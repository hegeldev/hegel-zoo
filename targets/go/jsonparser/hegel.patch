+func TestHegelIteratorsAgreeWithTheTree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v, data := document(ht, 3, false)
+		var paths [][]string
+		allPaths(v, nil, &paths)
+		path := pick(ht, paths)
+		want, _ := lookup(v, path)
+		switch w := want.(type) {
+		case []any:
+			var seen []any
+			var types []ValueType
+			off, err := ArrayEach(data, func(value []byte, dt ValueType, offset int, err error) {
+				if err != nil {
+					ht.Fatalf("ArrayEach callback error: %v", err)
+				}
+				seen = append(seen, append([]byte(nil), value...))
+				types = append(types, dt)
+			}, path...)
+			if err != nil || off < 0 {
+				ht.Fatalf("ArrayEach(%q): %d, %v", path, off, err)
+			}
+			if len(seen) != len(w) {
+				ht.Fatalf("ArrayEach(%q) visited %d elements, want %d", path, len(seen), len(w))
+			}
+			for i := range w {
+				if err := sameValue(seen[i].([]byte), types[i], w[i]); err != nil {
+					ht.Fatalf("ArrayEach(%q) element %d: %v", path, i, err)
+				}
+			}
+			count, err := ArrayEachErr(data, func([]byte, ValueType, int, error) error { return nil }, path...)
+			if err != nil || count != len(w) {
+				ht.Fatalf("ArrayEachErr(%q): %d, %v; want %d", path, count, err, len(w))
+			}
+			if err := ObjectEach(data, func([]byte, []byte, ValueType, int) error { return nil }, path...); err == nil {
+				ht.Fatalf("ObjectEach on an array: no error")
+			}
+		case object:
+			var keys []string
+			var vals [][]byte
+			var types []ValueType
+			err := ObjectEach(data, func(key, value []byte, dt ValueType, offset int) error {
+				keys = append(keys, string(key)) // ObjectEach hands keys over unescaped
+				vals = append(vals, append([]byte(nil), value...))
+				types = append(types, dt)
+				return nil
+			}, path...)
+			if err != nil {
+				ht.Fatalf("ObjectEach(%q): %v", path, err)
+			}
+			if len(keys) != len(w) {
+				ht.Fatalf("ObjectEach(%q) visited %d pairs, want %d", path, len(keys), len(w))
+			}
+			for i, e := range w {
+				if keys[i] != e.k {
+					ht.Fatalf("ObjectEach(%q) key %d: %q, want %q", path, i, keys[i], e.k)
+				}
+				if err := sameValue(vals[i], types[i], e.v); err != nil {
+					ht.Fatalf("ObjectEach(%q) value of %q: %v", path, e.k, err)
+				}
+			}
+			if _, err := ArrayEach(data, func([]byte, ValueType, int, error) {}, path...); err == nil {
+				ht.Fatalf("ArrayEach on an object: no error")
+			}
+		default:
+			if _, err := ArrayEach(data, func([]byte, ValueType, int, error) {}, path...); err == nil {
+				ht.Fatalf("ArrayEach on a %v: no error", typeOf(want))
+			}
+			if err := ObjectEach(data, func([]byte, []byte, ValueType, int) error { return nil }, path...); err == nil {
+				ht.Fatalf("ObjectEach on a %v: no error", typeOf(want))
+			}
+		}
+		// EachKey over several paths at once, some missing
+		var nonRoot [][]string
+		for _, p := range paths {
+			if len(p) > 0 {
+				nonRoot = append(nonRoot, p)
+			}
+		}
+		ht.Assume(len(nonRoot) > 0)
+		k := n(ht, 1, 4)
+		var query [][]string
+		var exists []bool
+		for i := 0; i < k; i++ {
+			if chance(ht, 25) {
+				query = append(query, missingPath(ht, v, pick(ht, nonRoot)))
+				exists = append(exists, false)
+			} else {
+				query = append(query, pick(ht, nonRoot))
+				exists = append(exists, true)
+			}
+		}
+		got := map[int][]byte{}
+		types := map[int]ValueType{}
+		ret := EachKey(data, func(idx int, value []byte, dt ValueType, err error) {
+			if err != nil {
+				ht.Fatalf("EachKey callback %d error: %v", idx, err)
+			}
+			if _, dup := got[idx]; dup {
+				ht.Fatalf("EachKey called twice for path %d %q", idx, query[idx])
+			}
+			got[idx] = append([]byte(nil), value...)
+			types[idx] = dt
+		}, query...)
+		allFound := true
+		for i, p := range query {
+			w, ok := lookup(v, p)
+			if !ok {
+				allFound = false
+				if _, called := got[i]; called {
+					ht.Fatalf("EachKey reported the missing path %q as %q", p, got[i])
+				}
+				continue
+			}
+			if _, called := got[i]; !called {
+				ht.Fatalf("EachKey never reported path %d %q (queries %q)", i, p, query)
+			}
+			if err := sameValue(got[i], types[i], w); err != nil {
+				ht.Fatalf("EachKey path %q: %v", p, err)
+			}
+		}
+		_ = exists
+		if (ret != -1) != allFound {
+			ht.Fatalf("EachKey returned %d with all paths found = %v (queries %q)", ret, allFound, query)
+		}
+	})
+}
