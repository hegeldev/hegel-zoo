+func TestHegelEscapeRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genRunes(ht, alphabet, 12)
+		e := Escape(s)
+		if len(e) < 2 || e[0] != '"' || e[len(e)-1] != '"' {
+			ht.Fatalf("Escape(%q) = %q is not a quoted literal", s, e)
+		}
+		var back string
+		if err := json.Unmarshal(e, &back); err != nil || back != s {
+			ht.Fatalf("encoding/json reads Escape(%q) = %s as %q, %v", s, e, back, err)
+		}
+		if p, err := ParseString(e[1 : len(e)-1]); err != nil || p != s {
+			ht.Fatalf("ParseString(Escape(%q)) = %q, %v", s, p, err)
+		}
+		if u, err := Unescape(e[1:len(e)-1], nil); err != nil || string(u) != s {
+			ht.Fatalf("Unescape(Escape(%q)) = %q, %v", s, u, err)
+		}
+		// every encoding the writer produces (and encoding/json's own) parses back
+		for esc := 0; esc <= 2; esc++ {
+			var b bytes.Buffer
+			(&style{esc: esc, quote: '"'}).str(&b, s)
+			body := b.Bytes()[1 : b.Len()-1]
+			if p, err := ParseString(body); err != nil || p != s {
+				ht.Fatalf("ParseString(%q) = %q, %v; want %q", body, p, err, s)
+			}
+			if u, err := Unescape(body, make([]byte, 0, len(body))); err != nil || string(u) != s {
+				ht.Fatalf("Unescape(%q) = %q, %v; want %q", body, u, err, s)
+			}
+		}
+		ref, _ := json.Marshal(s)
+		if p, err := ParseString(ref[1 : len(ref)-1]); err != nil || p != s {
+			ht.Fatalf("ParseString(%q) = %q, %v; want %q", ref[1:len(ref)-1], p, err, s)
+		}
+	})
+}
