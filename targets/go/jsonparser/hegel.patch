+package jsonparser_test
+
+// Hegel property tests for jsonparser (github.com/buger/jsonparser), written for the Hegel zoo.
+//
+// Oracle: the model tree the documents are generated from, checked against encoding/json
+// (every generated document is decoded with encoding/json first, so the model and the
+// reference agree before jsonparser is asked), and strconv for the scalar parsers. Documents
+// are rendered by a randomised writer: random JSON whitespace between tokens, three escaping
+// styles for strings (minimal, \u-escaped non-ASCII with \/ and surrogate pairs, \u00XX for
+// the short escapes), unique keys per object.
+//
+// The tests live in an external test package (only the exported API is used) so that their
+// helpers cannot collide with upstream's many in-package test files.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property() (hegel-go re-raises panics after shrinking, which would abort the
+// whole test binary and hide every later test).
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"testing/iotest"
+	"unicode/utf8"
+
+	. "github.com/buger/jsonparser"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			// Hegel's own control flow (Fatalf, Assume) is a panic with a value of its own types
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// --------------------------------------------------------------------------- model
+
+// A JSON value: nil | bool | number | string | []any | object.
+type number string
+
+type kv struct {
+	k string
+	v any
+}
+
+type object []kv
+
+func (o object) get(k string) (any, bool) {
+	for _, e := range o {
+		if e.k == k {
+			return e.v, true
+		}
+	}
+	return nil, false
+}
+
+var alphabet = append([]rune("abzAZ09 _-./:,;=!?'#@$%&*+<>()[]{}|^~`\"\\\t\n\r\b\f\x00\x01\x1f\x7fé中日😀𝔘"),
+	0x2028, 0x2029, 0xAD, 0xFEFF, 0xFFFD, 0x10FFFF)
+
+// keyAlphabet: nothing that Set would have to escape (jsonparser/3 is pinned separately),
+// no '[' (a component starting with '[' is an array index to jsonparser), no path syntax.
+var keyAlphabet = []rune("abzAZ09 _-/:,;=!?'#@$%&*+<>(){}|^~`é中日😀")
+
+func genRunes(tc hegel.TestCase, pool []rune, max int) string {
+	idx := hegel.Draw(tc, hegel.Lists(hegel.Integers(0, len(pool)-1)).MaxSize(max))
+	var b strings.Builder
+	for _, i := range idx {
+		b.WriteRune(pool[i])
+	}
+	return b.String()
+}
+
+func genString(tc hegel.TestCase) string { return genRunes(tc, alphabet, 8) }
+
+func genKey(tc hegel.TestCase, safe bool) string {
+	if safe {
+		return genRunes(tc, keyAlphabet, 6)
+	}
+	return genRunes(tc, alphabet, 6)
+}
+
+func digits(tc hegel.TestCase, lo, hi int) string {
+	k := n(tc, lo, hi)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		b.WriteByte(byte('0' + n(tc, 0, 9)))
+	}
+	return b.String()
+}
+
+// genNumber: the JSON number grammar, weighted towards the int64/uint64 edges.
+func genNumber(tc hegel.TestCase) number {
+	switch n(tc, 0, 6) {
+	case 0:
+		return number(strconv.Itoa(n(tc, -1000, 1000)))
+	case 1:
+		return number(strconv.FormatInt(hegel.Draw(tc, hegel.Integers[int64](math.MinInt64, math.MaxInt64)), 10))
+	case 2:
+		return number(strconv.FormatUint(hegel.Draw(tc, hegel.Integers[uint64](1<<63, math.MaxUint64)), 10))
+	case 3:
+		s := string(rune('1'+n(tc, 0, 8))) + digits(tc, 19, 24)
+		if chance(tc, 50) {
+			s = "-" + s
+		}
+		return number(s)
+	default:
+		var b strings.Builder
+		if chance(tc, 40) {
+			b.WriteByte('-')
+		}
+		if chance(tc, 30) {
+			b.WriteByte('0')
+		} else {
+			b.WriteByte(byte('1' + n(tc, 0, 8)))
+			b.WriteString(digits(tc, 0, 5))
+		}
+		if chance(tc, 50) {
+			b.WriteByte('.')
+			b.WriteString(digits(tc, 1, 5))
+		}
+		if chance(tc, 40) {
+			b.WriteByte(pick(tc, []byte{'e', 'E'}))
+			b.WriteString(pick(tc, []string{"", "+", "-"}))
+			b.WriteString(digits(tc, 1, 3))
+		}
+		return number(b.String())
+	}
+}
+
+func genObject(tc hegel.TestCase, depth int, safeKeys bool) object {
+	k := n(tc, 0, 4)
+	var o object
+	for i := 0; i < k; i++ {
+		key := genKey(tc, safeKeys)
+		if _, dup := o.get(key); dup {
+			continue
+		}
+		o = append(o, kv{key, genValue(tc, depth-1, safeKeys)})
+	}
+	return o
+}
+
+func genValue(tc hegel.TestCase, depth int, safeKeys bool) any {
+	top := 4
+	if depth > 0 {
+		top = 7
+	}
+	switch n(tc, 0, top) {
+	case 0:
+		return nil
+	case 1:
+		return hegel.Draw(tc, hegel.Booleans())
+	case 2:
+		return genNumber(tc)
+	case 3, 4:
+		return genString(tc)
+	case 5:
+		k := n(tc, 0, 4)
+		arr := make([]any, 0, k)
+		for i := 0; i < k; i++ {
+			arr = append(arr, genValue(tc, depth-1, safeKeys))
+		}
+		return arr
+	default:
+		return genObject(tc, depth, safeKeys)
+	}
+}
+
+// canon converts a model value to what encoding/json's decoder (UseNumber) produces.
+func canon(v any) any {
+	switch x := v.(type) {
+	case nil:
+		return nil
+	case bool:
+		return x
+	case number:
+		return json.Number(x)
+	case string:
+		return x
+	case []any:
+		out := make([]any, 0, len(x))
+		for _, e := range x {
+			out = append(out, canon(e))
+		}
+		return out
+	case object:
+		out := make(map[string]any, len(x))
+		for _, e := range x {
+			out[e.k] = canon(e.v)
+		}
+		return out
+	}
+	panic(fmt.Sprintf("bad model value %T", v))
+}
+
+// decode is the reference: encoding/json, numbers kept as text, no trailing garbage.
+func decode(b []byte) (any, error) {
+	d := json.NewDecoder(bytes.NewReader(b))
+	d.UseNumber()
+	var v any
+	if err := d.Decode(&v); err != nil {
+		return nil, err
+	}
+	if _, err := d.Token(); err != io.EOF {
+		return nil, fmt.Errorf("trailing data after the value: %v", err)
+	}
+	return v, nil
+}
+
+// --------------------------------------------------------------------------- paths
+
+func isIndex(c string) bool { return len(c) > 1 && c[0] == '[' }
+
+func indexOf(c string) (int, bool) {
+	if len(c) < 3 || c[0] != '[' || c[len(c)-1] != ']' {
+		return 0, false
+	}
+	i, err := strconv.Atoi(c[1 : len(c)-1])
+	return i, err == nil && i >= 0
+}
+
+// allPaths enumerates every path in v, the root included.
+func allPaths(v any, prefix []string, out *[][]string) {
+	p := append([]string(nil), prefix...)
+	*out = append(*out, p)
+	switch x := v.(type) {
+	case []any:
+		for i, e := range x {
+			allPaths(e, append(p, fmt.Sprintf("[%d]", i)), out)
+		}
+	case object:
+		for _, e := range x {
+			allPaths(e.v, append(p, e.k), out)
+		}
+	}
+}
+
+func lookup(v any, path []string) (any, bool) {
+	for _, c := range path {
+		switch x := v.(type) {
+		case []any:
+			i, ok := indexOf(c)
+			if !ok || i >= len(x) {
+				return nil, false
+			}
+			v = x[i]
+		case object:
+			e, ok := x.get(c)
+			if !ok {
+				return nil, false
+			}
+			v = e
+		default:
+			return nil, false
+		}
+	}
+	return v, true
+}
+
+// setPath: the model of Set on a path that exists, or whose missing tail is keys on objects
+// (jsonparser creates them). Returns the new tree.
+func setPath(v any, path []string, nv any) any {
+	if len(path) == 0 {
+		return nv
+	}
+	c := path[0]
+	switch x := v.(type) {
+	case []any:
+		i, ok := indexOf(c)
+		if !ok || i > len(x) {
+			panic("setPath: index out of range in the model")
+		}
+		out := append([]any(nil), x...)
+		if i == len(x) { // Set at index len appends (upstream's pr286-top-level-len test asserts it)
+			return append(out, setPath(object(nil), path[1:], nv))
+		}
+		out[i] = setPath(out[i], path[1:], nv)
+		return out
+	case object:
+		out := append(object(nil), x...)
+		for j, e := range out {
+			if e.k == c {
+				out[j].v = setPath(e.v, path[1:], nv)
+				return out
+			}
+		}
+		return append(out, kv{c, setPath(object(nil), path[1:], nv)})
+	}
+	panic("setPath: path into a scalar in the model")
+}
+
+func deletePath(v any, path []string) any {
+	c := path[0]
+	switch x := v.(type) {
+	case []any:
+		i, _ := indexOf(c)
+		out := append([]any(nil), x...)
+		if len(path) == 1 {
+			return append(out[:i], out[i+1:]...)
+		}
+		out[i] = deletePath(out[i], path[1:])
+		return out
+	case object:
+		out := append(object(nil), x...)
+		for j, e := range out {
+			if e.k == c {
+				if len(path) == 1 {
+					return append(out[:j], out[j+1:]...)
+				}
+				out[j].v = deletePath(e.v, path[1:])
+				return out
+			}
+		}
+	}
+	panic("deletePath: path not in the model")
+}
+
+func freshKey(o object, base string) string {
+	k := base
+	for i := 0; ; i++ {
+		if _, dup := o.get(k); !dup {
+			return k
+		}
+		k = fmt.Sprintf("%s%d", base, i)
+	}
+}
+
+// bracketKey: some step of the path is an object key that starts with '[' (index syntax).
+func bracketKey(v any, path []string) bool {
+	for _, c := range path {
+		if o, ok := v.(object); ok {
+			if strings.HasPrefix(c, "[") {
+				return true
+			}
+			v, _ = o.get(c)
+		} else if arr, ok := v.([]any); ok {
+			i, _ := indexOf(c)
+			if i < len(arr) {
+				v = arr[i]
+			}
+		}
+	}
+	return false
+}
+
+// missingPath: a path that does not exist, made from an existing one.
+func missingPath(tc hegel.TestCase, v any, path []string) []string {
+	cut := n(tc, 0, len(path))
+	prefix := append([]string(nil), path[:cut]...)
+	sub, _ := lookup(v, prefix)
+	switch x := sub.(type) {
+	case object:
+		return append(prefix, freshKey(x, pick(tc, []string{"missing", "", "z"})))
+	case []any:
+		return append(prefix, fmt.Sprintf("[%d]", len(x)+n(tc, 0, 2)))
+	default:
+		// a key step on a scalar; an index step on a scalar is jsonparser/8, pinned below
+		return append(prefix, "x")
+	}
+}
+
+// --------------------------------------------------------------------------- writer
+
+type style struct {
+	ws         []int
+	pos        int
+	esc        int  // 0 minimal, 1 \u for non-ASCII (+ \/), 2 \u00XX for the short escapes too
+	quote      byte // '"' or '\'' (Lenient only)
+	unknownEsc bool // write some letters as \g etc. (Lenient only)
+}
+
+func genStyle(tc hegel.TestCase) *style {
+	return &style{ws: hegel.Draw(tc, hegel.Lists(hegel.Integers(0, 6)).MaxSize(80)), esc: n(tc, 0, 2), quote: '"'}
+}
+
+var spaces = []string{"", "", "", " ", "\n", "\t", " \r\n "}
+
+func (s *style) space(b *bytes.Buffer) {
+	if s.pos < len(s.ws) {
+		b.WriteString(spaces[s.ws[s.pos]])
+		s.pos++
+	}
+}
+
+func (s *style) flag() bool {
+	if s.pos < len(s.ws) {
+		s.pos++
+		return s.ws[s.pos-1] >= 4
+	}
+	return false
+}
+
+const unknownEscapable = "ghjkmqvwxyz"
+
+func (s *style) str(b *bytes.Buffer, str string) {
+	b.WriteByte(s.quote)
+	for _, r := range str {
+		switch {
+		case r == rune(s.quote):
+			b.WriteByte('\\')
+			b.WriteByte(s.quote)
+		case r == '\\':
+			b.WriteString(`\\`)
+		case r < 0x20:
+			short := map[rune]string{'\n': `\n`, '\t': `\t`, '\r': `\r`, '\b': `\b`, '\f': `\f`}[r]
+			if short != "" && s.esc != 2 {
+				b.WriteString(short)
+			} else {
+				fmt.Fprintf(b, `\u%04x`, r)
+			}
+		case r == '/' && s.esc >= 1:
+			b.WriteString(`\/`)
+		case r >= 0x80 && s.esc >= 1:
+			if r > 0xFFFF {
+				hi, lo := (r-0x10000)>>10+0xD800, (r-0x10000)&0x3FF+0xDC00
+				if s.esc == 2 {
+					fmt.Fprintf(b, `\u%04X\u%04X`, hi, lo)
+				} else {
+					fmt.Fprintf(b, `\u%04x\u%04x`, hi, lo)
+				}
+			} else if s.esc == 2 {
+				fmt.Fprintf(b, `\u%04X`, r)
+			} else {
+				fmt.Fprintf(b, `\u%04x`, r)
+			}
+		case s.unknownEsc && strings.ContainsRune(unknownEscapable, r) && s.flag():
+			b.WriteByte('\\')
+			b.WriteRune(r)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte(s.quote)
+}
+
+func (s *style) value(b *bytes.Buffer, v any) {
+	s.space(b)
+	switch x := v.(type) {
+	case nil:
+		b.WriteString("null")
+	case bool:
+		b.WriteString(strconv.FormatBool(x))
+	case number:
+		b.WriteString(string(x))
+	case string:
+		s.str(b, x)
+	case []any:
+		b.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				s.space(b)
+				b.WriteByte(',')
+			}
+			s.value(b, e)
+		}
+		s.space(b)
+		b.WriteByte(']')
+	case object:
+		b.WriteByte('{')
+		for i, e := range x {
+			if i > 0 {
+				s.space(b)
+				b.WriteByte(',')
+			}
+			s.space(b)
+			s.str(b, e.k)
+			s.space(b)
+			b.WriteByte(':')
+			s.value(b, e.v)
+		}
+		s.space(b)
+		b.WriteByte('}')
+	}
+	s.space(b)
+}
+
+func render(s *style, v any) []byte {
+	var b bytes.Buffer
+	s.value(&b, v)
+	return b.Bytes()
+}
+
+// document: a model value, its rendering, checked against encoding/json.
+func document(ht *hegel.T, depth int, safeKeys bool) (any, []byte) {
+	v := genValue(ht, depth, safeKeys)
+	data := render(genStyle(ht), v)
+	ref, err := decode(data)
+	if err != nil {
+		ht.Fatalf("the generated document is not JSON (writer bug): %v\n%s", err, data)
+	}
+	if !reflect.DeepEqual(ref, canon(v)) {
+		ht.Fatalf("encoding/json reads the document differently from the model (writer bug):\n%#v\n%#v", ref, canon(v))
+	}
+	return v, data
+}
+
+func container(ht *hegel.T, depth int, safeKeys bool) (any, []byte) {
+	for {
+		v, data := document(ht, depth, safeKeys)
+		switch v.(type) {
+		case []any, object:
+			return v, data
+		}
+		ht.Assume(false)
+	}
+}
+
+// --------------------------------------------------------------------------- checks
+
+func typeOf(v any) ValueType {
+	switch v.(type) {
+	case nil:
+		return Null
+	case bool:
+		return Boolean
+	case number:
+		return Number
+	case string:
+		return String
+	case []any:
+		return Array
+	default:
+		return Object
+	}
+}
+
+// sameValue: jsonparser's raw value bytes describe the model value.
+func sameValue(got []byte, dt ValueType, want any) error {
+	if dt != typeOf(want) {
+		return fmt.Errorf("type %v, want %v", dt, typeOf(want))
+	}
+	switch w := want.(type) {
+	case nil:
+		if string(got) != "null" {
+			return fmt.Errorf("value %q for null", got)
+		}
+	case bool:
+		if string(got) != strconv.FormatBool(w) {
+			return fmt.Errorf("value %q for %v", got, w)
+		}
+	case number:
+		if string(got) != string(w) {
+			return fmt.Errorf("number %q, want %q", got, w)
+		}
+	case string:
+		var s string
+		if err := json.Unmarshal([]byte(`"`+string(got)+`"`), &s); err != nil {
+			return fmt.Errorf("string body %q does not unescape: %v", got, err)
+		}
+		if s != w {
+			return fmt.Errorf("string %q, want %q", s, w)
+		}
+	default:
+		ref, err := decode(got)
+		if err != nil {
+			return fmt.Errorf("value %q is not JSON: %v", got, err)
+		}
+		if !reflect.DeepEqual(ref, canon(w)) {
+			return fmt.Errorf("value %q reads as %#v, want %#v", got, ref, canon(w))
+		}
+	}
+	return nil
+}
+
+// checkGet: value, type and offset (the value ends at offset; strings at their closing quote).
+func checkGet(data, got []byte, dt ValueType, off int, want any) error {
+	if err := sameValue(got, dt, want); err != nil {
+		return err
+	}
+	end := off
+	if dt == String {
+		end = off - 1
+		if end < 0 || end >= len(data) || data[end] != '"' {
+			return fmt.Errorf("offset %d does not point after a closing quote", off)
+		}
+	}
+	if end < len(got) || end > len(data) || !bytes.Equal(data[end-len(got):end], got) {
+		return fmt.Errorf("offset %d: data[%d:%d] is not the value %q", off, end-len(got), end, got)
+	}
+	return nil
+}
+
+func sameDoc(out []byte, want any) error {
+	ref, err := decode(out)
+	if err != nil {
+		return fmt.Errorf("output is not JSON: %v\n%s", err, out)
+	}
+	if !reflect.DeepEqual(ref, canon(want)) {
+		w, _ := json.Marshal(canon(want))
+		return fmt.Errorf("output reads differently from the model:\n%s\nwant %s", out, w)
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- properties
+
+func TestHegelGetAgreesWithEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v, data := document(ht, 3, false)
+		var paths [][]string
+		allPaths(v, nil, &paths)
+		path := pick(ht, paths)
+		want, _ := lookup(v, path)
+		got, dt, off, err := Get(data, path...)
+		if err != nil {
+			ht.Fatalf("Get(%q): %v", path, err)
+		}
+		if err := checkGet(data, got, dt, off, want); err != nil {
+			ht.Fatalf("Get(%q): %v", path, err)
+		}
+		// the typed accessors: right on their type, an error on any other
+		s, serr := GetString(data, path...)
+		i, ierr := GetInt(data, path...)
+		u, uerr := GetUint64(data, path...)
+		f, ferr := GetFloat(data, path...)
+		b, berr := GetBoolean(data, path...)
+		al, alerr := GetArrayLen(data, path...)
+		ol, olerr := GetObjectLen(data, path...)
+		expectErr := func(what string, err error) {
+			if err == nil {
+				ht.Fatalf("%s on %v value %q: no error", what, dt, got)
+			}
+		}
+		switch w := want.(type) {
+		case string:
+			if serr != nil || s != w {
+				ht.Fatalf("GetString: %q, %v; want %q", s, serr, w)
+			}
+			if !bytes.ContainsRune(got, '\\') {
+				if us, err := GetUnsafeString(data, path...); err != nil || us != w {
+					ht.Fatalf("GetUnsafeString on an escape-free string: %q, %v; want %q", us, err, w)
+				}
+			}
+			expectErr("GetInt", ierr)
+			expectErr("GetFloat", ferr)
+			expectErr("GetBoolean", berr)
+		case number:
+			text := string(w)
+			if ri, rerr := strconv.ParseInt(text, 10, 64); rerr == nil {
+				if ierr != nil || i != ri {
+					ht.Fatalf("GetInt(%q): %d, %v; strconv says %d", text, i, ierr, ri)
+				}
+			} else if ierr == nil {
+				ht.Fatalf("GetInt(%q) = %d but strconv rejects it: %v", text, i, rerr)
+			}
+			if ru, rerr := strconv.ParseUint(text, 10, 64); rerr == nil || text == "-0" {
+				if uerr != nil || u != ru {
+					ht.Fatalf("GetUint64(%q): %d, %v; strconv says %d", text, u, uerr, ru)
+				}
+			} else if uerr == nil {
+				ht.Fatalf("GetUint64(%q) = %d but strconv rejects it: %v", text, u, rerr)
+			}
+			if rf, rerr := strconv.ParseFloat(text, 64); rerr == nil {
+				if ferr != nil || math.Float64bits(f) != math.Float64bits(rf) {
+					ht.Fatalf("GetFloat(%q): %v, %v; strconv says %v", text, f, ferr, rf)
+				}
+			} else if ferr == nil {
+				ht.Fatalf("GetFloat(%q) = %v but strconv rejects it: %v", text, f, rerr)
+			}
+			expectErr("GetString", serr)
+			expectErr("GetBoolean", berr)
+		case bool:
+			if berr != nil || b != w {
+				ht.Fatalf("GetBoolean: %v, %v; want %v", b, berr, w)
+			}
+			expectErr("GetString", serr)
+			expectErr("GetInt", ierr)
+			expectErr("GetFloat", ferr)
+		case nil:
+			expectErr("GetString", serr)
+			expectErr("GetInt", ierr)
+			expectErr("GetFloat", ferr)
+			expectErr("GetBoolean", berr)
+		case []any:
+			if alerr != nil || al != len(w) {
+				ht.Fatalf("GetArrayLen: %d, %v; want %d", al, alerr, len(w))
+			}
+			expectErr("GetObjectLen", olerr)
+			expectErr("GetString", serr)
+			expectErr("GetInt", ierr)
+		case object:
+			if olerr != nil || ol != len(w) {
+				ht.Fatalf("GetObjectLen: %d, %v; want %d", ol, olerr, len(w))
+			}
+			expectErr("GetArrayLen", alerr)
+			expectErr("GetString", serr)
+			expectErr("GetInt", ierr)
+		}
+		// a path that does not exist
+		miss := missingPath(ht, v, path)
+		mv, mdt, moff, merr := Get(data, miss...)
+		if merr != KeyPathNotFoundError || mdt != NotExist || len(mv) != 0 || moff != -1 {
+			ht.Fatalf("Get(%q) on a missing path: %q, %v, %d, %v", miss, mv, mdt, moff, merr)
+		}
+		// the same through Config{} (strict) and a compiled path
+		cv, cdt, coff, cerr := DefaultConfig.Get(data, path...)
+		if cerr != nil || !bytes.Equal(cv, got) || cdt != dt || coff != off {
+			ht.Fatalf("DefaultConfig.Get differs from Get: %q %v %d %v", cv, cdt, coff, cerr)
+		}
+		// the whole document, as the input of a stream
+		wv, wdt, woff, werr := Get(data)
+		if werr != nil {
+			ht.Fatalf("Get(data) with no keys: %v", werr)
+		}
+		if err := checkGet(data, wv, wdt, woff, v); err != nil {
+			ht.Fatalf("Get(data) with no keys: %v", err)
+		}
+	})
+}
