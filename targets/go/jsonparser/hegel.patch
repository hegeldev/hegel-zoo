+func TestHegelReaderParserAgreesWithGet(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v, data := document(ht, 3, false)
+		var paths [][]string
+		allPaths(v, nil, &paths)
+		path := pick(ht, paths)
+		if chance(ht, 20) {
+			path = missingPath(ht, v, path)
+		}
+		for _, c := range path {
+			ht.Assume(c != "") // jsonparser/7, pinned below
+		}
+		reader := func() io.Reader {
+			r := bytes.NewReader(data)
+			switch n(ht, 0, 3) {
+			case 0:
+				return r
+			case 1:
+				return iotest.OneByteReader(r)
+			case 2:
+				return iotest.HalfReader(r)
+			default:
+				return &chunkedReader{r, n(ht, 1, 7)}
+			}
+		}
+		cfg := Config{MaxBufferSize: pick(ht, []int{0, 1, 2, 3, 5, 8, 16, 64})}
+		wv, wdt, _, werr := Get(data, path...)
+		gv, gdt, gerr := NewReaderParser(reader(), cfg).Get(path...)
+		if !bytes.Equal(gv, wv) || gdt != wdt || (gerr == nil) != (werr == nil) {
+			ht.Fatalf("ReaderParser(%+v).Get(%q) on %q = %q %v %v; Get says %q %v %v", cfg, path, data, gv, gdt, gerr, wv, wdt, werr)
+		}
+		ws, wserr := GetString(data, path...)
+		gs, gserr := NewReaderParser(reader(), cfg).GetString(path...)
+		if gs != ws || (gserr == nil) != (wserr == nil) {
+			ht.Fatalf("ReaderParser(%+v).GetString(%q) on %q = %q %v; GetString says %q %v", cfg, path, data, gs, gserr, ws, wserr)
+		}
+		if arr, ok := v.([]any); ok {
+			var seen [][]byte
+			err := NewReaderParser(reader(), cfg).ArrayEach(func(value []byte, vt ValueType, err error) {
+				if err != nil {
+					ht.Fatalf("ReaderParser.ArrayEach callback error: %v", err)
+				}
+				seen = append(seen, append([]byte(nil), value...))
+			})
+			if err != nil || len(seen) != len(arr) {
+				ht.Fatalf("ReaderParser(%+v).ArrayEach: %d elements, %v; want %d", cfg, len(seen), err, len(arr))
+			}
+			var want [][]byte
+			ArrayEach(data, func(value []byte, vt ValueType, offset int, err error) {
+				want = append(want, append([]byte(nil), value...))
+			})
+			if !reflect.DeepEqual(seen, want) {
+				ht.Fatalf("ReaderParser(%+v).ArrayEach: %q; ArrayEach says %q", cfg, seen, want)
+			}
+		}
+	})
+}
