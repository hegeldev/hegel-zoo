+// wildcardDoc: an array of 1–4 objects that all carry key k (and random others), reached
+// through 0–2 object levels.
+func wildcardDoc(ht *hegel.T) (v any, prefix []string, k string, elems []object) {
+	k = genKey(ht, true)
+	m := n(ht, 1, 4)
+	arr := make([]any, 0, m)
+	for i := 0; i < m; i++ {
+		o := genObject(ht, 1, true)
+		var without object
+		for _, e := range o {
+			if e.k != k {
+				without = append(without, e)
+			}
+		}
+		at := n(ht, 0, len(without))
+		o = append(append(append(object(nil), without[:at]...), kv{k, genValue(ht, 1, true)}), without[at:]...)
+		elems = append(elems, o)
+		arr = append(arr, o)
+	}
+	v = arr
+	for depth := n(ht, 0, 2); depth > 0; depth-- {
+		o := genObject(ht, 1, true)
+		key := freshKey(o, genKey(ht, true))
+		at := n(ht, 0, len(o))
+		o = append(append(append(object(nil), o[:at]...), kv{key, v}), o[at:]...)
+		v = o
+		prefix = append([]string{key}, prefix...)
+	}
+	return v, prefix, k, elems
+}
