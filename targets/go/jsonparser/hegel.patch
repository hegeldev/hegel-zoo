+var pathKeyAlphabet = []rune("abzAZ09 _-/:,;=!?'#@%&*+<>(){}|^~`é中日😀")
+
+func TestHegelParsePathRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		var comps []string
+		var text strings.Builder
+		for i := 0; i < k; i++ {
+			switch n(ht, 0, 3) {
+			case 0:
+				comps = append(comps, "[*]")
+				if i == 0 {
+					text.WriteByte('$')
+				}
+				text.WriteString("[*]")
+			case 1:
+				idx := n(ht, 0, 12)
+				comps = append(comps, fmt.Sprintf("[%d]", idx))
+				if i == 0 {
+					text.WriteByte('$')
+				}
+				fmt.Fprintf(&text, "[%d]", idx)
+			default:
+				key := genRunes(ht, pathKeyAlphabet, 5)
+				comps = append(comps, key)
+				if key == "" || chance(ht, 30) { // the quoted form, JSON-escaped
+					if i > 0 || chance(ht, 50) {
+						if i == 0 {
+							text.WriteByte('$')
+						}
+						text.WriteByte('.')
+					}
+					text.Write(Escape(key))
+				} else {
+					if i > 0 {
+						text.WriteByte('.')
+					} else if chance(ht, 50) {
+						text.WriteString("$.")
+					}
+					text.WriteString(key)
+				}
+			}
+		}
+		parts, err := ParsePath(text.String())
+		if err != nil || !reflect.DeepEqual(parts, comps) {
+			ht.Fatalf("ParsePath(%q) = %q, %v; want %q", text.String(), parts, err, comps)
+		}
+		cp, err := CompilePath(text.String())
+		if err != nil || !reflect.DeepEqual(cp.Parts(), comps) {
+			ht.Fatalf("CompilePath(%q).Parts() = %q, %v; want %q", text.String(), cp.Parts(), err, comps)
+		}
+		// the compiled path behaves like the plain functions
+		v, data := container(ht, 2, true)
+		gv, gdt, goff, gerr := Get(data, comps...)
+		cv, cdt, coff, cerr := cp.Get(data)
+		if !bytes.Equal(gv, cv) || gdt != cdt || goff != coff || (gerr == nil) != (cerr == nil) {
+			ht.Fatalf("CompiledPath.Get differs from Get on %q: (%q %v %d %v) vs (%q %v %d %v)", comps, cv, cdt, coff, cerr, gv, gdt, goff, gerr)
+		}
+		gs, gserr := GetString(data, comps...)
+		cs, cserr := cp.GetString(data)
+		if gs != cs || (gserr == nil) != (cserr == nil) {
+			ht.Fatalf("CompiledPath.GetString differs from GetString on %q", comps)
+		}
+		gi, gierr := GetInt(data, comps...)
+		ci, cierr := cp.GetInt(data)
+		if gi != ci || (gierr == nil) != (cierr == nil) {
+			ht.Fatalf("CompiledPath.GetInt differs from GetInt on %q", comps)
+		}
+		valText := render(genStyle(ht), genValue(ht, 1, true))
+		if strings.Contains(strings.Join(comps, ""), "*") {
+			return
+		}
+		so, serr := Set(data, valText, comps...)
+		co, cerr2 := cp.Set(data, valText)
+		if !bytes.Equal(so, co) || (serr == nil) != (cerr2 == nil) {
+			ht.Fatalf("CompiledPath.Set differs from Set on %q:\n%s\n%s", comps, co, so)
+		}
+		if d1, d2 := Delete(data, comps...), cp.Delete(data); !bytes.Equal(d1, d2) {
+			ht.Fatalf("CompiledPath.Delete differs from Delete on %q:\n%s\n%s", comps, d2, d1)
+		}
+		_ = v
+	})
+}
