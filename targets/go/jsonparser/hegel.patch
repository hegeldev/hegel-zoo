+func TestHegelNoPanicOnMutatedDocuments(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v, data := document(ht, 3, false)
+		var paths [][]string
+		allPaths(v, nil, &paths)
+		path := pick(ht, paths)
+		mut := append([]byte(nil), data...)
+		for k := n(ht, 1, 3); k > 0 && len(mut) > 0; k-- {
+			pos := n(ht, 0, len(mut)-1)
+			switch n(ht, 0, 3) {
+			case 0:
+				mut = append(mut[:pos], mut[pos+1:]...)
+			case 1:
+				mut = append(mut[:pos], append([]byte{pick(ht, mutationBytes)}, mut[pos:]...)...)
+			case 2:
+				mut[pos] = pick(ht, mutationBytes)
+			default:
+				mut = mut[:pos]
+			}
+		}
+		value := render(genStyle(ht), genValue(ht, 1, false))
+		// only the absence of panics is asserted: the document may be anything now
+		Get(mut, path...)
+		GetString(mut, path...)
+		GetInt(mut, path...)
+		GetUint64(mut, path...)
+		GetFloat(mut, path...)
+		GetBoolean(mut, path...)
+		GetArrayLen(mut, path...)
+		GetObjectLen(mut, path...)
+		ArrayEach(mut, func([]byte, ValueType, int, error) {}, path...)
+		ObjectEach(mut, func([]byte, []byte, ValueType, int) error { return nil }, path...)
+		if len(path) > 0 {
+			EachKey(mut, func(int, []byte, ValueType, error) {}, path, missingPath(ht, v, path))
+			Set(mut, value, path...)
+			Delete(mut, path...)
+			Append(mut, value, path...)
+			EachKeyWildcard(mut, func(int, []byte, ValueType, error) {}, append(path, "[*]")...)
+			SetWildcard(mut, value, append(path[:len(path)-1], "[*]", path[len(path)-1])...)
+		}
+		Lenient.Get(mut, path...)
+		Lenient.GetString(mut, path...)
+		ParseString(mut)
+		ParseInt(mut)
+		ParseFloat(mut)
+		ParseBoolean(mut)
+		ParsePath(string(mut))
+		NewReaderParser(bytes.NewReader(mut), Config{MaxBufferSize: n(ht, 0, 8)}).Get(path...)
+	})
+}
