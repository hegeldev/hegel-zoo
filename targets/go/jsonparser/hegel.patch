+func TestHegelScalarParsersAgreeWithStrconv(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := string(genNumber(ht))
+		b := []byte(text)
+		if ri, rerr := strconv.ParseInt(text, 10, 64); rerr == nil {
+			if i, err := ParseInt(b); err != nil || i != ri {
+				ht.Fatalf("ParseInt(%q) = %d, %v; strconv says %d", text, i, err, ri)
+			}
+		} else if i, err := ParseInt(b); err == nil {
+			ht.Fatalf("ParseInt(%q) = %d but strconv rejects it (%v)", text, i, rerr)
+		}
+		if rf, rerr := strconv.ParseFloat(text, 64); rerr == nil {
+			if f, err := ParseFloat(b); err != nil || math.Float64bits(f) != math.Float64bits(rf) {
+				ht.Fatalf("ParseFloat(%q) = %v, %v; strconv says %v", text, f, err, rf)
+			}
+		} else if f, err := ParseFloat(b); err == nil {
+			ht.Fatalf("ParseFloat(%q) = %v but strconv rejects it (%v)", text, f, rerr)
+		}
+		// ParseBoolean: exactly the two literals
+		word := pick(ht, []string{"true", "false", "True", "TRUE", "t", "1", "0", "", "tru", "truee", "null", "false "})
+		v, err := ParseBoolean([]byte(word))
+		switch word {
+		case "true", "false":
+			if err != nil || v != (word == "true") {
+				ht.Fatalf("ParseBoolean(%q) = %v, %v", word, v, err)
+			}
+		default:
+			if err == nil {
+				ht.Fatalf("ParseBoolean(%q) = %v with no error", word, v)
+			}
+		}
+	})
+}
