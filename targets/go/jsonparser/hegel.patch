+func TestHegelLenientConfigReadsSingleQuotesAndUnknownEscapes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 3, false)
+		st := genStyle(ht)
+		if chance(ht, 60) {
+			st.quote = '\''
+		}
+		st.unknownEsc = chance(ht, 50)
+		data := render(st, v)
+		var paths [][]string
+		allPaths(v, nil, &paths)
+		path := pick(ht, paths)
+		want, _ := lookup(v, path)
+		got, dt, _, err := Lenient.Get(data, path...)
+		if err != nil || dt != typeOf(want) {
+			ht.Fatalf("Lenient.Get(%q) on\n%s\n= %q %v %v; want type %v", path, data, got, dt, err, typeOf(want))
+		}
+		switch w := want.(type) {
+		case string:
+			if s, err := Lenient.GetString(data, path...); err != nil || s != w {
+				ht.Fatalf("Lenient.GetString(%q) on\n%s\n= %q, %v; want %q", path, data, s, err, w)
+			}
+		case []any:
+			count := 0
+			if _, err := Lenient.ArrayEach(data, func([]byte, ValueType, int, error) { count++ }, path...); err != nil || count != len(w) {
+				ht.Fatalf("Lenient.ArrayEach(%q): %d, %v; want %d", path, count, err, len(w))
+			}
+		case object:
+			var keys []string
+			err := Lenient.ObjectEach(data, func(key, value []byte, vt ValueType, offset int) error {
+				keys = append(keys, string(key))
+				return nil
+			}, path...)
+			if err != nil || len(keys) != len(w) {
+				ht.Fatalf("Lenient.ObjectEach(%q): %q, %v; want %d pairs", path, keys, err, len(w))
+			}
+		case number:
+			if string(got) != string(w) {
+				ht.Fatalf("Lenient.Get(%q) number %q, want %q", path, got, w)
+			}
+		}
+		if st.quote == '"' && !st.unknownEsc {
+			// a strict document reads the same through both configurations
+			sv, sdt, soff, serr := Get(data, path...)
+			if !bytes.Equal(sv, got) || sdt != dt || serr != nil {
+				ht.Fatalf("Get and Lenient.Get differ on a strict document at %q: %q %v %d %v", path, sv, sdt, soff, serr)
+			}
+		}
+	})
+}
