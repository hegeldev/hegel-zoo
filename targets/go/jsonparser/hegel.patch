+func TestHegelWildcardsAgreeWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v, prefix, k, elems := wildcardDoc(ht)
+		data := render(genStyle(ht), v)
+		if _, err := decode(data); err != nil {
+			ht.Fatalf("writer bug: %v", err)
+		}
+		path := append(append(append([]string(nil), prefix...), "[*]"), k)
+		var seen [][]byte
+		var types []ValueType
+		var idxs []int
+		err := EachKeyWildcard(data, func(idx int, value []byte, vt ValueType, err error) {
+			if err != nil {
+				ht.Fatalf("EachKeyWildcard callback error: %v", err)
+			}
+			seen = append(seen, append([]byte(nil), value...))
+			types = append(types, vt)
+			idxs = append(idxs, idx)
+		}, path...)
+		if err != nil {
+			ht.Fatalf("EachKeyWildcard(%q): %v\n%s", path, err, data)
+		}
+		if len(seen) != len(elems) {
+			ht.Fatalf("EachKeyWildcard(%q) reported %d matches, want %d", path, len(seen), len(elems))
+		}
+		for i, o := range elems {
+			w, _ := o.get(k)
+			if idxs[i] != i {
+				ht.Fatalf("EachKeyWildcard match %d reported with idx %d", i, idxs[i])
+			}
+			if err := sameValue(seen[i], types[i], w); err != nil {
+				ht.Fatalf("EachKeyWildcard(%q) match %d: %v", path, i, err)
+			}
+		}
+		// ArrayEachWildcard with a terminal [*] is ArrayEach
+		count, err := ArrayEachWildcard(data, func(idx int, value []byte, vt ValueType, offset int, err error) error {
+			if err := sameValue(value, vt, elems[idx]); err != nil {
+				ht.Fatalf("ArrayEachWildcard element %d: %v", idx, err)
+			}
+			return nil
+		}, append(append([]string(nil), prefix...), "[*]")...)
+		if err != nil || count != len(elems) {
+			ht.Fatalf("ArrayEachWildcard: %d, %v; want %d", count, err, len(elems))
+		}
+		// SetWildcard sets k in every element
+		nv := genValue(ht, 1, true)
+		out, err := SetWildcard(data, render(genStyle(ht), nv), path...)
+		if err != nil {
+			ht.Fatalf("SetWildcard(%q): %v", path, err)
+		}
+		want := v
+		for i := range elems {
+			want = setPath(want, append(append(append([]string(nil), prefix...), fmt.Sprintf("[%d]", i)), k), nv)
+		}
+		if err := sameDoc(out, want); err != nil {
+			ht.Fatalf("SetWildcard(%q): %v", path, err)
+		}
+		// a terminal [*] on the array itself lists the elements
+		var els [][]byte
+		err = EachKeyWildcard(data, func(idx int, value []byte, vt ValueType, err error) {
+			els = append(els, append([]byte(nil), value...))
+		}, append(append([]string(nil), prefix...), "[*]")...)
+		if err != nil || len(els) != len(elems) {
+			ht.Fatalf("EachKeyWildcard(prefix, [*]): %d, %v; want %d", len(els), err, len(elems))
+		}
+	})
+}
