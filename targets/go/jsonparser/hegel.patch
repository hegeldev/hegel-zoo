+			ht.Fatalf("Get(%q) on %s: %q, %v (Get does find such keys)", key, data, got, err)
+		}
+		out := Delete(data, key)
+		if err := sameDoc(out, deletePath(o, []string{key})); err != nil {
+			ht.Fatalf("Delete(%q) on %s: %v", key, data, err)
+		}
+	})
+}
