+func TestHegelDeleteAgreesWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v, data := container(ht, 3, false)
+		var paths [][]string
+		allPaths(v, nil, &paths)
+		var nonRoot [][]string
+		for _, p := range paths {
+			if len(p) > 0 {
+				nonRoot = append(nonRoot, p)
+			}
+		}
+		ht.Assume(len(nonRoot) > 0)
+		path := pick(ht, nonRoot)
+		ht.Assume(!bracketKey(v, path)) // jsonparser/9, pinned below
+		snapshot := append([]byte(nil), data...)
+		out := Delete(data, path...)
+		if !bytes.Equal(data, snapshot) {
+			ht.Fatalf("Delete mutated its input")
+		}
+		if err := sameDoc(out, deletePath(v, path)); err != nil {
+			ht.Fatalf("Delete(%q) on %s: %v", path, data, err)
+		}
+		if !isIndex(path[len(path)-1]) {
+			if _, dt, _, err := Get(out, path...); err != KeyPathNotFoundError || dt != NotExist {
+				ht.Fatalf("Get after Delete(%q) still finds the key: %v %v", path, dt, err)
+			}
+		}
+		out2, found := DeleteFound(data, path...)
+		if !found || !bytes.Equal(out2, out) {
+			ht.Fatalf("DeleteFound(%q): found=%v, output differs from Delete's", path, found)
+		}
+		miss := missingPath(ht, v, path)
+		out3, found := DeleteFound(data, miss...)
+		if found || !bytes.Equal(out3, data) {
+			ht.Fatalf("DeleteFound(%q) on a missing path: found=%v\n%s", miss, found, out3)
+		}
+		if out4 := Delete(data, miss...); !bytes.Equal(out4, data) {
+			ht.Fatalf("Delete(%q) on a missing path changed the document:\n%s", miss, out4)
+		}
+	})
+}
