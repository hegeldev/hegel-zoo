+func TestHegelSetThenGetAgreesWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v, data := container(ht, 3, true)
+		var paths [][]string
+		allPaths(v, nil, &paths)
+		var candidates [][]string
+		for _, p := range paths {
+			if len(p) > 0 {
+				candidates = append(candidates, p)
+			}
+			if sub, _ := lookup(v, p); chance(ht, 30) {
+				switch x := sub.(type) {
+				case object: // a new key, possibly a chain of new keys
+					np := append(append([]string(nil), p...), freshKey(x, genKey(ht, true)))
+					for extra := n(ht, 0, 2); extra > 0; extra-- {
+						np = append(np, genKey(ht, true))
+					}
+					candidates = append(candidates, np)
+				case []any: // the index just past the end appends
+					candidates = append(candidates, append(append([]string(nil), p...), fmt.Sprintf("[%d]", len(x))))
+				}
+			}
+		}
+		ht.Assume(len(candidates) > 0)
+		path := pick(ht, candidates)
+		nv := genValue(ht, 2, true)
+		valText := render(genStyle(ht), nv)
+		snapshot := append([]byte(nil), data...)
+		out, err := Set(data, valText, path...)
+		if err != nil {
+			ht.Fatalf("Set(%q): %v", path, err)
+		}
+		if !bytes.Equal(data, snapshot) {
+			ht.Fatalf("Set mutated its input")
+		}
+		if err := sameDoc(out, setPath(v, path, nv)); err != nil {
+			ht.Fatalf("Set(%q, %s): %v", path, valText, err)
+		}
+		got, dt, _, gerr := Get(out, path...)
+		if gerr != nil {
+			ht.Fatalf("Get after Set(%q): %v\n%s", path, gerr, out)
+		}
+		if err := sameValue(got, dt, nv); err != nil {
+			ht.Fatalf("Get after Set(%q): %v", path, err)
+		}
+		// SetString escapes for the caller
+		s := genString(ht)
+		out2, err := SetString(data, s, path...)
+		if err != nil {
+			ht.Fatalf("SetString(%q): %v", path, err)
+		}
+		if err := sameDoc(out2, setPath(v, path, s)); err != nil {
+			ht.Fatalf("SetString(%q, %q): %v", path, s, err)
+		}
+		// Config{}.Set is Set
+		out3, err := DefaultConfig.Set(data, valText, path...)
+		if err != nil || !bytes.Equal(out3, out) {
+			ht.Fatalf("DefaultConfig.Set differs from Set: %v\n%s\n%s", err, out3, out)
+		}
+	})
+}
