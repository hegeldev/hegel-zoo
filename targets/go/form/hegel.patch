diff --git a/hegel/hegel_encode_test.go b/hegel/hegel_encode_test.go
new file mode 100644
index 0000000..5d7a126
--- /dev/null
+++ b/hegel/hegel_encode_test.go
@@ -0,0 +1,129 @@
+package hegel
+
+import (
+	"net/url"
+	"reflect"
+	"strconv"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- encoder model
+//
+// doc.go: "Use symbol `.` for separating fields/structs", "Use `[index or key]` for access to
+// index of a slice/array or key for map", "the Encoder attempts to avoid using array indexes
+// in url.Values if at all possible ... however there are times where it is unavoidable, like
+// with pointers", `form:"-"` ignores a field, ",omitempty" omits an empty one, ModeExplicit
+// "only parses values for field with a field tag", AnonymousEmbed "embeds anonymous data",
+// AnonymousSeparate writes it under the embedded field's name, time.Time as RFC3339.
+
+type mEnc struct {
+	o   encOpts
+	out url.Values
+}
+
+// modelEncode is the documented encoding of v.
+func modelEncode(v reflect.Value, o encOpts) url.Values {
+	m := &mEnc{o: o, out: url.Values{}}
+	m.value(v, "", true)
+	return m.out
+}
+
+func (m *mEnc) add(ns, s string) { m.out[ns] = append(m.out[ns], s) }
+
+// value encodes v under ns. plain says v was reached from the root through struct fields
+// and pointers only: there a slice of scalars is written as the values of its own key; deeper
+// (inside a slice or a map) every element is indexed.
+func (m *mEnc) value(v reflect.Value, ns string, plain bool) {
+	for v.Kind() == reflect.Pointer || v.Kind() == reflect.Interface {
+		if v.IsNil() {
+			return
+		}
+		v = v.Elem()
+	}
+	if v.Type() == timeType {
+		m.add(ns, v.Interface().(time.Time).Format(time.RFC3339))
+		return
+	}
+	switch v.Kind() {
+	case reflect.Struct:
+		m.strct(v, ns, plain)
+	case reflect.Map:
+		for _, k := range v.MapKeys() {
+			m.value(v.MapIndex(k), ns+"["+scalarText(k)+"]", false)
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			e := v.Index(i)
+			ins := ns + "[" + strconv.Itoa(i) + "]"
+			if !plain {
+				m.value(e, ins, false)
+				continue
+			}
+			switch e.Kind() {
+			case reflect.Pointer:
+				// pointers are indexed, nil ones skipped, so positions survive
+				m.value(e, ins, false)
+			case reflect.Interface:
+				if e.IsNil() {
+					continue
+				}
+				if Known.nilInterfaceElements && isScalarKind(e.Elem().Kind()) {
+					m.add(ns, scalarText(e.Elem()))
+					continue
+				}
+				m.value(e, ins, false)
+			default:
+				if isScalarKind(e.Kind()) {
+					m.add(ns, scalarText(e))
+				} else {
+					m.value(e, ins, false)
+				}
+			}
+		}
+	default:
+		m.add(ns, scalarText(v))
+	}
+}
+
+func (m *mEnc) strct(v reflect.Value, ns string, plain bool) {
+	t := v.Type()
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		name, omit, skip := m.o.fieldName(f)
+		if skip {
+			continue
+		}
+		fv := v.Field(i)
+		if omit && !hasValue(fv) {
+			continue
+		}
+		if f.Anonymous && !m.o.separate {
+			m.value(fv, ns, plain)
+			continue
+		}
+		m.value(fv, m.o.child(ns, name), plain)
+	}
+}
+
+// TestHegelEncodeModel: Encode writes the documented keys and values.
+func TestHegelEncodeModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		v := genRoot(ht)
+		enc := newEncoder(o)
+		got, err := enc.Encode(v.Addr().Interface())
+		if err != nil {
+			c.failClass(ht, "encode error", "Encode(%s) under %s: %v", v.Type(), o, err)
+			return
+		}
+		want := modelEncode(v, o)
+		c.count("keys " + strconv.Itoa(min(len(want)/5, 6)*5) + "+")
+		if !reflect.DeepEqual(got, want) {
+			c.failClass(ht, "values", "Encode(%s) under %s\n  value %s\n  got\n%s  want\n%s", v.Type(), o, show(v.Interface()), showValues(got), showValues(want))
+		}
+	})
+}
diff --git a/hegel/hegel_indexed_test.go b/hegel/hegel_indexed_test.go
new file mode 100644
index 0000000..300b1ee
--- /dev/null
+++ b/hegel/hegel_indexed_test.go
@@ -0,0 +1,419 @@
+package hegel
+
+import (
+	"net/url"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/go-playground/form/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- indexed keys
+//
+// doc.go: "Supports both Numbered and Normal arrays eg. "Array[0]" and just "Array" with
+// multiple values passed", "Slice honours the specified index ... if slice isn't big enough it
+// will be expanded", "Array honours the specified index ... if array isn't big enough a
+// warning will be printed and value ignored", "Mixing array/slice with array[idx]/slice[idx],
+// in which order are they parsed? array/slice then array[idx]/slice[idx]", "Use `[index or
+// key]` for access to index of a slice/array or key for map", "Only creates objects as
+// necessary", SetMaxArraySize "maximum array size that can be created". An invalid index or
+// map key is an error under the container's namespace; a container nothing was set in stays
+// nil.
+
+type Pair struct {
+	X string
+	Y int8
+}
+
+// Idx is the destination of the generated keys.
+type Idx struct {
+	S  []string
+	A  [3]string
+	PS []*string
+	I  []int8
+	M  map[string]string
+	MI map[int]string
+	SI []Pair
+	MS map[string]Pair
+	SS [][]string
+}
+
+const idxMax = 10 // SetMaxArraySize
+
+var (
+	strToks  = []string{"a", "b", "", "x y"}
+	int8Toks = []string{"1", "-7", "200", "x", ""}
+	indexes  = []string{"0", "0", "1", "1", "2", "3", "4", "5", "9", "10", "12", "x", "-1", "", "1a"}
+	mapKeys  = []string{"a", "b", "", "0", "x.y", " ", "k.X"}
+	intKeys  = []string{"1", "2", "-3", "0", "x", "", "1.5"}
+	junkKeys = []string{"Other", "S.X", "M", "MI", "SI[0]X", "[0]", "SI.X"}
+	// keys the decoder panics on (bug 1)
+	panicKeys = []string{"x]", "x[", "a[b", "]"}
+)
+
+func toks(tc hegel.TestCase, from []string) []string {
+	n := 1
+	if chance(tc, 25) {
+		n = drawInt(tc, 1, 3)
+	}
+	out := make([]string, n)
+	for i := range out {
+		out[i] = pick(tc, from)
+	}
+	return out
+}
+
+// genIdxValues draws url.Values for Idx.
+func genIdxValues(tc hegel.TestCase) url.Values {
+	vals := url.Values{}
+	for n := drawInt(tc, 1, 8); n > 0; n-- {
+		var key string
+		var v []string
+		switch drawInt(tc, 0, 15) {
+		case 0:
+			key, v = "S", toks(tc, strToks)
+		case 1:
+			key, v = "S["+pick(tc, indexes)+"]", toks(tc, strToks)
+		case 2:
+			key, v = "A", toks(tc, strToks)
+		case 3:
+			key, v = "A["+pick(tc, indexes)+"]", toks(tc, strToks)
+		case 4:
+			key, v = "PS", toks(tc, strToks)
+		case 5:
+			key, v = "PS["+pick(tc, indexes)+"]", toks(tc, strToks)
+		case 6:
+			key, v = "I", toks(tc, int8Toks)
+		case 7:
+			key, v = "I["+pick(tc, indexes)+"]", toks(tc, int8Toks)
+		case 8:
+			key, v = "M["+pick(tc, mapKeys)+"]", toks(tc, strToks)
+		case 9:
+			key, v = "MI["+pick(tc, intKeys)+"]", toks(tc, strToks)
+		case 10:
+			key, v = "SI["+pick(tc, indexes)+"].X", toks(tc, strToks)
+		case 11:
+			key, v = "SI["+pick(tc, indexes)+"].Y", toks(tc, int8Toks)
+		case 12:
+			if chance(tc, 50) {
+				key, v = "MS["+pick(tc, mapKeys)+"].X", toks(tc, strToks)
+			} else {
+				key, v = "MS["+pick(tc, mapKeys)+"].Y", toks(tc, int8Toks)
+			}
+		case 13:
+			key, v = "SS["+pick(tc, indexes)+"]["+pick(tc, indexes)+"]", toks(tc, strToks)
+		case 14:
+			// bare element keys: SI[i] counts for the length, SS[i] holds plain values
+			if chance(tc, 50) {
+				key, v = "SI["+pick(tc, indexes)+"]", toks(tc, strToks)
+			} else {
+				key, v = "SS["+pick(tc, indexes)+"]", toks(tc, strToks)
+			}
+		default:
+			if chance(tc, 20) {
+				key, v = pick(tc, panicKeys), toks(tc, strToks)
+			} else {
+				key, v = pick(tc, junkKeys), toks(tc, strToks)
+			}
+		}
+		vals[key] = v
+	}
+	return vals
+}
+
+// panicsOnKey: a ] before any [ or an unclosed [.
+func panicsOnKey(k string) bool {
+	inside := false
+	for i := 0; i < len(k); i++ {
+		switch k[i] {
+		case '[':
+			inside = true
+		case ']':
+			if !inside {
+				return true
+			}
+			inside = false
+		}
+	}
+	return inside
+}
+
+type idxKey struct {
+	raw string
+	i   int    // the index, -1 when not one
+	ns  string // alias + [raw]
+}
+
+type idxModel struct {
+	vals url.Values
+	errs map[string]bool
+}
+
+// entries are the bracketed keys under alias ns: for each ] in a key, the text back to the
+// nearest [ under the alias before that [. sl is one more than the largest index (1 when
+// there is none).
+func (m *idxModel) entries(ns string) (sl int, keys []idxKey) {
+	seen := map[string]bool{}
+	names := make([]string, 0, len(m.vals))
+	for k := range m.vals {
+		names = append(names, k)
+	}
+	sort.Strings(names)
+	maxIdx := 0
+	for _, k := range names {
+		open := -1
+		for p := 0; p < len(k); p++ {
+			switch k[p] {
+			case '[':
+				open = p
+			case ']':
+				if open < 0 {
+					continue
+				}
+				if k[:open] == ns {
+					raw := k[open+1 : p]
+					if !seen[raw] {
+						seen[raw] = true
+						e := idxKey{raw: raw, i: -1, ns: ns + "[" + raw + "]"}
+						if n, err := strconv.Atoi(raw); err == nil && n >= 0 && strings.Trim(raw, "0123456789") == "" {
+							e.i = n
+							if n > maxIdx {
+								maxIdx = n
+							}
+						}
+						keys = append(keys, e)
+					}
+				}
+				open = -1
+			}
+		}
+	}
+	return maxIdx + 1, keys
+}
+
+// field is the model of setting dst from the values under ns; it reports whether dst was set.
+func (m *idxModel) field(dst reflect.Value, ns string) bool {
+	if dst.Type() == timeType || isScalarKind(dst.Kind()) || dst.Kind() == reflect.Pointer || dst.Kind() == reflect.Interface {
+		if dst.Kind() == reflect.Pointer && dst.Type().Elem().Kind() != reflect.String {
+			panic("idxModel: pointer to " + dst.Type().Elem().String())
+		}
+		v, ok := m.vals[ns]
+		if !ok || len(v) == 0 {
+			return false
+		}
+		set, bad := applyToken(dst, v[0])
+		if bad {
+			m.errs[ns] = true
+		}
+		return set
+	}
+	switch dst.Kind() {
+	case reflect.Struct:
+		set := false
+		for i := 0; i < dst.NumField(); i++ {
+			if m.field(dst.Field(i), ns+"."+dst.Type().Field(i).Name) {
+				set = true
+			}
+		}
+		return set
+	case reflect.Slice:
+		return m.slice(dst, ns)
+	case reflect.Array:
+		return m.array(dst, ns)
+	case reflect.Map:
+		return m.mp(dst, ns)
+	}
+	panic("idxModel: " + dst.Type().String())
+}
+
+func (m *idxModel) slice(dst reflect.Value, ns string) bool {
+	t := dst.Type()
+	set := false
+	if plain, ok := m.vals[ns]; ok && len(plain) > 0 {
+		s := reflect.MakeSlice(t, len(plain), len(plain))
+		for i, tok := range plain {
+			e := reflect.New(t.Elem()).Elem()
+			if m.plainElem(e, ns, tok) {
+				set = true
+				s.Index(i).Set(e)
+			}
+		}
+		dst.Set(s)
+	}
+	sl, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return set
+	}
+	var varr reflect.Value
+	switch {
+	case dst.IsNil():
+		if sl > idxMax {
+			m.errs[ns] = true
+			return set
+		}
+		varr = reflect.MakeSlice(t, sl, sl)
+	case dst.Len() < sl:
+		if sl > idxMax {
+			m.errs[ns] = true
+			return set
+		}
+		varr = reflect.MakeSlice(t, sl, sl)
+		reflect.Copy(varr, dst)
+	default:
+		varr = dst
+	}
+	setIdx := false
+	for _, k := range keys {
+		if k.i < 0 {
+			m.errs[ns] = true
+			continue
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns) {
+			setIdx = true
+			varr.Index(k.i).Set(e)
+		}
+	}
+	// the expanded slice is kept once anything was set, by an index or a plain value
+	if set || setIdx {
+		dst.Set(varr)
+	}
+	return set || setIdx
+}
+
+// plainElem is one of the plain values of a slice or array: a scalar, or a pointer to one.
+func (m *idxModel) plainElem(e reflect.Value, ns, tok string) bool {
+	set, bad := applyToken(e, tok)
+	if bad {
+		m.errs[ns] = true
+	}
+	return set
+}
+
+func (m *idxModel) array(dst reflect.Value, ns string) bool {
+	t := dst.Type()
+	set := false
+	if plain, ok := m.vals[ns]; ok && len(plain) > 0 {
+		varr := reflect.New(t).Elem()
+		reflect.Copy(varr, dst)
+		for i, tok := range plain {
+			if i >= t.Len() {
+				break // a warning is printed, the value ignored
+			}
+			e := reflect.New(t.Elem()).Elem()
+			if m.plainElem(e, ns, tok) {
+				set = true
+				varr.Index(i).Set(e)
+			}
+		}
+		dst.Set(varr)
+	}
+	_, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return set
+	}
+	varr := reflect.New(t).Elem()
+	reflect.Copy(varr, dst)
+	setIdx := false
+	for _, k := range keys {
+		if k.i >= t.Len() {
+			continue // a warning is printed, the value ignored
+		}
+		if k.i < 0 {
+			m.errs[ns] = true
+			continue
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns) {
+			setIdx = true
+			varr.Index(k.i).Set(e)
+		}
+	}
+	if set || setIdx {
+		dst.Set(varr)
+	}
+	return set || setIdx
+}
+
+func (m *idxModel) mp(dst reflect.Value, ns string) bool {
+	t := dst.Type()
+	_, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return false
+	}
+	mp := reflect.MakeMap(t)
+	set := false
+	for _, k := range keys {
+		mk := reflect.New(t.Key()).Elem()
+		switch t.Key().Kind() {
+		case reflect.String:
+			mk.SetString(k.raw)
+		case reflect.Int:
+			n, err := strconv.ParseInt(k.raw, 10, 64)
+			if err != nil {
+				m.errs[ns] = true
+				continue
+			}
+			mk.SetInt(n)
+		default:
+			panic("idxModel: map key " + t.Key().String())
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns) {
+			set = true
+			mp.SetMapIndex(mk, e)
+		}
+	}
+	if set {
+		dst.Set(mp)
+	}
+	return set
+}
+
+// TestHegelIndexed: generated keys of the documented forms (plain values, [index], [key],
+// nested, mixed, invalid, beyond the array or the maximum size, unrelated) decode into slices,
+// arrays and maps as documented, with the documented errors.
+func TestHegelIndexed(t *testing.T) {
+	c := newCollector(t)
+	idxType := reflect.TypeOf(Idx{})
+	property(t, func(ht *hegel.T) {
+		vals := genIdxValues(ht)
+		if Known.bracketKeyPanic {
+			for k := range vals {
+				if panicsOnKey(k) {
+					c.count("skipped: key the decoder panics on")
+					return
+				}
+			}
+		}
+		m := &idxModel{vals: vals, errs: map[string]bool{}}
+		want := reflect.New(idxType).Elem()
+		for i := 0; i < want.NumField(); i++ {
+			m.field(want.Field(i), idxType.Field(i).Name)
+		}
+		wantErrs := make([]string, 0, len(m.errs))
+		for k := range m.errs {
+			wantErrs = append(wantErrs, k)
+		}
+		sort.Strings(wantErrs)
+		if len(wantErrs) > 0 {
+			c.count("with errors")
+		}
+		c.count("keys " + strconv.Itoa(len(vals)))
+		dec := form.NewDecoder()
+		dec.SetMaxArraySize(idxMax)
+		got := reflect.New(idxType)
+		err := dec.Decode(got.Interface(), vals)
+		if g, w := strings.Join(errorKeys(err), ","), strings.Join(wantErrs, ","); g != w {
+			c.failClass(ht, "errors", "Decode errors\n%s  got  %q\n  want %q\n  (%v)", showValues(vals), g, w, err)
+			return
+		}
+		if !same(want, got.Elem()) {
+			c.failClass(ht, "value", "Decode into Idx\n%s  want %s\n  got  %s", showValues(vals), show(want.Interface()), show(got.Elem().Interface()))
+		}
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..dba64a6
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,116 @@
+package hegel
+
+import (
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/go-playground/form/v4"
+)
+
+// --------------------------------------------------------------------------- pins
+//
+// One test per recorded bug, asserting the documented behaviour; listed as expected failures
+// in target.toml while the bug exists.
+
+// noPanic runs f and reports a panic as a test failure.
+func noPanic(t *testing.T, f func()) (panicked bool) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("panic: %v", r)
+			panicked = true
+		}
+	}()
+	f()
+	return false
+}
+
+// form/1: a key with a ] before any [ (or an unclosed [) makes Decode panic when the
+// destination has a slice, array, map or nested struct.
+func TestHegelPinBracketKeyPanic(t *testing.T) {
+	var dst struct {
+		S []string
+		N string
+	}
+	noPanic(t, func() {
+		err := form.NewDecoder().Decode(&dst, url.Values{"x]": {"1"}, "N": {"n"}})
+		if dst.N != "n" {
+			t.Errorf("N = %q, want n (err %v)", dst.N, err)
+		}
+	})
+	noPanic(t, func() {
+		_ = form.NewDecoder().Decode(&dst, url.Values{"x[": {"1"}})
+	})
+}
+
+// form/2: Decode panics on an interface{} field that already holds a value.
+func TestHegelPinPrefilledInterface(t *testing.T) {
+	dst := struct{ Any interface{} }{Any: "old"}
+	noPanic(t, func() {
+		if err := form.NewDecoder().Decode(&dst, url.Values{"Any": {"new"}}); err != nil {
+			t.Fatal(err)
+		}
+		if dst.Any != "new" {
+			t.Errorf("Any = %#v, want new", dst.Any)
+		}
+	})
+}
+
+// form/3: nil elements of a slice of interfaces are dropped by the encoder, so the positions
+// of the others are lost (nil pointers keep them, by indexing).
+func TestHegelPinNilInterfaceElements(t *testing.T) {
+	src := struct{ A []interface{} }{A: []interface{}{nil, "a"}}
+	vals, err := form.NewEncoder().Encode(&src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var dst struct{ A []interface{} }
+	if err := form.NewDecoder().Decode(&dst, vals); err != nil {
+		t.Fatal(err)
+	}
+	if len(dst.A) != 2 || dst.A[1] != "a" {
+		t.Errorf("A = %#v from %v, want [nil a]", dst.A, vals)
+	}
+}
+
+// form/4: an unparsable time value zeroes the field and points a nil *time.Time at a zero
+// time, besides the error.
+func TestHegelPinInvalidTimeKeepsValue(t *testing.T) {
+	x := time.Date(2020, 1, 2, 3, 4, 5, 0, time.UTC)
+	dst := struct {
+		T  time.Time
+		PT *time.Time
+	}{T: x}
+	err := form.NewDecoder().Decode(&dst, url.Values{"T": {"garbage"}, "PT": {"garbage"}})
+	if err == nil {
+		t.Fatal("no error")
+	}
+	if !dst.T.Equal(x) {
+		t.Errorf("T = %v, want %v", dst.T, x)
+	}
+	if dst.PT != nil {
+		t.Errorf("PT = %v, want nil", *dst.PT)
+	}
+}
+
+// form/5: map keys with [ or ] are written unescaped and cannot be read back: ] makes the
+// decoder panic, [ loses the entry.
+func TestHegelPinBracketMapKey(t *testing.T) {
+	for _, k := range []string{"a]", "a[b", "[0]"} {
+		src := struct{ M map[string]string }{M: map[string]string{k: "v"}}
+		vals, err := form.NewEncoder().Encode(&src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var dst struct{ M map[string]string }
+		noPanic(t, func() {
+			if err := form.NewDecoder().Decode(&dst, vals); err != nil {
+				t.Errorf("key %q: %v", k, err)
+			}
+			if dst.M[k] != "v" {
+				t.Errorf("key %q: M = %#v from %v", k, dst.M, vals)
+			}
+		})
+	}
+}
diff --git a/hegel/hegel_roundtrip_test.go b/hegel/hegel_roundtrip_test.go
new file mode 100644
index 0000000..5a86dc3
--- /dev/null
+++ b/hegel/hegel_roundtrip_test.go
@@ -0,0 +1,254 @@
+package hegel
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/go-playground/form/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- round trip
+//
+// doc.go: "Decodes url.Values into Go value(s) and Encodes Go value(s) into url.Values ...
+// Handles Encoding & Decoding of almost all Go types eg. can Decode into struct, array, map,
+// int... and Encode a struct, array, map, int...". What Encode writes, Decode with the same
+// settings reads back, up to what the encoding cannot carry: nil and empty are alike, a value
+// that encodes to nothing (an empty slice, a pointer to a struct with nothing to write) is not
+// there, and trailing such elements of a slice are gone with it.
+
+func newEncoder(o encOpts) *form.Encoder {
+	e := form.NewEncoder()
+	if o.explicit {
+		e.SetMode(form.ModeExplicit)
+	}
+	e.SetTagName(o.tag)
+	e.SetNamespacePrefix(o.prefix)
+	e.SetNamespaceSuffix(o.suffix)
+	if o.separate {
+		e.SetAnonymousMode(form.AnonymousSeparate)
+	}
+	return e
+}
+
+func newDecoder(o encOpts, separate bool) *form.Decoder {
+	d := form.NewDecoder()
+	if o.explicit {
+		d.SetMode(form.ModeExplicit)
+	}
+	d.SetTagName(o.tag)
+	d.SetNamespacePrefix(o.prefix)
+	d.SetNamespaceSuffix(o.suffix)
+	if separate {
+		d.SetAnonymousMode(form.AnonymousSeparate)
+	}
+	return d
+}
+
+// norm is the value Decode gives back for Encode(v): what the encoding does not carry is zero.
+func norm(v reflect.Value, o encOpts) reflect.Value {
+	t := v.Type()
+	out := reflect.New(t).Elem()
+	if t == timeType {
+		out.Set(v)
+		return out
+	}
+	switch t.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return out
+		}
+		e := norm(v.Elem(), o)
+		if absent(e, o) {
+			return out
+		}
+		p := reflect.New(t.Elem())
+		p.Elem().Set(e)
+		out.Set(p)
+	case reflect.Interface:
+		if v.IsNil() {
+			return out
+		}
+		out.Set(v)
+	case reflect.Slice:
+		var es []reflect.Value
+		for i := 0; i < v.Len(); i++ {
+			e := v.Index(i)
+			if Known.nilInterfaceElements && e.Kind() == reflect.Interface && e.IsNil() {
+				continue
+			}
+			es = append(es, norm(e, o))
+		}
+		for len(es) > 0 && absent(es[len(es)-1], o) {
+			es = es[:len(es)-1]
+		}
+		if len(es) == 0 {
+			return out
+		}
+		s := reflect.MakeSlice(t, len(es), len(es))
+		for i, e := range es {
+			s.Index(i).Set(e)
+		}
+		out.Set(s)
+	case reflect.Array:
+		for i := 0; i < t.Len(); i++ {
+			out.Index(i).Set(norm(v.Index(i), o))
+		}
+	case reflect.Map:
+		if v.IsNil() {
+			return out
+		}
+		m := reflect.MakeMap(t)
+		for _, k := range v.MapKeys() {
+			e := norm(v.MapIndex(k), o)
+			if absent(e, o) {
+				continue
+			}
+			m.SetMapIndex(k, e)
+		}
+		if m.Len() == 0 {
+			return out
+		}
+		out.Set(m)
+	case reflect.Struct:
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			_, omit, skip := o.fieldName(f)
+			if skip {
+				continue
+			}
+			fv := v.Field(i)
+			if omit && !hasValue(fv) {
+				continue
+			}
+			out.Field(i).Set(norm(fv, o))
+		}
+	default:
+		out.Set(v)
+	}
+	return out
+}
+
+// absent reports whether a normalised value encodes to nothing.
+func absent(v reflect.Value, o encOpts) bool {
+	if v.Type() == timeType {
+		return false
+	}
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Interface, reflect.Map:
+		return v.IsNil()
+	case reflect.Slice:
+		return v.Len() == 0
+	case reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if !absent(v.Index(i), o) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		t := v.Type()
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			_, omit, skip := o.fieldName(f)
+			if skip {
+				continue
+			}
+			fv := v.Field(i)
+			if omit && !hasValue(fv) {
+				continue
+			}
+			if !absent(fv, o) {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+// hasBracketMapKey reports a map key with [ or ] somewhere in the value.
+func hasBracketMapKey(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		return !v.IsNil() && hasBracketMapKey(v.Elem())
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if hasBracketMapKey(v.Index(i)) {
+				return true
+			}
+		}
+	case reflect.Map:
+		for _, k := range v.MapKeys() {
+			if k.Kind() == reflect.String {
+				for _, r := range k.String() {
+					if r == '[' || r == ']' {
+						return true
+					}
+				}
+			}
+			if hasBracketMapKey(v.MapIndex(k)) {
+				return true
+			}
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).PkgPath == "" && hasBracketMapKey(v.Field(i)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// genRoot draws a root type and a value of it.
+func genRoot(tc hegel.TestCase) reflect.Value {
+	rt := outerType
+	if chance(tc, 30) {
+		rt = pick(tc, rootTypes)
+	}
+	return genValue(tc, rt, 2)
+}
+
+// TestHegelRoundTrip: Encode then Decode with the same settings gives the value back (up to
+// what the encoding does not carry); encoding the decoded value gives the same url.Values.
+func TestHegelRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		v := genRoot(ht)
+		rt := v.Type()
+		enc := newEncoder(o)
+		// A decoder in AnonymousEmbed reads both layouts; AnonymousSeparate only its own.
+		decSeparate := o.separate && chance(ht, 50)
+		dec := newDecoder(o, decSeparate)
+		vals, err := enc.Encode(v.Addr().Interface())
+		if err != nil {
+			c.failClass(ht, "encode error", "Encode(%s) under %s: %v", rt, o, err)
+			return
+		}
+		if Known.bracketMapKeys && hasBracketMapKey(v) {
+			c.count("skipped: map key with a bracket")
+			return
+		}
+		c.count("root " + rt.String())
+		got := reflect.New(rt)
+		if err := dec.Decode(got.Interface(), vals); err != nil {
+			c.failClass(ht, "decode error", "Decode(%s) under %s (decoder separate=%v): %v\n%s", rt, o, decSeparate, err, showValues(vals))
+			return
+		}
+		want := norm(v, o)
+		if !same(want, got.Elem()) {
+			c.failClass(ht, "value", "round trip of %s under %s (decoder separate=%v)\n%s  want %s\n  got  %s", rt, o, decSeparate, showValues(vals), show(want.Interface()), show(got.Elem().Interface()))
+			return
+		}
+		vals2, err := enc.Encode(got.Interface())
+		if err != nil {
+			c.failClass(ht, "re-encode error", "Encode of the decoded %s: %v", rt, err)
+			return
+		}
+		if !reflect.DeepEqual(vals, vals2) {
+			c.failClass(ht, "re-encode", "encoding the decoded %s differs under %s\n  first\n%s  again\n%s", rt, o, showValues(vals), showValues(vals2))
+		}
+	})
+}
diff --git a/hegel/hegel_scalars_test.go b/hegel/hegel_scalars_test.go
new file mode 100644
index 0000000..1363687
--- /dev/null
+++ b/hegel/hegel_scalars_test.go
@@ -0,0 +1,221 @@
+package hegel
+
+import (
+	"errors"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-playground/form/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- scalar tokens
+//
+// doc.go lists the supported scalar types and "time.Time - by default using RFC3339"; the
+// decoder parses numbers with strconv in the field's size, booleans with an extended set
+// (1 t T true TRUE True on yes ok / 0 f F false FALSE False off no and the empty string), and
+// collects an error per field namespace in DecodeErrors, leaving the field as it was. A field
+// with no value, or an empty numeric value, is left alone.
+
+// Scalars is decoded into pre-filled, so that an untouched field is told from a zeroed one.
+type Scalars struct {
+	S    string
+	I    int
+	I8   int8
+	I16  int16
+	I32  int32
+	I64  int64
+	U    uint
+	U8   uint8
+	U16  uint16
+	U32  uint32
+	U64  uint64
+	F32  float32
+	F64  float64
+	B    bool
+	T    time.Time
+	PS   *string
+	PI   *int
+	PB   *bool
+	PT   *time.Time
+	Any  interface{}
+	Nest struct {
+		X int8
+		Y bool
+	}
+}
+
+var tokens = []string{
+	"", "0", "1", "-1", "127", "128", "-129", "255", "256", "65535", "65536", "4294967295", "4294967296",
+	"9223372036854775807", "9223372036854775808", "-9223372036854775808", "18446744073709551615",
+	"18446744073709551616", "+5", "0x10", "1e3", "1.5", "-0", "3.4028235e38", "1e39", "1e309", "NaN", "Inf",
+	"-Inf", "infinity", "t", "T", "true", "TRUE", "True", "on", "yes", "ok", "f", "F", "false", "FALSE",
+	"False", "off", "no", "y", "n", "2", " 1", "1 ", "abc", "1_000", "2020-01-02T03:04:05Z",
+	"2020-01-02T03:04:05+02:00", "2020-01-02T03:04:05.123Z", "2020-01-02", "0001-01-01T00:00:00Z",
+	"9999-12-31T23:59:59Z", "10000-01-01T00:00:00Z", "2020-13-01T00:00:00Z", "2020-01-02 03:04:05Z",
+	"2020-01-02t03:04:05z", string(rune(0xe9)),
+}
+
+// parseBoolExt is the documented boolean vocabulary.
+func parseBoolExt(s string) (bool, bool) {
+	switch s {
+	case "1", "t", "T", "true", "TRUE", "True", "on", "yes", "ok":
+		return true, true
+	case "", "0", "f", "F", "false", "FALSE", "False", "off", "no":
+		return false, true
+	}
+	return false, false
+}
+
+// applyToken is the model of one value on a scalar or time destination: set says the
+// destination was written, bad that an error is recorded.
+func applyToken(dst reflect.Value, tok string) (set, bad bool) {
+	if dst.Type() == timeType {
+		if tok == "" {
+			return false, false
+		}
+		x, err := time.Parse(time.RFC3339, tok)
+		if err != nil {
+			if Known.invalidTimeZeroes {
+				dst.Set(reflect.ValueOf(time.Time{}))
+				return true, true
+			}
+			return false, true
+		}
+		dst.Set(reflect.ValueOf(x))
+		return true, false
+	}
+	switch dst.Kind() {
+	case reflect.String:
+		dst.SetString(tok)
+		return true, false
+	case reflect.Interface:
+		dst.Set(reflect.ValueOf(tok))
+		return true, false
+	case reflect.Bool:
+		b, ok := parseBoolExt(tok)
+		if !ok {
+			return false, true
+		}
+		dst.SetBool(b)
+		return true, false
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if tok == "" {
+			return false, false
+		}
+		x, err := strconv.ParseInt(tok, 10, dst.Type().Bits())
+		if err != nil {
+			return false, true
+		}
+		dst.SetInt(x)
+		return true, false
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if tok == "" {
+			return false, false
+		}
+		x, err := strconv.ParseUint(tok, 10, dst.Type().Bits())
+		if err != nil {
+			return false, true
+		}
+		dst.SetUint(x)
+		return true, false
+	case reflect.Float32, reflect.Float64:
+		if tok == "" {
+			return false, false
+		}
+		x, err := strconv.ParseFloat(tok, dst.Type().Bits())
+		if err != nil {
+			return false, true
+		}
+		dst.SetFloat(x)
+		return true, false
+	case reflect.Pointer:
+		if dst.IsNil() {
+			tmp := reflect.New(dst.Type().Elem())
+			set, bad = applyToken(tmp.Elem(), tok)
+			if set {
+				dst.Set(tmp)
+			}
+			return set, bad
+		}
+		return applyToken(dst.Elem(), tok)
+	}
+	panic("applyToken: " + dst.Type().String())
+}
+
+// errorKeys are the namespaces of a DecodeErrors, sorted.
+func errorKeys(err error) []string {
+	if err == nil {
+		return nil
+	}
+	var de form.DecodeErrors
+	if !errors.As(err, &de) {
+		return []string{"<" + err.Error() + ">"}
+	}
+	keys := make([]string, 0, len(de))
+	for k := range de {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// TestHegelScalars: the value of each scalar field of a pre-filled struct is parsed as the
+// documentation says, an unparsable value is an error under the field's namespace and leaves
+// the field as it was.
+func TestHegelScalars(t *testing.T) {
+	c := newCollector(t)
+	scalarsType := reflect.TypeOf(Scalars{})
+	property(t, func(ht *hegel.T) {
+		pre := genValue(ht, scalarsType, 1)
+		if Known.prefilledInterfacePanic {
+			pre.FieldByName("Any").Set(reflect.Zero(pre.FieldByName("Any").Type()))
+		}
+		got := reflect.New(scalarsType)
+		got.Elem().Set(pre)
+		want := reflect.New(scalarsType).Elem()
+		want.Set(pre)
+		vals := map[string][]string{}
+		var wantErrs []string
+		var walk func(dst reflect.Value, ns string)
+		walk = func(dst reflect.Value, ns string) {
+			if dst.Kind() == reflect.Struct && dst.Type() != timeType {
+				for i := 0; i < dst.NumField(); i++ {
+					walk(dst.Field(i), ns+"."+dst.Type().Field(i).Name)
+				}
+				return
+			}
+			if !chance(ht, 60) {
+				return
+			}
+			toks := []string{pick(ht, tokens)}
+			if chance(ht, 20) {
+				toks = append(toks, pick(ht, tokens))
+			}
+			vals[ns] = toks
+			if _, bad := applyToken(dst, toks[0]); bad {
+				wantErrs = append(wantErrs, ns)
+			}
+		}
+		for i := 0; i < want.NumField(); i++ {
+			walk(want.Field(i), want.Type().Field(i).Name)
+		}
+		sort.Strings(wantErrs)
+		c.count("fields " + strconv.Itoa(min(len(vals)/5, 4)*5) + "+")
+		if len(wantErrs) > 0 {
+			c.count("with errors")
+		}
+		err := form.NewDecoder().Decode(got.Interface(), vals)
+		if g, w := strings.Join(errorKeys(err), ","), strings.Join(wantErrs, ","); g != w {
+			c.failClass(ht, "errors", "Decode errors\n%s  got  %q\n  want %q\n  (%v)", showValues(vals), g, w, err)
+			return
+		}
+		if !same(want, got.Elem()) {
+			c.failClass(ht, "value", "Decode into a pre-filled Scalars\n%s  pre  %s\n  want %s\n  got  %s", showValues(vals), show(pre.Interface()), show(want.Interface()), show(got.Elem().Interface()))
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..c5cb865
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,586 @@
+package hegel
+
+// Hegel property tests for go-playground/form, written for the Hegel zoo. See
+// targets/go/form/README.md.
+//
+// Oracles: the Encode -> Decode round trip over generated values of a type universe covering
+// every supported kind (scalars, time.Time, pointers, slices, arrays, maps, nested and embedded
+// structs, interfaces) and the encoder/decoder options (mode, tag name, namespace prefix and
+// suffix, anonymous mode); a model of the documented encoding (dot paths, [index] and [key],
+// plain slices, omitempty, ignore tags); strconv, parseBool and time.Parse on the tokens of
+// scalar fields; a model of the documented slice/array/map key semantics.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	bracketKeyPanic         bool // 1: Decode panics on a key with a ] before any [ or an unclosed [ when the destination has a slice, array, map or nested struct
+	prefilledInterfacePanic bool // 2: Decode panics (unaddressable value) on an interface{} field or element that already holds a value
+	nilInterfaceElements    bool // 3: the encoder drops nil elements of a slice of interfaces without indexing the rest, so their positions are lost
+	invalidTimeZeroes       bool // 4: an unparsable time value zeroes the field (and points a nil *time.Time at a zero time) besides the error
+	bracketMapKeys          bool // 5: the encoder writes map keys containing [ or ] unescaped, so the decoder panics on or ignores them
+}{true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- type universe
+
+// Leaf holds every scalar kind and a time.
+type Leaf struct {
+	S   string
+	I   int
+	I8  int8
+	U16 uint16
+	F32 float32
+	F64 float64
+	B   bool
+	T   time.Time
+}
+
+// Inner: tags (ignore, rename, omitempty, a second tag name), pointers, plain slices and
+// arrays, maps with every scalar key kind, an interface.
+type Inner struct {
+	Leaf
+	Tag  string `form:"tag" q:"t"`
+	Skip string `form:"-"`
+	Opt  string `form:"opt,omitempty"`
+	OptI int    `form:",omitempty"`
+	OptP *int   `form:"optp,omitempty"`
+	PS   *string
+	PI   *int8
+	SS   []string
+	AI   [3]int
+	M    map[string]int
+	MU   map[uint8]string
+	MB   map[bool]string
+	MF   map[float64]bool
+	Any  interface{}
+	Q    string `q:"quoted"`
+	priv int
+}
+
+// Embedded and PtrEmb are embedded in Outer by value and by pointer.
+type Embedded struct {
+	EA string
+	EB []int
+}
+
+type PtrEmb struct {
+	PA string
+	PB *string
+}
+
+// Outer: nested structs directly, behind pointers, in slices, arrays and maps; nested slices
+// and maps; slices of pointers, interfaces and times.
+type Outer struct {
+	Embedded
+	*PtrEmb
+	In   Inner
+	PIn  *Inner
+	Ins  []Inner
+	PIns []*Inner
+	AIn  [2]Inner
+	MI   map[string]Inner
+	MPI  map[string]*Inner
+	SS   [][]string
+	SPS  []*string
+	MS   map[int]map[string]string
+	MSl  map[string][]string
+	AnyS []interface{}
+	Arr  [2]*int
+	Ts   []time.Time
+	PT   *time.Time
+	Name string `form:"name" q:"nm"`
+}
+
+var (
+	timeType  = reflect.TypeOf(time.Time{})
+	outerType = reflect.TypeOf(Outer{})
+	// rootTypes are the other root values Encode and Decode accept.
+	rootTypes = []reflect.Type{
+		reflect.TypeOf(Inner{}),
+		reflect.TypeOf(Leaf{}),
+		reflect.TypeOf([]Inner{}),
+		reflect.TypeOf([]*string{}),
+		reflect.TypeOf([]string{}),
+		reflect.TypeOf([2]Inner{}),
+		reflect.TypeOf(map[string]int{}),
+		reflect.TypeOf(map[string]Inner{}),
+		reflect.TypeOf(map[int][]string{}),
+		reflect.TypeOf([][]string{}),
+		reflect.TypeOf(""),
+		reflect.TypeOf(0),
+		reflect.TypeOf(time.Time{}),
+	}
+)
+
+// stringAtoms are the string values and map keys; the brackets and dots are the key syntax.
+var stringAtoms = []string{
+	"", "a", "b", "hello world", "x.y", ".", "[", "]", "a[0]", "k]", "1", "0", "-1", "true", "on", "no",
+	"0001-01-01T00:00:00Z", "\n", " lead", "trail ", "a=b&c", "%41", string(rune(0xe9)), string(rune(0x1f600)),
+}
+
+var floatAtoms = []float64{0, 1, -1, 0.1, -0.5, 1.5, 3.14159, 1e10, 1e-7, 123456789.125, 1e300, -1e300,
+	3.4028234663852886e38, 1e39, mathInf(1), mathInf(-1), negZero()}
+
+func mathInf(sign int) float64 {
+	if sign > 0 {
+		return 1 / zeroF()
+	}
+	return -1 / zeroF()
+}
+
+func zeroF() float64   { return 0 }
+func negZero() float64 { return -zeroF() }
+
+var zones = []*time.Location{time.UTC, time.FixedZone("p2", 2*3600), time.FixedZone("m5", -5*3600-30*60),
+	time.FixedZone("p14", 14*3600), time.FixedZone("m12", -12*3600)}
+
+func genTime(tc hegel.TestCase) time.Time {
+	if chance(tc, 15) {
+		return time.Time{}
+	}
+	sec := drawInt(tc, -62135596800+12*3600, 253402300799-14*3600) // years 1 to 9999 in every zone
+	return time.Unix(int64(sec), 0).In(pick(tc, zones))
+}
+
+// genValue makes a random value of type t. Interfaces hold strings or nothing; floats and
+// times stay finite and at second precision (NaN and sub-second times cannot round trip by
+// design); unexported fields stay zero.
+func genValue(tc hegel.TestCase, t reflect.Type, depth int) reflect.Value {
+	v := reflect.New(t).Elem()
+	if t == timeType {
+		v.Set(reflect.ValueOf(genTime(tc)))
+		return v
+	}
+	switch t.Kind() {
+	case reflect.Pointer:
+		if chance(tc, 35) {
+			return v
+		}
+		p := reflect.New(t.Elem())
+		p.Elem().Set(genValue(tc, t.Elem(), depth))
+		v.Set(p)
+	case reflect.Interface:
+		if chance(tc, 35) {
+			return v
+		}
+		v.Set(reflect.ValueOf(pick(tc, stringAtoms)))
+	case reflect.Slice:
+		if chance(tc, 30) {
+			return v
+		}
+		n := drawInt(tc, 0, 3)
+		if depth <= 0 && t.Elem().Kind() != reflect.String {
+			n = drawInt(tc, 0, 1)
+		}
+		s := reflect.MakeSlice(t, n, n)
+		for i := 0; i < n; i++ {
+			s.Index(i).Set(genValue(tc, t.Elem(), depth-1))
+		}
+		v.Set(s)
+	case reflect.Array:
+		for i := 0; i < t.Len(); i++ {
+			v.Index(i).Set(genValue(tc, t.Elem(), depth-1))
+		}
+	case reflect.Map:
+		if chance(tc, 30) {
+			return v
+		}
+		n := drawInt(tc, 0, 3)
+		if depth <= 0 {
+			n = drawInt(tc, 0, 1)
+		}
+		m := reflect.MakeMap(t)
+		for i := 0; i < n; i++ {
+			k := genValue(tc, t.Key(), 0)
+			if t.Key().Kind() == reflect.String {
+				// brackets in a map key are bug 5: rare, so that few cases are skipped
+				for strings.ContainsAny(k.String(), "[]") && !chance(tc, 3) {
+					k = genValue(tc, t.Key(), 0)
+				}
+			}
+			m.SetMapIndex(k, genValue(tc, t.Elem(), depth-1))
+		}
+		v.Set(m)
+	case reflect.Struct:
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			v.Field(i).Set(genValue(tc, f.Type, depth))
+		}
+	case reflect.String:
+		v.SetString(pick(tc, stringAtoms))
+	case reflect.Bool:
+		v.SetBool(chance(tc, 50))
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		bits := t.Bits()
+		var x int64
+		switch drawInt(tc, 0, 3) {
+		case 0:
+			x = int64(drawInt(tc, -5, 5))
+		case 1:
+			x = int64(drawInt(tc, -128, 127))
+		case 2:
+			x = 1<<(bits-1) - 1
+		default:
+			x = -1 << (bits - 1)
+		}
+		v.SetInt(x)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		bits := t.Bits()
+		var x uint64
+		switch drawInt(tc, 0, 2) {
+		case 0:
+			x = uint64(drawInt(tc, 0, 5))
+		case 1:
+			x = uint64(drawInt(tc, 0, 255))
+		default:
+			x = 1<<bits - 1
+		}
+		v.SetUint(x)
+	case reflect.Float32, reflect.Float64:
+		v.SetFloat(pick(tc, floatAtoms))
+	default:
+		panic("genValue: " + t.String())
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- options
+
+// encOpts are the settings shared by an Encoder and a Decoder.
+type encOpts struct {
+	explicit bool   // ModeExplicit: only tagged fields
+	tag      string // tag name
+	prefix   string
+	suffix   string
+	separate bool // AnonymousSeparate
+}
+
+func genOpts(tc hegel.TestCase) encOpts {
+	o := encOpts{tag: "form", prefix: "."}
+	if chance(tc, 25) {
+		o.explicit = true
+	}
+	if chance(tc, 25) {
+		o.tag = "q"
+	}
+	switch drawInt(tc, 0, 9) {
+	case 0:
+		o.prefix, o.suffix = "[", "]"
+	case 1:
+		o.prefix, o.suffix = "_", ""
+	case 2:
+		o.prefix, o.suffix = "", ""
+	case 3:
+		o.prefix, o.suffix = ".", "!"
+	}
+	if chance(tc, 30) {
+		o.separate = true
+	}
+	return o
+}
+
+func (o encOpts) String() string {
+	return fmt.Sprintf("explicit=%v tag=%q prefix=%q suffix=%q separate=%v", o.explicit, o.tag, o.prefix, o.suffix, o.separate)
+}
+
+// fieldName applies the tag rules: "-" and unexported (non-embedded) fields are skipped,
+// ModeExplicit skips untagged fields, ",omitempty" is split off, an empty name is the field's.
+func (o encOpts) fieldName(f reflect.StructField) (name string, omitEmpty, skip bool) {
+	if f.PkgPath != "" && !f.Anonymous {
+		return "", false, true
+	}
+	name = f.Tag.Get(o.tag)
+	if name == "-" {
+		return "", false, true
+	}
+	if o.explicit && name == "" {
+		return "", false, true
+	}
+	if i := strings.LastIndexByte(name, ','); i >= 0 {
+		omitEmpty = name[i+1:] == "omitempty"
+		name = name[:i]
+	}
+	if name == "" {
+		name = f.Name
+	}
+	return name, omitEmpty, false
+}
+
+// child is the namespace of a struct field.
+func (o encOpts) child(ns, name string) string {
+	if ns == "" {
+		return name
+	}
+	return ns + o.prefix + name + o.suffix
+}
+
+// hasValue is the encoder's omitempty test: nil-able kinds are empty when nil, comparable
+// values when zero, other values never.
+func hasValue(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.Slice, reflect.Map, reflect.Pointer, reflect.Interface, reflect.Chan, reflect.Func:
+		return !v.IsNil()
+	}
+	if !v.Type().Comparable() {
+		return true
+	}
+	return !v.IsZero()
+}
+
+// --------------------------------------------------------------------------- comparison
+
+func isScalarKind(k reflect.Kind) bool {
+	switch k {
+	case reflect.String, reflect.Bool, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Float32, reflect.Float64:
+		return true
+	}
+	return false
+}
+
+// scalarText is the encoder's text for a scalar (and a map key).
+func scalarText(v reflect.Value) string {
+	switch v.Kind() {
+	case reflect.String:
+		return v.String()
+	case reflect.Bool:
+		return strconv.FormatBool(v.Bool())
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return strconv.FormatInt(v.Int(), 10)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return strconv.FormatUint(v.Uint(), 10)
+	case reflect.Float32:
+		return strconv.FormatFloat(v.Float(), 'f', -1, 32)
+	case reflect.Float64:
+		return strconv.FormatFloat(v.Float(), 'f', -1, 64)
+	}
+	panic("scalarText: " + v.Type().String())
+}
+
+// same compares two values of one type: times by Equal, nil and empty slices and maps alike,
+// unexported fields ignored.
+func same(a, b reflect.Value) bool {
+	if a.Type() == timeType {
+		return a.Interface().(time.Time).Equal(b.Interface().(time.Time))
+	}
+	switch a.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() && b.IsNil()
+		}
+		if a.Kind() == reflect.Interface && a.Elem().Type() != b.Elem().Type() {
+			return false
+		}
+		return same(a.Elem(), b.Elem())
+	case reflect.Slice:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Array:
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for _, k := range a.MapKeys() {
+			bv := b.MapIndex(k)
+			if !bv.IsValid() || !same(a.MapIndex(k), bv) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			if a.Type().Field(i).PkgPath != "" {
+				continue
+			}
+			if !same(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Float32, reflect.Float64:
+		return a.Float() == b.Float() || (a.Float() != a.Float() && b.Float() != b.Float())
+	case reflect.String:
+		return a.String() == b.String()
+	case reflect.Bool:
+		return a.Bool() == b.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return a.Int() == b.Int()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return a.Uint() == b.Uint()
+	}
+	panic("same: " + a.Type().String())
+}
+
+// show prints a value for a failure message.
+func show(v interface{}) string {
+	s := fmt.Sprintf("%+v", v)
+	if len(s) > 1500 {
+		s = s[:1500] + "..."
+	}
+	return s
+}
+
+// showValues prints url.Values with sorted keys.
+func showValues(vals map[string][]string) string {
+	keys := make([]string, 0, len(vals))
+	for k := range vals {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var sb strings.Builder
+	for _, k := range keys {
+		fmt.Fprintf(&sb, "  %q: %q\n", k, vals[k])
+	}
+	return sb.String()
+}
