@@ -0,0 +1,611 @@
+package hegel
+
+// Hegel property tests for go-playground/form, written for the Hegel zoo. See
+// targets/go/form/README.md.
+//
+// Oracles: the Encode -> Decode round trip over generated values of a type universe covering
+// every supported kind (scalars, time.Time, pointers, slices, arrays, maps, nested and embedded
+// structs, interfaces) and the encoder/decoder options (mode, tag name, namespace prefix and
+// suffix, anonymous mode); a model of the documented encoding (dot paths, [index] and [key],
+// plain slices, omitempty, ignore tags); strconv, parseBool and time.Parse on the tokens of
+// scalar fields; a model of the documented slice/array/map key semantics; a model of Decode
+// into pre-filled destinations over the whole universe; custom type functions on both sides
+// against the encoder and decoder models.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	bracketKeyPanic         bool // 1: Decode panics on a key with a ] before any [ or an unclosed [ when the destination has a slice, array, map or nested struct
+	prefilledInterfacePanic bool // 2: Decode panics (unaddressable value) on an interface{} field or element that already holds a value
+	nilInterfaceElements    bool // 3: the encoder drops nil elements of a slice of interfaces without indexing the rest, so their positions are lost
+	invalidTimeZeroes       bool // 4: an unparsable time value zeroes the field (and points a nil *time.Time at a zero time) besides the error
+	bracketMapKeys          bool // 5: the encoder writes map keys containing [ or ] unescaped, so the decoder panics on or ignores them
+}{true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- type universe
+
+// Leaf holds every scalar kind and a time.
+type Leaf struct {
+	S   string
+	I   int
+	I8  int8
+	U16 uint16
+	F32 float32
+	F64 float64
+	B   bool
+	T   time.Time
+}
+
+// Inner: tags (ignore, rename, omitempty, a second tag name), pointers, plain slices and
+// arrays, maps with every scalar key kind, an interface.
+type Inner struct {
+	Leaf
+	Tag  string `form:"tag" q:"t"`
+	Skip string `form:"-"`
+	Opt  string `form:"opt,omitempty"`
+	OptI int    `form:",omitempty"`
+	OptP *int   `form:"optp,omitempty"`
+	PS   *string
+	PI   *int8
+	SS   []string
+	AI   [3]int
+	M    map[string]int
+	MU   map[uint8]string
+	MB   map[bool]string
+	MF   map[float64]bool
+	Any  interface{}
+	Q    string `q:"quoted"`
+	priv int
+}
+
+// Embedded and PtrEmb are embedded in Outer by value and by pointer.
+type Embedded struct {
+	EA string
+	EB []int
+}
+
+type PtrEmb struct {
+	PA string
+	PB *string
+}
+
+// Outer: nested structs directly, behind pointers, in slices, arrays and maps; nested slices
+// and maps; slices of pointers, interfaces and times.
+type Outer struct {
+	Embedded
+	*PtrEmb
+	In   Inner
+	PIn  *Inner
+	Ins  []Inner
+	PIns []*Inner
+	AIn  [2]Inner
+	MI   map[string]Inner
+	MPI  map[string]*Inner
+	SS   [][]string
+	SPS  []*string
+	MS   map[int]map[string]string
+	MSl  map[string][]string
+	AnyS []interface{}
+	Arr  [2]*int
+	Ts   []time.Time
+	PT   *time.Time
+	Name string `form:"name" q:"nm"`
+}
+
+var (
+	timeType  = reflect.TypeOf(time.Time{})
+	outerType = reflect.TypeOf(Outer{})
+	// rootTypes are the other root values Encode and Decode accept.
+	rootTypes = []reflect.Type{
+		reflect.TypeOf(Inner{}),
+		reflect.TypeOf(Leaf{}),
+		reflect.TypeOf([]Inner{}),
+		reflect.TypeOf([]*string{}),
+		reflect.TypeOf([]string{}),
+		reflect.TypeOf([2]Inner{}),
+		reflect.TypeOf(map[string]int{}),
+		reflect.TypeOf(map[string]Inner{}),
+		reflect.TypeOf(map[int][]string{}),
+		reflect.TypeOf([][]string{}),
+		reflect.TypeOf(""),
+		reflect.TypeOf(0),
+		reflect.TypeOf(time.Time{}),
+	}
+)
+
+// stringAtoms are the string values and map keys; the brackets and dots are the key syntax.
+var stringAtoms = []string{
+	"", "a", "b", "hello world", "x.y", ".", "[", "]", "a[0]", "k]", "1", "0", "-1", "true", "on", "no",
+	"0001-01-01T00:00:00Z", "\n", " lead", "trail ", "a=b&c", "%41", string(rune(0xe9)), string(rune(0x1f600)),
+}
+
+var floatAtoms = []float64{0, 1, -1, 0.1, -0.5, 1.5, 3.14159, 1e10, 1e-7, 123456789.125, 1e300, -1e300,
+	3.4028234663852886e38, 1e39, mathInf(1), mathInf(-1), negZero()}
+
+func mathInf(sign int) float64 {
+	if sign > 0 {
+		return 1 / zeroF()
+	}
+	return -1 / zeroF()
+}
+
+func zeroF() float64   { return 0 }
+func negZero() float64 { return -zeroF() }
+
+var zones = []*time.Location{time.UTC, time.FixedZone("p2", 2*3600), time.FixedZone("m5", -5*3600-30*60),
+	time.FixedZone("p14", 14*3600), time.FixedZone("m12", -12*3600)}
+
+func genTime(tc hegel.TestCase) time.Time {
+	if chance(tc, 15) {
+		return time.Time{}
+	}
+	sec := drawInt(tc, -62135596800+12*3600, 253402300799-14*3600) // years 1 to 9999 in every zone
+	return time.Unix(int64(sec), 0).In(pick(tc, zones))
+}
+
+// genValue makes a random value of type t. Interfaces hold strings or nothing; floats and
+// times stay finite and at second precision (NaN and sub-second times cannot round trip by
+// design); unexported fields stay zero.
+func genValue(tc hegel.TestCase, t reflect.Type, depth int) reflect.Value {
+	v := reflect.New(t).Elem()
+	if t == timeType {
+		v.Set(reflect.ValueOf(genTime(tc)))
+		return v
+	}
+	switch t.Kind() {
+	case reflect.Pointer:
+		if chance(tc, 35) {
+			return v
+		}
+		p := reflect.New(t.Elem())
+		p.Elem().Set(genValue(tc, t.Elem(), depth))
+		v.Set(p)
+	case reflect.Interface:
+		if chance(tc, 35) {
+			return v
+		}
+		v.Set(reflect.ValueOf(pick(tc, stringAtoms)))
+	case reflect.Slice:
+		if chance(tc, 30) {
+			return v
+		}
+		n := drawInt(tc, 0, 3)
+		if depth <= 0 && t.Elem().Kind() != reflect.String {
+			n = drawInt(tc, 0, 1)
+		}
+		s := reflect.MakeSlice(t, n, n)
+		for i := 0; i < n; i++ {
+			s.Index(i).Set(genValue(tc, t.Elem(), depth-1))
+		}
+		v.Set(s)
+	case reflect.Array:
+		for i := 0; i < t.Len(); i++ {
+			v.Index(i).Set(genValue(tc, t.Elem(), depth-1))
+		}
+	case reflect.Map:
+		if chance(tc, 30) {
+			return v
+		}
+		n := drawInt(tc, 0, 3)
+		if depth <= 0 {
+			n = drawInt(tc, 0, 1)
+		}
+		m := reflect.MakeMap(t)
+		for i := 0; i < n; i++ {
+			k := genValue(tc, t.Key(), 0)
+			if t.Key().Kind() == reflect.String {
+				// brackets in a map key are bug 5: rare, so that few cases are skipped
+				for strings.ContainsAny(k.String(), "[]") && !chance(tc, 3) {
+					k = genValue(tc, t.Key(), 0)
+				}
+			}
+			m.SetMapIndex(k, genValue(tc, t.Elem(), depth-1))
+		}
+		v.Set(m)
+	case reflect.Struct:
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			v.Field(i).Set(genValue(tc, f.Type, depth))
+		}
+	case reflect.String:
+		v.SetString(pick(tc, stringAtoms))
+	case reflect.Bool:
+		v.SetBool(chance(tc, 50))
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		bits := t.Bits()
+		var x int64
+		switch drawInt(tc, 0, 3) {
+		case 0:
+			x = int64(drawInt(tc, -5, 5))
+		case 1:
+			x = int64(drawInt(tc, -128, 127))
+		case 2:
+			x = 1<<(bits-1) - 1
+		default:
+			x = -1 << (bits - 1)
+		}
+		v.SetInt(x)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		bits := t.Bits()
+		var x uint64
+		switch drawInt(tc, 0, 2) {
+		case 0:
+			x = uint64(drawInt(tc, 0, 5))
+		case 1:
+			x = uint64(drawInt(tc, 0, 255))
+		default:
+			x = 1<<bits - 1
+		}
+		v.SetUint(x)
+	case reflect.Float32, reflect.Float64:
+		v.SetFloat(pick(tc, floatAtoms))
+	default:
+		panic("genValue: " + t.String())
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- options
+
+// encOpts are the settings shared by an Encoder and a Decoder.
+type encOpts struct {
+	explicit bool   // ModeExplicit: only tagged fields
+	tag      string // tag name
+	prefix   string
+	suffix   string
+	separate bool // AnonymousSeparate
+	tagFn    int  // RegisterTagNameFunc: 0 none, 1 lower-case field names, 2 the q tag through the function
+}
+
+func genOpts(tc hegel.TestCase) encOpts {
+	o := encOpts{tag: "form", prefix: "."}
+	if chance(tc, 25) {
+		o.explicit = true
+	}
+	if chance(tc, 25) {
+		o.tag = "q"
+	}
+	switch drawInt(tc, 0, 9) {
+	case 0:
+		o.prefix, o.suffix = "[", "]"
+	case 1:
+		o.prefix, o.suffix = "_", ""
+	case 2:
+		o.prefix, o.suffix = "", ""
+	case 3:
+		o.prefix, o.suffix = ".", "!"
+	}
+	if chance(tc, 30) {
+		o.separate = true
+	}
+	if chance(tc, 20) {
+		o.tagFn = drawInt(tc, 1, 2)
+		if o.tagFn == 1 && o.prefix == "" {
+			// lower-case names with no separator collide (In.S and Ins both "ins")
+			o.prefix = "."
+		}
+	}
+	return o
+}
+
+// tagNameFunc is the registered TagNameFunc of a tagFn variant.
+func (o encOpts) tagNameFunc() func(f reflect.StructField) string {
+	switch o.tagFn {
+	case 1:
+		return func(f reflect.StructField) string { return strings.ToLower(f.Name) }
+	case 2:
+		return func(f reflect.StructField) string { return f.Tag.Get("q") }
+	}
+	return nil
+}
+
+func (o encOpts) String() string {
+	return fmt.Sprintf("explicit=%v tag=%q prefix=%q suffix=%q separate=%v tagFn=%d", o.explicit, o.tag, o.prefix, o.suffix, o.separate, o.tagFn)
+}
+
+// fieldName applies the tag rules: "-" and unexported (non-embedded) fields are skipped,
+// ModeExplicit skips untagged fields, ",omitempty" is split off, an empty name is the field's.
+func (o encOpts) fieldName(f reflect.StructField) (name string, omitEmpty, skip bool) {
+	if f.PkgPath != "" && !f.Anonymous {
+		return "", false, true
+	}
+	if fn := o.tagNameFunc(); fn != nil {
+		name = fn(f)
+	} else {
+		name = f.Tag.Get(o.tag)
+	}
+	if name == "-" {
+		return "", false, true
+	}
+	if o.explicit && name == "" {
+		return "", false, true
+	}
+	if i := strings.LastIndexByte(name, ','); i >= 0 {
+		omitEmpty = name[i+1:] == "omitempty"
+		name = name[:i]
+	}
+	if name == "" {
+		name = f.Name
+	}
+	return name, omitEmpty, false
+}
+
+// child is the namespace of a struct field.
+func (o encOpts) child(ns, name string) string {
+	if ns == "" {
+		return name
+	}
+	return ns + o.prefix + name + o.suffix
+}
+
+// hasValue is the encoder's omitempty test: nil-able kinds are empty when nil, comparable
+// values when zero, other values never.
+func hasValue(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.Slice, reflect.Map, reflect.Pointer, reflect.Interface, reflect.Chan, reflect.Func:
+		return !v.IsNil()
+	}
+	if !v.Type().Comparable() {
+		return true
+	}
+	return !v.IsZero()
+}
+
+// --------------------------------------------------------------------------- comparison
+
+func isScalarKind(k reflect.Kind) bool {
+	switch k {
+	case reflect.String, reflect.Bool, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Float32, reflect.Float64:
+		return true
+	}
+	return false
+}
+
+// scalarText is the encoder's text for a scalar (and a map key).
+func scalarText(v reflect.Value) string {
+	switch v.Kind() {
+	case reflect.String:
+		return v.String()
+	case reflect.Bool:
+		return strconv.FormatBool(v.Bool())
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return strconv.FormatInt(v.Int(), 10)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return strconv.FormatUint(v.Uint(), 10)
+	case reflect.Float32:
+		return strconv.FormatFloat(v.Float(), 'f', -1, 32)
+	case reflect.Float64:
+		return strconv.FormatFloat(v.Float(), 'f', -1, 64)
+	}
+	panic("scalarText: " + v.Type().String())
+}
+
+// same compares two values of one type: times by Equal, nil and empty slices and maps alike,
+// unexported fields ignored.
+func same(a, b reflect.Value) bool {
+	if a.Type() == timeType {
+		return a.Interface().(time.Time).Equal(b.Interface().(time.Time))
+	}
+	switch a.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() && b.IsNil()
+		}
+		if a.Kind() == reflect.Interface && a.Elem().Type() != b.Elem().Type() {
+			return false
+		}
+		return same(a.Elem(), b.Elem())
+	case reflect.Slice:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Array:
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for _, k := range a.MapKeys() {
+			bv := b.MapIndex(k)
+			if !bv.IsValid() || !same(a.MapIndex(k), bv) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			if a.Type().Field(i).PkgPath != "" {
+				continue
+			}
+			if !same(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Float32, reflect.Float64:
+		return a.Float() == b.Float() || (a.Float() != a.Float() && b.Float() != b.Float())
+	case reflect.String:
+		return a.String() == b.String()
+	case reflect.Bool:
+		return a.Bool() == b.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return a.Int() == b.Int()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return a.Uint() == b.Uint()
+	}
+	panic("same: " + a.Type().String())
+}
+
+// show prints a value for a failure message.
+func show(v interface{}) string {
+	s := fmt.Sprintf("%+v", v)
+	if len(s) > 1500 {
+		s = s[:1500] + "..."
+	}
+	return s
+}
+
+// showValues prints url.Values with sorted keys.
+func showValues(vals map[string][]string) string {
+	keys := make([]string, 0, len(vals))
+	for k := range vals {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var sb strings.Builder
+	for _, k := range keys {
+		fmt.Fprintf(&sb, "  %q: %q\n", k, vals[k])
+	}
+	return sb.String()
+}
