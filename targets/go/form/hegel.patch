diff --git a/hegel/hegel_custom_test.go b/hegel/hegel_custom_test.go
new file mode 100644
index 0000000..8f5e664
--- /dev/null
+++ b/hegel/hegel_custom_test.go
@@ -0,0 +1,317 @@
+package hegel
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-playground/form/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- custom type functions
+//
+// doc.go: "Allows for Custom Type registration ... `custom types` can override any of the
+// above types"; a decoder function `func([]string) (interface{}, error)` gets the values of
+// the field and returns the value to set (nil leaves the field alone, since v4.3.1), an
+// encoder function `func(interface{}) ([]string, error)` returns the values to write; either
+// may fail with an error recorded under the field's namespace. "if a struct type is
+// registered, the function will only be called if a url.Value exists for the struct and not
+// just the struct fields". Registered types replace the built-in handling of time.Time too.
+// Map keys "must be possible to print to a string ... or have a custom type function".
+
+// Color is a string type, Money a struct type, both with custom functions.
+type Color string
+
+type Money struct{ Cents int }
+
+type CustIn struct {
+	C Color
+	M Money
+}
+
+// Cust has custom-typed fields in every position: direct, behind a pointer, in slices and
+// arrays, as map keys and values, in nested structs, in slices and maps of structs.
+type Cust struct {
+	C   Color
+	PC  *Color
+	CS  []Color
+	CA  [2]Color
+	MC  map[Color]string
+	MVC map[string]Color
+	M   Money
+	PM  *Money
+	MS  []Money
+	MM  map[string]Money
+	MK  map[Money]int
+	T   time.Time
+	PT  *time.Time
+	TS  []time.Time
+	In  CustIn
+	Ins []CustIn
+	MI  map[string]CustIn
+	Opt Color `form:"opt,omitempty"`
+	Sk  Color `form:"-"`
+	S   string
+}
+
+var custType = reflect.TypeOf(Cust{})
+
+// custShape are the variants of the custom functions of one test case.
+type custShape struct {
+	moneyTwo bool // Money is written as two values (cents, "cents") instead of one
+	timeFn   bool // time.Time has a custom function (a date) instead of RFC3339
+	colorErr bool // the Color functions fail on the text "bad"
+}
+
+const dateLayout = "2006-01-02"
+
+func (s custShape) colorEnc(x interface{}) ([]string, error) {
+	c := string(x.(Color))
+	if s.colorErr && c == "bad" {
+		return nil, errors.New("bad color")
+	}
+	return []string{"c:" + c}, nil
+}
+
+func (s custShape) colorDec(v []string) (interface{}, error) {
+	if len(v) == 0 {
+		return nil, nil
+	}
+	c := strings.TrimPrefix(v[0], "c:")
+	if s.colorErr && c == "bad" {
+		return nil, errors.New("bad color")
+	}
+	return Color(c), nil
+}
+
+func (s custShape) moneyEnc(x interface{}) ([]string, error) {
+	m := x.(Money)
+	if s.moneyTwo {
+		return []string{strconv.Itoa(m.Cents), "cents"}, nil
+	}
+	return []string{strconv.Itoa(m.Cents)}, nil
+}
+
+func (s custShape) moneyDec(v []string) (interface{}, error) {
+	if len(v) == 0 {
+		return nil, nil
+	}
+	n, err := strconv.Atoi(v[0])
+	if err != nil {
+		return nil, fmt.Errorf("money: %v", err)
+	}
+	return Money{Cents: n}, nil
+}
+
+func (s custShape) timeEnc(x interface{}) ([]string, error) {
+	return []string{x.(time.Time).Format(dateLayout)}, nil
+}
+
+func (s custShape) timeDec(v []string) (interface{}, error) {
+	if len(v) == 0 {
+		return nil, nil
+	}
+	return time.Parse(dateLayout, v[0])
+}
+
+func (s custShape) register(e *form.Encoder, d *form.Decoder) {
+	e.RegisterCustomTypeFunc(s.colorEnc, Color(""))
+	e.RegisterCustomTypeFunc(s.moneyEnc, Money{})
+	d.RegisterCustomTypeFunc(s.colorDec, Color(""))
+	d.RegisterCustomTypeFunc(s.moneyDec, Money{})
+	if s.timeFn {
+		e.RegisterCustomTypeFunc(s.timeEnc, time.Time{})
+		d.RegisterCustomTypeFunc(s.timeDec, time.Time{})
+	}
+}
+
+// encHooks are the encoder model's view of the custom functions.
+func (s custShape) encHooks() map[reflect.Type]func(reflect.Value) ([]string, error) {
+	h := map[reflect.Type]func(reflect.Value) ([]string, error){
+		reflect.TypeOf(Color("")): func(v reflect.Value) ([]string, error) { return s.colorEnc(v.Interface()) },
+		reflect.TypeOf(Money{}):   func(v reflect.Value) ([]string, error) { return s.moneyEnc(v.Interface()) },
+	}
+	if s.timeFn {
+		h[timeType] = func(v reflect.Value) ([]string, error) { return s.timeEnc(v.Interface()) }
+	}
+	return h
+}
+
+func (s custShape) decHooks() map[reflect.Type]func([]string) (interface{}, error) {
+	h := map[reflect.Type]func([]string) (interface{}, error){
+		reflect.TypeOf(Color("")): s.colorDec,
+		reflect.TypeOf(Money{}):   s.moneyDec,
+	}
+	if s.timeFn {
+		h[timeType] = s.timeDec
+	}
+	return h
+}
+
+var colorAtoms = []Color{"", "red", "bad", "x y", "c:z", "1", "[", "k]"}
+
+// genCust makes a Cust; interfaces are not involved, times are at day precision when the
+// date function is on.
+func genCust(tc hegel.TestCase, s custShape) reflect.Value {
+	v := genValue(tc, custType, 2)
+	var fix func(x reflect.Value)
+	fix = func(x reflect.Value) {
+		switch x.Kind() {
+		case reflect.Pointer:
+			if !x.IsNil() {
+				fix(x.Elem())
+			}
+		case reflect.Slice, reflect.Array:
+			for i := 0; i < x.Len(); i++ {
+				fix(x.Index(i))
+			}
+		case reflect.Map:
+			for _, k := range x.MapKeys() {
+				e := deepCopy(x.MapIndex(k))
+				fix(e)
+				nk := deepCopy(k)
+				fix(nk)
+				// a bracket in a map key is bug 5: rare, so that few cases are skipped
+				for nk.Kind() == reflect.String && strings.ContainsAny(nk.String(), "[]") && !chance(tc, 5) {
+					fix(nk)
+				}
+				x.SetMapIndex(k, reflect.Value{})
+				x.SetMapIndex(nk, e)
+			}
+		case reflect.Struct:
+			if x.Type() == timeType {
+				if s.timeFn {
+					t := x.Interface().(time.Time)
+					x.Set(reflect.ValueOf(time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, time.UTC)))
+				}
+				return
+			}
+			for i := 0; i < x.NumField(); i++ {
+				fix(x.Field(i))
+			}
+		case reflect.String:
+			if x.Type() == reflect.TypeOf(Color("")) {
+				x.SetString(string(pick(tc, colorAtoms)))
+			}
+		}
+	}
+	fix(v)
+	return v
+}
+
+// hasColor reports whether the value holds the text somewhere in a Color (including keys).
+func hasColor(v reflect.Value, text Color) bool {
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		return !v.IsNil() && hasColor(v.Elem(), text)
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if hasColor(v.Index(i), text) {
+				return true
+			}
+		}
+	case reflect.Map:
+		for _, k := range v.MapKeys() {
+			if hasColor(k, text) || hasColor(v.MapIndex(k), text) {
+				return true
+			}
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if hasColor(v.Field(i), text) {
+				return true
+			}
+		}
+	case reflect.String:
+		return v.Type() == reflect.TypeOf(Color("")) && Color(v.String()) == text
+	}
+	return false
+}
+
+// TestHegelCustomTypes: with custom functions registered on both sides, Encode writes what the
+// encoder model says (custom values indexed in slices, a map key's first value, an error under
+// the namespace) and Decode reads the value back; the decoder model agrees on a pre-filled
+// destination.
+func TestHegelCustomTypes(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		if o.explicit && chance(ht, 70) {
+			o.explicit = false // Cust is mostly untagged
+		}
+		s := custShape{moneyTwo: chance(ht, 50), timeFn: chance(ht, 50), colorErr: chance(ht, 30)}
+		enc := newEncoder(o)
+		decSeparate := o.separate && chance(ht, 50)
+		dec := newDecoder(o, decSeparate)
+		s.register(enc, dec)
+		src := genCust(ht, s)
+		if Known.bracketMapKeys && hasBracketMapKey(src) {
+			c.count("skipped: map key with a bracket")
+			return
+		}
+		got, err := enc.Encode(src.Addr().Interface())
+		want, wantErrs := modelEncodeWith(src, o, s.encHooks())
+		if g, w := strings.Join(errorKeys(err), ","), strings.Join(wantErrs, ","); g != w {
+			c.failClass(ht, "encode errors", "Encode(Cust) errors under %s %+v\n  got  %q\n  want %q\n  (%v)", o, s, g, w, err)
+			return
+		}
+		if len(wantErrs) > 0 {
+			c.count("encode errors")
+		}
+		if !reflect.DeepEqual(got, want) {
+			c.failClass(ht, "encode", "Encode(Cust) under %s %+v\n  value %s\n  got\n%s  want\n%s", o, s, show(src.Interface()), showValues(got), showValues(want))
+			return
+		}
+		if len(wantErrs) > 0 {
+			return
+		}
+		// the round trip: what the encoding carries comes back
+		back := reflect.New(custType)
+		if err := dec.Decode(back.Interface(), got); err != nil {
+			if s.colorErr && hasColor(src, "bad") {
+				c.count("decode error on bad")
+				return
+			}
+			c.failClass(ht, "decode error", "Decode(Cust) under %s %+v: %v\n%s", o, s, err, showValues(got))
+			return
+		}
+		if !same(norm(src, o), back.Elem()) {
+			c.failClass(ht, "round trip", "round trip of Cust under %s %+v\n%s  want %s\n  got  %s", o, s, showValues(got), show(norm(src, o).Interface()), show(back.Elem().Interface()))
+			return
+		}
+		// the decoder model on a pre-filled destination
+		dst := genCust(ht, s)
+		if chance(ht, 30) {
+			for k, vs := range got {
+				if chance(ht, 20) {
+					vs[drawInt(ht, 0, len(vs)-1)] = pick(ht, tokens)
+					got[k] = vs
+				}
+			}
+		}
+		wantDst := deepCopy(dst)
+		m := &decModel{o: o, separate: decSeparate, vals: got, errs: map[string]bool{}, custom: s.decHooks()}
+		m.root(wantDst)
+		wantDecErrs := make([]string, 0, len(m.errs))
+		for k := range m.errs {
+			wantDecErrs = append(wantDecErrs, k)
+		}
+		sort.Strings(wantDecErrs)
+		gotDst := reflect.New(custType)
+		gotDst.Elem().Set(dst)
+		err = dec.Decode(gotDst.Interface(), got)
+		if g, w := strings.Join(errorKeys(err), ","), strings.Join(wantDecErrs, ","); g != w {
+			c.failClass(ht, "decode errors", "Decode(Cust) errors under %s %+v\n%s  got  %q\n  want %q\n  (%v)", o, s, showValues(got), g, w, err)
+			return
+		}
+		if !same(wantDst, gotDst.Elem()) {
+			c.failClass(ht, "decode", "Decode(Cust) into a pre-filled value under %s %+v\n%s  pre  %s\n  want %s\n  got  %s", o, s, showValues(got), show(dst.Interface()), show(wantDst.Interface()), show(gotDst.Elem().Interface()))
+		}
+	})
+}
diff --git a/hegel/hegel_decode_test.go b/hegel/hegel_decode_test.go
new file mode 100644
index 0000000..4d7d8ac
--- /dev/null
+++ b/hegel/hegel_decode_test.go
@@ -0,0 +1,512 @@
+package hegel
+
+import (
+	"net/url"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- decoder model
+//
+// A model of Decode over the whole type universe, into a destination that already holds a
+// value. doc.go: "Only creates objects as necessary eg. if no `array` or `map` values are
+// passed down, the `array` and `map` are left as their default values in the struct"; the
+// struct fields present in the values are set (nested structs, also behind a non-nil pointer,
+// field by field), a slice's plain values are appended after its existing elements and its
+// indexed values set in place (expanding it), an array's indices are set in place, a map's
+// entries are added or replaced, and an unparsable value leaves its field alone with an error
+// under the field's namespace. The values are the encoding of another value of the same type
+// under the same settings, some tokens replaced by arbitrary ones, plus unrelated keys.
+
+type decModel struct {
+	o        encOpts
+	separate bool
+	vals     url.Values
+	errs     map[string]bool
+	custom   map[reflect.Type]func([]string) (interface{}, error)
+}
+
+// root is Decode(&dst, vals) on the model's side.
+func (m *decModel) root(dst reflect.Value) {
+	if dst.Kind() == reflect.Struct && dst.Type() != timeType {
+		m.strct(dst, "")
+		return
+	}
+	m.field(dst, "", 0)
+}
+
+// entries are the bracketed keys under alias ns: for each ] in a key, the text back to the
+// nearest [ before it, when the text before that [ is ns. maxIdx is the largest index (0 when
+// there is none).
+func (m *decModel) entries(ns string) (maxIdx int, keys []idxKey) {
+	seen := map[string]bool{}
+	names := make([]string, 0, len(m.vals))
+	for k := range m.vals {
+		names = append(names, k)
+	}
+	sort.Strings(names)
+	for _, k := range names {
+		open := -1
+		for p := 0; p < len(k); p++ {
+			switch k[p] {
+			case '[':
+				open = p
+			case ']':
+				if open < 0 {
+					continue
+				}
+				if k[:open] == ns {
+					raw := k[open+1 : p]
+					if !seen[raw] {
+						seen[raw] = true
+						e := idxKey{raw: raw, i: -1, ns: ns + "[" + raw + "]"}
+						if raw != "" && strings.Trim(raw, "0123456789") == "" {
+							if n, err := strconv.Atoi(raw); err == nil {
+								e.i = n
+								if n > maxIdx {
+									maxIdx = n
+								}
+							}
+						}
+						keys = append(keys, e)
+					}
+				}
+				open = -1
+			}
+		}
+	}
+	return maxIdx, keys
+}
+
+// field sets dst from the values under ns (the idx-th of them for a scalar) and reports
+// whether it was set.
+func (m *decModel) field(dst reflect.Value, ns string, idx int) bool {
+	v := dst
+	for (v.Kind() == reflect.Pointer || v.Kind() == reflect.Interface) && !v.IsNil() {
+		v = v.Elem()
+	}
+	arr, ok := m.vals[ns]
+	if ok && m.custom != nil {
+		if cf, found := m.custom[v.Type()]; found {
+			val, err := cf(arr[idx:])
+			if err != nil {
+				m.errs[ns] = true
+				return false
+			}
+			if val == nil {
+				return false
+			}
+			v.Set(reflect.ValueOf(val))
+			return true
+		}
+	}
+	if v.Type() == timeType || isScalarKind(v.Kind()) || v.Kind() == reflect.Interface {
+		if !ok || idx >= len(arr) {
+			return false
+		}
+		set, bad := applyToken(v, arr[idx])
+		if bad {
+			m.errs[ns] = true
+		}
+		return set
+	}
+	switch v.Kind() {
+	case reflect.Pointer: // nil
+		nv := reflect.New(v.Type().Elem())
+		if m.field(nv.Elem(), ns, idx) {
+			v.Set(nv)
+			return true
+		}
+		return false
+	case reflect.Struct:
+		return m.strct(v, ns)
+	case reflect.Slice:
+		return m.slice(v, ns)
+	case reflect.Array:
+		return m.array(v, ns)
+	case reflect.Map:
+		return m.mp(v, ns)
+	}
+	panic("decModel: " + v.Type().String())
+}
+
+func (m *decModel) strct(v reflect.Value, ns string) bool {
+	t := v.Type()
+	set := false
+	// anonymous fields come last (the struct cache sorts them so)
+	var order []int
+	for i := 0; i < t.NumField(); i++ {
+		if !t.Field(i).Anonymous {
+			order = append(order, i)
+		}
+	}
+	for i := 0; i < t.NumField(); i++ {
+		if t.Field(i).Anonymous {
+			order = append(order, i)
+		}
+	}
+	for _, i := range order {
+		f := t.Field(i)
+		name, _, skip := m.o.fieldName(f)
+		if skip {
+			continue
+		}
+		if f.Anonymous && !m.separate {
+			if m.field(v.Field(i), ns, 0) {
+				set = true
+			}
+		}
+		if m.field(v.Field(i), m.o.child(ns, name), 0) {
+			set = true
+		}
+	}
+	return set
+}
+
+func (m *decModel) slice(v reflect.Value, ns string) bool {
+	t := v.Type()
+	set := false
+	if plain, ok := m.vals[ns]; ok && len(plain) > 0 {
+		ol := 0
+		if !v.IsNil() {
+			ol = v.Len()
+		}
+		l := ol + len(plain)
+		s := reflect.MakeSlice(t, l, l)
+		reflect.Copy(s, v)
+		for i := ol; i < l; i++ {
+			e := reflect.New(t.Elem()).Elem()
+			if m.field(e, ns, i-ol) {
+				set = true
+				s.Index(i).Set(e)
+			}
+		}
+		v.Set(s)
+	}
+	maxIdx, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return set
+	}
+	sl := maxIdx + 1
+	var varr reflect.Value
+	switch {
+	case v.IsNil():
+		if sl > decMax {
+			m.errs[ns] = true
+			return set
+		}
+		varr = reflect.MakeSlice(t, sl, sl)
+	case v.Len() < sl:
+		if v.Cap() <= sl && sl > decMax {
+			m.errs[ns] = true
+			return set
+		}
+		varr = reflect.MakeSlice(t, sl, sl)
+		reflect.Copy(varr, v)
+	default:
+		varr = v
+	}
+	for _, k := range keys {
+		if k.i < 0 {
+			m.errs[ns] = true
+			continue
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns, 0) {
+			set = true
+			varr.Index(k.i).Set(e)
+		}
+	}
+	if set {
+		v.Set(varr)
+	}
+	return set
+}
+
+func (m *decModel) array(v reflect.Value, ns string) bool {
+	t := v.Type()
+	set := false
+	if plain, ok := m.vals[ns]; ok && len(plain) > 0 {
+		varr := reflect.New(t).Elem()
+		reflect.Copy(varr, v)
+		for i := range plain {
+			if i >= t.Len() {
+				break
+			}
+			e := reflect.New(t.Elem()).Elem()
+			if m.field(e, ns, i) {
+				set = true
+				varr.Index(i).Set(e)
+			}
+		}
+		v.Set(varr)
+	}
+	_, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return set
+	}
+	varr := reflect.New(t).Elem()
+	reflect.Copy(varr, v)
+	for _, k := range keys {
+		if k.i >= t.Len() {
+			continue
+		}
+		if k.i < 0 {
+			m.errs[ns] = true
+			continue
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns, 0) {
+			set = true
+			varr.Index(k.i).Set(e)
+		}
+	}
+	if set {
+		v.Set(varr)
+	}
+	return set
+}
+
+// mapKey parses a map key as the decoder does; false with an error recorded.
+func (m *decModel) mapKey(raw string, mk reflect.Value, ns string) bool {
+	if m.custom != nil {
+		if cf, found := m.custom[mk.Type()]; found {
+			val, err := cf([]string{raw})
+			if err != nil || val == nil {
+				m.errs[ns] = true // a nil value would panic (bug 7): the property never returns one
+				return false
+			}
+			mk.Set(reflect.ValueOf(val))
+			return true
+		}
+	}
+	switch mk.Kind() {
+	case reflect.Interface:
+		mk.Set(reflect.ValueOf(raw))
+		return true
+	case reflect.String:
+		mk.SetString(raw)
+		return true
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		x, err := strconv.ParseInt(raw, 10, mk.Type().Bits())
+		if err != nil {
+			m.errs[ns] = true
+			return false
+		}
+		mk.SetInt(x)
+		return true
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		x, err := strconv.ParseUint(raw, 10, mk.Type().Bits())
+		if err != nil {
+			m.errs[ns] = true
+			return false
+		}
+		mk.SetUint(x)
+		return true
+	case reflect.Float32, reflect.Float64:
+		x, err := strconv.ParseFloat(raw, mk.Type().Bits())
+		if err != nil {
+			m.errs[ns] = true
+			return false
+		}
+		mk.SetFloat(x)
+		return true
+	case reflect.Bool:
+		b, ok := parseBoolExt(raw)
+		if !ok {
+			m.errs[ns] = true
+			return false
+		}
+		mk.SetBool(b)
+		return true
+	}
+	m.errs[ns] = true
+	return false
+}
+
+func (m *decModel) mp(v reflect.Value, ns string) bool {
+	t := v.Type()
+	_, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return false
+	}
+	existing := !v.IsNil()
+	mp := v
+	if !existing {
+		mp = reflect.MakeMap(t)
+	}
+	set := false
+	for _, k := range keys {
+		mk := reflect.New(t.Key()).Elem()
+		if !m.mapKey(k.raw, mk, ns) {
+			continue
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns, 0) {
+			set = true
+			mp.SetMapIndex(mk, e)
+		}
+	}
+	if set && !existing {
+		v.Set(mp)
+	}
+	return set
+}
+
+const decMax = 10000 // the decoder's default maximum array size
+
+// deepCopy copies a value of the universe (unexported fields stay zero).
+func deepCopy(v reflect.Value) reflect.Value {
+	t := v.Type()
+	out := reflect.New(t).Elem()
+	if t == timeType {
+		out.Set(v)
+		return out
+	}
+	switch t.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return out
+		}
+		p := reflect.New(t.Elem())
+		p.Elem().Set(deepCopy(v.Elem()))
+		out.Set(p)
+	case reflect.Interface:
+		if !v.IsNil() {
+			out.Set(deepCopy(v.Elem()))
+		}
+	case reflect.Slice:
+		if v.IsNil() {
+			return out
+		}
+		s := reflect.MakeSlice(t, v.Len(), v.Len())
+		for i := 0; i < v.Len(); i++ {
+			s.Index(i).Set(deepCopy(v.Index(i)))
+		}
+		out.Set(s)
+	case reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			out.Index(i).Set(deepCopy(v.Index(i)))
+		}
+	case reflect.Map:
+		if v.IsNil() {
+			return out
+		}
+		mp := reflect.MakeMap(t)
+		for _, k := range v.MapKeys() {
+			mp.SetMapIndex(deepCopy(k), deepCopy(v.MapIndex(k)))
+		}
+		out.Set(mp)
+	case reflect.Struct:
+		for i := 0; i < t.NumField(); i++ {
+			if t.Field(i).PkgPath == "" {
+				out.Field(i).Set(deepCopy(v.Field(i)))
+			}
+		}
+	default:
+		out.Set(v)
+	}
+	return out
+}
+
+// zeroInterfaces clears the interface fields the decoder would set in place (bug 2): those
+// reachable through struct fields, pointers, slices and arrays (map entries are replaced).
+func zeroInterfaces(v reflect.Value) {
+	switch v.Kind() {
+	case reflect.Interface:
+		v.Set(reflect.Zero(v.Type()))
+	case reflect.Pointer:
+		if !v.IsNil() {
+			zeroInterfaces(v.Elem())
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			zeroInterfaces(v.Index(i))
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).PkgPath == "" {
+				zeroInterfaces(v.Field(i))
+			}
+		}
+	}
+}
+
+// junkKeys are keys of Outer's shapes that match no encoding, or match other fields' kinds.
+var decJunkKeys = []string{"Nope", "In", "Ins", "SS", "MI", "Ts", "Arr", "name.X", "In.SS[0]", "Ts[0]", "Arr[1]",
+	"Ins[x].S", "MI[k]", "PIn", "PIns[0]", "AIn[5].S", "SS[1]", "MSl[k]", "In.M[k]", "In.AI[2]", "Embedded.EA", "EB[1]"}
+
+// TestHegelDecodeModel: Decode of generated values into a pre-filled value of the universe
+// gives the modelled value and error namespaces.
+func TestHegelDecodeModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		rt := outerType
+		if chance(ht, 25) {
+			rt = pick(ht, rootTypes)
+		}
+		src := genValue(ht, rt, 2)
+		if Known.bracketMapKeys && hasBracketMapKey(src) {
+			c.count("skipped: map key with a bracket")
+			return
+		}
+		vals, err := newEncoder(o).Encode(src.Addr().Interface())
+		if err != nil {
+			c.failClass(ht, "encode error", "Encode(%s) under %s: %v", rt, o, err)
+			return
+		}
+		// some tokens replaced by arbitrary ones, some unrelated keys
+		if chance(ht, 40) {
+			for k, vs := range vals {
+				if chance(ht, 15) {
+					vs[drawInt(ht, 0, len(vs)-1)] = pick(ht, tokens)
+					vals[k] = vs
+				}
+			}
+			c.count("tokens replaced")
+		}
+		if rt == outerType && chance(ht, 40) {
+			for n := drawInt(ht, 1, 3); n > 0; n-- {
+				vals[pick(ht, decJunkKeys)] = toks(ht, tokens)
+			}
+			c.count("junk keys")
+		}
+		dst := genValue(ht, rt, 2)
+		if Known.prefilledInterfacePanic {
+			zeroInterfaces(dst)
+		}
+		if chance(ht, 20) {
+			dst = reflect.New(rt).Elem()
+			c.count("zero destination")
+		}
+		want := deepCopy(dst)
+		decSeparate := o.separate && chance(ht, 50)
+		m := &decModel{o: o, separate: decSeparate, vals: vals, errs: map[string]bool{}}
+		m.root(want)
+		wantErrs := make([]string, 0, len(m.errs))
+		for k := range m.errs {
+			wantErrs = append(wantErrs, k)
+		}
+		sort.Strings(wantErrs)
+		if len(wantErrs) > 0 {
+			c.count("with errors")
+		}
+		c.count("root " + rt.String())
+		got := reflect.New(rt)
+		got.Elem().Set(dst)
+		err = newDecoder(o, decSeparate).Decode(got.Interface(), vals)
+		if g, w := strings.Join(errorKeys(err), ","), strings.Join(wantErrs, ","); g != w {
+			c.failClass(ht, "errors", "Decode(%s) errors under %s (decoder separate=%v)\n%s  got  %q\n  want %q\n  (%v)", rt, o, decSeparate, showValues(vals), g, w, err)
+			return
+		}
+		if !same(want, got.Elem()) {
+			c.failClass(ht, "value", "Decode(%s) into a pre-filled value under %s (decoder separate=%v)\n%s  pre  %s\n  want %s\n  got  %s", rt, o, decSeparate, showValues(vals), show(dst.Interface()), show(want.Interface()), show(got.Elem().Interface()))
+		}
+	})
+}
diff --git a/hegel/hegel_encode_test.go b/hegel/hegel_encode_test.go
new file mode 100644
index 0000000..d595c42
--- /dev/null
+++ b/hegel/hegel_encode_test.go
@@ -0,0 +1,184 @@
+package hegel
+
+import (
+	"net/url"
+	"reflect"
+	"sort"
+	"strconv"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- encoder model
+//
+// doc.go: "Use symbol `.` for separating fields/structs", "Use `[index or key]` for access to
+// index of a slice/array or key for map", "the Encoder attempts to avoid using array indexes
+// in url.Values if at all possible ... however there are times where it is unavoidable, like
+// with pointers", `form:"-"` ignores a field, ",omitempty" omits an empty one, ModeExplicit
+// "only parses values for field with a field tag", AnonymousEmbed "embeds anonymous data",
+// AnonymousSeparate writes it under the embedded field's name, time.Time as RFC3339.
+
+type mEnc struct {
+	o     encOpts
+	out   url.Values
+	hooks map[reflect.Type]func(reflect.Value) ([]string, error) // custom type functions
+	errs  map[string]bool
+}
+
+// modelEncode is the documented encoding of v.
+func modelEncode(v reflect.Value, o encOpts) url.Values {
+	out, _ := modelEncodeWith(v, o, nil)
+	return out
+}
+
+// modelEncodeWith is modelEncode with custom type functions; it also returns the sorted
+// namespaces of the errors they raised.
+func modelEncodeWith(v reflect.Value, o encOpts, hooks map[reflect.Type]func(reflect.Value) ([]string, error)) (url.Values, []string) {
+	m := &mEnc{o: o, out: url.Values{}, hooks: hooks, errs: map[string]bool{}}
+	m.value(v, "", true)
+	errs := make([]string, 0, len(m.errs))
+	for k := range m.errs {
+		errs = append(errs, k)
+	}
+	sort.Strings(errs)
+	return m.out, errs
+}
+
+// custom writes v with its custom function under valNS; an error is recorded under errNS
+// (the encoder records it before adding an element's index).
+func (m *mEnc) custom(v reflect.Value, valNS, errNS string) bool {
+	h, ok := m.hooks[v.Type()]
+	if !ok {
+		return false
+	}
+	strs, err := h(v)
+	if err != nil {
+		m.errs[errNS] = true
+		return true
+	}
+	for _, s := range strs {
+		m.add(valNS, s)
+	}
+	return true
+}
+
+// keyText is the encoder's text for a map key; false when its custom function fails.
+func (m *mEnc) keyText(k reflect.Value, ns string) (string, bool) {
+	if h, ok := m.hooks[k.Type()]; ok {
+		strs, err := h(k)
+		if err != nil {
+			m.errs[ns] = true
+			return "", false
+		}
+		return strs[0], true
+	}
+	return scalarText(k), true
+}
+
+func (m *mEnc) add(ns, s string) { m.out[ns] = append(m.out[ns], s) }
+
+// value encodes v under ns. plain says v was reached from the root through struct fields
+// and pointers only: there a slice of scalars is written as the values of its own key; deeper
+// (inside a slice or a map) every element is indexed.
+func (m *mEnc) value(v reflect.Value, ns string, plain bool) {
+	for v.Kind() == reflect.Pointer || v.Kind() == reflect.Interface {
+		if v.IsNil() {
+			return
+		}
+		v = v.Elem()
+	}
+	if m.custom(v, ns, ns) {
+		return
+	}
+	if v.Type() == timeType {
+		m.add(ns, v.Interface().(time.Time).Format(time.RFC3339))
+		return
+	}
+	switch v.Kind() {
+	case reflect.Struct:
+		m.strct(v, ns, plain)
+	case reflect.Map:
+		for _, k := range v.MapKeys() {
+			text, ok := m.keyText(k, ns)
+			if !ok {
+				continue
+			}
+			m.value(v.MapIndex(k), ns+"["+text+"]", false)
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			e := v.Index(i)
+			ins := ns + "[" + strconv.Itoa(i) + "]"
+			if !plain {
+				m.value(e, ins, false)
+				continue
+			}
+			switch e.Kind() {
+			case reflect.Pointer:
+				// pointers are indexed, nil ones skipped, so positions survive
+				m.value(e, ins, false)
+			case reflect.Interface:
+				if e.IsNil() {
+					continue
+				}
+				if Known.nilInterfaceElements && isScalarKind(e.Elem().Kind()) {
+					m.add(ns, scalarText(e.Elem()))
+					continue
+				}
+				m.value(e, ins, false)
+			default:
+				if m.custom(e, ins, ns) {
+					// custom values are indexed, the error under the slice's namespace
+				} else if isScalarKind(e.Kind()) {
+					m.add(ns, scalarText(e))
+				} else {
+					m.value(e, ins, false)
+				}
+			}
+		}
+	default:
+		m.add(ns, scalarText(v))
+	}
+}
+
+func (m *mEnc) strct(v reflect.Value, ns string, plain bool) {
+	t := v.Type()
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		name, omit, skip := m.o.fieldName(f)
+		if skip {
+			continue
+		}
+		fv := v.Field(i)
+		if omit && !hasValue(fv) {
+			continue
+		}
+		if f.Anonymous && !m.o.separate {
+			m.value(fv, ns, plain)
+			continue
+		}
+		m.value(fv, m.o.child(ns, name), plain)
+	}
+}
+
+// TestHegelEncodeModel: Encode writes the documented keys and values.
+func TestHegelEncodeModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		v := genRoot(ht)
+		enc := newEncoder(o)
+		got, err := enc.Encode(v.Addr().Interface())
+		if err != nil {
+			c.failClass(ht, "encode error", "Encode(%s) under %s: %v", v.Type(), o, err)
+			return
+		}
+		want := modelEncode(v, o)
+		c.count("keys " + strconv.Itoa(min(len(want)/5, 6)*5) + "+")
+		if !reflect.DeepEqual(got, want) {
+			c.failClass(ht, "values", "Encode(%s) under %s\n  value %s\n  got\n%s  want\n%s", v.Type(), o, show(v.Interface()), showValues(got), showValues(want))
+		}
+	})
+}
diff --git a/hegel/hegel_indexed_test.go b/hegel/hegel_indexed_test.go
new file mode 100644
index 0000000..300b1ee
--- /dev/null
+++ b/hegel/hegel_indexed_test.go
@@ -0,0 +1,419 @@
+package hegel
+
+import (
+	"net/url"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/go-playground/form/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- indexed keys
+//
+// doc.go: "Supports both Numbered and Normal arrays eg. "Array[0]" and just "Array" with
+// multiple values passed", "Slice honours the specified index ... if slice isn't big enough it
+// will be expanded", "Array honours the specified index ... if array isn't big enough a
+// warning will be printed and value ignored", "Mixing array/slice with array[idx]/slice[idx],
+// in which order are they parsed? array/slice then array[idx]/slice[idx]", "Use `[index or
+// key]` for access to index of a slice/array or key for map", "Only creates objects as
+// necessary", SetMaxArraySize "maximum array size that can be created". An invalid index or
+// map key is an error under the container's namespace; a container nothing was set in stays
+// nil.
+
+type Pair struct {
+	X string
+	Y int8
+}
+
+// Idx is the destination of the generated keys.
+type Idx struct {
+	S  []string
+	A  [3]string
+	PS []*string
+	I  []int8
+	M  map[string]string
+	MI map[int]string
+	SI []Pair
+	MS map[string]Pair
+	SS [][]string
+}
+
+const idxMax = 10 // SetMaxArraySize
+
+var (
+	strToks  = []string{"a", "b", "", "x y"}
+	int8Toks = []string{"1", "-7", "200", "x", ""}
+	indexes  = []string{"0", "0", "1", "1", "2", "3", "4", "5", "9", "10", "12", "x", "-1", "", "1a"}
+	mapKeys  = []string{"a", "b", "", "0", "x.y", " ", "k.X"}
+	intKeys  = []string{"1", "2", "-3", "0", "x", "", "1.5"}
+	junkKeys = []string{"Other", "S.X", "M", "MI", "SI[0]X", "[0]", "SI.X"}
+	// keys the decoder panics on (bug 1)
+	panicKeys = []string{"x]", "x[", "a[b", "]"}
+)
+
+func toks(tc hegel.TestCase, from []string) []string {
+	n := 1
+	if chance(tc, 25) {
+		n = drawInt(tc, 1, 3)
+	}
+	out := make([]string, n)
+	for i := range out {
+		out[i] = pick(tc, from)
+	}
+	return out
+}
+
+// genIdxValues draws url.Values for Idx.
+func genIdxValues(tc hegel.TestCase) url.Values {
+	vals := url.Values{}
+	for n := drawInt(tc, 1, 8); n > 0; n-- {
+		var key string
+		var v []string
+		switch drawInt(tc, 0, 15) {
+		case 0:
+			key, v = "S", toks(tc, strToks)
+		case 1:
+			key, v = "S["+pick(tc, indexes)+"]", toks(tc, strToks)
+		case 2:
+			key, v = "A", toks(tc, strToks)
+		case 3:
+			key, v = "A["+pick(tc, indexes)+"]", toks(tc, strToks)
+		case 4:
+			key, v = "PS", toks(tc, strToks)
+		case 5:
+			key, v = "PS["+pick(tc, indexes)+"]", toks(tc, strToks)
+		case 6:
+			key, v = "I", toks(tc, int8Toks)
+		case 7:
+			key, v = "I["+pick(tc, indexes)+"]", toks(tc, int8Toks)
+		case 8:
+			key, v = "M["+pick(tc, mapKeys)+"]", toks(tc, strToks)
+		case 9:
+			key, v = "MI["+pick(tc, intKeys)+"]", toks(tc, strToks)
+		case 10:
+			key, v = "SI["+pick(tc, indexes)+"].X", toks(tc, strToks)
+		case 11:
+			key, v = "SI["+pick(tc, indexes)+"].Y", toks(tc, int8Toks)
+		case 12:
+			if chance(tc, 50) {
+				key, v = "MS["+pick(tc, mapKeys)+"].X", toks(tc, strToks)
+			} else {
+				key, v = "MS["+pick(tc, mapKeys)+"].Y", toks(tc, int8Toks)
+			}
+		case 13:
+			key, v = "SS["+pick(tc, indexes)+"]["+pick(tc, indexes)+"]", toks(tc, strToks)
+		case 14:
+			// bare element keys: SI[i] counts for the length, SS[i] holds plain values
+			if chance(tc, 50) {
+				key, v = "SI["+pick(tc, indexes)+"]", toks(tc, strToks)
+			} else {
+				key, v = "SS["+pick(tc, indexes)+"]", toks(tc, strToks)
+			}
+		default:
+			if chance(tc, 20) {
+				key, v = pick(tc, panicKeys), toks(tc, strToks)
+			} else {
+				key, v = pick(tc, junkKeys), toks(tc, strToks)
+			}
+		}
+		vals[key] = v
+	}
+	return vals
+}
+
+// panicsOnKey: a ] before any [ or an unclosed [.
+func panicsOnKey(k string) bool {
+	inside := false
+	for i := 0; i < len(k); i++ {
+		switch k[i] {
+		case '[':
+			inside = true
+		case ']':
+			if !inside {
+				return true
+			}
+			inside = false
+		}
+	}
+	return inside
+}
+
+type idxKey struct {
+	raw string
+	i   int    // the index, -1 when not one
+	ns  string // alias + [raw]
+}
+
+type idxModel struct {
+	vals url.Values
+	errs map[string]bool
+}
+
+// entries are the bracketed keys under alias ns: for each ] in a key, the text back to the
+// nearest [ under the alias before that [. sl is one more than the largest index (1 when
+// there is none).
+func (m *idxModel) entries(ns string) (sl int, keys []idxKey) {
+	seen := map[string]bool{}
+	names := make([]string, 0, len(m.vals))
+	for k := range m.vals {
+		names = append(names, k)
+	}
+	sort.Strings(names)
+	maxIdx := 0
+	for _, k := range names {
+		open := -1
+		for p := 0; p < len(k); p++ {
+			switch k[p] {
+			case '[':
+				open = p
+			case ']':
+				if open < 0 {
+					continue
+				}
+				if k[:open] == ns {
+					raw := k[open+1 : p]
+					if !seen[raw] {
+						seen[raw] = true
+						e := idxKey{raw: raw, i: -1, ns: ns + "[" + raw + "]"}
+						if n, err := strconv.Atoi(raw); err == nil && n >= 0 && strings.Trim(raw, "0123456789") == "" {
+							e.i = n
+							if n > maxIdx {
+								maxIdx = n
+							}
+						}
+						keys = append(keys, e)
+					}
+				}
+				open = -1
+			}
+		}
+	}
+	return maxIdx + 1, keys
+}
+
+// field is the model of setting dst from the values under ns; it reports whether dst was set.
+func (m *idxModel) field(dst reflect.Value, ns string) bool {
+	if dst.Type() == timeType || isScalarKind(dst.Kind()) || dst.Kind() == reflect.Pointer || dst.Kind() == reflect.Interface {
+		if dst.Kind() == reflect.Pointer && dst.Type().Elem().Kind() != reflect.String {
+			panic("idxModel: pointer to " + dst.Type().Elem().String())
+		}
+		v, ok := m.vals[ns]
+		if !ok || len(v) == 0 {
+			return false
+		}
+		set, bad := applyToken(dst, v[0])
+		if bad {
+			m.errs[ns] = true
+		}
+		return set
+	}
+	switch dst.Kind() {
+	case reflect.Struct:
+		set := false
+		for i := 0; i < dst.NumField(); i++ {
+			if m.field(dst.Field(i), ns+"."+dst.Type().Field(i).Name) {
+				set = true
+			}
+		}
+		return set
+	case reflect.Slice:
+		return m.slice(dst, ns)
+	case reflect.Array:
+		return m.array(dst, ns)
+	case reflect.Map:
+		return m.mp(dst, ns)
+	}
+	panic("idxModel: " + dst.Type().String())
+}
+
+func (m *idxModel) slice(dst reflect.Value, ns string) bool {
+	t := dst.Type()
+	set := false
+	if plain, ok := m.vals[ns]; ok && len(plain) > 0 {
+		s := reflect.MakeSlice(t, len(plain), len(plain))
+		for i, tok := range plain {
+			e := reflect.New(t.Elem()).Elem()
+			if m.plainElem(e, ns, tok) {
+				set = true
+				s.Index(i).Set(e)
+			}
+		}
+		dst.Set(s)
+	}
+	sl, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return set
+	}
+	var varr reflect.Value
+	switch {
+	case dst.IsNil():
+		if sl > idxMax {
+			m.errs[ns] = true
+			return set
+		}
+		varr = reflect.MakeSlice(t, sl, sl)
+	case dst.Len() < sl:
+		if sl > idxMax {
+			m.errs[ns] = true
+			return set
+		}
+		varr = reflect.MakeSlice(t, sl, sl)
+		reflect.Copy(varr, dst)
+	default:
+		varr = dst
+	}
+	setIdx := false
+	for _, k := range keys {
+		if k.i < 0 {
+			m.errs[ns] = true
+			continue
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns) {
+			setIdx = true
+			varr.Index(k.i).Set(e)
+		}
+	}
+	// the expanded slice is kept once anything was set, by an index or a plain value
+	if set || setIdx {
+		dst.Set(varr)
+	}
+	return set || setIdx
+}
+
+// plainElem is one of the plain values of a slice or array: a scalar, or a pointer to one.
+func (m *idxModel) plainElem(e reflect.Value, ns, tok string) bool {
+	set, bad := applyToken(e, tok)
+	if bad {
+		m.errs[ns] = true
+	}
+	return set
+}
+
+func (m *idxModel) array(dst reflect.Value, ns string) bool {
+	t := dst.Type()
+	set := false
+	if plain, ok := m.vals[ns]; ok && len(plain) > 0 {
+		varr := reflect.New(t).Elem()
+		reflect.Copy(varr, dst)
+		for i, tok := range plain {
+			if i >= t.Len() {
+				break // a warning is printed, the value ignored
+			}
+			e := reflect.New(t.Elem()).Elem()
+			if m.plainElem(e, ns, tok) {
+				set = true
+				varr.Index(i).Set(e)
+			}
+		}
+		dst.Set(varr)
+	}
+	_, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return set
+	}
+	varr := reflect.New(t).Elem()
+	reflect.Copy(varr, dst)
+	setIdx := false
+	for _, k := range keys {
+		if k.i >= t.Len() {
+			continue // a warning is printed, the value ignored
+		}
+		if k.i < 0 {
+			m.errs[ns] = true
+			continue
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns) {
+			setIdx = true
+			varr.Index(k.i).Set(e)
+		}
+	}
+	if set || setIdx {
+		dst.Set(varr)
+	}
+	return set || setIdx
+}
+
+func (m *idxModel) mp(dst reflect.Value, ns string) bool {
+	t := dst.Type()
+	_, keys := m.entries(ns)
+	if len(keys) == 0 {
+		return false
+	}
+	mp := reflect.MakeMap(t)
+	set := false
+	for _, k := range keys {
+		mk := reflect.New(t.Key()).Elem()
+		switch t.Key().Kind() {
+		case reflect.String:
+			mk.SetString(k.raw)
+		case reflect.Int:
+			n, err := strconv.ParseInt(k.raw, 10, 64)
+			if err != nil {
+				m.errs[ns] = true
+				continue
+			}
+			mk.SetInt(n)
+		default:
+			panic("idxModel: map key " + t.Key().String())
+		}
+		e := reflect.New(t.Elem()).Elem()
+		if m.field(e, k.ns) {
+			set = true
+			mp.SetMapIndex(mk, e)
+		}
+	}
+	if set {
+		dst.Set(mp)
+	}
+	return set
+}
+
+// TestHegelIndexed: generated keys of the documented forms (plain values, [index], [key],
+// nested, mixed, invalid, beyond the array or the maximum size, unrelated) decode into slices,
+// arrays and maps as documented, with the documented errors.
+func TestHegelIndexed(t *testing.T) {
+	c := newCollector(t)
+	idxType := reflect.TypeOf(Idx{})
+	property(t, func(ht *hegel.T) {
+		vals := genIdxValues(ht)
+		if Known.bracketKeyPanic {
+			for k := range vals {
+				if panicsOnKey(k) {
+					c.count("skipped: key the decoder panics on")
+					return
+				}
+			}
+		}
+		m := &idxModel{vals: vals, errs: map[string]bool{}}
+		want := reflect.New(idxType).Elem()
+		for i := 0; i < want.NumField(); i++ {
+			m.field(want.Field(i), idxType.Field(i).Name)
+		}
+		wantErrs := make([]string, 0, len(m.errs))
+		for k := range m.errs {
+			wantErrs = append(wantErrs, k)
+		}
+		sort.Strings(wantErrs)
+		if len(wantErrs) > 0 {
+			c.count("with errors")
+		}
+		c.count("keys " + strconv.Itoa(len(vals)))
+		dec := form.NewDecoder()
+		dec.SetMaxArraySize(idxMax)
+		got := reflect.New(idxType)
+		err := dec.Decode(got.Interface(), vals)
+		if g, w := strings.Join(errorKeys(err), ","), strings.Join(wantErrs, ","); g != w {
+			c.failClass(ht, "errors", "Decode errors\n%s  got  %q\n  want %q\n  (%v)", showValues(vals), g, w, err)
+			return
+		}
+		if !same(want, got.Elem()) {
+			c.failClass(ht, "value", "Decode into Idx\n%s  want %s\n  got  %s", showValues(vals), show(want.Interface()), show(got.Elem().Interface()))
+		}
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..52a8b90
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,140 @@
+package hegel
+
+import (
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/go-playground/form/v4"
+)
+
+// --------------------------------------------------------------------------- pins
+//
+// One test per recorded bug, asserting the documented behaviour; listed as expected failures
+// in target.toml while the bug exists.
+
+// noPanic runs f and reports a panic as a test failure.
+func noPanic(t *testing.T, f func()) (panicked bool) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("panic: %v", r)
+			panicked = true
+		}
+	}()
+	f()
+	return false
+}
+
+// form/1: a key with a ] before any [ (or an unclosed [) makes Decode panic when the
+// destination has a slice, array, map or nested struct.
+func TestHegelPinBracketKeyPanic(t *testing.T) {
+	var dst struct {
+		S []string
+		N string
+	}
+	noPanic(t, func() {
+		err := form.NewDecoder().Decode(&dst, url.Values{"x]": {"1"}, "N": {"n"}})
+		if dst.N != "n" {
+			t.Errorf("N = %q, want n (err %v)", dst.N, err)
+		}
+	})
+	noPanic(t, func() {
+		_ = form.NewDecoder().Decode(&dst, url.Values{"x[": {"1"}})
+	})
+}
+
+// form/2: Decode panics on an interface{} field that already holds a value.
+func TestHegelPinPrefilledInterface(t *testing.T) {
+	dst := struct{ Any interface{} }{Any: "old"}
+	noPanic(t, func() {
+		if err := form.NewDecoder().Decode(&dst, url.Values{"Any": {"new"}}); err != nil {
+			t.Fatal(err)
+		}
+		if dst.Any != "new" {
+			t.Errorf("Any = %#v, want new", dst.Any)
+		}
+	})
+}
+
+// form/3: nil elements of a slice of interfaces are dropped by the encoder, so the positions
+// of the others are lost (nil pointers keep them, by indexing).
+func TestHegelPinNilInterfaceElements(t *testing.T) {
+	src := struct{ A []interface{} }{A: []interface{}{nil, "a"}}
+	vals, err := form.NewEncoder().Encode(&src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var dst struct{ A []interface{} }
+	if err := form.NewDecoder().Decode(&dst, vals); err != nil {
+		t.Fatal(err)
+	}
+	if len(dst.A) != 2 || dst.A[1] != "a" {
+		t.Errorf("A = %#v from %v, want [nil a]", dst.A, vals)
+	}
+}
+
+// form/4: an unparsable time value zeroes the field and points a nil *time.Time at a zero
+// time, besides the error.
+func TestHegelPinInvalidTimeKeepsValue(t *testing.T) {
+	x := time.Date(2020, 1, 2, 3, 4, 5, 0, time.UTC)
+	dst := struct {
+		T  time.Time
+		PT *time.Time
+	}{T: x}
+	err := form.NewDecoder().Decode(&dst, url.Values{"T": {"garbage"}, "PT": {"garbage"}})
+	if err == nil {
+		t.Fatal("no error")
+	}
+	if !dst.T.Equal(x) {
+		t.Errorf("T = %v, want %v", dst.T, x)
+	}
+	if dst.PT != nil {
+		t.Errorf("PT = %v, want nil", *dst.PT)
+	}
+}
+
+// form/5: map keys with [ or ] are written unescaped and cannot be read back: ] makes the
+// decoder panic, [ loses the entry.
+func TestHegelPinBracketMapKey(t *testing.T) {
+	for _, k := range []string{"a]", "a[b", "[0]"} {
+		src := struct{ M map[string]string }{M: map[string]string{k: "v"}}
+		vals, err := form.NewEncoder().Encode(&src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var dst struct{ M map[string]string }
+		noPanic(t, func() {
+			if err := form.NewDecoder().Decode(&dst, vals); err != nil {
+				t.Errorf("key %q: %v", k, err)
+			}
+			if dst.M[k] != "v" {
+				t.Errorf("key %q: M = %#v from %v", k, dst.M, vals)
+			}
+		})
+	}
+}
+
+// form/6: an encoder custom type function returning no values for a map key panics (index out
+// of range) instead of writing nothing or an error.
+func TestHegelPinEmptyCustomMapKey(t *testing.T) {
+	e := form.NewEncoder()
+	e.RegisterCustomTypeFunc(func(x interface{}) ([]string, error) { return nil, nil }, Color(""))
+	noPanic(t, func() {
+		_, _ = e.Encode(&struct{ M map[Color]string }{M: map[Color]string{"k": "v"}})
+	})
+}
+
+// form/7: a decoder custom type function returning nil for a map key panics (reflect.Value.Set
+// on zero Value); for a field, nil leaves it alone (v4.3.1).
+func TestHegelPinNilCustomMapKey(t *testing.T) {
+	d := form.NewDecoder()
+	d.RegisterCustomTypeFunc(func(v []string) (interface{}, error) { return nil, nil }, Color(""))
+	var dst struct {
+		C Color
+		M map[Color]string
+	}
+	noPanic(t, func() {
+		_ = d.Decode(&dst, url.Values{"C": {"x"}, "M[k]": {"v"}})
+	})
+}
diff --git a/hegel/hegel_roundtrip_test.go b/hegel/hegel_roundtrip_test.go
new file mode 100644
index 0000000..c1726c4
--- /dev/null
+++ b/hegel/hegel_roundtrip_test.go
@@ -0,0 +1,260 @@
+package hegel
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/go-playground/form/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- round trip
+//
+// doc.go: "Decodes url.Values into Go value(s) and Encodes Go value(s) into url.Values ...
+// Handles Encoding & Decoding of almost all Go types eg. can Decode into struct, array, map,
+// int... and Encode a struct, array, map, int...". What Encode writes, Decode with the same
+// settings reads back, up to what the encoding cannot carry: nil and empty are alike, a value
+// that encodes to nothing (an empty slice, a pointer to a struct with nothing to write) is not
+// there, and trailing such elements of a slice are gone with it.
+
+func newEncoder(o encOpts) *form.Encoder {
+	e := form.NewEncoder()
+	if o.explicit {
+		e.SetMode(form.ModeExplicit)
+	}
+	e.SetTagName(o.tag)
+	e.SetNamespacePrefix(o.prefix)
+	e.SetNamespaceSuffix(o.suffix)
+	if o.separate {
+		e.SetAnonymousMode(form.AnonymousSeparate)
+	}
+	if fn := o.tagNameFunc(); fn != nil {
+		e.RegisterTagNameFunc(fn)
+	}
+	return e
+}
+
+func newDecoder(o encOpts, separate bool) *form.Decoder {
+	d := form.NewDecoder()
+	if o.explicit {
+		d.SetMode(form.ModeExplicit)
+	}
+	d.SetTagName(o.tag)
+	d.SetNamespacePrefix(o.prefix)
+	d.SetNamespaceSuffix(o.suffix)
+	if separate {
+		d.SetAnonymousMode(form.AnonymousSeparate)
+	}
+	if fn := o.tagNameFunc(); fn != nil {
+		d.RegisterTagNameFunc(fn)
+	}
+	return d
+}
+
+// norm is the value Decode gives back for Encode(v): what the encoding does not carry is zero.
+func norm(v reflect.Value, o encOpts) reflect.Value {
+	t := v.Type()
+	out := reflect.New(t).Elem()
+	if t == timeType {
+		out.Set(v)
+		return out
+	}
+	switch t.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return out
+		}
+		e := norm(v.Elem(), o)
+		if absent(e, o) {
+			return out
+		}
+		p := reflect.New(t.Elem())
+		p.Elem().Set(e)
+		out.Set(p)
+	case reflect.Interface:
+		if v.IsNil() {
+			return out
+		}
+		out.Set(v)
+	case reflect.Slice:
+		var es []reflect.Value
+		for i := 0; i < v.Len(); i++ {
+			e := v.Index(i)
+			if Known.nilInterfaceElements && e.Kind() == reflect.Interface && e.IsNil() {
+				continue
+			}
+			es = append(es, norm(e, o))
+		}
+		for len(es) > 0 && absent(es[len(es)-1], o) {
+			es = es[:len(es)-1]
+		}
+		if len(es) == 0 {
+			return out
+		}
+		s := reflect.MakeSlice(t, len(es), len(es))
+		for i, e := range es {
+			s.Index(i).Set(e)
+		}
+		out.Set(s)
+	case reflect.Array:
+		for i := 0; i < t.Len(); i++ {
+			out.Index(i).Set(norm(v.Index(i), o))
+		}
+	case reflect.Map:
+		if v.IsNil() {
+			return out
+		}
+		m := reflect.MakeMap(t)
+		for _, k := range v.MapKeys() {
+			e := norm(v.MapIndex(k), o)
+			if absent(e, o) {
+				continue
+			}
+			m.SetMapIndex(k, e)
+		}
+		if m.Len() == 0 {
+			return out
+		}
+		out.Set(m)
+	case reflect.Struct:
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			_, omit, skip := o.fieldName(f)
+			if skip {
+				continue
+			}
+			fv := v.Field(i)
+			if omit && !hasValue(fv) {
+				continue
+			}
+			out.Field(i).Set(norm(fv, o))
+		}
+	default:
+		out.Set(v)
+	}
+	return out
+}
+
+// absent reports whether a normalised value encodes to nothing.
+func absent(v reflect.Value, o encOpts) bool {
+	if v.Type() == timeType {
+		return false
+	}
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Interface, reflect.Map:
+		return v.IsNil()
+	case reflect.Slice:
+		return v.Len() == 0
+	case reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if !absent(v.Index(i), o) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		t := v.Type()
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			_, omit, skip := o.fieldName(f)
+			if skip {
+				continue
+			}
+			fv := v.Field(i)
+			if omit && !hasValue(fv) {
+				continue
+			}
+			if !absent(fv, o) {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+// hasBracketMapKey reports a map key with [ or ] somewhere in the value.
+func hasBracketMapKey(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		return !v.IsNil() && hasBracketMapKey(v.Elem())
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if hasBracketMapKey(v.Index(i)) {
+				return true
+			}
+		}
+	case reflect.Map:
+		for _, k := range v.MapKeys() {
+			if k.Kind() == reflect.String {
+				for _, r := range k.String() {
+					if r == '[' || r == ']' {
+						return true
+					}
+				}
+			}
+			if hasBracketMapKey(v.MapIndex(k)) {
+				return true
+			}
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).PkgPath == "" && hasBracketMapKey(v.Field(i)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// genRoot draws a root type and a value of it.
+func genRoot(tc hegel.TestCase) reflect.Value {
+	rt := outerType
+	if chance(tc, 30) {
+		rt = pick(tc, rootTypes)
+	}
+	return genValue(tc, rt, 2)
+}
+
+// TestHegelRoundTrip: Encode then Decode with the same settings gives the value back (up to
+// what the encoding does not carry); encoding the decoded value gives the same url.Values.
+func TestHegelRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		v := genRoot(ht)
+		rt := v.Type()
+		enc := newEncoder(o)
+		// A decoder in AnonymousEmbed reads both layouts; AnonymousSeparate only its own.
+		decSeparate := o.separate && chance(ht, 50)
+		dec := newDecoder(o, decSeparate)
+		vals, err := enc.Encode(v.Addr().Interface())
+		if err != nil {
+			c.failClass(ht, "encode error", "Encode(%s) under %s: %v", rt, o, err)
+			return
+		}
+		if Known.bracketMapKeys && hasBracketMapKey(v) {
+			c.count("skipped: map key with a bracket")
+			return
+		}
+		c.count("root " + rt.String())
+		got := reflect.New(rt)
+		if err := dec.Decode(got.Interface(), vals); err != nil {
+			c.failClass(ht, "decode error", "Decode(%s) under %s (decoder separate=%v): %v\n%s", rt, o, decSeparate, err, showValues(vals))
+			return
+		}
+		want := norm(v, o)
+		if !same(want, got.Elem()) {
+			c.failClass(ht, "value", "round trip of %s under %s (decoder separate=%v)\n%s  want %s\n  got  %s", rt, o, decSeparate, showValues(vals), show(want.Interface()), show(got.Elem().Interface()))
+			return
+		}
+		vals2, err := enc.Encode(got.Interface())
+		if err != nil {
+			c.failClass(ht, "re-encode error", "Encode of the decoded %s: %v", rt, err)
+			return
+		}
+		if !reflect.DeepEqual(vals, vals2) {
+			c.failClass(ht, "re-encode", "encoding the decoded %s differs under %s\n  first\n%s  again\n%s", rt, o, showValues(vals), showValues(vals2))
+		}
+	})
+}
diff --git a/hegel/hegel_scalars_test.go b/hegel/hegel_scalars_test.go
new file mode 100644
index 0000000..3b1a994
--- /dev/null
+++ b/hegel/hegel_scalars_test.go
@@ -0,0 +1,228 @@
+package hegel
+
+import (
+	"errors"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-playground/form/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- scalar tokens
+//
+// doc.go lists the supported scalar types and "time.Time - by default using RFC3339"; the
+// decoder parses numbers with strconv in the field's size, booleans with an extended set
+// (1 t T true TRUE True on yes ok / 0 f F false FALSE False off no and the empty string), and
+// collects an error per field namespace in DecodeErrors, leaving the field as it was. A field
+// with no value, or an empty numeric value, is left alone.
+
+// Scalars is decoded into pre-filled, so that an untouched field is told from a zeroed one.
+type Scalars struct {
+	S    string
+	I    int
+	I8   int8
+	I16  int16
+	I32  int32
+	I64  int64
+	U    uint
+	U8   uint8
+	U16  uint16
+	U32  uint32
+	U64  uint64
+	F32  float32
+	F64  float64
+	B    bool
+	T    time.Time
+	PS   *string
+	PI   *int
+	PB   *bool
+	PT   *time.Time
+	Any  interface{}
+	Nest struct {
+		X int8
+		Y bool
+	}
+}
+
+var tokens = []string{
+	"", "0", "1", "-1", "127", "128", "-129", "255", "256", "65535", "65536", "4294967295", "4294967296",
+	"9223372036854775807", "9223372036854775808", "-9223372036854775808", "18446744073709551615",
+	"18446744073709551616", "+5", "0x10", "1e3", "1.5", "-0", "3.4028235e38", "1e39", "1e309", "NaN", "Inf",
+	"-Inf", "infinity", "t", "T", "true", "TRUE", "True", "on", "yes", "ok", "f", "F", "false", "FALSE",
+	"False", "off", "no", "y", "n", "2", " 1", "1 ", "abc", "1_000", "2020-01-02T03:04:05Z",
+	"2020-01-02T03:04:05+02:00", "2020-01-02T03:04:05.123Z", "2020-01-02", "0001-01-01T00:00:00Z",
+	"9999-12-31T23:59:59Z", "10000-01-01T00:00:00Z", "2020-13-01T00:00:00Z", "2020-01-02 03:04:05Z",
+	"2020-01-02t03:04:05z", string(rune(0xe9)),
+}
+
+// parseBoolExt is the documented boolean vocabulary.
+func parseBoolExt(s string) (bool, bool) {
+	switch s {
+	case "1", "t", "T", "true", "TRUE", "True", "on", "yes", "ok":
+		return true, true
+	case "", "0", "f", "F", "false", "FALSE", "False", "off", "no":
+		return false, true
+	}
+	return false, false
+}
+
+// applyToken is the model of one value on a scalar or time destination: set says the
+// destination was written, bad that an error is recorded.
+func applyToken(dst reflect.Value, tok string) (set, bad bool) {
+	if dst.Type() == timeType {
+		if tok == "" {
+			return false, false
+		}
+		x, err := time.Parse(time.RFC3339, tok)
+		if err != nil {
+			if Known.invalidTimeZeroes {
+				dst.Set(reflect.ValueOf(time.Time{}))
+				return true, true
+			}
+			return false, true
+		}
+		dst.Set(reflect.ValueOf(x))
+		return true, false
+	}
+	switch dst.Kind() {
+	case reflect.String:
+		dst.SetString(tok)
+		return true, false
+	case reflect.Interface:
+		dst.Set(reflect.ValueOf(tok))
+		return true, false
+	case reflect.Bool:
+		b, ok := parseBoolExt(tok)
+		if !ok {
+			return false, true
+		}
+		dst.SetBool(b)
+		return true, false
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if tok == "" {
+			return false, false
+		}
+		x, err := strconv.ParseInt(tok, 10, dst.Type().Bits())
+		if err != nil {
+			return false, true
+		}
+		dst.SetInt(x)
+		return true, false
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if tok == "" {
+			return false, false
+		}
+		x, err := strconv.ParseUint(tok, 10, dst.Type().Bits())
+		if err != nil {
+			return false, true
+		}
+		dst.SetUint(x)
+		return true, false
+	case reflect.Float32, reflect.Float64:
+		if tok == "" {
+			return false, false
+		}
+		x, err := strconv.ParseFloat(tok, dst.Type().Bits())
+		if err != nil {
+			return false, true
+		}
+		dst.SetFloat(x)
+		return true, false
+	case reflect.Pointer:
+		if dst.IsNil() {
+			tmp := reflect.New(dst.Type().Elem())
+			set, bad = applyToken(tmp.Elem(), tok)
+			if set {
+				dst.Set(tmp)
+			}
+			return set, bad
+		}
+		return applyToken(dst.Elem(), tok)
+	}
+	panic("applyToken: " + dst.Type().String())
+}
+
+// errorKeys are the namespaces of a DecodeErrors or EncodeErrors, sorted.
+func errorKeys(err error) []string {
+	if err == nil {
+		return nil
+	}
+	var keys []string
+	var de form.DecodeErrors
+	var ee form.EncodeErrors
+	switch {
+	case errors.As(err, &de):
+		for k := range de {
+			keys = append(keys, k)
+		}
+	case errors.As(err, &ee):
+		for k := range ee {
+			keys = append(keys, k)
+		}
+	default:
+		return []string{"<" + err.Error() + ">"}
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// TestHegelScalars: the value of each scalar field of a pre-filled struct is parsed as the
+// documentation says, an unparsable value is an error under the field's namespace and leaves
+// the field as it was.
+func TestHegelScalars(t *testing.T) {
+	c := newCollector(t)
+	scalarsType := reflect.TypeOf(Scalars{})
+	property(t, func(ht *hegel.T) {
+		pre := genValue(ht, scalarsType, 1)
+		if Known.prefilledInterfacePanic {
+			pre.FieldByName("Any").Set(reflect.Zero(pre.FieldByName("Any").Type()))
+		}
+		got := reflect.New(scalarsType)
+		got.Elem().Set(pre)
+		want := reflect.New(scalarsType).Elem()
+		want.Set(pre)
+		vals := map[string][]string{}
+		var wantErrs []string
+		var walk func(dst reflect.Value, ns string)
+		walk = func(dst reflect.Value, ns string) {
+			if dst.Kind() == reflect.Struct && dst.Type() != timeType {
+				for i := 0; i < dst.NumField(); i++ {
+					walk(dst.Field(i), ns+"."+dst.Type().Field(i).Name)
+				}
+				return
+			}
+			if !chance(ht, 60) {
+				return
+			}
+			toks := []string{pick(ht, tokens)}
+			if chance(ht, 20) {
+				toks = append(toks, pick(ht, tokens))
+			}
+			vals[ns] = toks
+			if _, bad := applyToken(dst, toks[0]); bad {
+				wantErrs = append(wantErrs, ns)
+			}
+		}
+		for i := 0; i < want.NumField(); i++ {
+			walk(want.Field(i), want.Type().Field(i).Name)
+		}
+		sort.Strings(wantErrs)
+		c.count("fields " + strconv.Itoa(min(len(vals)/5, 4)*5) + "+")
+		if len(wantErrs) > 0 {
+			c.count("with errors")
+		}
+		err := form.NewDecoder().Decode(got.Interface(), vals)
+		if g, w := strings.Join(errorKeys(err), ","), strings.Join(wantErrs, ","); g != w {
+			c.failClass(ht, "errors", "Decode errors\n%s  got  %q\n  want %q\n  (%v)", showValues(vals), g, w, err)
+			return
+		}
+		if !same(want, got.Elem()) {
+			c.failClass(ht, "value", "Decode into a pre-filled Scalars\n%s  pre  %s\n  want %s\n  got  %s", showValues(vals), show(pre.Interface()), show(want.Interface()), show(got.Elem().Interface()))
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..33eabb7
--- /dev/null
