+// TestHegelWhitespaceDoesNotChangeTheValue: the same tree rendered two ways gives the same
+// results (Type, Str, Num, compact Raw) for the same path.
+func TestHegelWhitespaceDoesNotChangeTheValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		root := genNode(ht, 0, false)
+		d1, d2 := genDoc(ht, root), genDoc(ht, root)
+		path, _, _ := genPath(ht, root)
+		a, b := Get(d1, path), Get(d2, path)
+		if a.Type != b.Type || a.Str != b.Str || (a.Num != b.Num && !(math.IsNaN(a.Num) && math.IsNaN(b.Num))) || compact(a.Raw) != compact(b.Raw) || a.Exists() != b.Exists() {
+			ht.Fatalf("whitespace changes the result of %s\n %s -> %s %s\n %s -> %s %s", show(path), show(d1), a.Type, show(a.Raw), show(d2), b.Type, show(b.Raw))
+		}
+	})
+}
