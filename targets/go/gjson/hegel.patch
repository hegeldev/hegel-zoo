diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..ad87d30
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,96 @@
+package gjson_test
+
+// One plain test per recorded bug (bugs.toml). Each asserts the correct behaviour, so it fails
+// while the bug exists and passes once upstream fixes it; target.toml lists them as expected
+// failures.
+
+import (
+	"math"
+	"testing"
+
+	. "github.com/tidwall/gjson"
+)
+
+// gjson/1: parseUint's overflow check misses wraparounds that stay above the previous value.
+func TestHegelPinIntSaturatesOnEveryOverflow(t *testing.T) {
+	if got := Parse("20500000000000000000").Int(); got != math.MaxInt64 {
+		t.Fatalf("Parse(20500000000000000000).Int() = %d, want %d", got, int64(math.MaxInt64))
+	}
+	if got := Parse("-20500000000000000000").Int(); got != math.MinInt64 {
+		t.Fatalf("Parse(-20500000000000000000).Int() = %d, want %d", got, int64(math.MinInt64))
+	}
+	if got := Parse("36893488147419103230").Uint(); got != math.MaxUint64 {
+		t.Fatalf("Parse(36893488147419103230).Uint() = %d, want %d", got, uint64(math.MaxUint64))
+	}
+}
+
+// gjson/2: a surrogate escape followed by a \uXXXX escape that does not complete the pair
+// drops the second escape.
+func TestHegelPinUnpairedSurrogateKeepsTheNextEscape(t *testing.T) {
+	if got := Parse(`"\ud83d\u0041"`).Str; got != "\uFFFDA" {
+		t.Fatalf(`Parse("\ud83d\u0041").Str = %q, want %q`, got, "\uFFFDA")
+	}
+	if got := Parse(`"\ud800\ud800"`).Str; got != "\uFFFD\uFFFD" {
+		t.Fatalf(`Parse("\ud800\ud800").Str = %q, want %q`, got, "\uFFFD\uFFFD")
+	}
+}
+
+// gjson/3: an auto-named multipath member keeps the path's backslashes in the key.
+func TestHegelPinMultipathAutoNameIsTheUnescapedKey(t *testing.T) {
+	if got := Get(`{"a.b":1}`, `{a\.b}`).Raw; got != `{"a.b":1}` {
+		t.Fatalf("Get({a\\.b}) = %s, want %s", got, `{"a.b":1}`)
+	}
+	if got := Get(`{"a*":1}`, `{a\*}`).Raw; got != `{"a*":1}` {
+		t.Fatalf("Get({a\\*}) = %s, want %s", got, `{"a*":1}`)
+	}
+}
+
+// gjson/4: an escaped * or ? in a key pattern acts as a wildcard when the pattern has another one.
+func TestHegelPinEscapedWildcardIsLiteralInPatterns(t *testing.T) {
+	doc := `{"axb":2,"a*b":1,"a\\b":5}`
+	if got := Get(doc, `a\*?`).Raw; got != "1" {
+		t.Fatalf(`Get(a\*?) = %q, want "1" (the key "a*b")`, got)
+	}
+	if got := Get(doc, `?\*b`).Raw; got != "1" {
+		t.Fatalf(`Get(?\*b) = %q, want "1" (the key "a*b")`, got)
+	}
+	if got := Get(doc, `a\\?`).Raw; got != "5" {
+		t.Fatalf(`Get(a\\?) = %q, want "5" (the key "a\b")`, got)
+	}
+}
+
+// gjson/5: Result.Path panics on a document that lacks a colon between key and value.
+func TestHegelPinPathDoesNotPanicOnInvalidJSON(t *testing.T) {
+	doc := `{"b:"2}`
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Path panicked: %v", r)
+		}
+	}()
+	r := Get(doc, "b:")
+	if r.Raw != "2" {
+		t.Skipf("gjson no longer reads 2 as the value of \"b:\" (got %q)", r.Raw)
+	}
+	_ = r.Path(doc)
+}
+
+// gjson/7: Escape leaves ':' alone, but inside a multipath an unescaped ':' names the member.
+func TestHegelPinEscapedKeysWorkInsideMultipaths(t *testing.T) {
+	doc := `{"a:":1,"b":2}`
+	if got := Get(doc, "["+Escape("a:")+",b]").Raw; got != `[1,2]` {
+		t.Fatalf("Get([%s,b]) = %s, want [1,2]", Escape("a:"), got)
+	}
+	if got := Get(doc, `{"n":`+Escape("a:")+`}`).Raw; got != `{"n":1}` {
+		t.Fatalf(`Get({"n":%s}) = %s, want {"n":1}`, Escape("a:"), got)
+	}
+}
+
+// gjson/6: a multipath literal is auto-named from the text after its last '.' or '|'.
+func TestHegelPinLiteralsAreAutoNamedUnderscore(t *testing.T) {
+	if got := Get(`{}`, `{!7.5}`).Raw; got != `{"_":7.5}` {
+		t.Fatalf("Get({!7.5}) = %s, want %s", got, `{"_":7.5}`)
+	}
+	if got := Get(`{}`, `{!"a.b"}`).Raw; got != `{"_":"a.b"}` {
+		t.Fatalf(`Get({!"a.b"}) = %s, want %s`, got, `{"_":"a.b"}`)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..b81d7d1
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,288 @@
+package gjson_test
+
+// One narrow property per recorded bug (bugs.toml): each draws the bug's shape region with
+// random contents and judges it by the models of hegel_test.go, so it fails on the bug naming
+// it; under HEGEL_NO_KNOWN=1 each draws the region beside the shape instead and passes.
+
+import (
+	"encoding/json"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	. "github.com/tidwall/gjson"
+)
+
+// --------------------------------------------------------------------------- gjson/1
+
+// wrappedIntegerTexts: a signed twenty-digit integer whose twentieth digit wraps uint64 above
+// the previous value (gjson/1); under HEGEL_NO_KNOWN=1 one whose wrap parseUint catches.
+var wrappedIntegerTexts = cat(halfSigns, hegel.SampledFrom(shaped(missedPrefixes, caughtPrefixes)), digitTexts(17, 17))
+
+// TestHegelTwentyDigitIntegersSaturateThroughIntAndUint: Int and Uint of a twenty-digit
+// integer text (as a number and as a string) clamp to the type's range.
+func TestHegelTwentyDigitIntegersSaturateThroughIntAndUint(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkNumber(ht, col, hegel.Draw(ht, wrappedIntegerTexts))
+	})
+}
+
+// --------------------------------------------------------------------------- gjson/2
+
+// surrogateTokenCase: a string token with a high-surrogate escape followed by a \uXXXX escape
+// that is not a low surrogate (gjson/2) between plain pieces; under HEGEL_NO_KNOWN=1 the
+// second escape completes the pair.
+type surrogateTokenCase struct {
+	pre, post []piece
+	hi, next  int
+}
+
+var (
+	plainPieces = many(piecesOf(hegel.SampledFrom([]int{0, 1, 2, 3, 4})), 0, 3)
+	notLows     = weighted(
+		choice[int]{2, hegel.Integers(0, 0xD7FF)},
+		choice[int]{1, hegel.Integers(0xD800, 0xDBFF)},
+		choice[int]{1, hegel.Integers(0xE000, 0xFFFF)},
+	)
+	surrogateTokenCases = hegel.Composite(func(tc hegel.TestCase) surrogateTokenCase {
+		return surrogateTokenCase{
+			pre:  hegel.Draw(tc, plainPieces),
+			post: hegel.Draw(tc, plainPieces),
+			hi:   hegel.Draw(tc, hegel.Integers(0xD800, 0xDBFF)),
+			next: hegel.Draw(tc, shaped(notLows, hegel.Integers(0xDC00, 0xDFFF))),
+		}
+	})
+)
+
+func (c surrogateTokenCase) token() string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, p := range c.pre {
+		b.WriteString(p.render())
+	}
+	fmt.Fprintf(&b, `\u%04x\u%04x`, c.hi, c.next)
+	for _, p := range c.post {
+		b.WriteString(p.render())
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+func (c surrogateTokenCase) GoString() string { return c.token() }
+
+// TestHegelSurrogateEscapeKeepsTheNextEscape: a high-surrogate escape followed by an escape
+// that does not pair with it decodes as encoding/json decodes it (the second escape stays).
+func TestHegelSurrogateEscapeKeepsTheNextEscape(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkStringToken(ht, col, hegel.Draw(ht, surrogateTokenCases).token())
+	})
+}
+
+// --------------------------------------------------------------------------- keyed objects
+
+// keyedObject: an object with some chosen keys in a row among plain keys, and the index of the
+// last chosen key (the target of the path).
+type keyedObject struct {
+	root *node
+	idx  int
+}
+
+// keyedObjects builds objects around the chosen keys (in order, placed together at a drawn
+// cut among up to four plain keys of letters); duplicates keep their first member.
+func keyedObjects(chosen hegel.Generator[[]string]) hegel.Generator[keyedObject] {
+	return hegel.Composite(func(tc hegel.TestCase) keyedObject {
+		keys := hegel.Draw(tc, chosen)
+		others := hegel.Draw(tc, many(runes("ab", 1, 3), 0, 4))
+		cut := hegel.Draw(tc, indices) % (len(others) + 1)
+		all := slices.Concat(others[:cut], keys, others[cut:])
+		o := objNode()
+		for _, k := range all {
+			if o.get(k) == nil {
+				o.put(k, string(AppendJSONString(nil, k)), hegel.Draw(tc, scalars))
+			}
+		}
+		return keyedObject{o, slices.Index(o.keys, keys[len(keys)-1])}
+	})
+}
+
+// keyedCases: a document of the object with a whitespace tape, and the path built from the
+// target's index.
+func keyedCases(objects hegel.Generator[keyedObject], path func(idx int) pathSpec) hegel.Generator[pathCase] {
+	return hegel.Composite(func(tc hegel.TestCase) pathCase {
+		o := hegel.Draw(tc, objects)
+		return pathCase{doc: doc{o.root, hegel.Draw(tc, wsTapes)}, path: path(o.idx)}
+	})
+}
+
+func listOf(g hegel.Generator[string]) hegel.Generator[[]string] {
+	return hegel.Map(g, func(s string) []string { return []string{s} })
+}
+
+// --------------------------------------------------------------------------- gjson/3
+
+// escapedKeys: a key with a character Escape escapes that still makes a simple multipath name
+// (gjson/3); under HEGEL_NO_KNOWN=1 a key of letters.
+var escapedKeys = shaped(
+	cat(runes("ab", 0, 2), pick(".", "*", "?", `\`, `"`, "<", ",", "~"), runes("ab", 0, 2)),
+	runes("ab", 1, 3),
+)
+
+// TestHegelMultipathAutoNamesUnescapeTheKey: {path} named after an escaped key uses the key
+// itself as the name.
+func TestHegelMultipathAutoNamesUnescapeTheKey(t *testing.T) {
+	col := newCollector(t)
+	cases := keyedCases(keyedObjects(listOf(escapedKeys)), func(idx int) pathSpec {
+		return pathSpec{multi: &multipath{obj: true, members: []member{{chain: []simpleStep{{at: idx}}}}}}
+	})
+	property(t, func(ht *hegel.T) {
+		judgePath(ht, col, hegel.Draw(ht, cases), "gjson/3")
+	})
+}
+
+// --------------------------------------------------------------------------- gjson/4
+
+// wildcardKeyCase: an object with a decoy key before a target key that holds a literal * or ?
+// where the decoy holds a letter, and a pattern over the target with a real wildcard at its
+// first rune and the literal escaped (gjson/4: the decoy matches when the escape is read as a
+// wildcard); under HEGEL_NO_KNOWN=1 the target holds a letter too and the pattern has no
+// escape.
+type wildcardKeyCase struct {
+	pre, post string
+	wild      string
+	letter    string
+}
+
+var (
+	wildcardKeyCases = hegel.Composite(func(tc hegel.TestCase) wildcardKeyCase {
+		return wildcardKeyCase{
+			pre:    hegel.Draw(tc, runes("ab", 1, 2)),
+			post:   hegel.Draw(tc, runes("ab", 0, 2)),
+			wild:   hegel.Draw(tc, shaped(pick("*", "?"), pick("a", "b"))),
+			letter: hegel.Draw(tc, pick("a", "b")),
+		}
+	})
+	wildcardCases = keyedCases(
+		keyedObjects(hegel.Map(wildcardKeyCases, func(c wildcardKeyCase) []string {
+			return []string{c.pre + c.letter + c.post, c.pre + c.wild + c.post}
+		})),
+		func(idx int) pathSpec {
+			return pathSpec{steps: []step{{at: idx, wild: true, pattern: patternSpec{kind: 0}}}}
+		},
+	)
+)
+
+// TestHegelEscapedWildcardsStayLiteralInPatterns: a key pattern with a real wildcard and an
+// escaped one selects the key with the literal character, not an earlier key that only the
+// wildcard reading matches.
+func TestHegelEscapedWildcardsStayLiteralInPatterns(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgePath(ht, col, hegel.Draw(ht, wildcardCases), "gjson/4")
+	})
+}
+
+// --------------------------------------------------------------------------- gjson/5
+
+// colonDoc: an object of one member whose key holds a colon and whose value follows the key
+// without the colon between them (gjson/5: Path panics); under HEGEL_NO_KNOWN=1 the member is
+// well formed.
+type colonDoc struct {
+	key   string
+	value *node
+	colon string
+}
+
+var colonDocs = hegel.Composite(func(tc hegel.TestCase) colonDoc {
+	return colonDoc{
+		key:   hegel.Draw(tc, cat(runes("ab", 0, 2), lit(":"), runes("ab", 0, 2))),
+		value: hegel.Draw(tc, scalars),
+		colon: hegel.Draw(tc, shaped(lit(""), lit(":"))),
+	}
+})
+
+func (d colonDoc) text() string {
+	return "{" + string(AppendJSONString(nil, d.key)) + d.colon + compactOf(d.value) + "}"
+}
+
+func (d colonDoc) GoString() string { return show(d.text()) }
+
+// TestHegelPathSurvivesInvalidDocuments: Path and Paths of a value found in a document that
+// lacks the colon after a key holding a colon return (anything) without panicking.
+func TestHegelPathSurvivesInvalidDocuments(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, colonDocs)
+		doc := d.text()
+		col.count("cases")
+		valid := json.Valid([]byte(doc))
+		r := Get(doc, Escape(d.key))
+		if p := caught(func() { r.Path(doc); r.Paths(doc) }); p != nil {
+			col.mismatch(ht, shapesIf(!valid, "gjson/5"), "panic %v in Path/Paths\n doc %s", p, show(doc))
+			return
+		}
+		var panicked any
+		Parse(doc).ForEach(func(k, v Result) bool {
+			if panicked == nil {
+				panicked = caught(func() { v.Path(doc) })
+			}
+			return true
+		})
+		if panicked != nil {
+			col.mismatch(ht, shapesIf(!valid, "gjson/5"), "panic %v in Path of a member\n doc %s", panicked, show(doc))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- gjson/6
+
+// dottedLiterals: a multipath literal holding a '.' or '|': a decimal number or a text with
+// the character (gjson/6); under HEGEL_NO_KNOWN=1 an integer or a text of letters.
+var (
+	dottedLiterals = hegel.Composite(func(tc hegel.TestCase) literal {
+		return literal{
+			kind: hegel.Draw(tc, hegel.Integers(1, 2)),
+			num:  hegel.Draw(tc, shaped(cat(itoa(hegel.Integers(0, 99)), lit("."), digitTexts(1, 3)), itoa(hegel.Integers(0, 999)))),
+			text: hegel.Draw(tc, shaped(cat(runes("ab", 0, 2), pick(".", "|"), runes("ab", 0, 2)), runes("ab", 0, 3))),
+		}
+	})
+	dottedLiteralCases = hegel.Composite(func(tc hegel.TestCase) pathCase {
+		m := multipath{obj: true, members: []member{{isLit: true, lit: hegel.Draw(tc, dottedLiterals)}}}
+		return pathCase{doc: hegel.Draw(tc, docs), path: pathSpec{multi: &m}}
+	})
+)
+
+// TestHegelMultipathLiteralsAreNamedUnderscore: a {!literal} member holding a '.' or '|' is
+// named "_" like any other literal.
+func TestHegelMultipathLiteralsAreNamedUnderscore(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgePath(ht, col, hegel.Draw(ht, dottedLiteralCases), "gjson/6")
+	})
+}
+
+// --------------------------------------------------------------------------- gjson/7
+
+// colonKeys: a key holding a colon (gjson/7); under HEGEL_NO_KNOWN=1 a key of letters.
+var (
+	colonKeys  = shaped(cat(runes("ab", 0, 2), lit(":"), runes("ab", 0, 2)), runes("ab", 1, 3))
+	colonCases = hegel.Composite(func(tc hegel.TestCase) pathCase {
+		obj := hegel.Draw(tc, chance(50))
+		return hegel.Draw(tc, keyedCases(keyedObjects(listOf(colonKeys)), func(idx int) pathSpec {
+			return pathSpec{multi: &multipath{obj: obj, members: []member{{chain: []simpleStep{{at: idx}}}}}}
+		}))
+	})
+)
+
+// TestHegelColonKeysResolveInsideMultipaths: a member path through an escaped key holding a
+// colon selects the key's value inside [..] and {..} as it does outside.
+func TestHegelColonKeysResolveInsideMultipaths(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		judgePath(ht, col, hegel.Draw(ht, colonCases), "gjson/7")
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..5dd8862
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2828 @@
+package gjson_test
+
+// Hegel property tests for gjson (github.com/tidwall/gjson), written for the Hegel zoo.
+// See targets/go/gjson/README.md.
+//
+// Oracles: encoding/json (Valid, Unmarshal into interface{}, Marshal of strings), strconv and
+// math/big for the number accessors, and a small ordered JSON tree with a constructive model of
+// the GJSON path syntax: a path is drawn as data (a list of step records, or a multipath of
+// members) and rendered against the tree by a pure walker that resolves every drawn index modulo
+// the live sizes and computes the value the path must select, so keys, indices, `#`, `#.key`
+// mapping, wildcards, queries, pipes, modifiers, multipaths and literals are all checked against
+// known answers.
+//
+// Generators are package-level values built from the binding's combinators; every property
+// draws one case record and renders it with pure functions. Whitespace and escape choices are
+// tapes read modulo their length, so an empty tape is the plain spelling and shrinking lands on
+// it; the tree is a value generator per depth, memoised from the deepest level up.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn by default and a disagreement on one of
+// them fails naming the bug, so the wide properties that meet them are the expected failures
+// mapped to the bugs; hegel_pins_test.go keeps one plain reproducer per bug and
+// hegel_shapes_test.go one narrow property per bug. HEGEL_NO_KNOWN=1 (noKnown, read once)
+// switches the Known gates on, which steer the generators off the shapes as the old test did,
+// and assumes away what is left of them.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes every property count its classes and record its
+// mismatches instead of failing (one long run lists every remaining shape at once).
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"math/bits"
+	"os"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+
+	. "github.com/tidwall/gjson"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+// collected ends a case whose mismatch was recorded in collect mode.
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// caught runs fn and returns what it panicked with, or nil.
+func caught(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// generators draw the bugs' shapes at their natural rate and a disagreement on one fails naming
+// the bug; under HEGEL_NO_KNOWN=1 the Known switches steer the generators off the shapes and
+// what is left of them is counted and assumed away.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// fail reports a failure of the case; in collect mode it records the message and ends the case.
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the model on a case whose recorded shapes are named
+// (none for a plain failure): the shapes are counted and the failure names them, or under
+// HEGEL_NO_KNOWN=1 the case is assumed away.
+func (c *collector) mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	for _, s := range shapes {
+		c.count("shape:" + s)
+	}
+	if len(shapes) > 0 {
+		if noKnown {
+			c.count("skip:known")
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.fail(ht, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). A switch is off by default, so the properties draw the
+// bug's shape and fail on it naming the bug; HEGEL_NO_KNOWN=1 turns every switch on, and the
+// generators then avoid the shape (or the property skips it) as the old test did. The pins
+// assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	uintOverflowMissed      bool // gjson/1: parseUint's overflow check misses wraparounds that land above the previous value
+	surrogateSwallowsNext   bool // gjson/2: a high surrogate followed by a non-low \uXXXX drops the second escape
+	multipathNameKeepsEsc   bool // gjson/3: an auto-named multipath member keeps the path's backslashes in the key
+	escapedWildcardMatches  bool // gjson/4: an escaped * or ? in a key pattern still acts as a wildcard when the pattern has another one
+	pathPanicsOnInvalidJSON bool // gjson/5: Result.Path panics (index -1) on some invalid documents, e.g. {"b:"2}
+	literalAutoName         bool // gjson/6: a multipath literal containing . or | is auto-named from the text after it
+	escapeMissesColon       bool // gjson/7: Escape leaves ':' alone, which names a multipath member: [a:] on {"a:":1} is []
+}{
+	uintOverflowMissed:      noKnown,
+	surrogateSwallowsNext:   noKnown,
+	multipathNameKeepsEsc:   noKnown,
+	escapedWildcardMatches:  noKnown,
+	pathPanicsOnInvalidJSON: noKnown,
+	literalAutoName:         noKnown,
+	escapeMissesColon:       noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapesIf names a recorded bug when the case has its shape.
+func shapesIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// hegel-go has no weighted choice, biased coin, optional with a probability or tuple
+// combinator; these are the zoo's spellings.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what it
+// shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table of texts (the first is the shrink target).
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// runes is a text of lo to hi runes of the pool.
+func runes(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+func itoa(g hegel.Generator[int]) hegel.Generator[string] { return hegel.Map(g, strconv.Itoa) }
+
+// cat draws one text from each generator and concatenates them (a tuple of texts; a Composite
+// only because the binding has no tuple combinator).
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// bytesOf is the bytes of a list generator as a string.
+func bytesOf(g hegel.Generator[[]byte]) hegel.Generator[string] {
+	return hegel.Map(g, func(bs []byte) string { return string(bs) })
+}
+
+// indices: an index into a container of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var indices = hegel.Integers(0, 99)
+
+// tapes: a tape of draws read modulo its length; an empty tape reads as 0 everywhere.
+func tapes(hi, maxLen int) hegel.Generator[[]int] { return many(hegel.Integers(0, hi), 0, maxLen) }
+
+// at reads a tape modulo its length (0 for an empty tape).
+func at(tape []int, i int) int {
+	if len(tape) == 0 {
+		return 0
+	}
+	return tape[i%len(tape)]
+}
+
+// --------------------------------------------------------------------------- the JSON tree
+
+// node is an ordered JSON value that remembers the exact token text of its scalars, so a
+// document rendered from it (with any whitespace) has predictable Raw slices.
+type node struct {
+	kind  byte // 'o' object, 'a' array, 's' string, 'n' number, 't' true, 'f' false, 'z' null
+	raw   string
+	str   string
+	num   float64
+	keys  []string
+	kraw  []string
+	vals  []*node
+	elems []*node
+}
+
+func strNode(s string) *node {
+	return &node{kind: 's', raw: string(AppendJSONString(nil, s)), str: s}
+}
+
+func numNode(raw string) *node {
+	f, _ := strconv.ParseFloat(raw, 64)
+	return &node{kind: 'n', raw: raw, num: f}
+}
+
+func litNode(raw string) *node {
+	switch raw {
+	case "true":
+		return &node{kind: 't', raw: raw}
+	case "false":
+		return &node{kind: 'f', raw: raw}
+	}
+	return &node{kind: 'z', raw: "null"}
+}
+
+func arrNode(elems []*node) *node { return &node{kind: 'a', elems: elems} }
+
+func objNode() *node { return &node{kind: 'o'} }
+
+func (o *node) put(key string, kraw string, v *node) {
+	o.keys = append(o.keys, key)
+	o.kraw = append(o.kraw, kraw)
+	o.vals = append(o.vals, v)
+}
+
+func (o *node) get(key string) *node {
+	for i, k := range o.keys {
+		if k == key {
+			return o.vals[i]
+		}
+	}
+	return nil
+}
+
+// render writes the value; ws supplies the whitespace between tokens ("" for compact output).
+func (nd *node) render(b *strings.Builder, ws func() string) {
+	switch nd.kind {
+	case 'o':
+		b.WriteByte('{')
+		for i := range nd.keys {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			b.WriteString(ws())
+			b.WriteString(nd.kraw[i])
+			b.WriteString(ws())
+			b.WriteByte(':')
+			b.WriteString(ws())
+			nd.vals[i].render(b, ws)
+			b.WriteString(ws())
+		}
+		if len(nd.keys) == 0 {
+			b.WriteString(ws())
+		}
+		b.WriteByte('}')
+	case 'a':
+		b.WriteByte('[')
+		for i, e := range nd.elems {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			b.WriteString(ws())
+			e.render(b, ws)
+			b.WriteString(ws())
+		}
+		if len(nd.elems) == 0 {
+			b.WriteString(ws())
+		}
+		b.WriteByte(']')
+	default:
+		b.WriteString(nd.raw)
+	}
+}
+
+func compactOf(nd *node) string {
+	var b strings.Builder
+	nd.render(&b, func() string { return "" })
+	return b.String()
+}
+
+// compact removes inter-token whitespace from valid JSON; invalid input comes back unchanged.
+func compact(s string) string {
+	var buf bytes.Buffer
+	if err := json.Compact(&buf, []byte(s)); err != nil {
+		return s
+	}
+	return buf.String()
+}
+
+var whitespaces = []string{"", "", "", " ", "  ", "\n", "\t", "\r\n", " \n\t"}
+
+// docText renders the tree with a whitespace tape: the k-th gap (before the value, between
+// every pair of tokens, after it) gets the whitespace the tape's k-th entry names; an empty tape
+// renders compactly.
+func docText(root *node, tape []int) string {
+	k := 0
+	ws := func() string {
+		if len(tape) == 0 {
+			return ""
+		}
+		w := whitespaces[at(tape, k)%len(whitespaces)]
+		k++
+		return w
+	}
+	var b strings.Builder
+	b.WriteString(ws())
+	root.render(&b, ws)
+	b.WriteString(ws())
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- generators
+
+const keyAlphabet = "abcxyz09 _-:.*?\\|#@!\"[](){},~%<>=+'/\t\néß😀"
+
+const textAlphabet = "abc xyz019 \t\n\r\"\\/.*?|#@!<>&é中😀\x00\x01 "
+
+var (
+	// keyTexts: an object key, empty three times in a hundred.
+	keyTexts = weighted(choice[string]{3, lit("")}, choice[string]{97, runes(keyAlphabet, 1, 6)})
+	// plainTexts: a string value.
+	plainTexts = runes(textAlphabet, 0, 8)
+)
+
+func digitTexts(lo, hi int) hegel.Generator[string] { return runes("0123456789", lo, hi) }
+
+// strSpell is a string with the escape choices of its token: a tape read with one entry per
+// rune (an empty tape spells every rune the plain way, so a shrunk token is plain).
+type strSpell struct {
+	s   string
+	esc []int
+}
+
+func spellsOf(texts hegel.Generator[string]) hegel.Generator[strSpell] {
+	return hegel.Composite(func(tc hegel.TestCase) strSpell {
+		return strSpell{hegel.Draw(tc, texts), hegel.Draw(tc, tapes(99, 8))}
+	})
+}
+
+var (
+	keySpells  = spellsOf(keyTexts)
+	textSpells = spellsOf(plainTexts)
+)
+
+// token spells the string as a JSON string token with the tape's escape choices: a quote or
+// backslash as \uXXXX three times in ten, a control character in its short form seven times in
+// ten (else \uXXXX in either case), a slash escaped three times in ten, an astral rune as a
+// surrogate pair four times in ten, another non-ASCII rune as \uXXXX three times in ten.
+func (sp strSpell) token() string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for k, r := range []rune(sp.s) {
+		c := at(sp.esc, k)
+		switch {
+		case r == '"' || r == '\\':
+			if c >= 70 {
+				fmt.Fprintf(&b, `\u%04x`, r)
+			} else {
+				b.WriteByte('\\')
+				b.WriteRune(r)
+			}
+		case r < 0x20:
+			short := map[rune]string{'\n': `\n`, '\t': `\t`, '\r': `\r`}[r]
+			switch {
+			case short != "" && c < 70:
+				b.WriteString(short)
+			case c%2 == 1:
+				fmt.Fprintf(&b, `\u%04X`, r)
+			default:
+				fmt.Fprintf(&b, `\u%04x`, r)
+			}
+		case r == '/' && c >= 70:
+			b.WriteString(`\/`)
+		case r > 0xFFFF && c >= 60:
+			hi, lo := (r-0x10000)>>10+0xD800, (r-0x10000)&0x3FF+0xDC00
+			fmt.Fprintf(&b, `\u%04x\u%04x`, hi, lo)
+		case r > 0x7F && r <= 0xFFFF && c >= 70:
+			fmt.Fprintf(&b, `\u%04x`, r)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+var (
+	signs     = maybe(30, lit("-"))
+	halfSigns = maybe(50, lit("-"))
+	exponents = cat(pick("e", "E"), pick("", "+", "-"), itoa(hegel.Integers(0, 300)))
+	// numberTexts: a JSON number token (grammar-exact, magnitude within float64's range): zero,
+	// a small integer, a 13-25 digit integer, a decimal, a decimal or an integer with an
+	// exponent.
+	numberTexts = cat(signs, weighted(
+		choice[string]{1, lit("0")},
+		choice[string]{2, itoa(hegel.Integers(1, 999))},
+		choice[string]{1, cat(pick("1", "2", "3", "4", "5", "6", "7", "8", "9"), digitTexts(12, 24))},
+		choice[string]{1, cat(itoa(hegel.Integers(0, 99)), lit("."), digitTexts(1, 6))},
+		choice[string]{1, cat(itoa(hegel.Integers(0, 9)), lit("."), digitTexts(1, 3), exponents)},
+		choice[string]{1, cat(itoa(hegel.Integers(1, 9)), exponents)},
+	))
+	strNodes = hegel.Map(textSpells, func(sp strSpell) *node { return &node{kind: 's', raw: sp.token(), str: sp.s} })
+	// scalars: null, a boolean, a number, a string.
+	scalars = weighted(
+		choice[*node]{1, hegel.Map(lit("null"), litNode)},
+		choice[*node]{1, hegel.Map(pick("true", "false"), litNode)},
+		choice[*node]{2, hegel.Map(numberTexts, numNode)},
+		choice[*node]{2, strNodes},
+	)
+)
+
+// field is one member of an object: the key with its spelling, and the value.
+type field struct {
+	key strSpell
+	val *node
+}
+
+const maxDepth = 4
+
+// treeLevels builds the value generator of each depth, from the deepest (scalars only) up: a
+// value is a scalar, or an object or array of up to four members drawn from the level below.
+// Objects keep the first member of each key unless dup (documents with duplicate keys, for the
+// Valid and NothingPanics properties).
+func treeLevels(dup bool) [maxDepth + 1]hegel.Generator[*node] {
+	var levels [maxDepth + 1]hegel.Generator[*node]
+	levels[maxDepth] = scalars
+	for d := maxDepth - 1; d >= 0; d-- {
+		below := levels[d+1]
+		fields := hegel.Composite(func(tc hegel.TestCase) field {
+			return field{hegel.Draw(tc, keySpells), hegel.Draw(tc, below)}
+		})
+		objects := hegel.Map(many(fields, 0, 4), func(fs []field) *node {
+			o := objNode()
+			for _, f := range fs {
+				if !dup && o.get(f.key.s) != nil {
+					continue
+				}
+				o.put(f.key.s, f.key.token(), f.val)
+			}
+			return o
+		})
+		arrays := hegel.Map(many(below, 0, 4), arrNode)
+		levels[d] = weighted(choice[*node]{35, scalars}, choice[*node]{33, objects}, choice[*node]{32, arrays})
+	}
+	return levels
+}
+
+var (
+	uniqueLevels = treeLevels(false)
+	// trees: a value up to four containers deep with unique keys; dupTrees the same with
+	// duplicate keys allowed.
+	trees    = uniqueLevels[0]
+	dupTrees = treeLevels(true)[0]
+	// wsTapes: the whitespace of a rendering, compact four times in ten.
+	wsTapes = weighted(choice[[]int]{40, hegel.Just[[]int](nil)}, choice[[]int]{60, many(hegel.Integers(0, len(whitespaces)-1), 1, 12)})
+)
+
+// doc is a tree and the whitespace tape of its rendering.
+type doc struct {
+	root *node
+	ws   []int
+}
+
+func (d doc) text() string { return docText(d.root, d.ws) }
+
+func docsOf(values hegel.Generator[*node]) hegel.Generator[doc] {
+	return hegel.Composite(func(tc hegel.TestCase) doc {
+		return doc{hegel.Draw(tc, values), hegel.Draw(tc, wsTapes)}
+	})
+}
+
+var (
+	docs    = docsOf(trees)
+	dupDocs = docsOf(dupTrees)
+)
+
+// --------------------------------------------------------------------------- path model
+
+// glob element: a literal rune, '*' or '?'.
+type gel struct {
+	lit  rune
+	wild byte // 0, '*' or '?'
+}
+
+func globMatch(p []gel, s []rune) bool {
+	if len(p) == 0 {
+		return len(s) == 0
+	}
+	switch p[0].wild {
+	case '*':
+		for i := 0; i <= len(s); i++ {
+			if globMatch(p[1:], s[i:]) {
+				return true
+			}
+		}
+		return false
+	case '?':
+		return len(s) > 0 && globMatch(p[1:], s[1:])
+	}
+	return len(s) > 0 && s[0] == p[0].lit && globMatch(p[1:], s[1:])
+}
+
+func globString(p []gel) string {
+	var b strings.Builder
+	for _, e := range p {
+		if e.wild != 0 {
+			b.WriteByte(e.wild)
+		} else {
+			b.WriteString(Escape(string(e.lit)))
+		}
+	}
+	return b.String()
+}
+
+// hasEscapedWild: the pattern keeps a literal *, ? or \ beside its wildcard (gjson/4's shape).
+func hasEscapedWild(p []gel) bool {
+	for _, e := range p {
+		if e.wild == 0 && (e.lit == '*' || e.lit == '?' || e.lit == '\\') {
+			return true
+		}
+	}
+	return false
+}
+
+// patternSpec turns a key into a wildcard pattern that matches it: a '?' for one rune, a '*'
+// for a run of runes, or a '*' for the first rune (positions taken modulo the key's length).
+type patternSpec struct {
+	kind, i, j int
+}
+
+func (p patternSpec) apply(key string) []gel {
+	rs := []rune(key)
+	g := make([]gel, 0, len(rs)+1)
+	for _, r := range rs {
+		g = append(g, gel{lit: r})
+	}
+	switch p.kind % 3 {
+	case 0:
+		g[p.i%len(rs)] = gel{wild: '?'}
+	case 1:
+		i := p.i % (len(rs) + 1)
+		j := i + p.j%(len(rs)-i+1)
+		g = append(append(append([]gel{}, g[:i]...), gel{wild: '*'}), g[j:]...)
+	default:
+		g = append([]gel{{wild: '*'}}, g[1:]...)
+	}
+	return g
+}
+
+// step is one component of a chain path, read against the node it reaches: on an object a key
+// step (an exact key, a wildcard pattern over it, or a key no document has); on an array an
+// index, a count, a #.component mapping or a #(...) query, the last two perhaps followed by a
+// pipe on the computed array; on a scalar a dead component. Indices are taken modulo the live
+// sizes.
+type step struct {
+	pipe    bool // a '|' separator instead of '.'
+	miss    bool // on an object: a key no document has
+	missKey string
+	at      int  // the key or element index
+	wild    bool // on an object: a wildcard pattern derived from the key
+	pattern patternSpec
+	arr     int // on an array: 0-3 an index, 4 a count, 5-6 a mapping, 7-9 a query
+	mapping mapSpec
+	query   querySpec
+	after   afterSpec
+	dead    int // on a scalar: x, 0 or #
+}
+
+// mapSpec is a #.component mapping over an array: #.key with a key taken from the first object
+// element at or after the drawn one (or a key no element has), or #.index.
+type mapSpec struct {
+	byIndex bool
+	from    int
+	keyAt   int
+	missing bool
+	idx     int
+}
+
+// querySpec is a #(...) or #(...)# query over an array, shaped by one element: its key (when
+// the element is an object) and a comparison against the member's own literal or a fresh one.
+type querySpec struct {
+	elem, key int
+	exists    bool // an existence query
+	op        int
+	fresh     bool // a drawn literal rather than the target's
+	num       string
+	text      string
+	boolText  string
+	all       bool // #(...)# selects every match
+}
+
+// afterSpec is a pipe on a computed array: a count, an index or a reverse (or nothing).
+type afterSpec struct {
+	use  bool
+	kind int
+	at   int
+}
+
+// modifier is a modifier component appended to a chain: its kind and the choices of the kinds
+// that have them (flatten's depth, which identity modifier, dig's key).
+type modifier struct {
+	on         bool
+	pipe       bool
+	kind       int
+	deep       bool
+	ident      int
+	digAt      int
+	digMissing bool
+}
+
+// simpleStep is one component of a simple chain (keys and indices only): the index of the key
+// or element, or a count on an array.
+type simpleStep struct {
+	at    int
+	count bool
+}
+
+// literal is a `!` literal of a multipath: a word, a number, a string or a small object.
+type literal struct {
+	kind       int
+	word       string
+	num, text string
+}
+
+// member is one member of a multipath: a literal or a simple chain from the root, named
+// explicitly or automatically.
+type member struct {
+	isLit    bool
+	lit      literal
+	chain    []simpleStep
+	explicit bool
+	name     string
+}
+
+// multipath is a [p1,p2,...] or {p1,"name":p2,!lit,...} path.
+type multipath struct {
+	obj     bool
+	members []member
+}
+
+// pathSpec is a path as data: a chain of steps with a modifier, or a multipath.
+type pathSpec struct {
+	steps    []step
+	modifier modifier
+	multi    *multipath
+}
+
+var (
+	missKeys     = cat(runes("qrs", 1, 3), lit("zz")) // no key ends in zz: the generator never produces one
+	patternSpecs = hegel.Composite(func(tc hegel.TestCase) patternSpec {
+		return patternSpec{kind: hegel.Draw(tc, hegel.Integers(0, 2)), i: hegel.Draw(tc, indices), j: hegel.Draw(tc, indices)}
+	})
+	mapSpecs = hegel.Composite(func(tc hegel.TestCase) mapSpec {
+		return mapSpec{
+			byIndex: hegel.Draw(tc, chance(50)),
+			from:    hegel.Draw(tc, indices),
+			keyAt:   hegel.Draw(tc, indices),
+			missing: hegel.Draw(tc, chance(15)),
+			idx:     hegel.Draw(tc, hegel.Integers(0, 3)),
+		}
+	})
+	querySpecs = hegel.Composite(func(tc hegel.TestCase) querySpec {
+		return querySpec{
+			elem:     hegel.Draw(tc, indices),
+			key:      hegel.Draw(tc, indices),
+			exists:   hegel.Draw(tc, chance(15)),
+			op:       hegel.Draw(tc, hegel.Integers(0, 6)),
+			fresh:    hegel.Draw(tc, chance(30)),
+			num:      hegel.Draw(tc, numberTexts),
+			text:     hegel.Draw(tc, plainTexts),
+			boolText: hegel.Draw(tc, pick("true", "false")),
+			all:      hegel.Draw(tc, chance(50)),
+		}
+	})
+	afterSpecs = hegel.Composite(func(tc hegel.TestCase) afterSpec {
+		return afterSpec{use: hegel.Draw(tc, chance(60)), kind: hegel.Draw(tc, hegel.Integers(0, 3)), at: hegel.Draw(tc, indices)}
+	})
+	steps = hegel.Composite(func(tc hegel.TestCase) step {
+		return step{
+			pipe:    hegel.Draw(tc, chance(20)),
+			miss:    hegel.Draw(tc, chance(10)),
+			missKey: hegel.Draw(tc, missKeys),
+			at:      hegel.Draw(tc, indices),
+			wild:    hegel.Draw(tc, chance(25)),
+			pattern: hegel.Draw(tc, patternSpecs),
+			arr:     hegel.Draw(tc, hegel.Integers(0, 9)),
+			mapping: hegel.Draw(tc, mapSpecs),
+			query:   hegel.Draw(tc, querySpecs),
+			after:   hegel.Draw(tc, afterSpecs),
+			dead:    hegel.Draw(tc, hegel.Integers(0, 2)),
+		}
+	})
+	modifiers = hegel.Composite(func(tc hegel.TestCase) modifier {
+		return modifier{
+			on:         hegel.Draw(tc, chance(30)),
+			pipe:       hegel.Draw(tc, chance(20)),
+			kind:       hegel.Draw(tc, hegel.Integers(0, 9)),
+			deep:       hegel.Draw(tc, chance(50)),
+			ident:      hegel.Draw(tc, hegel.Integers(0, 4)),
+			digAt:      hegel.Draw(tc, indices),
+			digMissing: hegel.Draw(tc, chance(20)),
+		}
+	})
+	simpleSteps = hegel.Composite(func(tc hegel.TestCase) simpleStep {
+		return simpleStep{at: hegel.Draw(tc, indices), count: hegel.Draw(tc, chance(15))}
+	})
+	literals = hegel.Composite(func(tc hegel.TestCase) literal {
+		return literal{
+			kind: hegel.Draw(tc, hegel.Integers(0, 3)),
+			word: hegel.Draw(tc, pick("true", "false", "null")),
+			num:  hegel.Draw(tc, numberTexts),
+			text: hegel.Draw(tc, plainTexts),
+		}
+	})
+	members = hegel.Composite(func(tc hegel.TestCase) member {
+		return member{
+			isLit:    hegel.Draw(tc, chance(25)),
+			lit:      hegel.Draw(tc, literals),
+			chain:    hegel.Draw(tc, many(simpleSteps, 0, 3)),
+			explicit: hegel.Draw(tc, chance(40)),
+			name:     hegel.Draw(tc, plainTexts),
+		}
+	})
+	multipaths = hegel.Composite(func(tc hegel.TestCase) multipath {
+		return multipath{obj: hegel.Draw(tc, chance(50)), members: hegel.Draw(tc, many(members, 1, 4))}
+	})
+	chainPaths = hegel.Composite(func(tc hegel.TestCase) pathSpec {
+		return pathSpec{steps: hegel.Draw(tc, many(steps, 1, 4)), modifier: hegel.Draw(tc, modifiers)}
+	})
+	multiPaths = hegel.Map(multipaths, func(m multipath) pathSpec { return pathSpec{multi: &m} })
+	// pathSpecs: a chain of one to four steps, or a multipath twelve times in a hundred.
+	pathSpecs = weighted(choice[pathSpec]{88, chainPaths}, choice[pathSpec]{12, multiPaths})
+)
+
+// walk renders a path spec against a tree and models the value it selects as it goes.
+type walk struct {
+	b     strings.Builder
+	first bool
+	class string
+	done  bool // the path must end here (a count: anything after "|#" would become "#.x" mapping)
+	multi bool // inside a multipath: ':' must be escaped by hand while gjson/7's switch is on
+	// after a wildcard component a '.' continues the search into the next matching key when
+	// the rest of the path finds nothing, so from then on every separator is a '|'
+	pipeOnly bool
+	colon    bool     // a component of a multipath member holds an unescaped ':' (gjson/7's shape)
+	shapes   []string // the recorded shapes the path has
+}
+
+func (w *walk) add(sep byte, comp string) {
+	if !w.first {
+		if sep == '.' && w.b.Len() == 0 && (comp == "" || comp[0] == '.') {
+			sep = '|' // a path starting with ".." means JSON Lines (documented)
+		}
+		w.b.WriteByte(sep)
+	}
+	w.first = false
+	w.b.WriteString(comp)
+}
+
+func (w *walk) sep(pipe bool) byte {
+	if w.pipeOnly || pipe {
+		return '|'
+	}
+	return '.'
+}
+
+func (w *walk) shape(id string) {
+	if !slices.Contains(w.shapes, id) {
+		w.shapes = append(w.shapes, id)
+	}
+}
+
+// keyStep selects a member of an object: exact key, wildcard pattern, or a missing key.
+func (w *walk) keyStep(o *node, s step) *node {
+	if len(o.keys) == 0 || s.miss {
+		w.add(w.sep(s.pipe), Escape(s.missKey))
+		w.class += "K0"
+		return nil
+	}
+	i := s.at % len(o.keys)
+	key := o.keys[i]
+	if key == "" && w.pipeOnly {
+		// "|" followed by an empty component is nothing (unlike "."): take another key
+		i = -1
+		for j, k := range o.keys {
+			if k != "" {
+				i, key = j, k
+				break
+			}
+		}
+		if i < 0 {
+			w.add('|', "qzz")
+			w.class += "K0"
+			return nil
+		}
+	}
+	if key != "" && s.wild {
+		p := s.pattern.apply(key)
+		exact := false
+		if hasEscapedWild(p) {
+			if Known.escapedWildcardMatches {
+				w.class += "Kw-skip"
+				exact = true
+			} else {
+				w.shape("gjson/4")
+			}
+		}
+		if !exact {
+			w.add(w.sep(s.pipe), globString(p))
+			w.class += "Kw"
+			w.pipeOnly = true
+			for j, k := range o.keys {
+				if globMatch(p, []rune(k)) {
+					return o.vals[j]
+				}
+			}
+			return nil
+		}
+	}
+	sep := w.sep(s.pipe)
+	if key == "" {
+		sep = '.'
+	}
+	w.add(sep, Escape(key))
+	w.class += "K"
+	return o.vals[i]
+}
+
+// indexStep selects an element of an array (or one past its end).
+func (w *walk) indexStep(a *node, s step) *node {
+	j := s.at % (len(a.elems) + 1)
+	w.add(w.sep(s.pipe), strconv.Itoa(j))
+	w.class += "I"
+	if j < len(a.elems) {
+		return a.elems[j]
+	}
+	return nil
+}
+
+var (
+	numOps  = []string{"==", "=", "!=", "<", "<=", ">", ">="}
+	strOps  = []string{"==", "!=", "<", "<=", ">", ">="}
+	boolOps = []string{"==", "!="}
+)
+
+// queryStep writes a #(...) or #(...)# query on an array and returns the selection.
+func (w *walk) queryStep(a *node, s step) (*node, bool) {
+	q := s.query
+	if len(a.elems) == 0 {
+		return nil, false
+	}
+	e := a.elems[q.elem%len(a.elems)]
+	var qpath string // "" for scalar arrays
+	var target *node // the member (or element) whose value shapes the literal
+	var member func(*node) *node
+	if e.kind == 'o' && len(e.keys) > 0 {
+		i := q.key % len(e.keys)
+		k := e.keys[i]
+		if k == "" || Escape(k) != k || strings.TrimSpace(k) != k {
+			return nil, false // the query parser trims whitespace around the key
+		}
+		qpath = k
+		target = e.vals[i]
+		member = func(x *node) *node {
+			if x.kind != 'o' {
+				return nil
+			}
+			return x.get(k)
+		}
+	} else if e.kind != 'o' && e.kind != 'a' {
+		target = e
+		member = func(x *node) *node {
+			switch x.kind {
+			case 'o':
+				return x.get("") // the query path is "", which is the empty key on an object
+			case 'a':
+				return nil
+			}
+			return x
+		}
+	} else {
+		return nil, false
+	}
+	// every element's member must share the literal's kind (or be absent): the cross-kind
+	// comparisons are gjson's own conventions, not modelled here
+	kind := target.kind
+	if kind == 't' || kind == 'f' {
+		kind = 'b'
+	}
+	for _, x := range a.elems {
+		m := member(x)
+		if m == nil {
+			continue
+		}
+		mk := m.kind
+		if mk == 't' || mk == 'f' {
+			mk = 'b'
+		}
+		if mk != kind {
+			return nil, false
+		}
+	}
+	var op, lit string
+	switch {
+	case q.exists && qpath != "":
+		op, lit = "", ""
+	case kind == 'n':
+		op = numOps[q.op%len(numOps)]
+		if q.fresh {
+			lit = q.num
+		} else {
+			lit = target.raw
+		}
+	case kind == 's':
+		op = strOps[q.op%len(strOps)]
+		if q.fresh {
+			lit = string(AppendJSONString(nil, q.text))
+		} else {
+			lit = string(AppendJSONString(nil, target.str))
+		}
+	case kind == 'b':
+		op = boolOps[q.op%len(boolOps)]
+		lit = q.boolText
+	default: // null members: existence only
+		op, lit = "", ""
+	}
+	matches := func(x *node) bool {
+		m := member(x)
+		if m == nil {
+			return false
+		}
+		if op == "" {
+			return true
+		}
+		switch kind {
+		case 'n':
+			l, _ := strconv.ParseFloat(lit, 64)
+			switch op {
+			case "==", "=":
+				return m.num == l
+			case "!=":
+				return m.num != l
+			case "<":
+				return m.num < l
+			case "<=":
+				return m.num <= l
+			case ">":
+				return m.num > l
+			default:
+				return m.num >= l
+			}
+		case 's':
+			var l string
+			_ = json.Unmarshal([]byte(lit), &l)
+			switch op {
+			case "==", "=":
+				return m.str == l
+			case "!=":
+				return m.str != l
+			case "<":
+				return m.str < l
+			case "<=":
+				return m.str <= l
+			case ">":
+				return m.str > l
+			default:
+				return m.str >= l
+			}
+		default:
+			v := m.kind == 't'
+			return (op == "==") == (v == (lit == "true"))
+		}
+	}
+	text := "#(" + qpath + op + lit + ")"
+	if q.all {
+		text += "#"
+	}
+	w.add(w.sep(s.pipe), text)
+	w.class += "Q"
+	if q.all {
+		var out []*node
+		for _, x := range a.elems {
+			if matches(x) {
+				out = append(out, x)
+			}
+		}
+		w.class += "#"
+		return arrNode(out), true
+	}
+	for _, x := range a.elems {
+		if matches(x) {
+			return x, true
+		}
+	}
+	return nil, true
+}
+
+// indexKey: a component of digits only is an index on an array (leading zeros allowed).
+func indexKey(key string) (int, bool) {
+	if key == "" || strings.Trim(key, "0123456789") != "" {
+		return 0, false
+	}
+	i, err := strconv.Atoi(key)
+	return i, err == nil
+}
+
+// component selects a member of a value by one path component: the key of an object, or the
+// index of an array when the component is digits only.
+func component(x *node, key string) *node {
+	switch x.kind {
+	case 'o':
+		return x.get(key)
+	case 'a':
+		if i, ok := indexKey(key); ok && i < len(x.elems) {
+			return x.elems[i]
+		}
+	}
+	return nil
+}
+
+// mapStep writes #.comp over an array (the elements' members that exist, in order): a key
+// taken from the first object element at or after the drawn one (or a key no element has),
+// or an index.
+func (w *walk) mapStep(a *node, s step) *node {
+	m := s.mapping
+	key := "k"
+	switch {
+	case m.byIndex:
+		key = strconv.Itoa(m.idx % 4)
+	case !m.missing && len(a.elems) > 0:
+		for d := range a.elems {
+			e := a.elems[(m.from+d)%len(a.elems)]
+			if e.kind == 'o' && len(e.keys) > 0 {
+				key = e.keys[m.keyAt%len(e.keys)]
+				break
+			}
+		}
+	}
+	if key == "" {
+		key = "k"
+	}
+	w.add(w.sep(s.pipe), "#."+Escape(key))
+	var out []*node
+	for _, e := range a.elems {
+		if v := component(e, key); v != nil {
+			out = append(out, v)
+		}
+	}
+	w.class += "M"
+	return arrNode(out)
+}
+
+// afterArray: a pipe on a computed array (#.x or #(...)#): count, index or reverse.
+func (w *walk) afterArray(a *node, s afterSpec) *node {
+	switch s.kind % 4 {
+	case 0:
+		w.add('|', "#")
+		w.class += "|#"
+		w.done = true
+		return numNode(strconv.Itoa(len(a.elems)))
+	case 1:
+		i := s.at % (len(a.elems) + 1)
+		w.add('|', strconv.Itoa(i))
+		w.class += "|i"
+		if i < len(a.elems) {
+			return a.elems[i]
+		}
+		return nil
+	case 2:
+		w.add('|', "@reverse")
+		w.class += "|r"
+		return modReverse(a)
+	}
+	return a
+}
+
+// arrayStep applies a step to an array: an index, a count (the path ends), a mapping or a query
+// (each perhaps piped, and the path ends on a computed array).
+func (w *walk) arrayStep(a *node, s step) (cur *node, stop bool) {
+	switch {
+	case s.arr <= 3:
+		return w.indexStep(a, s), false
+	case s.arr == 4:
+		w.add(w.sep(s.pipe), "#")
+		w.class += "#"
+		return numNode(strconv.Itoa(len(a.elems))), true
+	case s.arr <= 6:
+		cur = w.mapStep(a, s)
+		if s.after.use {
+			cur = w.afterArray(cur, s.after)
+		}
+		return cur, w.done || cur != nil && cur.kind == 'a'
+	}
+	sel, ok := w.queryStep(a, s)
+	if !ok {
+		return w.indexStep(a, s), false
+	}
+	cur = sel
+	if cur != nil && strings.HasSuffix(w.b.String(), ")#") {
+		if s.after.use {
+			cur = w.afterArray(cur, s.after)
+		}
+		return cur, w.done || cur != nil && cur.kind == 'a'
+	}
+	return cur, false
+}
+
+func modReverse(x *node) *node {
+	switch x.kind {
+	case 'a':
+		out := make([]*node, len(x.elems))
+		for i, e := range x.elems {
+			out[len(x.elems)-1-i] = e
+		}
+		return arrNode(out)
+	case 'o':
+		o := objNode()
+		for i := len(x.keys) - 1; i >= 0; i-- {
+			o.put(x.keys[i], x.kraw[i], x.vals[i])
+		}
+		return o
+	}
+	return x
+}
+
+func modKeys(x *node) *node {
+	switch x.kind {
+	case 'o':
+		out := make([]*node, len(x.keys))
+		for i := range x.keys {
+			out[i] = &node{kind: 's', raw: x.kraw[i], str: x.keys[i]}
+		}
+		return arrNode(out)
+	case 'a':
+		out := make([]*node, len(x.elems))
+		for i := range out {
+			out[i] = litNode("null")
+		}
+		return arrNode(out)
+	}
+	return arrNode([]*node{litNode("null")})
+}
+
+func modValues(x *node) *node {
+	switch x.kind {
+	case 'o':
+		return arrNode(append([]*node{}, x.vals...))
+	case 'a':
+		return x
+	}
+	return arrNode([]*node{x})
+}
+
+func modFlatten(x *node, deep bool) *node {
+	if x.kind != 'a' {
+		return x
+	}
+	var out []*node
+	for _, e := range x.elems {
+		if e.kind == 'a' {
+			if deep {
+				out = append(out, modFlatten(e, true).elems...)
+			} else {
+				out = append(out, e.elems...)
+			}
+		} else {
+			out = append(out, e)
+		}
+	}
+	return arrNode(out)
+}
+
+func modJoin(x *node) *node {
+	if x.kind != 'a' {
+		return x
+	}
+	o := objNode()
+	for _, e := range x.elems {
+		if e.kind != 'o' {
+			continue
+		}
+		for i, k := range e.keys {
+			if j := slices.Index(o.keys, k); j >= 0 {
+				o.vals[j] = e.vals[i]
+			} else {
+				o.put(k, e.kraw[i], e.vals[i])
+			}
+		}
+	}
+	return o
+}
+
+func modGroup(x *node) *node {
+	var all []*node
+	for i, k := range x.keys {
+		v := x.vals[i]
+		if v.kind != 'a' {
+			continue
+		}
+		for j, e := range v.elems {
+			if j == len(all) {
+				all = append(all, objNode())
+			}
+			all[j].put(k, x.kraw[i], e)
+		}
+	}
+	return arrNode(all)
+}
+
+// modDig: every member selected by the component anywhere in the value, in pre-order (an index
+// component selects from arrays too).
+func modDig(x *node, key string, out []*node) []*node {
+	if v := component(x, key); v != nil {
+		out = append(out, v)
+	}
+	for _, v := range x.vals {
+		out = modDig(v, key, out)
+	}
+	for _, e := range x.elems {
+		out = modDig(e, key, out)
+	}
+	return out
+}
+
+var identities = []string{"@this", "@ugly", "@valid", "@tostr|@fromstr", "@pretty|@ugly"}
+
+// modifierStep appends a modifier (dot or pipe: the same thing after a plain value).
+func (w *walk) modifierStep(x *node, m modifier) *node {
+	sep := w.sep(m.pipe)
+	switch m.kind % 10 {
+	case 0:
+		w.add(sep, "@reverse")
+		w.class += "@rev"
+		return modReverse(x)
+	case 1:
+		w.add(sep, "@keys")
+		w.class += "@keys"
+		return modKeys(x)
+	case 2:
+		w.add(sep, "@values")
+		w.class += "@vals"
+		return modValues(x)
+	case 3:
+		if !m.deep {
+			w.add(sep, "@flatten")
+			w.class += "@flat"
+			return modFlatten(x, false)
+		}
+		w.add(sep, `@flatten:{"deep":true}`)
+		w.class += "@flatd"
+		return modFlatten(x, true)
+	case 4:
+		w.add(sep, identities[m.ident%len(identities)])
+		w.class += "@id"
+		return x
+	case 5:
+		w.add(sep, "@join")
+		w.class += "@join"
+		return modJoin(x)
+	case 6:
+		if x.kind != 'o' {
+			return x
+		}
+		w.add(sep, "@group")
+		w.class += "@group"
+		return modGroup(x)
+	case 7:
+		key := "k"
+		if x.kind == 'o' && len(x.keys) > 0 && !m.digMissing {
+			key = x.keys[m.digAt%len(x.keys)]
+		}
+		if key == "" || strings.ContainsAny(key, "|.") || Escape(key) != key {
+			return x
+		}
+		w.add(sep, "@dig:"+key)
+		w.class += "@dig"
+		return arrNode(modDig(x, key, nil))
+	}
+	return x
+}
+
+// simpleChain: keys and indices only (for multipaths, Index and Path checks); returns the
+// value, the raw text of the last component and the component's text (the key itself).
+func (w *walk) simpleChain(root *node, chain []simpleStep) (val *node, lastRaw, lastText string) {
+	cur := root
+	for _, s := range chain {
+		if cur == nil {
+			break
+		}
+		switch cur.kind {
+		case 'o':
+			if len(cur.keys) == 0 {
+				w.add('.', "qzz")
+				return nil, "qzz", "qzz"
+			}
+			j := s.at % len(cur.keys)
+			key := cur.keys[j]
+			lastRaw, lastText = Escape(key), key
+			if w.multi && strings.Contains(key, ":") {
+				if Known.escapeMissesColon {
+					lastRaw = strings.ReplaceAll(lastRaw, ":", `\:`)
+				} else {
+					w.colon = true
+				}
+			}
+			w.add('.', lastRaw)
+			cur = cur.vals[j]
+		case 'a':
+			if s.count {
+				w.add('.', "#")
+				return numNode(strconv.Itoa(len(cur.elems))), "#", "#"
+			}
+			j := s.at % (len(cur.elems) + 1)
+			lastRaw, lastText = strconv.Itoa(j), strconv.Itoa(j)
+			w.add('.', lastRaw)
+			if j < len(cur.elems) {
+				cur = cur.elems[j]
+			} else {
+				cur = nil
+			}
+		default:
+			w.add('.', "x")
+			return nil, "x", "x"
+		}
+	}
+	return cur, lastRaw, lastText
+}
+
+// render is the literal's path text and its value.
+func (l literal) render() (string, *node) {
+	switch l.kind % 4 {
+	case 0:
+		return "!" + l.word, litNode(l.word)
+	case 1:
+		return "!" + l.num, numNode(l.num)
+	case 2:
+		tok := string(AppendJSONString(nil, l.text))
+		return "!" + tok, &node{kind: 's', raw: tok, str: l.text}
+	}
+	o := objNode()
+	o.put("k", `"k"`, numNode("1"))
+	return `!{"k":1}`, o
+}
+
+// gjsonSimpleName mirrors gjson's isSimpleName: the raw last component becomes the key.
+func gjsonSimpleName(c string) bool {
+	for i := 0; i < len(c); i++ {
+		if c[i] < ' ' || strings.IndexByte("[]{}()#|!", c[i]) >= 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// multipath writes [p1,p2,...] or {p1,"name":p2,!lit,...} over simple chains from the root and
+// models the result; an empty multipath is one empty path (the "" key), not modelled.
+func (w *walk) multipath(root *node, m multipath) *node {
+	if m.obj {
+		w.b.WriteByte('{')
+	} else {
+		w.b.WriteByte('[')
+	}
+	w.first = false
+	out := objNode()
+	arr := []*node{}
+	for i, mem := range m.members {
+		if i > 0 {
+			w.b.WriteByte(',')
+		}
+		// the member's path and value first, then the name
+		var p, autoName string
+		var v *node
+		litDot, colon, escaped := false, false, false
+		if mem.isLit {
+			p, v = mem.lit.render()
+			autoName = "_"
+			if m.obj && strings.ContainsAny(p, ".|") {
+				if Known.literalAutoName {
+					autoName = `\` // gjson/6: force an explicit name below
+				} else {
+					litDot = true
+				}
+			}
+		} else {
+			sub := &walk{first: true, multi: true}
+			val, lastRaw, lastText := sub.simpleChain(root, mem.chain)
+			p = sub.b.String()
+			if p == "" {
+				// no steps, or one step into the "" key: use the root instead
+				p, lastRaw, lastText, val = "@this", "@this", "@this", root
+			}
+			v, colon = val, sub.colon
+			// the member is named after its last component (the key itself) when the raw
+			// component is a simple name
+			autoName = "_"
+			if gjsonSimpleName(lastRaw) {
+				autoName = lastText
+				escaped = lastRaw != lastText
+			}
+		}
+		explicit := m.obj && mem.explicit
+		if m.obj && escaped {
+			if Known.multipathNameKeepsEsc {
+				explicit = true // gjson/3: the auto name would keep the backslashes
+			} else if !explicit {
+				w.shape("gjson/3")
+			}
+		}
+		if litDot && !explicit {
+			w.shape("gjson/6")
+		}
+		if colon && !explicit {
+			w.shape("gjson/7") // an unescaped ':' names the member
+		}
+		name := autoName
+		if explicit {
+			name = mem.name
+			w.b.WriteString(string(AppendJSONString(nil, name)))
+			w.b.WriteByte(':')
+		}
+		w.b.WriteString(p)
+		if v == nil {
+			continue
+		}
+		if m.obj {
+			out.put(name, string(AppendJSONString(nil, name)), v)
+		} else {
+			arr = append(arr, v)
+		}
+	}
+	if m.obj {
+		w.b.WriteByte('}')
+		w.class += "{}"
+		return out
+	}
+	w.b.WriteByte(']')
+	w.class += "[]"
+	return arrNode(arr)
+}
+
+// evalPath renders the spec for root and models the value Get must return (nil: non-existent);
+// it also gives the case's class for the collector and the recorded shapes the path has.
+func evalPath(root *node, spec pathSpec) (path string, want *node, class string, shapes []string) {
+	w := &walk{first: true}
+	if spec.multi != nil {
+		want = w.multipath(root, *spec.multi)
+		return w.b.String(), want, w.class, w.shapes
+	}
+	cur := root
+	for _, s := range spec.steps {
+		if cur == nil {
+			break
+		}
+		switch cur.kind {
+		case 'o':
+			cur = w.keyStep(cur, s)
+		case 'a':
+			var stop bool
+			cur, stop = w.arrayStep(cur, s)
+			if stop {
+				return w.b.String(), cur, w.class, w.shapes
+			}
+		default:
+			// a scalar: any further component finds nothing
+			w.add(w.sep(s.pipe), []string{"x", "0", "#"}[s.dead%3])
+			w.class += "S"
+			cur = nil
+		}
+	}
+	if cur != nil && spec.modifier.on {
+		cur = w.modifierStep(cur, spec.modifier)
+	}
+	if w.b.Len() == 0 {
+		w.add('.', "@this")
+		w.class += "@this"
+	}
+	return w.b.String(), cur, w.class, w.shapes
+}
+
+// --------------------------------------------------------------------------- comparison
+
+func show(s string) string {
+	if len(s) > 300 {
+		return fmt.Sprintf("%q…(%d bytes)", s[:300], len(s))
+	}
+	return fmt.Sprintf("%q", s)
+}
+
+// checkResult compares a Result with the tree's value; "" or the problem.
+func checkResult(got Result, want *node) string {
+	if want == nil {
+		if got.Exists() {
+			return fmt.Sprintf("expected no value, got %s (%s)", show(got.Raw), got.Type)
+		}
+		return ""
+	}
+	if !got.Exists() {
+		return fmt.Sprintf("expected %s, got nothing", show(compactOf(want)))
+	}
+	var wantType Type
+	switch want.kind {
+	case 'o', 'a':
+		wantType = JSON
+	case 's':
+		wantType = String
+	case 'n':
+		wantType = Number
+	case 't':
+		wantType = True
+	case 'f':
+		wantType = False
+	default:
+		wantType = Null
+	}
+	if got.Type != wantType {
+		return fmt.Sprintf("type %s, want %s (raw %s)", got.Type, wantType, show(got.Raw))
+	}
+	if g, w := compact(got.Raw), compactOf(want); g != w {
+		return fmt.Sprintf("raw %s, want %s", show(g), show(w))
+	}
+	if want.kind == 's' && got.Str != want.str {
+		return fmt.Sprintf("Str %q, want %q", got.Str, want.str)
+	}
+	if want.kind == 'n' && got.Num != want.num && !(math.IsNaN(got.Num) && math.IsNaN(want.num)) {
+		return fmt.Sprintf("Num %v, want %v", got.Num, want.num)
+	}
+	return ""
+}
+
+// judgeGet checks Get(doc, path) against the modelled value (a disagreement names the case's
+// recorded shapes), and that GetBytes and GetMany agree with Get.
+func judgeGet(ht *hegel.T, col *collector, d, path string, want *node, class string, shapes []string) {
+	got := Get(d, path)
+	if msg := checkResult(got, want); msg != "" {
+		col.count("mismatch:" + class)
+		col.mismatch(ht, shapes, "%s\n doc  %s\n path %s\n class %s", msg, show(d), show(path), class)
+		return
+	}
+	col.count("ok:" + class)
+	// GetBytes, GetMany and Result.Get on the root agree with Get
+	gb := GetBytes([]byte(d), path)
+	if gb.Raw != got.Raw || gb.Type != got.Type || gb.Str != got.Str || gb.Index != got.Index {
+		col.fail(ht, "GetBytes differs from Get\n doc %s\n path %s\n %+v\n %+v", show(d), show(path), gb, got)
+	}
+	ms := GetMany(d, path, "@this")
+	if ms[0].Raw != got.Raw || ms[0].Type != got.Type {
+		col.fail(ht, "GetMany differs from Get\n doc %s\n path %s", show(d), show(path))
+	}
+}
+
+// --------------------------------------------------------------------------- properties
+
+// pathCase: a document and a path over its tree.
+type pathCase struct {
+	doc  doc
+	path pathSpec
+}
+
+var pathCases = hegel.Composite(func(tc hegel.TestCase) pathCase {
+	return pathCase{doc: hegel.Draw(tc, docs), path: hegel.Draw(tc, pathSpecs)}
+})
