+// GoString is what the draw report prints (it uses %#v): the document and the rendered path.
+func (c pathCase) GoString() string {
+	path, _, class, _ := evalPath(c.doc.root, c.path)
+	return fmt.Sprintf("doc %s path %s (%s)", show(c.doc.text()), show(path), class)
+}
+
+// judgePath renders the case's path, counts its class and the recorded shapes it draws, and
+// checks Get against the modelled value. bug is the narrow property's own bug, named first
+// beside the shapes the walker found (nothing under HEGEL_NO_KNOWN=1, when the narrow property
+// draws the region beside the bug).
+func judgePath(ht *hegel.T, col *collector, c pathCase, bug string) {
+	col.count("cases")
+	path, want, class, shapes := evalPath(c.doc.root, c.path)
+	if bug != "" && !noKnown && !slices.Contains(shapes, bug) {
+		shapes = append([]string{bug}, shapes...)
+	}
+	for _, s := range shapes {
+		col.count("draws:" + s)
+	}
+	judgeGet(ht, col, c.doc.text(), path, want, class, shapes)
+}
