index 0000000..7fbd836
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2045 @@
+package gjson_test
+
+// Hegel property tests for gjson (github.com/tidwall/gjson), written for the Hegel zoo.
+// See targets/go/gjson/README.md.
+//
+// Oracles: encoding/json (Valid, Unmarshal into interface{}, Marshal of strings), strconv and
+// math/big for the number accessors, and a small ordered JSON tree with a constructive model of
+// the GJSON path syntax: every generated path is built from the tree together with the value it
+// must select, so keys, indices, `#`, `#.key` mapping, wildcards, queries, pipes, modifiers,
+// multipaths and literals are all checked against known answers.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the path property record its mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+
+	. "github.com/tidwall/gjson"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// word draws lo..hi runes from alphabet.
+func word(tc hegel.TestCase, alphabet string, lo, hi int) string {
+	pool := []rune(alphabet)
+	idx := hegel.Draw(tc, hegel.Lists(hegel.Integers(0, len(pool)-1)).MinSize(lo).MaxSize(hi))
+	var b strings.Builder
+	for _, i := range idx {
+		b.WriteRune(pool[i])
+	}
+	return b.String()
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	uintOverflowMissed      bool // gjson/1: parseUint's overflow check misses wraparounds that land above the previous value
+	surrogateSwallowsNext   bool // gjson/2: a high surrogate followed by a non-low \uXXXX drops the second escape
+	multipathNameKeepsEsc   bool // gjson/3: an auto-named multipath member keeps the path's backslashes in the key
+	escapedWildcardMatches  bool // gjson/4: an escaped * or ? in a key pattern still acts as a wildcard when the pattern has another one
+	pathPanicsOnInvalidJSON bool // gjson/5: Result.Path panics (index -1) on some invalid documents, e.g. {"b:"2}
+	literalAutoName         bool // gjson/6: a multipath literal containing . or | is auto-named from the text after it
+	escapeMissesColon       bool // gjson/7: Escape leaves ':' alone, which names a multipath member: [a:] on {"a:":1} is []
+}{
+	uintOverflowMissed:      true,
+	surrogateSwallowsNext:   true,
+	multipathNameKeepsEsc:   true,
+	escapedWildcardMatches:  true,
+	pathPanicsOnInvalidJSON: true,
+	literalAutoName:         true,
+	escapeMissesColon:       true,
+}
+
+// --------------------------------------------------------------------------- the JSON tree
+
+// node is an ordered JSON value that remembers the exact token text of its scalars, so a
+// document rendered from it (with any whitespace) has predictable Raw slices.
+type node struct {
+	kind  byte // 'o' object, 'a' array, 's' string, 'n' number, 't' true, 'f' false, 'z' null
+	raw   string
+	str   string
+	num   float64
+	keys  []string
+	kraw  []string
+	vals  []*node
+	elems []*node
+}
+
+func strNode(s string) *node {
+	return &node{kind: 's', raw: string(AppendJSONString(nil, s)), str: s}
+}
+
+func numNode(raw string) *node {
+	f, _ := strconv.ParseFloat(raw, 64)
+	return &node{kind: 'n', raw: raw, num: f}
+}
+
+func litNode(raw string) *node {
+	switch raw {
+	case "true":
+		return &node{kind: 't', raw: raw}
+	case "false":
+		return &node{kind: 'f', raw: raw}
+	}
+	return &node{kind: 'z', raw: "null"}
+}
+
+func arrNode(elems []*node) *node { return &node{kind: 'a', elems: elems} }
+
+func objNode() *node { return &node{kind: 'o'} }
+
+func (o *node) put(key string, kraw string, v *node) {
+	o.keys = append(o.keys, key)
+	o.kraw = append(o.kraw, kraw)
+	o.vals = append(o.vals, v)
+}
+
+func (o *node) get(key string) *node {
+	for i, k := range o.keys {
+		if k == key {
+			return o.vals[i]
+		}
+	}
+	return nil
+}
+
+func (nd *node) isContainer() bool { return nd.kind == 'o' || nd.kind == 'a' }
+
+// render writes the value; ws supplies the whitespace between tokens ("" for compact output).
+func (nd *node) render(b *strings.Builder, ws func() string) {
+	switch nd.kind {
+	case 'o':
+		b.WriteByte('{')
+		for i := range nd.keys {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			b.WriteString(ws())
+			b.WriteString(nd.kraw[i])
+			b.WriteString(ws())
+			b.WriteByte(':')
+			b.WriteString(ws())
+			nd.vals[i].render(b, ws)
+			b.WriteString(ws())
+		}
+		if len(nd.keys) == 0 {
+			b.WriteString(ws())
+		}
+		b.WriteByte('}')
+	case 'a':
+		b.WriteByte('[')
+		for i, e := range nd.elems {
+			if i > 0 {
+				b.WriteByte(',')
+			}
+			b.WriteString(ws())
+			e.render(b, ws)
+			b.WriteString(ws())
+		}
+		if len(nd.elems) == 0 {
+			b.WriteString(ws())
+		}
+		b.WriteByte(']')
+	default:
+		b.WriteString(nd.raw)
+	}
+}
+
+func compactOf(nd *node) string {
+	var b strings.Builder
+	nd.render(&b, func() string { return "" })
+	return b.String()
+}
+
+// compact removes inter-token whitespace from valid JSON; invalid input comes back unchanged.
+func compact(s string) string {
+	var buf bytes.Buffer
+	if err := json.Compact(&buf, []byte(s)); err != nil {
+		return s
+	}
+	return buf.String()
+}
+
+// --------------------------------------------------------------------------- generators
+
+const keyAlphabet = "abcxyz09 _-:.*?\\|#@!\"[](){},~%<>=+'/\t\néß😀"
+
+const textAlphabet = "abc xyz019 \t\n\r\"\\/.*?|#@!<>&é中😀\x00\x01 "
+
+// jsonString writes s as a JSON string token, choosing escapes at random.
+func jsonString(tc hegel.TestCase, s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"' || r == '\\':
+			if chance(tc, 30) {
+				fmt.Fprintf(&b, `\u%04x`, r)
+			} else {
+				b.WriteByte('\\')
+				b.WriteRune(r)
+			}
+		case r < 0x20:
+			switch {
+			case r == '\n' && chance(tc, 70):
+				b.WriteString(`\n`)
+			case r == '\t' && chance(tc, 70):
+				b.WriteString(`\t`)
+			case r == '\r' && chance(tc, 70):
+				b.WriteString(`\r`)
+			case chance(tc, 50):
+				fmt.Fprintf(&b, `\u%04X`, r)
+			default:
+				fmt.Fprintf(&b, `\u%04x`, r)
+			}
+		case r == '/' && chance(tc, 30):
+			b.WriteString(`\/`)
+		case r > 0xFFFF && chance(tc, 40):
+			hi, lo := (r-0x10000)>>10+0xD800, (r-0x10000)&0x3FF+0xDC00
+			fmt.Fprintf(&b, `\u%04x\u%04x`, hi, lo)
+		case r > 0x7F && r <= 0xFFFF && chance(tc, 30):
+			fmt.Fprintf(&b, `\u%04x`, r)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+func genKey(tc hegel.TestCase) string {
+	if chance(tc, 3) {
+		return ""
+	}
+	return word(tc, keyAlphabet, 1, 6)
+}
+
+func genText(tc hegel.TestCase) string { return word(tc, textAlphabet, 0, 8) }
+
+func digits(tc hegel.TestCase, lo, hi int) string { return word(tc, "0123456789", lo, hi) }
+
+// genNumber draws a JSON number token (grammar-exact, magnitude within float64's range).
+func genNumber(tc hegel.TestCase) string {
+	var b strings.Builder
+	if chance(tc, 30) {
+		b.WriteByte('-')
+	}
+	switch n(tc, 0, 6) {
+	case 0:
+		b.WriteByte('0')
+	case 1, 2:
+		b.WriteString(strconv.Itoa(n(tc, 1, 999)))
+	case 3:
+		b.WriteString(pick(tc, []string{"1", "2", "3", "4", "5", "6", "7", "8", "9"}) + digits(tc, 12, 24))
+	case 4:
+		b.WriteString(strconv.Itoa(n(tc, 0, 99)) + "." + digits(tc, 1, 6))
+	case 5:
+		b.WriteString(strconv.Itoa(n(tc, 0, 9)) + "." + digits(tc, 1, 3) + pick(tc, []string{"e", "E"}) + pick(tc, []string{"", "+", "-"}) + strconv.Itoa(n(tc, 0, 300)))
+	default:
+		b.WriteString(strconv.Itoa(n(tc, 1, 9)) + pick(tc, []string{"e", "E"}) + pick(tc, []string{"", "+", "-"}) + strconv.Itoa(n(tc, 0, 300)))
+	}
+	return b.String()
+}
+
+func genScalar(tc hegel.TestCase) *node {
+	switch n(tc, 0, 5) {
+	case 0, 1:
+		s := genText(tc)
+		return &node{kind: 's', raw: jsonString(tc, s), str: s}
+	case 2, 3:
+		return numNode(genNumber(tc))
+	case 4:
+		return litNode(pick(tc, []string{"true", "false"}))
+	default:
+		return litNode("null")
+	}
+}
+
+// genNode draws a value; keys are unique unless dupKeys is set.
+func genNode(tc hegel.TestCase, depth int, dupKeys bool) *node {
+	if depth >= 4 || chance(tc, 35) {
+		return genScalar(tc)
+	}
+	if chance(tc, 50) {
+		o := objNode()
+		cnt := n(tc, 0, 4)
+		for i := 0; i < cnt; i++ {
+			k := genKey(tc)
+			if !dupKeys && o.get(k) != nil {
+				continue
+			}
+			o.put(k, jsonString(tc, k), genNode(tc, depth+1, dupKeys))
+		}
+		return o
+	}
+	cnt := n(tc, 0, 4)
+	elems := make([]*node, 0, cnt)
+	for i := 0; i < cnt; i++ {
+		elems = append(elems, genNode(tc, depth+1, dupKeys))
+	}
+	return arrNode(elems)
+}
+
+var whitespaces = []string{"", "", "", " ", "  ", "\n", "\t", "\r\n", " \n\t"}
+
+// genDoc renders a tree with random whitespace; the whitespace choices come from one drawn
+// seed so the rendering itself makes no draws.
+func genDoc(tc hegel.TestCase, root *node) string {
+	seed := uint32(n(tc, 0, 1<<30))
+	pretty := chance(tc, 60)
+	var b strings.Builder
+	ws := func() string {
+		if !pretty {
+			return ""
+		}
+		seed = seed*1664525 + 1013904223
+		return whitespaces[int(seed>>16)%len(whitespaces)]
+	}
+	b.WriteString(ws())
+	root.render(&b, ws)
+	b.WriteString(ws())
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- path model
+
+// glob element: a literal rune, '*' or '?'.
+type gel struct {
+	lit  rune
+	wild byte // 0, '*' or '?'
+}
+
+func globMatch(p []gel, s []rune) bool {
+	if len(p) == 0 {
+		return len(s) == 0
+	}
+	switch p[0].wild {
+	case '*':
+		for i := 0; i <= len(s); i++ {
+			if globMatch(p[1:], s[i:]) {
+				return true
+			}
+		}
+		return false
+	case '?':
+		return len(s) > 0 && globMatch(p[1:], s[1:])
+	}
+	return len(s) > 0 && s[0] == p[0].lit && globMatch(p[1:], s[1:])
+}
+
+func globString(p []gel) string {
+	var b strings.Builder
+	for _, e := range p {
+		if e.wild != 0 {
+			b.WriteByte(e.wild)
+		} else {
+			b.WriteString(Escape(string(e.lit)))
+		}
+	}
+	return b.String()
+}
+
+// genPattern turns a key into a wildcard pattern that matches it.
+func genPattern(tc hegel.TestCase, key string) []gel {
+	rs := []rune(key)
+	p := make([]gel, 0, len(rs)+1)
+	for _, r := range rs {
+		p = append(p, gel{lit: r})
+	}
+	switch n(tc, 0, 2) {
+	case 0:
+		i := n(tc, 0, len(rs)-1)
+		p[i] = gel{wild: '?'}
+	case 1:
+		i := n(tc, 0, len(rs))
+		j := n(tc, i, len(rs))
+		p = append(append(append([]gel{}, p[:i]...), gel{wild: '*'}), p[j:]...)
+	default:
+		p = append([]gel{{wild: '*'}}, p[1:]...)
+	}
+	return p
+}
+
+// isSimpleKey: Escape leaves the key alone and gjson's isSimpleName accepts it.
+func isSimpleKey(k string) bool {
+	if k == "" || Escape(k) != k {
+		return false
+	}
+	for i := 0; i < len(k); i++ {
+		if k[i] < ' ' || strings.IndexByte("[]{}()#|!", k[i]) >= 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// pathGen builds a path and the value it must select.
+type pathGen struct {
+	tc    hegel.TestCase
+	b     strings.Builder
+	first bool
+	class string
+	done  bool // the path must end here (a count: anything after "|#" would become "#.x" mapping)
+	multi bool // inside a multipath: ':' must be escaped by hand (gjson/7)
+	// after a wildcard component a '.' continues the search into the next matching key when
+	// the rest of the path finds nothing, so from then on every separator is a '|'
+	pipeOnly bool
+}
+
+func (g *pathGen) add(sep byte, comp string) {
+	if !g.first {
+		if sep == '.' && g.b.Len() == 0 && (comp == "" || comp[0] == '.') {
+			sep = '|' // a path starting with ".." means JSON Lines (documented)
+		}
+		g.b.WriteByte(sep)
+	}
+	g.first = false
+	g.b.WriteString(comp)
+}
+
+func (g *pathGen) sep() byte {
+	if g.pipeOnly || chance(g.tc, 20) {
+		return '|'
+	}
+	return '.'
+}
+
+// keyStep selects a member of an object: exact key, wildcard pattern, or a missing key.
+func (g *pathGen) keyStep(o *node) *node {
+	tc := g.tc
+	if len(o.keys) == 0 || chance(tc, 10) {
+		g.add(g.sep(), Escape(word(tc, "qrs", 1, 3)+"zz"))
+		g.class += "K0"
+		return nil // no key ends in zz: the generator never produces one
+	}
+	i := n(tc, 0, len(o.keys)-1)
+	key := o.keys[i]
+	if key == "" && g.pipeOnly {
+		// "|" followed by an empty component is nothing (unlike "."): take another key
+		for j, k := range o.keys {
+			if k != "" {
+				i, key = j, k
+				break
+			}
+		}
+		if key == "" {
+			g.add('|', "qzz")
+			g.class += "K0"
+			return nil
+		}
+	}
+	if key != "" && chance(tc, 25) {
+		p := genPattern(tc, key)
+		if Known.escapedWildcardMatches {
+			for _, e := range p {
+				if e.wild == 0 && (e.lit == '*' || e.lit == '?' || e.lit == '\\') {
+					g.class += "Kw-skip"
+					goto exact
+				}
+			}
+		}
+		g.add(g.sep(), globString(p))
+		g.class += "Kw"
+		g.pipeOnly = true
+		for j, k := range o.keys {
+			if globMatch(p, []rune(k)) {
+				return o.vals[j]
+			}
+		}
+		return nil
+	}
+exact:
+	sep := g.sep()
+	if key == "" {
+		sep = '.'
+	}
+	g.add(sep, Escape(key))
+	g.class += "K"
+	return o.vals[i]
+}
+
+// queryStep writes a #(...) or #(...)# query on an array and returns the selection.
+func (g *pathGen) queryStep(a *node) (*node, bool) {
+	tc := g.tc
+	if len(a.elems) == 0 {
+		return nil, false
+	}
+	e := a.elems[n(tc, 0, len(a.elems)-1)]
+	var qpath string // "" for scalar arrays
+	var target *node // the member (or element) whose value shapes the literal
+	var member func(*node) *node
+	if e.kind == 'o' && len(e.keys) > 0 {
+		i := n(tc, 0, len(e.keys)-1)
+		k := e.keys[i]
+		if k == "" || Escape(k) != k || strings.TrimSpace(k) != k {
+			return nil, false // the query parser trims whitespace around the key
+		}
+		qpath = k
+		target = e.vals[i]
+		member = func(x *node) *node {
+			if x.kind != 'o' {
+				return nil
+			}
+			return x.get(k)
+		}
+	} else if e.kind != 'o' && e.kind != 'a' {
+		target = e
+		member = func(x *node) *node {
+			switch x.kind {
+			case 'o':
+				return x.get("") // the query path is "", which is the empty key on an object
+			case 'a':
+				return nil
+			}
+			return x
+		}
+	} else {
+		return nil, false
+	}
+	// every element's member must share the literal's kind (or be absent): the cross-kind
+	// comparisons are gjson's own conventions, not modelled here
+	var op, lit string
+	kind := target.kind
+	if kind == 't' || kind == 'f' {
+		kind = 'b'
+	}
+	for _, x := range a.elems {
+		m := member(x)
+		if m == nil {
+			continue
+		}
+		mk := m.kind
+		if mk == 't' || mk == 'f' {
+			mk = 'b'
+		}
+		if mk != kind && op != "?" {
+			return nil, false
+		}
+	}
+	exists := chance(tc, 15) && qpath != ""
+	switch {
+	case exists:
+		op, lit = "", ""
+	case kind == 'n':
+		op = pick(tc, []string{"==", "=", "!=", "<", "<=", ">", ">="})
+		if chance(tc, 30) {
+			lit = genNumber(tc)
+		} else {
+			lit = target.raw
+		}
+	case kind == 's':
+		op = pick(tc, []string{"==", "!=", "<", "<=", ">", ">="})
+		if chance(tc, 30) {
+			lit = string(AppendJSONString(nil, genText(tc)))
+		} else {
+			lit = string(AppendJSONString(nil, target.str))
+		}
+	case kind == 'b':
+		op = pick(tc, []string{"==", "!="})
+		lit = pick(tc, []string{"true", "false"})
+	default: // null members: existence only
+		op, lit = "", ""
+	}
+	matches := func(x *node) bool {
+		m := member(x)
+		if m == nil {
+			return false
+		}
+		if op == "" {
+			return true
+		}
+		switch kind {
+		case 'n':
+			l, _ := strconv.ParseFloat(lit, 64)
+			switch op {
+			case "==", "=":
+				return m.num == l
+			case "!=":
+				return m.num != l
+			case "<":
+				return m.num < l
+			case "<=":
+				return m.num <= l
+			case ">":
+				return m.num > l
+			default:
+				return m.num >= l
+			}
+		case 's':
+			var l string
+			_ = json.Unmarshal([]byte(lit), &l)
+			switch op {
+			case "==", "=":
+				return m.str == l
+			case "!=":
+				return m.str != l
+			case "<":
+				return m.str < l
+			case "<=":
+				return m.str <= l
+			case ">":
+				return m.str > l
+			default:
+				return m.str >= l
+			}
+		default:
+			v := m.kind == 't'
+			return (op == "==") == (v == (lit == "true"))
+		}
+	}
+	all := chance(tc, 50)
+	q := "#(" + qpath + op + lit + ")"
+	if all {
+		q += "#"
+	}
+	g.add(g.sep(), q)
+	g.class += "Q"
+	if all {
+		var out []*node
+		for _, x := range a.elems {
+			if matches(x) {
+				out = append(out, x)
+			}
+		}
+		g.class += "#"
+		return arrNode(out), true
+	}
+	for _, x := range a.elems {
+		if matches(x) {
+			return x, true
+		}
+	}
+	return nil, true
+}
+
+// mapStep writes #.comp over an array (the elements' values that exist, in order).
+func (g *pathGen) mapStep(a *node) *node {
+	tc := g.tc
+	var out []*node
+	if chance(tc, 50) {
+		// a key taken from one object element, or a random one
+		key := "k"
+		for _, e := range a.elems {
+			if e.kind == 'o' && len(e.keys) > 0 && chance(tc, 70) {
+				key = e.keys[n(tc, 0, len(e.keys)-1)]
+				break
+			}
+		}
+		if key == "" {
+			key = "k"
+		}
+		g.add(g.sep(), "#."+Escape(key))
+		for _, e := range a.elems {
+			if e.kind == 'o' {
+				if v := e.get(key); v != nil {
+					out = append(out, v)
+				}
+			}
+		}
+	} else {
+		idx := n(tc, 0, 3)
+		g.add(g.sep(), "#."+strconv.Itoa(idx))
+		for _, e := range a.elems {
+			if e.kind == 'a' && idx < len(e.elems) {
+				out = append(out, e.elems[idx])
+			}
+		}
+	}
+	g.class += "M"
+	return arrNode(out)
+}
+
+// afterArray: a pipe on a computed array (#.x or #(...)#): count, index or reverse.
+func (g *pathGen) afterArray(a *node) *node {
+	tc := g.tc
+	switch n(tc, 0, 3) {
+	case 0:
+		g.add('|', "#")
+		g.class += "|#"
+		g.done = true
+		return numNode(strconv.Itoa(len(a.elems)))
+	case 1:
+		i := n(tc, 0, len(a.elems))
+		g.add('|', strconv.Itoa(i))
+		g.class += "|i"
+		if i < len(a.elems) {
+			return a.elems[i]
+		}
+		return nil
+	case 2:
+		g.add('|', "@reverse")
+		g.class += "|r"
+		return modReverse(a)
+	}
+	return a
+}
+
+func modReverse(x *node) *node {
+	switch x.kind {
+	case 'a':
+		out := make([]*node, len(x.elems))
+		for i, e := range x.elems {
+			out[len(x.elems)-1-i] = e
+		}
+		return arrNode(out)
+	case 'o':
+		o := objNode()
+		for i := len(x.keys) - 1; i >= 0; i-- {
+			o.put(x.keys[i], x.kraw[i], x.vals[i])
+		}
+		return o
+	}
+	return x
+}
+
+func modKeys(x *node) *node {
+	switch x.kind {
+	case 'o':
+		out := make([]*node, len(x.keys))
+		for i := range x.keys {
+			out[i] = &node{kind: 's', raw: x.kraw[i], str: x.keys[i]}
+		}
+		return arrNode(out)
+	case 'a':
+		out := make([]*node, len(x.elems))
+		for i := range out {
+			out[i] = litNode("null")
+		}
+		return arrNode(out)
+	}
+	return arrNode([]*node{litNode("null")})
+}
+
+func modValues(x *node) *node {
+	switch x.kind {
+	case 'o':
+		return arrNode(append([]*node{}, x.vals...))
+	case 'a':
+		return x
+	}
+	return arrNode([]*node{x})
+}
+
+func modFlatten(x *node, deep bool) *node {
+	if x.kind != 'a' {
+		return x
+	}
+	var out []*node
+	for _, e := range x.elems {
+		if e.kind == 'a' {
+			if deep {
+				out = append(out, modFlatten(e, true).elems...)
+			} else {
+				out = append(out, e.elems...)
+			}
+		} else {
+			out = append(out, e)
+		}
+	}
+	return arrNode(out)
+}
+
+func modJoin(x *node) *node {
+	if x.kind != 'a' {
+		return x
+	}
+	o := objNode()
+	for _, e := range x.elems {
+		if e.kind != 'o' {
+			continue
+		}
+		for i, k := range e.keys {
+			if j := indexOf(o.keys, k); j >= 0 {
+				o.vals[j] = e.vals[i]
+			} else {
+				o.put(k, e.kraw[i], e.vals[i])
+			}
+		}
+	}
+	return o
+}
+
+func modGroup(x *node) *node {
+	var all []*node
+	for i, k := range x.keys {
+		v := x.vals[i]
+		if v.kind != 'a' {
+			continue
+		}
+		for j, e := range v.elems {
+			if j == len(all) {
+				all = append(all, objNode())
+			}
+			all[j].put(k, x.kraw[i], e)
+		}
+	}
+	return arrNode(all)
+}
+
+func modDig(x *node, key string, out []*node) []*node {
+	if x.kind == 'o' {
+		if v := x.get(key); v != nil {
+			out = append(out, v)
+		}
+		for _, v := range x.vals {
+			out = modDig(v, key, out)
+		}
+	} else if x.kind == 'a' {
+		for _, e := range x.elems {
+			out = modDig(e, key, out)
+		}
+	}
+	return out
+}
+
+func indexOf(xs []string, s string) int {
+	for i, x := range xs {
+		if x == s {
+			return i
+		}
+	}
+	return -1
+}
+
+// modifierStep appends a modifier (dot or pipe: the same thing after a plain value).
+func (g *pathGen) modifierStep(x *node) *node {
+	tc := g.tc
+	sep := g.sep()
+	switch n(tc, 0, 9) {
+	case 0:
+		g.add(sep, "@reverse")
+		g.class += "@rev"
+		return modReverse(x)
+	case 1:
+		g.add(sep, "@keys")
+		g.class += "@keys"
+		return modKeys(x)
+	case 2:
+		g.add(sep, "@values")
+		g.class += "@vals"
+		return modValues(x)
+	case 3:
+		if chance(tc, 50) {
+			g.add(sep, "@flatten")
+			g.class += "@flat"
+			return modFlatten(x, false)
+		}
+		g.add(sep, `@flatten:{"deep":true}`)
+		g.class += "@flatd"
+		return modFlatten(x, true)
+	case 4:
+		g.add(sep, pick(tc, []string{"@this", "@ugly", "@valid", "@tostr|@fromstr", "@pretty|@ugly"}))
+		g.class += "@id"
+		return x
+	case 5:
+		g.add(sep, "@join")
+		g.class += "@join"
+		return modJoin(x)
+	case 6:
+		if x.kind != 'o' {
+			return x
+		}
+		g.add(sep, "@group")
+		g.class += "@group"
+		return modGroup(x)
+	case 7:
+		key := "k"
+		if x.kind == 'o' && len(x.keys) > 0 && chance(tc, 80) {
+			key = x.keys[n(tc, 0, len(x.keys)-1)]
+		}
+		if key == "" || strings.ContainsAny(key, "|.") || Escape(key) != key {
+			return x
+		}
+		g.add(sep, "@dig:"+key)
+		g.class += "@dig"
+		return arrNode(modDig(x, key, nil))
+	}
+	return x
+}
+
+// simpleChain: keys and indices only (for multipaths, Index and Path checks); returns the
+// value and the raw text of the last component.
+func (g *pathGen) simpleChain(root *node, maxSteps int) (*node, string) {
+	cur := root
+	last := ""
+	steps := n(g.tc, 0, maxSteps)
+	for i := 0; i < steps && cur != nil; i++ {
+		switch cur.kind {
+		case 'o':
+			if len(cur.keys) == 0 {
+				g.add('.', "qzz")
+				return nil, "qzz"
+			}
+			j := n(g.tc, 0, len(cur.keys)-1)
+			last = Escape(cur.keys[j])
+			if g.multi && Known.escapeMissesColon {
+				last = strings.ReplaceAll(last, ":", `\:`)
+			}
+			g.add('.', last)
+			cur = cur.vals[j]
+		case 'a':
+			if chance(g.tc, 15) {
+				g.add('.', "#")
+				return numNode(strconv.Itoa(len(cur.elems))), "#"
+			}
+			j := n(g.tc, 0, len(cur.elems))
+			last = strconv.Itoa(j)
+			g.add('.', last)
+			if j < len(cur.elems) {
+				cur = cur.elems[j]
+			} else {
+				cur = nil
+			}
+		default:
+			g.add('.', "x")
+			return nil, "x"
+		}
+	}
+	return cur, last
+}
+
+// genLiteral: a `!` literal and its value.
+func genLiteral(tc hegel.TestCase) (string, *node) {
+	switch n(tc, 0, 3) {
+	case 0:
+		s := pick(tc, []string{"true", "false", "null"})
+		return "!" + s, litNode(s)
+	case 1:
+		r := genNumber(tc)
+		return "!" + r, numNode(r)
+	case 2:
+		s := genText(tc)
+		tok := string(AppendJSONString(nil, s))
+		return "!" + tok, &node{kind: 's', raw: tok, str: s}
+	}
+	o := objNode()
+	o.put("k", `"k"`, numNode("1"))
+	return `!{"k":1}`, o
+}
+
+// gjsonSimpleName mirrors gjson's isSimpleName: the raw last component becomes the key.
+func gjsonSimpleName(c string) bool {
+	for i := 0; i < len(c); i++ {
+		if c[i] < ' ' || strings.IndexByte("[]{}()#|!", c[i]) >= 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// multipath: [p1,p2,...] or {p1,"name":p2,!lit,...} over simple chains from the root.
+func (g *pathGen) multipath(root *node) *node {
+	tc := g.tc
+	obj := chance(tc, 50)
+	if obj {
+		g.b.WriteByte('{')
+	} else {
+		g.b.WriteByte('[')
+	}
+	g.first = false
+	cnt := n(tc, 1, 4) // an empty multipath is one empty path (the "" key), not modelled
+	out := objNode()
+	arr := []*node{}
+	for i := 0; i < cnt; i++ {
+		if i > 0 {
+			g.b.WriteByte(',')
+		}
+		// the member's path and value first, then the name
+		var p, autoName string
+		var v *node
+		if chance(tc, 25) {
+			p, v = genLiteral(tc)
+			autoName = "_"
+			if obj && Known.literalAutoName && strings.ContainsAny(p, ".|") {
+				autoName = `\` // gjson/6: force an explicit name below
+			}
+		} else {
+			sub := &pathGen{tc: tc, first: true, multi: true}
+			val, lastRaw := sub.simpleChain(root, 3)
+			p = sub.b.String()
+			if p == "" {
+				// no steps, or one step into the "" key: use the root instead
+				p, lastRaw, val = "@this", "@this", root
+			}
+			v = val
+			autoName = "_"
+			if gjsonSimpleName(lastRaw) {
+				autoName = lastRaw
+			}
+		}
+		explicit := obj && chance(tc, 40)
+		if obj && Known.multipathNameKeepsEsc && strings.Contains(autoName, `\`) {
+			explicit = true // gjson/3: the auto name would keep the backslashes
+		}
+		name := autoName
+		if explicit {
+			name = genText(tc)
+			g.b.WriteString(string(AppendJSONString(nil, name)))
+			g.b.WriteByte(':')
+		}
+		g.b.WriteString(p)
+		if v == nil {
+			continue
+		}
+		if obj {
+			out.put(name, string(AppendJSONString(nil, name)), v)
+		} else {
+			arr = append(arr, v)
+		}
+	}
+	if obj {
+		g.b.WriteByte('}')
+		g.class += "{}"
+		return out
+	}
+	g.b.WriteByte(']')
+	g.class += "[]"
+	return arrNode(arr)
+}
+
+func isIndexName(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// genPath draws a path for root and the value gjson must return (nil: non-existent).
+func genPath(tc hegel.TestCase, root *node) (string, *node, string) {
+	g := &pathGen{tc: tc, first: true}
+	if chance(tc, 12) {
+		want := g.multipath(root)
+		return g.b.String(), want, g.class
+	}
+	cur := root
+	steps := n(tc, 1, 4)
+	for i := 0; i < steps && cur != nil; i++ {
+		switch cur.kind {
+		case 'o':
+			cur = g.keyStep(cur)
+		case 'a':
+			switch n(tc, 0, 9) {
+			case 0, 1, 2, 3:
+				j := n(tc, 0, len(cur.elems))
+				g.add(g.sep(), strconv.Itoa(j))
+				g.class += "I"
+				if j < len(cur.elems) {
+					cur = cur.elems[j]
+				} else {
+					cur = nil
+				}
+			case 4:
+				g.add(g.sep(), "#")
+				g.class += "#"
+				return g.b.String(), numNode(strconv.Itoa(len(cur.elems))), g.class
+			case 5, 6:
+				cur = g.mapStep(cur)
+				if chance(tc, 60) {
+					cur = g.afterArray(cur)
+				}
+				if g.done || cur != nil && cur.kind == 'a' {
+					return g.b.String(), cur, g.class
+				}
+			default:
+				sel, ok := g.queryStep(cur)
+				if !ok {
+					j := n(tc, 0, len(cur.elems))
+					g.add(g.sep(), strconv.Itoa(j))
+					g.class += "I"
+					if j < len(cur.elems) {
+						cur = cur.elems[j]
+					} else {
+						cur = nil
+					}
+					continue
+				}
+				cur = sel
+				if cur != nil && strings.HasSuffix(g.b.String(), ")#") {
+					if chance(tc, 60) {
+						cur = g.afterArray(cur)
+					}
+					if g.done || cur != nil && cur.kind == 'a' {
+						return g.b.String(), cur, g.class
+					}
+				}
+			}
+		default:
+			// a scalar: any further component finds nothing
+			g.add(g.sep(), pick(tc, []string{"x", "0", "#"}))
+			g.class += "S"
+			cur = nil
+		}
+	}
+	if cur != nil && chance(tc, 30) {
+		cur = g.modifierStep(cur)
+	}
+	if g.b.Len() == 0 {
+		g.add('.', "@this")
+		g.class += "@this"
+	}
+	return g.b.String(), cur, g.class
+}
