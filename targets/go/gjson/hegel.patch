+// --------------------------------------------------------------------------- number accessors
+
+func clampInt(x *big.Int) int64 {
+	if x.IsInt64() {
+		return x.Int64()
+	}
+	if x.Sign() < 0 {
+		return math.MinInt64
+	}
+	return math.MaxInt64
+}
+
+func clampUint(x *big.Int) uint64 {
+	if x.IsUint64() {
+		return x.Uint64()
+	}
+	if x.Sign() < 0 {
+		return 0
+	}
+	return math.MaxUint64
+}
+
+// integerText: optional '-', then digits only (gjson's parseInt/parseUint grammar).
+func integerText(s string) (*big.Int, bool) {
+	t := strings.TrimPrefix(s, "-")
+	if t == "" {
+		return nil, false
+	}
+	for i := 0; i < len(t); i++ {
+		if t[i] < '0' || t[i] > '9' {
+			return nil, false
+		}
+	}
+	x, ok := new(big.Int).SetString(s, 10)
+	return x, ok
+}
+
+func f2iModel(f float64) int64 {
+	if f >= math.MaxInt64 {
+		return math.MaxInt64
+	} else if f < math.MinInt64 {
+		return math.MinInt64
+	}
+	return int64(f)
+}
+
+func f2uModel(f float64) uint64 {
+	if f >= math.MaxUint64 {
+		return math.MaxUint64
+	} else if f < 0 {
+		return 0
+	}
+	return uint64(f)
+}
+
+func safe(f float64) bool { return f >= -9007199254740991 && f <= 9007199254740991 }
+
+// intModel: Result.Int() as documented by its code paths, with exact integer parsing.
+func intModel(r Result) int64 {
+	switch r.Type {
+	case True:
+		return 1
+	case String:
+		if x, ok := integerText(r.Str); ok {
+			return clampInt(x)
+		}
+		f, err := strconv.ParseFloat(r.Str, 64)
+		if err != nil {
+			return 0
+		}
+		return f2iModel(f)
+	case Number:
+		if safe(r.Num) {
+			return int64(r.Num)
+		}
+		if x, ok := integerText(r.Raw); ok {
+			return clampInt(x)
+		}
+		return f2iModel(r.Num)
+	}
+	return 0
+}
+
+func uintModel(r Result) uint64 {
+	switch r.Type {
+	case True:
+		return 1
+	case String:
+		if x, ok := integerText(r.Str); ok && !strings.HasPrefix(r.Str, "-") {
+			return clampUint(x)
+		}
+		f, err := strconv.ParseFloat(r.Str, 64)
+		if err != nil {
+			return 0
+		}
+		return f2uModel(f)
+	case Number:
+		if safe(r.Num) && r.Num >= 0 {
+			return uint64(r.Num)
+		}
+		if x, ok := integerText(r.Raw); ok && !strings.HasPrefix(r.Raw, "-") {
+			return clampUint(x)
+		}
+		return f2uModel(r.Num)
+	}
+	return 0
+}
+
+// integerDigits: does a wraparound of parseUint stay above the previous value? (gjson/1)
+func overflowMissed(s string) bool {
+	s = strings.TrimPrefix(s, "-")
+	var prev uint64
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+		next := prev*10 + uint64(s[i]-'0')
+		big1 := new(big.Int).Mul(new(big.Int).SetUint64(prev), big.NewInt(10))
+		big1.Add(big1, big.NewInt(int64(s[i]-'0')))
+		if !big1.IsUint64() && next >= prev {
+			return true
+		}
+		prev = next
+	}
+	return false
+}
