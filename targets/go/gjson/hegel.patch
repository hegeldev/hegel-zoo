+		}
+		// the value of a member equals the member of the value
+		res := Parse(doc)
+		res.ForEach(func(k, v Result) bool {
+			vm, _ := json.Marshal(v.Value())
+			if root.kind == 'o' {
+				m := got.(map[string]any)
+				em, _ := json.Marshal(m[k.Str])
+				if string(vm) != string(em) {
+					ht.Fatalf("ForEach value %q differs from Value()[%q]\n doc %s", vm, k.Str, show(doc))
+				}
+			}
+			return true
+		})
+	})
+}
