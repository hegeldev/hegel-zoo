+// --------------------------------------------------------------------------- lines and garbage
+
+// TestHegelForEachLineSplitsJsonLines: values separated by newlines come back one by one.
+func TestHegelForEachLineSplitsJsonLines(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		cnt := n(ht, 0, 5)
+		var b strings.Builder
+		var want []string
+		for i := 0; i < cnt; i++ {
+			root := genNode(ht, 1, false)
+			doc := genDoc(ht, root)
+			if root.kind == 'n' && chance(ht, 50) {
+				doc = strings.TrimSpace(doc)
+			}
+			b.WriteString(doc)
+			b.WriteString(pick(ht, []string{"\n", "\r\n", "\n\n"}))
+			want = append(want, compactOf(root))
+		}
+		if chance(ht, 30) {
+			b.WriteString("  ")
+		}
+		var got []string
+		ForEachLine(b.String(), func(l Result) bool {
+			got = append(got, compact(l.Raw))
+			return true
+		})
+		if strings.Join(got, "\x00") != strings.Join(want, "\x00") {
+			ht.Fatalf("ForEachLine on %s\n got  %q\n want %q", show(b.String()), got, want)
+		}
+	})
+}
+
+const pathAlphabet = "abc019.|#@!*?\\[](){}\":,~%<>=-+ x"
+
+// TestHegelNothingPanicsOnArbitraryInput: Get and friends must not panic on any input
+// (the documentation promises unexpected results, not panics).
+func TestHegelNothingPanicsOnArbitraryInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var doc string
+		switch n(ht, 0, 2) {
+		case 0:
+			doc = word(ht, "{}[]\",:0123456789.-+eEtfnul \n\\/uabxyz\x00\xff", 0, 24)
+		case 1:
+			root := genNode(ht, 0, true)
+			doc = genDoc(ht, root)
+			bs := []byte(doc)
+			for k := n(ht, 1, 3); k > 0 && len(bs) > 0; k-- {
+				pos := n(ht, 0, len(bs)-1)
+				switch n(ht, 0, 2) {
+				case 0:
+					bs = append(bs[:pos], bs[pos+1:]...)
+				case 1:
+					bs[pos] = byte(n(ht, 0, 255))
+				default:
+					bs = bs[:pos]
+				}
+			}
+			doc = string(bs)
+		default:
+			root := genNode(ht, 0, true)
+			doc = genDoc(ht, root)
+		}
+		path := word(ht, pathAlphabet, 0, 12)
+		if chance(ht, 30) {
+			path = pick(ht, []string{"@reverse", "@keys", "@values", "@flatten", "@join", "@group", "@dig:a", "@tostr", "@fromstr", "@pretty", "@ugly", "@valid", "@this", "#", "#.a", "#(a>1)#", "#(a)", "[a,b]", "{a,\"x\":b}", "!true", "..a", "a.#.b|#", "@pretty:{\"sortKeys\":true}", "@flatten:{\"deep\":true}", "@join:{\"preserve\":true}"}) + word(ht, pathAlphabet, 0, 4)
+		}
+		defer func() {
+			if r := recover(); r != nil {
+				tn := reflect.TypeOf(r).String()
+				if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+					panic(r)
+				}
+				ht.Fatalf("panic %v\n doc  %s\n path %s", r, show(doc), show(path))
+			}
+		}()
+		Valid(doc)
+		r := Get(doc, path)
+		r.Value()
+		_ = r.String()
+		r.Int()
+		r.Uint()
+		r.Float()
+		r.Bool()
+		r.Time()
+		r.Array()
+		r.Map()
+		if !Known.pathPanicsOnInvalidJSON || json.Valid([]byte(doc)) {
+			r.Path(doc)
+			r.Paths(doc)
+		}
+		r.Exists()
+		r.IsArray()
+		r.IsObject()
+		r.IsBool()
+		r.ForEach(func(k, v Result) bool { v.Value(); return true })
+		r.Get(path)
+		p := Parse(doc)
+		p.Value()
+		p.ForEach(func(k, v Result) bool {
+			if !Known.pathPanicsOnInvalidJSON || json.Valid([]byte(doc)) {
+				v.Path(doc)
+			}
+			return true
+		})
+		GetMany(doc, path, "a", "#")
+		ForEachLine(doc, func(l Result) bool { l.Value(); return true })
+		Escape(path)
+		AppendJSONString(nil, doc)
+		Get(doc, Escape(path))
+	})
+}
