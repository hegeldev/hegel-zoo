+// TestHegelForEachMatchesTheTree: ForEach/All/Keys/Values/Array/Map walk the container in order.
+func TestHegelForEachMatchesTheTree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		root := genNode(ht, 0, false)
+		doc := genDoc(ht, root)
+		res := Parse(doc)
+		var keys, raws []string
+		res.ForEach(func(k, v Result) bool {
+			keys = append(keys, k.Str)
+			raws = append(raws, compact(v.Raw))
+			return true
+		})
+		var wkeys, wraws []string
+		switch root.kind {
+		case 'o':
+			wkeys = root.keys
+			for _, v := range root.vals {
+				wraws = append(wraws, compactOf(v))
+			}
+			if !res.IsObject() || res.IsArray() {
+				ht.Fatalf("IsObject/IsArray wrong for %s", show(doc))
+			}
+		case 'a':
+			for range root.elems {
+				wkeys = append(wkeys, "")
+			}
+			for _, e := range root.elems {
+				wraws = append(wraws, compactOf(e))
+			}
+			if res.IsObject() || !res.IsArray() {
+				ht.Fatalf("IsObject/IsArray wrong for %s", show(doc))
+			}
+		default:
+			wkeys = []string{""}
+			wraws = []string{root.raw}
+			if root.kind == 'z' {
+				wraws = []string{"null"}
+			}
+		}
+		if len(raws) != len(wraws) {
+			ht.Fatalf("ForEach visits %d values, want %d\n doc %s", len(raws), len(wraws), show(doc))
+		}
+		for i := range raws {
+			if raws[i] != wraws[i] || (root.kind == 'o' && keys[i] != wkeys[i]) {
+				ht.Fatalf("ForEach #%d: key %q raw %s, want key %q raw %s\n doc %s", i, keys[i], show(raws[i]), wkeys[i], show(wraws[i]), show(doc))
+			}
+		}
+		// All, Keys, Values are the same walk
+		i := 0
+		for k, v := range res.All() {
+			if k.Str != keys[i] || compact(v.Raw) != raws[i] {
+				ht.Fatalf("All() differs from ForEach at %d\n doc %s", i, show(doc))
+			}
+			i++
+		}
+		i = 0
+		for k := range res.Keys() {
+			if k.Str != keys[i] {
+				ht.Fatalf("Keys() differs from ForEach at %d\n doc %s", i, show(doc))
+			}
+			i++
+		}
+		i = 0
+		for v := range res.Values() {
+			if compact(v.Raw) != raws[i] {
+				ht.Fatalf("Values() differs from ForEach at %d\n doc %s", i, show(doc))
+			}
+			i++
+		}
+		// Array and Map
+		arr := res.Array()
+		switch root.kind {
+		case 'a':
+			if len(arr) != len(root.elems) {
+				ht.Fatalf("Array() has %d elements, want %d\n doc %s", len(arr), len(root.elems), show(doc))
+			}
+			for j, e := range arr {
+				if compact(e.Raw) != wraws[j] {
+					ht.Fatalf("Array()[%d] = %s, want %s\n doc %s", j, show(e.Raw), show(wraws[j]), show(doc))
+				}
+			}
+		case 'z':
+			if len(arr) != 0 {
+				ht.Fatalf("Array() of null has %d elements", len(arr))
+			}
+		default:
+			if len(arr) != 1 || arr[0].Raw != res.Raw {
+				ht.Fatalf("Array() of a non-array is not [self]\n doc %s", show(doc))
+			}
+		}
+		m := res.Map()
+		if root.kind == 'o' {
+			if len(m) != len(root.keys) {
+				ht.Fatalf("Map() has %d members, want %d\n doc %s", len(m), len(root.keys), show(doc))
+			}
+			for j, k := range root.keys {
+				if compact(m[k].Raw) != wraws[j] {
+					ht.Fatalf("Map()[%q] = %s, want %s\n doc %s", k, show(m[k].Raw), show(wraws[j]), show(doc))
+				}
+			}
+		} else if len(m) != 0 {
+			ht.Fatalf("Map() of a non-object has %d members\n doc %s", len(m), show(doc))
+		}
+	})
+}
