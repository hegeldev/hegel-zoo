+// TestHegelValueMatchesEncodingJson: Parse(doc).Value() is Unmarshal's tree (unique keys).
+func TestHegelValueMatchesEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, docs)
+		root, doc := d.root, d.text()
+		if !Valid(doc) {
+			ht.Fatalf("Valid false on a generated document %s", show(doc))
+		}
+		var want any
+		if err := json.Unmarshal([]byte(doc), &want); err != nil {
+			ht.Fatalf("encoding/json rejects the generated document %s: %v", show(doc), err)
+		}
+		got := Parse(doc).Value()
+		gm, _ := json.Marshal(got)
+		wm, _ := json.Marshal(want)
+		if string(gm) != string(wm) {
+			ht.Fatalf("Value() differs from encoding/json\n doc  %s\n got  %s\n want %s", show(doc), show(string(gm)), show(string(wm)))
+		}
+		// the value of a member equals the member of the value
+		res := Parse(doc)
+		res.ForEach(func(k, v Result) bool {
+			vm, _ := json.Marshal(v.Value())
+			if root.kind == 'o' {
+				m := got.(map[string]any)
+				em, _ := json.Marshal(m[k.Str])
+				if string(vm) != string(em) {
+					ht.Fatalf("ForEach value %q differs from Value()[%q]\n doc %s", vm, k.Str, show(doc))
+				}
+			}
+			return true
+		})
+	})
+}
+
+// edit is one corruption of a document's bytes, its position taken modulo the live length: a
+// byte deleted, junk inserted, a byte replaced, the text truncated, junk appended, or the first
+// colon from the position on dropped (which leaves a key followed by its value, the shape of
+// gjson/5 when the key itself holds a colon).
+type edit struct {
+	kind, at int
+	junk     string
+	b        byte
+}
+
+const junkAlphabet = " \t\n\r{}[]\",:.-+eE0123456789tfnul\\/uabxyz\x00\x7f\xff "
+
+var (
+	junkBytes = hegel.SampledFrom([]byte(junkAlphabet))
+	edits     = hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{
+			kind: hegel.Draw(tc, hegel.Integers(0, 5)),
+			at:   hegel.Draw(tc, indices),
+			junk: hegel.Draw(tc, bytesOf(many(junkBytes, 1, 3))),
+			b:    hegel.Draw(tc, weighted(choice[byte]{3, junkBytes}, choice[byte]{1, hegel.Integers[byte](0, 255)})),
+		}
+	})
+)
+
+func (e edit) apply(bs []byte) []byte {
+	pos := e.at % (len(bs) + 1)
+	switch e.kind % 6 {
+	case 0:
+		if pos < len(bs) {
+			return append(bs[:pos], bs[pos+1:]...)
+		}
+	case 1:
+		return append(bs[:pos], append([]byte(e.junk[:1]), bs[pos:]...)...)
+	case 2:
+		if pos < len(bs) {
+			bs[pos] = e.b
+		}
+	case 3:
+		return bs[:pos]
+	case 4:
+		return append(bs, e.junk...)
+	default:
+		if i := bytes.IndexByte(bs[pos:], ':'); i >= 0 {
+			return append(bs[:pos+i], bs[pos+i+1:]...)
+		}
+	}
+	return bs
+}
+
+// corrupt applies the edits to the text in turn.
+func corrupt(s string, es []edit) string {
+	bs := []byte(s)
+	for _, e := range es {
+		bs = e.apply(bs)
+	}
+	return string(bs)
+}
+
+// validCase: a document (duplicate keys allowed) and up to three corruptions of it.
+type validCase struct {
+	doc   doc
+	edits []edit
+}
+
+var validCases = hegel.Composite(func(tc hegel.TestCase) validCase {
+	return validCase{doc: hegel.Draw(tc, dupDocs), edits: hegel.Draw(tc, many(edits, 0, 3))}
+})
+
+func (c validCase) GoString() string {
+	return fmt.Sprintf("doc %s corrupted to %s", show(c.doc.text()), show(corrupt(c.doc.text(), c.edits)))
+}
+
+// TestHegelValidAgreesWithEncodingJson: Valid on valid documents and on their mutations.
+func TestHegelValidAgreesWithEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, validCases)
+		doc := c.doc.text()
+		if !Valid(doc) || !ValidBytes([]byte(doc)) {
+			ht.Fatalf("Valid false on a generated document %s", show(doc))
+		}
+		doc = corrupt(doc, c.edits)
+		if g, w := Valid(doc), json.Valid([]byte(doc)); g != w {
+			ht.Fatalf("Valid(%s) = %v, encoding/json says %v", show(doc), g, w)
+		}
+	})
+}
+
+// locateCase: a document, a simple chain into it, where to split the chain for Result.Get, and
+// which element and key the #.key mapping takes (all modulo the live sizes).
+type locateCase struct {
+	doc              doc
+	chain            []simpleStep
+	split, elem, key int
+}
+
+var locateCases = hegel.Composite(func(tc hegel.TestCase) locateCase {
+	return locateCase{
+		doc:   hegel.Draw(tc, docs),
+		chain: hegel.Draw(tc, many(simpleSteps, 1, 5)),
+		split: hegel.Draw(tc, indices),
+		elem:  hegel.Draw(tc, indices),
+		key:   hegel.Draw(tc, indices),
+	}
+})
+
+func (c locateCase) GoString() string {
+	w := &walk{first: true}
+	_, _, _ = w.simpleChain(c.doc.root, c.chain)
+	return fmt.Sprintf("doc %s path %s", show(c.doc.text()), show(w.b.String()))
+}
+
+// TestHegelIndexesAndPathsLocateTheValue: Index/Indexes point at Raw, Path/Paths round-trip,
+// Result.Get chains like a longer path (documents with unique keys).
+func TestHegelIndexesAndPathsLocateTheValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, locateCases)
+		root, doc := c.doc.root, c.doc.text()
+		w := &walk{first: true}
+		want, _, _ := w.simpleChain(root, c.chain)
+		path := w.b.String()
+		ht.Assume(path != "") // one step into the root's "" key
+		got := Get(doc, path)
+		if msg := checkResult(got, want); msg != "" {
+			ht.Fatalf("%s\n doc %s\n path %s", msg, show(doc), show(path))
+		}
+		if want == nil {
+			return
+		}
+		if strings.HasSuffix(path, ".#") || path == "#" {
+			return // a count has no place in the document
+		}
+		if strings.Contains(path, "|") {
+			// leading empty components are joined by '|' (see add), and a piped path is
+			// evaluated on the Raw of its left part, so its Index is 0 ("unknown") by contract
+			return
+		}
+		if got.Index <= 0 && (root.kind != want.kind || compactOf(root) != compactOf(want)) {
+			// Index 0 is "unknown" by contract, but a simple path always knows
+			ht.Fatalf("Index %d for %s in %s", got.Index, show(path), show(doc))
+		}
+		if got.Index+len(got.Raw) > len(doc) || doc[got.Index:got.Index+len(got.Raw)] != got.Raw {
+			ht.Fatalf("Index %d does not locate Raw %s in %s (path %s)", got.Index, show(got.Raw), show(doc), show(path))
+		}
+		// Path round-trip
+		p := got.Path(doc)
+		back := Get(doc, p)
+		if back.Raw != got.Raw || back.Index != got.Index {
+			ht.Fatalf("Path() gives %s, which selects %s at %d, not %s at %d\n doc %s\n path %s", show(p), show(back.Raw), back.Index, show(got.Raw), got.Index, show(doc), show(path))
+		}
+		// Result.Get after a split of the chain
+		comps := strings.Split(path, ".")
+		if len(comps) > 1 {
+			k := 1 + c.split%(len(comps)-1)
+			// the split must not fall inside an escaped dot, and the tail must not start with
+			// ".." (JSON Lines mode)
+			if !strings.HasSuffix(comps[k-1], `\`) && !strings.HasPrefix(strings.Join(comps[k:], "."), "..") {
+				head, tail := strings.Join(comps[:k], "."), strings.Join(comps[k:], ".")
+				sub := Get(doc, head).Get(tail)
+				if sub.Raw != got.Raw || sub.Index != got.Index || sub.Type != got.Type || sub.Str != got.Str {
+					ht.Fatalf("Get(%s).Get(%s) = %s at %d, Get(%s) = %s at %d\n doc %s", show(head), show(tail), show(sub.Raw), sub.Index, show(path), show(got.Raw), got.Index, show(doc))
+				}
+			}
+		}
+		// #.key mapping: Indexes, ForEach's Index, Paths
+		if want.kind == 'a' && len(want.elems) > 0 {
+			e := want.elems[c.elem%len(want.elems)]
+			if e.kind != 'o' || len(e.keys) == 0 {
+				return
+			}
+			key := e.keys[c.key%len(e.keys)]
+			mp := path + ".#." + Escape(key)
+			mres := Get(doc, mp)
+			var elems []*node
+			for _, x := range want.elems {
+				if x.kind == 'o' {
+					if v := x.get(key); v != nil {
+						elems = append(elems, v)
+					}
+				}
+			}
+			if msg := checkResult(mres, arrNode(elems)); msg != "" {
+				ht.Fatalf("%s\n doc %s\n path %s", msg, show(doc), show(mp))
+			}
+			if len(mres.Indexes) != len(elems) {
+				ht.Fatalf("%d Indexes for %d values\n doc %s\n path %s", len(mres.Indexes), len(elems), show(doc), show(mp))
+			}
+			i := 0
+			mres.ForEach(func(_, v Result) bool {
+				if v.Index+len(v.Raw) > len(doc) || doc[v.Index:v.Index+len(v.Raw)] != v.Raw {
+					ht.Fatalf("element %d: Index %d does not locate %s\n doc %s\n path %s", i, v.Index, show(v.Raw), show(doc), show(mp))
+				}
+				i++
+				return true
+			})
+			paths := mres.Paths(doc)
+			if len(paths) != len(elems) {
+				ht.Fatalf("Paths gives %d paths for %d values\n doc %s\n path %s", len(paths), len(elems), show(doc), show(mp))
+			}
+			for j, p := range paths {
+				if b := Get(doc, p); b.Raw != mres.Array()[j].Raw {
+					ht.Fatalf("Paths()[%d] = %s selects %s, want %s\n doc %s\n path %s", j, show(p), show(b.Raw), show(mres.Array()[j].Raw), show(doc), show(mp))
+				}
+			}
+		}
+	})
+}
+
+// TestHegelForEachMatchesTheTree: ForEach/All/Keys/Values/Array/Map walk the container in order.
+func TestHegelForEachMatchesTheTree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, docs)
+		root, doc := d.root, d.text()
+		res := Parse(doc)
+		var keys, raws []string
+		res.ForEach(func(k, v Result) bool {
+			keys = append(keys, k.Str)
+			raws = append(raws, compact(v.Raw))
+			return true
+		})
+		var wkeys, wraws []string
+		switch root.kind {
+		case 'o':
+			wkeys = root.keys
+			for _, v := range root.vals {
+				wraws = append(wraws, compactOf(v))
+			}
+			if !res.IsObject() || res.IsArray() {
+				ht.Fatalf("IsObject/IsArray wrong for %s", show(doc))
+			}
+		case 'a':
+			for range root.elems {
+				wkeys = append(wkeys, "")
+			}
+			for _, e := range root.elems {
+				wraws = append(wraws, compactOf(e))
+			}
+			if res.IsObject() || !res.IsArray() {
+				ht.Fatalf("IsObject/IsArray wrong for %s", show(doc))
+			}
+		default:
+			wkeys = []string{""}
+			wraws = []string{root.raw}
+			if root.kind == 'z' {
+				wraws = []string{"null"}
+			}
+		}
+		if len(raws) != len(wraws) {
+			ht.Fatalf("ForEach visits %d values, want %d\n doc %s", len(raws), len(wraws), show(doc))
+		}
+		for i := range raws {
+			if raws[i] != wraws[i] || (root.kind == 'o' && keys[i] != wkeys[i]) {
+				ht.Fatalf("ForEach #%d: key %q raw %s, want key %q raw %s\n doc %s", i, keys[i], show(raws[i]), wkeys[i], show(wraws[i]), show(doc))
+			}
+		}
+		// All, Keys, Values are the same walk
+		i := 0
+		for k, v := range res.All() {
+			if k.Str != keys[i] || compact(v.Raw) != raws[i] {
+				ht.Fatalf("All() differs from ForEach at %d\n doc %s", i, show(doc))
+			}
+			i++
+		}
+		i = 0
+		for k := range res.Keys() {
+			if k.Str != keys[i] {
+				ht.Fatalf("Keys() differs from ForEach at %d\n doc %s", i, show(doc))
+			}
+			i++
+		}
+		i = 0
+		for v := range res.Values() {
+			if compact(v.Raw) != raws[i] {
+				ht.Fatalf("Values() differs from ForEach at %d\n doc %s", i, show(doc))
+			}
+			i++
+		}
+		// Array and Map
+		arr := res.Array()
+		switch root.kind {
+		case 'a':
+			if len(arr) != len(root.elems) {
+				ht.Fatalf("Array() has %d elements, want %d\n doc %s", len(arr), len(root.elems), show(doc))
+			}
+			for j, e := range arr {
+				if compact(e.Raw) != wraws[j] {
+					ht.Fatalf("Array()[%d] = %s, want %s\n doc %s", j, show(e.Raw), show(wraws[j]), show(doc))
+				}
+			}
+		case 'z':
+			if len(arr) != 0 {
+				ht.Fatalf("Array() of null has %d elements", len(arr))
+			}
+		default:
+			if len(arr) != 1 || arr[0].Raw != res.Raw {
+				ht.Fatalf("Array() of a non-array is not [self]\n doc %s", show(doc))
+			}
+		}
+		m := res.Map()
+		if root.kind == 'o' {
+			if len(m) != len(root.keys) {
+				ht.Fatalf("Map() has %d members, want %d\n doc %s", len(m), len(root.keys), show(doc))
+			}
+			for j, k := range root.keys {
+				if compact(m[k].Raw) != wraws[j] {
+					ht.Fatalf("Map()[%q] = %s, want %s\n doc %s", k, show(m[k].Raw), show(wraws[j]), show(doc))
+				}
+			}
+		} else if len(m) != 0 {
+			ht.Fatalf("Map() of a non-object has %d members\n doc %s", len(m), show(doc))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- number accessors
+
+func clampInt(x *big.Int) int64 {
+	if x.IsInt64() {
+		return x.Int64()
+	}
+	if x.Sign() < 0 {
+		return math.MinInt64
+	}
+	return math.MaxInt64
+}
+
+func clampUint(x *big.Int) uint64 {
+	if x.IsUint64() {
+		return x.Uint64()
+	}
+	if x.Sign() < 0 {
+		return 0
+	}
+	return math.MaxUint64
+}
+
+// integerText: optional '-', then digits only (gjson's parseInt/parseUint grammar).
+func integerText(s string) (*big.Int, bool) {
+	t := strings.TrimPrefix(s, "-")
+	if t == "" {
+		return nil, false
+	}
+	for i := 0; i < len(t); i++ {
+		if t[i] < '0' || t[i] > '9' {
+			return nil, false
+		}
+	}
+	x, ok := new(big.Int).SetString(s, 10)
+	return x, ok
+}
+
+func f2iModel(f float64) int64 {
+	if f >= math.MaxInt64 {
+		return math.MaxInt64
+	} else if f < math.MinInt64 {
+		return math.MinInt64
+	}
+	return int64(f)
+}
+
+func f2uModel(f float64) uint64 {
+	if f >= math.MaxUint64 {
+		return math.MaxUint64
+	} else if f < 0 {
+		return 0
+	}
+	return uint64(f)
+}
+
+func safe(f float64) bool { return f >= -9007199254740991 && f <= 9007199254740991 }
+
+// intModel: Result.Int() as documented by its code paths, with exact integer parsing.
+func intModel(r Result) int64 {
+	switch r.Type {
+	case True:
+		return 1
+	case String:
+		if x, ok := integerText(r.Str); ok {
+			return clampInt(x)
+		}
+		f, err := strconv.ParseFloat(r.Str, 64)
+		if err != nil {
+			return 0
+		}
+		return f2iModel(f)
+	case Number:
+		if safe(r.Num) {
+			return int64(r.Num)
+		}
+		if x, ok := integerText(r.Raw); ok {
+			return clampInt(x)
+		}
+		return f2iModel(r.Num)
+	}
+	return 0
+}
+
+func uintModel(r Result) uint64 {
+	switch r.Type {
+	case True:
+		return 1
+	case String:
+		if x, ok := integerText(r.Str); ok && !strings.HasPrefix(r.Str, "-") {
+			return clampUint(x)
+		}
+		f, err := strconv.ParseFloat(r.Str, 64)
+		if err != nil {
+			return 0
+		}
+		return f2uModel(f)
+	case Number:
+		if safe(r.Num) && r.Num >= 0 {
+			return uint64(r.Num)
+		}
+		if x, ok := integerText(r.Raw); ok && !strings.HasPrefix(r.Raw, "-") {
+			return clampUint(x)
+		}
+		return f2uModel(r.Num)
+	}
+	return 0
+}
+
+// wrapsAbove: appending the digit to the accumulated value overflows uint64 and the wrapped
+// value is not below the previous one, which parseUint's `next < n` check misses (gjson/1).
+func wrapsAbove(n uint64, d byte) bool {
+	hi, lo := bits.Mul64(n, 10)
+	next, carry := bits.Add64(lo, uint64(d), 0)
+	return (hi != 0 || carry != 0) && next >= n
+}
+
+// wrapsBelow: the digit overflows and parseUint catches it (it then saturates).
+func wrapsBelow(n uint64, d byte) bool {
+	hi, lo := bits.Mul64(n, 10)
+	next, carry := bits.Add64(lo, uint64(d), 0)
+	return (hi != 0 || carry != 0) && next < n
+}
+
+// overflowMissed: parseUint's reading of the digits wraps uint64 at some step without the wrap
+// ever landing below the previous value, so the value comes back wrapped (gjson/1's shape).
+// Once a wrap lands below, parseUint saturates and later digits do not matter; a negative text
+// whose wrapped value is above MaxInt64 is rejected by parseInt and read as a float instead,
+// which hides the wrap.
+func overflowMissed(s string) bool {
+	neg := strings.HasPrefix(s, "-")
+	s = strings.TrimPrefix(s, "-")
+	var n uint64
+	wrapped := false
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+		d := s[i] - '0'
+		if wrapsBelow(n, d) {
+			return false
+		}
+		wrapped = wrapped || wrapsAbove(n, d)
+		n = n*10 + uint64(d)
+	}
+	return wrapped && !(neg && n > math.MaxInt64)
+}
+
+// wrapBand is how many times 10n+d wraps uint64.
+func wrapBand(n uint64, d byte) uint64 {
+	hi, lo := bits.Mul64(n, 10)
+	_, carry := bits.Add64(lo, uint64(d), 0)
+	return hi + carry
+}
+
+// overflowPrefixes: the three-digit prefixes p of the twenty-digit integers p·10^16+x (x any
+// sixteen digits) whose twentieth digit wraps uint64 above the previous value (missed, the
+// shape of gjson/1) and those whose wrap parseUint catches; each verdict is constant over the
+// prefix's range, which is checked at both ends within one wrap band.
+var missedPrefixes, caughtPrefixes = overflowPrefixes()
+
+func overflowPrefixes() (missed, caught []string) {
+	for p := uint64(100); p <= 999; p++ {
+		lo, hi := p*1e16, (p+1)*1e16-1
+		if wrapBand(lo, 0) != wrapBand(hi, 9) {
+			continue
+		}
+		switch {
+		case wrapsAbove(lo, 0) && wrapsAbove(hi, 9):
+			missed = append(missed, strconv.FormatUint(p, 10))
+		case wrapsBelow(lo, 0) && wrapsBelow(hi, 9):
+			caught = append(caught, strconv.FormatUint(p, 10))
+		}
+	}
+	return missed, caught
+}
+
+var (
+	// caughtOverflowTexts: a 20-22 digit integer whose first overflow parseUint catches (the
+	// region beside gjson/1).
+	caughtOverflowTexts = cat(hegel.SampledFrom(caughtPrefixes), digitTexts(17, 19))
+	longPrefixes        = pick("1", "9", "18", "92", "184", "2", "3", "36", "20")
+	numberTable  = pick("9007199254740991", "9007199254740992", "9007199254740993", "-9007199254740993", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551615", "18446744073709551616", "1e19", "1.5", "-0", "0.999", "1e400", "-1e400", "2e-400")
+	// rawNumbers: a JSON number; a 16-25 digit integer around the 64-bit boundary (the region
+	// of gjson/1; under HEGEL_NO_KNOWN=1 a 20-22 digit one whose overflow parseUint catches);
+	// 1-30 digits (1-19 under HEGEL_NO_KNOWN=1); a boundary of the table; junk around the
+	// number alphabet.
+	rawNumbers = weighted(
+		choice[string]{1, numberTexts},
+		choice[string]{1, cat(halfSigns, shaped(cat(longPrefixes, digitTexts(15, 22)), caughtOverflowTexts))},
+		choice[string]{1, cat(halfSigns, shaped(digitTexts(1, 30), digitTexts(1, 19)))},
+		choice[string]{1, numberTable},
+		choice[string]{1, runes("0123456789.-+eExabc ", 0, 8)},
+	)
+)
+
+// checkNumber checks Int, Uint, Float, Bool and String on the text as a JSON number (when it is
+// one) and as a JSON string, against the strconv/math/big models. A wrong Int or Uint on a
+// text whose overflow parseUint misses names gjson/1; under HEGEL_NO_KNOWN=1 such a text is
+// counted and assumed away.
+func checkNumber(ht *hegel.T, col *collector, raw string) {
+	col.count("cases")
+	var shapes []string
+	if overflowMissed(raw) {
+		shapes = []string{"gjson/1"}
+		col.count("draws:gjson/1")
+		if Known.uintOverflowMissed {
+			col.count("skip:gjson/1")
+			ht.Assume(false)
+		}
+	}
+	f, ferr := strconv.ParseFloat(raw, 64)
+	// as a JSON number (only when it is one), and as a JSON string
+	if _, ok := integerText(raw); ok && !strings.HasPrefix(raw, "-0") || json.Valid([]byte(raw)) && strings.TrimSpace(raw) == raw {
+		r := Get(`{"v":`+raw+`}`, "v")
+		if r.Type != Number {
+			col.fail(ht, "Get %s gives type %s", raw, r.Type)
+		}
+		if r.Raw != raw {
+			col.fail(ht, "Raw %q for %q", r.Raw, raw)
+		}
+		if r.Num != f && !(math.IsNaN(r.Num) && math.IsNaN(f)) && ferr == nil {
+			col.fail(ht, "Num %v for %q, ParseFloat says %v", r.Num, raw, f)
+		}
+		if g, w := r.Int(), intModel(r); g != w {
+			col.mismatch(ht, shapes, "Int() of number %s = %d, want %d", raw, g, w)
+		}
+		if g, w := r.Uint(), uintModel(r); g != w {
+			col.mismatch(ht, shapes, "Uint() of number %s = %d, want %d", raw, g, w)
+		}
+		if r.Float() != r.Num && !math.IsNaN(r.Num) {
+			col.fail(ht, "Float() of number %s = %v, Num %v", raw, r.Float(), r.Num)
+		}
+		if r.Bool() != (r.Num != 0) {
+			col.fail(ht, "Bool() of number %s = %v", raw, r.Bool())
+		}
+		wantStr := strconv.FormatFloat(r.Num, 'f', -1, 64)
+		if _, ok := integerText(raw); ok {
+			wantStr = raw
+		}
+		if r.String() != wantStr {
+			col.fail(ht, "String() of number %s = %q, want %q", raw, r.String(), wantStr)
+		}
+	}
+	s := Get(`{"v":"`+raw+`"}`, "v")
+	if s.Type != String || s.Str != raw {
+		col.fail(ht, "string %q comes back as %s %q", raw, s.Type, s.Str)
+	}
+	if g, w := s.Int(), intModel(s); g != w {
+		col.mismatch(ht, shapes, "Int() of string %q = %d, want %d", raw, g, w)
+	}
+	if g, w := s.Uint(), uintModel(s); g != w {
+		col.mismatch(ht, shapes, "Uint() of string %q = %d, want %d", raw, g, w)
+	}
+	wf := f
+	if ferr != nil {
+		wf = 0
+		if math.IsInf(f, 0) {
+			wf = f // ParseFloat returns ±Inf with a range error
+		}
+	}
+	if s.Float() != wf && !(math.IsNaN(s.Float()) && math.IsNaN(wf)) {
+		col.fail(ht, "Float() of string %q = %v, want %v", raw, s.Float(), wf)
+	}
+	pb, perr := strconv.ParseBool(strings.ToLower(raw))
+	if s.Bool() != (perr == nil && pb) {
+		col.fail(ht, "Bool() of string %q = %v", raw, s.Bool())
+	}
+}
+
+// TestHegelNumberAccessorsMatchTheirModels: Int, Uint, Float, Bool, String on numbers and on
+// numeric strings, against strconv/math/big. It draws the shape of gjson/1 (a 20-digit integer
+// whose wraparound parseUint misses).
+func TestHegelNumberAccessorsMatchTheirModels(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkNumber(ht, col, hegel.Draw(ht, rawNumbers))
+	})
+}
+
+// --------------------------------------------------------------------------- strings
+
+// piece is one part of a string token: plain text; a short escape; a \uXXXX escape of a BMP
+// code point in lower or upper case hex; a surrogate pair; a lone high or low surrogate; a high
+// surrogate followed by an escaped letter (gjson/2's shape); a lone high or low surrogate
+// followed by a plain letter (the region beside gjson/2, drawn under HEGEL_NO_KNOWN=1 in place
+// of the lone and the high-then-escape pieces).
+type piece struct {
+	kind   int
+	text   string
+	esc    string
+	cp     int
+	hi, lo int
+	letter int
+}
+
+// piecesOf is a piece of one of the kinds.
+func piecesOf(kinds hegel.Generator[int]) hegel.Generator[piece] {
+	return hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{
+			kind:   hegel.Draw(tc, kinds),
+			text:   hegel.Draw(tc, runes("abc xé中😀/", 1, 3)),
+			esc:    hegel.Draw(tc, pick(`\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`)),
+			cp:     hegel.Draw(tc, hegel.Integers(0, 0xD7FF)),
+			hi:     hegel.Draw(tc, hegel.Integers(0, 0x3FF)),
+			lo:     hegel.Draw(tc, hegel.Integers(0, 0x3FF)),
+			letter: hegel.Draw(tc, hegel.Integers(0x41, 0x5A)),
+		}
+	})
+}
+
+var (
+	pieceKinds = shaped(hegel.SampledFrom([]int{0, 0, 0, 1, 2, 3, 4, 5, 6, 7}), hegel.SampledFrom([]int{0, 0, 0, 1, 2, 3, 4, 4, 8, 9}))
+	pieces     = piecesOf(pieceKinds)
+	// stringTokens: a JSON string token of up to six pieces, with every kind of escape,
+	// including lone surrogates; encoding/json's reading of it is the reference.
+	stringTokens = hegel.Map(many(pieces, 0, 6), renderToken)
+)
+
+func (p piece) render() string {
+	switch p.kind % 10 {
+	case 0:
+		return p.text
+	case 1:
+		return p.esc
+	case 2:
+		return fmt.Sprintf(`\u%04x`, p.cp)
+	case 3:
+		return fmt.Sprintf(`\u%04X`, 0xE000+p.cp%0x2000)
+	case 4:
+		return fmt.Sprintf(`\u%04x\u%04x`, 0xD800+p.hi, 0xDC00+p.lo)
+	case 5:
+		return fmt.Sprintf(`\u%04x`, 0xD800+p.hi) // lone high surrogate
+	case 6:
+		return fmt.Sprintf(`\u%04x`, 0xDC00+p.lo) // lone low surrogate
+	case 7:
+		return fmt.Sprintf(`\u%04x\u%04x`, 0xD800+p.hi, p.letter) // high then a letter
+	case 8:
+		return fmt.Sprintf(`\u%04x%c`, 0xD800+p.hi, rune(p.letter))
+	}
+	return fmt.Sprintf(`\u%04x%c`, 0xDC00+p.lo, rune(p.letter))
+}
+
+func renderToken(ps []piece) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, p := range ps {
+		b.WriteString(p.render())
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// surrogateThenEscape: read as gjson reads the token, a \uD800-\uDFFF escape is followed by a
+// \uXXXX escape that does not complete a surrogate pair with it (gjson/2 drops the second
+// escape); a completed pair is consumed whole, so the low half of a pair followed by an escape
+// is not the shape.
+func surrogateThenEscape(tok string) bool {
+	hex := func(h string) int {
+		v, err := strconv.ParseUint(h, 16, 32)
+		if err != nil {
+			return -1
+		}
+		return int(v)
+	}
+	for i := 0; i < len(tok); i++ {
+		if tok[i] != '\\' || i+1 >= len(tok) {
+			continue
+		}
+		if tok[i+1] != 'u' || i+6 > len(tok) {
+			i++ // a short escape
+			continue
+		}
+		a := hex(tok[i+2 : i+6])
+		if a >= 0xD800 && a <= 0xDFFF && i+12 <= len(tok) && tok[i+6] == '\\' && tok[i+7] == 'u' {
+			b := hex(tok[i+8 : i+12])
+			if a <= 0xDBFF && b >= 0xDC00 && b <= 0xDFFF {
+				i += 11 // a pair
+				continue
+			}
+			if b >= 0 {
+				return true
+			}
+		}
+		i += 5
+	}
+	return false
+}
+
+// checkStringToken checks that Str of the token equals Unmarshal's string, through Parse, Get,
+// a key found through Escape and a query. A disagreement on a token with a surrogate escape
+// followed by an unpaired \uXXXX names gjson/2; under HEGEL_NO_KNOWN=1 such a token is counted
+// and assumed away.
+func checkStringToken(ht *hegel.T, col *collector, tok string) {
+	col.count("cases")
+	var shapes []string
+	if surrogateThenEscape(tok) {
+		shapes = []string{"gjson/2"}
+		col.count("draws:gjson/2")
+		if Known.surrogateSwallowsNext {
+			col.count("skip:gjson/2")
+			ht.Assume(false)
+		}
+	}
+	if !json.Valid([]byte(tok)) {
+		col.fail(ht, "generator made an invalid token %s", tok)
+	}
+	if !Valid(tok) {
+		col.fail(ht, "Valid(%s) = false, encoding/json accepts it", tok)
+	}
+	var want string
+	_ = json.Unmarshal([]byte(tok), &want)
+	if got := Parse(tok); got.Type != String || got.Str != want || got.Raw != tok {
+		col.mismatch(ht, shapes, "Parse(%s): type %s Str %q Raw %q, want Str %q", tok, got.Type, got.Str, got.Raw, want)
+	}
+	if got := Get(`{"k":`+tok+`}`, "k"); got.Str != want {
+		col.mismatch(ht, shapes, "Get(%s): Str %q, want %q", tok, got.Str, want)
+	}
+	if got := Get(`{`+tok+`:1}`, Escape(want)); !got.Exists() || got.Raw != "1" {
+		col.mismatch(ht, shapes, "key %s (%q) is not found through Escape: %q", tok, want, Escape(want))
+	}
+	if got := Get(`[`+tok+`]`, `#(=="`+strings.Trim(string(AppendJSONString(nil, want)), `"`)+`")`); got.Str != want {
+		col.mismatch(ht, shapes, "query for %q on [%s] gives %q", want, tok, got.Str)
+	}
+}
+
+// TestHegelStringDecodingMatchesEncodingJson: Str of a string token equals Unmarshal's string.
+// It draws the shape of gjson/2 (a surrogate escape followed by an unpaired \uXXXX escape).
+func TestHegelStringDecodingMatchesEncodingJson(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkStringToken(ht, col, hegel.Draw(ht, stringTokens))
+	})
+}
+
+// appendCase: a string (text, or any bytes three times in ten) and a prefix to append to.
+type appendCase struct {
+	s, prefix string
+}
+
+var appendCases = hegel.Composite(func(tc hegel.TestCase) appendCase {
+	return appendCase{
+		s:      hegel.Draw(tc, weighted(choice[string]{70, plainTexts}, choice[string]{30, bytesOf(many(hegel.Integers[byte](0, 255), 0, 8))})),
+		prefix: hegel.Draw(tc, runes("ab", 0, 2)),
+	}
+})
+
+// TestHegelAppendJSONStringMatchesEncodingJson: the same bytes as json.Marshal, and readable back.
+func TestHegelAppendJSONStringMatchesEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, appendCases)
+		s, prefix := c.s, c.prefix
+		got := AppendJSONString([]byte(prefix), s)
+		want, _ := json.Marshal(s)
+		if string(got) != prefix+string(want) {
+			ht.Fatalf("AppendJSONString(%q) = %s, json.Marshal gives %s", s, got[len(prefix):], want)
+		}
+		back := Parse(string(want))
+		if utf8.ValidString(s) && back.Str != s {
+			ht.Fatalf("Parse(%s).Str = %q, want %q", want, back.Str, s)
+		}
+		if !Valid(string(want)) {
+			ht.Fatalf("Valid(%s) = false", want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- ordering
+
+func lowerASCII(s string) string {
+	b := []byte(s)
+	for i, c := range b {
+		if c >= 'A' && c <= 'Z' {
+			b[i] = c + 32
+		}
+	}
+	return string(b)
+}
+
+func lessModel(a, b Result, cs bool) bool {
+	if a.Type != b.Type {
+		return a.Type < b.Type
+	}
+	switch a.Type {
+	case String:
+		if cs {
+			return a.Str < b.Str
+		}
+		return lowerASCII(a.Str) < lowerASCII(b.Str)
+	case Number:
+		return a.Num < b.Num
+	}
+	return a.Raw < b.Raw
+}
+
+var (
+	// lessValues: a value up to two containers deep, or a string of letters in both cases.
+	lessValues = weighted(
+		choice[*node]{60, uniqueLevels[2]},
+		choice[*node]{40, hegel.Map(runes("aAbBzZ09 é", 0, 4), strNode)},
+	)
+	lessCases = hegel.Composite(func(tc hegel.TestCase) lessCase {
+		return lessCase{
+			a:  hegel.Draw(tc, lessValues),
+			b:  hegel.Draw(tc, lessValues),
+			c:  hegel.Draw(tc, lessValues),
+			cs: hegel.Draw(tc, chance(50)),
+		}
+	})
+)
+
+// lessCase: three values to order, and whether strings compare case-sensitively.
+type lessCase struct {
+	a, b, c *node
+	cs      bool
+}
+
+func (c lessCase) GoString() string {
+	return fmt.Sprintf("%s, %s, %s (caseSensitive %v)", compactOf(c.a), compactOf(c.b), compactOf(c.c), c.cs)
+}
+
+// TestHegelLessIsAStrictWeakOrder: Less against its documented model, and the order laws.
+func TestHegelLessIsAStrictWeakOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		lc := hegel.Draw(ht, lessCases)
+		a, b, c, cs := Parse(compactOf(lc.a)), Parse(compactOf(lc.b)), Parse(compactOf(lc.c)), lc.cs
+		for _, p := range [][2]Result{{a, b}, {b, c}, {a, c}, {a, a}} {
+			if g, w := p[0].Less(p[1], cs), lessModel(p[0], p[1], cs); g != w {
+				ht.Fatalf("Less(%s, %s, %v) = %v, want %v", show(p[0].Raw), show(p[1].Raw), cs, g, w)
+			}
+		}
+		if a.Less(a, cs) {
+			ht.Fatalf("Less is not irreflexive on %s", show(a.Raw))
+		}
+		if a.Less(b, cs) && b.Less(a, cs) {
+			ht.Fatalf("Less is not asymmetric on %s, %s", show(a.Raw), show(b.Raw))
+		}
+		if a.Less(b, cs) && b.Less(c, cs) && !a.Less(c, cs) && !(math.IsNaN(a.Num) || math.IsNaN(b.Num) || math.IsNaN(c.Num)) {
+			ht.Fatalf("Less is not transitive on %s, %s, %s", show(a.Raw), show(b.Raw), show(c.Raw))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lines and garbage
+
+// lineDoc: one value of a JSON Lines text: a tree up to three containers deep, its whitespace,
+// whether a number is written without its whitespace, and the line break after it.
+type lineDoc struct {
+	root *node
+	ws   []int
+	trim bool
+	sep  string
+}
+
+// linesCase: up to five values and whether blanks follow the last line break.
+type linesCase struct {
+	lines    []lineDoc
+	trailing bool
+}
+
+var (
+	lineDocs = hegel.Composite(func(tc hegel.TestCase) lineDoc {
+		return lineDoc{
+			root: hegel.Draw(tc, uniqueLevels[1]),
+			ws:   hegel.Draw(tc, wsTapes),
+			trim: hegel.Draw(tc, chance(50)),
+			sep:  hegel.Draw(tc, pick("\n", "\r\n", "\n\n")),
+		}
+	})
+	linesCases = hegel.Composite(func(tc hegel.TestCase) linesCase {
+		return linesCase{lines: hegel.Draw(tc, many(lineDocs, 0, 5)), trailing: hegel.Draw(tc, chance(30))}
+	})
+)
+
+// text renders the lines; want is the compact value of each.
+func (c linesCase) text() (text string, want []string) {
+	var b strings.Builder
+	for _, l := range c.lines {
+		d := docText(l.root, l.ws)
+		if l.root.kind == 'n' && l.trim {
+			d = strings.TrimSpace(d)
+		}
+		b.WriteString(d)
+		b.WriteString(l.sep)
+		want = append(want, compactOf(l.root))
+	}
+	if c.trailing {
+		b.WriteString("  ")
+	}
+	return b.String(), want
+}
+
+func (c linesCase) GoString() string {
+	text, _ := c.text()
+	return show(text)
+}
+
+// TestHegelForEachLineSplitsJsonLines: values separated by newlines come back one by one.
+func TestHegelForEachLineSplitsJsonLines(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, linesCases)
+		text, want := c.text()
+		var got []string
+		ForEachLine(text, func(l Result) bool {
+			got = append(got, compact(l.Raw))
+			return true
+		})
+		if strings.Join(got, "\x00") != strings.Join(want, "\x00") {
+			ht.Fatalf("ForEachLine on %s\n got  %q\n want %q", show(text), got, want)
+		}
+	})
+}
+
+const pathAlphabet = "abc019.|#@!*?\\[](){}\":,~%<>=-+ x"
+
+const chaosAlphabet = "{}[]\",:0123456789.-+eEtfnul \n\\/uabxyz\x00\xff"
+
+// chaos is the document of a NothingPanics case: random bytes, a document with duplicate keys
+// corrupted by one to three edits, or such a document as rendered.
+type chaos struct {
+	kind  int
+	junk  string
+	doc   doc
+	edits []edit
+}
+
+func (c chaos) text() string {
+	switch c.kind % 3 {
+	case 0:
+		return c.junk
+	case 1:
+		return corrupt(c.doc.text(), c.edits)
+	}
+	return c.doc.text()
+}
+
+// chaosCase: a document and a path of path characters, or a special component followed by some.
+type chaosCase struct {
+	doc  chaos
+	path string
+}
+
+var (
+	specialPaths = []string{"@reverse", "@keys", "@values", "@flatten", "@join", "@group", "@dig:a", "@tostr", "@fromstr", "@pretty", "@ugly", "@valid", "@this", "#", "#.a", "#(a>1)#", "#(a)", "[a,b]", "{a,\"x\":b}", "!true", "..a", "a.#.b|#", "@pretty:{\"sortKeys\":true}", "@flatten:{\"deep\":true}", "@join:{\"preserve\":true}"}
+	chaosDocs    = hegel.Composite(func(tc hegel.TestCase) chaos {
+		return chaos{
+			kind:  hegel.Draw(tc, hegel.Integers(0, 2)),
+			junk:  hegel.Draw(tc, bytesOf(many(hegel.SampledFrom([]byte(chaosAlphabet)), 0, 24))),
+			doc:   hegel.Draw(tc, dupDocs),
+			edits: hegel.Draw(tc, many(edits, 1, 3)),
+		}
+	})
+	chaosPaths = weighted(
+		choice[string]{70, runes(pathAlphabet, 0, 12)},
+		choice[string]{30, cat(hegel.SampledFrom(specialPaths), runes(pathAlphabet, 0, 4))},
+	)
+	chaosCases = hegel.Composite(func(tc hegel.TestCase) chaosCase {
+		return chaosCase{doc: hegel.Draw(tc, chaosDocs), path: hegel.Draw(tc, chaosPaths)}
+	})
+)
+
+func (c chaosCase) GoString() string {
+	return fmt.Sprintf("doc %s path %s", show(c.doc.text()), show(c.path))
+}
+
+// checkNothingPanics runs the document and path through Get and friends. Path and Paths on an
+// invalid document are checked in a recover: a panic there names gjson/5; under
+// HEGEL_NO_KNOWN=1 they are not called on an invalid document (counted).
+func checkNothingPanics(ht *hegel.T, col *collector, doc, path string) {
+	col.count("cases")
+	valid := json.Valid([]byte(doc))
+	pathsOK := !Known.pathPanicsOnInvalidJSON || valid
+	if !pathsOK {
+		col.count("skip:gjson/5")
+	}
+	Valid(doc)
+	r := Get(doc, path)
+	r.Value()
+	_ = r.String()
+	r.Int()
+	r.Uint()
+	r.Float()
+	r.Bool()
+	r.Time()
+	r.Array()
+	r.Map()
+	if pathsOK {
+		if p := caught(func() { r.Path(doc); r.Paths(doc) }); p != nil {
+			col.mismatch(ht, shapesIf(!valid, "gjson/5"), "panic %v in Path/Paths\n doc  %s\n path %s", p, show(doc), show(path))
+		}
+	}
+	r.Exists()
+	r.IsArray()
+	r.IsObject()
+	r.IsBool()
+	r.ForEach(func(k, v Result) bool { v.Value(); return true })
+	r.Get(path)
+	p := Parse(doc)
+	p.Value()
+	var panicked any
+	p.ForEach(func(k, v Result) bool {
+		if pathsOK && panicked == nil {
+			panicked = caught(func() { v.Path(doc) })
+		}
+		return true
+	})
+	if panicked != nil {
+		col.mismatch(ht, shapesIf(!valid, "gjson/5"), "panic %v in Path of a member\n doc  %s\n path %s", panicked, show(doc), show(path))
+	}
+	GetMany(doc, path, "a", "#")
+	ForEachLine(doc, func(l Result) bool { l.Value(); return true })
+	Escape(path)
+	AppendJSONString(nil, doc)
+	Get(doc, Escape(path))
+}
+
+// TestHegelNothingPanicsOnArbitraryInput: Get and friends must not panic on any input
+// (the documentation promises unexpected results, not panics). It draws the shape of gjson/5
+// (an invalid document whose key holds a colon and lacks the colon before its value).
+func TestHegelNothingPanicsOnArbitraryInput(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, chaosCases)
+		checkNothingPanics(ht, col, c.doc.text(), c.path)
+	})
+}
+
+// wsCase: a tree, two whitespace tapes to render it with, and a path over it.
+type wsCase struct {
+	root     *node
+	ws1, ws2 []int
+	path     pathSpec
+}
+
+var wsCases = hegel.Composite(func(tc hegel.TestCase) wsCase {
+	return wsCase{
+		root: hegel.Draw(tc, trees),
+		ws1:  hegel.Draw(tc, wsTapes),
+		ws2:  hegel.Draw(tc, wsTapes),
+		path: hegel.Draw(tc, pathSpecs),
+	}
+})
+
+func (c wsCase) GoString() string {
+	path, _, _, _ := evalPath(c.root, c.path)
+	return fmt.Sprintf("docs %s and %s path %s", show(docText(c.root, c.ws1)), show(docText(c.root, c.ws2)), show(path))
+}
+
+// TestHegelWhitespaceDoesNotChangeTheValue: the same tree rendered two ways gives the same
+// results (Type, Str, Num, compact Raw) for the same path.
+func TestHegelWhitespaceDoesNotChangeTheValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wsCases)
+		d1, d2 := docText(c.root, c.ws1), docText(c.root, c.ws2)
+		path, _, _, _ := evalPath(c.root, c.path)
+		a, b := Get(d1, path), Get(d2, path)
+		if a.Type != b.Type || a.Str != b.Str || (a.Num != b.Num && !(math.IsNaN(a.Num) && math.IsNaN(b.Num))) || compact(a.Raw) != compact(b.Raw) || a.Exists() != b.Exists() {
+			ht.Fatalf("whitespace changes the result of %s\n %s -> %s %s\n %s -> %s %s", show(path), show(d1), a.Type, show(a.Raw), show(d2), b.Type, show(b.Raw))
+		}
+	})
+}
