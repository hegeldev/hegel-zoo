+// --------------------------------------------------------------------------- strings
+
+// genStringToken: a JSON string token with every kind of escape, including lone surrogates;
+// encoding/json's reading of it is the reference.
+func genStringToken(tc hegel.TestCase) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for cnt := n(tc, 0, 6); cnt > 0; cnt-- {
+		switch n(tc, 0, 9) {
+		case 0, 1, 2:
+			b.WriteString(word(tc, "abc xé中😀/", 1, 3))
+		case 3:
+			b.WriteString(pick(tc, []string{`\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`}))
+		case 4:
+			fmt.Fprintf(&b, `\u%04x`, n(tc, 0, 0xD7FF))
+		case 5:
+			fmt.Fprintf(&b, `\u%04X`, 0xE000+n(tc, 0, 0x1FFF))
+		case 6:
+			fmt.Fprintf(&b, `\u%04x\u%04x`, 0xD800+n(tc, 0, 0x3FF), 0xDC00+n(tc, 0, 0x3FF))
+		case 7:
+			fmt.Fprintf(&b, `\u%04x`, 0xD800+n(tc, 0, 0x3FF)) // lone high surrogate
+		case 8:
+			fmt.Fprintf(&b, `\u%04x`, 0xDC00+n(tc, 0, 0x3FF)) // lone low surrogate
+		default:
+			fmt.Fprintf(&b, `\u%04x\u%04x`, 0xD800+n(tc, 0, 0x3FF), n(tc, 0x41, 0x5A)) // high then a letter
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// surrogateThenEscape: a \uD800-\uDFFF escape followed by a \uXXXX escape that does not
+// complete a surrogate pair with it (gjson/2 drops the second escape).
+func surrogateThenEscape(tok string) bool {
+	hex := func(h string) int {
+		v, err := strconv.ParseUint(h, 16, 32)
+		if err != nil {
+			return -1
+		}
+		return int(v)
+	}
+	for i := 0; i+12 <= len(tok); i++ {
+		if tok[i] != '\\' || tok[i+1] != 'u' || tok[i+6] != '\\' || tok[i+7] != 'u' {
+			continue
+		}
+		a, b := hex(tok[i+2:i+6]), hex(tok[i+8:i+12])
+		if a >= 0xD800 && a <= 0xDFFF && b >= 0 && !(a <= 0xDBFF && b >= 0xDC00 && b <= 0xDFFF) {
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelStringDecodingMatchesEncodingJson: Str of a string token equals Unmarshal's string.
+func TestHegelStringDecodingMatchesEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tok := genStringToken(ht)
+		if Known.surrogateSwallowsNext && surrogateThenEscape(tok) {
+			return
+		}
+		if !json.Valid([]byte(tok)) {
+			ht.Fatalf("generator made an invalid token %s", tok)
+		}
+		if !Valid(tok) {
+			ht.Fatalf("Valid(%s) = false, encoding/json accepts it", tok)
+		}
+		var want string
+		_ = json.Unmarshal([]byte(tok), &want)
+		if got := Parse(tok); got.Type != String || got.Str != want || got.Raw != tok {
+			ht.Fatalf("Parse(%s): type %s Str %q Raw %q, want Str %q", tok, got.Type, got.Str, got.Raw, want)
+		}
+		if got := Get(`{"k":`+tok+`}`, "k"); got.Str != want {
+			ht.Fatalf("Get(%s): Str %q, want %q", tok, got.Str, want)
+		}
+		if got := Get(`{`+tok+`:1}`, Escape(want)); !got.Exists() || got.Raw != "1" {
+			ht.Fatalf("key %s (%q) is not found through Escape: %q", tok, want, Escape(want))
+		}
+		if got := Get(`[`+tok+`]`, `#(=="`+strings.Trim(string(AppendJSONString(nil, want)), `"`)+`")`); got.Str != want {
+			ht.Fatalf("query for %q on [%s] gives %q", want, tok, got.Str)
+		}
+	})
+}
+
+// TestHegelAppendJSONStringMatchesEncodingJson: the same bytes as json.Marshal, and readable back.
+func TestHegelAppendJSONStringMatchesEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var s string
+		if chance(ht, 30) {
+			bs := make([]byte, n(ht, 0, 8))
+			for i := range bs {
+				bs[i] = byte(n(ht, 0, 255))
+			}
+			s = string(bs)
+		} else {
+			s = genText(ht)
+		}
+		prefix := word(ht, "ab", 0, 2)
+		got := AppendJSONString([]byte(prefix), s)
+		want, _ := json.Marshal(s)
+		if string(got) != prefix+string(want) {
+			ht.Fatalf("AppendJSONString(%q) = %s, json.Marshal gives %s", s, got[len(prefix):], want)
+		}
+		back := Parse(string(want))
+		if utf8.ValidString(s) && back.Str != s {
+			ht.Fatalf("Parse(%s).Str = %q, want %q", want, back.Str, s)
+		}
+		if !Valid(string(want)) {
+			ht.Fatalf("Valid(%s) = false", want)
+		}
+	})
+}
