+// TestHegelValidAgreesWithEncodingJson: Valid on valid documents and on their mutations.
+func TestHegelValidAgreesWithEncodingJson(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		root := genNode(ht, 0, true)
+		doc := genDoc(ht, root)
+		if !Valid(doc) || !ValidBytes([]byte(doc)) {
+			ht.Fatalf("Valid false on a generated document %s", show(doc))
+		}
+		for round := n(ht, 0, 3); round > 0; round-- {
+			bs := []byte(doc)
+			junk := " \t\n\r{}[]\",:.-+eE0123456789tfnul\\/uabxyz\x00\x7f\xff "
+			pos := n(ht, 0, len(bs))
+			switch n(ht, 0, 4) {
+			case 0:
+				if pos < len(bs) {
+					bs = append(bs[:pos], bs[pos+1:]...)
+				}
+			case 1:
+				c := word(ht, junk, 1, 1)
+				bs = append(bs[:pos], append([]byte(c), bs[pos:]...)...)
+			case 2:
+				if pos < len(bs) {
+					bs[pos] = word(ht, junk, 1, 1)[0]
+				}
+			case 3:
+				bs = bs[:pos]
+			default:
+				bs = append(bs, word(ht, junk, 1, 3)...)
+			}
+			doc = string(bs)
+		}
+		if g, w := Valid(doc), json.Valid([]byte(doc)); g != w {
+			ht.Fatalf("Valid(%s) = %v, encoding/json says %v", show(doc), g, w)
+		}
+	})
+}
