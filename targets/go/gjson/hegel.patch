+// TestHegelGetFollowsThePathModel: every generated path selects the value the tree says.
+func TestHegelGetFollowsThePathModel(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		root := genNode(ht, 0, false)
+		doc := genDoc(ht, root)
+		path, want, class := genPath(ht, root)
+		got := Get(doc, path)
+		if msg := checkResult(got, want); msg != "" {
+			col.count("mismatch:" + class)
+			col.fail(ht, "%s\n doc  %s\n path %s\n class %s", msg, show(doc), show(path), class)
+			return
+		}
+		col.count("ok:" + class)
+		// GetBytes, GetMany and Result.Get on the root agree with Get
+		gb := GetBytes([]byte(doc), path)
+		if gb.Raw != got.Raw || gb.Type != got.Type || gb.Str != got.Str || gb.Index != got.Index {
+			ht.Fatalf("GetBytes differs from Get\n doc %s\n path %s\n %+v\n %+v", show(doc), show(path), gb, got)
+		}
+		many := GetMany(doc, path, "@this")
+		if many[0].Raw != got.Raw || many[0].Type != got.Type {
+			ht.Fatalf("GetMany differs from Get\n doc %s\n path %s", show(doc), show(path))
+		}
+	})
+}
