+// TestHegelNumberAccessorsMatchTheirModels: Int, Uint, Float, Bool, String on numbers and on
+// numeric strings, against strconv/math/big.
+func TestHegelNumberAccessorsMatchTheirModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var raw string
+		switch n(ht, 0, 4) {
+		case 0:
+			raw = genNumber(ht)
+		case 1:
+			raw = pick(ht, []string{"", "-"}) + pick(ht, []string{"1", "9", "18", "92", "184", "2", "3", "36", "20"}) + digits(ht, 15, 22)
+		case 2:
+			raw = pick(ht, []string{"", "-"}) + digits(ht, 1, 30)
+		case 3:
+			raw = pick(ht, []string{"9007199254740991", "9007199254740992", "9007199254740993", "-9007199254740993", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551615", "18446744073709551616", "1e19", "1.5", "-0", "0.999", "1e400", "-1e400", "2e-400"})
+		default:
+			raw = word(ht, "0123456789.-+eExabc ", 0, 8)
+		}
+		if Known.uintOverflowMissed && overflowMissed(raw) {
+			return
+		}
+		f, ferr := strconv.ParseFloat(raw, 64)
+		// as a JSON number (only when it is one), and as a JSON string
+		if _, ok := integerText(raw); ok && !strings.HasPrefix(raw, "-0") || json.Valid([]byte(raw)) && strings.TrimSpace(raw) == raw {
+			r := Get(`{"v":`+raw+`}`, "v")
+			if r.Type != Number {
+				ht.Fatalf("Get %s gives type %s", raw, r.Type)
+			}
+			if r.Raw != raw {
+				ht.Fatalf("Raw %q for %q", r.Raw, raw)
+			}
+			if r.Num != f && !(math.IsNaN(r.Num) && math.IsNaN(f)) && ferr == nil {
+				ht.Fatalf("Num %v for %q, ParseFloat says %v", r.Num, raw, f)
+			}
+			if g, w := r.Int(), intModel(r); g != w {
+				ht.Fatalf("Int() of number %s = %d, want %d", raw, g, w)
+			}
+			if g, w := r.Uint(), uintModel(r); g != w {
+				ht.Fatalf("Uint() of number %s = %d, want %d", raw, g, w)
+			}
+			if r.Float() != r.Num && !math.IsNaN(r.Num) {
+				ht.Fatalf("Float() of number %s = %v, Num %v", raw, r.Float(), r.Num)
+			}
+			if r.Bool() != (r.Num != 0) {
+				ht.Fatalf("Bool() of number %s = %v", raw, r.Bool())
+			}
+			wantStr := strconv.FormatFloat(r.Num, 'f', -1, 64)
+			if _, ok := integerText(raw); ok {
+				wantStr = raw
+			}
+			if r.String() != wantStr {
+				ht.Fatalf("String() of number %s = %q, want %q", raw, r.String(), wantStr)
+			}
+		}
+		s := Get(`{"v":"`+raw+`"}`, "v")
+		if s.Type != String || s.Str != raw {
+			ht.Fatalf("string %q comes back as %s %q", raw, s.Type, s.Str)
+		}
+		if g, w := s.Int(), intModel(s); g != w {
+			ht.Fatalf("Int() of string %q = %d, want %d", raw, g, w)
+		}
+		if g, w := s.Uint(), uintModel(s); g != w {
+			ht.Fatalf("Uint() of string %q = %d, want %d", raw, g, w)
+		}
+		wf := f
+		if ferr != nil {
+			wf = 0
+			if math.IsInf(f, 0) {
+				wf = f // ParseFloat returns ±Inf with a range error
+			}
+		}
+		if s.Float() != wf && !(math.IsNaN(s.Float()) && math.IsNaN(wf)) {
+			ht.Fatalf("Float() of string %q = %v, want %v", raw, s.Float(), wf)
+		}
+		pb, perr := strconv.ParseBool(strings.ToLower(raw))
+		if s.Bool() != (perr == nil && pb) {
+			ht.Fatalf("Bool() of string %q = %v", raw, s.Bool())
+		}
+	})
+}
