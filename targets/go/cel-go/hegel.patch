+			}
+		}
+		if !skipRewrites {
+			// constant folding, then the folded AST evaluated and unparsed
+			folder, err := cel.NewConstantFoldingOptimizer()
+			if err != nil {
+				ht.Fatalf("NewConstantFoldingOptimizer: %v", err)
+			}
+			opt, err := cel.NewStaticOptimizer(folder)
+			if err != nil {
+				ht.Fatalf("NewStaticOptimizer: %v", err)
+			}
+			folded, iss := opt.Optimize(env, checked)
+			if iss.Err() != nil {
+				if HZKnown.foldIDCollision && strings.Contains(iss.Err().Error(), "already exists for expression") {
+					hzAvoid("foldIDCollision")
+				} else {
+					c.failClass(ht, "fold", "constant folding: %v%s", iss.Err(), where())
+				}
