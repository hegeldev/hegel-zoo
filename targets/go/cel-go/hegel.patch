+// --------------------------------------------------------------------------- cel-go/2
+
+// hzSigned is the value made negative (the shape of cel-go/2) or, under HEGEL_NO_KNOWN=1,
+// positive.
+func hzSigned(v hzVal) hzVal {
+	v = hzNonNegative(v)
+	switch v.k {
+	case hzKInt:
+		if v.i == 0 {
+			v.i = 1
+		}
+		return hzInt(shaped(-v.i, v.i))
+	case hzKDouble:
+		if v.d == 0 {
+			v.d = 1.5
+		}
+		return hzDouble(shaped(-v.d, v.d))
+	}
+	return v
+}
+
+// hzNegativeLiteralCases: a negative int or double literal in a context: bare, an operand of
+// an arithmetic operator beside a variable of its type, a list element, a conversion argument,
+// a conditional branch.
+var hzNegativeLiteralCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	t := hegel.Draw(tc, hegel.SampledFrom([]hzType{hzTInt, hzTDouble}))
+	lit := hzLit(hzSigned(hegel.Draw(tc, hzValsOf(t))))
+	other := hegel.Draw(tc, hzVarsOf(t))
+	op := hegel.Draw(tc, hegel.SampledFrom([]string{"+", "-", "*", "/"}))
+	var expr *hzNode
+	switch hegel.Draw(tc, hegel.Integers(0, 5)) {
+	case 0:
+		expr = lit
+	case 1:
+		expr = hzBinNode(op, lit, other)
+	case 2:
+		expr = hzBinNode(op, other, lit)
+	case 3:
+		expr = hzListNode(hzListOf(t), []*hzNode{lit})
+	case 4:
+		expr = hzConvNode(hzTString, lit)
+	default:
+		expr = hzCondNode(hzVarNode("b1"), lit, other)
+	}
+	return hzShapeCase(tc, expr)
+})
+
+// TestHegelParsersAgreeOnNegativeLiteralOffsets: both parsers record the same offset range
+// for a negative numeric literal (-1, -1.5), as they do for every other node; the Pratt parser
+// records the minus sign alone (cel-go/2).
+func TestHegelParsersAgreeOnNegativeLiteralOffsets(t *testing.T) {
+	antlr, pratt := hzParser(t, false), hzParser(t, true)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, hzNegativeLiteralCases)
+		hzJudgeParsers(ht, c, antlr, pratt, cs.src(), "generated")
+	})
+}
