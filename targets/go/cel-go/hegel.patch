+			c.failClass(ht, "unparse ast", "unparsed %q parses to a different tree:\n  %s\n  %s%s", us, hzDump(parsed.NativeRep().Expr()), hzDump(a2.NativeRep().Expr()), where())
+		}
+		if p, err := env.Program(a2); err == nil {
+			if g2, e2 := hzEval(p, act); !hzSame(got, g2) {
+				c.failClass(ht, "unparse eval", "unparsed %q gave %s (%s), the original %s (%s)%s", us, g2.String(), e2, got.String(), gotErr, where())
+			}
+		}
+	})
+}
+
+// hzTypeMatches reports whether a checked type equals the generated one up to dyn: every
+// `dyn` in got stands for any type.
+func hzTypeMatches(got, want string) bool {
+	if !strings.Contains(got, "dyn") {
+		return got == want
+	}
+	pat := "^" + strings.ReplaceAll(regexp.QuoteMeta(got), "dyn", `[a-z]+(\([a-z, ()]*\))?`) + "$"
+	ok, err := regexp.MatchString(pat, want)
+	return err == nil && ok
+}
+
+// --------------------------------------------------------------------------- AST dumps
+
+// hzDump renders a parsed tree without ids, for comparisons between parsers.
+func hzDump(e celast.Expr) string {
+	var sb strings.Builder
+	hzDumpTo(&sb, e, false)
+	return sb.String()
+}
+
+// hzDumpNorm is hzDump up to the unparser's liberties: a negated numeric literal is the
+// negative literal, and chains of && and || are flat.
+func hzDumpNorm(e celast.Expr) string {
+	var sb strings.Builder
+	hzDumpTo(&sb, e, true)
+	return sb.String()
+}
+
+func hzFlatten(fn string, e celast.Expr, out []celast.Expr) []celast.Expr {
+	if e != nil && e.Kind() == celast.CallKind && e.AsCall().FunctionName() == fn && !e.AsCall().IsMemberFunction() {
+		for _, a := range e.AsCall().Args() {
+			out = hzFlatten(fn, a, out)
+		}
+		return out
+	}
+	return append(out, e)
+}
+
+var (
+	hzNormInt    = regexp.MustCompile(`^int\((-?[0-9]+)\)$`)
+	hzNormDouble = regexp.MustCompile(`^double\(([0-9]+)\)$`)
+)
+
+func hzDumpTo(sb *strings.Builder, e celast.Expr, norm bool) {
+	if e == nil {
+		sb.WriteString("<nil>")
+		return
+	}
+	switch e.Kind() {
+	case celast.LiteralKind:
+		v := e.AsLiteral()
+		switch x := v.(type) {
+		case types.Bytes:
+			fmt.Fprintf(sb, "bytes(%x)", []byte(x))
+		case types.Double:
+			fmt.Fprintf(sb, "double(%v)", math.Float64bits(float64(x)))
+		default:
+			fmt.Fprintf(sb, "%s(%#v)", v.Type().TypeName(), v.Value())
+		}
+	case celast.IdentKind:
+		fmt.Fprintf(sb, "ident(%s)", e.AsIdent())
+	case celast.SelectKind:
+		s := e.AsSelect()
+		sb.WriteString("select(")
+		hzDumpTo(sb, s.Operand(), norm)
+		fmt.Fprintf(sb, ", %q, test=%v)", s.FieldName(), s.IsTestOnly())
+	case celast.CallKind:
+		cl := e.AsCall()
+		fn := cl.FunctionName()
+		args := cl.Args()
+		if norm && fn == "-_" && len(args) == 1 {
+			// -(-(5)) unparses as -(-5), which parses as -(5): fold negated numeric literals
+			var inner strings.Builder
+			hzDumpTo(&inner, args[0], norm)
+			if m := hzNormInt.FindStringSubmatch(inner.String()); m != nil {
+				n, _ := strconv.ParseInt(m[1], 10, 64)
+				fmt.Fprintf(sb, "int(%#v)", -n)
+				return
+			}
+			if m := hzNormDouble.FindStringSubmatch(inner.String()); m != nil {
+				bits, _ := strconv.ParseUint(m[1], 10, 64)
+				fmt.Fprintf(sb, "double(%v)", bits^(1<<63))
+				return
+			}
+		}
+		if norm && (fn == "_&&_" || fn == "_||_") && !cl.IsMemberFunction() {
+			args = hzFlatten(fn, e, nil)
+		}
+		fmt.Fprintf(sb, "call(%s", fn)
+		if cl.IsMemberFunction() {
+			sb.WriteString(", target=")
+			hzDumpTo(sb, cl.Target(), norm)
+		}
+		for _, a := range args {
+			sb.WriteString(", ")
+			hzDumpTo(sb, a, norm)
+		}
+		sb.WriteString(")")
+	case celast.ListKind:
+		l := e.AsList()
+		sb.WriteString("list[")
+		for i, el := range l.Elements() {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			if l.IsOptional(int32(i)) {
+				sb.WriteString("?")
+			}
+			hzDumpTo(sb, el, norm)
+		}
+		sb.WriteString("]")
+	case celast.MapKind:
+		m := e.AsMap()
+		sb.WriteString("map{")
+		for i, en := range m.Entries() {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			me := en.AsMapEntry()
+			if me.IsOptional() {
+				sb.WriteString("?")
+			}
+			hzDumpTo(sb, me.Key(), norm)
+			sb.WriteString(": ")
+			hzDumpTo(sb, me.Value(), norm)
+		}
+		sb.WriteString("}")
+	case celast.StructKind:
+		s := e.AsStruct()
+		fmt.Fprintf(sb, "struct %s{", s.TypeName())
+		for i, f := range s.Fields() {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			sf := f.AsStructField()
+			if sf.IsOptional() {
+				sb.WriteString("?")
+			}
+			sb.WriteString(sf.Name())
+			sb.WriteString(": ")
+			hzDumpTo(sb, sf.Value(), norm)
+		}
+		sb.WriteString("}")
+	case celast.ComprehensionKind:
+		cp := e.AsComprehension()
+		fmt.Fprintf(sb, "compr(%s", cp.IterVar())
+		if cp.HasIterVar2() {
+			fmt.Fprintf(sb, ", %s", cp.IterVar2())
+		}
+		sb.WriteString(" in ")
+		hzDumpTo(sb, cp.IterRange(), norm)
+		fmt.Fprintf(sb, "; %s = ", cp.AccuVar())
+		hzDumpTo(sb, cp.AccuInit(), norm)
+		sb.WriteString("; cond ")
+		hzDumpTo(sb, cp.LoopCondition(), norm)
+		sb.WriteString("; step ")
+		hzDumpTo(sb, cp.LoopStep(), norm)
+		sb.WriteString("; result ")
+		hzDumpTo(sb, cp.Result(), norm)
+		sb.WriteString(")")
+	default:
+		fmt.Fprintf(sb, "kind%d", e.Kind())
+	}
+}
+
+// hzDumpInfo renders the macro calls and the offsets of a parse, in tree order.
+func hzDumpInfo(a *celast.AST) (macros string, offsets string) {
+	var ms []string
+	for _, m := range a.SourceInfo().MacroCalls() {
+		ms = append(ms, hzDump(m))
+	}
+	sort.Strings(ms)
+	var offs []string
+	var walk func(e celast.Expr)
+	walk = func(e celast.Expr) {
+		if e == nil {
+			return
+		}
+		r, ok := a.SourceInfo().GetOffsetRange(e.ID())
+		if ok {
+			offs = append(offs, fmt.Sprintf("%d:%d-%d", e.Kind(), r.Start, r.Stop))
+		} else {
+			offs = append(offs, fmt.Sprintf("%d:-", e.Kind()))
+		}
+		switch e.Kind() {
+		case celast.SelectKind:
+			walk(e.AsSelect().Operand())
+		case celast.CallKind:
+			cl := e.AsCall()
+			if cl.IsMemberFunction() {
+				walk(cl.Target())
+			}
+			for _, x := range cl.Args() {
+				walk(x)
+			}
+		case celast.ListKind:
+			for _, x := range e.AsList().Elements() {
+				walk(x)
+			}
+		case celast.MapKind:
+			for _, en := range e.AsMap().Entries() {
+				walk(en.AsMapEntry().Key())
+				walk(en.AsMapEntry().Value())
+			}
+		case celast.StructKind:
+			for _, f := range e.AsStruct().Fields() {
+				walk(f.AsStructField().Value())
+			}
+		case celast.ComprehensionKind:
+			cp := e.AsComprehension()
+			walk(cp.IterRange())
+			walk(cp.AccuInit())
+			walk(cp.LoopCondition())
+			walk(cp.LoopStep())
+			walk(cp.Result())
+		}
+	}
+	walk(a.Expr())
+	return strings.Join(ms, "\n"), strings.Join(offs, " ")
+}
+
+// --------------------------------------------------------------------------- parsers
+
+func hzParser(t testing.TB, pratt bool) *parser.Parser {
+	p, err := parser.NewParser(parser.Macros(parser.AllMacros...), parser.PopulateMacroCalls(true),
+		parser.EnableOptionalSyntax(true), parser.EnablePrattParser(pratt))
+	if err != nil {
+		t.Fatalf("parser.NewParser: %v", err)
+	}
+	return p
+}
+
+// hzMutate damages a source text: a character or token removed, doubled or replaced.
+func hzMutate(tc hegel.TestCase, s string) string {
+	rs := []rune(s)
+	if len(rs) == 0 {
+		return hzPick(tc, []string{"", "(", ")", "a", "1", "-", "!", "?", ":", "."})
+	}
+	i := hzDrawInt(tc, 0, len(rs)-1)
+	switch hzDrawInt(tc, 0, 5) {
+	case 0:
+		return string(rs[:i]) + string(rs[i+1:])
+	case 1:
+		return string(rs[:i]) + string(rs[i]) + string(rs[i:])
+	case 2:
+		return string(rs[:i]) + hzPick(tc, []string{"(", ")", "[", "]", "{", "}", ".", ",", "?", ":", "-", "!", "+", "*", "/", "%", "<", ">", "=", "&", "|", "in", " in ", "'", "\"", "\\", "u", "e", "x", "0", "9", " ", "\n", "//", "b'", "r\"", "@", "#", "`", "\u00a0"}) + string(rs[i:])
+	case 3:
+		j := hzDrawInt(tc, i, len(rs))
+		return string(rs[:i]) + string(rs[j:])
+	case 4:
+		j := hzDrawInt(tc, i, len(rs))
+		return string(rs[:i]) + string(rs[i:j]) + string(rs[i:j]) + string(rs[j:])
+	default:
+		return string(rs[:i]) + string(hzPick(tc, hzRunes)) + string(rs[i+1:])
+	}
+}
+
+// TestHegelParsers: the Pratt parser is a drop-in for the ANTLR parser. On a generated
+// expression, on a damaged copy of it and on a random token string, both accept or both
+// reject, and when both accept the trees, macro calls and offsets are the same.
+func TestHegelParsers(t *testing.T) {
+	antlr := hzParser(t, false)
+	pratt := hzParser(t, true)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		cs := hzGenCase(tc, nil, hzDrawInt(tc, 1, 4))
+		src := cs.expr.src
+		kind := "generated"
+		switch hzDrawInt(tc, 0, 9) {
+		case 0, 1, 2:
+			kind = "mutated"
+			n := hzDrawInt(tc, 1, 3)
+			for i := 0; i < n; i++ {
+				src = hzMutate(tc, src)
+			}
+		case 3:
+			kind = "soup"
+			n := hzDrawInt(tc, 0, 12)
+			var sb strings.Builder
+			for i := 0; i < n; i++ {
+				sb.WriteString(hzPick(tc, hzTokens))
+				if hzChance(tc, 40) {
+					sb.WriteString(" ")
+				}
+			}
+			src = sb.String()
+		}
+		c.count(kind)
+		a1, e1 := antlr.Parse(common.NewTextSource(src))
+		a2, e2 := pratt.Parse(common.NewTextSource(src))
+		ok1 := e1 == nil || len(e1.GetErrors()) == 0
+		ok2 := e2 == nil || len(e2.GetErrors()) == 0
+		if ok1 != ok2 {
+			var msg string
+			if !ok1 {
+				msg = "ANTLR rejects: " + e1.ToDisplayString()
+			} else {
+				msg = "Pratt rejects: " + e2.ToDisplayString()
+				if HZKnown.prattLiteralIn && strings.Contains(e2.GetErrors()[0].Message, "literal has unexpected trailing characters") {
+					hzAvoid("prattLiteralIn")
+					return
+				}
+			}
+			c.failClass(ht, "accept", "the parsers disagree on %q (%s): %s", src, kind, msg)
+			return
+		}
+		if !ok1 {
+			if kind == "generated" {
+				c.failClass(ht, "generated rejected", "the generated expression %q is rejected: %s", src, e1.ToDisplayString())
+				return
+			}
+			c.count("both reject")
+			// the first error's position and message
+			m1, m2 := e1.GetErrors()[0], e2.GetErrors()[0]
+			if m1.Location.Line() != m2.Location.Line() || m1.Location.Column() != m2.Location.Column() {
+				c.count("reject position differs")
+			} else if m1.Message != m2.Message {
+				c.count("reject message differs")
+			} else {
+				c.count("reject same")
+			}
+			if len(e1.GetErrors()) != len(e2.GetErrors()) {
+				c.count("reject count differs")
+			}
+			return
+		}
+		if kind == "generated" {
+			c.count("generated accepted")
+		} else {
+			c.count("both accept")
+		}
+		d1, d2 := hzDump(a1.Expr()), hzDump(a2.Expr())
+		if d1 != d2 {
+			c.failClass(ht, "tree", "the parsers give different trees for %q (%s):\n  ANTLR: %s\n  Pratt: %s", src, kind, d1, d2)
+			return
+		}
+		m1, o1 := hzDumpInfo(a1)
+		m2, o2 := hzDumpInfo(a2)
+		if m1 != m2 {
+			c.failClass(ht, "macros", "the parsers give different macro calls for %q:\n  ANTLR: %s\n  Pratt: %s", src, m1, m2)
+		}
+		if o1 != o2 {
+			if HZKnown.prattNegativeLiteralOffset && hzOffsetsDifferOnlyIn(o1, o2, celast.LiteralKind, celast.StructKind, celast.IdentKind) {
+				hzAvoid("prattNegativeLiteralOffset")
+			} else {
+				c.failClass(ht, "offsets", "the parsers give different offsets for %q:\n  ANTLR: %s\n  Pratt: %s", src, o1, o2)
+			}
+		}
+	})
+}
+
+// hzOffsetsDifferOnlyIn reports whether two offset dumps of the same tree differ only at
+// nodes of the given kinds.
+func hzOffsetsDifferOnlyIn(o1, o2 string, kinds ...celast.ExprKind) bool {
+	a, b := strings.Fields(o1), strings.Fields(o2)
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] == b[i] {
+			continue
+		}
+		k1, _, _ := strings.Cut(a[i], ":")
+		k2, _, _ := strings.Cut(b[i], ":")
+		if k1 != k2 {
+			return false
+		}
+		ok := false
+		for _, k := range kinds {
+			if k1 == fmt.Sprint(int(k)) {
+				ok = true
+			}
+		}
+		if !ok {
+			return false
+		}
+	}
+	return true
+}
+
+var hzTokens = []string{"(", ")", "[", "]", "{", "}", ".", ",", "?", ":", "-", "!", "+", "*", "/", "%", "<", "<=", ">", ">=", "==", "!=", "&&", "||", "in", "a", "b", "x", "i1", "s1", "li", "ms", "true", "false", "null", "0", "1", "42", "0x1F", "1u", "0.5", "1e3", ".5", "1.", "'a'", "\"b\"", "b'c'", "r'd'", "'''e'''", "\"\"\"f\"\"\"", "size", "has", "all", "exists", "map", "filter", "int", "string", "type", "`quoted`", "?.", "//c\n", "\\", "@", "$", "-1", "-0x1", "'\\u0041'", "'\\x41'", "'\\101'", "'\\U0001F600'", "b'\\xff'", "'\\q'", "'''\n'''", "\"unterminated", "'un", "1e", "0x", "1.5.5", "1__0", "00", "07", "0u0", "1uu", "1U", "true1", "in1", "_a", "a_", "a.b", "a?.b", "a[?0]", "[?1]", "{?'a': 1}", "Msg{a: 1}", ".a", "a.b.c", "1 ? 2 : 3", "!!a", "--1", "- -1", "-(-1)", "a in b", "a in b in c", "a < b < c", "a == b == c", "(1)", "((1))", "[1,]", "{1:2,}", "[,]", "{,}", "()", "a()", "a.b()", "a.b(1,)", "size()", "size(1,2)", "1 .a", "1.a", "1.0.a", "a . b", "a .b ()", "x ?: y", "x ? y", "x : y", "in", " in", "in ", "a in", "in a", "a.in", "a.in(1)", "in(1)", "in.a", "has(a)", "has(a.b)", "has(a.b.c)", "has()", "has(1)", "a.all(x, x > 0)", "a.all(x, y, x > y)", "a.exists_one(x, x)", "a.map(x, x)", "a.map(x, x > 0, x)", "a.filter(x, x)", "a.map(x, y, x)", "a.all(1, x)", "a.all(x.y, x)", "a.map(x, x, x, x)", "\u00a0", "\ufeff", "\u2028", "\t", "\n", "\r"}
