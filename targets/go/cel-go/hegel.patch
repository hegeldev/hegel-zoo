+// --------------------------------------------------------------------------- cel-go/3
+
+// hzIndexedLiterals: an element of an empty list or map literal ([][0], {}['a']; of a
+// one-entry literal under HEGEL_NO_KNOWN=1).
+func hzIndexedLiterals(at hzType) hegel.Generator[*hzNode] {
+	var lit hegel.Generator[*hzNode]
+	if at.k == hzKList {
+		lit = hzListLits(at, hzLitsOf(*at.elem), shaped(0, 1))
+	} else {
+		lit = hzMapLits(at, hzLitsOf(*at.key), hzLitsOf(*at.val), shaped(0, 1))
+	}
+	lit = hegel.Filter(lit, func(n *hzNode) bool { return len(n.args) == shaped(0, len(n.args)) })
+	keys := hzKeysOf(at)
+	return hegel.Composite(func(tc hegel.TestCase) *hzNode {
+		return hzIndexNode(hegel.Draw(tc, lit), hegel.Draw(tc, keys))
+	})
+}
+
+// hzEmptyLiteralOperandCases: such an element bound by a unary minus (ints) or by an addition
+// of two of them, then combined with a literal of the element's type by an arithmetic operator
+// (the shape of cel-go/3: the checker types the first step double or bytes and the second
+// fails to check).
+var hzEmptyLiteralOperandCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	at := hegel.Draw(tc, hegel.SampledFrom([]hzType{hzTLInt, hzTMSI, hzTLStr, hzTMIS}))
+	et := hzIndexedOf(at)
+	first := hegel.Draw(tc, hzIndexedLiterals(at))
+	inner := hzBinNode("+", first, hegel.Draw(tc, hzIndexedLiterals(at)))
+	if et.k == hzKInt && hegel.Draw(tc, chance(50)) {
+		inner = hzNegNode(first)
+	}
+	op := "+"
+	if et.k == hzKInt {
+		op = hegel.Draw(tc, hegel.SampledFrom([]string{"+", "-", "*"}))
+	}
+	lit := hegel.Draw(tc, hzLitsOf(et))
+	expr := hzBinNode(op, inner, lit)
+	if hegel.Draw(tc, chance(50)) {
+		expr = hzBinNode(op, lit, inner)
+	}
+	return hzShapeCase(tc, expr)
+})
+
+// TestHegelCheckerLeavesEmptyLiteralElementsDyn: an element of an empty literal has no known
+// type, so an operator applied to it is typed dyn (as for -dyn(1)) and -([][0]) + 1 checks;
+// the checker binds the element's type variable to the first overload tried, types -({}['a'])
+// double and {}['a'] + {}['b'] bytes, and rejects the addition of an int (cel-go/3).
+func TestHegelCheckerLeavesEmptyLiteralElementsDyn(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzJudge(ht, c, env, hegel.Draw(ht, hzEmptyLiteralOperandCases), true)
+	})
+}
