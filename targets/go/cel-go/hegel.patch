+// hzInRewriteCases: an erroring needle in an empty constant haystack (`e in []`), or a
+// literal needle repeated in a constant haystack beside an erroring element (`x in [x, e]`),
+// the shapes of cel-go/4; under HEGEL_NO_KNOWN=1 the haystack is a variable (li, ls), which
+// nothing rewrites.
+var hzInRewriteCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	t := hegel.Draw(tc, hegel.SampledFrom([]hzType{hzTInt, hzTString}))
+	e := hegel.Draw(tc, hzErroringOf(t))
+	x := hegel.Draw(tc, hzLitsOf(t))
+	hay := hzVarNode("li")
+	if t.k == hzKString {
+		hay = hzVarNode("ls")
+	}
+	var expr *hzNode
+	switch shaped(hegel.Draw(tc, hegel.Integers(0, 1)), 2) {
+	case 0:
+		expr = hzBinNode("in", e, hzListNode(hzListOf(t), nil))
+	case 1:
+		elems := []*hzNode{x, e}
+		if hegel.Draw(tc, chance(30)) {
+			elems = append(elems, hegel.Draw(tc, hzLitsOf(t)))
+		}
+		if hegel.Draw(tc, chance(50)) {
+			elems[0], elems[1] = elems[1], elems[0]
+		}
+		expr = hzBinNode("in", x, hzListNode(hzListOf(t), elems))
+	default:
+		expr = hzBinNode("in", e, hay)
+	}
+	return hzShapeCase(tc, expr)
+})
+
+// TestHegelInRewritesKeepOperandErrors: `in` is a strict function, so an erroring needle or
+// haystack element makes the expression an error under OptOptimize and after constant folding
+// as it does in plain evaluation; the set-membership rewrites give false for an empty
+// haystack and true for a needle equal to another element (cel-go/4).
+func TestHegelInRewritesKeepOperandErrors(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzJudge(ht, c, env, hegel.Draw(ht, hzInRewriteCases), true)
+	})
+}
