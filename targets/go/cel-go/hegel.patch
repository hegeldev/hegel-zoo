+// --------------------------------------------------------------------------- cel-go/4
+
+// hzErroringOf: an expression of the type whose value is an error: a division or modulus by
+// zero, an index past a one-element list, a conversion that fails, the negation of the
+// smallest int, a string from invalid bytes.
+func hzErroringOf(t hzType) hegel.Generator[*hzNode] {
+	if t.k == hzKString {
+		return hegel.OneOf(
+			hegel.Just(hzConvNode(hzTString, hzLit(hzBytes([]byte{0xff})))),
+			hegel.Map(hzLitsOf(hzTString), func(x *hzNode) *hzNode { return hzIndexNode(hzListNode(hzTLStr, []*hzNode{x}), hzLit(hzInt(5))) }),
+		)
+	}
+	return hegel.OneOf(
+		hegel.Map(hzLitsOf(hzTInt), func(x *hzNode) *hzNode { return hzBinNode("/", x, hzLit(hzInt(0))) }),
+		hegel.Map(hzLitsOf(hzTInt), func(x *hzNode) *hzNode { return hzBinNode("%", x, hzLit(hzInt(0))) }),
+		hegel.Map(hzLitsOf(hzTInt), func(x *hzNode) *hzNode { return hzIndexNode(hzListNode(hzTLInt, []*hzNode{x}), hzLit(hzInt(5))) }),
+		hegel.Map(hegel.SampledFrom([]string{"x", "", "1.5", "abc"}), func(s string) *hzNode { return hzConvNode(hzTInt, hzLit(hzStr(s))) }),
+		hegel.Just(hzNegNode(hzLit(hzInt(math.MinInt64)))),
+	)
+}
