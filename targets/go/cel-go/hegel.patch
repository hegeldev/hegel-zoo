+// TestHegelOptimizeBuildsProgramsWithErroringConstantUnaries: a constant conversion that errors
+// in a branch the expression never takes does not stop env.Program under OptOptimize (the
+// option promises program-creation errors for regex patterns only) and the program evaluates
+// as the plain one; the planner returns the conversion's error (cel-go/6).
+func TestHegelOptimizeBuildsProgramsWithErroringConstantUnaries(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
