+// hzConstUnaryCases: such a conversion in a branch the expression never takes: the untaken arm
+// of a conditional with a literal condition, or the absorbed side of || with true or && with
+// false (compared to a literal of its type first).
+var hzConstUnaryCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	e := hegel.Draw(tc, hzConstUnaries)
+	other := hegel.Draw(tc, hzLitsOf(e.t))
+	if e.t.k == hzKDouble {
+		other = hzFiniteNonZero(other.v) // (a non-finite one would meet cel-go/8 instead)
+	}
+	var expr *hzNode
+	switch hegel.Draw(tc, hegel.Integers(0, 1)) {
+	case 0:
+		expr = hzCondNode(hzLit(hzBool(true)), other, e)
+		if hegel.Draw(tc, chance(50)) {
+			expr = hzCondNode(hzLit(hzBool(false)), e, other)
+		}
+	default:
+		cmp := hzBinNode("==", e, other)
+		op, lit := "||", hzLit(hzBool(true))
+		if hegel.Draw(tc, chance(50)) {
+			op, lit = "&&", hzLit(hzBool(false))
+		}
+		expr = hzBinNode(op, cmp, lit)
+		if hegel.Draw(tc, chance(50)) {
+			expr = hzBinNode(op, lit, cmp)
+		}
+	}
+	return hzShapeCase(tc, expr)
+})
