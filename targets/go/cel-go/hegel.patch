+// One narrow property per recorded bug (bugs.toml): each draws the bug's shape region with
+// random contents, judged by the oracle of the wide property that found it (hzJudge,
+// hzJudgeParsers), so it fails there naming the bug and is an expected failure mapped to it;
+// under HEGEL_NO_KNOWN=1 it draws the neighbouring region (shaped) and passes. The pins in
+// hegel_zoo_pins_test.go hold the single regression examples.
+
+import (
+	"math"
+	"sort"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzLitsOf: literal nodes of the type.
+func hzLitsOf(t hzType) hegel.Generator[*hzNode] { return hegel.Map(hzValsOf(t), hzLit) }
+
+// hzLeavesOf: a literal or a variable of the type.
+func hzLeavesOf(t hzType) hegel.Generator[*hzNode] {
+	return weighted(choice[*hzNode]{60, hzLitsOf(t)}, choice[*hzNode]{40, hzVarsOf(t)})
+}
+
+// hzDistinctKeyMaps: a map literal of lo to hi entries whose literal keys are distinct by
+// construction (drawn as a Go map) and in sorted order, with the values drawn from vals.
+func hzDistinctKeyMaps(mt hzType, vals hegel.Generator[*hzNode], lo, hi int) hegel.Generator[*hzNode] {
+	if mt.key.k == hzKInt {
+		return hegel.Map(hegel.Maps(hegel.Map(hzIntVals, func(v hzVal) int64 { return v.i }), vals).MinSize(lo).MaxSize(hi), func(m map[int64]*hzNode) *hzNode {
+			keys := make([]int64, 0, len(m))
+			for k := range m {
+				keys = append(keys, k)
+			}
+			sort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })
+			var es []pair[*hzNode, *hzNode]
+			for _, k := range keys {
+				es = append(es, pair[*hzNode, *hzNode]{hzLit(hzInt(k)), m[k]})
+			}
+			return hzMapNode(mt, es)
+		})
+	}
+	return hegel.Map(hegel.Maps(hegel.Map(hzStringVals, func(v hzVal) string { return v.s }), vals).MinSize(lo).MaxSize(hi), func(m map[string]*hzNode) *hzNode {
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var es []pair[*hzNode, *hzNode]
+		for _, k := range keys {
+			es = append(es, pair[*hzNode, *hzNode]{hzLit(hzStr(k)), m[k]})
+		}
+		return hzMapNode(mt, es)
+	})
+}
+
+// hzShapeCase: bindings, the drawn tree and a tape.
+func hzShapeCase(tc hegel.TestCase, expr *hzNode) hzCase {
+	return hzShapeless(hzCase{env: hegel.Draw(tc, hzBindings), expr: expr, tape: hegel.Draw(tc, hzTapes), in: hzInDefault})
+}
+
+// --------------------------------------------------------------------------- cel-go/1
+
+// hzGluedInCases: a non-negative int, uint or double literal directly followed by `in` (the
+// shape of cel-go/1; a space before `in` under HEGEL_NO_KNOWN=1) and a haystack of its type: a
+// list literal of up to three non-negative literals, or li for an int.
+var hzGluedInCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	t := hegel.Draw(tc, hegel.SampledFrom([]hzType{hzTInt, hzTUint, hzTDouble}))
+	unsigned := hegel.Map(hzValsOf(t), func(v hzVal) *hzNode { return hzLit(hzNonNegative(v)) })
+	needle := hegel.Draw(tc, unsigned)
+	hay := hzListLits(hzListOf(t), unsigned, 0)
+	if t.k == hzKInt {
+		hay = hegel.OneOf(hay, hegel.Just(hzVarNode("li")))
+	}
+	c := hzShapeCase(tc, hzBinNode("in", needle, hegel.Draw(tc, hay)))
+	c.in = shaped(hzInGlued, hzInSpaced)
+	return c
+})
+
+// TestHegelPrattLexesLiteralBeforeIn: a numeric literal directly followed by the keyword `in`
+// (1in[1], 0x1in li, 1uin[1u], 1.0in[1.0]) is two tokens to the grammar's lexer, so the Pratt
+// parser accepts it and builds the same tree; it rejects the literal as having trailing
+// characters (cel-go/1).
+func TestHegelPrattLexesLiteralBeforeIn(t *testing.T) {
+	antlr, pratt := hzParser(t, false), hzParser(t, true)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, hzGluedInCases)
+		c.count(cs.expr.args[0].t.String())
+		hzJudgeParsers(ht, c, antlr, pratt, cs.src(), "generated")
+	})
+}
