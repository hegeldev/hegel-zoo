+// --------------------------------------------------------------------------- cel-go/8
+
+// hzFiniteNonZero is a finite double away from zero.
+func hzFiniteNonZero(v hzVal) *hzNode {
+	if math.IsNaN(v.d) || math.IsInf(v.d, 0) || v.d == 0 {
+		return hzLit(hzDouble(1.5))
+	}
+	return hzLit(v)
+}
+
+// hzNonFiniteExprs: a constant double expression that evaluates to NaN or an infinity: 0.0/0.0,
+// a/0.0, its negation, a product past the largest double (the shape of cel-go/8); under
+// HEGEL_NO_KNOWN=1 a finite quotient or product.
+var hzNonFiniteExprs = shaped(hegel.OneOf(
+	hegel.Just(hzBinNode("/", hzLit(hzDouble(0)), hzLit(hzDouble(0)))),
+	hegel.Map(hzDoubleVals, func(v hzVal) *hzNode { return hzBinNode("/", hzFiniteNonZero(v), hzLit(hzDouble(0))) }),
+	hegel.Map(hzDoubleVals, func(v hzVal) *hzNode { return hzNegNode(hzBinNode("/", hzFiniteNonZero(v), hzLit(hzDouble(0)))) }),
+	hegel.Map(hegel.Integers(10, 1000), func(k int) *hzNode { return hzBinNode("*", hzLit(hzDouble(1e308)), hzLit(hzDouble(float64(k)))) }),
+), hegel.OneOf(
+	hegel.Map(hzDoubleVals, func(v hzVal) *hzNode { return hzBinNode("/", hzFiniteNonZero(v), hzLit(hzDouble(2))) }),
+	hegel.Map(hzDoubleVals, func(v hzVal) *hzNode { return hzBinNode("*", hzFiniteNonZero(v), hzLit(hzDouble(0.5))) }),
+))
+
+// hzNonFiniteFoldCases: such an expression bare, in a list, added to d1 or as a conditional
+// branch.
+var hzNonFiniteFoldCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	e := hegel.Draw(tc, hzNonFiniteExprs)
+	var expr *hzNode
+	switch hegel.Draw(tc, hegel.Integers(0, 3)) {
+	case 0:
+		expr = e
+	case 1:
+		expr = hzListNode(hzListOf(hzTDouble), []*hzNode{e})
+	case 2:
+		expr = hzBinNode("+", e, hzVarNode("d1"))
+	default:
+		expr = hzCondNode(hzVarNode("b1"), e, hzFiniteNonZero(hegel.Draw(tc, hzDoubleVals)))
+	}
+	return hzShapeCase(tc, expr)
+})
+
+// TestHegelFoldedNonFiniteDoublesUnparseToValidText: the text AstToString writes for a folded
+// AST compiles (CEL has no literal for NaN or the infinities, so an error from AstToString
+// would do); the unparser writes NaN.0, +Inf.0 and -Inf.0 (cel-go/8).
+func TestHegelFoldedNonFiniteDoublesUnparseToValidText(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzJudge(ht, c, env, hegel.Draw(ht, hzNonFiniteFoldCases), true)
+	})
+}
+
+// --------------------------------------------------------------------------- cel-go/9
+
+// hzLiteralPredicateCases: a constant range (a list literal of one to three literals, or a map
+// literal of one or two literal entries) under a macro whose literal predicate leaves the
+// accumulator unchanged - filter, the three-argument map and exists with false, all with true
+// (the shape of cel-go/9; a predicate that merely evaluates so, X != X or X == X, under
+// HEGEL_NO_KNOWN=1) - with a random transform, negated 40% of the time when it is a bool.
+var hzLiteralPredicateCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	rt := hegel.Draw(tc, hegel.SampledFrom([]hzType{hzTLInt, hzTLStr, hzTMSI, hzTMIS}))
+	var rng *hzNode
+	if rt.k == hzKList {
+		rng = hegel.Draw(tc, hzListLits(rt, hzLitsOf(*rt.elem), 1))
+	} else {
+		rng = hegel.Draw(tc, hzDistinctKeyMaps(rt, hzLitsOf(*rt.val), 1, 2))
+	}
+	kind := hzElemOf(rt).k
+	name := hegel.Draw(tc, hegel.SampledFrom([]string{"filter", "map3", "exists", "all"}))
+	pred := shaped("false", "ne self")
+	if name == "all" {
+		pred = shaped("true", "eq self")
+	}
+	m := hzMacro{
+		name: name,
+		x:    hegel.Draw(tc, hzIterVars),
+		pred: hzTemplateUse{hzTemplateID(hzPredsOf(kind), pred), hegel.Draw(tc, hzTParamsGen)},
+		tr:   hzTemplateUse{hegel.Draw(tc, hegel.Integers(0, len(hzTransOf(kind))-1)), hegel.Draw(tc, hzTParamsGen)},
+	}
+	expr := hzMacroNode(rng, m)
+	if expr.t.k == hzKBool && hegel.Draw(tc, chance(40)) {
+		expr = hzNotNode(expr, 1)
+	}
+	cs := hzShapeCase(tc, expr)
+	cs.unordered = rt.k == hzKMap
+	return cs
+})
+
+// TestHegelFoldingKeepsLiteralPredicateMacros: a macro over a constant range with a literal
+// predicate folds to the macro's value ([] for filter and map, false for exists, true for
+// all) as a predicate that merely evaluates so does; the pruner reduces the loop step to the
+// accumulator and folds a stray value in - the last map value, null for a list (cel-go/9).
+func TestHegelFoldingKeepsLiteralPredicateMacros(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, hzLiteralPredicateCases)
+		c.count(hzMacroChain(cs.expr))
+		hzJudge(ht, c, env, cs, false)
+	})
+}
+
+// --------------------------------------------------------------------------- cel-go/10
+
+var (
+	hzASCIIBits   = hegel.Text().Alphabet("ab xyz09").MaxSize(3)
+	hzWideChars   = hegel.SampledFrom([]string{"\u00e9", "\u00fc", "\u00a0", "\u20ac", "\u2028", "\U0001F600"})
+	hzQuotes      = hegel.SampledFrom([]string{"'", "\"", "'''", "\"\"\""})
+	hzTextPrefix  = hegel.SampledFrom([]string{"", "b", "r"})
+	hzTextContext = hegel.Integers(0, 4)
+)
+
+// hzNonASCIITextLiteralCases: a string or bytes literal, in any quote spelling, whose text
+// holds a non-ASCII character between ASCII runs (the shape of cel-go/10; ASCII text only
+// under HEGEL_NO_KNOWN=1), bare or in a context: size(), a concatenation with a string
+// variable, a list element, a comparison.
+var hzNonASCIITextLiteralCases = hegel.Composite(func(tc hegel.TestCase) string {
+	text := hegel.Draw(tc, hzASCIIBits) + shaped(hegel.Draw(tc, hzWideChars), "") + hegel.Draw(tc, hzASCIIBits)
+	quote := hegel.Draw(tc, hzQuotes)
+	lit := hegel.Draw(tc, hzTextPrefix) + quote + text + quote
+	switch hegel.Draw(tc, hzTextContext) {
+	case 0:
+		return lit
+	case 1:
+		return "size(" + lit + ")"
+	case 2:
+		return lit + " + s1"
+	case 3:
+		return "[" + lit + "]"
+	default:
+		return lit + " == s1"
+	}
+})
+
+// TestHegelParsersAgreeOnNonASCIITextLiteralOffsets: both parsers record the same offset
+// range for a string or bytes literal holding a non-ASCII character, as they do for ASCII
+// text; the ANTLR parser ends the range after the text's byte length while every offset
+// counts characters (cel-go/10).
+func TestHegelParsersAgreeOnNonASCIITextLiteralOffsets(t *testing.T) {
+	antlr, pratt := hzParser(t, false), hzParser(t, true)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzJudgeParsers(ht, c, antlr, pratt, hegel.Draw(ht, hzNonASCIITextLiteralCases), "generated")
+	})
+}
+
+// --------------------------------------------------------------------------- cel-go/11
+
+var (
+	hzAggregateOpens  = []string{"[", "{", "Msg{", "a.b.Msg{"}
+	hzAggregateCloses = []string{"]", "}", "}", "}"}
+	hzAggregateIdx    = hegel.Integers(0, len(hzAggregateOpens)-1)
+	hzSpaces          = hegel.SampledFrom([]string{"", " ", "\n", "\t"})
+	hzCommaContext    = hegel.Integers(0, 3)
+)
+
+// hzLoneCommaCases: an empty list, map or message literal holding a lone comma with random
+// spacing around it (the shape of cel-go/11; no comma under HEGEL_NO_KNOWN=1), bare or as an
+// operand: of size(), a list element, a comparison, a conditional branch.
+var hzLoneCommaCases = hegel.Composite(func(tc hegel.TestCase) string {
+	i := hegel.Draw(tc, hzAggregateIdx)
+	inner := hegel.Draw(tc, hzSpaces) + shaped(",", "") + hegel.Draw(tc, hzSpaces)
+	lit := hzAggregateOpens[i] + inner + hzAggregateCloses[i]
+	switch hegel.Draw(tc, hzCommaContext) {
+	case 0:
+		return lit
+	case 1:
+		return "size(" + lit + ")"
+	case 2:
+		return "[" + lit + "]"
+	default:
+		return "b1 ? " + lit + " : " + lit
+	}
+})
+
+// TestHegelParsersAgreeOnLoneCommas: both parsers accept an empty list, map or message
+// literal written with a lone comma, as the grammar does; the Pratt parser rejects it
+// (cel-go/11).
+func TestHegelParsersAgreeOnLoneCommas(t *testing.T) {
+	antlr, pratt := hzParser(t, false), hzParser(t, true)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzJudgeParsers(ht, c, antlr, pratt, hegel.Draw(ht, hzLoneCommaCases), "generated")
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..a70b7d9
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,299 @@
+package hegel
+
+// Hegel property tests for cel-go, written for the Hegel zoo. See targets/go/cel-go/README.md.
+// They live in a package of their own (hegel/) and drive the public API: the parser package
+// (both parsers), cel.Env parse/check/program/eval, the evaluation options, the static
+// optimizer and the unparser.
+//
+// Oracles: the CEL specification's Standard Definitions, transcribed into a model that gives
+// every generated expression its value; the library against itself (the ANTLR and Pratt
+// parsers, checked and unchecked evaluation, the evaluation options, constant folding, and
+// the unparser's round trip must all agree).
+//
+// Every property draws one case record from generators built of hegel-go's combinators (the
+// bindings, an expression tree typed by construction, and a tape for the choices the text
+// leaves free), renders it with pure functions and judges it through one oracle (hzJudge,
+// hzJudgeParsers). The shapes of the recorded bugs (bugs.toml) are drawn at their natural
+// rate, so the properties that meet them fail naming the shape and are the expected failures
+// mapped to the bugs (STYLE.md rule 11); hegel_zoo_shapes_test.go has one property per bug
+// over its shape region alone, and hegel_zoo_pins_test.go the regression examples.
+// HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below) for a run that looks past
+// the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// generators draw the bugs' shapes and the properties that meet them fail, naming the shape
+// (hzCollector.mismatch, hzCollector.tolerated); under HEGEL_NO_KNOWN=1 the switches of HZKnown
+// are on, the shapes are left out of the generators (shaped) and a check that still meets a
+// known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. A switch that is on
+// means the generators keep away from the shape or the checks skip it, which is so only under
+// HEGEL_NO_KNOWN=1; the pins assert the documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	prattLiteralIn              bool // cel-go/1: the Pratt lexer rejects a numeric literal directly followed by `in` (1in[1]), which the grammar's lexer splits into two tokens. On: a space before `in`.
+	prattNegativeLiteralOffset  bool // cel-go/2: the Pratt parser records the offset range of a negative numeric literal (-1), of a leading-dot identifier (.b) and of a message literal differently from the ANTLR parser. On: offsets of literals, identifiers and structs are not compared.
+	checkerTypeVarFirstOverload bool // cel-go/3: an operand of unresolved type (an element of an empty list or map literal) is bound by the first overload tried, so -({}['a']) is typed double and -({}['a']) + 1 fails to check. On: indexes and macro ranges are non-empty literals.
+	inFoldDropsError            bool // cel-go/4: OptOptimize and constant folding rewrite `e in []` to false, and folding rewrites `x in [x, e]` to true, dropping the error of e. On: the rewrites are skipped when an erroring expression has `in` over a constant haystack.
+	mapRepeatedKeyLastWins      bool // cel-go/5: a map literal with a repeated key evaluates to a map holding the last entry, not to the error the specification requires. On: repeated keys are dropped from the drawn tree.
+	optimizeConstUnaryError     bool // cel-go/6: OptOptimize fails Program() with the error of a constant unary call (string(b'\xff'), int('x')) even in a branch that is never taken. On: such a Program() error is skipped.
+	foldIDCollision             bool // cel-go/7: constant folding of (true ? {a: 1, b: 2, c: 3} : {})['t'] or (false ? {1: s1} : {i2: s1}).filter(k, k < 1) fails: the pruned branch's ids collide with later nodes ("incompatible type/reference already exists for expression"). On: such a folding error is skipped.
+	unparseNonFiniteDouble      bool // cel-go/8: the unparser writes a non-finite double literal (from folding 0.0/0.0 or 1.0/0.0) as NaN.0, +Inf.0 or -Inf.0, which do not parse. On: such a folded text is not recompiled.
+	foldFalsePredicate          bool // cel-go/9: constant folding of {1: 'a'}.filter(e, false), .map(e, false, t), .exists(e, false) or .all(e, true) over a constant range gives a stray value (the last map value, null for a list) instead of the accumulator's result. On: literal predicates are left out of those macros.
+	antlrTextLiteralStopInBytes bool // cel-go/10: the ANTLR parser's helper sets the offset range of a literal to Start plus the byte length of its text (parser/helper.go, newLiteral: offset.Stop = offset.Start + int32(len(c.GetText()))) while Start and every other offset count code points, so a string or bytes literal holding a non-ASCII character is recorded too long: a quoted two-byte e-acute is 0-4 against the Pratt parser's 0-3, a quoted four-byte emoji 0-6 against 0-3. On: offset differences that are all non-ASCII text literals are counted, not judged.
+	prattRejectsLoneComma       bool // cel-go/11: the grammar (parser/gen/CEL.g4, CreateList: '[' listInit? ','? ']', CreateStruct and CreateMessage alike) takes a lone comma, so the ANTLR parser accepts `[,]`, `{,}`, `[ , ]` and `Msg{,}` as the empty list, map and message, and the Pratt parser rejects each of them ("unexpected token"; "expected struct field name"). Both accept `[1,]`, `{1: 2,}`, `[]`, `{}` and reject `[,1]`. On: a text with a lone comma the Pratt parser rejects is counted, not judged.
+}{noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown}
+
+// hzLoneComma matches an opening bracket or brace followed by a comma.
+var hzLoneComma = regexp.MustCompile(`[\[{]\s*,`)
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- collector
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is that of the
+// recorded bugs shape names (none for a shape no bug covers): the failure names them, and
+// under HEGEL_NO_KNOWN=1 a disagreement on a known shape rejects the case instead (rare then,
+// since the generators leave the shapes out).
+func (c *hzCollector) mismatch(ht *hegel.T, shape []string, class string, format string, args ...any) {
+	if len(shape) > 0 {
+		if noKnown {
+			c.count("skipped " + strings.Join(shape, ", "))
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+		class += " " + strings.Join(shape, ", ")
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// tolerated is mismatch for one check among several: under HEGEL_NO_KNOWN=1 a disagreement on
+// a known shape is counted and the check skipped (true), the case going on to its other
+// checks; otherwise it is the failure.
+func (c *hzCollector) tolerated(ht *hegel.T, shape []string, class string, format string, args ...any) bool {
+	if noKnown && len(shape) > 0 {
+		class = "tolerated " + strings.Join(shape, ", ")
+		c.mu.Lock()
+		c.counts[class]++
+		if hzCollecting && c.counts[class] <= 3 {
+			c.msgs = append(c.msgs, c.name+": "+class+": "+fmt.Sprintf(format, args...))
+		}
+		c.mu.Unlock()
+		return true
+	}
+	c.mismatch(ht, shape, class, format, args...)
+	return false
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// nonNil makes an empty slice a non-nil one (Lists yields nil for zero elements).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// tape is a drawn list of small integers that a pure renderer consumes in order, recycled
+// modulo its length, for the choices a text leaves free (whitespace, redundant parentheses,
+// the spelling of a literal). An empty tape answers 0 to every question, so the shrunk form
+// of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 || n <= 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// hzTapes: up to sixty values of 0 to 99.
+var hzTapes = many(hegel.Integers(0, 99), 0, 60)
