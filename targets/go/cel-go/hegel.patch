+// --------------------------------------------------------------------------- cel-go/7
+
+// hzFilterSpecs: a filter with a predicate that is not a literal (which would meet cel-go/9
+// instead).
+func hzFilterSpecs(kind hzKind) hegel.Generator[hzMacro] {
+	return hegel.Filter(hzMacroSpecsOver(kind, []string{"filter"}), func(m hzMacro) bool {
+		return !hzLiteralPredicate(hzPredsOf(kind)[m.pred.id].name, "filter")
+	})
+}
+
+// hzPrunedConditionalCases: a conditional with a literal condition whose taken branch is a
+// map literal of three or four entries with distinct literal keys, indexed (the shape of
+// cel-go/7; two entries under HEGEL_NO_KNOWN=1), or one whose branches are one-entry maps,
+// filtered (a list under HEGEL_NO_KNOWN=1); values are literals or variables.
+var hzPrunedConditionalCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	mt := hegel.Draw(tc, hegel.SampledFrom([]hzType{hzTMSI, hzTMIS}))
+	kt, vt := *mt.key, *mt.val
+	entries := func(lo, hi int) hegel.Generator[*hzNode] { return hzDistinctKeyMaps(mt, hzLeavesOf(vt), lo, hi) }
+	lists := func(lo, hi int) hegel.Generator[*hzNode] { return hzListLits(hzListOf(vt), hzLeavesOf(vt), lo) }
+	c := hegel.Draw(tc, hegel.Booleans())
+	branch := func(taken, other *hzNode) *hzNode {
+		if c {
+			return hzCondNode(hzLit(hzBool(true)), taken, other)
+		}
+		return hzCondNode(hzLit(hzBool(false)), other, taken)
+	}
+	var expr *hzNode
+	if hegel.Draw(tc, chance(50)) {
+		taken := hegel.Draw(tc, entries(1, 1))
+		other := hegel.Draw(tc, entries(1, 1))
+		if noKnown {
+			taken, other = hegel.Draw(tc, lists(1, 1)), hegel.Draw(tc, lists(1, 1))
+		}
+		rng := branch(taken, other)
+		expr = hzMacroNode(rng, hegel.Draw(tc, hzFilterSpecs(hzElemOf(rng.t).k)))
+		cs := hzShapeCase(tc, expr)
+		cs.unordered = rng.t.k == hzKMap
+		return cs
+	}
+	taken := hegel.Draw(tc, shaped(entries(3, 4), entries(2, 2)))
+	other := hegel.Draw(tc, entries(0, 3))
+	key := hegel.Draw(tc, weighted(choice[*hzNode]{50, hzPicks(kt)}, choice[*hzNode]{50, hzLeavesOf(kt)}))
+	return hzShapeCase(tc, hzIndexNode(branch(taken, other), key))
+})
+
+// TestHegelFoldingSurvivesPrunedConditionalBranches: constant folding of a conditional with a
+// literal condition keeps the taken branch and folds the rest of the expression (an index
+// into the map, a filter over it) as plain evaluation does; the pruned branch's ids collide
+// with later nodes and the optimizer fails re-checking (cel-go/7).
+func TestHegelFoldingSurvivesPrunedConditionalBranches(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, hzPrunedConditionalCases)
+		hzJudge(ht, c, env, cs, cs.expr.kind != hzNMacro)
+	})
+}
