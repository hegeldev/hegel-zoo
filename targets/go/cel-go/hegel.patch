+package hegel
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- comprehensions
+
+// The comprehension macros are modelled with a small set of predicate and transform templates
+// over the loop variable, so that each element's value can be computed by the model: the
+// specification's Macros section gives the combination rules (all: && over the predicates,
+// exists: ||, exists_one: exactly one true and any error an error, map and filter: any error
+// an error). A template's constants (an int k, a string s, a pattern, a count n) are drawn
+// with its use as hzTParams and spelled by the renderer.
+
+type hzTParams struct {
+	k   int64
+	s   string
+	pat string
+	n   int64
+}
+
+// hzTemplate is a predicate or transform of the loop variable X: its source (X spelled as the
+// drawn variable, the constants spelled by the renderer) and its model.
+type hzTemplate struct {
+	name string
+	t    hzType
+	src  func(x string, p hzTParams, r *hzRenderer) string
+	fn   func(x hzVal, p hzTParams, env hzVars) hzVal
+}
+
+func hzBoolOf(v hzVal, pred func(hzVal) bool) hzVal {
+	if v.isErr() {
+		return v
+	}
+	return hzBool(pred(v))
+}
+
+// predicates over an int element
+var hzIntPreds = []hzTemplate{
+	{"lt", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " < " + r.lit(hzInt(p.k)) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(x.i < p.k) }},
+	{"ge", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " >= " + r.lit(hzInt(p.k)) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(x.i >= p.k) }},
+	{"eq", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " == " + r.lit(hzInt(p.k)) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(x.i == p.k) }},
+	{"ne", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " != " + r.lit(hzInt(p.k)) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(x.i != p.k) }},
+	{"gt i1", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " > i1" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(x.i > env.get("i1").i) }},
+	{"mod", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " % " + r.lit(hzInt(p.k)) + " == 0" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal {
+			return hzBoolOf(hzModInt(x.i, p.k), func(m hzVal) bool { return m.i == 0 })
+		}},
+	{"div", hzTBool, func(x string, p hzTParams, r *hzRenderer) string {
+		return "(" + x + " / " + r.lit(hzInt(p.k)) + ") > 0"
+	},
+		func(x hzVal, p hzTParams, env hzVars) hzVal {
+			return hzBoolOf(hzDivInt(x.i, p.k), func(d hzVal) bool { return d.i > 0 })
+		}},
+	{"add", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " + " + r.lit(hzInt(p.k)) + " > 0" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal {
+			return hzBoolOf(hzAddInt(x.i, p.k), func(s hzVal) bool { return s.i > 0 })
+		}},
+	{"neg", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return "-" + x + " < 0" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal {
+			return hzBoolOf(hzNegInt(x.i), func(n hzVal) bool { return n.i < 0 })
+		}},
+	{"digits", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return "string(" + x + ").size() > 1" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(len(strconv.FormatInt(x.i, 10)) > 1) }},
+	{"in li", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " in li" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal {
+			for _, e := range env.get("li").list {
+				if e.i == x.i {
+					return hzBool(true)
+				}
+			}
+			return hzBool(false)
+		}},
+	{"true", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return "true" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(true) }},
+	{"false", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return "false" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(false) }},
+	{"ne self", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " != " + x },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(false) }},
+	{"eq self", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " == " + x },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(true) }},
+}
+
+// predicates over a string element
+var hzStrPreds = []hzTemplate{
+	{"startsWith", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + ".startsWith(" + r.str(p.s) + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(strings.HasPrefix(x.s, p.s)) }},
+	{"endsWith", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + ".endsWith(" + r.str(p.s) + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(strings.HasSuffix(x.s, p.s)) }},
+	{"contains", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + ".contains(" + r.str(p.s) + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(strings.Contains(x.s, p.s)) }},
+	{"eq", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " == " + r.str(p.s) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(x.s == p.s) }},
+	{"lt", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " < " + r.str(p.s) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(x.s < p.s) }},
+	{"size", hzTBool, func(x string, p hzTParams, r *hzRenderer) string {
+		return x + ".size() > " + strconv.FormatInt(p.n, 10)
+	},
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(int64(utf8.RuneCountInString(x.s)) > p.n) }},
+	{"matches", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + ".matches(" + r.str(p.pat) + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal {
+			re, err := regexp.Compile(p.pat)
+			if err != nil {
+				return hzErr("bad pattern")
+			}
+			return hzBool(re.MatchString(x.s))
+		}},
+	{"in ls", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " in ls" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal {
+			for _, e := range env.get("ls").list {
+				if e.s == x.s {
+					return hzBool(true)
+				}
+			}
+			return hzBool(false)
+		}},
+	{"int", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return "int(" + x + ") > 0" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal {
+			return hzBoolOf(hzConvert(hzTInt, x), func(v hzVal) bool { return v.i > 0 })
+		}},
+	{"in ms", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " in ms" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(hzMapFind(env.get("ms"), x) >= 0) }},
+	{"true", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return "true" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(true) }},
+	{"false", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return "false" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(false) }},
+	{"ne self", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " != " + x },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(false) }},
+	{"eq self", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " == " + x },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(true) }},
+}
+
+// transforms of an int element
+var hzIntTrans = []hzTemplate{
+	{"add", hzTInt, func(x string, p hzTParams, r *hzRenderer) string { return x + " + " + r.lit(hzInt(p.k)) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzAddInt(x.i, p.k) }},
+	{"double", hzTInt, func(x string, p hzTParams, r *hzRenderer) string { return x + " * 2" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzMulInt(x.i, 2) }},
+	{"neg", hzTInt, func(x string, p hzTParams, r *hzRenderer) string { return "-" + x },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzNegInt(x.i) }},
+	{"mod", hzTInt, func(x string, p hzTParams, r *hzRenderer) string { return x + " % " + r.lit(hzInt(p.k)) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzModInt(x.i, p.k) }},
+	{"string", hzTString, func(x string, p hzTParams, r *hzRenderer) string { return "string(" + x + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzStr(strconv.FormatInt(x.i, 10)) }},
+	{"gt", hzTBool, func(x string, p hzTParams, r *hzRenderer) string { return x + " > " + r.lit(hzInt(p.k)) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBool(x.i > p.k) }},
+	{"toDouble", hzTDouble, func(x string, p hzTParams, r *hzRenderer) string { return "double(" + x + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzDouble(float64(x.i)) }},
+	{"id", hzTInt, func(x string, p hzTParams, r *hzRenderer) string { return x },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return x }},
+}
+
+// transforms of a string element
+var hzStrTrans = []hzTemplate{
+	{"concat", hzTString, func(x string, p hzTParams, r *hzRenderer) string { return x + " + " + r.str(p.s) },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzStr(x.s + p.s) }},
+	{"size", hzTInt, func(x string, p hzTParams, r *hzRenderer) string { return "size(" + x + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzInt(int64(utf8.RuneCountInString(x.s))) }},
+	{"size member", hzTInt, func(x string, p hzTParams, r *hzRenderer) string { return x + ".size()" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzInt(int64(utf8.RuneCountInString(x.s))) }},
+	{"bytes", hzTBytes, func(x string, p hzTParams, r *hzRenderer) string { return "bytes(" + x + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzBytes([]byte(x.s)) }},
+	{"int", hzTInt, func(x string, p hzTParams, r *hzRenderer) string { return "int(" + x + ")" },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return hzConvert(hzTInt, x) }},
+	{"id", hzTString, func(x string, p hzTParams, r *hzRenderer) string { return x },
+		func(x hzVal, p hzTParams, env hzVars) hzVal { return x }},
+}
+
+func hzPredsOf(kind hzKind) []hzTemplate {
+	if kind == hzKInt {
+		return hzIntPreds
+	}
+	return hzStrPreds
+}
+
+func hzTransOf(kind hzKind) []hzTemplate {
+	if kind == hzKInt {
+		return hzIntTrans
+	}
+	return hzStrTrans
+}
+
+// hzTemplateID is the index of the named template.
+func hzTemplateID(table []hzTemplate, name string) int {
+	for i, t := range table {
+		if t.name == name {
+			return i
+		}
+	}
+	panic("hzTemplateID: no template " + name)
+}
+
+// hzTemplateUse is a template with its constants.
+type hzTemplateUse struct {
+	id int
+	p  hzTParams
+}
+
+// hzMacro is a comprehension applied to a range: the macro, its loop variable, its predicate
+// and its transform (map3 is the three-argument map, a filter and a transform).
+type hzMacro struct {
+	name string
+	x    string
+	pred hzTemplateUse
+	tr   hzTemplateUse
+}
+
+var hzMacroNames = []string{"all", "exists", "exists_one", "map", "map3", "filter"}
+
+// hzLiteralPredicate reports whether the predicate leaves the accumulator of the macro
+// unchanged at every step: filter, the three-argument map and exists with the literal false,
+// all with the literal true (the shape of cel-go/9).
+func hzLiteralPredicate(predName, macro string) bool {
+	return (predName == "false" && (macro == "exists" || macro == "filter" || macro == "map3")) || (predName == "true" && macro == "all")
+}
+
+// hzLiteralPredicateMacro reports whether the tree holds a macro with such a predicate.
+func hzLiteralPredicateMacro(n *hzNode) bool {
+	return hzAny(n, func(x *hzNode) bool {
+		if x.kind != hzNMacro {
+			return false
+		}
+		preds := hzPredsOf(hzElemOf(x.args[0].t).k)
+		return hzLiteralPredicate(preds[x.macro.pred.id].name, x.macro.name)
+	})
+}
+
+// hzMacroNode applies the macro to the range.
+func hzMacroNode(rng *hzNode, m hzMacro) *hzNode {
+	elemT := hzElemOf(rng.t)
+	var t hzType
+	switch m.name {
+	case "all", "exists", "exists_one":
+		t = hzTBool
+	case "map", "map3":
+		t = hzListOf(hzTransOf(elemT.k)[m.tr.id].t)
+	default:
+		t = hzListOf(elemT)
+	}
+	return &hzNode{kind: hzNMacro, t: t, macro: &m, args: []*hzNode{rng}}
+}
+
+// hzMacroChain names the macros of the tree, outermost last (for the statistics).
+func hzMacroChain(n *hzNode) string {
+	var names []string
+	for _, a := range n.args {
+		if s := hzMacroChain(a); s != "" {
+			names = append(names, s)
+		}
+	}
+	if n.kind == hzNMacro {
+		names = append(names, n.macro.name)
+	}
+	return strings.Join(names, ".")
+}
+
+// hzEvalMacro is the specification's value of a comprehension (the Macros section: all is &&
+// over the predicates, exists ||, exists_one exactly one true and any error an error, map and
+// filter any error an error).
+func hzEvalMacro(n *hzNode, env hzVars) hzVal {
+	rng := hzEvalNode(n.args[0], env)
+	if rng.isErr() {
+		return rng
+	}
+	kind := hzElemOf(n.args[0].t).k
+	m := n.macro
+	p, tr := hzPredsOf(kind)[m.pred.id], hzTransOf(kind)[m.tr.id]
+	elems := rng.list
+	if rng.k == hzKMap {
+		elems = rng.keys
+	}
+	// the predicate values, in order
+	pv := make([]hzVal, len(elems))
+	for i, e := range elems {
+		pv[i] = p.fn(e, m.pred.p, env)
+	}
+	switch m.name {
+	case "all":
+		acc := hzBool(true)
+		for _, r := range pv {
+			acc = hzAnd(acc, r)
+		}
+		return acc
+	case "exists":
+		acc := hzBool(false)
+		for _, r := range pv {
+			acc = hzOr(acc, r)
+		}
+		return acc
+	case "exists_one":
+		count := 0
+		var errv *hzVal
+		for _, r := range pv {
+			if r.isErr() {
+				if errv == nil {
+					rr := r
+					errv = &rr
+				}
+			} else if r.bo {
+				count++
+			}
+		}
+		if errv != nil {
+			return *errv
+		}
+		return hzBool(count == 1)
+	case "map":
+		out := hzVal{k: hzKList, list: []hzVal{}}
+		for _, e := range elems {
+			r := tr.fn(e, m.tr.p, env)
+			if r.isErr() {
+				return r
+			}
+			out.list = append(out.list, r)
+		}
+		return out
+	case "map3":
+		out := hzVal{k: hzKList, list: []hzVal{}}
+		for i, e := range elems {
+			if pv[i].isErr() {
+				return pv[i]
+			}
+			if !pv[i].bo {
+				continue
+			}
+			r := tr.fn(e, m.tr.p, env)
+			if r.isErr() {
+				return r
+			}
+			out.list = append(out.list, r)
+		}
+		return out
+	}
+	out := hzVal{k: hzKList, list: []hzVal{}}
+	for i, e := range elems {
+		if pv[i].isErr() {
+			return pv[i]
+		}
+		if pv[i].bo {
+			out.list = append(out.list, e)
+		}
+	}
+	return out
+}
+
+// macro writes rng.name(x, ...).
+func (r *hzRenderer) macro(n *hzNode) string {
+	kind := hzElemOf(n.args[0].t).k
+	m := n.macro
+	target := r.primary(n.args[0])
+	ws := r.ws()
+	pred := hzPredsOf(kind)[m.pred.id].src(m.x, m.pred.p, r)
+	trs := hzTransOf(kind)[m.tr.id].src(m.x, m.tr.p, r)
+	switch m.name {
+	case "map":
+		return fmt.Sprintf("%s.map(%s,%s%s)", target, m.x, ws, trs)
+	case "map3":
+		return fmt.Sprintf("%s.map(%s,%s%s,%s%s)", target, m.x, ws, pred, r.ws(), trs)
+	}
+	return fmt.Sprintf("%s.%s(%s,%s%s)", target, m.name, m.x, ws, pred)
+}
+
+// --------------------------------------------------------------------------- generators
+
+var (
+	hzIterVars   = hegel.SampledFrom([]string{"x", "e", "k", "item", "x_1"})
+	hzTParamsGen = hegel.Composite(func(tc hegel.TestCase) hzTParams {
+		return hzTParams{
+			k:   hegel.Draw(tc, hzIntVals).i,
+			s:   hegel.Draw(tc, hzStringVals).s,
+			pat: hegel.Draw(tc, hegel.SampledFrom(hzPatterns)),
+			n:   int64(hegel.Draw(tc, hegel.Integers(0, 5))),
+		}
+	})
+)
+
+// hzMacroSpecsOver: one of the named macros over elements of the kind with a predicate and a
+// transform of the kind's tables; under HEGEL_NO_KNOWN=1 the literal predicates that leave the
+// accumulator unchanged are left out of the macros they break (cel-go/9).
+func hzMacroSpecsOver(kind hzKind, names []string) hegel.Generator[hzMacro] {
+	preds, trans := hzPredsOf(kind), hzTransOf(kind)
+	return hegel.FlatMap(hegel.SampledFrom(names), func(name string) hegel.Generator[hzMacro] {
+		var ids []int
+		for i, p := range preds {
+			if HZKnown.foldFalsePredicate && hzLiteralPredicate(p.name, name) {
+				continue
+			}
+			ids = append(ids, i)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) hzMacro {
+			return hzMacro{
+				name: name,
+				x:    hegel.Draw(tc, hzIterVars),
+				pred: hzTemplateUse{hegel.Draw(tc, hegel.SampledFrom(ids)), hegel.Draw(tc, hzTParamsGen)},
+				tr:   hzTemplateUse{hegel.Draw(tc, hegel.Integers(0, len(trans)-1)), hegel.Draw(tc, hzTParamsGen)},
+			}
+		})
+	})
+}
+
+// hzMacroSpecs: any macro, by element kind.
+var hzMacroSpecs = map[hzKind]hegel.Generator[hzMacro]{
+	hzKInt:    hzMacroSpecsOver(hzKInt, hzMacroNames),
+	hzKString: hzMacroSpecsOver(hzKString, hzMacroNames),
+}
+
+// hzRangeTypes: the range of a macro case: a list twice as often as a map.
+var hzRangeTypes = []hzType{hzTLInt, hzTLStr, hzTLInt, hzTLStr, hzTMSI, hzTMIS}
+
+// hzMacroCases: bindings, a range up to two levels deep, a macro over it, 40% of the time a
+// second macro chained on a list result of int or string, and 30% of the time an expression
+// using the result (`!` of a bool, size of a list).
+var hzMacroCases = hegel.Map(hegel.Composite(func(tc hegel.TestCase) hzCase {
+	env := hegel.Draw(tc, hzBindings)
+	rt := hegel.Draw(tc, hegel.SampledFrom(hzRangeTypes))
+	depth := hegel.Draw(tc, hegel.Integers(0, 2))
+	rng := hegel.Draw(tc, hzGrammars[depth].aggs[rt.String()])
+	node := hzMacroNode(rng, hegel.Draw(tc, hzMacroSpecs[hzElemOf(rt).k]))
+	if node.t.k == hzKList && (node.t.elem.k == hzKInt || node.t.elem.k == hzKString) && hegel.Draw(tc, chance(40)) {
+		node = hzMacroNode(node, hegel.Draw(tc, hzMacroSpecs[node.t.elem.k]))
+	}
+	if hegel.Draw(tc, chance(30)) {
+		switch node.t.k {
+		case hzKBool:
+			node = hzNotNode(node, 1)
+		case hzKList:
+			node = hzSizeNode(node)
+		}
+	}
+	return hzCase{env: env, expr: node, tape: hegel.Draw(tc, hzTapes), in: hzInDefault, unordered: rt.k == hzKMap}
+}), hzShapeless)
+
+// TestHegelMacros: the comprehension macros over generated ranges and predicate templates give
+// the specification's value under every evaluation mode, fold and unparse consistently.
+func TestHegelMacros(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, hzMacroCases)
+		c.count("macro " + hzMacroChain(cs.expr))
+		hzJudge(ht, c, env, cs, false)
+	})
+}
