+package hegel
+
+// The expression generator and its model. A case is data: the variable bindings, an
+// expression tree (hzNode) typed by construction, and a tape of small integers for the
+// choices the text leaves free (whitespace, redundant parentheses, the spelling of a
+// literal). The model is a direct transcription of the specification's Standard Definitions
+// (langdef.md): checked int/uint arithmetic, IEEE doubles, byte-wise string ordering,
+// code-point string sizes, commutative error absorption in && and ||, and the documented
+// conversions; it is a pure function of the tree and the bindings (hzEvalNode). The source
+// text is a pure function of the tree, the bindings and the tape (hzRender); an empty tape is
+// the tight, plainly spelled text, so that is what a case shrinks to.
+
+import (
+	"bytes"
+	"fmt"
+	"math"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- types
+
+type hzKind int
+
+const (
+	hzKInt hzKind = iota
+	hzKUint
+	hzKDouble
+	hzKString
+	hzKBytes
+	hzKBool
+	hzKList
+	hzKMap
+	hzKErr
+)
+
+type hzType struct {
+	k    hzKind
+	elem *hzType // list element
+	key  *hzType // map key
+	val  *hzType // map value
+}
+
+var (
+	hzTInt    = hzType{k: hzKInt}
+	hzTUint   = hzType{k: hzKUint}
+	hzTDouble = hzType{k: hzKDouble}
+	hzTString = hzType{k: hzKString}
+	hzTBytes  = hzType{k: hzKBytes}
+	hzTBool   = hzType{k: hzKBool}
+	hzTLInt   = hzType{k: hzKList, elem: &hzTInt}
+	hzTLStr   = hzType{k: hzKList, elem: &hzTString}
+	hzTMSI    = hzType{k: hzKMap, key: &hzTString, val: &hzTInt}
+	hzTMIS    = hzType{k: hzKMap, key: &hzTInt, val: &hzTString}
+)
+
+var hzScalarTypes = []hzType{hzTInt, hzTUint, hzTDouble, hzTString, hzTBytes, hzTBool}
+var hzAllTypes = []hzType{hzTInt, hzTUint, hzTDouble, hzTString, hzTBytes, hzTBool, hzTLInt, hzTLStr, hzTMSI, hzTMIS}
+
+func (t hzType) String() string {
+	switch t.k {
+	case hzKInt:
+		return "int"
+	case hzKUint:
+		return "uint"
+	case hzKDouble:
+		return "double"
+	case hzKString:
+		return "string"
+	case hzKBytes:
+		return "bytes"
+	case hzKBool:
+		return "bool"
+	case hzKList:
+		return "list(" + t.elem.String() + ")"
+	case hzKMap:
+		return "map(" + t.key.String() + ", " + t.val.String() + ")"
+	}
+	return "?"
+}
+
+func (t hzType) eq(o hzType) bool { return t.String() == o.String() }
+
+// hzListOf is the list type of the element type.
+func hzListOf(elem hzType) hzType { return hzType{k: hzKList, elem: &elem} }
+
+// hzElemOf is the type an iteration over the aggregate yields: the element of a list, the key
+// of a map.
+func hzElemOf(t hzType) hzType {
+	if t.k == hzKList {
+		return *t.elem
+	}
+	return *t.key
+}
+
+// hzIndexedOf is the type an index into the aggregate yields.
+func hzIndexedOf(t hzType) hzType {
+	if t.k == hzKList {
+		return *t.elem
+	}
+	return *t.val
+}
+
+// --------------------------------------------------------------------------- values
+
+type hzVal struct {
+	k    hzKind
+	i    int64
+	u    uint64
+	d    float64
+	s    string
+	b    []byte
+	bo   bool
+	list []hzVal
+	keys []hzVal
+	vals []hzVal
+	err  string // hzKErr: the class of error
+}
+
+func hzInt(i int64) hzVal      { return hzVal{k: hzKInt, i: i} }
+func hzUint(u uint64) hzVal    { return hzVal{k: hzKUint, u: u} }
+func hzDouble(d float64) hzVal { return hzVal{k: hzKDouble, d: d} }
+func hzStr(s string) hzVal     { return hzVal{k: hzKString, s: s} }
+func hzBytes(b []byte) hzVal   { return hzVal{k: hzKBytes, b: b} }
+func hzBool(b bool) hzVal      { return hzVal{k: hzKBool, bo: b} }
+func hzErr(class string) hzVal { return hzVal{k: hzKErr, err: class} }
+
+func (v hzVal) isErr() bool { return v.k == hzKErr }
+
+// hzZero is the zero value of a scalar type.
+func hzZero(t hzType) hzVal {
+	switch t.k {
+	case hzKInt:
+		return hzInt(0)
+	case hzKUint:
+		return hzUint(0)
+	case hzKDouble:
+		return hzDouble(0)
+	case hzKString:
+		return hzStr("")
+	case hzKBytes:
+		return hzBytes([]byte{})
+	}
+	return hzBool(false)
+}
+
+// hzTypeOfVal is the type of a scalar value.
+func hzTypeOfVal(v hzVal) hzType {
+	switch v.k {
+	case hzKInt:
+		return hzTInt
+	case hzKUint:
+		return hzTUint
+	case hzKDouble:
+		return hzTDouble
+	case hzKString:
+		return hzTString
+	case hzKBytes:
+		return hzTBytes
+	}
+	return hzTBool
+}
+
+// String renders a value as a CEL literal (for messages and for sorting map keys).
+func (v hzVal) String() string {
+	switch v.k {
+	case hzKInt:
+		return strconv.FormatInt(v.i, 10)
+	case hzKUint:
+		return strconv.FormatUint(v.u, 10) + "u"
+	case hzKDouble:
+		return strconv.FormatFloat(v.d, 'g', -1, 64) + "d"
+	case hzKString:
+		return strconv.Quote(v.s)
+	case hzKBytes:
+		return "b" + strconv.Quote(string(v.b))
+	case hzKBool:
+		return strconv.FormatBool(v.bo)
+	case hzKList:
+		parts := make([]string, len(v.list))
+		for i, e := range v.list {
+			parts[i] = e.String()
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case hzKMap:
+		idx := hzSortedKeys(v)
+		parts := make([]string, len(idx))
+		for n, i := range idx {
+			parts[n] = v.keys[i].String() + ": " + v.vals[i].String()
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	case hzKErr:
+		return "error(" + v.err + ")"
+	}
+	return "?"
+}
+
+func hzSortedKeys(v hzVal) []int {
+	idx := make([]int, len(v.keys))
+	for i := range idx {
+		idx[i] = i
+	}
+	sort.Slice(idx, func(a, b int) bool { return v.keys[idx[a]].String() < v.keys[idx[b]].String() })
+	return idx
+}
+
+// hzEqual is the specification's equality (numeric across int/uint/double, NaN never equal,
+// aggregates element-wise); the generator only compares values of one type.
+func hzEqual(a, b hzVal) bool {
+	if a.k == hzKErr || b.k == hzKErr {
+		return false
+	}
+	switch a.k {
+	case hzKInt:
+		switch b.k {
+		case hzKInt:
+			return a.i == b.i
+		case hzKUint:
+			return a.i >= 0 && uint64(a.i) == b.u
+		case hzKDouble:
+			return hzCmpIntDouble(a.i, b.d) == 0
+		}
+		return false
+	case hzKUint:
+		switch b.k {
+		case hzKInt:
+			return b.i >= 0 && uint64(b.i) == a.u
+		case hzKUint:
+			return a.u == b.u
+		case hzKDouble:
+			return hzCmpUintDouble(a.u, b.d) == 0
+		}
+		return false
+	case hzKDouble:
+		switch b.k {
+		case hzKInt:
+			return hzCmpIntDouble(b.i, a.d) == 0
+		case hzKUint:
+			return hzCmpUintDouble(b.u, a.d) == 0
+		case hzKDouble:
+			return a.d == b.d
+		}
+		return false
+	case hzKString:
+		return b.k == hzKString && a.s == b.s
+	case hzKBytes:
+		return b.k == hzKBytes && bytes.Equal(a.b, b.b)
+	case hzKBool:
+		return b.k == hzKBool && a.bo == b.bo
+	case hzKList:
+		if b.k != hzKList || len(a.list) != len(b.list) {
+			return false
+		}
+		for i := range a.list {
+			if !hzEqual(a.list[i], b.list[i]) {
+				return false
+			}
+		}
+		return true
+	case hzKMap:
+		if b.k != hzKMap || len(a.keys) != len(b.keys) {
+			return false
+		}
+		for i := range a.keys {
+			j := hzMapFind(b, a.keys[i])
+			if j < 0 || !hzEqual(a.vals[i], b.vals[j]) {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+// hzCmpIntDouble compares exactly, as the specification's cross-type ordering requires
+// (returns 2 for an unordered NaN).
+func hzCmpIntDouble(i int64, d float64) int {
+	if math.IsNaN(d) {
+		return 2
+	}
+	if d < -9223372036854775808.0 {
+		return 1
+	}
+	if d >= 9223372036854775808.0 {
+		return -1
+	}
+	t := math.Trunc(d)
+	ti := int64(t)
+	if i < ti {
+		return -1
+	}
+	if i > ti {
+		return 1
+	}
+	frac := d - t
+	if frac > 0 {
+		return -1
+	}
+	if frac < 0 {
+		return 1
+	}
+	return 0
+}
+
+func hzCmpUintDouble(u uint64, d float64) int {
+	if math.IsNaN(d) {
+		return 2
+	}
+	if d < 0 {
+		return 1
+	}
+	if d >= 18446744073709551616.0 {
+		return -1
+	}
+	t := math.Trunc(d)
+	tu := uint64(t)
+	if u < tu {
+		return -1
+	}
+	if u > tu {
+		return 1
+	}
+	frac := d - t
+	if frac > 0 {
+		return -1
+	}
+	return 0
+}
+
+func hzMapFind(m hzVal, key hzVal) int {
+	for i := range m.keys {
+		if hzEqual(m.keys[i], key) {
+			return i
+		}
+	}
+	return -1
+}
+
+// hzCompare orders two values of one type; ok is false for NaN (an error in cel-go).
+func hzCompare(a, b hzVal) (c int, ok bool) {
+	switch a.k {
+	case hzKInt:
+		if a.i < b.i {
+			return -1, true
+		} else if a.i > b.i {
+			return 1, true
+		}
+		return 0, true
+	case hzKUint:
+		if a.u < b.u {
+			return -1, true
+		} else if a.u > b.u {
+			return 1, true
+		}
+		return 0, true
+	case hzKDouble:
+		if math.IsNaN(a.d) || math.IsNaN(b.d) {
+			return 0, false
+		}
+		if a.d < b.d {
+			return -1, true
+		} else if a.d > b.d {
+			return 1, true
+		}
+		return 0, true
+	case hzKString:
+		return strings.Compare(a.s, b.s), true
+	case hzKBytes:
+		return bytes.Compare(a.b, b.b), true
+	case hzKBool:
+		if a.bo == b.bo {
+			return 0, true
+		} else if !a.bo {
+			return -1, true
+		}
+		return 1, true
+	}
+	return 0, false
+}
+
+// hzSame is the test's own comparison of a model value with an evaluation result: like
+// hzEqual, but NaN equals NaN and errors equal errors.
+func hzSame(a, b hzVal) bool {
+	if a.k == hzKErr || b.k == hzKErr {
+		return a.k == b.k
+	}
+	if a.k == hzKDouble && b.k == hzKDouble && math.IsNaN(a.d) && math.IsNaN(b.d) {
+		return true
+	}
+	if a.k == hzKList && b.k == hzKList {
+		if len(a.list) != len(b.list) {
+			return false
+		}
+		for i := range a.list {
+			if !hzSame(a.list[i], b.list[i]) {
+				return false
+			}
+		}
+		return true
+	}
+	if a.k == hzKMap && b.k == hzKMap {
+		if len(a.keys) != len(b.keys) {
+			return false
+		}
+		for i := range a.keys {
+			j := hzMapFind(b, a.keys[i])
+			if j < 0 || !hzSame(a.vals[i], b.vals[j]) {
+				return false
+			}
+		}
+		return true
+	}
+	return hzEqual(a, b)
+}
+
+// hzSameSet is hzSame for lists whose order is unspecified.
+func hzSameSet(a, b hzVal) bool {
+	if a.k != hzKList || b.k != hzKList {
+		return hzSame(a, b)
+	}
+	if len(a.list) != len(b.list) {
+		return false
+	}
+	as := append([]hzVal{}, a.list...)
+	bs := append([]hzVal{}, b.list...)
+	sort.Slice(as, func(i, j int) bool { return as[i].String() < as[j].String() })
+	sort.Slice(bs, func(i, j int) bool { return bs[i].String() < bs[j].String() })
+	for i := range as {
+		if !hzSame(as[i], bs[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- arithmetic
+
+func hzAddInt(x, y int64) hzVal {
+	if (y > 0 && x > math.MaxInt64-y) || (y < 0 && x < math.MinInt64-y) {
+		return hzErr("overflow")
+	}
+	return hzInt(x + y)
+}
+
+func hzSubInt(x, y int64) hzVal {
+	if (y < 0 && x > math.MaxInt64+y) || (y > 0 && x < math.MinInt64+y) {
+		return hzErr("overflow")
+	}
+	return hzInt(x - y)
+}
+
+func hzMulInt(x, y int64) hzVal {
+	if x == 0 || y == 0 {
+		return hzInt(0)
+	}
+	p := x * y
+	if p/y != x || (x == -1 && y == math.MinInt64) || (y == -1 && x == math.MinInt64) {
+		return hzErr("overflow")
+	}
+	return hzInt(p)
+}
+
+func hzDivInt(x, y int64) hzVal {
+	if y == 0 {
+		return hzErr("divide by zero")
+	}
+	if x == math.MinInt64 && y == -1 {
+		return hzErr("overflow")
+	}
+	return hzInt(x / y)
+}
+
+func hzModInt(x, y int64) hzVal {
+	if y == 0 {
+		return hzErr("modulus by zero")
+	}
+	if x == math.MinInt64 && y == -1 {
+		// mathematically 0; cel-go reports an overflow, and the specification's overflow rule
+		// covers the intermediate quotient: accepted either way
+		return hzErr("overflow")
+	}
+	return hzInt(x % y)
+}
+
+func hzNegInt(x int64) hzVal {
+	if x == math.MinInt64 {
+		return hzErr("overflow")
+	}
+	return hzInt(-x)
+}
+
+func hzAddUint(x, y uint64) hzVal {
+	if x > math.MaxUint64-y {
+		return hzErr("overflow")
+	}
+	return hzUint(x + y)
+}
+
+func hzSubUint(x, y uint64) hzVal {
+	if y > x {
+		return hzErr("overflow")
+	}
+	return hzUint(x - y)
+}
+
+func hzMulUint(x, y uint64) hzVal {
+	if x == 0 || y == 0 {
+		return hzUint(0)
+	}
+	p := x * y
+	if p/y != x {
+		return hzErr("overflow")
+	}
+	return hzUint(p)
+}
+
+func hzDivUint(x, y uint64) hzVal {
+	if y == 0 {
+		return hzErr("divide by zero")
+	}
+	return hzUint(x / y)
+}
+
+func hzModUint(x, y uint64) hzVal {
+	if y == 0 {
+		return hzErr("modulus by zero")
+	}
+	return hzUint(x % y)
+}
+
+// hzAnd and hzOr are the specification's commutative, error-absorbing logical operators.
+func hzAnd(a, b hzVal) hzVal {
+	switch {
+	case !a.isErr() && !a.bo, !b.isErr() && !b.bo:
+		return hzBool(false)
+	case a.isErr():
+		return a
+	case b.isErr():
+		return b
+	}
+	return hzBool(true)
+}
+
+func hzOr(a, b hzVal) hzVal {
+	switch {
+	case !a.isErr() && a.bo, !b.isErr() && b.bo:
+		return hzBool(true)
+	case a.isErr():
+		return a
+	case b.isErr():
+		return b
+	}
+	return hzBool(false)
+}
+
+// --------------------------------------------------------------------------- conversions
+
+func hzConvert(to hzType, v hzVal) hzVal {
+	if v.isErr() {
+		return v
+	}
+	switch to.k {
+	case hzKInt:
+		switch v.k {
+		case hzKInt:
+			return v
+		case hzKUint:
+			if v.u > math.MaxInt64 {
+				return hzErr("conversion range")
+			}
+			return hzInt(int64(v.u))
+		case hzKDouble:
+			// (minInt, maxInt) non-inclusive, NaN and infinities excluded
+			if math.IsNaN(v.d) || math.IsInf(v.d, 0) || v.d <= -9223372036854775808.0 || v.d >= 9223372036854775808.0 {
+				return hzErr("conversion range")
+			}
+			return hzInt(int64(v.d))
+		case hzKString:
+			n, err := strconv.ParseInt(v.s, 10, 64)
+			if err != nil {
+				return hzErr("conversion parse")
+			}
+			return hzInt(n)
+		}
+	case hzKUint:
+		switch v.k {
+		case hzKUint:
+			return v
+		case hzKInt:
+			if v.i < 0 {
+				return hzErr("conversion range")
+			}
+			return hzUint(uint64(v.i))
+		case hzKDouble:
+			if math.IsNaN(v.d) || math.IsInf(v.d, 0) || v.d < 0 || v.d >= 18446744073709551616.0 {
+				return hzErr("conversion range")
+			}
+			return hzUint(uint64(v.d))
+		case hzKString:
+			n, err := strconv.ParseUint(v.s, 10, 64)
+			if err != nil {
+				return hzErr("conversion parse")
+			}
+			return hzUint(n)
+		}
+	case hzKDouble:
+		switch v.k {
+		case hzKDouble:
+			return v
+		case hzKInt:
+			return hzDouble(float64(v.i))
+		case hzKUint:
+			return hzDouble(float64(v.u))
+		case hzKString:
+			n, err := strconv.ParseFloat(v.s, 64)
+			if err != nil {
+				return hzErr("conversion parse")
+			}
+			return hzDouble(n)
+		}
+	case hzKString:
+		switch v.k {
+		case hzKString:
+			return v
+		case hzKInt:
+			return hzStr(strconv.FormatInt(v.i, 10))
+		case hzKUint:
+			return hzStr(strconv.FormatUint(v.u, 10))
+		case hzKDouble:
+			return hzStr(fmt.Sprintf("%g", v.d))
+		case hzKBool:
+			return hzStr(strconv.FormatBool(v.bo))
+		case hzKBytes:
+			if !utf8.Valid(v.b) {
+				return hzErr("invalid utf-8")
+			}
+			return hzStr(string(v.b))
+		}
+	case hzKBytes:
+		switch v.k {
+		case hzKBytes:
+			return v
+		case hzKString:
+			return hzBytes([]byte(v.s))
+		}
+	case hzKBool:
+		switch v.k {
+		case hzKBool:
+			return v
+		case hzKString:
+			b, err := strconv.ParseBool(v.s)
+			if err != nil {
+				return hzErr("conversion parse")
+			}
+			return hzBool(b)
+		}
+	}
+	return hzErr("no such overload")
+}
+
+// hzConvFrom: the types a conversion to t accepts (the identity last).
+func hzConvFrom(t hzType) []hzType {
+	switch t.k {
+	case hzKInt:
+		return []hzType{hzTUint, hzTDouble, hzTString, hzTInt}
+	case hzKUint:
+		return []hzType{hzTInt, hzTDouble, hzTString, hzTUint}
+	case hzKDouble:
+		return []hzType{hzTInt, hzTUint, hzTString, hzTDouble}
+	case hzKString:
+		return []hzType{hzTInt, hzTUint, hzTDouble, hzTBool, hzTBytes, hzTString}
+	case hzKBytes:
+		return []hzType{hzTString, hzTBytes}
+	}
+	return []hzType{hzTString, hzTBool}
+}
+
+// --------------------------------------------------------------------------- expression trees
+
+// Binding levels of the grammar, high binds tight.
+const (
+	hzPrecPrimary = 100
+	hzPrecUnary   = 90
+	hzPrecMul     = 80
+	hzPrecAdd     = 70
+	hzPrecRel     = 60
+	hzPrecAnd     = 50
+	hzPrecOr      = 40
+	hzPrecCond    = 30
+)
+
+type hzNKind int
+
+const (
+	hzNLit    hzNKind = iota // a literal of a scalar type (v)
+	hzNVar                   // a variable (name)
+	hzNList                  // a list literal (args: the elements)
+	hzNMap                   // a map literal (args: key, value, key, value, ...)
+	hzNNeg                   // -e
+	hzNNot                   // !e, or !!e (n = 2)
+	hzNBin                   // a op b (name: + - * / % == != < <= > >= && || in; for `in` the needle then the haystack)
+	hzNCond                  // c ? a : b
+	hzNIndex                 // agg[key]
+	hzNSize                  // size(e) or e.size()
+	hzNConv                  // t(e)
+	hzNStrFn                 // s.fn(arg) (name: contains, startsWith, endsWith, matches)
+	hzNMacro                 // rng.name(x, ...) (macro; args: the range)
+	hzNPick                  // the key or needle: the n-th element (modulo) of the sibling aggregate as a literal, or the type's zero when it has none
+	hzNPos                   // the index into the sibling list: n modulo its size plus one (so one position past the end is drawn too) as an int literal
+	hzNSubstr                // the argument of a string function: the substring [n, m] (positions modulo) of the sibling string as a literal
+)
+
+// hzNode is a node of a generated expression, typed by construction.
+type hzNode struct {
+	kind  hzNKind
+	t     hzType
+	v     hzVal
+	name  string
+	n, m  int
+	args  []*hzNode
+	macro *hzMacro
+}
+
+func hzLit(v hzVal) *hzNode { return &hzNode{kind: hzNLit, t: hzTypeOfVal(v), v: v} }
+
+func hzVarNode(name string) *hzNode {
+	for _, d := range hzVarDecls {
+		if d.name == name {
+			return &hzNode{kind: hzNVar, t: d.t, name: name}
+		}
+	}
+	panic("hzVarNode: no variable " + name)
+}
+
+func hzListNode(t hzType, elems []*hzNode) *hzNode {
+	return &hzNode{kind: hzNList, t: t, args: nonNil(elems)}
+}
+
+func hzMapNode(t hzType, entries []pair[*hzNode, *hzNode]) *hzNode {
+	n := &hzNode{kind: hzNMap, t: t, args: []*hzNode{}}
+	for _, e := range entries {
+		n.args = append(n.args, e.a, e.b)
+	}
+	return n
+}
+
+func hzNegNode(e *hzNode) *hzNode { return &hzNode{kind: hzNNeg, t: e.t, args: []*hzNode{e}} }
+
+func hzNotNode(e *hzNode, bangs int) *hzNode {
+	return &hzNode{kind: hzNNot, t: hzTBool, n: bangs, args: []*hzNode{e}}
+}
+
+func hzBinNode(op string, a, b *hzNode) *hzNode {
+	t := a.t
+	switch op {
+	case "==", "!=", "<", "<=", ">", ">=", "&&", "||", "in":
+		t = hzTBool
+	}
+	return &hzNode{kind: hzNBin, t: t, name: op, args: []*hzNode{a, b}}
+}
+
+func hzCondNode(c, a, b *hzNode) *hzNode {
+	return &hzNode{kind: hzNCond, t: a.t, args: []*hzNode{c, a, b}}
+}
+
+func hzIndexNode(agg, key *hzNode) *hzNode {
+	return &hzNode{kind: hzNIndex, t: hzIndexedOf(agg.t), args: []*hzNode{agg, key}}
+}
+
+func hzSizeNode(e *hzNode) *hzNode { return &hzNode{kind: hzNSize, t: hzTInt, args: []*hzNode{e}} }
+
+func hzConvNode(t hzType, e *hzNode) *hzNode { return &hzNode{kind: hzNConv, t: t, args: []*hzNode{e}} }
+
+func hzStrFnNode(fn string, s, arg *hzNode) *hzNode {
+	return &hzNode{kind: hzNStrFn, t: hzTBool, name: fn, args: []*hzNode{s, arg}}
+}
+
+func hzPickNode(t hzType, n int) *hzNode { return &hzNode{kind: hzNPick, t: t, n: n} }
+
+func hzPosNode(n int) *hzNode { return &hzNode{kind: hzNPos, t: hzTInt, n: n} }
+
+func hzSubstrNode(i, j int) *hzNode { return &hzNode{kind: hzNSubstr, t: hzTString, n: i, m: j} }
+
+// hzPrecOf is the binding level of the node's text.
+func hzPrecOf(n *hzNode) int {
+	switch n.kind {
+	case hzNNeg, hzNNot:
+		return hzPrecUnary
+	case hzNBin:
+		switch n.name {
+		case "*", "/", "%":
+			return hzPrecMul
+		case "+", "-":
+			return hzPrecAdd
+		case "&&":
+			return hzPrecAnd
+		case "||":
+			return hzPrecOr
+		}
+		return hzPrecRel
+	case hzNCond:
+		return hzPrecCond
+	}
+	return hzPrecPrimary
+}
+
+// hzAny reports whether pred holds of the node or of any node below it.
+func hzAny(n *hzNode, pred func(*hzNode) bool) bool {
+	if pred(n) {
+		return true
+	}
+	for _, a := range n.args {
+		if hzAny(a, pred) {
+			return true
+		}
+	}
+	return false
+}
+
+// hzEmptyLit reports whether the node is an empty list or map literal, or a conditional or a
+// concatenation of two (its element type is unresolved for the checker: cel-go/3).
+func hzEmptyLit(n *hzNode) bool {
+	switch n.kind {
+	case hzNList, hzNMap:
+		return len(n.args) == 0
+	case hzNCond:
+		return hzEmptyLit(n.args[1]) && hzEmptyLit(n.args[2])
+	case hzNBin:
+		return n.name == "+" && hzEmptyLit(n.args[0]) && hzEmptyLit(n.args[1])
+	}
+	return false
+}
+
+// hzHasVar reports whether the value of the subtree depends on the bindings (a macro's
+// templates may read them).
+func hzHasVar(n *hzNode) bool {
+	return hzAny(n, func(x *hzNode) bool { return x.kind == hzNVar || x.kind == hzNMacro })
+}
+
+// hzHasConstIn reports whether an `in` over a constant haystack occurs: the shape OptOptimize
+// and constant folding rewrite, dropping the needle's error (cel-go/4).
+func hzHasConstIn(n *hzNode) bool {
+	return hzAny(n, func(x *hzNode) bool { return x.kind == hzNBin && x.name == "in" && !hzHasVar(x.args[1]) })
+}
+
+// hzIndexesEmptyLit reports whether an index or a macro range is an empty literal (cel-go/3).
+func hzIndexesEmptyLit(n *hzNode) bool {
+	return hzAny(n, func(x *hzNode) bool { return (x.kind == hzNIndex || x.kind == hzNMacro) && hzEmptyLit(x.args[0]) })
+}
+
+// hzRepeatedKey reports whether a map literal has two keys that evaluate equal (cel-go/5).
+func hzRepeatedKey(n *hzNode, env hzVars) bool {
+	return hzAny(n, func(x *hzNode) bool {
+		if x.kind != hzNMap {
+			return false
+		}
+		seen := hzVal{k: hzKMap}
+		for i := 0; i+1 < len(x.args); i += 2 {
+			k := hzEvalNode(x.args[i], env)
+			if k.isErr() {
+				continue
+			}
+			if hzMapFind(seen, k) >= 0 {
+				return true
+			}
+			seen.keys = append(seen.keys, k)
+		}
+		return false
+	})
+}
+
+// hzDropRepeatedKeys is the tree with every map entry whose key evaluates equal to an earlier
+// key of its literal left out (the shape of cel-go/5, left out under HEGEL_NO_KNOWN=1).
+func hzDropRepeatedKeys(n *hzNode, env hzVars) *hzNode {
+	out := *n
+	out.args = make([]*hzNode, 0, len(n.args))
+	for _, a := range n.args {
+		out.args = append(out.args, hzDropRepeatedKeys(a, env))
+	}
+	if n.kind != hzNMap {
+		return &out
+	}
+	entries := out.args
+	out.args = []*hzNode{}
+	seen := hzVal{k: hzKMap}
+	for i := 0; i+1 < len(entries); i += 2 {
+		k := hzEvalNode(entries[i], env)
+		if !k.isErr() {
+			if hzMapFind(seen, k) >= 0 {
+				continue
+			}
+			seen.keys = append(seen.keys, k)
+		}
+		out.args = append(out.args, entries[i], entries[i+1])
+	}
+	return &out
+}
+
+// --------------------------------------------------------------------------- bindings
+
+type hzVar struct {
+	name string
+	t    hzType
+	v    hzVal
+}
+
+// hzVars is the variable bindings of a case.
+type hzVars []hzVar
+
+func (e hzVars) get(name string) hzVal {
+	for _, v := range e {
+		if v.name == name {
+			return v.v
+		}
+	}
+	return hzErr("unbound " + name)
+}
+
+var hzVarDecls = []hzVar{
+	{name: "i1", t: hzTInt}, {name: "i2", t: hzTInt}, {name: "u1", t: hzTUint}, {name: "d1", t: hzTDouble},
+	{name: "s1", t: hzTString}, {name: "s2", t: hzTString}, {name: "by1", t: hzTBytes}, {name: "b1", t: hzTBool},
+	{name: "li", t: hzTLInt}, {name: "ls", t: hzTLStr}, {name: "ms", t: hzTMSI}, {name: "mi", t: hzTMIS},
+}
+
+// hzGoValue converts a model value to the Go value an activation takes.
+func hzGoValue(v hzVal) any {
+	switch v.k {
+	case hzKInt:
+		return v.i
+	case hzKUint:
+		return v.u
+	case hzKDouble:
+		return v.d
+	case hzKString:
+		return v.s
+	case hzKBytes:
+		return v.b
+	case hzKBool:
+		return v.bo
+	case hzKList:
+		out := make([]any, len(v.list))
+		for i, e := range v.list {
+			out[i] = hzGoValue(e)
+		}
+		return out
+	case hzKMap:
+		out := map[any]any{}
+		for i := range v.keys {
+			out[hzGoValue(v.keys[i])] = hzGoValue(v.vals[i])
+		}
+		return out
+	}
+	return nil
+}
+
+func (e hzVars) activation() map[string]any {
+	m := map[string]any{}
+	for _, v := range e {
+		m[v.name] = hzGoValue(v.v)
+	}
+	return m
+}
+
+func (e hzVars) describe() string {
+	var sb strings.Builder
+	for _, v := range e {
+		fmt.Fprintf(&sb, "%s = %s; ", v.name, v.v.String())
+	}
+	return sb.String()
+}
+
+// --------------------------------------------------------------------------- pools
+
+var hzInterestingInts = []int64{0, 1, -1, 2, -2, 7, 10, 100, 255, 256, -128, 1000, 65536, math.MaxInt64, math.MinInt64, math.MaxInt64 - 1, math.MinInt64 + 1, 4294967296, 3037000499, -3037000499}
+var hzInterestingUints = []uint64{0, 1, 2, 7, 10, 255, 256, 65536, math.MaxUint64, math.MaxUint64 - 1, 1 << 63, (1 << 63) - 1, 4294967296}
+var hzInterestingDoubles = []float64{0, 1, -1, 0.5, -0.5, 1.5, 2.5, 3.14, 1e3, 1e10, 1e18, 1e19, 9.223372036854775807e18, -9.223372036854775808e18, 1.8446744073709552e19, 1e300, 1e-300, 4.9e-324, 1.7976931348623157e308, 123456789.125}
+var hzStringPool = []string{"", "a", "b", "abc", "ABC", "hello", "world", "hello world", "Hello, World!", "0", "1", "-1", "+5", "42", "3.14", "1e3", "0x1F", " 7", "7 ", "true", "false", "True", "TRUE", "t", "f", "T", "F", "yes", "no", "on", "off", "1.0", "inf", "-Inf", "NaN", "nan", "Infinity", "1_000", "٣", "é", "fiancé", "日本語", "😀", "a\nb", "tab\there", "quote'", "dquote\"", "back\\slash", "null", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "18446744073709551615", "18446744073709551616", "-0", "00", "007", "0b101", "1e400", "-1e400", ".5", "5.", "0x", "", "a.b", "a*b", "[a]", "(a)", "^a$", "a|b"}
+var hzRunes = []rune{'a', 'b', 'z', 'A', 'Z', '0', '9', ' ', '.', ',', '\'', '"', '\\', '\n', '\t', '/', '*', '?', '[', ']', '{', '}', '$', '^', '\u00e9', '\u00df', '\u65e5', '\U0001F600', '\u0301', 0x7f, '\u00a0', '\u2028', '\ufeff', '\u01c5', '\u0130', '\u0131'}
+var hzPatterns = []string{"", "a", "^a", "a$", "^$", "^.*$", "[a-z]+", "\\d+", "^\\d+$", "(?i)hello", "h.llo", "a|b", "^[A-Z]", "\\s", "\\p{L}", "^\\p{L}+$", "(a)(b)", "x*", ".", "\\.", "\\\\", "[", "(", "*a", "a{2}", "(?P<n>a)", "\\u0301", "é", "日"}
+
+// hzNumLit matches the source of a numeric literal (with an optional leading minus).
+var hzNumLit = regexp.MustCompile(`^-?\s*(0[xX][0-9a-fA-F]+|[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?|[0-9]+\.([eE][+-]?[0-9]+)?)[uU]?$`)
+
+func hzIdentChar(r byte) bool {
+	return r == '_' || (r >= '0' && r <= '9') || (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z')
+}
+
+// --------------------------------------------------------------------------- the model
+
+// hzEvalNode is the specification's value of the tree under the bindings (an error is a value
+// of the error kind).
+func hzEvalNode(n *hzNode, env hzVars) hzVal {
+	switch n.kind {
+	case hzNLit:
+		return n.v
+	case hzNVar:
+		return env.get(n.name)
+	case hzNList:
+		v := hzVal{k: hzKList, list: []hzVal{}}
+		for _, e := range n.args {
+			v.list = append(v.list, hzEvalNode(e, env))
+		}
+		for _, x := range v.list {
+			if x.isErr() {
+				return x
+			}
+		}
+		return v
+	case hzNMap:
+		v := hzVal{k: hzKMap, keys: []hzVal{}, vals: []hzVal{}}
+		var errv *hzVal
+		for i := 0; i+1 < len(n.args); i += 2 {
+			k, e := hzEvalNode(n.args[i], env), hzEvalNode(n.args[i+1], env)
+			switch {
+			case k.isErr():
+				if errv == nil {
+					errv = &k
+				}
+			case e.isErr():
+				if errv == nil {
+					errv = &e
+				}
+			case hzMapFind(v, k) >= 0:
+				// a repeated key is an error by the specification; cel-go keeps the last entry (cel-go/5)
+				if errv == nil {
+					ev := hzErr("duplicate key")
+					errv = &ev
+				}
+			default:
+				v.keys = append(v.keys, k)
+				v.vals = append(v.vals, e)
+			}
+		}
+		if errv != nil {
+			return *errv
+		}
+		return v
+	case hzNNeg:
+		e := hzEvalNode(n.args[0], env)
+		switch {
+		case e.isErr():
+			return e
+		case e.k == hzKInt:
+			return hzNegInt(e.i)
+		}
+		return hzDouble(-e.d)
+	case hzNNot:
+		e := hzEvalNode(n.args[0], env)
+		if e.isErr() {
+			return e
+		}
+		b := e.bo
+		for i := 0; i < n.n; i++ {
+			b = !b
+		}
+		return hzBool(b)
+	case hzNBin:
+		return hzEvalBin(n, env)
+	case hzNCond:
+		c := hzEvalNode(n.args[0], env)
+		switch {
+		case c.isErr():
+			return c
+		case c.bo:
+			return hzEvalNode(n.args[1], env)
+		}
+		return hzEvalNode(n.args[2], env)
+	case hzNIndex:
+		agg := hzEvalNode(n.args[0], env)
+		key := hzEvalOperand(n.args[1], agg, env)
+		switch {
+		case agg.isErr():
+			return agg
+		case key.isErr():
+			return key
+		case agg.k == hzKList:
+			if key.i < 0 || key.i >= int64(len(agg.list)) {
+				return hzErr("index out of range")
+			}
+			return agg.list[key.i]
+		}
+		if j := hzMapFind(agg, key); j >= 0 {
+			return agg.vals[j]
+		}
+		return hzErr("no such key")
+	case hzNSize:
+		e := hzEvalNode(n.args[0], env)
+		switch e.k {
+		case hzKString:
+			return hzInt(int64(utf8.RuneCountInString(e.s)))
+		case hzKBytes:
+			return hzInt(int64(len(e.b)))
+		case hzKList:
+			return hzInt(int64(len(e.list)))
+		case hzKMap:
+			return hzInt(int64(len(e.keys)))
+		}
+		return e
+	case hzNConv:
+		return hzConvert(n.t, hzEvalNode(n.args[0], env))
+	case hzNStrFn:
+		s := hzEvalNode(n.args[0], env)
+		arg := hzEvalOperand(n.args[1], s, env)
+		switch {
+		case s.isErr():
+			return s
+		case arg.isErr():
+			return arg
+		}
+		switch n.name {
+		case "contains":
+			return hzBool(strings.Contains(s.s, arg.s))
+		case "startsWith":
+			return hzBool(strings.HasPrefix(s.s, arg.s))
+		case "endsWith":
+			return hzBool(strings.HasSuffix(s.s, arg.s))
+		}
+		re, err := regexp.Compile(arg.s)
+		if err != nil {
+			return hzErr("bad pattern")
+		}
+		return hzBool(re.MatchString(s.s))
+	case hzNMacro:
+		return hzEvalMacro(n, env)
+	}
+	return hzErr("no value")
+}
+
+// hzEvalOperand is the value of a key, needle or argument node, which may be derived from its
+// sibling's value (hzNPick, hzNSubstr).
+func hzEvalOperand(n *hzNode, sibling hzVal, env hzVars) hzVal {
+	switch n.kind {
+	case hzNPick:
+		return hzPickValue(sibling, n.n, n.t)
+	case hzNPos:
+		return hzPosValue(sibling, n.n)
+	case hzNSubstr:
+		return hzSubstrValue(sibling, n.n, n.m)
+	}
+	return hzEvalNode(n, env)
+}
+
+// hzPickValue is the n-th (modulo) element of a list or key of a map, or the type's zero when
+// the aggregate has none or is an error.
+func hzPickValue(agg hzVal, n int, t hzType) hzVal {
+	elems := agg.list
+	if agg.k == hzKMap {
+		elems = agg.keys
+	}
+	if agg.isErr() || len(elems) == 0 {
+		return hzZero(t)
+	}
+	return elems[n%len(elems)]
+}
+
+// hzPosValue is the n-th position of the list modulo its size plus one; 0 for an error.
+func hzPosValue(list hzVal, n int) hzVal {
+	if list.isErr() {
+		return hzInt(0)
+	}
+	return hzInt(int64(n % (len(list.list) + 1)))
+}
+
+// hzSubstrValue is the substring of s from position i (modulo the length plus one) of j
+// (modulo the rest plus one) code points; "" for an error.
+func hzSubstrValue(s hzVal, i, j int) hzVal {
+	if s.isErr() {
+		return hzStr("")
+	}
+	rs := []rune(s.s)
+	i %= len(rs) + 1
+	j = i + j%(len(rs)-i+1)
+	return hzStr(string(rs[i:j]))
+}
+
+func hzEvalBin(n *hzNode, env hzVars) hzVal {
+	op := n.name
+	if op == "in" {
+		agg := hzEvalNode(n.args[1], env)
+		e := hzEvalOperand(n.args[0], agg, env)
+		switch {
+		case e.isErr():
+			return e
+		case agg.isErr():
+			return agg
+		case agg.k == hzKList:
+			for _, x := range agg.list {
+				if hzEqual(x, e) {
+					return hzBool(true)
+				}
+			}
+			return hzBool(false)
+		}
+		return hzBool(hzMapFind(agg, e) >= 0)
+	}
+	a, b := hzEvalNode(n.args[0], env), hzEvalNode(n.args[1], env)
+	switch op {
+	case "&&":
+		return hzAnd(a, b)
+	case "||":
+		return hzOr(a, b)
+	}
+	switch {
+	case a.isErr():
+		return a
+	case b.isErr():
+		return b
+	}
+	switch op {
+	case "==":
+		return hzBool(hzEqual(a, b))
+	case "!=":
+		return hzBool(!hzEqual(a, b))
+	case "<", "<=", ">", ">=":
+		c, ok := hzCompare(a, b)
+		if !ok {
+			// IEEE: every ordering of a NaN is false (the standard library's operators say so
+			// explicitly; the algebraic law `e1 <= e2` == `!(e1 > e2)` of the specification does
+			// not hold for NaN and is not judged)
+			return hzBool(false)
+		}
+		switch op {
+		case "<":
+			return hzBool(c < 0)
+		case "<=":
+			return hzBool(c <= 0)
+		case ">":
+			return hzBool(c > 0)
+		}
+		return hzBool(c >= 0)
+	}
+	switch a.k {
+	case hzKInt:
+		switch op {
+		case "+":
+			return hzAddInt(a.i, b.i)
+		case "-":
+			return hzSubInt(a.i, b.i)
+		case "*":
+			return hzMulInt(a.i, b.i)
+		case "/":
+			return hzDivInt(a.i, b.i)
+		}
+		return hzModInt(a.i, b.i)
+	case hzKUint:
+		switch op {
+		case "+":
+			return hzAddUint(a.u, b.u)
+		case "-":
+			return hzSubUint(a.u, b.u)
+		case "*":
+			return hzMulUint(a.u, b.u)
+		case "/":
+			return hzDivUint(a.u, b.u)
+		}
+		return hzModUint(a.u, b.u)
+	case hzKDouble:
+		switch op {
+		case "+":
+			return hzDouble(a.d + b.d)
+		case "-":
+			return hzDouble(a.d - b.d)
+		case "*":
+			return hzDouble(a.d * b.d)
+		}
+		return hzDouble(a.d / b.d)
+	case hzKString:
+		return hzStr(a.s + b.s)
+	case hzKBytes:
+		return hzBytes(append(append([]byte{}, a.b...), b.b...))
+	case hzKList:
+		return hzVal{k: hzKList, list: append(append([]hzVal{}, a.list...), b.list...)}
+	}
+	return hzErr("no such overload")
+}
+
+// --------------------------------------------------------------------------- the text
+
+// hzInSpacing is how the text spaces a numeric literal from a following `in`.
+type hzInSpacing int
+
+const (
+	hzInTape   hzInSpacing = iota // the tape's whitespace, so the literal is glued to `in` some of the time (the shape of cel-go/1)
+	hzInGlued                     // always glued
+	hzInSpaced                    // always a space
+)
+
+// hzInDefault: how the wide properties space `in`: by the tape, so the shape of cel-go/1 is
+// drawn at its natural rate; a space under HEGEL_NO_KNOWN=1.
+var hzInDefault = shaped(hzInTape, hzInSpaced)
+
+// hzRenderer writes the text of a tree, reading its free choices from the tape. With unsigned
+// it writes no negative numeric literal (the magnitude instead, and -(1) for a negated one):
+// the text of a parser comparison under HEGEL_NO_KNOWN=1, past the shape of cel-go/2.
+type hzRenderer struct {
+	t        *tape
+	env      hzVars
+	in       hzInSpacing
+	unsigned bool
+}
+
+func hzRender(n *hzNode, env hzVars, tp []int, in hzInSpacing, unsigned bool) string {
+	r := &hzRenderer{t: &tape{vals: tp}, env: env, in: in, unsigned: unsigned}
+	return r.expr(n)
+}
+
+// hzNonNegative is the value with a non-negative, finite magnitude (a literal without a minus).
+func hzNonNegative(v hzVal) hzVal {
+	switch v.k {
+	case hzKInt:
+		if v.i == math.MinInt64 {
+			return hzInt(math.MaxInt64)
+		}
+		if v.i < 0 {
+			return hzInt(-v.i)
+		}
+	case hzKDouble:
+		if math.IsNaN(v.d) || math.IsInf(v.d, 0) {
+			return hzDouble(1.5)
+		}
+		return hzDouble(math.Abs(v.d))
+	}
+	return v
+}
+
+// ws is inter-token whitespace (mostly none or one space).
+func (r *hzRenderer) ws() string {
+	switch r.t.next(20) {
+	case 12, 13, 14, 15, 16:
+		return " "
+	case 17:
+		return "  "
+	case 18:
+		return "\t"
+	case 19:
+		return "\n"
+	}
+	return ""
+}
+
+func (r *hzRenderer) parens(s string) string { return "(" + r.ws() + s + r.ws() + ")" }
+
+// primary wraps an operand that a member access or index applies to.
+func (r *hzRenderer) primary(n *hzNode) string {
+	s := r.expr(n)
+	if hzPrecOf(n) < hzPrecPrimary || r.t.coin(10) {
+		return r.parens(s)
+	}
+	return s
+}
+
+// operand is the text of a key, needle or argument, a derived one as the literal of its value.
+func (r *hzRenderer) operand(n, sibling *hzNode) string {
+	switch n.kind {
+	case hzNPick, hzNPos, hzNSubstr:
+		return r.lit(hzEvalOperand(n, hzEvalNode(sibling, r.env), r.env))
+	}
+	return r.expr(n)
+}
+
+func (r *hzRenderer) expr(n *hzNode) string {
+	switch n.kind {
+	case hzNLit:
+		return r.lit(n.v)
+	case hzNVar:
+		return n.name
+	case hzNList:
+		parts := make([]string, len(n.args))
+		for i, e := range n.args {
+			parts[i] = r.expr(e)
+		}
+		return r.aggregate("[", "]", parts)
+	case hzNMap:
+		var parts []string
+		for i := 0; i+1 < len(n.args); i += 2 {
+			parts = append(parts, r.expr(n.args[i])+r.ws()+":"+r.ws()+r.expr(n.args[i+1]))
+		}
+		return r.aggregate("{", "}", parts)
+	case hzNNeg:
+		s := r.expr(n.args[0])
+		// (the parser folds --5 to 5 and -(-(0)) to -(-0): a negated operand is parenthesized)
+		if hzPrecOf(n.args[0]) < hzPrecUnary || strings.HasPrefix(s, "-") || (r.unsigned && n.args[0].kind == hzNLit) || r.t.coin(10) {
+			s = r.parens(s)
+		}
+		return "-" + r.ws() + s
+	case hzNNot:
+		s := r.expr(n.args[0])
+		if hzPrecOf(n.args[0]) < hzPrecUnary || r.t.coin(10) {
+			s = r.parens(s)
+		}
+		return strings.Repeat("!", n.n) + r.ws() + s
+	case hzNBin:
+		return r.bin(n)
+	case hzNCond:
+		cs := r.expr(n.args[0])
+		if hzPrecOf(n.args[0]) <= hzPrecCond || r.t.coin(10) {
+			cs = r.parens(cs)
+		}
+		as := r.expr(n.args[1])
+		if hzPrecOf(n.args[1]) <= hzPrecCond || r.t.coin(10) {
+			as = r.parens(as)
+		}
+		bs := r.expr(n.args[2])
+		if r.t.coin(10) {
+			bs = r.parens(bs)
+		}
+		return cs + r.ws() + "?" + r.ws() + as + r.ws() + ":" + r.ws() + bs
+	case hzNIndex:
+		agg := r.primary(n.args[0])
+		key := r.operand(n.args[1], n.args[0])
+		ws := r.ws()
+		return agg + ws + "[" + ws + key + ws + "]"
+	case hzNSize:
+		return r.call("size", n.args[0], nil)
+	case hzNConv:
+		ws := r.ws()
+		return n.t.String() + ws + "(" + ws + r.expr(n.args[0]) + ws + ")"
+	case hzNStrFn:
+		arg := r.operand(n.args[1], n.args[0])
+		if n.name == "matches" {
+			return r.call("matches", n.args[0], []string{arg})
+		}
+		// contains/startsWith/endsWith exist as member functions only
+		ws := r.ws()
+		return r.primary(n.args[0]) + ws + "." + ws + n.name + ws + "(" + ws + arg + ws + ")"
+	case hzNMacro:
+		return r.macro(n)
+	}
+	panic("hzRenderer.expr: a derived operand outside its context")
+}
+
+// aggregate writes a list or map literal, with a trailing comma some of the time.
+func (r *hzRenderer) aggregate(open, close string, parts []string) string {
+	s := open + r.ws() + strings.Join(parts, ","+r.ws())
+	if len(parts) > 0 && r.t.coin(15) {
+		s += ","
+	}
+	return s + r.ws() + close
+}
+
+// call writes fn(target, args...) or target.fn(args...).
+func (r *hzRenderer) call(fn string, target *hzNode, args []string) string {
+	ws := r.ws()
+	if r.t.coin(50) {
+		return r.primary(target) + ws + "." + ws + fn + ws + "(" + ws + strings.Join(args, ","+r.ws()) + ws + ")"
+	}
+	parts := append([]string{r.expr(target)}, args...)
+	return fn + ws + "(" + ws + strings.Join(parts, ","+r.ws()) + ws + ")"
+}
+
+// bin writes `a op b` with the grammar's binding levels (left associative).
+func (r *hzRenderer) bin(n *hzNode) string {
+	op, prec := n.name, hzPrecOf(n)
+	a, b := n.args[0], n.args[1]
+	as := r.operand(a, b) // an `in` needle may be an element of the haystack
+	if hzPrecOf(a) < prec || r.t.coin(10) {
+		as = r.parens(as)
+	}
+	bs := r.expr(b)
+	if hzPrecOf(b) <= prec || r.t.coin(10) {
+		bs = r.parens(bs)
+	}
+	before, after := r.ws(), r.ws()
+	if op == "in" {
+		// `in` is a keyword: glued to an identifier on either side it becomes part of the
+		// identifier (both parsers); glued to a numeric literal on its left the grammar's lexer
+		// still separates it, the Pratt lexer does not (cel-go/1)
+		if after == "" && len(bs) > 0 && hzIdentChar(bs[0]) {
+			after = " "
+		}
+		if len(as) > 0 && hzIdentChar(as[len(as)-1]) {
+			switch {
+			case !hzNumLit.MatchString(as):
+				if before == "" {
+					before = " "
+				}
+			case r.in == hzInGlued:
+				before = ""
+			case r.in == hzInSpaced && before == "":
+				before = " "
+			}
+		}
+	}
+	return as + before + op + after + bs
+}
+
+// lit writes a scalar value as a literal in one of the spellings of the grammar.
+func (r *hzRenderer) lit(v hzVal) string {
+	if r.unsigned {
+		v = hzNonNegative(v)
+	}
+	switch v.k {
+	case hzKInt:
+		return r.intLit(v.i)
+	case hzKUint:
+		return r.uintLit(v.u)
+	case hzKDouble:
+		return r.doubleLit(v.d)
+	case hzKString:
+		return r.str(v.s)
+	case hzKBytes:
+		return r.bytesLit(v.b)
+	case hzKBool:
+		return strconv.FormatBool(v.bo)
+	}
+	panic("hzRenderer.lit: not a scalar value " + v.String())
+}
+
+func (r *hzRenderer) intLit(i int64) string {
+	if i == math.MinInt64 {
+		if r.t.coin(30) {
+			return "-0x8000000000000000"
+		}
+		return "-9223372036854775808"
+	}
+	a := i
+	if a < 0 {
+		a = -a
+	}
+	s := strconv.FormatInt(a, 10)
+	if r.t.coin(25) {
+		s = fmt.Sprintf("0x%X", a)
+		if r.t.coin(50) {
+			s = fmt.Sprintf("0x%x", a)
+		}
+	}
+	if i < 0 {
+		s = "-" + r.ws() + s
+	}
+	return s
+}
+
+func (r *hzRenderer) uintLit(u uint64) string {
+	s := strconv.FormatUint(u, 10)
+	if r.t.coin(25) {
+		s = fmt.Sprintf("0x%x", u)
+	}
+	if r.t.coin(30) {
+		return s + "U"
+	}
+	return s + "u"
+}
+
+// doubleLit renders a double so that it parses back to the same value; infinities and NaN
+// have no literal (1e400 is rejected by the parser) and come from 1.0/0.0 and 0.0/0.0.
+func (r *hzRenderer) doubleLit(d float64) string {
+	switch {
+	case math.IsNaN(d):
+		return "(0.0/0.0)"
+	case math.IsInf(d, 1):
+		return "(1.0/0.0)"
+	case math.IsInf(d, -1):
+		return "(-1.0/0.0)"
+	}
+	neg := math.Signbit(d)
+	a := math.Abs(d)
+	s := strconv.FormatFloat(a, 'g', -1, 64)
+	switch r.t.next(6) {
+	case 1:
+		s = strconv.FormatFloat(a, 'e', -1, 64) // 1.5e+00
+	case 2:
+		s = strconv.FormatFloat(a, 'E', -1, 64)
+	case 3:
+		if a == math.Trunc(a) && a < 1e15 {
+			s = strconv.FormatFloat(a, 'f', -1, 64) + ".0" // 12.0 (the grammar has no `12.`)
+		}
+	case 4:
+		if a < 1 && a > 0 {
+			s = strings.TrimPrefix(strconv.FormatFloat(a, 'f', -1, 64), "0") // .5
+		}
+	}
+	if !strings.ContainsAny(s, ".eE") {
+		s += ".0"
+	}
+	if neg {
+		s = "-" + r.ws() + s
+	}
+	return s
+}
+
+// str renders a string in one of the literal forms of the grammar.
+func (r *hzRenderer) str(s string) string {
+	q := "\""
+	if r.t.coin(40) {
+		q = "'"
+	}
+	if r.t.coin(15) {
+		q = q + q + q
+	}
+	if r.t.coin(20) && !strings.ContainsAny(s, "\\\n\r"+q[:1]) {
+		p := "r"
+		if r.t.coin(30) {
+			p = "R"
+		}
+		return p + q + s + q
+	}
+	var sb strings.Builder
+	sb.WriteString(q)
+	for _, c := range s {
+		switch {
+		case c == '\\':
+			sb.WriteString(`\\`)
+		case c == '\n':
+			if len(q) == 3 && r.t.coin(50) {
+				sb.WriteRune('\n')
+			} else {
+				sb.WriteString(`\n`)
+			}
+		case c == '\t':
+			sb.WriteString([]string{`\t`, `\x09`, `\011`}[r.t.next(3)])
+		case string(c) == q[:1]:
+			// always escaped: inside '''...''' a quote at the end would close the literal early
+			sb.WriteString(`\` + string(c))
+		case c == '\'' || c == '"':
+			if r.t.coin(50) {
+				sb.WriteString(`\` + string(c))
+			} else {
+				sb.WriteRune(c)
+			}
+		case c < 0x20 || c == 0x7f:
+			sb.WriteString(fmt.Sprintf(`\x%02x`, c))
+		case c >= 0x80 && r.t.coin(50):
+			if c > 0xffff || r.t.coin(30) {
+				sb.WriteString(fmt.Sprintf(`\U%08X`, c))
+			} else {
+				sb.WriteString(fmt.Sprintf(`\u%04x`, c))
+			}
+		case c < 0x80 && r.t.coin(5):
+			sb.WriteString(fmt.Sprintf(`\%03o`, c))
+		default:
+			sb.WriteRune(c)
+		}
+	}
+	sb.WriteString(q)
+	return sb.String()
+}
+
+func (r *hzRenderer) bytesLit(b []byte) string {
+	q := "\""
+	if r.t.coin(40) {
+		q = "'"
+	}
+	var sb strings.Builder
+	if r.t.coin(30) {
+		sb.WriteString("B")
+	} else {
+		sb.WriteString("b")
+	}
+	sb.WriteString(q)
+	for _, c := range b {
+		switch {
+		case c == '\\':
+			sb.WriteString(`\\`)
+		case c == q[0]:
+			sb.WriteString(`\` + string(rune(c)))
+		case c >= 0x20 && c < 0x7f && r.t.coin(80):
+			sb.WriteByte(c)
+		case r.t.coin(20):
+			sb.WriteString(fmt.Sprintf(`\%03o`, c))
+		default:
+			sb.WriteString(fmt.Sprintf(`\x%02x`, c))
+		}
+	}
+	sb.WriteString(q)
+	return sb.String()
+}
+
+// --------------------------------------------------------------------------- values, drawn
+
+var (
+	hzIntVals = weighted(
+		choice[hzVal]{60, hegel.Map(hegel.SampledFrom(hzInterestingInts), hzInt)},
+		choice[hzVal]{20, hegel.Map(hegel.Integers[int64](-1000, 1000), hzInt)},
+		choice[hzVal]{20, hegel.Map(hegel.Integers[int64](math.MinInt64, math.MaxInt64), hzInt)},
+	)
+	hzUintVals = weighted(
+		choice[hzVal]{60, hegel.Map(hegel.SampledFrom(hzInterestingUints), hzUint)},
+		choice[hzVal]{20, hegel.Map(hegel.Integers[uint64](0, 1000), hzUint)},
+		choice[hzVal]{20, hegel.Map(hegel.Integers[uint64](0, math.MaxUint64), hzUint)},
+	)
+	// hzDoubleVals: a value of the pool (negated 30% of the time), a non-finite value once in
+	// twenty-five, else a small ratio.
+	hzDoubleVals = weighted(
+		choice[hzVal]{60, hegel.Map(pairs(hegel.SampledFrom(hzInterestingDoubles), chance(30)), func(p pair[float64, bool]) hzVal {
+			if p.b {
+				return hzDouble(-p.a)
+			}
+			return hzDouble(p.a)
+		})},
+		choice[hzVal]{4, hegel.Map(hegel.SampledFrom([]float64{math.Inf(1), math.Inf(-1), math.NaN()}), hzDouble)},
+		choice[hzVal]{36, hegel.Map(pairs(hegel.Integers(-100000, 100000), hegel.SampledFrom([]int{1, 2, 4, 8, 10, 100, 3, 7})), func(p pair[int, int]) hzVal {
+			return hzDouble(float64(p.a) / float64(p.b))
+		})},
+	)
+	hzStringVals = weighted(
+		choice[hzVal]{70, hegel.Map(hegel.SampledFrom(hzStringPool), hzStr)},
+		choice[hzVal]{30, hegel.Map(hegel.Text().Alphabet(string(hzRunes)).MaxSize(6), hzStr)},
+	)
+	hzBytesVals = weighted(
+		choice[hzVal]{50, hegel.Map(hegel.SampledFrom(hzStringPool), func(s string) hzVal { return hzBytes([]byte(s)) })},
+		choice[hzVal]{50, hegel.Map(hegel.Binary(0, 6), hzBytes)},
+	)
+	hzBoolVals = hegel.Map(hegel.Booleans(), hzBool)
+	hzLIntVals = hzListVals(hzIntVals)
+	hzLStrVals = hzListVals(hzStringVals)
+	// map values: distinct keys by construction, in sorted order (a Go map has none)
+	hzMSIVals = hegel.Map(hegel.Maps(hegel.Map(hzStringVals, func(v hzVal) string { return v.s }), hzIntVals).MaxSize(3), func(m map[string]hzVal) hzVal {
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		v := hzVal{k: hzKMap, keys: []hzVal{}, vals: []hzVal{}}
+		for _, k := range keys {
+			v.keys = append(v.keys, hzStr(k))
+			v.vals = append(v.vals, m[k])
+		}
+		return v
+	})
+	hzMISVals = hegel.Map(hegel.Maps(hegel.Map(hzIntVals, func(v hzVal) int64 { return v.i }), hzStringVals).MaxSize(3), func(m map[int64]hzVal) hzVal {
+		keys := make([]int64, 0, len(m))
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })
+		v := hzVal{k: hzKMap, keys: []hzVal{}, vals: []hzVal{}}
+		for _, k := range keys {
+			v.keys = append(v.keys, hzInt(k))
+			v.vals = append(v.vals, m[k])
+		}
+		return v
+	})
+)
+
+// hzListVals: up to four elements.
+func hzListVals(elem hegel.Generator[hzVal]) hegel.Generator[hzVal] {
+	return hegel.Map(hegel.Lists(elem).MaxSize(4), func(xs []hzVal) hzVal { return hzVal{k: hzKList, list: nonNil(xs)} })
+}
+
+// hzValsOf: values of the type.
+func hzValsOf(t hzType) hegel.Generator[hzVal] {
+	switch t.String() {
+	case "int":
+		return hzIntVals
+	case "uint":
+		return hzUintVals
+	case "double":
+		return hzDoubleVals
+	case "string":
+		return hzStringVals
+	case "bytes":
+		return hzBytesVals
+	case "bool":
+		return hzBoolVals
+	case "list(int)":
+		return hzLIntVals
+	case "list(string)":
+		return hzLStrVals
+	case "map(string, int)":
+		return hzMSIVals
+	case "map(int, string)":
+		return hzMISVals
+	}
+	panic("hzValsOf: no values of type " + t.String())
+}
+
+// hzBindings: a value for each of the twelve variables.
+var hzBindings = hegel.Composite(func(tc hegel.TestCase) hzVars {
+	env := make(hzVars, len(hzVarDecls))
+	for i, d := range hzVarDecls {
+		env[i] = hzVar{name: d.name, t: d.t, v: hegel.Draw(tc, hzValsOf(d.t))}
+	}
+	return env
+})
+
+// --------------------------------------------------------------------------- the grammar
+
+// hzListLits: a list literal of minN to three elements.
+func hzListLits(t hzType, elems hegel.Generator[*hzNode], minN int) hegel.Generator[*hzNode] {
+	return hegel.Map(hegel.Lists(elems).MinSize(minN).MaxSize(3), func(xs []*hzNode) *hzNode { return hzListNode(t, xs) })
+}
+
+// hzMapLits: a map literal of minN to three entries.
+func hzMapLits(t hzType, keys, vals hegel.Generator[*hzNode], minN int) hegel.Generator[*hzNode] {
+	return hegel.Map(hegel.Lists(pairs(keys, vals)).MinSize(minN).MaxSize(3), func(es []pair[*hzNode, *hzNode]) *hzNode { return hzMapNode(t, es) })
+}
+
+// hzVarsOf: a variable of the type.
+func hzVarsOf(t hzType) hegel.Generator[*hzNode] {
+	var names []string
+	for _, d := range hzVarDecls {
+		if d.t.eq(t) {
+			names = append(names, d.name)
+		}
+	}
+	return hegel.Map(hegel.SampledFrom(names), hzVarNode)
+}
+
+// hzPicks: an element of the sibling aggregate, by position modulo its size.
+func hzPicks(t hzType) hegel.Generator[*hzNode] {
+	return hegel.Map(positions, func(n int) *hzNode { return hzPickNode(t, n) })
+}
+
+// hzKeysOf: a key into the sibling aggregate of the type that is one of its own: a position
+// of a list, a key of a map.
+func hzKeysOf(at hzType) hegel.Generator[*hzNode] {
+	if at.k == hzKList {
+		return hegel.Map(positions, hzPosNode)
+	}
+	return hzPicks(*at.key)
+}
+
+var (
+	hzSizeTypes  = []hzType{hzTString, hzTBytes, hzTLInt, hzTLStr, hzTMSI, hzTMIS}
+	hzInTypes    = []hzType{hzTLInt, hzTLStr, hzTMSI, hzTMIS}
+	hzStrFns     = []string{"contains", "startsWith", "endsWith", "matches"}
+	hzPatternLit = hegel.Map(hegel.SampledFrom(hzPatterns), func(p string) *hzNode { return hzLit(hzStr(p)) })
+	hzSubstrs    = hegel.Map(pairs(positions, positions), func(p pair[int, int]) *hzNode { return hzSubstrNode(p.a, p.b) })
+)
+
+// hzGrammar: the expressions of every type, at most bound levels of composition deep, and
+// the aggregates an index or a macro range is taken over.
+type hzGrammar struct {
+	exprs map[string]hegel.Generator[*hzNode]
+	aggs  map[string]hegel.Generator[*hzNode]
+}
+
+// hzGrammarAt builds the grammar for a depth bound: a leaf (a literal or, 40% of the time, a
+// variable) at the bound and a quarter of the time above it, else a node of the type's
+// operators with subexpressions drawn from the grammar again (the depth counter in the closure
+// tracks the live recursion, hegel-go's ExampleComposite_recursive). Under HEGEL_NO_KNOWN=1
+// the aggregates of indexes and macro ranges are not empty literals (cel-go/3).
+func hzGrammarAt(bound int) *hzGrammar {
+	exprs := map[string]hegel.Generator[*hzNode]{}
+	aggs := map[string]hegel.Generator[*hzNode]{}
+	ref := func(t hzType) hegel.Generator[*hzNode] {
+		key := t.String()
+		return hegel.Composite(func(tc hegel.TestCase) *hzNode { return hegel.Draw(tc, exprs[key]) })
+	}
+	var leafOf func(t hzType) hegel.Generator[*hzNode]
+	leafOf = func(t hzType) hegel.Generator[*hzNode] {
+		var lit hegel.Generator[*hzNode]
+		switch t.k {
+		case hzKList:
+			lit = hzListLits(t, leafOf(*t.elem), 0)
+		case hzKMap:
+			lit = hzMapLits(t, leafOf(*t.key), leafOf(*t.val), 0)
+		default:
+			lit = hegel.Map(hzValsOf(t), hzLit)
+		}
+		return weighted(choice[*hzNode]{60, lit}, choice[*hzNode]{40, hzVarsOf(t)})
+	}
+	aggLit := func(t hzType, minN int) hegel.Generator[*hzNode] {
+		if t.k == hzKList {
+			return hzListLits(t, ref(*t.elem), minN)
+		}
+		return hzMapLits(t, ref(*t.key), ref(*t.val), minN)
+	}
+	for _, at := range hzInTypes {
+		aggs[at.String()] = ref(at)
+		if HZKnown.checkerTypeVarFirstOverload {
+			aggs[at.String()] = hegel.Filter(weighted(
+				choice[*hzNode]{40, hzVarsOf(at)},
+				choice[*hzNode]{40, aggLit(at, 1)},
+				choice[*hzNode]{20, ref(at)},
+			), func(n *hzNode) bool { return !hzEmptyLit(n) })
+		}
+	}
+	negate := func(t hzType) hegel.Generator[*hzNode] { return hegel.Map(ref(t), hzNegNode) }
+	arith := func(t hzType) hegel.Generator[*hzNode] {
+		ops := []string{"+", "-", "*", "/", "%"}
+		if t.k == hzKDouble {
+			ops = ops[:4]
+		}
+		return hegel.Composite(func(tc hegel.TestCase) *hzNode {
+			op := hegel.Draw(tc, hegel.SampledFrom(ops))
+			return hzBinNode(op, hegel.Draw(tc, ref(t)), hegel.Draw(tc, ref(t)))
+		})
+	}
+	sizes := hegel.FlatMap(hegel.SampledFrom(hzSizeTypes), func(at hzType) hegel.Generator[*hzNode] {
+		return hegel.Map(ref(at), hzSizeNode)
+	})
+	conv := func(t hzType) hegel.Generator[*hzNode] {
+		return hegel.FlatMap(hegel.SampledFrom(hzConvFrom(t)), func(ft hzType) hegel.Generator[*hzNode] {
+			return hegel.Map(ref(ft), func(e *hzNode) *hzNode { return hzConvNode(t, e) })
+		})
+	}
+	cond := func(t hzType) hegel.Generator[*hzNode] {
+		return hegel.Composite(func(tc hegel.TestCase) *hzNode {
+			return hzCondNode(hegel.Draw(tc, ref(hzTBool)), hegel.Draw(tc, ref(t)), hegel.Draw(tc, ref(t)))
+		})
+	}
+	// index: the key one of the aggregate's own 70% of the time, else an expression
+	index := func(at hzType) hegel.Generator[*hzNode] {
+		kt := hzTInt
+		if at.k == hzKMap {
+			kt = *at.key
+		}
+		keys := weighted(choice[*hzNode]{70, hzKeysOf(at)}, choice[*hzNode]{30, ref(kt)})
+		return hegel.Composite(func(tc hegel.TestCase) *hzNode {
+			return hzIndexNode(hegel.Draw(tc, aggs[at.String()]), hegel.Draw(tc, keys))
+		})
+	}
+	// in: the needle an element of the aggregate half of the time
+	ins := hegel.FlatMap(hegel.SampledFrom(hzInTypes), func(at hzType) hegel.Generator[*hzNode] {
+		et := hzElemOf(at)
+		needles := weighted(choice[*hzNode]{50, hzPicks(et)}, choice[*hzNode]{50, ref(et)})
+		return hegel.Composite(func(tc hegel.TestCase) *hzNode {
+			agg := hegel.Draw(tc, ref(at))
+			return hzBinNode("in", hegel.Draw(tc, needles), agg)
+		})
+	})
+	concat := func(t hzType) hegel.Generator[*hzNode] {
+		return hegel.Composite(func(tc hegel.TestCase) *hzNode {
+			return hzBinNode("+", hegel.Draw(tc, ref(t)), hegel.Draw(tc, ref(t)))
+		})
+	}
+	comparison := func(types []hzType, ops []string) hegel.Generator[*hzNode] {
+		return hegel.FlatMap(hegel.SampledFrom(types), func(t hzType) hegel.Generator[*hzNode] {
+			return hegel.Composite(func(tc hegel.TestCase) *hzNode {
+				op := hegel.Draw(tc, hegel.SampledFrom(ops))
+				return hzBinNode(op, hegel.Draw(tc, ref(t)), hegel.Draw(tc, ref(t)))
+			})
+		})
+	}
+	compares := weighted(
+		choice[*hzNode]{40, comparison(hzAllTypes, []string{"==", "!="})},
+		choice[*hzNode]{60, comparison(hzScalarTypes, []string{"<", "<=", ">", ">="})},
+	)
+	logic := hegel.Composite(func(tc hegel.TestCase) *hzNode {
+		op := hegel.Draw(tc, hegel.SampledFrom([]string{"&&", "||"}))
+		return hzBinNode(op, hegel.Draw(tc, ref(hzTBool)), hegel.Draw(tc, ref(hzTBool)))
+	})
+	bangs := hegel.Map(chance(10), func(twice bool) int {
+		if twice {
+			return 2
+		}
+		return 1
+	})
+	nots := hegel.Composite(func(tc hegel.TestCase) *hzNode {
+		return hzNotNode(hegel.Draw(tc, ref(hzTBool)), hegel.Draw(tc, bangs))
+	})
+	// string functions: the argument a substring of the operand 40% of the time; for matches
+	// a pattern of the pool 70% of the time
+	strFns := hegel.FlatMap(hegel.SampledFrom(hzStrFns), func(fn string) hegel.Generator[*hzNode] {
+		args := weighted(choice[*hzNode]{40, hzSubstrs}, choice[*hzNode]{60, ref(hzTString)})
+		if fn == "matches" {
+			args = weighted(choice[*hzNode]{70, hzPatternLit}, choice[*hzNode]{12, hzSubstrs}, choice[*hzNode]{18, ref(hzTString)})
+		}
+		return hegel.Composite(func(tc hegel.TestCase) *hzNode {
+			s := hegel.Draw(tc, ref(hzTString))
+			return hzStrFnNode(fn, s, hegel.Draw(tc, args))
+		})
+	})
+	aggregates := func(t hzType) []choice[*hzNode] {
+		out := []choice[*hzNode]{{2, aggLit(t, 0)}}
+		if t.k == hzKList {
+			out = append(out, choice[*hzNode]{1, concat(t)})
+		}
+		return append(out, choice[*hzNode]{1, cond(t)})
+	}
+	branches := map[string]hegel.Generator[*hzNode]{
+		"int": weighted(
+			choice[*hzNode]{1, negate(hzTInt)}, choice[*hzNode]{3, arith(hzTInt)}, choice[*hzNode]{1, sizes},
+			choice[*hzNode]{1, conv(hzTInt)}, choice[*hzNode]{1, cond(hzTInt)}, choice[*hzNode]{1, index(hzTLInt)}, choice[*hzNode]{1, index(hzTMSI)},
+		),
+		"uint":   weighted(choice[*hzNode]{3, arith(hzTUint)}, choice[*hzNode]{1, conv(hzTUint)}, choice[*hzNode]{1, cond(hzTUint)}),
+		"double": weighted(choice[*hzNode]{1, negate(hzTDouble)}, choice[*hzNode]{3, arith(hzTDouble)}, choice[*hzNode]{1, conv(hzTDouble)}, choice[*hzNode]{1, cond(hzTDouble)}),
+		"string": weighted(
+			choice[*hzNode]{2, concat(hzTString)}, choice[*hzNode]{2, conv(hzTString)}, choice[*hzNode]{1, cond(hzTString)},
+			choice[*hzNode]{1, hegel.OneOf(index(hzTLStr), index(hzTMIS))},
+		),
+		"bytes": weighted(choice[*hzNode]{2, concat(hzTBytes)}, choice[*hzNode]{1, conv(hzTBytes)}, choice[*hzNode]{1, cond(hzTBytes)}),
+		"bool": weighted(
+			choice[*hzNode]{1, nots}, choice[*hzNode]{3, compares}, choice[*hzNode]{2, logic}, choice[*hzNode]{2, ins},
+			choice[*hzNode]{2, strFns}, choice[*hzNode]{1, conv(hzTBool)}, choice[*hzNode]{1, cond(hzTBool)},
+		),
+		"list(int)":        weighted(aggregates(hzTLInt)...),
+		"list(string)":     weighted(aggregates(hzTLStr)...),
+		"map(string, int)": weighted(aggregates(hzTMSI)...),
+		"map(int, string)": weighted(aggregates(hzTMIS)...),
+	}
+	depth := 0
+	for _, t := range hzAllTypes {
+		key := t.String()
+		leaf := leafOf(t)
+		nodes := weighted(choice[*hzNode]{25, leaf}, choice[*hzNode]{75, branches[key]})
+		exprs[key] = hegel.Composite(func(tc hegel.TestCase) *hzNode {
+			if depth >= bound {
+				return hegel.Draw(tc, leaf)
+			}
+			depth++
+			defer func() { depth-- }()
+			return hegel.Draw(tc, nodes)
+		})
+	}
+	return &hzGrammar{exprs: exprs, aggs: aggs}
+}
+
+// hzGrammars: the grammar at every depth bound from 0 (leaves only) to 4.
+var hzGrammars = func() []*hzGrammar {
+	out := make([]*hzGrammar, 5)
+	for b := range out {
+		out[b] = hzGrammarAt(b)
+	}
+	return out
+}()
+
+// --------------------------------------------------------------------------- cases
+
+// hzCase is one generated case: the bindings, the expression and the tape of its text.
+type hzCase struct {
+	env       hzVars
+	expr      *hzNode
+	tape      []int
+	in        hzInSpacing
+	unordered bool // the value is a list built from a map's keys: its order is unspecified
+	unsigned  bool // the text has no negative numeric literal (a parser comparison past cel-go/2; the model does not apply)
+}
+
+func (c hzCase) src() string { return hzRender(c.expr, c.env, c.tape, c.in, c.unsigned) }
+func (c hzCase) want() hzVal { return hzEvalNode(c.expr, c.env) }
+func (c hzCase) GoString() string {
+	return fmt.Sprintf("expr: %s\nvars: %s\nmodel: %s", c.src(), c.env.describe(), c.want().String())
+}
+
+// hzShapeless is the case with the shapes the generators cannot exclude by construction left
+// out under HEGEL_NO_KNOWN=1: a map literal's repeated keys (cel-go/5) are dropped.
+func hzShapeless(c hzCase) hzCase {
+	if HZKnown.mapRepeatedKeyLastWins {
+		c.expr = hzDropRepeatedKeys(c.expr, c.env)
+	}
+	return c
+}
+
+// hzWantTypes: the type of a case's expression: bool three times in ten, int twice, string
+// once, else any type.
+var hzWantTypes = weighted(
+	choice[hzType]{30, hegel.Just(hzTBool)},
+	choice[hzType]{20, hegel.Just(hzTInt)},
+	choice[hzType]{10, hegel.Just(hzTString)},
+	choice[hzType]{40, hegel.SampledFrom(hzAllTypes)},
+)
+
+// hzCases: bindings and an expression one to four levels deep of a drawn type.
+var hzCases = hegel.Map(hegel.Composite(func(tc hegel.TestCase) hzCase {
+	depth := hegel.Draw(tc, hegel.Integers(1, 4))
+	t := hegel.Draw(tc, hzWantTypes)
+	return hzCase{
+		env:  hegel.Draw(tc, hzBindings),
+		expr: hegel.Draw(tc, hzGrammars[depth].exprs[t.String()]),
+		tape: hegel.Draw(tc, hzTapes),
+		in:   hzInDefault,
+	}
+}), hzShapeless)
