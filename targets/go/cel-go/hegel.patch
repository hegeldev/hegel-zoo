+// --------------------------------------------------------------------------- environment
+
+var (
+	hzEnvOnce sync.Once
+	hzEnvVal  *cel.Env
+	hzEnvErr  error
+)
+
+func hzCelType(t hzType) *cel.Type {
+	switch t.k {
+	case hzKInt:
+		return cel.IntType
+	case hzKUint:
+		return cel.UintType
+	case hzKDouble:
+		return cel.DoubleType
+	case hzKString:
+		return cel.StringType
+	case hzKBytes:
+		return cel.BytesType
+	case hzKBool:
+		return cel.BoolType
+	case hzKList:
+		return cel.ListType(hzCelType(*t.elem))
+	case hzKMap:
+		return cel.MapType(hzCelType(*t.key), hzCelType(*t.val))
+	}
+	return cel.DynType
+}
+
+// hzEnv is the environment of the generated expressions: the standard library and the
+// variables of hzVarDecls.
+func hzEnv(t testing.TB) *cel.Env {
+	hzEnvOnce.Do(func() {
+		var opts []cel.EnvOption
+		for _, d := range hzVarDecls {
+			opts = append(opts, cel.Variable(d.name, hzCelType(d.t)))
+		}
+		opts = append(opts, cel.EnableMacroCallTracking(), cel.OptionalTypes())
+		hzEnvVal, hzEnvErr = cel.NewEnv(opts...)
+	})
+	if hzEnvErr != nil {
+		t.Fatalf("cel.NewEnv: %v", hzEnvErr)
+	}
+	return hzEnvVal
+}
+
+// hzFromRef converts an evaluation result to a model value.
+func hzFromRef(v ref.Val) hzVal {
+	switch x := v.(type) {
+	case types.Int:
+		return hzInt(int64(x))
+	case types.Uint:
+		return hzUint(uint64(x))
+	case types.Double:
+		return hzDouble(float64(x))
+	case types.String:
+		return hzStr(string(x))
+	case types.Bytes:
+		return hzBytes([]byte(x))
+	case types.Bool:
+		return hzBool(bool(x))
+	case *types.Err:
+		return hzErr(x.Error())
+	case traits.Mapper:
+		out := hzVal{k: hzKMap, keys: []hzVal{}, vals: []hzVal{}}
+		it := x.Iterator()
+		for it.HasNext() == types.True {
+			k := it.Next()
+			out.keys = append(out.keys, hzFromRef(k))
+			out.vals = append(out.vals, hzFromRef(x.Get(k)))
+		}
+		return out
+	case traits.Lister:
+		out := hzVal{k: hzKList, list: []hzVal{}}
+		n, _ := x.Size().(types.Int)
+		for i := int64(0); i < int64(n); i++ {
+			out.list = append(out.list, hzFromRef(x.Get(types.Int(i))))
+		}
+		return out
+	}
+	if v == nil {
+		return hzErr("nil result")
+	}
+	return hzErr(fmt.Sprintf("unexpected result type %T", v))
+}
+
+// hzEval runs a program and converts the outcome (an error is a value of the error kind).
+func hzEval(prg cel.Program, act map[string]any) (hzVal, string) {
+	out, _, err := prg.Eval(act)
+	if err != nil {
+		return hzErr(err.Error()), err.Error()
+	}
+	if types.IsError(out) {
+		return hzErr(out.(*types.Err).Error()), out.(*types.Err).Error()
+	}
+	return hzFromRef(out), ""
+}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelEval: a generated expression parses and checks with the generated type, and
+// unchecked evaluation, checked evaluation, every evaluation option, constant folding and the
+// unparsed expression all give the specification's value (or an error where the model has one).
+func TestHegelEval(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		cs := hzGenCase(tc, nil, hzDrawInt(tc, 1, 4))
+		src := cs.expr.src
+		want := cs.expr.v
+		act := cs.activation()
+		where := func() string {
+			return fmt.Sprintf("\n  expr: %s\n  vars: %s\n  model: %s", src, cs.describe(), want.String())
+		}
+		if want.isErr() {
+			c.count("model error " + want.err)
+		} else {
+			c.count("type " + cs.expr.t.String())
+		}
+
+		parsed, iss := env.Parse(src)
+		if iss.Err() != nil {
+			c.failClass(ht, "parse", "parse error: %v%s", iss.Err(), where())
+			return
+		}
+		checked, iss := env.Check(parsed)
+		if iss.Err() != nil {
+			c.failClass(ht, "check", "check error: %v%s", iss.Err(), where())
+			return
+		}
+		if got := checked.OutputType().String(); got != cs.expr.t.String() {
+			// an empty literal's element type is dyn, and stays so through a conditional or a
+			// concatenation of two of them: dyn is a wildcard here
+			if hzTypeMatches(got, cs.expr.t.String()) {
+				c.count("type with dyn")
+			} else {
+				c.failClass(ht, "type", "checked type %s, generated %s%s", got, cs.expr.t, where())
+			}
+		}
+
+		prg, err := env.Program(parsed)
+		if err != nil {
+			c.failClass(ht, "program", "Program(parsed): %v%s", err, where())
+			return
+		}
+		got, gotErr := hzEval(prg, act)
+		if !hzSame(want, got) {
+			c.failClass(ht, "model", "unchecked evaluation gave %s (%s), the specification %s%s", got.String(), gotErr, want.String(), where())
+		}
+
+		// the rewrites of `in` by OptOptimize and constant folding lose an operand's error
+		skipRewrites := got.isErr() && cs.hasIn && HZKnown.inFoldDropsError
+		if skipRewrites {
+			hzAvoid("inFoldDropsError")
+		}
+
+		variants := []struct {
+			name string
+			ast  *cel.Ast
+			opts []cel.ProgramOption
+		}{
+			{"checked", checked, nil},
+			{"optimize", checked, []cel.ProgramOption{cel.EvalOptions(cel.OptOptimize)}},
+			{"exhaustive", checked, []cel.ProgramOption{cel.EvalOptions(cel.OptExhaustiveEval)}},
+			{"partial", checked, []cel.ProgramOption{cel.EvalOptions(cel.OptPartialEval)}},
+			{"track", parsed, []cel.ProgramOption{cel.EvalOptions(cel.OptTrackState | cel.OptTrackCost)}},
+		}
