new file mode 100644
index 0000000..72af5d3
--- /dev/null
+++ b/hegel/hegel_zoo_props_test.go
@@ -0,0 +1,817 @@
+package hegel
+
+import (
+	"fmt"
+	"math"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"cel.dev/cel-go/cel"
+	"cel.dev/cel-go/common"
+	celast "cel.dev/cel-go/common/ast"
+	"cel.dev/cel-go/common/types"
+	"cel.dev/cel-go/common/types/ref"
+	"cel.dev/cel-go/common/types/traits"
+	"cel.dev/cel-go/parser"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- environment
+
+var (
+	hzEnvOnce sync.Once
+	hzEnvVal  *cel.Env
+	hzEnvErr  error
+)
+
+func hzCelType(t hzType) *cel.Type {
+	switch t.k {
+	case hzKInt:
+		return cel.IntType
+	case hzKUint:
+		return cel.UintType
+	case hzKDouble:
+		return cel.DoubleType
+	case hzKString:
+		return cel.StringType
+	case hzKBytes:
+		return cel.BytesType
+	case hzKBool:
+		return cel.BoolType
+	case hzKList:
+		return cel.ListType(hzCelType(*t.elem))
+	case hzKMap:
+		return cel.MapType(hzCelType(*t.key), hzCelType(*t.val))
+	}
+	return cel.DynType
+}
+
+// hzCelEnv is the environment of the generated expressions: the standard library and the
+// variables of hzVarDecls.
+func hzEnv(t testing.TB) *cel.Env {
+	hzEnvOnce.Do(func() {
+		var opts []cel.EnvOption
+		for _, d := range hzVarDecls {
+			opts = append(opts, cel.Variable(d.name, hzCelType(d.t)))
+		}
+		opts = append(opts, cel.EnableMacroCallTracking(), cel.OptionalTypes())
+		hzEnvVal, hzEnvErr = cel.NewEnv(opts...)
+	})
+	if hzEnvErr != nil {
+		t.Fatalf("cel.NewEnv: %v", hzEnvErr)
+	}
+	return hzEnvVal
+}
+
+// hzFromRef converts an evaluation result to a model value.
+func hzFromRef(v ref.Val) hzVal {
+	switch x := v.(type) {
+	case types.Int:
+		return hzInt(int64(x))
+	case types.Uint:
+		return hzUint(uint64(x))
+	case types.Double:
+		return hzDouble(float64(x))
+	case types.String:
+		return hzStr(string(x))
+	case types.Bytes:
+		return hzBytes([]byte(x))
+	case types.Bool:
+		return hzBool(bool(x))
+	case *types.Err:
+		return hzErr(x.Error())
+	case traits.Mapper:
+		out := hzVal{k: hzKMap, keys: []hzVal{}, vals: []hzVal{}}
+		it := x.Iterator()
+		for it.HasNext() == types.True {
+			k := it.Next()
+			out.keys = append(out.keys, hzFromRef(k))
+			out.vals = append(out.vals, hzFromRef(x.Get(k)))
+		}
+		return out
+	case traits.Lister:
+		out := hzVal{k: hzKList, list: []hzVal{}}
+		n, _ := x.Size().(types.Int)
+		for i := int64(0); i < int64(n); i++ {
+			out.list = append(out.list, hzFromRef(x.Get(types.Int(i))))
+		}
+		return out
+	}
+	if v == nil {
+		return hzErr("nil result")
+	}
+	return hzErr(fmt.Sprintf("unexpected result type %T", v))
+}
+
+// hzEval runs a program and converts the outcome (an error is a value of the error kind).
+func hzEval(prg cel.Program, act map[string]any) (hzVal, string) {
+	out, _, err := prg.Eval(act)
+	if err != nil {
+		return hzErr(err.Error()), err.Error()
+	}
+	if types.IsError(out) {
+		return hzErr(out.(*types.Err).Error()), out.(*types.Err).Error()
+	}
+	return hzFromRef(out), ""
+}
+
+// --------------------------------------------------------------------------- the oracle
+
+// hzJudge judges a case: the expression parses and checks with the generated type, unchecked
+// evaluation gives the specification's value, checked evaluation, every evaluation option and
+// constant folding give the same, and the unparsed text parses to the same tree and evaluates
+// the same. With full (TestHegelEval) the folded AST's text must recompile and evaluate the
+// same too and the unparser must be a fixpoint; without (TestHegelMacros) those are left out
+// and a list built from a map's keys is compared as a multiset. A mismatch on the shape of a
+// recorded bug names it.
+func hzJudge(ht *hegel.T, c *hzCollector, env *cel.Env, cs hzCase, full bool) {
+	src := cs.src()
+	want := cs.want()
+	act := cs.env.activation()
+	where := func() string {
+		return fmt.Sprintf("\n  expr: %s\n  vars: %s\n  model: %s", src, cs.env.describe(), want.String())
+	}
+	same := hzSame
+	if cs.unordered {
+		same = hzSameSet
+	}
+	if want.isErr() {
+		c.count("model error " + want.err)
+	} else {
+		c.count("type " + cs.expr.t.String())
+	}
+	// an element of an empty literal has an unresolved type, which the checker binds to the
+	// first overload of the operator applied to it (cel-go/3)
+	emptyIndexed := shapeIf(hzIndexesEmptyLit(cs.expr), "cel-go/3")
+
+	parsed, iss := env.Parse(src)
+	if iss.Err() != nil {
+		c.failClass(ht, "parse", "parse error: %v%s", iss.Err(), where())
+		return
+	}
+	checked, iss := env.Check(parsed)
+	if iss.Err() != nil {
+		overload := shapeIf(len(emptyIndexed) > 0 && strings.Contains(iss.Err().Error(), "no matching overload"), "cel-go/3")
+		c.mismatch(ht, overload, "check", "check error: %v%s", iss.Err(), where())
+		return
+	}
+	if got := checked.OutputType().String(); got != cs.expr.t.String() {
+		// an empty literal's element type is dyn, and stays so through a conditional or a
+		// concatenation of two of them: dyn is a wildcard here
+		if hzTypeMatches(got, cs.expr.t.String()) {
+			c.count("type with dyn")
+		} else {
+			c.mismatch(ht, emptyIndexed, "type", "checked type %s, generated %s%s", got, cs.expr.t, where())
+		}
+	}
+
+	prg, err := env.Program(parsed)
+	if err != nil {
+		c.failClass(ht, "program", "Program(parsed): %v%s", err, where())
+		return
+	}
+	got, gotErr := hzEval(prg, act)
+	if !same(want, got) {
+		repeated := shapeIf(want.isErr() && want.err == "duplicate key" && hzRepeatedKey(cs.expr, cs.env), "cel-go/5")
+		c.mismatch(ht, repeated, "model", "unchecked evaluation gave %s (%s), the specification %s%s", got.String(), gotErr, want.String(), where())
+	}
+
+	// the rewrites of `in` over a constant haystack by OptOptimize and constant folding lose an
+	// operand's error (cel-go/4)
+	inShape := shapeIf(got.isErr() && hzHasConstIn(cs.expr), "cel-go/4")
+	skipRewrites := len(inShape) > 0 && HZKnown.inFoldDropsError
+	if skipRewrites {
+		c.count("tolerated cel-go/4")
+	}
+
+	variants := []struct {
+		name string
+		ast  *cel.Ast
+		opts []cel.ProgramOption
+	}{
+		{"checked", checked, nil},
+		{"optimize", checked, []cel.ProgramOption{cel.EvalOptions(cel.OptOptimize)}},
+		{"exhaustive", checked, []cel.ProgramOption{cel.EvalOptions(cel.OptExhaustiveEval)}},
+		{"partial", checked, []cel.ProgramOption{cel.EvalOptions(cel.OptPartialEval)}},
+		{"track", parsed, []cel.ProgramOption{cel.EvalOptions(cel.OptTrackState | cel.OptTrackCost)}},
+	}
+	for _, v := range variants {
+		if v.name == "optimize" && skipRewrites {
+			continue
+		}
+		p, err := env.Program(v.ast, v.opts...)
+		if err != nil {
+			if v.name == "optimize" {
+				if got.isErr() {
+					// OptOptimize reports a constant pattern's compilation error at program creation
+					c.count("optimize program error")
+					continue
+				}
+				// a constant unary call that errors in a branch the expression never takes (cel-go/6)
+				c.tolerated(ht, []string{"cel-go/6"}, "program optimize", "Program(optimize): %v%s", err, where())
+				continue
+			}
+			c.failClass(ht, "program "+v.name, "Program(%s): %v%s", v.name, err, where())
+			continue
+		}
+		g2, e2 := hzEval(p, act)
+		if !same(got, g2) {
+			var shape []string
+			if v.name == "optimize" {
+				shape = inShape
+			}
+			c.mismatch(ht, shape, v.name, "%s evaluation gave %s (%s), unchecked %s (%s)%s", v.name, g2.String(), e2, got.String(), gotErr, where())
+		}
+	}
+	if !skipRewrites {
+		// constant folding, then the folded AST evaluated and unparsed
+		folder, err := cel.NewConstantFoldingOptimizer()
+		if err != nil {
+			ht.Fatalf("NewConstantFoldingOptimizer: %v", err)
+		}
+		opt, err := cel.NewStaticOptimizer(folder)
+		if err != nil {
+			ht.Fatalf("NewStaticOptimizer: %v", err)
+		}
+		literalPredicate := shapeIf(hzLiteralPredicateMacro(cs.expr), "cel-go/9")
+		folded, iss := opt.Optimize(env, checked)
+		if iss.Err() != nil {
+			// a pruned conditional branch's ids colliding with later nodes (cel-go/7); a literal
+			// predicate folded to a null the wrapping `!` has no overload for (cel-go/9)
+			collision := shapeIf(strings.Contains(iss.Err().Error(), "already exists for expression"), "cel-go/7")
+			c.tolerated(ht, append(collision, literalPredicate...), "fold", "constant folding: %v%s", iss.Err(), where())
+		} else if p, err := env.Program(folded); err != nil {
+			c.failClass(ht, "fold program", "Program(folded): %v%s", err, where())
+		} else {
+			if g2, e2 := hzEval(p, act); !same(got, g2) {
+				fs, _ := cel.AstToString(folded)
+				c.mismatch(ht, append(inShape, literalPredicate...), "fold", "folded evaluation (%s) gave %s (%s), unchecked %s (%s)%s", fs, g2.String(), e2, got.String(), gotErr, where())
+			}
+			if full {
+				if fs, err := cel.AstToString(folded); err != nil {
+					c.failClass(ht, "fold unparse", "AstToString(folded): %v%s", err, where())
+				} else if a2, iss := env.Compile(fs); iss.Err() != nil {
+					// a non-finite double literal written as NaN.0 or Inf.0 (cel-go/8)
+					nonFinite := shapeIf(strings.Contains(fs, "NaN.0") || strings.Contains(fs, "Inf.0"), "cel-go/8")
+					c.tolerated(ht, nonFinite, "fold unparse", "folded expression %q does not compile: %v%s", fs, iss.Err(), where())
+				} else if p, err := env.Program(a2); err == nil {
+					if g2, e2 := hzEval(p, act); !same(got, g2) {
+						c.mismatch(ht, append(inShape, literalPredicate...), "fold unparse", "folded expression %q gave %s (%s), unchecked %s (%s)%s", fs, g2.String(), e2, got.String(), gotErr, where())
+					}
+				}
+			}
+		}
+	}
+
+	// the unparser: a fixpoint that evaluates the same
+	us, err := cel.AstToString(parsed)
+	if err != nil {
+		c.failClass(ht, "unparse", "AstToString: %v%s", err, where())
+		return
+	}
+	a2, iss := env.Parse(us)
+	if iss.Err() != nil {
+		c.failClass(ht, "unparse", "unparsed %q does not parse: %v%s", us, iss.Err(), where())
+		return
+	}
+	if full {
+		// (the unparser writes -(5) as -5, which parses to a negative literal, and -(-(0)) as
+		// -(-0), which parses to -(0): the trees are compared with negated literals normalized,
+		// and the text is only required to be a fixpoint when the trees agree exactly)
+		liberty := hzDump(parsed.NativeRep().Expr()) != hzDump(a2.NativeRep().Expr())
+		if us2, err := cel.AstToString(a2); err != nil || (us2 != us && !liberty) {
+			c.failClass(ht, "unparse", "unparse is not a fixpoint:\n  once:  %s\n  twice: %s (%v)%s", us, us2, err, where())
+		}
+	}
+	if hzDumpNorm(parsed.NativeRep().Expr()) != hzDumpNorm(a2.NativeRep().Expr()) {
+		c.failClass(ht, "unparse ast", "unparsed %q parses to a different tree:\n  %s\n  %s%s", us, hzDump(parsed.NativeRep().Expr()), hzDump(a2.NativeRep().Expr()), where())
+	}
+	if p, err := env.Program(a2); err == nil {
+		if g2, e2 := hzEval(p, act); !same(got, g2) {
+			c.failClass(ht, "unparse eval", "unparsed %q gave %s (%s), the original %s (%s)%s", us, g2.String(), e2, got.String(), gotErr, where())
+		}
+	}
+}
+
+// TestHegelEval: a generated expression parses and checks with the generated type, and
+// unchecked evaluation, checked evaluation, every evaluation option, constant folding and the
+// unparsed expression all give the specification's value (or an error where the model has one).
+func TestHegelEval(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzJudge(ht, c, env, hegel.Draw(ht, hzCases), true)
+	})
+}
+
+// hzTypeMatches reports whether a checked type equals the generated one up to dyn: every
+// `dyn` in got stands for any type.
+func hzTypeMatches(got, want string) bool {
+	if !strings.Contains(got, "dyn") {
+		return got == want
+	}
+	pat := "^" + strings.ReplaceAll(regexp.QuoteMeta(got), "dyn", `[a-z]+(\([a-z, ()]*\))?`) + "$"
+	ok, err := regexp.MatchString(pat, want)
+	return err == nil && ok
+}
+
+// --------------------------------------------------------------------------- AST dumps
+
+// hzDump renders a parsed tree without ids, for comparisons between parsers.
+func hzDump(e celast.Expr) string {
+	var sb strings.Builder
+	hzDumpTo(&sb, e, false)
+	return sb.String()
+}
+
+// hzDumpNorm is hzDump up to the unparser's liberties: a negated numeric literal is the
+// negative literal, and chains of && and || are flat.
+func hzDumpNorm(e celast.Expr) string {
+	var sb strings.Builder
+	hzDumpTo(&sb, e, true)
+	return sb.String()
+}
+
+func hzFlatten(fn string, e celast.Expr, out []celast.Expr) []celast.Expr {
+	if e != nil && e.Kind() == celast.CallKind && e.AsCall().FunctionName() == fn && !e.AsCall().IsMemberFunction() {
+		for _, a := range e.AsCall().Args() {
+			out = hzFlatten(fn, a, out)
+		}
+		return out
+	}
+	return append(out, e)
+}
+
+var (
+	hzNormInt    = regexp.MustCompile(`^int\((-?[0-9]+)\)$`)
+	hzNormDouble = regexp.MustCompile(`^double\(([0-9]+)\)$`)
+)
+
+func hzDumpTo(sb *strings.Builder, e celast.Expr, norm bool) {
+	if e == nil {
+		sb.WriteString("<nil>")
+		return
+	}
+	switch e.Kind() {
+	case celast.LiteralKind:
+		v := e.AsLiteral()
+		switch x := v.(type) {
+		case types.Bytes:
+			fmt.Fprintf(sb, "bytes(%x)", []byte(x))
+		case types.Double:
+			fmt.Fprintf(sb, "double(%v)", math.Float64bits(float64(x)))
+		default:
+			fmt.Fprintf(sb, "%s(%#v)", v.Type().TypeName(), v.Value())
+		}
+	case celast.IdentKind:
+		fmt.Fprintf(sb, "ident(%s)", e.AsIdent())
+	case celast.SelectKind:
+		s := e.AsSelect()
+		sb.WriteString("select(")
+		hzDumpTo(sb, s.Operand(), norm)
+		fmt.Fprintf(sb, ", %q, test=%v)", s.FieldName(), s.IsTestOnly())
+	case celast.CallKind:
+		cl := e.AsCall()
+		fn := cl.FunctionName()
+		args := cl.Args()
+		if norm && fn == "-_" && len(args) == 1 {
+			// -(-(5)) unparses as -(-5), which parses as -(5): fold negated numeric literals
+			var inner strings.Builder
+			hzDumpTo(&inner, args[0], norm)
+			if m := hzNormInt.FindStringSubmatch(inner.String()); m != nil {
+				n, _ := strconv.ParseInt(m[1], 10, 64)
+				fmt.Fprintf(sb, "int(%#v)", -n)
+				return
+			}
+			if m := hzNormDouble.FindStringSubmatch(inner.String()); m != nil {
+				bits, _ := strconv.ParseUint(m[1], 10, 64)
+				fmt.Fprintf(sb, "double(%v)", bits^(1<<63))
+				return
+			}
+		}
+		if norm && (fn == "_&&_" || fn == "_||_") && !cl.IsMemberFunction() {
+			args = hzFlatten(fn, e, nil)
+		}
+		fmt.Fprintf(sb, "call(%s", fn)
+		if cl.IsMemberFunction() {
+			sb.WriteString(", target=")
+			hzDumpTo(sb, cl.Target(), norm)
+		}
+		for _, a := range args {
+			sb.WriteString(", ")
+			hzDumpTo(sb, a, norm)
+		}
+		sb.WriteString(")")
+	case celast.ListKind:
+		l := e.AsList()
+		sb.WriteString("list[")
+		for i, el := range l.Elements() {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			if l.IsOptional(int32(i)) {
+				sb.WriteString("?")
+			}
+			hzDumpTo(sb, el, norm)
+		}
+		sb.WriteString("]")
+	case celast.MapKind:
+		m := e.AsMap()
+		sb.WriteString("map{")
+		for i, en := range m.Entries() {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			me := en.AsMapEntry()
+			if me.IsOptional() {
+				sb.WriteString("?")
+			}
+			hzDumpTo(sb, me.Key(), norm)
+			sb.WriteString(": ")
+			hzDumpTo(sb, me.Value(), norm)
+		}
+		sb.WriteString("}")
+	case celast.StructKind:
+		s := e.AsStruct()
+		fmt.Fprintf(sb, "struct %s{", s.TypeName())
+		for i, f := range s.Fields() {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			sf := f.AsStructField()
+			if sf.IsOptional() {
+				sb.WriteString("?")
+			}
+			sb.WriteString(sf.Name())
+			sb.WriteString(": ")
+			hzDumpTo(sb, sf.Value(), norm)
+		}
+		sb.WriteString("}")
+	case celast.ComprehensionKind:
+		cp := e.AsComprehension()
+		fmt.Fprintf(sb, "compr(%s", cp.IterVar())
+		if cp.HasIterVar2() {
+			fmt.Fprintf(sb, ", %s", cp.IterVar2())
+		}
+		sb.WriteString(" in ")
+		hzDumpTo(sb, cp.IterRange(), norm)
+		fmt.Fprintf(sb, "; %s = ", cp.AccuVar())
+		hzDumpTo(sb, cp.AccuInit(), norm)
+		sb.WriteString("; cond ")
+		hzDumpTo(sb, cp.LoopCondition(), norm)
+		sb.WriteString("; step ")
+		hzDumpTo(sb, cp.LoopStep(), norm)
+		sb.WriteString("; result ")
+		hzDumpTo(sb, cp.Result(), norm)
+		sb.WriteString(")")
+	default:
+		fmt.Fprintf(sb, "kind%d", e.Kind())
+	}
+}
+
+// hzDumpInfo renders the macro calls and the offsets of a parse, in tree order.
+func hzDumpInfo(a *celast.AST) (macros string, offsets string) {
+	var ms []string
+	for _, m := range a.SourceInfo().MacroCalls() {
+		ms = append(ms, hzDump(m))
+	}
+	sort.Strings(ms)
+	var offs []string
+	var walk func(e celast.Expr)
+	walk = func(e celast.Expr) {
+		if e == nil {
+			return
+		}
+		r, ok := a.SourceInfo().GetOffsetRange(e.ID())
+		if ok {
+			offs = append(offs, fmt.Sprintf("%d:%d-%d", e.Kind(), r.Start, r.Stop))
+		} else {
+			offs = append(offs, fmt.Sprintf("%d:-", e.Kind()))
+		}
+		for _, c := range hzChildren(e) {
+			walk(c)
+		}
+	}
+	walk(a.Expr())
+	return strings.Join(ms, "\n"), strings.Join(offs, " ")
+}
+
+// hzChildren: the subexpressions of a node, in source order.
+func hzChildren(e celast.Expr) []celast.Expr {
+	switch e.Kind() {
+	case celast.SelectKind:
+		return []celast.Expr{e.AsSelect().Operand()}
+	case celast.CallKind:
+		cl := e.AsCall()
+		var out []celast.Expr
+		if cl.IsMemberFunction() {
+			out = append(out, cl.Target())
+		}
+		return append(out, cl.Args()...)
+	case celast.ListKind:
+		return e.AsList().Elements()
+	case celast.MapKind:
+		var out []celast.Expr
+		for _, en := range e.AsMap().Entries() {
+			out = append(out, en.AsMapEntry().Key(), en.AsMapEntry().Value())
+		}
+		return out
+	case celast.StructKind:
+		var out []celast.Expr
+		for _, f := range e.AsStruct().Fields() {
+			out = append(out, f.AsStructField().Value())
+		}
+		return out
+	case celast.ComprehensionKind:
+		cp := e.AsComprehension()
+		return []celast.Expr{cp.IterRange(), cp.AccuInit(), cp.LoopCondition(), cp.LoopStep(), cp.Result()}
+	}
+	return nil
+}
+
+// hzOffsetDiffs: the nodes of a1 whose offset range differs from the same node's in a2 (the
+// trees are the same).
+func hzOffsetDiffs(a1, a2 *celast.AST) []celast.Expr {
+	var out []celast.Expr
+	var walk func(e1, e2 celast.Expr)
+	walk = func(e1, e2 celast.Expr) {
+		if e1 == nil || e2 == nil {
+			return
+		}
+		r1, ok1 := a1.SourceInfo().GetOffsetRange(e1.ID())
+		r2, ok2 := a2.SourceInfo().GetOffsetRange(e2.ID())
+		if ok1 != ok2 || r1 != r2 {
+			out = append(out, e1)
+		}
+		c1, c2 := hzChildren(e1), hzChildren(e2)
+		for i := range c1 {
+			if i < len(c2) {
+				walk(c1[i], c2[i])
+			}
+		}
+	}
+	walk(a1.Expr(), a2.Expr())
+	return out
+}
+
+// hzNonASCIIText reports whether the literal is a string or bytes value with a byte past ASCII.
+func hzNonASCIIText(e celast.Expr) bool {
+	if e.Kind() != celast.LiteralKind {
+		return false
+	}
+	var text string
+	switch v := e.AsLiteral().(type) {
+	case types.String:
+		text = string(v)
+	case types.Bytes:
+		text = string(v)
+	default:
+		return false
+	}
+	for i := 0; i < len(text); i++ {
+		if text[i] >= 0x80 {
+			return true
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- parsers
+
+func hzParser(t testing.TB, pratt bool) *parser.Parser {
+	p, err := parser.NewParser(parser.Macros(parser.AllMacros...), parser.PopulateMacroCalls(true),
+		parser.EnableOptionalSyntax(true), parser.EnablePrattParser(pratt))
+	if err != nil {
+		t.Fatalf("parser.NewParser: %v", err)
+	}
+	return p
+}
+
+// hzMutation damages a source text: a character or run of characters removed, doubled or
+// replaced, or a fragment inserted; positions are taken modulo the live length.
+type hzMutation struct {
+	kind int // 0: delete a character, 1: double it, 2: insert a fragment, 3: delete a run, 4: double a run, 5: replace a character
+	i, j int
+	ins  string
+	r    rune
+}
+
+var hzFragments = []string{"(", ")", "[", "]", "{", "}", ".", ",", "?", ":", "-", "!", "+", "*", "/", "%", "<", ">", "=", "&", "|", "in", " in ", "'", "\"", "\\", "u", "e", "x", "0", "9", " ", "\n", "//", "b'", "r\"", "@", "#", "`", "\u00a0"}
+
+// hzEmptyFragments: what an empty text is mutated into.
+var hzEmptyFragments = []string{"", "(", ")", "a", "1", "-", "!", "?", ":", "."}
+
+var hzMutations = hegel.Composite(func(tc hegel.TestCase) hzMutation {
+	return hzMutation{
+		kind: hegel.Draw(tc, hegel.Integers(0, 5)),
+		i:    hegel.Draw(tc, positions),
+		j:    hegel.Draw(tc, positions),
+		ins:  hegel.Draw(tc, hegel.SampledFrom(hzFragments)),
+		r:    hegel.Draw(tc, hegel.SampledFrom(hzRunes)),
+	}
+})
+
+func (m hzMutation) apply(s string) string {
+	rs := []rune(s)
+	if len(rs) == 0 {
+		return hzEmptyFragments[m.i%len(hzEmptyFragments)]
+	}
+	i := m.i % len(rs)
+	j := i + m.j%(len(rs)-i+1)
+	switch m.kind {
+	case 0:
+		return string(rs[:i]) + string(rs[i+1:])
+	case 1:
+		return string(rs[:i]) + string(rs[i]) + string(rs[i:])
+	case 2:
+		return string(rs[:i]) + m.ins + string(rs[i:])
+	case 3:
+		return string(rs[:i]) + string(rs[j:])
+	case 4:
+		return string(rs[:i]) + string(rs[i:j]) + string(rs[i:j]) + string(rs[j:])
+	}
+	return string(rs[:i]) + string(m.r) + string(rs[i+1:])
+}
+
+// hzParseCase is an input of the parser comparison: a generated expression, a generated
+// expression with one to three mutations, or a soup of tokens.
+type hzParseCase struct {
+	kind string
+	cs   hzCase
+	muts []hzMutation
+	soup []pair[string, bool] // a token and whether a space follows
+}
+
+func (c hzParseCase) src() string {
+	switch c.kind {
+	case "mutated":
+		s := c.cs.src()
+		for _, m := range c.muts {
+			s = m.apply(s)
+		}
+		return s
+	case "soup":
+		var sb strings.Builder
+		for _, p := range c.soup {
+			sb.WriteString(p.a)
+			if p.b {
+				sb.WriteString(" ")
+			}
+		}
+		return sb.String()
+	}
+	return c.cs.src()
+}
+
+func (c hzParseCase) GoString() string {
+	if c.kind == "mutated" {
+		return fmt.Sprintf("%s: %q\nfrom: %q", c.kind, c.src(), c.cs.src())
+	}
+	return fmt.Sprintf("%s: %q", c.kind, c.src())
+}
+
+// hzParseTexts: the generated cases of the parser comparison, their negative numeric literals
+// written unsigned under HEGEL_NO_KNOWN=1 (cel-go/2).
+var hzParseTexts = hegel.Map(hzCases, func(cs hzCase) hzCase {
+	cs.unsigned = HZKnown.prattNegativeLiteralOffset
+	return cs
+})
+
+var hzParseCases = weighted(
+	choice[hzParseCase]{60, hegel.Map(hzParseTexts, func(cs hzCase) hzParseCase { return hzParseCase{kind: "generated", cs: cs} })},
+	choice[hzParseCase]{30, hegel.Composite(func(tc hegel.TestCase) hzParseCase {
+		return hzParseCase{kind: "mutated", cs: hegel.Draw(tc, hzParseTexts), muts: hegel.Draw(tc, many(hzMutations, 1, 3))}
+	})},
+	choice[hzParseCase]{10, hegel.Map(many(pairs(hegel.SampledFrom(hzSoupTokens), chance(40)), 0, 12), func(soup []pair[string, bool]) hzParseCase {
+		return hzParseCase{kind: "soup", soup: soup}
+	})},
+)
+
+// hzSoupTokens: the tokens of a soup; under HEGEL_NO_KNOWN=1 without the negative literals, the
+// message literal and the leading-dot identifier whose offsets the parsers record differently
+// (cel-go/2).
+var hzSoupTokens = func() []string {
+	if !HZKnown.prattNegativeLiteralOffset {
+		return hzTokens
+	}
+	var out []string
+	for _, t := range hzTokens {
+		switch t {
+		case "-1", "-0x1", "Msg{a: 1}", ".a":
+			continue
+		}
+		out = append(out, t)
+	}
+	return out
+}()
+
+// hzJudgeParsers: both parsers accept or both reject the text, and when both accept the
+// trees, macro calls and offsets are the same (reject messages and positions are counted,
+// not judged).
+func hzJudgeParsers(ht *hegel.T, c *hzCollector, antlr, pratt *parser.Parser, src, kind string) {
+	a1, e1 := antlr.Parse(common.NewTextSource(src))
+	a2, e2 := pratt.Parse(common.NewTextSource(src))
+	ok1 := e1 == nil || len(e1.GetErrors()) == 0
+	ok2 := e2 == nil || len(e2.GetErrors()) == 0
+	if ok1 != ok2 {
+		var msg string
+		var shape []string
+		if !ok1 {
+			msg = "ANTLR rejects: " + e1.ToDisplayString()
+		} else {
+			msg = "Pratt rejects: " + e2.ToDisplayString()
+			switch {
+			case hzLoneComma.MatchString(src):
+				// a lone comma in a list, map or message literal (cel-go/11)
+				if HZKnown.prattRejectsLoneComma {
+					c.count("skipped lone comma")
+					return
+				}
+				shape = shapeIf(true, "cel-go/11")
+			default:
+				// the Pratt lexer takes a numeric literal glued to `in` as one malformed token (cel-go/1)
+				shape = shapeIf(strings.Contains(e2.GetErrors()[0].Message, "literal has unexpected trailing characters"), "cel-go/1")
+			}
+		}
+		c.mismatch(ht, shape, "accept", "the parsers disagree on %q (%s): %s", src, kind, msg)
+		return
+	}
+	if !ok1 {
+		if kind == "generated" {
+			c.failClass(ht, "generated rejected", "the generated expression %q is rejected: %s", src, e1.ToDisplayString())
+			return
+		}
+		c.count("both reject")
+		// the first error's position and message
+		m1, m2 := e1.GetErrors()[0], e2.GetErrors()[0]
+		if m1.Location.Line() != m2.Location.Line() || m1.Location.Column() != m2.Location.Column() {
+			c.count("reject position differs")
+		} else if m1.Message != m2.Message {
+			c.count("reject message differs")
+		} else {
+			c.count("reject same")
+		}
+		if len(e1.GetErrors()) != len(e2.GetErrors()) {
+			c.count("reject count differs")
+		}
+		return
+	}
+	if kind == "generated" {
+		c.count("generated accepted")
+	} else {
+		c.count("both accept")
+	}
+	d1, d2 := hzDump(a1.Expr()), hzDump(a2.Expr())
+	if d1 != d2 {
+		c.failClass(ht, "tree", "the parsers give different trees for %q (%s):\n  ANTLR: %s\n  Pratt: %s", src, kind, d1, d2)
+		return
+	}
+	m1, o1 := hzDumpInfo(a1)
+	m2, o2 := hzDumpInfo(a2)
+	if m1 != m2 {
+		c.failClass(ht, "macros", "the parsers give different macro calls for %q:\n  ANTLR: %s\n  Pratt: %s", src, m1, m2)
+	}
+	if o1 != o2 {
+		// the ANTLR parser's range of a string or bytes literal with a non-ASCII character ends
+		// in bytes (cel-go/10); negative numeric literals, leading-dot identifiers and message
+		// literals (cel-go/2)
+		diffs := hzOffsetDiffs(a1, a2)
+		known := true
+		texts := 0
+		for _, e := range diffs {
+			switch {
+			case hzNonASCIIText(e):
+				texts++
+			case e.Kind() == celast.LiteralKind, e.Kind() == celast.IdentKind, e.Kind() == celast.StructKind:
+			default:
+				known = false
+			}
+		}
+		if HZKnown.antlrTextLiteralStopInBytes && known && texts == len(diffs) {
+			c.count("skipped non-ASCII text literal offsets")
+			return
+		}
+		shape := append(shapeIf(known && texts < len(diffs), "cel-go/2"), shapeIf(known && texts > 0, "cel-go/10")...)
+		c.tolerated(ht, shape, "offsets", "the parsers give different offsets for %q:\n  ANTLR: %s\n  Pratt: %s", src, o1, o2)
+	}
+}
+
+// TestHegelParsers: the Pratt parser is a drop-in for the ANTLR parser. On a generated
+// expression, on a damaged copy of it and on a random token string, both accept or both
+// reject, and when both accept the trees, macro calls and offsets are the same.
+func TestHegelParsers(t *testing.T) {
+	antlr := hzParser(t, false)
+	pratt := hzParser(t, true)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		pc := hegel.Draw(ht, hzParseCases)
+		c.count(pc.kind)
+		hzJudgeParsers(ht, c, antlr, pratt, pc.src(), pc.kind)
+	})
+}
