+// --------------------------------------------------------------------------- cel-go/6
+
+// hzConstUnaries: a conversion of a constant that errors (int('x'), string(b'\xff'), uint(-1),
+// int(1e300); the shape of cel-go/6), or under HEGEL_NO_KNOWN=1 one that succeeds.
+var hzConstUnaries = shaped(hegel.OneOf(
+	hegel.Map(hegel.SampledFrom([]string{"x", "abc", "1.5", ""}), func(s string) *hzNode { return hzConvNode(hzTInt, hzLit(hzStr(s))) }),
+	hegel.Map(hegel.SampledFrom([]string{"x", "-1", "1.5"}), func(s string) *hzNode { return hzConvNode(hzTUint, hzLit(hzStr(s))) }),
+	hegel.Map(hegel.SampledFrom([]string{"abc", "x", ""}), func(s string) *hzNode { return hzConvNode(hzTDouble, hzLit(hzStr(s))) }),
+	hegel.Map(hegel.SampledFrom([]string{"yes", "x", "2"}), func(s string) *hzNode { return hzConvNode(hzTBool, hzLit(hzStr(s))) }),
+	hegel.Map(hegel.SampledFrom([][]byte{{0xff}, {0xc3}, {'a', 0xfe}}), func(b []byte) *hzNode { return hzConvNode(hzTString, hzLit(hzBytes(b))) }),
+	hegel.Map(hegel.Integers[int64](-1000, -1), func(i int64) *hzNode { return hzConvNode(hzTUint, hzLit(hzInt(i))) }),
+	hegel.Map(hegel.SampledFrom([]float64{1e300, -1e300, 1e19}), func(d float64) *hzNode { return hzConvNode(hzTInt, hzLit(hzDouble(d))) }),
+), hegel.OneOf(
+	hegel.Map(hegel.Integers[int64](-1000, 1000), func(i int64) *hzNode { return hzConvNode(hzTInt, hzLit(hzStr(hzConvert(hzTString, hzInt(i)).s))) }),
+	hegel.Map(hegel.Integers[uint64](0, 1000), func(u uint64) *hzNode { return hzConvNode(hzTUint, hzLit(hzStr(hzConvert(hzTString, hzUint(u)).s))) }),
+	hegel.Map(hegel.SampledFrom([]string{"1.5", "2", "-0.25"}), func(s string) *hzNode { return hzConvNode(hzTDouble, hzLit(hzStr(s))) }),
+	hegel.Map(hegel.SampledFrom([]string{"true", "false", "1"}), func(s string) *hzNode { return hzConvNode(hzTBool, hzLit(hzStr(s))) }),
+	hegel.Map(hegel.SampledFrom([]string{"ab", "", "\u00e9"}), func(s string) *hzNode { return hzConvNode(hzTString, hzLit(hzBytes([]byte(s)))) }),
+	hegel.Map(hegel.Integers[int64](0, 1000), func(i int64) *hzNode { return hzConvNode(hzTUint, hzLit(hzInt(i))) }),
+	hegel.Map(hegel.SampledFrom([]float64{2.5, -3, 1e10}), func(d float64) *hzNode { return hzConvNode(hzTInt, hzLit(hzDouble(d))) }),
+))
