+// --------------------------------------------------------------------------- cel-go/5
+
+// hzRepeatedKeyCases: a map literal of one to three entries of literal or variable keys and
+// values, with one key repeated - the same node again, or the literal of an existing key's
+// value - (the shape of cel-go/5; no repetition under HEGEL_NO_KNOWN=1, and a chance collision
+// is dropped), bare, indexed by one of its keys or measured.
+var hzRepeatedKeyCases = hegel.Composite(func(tc hegel.TestCase) hzCase {
+	mt := hegel.Draw(tc, hegel.SampledFrom([]hzType{hzTMSI, hzTMIS}))
+	entries := hegel.Draw(tc, many(pairs(hzLeavesOf(*mt.key), hzLeavesOf(*mt.val)), 1, 3))
+	env := hegel.Draw(tc, hzBindings)
+	if shaped(true, false) {
+		at := hegel.Draw(tc, positions) % len(entries)
+		key := entries[at].a
+		if hegel.Draw(tc, chance(50)) {
+			key = hzLit(hzEvalNode(key, env))
+		}
+		dup := pair[*hzNode, *hzNode]{key, hegel.Draw(tc, hzLeavesOf(*mt.val))}
+		where := hegel.Draw(tc, positions) % (len(entries) + 1)
+		entries = append(entries[:where], append([]pair[*hzNode, *hzNode]{dup}, entries[where:]...)...)
+	}
+	expr := hzMapNode(mt, entries)
+	switch hegel.Draw(tc, hegel.Integers(0, 2)) {
+	case 1:
+		// indexed by one of its own keys (the model's map is an error, so a pick would be the zero key)
+		expr = hzIndexNode(expr, entries[hegel.Draw(tc, positions)%len(entries)].a)
+	case 2:
+		expr = hzSizeNode(expr)
+	}
+	return hzShapeless(hzCase{env: env, expr: expr, tape: hegel.Draw(tc, hzTapes), in: hzInDefault})
+})
+
+// TestHegelMapLiteralRepeatedKeyIsAnError: a map literal with two entries whose keys are equal
+// evaluates to an error, as the specification's Aggregate Values require; cel-go builds the
+// map with the last entry (cel-go/5).
+func TestHegelMapLiteralRepeatedKeyIsAnError(t *testing.T) {
+	env := hzEnv(t)
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzJudge(ht, c, env, hegel.Draw(ht, hzRepeatedKeyCases), true)
+	})
+}
