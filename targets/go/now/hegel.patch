+package now_test
+
+// Hegel property tests for github.com/jinzhu/now.
+//
+// The oracle is Go's own time package: the beginning of a unit is the first
+// instant whose wall clock, in the time's location, lies in that unit (the
+// minute, hour, day, week starting on WeekStartDay, month, quarter, half
+// year or year), the end is the last such instant, and the README's examples
+// fix the rest - EndOf* is one nanosecond before the next beginning, Monday
+// is the Monday on or before the date (a Sunday belongs to the week of the
+// Monday six days earlier), Sunday is the Sunday on or after it, and Parse
+// fills the fields a string does not carry from the "now" it is given: a
+// time-only string is today, a month-day string is this year, a date-only
+// string is the day's first instant. Locations come from the IANA database
+// (via time/tzdata) and from fixed zones, so daylight-saving transitions
+// inside a unit and at its boundaries are exercised: the shapes of the
+// recorded bugs (bugs.toml) are drawn by default and the properties that meet
+// them fail, naming what they meet; each bug also has a property over its
+// shape region alone (the section before the pins). HEGEL_NO_KNOWN=1 switches
+// the known shapes off (noKnown, in the harness), for a run that looks past
+// the bugs.
+//
+// Every property draws one case record from generators that are package-level
+// values and renders it with pure functions; the records carry a GoString for
+// the draw report.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	_ "time/tzdata"
+
+	"github.com/jinzhu/now"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+const stamp = "2006-01-02 15:04:05.000000000 -07:00:00 MST Mon"
+
+func fmtT(t time.Time) string { return t.Format(stamp) }
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml). By default the
+// generators draw their shapes - a fixed zone with a sub-minute offset (now/1), an instant
+// within two hours of a transition (now/2), a unit whose boundary midnight is missing (now/3,
+// now/4) or whose last hour repeats (now/5), a week across a skipped date (now/6), a fraction
+// of other than 3, 6 or 9 digits (now/7), a Kitchen string (now/8), a month-day string after
+// a time (now/9), a date before a time (now/10), a date-only string for a day without a
+// midnight (now/11) - and the properties that meet them fail; the pins are the regression
+// examples beside them. Under HEGEL_NO_KNOWN=1 the wide case generators are filtered by the
+// shape tests (gated) and the per-bug properties draw the neighbouring region instead
+// (shaped). Read once.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// gated is g, or under HEGEL_NO_KNOWN=1 g without the cases that have a known shape.
+func gated[T any](g hegel.Generator[T], clean func(T) bool) hegel.Generator[T] {
+	if noKnown {
+		return hegel.Filter(g, clean)
+	}
+	return g
+}
+
+// shaped is the known-bug shape, or under HEGEL_NO_KNOWN=1 the neighbouring one past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// chance is true pct percent of the time; it shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// ---------------------------------------------------------------------------
+// Locations and instants.
+
+var zoneNames = []string{
+	"UTC", "America/New_York", "Europe/London", "Europe/Berlin", "Asia/Kolkata", "Asia/Kathmandu",
+	"Australia/Lord_Howe", "Pacific/Chatham", "America/Havana", "America/Sao_Paulo", "Pacific/Apia",
+	"Asia/Tehran", "Africa/Casablanca", "America/Santiago", "Australia/Sydney", "Africa/Cairo",
+	"America/Asuncion", "Asia/Beirut", "Pacific/Auckland", "America/St_Johns",
+}
+
+var locations = func() map[string]*time.Location {
+	out := map[string]*time.Location{}
+	for _, name := range zoneNames {
+		loc, err := time.LoadLocation(name)
+		if err != nil {
+			panic(err)
+		}
+		out[name] = loc
+	}
+	return out
+}()
+
+// zone is a location: one of the IANA zones by name, or a fixed zone with an offset of up to
+// fourteen hours in seconds (a sub-minute offset, the shape of every local mean time, is
+// now/1; under HEGEL_NO_KNOWN=1 the offset is a whole number of minutes).
+type zone struct {
+	name string // the IANA name; "" for a fixed zone
+	secs int    // the fixed zone's offset in seconds
+}
+
+func (z zone) loc() *time.Location {
+	if z.name != "" {
+		return locations[z.name]
+	}
+	return time.FixedZone(fmt.Sprintf("F%+ds", z.secs), z.secs)
+}
+
+func ianaZone(name string) zone { return zone{name: name} }
+
+var (
+	ianaZones  = hegel.Map(hegel.SampledFrom(zoneNames), ianaZone)
+	offsets    = shaped(hegel.Integers(-14*3600, 14*3600), hegel.Map(hegel.Integers(-14*60, 14*60), func(m int) int { return m * 60 }))
+	fixedZones = hegel.Map(offsets, func(secs int) zone { return zone{secs: secs} })
+	// zones: an IANA zone, or a fixed zone three times in twenty.
+	zones = weighted(choice[zone]{85, ianaZones}, choice[zone]{15, fixedZones})
+)
+
+// clock is the wall clock of an instant.
+type clock struct{ h, mi, s, ns int }
+
+var (
+	hours   = hegel.Integers(0, 23)
+	minutes = hegel.Integers(0, 59)
+	seconds = hegel.Integers(0, 59)
+	nanos   = hegel.Integers(0, 999999999)
+
+	anyClocks = hegel.Composite(func(tc hegel.TestCase) clock {
+		return clock{h: hegel.Draw(tc, hours), mi: hegel.Draw(tc, minutes), s: hegel.Draw(tc, seconds), ns: hegel.Draw(tc, nanos)}
+	})
+	// clocks: midnight, the last nanosecond of the day, the top of an hour, a whole second,
+	// or any clock (twice as often), so that the boundaries are hit.
+	clocks = hegel.OneOf(
+		hegel.Just(clock{}),
+		hegel.Just(clock{23, 59, 59, 999999999}),
+		hegel.Map(hours, func(h int) clock { return clock{h: h} }),
+		hegel.Composite(func(tc hegel.TestCase) clock {
+			return clock{h: hegel.Draw(tc, hours), mi: hegel.Draw(tc, minutes), s: hegel.Draw(tc, seconds)}
+		}),
+		anyClocks,
+		anyClocks,
+	)
+)
+
+// instant is a wall clock in a zone: a calendar date (the day may run past the month's end;
+// time.Date normalises it), a clock, and a shift of up to three hours either way (three
+// times in ten), so that instants inside transition hours are reached as absolute times too.
+type instant struct {
+	y     int
+	m     time.Month
+	d     int
+	clock clock
+	shift int // seconds
+}
+
+func (i instant) at(loc *time.Location) time.Time {
+	return time.Date(i.y, i.m, i.d, i.clock.h, i.clock.mi, i.clock.s, i.clock.ns, loc).Add(time.Duration(i.shift) * time.Second)
+}
+
+// instants: years 1975-2060.
+var instants = hegel.Composite(func(tc hegel.TestCase) instant {
+	return instant{
+		y:     hegel.Draw(tc, hegel.Integers(1975, 2060)),
+		m:     time.Month(hegel.Draw(tc, hegel.Integers(1, 12))),
+		d:     hegel.Draw(tc, hegel.Integers(1, 31)),
+		clock: hegel.Draw(tc, clocks),
+		shift: hegel.Draw(tc, shifts),
+	}
+})
+
+// ---------------------------------------------------------------------------
+// The model.
+
+func mid(y int, m time.Month, d int, loc *time.Location) time.Time {
+	return time.Date(y, m, d, 0, 0, 0, 0, loc)
+}
+
+func offsetOf(t time.Time) int {
+	_, off := t.Zone()
+	return off
+}
+
+// firstWhere is the first instant in (lo, hi] satisfying ok, given that lo does not and hi
+// does and that ok changes once between them (there is one transition at most).
+func firstWhere(lo, hi time.Time, ok func(time.Time) bool) time.Time {
+	for hi.Sub(lo) > time.Nanosecond {
+		mid := lo.Add(hi.Sub(lo) / 2)
+		if ok(mid) {
+			hi = mid
+		} else {
+			lo = mid
+		}
+	}
+	return hi
+}
+
+// sinceHour and sinceMinute are the wall clock's distance into its hour and minute.
+func sinceHour(t time.Time) time.Duration {
+	return time.Duration(t.Minute())*time.Minute + sinceMinute(t)
+}
+
+func sinceMinute(t time.Time) time.Duration {
+	return time.Duration(t.Second())*time.Second + time.Duration(t.Nanosecond())
+}
+
+// hourKey is the wall date and hour of an instant.
+func hourKey(t time.Time) [4]int {
+	y, m, d := t.Date()
+	return [4]int{y, int(m), d, t.Hour()}
+}
+
+// minuteBegin is the top of t's wall minute: t less its seconds and nanoseconds (an offset
+// need not be a whole number of minutes, so the instant is not truncated).
+func minuteBegin(t time.Time) time.Time { return t.Add(-sinceMinute(t)) }
+
+// hourBegin is the top of t's wall hour: t less its minutes, seconds and nanoseconds, or,
+// when that instant has another wall hour (the hour began at a transition, as Lord Howe's
+// 02:30), the first instant after it with t's wall date and hour. An hour that occurs twice
+// has two beginnings, each its own.
+func hourBegin(t time.Time) time.Time {
+	c := t.Add(-sinceHour(t))
+	key := hourKey(t)
+	if hourKey(c) == key {
+		return c
+	}
+	return firstWhere(c, t, func(x time.Time) bool { return hourKey(x) == key })
+}
+
+// hourEnd is the last instant whose wall date and hour are t's: the first instant after t
+// whose wall hour differs, less a nanosecond. Across a transition the hour may be shorter
+// or longer than sixty minutes.
+func hourEnd(t time.Time) time.Time {
+	key := hourKey(t)
+	x := t
+	for {
+		next := x.Add(time.Hour - sinceHour(x)) // the next top of an hour by the clock
+		if hourKey(next) != key {
+			return firstWhere(x, next, func(y time.Time) bool { return hourKey(y) != key }).Add(-time.Nanosecond)
+		}
+		x = next
+	}
+}
+
+// cleanAround reports whether the zone offset is constant within three hours
+// of x: no transition nearby, so wall clocks near x are unambiguous (a
+// setback of two hours, St John's 1988, repeats the tops of the hours up to
+// three hours after it). It is the shape test of now/2 (an instant within
+// three hours of a transition).
+func cleanAround(x time.Time) bool {
+	off := offsetOf(x)
+	for _, k := range []int{-3, -2, -1, 1, 2, 3} {
+		if offsetOf(x.Add(time.Duration(k)*time.Hour)) != off {
+			return false
+		}
+	}
+	return true
+}
+
+// cleanMidnight reports whether midnight of the civil date exists, is
+// unique and has no transition within two hours (the pinned shapes now/3,
+// now/4 and now/5 are transitions at or near a midnight).
+func cleanMidnight(y int, m time.Month, d int, loc *time.Location) bool {
+	x := mid(y, m, d, loc)
+	yy, mm, dd := x.Date()
+	if yy != y || mm != m || dd != d || x.Hour() != 0 || x.Minute() != 0 || x.Second() != 0 {
+		return false
+	}
+	return cleanAround(x)
+}
+
+// civil is a calendar date; arithmetic goes through UTC, which has no
+// transitions.
+type civil struct {
+	y int
+	m time.Month
+	d int
+}
+
+func dateOf(t time.Time) civil {
+	y, m, d := t.Date()
+	return civil{y, m, d}
+}
+
+func (c civil) addDays(k int) civil {
+	return dateOf(time.Date(c.y, c.m, c.d+k, 12, 0, 0, 0, time.UTC))
+}
+
+func (c civil) addMonths(k int) civil {
+	return dateOf(time.Date(c.y, c.m+time.Month(k), c.d, 12, 0, 0, 0, time.UTC))
+}
+
+func (c civil) weekday() time.Weekday {
+	return time.Date(c.y, c.m, c.d, 12, 0, 0, 0, time.UTC).Weekday()
+}
+
+func (c civil) before(o civil) bool {
+	if c.y != o.y {
+		return c.y < o.y
+	}
+	if c.m != o.m {
+		return c.m < o.m
+	}
+	return c.d < o.d
+}
+
+// start is the first instant of the date in loc: its midnight when that exists, else the
+// first instant past the transition that swallowed it (Havana's 01:00 CDT on 2025-03-09), or,
+// for a date the calendar skipped (Apia's 30 December 2011), the first instant of the next
+// date. time.Date alone is not it: for a missing midnight it "returns a time that is correct
+// in one of the two zones", which may be 23:00 of the day before.
+func (c civil) start(loc *time.Location) time.Time {
+	on := func(x time.Time) bool { return !dateOf(x).before(c) }
+	hi := mid(c.y, c.m, c.d, loc)
+	for !on(hi) {
+		hi = hi.Add(time.Hour)
+	}
+	lo := hi.Add(-time.Hour)
+	for on(lo) {
+		lo = lo.Add(-time.Hour)
+	}
+	return firstWhere(lo, hi, on)
+}
+
+// clean is the shape test of now/3, now/4 and now/5: the date's midnight exists, is unique
+// and has no transition within two hours.
+func (c civil) clean(loc *time.Location) bool { return cleanMidnight(c.y, c.m, c.d, loc) }
+
+// first is the first of c's month.
+func (c civil) first() civil { return civil{c.y, c.m, 1} }
+
+// weekStart is the date of the week's first day on or before c.
+func (c civil) weekStart(start time.Weekday) civil {
+	return c.addDays(-int((c.weekday() - start + 7) % 7))
+}
+
+// isoMonday is the Monday on or before c (a Sunday belongs to the week of
+// the Monday six days earlier), as the README defines Monday().
+func (c civil) isoMonday() civil {
+	wd := int(c.weekday())
+	if wd == 0 {
+		wd = 7
+	}
+	return c.addDays(-wd + 1)
+}
+
+// nextSunday is the Sunday on or after c, as the README defines Sunday().
+func (c civil) nextSunday() civil {
+	wd := int(c.weekday())
+	if wd == 0 {
+		wd = 7
+	}
+	return c.addDays(7 - wd)
+}
+
+// unit is one of now's calendar units with its model.
+type unit struct {
+	name  string
+	begin func(*now.Now) time.Time
+	end   func(*now.Now) time.Time
+	// span gives the first date of the unit containing c and the first
+	// date of the next unit.
+	span func(c civil, start time.Weekday) (from, to civil)
+}
+
+var calendarUnits = []unit{
+	{"Day", (*now.Now).BeginningOfDay, (*now.Now).EndOfDay,
+		func(c civil, _ time.Weekday) (civil, civil) { return c, c.addDays(1) }},
+	{"Week", (*now.Now).BeginningOfWeek, (*now.Now).EndOfWeek,
+		func(c civil, start time.Weekday) (civil, civil) {
+			s := c.weekStart(start)
+			return s, s.addDays(7)
+		}},
+	{"Month", (*now.Now).BeginningOfMonth, (*now.Now).EndOfMonth,
+		func(c civil, _ time.Weekday) (civil, civil) {
+			s := civil{c.y, c.m, 1}
+			return s, s.addMonths(1)
+		}},
+	{"Quarter", (*now.Now).BeginningOfQuarter, (*now.Now).EndOfQuarter,
+		func(c civil, _ time.Weekday) (civil, civil) {
+			s := civil{c.y, time.Month(3*((int(c.m)-1)/3) + 1), 1}
+			return s, s.addMonths(3)
+		}},
+	{"Half", (*now.Now).BeginningOfHalf, (*now.Now).EndOfHalf,
+		func(c civil, _ time.Weekday) (civil, civil) {
+			s := civil{c.y, time.Month(6*((int(c.m)-1)/6) + 1), 1}
+			return s, s.addMonths(6)
+		}},
+	{"Year", (*now.Now).BeginningOfYear, (*now.Now).EndOfYear,
+		func(c civil, _ time.Weekday) (civil, civil) {
+			s := civil{c.y, time.January, 1}
+			return s, s.addMonths(12)
+		}},
+}
+
+func withStart(t time.Time, start time.Weekday) *now.Now {
+	return (&now.Config{WeekStartDay: start, TimeFormats: now.TimeFormats}).With(t)
+}
+
+// ---------------------------------------------------------------------------
+// Where the zones' transitions are, and the dates with a recorded shape.
+
+// transitions are, per IANA zone, the instants at which the offset changes between 1974 and
+// 2062 (the instants' years and the units around them), found by comparing the offsets at
+// consecutive UTC midnights and bisecting the day between two that differ.
+var transitions = func() map[string][]time.Time {
+	out := map[string][]time.Time{}
+	end := time.Date(2062, 1, 1, 0, 0, 0, 0, time.UTC)
+	for _, name := range zoneNames {
+		loc := locations[name]
+		for day := time.Date(1974, 1, 1, 0, 0, 0, 0, time.UTC); day.Before(end); day = day.Add(24 * time.Hour) {
+			next := day.Add(24 * time.Hour)
+			if from := offsetOf(day.In(loc)); from != offsetOf(next.In(loc)) {
+				x := firstWhere(day, next, func(t time.Time) bool { return offsetOf(t.In(loc)) != from })
+				out[name] = append(out[name], x.In(loc))
+			}
+		}
+	}
+	return out
+}()
+
+// shapeDates are, per IANA zone, the dates of the recorded calendar shapes: noMidnight, the
+// dates without a 00:00 wall time (daylight saving starting at midnight: now/3, now/4,
+// now/11); repeatedEnd, the dates whose 23:59:59.999999999 occurs twice (daylight saving
+// ending at midnight: now/5); skipped, the dates the calendar left out (Apia's 30 December
+// 2011: now/6). Each is decided by comparing time.Date's answer with the date's start.
+type shapeDates struct{ noMidnight, repeatedEnd, skipped []civil }
+
+var shapes = func() map[string]shapeDates {
+	out := map[string]shapeDates{}
+	for _, name := range zoneNames {
+		loc := locations[name]
+		var s shapeDates
+		for _, x := range transitions[name] {
+			// the date before the transition, its own, and any skipped between them
+			before := dateOf(x.Add(-time.Nanosecond))
+			for c, last := before, dateOf(x); !last.before(c); c = c.addDays(1) {
+				start := c.start(loc)
+				if dateOf(start) != c {
+					s.skipped = append(s.skipped, c)
+					continue
+				}
+				if start.Hour() != 0 || start.Minute() != 0 || start.Second() != 0 {
+					s.noMidnight = append(s.noMidnight, c)
+				}
+				if eod := time.Date(c.y, c.m, c.d, 23, 59, 59, 999999999, loc); !eod.Equal(c.addDays(1).start(loc).Add(-time.Nanosecond)) {
+					s.repeatedEnd = append(s.repeatedEnd, c)
+				}
+			}
+		}
+		out[name] = s
+	}
+	return out
+}()
+
+// zonesWith are the IANA zones that have at least one of the dates pick selects.
+func zonesWith(pick func(shapeDates) []civil) []string {
+	var names []string
+	for _, name := range zoneNames {
+		if len(pick(shapes[name])) > 0 {
+			names = append(names, name)
+		}
+	}
+	return names
+}
+
+// datedZone is an IANA zone and one of its dates of a shape.
+type datedZone struct {
+	zone zone
+	date civil
+}
+
+// datedZones draws a zone among those that have the shape and one of its dates.
+func datedZones(pick func(shapeDates) []civil) hegel.Generator[datedZone] {
+	return hegel.FlatMap(hegel.SampledFrom(zonesWith(pick)), func(name string) hegel.Generator[datedZone] {
+		return hegel.Map(hegel.SampledFrom(pick(shapes[name])), func(c civil) datedZone { return datedZone{ianaZone(name), c} })
+	})
+}
+
+var (
+	noMidnightDates  = func(s shapeDates) []civil { return s.noMidnight }
+	repeatedEndDates = func(s shapeDates) []civil { return s.repeatedEnd }
+	skippedDates     = func(s shapeDates) []civil { return s.skipped }
+	firstsNoMidnight = func(s shapeDates) []civil {
+		var out []civil
+		for _, c := range s.noMidnight {
+			if c.d == 1 {
+				out = append(out, c)
+			}
+		}
+		return out
+	}
+)
+
+// instantOn is an instant on the civil date (a clock and a shift, as instants draws them).
+func instantOn(c civil, clock clock, shift int) instant {
+	return instant{y: c.y, m: c.m, d: c.d, clock: clock, shift: shift}
+}
+
+var shifts = maybe(30, hegel.Integers(-3*3600, 3*3600))
+
+// ---------------------------------------------------------------------------
+// Property: the calendar units begin and end where the calendar says.
+
+// calendarCase: the zone, the instant, the week's first day and the unit (an index into
+// calendarUnits).
+type calendarCase struct {
+	zone  zone
+	t     instant
+	start time.Weekday
+	unit  int
+}
+
+func (c calendarCase) GoString() string {
+	return fmt.Sprintf("%s of %s (week start %s)", calendarUnits[c.unit].name, fmtT(c.t.at(c.zone.loc())), c.start)
+}
+
+// clean is the shape test of now/3, now/4, now/5 and now/6 for the case: the unit's own
+// boundaries, the midnight of the instant's date (weeks are computed from BeginningOfDay)
+// and of the unit's last day (the end's own date, from which the end is asked again) have a
+// clean midnight, and for the units from the month up (computed from BeginningOfMonth) so
+// have the first of the instant's month and of the last day's. By default the shapes are
+// drawn; under HEGEL_NO_KNOWN=1 the case generator is filtered by it.
+func (c calendarCase) clean() bool {
+	loc := c.zone.loc()
+	d := dateOf(c.t.at(loc))
+	from, to := calendarUnits[c.unit].span(d, c.start)
+	last := to.addDays(-1)
+	if !(from.clean(loc) && to.clean(loc) && d.clean(loc) && last.clean(loc)) {
+		return false
+	}
+	return calendarUnits[c.unit].name == "Day" || calendarUnits[c.unit].name == "Week" ||
+		(d.first().clean(loc) && last.first().clean(loc))
+}
+
+var (
+	weekdays  = hegel.Map(hegel.Integers(0, 6), func(d int) time.Weekday { return time.Weekday(d) })
+	unitIndex = hegel.Integers(0, len(calendarUnits)-1)
+
+	calendarCases = gated(hegel.Composite(func(tc hegel.TestCase) calendarCase {
+		return calendarCase{zone: hegel.Draw(tc, zones), t: hegel.Draw(tc, instants), start: hegel.Draw(tc, weekdays), unit: hegel.Draw(tc, unitIndex)}
+	}), calendarCase.clean)
+)
+
+// calendarUnitsAgree judges one case: the unit begins at the first instant of its first date
+// and ends a nanosecond before the first instant of the next unit's first date, is
+// idempotent and closed, and the package-level WeekStartDay path agrees with the Config path.
+func calendarUnitsAgree(ht *hegel.T, c calendarCase) {
+	loc, start, u := c.zone.loc(), c.start, calendarUnits[c.unit]
+	tt := c.t.at(loc)
+	d := dateOf(tt)
+	from, to := u.span(d, start)
+
+	nw := withStart(tt, start)
+	wantB := from.start(loc)
+	wantE := to.start(loc).Add(-time.Nanosecond)
+	gotB := u.begin(nw)
+	gotE := u.end(nw)
+	if !gotB.Equal(wantB) || gotB.Location() != loc {
+		ht.Fatalf("BeginningOf%s(%s, week start %s) = %s, want %s", u.name, fmtT(tt), start, fmtT(gotB), fmtT(wantB))
+	}
+	if !gotE.Equal(wantE) || gotE.Location() != loc {
+		ht.Fatalf("EndOf%s(%s, week start %s) = %s, want %s", u.name, fmtT(tt), start, fmtT(gotE), fmtT(wantE))
+	}
+	// Idempotence and closure.
+	if b2 := u.begin(withStart(gotB, start)); !b2.Equal(gotB) {
+		ht.Fatalf("BeginningOf%s is not idempotent: %s -> %s", u.name, fmtT(gotB), fmtT(b2))
+	}
+	if e2 := u.end(withStart(gotE, start)); !e2.Equal(gotE) {
+		ht.Fatalf("EndOf%s is not idempotent: %s -> %s", u.name, fmtT(gotE), fmtT(e2))
+	}
+	if b3 := u.begin(withStart(gotE, start)); !b3.Equal(gotB) {
+		ht.Fatalf("BeginningOf%s(EndOf%s(%s)) = %s, want %s", u.name, u.name, fmtT(tt), fmtT(b3), fmtT(gotB))
+	}
+	// The package-level WeekStartDay and the plain With agree with the
+	// Config path.
+	if u.name == "Week" {
+		old := now.WeekStartDay
+		now.WeekStartDay = start
+		gb, ge := now.With(tt).BeginningOfWeek(), now.With(tt).EndOfWeek()
+		now.WeekStartDay = old
+		if !gb.Equal(wantB) || !ge.Equal(wantE) {
+			ht.Fatalf("now.With with WeekStartDay %s: %s .. %s, want %s .. %s", start, fmtT(gb), fmtT(ge), fmtT(wantB), fmtT(wantE))
+		}
+	}
+	if q := nw.Quarter(); q != uint((int(d.m)-1)/3+1) {
+		ht.Fatalf("Quarter(%s) = %d", fmtT(tt), q)
+	}
+}
+
+// TestHegelCalendarUnitsBeginAndEndOnTheCalendar: the calendar units of a random instant in a
+// random zone. The shapes of now/3, now/4, now/5 and now/6 (a missing or repeated wall time
+// at a unit's boundary midnight) are drawn at their natural rate, about one case in a
+// hundred; each has its own property below.
+func TestHegelCalendarUnitsBeginAndEndOnTheCalendar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		calendarUnitsAgree(ht, hegel.Draw(ht, calendarCases))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: minutes and hours begin and end on the clock.
+
+// clockCase: the zone and the instant.
+type clockCase struct {
+	zone zone
+	t    instant
+}
+
+func (c clockCase) GoString() string {
+	return fmt.Sprintf("clock units of %s", fmtT(c.t.at(c.zone.loc())))
+}
+
+// clean is the shape test of now/1 and now/2 for the case: a whole-minute offset and no
+// transition within two hours of the instant.
+func (c clockCase) clean() bool { return c.zone.secs%60 == 0 && cleanAround(c.t.at(c.zone.loc())) }
+
+var clockCases = gated(hegel.Composite(func(tc hegel.TestCase) clockCase {
+	return clockCase{zone: hegel.Draw(tc, zones), t: hegel.Draw(tc, instants)}
+}), clockCase.clean)
+
+// clockUnitsAgree judges one instant in its location: the minute and the hour begin at the
+// top of the wall minute and hour and end a nanosecond before the wall clock leaves them,
+// with idempotence.
+func clockUnitsAgree(ht *hegel.T, loc *time.Location, tt time.Time) {
+	nw := now.With(tt)
+	wantMinB, wantHourB, wantHourE := minuteBegin(tt), hourBegin(tt), hourEnd(tt)
+	checks := []struct {
+		name string
+		got  time.Time
+		want time.Time
+	}{
+		{"BeginningOfMinute", nw.BeginningOfMinute(), wantMinB},
+		{"EndOfMinute", nw.EndOfMinute(), wantMinB.Add(time.Minute - time.Nanosecond)},
+		{"BeginningOfHour", nw.BeginningOfHour(), wantHourB},
+		{"EndOfHour", nw.EndOfHour(), wantHourE},
+	}
+	for _, ck := range checks {
+		if !ck.got.Equal(ck.want) || ck.got.Location() != loc {
+			ht.Fatalf("%s(%s) = %s, want %s", ck.name, fmtT(tt), fmtT(ck.got), fmtT(ck.want))
+		}
+	}
+	if b := now.With(nw.BeginningOfHour()).BeginningOfHour(); !b.Equal(wantHourB) {
+		ht.Fatalf("BeginningOfHour is not idempotent at %s: %s", fmtT(tt), fmtT(b))
+	}
+	if b := now.With(nw.EndOfMinute()).BeginningOfMinute(); !b.Equal(wantMinB) {
+		ht.Fatalf("BeginningOfMinute(EndOfMinute(%s)) = %s", fmtT(tt), fmtT(b))
+	}
+}
+
+// TestHegelClockUnitsBeginAndEndOnTheClock: the minute and hour units of a random instant in
+// a random zone. A fixed zone with a sub-minute offset (now/1) is about one case in seven, an
+// instant within a few hours of a transition (now/2) about one in sixty; each has its own
+// property below.
+func TestHegelClockUnitsBeginAndEndOnTheClock(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, clockCases)
+		loc := c.zone.loc()
+		clockUnitsAgree(ht, loc, c.t.at(loc))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Parse: layouts and their rendering.
+
+// layoutSpec describes one of now's default layouts: how to render a time
+// and which fields the text carries.
+type layoutSpec struct {
+	layout   string
+	hasDate  bool // year, month and day (or the fields present)
+	hasYear  bool
+	hasMonth bool
+	hasDay   bool
+	hasClock bool // at least the hour
+	hasMin   bool
+	hasSec   bool
+	zoned    bool // carries a numeric offset
+}
+
+var dateLayouts = []layoutSpec{
+	{layout: "2006", hasDate: true, hasYear: true},
+	{layout: "2006-1", hasDate: true, hasYear: true, hasMonth: true},
+	{layout: "2006-1-2", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006.1.2", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006.01.02", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "1/2/2006", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006/01/02", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "20060102", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+}
+
+var dateTimeLayouts = []layoutSpec{
+	{layout: "2006-1-2 15", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true},
+	{layout: "2006-1-2 15:4", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true},
+	{layout: "2006-1-2 15:4:5", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: "2006.1.2 15:04:05", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: "2006.01.02 15:04:05", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: "1/2/2006 15:4:5", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: "2006/01/02 15:04:05", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: time.RFC3339, hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true, zoned: true},
+	{layout: "2006-01-02T15:04:05Z0700", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true, zoned: true},
+}
+
+// timeLayouts: the three plain time-only layouts, then time.Kitchen ("3:04PM"), whose
+// strings Parse accepts but does not recognise as times (now/8).
+var timeLayouts = []layoutSpec{
+	{layout: "15:4:5", hasClock: true, hasMin: true, hasSec: true},
+	{layout: "15:4", hasClock: true, hasMin: true},
+	{layout: "15", hasClock: true},
+	{layout: time.Kitchen, hasClock: true, hasMin: true},
+}
+
+var monthDayLayout = layoutSpec{layout: "1-2", hasMonth: true, hasDay: true}
+
+// layouts is every layout the oracle covers, in groups: the date-only ones, the date-time
+// ones, the time-only ones and the month-day one; the *Index generators draw an index into
+// it from one group.
+var (
+	layouts = slices.Concat(dateLayouts, dateTimeLayouts, timeLayouts, []layoutSpec{monthDayLayout})
+
+	firstDateTime = len(dateLayouts)
+	firstTimeOnly = firstDateTime + len(dateTimeLayouts)
+	kitchenIndex  = firstTimeOnly + len(timeLayouts) - 1
+	monthDayIndex = firstTimeOnly + len(timeLayouts)
+
+	// dayIndices: the date-only layouts that carry a day (the two-string form needs one).
+	dayIndices = indices(2, firstDateTime-1)
+	dayIndex   = hegel.SampledFrom(dayIndices)
+	// unzonedDateTimeIndex: the date-time layouts without an offset (the zoned two are last).
+	unzonedDateTimeIndex = hegel.Integers(firstDateTime, firstTimeOnly-3)
+	// timeOnlyIndex: the plain time-only layouts, without Kitchen.
+	timeOnlyIndex = hegel.Integers(firstTimeOnly, kitchenIndex-1)
+	// secondsIndices: the layouts that carry seconds, so that a fraction can follow.
+	secondsIndices = func() []int {
+		var out []int
+		for i, spec := range layouts {
+			if spec.hasSec {
+				out = append(out, i)
+			}
+		}
+		return out
+	}()
+
+	// layoutIndex: an index into layouts from a table in which each group weighs a quarter.
+	// One draw rather than a weighted choice with a draw-free month-day alternative, so that
+	// the shrinker can move between the layouts freely and lands on the first, "2006". The
+	// time-only group holds Kitchen (now/8), or under HEGEL_NO_KNOWN=1 the plain three.
+	layoutIndex = hegel.SampledFrom(evenGroups(
+		indices(0, firstDateTime-1),
+		indices(firstDateTime, firstTimeOnly-1),
+		indices(firstTimeOnly, shaped(kitchenIndex, kitchenIndex-1)),
+		[]int{monthDayIndex},
+	))
+)
+
+// indices is lo..hi.
+func indices(lo, hi int) []int {
+	var out []int
+	for i := lo; i <= hi; i++ {
+		out = append(out, i)
+	}
+	return out
+}
+
+// evenGroups is an index table over the groups in which every group has the same total
+// weight: each member of a group of n is repeated 72/n times.
+func evenGroups(groups ...[]int) []int {
+	var table []int
+	for _, g := range groups {
+		for _, i := range g {
+			table = append(table, slices.Repeat([]int{i}, 72/len(g))...)
+		}
+	}
+	return table
+}
+
+// fractionOf: nanoseconds whose shortest decimal rendering has exactly n digits: a number of
+// n-1 digits, then a non-zero last digit, times the scale that fills nine.
+func fractionOf(n int) hegel.Generator[int] {
+	hi, scale := 1, 1
+	for i := 1; i < n; i++ {
+		hi *= 10
+	}
+	for i := n; i < 9; i++ {
+		scale *= 10
+	}
+	return hegel.Composite(func(tc hegel.TestCase) int {
+		return (hegel.Draw(tc, hegel.Integers(0, hi-1))*10 + hegel.Draw(tc, hegel.Integers(1, 9))) * scale
+	})
+}
+
+// fractionsOf: a fraction of one of the digit counts.
+func fractionsOf(digits ...int) hegel.Generator[int] {
+	gens := make([]hegel.Generator[int], len(digits))
+	for i, n := range digits {
+		gens[i] = fractionOf(n)
+	}
+	return hegel.OneOf(gens...)
+}
+
+var (
+	// regularDigits are the fraction lengths Parse's has-time patterns admit; oddDigits the
+	// others, the shape of now/7.
+	regularDigits = []int{3, 6, 9}
+	oddDigits     = []int{1, 2, 4, 5, 7, 8}
+	// fractions: no fraction seven times in ten, else one of 1 to 9 digits (under
+	// HEGEL_NO_KNOWN=1 one of 3, 6 or 9); regularFractions the same over 3, 6 and 9 only,
+	// for the properties whose shape is elsewhere.
+	fractions        = someFractions(shaped(indices(1, 9), regularDigits))
+	regularFractions = someFractions(regularDigits)
+)
+
+func someFractions(digits []int) hegel.Generator[int] {
+	return weighted(choice[int]{70, hegel.Just(0)}, choice[int]{30, fractionsOf(digits...)})
+}
+
+// render formats v in the layout, appending a fraction to the seconds when
+// asked (Go accepts one after any seconds field).
+func render(spec layoutSpec, v time.Time, frac int) string {
+	layout := spec.layout
+	if spec.hasSec && frac != 0 {
+		v = v.Add(time.Duration(frac))
+		if strings.Contains(layout, "05") {
+			layout = strings.Replace(layout, "05", "05.999999999", 1)
+		} else {
+			layout = strings.Replace(layout, ":5", ":5.999999999", 1)
+		}
+	}
+	return v.Format(layout)
+}
+
+// expectedParse is the time Parse should produce for a string in spec
+// rendered from v, given the reference time base: a string without a clock
+// is the first instant of its date (its midnight, when that exists: now/11);
+// a wall clock the string carries is rebuilt with time.Date, whose call the
+// model shares when that wall clock is missing or repeated.
+func expectedParse(spec layoutSpec, v, base time.Time, frac int) time.Time {
+	y, m, d := base.Date()
+	if spec.hasYear {
+		y = v.Year()
+	}
+	if spec.hasMonth {
+		m = v.Month()
+	} else if spec.hasDate {
+		m = time.January
+	}
+	if spec.hasDay {
+		d = v.Day()
+	} else if spec.hasDate {
+		d = 1
+	}
+	h, mi, s, ns := 0, 0, 0, 0
+	if spec.hasClock {
+		h = v.Hour()
+	}
+	if spec.hasMin {
+		mi = v.Minute()
+	}
+	if spec.hasSec {
+		s = v.Second()
+		ns = frac
+	}
+	loc := base.Location()
+	if spec.zoned {
+		_, off := v.Zone()
+		if off == 0 {
+			loc = time.UTC
+		} else {
+			loc = time.FixedZone("", off)
+		}
+	}
+	if !spec.hasClock {
+		return civil{y, m, d}.start(loc)
+	}
+	return time.Date(y, m, d, h, mi, s, ns, loc)
+}
+
+// parsable: the fields of a time whose rendering in a layout is unambiguous: years
+// 1970-2100 (three times in five) or 1000-2999, days 1-28, and for a zoned layout a
+// whole-minute offset, in which the time is then expressed.
+type parsable struct {
+	y                int
+	m                time.Month
+	d, h, mi, s, off int
+	zoned            bool
+}
+
+func (p parsable) at(loc *time.Location) time.Time {
+	v := time.Date(p.y, p.m, p.d, p.h, p.mi, p.s, 0, loc)
+	if p.zoned {
+		v = v.In(time.FixedZone("", p.off*60))
+	}
+	return v
+}
+
+var years = weighted(choice[int]{60, hegel.Integers(1970, 2100)}, choice[int]{40, hegel.Integers(1000, 2999)})
+
+func parsablesOf(zoned bool) hegel.Generator[parsable] {
+	offsets := hegel.Just(0)
+	if zoned {
+		offsets = hegel.Integers(-14*60, 14*60)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) parsable {
+		return parsable{
+			y:     hegel.Draw(tc, years),
+			m:     time.Month(hegel.Draw(tc, hegel.Integers(1, 12))),
+			d:     hegel.Draw(tc, hegel.Integers(1, 28)),
+			h:     hegel.Draw(tc, hours),
+			mi:    hegel.Draw(tc, minutes),
+			s:     hegel.Draw(tc, seconds),
+			off:   hegel.Draw(tc, offsets),
+			zoned: zoned,
+		}
+	})
+}
+
+var plainParsables, zonedParsables = parsablesOf(false), parsablesOf(true)
+
+// same compares instant, offset and wall clock; the zone abbreviation is
+// left out because ParseInLocation reuses the location's zone when the
+// parsed offset matches it (documented Go behaviour).
+func same(a, b time.Time) bool {
+	const noName = "2006-01-02 15:04:05.000000000 -07:00:00"
+	return a.Equal(b) && a.Format(noName) == b.Format(noName)
+}
+
+// ---------------------------------------------------------------------------
+// Property: Parse fills the missing fields from "now".
+
+// parseCase: the zone and the "now"; the layout (an index into layouts), the time to render
+// in it and its fraction; and, for a time-only layout, the layout of a date (a date-only
+// layout with a day, or the month-day one: now/9) and the time to render in it for the
+// two-string form (dateLayout is -1 otherwise), with the order of the two strings: the
+// clock then the date, or the date then the clock (now/10).
+type parseCase struct {
+	zone       zone
+	base       instant
+	layout     int
+	v          parsable
+	frac       int
+	dateLayout int
+	dv         parsable
+	dateFirst  bool
+}
+
+func (c parseCase) spec() layoutSpec { return layouts[c.layout] }
+
+func (c parseCase) text() string { return render(c.spec(), c.v.at(c.zone.loc()), c.frac) }
+
+func (c parseCase) want() time.Time {
+	loc := c.zone.loc()
+	return expectedParse(c.spec(), c.v.at(loc), c.base.at(loc), c.frac)
+}
+
+func (c parseCase) dateText() string { return render(layouts[c.dateLayout], c.dv.at(c.zone.loc()), 0) }
+
+// strs are the two strings of the two-string form in the order they are given.
+func (c parseCase) strs() []string {
+	if c.dateFirst {
+		return []string{c.dateText(), c.text()}
+	}
+	return []string{c.text(), c.dateText()}
+}
+
+// want2 is the answer of the two-string form, in either order: the date string's date (the
+// month-day layout takes the year from the time string's answer) at the time string's clock.
+func (c parseCase) want2() time.Time {
+	loc := c.zone.loc()
+	w := c.want()
+	d := dateOf(expectedParse(layouts[c.dateLayout], c.dv.at(loc), w, 0))
+	return time.Date(d.y, d.m, d.d, w.Hour(), w.Minute(), w.Second(), w.Nanosecond(), loc)
+}
+
+func (c parseCase) GoString() string {
+	s := fmt.Sprintf("Parse(%q) [%s] with now = %s", c.text(), c.spec().layout, fmtT(c.base.at(c.zone.loc())))
+	if c.dateLayout >= 0 {
+		s += fmt.Sprintf("; Parse(%q, %q) [%s]", c.strs()[0], c.strs()[1], layouts[c.dateLayout].layout)
+	}
+	return s
+}
+
+// clean is the shape test of now/7 to now/11 for the case: a fraction of 3, 6 or 9 digits, a
+// layout other than Kitchen, the two-string form with a date-only layout in the order the
+// clock then the date, and an expected wall time away from a transition (a date whose
+// midnight does not exist, or today's skipped hour; the date string of the two-string form
+// is parsed as its midnight first, so that midnight must be clean too). By default the
+// shapes are drawn; under HEGEL_NO_KNOWN=1 the case generators are filtered by it.
+func (c parseCase) clean() bool {
+	if c.frac != 0 && !slices.Contains(regularDigits, len(strings.TrimRight(fmt.Sprintf("%09d", c.frac), "0"))) {
+		return false
+	}
+	if c.layout == kitchenIndex || c.dateLayout == monthDayIndex || c.dateFirst {
+		return false
+	}
+	if !c.spec().zoned && !cleanAround(c.want()) {
+		return false
+	}
+	if c.dateLayout >= 0 {
+		w := c.want2()
+		if !cleanAround(w) || !dateOf(w).clean(c.zone.loc()) {
+			return false
+		}
+	}
+	return true
+}
+
+// parseShape is what a family of parse cases draws from: the zone and the layout; the
+// fraction, for a layout with seconds; the time rendered in an unzoned layout; and, for a
+// time-only layout, the layout and time of the date string and whether it comes first.
+type parseShape struct {
+	zones     hegel.Generator[zone]
+	layouts   hegel.Generator[int]
+	fracs     hegel.Generator[int]
+	plain     hegel.Generator[parsable]
+	dates     hegel.Generator[int]
+	dvs       hegel.Generator[parsable]
+	dateFirst hegel.Generator[bool]
+}
+
+// parseCasesOf draws the cases of a shape: the layout decides what else is drawn.
+func parseCasesOf(s parseShape) hegel.Generator[parseCase] {
+	return hegel.FlatMap(s.layouts, func(li int) hegel.Generator[parseCase] {
+		spec := layouts[li]
+		fracs := hegel.Just(0)
+		if spec.hasSec {
+			fracs = s.fracs
+		}
+		vs := s.plain
+		if spec.zoned {
+			vs = zonedParsables
+		}
+		dls, dvs, firsts := hegel.Just(-1), hegel.Just(parsable{}), hegel.Just(false)
+		if spec.hasClock && !spec.hasDate {
+			dls, dvs, firsts = s.dates, s.dvs, s.dateFirst
+		}
+		return hegel.Composite(func(tc hegel.TestCase) parseCase {
+			return parseCase{
+				zone:       hegel.Draw(tc, s.zones),
+				base:       hegel.Draw(tc, instants),
+				layout:     li,
+				v:          hegel.Draw(tc, vs),
+				frac:       hegel.Draw(tc, fracs),
+				dateLayout: hegel.Draw(tc, dls),
+				dv:         hegel.Draw(tc, dvs),
+				dateFirst:  hegel.Draw(tc, firsts),
+			}
+		})
+	})
+}
+
+var (
+	// dateAfterTimeIndex: the layout of the date string: one with a day, or the month-day
+	// one (now/8) as often as each of those; under HEGEL_NO_KNOWN=1 only the former.
+	dateAfterTimeIndex = hegel.SampledFrom(shaped(append(slices.Clone(dayIndices), monthDayIndex), dayIndices))
+	// dateFirsts: the date before the clock half the time (now/10); under HEGEL_NO_KNOWN=1
+	// never.
+	dateFirsts = shaped[hegel.Generator[bool]](chance(50), hegel.Just(false))
+
+	parseCases = gated(parseCasesOf(parseShape{
+		zones: zones, layouts: layoutIndex, fracs: fractions, plain: plainParsables,
+		dates: dateAfterTimeIndex, dvs: plainParsables, dateFirst: dateFirsts,
+	}), parseCase.clean)
+)
+
+// parseAgrees judges one case: Parse, MustParse and the Config paths give the expected time
+// for the string, a Config restricted to an unrelated layout refuses it, and the two-string
+// form gives the date string's date at the time string's clock.
+func parseAgrees(ht *hegel.T, c parseCase) {
+	spec, loc := c.spec(), c.zone.loc()
+	base, text, want := c.base.at(loc), c.text(), c.want()
+
+	got, err := now.With(base).Parse(text)
+	if err != nil {
+		ht.Fatalf("Parse(%q) [%s]: %v", text, spec.layout, err)
+	}
+	if !same(got, want) {
+		ht.Fatalf("Parse(%q) [%s] with now = %s: %s, want %s", text, spec.layout, fmtT(base), fmtT(got), fmtT(want))
+	}
+	if mp := now.With(base).MustParse(text); !same(mp, want) {
+		ht.Fatalf("MustParse(%q) = %s, want %s", text, fmtT(mp), fmtT(want))
+	}
+	// The Config path with an explicit location parses the same.
+	cfg := &now.Config{WeekStartDay: time.Sunday, TimeLocation: loc, TimeFormats: now.TimeFormats}
+	if cg, err := cfg.With(base).Parse(text); err != nil || !same(cg, want) {
+		ht.Fatalf("Config.With(...).Parse(%q) = %s, %v; want %s", text, fmtT(cg), err, fmtT(want))
+	}
+	// A Config restricted to this layout parses it; restricted to a
+	// layout that cannot read it, it refuses.
+	one := &now.Config{TimeFormats: []string{spec.layout}}
+	if cg, err := one.With(base).Parse(text); err != nil || !same(cg, want) {
+		ht.Fatalf("Config{TimeFormats: [%q]}.Parse(%q) = %s, %v; want %s", spec.layout, text, fmtT(cg), err, fmtT(want))
+	}
+	if spec.hasDate && spec.hasDay {
+		other := "2006-01-02 15:04:05.999999999 -0700 MST"
+		if cg, err := (&now.Config{TimeFormats: []string{other}}).With(base).Parse(text); err == nil {
+			ht.Fatalf("Config{TimeFormats: [%q]}.Parse(%q) = %s, want an error", other, text, fmtT(cg))
+		}
+	}
+
+	// A time-only string and a date string, in either order: the date's
+	// date at the string's clock.
+	if c.dateLayout >= 0 {
+		strs, want2 := c.strs(), c.want2()
+		got2, err := now.With(base).Parse(strs...)
+		if err != nil || !same(got2, want2) {
+			ht.Fatalf("Parse(%q, %q) with now = %s: %s, %v; want %s", strs[0], strs[1], fmtT(base), fmtT(got2), err, fmtT(want2))
+		}
+	}
+}
+
+// TestHegelParseFillsFromNow: a time rendered in one of the default layouts, against a
+// random "now". The shapes of now/7 (a fraction of another length), now/8 (Kitchen), now/9
+// (a month-day string after a time), now/10 (a date before a time) and now/11 (a date
+// without a midnight) are drawn at their natural rates, about one case in ten in all; each
+// has its own property below.
+func TestHegelParseFillsFromNow(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		parseAgrees(ht, hegel.Draw(ht, parseCases))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: malformed strings are refused; MustParse panics.
+
+// malformed: a string no layout accepts, and what is wrong with it.
+type malformed struct{ what, text string }
+
+// malformedTexts: one of the texts.
+func malformedTexts(what string, texts ...string) hegel.Generator[malformed] {
+	return hegel.Map(hegel.SampledFrom(texts), func(text string) malformed { return malformed{what, text} })
+}
+
+// malformedNumbers: the format filled with one number from each of the parts.
+func malformedNumbers(what, format string, parts ...hegel.Generator[int]) hegel.Generator[malformed] {
+	return hegel.Composite(func(tc hegel.TestCase) malformed {
+		args := make([]any, len(parts))
+		for i, p := range parts {
+			args[i] = hegel.Draw(tc, p)
+		}
+		return malformed{what, fmt.Sprintf(format, args...)}
+	})
+}
+
+var (
+	recentYears = hegel.Integers(1970, 2100)
+	// malformeds: the nine shapes of unparseable strings, the empty one first.
+	malformeds = hegel.OneOf(
+		hegel.Just(malformed{"empty", ""}),
+		malformedTexts("surrounding blank", " 12:20", "12:20 ", " 2017-10-13"),
+		malformedTexts("letters", "today", "yesterday", "noon", "x", "2017-10-13x", "12:20pm", "2017-10-13T12:20:21"),
+		malformedNumbers("hour out of range", "%d:%02d", hegel.Integers(24, 99), minutes),
+		malformedNumbers("minute out of range", "%d:%d", hours, hegel.Integers(60, 99)),
+		malformedNumbers("second out of range", "%d:%d:%d", hours, minutes, hegel.Integers(60, 99)),
+		malformedNumbers("month out of range", "%d-%d-%d", recentYears, hegel.Integers(13, 99), hegel.Integers(1, 28)),
+		malformedNumbers("day out of range", "%d-%d-%d", recentYears, hegel.Integers(1, 12), hegel.Integers(32, 99)),
+		malformedNumbers("February 30", "%d-02-%d", recentYears, hegel.Integers(30, 31)),
+	)
+)
+
+// malformedCase: the zone and the "now", and the string.
+type malformedCase struct {
+	zone zone
+	base instant
+	m    malformed
+}
+
+func (c malformedCase) GoString() string {
+	return fmt.Sprintf("%s: %q with now = %s", c.m.what, c.m.text, fmtT(c.base.at(c.zone.loc())))
+}
+
+var malformedCases = hegel.Composite(func(tc hegel.TestCase) malformedCase {
+	return malformedCase{zone: hegel.Draw(tc, zones), base: hegel.Draw(tc, instants), m: hegel.Draw(tc, malformeds)}
+})
+
+func TestHegelMalformedStringsAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, malformedCases)
+		base, text, what := c.base.at(c.zone.loc()), c.m.text, c.m.what
+		got, err := now.With(base).Parse(text)
+		if err == nil {
+			ht.Fatalf("Parse(%q) [%s] = %s, want an error", text, what, fmtT(got))
+		} else if !got.IsZero() {
+			ht.Fatalf("Parse(%q) [%s] returned %s with an error", text, what, fmtT(got))
+		}
+		func() {
+			defer func() {
+				if recover() == nil {
+					ht.Fatalf("MustParse(%q) [%s] did not panic", text, what)
+				}
+			}()
+			now.With(base).MustParse(text)
+		}()
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: Monday, Sunday, EndOfSunday and Between follow the README.
+
+// weekCase: the zone and the instant; a time-only layout (an index into layouts) and a time
+// to render in it for Monday(text) and Sunday(text); a date-time layout without an offset
+// for Between, and the seconds its bounds lie before and after the instant.
+type weekCase struct {
+	zone    zone
+	t       instant
+	layout  int
+	v       parsable
+	between int
+	lo, hi  int
+}
+
+func (c weekCase) at() time.Time { return c.t.at(c.zone.loc()) }
+
+func (c weekCase) text() string { return render(layouts[c.layout], c.v.at(c.zone.loc()), 0) }
+
+// clockOf is the instant the time-only string means on the instant's own day.
+func (c weekCase) clockOf() time.Time {
+	loc := c.zone.loc()
+	return expectedParse(layouts[c.layout], c.v.at(loc), c.at(), 0)
+}
+
+// onDay is the time-only string's clock on the date d.
+func (c weekCase) onDay(d civil) time.Time {
+	w := c.clockOf()
+	return time.Date(d.y, d.m, d.d, w.Hour(), w.Minute(), w.Second(), 0, c.zone.loc())
+}
+
+// bounds are the Between bounds: whole seconds up to an hour before and after the instant.
+func (c weekCase) bounds() (lo, hi time.Time) {
+	tt := c.at()
+	return tt.Add(-time.Duration(c.lo) * time.Second).Truncate(time.Second), tt.Add(time.Duration(c.hi) * time.Second).Truncate(time.Second)
+}
+
+func (c weekCase) boundTexts() (string, string) {
+	lo, hi := c.bounds()
+	return render(layouts[c.between], lo, 0), render(layouts[c.between], hi, 0)
+}
+
+func (c weekCase) GoString() string {
+	loText, hiText := c.boundTexts()
+	return fmt.Sprintf("Monday/Sunday of %s; Monday(%q) [%s]; Between(%q, %q) [%s]", fmtT(c.at()), c.text(), layouts[c.layout].layout, loText, hiText, layouts[c.between].layout)
+}
+
+// clean is the shape test of the case: the midnights of the instant's date, of its Monday,
+// of its Sunday and of the day after (EndOfSunday is that midnight less a nanosecond) are
+// clean (now/3, now/5); the time-only string's wall time on the Monday and the Sunday, and
+// the two Between bounds, lie away from a transition (now/2, now/11). By default the shapes
+// are drawn; under HEGEL_NO_KNOWN=1 the case generator is filtered by it.
+func (c weekCase) clean() bool {
+	loc := c.zone.loc()
+	d := dateOf(c.at())
+	mon, sun := d.isoMonday(), d.nextSunday()
+	if !(d.clean(loc) && mon.clean(loc) && sun.clean(loc) && sun.addDays(1).clean(loc)) {
+		return false
+	}
+	lo, hi := c.bounds()
+	return cleanAround(c.onDay(mon)) && cleanAround(c.onDay(sun)) && cleanAround(lo) && cleanAround(hi)
+}
+
+var (
+	hourSpans = hegel.Integers(0, 3600)
+	weekCases = gated(hegel.Composite(func(tc hegel.TestCase) weekCase {
+		return weekCase{
+			zone:    hegel.Draw(tc, zones),
+			t:       hegel.Draw(tc, instants),
+			layout:  hegel.Draw(tc, timeOnlyIndex),
+			v:       hegel.Draw(tc, plainParsables),
+			between: hegel.Draw(tc, unzonedDateTimeIndex),
+			lo:      hegel.Draw(tc, hourSpans),
+			hi:      hegel.Draw(tc, hourSpans),
+		}
+	}), weekCase.clean)
+)
+
+// TestHegelMondaySundayAndBetween: Monday, Sunday and EndOfSunday of a random instant, with
+// and without a time-only string, and Between. A Monday, Sunday or instant's date without a
+// midnight (now/3) or a Sunday whose last hour repeats (now/5) is drawn at its natural rate,
+// about one case in sixty.
+func TestHegelMondaySundayAndBetween(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, weekCases)
+		loc := c.zone.loc()
+		tt := c.at()
+		d := dateOf(tt)
+		mon, sun := d.isoMonday(), d.nextSunday()
+		nw := now.With(tt)
+		if got := nw.Monday(); !got.Equal(mon.start(loc)) {
+			ht.Fatalf("Monday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(mon.start(loc)))
+		}
+		if got := nw.Sunday(); !got.Equal(sun.start(loc)) {
+			ht.Fatalf("Sunday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(sun.start(loc)))
+		}
+		if got, want := nw.EndOfSunday(), sun.addDays(1).start(loc).Add(-time.Nanosecond); !got.Equal(want) {
+			ht.Fatalf("EndOfSunday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(want))
+		}
+
+		// With a time-only string: the same day shift, that clock.
+		text := c.text()
+		if got, want := nw.Monday(text), c.onDay(mon); !got.Equal(want) {
+			ht.Fatalf("Monday(%q) at %s = %s, want %s", text, fmtT(tt), fmtT(got), fmtT(want))
+		}
+		if got, want := nw.Sunday(text), c.onDay(sun); !got.Equal(want) {
+			ht.Fatalf("Sunday(%q) at %s = %s, want %s", text, fmtT(tt), fmtT(got), fmtT(want))
+		}
+
+		// Between is strict on both ends.
+		dspec := layouts[c.between]
+		lo, hi := c.bounds()
+		loText, hiText := c.boundTexts()
+		loT, hiT := expectedParse(dspec, lo, tt, 0), expectedParse(dspec, hi, tt, 0)
+		want2 := tt.After(loT) && tt.Before(hiT)
+		note(ht, "Between: %s .. %s", fmtT(loT), fmtT(hiT))
+		if got := nw.Between(loText, hiText); got != want2 {
+			ht.Fatalf("Between(%q, %q) at %s = %v, want %v", loText, hiText, fmtT(tt), got, want2)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// One property per recorded bug: a generator over the bug's shape region with random
+// contents, judged by the checks of the wide properties above, so that each bug has a
+// property that finds it every run (the wide properties reach most of the shapes in about
+// one case in sixty). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does
+// not touch instead (a whole-minute offset, an instant two to four hours from a transition,
+// the week or the month after, another week start, the regular fraction lengths, a plain
+// time-only layout, a date layout with a day, the other order of the two strings) and passes.
+
+// subMinuteZones: a fixed zone whose offset has a seconds part of 1-59 (under
+// HEGEL_NO_KNOWN=1 of 0).
+var subMinuteZones = hegel.Composite(func(tc hegel.TestCase) zone {
+	return zone{secs: hegel.Draw(tc, hegel.Integers(-14*60, 14*60))*60 + hegel.Draw(tc, shaped[hegel.Generator[int]](hegel.Integers(1, 59), hegel.Just(0)))}
+})
+
+var subMinuteClockCases = hegel.Composite(func(tc hegel.TestCase) clockCase {
+	return clockCase{zone: hegel.Draw(tc, subMinuteZones), t: hegel.Draw(tc, instants)}
+})
+
+// TestHegelSubMinuteOffsetsBeginAndEndOnTheClock: in a fixed zone whose offset is not a
+// whole number of minutes (a local mean time), the minute begins at the top of the wall
+// minute. BeginningOfMinute truncates the absolute time, so it lands on the offset's seconds
+// (now/1).
+func TestHegelSubMinuteOffsetsBeginAndEndOnTheClock(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, subMinuteClockCases)
+		loc := c.zone.loc()
+		clockUnitsAgree(ht, loc, c.t.at(loc))
+	})
+}
+
+// transitionCase: an IANA zone, one of its transitions and a distance from it in seconds
+// and nanoseconds: within two hours, or under HEGEL_NO_KNOWN=1 three to five hours away
+// (the tops of the hours repeat for up to three hours after a two-hour setback).
+type transitionCase struct {
+	zone  zone
+	index int
+	secs  int
+	ns    int
+}
+
+func (c transitionCase) transition() time.Time { return transitions[c.zone.name][c.index] }
+
+func (c transitionCase) at() time.Time {
+	return c.transition().Add(time.Duration(c.secs)*time.Second + time.Duration(c.ns))
+}
+
+func (c transitionCase) GoString() string {
+	return fmt.Sprintf("clock units of %s (%+d s from the transition at %s)", fmtT(c.at()), c.secs, fmtT(c.transition()))
+}
+
+var (
+	transitionZones = func() []string {
+		var names []string
+		for _, name := range zoneNames {
+			if len(transitions[name]) > 0 {
+				names = append(names, name)
+			}
+		}
+		return names
+	}()
+	nearTransition  = shaped[hegel.Generator[int]](hegel.Integers(-2*3600, 2*3600), hegel.OneOf(hegel.Integers(3*3600+1, 5*3600), hegel.Integers(-5*3600, -3*3600-1)))
+	transitionCases = hegel.FlatMap(hegel.SampledFrom(transitionZones), func(name string) hegel.Generator[transitionCase] {
+		return hegel.Composite(func(tc hegel.TestCase) transitionCase {
+			return transitionCase{zone: ianaZone(name), index: hegel.Draw(tc, hegel.Integers(0, len(transitions[name])-1)), secs: hegel.Draw(tc, nearTransition), ns: hegel.Draw(tc, nanos)}
+		})
+	})
+)
+
+// TestHegelHoursAroundATransitionBeginAndEndOnTheClock: within two hours of a transition the
+// hour still begins at the top of t's wall hour and ends when the wall clock leaves it.
+// BeginningOfHour rebuilds the wall clock with time.Date, so in a repeated hour it picks the
+// earlier occurrence, and EndOfHour adds sixty minutes to it (now/2).
+func TestHegelHoursAroundATransitionBeginAndEndOnTheClock(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, transitionCases)
+		clockUnitsAgree(ht, c.zone.loc(), c.at())
+	})
+}
+
+// missingMidnightCases: a zone and a date without a midnight; an instant on that date, with
+// the unit Day or Week, or within the six days after it, with the unit Week, the week
+// starting on the date's weekday. Under HEGEL_NO_KNOWN=1 the instant is in the week after.
+var missingMidnightCases = gated(hegel.FlatMap(datedZones(noMidnightDates), func(dz datedZone) hegel.Generator[calendarCase] {
+	return hegel.Composite(func(tc hegel.TestCase) calendarCase {
+		k := hegel.Draw(tc, shaped[hegel.Generator[int]](hegel.Integers(0, 6), hegel.Integers(7, 13)))
+		unit := 1 // Week
+		if k%7 == 0 {
+			unit = hegel.Draw(tc, hegel.Integers(0, 1))
+		}
+		return calendarCase{zone: dz.zone, t: instantOn(dz.date.addDays(k), hegel.Draw(tc, clocks), hegel.Draw(tc, shifts)), start: dz.date.weekday(), unit: unit}
+	})
+}), calendarCase.clean)
+
+// TestHegelDaysWithoutAMidnightBeginOnTheCalendar: a day without a midnight (daylight saving
+// starting at 00:00) begins at its first instant, and the week starting on it too.
+// BeginningOfDay is time.Date of the missing midnight, which is 23:00 of the day before
+// (Havana) or an hour into the day (Beirut), and BeginningOfWeek and EndOfWeek are built on
+// it (now/3).
+func TestHegelDaysWithoutAMidnightBeginOnTheCalendar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		calendarUnitsAgree(ht, hegel.Draw(ht, missingMidnightCases))
+	})
+}
+
+// missingFirstCases: a zone and a first of a month without a midnight; an instant in that
+// month with the unit Month, Quarter or Half. Under HEGEL_NO_KNOWN=1 an instant in the
+// month after, with the unit Month.
+var missingFirstCases = gated(hegel.FlatMap(datedZones(firstsNoMidnight), func(dz datedZone) hegel.Generator[calendarCase] {
+	first := dz.date.addMonths(shaped(0, 1))
+	return hegel.Composite(func(tc hegel.TestCase) calendarCase {
+		day := first.addDays(hegel.Draw(tc, hegel.Integers(0, 27)))
+		unit := hegel.Draw(tc, shaped[hegel.Generator[int]](hegel.Integers(2, 4), hegel.Just(2)))
+		return calendarCase{zone: dz.zone, t: instantOn(day, hegel.Draw(tc, clocks), hegel.Draw(tc, shifts)), start: hegel.Draw(tc, weekdays), unit: unit}
+	})
+}), calendarCase.clean)
+
+// TestHegelMonthsWithoutAMidnightOnTheFirstBeginOnTheCalendar: a month whose first day has
+// no midnight begins at that day's first instant, and the quarter and half year containing
+// it at theirs. BeginningOfMonth is time.Date of the missing midnight, in the previous month
+// or an hour late, and the quarter and half are computed from it with AddDate (now/4).
+func TestHegelMonthsWithoutAMidnightOnTheFirstBeginOnTheCalendar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		calendarUnitsAgree(ht, hegel.Draw(ht, missingFirstCases))
+	})
+}
+
+// repeatedEndCases: a zone and a date whose last hour repeats; an instant on that date
+// (under HEGEL_NO_KNOWN=1 from two to seven days after it: the next day's midnight is within
+// two hours of the transition), with the unit Day.
+var repeatedEndCases = gated(hegel.FlatMap(datedZones(repeatedEndDates), func(dz datedZone) hegel.Generator[calendarCase] {
+	return hegel.Composite(func(tc hegel.TestCase) calendarCase {
+		day := dz.date.addDays(hegel.Draw(tc, shaped[hegel.Generator[int]](hegel.Just(0), hegel.Integers(2, 7))))
+		return calendarCase{zone: dz.zone, t: instantOn(day, hegel.Draw(tc, clocks), hegel.Draw(tc, shifts)), start: hegel.Draw(tc, weekdays), unit: 0}
+	})
+}), calendarCase.clean)
+
+// TestHegelDaysWithARepeatedLastHourEndOnTheCalendar: a day whose 23rd hour occurs twice
+// (daylight saving ending at midnight) ends at the later 23:59:59.999999999. EndOfDay is
+// time.Date of that wall clock, which is the earlier one (now/5).
+func TestHegelDaysWithARepeatedLastHourEndOnTheCalendar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		calendarUnitsAgree(ht, hegel.Draw(ht, repeatedEndCases))
+	})
+}
+
+// skippedDateCases: a zone and a date its calendar skipped; an instant in the six days after
+// it and the week starting on the skipped date's weekday, with the unit Week. Under
+// HEGEL_NO_KNOWN=1 the instant is from two to seven days after it and the week starts on
+// another weekday than the skipped date's and the next day's (whose midnight is the
+// transition).
+var skippedDateCases = gated(hegel.FlatMap(datedZones(skippedDates), func(dz datedZone) hegel.Generator[calendarCase] {
+	var others []time.Weekday
+	for wd := time.Sunday; wd <= time.Saturday; wd++ {
+		if wd != dz.date.weekday() && wd != dz.date.addDays(1).weekday() {
+			others = append(others, wd)
+		}
+	}
+	starts := shaped[hegel.Generator[time.Weekday]](hegel.Just(dz.date.weekday()), hegel.SampledFrom(others))
+	return hegel.Composite(func(tc hegel.TestCase) calendarCase {
+		day := dz.date.addDays(hegel.Draw(tc, shaped[hegel.Generator[int]](hegel.Integers(1, 6), hegel.Integers(2, 7))))
+		return calendarCase{zone: dz.zone, t: instantOn(day, hegel.Draw(tc, clocks), hegel.Draw(tc, shifts)), start: hegel.Draw(tc, starts), unit: 1}
+	})
+}), calendarCase.clean)
+
+// TestHegelWeeksAcrossASkippedDateBeginOnTheCalendar: a week whose first day the calendar
+// skipped (Apia's Friday 30 December 2011) begins at the first instant that exists, the day
+// after. BeginningOfWeek counts back calendar days with AddDate and lands on the day before
+// (now/6).
+func TestHegelWeeksAcrossASkippedDateBeginOnTheCalendar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		calendarUnitsAgree(ht, hegel.Draw(ht, skippedDateCases))
+	})
+}
+
+// oddFractionCases: a layout with seconds and a fraction of 1, 2, 4, 5, 7 or 8 digits (under
+// HEGEL_NO_KNOWN=1 of 3, 6 or 9).
+var oddFractionCases = gated(parseCasesOf(parseShape{
+	zones: zones, layouts: hegel.SampledFrom(secondsIndices), fracs: fractionsOf(shaped(oddDigits, regularDigits)...),
+	plain: plainParsables, dates: dayIndex, dvs: plainParsables, dateFirst: hegel.Just(false),
+}), parseCase.clean)
+
+// TestHegelFractionsOfAnyLengthParse: a fraction of any number of digits after the seconds
+// parses like one of 3, 6 or 9. The has-time patterns admit only those, so a time-only
+// string with another lands on January 1st and a zero clock field of a date-time string is
+// replaced by the current one (now/7).
+func TestHegelFractionsOfAnyLengthParse(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		parseAgrees(ht, hegel.Draw(ht, oddFractionCases))
+	})
+}
+
+// kitchenCases: the Kitchen layout (under HEGEL_NO_KNOWN=1 a plain time-only one).
+var kitchenCases = gated(parseCasesOf(parseShape{
+	zones: zones, layouts: shaped[hegel.Generator[int]](hegel.Just(kitchenIndex), timeOnlyIndex), fracs: regularFractions,
+	plain: plainParsables, dates: dayIndex, dvs: plainParsables, dateFirst: hegel.Just(false),
+}), parseCase.clean)
+
+// TestHegelKitchenTimesAreToday: a Kitchen string ("12:20PM") is today at that clock, as
+// every other time-only string. The has-time patterns want the clock to end the string, so
+// it lands on January 1st (now/8).
+func TestHegelKitchenTimesAreToday(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		parseAgrees(ht, hegel.Draw(ht, kitchenCases))
+	})
+}
+
+// monthDayAfterTimeCases: a plain time-only string, then a month-day string (under
+// HEGEL_NO_KNOWN=1 a date-only string with a day).
+var monthDayAfterTimeCases = gated(parseCasesOf(parseShape{
+	zones: zones, layouts: timeOnlyIndex, fracs: regularFractions, plain: plainParsables,
+	dates: shaped[hegel.Generator[int]](hegel.Just(monthDayIndex), dayIndex), dvs: plainParsables, dateFirst: hegel.Just(false),
+}), parseCase.clean)
+
+// TestHegelMonthDayAfterATimeKeepsTheClock: Parse(time, "10-13") is this year's October 13th
+// at the time's clock, as Parse(time, "2017-10-13") is. The month-day string matches the
+// has-time pattern through its hyphen, so the clock is dropped (now/9).
+func TestHegelMonthDayAfterATimeKeepsTheClock(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		parseAgrees(ht, hegel.Draw(ht, monthDayAfterTimeCases))
+	})
+}
+
+// dateThenTimeCases: a date-only string with a day, then a plain time-only string (under
+// HEGEL_NO_KNOWN=1 the other order).
+var dateThenTimeCases = gated(parseCasesOf(parseShape{
+	zones: zones, layouts: timeOnlyIndex, fracs: regularFractions, plain: plainParsables,
+	dates: dayIndex, dvs: plainParsables, dateFirst: hegel.Just(shaped(true, false)),
+}), parseCase.clean)
+
+// TestHegelDateThenTimeKeepsTheDate: Parse(date, time) is the date at the time's clock, as
+// Parse(time, date) is. The only-time flag is ANDed across the strings, so the time string's
+// zero month and day are not filled from the date and become January 1st (now/10).
+func TestHegelDateThenTimeKeepsTheDate(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		parseAgrees(ht, hegel.Draw(ht, dateThenTimeCases))
+	})
+}
+
+// noMidnightParseCases: a zone and a date without a midnight (under HEGEL_NO_KNOWN=1 the
+// date a week later), rendered in a date-only layout with a day and parsed alone, or after a
+// plain time-only string.
+var noMidnightParseCases = gated(hegel.FlatMap(datedZones(noMidnightDates), func(dz datedZone) hegel.Generator[parseCase] {
+	date := dz.date.addDays(shaped(0, 7))
+	// the date with a clock from 01:00 on, so that it renders as itself (its 00:xx may not
+	// exist)
+	dated := hegel.Composite(func(tc hegel.TestCase) parsable {
+		return parsable{y: date.y, m: date.m, d: date.d, h: hegel.Draw(tc, hegel.Integers(1, 23)), mi: hegel.Draw(tc, minutes), s: hegel.Draw(tc, seconds)}
+	})
+	alone := parseCasesOf(parseShape{zones: hegel.Just(dz.zone), layouts: dayIndex, fracs: hegel.Just(0), plain: dated})
+	after := parseCasesOf(parseShape{
+		zones: hegel.Just(dz.zone), layouts: timeOnlyIndex, fracs: regularFractions, plain: plainParsables,
+		dates: dayIndex, dvs: dated, dateFirst: hegel.Just(false),
+	})
+	return hegel.OneOf(alone, after)
+}), parseCase.clean)
+
+// TestHegelDatesWithoutAMidnightParse: a date-only string for a day without a midnight is
+// that day's first instant, and after a time-only string it is that day at the time's clock.
+// ParseInLocation resolves the missing midnight to 23:00 of the day before (Havana) or 01:00
+// (Beirut), and Parse takes the hour it got back as carried by the string (now/11).
+func TestHegelDatesWithoutAMidnightParse(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		parseAgrees(ht, hegel.Draw(ht, noMidnightParseCases))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Pins: one test per recorded bug, each failing while the bug is present.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func mustLoc(t *testing.T, name string) *time.Location {
+	t.Helper()
+	loc, err := time.LoadLocation(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return loc
+}
+
+func expect(t *testing.T, what string, got, want time.Time) {
+	t.Helper()
+	if !got.Equal(want) {
+		t.Errorf("%s = %s, want %s", what, fmtT(got), fmtT(want))
+	}
+}
+
+// now/1: BeginningOfMinute truncates the absolute time, so a location whose
+// offset is not a whole number of minutes (LMT +00:19:32) gets :32 seconds.
+func TestHegelPinSubMinuteOffsetMinute(t *testing.T) {
+	defer guard(t)
+	lmt := time.FixedZone("LMT", 19*60+32)
+	tt := time.Date(2017, 10, 13, 12, 34, 50, 123, lmt)
+	expect(t, "BeginningOfMinute", now.With(tt).BeginningOfMinute(), time.Date(2017, 10, 13, 12, 34, 0, 0, lmt))
+	expect(t, "EndOfMinute", now.With(tt).EndOfMinute(), time.Date(2017, 10, 13, 12, 34, 59, 999999999, lmt))
+}
+
+// now/2: BeginningOfHour rebuilds the wall clock with time.Date, so in a
+// repeated hour it picks the other occurrence and EndOfHour assumes hours
+// are sixty minutes long.
+func TestHegelPinRepeatedOrShortHour(t *testing.T) {
+	defer guard(t)
+	ny := mustLoc(t, "America/New_York")
+	second := time.Date(2025, 11, 2, 6, 30, 0, 0, time.UTC).In(ny) // the second 01:30, EST
+	expect(t, "BeginningOfHour(second 01:30 EST)", now.With(second).BeginningOfHour(), time.Date(2025, 11, 2, 6, 0, 0, 0, time.UTC))
+	expect(t, "EndOfHour(second 01:30 EST)", now.With(second).EndOfHour(), time.Date(2025, 11, 2, 6, 59, 59, 999999999, time.UTC))
+	lh := mustLoc(t, "Australia/Lord_Howe")
+	lht := time.Date(2025, 10, 4, 15, 45, 0, 0, time.UTC).In(lh) // 02:45 +11, the hour began at 02:30
+	expect(t, "EndOfHour(Lord Howe 02:45)", now.With(lht).EndOfHour(), time.Date(2025, 10, 4, 15, 59, 59, 999999999, time.UTC))
+}
+
+// now/3: when midnight does not exist (daylight saving starting at 00:00),
+// BeginningOfDay is 23:00 of the previous day and everything built on it —
+// BeginningOfWeek, EndOfWeek, Monday, Sunday, EndOfSunday — moves with it.
+func TestHegelPinSkippedMidnightDay(t *testing.T) {
+	defer guard(t)
+	hv := mustLoc(t, "America/Havana")
+	firstOfMar9 := time.Date(2025, 3, 9, 5, 0, 0, 0, time.UTC) // 01:00 CDT, the first instant of March 9
+	noon := time.Date(2025, 3, 9, 12, 0, 0, 0, hv)
+	expect(t, "BeginningOfDay(Havana 2025-03-09)", now.With(noon).BeginningOfDay(), firstOfMar9)
+	expect(t, "BeginningOfWeek(Havana 2025-03-09, Sunday start)", withStart(noon, time.Sunday).BeginningOfWeek(), firstOfMar9)
+	expect(t, "Monday(Havana 2025-03-09)", now.With(noon).Monday(), time.Date(2025, 3, 3, 0, 0, 0, 0, hv))
+	wed := time.Date(2025, 3, 5, 12, 0, 0, 0, hv)
+	expect(t, "Sunday(Havana 2025-03-05)", now.With(wed).Sunday(), firstOfMar9)
+	sat := time.Date(2025, 3, 8, 12, 0, 0, 0, hv)
+	expect(t, "EndOfWeek(Havana 2025-03-08, Sunday start)", withStart(sat, time.Sunday).EndOfWeek(), firstOfMar9.Add(-time.Nanosecond))
+}
+
+// now/4: the same skipped midnight on the first of the month shifts
+// BeginningOfMonth into the previous month, and the quarter and half built
+// on it are off by an hour (Beirut 1990) or a whole month (Asunción 2002).
+func TestHegelPinSkippedMidnightQuarter(t *testing.T) {
+	defer guard(t)
+	beirut := mustLoc(t, "Asia/Beirut")
+	tt := time.Date(1990, 5, 19, 12, 0, 0, 0, beirut)
+	expect(t, "BeginningOfHalf(Beirut 1990-05-19)", now.With(tt).BeginningOfHalf(), time.Date(1990, 1, 1, 0, 0, 0, 0, beirut))
+	asu := mustLoc(t, "America/Asuncion")
+	q3 := time.Date(2002, 9, 30, 12, 0, 0, 0, asu)
+	expect(t, "BeginningOfQuarter(Asunción 2002-09-30)", now.With(q3).BeginningOfQuarter(), time.Date(2002, 7, 1, 0, 0, 0, 0, asu))
+	expect(t, "EndOfQuarter(Asunción 2002-09-30)", now.With(q3).EndOfQuarter(), time.Date(2002, 10, 1, 0, 0, 0, 0, asu).Add(-time.Nanosecond))
+}
+
+// now/5: EndOfDay rebuilds 23:59:59.999999999 with time.Date; when the last
+// hour of the day repeats (daylight saving ending at midnight) it returns
+// the earlier occurrence, which lies before the given time.
+func TestHegelPinEndOfDayInRepeatedHour(t *testing.T) {
+	defer guard(t)
+	sp := mustLoc(t, "America/Sao_Paulo")
+	tt := time.Date(2018, 2, 18, 2, 30, 0, 0, time.UTC).In(sp) // 23:30 -03, the second 23:30 of February 17
+	expect(t, "EndOfDay(São Paulo second 23:30)", now.With(tt).EndOfDay(), time.Date(2018, 2, 18, 2, 59, 59, 999999999, time.UTC))
+}
+
+// now/6: BeginningOfWeek counts back whole days with AddDate, so across a
+// skipped calendar day (Samoa, 30 December 2011) it lands on the day
+// before the week's first day.
+func TestHegelPinSkippedDayWeek(t *testing.T) {
+	defer guard(t)
+	apia := mustLoc(t, "Pacific/Apia")
+	sat := time.Date(2011, 12, 31, 12, 0, 0, 0, apia)
+	expect(t, "BeginningOfWeek(Apia 2011-12-31, Friday start)", withStart(sat, time.Friday).BeginningOfWeek(), time.Date(2011, 12, 31, 0, 0, 0, 0, apia))
+}
+
+var pinBase = time.Date(2013, 11, 18, 17, 51, 49, 123456789, time.UTC)
+
+func pinParse(t *testing.T, want time.Time, strs ...string) {
+	t.Helper()
+	got, err := now.With(pinBase).Parse(strs...)
+	if err != nil {
+		t.Errorf("Parse(%q): %v", strs, err)
+		return
+	}
+	expect(t, fmt.Sprintf("Parse(%q)", strs), got, want)
+}
+
+// now/7: the has-time detection only knows fractions of 3, 6 or 9 digits;
+// with any other length a time-only string lands on January 1st and a
+// zero clock field is replaced by the current one.
+func TestHegelPinFractionDigits(t *testing.T) {
+	defer guard(t)
+	pinParse(t, time.Date(2013, 11, 18, 12, 20, 13, 500000000, time.UTC), "12:20:13.5")
+	pinParse(t, time.Date(2017, 10, 13, 12, 0, 21, 500000000, time.UTC), "2017-10-13 12:00:21.5")
+}
+
+// now/8: Kitchen strings ("12:20PM") are not recognised as times and land
+// on January 1st.
+func TestHegelPinKitchenIsToday(t *testing.T) {
+	defer guard(t)
+	pinParse(t, time.Date(2013, 11, 18, 12, 20, 0, 0, time.UTC), "12:20PM")
+}
+
+// now/9: a month-day string matches the has-time pattern through its
+// hyphen, so a clock parsed from an earlier string is dropped.
+func TestHegelPinMonthDayLooksLikeTime(t *testing.T) {
+	defer guard(t)
+	pinParse(t, time.Date(2013, 10, 13, 12, 20, 0, 0, time.UTC), "12:20", "10-13")
+}
+
+// now/10: a date followed by a time-only string loses the date (January
+// 1st), because onlyTimeInStr is ANDed across the strings; the upstream
+// test only passes because its date is 2011-1-1.
+func TestHegelPinDateThenTime(t *testing.T) {
+	defer guard(t)
+	pinParse(t, time.Date(2017, 10, 13, 12, 20, 0, 0, time.UTC), "2017-10-13", "12:20")
+	pinParse(t, time.Date(2017, 10, 13, 18, 0, 0, 0, time.UTC), "2017-10-13", "18")
+}
+
+// now/11: a date-only string for a day whose midnight does not exist
+// parses to 23:00 of the previous day (Havana, Santiago) or to 01:00
+// (Beirut), and a time-only string combined with such a date has its clock
+// overwritten by that hour.
+func TestHegelPinDateWithoutMidnight(t *testing.T) {
+	defer guard(t)
+	hv := mustLoc(t, "America/Havana")
+	base := time.Date(2013, 11, 18, 17, 51, 49, 0, hv)
+	firstOfMar9 := time.Date(2025, 3, 9, 5, 0, 0, 0, time.UTC) // 01:00 CDT
+	if got, err := now.With(base).Parse("2025-03-09"); err != nil {
+		t.Error(err)
+	} else {
+		expect(t, `Parse("2025-03-09") in Havana`, got, firstOfMar9)
+	}
+	if got, err := now.With(base).Parse("12:20", "2025-03-09"); err != nil {
+		t.Error(err)
+	} else {
+		expect(t, `Parse("12:20", "2025-03-09") in Havana`, got, time.Date(2025, 3, 9, 12, 20, 0, 0, hv))
+	}
+	beirut := mustLoc(t, "Asia/Beirut")
+	if got, err := now.With(base.In(beirut)).Parse("02:00", "1973-5-1"); err != nil {
+		t.Error(err)
+	} else {
+		expect(t, `Parse("02:00", "1973-5-1") in Beirut`, got, time.Date(1973, 5, 1, 2, 0, 0, 0, beirut))
+	}
+}
