+var monthDayLayout = layoutSpec{layout: "1-2", hasMonth: true, hasDay: true}
+
+// genFraction draws nanoseconds whose shortest decimal rendering has 3, 6
+// or 9 digits (other lengths are pinned, now/6), or zero.
+func genFraction(tc hegel.TestCase) int {
+	switch n(tc, 0, 3) {
+	case 0:
+		return (n(tc, 0, 99)*10 + n(tc, 1, 9)) * 1000000
+	case 1:
+		return (n(tc, 0, 99999)*10 + n(tc, 1, 9)) * 1000
+	case 2:
+		return n(tc, 0, 99999999)*10 + n(tc, 1, 9)
+	}
+	return 0
+}
+
+// render formats v in the layout, appending a fraction to the seconds when
+// asked (Go accepts one after any seconds field).
+func render(tc hegel.TestCase, spec layoutSpec, v time.Time, frac int) string {
+	layout := spec.layout
+	if spec.hasSec && frac != 0 {
+		v = v.Add(time.Duration(frac))
+		if strings.Contains(layout, "05") {
+			layout = strings.Replace(layout, "05", "05.999999999", 1)
+		} else {
+			layout = strings.Replace(layout, ":5", ":5.999999999", 1)
+		}
+	}
+	return v.Format(layout)
+}
+
+// expectedParse is the time Parse should produce for a string in spec
+// rendered from v, given the reference time base.
+func expectedParse(spec layoutSpec, v, base time.Time, frac int) time.Time {
+	y, m, d := base.Date()
+	if spec.hasYear {
+		y = v.Year()
+	}
+	if spec.hasMonth {
+		m = v.Month()
+	} else if spec.hasDate {
+		m = time.January
+	}
+	if spec.hasDay {
+		d = v.Day()
+	} else if spec.hasDate {
+		d = 1
+	}
+	h, mi, s, ns := 0, 0, 0, 0
+	if spec.hasClock {
+		h = v.Hour()
+	}
+	if spec.hasMin {
+		mi = v.Minute()
+	}
+	if spec.hasSec {
+		s = v.Second()
+		ns = frac
+	}
+	loc := base.Location()
+	if spec.zoned {
+		_, off := v.Zone()
+		if off == 0 {
+			loc = time.UTC
+		} else {
+			loc = time.FixedZone("", off)
+		}
+	}
+	return time.Date(y, m, d, h, mi, s, ns, loc)
+}
+
+// genParsable draws a time whose rendering in spec is unambiguous: years
+// 1000–2999, and with a zone only whole-minute offsets.
+func genParsable(tc hegel.TestCase, spec layoutSpec, loc *time.Location) time.Time {
+	y := n(tc, 1000, 2999)
+	if chance(tc, 60) {
+		y = n(tc, 1970, 2100)
+	}
+	v := time.Date(y, time.Month(n(tc, 1, 12)), n(tc, 1, 28), n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59), 0, loc)
+	if spec.zoned {
+		v = v.In(time.FixedZone("", n(tc, -14*60, 14*60)*60))
+	}
+	return v
+}
+
+// same compares instant, offset and wall clock; the zone abbreviation is
+// left out because ParseInLocation reuses the location's zone when the
+// parsed offset matches it (documented Go behaviour).
+func same(a, b time.Time) bool {
+	const noName = "2006-01-02 15:04:05.000000000 -07:00:00"
+	return a.Equal(b) && a.Format(noName) == b.Format(noName)
+}
