+// ---------------------------------------------------------------------------
+// Parse: layouts and their rendering.
+
+// layoutSpec describes one of now's default layouts: how to render a time
+// and which fields the text carries.
+type layoutSpec struct {
+	layout   string
+	hasDate  bool // year, month and day (or the fields present)
+	hasYear  bool
+	hasMonth bool
+	hasDay   bool
+	hasClock bool // at least the hour
+	hasMin   bool
+	hasSec   bool
+	zoned    bool // carries a numeric offset
+}
+
+var dateLayouts = []layoutSpec{
+	{layout: "2006", hasDate: true, hasYear: true},
+	{layout: "2006-1", hasDate: true, hasYear: true, hasMonth: true},
+	{layout: "2006-1-2", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006.1.2", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006.01.02", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "1/2/2006", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006/01/02", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "20060102", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+}
+
+var dateTimeLayouts = []layoutSpec{
