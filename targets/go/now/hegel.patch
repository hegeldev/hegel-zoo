+// ---------------------------------------------------------------------------
+// Property: Parse fills the missing fields from "now".
+
+func TestHegelParseFillsFromNow(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		loc := genLocation(ht)
+		base := genInstant(ht, loc)
+		var spec layoutSpec
+		switch n(ht, 0, 3) {
+		case 0:
+			spec = pick(ht, dateLayouts)
+		case 1:
+			spec = pick(ht, dateTimeLayouts)
+		case 2:
+			spec = pick(ht, timeLayouts)
+		default:
+			spec = monthDayLayout
+		}
+		frac := 0
+		if spec.hasSec && chance(ht, 40) {
+			frac = genFraction(ht)
+		}
+		v := genParsable(ht, spec, loc)
+		want := expectedParse(spec, v, base, frac)
+		// An expected wall time within two hours of a transition — a date
+		// whose midnight does not exist, or today's skipped hour — is the
+		// pinned shape now/11 and is redrawn.
+		for tries := 0; tries < 20 && !spec.zoned && !cleanAround(want); tries++ {
+			v = genParsable(ht, spec, loc)
+			want = expectedParse(spec, v, base, frac)
+		}
+		if !spec.zoned && !cleanAround(want) {
+			loc = time.UTC
+			base = base.In(loc)
+			v = genParsable(ht, spec, loc)
+			want = expectedParse(spec, v, base, frac)
+		}
+		text := render(ht, spec, v, frac)
+		note(ht, "Parse(%q) [%s] with now = %s", text, spec.layout, fmtT(base))
+
+		got, err := now.With(base).Parse(text)
+		if err != nil {
+			fail(ht, "Parse(%q) [%s]: %v", text, spec.layout, err)
+			return
+		}
+		if !same(got, want) {
+			fail(ht, "Parse(%q) [%s] with now = %s: %s, want %s", text, spec.layout, fmtT(base), fmtT(got), fmtT(want))
+		}
+		if mp := now.With(base).MustParse(text); !same(mp, want) {
+			fail(ht, "MustParse(%q) = %s, want %s", text, fmtT(mp), fmtT(want))
+		}
+		// The Config path with an explicit location parses the same.
+		cfg := &now.Config{WeekStartDay: time.Sunday, TimeLocation: loc, TimeFormats: now.TimeFormats}
+		if cg, err := cfg.With(base).Parse(text); err != nil || !same(cg, want) {
+			fail(ht, "Config.With(...).Parse(%q) = %s, %v; want %s", text, fmtT(cg), err, fmtT(want))
+		}
+		// A Config restricted to this layout parses it; restricted to a
+		// layout that cannot read it, it refuses.
+		one := &now.Config{TimeFormats: []string{spec.layout}}
+		if cg, err := one.With(base).Parse(text); err != nil || !same(cg, want) {
+			fail(ht, "Config{TimeFormats: [%q]}.Parse(%q) = %s, %v; want %s", spec.layout, text, fmtT(cg), err, fmtT(want))
+		}
+		if spec.hasDate && spec.hasDay {
+			other := "2006-01-02 15:04:05.999999999 -0700 MST"
+			if cg, err := (&now.Config{TimeFormats: []string{other}}).With(base).Parse(text); err == nil {
+				fail(ht, "Config{TimeFormats: [%q]}.Parse(%q) = %s, want an error", other, text, fmtT(cg))
+			}
+		}
+
+		// A time-only string after a date-only string, in the order the
+		// code fills from: the clock then the date (the other order is
+		// pinned, now/9).
+		if spec.hasClock && !spec.hasDate {
+			dspec := pick(ht, dateLayouts)
+			if !dspec.hasDay {
+				dspec = dateLayouts[2]
+			}
+			dv := genParsable(ht, dspec, loc)
+			want2 := time.Date(dv.Year(), dv.Month(), dv.Day(), want.Hour(), want.Minute(), want.Second(), want.Nanosecond(), loc)
+			// The date string is parsed as its midnight first, so that
+			// midnight must be clean too (now/11).
+			cleanPair := func() bool { return cleanAround(want2) && dateOf(want2).clean(loc) }
+			for tries := 0; tries < 20 && !cleanPair(); tries++ {
+				dv = genParsable(ht, dspec, loc)
+				want2 = time.Date(dv.Year(), dv.Month(), dv.Day(), want.Hour(), want.Minute(), want.Second(), want.Nanosecond(), loc)
+			}
+			if !cleanPair() {
+				return
+			}
+			dtext := render(ht, dspec, dv, 0)
+			got2, err := now.With(base).Parse(text, dtext)
+			if err != nil || !same(got2, want2) {
+				fail(ht, "Parse(%q, %q) with now = %s: %s, %v; want %s", text, dtext, fmtT(base), fmtT(got2), err, fmtT(want2))
+			}
+		}
+	})
+}
