+package now_test
+
+// Hegel property tests for github.com/jinzhu/now.
+//
+// The oracle is Go's own time package: the beginning of a unit is the first
+// instant whose wall clock, in the time's location, lies in that unit (the
+// minute, hour, day, week starting on WeekStartDay, month, quarter, half
+// year or year), the end is the last such instant, and the README's examples
+// fix the rest - EndOf* is one nanosecond before the next beginning, Monday
+// is the Monday on or before the date (a Sunday belongs to the week of the
+// Monday six days earlier), Sunday is the Sunday on or after it, and Parse
+// fills the fields a string does not carry from the "now" it is given: a
+// time-only string is today, a month-day string is this year, a date-only
+// string is midnight. Locations come from the IANA database (via time/tzdata)
+// and from fixed zones, so daylight-saving transitions inside a unit are
+// exercised; the pinned shapes (transitions at a unit's own boundary) are
+// kept out of the cases by a filter on the case generator, see the README.
+//
+// Every property draws one case record from generators that are package-level
+// values and renders it with pure functions; the records carry a GoString for
+// the draw report.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	_ "time/tzdata"
+
+	"github.com/jinzhu/now"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+const stamp = "2006-01-02 15:04:05.000000000 -07:00:00 MST Mon"
+
+func fmtT(t time.Time) string { return t.Format(stamp) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// ---------------------------------------------------------------------------
+// Locations and instants.
+
+var zoneNames = []string{
+	"UTC", "America/New_York", "Europe/London", "Europe/Berlin", "Asia/Kolkata", "Asia/Kathmandu",
+	"Australia/Lord_Howe", "Pacific/Chatham", "America/Havana", "America/Sao_Paulo", "Pacific/Apia",
+	"Asia/Tehran", "Africa/Casablanca", "America/Santiago", "Australia/Sydney", "Africa/Cairo",
+	"America/Asuncion", "Asia/Beirut", "Pacific/Auckland", "America/St_Johns",
+}
+
+var locations = func() map[string]*time.Location {
+	out := map[string]*time.Location{}
+	for _, name := range zoneNames {
+		loc, err := time.LoadLocation(name)
+		if err != nil {
+			panic(err)
+		}
+		out[name] = loc
+	}
+	return out
+}()
+
+// zone is a location: one of the IANA zones by name, or a fixed zone with a whole-minute
+// offset (sub-minute offsets are now/1).
+type zone struct {
+	name string // the IANA name; "" for a fixed zone
+	mins int    // the fixed zone's offset in minutes
+}
+
+func (z zone) loc() *time.Location {
+	if z.name != "" {
+		return locations[z.name]
+	}
+	return time.FixedZone(fmt.Sprintf("F%+d", z.mins), z.mins*60)
+}
+
+// zones: an IANA zone, or a fixed zone three times in twenty.
+var zones = weighted(
+	choice[zone]{85, hegel.Map(hegel.SampledFrom(zoneNames), func(name string) zone { return zone{name: name} })},
+	choice[zone]{15, hegel.Map(hegel.Integers(-14*60, 14*60), func(mins int) zone { return zone{mins: mins} })},
+)
+
+// clock is the wall clock of an instant.
+type clock struct{ h, mi, s, ns int }
+
+var (
+	hours   = hegel.Integers(0, 23)
+	minutes = hegel.Integers(0, 59)
+	seconds = hegel.Integers(0, 59)
+	nanos   = hegel.Integers(0, 999999999)
+
+	anyClocks = hegel.Composite(func(tc hegel.TestCase) clock {
+		return clock{h: hegel.Draw(tc, hours), mi: hegel.Draw(tc, minutes), s: hegel.Draw(tc, seconds), ns: hegel.Draw(tc, nanos)}
+	})
+	// clocks: midnight, the last nanosecond of the day, the top of an hour, a whole second,
+	// or any clock (twice as often), so that the boundaries are hit.
+	clocks = hegel.OneOf(
+		hegel.Just(clock{}),
+		hegel.Just(clock{23, 59, 59, 999999999}),
+		hegel.Map(hours, func(h int) clock { return clock{h: h} }),
+		hegel.Composite(func(tc hegel.TestCase) clock {
+			return clock{h: hegel.Draw(tc, hours), mi: hegel.Draw(tc, minutes), s: hegel.Draw(tc, seconds)}
+		}),
+		anyClocks,
+		anyClocks,
+	)
+)
+
+// instant is a wall clock in a zone: a calendar date (the day may run past the month's end;
+// time.Date normalises it), a clock, and a shift of up to three hours either way (three
+// times in ten), so that instants inside transition hours are reached as absolute times too.
+type instant struct {
+	y     int
+	m     time.Month
+	d     int
+	clock clock
+	shift int // seconds
+}
+
+func (i instant) at(loc *time.Location) time.Time {
+	return time.Date(i.y, i.m, i.d, i.clock.h, i.clock.mi, i.clock.s, i.clock.ns, loc).Add(time.Duration(i.shift) * time.Second)
+}
+
+// instants: years 1975-2060.
+var instants = hegel.Composite(func(tc hegel.TestCase) instant {
+	return instant{
+		y:     hegel.Draw(tc, hegel.Integers(1975, 2060)),
+		m:     time.Month(hegel.Draw(tc, hegel.Integers(1, 12))),
+		d:     hegel.Draw(tc, hegel.Integers(1, 31)),
+		clock: hegel.Draw(tc, clocks),
+		shift: hegel.Draw(tc, maybe(30, hegel.Integers(-3*3600, 3*3600))),
+	}
+})
+
+// ---------------------------------------------------------------------------
+// The model.
+
+func mid(y int, m time.Month, d int, loc *time.Location) time.Time {
+	return time.Date(y, m, d, 0, 0, 0, 0, loc)
+}
+
+func offsetOf(t time.Time) int {
+	_, off := t.Zone()
+	return off
+}
+
+// cleanAround reports whether the zone offset is constant within two hours
+// of x: no transition nearby, so wall clocks near x are unambiguous.
+func cleanAround(x time.Time) bool {
+	off := offsetOf(x)
+	for _, k := range []int{-2, -1, 1, 2} {
+		if offsetOf(x.Add(time.Duration(k)*time.Hour)) != off {
+			return false
+		}
+	}
+	return true
+}
+
+// cleanMidnight reports whether midnight of the civil date exists, is
+// unique and has no transition within two hours (the pinned shapes now/3,
+// now/4 and now/5 are transitions at or near a midnight).
+func cleanMidnight(y int, m time.Month, d int, loc *time.Location) bool {
+	x := mid(y, m, d, loc)
+	yy, mm, dd := x.Date()
+	if yy != y || mm != m || dd != d || x.Hour() != 0 || x.Minute() != 0 || x.Second() != 0 {
+		return false
+	}
+	return cleanAround(x)
+}
+
+// civil is a calendar date; arithmetic goes through UTC, which has no
+// transitions.
+type civil struct {
+	y int
+	m time.Month
+	d int
+}
+
+func dateOf(t time.Time) civil {
+	y, m, d := t.Date()
+	return civil{y, m, d}
+}
+
+func (c civil) addDays(k int) civil {
+	return dateOf(time.Date(c.y, c.m, c.d+k, 12, 0, 0, 0, time.UTC))
+}
+
+func (c civil) addMonths(k int) civil {
+	return dateOf(time.Date(c.y, c.m+time.Month(k), c.d, 12, 0, 0, 0, time.UTC))
+}
+
+func (c civil) weekday() time.Weekday {
+	return time.Date(c.y, c.m, c.d, 12, 0, 0, 0, time.UTC).Weekday()
+}
+
+func (c civil) midnight(loc *time.Location) time.Time { return mid(c.y, c.m, c.d, loc) }
+
+func (c civil) clean(loc *time.Location) bool { return cleanMidnight(c.y, c.m, c.d, loc) }
+
+// first is the first of c's month.
+func (c civil) first() civil { return civil{c.y, c.m, 1} }
+
+// weekStart is the date of the week's first day on or before c.
+func (c civil) weekStart(start time.Weekday) civil {
+	return c.addDays(-int((c.weekday() - start + 7) % 7))
+}
+
+// isoMonday is the Monday on or before c (a Sunday belongs to the week of
+// the Monday six days earlier), as the README defines Monday().
+func (c civil) isoMonday() civil {
+	wd := int(c.weekday())
+	if wd == 0 {
+		wd = 7
+	}
+	return c.addDays(-wd + 1)
+}
+
+// nextSunday is the Sunday on or after c, as the README defines Sunday().
+func (c civil) nextSunday() civil {
+	wd := int(c.weekday())
+	if wd == 0 {
+		wd = 7
+	}
+	return c.addDays(7 - wd)
+}
+
+// unit is one of now's calendar units with its model.
+type unit struct {
+	name  string
+	begin func(*now.Now) time.Time
+	end   func(*now.Now) time.Time
+	// span gives the first date of the unit containing c and the first
+	// date of the next unit.
+	span func(c civil, start time.Weekday) (from, to civil)
+}
+
+var calendarUnits = []unit{
+	{"Day", (*now.Now).BeginningOfDay, (*now.Now).EndOfDay,
+		func(c civil, _ time.Weekday) (civil, civil) { return c, c.addDays(1) }},
+	{"Week", (*now.Now).BeginningOfWeek, (*now.Now).EndOfWeek,
+		func(c civil, start time.Weekday) (civil, civil) {
+			s := c.weekStart(start)
+			return s, s.addDays(7)
+		}},
+	{"Month", (*now.Now).BeginningOfMonth, (*now.Now).EndOfMonth,
+		func(c civil, _ time.Weekday) (civil, civil) {
+			s := civil{c.y, c.m, 1}
+			return s, s.addMonths(1)
+		}},
+	{"Quarter", (*now.Now).BeginningOfQuarter, (*now.Now).EndOfQuarter,
+		func(c civil, _ time.Weekday) (civil, civil) {
+			s := civil{c.y, time.Month(3*((int(c.m)-1)/3) + 1), 1}
+			return s, s.addMonths(3)
+		}},
+	{"Half", (*now.Now).BeginningOfHalf, (*now.Now).EndOfHalf,
+		func(c civil, _ time.Weekday) (civil, civil) {
+			s := civil{c.y, time.Month(6*((int(c.m)-1)/6) + 1), 1}
+			return s, s.addMonths(6)
+		}},
+	{"Year", (*now.Now).BeginningOfYear, (*now.Now).EndOfYear,
+		func(c civil, _ time.Weekday) (civil, civil) {
+			s := civil{c.y, time.January, 1}
+			return s, s.addMonths(12)
+		}},
+}
+
+func withStart(t time.Time, start time.Weekday) *now.Now {
+	return (&now.Config{WeekStartDay: start, TimeFormats: now.TimeFormats}).With(t)
+}
+
+// ---------------------------------------------------------------------------
+// Property: the calendar units begin and end where the calendar says.
+
+// calendarCase: the zone, the instant, the week's first day and the unit (an index into
+// calendarUnits).
+type calendarCase struct {
+	zone  zone
+	t     instant
+	start time.Weekday
+	unit  int
+}
+
+func (c calendarCase) GoString() string {
+	return fmt.Sprintf("%s of %s (week start %s)", calendarUnits[c.unit].name, fmtT(c.t.at(c.zone.loc())), c.start)
+}
+
+// clean reports whether the case is none of the pinned shapes (now/3, now/4, now/5): the
+// unit's own boundaries, the midnight of the instant's date (weeks are computed from
+// BeginningOfDay), the first of its month (quarters and halves are computed from
+// BeginningOfMonth), and the same two for the unit's last day (the end's own date, from
+// which the end is asked again) all have a clean midnight.
+func (c calendarCase) clean() bool {
+	loc := c.zone.loc()
+	d := dateOf(c.t.at(loc))
+	from, to := calendarUnits[c.unit].span(d, c.start)
+	last := to.addDays(-1)
+	return from.clean(loc) && to.clean(loc) && d.clean(loc) && d.first().clean(loc) &&
+		last.clean(loc) && last.first().clean(loc)
+}
+
+var (
+	weekdays  = hegel.Map(hegel.Integers(0, 6), func(d int) time.Weekday { return time.Weekday(d) })
+	unitIndex = hegel.Integers(0, len(calendarUnits)-1)
+
+	calendarCases = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) calendarCase {
+		return calendarCase{zone: hegel.Draw(tc, zones), t: hegel.Draw(tc, instants), start: hegel.Draw(tc, weekdays), unit: hegel.Draw(tc, unitIndex)}
+	}), calendarCase.clean)
+)
+
+func TestHegelCalendarUnitsBeginAndEndOnTheCalendar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, calendarCases)
+		loc, start, u := c.zone.loc(), c.start, calendarUnits[c.unit]
+		tt := c.t.at(loc)
+		d := dateOf(tt)
+		from, to := u.span(d, start)
+
+		nw := withStart(tt, start)
+		wantB := from.midnight(loc)
+		wantE := to.midnight(loc).Add(-time.Nanosecond)
+		gotB := u.begin(nw)
+		gotE := u.end(nw)
+		if !gotB.Equal(wantB) || gotB.Location() != loc {
+			ht.Fatalf("BeginningOf%s(%s, week start %s) = %s, want %s", u.name, fmtT(tt), start, fmtT(gotB), fmtT(wantB))
+		}
+		if !gotE.Equal(wantE) || gotE.Location() != loc {
+			ht.Fatalf("EndOf%s(%s, week start %s) = %s, want %s", u.name, fmtT(tt), start, fmtT(gotE), fmtT(wantE))
+		}
+		// Idempotence and closure.
+		if b2 := u.begin(withStart(gotB, start)); !b2.Equal(gotB) {
+			ht.Fatalf("BeginningOf%s is not idempotent: %s -> %s", u.name, fmtT(gotB), fmtT(b2))
+		}
+		if e2 := u.end(withStart(gotE, start)); !e2.Equal(gotE) {
+			ht.Fatalf("EndOf%s is not idempotent: %s -> %s", u.name, fmtT(gotE), fmtT(e2))
+		}
+		if b3 := u.begin(withStart(gotE, start)); !b3.Equal(gotB) {
+			ht.Fatalf("BeginningOf%s(EndOf%s(%s)) = %s, want %s", u.name, u.name, fmtT(tt), fmtT(b3), fmtT(gotB))
+		}
+		// The package-level WeekStartDay and the plain With agree with the
+		// Config path.
+		if u.name == "Week" {
+			old := now.WeekStartDay
+			now.WeekStartDay = start
+			gb, ge := now.With(tt).BeginningOfWeek(), now.With(tt).EndOfWeek()
+			now.WeekStartDay = old
+			if !gb.Equal(wantB) || !ge.Equal(wantE) {
+				ht.Fatalf("now.With with WeekStartDay %s: %s .. %s, want %s .. %s", start, fmtT(gb), fmtT(ge), fmtT(wantB), fmtT(wantE))
+			}
+		}
+		if q := nw.Quarter(); q != uint((int(d.m)-1)/3+1) {
+			ht.Fatalf("Quarter(%s) = %d", fmtT(tt), q)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: minutes and hours begin and end on the clock.
+
+// clockCase: the zone and the instant; a transition within two hours of it is a pinned
+// shape (now/2), so the case is clean when there is none.
+type clockCase struct {
+	zone zone
+	t    instant
+}
+
+func (c clockCase) GoString() string {
+	return fmt.Sprintf("clock units of %s", fmtT(c.t.at(c.zone.loc())))
+}
+
+func (c clockCase) clean() bool { return cleanAround(c.t.at(c.zone.loc())) }
+
+var clockCases = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) clockCase {
+	return clockCase{zone: hegel.Draw(tc, zones), t: hegel.Draw(tc, instants)}
+}), clockCase.clean)
+
+func TestHegelClockUnitsBeginAndEndOnTheClock(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, clockCases)
+		loc := c.zone.loc()
+		tt := c.t.at(loc)
+		nw := now.With(tt)
+		y, m, d := tt.Date()
+		h, mi, _ := tt.Clock()
+		wantMinB := time.Date(y, m, d, h, mi, 0, 0, loc)
+		wantHourB := time.Date(y, m, d, h, 0, 0, 0, loc)
+		checks := []struct {
+			name string
+			got  time.Time
+			want time.Time
+		}{
+			{"BeginningOfMinute", nw.BeginningOfMinute(), wantMinB},
+			{"EndOfMinute", nw.EndOfMinute(), wantMinB.Add(time.Minute - time.Nanosecond)},
+			{"BeginningOfHour", nw.BeginningOfHour(), wantHourB},
+			{"EndOfHour", nw.EndOfHour(), wantHourB.Add(time.Hour - time.Nanosecond)},
+		}
+		for _, ck := range checks {
+			if !ck.got.Equal(ck.want) || ck.got.Location() != loc {
+				ht.Fatalf("%s(%s) = %s, want %s", ck.name, fmtT(tt), fmtT(ck.got), fmtT(ck.want))
+			}
+		}
+		if b := now.With(nw.BeginningOfHour()).BeginningOfHour(); !b.Equal(wantHourB) {
+			ht.Fatalf("BeginningOfHour is not idempotent at %s: %s", fmtT(tt), fmtT(b))
+		}
+		if b := now.With(nw.EndOfMinute()).BeginningOfMinute(); !b.Equal(wantMinB) {
+			ht.Fatalf("BeginningOfMinute(EndOfMinute(%s)) = %s", fmtT(tt), fmtT(b))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Parse: layouts and their rendering.
+
+// layoutSpec describes one of now's default layouts: how to render a time
+// and which fields the text carries.
+type layoutSpec struct {
+	layout   string
+	hasDate  bool // year, month and day (or the fields present)
+	hasYear  bool
+	hasMonth bool
+	hasDay   bool
+	hasClock bool // at least the hour
+	hasMin   bool
+	hasSec   bool
+	zoned    bool // carries a numeric offset
+}
+
+var dateLayouts = []layoutSpec{
+	{layout: "2006", hasDate: true, hasYear: true},
+	{layout: "2006-1", hasDate: true, hasYear: true, hasMonth: true},
+	{layout: "2006-1-2", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006.1.2", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006.01.02", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "1/2/2006", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "2006/01/02", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+	{layout: "20060102", hasDate: true, hasYear: true, hasMonth: true, hasDay: true},
+}
+
+var dateTimeLayouts = []layoutSpec{
+	{layout: "2006-1-2 15", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true},
+	{layout: "2006-1-2 15:4", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true},
+	{layout: "2006-1-2 15:4:5", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: "2006.1.2 15:04:05", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: "2006.01.02 15:04:05", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: "1/2/2006 15:4:5", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: "2006/01/02 15:04:05", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true},
+	{layout: time.RFC3339, hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true, zoned: true},
+	{layout: "2006-01-02T15:04:05Z0700", hasDate: true, hasYear: true, hasMonth: true, hasDay: true, hasClock: true, hasMin: true, hasSec: true, zoned: true},
+}
+
+var timeLayouts = []layoutSpec{
+	{layout: "15:4:5", hasClock: true, hasMin: true, hasSec: true},
+	{layout: "15:4", hasClock: true, hasMin: true},
+	{layout: "15", hasClock: true},
+}
+
+var monthDayLayout = layoutSpec{layout: "1-2", hasMonth: true, hasDay: true}
+
+// layouts is every layout the oracle covers, in groups: the date-only ones, the date-time
+// ones, the time-only ones and the month-day one; the *Index generators draw an index into
+// it from one group.
+var (
+	layouts = slices.Concat(dateLayouts, dateTimeLayouts, timeLayouts, []layoutSpec{monthDayLayout})
+
+	firstDateTime = len(dateLayouts)
+	firstTimeOnly = firstDateTime + len(dateTimeLayouts)
+	monthDayIndex = firstTimeOnly + len(timeLayouts)
+
+	// dayIndex: the date-only layouts that carry a day (the two-string form needs one).
+	dayIndex = hegel.Integers(2, firstDateTime-1)
+	// unzonedDateTimeIndex: the date-time layouts without an offset (the zoned two are last).
+	unzonedDateTimeIndex = hegel.Integers(firstDateTime, firstTimeOnly-3)
+	timeOnlyIndex        = hegel.Integers(firstTimeOnly, monthDayIndex-1)
+
+	// layoutIndex: an index into layouts from a table in which each group weighs a quarter.
+	// One draw rather than a weighted choice with a draw-free month-day alternative, so that
+	// the shrinker can move between the layouts freely and lands on the first, "2006".
+	layoutIndex = hegel.SampledFrom(evenGroups(len(dateLayouts), len(dateTimeLayouts), len(timeLayouts), 1))
+)
+
+// evenGroups is an index table over consecutive groups of the given sizes in which every group
+// has the same total weight: each member of a group of n is repeated 72/n times.
+func evenGroups(sizes ...int) []int {
+	var table []int
+	start := 0
+	for _, n := range sizes {
+		for i := 0; i < n; i++ {
+			for k := 0; k < 72/n; k++ {
+				table = append(table, start+i)
+			}
+		}
+		start += n
+	}
+	return table
+}
+
+// digitsFraction: nanoseconds whose shortest decimal rendering has exactly the digits the
+// scale leaves: a number up to hi, then a non-zero last digit, times the scale.
+func digitsFraction(hi, scale int) hegel.Generator[int] {
+	return hegel.Composite(func(tc hegel.TestCase) int {
+		return (hegel.Draw(tc, hegel.Integers(0, hi))*10 + hegel.Draw(tc, hegel.Integers(1, 9))) * scale
+	})
+}
+
+// fractions: no fraction seven times in ten, else one of 3, 6 or 9 digits (other lengths
+// are pinned, now/7).
+var fractions = weighted(
+	choice[int]{70, hegel.Just(0)},
+	choice[int]{30, hegel.OneOf(digitsFraction(99, 1000000), digitsFraction(99999, 1000), digitsFraction(99999999, 1))},
+)
+
+// render formats v in the layout, appending a fraction to the seconds when
+// asked (Go accepts one after any seconds field).
+func render(spec layoutSpec, v time.Time, frac int) string {
+	layout := spec.layout
+	if spec.hasSec && frac != 0 {
+		v = v.Add(time.Duration(frac))
+		if strings.Contains(layout, "05") {
+			layout = strings.Replace(layout, "05", "05.999999999", 1)
+		} else {
+			layout = strings.Replace(layout, ":5", ":5.999999999", 1)
+		}
+	}
+	return v.Format(layout)
+}
+
+// expectedParse is the time Parse should produce for a string in spec
+// rendered from v, given the reference time base.
+func expectedParse(spec layoutSpec, v, base time.Time, frac int) time.Time {
+	y, m, d := base.Date()
+	if spec.hasYear {
+		y = v.Year()
+	}
+	if spec.hasMonth {
+		m = v.Month()
+	} else if spec.hasDate {
+		m = time.January
+	}
+	if spec.hasDay {
+		d = v.Day()
+	} else if spec.hasDate {
+		d = 1
+	}
+	h, mi, s, ns := 0, 0, 0, 0
+	if spec.hasClock {
+		h = v.Hour()
+	}
+	if spec.hasMin {
+		mi = v.Minute()
+	}
+	if spec.hasSec {
+		s = v.Second()
+		ns = frac
+	}
+	loc := base.Location()
+	if spec.zoned {
+		_, off := v.Zone()
+		if off == 0 {
+			loc = time.UTC
+		} else {
+			loc = time.FixedZone("", off)
+		}
+	}
+	return time.Date(y, m, d, h, mi, s, ns, loc)
+}
+
+// parsable: the fields of a time whose rendering in a layout is unambiguous: years
+// 1970-2100 (three times in five) or 1000-2999, days 1-28, and for a zoned layout a
+// whole-minute offset, in which the time is then expressed.
+type parsable struct {
+	y                int
+	m                time.Month
+	d, h, mi, s, off int
+	zoned            bool
+}
+
+func (p parsable) at(loc *time.Location) time.Time {
+	v := time.Date(p.y, p.m, p.d, p.h, p.mi, p.s, 0, loc)
+	if p.zoned {
+		v = v.In(time.FixedZone("", p.off*60))
+	}
+	return v
+}
+
+var years = weighted(choice[int]{60, hegel.Integers(1970, 2100)}, choice[int]{40, hegel.Integers(1000, 2999)})
+
+func parsablesOf(zoned bool) hegel.Generator[parsable] {
+	offsets := hegel.Just(0)
+	if zoned {
+		offsets = hegel.Integers(-14*60, 14*60)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) parsable {
+		return parsable{
+			y:     hegel.Draw(tc, years),
+			m:     time.Month(hegel.Draw(tc, hegel.Integers(1, 12))),
+			d:     hegel.Draw(tc, hegel.Integers(1, 28)),
+			h:     hegel.Draw(tc, hours),
+			mi:    hegel.Draw(tc, minutes),
+			s:     hegel.Draw(tc, seconds),
+			off:   hegel.Draw(tc, offsets),
+			zoned: zoned,
+		}
+	})
+}
+
+var plainParsables, zonedParsables = parsablesOf(false), parsablesOf(true)
+
+// same compares instant, offset and wall clock; the zone abbreviation is
+// left out because ParseInLocation reuses the location's zone when the
+// parsed offset matches it (documented Go behaviour).
+func same(a, b time.Time) bool {
+	const noName = "2006-01-02 15:04:05.000000000 -07:00:00"
+	return a.Equal(b) && a.Format(noName) == b.Format(noName)
+}
+
+// ---------------------------------------------------------------------------
+// Property: Parse fills the missing fields from "now".
+
+// parseCase: the zone and the "now"; the layout (an index into layouts), the time to render
+// in it and its fraction; and, for a time-only layout, the date-only layout with a day and
+// the time to render in it for the two-string form (dateLayout is -1 otherwise).
+type parseCase struct {
+	zone       zone
+	base       instant
+	layout     int
+	v          parsable
+	frac       int
+	dateLayout int
+	dv         parsable
+}
+
+func (c parseCase) spec() layoutSpec { return layouts[c.layout] }
+
+func (c parseCase) text() string { return render(c.spec(), c.v.at(c.zone.loc()), c.frac) }
+
+func (c parseCase) want() time.Time {
+	loc := c.zone.loc()
+	return expectedParse(c.spec(), c.v.at(loc), c.base.at(loc), c.frac)
+}
+
+func (c parseCase) dateText() string { return render(layouts[c.dateLayout], c.dv.at(c.zone.loc()), 0) }
+
+// want2 is the answer of the two-string form: the date string's date at the time string's
+// clock.
+func (c parseCase) want2() time.Time {
+	loc := c.zone.loc()
+	dv, w := c.dv.at(loc), c.want()
+	return time.Date(dv.Year(), dv.Month(), dv.Day(), w.Hour(), w.Minute(), w.Second(), w.Nanosecond(), loc)
+}
+
+func (c parseCase) GoString() string {
+	s := fmt.Sprintf("Parse(%q) [%s] with now = %s", c.text(), c.spec().layout, fmtT(c.base.at(c.zone.loc())))
+	if c.dateLayout >= 0 {
+		s += fmt.Sprintf("; Parse(%q, %q) [%s]", c.text(), c.dateText(), layouts[c.dateLayout].layout)
+	}
+	return s
+}
+
+// clean: an expected wall time within two hours of a transition (a date whose midnight does
+// not exist, or today's skipped hour) is the pinned shape now/11; the date string of the
+// two-string form is parsed as its midnight first, so that midnight must be clean too.
+func (c parseCase) clean() bool {
+	if !c.spec().zoned && !cleanAround(c.want()) {
+		return false
+	}
+	if c.dateLayout >= 0 {
+		w := c.want2()
+		if !cleanAround(w) || !dateOf(w).clean(c.zone.loc()) {
+			return false
+		}
+	}
+	return true
+}
+
+// parseCases: the layout decides what else is drawn: a fraction only with seconds, an
+// offset only with a zone, the second string only for a time-only layout.
+var parseCases = hegel.Filter(hegel.FlatMap(layoutIndex, func(li int) hegel.Generator[parseCase] {
+	spec := layouts[li]
+	fracs := hegel.Just(0)
+	if spec.hasSec {
+		fracs = fractions
+	}
+	vs := plainParsables
+	if spec.zoned {
+		vs = zonedParsables
+	}
+	dls, dvs := hegel.Just(-1), hegel.Just(parsable{})
+	if spec.hasClock && !spec.hasDate {
+		dls, dvs = dayIndex, plainParsables
+	}
+	return hegel.Composite(func(tc hegel.TestCase) parseCase {
+		return parseCase{
+			zone:       hegel.Draw(tc, zones),
+			base:       hegel.Draw(tc, instants),
+			layout:     li,
+			v:          hegel.Draw(tc, vs),
+			frac:       hegel.Draw(tc, fracs),
+			dateLayout: hegel.Draw(tc, dls),
+			dv:         hegel.Draw(tc, dvs),
+		}
+	})
+}), parseCase.clean)
+
+func TestHegelParseFillsFromNow(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, parseCases)
+		spec, loc := c.spec(), c.zone.loc()
+		base, text, want := c.base.at(loc), c.text(), c.want()
+
+		got, err := now.With(base).Parse(text)
+		if err != nil {
+			ht.Fatalf("Parse(%q) [%s]: %v", text, spec.layout, err)
+		}
+		if !same(got, want) {
+			ht.Fatalf("Parse(%q) [%s] with now = %s: %s, want %s", text, spec.layout, fmtT(base), fmtT(got), fmtT(want))
+		}
+		if mp := now.With(base).MustParse(text); !same(mp, want) {
+			ht.Fatalf("MustParse(%q) = %s, want %s", text, fmtT(mp), fmtT(want))
+		}
+		// The Config path with an explicit location parses the same.
+		cfg := &now.Config{WeekStartDay: time.Sunday, TimeLocation: loc, TimeFormats: now.TimeFormats}
+		if cg, err := cfg.With(base).Parse(text); err != nil || !same(cg, want) {
+			ht.Fatalf("Config.With(...).Parse(%q) = %s, %v; want %s", text, fmtT(cg), err, fmtT(want))
+		}
+		// A Config restricted to this layout parses it; restricted to a
+		// layout that cannot read it, it refuses.
+		one := &now.Config{TimeFormats: []string{spec.layout}}
+		if cg, err := one.With(base).Parse(text); err != nil || !same(cg, want) {
+			ht.Fatalf("Config{TimeFormats: [%q]}.Parse(%q) = %s, %v; want %s", spec.layout, text, fmtT(cg), err, fmtT(want))
+		}
+		if spec.hasDate && spec.hasDay {
+			other := "2006-01-02 15:04:05.999999999 -0700 MST"
+			if cg, err := (&now.Config{TimeFormats: []string{other}}).With(base).Parse(text); err == nil {
+				ht.Fatalf("Config{TimeFormats: [%q]}.Parse(%q) = %s, want an error", other, text, fmtT(cg))
+			}
+		}
+
+		// A time-only string after a date-only string, in the order the
+		// code fills from: the clock then the date (the other order is
+		// pinned, now/9).
+		if c.dateLayout >= 0 {
+			dtext, want2 := c.dateText(), c.want2()
+			got2, err := now.With(base).Parse(text, dtext)
+			if err != nil || !same(got2, want2) {
+				ht.Fatalf("Parse(%q, %q) with now = %s: %s, %v; want %s", text, dtext, fmtT(base), fmtT(got2), err, fmtT(want2))
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: malformed strings are refused; MustParse panics.
+
+// malformed: a string no layout accepts, and what is wrong with it.
+type malformed struct{ what, text string }
+
+// malformedTexts: one of the texts.
+func malformedTexts(what string, texts ...string) hegel.Generator[malformed] {
+	return hegel.Map(hegel.SampledFrom(texts), func(text string) malformed { return malformed{what, text} })
+}
+
+// malformedNumbers: the format filled with one number from each of the parts.
+func malformedNumbers(what, format string, parts ...hegel.Generator[int]) hegel.Generator[malformed] {
+	return hegel.Composite(func(tc hegel.TestCase) malformed {
+		args := make([]any, len(parts))
+		for i, p := range parts {
+			args[i] = hegel.Draw(tc, p)
+		}
+		return malformed{what, fmt.Sprintf(format, args...)}
+	})
+}
+
+var (
+	recentYears = hegel.Integers(1970, 2100)
+	// malformeds: the nine shapes of unparseable strings, the empty one first.
+	malformeds = hegel.OneOf(
+		hegel.Just(malformed{"empty", ""}),
+		malformedTexts("surrounding blank", " 12:20", "12:20 ", " 2017-10-13"),
+		malformedTexts("letters", "today", "yesterday", "noon", "x", "2017-10-13x", "12:20pm", "2017-10-13T12:20:21"),
+		malformedNumbers("hour out of range", "%d:%02d", hegel.Integers(24, 99), minutes),
+		malformedNumbers("minute out of range", "%d:%d", hours, hegel.Integers(60, 99)),
+		malformedNumbers("second out of range", "%d:%d:%d", hours, minutes, hegel.Integers(60, 99)),
+		malformedNumbers("month out of range", "%d-%d-%d", recentYears, hegel.Integers(13, 99), hegel.Integers(1, 28)),
+		malformedNumbers("day out of range", "%d-%d-%d", recentYears, hegel.Integers(1, 12), hegel.Integers(32, 99)),
+		malformedNumbers("February 30", "%d-02-%d", recentYears, hegel.Integers(30, 31)),
+	)
+)
+
+// malformedCase: the zone and the "now", and the string.
+type malformedCase struct {
+	zone zone
+	base instant
+	m    malformed
+}
+
+func (c malformedCase) GoString() string {
+	return fmt.Sprintf("%s: %q with now = %s", c.m.what, c.m.text, fmtT(c.base.at(c.zone.loc())))
+}
+
+var malformedCases = hegel.Composite(func(tc hegel.TestCase) malformedCase {
+	return malformedCase{zone: hegel.Draw(tc, zones), base: hegel.Draw(tc, instants), m: hegel.Draw(tc, malformeds)}
+})
+
+func TestHegelMalformedStringsAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, malformedCases)
+		base, text, what := c.base.at(c.zone.loc()), c.m.text, c.m.what
+		got, err := now.With(base).Parse(text)
+		if err == nil {
+			ht.Fatalf("Parse(%q) [%s] = %s, want an error", text, what, fmtT(got))
+		} else if !got.IsZero() {
+			ht.Fatalf("Parse(%q) [%s] returned %s with an error", text, what, fmtT(got))
+		}
+		func() {
+			defer func() {
+				if recover() == nil {
+					ht.Fatalf("MustParse(%q) [%s] did not panic", text, what)
+				}
+			}()
+			now.With(base).MustParse(text)
+		}()
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: Monday, Sunday, EndOfSunday and Between follow the README.
+
+// weekCase: the zone and the instant; a time-only layout (an index into layouts) and a time
+// to render in it for Monday(text) and Sunday(text); a date-time layout without an offset
+// for Between, and the seconds its bounds lie before and after the instant.
+type weekCase struct {
+	zone    zone
+	t       instant
+	layout  int
+	v       parsable
+	between int
+	lo, hi  int
+}
+
+func (c weekCase) at() time.Time { return c.t.at(c.zone.loc()) }
+
+func (c weekCase) text() string { return render(layouts[c.layout], c.v.at(c.zone.loc()), 0) }
+
+// clockOf is the instant the time-only string means on the instant's own day.
+func (c weekCase) clockOf() time.Time {
+	loc := c.zone.loc()
+	return expectedParse(layouts[c.layout], c.v.at(loc), c.at(), 0)
+}
+
+// onDay is the time-only string's clock on the date d.
+func (c weekCase) onDay(d civil) time.Time {
+	w := c.clockOf()
+	return time.Date(d.y, d.m, d.d, w.Hour(), w.Minute(), w.Second(), 0, c.zone.loc())
+}
+
+// bounds are the Between bounds: whole seconds up to an hour before and after the instant.
+func (c weekCase) bounds() (lo, hi time.Time) {
+	tt := c.at()
+	return tt.Add(-time.Duration(c.lo) * time.Second).Truncate(time.Second), tt.Add(time.Duration(c.hi) * time.Second).Truncate(time.Second)
+}
+
+func (c weekCase) boundTexts() (string, string) {
+	lo, hi := c.bounds()
+	return render(layouts[c.between], lo, 0), render(layouts[c.between], hi, 0)
+}
+
+func (c weekCase) GoString() string {
+	loText, hiText := c.boundTexts()
+	return fmt.Sprintf("Monday/Sunday of %s; Monday(%q) [%s]; Between(%q, %q) [%s]", fmtT(c.at()), c.text(), layouts[c.layout].layout, loText, hiText, layouts[c.between].layout)
+}
+
+// clean: the midnights of the instant's date, of its Monday, of its Sunday and of the day
+// after (EndOfSunday is that midnight less a nanosecond) are clean (now/3); the time-only
+// string's wall time on the Monday and the Sunday, and the two Between bounds, lie away from
+// a transition (now/2, now/11).
+func (c weekCase) clean() bool {
+	loc := c.zone.loc()
+	d := dateOf(c.at())
+	mon, sun := d.isoMonday(), d.nextSunday()
+	if !(d.clean(loc) && mon.clean(loc) && sun.clean(loc) && sun.addDays(1).clean(loc)) {
+		return false
+	}
+	lo, hi := c.bounds()
+	return cleanAround(c.onDay(mon)) && cleanAround(c.onDay(sun)) && cleanAround(lo) && cleanAround(hi)
+}
+
+var (
+	hourSpans = hegel.Integers(0, 3600)
+	weekCases = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) weekCase {
+		return weekCase{
+			zone:    hegel.Draw(tc, zones),
+			t:       hegel.Draw(tc, instants),
+			layout:  hegel.Draw(tc, timeOnlyIndex),
+			v:       hegel.Draw(tc, plainParsables),
+			between: hegel.Draw(tc, unzonedDateTimeIndex),
+			lo:      hegel.Draw(tc, hourSpans),
+			hi:      hegel.Draw(tc, hourSpans),
+		}
+	}), weekCase.clean)
+)
+
+func TestHegelMondaySundayAndBetween(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, weekCases)
+		loc := c.zone.loc()
+		tt := c.at()
+		d := dateOf(tt)
+		mon, sun := d.isoMonday(), d.nextSunday()
+		nw := now.With(tt)
+		if got := nw.Monday(); !got.Equal(mon.midnight(loc)) {
+			ht.Fatalf("Monday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(mon.midnight(loc)))
+		}
+		if got := nw.Sunday(); !got.Equal(sun.midnight(loc)) {
+			ht.Fatalf("Sunday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(sun.midnight(loc)))
+		}
+		if got, want := nw.EndOfSunday(), sun.addDays(1).midnight(loc).Add(-time.Nanosecond); !got.Equal(want) {
+			ht.Fatalf("EndOfSunday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(want))
+		}
+
+		// With a time-only string: the same day shift, that clock.
+		text := c.text()
+		if got, want := nw.Monday(text), c.onDay(mon); !got.Equal(want) {
+			ht.Fatalf("Monday(%q) at %s = %s, want %s", text, fmtT(tt), fmtT(got), fmtT(want))
+		}
+		if got, want := nw.Sunday(text), c.onDay(sun); !got.Equal(want) {
+			ht.Fatalf("Sunday(%q) at %s = %s, want %s", text, fmtT(tt), fmtT(got), fmtT(want))
+		}
+
+		// Between is strict on both ends.
+		dspec := layouts[c.between]
+		lo, hi := c.bounds()
+		loText, hiText := c.boundTexts()
+		loT, hiT := expectedParse(dspec, lo, tt, 0), expectedParse(dspec, hi, tt, 0)
+		want2 := tt.After(loT) && tt.Before(hiT)
+		note(ht, "Between: %s .. %s", fmtT(loT), fmtT(hiT))
+		if got := nw.Between(loText, hiText); got != want2 {
+			ht.Fatalf("Between(%q, %q) at %s = %v, want %v", loText, hiText, fmtT(tt), got, want2)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Pins: one test per recorded bug, each failing while the bug is present.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func mustLoc(t *testing.T, name string) *time.Location {
+	t.Helper()
+	loc, err := time.LoadLocation(name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return loc
+}
+
+func expect(t *testing.T, what string, got, want time.Time) {
+	t.Helper()
+	if !got.Equal(want) {
+		t.Errorf("%s = %s, want %s", what, fmtT(got), fmtT(want))
+	}
+}
+
+// now/1: BeginningOfMinute truncates the absolute time, so a location whose
+// offset is not a whole number of minutes (LMT +00:19:32) gets :32 seconds.
+func TestHegelPinSubMinuteOffsetMinute(t *testing.T) {
+	defer guard(t)
+	lmt := time.FixedZone("LMT", 19*60+32)
+	tt := time.Date(2017, 10, 13, 12, 34, 50, 123, lmt)
+	expect(t, "BeginningOfMinute", now.With(tt).BeginningOfMinute(), time.Date(2017, 10, 13, 12, 34, 0, 0, lmt))
+	expect(t, "EndOfMinute", now.With(tt).EndOfMinute(), time.Date(2017, 10, 13, 12, 34, 59, 999999999, lmt))
+}
+
+// now/2: BeginningOfHour rebuilds the wall clock with time.Date, so in a
+// repeated hour it picks the other occurrence and EndOfHour assumes hours
+// are sixty minutes long.
+func TestHegelPinRepeatedOrShortHour(t *testing.T) {
+	defer guard(t)
+	ny := mustLoc(t, "America/New_York")
+	second := time.Date(2025, 11, 2, 6, 30, 0, 0, time.UTC).In(ny) // the second 01:30, EST
+	expect(t, "BeginningOfHour(second 01:30 EST)", now.With(second).BeginningOfHour(), time.Date(2025, 11, 2, 6, 0, 0, 0, time.UTC))
+	expect(t, "EndOfHour(second 01:30 EST)", now.With(second).EndOfHour(), time.Date(2025, 11, 2, 6, 59, 59, 999999999, time.UTC))
+	lh := mustLoc(t, "Australia/Lord_Howe")
+	lht := time.Date(2025, 10, 4, 15, 45, 0, 0, time.UTC).In(lh) // 02:45 +11, the hour began at 02:30
+	expect(t, "EndOfHour(Lord Howe 02:45)", now.With(lht).EndOfHour(), time.Date(2025, 10, 4, 15, 59, 59, 999999999, time.UTC))
+}
+
+// now/3: when midnight does not exist (daylight saving starting at 00:00),
+// BeginningOfDay is 23:00 of the previous day and everything built on it —
+// BeginningOfWeek, EndOfWeek, Monday, Sunday, EndOfSunday — moves with it.
+func TestHegelPinSkippedMidnightDay(t *testing.T) {
+	defer guard(t)
+	hv := mustLoc(t, "America/Havana")
+	firstOfMar9 := time.Date(2025, 3, 9, 5, 0, 0, 0, time.UTC) // 01:00 CDT, the first instant of March 9
+	noon := time.Date(2025, 3, 9, 12, 0, 0, 0, hv)
+	expect(t, "BeginningOfDay(Havana 2025-03-09)", now.With(noon).BeginningOfDay(), firstOfMar9)
+	expect(t, "BeginningOfWeek(Havana 2025-03-09, Sunday start)", withStart(noon, time.Sunday).BeginningOfWeek(), firstOfMar9)
+	expect(t, "Monday(Havana 2025-03-09)", now.With(noon).Monday(), time.Date(2025, 3, 3, 0, 0, 0, 0, hv))
+	wed := time.Date(2025, 3, 5, 12, 0, 0, 0, hv)
+	expect(t, "Sunday(Havana 2025-03-05)", now.With(wed).Sunday(), firstOfMar9)
+	sat := time.Date(2025, 3, 8, 12, 0, 0, 0, hv)
+	expect(t, "EndOfWeek(Havana 2025-03-08, Sunday start)", withStart(sat, time.Sunday).EndOfWeek(), firstOfMar9.Add(-time.Nanosecond))
+}
+
+// now/4: the same skipped midnight on the first of the month shifts
+// BeginningOfMonth into the previous month, and the quarter and half built
+// on it are off by an hour (Beirut 1990) or a whole month (Asunción 2002).
+func TestHegelPinSkippedMidnightQuarter(t *testing.T) {
+	defer guard(t)
+	beirut := mustLoc(t, "Asia/Beirut")
+	tt := time.Date(1990, 5, 19, 12, 0, 0, 0, beirut)
+	expect(t, "BeginningOfHalf(Beirut 1990-05-19)", now.With(tt).BeginningOfHalf(), time.Date(1990, 1, 1, 0, 0, 0, 0, beirut))
+	asu := mustLoc(t, "America/Asuncion")
+	q3 := time.Date(2002, 9, 30, 12, 0, 0, 0, asu)
+	expect(t, "BeginningOfQuarter(Asunción 2002-09-30)", now.With(q3).BeginningOfQuarter(), time.Date(2002, 7, 1, 0, 0, 0, 0, asu))
+	expect(t, "EndOfQuarter(Asunción 2002-09-30)", now.With(q3).EndOfQuarter(), time.Date(2002, 10, 1, 0, 0, 0, 0, asu).Add(-time.Nanosecond))
+}
+
+// now/5: EndOfDay rebuilds 23:59:59.999999999 with time.Date; when the last
+// hour of the day repeats (daylight saving ending at midnight) it returns
+// the earlier occurrence, which lies before the given time.
+func TestHegelPinEndOfDayInRepeatedHour(t *testing.T) {
+	defer guard(t)
+	sp := mustLoc(t, "America/Sao_Paulo")
+	tt := time.Date(2018, 2, 18, 2, 30, 0, 0, time.UTC).In(sp) // 23:30 -03, the second 23:30 of February 17
+	expect(t, "EndOfDay(São Paulo second 23:30)", now.With(tt).EndOfDay(), time.Date(2018, 2, 18, 2, 59, 59, 999999999, time.UTC))
+}
+
+// now/6: BeginningOfWeek counts back whole days with AddDate, so across a
+// skipped calendar day (Samoa, 30 December 2011) it lands on the day
+// before the week's first day.
+func TestHegelPinSkippedDayWeek(t *testing.T) {
+	defer guard(t)
+	apia := mustLoc(t, "Pacific/Apia")
+	sat := time.Date(2011, 12, 31, 12, 0, 0, 0, apia)
+	expect(t, "BeginningOfWeek(Apia 2011-12-31, Friday start)", withStart(sat, time.Friday).BeginningOfWeek(), time.Date(2011, 12, 31, 0, 0, 0, 0, apia))
+}
+
+var pinBase = time.Date(2013, 11, 18, 17, 51, 49, 123456789, time.UTC)
+
+func pinParse(t *testing.T, want time.Time, strs ...string) {
+	t.Helper()
+	got, err := now.With(pinBase).Parse(strs...)
+	if err != nil {
+		t.Errorf("Parse(%q): %v", strs, err)
+		return
+	}
+	expect(t, fmt.Sprintf("Parse(%q)", strs), got, want)
+}
+
+// now/7: the has-time detection only knows fractions of 3, 6 or 9 digits;
+// with any other length a time-only string lands on January 1st and a
+// zero clock field is replaced by the current one.
+func TestHegelPinFractionDigits(t *testing.T) {
+	defer guard(t)
+	pinParse(t, time.Date(2013, 11, 18, 12, 20, 13, 500000000, time.UTC), "12:20:13.5")
+	pinParse(t, time.Date(2017, 10, 13, 12, 0, 21, 500000000, time.UTC), "2017-10-13 12:00:21.5")
+}
+
+// now/8: Kitchen strings ("12:20PM") are not recognised as times and land
+// on January 1st.
+func TestHegelPinKitchenIsToday(t *testing.T) {
+	defer guard(t)
+	pinParse(t, time.Date(2013, 11, 18, 12, 20, 0, 0, time.UTC), "12:20PM")
+}
+
+// now/9: a month-day string matches the has-time pattern through its
+// hyphen, so a clock parsed from an earlier string is dropped.
+func TestHegelPinMonthDayLooksLikeTime(t *testing.T) {
+	defer guard(t)
+	pinParse(t, time.Date(2013, 10, 13, 12, 20, 0, 0, time.UTC), "12:20", "10-13")
+}
+
+// now/10: a date followed by a time-only string loses the date (January
+// 1st), because onlyTimeInStr is ANDed across the strings; the upstream
+// test only passes because its date is 2011-1-1.
+func TestHegelPinDateThenTime(t *testing.T) {
+	defer guard(t)
+	pinParse(t, time.Date(2017, 10, 13, 12, 20, 0, 0, time.UTC), "2017-10-13", "12:20")
+	pinParse(t, time.Date(2017, 10, 13, 18, 0, 0, 0, time.UTC), "2017-10-13", "18")
+}
+
+// now/11: a date-only string for a day whose midnight does not exist
+// parses to 23:00 of the previous day (Havana, Santiago) or to 01:00
+// (Beirut), and a time-only string combined with such a date has its clock
+// overwritten by that hour.
+func TestHegelPinDateWithoutMidnight(t *testing.T) {
+	defer guard(t)
+	hv := mustLoc(t, "America/Havana")
+	base := time.Date(2013, 11, 18, 17, 51, 49, 0, hv)
+	firstOfMar9 := time.Date(2025, 3, 9, 5, 0, 0, 0, time.UTC) // 01:00 CDT
+	if got, err := now.With(base).Parse("2025-03-09"); err != nil {
+		t.Error(err)
+	} else {
+		expect(t, `Parse("2025-03-09") in Havana`, got, firstOfMar9)
+	}
+	if got, err := now.With(base).Parse("12:20", "2025-03-09"); err != nil {
+		t.Error(err)
+	} else {
+		expect(t, `Parse("12:20", "2025-03-09") in Havana`, got, time.Date(2025, 3, 9, 12, 20, 0, 0, hv))
+	}
+	beirut := mustLoc(t, "Asia/Beirut")
+	if got, err := now.With(base.In(beirut)).Parse("02:00", "1973-5-1"); err != nil {
+		t.Error(err)
+	} else {
+		expect(t, `Parse("02:00", "1973-5-1") in Beirut`, got, time.Date(1973, 5, 1, 2, 0, 0, 0, beirut))
+	}
+}
