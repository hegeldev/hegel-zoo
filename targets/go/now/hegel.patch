+// ---------------------------------------------------------------------------
+// Property: malformed strings are refused; MustParse panics.
+
+func TestHegelMalformedStringsAreRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		loc := genLocation(ht)
+		base := genInstant(ht, loc)
+		var text, what string
+		switch n(ht, 0, 8) {
+		case 0:
+			what, text = "hour out of range", fmt.Sprintf("%d:%02d", n(ht, 24, 99), n(ht, 0, 59))
+		case 1:
+			what, text = "minute out of range", fmt.Sprintf("%d:%d", n(ht, 0, 23), n(ht, 60, 99))
+		case 2:
+			what, text = "month out of range", fmt.Sprintf("%d-%d-%d", n(ht, 1970, 2100), n(ht, 13, 99), n(ht, 1, 28))
+		case 3:
+			what, text = "day out of range", fmt.Sprintf("%d-%d-%d", n(ht, 1970, 2100), n(ht, 1, 12), n(ht, 32, 99))
+		case 4:
+			what, text = "February 30", fmt.Sprintf("%d-02-%d", n(ht, 1970, 2100), n(ht, 30, 31))
+		case 5:
+			what, text = "letters", pick(ht, []string{"today", "yesterday", "noon", "x", "2017-10-13x", "12:20pm", "2017-10-13T12:20:21"})
+		case 6:
+			what, text = "second out of range", fmt.Sprintf("%d:%d:%d", n(ht, 0, 23), n(ht, 0, 59), n(ht, 60, 99))
+		case 7:
+			what, text = "empty", ""
+		default:
+			what, text = "surrounding blank", pick(ht, []string{" 12:20", "12:20 ", " 2017-10-13"})
+		}
+		note(ht, "%s: %q", what, text)
+		got, err := now.With(base).Parse(text)
+		if err == nil {
+			fail(ht, "Parse(%q) [%s] = %s, want an error", text, what, fmtT(got))
+		} else if !got.IsZero() {
+			fail(ht, "Parse(%q) [%s] returned %s with an error", text, what, fmtT(got))
+		}
+		func() {
+			defer func() {
+				if recover() == nil {
+					fail(ht, "MustParse(%q) [%s] did not panic", text, what)
+				}
+			}()
+			now.With(base).MustParse(text)
+		}()
+	})
+}
