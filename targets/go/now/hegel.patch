+// ---------------------------------------------------------------------------
+// Property: Monday, Sunday, EndOfSunday and Between follow the README.
+
+func TestHegelMondaySundayAndBetween(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		loc := genLocation(ht)
+		tt := genInstant(ht, loc)
+		c := dateOf(tt)
+		mon, sun := c.isoMonday(), c.nextSunday()
+		clean := func() bool {
+			return c.clean(loc) && mon.clean(loc) && sun.clean(loc) && sun.addDays(1).clean(loc)
+		}
+		for tries := 0; tries < 30 && !clean(); tries++ {
+			tt = genInstant(ht, loc)
+			c = dateOf(tt)
+			mon, sun = c.isoMonday(), c.nextSunday()
+		}
+		if !clean() {
+			loc = time.UTC
+			tt = tt.In(loc)
+			c = dateOf(tt)
+			mon, sun = c.isoMonday(), c.nextSunday()
+		}
+		note(ht, "Monday/Sunday of %s", fmtT(tt))
+		nw := now.With(tt)
+		if got := nw.Monday(); !got.Equal(mon.midnight(loc)) {
+			fail(ht, "Monday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(mon.midnight(loc)))
+		}
+		if got := nw.Sunday(); !got.Equal(sun.midnight(loc)) {
+			fail(ht, "Sunday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(sun.midnight(loc)))
+		}
+		if got, want := nw.EndOfSunday(), sun.addDays(1).midnight(loc).Add(-time.Nanosecond); !got.Equal(want) {
+			fail(ht, "EndOfSunday(%s) = %s, want %s", fmtT(tt), fmtT(got), fmtT(want))
+		}
+
+		// With a time-only string: the same day shift, that clock.
+		spec := pick(ht, timeLayouts)
+		v := genParsable(ht, spec, loc)
+		text := render(ht, spec, v, 0)
+		want := expectedParse(spec, v, tt, 0)
+		wantMon := time.Date(mon.y, mon.m, mon.d, want.Hour(), want.Minute(), want.Second(), 0, loc)
+		wantSun := time.Date(sun.y, sun.m, sun.d, want.Hour(), want.Minute(), want.Second(), 0, loc)
+		if cleanAround(wantMon) {
+			if got := nw.Monday(text); !got.Equal(wantMon) {
+				fail(ht, "Monday(%q) at %s = %s, want %s", text, fmtT(tt), fmtT(got), fmtT(wantMon))
+			}
+		}
+		if cleanAround(wantSun) {
+			if got := nw.Sunday(text); !got.Equal(wantSun) {
+				fail(ht, "Sunday(%q) at %s = %s, want %s", text, fmtT(tt), fmtT(got), fmtT(wantSun))
+			}
+		}
+
+		// Between is strict on both ends.
+		dspec := pick(ht, dateTimeLayouts)
+		if dspec.zoned {
+			dspec = dateTimeLayouts[2]
+		}
+		lo := tt.Add(-time.Duration(n(ht, 0, 3600)) * time.Second).Truncate(time.Second)
+		hi := tt.Add(time.Duration(n(ht, 0, 3600)) * time.Second).Truncate(time.Second)
+		if !cleanAround(lo) || !cleanAround(hi) {
+			return
+		}
+		loText, hiText := render(ht, dspec, lo, 0), render(ht, dspec, hi, 0)
+		loT, hiT := expectedParse(dspec, lo, tt, 0), expectedParse(dspec, hi, tt, 0)
+		want2 := tt.After(loT) && tt.Before(hiT)
+		if got := nw.Between(loText, hiText); got != want2 {
+			fail(ht, "Between(%q, %q) at %s = %v, want %v", loText, hiText, fmtT(tt), got, want2)
+		}
+	})
+}
