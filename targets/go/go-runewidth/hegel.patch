+// ---- locales -------------------------------------------------------------------------------
+
+// cjkCharsets are the CJK multibyte charsets the package recognises (spelled as glibc does, in
+// any case); utf8Charsets count as CJK only with a CJK language.
+var (
+	cjkCharsets   = []string{"eucJP", "eucjp", "EUCJP", "jis", "eucKR", "euckr", "eucCN", "SJIS", "sjis", "CP932", "cp51932", "CP936", "cp949", "cp950", "Big5", "big5", "BIG5", "GBK", "gbk", "GB2312", "gb2312"}
+	utf8Charsets  = []string{"UTF-8", "utf-8", "utf8", "UTF8", "Utf-8"}
+	otherCharsets = []string{"ISO-8859-1", "iso88591", "CP1252", "KOI8-R", "ASCII", "TIS-620", "latin1"}
+	cjkLangs      = []string{"ja", "ko", "zh"}
+	otherLangs    = []string{"en", "de", "fr", "ru", "th", "vi", "ast", "kab"}
+	countries     = []string{"", "_JP", "_KR", "_CN", "_TW", "_HK", "_US", "_DE", "_GB"}
+	modifiers     = []string{"", "", "", "@euro", "@latin", "@cjk_narrow", "@CJK_NARROW", "@Cjk_Narrow"}
+)
+
+type locale struct {
+	name          string
+	cjkLang       bool
+	charset       string // "cjk", "utf8", "other"
+	narrowModifer bool
+}
+
+// genLocale draws a POSIX locale name whose CJK-ness the package documents an answer for. The
+// shapes it gets wrong (a CJK language with no charset or with a CJK charset it does not know)
+// are pinned as go-runewidth/2 and not drawn here.
+func genLocale(tc hegel.TestCase) locale {
+	var l locale
+	var lang string
+	if l.cjkLang = chance(tc, 50); l.cjkLang {
+		lang = pick(tc, cjkLangs)
+	} else {
+		lang = pick(tc, otherLangs)
+	}
+	var cs string
+	switch n(tc, 1, 3) {
+	case 1:
+		l.charset, cs = "cjk", pick(tc, cjkCharsets)
+	case 2:
+		l.charset, cs = "utf8", pick(tc, utf8Charsets)
+	default:
+		if l.cjkLang {
+			l.charset, cs = "utf8", pick(tc, utf8Charsets)
+		} else {
+			l.charset = "other"
+			if chance(tc, 70) {
+				cs = pick(tc, otherCharsets)
+			}
+		}
+	}
+	mod := pick(tc, modifiers)
+	l.narrowModifer = strings.EqualFold(mod, "@cjk_narrow")
+	l.name = lang + pick(tc, countries)
+	if cs != "" {
+		l.name += "." + cs
+	}
+	l.name += mod
+	return l
+}
+
+func (l locale) eastAsian() bool {
+	if l.narrowModifer {
+		return false
+	}
+	switch l.charset {
+	case "cjk":
+		return true
+	case "utf8":
+		return l.cjkLang
+	}
+	return false
+}
+
+var cLocales = []string{"", "C", "POSIX", "C.UTF-8", "C.utf8", "C-UTF-8", "C.ISO-8859-1"}
+
+// TestHegelIsEastAsianFollowsTheLocaleGrammar: IsEastAsian reads LC_ALL, then LC_CTYPE, then
+// LANG; the C and POSIX locales are never East Asian, a CJK charset always is, UTF-8 is with a
+// Japanese, Korean or Chinese language, and @cjk_narrow turns it off.
+func TestHegelIsEastAsianFollowsTheLocaleGrammar(t *testing.T) {
+	saved := map[string]string{}
+	for _, k := range []string{"LC_ALL", "LC_CTYPE", "LANG"} {
+		saved[k] = os.Getenv(k)
+	}
+	defer func() {
+		for k, v := range saved {
+			os.Setenv(k, v)
+		}
+	}()
+	property(t, func(ht *hegel.T) {
+		var vals [3]string
+		var want bool
+		effective := -1
+		for i := range vals {
+			if chance(ht, 60) {
+				if chance(ht, 25) {
+					vals[i] = pick(ht, cLocales)
+				} else {
+					l := genLocale(ht)
+					vals[i] = l.name
+					if effective < 0 {
+						want = l.eastAsian()
+					}
+				}
+				if effective < 0 && vals[i] != "" {
+					effective = i
+				}
+			}
+		}
+		os.Setenv("LC_ALL", vals[0])
+		os.Setenv("LC_CTYPE", vals[1])
+		os.Setenv("LANG", vals[2])
+		if effective < 0 {
+			want = false
+		}
+		note(ht, "LC_ALL=%q LC_CTYPE=%q LANG=%q", vals[0], vals[1], vals[2])
+		if got := IsEastAsian(); got != want {
+			fail(ht, "IsEastAsian() with LC_ALL=%q LC_CTYPE=%q LANG=%q = %v, want %v", vals[0], vals[1], vals[2], got, want)
+		}
+	})
+}
+
+// ---- pins ----------------------------------------------------------------------------------
+
+// TestHegelPinWrapASCIIAgreesWithTheSegmenterOnCRLF pins go-runewidth/1: at a non-positive
+// width the ASCII fast path of Wrap breaks before a CRLF, which the segmenter path treats as a
+// line ending and never breaks before.
+func TestHegelPinWrapASCIIAgreesWithTheSegmenterOnCRLF(t *testing.T) {
+	defer guard(t)
+	c := &Condition{}
+	for _, w := range []int{0, -1} {
+		ascii := c.Wrap("a\r\nb", w)
+		wide := c.Wrap("あ\r\nb", w)
+		want := modelWrap(c, "a\r\nb", w)
+		if ascii != want {
+			t.Errorf("Wrap(%q, %d) = %q, want %q as the cluster loop gives (Wrap(%q, %d) = %q)", "a\r\nb", w, ascii, want, "あ\r\nb", w, wide)
+		}
+	}
+}
+
+// TestHegelPinIsEastAsianKnowsTheCommonCJKLocales pins go-runewidth/2: CJK locales whose charset
+// is missing or spelled outside the package's short list are reported as not East Asian.
+func TestHegelPinIsEastAsianKnowsTheCommonCJKLocales(t *testing.T) {
+	defer guard(t)
+	saved := os.Getenv("LC_ALL")
+	defer os.Setenv("LC_ALL", saved)
+	for _, l := range []string{"ja_JP", "zh_CN", "ko_KR", "ja_JP.EUC-JP", "ko_KR.EUC-KR", "zh_CN.GB18030", "zh_CN.gb18030", "zh_HK.big5hkscs", "zh_HK.BIG5-HKSCS", "zh_TW.euctw", "zh_TW.EUC-TW", "ja_JP.SHIFT_JIS"} {
+		os.Setenv("LC_ALL", l)
+		if !IsEastAsian() {
+			t.Errorf("IsEastAsian() with LC_ALL=%q = false, want true", l)
+		}
+	}
+}
+
+// TestHegelPinSingleInvalidByteMeasuresLikeAnyOther pins go-runewidth/3: StringWidth answers a
+// one-byte string from a shortcut that ignores the locale, so in an East Asian locale a lone
+// byte that is not UTF-8 is one cell while the same byte inside longer text is two.
+func TestHegelPinSingleInvalidByteMeasuresLikeAnyOther(t *testing.T) {
+	defer guard(t)
+	c := &Condition{EastAsianWidth: true, StrictEmojiNeutral: true}
+	for _, b := range []string{"\x80", "\xff", "\xc3"} {
+		single := c.StringWidth(b)
+		double := c.StringWidth(b + b)
+		if single*2 != double {
+			t.Errorf("StringWidth(%q) East Asian = %d but StringWidth(%q) = %d (U+FFFD is %d cells)", b, single, b+b, double, c.RuneWidth(utf8.RuneError))
+		}
+	}
+}
+
+// TestHegelPinTwoCellExtendRuneKeepsItsBaseVisible pins go-runewidth/4: a skin tone modifier
+// (a two-cell rune of grapheme class Extend) joins the preceding space or letter into one
+// cluster, as a space joins preceding Prepend runes, and the two-cell cap then counts the
+// whole as two cells, so FillLeft/FillRight cannot reach the requested width and a padded
+// column is one cell short.
+func TestHegelPinTwoCellExtendRuneKeepsItsBaseVisible(t *testing.T) {
+	defer guard(t)
+	c := &Condition{}
+	for _, s := range []string{" 🏼", "a🏼", " 🏿", "࢐؁ "} {
+		if got := c.StringWidth(s); got != 3 {
+			t.Errorf("StringWidth(%q) = %d, want 3", s, got)
+		}
+	}
+	if got := c.StringWidth(c.FillLeft("🏼", 4)); got != 4 {
+		t.Errorf("StringWidth(FillLeft(%q, 4)) = %d, want 4 (FillLeft gave %q)", "🏼", got, c.FillLeft("🏼", 4))
+	}
+	if got := c.StringWidth(c.FillRight("࢐؁", 4)); got != 4 {
+		t.Errorf("StringWidth(FillRight(%q, 4)) = %d, want 4 (FillRight gave %q)", "࢐؁", got, c.FillRight("࢐؁", 4))
+	}
+}
+
+// TestHegelPinIncompleteSequenceAtTheEndIsMeasured pins go-runewidth/5: an incomplete UTF-8
+// sequence at the end of the text is attached to the preceding cluster by the segmenter and
+// vanishes under the two-cell cap, while the same bytes followed by anything else count as
+// one cell each.
+func TestHegelPinIncompleteSequenceAtTheEndIsMeasured(t *testing.T) {
+	defer guard(t)
+	c := &Condition{}
+	for _, tt := range []struct{ s, tail string }{{"あ", "\xe3\x81"}, {"a", "\xf0\x98\xb7"}, {"あ", "\xc3"}} {
+		alone := c.StringWidth(tt.tail)
+		atEnd := c.StringWidth(tt.s + tt.tail)
+		followed := c.StringWidth(tt.s + tt.tail + " ")
+		if atEnd != c.StringWidth(tt.s)+alone || followed != atEnd+1 {
+			t.Errorf("StringWidth(%q) = %d, StringWidth(%q) = %d, StringWidth(%q) = %d: the incomplete sequence is %d cells on its own", tt.s+tt.tail, atEnd, tt.s+tt.tail+" ", followed, tt.tail, alone, alone)
+		}
+	}
+	if got := c.Truncate("あ\xe3\x81", 2, ""); got != "あ" {
+		t.Errorf("Truncate(%q, 2, \"\") = %q, want %q", "あ\xe3\x81", got, "あ")
+	}
+}
+
+// ---- fixed examples ------------------------------------------------------------------------
+
+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	c := &Condition{}
+	ea := &Condition{EastAsianWidth: true, StrictEmojiNeutral: true}
+	for _, tt := range []struct {
+		s         string
+		w, eaw    int
+		truncated string
+	}{
+		{"つのだ☆HIRO", 11, 12, "つの…"},
+		{"■㈱の世界①", 10, 12, "■㈱の…"},
+		{"👨‍👩‍👧‍👦", 2, 2, "👨‍👩‍👧‍👦"},
+		{"🇩🇰🇯🇵", 4, 4, "🇩🇰🇯🇵"},
+		{"हिन्दी", 5, 5, "हिन्दी"},
+		{"abc\r\ndef", 6, 6, "abc\r\ndef"},
+		{"abc\r\ndefg", 7, 7, "abc\r\nde…"},
+	} {
+		if got := c.StringWidth(tt.s); got != tt.w {
+			t.Errorf("StringWidth(%q) = %d, want %d", tt.s, got, tt.w)
+		}
+		if got := ea.StringWidth(tt.s); got != tt.eaw {
+			t.Errorf("StringWidth(%q) East Asian = %d, want %d", tt.s, got, tt.eaw)
+		}
