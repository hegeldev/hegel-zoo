diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..3d2c699
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,73 @@
+package goja_test
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// compare judges goja's result against the reference engine's for one
+// program: both compile, run and return the same value, or both fail at the
+// same stage (compiling, or running) with the same kind of error. Error
+// messages are not compared (the serialiser keeps an error's name only);
+// any other thrown value must be the same.
+func compare(ht *hegel.T, src string, g, r jsResult) {
+	if r.Status == "timeout" {
+		fail(ht, "node does not finish (the generator must bound every loop)\nprogram:\n%s\ngoja: %s %s", src, g.Status, cut(g.Payload))
+	}
+	switch g.Status {
+	case "panic":
+		fail(ht, "goja panics\nprogram:\n%s\n%s", src, g.Payload)
+	case "timeout":
+		fail(ht, "goja does not finish\nprogram:\n%s\nnode: %s %s", src, r.Status, cut(r.Payload))
+	}
+	if g.Status != r.Status {
+		fail(ht, "goja %s, node %s\nprogram:\n%s\ngoja: %s\nnode: %s", g.Status, r.Status, src, cut(g.Payload), cut(r.Payload))
+	}
+	if g.Payload != r.Payload {
+		fail(ht, "%s differ\nprogram:\n%s\ngoja: %s\nnode: %s", map[string]string{"ok": "results", "throw": "thrown values", "compile": "compile errors"}[g.Status], src, cut(g.Payload), cut(r.Payload))
+	}
+}
+
+func cut(s string) string {
+	if len(s) > 600 {
+		return s[:600] + "..."
+	}
+	return s
+}
+
+// TestHegelRunAgreesWithNode: a generated program (literals of every kind,
+// variables, assignments, the control statements, closures, arrays and
+// objects, classes, the operators with their precedence and coercions,
+// exceptions, the built-in objects' methods) returns the same value in goja
+// and in node, or fails in both at the same stage with the same kind of
+// error; the probes (fixed programs over the language's and the built-ins'
+// corners) likewise.
+func TestHegelRunAgreesWithNode(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 3)
+		for i := 0; i < k; i++ {
+			g := newGen(ht)
+			var src string
+			if chance(ht, 20) {
+				src = g.wrong()
+			} else {
+				src = g.program()
+			}
+			note(ht, "program:\n%s", src)
+			gr := gojaRun(src)
+			nr := nodeRun(ht, src)
+			compare(ht, src, gr, nr)
+		}
+	})
+}
+
+// TestHegelProbesAgreeWithNode: the fixed probe programs, one property case
+// each so that a failing probe is reported on its own.
+func TestHegelProbesAgreeWithNode(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := pick(ht, probes...)
+		note(ht, "program:\n%s", src)
+		compare(ht, src, gojaRun(src), nodeRun(ht, src))
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..850c8b1
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,200 @@
+package goja_test
+
+// Generated JavaScript programs run by goja and by the reference engine
+// (node, as a child process) must agree: the same programs compile, run
+// and return the same values, or fail at the same stage with the same kind
+// of error.
+//
+// Needs node on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	curT          testing.TB // the running property test, for the first-failure log
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 400 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	// A case is a batch of programs through the oracle: large and slow by
+	// hegel's defaults.
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	// Logged as it happens: the report hegel prints after shrinking lists
+	// every draw first, and a CI log excerpt may cut it off before the
+	// message.
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Known bugs (see bugs.toml). Each gate keeps the generator away from a
+// shape that is known to differ from the reference engine while the bug is
+// open; the pins in hegel_pins_test.go fail while it is.
+
+var Known = struct {
+	arrowArguments           bool // arguments inside an arrow function inside a function is undefined, or a Go panic (index out of range), instead of the enclosing function's arguments
+	strictOctalEscape        bool // legacy octal escapes ('\1', '\101', '\08', '\8') are accepted in strict mode code
+	parseIntNegZero          bool // parseInt('-0') is +0, not -0
+	isoExtendedYear          bool // toISOString/toJSON print a year outside 0..9999 with as few digits as it has (+10000, -0001) instead of six
+	regexLineTerminators     bool // in a regexp, . matches U+2028/U+2029 and ^/$ with the m flag do not see \r, U+2028 or U+2029 as line terminators
+	loneSurrogateCase        bool // toUpperCase, toLowerCase and normalize turn a lone surrogate into U+FFFD
+	toInt32Large             bool // ToInt32/ToUint32 of a number of magnitude 2^63 or more give 0 (1e21 | 0, ~1e21, 1e21 >>> 0, Math.imul, Math.clz32) instead of the value modulo 2^32
+	labelledFunction         bool // a labelled function declaration (L: function f() {}) is a SyntaxError in sloppy mode
+	unicodeRegexpSyntax      bool // with the u flag, invalid patterns are accepted (identity escapes such as \-, incomplete escapes, a backreference to a missing group, a lone ] or a{, a class range with a class escape, a quantified lookahead, an unknown property name)
+	duplicateGroupNames      bool // a regexp with two groups of the same name in one alternative ((?<a>x)(?<a>y)) is accepted
+	quantifiedLookbehind     bool // a quantified lookbehind ((?<=a)+) is accepted (no generator shape: quantifiers never follow an assertion)
+	jsonNumberRange          bool // JSON.parse of a number beyond the double range (1e400) throws a SyntaxError instead of giving Infinity
+	deleteNew                bool // delete new X() throws a TypeError instead of giving true
+	mulNegZero               bool // a product of integer-valued numbers that should be -0 is +0 (-5 * 0, 0 * -5, x *= -5)
+	unicodeProperty          bool // a \p{...} or \P{...} property escape with the u flag never matches
+	globalEmptyMatch         bool // match and replace with a g regexp drop an empty match right after a non-empty one ('ab'.match(/a|/g) lacks one "")
+	execKeyOrder             bool // a match result's own keys come as input, index, groups instead of index, input, groups
