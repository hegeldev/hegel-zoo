+		flags = pick(g.ht, "u", "u", "gu", "iu")
+	}
+	if Known.asciiCaseFold && strings.Contains(flags, "i") && !strings.Contains(flags, "u") {
+		flags += "u" // goja/22: case-insensitive only with Unicode case folding
+	}
