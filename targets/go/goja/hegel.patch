+}
+
+func (g *gen) labeled(d int) string {
+	lbl := g.fresh("L")
+	g.labels = append(g.labels, lbl)
+	defer func() { g.labels = g.labels[:len(g.labels)-1] }()
+	return lbl + ": " + g.loop(d)
+}
+
+func (g *gen) generatorStmt(d int) string {
+	res := g.fresh("v")
+	saved := g.vars
+	a, b := g.expr(kAny, d-1).s, g.expr(kAny, d-1).s
+	g.vars = saved
+	g.vars = append(g.vars, variable{name: res, k: kAny})
+	switch n(g.ht, 1, 5) {
+	case 1:
+		return fmt.Sprintf("const %s = (() => { function* gen() { const x = yield %s; yield x; return %s; } const it = gen(); return [it.next(1), it.next(2), it.next(3), it.next(4)]; })();", res, a, b)
+	case 2:
+		return fmt.Sprintf("const %s = [...(function* () { yield* [%s, %s]; yield* '%s'; })()];", res, a, b, pick(g.ht, "ab", "", "\\u00e9"))
+	case 3:
+		return fmt.Sprintf("const %s = (() => { const it = [%s, %s][Symbol.iterator](); return [it.next(), it.next(), it.next(), typeof it[Symbol.iterator]]; })();", res, a, b)
+	case 4:
+		return fmt.Sprintf("const %s = (() => { const o = {*[Symbol.iterator]() { yield %s; yield %s; }}; return [Array.from(o), [...o].length, Math.max(...o.length === undefined ? [1] : [2])]; })();", res, a, b)
+	default:
+		return fmt.Sprintf("const %s = (() => { function* g() { try { yield %s; yield 2; } finally { return %s; } } const it = g(); return [it.next(), it.return(9), it.next()]; })();", res, a, b)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Programs.
+
+// program is a function body: statements, then a return of the visible
+// values.
+func (g *gen) program() string {
+	k := n(g.ht, 0, 7)
+	var lines []string
+	if chance(g.ht, 20) {
+		lines = append(lines, "'use strict';")
+	}
+	for i := 0; i < k && g.tick(); i++ {
+		if s := g.stmt(2); s != "" {
+			lines = append(lines, s)
+		}
+	}
+	vs := g.visible(kAny)
+	var rets []string
+	for _, v := range vs {
+		rets = append(rets, v.name)
+	}
+	if len(rets) > 8 {
+		rets = rets[len(rets)-8:]
+	}
+	ret := "return [" + strings.Join(rets, ", ") + "];"
+	if chance(g.ht, 25) {
+		ret = "return " + g.expr(kAny, 2).s + ";"
+	}
+	lines = append(lines, ret)
+	return strings.Join(lines, "\n")
+}
+
+// wrong is a program that is probably invalid: a valid one with a token
+// removed, inserted or swapped, or a program built around an early error.
+// Both engines must reject it, or both accept it and agree on the result.
+func (g *gen) wrong() string {
+	if chance(g.ht, 50) {
+		return g.earlyError()
+	}
+	src := g.program()
+	m := g.mutate(src)
+	if Known.strictOctalEscape && strings.Contains(m, "'use strict'") && octalEscape.MatchString(m) {
+		return src // goja/2: a mutation may turn \u212B into \212B
+	}
+	if Known.letNewline && letAtLineEnd.MatchString(m) {
+		return src // goja/30: let (or await, yield) at the end of a line is a SyntaxError instead of an identifier
+	}
+	for _, h := range forHeader.FindAllStringSubmatch(m, -1) {
+		if !strings.Contains(h[2], h[1]) {
+			return src // the mutation took the loop variable out of the bound: an endless loop in both engines
+		}
+	}
+	if Known.unicodeRegexpSyntax && !subset(uRegexp.FindAllString(m, -1), uRegexp.FindAllString(src, -1)) {
+		return src // goja/9: a mutated pattern under the u flag may be one only node rejects
+	}
+	if Known.catchAssignmentInFinally && commentedDecl.MatchString(m) {
+		return src // goja/38: a declaration commented out leaves the catch block assigning an undeclared name the finally block then reads
+	}
+	if callTarget.MatchString(m) {
+		// a call as the target of ++, -- or an assignment: an early SyntaxError
+		// in goja, a runtime ReferenceError in node (Annex B, Runtime Errors for
+		// Function Call Assignment Targets), not judged
+		return src
+	}
+	if Known.unterminatedClass {
+		// goja/18: no line with a [ left open after a /
+		for _, line := range strings.Split(m, "\n") {
+			if strings.Contains(line, "/") && strings.Count(line, "[") > strings.Count(line, "]") {
+				return src
+			}
+		}
+	}
+	return m
+}
+
+var octalEscape = regexp.MustCompile(`\\[0-9]`)
+var letAtLineEnd = regexp.MustCompile(`\b(let|await|yield)[ \t]*\n`)
+var bigintLit = regexp.MustCompile(`\b\d+n\b|BigInt`)
+var commentedDecl = regexp.MustCompile(`//\s*(let|const|var)\b`)
+var forHeader = regexp.MustCompile(`for \((?:let|var|const) (\w+) = [^;]*; ([^;]*);`)
+var uRegexp = regexp.MustCompile(`/(?:[^/\n\\]|\\.)+/[a-z]*u[a-z]*`)
+
+// subset reports whether every string of xs is in ys.
+func subset(xs, ys []string) bool {
+	for _, x := range xs {
+		found := false
+		for _, y := range ys {
+			if x == y {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+// callTarget matches ++/-- before an array, call, string or parenthesised
+// operand, and ++/--/an assignment operator right after a closing parenthesis.
+var callTarget = regexp.MustCompile("(\\+\\+|--)\\s*(\\[|\\(|['\"`]|[\\w$.]+\\()|\\)\\s*(\\+\\+|--|[-+*/%&|^]?=[^=>])")
+
+// mutate applies one small change to src.
+func (g *gen) mutate(src string) string {
+	switch n(g.ht, 1, 6) {
+	case 1:
+		// drop a character
+		if len(src) > 1 {
+			i := n(g.ht, 0, len(src)-1)
+			return src[:i] + src[i+1:]
+		}
+	case 2:
+		// insert a token
+		i := n(g.ht, 0, len(src))
+		return src[:i] + pick(g.ht, ")", "(", "{", "}", "[", "]", ";", ",", "=", "==", "+", "return ", "let ", "const ", "'", "\"", "`", "${", "/", "*/", "/*", "//", "\n", "...", "=>", "?", ":", "else ", "case 1:", "\\", "0", "x", "await ", "yield ", "new ", "typeof ", "in ", "of ", "async ", "#", "@", "\\u0041", "\u00a0", "\u2028", "\ufeff") + src[i:]
+	case 3:
+		// swap two characters
+		if len(src) > 2 {
+			i := n(g.ht, 0, len(src)-2)
+			return src[:i] + src[i+1:i+2] + src[i:i+1] + src[i+2:]
+		}
+	case 4:
+		// duplicate a line
+		lines := strings.Split(src, "\n")
+		i := n(g.ht, 0, len(lines)-1)
+		lines = append(lines[:i+1], lines[i:]...)
+		return strings.Join(lines, "\n")
+	case 5:
+		// replace a keyword
+		for _, kw := range []string{"let ", "const ", "function ", "return ", "class ", "for ", "if ", "else ", "try ", "catch ", "while ", "switch ", "case "} {
+			if strings.Contains(src, kw) {
+				return strings.Replace(src, kw, pick(g.ht, "let ", "const ", "var ", "function ", "return ", "class ", "for ", "if ", "else ", "try ", "catch ", "while ", "switch ", "case ", "yield ", "await ", "async ", "static ", "enum ", "import ", "export ", "with ", "debugger ", "", "let\n", "new.target ", "super ", "arguments "), 1)
+			}
+		}
+	}
+	return src
+}
+
+// earlyError picks a program from earlyErrors, avoiding the open bugs.
+func (g *gen) earlyError() string {
+	for {
+		s := pick(g.ht, earlyErrors...)
+		switch {
+		case Known.arrowArguments && strings.Contains(s, "(() => arguments"):
+		case Known.labelledFunction && strings.HasPrefix(s, "L: function f() {} return"):
+		case Known.unicodeRegexpSyntax && strings.Contains(s, "/u") && (strings.Contains(s, "\\-") || strings.Contains(s, "\\1") || strings.Contains(s, "[\\d-z]") || strings.Contains(s, "a{,2}") || strings.Contains(s, "]/u") || strings.Contains(s, "}/u") || strings.Contains(s, "(?=a)+") || strings.Contains(s, "\\k<a>/u") || strings.Contains(s, "Bogus")):
+		case Known.duplicateGroupNames && strings.Contains(s, "(?<a>x)(?<a>y)"):
+		case Known.quantifiedLookbehind && strings.Contains(s, "(?<=a)+"):
+		case Known.jsonNumberRange && strings.Contains(s, "1e400"):
+		case Known.unicodeProperty && strings.Contains(s, "\\p{L}/u"):
+		case Known.execKeyOrder && strings.Contains(s, ".exec('a');"):
+		case Known.unterminatedClass && strings.Contains(s, "/[/"):
+		case Known.restParamUseStrict && strings.Contains(s, "(...a) { 'use strict'; }"):
+		case Known.codePointEscapePanic && strings.Contains(s, "u{10FFFF}'"):
+		case Known.codePointEscapePanic && strings.Contains(s, "u{10FFFF}`"):
+		case Known.strictOctalEscape && strings.Contains(s, "'use strict'") && (strings.Contains(s, "'\\1'") || strings.Contains(s, "'\\08'")):
+		default:
+			return s
+		}
+	}
+}
