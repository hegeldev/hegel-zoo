+// The reference engine (node) as a child process running a small driver:
+// one program per request (a line with the byte length, then the bytes),
+// one reply per program (a status line - ok, compile, throw or timeout -
+// then a line with the byte length of the payload and the payload). Each
+// program is the body of a function run in a fresh context; the payload is
+// the value it returns (or throws), serialised by serSrc, a piece of plain
+// ES5 that both engines run in the same fresh context before the program:
+//
+//	undefined, null, true, false; numbers by Number.prototype.toString
+//	(spec-exact), with -0 kept; strings quoted with every code unit outside
+//	printable ASCII escaped as \uXXXX; arrays as [a,b,<hole>] plus their
+//	other own enumerable keys; objects as {"k":v,...} in own-key order
+//	(spec-defined); errors by name only (messages are the engine's own);
+//	dates by their time value; regexps by source, flags and lastIndex;
+//	maps and sets by contents in insertion order; wrapper objects by tag
+//	and value; functions by their length; <cycle> and <deep> for the rest.
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"runtime/debug"
+	"strconv"
+	"strings"
