+	k := n(g.ht, 1, 4)
+	var b strings.Builder
+	mayEmpty := true
+	for i := 0; i < k; i++ {
+		a := pick(g.ht, atoms...)
+		if !emptyAtoms[a] {
+			mayEmpty = false
+		}
+		b.WriteString(a)
+	}
+	g.lastReEmpty = mayEmpty || strings.Contains(b.String(), "|") // an alternative may match the empty string
+	// the d (hasIndices) and v (unicodeSets) flags are features goja does not have
+	flagSets := []string{"", "", "", "g", "i", "gi", "m", "s", "u", "y", "gu", "iu", "gm", "gy", "ig", "us"}
+	src := b.String()
+	flags := pick(g.ht, flagSets...)
