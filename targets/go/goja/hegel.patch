@@ -0,0 +1,1978 @@
+package goja_test
+
+// A generator of JavaScript programs: the body of a function, built from
+// typed expressions (numbers, strings, booleans, arrays, objects, anything)
+// and statements over a scope of variables, ending in a return of the
+// visible values. Everything it produces is deterministic, bounded (every
+// loop has a fixed or guarded count, recursion is not generated, strings and
+// arrays stay small) and stays away from behaviour the specification leaves
+// to the implementation (Math's transcendental functions and ** beyond small
+// integers, toString of a fraction with a radix, locale-sensitive methods,
+// Function.prototype.toString, error messages, promise job timing, Date
+// parsing of non-ISO strings, local time).
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+type kind int
+
+const (
+	kAny kind = iota
+	kNum
+	kStr
+	kBool
+	kArr
+	kObj
+	kFunc
+)
+
+// Precedences (higher binds tighter).
+const (
+	commaPrec  = 1
+	assignPrec = 2
+	condPrec   = 3
+	nullPrec   = 4
+	orPrec     = 5
+	andPrec    = 6
+	bitOrPrec  = 7
+	bitXorPrec = 8
+	bitAndPrec = 9
+	eqPrec     = 10
+	relPrec    = 11
+	shiftPrec  = 12
+	addPrec    = 13
+	mulPrec    = 14
+	expPrec    = 15
+	unaryPrec  = 16
+	postPrec   = 17
+	callPrec   = 18
+	atomPrec   = 19
+)
+
+type ex struct {
+	s    string
+	prec int
+}
+
+func atom(s string) ex { return ex{s, atomPrec} }
+
+type variable struct {
+	name  string
+	k     kind
+	elem  kind // for arrays: the element kind (kAny if mixed)
+	seq   bool // an array without holes whose length is known to both engines
+	konst bool // declared with const: not assignable
+}
+
+type gen struct {
+	ht      *hegel.T
+	vars    []variable
+	depth   int
+	budget  int
+	counter int
+	loops   int // enclosing loops (break/continue allowed)
+	funcs   int // enclosing generated functions (return allowed)
+	labels  []string
+
+	lastReEmpty bool // the last regexLit can match the empty string
+}
+
+func newGen(ht *hegel.T) *gen { return &gen{ht: ht, budget: 60} }
+
+func (g *gen) tick() bool {
+	g.budget--
+	return g.budget > 0
+}
+
+func (g *gen) fresh(prefix string) string {
+	g.counter++
+	return fmt.Sprintf("%s%d", prefix, g.counter)
+}
+
+func (g *gen) visible(k kind) []variable {
+	var out []variable
+	for _, v := range g.vars {
+		if k == kAny || v.k == k {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+func (g *gen) paren(x ex) ex {
+	if x.prec >= atomPrec {
+		return x
+	}
+	return atom("(" + x.s + ")")
+}
+
+// operand parenthesises x when it binds looser than an operator of prec on
+// the side it is on.
+func (g *gen) operand(x ex, prec int, strict bool) string {
+	if x.prec < prec || (strict && x.prec == prec) {
+		return "(" + x.s + ")"
+	}
+	return x.s
+}
+
+func (g *gen) binary(op string, l, r ex, prec int, rightAssoc bool) ex {
+	ls := g.operand(l, prec, rightAssoc)
+	rs := g.operand(r, prec, !rightAssoc)
+	if op == "**" && l.prec == unaryPrec {
+		ls = "(" + l.s + ")" // a unary operand of ** must be parenthesised
+	}
+	if Known.relationalChain && prec == relPrec && l.prec == relPrec {
+		ls = "(" + l.s + ")" // goja/21: no relational chains
+	}
+	return ex{ls + " " + op + " " + rs, prec}
+}
+
+func (g *gen) unary(op string, x ex) ex {
+	s := g.operand(x, unaryPrec, false)
+	if strings.HasPrefix(s, op[len(op)-1:]) && (op == "-" || op == "+") {
+		s = " " + s // - -x, not --x
+	}
+	return ex{op + s, unaryPrec}
+}
+
+func (g *gen) call(fn string, args ...string) ex {
+	return ex{fn + "(" + strings.Join(args, ", ") + ")", callPrec}
+}
+
+func (g *gen) member(x ex, name string) ex {
+	s := g.operand(x, callPrec, false)
+	if x.prec == atomPrec && isNumLit(x.s) {
+		s = "(" + x.s + ")" // 1.toFixed is a syntax error
+	}
+	return ex{s + "." + name, callPrec}
+}
+
+func isNumLit(s string) bool {
+	if s == "" {
+		return false
+	}
+	c := s[0]
+	return c >= '0' && c <= '9' || c == '.'
+}
+
+// ---------------------------------------------------------------------------
+// Literals.
+
+func (g *gen) numLit() string {
+	switch n(g.ht, 1, 14) {
+	case 1, 2, 3:
+		return fmt.Sprint(n(g.ht, 0, 12))
+	case 4:
+		return fmt.Sprint(n(g.ht, 0, 1000000))
+	case 5:
+		return pick(g.ht, "0.5", "1.5", "0.1", "0.2", "0.3", "2.25", "1e3", "1e21", "1e-7", "123.456", "5e-324", "1.7976931348623157e308", ".5", "5.", "0.000001", "1e300")
+	case 6:
+		return pick(g.ht, "0x1F", "0xff", "0b101", "0o17", "0X10", "0B11", "0O7", "0xFFFFFFFF", "0x20000000000000")
+	case 7:
+		return pick(g.ht, "NaN", "Infinity", "-Infinity", "-0", "Number.MAX_SAFE_INTEGER", "Number.EPSILON", "Number.MIN_VALUE", "Number.MAX_VALUE", "2147483647", "2147483648", "4294967295", "4294967296", "9007199254740993")
+	case 8:
+		return pick(g.ht, "1_000", "0x1_0", "1_0.5_0", "1e1_0")
+	default:
+		return fmt.Sprint(n(g.ht, -20, 20))
+	}
+}
+
+var strAtoms = []string{"", "a", "b", "abc", "Hello", "hello world", " x ", "1", "12", "-3", "0x10", "1e2", " 42 ", "3.5", "true", "null", "undefined", "NaN", "Infinity", "a,b,c", "A-B", "aaa", "\\n", "\\t", "\\\\", "\\u00e9", "\\u00C9", "caf\\u00e9", "\\u{1F600}", "\\uD83D\\uDE00", "\\u0130", "\\u00df", "\\u03a3\\u03c2", "\\x41", "\\0", "\\u2028", "\\uFEFF", "%", "$1", "$&", "$$", "\\u0000", "\\u00A0", "\\r\\n", "[a]", "(x)", "a.b", "a*b", "\\u0041\\u030A", "\\u00C5", "\\u212B"}
+
+// strAtom is the body of a string literal.
+func (g *gen) strAtom() string {
+	s := pick(g.ht, strAtoms...)
+	if Known.regexLineTerminators && (strings.Contains(s, "\\u2028") || strings.Contains(s, "\\r")) {
+		s = "\\n" // U+2028 and \r are not line terminators for goja's regexps: goja/5
+	}
+	if Known.nbspToNumber && (strings.Contains(s, "\\u00A0") || strings.Contains(s, "\\uFEFF")) {
+		s = " " // goja/24: no non-ASCII white space in strings
+	}
+	return s
+}
+
+func (g *gen) strLit() string {
+	switch n(g.ht, 1, 10) {
+	case 1, 2, 3, 4, 5:
+		return "'" + g.strAtom() + "'"
+	case 6, 7:
+		return "\"" + g.strAtom() + "\""
+	case 8:
+		return "`" + strings.ReplaceAll(g.strAtom(), "$", "$$") + "`"
+	case 9:
+		a, b := g.strAtom(), g.strAtom()
+		if Known.strictOctalEscape && strings.HasSuffix(a, "\\0") && b != "" && b[0] >= '0' && b[0] <= '9' {
+			a = strings.TrimSuffix(a, "\\0") + "\\x00" // \0 followed by a digit is a legacy octal escape: goja/2
+		}
+		return "'" + a + b + "'"
+	default:
+		octal := "'\\101\\102'"
+		if Known.strictOctalEscape {
+			octal = "'\\x41\\x42'" // a legacy octal escape under 'use strict': goja/2
+		}
+		return pick(g.ht, "'it\\'s'", "\"say \\\"hi\\\"\"", "'line1\\\nline2'", octal, "'\\a\\c'", "`back\\`tick`", "'\\u{41}\\u{1f600}'", "'\\v\\f\\b'")
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Expressions.
+
+func (g *gen) expr(k kind, d int) ex {
+	if !g.tick() {
+		d = 0
+	}
+	switch k {
+	case kNum:
+		return g.numExpr(d)
+	case kStr:
+		return g.strExpr(d)
+	case kBool:
+		return g.boolExpr(d)
+	case kArr:
+		return g.arrExpr(d)
+	case kObj:
+		return g.objExpr(d)
+	case kFunc:
+		return g.funcExpr(d)
+	}
+	return g.anyExpr(d)
+}
+
+func (g *gen) varOf(k kind) (ex, bool) {
+	vs := g.visible(k)
+	if len(vs) == 0 || !chance(g.ht, 60) {
+		return ex{}, false
+	}
+	return atom(pick(g.ht, vs...).name), true
+}
+
+func (g *gen) anyExpr(d int) ex {
+	switch n(g.ht, 1, 16) {
+	case 1, 2, 3:
+		return g.numExpr(d)
+	case 4, 5, 6:
+		return g.strExpr(d)
+	case 7, 8:
+		return g.boolExpr(d)
+	case 9, 10:
+		return g.arrExpr(d)
+	case 11, 12:
+		return g.objExpr(d)
+	case 13:
+		return atom(pick(g.ht, "undefined", "null", "void 0", "Symbol.iterator", "Symbol('s')", "10n", "-5n", "0n", "/a+/g", "new RegExp('b', 'i')", "new Map()", "new Set([1, 2, 2])", "new Map([[1, 'a'], ['1', 'b']])", "new Set(['x', 'x'])", "new Number(3)", "new String('s')", "new Boolean(false)", "Object(1n)", "new Error('e')", "new RangeError('r')", "[].values()", "new Date(NaN)")) // no valid dates: Date.prototype.toString spells the time zone the engine's way
+	case 14:
+		return g.funcExpr(d)
+	case 15:
+		if d <= 0 {
+			return atom("undefined")
+		}
+		c := g.expr(kBool, d-1)
+		a := g.expr(kAny, d-1)
+		b := g.expr(kAny, d-1)
+		return ex{g.operand(c, condPrec, true) + " ? " + g.operand(a, assignPrec, false) + " : " + g.operand(b, assignPrec, false), condPrec}
+	default:
+		if v, ok := g.varOf(kAny); ok {
+			return v
+		}
+		return atom("undefined")
+	}
+}
+
+func (g *gen) numExpr(d int) ex {
+	if v, ok := g.varOf(kNum); ok && chance(g.ht, 50) {
+		return v
+	}
+	if d <= 0 {
+		return atom(g.numLit())
+	}
+	switch n(g.ht, 1, 22) {
+	case 1, 2:
+		return atom(g.numLit())
+	case 3, 4, 5:
+		op := pick(g.ht, "+", "-", "*", "/", "%", "+", "-", "*")
+		x := g.binary(op, g.expr(kNum, d-1), g.expr(kNum, d-1), map[string]int{"+": addPrec, "-": addPrec, "*": mulPrec, "/": mulPrec, "%": mulPrec}[op], false)
+		if op == "*" && Known.mulNegZero {
+			x = g.binary("+", x, atom("0"), addPrec, false) // the sign of a zero product: goja/14
+		}
+		return x
+	case 6:
+		// ** is implementation-approximated beyond small integers: keep it exact
+		return g.binary("**", atom(pick(g.ht, "2", "3", "-2", "10", "0", "1", "0.5", "4")), atom(pick(g.ht, "2", "3", "0", "1", "10", "-1", "-2")), expPrec, true)
+	case 7:
+		op := pick(g.ht, "|", "&", "^", "<<", ">>", ">>>")
+		return g.binary(op, g.i32(g.expr(kNum, d-1)), g.i32(g.expr(kNum, d-1)), map[string]int{"|": bitOrPrec, "&": bitAndPrec, "^": bitXorPrec, "<<": shiftPrec, ">>": shiftPrec, ">>>": shiftPrec}[op], false)
+	case 8:
+		op := pick(g.ht, "-", "+", "~", "-", "+")
+		x := g.expr(pick(g.ht, kNum, kNum, kStr, kBool, kAny), d-1)
+		if op == "~" {
+			x = g.i32(x)
+		}
+		return g.unary(op, x)
+	case 9:
+		f := pick(g.ht, "Math.floor", "Math.ceil", "Math.round", "Math.trunc", "Math.abs", "Math.sign", "Math.sqrt", "Math.fround", "Math.clz32", "Math.max", "Math.min", "Math.hypot", "Math.cbrt")
+		switch f {
+		case "Math.max", "Math.min", "Math.hypot":
+			k := n(g.ht, 0, 3)
+			args := make([]string, k)
+			for i := range args {
+				args[i] = g.expr(kNum, d-1).s
+			}
+			if f == "Math.hypot" {
+				args = []string{pick(g.ht, "3", "0", "-4", "5", "Infinity", "NaN"), pick(g.ht, "4", "0", "12", "-0")} // exact cases
+			}
+			return g.call(f, args...)
+		case "Math.sqrt":
+			return g.call(f, pick(g.ht, "4", "2", "0", "-1", "-0", "0.25", "1e10", "NaN", "Infinity", "144", g.expr(kNum, d-1).s))
+		case "Math.cbrt":
+			return g.call(f, pick(g.ht, "27", "-8", "0", "-0", "1", "NaN", "Infinity"))
+		}
+		if f == "Math.clz32" {
+			return g.call(f, g.i32(g.expr(kNum, d-1)).s)
+		}
+		return g.call(f, g.expr(kNum, d-1).s)
+	case 10:
+		return g.call("Math.imul", g.i32(g.expr(kNum, d-1)).s, g.i32(g.expr(kNum, d-1)).s)
+	case 11:
+		f := pick(g.ht, "parseInt", "parseFloat", "Number", "Number.parseInt", "Number.parseFloat")
+		var c ex
+		if strings.HasSuffix(f, "parseInt") && chance(g.ht, 50) {
+			c = g.call(f, g.expr(kStr, d-1).s, pick(g.ht, "10", "16", "2", "36", "8", "0", "37", "1", "undefined", "'16'", "3.9"))
+		} else {
+			c = g.call(f, g.expr(pick(g.ht, kStr, kStr, kAny), d-1).s)
+		}
+		if Known.parseIntNegZero && strings.HasSuffix(f, "parseInt") {
+			return g.binary("+", c, atom("0"), addPrec, false) // -0 + 0 is 0 on both sides: goja/3
+		}
+		return c
+	case 12:
+		return g.member(g.expr(pick(g.ht, kStr, kArr), d-1), "length")
+	case 13:
+		s := g.expr(kStr, d-1)
+		m := pick(g.ht, "indexOf", "lastIndexOf", "charCodeAt", "codePointAt", "search", "localeCompare")
+		switch m {
+		case "charCodeAt", "codePointAt":
+			return g.call(g.member(s, m).s, pick(g.ht, "0", "1", "2", "-1", "100", "1.5", "undefined", g.expr(kNum, d-1).s))
+		case "search":
+			return g.call(g.member(s, m).s, g.regexLit())
+		case "localeCompare":
+			return g.call("Math.sign", g.call(g.member(s, m).s, pick(g.ht, "'a'", "'b'", "'B'", "''", "'abc'")).s) // only the sign of an ASCII comparison is portable
+		}
+		return g.call(g.member(s, m).s, g.expr(kStr, d-1).s, pick(g.ht, "", "0", "1", "-1", "100", "NaN", "undefined"))
+	case 14:
+		a := g.expr(kArr, d-1)
+		m := pick(g.ht, "indexOf", "lastIndexOf", "findIndex", "findLastIndex", "push", "unshift")
+		switch m {
+		case "findIndex", "findLastIndex":
+			return g.call(g.member(a, m).s, g.predicate(d-1))
+		case "push", "unshift":
+			return g.call(g.member(g.paren(a), m).s, g.expr(kAny, d-1).s)
+		}
+		return g.call(g.member(a, m).s, g.expr(kAny, d-1).s)
+	case 15:
+		c := g.expr(kBool, d-1)
+		return ex{g.operand(c, condPrec, true) + " ? " + g.operand(g.expr(kNum, d-1), assignPrec, false) + " : " + g.operand(g.expr(kNum, d-1), assignPrec, false), condPrec}
+	case 16:
+		if v := g.visible(kNum); len(v) > 0 {
+			x := pick(g.ht, v...)
+			if !x.konst {
+				e := ex{pick(g.ht, x.name+"++", x.name+"--", "++"+x.name, "--"+x.name, x.name+" += "+g.operand(g.expr(kNum, d-1), assignPrec, false), x.name+" *= 2", x.name+" -= 1", x.name+" |= 1", x.name+" **= 2", x.name+" >>>= 1", x.name+" %= 3"), assignPrec}
+				if Known.toInt32Large && (strings.Contains(e.s, "|=") || strings.Contains(e.s, ">>>=")) {
+					return ex{x.name + " += 1", assignPrec} // goja/7
+				}
+				return e
+			}
+		}
+		return atom(g.numLit())
+	case 17:
+		return g.call(fmt.Sprintf("(function (a, b) { return %s; })", pick(g.ht, "a + b", "a - b", "a * b + 0", "arguments.length", "a", "b", "this === undefined ? 1 : 2", "(a || 0) + (b || 0)")), g.expr(kNum, d-1).s, g.expr(kNum, d-1).s)
+	case 18:
+		return g.call(pick(g.ht, "((a, b) => a + b)", "((a, b = 5) => a * b + 0)", "((...r) => r.length)", "((a, b) => a % b)"), g.expr(kNum, d-1).s, g.expr(kNum, d-1).s)
+	case 19:
+		// dates: UTC only (local time is the machine's)
+		switch n(g.ht, 1, 5) {
+		case 1:
+			return g.call("Date.UTC", pick(g.ht, "2000", "1970", "99", "0", "2024", "-1", "275760", "1e10"), pick(g.ht, "0", "1", "11", "12", "-1", "1.5"), pick(g.ht, "1", "29", "31", "0", "32"))
+		case 2:
+			return g.call(g.member(atom("new Date("+g.expr(kNum, d-1).s+")"), pick(g.ht, "getTime", "getUTCFullYear", "getUTCMonth", "getUTCDate", "getUTCDay", "getUTCHours", "getUTCMinutes", "getUTCSeconds", "getUTCMilliseconds", "valueOf")).s)
+		case 3:
+			// only strings in the specification's format: anything else falls back to the implementation
+			return g.call("Date.parse", pick(g.ht, "'2000-01-01'", "'2000-01-01T00:00:00Z'", "'2000-01-01T00:00:00.123Z'", "'2000-01-01T12:30'", "'2000-01-01T12:30:00+01:00'", "'+010000-01-01T00:00:00Z'", "'-000001-01-01T00:00:00Z'", "'2000-01-01T24:00:00Z'", "''", "'2000'", "'2000-06'", "'2000-01-01T00:00Z'", "'+275760-09-13T00:00:00Z'", "'-271821-04-20T00:00:00Z'", "'2000-01-01T00:00:00-05:30'"))
+		case 4:
+			return g.call(g.member(atom("new Date("+g.expr(kNum, d-1).s+")"), pick(g.ht, dateSetters()...)).s, g.expr(kNum, d-1).s)
+		default:
+			return g.call("Date.UTC", pick(g.ht, "2000", "1970", "2024"), pick(g.ht, "0", "1", "11"), pick(g.ht, "1", "29"), pick(g.ht, "0", "23", "24", "-1"), pick(g.ht, "0", "59", "60"), pick(g.ht, "0", "59", "60"), pick(g.ht, "0", "999", "1000", "-1"))
+		}
+	case 20:
+		return g.call(pick(g.ht, "Number", "Math.abs", "Math.floor", "Math.trunc"), g.expr(pick(g.ht, kBool, kArr, kObj, kAny, kStr), d-1).s)
+	case 21:
+		x := g.i32(g.expr(kNum, d-1))
+		return ex{g.operand(x, bitOrPrec, false) + " | 0", bitOrPrec}
+	default:
+		return g.call(pick(g.ht, "Object.keys", "Object.values", "Object.entries", "Object.getOwnPropertyNames", "Reflect.ownKeys"), g.expr(pick(g.ht, kObj, kArr, kStr), d-1).s).length()
+	}
+}
+
+func (e ex) length() ex { return ex{e.s + ".length", callPrec} }
+
+// i32 is x as an operand of a bitwise operator: while goja/7 is open, the
+// value is first reduced modulo 2^32 (which does not change ToInt32 of it),
+// since goja gives 0 for a magnitude of 2^63 or more.
+func (g *gen) i32(x ex) ex {
+	if Known.toInt32Large {
+		return ex{g.operand(x, mulPrec, false) + " % 4294967296", mulPrec}
+	}
+	return x
+}
+
+// predicate is a one-argument arrow function returning a boolean.
+func (g *gen) predicate(d int) string {
+	return pick(g.ht, "x => x", "x => !x", "x => typeof x === 'number'", "x => typeof x === 'string'", "x => x > 2", "x => x == 1", "(x, i) => i % 2 === 0", "x => x !== x", "x => x === undefined", "x => x === null", "x => Array.isArray(x)", "x => x && x.length > 1", "(x, i, a) => a.indexOf(x) !== i", "function (x) { return x < 3; }")
+}
+
+// jsonGap is JSON.stringify's third argument.
