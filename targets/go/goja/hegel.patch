+	case 7:
+		return g.call("Array.from", g.expr(pick(g.ht, kArr, kStr, kObj), d-1).s, pick(g.ht, "", "x => x", "(x, i) => i", arrayFromMapper()))
+	case 8:
+		return g.call(pick(g.ht, "Array.of", "Array", "new Array"), g.elems(d-1, n(g.ht, 0, 3), false))
+	case 9:
+		return atom("[..." + g.operand(g.expr(pick(g.ht, kArr, kStr), d-1), assignPrec, false) + ", " + g.elems(d-1, n(g.ht, 0, 2), false) + "]")
+	case 10:
+		re := withGlobal(g.regexLit())
+		if Known.globalEmptyMatch && g.lastReEmpty {
+			re = "/[a-c]+/g" // goja/16, and a global match is wanted here (the non-global result has goja/17's key order)
+		}
+		return g.call(g.member(g.expr(kStr, d-1), "match").s, re)
+	case 11:
+		return atom("Array(" + pick(g.ht, "0", "1", "3", "10", "'3'", "2.5", "-1", "4294967296", "1e10", "NaN") + ")")
+	case 12:
+		return g.call("[].concat", g.expr(kAny, d-1).s, g.expr(kArr, d-1).s)
+	case 13:
+		return atom("[" + g.expr(kAny, d-1).s + "].concat(" + g.expr(kArr, d-1).s + ")")
+	case 14:
+		return g.call("Array.from", "{length: "+pick(g.ht, "3", "0", "-1", "2.5", "'2'")+", 0: 'a', 1: 'b', 5: 'x'}")
+	case 15:
+		return g.call("Array.from", g.expr(kArr, d-1).s+".entries()")
+	default:
+		return atom("[" + g.elems(d-1, n(g.ht, 0, 3), false) + "]")
+	}
+}
+
+func (g *gen) elems(d, k int, holes bool) string {
+	parts := make([]string, k)
+	for i := range parts {
+		if holes && chance(g.ht, 30) {
+			parts[i] = ""
+		} else if chance(g.ht, 15) {
+			parts[i] = "..." + g.operand(g.expr(pick(g.ht, kArr, kStr), d), assignPrec, false)
+		} else {
+			parts[i] = g.expr(pick(g.ht, kNum, kNum, kStr, kStr, kBool, kAny, kArr, kObj), d).s
+		}
+	}
+	s := strings.Join(parts, ", ")
+	if holes && k > 0 && chance(g.ht, 30) {
+		s += "," // trailing comma: no extra element
+	}
+	return s
+}
+
+func (g *gen) key(d int) string {
+	switch n(g.ht, 1, 12) {
+	case 1, 2, 3, 4:
+		return pick(g.ht, "a", "b", "c", "x", "y", "length", "constructor", "toString", "valueOf", "hasOwnProperty", "__proto__", "$", "_", "if", "class", "await")
+	case 5, 6:
+		return fmt.Sprint(n(g.ht, 0, 12))
+	case 7:
+		return pick(g.ht, "'1'", "'01'", "'-0'", "'1.0'", "'1e3'", "'4294967295'", "'4294967296'", "'a b'", "''", "'\\u00e9'", "'\\u{1F600}'", "'__proto__'", "'-1'", "'0.5'")
+	case 8:
+		return "[" + g.expr(pick(g.ht, kStr, kNum, kAny), d).s + "]"
+	case 9:
+		return pick(g.ht, "1.5", "0x10", "1e3", "0.0", "-0", "1e21", "010", "0.1e1", "00")
+	case 10:
+		return "[Symbol.iterator]"
+	default:
+		return pick(g.ht, "a", "b", "1", "2")
+	}
+}
+
+func (g *gen) objExpr(d int) ex {
+	if v, ok := g.varOf(kObj); ok && chance(g.ht, 50) {
+		return v
+	}
+	if d <= 0 {
+		return atom("{}")
+	}
+	switch n(g.ht, 1, 12) {
+	case 1, 2, 3, 4:
+		return atom(g.objLit(d - 1))
+	case 5:
+		return g.call("Object.assign", g.expr(kObj, d-1).s, g.expr(pick(g.ht, kObj, kArr, kStr, kAny), d-1).s)
+	case 6:
+		from := pick(g.ht, "Object.entries", "Array.from", "Object.entries")
+		if Known.fromEntriesPanic {
+			from = "Object.entries" // goja/20: entries are always pairs
+		}
+		return g.call("Object.fromEntries", g.call(from, g.expr(pick(g.ht, kObj, kArr), d-1).s).s)
+	case 7:
+		// the documented caveat: a lone surrogate does not survive the engine's JSON round trip
+		// (U+FFFD), so the replacer scrubs surrogate code units (pairs too: no lookarounds here,
+		// the lookbehind path handles surrogates differently)
+		return g.call("JSON.parse", g.call("JSON.stringify", g.expr(pick(g.ht, kObj, kArr, kAny), d-1).s, "(k, v) => typeof v === 'string' ? v.replace(/[\\uD800-\\uDFFF]/g, '?') : v").s)
+	case 8:
+		return atom("{..." + g.operand(g.expr(pick(g.ht, kObj, kArr, kStr, kAny), d-1), assignPrec, false) + ", " + g.key(d-1) + ": " + g.expr(kAny, d-1).s + "}")
+	case 9:
+		return g.call("Object.create", pick(g.ht, "null", "{inherited: 1}", "Object.prototype", "Array.prototype"))
+	case 10:
+		return atom("new (class { constructor(v) { this.v = v; this[1] = 2; } get w() { return this.v; } })(" + g.expr(kAny, d-1).s + ")")
+	case 11:
+		return g.call("Object.defineProperty", g.expr(kObj, d-1).s, g.expr(kStr, d-1).s, pick(g.ht, "{value: 1, enumerable: true}", "{value: 1}", "{get() { return 7; }, enumerable: true}", "{value: 2, writable: false, enumerable: true, configurable: false}", "{set(v) {}, enumerable: true}"))
+	default:
+		return atom(g.objLit(d - 1))
+	}
+}
+
+func (g *gen) objLit(d int) string {
+	k := n(g.ht, 0, 4)
+	parts := make([]string, k)
+	for i := range parts {
+		switch n(g.ht, 1, 12) {
+		case 1, 2, 3, 4, 5, 6:
+			parts[i] = g.key(d) + ": " + g.expr(pick(g.ht, kNum, kStr, kBool, kAny, kArr, kObj), d).s
+		case 7:
+			if vs := g.visible(kAny); len(vs) > 0 {
+				parts[i] = pick(g.ht, vs...).name // shorthand
+			} else {
+				parts[i] = "z: 0"
+			}
+		case 8:
+			parts[i] = "get " + pick(g.ht, "a", "b", "g") + "() { return " + g.expr(kAny, d).s + "; }"
+		case 9:
+			parts[i] = pick(g.ht, "a", "m", "1") + "(" + pick(g.ht, "", "x", "x, y", "...r") + ") { return " + g.expr(kAny, d).s + "; }"
+		case 10:
+			parts[i] = "..." + g.operand(g.expr(pick(g.ht, kObj, kArr, kStr, kAny), d), assignPrec, false)
+		case 11:
+			parts[i] = "set " + pick(g.ht, "a", "b") + "(v) { this._v = v; }"
+		default:
+			parts[i] = "__proto__: " + pick(g.ht, "null", "{p: 1}", "[]", "1")
+		}
+	}
+	// V8 lists accessors after data properties when the literal has a
+	// spread (off the specification's creation order): never both.
+	spread := false
+	for _, p := range parts {
+		spread = spread || strings.HasPrefix(p, "...")
+	}
+	if spread {
+		for i, p := range parts {
+			if strings.HasPrefix(p, "get ") || strings.HasPrefix(p, "set ") {
+				parts[i] = p[4:5] + ": 1"
+			}
+		}
+		// and V8 moves a repeated key to the end of the order when the literal
+		// has a spread (`{...{}, b: 1, a: 2, b: 3}` lists a, b): no repeated keys
+		seen := map[string]bool{}
+		kept := parts[:0]
+		for _, p := range parts {
+			key := p
+			if i := strings.IndexAny(p, ":("); i >= 0 {
+				key = p[:i]
+			}
+			if !strings.HasPrefix(p, "...") && seen[key] {
+				continue
+			}
+			seen[key] = true
+			kept = append(kept, p)
+		}
+		parts = kept
+	}
+	return "{" + strings.Join(parts, ", ") + "}"
+}
+
+func (g *gen) funcExpr(d int) ex {
+	if v, ok := g.varOf(kFunc); ok && chance(g.ht, 50) {
+		return v
+	}
+	body := "undefined"
+	if d > 0 {
+		body = g.expr(kAny, d-1).s
+	}
+	switch n(g.ht, 1, 8) {
+	case 1, 2:
+		return atom("function (" + pick(g.ht, "", "a", "a, b", "a, b = 1", "...r", "a, ...r", "{a, b}", "[a, b]") + ") { return " + body + "; }")
+	case 3, 4:
+		// an arrow function binds looser than any operator: `x => a && b` is one arrow
+		return ex{"(" + pick(g.ht, "", "a", "a, b", "a = 2", "...r") + ") => " + g.operand(ex{body, assignPrec}, assignPrec, false), assignPrec}
+	case 5:
+		return atom("function* () { yield 1; yield " + body + "; }")
+	case 6:
+		return atom(pick(g.ht, "Math.max", "String", "Number", "Array.isArray", "Object.keys", "parseInt", "JSON.stringify", "Boolean", "Symbol", "Object", "Array", "Date.UTC", "isNaN", "encodeURIComponent"))
+	case 7:
+		return atom("class { static s = 1; constructor(a) { this.a = a; } m() { return " + body + "; } }")
+	default:
+		return atom("(function () { return function () { return " + body + "; }; })()")
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Statements.
+
+func (g *gen) indent() string { return strings.Repeat("  ", g.depth) }
+
+func (g *gen) block(d, k int) string {
+	saved := g.vars
+	g.depth++
+	var lines []string
+	for i := 0; i < k && g.tick(); i++ {
+		if s := g.stmt(d); s != "" {
+			lines = append(lines, g.indent()+s)
+		}
+	}
+	g.depth--
+	g.vars = saved
+	if len(lines) == 0 {
+		return ""
+	}
+	return strings.Join(lines, "\n") + "\n"
+}
+
+func (g *gen) declare(k kind, d int) string {
+	name := g.fresh("v")
+	kw := pick(g.ht, "let", "let", "const", "var")
+	v := variable{name: name, k: k, elem: kAny, konst: kw == "const"}
+	x := g.expr(k, d)
+	if k == kArr && strings.HasPrefix(x.s, "[") && !strings.Contains(x.s, "...") && !strings.Contains(x.s, ",,") && !strings.Contains(x.s, ", ,") && !strings.HasSuffix(x.s, ",]") {
+		v.seq = true
+	}
+	g.vars = append(g.vars, v)
+	return fmt.Sprintf("%s %s = %s;", kw, name, x.s)
+}
+
+func (g *gen) stmt(d int) string {
+	switch n(g.ht, 1, 30) {
+	case 1, 2, 3, 4, 5, 6:
+		return g.declare(pick(g.ht, kNum, kNum, kStr, kStr, kBool, kArr, kArr, kObj, kObj, kAny, kFunc), d)
+	case 7, 8:
+		if vs := g.visible(kAny); len(vs) > 0 {
+			v := pick(g.ht, vs...)
+			if !v.konst {
+				k := v.k
+				if chance(g.ht, 15) {
+					k = kAny // changes the kind: the registry keeps the old one, fine for a differential
+				}
+				return fmt.Sprintf("%s %s %s;", v.name, pick(g.ht, "=", "=", "=", "+=", "-=", "||=", "&&=", "??="), g.expr(k, d).s)
+			}
+		}
+		return g.declare(kNum, d)
+	case 9, 10:
+		cond := g.expr(pick(g.ht, kBool, kAny), d).s
+		body := g.block(d-1, n(g.ht, 0, 3))
+		var els string
+		if chance(g.ht, 40) {
+			els = fmt.Sprintf(" else {\n%s%s}", g.block(d-1, n(g.ht, 0, 3)), g.indent())
+		}
+		if Known.deadBranchJump && (strings.Contains(body+els, "break") || strings.Contains(body+els, "continue")) {
+			cond = "Boolean(" + cond + ")" // goja/33: no constant condition around a break or continue
+		}
+		return fmt.Sprintf("if (%s) {\n%s%s}%s", cond, body, g.indent(), els)
+	case 11, 12:
+		return g.loop(d)
+	case 13:
+		return g.forIn(d)
+	case 14:
+		return g.tryStmt(d)
+	case 15, 16:
+		return g.funcDecl(d)
+	case 17:
+		if v := g.visible(kArr); len(v) > 0 {
+			a := pick(g.ht, v...)
+			m := pick(g.ht, "push", "pop", "shift", "unshift", "reverse", "sort", "splice", "fill")
+			switch m {
+			case "push", "unshift":
+				return fmt.Sprintf("%s.%s(%s);", a.name, m, g.elems(d, n(g.ht, 0, 3), false))
+			case "splice":
+				return fmt.Sprintf("%s.splice(%s, %s%s);", a.name, g.idx(d), g.idx(d), pick(g.ht, "", ", "+g.expr(kAny, d).s))
+			case "fill":
+				return fmt.Sprintf("%s.fill(%s, %s);", a.name, g.expr(kAny, d).s, g.idx(d))
+			case "sort":
+				return fmt.Sprintf("%s.sort(%s);", a.name, pick(g.ht, "", "(a, b) => a - b", "(a, b) => String(b) < String(a) ? -1 : String(a) < String(b) ? 1 : 0"))
+			}
+			return fmt.Sprintf("%s.%s();", a.name, m)
+		}
+		return g.declare(kArr, d)
+	case 18:
+		if v := g.visible(kObj); len(v) > 0 {
+			o := pick(g.ht, v...)
+			switch n(g.ht, 1, 5) {
+			case 1, 2:
+				return fmt.Sprintf("%s[%s] = %s;", o.name, g.expr(pick(g.ht, kStr, kNum, kAny), d).s, g.expr(kAny, d).s)
+			case 3:
+				return fmt.Sprintf("%s.%s = %s;", o.name, pick(g.ht, "a", "b", "c", "x", "length", "0", "toString"), g.expr(kAny, d).s)
+			case 4:
+				return fmt.Sprintf("delete %s[%s];", o.name, g.expr(pick(g.ht, kStr, kNum), d).s)
+			}
+			return fmt.Sprintf("Object.%s(%s);", pick(g.ht, "freeze", "seal", "preventExtensions"), o.name)
+		}
+		return g.declare(kObj, d)
+	case 19:
+		if v := g.visible(kArr); len(v) > 0 {
+			a := pick(g.ht, v...)
+			switch n(g.ht, 1, 3) {
+			case 1:
+				return fmt.Sprintf("%s[%s] = %s;", a.name, g.idx(d), g.expr(kAny, d).s)
+			case 2:
+				return fmt.Sprintf("%s.length = %s;", a.name, pick(g.ht, "0", "1", "2", "5", "10", "'3'", "1.5", "-1", "4294967296"))
+			}
+			return fmt.Sprintf("%s[%s] = %s;", a.name, pick(g.ht, "'x'", "'1'", "'-1'", "'01'", "1e3", "'4294967295'", "4294967295"), g.expr(kAny, d).s)
+		}
+		return g.declare(kArr, d)
+	case 20:
+		return g.switchStmt(d)
+	case 21:
+		return g.destructure(d)
+	case 22:
+		if g.loops > 0 && chance(g.ht, 50) {
+			kw := pick(g.ht, "break", "continue")
+			cond := g.expr(kBool, d).s
+			if Known.constantContinue {
+				cond = "Boolean(" + cond + ")" // goja/19: never a constant condition
+			}
+			if len(g.labels) > 0 && chance(g.ht, 40) {
+				return fmt.Sprintf("if (%s) %s %s;", cond, kw, pick(g.ht, g.labels...))
+			}
+			return fmt.Sprintf("if (%s) %s;", cond, kw)
+		}
+		return fmt.Sprintf("%s;", g.expr(kAny, d).s)
+	case 23:
+		return g.classDecl(d)
+	case 24:
+		return fmt.Sprintf("{\n%s%s}", g.block(d-1, n(g.ht, 1, 3)), g.indent())
+	case 25:
+		return g.labeled(d)
+	case 26:
+		name := g.fresh("v")
+		g.vars = append(g.vars, variable{name: name, k: kAny})
+		return fmt.Sprintf("let %s = (() => { try { return %s; } catch (e) { return e instanceof Error ? e.name : e; } })();", name, g.expr(kAny, d).s)
+	case 27:
+		return g.generatorStmt(d)
+	case 28:
+		if v := g.visible(kNum); len(v) > 0 {
+			x := pick(g.ht, v...)
+			if !x.konst {
+				if Known.toInt32Large {
+					return pick(g.ht, x.name+"++;", x.name+"--;", "++"+x.name+";", x.name+" = -"+x.name+";") // goja/7
+				}
+				return pick(g.ht, x.name+"++;", x.name+"--;", "++"+x.name+";", x.name+" = -"+x.name+";", x.name+" = "+x.name+" | 0;", x.name+" >>>= 0;", x.name+" = ~~"+x.name+";")
+			}
+		}
+		return g.declare(kNum, d)
+	default:
+		return fmt.Sprintf("%s;", g.expr(kAny, d).s)
+	}
+}
+
+func (g *gen) loop(d int) string {
+	i := g.fresh("i")
+	saved := g.vars
+	g.loops++
+	defer func() { g.loops--; g.vars = saved }()
+	switch n(g.ht, 1, 5) {
+	case 1, 2:
+		g.vars = append(g.vars, variable{name: i, k: kNum, konst: true})
+		return fmt.Sprintf("for (let %s = %d; %s < %d; %s%s) {\n%s%s}", i, n(g.ht, -1, 2), i, n(g.ht, 0, 6), i, pick(g.ht, "++", " += 1", " += 2", "++"), g.block(d-1, n(g.ht, 0, 3)), g.indent())
+	case 3:
+		g.vars = append(g.vars, variable{name: i, k: kNum, konst: true})
+		return fmt.Sprintf("let %s = 0;\n%swhile (%s && %s++ < %d) {\n%s%s}", i, g.indent(), g.operand(g.expr(kBool, d), andPrec, false), i, n(g.ht, 0, 6), g.block(d-1, n(g.ht, 0, 3)), g.indent())
+	case 4:
+		g.vars = append(g.vars, variable{name: i, k: kNum, konst: true})
+		return fmt.Sprintf("let %s = 0;\n%sdo {\n%s%s} while (%s++ < %d && %s);", i, g.indent(), g.block(d-1, n(g.ht, 0, 3)), g.indent(), i, n(g.ht, 0, 4), g.operand(g.expr(kBool, d), andPrec, false))
+	default:
+		x := g.fresh("e")
+		src := g.expr(pick(g.ht, kArr, kArr, kStr), d)
+		g.vars = append(g.vars, variable{name: x, k: kAny, konst: true})
+		// over a copy: a body that pushes onto the iterated array would never end
+		// (node throws a RangeError at the array length limit, the engine hits the interrupt)
+		return fmt.Sprintf("for (%s %s of [...%s]) {\n%s%s}", pick(g.ht, "const", "let", "var"), x, g.operand(src, assignPrec, false), g.block(d-1, n(g.ht, 0, 3)), g.indent())
+	}
+}
+
+func (g *gen) forIn(d int) string {
+	k := g.fresh("k")
+	saved := g.vars
+	g.loops++
+	defer func() { g.loops--; g.vars = saved }()
+	src := g.expr(pick(g.ht, kObj, kArr, kStr, kAny), d)
+	g.vars = append(g.vars, variable{name: k, k: kStr, konst: true})
+	acc := g.fresh("v")
+	body := g.block(d-1, n(g.ht, 0, 2))
+	s := fmt.Sprintf("const %s = [];\n%sfor (const %s in %s) {\n%s  %s.push(%s);\n%s%s}", acc, g.indent(), k, g.operand(src, assignPrec, false), g.indent(), acc, k, body, g.indent())
+	g.vars = append(saved, variable{name: acc, k: kArr, elem: kStr, seq: true, konst: true})
+	saved = g.vars
+	return s
+}
+
+func (g *gen) tryStmt(d int) string {
+	res := g.fresh("v")
+	saved := g.vars
+	body := g.block(d-1, n(g.ht, 0, 3))
+	g.vars = saved
+	var thrown string
+	switch n(g.ht, 1, 6) {
+	case 1:
+		thrown = fmt.Sprintf("throw %s;", g.expr(kAny, d).s)
+	case 2:
+		thrown = fmt.Sprintf("throw new %s(%s);", pick(g.ht, "Error", "TypeError", "RangeError", "SyntaxError", "ReferenceError", "EvalError", "URIError"), g.expr(kStr, d).s)
+	case 3:
+		thrown = pick(g.ht, "null.x;", "undefined();", "(void 0).a.b;", "new Array(-1);", "(1).toFixed(101);", "'a'.repeat(-1);", "JSON.parse('{');", "new RegExp('(');", "decodeURIComponent('%');", "BigInt(1.5);", "1n + 1;", "Symbol() + '';", "[].reduce((a, b) => a);", "Object.defineProperty(1, 'x', {});", "new (() => {})();", "x.y;", "(function f() { 'use strict'; f = 1; })();", "Object.freeze([1]).push(2);", "'use strict'; undefinedVariable = 1;", "({}).x.y;", "[...1];", "new Symbol();", "Object.setPrototypeOf(Object.preventExtensions({}), {});", "(class A extends null {}, new (class A extends null {})());", "String.fromCodePoint(-1);", "'x'.normalize('bad');", "(1).toString(1);", "new Date(NaN).toISOString();", "structuredClone;", "Reflect.ownKeys(1);", "new Proxy({}, {get() { return 1; }}).x.y.z;")
+	case 4:
+		thrown = fmt.Sprintf("%s;", g.expr(kAny, d).s)
+	default:
+		thrown = ""
+	}
+	g.vars = saved
+	catchBody := g.block(d-1, n(g.ht, 0, 2))
+	g.vars = saved
+	fin := ""
+	if chance(g.ht, 40) {
+		fin = fmt.Sprintf(" finally {\n%s  %s = [%s, 'f'];\n%s}", g.indent(), res, res, g.indent())
+	}
+	g.vars = append(saved, variable{name: res, k: kAny})
+	param := pick(g.ht, "e", "{name, message}", "[a] = [1]", "e = 1")
+	if Known.bigintPrototypeName && param == "{name, message}" && bigintLit.MatchString(thrown) {
+		param = "e" // goja/37: a thrown BigInt has a name
+	}
+	ev := map[string]string{"{name, message}": "name", "[a] = [1]": "a"}[param]
+	if ev == "" {
+		ev = "e"
+	}
+	return fmt.Sprintf("let %s;\n%stry {\n%s%s  %s\n%s} catch (%s) {\n%s  %s = %s instanceof Error ? %s.name : %s;\n%s%s}%s", res, g.indent(), body, g.indent(), thrown, g.indent(), param, g.indent(), res, ev, ev, ev, catchBody, g.indent(), fin)
+}
+
+func (g *gen) funcDecl(d int) string {
+	name := g.fresh("f")
+	saved := g.vars
+	params := pick(g.ht, "", "a", "a, b", "a, b = 1", "...r", "a, ...r", "{a, b} = {}", "[a, b] = []", "a, b, c")
+	g.vars = nil
+	for _, p := range []string{"a", "b", "c", "r"} {
+		if strings.Contains(params, p) {
+			g.vars = append(g.vars, variable{name: p, k: kAny})
+		}
+	}
+	g.funcs++
+	g.depth++
+	body := g.block(d-1, n(g.ht, 0, 3))
+	ret := fmt.Sprintf("%sreturn %s;\n", g.indent(), g.retList())
+	g.depth--
+	g.funcs--
+	g.vars = saved
+	g.vars = append(g.vars, variable{name: name, k: kFunc})
+	kw := pick(g.ht, "function", "function", "function*")
+	s := fmt.Sprintf("%s %s(%s) {\n%s%s%s}", kw, name, params, body, ret, g.indent())
+	// call it and keep the result, so that the body runs
+	res := g.fresh("v")
+	callArgs := g.elems(d, n(g.ht, 0, 3), false)
+	call := fmt.Sprintf("%s(%s)", name, callArgs)
+	if kw == "function*" {
+		call = "[..." + call + "]"
+	} else if chance(g.ht, 30) {
+		call = fmt.Sprintf("%s.%s(%s)", name, pick(g.ht, "call", "apply", "bind"), pick(g.ht, "null", "{}", "1", "undefined"))
+		if strings.Contains(call, "bind") {
+			call += "()"
+		}
+	}
+	g.vars = append(g.vars, variable{name: res, k: kAny})
+	return fmt.Sprintf("%s\n%slet %s = %s;", s, g.indent(), res, call)
+}
+
+func (g *gen) retList() string {
+	vs := g.visible(kAny)
+	if len(vs) == 0 {
+		return g.expr(kAny, 1).s
+	}
+	if len(vs) > 4 {
+		vs = vs[len(vs)-4:]
+	}
+	names := make([]string, len(vs))
+	for i, v := range vs {
+		names[i] = v.name
+	}
+	return "[" + strings.Join(names, ", ") + "]"
+}
+
+func (g *gen) switchStmt(d int) string {
+	res := g.fresh("v")
+	x := g.expr(pick(g.ht, kNum, kStr, kAny), d)
+	var cases []string
+	k := n(g.ht, 1, 4)
+	for i := 0; i < k; i++ {
+		lbl := pick(g.ht, "1", "2", "'a'", "'1'", "true", "undefined", "null", "NaN", "0", "-0", "'b'", g.expr(kAny, d-1).s)
+		body := pick(g.ht, fmt.Sprintf("%s = %d; break;", res, i), fmt.Sprintf("%s += %d;", res, i), fmt.Sprintf("%s = %d;", res, i), "break;", "")
+		cases = append(cases, fmt.Sprintf("%s  case %s: %s", g.indent(), lbl, body))
+	}
+	if chance(g.ht, 50) {
+		pos := n(g.ht, 0, len(cases))
+		def := fmt.Sprintf("%s  default: %s = 'd';%s", g.indent(), res, pick(g.ht, "", " break;"))
+		cases = append(cases[:pos], append([]string{def}, cases[pos:]...)...)
+	}
+	g.vars = append(g.vars, variable{name: res, k: kAny})
+	return fmt.Sprintf("let %s = 0;\n%sswitch (%s) {\n%s\n%s}", res, g.indent(), x.s, strings.Join(cases, "\n"), g.indent())
+}
+
+func (g *gen) destructure(d int) string {
+	a, b, c := g.fresh("d"), g.fresh("d"), g.fresh("d")
+	for _, v := range []string{a, b, c} {
+		g.vars = append(g.vars, variable{name: v, k: kAny})
+	}
+	switch n(g.ht, 1, 6) {
+	case 1:
+		return fmt.Sprintf("let [%s, %s = %s, ...%s] = %s;", a, b, g.expr(kAny, d).s, c, g.operand(g.expr(pick(g.ht, kArr, kStr), d), assignPrec, false))
+	case 2:
+		return fmt.Sprintf("let {%s, %s: %s = %s, ...%s} = %s;", a, pick(g.ht, "a", "b", "length", "0", "x"), b, g.expr(kAny, d).s, c, g.operand(g.expr(pick(g.ht, kObj, kArr, kStr), d), assignPrec, false))
+	case 3:
+		return fmt.Sprintf("let %s, %s, %s;\n%s[%s, [%s] = [], {%s = 3} = {}] = %s;", a, b, c, g.indent(), a, b, c, g.operand(g.expr(kArr, d), assignPrec, false))
+	case 4:
+		return fmt.Sprintf("let %s = %s, %s = %s, %s;\n%s[%s, %s] = [%s, %s]; %s = [%s, %s];", a, g.expr(kAny, d).s, b, g.expr(kAny, d).s, c, g.indent(), a, b, b, a, c, a, b)
+	case 5:
+		return fmt.Sprintf("let {[%s]: %s, %s = 1, %s} = %s;", g.expr(kStr, d).s, a, b, c, g.operand(g.expr(kObj, d), assignPrec, false))
+	default:
+		return fmt.Sprintf("let [%s, , %s, %s] = %s;", a, b, c, pick(g.ht, "'abc'", "'\\u{1F600}x'", "[1, 2, 3]", "new Set([1, 1, 2, 3])", "new Map([[1, 2], [3, 4]])", "[1, 2, 3].entries()", "(function* () { yield 1; yield 2; })()"))
+	}
+}
+
+func (g *gen) classDecl(d int) string {
+	name := g.fresh("C")
+	res := g.fresh("v")
+	saved := g.vars
+	g.vars = nil
+	val := g.expr(kAny, d-1).s
+	g.vars = saved
+	extra := pick(g.ht, "", " extends Array", " extends Error", " extends Object", " extends (class { constructor() { this.base = 1; } })")
+	body := []string{
+		"constructor(...a) { " + pick(g.ht, "", "super(...a); ", "super(); ") + "this.a = a.length; this.v = " + val + "; }",
+		"m() { return this.a; }",
+		"get g() { return this.v; }",
+		"static s() { return " + pick(g.ht, "1", "this.name", "typeof this", "new this(1, 2).a") + "; }",
+		"[Symbol.toPrimitive](h) { return h; }",
+		"toString() { return 'C'; }",
+		"static #p = 1; static p() { return " + name + ".#p; }",
+		"f = 5;",
+		"static sf = 6;",
+		"['c' + 1]() { return 1; }",
+	}
+	if extra == "" && strings.Contains(body[0], "super") {
+		body[0] = "constructor(...a) { this.a = a.length; this.v = " + val + "; }"
+	}
+	if extra != "" && !strings.Contains(body[0], "super") {
+		body[0] = "constructor(...a) { super(...a); this.a = a.length; this.v = " + val + "; }"
+	}
+	k := n(g.ht, 1, 5)
+	chosen := []string{body[0]}
+	for i := 0; i < k; i++ {
+		c := pick(g.ht, body[1:]...)
+		dup := false
+		for _, x := range chosen {
+			if x == c {
+				dup = true
+			}
+		}
+		if !dup {
+			chosen = append(chosen, c)
+		}
+	}
+	g.vars = append(g.vars, variable{name: name, k: kFunc, konst: true})
+	g.vars = append(g.vars, variable{name: res, k: kAny})
+	inst := fmt.Sprintf("new %s(%s)", name, g.elems(d-1, n(g.ht, 0, 2), false))
+	use := pick(g.ht, inst+".a", inst+".v", inst+".g", "typeof "+inst+".m", "["+inst+" instanceof "+name+", Object.getPrototypeOf("+inst+") === "+name+".prototype]", name+".name", "Object.getOwnPropertyNames("+name+".prototype)", "Object.keys("+inst+")", "String("+inst+")", "typeof "+name, inst+".constructor === "+name, "Object.getOwnPropertyNames("+name+")", "Object.getPrototypeOf("+name+") === Function.prototype", inst+".length", "JSON.stringify("+inst+")", "Array.isArray("+inst+")", inst+" instanceof Error")
