+		// goja/9: only patterns valid with the u flag
+		src = strings.ReplaceAll(src, "\\-", "-")
+		src = strings.ReplaceAll(src, "[\\d-x]", "[\\dx]")
+		if !strings.Contains(src, "(a)") && !strings.Contains(src, "(?<x>a)") {
+			src = strings.ReplaceAll(src, "\\1", "a")
+		}
+		if !strings.Contains(src, "(?<x>a)") {
+			src = strings.ReplaceAll(src, "\\k<x>", "k")
+		}
+	}
+	if Known.duplicateGroupNames && strings.Count(src, "(?<x>a)") > 1 {
