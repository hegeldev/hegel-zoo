+      setForEach = typeof Set === 'function' ? Set.prototype.forEach : null,
+      numValue = Number.prototype.valueOf, strValue = String.prototype.valueOf, boolValue = Boolean.prototype.valueOf;
+  function fmtNum(n) {
+    if (n !== n) return 'NaN';
+    if (n === 0 && 1 / n < 0) return '-0';
+    return numToStr.call(n);
+  }
+  function fmtStr(s) {
+    var out = '"';
+    for (var i = 0; i < s.length; i++) {
+      var c = charCode.call(s, i);
+      if (c < 32 || c > 126 || c === 34 || c === 92) {
+        out += '\\u' + strSlice.call('0000' + numToStr.call(c, 16), -4);
+      } else {
