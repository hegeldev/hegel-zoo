+        if (!isIndex(keys[i], v.length)) arrPush.call(parts, fmtStr(keys[i]) + ':' + prop(v, keys[i], seen, depth));
+      }
+      out = '[' + arrJoin.call(parts, ',') + ']';
+    } else if (tag === '[object Error]') {
+      out = '<Error ' + fmtStr(Str(v.name)) + '>';
+    } else if (tag === '[object Date]') {
+      out = '<date ' + fmtNum(getTime.call(v)) + '>';
+    } else if (tag === '[object RegExp]') {
+      out = '<regexp ' + fmtStr(Str(v.source)) + ' ' + fmtStr(Str(v.flags)) + ' ' + fmtNum(v.lastIndex) + '>';
+    } else if (tag === '[object Map]') {
+      mapForEach.call(v, function (val, key) { arrPush.call(parts, ser(key, seen, depth + 1) + '=>' + ser(val, seen, depth + 1)); });
+      out = '<map ' + arrJoin.call(parts, ',') + '>';
+    } else if (tag === '[object Set]') {
+      setForEach.call(v, function (val) { arrPush.call(parts, ser(val, seen, depth + 1)); });
+      out = '<set ' + arrJoin.call(parts, ',') + '>';
+    } else if (tag === '[object Number]') {
+      out = '<Number ' + fmtNum(numValue.call(v)) + '>';
+    } else if (tag === '[object String]') {
+      out = '<String ' + fmtStr(strValue.call(v)) + '>';
+    } else if (tag === '[object Boolean]') {
+      out = '<Boolean ' + (boolValue.call(v) ? 'true' : 'false') + '>';
+    } else {
+      keys = keysOf(v);
+      for (i = 0; i < keys.length; i++) {
+        arrPush.call(parts, fmtStr(keys[i]) + ':' + prop(v, keys[i], seen, depth));
+      }
+      out = (tag === '[object Object]' || tag === '[object Arguments]' ? '' : '<' + tag + '>') + '{' + arrJoin.call(parts, ',') + '}';
+    }
+    seen.length--;
+    return out;
+  }
+  // prop is ser of v[k]; a getter that throws gives <throws "Name">.
+  function prop(v, k, seen, depth) {
+    var x;
+    try {
+      x = v[k];
+    } catch (e) {
+      return '<throws ' + fmtStr(Str(e && e.name)) + '>';
+    }
+    return ser(x, seen, depth + 1);
+  }
+  return function (v) { return ser(v, [], 0); };
+})();
+`
+
+const nodeDriver = `'use strict';
+const vm = require('vm');
+const SER = process.env.HEGEL_SER_SRC;
+let buf = Buffer.alloc(0);
+function reply(status, payload) {
+  process.stdout.write(status + '\n' + Buffer.byteLength(payload) + '\n' + payload);
+}
+function run(src) {
+  const ctx = vm.createContext({});
+  vm.runInContext(SER, ctx, { filename: 'ser' });
+  let script;
+  try {
+    script = new vm.Script('(function () {\n' + src + '\n})()', { filename: 'snip' });
+  } catch (e) {
+    reply('compile', '<Error ' + JSON.stringify(String(e && e.name)) + '>');
+    return;
+  }
+  const ser = ctx.__ser;
+  let v;
+  try {
+    v = script.runInContext(ctx, { timeout: 5000 });
+  } catch (e) {
+    if (e && e.code === 'ERR_SCRIPT_EXECUTION_TIMEOUT') {
+      reply('timeout', '');
+      return;
+    }
+    let p;
+    try { p = ser(e); } catch (e2) { p = '<unserialisable>'; }
+    reply('throw', p);
+    return;
+  }
+  let p;
+  try { p = ser(v); } catch (e2) { p = '<unserialisable>'; }
+  reply('ok', p);
+}
+function pump() {
+  for (;;) {
+    const nl = buf.indexOf(10);
+    if (nl < 0) return;
+    const len = parseInt(buf.slice(0, nl).toString('latin1'), 10);
+    if (buf.length < nl + 1 + len) return;
+    const src = buf.slice(nl + 1, nl + 1 + len).toString('utf8');
+    buf = buf.slice(nl + 1 + len);
+    run(src);
+  }
+}
+process.stdout.write('node driver ' + process.version + '\n');
+process.stdin.on('data', (d) => { buf = Buffer.concat([buf, d]); pump(); });
+process.stdin.on('end', () => process.exit(0));
+// A program may leave a rejected promise behind (a dynamic import, say):
+// that is its result's business, not a reason to die.
+process.on('unhandledRejection', () => {});
+`
+
+type jsResult struct {
+	Status  string // ok, compile, throw, timeout (and, for goja, panic)
+	Payload string
+}
+
+var (
+	oracleOnce   sync.Once
+	oracleMu     sync.Mutex
+	oracleIn     io.WriteCloser
+	oracleOut    *bufio.Reader
+	oracleErr    error
+	oracleBanner string
+	oracleCmd    *exec.Cmd
+	oracleStderr strings.Builder
+)
+
+func startOracle() {
+	cmd := exec.Command("node", "-e", nodeDriver)
+	cmd.Env = append(os.Environ(), "HEGEL_SER_SRC="+serSrc, "TZ=UTC")
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	cmd.Stderr = &oracleStderr
+	oracleCmd = cmd
+	if err := cmd.Start(); err != nil {
+		oracleErr = fmt.Errorf("starting node: %v", err)
+		return
+	}
+	oracleIn = stdin
+	oracleOut = bufio.NewReaderSize(stdout, 1<<20)
+	banner, err := oracleOut.ReadString('\n')
+	if err != nil {
+		_ = cmd.Wait()
+		oracleErr = fmt.Errorf("node driver did not start (node needed on PATH): %v: %s", err, oracleStderr.String())
+		return
+	}
+	oracleBanner = strings.TrimSpace(banner)
+}
+
+// nodeRun runs one program (a function body) in the reference engine.
+func nodeRun(t testing.TB, src string) jsResult {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("oracle: %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	if _, err := fmt.Fprintf(oracleIn, "%d\n%s", len(src), src); err != nil {
+		_ = oracleCmd.Wait()
+		t.Fatalf("oracle write: %v\nstderr: %s", err, oracleStderr.String())
+	}
+	readLine := func() string {
+		line, err := oracleOut.ReadString('\n')
+		if err != nil {
+			_ = oracleCmd.Wait()
+			t.Fatalf("oracle died: %v\nprogram: %q\nstderr: %s", err, src, oracleStderr.String())
+		}
+		return strings.TrimSuffix(line, "\n")
+	}
+	status := readLine()
+	size, err := strconv.Atoi(readLine())
+	if err != nil {
+		t.Fatalf("oracle reply: bad length: %v", err)
+	}
+	buf := make([]byte, size)
+	if _, err := io.ReadFull(oracleOut, buf); err != nil {
+		t.Fatalf("oracle payload: %v", err)
+	}
+	return jsResult{Status: status, Payload: string(buf)}
+}
+
+// ---------------------------------------------------------------------------
+// goja side.
+
+// shortStack keeps the goja frames of a panic's stack.
+func shortStack(b []byte) string {
+	var keep []string
+	lines := strings.Split(string(b), "\n")
+	for i := 0; i+1 < len(lines); i++ {
+		if strings.Contains(lines[i], "goja.") && !strings.Contains(lines[i], "_test.") {
+			keep = append(keep, strings.TrimSpace(lines[i])+" "+strings.TrimSpace(lines[i+1]))
+		}
+		if len(keep) == 6 {
+			break
+		}
+	}
+	return strings.Join(keep, "\n")
+}
+
+// traceFile, when HEGEL_TRACE names a file, receives every program before
+// it runs in goja: the last one written is the one that killed the process
+// when it dies without a stack (out of memory).
+var traceFile = func() *os.File {
+	if p := os.Getenv("HEGEL_TRACE"); p != "" {
+		f, _ := os.Create(p)
+		return f
+	}
+	return nil
+}()
+
+func fmtErrName(name string) string { return `<Error "` + name + `">` }
+
+// gojaRun runs one program (a function body) in a fresh goja runtime, the
+// same way the driver does. A panic in goja gives the status "panic" with
+// the message and stack as the payload; a run that does not finish within
+// the deadline gives "timeout".
+func gojaRun(src string) (res jsResult) {
+	if traceFile != nil {
+		traceFile.Truncate(0)
+		traceFile.Seek(0, 0)
+		traceFile.WriteString(src)
+		traceFile.Sync()
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			res = jsResult{Status: "panic", Payload: fmt.Sprintf("%v\n%s", r, shortStack(debug.Stack()))}
+		}
+	}()
+	rt := goja.New()
+	if _, err := rt.RunScript("ser", serSrc); err != nil {
+		panic("serialiser: " + err.Error())
+	}
+	serFn, ok := goja.AssertFunction(rt.Get("__ser"))
+	if !ok {
+		panic("serialiser is not a function")
+	}
+	ser := func(v goja.Value) string {
+		out, err := serFn(goja.Undefined(), v)
+		if err != nil {
+			return "<unserialisable>"
+		}
+		return out.String()
+	}
+	prg, err := goja.Compile("snip", "(function () {\n"+src+"\n})()", false)
+	if err != nil {
+		name := "SyntaxError"
+		if _, ok := err.(*goja.CompilerReferenceError); ok {
+			name = "ReferenceError"
+		}
+		return jsResult{Status: "compile", Payload: fmtErrName(name)}
+	}
+	timer := time.AfterFunc(10*time.Second, func() { rt.Interrupt("timeout") })
+	v, err := rt.RunProgram(prg)
+	timer.Stop()
+	if err != nil {
+		switch e := err.(type) {
+		case *goja.InterruptedError:
+			return jsResult{Status: "timeout", Payload: ""}
+		case *goja.Exception:
+			return jsResult{Status: "throw", Payload: ser(e.Value())}
+		case *goja.StackOverflowError:
+			return jsResult{Status: "throw", Payload: ser(e.Value())}
+		}
+		return jsResult{Status: "throw", Payload: "<go error " + err.Error() + ">"}
+	}
+	return jsResult{Status: "ok", Payload: ser(v)}
+}
+
+func TestHegelOracleVersion(t *testing.T) {
+	const smoke = `var o = {b: 1, 2: "two", a: [1, , -0, 1e21, 0.1 + 0.2]}; o.self = o; return [o, "aé\"", null, undefined, new Date(0), /x+/gi, new Map([[1, {}]]), 10n ** 20n, function (a, b) {}]`
+	r := nodeRun(t, smoke)
+	t.Logf("%s", oracleBanner)
+	if !strings.Contains(oracleBanner, "node driver v") {
+		t.Fatalf("the oracle should be node: %s", oracleBanner)
+	}
+	want := `[{"2":"two","b":1,"a":[1,<hole>,-0,1e+21,0.30000000000000004],"self":<cycle>},"a\u00e9\u0022",null,undefined,<date 0>,<regexp "x+" "gi" 0>,<map 1=>{}>,100000000000000000000n,<function 2>]`
+	if r.Status != "ok" || r.Payload != want {
+		t.Fatalf("oracle smoke test: %+v", r)
+	}
+	g := gojaRun(smoke)
+	if g.Status != "ok" || g.Payload != want {
+		t.Fatalf("goja smoke test: %+v", g)
+	}
+	for _, p := range []struct{ src, status, payload string }{
+		{"return }", "compile", `<Error "SyntaxError">`},
+		{"throw new TypeError('x')", "throw", `<Error "TypeError">`},
+		{"return [][0].x", "throw", `<Error "TypeError">`},
+		{"throw 5", "throw", "5"},
+	} {
+		if r := nodeRun(t, p.src); r.Status != p.status || r.Payload != p.payload {
+			t.Errorf("node %q: %+v", p.src, r)
+		}
+		if g := gojaRun(p.src); g.Status != p.status || g.Payload != p.payload {
+			t.Errorf("goja %q: %+v", p.src, g)
+		}
+	}
+}
