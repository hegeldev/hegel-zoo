+// nonEmptyGlobal is re for match/replace: while goja/16 is open a regexp
+// that can match the empty string loses its g flag.
+// arrayFromMapper is a mapping function for Array.from.
+func arrayFromMapper() string {
+	if Known.arrayFromNativeMap { // goja/35: no native function over a possibly holey array-like
+		return "x => String(x)"
+	}
+	return "String"
+}
+
+// withGlobal is the regexp literal re with the g flag and without y.
+func withGlobal(re string) string {
+	i := strings.LastIndex(re, "/")
+	return re[:i+1] + strings.NewReplacer("g", "", "y", "").Replace(re[i+1:]) + "g"
+}
+
+func (g *gen) nonEmptyGlobal(re string) string {
+	if !Known.globalEmptyMatch || !g.lastReEmpty {
+		return re
+	}
+	i := strings.LastIndex(re, "/")
+	return re[:i+1] + strings.ReplaceAll(re[i+1:], "g", "")
+}
