diff --git a/hegel/hegel_changelog_test.go b/hegel/hegel_changelog_test.go
new file mode 100644
index 0000000..081195b
--- /dev/null
+++ b/hegel/hegel_changelog_test.go
@@ -0,0 +1,262 @@
+package hegel
+
+// pault.ag/go/debian/changelog against dpkg-parsechangelog.
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+	"pault.ag/go/debian/changelog"
+)
+
+var (
+	sources    = []string{"hello", "libfoo-bar", "g++-13", "a.b+c", "0ad", "Hello"}
+	clVersions = []string{"2.10-1", "1:1.0-1", "0.1~rc1-1ubuntu2", "3", "1.0+dfsg-1~bpo12+1", "2.10-1", "1.0-", "a1"}
+	dists      = []string{"unstable", "experimental", "stable-security", "UNRELEASED", "bookworm-backports", "unstable experimental", "unstable  sid", "trixie"}
+	// options: the clean shapes several times, then the ones dpkg warns about (not judged)
+	optionShapes = []string{"urgency=low", "urgency=medium", "urgency=high", "urgency=low", "urgency=low, binary-only=yes", "urgency=low,binary-only=yes", " urgency=low", "urgency=LOW", "urgency=low ", "binary-only=yes, urgency=low", "urgency=emergency", "urgency=critical", "urgency = low", "", "urgency=low; x=y", "urgency=low,foo=bar"}
+	changeLines  = []string{"  * Initial release.", "  * Fix the -- dashes.", "    continued line", "  [ Jane Doe ]", "  - dash item", "  * Closes: #12345", "  * (LP: #1)", "  * with trailing  ", "  * Second item.", "    (continued)", "  * Third; with semicolon", "  * Fourth: colon", "  * Update to 1.0-1", "  * a (b) c", "  * quotes \"x\"", "   "}
+	rareLines    = []string{"\t\t* two tabs", "\t  * tab and spaces", "# comment", "\t* tab item", " single space"}
+	maintainers  = []string{"Jane Doe <jane@example.org>", "A B <a@b>", "J. Random Hacker <jrh@debian.org>", "Debian Foo Team <team@lists.debian.org>", "X <x@y.z>"}
+	rareMaints   = []string{"Jane  Doe <jane@example.org>", "Jane Doe  <jane@example.org>", "Jane Doe"}
+	dateShapes   = []string{"Thu, 01 Jan 2026 10:00:00 +0000", "Mon, 02 Jan 2006 15:04:05 -0700", "Sun, 20 Sep 2026 04:05:06 +0200", "Thu,  01 Jan 2026 10:00:00 -0500", "Thu, 01 Jan 2026 10:00:00 +0000 ", "Thu, 01 Jan 2026 9:00:00 +0000", "Fri, 01 Jan 2026 10:00:00 +0000", "Wed, 31 Dec 2025 23:59:59 +1300"}
+	rareDates    = []string{"Thu, 1 Jan 2026 10:00:00 +0000", "01 Jan 2026 10:00:00 +0000", "thu, 01 jan 2026 10:00:00 +0000", "Thu, 01 January 2026 10:00:00 +0000"}
+)
+
+type entrySpec struct {
+	source, version, dist, options, maintainer, date string
+	headerSep, trailerSep                            string
+	changes                                          []string
+}
+
+func genEntry(tc hegel.TestCase) entrySpec {
+	sp := entrySpec{
+		source: pick(tc, sources...), version: pick(tc, clVersions...), dist: pick(tc, dists...),
+		options: pick(tc, optionShapes...), maintainer: pick(tc, maintainers...), date: pick(tc, dateShapes...),
+		headerSep: " ", trailerSep: "  ",
+	}
+	if chance(tc, 8) {
+		sp.maintainer = pick(tc, rareMaints...)
+	}
+	if chance(tc, 8) {
+		sp.date = pick(tc, rareDates...)
+	}
+	if chance(tc, 5) {
+		sp.headerSep = pick(tc, "  ", "")
+	}
+	if chance(tc, 5) {
+		sp.trailerSep = pick(tc, " ", "   ", "\t")
+	}
+	for k := n(tc, 0, 4); k > 0; k-- {
+		if chance(tc, 3) {
+			sp.changes = append(sp.changes, pick(tc, rareLines...))
+		} else {
+			sp.changes = append(sp.changes, pick(tc, changeLines...))
+		}
+		if chance(tc, 30) {
+			sp.changes = append(sp.changes, "")
+		}
+	}
+	return sp
+}
+
+func (e entrySpec) text(tc hegel.TestCase) string {
+	var b strings.Builder
+	b.WriteString(e.source + e.headerSep + "(" + e.version + ")" + pick(tc, " ", " ", "  ") + e.dist + pick(tc, ";", ";", ";", ";", " ;") + e.options + pick(tc, "", "", " ") + "\n")
+	b.WriteString(pick(tc, "\n", "\n", "\n", "", "\n\n"))
+	for _, l := range e.changes {
+		b.WriteString(l + "\n")
+	}
+	b.WriteString(pick(tc, "\n", "\n", "", " \n"))
+	b.WriteString(" -- " + e.maintainer + e.trailerSep + e.date + "\n")
+	return b.String()
+}
+
+type changelogSpec struct {
+	text    string
+	entries []entrySpec
+	wsSep   bool // a whitespace-only line between two entries
+}
+
+func genChangelog(tc hegel.TestCase) changelogSpec {
+	var sp changelogSpec
+	var b strings.Builder
+	for k := n(tc, 1, 3); k > 0; k-- {
+		e := genEntry(tc)
+		sp.entries = append(sp.entries, e)
+		b.WriteString(e.text(tc))
+		if k > 1 {
+			s := pick(tc, "\n", "\n", "\n\n", "", " \n")
+			if s == " \n" {
+				sp.wsSep = true
+			}
+			b.WriteString(s)
+		}
+	}
+	sp.text = b.String()
+	return sp
+}
+
+// dpkgChangelog is dpkg-parsechangelog's reading: one field map per entry, the warnings, and
+// whether it failed outright.
+type dpkgChangelog struct {
+	entries  []map[string]string
+	warnings []string
+	fatal    bool
+}
+
+func runDpkgParsechangelog(text string) dpkgChangelog {
+	f, err := os.CreateTemp("", "changelog-*")
+	if err != nil {
+		panic(err)
+	}
+	defer os.Remove(f.Name())
+	f.WriteString(text)
+	f.Close()
+	cmd := exec.Command("dpkg-parsechangelog", "-l", f.Name(), "--all", "--format", "rfc822")
+	var out, errb strings.Builder
+	cmd.Stdout, cmd.Stderr = &out, &errb
+	err = cmd.Run()
+	var r dpkgChangelog
+	for _, l := range strings.Split(errb.String(), "\n") {
+		if strings.TrimSpace(l) != "" {
+			r.warnings = append(r.warnings, l)
+		}
+	}
+	if err != nil {
+		r.fatal = true
+		return r
+	}
+	for _, para := range strings.Split(strings.TrimRight(out.String(), "\n"), "\n\n") {
+		fields := map[string]string{}
+		var last string
+		for _, l := range strings.Split(para, "\n") {
+			if strings.HasPrefix(l, " ") {
+				fields[last] += "\n" + l[1:]
+				continue
+			}
+			k, v, _ := strings.Cut(l, ": ")
+			if v == "" {
+				k = strings.TrimSuffix(l, ":")
+			}
+			last = k
+			fields[k] = v
+		}
+		if len(fields) > 0 {
+			r.entries = append(r.entries, fields)
+		}
+	}
+	return r
+}
+
+// entryView is an entry as both readers describe it.
+type entryView struct {
+	source, version, dist, urgency, maintainer string
+	timestamp                                  int64
+	changes                                    []string // the change lines, right-trimmed, blank ones dropped
+}
+
+func (e entryView) String() string {
+	return fmt.Sprintf("  %s (%s) %s; urgency=%s\n  -- %s @%d\n  changes %q\n", e.source, e.version, e.dist, e.urgency, e.maintainer, e.timestamp, e.changes)
+}
+
+func showEntries(es []entryView) string {
+	var b strings.Builder
+	for _, e := range es {
+		b.WriteString(e.String())
+	}
+	return b.String()
+}
+
+func changeLinesOf(lines []string, dropFirst bool) []string {
+	var out []string
+	for i, l := range lines {
+		if dropFirst && i == 0 {
+			continue
+		}
+		l = strings.TrimRight(l, " \t\r")
+		if l == "" || l == "." {
+			continue
+		}
+		out = append(out, l)
+	}
+	return out
+}
+
+func goEntries(text string) ([]entryView, error) {
+	es, err := changelog.Parse(strings.NewReader(text))
+	if err != nil {
+		return nil, err
+	}
+	var out []entryView
+	for _, e := range es {
+		v := entryView{source: e.Source, version: e.Version.String(), dist: strings.Join(strings.Fields(e.Target), " "),
+			urgency: strings.ToLower(e.Arguments["urgency"]), maintainer: e.ChangedBy, timestamp: e.When.Unix()} // dpkg lower-cases the urgency
+		v.changes = changeLinesOf(strings.Split(strings.TrimRight(e.Changelog, "\n"), "\n"), false)
+		out = append(out, v)
+	}
+	return out, nil
+}
+
+func dpkgEntries(r dpkgChangelog) []entryView {
+	var out []entryView
+	for _, f := range r.entries {
+		ts, _ := strconv.ParseInt(f["Timestamp"], 10, 64)
+		v := entryView{source: f["Source"], version: f["Version"], dist: strings.Join(strings.Fields(f["Distribution"]), " "),
+			urgency: strings.ToLower(f["Urgency"]), maintainer: f["Maintainer"], timestamp: ts}
+		// Changes: the header line, then the change lines each behind one space, blank ones as " ."
+		v.changes = changeLinesOf(strings.Split(strings.TrimPrefix(f["Changes"], "\n"), "\n"), true)
+		out = append(out, v)
+	}
+	return out
+}
+
+// TestHegelChangelogMatchesDpkg: a changelog of one to three entries (header lines in the
+// variations of spacing, distributions and options dpkg meets; change lines with bullets,
+// sections, blank lines, tabs and dashes; trailer lines with the date in the forms dpkg's
+// grammar allows) parsed by changelog.Parse gives dpkg-parsechangelog's entries (source,
+// version, distributions, urgency, maintainer, timestamp, change lines) whenever dpkg reads it
+// without a warning; when dpkg warns or fails, Parse may do as it likes.
+func TestHegelChangelogMatchesDpkg(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		sp := genChangelog(tc)
+		if id := knownChangelog(sp); id != "" {
+			count("known " + id)
+			return
+		}
+		r := runDpkgParsechangelog(sp.text)
+		got, err := goEntries(sp.text)
+		if r.fatal || len(r.warnings) > 0 {
+			if err != nil {
+				count("both complain")
+			} else {
+				count("lenient")
+			}
+			return
+		}
+		if len(r.entries) < len(sp.entries) {
+			count("dpkg stops early") // a later line taken for the old changelog format: the rest is kept unparsed, silently
+			return
+		}
+		for _, e := range sp.entries {
+			if !strings.Contains(e.options, "urgency=") {
+				count("no urgency") // dpkg reports "unknown", go-debian leaves the argument unset
+				return
+			}
+		}
+		if err != nil {
+			fail(ht, "changelog.Parse fails on\n%s: %v\ndpkg reads it cleanly:\n%s", sp.text, err, showEntries(dpkgEntries(r)))
+		}
+		want := dpkgEntries(r)
+		if showEntries(got) != showEntries(want) {
+			fail(ht, "changelog.Parse on\n%s:\n%sdpkg-parsechangelog:\n%s", sp.text, showEntries(got), showEntries(want))
+		}
+		count("parsed")
+	})
+}
diff --git a/hegel/hegel_control_test.go b/hegel/hegel_control_test.go
new file mode 100644
index 0000000..821945c
--- /dev/null
+++ b/hegel/hegel_control_test.go
@@ -0,0 +1,335 @@
+package hegel
+
+// pault.ag/go/debian/control's paragraph reader and writer against dpkg's Dpkg::Control::HashCore.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+	"pault.ag/go/debian/control"
+)
+
+var (
+	fieldNames  = []string{"Package", "Version", "Description", "Depends", "X-Foo", "Multi-Arch", "Homepage", "A", "B-C", "Installed-Size", "Section"}
+	fieldWords  = []string{"foo", "1.0-1", "a b c", "x: y", "tab\there", "trail  ", "  lead", "#hash", "-dash", "é", "very long value with many words in it", "."}
+	contLines   = []string{"more", "more", "more words here", "a:b", "-- dashes", "# not a comment inside", ".", "..", "...", "", " indented", "  two", "x  ", "\t"}
+	blankShapes = []string{"\n", "\n", "\n\n", "\n\n\n"}
+)
+
+// paragraphSpec is one generated paragraph: its text and the shapes the gates look at.
+type paragraphSpec struct {
+	text       string
+	dupKey     bool
+	junkKey    bool // a key dpkg refuses (spaces inside, a leading hyphen, empty)
+	wsLine     bool // a whitespace-only line inside the paragraph
+	blankCont  bool // a continuation line with nothing after the first character
+	comment    bool
+	crlf       bool
+	dotsOnly   bool // a continuation of two or more dots
+	tabCont    bool // a continuation line starting with a tab
+	spaceColon bool // whitespace before the colon
+	continued  bool // any continuation line
+}
+
+func genParagraph(tc hegel.TestCase) paragraphSpec {
+	var sp paragraphSpec
+	var b strings.Builder
+	seen := map[string]bool{}
+	for k := n(tc, 1, 5); k > 0; k-- {
+		key := pick(tc, fieldNames...)
+		for tries := 0; seen[key] && tries < 5; tries++ {
+			key = pick(tc, fieldNames...)
+		}
+		if chance(tc, 3) {
+			key = pick(tc, "Key With Space", "-Dash", "", "Ke:y")
+			sp.junkKey = true
+			if key == "" {
+				sp.continued = true // the line starts with whitespace: a continuation line to both readers
+			}
+		}
+		if seen[key] {
+			if !chance(tc, 30) {
+				continue
+			}
+			sp.dupKey = true
+		}
+		seen[key] = true
+		if chance(tc, 5) {
+			b.WriteString("# a comment line\n")
+			sp.comment = true
+		}
+		colon := ":"
+		if chance(tc, 4) {
+			colon = pick(tc, " :", "\t:")
+			sp.spaceColon = true
+		}
+		b.WriteString(key + colon + pick(tc, " ", " ", "", "  ", "\t") + pick(tc, fieldWords...) + pick(tc, "", "", " ", "\t"))
+		b.WriteString("\n")
+		for m := pick(tc, 0, 0, 0, 0, 0, 1, 1, 2, 3); m > 0; m-- {
+			sp.continued = true
+			ind := pick(tc, " ", " ", "  ", "\t")
+			line := pick(tc, contLines...)
+			if ind == "\t" {
+				sp.tabCont = true
+			}
+			if strings.TrimSpace(line) == "" {
+				sp.blankCont = true
+				if strings.TrimSpace(ind+line) == "" {
+					sp.wsLine = true
+				}
+			}
+			if strings.Trim(line, ".") == "" && len(line) > 1 {
+				sp.dotsOnly = true
+			}
+			if chance(tc, 4) {
+				b.WriteString("# comment\n")
+				sp.comment = true
+			}
+			b.WriteString(ind + line + "\n")
+		}
+	}
+	sp.text = b.String()
+	if chance(tc, 5) {
+		sp.text = strings.ReplaceAll(sp.text, "\n", "\r\n")
+		sp.crlf = true
+	}
+	return sp
+}
+
+type controlSpec struct {
+	text       string
+	paragraphs []paragraphSpec
+	noFinalNL  bool
+	leading    string
+}
+
+func genControl(tc hegel.TestCase) controlSpec {
+	var sp controlSpec
+	var b strings.Builder
+	if chance(tc, 10) {
+		sp.leading = pick(tc, blankShapes...)
+		b.WriteString(sp.leading)
+	}
+	for k := n(tc, 1, 3); k > 0; k-- {
+		p := genParagraph(tc)
+		sp.paragraphs = append(sp.paragraphs, p)
+		b.WriteString(p.text)
+		if k > 1 {
+			b.WriteString(pick(tc, blankShapes...))
+		}
+	}
+	sp.text = b.String()
+	if chance(tc, 10) {
+		sp.text = strings.TrimRight(sp.text, "\r\n")
+		sp.noFinalNL = true
+	}
+	if chance(tc, 10) {
+		sp.text += pick(tc, blankShapes...)
+	}
+	return sp
+}
+
+// showParagraphs renders both readings alike: one "key=value" line per field, in order.
+func showParagraphs(paras [][][2]string) string {
+	var b strings.Builder
+	for _, p := range paras {
+		for _, kv := range p {
+			b.WriteString(fmt.Sprintf("  %s=%q\n", kv[0], kv[1]))
+		}
+		b.WriteString(" --\n")
+	}
+	return b.String()
+}
+
+func goParagraphs(text string) ([][][2]string, error) {
+	r, err := control.NewParagraphReader(strings.NewReader(text), nil)
+	if err != nil {
+		return nil, err
+	}
+	all, err := r.All()
+	if err != nil {
+		return nil, err
+	}
+	var out [][][2]string
+	for _, p := range all {
+		var kvs [][2]string
+		for _, k := range p.Order {
+			kvs = append(kvs, [2]string{k, p.Values[k]})
+		}
+		out = append(out, kvs)
+	}
+	return out, nil
+}
+
+type perlControl struct {
+	Ok         bool
+	Error      string
+	Paragraphs [][][2]string
+	Warnings   []string
+}
+
+func dpkgParagraphs(text string) perlControl {
+	var pc perlControl
+	ask(&pc, "C", text)
+	return pc
+}
+
+// TestHegelParagraphsMatchDpkg: a control file (one to three paragraphs; keys from a list; values
+// with odd spacing, tabs and trailing whitespace; continuation lines indented with spaces or a tab,
+// with dot lines, empty lines and indented text; comment lines; blank and whitespace-only lines
+// between paragraphs; CRLF; no final newline) read by control.ParagraphReader gives dpkg's
+// paragraphs: the same fields in the same order with the same values, or both refuse it.
+func TestHegelParagraphsMatchDpkg(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		sp := genControl(tc)
+		for _, p := range sp.paragraphs {
+			if p.wsLine {
+				count("whitespace-only line") // a paragraph separator to dpkg, a continuation to go-debian (policy allows both)
+				return
+			}
+		}
+		if id := knownControl(sp); id != "" {
+			count("known " + id)
+			return
+		}
+		got, err := goParagraphs(sp.text)
+		pc := dpkgParagraphs(sp.text)
+		if err != nil {
+			if pc.Ok {
+				fail(ht, "ParagraphReader fails on %q: %v\ndpkg reads:\n%s", sp.text, err, showParagraphs(pc.Paragraphs))
+			}
+			count("both reject")
+			return
+		}
+		if !pc.Ok {
+			for _, p := range sp.paragraphs {
+				if p.dupKey || p.junkKey {
+					count("lenient (dpkg refuses the key)")
+					return
+				}
+			}
+			fail(ht, "ParagraphReader reads %q as\n%sdpkg refuses it: %s", sp.text, showParagraphs(got), strings.TrimSpace(pc.Error))
+		}
+		if showParagraphs(got) != showParagraphs(pc.Paragraphs) {
+			fail(ht, "ParagraphReader on %q:\n%sdpkg:\n%s", sp.text, showParagraphs(got), showParagraphs(pc.Paragraphs))
+		}
+		count("parsed")
+	})
+}
+
+// valueSpec is a generated field value for the writer.
+type valueSpec struct {
+	value      string
+	lines      []string
+	trailingNL bool
+	leadingNL  bool
+	dotLine    bool // a line that is only dots
+	blankLine  bool // an empty line, or one of whitespace only
+	wsLine     bool // a line of whitespace only (not empty)
+	wsEnd      bool // a line ending in whitespace
+}
+
+func genValue(tc hegel.TestCase) valueSpec {
+	var sp valueSpec
+	for k := pick(tc, 1, 1, 1, 2, 3, 4); k > 0; k-- {
+		sp.lines = append(sp.lines, pick(tc, "a", "b c", "x y z", "#h", "-d", "a", "b c", "x y z", "", ".", "..", " lead", "trail ", "\t", "  "))
+	}
+	for _, l := range sp.lines {
+		if strings.Trim(l, ".") == "" && l != "" {
+			sp.dotLine = true
+		}
+		if strings.TrimSpace(l) == "" {
+			sp.blankLine = true
+			if l != "" {
+				sp.wsLine = true
+			}
+		}
+		if l != strings.TrimRight(l, " \t") {
+			sp.wsEnd = true
+		}
+	}
+	sp.value = strings.Join(sp.lines, "\n")
+	if chance(tc, 15) {
+		sp.value += "\n"
+		sp.trailingNL = true
+	}
+	if chance(tc, 10) {
+		sp.value = "\n" + sp.value
+		sp.leadingNL = true
+	}
+	return sp
+}
+
+// TestHegelParagraphWriteToMatchesDpkg: a Paragraph built with Set (values of one to four lines,
+// with empty, dot-only, whitespace and indented lines, a leading or trailing newline) is written
+// by WriteTo as Dpkg::Control::HashCore writes the same fields, and reads back with
+// ParagraphReader as the paragraph it was.
+func TestHegelParagraphWriteToMatchesDpkg(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		p := control.Paragraph{Values: map[string]string{}, Order: []string{}}
+		var fields [][2]string
+		var specs []valueSpec
+		seen := map[string]bool{}
+		for k := n(tc, 1, 4); k > 0; k-- {
+			key := pick(tc, fieldNames...)
+			if seen[key] {
+				continue
+			}
+			seen[key] = true
+			v := genValue(tc)
+			specs = append(specs, v)
+			p.Set(key, v.value)
+			fields = append(fields, [2]string{key, v.value})
+		}
+		var buf bytes.Buffer
+		if err := p.WriteTo(&buf); err != nil {
+			fail(ht, "WriteTo: %v", err)
+		}
+		got := buf.String()
+		if id := knownWrite(specs); id != "" {
+			count("known " + id)
+		} else {
+			js, _ := json.Marshal(fields)
+			var pw struct{ Output string }
+			ask(&pw, "W", string(js))
+			if trimLines(got) != trimLines(pw.Output) {
+				fail(ht, "WriteTo of %q:\n%q\ndpkg writes:\n%q", fields, got, pw.Output)
+			}
+		}
+		for _, v := range specs {
+			if v.wsEnd || strings.HasPrefix(v.value, " ") || strings.HasPrefix(v.value, "\t") {
+				count("insignificant whitespace") // trailing whitespace and a first line's leading whitespace do not survive the format
+				return
+			}
+		}
+		if id := knownReadBack(specs); id != "" {
+			count("known " + id)
+			return
+		}
+		back, err := goParagraphs(got)
+		if err != nil {
+			fail(ht, "WriteTo wrote %q, which ParagraphReader refuses: %v", got, err)
+		}
+		want := [][][2]string{fields}
+		if showParagraphs(back) != showParagraphs(want) {
+			fail(ht, "WriteTo wrote %q, which reads back as\n%swas\n%s", got, showParagraphs(back), showParagraphs(want))
+		}
+		count("ok")
+	})
+}
+
+// trimLines drops trailing whitespace from every line: dpkg writes "Key:" for an empty value
+// where go-debian writes "Key: ", which every reader treats alike.
+func trimLines(s string) string {
+	lines := strings.Split(s, "\n")
+	for i, l := range lines {
+		lines[i] = strings.TrimRight(l, " \t")
+	}
+	return strings.Join(lines, "\n")
+}
diff --git a/hegel/hegel_dependencies_test.go b/hegel/hegel_dependencies_test.go
new file mode 100644
index 0000000..043202c
--- /dev/null
+++ b/hegel/hegel_dependencies_test.go
@@ -0,0 +1,557 @@
+package hegel
+
+// The dependency and architecture records and their generators (hegel_dependency_model_test.go
+// has the models and the replicas, hegel_dependency_test.go the wide properties,
+// hegel_dependency_shapes_test.go the narrow ones). A relationship field is drawn as its
+// possibilities, each as its parts (the name, the qualifier, the version relation, the
+// architecture list, the restriction lists, and the whitespace between them, drawn
+// separately so that the shapes of the recorded bugs are parts) and rendered by text(); the
+// record carries the oracle's answers (depOracle: Dpkg::Deps's reading of the text and of
+// the texts the model writes), asked once per text. Every weight below is nominal; the figure
+// beside it is the realised rate the probe measured over 3000 cases (HEGEL_SEED=7), in
+// percent of the draws of that table (the engine's dice are not even: hegel_idioms_test.go).
+
+import (
+	"fmt"
+	"strings"
+	"sync"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the oracle's
+// answers
+
+// perlDeps is Dpkg::Deps's reading of a relationship field (the "D" command of the oracle:
+// deps_parse with build_dep, so that architecture lists and build profiles are read).
+type perlDeps struct {
+	Ok      bool
+	Output  string
+	Error   string
+	Entries [][]struct {
+		Package      string
+		Archqual     *string
+		Relation     *string
+		Version      *string
+		Arches       []string
+		Restrictions [][]string
+	}
+	Warnings []string
+}
+
+// depReading is one text's reading by dpkg: refused, or the possibilities as possView.
+type depReading struct {
+	ok   bool
+	rels [][]possView
+}
+
+// depOracle memoises dpkg's readings of the texts of one case (the text, and the texts the
+// model writes back).
+type depOracle struct {
+	readings map[string]depReading
+}
+
+func newDepOracle() *depOracle { return &depOracle{readings: map[string]depReading{}} }
+
+func (o *depOracle) read(text string) depReading {
+	if r, ok := o.readings[text]; ok {
+		return r
+	}
+	var pd perlDeps
+	ask(&pd, "D", text)
+	r := depReading{ok: pd.Ok}
+	if pd.Ok {
+		for _, rel := range pd.Entries {
+			var ps []possView
+			for _, p := range rel {
+				v := possView{name: p.Package, arches: p.Arches, restrictions: p.Restrictions}
+				if p.Archqual != nil {
+					v.archqual = *p.Archqual
+				}
+				if p.Relation != nil {
+					v.op = *p.Relation
+				}
+				if p.Version != nil {
+					v.version = *p.Version
+				}
+				ps = append(ps, v)
+			}
+			r.rels = append(r.rels, ps)
+		}
+	}
+	o.readings[text] = r
+	return r
+}
+
+// perlArch is Dpkg::Arch's view of a name (the "A" command): its tuple as a real
+// architecture, its tuple as a wildcard, its canonical name, and whether an alias is it
+// (debarch_is).
+type perlArch struct {
+	Tuple         *string `json:"tuple"`
+	WildcardTuple *string `json:"wildcard_tuple"`
+	Canonical     *string `json:"canonical"`
+	IsWildcard    int     `json:"is_wildcard"`
+	Is            int     `json:"is"`
+}
+
+// perlConcerned is debarch_is_concerned of a real architecture by a one-name list (the "M"
+// command): whether the list parses, and the answer.
+type perlConcerned struct {
+	Ok        bool
+	Concerned int
+}
+
+// The architecture answers are memoised across cases (the names are a small table).
+var (
+	archMu        sync.Mutex
+	archViews     = map[string]perlArch{}
+	archIs        = map[[2]string]bool{}
+	archConcerned = map[[2]string]perlConcerned{}
+)
+
+func archView(name string) perlArch {
+	archMu.Lock()
+	defer archMu.Unlock()
+	if v, ok := archViews[name]; ok {
+		return v
+	}
+	var v perlArch
+	ask(&v, "A", name)
+	archViews[name] = v
+	return v
+}
+
+func archIsAlias(real, alias string) bool {
+	archMu.Lock()
+	defer archMu.Unlock()
+	key := [2]string{real, alias}
+	if v, ok := archIs[key]; ok {
+		return v
+	}
+	var v perlArch
+	ask(&v, "A", real, alias)
+	archIs[key] = v.Is == 1
+	return v.Is == 1
+}
+
+func archConcernedBy(real, list string) perlConcerned {
+	archMu.Lock()
+	defer archMu.Unlock()
+	key := [2]string{real, list}
+	if v, ok := archConcerned[key]; ok {
+		return v
+	}
+	var v perlConcerned
+	ask(&v, "M", real, list)
+	archConcerned[key] = v
+	return v
+}
+
+// --------------------------------------------------------------------------- the
+// dependency cases
+
+// possibility is one generated possibility: its parts and the whitespace between them. The
+// text is name, ":" qual qualSep, verSep "(" opPad op opSep number verPad ")", listSep "["
+// listPad arches archPad "]" and stageSep stages, each group only when present.
+type possibility struct {
+	name     string
+	substvar bool // the name is written ${name}
+	junkName bool // a name dpkg refuses (go-debian validates no names)
+	qual     string
+	qualSep  string
+	hasVer   bool
+	verSep   string
+	opPad    string
+	op       string
+	opSep    string
+	number   string
+	verPad   string
+	arches   []string
+	not      bool // every name negated
+	mixed    bool // the first name's negation flipped (refused by both, for different reasons)
+	listSep  string
+	listPad  string
+	archSep  string
+	archPad  string
+	stages   string // the restriction lists as written, "" for none
+	stageSep string
+}
+
+func (p possibility) text() string {
+	var b strings.Builder
+	if p.substvar {
+		b.WriteString("${" + p.name + "}")
+	} else {
+		b.WriteString(p.name)
+	}
+	if p.qual != "" {
+		b.WriteString(":" + p.qual + p.qualSep)
+	}
+	if p.hasVer {
+		b.WriteString(p.verSep + "(" + p.opPad + p.op + p.opSep + p.number + p.verPad + ")")
+	}
+	if len(p.arches) > 0 {
+		names := make([]string, len(p.arches))
+		for i, a := range p.arches {
+			not := p.not
+			if i == 0 && p.mixed {
+				not = !not
+			}
+			if not {
+				a = "!" + a
+			}
+			names[i] = a
+		}
+		b.WriteString(p.listSep + "[" + p.listPad + strings.Join(names, p.archSep) + p.archPad + "]")
+	}
+	if p.stages != "" {
+		b.WriteString(p.stageSep + p.stages)
+	}
+	return b.String()
+}
+
+// GoString lists the parts that are set.
+func (p possibility) GoString() string {
+	var parts []string
+	add := func(name, v string) {
+		if v != "" {
+			parts = append(parts, fmt.Sprintf("%s: %q", name, v))
+		}
+	}
+	if p.substvar {
+		parts = append(parts, "substvar")
+	}
+	if p.junkName {
+		parts = append(parts, "junkName")
+	}
+	add("qual", p.qual)
+	add("qualSep", p.qualSep)
+	if p.hasVer {
+		add("verSep", p.verSep)
+		add("opPad", p.opPad)
+		add("op", p.op)
+		add("opSep", p.opSep)
+		add("number", p.number)
+		add("verPad", p.verPad)
+	}
+	if len(p.arches) > 0 {
+		parts = append(parts, fmt.Sprintf("arches: %q", p.arches))
+		if p.not {
+			parts = append(parts, "not")
+		}
+		if p.mixed {
+			parts = append(parts, "mixed")
+		}
+		add("listSep", p.listSep)
+		add("listPad", p.listPad)
+		add("archSep", p.archSep)
+		add("archPad", p.archPad)
+	}
+	add("stages", p.stages)
+	if p.stages != "" {
+		add("stageSep", p.stageSep)
+	}
+	return fmt.Sprintf("{%q %s}", p.name, strings.Join(parts, " "))
+}
+
+// dependencyCase is one relationship field: relations of possibilities, the separators, a
+// trailing comma and the padding.
+type dependencyCase struct {
+	rels     [][]possibility
+	possSep  string
+	relSep   string
+	trailing string
+	lead     string
+	trail    string
+	o        *depOracle
+}
+
+func (c dependencyCase) text() string {
+	var rels []string
+	for _, r := range c.rels {
+		var ps []string
+		for _, p := range r {
+			ps = append(ps, p.text())
+		}
+		rels = append(rels, strings.Join(ps, c.possSep))
+	}
+	return c.lead + strings.Join(rels, c.relSep) + c.trailing + c.trail
+}
+
+func (c dependencyCase) GoString() string {
+	var rels []string
+	for _, r := range c.rels {
+		var ps []string
+		for _, p := range r {
+			ps = append(ps, p.GoString())
+		}
+		rels = append(rels, "["+strings.Join(ps, " ")+"]")
+	}
+	return fmt.Sprintf("dependencyCase(%q){rels: [%s], possSep: %q, relSep: %q, trailing: %q, pad: %q/%q}",
+		c.text(), strings.Join(rels, " "), c.possSep, c.relSep, c.trailing, c.lead, c.trail)
+}
+
+// possibilities walks the possibilities of the case.
+func (c dependencyCase) possibilities() []possibility {
+	var out []possibility
+	for _, r := range c.rels {
+		out = append(out, r...)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the
+// dependency generators
+
+// depGens is one flavour of the dependency generators: judged leaves out what the parse
+// property does not judge (names dpkg refuses, substvars, the relations and version texts
+// dpkg refuses in ways that depend on the spacing, a mixed negation); plain leaves out the
+// shapes of the recorded bugs (the alternative of weight zero: hzUnless), for the surroundings
+// of the narrow properties and for HEGEL_NO_KNOWN=1. The shape of go-debian/19 (a possibility
+// with both a version relation and an architecture list, whose String() dpkg refuses) is a
+// composition of the record: the plain flavour draws the list only when there is no version
+// relation (generator shape, not a filter: 29 percent of the parse cases have it), so that
+// under HEGEL_NO_KNOWN=1 no case has it; the round trip does not reach it (go-debian's parser
+// reads either order) but loses it there with the rest of the plain exclusions.
+type depGens struct {
+	possibilities hegel.Generator[possibility]
+	dependencies  hegel.Generator[dependencyCase]
+}
+
+// listArchNames is the architecture names of a list as dpkg writes them (canonical real
+// names; wildcards in their shortest spelling): go-debian's String() of a wildcard it pads
+// with base/gnu is a different name (go-debian/3), the five such are never drawn plain.
+var listArchNames = []string{"amd64", "i386", "arm64", "armhf", "armel", "kfreebsd-amd64", "hurd-i386", "musl-linux-armhf", "x32", "mipsel", "ppc64el", "s390x", "riscv64", "loong64", "sparc64", "alpha", "hppa", "m68k", "sh4", "ia64", "powerpc", "mips64el", "uclibc-linux-arm", "foo", "any", "all", "any-any", "linux-any", "any-amd64", "gnu-linux-any", "kfreebsd-any", "musl-any-any"}
+
+func newDepGens(judged, plain bool) depGens {
+	u := func(off bool, w int) int { return hzUnless(off, w) }
+	var g depGens
+
+	// The names: Policy's, or ones dpkg refuses (not judged), or a substvar (round trip only).
+	names := dieOver([]int{
+		8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, // the eleven names, nominal 8 each (judged: 9.1): realise 7.6 to 9.9 judged, 7.1 to 8.5 in the round trip
+		u(judged, 1), u(judged, 1), u(judged, 1), u(judged, 1), u(judged, 1), u(judged, 1), u(judged, 1), u(judged, 1), // the junk, nominal 1 each (round trip only): realise 0.7 to 1.5
+		u(judged || plain, 2), u(judged || plain, 2), // the substvars, nominal 2 each (round trip only): realise 2.1 and 2.2
+	}, "libc6", "foo", "bar-baz", "g++", "python3.12", "a.b+c", "x", "0ad", "libfoo-dev", "Foo", "perl",
+		"foo_bar", "-foo", "foo!", ".x", "+y", "foo bar", "fo:o", "",
+		"misc:Depends", "shlibs:Depends")
+	junkNames := map[string]bool{"foo_bar": true, "-foo": true, "foo!": true, ".x": true, "+y": true, "foo bar": true, "fo:o": true, "": true}
+	substvars := map[string]bool{"misc:Depends": true, "shlibs:Depends": true}
+
+	// The qualifier: linux-any is padded with base/gnu (go-debian/3).
+	quals := dieOver([]int{
+		4,           // "any" nominal 29: realises 30
+		2,           // "native" nominal 14: realises 15
+		3,           // "amd64" nominal 21: realises 22
+		2,           // "i386" nominal 14: realises 13
+		1,           // "all" nominal 7: realises 6
+		u(plain, 2), // "linux-any" nominal 14: realises 14
+	}, "any", "native", "amd64", "i386", "all", "linux-any")
+
+	// The whitespace after the qualifier: a tab or a newline is taken into it (go-debian/7).
+	qualSeps := dieOver([]int{
+		6,           // " " nominal 55: realises 55
+		2,           // "" nominal 18: realises 18
+		1,           // "  " nominal 9: realises 12
+		u(plain, 1), // "\t" nominal 9: realises 9
+		u(plain, 1), // "\n " nominal 9: realises 6
