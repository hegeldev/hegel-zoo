+	verSeps := dieOver([]int{6, 2, 1, 1, 1}, " ", "", "  ", "\t", "\n ") // nominal 55/18/9/9/9: realises 55/17/10/10/8
+	opPads := dieOver([]int{6, 2, 1}, "", " ", "  ")                     // nominal 67/22/11: realises 68/22/10
+	opSeps := dieOver([]int{6, 2, 1}, " ", "", "  ")                     // nominal 67/22/11: realises 68/20/12
