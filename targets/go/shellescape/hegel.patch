+// ---------------------------------------------------------------- examples
+
+func TestHegelExamples(t *testing.T) {
+	for _, tt := range []struct{ in, want string }{
+		{"", "''"},
+		{"abc", "abc"},
+		{"a b", "'a b'"},
+		{"it's", `'it'"'"'s'`},
+		{"ä", "'ä'"},
+	} {
+		if got := shellescape.Quote(tt.in); got != tt.want {
+			t.Errorf("Quote(%q) = %q, want %q", tt.in, got, tt.want)
+		}
+	}
+	if got := shellescape.QuoteCommand([]string{"ls", "-l", "my file"}); got != "ls -l 'my file'" {
+		t.Errorf("QuoteCommand = %q", got)
+	}
+}
