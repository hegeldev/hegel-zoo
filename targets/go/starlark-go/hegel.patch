+package hegel
+
+// The program generator: typed programs in the subset of Starlark that is
+// also Python 3, with the same meaning by the Starlark specification.
+//
+// Kept out, because the two languages differ by design: bools as numbers,
+// chained comparisons, chained assignment, iterating strings, non-ASCII
+// strings (Starlark indexes bytes), string %-formatting with widths or
+// flags, str.format specifiers, **, shifts by 512 or more, int() of strings
+// with spaces or underscores, hash(), type(), set, lambda, recursion,
+// del, slice assignment, popitem (order unspecified), splitlines on \r,
+// Python-only builtins and methods (sum, sort, reverse, ...). Loops are
+// bounded (ranges, lists, a counter for while) and values assigned inside a
+// loop may reference one loop-carried value at most and never multiply it,
+// so no program grows exponentially in either interpreter.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Types.
+
+type kind int
+
+const (
+	kInt kind = iota
+	kStr
+	kBool
+	kNone
+	kList
+	kDict
+	kTuple
+)
+
+type ty struct {
+	k     kind
+	elem  *ty  // list element, dict value
+	key   *ty  // dict key
+	elems []ty // tuple elements
+}
+
+var (
+	tInt  = ty{k: kInt}
+	tStr  = ty{k: kStr}
+	tBool = ty{k: kBool}
+	tNone = ty{k: kNone}
+)
+
+func listOf(e ty) ty      { return ty{k: kList, elem: &e} }
+func dictOf(k, v ty) ty   { return ty{k: kDict, key: &k, elem: &v} }
+func tupleOf(es ...ty) ty { return ty{k: kTuple, elems: es} }
+
+func (t ty) String() string {
+	switch t.k {
+	case kInt:
+		return "int"
+	case kStr:
+		return "str"
+	case kBool:
+		return "bool"
+	case kNone:
+		return "None"
+	case kList:
+		return "list[" + t.elem.String() + "]"
+	case kDict:
+		return "dict[" + t.key.String() + "," + t.elem.String() + "]"
+	case kTuple:
+		parts := make([]string, len(t.elems))
+		for i, e := range t.elems {
+			parts[i] = e.String()
+		}
+		return "tuple[" + strings.Join(parts, ",") + "]"
+	}
+	return "?"
+}
+
+func (t ty) eq(u ty) bool { return t.String() == u.String() }
+
+// ordered reports whether values of the type can be compared with <.
+func (t ty) ordered() bool {
+	switch t.k {
+	case kInt, kStr, kBool:
+		return true
+	case kList:
+		return t.elem.ordered()
+	case kTuple:
+		for _, e := range t.elems {
+			if !e.ordered() {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+// hashable reports whether values of the type can be dict keys.
+func (t ty) hashable() bool { return t.k == kInt || t.k == kStr }
+
+// growable reports whether values of the type can grow without bound.
+func (t ty) growable() bool { return t.k != kBool && t.k != kNone }
+
+// ---------------------------------------------------------------------------
+// The generator.
+
+type variable struct {
+	name    string
+	t       ty
+	depth   int  // loop depth at declaration
+	mutable bool // may be assigned and mutated (not a parameter, not a loop counter)
+	taint   bool // derived from a loop-carried value inside the current loop nest
+	frozen  bool // being iterated over: no mutation
+}
+
+type fn struct {
+	name   string
+	params []ty
+	ret    ty
+}
+
+type gen struct {
+	tc        hegel.TestCase
+	vars      []variable
+	nvar      int
+	funcs     []fn
+	loopDepth int
+	lines     []string
+	indent    int
+	stmts     int // remaining statement budget
+	grow      int // 0: free; 1: at most one loop-carried reference, no multiplication; 2: none
+	taint     int // loop-carried references in the expression being generated
+	scopeBase int // vars[:scopeBase] are read-only (globals seen from a function body)
+	inFunc    bool
+	retTy     ty
+	noMutate  int // > 0 while generating a body that iterates a variable directly
+}
+
+func (g *gen) n(lo, hi int) int    { return n(g.tc, lo, hi) }
+func (g *gen) chance(pct int) bool { return chance(g.tc, pct) }
+
+func (g *gen) emit(format string, args ...any) {
+	g.lines = append(g.lines, strings.Repeat("    ", g.indent)+fmt.Sprintf(format, args...))
+}
+
+func (g *gen) newName(prefix string) string {
+	g.nvar++
+	return fmt.Sprintf("%s%d", prefix, g.nvar)
+}
+
+// declare adds a variable to the scope.
+func (g *gen) declare(prefix string, t ty, mutable, taint bool) *variable {
+	g.vars = append(g.vars, variable{name: g.newName(prefix), t: t, depth: g.loopDepth, mutable: mutable, taint: taint})
+	return &g.vars[len(g.vars)-1]
+}
+
+// genProgram builds a program.
+func genProgram(tc hegel.TestCase) string {
+	g := &gen{tc: tc}
+	g.stmts = g.n(4, 40)
+	for i := g.n(1, 5); i > 0; i-- {
+		g.stmtNewVar()
+	}
+	for i := g.n(0, 2); i > 0; i-- {
+		g.funcDef()
+	}
+	for g.stmts > 0 {
+		g.stmt()
+	}
+	if g.chance(80) {
+		g.stmtPrint()
+	}
+	return strings.Join(g.lines, "\n") + "\n"
+}
+
+// ---------------------------------------------------------------------------
+// Types and literals.
+
+func (g *gen) randType(depth int) ty {
+	w := g.n(1, 100)
+	switch {
+	case w <= 32:
+		return tInt
+	case w <= 62:
+		return tStr
+	case w <= 72:
+		return tBool
+	case w <= 90 && depth < 2:
+		return listOf(g.randType(depth + 1))
+	case w <= 97 && depth < 2:
+		return dictOf(g.keyType(), g.randType(depth+1))
+	case depth < 2:
+		k := g.n(1, 3)
+		es := make([]ty, k)
+		for i := range es {
+			es[i] = g.scalarType()
+		}
+		return tupleOf(es...)
+	}
+	return tInt
+}
+
+func (g *gen) scalarType() ty { return pick(g.tc, tInt, tStr, tStr, tInt, tBool) }
+func (g *gen) keyType() ty    { return pick(g.tc, tInt, tStr, tStr) }
+
+const strPool = "abcxyzABZ019 ,.;:-_!?/%{}()[]<>'\"\\\n\t"
+
+// randStr draws a string from the pool.
+func (g *gen) randStr(maxLen int) string {
+	k := g.n(0, maxLen)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		if g.chance(15) {
+			b.WriteString(pick(g.tc, "ab", "Ab", "a b", "  ", "xyz", "a\nb", "\t", "hello", "World", "12", "0", "-1", "0x1f", "1_0", "0b11", "..", "--", "aa", "AA", "Hello World", "hELLO wORLD"))
+			continue
+		}
+		b.WriteByte(strPool[g.n(0, len(strPool)-1)])
+	}
+	return b.String()
+}
+
+// strLit spells a string literal.
+func (g *gen) strLit(s string) string {
+	if g.chance(10) && !strings.ContainsAny(s, "\\\"'\n") {
+		return "r\"" + s + "\""
+	}
+	if g.chance(8) && !strings.Contains(s, "\"") && !strings.Contains(s, "\\") && !strings.HasSuffix(s, "\"") {
+		return "\"\"\"" + s + "\"\"\""
+	}
+	q := byte('"')
+	if g.chance(20) {
+		q = '\''
+	}
+	hex := g.chance(15)
+	var b strings.Builder
+	b.WriteByte(q)
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == '\\':
+			b.WriteString("\\\\")
+		case c == q:
+			b.WriteByte('\\')
+			b.WriteByte(c)
+		case c == '\n':
+			b.WriteString("\\n")
+		case c == '\t':
+			b.WriteString("\\t")
+		case hex && g.chance(30):
+			b.WriteString(pick(g.tc, fmt.Sprintf("\\x%02x", c), fmt.Sprintf("\\%03o", c), fmt.Sprintf("\\u%04x", c)))
+		default:
+			b.WriteByte(c)
+		}
+	}
+	b.WriteByte(q)
+	return b.String()
+}
+
+// intLit spells an integer literal (negative ones parenthesised).
+func (g *gen) intLit() string {
+	var v int64
+	switch g.n(1, 10) {
+	case 1, 2, 3:
+		v = int64(g.n(0, 3))
+	case 4, 5:
+		v = int64(g.n(-20, 20))
+	case 6, 7:
+		v = int64(g.n(-1000, 1000))
+	case 8:
+		v = int64(g.n(-1<<31, 1<<31-1))
+	case 9:
+		v = int64(g.n(-1<<62, 1<<62-1))
+	default:
+		// wider than 64 bits
+		digits := strconv.FormatInt(int64(g.n(1, 1<<62)), 10) + strconv.FormatInt(int64(g.n(1<<40, 1<<62)), 10)
+		if g.chance(30) {
+			return "(-" + digits + ")"
+		}
+		return digits
+	}
+	if v < 0 {
+		return "(-" + strconv.FormatInt(-v, 10) + ")"
+	}
+	if v > 0 && g.chance(15) {
+		switch g.n(1, 3) {
+		case 1:
+			return "0x" + strconv.FormatInt(v, 16)
+		case 2:
+			return "0o" + strconv.FormatInt(v, 8)
+		default:
+			return "0b" + strconv.FormatInt(v, 2)
+		}
+	}
+	return strconv.FormatInt(v, 10)
+}
+
+// literal spells a literal value of the type.
+func (g *gen) literal(t ty, depth int) string {
+	switch t.k {
+	case kInt:
+		return g.intLit()
+	case kStr:
+		return g.strLit(g.randStr(8))
+	case kBool:
+		return pick(g.tc, "True", "False")
+	case kNone:
+		return "None"
+	case kList:
+		k := g.n(1, 5)
+		if g.chance(12) {
+			k = 0
+		}
+		parts := make([]string, k)
+		for i := range parts {
+			parts[i] = g.expr(*t.elem, depth+1)
+		}
+		if k == 1 && g.chance(30) {
+			return "[" + parts[0] + ",]"
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case kDict:
+		// distinct literal keys: a dict literal with two equal keys is an
+		// error in Starlark, fine in Python
+		k := g.n(0, 3)
+		parts := make([]string, 0, k)
+		seen := map[string]bool{}
+		for i := 0; i < k; i++ {
+			var key, canon string
+			if t.key.k == kInt {
+				canon = strconv.Itoa(g.n(-3, 12))
+				key = canon
+				if key[0] == '-' {
+					key = "(" + key + ")"
+				}
+			} else {
+				canon = g.randStr(3)
+				key = g.strLit(canon)
+			}
+			if seen[canon] {
+				continue
+			}
+			seen[canon] = true
+			parts = append(parts, key+": "+g.expr(*t.elem, depth+1))
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	case kTuple:
+		parts := make([]string, len(t.elems))
+		for i, e := range t.elems {
+			parts[i] = g.expr(e, depth+1)
+		}
+		if len(parts) == 1 {
+			return "(" + parts[0] + ",)"
+		}
+		return "(" + strings.Join(parts, ", ") + ")"
+	}
+	return "None"
+}
+
+// ---------------------------------------------------------------------------
+// Variables.
+
+// varsOf lists the variables of a type in scope, honouring the growth mode.
+func (g *gen) varsOf(t ty) []*variable {
+	var vs []*variable
+	for i := range g.vars {
+		v := &g.vars[i]
+		if !v.t.eq(t) {
+			continue
+		}
+		if g.grow > 0 && v.t.growable() && (v.taint || v.depth < g.loopDepth) {
+			if g.grow == 2 || g.taint >= 1 {
+				continue
+			}
+		}
+		vs = append(vs, v)
+	}
+	return vs
+}
+
+// varsWhere lists the variables satisfying pred (any type), honouring the
+// growth mode.
+func (g *gen) varsWhere(pred func(ty) bool) []*variable {
+	var vs []*variable
+	for i := range g.vars {
+		v := &g.vars[i]
+		if !pred(v.t) {
+			continue
+		}
+		if g.grow > 0 && v.t.growable() && (v.taint || v.depth < g.loopDepth) {
+			if g.grow == 2 || g.taint >= 1 {
+				continue
+			}
+		}
+		vs = append(vs, v)
+	}
+	return vs
+}
+
+// ref spells a reference to the variable, accounting for it in the growth
+// mode.
+func (g *gen) ref(v *variable) string {
+	if g.grow > 0 && v.t.growable() && (v.taint || v.depth < g.loopDepth) {
+		g.taint++
+	}
+	return v.name
+}
+
+// someVar picks a variable of the type, or returns nil.
+func (g *gen) someVar(t ty) *variable {
+	vs := g.varsOf(t)
+	if len(vs) == 0 {
+		return nil
+	}
+	return vs[g.n(0, len(vs)-1)]
+}
+
+// mutableVars lists the variables of the scope that may be assigned or
+// mutated now.
+func (g *gen) mutableVars(pred func(ty) bool) []*variable {
+	var vs []*variable
+	for i := g.scopeBase; i < len(g.vars); i++ {
+		v := &g.vars[i]
+		if v.mutable && !v.frozen && pred(v.t) {
+			vs = append(vs, v)
+		}
+	}
+	return vs
+}
+
+// ---------------------------------------------------------------------------
+// Expressions.
+
+// Precedence levels, shared by Python and Starlark: an operand is
+// parenthesised only when its level is below what its context needs, so
+// the parser's precedence and associativity are exercised.
+const (
+	pCond   = 0  // a if c else b
+	pOr     = 1  // or
+	pAnd    = 2  // and
+	pNot    = 3  // not x
+	pCmp    = 4  // == != < > <= >= in not-in (not chained: operands need pBitOr)
+	pBitOr  = 5  // |
+	pBitXor = 6  // ^
+	pBitAnd = 7  // &
+	pShift  = 8  // << >>
+	pAdd    = 9  // + -
+	pMul    = 10 // * // %
+	pUnary  = 11 // - + ~
+	pAtom   = 12 // literals, names, calls, subscripts, attribute calls
+)
+
+// expr generates an expression of the type for a context that takes any
+// expression (an argument, an element, a right-hand side).
+func (g *gen) expr(t ty, depth int) string { return g.exprP(t, depth, pCond) }
+
+// atom generates an expression usable as the receiver of a method call
+// or subscript.
+func (g *gen) atom(t ty, depth int) string { return g.exprP(t, depth, pAtom) }
+
+// exprP generates an expression of the type, parenthesised if its
+// precedence is below min.
+func (g *gen) exprP(t ty, depth, min int) string {
+	s, p := g.exprRaw(t, depth)
+	if p < min {
+		return "(" + s + ")"
+	}
+	return s
+}
+
+// exprRaw generates an expression and its precedence level.
+func (g *gen) exprRaw(t ty, depth int) (string, int) {
+	if depth >= 3 || g.chance(25+depth*15) {
+		return g.leaf(t, depth)
+	}
+	switch t.k {
+	case kInt:
+		return g.intExpr(depth)
+	case kStr:
+		return g.strExpr(depth)
+	case kBool:
+		return g.boolExpr(depth)
+	case kList:
+		return g.listExpr(t, depth)
+	case kDict:
+		return g.dictExpr(t, depth)
+	case kTuple:
+		return g.tupleExpr(t, depth)
+	}
+	return g.leaf(t, depth)
+}
+
+func (g *gen) leaf(t ty, depth int) (string, int) {
+	if v := g.someVar(t); v != nil && g.chance(60) {
+		return g.ref(v), pAtom
+	}
+	// literal parenthesises negative numbers, so every literal is an atom
+	return g.literal(t, depth), pAtom
+}
+
+// snapshotFrozen remembers which variables are being iterated and returns
+// a function restoring that state.
+func (g *gen) snapshotFrozen() func() {
+	frozen := make([]bool, len(g.vars))
+	for i, v := range g.vars {
+		frozen[i] = v.frozen
+	}
+	return func() {
+		for i := range frozen {
+			if i < len(g.vars) {
+				g.vars[i].frozen = frozen[i]
+			}
+		}
+	}
+}
+
+// cond generates a condition expression (a bool).
+func (g *gen) cond(depth int) string { return g.expr(tBool, depth) }
+
+// orTest generates a bool usable where Python wants an or_test: the
+// clauses of a comprehension, the operands of a conditional.
+func (g *gen) orTest(depth int) string { return g.exprP(tBool, depth, pOr) }
+
+// call spells a call of a generated function returning the type.
+func (g *gen) call(t ty, depth int) (string, int) {
+	var fs []fn
+	for _, f := range g.funcs {
+		if f.ret.eq(t) {
+			fs = append(fs, f)
+		}
+	}
+	if len(fs) == 0 || g.inFunc {
+		return "", -1
+	}
+	f := fs[g.n(0, len(fs)-1)]
+	saved := g.grow
+	if g.grow > 0 {
+		g.grow = 2 // a function may multiply its arguments
+	}
+	args := make([]string, len(f.params))
+	for i, p := range f.params {
+		args[i] = g.expr(p, depth+1)
+	}
+	g.grow = saved
+	if len(args) > 1 && g.chance(15) {
+		// keyword arguments, in reverse order
+		for i := range args {
+			args[i] = fmt.Sprintf("p%d=%s", i, args[i])
+		}
+		for i, j := 0, len(args)-1; i < j; i, j = i+1, j-1 {
+			args[i], args[j] = args[j], args[i]
+		}
+	}
+	return f.name + "(" + strings.Join(args, ", ") + ")", pAtom
+}
+
+// subscript spells an index into a list variable of the element type, a
+// dict with that value type, or a tuple with such an element.
+func (g *gen) subscript(t ty, depth int) (string, int) {
+	var options []func() string
+	for _, v := range g.varsWhere(func(u ty) bool { return u.k == kList && u.elem.eq(t) }) {
+		v := v
+		options = append(options, func() string { return g.ref(v) + "[" + g.index(depth) + "]" })
+	}
+	for _, v := range g.varsWhere(func(u ty) bool { return u.k == kDict && u.elem.eq(t) }) {
+		v := v
+		options = append(options, func() string {
+			k := g.expr(*v.t.key, depth+1)
+			switch g.n(1, 4) {
+			case 1:
+				return g.ref(v) + "[" + k + "]"
+			case 2:
+				return g.ref(v) + ".get(" + k + ", " + g.expr(t, depth+1) + ")"
+			case 3:
+				if g.noMutate == 0 && v.mutable && !v.frozen && g.scopeIndex(v) >= g.scopeBase {
+					return g.ref(v) + ".pop(" + k + ", " + g.expr(t, depth+1) + ")"
+				}
+				return g.ref(v) + ".get(" + k + ", " + g.expr(t, depth+1) + ")"
+			default:
+				if g.noMutate == 0 && v.mutable && !v.frozen && g.scopeIndex(v) >= g.scopeBase {
+					return g.ref(v) + ".setdefault(" + k + ", " + g.expr(t, depth+1) + ")"
+				}
+				return g.ref(v) + "[" + k + "]"
+			}
+		})
+	}
+	for _, v := range g.varsWhere(func(u ty) bool { return u.k == kTuple }) {
+		v := v
+		for i, e := range v.t.elems {
+			if e.eq(t) {
+				i := i
+				options = append(options, func() string {
+					if g.chance(30) {
+						return g.ref(v) + "[" + strconv.Itoa(i-len(v.t.elems)) + "]"
+					}
+					return g.ref(v) + "[" + strconv.Itoa(i) + "]"
+				})
+			}
+		}
+	}
+	if len(options) == 0 {
+		return "", -1
+	}
+	return options[g.n(0, len(options)-1)](), pAtom
+}
+
+func (g *gen) scopeIndex(v *variable) int {
+	for i := range g.vars {
+		if &g.vars[i] == v {
+			return i
+		}
+	}
+	return -1
+}
+
+// index spells an index expression: a small literal mostly, sometimes an
+// expression.
+func (g *gen) index(depth int) string {
+	if g.chance(75) {
+		i := g.n(-3, 3)
+		if g.chance(50) {
+			i = g.n(-1, 1)
+		}
+		if i < 0 {
+			return "(" + strconv.Itoa(i) + ")"
+		}
+		return strconv.Itoa(i)
+	}
+	return g.small(depth)
+}
+
+// small spells a computed integer between -4 and 4: indexes and ranges
+// wider than a machine int are an error in Starlark and clamped in Python.
+func (g *gen) small(depth int) string {
+	return "(" + g.exprP(tInt, depth+1, pMul) + " % 9 - 4)"
+}
+
+// slice spells [i:j:k] with optional parts.
+func (g *gen) slice(depth int) string {
+	part := func() string {
+		if g.chance(40) {
+			return ""
+		}
+		return g.index(depth)
+	}
+	s := part() + ":" + part()
+	if g.chance(30) {
+		k := pick(g.tc, "1", "2", "3", "(-1)", "(-2)", "")
+		s += ":" + k
+	}
+	return s
+}
+
+// ---- int
+
+func (g *gen) intExpr(depth int) (string, int) {
+	if s, p := g.tryCommon(tInt, depth); p >= 0 {
+		return s, p
+	}
+	choices := []func() (string, int){
+		func() (string, int) { return g.binary(tInt, depth, pick(g.tc, "+", "-"), pAdd), pAdd },
+		func() (string, int) { return g.exprP(tInt, depth+1, pMul) + " // " + g.divisor(depth), pMul },
+		func() (string, int) { return g.exprP(tInt, depth+1, pMul) + " % " + g.divisor(depth), pMul },
+		func() (string, int) { return pick(g.tc, "-", "+", "~") + g.exprP(tInt, depth+1, pUnary), pUnary },
+		func() (string, int) { return g.binary(tInt, depth, "&", pBitAnd), pBitAnd },
+		func() (string, int) { return g.binary(tInt, depth, "|", pBitOr), pBitOr },
+		func() (string, int) { return g.binary(tInt, depth, "^", pBitXor), pBitXor },
+		func() (string, int) {
+			return g.exprP(tInt, depth+1, pShift) + " >> " + strconv.Itoa(g.n(0, 70)), pShift
+		},
+		func() (string, int) { return "abs(" + g.expr(tInt, depth+1) + ")", pAtom },
+		func() (string, int) { return "int(" + g.expr(tBool, depth+1) + ")", pAtom },
+		func() (string, int) { return "int(" + g.expr(tInt, depth+1) + ")", pAtom },
+		func() (string, int) { return g.intParse(), pAtom },
+		func() (string, int) {
+			return pick(g.tc, "min", "max") + "(" + g.expr(tInt, depth+1) + ", " + g.expr(tInt, depth+1) + ")", pAtom
+		},
+		func() (string, int) {
+			return pick(g.tc, "min", "max") + "(" + g.nonEmpty(listOf(tInt), depth) + ")", pAtom
+		},
+		func() (string, int) {
+			v := g.someVarWhere(func(t ty) bool { return t.k == kList || t.k == kDict || t.k == kStr || t.k == kTuple })
+			if v == nil {
+				return "len(" + g.expr(tStr, depth+1) + ")", pAtom
+			}
+			return "len(" + g.ref(v) + ")", pAtom
+		},
+		func() (string, int) {
+			m := pick(g.tc, "find", "rfind", "count", "find", "rfind", "count", "find", "rfind", "count", "index", "rindex")
+			s := g.atom(tStr, depth+1) + "." + m + "("
+			if g.chance(30) {
+				// with a range, a non-empty literal: Python finds "" nowhere past
+				// the end, Starlark at the end (as in the slice S[start:end])
+				s += g.strLit(g.randStr(3)+"a") + ", " + g.index(depth)
+				if g.chance(50) {
+					s += ", " + g.index(depth)
+				}
+			} else {
+				s += g.expr(tStr, depth+1)
+			}
+			return s + ")", pAtom
+		},
+		func() (string, int) {
+			v := g.someVarWhere(func(t ty) bool { return t.k == kList })
+			if v == nil {
+				return "len([])", pAtom
+			}
+			if g.chance(70) {
+				return "len(" + g.ref(v) + ")", pAtom
+			}
+			s := g.ref(v) + ".index(" + g.expr(*v.t.elem, depth+1)
+			if g.chance(30) {
+				s += ", " + g.index(depth)
+			}
+			return s + ")", pAtom
+		},
+		func() (string, int) { return "ord(" + g.strLit(string(strPool[g.n(0, len(strPool)-1)])) + ")", pAtom },
+		func() (string, int) {
+			return "len(range(" + g.small(depth) + ", " + g.small(depth) + ", " + pick(g.tc, "1", "2", "3", "(-1)", "(-2)") + "))", pAtom
+		},
+	}
+	if g.grow == 0 {
+		choices = append(choices,
+			func() (string, int) { return g.binary(tInt, depth, "*", pMul), pMul },
+			func() (string, int) {
+				return g.exprP(tInt, depth+1, pShift) + " << " + strconv.Itoa(g.n(0, 70)), pShift
+			},
+		)
+	}
+	return choices[g.n(0, len(choices)-1)]()
+}
+
+// nonEmpty spells a list expression with at least one element, mostly.
+func (g *gen) nonEmpty(t ty, depth int) string {
+	if g.chance(25) {
+		return g.expr(t, depth+1)
+	}
+	return "(" + g.expr(t, depth+1) + " + [" + g.expr(*t.elem, depth+1) + "])"
+}
+
+// sep spells a separator argument: a non-empty literal mostly (an empty
+// separator is an error for split and partition).
+func (g *gen) sep(depth int) string {
+	if g.chance(25) {
+		return g.expr(tStr, depth+1)
+	}
+	return g.strLit(g.randStr(1) + pick(g.tc, "a", ",", " ", "\n", "b", "-", "ab"))
+}
+
+// binary spells a left-associative binary operation at the level.
+func (g *gen) binary(t ty, depth int, op string, p int) string {
+	return g.exprP(t, depth+1, p) + " " + op + " " + g.exprP(t, depth+1, p+1)
+}
+
+// divisor spells a divisor (the right operand of // or %): a non-zero
+// literal mostly.
+func (g *gen) divisor(depth int) string {
+	if g.chance(85) {
+		d := g.n(1, 12)
+		if g.chance(30) {
+			return "(-" + strconv.Itoa(d) + ")"
+		}
+		return strconv.Itoa(d)
+	}
+	return g.exprP(tInt, depth+1, pMul+1)
+}
+
+// intParse spells int(string[, base]).
+func (g *gen) intParse() string {
+	sign := pick(g.tc, "", "", "-", "+")
+	switch g.n(1, 10) {
+	case 1:
+		return "int(" + g.strLit(sign+strconv.Itoa(g.n(0, 100000))) + ")"
+	case 2:
+		return "int(" + g.strLit(sign+strconv.FormatInt(int64(g.n(0, 1<<40)), 16)) + ", 16)"
+	case 3:
+		return "int(" + g.strLit(sign+"0x"+strconv.FormatInt(int64(g.n(0, 1<<40)), 16)) + ", " + pick(g.tc, "16", "0") + ")"
+	case 4:
+		return "int(" + g.strLit(sign+strconv.FormatInt(int64(g.n(0, 1<<20)), 2)) + ", 2)"
+	case 5, 6, 7:
+		return "int(" + g.strLit(sign+"0o"+strconv.FormatInt(int64(g.n(0, 1<<20)), 8)) + ", " + pick(g.tc, "8", "0") + ")"
+	case 8, 9:
+		return "int(" + g.strLit(sign+strconv.Itoa(g.n(0, 100000))) + ", " + pick(g.tc, "10", "0", "36") + ")"
+	default:
+		return "int(" + g.strLit(pick(g.tc, "", "0x", "-", "+-1", "12a", "0b101", "0o17", "1e3", "09", "00", "-0x10", "0X1F", "0B1", "0O7")) + pick(g.tc, "", ", 0", ", 10", ", 16", ", 36") + ")"
+	}
+}
+
+func (g *gen) someVarWhere(pred func(ty) bool) *variable {
+	vs := g.varsWhere(pred)
+	if len(vs) == 0 {
+		return nil
+	}
+	return vs[g.n(0, len(vs)-1)]
+}
+
+// tryCommon handles the expression forms shared by every type: a call, a
+// subscript, a conditional. It returns -1 when it has nothing.
+func (g *gen) tryCommon(t ty, depth int) (string, int) {
+	switch g.n(1, 10) {
+	case 1:
+		if s, p := g.call(t, depth); p >= 0 {
+			return s, p
+		}
+	case 2:
+		if s, p := g.subscript(t, depth); p >= 0 {
+			return s, p
+		}
+	case 4:
+		return g.exprP(t, depth+1, pOr) + " if " + g.orTest(depth+1) + " else " + g.expr(t, depth+1), pCond
+	}
+	return "", -1
+}
+
+// ---- str
+
+func (g *gen) strExpr(depth int) (string, int) {
+	if s, p := g.tryCommon(tStr, depth); p >= 0 {
+		return s, p
+	}
+	choices := []func() (string, int){
+		func() (string, int) { return g.binary(tStr, depth, "+", pAdd), pAdd },
+		func() (string, int) { return g.atom(tStr, depth+1) + "[" + g.index(depth) + "]", pAtom },
+		func() (string, int) { return g.atom(tStr, depth+1) + "[" + g.slice(depth) + "]", pAtom },
+		func() (string, int) { return "str(" + g.anyExpr(depth+1) + ")", pAtom },
+		func() (string, int) { return "repr(" + g.anyExpr(depth+1) + ")", pAtom },
+		func() (string, int) { return g.percentFormat(depth), pMul },
+		func() (string, int) { return g.formatCall(depth), pAtom },
+		func() (string, int) {
+			m := pick(g.tc, "upper", "lower", "strip", "lstrip", "rstrip", "capitalize", "title")
+			return g.atom(tStr, depth+1) + "." + m + "()", pAtom
+		},
+		func() (string, int) {
+			m := pick(g.tc, "strip", "lstrip", "rstrip")
+			// a non-empty literal cutset while starlark-go/2 is open (an empty
+			// cutset strips whitespace)
+			return g.atom(tStr, depth+1) + "." + m + "(" + g.strLit(g.randStr(2)+pick(g.tc, "a", " ", "\t", "x", ",")) + ")", pAtom
+		},
+		func() (string, int) {
+			s := g.atom(tStr, depth+1) + ".replace(" + g.expr(tStr, depth+1) + ", " + g.expr(tStr, depth+1)
+			if g.chance(30) {
+				s += ", " + g.index(depth)
+			}
+			return s + ")", pAtom
+		},
+		func() (string, int) {
+			return g.atom(tStr, depth+1) + ".join(" + g.expr(listOf(tStr), depth+1) + ")", pAtom
+		},
+		func() (string, int) {
+			m := pick(g.tc, "removeprefix", "removesuffix")
+			return g.atom(tStr, depth+1) + "." + m + "(" + g.expr(tStr, depth+1) + ")", pAtom
+		},
+		func() (string, int) {
+			m := pick(g.tc, "partition", "rpartition")
+			return g.atom(tStr, depth+1) + "." + m + "(" + g.sep(depth) + ")[" + strconv.Itoa(g.n(0, 2)) + "]", pAtom
+		},
+		func() (string, int) {
+			// printable ASCII and the whitespace both languages agree on: Python
+			// counts \x1c-\x1f as whitespace, Starlark (White_Space) does not
+			c := g.n(32, 126)
+			if g.chance(20) {
+				c = pick(g.tc, 9, 10) // not \v \f \r: line boundaries for Python's splitlines, not Starlark's
+			}
+			return "chr(" + strconv.Itoa(c) + ")", pAtom
+		},
+		func() (string, int) {
+			s := pick(g.tc, "min", "max") + "(" + g.nonEmpty(listOf(tStr), depth)
+			if g.chance(30) {
+				s += ", key=len"
+			}
+			return s + ")", pAtom
+		},
+		func() (string, int) {
+			return pick(g.tc, "min", "max") + "(" + g.expr(tStr, depth+1) + ", " + g.expr(tStr, depth+1) + ")", pAtom
+		},
+	}
+	if g.grow == 0 {
+		choices = append(choices,
+			func() (string, int) { return g.exprP(tStr, depth+1, pMul) + " * " + g.repeatCount(depth), pMul },
+			func() (string, int) { return g.repeatCount(depth) + " * " + g.exprP(tStr, depth+1, pMul+1), pMul },
+		)
+	}
+	return choices[g.n(0, len(choices)-1)]()
+}
+
+func (g *gen) repeatCount(depth int) string {
+	if g.chance(70) {
+		k := g.n(-1, 4)
+		if k < 0 {
+			return "(-1)"
+		}
+		return strconv.Itoa(k)
+	}
+	// never a free expression: a 64-bit literal times a list is minutes of
+	// work in Python
+	return g.small(depth)
+}
+
+// anyExpr generates an expression of some type, for str(), repr() and
+// print.
+func (g *gen) anyExpr(depth int) string {
+	if g.chance(8) {
+		return "None"
+	}
+	t := g.randType(1)
+	if g.chance(30) {
+		if v := g.someVarWhere(func(ty) bool { return true }); v != nil {
+			return g.ref(v)
+		}
+	}
+	return g.expr(t, depth)
+}
+
+// scalarArg generates an argument for %s and {}: an int, a string, a bool
+// or None (strings would need Python's repr otherwise).
+func (g *gen) scalarArg(depth int) string {
+	switch g.n(1, 7) {
+	case 1, 2, 3:
+		return g.exprP(tInt, depth+1, pUnary)
+	case 4, 5:
+		return g.exprP(tStr, depth+1, pUnary)
+	case 6:
+		return g.exprP(tBool, depth+1, pUnary)
+	}
+	return "None"
+}
+
+// reprArg generates an argument for %r and {!r}: an int, a bool or None.
+func (g *gen) reprArg(depth int) string {
+	switch g.n(1, 4) {
+	case 1, 2:
+		return g.exprP(tInt, depth+1, pUnary)
+	case 3:
+		return g.exprP(tBool, depth+1, pUnary)
+	}
+	return "None"
+}
+
+// fmtText spells literal text for a format string, without the format
+// characters.
+func (g *gen) fmtText(exclude string) string {
+	s := g.randStr(4)
+	for _, c := range exclude {
+		s = strings.ReplaceAll(s, string(c), "")
+	}
+	return s
+}
+
+// percentFormat spells a "..." % args expression.
+func (g *gen) percentFormat(depth int) string {
+	k := g.n(0, 3)
+	var fs strings.Builder
+	var args []string
+	keyed := k > 0 && g.chance(15)
+	fs.WriteString(g.fmtText("%"))
+	for i := 0; i < k; i++ {
+		var conv, arg string
+		switch g.n(1, 9) {
+		case 1, 2, 3:
+			conv, arg = "s", g.scalarArg(depth)
+		case 4:
+			conv, arg = "r", g.reprArg(depth)
+		case 5, 6:
+			conv, arg = pick(g.tc, "d", "i"), g.exprP(tInt, depth+1, pUnary)
+		case 7:
+			conv, arg = pick(g.tc, "o", "x", "X"), g.exprP(tInt, depth+1, pUnary)
+		case 8:
+			if g.chance(50) {
+				conv, arg = "c", strconv.Itoa(g.n(32, 126))
+			} else {
+				conv, arg = "c", g.strLit(string(strPool[g.n(0, len(strPool)-1)]))
+			}
+		default:
+			fs.WriteString("%%")
+			fs.WriteString(g.fmtText("%"))
+			continue
+		}
+		if keyed {
+			fs.WriteString(fmt.Sprintf("%%(k%d)%s", i, conv))
+			args = append(args, fmt.Sprintf("\"k%d\": %s", i, arg))
+		} else {
+			fs.WriteString("%" + conv)
+			args = append(args, arg)
+		}
+		fs.WriteString(g.fmtText("%"))
+	}
+	lit := g.strLit(fs.String())
+	switch {
+	case keyed:
+		return lit + " % {" + strings.Join(args, ", ") + "}"
+	case len(args) == 0:
+		return lit + " % ()"
+	case len(args) == 1 && g.chance(60):
+		return lit + " % " + args[0]
+	default:
+		return lit + " % (" + strings.Join(args, ", ") + ")"
+	}
+}
+
+// formatCall spells a "...".format(args) expression.
+func (g *gen) formatCall(depth int) string {
+	k := g.n(0, 3)
+	mode := g.n(1, 3) // 1 auto, 2 manual, 3 keywords
+	var fs strings.Builder
+	var args []string
+	fs.WriteString(g.fmtText("{}"))
+	if g.chance(20) {
+		fs.WriteString(pick(g.tc, "{{", "}}", "{{}}"))
+	}
+	for i := 0; i < k; i++ {
+		conv := ""
+		var arg string
+		if g.chance(20) {
+			conv, arg = "!r", g.reprArg(depth)
+		} else {
+			if g.chance(20) {
+				conv = "!s"
+			}
+			arg = g.scalarArg(depth)
+		}
+		switch mode {
+		case 1:
+			fs.WriteString("{" + conv + "}")
+			args = append(args, arg)
+		case 2:
+			j := i
+			if conv != "!r" && g.chance(30) {
+				j = g.n(0, k-1) // repeats and skips are fine (but !r of a string would need Python's repr)
+			}
+			fs.WriteString("{" + strconv.Itoa(j) + conv + "}")
+			args = append(args, arg)
+		default:
+			fs.WriteString(fmt.Sprintf("{a%d%s}", i, conv))
+			args = append(args, fmt.Sprintf("a%d=%s", i, arg))
+		}
+		fs.WriteString(g.fmtText("{}"))
+	}
+	return g.strLit(fs.String()) + ".format(" + strings.Join(args, ", ") + ")"
+}
+
+// ---- bool
+
+func (g *gen) boolExpr(depth int) (string, int) {
+	if s, p := g.tryCommon(tBool, depth); p >= 0 {
+		return s, p
+	}
+	choices := []func() (string, int){
+		func() (string, int) { return "not " + g.exprP(tBool, depth+1, pNot), pNot },
+		func() (string, int) {
+			return g.exprP(tBool, depth+1, pAnd) + " and " + g.exprP(tBool, depth+1, pNot), pAnd
+		},
+		func() (string, int) {
+			return g.exprP(tBool, depth+1, pOr) + " or " + g.exprP(tBool, depth+1, pAnd), pOr
+		},
+		func() (string, int) {
+			t := g.randType(1)
+			u := t
+			if g.chance(10) {
+				t, u = tNone, tNone
+			} else if g.chance(15) {
+				// values of different types are unequal (bools kept apart from
+				// ints, which Python unifies)
+				for u = g.randType(1); u.eq(t) || (u.k == kBool && t.k == kInt) || (u.k == kInt && t.k == kBool); {
+					u = g.randType(1)
+				}
+			}
+			return g.exprP(t, depth+1, pBitOr) + pick(g.tc, " == ", " != ") + g.exprP(u, depth+1, pBitOr), pCmp
+		},
+		func() (string, int) {
+			t := g.randType(1)
+			for !t.ordered() {
+				t = g.randType(1)
+			}
+			return g.exprP(t, depth+1, pBitOr) + pick(g.tc, " < ", " <= ", " > ", " >= ") + g.exprP(t, depth+1, pBitOr), pCmp
+		},
+		func() (string, int) {
+			t := g.randType(2)
+			return g.exprP(t, depth+1, pBitOr) + pick(g.tc, " in ", " not in ") + g.exprP(listOf(t), depth+1, pBitOr), pCmp
+		},
+		func() (string, int) {
+			return g.exprP(tStr, depth+1, pBitOr) + pick(g.tc, " in ", " not in ") + g.exprP(tStr, depth+1, pBitOr), pCmp
+		},
+		func() (string, int) {
+			v := g.someVarWhere(func(t ty) bool { return t.k == kDict })
+			if v == nil {
+				return g.exprP(tStr, depth+1, pBitOr) + " in {}", pCmp
+			}
+			return g.exprP(*v.t.key, depth+1, pBitOr) + pick(g.tc, " in ", " not in ") + g.ref(v), pCmp
+		},
+		func() (string, int) {
+			m := pick(g.tc, "startswith", "endswith")
+			s := g.atom(tStr, depth+1) + "." + m + "("
+			ranged := g.chance(25)
+			affix := func() string {
+				if ranged {
+					// Python finds no empty affix in an empty or inverted range,
+					// Starlark does (as in the slice S[start:end])
+					return g.strLit(g.randStr(2) + "a")
+				}
+				return g.expr(tStr, depth+1)
+			}
+			if g.chance(25) {
+				s += "(" + affix() + ", " + affix() + ")"
+			} else {
+				s += affix()
+			}
+			if ranged {
+				s += ", " + g.index(depth)
+				if g.chance(50) {
+					s += ", " + g.index(depth)
+				}
+			}
+			return s + ")", pAtom
+		},
+		func() (string, int) {
+			m := pick(g.tc, "isalpha", "isdigit", "isspace", "islower", "isupper", "isalnum", "istitle")
+			return g.atom(tStr, depth+1) + "." + m + "()", pAtom
+		},
+		func() (string, int) { return "bool(" + g.anyExpr(depth+1) + ")", pAtom },
+		func() (string, int) {
+			return pick(g.tc, "all", "any") + "(" + g.expr(listOf(tBool), depth+1) + ")", pAtom
+		},
+	}
+	return choices[g.n(0, len(choices)-1)]()
+}
+
+// ---- list
+
+func (g *gen) listExpr(t ty, depth int) (string, int) {
+	if s, p := g.tryCommon(t, depth); p >= 0 {
+		return s, p
+	}
+	e := *t.elem
+	choices := []func() (string, int){
+		func() (string, int) { return g.binary(t, depth, "+", pAdd), pAdd },
+		func() (string, int) { return g.atom(t, depth+1) + "[" + g.slice(depth) + "]", pAtom },
+		func() (string, int) { return "list(" + g.expr(t, depth+1) + ")", pAtom },
+		func() (string, int) { return "list(reversed(" + g.expr(t, depth+1) + "))", pAtom },
+	}
+	if e.ordered() {
+		choices = append(choices, func() (string, int) {
+			s := "sorted(" + g.expr(t, depth+1)
+			if g.chance(30) {
+				s += ", reverse=" + g.expr(tBool, depth+1)
+			}
+			return s + ")", pAtom
+		})
+	}
+	if e.k == kStr || e.k == kList {
+		choices = append(choices, func() (string, int) {
+			s := "sorted(" + g.expr(t, depth+1) + ", key=len"
+			if g.chance(30) {
+				s += ", reverse=True"
+			}
+			return s + ")", pAtom
+		})
+	}
+	if e.k == kInt {
+		choices = append(choices, func() (string, int) {
+			s := "list(range(" + g.small(depth)
+			if g.chance(70) {
+				s += ", " + g.small(depth)
+				if g.chance(50) {
+					s += ", " + pick(g.tc, "1", "2", "3", "(-1)", "(-2)")
+				}
+			}
+			return s + "))", pAtom
+		})
+	}
+	if e.k == kStr {
+		choices = append(choices,
+			func() (string, int) {
+				s := g.atom(tStr, depth+1) + "." + pick(g.tc, "split", "rsplit") + "("
+				if g.chance(30) {
+					s += pick(g.tc, "", "None")
+					if s[len(s)-1] != '(' && g.chance(50) {
+						s += ", " + g.index(depth)
+					}
+				} else {
+					s += g.sep(depth)
+					if g.chance(40) {
+						s += ", " + g.index(depth)
+					}
+				}
+				return s + ")", pAtom
+			},
+			func() (string, int) {
+				s := g.atom(tStr, depth+1) + ".splitlines("
+				if g.chance(30) {
+					s += g.expr(tBool, depth+1)
+				}
+				return s + ")", pAtom
+			},
+		)
+	}
+	for _, v := range g.varsWhere(func(u ty) bool { return u.k == kDict && (u.key.eq(e) || u.elem.eq(e)) }) {
+		v := v
+		choices = append(choices, func() (string, int) {
+			if v.t.key.eq(e) && (!v.t.elem.eq(e) || g.chance(50)) {
+				return pick(g.tc, "list(", "sorted(") + g.ref(v) + pick(g.tc, ".keys()", "") + ")", pAtom
+			}
+			return "list(" + g.ref(v) + ".values())", pAtom
+		})
+	}
+	if e.k == kTuple && len(e.elems) == 2 {
+		a, b := e.elems[0], e.elems[1]
+		if a.k == kInt {
+			choices = append(choices, func() (string, int) {
+				return "list(enumerate(" + g.expr(listOf(b), depth+1) + "))", pAtom
+			})
+		}
+		choices = append(choices, func() (string, int) {
+			return "list(zip(" + g.expr(listOf(a), depth+1) + ", " + g.expr(listOf(b), depth+1) + "))", pAtom
+		})
+		if a.hashable() {
+			choices = append(choices, func() (string, int) {
+				fn := "list("
+				if e.ordered() && g.chance(50) {
+					fn = "sorted("
+				}
+				return fn + g.atom(dictOf(a, b), depth+1) + ".items())", pAtom
+			})
+		}
+	}
+	if g.grow == 0 {
+		choices = append(choices,
+			func() (string, int) { return g.exprP(t, depth+1, pMul) + " * " + g.repeatCount(depth), pMul },
+			func() (string, int) { return g.comprehension(t, depth), pAtom },
+		)
+	}
+	return choices[g.n(0, len(choices)-1)]()
+}
+
+// ---- dict
+
+func (g *gen) dictExpr(t ty, depth int) (string, int) {
+	if s, p := g.tryCommon(t, depth); p >= 0 {
+		return s, p
+	}
+	k, v := *t.key, *t.elem
+	choices := []func() (string, int){
+		func() (string, int) { return "dict(" + g.expr(t, depth+1) + ")", pAtom },
+		func() (string, int) { return "dict(" + g.expr(listOf(tupleOf(k, v)), depth+1) + ")", pAtom },
+		func() (string, int) {
+			return "dict(zip(" + g.expr(listOf(k), depth+1) + ", " + g.expr(listOf(v), depth+1) + "))", pAtom
+		},
+		func() (string, int) { return g.binary(t, depth, "|", pBitOr), pBitOr },
+	}
+	if g.grow == 0 {
+		choices = append(choices, func() (string, int) { return g.comprehension(t, depth), pAtom })
+	}
+	return choices[g.n(0, len(choices)-1)]()
+}
+
+// ---- tuple
+
+func (g *gen) tupleExpr(t ty, depth int) (string, int) {
+	if s, p := g.tryCommon(t, depth); p >= 0 {
+		return s, p
+	}
+	if len(t.elems) >= 2 && g.chance(30) {
+		i := g.n(1, len(t.elems)-1)
+		return g.exprP(tupleOf(t.elems[:i]...), depth+1, pAdd) + " + " + g.exprP(tupleOf(t.elems[i:]...), depth+1, pAdd+1), pAdd
+	}
+	return g.literal(t, depth), pAtom
+}
+
+// ---- comprehensions
+
+// comprehension spells a list or dict comprehension of the type; the
+// loop variables are scoped to it.
+func (g *gen) comprehension(t ty, depth int) string {
+	saved := len(g.vars)
+	savedMutate := g.noMutate
+	unfreeze := g.snapshotFrozen()
+	g.noMutate++
+	iter, names := g.iterable(depth + 1)
+	var body string
+	if t.k == kList {
+		body = g.expr(*t.elem, depth+1)
+	} else {
+		body = g.expr(*t.key, depth+1) + ": " + g.expr(*t.elem, depth+1)
+	}
+	s := body + " for " + names + " in " + iter
+	if g.chance(30) {
+		s += " if " + g.orTest(depth+1)
+	}
+	if g.chance(15) {
+		iter2, names2 := g.iterable(depth + 1)
+		s += " for " + names2 + " in " + iter2
+	}
+	g.vars = g.vars[:saved]
+	unfreeze()
+	g.noMutate = savedMutate
+	if t.k == kList {
+		return "[" + s + "]"
+	}
+	return "{" + s + "}"
+}
+
+// iterable spells something to loop over and declares the loop variables
+// (until the caller truncates the scope); returns the iterable and the
+// target names.
+func (g *gen) iterable(depth int) (string, string) {
+	switch g.n(1, 10) {
+	case 1, 2, 3:
+		// a range
+		s := "range(" + strconv.Itoa(g.n(-3, 6))
+		if g.chance(70) {
+			s += ", " + strconv.Itoa(g.n(-3, 8))
+			if g.chance(40) {
+				s += ", " + pick(g.tc, "1", "2", "3", "(-1)", "(-2)")
+			}
+		}
+		v := g.declare("i", tInt, false, false)
+		return s + ")", v.name
+	case 4, 5, 6:
+		// a list variable or expression
+		if v := g.someVarWhere(func(t ty) bool { return t.k == kList }); v != nil && g.chance(60) {
+			v.frozen = true
+			x := g.declare("x", *v.t.elem, true, true)
+			return v.name, x.name
+		}
+		t := listOf(g.randType(1))
+		e := g.expr(t, depth)
+		x := g.declare("x", *t.elem, true, g.taint > 0)
+		// a copy: the expression may be (an alias of) a variable the body
+		// mutates, which Python tolerates and Starlark rejects
+		return "list(" + e + ")", x.name
+	case 7:
+		if v := g.someVarWhere(func(t ty) bool { return t.k == kDict }); v != nil {
+			v.frozen = true
+			switch g.n(1, 4) {
+			case 1:
+				k := g.declare("k", *v.t.key, true, true)
+				return v.name, k.name
+			case 2:
+				k := g.declare("k", *v.t.key, true, true)
+				return v.name + ".keys()", k.name
+			case 3:
+				x := g.declare("x", *v.t.elem, true, true)
+				return v.name + ".values()", x.name
+			default:
+				k := g.declare("k", *v.t.key, true, true)
+				x := g.declare("x", *v.t.elem, true, true)
+				return v.name + ".items()", k.name + ", " + x.name
+			}
+		}
+		fallthrough
+	case 8:
+		if v := g.someVarWhere(func(t ty) bool { return t.k == kList }); v != nil {
+			v.frozen = true
+			i := g.declare("i", tInt, false, false)
+			x := g.declare("x", *v.t.elem, true, true)
+			return "enumerate(" + v.name + ")", i.name + ", " + x.name
+		}
+		fallthrough
+	case 9:
+		vs := g.varsWhere(func(t ty) bool { return t.k == kList })
+		if len(vs) >= 1 {
+			a := vs[g.n(0, len(vs)-1)]
+			b := vs[g.n(0, len(vs)-1)]
+			a.frozen, b.frozen = true, true
+			x := g.declare("x", *a.t.elem, true, true)
+			y := g.declare("x", *b.t.elem, true, true)
+			return "zip(" + a.name + ", " + b.name + ")", x.name + ", " + y.name
+		}
+		fallthrough
+	default:
+		if v := g.someVarWhere(func(t ty) bool { return t.k == kList && t.elem.k == kTuple }); v != nil {
+			v.frozen = true
+			names := make([]string, len(v.t.elem.elems))
+			for i, e := range v.t.elem.elems {
+				names[i] = g.declare("x", e, true, true).name
+			}
+			if len(names) == 1 {
+				return v.name, "(" + names[0] + ",)" // Starlark has no unparenthesised 1-tuples
+			}
+			return v.name, strings.Join(names, ", ")
+		}
+		v := g.declare("i", tInt, false, false)
+		return "range(" + strconv.Itoa(g.n(0, 5)) + ")", v.name
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Statements.
+
+func (g *gen) stmt() {
+	g.stmts--
+	w := g.n(1, 100)
+	switch {
+	case w <= 18:
+		g.stmtNewVar()
+	case w <= 30:
+		g.stmtAssign()
+	case w <= 40:
+		g.stmtAugAssign()
+	case w <= 52:
+		g.stmtMutate()
+	case w <= 68:
+		g.stmtPrint()
+	case w <= 78:
+		g.stmtIf()
+	case w <= 90:
+		if g.loopDepth < 3 && !g.inFunc {
+			g.stmtFor()
+		} else {
+			g.stmtPrint()
+		}
+	case w <= 94:
+		if g.loopDepth < 3 && !g.inFunc {
+			g.stmtWhile()
+		} else {
+			g.stmtAssign()
+		}
+	case w <= 97:
+		g.stmtUnpack()
+	default:
+		g.stmtCall()
+	}
+}
+
+// block emits an indented block of statements, restoring the scope after.
+func (g *gen) block(max int) {
+	saved := len(g.vars)
+	g.indent++
+	k := g.n(1, max)
+	if g.stmts <= 0 {
+		k = 1
+	}
+	for i := 0; i < k; i++ {
+		g.stmt()
+	}
+	g.indent--
+	// variables declared in the block go out of scope; frozen marks were set
+	// by the loop header and are cleared by the loop
+	g.vars = g.vars[:saved]
+}
+
+// rhsMode sets the growth mode for a value computed inside a loop.
+func (g *gen) rhsMode() (restore func()) {
+	savedGrow, savedTaint := g.grow, g.taint
+	if g.loopDepth > 0 {
+		g.grow = 1
+	}
+	g.taint = 0
+	return func() { g.grow, g.taint = savedGrow, savedTaint }
+}
+
+func (g *gen) stmtNewVar() {
+	t := g.randType(0)
+	restore := g.rhsMode()
+	e := g.expr(t, 0)
+	tainted := g.taint > 0
+	restore()
+	v := g.declare("v", t, true, tainted)
+	g.emit("%s = %s", v.name, e)
+}
+
+func (g *gen) stmtAssign() {
+	vs := g.mutableVars(func(ty) bool { return true })
+	if len(vs) == 0 {
+		g.stmtNewVar()
+		return
+	}
+	v := vs[g.n(0, len(vs)-1)]
+	restore := g.rhsMode()
+	e := g.expr(v.t, 0)
+	if g.taint > 0 && g.loopDepth > v.depth {
+		v.taint = true
+	} else if g.loopDepth > 0 && g.taint > 0 {
+		v.taint = true
+	}
+	restore()
+	g.emit("%s = %s", v.name, e)
+}
+
+func (g *gen) stmtAugAssign() {
+	vs := g.mutableVars(func(t ty) bool { return t.k == kInt || t.k == kStr || t.k == kList })
+	if len(vs) == 0 {
+		g.stmtNewVar()
+		return
+	}
+	v := vs[g.n(0, len(vs)-1)]
+	if v.t.k == kList && g.noMutate > 0 {
+		// += on a list mutates it in place
+		g.stmtAssign()
+		return
+	}
+	restore := g.rhsMode()
+	g.ref(v) // the receiver counts as a loop-carried reference
+	op := "+="
+	if v.t.k == kInt {
+		ops := []string{"+=", "-=", "//=", "%=", "&=", "|=", "^=", ">>="}
+		if g.grow == 0 {
+			ops = append(ops, "*=", "<<=")
+		}
+		op = pick(g.tc, ops...)
+	}
+	var e string
+	switch op {
+	case "//=", "%=":
+		e = g.divisor(0)
+	case ">>=", "<<=":
+		e = strconv.Itoa(g.n(0, 70))
+	default:
+		e = g.expr(v.t, 0)
+	}
+	restore()
+	g.emit("%s %s %s", v.name, op, e)
+}
+
+// stmtMutate emits a mutating method call or subscript assignment on a
+// list or dict.
+func (g *gen) stmtMutate() {
+	if g.noMutate > 0 {
+		g.stmtPrint()
+		return
+	}
+	vs := g.mutableVars(func(t ty) bool { return t.k == kList || t.k == kDict })
+	if len(vs) == 0 {
+		g.stmtNewVar()
+		return
+	}
+	v := vs[g.n(0, len(vs)-1)]
+	restore := g.rhsMode()
+	defer restore()
+	g.ref(v)
+	if v.t.k == kList {
+		e := *v.t.elem
+		switch g.n(1, 8) {
+		case 1, 2, 3:
+			g.emit("%s.append(%s)", v.name, g.expr(e, 0))
+		case 4:
+			g.emit("%s.extend(%s)", v.name, g.expr(v.t, 0))
+		case 5:
+			g.emit("%s.insert(%s, %s)", v.name, g.index(0), g.expr(e, 0))
+		case 6:
+			if g.chance(50) {
+				g.emit("%s.pop()", v.name)
+			} else {
+				g.emit("%s.pop(%s)", v.name, g.index(0))
+			}
+		case 7:
+			if g.chance(30) {
+				g.emit("%s.clear()", v.name)
+			} else {
+				g.emit("%s.remove(%s)", v.name, g.expr(e, 0))
+			}
+		default:
+			g.emit("%s[%s] = %s", v.name, g.index(0), g.expr(e, 0))
+		}
+		return
+	}
+	k, e := *v.t.key, *v.t.elem
+	switch g.n(1, 7) {
+	case 1, 2, 3:
+		g.emit("%s[%s] = %s", v.name, g.expr(k, 0), g.expr(e, 0))
+	case 4:
+		if g.chance(60) {
+			g.emit("%s.update(%s)", v.name, g.expr(v.t, 0))
+		} else {
+			g.emit("%s.update(%s)", v.name, g.expr(listOf(tupleOf(k, e)), 0))
+		}
+	case 5:
+		if g.chance(25) {
+			g.emit("%s.pop(%s)", v.name, g.expr(k, 0))
+		} else {
+			g.emit("%s.pop(%s, %s)", v.name, g.expr(k, 0), g.expr(e, 0))
+		}
+	case 6:
+		g.emit("%s.setdefault(%s, %s)", v.name, g.expr(k, 0), g.expr(e, 0))
+	default:
+		g.emit("%s.clear()", v.name)
+	}
+}
+
+func (g *gen) stmtPrint() {
+	k := g.n(0, 3)
+	if k == 0 && g.chance(80) {
+		k = 1
+	}
+	saved := g.grow
+	g.grow = 0
+	args := make([]string, k)
+	for i := range args {
+		args[i] = g.anyExpr(0)
+	}
+	g.grow = saved
+	if k > 1 && g.chance(20) {
+		args = append(args, "sep="+g.strLit(g.randStr(2)))
+	}
+	g.emit("print(%s)", strings.Join(args, ", "))
+}
+
+func (g *gen) stmtIf() {
+	g.emit("if %s:", g.cond(0))
+	g.block(3)
+	for g.chance(25) {
+		g.emit("elif %s:", g.cond(0))
+		g.block(2)
+	}
+	if g.chance(50) {
+		g.emit("else:")
+		g.block(3)
+	}
+}
+
+func (g *gen) stmtFor() {
+	saved := len(g.vars)
+	// remember which variables the header freezes
+	var frozenBefore []bool
+	for _, v := range g.vars {
+		frozenBefore = append(frozenBefore, v.frozen)
+	}
+	restore := g.rhsMode()
+	iter, names := g.iterable(0)
+	restore()
+	direct := false
+	for i := range g.vars[:saved] {
+		if g.vars[i].frozen && !frozenBefore[i] {
+			direct = true
+		}
+	}
+	g.emit("for %s in %s:", names, iter)
+	g.loopDepth++
+	if direct {
+		g.noMutate++
+	}
+	// the loop variables were declared at the outer depth; make them inner
+	for i := saved; i < len(g.vars); i++ {
+		g.vars[i].depth = g.loopDepth
+	}
+	g.loopBody()
+	if direct {
+		g.noMutate--
+	}
+	g.loopDepth--
+	g.vars = g.vars[:saved]
+	for i := range g.vars {
+		g.vars[i].frozen = frozenBefore[i]
+	}
+	g.untaint()
+}
+
+// untaint clears the loop-carried marks once no loop is open.
+func (g *gen) untaint() {
+	if g.loopDepth == 0 {
+		for i := range g.vars {
+			g.vars[i].taint = false
+		}
+	}
+}
+
+// loopBody emits a loop body, sometimes ending in break or continue.
+func (g *gen) loopBody() {
+	g.block(4)
+	if g.chance(25) {
+		g.indent++
+		if g.chance(50) {
+			g.emit("if %s:", g.cond(0))
+			g.indent++
+			g.emit("%s", pick(g.tc, "break", "continue"))
+			g.indent--
+		} else {
+			g.emit("%s", pick(g.tc, "break", "continue", "pass"))
+		}
+		g.indent--
+	}
+}
+
+func (g *gen) stmtWhile() {
+	c := g.declare("w", tInt, false, false)
+	g.emit("%s = 0", c.name)
+	limit := g.n(0, 6)
+	if g.chance(50) {
+		g.emit("while %s < %d:", c.name, limit)
+	} else {
+		g.emit("while %s < %d and %s:", c.name, limit, g.exprP(tBool, 0, pNot))
+	}
+	g.indent++
+	g.emit("%s += 1", c.name)
+	g.indent--
+	g.loopDepth++
+	g.loopBody()
+	g.loopDepth--
+	g.untaint()
+}
+
+// stmtUnpack emits a tuple unpacking assignment.
+func (g *gen) stmtUnpack() {
+	vs := g.varsWhere(func(t ty) bool { return t.k == kTuple && len(t.elems) >= 2 })
+	if len(vs) == 0 {
+		t := tupleOf(g.scalarType(), g.scalarType())
+		restore := g.rhsMode()
+		e := g.expr(t, 0)
+		tainted := g.taint > 0
+		restore()
+		a := g.declare("v", t.elems[0], true, tainted)
+		b := g.declare("v", t.elems[1], true, tainted)
+		g.emit("%s, %s = %s", a.name, b.name, e)
+		return
+	}
+	v := vs[g.n(0, len(vs)-1)]
+	restore := g.rhsMode()
+	e := g.ref(v)
+	tainted := g.taint > 0
+	restore()
+	names := make([]string, len(v.t.elems))
+	for i, et := range v.t.elems {
+		names[i] = g.declare("v", et, true, tainted).name
+	}
+	g.emit("%s = %s", strings.Join(names, ", "), e)
+}
+
+// stmtCall emits a call for its effect (prints inside functions).
+func (g *gen) stmtCall() {
+	if len(g.funcs) == 0 || g.inFunc {
+		g.stmtPrint()
+		return
+	}
+	f := g.funcs[g.n(0, len(g.funcs)-1)]
+	restore := g.rhsMode()
+	if s, p := g.call(f.ret, 0); p >= 0 {
+		g.emit("%s", s)
+	} else {
+		g.emit("pass")
+	}
+	restore()
+}
+
+// ---------------------------------------------------------------------------
+// Functions.
+
+// funcDef emits a function: typed parameters, a straight-line body (no
+// loops), a typed return. Functions read globals but never mutate them or
+// their parameters, so a call has no effect but its result and its prints.
+func (g *gen) funcDef() {
+	f := fn{name: g.newName("f"), ret: g.randType(0)}
+	k := g.n(0, 3)
+	params := make([]string, k)
+	savedVars := len(g.vars)
+	g.scopeBase = len(g.vars)
+	for i := 0; i < k; i++ {
+		t := g.randType(1)
+		f.params = append(f.params, t)
+		v := g.declare("p", t, false, false)
+		v.name = fmt.Sprintf("p%d", i)
+		params[i] = v.name
+		if i == k-1 && g.chance(20) {
+			// the default may use the globals, not the parameters
+			saved := g.grow
+			g.grow = 0
+			hidden := g.vars[g.scopeBase:]
+			g.vars = g.vars[:g.scopeBase]
+			params[i] += "=" + g.literal(t, 2)
+			g.vars = append(g.vars, hidden...)
+			g.grow = saved
+		}
+	}
+	g.emit("def %s(%s):", f.name, strings.Join(params, ", "))
+	g.indent++
+	g.inFunc = true
+	g.noMutate++ // a local may alias a parameter or a global: functions mutate nothing
+	g.retTy = f.ret
+	savedBudget := g.stmts
+	g.stmts = g.n(0, 5)
+	for g.stmts > 0 {
+		g.stmt()
+	}
+	g.stmts = savedBudget
+	if g.chance(30) {
+		g.emit("if %s:", g.cond(0))
+		g.indent++
+		g.emit("return %s", g.expr(f.ret, 0))
+		g.indent--
+	}
+	g.emit("return %s", g.expr(f.ret, 0))
+	g.noMutate--
+	g.inFunc = false
+	g.indent--
+	g.vars = g.vars[:savedVars]
+	g.scopeBase = 0
+	g.funcs = append(g.funcs, f)
+	g.emit("")
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..6c4c9dc
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,53 @@
+package hegel
+
+import (
+	"strings"
+	"testing"
+)
+
+// Pins: one deterministic reproducer per recorded bug. They fail while the
+// bug is open (expected_failures in target.toml) and pass once it is fixed.
+
+// runOK runs the program in starlark-go and returns its output, failing the
+// test on any error.
+func runOK(t *testing.T, src string) []string {
+	t.Helper()
+	r := goRun(src)
+	if r.status != "ok" {
+		t.Fatalf("%s\n-> %s", src, r)
+	}
+	return r.out
+}
+
+// TestHegelPinNegativeRepeatIsEmpty: starlark-go/1. The specification:
+// "Negative values of n behave like zero" for sequence * n; starlark-go
+// fails with "repeat count ... too large" once the negative count does not
+// fit in 32 bits.
+func TestHegelPinNegativeRepeatIsEmpty(t *testing.T) {
+	cases := map[string]string{
+		`print("ab" * (-3000000000))`:       "",
+		`print([1] * (-3000000000))`:        "[]",
+		`print((1,) * (-3000000000))`:       "()",
+		`print((-1 << 40) * "x")`:           "",
+		`print(len(range(3) * (-1 << 40)))`: "0",
+	}
+	for src, want := range cases {
+		out := runOK(t, src)
+		if strings.Join(out, "\n") != want {
+			t.Errorf("%s -> %q, want %q", src, out, want)
+		}
+	}
+}
+
+// TestHegelPinEmptyCutsetStripsNothing: starlark-go/2. The specification:
+// "S.strip(cutset) instead removes all leading and trailing Unicode code
+// points contained in cutset"; an empty cutset contains none, yet
+// starlark-go treats it as absent and strips whitespace (lstrip and rstrip
+// alike). Python keeps the string.
+func TestHegelPinEmptyCutsetStripsNothing(t *testing.T) {
+	out := runOK(t, `print(repr(" a ".strip("")), repr("\ta".lstrip("")), repr("a\n".rstrip("")))`)
+	want := `" a " "\ta" "a\n"`
+	if strings.Join(out, "\n") != want {
+		t.Errorf("got %q, want %q", out, want)
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..666328f
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,90 @@
+package hegel
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// TestHegelOracle checks the oracle is there and spells values the
+// Starlark way.
+func TestHegelOracle(t *testing.T) {
+	src := "print(1, \"a\", [1, 'b\\n'], {\"k\": (1,)}, None, True, 1 << 70, -7 // 2, -7 % 2)\nprint(repr(\"x\\\"y\"), str([\"a\"]))\n"
+	py := pyRun(t, src)
+	sl := goRun(src)
+	if py.status != "ok" || sl.status != "ok" {
+		t.Fatalf("python: %s\nstarlark: %s", py, sl)
+	}
+	if strings.Join(py.out, "\n") != strings.Join(sl.out, "\n") {
+		t.Fatalf("python: %s\nstarlark: %s", py, sl)
+	}
+}
+
+// TestHegelMatchesPython: a program in the shared subset of Starlark and
+// Python prints the same lines in starlark-go and in python3, and fails
+// or succeeds alike.
+func TestHegelMatchesPython(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := genProgram(ht)
+		trace(src)
+		py := pyRun(t, src)
+		if py.status == "syntax" {
+			fail(ht, "the generator wrote something Python rejects:\n%s\n%s", numbered(src), py.err)
+		}
+		if py.status == "timeout" {
+			count("python timeout")
+			fail(ht, "python does not finish (a generator fault):\n%s", numbered(src))
+		}
+		if strings.HasPrefix(py.err, "OverflowError") || strings.HasPrefix(py.err, "MemoryError") {
+			// Python's C-sized limits ("" * (1 << 70), len(range(1 << 70)))
+			// are not Starlark's
+			count("python overflow")
+			return
+		}
+		sl := goRun(src)
+		if id := known(src, py, sl); id != "" {
+			count("known " + id)
+			return
+		}
+		judge(ht, src, py, sl)
+	})
+}
+
+// judge compares the two runs.
+func judge(ht *hegel.T, src string, py, sl result) {
+	switch sl.status {
+	case "panic":
+		fail(ht, "starlark-go panics:\n%s\n%s\npython: %s", numbered(src), sl.err, py)
+	case "syntax":
+		fail(ht, "starlark-go rejects a program Python runs:\n%s\n%s\npython: %s", numbered(src), sl.err, py)
+	case "timeout":
+		fail(ht, "starlark-go does not finish (%d steps):\n%s\npython: %s", maxSteps, numbered(src), py)
+	}
+	if py.status != sl.status {
+		fail(ht, "python %s but starlark-go %s:\n%s\npython: %s\nstarlark: %s", py.status, sl.status, numbered(src), py, sl)
+	}
+	if py.status == "error" {
+		kind, _, _ := strings.Cut(py.err, ":")
+		count("both fail: " + kind)
+	}
+	if diff := firstDiff(py.out, sl.out); diff != "" {
+		fail(ht, "different output:\n%s\n%s\npython: %s\nstarlark: %s", numbered(src), diff, py, sl)
+	}
+}
+
+// firstDiff describes the first difference between two outputs, or "".
+func firstDiff(a, b []string) string {
+	for i := 0; i < len(a) || i < len(b); i++ {
+		switch {
+		case i >= len(a):
+			return fmt.Sprintf("line %d: python has nothing, starlark-go %q", i+1, b[i])
+		case i >= len(b):
+			return fmt.Sprintf("line %d: python %q, starlark-go has nothing", i+1, a[i])
+		case a[i] != b[i]:
+			return fmt.Sprintf("line %d: python %q, starlark-go %q", i+1, a[i], b[i])
+		}
+	}
+	return ""
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..e8cd0db
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,341 @@
+package hegel
+
+// Hegel property tests for starlark-go. Generated programs in the subset of
+// Starlark that is also Python (with the same meaning by the specification:
+// no bool/int unification, no chained comparisons, strings never iterated,
+// only the shared builtins and methods) run in starlark-go and in python3 -
+// a child process speaking one JSON line each way, oracle.py, whose print,
+// str and repr spell values the Starlark way - and must print the same
+// lines and fail or succeed alike.
+//
+// Needs python3 (3.12 or later).
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"go.starlark.net/resolve"
+	"go.starlark.net/starlark"
+	"go.starlark.net/syntax"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+	tracePath     = os.Getenv("HEGEL_TRACE")
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// trace writes the program about to run to HEGEL_TRACE, so a program that
+// kills the test binary is known afterwards.
+func trace(src string) {
+	if tracePath == "" {
+		return
+	}
+	f, err := os.Create(tracePath)
+	if err != nil {
+		return
+	}
+	f.WriteString(src)
+	f.Sync()
+	f.Close()
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// ---------------------------------------------------------------------------
+// Running a program: the same shape of result from both sides.
+
+// result is what running a program produced.
+type result struct {
+	status string   // "ok", "error" (a dynamic error), "syntax" (a static error), "timeout", "panic"
+	out    []string // the lines printed before the end or the error
+	err    string   // the error's message
+}
+
+func (r result) String() string {
+	s := r.status
+	if r.err != "" {
+		s += ": " + r.err
+	}
+	return s + "\n  " + strings.Join(r.out, "\n  ")
+}
+
+// fileOptions are the dialect options the programs run under: the
+// generated programs use if/for at top level and rebind globals, as Python
+// does.
+var fileOptions = &syntax.FileOptions{While: true, TopLevelControl: true, GlobalReassign: true}
+
+const maxSteps = 50_000_000
+
+// goRun runs the program in starlark-go.
+func goRun(src string) (res result) {
+	var out []string
+	defer func() {
+		if r := recover(); r != nil {
+			res = result{status: "panic", out: out, err: fmt.Sprintf("%v\n%s", r, libraryFrames(debug.Stack()))}
+		}
+	}()
+	thread := &starlark.Thread{Name: "hegel", Print: func(_ *starlark.Thread, msg string) { out = append(out, msg) }}
+	thread.SetMaxExecutionSteps(maxSteps)
+	_, err := starlark.ExecFileOptions(fileOptions, thread, "prog", src, nil)
+	if err == nil {
+		return result{status: "ok", out: out}
+	}
+	var evalErr *starlark.EvalError
+	var synErr syntax.Error
+	var resErr resolve.ErrorList
+	switch {
+	case errors.As(err, &evalErr):
+		if strings.Contains(evalErr.Msg, "too many steps") {
+			return result{status: "timeout", out: out, err: evalErr.Msg}
+		}
+		return result{status: "error", out: out, err: evalErr.Msg}
+	case errors.As(err, &synErr), errors.As(err, &resErr):
+		return result{status: "syntax", out: out, err: err.Error()}
+	}
+	return result{status: "error", out: out, err: err.Error()}
+}
+
+// libraryFrames keeps the frames of a panic stack that are in starlark-go.
+func libraryFrames(stack []byte) string {
+	var keep []string
+	lines := strings.Split(string(stack), "\n")
+	for i := 0; i+1 < len(lines); i++ {
+		if strings.Contains(lines[i+1], "go.starlark.net/") && !strings.Contains(lines[i+1], "/hegel/") {
+			keep = append(keep, strings.TrimSpace(lines[i]), strings.TrimSpace(lines[i+1]))
+		}
+	}
+	if len(keep) > 16 {
+		keep = keep[:16]
+	}
+	return strings.Join(keep, "\n")
+}
+
+// ---------------------------------------------------------------------------
+// The oracle: python3 in a child process, one JSON line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	cmd.Env = append(os.Environ(), "PYTHONDONTWRITEBYTECODE=1")
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// call sends one JSON request and returns the answer object.
+func (o *oracle) call(req map[string]any) (map[string]any, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return nil, o.err
+	}
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(line, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	resp, err := o.out.ReadBytes('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return nil, err
+	}
+	var m map[string]any
+	if err := json.Unmarshal(resp, &m); err != nil {
+		return nil, fmt.Errorf("%s oracle: bad answer %.200q: %v", o.name, resp, err)
+	}
+	if s, _ := m["status"].(string); s == "oracle" {
+		return nil, fmt.Errorf("%s oracle failed on %v: %v", o.name, req, m["error"])
+	}
+	return m, nil
+}
+
+var (
+	pyOnce sync.Once
+	py     *oracle
+)
+
+func pyOracle() *oracle {
+	pyOnce.Do(func() { py = startOracle("python", "python3", "-u", "oracle.py") })
+	return py
+}
+
+// pyRun runs the program in Python with Starlark's spelling of values.
+func pyRun(t testing.TB, src string) result {
+	m, err := pyOracle().call(map[string]any{"src": src})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	r := result{status: str(m["status"]), err: str(m["error"])}
+	lines, _ := m["out"].([]any)
+	for _, l := range lines {
+		r.out = append(r.out, str(l))
+	}
+	return r
+}
+
+func str(v any) string {
+	s, _ := v.(string)
+	return s
+}
+
+// numbered returns the program with line numbers, for failure reports.
+func numbered(src string) string {
+	var b strings.Builder
+	for i, l := range strings.Split(strings.TrimRight(src, "\n"), "\n") {
+		fmt.Fprintf(&b, "%3d| %s\n", i+1, l)
+	}
+	return b.String()
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..d3d5380
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,21 @@
+package hegel
+
+import "strings"
+
+// Known bugs of starlark-go at the pinned commit, gated so the property
+// stays green while they are open. Each rule names the zoo's bug id; the
+// pins in hegel_pins_test.go fail while the bug is open.
+
+// known returns the id of the bug that explains the case, or "".
+func known(src string, py, sl result) string {
+	_ = src
+	switch {
+	case py.status == "ok" && sl.status == "error" && strings.HasPrefix(sl.err, "repeat count -"):
+		// starlark-go/1: a negative repeat count below -2**31 is an error
+		// instead of an empty result.
+		return "starlark-go/1"
+	}
+	// starlark-go/2 (strip("") strips whitespace) is kept out by the
+	// generator: cutsets are non-empty literals.
+	return ""
+}
diff --git a/hegel/oracle.py b/hegel/oracle.py
new file mode 100644
index 0000000..fa93431
--- /dev/null
+++ b/hegel/oracle.py
@@ -0,0 +1,141 @@
+"""The Python oracle for the zoo's Starlark tests: runs a program that is
+both Python and Starlark, printing what Starlark would print.
+
+One JSON object per line on stdin, {"src": program}; one JSON object per
+line on stdout, {"status": "ok" | "error" | "syntax" | "timeout",
+"out": [lines printed so far], "error": "Type: message"}.
+
+Starlark's str and repr differ from Python's in spelling (strings are
+double-quoted, and str() of a container uses repr for its elements just
+like Python but with Starlark's spelling of strings), so the program runs
+with print, str and repr replaced by versions that spell values the
+Starlark way. The generator keeps the program to the shared subset where
+the two languages agree by design (no bool/int unification, no chained
+comparisons, strings never iterated, %-formatting and str.format only with
+scalar arguments and with no width or precision specifiers).
+"""
+import json
+import signal
+import sys
+
+sys.set_int_max_str_digits(0)
+sys.setrecursionlimit(3000)
+
+
+class Timeout(BaseException):
+    pass
+
+
+def on_alarm(signum, frame):
+    raise Timeout()
+
+
+signal.signal(signal.SIGALRM, on_alarm)
+
+
+def sl_quote(s):
+    out = ['"']
+    for ch in s:
+        if ch == '"':
+            out.append('\\"')
+        elif ch == "\\":
+            out.append("\\\\")
+        elif ch == "\n":
+            out.append("\\n")
+        elif ch == "\t":
+            out.append("\\t")
+        elif ch == "\r":
+            out.append("\\r")
+        elif ch == "\a":
+            out.append("\\a")
+        elif ch == "\b":
+            out.append("\\b")
+        elif ch == "\f":
+            out.append("\\f")
+        elif ch == "\v":
+            out.append("\\v")
+        elif ord(ch) < 0x20 or ord(ch) == 0x7F:
+            out.append("\\x%02x" % ord(ch))
+        else:
+            out.append(ch)
+    out.append('"')
+    return "".join(out)
+
+
+def sl_repr(x):
+    if x is None:
+        return "None"
+    if x is True:
+        return "True"
+    if x is False:
+        return "False"
+    if isinstance(x, int):
+        return str(x)
+    if isinstance(x, str):
+        return sl_quote(x)
+    if isinstance(x, list):
+        return "[" + ", ".join(sl_repr(e) for e in x) + "]"
+    if isinstance(x, tuple):
+        if len(x) == 1:
+            return "(" + sl_repr(x[0]) + ",)"
+        return "(" + ", ".join(sl_repr(e) for e in x) + ")"
+    if isinstance(x, dict):
+        return "{" + ", ".join(sl_repr(k) + ": " + sl_repr(v) for k, v in x.items()) + "}"
+    if isinstance(x, range):
+        if x.step == 1:
+            return "range(%d, %d)" % (x.start, x.stop)
+        return "range(%d, %d, %d)" % (x.start, x.stop, x.step)
+    if callable(x):
+        return "<function %s>" % getattr(x, "__name__", "?")
+    raise TypeError("unrepresentable value of type %s" % type(x).__name__)
+
+
+def sl_str(x):
+    if isinstance(x, str):
+        return x
+    return sl_repr(x)
+
+
+def run(src):
+    out = []
+
+    def sl_print(*args, sep=" "):
+        out.append(sep.join(sl_str(a) for a in args))
+
+    try:
+        code = compile(src, "prog", "exec")
+    except SyntaxError as e:
+        return {"status": "syntax", "out": out, "error": "SyntaxError: %s" % e}
+    ns = {"__builtins__": __builtins__, "print": sl_print, "str": sl_str, "repr": sl_repr}
+    signal.setitimer(signal.ITIMER_REAL, 10.0)
+    try:
+        exec(code, ns)
+    except Timeout:
+        return {"status": "timeout", "out": out, "error": "timeout"}
+    except RecursionError as e:
+        return {"status": "error", "out": out, "error": "RecursionError: %s" % e}
+    except MemoryError as e:
+        return {"status": "error", "out": out, "error": "MemoryError"}
+    except Exception as e:
+        return {"status": "error", "out": out, "error": "%s: %s" % (type(e).__name__, e)}
+    finally:
+        signal.setitimer(signal.ITIMER_REAL, 0)
+    return {"status": "ok", "out": out, "error": ""}
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            req = json.loads(line)
+            resp = run(req["src"])
+        except Exception as e:  # a failure of the oracle itself
+            resp = {"error": "oracle: %s: %s" % (type(e).__name__, e), "status": "oracle"}
+        sys.stdout.write(json.dumps(resp) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
