+// ---- Replace and Split against the match sequence ----
+
+// expand applies the documented substitution syntax to m over input.
+func expand(tmpl string, m *regexp2.Match, input string, p *pattern, re *regexp2.Regexp) string {
+	var sb strings.Builder
+	runes := []rune(input)
+	start, length := m.RuneIndex, m.RuneLength
+	grpText := func(grp *regexp2.Group) string {
+		if grp == nil || len(grp.Captures) == 0 {
+			return ""
+		}
+		return string(runes[grp.RuneIndex : grp.RuneIndex+grp.RuneLength])
+	}
+	for i := 0; i < len(tmpl); i++ {
+		c := tmpl[i]
+		if c != '$' || i+1 >= len(tmpl) {
+			sb.WriteByte(c)
+			continue
+		}
+		i++
+		switch d := tmpl[i]; {
+		case d == '$':
+			sb.WriteByte('$')
+		case d == '&':
+			sb.WriteString(string(runes[start : start+length]))
+		case d == '`':
+			sb.WriteString(string(runes[:start]))
+		case d == '\'':
+			sb.WriteString(string(runes[start+length:]))
+		case d == '_':
+			sb.WriteString(input)
+		case d == '{':
+			end := strings.IndexByte(tmpl[i:], '}')
+			name := tmpl[i+1 : i+end]
+			i += end
+			if num, err := strconv.Atoi(name); err == nil {
+				sb.WriteString(grpText(m.GroupByNumber(num)))
+			} else {
+				sb.WriteString(grpText(m.GroupByName(name)))
+			}
+		case d >= '0' && d <= '9':
+			sb.WriteString(grpText(m.GroupByNumber(int(d - '0'))))
+		default:
+			sb.WriteByte('$')
+			sb.WriteByte(d)
+		}
+	}
+	return sb.String()
+}
+
+// genTemplate draws a substitution template whose every $-reference exists.
+func genTemplate(tc hegel.TestCase, p *pattern) string {
+	var sb strings.Builder
+	for i, k := 0, n(tc, 0, 4); i < k; i++ {
+		switch n(tc, 0, 7) {
+		case 0, 1:
+			sb.WriteString(pick(tc, []string{"x", "-", "é", " "}))
+		case 2:
+			sb.WriteString("$$")
+		case 3:
+			sb.WriteString("$&")
+		case 4:
+			sb.WriteString(pick(tc, []string{"$`", "$'", "$_"}))
+		default:
+			if len(p.names) == 0 {
+				sb.WriteString("$0")
+				continue
+			}
+			k := n(tc, 1, len(p.names))
+			if nm := p.names[k-1]; nm != "" && chance(tc, 70) {
+				sb.WriteString("${" + nm + "}")
+			} else {
+				sb.WriteString(fmt.Sprintf("${%d}", p.netNumber(k)))
+			}
+		}
+	}
+	return sb.String()
+}
+
+// splitModel is Split's documented behaviour over the match sequence: the text between
+// matches, with the text of every participating capturing group (in .NET number order)
+// after each piece; count limits the matches used (-1 all, 0 nil, 1 the input).
+func splitModel(input string, ms []*regexp2.Match, count int, groups int) []string {
+	if count == 0 {
+		return nil
+	}
+	if count == 1 {
+		return []string{input}
+	}
+	runes := []rune(input)
+	if count > 0 && len(ms) > count-1 {
+		ms = ms[:count-1]
+	}
+	out := []string{}
+	prev := 0
+	for _, m := range ms {
+		out = append(out, string(runes[prev:m.RuneIndex]))
+		for k := 1; k <= groups; k++ {
+			if grp := m.GroupByNumber(k); grp != nil && len(grp.Captures) > 0 {
+				out = append(out, string(runes[grp.RuneIndex:grp.RuneIndex+grp.RuneLength]))
+			}
+		}
+		prev = m.RuneIndex + m.RuneLength
+	}
+	out = append(out, string(runes[prev:]))
+	return out
+}
+
+// TestHegelReplaceAndSplitFollowTheMatchSequence: Replace with a template, ReplaceFunc, and
+// Split equal their models over the FindStringMatch/FindNextMatch sequence; count limits apply.
+func TestHegelReplaceAndSplitFollowTheMatchSequence(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := genPattern(ht)
+		text := genText(ht)
+		re, err := regexp2.Compile(p.net, netOptions(p.flags))
+		if err != nil {
+			return
+		}
+		ms, err := chainMatches(re, text)
+		if err != nil {
+			note(ht, "chain: %v", err)
+			return
+		}
+		tmpl := genTemplate(ht, p)
+		count := pick(ht, []int{-1, -1, -1, 0, 1, 2, 3})
+		note(ht, "pattern=%q flags=%q text=%q tmpl=%q count=%d matches=%d", p.net, p.flags, text, tmpl, count, len(ms))
+		// Replace: every match (up to count) replaced by its expansion, the rest copied.
+		use := ms
+		if count >= 0 && len(use) > count {
+			use = use[:count]
+		}
+		runes := []rune(text)
+		var sb strings.Builder
+		prev := 0
+		for _, m := range use {
+			sb.WriteString(string(runes[prev:m.RuneIndex]))
+			sb.WriteString(expand(tmpl, m, text, p, re))
+			prev = m.RuneIndex + m.RuneLength
+		}
+		sb.WriteString(string(runes[prev:]))
+		want := sb.String()
+		got, err := re.Replace(text, tmpl, -1, count)
+		if err != nil {
+			fail(ht, "Replace(%q, %q, -1, %d) with %q: %v", text, tmpl, count, p.net, err)
+		}
+		gotF, err := re.ReplaceFunc(text, func(m regexp2.Match) string { return expand(tmpl, &m, text, p, re) }, -1, count)
+		if err != nil {
+			fail(ht, "ReplaceFunc: %v", err)
+		}
+		if count == 0 {
+			// Pinned (regexp2/3): count 0 returns "" instead of the input.
+			note(ht, "count 0: Replace %q, ReplaceFunc %q (regexp2/3)", got, gotF)
+		} else {
+			if got != want {
+				fail(ht, "Replace(%q, %q, -1, %d) with %q = %q, the match sequence gives %q", text, tmpl, count, p.net, got, want)
+			}
+			if gotF != want {
+				fail(ht, "ReplaceFunc(%q, %q, -1, %d) with %q = %q, the match sequence gives %q", text, tmpl, count, p.net, gotF, want)
+			}
+		}
+		// Split: counts above 1 are pinned (regexp2/4: count splits instead of count-1).
+		gotS, err := re.Split(text, count)
+		if err != nil {
+			fail(ht, "Split(%q, %d) with %q: %v", text, count, p.net, err)
+		}
+		unmatchedGroup := false
+		for _, m := range ms {
+			for k := 1; k <= len(p.names); k++ {
+				if grp := m.GroupByNumber(k); grp == nil || len(grp.Captures) == 0 {
+					unmatchedGroup = true
+				}
+			}
+		}
+		if count > 1 {
+			note(ht, "Split count %d: %q (regexp2/4)", count, gotS)
+		} else if unmatchedGroup {
+			// Pinned (regexp2/5): an empty string is added for every group that did not take part.
+			note(ht, "Split with a non-participating group: %q (regexp2/5)", gotS)
+		} else if wantS := splitModel(text, ms, count, len(p.names)); !reflect.DeepEqual(gotS, wantS) {
+			fail(ht, "Split(%q, %d) with %q = %q, the match sequence gives %q", text, count, p.net, gotS, wantS)
+		}
+	})
+}
