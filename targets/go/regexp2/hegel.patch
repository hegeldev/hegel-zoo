+// TestHegelPinAlternationKeepsTheLiteralBranch pins regexp2/1: when a branch beginning with a
+// literal or a positive class precedes a branch beginning with `.` or a negated class, the
+// first-character filter excludes the literal's characters, so the literal branch (and any
+// match starting with those characters) is never found.
+func TestHegelPinAlternationKeepsTheLiteralBranch(t *testing.T) {
+	defer guard(t)
+	for _, tt := range []struct {
+		p, s string
+		want string // "index+length" of the leftmost match
+	}{
+		{"a|.", "a", "0+1"},
+		{"a|.", "ba", "0+1"},
+		{"a|.+", "a", "0+1"},
+		{"x|a|.", "xa", "0+1"},
+		{`a|[^x]`, "a", "0+1"},
+		{`\\.|[^"\\]`, `\"`, "0+2"},
+		{"(a)|.", "a", "0+1"},
+		{"a*.", "a", "0+1"},
+		{"(a||b)+.", "b", "0+1"},
+		{"é|.", "é", "0+1"},
+	} {
+		for _, opt := range []regexp2.RegexOptions{regexp2.None, regexp2.RE2} {
+			re, err := regexp2.Compile(tt.p, opt)
+			if err != nil {
+				if opt == regexp2.RE2 {
+					continue
+				}
+				t.Fatalf("Compile(%q): %v", tt.p, err)
+			}
+			m, err := re.FindStringMatch(tt.s)
+			if err != nil {
+				t.Fatalf("FindStringMatch: %v", err)
+			}
+			got := "none"
+			if m != nil {
+				got = fmt.Sprintf("%d+%d", m.RuneIndex, m.RuneLength)
+			}
+			if got != tt.want {
+				t.Errorf("%q (options %v) on %q: match %s, want %s", tt.p, opt, tt.s, got, tt.want)
+			}
+		}
+	}
+}
