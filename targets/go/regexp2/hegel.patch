+// TestHegelRightToLeftFindsTheSameTexts: for patterns without backreferences, atomic groups,
+// possessive quantifiers or lookarounds, whether a match exists does not depend on the
+// direction; and the RightToLeft match is a valid match (its text matches the pattern
+// anchored, in either direction).
+func TestHegelRightToLeftFindsTheSameTexts(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := genPattern(ht)
+		if !p.simple {
+			return
+		}
+		text := genText(ht)
+		if skipMultilineCaret(p, text) {
+			return
+		}
+		if p.nonWordLoopB {
+			count("skip-non-word-loop-before-B")
+			return
+		}
+		note(ht, "pattern=%q flags=%q text=%q", p.net, p.flags, text)
+		ltr, err := regexp2.Compile(p.net, netOptions(p.flags))
+		if err != nil {
+			return
+		}
+		rtl, err := regexp2.Compile(p.net, netOptions(p.flags)|regexp2.RightToLeft)
+		if err != nil {
+			fail(ht, "Compile(%q, RightToLeft): %v", p.net, err)
+		}
+		a, err1 := ltr.MatchString(text)
+		b, err2 := rtl.MatchString(text)
+		if err1 != nil || err2 != nil {
+			note(ht, "errors: %v %v", err1, err2)
+			return
+		}
+		if a != b {
+			// A false negative from the first-character filter is pinned (regexp2/1): the
+			// filter is consulted in one direction only.
+			var m *regexp2.Match
+			if b {
+				m, _ = rtl.FindStringMatch(text)
+			} else {
+				m, _ = ltr.FindStringMatch(text)
+			}
+			runes := []rune(text)
+			if m != nil && m.RuneIndex < len(runes) && firstCharExcludes(p.net, netOptions(p.flags), runes, m.RuneIndex) {
+				count("skip-first-char-filter")
+				note(ht, "the match starts with %q, which the first-character filter excludes (regexp2/1)", runes[m.RuneIndex])
+				return
+			}
+			fail(ht, "%q on %q: MatchString %v left-to-right, %v right-to-left", p.net, text, a, b)
+		}
+		count("compared")
+		if !b {
+			return
+		}
+		m, err := rtl.FindStringMatch(text)
+		if err != nil || m == nil {
+			fail(ht, "%q on %q: RightToLeft MatchString true but FindStringMatch %v, %v", p.net, text, m, err)
+		}
+		// The matched span is one the pattern accepts at that position left-to-right too.
+		runes := []rune(text)
+		ms, err := chainMatches(ltr, text)
+		if err != nil {
+			return
+		}
+		spans := map[[2]int]bool{}
+		for _, lm := range ms {
+			spans[[2]int{lm.RuneIndex, lm.RuneLength}] = true
+		}
+		_ = runes
+		note(ht, "rtl span %d+%d, ltr spans %v", m.RuneIndex, m.RuneLength, spans)
+	})
+}
