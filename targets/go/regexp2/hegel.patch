+// TestHegelPinNonBoundaryAfterANonWordLoopBacktracks (regexp2/8): a greedy loop of non-word
+// characters followed by \B is made atomic, so the loop never gives back a character to put
+// \B between two non-word characters.
+func TestHegelPinNonBoundaryAfterANonWordLoopBacktracks(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		pattern, text string
+		want          []int // index, length of every match in the chain
+	}{
+		{`\D+\B`, "ba", []int{0, 1}},
+		{`\D+\B|a`, "ba", []int{0, 1, 1, 1}},
+		{`(\D+)\B`, "ba", []int{0, 1}},
+		{`\D{1,2}\B`, "ba", []int{0, 1}},
+		{`[\D]+\B`, "ba", []int{0, 1}},
+		{`\W+\B`, "--a", []int{0, 1}},
+		{`\W{2,}\B`, "---a", []int{0, 2}},
+		{`-+\B`, "--a", []int{0, 1}},
+		{`-{1,3}\B`, "--a", []int{0, 1}},
+		{` +\B`, "  a", []int{0, 1}},
+		{`\D+\B(?:)`, "ba", []int{0, 1}},
+	}
+	for _, c := range cases {
+		for _, opts := range []regexp2.RegexOptions{regexp2.None, regexp2.RE2} {
+			re, err := regexp2.Compile(c.pattern, opts)
+			if err != nil {
+				t.Fatalf("Compile(%q, %d): %v", c.pattern, opts, err)
+			}
+			ms, err := chainMatches(re, c.text)
+			if err != nil {
+				t.Fatalf("%q on %q: %v", c.pattern, c.text, err)
+			}
+			var got []int
+			for _, m := range ms {
+				got = append(got, m.RuneIndex, m.RuneLength)
+			}
+			if !reflect.DeepEqual(got, c.want) {
+				t.Errorf("%q (options %d) on %q: matches (index, length) %v, want %v", c.pattern, opts, c.text, got, c.want)
+			}
+		}
+	}
+	// The lazy and the zero-minimum loops are not made atomic and behave.
+	for _, pat := range []string{`\D+?\B`, `\D*\B`, `-+?\B`} {
+		re := regexp2.MustCompile(pat, regexp2.None)
+		if m, _ := re.FindStringMatch(strings.Repeat("-", 2) + "a"); pat != `\D*\B` && (m == nil || m.RuneIndex != 0 || m.RuneLength != 1) {
+			t.Errorf("%q on %q: %v", pat, "--a", m)
+		}
+	}
+}
+
+func TestHegelExamples(t *testing.T) {
+	re := regexp2.MustCompile(`(?<y>\d{4})-(\d{2})`, regexp2.None)
+	m, err := re.FindStringMatch("on 2024-05 and 2025-06")
+	if err != nil || m == nil || m.String() != "2024-05" || m.GroupByName("y").String() != "2024" {
+		t.Fatalf("FindStringMatch: %v %v", m, err)
+	}
+	if got := re.GetGroupNames(); !reflect.DeepEqual(got, []string{"0", "1", "y"}) {
+		t.Errorf("GetGroupNames = %q", got)
+	}
+	out, err := re.Replace("on 2024-05 and 2025-06", "${y}/$1", -1, -1)
+	if err != nil || out != "on 2024/05 and 2025/06" {
+		t.Errorf("Replace = %q, %v", out, err)
+	}
+	parts, err := regexp2.MustCompile(`(-)`, regexp2.None).Split("a-b", -1)
+	if err != nil || !reflect.DeepEqual(parts, []string{"a", "-", "b"}) {
+		t.Errorf("Split = %q, %v", parts, err)
+	}
+}
