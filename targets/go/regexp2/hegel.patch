+// ---- RE2 mode vs Go's regexp, through the compat adapter ----
+
+func byteIndex(text string, runeIdx int) int {
+	i := 0
+	for k := 0; k < runeIdx; k++ {
+		_, sz := utf8.DecodeRuneInString(text[i:])
+		i += sz
+	}
+	return i
+}
+
+// TestHegelCompatAdapterMatchesGoRegexp: on the RE2-expressible subset, every compat method
+// returns what regexp's does.
+func TestHegelCompatAdapterMatchesGoRegexp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := genPattern(ht)
+		if !p.re2ok {
+			return
+		}
+		text := genText(ht)
+		src := p.re2
+		if p.flags != "" {
+			src = "(?" + p.flags + ")" + src
+		}
+		note(ht, "pattern=%q text=%q", src, text)
+		std, serr := regexp.Compile(src)
+		copts := []regexp2.CompileOption{regexp2.RE2}
+		named, unnamed := false, false
+		for _, nm := range p.names {
+			if nm == "" {
+				unnamed = true
+			} else {
+				named = true
+			}
+		}
+		if named && unnamed {
+			// Pinned (regexp2/7): without it the submatch order is .NET's, not regexp's.
+			count("maintain-capture-order")
+			copts = append(copts, regexp2.OptionMaintainCaptureOrder())
+		}
+		re, err := compat.Compile(src, copts...)
+		if serr != nil {
+			if err == nil {
+				note(ht, "regexp rejects %q (%v), regexp2 RE2 accepts", src, serr)
+			}
+			return
+		}
+		if err != nil {
+			fail(ht, "compat.Compile(%q, RE2) fails: %v; regexp accepts", src, err)
+		}
+		if p.nullLoop {
+			// RE2 rejects an empty loop iteration, .NET takes one: "(?:a*?|b*?)*b+?" on "abb"
+			// is [0 3] for regexp and [0 2] for regexp2 (and Perl) — a difference between the
+			// two families, not judged.
+			count("skip-null-loop")
+			return
+		}
+		if p.nonWordLoopB {
+			count("skip-non-word-loop-before-B")
+			note(ht, `\B after a loop of non-word characters: pinned (regexp2/8), not judged`)
+			return
+		}
+		if p.wordBoundary && strings.ContainsAny(text, "éÉ日") {
+			// Pinned (regexp2/6): \b in RE2 mode treats non-ASCII letters as word characters.
+			count("skip-word-boundary-non-ascii")
+			note(ht, `\b with non-ASCII letters in the text: not judged (regexp2/6)`)
+			return
+		}
+		for _, loc := range std.FindAllStringIndex(text, -1) {
+			if loc[0] < len(text) {
+				if r, _ := utf8.DecodeRuneInString(text[loc[0]:]); firstCharExcludes(src, regexp2.RE2, []rune(text), utf8.RuneCountInString(text[:loc[0]])) {
+					count("skip-first-char-filter")
+					note(ht, "a regexp match starts with %q, which the first-character filter excludes (regexp2/1)", r)
+					return
+				}
+			}
+		}
+		count("compared")
+		b := []byte(text)
+		check := func(what string, got, want any) {
+			// A nil slice from regexp against an empty one from compat is pinned (regexp2/2).
+			gv, wv := reflect.ValueOf(got), reflect.ValueOf(want)
+			if gv.IsValid() && gv.Kind() == reflect.Slice && wv.IsValid() && wv.Kind() == reflect.Slice && gv.Len() == 0 && wv.Len() == 0 && gv.IsNil() != wv.IsNil() {
+				count("nil-vs-empty:" + what)
+				note(ht, "%s: compat %#v, regexp %#v (regexp2/2)", what, got, want)
+				return
+			}
+			if !reflect.DeepEqual(got, want) {
+				fail(ht, "%s: compat %v, regexp %v (pattern %q, text %q)", what, got, want, src, text)
+			}
+		}
+		check("MatchString", re.MatchString(text), std.MatchString(text))
+		check("Match", re.Match(b), std.Match(b))
+		check("MatchReader", re.MatchReader(strings.NewReader(text)), std.MatchReader(strings.NewReader(text)))
+		check("FindStringIndex", re.FindStringIndex(text), std.FindStringIndex(text))
+		check("FindString", re.FindString(text), std.FindString(text))
+		check("FindIndex", re.FindIndex(b), std.FindIndex(b))
+		check("Find", re.Find(b), std.Find(b))
+		check("FindReaderIndex", re.FindReaderIndex(strings.NewReader(text)), std.FindReaderIndex(strings.NewReader(text)))
+		check("FindStringSubmatchIndex", re.FindStringSubmatchIndex(text), std.FindStringSubmatchIndex(text))
+		check("FindStringSubmatch", re.FindStringSubmatch(text), std.FindStringSubmatch(text))
+		check("FindSubmatchIndex", re.FindSubmatchIndex(b), std.FindSubmatchIndex(b))
+		check("FindSubmatch", re.FindSubmatch(b), std.FindSubmatch(b))
+		check("FindReaderSubmatchIndex", re.FindReaderSubmatchIndex(strings.NewReader(text)), std.FindReaderSubmatchIndex(strings.NewReader(text)))
+		for _, lim := range []int{-1, 0, 1, 2} {
+			tag := fmt.Sprintf("(n=%d)", lim)
+			check("FindAllStringIndex"+tag, re.FindAllStringIndex(text, lim), std.FindAllStringIndex(text, lim))
+			check("FindAllString"+tag, re.FindAllString(text, lim), std.FindAllString(text, lim))
+			check("FindAllIndex"+tag, re.FindAllIndex(b, lim), std.FindAllIndex(b, lim))
+			check("FindAll"+tag, re.FindAll(b, lim), std.FindAll(b, lim))
+			check("FindAllStringSubmatchIndex"+tag, re.FindAllStringSubmatchIndex(text, lim), std.FindAllStringSubmatchIndex(text, lim))
+			check("FindAllStringSubmatch"+tag, re.FindAllStringSubmatch(text, lim), std.FindAllStringSubmatch(text, lim))
+			check("FindAllSubmatchIndex"+tag, re.FindAllSubmatchIndex(b, lim), std.FindAllSubmatchIndex(b, lim))
+			check("FindAllSubmatch"+tag, re.FindAllSubmatch(b, lim), std.FindAllSubmatch(b, lim))
+		}
+		// The underlying Regexp's own FindAllStringIndex too.
+		locs, err := re.Unwrap().FindAllStringIndex(text, -1)
+		if err != nil {
+			fail(ht, "FindAllStringIndex: %v", err)
+		}
+		check("Regexp.FindAllStringIndex", locs, std.FindAllStringIndex(text, -1))
+		// String() is the source.
+		check("String", re.String(), src)
+	})
+}
