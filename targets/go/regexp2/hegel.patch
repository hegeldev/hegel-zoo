+// TestHegelGroupNumberingFollowsTheDotNetRule: unnamed groups first in textual order, then
+// named ones; the name tables and the two lookups agree with that; with
+// OptionMaintainCaptureOrder every group keeps its textual number.
+func TestHegelGroupNumberingFollowsTheDotNetRule(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := genPattern(ht)
+		re, err := regexp2.Compile(p.net, netOptions(p.flags))
+		if err != nil {
+			return
+		}
+		note(ht, "pattern=%q names=%q", p.net, p.names)
+		wantNums := []int{0}
+		wantNames := []string{"0"}
+		byNumber := map[int]string{0: "0"}
+		for k := 1; k <= len(p.names); k++ {
+			wantNums = append(wantNums, k)
+		}
+		unnamed := 0
+		for _, nm := range p.names {
+			if nm == "" {
+				unnamed++
+				byNumber[unnamed] = strconv.Itoa(unnamed)
+			}
+		}
+		named := 0
+		for _, nm := range p.names {
+			if nm != "" {
+				named++
+				byNumber[unnamed+named] = nm
+			}
+		}
+		for k := 1; k <= len(p.names); k++ {
+			wantNames = append(wantNames, byNumber[k])
+		}
+		if got := re.GetGroupNumbers(); !reflect.DeepEqual(got, wantNums) {
+			fail(ht, "GetGroupNumbers of %q = %v, want %v", p.net, got, wantNums)
+		}
+		if got := re.GetGroupNames(); !reflect.DeepEqual(got, wantNames) {
+			fail(ht, "GetGroupNames of %q = %q, want %q", p.net, got, wantNames)
+		}
+		for num, nm := range byNumber {
+			if got := re.GroupNameFromNumber(num); got != nm {
+				fail(ht, "GroupNameFromNumber(%d) of %q = %q, want %q", num, p.net, got, nm)
+			}
+			if got := re.GroupNumberFromName(nm); got != num {
+				fail(ht, "GroupNumberFromName(%q) of %q = %d, want %d", nm, p.net, got, num)
+			}
+		}
+		if got := re.GroupNumberFromName("nope"); got != -1 {
+			fail(ht, "GroupNumberFromName(\"nope\") of %q = %d, want -1", p.net, got)
+		}
+		if got := re.GroupNameFromNumber(len(p.names) + 1); got != "" {
+			fail(ht, "GroupNameFromNumber(%d) of %q = %q, want \"\"", len(p.names)+1, p.net, got)
+		}
+		// Textual order when asked for.
+		reT, err := regexp2.Compile(p.net, netOptions(p.flags), regexp2.OptionMaintainCaptureOrder())
+		if err != nil {
+			fail(ht, "Compile with OptionMaintainCaptureOrder: %v", err)
+		}
+		wantT := []string{"0"}
+		for k, nm := range p.names {
+			if nm == "" {
+				nm = strconv.Itoa(k + 1)
+			}
+			wantT = append(wantT, nm)
+		}
+		if got := reT.GetGroupNames(); !reflect.DeepEqual(got, wantT) {
+			fail(ht, "GetGroupNames of %q with OptionMaintainCaptureOrder = %q, want %q", p.net, got, wantT)
+		}
+	})
+}
