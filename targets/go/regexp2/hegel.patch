+// TestHegelEscapeRoundTrips: Escape(s) compiled matches exactly s, and Unescape inverts it.
+func TestHegelEscapeRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var sb strings.Builder
+		for i, k := 0, n(ht, 0, 8); i < k; i++ {
+			sb.WriteString(pick(ht, []string{"a", ".", "*", "+", "?", "(", ")", "[", "]", "{", "}", "|", "^", "$", `\`, "#", " ", "\n", "\t", "é", "😀", "-", "0", "1", "#"}))
+		}
+		s := sb.String()
+		esc := regexp2.Escape(s)
+		re, err := regexp2.Compile(`\A(?:`+esc+`)\z`, regexp2.None)
+		if err != nil {
+			fail(ht, "Escape(%q) = %q does not compile: %v", s, esc, err)
+		}
+		ok, err := re.MatchString(s)
+		if err != nil || !ok {
+			fail(ht, "Escape(%q) = %q does not match its source: %v %v", s, esc, ok, err)
+		}
+		if len(s) > 0 {
+			other := s + "x"
+			if ok, _ := re.MatchString(other); ok {
+				fail(ht, "Escape(%q) = %q matches %q", s, esc, other)
+			}
+		}
+		// Escaped text under IgnorePatternWhitespace still matches (the escape is documented
+		// to make the text safe for any option set).
+		reX, err := regexp2.Compile(`\A(?:`+esc+`)\z`, regexp2.IgnorePatternWhitespace)
+		if err != nil {
+			fail(ht, "Escape(%q) = %q does not compile with IgnorePatternWhitespace: %v", s, esc, err)
+		}
+		if ok, _ := reX.MatchString(s); !ok {
+			fail(ht, "Escape(%q) = %q does not match its source under IgnorePatternWhitespace", s, esc)
+		}
+		un, err := regexp2.Unescape(esc)
+		if err != nil || un != s {
+			fail(ht, "Unescape(Escape(%q) = %q) = %q, %v", s, esc, un, err)
+		}
+	})
+}
