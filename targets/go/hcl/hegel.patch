+// ---------------------------------------------------------------------------
+// Structure at position.
+
+// posAt converts a byte offset into an hcl.Pos over src.
+func posAt(src []byte, off int) hcl.Pos {
+	line, col := 1, 1
+	for i := 0; i < off && i < len(src); i++ {
+		if src[i] == '\n' {
+			line++
+			col = 1
+		} else if src[i]&0xc0 != 0x80 {
+			col++
+		}
+	}
+	return hcl.Pos{Line: line, Column: col, Byte: off}
+}
+
+// TestHegelStructureAtPosFindsTheEnclosingItems: for positions inside an
+// attribute or a block, the at-position lookups return the items whose
+// ranges contain the position.
+func TestHegelStructureAtPosFindsTheEnclosingItems(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, _, _ := genConfig(ht)
+		src := []byte(spellNative(ht, b, false))
+		note(ht, "source:\n%s", src)
+		f := parseConfig(ht, string(src), "the generated file")
+		body := f.Body.(*hclsyntax.Body)
+		// Collect attributes and block chains from the parsed tree (the
+		// ranges are the oracle; the parse was checked elsewhere).
+		type item struct {
+			attr  *hclsyntax.Attribute
+			chain []*hclsyntax.Block
+		}
+		var items []item
+		var walk func(hb *hclsyntax.Body, chain []*hclsyntax.Block)
+		walk = func(hb *hclsyntax.Body, chain []*hclsyntax.Block) {
+			for _, a := range hb.Attributes {
+				items = append(items, item{attr: a, chain: chain})
+			}
+			for _, blk := range hb.Blocks {
+				c := append(append([]*hclsyntax.Block{}, chain...), blk)
+				items = append(items, item{chain: c})
+				walk(blk.Body, c)
+			}
+		}
+		walk(body, nil)
+		if len(items) == 0 {
+			ht.Assume(false)
+			return
+		}
+		it := items[n(ht, 0, len(items)-1)]
+		var rng hcl.Range
+		if it.attr != nil {
+			rng = it.attr.SrcRange
+		} else {
+			// The header of the innermost block: from its type to its
+			// opening brace.
+			blk := it.chain[len(it.chain)-1]
+			rng = hcl.Range{Start: blk.TypeRange.Start, End: blk.OpenBraceRange.End}
+		}
+		if rng.End.Byte <= rng.Start.Byte {
+			ht.Assume(false)
+			return
+		}
+		off := n(ht, rng.Start.Byte, rng.End.Byte-1)
+		pos := posAt(src, off)
+		note(ht, "position %v (byte %d, %q)", pos, off, src[off:min(off+10, len(src))])
+		if it.attr != nil {
+			got := f.AttributeAtPos(pos)
+			if got == nil || got.Range != it.attr.SrcRange {
+				fail(ht, "AttributeAtPos(%v) = %v, expected the attribute %q at %s\nsource:\n%s", pos, describeAttr(got), it.attr.Name, it.attr.SrcRange, src)
+			}
+		} else if got := f.AttributeAtPos(pos); got != nil {
+			fail(ht, "AttributeAtPos(%v) = %s inside a block header\nsource:\n%s", pos, describeAttr(got), src)
+		}
+		blocks := f.BlocksAtPos(pos)
+		if len(blocks) != len(it.chain) {
+			fail(ht, "BlocksAtPos(%v) has %d blocks, expected %d\nsource:\n%s", pos, len(blocks), len(it.chain), src)
+		}
+		for i, blk := range blocks {
+			if blk.DefRange != it.chain[i].DefRange() {
+				fail(ht, "BlocksAtPos(%v)[%d] is %s, expected %s\nsource:\n%s", pos, i, blk.DefRange, it.chain[i].DefRange(), src)
+			}
+		}
+		outer := f.OutermostBlockAtPos(pos)
+		inner := f.InnermostBlockAtPos(pos)
+		if len(it.chain) == 0 {
+			if outer != nil || inner != nil {
+				fail(ht, "block lookups at %v find blocks outside any block\nsource:\n%s", pos, src)
+			}
+		} else {
+			if outer == nil || outer.DefRange != it.chain[0].DefRange() {
+				fail(ht, "OutermostBlockAtPos(%v) is %v, expected %s\nsource:\n%s", pos, outer, it.chain[0].DefRange(), src)
+			}
+			if inner == nil || inner.DefRange != it.chain[len(it.chain)-1].DefRange() {
+				fail(ht, "InnermostBlockAtPos(%v) is %v, expected %s\nsource:\n%s", pos, inner, it.chain[len(it.chain)-1].DefRange(), src)
+			}
+		}
+		// The outermost expression at a position inside an attribute's
+		// expression is that expression.
+		if it.attr != nil {
+			er := it.attr.Expr.Range()
+			if er.End.Byte > er.Start.Byte {
+				eoff := n(ht, er.Start.Byte, er.End.Byte-1)
+				epos := posAt(src, eoff)
+				got := f.OutermostExprAtPos(epos)
+				if got == nil || got.Range() != er {
+					gotR := "nil"
+					if got != nil {
+						gotR = got.Range().String()
+					}
+					fail(ht, "OutermostExprAtPos(%v) is %s, expected %s (attribute %q)\nsource:\n%s", epos, gotR, er, it.attr.Name, src)
+				}
+			}
+		}
+	})
+}
+
+func describeAttr(a *hcl.Attribute) string {
+	if a == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("%q at %s", a.Name, a.Range)
+}
