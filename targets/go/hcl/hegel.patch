+// TestHegelWriterKeepsEscapedLabels: hclwrite's Labels() lists every label
+// of a parsed block (the oracle of TestHegelWriterAgreesWithFormat).
+func TestHegelWriterKeepsEscapedLabels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, escapedLabelCases)
+		src := []byte(spell(c.body, c.tape).src)
+		note(ht, "source:\n%s", src)
+		parseConfig(ht, string(src), "the generated file")
+		wf, diags := hclwrite.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclwrite.ParseConfig rejects what hclsyntax accepts:\n%s\n  %s", src, diagText(diags))
+		}
+		if msg, shapes := checkWriterBody(wf.Body(), c.body, evalContext(c.sc), c.sc, "file"); msg != "" {
+			mismatch(ht, shapes, "%s\nsource:\n%s", msg, src)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// hcl/3: a comment between a block's type and its first label.
+
+// headerCase: a block header with a block comment after the type (at 0) or
+// after the labels (at 1), around a body of attributes.
+type headerCase struct {
+	sc      *scope
+	typ     string
+	labels  []label
+	comment string
+	at      int
+	body    *body
+	tape    []int
+}
+
+func (c headerCase) source() string {
+	var parts []string
+	for _, l := range c.labels {
+		if l.quoted {
+			parts = append(parts, quoteNative(l.text, false))
+		} else {
+			parts = append(parts, l.text)
+		}
+	}
+	header := c.typ + " " + strings.Join(parts, " ")
+	if c.at == 0 {
+		header = c.typ + " " + c.comment + " " + strings.Join(parts, " ")
+	} else {
+		header += " " + c.comment
+	}
+	return header + " {\n" + spell(c.body, c.tape).src + "}\n"
+}
+
+func (c headerCase) GoString() string {
+	return fmt.Sprintf("source:\n%s\nvariables:\n%s", c.source(), c.sc.describe())
+}
+
+var headerComments = hegel.SampledFrom([]string{"/* c */", "/**/", "/* ${x} %{y} */", "/* \u65e5\u672c */", "/* a\nb */"})
+
+// headerCases: a block with one or two labels and a comment after the type
+// (after the labels under HEGEL_NO_KNOWN=1).
+var headerCases = hegel.FlatMap(envs, func(sc *scope) hegel.Generator[headerCase] {
+	bodies := newBodyGrammar(sc).bodies(1, 0, 0)
+	return hegel.Composite(func(tc hegel.TestCase) headerCase {
+		return headerCase{sc: sc, typ: hegel.Draw(tc, blockTypes), labels: hegel.Draw(tc, many(labels, 1, 2)), comment: hegel.Draw(tc, headerComments), at: shaped(0, 1), body: hegel.Draw(tc, bodies), tape: hegel.Draw(tc, tapes)}
+	})
+})
+
+// TestHegelWriterKeepsCommentAfterBlockType: hclwrite.ParseConfig(src).Bytes()
+// is hclwrite.Format(src), comments included (the oracle of
+// TestHegelWriterAgreesWithFormat).
+func TestHegelWriterKeepsCommentAfterBlockType(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, headerCases)
+		src := []byte(c.source())
+		note(ht, "source:\n%s", src)
+		parseConfig(ht, string(src), "the generated file")
+		wf, diags := hclwrite.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclwrite.ParseConfig rejects what hclsyntax accepts:\n%s\n  %s", src, diagText(diags))
+		}
+		if formatted := hclwrite.Format(src); !bytes.Equal(wf.Bytes(), formatted) {
+			mismatch(ht, known("hcl/3"), "hclwrite.ParseConfig(src).Bytes() differs from Format(src):\nsource:\n%s\nbytes:\n%s\nformat:\n%s", src, wf.Bytes(), formatted)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// hcl/4: JustAttributes on the body PartialContent leaves after extracting
+// blocks.
+
+// extractedCase: a configuration whose blocks (none under HEGEL_NO_KNOWN=1)
+// and some attributes are extracted, the rest left for JustAttributes.
+type extractedCase struct {
+	config
+	split []int
+}
+
+var extractedCases = hegel.FlatMap(envs, func(sc *scope) hegel.Generator[extractedCase] {
+	bg := newBodyGrammar(sc)
+	attrItems := hegel.Map(bg.attrs(1), func(a *attr) item { return item{attr: a} })
+	blockItems := shaped(many(bg.blocks(1, 1), 1, 2), hegel.Just[[]item](nil))
+	return hegel.Composite(func(tc hegel.TestCase) extractedCase {
+		items := append(hegel.Draw(tc, many(attrItems, 0, 3)), hegel.Draw(tc, blockItems)...)
+		return extractedCase{config{sc: sc, body: assemble(items), tape: hegel.Draw(tc, tapes)}, hegel.Draw(tc, tapes)}
+	})
+})
+
+// TestHegelJustAttributesIgnoresExtractedBlocks: after PartialContent has
+// extracted every block, the remaining body has just attributes (the oracle
+// of TestHegelPartialContentLeavesTheRest).
+func TestHegelJustAttributesIgnoresExtractedBlocks(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, extractedCases)
+		b, sc := c.body, c.sc
+		ctx := evalContext(sc)
+		// Every block to the first side, attributes as the tape says.
+		b1, b2 := &body{}, &body{}
+		t := &tape{vals: c.split}
+		for _, a := range b.attrs {
+			side := b1
+			if t.coin(50) {
+				side = b2
+			}
+			side.attrs = append(side.attrs, a)
+			side.order = append(side.order, len(side.attrs)-1)
+		}
+		for _, blk := range b.blocks {
+			b1.blocks = append(b1.blocks, blk)
+			b1.order = append(b1.order, -len(b1.blocks))
+		}
+		src := spell(b, c.tape).src
+		note(ht, "native:\n%s", src)
+		f := parseConfig(ht, src, "the generated file")
+		content, remain, diags := f.Body.PartialContent(schemaOf(b1))
+		if diags.HasErrors() {
+			fail(ht, "PartialContent fails: %s\nnative:\n%s", diagText(diags), src)
+		}
+		if msg, shapes := checkContentOf(content, b1, ctx, sc, "partial"); msg != "" {
+			mismatch(ht, shapes, "%s\nnative:\n%s", msg, src)
+		}
+		if msg, shapes := checkContent(remain, b2, ctx, sc, "remain"); msg != "" {
+			mismatch(ht, shapes, "%s\nnative:\n%s", msg, src)
+		}
+		attrs, diags := remain.JustAttributes()
+		if diags.HasErrors() {
+			mismatch(ht, known("hcl/4"), "JustAttributes on the remaining body fails: %s\nnative:\n%s", diagText(diags), src)
+		}
+		if len(attrs) != len(b2.attrs) {
+			mismatch(ht, known("hcl/4"), "JustAttributes on the remaining body has %d attributes, expected %d\nnative:\n%s", len(attrs), len(b2.attrs), src)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// hcl/5: an hclwrite edit that adds to a one-line block.
+
+// oneLineCase: a file of one block of at most one attribute, spelled on one
+// line (multi-line under HEGEL_NO_KNOWN=1), and an edit adding an attribute
+// or a block to it.
+type oneLineCase struct {
+	config
+	edit edit
+}
+
+func (c oneLineCase) GoString() string {
+	return c.config.GoString() + "edit: " + c.edit.String() + "\n"
+}
+
+// addingEdits: set an attribute of a fresh name, or append a block, inside
+// the file's first block.
+var addingEdits = hegel.Map(hegel.OneOf(
+	hegel.Map(pairs(hegel.Map(freshIdents, func(s string) string { return s + "_new" }), setters), func(p pair[string, wattr]) edit {
+		p.b.name = p.a
+		return edit{kind: setAttr, attr: p.b}
+	}),
+	hegel.Map(wblocksOf(nil), func(b *wblock) edit { return edit{kind: appendBlock, blk: b} }),
+), func(e edit) edit {
+	e.path = []int{0}
+	return e
+})
+
+// plainLabels: labels without the shape of hcl/2 (a label hclwrite drops
+// keeps FirstMatchingBlock from finding the block, so the edit would not
+// happen).
+var plainLabels = hegel.Map(labels, func(l label) label {
+	if l.quoted {
+		l.text = strings.NewReplacer("$", "", "%", "").Replace(l.text)
+	}
+	return l
+})
+
+var oneLineCases = hegel.FlatMap(envs, func(sc *scope) hegel.Generator[oneLineCase] {
+	bg := newBodyGrammar(sc)
+	bodies := hegel.Map(many(bg.attrs(1), 0, 1), func(as []*attr) *body {
+		b := &body{}
+		for _, a := range as {
+			if a.heredoc != nil || keywords[a.name] {
+				continue // a heredoc cannot sit in a one-line block
+			}
+			b.attrs = append(b.attrs, a)
+			b.order = append(b.order, len(b.attrs)-1)
+		}
+		return b
+	})
+	return hegel.Composite(func(tc hegel.TestCase) oneLineCase {
+		blk := &block{typ: hegel.Draw(tc, blockTypes), body: hegel.Draw(tc, bodies), oneLine: shaped(true, false)}
+		for _, l := range hegel.Draw(tc, many(plainLabels, 0, 2)) {
+			blk.labels = append(blk.labels, l.text)
+			blk.quoted = append(blk.quoted, l.quoted)
+		}
+		return oneLineCase{config{sc: sc, body: &body{blocks: []*block{blk}, order: []int{-1}}, tape: hegel.Draw(tc, tapes)}, hegel.Draw(tc, addingEdits)}
+	})
+})
+
+// TestHegelWriterEditsInOneLineBlocksParse: what hclwrite writes after an
+// edit inside a parsed block parses and offers the edited content (the
+// oracle of TestHegelEditsOnParsedFilesKeepTheRest).
+func TestHegelWriterEditsInOneLineBlocksParse(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, oneLineCases)
+		b, sc := c.body, c.sc
+		ctx := evalContext(sc)
+		src := []byte(spell(b, c.tape).src)
+		note(ht, "source:\n%s", src)
+		parseConfig(ht, string(src), "the generated file")
+		wf, diags := hclwrite.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclwrite.ParseConfig rejects what hclsyntax accepts:\n%s\n  %s", src, diagText(diags))
+		}
+		apply(c.edit, wf.Body(), b, sc)
+		out := wf.Bytes()
+		pf, diags := hclsyntax.ParseConfig(out, "edited.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			mismatch(ht, known("hcl/5"), "hclsyntax rejects a file edited with hclwrite (%s):\n%s\n  %s\noriginal:\n%s", c.edit, out, diagText(diags), src)
+		}
+		if msg, shapes := checkContent(pf.Body, b, ctx, sc, "edited"); msg != "" {
+			mismatch(ht, append(shapes, known("hcl/5")...), "%s (after %s)\nedited:\n%s\noriginal:\n%s", msg, c.edit, out, src)
+		}
+		if formatted := hclwrite.Format(out); !bytes.Equal(formatted, out) {
+			mismatch(ht, known("hcl/5"), "an edited file (%s) is not in Format's form:\nedited:\n%s\nformatted:\n%s", c.edit, out, formatted)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// hcl/6: a JSON string value with a carriage return before an escaped `${`.
+
+// lineTexts: a short text without line breaks (template introducers
+// included, which the JSON spelling escapes).
+var lineTexts = hegel.Text().Alphabet("ab $%{}").MaxSize(3)
+
+// crEscapeTexts: a string value with a lone carriage return (a line feed
+// under HEGEL_NO_KNOWN=1) and, later on the same line, an even run of `$`
+// or `%` before `{`: its JSON template spelling has an odd run, a literal
+// sigil before an escape (`$${` is spelled `$$${`).
+var crEscapeTexts = hegel.Composite(func(tc hegel.TestCase) string {
+	pre := hegel.Draw(tc, lineTexts)
+	mid := hegel.Draw(tc, lineTexts)
+	sigil := hegel.Draw(tc, hegel.SampledFrom([]string{"$", "%"}))
+	run := 2 * hegel.Draw(tc, hegel.Integers(1, 2))
+	post := hegel.Draw(tc, hegel.SampledFrom(stringPieces))
+	return pre + shaped("\r", "\n") + mid + strings.Repeat(sigil, run) + "{" + post
+})
+
+// crEscapeCases: a file of one literal string attribute with such a value.
+var crEscapeCases = hegel.FlatMap(envs, func(sc *scope) hegel.Generator[config] {
+	return hegel.Map(crEscapeTexts, func(s string) config {
+		return config{sc: sc, body: &body{attrs: []*attr{{name: "a", e: &E{op: "lit", v: strV(s)}}}, order: []int{0}}}
+	})
+})
+
+// TestHegelTemplateEscapesAfterCarriageReturn: a JSON string value reads as
+// the template it spells, escapes processed after a carriage return as after
+// any other character (the oracle of TestHegelNativeAndJSONBodiesAgree).
+func TestHegelTemplateEscapesAfterCarriageReturn(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, crEscapeCases)
+		jsrc := spellJSON(c.body)
+		note(ht, "json:\n%s", jsrc)
+		jf, diags := json.Parse([]byte(jsrc), "gen.json")
+		if diags.HasErrors() {
+			fail(ht, "json.Parse rejects the generated file:\n%s\n  %s", jsrc, diagText(diags))
+		}
+		if msg, shapes := checkContent(jf.Body, c.body, evalContext(c.sc), c.sc, "json"); msg != "" {
+			mismatch(ht, append(shapes, known("hcl/6")...), "%s\njson:\n%s", msg, jsrc)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// hcl/7: a negative number set by hclwrite after an inline comment.
+
+// commentMinusCase: an attribute whose value follows an inline comment,
+// parsed by hclwrite and set to a number (negative by default, non-negative
+// under HEGEL_NO_KNOWN=1).
+type commentMinusCase struct {
+	comment string
+	old     string
+	num     cty.Value
+	inBlock bool
+}
+
+func (c commentMinusCase) source() string {
+	src := "a = " + c.comment + " " + c.old + "\n"
+	if c.inBlock {
+		return "b {\n  " + src + "}\n"
+	}
+	return src
+}
+
+func (c commentMinusCase) GoString() string {
+	return fmt.Sprintf("source:\n%s\nset a = %#v", c.source(), c.num)
+}
+
+var commentMinusCases = hegel.Composite(func(tc hegel.TestCase) commentMinusCase {
+	sign := shaped(-1.0, 1.0)
+	num := cty.NumberIntVal(int64(sign) * int64(hegel.Draw(tc, hegel.Integers(0, 1000))))
+	if hegel.Draw(tc, hegel.Booleans()) {
+		num = cty.NumberFloatVal(sign * float64(hegel.Draw(tc, hegel.Integers(1, 1000))) / 8)
+	}
+	return commentMinusCase{
+		comment: hegel.Draw(tc, hegel.SampledFrom([]string{"/* c */", "/**/", "/* ${x} %{y} */", "/* \u65e5\u672c */"})),
+		old:     hegel.Draw(tc, hegel.SampledFrom([]string{"1", "true", "\"s\"", "[1]", "x"})),
+		num:     num,
+		inBlock: hegel.Draw(tc, hegel.Booleans()),
+	}
+})
+
+// TestHegelFormatKeepsUnaryMinusAfterComment: what hclwrite writes after
+// setting an attribute's value is in Format's form (the oracle of
+// TestHegelEditsOnParsedFilesKeepTheRest).
+func TestHegelFormatKeepsUnaryMinusAfterComment(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, commentMinusCases)
+		src := []byte(c.source())
+		note(ht, "source:\n%s", src)
+		wf, diags := hclwrite.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclwrite.ParseConfig rejects the generated file:\n%s\n  %s", src, diagText(diags))
+		}
+		wb := wf.Body()
+		if c.inBlock {
+			wb = wb.Blocks()[0].Body()
+		}
+		wb.SetAttributeValue("a", c.num)
+		out := wf.Bytes()
+		if _, diags := hclsyntax.ParseConfig(out, "edited.hcl", hcl.InitialPos); diags.HasErrors() {
+			fail(ht, "hclsyntax rejects a file edited with hclwrite:\n%s\n  %s", out, diagText(diags))
+		}
+		if formatted := hclwrite.Format(out); !bytes.Equal(formatted, out) {
+			mismatch(ht, known("hcl/7"), "an edited file (a = %#v) is not in Format's form:\nedited:\n%s\nformatted:\n%s", c.num, out, formatted)
+		}
+	})
+}
