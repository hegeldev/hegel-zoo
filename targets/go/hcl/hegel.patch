+// ---------------------------------------------------------------------------
+// PartialContent and MergeFiles.
+
+// splitBody partitions a body's attributes and blocks (blocks of one type
+// stay together) into two bodies.
+func splitBody(tc hegel.TestCase, b *body) (*body, *body) {
+	b1, b2 := &body{}, &body{}
+	typeSide := map[string]bool{}
+	for _, o := range b.order {
+		if o >= 0 {
+			a := b.attrs[o]
+			side := b1
+			if chance(tc, 50) {
+				side = b2
+			}
+			side.attrs = append(side.attrs, a)
+			side.order = append(side.order, len(side.attrs)-1)
+			continue
+		}
+		blk := b.blocks[-1-o]
+		second, seen := typeSide[blk.typ]
+		if !seen {
+			second = chance(tc, 50)
+			typeSide[blk.typ] = second
+		}
+		side := b1
+		if second {
+			side = b2
+		}
+		side.blocks = append(side.blocks, blk)
+		side.order = append(side.order, -len(side.blocks))
+	}
+	return b1, b2
+}
