+package hcl_test
+
+// Further properties: static analysis (ExprList, ExprMap, ExprCall,
+// AbsTraversalForExpr) in both syntaxes, PartialContent and MergeFiles,
+// hclwrite edits on parsed files, traversals, and the structure-at-position
+// lookups against the model.
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/hashicorp/hcl/v2/hclwrite"
+	"github.com/hashicorp/hcl/v2/json"
+	"github.com/zclconf/go-cty/cty"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Static analysis.
+
+// TestHegelStaticAnalysisSeesTheSyntax: tuple, object, call and traversal
+// expressions are recognised by the static analysis helpers, natively and
+// through JSON strings, with the elements the source spells.
+func TestHegelStaticAnalysisSeesTheSyntax(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, staticCases)
+		sc, e := c.sc, c.e
+		ctx := evalContext(sc)
+		_, err := tryEval(e, sc)
+		ht.Assume(err == nil)
+		src := render(e, 0)
+		note(ht, "expression: %s", src)
+		exprs := map[string]hcl.Expression{"native": parseExpr(ht, src)}
+		chain, static := traversalChain(e)
+		// The JSON spellings the static analysis understands: arrays and
+		// objects for lists and maps, and the native text of a call or a
+		// traversal as a plain string.
+		jsrc := ""
+		switch {
+		case strings.Contains(src, "\n"):
+		case e.op == "tuple" || e.op == "object":
+			jsrc = staticJSON(e)
+		case e.op == "call":
+			jsrc = quoteJSONRaw(src)
+		case static && !strings.ContainsAny(chain, "$%"):
+			jsrc = quoteJSONRaw(chain)
+		}
+		if jsrc != "" {
+			je, diags := json.ParseExpression([]byte(jsrc), "gen.json")
+			if diags.HasErrors() {
+				fail(ht, "json.ParseExpression rejects %s: %s", jsrc, diagText(diags))
+			}
+			exprs["json"] = je
+			// staticJSON puts literal strings in templates (hcl/6: a lone
+			// carriage return before an escape keeps the escape verbatim).
+			if cr := shapeIf(exprQuirk(e), "hcl/6"); len(cr) > 0 && (e.op == "tuple" || e.op == "object") {
+				want := eval(e, sc)
+				if got, diags := je.Value(ctx); diags.HasErrors() || !sameValue(got, want.cty()) {
+					mismatch(ht, cr, "json: %s evaluates to %#v, expected %#v (%s)", jsrc, got, want.cty(), diagText(diags))
+				}
+			}
+		}
+		for how, expr := range exprs {
+			switch e.op {
+			case "tuple":
+				elems, diags := hcl.ExprList(expr)
+				if diags.HasErrors() {
+					fail(ht, "%s: ExprList fails on %s: %s", how, src, diagText(diags))
+				}
+				if len(elems) != len(e.args) {
+					fail(ht, "%s: ExprList of %s has %d elements, expected %d", how, src, len(elems), len(e.args))
+				}
+				for i, el := range elems {
+					want := eval(e.args[i], sc)
+					got, diags := el.Value(ctx)
+					if diags.HasErrors() || !sameValue(got, want.cty()) {
+						fail(ht, "%s: ExprList element %d of %s = %#v, expected %#v (%s)", how, i, src, got, want.cty(), diagText(diags))
+					}
+				}
+			case "object":
+				pairs, diags := hcl.ExprMap(expr)
+				if diags.HasErrors() {
+					fail(ht, "%s: ExprMap fails on %s: %s", how, src, diagText(diags))
+				}
+				if len(pairs) != len(e.args) {
+					fail(ht, "%s: ExprMap of %s has %d pairs, expected %d", how, src, len(pairs), len(e.args))
+				}
+				for i, p := range pairs {
+					// Keys: natively a bare identifier is a keyword, a quoted one
+					// a string. A JSON key is a string (ExprAsKeyword would read
+					// it as native traversal syntax, where "a#" or "a " is the
+					// keyword a with a trailing comment or space).
+					key := ""
+					if how == "native" {
+						key = hcl.ExprAsKeyword(p.Key)
+					}
+					if key == "" {
+						kv, diags := p.Key.Value(ctx)
+						if diags.HasErrors() || kv.Type() != cty.String {
+							fail(ht, "%s: ExprMap key %d of %s is neither a keyword nor a string: %s", how, i, src, diagText(diags))
+						}
+						key = kv.AsString()
+					}
+					if nfc(key) != nfc(e.names[i]) {
+						fail(ht, "%s: ExprMap key %d of %s is %q, expected %q", how, i, src, key, e.names[i])
+					}
+					want := eval(e.args[i], sc)
+					got, diags := p.Value.Value(ctx)
+					if diags.HasErrors() || !sameValue(got, want.cty()) {
+						fail(ht, "%s: ExprMap value %d of %s = %#v, expected %#v (%s)", how, i, src, got, want.cty(), diagText(diags))
+					}
+				}
+			case "call":
+				call, diags := hcl.ExprCall(expr)
+				if diags.HasErrors() {
+					fail(ht, "%s: ExprCall fails on %s: %s", how, src, diagText(diags))
+				}
+				if call.Name != e.name || len(call.Arguments) != len(e.args) {
+					fail(ht, "%s: ExprCall of %s is %s with %d arguments, expected %s with %d", how, src, call.Name, len(call.Arguments), e.name, len(e.args))
+				}
+				if how == "native" && string(call.NameRange.SliceBytes([]byte(src))) != e.name {
+					fail(ht, "%s: ExprCall NameRange of %s slices %q", how, src, call.NameRange.SliceBytes([]byte(src)))
+				}
+			case "var", "attr", "idx":
+				if !static {
+					// Not a static traversal (a computed index); it must not be
+					// mistaken for one either.
+					if _, diags := hcl.AbsTraversalForExpr(expr); !diags.HasErrors() && !mayBeStatic(e) {
+						fail(ht, "%s: AbsTraversalForExpr accepts the non-static %s", how, src)
+					}
+					return
+				}
+				trav, diags := hcl.AbsTraversalForExpr(expr)
+				if diags.HasErrors() {
+					fail(ht, "%s: AbsTraversalForExpr rejects %s: %s", how, src, diagText(diags))
+				}
+				if got := describeTraversal(trav); got != chain {
+					fail(ht, "%s: AbsTraversalForExpr of %s gives %s, expected %s", how, src, got, chain)
+				}
+				want := eval(e, sc)
+				got, diags := trav.TraverseAbs(ctx)
+				if diags.HasErrors() || !sameValue(got, want.cty()) {
+					fail(ht, "%s: TraverseAbs of %s = %#v, expected %#v (%s)", how, src, got, want.cty(), diagText(diags))
+				}
+				if how == "native" {
+					// The traversal parser reads the same steps from the
+					// canonical spelling (it has no legacy `.0` index).
+					if !strings.ContainsAny(chain, "$%") {
+						t2, diags := hclsyntax.ParseTraversalAbs([]byte(chain), "trav.hcl", hcl.InitialPos)
+						if diags.HasErrors() {
+							fail(ht, "ParseTraversalAbs rejects %s: %s", chain, diagText(diags))
+						}
+						if got := describeTraversal(t2); got != chain {
+							fail(ht, "ParseTraversalAbs of %s gives %s", chain, got)
+						}
+					}
+					// And hclwrite spells it back.
+					toks := hclwrite.TokensForTraversal(trav)
+					t3, diags := hclsyntax.ParseTraversalAbs(toks.Bytes(), "trav.hcl", hcl.InitialPos)
+					if diags.HasErrors() {
+						fail(ht, "TokensForTraversal of %s spells %q, which ParseTraversalAbs rejects: %s", src, toks.Bytes(), diagText(diags))
+					}
+					if got := describeTraversal(t3); got != chain {
+						fail(ht, "TokensForTraversal of %s spells %q, read as %s", src, toks.Bytes(), got)
+					}
+				}
+			}
+		}
+	})
+}
+
+// exprQuirk reports whether a literal or an object key of the expression
+// has a string of the shape of hcl/6.
+func exprQuirk(e *E) bool {
+	if e == nil {
+		return false
+	}
+	if e.op == "lit" && hasCRQuirk(e.v) {
+		return true
+	}
+	for _, name := range e.names {
+		if strQuirk(name) {
+			return true
+		}
+	}
+	for _, c := range []*E{e.a, e.b, e.c} {
+		if exprQuirk(c) {
+			return true
+		}
+	}
+	for _, c := range e.args {
+		if exprQuirk(c) {
+			return true
+		}
+	}
+	for _, p := range e.parts {
+		if exprQuirk(p.e) {
+			return true
+		}
+	}
+	return false
+}
+
+// staticJSON spells a tuple or object expression as a JSON array or object
+// (elements and values as templates or literals), the forms ExprList and
+// ExprMap understand in JSON. An object key is a template to ExprMap in the
+// JSON syntax, so it is spelled with the template escapes.
+func staticJSON(e *E) string {
+	switch e.op {
+	case "tuple":
+		parts := make([]string, len(e.args))
+		for i, a := range e.args {
+			parts[i] = staticJSON(a)
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case "object":
+		parts := make([]string, len(e.args))
+		for i, a := range e.args {
+			parts[i] = quoteJSON(e.names[i], false) + ": " + staticJSON(a)
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	case "lit":
+		if !hasNull(e.v) {
+			return e.v.json()
+		}
+	}
+	return quoteJSONRaw("${" + render(e, 0) + "}")
+}
+
+// traversalChain describes e as a static traversal (root name, attribute and
+// literal-index steps) in canonical native syntax when it is one. A negative
+// number key is a unary operation to the parser, so not static.
+func traversalChain(e *E) (string, bool) {
+	switch e.op {
+	case "var":
+		return e.name, true
+	case "attr":
+		base, ok := traversalChain(e.a)
+		if !ok {
+			return "", false
+		}
+		if isDigits(e.name) {
+			return base + "[" + e.name + "]", true
+		}
+		return base + "." + e.name, true
+	case "idx":
+		base, ok := traversalChain(e.a)
+		if !ok {
+			return "", false
+		}
+		if s, ok := literalText(e.b); ok {
+			return base + "[" + quoteNative(nfc(s), true) + "]", true
+		}
+		if e.b.op != "lit" {
+			return "", false
+		}
+		switch e.b.v.k {
+		case kNum:
+			if strings.HasPrefix(strings.TrimSpace(e.b.v.num), "-") {
+				return "", false
+			}
+			return base + "[" + canonNum(e.b.v.num) + "]", true
+		case kStr:
+			return base + "[" + quoteNative(nfc(e.b.v.s), true) + "]", true
+		}
+		return "", false
+	}
+	return "", false
+}
+
+// literalText: the text of a template made of literal parts only (a string
+// literal to the parser).
+func literalText(e *E) (string, bool) {
+	if e.op != "tmpl" {
+		return "", false
+	}
+	var b strings.Builder
+	for _, p := range e.parts {
+		if p.kind != "lit" {
+			return "", false
+		}
+		b.WriteString(p.text)
+	}
+	return b.String(), true
+}
+
+// mayBeStatic: a chain whose index keys are literals of any kind (the parser
+// also makes traversal steps of bool and null keys).
+func mayBeStatic(e *E) bool {
+	switch e.op {
+	case "var":
+		return true
+	case "attr":
+		return mayBeStatic(e.a)
+	case "idx":
+		_, lit := literalText(e.b)
+		return (e.b.op == "lit" || lit) && mayBeStatic(e.a)
+	}
+	return false
+}
+
+func describeTraversal(t hcl.Traversal) string {
+	var b strings.Builder
+	for _, step := range t {
+		switch s := step.(type) {
+		case hcl.TraverseRoot:
+			b.WriteString(s.Name)
+		case hcl.TraverseAttr:
+			b.WriteString("." + s.Name)
+		case hcl.TraverseIndex:
+			switch s.Key.Type() {
+			case cty.Number:
+				b.WriteString("[" + numText(s.Key.AsBigFloat()) + "]")
+			case cty.String:
+				b.WriteString("[" + quoteNative(s.Key.AsString(), true) + "]")
+			default:
+				b.WriteString("[?]")
+			}
+		default:
+			b.WriteString(fmt.Sprintf("<%T>", step))
+		}
+	}
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// PartialContent and MergeFiles.
+
+// splitBody partitions a body's attributes and blocks (blocks of one type
+// stay together) into two bodies, each item's side read from the tape.
+func splitBody(b *body, t *tape) (*body, *body) {
+	b1, b2 := &body{}, &body{}
+	typeSide := map[string]bool{}
+	for _, o := range b.order {
+		if o >= 0 {
+			a := b.attrs[o]
+			side := b1
+			if t.coin(50) {
+				side = b2
+			}
+			side.attrs = append(side.attrs, a)
+			side.order = append(side.order, len(side.attrs)-1)
+			continue
+		}
+		blk := b.blocks[-1-o]
+		second, seen := typeSide[blk.typ]
+		if !seen {
+			second = t.coin(50)
+			typeSide[blk.typ] = second
+		}
+		side := b1
+		if second {
+			side = b2
+		}
+		side.blocks = append(side.blocks, blk)
+		side.order = append(side.order, -len(side.blocks))
+	}
+	return b1, b2
+}
+
+// partialCase: a configuration and the tape that splits its body in two.
+type partialCase struct {
+	config
+	split []int
+}
+
+var partialCases = hegel.Map(pairs(configs, tapes), func(p pair[config, []int]) partialCase { return partialCase{p.a, p.b} })
+
+// TestHegelPartialContentLeavesTheRest: PartialContent with a schema for
+// part of a body returns that part and a remaining body holding exactly the
+// rest, in both syntaxes; MergeFiles of a native and a JSON file offers the
+// union.
+func TestHegelPartialContentLeavesTheRest(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, partialCases)
+		b, sc := c.body, c.sc
+		ctx := evalContext(sc)
+		cr := shapeIf(jsonQuirk(b), "hcl/6") // the JSON spellings put literal strings in templates
+		b1, b2 := splitBody(b, &tape{vals: c.split})
+		src := spell(b, c.tape).src
+		jsrc := spellJSON(b)
+		note(ht, "native:\n%s\njson:\n%s", src, jsrc)
+		f := parseConfig(ht, src, "the generated file")
+		jf, diags := json.Parse([]byte(jsrc), "gen.json")
+		if diags.HasErrors() {
+			fail(ht, "json.Parse rejects the generated file:\n%s\n  %s", jsrc, diagText(diags))
+		}
+		for how, hb := range map[string]hcl.Body{"native": f.Body, "json": jf.Body} {
+			content, remain, diags := hb.PartialContent(schemaOf(b1))
+			if diags.HasErrors() {
+				fail(ht, "%s: PartialContent fails: %s\nnative:\n%s\njson:\n%s", how, diagText(diags), src, jsrc)
+			}
+			jsonCR := shapeIf(how == "json" && len(cr) > 0, "hcl/6")
+			if msg, shapes := checkContentOf(content, b1, ctx, sc, how+"/partial"); msg != "" {
+				mismatch(ht, append(shapes, jsonCR...), "%s\nnative:\n%s\njson:\n%s", msg, src, jsrc)
+			}
+			if msg, shapes := checkContent(remain, b2, ctx, sc, how+"/remain"); msg != "" {
+				mismatch(ht, append(shapes, jsonCR...), "%s\nnative:\n%s\njson:\n%s", msg, src, jsrc)
+			}
+			// JustAttributes on the remainder, when no blocks remain (hcl/4:
+			// the native body still reports the extracted blocks; under
+			// HEGEL_NO_KNOWN=1 that region is left out).
+			extracted := shapeIf(how == "native" && len(b1.blocks) > 0, "hcl/4")
+			if len(b2.blocks) == 0 && (len(extracted) == 0 || !Known.partialJustAttrs) {
+				attrs, diags := remain.JustAttributes()
+				if diags.HasErrors() {
+					mismatch(ht, extracted, "%s: JustAttributes on the remaining body fails: %s\nnative:\n%s\njson:\n%s", how, diagText(diags), src, jsrc)
+				}
+				if len(attrs) != len(b2.attrs) {
+					mismatch(ht, extracted, "%s: JustAttributes on the remaining body has %d attributes, expected %d\nnative:\n%s\njson:\n%s", how, len(attrs), len(b2.attrs), src, jsrc)
+				}
+			}
+			// Content with the full schema on the remaining body only sees
+			// the rest.
+			full, diags := remain.Content(schemaOf(b))
+			if diags.HasErrors() {
+				fail(ht, "%s: Content(full schema) on the remaining body fails: %s\nnative:\n%s\njson:\n%s", how, diagText(diags), src, jsrc)
+			}
+			if len(full.Attributes) != len(b2.attrs) || len(full.Blocks) != len(b2.blocks) {
+				fail(ht, "%s: the remaining body still offers %d attributes and %d blocks, expected %d and %d\nnative:\n%s\njson:\n%s", how, len(full.Attributes), len(full.Blocks), len(b2.attrs), len(b2.blocks), src, jsrc)
+			}
+		}
+		// Merge a native file holding b1 with a JSON file holding b2.
+		src1 := spell(b1, c.tape).src
+		jsrc2 := spellJSON(b2)
+		f1 := parseConfig(ht, src1, "the first half")
+		f2, diags := json.Parse([]byte(jsrc2), "half.json")
+		if diags.HasErrors() {
+			fail(ht, "json.Parse rejects the second half:\n%s\n  %s", jsrc2, diagText(diags))
+		}
+		merged := hcl.MergeFiles([]*hcl.File{f1, f2})
+		if msg, shapes := checkContent(merged, b, ctx, sc, "merged"); msg != "" {
+			mismatch(ht, append(shapes, cr...), "%s\nnative half:\n%s\njson half:\n%s", msg, src1, jsrc2)
+		}
+		// And PartialContent on the merged body.
+		content, remain, diags := merged.PartialContent(schemaOf(b1))
+		if diags.HasErrors() {
+			fail(ht, "merged: PartialContent fails: %s\nnative half:\n%s\njson half:\n%s", diagText(diags), src1, jsrc2)
+		}
+		if msg, shapes := checkContentOf(content, b1, ctx, sc, "merged/partial"); msg != "" {
+			mismatch(ht, append(shapes, cr...), "%s\nnative half:\n%s\njson half:\n%s", msg, src1, jsrc2)
+		}
+		if msg, shapes := checkContent(remain, b2, ctx, sc, "merged/remain"); msg != "" {
+			mismatch(ht, append(shapes, cr...), "%s\nnative half:\n%s\njson half:\n%s", msg, src1, jsrc2)
+		}
+	})
+}
