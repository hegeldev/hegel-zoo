+// TestHegelRangesPointAtTheSource: the ranges of attributes, expressions,
+// blocks and labels slice the source to the text they describe.
+func TestHegelRangesPointAtTheSource(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, sc, _ := genConfig(ht)
+		src := []byte(spellNative(ht, b, false))
+		note(ht, "source:\n%s", src)
+		f := parseConfig(ht, string(src), "the generated file")
+		ctx := evalContext(sc)
+		if msg := checkRanges(f.Body.(*hclsyntax.Body), b, src, ctx, sc); msg != "" {
+			fail(ht, "%s\nsource:\n%s", msg, src)
+		}
+	})
+}
+
+func checkRanges(hb *hclsyntax.Body, b *body, src []byte, ctx *hcl.EvalContext, sc *scope) string {
+	if !hb.SrcRange.CanSliceBytes(src) {
+		return fmt.Sprintf("body range %s is outside the source", hb.SrcRange)
+	}
+	for _, a := range b.attrs {
+		ha, ok := hb.Attributes[a.name]
+		if !ok {
+			return fmt.Sprintf("attribute %q missing", a.name)
+		}
+		whole := string(ha.SrcRange.SliceBytes(src))
+		if !strings.HasPrefix(whole, a.name) {
+			return fmt.Sprintf("attribute %q: SrcRange %s slices %q, which does not start with the name", a.name, ha.SrcRange, whole)
+		}
+		if string(ha.NameRange.SliceBytes(src)) != a.name {
+			return fmt.Sprintf("attribute %q: NameRange %s slices %q", a.name, ha.NameRange, ha.NameRange.SliceBytes(src))
+		}
+		if string(ha.EqualsRange.SliceBytes(src)) != "=" {
+			return fmt.Sprintf("attribute %q: EqualsRange %s slices %q", a.name, ha.EqualsRange, ha.EqualsRange.SliceBytes(src))
+		}
+		exprSrc := ha.Expr.Range().SliceBytes(src)
+		text := string(exprSrc)
+		if a.heredoc != nil {
+			if !strings.HasSuffix(text, "\n") {
+				text += "\n"
+			}
+		}
+		expr, diags := hclsyntax.ParseExpression([]byte(text), "slice.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			return fmt.Sprintf("attribute %q: the expression range %s slices %q, which does not parse: %s", a.name, ha.Expr.Range(), exprSrc, diagText(diags))
+		}
+		want, err := tryEval(a.e, sc)
+		if err != nil {
+			return "GENERATOR: " + err.Error()
+		}
+		val, diags := expr.Value(ctx)
+		if diags.HasErrors() {
+			return fmt.Sprintf("attribute %q: the expression range slice %q does not evaluate: %s", a.name, exprSrc, diagText(diags))
+		}
+		if !sameValue(val, want.cty()) {
+			return fmt.Sprintf("attribute %q: the expression range slice %q evaluates to %#v, expected %#v", a.name, exprSrc, val, want.cty())
+		}
+		if !rangeWithin(ha.Expr.Range(), ha.SrcRange) || !rangeWithin(ha.SrcRange, hb.SrcRange) {
+			return fmt.Sprintf("attribute %q: ranges do not nest: expr %s, attr %s, body %s", a.name, ha.Expr.Range(), ha.SrcRange, hb.SrcRange)
+		}
+	}
+	if len(hb.Blocks) != len(b.blocks) {
+		return fmt.Sprintf("%d blocks, expected %d", len(hb.Blocks), len(b.blocks))
+	}
+	for i, blk := range b.blocks {
+		got := hb.Blocks[i]
+		if string(got.TypeRange.SliceBytes(src)) != blk.typ {
+			return fmt.Sprintf("block %d: TypeRange %s slices %q, expected %q", i, got.TypeRange, got.TypeRange.SliceBytes(src), blk.typ)
+		}
+		if len(got.LabelRanges) != len(blk.labels) {
+			return fmt.Sprintf("block %d: %d label ranges for %d labels", i, len(got.LabelRanges), len(blk.labels))
+		}
+		for k, lr := range got.LabelRanges {
+			text := string(lr.SliceBytes(src))
+			want := blk.labels[k]
+			if blk.quoted[k] {
+				// A quoted label: the slice is a string literal spelling it.
+				e, diags := hclsyntax.ParseExpression([]byte(text), "label.hcl", hcl.InitialPos)
+				if diags.HasErrors() {
+					return fmt.Sprintf("block %d: label range %d slices %q, not a string literal", i, k, text)
+				}
+				v, diags := e.Value(nil)
+				if diags.HasErrors() || v.Type() != cty.String || v.AsString() != nfc(want) {
+					return fmt.Sprintf("block %d: label range %d slices %q, expected the spelling of %q", i, k, text, want)
+				}
+			} else if nfc(text) != nfc(want) {
+				return fmt.Sprintf("block %d: label range %d slices %q, expected %q", i, k, text, want)
+			}
+		}
+		if string(got.OpenBraceRange.SliceBytes(src)) != "{" || string(got.CloseBraceRange.SliceBytes(src)) != "}" {
+			return fmt.Sprintf("block %d: brace ranges slice %q and %q", i, got.OpenBraceRange.SliceBytes(src), got.CloseBraceRange.SliceBytes(src))
+		}
+		if !rangeWithin(got.Body.SrcRange, got.Range()) || !rangeWithin(got.Range(), hb.SrcRange) {
+			return fmt.Sprintf("block %d: ranges do not nest: body %s, block %s, parent %s", i, got.Body.SrcRange, got.Range(), hb.SrcRange)
+		}
+		if msg := checkRanges(got.Body, blk.body, src, ctx, sc); msg != "" {
+			return fmt.Sprintf("in block %d (%s): %s", i, blk.typ, msg)
+		}
+	}
+	return ""
+}
+
+func rangeWithin(inner, outer hcl.Range) bool {
+	return inner.Start.Byte >= outer.Start.Byte && inner.End.Byte <= outer.End.Byte && inner.Start.Byte <= inner.End.Byte
+}
+
+// TestHegelBrokenInputsNeverPanic: mutated files never make the parsers,
+// the formatter or the writer panic; whatever still parses is reproduced
+// verbatim by hclwrite and formats to a fixed point.
+func TestHegelBrokenInputsNeverPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, _, _ := genConfig(ht)
+		src := []byte(spellNative(ht, b, false))
+		if chance(ht, 30) {
+			src = []byte(spellJSON(b))
+		}
+		mutated := mutate(ht, src)
+		note(ht, "mutated:\n%s", mutated)
+		f, diags := hclsyntax.ParseConfig(mutated, "m.hcl", hcl.InitialPos)
+		json.Parse(mutated, "m.json")
+		hclsyntax.ParseExpression(mutated, "m.hcl", hcl.InitialPos)
+		hclsyntax.ParseTemplate(mutated, "m.hcl", hcl.InitialPos)
+		hclsyntax.ParseTraversalAbs(mutated, "m.hcl", hcl.InitialPos)
+		formatted := hclwrite.Format(mutated)
+		wf, wdiags := hclwrite.ParseConfig(mutated, "m.hcl", hcl.InitialPos)
+		if !diags.HasErrors() {
+			if wdiags.HasErrors() {
+				fail(ht, "hclwrite.ParseConfig rejects what hclsyntax accepts:\n%s\n  %s", mutated, diagText(wdiags))
+			}
+			if !bytes.Equal(wf.Bytes(), formatted) {
+				fail(ht, "hclwrite.ParseConfig(src).Bytes() differs from Format(src):\nsource:\n%s\nbytes:\n%s\nformat:\n%s", mutated, wf.Bytes(), formatted)
+			}
+			f2, diags2 := hclsyntax.ParseConfig(formatted, "f.hcl", hcl.InitialPos)
+			if diags2.HasErrors() {
+				fail(ht, "Format output does not parse:\n%s\n  %s\nsource:\n%s", formatted, diagText(diags2), mutated)
+			}
+			t1, _ := tokenShapes(mutated)
+			t2, _ := tokenShapes(formatted)
+			if d := firstTokenDiff(t1, t2); d != "" {
+				fail(ht, "Format changed more than whitespace: %s\nsource:\n%s\nformatted:\n%s", d, mutated, formatted)
+			}
+			again := hclwrite.Format(formatted)
+			if !bytes.Equal(again, formatted) {
+				fail(ht, "Format is not idempotent:\nsource:\n%s\nfirst:\n%s\nsecond:\n%s", mutated, formatted, again)
+			}
+			// The structures agree on attribute names and block types.
+			attrs1, _ := f.Body.JustAttributes()
+			attrs2, _ := f2.Body.JustAttributes()
+			if len(attrs1) != len(attrs2) {
+				fail(ht, "Format changed the attribute set: %d vs %d\nsource:\n%s\nformatted:\n%s", len(attrs1), len(attrs2), mutated, formatted)
+			}
+		}
+	})
+}
+
+var mutationPieces = []string{"{", "}", "[", "]", "(", ")", "\"", "\\", "${", "%{", "~}", "<<EOT\n", "EOT\n", "\n", "#", "//", "/*", "*/", "=", "==", ":", ",", ".", "...", "*", "-", "?", " ", "\t", "\r\n", "for", "in", "if", "null", "\xff", "\x00", "'", "`", "1e", "0x", " ", " "}
+
+func mutate(tc hegel.TestCase, src []byte) []byte {
+	out := append([]byte{}, src...)
+	for k := n(tc, 1, 3); k > 0; k-- {
+		switch n(tc, 1, 5) {
+		case 1: // delete a span
+			if len(out) == 0 {
+				continue
+			}
+			i := n(tc, 0, len(out)-1)
+			j := i + n(tc, 1, 8)
+			if j > len(out) {
+				j = len(out)
+			}
+			out = append(out[:i:i], out[j:]...)
+		case 2: // insert a piece
+			i := n(tc, 0, len(out))
+			p := []byte(pick(tc, mutationPieces...))
+			out = append(out[:i:i], append(p, out[i:]...)...)
+		case 3: // replace a byte
+			if len(out) == 0 {
+				continue
+			}
+			i := n(tc, 0, len(out)-1)
+			out[i] = byte(n(tc, 0, 255))
+		case 4: // duplicate a span
+			if len(out) == 0 {
+				continue
+			}
+			i := n(tc, 0, len(out)-1)
+			j := i + n(tc, 1, 20)
+			if j > len(out) {
+				j = len(out)
+			}
+			span := append([]byte{}, out[i:j]...)
+			at := n(tc, 0, len(out))
+			out = append(out[:at:at], append(span, out[at:]...)...)
+		default: // truncate
+			if len(out) == 0 {
+				continue
+			}
+			out = out[:n(tc, 0, len(out)-1)]
+		}
+	}
+	return out
+}
