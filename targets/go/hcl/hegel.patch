+// ---------------------------------------------------------------------------
+// Static analysis.
+
+// TestHegelStaticAnalysisSeesTheSyntax: tuple, object, call and traversal
+// expressions are recognised by the static analysis helpers, natively and
+// through JSON strings, with the elements the source spells.
+func TestHegelStaticAnalysisSeesTheSyntax(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sc := genEnv(ht)
+		ctx := evalContext(sc)
+		g := &gen{tc: ht, sc: sc, budget: 40}
+		var e *E
+		for tries := 0; e == nil && tries < 6; tries++ {
+			cand := g.expr(nil, n(ht, 1, 3))
+			switch cand.op {
+			case "tuple", "object", "call", "var", "attr", "idx":
+				e = cand
+			}
+		}
+		if e == nil {
+			e = &E{op: "tuple", args: []*E{g.expr(nil, 1)}}
+		}
+		if _, err := tryEval(e, sc); err != nil {
+			ht.Assume(false)
+			return
+		}
+		src := render(e, 0)
+		note(ht, "expression: %s", src)
+		exprs := map[string]hcl.Expression{"native": parseExpr(ht, src)}
+		chain, static := traversalChain(e)
+		// The JSON spellings the static analysis understands: arrays and
+		// objects for lists and maps, and the native text of a call or a
+		// traversal as a plain string.
+		jsrc := ""
+		switch {
+		case strings.Contains(src, "\n"):
+		case e.op == "tuple" || e.op == "object":
+			jsrc = staticJSON(e)
+		case e.op == "call":
+			jsrc = quoteJSONRaw(src)
+		case static && !strings.ContainsAny(chain, "$%"):
+			jsrc = quoteJSONRaw(chain)
+		}
+		if jsrc != "" {
+			je, diags := json.ParseExpression([]byte(jsrc), "gen.json")
+			if diags.HasErrors() {
+				fail(ht, "json.ParseExpression rejects %s: %s", jsrc, diagText(diags))
+			}
+			exprs["json"] = je
+		}
+		for how, expr := range exprs {
+			switch e.op {
+			case "tuple":
+				elems, diags := hcl.ExprList(expr)
+				if diags.HasErrors() {
+					fail(ht, "%s: ExprList fails on %s: %s", how, src, diagText(diags))
+				}
+				if len(elems) != len(e.args) {
+					fail(ht, "%s: ExprList of %s has %d elements, expected %d", how, src, len(elems), len(e.args))
+				}
+				for i, el := range elems {
+					want := eval(e.args[i], sc)
+					got, diags := el.Value(ctx)
+					if diags.HasErrors() || !sameValue(got, want.cty()) {
+						fail(ht, "%s: ExprList element %d of %s = %#v, expected %#v (%s)", how, i, src, got, want.cty(), diagText(diags))
+					}
+				}
+			case "object":
+				pairs, diags := hcl.ExprMap(expr)
+				if diags.HasErrors() {
+					fail(ht, "%s: ExprMap fails on %s: %s", how, src, diagText(diags))
+				}
+				if len(pairs) != len(e.args) {
+					fail(ht, "%s: ExprMap of %s has %d pairs, expected %d", how, src, len(pairs), len(e.args))
+				}
+				for i, p := range pairs {
+					// Keys: a bare identifier is a keyword, a quoted one a string.
+					key := hcl.ExprAsKeyword(p.Key)
+					if key == "" {
+						kv, diags := p.Key.Value(ctx)
+						if diags.HasErrors() || kv.Type() != cty.String {
+							fail(ht, "%s: ExprMap key %d of %s is neither a keyword nor a string: %s", how, i, src, diagText(diags))
+						}
+						key = kv.AsString()
+					}
+					if nfc(key) != nfc(e.names[i]) {
+						fail(ht, "%s: ExprMap key %d of %s is %q, expected %q", how, i, src, key, e.names[i])
+					}
+					want := eval(e.args[i], sc)
+					got, diags := p.Value.Value(ctx)
+					if diags.HasErrors() || !sameValue(got, want.cty()) {
+						fail(ht, "%s: ExprMap value %d of %s = %#v, expected %#v (%s)", how, i, src, got, want.cty(), diagText(diags))
+					}
+				}
+			case "call":
+				call, diags := hcl.ExprCall(expr)
+				if diags.HasErrors() {
+					fail(ht, "%s: ExprCall fails on %s: %s", how, src, diagText(diags))
+				}
+				if call.Name != e.name || len(call.Arguments) != len(e.args) {
+					fail(ht, "%s: ExprCall of %s is %s with %d arguments, expected %s with %d", how, src, call.Name, len(call.Arguments), e.name, len(e.args))
+				}
+				if how == "native" && string(call.NameRange.SliceBytes([]byte(src))) != e.name {
+					fail(ht, "%s: ExprCall NameRange of %s slices %q", how, src, call.NameRange.SliceBytes([]byte(src)))
+				}
+			case "var", "attr", "idx":
+				if !static {
+					// Not a static traversal (a computed index); it must not be
+					// mistaken for one either.
+					if _, diags := hcl.AbsTraversalForExpr(expr); !diags.HasErrors() && !mayBeStatic(e) {
+						fail(ht, "%s: AbsTraversalForExpr accepts the non-static %s", how, src)
+					}
+					return
+				}
+				trav, diags := hcl.AbsTraversalForExpr(expr)
+				if diags.HasErrors() {
+					fail(ht, "%s: AbsTraversalForExpr rejects %s: %s", how, src, diagText(diags))
+				}
+				if got := describeTraversal(trav); got != chain {
+					fail(ht, "%s: AbsTraversalForExpr of %s gives %s, expected %s", how, src, got, chain)
+				}
+				want := eval(e, sc)
+				got, diags := trav.TraverseAbs(ctx)
+				if diags.HasErrors() || !sameValue(got, want.cty()) {
+					fail(ht, "%s: TraverseAbs of %s = %#v, expected %#v (%s)", how, src, got, want.cty(), diagText(diags))
+				}
+				if how == "native" {
+					// The traversal parser reads the same steps from the
+					// canonical spelling (it has no legacy `.0` index).
+					if !strings.ContainsAny(chain, "$%") {
+						t2, diags := hclsyntax.ParseTraversalAbs([]byte(chain), "trav.hcl", hcl.InitialPos)
+						if diags.HasErrors() {
+							fail(ht, "ParseTraversalAbs rejects %s: %s", chain, diagText(diags))
+						}
+						if got := describeTraversal(t2); got != chain {
+							fail(ht, "ParseTraversalAbs of %s gives %s", chain, got)
+						}
+					}
+					// And hclwrite spells it back.
+					toks := hclwrite.TokensForTraversal(trav)
+					t3, diags := hclsyntax.ParseTraversalAbs(toks.Bytes(), "trav.hcl", hcl.InitialPos)
+					if diags.HasErrors() {
+						fail(ht, "TokensForTraversal of %s spells %q, which ParseTraversalAbs rejects: %s", src, toks.Bytes(), diagText(diags))
+					}
+					if got := describeTraversal(t3); got != chain {
+						fail(ht, "TokensForTraversal of %s spells %q, read as %s", src, toks.Bytes(), got)
+					}
+				}
+			}
+		}
+	})
+}
