+++ b/hegel_test.go
@@ -0,0 +1,800 @@
+package hcl_test
+
+// Hegel properties for github.com/hashicorp/hcl/v2 (the Hegel zoo). Oracles:
+// the native syntax specification (hclsyntax/spec.md) as a model evaluator
+// over generated, statically typed expressions; the JSON syntax (json/spec.md)
+// against the native syntax on the same values and bodies; hclwrite against
+// hclsyntax (a formatted or generated file must parse to the same content,
+// formatting changes only whitespace and is idempotent, ParseConfig preserves
+// the input verbatim); the source text (ranges); and the parsers against
+// panics on mutated input.
+//
+// Every property draws one case record from generator values built of
+// hegel-go's combinators: the values here, expressions over a drawn scope in
+// hegel_expr_test.go (a grammar built once per case, since a well-typed
+// expression needs the variables it refers to), bodies, hclwrite builds, edits
+// and mutations in hegel_config_test.go. A case is rendered by pure functions;
+// the native spelling reads its whitespace from a drawn tape, so an empty tape
+// is the tidy form a case shrinks to. The shapes of the recorded bugs
+// (bugs.toml) are drawn at their natural rate, so the properties that meet
+// them fail naming the shape and are the expected failures mapped to the bugs
+// (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over its
+// shape region alone and hegel_pins_test.go the regression examples.
+// HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below) for a run
+// that looks past the bugs. HCL_COLLECT=1 records mismatches instead of
+// failing and prints them at the end of each test.
+
+import (
+	"fmt"
+	"math/big"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/zclconf/go-cty/cty"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness plumbing (shared with the other Go targets of the zoo).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("HCL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if ee, ok := r.(evalError); ok {
+				ht.Fatalf("GENERATOR: the model cannot evaluate what it generated: %v", ee)
+			}
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow (E_STOP_TEST on an overrun)
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// The recorded bugs.
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape (mismatch); under HEGEL_NO_KNOWN=1 the
+// gates of Known are on and the shapes are left out of the generators
+// (shaped), and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of the recorded bugs (bugs.toml); on means the
+// shape is left out, which is so only under HEGEL_NO_KNOWN=1. The pins in
+// hegel_pins_test.go assert the correct behaviour and fail while a bug is open.
+var Known = struct {
+	flushBlankLines    bool // hcl/1: `<<-` heredocs leave whitespace-only lines unstripped (the spec strips the common prefix from every line)
+	writerEscapedLabel bool // hcl/2: hclwrite drops a quoted block label that contains a `$` or `%` beside other characters ("a$", "$${x}") from Labels()
+	writerTypeComment  bool // hcl/3: hclwrite drops a comment between a block's type and its first label
+	partialJustAttrs   bool // hcl/4: hclsyntax JustAttributes on the body PartialContent leaves reports the extracted blocks as "Unexpected block"
+	writerOneLineBlock bool // hcl/5: hclwrite edits inside a one-line block (`resource {}`, `resource { a = 1 }`) produce invalid HCL (upstream #687)
+	crTemplateEscape   bool // hcl/6: a bare template keeps `$$${` verbatim after a lone carriage return (`\r$$${` reads `\r$$${`, `\n$$${` reads `\n$${`)
+	formatCommentMinus bool // hcl/7: hclwrite.Format spaces a unary minus after an inline comment (`a = /* c */ -1` becomes `a = /* c */ - 1`)
+}{noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown}
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a narrow property draws the shape of (none under
+// HEGEL_NO_KNOWN=1, where it draws the neighbouring region).
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// mismatch reports a disagreement with the model on a case that has the
+// shapes of the recorded bugs named (none for a shape no bug covers): the
+// failure names them, and under HEGEL_NO_KNOWN=1 a disagreement on a known
+// shape is skipped instead (rare then, since the generators leave the shapes
+// out).
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if len(shapes) > 0 {
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// hcl/6: in a bare template (a JSON string value, hclsyntax.ParseTemplate) a
+// lone carriage return followed, on the same line, by a literal `$` or `%`
+// and an escape (`\r$$${`, `\r%%%{`, `\r$$${a$$${`) is kept verbatim: the
+// escape is not processed, unlike after any other character (`\n$$${` reads
+// `\n$${`, `\r\n$$${` too) and unlike an even run (`\r$$$${` reads `\r$$${`).
+// The JSON spellings put the raw carriage return in the template; a string
+// value whose template text (`${` and `%{` escaped) has that shape is the
+// bug's shape (crEscapeQuirk over-approximates it: `$$$${` matches too).
+var (
+	crEscapeQuirk = regexp.MustCompile("\r[^\n]*([$]{3}\\{|%{3}\\{)")
+	jsonEscapes   = strings.NewReplacer("${", "$${", "%{", "%%{")
+)
+
+// hcl/7: hclwrite.Format takes a `-` right after an inline comment for a
+// subtraction (hclwrite/format.go, spaceAfterToken's TokenMinus heuristics
+// do not list TokenComment as a start of an expression), so `a = /* c */ -1`
+// formats as `a = /* c */ - 1` while `a = -1` keeps its form: what the writer
+// emits when it sets a negative number after such a comment is not in
+// Format's form. An output with a comment right before a minus is the shape.
+var commentMinus = regexp.MustCompile(`\*/\s*-`)
+
+// strQuirk reports whether a string spelled as a JSON template has the shape
+// of hcl/6.
+func strQuirk(s string) bool { return crEscapeQuirk.MatchString(jsonEscapes.Replace(s)) }
+
+// hasCRQuirk reports whether a string of the value has the shape of hcl/6.
+func hasCRQuirk(v V) bool {
+	if v.k == kStr && strQuirk(v.s) {
+		return true
+	}
+	for _, e := range v.elems {
+		if hasCRQuirk(e) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise,
+// which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil
+// otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// deferred draws from a generator assigned later (a forward reference for a
+// recursive generator).
+func deferred[T any](g *hegel.Generator[T]) hegel.Generator[T] {
+	return hegel.Composite(func(tc hegel.TestCase) T { return hegel.Draw(tc, *g) })
+}
+
+// joined concatenates the drawn pieces.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(ps []string) string { return strings.Join(ps, "") })
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// at is the element of xs at a drawn position, modulo their number.
+func at[T any](xs []T, pos int) T { return xs[pos%len(xs)] }
+
+// tape is a drawn list of small integers that a pure writer consumes in
+// order, recycled modulo its length, for the choices a spelling leaves free
+// (whitespace, comments, filler lines). An empty tape answers 0 to every
+// question, so the shrunk form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	pos  int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 || n <= 0 {
+		return 0
+	}
+	v := t.vals[t.pos%len(t.vals)]
+	t.pos++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to sixty values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 60)
+
+// ---------------------------------------------------------------------------
+// The value model: the values the generators build, with the cty value they
+// denote and their spellings in the native and the JSON syntax.
+
+type kind int
+
+const (
+	kNull kind = iota
+	kBool
+	kNum
+	kStr
+	kTuple
+	kObj
+)
+
+type V struct {
+	k     kind
+	b     bool
+	num   string // decimal literal text
+	s     string
+	elems []V
+	keys  []string // object attribute names, in the order they are written
+	list  bool     // a list (of et) rather than a tuple: only functions produce these
+	et    T
+}
+
+func nullV() V           { return V{k: kNull} }
+func boolV(b bool) V     { return V{k: kBool, b: b} }
+func numV(text string) V { return V{k: kNum, num: text} }
+func intV(i int64) V     { return numV(strconv.FormatInt(i, 10)) }
+func strV(s string) V    { return V{k: kStr, s: s} }
+func tupleV(elems ...V) V {
+	if elems == nil {
+		elems = []V{}
+	}
+	return V{k: kTuple, elems: elems}
+}
+func objV(keys []string, elems []V) V { return V{k: kObj, keys: keys, elems: elems} }
+func listV(elems []V, et T) V {
+	if elems == nil {
+		elems = []V{}
+	}
+	return V{k: kTuple, elems: elems, list: true, et: et}
+}
+
+// ctyType is the cty type of a model type.
+func ctyType(t T) cty.Type {
+	switch t.k {
+	case kNum:
+		return cty.Number
+	case kStr:
+		return cty.String
+	case kBool:
+		return cty.Bool
+	case kNull:
+		return cty.DynamicPseudoType
+	case kTuple:
+		if t.list {
+			return cty.List(ctyType(*t.elem))
+		}
+		etys := make([]cty.Type, len(t.elems))
+		for i, e := range t.elems {
+			etys[i] = ctyType(e)
+		}
+		return cty.Tuple(etys)
+	default:
+		atys := map[string]cty.Type{}
+		for i, k := range t.keys {
+			atys[k] = ctyType(t.fields[i])
+		}
+		return cty.Object(atys)
+	}
+}
+
+func (v V) cty() cty.Value {
+	switch v.k {
+	case kNull:
+		return cty.NullVal(cty.DynamicPseudoType)
+	case kBool:
+		return cty.BoolVal(v.b)
+	case kNum:
+		return cty.MustParseNumberVal(v.num)
+	case kStr:
+		return cty.StringVal(v.s)
+	case kTuple:
+		if v.list {
+			if len(v.elems) == 0 {
+				return cty.ListValEmpty(ctyType(v.et))
+			}
+			vals := make([]cty.Value, len(v.elems))
+			for i, e := range v.elems {
+				vals[i] = e.cty()
+			}
+			return cty.ListVal(vals)
+		}
+		if len(v.elems) == 0 {
+			return cty.EmptyTupleVal
+		}
+		vals := make([]cty.Value, len(v.elems))
+		for i, e := range v.elems {
+			vals[i] = e.cty()
+		}
+		return cty.TupleVal(vals)
+	case kObj:
+		if len(v.elems) == 0 {
+			return cty.EmptyObjectVal
+		}
+		m := map[string]cty.Value{}
+		for i, k := range v.keys {
+			m[k] = v.elems[i].cty()
+		}
+		return cty.ObjectVal(m)
+	}
+	panic("bad kind")
+}
+
+// bigNum parses a number literal the way cty does (512-bit binary float).
+func bigNum(text string) *big.Float {
+	f, _, err := big.ParseFloat(text, 10, 512, big.ToNearestEven)
+	if err != nil {
+		panic("bad number literal " + text)
+	}
+	return f
+}
+
+// numText is the decimal text of a number in the form used when a number is
+// converted to a string (no exponent, no trailing zeros).
+func numText(f *big.Float) string { return f.Text('f', -1) }
+
+// canonNum normalises a number literal to the text its value converts to.
+func canonNum(text string) string { return numText(bigNum(text)) }
+
+// sameValue reports whether two cty values are the same value of the same
+// type (null values compare by type only).
+func sameValue(a, b cty.Value) bool {
+	if !a.Type().Equals(b.Type()) {
+		return false
+	}
+	if a.IsNull() || b.IsNull() {
+		return a.IsNull() && b.IsNull()
+	}
+	if !a.IsWhollyKnown() || !b.IsWhollyKnown() {
+		return false
+	}
+	return a.Equals(b).True()
+}
+
+// ---------------------------------------------------------------------------
+// Spelling values in the two syntaxes.
+
+var keywords = map[string]bool{"for": true, "in": true, "if": true, "else": true, "endif": true, "endfor": true, "true": true, "false": true, "null": true}
+
+// isIdent reports whether s is a native-syntax identifier (spec: ID_Start
+// then ID_Continue or '-').
+func isIdent(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i, r := range s {
+		if i == 0 {
+			if !(unicode.IsLetter(r) || r == '_') {
+				return false
+			}
+			continue
+		}
+		if !(unicode.IsLetter(r) || unicode.IsDigit(r) || r == '_' || r == '-' || unicode.Is(unicode.Mn, r) || unicode.Is(unicode.Mc, r) || unicode.Is(unicode.Pc, r)) {
+			return false
+		}
+	}
+	return true
+}
+
+// quoteNative spells a string as a native quoted template that is a plain
+// literal: escapes for the characters the spec lists, template introducers
+// doubled, control characters and (when asked) a few other characters as
+// \uNNNN / \UNNNNNNNN escapes.
+func quoteNative(s string, escapeAll bool) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := 0; i < len(s); {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		switch {
+		case r == '\n':
+			b.WriteString(`\n`)
+		case r == '\r':
+			b.WriteString(`\r`)
+		case r == '\t':
+			b.WriteString(`\t`)
+		case r == '"':
+			b.WriteString(`\"`)
+		case r == '\\':
+			b.WriteString(`\\`)
+		case r == '$' && strings.HasPrefix(s[i:], "${"):
+			b.WriteString("$${")
+			i += 2
+			continue
+		case r == '%' && strings.HasPrefix(s[i:], "%{"):
+			b.WriteString("%%{")
+			i += 2
+			continue
+		case r < 0x20 || r == 0x7f || (escapeAll && r != ' '):
+			if r > 0xffff {
+				fmt.Fprintf(&b, `\U%08X`, r)
+			} else {
+				fmt.Fprintf(&b, `\u%04x`, r)
+			}
+		default:
+			b.WriteRune(r)
+		}
+		i += size
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// quoteJSON spells a string as a JSON string whose value, read as a template
+// (the JSON syntax evaluates strings as templates), is the string itself.
+func quoteJSON(s string, escapeAll bool) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := 0; i < len(s); {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		switch {
+		case r == '\n':
+			b.WriteString(`\n`)
+		case r == '\r':
+			b.WriteString(`\r`)
+		case r == '\t':
+			b.WriteString(`\t`)
+		case r == '"':
+			b.WriteString(`\"`)
+		case r == '\\':
+			b.WriteString(`\\`)
+		case r == '$' && strings.HasPrefix(s[i:], "${"):
+			b.WriteString("$$")
+		case r == '%' && strings.HasPrefix(s[i:], "%{"):
+			b.WriteString("%%")
+		case r < 0x20 || r == 0x7f || (escapeAll && r != ' ' && r < 0x10000):
+			fmt.Fprintf(&b, `\u%04x`, r)
+		default:
+			b.WriteRune(r)
+		}
+		i += size
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// nativeKey spells an object attribute name: an identifier when it is one
+// (and not a keyword), a quoted string otherwise.
+func nativeKey(k string) string {
+	if isIdent(k) && !keywords[k] {
+		return k
+	}
+	return quoteNative(k, false)
+}
+
+// native spells a value as a native-syntax expression on one line.
+func (v V) native() string {
+	switch v.k {
+	case kNull:
+		return "null"
+	case kBool:
+		return strconv.FormatBool(v.b)
+	case kNum:
+		return v.num
+	case kStr:
+		return quoteNative(v.s, false)
+	case kTuple:
+		if v.list {
+			panic("a list value has no literal spelling")
+		}
+		parts := make([]string, len(v.elems))
+		for i, e := range v.elems {
+			parts[i] = e.native()
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case kObj:
+		parts := make([]string, len(v.elems))
+		for i, e := range v.elems {
+			parts[i] = nativeKey(v.keys[i]) + " = " + e.native()
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	}
+	panic("bad kind")
+}
+
+// json spells a value as JSON that the JSON syntax reads as the same value
+// (strings escaped for template mode).
+func (v V) json() string {
+	switch v.k {
+	case kNull:
+		return "null"
+	case kBool:
+		return strconv.FormatBool(v.b)
+	case kNum:
+		return v.num
+	case kStr:
+		return quoteJSON(v.s, false)
+	case kTuple:
+		parts := make([]string, len(v.elems))
+		for i, e := range v.elems {
+			parts[i] = e.json()
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case kObj:
+		parts := make([]string, len(v.elems))
+		for i, e := range v.elems {
+			parts[i] = quoteJSON(v.keys[i], false) + ":" + e.json()
+		}
+		return "{" + strings.Join(parts, ",") + "}"
+	}
+	panic("bad kind")
+}
+
+// ---------------------------------------------------------------------------
+// Generators for values.
+
+var identPool = []string{"a", "b", "foo", "bar_baz", "x1", "with-dash", "_u", "Zed", "\u03bb", "id", "name", "count", "tags"}
+
+var (
+	identFirsts = hegel.SampledFrom([]string{"a", "B", "_", "q", "\u00fc", "\u540d"})
+	identRests  = joined(many(hegel.SampledFrom([]string{"a", "9", "_", "-", "Z", "\u00e9", "0"}), 0, 4))
+	// freshIdents: ID_Start then up to four ID_Continue | '-' pieces.
+	freshIdents = hegel.Map(pairs(identFirsts, identRests), func(p pair[string, string]) string { return p.a + p.b })
+	// idents: an identifier of the pool, or one time in seven a fresh one.
+	idents = weighted(choice[string]{85, hegel.SampledFrom(identPool)}, choice[string]{15, freshIdents})
+)
+
+var stringPieces = []string{"a", "b", "hello", " ", "  ", "world", "0", "12", "\"", "\\", "$", "${", "%{", "$${", "%%{", "{", "}", "~", "#", "//", "/*", "*/", "\n", "\t", "\r", "\u00e9", "\u65e5\u672c", "\U0001F600", "e\u0301", "\u200b", "<<EOT", "EOT", "'", "`", "\x7f", "\u0001", "-", "=", ":", ",", ".", "[", "]", "(", ")", "*", "?", "!", "true", "null", "1e3"}
+
+// strs: up to four pieces of the pool, in NFC: strings are compared under NFC
+// (spec.md, Primitive Types) and cty normalises every string it holds, so the
+// model keeps its strings in NFC too.
+var strs = hegel.Map(joined(many(hegel.SampledFrom(stringPieces), 0, 4)), nfc)
+
+// nfc normalises a string the way cty does when it stores one.
+func nfc(s string) string { return cty.StringVal(s).AsString() }
+
+var numPool = []string{"123456789012345678901234567890", "1e3", "2.5E-2", "1E+2", "0.000001", "9007199254740993", "1e-400", "1e400", "100000000000000000000000000000000000000"}
+
+func itoa(i int) string { return strconv.Itoa(i) }
+
+// numTexts: a number literal valid in both syntaxes: small integers most of
+// the time, a decimal, an exponent form and the pool's edge cases.
+var numTexts = weighted(
+	choice[string]{1, hegel.Just("0")},
+	choice[string]{3, hegel.Map(hegel.Integers(0, 20), itoa)},
+	choice[string]{3, hegel.Map(hegel.Integers(0, 1000), itoa)},
+	choice[string]{1, hegel.Map(pairs(hegel.Integers(0, 99), hegel.Integers(0, 999)), func(p pair[int, int]) string { return itoa(p.a) + "." + itoa(p.b) })},
+	choice[string]{1, hegel.SampledFrom(numPool)},
+	choice[string]{1, hegel.Map(pairs(hegel.Integers(1, 9), hegel.Integers(0, 30)), func(p pair[int, int]) string { return itoa(p.a) + "e" + itoa(p.b) })},
+)
+
+var (
+	smallInts = hegel.Map(hegel.Integers(-20, 20), func(i int) V { return intV(int64(i)) })
+	bools     = hegel.Map(hegel.Booleans(), boolV)
+	nums      = hegel.Map(numTexts, numV)
+	texts     = hegel.Map(strs, strV)
+	// objKeys: an object attribute name, an identifier three times in four.
+	objKeys = weighted(choice[string]{75, idents}, choice[string]{25, strs})
+)
+
+// objectOf is the object of the pairs, the first of two pairs with one key
+// winning (as the old generator dropped a repeated key).
+func objectOf(ps []pair[string, V]) V {
+	keys, elems := []string{}, []V{}
+	seen := map[string]bool{}
+	for _, p := range ps {
+		if seen[p.a] {
+			continue
+		}
+		seen[p.a] = true
+		keys = append(keys, p.a)
+		elems = append(elems, p.b)
+	}
+	return objV(keys, elems)
+}
+
+// valueTrees: a value: a bool, a number, a string and a small integer (or,
+// with nulls, null three times in ten) once each, a tuple of up to three
+// values twice and an object of up to three distinct names twice, by weight;
+// collections nest bound deep, below which every value is a scalar.
+func valueTrees(bound int, nulls bool) hegel.Generator[V] {
+	fourth := smallInts
+	if nulls {
+		fourth = weighted(choice[V]{70, smallInts}, choice[V]{30, hegel.Just(nullV())})
+	}
+	scalars := weighted(choice[V]{1, bools}, choice[V]{1, nums}, choice[V]{1, texts}, choice[V]{1, fourth})
+	depth := 0
+	var values hegel.Generator[V]
+	items := deferred(&values)
+	tupleItems := many(items, 0, 3)
+	objectItems := many(pairs(objKeys, items), 0, 3)
+	tuples := hegel.Composite(func(tc hegel.TestCase) V {
+		depth++
+		defer func() { depth-- }()
+		return tupleV(hegel.Draw(tc, tupleItems)...)
+	})
+	objects := hegel.Composite(func(tc hegel.TestCase) V {
+		depth++
+		defer func() { depth-- }()
+		return objectOf(hegel.Draw(tc, objectItems))
+	})
+	branches := weighted(choice[V]{4, scalars}, choice[V]{2, tuples}, choice[V]{2, objects})
+	values = hegel.Composite(func(tc hegel.TestCase) V {
+		if depth >= bound {
+			return hegel.Draw(tc, scalars)
+		}
+		return hegel.Draw(tc, branches)
+	})
+	return values
+}
+
+// valueGens: the value trees at depth bounds 0 to 3, with and without nulls.
+var valueGens = func() map[[2]int]hegel.Generator[V] {
+	m := map[[2]int]hegel.Generator[V]{}
+	for bound := 0; bound <= 3; bound++ {
+		m[[2]int{bound, 0}] = valueTrees(bound, false)
+		m[[2]int{bound, 1}] = valueTrees(bound, true)
+	}
+	return m
+}()
+
+// valuesOf: values nesting at most depth levels deep, with nulls or without.
+func valuesOf(depth int, nulls bool) hegel.Generator[V] {
+	if depth < 0 {
+		depth = 0
+	}
+	if depth > 3 {
+		depth = 3
+	}
+	n := 0
+	if nulls {
+		n = 1
+	}
+	return valueGens[[2]int{depth, n}]
+}
+
+// ---------------------------------------------------------------------------
+// Diagnostics and parsing helpers.
+
+func diagText(diags hcl.Diagnostics) string {
+	var parts []string
+	for _, d := range diags {
+		parts = append(parts, d.Error())
+	}
+	return strings.Join(parts, "\n  ")
+}
+
+func parseExpr(ht *hegel.T, src string) hclsyntax.Expression {
+	e, diags := hclsyntax.ParseExpression([]byte(src), "gen.hcl", hcl.InitialPos)
+	if diags.HasErrors() {
+		fail(ht, "hclsyntax.ParseExpression rejects a generated expression:\n%s\n  %s", src, diagText(diags))
+	}
+	return e
+}
+
+func parseConfig(ht *hegel.T, src string, what string) *hcl.File {
+	f, diags := hclsyntax.ParseConfig([]byte(src), "gen.hcl", hcl.InitialPos)
+	if diags.HasErrors() {
+		fail(ht, "hclsyntax.ParseConfig rejects %s:\n%s\n  %s", what, src, diagText(diags))
+	}
+	return f
+}
