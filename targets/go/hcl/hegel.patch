+// hcl/5: what hclwrite writes after editing a one-line block parses.
+func TestHegelPinWriterEditsInOneLineBlockParse(t *testing.T) {
+	edits := map[string]func(b *hclwrite.Body){
+		"SetAttributeValue": func(b *hclwrite.Body) { b.SetAttributeValue("b", cty.True) },
+		"AppendNewBlock":    func(b *hclwrite.Body) { b.AppendNewBlock("inner", nil) },
+	}
+	for _, src := range []string{"resource {}\n", "resource { a = 1 }\n"} {
+		for name, edit := range edits {
+			f, diags := hclwrite.ParseConfig([]byte(src), "pin.hcl", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("parse %q: %s", src, diags)
+			}
+			edit(f.Body().Blocks()[0].Body())
+			out := f.Bytes()
+			if _, diags := hclsyntax.ParseConfig(out, "edited.hcl", hcl.InitialPos); diags.HasErrors() {
+				t.Errorf("%s on the block of %q writes %q, which does not parse: %s", name, src, out, diags)
+			}
+		}
+	}
+}
+
+// hcl/6: a bare template processes the `$${` and `%%{` escapes after a lone
+// carriage return as after any other character.
+func TestHegelPinTemplateEscapesAfterCarriageReturn(t *testing.T) {
+	cases := []struct{ src, want string }{
+		{"\r$$${", "\r$${"},
+		{"\r%%%{", "\r%%{"},
+		{"\r $$${", "\r $${"},
+		{"\r$$${a$$${", "\r$${a$${"},
+		{"\n$$${", "\n$${"},
+	}
+	for _, c := range cases {
+		e, diags := hclsyntax.ParseTemplate([]byte(c.src), "pin.tmpl", hcl.InitialPos)
+		if diags.HasErrors() {
+			t.Fatalf("parse %q: %s", c.src, diags)
+		}
+		v, diags := e.Value(nil)
+		if diags.HasErrors() {
+			t.Fatalf("value of %q: %s", c.src, diags)
+		}
+		if got := v.AsString(); got != c.want {
+			t.Errorf("template %q evaluates to %q, expected %q", c.src, got, c.want)
+		}
+	}
+}
+
+// hcl/7: hclwrite.Format keeps a unary minus after an inline comment as it
+// keeps `a = -1`, so what hclwrite writes for a negative number set after
+// such a comment is in Format's form.
+func TestHegelPinFormatKeepsUnaryMinusAfterComment(t *testing.T) {
+	for _, src := range []string{"a = /* c */ -1\n", "a = [/* c */ -x]\n", "a = f(/* c */ -1.5)\n"} {
+		if got := string(hclwrite.Format([]byte(src))); got != src {
+			t.Errorf("Format(%q) = %q, expected it unchanged", src, got)
+		}
+	}
+	f, diags := hclwrite.ParseConfig([]byte("a = /* c */ 1\n"), "pin.hcl", hcl.InitialPos)
+	if diags.HasErrors() {
+		t.Fatalf("parse: %s", diags)
+	}
+	f.Body().SetAttributeValue("a", cty.NumberIntVal(-3))
+	out := f.Bytes()
+	if formatted := hclwrite.Format(out); string(formatted) != string(out) {
+		t.Errorf("after SetAttributeValue(-3) hclwrite writes %q, which Format changes to %q", out, formatted)
+	}
+}
