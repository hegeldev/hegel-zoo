+package hcl_test
+
+// Statically typed expressions over the value model: generation, a model
+// evaluator transcribed from hclsyntax/spec.md, and spellings in the native
+// syntax. Every generated expression is well typed and total (no index out of
+// range, no division by zero, no null in a template), so hclsyntax must
+// evaluate it without diagnostics to the model's value.
+
+import (
+	"fmt"
+	"math/big"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/hashicorp/hcl/v2/json"
+	"github.com/zclconf/go-cty/cty"
+	"github.com/zclconf/go-cty/cty/function"
+	"github.com/zclconf/go-cty/cty/function/stdlib"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Static types.
+
+type T struct {
+	k      kind
+	elems  []T      // tuple element types
+	keys   []string // object attribute names, sorted
+	fields []T      // object attribute types, aligned with keys
+	list   bool     // list(elem) rather than a tuple
+	elem   *T
+}
+
+var (
+	tNum  = T{k: kNum}
+	tStr  = T{k: kStr}
+	tBool = T{k: kBool}
+)
+
+func typeOf(v V) T {
+	switch v.k {
+	case kTuple:
+		if v.list {
+			et := v.et
+			return T{k: kTuple, list: true, elem: &et}
+		}
+		t := T{k: kTuple, elems: []T{}}
+		for _, e := range v.elems {
+			t.elems = append(t.elems, typeOf(e))
+		}
+		return t
+	case kObj:
+		idx := make([]int, len(v.keys))
+		for i := range idx {
+			idx[i] = i
+		}
+		sort.Slice(idx, func(a, b int) bool { return v.keys[idx[a]] < v.keys[idx[b]] })
+		t := T{k: kObj, keys: []string{}, fields: []T{}}
+		for _, i := range idx {
+			t.keys = append(t.keys, v.keys[i])
+			t.fields = append(t.fields, typeOf(v.elems[i]))
+		}
+		return t
+	default:
+		return T{k: v.k}
+	}
+}
+
+func (t T) eq(u T) bool {
+	if t.k != u.k || t.list != u.list || len(t.elems) != len(u.elems) || len(t.keys) != len(u.keys) {
+		return false
+	}
+	if t.list {
+		return t.elem.eq(*u.elem)
+	}
+	for i := range t.elems {
+		if !t.elems[i].eq(u.elems[i]) {
+			return false
+		}
+	}
+	for i := range t.keys {
+		if t.keys[i] != u.keys[i] || !t.fields[i].eq(u.fields[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (t T) String() string {
+	switch t.k {
+	case kNum:
+		return "number"
+	case kStr:
+		return "string"
+	case kBool:
+		return "bool"
+	case kNull:
+		return "dynamic"
+	case kTuple:
+		if t.list {
+			return "list(" + t.elem.String() + ")"
+		}
+		parts := make([]string, len(t.elems))
+		for i, e := range t.elems {
+			parts[i] = e.String()
+		}
+		return "tuple[" + strings.Join(parts, ", ") + "]"
+	default:
+		parts := make([]string, len(t.keys))
+		for i, k := range t.keys {
+			parts[i] = k + "=" + t.fields[i].String()
+		}
+		return "object{" + strings.Join(parts, ", ") + "}"
+	}
+}
+
+// homogeneous reports whether all elements of a tuple type (or all fields of
+// an object type) share one type, which makes a body typed under one binding
+// well typed under all of them.
+func (t T) homogeneous() (T, bool) {
+	var parts []T
+	if t.list {
+		return *t.elem, true
+	}
+	if t.k == kTuple {
+		parts = t.elems
+	} else if t.k == kObj {
+		parts = t.fields
+	} else {
+		return T{}, false
+	}
+	if len(parts) == 0 {
+		return T{}, false
+	}
+	for _, p := range parts[1:] {
+		if !p.eq(parts[0]) {
+			return T{}, false
+		}
+	}
+	return parts[0], true
+}
+
+// ---------------------------------------------------------------------------
+// Expressions.
+
+type E struct {
+	op    string // lit var bin un cond idx attr splat fsplat fortup forobj tmpl call paren
+	v     V      // lit
+	name  string // var name, attr name, function name, binary/unary operator
+	a     *E
+	b     *E
+	c     *E
+	args  []*E // call arguments, splat steps' attribute names in names
+	names []string
+	// for expressions
+	keyVar, valVar string
+	group          bool
+	// templates
+	parts []tpart
+	// splat steps: attr names ("" = index by ints[i])
+	steps []splatStep
+	// call
+	ellipsis bool
+	sp       spacing
+}
+
+type splatStep struct {
+	attr  string
+	index int
+	isIdx bool
+}
+
+type tpart struct {
+	kind      string // lit interp if for
+	text      string
+	e         *E // interp expression, if condition, for collection
+	then      []tpart
+	els       []tpart
+	hasEl     bool
+	body      []tpart
+	kv        [2]string // for key/value names
+	strip     [2]bool   // strip markers on the opening sequence: after `{`, before `}`
+	stripElse [2]bool
+	stripEnd  [2]bool
+}
+
+// spacing is the whitespace variant used when spelling an expression.
+type spacing int
+
+// ---------------------------------------------------------------------------
+// The scope: variable values.
+
+type scope struct {
+	vars   map[string]V
+	parent *scope
+}
+
+func (s *scope) lookup(name string) (V, bool) {
+	for c := s; c != nil; c = c.parent {
+		if v, ok := c.vars[name]; ok {
+			return v, true
+		}
+	}
+	return V{}, false
+}
+
+func (s *scope) child(vars map[string]V) *scope { return &scope{vars: vars, parent: s} }
+
+// ---------------------------------------------------------------------------
+// Conversions of the information model.
+
+type evalError struct{ msg string }
+
+func (e evalError) Error() string { return e.msg }
+
+func numOf(v V) *big.Float {
+	switch v.k {
+	case kNum:
+		return bigNum(v.num)
+	case kStr:
+		f, _, err := big.ParseFloat(v.s, 10, 512, big.ToNearestEven)
+		if err != nil {
+			panic(evalError{"string not a number: " + v.s})
+		}
+		return f
+	}
+	panic(evalError{"not a number"})
+}
+
+func boolOf(v V) bool {
+	switch v.k {
+	case kBool:
+		return v.b
+	case kStr:
+		if v.s == "true" {
+			return true
+		}
+		if v.s == "false" {
+			return false
+		}
+	}
+	panic(evalError{"not a bool"})
+}
+
+// strOf converts a primitive to string as the information model does.
+func strOf(v V) string {
+	switch v.k {
+	case kStr:
+		return v.s
+	case kNum:
+		return canonNum(v.num)
+	case kBool:
+		return strconv.FormatBool(v.b)
+	}
+	panic(evalError{"not convertible to string"})
+}
+
+func vEq(a, b V) bool {
+	if a.k != b.k || a.list != b.list {
+		return false
+	}
+	switch a.k {
+	case kNull:
+		return true
+	case kBool:
+		return a.b == b.b
+	case kNum:
+		return bigNum(a.num).Cmp(bigNum(b.num)) == 0
+	case kStr:
+		return a.s == b.s
+	case kTuple:
+		if len(a.elems) != len(b.elems) {
+			return false
+		}
+		for i := range a.elems {
+			if !vEq(a.elems[i], b.elems[i]) {
+				return false
+			}
+		}
+		return true
+	case kObj:
+		if len(a.keys) != len(b.keys) {
+			return false
+		}
+		for i, k := range a.keys {
+			j := -1
+			for jj, kk := range b.keys {
+				if kk == k {
+					j = jj
+				}
+			}
+			if j < 0 || !vEq(a.elems[i], b.elems[j]) {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+func floatV(f *big.Float) V { return numV(numText(f)) }
+
+// objGet returns the attribute value of an object.
+func objGet(v V, key string) (V, bool) {
+	for i, k := range v.keys {
+		if k == key {
+			return v.elems[i], true
+		}
+	}
+	return V{}, false
+}
+
+// sortedObj visits an object's attributes in lexicographic key order.
+func sortedKeys(v V) []int {
+	idx := make([]int, len(v.keys))
+	for i := range idx {
+		idx[i] = i
+	}
+	sort.Slice(idx, func(a, b int) bool { return v.keys[idx[a]] < v.keys[idx[b]] })
+	return idx
+}
+
+// ---------------------------------------------------------------------------
+// The model evaluator.
+
+func eval(e *E, sc *scope) V {
+	switch e.op {
+	case "lit":
+		return e.v
+	case "paren":
+		return eval(e.a, sc)
+	case "var":
+		v, ok := sc.lookup(e.name)
+		if !ok {
+			panic(evalError{"unbound " + e.name})
+		}
+		return v
+	case "un":
+		x := eval(e.a, sc)
+		if e.name == "-" {
+			return floatV(new(big.Float).SetPrec(512).Neg(numOf(x)))
+		}
+		return boolV(!boolOf(x))
+	case "bin":
+		l, r := eval(e.a, sc), eval(e.b, sc)
+		switch e.name {
+		case "==":
+			return boolV(vEq(l, r))
+		case "!=":
+			return boolV(!vEq(l, r))
+		case "&&":
+			return boolV(boolOf(l) && boolOf(r))
+		case "||":
+			return boolV(boolOf(l) || boolOf(r))
+		}
+		a, b := numOf(l), numOf(r)
+		switch e.name {
+		case "<":
+			return boolV(a.Cmp(b) < 0)
+		case "<=":
+			return boolV(a.Cmp(b) <= 0)
+		case ">":
+			return boolV(a.Cmp(b) > 0)
+		case ">=":
+			return boolV(a.Cmp(b) >= 0)
+		case "+":
+			return floatV(new(big.Float).SetPrec(512).Add(a, b))
+		case "-":
+			return floatV(new(big.Float).SetPrec(512).Sub(a, b))
+		case "*":
+			return floatV(new(big.Float).SetPrec(512).Mul(a, b))
+		case "/":
+			return floatV(new(big.Float).SetPrec(512).Quo(a, b))
+		case "%":
+			// a - trunc(a/b)*b, the remainder with the dividend's sign.
+			q := new(big.Float).SetPrec(512).Quo(a, b)
+			qi, _ := q.Int(nil)
+			w := new(big.Float).SetPrec(512).SetInt(qi)
+			w.Mul(w, b)
+			return floatV(new(big.Float).SetPrec(512).Sub(a, w))
+		}
+	case "cond":
+		c := boolOf(eval(e.a, sc))
+		t, f := eval(e.b, sc), eval(e.c, sc)
+		tt, ft := typeOf(t), typeOf(f)
+		if tt.eq(ft) {
+			if c {
+				return t
+			}
+			return f
+		}
+		// Unification of differing primitive types converts both to string.
+		if c {
+			return strV(strOf(t))
+		}
+		return strV(strOf(f))
+	case "idx":
+		coll, key := eval(e.a, sc), eval(e.b, sc)
+		switch coll.k {
+		case kTuple:
+			i, _ := numOf(key).Int64()
+			if i < 0 || int(i) >= len(coll.elems) {
+				panic(evalError{"index out of range in " + e.dump()})
+			}
+			return coll.elems[i]
+		case kObj:
+			v, ok := objGet(coll, strOf(key))
+			if !ok {
+				panic(evalError{"no such attribute"})
+			}
+			return v
+		}
+		panic(evalError{"not indexable"})
+	case "attr":
+		coll := eval(e.a, sc)
+		if coll.k == kTuple {
+			// The legacy index operator tuple.N.
+			i, err := strconv.Atoi(e.name)
+			if err != nil || i < 0 || i >= len(coll.elems) {
+				panic(evalError{"legacy index " + e.name})
+			}
+			return coll.elems[i]
+		}
+		v, ok := objGet(coll, e.name)
+		if !ok {
+			panic(evalError{"no such attribute " + e.name})
+		}
+		return v
+	case "splat", "fsplat":
+		src := eval(e.a, sc)
+		var items []V
+		if src.k == kTuple {
+			items = src.elems
+		} else if src.k == kNull {
+			items = nil
+		} else {
+			items = []V{src}
+		}
+		out := []V{}
+		for _, it := range items {
+			cur := it
+			for _, st := range e.steps {
+				if st.isIdx {
+					if cur.k != kTuple || st.index >= len(cur.elems) {
+						panic(evalError{"splat index"})
+					}
+					cur = cur.elems[st.index]
+				} else {
+					var ok bool
+					cur, ok = objGet(cur, st.attr)
+					if !ok {
+						panic(evalError{"splat attr"})
+					}
+				}
+			}
+			out = append(out, cur)
+		}
+		return tupleV(out...)
+	case "fortup", "forobj":
+		coll := eval(e.a, sc)
+		type kv struct{ k, v V }
+		var items []kv
+		switch coll.k {
+		case kTuple:
+			for i, it := range coll.elems {
+				items = append(items, kv{intV(int64(i)), it})
+			}
+		case kObj:
+			for _, i := range sortedKeys(coll) {
+				items = append(items, kv{strV(coll.keys[i]), coll.elems[i]})
+			}
+		default:
+			panic(evalError{"not iterable"})
+		}
+		var outElems []V
+		var outKeys []string
+		groups := map[string][]V{}
+		for _, it := range items {
+			vars := map[string]V{}
+			if e.keyVar != "" {
+				vars[e.keyVar] = it.k
+			}
+			vars[e.valVar] = it.v
+			inner := sc.child(vars)
+			if e.c != nil && !boolOf(eval(e.c, inner)) {
+				continue
+			}
+			if e.op == "fortup" {
+				outElems = append(outElems, eval(e.b, inner))
+				continue
+			}
+			key := strOf(eval(e.b, inner))
+			val := eval(e.args[0], inner)
+			if e.group {
+				if _, seen := groups[key]; !seen {
+					outKeys = append(outKeys, key)
+				}
+				groups[key] = append(groups[key], val)
+				continue
+			}
+			for _, k := range outKeys {
+				if k == key {
+					panic(evalError{"duplicate key " + key})
+				}
+			}
+			outKeys = append(outKeys, key)
+			outElems = append(outElems, val)
+		}
+		if e.op == "fortup" {
+			return tupleV(outElems...)
+		}
+		if e.group {
+			outElems = nil
+			for _, k := range outKeys {
+				outElems = append(outElems, tupleV(groups[k]...))
+			}
+		}
+		if outKeys == nil {
+			outKeys, outElems = []string{}, []V{}
+		}
+		return objV(outKeys, outElems)
+	case "tmpl":
+		return evalTemplate(e.parts, sc)
+	case "tuple":
+		elems := []V{}
+		for _, a := range e.args {
+			elems = append(elems, eval(a, sc))
+		}
+		return tupleV(elems...)
+	case "object":
+		elems := []V{}
+		for _, a := range e.args {
+			elems = append(elems, eval(a, sc))
+		}
+		return objV(e.names, elems)
+	case "call":
+		var args []V
+		for _, a := range e.args {
+			args = append(args, eval(a, sc))
+		}
+		if e.ellipsis {
+			last := args[len(args)-1]
+			args = append(args[:len(args)-1], last.elems...)
+		}
+		return callModel(e.name, args)
+	}
+	panic(evalError{"bad op " + e.op})
+}
+
+// evalTemplate follows the template sub-language: strip markers act on the
+// adjacent literals at syntax level, a template of a single interpolation is
+// unwrapped, everything else is concatenated as strings.
+func evalTemplate(parts []tpart, sc *scope) V {
+	// A template that is a single interpolation (empty literals, such as the
+	// remains of a stripped space, do not count) yields the value itself.
+	if single := soleInterp(parts); single != nil {
+		return eval(single, sc)
+	}
+	var b strings.Builder
+	renderParts(parts, sc, &b)
+	return strV(b.String())
+}
+
+// soleInterp returns the interpolation's expression when the parts are one
+// interpolation beside empty literals only.
+func soleInterp(parts []tpart) *E {
+	var single *E
+	for _, p := range parts {
+		switch {
+		case p.kind == "lit" && p.text == "":
+		case p.kind == "interp" && single == nil:
+			single = p.e
+		default:
+			return nil
+		}
+	}
+	return single
+}
+
+func renderParts(parts []tpart, sc *scope, b *strings.Builder) {
+	for _, p := range parts {
+		switch p.kind {
+		case "lit":
+			b.WriteString(p.text)
+		case "interp":
+			v := eval(p.e, sc)
+			if v.k == kNull {
+				panic(evalError{"null in template"})
+			}
+			b.WriteString(strOf(v))
+		case "if":
+			if boolOf(eval(p.e, sc)) {
+				renderParts(p.then, sc, b)
+			} else if p.hasEl {
+				renderParts(p.els, sc, b)
+			}
+		case "for":
+			coll := eval(p.e, sc)
+			type kv struct{ k, v V }
+			var items []kv
+			switch coll.k {
+			case kTuple:
+				for i, it := range coll.elems {
+					items = append(items, kv{intV(int64(i)), it})
+				}
+			case kObj:
+				for _, i := range sortedKeys(coll) {
+					items = append(items, kv{strV(coll.keys[i]), coll.elems[i]})
+				}
+			}
+			for _, it := range items {
+				vars := map[string]V{}
+				if p.kv[0] != "" {
+					vars[p.kv[0]] = it.k
+				}
+				vars[p.kv[1]] = it.v
+				renderParts(p.body, sc.child(vars), b)
+			}
+		}
+	}
+}
+
+// Functions offered to expressions: the cty stdlib ones the harness models.
+var funcTable = map[string]function.Function{
+	"upper":    stdlib.UpperFunc,
+	"lower":    stdlib.LowerFunc,
+	"strlen":   stdlib.StrlenFunc,
+	"length":   stdlib.LengthFunc,
+	"max":      stdlib.MaxFunc,
+	"min":      stdlib.MinFunc,
+	"abs":      stdlib.AbsoluteFunc,
+	"concat":   stdlib.ConcatFunc,
+	"join":     stdlib.JoinFunc,
+	"keys":     stdlib.KeysFunc,
+	"contains": stdlib.ContainsFunc,
+	"element":  stdlib.ElementFunc,
+	"range":    stdlib.RangeFunc,
+}
+
+func callModel(name string, args []V) V {
+	switch name {
+	case "upper":
+		return strV(strings.ToUpper(strOf(args[0])))
+	case "lower":
+		return strV(strings.ToLower(strOf(args[0])))
+	case "strlen":
+		// Graphemes; the generator only passes strings whose graphemes are
+		// single code points.
+		return intV(int64(len([]rune(strOf(args[0])))))
+	case "length":
+		return intV(int64(len(args[0].elems)))
+	case "max", "min":
+		best := numOf(args[0])
+		for _, a := range args[1:] {
+			f := numOf(a)
+			if (name == "max" && f.Cmp(best) > 0) || (name == "min" && f.Cmp(best) < 0) {
+				best = f
+			}
+		}
+		return floatV(best)
+	case "abs":
+		return floatV(new(big.Float).SetPrec(512).Abs(numOf(args[0])))
+	case "concat":
+		var out []V
+		allLists := true
+		for _, a := range args {
+			out = append(out, a.elems...)
+			if !a.list {
+				allLists = false
+			}
+		}
+		if allLists {
+			return listV(out, args[0].et)
+		}
+		return tupleV(out...)
+	case "join":
+		sep := strOf(args[0])
+		var parts []string
+		for _, a := range args[1:] {
+			for _, el := range a.elems {
+				parts = append(parts, strOf(el))
+			}
+		}
+		return strV(strings.Join(parts, sep))
+	case "keys":
+		var out []V
+		for _, i := range sortedKeys(args[0]) {
+			out = append(out, strV(args[0].keys[i]))
+		}
+		return tupleV(out...)
+	case "contains":
+		for _, el := range args[0].elems {
+			if vEq(el, args[1]) {
+				return boolV(true)
+			}
+		}
+		return boolV(false)
+	case "element":
+		i, _ := numOf(args[1]).Int64()
+		l := int64(len(args[0].elems))
+		return args[0].elems[((i%l)+l)%l]
+	case "range":
+		var out []V
+		var start, end, step int64 = 0, 0, 1
+		switch len(args) {
+		case 1:
+			end, _ = numOf(args[0]).Int64()
+		case 2:
+			start, _ = numOf(args[0]).Int64()
+			end, _ = numOf(args[1]).Int64()
+		case 3:
+			start, _ = numOf(args[0]).Int64()
+			end, _ = numOf(args[1]).Int64()
+			step, _ = numOf(args[2]).Int64()
+		}
+		for i := start; (step > 0 && i < end) || (step < 0 && i > end); i += step {
+			out = append(out, intV(i))
+		}
+		return listV(out, tNum)
+	}
+	panic(evalError{"unknown function " + name})
+}
+
+// ---------------------------------------------------------------------------
+// Spelling expressions in the native syntax.
+
+// Precedence levels (higher binds tighter).
+func precOf(op string) int {
+	switch op {
+	case "||":
+		return 1
+	case "&&":
+		return 2
+	case "==", "!=":
+		return 3
+	case "<", ">", "<=", ">=":
+		return 4
+	case "+", "-":
+		return 5
+	case "*", "/", "%":
+		return 6
+	}
+	panic("bad operator " + op)
+}
+
+func (e *E) prec() int {
+	switch e.op {
+	case "lit":
+		if e.v.k == kNum && strings.HasPrefix(e.v.num, "-") {
+			return 7 // a negative number literal is a negation
+		}
+		return 9
+	case "cond":
+		return 0
+	case "bin":
+		return precOf(e.name)
+	case "un":
+		return 7
+	case "idx", "attr", "splat", "fsplat":
+		return 8
+	default:
+		return 9
+	}
+}
+
+// sp returns the spacing string for the expression's spacing variant.
+func (e *E) space() string {
+	switch e.sp {
+	case 0:
+		return " "
+	case 1:
+		return ""
+	default:
+		return "  "
+	}
+}
+
+// render spells e; minPrec is the lowest precedence allowed without
+// parentheses.
+func render(e *E, minPrec int) string {
+	s := renderBare(e)
+	if e.prec() < minPrec {
+		return "(" + s + ")"
+	}
+	return s
+}
+
+func renderBare(e *E) string {
+	sp := e.space()
+	switch e.op {
+	case "lit":
+		return e.v.native()
+	case "paren":
+		return "(" + sp + render(e.a, 0) + sp + ")"
+	case "var":
+		return e.name
+	case "un":
+		operand := render(e.a, 7)
+		if e.name == "-" && strings.HasPrefix(operand, "-") {
+			return "- " + operand
+		}
+		return e.name + operand
+	case "bin":
+		p := precOf(e.name)
+		left := render(e.a, p)
+		before := sp
+		if e.name == "-" && sp == "" && left != "" && isIdentByte(left[len(left)-1]) {
+			// A `-` glued to an identifier would extend the identifier.
+			before = " "
+		}
+		return left + before + e.name + sp + render(e.b, p+1)
+	case "cond":
+		return render(e.a, 1) + sp + "?" + sp + render(e.b, 0) + sp + ":" + sp + render(e.c, 0)
+	case "idx":
+		return render(e.a, 8) + "[" + sp + render(e.b, 0) + sp + "]"
+	case "attr":
+		return render(e.a, 8) + "." + e.name
+	case "splat", "fsplat":
+		var b strings.Builder
+		b.WriteString(render(e.a, 8))
+		if e.op == "splat" {
+			b.WriteString(".*")
+		} else {
+			b.WriteString("[*]")
+		}
+		for _, st := range e.steps {
+			if st.isIdx {
+				b.WriteString("[" + strconv.Itoa(st.index) + "]")
+			} else {
+				b.WriteString("." + st.attr)
+			}
+		}
+		return b.String()
+	case "fortup", "forobj":
+		var b strings.Builder
+		open, close := "[", "]"
+		if e.op == "forobj" {
+			open, close = "{", "}"
+		}
+		b.WriteString(open + sp + "for ")
+		if e.keyVar != "" {
+			b.WriteString(e.keyVar + "," + sp + e.valVar)
+		} else {
+			b.WriteString(e.valVar)
+		}
+		b.WriteString(" in " + render(e.a, 0) + sp + ":" + sp + render(e.b, 0))
+		if e.op == "forobj" {
+			b.WriteString(sp + "=>" + sp + render(e.args[0], 0))
+			if e.group {
+				b.WriteString("...")
+			}
+		}
+		if e.c != nil {
+			b.WriteString(" if " + render(e.c, 0))
+		}
+		b.WriteString(sp + close)
+		return b.String()
+	case "tmpl":
+		return `"` + renderTemplate(e.parts, false) + `"`
+	case "tuple":
+		parts := make([]string, len(e.args))
+		for i, a := range e.args {
+			parts[i] = render(a, 0)
+		}
+		return "[" + sp + strings.Join(parts, ","+sp) + sp + "]"
+	case "object":
+		parts := make([]string, len(e.args))
+		for i, a := range e.args {
+			parts[i] = nativeKey(e.names[i]) + pick2(e.sp, " = ", ": ") + render(a, 0)
+		}
+		return "{" + sp + strings.Join(parts, ","+sp) + sp + "}"
+	case "call":
+		parts := make([]string, len(e.args))
+		for i, a := range e.args {
+			parts[i] = render(a, 0)
+		}
+		s := e.name + "(" + sp + strings.Join(parts, ","+sp)
+		if e.ellipsis {
+			s += "..."
+		}
+		return s + sp + ")"
+	}
+	panic("bad op " + e.op)
+}
+
+// tmplLit escapes a literal for a quoted template (heredoc=false) or a
+// heredoc body (heredoc=true, where only the template introducers need
+// escaping and newlines are literal).
+func tmplLit(text string, heredoc bool) string {
+	if !heredoc {
+		q := quoteNative(text, false)
+		return q[1 : len(q)-1]
+	}
+	text = strings.ReplaceAll(text, "${", "$${")
+	return strings.ReplaceAll(text, "%{", "%%{")
+}
+
+func seqOpen(kind string, strip bool) string {
+	s := "${"
+	if kind == "ctrl" {
+		s = "%{"
+	}
+	if strip {
+		s += "~"
+	}
+	return s
+}
+
+func seqClose(strip bool) string {
+	if strip {
+		return "~}"
+	}
+	return "}"
+}
+
+// meldLits joins adjacent literal parts (the scanner sees one literal), at
+// every nesting level.
+func meldLits(parts []tpart) []tpart {
+	var out []tpart
+	for _, p := range parts {
+		switch p.kind {
+		case "if":
+			p.then = meldLits(p.then)
+			p.els = meldLits(p.els)
+		case "for":
+			p.body = meldLits(p.body)
+		}
+		if p.kind == "lit" && len(out) > 0 && out[len(out)-1].kind == "lit" {
+			out[len(out)-1].text += p.text
+			continue
+		}
+		out = append(out, p)
+	}
+	return out
+}
+
+// dump spells the model expression tree, for failure messages.
+func (e *E) dump() string {
+	if e == nil {
+		return "_"
+	}
+	var b strings.Builder
+	b.WriteString("(" + e.op)
+	if e.name != "" {
+		b.WriteString(" " + e.name)
+	}
+	if e.op == "lit" {
+		b.WriteString(" " + e.v.native())
+	}
+	for _, c := range []*E{e.a, e.b, e.c} {
+		if c != nil {
+			b.WriteString(" " + c.dump())
+		}
+	}
+	for _, c := range e.args {
+		b.WriteString(" " + c.dump())
+	}
+	for _, p := range e.parts {
+		switch p.kind {
+		case "lit":
+			b.WriteString(" " + strconv.Quote(p.text))
+		case "interp":
+			b.WriteString(" ${" + p.e.dump() + "}")
+		default:
+			b.WriteString(" %{" + p.kind + " " + p.e.dump() + "}")
+		}
+	}
+	b.WriteString(")")
+	return b.String()
+}
+
+func renderTemplate(parts []tpart, heredoc bool) string {
+	return renderTemplateTail(parts, heredoc, false)
+}
+
+// renderTemplateTail spells parts; tailSeq says a control sequence follows
+// the last part (the else/endif/endfor of the enclosing directive).
+func renderTemplateTail(parts []tpart, heredoc bool, tailSeq bool) string {
+	var b strings.Builder
+	parts = meldLits(parts)
+	for i, p := range parts {
+		switch p.kind {
+		case "lit":
+			text := p.text
+			// A literal ending in `$` or `%` right before a sequence would
+			// spell the escape of that sequence: interpolate the character.
+			if (i+1 < len(parts) || tailSeq) && (strings.HasSuffix(text, "$") || strings.HasSuffix(text, "%")) {
+				// All of the trailing `$`/`%` characters go into the
+				// interpolation: a literal `$` right before `${` would spell
+				// the escape `$${`.
+				prefix := strings.TrimRight(text, "$%")
+				b.WriteString(tmplLit(prefix, heredoc))
+				b.WriteString("${" + quoteNative(text[len(prefix):], false) + "}")
+				continue
+			}
+			b.WriteString(tmplLit(text, heredoc))
+		case "interp":
+			b.WriteString(seqOpen("interp", p.strip[0]) + " " + render(p.e, 0) + " " + seqClose(p.strip[1]))
+		case "if":
+			b.WriteString(seqOpen("ctrl", p.strip[0]) + " if " + render(p.e, 0) + " " + seqClose(p.strip[1]))
+			b.WriteString(renderTemplateTail(p.then, heredoc, true))
+			if p.hasEl {
+				b.WriteString(seqOpen("ctrl", p.stripElse[0]) + " else " + seqClose(p.stripElse[1]))
+				b.WriteString(renderTemplateTail(p.els, heredoc, true))
+			}
+			b.WriteString(seqOpen("ctrl", p.stripEnd[0]) + " endif " + seqClose(p.stripEnd[1]))
+		case "for":
+			b.WriteString(seqOpen("ctrl", p.strip[0]) + " for ")
+			if p.kv[0] != "" {
+				b.WriteString(p.kv[0] + ", ")
+			}
+			b.WriteString(p.kv[1] + " in " + render(p.e, 0) + " " + seqClose(p.strip[1]))
+			b.WriteString(renderTemplateTail(p.body, heredoc, true))
+			b.WriteString(seqOpen("ctrl", p.stripEnd[0]) + " endfor " + seqClose(p.stripEnd[1]))
+		}
+	}
+	return b.String()
+}
+
+// applyStrips rewrites the literals of a template according to its strip
+// markers (spaces adjacent to a marker are removed at syntax level), so that
+// the evaluator can ignore the markers. It flattens the syntax order of
+// sequences and literals.
+func applyStrips(parts []tpart) {
+	// Collect the syntax-order sequence of items: literal pointers and
+	// marker pairs.
+	type item struct {
+		lit   *tpart
+		strip [2]bool // marker: strip before (on the preceding literal), strip after (on the following literal)
+	}
+	var items []item
+	var walk func(ps []tpart)
+	walk = func(ps []tpart) {
+		for i := range ps {
+			p := &ps[i]
+			switch p.kind {
+			case "lit":
+				items = append(items, item{lit: p})
+			case "interp":
+				items = append(items, item{strip: p.strip})
+			case "if":
+				items = append(items, item{strip: p.strip})
+				walk(p.then)
+				if p.hasEl {
+					items = append(items, item{strip: p.stripElse})
+					walk(p.els)
+				}
+				items = append(items, item{strip: p.stripEnd})
+			case "for":
+				items = append(items, item{strip: p.strip})
+				walk(p.body)
+				items = append(items, item{strip: p.stripEnd})
+			}
+		}
+	}
+	walk(parts)
+	for i, it := range items {
+		if it.lit != nil {
+			continue
+		}
+		if it.strip[0] && i > 0 && items[i-1].lit != nil {
+			items[i-1].lit.text = strings.TrimRightFunc(items[i-1].lit.text, unicode.IsSpace)
+		}
+		if it.strip[1] && i+1 < len(items) && items[i+1].lit != nil {
+			items[i+1].lit.text = strings.TrimLeftFunc(items[i+1].lit.text, unicode.IsSpace)
+		}
+	}
+}
+
+// freeVars collects the root names of the variable references of e that are
+// not bound by an enclosing for expression or template directive.
+func freeVars(e *E, bound map[string]bool, out map[string]bool) {
+	if e == nil {
+		return
+	}
+	switch e.op {
+	case "var":
+		if !bound[e.name] {
+			out[e.name] = true
+		}
+	case "fortup", "forobj":
+		freeVars(e.a, bound, out)
+		inner := map[string]bool{}
+		for k := range bound {
+			inner[k] = true
+		}
+		inner[e.valVar] = true
+		if e.keyVar != "" {
+			inner[e.keyVar] = true
+		}
+		freeVars(e.b, inner, out)
+		freeVars(e.c, inner, out)
+		for _, a := range e.args {
+			freeVars(a, inner, out)
+		}
+	case "tmpl":
+		freeVarsParts(e.parts, bound, out)
+	default:
+		freeVars(e.a, bound, out)
+		freeVars(e.b, bound, out)
+		freeVars(e.c, bound, out)
+		for _, a := range e.args {
+			freeVars(a, bound, out)
+		}
+	}
+}
+
+func freeVarsParts(parts []tpart, bound map[string]bool, out map[string]bool) {
+	for _, p := range parts {
+		switch p.kind {
+		case "interp":
+			freeVars(p.e, bound, out)
+		case "if":
+			freeVars(p.e, bound, out)
+			freeVarsParts(p.then, bound, out)
+			freeVarsParts(p.els, bound, out)
+		case "for":
+			freeVars(p.e, bound, out)
+			inner := map[string]bool{}
+			for k := range bound {
+				inner[k] = true
+			}
+			inner[p.kv[1]] = true
+			if p.kv[0] != "" {
+				inner[p.kv[0]] = true
+			}
+			freeVarsParts(p.body, inner, out)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The generator.
+
+type gen struct {
+	tc        hegel.TestCase
+	sc        *scope
+	budget    int
+	loopVars  int             // fresh names for for-expression variables
+	loopNames map[string]bool // every loop variable name handed out
+}
+
+// dynamicType reports whether the type of e may differ between bindings of
+// an enclosing for expression: a for expression with a filter or grouping
+// (whose length or keys depend on values) that refers to a loop variable.
+func (g *gen) dynamicType(e *E) bool {
+	if e == nil {
+		return false
+	}
+	if (e.op == "fortup" || e.op == "forobj") && (e.c != nil || e.group) && !g.loopFree(e) {
+		return true
+	}
+	for _, c := range []*E{e.a, e.b, e.c} {
+		if g.dynamicType(c) {
+			return true
+		}
+	}
+	for _, c := range e.args {
+		if g.dynamicType(c) {
+			return true
+		}
+	}
+	for _, p := range e.parts {
+		if g.dynamicType(p.e) {
+			return true
+		}
+	}
+	return false
+}
+
+// loopFree reports whether e refers to no loop variable, so that its value
+// is the same under every binding of an enclosing for expression.
+func (g *gen) loopFree(e *E) bool {
+	free := map[string]bool{}
+	freeVars(e, map[string]bool{}, free)
+	for name := range free {
+		if g.loopNames[name] {
+			return false
+		}
+	}
+	return true
+}
+
+func (g *gen) spend() bool {
+	g.budget--
+	return g.budget >= 0
+}
+
+// lit draws a literal of the wanted type (any type when want is nil).
+func (g *gen) litOf(want *T) V {
+	if want == nil {
+		for tries := 0; tries < 5; tries++ {
+			v := genValue(g.tc, 2)
+			if !hasNull(v) {
+				return v
+			}
+		}
+		return intV(int64(n(g.tc, 0, 9)))
+	}
+	return valueOfType(g.tc, *want)
+}
+
+// hasListValue: v is or contains a list (which has no literal spelling).
+func hasListValue(v V) bool {
+	if v.list {
+		return true
+	}
+	for _, e := range v.elems {
+		if hasListValue(e) {
+			return true
+		}
+	}
+	return false
+}
+
+func hasNull(v V) bool {
+	if v.k == kNull {
+		return true
+	}
+	for _, e := range v.elems {
+		if hasNull(e) {
+			return true
+		}
+	}
+	return false
+}
+
+// valueOfType draws a value of exactly the given type.
+func valueOfType(tc hegel.TestCase, t T) V {
+	if t.list {
+		elems := []V{}
+		for k := n(tc, 0, 3); k > 0; k-- {
+			elems = append(elems, valueOfType(tc, *t.elem))
+		}
+		return listV(elems, *t.elem)
+	}
+	switch t.k {
+	case kNum:
+		if chance(tc, 70) {
+			return intV(int64(n(tc, -30, 30)))
+		}
+		return numV(genNumText(tc))
+	case kStr:
+		return strV(genString(tc))
+	case kBool:
+		return boolV(chance(tc, 50))
+	case kTuple:
+		elems := []V{}
+		for _, et := range t.elems {
+			elems = append(elems, valueOfType(tc, et))
+		}
+		return tupleV(elems...)
+	default:
+		keys, elems := []string{}, []V{}
+		for i, k := range t.keys {
+			keys = append(keys, k)
+			elems = append(elems, valueOfType(tc, t.fields[i]))
+		}
+		// Written in a random order.
+		for i := len(keys) - 1; i > 0; i-- {
+			j := n(tc, 0, i)
+			keys[i], keys[j] = keys[j], keys[i]
+			elems[i], elems[j] = elems[j], elems[i]
+		}
+		return objV(keys, elems)
+	}
+}
+
+// varsOfType lists the variables in scope whose value has the wanted type.
+func (g *gen) varsOfType(want *T) []string {
+	var out []string
+	seen := map[string]bool{}
+	for c := g.sc; c != nil; c = c.parent {
+		for name, v := range c.vars {
+			if seen[name] {
+				continue
+			}
+			seen[name] = true
+			if want == nil || typeOf(v).eq(*want) {
+				out = append(out, name)
+			}
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func (g *gen) lit(v V) *E { return &E{op: "lit", v: v, sp: spacing(n(g.tc, 0, 2))} }
+
+// expr draws a well-typed expression whose value has type want (any type
+// when nil), nesting at most depth levels.
+func (g *gen) expr(want *T, depth int) *E {
+	e := g.exprInner(want, depth)
+	e.sp = spacing(n(g.tc, 0, 2))
+	return e
+}
+
+func (g *gen) exprInner(want *T, depth int) *E {
+	if depth <= 0 || !g.spend() {
+		return g.atom(want)
+	}
+	// Choose a construction; fall back to an atom when it does not fit.
+	switch n(g.tc, 1, 14) {
+	case 1, 2:
+		return g.atom(want)
+	case 3:
+		return &E{op: "paren", a: g.expr(want, depth-1)}
+	case 4, 5:
+		if e := g.binary(want, depth); e != nil {
+			return e
+		}
+	case 6:
+		if e := g.unary(want, depth); e != nil {
+			return e
+		}
+	case 7:
+		return g.conditional(want, depth)
+	case 8:
+		if e := g.index(want, depth); e != nil {
+			return e
+		}
+	case 9:
+		if e := g.getAttr(want, depth); e != nil {
+			return e
+		}
+	case 10:
+		if e := g.splat(want, depth); e != nil {
+			return e
+		}
+	case 11:
+		if e := g.forExpr(want, depth); e != nil {
+			return e
+		}
+	case 12:
+		if e := g.template(want, depth); e != nil {
+			return e
+		}
+	case 13, 14:
+		if e := g.call(want, depth); e != nil {
+			return e
+		}
+	}
+	return g.atom(want)
+}
+
+func (g *gen) atom(want *T) *E {
+	vars := g.varsOfType(want)
+	if len(vars) > 0 && chance(g.tc, 50) {
+		return &E{op: "var", name: pick(g.tc, vars...)}
+	}
+	if want != nil && want.list {
+		// Lists have no literal: only range() makes one (of numbers).
+		if want.elem.k == kNum {
+			return &E{op: "call", name: "range", args: []*E{g.lit(intV(int64(n(g.tc, 0, 4))))}}
+		}
+		if len(vars) > 0 {
+			return &E{op: "var", name: pick(g.tc, vars...)}
+		}
+		panic(evalError{"no way to spell a " + want.String()})
+	}
+	return g.lit(g.litOf(want))
+}
+
+func (g *gen) binary(want *T, depth int) *E {
+	var ops []string
+	if want == nil || want.k == kNum {
+		ops = append(ops, "+", "-", "*", "/", "%")
+	}
+	if want == nil || want.k == kBool {
+		ops = append(ops, "==", "!=", "<", "<=", ">", ">=", "&&", "||")
+	}
+	if len(ops) == 0 {
+		return nil
+	}
+	op := pick(g.tc, ops...)
+	switch op {
+	case "==", "!=":
+		a := g.expr(nil, depth-1)
+		var b *E
+		if chance(g.tc, 60) {
+			t := typeOf(eval(a, g.sc))
+			b = g.expr(&t, depth-1)
+		} else {
+			b = g.expr(nil, depth-1)
+		}
+		return &E{op: "bin", name: op, a: a, b: b}
+	case "&&", "||":
+		return &E{op: "bin", name: op, a: g.boolish(depth - 1), b: g.boolish(depth - 1)}
+	case "/", "%":
+		a := g.numish(depth - 1)
+		var b *E
+		for tries := 0; ; tries++ {
+			b = g.numish(depth - 1)
+			if numOf(eval(b, g.sc)).Sign() != 0 && g.loopFree(b) {
+				break
+			}
+			if tries == 3 {
+				b = g.lit(intV(int64(n(g.tc, 1, 7))))
+				break
+			}
+		}
+		return &E{op: "bin", name: op, a: a, b: b}
+	default:
+		return &E{op: "bin", name: op, a: g.numish(depth - 1), b: g.numish(depth - 1)}
+	}
+}
+
+// numish draws an expression that converts to a number: a number, or (rarely)
+// a string spelling one.
+func (g *gen) numish(depth int) *E {
+	if chance(g.tc, 8) {
+		return g.lit(strV(canonNum(genNumText(g.tc))))
+	}
+	return g.expr(&tNum, depth)
+}
+
+func (g *gen) boolish(depth int) *E {
+	if chance(g.tc, 8) {
+		return g.lit(strV(strconv.FormatBool(chance(g.tc, 50))))
+	}
+	return g.expr(&tBool, depth)
+}
+
+func (g *gen) unary(want *T, depth int) *E {
+	if want != nil && want.k != kNum && want.k != kBool {
+		return nil
+	}
+	if (want == nil && chance(g.tc, 50)) || (want != nil && want.k == kNum) {
+		return &E{op: "un", name: "-", a: g.numish(depth - 1)}
+	}
+	return &E{op: "un", name: "!", a: g.boolish(depth - 1)}
+}
+
+func (g *gen) conditional(want *T, depth int) *E {
+	c := g.boolish(depth - 1)
+	if want == nil && chance(g.tc, 25) {
+		// Differing primitive types unify to string.
+		t1, t2 := pick(g.tc, tNum, tBool), tStr
+		if chance(g.tc, 50) {
+			t1, t2 = t2, t1
+		}
+		return &E{op: "cond", a: c, b: g.expr(&t1, depth-1), c: g.expr(&t2, depth-1)}
+	}
+	b := g.expr(want, depth-1)
+	if g.dynamicType(b) {
+		b = g.atom(want)
+	}
+	t := typeOf(eval(b, g.sc))
+	return &E{op: "cond", a: c, b: b, c: g.expr(&t, depth-1)}
+}
+
+// collectionWith draws a tuple or object expression that has an element of
+// the wanted type at a known position (or any collection when want is nil).
+func (g *gen) collectionWith(want *T, depth int) (coll *E, key V, isTuple bool, ok bool) {
+	// Prefer a variable or generated expression that already is a collection.
+	if chance(g.tc, 50) {
+		e := g.expr(nil, depth-1)
+		v := eval(e, g.sc)
+		if g.dynamicType(e) {
+			v = V{} // its shape may change with the binding: build a literal instead
+		}
+		switch v.k {
+		case kTuple:
+			for tries := 0; tries < 3 && len(v.elems) > 0; tries++ {
+				i := n(g.tc, 0, len(v.elems)-1)
+				if want == nil || typeOf(v.elems[i]).eq(*want) {
+					return e, intV(int64(i)), true, true
+				}
+			}
+		case kObj:
+			for tries := 0; tries < 3 && len(v.keys) > 0; tries++ {
+				i := n(g.tc, 0, len(v.keys)-1)
+				if want == nil || typeOf(v.elems[i]).eq(*want) {
+					return e, strV(v.keys[i]), false, true
+				}
+			}
+		}
+	}
+	// Build a literal collection around an expression of the wanted type.
+	inner := g.expr(want, depth-1)
+	others := n(g.tc, 0, 2)
+	if chance(g.tc, 50) {
+		elems := []*E{}
+		pos := n(g.tc, 0, others)
+		for i := 0; i <= others; i++ {
+			if i == pos {
+				elems = append(elems, inner)
+			} else {
+				elems = append(elems, g.expr(nil, depth-2))
+			}
+		}
+		return &E{op: "tuple", args: elems}, intV(int64(pos)), true, true
+	}
+	keys := []string{}
+	elems := []*E{}
+	pos := n(g.tc, 0, others)
+	var chosen string
+	found := false
+	seen := map[string]bool{}
+	for i := 0; i <= others; i++ {
+		k := genIdent(g.tc)
+		if chance(g.tc, 20) {
+			k = genString(g.tc)
+		}
+		if seen[k] {
+			continue
+		}
+		seen[k] = true
+		keys = append(keys, k)
+		if i == pos {
+			chosen = k
+			found = true
+			elems = append(elems, inner)
+		} else {
+			elems = append(elems, g.expr(nil, depth-2))
+		}
+	}
+	if !found {
+		chosen = keys[0]
+		elems[0] = inner
+	}
+	return &E{op: "object", names: keys, args: elems}, strV(chosen), false, true
+}
+
+// noSplatTail parenthesises a splat so that an index or attribute after it
+// applies to the result rather than becoming a step of the splat.
+func noSplatTail(coll *E) *E {
+	if coll.op == "splat" || coll.op == "fsplat" {
+		return &E{op: "paren", a: coll}
+	}
+	return coll
+}
+
+func (g *gen) index(want *T, depth int) *E {
+	coll, key, isTuple, ok := g.collectionWith(want, depth)
+	if !ok {
+		return nil
+	}
+	coll = noSplatTail(coll)
+	var keyE *E
+	if isTuple {
+		keyE = g.expr(&tNum, depth-2)
+		// Steer the key to the position: pos = key - (key - pos), spelled
+		// as an arithmetic expression, or just the literal.
+		kv := numOf(eval(keyE, g.sc))
+		if chance(g.tc, 70) || !g.loopFree(keyE) || !kv.IsInt() || kv.Cmp(big.NewFloat(1e6)) > 0 || kv.Cmp(big.NewFloat(-1e6)) < 0 {
+			keyE = g.lit(key)
+		} else {
+			i, _ := numOf(key).Int64()
+			k, _ := numOf(eval(keyE, g.sc)).Int64()
+			keyE = &E{op: "bin", name: "-", a: keyE, b: g.lit(intV(k - i))}
+		}
+	} else {
+		if chance(g.tc, 70) {
+			keyE = g.lit(key)
+		} else {
+			keyE = &E{op: "tmpl", parts: []tpart{{kind: "lit", text: key.s}}}
+		}
+	}
+	return &E{op: "idx", a: coll, b: keyE}
+}
+
+func (g *gen) getAttr(want *T, depth int) *E {
+	coll, key, isTuple, ok := g.collectionWith(want, depth)
+	if ok {
+		coll = noSplatTail(coll)
+	}
+	if !ok || isTuple {
+		if ok && isTuple && chance(g.tc, 50) && coll.op != "splat" && coll.op != "fsplat" && !(coll.op == "attr" && isDigits(coll.name)) {
+			// The legacy index operator: tuple.N (after a splat it would read
+			// as a splat step).
+			return &E{op: "attr", a: coll, name: key.num}
+		}
+		return nil
+	}
+	if !isIdent(key.s) || keywords[key.s] {
+		return &E{op: "idx", a: coll, b: g.lit(key)}
+	}
+	return &E{op: "attr", a: coll, name: key.s}
+}
+
+func (g *gen) splat(want *T, depth int) *E {
+	// Source: an expression whose value is a tuple of objects (or a single
+	// object, coerced) that all have a common attribute path.
+	src := g.expr(nil, depth-1)
+	v := eval(src, g.sc)
+	if v.list {
+		return nil // a splat over a list yields a list; the model keeps to tuples here
+	}
+	if src.op == "splat" || src.op == "fsplat" {
+		return nil // a splat directly on a splat is a syntax error by design (v2.24)
+	}
+	var items []V
+	switch v.k {
+	case kTuple:
+		items = v.elems
+	case kObj, kNum, kStr, kBool:
+		items = []V{v}
+	default:
+		return nil
+	}
+	e := &E{op: pick(g.tc, "splat", "fsplat"), a: src}
+	if len(items) == 0 {
+		if want != nil && !want.eq(T{k: kTuple, elems: []T{}}) {
+			return nil
+		}
+		return e
+	}
+	// Walk common steps.
+	cur := items
+	for steps := n(g.tc, 0, 3); steps > 0; steps-- {
+		first := cur[0]
+		var st splatStep
+		switch first.k {
+		case kObj:
+			if len(first.keys) == 0 {
+				steps = 0
+				continue
+			}
+			k := first.keys[n(g.tc, 0, len(first.keys)-1)]
+			if !isIdent(k) || keywords[k] {
+				steps = 0
+				continue
+			}
+			st = splatStep{attr: k}
+		case kTuple:
+			if e.op == "splat" || len(first.elems) == 0 {
+				steps = 0
+				continue
+			}
+			st = splatStep{isIdx: true, index: n(g.tc, 0, len(first.elems)-1)}
+		default:
+			steps = 0
+			continue
+		}
+		var next []V
+		okAll := true
+		for _, it := range cur {
+			if st.isIdx {
+				if it.k != kTuple || st.index >= len(it.elems) {
+					okAll = false
+					break
+				}
+				next = append(next, it.elems[st.index])
+			} else {
+				nv, ok := objGet(it, st.attr)
+				if !ok {
+					okAll = false
+					break
+				}
+				next = append(next, nv)
+			}
+		}
+		if !okAll {
+			break
+		}
+		e.steps = append(e.steps, st)
+		cur = next
+	}
+	if want != nil && !typeOf(tupleV(cur...)).eq(*want) {
+		return nil
+	}
+	return e
+}
+
+func (g *gen) freshVar() string {
+	g.loopVars++
+	name := pick(g.tc, "v", "item", "el", "k-v", "ζ") + strconv.Itoa(g.loopVars)
+	if g.loopNames == nil {
+		g.loopNames = map[string]bool{}
+	}
+	g.loopNames[name] = true
+	return name
+}
+
+// iterable draws an expression over a homogeneous tuple or object and the
+// common element type.
+func (g *gen) iterable(depth int) (*E, T, bool) {
+	for tries := 0; tries < 3; tries++ {
+		coll := g.expr(nil, depth-1)
+		v := eval(coll, g.sc)
+		if v.k != kTuple && v.k != kObj {
+			continue
+		}
+		if len(v.elems) == 0 {
+			return coll, T{}, true
+		}
+		if et, ok := typeOf(v).homogeneous(); ok {
+			return coll, et, true
+		}
+	}
+	// Build one: a tuple of values of one type.
+	et := typeOf(g.litOf(nil))
+	elems := []*E{}
+	for k := n(g.tc, 1, 3); k > 0; k-- {
+		elems = append(elems, g.expr(&et, depth-2))
+	}
+	return &E{op: "tuple", args: elems}, et, true
+}
+
+func (g *gen) forExpr(want *T, depth int) *E {
+	coll, et, ok := g.iterable(depth)
+	if !ok {
+		return nil
+	}
+	v := eval(coll, g.sc)
+	e := &E{op: pick(g.tc, "fortup", "forobj"), a: coll, valVar: g.freshVar()}
+	if chance(g.tc, 50) {
+		e.keyVar = g.freshVar()
+	}
+	// Bind the loop variables to a sample element to type the body.
+	sample := map[string]V{}
+	if len(v.elems) > 0 {
+		sample[e.valVar] = v.elems[0]
+		if e.keyVar != "" {
+			if v.k == kTuple {
+				sample[e.keyVar] = intV(0)
+			} else {
+				sample[e.keyVar] = strV(v.keys[0])
+			}
+		}
+	} else {
+		sample[e.valVar] = valueOfType(g.tc, et)
+		if e.keyVar != "" {
+			sample[e.keyVar] = intV(0)
+		}
+	}
+	saved := g.sc
+	g.sc = saved.child(sample)
+	defer func() { g.sc = saved }()
+	if e.op == "fortup" {
+		var bodyWant *T
+		if want != nil {
+			if want.k != kTuple {
+				return nil
+			}
+			if bt, ok := want.homogeneous(); ok {
+				bodyWant = &bt
+			} else if len(want.elems) > 0 {
+				return nil
+			}
+		}
+		e.b = g.expr(bodyWant, depth-1)
+	} else {
+		// Keys: distinct strings unless grouping.
+		e.group = chance(g.tc, 30)
+		if e.keyVar != "" && chance(g.tc, 60) {
+			// The key variable is unique per element: as a string it stays so.
+			if v.k == kTuple {
+				e.b = &E{op: "tmpl", parts: []tpart{{kind: "lit", text: "k"}, {kind: "interp", e: &E{op: "var", name: e.keyVar}}}}
+			} else {
+				e.b = &E{op: "var", name: e.keyVar}
+			}
+		} else if e.group {
+			e.b = g.expr(&tStr, depth-1)
+		} else {
+			// Distinct keys from the element itself when it is a primitive
+			// and the elements are distinct; else a constant per position via
+			// the key variable is not available, so fall back to grouping.
+			e.group = true
+			e.b = g.expr(&tStr, depth-1)
+		}
+		e.args = []*E{g.expr(nil, depth-1)}
+	}
+	if chance(g.tc, 40) {
+		e.c = g.boolish(depth - 1)
+	}
+	g.sc = saved
+	// Check the result type when one is wanted, and that evaluation is total.
+	res, err := tryEval(e, g.sc)
+	if err != nil {
+		return nil
+	}
+	if want != nil && !typeOf(res).eq(*want) {
+		return nil
+	}
+	return e
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func isIdentByte(b byte) bool {
+	return b == '_' || b == '-' || b >= 0x80 || (b >= '0' && b <= '9') || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
+}
+
+func tryEval(e *E, sc *scope) (v V, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			if ee, ok := r.(evalError); ok {
+				err = ee
+				return
+			}
+			panic(r)
+		}
+	}()
+	return eval(e, sc), nil
+}
+
+// template draws a quoted template expression; its value is a string (a
+// template of a single interpolation is unwrapped and has the inner type).
+func (g *gen) template(want *T, depth int) *E {
+	if want != nil && want.k != kStr && chance(g.tc, 50) {
+		// Unwrapped single interpolation of the wanted type.
+		inner := g.expr(want, depth-1)
+		return &E{op: "tmpl", parts: []tpart{{kind: "interp", e: inner}}}
+	}
+	if want != nil && want.k != kStr {
+		return nil
+	}
+	parts := meldLits(g.templateParts(depth-1, 0))
+	if len(parts) > 0 && parts[0].kind == "lit" && parts[0].text == "" {
+		parts = parts[1:]
+	}
+	if len(parts) > 0 && parts[len(parts)-1].kind == "lit" && parts[len(parts)-1].text == "" {
+		parts = parts[:len(parts)-1]
+	}
+	if len(parts) == 1 && parts[0].kind == "interp" {
+		// Would unwrap: make it a string with a literal beside it.
+		parts = append(parts, tpart{kind: "lit", text: pick(g.tc, " ", "x", "-", "$")})
+	}
+	if len(parts) == 0 {
+		parts = []tpart{{kind: "lit", text: genString(g.tc)}}
+	}
+	parts = meldLits(parts)
+	applyStrips(parts)
+	if soleInterp(parts) != nil {
+		// The strip markers ate the literal beside the interpolation: add
+		// one they cannot strip.
+		parts = append(parts, tpart{kind: "lit", text: pick(g.tc, "x", "-")})
+	}
+	return &E{op: "tmpl", parts: parts}
+}
+
+func (g *gen) stripPair() [2]bool {
+	if chance(g.tc, 75) {
+		return [2]bool{}
+	}
+	return [2]bool{chance(g.tc, 50), chance(g.tc, 50)}
+}
+
+func (g *gen) templateParts(depth int, nesting int) []tpart {
+	var parts []tpart
+	for k := n(g.tc, 0, 4); k > 0; k-- {
+		switch n(g.tc, 1, 8) {
+		case 1, 2, 3:
+			text := genString(g.tc)
+			if chance(g.tc, 40) {
+				text = pick(g.tc, " ", "  ", " x ", "\t", "a b", " ", "　", "~", "~}", "%", "$")
+			}
+			parts = append(parts, tpart{kind: "lit", text: text})
+		case 4, 5, 6:
+			t := pick(g.tc, tStr, tNum, tBool)
+			parts = append(parts, tpart{kind: "interp", e: g.expr(&t, depth-1), strip: g.stripPair()})
+		case 7:
+			if nesting >= 2 {
+				continue
+			}
+			p := tpart{kind: "if", e: g.boolish(depth - 1), strip: g.stripPair(), stripEnd: g.stripPair()}
+			p.then = g.templateParts(depth-1, nesting+1)
+			if chance(g.tc, 60) {
+				p.hasEl = true
+				p.stripElse = g.stripPair()
+				p.els = g.templateParts(depth-1, nesting+1)
+			}
+			parts = append(parts, p)
+		case 8:
+			if nesting >= 2 {
+				continue
+			}
+			coll, et, ok := g.iterable(depth)
+			if !ok || (et.k != kNum && et.k != kStr && et.k != kBool && et.k != kNull) {
+				continue
+			}
+			p := tpart{kind: "for", e: coll, strip: g.stripPair(), stripEnd: g.stripPair()}
+			p.kv[1] = g.freshVar()
+			if chance(g.tc, 50) {
+				p.kv[0] = g.freshVar()
+			}
+			v := eval(coll, g.sc)
+			sample := map[string]V{}
+			if len(v.elems) > 0 {
+				sample[p.kv[1]] = v.elems[0]
+			} else {
+				sample[p.kv[1]] = strV("")
+			}
+			if p.kv[0] != "" {
+				sample[p.kv[0]] = intV(0)
+				if v.k == kObj && len(v.keys) > 0 {
+					sample[p.kv[0]] = strV(v.keys[0])
+				}
+			}
+			saved := g.sc
+			g.sc = saved.child(sample)
+			p.body = g.templateParts(depth-1, nesting+1)
+			g.sc = saved
+			parts = append(parts, p)
+		}
+	}
+	return parts
+}
+
+// asciiSimple reports whether every grapheme of s is one code point.
+func asciiSimple(s string) bool {
+	for _, r := range s {
+		if r >= 0x300 || r == '\r' {
+			return false
+		}
+	}
+	return true
+}
+
+func (g *gen) call(want *T, depth int) *E {
+	var names []string
+	if want == nil || want.k == kStr {
+		names = append(names, "upper", "lower", "join")
+	}
+	if want == nil || want.k == kNum {
+		names = append(names, "strlen", "length", "max", "min", "abs")
+	}
+	if want == nil || want.k == kTuple {
+		names = append(names, "concat", "keys", "range")
+	}
+	if want == nil || want.k == kBool {
+		names = append(names, "contains")
+	}
+	names = append(names, "element")
+	name := pick(g.tc, names...)
+	e := &E{op: "call", name: name}
+	switch name {
+	case "upper", "lower":
+		e.args = []*E{g.expr(&tStr, depth-1)}
+	case "strlen":
+		s := g.expr(&tStr, depth-1)
+		if !asciiSimple(eval(s, g.sc).s) || !g.loopFree(s) {
+			return nil
+		}
+		e.args = []*E{s}
+	case "length":
+		coll, _, ok := g.iterable(depth)
+		if !ok || eval(coll, g.sc).k != kTuple {
+			return nil
+		}
+		e.args = []*E{coll}
+	case "max", "min":
+		for k := n(g.tc, 1, 3); k > 0; k-- {
+			e.args = append(e.args, g.expr(&tNum, depth-1))
+		}
+		if chance(g.tc, 30) {
+			// Expand a tuple of numbers: max(a, [1, 2]...).
+			var elems []*E
+			for k := n(g.tc, 1, 3); k > 0; k-- {
+				elems = append(elems, g.expr(&tNum, depth-2))
+			}
+			e.args = append(e.args, &E{op: "tuple", args: elems})
+			e.ellipsis = true
+		}
+	case "abs":
+		e.args = []*E{g.expr(&tNum, depth-1)}
+	case "concat":
+		var lists, tuples int
+		var firstET T
+		for k := n(g.tc, 1, 3); k > 0; k-- {
+			coll, _, ok := g.iterable(depth)
+			if !ok || eval(coll, g.sc).k != kTuple {
+				return nil
+			}
+			v := eval(coll, g.sc)
+			if v.list {
+				if lists == 0 {
+					firstET = v.et
+				} else if !firstET.eq(v.et) {
+					return nil
+				}
+				lists++
+			} else {
+				tuples++
+			}
+			e.args = append(e.args, coll)
+		}
+	case "join":
+		coll, et, ok := g.iterable(depth)
+		if !ok || eval(coll, g.sc).k != kTuple || (et.k != kStr && et.k != kNum && et.k != kBool && et.k != kNull) {
+			return nil
+		}
+		e.args = []*E{g.expr(&tStr, depth-1), coll}
+	case "keys":
+		coll, _, ok := g.iterable(depth)
+		if !ok || eval(coll, g.sc).k != kObj {
+			return nil
+		}
+		e.args = []*E{coll}
+	case "range":
+		// range(end), range(start, end), range(start, end, step): the end must
+		// not lie before the start in the step's direction.
+		start := int64(n(g.tc, -3, 5))
+		step := int64(pick(g.tc, 1, 2, -1, 3, -2))
+		if !chance(g.tc, 50) {
+			step = 1
+		}
+		span := int64(n(g.tc, 0, 5))
+		end := start + span
+		if step < 0 {
+			end = start - span
+		}
+		switch n(g.tc, 1, 3) {
+		case 1:
+			e.args = []*E{g.lit(intV(int64(n(g.tc, 0, 5))))}
+		case 2:
+			e.args = []*E{g.lit(intV(start)), g.lit(intV(start + span))}
+		default:
+			e.args = []*E{g.lit(intV(start)), g.lit(intV(end)), g.lit(intV(step))}
+		}
+	case "contains":
+		coll, et, ok := g.iterable(depth)
+		if !ok || eval(coll, g.sc).k != kTuple || et.k == kNull {
+			return nil
+		}
+		v := eval(coll, g.sc)
+		var needle *E
+		if pickIdx := n(g.tc, 0, len(v.elems)); len(v.elems) > 0 && pickIdx < len(v.elems) && !hasListValue(v.elems[pickIdx]) {
+			// An element as the needle (a list element has no literal).
+			needle = g.lit(v.elems[pickIdx])
+		} else {
+			needle = g.expr(&et, depth-1)
+		}
+		e.args = []*E{coll, needle}
+	case "element":
+		coll, et, ok := g.iterable(depth)
+		if !ok || eval(coll, g.sc).k != kTuple || len(eval(coll, g.sc).elems) == 0 {
+			return nil
+		}
+		if want != nil && !et.eq(*want) {
+			return nil
+		}
+		e.args = []*E{coll, g.lit(intV(int64(n(g.tc, 0, 9))))}
+	}
+	if _, err := tryEval(e, g.sc); err != nil {
+		return nil
+	}
+	if want != nil && !typeOf(eval(e, g.sc)).eq(*want) {
+		return nil
+	}
+	return e
+}
+
+// ---------------------------------------------------------------------------
+// The environment of a test case: variables with random values.
+
+var varPool = []string{"a", "b", "foo", "bar_baz", "x1", "with-dash", "_u", "name", "count", "tags", "λ", "in_", "true_"}
+
+func genEnv(tc hegel.TestCase) *scope {
+	vars := map[string]V{}
+	for _, name := range varPool {
+		if chance(tc, 70) {
+			for tries := 0; tries < 4; tries++ {
+				v := genValue(tc, 2)
+				if !hasNull(v) {
+					vars[name] = v
+					break
+				}
+			}
+		}
+	}
+	return &scope{vars: vars}
+}
+
+func evalContext(sc *scope) *hcl.EvalContext {
+	ctx := &hcl.EvalContext{Variables: map[string]cty.Value{}, Functions: funcTable}
+	for name, v := range sc.vars {
+		ctx.Variables[name] = v.cty()
+	}
+	return ctx
+}
+
+func pick2(sp spacing, a, b string) string {
+	if sp == 2 {
+		return b
+	}
+	return a
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// TestHegelExpressionsEvaluateAsTheSpecSays: a well-typed generated
+// expression, spelled in the native syntax, parses and evaluates to the
+// model's value; spelled as a JSON string template "${...}", the JSON syntax
+// agrees.
+func TestHegelExpressionsEvaluateAsTheSpecSays(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sc := genEnv(ht)
+		g := &gen{tc: ht, sc: sc, budget: 40}
+		e := g.expr(nil, n(ht, 1, 4))
+		want, err := tryEval(e, sc)
+		if err != nil {
+			ht.Assume(false)
+			return
+		}
+		src := render(e, 0)
+		note(ht, "expression: %s", src)
+		note(ht, "expected: %#v", want.cty())
+		expr := parseExpr(ht, src)
+		ctx := evalContext(sc)
+		got, diags := expr.Value(ctx)
+		if diags.HasErrors() {
+			fail(ht, "hclsyntax evaluation fails:\n%s\nexpected %#v\n  %s", src, want.cty(), diagText(diags))
+		}
+		if !sameValue(got, want.cty()) {
+			fail(ht, "hclsyntax value differs from the model:\n%s\n     got %#v\nexpected %#v", src, got, want.cty())
+		}
+		// The same expression inside a JSON string template.
+		if strings.ContainsAny(src, "\n") {
+			return
+		}
+		jsrc := quoteJSONRaw("${" + src + "}")
+		jexpr, diags := json.ParseExpression([]byte(jsrc), "gen.json")
+		if diags.HasErrors() {
+			fail(ht, "json.ParseExpression rejects:\n%s\n  %s", jsrc, diagText(diags))
+		}
+		jgot, diags := jexpr.Value(ctx)
+		if diags.HasErrors() {
+			fail(ht, "json evaluation fails:\n%s\nexpected %#v\n  %s", jsrc, want.cty(), diagText(diags))
+		}
+		if !sameValue(jgot, want.cty()) {
+			fail(ht, "json value differs from the model:\n%s\n     got %#v\nexpected %#v", jsrc, jgot, want.cty())
+		}
+	})
+}
+
+// quoteJSONRaw spells s as a JSON string literal without any template
+// escaping (the content is meant to be read as a template).
+func quoteJSONRaw(s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, r := range s {
+		switch r {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\r':
+			b.WriteString(`\r`)
+		case '\t':
+			b.WriteString(`\t`)
+		default:
+			if r < 0x20 || r == 0x7f {
+				fmt.Fprintf(&b, `\u%04x`, r)
+			} else {
+				b.WriteRune(r)
+			}
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// TestHegelVariablesAreTheFreeReferences: Expression.Variables() names
+// exactly the variables an expression refers to outside its own for scopes.
+func TestHegelVariablesAreTheFreeReferences(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sc := genEnv(ht)
+		g := &gen{tc: ht, sc: sc, budget: 40}
+		e := g.expr(nil, n(ht, 1, 4))
+		if _, err := tryEval(e, sc); err != nil {
+			ht.Assume(false)
+			return
+		}
+		src := render(e, 0)
+		note(ht, "expression: %s", src)
+		want := map[string]bool{}
+		freeVars(e, map[string]bool{}, want)
+		expr := parseExpr(ht, src)
+		got := map[string]bool{}
+		for _, tr := range expr.Variables() {
+			got[tr.RootName()] = true
+		}
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "Variables() differs:\n%s\n     got %v\nexpected %v", src, keysOf(got), keysOf(want))
+		}
+		// Every traversal must be one of the scope's variables, and the
+		// expression must be spelled by the source range of each.
+		for _, tr := range expr.Variables() {
+			rng := tr.SourceRange()
+			text := string(rng.SliceBytes([]byte(src)))
+			if !strings.HasPrefix(text, tr.RootName()) {
+				fail(ht, "traversal range %s of %q does not start with its root name in:\n%s", rng, text, src)
+			}
+		}
+	})
+}
+
+func keysOf(m map[string]bool) []string {
+	var out []string
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
