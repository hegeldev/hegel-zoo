+// Deterministic pins for the recorded bugs (bugs.toml). Each asserts the
+// correct behaviour and fails while the bug is open; the properties skip the
+// shape behind the matching Known gate in hegel_test.go.
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/hashicorp/hcl/v2/hclwrite"
+	"github.com/zclconf/go-cty/cty"
+)
+
+func evalAttr(t *testing.T, src string) cty.Value {
+	t.Helper()
+	f, diags := hclsyntax.ParseConfig([]byte(src), "pin.hcl", hcl.InitialPos)
+	if diags.HasErrors() {
+		t.Fatalf("parse: %s", diags)
+	}
+	attrs, diags := f.Body.JustAttributes()
+	if diags.HasErrors() {
+		t.Fatalf("attributes: %s", diags)
+	}
+	v, diags := attrs["a"].Expr.Value(nil)
+	if diags.HasErrors() {
+		t.Fatalf("value: %s", diags)
+	}
+	return v
+}
+
+// hcl/1: the spec says an indented heredoc finds the minimum leading
+// whitespace of the line-leading literals and removes that much "from all
+// line-leading literal strings"; whitespace-only lines keep theirs. Both
+// readings of the minimum (over every line, or over the non-blank lines as
+// the implementation does) are accepted; a blank line left indented while
+// the others were stripped is not.
+func TestHegelPinIndentedHeredocStripsBlankLines(t *testing.T) {
+	cases := []struct {
+		src  string
+		want []string
+	}{
+		{"a = <<-END\n  x\n \nEND\n", []string{"x\n\n", " x\n\n"}},
+		{"a = <<-END\n \nEND\n", []string{"\n"}},
+		{"a = <<-END\n\tx\n\t\n\ty\nEND\n", []string{"x\n\ny\n"}},
+	}
+	for _, c := range cases {
+		got := evalAttr(t, c.src).AsString()
+		ok := false
+		for _, w := range c.want {
+			ok = ok || got == w
+		}
+		if !ok {
+			t.Errorf("%q evaluates to %q, expected one of %q", c.src, got, c.want)
+		}
+	}
+}
+
+// hcl/2: hclwrite's Labels() must list every quoted label, including those
+// spelled with template escapes.
+func TestHegelPinWriterKeepsEscapedLabels(t *testing.T) {
+	cases := []struct {
+		src  string
+		want []string
+	}{
+		{"resource \"a$\" \"b\" {}\n", []string{"a$", "b"}},
+		{"resource \"a%\" {}\n", []string{"a%"}},
+		{"resource \"$${x}\" \"b\" {}\n", []string{"${x}", "b"}},
+		{"resource \"%%{x}\" {}\n", []string{"%{x}"}},
+	}
+	for _, c := range cases {
+		f, diags := hclwrite.ParseConfig([]byte(c.src), "pin.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			t.Fatalf("parse %q: %s", c.src, diags)
+		}
+		got := f.Body().Blocks()[0].Labels()
+		if !reflect.DeepEqual(got, c.want) {
+			t.Errorf("Labels() of %q = %q, expected %q", c.src, got, c.want)
+		}
+	}
+}
+
+// hcl/3: hclwrite keeps a comment between a block's type and its first
+// label, as it keeps every other comment.
+func TestHegelPinWriterKeepsCommentAfterBlockType(t *testing.T) {
+	for _, src := range []string{"resource /* c */ \"a\" {}\n", "resource /* c */ a {}\n"} {
+		f, diags := hclwrite.ParseConfig([]byte(src), "pin.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			t.Fatalf("parse %q: %s", src, diags)
+		}
+		want := string(hclwrite.Format([]byte(src)))
+		if got := string(f.Bytes()); got != want {
+			t.Errorf("hclwrite.ParseConfig(%q).Bytes() = %q, expected %q (Format's output)", src, got, want)
+		}
+	}
+}
+
+// hcl/4: the body PartialContent leaves behaves as if the extracted blocks
+// were not there, for JustAttributes as for Content.
+func TestHegelPinJustAttributesIgnoresExtractedBlocks(t *testing.T) {
+	f, diags := hclsyntax.ParseConfig([]byte("resource {}\na = 1\n"), "pin.hcl", hcl.InitialPos)
+	if diags.HasErrors() {
+		t.Fatalf("parse: %s", diags)
+	}
+	schema := &hcl.BodySchema{Blocks: []hcl.BlockHeaderSchema{{Type: "resource"}}}
+	content, remain, diags := f.Body.PartialContent(schema)
+	if diags.HasErrors() || len(content.Blocks) != 1 {
+		t.Fatalf("PartialContent: %d blocks, %s", len(content.Blocks), diags)
+	}
+	if _, diags := remain.Content(&hcl.BodySchema{Attributes: []hcl.AttributeSchema{{Name: "a"}}}); diags.HasErrors() {
+		t.Fatalf("Content on the remainder: %s", diags)
+	}
+	attrs, diags := remain.JustAttributes()
+	if diags.HasErrors() {
+		t.Errorf("JustAttributes on the remainder reports %s", diags)
+	}
+	if len(attrs) != 1 || attrs["a"] == nil {
+		t.Errorf("JustAttributes on the remainder has %d attributes, expected just a", len(attrs))
+	}
+}
+
+// hcl/5: what hclwrite writes after editing a one-line block parses.
+func TestHegelPinWriterEditsInOneLineBlockParse(t *testing.T) {
+	edits := map[string]func(b *hclwrite.Body){
+		"SetAttributeValue": func(b *hclwrite.Body) { b.SetAttributeValue("b", cty.True) },
+		"AppendNewBlock":    func(b *hclwrite.Body) { b.AppendNewBlock("inner", nil) },
+	}
+	for _, src := range []string{"resource {}\n", "resource { a = 1 }\n"} {
+		for name, edit := range edits {
+			f, diags := hclwrite.ParseConfig([]byte(src), "pin.hcl", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("parse %q: %s", src, diags)
+			}
+			edit(f.Body().Blocks()[0].Body())
+			out := f.Bytes()
+			if _, diags := hclsyntax.ParseConfig(out, "edited.hcl", hcl.InitialPos); diags.HasErrors() {
+				t.Errorf("%s on the block of %q writes %q, which does not parse: %s", name, src, out, diags)
+			}
+		}
+	}
+}
