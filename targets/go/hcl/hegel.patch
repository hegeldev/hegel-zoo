+// ---------------------------------------------------------------------------
+// Edits on parsed files.
+
+// TestHegelEditsOnParsedFilesKeepTheRest: a generated file parsed by
+// hclwrite survives a sequence of edits: after each, the bytes parse and
+// offer the edited model's content, and untouched attributes keep their
+// expressions.
+func TestHegelEditsOnParsedFilesKeepTheRest(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, sc, _ := genConfig(ht)
+		ctx := evalContext(sc)
+		if Known.writerOneLineBlock {
+			clearOneLine(b) // hcl/5
+		}
+		src := []byte(spellNative(ht, b, false))
+		note(ht, "source:\n%s", src)
+		parseConfig(ht, string(src), "the generated file")
+		wf, diags := hclwrite.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclwrite.ParseConfig rejects what hclsyntax accepts:\n%s\n  %s", src, diagText(diags))
+		}
+		for k := n(ht, 1, 5); k > 0; k-- {
+			editBody(ht, wf.Body(), b, sc)
+			out := wf.Bytes()
+			pf, diags := hclsyntax.ParseConfig(out, "edited.hcl", hcl.InitialPos)
+			if diags.HasErrors() {
+				fail(ht, "hclsyntax rejects a file edited with hclwrite:\n%s\n  %s\noriginal:\n%s", out, diagText(diags), src)
+			}
+			if msg := checkContent(pf.Body, b, ctx, sc, "edited"); msg != "" {
+				fail(ht, "%s\nedited:\n%s\noriginal:\n%s", msg, out, src)
+			}
+			if formatted := hclwrite.Format(out); !bytes.Equal(formatted, out) {
+				fail(ht, "an edited file is not in Format's form:\nedited:\n%s\nformatted:\n%s", out, formatted)
+			}
+		}
+	})
+}
