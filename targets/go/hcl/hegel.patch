@@ -0,0 +1,571 @@
+package hcl_test
+
+// Hegel properties for github.com/hashicorp/hcl/v2 (the Hegel zoo). Oracles:
+// the native syntax specification (hclsyntax/spec.md) as a model evaluator
+// over generated, statically typed expressions; the JSON syntax (json/spec.md)
+// against the native syntax on the same values and bodies; hclwrite against
+// hclsyntax (a formatted or generated file must parse to the same content,
+// formatting changes only whitespace and is idempotent, ParseConfig preserves
+// the input verbatim); the source text (ranges); and the parsers against
+// panics on mutated input.
+
+import (
+	"fmt"
+	"math/big"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/zclconf/go-cty/cty"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness plumbing (shared with the other Go targets of the zoo).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("HCL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if ee, ok := r.(evalError); ok {
+				ht.Fatalf("GENERATOR: the model cannot evaluate what it generated: %v", ee)
+			}
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow (E_STOP_TEST on an overrun)
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	flushBlankLines    bool // hcl/1: `<<-` heredocs leave whitespace-only lines unstripped (the spec strips the common prefix from every line)
+	writerEscapedLabel bool // hcl/2: hclwrite drops a quoted block label that contains a `$` or `%` beside other characters ("a$", "$${x}") from Labels()
+	writerTypeComment  bool // hcl/3: hclwrite drops a comment between a block's type and its first label
+	partialJustAttrs   bool // hcl/4: hclsyntax JustAttributes on the body PartialContent leaves reports the extracted blocks as "Unexpected block"
+	writerOneLineBlock bool // hcl/5: hclwrite edits inside a one-line block (`resource {}`, `resource { a = 1 }`) produce invalid HCL (upstream #687)
+}{flushBlankLines: true, writerEscapedLabel: true, writerTypeComment: true, partialJustAttrs: true, writerOneLineBlock: true}
+
+// ---------------------------------------------------------------------------
+// The value model: the values the generators build, with the cty value they
+// denote and their spellings in the native and the JSON syntax.
+
+type kind int
+
+const (
+	kNull kind = iota
+	kBool
+	kNum
+	kStr
+	kTuple
+	kObj
+)
+
+type V struct {
+	k     kind
+	b     bool
+	num   string // decimal literal text
+	s     string
+	elems []V
+	keys  []string // object attribute names, in the order they are written
+	list  bool     // a list (of et) rather than a tuple: only functions produce these
+	et    T
+}
+
+func nullV() V           { return V{k: kNull} }
+func boolV(b bool) V     { return V{k: kBool, b: b} }
+func numV(text string) V { return V{k: kNum, num: text} }
+func intV(i int64) V     { return numV(strconv.FormatInt(i, 10)) }
+func strV(s string) V    { return V{k: kStr, s: s} }
+func tupleV(elems ...V) V {
+	if elems == nil {
+		elems = []V{}
+	}
+	return V{k: kTuple, elems: elems}
+}
+func objV(keys []string, elems []V) V { return V{k: kObj, keys: keys, elems: elems} }
+func listV(elems []V, et T) V {
+	if elems == nil {
+		elems = []V{}
+	}
+	return V{k: kTuple, elems: elems, list: true, et: et}
+}
+
+// ctyType is the cty type of a model type.
+func ctyType(t T) cty.Type {
+	switch t.k {
+	case kNum:
+		return cty.Number
+	case kStr:
+		return cty.String
+	case kBool:
+		return cty.Bool
+	case kNull:
+		return cty.DynamicPseudoType
+	case kTuple:
+		if t.list {
+			return cty.List(ctyType(*t.elem))
+		}
+		etys := make([]cty.Type, len(t.elems))
+		for i, e := range t.elems {
+			etys[i] = ctyType(e)
+		}
+		return cty.Tuple(etys)
+	default:
+		atys := map[string]cty.Type{}
+		for i, k := range t.keys {
+			atys[k] = ctyType(t.fields[i])
+		}
+		return cty.Object(atys)
+	}
+}
+
+func (v V) cty() cty.Value {
+	switch v.k {
+	case kNull:
+		return cty.NullVal(cty.DynamicPseudoType)
+	case kBool:
+		return cty.BoolVal(v.b)
+	case kNum:
+		return cty.MustParseNumberVal(v.num)
+	case kStr:
+		return cty.StringVal(v.s)
+	case kTuple:
+		if v.list {
+			if len(v.elems) == 0 {
+				return cty.ListValEmpty(ctyType(v.et))
+			}
+			vals := make([]cty.Value, len(v.elems))
+			for i, e := range v.elems {
+				vals[i] = e.cty()
+			}
+			return cty.ListVal(vals)
+		}
+		if len(v.elems) == 0 {
+			return cty.EmptyTupleVal
+		}
+		vals := make([]cty.Value, len(v.elems))
+		for i, e := range v.elems {
+			vals[i] = e.cty()
+		}
+		return cty.TupleVal(vals)
+	case kObj:
+		if len(v.elems) == 0 {
+			return cty.EmptyObjectVal
+		}
+		m := map[string]cty.Value{}
+		for i, k := range v.keys {
+			m[k] = v.elems[i].cty()
+		}
+		return cty.ObjectVal(m)
+	}
+	panic("bad kind")
+}
+
+// bigNum parses a number literal the way cty does (512-bit binary float).
+func bigNum(text string) *big.Float {
+	f, _, err := big.ParseFloat(text, 10, 512, big.ToNearestEven)
+	if err != nil {
+		panic("bad number literal " + text)
+	}
+	return f
+}
+
+// numText is the decimal text of a number in the form used when a number is
+// converted to a string (no exponent, no trailing zeros).
+func numText(f *big.Float) string { return f.Text('f', -1) }
+
+// canonNum normalises a number literal to the text its value converts to.
+func canonNum(text string) string { return numText(bigNum(text)) }
+
+// sameValue reports whether two cty values are the same value of the same
+// type (null values compare by type only).
+func sameValue(a, b cty.Value) bool {
+	if !a.Type().Equals(b.Type()) {
+		return false
+	}
+	if a.IsNull() || b.IsNull() {
+		return a.IsNull() && b.IsNull()
+	}
+	if !a.IsWhollyKnown() || !b.IsWhollyKnown() {
+		return false
+	}
+	return a.Equals(b).True()
+}
+
+// ---------------------------------------------------------------------------
+// Spelling values in the two syntaxes.
+
+var keywords = map[string]bool{"for": true, "in": true, "if": true, "else": true, "endif": true, "endfor": true, "true": true, "false": true, "null": true}
+
+// isIdent reports whether s is a native-syntax identifier (spec: ID_Start
+// then ID_Continue or '-').
+func isIdent(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i, r := range s {
+		if i == 0 {
+			if !(unicode.IsLetter(r) || r == '_') {
+				return false
+			}
+			continue
+		}
+		if !(unicode.IsLetter(r) || unicode.IsDigit(r) || r == '_' || r == '-' || unicode.Is(unicode.Mn, r) || unicode.Is(unicode.Mc, r) || unicode.Is(unicode.Pc, r)) {
+			return false
+		}
+	}
+	return true
+}
+
+// quoteNative spells a string as a native quoted template that is a plain
+// literal: escapes for the characters the spec lists, template introducers
+// doubled, control characters and (when asked) a few other characters as
+// \uNNNN / \UNNNNNNNN escapes.
+func quoteNative(s string, escapeAll bool) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := 0; i < len(s); {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		switch {
+		case r == '\n':
+			b.WriteString(`\n`)
+		case r == '\r':
+			b.WriteString(`\r`)
+		case r == '\t':
+			b.WriteString(`\t`)
+		case r == '"':
+			b.WriteString(`\"`)
+		case r == '\\':
+			b.WriteString(`\\`)
+		case r == '$' && strings.HasPrefix(s[i:], "${"):
+			b.WriteString("$${")
+			i += 2
+			continue
+		case r == '%' && strings.HasPrefix(s[i:], "%{"):
+			b.WriteString("%%{")
+			i += 2
+			continue
+		case r < 0x20 || r == 0x7f || (escapeAll && r != ' '):
+			if r > 0xffff {
+				fmt.Fprintf(&b, `\U%08X`, r)
+			} else {
+				fmt.Fprintf(&b, `\u%04x`, r)
+			}
+		default:
+			b.WriteRune(r)
+		}
+		i += size
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// quoteJSON spells a string as a JSON string whose value, read as a template
+// (the JSON syntax evaluates strings as templates), is the string itself.
+func quoteJSON(s string, escapeAll bool) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := 0; i < len(s); {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		switch {
+		case r == '\n':
+			b.WriteString(`\n`)
+		case r == '\r':
+			b.WriteString(`\r`)
+		case r == '\t':
+			b.WriteString(`\t`)
+		case r == '"':
+			b.WriteString(`\"`)
+		case r == '\\':
+			b.WriteString(`\\`)
+		case r == '$' && strings.HasPrefix(s[i:], "${"):
+			b.WriteString("$$")
+		case r == '%' && strings.HasPrefix(s[i:], "%{"):
+			b.WriteString("%%")
+		case r < 0x20 || r == 0x7f || (escapeAll && r != ' ' && r < 0x10000):
+			fmt.Fprintf(&b, `\u%04x`, r)
+		default:
+			b.WriteRune(r)
+		}
+		i += size
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// nativeKey spells an object attribute name: an identifier when it is one
+// (and not a keyword), a quoted string otherwise.
+func nativeKey(k string) string {
+	if isIdent(k) && !keywords[k] {
+		return k
+	}
+	return quoteNative(k, false)
+}
+
+// native spells a value as a native-syntax expression on one line.
+func (v V) native() string {
+	switch v.k {
+	case kNull:
+		return "null"
+	case kBool:
+		return strconv.FormatBool(v.b)
+	case kNum:
+		return v.num
+	case kStr:
+		return quoteNative(v.s, false)
+	case kTuple:
+		if v.list {
+			panic("a list value has no literal spelling")
+		}
+		parts := make([]string, len(v.elems))
+		for i, e := range v.elems {
+			parts[i] = e.native()
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case kObj:
+		parts := make([]string, len(v.elems))
+		for i, e := range v.elems {
+			parts[i] = nativeKey(v.keys[i]) + " = " + e.native()
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	}
+	panic("bad kind")
+}
+
+// json spells a value as JSON that the JSON syntax reads as the same value
+// (strings escaped for template mode).
+func (v V) json() string {
+	switch v.k {
+	case kNull:
+		return "null"
+	case kBool:
+		return strconv.FormatBool(v.b)
+	case kNum:
+		return v.num
+	case kStr:
+		return quoteJSON(v.s, false)
+	case kTuple:
+		parts := make([]string, len(v.elems))
+		for i, e := range v.elems {
+			parts[i] = e.json()
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case kObj:
+		parts := make([]string, len(v.elems))
+		for i, e := range v.elems {
+			parts[i] = quoteJSON(v.keys[i], false) + ":" + e.json()
+		}
+		return "{" + strings.Join(parts, ",") + "}"
+	}
+	panic("bad kind")
+}
+
+// ---------------------------------------------------------------------------
+// Generators for values.
+
+var identPool = []string{"a", "b", "foo", "bar_baz", "x1", "with-dash", "_u", "Zed", "λ", "id", "name", "count", "tags"}
+
+func genIdent(tc hegel.TestCase) string {
+	if chance(tc, 85) {
+		return pick(tc, identPool...)
+	}
+	// A fresh identifier: ID_Start then ID_Continue | '-'.
+	first := pick(tc, "a", "B", "_", "q", "ü", "名")
+	rest := ""
+	for k := n(tc, 0, 4); k > 0; k-- {
+		rest += pick(tc, "a", "9", "_", "-", "Z", "é", "0")
+	}
+	return first + rest
+}
+
+var stringPieces = []string{"a", "b", "hello", " ", "  ", "world", "0", "12", "\"", "\\", "$", "${", "%{", "$${", "%%{", "{", "}", "~", "#", "//", "/*", "*/", "\n", "\t", "\r", "é", "日本", "😀", "e\u0301", "\u200b", "<<EOT", "EOT", "'", "`", "\x7f", "\u0001", "-", "=", ":", ",", ".", "[", "]", "(", ")", "*", "?", "!", "true", "null", "1e3"}
+
+func genString(tc hegel.TestCase) string {
+	var b strings.Builder
+	for k := n(tc, 0, 4); k > 0; k-- {
+		b.WriteString(pick(tc, stringPieces...))
+	}
+	// Strings are compared under NFC (spec.md, Primitive Types) and cty
+	// normalises every string it holds, so the model keeps its strings in
+	// NFC too.
+	return nfc(b.String())
+}
+
+// nfc normalises a string the way cty does when it stores one.
+func nfc(s string) string { return cty.StringVal(s).AsString() }
+
+// genNumText draws a number literal valid in both syntaxes.
+func genNumText(tc hegel.TestCase) string {
+	switch n(tc, 1, 10) {
+	case 1:
+		return "0"
+	case 2, 3, 4:
+		return strconv.Itoa(n(tc, 0, 1000))
+	case 5:
+		return strconv.Itoa(n(tc, 0, 99)) + "." + strconv.Itoa(n(tc, 0, 999))
+	case 6:
+		return pick(tc, "123456789012345678901234567890", "1e3", "2.5E-2", "1E+2", "0.000001", "9007199254740993", "1e-400", "1e400", "100000000000000000000000000000000000000")
+	case 7:
+		return strconv.Itoa(n(tc, 1, 9)) + "e" + strconv.Itoa(n(tc, 0, 30))
+	default:
+		return strconv.Itoa(n(tc, 0, 20))
+	}
+}
+
+// genValue draws a value; depth bounds the nesting.
+func genValue(tc hegel.TestCase, depth int) V {
+	top := 8
+	if depth <= 0 {
+		top = 4
+	}
+	switch n(tc, 1, top) {
+	case 1:
+		return boolV(chance(tc, 50))
+	case 2:
+		return numV(genNumText(tc))
+	case 3:
+		return strV(genString(tc))
+	case 4:
+		if chance(tc, 30) {
+			return nullV()
+		}
+		return intV(int64(n(tc, -20, 20)))
+	case 5, 6:
+		var elems []V
+		for k := n(tc, 0, 3); k > 0; k-- {
+			elems = append(elems, genValue(tc, depth-1))
+		}
+		return tupleV(elems...)
+	default:
+		var keys []string
+		var elems []V
+		seen := map[string]bool{}
+		for k := n(tc, 0, 3); k > 0; k-- {
+			var key string
+			if chance(tc, 75) {
+				key = genIdent(tc)
+			} else {
+				key = genString(tc)
+			}
+			if seen[key] {
+				continue
+			}
+			seen[key] = true
+			keys = append(keys, key)
+			elems = append(elems, genValue(tc, depth-1))
+		}
+		if keys == nil {
+			keys, elems = []string{}, []V{}
+		}
+		return objV(keys, elems)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Diagnostics and parsing helpers.
+
+func diagText(diags hcl.Diagnostics) string {
+	var parts []string
+	for _, d := range diags {
+		parts = append(parts, d.Error())
+	}
+	return strings.Join(parts, "\n  ")
+}
+
+func parseExpr(ht *hegel.T, src string) hclsyntax.Expression {
+	e, diags := hclsyntax.ParseExpression([]byte(src), "gen.hcl", hcl.InitialPos)
+	if diags.HasErrors() {
+		fail(ht, "hclsyntax.ParseExpression rejects a generated expression:\n%s\n  %s", src, diagText(diags))
+	}
+	return e
+}
+
+func parseConfig(ht *hegel.T, src string, what string) *hcl.File {
+	f, diags := hclsyntax.ParseConfig([]byte(src), "gen.hcl", hcl.InitialPos)
+	if diags.HasErrors() {
+		fail(ht, "hclsyntax.ParseConfig rejects %s:\n%s\n  %s", what, src, diagText(diags))
+	}
+	return f
+}
