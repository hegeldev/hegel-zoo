+// checkContentOf is checkContent on an already extracted BodyContent.
+func checkContentOf(content *hcl.BodyContent, b *body, ctx *hcl.EvalContext, sc *scope, path string) string {
+	if len(content.Attributes) != len(b.attrs) {
+		return fmt.Sprintf("%s: %d attributes, expected %d", path, len(content.Attributes), len(b.attrs))
+	}
+	for _, a := range b.attrs {
+		got, ok := content.Attributes[a.name]
+		if !ok {
+			return fmt.Sprintf("%s: attribute %q missing", path, a.name)
+		}
+		want, err := tryEval(a.e, sc)
+		if err != nil {
+			return "GENERATOR: " + err.Error()
+		}
+		val, diags := got.Expr.Value(ctx)
+		if diags.HasErrors() || !sameValue(val, want.cty()) {
+			return fmt.Sprintf("%s: attribute %q = %#v, expected %#v (%s)", path, a.name, val, want.cty(), diagText(diags))
+		}
+	}
+	if len(content.Blocks) != len(b.blocks) {
+		return fmt.Sprintf("%s: %d blocks, expected %d", path, len(content.Blocks), len(b.blocks))
+	}
+	used := make([]bool, len(content.Blocks))
+	for i, blk := range b.blocks {
+		found := -1
+		for j, got := range content.Blocks {
+			if used[j] || got.Type != blk.typ || len(got.Labels) != len(blk.labels) {
+				continue
+			}
+			same := true
+			for k := range blk.labels {
+				if nfc(got.Labels[k]) != nfc(blk.labels[k]) {
+					same = false
+				}
+			}
+			if same {
+				found = j
+				break
+			}
+		}
+		if found < 0 {
+			return fmt.Sprintf("%s: block %d (%s %q) not found among %s", path, i, blk.typ, blk.labels, describeBlocks(content.Blocks))
+		}
+		used[found] = true
+		if msg := checkContent(content.Blocks[found].Body, blk.body, ctx, sc, fmt.Sprintf("%s/%s%q", path, blk.typ, blk.labels)); msg != "" {
+			return msg
+		}
+	}
+	return ""
+}
