@@ -0,0 +1,1722 @@
+package hcl_test
+
+// Configuration files: a body model with attributes, blocks, heredocs and
+// comments, drawn as a tree of records, spelled in the native syntax (its
+// whitespace read from a drawn tape) and in the JSON syntax, built with
+// hclwrite from drawn build specs, formatted with hclwrite.Format, edited and
+// mutated by drawn lists of operations, and read back with hclsyntax and json
+// through hcl.Body.Content.
+
+import (
+	"bytes"
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/hashicorp/hcl/v2/hclwrite"
+	"github.com/hashicorp/hcl/v2/json"
+	"github.com/zclconf/go-cty/cty"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// The body model.
+
+type attr struct {
+	name    string
+	e       *E      // the expression (a "tmpl" holding the value's template for heredocs)
+	heredoc *hdoc   // non-nil for a heredoc attribute
+	spell   []tpart // heredocs: the template as written (indented for <<-)
+	comment string  // trailing line comment, "" for none
+}
+
+type hdoc struct {
+	marker string
+	indent int // > 0 for a <<- heredoc with this many leading spaces
+}
+
+type block struct {
+	typ     string
+	labels  []string
+	quoted  []bool // spelled as a quoted string (true) or an identifier
+	body    *body
+	oneLine bool // spelled as a one-line block (at most one attribute)
+}
+
+type body struct {
+	attrs  []*attr
+	blocks []*block
+	order  []int // indices into attrs (>= 0) and blocks (< 0: -1-i), in source order
+}
+
+func (b *body) items() []any {
+	var out []any
+	for _, o := range b.order {
+		if o >= 0 {
+			out = append(out, b.attrs[o])
+		} else {
+			out = append(out, b.blocks[-1-o])
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Heredocs.
+
+// heredocLine: one line of a heredoc: its parts (literals and
+// interpolations), and for an indented heredoc the whitespace it is indented
+// by beyond the common indentation.
+type heredocLine struct {
+	extra string
+	parts []tpart
+}
+
+// heredocSpec: a heredoc attribute's value: the marker, the indentation (0
+// for `<<`, else a `<<-` heredoc whose lines are indented that much) and one
+// to three lines.
+type heredocSpec struct {
+	marker string
+	indent int
+	lines  []heredocLine
+}
+
+var (
+	heredocMarkers = hegel.SampledFrom([]string{"END", "HEREDOC", "eot", "_x"})
+	heredocLitPool = hegel.SampledFrom([]string{"hello", "  ", "a b", "${", "%{", "\"quoted\"", "\\n", "\u00e9", "}", "$", "%", "\t"})
+	// heredocIndents: a plain heredoc six times in ten, else indented one to
+	// four spaces.
+	heredocIndents = weighted(choice[int]{60, hegel.Just(0)}, choice[int]{40, hegel.Integers(1, 4)})
+	// lineExtras: extra indentation of a line, none seven times in ten.
+	lineExtras    = maybe(30, hegel.SampledFrom([]string{" ", "  ", "\t"}))
+	templateTypes = hegel.SampledFrom([]T{tStr, tNum, tBool})
+)
+
+// bodyGrammar: the body generators over one case's expression grammar,
+// memoised per depth.
+type bodyGrammar struct {
+	g    *grammar
+	memo map[[3]int]hegel.Generator[*body]
+}
+
+func newBodyGrammar(sc *scope) *bodyGrammar {
+	return &bodyGrammar{g: newGrammar(sc, 60), memo: map[[3]int]hegel.Generator[*body]{}}
+}
+
+// heredocSpecs: a heredoc of one to three lines of up to two parts each, a
+// literal of the pool six times in ten, else an interpolation of a string,
+// number or boolean.
+func (bg *bodyGrammar) heredocSpecs(depth int) hegel.Generator[heredocSpec] {
+	lits := hegel.Map(heredocLitPool, func(s string) tpart { return tpart{kind: "lit", text: s} })
+	interps := hegel.Composite(func(tc hegel.TestCase) tpart {
+		t := hegel.Draw(tc, templateTypes)
+		return tpart{kind: "interp", e: hegel.Draw(tc, bg.g.expr(&t, depth-1))}
+	})
+	parts := weighted(choice[tpart]{60, lits}, choice[tpart]{40, interps})
+	lines := hegel.Map(pairs(lineExtras, many(parts, 0, 2)), func(p pair[string, []tpart]) heredocLine { return heredocLine{p.a, p.b} })
+	return hegel.Composite(func(tc hegel.TestCase) heredocSpec {
+		return heredocSpec{marker: hegel.Draw(tc, heredocMarkers), indent: hegel.Draw(tc, heredocIndents), lines: hegel.Draw(tc, many(lines, 1, 3))}
+	})
+}
+
+// heredocAttr is the heredoc attribute of a spec: the template as written
+// (every line of a `<<-` heredoc indented by the common indentation and its
+// own extra) and, as the value, the template dedented by the specification's
+// rule. Under HEGEL_NO_KNOWN=1 no line of an indented heredoc is whitespace
+// only (hcl/1).
+func heredocAttr(spec heredocSpec) *attr {
+	pad := strings.Repeat(" ", spec.indent)
+	var parts []tpart
+	for _, line := range spec.lines {
+		if spec.indent > 0 {
+			parts = append(parts, tpart{kind: "lit", text: pad + line.extra})
+		}
+		parts = append(parts, line.parts...)
+		parts = append(parts, tpart{kind: "lit", text: "\n"})
+	}
+	if spec.indent > 0 && Known.flushBlankLines {
+		parts = noBlankLines(parts)
+	}
+	parts = meldLits(parts)
+	a := &attr{heredoc: &hdoc{marker: spec.marker, indent: spec.indent}, spell: parts, e: &E{op: "tmpl", parts: parts}}
+	if spec.indent > 0 {
+		a.e = &E{op: "tmpl", parts: specDedent(copyParts(parts))}
+	}
+	return a
+}
+
+// lineStarts lists the index of each part that begins a line (the first
+// part, and every part after a literal ending in a newline).
+func lineStarts(parts []tpart) []int {
+	var out []int
+	newline := true
+	for i, p := range parts {
+		if newline {
+			out = append(out, i)
+		}
+		newline = p.kind == "lit" && strings.HasSuffix(p.text, "\n")
+	}
+	return out
+}
+
+// noBlankLines makes sure no line of the template is whitespace only (hcl/1
+// treats such lines specially).
+func noBlankLines(parts []tpart) []tpart {
+	starts := lineStarts(parts)
+	for _, s := range starts {
+		// Find the extent of the line.
+		blank := true
+		end := s
+		for end < len(parts) {
+			p := parts[end]
+			if p.kind != "lit" || strings.TrimSpace(strings.TrimSuffix(p.text, "\n")) != "" {
+				blank = false
+			}
+			if p.kind == "lit" && strings.HasSuffix(p.text, "\n") {
+				break
+			}
+			end++
+		}
+		if blank && end < len(parts) {
+			parts[end].text = "x" + parts[end].text
+			if len(parts[end].text) > 1 && strings.TrimSpace(strings.TrimSuffix(parts[end].text, "\n")) == "x" {
+				// The line was pad + "\n": put the x after the pad.
+				t := strings.TrimSuffix(parts[end].text[1:], "\n")
+				parts[end].text = t + "x\n"
+			}
+		}
+	}
+	return parts
+}
+
+// hasBlankLine reports whether a line of the template is whitespace only
+// (with an indented heredoc, the shape of hcl/1).
+func hasBlankLine(parts []tpart) bool {
+	blank := true
+	for _, p := range parts {
+		if p.kind != "lit" {
+			blank = false
+			continue
+		}
+		text := p.text
+		for {
+			i := strings.IndexByte(text, '\n')
+			if i < 0 {
+				if strings.TrimSpace(text) != "" {
+					blank = false
+				}
+				break
+			}
+			if blank && strings.TrimSpace(text[:i]) == "" {
+				return true
+			}
+			blank = true
+			text = text[i+1:]
+		}
+	}
+	return false
+}
+
+// attrShapes names the recorded bug whose shape an attribute has: an
+// indented heredoc with a whitespace-only line (hcl/1).
+func attrShapes(a *attr) []string {
+	return shapeIf(a.heredoc != nil && a.heredoc.indent > 0 && hasBlankLine(a.spell), "hcl/1")
+}
+
+func copyParts(parts []tpart) []tpart {
+	out := make([]tpart, len(parts))
+	copy(out, parts)
+	return out
+}
+
+// specDedent applies the <<- rule of the specification: the minimum number of
+// leading spaces over the line-leading literals (a line starting with an
+// interpolation has none) is removed from every line-leading literal.
+func specDedent(parts []tpart) []tpart {
+	// Split literals at newlines so that every line-leading literal is a part
+	// of its own, then meld the pieces within a line (the scanner yields one
+	// token per run of literal text).
+	var split []tpart
+	for _, p := range parts {
+		if p.kind != "lit" {
+			split = append(split, p)
+			continue
+		}
+		text := p.text
+		for text != "" {
+			i := strings.IndexByte(text, '\n')
+			if i < 0 {
+				split = append(split, tpart{kind: "lit", text: text})
+				break
+			}
+			split = append(split, tpart{kind: "lit", text: text[:i+1]})
+			text = text[i+1:]
+		}
+	}
+	var melded []tpart
+	for _, p := range split {
+		if len(melded) > 0 && p.kind == "lit" && melded[len(melded)-1].kind == "lit" && !strings.HasSuffix(melded[len(melded)-1].text, "\n") {
+			melded[len(melded)-1].text += p.text
+			continue
+		}
+		melded = append(melded, p)
+	}
+	parts = melded
+	starts := lineStarts(parts)
+	min := -1
+	for _, s := range starts {
+		spaces := 0
+		if parts[s].kind == "lit" {
+			// The newline that ends a whitespace-only line is not part of
+			// its indentation.
+			text := strings.TrimSuffix(parts[s].text, "\n")
+			spaces = len([]rune(text)) - len([]rune(strings.TrimLeftFunc(text, unicode.IsSpace)))
+		}
+		if min < 0 || spaces < min {
+			min = spaces
+		}
+	}
+	if min <= 0 {
+		return parts
+	}
+	for _, s := range starts {
+		if parts[s].kind == "lit" {
+			r := []rune(parts[s].text)
+			parts[s].text = string(r[min:])
+		}
+	}
+	return parts
+}
+
+// ---------------------------------------------------------------------------
+// Attributes, blocks and bodies.
+
+// attrComments: a trailing comment on a plain attribute, none four times in
+// five.
+var attrComments = maybe(20, hegel.SampledFrom([]string{"# note", "// note", "#", "//", "# ${not} %{a} \"q\"", "# \u65e5\u672c"}))
+
+// attrs: an attribute with a drawn name: an expression with maybe a trailing
+// comment (a comment may not follow a heredoc's closing marker), or one time
+// in seven a heredoc.
+func (bg *bodyGrammar) attrs(depth int) hegel.Generator[*attr] {
+	plain := hegel.Composite(func(tc hegel.TestCase) *attr {
+		return &attr{e: hegel.Draw(tc, bg.g.expr(nil, depth)), comment: hegel.Draw(tc, attrComments)}
+	})
+	heredocs := hegel.Map(bg.heredocSpecs(depth), heredocAttr)
+	return hegel.Map(pairs(idents, weighted(choice[*attr]{85, plain}, choice[*attr]{15, heredocs})), func(p pair[string, *attr]) *attr {
+		p.b.name = p.a
+		return p.b
+	})
+}
+
+var (
+	blockTypePool = hegel.SampledFrom([]string{"resource", "variable", "locals", "module", "provider", "a", "block-1", "\u03bb"})
+	blockTypes    = weighted(choice[string]{80, blockTypePool}, choice[string]{20, idents})
+	labelPool     = hegel.SampledFrom([]string{"aws_instance", "web", "main", "", "with space", "a\"b", "${x}", "%{y}", "\u00e9"})
+)
+
+// label: a block label, spelled as an identifier or a quoted string.
+type label struct {
+	text   string
+	quoted bool
+}
+
+// labels: an identifier three times in ten, else a quoted label from the pool
+// or (three times in ten) any string.
+var labels = hegel.Map(weighted(
+	choice[label]{30, hegel.Map(idents, func(s string) label { return label{s, false} })},
+	choice[label]{49, hegel.Map(labelPool, func(s string) label { return label{s, true} })},
+	choice[label]{21, hegel.Map(strs, func(s string) label { return label{s, true} })},
+), pastEscapedLabel)
+
+// pastEscapedLabel: under HEGEL_NO_KNOWN=1 a quoted label loses the `$` and
+// `%` it has beside other characters (hcl/2).
+func pastEscapedLabel(l label) label {
+	if Known.writerEscapedLabel && l.quoted && len(l.text) > 1 && strings.ContainsAny(l.text, "$%") {
+		l.text = strings.NewReplacer("$", "", "%", "").Replace(l.text)
+	}
+	return l
+}
+
+// twinSpec: a second block of the same type beside the first, its last label
+// replaced half of the time.
+type twinSpec struct {
+	relabel bool
+	label   label
+	body    *body
+}
+
+// item: one item of a body: an attribute, or a block with maybe a twin.
+type item struct {
+	attr *attr
+	blk  *block
+	twin *block
+}
+
+// blocks: a block of a drawn type with up to two labels and a body one level
+// shallower, spelled on one line four times in ten when it may be (at most
+// one attribute, no blocks), with a twin one time in four.
+func (bg *bodyGrammar) blocks(depth, bodyDepth int) hegel.Generator[item] {
+	inner := bg.bodies(depth, bodyDepth-1, 0)
+	labelLists := many(labels, 0, 2)
+	oneLines := chance(40)
+	twins := optional(25, hegel.Composite(func(tc hegel.TestCase) twinSpec {
+		return twinSpec{relabel: hegel.Draw(tc, chance(50)), label: hegel.Draw(tc, labels), body: hegel.Draw(tc, inner)}
+	}))
+	return hegel.Composite(func(tc hegel.TestCase) item {
+		blk := &block{typ: hegel.Draw(tc, blockTypes)}
+		for _, l := range hegel.Draw(tc, labelLists) {
+			blk.labels = append(blk.labels, l.text)
+			blk.quoted = append(blk.quoted, l.quoted)
+		}
+		blk.body = hegel.Draw(tc, inner)
+		blk.oneLine = hegel.Draw(tc, oneLines) && len(blk.body.attrs) <= 1 && len(blk.body.blocks) == 0
+		it := item{blk: blk}
+		if tw := hegel.Draw(tc, twins); tw != nil {
+			twin := &block{typ: blk.typ, labels: append([]string{}, blk.labels...), quoted: append([]bool{}, blk.quoted...), body: tw.body}
+			if tw.relabel && len(twin.labels) > 0 {
+				twin.labels[len(twin.labels)-1] = tw.label.text
+				twin.quoted[len(twin.quoted)-1] = tw.label.quoted
+			}
+			it.twin = twin
+		}
+		return it
+	})
+}
+
+// bodies: a body of minItems to four items, attributes seven times in ten
+// and blocks (down to bodyDepth levels of nesting) three times in ten,
+// assembled with one attribute or block type per name.
+func (bg *bodyGrammar) bodies(depth, bodyDepth, minItems int) hegel.Generator[*body] {
+	key := [3]int{depth, bodyDepth, minItems}
+	if gen, ok := bg.memo[key]; ok {
+		return gen
+	}
+	attrItems := hegel.Map(bg.attrs(depth), func(a *attr) item { return item{attr: a} })
+	items := attrItems
+	if bodyDepth > 0 {
+		items = weighted(choice[item]{70, attrItems}, choice[item]{30, bg.blocks(depth, bodyDepth)})
+	}
+	gen := hegel.Map(many(items, minItems, 4), assemble)
+	bg.memo[key] = gen
+	return gen
+}
+
+// assemble is the body of the items, the first item of a name winning
+// (attributes and block types share one namespace, and no attribute is named
+// by a keyword).
+func assemble(items []item) *body {
+	b := &body{}
+	names := map[string]bool{}
+	for _, it := range items {
+		if it.attr != nil {
+			if names[it.attr.name] || keywords[it.attr.name] {
+				continue
+			}
+			names[it.attr.name] = true
+			b.attrs = append(b.attrs, it.attr)
+			b.order = append(b.order, len(b.attrs)-1)
+			continue
+		}
+		if names[it.blk.typ] {
+			continue
+		}
+		names[it.blk.typ] = true
+		b.blocks = append(b.blocks, it.blk)
+		b.order = append(b.order, -len(b.blocks))
+		if it.twin != nil {
+			b.blocks = append(b.blocks, it.twin)
+			b.order = append(b.order, -len(b.blocks))
+		}
+	}
+	return b
+}
+
+// ---------------------------------------------------------------------------
+// The configuration case.
+
+// config: a scope, a body over it and the tape its native spelling reads its
+// whitespace from.
+type config struct {
+	sc   *scope
+	body *body
+	tape []int
+}
+
+// GoString is what the draw report prints.
+func (c config) GoString() string {
+	return fmt.Sprintf("native:\n%s\nvariables:\n%s", spell(c.body, c.tape).src, c.sc.describe())
+}
+
+// configsOf: a scope, a body of at least minItems items whose expressions
+// nest one to three levels (blocks two), and a whitespace tape.
+func configsOf(minItems int) hegel.Generator[config] {
+	return hegel.FlatMap(envs, func(sc *scope) hegel.Generator[config] {
+		bg := newBodyGrammar(sc)
+		return hegel.FlatMap(hegel.Integers(1, 3), func(depth int) hegel.Generator[config] {
+			return hegel.Map(pairs(bg.bodies(depth, 2, minItems), tapes), func(p pair[*body, []int]) config {
+				return config{sc, p.a, p.b}
+			})
+		})
+	})
+}
+
+var (
+	configs          = configsOf(0)
+	configsWithItems = configsOf(1)
+)
+
+// ---------------------------------------------------------------------------
+// Spelling a body in the native syntax.
+
+// nativeWriter spells a body, reading the whitespace, comments and filler
+// lines it is free to choose from a tape.
+type nativeWriter struct {
+	t           *tape
+	b           strings.Builder
+	indent      int
+	typeComment bool // a comment was written between a block's type and its first label (hcl/3)
+}
+
+var (
+	wsPool     = []string{"", "  ", "\t", " /* c */ "}
+	leadPool   = []string{"", " ", "\t", "    "}
+	fillerPool = []string{"\n", "# comment line\n", "// other\n", "/* block\n comment */\n", "\n\n"}
+)
+
+// ws: the space between tokens: a single space, four times in ten something
+// else.
+func (w *nativeWriter) ws() string {
+	if w.t.coin(40) {
+		return wsPool[w.t.next(len(wsPool))]
+	}
+	return " "
+}
+
+// lead: a line's indentation: two spaces per level, three times in ten
+// something else.
+func (w *nativeWriter) lead() string {
+	if w.t.coin(30) {
+		return leadPool[w.t.next(len(leadPool))]
+	}
+	return strings.Repeat("  ", w.indent)
+}
+
+func (w *nativeWriter) writeBody(b *body) {
+	for _, it := range b.items() {
+		if w.t.coin(15) {
+			w.b.WriteString(fillerPool[w.t.next(len(fillerPool))])
+		}
+		switch x := it.(type) {
+		case *attr:
+			w.writeAttr(x)
+		case *block:
+			w.writeBlock(x)
+		}
+	}
+}
+
+func (w *nativeWriter) writeAttr(a *attr) {
+	w.b.WriteString(w.lead() + a.name + w.ws() + "=" + w.ws())
+	if a.heredoc != nil {
+		h := a.heredoc
+		if h.indent > 0 {
+			w.b.WriteString("<<-" + h.marker + "\n")
+			w.b.WriteString(renderTemplate(a.spell, true))
+			closers := []string{"", strings.Repeat(" ", h.indent), "  "}
+			w.b.WriteString(closers[w.t.next(len(closers))] + h.marker)
+		} else {
+			w.b.WriteString("<<" + h.marker + "\n")
+			w.b.WriteString(renderTemplate(a.spell, true))
+			w.b.WriteString(h.marker)
+		}
+	} else {
+		w.b.WriteString(render(a.e, 0))
+	}
+	if a.comment != "" {
+		w.b.WriteString(w.ws() + a.comment)
+	}
+	w.b.WriteString("\n")
+}
+
+func (w *nativeWriter) writeBlock(blk *block) {
+	w.b.WriteString(w.lead() + blk.typ)
+	for i, l := range blk.labels {
+		sep := w.ws()
+		if i == 0 && strings.Contains(sep, "/*") {
+			// A comment between the type and the first label is the shape of
+			// hcl/3; HEGEL_NO_KNOWN=1 spells a space instead.
+			sep = shaped(sep, " ")
+			w.typeComment = sep != " "
+		}
+		if !blk.quoted[i] && sep == "" {
+			sep = " " // two identifiers need a separator
+		}
+		if blk.quoted[i] {
+			w.b.WriteString(sep + quoteNative(l, false))
+		} else {
+			w.b.WriteString(sep + l)
+		}
+	}
+	if blk.oneLine {
+		w.b.WriteString(w.ws() + "{")
+		if len(blk.body.attrs) == 1 && blk.body.attrs[0].heredoc == nil {
+			a := blk.body.attrs[0]
+			w.b.WriteString(w.ws() + a.name + w.ws() + "=" + w.ws() + render(a.e, 0) + w.ws())
+		} else if len(blk.body.attrs) == 1 {
+			// A heredoc cannot sit in a one-line block: spell it multi-line.
+			w.b.WriteString("\n")
+			w.indent++
+			w.writeBody(blk.body)
+			w.indent--
+			w.b.WriteString(w.lead())
+		}
+		w.b.WriteString("}\n")
+		return
+	}
+	w.b.WriteString(w.ws() + "{\n")
+	w.indent++
+	w.writeBody(blk.body)
+	w.indent--
+	w.b.WriteString(w.lead() + "}\n")
+}
+
+// rendered: a body's native spelling, and whether it has a comment between a
+// block's type and its first label (hcl/3).
+type rendered struct {
+	src         string
+	typeComment bool
+}
+
+// spell is the native spelling of b with the whitespace the tape dictates (an
+// empty tape spells the tidy form).
+func spell(b *body, vals []int) rendered {
+	w := &nativeWriter{t: &tape{vals: vals}}
+	w.writeBody(b)
+	return rendered{w.b.String(), w.typeComment}
+}
+
+// ---------------------------------------------------------------------------
+// Spelling a body in the JSON syntax.
+
+func exprJSON(a *attr) string {
+	if a.heredoc != nil {
+		// The heredoc's (dedented) template as a standalone template string.
+		return quoteJSONRaw(renderTemplate(a.e.parts, true))
+	}
+	if a.e.op == "lit" && !hasNull(a.e.v) {
+		return a.e.v.json()
+	}
+	return quoteJSONRaw("${" + render(a.e, 0) + "}")
+}
+
+// jsonQuirk reports whether the JSON spelling of the body puts a literal
+// string of the shape of hcl/6 in a template (a literal attribute value;
+// expressions spell their strings with escapes).
+func jsonQuirk(b *body) bool {
+	for _, a := range b.attrs {
+		if a.e.op == "lit" && hasCRQuirk(a.e.v) {
+			return true
+		}
+	}
+	for _, blk := range b.blocks {
+		if jsonQuirk(blk.body) {
+			return true
+		}
+	}
+	return false
+}
+
+func spellJSON(b *body) string {
+	var props []string
+	for _, a := range b.attrs {
+		props = append(props, quoteJSONRaw(a.name)+": "+exprJSON(a))
+	}
+	// Blocks: grouped by type, then nested by labels; repeated paths become
+	// arrays.
+	byType := map[string][]*block{}
+	var types []string
+	for _, blk := range b.blocks {
+		if _, ok := byType[blk.typ]; !ok {
+			types = append(types, blk.typ)
+		}
+		byType[blk.typ] = append(byType[blk.typ], blk)
+	}
+	for _, t := range types {
+		props = append(props, quoteJSONRaw(t)+": "+jsonBlockGroup(byType[t], 0))
+	}
+	return "{" + strings.Join(props, ", ") + "}"
+}
+
+// jsonBlockGroup spells blocks sharing a type and the first `level` labels.
+func jsonBlockGroup(blks []*block, level int) string {
+	if len(blks[0].labels) == level {
+		// Bodies.
+		if len(blks) == 1 {
+			return spellJSON(blks[0].body)
+		}
+		parts := make([]string, len(blks))
+		for i, blk := range blks {
+			parts[i] = spellJSON(blk.body)
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	}
+	byLabel := map[string][]*block{}
+	var labels []string
+	for _, blk := range blks {
+		l := blk.labels[level]
+		if _, ok := byLabel[l]; !ok {
+			labels = append(labels, l)
+		}
+		byLabel[l] = append(byLabel[l], blk)
+	}
+	parts := make([]string, len(labels))
+	for i, l := range labels {
+		parts[i] = quoteJSONRaw(l) + ": " + jsonBlockGroup(byLabel[l], level+1)
+	}
+	return "{" + strings.Join(parts, ", ") + "}"
+}
+
+// ---------------------------------------------------------------------------
+// Reading a body back through hcl.Body.Content.
+
+func schemaOf(b *body) *hcl.BodySchema {
+	s := &hcl.BodySchema{}
+	for _, a := range b.attrs {
+		s.Attributes = append(s.Attributes, hcl.AttributeSchema{Name: a.name})
+	}
+	seen := map[string]bool{}
+	for _, blk := range b.blocks {
+		if seen[blk.typ] {
+			continue
+		}
+		seen[blk.typ] = true
+		s.Blocks = append(s.Blocks, hcl.BlockHeaderSchema{Type: blk.typ, LabelNames: labelNames(len(blk.labels))})
+	}
+	return s
+}
+
+func labelNames(k int) []string {
+	out := make([]string, k)
+	for i := range out {
+		out[i] = fmt.Sprintf("label%d", i)
+	}
+	return out
+}
+
+// checkContent compares what a parsed body offers through Content with the
+// model, evaluating attributes in ctx; it returns a description of the first
+// difference (or "") and the recorded bug shapes of the item that differs.
+func checkContent(hb hcl.Body, b *body, ctx *hcl.EvalContext, sc *scope, path string) (string, []string) {
+	content, diags := hb.Content(schemaOf(b))
+	if diags.HasErrors() {
+		return fmt.Sprintf("%s: Content fails: %s", path, diagText(diags)), nil
+	}
+	return checkContentOf(content, b, ctx, sc, path)
+}
+
+// checkContentOf is checkContent on an already extracted BodyContent.
+func checkContentOf(content *hcl.BodyContent, b *body, ctx *hcl.EvalContext, sc *scope, path string) (string, []string) {
+	if len(content.Attributes) != len(b.attrs) {
+		return fmt.Sprintf("%s: %d attributes, expected %d", path, len(content.Attributes), len(b.attrs)), nil
+	}
+	for _, a := range b.attrs {
+		got, ok := content.Attributes[a.name]
+		if !ok {
+			return fmt.Sprintf("%s: attribute %q missing", path, a.name), nil
+		}
+		want, err := tryEval(a.e, sc)
+		if err != nil {
+			return fmt.Sprintf("GENERATOR: %s: model cannot evaluate %s: %v", path, a.name, err), nil
+		}
+		val, diags := got.Expr.Value(ctx)
+		if diags.HasErrors() {
+			return fmt.Sprintf("%s: attribute %q fails to evaluate: %s", path, a.name, diagText(diags)), attrShapes(a)
+		}
+		if !sameValue(val, want.cty()) {
+			return fmt.Sprintf("%s: attribute %q = %#v, expected %#v\nmodel: %s", path, a.name, val, want.cty(), a.e.dump()), attrShapes(a)
+		}
+	}
+	if len(content.Blocks) != len(b.blocks) {
+		return fmt.Sprintf("%s: %d blocks, expected %d", path, len(content.Blocks), len(b.blocks)), nil
+	}
+	// Blocks: per (type, labels) the order is preserved; across kinds the
+	// JSON syntax groups them, so match by key.
+	used := make([]bool, len(content.Blocks))
+	for i, blk := range b.blocks {
+		found := -1
+		for j, got := range content.Blocks {
+			if used[j] || got.Type != blk.typ || len(got.Labels) != len(blk.labels) {
+				continue
+			}
+			same := true
+			for k := range blk.labels {
+				if nfc(got.Labels[k]) != nfc(blk.labels[k]) {
+					same = false
+				}
+			}
+			if same {
+				found = j
+				break
+			}
+		}
+		if found < 0 {
+			return fmt.Sprintf("%s: block %d (%s %q) not found among %s", path, i, blk.typ, blk.labels, describeBlocks(content.Blocks)), nil
+		}
+		used[found] = true
+		if msg, shapes := checkContent(content.Blocks[found].Body, blk.body, ctx, sc, fmt.Sprintf("%s/%s%q", path, blk.typ, blk.labels)); msg != "" {
+			return msg, shapes
+		}
+	}
+	return "", nil
+}
+
+func describeBlocks(blks hcl.Blocks) string {
+	var parts []string
+	for _, b := range blks {
+		parts = append(parts, fmt.Sprintf("%s %q", b.Type, b.Labels))
+	}
+	return "[" + strings.Join(parts, ", ") + "]"
+}
+
+// ---------------------------------------------------------------------------
+// Tokens compared modulo whitespace.
+
+type tokShape struct {
+	typ   hclsyntax.TokenType
+	bytes string
+}
+
+func tokenShapes(src []byte) ([]tokShape, hcl.Diagnostics) {
+	toks, diags := hclsyntax.LexConfig(src, "gen.hcl", hcl.InitialPos)
+	var out []tokShape
+	for _, t := range toks {
+		if t.Type == hclsyntax.TokenNewline || t.Type == hclsyntax.TokenEOF {
+			continue
+		}
+		out = append(out, tokShape{t.Type, string(t.Bytes)})
+	}
+	return out, diags
+}
+
+func firstTokenDiff(a, b []tokShape) string {
+	for i := 0; i < len(a) && i < len(b); i++ {
+		if a[i] != b[i] {
+			return fmt.Sprintf("token %d: %s %q vs %s %q", i, a[i].typ, a[i].bytes, b[i].typ, b[i].bytes)
+		}
+	}
+	if len(a) != len(b) {
+		return fmt.Sprintf("%d tokens vs %d", len(a), len(b))
+	}
+	return ""
+}
+
+// ---------------------------------------------------------------------------
+// Properties on spelled files.
+
+// TestHegelNativeAndJSONBodiesAgree: the same body spelled in the native and
+// the JSON syntax offers the same attributes (values) and blocks through
+// hcl.Body.Content.
+func TestHegelNativeAndJSONBodiesAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, configs)
+		src := spell(c.body, c.tape).src
+		jsrc := spellJSON(c.body)
+		note(ht, "native:\n%s", src)
+		note(ht, "json:\n%s", jsrc)
+		ctx := evalContext(c.sc)
+		f := parseConfig(ht, src, "the generated file")
+		if msg, shapes := checkContent(f.Body, c.body, ctx, c.sc, "native"); msg != "" {
+			mismatch(ht, shapes, "%s\nsource:\n%s", msg, src)
+		}
+		jf, diags := json.Parse([]byte(jsrc), "gen.json")
+		if diags.HasErrors() {
+			fail(ht, "json.Parse rejects the generated file:\n%s\n  %s", jsrc, diagText(diags))
+		}
+		if msg, shapes := checkContent(jf.Body, c.body, ctx, c.sc, "json"); msg != "" {
+			mismatch(ht, append(shapes, shapeIf(jsonQuirk(c.body), "hcl/6")...), "%s\njson:\n%s\nnative:\n%s", msg, jsrc, src)
+		}
+	})
+}
+
+// TestHegelFormatChangesOnlyWhitespace: hclwrite.Format keeps every token,
+// keeps the meaning of every attribute, produces its own fixed point and
+// output that hclwrite reproduces verbatim.
+func TestHegelFormatChangesOnlyWhitespace(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, configs)
+		r := spell(c.body, c.tape)
+		src := []byte(r.src)
+		note(ht, "source:\n%s", src)
+		parseConfig(ht, string(src), "the generated file")
+		formatted := hclwrite.Format(src)
+		note(ht, "formatted:\n%s", formatted)
+		f2, diags := hclsyntax.ParseConfig(formatted, "fmt.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "Format output does not parse:\n%s\n  %s\nsource:\n%s", formatted, diagText(diags), src)
+		}
+		t1, _ := tokenShapes(src)
+		t2, _ := tokenShapes(formatted)
+		if d := firstTokenDiff(t1, t2); d != "" {
+			fail(ht, "Format changed more than whitespace: %s\nsource:\n%s\nformatted:\n%s", d, src, formatted)
+		}
+		ctx := evalContext(c.sc)
+		if msg, shapes := checkContent(f2.Body, c.body, ctx, c.sc, "formatted"); msg != "" {
+			mismatch(ht, shapes, "%s\nsource:\n%s\nformatted:\n%s", msg, src, formatted)
+		}
+		again := hclwrite.Format(formatted)
+		if !bytes.Equal(again, formatted) {
+			fail(ht, "Format is not idempotent:\nsource:\n%s\nfirst:\n%s\nsecond:\n%s", src, formatted, again)
+		}
+		wf, diags := hclwrite.ParseConfig(formatted, "fmt.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclwrite.ParseConfig rejects Format output:\n%s\n  %s", formatted, diagText(diags))
+		}
+		if !bytes.Equal(wf.Bytes(), formatted) {
+			mismatch(ht, shapeIf(r.typeComment, "hcl/3"), "hclwrite.ParseConfig(Format(src)).Bytes() differs from Format(src):\nformatted:\n%s\nbytes:\n%s", formatted, wf.Bytes())
+		}
+	})
+}
+
+// TestHegelWriterAgreesWithFormat: hclwrite.ParseConfig(src).Bytes() (the
+// AST path, which formats on output) is hclwrite.Format(src) (the token
+// path), and the AST's attributes and blocks are the model's.
+func TestHegelWriterAgreesWithFormat(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, configs)
+		r := spell(c.body, c.tape)
+		src := []byte(r.src)
+		note(ht, "source:\n%s", src)
+		parseConfig(ht, string(src), "the generated file")
+		wf, diags := hclwrite.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclwrite.ParseConfig rejects what hclsyntax accepts:\n%s\n  %s", src, diagText(diags))
+		}
+		if formatted := hclwrite.Format(src); !bytes.Equal(wf.Bytes(), formatted) {
+			mismatch(ht, shapeIf(r.typeComment, "hcl/3"), "hclwrite.ParseConfig(src).Bytes() differs from Format(src):\nsource:\n%s\nbytes:\n%s\nformat:\n%s", src, wf.Bytes(), formatted)
+		}
+		ctx := evalContext(c.sc)
+		if msg, shapes := checkWriterBody(wf.Body(), c.body, ctx, c.sc, "file"); msg != "" {
+			mismatch(ht, shapes, "%s\nsource:\n%s", msg, src)
+		}
+	})
+}
+
+// checkWriterBody compares an hclwrite.Body with the model: attribute names
+// and expression values (the expression tokens re-parsed), block types,
+// labels and bodies. It returns the first difference and the recorded bug
+// shapes of the item that differs.
+func checkWriterBody(wb *hclwrite.Body, b *body, ctx *hcl.EvalContext, sc *scope, path string) (string, []string) {
+	attrs := wb.Attributes()
+	if len(attrs) != len(b.attrs) {
+		return fmt.Sprintf("%s: hclwrite sees %d attributes, expected %d", path, len(attrs), len(b.attrs)), nil
+	}
+	for _, a := range b.attrs {
+		wa := wb.GetAttribute(a.name)
+		if wa == nil {
+			return fmt.Sprintf("%s: hclwrite has no attribute %q", path, a.name), nil
+		}
+		exprSrc := wa.Expr().BuildTokens(nil).Bytes()
+		want, err := tryEval(a.e, sc)
+		if err != nil {
+			return fmt.Sprintf("GENERATOR: %s: %v", path, err), nil
+		}
+		src := string(exprSrc)
+		if a.heredoc != nil && !strings.HasSuffix(src, "\n") {
+			src += "\n"
+		}
+		expr, diags := hclsyntax.ParseExpression([]byte(src), "expr.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			return fmt.Sprintf("%s: the expression tokens of %q do not parse: %q\n  %s", path, a.name, exprSrc, diagText(diags)), nil
+		}
+		val, diags := expr.Value(ctx)
+		if diags.HasErrors() {
+			return fmt.Sprintf("%s: the expression tokens of %q do not evaluate: %q\n  %s", path, a.name, exprSrc, diagText(diags)), attrShapes(a)
+		}
+		if !sameValue(val, want.cty()) {
+			return fmt.Sprintf("%s: the expression tokens of %q evaluate to %#v, expected %#v: %q", path, a.name, val, want.cty(), exprSrc), attrShapes(a)
+		}
+	}
+	blocks := wb.Blocks()
+	if len(blocks) != len(b.blocks) {
+		return fmt.Sprintf("%s: hclwrite sees %d blocks, expected %d", path, len(blocks), len(b.blocks)), nil
+	}
+	for i, blk := range b.blocks {
+		got := blocks[i]
+		if got.Type() != blk.typ {
+			return fmt.Sprintf("%s: block %d has type %q, expected %q", path, i, got.Type(), blk.typ), nil
+		}
+		labels := got.Labels()
+		if Known.writerEscapedLabel && hasEscapedLabel(blk) {
+			labels = nil // hcl/2: not compared
+		} else if len(labels) != len(blk.labels) {
+			return fmt.Sprintf("%s: block %d has labels %q, expected %q", path, i, labels, blk.labels), shapeIf(hasEscapedLabel(blk), "hcl/2")
+		}
+		for k := range labels {
+			if nfc(labels[k]) != nfc(blk.labels[k]) {
+				return fmt.Sprintf("%s: block %d has labels %q, expected %q", path, i, labels, blk.labels), shapeIf(hasEscapedLabel(blk), "hcl/2")
+			}
+		}
+		if msg, shapes := checkWriterBody(got.Body(), blk.body, ctx, sc, fmt.Sprintf("%s/%s%q", path, blk.typ, blk.labels)); msg != "" {
+			return msg, shapes
+		}
+	}
+	return "", nil
+}
+
+// hasEscapedLabel reports whether a block has a quoted label containing a
+// `$` or `%` beside other characters (the scanner splits the literal there;
+// the shape of hcl/2).
+func hasEscapedLabel(blk *block) bool {
+	for i, l := range blk.labels {
+		if blk.quoted[i] && len(l) > 1 && strings.ContainsAny(l, "$%") {
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelTokensForValueRoundTrip: hclwrite.TokensForValue spells a value
+// that hclsyntax reads back as the same value.
+func TestHegelTokensForValueRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := hegel.Draw(ht, valuesOf(3, true))
+		toks := hclwrite.TokensForValue(v.cty())
+		src := toks.Bytes()
+		note(ht, "value %#v\ntokens: %s", v.cty(), src)
+		expr, diags := hclsyntax.ParseExpression(src, "val.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "TokensForValue output does not parse: %s\n  %s\nvalue %#v", src, diagText(diags), v.cty())
+		}
+		got, diags := expr.Value(nil)
+		if diags.HasErrors() {
+			fail(ht, "TokensForValue output does not evaluate: %s\n  %s", src, diagText(diags))
+		}
+		if !sameValue(got, v.cty()) {
+			fail(ht, "TokensForValue round trip differs: %s\n     got %#v\nexpected %#v", src, got, v.cty())
+		}
+		// Format leaves it alone up to whitespace, and the token bytes are
+		// what the tokens say.
+		formatted := hclwrite.Format(append([]byte("x = "), src...))
+		f, diags := hclsyntax.ParseConfig(formatted, "val.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "formatted TokensForValue output does not parse:\n%s\n  %s", formatted, diagText(diags))
+		}
+		attrs, _ := f.Body.JustAttributes()
+		got2, diags := attrs["x"].Expr.Value(nil)
+		if diags.HasErrors() || !sameValue(got2, v.cty()) {
+			fail(ht, "formatted TokensForValue output evaluates differently:\n%s\n     got %#v\nexpected %#v\n%s", formatted, got2, v.cty(), diagText(diags))
+		}
+	})
+}
+
+// TestHegelRangesPointAtTheSource: the ranges of attributes, expressions,
+// blocks and labels slice the source to the text they describe.
+func TestHegelRangesPointAtTheSource(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, configs)
+		src := []byte(spell(c.body, c.tape).src)
+		note(ht, "source:\n%s", src)
+		f := parseConfig(ht, string(src), "the generated file")
+		ctx := evalContext(c.sc)
+		if msg, shapes := checkRanges(f.Body.(*hclsyntax.Body), c.body, src, ctx, c.sc); msg != "" {
+			mismatch(ht, shapes, "%s\nsource:\n%s", msg, src)
+		}
+	})
+}
+
+func checkRanges(hb *hclsyntax.Body, b *body, src []byte, ctx *hcl.EvalContext, sc *scope) (string, []string) {
+	if !hb.SrcRange.CanSliceBytes(src) {
+		return fmt.Sprintf("body range %s is outside the source", hb.SrcRange), nil
+	}
+	for _, a := range b.attrs {
+		ha, ok := hb.Attributes[a.name]
+		if !ok {
+			return fmt.Sprintf("attribute %q missing", a.name), nil
+		}
+		whole := string(ha.SrcRange.SliceBytes(src))
+		if !strings.HasPrefix(whole, a.name) {
+			return fmt.Sprintf("attribute %q: SrcRange %s slices %q, which does not start with the name", a.name, ha.SrcRange, whole), nil
+		}
+		if string(ha.NameRange.SliceBytes(src)) != a.name {
+			return fmt.Sprintf("attribute %q: NameRange %s slices %q", a.name, ha.NameRange, ha.NameRange.SliceBytes(src)), nil
+		}
+		if string(ha.EqualsRange.SliceBytes(src)) != "=" {
+			return fmt.Sprintf("attribute %q: EqualsRange %s slices %q", a.name, ha.EqualsRange, ha.EqualsRange.SliceBytes(src)), nil
+		}
+		exprSrc := ha.Expr.Range().SliceBytes(src)
+		text := string(exprSrc)
+		if a.heredoc != nil {
+			if !strings.HasSuffix(text, "\n") {
+				text += "\n"
+			}
+		}
+		expr, diags := hclsyntax.ParseExpression([]byte(text), "slice.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			return fmt.Sprintf("attribute %q: the expression range %s slices %q, which does not parse: %s", a.name, ha.Expr.Range(), exprSrc, diagText(diags)), nil
+		}
+		want, err := tryEval(a.e, sc)
+		if err != nil {
+			return "GENERATOR: " + err.Error(), nil
+		}
+		val, diags := expr.Value(ctx)
+		if diags.HasErrors() {
+			return fmt.Sprintf("attribute %q: the expression range slice %q does not evaluate: %s", a.name, exprSrc, diagText(diags)), attrShapes(a)
+		}
+		if !sameValue(val, want.cty()) {
+			return fmt.Sprintf("attribute %q: the expression range slice %q evaluates to %#v, expected %#v", a.name, exprSrc, val, want.cty()), attrShapes(a)
+		}
+		if !rangeWithin(ha.Expr.Range(), ha.SrcRange) || !rangeWithin(ha.SrcRange, hb.SrcRange) {
+			return fmt.Sprintf("attribute %q: ranges do not nest: expr %s, attr %s, body %s", a.name, ha.Expr.Range(), ha.SrcRange, hb.SrcRange), nil
+		}
+	}
+	if len(hb.Blocks) != len(b.blocks) {
+		return fmt.Sprintf("%d blocks, expected %d", len(hb.Blocks), len(b.blocks)), nil
+	}
+	for i, blk := range b.blocks {
+		got := hb.Blocks[i]
+		if string(got.TypeRange.SliceBytes(src)) != blk.typ {
+			return fmt.Sprintf("block %d: TypeRange %s slices %q, expected %q", i, got.TypeRange, got.TypeRange.SliceBytes(src), blk.typ), nil
+		}
+		if len(got.LabelRanges) != len(blk.labels) {
+			return fmt.Sprintf("block %d: %d label ranges for %d labels", i, len(got.LabelRanges), len(blk.labels)), nil
+		}
+		for k, lr := range got.LabelRanges {
+			text := string(lr.SliceBytes(src))
+			want := blk.labels[k]
+			if blk.quoted[k] {
+				// A quoted label: the slice is a string literal spelling it.
+				e, diags := hclsyntax.ParseExpression([]byte(text), "label.hcl", hcl.InitialPos)
+				if diags.HasErrors() {
+					return fmt.Sprintf("block %d: label range %d slices %q, not a string literal", i, k, text), nil
+				}
+				v, diags := e.Value(nil)
+				if diags.HasErrors() || v.Type() != cty.String || v.AsString() != nfc(want) {
+					return fmt.Sprintf("block %d: label range %d slices %q, expected the spelling of %q", i, k, text, want), nil
+				}
+			} else if nfc(text) != nfc(want) {
+				return fmt.Sprintf("block %d: label range %d slices %q, expected %q", i, k, text, want), nil
+			}
+		}
+		if string(got.OpenBraceRange.SliceBytes(src)) != "{" || string(got.CloseBraceRange.SliceBytes(src)) != "}" {
+			return fmt.Sprintf("block %d: brace ranges slice %q and %q", i, got.OpenBraceRange.SliceBytes(src), got.CloseBraceRange.SliceBytes(src)), nil
+		}
+		if !rangeWithin(got.Body.SrcRange, got.Range()) || !rangeWithin(got.Range(), hb.SrcRange) {
+			return fmt.Sprintf("block %d: ranges do not nest: body %s, block %s, parent %s", i, got.Body.SrcRange, got.Range(), hb.SrcRange), nil
+		}
+		if msg, shapes := checkRanges(got.Body, blk.body, src, ctx, sc); msg != "" {
+			return fmt.Sprintf("in block %d (%s): %s", i, blk.typ, msg), shapes
+		}
+	}
+	return "", nil
+}
+
+func rangeWithin(inner, outer hcl.Range) bool {
+	return inner.Start.Byte >= outer.Start.Byte && inner.End.Byte <= outer.End.Byte && inner.Start.Byte <= inner.End.Byte
+}
+
+// ---------------------------------------------------------------------------
+// Building files with the hclwrite API: build specs, applied by pure
+// functions to an hclwrite body and the model alike.
+
+// setter: the hclwrite call that sets an attribute.
+type setter int
+
+const (
+	setValue setter = iota // SetAttributeValue
+	setRaw                 // SetAttributeRaw with TokensForValue
+	setTrav                // SetAttributeTraversal into a variable
+)
+
+// travStep: one step of a traversal into a variable's value: the position of
+// the attribute or element (modulo their number) and, for an attribute,
+// whether it is an attribute step rather than an index by its name.
+type travStep struct {
+	at     int
+	asAttr bool
+}
+
+// wattr: an attribute to set: by value, by raw tokens of a value, or as a
+// traversal into the variable at position root.
+type wattr struct {
+	name  string
+	how   setter
+	v     V
+	root  int
+	steps []travStep
+}
+
+// wblock: a block to append: type, two candidate labels of which count are
+// used (or as many as the body's earlier blocks of the type have), a body,
+// and whether a blank line follows.
+type wblock struct {
+	typ     string
+	labels  []string
+	count   int
+	body    *wbody
+	newline bool
+}
+
+type witem struct {
+	attr *wattr
+	blk  *wblock
+}
+
+type wbody struct {
+	items []witem
+}
+
+var (
+	travSteps = hegel.Map(pairs(positions, chance(70)), func(p pair[int, bool]) travStep { return travStep{p.a, p.b} })
+	setters   = hegel.OneOf(
+		hegel.Map(valuesOf(2, false), func(v V) wattr { return wattr{how: setValue, v: v} }),
+		hegel.Map(valuesOf(2, false), func(v V) wattr { return wattr{how: setRaw, v: v} }),
+		hegel.Map(pairs(positions, many(travSteps, 0, 3)), func(p pair[int, []travStep]) wattr { return wattr{how: setTrav, root: p.a, steps: p.b} }),
+	)
+	// wattrs: an attribute to set, with a drawn name.
+	wattrs = hegel.Map(pairs(idents, setters), func(p pair[string, wattr]) wattr {
+		p.b.name = p.a
+		return p.b
+	})
+	// labelTexts: labels for AppendNewBlock, which quotes every label.
+	labelTexts = hegel.Map(labels, func(l label) string { return l.text })
+)
+
+// wblocksOf: a block to append whose body comes from inner (attributes only
+// when nil).
+func wblocksOf(inner hegel.Generator[*wbody]) hegel.Generator[*wblock] {
+	return hegel.Composite(func(tc hegel.TestCase) *wblock {
+		blk := &wblock{typ: hegel.Draw(tc, blockTypes), labels: hegel.Draw(tc, many(labelTexts, 2, 2)), count: hegel.Draw(tc, hegel.Integers(0, 2))}
+		if inner != nil {
+			blk.body = hegel.Draw(tc, inner)
+		}
+		blk.newline = hegel.Draw(tc, chance(30))
+		return blk
+	})
+}
+
+// wbodiesOf: up to four items, attributes seven times in ten and blocks with
+// bodies from inner three times in ten (attributes only when inner is nil).
+func wbodiesOf(inner hegel.Generator[*wbody]) hegel.Generator[*wbody] {
+	attrItems := hegel.Map(wattrs, func(a wattr) witem { return witem{attr: &a} })
+	items := attrItems
+	if inner != nil {
+		items = weighted(choice[witem]{70, attrItems}, choice[witem]{30, hegel.Map(wblocksOf(inner), func(b *wblock) witem { return witem{blk: b} })})
+	}
+	return hegel.Map(many(items, 0, 4), func(its []witem) *wbody { return &wbody{its} })
+}
+
+// wbodies: build specs nesting blocks 0, 1 and 2 levels deep.
+var wbodies = func() []hegel.Generator[*wbody] {
+	var out []hegel.Generator[*wbody]
+	var inner hegel.Generator[*wbody]
+	for depth := 0; depth <= 2; depth++ {
+		if depth == 0 {
+			inner = wbodiesOf(nil)
+		} else {
+			inner = wbodiesOf(inner)
+		}
+		out = append(out, inner)
+	}
+	return out
+}()
+
+// build fills an hclwrite body and its model alike from a spec, the first
+// attribute of a name winning.
+func build(wb *hclwrite.Body, spec *wbody, model *body, sc *scope) {
+	names := map[string]bool{}
+	for _, it := range spec.items {
+		if it.attr != nil {
+			if names[it.attr.name] {
+				continue
+			}
+			names[it.attr.name] = true
+			a := setAttribute(wb, *it.attr, sc)
+			model.attrs = append(model.attrs, a)
+			model.order = append(model.order, len(model.attrs)-1)
+			continue
+		}
+		appendNewBlock(wb, it.blk, model, sc)
+		if it.blk.newline {
+			wb.AppendNewline()
+		}
+	}
+}
+
+// appendNewBlock appends a block of the spec to an hclwrite body and its
+// model.
+func appendNewBlock(wb *hclwrite.Body, spec *wblock, model *body, sc *scope) {
+	count := labelCountFor(model, spec.typ, spec.count)
+	blk := &block{typ: spec.typ, labels: append([]string{}, spec.labels[:count]...), quoted: make([]bool, count), body: &body{}}
+	for i := range blk.quoted {
+		blk.quoted[i] = true
+	}
+	wblk := wb.AppendNewBlock(blk.typ, blk.labels)
+	if spec.body != nil {
+		build(wblk.Body(), spec.body, blk.body, sc)
+	}
+	model.blocks = append(model.blocks, blk)
+	model.order = append(model.order, -len(model.blocks))
+}
+
+// labelCountFor keeps blocks of one type in one body to one label count, as
+// a schema requires; the first block of a type gets the drawn count.
+func labelCountFor(model *body, typ string, drawn int) int {
+	for _, blk := range model.blocks {
+		if blk.typ == typ {
+			return len(blk.labels)
+		}
+	}
+	return drawn
+}
+
+func sortedRoots(sc *scope) []string {
+	var roots []string
+	for k := range sc.vars {
+		roots = append(roots, k)
+	}
+	sort.Strings(roots)
+	return roots
+}
+
+// setAttribute sets an attribute through the spec's hclwrite setter and
+// returns its model. A traversal follows the spec's steps into the variable
+// as far as its value has attributes or elements.
+func setAttribute(wb *hclwrite.Body, spec wattr, sc *scope) *attr {
+	switch spec.how {
+	case setValue:
+		wb.SetAttributeValue(spec.name, spec.v.cty())
+		return &attr{name: spec.name, e: &E{op: "lit", v: spec.v}}
+	case setRaw:
+		wb.SetAttributeRaw(spec.name, hclwrite.TokensForValue(spec.v.cty()))
+		return &attr{name: spec.name, e: &E{op: "lit", v: spec.v}}
+	}
+	roots := sortedRoots(sc)
+	if len(roots) == 0 {
+		wb.SetAttributeValue(spec.name, cty.True)
+		return &attr{name: spec.name, e: &E{op: "lit", v: boolV(true)}}
+	}
+	root := at(roots, spec.root)
+	e := &E{op: "var", name: root}
+	trav := hcl.Traversal{hcl.TraverseRoot{Name: root}}
+	cur := sc.vars[root]
+steps:
+	for _, st := range spec.steps {
+		switch {
+		case cur.k == kObj && len(cur.keys) > 0:
+			i := st.at % len(cur.keys)
+			key := cur.keys[i]
+			if isIdent(key) && !keywords[key] && st.asAttr {
+				trav = append(trav, hcl.TraverseAttr{Name: key})
+				e = &E{op: "attr", a: e, name: key}
+			} else {
+				trav = append(trav, hcl.TraverseIndex{Key: cty.StringVal(key)})
+				e = &E{op: "idx", a: e, b: &E{op: "lit", v: strV(key)}}
+			}
+			cur = cur.elems[i]
+		case cur.k == kTuple && len(cur.elems) > 0:
+			i := st.at % len(cur.elems)
+			trav = append(trav, hcl.TraverseIndex{Key: cty.NumberIntVal(int64(i))})
+			e = &E{op: "idx", a: e, b: &E{op: "lit", v: intV(int64(i))}}
+			cur = cur.elems[i]
+		default:
+			break steps
+		}
+	}
+	wb.SetAttributeTraversal(spec.name, trav)
+	return &attr{name: spec.name, e: e}
+}
+
+// ---------------------------------------------------------------------------
+// Edits: drawn as data, applied to an hclwrite body and its model with the
+// positions taken modulo the live sizes.
+
+type editKind int
+
+const (
+	setAttr     editKind = iota // set a new or existing attribute
+	removeAttr                  // remove the attribute at a position
+	renameAttr                  // rename the attribute at a position
+	removeBlock                 // remove the block at a position
+	appendBlock                 // append a block
+)
+
+var editKindNames = []string{"set attribute", "remove attribute", "rename attribute", "remove block", "append block"}
+
+// edit: one edit: the blocks to descend into (positions, as far as there are
+// blocks), the kind and its data.
+type edit struct {
+	path []int
+	kind editKind
+	attr wattr
+	at   int
+	to   string
+	blk  *wblock
+}
+
+func (e edit) String() string {
+	s := editKindNames[e.kind]
+	switch e.kind {
+	case setAttr:
+		s += " " + e.attr.name
+	case renameAttr:
+		s += fmt.Sprintf(" #%d to %s", e.at, e.to)
+	case removeAttr, removeBlock:
+		s += fmt.Sprintf(" #%d", e.at)
+	case appendBlock:
+		s += " " + e.blk.typ
+	}
+	if len(e.path) > 0 {
+		s += fmt.Sprintf(" in block path %v", e.path)
+	}
+	return s
+}
+
+func describeEdits(edits []edit) string {
+	parts := make([]string, len(edits))
+	for i, e := range edits {
+		parts[i] = e.String()
+	}
+	return strings.Join(parts, "; ")
+}
+
+// edits: one of the five kinds, the plainest (set an attribute) first, at
+// up to two levels of blocks down.
+var edits = hegel.Map(pairs(many(positions, 0, 2), hegel.OneOf(
+	hegel.Map(wattrs, func(a wattr) edit { return edit{kind: setAttr, attr: a} }),
+	hegel.Map(positions, func(i int) edit { return edit{kind: removeAttr, at: i} }),
+	hegel.Map(pairs(positions, idents), func(p pair[int, string]) edit { return edit{kind: renameAttr, at: p.a, to: p.b} }),
+	hegel.Map(positions, func(i int) edit { return edit{kind: removeBlock, at: i} }),
+	hegel.Map(wblocksOf(wbodies[0]), func(b *wblock) edit { return edit{kind: appendBlock, blk: b} }),
+)), func(p pair[[]int, edit]) edit {
+	p.b.path = p.a
+	return p.b
+})
+
+// firstTwin is the first block of the model with blk's type and labels
+// (FirstMatchingBlock finds that one).
+func firstTwin(model *body, blk *block) *block {
+	for _, cand := range model.blocks {
+		if cand.typ == blk.typ && strings.Join(cand.labels, "\x00") == strings.Join(blk.labels, "\x00") {
+			return cand
+		}
+	}
+	return blk
+}
+
+// apply performs one edit on an hclwrite body and its model alike, descending
+// along the path as far as there are blocks. It returns the block whose body
+// the edit reached (nil for the root), and whether the edit added a new
+// attribute or a block to it (in a one-line block, the shape of hcl/5).
+func apply(e edit, wb *hclwrite.Body, model *body, sc *scope) (*block, bool) {
+	var target *block
+	for _, pos := range e.path {
+		if len(model.blocks) == 0 {
+			break
+		}
+		blk := model.blocks[pos%len(model.blocks)]
+		wblk := wb.FirstMatchingBlock(blk.typ, blk.labels)
+		if wblk == nil {
+			return target, false
+		}
+		blk = firstTwin(model, blk)
+		wb, model, target = wblk.Body(), blk.body, blk
+	}
+	switch e.kind {
+	case setAttr:
+		a := setAttribute(wb, e.attr, sc)
+		for i, old := range model.attrs {
+			if old.name == a.name {
+				model.attrs[i] = a
+				return target, false
+			}
+		}
+		model.attrs = append(model.attrs, a)
+		model.order = append(model.order, len(model.attrs)-1)
+		return target, true
+	case removeAttr:
+		if len(model.attrs) == 0 {
+			return target, false
+		}
+		i := e.at % len(model.attrs)
+		wb.RemoveAttribute(model.attrs[i].name)
+		model.removeAttr(i)
+	case renameAttr:
+		if len(model.attrs) == 0 {
+			return target, false
+		}
+		i := e.at % len(model.attrs)
+		for _, other := range model.attrs {
+			if other.name == e.to {
+				return target, false
+			}
+		}
+		if wb.RenameAttribute(model.attrs[i].name, e.to) {
+			model.attrs[i].name = e.to
+		}
+	case removeBlock:
+		if len(model.blocks) == 0 {
+			return target, false
+		}
+		blk := model.blocks[e.at%len(model.blocks)]
+		wblk := wb.FirstMatchingBlock(blk.typ, blk.labels)
+		if wblk == nil {
+			return target, false
+		}
+		wb.RemoveBlock(wblk)
+		for j, cand := range model.blocks {
+			if cand.typ == blk.typ && strings.Join(cand.labels, "\x00") == strings.Join(blk.labels, "\x00") {
+				model.removeBlock(j)
+				break
+			}
+		}
+	case appendBlock:
+		appendNewBlock(wb, e.blk, model, sc)
+		return target, true
+	}
+	return target, false
+}
+
+func (b *body) removeAttr(i int) {
+	b.attrs = append(b.attrs[:i], b.attrs[i+1:]...)
+	var order []int
+	for _, o := range b.order {
+		if o == i {
+			continue
+		}
+		if o > i {
+			o--
+		}
+		order = append(order, o)
+	}
+	b.order = order
+}
+
+func (b *body) removeBlock(i int) {
+	b.blocks = append(b.blocks[:i], b.blocks[i+1:]...)
+	var order []int
+	for _, o := range b.order {
+		if o == -1-i {
+			continue
+		}
+		if o < -1-i {
+			o++
+		}
+		order = append(order, o)
+	}
+	b.order = order
+}
+
+// genCase: a scope, a build spec and up to four edits.
+type genCase struct {
+	sc    *scope
+	spec  *wbody
+	edits []edit
+}
+
+func (c genCase) GoString() string {
+	f := hclwrite.NewEmptyFile()
+	build(f.Body(), c.spec, &body{}, c.sc)
+	return fmt.Sprintf("built:\n%s\nedits: %s\nvariables:\n%s", f.Bytes(), describeEdits(c.edits), c.sc.describe())
+}
+
+var genCases = hegel.Composite(func(tc hegel.TestCase) genCase {
+	return genCase{sc: hegel.Draw(tc, envs), spec: hegel.Draw(tc, wbodies[2]), edits: hegel.Draw(tc, many(edits, 0, 4))}
+})
+
+// TestHegelGeneratedFilesReadBack: a file generated with the hclwrite API
+// (SetAttributeValue, SetAttributeTraversal, SetAttributeRaw with
+// TokensForValue, AppendNewBlock) parses with hclsyntax to the model, is
+// already formatted, and survives a sequence of edits.
+func TestHegelGeneratedFilesReadBack(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, genCases)
+		ctx := evalContext(c.sc)
+		f := hclwrite.NewEmptyFile()
+		model := &body{}
+		build(f.Body(), c.spec, model, c.sc)
+		src := f.Bytes()
+		note(ht, "generated:\n%s", src)
+		pf, diags := hclsyntax.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclsyntax rejects a file built with hclwrite:\n%s\n  %s", src, diagText(diags))
+		}
+		if msg, _ := checkContent(pf.Body, model, ctx, c.sc, "generated"); msg != "" {
+			fail(ht, "%s\ngenerated:\n%s", msg, src)
+		}
+		formatted := hclwrite.Format(src)
+		if !bytes.Equal(formatted, src) {
+			fail(ht, "a file built with hclwrite is not in Format's form:\nbuilt:\n%s\nformatted:\n%s", src, formatted)
+		}
+		for _, e := range c.edits {
+			apply(e, f.Body(), model, c.sc)
+			src = f.Bytes()
+			pf, diags = hclsyntax.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+			if diags.HasErrors() {
+				fail(ht, "hclsyntax rejects a file edited with hclwrite (%s):\n%s\n  %s", e, src, diagText(diags))
+			}
+			if msg, _ := checkContent(pf.Body, model, ctx, c.sc, "edited"); msg != "" {
+				fail(ht, "%s (after %s)\nedited:\n%s", msg, e, src)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Mutations: drawn as data, applied with positions modulo the live length.
+
+type mutationKind int
+
+const (
+	mutDelete    mutationKind = iota // delete a span of one to eight bytes
+	mutInsert                        // insert a piece
+	mutReplace                       // replace a byte
+	mutDuplicate                     // copy a span of up to twenty bytes elsewhere
+	mutTruncate                      // cut the tail
+)
+
+type mutation struct {
+	kind  mutationKind
+	at    int
+	span  int
+	to    int
+	piece string
+	b     byte
+}
+
+var mutationPieces = []string{"{", "}", "[", "]", "(", ")", "\"", "\\", "${", "%{", "~}", "<<EOT\n", "EOT\n", "\n", "#", "//", "/*", "*/", "=", "==", ":", ",", ".", "...", "*", "-", "?", " ", "\t", "\r\n", "for", "in", "if", "null", "\xff", "\x00", "'", "`", "1e", "0x", "\u00a0", "\u2028"}
+
+// offsets: a byte offset into a source of unknown length, taken modulo the
+// length.
+var offsets = hegel.Integers(0, 99999)
+
+var mutations = hegel.OneOf(
+	hegel.Map(pairs(offsets, hegel.Integers(1, 8)), func(p pair[int, int]) mutation { return mutation{kind: mutDelete, at: p.a, span: p.b} }),
+	hegel.Map(pairs(offsets, hegel.SampledFrom(mutationPieces)), func(p pair[int, string]) mutation { return mutation{kind: mutInsert, at: p.a, piece: p.b} }),
+	hegel.Map(pairs(offsets, hegel.Integers(0, 255)), func(p pair[int, int]) mutation { return mutation{kind: mutReplace, at: p.a, b: byte(p.b)} }),
+	hegel.Composite(func(tc hegel.TestCase) mutation {
+		return mutation{kind: mutDuplicate, at: hegel.Draw(tc, offsets), span: hegel.Draw(tc, hegel.Integers(1, 20)), to: hegel.Draw(tc, offsets)}
+	}),
+	hegel.Map(offsets, func(i int) mutation { return mutation{kind: mutTruncate, at: i} }),
+)
+
+// mutate applies the mutations to a copy of src.
+func mutate(src []byte, muts []mutation) []byte {
+	out := append([]byte{}, src...)
+	for _, m := range muts {
+		if len(out) == 0 && m.kind != mutInsert {
+			continue
+		}
+		switch m.kind {
+		case mutDelete:
+			i := m.at % len(out)
+			j := min(i+m.span, len(out))
+			out = append(out[:i:i], out[j:]...)
+		case mutInsert:
+			i := m.at % (len(out) + 1)
+			out = append(out[:i:i], append([]byte(m.piece), out[i:]...)...)
+		case mutReplace:
+			out[m.at%len(out)] = m.b
+		case mutDuplicate:
+			i := m.at % len(out)
+			j := min(i+m.span, len(out))
+			span := append([]byte{}, out[i:j]...)
+			to := m.to % (len(out) + 1)
+			out = append(out[:to:to], append(span, out[to:]...)...)
+		case mutTruncate:
+			out = out[:m.at%len(out)]
+		}
+	}
+	return out
+}
+
+// brokenCase: a configuration, spelled as JSON three times in ten, and one
+// to three mutations.
+type brokenCase struct {
+	config
+	json bool
+	muts []mutation
+}
+
+func (c brokenCase) source() []byte {
+	if c.json {
+		return []byte(spellJSON(c.body))
+	}
+	return []byte(spell(c.body, c.tape).src)
+}
+
+func (c brokenCase) GoString() string {
+	return fmt.Sprintf("mutated:\n%s", mutate(c.source(), c.muts))
+}
+
+var brokenCases = hegel.Composite(func(tc hegel.TestCase) brokenCase {
+	return brokenCase{config: hegel.Draw(tc, configs), json: hegel.Draw(tc, chance(30)), muts: hegel.Draw(tc, many(mutations, 1, 3))}
+})
+
+// hasTypeComment reports whether a block of the parsed body has a comment
+// between its type and its first label (the shape of hcl/3), which a
+// mutation may create.
+func hasTypeComment(hb *hclsyntax.Body, src []byte) bool {
+	for _, blk := range hb.Blocks {
+		if len(blk.LabelRanges) > 0 {
+			from, to := blk.TypeRange.End.Byte, blk.LabelRanges[0].Start.Byte
+			if from <= to && to <= len(src) && bytes.Contains(src[from:to], []byte("/*")) {
+				return true
+			}
+		}
+		if hasTypeComment(blk.Body, src) {
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelBrokenInputsNeverPanic: mutated files never make the parsers,
+// the formatter or the writer panic; whatever still parses is reproduced
+// verbatim by hclwrite and formats to a fixed point.
+func TestHegelBrokenInputsNeverPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, brokenCases)
+		mutated := mutate(c.source(), c.muts)
+		note(ht, "mutated:\n%s", mutated)
+		f, diags := hclsyntax.ParseConfig(mutated, "m.hcl", hcl.InitialPos)
+		typeComment := !diags.HasErrors() && hasTypeComment(f.Body.(*hclsyntax.Body), mutated)
+		json.Parse(mutated, "m.json")
+		hclsyntax.ParseExpression(mutated, "m.hcl", hcl.InitialPos)
+		hclsyntax.ParseTemplate(mutated, "m.hcl", hcl.InitialPos)
+		hclsyntax.ParseTraversalAbs(mutated, "m.hcl", hcl.InitialPos)
+		formatted := hclwrite.Format(mutated)
+		wf, wdiags := hclwrite.ParseConfig(mutated, "m.hcl", hcl.InitialPos)
+		if !diags.HasErrors() {
+			if wdiags.HasErrors() {
+				fail(ht, "hclwrite.ParseConfig rejects what hclsyntax accepts:\n%s\n  %s", mutated, diagText(wdiags))
+			}
+			if !bytes.Equal(wf.Bytes(), formatted) {
+				mismatch(ht, shapeIf(typeComment, "hcl/3"), "hclwrite.ParseConfig(src).Bytes() differs from Format(src):\nsource:\n%s\nbytes:\n%s\nformat:\n%s", mutated, wf.Bytes(), formatted)
+			}
+			f2, diags2 := hclsyntax.ParseConfig(formatted, "f.hcl", hcl.InitialPos)
+			if diags2.HasErrors() {
+				fail(ht, "Format output does not parse:\n%s\n  %s\nsource:\n%s", formatted, diagText(diags2), mutated)
+			}
+			t1, _ := tokenShapes(mutated)
+			t2, _ := tokenShapes(formatted)
+			if d := firstTokenDiff(t1, t2); d != "" {
+				fail(ht, "Format changed more than whitespace: %s\nsource:\n%s\nformatted:\n%s", d, mutated, formatted)
+			}
+			again := hclwrite.Format(formatted)
+			if !bytes.Equal(again, formatted) {
+				fail(ht, "Format is not idempotent:\nsource:\n%s\nfirst:\n%s\nsecond:\n%s", mutated, formatted, again)
+			}
+			// The structures agree on attribute names and block types.
+			attrs1, _ := f.Body.JustAttributes()
+			attrs2, _ := f2.Body.JustAttributes()
+			if len(attrs1) != len(attrs2) {
+				fail(ht, "Format changed the attribute set: %d vs %d\nsource:\n%s\nformatted:\n%s", len(attrs1), len(attrs2), mutated, formatted)
+			}
+		}
+	})
+}
diff --git a/hegel_expr_test.go b/hegel_expr_test.go
new file mode 100644
index 0000000..356145d
--- /dev/null
+++ b/hegel_expr_test.go
@@ -0,0 +1,2617 @@
+package hcl_test
+
+// Statically typed expressions over the value model: a model evaluator
+// transcribed from hclsyntax/spec.md, spellings in the native syntax, and the
+// grammar of expressions as generator values over a drawn scope. Every
+// generated expression is well typed and total (no index out of range, no
+// division by zero, no null in a template), so hclsyntax must evaluate it
+// without diagnostics to the model's value.
+
+import (
+	"fmt"
+	"math/big"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/hashicorp/hcl/v2/json"
+	"github.com/zclconf/go-cty/cty"
+	"github.com/zclconf/go-cty/cty/function"
+	"github.com/zclconf/go-cty/cty/function/stdlib"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Static types.
+
+type T struct {
+	k      kind
+	elems  []T      // tuple element types
+	keys   []string // object attribute names, sorted
+	fields []T      // object attribute types, aligned with keys
+	list   bool     // list(elem) rather than a tuple
+	elem   *T
+}
+
+var (
+	tNum  = T{k: kNum}
+	tStr  = T{k: kStr}
+	tBool = T{k: kBool}
+)
+
+func typeOf(v V) T {
+	switch v.k {
+	case kTuple:
+		if v.list {
+			et := v.et
+			return T{k: kTuple, list: true, elem: &et}
+		}
+		t := T{k: kTuple, elems: []T{}}
+		for _, e := range v.elems {
+			t.elems = append(t.elems, typeOf(e))
+		}
+		return t
+	case kObj:
+		idx := make([]int, len(v.keys))
+		for i := range idx {
+			idx[i] = i
+		}
+		sort.Slice(idx, func(a, b int) bool { return v.keys[idx[a]] < v.keys[idx[b]] })
+		t := T{k: kObj, keys: []string{}, fields: []T{}}
+		for _, i := range idx {
+			t.keys = append(t.keys, v.keys[i])
+			t.fields = append(t.fields, typeOf(v.elems[i]))
+		}
+		return t
+	default:
+		return T{k: v.k}
+	}
+}
+
+func (t T) eq(u T) bool {
+	if t.k != u.k || t.list != u.list || len(t.elems) != len(u.elems) || len(t.keys) != len(u.keys) {
+		return false
+	}
+	if t.list {
+		return t.elem.eq(*u.elem)
+	}
+	for i := range t.elems {
+		if !t.elems[i].eq(u.elems[i]) {
+			return false
+		}
+	}
+	for i := range t.keys {
+		if t.keys[i] != u.keys[i] || !t.fields[i].eq(u.fields[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (t T) String() string {
+	switch t.k {
+	case kNum:
+		return "number"
+	case kStr:
+		return "string"
+	case kBool:
+		return "bool"
+	case kNull:
+		return "dynamic"
+	case kTuple:
+		if t.list {
+			return "list(" + t.elem.String() + ")"
+		}
+		parts := make([]string, len(t.elems))
+		for i, e := range t.elems {
+			parts[i] = e.String()
+		}
+		return "tuple[" + strings.Join(parts, ", ") + "]"
+	default:
+		parts := make([]string, len(t.keys))
+		for i, k := range t.keys {
+			parts[i] = k + "=" + t.fields[i].String()
+		}
+		return "object{" + strings.Join(parts, ", ") + "}"
+	}
+}
+
+// homogeneous reports whether all elements of a tuple type (or all fields of
+// an object type) share one type, which makes a body typed under one binding
+// well typed under all of them.
+func (t T) homogeneous() (T, bool) {
+	var parts []T
+	if t.list {
+		return *t.elem, true
+	}
+	if t.k == kTuple {
+		parts = t.elems
+	} else if t.k == kObj {
+		parts = t.fields
+	} else {
+		return T{}, false
+	}
+	if len(parts) == 0 {
+		return T{}, false
+	}
+	for _, p := range parts[1:] {
+		if !p.eq(parts[0]) {
+			return T{}, false
+		}
+	}
+	return parts[0], true
+}
+
+// ---------------------------------------------------------------------------
+// Expressions.
+
+type E struct {
+	op    string // lit var bin un cond idx attr splat fsplat fortup forobj tmpl call paren
+	v     V      // lit
+	name  string // var name, attr name, function name, binary/unary operator
+	a     *E
+	b     *E
+	c     *E
+	args  []*E // call arguments, splat steps' attribute names in names
+	names []string
+	// for expressions
+	keyVar, valVar string
+	group          bool
+	// templates
+	parts []tpart
+	// splat steps: attr names ("" = index by ints[i])
+	steps []splatStep
+	// call
+	ellipsis bool
+	sp       spacing
+}
+
+type splatStep struct {
+	attr  string
+	index int
+	isIdx bool
+}
+
+type tpart struct {
+	kind      string // lit interp if for
+	text      string
+	e         *E // interp expression, if condition, for collection
+	then      []tpart
+	els       []tpart
+	hasEl     bool
+	body      []tpart
+	kv        [2]string // for key/value names
+	strip     [2]bool   // strip markers on the opening sequence: after `{`, before `}`
+	stripElse [2]bool
+	stripEnd  [2]bool
+}
+
+// spacing is the whitespace variant used when spelling an expression.
+type spacing int
+
+// ---------------------------------------------------------------------------
+// The scope: variable values.
+
+type scope struct {
+	vars   map[string]V
+	parent *scope
+}
+
+func (s *scope) lookup(name string) (V, bool) {
+	for c := s; c != nil; c = c.parent {
+		if v, ok := c.vars[name]; ok {
+			return v, true
+		}
+	}
+	return V{}, false
+}
+
+func (s *scope) child(vars map[string]V) *scope { return &scope{vars: vars, parent: s} }
+
+// describe lists the variables of the scope's root, for the draw report.
+func (s *scope) describe() string {
+	names := make([]string, 0, len(s.vars))
+	for name := range s.vars {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	var b strings.Builder
+	for _, name := range names {
+		b.WriteString("  " + name + " = " + s.vars[name].native() + "\n")
+	}
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// Conversions of the information model.
+
+type evalError struct{ msg string }
+
+func (e evalError) Error() string { return e.msg }
+
+func numOf(v V) *big.Float {
+	switch v.k {
+	case kNum:
+		return bigNum(v.num)
+	case kStr:
+		f, _, err := big.ParseFloat(v.s, 10, 512, big.ToNearestEven)
+		if err != nil {
+			panic(evalError{"string not a number: " + v.s})
+		}
+		return f
+	}
+	panic(evalError{"not a number"})
+}
+
+func boolOf(v V) bool {
+	switch v.k {
+	case kBool:
+		return v.b
+	case kStr:
+		if v.s == "true" {
+			return true
+		}
+		if v.s == "false" {
+			return false
+		}
+	}
+	panic(evalError{"not a bool"})
+}
+
+// strOf converts a primitive to string as the information model does.
+func strOf(v V) string {
+	switch v.k {
+	case kStr:
+		return v.s
+	case kNum:
+		return canonNum(v.num)
+	case kBool:
+		return strconv.FormatBool(v.b)
+	}
+	panic(evalError{"not convertible to string"})
+}
+
+func vEq(a, b V) bool {
+	if a.k != b.k || a.list != b.list {
+		return false
+	}
+	switch a.k {
+	case kNull:
+		return true
+	case kBool:
+		return a.b == b.b
+	case kNum:
+		return bigNum(a.num).Cmp(bigNum(b.num)) == 0
+	case kStr:
+		return a.s == b.s
+	case kTuple:
+		if len(a.elems) != len(b.elems) {
+			return false
+		}
+		for i := range a.elems {
+			if !vEq(a.elems[i], b.elems[i]) {
+				return false
+			}
+		}
+		return true
+	case kObj:
+		if len(a.keys) != len(b.keys) {
+			return false
+		}
+		for i, k := range a.keys {
+			j := -1
+			for jj, kk := range b.keys {
+				if kk == k {
+					j = jj
+				}
+			}
+			if j < 0 || !vEq(a.elems[i], b.elems[j]) {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+func floatV(f *big.Float) V { return numV(numText(f)) }
+
+// objGet returns the attribute value of an object.
+func objGet(v V, key string) (V, bool) {
+	for i, k := range v.keys {
+		if k == key {
+			return v.elems[i], true
+		}
+	}
+	return V{}, false
+}
+
+// sortedKeys visits an object's attributes in lexicographic key order.
+func sortedKeys(v V) []int {
+	idx := make([]int, len(v.keys))
+	for i := range idx {
+		idx[i] = i
+	}
+	sort.Slice(idx, func(a, b int) bool { return v.keys[idx[a]] < v.keys[idx[b]] })
+	return idx
+}
+
+// ---------------------------------------------------------------------------
+// The model evaluator.
+
+func eval(e *E, sc *scope) V {
+	switch e.op {
+	case "lit":
+		return e.v
+	case "paren":
+		return eval(e.a, sc)
+	case "var":
+		v, ok := sc.lookup(e.name)
+		if !ok {
+			panic(evalError{"unbound " + e.name})
+		}
+		return v
+	case "un":
+		x := eval(e.a, sc)
+		if e.name == "-" {
+			return floatV(new(big.Float).SetPrec(512).Neg(numOf(x)))
+		}
+		return boolV(!boolOf(x))
+	case "bin":
+		l, r := eval(e.a, sc), eval(e.b, sc)
+		switch e.name {
+		case "==":
+			return boolV(vEq(l, r))
+		case "!=":
+			return boolV(!vEq(l, r))
+		case "&&":
+			return boolV(boolOf(l) && boolOf(r))
+		case "||":
+			return boolV(boolOf(l) || boolOf(r))
+		}
+		a, b := numOf(l), numOf(r)
+		switch e.name {
+		case "<":
+			return boolV(a.Cmp(b) < 0)
+		case "<=":
+			return boolV(a.Cmp(b) <= 0)
+		case ">":
+			return boolV(a.Cmp(b) > 0)
+		case ">=":
+			return boolV(a.Cmp(b) >= 0)
+		case "+":
+			return floatV(new(big.Float).SetPrec(512).Add(a, b))
+		case "-":
+			return floatV(new(big.Float).SetPrec(512).Sub(a, b))
+		case "*":
+			return floatV(new(big.Float).SetPrec(512).Mul(a, b))
+		case "/":
+			return floatV(new(big.Float).SetPrec(512).Quo(a, b))
+		case "%":
+			// a - trunc(a/b)*b, the remainder with the dividend's sign.
+			q := new(big.Float).SetPrec(512).Quo(a, b)
+			qi, _ := q.Int(nil)
+			w := new(big.Float).SetPrec(512).SetInt(qi)
+			w.Mul(w, b)
+			return floatV(new(big.Float).SetPrec(512).Sub(a, w))
+		}
+	case "cond":
+		c := boolOf(eval(e.a, sc))
+		t, f := eval(e.b, sc), eval(e.c, sc)
+		tt, ft := typeOf(t), typeOf(f)
+		if tt.eq(ft) {
+			if c {
+				return t
+			}
+			return f
+		}
+		// Unification of differing primitive types converts both to string.
+		if c {
+			return strV(strOf(t))
+		}
+		return strV(strOf(f))
+	case "idx":
+		coll, key := eval(e.a, sc), eval(e.b, sc)
+		switch coll.k {
+		case kTuple:
+			i, _ := numOf(key).Int64()
+			if i < 0 || int(i) >= len(coll.elems) {
+				panic(evalError{"index out of range in " + e.dump()})
+			}
+			return coll.elems[i]
+		case kObj:
+			v, ok := objGet(coll, strOf(key))
+			if !ok {
+				panic(evalError{"no such attribute"})
+			}
+			return v
+		}
+		panic(evalError{"not indexable"})
+	case "attr":
+		coll := eval(e.a, sc)
+		if coll.k == kTuple {
+			// The legacy index operator tuple.N.
+			i, err := strconv.Atoi(e.name)
+			if err != nil || i < 0 || i >= len(coll.elems) {
+				panic(evalError{"legacy index " + e.name})
+			}
+			return coll.elems[i]
+		}
+		v, ok := objGet(coll, e.name)
+		if !ok {
+			panic(evalError{"no such attribute " + e.name})
+		}
+		return v
+	case "splat", "fsplat":
+		src := eval(e.a, sc)
+		var items []V
+		if src.k == kTuple {
+			items = src.elems
+		} else if src.k == kNull {
+			items = nil
+		} else {
+			items = []V{src}
+		}
+		out := []V{}
+		for _, it := range items {
+			cur := it
+			for _, st := range e.steps {
+				if st.isIdx {
+					if cur.k != kTuple || st.index >= len(cur.elems) {
+						panic(evalError{"splat index"})
+					}
+					cur = cur.elems[st.index]
+				} else {
+					var ok bool
+					cur, ok = objGet(cur, st.attr)
+					if !ok {
+						panic(evalError{"splat attr"})
+					}
+				}
+			}
+			out = append(out, cur)
+		}
+		return tupleV(out...)
+	case "fortup", "forobj":
+		coll := eval(e.a, sc)
+		type kv struct{ k, v V }
+		var items []kv
+		switch coll.k {
+		case kTuple:
+			for i, it := range coll.elems {
+				items = append(items, kv{intV(int64(i)), it})
+			}
+		case kObj:
+			for _, i := range sortedKeys(coll) {
+				items = append(items, kv{strV(coll.keys[i]), coll.elems[i]})
+			}
+		default:
+			panic(evalError{"not iterable"})
+		}
+		var outElems []V
+		var outKeys []string
+		groups := map[string][]V{}
+		for _, it := range items {
+			vars := map[string]V{}
+			if e.keyVar != "" {
+				vars[e.keyVar] = it.k
+			}
+			vars[e.valVar] = it.v
+			inner := sc.child(vars)
+			if e.c != nil && !boolOf(eval(e.c, inner)) {
+				continue
+			}
+			if e.op == "fortup" {
+				outElems = append(outElems, eval(e.b, inner))
+				continue
+			}
+			key := strOf(eval(e.b, inner))
+			val := eval(e.args[0], inner)
+			if e.group {
+				if _, seen := groups[key]; !seen {
+					outKeys = append(outKeys, key)
+				}
+				groups[key] = append(groups[key], val)
+				continue
+			}
+			for _, k := range outKeys {
+				if k == key {
+					panic(evalError{"duplicate key " + key})
+				}
+			}
+			outKeys = append(outKeys, key)
+			outElems = append(outElems, val)
+		}
+		if e.op == "fortup" {
+			return tupleV(outElems...)
+		}
+		if e.group {
+			outElems = nil
+			for _, k := range outKeys {
+				outElems = append(outElems, tupleV(groups[k]...))
+			}
+		}
+		if outKeys == nil {
+			outKeys, outElems = []string{}, []V{}
+		}
+		return objV(outKeys, outElems)
+	case "tmpl":
+		return evalTemplate(e.parts, sc)
+	case "tuple":
+		elems := []V{}
+		for _, a := range e.args {
+			elems = append(elems, eval(a, sc))
+		}
+		return tupleV(elems...)
+	case "object":
+		elems := []V{}
+		for _, a := range e.args {
+			elems = append(elems, eval(a, sc))
+		}
+		return objV(e.names, elems)
+	case "call":
+		var args []V
+		for _, a := range e.args {
+			args = append(args, eval(a, sc))
+		}
+		if e.ellipsis {
+			last := args[len(args)-1]
+			args = append(args[:len(args)-1], last.elems...)
+		}
+		return callModel(e.name, args)
+	}
+	panic(evalError{"bad op " + e.op})
+}
+
+// evalTemplate follows the template sub-language: strip markers act on the
+// adjacent literals at syntax level, a template of a single interpolation is
+// unwrapped, everything else is concatenated as strings.
+func evalTemplate(parts []tpart, sc *scope) V {
+	// A template that is a single interpolation (empty literals, such as the
+	// remains of a stripped space, do not count) yields the value itself.
+	if single := soleInterp(parts); single != nil {
+		return eval(single, sc)
+	}
+	var b strings.Builder
+	renderParts(parts, sc, &b)
+	return strV(b.String())
+}
+
+// soleInterp returns the interpolation's expression when the parts are one
+// interpolation beside empty literals only.
+func soleInterp(parts []tpart) *E {
+	var single *E
+	for _, p := range parts {
+		switch {
+		case p.kind == "lit" && p.text == "":
+		case p.kind == "interp" && single == nil:
+			single = p.e
+		default:
+			return nil
+		}
+	}
+	return single
+}
+
+func renderParts(parts []tpart, sc *scope, b *strings.Builder) {
+	for _, p := range parts {
+		switch p.kind {
+		case "lit":
+			b.WriteString(p.text)
+		case "interp":
+			v := eval(p.e, sc)
+			if v.k == kNull {
+				panic(evalError{"null in template"})
+			}
+			b.WriteString(strOf(v))
+		case "if":
+			if boolOf(eval(p.e, sc)) {
+				renderParts(p.then, sc, b)
+			} else if p.hasEl {
+				renderParts(p.els, sc, b)
+			}
+		case "for":
+			coll := eval(p.e, sc)
+			type kv struct{ k, v V }
+			var items []kv
+			switch coll.k {
+			case kTuple:
+				for i, it := range coll.elems {
+					items = append(items, kv{intV(int64(i)), it})
+				}
+			case kObj:
+				for _, i := range sortedKeys(coll) {
+					items = append(items, kv{strV(coll.keys[i]), coll.elems[i]})
+				}
+			}
+			for _, it := range items {
+				vars := map[string]V{}
+				if p.kv[0] != "" {
+					vars[p.kv[0]] = it.k
+				}
+				vars[p.kv[1]] = it.v
+				renderParts(p.body, sc.child(vars), b)
+			}
+		}
+	}
+}
+
+// Functions offered to expressions: the cty stdlib ones the harness models.
+var funcTable = map[string]function.Function{
+	"upper":    stdlib.UpperFunc,
+	"lower":    stdlib.LowerFunc,
+	"strlen":   stdlib.StrlenFunc,
+	"length":   stdlib.LengthFunc,
+	"max":      stdlib.MaxFunc,
+	"min":      stdlib.MinFunc,
+	"abs":      stdlib.AbsoluteFunc,
+	"concat":   stdlib.ConcatFunc,
+	"join":     stdlib.JoinFunc,
+	"keys":     stdlib.KeysFunc,
+	"contains": stdlib.ContainsFunc,
+	"element":  stdlib.ElementFunc,
+	"range":    stdlib.RangeFunc,
+}
+
+func callModel(name string, args []V) V {
+	switch name {
+	case "upper":
+		return strV(strings.ToUpper(strOf(args[0])))
+	case "lower":
+		return strV(strings.ToLower(strOf(args[0])))
+	case "strlen":
+		// Graphemes; the generator only passes strings whose graphemes are
+		// single code points.
+		return intV(int64(len([]rune(strOf(args[0])))))
+	case "length":
+		return intV(int64(len(args[0].elems)))
+	case "max", "min":
+		best := numOf(args[0])
+		for _, a := range args[1:] {
+			f := numOf(a)
+			if (name == "max" && f.Cmp(best) > 0) || (name == "min" && f.Cmp(best) < 0) {
+				best = f
+			}
+		}
+		return floatV(best)
+	case "abs":
+		return floatV(new(big.Float).SetPrec(512).Abs(numOf(args[0])))
+	case "concat":
+		var out []V
+		allLists := true
+		for _, a := range args {
+			out = append(out, a.elems...)
+			if !a.list {
+				allLists = false
+			}
+		}
+		if allLists {
+			return listV(out, args[0].et)
+		}
+		return tupleV(out...)
+	case "join":
+		sep := strOf(args[0])
+		var parts []string
+		for _, a := range args[1:] {
+			for _, el := range a.elems {
+				parts = append(parts, strOf(el))
+			}
+		}
+		return strV(strings.Join(parts, sep))
+	case "keys":
+		var out []V
+		for _, i := range sortedKeys(args[0]) {
+			out = append(out, strV(args[0].keys[i]))
+		}
+		return tupleV(out...)
+	case "contains":
+		for _, el := range args[0].elems {
+			if vEq(el, args[1]) {
+				return boolV(true)
+			}
+		}
+		return boolV(false)
+	case "element":
+		i, _ := numOf(args[1]).Int64()
+		l := int64(len(args[0].elems))
+		return args[0].elems[((i%l)+l)%l]
+	case "range":
+		var out []V
+		var start, end, step int64 = 0, 0, 1
+		switch len(args) {
+		case 1:
+			end, _ = numOf(args[0]).Int64()
+		case 2:
+			start, _ = numOf(args[0]).Int64()
+			end, _ = numOf(args[1]).Int64()
+		case 3:
+			start, _ = numOf(args[0]).Int64()
+			end, _ = numOf(args[1]).Int64()
+			step, _ = numOf(args[2]).Int64()
+		}
+		for i := start; (step > 0 && i < end) || (step < 0 && i > end); i += step {
+			out = append(out, intV(i))
+		}
+		return listV(out, tNum)
+	}
+	panic(evalError{"unknown function " + name})
+}
+
+// ---------------------------------------------------------------------------
+// Spelling expressions in the native syntax.
+
+// Precedence levels (higher binds tighter).
+func precOf(op string) int {
+	switch op {
+	case "||":
+		return 1
+	case "&&":
+		return 2
+	case "==", "!=":
+		return 3
+	case "<", ">", "<=", ">=":
+		return 4
+	case "+", "-":
+		return 5
+	case "*", "/", "%":
+		return 6
+	}
+	panic("bad operator " + op)
+}
+
+func (e *E) prec() int {
+	switch e.op {
+	case "lit":
+		if e.v.k == kNum && strings.HasPrefix(e.v.num, "-") {
+			return 7 // a negative number literal is a negation
+		}
+		return 9
+	case "cond":
+		return 0
+	case "bin":
+		return precOf(e.name)
+	case "un":
+		return 7
+	case "idx", "attr", "splat", "fsplat":
+		return 8
+	default:
+		return 9
+	}
+}
+
+// sp returns the spacing string for the expression's spacing variant.
+func (e *E) space() string {
+	switch e.sp {
+	case 0:
+		return " "
+	case 1:
+		return ""
+	default:
+		return "  "
+	}
+}
+
+// render spells e; minPrec is the lowest precedence allowed without
+// parentheses.
+func render(e *E, minPrec int) string {
+	s := renderBare(e)
+	if e.prec() < minPrec {
+		return "(" + s + ")"
+	}
+	return s
+}
+
+func renderBare(e *E) string {
+	sp := e.space()
+	switch e.op {
+	case "lit":
+		return e.v.native()
+	case "paren":
+		return "(" + sp + render(e.a, 0) + sp + ")"
+	case "var":
+		return e.name
+	case "un":
+		operand := render(e.a, 7)
+		if e.name == "-" && strings.HasPrefix(operand, "-") {
+			return "- " + operand
+		}
+		return e.name + operand
+	case "bin":
+		p := precOf(e.name)
+		left := render(e.a, p)
+		before := sp
+		if e.name == "-" && sp == "" && left != "" && isIdentByte(left[len(left)-1]) {
+			// A `-` glued to an identifier would extend the identifier.
+			before = " "
+		}
+		return left + before + e.name + sp + render(e.b, p+1)
+	case "cond":
+		return render(e.a, 1) + sp + "?" + sp + render(e.b, 0) + sp + ":" + sp + render(e.c, 0)
+	case "idx":
+		return render(e.a, 8) + "[" + sp + render(e.b, 0) + sp + "]"
+	case "attr":
+		return render(e.a, 8) + "." + e.name
+	case "splat", "fsplat":
+		var b strings.Builder
+		b.WriteString(render(e.a, 8))
+		if e.op == "splat" {
+			b.WriteString(".*")
+		} else {
+			b.WriteString("[*]")
+		}
+		for _, st := range e.steps {
+			if st.isIdx {
+				b.WriteString("[" + strconv.Itoa(st.index) + "]")
+			} else {
+				b.WriteString("." + st.attr)
+			}
+		}
+		return b.String()
+	case "fortup", "forobj":
+		var b strings.Builder
+		open, close := "[", "]"
+		if e.op == "forobj" {
+			open, close = "{", "}"
+		}
+		b.WriteString(open + sp + "for ")
+		if e.keyVar != "" {
+			b.WriteString(e.keyVar + "," + sp + e.valVar)
+		} else {
+			b.WriteString(e.valVar)
+		}
+		b.WriteString(" in " + render(e.a, 0) + sp + ":" + sp + render(e.b, 0))
+		if e.op == "forobj" {
+			b.WriteString(sp + "=>" + sp + render(e.args[0], 0))
+			if e.group {
+				b.WriteString("...")
+			}
+		}
+		if e.c != nil {
+			b.WriteString(" if " + render(e.c, 0))
+		}
+		b.WriteString(sp + close)
+		return b.String()
+	case "tmpl":
+		return `"` + renderTemplate(e.parts, false) + `"`
+	case "tuple":
+		parts := make([]string, len(e.args))
+		for i, a := range e.args {
+			parts[i] = render(a, 0)
+		}
+		return "[" + sp + strings.Join(parts, ","+sp) + sp + "]"
+	case "object":
+		parts := make([]string, len(e.args))
+		for i, a := range e.args {
+			parts[i] = nativeKey(e.names[i]) + pick2(e.sp, " = ", ": ") + render(a, 0)
+		}
+		return "{" + sp + strings.Join(parts, ","+sp) + sp + "}"
+	case "call":
+		parts := make([]string, len(e.args))
+		for i, a := range e.args {
+			parts[i] = render(a, 0)
+		}
+		s := e.name + "(" + sp + strings.Join(parts, ","+sp)
+		if e.ellipsis {
+			s += "..."
+		}
+		return s + sp + ")"
+	}
+	panic("bad op " + e.op)
+}
+
+// tmplLit escapes a literal for a quoted template (heredoc=false) or a
+// heredoc body (heredoc=true, where only the template introducers need
+// escaping and newlines are literal).
+func tmplLit(text string, heredoc bool) string {
+	if !heredoc {
+		q := quoteNative(text, false)
+		return q[1 : len(q)-1]
+	}
+	text = strings.ReplaceAll(text, "${", "$${")
+	return strings.ReplaceAll(text, "%{", "%%{")
+}
+
+func seqOpen(kind string, strip bool) string {
+	s := "${"
+	if kind == "ctrl" {
+		s = "%{"
+	}
+	if strip {
+		s += "~"
+	}
+	return s
+}
+
+func seqClose(strip bool) string {
+	if strip {
+		return "~}"
+	}
+	return "}"
+}
+
+// meldLits joins adjacent literal parts (the scanner sees one literal), at
+// every nesting level.
+func meldLits(parts []tpart) []tpart {
+	var out []tpart
+	for _, p := range parts {
+		switch p.kind {
+		case "if":
+			p.then = meldLits(p.then)
+			p.els = meldLits(p.els)
+		case "for":
+			p.body = meldLits(p.body)
+		}
+		if p.kind == "lit" && len(out) > 0 && out[len(out)-1].kind == "lit" {
+			out[len(out)-1].text += p.text
+			continue
+		}
+		out = append(out, p)
+	}
+	return out
+}
+
+// dump spells the model expression tree, for failure messages.
+func (e *E) dump() string {
+	if e == nil {
+		return "_"
+	}
+	var b strings.Builder
+	b.WriteString("(" + e.op)
+	if e.name != "" {
+		b.WriteString(" " + e.name)
+	}
+	if e.op == "lit" {
+		b.WriteString(" " + e.v.native())
+	}
+	for _, c := range []*E{e.a, e.b, e.c} {
+		if c != nil {
+			b.WriteString(" " + c.dump())
+		}
+	}
+	for _, c := range e.args {
+		b.WriteString(" " + c.dump())
+	}
+	for _, p := range e.parts {
+		switch p.kind {
+		case "lit":
+			b.WriteString(" " + strconv.Quote(p.text))
+		case "interp":
+			b.WriteString(" ${" + p.e.dump() + "}")
+		default:
+			b.WriteString(" %{" + p.kind + " " + p.e.dump() + "}")
+		}
+	}
+	b.WriteString(")")
+	return b.String()
+}
+
+func renderTemplate(parts []tpart, heredoc bool) string {
+	return renderTemplateTail(parts, heredoc, false)
+}
+
+// renderTemplateTail spells parts; tailSeq says a control sequence follows
+// the last part (the else/endif/endfor of the enclosing directive).
+func renderTemplateTail(parts []tpart, heredoc bool, tailSeq bool) string {
+	var b strings.Builder
+	parts = meldLits(parts)
+	for i, p := range parts {
+		switch p.kind {
+		case "lit":
+			text := p.text
+			// A literal ending in `$` or `%` right before a sequence would
+			// spell the escape of that sequence: interpolate the character.
+			if (i+1 < len(parts) || tailSeq) && (strings.HasSuffix(text, "$") || strings.HasSuffix(text, "%")) {
+				// All of the trailing `$`/`%` characters go into the
+				// interpolation: a literal `$` right before `${` would spell
+				// the escape `$${`.
+				prefix := strings.TrimRight(text, "$%")
+				b.WriteString(tmplLit(prefix, heredoc))
+				b.WriteString("${" + quoteNative(text[len(prefix):], false) + "}")
+				continue
+			}
+			b.WriteString(tmplLit(text, heredoc))
+		case "interp":
+			b.WriteString(seqOpen("interp", p.strip[0]) + " " + render(p.e, 0) + " " + seqClose(p.strip[1]))
+		case "if":
+			b.WriteString(seqOpen("ctrl", p.strip[0]) + " if " + render(p.e, 0) + " " + seqClose(p.strip[1]))
+			b.WriteString(renderTemplateTail(p.then, heredoc, true))
+			if p.hasEl {
+				b.WriteString(seqOpen("ctrl", p.stripElse[0]) + " else " + seqClose(p.stripElse[1]))
+				b.WriteString(renderTemplateTail(p.els, heredoc, true))
+			}
+			b.WriteString(seqOpen("ctrl", p.stripEnd[0]) + " endif " + seqClose(p.stripEnd[1]))
+		case "for":
+			b.WriteString(seqOpen("ctrl", p.strip[0]) + " for ")
+			if p.kv[0] != "" {
+				b.WriteString(p.kv[0] + ", ")
+			}
+			b.WriteString(p.kv[1] + " in " + render(p.e, 0) + " " + seqClose(p.strip[1]))
+			b.WriteString(renderTemplateTail(p.body, heredoc, true))
+			b.WriteString(seqOpen("ctrl", p.stripEnd[0]) + " endfor " + seqClose(p.stripEnd[1]))
+		}
+	}
+	return b.String()
+}
+
+// applyStrips rewrites the literals of a template according to its strip
+// markers (spaces adjacent to a marker are removed at syntax level), so that
+// the evaluator can ignore the markers. It flattens the syntax order of
+// sequences and literals.
+func applyStrips(parts []tpart) {
+	// Collect the syntax-order sequence of items: literal pointers and
+	// marker pairs.
+	type item struct {
+		lit   *tpart
+		strip [2]bool // marker: strip before (on the preceding literal), strip after (on the following literal)
+	}
+	var items []item
+	var walk func(ps []tpart)
+	walk = func(ps []tpart) {
+		for i := range ps {
+			p := &ps[i]
+			switch p.kind {
+			case "lit":
+				items = append(items, item{lit: p})
+			case "interp":
+				items = append(items, item{strip: p.strip})
+			case "if":
+				items = append(items, item{strip: p.strip})
+				walk(p.then)
+				if p.hasEl {
+					items = append(items, item{strip: p.stripElse})
+					walk(p.els)
+				}
+				items = append(items, item{strip: p.stripEnd})
+			case "for":
+				items = append(items, item{strip: p.strip})
+				walk(p.body)
+				items = append(items, item{strip: p.stripEnd})
+			}
+		}
+	}
+	walk(parts)
+	for i, it := range items {
+		if it.lit != nil {
+			continue
+		}
+		if it.strip[0] && i > 0 && items[i-1].lit != nil {
+			items[i-1].lit.text = strings.TrimRightFunc(items[i-1].lit.text, unicode.IsSpace)
+		}
+		if it.strip[1] && i+1 < len(items) && items[i+1].lit != nil {
+			items[i+1].lit.text = strings.TrimLeftFunc(items[i+1].lit.text, unicode.IsSpace)
+		}
+	}
+}
+
+// freeVars collects the root names of the variable references of e that are
+// not bound by an enclosing for expression or template directive.
+func freeVars(e *E, bound map[string]bool, out map[string]bool) {
+	if e == nil {
+		return
+	}
+	switch e.op {
+	case "var":
+		if !bound[e.name] {
+			out[e.name] = true
+		}
+	case "fortup", "forobj":
+		freeVars(e.a, bound, out)
+		inner := map[string]bool{}
+		for k := range bound {
+			inner[k] = true
+		}
+		inner[e.valVar] = true
+		if e.keyVar != "" {
+			inner[e.keyVar] = true
+		}
+		freeVars(e.b, inner, out)
+		freeVars(e.c, inner, out)
+		for _, a := range e.args {
+			freeVars(a, inner, out)
+		}
+	case "tmpl":
+		freeVarsParts(e.parts, bound, out)
+	default:
+		freeVars(e.a, bound, out)
+		freeVars(e.b, bound, out)
+		freeVars(e.c, bound, out)
+		for _, a := range e.args {
+			freeVars(a, bound, out)
+		}
+	}
+}
+
+func freeVarsParts(parts []tpart, bound map[string]bool, out map[string]bool) {
+	for _, p := range parts {
+		switch p.kind {
+		case "interp":
+			freeVars(p.e, bound, out)
+		case "if":
+			freeVars(p.e, bound, out)
+			freeVarsParts(p.then, bound, out)
+			freeVarsParts(p.els, bound, out)
+		case "for":
+			freeVars(p.e, bound, out)
+			inner := map[string]bool{}
+			for k := range bound {
+				inner[k] = true
+			}
+			inner[p.kv[1]] = true
+			if p.kv[0] != "" {
+				inner[p.kv[0]] = true
+			}
+			freeVarsParts(p.body, inner, out)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The grammar: expression generators over a drawn scope.
+
+// grammar holds the generators of well-typed expressions over one case's
+// scope: a generator per wanted type and depth, memoised so that each exists
+// once per case (a well-typed expression needs the variables it may refer to,
+// so a grammar is built inside a FlatMap over the scope), the live scope (the
+// body of a for expression or directive is drawn with its loop variables
+// bound, and the scope is restored afterwards), the budget of nodes a case
+// may spend, and the loop variable names handed out.
+type grammar struct {
+	sc        *scope
+	budget    int
+	loopVars  int             // fresh names for for-expression variables
+	loopNames map[string]bool // every loop variable name handed out
+	memo      map[string]hegel.Generator[*E]
+	partMemo  map[[2]int]hegel.Generator[[]tpart]
+}
+
+func newGrammar(sc *scope, budget int) *grammar {
+	return &grammar{sc: sc, budget: budget, loopNames: map[string]bool{}, memo: map[string]hegel.Generator[*E]{}, partMemo: map[[2]int]hegel.Generator[[]tpart]{}}
+}
+
+// dynamicType reports whether the type of e may differ between bindings of
+// an enclosing for expression: a for expression with a filter or grouping
+// (whose length or keys depend on values) that refers to a loop variable.
+func (g *grammar) dynamicType(e *E) bool {
+	if e == nil {
+		return false
+	}
+	if (e.op == "fortup" || e.op == "forobj") && (e.c != nil || e.group) && !g.loopFree(e) {
+		return true
+	}
+	for _, c := range []*E{e.a, e.b, e.c} {
+		if g.dynamicType(c) {
+			return true
+		}
+	}
+	for _, c := range e.args {
+		if g.dynamicType(c) {
+			return true
+		}
+	}
+	for _, p := range e.parts {
+		if g.dynamicType(p.e) {
+			return true
+		}
+	}
+	return false
+}
+
+// loopFree reports whether e refers to no loop variable, so that its value
+// is the same under every binding of an enclosing for expression.
+func (g *grammar) loopFree(e *E) bool {
+	free := map[string]bool{}
+	freeVars(e, map[string]bool{}, free)
+	for name := range free {
+		if g.loopNames[name] {
+			return false
+		}
+	}
+	return true
+}
+
+func (g *grammar) spend() bool {
+	g.budget--
+	return g.budget >= 0
+}
+
+// bound runs fn with vars bound in a child scope, the scope restored
+// afterwards (also when a draw inside aborts).
+func (g *grammar) bound(vars map[string]V, fn func()) {
+	saved := g.sc
+	g.sc = saved.child(vars)
+	defer func() { g.sc = saved }()
+	fn()
+}
+
+// hasListValue: v is or contains a list (which has no literal spelling).
+func hasListValue(v V) bool {
+	if v.list {
+		return true
+	}
+	for _, e := range v.elems {
+		if hasListValue(e) {
+			return true
+		}
+	}
+	return false
+}
+
+func hasNull(v V) bool {
+	if v.k == kNull {
+		return true
+	}
+	for _, e := range v.elems {
+		if hasNull(e) {
+			return true
+		}
+	}
+	return false
+}
+
+// spacings: the whitespace variant of a spelled expression, a single space
+// first.
+var spacings = hegel.Map(hegel.Integers(0, 2), func(i int) spacing { return spacing(i) })
+
+// litOf: the literal v with a drawn spacing.
+func litOf(v V) hegel.Generator[*E] {
+	return hegel.Map(spacings, func(sp spacing) *E { return &E{op: "lit", v: v, sp: sp} })
+}
+
+// litsOf: literals of the values drawn from g, with a drawn spacing.
+func litsOf(g hegel.Generator[V]) hegel.Generator[*E] {
+	return hegel.Map(pairs(g, spacings), func(p pair[V, spacing]) *E { return &E{op: "lit", v: p.a, sp: p.b} })
+}
+
+// intLits: integer literals of lo to hi.
+func intLits(lo, hi int) hegel.Generator[*E] {
+	return litsOf(hegel.Map(hegel.Integers(lo, hi), func(i int) V { return intV(int64(i)) }))
+}
+
+// shuffledOrder is the order of n indices sorted by one drawn key each (keys
+// recycled modulo their number; equal keys keep the declared order, so an
+// empty key list is the identity, which is what it shrinks to).
+func shuffledOrder(n int, keys []int) []int {
+	idx := make([]int, n)
+	for i := range idx {
+		idx[i] = i
+	}
+	if len(keys) == 0 {
+		return idx
+	}
+	sort.SliceStable(idx, func(i, j int) bool { return keys[idx[i]%len(keys)] < keys[idx[j]%len(keys)] })
+	return idx
+}
+
+// valuesOfType: values of exactly the type: small integers (or the number
+// pool) for numbers, strings, booleans, a value per element or field for
+// tuples and objects (an object's attributes written in a drawn order), and
+// lists of up to three elements.
+func valuesOfType(t T) hegel.Generator[V] {
+	if t.list {
+		et := *t.elem
+		return hegel.Map(many(valuesOfType(et), 0, 3), func(es []V) V { return listV(es, et) })
+	}
+	switch t.k {
+	case kNum:
+		return weighted(choice[V]{70, hegel.Map(hegel.Integers(-30, 30), func(i int) V { return intV(int64(i)) })}, choice[V]{30, nums})
+	case kStr:
+		return texts
+	case kBool:
+		return bools
+	case kTuple:
+		elemGens := make([]hegel.Generator[V], len(t.elems))
+		for i, et := range t.elems {
+			elemGens[i] = valuesOfType(et)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) V {
+			elems := make([]V, len(elemGens))
+			for i, eg := range elemGens {
+				elems[i] = hegel.Draw(tc, eg)
+			}
+			return tupleV(elems...)
+		})
+	default:
+		fieldGens := make([]hegel.Generator[V], len(t.keys))
+		for i, ft := range t.fields {
+			fieldGens[i] = valuesOfType(ft)
+		}
+		orderKeys := many(positions, 0, len(t.keys))
+		return hegel.Composite(func(tc hegel.TestCase) V {
+			order := shuffledOrder(len(t.keys), hegel.Draw(tc, orderKeys))
+			keys, elems := []string{}, []V{}
+			for _, i := range order {
+				keys = append(keys, t.keys[i])
+				elems = append(elems, hegel.Draw(tc, fieldGens[i]))
+			}
+			return objV(keys, elems)
+		})
+	}
+}
+
+// varsOfType lists the variables in scope whose value has the wanted type.
+func (g *grammar) varsOfType(want *T) []string {
+	var out []string
+	seen := map[string]bool{}
+	for c := g.sc; c != nil; c = c.parent {
+		for name, v := range c.vars {
+			if seen[name] {
+				continue
+			}
+			seen[name] = true
+			if want == nil || typeOf(v).eq(*want) {
+				out = append(out, name)
+			}
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// expr: well-typed expressions whose value has type want (any type when nil),
+// nesting at most depth levels: an atom, or one of the constructions (each
+// yielding nil when it does not fit the wanted type, whereupon an atom stands
+// in), with a drawn spacing.
+func (g *grammar) expr(want *T, depth int) hegel.Generator[*E] {
+	key := "any"
+	if want != nil {
+		key = want.String()
+	}
+	key += "@" + strconv.Itoa(depth)
+	if gen, ok := g.memo[key]; ok {
+		return gen
+	}
+	atoms := g.atoms(want)
+	inner := atoms
+	if depth > 0 {
+		constructions := weighted(
+			choice[*E]{2, atoms},
+			choice[*E]{1, g.parens(want, depth)},
+			choice[*E]{2, g.binaries(want, depth)},
+			choice[*E]{1, g.unaries(want, depth)},
+			choice[*E]{1, g.conditionals(want, depth)},
+			choice[*E]{1, g.indexes(want, depth)},
+			choice[*E]{1, g.getAttrs(want, depth)},
+			choice[*E]{1, g.splats(want, depth)},
+			choice[*E]{1, g.forExprs(want, depth)},
+			choice[*E]{1, g.templates(want, depth)},
+			choice[*E]{2, g.calls(want, depth)},
+		)
+		inner = hegel.Composite(func(tc hegel.TestCase) *E {
+			if !g.spend() {
+				return hegel.Draw(tc, atoms)
+			}
+			if e := hegel.Draw(tc, constructions); e != nil {
+				return e
+			}
+			return hegel.Draw(tc, atoms)
+		})
+	}
+	gen := hegel.Map(pairs(inner, spacings), func(p pair[*E, spacing]) *E {
+		p.a.sp = p.b
+		return p.a
+	})
+	g.memo[key] = gen
+	return gen
+}
+
+// atoms: a variable of the wanted type half of the time when there is one,
+// else a literal (a type holding a list, which has no literal, is spelled by
+// listAtoms).
+func (g *grammar) atoms(want *T) hegel.Generator[*E] {
+	if want != nil && hasListType(*want) {
+		return g.listAtoms(*want)
+	}
+	lits := litsOf(valuesOf(2, false))
+	if want != nil {
+		lits = litsOf(valuesOfType(*want))
+	}
+	useVar := chance(50)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		vars := g.varsOfType(want)
+		if len(vars) > 0 && hegel.Draw(tc, useVar) {
+			return &E{op: "var", name: hegel.Draw(tc, hegel.SampledFrom(vars))}
+		}
+		return hegel.Draw(tc, lits)
+	})
+}
+
+// hasListType: t is or holds a list type (which has no literal spelling).
+func hasListType(t T) bool {
+	if t.list {
+		return true
+	}
+	for _, e := range t.elems {
+		if hasListType(e) {
+			return true
+		}
+	}
+	for _, f := range t.fields {
+		if hasListType(f) {
+			return true
+		}
+	}
+	return false
+}
+
+// listAtoms: an expression of a type holding a list: a variable of the type
+// half of the time when there is one, else a range() call for a list of
+// numbers (a variable for any other list) and a tuple or object constructor
+// of atoms of the element types.
+func (g *grammar) listAtoms(t T) hegel.Generator[*E] {
+	useVar := chance(50)
+	rangeCounts := intLits(0, 4)
+	var elemGens []hegel.Generator[*E]
+	parts := t.elems
+	if t.k == kObj {
+		parts = t.fields
+	}
+	if !t.list {
+		for i := range parts {
+			et := parts[i]
+			elemGens = append(elemGens, g.atoms(&et))
+		}
+	}
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		vars := g.varsOfType(&t)
+		if len(vars) > 0 && hegel.Draw(tc, useVar) {
+			return &E{op: "var", name: hegel.Draw(tc, hegel.SampledFrom(vars))}
+		}
+		if t.list {
+			if t.elem.k == kNum {
+				return callOf("range", hegel.Draw(tc, rangeCounts))
+			}
+			if len(vars) > 0 {
+				return &E{op: "var", name: hegel.Draw(tc, hegel.SampledFrom(vars))}
+			}
+			panic(evalError{"no way to spell a " + t.String()})
+		}
+		args := make([]*E, len(elemGens))
+		for i, eg := range elemGens {
+			args[i] = hegel.Draw(tc, eg)
+		}
+		if t.k == kObj {
+			return &E{op: "object", names: append([]string{}, t.keys...), args: args}
+		}
+		return &E{op: "tuple", args: args}
+	})
+}
+
+func (g *grammar) parens(want *T, depth int) hegel.Generator[*E] {
+	return hegel.Map(g.expr(want, depth-1), func(e *E) *E { return &E{op: "paren", a: e} })
+}
+
+func binOf(op string, a, b *E) *E { return &E{op: "bin", name: op, a: a, b: b} }
+
+// binaries: the binary operators that give the wanted type: arithmetic and
+// division for numbers, equality, ordering and logic for booleans.
+func (g *grammar) binaries(want *T, depth int) hegel.Generator[*E] {
+	var alts []choice[*E]
+	if want == nil || want.k == kNum {
+		alts = append(alts, choice[*E]{3, g.arithmetic(depth)}, choice[*E]{2, g.divisions(depth)})
+	}
+	if want == nil || want.k == kBool {
+		alts = append(alts, choice[*E]{2, g.equalities(depth)}, choice[*E]{4, g.orderings(depth)}, choice[*E]{2, g.logicals(depth)})
+	}
+	if len(alts) == 0 {
+		return hegel.Just[*E](nil)
+	}
+	return weighted(alts...)
+}
+
+// operations: op applied to two operands.
+func operations(ops []string, operands hegel.Generator[*E]) hegel.Generator[*E] {
+	opGen := hegel.SampledFrom(ops)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		return binOf(hegel.Draw(tc, opGen), hegel.Draw(tc, operands), hegel.Draw(tc, operands))
+	})
+}
+
+func (g *grammar) arithmetic(depth int) hegel.Generator[*E] {
+	return operations([]string{"+", "-", "*"}, g.numish(depth-1))
+}
+
+func (g *grammar) orderings(depth int) hegel.Generator[*E] {
+	return operations([]string{"<", "<=", ">", ">="}, g.numish(depth-1))
+}
+
+func (g *grammar) logicals(depth int) hegel.Generator[*E] {
+	return operations([]string{"&&", "||"}, g.boolish(depth-1))
+}
+
+// equalities: == and != between an expression and, six times in ten, one of
+// the same type.
+func (g *grammar) equalities(depth int) hegel.Generator[*E] {
+	ops := hegel.SampledFrom([]string{"==", "!="})
+	anys := g.expr(nil, depth-1)
+	sameType := chance(60)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		op := hegel.Draw(tc, ops)
+		a := hegel.Draw(tc, anys)
+		if hegel.Draw(tc, sameType) {
+			t := typeOf(eval(a, g.sc))
+			return binOf(op, a, hegel.Draw(tc, g.expr(&t, depth-1)))
+		}
+		return binOf(op, a, hegel.Draw(tc, anys))
+	})
+}
+
+// divisions: / and %; a divisor that is zero, or whose value depends on a
+// loop variable, is replaced by a small integer literal, as is the divisor
+// when the result would be rounded at 64 bits (see exact): an inexact
+// quotient of two operands that may both be 64-bit, or a remainder of a
+// possibly 64-bit dividend by a non-integer.
+func (g *grammar) divisions(depth int) hegel.Generator[*E] {
+	ops := hegel.SampledFrom([]string{"/", "%"})
+	nums := g.numish(depth - 1)
+	safe := intLits(1, 7)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		op := hegel.Draw(tc, ops)
+		a := hegel.Draw(tc, nums)
+		b := hegel.Draw(tc, nums)
+		av, bv := numOf(eval(a, g.sc)), numOf(eval(b, g.sc))
+		rounded := false
+		if !g.exact(a) && bv.Sign() != 0 {
+			if op == "/" {
+				rounded = !g.exact(b) && new(big.Float).SetPrec(512).Quo(av, bv).Acc() != big.Exact
+			} else {
+				rounded = !bv.IsInt()
+			}
+		}
+		if bv.Sign() == 0 || !g.loopFree(b) || rounded {
+			b = hegel.Draw(tc, safe)
+		}
+		return binOf(op, a, b)
+	})
+}
+
+// exact reports whether the number e evaluates to certainly has the 512-bit
+// precision of a parsed literal. cty's arithmetic rounds to the widest
+// precision among its operands (a remainder to its dividend's): a literal or
+// a variable is parsed at 512 bits, but the results of length, strlen, range
+// and the like are 64-bit integers (cty.NumberIntVal), so a division of two
+// such results, or a remainder of one by a fraction, is rounded at 64 bits,
+// which the model's 512-bit arithmetic does not reproduce. An expression
+// that is not provably 512-bit (a call, an index into a constructor, a loop
+// variable) counts as possibly 64-bit; with the divisors above, every such
+// value is an integer.
+func (g *grammar) exact(e *E) bool {
+	switch e.op {
+	case "lit":
+		return true
+	case "var":
+		return !g.loopNames[e.name]
+	case "paren":
+		return g.exact(e.a)
+	case "un":
+		return g.exact(e.a)
+	case "bin":
+		return g.exact(e.a) || g.exact(e.b)
+	case "cond":
+		return g.exact(e.b) && g.exact(e.c)
+	case "tmpl":
+		// A string converts to a number by parsing, unless the template is
+		// a single interpolation, which is the value itself.
+		if inner := soleInterp(e.parts); inner != nil {
+			return g.exact(inner)
+		}
+		return true
+	case "call":
+		switch e.name {
+		case "abs":
+			return g.exact(e.args[0])
+		case "max", "min":
+			if e.ellipsis {
+				return false
+			}
+			for _, a := range e.args {
+				if !g.exact(a) {
+					return false
+				}
+			}
+			return true
+		}
+	}
+	return false
+}
+
+// numish: an expression that converts to a number: a number, or (rarely) a
+// string spelling one.
+func (g *grammar) numish(depth int) hegel.Generator[*E] {
+	numStrings := hegel.Map(numTexts, func(s string) V { return strV(canonNum(s)) })
+	return weighted(choice[*E]{92, g.expr(&tNum, depth)}, choice[*E]{8, litsOf(numStrings)})
+}
+
+// boolish: a boolean, or (rarely) a string spelling one.
+func (g *grammar) boolish(depth int) hegel.Generator[*E] {
+	boolStrings := hegel.Map(hegel.Booleans(), func(b bool) V { return strV(strconv.FormatBool(b)) })
+	return weighted(choice[*E]{92, g.expr(&tBool, depth)}, choice[*E]{8, litsOf(boolStrings)})
+}
+
+// unaries: a negation for numbers, a not for booleans, either for any type.
+func (g *grammar) unaries(want *T, depth int) hegel.Generator[*E] {
+	if want != nil && want.k != kNum && want.k != kBool {
+		return hegel.Just[*E](nil)
+	}
+	negs := hegel.Map(g.numish(depth-1), func(a *E) *E { return &E{op: "un", name: "-", a: a} })
+	nots := hegel.Map(g.boolish(depth-1), func(a *E) *E { return &E{op: "un", name: "!", a: a} })
+	switch {
+	case want == nil:
+		return hegel.OneOf(negs, nots)
+	case want.k == kNum:
+		return negs
+	}
+	return nots
+}
+
+// conditionals: a condition and two branches of one type (the second drawn
+// after the first's type; a branch whose type may change with a loop binding
+// gives way to an atom), or, for any type, one time in four two branches of
+// differing primitive types, which unify to string.
+func (g *grammar) conditionals(want *T, depth int) hegel.Generator[*E] {
+	conds := g.boolish(depth - 1)
+	branches := g.expr(want, depth-1)
+	atoms := g.atoms(want)
+	same := hegel.Composite(func(tc hegel.TestCase) *E {
+		c := hegel.Draw(tc, conds)
+		b := hegel.Draw(tc, branches)
+		if g.dynamicType(b) {
+			b = hegel.Draw(tc, atoms)
+		}
+		t := typeOf(eval(b, g.sc))
+		return &E{op: "cond", a: c, b: b, c: hegel.Draw(tc, g.expr(&t, depth-1))}
+	})
+	if want != nil {
+		return same
+	}
+	primitives := hegel.SampledFrom([]T{tNum, tBool})
+	swap := chance(50)
+	unifying := hegel.Composite(func(tc hegel.TestCase) *E {
+		c := hegel.Draw(tc, conds)
+		t1, t2 := hegel.Draw(tc, primitives), tStr
+		if hegel.Draw(tc, swap) {
+			t1, t2 = t2, t1
+		}
+		return &E{op: "cond", a: c, b: hegel.Draw(tc, g.expr(&t1, depth-1)), c: hegel.Draw(tc, g.expr(&t2, depth-1))}
+	})
+	return weighted(choice[*E]{75, same}, choice[*E]{25, unifying})
+}
+
+// collPick: a collection expression and the key of one of its elements (of
+// the wanted type).
+type collPick struct {
+	coll    *E
+	key     V
+	isTuple bool
+}
+
+// collKeys: an object constructor's attribute names.
+var collKeys = weighted(choice[string]{80, idents}, choice[string]{20, strs})
+
+// collections: a tuple or object expression with an element of the wanted
+// type at a known key: half of the time an existing expression that is one
+// (the element found from a drawn position on), else a constructor built
+// around an expression of the wanted type at a drawn position among up to
+// two others.
+func (g *grammar) collections(want *T, depth int) hegel.Generator[collPick] {
+	anys := g.expr(nil, depth-1)
+	inners := g.expr(want, depth-1)
+	others := many(g.expr(nil, depth-2), 0, 2)
+	fits := func(v V) bool { return want == nil || typeOf(v).eq(*want) }
+	existing := hegel.Composite(func(tc hegel.TestCase) *collPick {
+		e := hegel.Draw(tc, anys)
+		v := eval(e, g.sc)
+		if g.dynamicType(e) {
+			v = V{} // its shape may change with the binding: build a constructor instead
+		}
+		start := hegel.Draw(tc, positions)
+		switch v.k {
+		case kTuple:
+			for j := range v.elems {
+				i := (start + j) % len(v.elems)
+				if fits(v.elems[i]) {
+					return &collPick{e, intV(int64(i)), true}
+				}
+			}
+		case kObj:
+			for j := range v.keys {
+				i := (start + j) % len(v.keys)
+				if fits(v.elems[i]) {
+					return &collPick{e, strV(v.keys[i]), false}
+				}
+			}
+		}
+		return nil
+	})
+	asObject := chance(50)
+	built := hegel.Composite(func(tc hegel.TestCase) collPick {
+		inner := hegel.Draw(tc, inners)
+		rest := hegel.Draw(tc, others)
+		pos := hegel.Draw(tc, positions) % (len(rest) + 1)
+		elems := append(append(append([]*E{}, rest[:pos]...), inner), rest[pos:]...)
+		if !hegel.Draw(tc, asObject) {
+			return collPick{&E{op: "tuple", args: elems}, intV(int64(pos)), true}
+		}
+		keys := hegel.Draw(tc, many(collKeys, len(elems), len(elems)))
+		names, args := []string{}, []*E{}
+		chosen, found := "", false
+		seen := map[string]bool{}
+		for i, k := range keys {
+			if seen[k] {
+				continue // a repeated name drops its element
+			}
+			seen[k] = true
+			names = append(names, k)
+			args = append(args, elems[i])
+			if i == pos {
+				chosen, found = k, true
+			}
+		}
+		if !found {
+			chosen, args[0] = names[0], inner
+		}
+		return collPick{&E{op: "object", names: names, args: args}, strV(chosen), false}
+	})
+	useExisting := chance(50)
+	return hegel.Composite(func(tc hegel.TestCase) collPick {
+		if hegel.Draw(tc, useExisting) {
+			if p := hegel.Draw(tc, existing); p != nil {
+				return *p
+			}
+		}
+		return hegel.Draw(tc, built)
+	})
+}
+
+// noSplatTail parenthesises a splat so that an index or attribute after it
+// applies to the result rather than becoming a step of the splat.
+func noSplatTail(coll *E) *E {
+	if coll.op == "splat" || coll.op == "fsplat" {
+		return &E{op: "paren", a: coll}
+	}
+	return coll
+}
+
+// indexes: coll[key]: a tuple's key is its position, spelled as the literal
+// (seven times in ten, and whenever the drawn number expression is not a
+// small loop-free integer) or as that expression minus the difference; an
+// object's key is the name, as a literal or as a template of it.
+func (g *grammar) indexes(want *T, depth int) hegel.Generator[*E] {
+	colls := g.collections(want, depth)
+	numKeys := g.expr(&tNum, depth-2)
+	plain := chance(70)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		p := hegel.Draw(tc, colls)
+		coll := noSplatTail(p.coll)
+		if p.isTuple {
+			keyE := hegel.Draw(tc, numKeys)
+			kv := numOf(eval(keyE, g.sc))
+			if hegel.Draw(tc, plain) || !g.loopFree(keyE) || !kv.IsInt() || kv.Cmp(big.NewFloat(1e6)) > 0 || kv.Cmp(big.NewFloat(-1e6)) < 0 {
+				return &E{op: "idx", a: coll, b: hegel.Draw(tc, litOf(p.key))}
+			}
+			i, _ := numOf(p.key).Int64()
+			k, _ := kv.Int64()
+			return &E{op: "idx", a: coll, b: binOf("-", keyE, hegel.Draw(tc, litOf(intV(k-i))))}
+		}
+		if hegel.Draw(tc, plain) {
+			return &E{op: "idx", a: coll, b: hegel.Draw(tc, litOf(p.key))}
+		}
+		return &E{op: "idx", a: coll, b: &E{op: "tmpl", parts: []tpart{{kind: "lit", text: p.key.s}}}}
+	})
+}
+
+// getAttrs: coll.name on an object (coll["name"] when the name is not an
+// identifier); on a tuple, half of the time the legacy index coll.N (not
+// after a splat or another legacy index, where it would read differently).
+func (g *grammar) getAttrs(want *T, depth int) hegel.Generator[*E] {
+	colls := g.collections(want, depth)
+	legacy := chance(50)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		p := hegel.Draw(tc, colls)
+		coll := noSplatTail(p.coll)
+		if p.isTuple {
+			if hegel.Draw(tc, legacy) && coll.op != "splat" && coll.op != "fsplat" && !(coll.op == "attr" && isDigits(coll.name)) {
+				return &E{op: "attr", a: coll, name: p.key.num}
+			}
+			return nil
+		}
+		if !isIdent(p.key.s) || keywords[p.key.s] {
+			return &E{op: "idx", a: coll, b: hegel.Draw(tc, litOf(p.key))}
+		}
+		return &E{op: "attr", a: coll, name: p.key.s}
+	})
+}
+
+// splats: src.* or src[*] over a tuple (or a single value, coerced) followed
+// by up to three steps that every element has (attribute names, or for a
+// full splat indexes), chosen by drawn positions; nil over a list, on a
+// splat, or when the result has not the wanted type.
+func (g *grammar) splats(want *T, depth int) hegel.Generator[*E] {
+	srcs := g.expr(nil, depth-1)
+	kinds := hegel.SampledFrom([]string{"splat", "fsplat"})
+	stepPicks := many(positions, 0, 3)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		src := hegel.Draw(tc, srcs)
+		v := eval(src, g.sc)
+		if v.list {
+			return nil // a splat over a list yields a list; the model keeps to tuples here
+		}
+		if src.op == "splat" || src.op == "fsplat" {
+			return nil // a splat directly on a splat is a syntax error by design (v2.24)
+		}
+		var items []V
+		switch v.k {
+		case kTuple:
+			items = v.elems
+		case kObj, kNum, kStr, kBool:
+			items = []V{v}
+		default:
+			return nil
+		}
+		e := &E{op: hegel.Draw(tc, kinds), a: src}
+		if len(items) == 0 {
+			if want != nil && !want.eq(T{k: kTuple, elems: []T{}}) {
+				return nil
+			}
+			return e
+		}
+		cur := items
+	steps:
+		for _, pick := range hegel.Draw(tc, stepPicks) {
+			first := cur[0]
+			var st splatStep
+			switch first.k {
+			case kObj:
+				if len(first.keys) == 0 {
+					break steps
+				}
+				k := first.keys[pick%len(first.keys)]
+				if !isIdent(k) || keywords[k] {
+					break steps
+				}
+				st = splatStep{attr: k}
+			case kTuple:
+				if e.op == "splat" || len(first.elems) == 0 {
+					break steps
+				}
+				st = splatStep{isIdx: true, index: pick % len(first.elems)}
+			default:
+				break steps
+			}
+			var next []V
+			for _, it := range cur {
+				if st.isIdx {
+					if it.k != kTuple || st.index >= len(it.elems) {
+						break steps
+					}
+					next = append(next, it.elems[st.index])
+				} else {
+					nv, ok := objGet(it, st.attr)
+					if !ok {
+						break steps
+					}
+					next = append(next, nv)
+				}
+			}
+			e.steps = append(e.steps, st)
+			cur = next
+		}
+		if want != nil && !typeOf(tupleV(cur...)).eq(*want) {
+			return nil
+		}
+		return e
+	})
+}
+
+var loopNamePieces = hegel.SampledFrom([]string{"v", "item", "el", "k-v", "\u03b6"})
+
+// freshVar hands out a loop variable name no expression of the case uses
+// elsewhere.
+func (g *grammar) freshVar(tc hegel.TestCase) string {
+	g.loopVars++
+	name := hegel.Draw(tc, loopNamePieces) + strconv.Itoa(g.loopVars)
+	g.loopNames[name] = true
+	return name
+}
+
+// iterPick: an expression over a homogeneous tuple or object and the common
+// element type (T{} for an empty collection).
+type iterPick struct {
+	coll *E
+	et   T
+}
+
+// iterables: an expression that is a homogeneous collection, or when the
+// drawn one is not, a tuple constructor of one to three expressions of one
+// drawn type.
+func (g *grammar) iterables(depth int) hegel.Generator[iterPick] {
+	anys := g.expr(nil, depth-1)
+	elemTypes := hegel.Map(valuesOf(2, false), typeOf)
+	return hegel.Composite(func(tc hegel.TestCase) iterPick {
+		coll := hegel.Draw(tc, anys)
+		v := eval(coll, g.sc)
+		if v.k == kTuple || v.k == kObj {
+			if len(v.elems) == 0 {
+				return iterPick{coll, T{}}
+			}
+			if et, ok := typeOf(v).homogeneous(); ok {
+				return iterPick{coll, et}
+			}
+		}
+		et := hegel.Draw(tc, elemTypes)
+		return iterPick{&E{op: "tuple", args: hegel.Draw(tc, many(g.expr(&et, depth-2), 1, 3))}, et}
+	})
+}
+
+// forExprs: [for v in coll : body] and {for k, v in coll : key => value...}
+// over an iterable, the body drawn with the loop variables bound to a sample
+// element (the first, or a value of the element type when empty); an object
+// result groups (`...`) unless its keys are the unique key variable; a filter
+// four times in ten. Nil when the result does not evaluate or has not the
+// wanted type.
+func (g *grammar) forExprs(want *T, depth int) hegel.Generator[*E] {
+	iters := g.iterables(depth)
+	kinds := hegel.SampledFrom([]string{"fortup", "forobj"})
+	withKey, grouping, keyed, filtered := chance(50), chance(30), chance(60), chance(40)
+	conds := g.boolish(depth - 1)
+	return hegel.Composite(func(tc hegel.TestCase) (out *E) {
+		it := hegel.Draw(tc, iters)
+		coll, et := it.coll, it.et
+		v := eval(coll, g.sc)
+		e := &E{op: hegel.Draw(tc, kinds), a: coll, valVar: g.freshVar(tc)}
+		if hegel.Draw(tc, withKey) {
+			e.keyVar = g.freshVar(tc)
+		}
+		// Bind the loop variables to a sample element to type the body.
+		sample := map[string]V{}
+		if len(v.elems) > 0 {
+			sample[e.valVar] = v.elems[0]
+			if e.keyVar != "" {
+				if v.k == kTuple {
+					sample[e.keyVar] = intV(0)
+				} else {
+					sample[e.keyVar] = strV(v.keys[0])
+				}
+			}
+		} else {
+			sample[e.valVar] = hegel.Draw(tc, valuesOfType(et))
+			if e.keyVar != "" {
+				sample[e.keyVar] = intV(0)
+			}
+		}
+		fits := true
+		g.bound(sample, func() {
+			if e.op == "fortup" {
+				var bodyWant *T
+				if want != nil {
+					if want.k != kTuple {
+						fits = false
+						return
+					}
+					if bt, ok := want.homogeneous(); ok {
+						bodyWant = &bt
+					} else if len(want.elems) > 0 {
+						fits = false
+						return
+					}
+				}
+				e.b = hegel.Draw(tc, g.expr(bodyWant, depth-1))
+			} else {
+				// Keys: distinct strings unless grouping.
+				e.group = hegel.Draw(tc, grouping)
+				if e.keyVar != "" && hegel.Draw(tc, keyed) {
+					// The key variable is unique per element: as a string it stays so.
+					if v.k == kTuple {
+						e.b = &E{op: "tmpl", parts: []tpart{{kind: "lit", text: "k"}, {kind: "interp", e: &E{op: "var", name: e.keyVar}}}}
+					} else {
+						e.b = &E{op: "var", name: e.keyVar}
+					}
+				} else {
+					// Any other key may repeat between elements, so group.
+					e.group = true
+					e.b = hegel.Draw(tc, g.expr(&tStr, depth-1))
+				}
+				e.args = []*E{hegel.Draw(tc, g.expr(nil, depth-1))}
+			}
+			if hegel.Draw(tc, filtered) {
+				e.c = hegel.Draw(tc, conds)
+			}
+		})
+		if !fits {
+			return nil
+		}
+		// Check the result type when one is wanted, and that evaluation is total.
+		res, err := tryEval(e, g.sc)
+		if err != nil {
+			return nil
+		}
+		if want != nil && !typeOf(res).eq(*want) {
+			return nil
+		}
+		return e
+	})
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func isIdentByte(b byte) bool {
+	return b == '_' || b == '-' || b >= 0x80 || (b >= '0' && b <= '9') || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
+}
+
+func tryEval(e *E, sc *scope) (v V, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			if ee, ok := r.(evalError); ok {
+				err = ee
+				return
+			}
+			panic(r)
+		}
+	}()
+	return eval(e, sc), nil
+}
+
+// stripPairs: the strip markers of a template sequence, none three times in
+// four.
+var stripPairs = weighted(
+	choice[[2]bool]{75, hegel.Just([2]bool{})},
+	choice[[2]bool]{25, hegel.Map(pairs(chance(50), chance(50)), func(p pair[bool, bool]) [2]bool { return [2]bool{p.a, p.b} })},
+)
+
+// templates: for a string (or any type) a quoted template of drawn parts
+// whose value is a string (a lone interpolation gets a literal beside it, so
+// that it does not unwrap; empty templates get a string); for another type,
+// half of the time a template of a single interpolation of that type, which
+// unwraps to it.
+func (g *grammar) templates(want *T, depth int) hegel.Generator[*E] {
+	if want != nil && want.k != kStr {
+		unwrapped := hegel.Map(g.expr(want, depth-1), func(inner *E) *E {
+			return &E{op: "tmpl", parts: []tpart{{kind: "interp", e: inner}}}
+		})
+		return weighted(choice[*E]{50, hegel.Just[*E](nil)}, choice[*E]{50, unwrapped})
+	}
+	parts := g.templateParts(depth-1, 0)
+	fillers := hegel.SampledFrom([]string{" ", "x", "-", "$"})
+	hard := hegel.SampledFrom([]string{"x", "-"})
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		ps := meldLits(hegel.Draw(tc, parts))
+		if len(ps) > 0 && ps[0].kind == "lit" && ps[0].text == "" {
+			ps = ps[1:]
+		}
+		if len(ps) > 0 && ps[len(ps)-1].kind == "lit" && ps[len(ps)-1].text == "" {
+			ps = ps[:len(ps)-1]
+		}
+		if len(ps) == 1 && ps[0].kind == "interp" {
+			// Would unwrap: make it a string with a literal beside it.
+			ps = append(ps, tpart{kind: "lit", text: hegel.Draw(tc, fillers)})
+		}
+		if len(ps) == 0 {
+			ps = []tpart{{kind: "lit", text: hegel.Draw(tc, strs)}}
+		}
+		ps = meldLits(ps)
+		applyStrips(ps)
+		if soleInterp(ps) != nil {
+			// The strip markers ate the literal beside the interpolation: add
+			// one they cannot strip.
+			ps = append(ps, tpart{kind: "lit", text: hegel.Draw(tc, hard)})
+		}
+		return &E{op: "tmpl", parts: ps}
+	})
+}
+
+// templateLitPool: literals with whitespace and stray template characters,
+// beside the string pool.
+var templateLitPool = hegel.SampledFrom([]string{" ", "  ", " x ", "\t", "a b", "\u00a0", "\u3000", "~", "~}", "%", "$"})
+
+// templateParts: up to four parts of a template: literals and interpolations
+// three times each, and below two levels of nesting an if directive and a
+// for directive once each (a directive that does not fit is dropped).
+func (g *grammar) templateParts(depth, nesting int) hegel.Generator[[]tpart] {
+	key := [2]int{depth, nesting}
+	if gen, ok := g.partMemo[key]; ok {
+		return gen
+	}
+	lits := hegel.Map(weighted(choice[string]{60, strs}, choice[string]{40, templateLitPool}), func(s string) *tpart {
+		return &tpart{kind: "lit", text: s}
+	})
+	types := hegel.SampledFrom([]T{tStr, tNum, tBool})
+	interps := hegel.Composite(func(tc hegel.TestCase) *tpart {
+		t := hegel.Draw(tc, types)
+		return &tpart{kind: "interp", e: hegel.Draw(tc, g.expr(&t, depth-1)), strip: hegel.Draw(tc, stripPairs)}
+	})
+	alts := []choice[*tpart]{{3, lits}, {3, interps}}
+	if nesting < 2 {
+		alts = append(alts, choice[*tpart]{1, g.ifParts(depth, nesting)}, choice[*tpart]{1, g.forParts(depth, nesting)})
+	}
+	gen := hegel.Map(many(weighted(alts...), 0, 4), func(ps []*tpart) []tpart {
+		var out []tpart
+		for _, p := range ps {
+			if p != nil {
+				out = append(out, *p)
+			}
+		}
+		return out
+	})
+	g.partMemo[key] = gen
+	return gen
+}
+
+// ifParts: %{ if c }...%{ else }...%{ endif }, the else six times in ten.
+func (g *grammar) ifParts(depth, nesting int) hegel.Generator[*tpart] {
+	conds := g.boolish(depth - 1)
+	inner := g.templateParts(depth-1, nesting+1)
+	hasElse := chance(60)
+	return hegel.Composite(func(tc hegel.TestCase) *tpart {
+		p := &tpart{kind: "if", e: hegel.Draw(tc, conds), strip: hegel.Draw(tc, stripPairs), stripEnd: hegel.Draw(tc, stripPairs)}
+		p.then = hegel.Draw(tc, inner)
+		if hegel.Draw(tc, hasElse) {
+			p.hasEl = true
+			p.stripElse = hegel.Draw(tc, stripPairs)
+			p.els = hegel.Draw(tc, inner)
+		}
+		return p
+	})
+}
+
+// forParts: %{ for k, v in coll }...%{ endfor } over an iterable of
+// primitives, the body drawn with the loop variables bound; nil over other
+// element types.
+func (g *grammar) forParts(depth, nesting int) hegel.Generator[*tpart] {
+	iters := g.iterables(depth)
+	inner := g.templateParts(depth-1, nesting+1)
+	withKey := chance(50)
+	return hegel.Composite(func(tc hegel.TestCase) *tpart {
+		it := hegel.Draw(tc, iters)
+		coll, et := it.coll, it.et
+		if et.k != kNum && et.k != kStr && et.k != kBool && et.k != kNull {
+			return nil
+		}
+		p := &tpart{kind: "for", e: coll, strip: hegel.Draw(tc, stripPairs), stripEnd: hegel.Draw(tc, stripPairs)}
+		p.kv[1] = g.freshVar(tc)
+		if hegel.Draw(tc, withKey) {
+			p.kv[0] = g.freshVar(tc)
+		}
+		v := eval(coll, g.sc)
+		sample := map[string]V{}
+		if len(v.elems) > 0 {
+			sample[p.kv[1]] = v.elems[0]
+		} else {
+			sample[p.kv[1]] = strV("")
+		}
+		if p.kv[0] != "" {
+			sample[p.kv[0]] = intV(0)
+			if v.k == kObj && len(v.keys) > 0 {
+				sample[p.kv[0]] = strV(v.keys[0])
+			}
+		}
+		g.bound(sample, func() { p.body = hegel.Draw(tc, inner) })
+		return p
+	})
+}
+
+// asciiSimple reports whether every grapheme of s is one code point.
+func asciiSimple(s string) bool {
+	for _, r := range s {
+		if r >= 0x300 || r == '\r' {
+			return false
+		}
+	}
+	return true
+}
+
+func callOf(name string, args ...*E) *E { return &E{op: "call", name: name, args: args} }
+
+// calls: a call of one of the modelled functions whose result can have the
+// wanted type, evaluated by the model to check that it is total and of the
+// type (nil otherwise).
+func (g *grammar) calls(want *T, depth int) hegel.Generator[*E] {
+	var alts []hegel.Generator[*E]
+	if want == nil || want.k == kStr {
+		alts = append(alts, g.unaryCalls("upper", tStr, depth), g.unaryCalls("lower", tStr, depth), g.joinCalls(depth))
+	}
+	if want == nil || want.k == kNum {
+		alts = append(alts, g.strlenCalls(depth), g.lengthCalls(depth), g.extremumCalls("max", depth), g.extremumCalls("min", depth), g.unaryCalls("abs", tNum, depth))
+	}
+	if want == nil || want.k == kTuple {
+		alts = append(alts, g.concatCalls(depth), g.keysCalls(depth), rangeCalls)
+	}
+	if want == nil || want.k == kBool {
+		alts = append(alts, g.containsCalls(depth))
+	}
+	alts = append(alts, g.elementCalls(want, depth))
+	return hegel.Map(hegel.OneOf(alts...), func(e *E) *E {
+		if e == nil {
+			return nil
+		}
+		if _, err := tryEval(e, g.sc); err != nil {
+			return nil
+		}
+		if want != nil && !typeOf(eval(e, g.sc)).eq(*want) {
+			return nil
+		}
+		return e
+	})
+}
+
+// unaryCalls: name(x) over an argument of the type.
+func (g *grammar) unaryCalls(name string, arg T, depth int) hegel.Generator[*E] {
+	return hegel.Map(g.expr(&arg, depth-1), func(a *E) *E { return callOf(name, a) })
+}
+
+// strlenCalls: strlen(s) over a string whose graphemes are single code points
+// and whose value does not depend on a loop variable.
+func (g *grammar) strlenCalls(depth int) hegel.Generator[*E] {
+	return hegel.Map(g.expr(&tStr, depth-1), func(s *E) *E {
+		if !asciiSimple(eval(s, g.sc).s) || !g.loopFree(s) {
+			return nil
+		}
+		return callOf("strlen", s)
+	})
+}
+
+// lengthCalls: length(t) over a tuple.
+func (g *grammar) lengthCalls(depth int) hegel.Generator[*E] {
+	return hegel.Map(g.iterables(depth), func(it iterPick) *E {
+		if eval(it.coll, g.sc).k != kTuple {
+			return nil
+		}
+		return callOf("length", it.coll)
+	})
+}
+
+// extremumCalls: max or min of one to three numbers, three times in ten with
+// a tuple of numbers expanded (`max(a, [1, 2]...)`).
+func (g *grammar) extremumCalls(name string, depth int) hegel.Generator[*E] {
+	args := many(g.expr(&tNum, depth-1), 1, 3)
+	expanded := many(g.expr(&tNum, depth-2), 1, 3)
+	expand := chance(30)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		e := callOf(name, hegel.Draw(tc, args)...)
+		if hegel.Draw(tc, expand) {
+			e.args = append(e.args, &E{op: "tuple", args: hegel.Draw(tc, expanded)})
+			e.ellipsis = true
+		}
+		return e
+	})
+}
+
+// concatCalls: concat of one to three tuples (lists must share their element
+// type).
+func (g *grammar) concatCalls(depth int) hegel.Generator[*E] {
+	return hegel.Map(many(g.iterables(depth), 1, 3), func(its []iterPick) *E {
+		e := callOf("concat")
+		var lists int
+		var firstET T
+		for _, it := range its {
+			v := eval(it.coll, g.sc)
+			if v.k != kTuple {
+				return nil
+			}
+			if v.list {
+				if lists == 0 {
+					firstET = v.et
+				} else if !firstET.eq(v.et) {
+					return nil
+				}
+				lists++
+			}
+			e.args = append(e.args, it.coll)
+		}
+		return e
+	})
+}
+
+// joinCalls: join(sep, t) over a tuple of primitives.
+func (g *grammar) joinCalls(depth int) hegel.Generator[*E] {
+	iters := g.iterables(depth)
+	seps := g.expr(&tStr, depth-1)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		it := hegel.Draw(tc, iters)
+		if eval(it.coll, g.sc).k != kTuple || (it.et.k != kStr && it.et.k != kNum && it.et.k != kBool && it.et.k != kNull) {
+			return nil
+		}
+		return callOf("join", hegel.Draw(tc, seps), it.coll)
+	})
+}
+
+// keysCalls: keys(o) over an object.
+func (g *grammar) keysCalls(depth int) hegel.Generator[*E] {
+	return hegel.Map(g.iterables(depth), func(it iterPick) *E {
+		if eval(it.coll, g.sc).k != kObj {
+			return nil
+		}
+		return callOf("keys", it.coll)
+	})
+}
+
+// rangeCalls: range(end), range(start, end) or range(start, end, step), the
+// end never before the start in the step's direction.
+var rangeCalls = func() hegel.Generator[*E] {
+	starts, spans := hegel.Integers(-3, 5), hegel.Integers(0, 5)
+	steps := weighted(choice[int]{50, hegel.Just(1)}, choice[int]{50, hegel.SampledFrom([]int{1, 2, -1, 3, -2})})
+	oneArg := hegel.Map(intLits(0, 5), func(end *E) *E { return callOf("range", end) })
+	twoArgs := hegel.Composite(func(tc hegel.TestCase) *E {
+		start, span := hegel.Draw(tc, starts), hegel.Draw(tc, spans)
+		return callOf("range", hegel.Draw(tc, litOf(intV(int64(start)))), hegel.Draw(tc, litOf(intV(int64(start+span)))))
+	})
+	threeArgs := hegel.Composite(func(tc hegel.TestCase) *E {
+		start, span, step := hegel.Draw(tc, starts), hegel.Draw(tc, spans), hegel.Draw(tc, steps)
+		end := start + span
+		if step < 0 {
+			end = start - span
+		}
+		return callOf("range", hegel.Draw(tc, litOf(intV(int64(start)))), hegel.Draw(tc, litOf(intV(int64(end)))), hegel.Draw(tc, litOf(intV(int64(step)))))
+	})
+	return hegel.OneOf(oneArg, twoArgs, threeArgs)
+}()
+
+// containsCalls: contains(t, x) over a tuple with a needle that is one of its
+// elements (at a drawn position) or an expression of the element type.
+func (g *grammar) containsCalls(depth int) hegel.Generator[*E] {
+	iters := g.iterables(depth)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		it := hegel.Draw(tc, iters)
+		v := eval(it.coll, g.sc)
+		if v.k != kTuple || it.et.k == kNull {
+			return nil
+		}
+		pick := hegel.Draw(tc, positions) % (len(v.elems) + 1)
+		if pick < len(v.elems) && !hasListValue(v.elems[pick]) {
+			return callOf("contains", it.coll, hegel.Draw(tc, litOf(v.elems[pick])))
+		}
+		et := it.et
+		return callOf("contains", it.coll, hegel.Draw(tc, g.expr(&et, depth-1)))
+	})
+}
+
+// elementCalls: element(t, i) over a non-empty tuple of the wanted element
+// type, with an index of 0 to 9 (wrapping).
+func (g *grammar) elementCalls(want *T, depth int) hegel.Generator[*E] {
+	iters := g.iterables(depth)
+	indexes := intLits(0, 9)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		it := hegel.Draw(tc, iters)
+		v := eval(it.coll, g.sc)
+		if v.k != kTuple || len(v.elems) == 0 {
+			return nil
+		}
+		if want != nil && !it.et.eq(*want) {
+			return nil
+		}
+		return callOf("element", it.coll, hegel.Draw(tc, indexes))
+	})
+}
+
+// staticExprs: an expression the static analysis helpers understand: a tuple
+// or object constructor, a variable, an attribute access, an index or a call
+// (a tuple around an expression when the drawn construction does not fit).
+func (g *grammar) staticExprs(depth int) hegel.Generator[*E] {
+	tuples := hegel.Map(many(g.expr(nil, depth-1), 0, 3), func(args []*E) *E { return &E{op: "tuple", args: args} })
+	objects := hegel.Map(many(pairs(collKeys, g.expr(nil, depth-1)), 0, 3), func(ps []pair[string, *E]) *E {
+		e := &E{op: "object"}
+		seen := map[string]bool{}
+		for _, p := range ps {
+			if seen[p.a] {
+				continue
+			}
+			seen[p.a] = true
+			e.names = append(e.names, p.a)
+			e.args = append(e.args, p.b)
+		}
+		return e
+	})
+	vars := hegel.Composite(func(tc hegel.TestCase) *E {
+		names := g.varsOfType(nil)
+		if len(names) == 0 {
+			return nil
+		}
+		return &E{op: "var", name: hegel.Draw(tc, hegel.SampledFrom(names))}
+	})
+	constructions := weighted(
+		choice[*E]{2, tuples},
+		choice[*E]{2, objects},
+		choice[*E]{2, vars},
+		choice[*E]{2, g.getAttrs(nil, depth)},
+		choice[*E]{2, g.indexes(nil, depth)},
+		choice[*E]{2, g.calls(nil, depth)},
+	)
+	fallback := g.expr(nil, 1)
+	return hegel.Composite(func(tc hegel.TestCase) *E {
+		e := hegel.Draw(tc, constructions)
+		if e == nil {
+			e = &E{op: "tuple", args: []*E{hegel.Draw(tc, fallback)}}
+		}
+		e.sp = hegel.Draw(tc, spacings)
+		return e
+	})
+}
+
+// ---------------------------------------------------------------------------
+// The environment of a test case: variables with random values.
+
+var varPool = []string{"a", "b", "foo", "bar_baz", "x1", "with-dash", "_u", "name", "count", "tags", "\u03bb", "in_", "true_"}
+
+// envs: the variables of a case: each name of the pool bound seven times in
+// ten to a value without nulls.
+var envs = func() hegel.Generator[*scope] {
+	values := optional(70, valuesOf(2, false))
+	return hegel.Composite(func(tc hegel.TestCase) *scope {
+		vars := map[string]V{}
+		for _, name := range varPool {
+			if v := hegel.Draw(tc, values); v != nil {
+				vars[name] = *v
+			}
+		}
+		return &scope{vars: vars}
+	})
+}()
+
+func evalContext(sc *scope) *hcl.EvalContext {
+	ctx := &hcl.EvalContext{Variables: map[string]cty.Value{}, Functions: funcTable}
+	for name, v := range sc.vars {
+		ctx.Variables[name] = v.cty()
+	}
+	return ctx
+}
+
+func pick2(sp spacing, a, b string) string {
+	if sp == 2 {
+		return b
+	}
+	return a
+}
+
+// exprCase: a scope and an expression over it.
+type exprCase struct {
+	sc *scope
+	e  *E
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c exprCase) GoString() string {
+	return fmt.Sprintf("expression: %s\nvariables:\n%s", render(c.e, 0), c.sc.describe())
+}
+
+// exprCases: a scope and a well-typed expression of depth one to four over
+// it, from a grammar built for the case.
+var exprCases = hegel.FlatMap(envs, func(sc *scope) hegel.Generator[exprCase] {
+	g := newGrammar(sc, 40)
+	return hegel.FlatMap(hegel.Integers(1, 4), func(depth int) hegel.Generator[exprCase] {
+		return hegel.Map(g.expr(nil, depth), func(e *E) exprCase { return exprCase{sc, e} })
+	})
+})
+
+// staticCases: a scope and an expression of depth one to three the static
+// analysis helpers understand.
+var staticCases = hegel.FlatMap(envs, func(sc *scope) hegel.Generator[exprCase] {
+	g := newGrammar(sc, 40)
+	return hegel.FlatMap(hegel.Integers(1, 3), func(depth int) hegel.Generator[exprCase] {
+		return hegel.Map(g.staticExprs(depth), func(e *E) exprCase { return exprCase{sc, e} })
+	})
+})
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// TestHegelExpressionsEvaluateAsTheSpecSays: a well-typed generated
+// expression, spelled in the native syntax, parses and evaluates to the
+// model's value; spelled as a JSON string template "${...}", the JSON syntax
+// agrees.
+func TestHegelExpressionsEvaluateAsTheSpecSays(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, exprCases)
+		want, err := tryEval(c.e, c.sc)
+		ht.Assume(err == nil)
+		src := render(c.e, 0)
+		note(ht, "expected: %#v", want.cty())
+		expr := parseExpr(ht, src)
+		ctx := evalContext(c.sc)
+		got, diags := expr.Value(ctx)
+		if diags.HasErrors() {
+			fail(ht, "hclsyntax evaluation fails:\n%s\nexpected %#v\n  %s", src, want.cty(), diagText(diags))
+		}
+		if !sameValue(got, want.cty()) {
+			fail(ht, "hclsyntax value differs from the model:\n%s\n     got %#v\nexpected %#v", src, got, want.cty())
+		}
+		// The same expression inside a JSON string template.
+		if strings.ContainsAny(src, "\n") {
+			return
+		}
+		jsrc := quoteJSONRaw("${" + src + "}")
+		jexpr, diags := json.ParseExpression([]byte(jsrc), "gen.json")
+		if diags.HasErrors() {
+			fail(ht, "json.ParseExpression rejects:\n%s\n  %s", jsrc, diagText(diags))
+		}
+		jgot, diags := jexpr.Value(ctx)
+		if diags.HasErrors() {
+			fail(ht, "json evaluation fails:\n%s\nexpected %#v\n  %s", jsrc, want.cty(), diagText(diags))
+		}
+		if !sameValue(jgot, want.cty()) {
+			fail(ht, "json value differs from the model:\n%s\n     got %#v\nexpected %#v", jsrc, jgot, want.cty())
+		}
+	})
+}
+
+// quoteJSONRaw spells s as a JSON string literal without any template
+// escaping (the content is meant to be read as a template).
+func quoteJSONRaw(s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for _, r := range s {
+		switch r {
+		case '"':
+			b.WriteString(`\"`)
+		case '\\':
+			b.WriteString(`\\`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\r':
+			b.WriteString(`\r`)
+		case '\t':
+			b.WriteString(`\t`)
+		default:
+			if r < 0x20 || r == 0x7f {
+				fmt.Fprintf(&b, `\u%04x`, r)
+			} else {
+				b.WriteRune(r)
+			}
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// TestHegelVariablesAreTheFreeReferences: Expression.Variables() names
+// exactly the variables an expression refers to outside its own for scopes.
+func TestHegelVariablesAreTheFreeReferences(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, exprCases)
+		_, err := tryEval(c.e, c.sc)
+		ht.Assume(err == nil)
+		src := render(c.e, 0)
+		want := map[string]bool{}
+		freeVars(c.e, map[string]bool{}, want)
+		expr := parseExpr(ht, src)
+		got := map[string]bool{}
+		for _, tr := range expr.Variables() {
+			got[tr.RootName()] = true
+		}
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "Variables() differs:\n%s\n     got %v\nexpected %v", src, keysOf(got), keysOf(want))
+		}
+		// Every traversal must be one of the scope's variables, and the
+		// expression must be spelled by the source range of each.
+		for _, tr := range expr.Variables() {
+			rng := tr.SourceRange()
+			text := string(rng.SliceBytes([]byte(src)))
+			if !strings.HasPrefix(text, tr.RootName()) {
+				fail(ht, "traversal range %s of %q does not start with its root name in:\n%s", rng, text, src)
+			}
+		}
+	})
+}
+
+func keysOf(m map[string]bool) []string {
+	var out []string
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
