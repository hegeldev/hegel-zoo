+// TestHegelGeneratedFilesReadBack: a file generated with the hclwrite API
+// (SetAttributeValue, SetAttributeTraversal, SetAttributeRaw with
+// TokensForValue, AppendNewBlock) parses with hclsyntax to the model, is
+// already formatted, and survives a sequence of edits.
+func TestHegelGeneratedFilesReadBack(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sc := genEnv(ht)
+		ctx := evalContext(sc)
+		f := hclwrite.NewEmptyFile()
+		model := &body{}
+		buildBody(ht, f.Body(), model, sc, 2)
+		src := f.Bytes()
+		note(ht, "generated:\n%s", src)
+		pf, diags := hclsyntax.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclsyntax rejects a file built with hclwrite:\n%s\n  %s", src, diagText(diags))
+		}
+		if msg := checkContent(pf.Body, model, ctx, sc, "generated"); msg != "" {
+			fail(ht, "%s\ngenerated:\n%s", msg, src)
+		}
+		formatted := hclwrite.Format(src)
+		if !bytes.Equal(formatted, src) {
+			fail(ht, "a file built with hclwrite is not in Format's form:\nbuilt:\n%s\nformatted:\n%s", src, formatted)
+		}
+		// Edits.
+		for k := n(ht, 0, 4); k > 0; k-- {
+			editBody(ht, f.Body(), model, sc)
+			src = f.Bytes()
+			pf, diags = hclsyntax.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+			if diags.HasErrors() {
+				fail(ht, "hclsyntax rejects a file edited with hclwrite:\n%s\n  %s", src, diagText(diags))
+			}
+			if msg := checkContent(pf.Body, model, ctx, sc, "edited"); msg != "" {
+				fail(ht, "%s\nedited:\n%s", msg, src)
+			}
+		}
+	})
+}
+
+// buildBody fills an hclwrite body and its model alike.
+func buildBody(tc hegel.TestCase, wb *hclwrite.Body, model *body, sc *scope, depth int) {
+	names := map[string]bool{}
+	for k := n(tc, 0, 4); k > 0; k-- {
+		if depth > 0 && chance(tc, 30) {
+			blk := &block{typ: genBlockType(tc)}
+			for l := labelCountFor(tc, model, blk.typ); l > 0; l-- {
+				lab, _ := genLabel(tc)
+				blk.labels = append(blk.labels, lab)
+				blk.quoted = append(blk.quoted, true)
+			}
+			blk.body = &body{}
+			wblk := wb.AppendNewBlock(blk.typ, blk.labels)
+			buildBody(tc, wblk.Body(), blk.body, sc, depth-1)
+			model.blocks = append(model.blocks, blk)
+			model.order = append(model.order, -len(model.blocks))
+			if chance(tc, 30) {
+				wb.AppendNewline()
+			}
+			continue
+		}
+		name := genIdent(tc)
+		if names[name] {
+			continue
+		}
+		names[name] = true
+		a := setRandomAttribute(tc, wb, name, sc)
+		model.attrs = append(model.attrs, a)
+		model.order = append(model.order, len(model.attrs)-1)
+	}
+}
+
+// setRandomAttribute sets an attribute through one of the hclwrite setters
+// and returns its model.
+func setRandomAttribute(tc hegel.TestCase, wb *hclwrite.Body, name string, sc *scope) *attr {
+	switch n(tc, 1, 3) {
+	case 1:
+		var v V
+		for tries := 0; ; tries++ {
+			v = genValue(tc, 2)
+			if !hasNull(v) || tries == 3 {
+				break
+			}
+		}
+		if hasNull(v) {
+			v = intV(0)
+		}
+		wb.SetAttributeValue(name, v.cty())
+		return &attr{name: name, e: &E{op: "lit", v: v}}
+	case 2:
+		var v V
+		for tries := 0; ; tries++ {
+			v = genValue(tc, 2)
+			if !hasNull(v) || tries == 3 {
+				break
+			}
+		}
+		if hasNull(v) {
+			v = strV("x")
+		}
+		wb.SetAttributeRaw(name, hclwrite.TokensForValue(v.cty()))
+		return &attr{name: name, e: &E{op: "lit", v: v}}
+	default:
+		// A traversal into a variable: root, then attribute and index steps
+		// that exist.
+		var roots []string
+		for k := range sc.vars {
+			roots = append(roots, k)
+		}
+		sort.Strings(roots)
+		if len(roots) == 0 {
+			wb.SetAttributeValue(name, cty.True)
+			return &attr{name: name, e: &E{op: "lit", v: boolV(true)}}
+		}
+		root := pick(tc, roots...)
+		e := &E{op: "var", name: root}
+		trav := hcl.Traversal{hcl.TraverseRoot{Name: root}}
+		cur := sc.vars[root]
+		for steps := n(tc, 0, 3); steps > 0; steps-- {
+			switch cur.k {
+			case kObj:
+				if len(cur.keys) == 0 {
+					steps = 0
+					continue
+				}
+				i := n(tc, 0, len(cur.keys)-1)
+				key := cur.keys[i]
+				if isIdent(key) && !keywords[key] && chance(tc, 70) {
+					trav = append(trav, hcl.TraverseAttr{Name: key})
+					e = &E{op: "attr", a: e, name: key}
+				} else {
+					trav = append(trav, hcl.TraverseIndex{Key: cty.StringVal(key)})
+					e = &E{op: "idx", a: e, b: &E{op: "lit", v: strV(key)}}
+				}
+				cur = cur.elems[i]
+			case kTuple:
+				if len(cur.elems) == 0 {
+					steps = 0
+					continue
+				}
+				i := n(tc, 0, len(cur.elems)-1)
+				trav = append(trav, hcl.TraverseIndex{Key: cty.NumberIntVal(int64(i))})
+				e = &E{op: "idx", a: e, b: &E{op: "lit", v: intV(int64(i))}}
+				cur = cur.elems[i]
+			default:
+				steps = 0
+			}
+		}
+		wb.SetAttributeTraversal(name, trav)
+		return &attr{name: name, e: e}
+	}
+}
+
+// editBody applies one random edit to an hclwrite body and its model.
+func editBody(tc hegel.TestCase, wb *hclwrite.Body, model *body, sc *scope) {
+	// Descend into a block sometimes.
+	if len(model.blocks) > 0 && chance(tc, 30) {
+		i := n(tc, 0, len(model.blocks)-1)
+		blk := model.blocks[i]
+		wblk := wb.FirstMatchingBlock(blk.typ, blk.labels)
+		if wblk == nil {
+			return
+		}
+		// FirstMatchingBlock may find an earlier twin; edit the model twin.
+		for _, cand := range model.blocks {
+			if cand.typ == blk.typ && strings.Join(cand.labels, "\x00") == strings.Join(blk.labels, "\x00") {
+				blk = cand
+				break
+			}
+		}
+		editBody(tc, wblk.Body(), blk.body, sc)
+		return
+	}
+	switch n(tc, 1, 5) {
+	case 1: // set a new or existing attribute
+		name := genIdent(tc)
+		a := setRandomAttribute(tc, wb, name, sc)
+		for i, old := range model.attrs {
+			if old.name == name {
+				model.attrs[i] = a
+				return
+			}
+		}
+		model.attrs = append(model.attrs, a)
+		model.order = append(model.order, len(model.attrs)-1)
+	case 2: // remove an attribute
+		if len(model.attrs) == 0 {
+			return
+		}
+		i := n(tc, 0, len(model.attrs)-1)
+		wb.RemoveAttribute(model.attrs[i].name)
+		model.removeAttr(i)
+	case 3: // rename an attribute
+		if len(model.attrs) == 0 {
+			return
+		}
+		i := n(tc, 0, len(model.attrs)-1)
+		to := genIdent(tc)
+		for _, other := range model.attrs {
+			if other.name == to {
+				return
+			}
+		}
+		if wb.RenameAttribute(model.attrs[i].name, to) {
+			model.attrs[i].name = to
+		}
+	case 4: // remove a block
+		if len(model.blocks) == 0 {
+			return
+		}
+		i := n(tc, 0, len(model.blocks)-1)
+		blk := model.blocks[i]
+		wblk := wb.FirstMatchingBlock(blk.typ, blk.labels)
+		if wblk == nil {
+			return
+		}
+		wb.RemoveBlock(wblk)
+		for j, cand := range model.blocks {
+			if cand.typ == blk.typ && strings.Join(cand.labels, "\x00") == strings.Join(blk.labels, "\x00") {
+				model.removeBlock(j)
+				return
+			}
+		}
+	default: // append a block
+		blk := &block{typ: genBlockType(tc), body: &body{}}
+		for l := labelCountFor(tc, model, blk.typ); l > 0; l-- {
+			lab, _ := genLabel(tc)
+			blk.labels = append(blk.labels, lab)
+			blk.quoted = append(blk.quoted, true)
+		}
+		wblk := wb.AppendNewBlock(blk.typ, blk.labels)
+		buildBody(tc, wblk.Body(), blk.body, sc, 0)
+		model.blocks = append(model.blocks, blk)
+		model.order = append(model.order, -len(model.blocks))
+	}
+}
+
+// labelCountFor keeps blocks of one type in one body to one label count, as
+// a schema requires.
+func labelCountFor(tc hegel.TestCase, model *body, typ string) int {
+	for _, blk := range model.blocks {
+		if blk.typ == typ {
+			return len(blk.labels)
+		}
+	}
+	return n(tc, 0, 2)
+}
+
+func (b *body) removeAttr(i int) {
+	b.attrs = append(b.attrs[:i], b.attrs[i+1:]...)
+	var order []int
+	for _, o := range b.order {
+		if o == i {
+			continue
+		}
+		if o > i {
+			o--
+		}
+		order = append(order, o)
+	}
+	b.order = order
+}
+
+func (b *body) removeBlock(i int) {
+	b.blocks = append(b.blocks[:i], b.blocks[i+1:]...)
+	var order []int
+	for _, o := range b.order {
+		if o == -1-i {
+			continue
+		}
+		if o < -1-i {
+			o++
+		}
+		order = append(order, o)
+	}
+	b.order = order
+}
+
+// TestHegelTokensForValueRoundTrip: hclwrite.TokensForValue spells a value
+// that hclsyntax reads back as the same value.
+func TestHegelTokensForValueRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 3)
+		toks := hclwrite.TokensForValue(v.cty())
+		src := toks.Bytes()
+		note(ht, "value %#v\ntokens: %s", v.cty(), src)
+		expr, diags := hclsyntax.ParseExpression(src, "val.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "TokensForValue output does not parse: %s\n  %s\nvalue %#v", src, diagText(diags), v.cty())
+		}
+		got, diags := expr.Value(nil)
+		if diags.HasErrors() {
+			fail(ht, "TokensForValue output does not evaluate: %s\n  %s", src, diagText(diags))
+		}
+		if !sameValue(got, v.cty()) {
+			fail(ht, "TokensForValue round trip differs: %s\n     got %#v\nexpected %#v", src, got, v.cty())
+		}
+		// Format leaves it alone up to whitespace, and the token bytes are
+		// what the tokens say.
+		formatted := hclwrite.Format(append([]byte("x = "), src...))
+		f, diags := hclsyntax.ParseConfig(formatted, "val.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "formatted TokensForValue output does not parse:\n%s\n  %s", formatted, diagText(diags))
+		}
+		attrs, _ := f.Body.JustAttributes()
+		got2, diags := attrs["x"].Expr.Value(nil)
+		if diags.HasErrors() || !sameValue(got2, v.cty()) {
+			fail(ht, "formatted TokensForValue output evaluates differently:\n%s\n     got %#v\nexpected %#v\n%s", formatted, got2, v.cty(), diagText(diags))
+		}
+	})
+}
