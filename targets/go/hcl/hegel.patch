+// ---------------------------------------------------------------------------
+// Edits on parsed files.
+
+// editCase: a configuration and one to five edits on it. Under
+// HEGEL_NO_KNOWN=1 every block is spelled multi-line (hcl/5).
+type editCase struct {
+	config
+	edits []edit
+}
+
+func (c editCase) GoString() string {
+	return c.config.GoString() + "edits: " + describeEdits(c.edits) + "\n"
+}
+
+var editCases = hegel.Map(pairs(configs, many(edits, 1, 5)), func(p pair[config, []edit]) editCase {
+	if Known.writerOneLineBlock {
+		clearOneLine(p.a.body)
+	}
+	return editCase{p.a, p.b}
+})
+
+// TestHegelEditsOnParsedFilesKeepTheRest: a generated file parsed by
+// hclwrite survives a sequence of edits: after each, the bytes parse and
+// offer the edited model's content, and untouched attributes keep their
+// expressions.
+func TestHegelEditsOnParsedFilesKeepTheRest(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, editCases)
+		b, sc := c.body, c.sc
+		ctx := evalContext(sc)
+		src := []byte(spell(b, c.tape).src)
+		note(ht, "source:\n%s", src)
+		parseConfig(ht, string(src), "the generated file")
+		wf, diags := hclwrite.ParseConfig(src, "gen.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			fail(ht, "hclwrite.ParseConfig rejects what hclsyntax accepts:\n%s\n  %s", src, diagText(diags))
+		}
+		for _, e := range c.edits {
+			target, added := apply(e, wf.Body(), b, sc)
+			oneLine := shapeIf(target != nil && target.oneLine && added, "hcl/5")
+			out := wf.Bytes()
+			pf, diags := hclsyntax.ParseConfig(out, "edited.hcl", hcl.InitialPos)
+			if diags.HasErrors() {
+				mismatch(ht, oneLine, "hclsyntax rejects a file edited with hclwrite (%s):\n%s\n  %s\noriginal:\n%s", e, out, diagText(diags), src)
+			}
+			if msg, shapes := checkContent(pf.Body, b, ctx, sc, "edited"); msg != "" {
+				mismatch(ht, append(shapes, oneLine...), "%s (after %s)\nedited:\n%s\noriginal:\n%s", msg, e, out, src)
+			}
+			minus := shapeIf(commentMinus.Match(out), "hcl/7")
+			if formatted := hclwrite.Format(out); !bytes.Equal(formatted, out) {
+				mismatch(ht, append(oneLine, minus...), "an edited file (%s) is not in Format's form:\nedited:\n%s\nformatted:\n%s", e, out, formatted)
+			}
+		}
+	})
+}
