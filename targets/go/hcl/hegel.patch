+// ---------------------------------------------------------------------------
+// hcl/1: an indented heredoc with a whitespace-only line.
+
+// blankLines: a whitespace-only heredoc line (empty, spaces or a tab beyond
+// the indentation).
+var blankLines = hegel.Map(pairs(lineExtras, hegel.SampledFrom([]string{"", "  ", "\t"})), func(p pair[string, string]) heredocLine {
+	line := heredocLine{extra: p.a}
+	if p.b != "" {
+		line.parts = []tpart{{kind: "lit", text: p.b}}
+	}
+	return line
+})
+
+// blankHeredocCases: a file of one `<<-` heredoc attribute with one
+// whitespace-only line among its lines (none under HEGEL_NO_KNOWN=1).
+var blankHeredocCases = hegel.FlatMap(envs, func(sc *scope) hegel.Generator[config] {
+	specs := newBodyGrammar(sc).heredocSpecs(2)
+	extra := shaped(many(blankLines, 1, 1), hegel.Just[[]heredocLine](nil))
+	indents := hegel.Integers(1, 4)
+	return hegel.Composite(func(tc hegel.TestCase) config {
+		spec := hegel.Draw(tc, specs)
+		spec.indent = hegel.Draw(tc, indents)
+		for _, line := range hegel.Draw(tc, extra) {
+			pos := hegel.Draw(tc, positions) % (len(spec.lines) + 1)
+			spec.lines = append(append(append([]heredocLine{}, spec.lines[:pos]...), line), spec.lines[pos:]...)
+		}
+		a := heredocAttr(spec)
+		a.name = "a"
+		return config{sc: sc, body: &body{attrs: []*attr{a}, order: []int{0}}, tape: hegel.Draw(tc, tapes)}
+	})
+})
+
+// TestHegelIndentedHeredocsStripBlankLines: the value of a `<<-` heredoc is
+// the template dedented by the specification's rule, whitespace-only lines
+// included (the oracle of TestHegelNativeAndJSONBodiesAgree).
+func TestHegelIndentedHeredocsStripBlankLines(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, blankHeredocCases)
+		src := spell(c.body, c.tape).src
+		note(ht, "native:\n%s", src)
+		f := parseConfig(ht, src, "the generated file")
+		if msg, shapes := checkContent(f.Body, c.body, evalContext(c.sc), c.sc, "native"); msg != "" {
+			mismatch(ht, shapes, "%s\nsource:\n%s", msg, src)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// hcl/2: a quoted block label with `$` or `%` beside other characters.
+
+// escapedLabels: a quoted label of a template introducer or escape beside
+// another piece.
+var escapedLabels = hegel.Map(pairs(hegel.SampledFrom([]string{"$", "%", "${x}", "%{y}", "$${", "%%{"}), hegel.SampledFrom(stringPieces)), func(p pair[string, string]) label {
+	return label{text: nfc(p.a + p.b), quoted: true}
+})
+
+// quotedLabels: any quoted label (past the shape under HEGEL_NO_KNOWN=1).
+var quotedLabels = hegel.Map(weighted(choice[string]{70, labelPool}, choice[string]{30, strs}), func(s string) label { return pastEscapedLabel(label{s, true}) })
+
+// escapedLabelCases: a file of one block whose labels include an escaped one
+// (any quoted labels under HEGEL_NO_KNOWN=1) around a body of attributes.
+var escapedLabelCases = hegel.FlatMap(envs, func(sc *scope) hegel.Generator[config] {
+	bodies := newBodyGrammar(sc).bodies(1, 0, 0)
+	special := shaped(escapedLabels, quotedLabels)
+	others := many(labels, 0, 1)
+	return hegel.Composite(func(tc hegel.TestCase) config {
+		ls := hegel.Draw(tc, others)
+		pos := hegel.Draw(tc, positions) % (len(ls) + 1)
+		ls = append(append(append([]label{}, ls[:pos]...), hegel.Draw(tc, special)), ls[pos:]...)
+		blk := &block{typ: hegel.Draw(tc, blockTypes), body: hegel.Draw(tc, bodies)}
+		for _, l := range ls {
+			blk.labels = append(blk.labels, l.text)
+			blk.quoted = append(blk.quoted, l.quoted)
+		}
+		return config{sc: sc, body: &body{blocks: []*block{blk}, order: []int{-1}}, tape: hegel.Draw(tc, tapes)}
+	})
+})
