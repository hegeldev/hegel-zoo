+// checkWriterBody compares an hclwrite.Body with the model: attribute names
+// and expression values (the expression tokens re-parsed), block types,
+// labels and bodies.
+func checkWriterBody(wb *hclwrite.Body, b *body, ctx *hcl.EvalContext, sc *scope, path string) string {
+	attrs := wb.Attributes()
+	if len(attrs) != len(b.attrs) {
+		return fmt.Sprintf("%s: hclwrite sees %d attributes, expected %d", path, len(attrs), len(b.attrs))
+	}
+	for _, a := range b.attrs {
+		wa := wb.GetAttribute(a.name)
+		if wa == nil {
+			return fmt.Sprintf("%s: hclwrite has no attribute %q", path, a.name)
+		}
+		exprSrc := wa.Expr().BuildTokens(nil).Bytes()
+		want, err := tryEval(a.e, sc)
+		if err != nil {
+			return fmt.Sprintf("GENERATOR: %s: %v", path, err)
+		}
+		src := string(exprSrc)
+		if a.heredoc != nil && !strings.HasSuffix(src, "\n") {
+			src += "\n"
+		}
+		expr, diags := hclsyntax.ParseExpression([]byte(src), "expr.hcl", hcl.InitialPos)
+		if diags.HasErrors() {
+			return fmt.Sprintf("%s: the expression tokens of %q do not parse: %q\n  %s", path, a.name, exprSrc, diagText(diags))
+		}
+		val, diags := expr.Value(ctx)
+		if diags.HasErrors() {
+			return fmt.Sprintf("%s: the expression tokens of %q do not evaluate: %q\n  %s", path, a.name, exprSrc, diagText(diags))
+		}
+		if !sameValue(val, want.cty()) {
+			return fmt.Sprintf("%s: the expression tokens of %q evaluate to %#v, expected %#v: %q", path, a.name, val, want.cty(), exprSrc)
+		}
+	}
+	blocks := wb.Blocks()
+	if len(blocks) != len(b.blocks) {
+		return fmt.Sprintf("%s: hclwrite sees %d blocks, expected %d", path, len(blocks), len(b.blocks))
+	}
+	for i, blk := range b.blocks {
+		got := blocks[i]
+		if got.Type() != blk.typ {
+			return fmt.Sprintf("%s: block %d has type %q, expected %q", path, i, got.Type(), blk.typ)
+		}
+		labels := got.Labels()
+		if Known.writerEscapedLabel && hasEscapedLabel(blk) {
+			labels = nil // hcl/2: not compared
+		} else if len(labels) != len(blk.labels) {
+			return fmt.Sprintf("%s: block %d has labels %q, expected %q", path, i, labels, blk.labels)
+		}
+		for k := range labels {
+			if nfc(labels[k]) != nfc(blk.labels[k]) {
+				return fmt.Sprintf("%s: block %d has labels %q, expected %q", path, i, labels, blk.labels)
+			}
+		}
+		if msg := checkWriterBody(got.Body(), blk.body, ctx, sc, fmt.Sprintf("%s/%s%q", path, blk.typ, blk.labels)); msg != "" {
+			return msg
+		}
+	}
+	return ""
+}
+
+// hasEscapedLabel reports whether a block has a quoted label containing a
+// `$` or `%` beside other characters (the scanner splits the literal there).
+func hasEscapedLabel(blk *block) bool {
+	for i, l := range blk.labels {
+		if blk.quoted[i] && len(l) > 1 && strings.ContainsAny(l, "$%") {
+			return true
+		}
+	}
+	return false
+}
