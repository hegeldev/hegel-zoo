+package hcl_test
+
+// Configuration files: a body model with attributes, blocks, heredocs and
+// comments, spelled in the native syntax (with random whitespace) and in the
+// JSON syntax, built with hclwrite, formatted with hclwrite.Format, and read
+// back with hclsyntax and json through hcl.Body.Content.
+
+import (
+	"bytes"
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/hashicorp/hcl/v2/hclwrite"
+	"github.com/hashicorp/hcl/v2/json"
+	"github.com/zclconf/go-cty/cty"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// The body model.
+
+type attr struct {
+	name    string
+	e       *E      // the expression (a "tmpl" holding the value's template for heredocs)
+	heredoc *hdoc   // non-nil for a heredoc attribute
+	spell   []tpart // heredocs: the template as written (indented for <<-)
+	comment string  // trailing line comment, "" for none
+}
+
+type hdoc struct {
+	marker string
+	indent int // > 0 for a <<- heredoc with this many leading spaces
+}
+
+type block struct {
+	typ     string
+	labels  []string
+	quoted  []bool // spelled as a quoted string (true) or an identifier
+	body    *body
+	oneLine bool // spelled as a one-line block (at most one attribute)
+}
+
+type body struct {
+	attrs  []*attr
+	blocks []*block
+	order  []int // indices into attrs (>= 0) and blocks (< 0: -1-i), in source order
+	trail  []string
+}
+
+func (b *body) items() []any {
+	var out []any
+	for _, o := range b.order {
+		if o >= 0 {
+			out = append(out, b.attrs[o])
+		} else {
+			out = append(out, b.blocks[-1-o])
+		}
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Generation.
+
+func genBlockType(tc hegel.TestCase) string {
+	if chance(tc, 80) {
+		return pick(tc, "resource", "variable", "locals", "module", "provider", "a", "block-1", "λ")
+	}
+	return genIdent(tc)
+}
+
+func genLabel(tc hegel.TestCase) (string, bool) {
+	if chance(tc, 30) {
+		return genIdent(tc), false
+	}
+	if chance(tc, 70) {
+		return pick(tc, "aws_instance", "web", "main", "", "with space", "a\"b", "${x}", "%{y}", "é"), true
+	}
+	return genString(tc), true
+}
+
+func (g *gen) genBody(depth int, bodyDepth int) *body {
+	b := &body{}
+	names := map[string]bool{}
+	for k := n(g.tc, 0, 4); k > 0; k-- {
+		if bodyDepth > 0 && chance(g.tc, 30) {
+			blk := &block{typ: genBlockType(g.tc)}
+			if names[blk.typ] {
+				continue
+			}
+			for l := n(g.tc, 0, 2); l > 0; l-- {
+				lab, quoted := genLabel(g.tc)
+				blk.labels = append(blk.labels, lab)
+				blk.quoted = append(blk.quoted, quoted)
+			}
+			blk.body = g.genBody(depth, bodyDepth-1)
+			if len(blk.body.attrs)+len(blk.body.blocks) <= 1 && len(blk.body.blocks) == 0 && chance(g.tc, 40) {
+				blk.oneLine = true
+			}
+			b.blocks = append(b.blocks, blk)
+			b.order = append(b.order, -len(b.blocks))
+			// Another block of the same type is allowed; JSON groups them.
+			if chance(g.tc, 25) {
+				b2 := &block{typ: blk.typ, labels: append([]string{}, blk.labels...), quoted: append([]bool{}, blk.quoted...)}
+				if len(b2.labels) > 0 && chance(g.tc, 50) {
+					lab, quoted := genLabel(g.tc)
+					b2.labels[len(b2.labels)-1] = lab
+					b2.quoted[len(b2.quoted)-1] = quoted
+				}
+				b2.body = g.genBody(depth, bodyDepth-1)
+				b.blocks = append(b.blocks, b2)
+				b.order = append(b.order, -len(b.blocks))
+			}
+			names[blk.typ] = true
+			continue
+		}
+		a := &attr{name: genIdent(g.tc)}
+		if names[a.name] || keywords[a.name] {
+			continue
+		}
+		names[a.name] = true
+		if chance(g.tc, 15) {
+			a.heredoc = &hdoc{marker: pick(g.tc, "END", "HEREDOC", "eot", "_x")}
+			parts := g.heredocTemplate(depth)
+			if chance(g.tc, 40) {
+				a.heredoc.indent = n(g.tc, 1, 4)
+				parts = padLines(parts, strings.Repeat(" ", a.heredoc.indent), g.tc)
+				if Known.flushBlankLines {
+					parts = noBlankLines(parts)
+				}
+				parts = meldLits(parts)
+				a.spell = parts
+				a.e = &E{op: "tmpl", parts: specDedent(copyParts(parts))}
+			} else {
+				parts = meldLits(parts)
+				a.spell = parts
+				a.e = &E{op: "tmpl", parts: parts}
+			}
+		} else {
+			a.e = g.expr(nil, depth)
+			// A comment may not follow a heredoc's closing marker (the grammar
+			// wants a newline there), so only plain attributes get one.
+			if chance(g.tc, 20) {
+				a.comment = pick(g.tc, "# note", "// note", "#", "//", "# ${not} %{a} \"q\"", "# 日本")
+			}
+		}
+		b.attrs = append(b.attrs, a)
+		b.order = append(b.order, len(b.attrs)-1)
+	}
+	return b
+}
+
+// lineStarts calls fn with the index of each part that begins a line (the
+// first part, and every part after a literal ending in a newline), or -1
+// when a line begins after the last part (nothing to pad).
+func lineStarts(parts []tpart) []int {
+	var out []int
+	newline := true
+	for i, p := range parts {
+		if newline {
+			out = append(out, i)
+		}
+		newline = p.kind == "lit" && strings.HasSuffix(p.text, "\n")
+	}
+	return out
+}
+
+// padLines indents every line of a template by pad, as the source of a <<-
+// heredoc would be written.
+func padLines(parts []tpart, pad string, tc hegel.TestCase) []tpart {
+	starts := lineStarts(parts)
+	var out []tpart
+	for i, p := range parts {
+		isStart := false
+		for _, s := range starts {
+			if s == i {
+				isStart = true
+			}
+		}
+		if isStart {
+			extra := ""
+			if chance(tc, 30) {
+				extra = pick(tc, " ", "  ", "\t")
+			}
+			if p.kind == "lit" {
+				p.text = pad + extra + p.text
+			} else {
+				out = append(out, tpart{kind: "lit", text: pad + extra})
+			}
+		}
+		out = append(out, p)
+	}
+	return out
+}
+
+// noBlankLines makes sure no line of the template is whitespace only (hcl/1
+// treats such lines specially).
+func noBlankLines(parts []tpart) []tpart {
+	starts := lineStarts(parts)
+	for _, s := range starts {
+		// Find the extent of the line.
+		blank := true
+		end := s
+		for end < len(parts) {
+			p := parts[end]
+			if p.kind != "lit" || strings.TrimSpace(strings.TrimSuffix(p.text, "\n")) != "" {
+				blank = false
+			}
+			if p.kind == "lit" && strings.HasSuffix(p.text, "\n") {
+				break
+			}
+			end++
+		}
+		if blank && end < len(parts) {
+			parts[end].text = "x" + parts[end].text
+			if len(parts[end].text) > 1 && strings.TrimSpace(strings.TrimSuffix(parts[end].text, "\n")) == "x" {
+				// The line was pad + "\n": put the x after the pad.
+				t := strings.TrimSuffix(parts[end].text[1:], "\n")
+				parts[end].text = t + "x\n"
+			}
+		}
+	}
+	return parts
+}
+
+func copyParts(parts []tpart) []tpart {
+	out := make([]tpart, len(parts))
+	copy(out, parts)
+	return out
+}
+
+// specDedent applies the <<- rule of the specification: the minimum number of
+// leading spaces over the line-leading literals (a line starting with an
+// interpolation has none) is removed from every line-leading literal.
+func specDedent(parts []tpart) []tpart {
+	// Split literals at newlines so that every line-leading literal is a part
+	// of its own, then meld the pieces within a line (the scanner yields one
+	// token per run of literal text).
+	var split []tpart
+	for _, p := range parts {
+		if p.kind != "lit" {
+			split = append(split, p)
+			continue
+		}
+		text := p.text
+		for text != "" {
+			i := strings.IndexByte(text, '\n')
+			if i < 0 {
+				split = append(split, tpart{kind: "lit", text: text})
+				break
+			}
+			split = append(split, tpart{kind: "lit", text: text[:i+1]})
+			text = text[i+1:]
+		}
+	}
+	var melded []tpart
+	for _, p := range split {
+		if len(melded) > 0 && p.kind == "lit" && melded[len(melded)-1].kind == "lit" && !strings.HasSuffix(melded[len(melded)-1].text, "\n") {
+			melded[len(melded)-1].text += p.text
+			continue
+		}
+		melded = append(melded, p)
+	}
+	parts = melded
+	starts := lineStarts(parts)
+	min := -1
+	for _, s := range starts {
+		spaces := 0
+		if parts[s].kind == "lit" {
+			spaces = len([]rune(parts[s].text)) - len([]rune(strings.TrimLeftFunc(parts[s].text, unicode.IsSpace)))
+		}
+		if min < 0 || spaces < min {
+			min = spaces
+		}
+	}
+	if min <= 0 {
+		return parts
+	}
+	for _, s := range starts {
+		if parts[s].kind == "lit" {
+			r := []rune(parts[s].text)
+			parts[s].text = string(r[min:])
+		}
+	}
+	return parts
+}
+
+// heredocTemplate draws the template of a heredoc: lines of literals and
+// interpolations, ending in a newline.
+func (g *gen) heredocTemplate(depth int) []tpart {
+	var parts []tpart
+	for lines := n(g.tc, 1, 3); lines > 0; lines-- {
+		for k := n(g.tc, 0, 2); k > 0; k-- {
+			if chance(g.tc, 60) {
+				text := pick(g.tc, "hello", "  ", "a b", "${", "%{", "\"quoted\"", "\\n", "é", "}", "$", "%", "\t")
+				parts = append(parts, tpart{kind: "lit", text: text})
+			} else {
+				t := pick(g.tc, tStr, tNum, tBool)
+				parts = append(parts, tpart{kind: "interp", e: g.expr(&t, depth-1)})
+			}
+		}
+		parts = append(parts, tpart{kind: "lit", text: "\n"})
+	}
+	return parts
+}
+
+// ---------------------------------------------------------------------------
+// Spelling a body in the native syntax.
+
+type nativeWriter struct {
+	tc     hegel.TestCase
+	b      strings.Builder
+	indent int
+	tidy   bool // canonical spacing only
+}
+
+func (w *nativeWriter) ws() string {
+	if w.tidy || chance(w.tc, 60) {
+		return " "
+	}
+	return pick(w.tc, "", "  ", "\t", " /* c */ ")
+}
+
+func (w *nativeWriter) lead() string {
+	if w.tidy {
+		return strings.Repeat("  ", w.indent)
+	}
+	if chance(w.tc, 70) {
+		return strings.Repeat("  ", w.indent)
+	}
+	return pick(w.tc, "", " ", "\t", "    ")
+}
+
+func (w *nativeWriter) writeBody(b *body) {
+	for _, it := range b.items() {
+		if !w.tidy && chance(w.tc, 15) {
+			w.b.WriteString(pick(w.tc, "\n", "# comment line\n", "// other\n", "/* block\n comment */\n", "\n\n"))
+		}
+		switch x := it.(type) {
+		case *attr:
+			w.writeAttr(x)
+		case *block:
+			w.writeBlock(x)
+		}
+	}
+}
+
+func (w *nativeWriter) writeAttr(a *attr) {
+	w.b.WriteString(w.lead() + a.name + w.ws() + "=" + w.ws())
+	if a.heredoc != nil {
+		h := a.heredoc
+		if h.indent > 0 {
+			w.b.WriteString("<<-" + h.marker + "\n")
+			w.b.WriteString(renderTemplate(a.spell, true))
+			w.b.WriteString(pick(w.tc, "", strings.Repeat(" ", h.indent), "  ") + h.marker)
+		} else {
+			w.b.WriteString("<<" + h.marker + "\n")
+			w.b.WriteString(renderTemplate(a.spell, true))
+			w.b.WriteString(h.marker)
+		}
+	} else {
+		w.b.WriteString(render(a.e, 0))
+	}
+	if a.comment != "" {
+		w.b.WriteString(w.ws() + a.comment)
+	}
+	w.b.WriteString("\n")
+}
+
+func (w *nativeWriter) writeBlock(blk *block) {
+	w.b.WriteString(w.lead() + blk.typ)
+	for i, l := range blk.labels {
+		sep := w.ws()
+		if i == 0 && Known.writerTypeComment && strings.Contains(sep, "/*") {
+			sep = " " // hcl/3
+		}
+		if !blk.quoted[i] && sep == "" {
+			sep = " " // two identifiers need a separator
+		}
+		if blk.quoted[i] {
+			w.b.WriteString(sep + quoteNative(l, false))
+		} else {
+			w.b.WriteString(sep + l)
+		}
+	}
+	if blk.oneLine {
+		w.b.WriteString(w.ws() + "{")
+		if len(blk.body.attrs) == 1 && blk.body.attrs[0].heredoc == nil {
+			a := blk.body.attrs[0]
+			w.b.WriteString(w.ws() + a.name + w.ws() + "=" + w.ws() + render(a.e, 0) + w.ws())
+		} else if len(blk.body.attrs) == 1 {
+			// A heredoc cannot sit in a one-line block: spell it multi-line.
+			w.b.WriteString("\n")
+			w.indent++
+			w.writeBody(blk.body)
+			w.indent--
+			w.b.WriteString(w.lead())
+		}
+		w.b.WriteString("}\n")
+		return
+	}
+	w.b.WriteString(w.ws() + "{\n")
+	w.indent++
+	w.writeBody(blk.body)
+	w.indent--
+	w.b.WriteString(w.lead() + "}\n")
+}
+
+func spellNative(tc hegel.TestCase, b *body, tidy bool) string {
+	w := &nativeWriter{tc: tc, tidy: tidy}
+	w.writeBody(b)
+	return w.b.String()
+}
+
+// ---------------------------------------------------------------------------
+// Spelling a body in the JSON syntax.
+
+func exprJSON(a *attr) string {
+	if a.heredoc != nil {
+		// The heredoc's (dedented) template as a standalone template string.
+		return quoteJSONRaw(renderTemplate(a.e.parts, true))
+	}
+	if a.e.op == "lit" && !hasNull(a.e.v) {
+		return a.e.v.json()
+	}
+	return quoteJSONRaw("${" + render(a.e, 0) + "}")
+}
+
+func spellJSON(b *body) string {
+	var props []string
+	for _, a := range b.attrs {
+		props = append(props, quoteJSONRaw(a.name)+": "+exprJSON(a))
+	}
+	// Blocks: grouped by type, then nested by labels; repeated paths become
+	// arrays.
+	byType := map[string][]*block{}
+	var types []string
+	for _, blk := range b.blocks {
+		if _, ok := byType[blk.typ]; !ok {
+			types = append(types, blk.typ)
+		}
+		byType[blk.typ] = append(byType[blk.typ], blk)
+	}
+	for _, t := range types {
+		props = append(props, quoteJSONRaw(t)+": "+jsonBlockGroup(byType[t], 0))
+	}
+	return "{" + strings.Join(props, ", ") + "}"
+}
+
+// jsonBlockGroup spells blocks sharing a type and the first `level` labels.
+func jsonBlockGroup(blks []*block, level int) string {
+	if len(blks[0].labels) == level {
+		// Bodies.
+		if len(blks) == 1 {
+			return spellJSON(blks[0].body)
+		}
+		parts := make([]string, len(blks))
+		for i, blk := range blks {
+			parts[i] = spellJSON(blk.body)
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	}
+	byLabel := map[string][]*block{}
+	var labels []string
+	for _, blk := range blks {
+		l := blk.labels[level]
+		if _, ok := byLabel[l]; !ok {
+			labels = append(labels, l)
+		}
+		byLabel[l] = append(byLabel[l], blk)
+	}
+	parts := make([]string, len(labels))
+	for i, l := range labels {
+		parts[i] = quoteJSONRaw(l) + ": " + jsonBlockGroup(byLabel[l], level+1)
+	}
+	return "{" + strings.Join(parts, ", ") + "}"
+}
+
+// ---------------------------------------------------------------------------
+// Reading a body back through hcl.Body.Content.
+
+func schemaOf(b *body) *hcl.BodySchema {
+	s := &hcl.BodySchema{}
+	for _, a := range b.attrs {
+		s.Attributes = append(s.Attributes, hcl.AttributeSchema{Name: a.name})
+	}
+	seen := map[string]bool{}
+	for _, blk := range b.blocks {
+		if seen[blk.typ] {
+			continue
+		}
+		seen[blk.typ] = true
+		s.Blocks = append(s.Blocks, hcl.BlockHeaderSchema{Type: blk.typ, LabelNames: labelNames(len(blk.labels))})
+	}
+	return s
+}
+
+func labelNames(k int) []string {
+	out := make([]string, k)
+	for i := range out {
+		out[i] = fmt.Sprintf("label%d", i)
+	}
+	return out
+}
+
+// checkContent compares what a parsed body offers through Content with the
+// model, evaluating attributes in ctx; it returns a description of the first
+// difference, or "".
+func checkContent(hb hcl.Body, b *body, ctx *hcl.EvalContext, sc *scope, path string) string {
+	content, diags := hb.Content(schemaOf(b))
+	if diags.HasErrors() {
+		return fmt.Sprintf("%s: Content fails: %s", path, diagText(diags))
+	}
+	if len(content.Attributes) != len(b.attrs) {
+		return fmt.Sprintf("%s: %d attributes, expected %d", path, len(content.Attributes), len(b.attrs))
+	}
+	for _, a := range b.attrs {
+		got, ok := content.Attributes[a.name]
+		if !ok {
+			return fmt.Sprintf("%s: attribute %q missing", path, a.name)
+		}
+		want, err := tryEval(a.e, sc)
+		if err != nil {
+			return fmt.Sprintf("GENERATOR: %s: model cannot evaluate %s: %v", path, a.name, err)
+		}
+		val, diags := got.Expr.Value(ctx)
+		if diags.HasErrors() {
+			return fmt.Sprintf("%s: attribute %q fails to evaluate: %s", path, a.name, diagText(diags))
+		}
+		if !sameValue(val, want.cty()) {
+			return fmt.Sprintf("%s: attribute %q = %#v, expected %#v\nmodel: %s", path, a.name, val, want.cty(), a.e.dump())
+		}
+	}
+	if len(content.Blocks) != len(b.blocks) {
+		return fmt.Sprintf("%s: %d blocks, expected %d", path, len(content.Blocks), len(b.blocks))
+	}
+	// Blocks: per (type, labels) the order is preserved; across kinds the
+	// JSON syntax groups them, so match by key.
+	used := make([]bool, len(content.Blocks))
+	for i, blk := range b.blocks {
+		found := -1
+		for j, got := range content.Blocks {
+			if used[j] || got.Type != blk.typ || len(got.Labels) != len(blk.labels) {
+				continue
+			}
+			same := true
+			for k := range blk.labels {
+				if nfc(got.Labels[k]) != nfc(blk.labels[k]) {
+					same = false
+				}
+			}
+			if same {
+				found = j
+				break
+			}
+		}
+		if found < 0 {
+			return fmt.Sprintf("%s: block %d (%s %q) not found among %s", path, i, blk.typ, blk.labels, describeBlocks(content.Blocks))
+		}
+		used[found] = true
+		if msg := checkContent(content.Blocks[found].Body, blk.body, ctx, sc, fmt.Sprintf("%s/%s%q", path, blk.typ, blk.labels)); msg != "" {
+			return msg
+		}
+	}
+	return ""
+}
+
+func describeBlocks(blks hcl.Blocks) string {
+	var parts []string
+	for _, b := range blks {
+		parts = append(parts, fmt.Sprintf("%s %q", b.Type, b.Labels))
+	}
+	return "[" + strings.Join(parts, ", ") + "]"
+}
+
+// ---------------------------------------------------------------------------
+// Tokens compared modulo whitespace.
+
+type tokShape struct {
+	typ   hclsyntax.TokenType
+	bytes string
+}
+
+func tokenShapes(src []byte) ([]tokShape, hcl.Diagnostics) {
+	toks, diags := hclsyntax.LexConfig(src, "gen.hcl", hcl.InitialPos)
+	var out []tokShape
+	for _, t := range toks {
+		if t.Type == hclsyntax.TokenNewline || t.Type == hclsyntax.TokenEOF {
+			continue
+		}
+		out = append(out, tokShape{t.Type, string(t.Bytes)})
+	}
+	return out, diags
+}
+
+func firstTokenDiff(a, b []tokShape) string {
+	for i := 0; i < len(a) && i < len(b); i++ {
+		if a[i] != b[i] {
+			return fmt.Sprintf("token %d: %s %q vs %s %q", i, a[i].typ, a[i].bytes, b[i].typ, b[i].bytes)
+		}
+	}
+	if len(a) != len(b) {
+		return fmt.Sprintf("%d tokens vs %d", len(a), len(b))
+	}
+	return ""
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+func genConfig(ht *hegel.T) (*body, *scope, *gen) {
+	sc := genEnv(ht)
+	g := &gen{tc: ht, sc: sc, budget: 60}
+	b := g.genBody(n(ht, 1, 3), 2)
+	return b, sc, g
+}
