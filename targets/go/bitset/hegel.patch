diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..6223721
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,129 @@
+package bitset_test
+
+// Pins for the bugs in bugs.toml. Each asserts the correct behaviour and is listed as an
+// expected failure in target.toml: it fails while the bug exists and passes, unexpectedly,
+// once the bug is fixed (which is the signal to drop the Known switch and the entry).
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/bits-and-blooms/bitset"
+)
+
+// bitset/1
+func TestHegelPinPreviousSetLooksBackFromAnyIndex(t *testing.T) {
+	b := bitset.New(8)
+	b.Set(3)
+	for _, i := range []uint{7, 50, 64, 100, 1000} {
+		if got, ok := b.PreviousSet(i); !ok || got != 3 {
+			t.Errorf("PreviousSet(%d) on {3} of Len 8 = %d,%v; want 3,true", i, got, ok)
+		}
+	}
+	c := bitset.New(200)
+	c.Set(70)
+	c.Set(5)
+	if got, ok := c.PreviousClear(1000); !ok || got != 199 {
+		t.Errorf("PreviousClear(1000) on Len 200 = %d,%v; want 199,true", got, ok)
+	}
+}
+
+// bitset/2
+func TestHegelPinPreviousClearStaysWithinTheLength(t *testing.T) {
+	b := bitset.New(8)
+	b.Set(3)
+	if got, ok := b.PreviousClear(50); !ok || got != 7 {
+		t.Errorf("PreviousClear(50) on Len 8 = %d,%v; want 7,true (bit 50 is beyond the length, as NextClear treats it)", got, ok)
+	}
+	full := bitset.New(8)
+	full.SetAll()
+	if got, ok := full.PreviousClear(50); ok {
+		t.Errorf("PreviousClear(50) on a full set of Len 8 = %d,%v; want false (all bits are set)", got, ok)
+	}
+}
+
+// bitset/3
+func TestHegelPinInPlaceIntersectionEqualsIntersection(t *testing.T) {
+	a := bitset.New(10)
+	a.Set(1)
+	c := bitset.New(200)
+	c.Set(1)
+	x := a.Clone()
+	x.InPlaceIntersection(c)
+	want := a.Intersection(c)
+	if !x.Equal(want) {
+		t.Errorf("InPlaceIntersection gives Len %d, Intersection Len %d: not Equal", x.Len(), want.Len())
+	}
+}
+
+// bitset/4
+func TestHegelPinCopyLeavesTheRestOfTheDestination(t *testing.T) {
+	src := bitset.New(5)
+	src.Set(1)
+	dst := bitset.New(100)
+	dst.SetAll()
+	if count := src.Copy(dst); count != 5 {
+		t.Fatalf("Copy returned %d, want 5", count)
+	}
+	// Bits 0-4 come from the source (only bit 1 set); bits 5-99 stay set.
+	if got := dst.Count(); got != 96 {
+		t.Errorf("after copying 5 bits into a full 100-bit set, Count = %d, want 96", got)
+	}
+	for i := uint(5); i < 100; i++ {
+		if !dst.Test(i) {
+			t.Errorf("bit %d of the destination was cleared by a 5-bit Copy", i)
+			break
+		}
+	}
+}
+
+// bitset/5
+func TestHegelPinExtractToExtendsForAnEmptySource(t *testing.T) {
+	mask := bitset.New(10)
+	mask.SetRange(0, 8)
+	dst := bitset.New(3)
+	(&bitset.BitSet{}).ExtractTo(mask, dst)
+	if dst.Len() != 8 {
+		t.Errorf("ExtractTo from an empty source with an 8-bit mask into New(3) leaves Len %d; Extract gives Len %d", dst.Len(), (&bitset.BitSet{}).Extract(mask).Len())
+	}
+}
+
+// bitset/6
+func TestHegelPinDepositToClearsBeyondTheSource(t *testing.T) {
+	src := bitset.New(3) // one word: bits 64 and up of the source are clear
+	src.Set(0)
+	mask := bitset.New(200)
+	mask.SetRange(0, 70) // 70 mask positions, 6 more than the source's word holds
+	dst := bitset.New(200)
+	dst.SetAll()
+	src.DepositTo(mask, dst)
+	for _, p := range []uint{64, 65, 69} {
+		if dst.Test(p) {
+			t.Errorf("mask position %d took no bit from the source: it should be clear (source bit %d is clear), but stays set", p, p)
+		}
+	}
+	if !dst.Test(0) || dst.Test(1) || !dst.Test(70) {
+		t.Errorf("positions 0, 1, 70 = %v %v %v; want true false true", dst.Test(0), dst.Test(1), dst.Test(70))
+	}
+}
+
+// bitset/7
+func TestHegelPinReadFromRejectsAnImpossibleLength(t *testing.T) {
+	var hdr [8]byte
+	binary.BigEndian.PutUint64(hdr[:], 1<<62) // a length no 8-byte input can back
+	b := bitset.New(10)
+	b.Set(3)
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Fatalf("UnmarshalBinary of an 8-byte header claiming length 1<<62 panics: %v (want an error)", r)
+			}
+		}()
+		if err := b.UnmarshalBinary(hdr[:]); err == nil {
+			t.Fatalf("UnmarshalBinary of an 8-byte header claiming length 1<<62 succeeds")
+		}
+	}()
+	if !(b.Len() == 10 && b.Count() == 1) && !(b.Len() == 0 && b.Count() == 0) {
+		t.Errorf("after the failed read the set is neither unchanged nor empty: Len %d Count %d", b.Len(), b.Count())
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..48ff1ce
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,396 @@
+package bitset_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with random
+// contents, judged by the model checks of the wide property that found it, so that each bug has
+// a property that finds it every run (the wide properties in hegel_test.go reach the shapes at
+// their natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not
+// touch instead (an index within the allocated words, one below the length, sets of equal
+// length, a source whose length is a multiple of 64, a destination long enough, a mask no wider
+// than the source's words, a header claiming one word) and passes.
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"testing"
+
+	"github.com/bits-and-blooms/bitset"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	// lengths1: a length of one bit or more (bitPos without 0).
+	lengths1 = weighted(choice[int]{60, hegel.Integers(1, 200)}, choice[int]{28, hegel.SampledFrom(posEdges[1:])}, choice[int]{12, hegel.Integers(1, 5000)})
+	// offWordLengths: a length that is not a multiple of 64.
+	offWordLengths = hegel.Map(lengths1, func(l int) int {
+		if l%64 == 0 {
+			return l + 1
+		}
+		return l
+	})
+	// wordLengths: a length that is a multiple of 64.
+	wordLengths = hegel.Map(hegel.Integers(1, 80), func(n int) int { return 64 * n })
+	// nonEmptySets: a set of one bit or more (so of one word or more), by every constructor but
+	// the zero value.
+	nonEmptySets = weighted(
+		choice[setSpec]{2, newSetsOf(lengths1)},
+		choice[setSpec]{1, mustSetsOf(lengths1)},
+		choice[setSpec]{1, fromSetsOf(many(word64s, 1, 6))},
+		choice[setSpec]{1, fromLengthSets},
+	)
+)
+
+// setsOf: New (three times in four) or MustNew sets of the lengths.
+func setsOf(lengths hegel.Generator[int]) hegel.Generator[setSpec] {
+	return weighted(choice[setSpec]{3, newSetsOf(lengths)}, choice[setSpec]{1, mustSetsOf(lengths)})
+}
+
+// extendTo lengthens b and m to n bits (when n is above the length) without setting a bit.
+func extendTo(b *bitset.BitSet, m *model, n int) {
+	if n > m.length() {
+		b.Set(uint(n - 1))
+		b.Clear(uint(n - 1))
+		m.set(n - 1)
+		m.clear(n - 1)
+	}
+}
+
+// --------------------------------------------------------------------------- bitset/1, bitset/2
+
+// probeCase: a set, an index into a region of it (modulo the region's size) and a bit to set
+// when the contents have none.
+type probeCase struct {
+	set setSpec
+	at  int
+	bit int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c probeCase) GoString() string {
+	return fmt.Sprintf("%s; at %d; bit %d", c.set.GoString(), c.at, c.bit)
+}
+
+func probeCasesOf(sets hegel.Generator[setSpec]) hegel.Generator[probeCase] {
+	return hegel.Composite(func(tc hegel.TestCase) probeCase {
+		return probeCase{set: hegel.Draw(tc, sets), at: hegel.Draw(tc, positions), bit: hegel.Draw(tc, positions)}
+	})
+}
+
+var (
+	beyondWordCases = probeCasesOf(nonEmptySets)
+	paddingCases    = probeCasesOf(setsOf(offWordLengths))
+)
+
+// TestHegelPreviousSetLooksBackBeyondTheLastWord: PreviousSet(i) for an index beyond the set's
+// last allocated word is the set's highest set bit (a bit is set when the contents have none),
+// as the model says; the library answers "not found" (bitset/1). Under HEGEL_NO_KNOWN=1 the
+// index is within the allocated words.
+func TestHegelPreviousSetLooksBackBeyondTheLastWord(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, beyondWordCases)
+		describe(c)
+		b, m := c.set.build()
+		if m.count() == 0 {
+			p := c.bit % m.length()
+			b.Set(uint(p))
+			m.set(p)
+		}
+		words := 64 * len(b.Words())
+		i := shaped(words+c.at%80, c.at%words)
+		previousSetAgrees(ht, "PreviousSet", b, m, i, shaped("bitset/1", ""))
+	})
+}
+
+// TestHegelPreviousClearStaysWithinTheLength: PreviousClear(i) for an index at or beyond the
+// length within the last allocated word is the last clear bit below the length, or "not found"
+// on a full set; the library returns i itself, a padding bit (bitset/2). Under HEGEL_NO_KNOWN=1
+// the index is below the length.
+func TestHegelPreviousClearStaysWithinTheLength(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, paddingCases)
+		describe(c)
+		b, m := c.set.build()
+		if m.length()%64 == 0 { // a fill moved the length onto a word boundary
+			extendTo(b, m, m.length()+1)
+		}
+		L, words := m.length(), 64*len(b.Words())
+		i := shaped(L+c.at%(words-L), c.at%L)
+		previousClearAgrees(ht, "PreviousClear", b, m, i, shaped("bitset/2", ""))
+	})
+}
+
+// --------------------------------------------------------------------------- bitset/3
+
+// pairCase: two sets.
+type pairCase struct{ a, c setSpec }
+
+// GoString is what the draw report prints (it uses %#v).
+func (p pairCase) GoString() string { return fmt.Sprintf("a %s; c %s", p.a.GoString(), p.c.GoString()) }
+
+var pairCases = hegel.Composite(func(tc hegel.TestCase) pairCase {
+	return pairCase{a: hegel.Draw(tc, sets), c: hegel.Draw(tc, sets)}
+})
+
+// TestHegelInPlaceIntersectionEqualsIntersection: for sets of different lengths (the second is
+// lengthened by a clear bit when they are equal) a.Clone().InPlaceIntersection(c) is Equal to
+// a.Intersection(c); the library keeps the longer length in place and the shorter in the
+// functional form (bitset/3). Under HEGEL_NO_KNOWN=1 the shorter set is lengthened to the
+// longer's length first.
+func TestHegelInPlaceIntersectionEqualsIntersection(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, pairCases)
+		describe(p)
+		a, am := p.a.build()
+		c, cm := p.c.build()
+		if noKnown {
+			extendTo(a, am, cm.length())
+			extendTo(c, cm, am.length())
+		} else if am.length() == cm.length() {
+			extendTo(c, cm, cm.length()+1)
+		}
+		x := a.Clone()
+		x.InPlaceIntersection(c)
+		res := a.Intersection(c)
+		checkSet(ht, "Intersection", res, intersection(am, cm))
+		if !x.Equal(res) {
+			mismatch(ht, shaped("bitset/3", ""), "InPlaceIntersection gives Len %d %s, Intersection Len %d %s", x.Len(), x.String(), res.Len(), res.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- bitset/4
+
+// copyCase: a source of a length off a word boundary (on one under HEGEL_NO_KNOWN=1) and a
+// destination.
+type copyCase struct{ src, dst setSpec }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c copyCase) GoString() string {
+	return fmt.Sprintf("source %s; destination %s", c.src.GoString(), c.dst.GoString())
+}
+
+var copyCases = hegel.Composite(func(tc hegel.TestCase) copyCase {
+	return copyCase{src: hegel.Draw(tc, setsOf(shaped(offWordLengths, wordLengths))), dst: hegel.Draw(tc, sets)}
+})
+
+// TestHegelCopyLeavesTheRestOfTheDestination: Copy writes min(Len) bits into the destination
+// and leaves its other bits alone, so a destination with bits set between the source's length
+// and the end of the source's last word keeps them; the library copies the source's padding
+// zeros over them (bitset/4). Under HEGEL_NO_KNOWN=1 the source's length is a multiple of 64, so
+// it has no padding.
+func TestHegelCopyLeavesTheRestOfTheDestination(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, copyCases)
+		describe(c)
+		src, sm := c.src.build()
+		dst, dm := c.dst.build()
+		L := sm.length()
+		if noKnown {
+			extendTo(src, sm, 64*wordsNeeded(L)) // a fill may have moved the length off the boundary
+		} else if L%64 == 0 {
+			extendTo(src, sm, L+1) // or onto one
+		}
+		L = sm.length()
+		end := 64 * wordsNeeded(L)
+		// The destination reaches past the source's last word, with the bits in between set.
+		dst.SetRange(uint(L), uint(end))
+		dm.setRange(L, end)
+		count := src.Copy(dst)
+		k := min(L, dm.length())
+		if int(count) != k {
+			fail(ht, "Copy returned %d, want min(%d, %d) = %d", count, L, dm.length(), k)
+		}
+		for i := 0; i < k; i++ {
+			dm.bits[i] = sm.bits[i]
+		}
+		checkSetOf(ht, shaped("bitset/4", ""), "Copy destination", dst, dm)
+		checkSet(ht, "Copy source unchanged", src, sm)
+	})
+}
+
+// --------------------------------------------------------------------------- bitset/5
+
+var emptyKinds = []string{"zero value", "New(0)", "MustNew(0)", "From(nil)"}
+
+// emptyCase: an empty source by one of its constructors, a mask, the ExtractTo destination's
+// length (modulo the mask's count, or past it under HEGEL_NO_KNOWN=1) and a bit to set in an
+// empty mask.
+type emptyCase struct {
+	how     string
+	mask    setSpec
+	dl, bit int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c emptyCase) GoString() string {
+	return fmt.Sprintf("source %s; mask %s; dl %d; bit %d", c.how, c.mask.GoString(), c.dl, c.bit)
+}
+
+var emptyCases = hegel.Composite(func(tc hegel.TestCase) emptyCase {
+	return emptyCase{
+		how:  hegel.Draw(tc, hegel.SampledFrom(emptyKinds)),
+		mask: hegel.Draw(tc, sets),
+		dl:   hegel.Draw(tc, positions),
+		bit:  hegel.Draw(tc, positions),
+	}
+})
+
+func emptySource(how string) *bitset.BitSet {
+	switch how {
+	case "New(0)":
+		return bitset.New(0)
+	case "MustNew(0)":
+		return bitset.MustNew(0)
+	case "From(nil)":
+		return bitset.From(nil)
+	}
+	return &bitset.BitSet{}
+}
+
+// TestHegelExtractToExtendsForAnEmptySource: ExtractTo from a source without words into a
+// destination shorter than the mask's count extends the destination to the count (as Extract
+// does), all clear; the library returns before extending (bitset/5). Under HEGEL_NO_KNOWN=1 the
+// destination is long enough already.
+func TestHegelExtractToExtendsForAnEmptySource(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, emptyCases)
+		describe(c)
+		src := emptySource(c.how)
+		mask, mm := c.mask.build()
+		if mm.count() == 0 {
+			p := c.bit % 200
+			mask.Set(uint(p))
+			mm.set(p)
+		}
+		count := mm.count()
+		dl := shaped(c.dl%count, count+c.dl%50)
+		dst := bitset.New(uint(dl))
+		src.ExtractTo(mask, dst)
+		checkSetOf(ht, shaped("bitset/5", ""), fmt.Sprintf("ExtractTo from %s into New(%d) with %d mask positions", c.how, dl, count), dst, newModel(max(dl, count)))
+		if got := src.Extract(mask); int(got.Len()) != count {
+			fail(ht, "Extract from %s with %d mask positions gives Len %d", c.how, count, got.Len())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- bitset/6
+
+// depositCase: a source of one word or more, how many mask positions past the source's
+// allocated bits the mask has (one to seventy; none under HEGEL_NO_KNOWN=1) and the padding of
+// the mask's length beyond them.
+type depositCase struct {
+	src        setSpec
+	extra, pad int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c depositCase) GoString() string {
+	return fmt.Sprintf("source %s; %d mask positions past its words; padding %d", c.src.GoString(), c.extra, c.pad)
+}
+
+var depositCases = hegel.Composite(func(tc hegel.TestCase) depositCase {
+	return depositCase{
+		src:   hegel.Draw(tc, nonEmptySets),
+		extra: hegel.Draw(tc, shaped(hegel.Integers(1, 70), hegel.Just(0))),
+		pad:   hegel.Draw(tc, hegel.Integers(0, 100)),
+	}
+})
+
+// TestHegelDepositToClearsBeyondTheSource: DepositTo places source bit k at the k-th mask
+// position, so mask positions past the source's allocated bits, whose source bits are clear,
+// are cleared in a full destination; the library stops at the source's last word and leaves
+// them set (bitset/6). Under HEGEL_NO_KNOWN=1 the mask has no more positions than the source
+// has allocated bits.
+func TestHegelDepositToClearsBeyondTheSource(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, depositCases)
+		describe(c)
+		src, sm := c.src.build()
+		n := 64*len(src.Words()) + c.extra
+		mask, mm := bitset.New(uint(n+c.pad)), newModel(n+c.pad)
+		mask.SetRange(0, uint(n))
+		mm.setRange(0, n)
+		dst, dm := bitset.New(uint(n+c.pad)), newModel(n+c.pad)
+		dst.SetAll()
+		for i := range dm.bits {
+			dm.bits[i] = true
+		}
+		src.DepositTo(mask, dst)
+		deposit(sm, mm, dm)
+		checkSetOf(ht, shaped("bitset/6", ""), fmt.Sprintf("DepositTo of %d mask positions from %d source words", n, len(src.Words())), dst, dm)
+		checkSet(ht, "DepositTo source unchanged", src, sm)
+	})
+}
+
+// --------------------------------------------------------------------------- bitset/7
+
+// headerCase: the exponent of an impossible length header (headerExps), the byte order, the set
+// it is read into (nil: a fresh one) and how.
+type headerCase struct {
+	exp    int
+	little bool
+	victim *setSpec
+	how    string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c headerCase) GoString() string {
+	order, into := "big-endian", "a fresh set"
+	if c.little {
+		order = "little-endian"
+	}
+	if c.victim != nil {
+		into = c.victim.GoString()
+	}
+	return fmt.Sprintf("header 2^%d %s; %s into %s", c.exp, order, c.how, into)
+}
+
+var headerCases = hegel.Composite(func(tc hegel.TestCase) headerCase {
+	return headerCase{
+		exp:    hegel.Draw(tc, headerExps),
+		little: hegel.Draw(tc, chance(30)),
+		victim: hegel.Draw(tc, optional(50, sets)),
+		how:    hegel.Draw(tc, hegel.SampledFrom([]string{"UnmarshalBinary", "ReadFrom"})),
+	}
+})
+
+// TestHegelReadFromRejectsAnImpossibleLength: a bare header claiming a length no 8-byte input
+// can back is an error from UnmarshalBinary and ReadFrom that leaves the set unchanged or
+// empty, as documented; the library allocates for the claimed length first and panics in make
+// (bitset/7). Under HEGEL_NO_KNOWN=1 the header claims one word, which the input lacks: an
+// error.
+func TestHegelReadFromRejectsAnImpossibleLength(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, headerCases)
+		describe(c)
+		order := binary.ByteOrder(binary.BigEndian)
+		if c.little {
+			bitset.LittleEndian()
+			order = binary.LittleEndian
+			defer bitset.BigEndian()
+		}
+		hdr := headerBytes(c.exp, order)
+		b, m := &bitset.BitSet{}, newModel(0)
+		if c.victim != nil {
+			b, m = c.victim.build()
+		}
+		var err error
+		panicked := catching(func() {
+			if c.how == "ReadFrom" {
+				_, err = b.ReadFrom(bytes.NewReader(hdr))
+			} else {
+				err = b.UnmarshalBinary(hdr)
+			}
+		})
+		shape := shaped("bitset/7", "")
+		if panicked != nil {
+			mismatch(ht, shape, "%s of a bare length header % x panics: %v", c.how, hdr, panicked)
+		}
+		if err == nil {
+			mismatch(ht, shape, "%s of a bare length header % x succeeds", c.how, hdr)
+		}
+		if !(b.Len() == 0 && b.Count() == 0) && !(int(b.Len()) == m.length() && b.Count() == uint(m.count())) {
+			fail(ht, "after the failed read the set is neither unchanged nor empty: Len %d Count %d (was Len %d Count %d)", b.Len(), b.Count(), m.length(), m.count())
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..90d820e
--- /dev/null
