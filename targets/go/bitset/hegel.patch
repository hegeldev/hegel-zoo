diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..6223721
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,129 @@
+package bitset_test
+
+// Pins for the bugs in bugs.toml. Each asserts the correct behaviour and is listed as an
+// expected failure in target.toml: it fails while the bug exists and passes, unexpectedly,
+// once the bug is fixed (which is the signal to drop the Known switch and the entry).
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/bits-and-blooms/bitset"
+)
+
+// bitset/1
+func TestHegelPinPreviousSetLooksBackFromAnyIndex(t *testing.T) {
+	b := bitset.New(8)
+	b.Set(3)
+	for _, i := range []uint{7, 50, 64, 100, 1000} {
+		if got, ok := b.PreviousSet(i); !ok || got != 3 {
+			t.Errorf("PreviousSet(%d) on {3} of Len 8 = %d,%v; want 3,true", i, got, ok)
+		}
+	}
+	c := bitset.New(200)
+	c.Set(70)
+	c.Set(5)
+	if got, ok := c.PreviousClear(1000); !ok || got != 199 {
+		t.Errorf("PreviousClear(1000) on Len 200 = %d,%v; want 199,true", got, ok)
+	}
+}
+
+// bitset/2
+func TestHegelPinPreviousClearStaysWithinTheLength(t *testing.T) {
+	b := bitset.New(8)
+	b.Set(3)
+	if got, ok := b.PreviousClear(50); !ok || got != 7 {
+		t.Errorf("PreviousClear(50) on Len 8 = %d,%v; want 7,true (bit 50 is beyond the length, as NextClear treats it)", got, ok)
+	}
+	full := bitset.New(8)
+	full.SetAll()
+	if got, ok := full.PreviousClear(50); ok {
+		t.Errorf("PreviousClear(50) on a full set of Len 8 = %d,%v; want false (all bits are set)", got, ok)
+	}
+}
+
+// bitset/3
+func TestHegelPinInPlaceIntersectionEqualsIntersection(t *testing.T) {
+	a := bitset.New(10)
+	a.Set(1)
+	c := bitset.New(200)
+	c.Set(1)
+	x := a.Clone()
+	x.InPlaceIntersection(c)
+	want := a.Intersection(c)
+	if !x.Equal(want) {
+		t.Errorf("InPlaceIntersection gives Len %d, Intersection Len %d: not Equal", x.Len(), want.Len())
+	}
+}
+
+// bitset/4
+func TestHegelPinCopyLeavesTheRestOfTheDestination(t *testing.T) {
+	src := bitset.New(5)
+	src.Set(1)
+	dst := bitset.New(100)
+	dst.SetAll()
+	if count := src.Copy(dst); count != 5 {
+		t.Fatalf("Copy returned %d, want 5", count)
+	}
+	// Bits 0-4 come from the source (only bit 1 set); bits 5-99 stay set.
+	if got := dst.Count(); got != 96 {
+		t.Errorf("after copying 5 bits into a full 100-bit set, Count = %d, want 96", got)
+	}
+	for i := uint(5); i < 100; i++ {
+		if !dst.Test(i) {
+			t.Errorf("bit %d of the destination was cleared by a 5-bit Copy", i)
+			break
+		}
+	}
+}
+
+// bitset/5
+func TestHegelPinExtractToExtendsForAnEmptySource(t *testing.T) {
+	mask := bitset.New(10)
+	mask.SetRange(0, 8)
+	dst := bitset.New(3)
+	(&bitset.BitSet{}).ExtractTo(mask, dst)
+	if dst.Len() != 8 {
+		t.Errorf("ExtractTo from an empty source with an 8-bit mask into New(3) leaves Len %d; Extract gives Len %d", dst.Len(), (&bitset.BitSet{}).Extract(mask).Len())
+	}
+}
+
+// bitset/6
+func TestHegelPinDepositToClearsBeyondTheSource(t *testing.T) {
+	src := bitset.New(3) // one word: bits 64 and up of the source are clear
+	src.Set(0)
+	mask := bitset.New(200)
+	mask.SetRange(0, 70) // 70 mask positions, 6 more than the source's word holds
+	dst := bitset.New(200)
+	dst.SetAll()
+	src.DepositTo(mask, dst)
+	for _, p := range []uint{64, 65, 69} {
+		if dst.Test(p) {
+			t.Errorf("mask position %d took no bit from the source: it should be clear (source bit %d is clear), but stays set", p, p)
+		}
+	}
+	if !dst.Test(0) || dst.Test(1) || !dst.Test(70) {
+		t.Errorf("positions 0, 1, 70 = %v %v %v; want true false true", dst.Test(0), dst.Test(1), dst.Test(70))
+	}
+}
+
+// bitset/7
+func TestHegelPinReadFromRejectsAnImpossibleLength(t *testing.T) {
+	var hdr [8]byte
+	binary.BigEndian.PutUint64(hdr[:], 1<<62) // a length no 8-byte input can back
+	b := bitset.New(10)
+	b.Set(3)
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Fatalf("UnmarshalBinary of an 8-byte header claiming length 1<<62 panics: %v (want an error)", r)
+			}
+		}()
+		if err := b.UnmarshalBinary(hdr[:]); err == nil {
+			t.Fatalf("UnmarshalBinary of an 8-byte header claiming length 1<<62 succeeds")
+		}
+	}()
+	if !(b.Len() == 10 && b.Count() == 1) && !(b.Len() == 0 && b.Count() == 0) {
+		t.Errorf("after the failed read the set is neither unchanged nor empty: Len %d Count %d", b.Len(), b.Count())
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..9f67da8
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1100 @@
+package bitset_test
+
+// Hegel property tests for github.com/bits-and-blooms/bitset.
+//
+// Oracle: a model of a bitset as a slice of booleans whose length is the
+// documented Len (bits at or beyond it are clear), with every documented
+// operation written against it (set algebra, ranges, shifts, insertion and
+// deletion, rank/select, navigation, PEXT/PDEP, copying, comparison,
+// iteration and the textual forms), the binary format as WriteTo documents it
+// (a length word followed by the words, big- or little-endian), the JSON form
+// (the binary in base64 URL encoding), and the package's documented contracts.
+//
+// Set BITSET_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math/bits"
+	"math/rand"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/bits-and-blooms/bitset"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("BITSET_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...)+"\n  case: "+lastNote)
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+var lastNote string // the notes of the running case, for collect mode
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		lastNote = ""
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) {
+	m := fmt.Sprintf(format, args...)
+	lastNote += "\n  " + m
+	ht.Note(m)
+}
+
+// prng returns a seeded random source: bulk bits come from it so that Hegel
+// only has to draw (and shrink) the structure of a case.
+func prng(ht *hegel.T) *rand.Rand { return rand.New(rand.NewSource(int64(n(ht, 0, 1<<30)))) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	previousBeyondLastWord bool // bitset/1: PreviousSet and PreviousClear return "not found" for an index beyond the last word
+	previousClearBeyondLen bool // bitset/2: PreviousClear returns positions at or beyond Len
+	inPlaceIntersectionLen bool // bitset/3: InPlaceIntersection extends the receiver to the other set's length; Intersection keeps the shorter
+	copyClearsPadding      bool // bitset/4: Copy clears destination bits between the source's length and the end of its last word
+	extractToEmptySource   bool // bitset/5: ExtractTo does not extend dst when the source has no words
+	depositToStopsAtSource bool // bitset/6: DepositTo leaves mask positions unchanged once the source's words run out
+	readFromTrustsLength   bool // bitset/7: ReadFrom allocates for whatever length the header claims, panicking on a huge one
+}{previousBeyondLastWord: true, previousClearBeyondLen: true, inPlaceIntersectionLen: true, copyClearsPadding: true, extractToEmptySource: true, depositToStopsAtSource: true, readFromTrustsLength: true}
+
+// ---------------------------------------------------------------------------
+// The model.
+
+// model is a bitset as documented: Len bits, of which some are set; bits at or
+// beyond Len are clear.
+type model struct {
+	bits []bool // len(bits) == Len
+}
+
+func newModel(length int) *model { return &model{bits: make([]bool, length)} }
+
+func (m *model) clone() *model { return &model{bits: append([]bool(nil), m.bits...)} }
+
+func (m *model) length() int { return len(m.bits) }
+
+func (m *model) test(i int) bool { return i >= 0 && i < len(m.bits) && m.bits[i] }
+
+// extend makes the model at least length bits long.
+func (m *model) extend(length int) {
+	for len(m.bits) < length {
+		m.bits = append(m.bits, false)
+	}
+}
+
+func (m *model) set(i int) { m.extend(i + 1); m.bits[i] = true }
+
+func (m *model) clear(i int) {
+	if i < len(m.bits) {
+		m.bits[i] = false
+	}
+}
+
+func (m *model) flip(i int) { m.extend(i + 1); m.bits[i] = !m.bits[i] }
+
+func (m *model) setRange(s, e int) {
+	if s >= e {
+		return
+	}
+	m.extend(e)
+	for i := s; i < e; i++ {
+		m.bits[i] = true
+	}
+}
+
+func (m *model) flipRange(s, e int) {
+	if s >= e {
+		return
+	}
+	m.extend(e)
+	for i := s; i < e; i++ {
+		m.bits[i] = !m.bits[i]
+	}
+}
+
+func (m *model) count() int {
+	c := 0
+	for _, b := range m.bits {
+		if b {
+			c++
+		}
+	}
+	return c
+}
+
+// top returns the highest set bit, or -1.
+func (m *model) top() int {
+	for i := len(m.bits) - 1; i >= 0; i-- {
+		if m.bits[i] {
+			return i
+		}
+	}
+	return -1
+}
+
+func (m *model) setBits() []uint {
+	var out []uint
+	for i, b := range m.bits {
+		if b {
+			out = append(out, uint(i))
+		}
+	}
+	return out
+}
+
+func (m *model) insertAt(idx int) {
+	m.bits = append(m.bits, false)
+	copy(m.bits[idx+1:], m.bits[idx:])
+	m.bits[idx] = false
+}
+
+func (m *model) deleteAt(i int) {
+	m.bits = append(m.bits[:i], m.bits[i+1:]...)
+}
+
+func (m *model) shiftLeft(k int) {
+	top := m.top()
+	if k == 0 || top < 0 {
+		return
+	}
+	nb := make([]bool, max(len(m.bits), top+k+1))
+	for i, b := range m.bits {
+		if b {
+			nb[i+k] = true
+		}
+	}
+	m.bits = nb
+}
+
+// shiftRight moves every set bit down by k; the length is left to the caller
+// (see the property: it is implementation-defined and re-synchronised).
+func (m *model) shiftRight(k int) {
+	if k == 0 || m.top() < 0 {
+		return
+	}
+	nb := make([]bool, len(m.bits))
+	for i, b := range m.bits {
+		if b && i >= k {
+			nb[i-k] = true
+		}
+	}
+	m.bits = nb
+}
+
+func (m *model) complement() *model {
+	r := newModel(len(m.bits))
+	for i, b := range m.bits {
+		r.bits[i] = !b
+	}
+	return r
+}
+
+func union(a, b *model) *model {
+	r := newModel(max(a.length(), b.length()))
+	for i := range r.bits {
+		r.bits[i] = a.test(i) || b.test(i)
+	}
+	return r
+}
+
+func intersection(a, b *model) *model {
+	r := newModel(min(a.length(), b.length()))
+	for i := range r.bits {
+		r.bits[i] = a.test(i) && b.test(i)
+	}
+	return r
+}
+
+func difference(a, b *model) *model {
+	r := newModel(a.length())
+	for i := range r.bits {
+		r.bits[i] = a.test(i) && !b.test(i)
+	}
+	return r
+}
+
+func symmetricDifference(a, b *model) *model {
+	r := newModel(max(a.length(), b.length()))
+	for i := range r.bits {
+		r.bits[i] = a.test(i) != b.test(i)
+	}
+	return r
+}
+
+func isSuperSet(a, b *model) bool {
+	for i, x := range b.bits {
+		if x && !a.test(i) {
+			return false
+		}
+	}
+	return true
+}
+
+func sameBits(a, b *model) bool { return isSuperSet(a, b) && isSuperSet(b, a) }
+
+// extract is PEXT: the bits of m at the set positions of mask, packed.
+func extract(m, mask *model) []bool {
+	var out []bool
+	for _, p := range mask.setBits() {
+		out = append(out, m.test(int(p)))
+	}
+	return out
+}
+
+// deposit is PDEP into dst: the k-th bit of m goes to the k-th set position of mask.
+func deposit(m, mask, dst *model) {
+	for k, p := range mask.setBits() {
+		if int(p) < dst.length() {
+			dst.bits[p] = m.test(k)
+		}
+	}
+}
+
+// words are the model's bits as 64-bit words, wordsNeeded(Len) of them.
+func wordsNeeded(length int) int { return (length + 63) / 64 }
+
+func (m *model) words() []uint64 {
+	out := make([]uint64, wordsNeeded(len(m.bits)))
+	for i, b := range m.bits {
+		if b {
+			out[i/64] |= 1 << (i % 64)
+		}
+	}
+	return out
+}
+
+// encode is the binary format WriteTo documents: the length as a 64-bit
+// word, then the words, in the given byte order.
+func (m *model) encode(order binary.ByteOrder) []byte {
+	var buf bytes.Buffer
+	var w [8]byte
+	order.PutUint64(w[:], uint64(len(m.bits)))
+	buf.Write(w[:])
+	for _, x := range m.words() {
+		order.PutUint64(w[:], x)
+		buf.Write(w[:])
+	}
+	return buf.Bytes()
+}
+
+func (m *model) string() string {
+	var sb strings.Builder
+	sb.WriteString("{")
+	for i, p := range m.setBits() {
+		if i > 0 {
+			sb.WriteString(",")
+		}
+		sb.WriteString(strconv.Itoa(int(p)))
+	}
+	sb.WriteString("}")
+	return sb.String()
+}
+
+func (m *model) dumpAsBits() string {
+	ws := m.words()
+	var sb strings.Builder
+	for i := len(ws) - 1; i >= 0; i-- {
+		fmt.Fprintf(&sb, "%064b.", ws[i])
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------------------
+// Comparing a BitSet with its model.
+
+// checkSet compares every observable of b with m.
+func checkSet(ht *hegel.T, what string, b *bitset.BitSet, m *model) {
+	if int(b.Len()) != m.length() {
+		fail(ht, "%s: Len %d, model %d", what, b.Len(), m.length())
+	}
+	if int(b.Count()) != m.count() {
+		fail(ht, "%s: Count %d, model %d", what, b.Count(), m.count())
+	}
+	limit := m.length() + 70
+	for i := 0; i < limit; i++ {
+		if b.Test(uint(i)) != m.test(i) {
+			fail(ht, "%s: Test(%d) = %v, model %v", what, i, b.Test(uint(i)), m.test(i))
+		}
+	}
+	if b.Any() != (m.count() > 0) || b.None() != (m.count() == 0) || b.All() != (m.count() == m.length()) {
+		fail(ht, "%s: Any %v None %v All %v with count %d of %d", what, b.Any(), b.None(), b.All(), m.count(), m.length())
+	}
+	if got := b.Words(); !reflect.DeepEqual(got, m.words()) && !(len(got) == 0 && len(m.words()) == 0) {
+		fail(ht, "%s: Words %x, model %x", what, got, m.words())
+	}
+	want := m.setBits()
+	var got []uint
+	for i := range b.EachSet() {
+		got = append(got, i)
+	}
+	if !reflect.DeepEqual(got, want) && !(len(got) == 0 && len(want) == 0) {
+		fail(ht, "%s: EachSet %v, model %v", what, got, want)
+	}
+	if got := b.AppendTo([]uint{7}); !reflect.DeepEqual(got, append([]uint{7}, want...)) {
+		fail(ht, "%s: AppendTo %v, model %v", what, got, append([]uint{7}, want...))
+	}
+	if got := b.AsSlice(make([]uint, 0, len(want)+1)); !reflect.DeepEqual(got, want) && !(len(got) == 0 && len(want) == 0) {
+		fail(ht, "%s: AsSlice %v, model %v", what, got, want)
+	}
+	if got := b.String(); got != m.string() {
+		fail(ht, "%s: String %q, model %q", what, got, m.string())
+	}
+	if got := b.DumpAsBits(); got != m.dumpAsBits() && !(m.length() == 0 && got == ".") {
+		fail(ht, "%s: DumpAsBits %q, model %q", what, got, m.dumpAsBits())
+	}
+	if c := b.Clone(); !c.Equal(b) || !b.Equal(c) {
+		fail(ht, "%s: Clone is not Equal", what)
+	}
+	if got := b.BinaryStorageSize(); got != 8+8*wordsNeeded(m.length()) {
+		fail(ht, "%s: BinaryStorageSize %d, model %d", what, got, 8+8*wordsNeeded(m.length()))
+	}
+}
+
+// checkQueries compares the positional queries at random positions.
+func checkQueries(ht *hegel.T, r *rand.Rand, what string, b *bitset.BitSet, m *model) {
+	L := m.length()
+	for k := 0; k < 6; k++ {
+		i := r.Intn(L + 80)
+		if r.Intn(4) == 0 && L > 0 {
+			i = r.Intn(L)
+		}
+		// NextSet: the first set bit at or after i.
+		wantIdx, wantOK := -1, false
+		for j := i; j < L; j++ {
+			if m.bits[j] {
+				wantIdx, wantOK = j, true
+				break
+			}
+		}
+		if got, ok := b.NextSet(uint(i)); ok != wantOK || (ok && int(got) != wantIdx) {
+			fail(ht, "%s: NextSet(%d) = %d,%v; model %d,%v", what, i, got, ok, wantIdx, wantOK)
+		}
+		// NextClear: the first clear bit in [i, Len).
+		wantIdx, wantOK = -1, false
+		for j := i; j < L; j++ {
+			if !m.bits[j] {
+				wantIdx, wantOK = j, true
+				break
+			}
+		}
+		if got, ok := b.NextClear(uint(i)); ok != wantOK || (ok && int(got) != wantIdx) {
+			fail(ht, "%s: NextClear(%d) = %d,%v; model %d,%v", what, i, got, ok, wantIdx, wantOK)
+		}
+		// PreviousSet: the last set bit at or before i.
+		pi := i
+		if (Known.previousBeyondLastWord || Known.previousClearBeyondLen) && L > 0 {
+			pi = min(i, L-1)
+		}
+		wantIdx, wantOK = -1, false
+		for j := min(pi, L-1); j >= 0; j-- {
+			if m.bits[j] {
+				wantIdx, wantOK = j, true
+				break
+			}
+		}
+		if L > 0 || !Known.previousBeyondLastWord {
+			if got, ok := b.PreviousSet(uint(pi)); ok != wantOK || (ok && int(got) != wantIdx) {
+				fail(ht, "%s: PreviousSet(%d) = %d,%v; model %d,%v (Len %d)", what, pi, got, ok, wantIdx, wantOK, L)
+			}
+		}
+		// PreviousClear: the last clear bit at or before i, within the length.
+		wantIdx, wantOK = -1, false
+		for j := min(pi, L-1); j >= 0; j-- {
+			if !m.bits[j] {
+				wantIdx, wantOK = j, true
+				break
+			}
+		}
+		if L > 0 || !Known.previousBeyondLastWord {
+			if got, ok := b.PreviousClear(uint(pi)); ok != wantOK || (ok && int(got) != wantIdx) {
+				fail(ht, "%s: PreviousClear(%d) = %d,%v; model %d,%v (Len %d)", what, pi, got, ok, wantIdx, wantOK, L)
+			}
+		}
+		// Rank: set bits at or below i.
+		rank := 0
+		for j := 0; j <= i && j < L; j++ {
+			if m.bits[j] {
+				rank++
+			}
+		}
+		if got := b.Rank(uint(i)); int(got) != rank {
+			fail(ht, "%s: Rank(%d) = %d, model %d", what, i, got, rank)
+		}
+		// OnesBetween.
+		to := r.Intn(L + 80)
+		ones := 0
+		for j := i; j < to && j < L; j++ {
+			if m.bits[j] {
+				ones++
+			}
+		}
+		if got := b.OnesBetween(uint(i), uint(to)); int(got) != ones {
+			fail(ht, "%s: OnesBetween(%d, %d) = %d, model %d", what, i, to, got, ones)
+		}
+		// GetWord64AtBit.
+		var word uint64
+		for j := 0; j < 64; j++ {
+			if m.test(i + j) {
+				word |= 1 << j
+			}
+		}
+		if got := b.GetWord64AtBit(uint(i)); got != word {
+			fail(ht, "%s: GetWord64AtBit(%d) = %x, model %x", what, i, got, word)
+		}
+		// NextSetMany.
+		capacity := r.Intn(5)
+		var wantMany []uint
+		for j := i; j < L && len(wantMany) < capacity; j++ {
+			if m.bits[j] {
+				wantMany = append(wantMany, uint(j))
+			}
+		}
+		last, got := b.NextSetMany(uint(i), make([]uint, 0, capacity))
+		if !reflect.DeepEqual(got, wantMany) && !(len(got) == 0 && len(wantMany) == 0) {
+			fail(ht, "%s: NextSetMany(%d, cap %d) = %v, model %v", what, i, capacity, got, wantMany)
+		}
+		if len(wantMany) > 0 && last != wantMany[len(wantMany)-1] {
+			fail(ht, "%s: NextSetMany(%d, cap %d) returns last %d, want %d", what, i, capacity, last, wantMany[len(wantMany)-1])
+		}
+	}
+	// Select: the j-th set bit; Len when out of range.
+	set := m.setBits()
+	for k := 0; k < 3; k++ {
+		j := r.Intn(len(set) + 2)
+		want := uint(L)
+		if j < len(set) {
+			want = set[j]
+		}
+		if got := b.Select(uint(j)); got != want {
+			fail(ht, "%s: Select(%d) = %d, model %d", what, j, got, want)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+// genPos draws a bit position, mostly small.
+func genPos(ht *hegel.T) int {
+	switch {
+	case chance(ht, 60):
+		return n(ht, 0, 200)
+	case chance(ht, 70):
+		return pick(ht, 0, 1, 62, 63, 64, 65, 127, 128, 129, 191, 192, 255, 256, 511, 512, 1000)
+	default:
+		return n(ht, 0, 5000)
+	}
+}
+
+// genSet makes a BitSet and its model, by one of the constructors.
+func genSet(ht *hegel.T, r *rand.Rand) (*bitset.BitSet, *model, string) {
+	switch pick(ht, "new", "new", "zero", "from", "fromlength", "must") {
+	case "zero":
+		return &bitset.BitSet{}, newModel(0), "zero value"
+	case "from", "fromlength":
+		words := make([]uint64, n(ht, 0, 6))
+		for i := range words {
+			switch r.Intn(4) {
+			case 0:
+				words[i] = 0
+			case 1:
+				words[i] = ^uint64(0)
+			default:
+				words[i] = r.Uint64()
+			}
+		}
+		if len(words) > 0 && chance(ht, 50) {
+			length := n(ht, 64*(len(words)-1)+1, 64*len(words))
+			m := newModel(length)
+			for i := range m.bits {
+				m.bits[i] = words[i/64]&(1<<(i%64)) != 0
+			}
+			// Bits beyond the length must be clear in the words we hand over.
+			for i := length; i < 64*len(words); i++ {
+				words[i/64] &^= 1 << (i % 64)
+			}
+			return bitset.FromWithLength(uint(length), words), m, fmt.Sprintf("FromWithLength(%d, %d words)", length, len(words))
+		}
+		m := newModel(64 * len(words))
+		for i := range m.bits {
+			m.bits[i] = words[i/64]&(1<<(i%64)) != 0
+		}
+		return bitset.From(words), m, fmt.Sprintf("From(%d words)", len(words))
+	case "must":
+		length := genPos(ht)
+		return bitset.MustNew(uint(length)), newModel(length), fmt.Sprintf("MustNew(%d)", length)
+	default:
+		length := genPos(ht)
+		b := bitset.New(uint(length))
+		m := newModel(length)
+		// Fill it a little.
+		for k := n(ht, 0, 4); k > 0; k-- {
+			switch r.Intn(3) {
+			case 0:
+				i := r.Intn(length + 100)
+				b.Set(uint(i))
+				m.set(i)
+			case 1:
+				s, e := r.Intn(length+50), r.Intn(length+50)
+				b.SetRange(uint(s), uint(e))
+				m.setRange(s, e)
+			default:
+				for i := 0; i < length; i++ {
+					if r.Intn(2) == 0 {
+						b.Set(uint(i))
+						m.set(i)
+					}
+				}
+			}
+		}
+		return b, m, fmt.Sprintf("New(%d) filled", length)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Property 1: single-set operations against the model.
+
+func TestHegelSingleSetOperations(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		b, m, how := genSet(ht, r)
+		note(ht, "%s", how)
+		checkSet(ht, "initial", b, m)
+		steps := n(ht, 1, 25)
+		for s := 0; s < steps; s++ {
+			var what string
+			switch op := pick(ht, "set", "set", "clear", "flip", "setto", "setrange", "fliprange", "clearall", "setall", "insertat", "deleteat", "shiftleft", "shiftright", "shrink", "compact", "complement", "clone"); op {
+			case "set":
+				i := genPos(ht)
+				what = fmt.Sprintf("Set(%d)", i)
+				if got := b.Set(uint(i)); got != b {
+					fail(ht, "%s did not return its receiver", what)
+				}
+				m.set(i)
+			case "clear":
+				i := genPos(ht)
+				what = fmt.Sprintf("Clear(%d)", i)
+				b.Clear(uint(i))
+				m.clear(i)
+			case "flip":
+				i := genPos(ht)
+				what = fmt.Sprintf("Flip(%d)", i)
+				b.Flip(uint(i))
+				m.flip(i)
+			case "setto":
+				i, v := genPos(ht), chance(ht, 50)
+				what = fmt.Sprintf("SetTo(%d, %v)", i, v)
+				b.SetTo(uint(i), v)
+				if v {
+					m.set(i)
+				} else {
+					m.clear(i)
+				}
+			case "setrange":
+				s, e := genPos(ht), genPos(ht)
+				what = fmt.Sprintf("SetRange(%d, %d)", s, e)
+				b.SetRange(uint(s), uint(e))
+				m.setRange(s, e)
+			case "fliprange":
+				s, e := genPos(ht), genPos(ht)
+				what = fmt.Sprintf("FlipRange(%d, %d)", s, e)
+				b.FlipRange(uint(s), uint(e))
+				m.flipRange(s, e)
+			case "clearall":
+				what = "ClearAll"
+				b.ClearAll()
+				for i := range m.bits {
+					m.bits[i] = false
+				}
+			case "setall":
+				what = "SetAll"
+				b.SetAll()
+				for i := range m.bits {
+					m.bits[i] = true
+				}
+			case "insertat":
+				if m.length() == 0 {
+					continue
+				}
+				i := n(ht, 0, m.length()-1)
+				what = fmt.Sprintf("InsertAt(%d) at Len %d", i, m.length())
+				b.InsertAt(uint(i))
+				m.insertAt(i)
+			case "deleteat":
+				if m.length() == 0 {
+					continue
+				}
+				i := n(ht, 0, m.length()-1)
+				what = fmt.Sprintf("DeleteAt(%d) at Len %d", i, m.length())
+				b.DeleteAt(uint(i))
+				m.deleteAt(i)
+			case "shiftleft":
+				k := pick(ht, 0, 1, 2, 7, 63, 64, 65, 128, 130, n(ht, 0, 300))
+				what = fmt.Sprintf("ShiftLeft(%d) at Len %d top %d", k, m.length(), m.top())
+				b.ShiftLeft(uint(k))
+				m.shiftLeft(k)
+			case "shiftright":
+				k := pick(ht, 0, 1, 2, 7, 63, 64, 65, 128, 130, n(ht, 0, 300))
+				what = fmt.Sprintf("ShiftRight(%d) at Len %d top %d", k, m.length(), m.top())
+				oldLen := m.length()
+				b.ShiftRight(uint(k))
+				m.shiftRight(k)
+				// The length after a right shift is implementation-defined:
+				// it must still cover the bits and not grow.
+				if int(b.Len()) > oldLen || int(b.Len()) <= m.top() {
+					fail(ht, "%s: Len %d after (was %d, top now %d)", what, b.Len(), oldLen, m.top())
+				}
+				m.bits = m.bits[:b.Len()]
+			case "shrink":
+				last := genPos(ht)
+				what = fmt.Sprintf("Shrink(%d) at Len %d", last, m.length())
+				b.Shrink(uint(last))
+				// Documented: bits above last cleared, the new length is
+				// last+1; when that needs more words than allocated it is a
+				// no-op (see README).
+				if wordsNeeded(last+1) <= wordsNeeded(m.length()) {
+					nb := make([]bool, last+1)
+					copy(nb, m.bits)
+					m.bits = nb
+				}
+			case "compact":
+				what = fmt.Sprintf("Compact at Len %d top %d", m.length(), m.top())
+				oldLen := m.length()
+				b.Compact()
+				// Documented: preserves the set bits, minimises memory; the
+				// length is word-granular (see README).
+				if int(b.Len()) <= m.top() || int(b.Len()) > max(oldLen, 64) {
+					fail(ht, "%s: Len %d after (top %d)", what, b.Len(), m.top())
+				}
+				nb := make([]bool, b.Len())
+				copy(nb, m.bits)
+				m.bits = nb
+			case "complement":
+				what = fmt.Sprintf("Complement at Len %d", m.length())
+				c := b.Complement()
+				cm := m.complement()
+				checkSet(ht, what+" result", c, cm)
+				checkSet(ht, what+" receiver unchanged", b, m)
+				b, m = c, cm
+			default:
+				what = "Clone"
+				c := b.Clone()
+				checkSet(ht, what, c, m)
+				b = c
+			}
+			note(ht, "%s", what)
+			checkSet(ht, what, b, m)
+			if chance(ht, 50) {
+				checkQueries(ht, r, what, b, m)
+			}
+		}
+	})
+}
