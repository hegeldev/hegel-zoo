+// ---------------------------------------------------------------------------
+// Property 3: Extract and Deposit (PEXT/PDEP) against the model.
+
+func TestHegelExtractAndDeposit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		src, sm, howS := genSet(ht, r)
+		mask, mm, howM := genSet(ht, r)
+		note(ht, "source: %s; mask: %s (%d set)", howS, howM, mm.count())
+		// Extract: the bits at the mask's set positions, packed.
+		packed := extract(sm, mm)
+		got := src.Extract(mask)
+		want := &model{bits: packed}
+		checkSet(ht, "Extract", got, want)
+		checkSet(ht, "Extract source unchanged", src, sm)
+		checkSet(ht, "Extract mask unchanged", mask, mm)
+		// ExtractTo into a clear destination of some length: extended to
+		// hold the packed bits, nothing else set.
+		dl := genPos(ht)
+		if Known.extractToEmptySource && sm.length() == 0 {
+			dl = max(dl, len(packed))
+		}
+		dst := bitset.New(uint(dl))
+		src.ExtractTo(mask, dst)
+		dm := newModel(max(dl, len(packed)))
+		copy(dm.bits, packed)
+		checkSet(ht, fmt.Sprintf("ExtractTo into New(%d)", dl), dst, dm)
+		// Deposit: the k-th bit of the source at the k-th set position of the
+		// mask; the result has the mask's length.
+		dep := src.Deposit(mask)
+		depm := newModel(mm.length())
+		deposit(sm, mm, depm)
+		checkSet(ht, "Deposit", dep, depm)
+		checkSet(ht, "Deposit source unchanged", src, sm)
+		// DepositTo into a destination with its own bits, at least as long
+		// as the mask: the mask positions take the source's bits, the others
+		// stay.
+		dst2, dm2, howD := genSet(ht, r)
+		if dm2.length() < mm.length() {
+			dst2.SetRange(uint(mm.length()-1), uint(mm.length()))
+			dst2.Clear(uint(mm.length() - 1))
+			dm2.extend(mm.length())
+		}
+		note(ht, "DepositTo into %s (Len %d)", howD, dm2.length())
+		if Known.depositToStopsAtSource && mm.count() > 64*wordsNeeded(sm.length()) {
+			return
+		}
+		src.DepositTo(mask, dst2)
+		deposit(sm, mm, dm2)
+		checkSet(ht, "DepositTo destination", dst2, dm2)
+	})
+}
