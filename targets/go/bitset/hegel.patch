+// ---------------------------------------------------------------------------
+// Property 3: Extract and Deposit (PEXT/PDEP) against the model.
+
+// extractCase: the source, the mask, the length of the ExtractTo destination and the DepositTo
+// destination.
+type extractCase struct {
+	src, mask setSpec
+	dl        int
+	dst       setSpec
+}
+
+var extractCases = hegel.Composite(func(tc hegel.TestCase) extractCase {
+	return extractCase{
+		src:  hegel.Draw(tc, sets),
+		mask: hegel.Draw(tc, sets),
+		dl:   hegel.Draw(tc, bitPos),
+		dst:  hegel.Draw(tc, sets),
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c extractCase) GoString() string {
+	return fmt.Sprintf("source %s; mask %s; ExtractTo into New(%d); DepositTo into %s", c.src.GoString(), c.mask.GoString(), c.dl, c.dst.GoString())
+}
+
+// TestHegelExtractAndDeposit: Extract and ExtractTo (into a clear destination of the drawn
+// length, extended to hold the packed bits; the shape of bitset/5: a source without words)
+// against PEXT, Deposit and DepositTo (into a destination with bits of its own, at least as long
+// as the mask; the shape of bitset/6: a mask with more positions than the source has allocated
+// bits) against PDEP, operands unchanged.
+func TestHegelExtractAndDeposit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, extractCases)
+		describe(c)
+		src, sm := c.src.build()
+		mask, mm := c.mask.build()
+		// Extract: the bits at the mask's set positions, packed.
+		packed := extract(sm, mm)
+		got := src.Extract(mask)
+		want := &model{bits: packed}
+		checkSet(ht, "Extract", got, want)
+		checkSet(ht, "Extract source unchanged", src, sm)
+		checkSet(ht, "Extract mask unchanged", mask, mm)
+		// ExtractTo into a clear destination of some length: extended to hold the packed bits,
+		// nothing else set. A source without words leaves the destination as it is (bitset/5);
+		// under HEGEL_NO_KNOWN=1 the destination is then long enough from the start.
+		dl := c.dl
+		shape := ""
+		if len(src.Words()) == 0 && dl < len(packed) {
+			if Known.extractToEmptySource {
+				dl = len(packed)
+			} else {
+				shape = "bitset/5"
+			}
+		}
+		dst := bitset.New(uint(dl))
+		src.ExtractTo(mask, dst)
+		dm := newModel(max(dl, len(packed)))
+		copy(dm.bits, packed)
+		checkSetOf(ht, shape, fmt.Sprintf("ExtractTo into New(%d)", dl), dst, dm)
+		// Deposit: the k-th bit of the source at the k-th set position of the mask; the result
+		// has the mask's length.
+		dep := src.Deposit(mask)
+		depm := newModel(mm.length())
+		deposit(sm, mm, depm)
+		checkSet(ht, "Deposit", dep, depm)
+		checkSet(ht, "Deposit source unchanged", src, sm)
+		// DepositTo into a destination with its own bits, at least as long as the mask: the mask
+		// positions take the source's bits, the others stay. Mask positions past the source's
+		// allocated bits keep the destination's bits instead of the source's clear ones
+		// (bitset/6); under HEGEL_NO_KNOWN=1 those positions are cleared from the mask first.
+		dst2, dm2 := c.dst.build()
+		if dm2.length() < mm.length() {
+			dst2.SetRange(uint(mm.length()-1), uint(mm.length()))
+			dst2.Clear(uint(mm.length() - 1))
+			dm2.extend(mm.length())
+		}
+		shape = ""
+		if mm.count() > 64*len(src.Words()) {
+			if Known.depositToStopsAtSource {
+				mask, mm = trimmed(mask, mm, 64*len(src.Words()))
+			} else {
+				shape = "bitset/6"
+			}
+		}
+		src.DepositTo(mask, dst2)
+		deposit(sm, mm, dm2)
+		checkSetOf(ht, shape, fmt.Sprintf("DepositTo of %d mask positions into %s (Len %d)", mm.count(), c.dst.GoString(), dm2.length()), dst2, dm2)
+	})
+}
+
+// trimmed is a copy of the mask without its positions at or beyond n (its length unchanged).
+func trimmed(mask *bitset.BitSet, mm *model, n int) (*bitset.BitSet, *model) {
+	t, tm := mask.Clone(), mm.clone()
+	for _, p := range mm.setBits() {
+		if int(p) >= n {
+			t.Clear(p)
+			tm.clear(int(p))
+		}
+	}
+	return t, tm
+}
+
+// ---------------------------------------------------------------------------
+// Property 4: the binary and JSON forms.
+
+// readKinds: how the encoding is read back.
+var readKinds = []string{"UnmarshalBinary", "ReadFrom", "ReadFrom with trailing bytes"}
+
+// headerExps: the exponent n of the length 2^n (2^64-1 for 64) a bare 8-byte header claims: 52
+// to 64, lengths whose words exceed Go's largest allocation, so that ReadFrom's make panics (the
+// shape of bitset/7; 40 to 51 would ask for 128 GiB to 128 TiB and the runtime's fatal
+// out-of-memory error would take the test binary with it, so they are not drawn); under
+// HEGEL_NO_KNOWN=1 0 to 6, lengths of one word the input cannot supply: an error.
+var headerExps = shaped(hegel.Integers(52, 64), hegel.Integers(0, 6))
+
+// headerBytes is the bare length header for the exponent in the byte order.
+func headerBytes(exp int, order binary.ByteOrder) []byte {
+	length := ^uint64(0)
+	if exp < 64 {
+		length = uint64(1) << uint(exp)
+	}
+	var hdr [8]byte
+	order.PutUint64(hdr[:], length)
+	return hdr[:]
+}
+
+// serialCase: the set, the byte order, the set read back into (nil: a fresh one) and how, where
+// the truncated copy is cut (modulo the encoding's length), the set it is read into, and the
+// exponent of an impossible length header (nil: none this case).
+type serialCase struct {
+	set    setSpec
+	little bool
+	back   *setSpec
+	how    string
+	cut    int
+	victim setSpec
+	header *int
+}
+
+var serialCases = hegel.Composite(func(tc hegel.TestCase) serialCase {
+	return serialCase{
+		set:    hegel.Draw(tc, sets),
+		little: hegel.Draw(tc, chance(30)),
+		back:   hegel.Draw(tc, optional(50, sets)),
+		how:    hegel.Draw(tc, hegel.SampledFrom(readKinds)),
+		cut:    hegel.Draw(tc, positions),
+		victim: hegel.Draw(tc, sets),
+		header: hegel.Draw(tc, optional(30, headerExps)),
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c serialCase) GoString() string {
+	order, back, header := "big-endian", "a fresh set", "no bare header"
+	if c.little {
+		order = "little-endian"
+	}
+	if c.back != nil {
+		back = c.back.GoString()
+	}
+	if c.header != nil {
+		header = fmt.Sprintf("bare header 2^%d", *c.header)
+	}
+	return fmt.Sprintf("%s; %s; %s into %s; cut %d of a copy read into %s; %s", c.set.GoString(), order, c.how, back, c.cut, c.victim.GoString(), header)
+}
+
+// TestHegelSerialization: MarshalBinary and WriteTo equal the independent encoding in both byte
+// orders and BinaryStorageSize is its size; UnmarshalBinary and ReadFrom (into a fresh or a used
+// set, with trailing bytes left in the stream) give an Equal set; MarshalJSON is the base64 of
+// the encoding and round-trips; truncated input fails and leaves the set empty or unchanged; a
+// bare header claiming a length no input could back is an error, not an allocation (the shape
+// of bitset/7: ReadFrom panics in make).
+func TestHegelSerialization(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, serialCases)
+		describe(c)
+		b, m := c.set.build()
+		order := binary.ByteOrder(binary.BigEndian)
+		if c.little {
+			bitset.LittleEndian()
+			order = binary.LittleEndian
+			defer bitset.BigEndian()
+		}
+		if got := bitset.BinaryOrder(); got != order {
+			fail(ht, "BinaryOrder %v, want %v", got, order)
+		}
+		want := m.encode(order)
+		data, err := b.MarshalBinary()
+		if err != nil || !bytes.Equal(data, want) {
+			fail(ht, "MarshalBinary = % x, %v; the format says % x", data, err, want)
+		}
+		var wbuf bytes.Buffer
+		nw, err := b.WriteTo(&wbuf)
+		if err != nil || !bytes.Equal(wbuf.Bytes(), want) || int(nw) != len(want) {
+			fail(ht, "WriteTo wrote %d bytes % x, %v; want %d bytes % x", nw, wbuf.Bytes(), err, len(want), want)
+		}
+		if got := b.BinaryStorageSize(); got != len(want) {
+			fail(ht, "BinaryStorageSize %d, the encoding has %d bytes", got, len(want))
+		}
+		// Reading back, into a fresh set or a used one.
+		back := &bitset.BitSet{}
+		if c.back != nil {
+			back, _ = c.back.build()
+		}
+		switch c.how {
+		case "UnmarshalBinary":
+			if err := back.UnmarshalBinary(want); err != nil {
+				fail(ht, "UnmarshalBinary: %v", err)
+			}
+		case "ReadFrom":
+			nr, err := back.ReadFrom(bytes.NewReader(want))
+			if err != nil || int(nr) != len(want) {
+				fail(ht, "ReadFrom read %d, %v; want %d", nr, err, len(want))
+			}
+		default:
+			// Trailing bytes belong to whatever follows in the stream.
+			extra := append(append([]byte(nil), want...), 1, 2, 3)
+			rd := bytes.NewReader(extra)
+			nr, err := back.ReadFrom(rd)
+			if err != nil || int(nr) != len(want) || rd.Len() != 3 {
+				fail(ht, "ReadFrom with trailing bytes read %d, %v, left %d; want %d and 3 left", nr, err, rd.Len(), len(want))
+			}
+		}
+		checkSet(ht, "read back", back, m)
+		if !back.Equal(b) {
+			fail(ht, "the set read back is not Equal to the original")
+		}
+		// JSON: the binary form in base64 (URL alphabet by default).
+		js, err := json.Marshal(b)
+		if err != nil {
+			fail(ht, "MarshalJSON: %v", err)
+		}
+		var s string
+		if err := json.Unmarshal(js, &s); err != nil {
+			fail(ht, "MarshalJSON gave %s, not a JSON string", js)
+		}
+		if s != base64.URLEncoding.EncodeToString(want) {
+			fail(ht, "MarshalJSON gave %q, want %q", s, base64.URLEncoding.EncodeToString(want))
+		}
+		var jback bitset.BitSet
+		if err := json.Unmarshal(js, &jback); err != nil {
+			fail(ht, "UnmarshalJSON: %v", err)
+		}
+		checkSet(ht, "JSON round trip", &jback, m)
+		// Damaged input: truncated data is an error and leaves the set empty or unchanged; a
+		// length word alone is an error too.
+		cut := want[:c.cut%len(want)]
+		victim, vm := c.victim.build()
+		if err := victim.UnmarshalBinary(cut); err == nil {
+			fail(ht, "UnmarshalBinary of %d of %d bytes succeeds", len(cut), len(want))
+		}
+		if !(victim.Len() == 0 && victim.Count() == 0) && !(int(victim.Len()) == vm.length() && victim.Count() == uint(vm.count())) {
+			fail(ht, "after a failed UnmarshalBinary the set has Len %d Count %d: neither empty nor unchanged (Len %d Count %d)", victim.Len(), victim.Count(), vm.length(), vm.count())
+		}
+		// A header claiming a length no input could back is an error, not an allocation.
+		if c.header != nil {
+			hdr := headerBytes(*c.header, order)
+			shape := shaped("bitset/7", "")
+			var err error
+			if r := catching(func() { err = (&bitset.BitSet{}).UnmarshalBinary(hdr) }); r != nil {
+				mismatch(ht, shape, "UnmarshalBinary of a bare length header % x panics: %v", hdr, r)
+			}
+			if err == nil {
+				mismatch(ht, shape, "UnmarshalBinary of a bare length header % x succeeds", hdr)
+			}
+		}
+	})
+}
+
+// catching runs fn and returns what it panicked with, nil when it returned.
+func catching(fn func()) (panicked any) {
+	defer func() { panicked = recover() }()
+	fn()
+	return nil
+}
