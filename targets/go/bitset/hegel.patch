+// ---------------------------------------------------------------------------
+// Property 5: word-level constructors and access.
+
+// wordChange: a new value for the k-th word (modulo their number) of a shared slice.
+type wordChange struct {
+	k int
+	w uint64
+}
+
+// wordsCase: the words handed to From, a change to one of them (nil: none), and the words
+// handed to SetBitsetFrom.
+type wordsCase struct {
+	words  []uint64
+	change *wordChange
+	w2     []uint64
+}
+
+var (
+	wordChanges = hegel.Composite(func(tc hegel.TestCase) wordChange {
+		return wordChange{k: hegel.Draw(tc, positions), w: hegel.Draw(tc, word64s)}
+	})
+	wordsCases = hegel.Composite(func(tc hegel.TestCase) wordsCase {
+		return wordsCase{
+			words:  hegel.Draw(tc, many(word64s, 0, 5)),
+			change: hegel.Draw(tc, optional(50, wordChanges)),
+			w2:     hegel.Draw(tc, many(word64s, 0, 4)),
+		}
+	})
+)
+
+// GoString is what the draw report prints (it uses %#v).
+func (c wordsCase) GoString() string {
+	change := "no change"
+	if c.change != nil {
+		change = fmt.Sprintf("word %d := %x", c.change.k, c.change.w)
+	}
+	return fmt.Sprintf("From(%x); %s; SetBitsetFrom(%x)", c.words, change, c.w2)
+}
+
+// TestHegelWordsAndConstructors: From shares its words (changes show through), SetBitsetFrom
+// replaces the content, writing through Words changes the set, Bytes is Words, Cap is the range
+// of uint, FromWithLength panics on a short slice.
+func TestHegelWordsAndConstructors(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wordsCases)
+		describe(c)
+		words := append([]uint64(nil), c.words...)
+		// From shares the slice: the set follows changes to it.
+		b := bitset.From(words)
+		m := modelOfWords(words, 64*len(words))
+		checkSet(ht, "From", b, m)
+		if len(words) > 0 && c.change != nil {
+			k := c.change.k % len(words)
+			words[k] = c.change.w
+			for i := 0; i < 64; i++ {
+				m.bits[64*k+i] = words[k]&(1<<i) != 0
+			}
+			checkSet(ht, "From after changing the shared word", b, m)
+		}
+		// SetBitsetFrom replaces the content.
+		w2 := append([]uint64(nil), c.w2...)
+		b.SetBitsetFrom(w2)
+		m = modelOfWords(w2, 64*len(w2))
+		checkSet(ht, "SetBitsetFrom", b, m)
+		// Words gives the representation; writing through it changes the set.
+		if len(w2) > 0 {
+			ws := b.Words()
+			ws[0] ^= 1
+			m.bits[0] = !m.bits[0]
+			checkSet(ht, "after writing through Words", b, m)
+		}
+		// Bytes is Words.
+		if got := b.Bytes(); !reflect.DeepEqual(got, b.Words()) && !(len(got) == 0 && len(b.Words()) == 0) {
+			fail(ht, "Bytes %x differs from Words %x", got, b.Words())
+		}
+		// Cap is the full range of uint.
+		if bitset.Cap() != ^uint(0) {
+			fail(ht, "Cap = %d", bitset.Cap())
+		}
+		// FromWithLength with a slice too short panics, as documented.
+		func() {
+			defer func() {
+				if recover() == nil {
+					fail(ht, "FromWithLength(65, one word) did not panic")
+				}
+			}()
+			bitset.FromWithLength(65, []uint64{0})
+		}()
+	})
+}
