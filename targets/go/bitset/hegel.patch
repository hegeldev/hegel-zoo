+package bitset_test
+
+// Hegel property tests for github.com/bits-and-blooms/bitset.
+//
+// Oracle: a model of a bitset as a slice of booleans whose length is the
+// documented Len (bits at or beyond it are clear), with every documented
+// operation written against it (set algebra, ranges, shifts, insertion and
+// deletion, rank/select, navigation, PEXT/PDEP, copying, comparison,
+// iteration and the textual forms), the binary format as WriteTo documents it
+// (a length word followed by the words, big- or little-endian), the JSON form
+// (the binary in base64 URL encoding), and the package's documented contracts.
+//
+// Every property draws one case record built from generator values: a set is
+// a setSpec (its constructor and the data handed to it, built by a pure
+// function), an operation sequence a list of op records applied in turn with
+// indices taken modulo the live length, the positional queries a list of
+// probe records resolved against the live length. The shapes of the recorded
+// bugs (bugs.toml) are drawn at their natural rate, so the properties that
+// meet them fail naming the shape and are the expected failures mapped to the
+// bugs (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over
+// its shape region alone, and hegel_pins_test.go the regression examples.
+// HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below) for a run
+// that looks past the bugs.
+//
+// Set BITSET_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/bits-and-blooms/bitset"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// generators draw the bugs' shapes and the properties that meet them fail, naming the shape
+// (mismatch); under HEGEL_NO_KNOWN=1 the gates of Known are on: the shapes are left out of the
+// generators (shaped) or stepped around in the bodies as the old test did, and a mismatch that
+// still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); on means the shape is left out,
+// which is so only under HEGEL_NO_KNOWN=1. The pin tests in hegel_pins_test.go assert the correct
+// behaviour and fail while a bug is open, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	previousBeyondLastWord bool // bitset/1: PreviousSet and PreviousClear return "not found" for an index beyond the last word
+	previousClearBeyondLen bool // bitset/2: PreviousClear returns positions at or beyond Len
+	inPlaceIntersectionLen bool // bitset/3: InPlaceIntersection keeps the longer length; Intersection the shorter
+	copyClearsPadding      bool // bitset/4: Copy clears destination bits between the source's length and the end of its last word
+	extractToEmptySource   bool // bitset/5: ExtractTo does not extend dst when the source has no words
+	depositToStopsAtSource bool // bitset/6: DepositTo leaves mask positions unchanged once the source's words run out
+	readFromTrustsLength   bool // bitset/7: ReadFrom allocates for whatever length the header claims, panicking on a huge one
+}{
+	previousBeyondLastWord: noKnown,
+	previousClearBeyondLen: noKnown,
+	inPlaceIntersectionLen: noKnown,
+	copyClearsPadding:      noKnown,
+	extractToEmptySource:   noKnown,
+	depositToStopsAtSource: noKnown,
+	readFromTrustsLength:   noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// collected is the panic value fail() raises in collect mode; property() swallows it so that the
+// case counts as passed and the run goes on.
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("BITSET_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	lastCase      string // the running case, for collect mode (the draw report prints it otherwise)
+)
+
+// describe records the drawn case for collect mode.
+func describe(c any) {
+	if collecting {
+		lastCase = fmt.Sprintf("%#v", c)
+	}
+}
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the message and
+// abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...)+"\n  case: "+lastCase)
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// mismatch reports a disagreement with the model on a case whose shape is that of the recorded
+// bug shape names ("" for none): the failure names the shape, and under HEGEL_NO_KNOWN=1 a
+// disagreement on a known shape is skipped instead (rare then, since the generators and the
+// bodies step around the shapes).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure of
+// the current test case (hegel-go re-raises panics after shrinking, which would abort the test
+// binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		lastCase = ""
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what it
+// shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// ---------------------------------------------------------------------------
+// The model.
+
+// model is a bitset as documented: Len bits, of which some are set; bits at or
+// beyond Len are clear.
+type model struct {
+	bits []bool // len(bits) == Len
+}
+
+func newModel(length int) *model { return &model{bits: make([]bool, length)} }
+
+// modelOfWords is the model of length bits read from the words.
+func modelOfWords(words []uint64, length int) *model {
+	m := newModel(length)
+	for i := range m.bits {
+		m.bits[i] = words[i/64]&(1<<(i%64)) != 0
+	}
+	return m
+}
+
+func (m *model) clone() *model { return &model{bits: append([]bool(nil), m.bits...)} }
+
+func (m *model) length() int { return len(m.bits) }
+
+func (m *model) test(i int) bool { return i >= 0 && i < len(m.bits) && m.bits[i] }
+
+// extend makes the model at least length bits long.
+func (m *model) extend(length int) {
+	for len(m.bits) < length {
+		m.bits = append(m.bits, false)
+	}
+}
+
+func (m *model) set(i int) { m.extend(i + 1); m.bits[i] = true }
+
+func (m *model) clear(i int) {
+	if i < len(m.bits) {
+		m.bits[i] = false
+	}
+}
+
+func (m *model) flip(i int) { m.extend(i + 1); m.bits[i] = !m.bits[i] }
+
+func (m *model) setRange(s, e int) {
+	if s >= e {
+		return
+	}
+	m.extend(e)
+	for i := s; i < e; i++ {
+		m.bits[i] = true
+	}
+}
+
+func (m *model) flipRange(s, e int) {
+	if s >= e {
+		return
+	}
+	m.extend(e)
+	for i := s; i < e; i++ {
+		m.bits[i] = !m.bits[i]
+	}
+}
+
+func (m *model) count() int {
+	c := 0
+	for _, b := range m.bits {
+		if b {
+			c++
+		}
+	}
+	return c
+}
+
+// top returns the highest set bit, or -1.
+func (m *model) top() int {
+	for i := len(m.bits) - 1; i >= 0; i-- {
+		if m.bits[i] {
+			return i
+		}
+	}
+	return -1
+}
+
+func (m *model) setBits() []uint {
+	var out []uint
+	for i, b := range m.bits {
+		if b {
+			out = append(out, uint(i))
+		}
+	}
+	return out
+}
+
+func (m *model) insertAt(idx int) {
+	m.bits = append(m.bits, false)
+	copy(m.bits[idx+1:], m.bits[idx:])
+	m.bits[idx] = false
+}
+
+func (m *model) deleteAt(i int) {
+	m.bits = append(m.bits[:i], m.bits[i+1:]...)
+}
+
+func (m *model) shiftLeft(k int) {
+	top := m.top()
+	if k == 0 || top < 0 {
+		return
+	}
+	nb := make([]bool, max(len(m.bits), top+k+1))
+	for i, b := range m.bits {
+		if b {
+			nb[i+k] = true
+		}
+	}
+	m.bits = nb
+}
+
+// shiftRight moves every set bit down by k; the length is left to the caller
+// (see the property: it is implementation-defined and re-synchronised).
+func (m *model) shiftRight(k int) {
+	if k == 0 || m.top() < 0 {
+		return
+	}
+	nb := make([]bool, len(m.bits))
+	for i, b := range m.bits {
+		if b && i >= k {
+			nb[i-k] = true
+		}
+	}
+	m.bits = nb
+}
+
+func (m *model) complement() *model {
+	r := newModel(len(m.bits))
+	for i, b := range m.bits {
+		r.bits[i] = !b
+	}
+	return r
+}
+
+func union(a, b *model) *model {
+	r := newModel(max(a.length(), b.length()))
+	for i := range r.bits {
+		r.bits[i] = a.test(i) || b.test(i)
+	}
+	return r
+}
+
+func intersection(a, b *model) *model {
+	r := newModel(min(a.length(), b.length()))
+	for i := range r.bits {
+		r.bits[i] = a.test(i) && b.test(i)
+	}
+	return r
+}
+
+func difference(a, b *model) *model {
+	r := newModel(a.length())
+	for i := range r.bits {
+		r.bits[i] = a.test(i) && !b.test(i)
+	}
+	return r
+}
+
+func symmetricDifference(a, b *model) *model {
+	r := newModel(max(a.length(), b.length()))
+	for i := range r.bits {
+		r.bits[i] = a.test(i) != b.test(i)
+	}
+	return r
+}
+
+func isSuperSet(a, b *model) bool {
+	for i, x := range b.bits {
+		if x && !a.test(i) {
+			return false
+		}
+	}
+	return true
+}
+
+func sameBits(a, b *model) bool { return isSuperSet(a, b) && isSuperSet(b, a) }
+
+// extract is PEXT: the bits of m at the set positions of mask, packed.
+func extract(m, mask *model) []bool {
+	var out []bool
+	for _, p := range mask.setBits() {
+		out = append(out, m.test(int(p)))
+	}
+	return out
+}
+
+// deposit is PDEP into dst: the k-th bit of m goes to the k-th set position of mask.
+func deposit(m, mask, dst *model) {
+	for k, p := range mask.setBits() {
+		if int(p) < dst.length() {
+			dst.bits[p] = m.test(k)
+		}
+	}
+}
+
+// words are the model's bits as 64-bit words, wordsNeeded(Len) of them.
+func wordsNeeded(length int) int { return (length + 63) / 64 }
+
+func (m *model) words() []uint64 {
+	out := make([]uint64, wordsNeeded(len(m.bits)))
+	for i, b := range m.bits {
+		if b {
+			out[i/64] |= 1 << (i % 64)
+		}
+	}
+	return out
+}
+
+// encode is the binary format WriteTo documents: the length as a 64-bit
+// word, then the words, in the given byte order.
+func (m *model) encode(order binary.ByteOrder) []byte {
+	var buf bytes.Buffer
+	var w [8]byte
+	order.PutUint64(w[:], uint64(len(m.bits)))
+	buf.Write(w[:])
+	for _, x := range m.words() {
+		order.PutUint64(w[:], x)
+		buf.Write(w[:])
+	}
+	return buf.Bytes()
+}
+
+func (m *model) string() string {
+	var sb strings.Builder
+	sb.WriteString("{")
+	for i, p := range m.setBits() {
+		if i > 0 {
+			sb.WriteString(",")
+		}
+		sb.WriteString(strconv.Itoa(int(p)))
+	}
+	sb.WriteString("}")
+	return sb.String()
+}
+
+func (m *model) dumpAsBits() string {
+	ws := m.words()
+	var sb strings.Builder
+	for i := len(ws) - 1; i >= 0; i-- {
+		fmt.Fprintf(&sb, "%064b.", ws[i])
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------------------
+// Comparing a BitSet with its model.
+
+// checkSet compares every observable of b with m.
+func checkSet(ht *hegel.T, what string, b *bitset.BitSet, m *model) { checkSetOf(ht, "", what, b, m) }
+
+// checkSetOf is checkSet for a case whose shape is that of the recorded bug shape names ("" for
+// none): a disagreement names the shape (see mismatch).
+func checkSetOf(ht *hegel.T, shape, what string, b *bitset.BitSet, m *model) {
+	if int(b.Len()) != m.length() {
+		mismatch(ht, shape, "%s: Len %d, model %d", what, b.Len(), m.length())
+	}
+	if int(b.Count()) != m.count() {
+		mismatch(ht, shape, "%s: Count %d, model %d", what, b.Count(), m.count())
+	}
+	limit := m.length() + 70
+	for i := 0; i < limit; i++ {
+		if b.Test(uint(i)) != m.test(i) {
+			mismatch(ht, shape, "%s: Test(%d) = %v, model %v", what, i, b.Test(uint(i)), m.test(i))
+		}
+	}
+	if b.Any() != (m.count() > 0) || b.None() != (m.count() == 0) || b.All() != (m.count() == m.length()) {
+		mismatch(ht, shape, "%s: Any %v None %v All %v with count %d of %d", what, b.Any(), b.None(), b.All(), m.count(), m.length())
+	}
+	if got := b.Words(); !reflect.DeepEqual(got, m.words()) && !(len(got) == 0 && len(m.words()) == 0) {
+		mismatch(ht, shape, "%s: Words %x, model %x", what, got, m.words())
+	}
+	want := m.setBits()
+	var got []uint
+	for i := range b.EachSet() {
+		got = append(got, i)
+	}
+	if !reflect.DeepEqual(got, want) && !(len(got) == 0 && len(want) == 0) {
+		mismatch(ht, shape, "%s: EachSet %v, model %v", what, got, want)
+	}
+	if got := b.AppendTo([]uint{7}); !reflect.DeepEqual(got, append([]uint{7}, want...)) {
+		mismatch(ht, shape, "%s: AppendTo %v, model %v", what, got, append([]uint{7}, want...))
+	}
+	if got := b.AsSlice(make([]uint, 0, len(want)+1)); !reflect.DeepEqual(got, want) && !(len(got) == 0 && len(want) == 0) {
+		mismatch(ht, shape, "%s: AsSlice %v, model %v", what, got, want)
+	}
+	if got := b.String(); got != m.string() {
+		mismatch(ht, shape, "%s: String %q, model %q", what, got, m.string())
+	}
+	if got := b.DumpAsBits(); got != m.dumpAsBits() && !(m.length() == 0 && got == ".") {
+		mismatch(ht, shape, "%s: DumpAsBits %q, model %q", what, got, m.dumpAsBits())
+	}
+	if c := b.Clone(); !c.Equal(b) || !b.Equal(c) {
+		mismatch(ht, shape, "%s: Clone is not Equal", what)
+	}
+	if got := b.BinaryStorageSize(); got != 8+8*wordsNeeded(m.length()) {
+		mismatch(ht, shape, "%s: BinaryStorageSize %d, model %d", what, got, 8+8*wordsNeeded(m.length()))
+	}
+}
+
+// previousShape names the recorded bug whose shape a Previous* query at i has: an index beyond
+// the last allocated word (bitset/1), else, for PreviousClear, one at or beyond the length
+// (bitset/2); "" within the length.
+func previousShape(b *bitset.BitSet, m *model, i int, clear bool) string {
+	switch {
+	case i >= 64*len(b.Words()):
+		return "bitset/1"
+	case clear && i >= m.length():
+		return "bitset/2"
+	}
+	return ""
+}
+
+// previousSetAgrees compares PreviousSet(i) with the model: the last set bit at or before i; a
+// disagreement names the shape.
+func previousSetAgrees(ht *hegel.T, what string, b *bitset.BitSet, m *model, i int, shape string) {
+	L := m.length()
+	wantIdx, wantOK := -1, false
+	for j := min(i, L-1); j >= 0; j-- {
+		if m.bits[j] {
+			wantIdx, wantOK = j, true
+			break
+		}
+	}
+	if got, ok := b.PreviousSet(uint(i)); ok != wantOK || (ok && int(got) != wantIdx) {
+		mismatch(ht, shape, "%s: PreviousSet(%d) = %d,%v; model %d,%v (Len %d)", what, i, got, ok, wantIdx, wantOK, L)
+	}
+}
+
+// previousClearAgrees compares PreviousClear(i) with the model: the last clear bit at or before
+// i within the length; a disagreement names the shape.
+func previousClearAgrees(ht *hegel.T, what string, b *bitset.BitSet, m *model, i int, shape string) {
+	L := m.length()
+	wantIdx, wantOK := -1, false
+	for j := min(i, L-1); j >= 0; j-- {
+		if !m.bits[j] {
+			wantIdx, wantOK = j, true
+			break
+		}
+	}
+	if got, ok := b.PreviousClear(uint(i)); ok != wantOK || (ok && int(got) != wantIdx) {
+		mismatch(ht, shape, "%s: PreviousClear(%d) = %d,%v; model %d,%v (Len %d)", what, i, got, ok, wantIdx, wantOK, L)
+	}
+}
+
+// checkPrevious runs both Previous* queries at i, naming the shape of a disagreement. Under
+// HEGEL_NO_KNOWN=1 the index is clamped below the length and an empty set is not asked (the
+// old gates of bitset/1 and bitset/2).
+func checkPrevious(ht *hegel.T, what string, b *bitset.BitSet, m *model, i int) {
+	if Known.previousBeyondLastWord || Known.previousClearBeyondLen {
+		if m.length() == 0 {
+			return
+		}
+		i = min(i, m.length()-1)
+	}
+	previousSetAgrees(ht, what, b, m, i, previousShape(b, m, i, false))
+	previousClearAgrees(ht, what, b, m, i, previousShape(b, m, i, true))
+}
+
+// zone is where a probe's index falls relative to the live length.
+type zone int
+
+const (
+	anywhere zone = iota // 0 to Len+79
+	within               // below Len (anywhere on an empty set)
+	beyond               // Len to Len+79
+)
+
+var zoneNames = [...]string{"any", "within", "beyond"}
+
+// probe is one round of positional queries: an index (at, resolved in its zone against the live
+// length), the end of an OnesBetween range (to, modulo Len+80) and the capacity of a NextSetMany
+// buffer.
+type probe struct {
+	at       int
+	zone     zone
+	to       int
+	capacity int
+}
+
+// index is the probe's index against a set of length L.
+func (p probe) index(L int) int {
+	switch {
+	case p.zone == within && L > 0:
+		return p.at % L
+	case p.zone == beyond:
+		return L + p.at%80
+	}
+	return p.at % (L + 80)
+}
+
+func (p probe) String() string {
+	return fmt.Sprintf("%s:%d/to %d/cap %d", zoneNames[p.zone], p.at, p.to, p.capacity)
+}
+
+// checkQueries compares the positional queries at the probes' positions.
+func checkQueries(ht *hegel.T, what string, b *bitset.BitSet, m *model, probes []probe, selects []int) {
+	L := m.length()
+	for _, p := range probes {
+		i := p.index(L)
+		// NextSet: the first set bit at or after i.
+		wantIdx, wantOK := -1, false
+		for j := i; j < L; j++ {
+			if m.bits[j] {
+				wantIdx, wantOK = j, true
+				break
+			}
+		}
+		if got, ok := b.NextSet(uint(i)); ok != wantOK || (ok && int(got) != wantIdx) {
+			fail(ht, "%s: NextSet(%d) = %d,%v; model %d,%v", what, i, got, ok, wantIdx, wantOK)
+		}
+		// NextClear: the first clear bit in [i, Len).
+		wantIdx, wantOK = -1, false
+		for j := i; j < L; j++ {
+			if !m.bits[j] {
+				wantIdx, wantOK = j, true
+				break
+			}
+		}
+		if got, ok := b.NextClear(uint(i)); ok != wantOK || (ok && int(got) != wantIdx) {
+			fail(ht, "%s: NextClear(%d) = %d,%v; model %d,%v", what, i, got, ok, wantIdx, wantOK)
+		}
+		checkPrevious(ht, what, b, m, i)
+		// Rank: set bits at or below i.
+		rank := 0
+		for j := 0; j <= i && j < L; j++ {
+			if m.bits[j] {
+				rank++
+			}
+		}
+		if got := b.Rank(uint(i)); int(got) != rank {
+			fail(ht, "%s: Rank(%d) = %d, model %d", what, i, got, rank)
+		}
+		// OnesBetween.
+		to := p.to % (L + 80)
+		ones := 0
+		for j := i; j < to && j < L; j++ {
+			if m.bits[j] {
+				ones++
+			}
+		}
+		if got := b.OnesBetween(uint(i), uint(to)); int(got) != ones {
+			fail(ht, "%s: OnesBetween(%d, %d) = %d, model %d", what, i, to, got, ones)
+		}
+		// GetWord64AtBit.
+		var word uint64
+		for j := 0; j < 64; j++ {
+			if m.test(i + j) {
+				word |= 1 << j
+			}
+		}
+		if got := b.GetWord64AtBit(uint(i)); got != word {
+			fail(ht, "%s: GetWord64AtBit(%d) = %x, model %x", what, i, got, word)
+		}
+		// NextSetMany.
+		var wantMany []uint
+		for j := i; j < L && len(wantMany) < p.capacity; j++ {
+			if m.bits[j] {
+				wantMany = append(wantMany, uint(j))
+			}
+		}
+		last, got := b.NextSetMany(uint(i), make([]uint, 0, p.capacity))
+		if !reflect.DeepEqual(got, wantMany) && !(len(got) == 0 && len(wantMany) == 0) {
+			fail(ht, "%s: NextSetMany(%d, cap %d) = %v, model %v", what, i, p.capacity, got, wantMany)
+		}
+		if len(wantMany) > 0 && last != wantMany[len(wantMany)-1] {
+			fail(ht, "%s: NextSetMany(%d, cap %d) returns last %d, want %d", what, i, p.capacity, last, wantMany[len(wantMany)-1])
+		}
+	}
+	// Select: the j-th set bit (j modulo the count plus two); Len when out of range.
+	set := m.setBits()
+	for _, s := range selects {
+		j := s % (len(set) + 2)
+		want := uint(L)
+		if j < len(set) {
+			want = set[j]
+		}
+		if got := b.Select(uint(j)); got != want {
+			fail(ht, "%s: Select(%d) = %d, model %d", what, j, got, want)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+var (
+	// posEdges: bit positions at and around word boundaries.
+	posEdges = []int{0, 1, 62, 63, 64, 65, 127, 128, 129, 191, 192, 255, 256, 511, 512, 1000}
+	// bitPos: a bit position: within 200 three times in five, an edge seven times in twenty-five,
+	// else within 5000.
+	bitPos = weighted(choice[int]{60, hegel.Integers(0, 200)}, choice[int]{28, hegel.SampledFrom(posEdges)}, choice[int]{12, hegel.Integers(0, 5000)})
+	// positions: an index into live data of unknown size, taken modulo the size when applied (so
+	// every drawn value fits and the shrinker is free).
+	positions = hegel.Integers(0, 9999)
+	// word64s: a word: zero or all ones half of the time, random otherwise.
+	word64s = weighted(choice[uint64]{1, hegel.SampledFrom([]uint64{0, ^uint64(0)})}, choice[uint64]{1, hegel.Integers[uint64](0, math.MaxUint64)})
+	zones   = hegel.SampledFrom([]zone{anywhere, within, beyond})
+	probes  = hegel.Composite(func(tc hegel.TestCase) probe {
+		return probe{at: hegel.Draw(tc, positions), zone: hegel.Draw(tc, zones), to: hegel.Draw(tc, positions), capacity: hegel.Draw(tc, hegel.Integers(0, 4))}
+	})
+)
+
+// fill is one way a New set is filled: a bit at a position (modulo Len+100, so a fill may extend
+// the set), a range (its ends modulo Len+50), or a byte pattern tiled across the length.
+type fillKind int
+
+const (
+	fillBit fillKind = iota
+	fillRange
+	fillTile
+)
+
+type fill struct {
+	kind    fillKind
+	a, b    int
+	pattern []byte
+}
+
+func (f fill) String() string {
+	switch f.kind {
+	case fillBit:
+		return fmt.Sprintf("Set(%d)", f.a)
+	case fillRange:
+		return fmt.Sprintf("SetRange(%d, %d)", f.a, f.b)
+	}
+	return fmt.Sprintf("Tile(%x)", f.pattern)
+}
+
+// apply fills b (of constructor length) and m alike.
+func (f fill) apply(b *bitset.BitSet, m *model, length int) {
+	switch f.kind {
+	case fillBit:
+		i := f.a % (length + 100)
+		b.Set(uint(i))
+		m.set(i)
+	case fillRange:
+		s, e := f.a%(length+50), f.b%(length+50)
+		b.SetRange(uint(s), uint(e))
+		m.setRange(s, e)
+	default:
+		for i := 0; i < length; i++ {
+			if f.pattern[(i/8)%len(f.pattern)]>>(i%8)&1 != 0 {
+				b.Set(uint(i))
+				m.set(i)
+			}
+		}
+	}
+}
+
+var fills = weighted(
+	choice[fill]{1, hegel.Map(positions, func(a int) fill { return fill{kind: fillBit, a: a} })},
+	choice[fill]{1, hegel.Composite(func(tc hegel.TestCase) fill {
+		return fill{kind: fillRange, a: hegel.Draw(tc, positions), b: hegel.Draw(tc, positions)}
+	})},
+	choice[fill]{1, hegel.Map(hegel.Binary(1, 8), func(p []byte) fill { return fill{kind: fillTile, pattern: p} })},
+)
+
+// setSpec is a set as drawn: its constructor and the data handed to it. build makes the BitSet
+// and its model afresh each time.
+type setKind int
+
+const (
+	kindNew        setKind = iota // New(length), then the fills
+	kindZero                      // the zero value
+	kindMust                      // MustNew(length)
+	kindFrom                      // From(words)
+	kindFromLength                // FromWithLength(64*(len(words)-1)+length, words): length bits of the last word
+)
+
+type setSpec struct {
+	kind   setKind
+	length int
+	words  []uint64
+	fills  []fill
+}
+
+func (s setSpec) build() (*bitset.BitSet, *model) {
+	switch s.kind {
+	case kindZero:
+		return &bitset.BitSet{}, newModel(0)
+	case kindMust:
+		return bitset.MustNew(uint(s.length)), newModel(s.length)
+	case kindFrom:
+		ws := append([]uint64(nil), s.words...)
+		return bitset.From(ws), modelOfWords(ws, 64*len(ws))
+	case kindFromLength:
+		ws := append([]uint64(nil), s.words...)
+		length := 64*(len(ws)-1) + s.length
+		// Bits beyond the length must be clear in the words handed over.
+		for i := length; i < 64*len(ws); i++ {
+			ws[i/64] &^= 1 << (i % 64)
+		}
+		return bitset.FromWithLength(uint(length), ws), modelOfWords(ws, length)
+	}
+	b, m := bitset.New(uint(s.length)), newModel(s.length)
+	for _, f := range s.fills {
+		f.apply(b, m, s.length)
+	}
+	return b, m
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (s setSpec) GoString() string {
+	switch s.kind {
+	case kindZero:
+		return "zero value"
+	case kindMust:
+		return fmt.Sprintf("MustNew(%d)", s.length)
+	case kindFrom:
+		return fmt.Sprintf("From(%x)", s.words)
+	case kindFromLength:
+		return fmt.Sprintf("FromWithLength(%d, %x)", 64*(len(s.words)-1)+s.length, s.words)
+	}
+	return fmt.Sprintf("New(%d)%v", s.length, s.fills)
+}
+
+// newSetsOf: New sets of the lengths with up to four fills.
+func newSetsOf(lengths hegel.Generator[int]) hegel.Generator[setSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) setSpec {
+		return setSpec{kind: kindNew, length: hegel.Draw(tc, lengths), fills: hegel.Draw(tc, hegel.Lists(fills).MaxSize(4))}
+	})
+}
+
+// mustSetsOf: MustNew sets of the lengths.
+func mustSetsOf(lengths hegel.Generator[int]) hegel.Generator[setSpec] {
+	return hegel.Map(lengths, func(l int) setSpec { return setSpec{kind: kindMust, length: l} })
+}
+
+// fromSetsOf: From sets over the word lists.
+func fromSetsOf(wordLists hegel.Generator[[]uint64]) hegel.Generator[setSpec] {
+	return hegel.Map(wordLists, func(ws []uint64) setSpec { return setSpec{kind: kindFrom, words: ws} })
+}
+
+var (
+	zeroSets = hegel.Just(setSpec{kind: kindZero})
+	// fromLengthSets: one to six words with one to 64 bits of the last word in use.
+	fromLengthSets = hegel.Composite(func(tc hegel.TestCase) setSpec {
+		return setSpec{kind: kindFromLength, words: hegel.Draw(tc, many(word64s, 1, 6)), length: hegel.Draw(tc, hegel.Integers(1, 64))}
+	})
+	// sets: a set by one of the constructors, New twice as often as the rest.
+	sets = weighted(
+		choice[setSpec]{2, newSetsOf(bitPos)},
+		choice[setSpec]{1, zeroSets},
+		choice[setSpec]{1, mustSetsOf(bitPos)},
+		choice[setSpec]{1, fromSetsOf(many(word64s, 0, 6))},
+		choice[setSpec]{1, fromLengthSets},
+	)
+)
+
+// ---------------------------------------------------------------------------
+// Property 1: single-set operations against the model.
+
+type opKind int
+
+const (
+	opSet opKind = iota
+	opClear
+	opFlip
+	opSetTo
+	opSetRange
+	opFlipRange
+	opClearAll
+	opSetAll
+	opInsertAt
+	opDeleteAt
+	opShiftLeft
+	opShiftRight
+	opShrink
+	opCompact
+	opComplement
+	opClone
+)
+
+var opNames = [...]string{"Set", "Clear", "Flip", "SetTo", "SetRange", "FlipRange", "ClearAll", "SetAll", "InsertAt", "DeleteAt", "ShiftLeft", "ShiftRight", "Shrink", "Compact", "Complement", "Clone"}
+
+// op is one step of a sequence; only the fields its kind uses are drawn. InsertAt and DeleteAt
+// take their index modulo the live length when applied (a no-op on an empty set, as documented
+// they are exercised below the length only).
+type op struct {
+	kind opKind
+	a, b int
+	v    bool
+}
+
+func (o op) String() string {
+	switch o.kind {
+	case opSet, opClear, opFlip, opShrink, opInsertAt, opDeleteAt, opShiftLeft, opShiftRight:
+		return fmt.Sprintf("%s(%d)", opNames[o.kind], o.a)
+	case opSetTo:
+		return fmt.Sprintf("SetTo(%d, %v)", o.a, o.v)
+	case opSetRange, opFlipRange:
+		return fmt.Sprintf("%s(%d, %d)", opNames[o.kind], o.a, o.b)
+	}
+	return opNames[o.kind]
+}
+
+// atPos is an op of the kind at one of the positions; ranged one over two bit positions; bare
+// one without arguments.
+func atPos(kind opKind, pos hegel.Generator[int]) hegel.Generator[op] {
+	return hegel.Map(pos, func(i int) op { return op{kind: kind, a: i} })
+}
+
+func ranged(kind opKind) hegel.Generator[op] {
+	return hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: kind, a: hegel.Draw(tc, bitPos), b: hegel.Draw(tc, bitPos)}
+	})
+}
+
+func bare(kind opKind) hegel.Generator[op] { return hegel.Just(op{kind: kind}) }
+
+var (
+	// shifts: a shift distance: at or around a word boundary nine times in ten, else within 300.
+	shifts = weighted(choice[int]{9, hegel.SampledFrom([]int{0, 1, 2, 7, 63, 64, 65, 128, 130})}, choice[int]{1, hegel.Integers(0, 300)})
+	setTos = hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opSetTo, a: hegel.Draw(tc, bitPos), v: hegel.Draw(tc, chance(50))}
+	})
+	// ops: the steps of a sequence, Set twice as often as the rest.
+	ops = weighted(
+		choice[op]{2, atPos(opSet, bitPos)},
+		choice[op]{1, atPos(opClear, bitPos)},
+		choice[op]{1, atPos(opFlip, bitPos)},
+		choice[op]{1, setTos},
+		choice[op]{1, ranged(opSetRange)},
+		choice[op]{1, ranged(opFlipRange)},
+		choice[op]{1, bare(opClearAll)},
+		choice[op]{1, bare(opSetAll)},
+		choice[op]{1, atPos(opInsertAt, positions)},
+		choice[op]{1, atPos(opDeleteAt, positions)},
+		choice[op]{1, atPos(opShiftLeft, shifts)},
+		choice[op]{1, atPos(opShiftRight, shifts)},
+		choice[op]{1, atPos(opShrink, bitPos)},
+		choice[op]{1, bare(opCompact)},
+		choice[op]{1, bare(opComplement)},
+		choice[op]{1, bare(opClone)},
+	)
+)
+
+// apply runs the step on the set and the model, checking what the step itself promises, and
+// returns the live pair (Complement and Clone replace it) with a description of the step.
+func (o op) apply(ht *hegel.T, b *bitset.BitSet, m *model) (*bitset.BitSet, *model, string) {
+	what := fmt.Sprintf("%v at Len %d", o, m.length())
+	switch o.kind {
+	case opSet:
+		if got := b.Set(uint(o.a)); got != b {
+			fail(ht, "%s did not return its receiver", what)
+		}
+		m.set(o.a)
+	case opClear:
+		b.Clear(uint(o.a))
+		m.clear(o.a)
+	case opFlip:
+		b.Flip(uint(o.a))
+		m.flip(o.a)
+	case opSetTo:
+		b.SetTo(uint(o.a), o.v)
+		if o.v {
+			m.set(o.a)
+		} else {
+			m.clear(o.a)
+		}
+	case opSetRange:
+		b.SetRange(uint(o.a), uint(o.b))
+		m.setRange(o.a, o.b)
+	case opFlipRange:
+		b.FlipRange(uint(o.a), uint(o.b))
+		m.flipRange(o.a, o.b)
+	case opClearAll:
+		b.ClearAll()
+		for i := range m.bits {
+			m.bits[i] = false
+		}
+	case opSetAll:
+		b.SetAll()
+		for i := range m.bits {
+			m.bits[i] = true
+		}
+	case opInsertAt:
+		if m.length() == 0 {
+			return b, m, what + " (empty set: no-op)"
+		}
+		i := o.a % m.length()
+		what = fmt.Sprintf("InsertAt(%d) at Len %d", i, m.length())
+		b.InsertAt(uint(i))
+		m.insertAt(i)
+	case opDeleteAt:
+		if m.length() == 0 {
+			return b, m, what + " (empty set: no-op)"
+		}
+		i := o.a % m.length()
+		what = fmt.Sprintf("DeleteAt(%d) at Len %d", i, m.length())
+		b.DeleteAt(uint(i))
+		m.deleteAt(i)
+	case opShiftLeft:
+		what = fmt.Sprintf("ShiftLeft(%d) at Len %d top %d", o.a, m.length(), m.top())
+		b.ShiftLeft(uint(o.a))
+		m.shiftLeft(o.a)
+	case opShiftRight:
+		what = fmt.Sprintf("ShiftRight(%d) at Len %d top %d", o.a, m.length(), m.top())
+		oldLen := m.length()
+		b.ShiftRight(uint(o.a))
+		m.shiftRight(o.a)
+		// The length after a right shift is implementation-defined: it must still cover the
+		// bits and not grow.
+		if int(b.Len()) > oldLen || int(b.Len()) <= m.top() {
+			fail(ht, "%s: Len %d after (was %d, top now %d)", what, b.Len(), oldLen, m.top())
+		}
+		m.bits = m.bits[:b.Len()]
+	case opShrink:
+		b.Shrink(uint(o.a))
+		// Documented: bits above last cleared, the new length is last+1; when that needs more
+		// words than allocated it is a no-op (see README).
+		if wordsNeeded(o.a+1) <= wordsNeeded(m.length()) {
+			nb := make([]bool, o.a+1)
+			copy(nb, m.bits)
+			m.bits = nb
+		}
+	case opCompact:
+		what = fmt.Sprintf("Compact at Len %d top %d", m.length(), m.top())
+		oldLen := m.length()
+		b.Compact()
+		// Documented: preserves the set bits, minimises memory; the length is word-granular (see
+		// README).
+		if int(b.Len()) <= m.top() || int(b.Len()) > max(oldLen, 64) {
+			fail(ht, "%s: Len %d after (top %d)", what, b.Len(), m.top())
+		}
+		nb := make([]bool, b.Len())
+		copy(nb, m.bits)
+		m.bits = nb
+	case opComplement:
+		c := b.Complement()
+		cm := m.complement()
+		checkSet(ht, what+" result", c, cm)
+		checkSet(ht, what+" receiver unchanged", b, m)
+		return c, cm, what
+	case opClone:
+		c := b.Clone()
+		checkSet(ht, what, c, m)
+		return c, m, what
+	}
+	return b, m, what
+}
+
+// singleCase: a set, one to twenty-five steps, and the positional queries run after every step.
+type singleCase struct {
+	start   setSpec
+	ops     []op
+	probes  []probe
+	selects []int
+}
+
+var singleCases = hegel.Composite(func(tc hegel.TestCase) singleCase {
+	return singleCase{
+		start:   hegel.Draw(tc, sets),
+		ops:     hegel.Draw(tc, many(ops, 1, 25)),
+		probes:  hegel.Draw(tc, many(probes, 0, 6)),
+		selects: hegel.Draw(tc, many(positions, 0, 3)),
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c singleCase) GoString() string {
+	return fmt.Sprintf("%s; ops %v; probes %v; selects %v", c.start.GoString(), c.ops, c.probes, c.selects)
+}
+
+// TestHegelSingleSetOperations: a set from one of the constructors, then the steps in turn;
+// after each, every observable agrees with the model, and so do the positional queries at the
+// probes' positions (the shapes of bitset/1 and bitset/2, a Previous* query beyond the last word
+// or at or beyond the length, are drawn at their natural rate).
+func TestHegelSingleSetOperations(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, singleCases)
+		describe(c)
+		b, m := c.start.build()
+		checkSet(ht, "initial", b, m)
+		for _, o := range c.ops {
+			var what string
+			b, m, what = o.apply(ht, b, m)
+			checkSet(ht, what, b, m)
+			checkQueries(ht, what, b, m, c.probes, c.selects)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 2: two-set operations against the model.
+
+// setOp is one of the four algebraic operations with its cardinality and in-place forms and its
+// model.
+type setOp struct {
+	fn   func(*bitset.BitSet, *bitset.BitSet) *bitset.BitSet
+	card func(*bitset.BitSet, *bitset.BitSet) uint
+	inpl func(*bitset.BitSet, *bitset.BitSet)
+	md   func(*model, *model) *model
+}
+
+var (
+	setOpNames = []string{"Union", "Intersection", "Difference", "SymmetricDifference"}
+	setOps     = map[string]setOp{
+		"Union":               {(*bitset.BitSet).Union, (*bitset.BitSet).UnionCardinality, (*bitset.BitSet).InPlaceUnion, union},
+		"Intersection":        {(*bitset.BitSet).Intersection, (*bitset.BitSet).IntersectionCardinality, (*bitset.BitSet).InPlaceIntersection, intersection},
+		"Difference":          {(*bitset.BitSet).Difference, (*bitset.BitSet).DifferenceCardinality, (*bitset.BitSet).InPlaceDifference, difference},
+		"SymmetricDifference": {(*bitset.BitSet).SymmetricDifference, (*bitset.BitSet).SymmetricDifferenceCardinality, (*bitset.BitSet).InPlaceSymmetricDifference, symmetricDifference},
+	}
+)
+
+// copyStep: no copy, Copy into dst, or CopyFull into dst.
+type copyKind int
+
+const (
+	noCopy copyKind = iota
+	copyBits
+	copyFull
+)
+
+type copyStep struct {
+	kind copyKind
+	dst  setSpec
+}
+
+func (s copyStep) String() string {
+	switch s.kind {
+	case copyBits:
+		return "Copy into " + s.dst.GoString()
+	case copyFull:
+		return "CopyFull into " + s.dst.GoString()
+	}
+	return "no copy"
+}
+
+var copySteps = hegel.OneOf(
+	hegel.Just(copyStep{}),
+	hegel.Map(sets, func(dst setSpec) copyStep { return copyStep{kind: copyBits, dst: dst} }),
+	hegel.Map(sets, func(dst setSpec) copyStep { return copyStep{kind: copyFull, dst: dst} }),
+)
+
+// twoCase: two sets (the second a clone of the first 15% of the time), the operation, and the
+// copy step.
+type twoCase struct {
+	a, c setSpec
+	same bool
+	op   string
+	copy copyStep
+}
+
+var twoCases = hegel.Composite(func(tc hegel.TestCase) twoCase {
+	return twoCase{
+		a:    hegel.Draw(tc, sets),
+		c:    hegel.Draw(tc, sets),
+		same: hegel.Draw(tc, chance(15)),
+		op:   hegel.Draw(tc, hegel.SampledFrom(setOpNames)),
+		copy: hegel.Draw(tc, copySteps),
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c twoCase) GoString() string {
+	other := c.c.GoString()
+	if c.same {
+		other = "a clone of a"
+	}
+	return fmt.Sprintf("a %s; c %s; %s; %v", c.a.GoString(), other, c.op, c.copy)
+}
+
+// TestHegelTwoSetOperations: Equal, IsSuperSet and IsStrictSuperSet against the model; one of
+// Union, Intersection, Difference and SymmetricDifference with its cardinality (operands
+// unchanged) and its in-place form, which must be Equal to the functional result (the shape of
+// bitset/3: InPlaceIntersection of sets of different lengths); Copy (the returned count, the
+// copied bits, the rest of the destination untouched; the shape of bitset/4: a destination longer
+// than a source whose length is not a multiple of 64) and CopyFull.
+func TestHegelTwoSetOperations(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, twoCases)
+		describe(tcase)
+		a, am := tcase.a.build()
+		c, cm := tcase.c.build()
+		if tcase.same {
+			c, cm = a.Clone(), am.clone()
+		}
+		checkSet(ht, "a", a, am)
+		checkSet(ht, "c", c, cm)
+		// Comparisons.
+		if got := a.Equal(c); got != (am.length() == cm.length() && sameBits(am, cm)) {
+			fail(ht, "Equal = %v; model lengths %d %d same bits %v", got, am.length(), cm.length(), sameBits(am, cm))
+		}
+		if got := a.IsSuperSet(c); got != isSuperSet(am, cm) {
+			fail(ht, "IsSuperSet = %v, model %v", got, isSuperSet(am, cm))
+		}
+		if got := a.IsStrictSuperSet(c); got != (isSuperSet(am, cm) && !sameBits(am, cm)) {
+			fail(ht, "IsStrictSuperSet = %v, model %v", got, isSuperSet(am, cm) && !sameBits(am, cm))
+		}
+		// The functional operation and its cardinality.
+		name := tcase.op
+		o := setOps[name]
+		want := o.md(am, cm)
+		res := o.fn(a, c)
+		checkSet(ht, name+" result", res, want)
+		checkSet(ht, name+" left operand unchanged", a, am)
+		checkSet(ht, name+" right operand unchanged", c, cm)
+		if got := o.card(a, c); int(got) != want.count() {
+			fail(ht, "%sCardinality = %d, model %d", name, got, want.count())
+		}
+		// In place: the same set as the functional result. InPlaceIntersection keeps the longer
+		// length where Intersection keeps the shorter (bitset/3); under HEGEL_NO_KNOWN=1 it is
+		// compared bit by bit at whichever length it has.
+		x := a.Clone()
+		o.inpl(x, c)
+		if Known.inPlaceIntersectionLen && name == "Intersection" {
+			xm := want.clone()
+			xm.extend(max(am.length(), cm.length()))
+			if int(x.Len()) != xm.length() {
+				xm = want.clone()
+			}
+			checkSet(ht, "InPlaceIntersection (bits only)", x, xm)
+		} else if !x.Equal(res) {
+			shape := ""
+			if name == "Intersection" && am.length() != cm.length() {
+				shape = "bitset/3"
+			}
+			mismatch(ht, shape, "InPlace%s gives Len %d %s, the functional result Len %d %s", name, x.Len(), x.String(), res.Len(), res.String())
+		}
+		checkSet(ht, "InPlace"+name+" right operand unchanged", c, cm)
+		// Copy and CopyFull.
+		switch tcase.copy.kind {
+		case copyBits:
+			dst, dm := tcase.copy.dst.build()
+			// The shape of bitset/4: a destination longer than a source whose length is not a
+			// multiple of 64 (its bits between the source's length and the end of the source's
+			// last word are cleared); under HEGEL_NO_KNOWN=1 the destination is a clone of the
+			// source instead.
+			shape := ""
+			if am.length() < dm.length() && am.length()%64 != 0 {
+				if Known.copyClearsPadding {
+					dst, dm = a.Clone(), am.clone()
+				} else {
+					shape = "bitset/4"
+				}
+			}
+			count := a.Copy(dst)
+			k := min(am.length(), dm.length())
+			if int(count) != k {
+				fail(ht, "Copy returned %d, want min(%d, %d) = %d", count, am.length(), dm.length(), k)
+			}
+			for i := 0; i < k; i++ {
+				dm.bits[i] = am.bits[i]
+			}
+			checkSetOf(ht, shape, "Copy destination", dst, dm)
+			checkSet(ht, "Copy source unchanged", a, am)
+		case copyFull:
+			dst, _ := tcase.copy.dst.build()
+			a.CopyFull(dst)
+			checkSet(ht, "CopyFull destination", dst, am)
+			if !dst.Equal(a) {
+				fail(ht, "CopyFull destination is not Equal to the source")
+			}
+		}
+	})
+}
