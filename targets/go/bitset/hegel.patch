+// ---------------------------------------------------------------------------
+// Property 4: the binary and JSON forms.
+
+func TestHegelSerialization(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		b, m, how := genSet(ht, r)
+		note(ht, "%s", how)
+		order := binary.ByteOrder(binary.BigEndian)
+		if chance(ht, 30) {
+			bitset.LittleEndian()
+			order = binary.LittleEndian
+			defer bitset.BigEndian()
+			note(ht, "little-endian")
+		}
+		if got := bitset.BinaryOrder(); got != order {
+			fail(ht, "BinaryOrder %v, want %v", got, order)
+		}
+		want := m.encode(order)
+		data, err := b.MarshalBinary()
+		if err != nil || !bytes.Equal(data, want) {
+			fail(ht, "MarshalBinary = % x, %v; the format says % x", data, err, want)
+		}
+		var wbuf bytes.Buffer
+		nw, err := b.WriteTo(&wbuf)
+		if err != nil || !bytes.Equal(wbuf.Bytes(), want) || int(nw) != len(want) {
+			fail(ht, "WriteTo wrote %d bytes % x, %v; want %d bytes % x", nw, wbuf.Bytes(), err, len(want), want)
+		}
+		if got := b.BinaryStorageSize(); got != len(want) {
+			fail(ht, "BinaryStorageSize %d, the encoding has %d bytes", got, len(want))
+		}
+		// Reading back, into a fresh set or a used one.
+		var back *bitset.BitSet
+		if chance(ht, 50) {
+			back = &bitset.BitSet{}
+		} else {
+			back, _, _ = genSet(ht, r)
+		}
+		switch pick(ht, "unmarshal", "readfrom", "readfrom-extra") {
+		case "unmarshal":
+			if err := back.UnmarshalBinary(want); err != nil {
+				fail(ht, "UnmarshalBinary: %v", err)
+			}
+		case "readfrom":
+			nr, err := back.ReadFrom(bytes.NewReader(want))
+			if err != nil || int(nr) != len(want) {
+				fail(ht, "ReadFrom read %d, %v; want %d", nr, err, len(want))
+			}
+		default:
+			// Trailing bytes belong to whatever follows in the stream.
+			extra := append(append([]byte(nil), want...), 1, 2, 3)
+			rd := bytes.NewReader(extra)
+			nr, err := back.ReadFrom(rd)
+			if err != nil || int(nr) != len(want) || rd.Len() != 3 {
+				fail(ht, "ReadFrom with trailing bytes read %d, %v, left %d; want %d and 3 left", nr, err, rd.Len(), len(want))
+			}
+		}
+		checkSet(ht, "read back", back, m)
+		if !back.Equal(b) {
+			fail(ht, "the set read back is not Equal to the original")
+		}
+		// JSON: the binary form in base64 (URL alphabet by default).
+		js, err := json.Marshal(b)
+		if err != nil {
+			fail(ht, "MarshalJSON: %v", err)
+		}
+		var s string
+		if err := json.Unmarshal(js, &s); err != nil {
+			fail(ht, "MarshalJSON gave %s, not a JSON string", js)
+		}
+		if s != base64.URLEncoding.EncodeToString(want) {
+			fail(ht, "MarshalJSON gave %q, want %q", s, base64.URLEncoding.EncodeToString(want))
+		}
+		var jback bitset.BitSet
+		if err := json.Unmarshal(js, &jback); err != nil {
+			fail(ht, "UnmarshalJSON: %v", err)
+		}
+		checkSet(ht, "JSON round trip", &jback, m)
+		// Damaged input: truncated data is an error and leaves the set
+		// empty or unchanged; a length word alone is an error too.
+		if len(want) > 0 {
+			cut := want[:n(ht, 0, len(want)-1)]
+			victim, vm, _ := genSet(ht, r)
+			err := victim.UnmarshalBinary(cut)
+			if err == nil {
+				fail(ht, "UnmarshalBinary of %d of %d bytes succeeds", len(cut), len(want))
+			}
+			if !(victim.Len() == 0 && victim.Count() == 0) && !(int(victim.Len()) == vm.length() && victim.Count() == uint(vm.count())) {
+				fail(ht, "after a failed UnmarshalBinary the set has Len %d Count %d: neither empty nor unchanged (Len %d Count %d)", victim.Len(), victim.Count(), vm.length(), vm.count())
+			}
+		}
+		// A header claiming a length no input could back is an error, not
+		// an allocation.
+		if !Known.readFromTrustsLength && chance(ht, 30) {
+			var hdr [8]byte
+			order.PutUint64(hdr[:], uint64(1)<<uint(n(ht, 40, 63)))
+			if err := (&bitset.BitSet{}).UnmarshalBinary(hdr[:]); err == nil {
+				fail(ht, "UnmarshalBinary of a bare length header % x succeeds", hdr)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 5: word-level constructors and access.
+
+func TestHegelWordsAndConstructors(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		words := make([]uint64, n(ht, 0, 5))
+		for i := range words {
+			words[i] = r.Uint64()
+		}
+		// From shares the slice: the set follows changes to it.
+		b := bitset.From(words)
+		m := newModel(64 * len(words))
+		for i := range m.bits {
+			m.bits[i] = words[i/64]&(1<<(i%64)) != 0
+		}
+		note(ht, "From(%d words)", len(words))
+		checkSet(ht, "From", b, m)
+		if len(words) > 0 && chance(ht, 50) {
+			k := n(ht, 0, len(words)-1)
+			words[k] = r.Uint64()
+			for i := 0; i < 64; i++ {
+				m.bits[64*k+i] = words[k]&(1<<i) != 0
+			}
+			checkSet(ht, "From after changing the shared word", b, m)
+		}
+		// SetBitsetFrom replaces the content.
+		w2 := make([]uint64, n(ht, 0, 4))
+		for i := range w2 {
+			w2[i] = r.Uint64()
+		}
+		b.SetBitsetFrom(w2)
+		m = newModel(64 * len(w2))
+		for i := range m.bits {
+			m.bits[i] = w2[i/64]&(1<<(i%64)) != 0
+		}
+		checkSet(ht, "SetBitsetFrom", b, m)
+		// Words gives the representation; writing through it changes the set.
+		if len(w2) > 0 {
+			ws := b.Words()
+			ws[0] ^= 1
+			m.bits[0] = !m.bits[0]
+			checkSet(ht, "after writing through Words", b, m)
+		}
+		// Bytes is Words.
+		if got := b.Bytes(); !reflect.DeepEqual(got, b.Words()) && !(len(got) == 0 && len(b.Words()) == 0) {
+			fail(ht, "Bytes %x differs from Words %x", got, b.Words())
+		}
+		// Cap is the full range of uint.
+		if bitset.Cap() != ^uint(0) {
+			fail(ht, "Cap = %d", bitset.Cap())
+		}
+		// FromWithLength with a slice too short panics, as documented.
+		func() {
+			defer func() {
+				if recover() == nil {
+					fail(ht, "FromWithLength(65, one word) did not panic")
+				}
+			}()
+			bitset.FromWithLength(65, []uint64{0})
+		}()
+	})
+}
