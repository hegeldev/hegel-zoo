diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..cd99081
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,167 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml cli/1 ...), each asserting the documented
+// behaviour; they fail while the bug exists and are listed as expected failures in target.toml.
+
+import (
+	"context"
+	"io"
+	"reflect"
+	"testing"
+
+	"github.com/urfave/cli/v3"
+)
+
+// hzPinRun runs cmd on args with the help hidden and the errors returned as they are; it
+// returns the positional arguments the innermost Action received, or the error.
+func hzPinRun(cmd *cli.Command, args ...string) (ran string, got []string, err error) {
+	var setup func(c *cli.Command, path string)
+	setup = func(c *cli.Command, path string) {
+		c.HideHelp = true
+		c.Writer, c.ErrWriter = io.Discard, io.Discard
+		c.OnUsageError = func(ctx context.Context, cmd *cli.Command, err error, isSub bool) error { return err }
+		if c.Action == nil {
+			c.Action = func(ctx context.Context, cmd *cli.Command) error {
+				ran = path
+				got = cmd.Args().Slice()
+				return nil
+			}
+		}
+		for _, sub := range c.Commands {
+			setup(sub, path+" "+sub.Name)
+		}
+	}
+	setup(cmd, "app")
+	cmd.ExitErrHandler = func(context.Context, *cli.Command, error) {}
+	err = cmd.Run(context.Background(), append([]string{"app"}, args...))
+	return ran, got, err
+}
+
+// TestHegelPinDashKeepsRest: cli/1. A lone "-" is a positional argument (stdin by convention);
+// the arguments after it are still there, and flags among them are still parsed ("flags can
+// appear anywhere").
+func TestHegelPinDashKeepsRest(t *testing.T) {
+	cmd := &cli.Command{Flags: []cli.Flag{&cli.StringFlag{Name: "lang"}}}
+	_, args, err := hzPinRun(cmd, "-", "file.txt", "--lang", "fr")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"-", "file.txt"}; !reflect.DeepEqual(args, want) || cmd.String("lang") != "fr" {
+		t.Errorf("app - file.txt --lang fr: Args() = %q, lang = %q; want %q and \"fr\"", args, cmd.String("lang"), want)
+	}
+}
+
+// TestHegelPinCombinedShortValueFlag: cli/2. In a combined short-option token (UseShortOption-
+// Handling) every letter is a flag; a flag that takes a value and is not the last letter is
+// either an error or takes the value - it must not be silently ignored.
+func TestHegelPinCombinedShortValueFlag(t *testing.T) {
+	cmd := &cli.Command{
+		UseShortOptionHandling: true,
+		Flags: []cli.Flag{
+			&cli.StringFlag{Name: "out", Aliases: []string{"o"}},
+			&cli.BoolFlag{Name: "verbose", Aliases: []string{"v"}},
+		},
+	}
+	_, args, err := hzPinRun(cmd, "-ov", "file.txt")
+	if err != nil {
+		return // an error is acceptable
+	}
+	if !cmd.IsSet("out") {
+		t.Errorf("-ov file.txt with -o taking a value: no error, out not set, verbose=%v, Args() = %q", cmd.Bool("verbose"), args)
+	}
+}
+
+// TestHegelPinCombinedShortInverseFlag: cli/3. A BoolWithInverseFlag's alias in a combined
+// short-option token sets the flag, as the alias alone does; only the "no-" form sets it to
+// false.
+func TestHegelPinCombinedShortInverseFlag(t *testing.T) {
+	cmd := &cli.Command{
+		UseShortOptionHandling: true,
+		Flags: []cli.Flag{
+			&cli.BoolWithInverseFlag{Name: "color", Aliases: []string{"c"}},
+			&cli.BoolFlag{Name: "verbose", Aliases: []string{"v"}},
+		},
+	}
+	if _, _, err := hzPinRun(cmd, "-cv"); err != nil {
+		t.Fatal(err)
+	}
+	if !cmd.Bool("color") {
+		t.Errorf("-cv with -c a BoolWithInverseFlag: color = false (IsSet %v); -c alone gives true", cmd.IsSet("color"))
+	}
+}
+
+// TestHegelPinLocalFlagNotInSubcommand: cli/4. A Local flag of the parent is not applied to
+// its subcommands, in the combined short-option form as in the long form.
+func TestHegelPinLocalFlagNotInSubcommand(t *testing.T) {
+	cmd := &cli.Command{
+		UseShortOptionHandling: true,
+		Flags:                  []cli.Flag{&cli.StringFlag{Name: "loc", Aliases: []string{"L"}, Local: true}},
+		Commands:               []*cli.Command{{Name: "sub"}},
+	}
+	_, _, errLong := hzPinRun(cmd, "sub", "--loc", "x")
+	cmd2 := &cli.Command{
+		UseShortOptionHandling: true,
+		Flags:                  []cli.Flag{&cli.StringFlag{Name: "loc", Aliases: []string{"L"}, Local: true}},
+		Commands:               []*cli.Command{{Name: "sub"}},
+	}
+	_, _, errShort := hzPinRun(cmd2, "sub", "-L", "x")
+	if (errLong == nil) != (errShort == nil) {
+		t.Errorf("Local flag --loc/-L from the subcommand: --loc x gives %v, -L x gives %v (loc = %q)", errLong, errShort, cmd2.String("loc"))
+	}
+}
+
+// TestHegelPinDoubleDashEndsCommands: cli/5. "--" ends the flag parsing: what follows are
+// positional arguments of the current command, not a subcommand and its flags.
+func TestHegelPinDoubleDashEndsCommands(t *testing.T) {
+	cmd := &cli.Command{
+		Flags:    []cli.Flag{&cli.StringFlag{Name: "lang"}},
+		Commands: []*cli.Command{{Name: "sub"}},
+	}
+	ran, args, err := hzPinRun(cmd, "--", "sub", "--lang", "fr")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"sub", "--lang", "fr"}; ran != "app" || !reflect.DeepEqual(args, want) {
+		t.Errorf("app -- sub --lang fr: ran %q with Args() %q, lang = %q; want the root with %q", ran, args, cmd.String("lang"), want)
+	}
+}
+
+// TestHegelPinCommandNameAfterPositional: cli/6. Only the first positional argument names a
+// subcommand; a later argument that happens to equal a subcommand's name is an ordinary
+// positional, and the flags after it are still parsed.
+func TestHegelPinCommandNameAfterPositional(t *testing.T) {
+	cmd := &cli.Command{
+		Flags:    []cli.Flag{&cli.StringFlag{Name: "lang"}},
+		Commands: []*cli.Command{{Name: "sub"}},
+	}
+	ran, args, err := hzPinRun(cmd, "foo", "sub", "--lang", "fr")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"foo", "sub"}; ran != "app" || !reflect.DeepEqual(args, want) || cmd.String("lang") != "fr" {
+		t.Errorf("app foo sub --lang fr: ran %q with Args() %q, lang = %q; want the root with %q and \"fr\"", ran, args, cmd.String("lang"), want)
+	}
+}
+
+// TestHegelPinTwoFormsOfOneFlag: cli/7. "giving two different forms of the same flag in the
+// same command invocation is an error" (docs/v3/examples/flags/advanced.md).
+func TestHegelPinTwoFormsOfOneFlag(t *testing.T) {
+	cmd := &cli.Command{Flags: []cli.Flag{&cli.StringFlag{Name: "lang", Aliases: []string{"l"}}}}
+	_, _, err := hzPinRun(cmd, "--lang", "fr", "-l", "de")
+	if err == nil {
+		t.Errorf("--lang fr -l de: no error, lang = %q; the documentation says two forms of one flag are an error", cmd.String("lang"))
+	}
+}
+
+// TestHegelPinInverseFlagGet: cli/8. Flag.Get returns the flag's value; before any run it is
+// the default (FlagBase.Get), for a BoolWithInverseFlag as for the others.
+func TestHegelPinInverseFlagGet(t *testing.T) {
+	f := &cli.BoolWithInverseFlag{Name: "color", Value: true}
+	var v any
+	if r := hzCatch(func() { v = f.Get() }); r != nil {
+		t.Fatalf("BoolWithInverseFlag{Value: true}.Get() before a run: panic %v", r)
+	}
+	if v != true {
+		t.Errorf("BoolWithInverseFlag{Value: true}.Get() = %v, want true", v)
+	}
+}
diff --git a/hegel/hegel_zoo_run_test.go b/hegel/hegel_zoo_run_test.go
new file mode 100644
index 0000000..33c922b
--- /dev/null
+++ b/hegel/hegel_zoo_run_test.go
@@ -0,0 +1,1268 @@
+package hegel
+
+// Command.Run over a generated command tree and argument list against a model of the documented
+// command-line grammar (docs/v3/examples/flags/*.md, arguments/advanced.md, subcommands/basics.md
+// and the doc comments of Command and FlagBase).
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/urfave/cli/v3"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- specs
+
+const (
+	hzKBool = iota
+	hzKString
+	hzKInt
+	hzKInt8
+	hzKUint16
+	hzKFloat
+	hzKDuration
+	hzKStrings
+	hzKInts
+	hzKMap
+	hzKBoolInv
+	hzKCount
+)
+
+var hzKindNames = []string{"bool", "string", "int", "int8", "uint16", "float", "duration", "strings", "ints", "map", "boolinv"}
+
+type hzFlagSpec struct {
+	kind     int
+	name     string
+	aliases  []string
+	local    bool
+	onlyOnce bool
+	required bool
+	def      string // default value ("" for the zero value)
+	id       int    // position in the tree's flag list
+}
+
+// names lists the flag's names as Flag.Names() does (the inverse forms after the plain ones).
+func (s *hzFlagSpec) names() []string {
+	ns := append([]string{s.name}, s.aliases...)
+	if s.kind == hzKBoolInv {
+		for _, n := range append([]string{s.name}, s.aliases...) {
+			ns = append(ns, "no-"+n)
+		}
+	}
+	return ns
+}
+
+func (s *hzFlagSpec) isBool() bool { return s.kind == hzKBool || s.kind == hzKBoolInv }
+
+func (s *hzFlagSpec) String() string {
+	var opts []string
+	if s.local {
+		opts = append(opts, "local")
+	}
+	if s.onlyOnce {
+		opts = append(opts, "once")
+	}
+	if s.required {
+		opts = append(opts, "required")
+	}
+	if s.def != "" {
+		opts = append(opts, "default="+s.def)
+	}
+	return fmt.Sprintf("%s:%s%v %s", hzKindNames[s.kind], s.name, s.aliases, strings.Join(opts, ","))
+}
+
+const (
+	hzAInt = iota
+	hzAString
+	hzAStrings
+	hzAInts
+)
+
+type hzArgSpec struct {
+	kind     int
+	name     string
+	required bool // single arguments
+	min, max int  // multi arguments
+}
+
+func (a *hzArgSpec) String() string {
+	switch a.kind {
+	case hzAInt:
+		return fmt.Sprintf("IntArg(%s,req=%v)", a.name, a.required)
+	case hzAString:
+		return fmt.Sprintf("StringArg(%s,req=%v)", a.name, a.required)
+	case hzAStrings:
+		return fmt.Sprintf("StringArgs(%s,%d..%d)", a.name, a.min, a.max)
+	}
+	return fmt.Sprintf("IntArgs(%s,%d..%d)", a.name, a.min, a.max)
+}
+
+type hzGroupSpec struct {
+	lists    [][]*hzFlagSpec
+	required bool
+}
+
+type hzCmdSpec struct {
+	name     string
+	aliases  []string
+	flags    []*hzFlagSpec // Command.Flags
+	groups   []*hzGroupSpec
+	args     []*hzArgSpec
+	subs     []*hzCmdSpec
+	shortOpt bool
+	stopN    *int
+	parent   *hzCmdSpec
+}
+
+// allFlags is Command.allFlags(): Flags, then the mutually exclusive groups' flags.
+func (c *hzCmdSpec) allFlags() []*hzFlagSpec {
+	fs := append([]*hzFlagSpec{}, c.flags...)
+	for _, g := range c.groups {
+		for _, l := range g.lists {
+			fs = append(fs, l...)
+		}
+	}
+	return fs
+}
+
+func (c *hzCmdSpec) path() string {
+	if c.parent == nil {
+		return c.name
+	}
+	return c.parent.path() + " " + c.name
+}
+
+func (c *hzCmdSpec) describe(indent string) string {
+	var sb strings.Builder
+	opts := ""
+	if c.shortOpt {
+		opts += " short"
+	}
+	if c.stopN != nil {
+		opts += fmt.Sprintf(" stopN=%d", *c.stopN)
+	}
+	fmt.Fprintf(&sb, "%scmd %s%v%s\n", indent, c.name, c.aliases, opts)
+	for _, f := range c.flags {
+		fmt.Fprintf(&sb, "%s  flag %s\n", indent, f)
+	}
+	for _, g := range c.groups {
+		fmt.Fprintf(&sb, "%s  group required=%v\n", indent, g.required)
+		for _, l := range g.lists {
+			for _, f := range l {
+				fmt.Fprintf(&sb, "%s    flag %s\n", indent, f)
+			}
+			fmt.Fprintf(&sb, "%s    |\n", indent)
+		}
+	}
+	for _, a := range c.args {
+		fmt.Fprintf(&sb, "%s  arg %s\n", indent, a)
+	}
+	for _, s := range c.subs {
+		sb.WriteString(s.describe(indent + "  "))
+	}
+	return sb.String()
+}
+
+// --------------------------------------------------------------------------- the real tree
+
+// hzRealTree holds the cli.Command built from a spec and the record its Actions write.
+type hzRealTree struct {
+	root   *cli.Command
+	flags  map[*hzFlagSpec]cli.Flag
+	ran    *hzCmdSpec
+	args   []string
+	argVal []string
+}
+
+func hzBuildFlag(s *hzFlagSpec) cli.Flag {
+	switch s.kind {
+	case hzKBool:
+		return &cli.BoolFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required, Value: s.def == "true"}
+	case hzKString:
+		return &cli.StringFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required, Value: s.def}
+	case hzKInt:
+		v, _ := strconv.Atoi(s.def)
+		return &cli.IntFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required, Value: v}
+	case hzKInt8:
+		return &cli.Int8Flag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required}
+	case hzKUint16:
+		return &cli.Uint16Flag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required}
+	case hzKFloat:
+		return &cli.FloatFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required}
+	case hzKDuration:
+		return &cli.DurationFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required}
+	case hzKStrings:
+		var def []string
+		if s.def != "" {
+			def = strings.Split(s.def, ",")
+		}
+		return &cli.StringSliceFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required, Value: def}
+	case hzKInts:
+		return &cli.IntSliceFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required}
+	case hzKMap:
+		return &cli.StringMapFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required}
+	case hzKBoolInv:
+		return &cli.BoolWithInverseFlag{Name: s.name, Aliases: s.aliases, Local: s.local, OnlyOnce: s.onlyOnce, Required: s.required, Value: s.def == "true"}
+	}
+	panic("kind")
+}
+
+func hzBuildArg(a *hzArgSpec) cli.Argument {
+	switch a.kind {
+	case hzAInt:
+		return &cli.IntArg{Name: a.name, Required: a.required}
+	case hzAString:
+		return &cli.StringArg{Name: a.name, Required: a.required}
+	case hzAStrings:
+		return &cli.StringArgs{Name: a.name, Min: a.min, Max: a.max}
+	}
+	return &cli.IntArgs{Name: a.name, Min: a.min, Max: a.max}
+}
+
+func (rt *hzRealTree) build(s *hzCmdSpec) *cli.Command {
+	c := &cli.Command{Name: s.name, Aliases: s.aliases, HideHelp: true, UseShortOptionHandling: s.shortOpt}
+	if s.stopN != nil {
+		n := *s.stopN
+		c.StopOnNthArg = &n
+	}
+	for _, fs := range s.flags {
+		f := hzBuildFlag(fs)
+		rt.flags[fs] = f
+		c.Flags = append(c.Flags, f)
+	}
+	for _, g := range s.groups {
+		grp := cli.MutuallyExclusiveFlags{Required: g.required}
+		for _, l := range g.lists {
+			var fl []cli.Flag
+			for _, fs := range l {
+				f := hzBuildFlag(fs)
+				rt.flags[fs] = f
+				fl = append(fl, f)
+			}
+			grp.Flags = append(grp.Flags, fl)
+		}
+		c.MutuallyExclusiveFlags = append(c.MutuallyExclusiveFlags, grp)
+	}
+	for _, a := range s.args {
+		c.Arguments = append(c.Arguments, hzBuildArg(a))
+	}
+	for _, sub := range s.subs {
+		c.Commands = append(c.Commands, rt.build(sub))
+	}
+	spec := s
+	c.Action = func(ctx context.Context, cmd *cli.Command) error {
+		rt.ran = spec
+		rt.args = cmd.Args().Slice()
+		for _, a := range spec.args {
+			switch a.kind {
+			case hzAInt:
+				rt.argVal = append(rt.argVal, fmt.Sprint(cmd.IntArg(a.name)))
+			case hzAString:
+				rt.argVal = append(rt.argVal, fmt.Sprintf("%q", cmd.StringArg(a.name)))
+			case hzAStrings:
+				rt.argVal = append(rt.argVal, fmt.Sprintf("%q", cmd.StringArgs(a.name)))
+			case hzAInts:
+				rt.argVal = append(rt.argVal, fmt.Sprint(cmd.IntArgs(a.name)))
+			}
+		}
+		return nil
+	}
+	c.OnUsageError = func(ctx context.Context, cmd *cli.Command, err error, isSub bool) error { return err }
+	c.Writer, c.ErrWriter = io.Discard, io.Discard
+	return c
+}
+
+func hzNewRealTree(s *hzCmdSpec) *hzRealTree {
+	rt := &hzRealTree{flags: map[*hzFlagSpec]cli.Flag{}}
+	rt.root = rt.build(s)
+	rt.root.ExitErrHandler = func(context.Context, *cli.Command, error) {}
+	return rt
+}
+
+// hzFlagState prints a flag's value, IsSet and Count. Get on a BoolWithInverseFlag that no
+// command has run panics (bug cli/N); the default is reported then.
+func hzFlagState(fs *hzFlagSpec, f cli.Flag) string {
+	count := 0
+	if c, ok := f.(cli.Countable); ok {
+		count = c.Count()
+	}
+	var v any
+	if r := hzCatch(func() { v = f.Get() }); r != nil {
+		if _, ok := f.(*cli.BoolWithInverseFlag); ok && HZKnown.inverseGetPanics {
+			v = fs.def == "true"
+		} else {
+			v = fmt.Sprintf("panic: %v", r)
+		}
+	}
+	return fmt.Sprintf("%v set=%v count=%d", v, f.IsSet(), count)
+}
+
+// --------------------------------------------------------------------------- the model
+
+type hzMFlag struct {
+	spec  *hzFlagSpec
+	val   any
+	set   bool
+	count int
+	init  bool // slices and maps: the first Set replaces the default
+	pset  bool // BoolWithInverse: the positive form was set
+	nset  bool // BoolWithInverse: the inverse form was set
+}
+
+func hzNewMFlag(s *hzFlagSpec) *hzMFlag {
+	m := &hzMFlag{spec: s}
+	switch s.kind {
+	case hzKBool, hzKBoolInv:
+		m.val = s.def == "true"
+	case hzKString:
+		m.val = s.def
+	case hzKInt:
+		v, _ := strconv.Atoi(s.def)
+		m.val = v
+	case hzKInt8:
+		m.val = int8(0)
+	case hzKUint16:
+		m.val = uint16(0)
+	case hzKFloat:
+		m.val = float64(0)
+	case hzKDuration:
+		m.val = time.Duration(0)
+	case hzKStrings:
+		var def []string
+		if s.def != "" {
+			def = strings.Split(s.def, ",")
+		}
+		m.val = def
+	case hzKInts:
+		m.val = []int(nil)
+	case hzKMap:
+		m.val = map[string]string(nil)
+	}
+	return m
+}
+
+func (m *hzMFlag) state() string {
+	return fmt.Sprintf("%v set=%v count=%d", m.val, m.set, m.count)
+}
+
+func hzHasName(names []string, n string) bool {
+	for _, x := range names {
+		if x == n {
+			return true
+		}
+	}
+	return false
+}
+
+// setValue parses one value into the flag as the flag's Value type does.
+func (m *hzMFlag) setValue(val string) error {
+	switch m.spec.kind {
+	case hzKBool:
+		b, err := strconv.ParseBool(val)
+		if err != nil {
+			return errors.New("parse error")
+		}
+		m.val = b
+	case hzKString:
+		m.val = val
+	case hzKInt:
+		n, err := strconv.ParseInt(val, 0, 64)
+		if err != nil {
+			return err
+		}
+		m.val = int(n)
+	case hzKInt8:
+		n, err := strconv.ParseInt(val, 0, 8)
+		if err != nil {
+			return err
+		}
+		m.val = int8(n)
+	case hzKUint16:
+		n, err := strconv.ParseUint(val, 0, 16)
+		if err != nil {
+			return err
+		}
+		m.val = uint16(n)
+	case hzKFloat:
+		f, err := strconv.ParseFloat(val, 64)
+		if err != nil {
+			return err
+		}
+		m.val = f
+	case hzKDuration:
+		d, err := time.ParseDuration(val)
+		if err != nil {
+			return err
+		}
+		m.val = d
+	case hzKStrings:
+		if !m.init {
+			m.val = []string{}
+			m.init = true
+		}
+		m.val = append(m.val.([]string), strings.Split(val, ",")...)
+	case hzKInts:
+		if !m.init {
+			m.val = []int{}
+			m.init = true
+		}
+		for _, s := range strings.Split(val, ",") {
+			n, err := strconv.ParseInt(strings.TrimSpace(s), 0, 64)
+			if err != nil {
+				return err
+			}
+			m.val = append(m.val.([]int), int(n))
+		}
+	case hzKMap:
+		if !m.init {
+			m.val = map[string]string{}
+			m.init = true
+		}
+		for _, item := range strings.Split(val, ",") {
+			k, v, ok := strings.Cut(item, "=")
+			if !ok {
+				return fmt.Errorf("item %q is missing separator %q", item, "=")
+			}
+			m.val.(map[string]string)[k] = v
+		}
+	}
+	return nil
+}
+
+// Set is Flag.Set(name, val): FlagBase.Set for the ordinary flags, BoolWithInverseFlag.Set for
+// the inverse ones.
+func (m *hzMFlag) Set(name, val string) error {
+	if m.spec.kind == hzKBoolInv {
+		if m.count > 0 && m.spec.onlyOnce {
+			return errors.New("can't duplicate this flag")
+		}
+		m.set = true
+		positive := hzHasName(append([]string{m.spec.name}, m.spec.aliases...), name)
+		both := fmt.Errorf("cannot set both flags `--%s` and `--%s`", m.spec.name, "no-"+m.spec.name)
+		if positive {
+			if m.nset {
+				return both
+			}
+			if err := m.setBool(val); err != nil {
+				return err
+			}
+			m.pset = true
+		} else {
+			if m.pset {
+				return both
+			}
+			m.val = false
+			m.nset = true
+		}
+		m.count++
+		return nil
+	}
+	if m.count == 1 && m.spec.onlyOnce {
+		return errors.New("can't duplicate this flag")
+	}
+	m.count++
+	if err := m.setValue(val); err != nil {
+		return err
+	}
+	m.set = true
+	return nil
+}
+
+func (m *hzMFlag) setBool(val string) error {
+	b, err := strconv.ParseBool(val)
+	if err != nil {
+		return errors.New("parse error")
+	}
+	m.val = b
+	return nil
+}
+
+type hzMCmd struct {
+	spec    *hzCmdSpec
+	flags   []*hzMFlag // allFlags order
+	subs    []*hzMCmd
+	parent  *hzMCmd
+	applied []*hzMFlag
+	dashAt  int // index in the positionals where the arguments after "--" start (-1: none)
+}
+
+func hzNewModel(s *hzCmdSpec, parent *hzMCmd, all map[*hzFlagSpec]*hzMFlag) *hzMCmd {
+	m := &hzMCmd{spec: s, parent: parent}
+	for _, fs := range s.allFlags() {
+		f := hzNewMFlag(fs)
+		all[fs] = f
+		m.flags = append(m.flags, f)
+	}
+	for _, sub := range s.subs {
+		m.subs = append(m.subs, hzNewModel(sub, m, all))
+	}
+	return m
+}
+
+func (c *hzMCmd) command(name string) *hzMCmd {
+	for _, s := range c.subs {
+		if s.spec.name == name || hzHasName(s.spec.aliases, name) {
+			return s
+		}
+	}
+	return nil
+}
+
+// lFlag: a flag of this command by name.
+func (c *hzMCmd) lFlag(name string) *hzMFlag {
+	for _, f := range c.flags {
+		if hzHasName(f.spec.names(), name) {
+			return f
+		}
+	}
+	return nil
+}
+
+// lookupFlag: a flag by name over the lineage (Command.lookupFlag).
+func (c *hzMCmd) lookupFlag(name string) *hzMFlag {
+	for p := c; p != nil; p = p.parent {
+		if f := p.lFlag(name); f != nil {
+			return f
+		}
+	}
+	return nil
+}
+
+func (c *hzMCmd) lookupApplied(name string) *hzMFlag {
+	for _, f := range c.applied {
+		if hzHasName(f.spec.names(), name) {
+			return f
+		}
+	}
+	return nil
+}
+
+func (c *hzMCmd) useShort() bool {
+	for p := c; p != nil; p = p.parent {
+		if p.spec.shortOpt {
+			return true
+		}
+	}
+	return false
+}
+
+type hzResult struct {
+	path   string
+	args   []string
+	argVal []string
+	err    string
+}
+
+func (r hzResult) String() string {
+	if r.err != "" {
+		return "error: " + r.err
+	}
+	return fmt.Sprintf("ran %s args=%q argvals=%v", r.path, r.args, r.argVal)
+}
+
+const (
+	hzNotDefined = "flag provided but not defined: -"
+	hzNeedsArg   = "flag needs an argument: "
+)
+
+func hzSetErr(val, name string, err error) error {
+	return fmt.Errorf("invalid value %q for flag -%s: %v", val, name, err)
+}
+
+// parseFlags is the model of Command.parseFlags: the documented grammar with the recorded
+// deviations behind switches.
+func (c *hzMCmd) parseFlags(rargs []string) ([]string, error) {
+	c.applied = append([]*hzMFlag{}, c.flags...)
+	for p := c.parent; p != nil; p = p.parent {
+		for _, f := range p.flags {
+			if f.spec.local {
+				continue
+			}
+			shadowed := false
+			for _, n := range f.spec.names() {
+				if c.lFlag(n) != nil {
+					shadowed = true
+					break
+				}
+			}
+			if !shadowed {
+				c.applied = append(c.applied, f)
+			}
+		}
+	}
+	pos := []string{}
+	c.dashAt = -1
+	for i := 0; i < len(rargs); i++ {
+		raw := rargs[i]
+		first := strings.TrimSpace(raw)
+		if first == "" {
+			pos = append(pos, raw)
+			continue
+		}
+		if first == "--" {
+			c.dashAt = len(pos)
+			return append(pos, rargs[i+1:]...), nil
+		}
+		if c.spec.stopN != nil && len(pos) == *c.spec.stopN {
+			return append(pos, rargs[i:]...), nil
+		}
+		if first[0] != '-' {
+			if c.command(first) != nil && (len(pos) == 0 || HZKnown.commandNameStopsParsing) {
+				return append(pos, rargs[i:]...), nil
+			}
+			pos = append(pos, raw)
+			continue
+		}
+		if len(first) == 1 {
+			pos = append(pos, first)
+			if HZKnown.dashDropsRest {
+				return pos, nil
+			}
+			continue
+		}
+		numMinuses := 1
+		short := c.useShort()
+		if first[1] == '-' {
+			numMinuses = 2
+			short = false
+		} else if r, _ := utf8.DecodeRuneInString(first[1:]); !unicode.IsLetter(r) {
+			// a negative number or the like: not a flag, and the parsing stops
+			return append(pos, rargs[i:]...), nil
+		}
+		flagName := first[numMinuses:]
+		flagVal := ""
+		fromEq := false
+		if idx := strings.Index(flagName, "="); idx != -1 {
+			_, flagVal, _ = strings.Cut(raw, "=")
+			flagName = flagName[:idx]
+			fromEq = true
+		}
+		if f := c.lookupApplied(flagName); f != nil {
+			if f.spec.isBool() {
+				if flagVal == "" {
+					flagVal = "true"
+				}
+				if err := f.Set(flagName, flagVal); err != nil {
+					return pos, hzSetErr(flagVal, flagName, err)
+				}
+				continue
+			}
+			if flagVal == "" && !fromEq {
+				if i == len(rargs)-1 {
+					return pos, errors.New(hzNeedsArg + first)
+				}
+				flagVal = rargs[i+1]
+				i++
+			}
+			if err := f.Set(flagName, flagVal); err != nil {
+				return pos, hzSetErr(flagVal, flagName, err)
+			}
+			continue
+		}
+		if !short {
+			return pos, errors.New(hzNotDefined + flagName)
+		}
+		// combined short options: every letter a flag
+		runes := []rune(flagName)
+		for index, r := range runes {
+			ch := string(r)
+			var sf *hzMFlag
+			if HZKnown.combinedShortsSeeLocalFlags {
+				sf = c.lookupFlag(ch)
+			} else {
+				sf = c.lookupApplied(ch)
+			}
+			if sf == nil {
+				return pos, errors.New(hzNotDefined + flagName)
+			}
+			last := index == len(runes)-1
+			if sf.spec.isBool() {
+				fv := flagVal
+				if fv == "" {
+					fv = "true"
+				}
+				setName := flagName
+				if !HZKnown.combinedInverseSetsFalse {
+					setName = ch
+				}
+				if err := sf.Set(setName, fv); err != nil {
+					return pos, hzSetErr(fv, flagName, err)
+				}
+			} else if last {
+				if flagVal == "" {
+					if i == len(rargs)-1 {
+						return pos, errors.New(hzNeedsArg + ch)
+					}
+					flagVal = rargs[i+1]
+					i++
+				}
+				if err := sf.Set(flagName, flagVal); err != nil {
+					return pos, hzSetErr(flagVal, flagName, err)
+				}
+			} else {
+				// a value-taking flag that is not the last letter is skipped
+				hzCombinedSkipped++
+			}
+		}
+	}
+	return pos, nil
+}
+
+var hzCombinedSkipped int
+
+func (g *hzGroupSpec) check(all map[*hzFlagSpec]*hzMFlag) error {
+	firstName, firstIdx := "", -1
+	for i, l := range g.lists {
+		for _, fs := range l {
+			if all[fs].set {
+				firstName, firstIdx = fs.names()[0], i
+				break
+			}
+		}
+		if firstIdx >= 0 {
+			break
+		}
+	}
+	if firstIdx >= 0 {
+		for _, l := range g.lists[firstIdx+1:] {
+			for _, fs := range l {
+				if all[fs].set {
+					return fmt.Errorf("option %s cannot be set along with option %s", firstName, fs.names()[0])
+				}
+			}
+		}
+		return nil
+	}
+	if g.required {
+		var parts []string
+		for _, l := range g.lists {
+			var ns []string
+			for _, fs := range l {
+				ns = append(ns, fs.names()...)
+			}
+			parts = append(parts, strings.Join(ns, " "))
+		}
+		return fmt.Errorf("one of these flags needs to be provided: %s", strings.Join(parts, ", "))
+	}
+	return nil
+}
+
+func hzRequiredErr(kind string, names []string) error {
+	if len(names) == 1 {
+		return fmt.Errorf("Required %s %q not set", kind, names[0])
+	}
+	return fmt.Errorf("Required %ss %q not set", kind, strings.Join(names, ", "))
+}
+
+// run is the model of Command.run for a command whose name has been consumed.
+func (c *hzMCmd) run(args []string, all map[*hzFlagSpec]*hzMFlag) hzResult {
+	pos, err := c.parseFlags(args)
+	if err != nil {
+		return hzResult{err: err.Error()}
+	}
+	for p := c; p != nil; p = p.parent {
+		for _, g := range p.spec.groups {
+			if err := g.check(all); err != nil {
+				return hzResult{err: err.Error()}
+			}
+		}
+	}
+	if len(pos) > 0 && (c.dashAt != 0 || HZKnown.dashDashDispatches) {
+		if sub := c.command(pos[0]); sub != nil {
+			return sub.run(pos[1:], all)
+		}
+	}
+	for p := c; p != nil; p = p.parent {
+		var missing []string
+		for _, f := range p.applied {
+			if f.spec.required && !f.set {
+				missing = append(missing, f.spec.names()[0])
+			}
+		}
+		if len(missing) > 0 {
+			return hzResult{err: hzRequiredErr("flag", missing).Error()}
+		}
+	}
+	// required single arguments by position
+	var missing []string
+	for i, a := range c.spec.args {
+		if (a.kind == hzAInt || a.kind == hzAString) && a.required && i >= len(pos) {
+			missing = append(missing, a.name)
+		}
+	}
+	if len(missing) > 0 {
+		return hzResult{err: hzRequiredErr("argument", missing).Error()}
+	}
+	res := hzResult{path: c.spec.path()}
+	rest := pos
+	for _, a := range c.spec.args {
+		switch a.kind {
+		case hzAInt, hzAString:
+			if a.required && len(rest) == 0 {
+				return hzResult{err: hzRequiredErr("argument", []string{a.name}).Error()}
+			}
+			if a.kind == hzAInt {
+				n := 0
+				if len(rest) > 0 {
+					v, err := strconv.ParseInt(rest[0], 0, 64)
+					if err != nil {
+						return hzResult{err: fmt.Sprintf("invalid value %q for argument %s: %v", rest[0], a.name, err)}
+					}
+					n = int(v)
+				}
+				res.argVal = append(res.argVal, fmt.Sprint(n))
+			} else {
+				s := ""
+				if len(rest) > 0 {
+					s = rest[0]
+				}
+				res.argVal = append(res.argVal, fmt.Sprintf("%q", s))
+			}
+			if len(rest) > 0 {
+				rest = rest[1:]
+			}
+		case hzAStrings, hzAInts:
+			if a.max == 0 {
+				return hzResult{err: fmt.Sprintf("args %s has max 0, not parsing argument", a.name)}
+			}
+			if a.max != -1 && a.min > a.max {
+				return hzResult{err: fmt.Sprintf("args %s has min[%d] > max[%d], not parsing argument", a.name, a.min, a.max)}
+			}
+			count := 0
+			var ss []string
+			var ns []int
+			for _, s := range rest {
+				if a.kind == hzAInts {
+					v, err := strconv.ParseInt(s, 0, 64)
+					if err != nil {
+						return hzResult{err: fmt.Sprintf("invalid value %q for argument %s: %v", s, a.name, err)}
+					}
+					ns = append(ns, int(v))
+				} else {
+					ss = append(ss, s)
+				}
+				count++
+				if count >= a.max && a.max > -1 {
+					break
+				}
+			}
+			if count < a.min {
+				return hzResult{err: fmt.Sprintf("sufficient count of arg %s not provided, given %d expected %d", a.name, count, a.min)}
+			}
+			if a.kind == hzAInts {
+				if ns == nil {
+					ns = []int{}
+				}
+				res.argVal = append(res.argVal, fmt.Sprint(ns))
+			} else {
+				if ss == nil {
+					ss = []string{}
+				}
+				res.argVal = append(res.argVal, fmt.Sprintf("%q", ss))
+			}
+			rest = rest[count:]
+		}
+	}
+	res.args = rest
+	return res
+}
+
+// --------------------------------------------------------------------------- generators
+
+var hzLongNames = []string{"alpha", "beta", "gamma", "delta", "lang", "out", "num", "size", "mode", "color"}
+var hzAliasChars = []string{"a", "b", "c", "d", "x", "o", "n", "s"}
+var hzCmdNames = [][]string{{"sub", "s"}, {"run", "r"}, {"add"}, {"list", "ls"}}
+
+var hzKindWeights = []int{22, 18, 10, 5, 5, 5, 5, 8, 5, 5, 12}
+
+func hzDrawKind(tc hegel.TestCase) int {
+	total := 0
+	for _, w := range hzKindWeights {
+		total += w
+	}
+	n := hzDrawInt(tc, 1, total)
+	for k, w := range hzKindWeights {
+		n -= w
+		if n <= 0 {
+			return k
+		}
+	}
+	return hzKBool
+}
+
+var hzDefaults = map[int][]string{
+	hzKBool:    {"true"},
+	hzKBoolInv: {"true"},
+	hzKString:  {"en", "d"},
+	hzKInt:     {"7", "-3"},
+	hzKStrings: {"d1", "d1,d2"},
+}
+
+// hzGenFlag draws a flag whose names are not among taken (a set of names in the command).
+func hzGenFlag(tc hegel.TestCase, taken map[string]bool, id int) *hzFlagSpec {
+	s := &hzFlagSpec{kind: hzDrawKind(tc), id: id}
+	for tries := 0; ; tries++ {
+		s.name = hzPick(tc, hzLongNames)
+		if !taken[s.name] && !taken["no-"+s.name] || tries > 8 {
+			break
+		}
+	}
+	if hzChance(tc, 55) {
+		a := hzPick(tc, hzAliasChars)
+		if !taken[a] && !taken["no-"+a] {
+			s.aliases = append(s.aliases, a)
+		}
+	}
+	for _, n := range s.names() {
+		taken[n] = true
+	}
+	s.local = hzChance(tc, 25)
+	s.onlyOnce = hzChance(tc, 10)
+	s.required = hzChance(tc, 5)
+	if defs := hzDefaults[s.kind]; defs != nil && hzChance(tc, 40) {
+		s.def = hzPick(tc, defs)
+	}
+	return s
+}
+
+func hzGenArgs(tc hegel.TestCase) []*hzArgSpec {
+	var as []*hzArgSpec
+	names := []string{"first", "second", "rest"}
+	for i, n := 0, hzDrawInt(tc, 1, 2); i < n; i++ {
+		a := &hzArgSpec{name: names[i], kind: hzDrawInt(tc, 0, 3)}
+		switch a.kind {
+		case hzAInt, hzAString:
+			a.required = hzChance(tc, 20)
+		default:
+			a.min = hzDrawInt(tc, 0, 1)
+			a.max = hzPick(tc, []int{-1, -1, 1, 2, 3})
+			if hzChance(tc, 4) {
+				a.max = 0
+			}
+		}
+		as = append(as, a)
+	}
+	return as
+}
+
+func hzGenCmd(tc hegel.TestCase, names []string, parent *hzCmdSpec, depth int, ids *int) *hzCmdSpec {
+	c := &hzCmdSpec{name: names[0], aliases: names[1:], parent: parent}
+	c.shortOpt = hzChance(tc, 35)
+	if depth == 0 && hzChance(tc, 12) {
+		n := hzDrawInt(tc, 0, 2)
+		c.stopN = &n
+	}
+	taken := map[string]bool{}
+	for i, n := 0, hzDrawInt(tc, 0, 4); i < n; i++ {
+		c.flags = append(c.flags, hzGenFlag(tc, taken, *ids))
+		*ids++
+	}
+	if hzChance(tc, 12) {
+		g := &hzGroupSpec{required: hzChance(tc, 15)}
+		for i := 0; i < 2; i++ {
+			var l []*hzFlagSpec
+			for j, n := 0, hzDrawInt(tc, 1, 2); j < n; j++ {
+				f := hzGenFlag(tc, taken, *ids)
+				*ids++
+				if f.kind != hzKBool {
+					f.kind = hzKString
+				}
+				f.required = false
+				l = append(l, f)
+			}
+			g.lists = append(g.lists, l)
+		}
+		c.groups = append(c.groups, g)
+	}
+	if hzChance(tc, 25) {
+		c.args = hzGenArgs(tc)
+	}
+	if depth < 2 {
+		max := 3
+		if depth == 1 {
+			max = 1
+		}
+		used := map[int]bool{}
+		for i, n := 0, hzDrawInt(tc, 0, max); i < n; i++ {
+			k := hzDrawInt(tc, 0, len(hzCmdNames)-1)
+			if used[k] {
+				continue
+			}
+			used[k] = true
+			if depth == 1 && !hzChance(tc, 60) {
+				continue
+			}
+			c.subs = append(c.subs, hzGenCmd(tc, hzCmdNames[k], c, depth+1, ids))
+		}
+	}
+	return c
+}
+
+func hzAllFlagSpecs(c *hzCmdSpec, out *[]*hzFlagSpec) {
+	*out = append(*out, c.allFlags()...)
+	for _, s := range c.subs {
+		hzAllFlagSpecs(s, out)
+	}
+}
+
+func hzAllCmdSpecs(c *hzCmdSpec, out *[]*hzCmdSpec) {
+	*out = append(*out, c)
+	for _, s := range c.subs {
+		hzAllCmdSpecs(s, out)
+	}
+}
