+}
+
+var hzPositionals = []string{"foo", "bar", "-", "--", "-1", "-.5", "", "  ", "x=y", " --alpha", "--zzz", "-z", "--zzz=1", "---x", "-9x"}
+
+// hzFlagToken draws one flag token (and possibly its value) for f.
+func hzFlagToken(tc hegel.TestCase, f *hzFlagSpec) []string {
+	name := hzPick(tc, f.names())
+	tok := "--" + name
+	if len(name) == 1 && hzChance(tc, 85) || hzChance(tc, 15) {
+		tok = "-" + name
+	}
+	if hzChance(tc, 30) {
+		return []string{tok + "=" + hzPick(tc, hzValuesByKind[f.kind])}
+	}
+	if !f.isBool() && hzChance(tc, 85) {
+		return []string{tok, hzPick(tc, hzValuesByKind[f.kind])}
+	}
+	return []string{tok}
+}
+
+// hzCombinedToken draws a combined short-option token from the flags' aliases (bool flags
+// preferred, since only those combine).
+func hzCombinedToken(tc hegel.TestCase, flags []*hzFlagSpec) []string {
+	var bools, aliased []*hzFlagSpec
+	for _, f := range flags {
+		if len(f.aliases) > 0 {
+			aliased = append(aliased, f)
+			if f.isBool() {
+				bools = append(bools, f)
+			}
+		}
+	}
+	var sb strings.Builder
+	sb.WriteString("-")
+	for j, k := 0, hzDrawInt(tc, 2, 3); j < k; j++ {
+		switch {
+		case len(bools) > 0 && hzChance(tc, 70):
+			sb.WriteString(hzPick(tc, bools).aliases[0])
+		case len(aliased) > 0 && hzChance(tc, 80):
+			sb.WriteString(hzPick(tc, aliased).aliases[0])
+		default:
+			sb.WriteString(hzPick(tc, hzAliasChars))
+		}
+	}
+	tok := sb.String()
+	if hzChance(tc, 20) {
+		tok += "=" + hzPick(tc, []string{"true", "false", "1", "x"})
+	}
+	if hzChance(tc, 40) {
+		return []string{tok, hzPick(tc, []string{"1", "a", "true", "2s"})}
+	}
+	return []string{tok}
+}
+
+// hzReachable lists the flags a command can see: its own and its ancestors' (Local included,
+// to reach the errors).
+func hzReachable(c *hzCmdSpec) []*hzFlagSpec {
+	var fs []*hzFlagSpec
+	for p := c; p != nil; p = p.parent {
+		fs = append(fs, p.allFlags()...)
+	}
+	return fs
+}
+
+// hzGenArgv draws an argument list for the tree: mostly a walk towards one command with
+// that command's flags around the names, sometimes tokens drawn from the whole tree.
+func hzGenArgv(tc hegel.TestCase, root *hzCmdSpec) []string {
+	var cmds []*hzCmdSpec
+	hzAllCmdSpecs(root, &cmds)
+	if hzChance(tc, 70) {
+		target := hzPick(tc, cmds)
+		var chain []*hzCmdSpec
+		for c := target; c != nil; c = c.parent {
+			chain = append([]*hzCmdSpec{c}, chain...)
+		}
+		var argv []string
+		for i, c := range chain {
+			if i > 0 {
+				argv = append(argv, hzPick(tc, append([]string{c.name}, c.aliases...)))
+			}
+			reach := hzReachable(c)
+			for j, n := 0, hzDrawInt(tc, 0, 3); j < n; j++ {
+				switch r := hzDrawInt(tc, 1, 100); {
+				case r <= 70 && len(reach) > 0:
+					argv = append(argv, hzFlagToken(tc, hzPick(tc, reach))...)
+				case r <= 82 && len(reach) > 0:
+					argv = append(argv, hzCombinedToken(tc, reach)...)
+				case r <= 92:
+					argv = append(argv, hzPick(tc, []string{"foo", "1", "2", "x", "bar"}))
+				default:
+					argv = append(argv, hzPick(tc, hzPositionals))
+				}
+			}
+		}
+		return argv
+	}
+	return hzGenArgvRandom(tc, root, cmds)
+}
+
+func hzGenArgvRandom(tc hegel.TestCase, root *hzCmdSpec, cmds []*hzCmdSpec) []string {
+	var flags []*hzFlagSpec
+	hzAllFlagSpecs(root, &flags)
+	var argv []string
+	n := hzDrawInt(tc, 0, 8)
+	for i := 0; i < n; i++ {
+		switch r := hzDrawInt(tc, 1, 100); {
+		case r <= 50 && len(flags) > 0:
+			f := hzPick(tc, flags)
+			if hzChance(tc, 50) && len(root.allFlags()) > 0 {
+				f = hzPick(tc, root.allFlags()) // the root's flags reach everywhere
+			}
+			names := f.names()
+			name := hzPick(tc, names)
+			tok := "--" + name
+			if len(name) == 1 && hzChance(tc, 85) || hzChance(tc, 15) {
+				tok = "-" + name
+			}
+			withEq := hzChance(tc, 30)
+			if withEq {
+				argv = append(argv, tok+"="+hzPick(tc, hzValuesByKind[f.kind]))
+			} else {
+				argv = append(argv, tok)
+				if !f.isBool() && hzChance(tc, 85) {
+					argv = append(argv, hzPick(tc, hzValuesByKind[f.kind]))
+				}
+			}
+		case r <= 62 && len(flags) > 0:
+			// combined short options
+			var sb strings.Builder
+			sb.WriteString("-")
+			for j, k := 0, hzDrawInt(tc, 2, 3); j < k; j++ {
+				f := hzPick(tc, flags)
+				if len(f.aliases) > 0 {
+					sb.WriteString(f.aliases[0])
+				} else {
+					sb.WriteString(hzPick(tc, hzAliasChars))
+				}
+			}
+			tok := sb.String()
+			if hzChance(tc, 20) {
+				tok += "=" + hzPick(tc, []string{"true", "false", "1", "x"})
+			}
+			argv = append(argv, tok)
+			if hzChance(tc, 40) {
+				argv = append(argv, hzPick(tc, []string{"1", "a", "true", "2s"}))
+			}
+		case r <= 80:
+			c := hzPick(tc, cmds)
+			if c != root {
+				argv = append(argv, hzPick(tc, append([]string{c.name}, c.aliases...)))
+			} else {
+				argv = append(argv, hzPick(tc, []string{"foo", "1", "2", "x"}))
+			}
+		default:
+			argv = append(argv, hzPick(tc, hzPositionals))
+		}
+	}
+	return argv
+}
+
+// --------------------------------------------------------------------------- the property
+
+// TestHegelRun: a generated command tree run on a generated argument list; the command that
+// ran, its positional arguments and typed argument values, every flag's value, IsSet and
+// Count (on success), or the error text, against the model.
+func TestHegelRun(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		tc := ht
+		ids := 0
+		spec := hzGenCmd(tc, []string{"app"}, nil, 0, &ids)
+		argv := hzGenArgv(tc, spec)
+
+		all := map[*hzFlagSpec]*hzMFlag{}
+		model := hzNewModel(spec, nil, all)
+		before := hzCombinedSkipped
+		want := model.run(argv, all)
+
+		rt := hzNewRealTree(spec)
+		var got hzResult
+		r := hzCatch(func() {
+			err := rt.root.Run(context.Background(), append([]string{"app"}, argv...))
+			if err != nil {
+				got = hzResult{err: err.Error()}
+			} else if rt.ran == nil {
+				got = hzResult{err: "<no action ran>"}
+			} else {
+				got = hzResult{path: rt.ran.path(), args: rt.args, argVal: rt.argVal}
+			}
+		})
+		desc := func() string {
+			return fmt.Sprintf("argv %q\n%s", argv, spec.describe(""))
+		}
+		if r != nil {
+			col.failClass(ht, "panic", "%s\npanic: %v", desc(), r)
+			return
+		}
+		if got.String() != want.String() {
+			class := "result"
+			if got.err != "" || want.err != "" {
+				class = "error"
+			}
+			col.failClass(ht, class, "%s\n got %s\nwant %s", desc(), got, want)
+			return
+		}
+		if want.err == "" {
+			var specs []*hzFlagSpec
+			hzAllFlagSpecs(spec, &specs)
+			for _, fs := range specs {
+				g, w := hzFlagState(fs, rt.flags[fs]), all[fs].state()
+				if g != w {
+					col.failClass(ht, "flag", "%s\nresult %s\nflag %s\n got %s\nwant %s", desc(), want, fs, g, w)
+					return
+				}
+			}
+			col.count("ok depth " + fmt.Sprint(strings.Count(want.path, " ")))
+		} else {
+			col.count("error " + hzErrClass(want.err))
+		}
+		if hzCombinedSkipped > before {
+			col.count("combined non-bool skipped")
+		}
+	})
+}
+
+func hzErrClass(err string) string {
+	for _, p := range []string{"flag provided but not defined", "flag needs an argument", "invalid value", "Required flag", "Required argument", "option ", "one of these flags", "sufficient count", "args "} {
+		if strings.HasPrefix(err, p) {
+			return strings.TrimSpace(p)
+		}
+	}
+	return "other"
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..8e567b2
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,163 @@
+package hegel
+
+// Hegel property tests for urfave/cli v3, written for the Hegel zoo. See targets/go/cli/README.md.
+// They live in a package of their own (hegel/) and drive the public API: a generated
+// cli.Command tree run with Command.Run on generated argument lists, the Actions recording
+// which command ran, its flag values and its positional arguments.
+//
+// Oracle: a model of the documented command-line grammar (flags with values by space or
+// '=', bool flags, aliases, '--', short-option handling, persistent and local flags,
+// subcommands, slice and map flags, OnlyOnce, Required, mutually exclusive groups, typed
+// arguments).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on; the pins assert the documented behaviour and fail while
+// the bug exists.
+var HZKnown = struct {
+	dashDropsRest               bool // a lone "-" ends the parsing and drops the arguments after it
+	commandNameStopsParsing     bool // a subcommand name that is not the first positional still stops the parsing (and is not dispatched)
+	combinedShortsSeeLocalFlags bool // combined short options find a parent's Local flag from a subcommand
+	combinedInverseSetsFalse    bool // a BoolWithInverseFlag in a combined short token is set to false
+	dashDashDispatches          bool // a subcommand name right after "--" is dispatched and the rest parsed as its flags
+	inverseGetPanics            bool // BoolWithInverseFlag.Get panics before the flag has been prepared by a run
+}{true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
