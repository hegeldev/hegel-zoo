+// --------------------------------------------------------------------------- properties
+
+// TestHegelValidationFollowsTheModel: the Validator (and the Parser around it) reports exactly
+// the modelled errors for MapClaims read with and without UseNumber, and for RegisteredClaims.
+func TestHegelValidationFollowsTheModel(t *testing.T) {
+	col := newCollector(t)
+	key := keysFor("HS256")[0]
+	property(t, func(ht *hegel.T) {
+		c := genClaims(ht)
+		o := genOpts(ht)
+		now := genNow(ht, c, o)
+		if Known.hugeDateWraps && c.hasDateKind("huge") {
+			col.count("skip-huge")
+			return
+		}
+		clock := time.Unix(now, 0)
+		validator := jwt.NewValidator(o.options(clock)...)
+
+		// MapClaims, plain Unmarshal (float64 numbers)
+		{
+			var m jwt.MapClaims
+			if err := json.Unmarshal(c.raw, &m); err != nil {
+				col.fail(ht, "claims %s do not unmarshal into MapClaims: %v", c.raw, err)
+				return
+			}
+			want := modelValidate(c, o, now, true)
+			if msg := checkErrors(validator.Validate(m), want); msg != "" {
+				col.fail(ht, "MapClaims %s at now=%d %s: %s", c.raw, now, o, msg)
+				return
+			}
+			col.count("map")
+			// MapClaims with UseNumber
+			dec := json.NewDecoder(strings.NewReader(string(c.raw)))
+			dec.UseNumber()
+			var mn jwt.MapClaims
+			if err := dec.Decode(&mn); err != nil {
+				col.fail(ht, "claims %s do not decode into MapClaims with UseNumber: %v", c.raw, err)
+				return
+			}
+			if msg := checkErrors(validator.Validate(mn), want); msg != "" {
+				col.fail(ht, "MapClaims(UseNumber) %s at now=%d %s: %s", c.raw, now, o, msg)
+				return
+			}
+			if len(want) == 0 {
+				col.count("map-valid")
+			}
+			// through the parser
+			if chance(ht, 30) {
+				tok := jwt.NewWithClaims(jwt.SigningMethodHS256, m)
+				str, err := tok.SignedString(key.private)
+				if err != nil {
+					col.fail(ht, "signing %s: %v", c.raw, err)
+					return
+				}
+				parsed, err := jwt.Parse(str, func(*jwt.Token) (any, error) { return key.public, nil }, o.options(clock)...)
+				if len(want) == 0 {
+					if err != nil || parsed == nil || !parsed.Valid {
+						col.fail(ht, "Parse of a token with claims %s at now=%d %s: err=%v, want valid", c.raw, now, o, err)
+						return
+					}
+				} else {
+					if err == nil || !errors.Is(err, jwt.ErrTokenInvalidClaims) || parsed == nil || parsed.Valid {
+						col.fail(ht, "Parse of a token with claims %s at now=%d %s: err=%v, want ErrTokenInvalidClaims with %v", c.raw, now, o, err, want)
+						return
+					}
+					if msg := checkErrors(err, want); msg != "" {
+						col.fail(ht, "Parse of a token with claims %s at now=%d %s: %s", c.raw, now, o, msg)
+						return
+					}
+				}
+				col.count("parsed")
+			}
+		}
+
+		// RegisteredClaims
+		var r jwt.RegisteredClaims
+		err := json.Unmarshal(c.raw, &r)
+		if c.registeredUnmarshals() {
+			if err != nil {
+				col.fail(ht, "claims %s do not unmarshal into RegisteredClaims: %v", c.raw, err)
+				return
+			}
+			want := modelValidate(c, o, now, false)
+			if msg := checkErrors(validator.Validate(r), want); msg != "" {
+				col.fail(ht, "RegisteredClaims %s at now=%d %s: %s", c.raw, now, o, msg)
+				return
+			}
+			col.count("registered")
+		} else {
+			if err == nil {
+				col.fail(ht, "claims %s unmarshal into RegisteredClaims %+v, want an error", c.raw, r)
+				return
+			}
+			col.count("registered-rejected")
+		}
+
+		// joserfc as a second opinion on exp/nbf/iat: integer dates only, no expectations it does
+		// not have, and not at the exp boundary where the two conventions differ by design.
+		if o.requireExp || o.requireNbf || len(o.aud) > 0 || o.iss != "" || o.sub != "" {
+			return
+		}
+		for _, d := range c.dates() {
+			if d.kind != "absent" && d.kind != "int" {
+				return
+			}
+		}
+		if c.iat.kind == "int" && !o.checkIat {
+			return
+		}
+		for _, s := range []strSpec{c.iss, c.sub, c.jti} {
+			if s.kind != "absent" && s.kind != "string" {
+				return // joserfc polices the type of every registered claim
+			}
+		}
+		switch c.aud.kind {
+		case "number", "mixed", "object", "null":
+			return
+		}
+		if c.exp.kind == "int" && now == c.exp.secs+o.leeway {
+			col.count("joserfc-boundary")
+			return
+		}
+		rep := oracleValidate(c.raw, now, o.leeway)
+		if !rep.Ok {
+			col.fail(ht, "joserfc could not validate %s: %s %s", c.raw, rep.Error, rep.Message)
+			return
+		}
+		want := modelValidate(c, o, now, false)
+		if rep.Valid != (len(want) == 0) {
+			col.fail(ht, "joserfc says valid=%v for %s at now=%d leeway=%d, the model says %v", rep.Valid, c.raw, now, o.leeway, want)
+			return
+		}
+		col.count("joserfc")
+	})
+}
