+// TestHegelGoTokensReadInJoserfc: every token golang-jwt signs verifies in joserfc with the same
+// header and claims, and parses back in golang-jwt.
+func TestHegelGoTokensReadInJoserfc(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		alg := pick(ht, allAlgs)
+		key := pick(ht, keysFor(alg))
+		c := genClaims(ht)
+		var claims jwt.Claims
+		useRegistered := chance(ht, 35) && c.registeredUnmarshals() && !c.hasDateKind("string") && !(Known.hugeDateWraps && c.hasDateKind("huge"))
+		if useRegistered {
+			var r jwt.RegisteredClaims
+			if err := json.Unmarshal(c.raw, &r); err != nil {
+				col.fail(ht, "claims %s into RegisteredClaims: %v", c.raw, err)
+				return
+			}
+			claims = r
+			col.count("registered")
+		} else {
+			m := jwt.MapClaims{}
+			if err := json.Unmarshal(c.raw, &m); err != nil {
+				col.fail(ht, "claims %s into MapClaims: %v", c.raw, err)
+				return
+			}
+			claims = m
+			col.count("map")
+		}
+		tok := jwt.NewWithClaims(methodOf(alg), claims)
+		if chance(ht, 30) {
+			tok.Header["kid"] = key.name
+		}
+		if chance(ht, 20) {
+			tok.Header["cty"] = "JWT"
+		}
+		if chance(ht, 20) {
+			tok.Header["zoo"] = map[string]any{"n": n(ht, 0, 9), "s": pick(ht, stringPool)}
+		}
+		switch n(ht, 1, 10) {
+		case 1:
+			delete(tok.Header, "typ")
+		case 2:
+			tok.Header["typ"] = "at+jwt"
+		}
+		str, err := tok.SignedString(key.private)
+		if err != nil {
+			col.fail(ht, "%s with %s: SignedString: %v", alg, key.name, err)
+			return
+		}
+		wantHeader := canonOf(tok.Header)
+		wantClaims := canonOf(claims)
+
+		rep := oracleDecode(str, key.oracle, key.kty, alg)
+		if !rep.Ok {
+			col.fail(ht, "%s with %s: joserfc rejects %s: %s %s", alg, key.name, str, rep.Error, rep.Message)
+			return
+		}
+		if got := canon(rep.Header); got != wantHeader {
+			col.fail(ht, "%s with %s: joserfc header %s, golang-jwt wrote %s", alg, key.name, got, wantHeader)
+			return
+		}
+		if got := canon(rep.Claims); got != wantClaims {
+			col.fail(ht, "%s with %s: joserfc claims %s, golang-jwt wrote %s (claims %s)", alg, key.name, got, wantClaims, c.raw)
+			return
+		}
+		// the raw payload is exactly what SigningString encodes
+		ver := oracleVerify(str, key.oracle, key.kty, alg)
+		parts := strings.Split(str, ".")
+		payload, _ := base64.RawURLEncoding.DecodeString(parts[1])
+		if !ver.Ok || ver.Payload != fmt.Sprintf("%x", payload) {
+			col.fail(ht, "%s with %s: joserfc payload %q, want %x", alg, key.name, ver.Payload, payload)
+			return
+		}
+		// and golang-jwt reads its own token
+		back, err := jwt.Parse(str, func(*jwt.Token) (any, error) { return key.public, nil }, jwt.WithoutClaimsValidation(), jwt.WithValidMethods([]string{alg}))
+		if err != nil || !back.Valid {
+			col.fail(ht, "%s with %s: golang-jwt does not read its own token %s: %v", alg, key.name, str, err)
+			return
+		}
+		if got := canonOf(back.Claims); got != wantClaims {
+			col.fail(ht, "%s with %s: read back claims %s, wrote %s", alg, key.name, got, wantClaims)
+			return
+		}
+		if got := canonOf(back.Header); got != wantHeader {
+			col.fail(ht, "%s with %s: read back header %s, wrote %s", alg, key.name, got, wantHeader)
+			return
+		}
+		col.count(alg)
+	})
+}
+
+// b64Alphabet is the base64url alphabet.
+const b64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
+
+// TestHegelJoserfcTokensParseInGo: tokens joserfc signs parse and verify in golang-jwt with the
+// same header and claims; a changed signature, payload or header, a wrong key, a wrong key type
+// or an excluded algorithm never verifies; a key set verifies when it holds the right key.
+func TestHegelJoserfcTokensParseInGo(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		alg := pick(ht, allAlgs)
+		candidates := keysFor(alg)
+		key := pick(ht, candidates)
+		c := genClaims(ht)
+		if Known.hugeDateWraps && c.hasDateKind("huge") {
+			col.count("skip-huge")
+			return
+		}
+		header := map[string]any{"alg": alg}
+		if chance(ht, 30) {
+			header["kid"] = key.name
+		}
+		if chance(ht, 50) {
+			header["typ"] = pick(ht, []string{"JWT", "at+jwt"})
+		}
+		if chance(ht, 20) {
+			header["zoo"] = []any{1, "two"}
+		}
+		enc := oracleEncode(mustJSON(header), c.raw, key.oracle, key.kty, alg)
+		if !enc.Ok {
+			col.fail(ht, "joserfc could not sign %s with %s: %s %s", c.raw, alg, enc.Error, enc.Message)
+			return
+		}
+		str := enc.Token
+		wantClaims := canon(c.raw)
+		wantHeader := canonOf(header)
+		keyFunc := func(k any) jwt.Keyfunc { return func(*jwt.Token) (any, error) { return k, nil } }
+		opts := []jwt.ParserOption{jwt.WithoutClaimsValidation()}
+		if chance(ht, 50) {
+			opts = append(opts, jwt.WithValidMethods([]string{alg}))
+		}
+		if chance(ht, 30) {
+			opts = append(opts, jwt.WithJSONNumber())
+			col.count("json-number")
+		}
+		if chance(ht, 20) {
+			opts = append(opts, jwt.WithStrictDecoding())
+		}
+		if chance(ht, 20) {
+			opts = append(opts, jwt.WithPaddingAllowed())
+		}
+
+		// the good token, into MapClaims
+		tok, err := jwt.Parse(str, keyFunc(key.public), opts...)
+		if err != nil || !tok.Valid {
+			col.fail(ht, "%s with %s: Parse(%s) = %v, want valid", alg, key.name, str, err)
+			return
+		}
+		if got := canonOf(tok.Claims); got != wantClaims {
+			col.fail(ht, "%s with %s: claims %s, joserfc signed %s", alg, key.name, got, wantClaims)
+			return
+		}
+		if got := canonOf(tok.Header); got != wantHeader {
+			col.fail(ht, "%s with %s: header %s, joserfc signed %s", alg, key.name, got, wantHeader)
+			return
+		}
+		if tok.Method.Alg() != alg || tok.Raw != str {
+			col.fail(ht, "%s with %s: Method %s, Raw %q", alg, key.name, tok.Method.Alg(), tok.Raw)
+			return
+		}
+		// into RegisteredClaims when the claims fit
+		if c.registeredUnmarshals() && !c.hasDateKind("string") {
+			rt, err := jwt.ParseWithClaims(str, &jwt.RegisteredClaims{}, keyFunc(key.public), opts...)
+			if err != nil || !rt.Valid {
+				col.fail(ht, "%s with %s: ParseWithClaims(RegisteredClaims) of %s (claims %s) = %v, want valid", alg, key.name, str, c.raw, err)
+				return
+			}
+			rc := rt.Claims.(*jwt.RegisteredClaims)
+			for name, d := range c.dates() {
+				var got *jwt.NumericDate
+				switch name {
+				case "exp":
+					got = rc.ExpiresAt
+				case "nbf":
+					got = rc.NotBefore
+				case "iat":
+					got = rc.IssuedAt
+				}
+				if d.kind == "int" || d.kind == "frac" {
+					if got == nil || got.Unix() != d.floorSecs() {
+						col.fail(ht, "%s with %s: RegisteredClaims %s = %v from %s", alg, key.name, name, got, d.raw)
+						return
+					}
+				} else if got != nil {
+					col.fail(ht, "%s with %s: RegisteredClaims %s = %v from absent/null", alg, key.name, name, got)
+					return
+				}
+			}
+			if rc.Issuer != c.iss.val || rc.Subject != c.sub.val || rc.ID != c.jti.val {
+				col.fail(ht, "%s with %s: RegisteredClaims iss=%q sub=%q jti=%q from %s", alg, key.name, rc.Issuer, rc.Subject, rc.ID, c.raw)
+				return
+			}
+			if !reflect.DeepEqual([]string(rc.Audience), c.aud.vals) && !(len(rc.Audience) == 0 && len(c.aud.vals) == 0) {
+				col.fail(ht, "%s with %s: RegisteredClaims aud=%q from %s", alg, key.name, rc.Audience, c.raw)
+				return
+			}
+			col.count("registered")
+		}
+
+		// a tampered token
+		parts := strings.Split(str, ".")
+		seg := n(ht, 0, 2)
+		pos := n(ht, 0, len(parts[seg])-1)
+		if seg == 2 && pos == len(parts[2])-1 && len(parts[2]) > 1 {
+			pos-- // the last character carries unused bits that a lax decoder ignores
+		}
+		resized := false
+		if seg == 2 && chance(ht, 25) {
+			// drop or add three bytes instead (four characters keep the segment decodable, though
+			// strict decoding may still refuse the new trailing bits)
+			resized = true
+			if chance(ht, 50) {
+				parts[2] = parts[2][:len(parts[2])-4]
+			} else {
+				parts[2] += "AAAA"
+			}
+		} else {
+			old := parts[seg][pos]
+			var repl byte
+			for {
+				repl = b64Alphabet[n(ht, 0, 63)]
+				if repl != old {
+					break
+				}
+			}
+			parts[seg] = parts[seg][:pos] + string(repl) + parts[seg][pos+1:]
+		}
+		bad := strings.Join(parts, ".")
+		btok, err := jwt.Parse(bad, keyFunc(key.public), opts...)
+		if err == nil || (btok != nil && btok.Valid) {
+			col.fail(ht, "%s with %s: tampered token %s (segment %d) verifies: %v", alg, key.name, bad, seg, err)
+			return
+		}
+		if seg == 2 && !errors.Is(err, jwt.ErrTokenSignatureInvalid) && !(resized && errors.Is(err, jwt.ErrTokenMalformed)) {
+			col.fail(ht, "%s with %s: changed signature %s gives %v, want ErrTokenSignatureInvalid", alg, key.name, bad, err)
+			return
+		}
+		if !errors.Is(err, jwt.ErrTokenSignatureInvalid) && !errors.Is(err, jwt.ErrTokenMalformed) && !errors.Is(err, jwt.ErrTokenUnverifiable) {
+			col.fail(ht, "%s with %s: tampered token %s gives %v, want a malformed/unverifiable/signature error", alg, key.name, bad, err)
+			return
+		}
+		col.count(fmt.Sprintf("tamper-%d", seg))
+
+		// another key of the same kind
+		var other keyPair
+		for _, k := range keys() {
+			if k.kty == key.kty && k.name != key.name {
+				other = k
+				if chance(ht, 50) {
+					break
+				}
+			}
+		}
+		if other.name != "" {
+			_, err := jwt.Parse(str, keyFunc(other.public), opts...)
+			if !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+				col.fail(ht, "%s with %s: verifies under %s: %v", alg, key.name, other.name, err)
+				return
+			}
+			// a key set with the wrong key first and the right one after
+			set := jwt.VerificationKeySet{Keys: []jwt.VerificationKey{other.public, key.public}}
+			st, err := jwt.Parse(str, keyFunc(set), opts...)
+			if err != nil || !st.Valid {
+				col.fail(ht, "%s with %s: key set {%s, %s} does not verify: %v", alg, key.name, other.name, key.name, err)
+				return
+			}
+			_, err = jwt.Parse(str, keyFunc(jwt.VerificationKeySet{Keys: []jwt.VerificationKey{other.public}}), opts...)
+			if !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+				col.fail(ht, "%s with %s: key set {%s} verifies: %v", alg, key.name, other.name, err)
+				return
+			}
+		}
+		_, err = jwt.Parse(str, keyFunc(jwt.VerificationKeySet{}), opts...)
+		if !errors.Is(err, jwt.ErrTokenUnverifiable) {
+			col.fail(ht, "%s with %s: empty key set gives %v, want ErrTokenUnverifiable", alg, key.name, err)
+			return
+		}
+		// a key of the wrong type
+		var wrongType any = []byte("not the key type")
+		if key.kty == "oct" {
+			wrongType = keysFor("ES256")[0].public
+		}
+		_, err = jwt.Parse(str, keyFunc(wrongType), opts...)
+		if !errors.Is(err, jwt.ErrTokenSignatureInvalid) || !errors.Is(err, jwt.ErrInvalidKeyType) {
+			col.fail(ht, "%s with %s: a key of the wrong type gives %v, want ErrTokenSignatureInvalid wrapping ErrInvalidKeyType", alg, key.name, err)
+			return
+		}
+		// the algorithm excluded
+		otherAlg := pick(ht, allAlgs)
+		if otherAlg != alg {
+			_, err = jwt.Parse(str, keyFunc(key.public), jwt.WithoutClaimsValidation(), jwt.WithValidMethods([]string{otherAlg}))
+			if !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+				col.fail(ht, "%s with %s: WithValidMethods(%s) gives %v, want ErrTokenSignatureInvalid", alg, key.name, otherAlg, err)
+				return
+			}
+		}
+		// no key function, a failing key function
+		_, err = jwt.Parse(str, nil, opts...)
+		if !errors.Is(err, jwt.ErrTokenUnverifiable) {
+			col.fail(ht, "%s with %s: nil Keyfunc gives %v", alg, key.name, err)
+			return
+		}
+		boom := errors.New("boom")
+		_, err = jwt.Parse(str, func(*jwt.Token) (any, error) { return nil, boom }, opts...)
+		if !errors.Is(err, jwt.ErrTokenUnverifiable) || !errors.Is(err, boom) {
+			col.fail(ht, "%s with %s: failing Keyfunc gives %v", alg, key.name, err)
+			return
+		}
+		col.count(alg)
+	})
+}
+
+// TestHegelMapAndRegisteredClaimsAgree: the six accessors give the same values from MapClaims
+// (with and without UseNumber) and from RegisteredClaims for the same JSON; RegisteredClaims
+// marshal and unmarshal back to themselves under both settings of MarshalSingleStringAsArray.
+func TestHegelMapAndRegisteredClaimsAgree(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := genClaims(ht)
+		if !c.registeredUnmarshals() || c.hasDateKind("string") || (Known.hugeDateWraps && c.hasDateKind("huge")) || (Known.nullIsInvalid && (c.hasDateKind("null") || c.iss.kind == "null" || c.sub.kind == "null")) {
+			col.count("skip")
+			return
+		}
+		var r jwt.RegisteredClaims
+		if err := json.Unmarshal(c.raw, &r); err != nil {
+			col.fail(ht, "%s into RegisteredClaims: %v", c.raw, err)
+			return
+		}
+		var m jwt.MapClaims
+		if err := json.Unmarshal(c.raw, &m); err != nil {
+			col.fail(ht, "%s into MapClaims: %v", c.raw, err)
+			return
+		}
+		dec := json.NewDecoder(strings.NewReader(string(c.raw)))
+		dec.UseNumber()
+		var mn jwt.MapClaims
+		if err := dec.Decode(&mn); err != nil {
+			col.fail(ht, "%s into MapClaims with UseNumber: %v", c.raw, err)
+			return
+		}
+		for _, cl := range []struct {
+			name string
+			v    jwt.Claims
+		}{{"MapClaims", m}, {"MapClaims(UseNumber)", mn}} {
+			for _, acc := range []struct {
+				name string
+				get  func(jwt.Claims) (any, error)
+			}{
+				{"exp", func(x jwt.Claims) (any, error) { return x.GetExpirationTime() }},
+				{"nbf", func(x jwt.Claims) (any, error) { return x.GetNotBefore() }},
+				{"iat", func(x jwt.Claims) (any, error) { return x.GetIssuedAt() }},
+				{"iss", func(x jwt.Claims) (any, error) { return x.GetIssuer() }},
+				{"sub", func(x jwt.Claims) (any, error) { return x.GetSubject() }},
+				{"aud", func(x jwt.Claims) (any, error) { return x.GetAudience() }},
+			} {
+				a, aerr := acc.get(cl.v)
+				b, berr := acc.get(r)
+				if (aerr != nil) != (berr != nil) {
+					col.fail(ht, "%s from %s: %s gives error %v, RegisteredClaims %v", acc.name, c.raw, cl.name, aerr, berr)
+					return
+				}
+				if aerr != nil {
+					continue
+				}
+				if !sameClaimValue(a, b) {
+					col.fail(ht, "%s from %s: %s gives %s, RegisteredClaims %s", acc.name, c.raw, cl.name, showClaim(a), showClaim(b))
+					return
+				}
+			}
+		}
+		col.count("agree")
+
+		// marshal round trip of RegisteredClaims
+		for _, single := range []bool{true, false} {
+			jwt.MarshalSingleStringAsArray = single
+			out, err := json.Marshal(r)
+			jwt.MarshalSingleStringAsArray = true
+			if err != nil {
+				col.fail(ht, "marshal of %+v: %v", r, err)
+				return
+			}
+			// the model of the text: omitempty members, dates as integer seconds, aud per the switch
+			want := map[string]any{}
+			if r.Issuer != "" {
+				want["iss"] = r.Issuer
+			}
+			if r.Subject != "" {
+				want["sub"] = r.Subject
+			}
+			if r.ID != "" {
+				want["jti"] = r.ID
+			}
+			if len(r.Audience) > 0 {
+				if len(r.Audience) == 1 && !single {
+					want["aud"] = r.Audience[0]
+				} else {
+					want["aud"] = []string(r.Audience)
+				}
+			}
+			for name, d := range map[string]*jwt.NumericDate{"exp": r.ExpiresAt, "nbf": r.NotBefore, "iat": r.IssuedAt} {
+				if d != nil {
+					want[name] = json.Number(strconv.FormatInt(d.Unix(), 10))
+				}
+			}
+			if canon(out) != canonOf(want) {
+				col.fail(ht, "marshal of RegisteredClaims from %s (single=%v) = %s, want %s", c.raw, !single, out, mustJSON(want))
+				return
+			}
+			var back jwt.RegisteredClaims
+			if err := json.Unmarshal(out, &back); err != nil {
+				col.fail(ht, "unmarshal of %s: %v", out, err)
+				return
+			}
+			if !sameRegistered(r, back) {
+				col.fail(ht, "RegisteredClaims %s -> %s -> %s", c.raw, out, mustJSON(back))
+				return
+			}
+		}
+		col.count("roundtrip")
+	})
+}
+
+func isPowerOfTen(x time.Duration) bool {
+	for x > 1 && x%10 == 0 {
+		x /= 10
+	}
+	return x == 1
+}
+
+func showClaim(v any) string {
+	switch x := v.(type) {
+	case *jwt.NumericDate:
+		if x == nil {
+			return "nil"
+		}
+		return x.Time.UTC().Format(time.RFC3339Nano)
+	}
+	return fmt.Sprintf("%#v", v)
+}
+
+func sameClaimValue(a, b any) bool {
+	switch x := a.(type) {
+	case *jwt.NumericDate:
+		y := b.(*jwt.NumericDate)
+		if x == nil || y == nil {
+			return x == nil && y == nil
+		}
+		return x.Time.Equal(y.Time)
+	case jwt.ClaimStrings:
+		y := b.(jwt.ClaimStrings)
+		return reflect.DeepEqual([]string(x), []string(y)) || len(x) == 0 && len(y) == 0
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func sameRegistered(a, b jwt.RegisteredClaims) bool {
+	return a.Issuer == b.Issuer && a.Subject == b.Subject && a.ID == b.ID &&
+		sameClaimValue(a.Audience, b.Audience) && sameClaimValue(a.ExpiresAt, b.ExpiresAt) &&
+		sameClaimValue(a.NotBefore, b.NotBefore) && sameClaimValue(a.IssuedAt, b.IssuedAt)
+}
+
+// TestHegelNumericDatesRoundTrip: NewNumericDate truncates to TimePrecision, MarshalJSON writes
+// the decimal of that instant, and UnmarshalJSON reads it back (exactly at second precision;
+// within the float64 error below); ClaimStrings marshal per MarshalSingleStringAsArray and read
+// a string, an array of strings or null, and nothing else.
+func TestHegelNumericDatesRoundTrip(t *testing.T) {
+	col := newCollector(t)
+	defer func() { jwt.TimePrecision = time.Second }()
+	property(t, func(ht *hegel.T) {
+		precs := []time.Duration{time.Second, time.Millisecond, time.Microsecond, 500 * time.Millisecond, 250 * time.Millisecond, 2 * time.Second}
+		prec := pick(ht, precs)
+		oddPrec := time.Second%prec != 0 || (prec < time.Second && !isPowerOfTen(time.Second/prec))
+		jwt.TimePrecision = prec
+		defer func() { jwt.TimePrecision = time.Second }()
+		secs := int64(n(ht, 0, 4_000_000_000))
+		if chance(ht, 20) {
+			secs = fixedNow + int64(n(ht, -100, 100))
+		}
+		if !Known.preEpochFraction && chance(ht, 15) {
+			secs = -secs
+		}
+		nanos := int64(n(ht, 0, 999_999_999))
+		switch n(ht, 1, 4) {
+		case 1:
+			nanos = 0
+		case 2:
+			nanos = int64(n(ht, 0, 999)) * 1_000_000
+		}
+		instant := time.Unix(secs, nanos)
+		d := jwt.NewNumericDate(instant)
+		truncated := instant.Truncate(prec)
+		if !d.Time.Equal(truncated) {
+			col.fail(ht, "NewNumericDate(%v) at %v = %v, want %v", instant, prec, d.Time, truncated)
+			return
+		}
+		if oddPrec && Known.oddPrecisionDrops {
+			col.count("skip-odd-" + prec.String())
+			return
+		}
+		out, err := json.Marshal(d)
+		if err != nil {
+			col.fail(ht, "marshal of %v: %v", d.Time, err)
+			return
+		}
+		// the model text: the seconds, then the fraction to the precision's digits (for a
+		// precision that is not a power of ten, as many digits as the fraction needs)
+		digits := 0
+		for p := prec; p < time.Second; p *= 10 {
+			digits++
+		}
+		unix := truncated.Unix()
+		want := strconv.FormatInt(unix, 10)
+		if oddPrec {
+			frac := strings.TrimRight(fmt.Sprintf("%09d", truncated.Nanosecond()), "0")
+			if frac != "" {
+				want += "." + frac
+			}
+		} else if digits > 0 {
+			frac := truncated.Nanosecond() / int(prec)
+			want += "." + fmt.Sprintf("%0*d", digits, frac)
+		}
+		if string(out) != want {
+			col.fail(ht, "marshal of %v at %v = %s, want %s", truncated, prec, out, want)
+			return
+		}
+		var back jwt.NumericDate
+		if err := json.Unmarshal(out, &back); err != nil {
+			col.fail(ht, "unmarshal of %s: %v", out, err)
+			return
+		}
+		diff := truncated.Sub(back.Time)
+		if prec == time.Second || !Known.subsecondTruncates {
+			if diff != 0 {
+				col.fail(ht, "%s at %v reads back as %v, want %v", out, prec, back.Time, truncated)
+				return
+			}
+		} else if diff < 0 || diff > prec {
+			col.fail(ht, "%s at %v reads back as %v, want %v (within one %v below)", out, prec, back.Time, truncated, prec)
+			return
+		}
+		col.count(prec.String())
+
+		// ClaimStrings
+		k := n(ht, 0, 3)
+		vals := make([]string, k)
+		for i := range vals {
+			vals[i] = pick(ht, stringPool)
+		}
+		single := chance(ht, 50)
+		jwt.MarshalSingleStringAsArray = !single
+		cs, err := json.Marshal(jwt.ClaimStrings(vals))
+		jwt.MarshalSingleStringAsArray = true
+		if err != nil {
+			col.fail(ht, "marshal of ClaimStrings %q: %v", vals, err)
+			return
+		}
+		var wantCS []byte
+		if k == 1 && single {
+			wantCS = mustJSON(vals[0])
+		} else {
+			wantCS = mustJSON(vals)
+		}
+		if string(cs) != string(wantCS) {
+			col.fail(ht, "ClaimStrings %q (single=%v) = %s, want %s", vals, single, cs, wantCS)
+			return
+		}
+		var backCS jwt.ClaimStrings
+		if err := json.Unmarshal(cs, &backCS); err != nil || !reflect.DeepEqual([]string(backCS), vals) && !(len(backCS) == 0 && k == 0) {
+			col.fail(ht, "ClaimStrings %s reads back as %q (%v), want %q", cs, backCS, err, vals)
+			return
+		}
+		for _, badRaw := range []string{"5", "true", `{"a":"b"}`, `["a", 1]`, `[1]`} {
+			var x jwt.ClaimStrings
+			if err := json.Unmarshal([]byte(badRaw), &x); err == nil {
+				col.fail(ht, "ClaimStrings accepts %s as %q", badRaw, x)
+				return
+			}
+		}
+		var nullCS jwt.ClaimStrings = jwt.ClaimStrings{"keep"}
+		if err := json.Unmarshal([]byte("null"), &nullCS); err != nil {
+			col.fail(ht, "ClaimStrings refuses null: %v", err)
+			return
+		}
+		col.count("claimstrings")
+	})
+}
+
+// --------------------------------------------------------------------------- parsing model
+
+// segSpec is one generated token segment: the bytes it should carry and how they were encoded.
+type segSpec struct {
+	bytes    []byte
+	text     string
+	encoding string // raw, padded, standard, junk, padded-1
+}
+
+func encodeSeg(tc hegel.TestCase, b []byte) segSpec {
+	s := segSpec{bytes: b}
+	switch n(tc, 1, 20) {
+	case 1, 2, 3:
+		s.encoding = "padded"
+		s.text = base64.URLEncoding.EncodeToString(b)
+	case 4:
+		s.encoding = "standard"
+		s.text = base64.RawStdEncoding.EncodeToString(b)
+	case 5:
+		s.encoding = "junk"
+		s.text = base64.RawURLEncoding.EncodeToString(b)
+		pos := n(tc, 0, len(s.text))
+		s.text = s.text[:pos] + pick(tc, []string{"=", " ", "!", ".", "\n", "\r", "é"}) + s.text[pos:]
+	case 6:
+		s.encoding = "dirty-bits"
+		s.text = base64.RawURLEncoding.EncodeToString(b)
+	default:
+		s.encoding = "raw"
+		s.text = base64.RawURLEncoding.EncodeToString(b)
+	}
+	if s.encoding == "dirty-bits" && len(s.text) > 0 && len(s.text)%4 != 0 {
+		// set unused trailing bits in the last character
+		last := strings.IndexByte(b64Alphabet, s.text[len(s.text)-1])
+		unused := 2
+		if len(s.text)%4 == 3 {
+			unused = 2
+		} else {
+			unused = 4
+		}
+		last |= (1 << unused) - 1
+		s.text = s.text[:len(s.text)-1] + string(b64Alphabet[last])
+	}
+	return s
+}
+
+// modelDecode says what Parser.DecodeSegment does with text under the options: the bytes, or
+// failure.
+func modelDecode(text string, padding, strict bool) ([]byte, bool) {
+	body := text
+	if padding {
+		// the parser pads by the raw length, before the decoder skips any line break
+		if l := len(body) % 4; l > 0 {
+			body += strings.Repeat("=", 4-l)
+		}
+	}
+	if Known.newlinesIgnored {
+		body = strings.NewReplacer("\n", "", "\r", "").Replace(body)
+	}
+	if padding {
+		// URLEncoding with padding: the text must now be a multiple of four with padding only at
+		// the end (at most two)
+		trimmed := strings.TrimRight(body, "=")
+		pads := len(body) - len(trimmed)
+		if pads > 2 || len(body)%4 != 0 {
+			return nil, false
+		}
+		body = trimmed
+	} else if strings.ContainsRune(body, '=') {
+		return nil, false
+	}
+	for i := 0; i < len(body); i++ {
+		if strings.IndexByte(b64Alphabet, body[i]) < 0 {
+			return nil, false
+		}
+	}
+	if len(body)%4 == 1 {
+		return nil, false
+	}
+	if strict && len(body)%4 != 0 {
+		last := strings.IndexByte(b64Alphabet, body[len(body)-1])
+		unused := 2
+		if len(body)%4 == 2 {
+			unused = 4
+		}
+		if last&((1<<unused)-1) != 0 {
+			return nil, false
+		}
+	}
+	out, err := base64.RawURLEncoding.DecodeString(body)
+	if err != nil {
+		return nil, false
+	}
+	return out, true
+}
+
+// TestHegelParsingFollowsBase64AndJSON: DecodeSegment agrees with the model of the options, and
+// ParseUnverified classifies a token (malformed, unverifiable, or parsed with the header and
+// claims read) exactly as the model of its steps says; nothing panics on random tokens through
+// every entry point.
+func TestHegelParsingFollowsBase64AndJSON(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		padding, strict := chance(ht, 40), chance(ht, 30)
+		var opts []jwt.ParserOption
+		if padding {
+			opts = append(opts, jwt.WithPaddingAllowed())
+		}
+		if strict {
+			opts = append(opts, jwt.WithStrictDecoding())
+		}
+		parser := jwt.NewParser(opts...)
+
+		// DecodeSegment alone
+		raw := []byte(word(ht, "abc\x00\xff", 0, 12))
+		seg := encodeSeg(ht, raw)
+		wantBytes, wantOK := modelDecode(seg.text, padding, strict)
+		got, err := parser.DecodeSegment(seg.text)
+		if (err == nil) != wantOK || (wantOK && string(got) != string(wantBytes)) {
+			col.fail(ht, "DecodeSegment(%q, padding=%v strict=%v) = %x, %v; model %x, %v (%s)", seg.text, padding, strict, got, err, wantBytes, wantOK, seg.encoding)
+			return
+		}
+		col.count("decode-" + seg.encoding)
+
+		// a token from generated segments
+		alg := pick(ht, append(append([]string{}, allAlgs...), "none", "XX", "", "hs256"))
+		header := map[string]any{"alg": alg, "typ": "JWT"}
+		switch n(ht, 1, 12) {
+		case 1:
+			delete(header, "alg")
+		case 2:
+			header["alg"] = 5
+		case 3:
+			header["alg"] = nil
+		}
+		headerText := string(mustJSON(header))
+		headerJSON := true
+		switch n(ht, 1, 15) {
+		case 1:
+			headerText = "{"
+			headerJSON = false
+		case 2:
+			headerText = "[1]"
+			headerJSON = false
+		case 3:
+			headerText = "null" // unmarshals into a nil map
+		case 4:
+			headerText = ""
+			headerJSON = false
+		}
+		c := genClaims(ht)
+		claimsText := string(c.raw)
+		if c.hasDateKind("huge") {
+			claimsText = `{"exp":1800000000,"n":1.5}` // a 2^63 literal does not survive MapClaims' float64
+		}
+		claimsJSON := true
+		switch n(ht, 1, 15) {
+		case 1:
+			claimsText = "{"
+			claimsJSON = false
+		case 2:
+			claimsText = `"x"`
+			claimsJSON = false
+		case 3:
+			claimsText = "null"
+		case 4:
+			claimsText = "[]"
+			claimsJSON = false
+		}
+		sig := []byte(word(ht, "\x00\x01\xfe\xff", 0, 70))
+		segs := []segSpec{encodeSeg(ht, []byte(headerText)), encodeSeg(ht, []byte(claimsText)), encodeSeg(ht, sig)}
+		token := segs[0].text + "." + segs[1].text + "." + segs[2].text
+		extraDots := n(ht, 1, 12) == 1
+		if extraDots {
+			token += "."
+		}
+
+		// the model of ParseUnverified
+		var wantErr error
+		switch {
+		case extraDots:
+			wantErr = jwt.ErrTokenMalformed
+		default:
+			if _, ok := modelDecode(segs[0].text, padding, strict); !ok || !headerJSON {
+				wantErr = jwt.ErrTokenMalformed
+			} else if _, ok := modelDecode(segs[1].text, padding, strict); !ok || !claimsJSON {
+				wantErr = jwt.ErrTokenMalformed
+			} else if headerText == "null" || header["alg"] == nil {
+				wantErr = jwt.ErrTokenUnverifiable
+			} else if a, isStr := header["alg"].(string); !isStr || jwt.GetSigningMethod(a) == nil {
+				wantErr = jwt.ErrTokenUnverifiable
+			} else if _, ok := modelDecode(segs[2].text, padding, strict); !ok {
+				wantErr = jwt.ErrTokenMalformed
+			}
+		}
+		tok, parts, err := parser.ParseUnverified(token, jwt.MapClaims{})
+		if wantErr == nil {
+			if err != nil {
+				col.fail(ht, "ParseUnverified(%q, padding=%v strict=%v) = %v, want success (%s/%s/%s)", token, padding, strict, err, segs[0].encoding, segs[1].encoding, segs[2].encoding)
+				return
+			}
+			if len(parts) != 3 || canonOf(tok.Header) != canon([]byte(headerText)) || tok.Method.Alg() != header["alg"] || string(tok.Signature) != string(sig) {
+				col.fail(ht, "ParseUnverified(%q): header %s (want %s), alg %v, signature %x (want %x)", token, mustJSON(tok.Header), headerText, tok.Method, tok.Signature, sig)
+				return
+			}
+			if claimsText != "null" && canonOf(tok.Claims) != canon([]byte(claimsText)) {
+				col.fail(ht, "ParseUnverified(%q): claims %s, want %s", token, mustJSON(tok.Claims), claimsText)
+				return
+			}
+			col.count("parsed")
+		} else {
+			if err == nil || !errors.Is(err, wantErr) {
+				col.fail(ht, "ParseUnverified(%q, padding=%v strict=%v) = %v, want %v (%s/%s/%s; header %q claims %q)", token, padding, strict, err, wantErr, segs[0].encoding, segs[1].encoding, segs[2].encoding, headerText, claimsText)
+				return
+			}
+			col.count(wantErr.Error())
+		}
+
+		// nothing panics: the full parse of this token and of random text, every claims type
+		junk := token
+		if chance(ht, 30) {
+			junk = word(ht, "aZ09-_=.+/ {}\"", 0, 30)
+		}
+		claimTypes := []jwt.Claims{jwt.MapClaims{}, &jwt.RegisteredClaims{}, jwt.RegisteredClaims{}, &customClaims{}}
+		for _, cl := range claimTypes {
+			keyFunc := func(t *jwt.Token) (any, error) {
+				switch t.Method.Alg() {
+				case "none":
+					return jwt.UnsafeAllowNoneSignatureType, nil
+				case "HS256", "HS384", "HS512":
+					return []byte("k"), nil
+				}
+				return keysFor("ES256")[0].public, nil
+			}
+			ptok, perr := jwt.ParseWithClaims(junk, cl, keyFunc, append(opts, jwt.WithJSONNumber())...)
+			if perr == nil && (ptok == nil || !ptok.Valid) {
+				col.fail(ht, "ParseWithClaims(%q, %T): no error but not valid", junk, cl)
+				return
+			}
+		}
+		col.count("nopanic")
+	})
+}
+
+type customClaims struct {
+	Foo string `json:"foo"`
+	jwt.RegisteredClaims
+}
+
+func (c customClaims) Validate() error {
+	if c.Foo == "bad" {
+		return errors.New("foo is bad")
+	}
+	return nil
+}
+
+// TestHegelSigningMethodsCheckKeysAndSignatures: Sign takes exactly the key types its method
+// documents (and the matching curve), Verify accepts the matching public key and nothing else,
+// no altered signature verifies, and the none method is only usable with its magic constant.
+func TestHegelSigningMethodsCheckKeysAndSignatures(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		alg := pick(ht, allAlgs)
+		m := methodOf(alg)
+		if m == nil || m.Alg() != alg {
+			col.fail(ht, "GetSigningMethod(%s) = %v", alg, m)
+			return
+		}
+		text := word(ht, "abc.xyzé", 0, 40)
+		key := pick(ht, keys())
+		serves := contains(key.algs, alg)
+		sig, err := m.Sign(text, key.private)
+		ktyOf := map[string]string{"HS": "oct", "RS": "RSA", "PS": "RSA", "ES": "EC", "Ed": "OKP"}[alg[:2]]
+		switch {
+		case serves:
+			if err != nil {
+				col.fail(ht, "%s.Sign with %s: %v", alg, key.name, err)
+				return
+			}
+		case key.kty != ktyOf:
+			// EdDSA takes any crypto.Signer and refuses one whose public key is not Ed25519 with
+			// ErrInvalidKey; the other methods switch on the key type
+			if !errors.Is(err, jwt.ErrInvalidKeyType) && !(alg == "EdDSA" && errors.Is(err, jwt.ErrInvalidKey)) {
+				col.fail(ht, "%s.Sign with %s (%s): %v, want ErrInvalidKeyType", alg, key.name, key.kty, err)
+				return
+			}
+			col.count("sign-wrong-type")
+		default:
+			// the right type but not serving: an EC key of another curve, or an oct key shorter than
+			// the hash (golang-jwt does not enforce RFC 7518 3.2, so those sign)
+			if key.kty == "EC" {
+				if !errors.Is(err, jwt.ErrInvalidKey) {
+					col.fail(ht, "%s.Sign with %s: %v, want ErrInvalidKey", alg, key.name, err)
+					return
+				}
+				col.count("sign-wrong-curve")
+			} else if err != nil {
+				col.fail(ht, "%s.Sign with %s: %v", alg, key.name, err)
+				return
+			}
+		}
+		if err != nil {
+			return
+		}
+		if err := m.Verify(text, sig, key.public); err != nil {
+			col.fail(ht, "%s.Verify of its own signature with %s: %v", alg, key.name, err)
+			return
+		}
+		// the expected signature sizes
+		wantLen := map[string]int{"HS256": 32, "HS384": 48, "HS512": 64, "ES256": 64, "ES384": 96, "ES512": 132, "EdDSA": 64}
+		if l, ok := wantLen[alg]; ok && len(sig) != l {
+			col.fail(ht, "%s signature of %d bytes, want %d", alg, len(sig), l)
+			return
+		}
+		if key.kty == "RSA" && len(sig) != 256 {
+			col.fail(ht, "%s signature of %d bytes, want 256", alg, len(sig))
+			return
+		}
+		// another key of the same type
+		for _, other := range keys() {
+			if other.kty == key.kty && other.name != key.name && contains(other.algs, alg) {
+				if err := m.Verify(text, sig, other.public); err == nil {
+					col.fail(ht, "%s signature by %s verifies under %s", alg, key.name, other.name)
+					return
+				}
+			}
+		}
+		// other key types
+		for _, other := range keys() {
+			if other.kty != key.kty {
+				if err := m.Verify(text, sig, other.public); !errors.Is(err, jwt.ErrInvalidKeyType) {
+					col.fail(ht, "%s.Verify with %s (%s): %v, want ErrInvalidKeyType", alg, other.name, other.kty, err)
+					return
+				}
+			}
+		}
+		// pointer forms golang-jwt does not take
+		switch pub := key.public.(type) {
+		case ed25519.PublicKey:
+			if err := m.Verify(text, sig, &pub); !errors.Is(err, jwt.ErrInvalidKeyType) {
+				col.fail(ht, "%s.Verify with *ed25519.PublicKey: %v", alg, err)
+				return
+			}
+		case *ecdsa.PublicKey:
+			if err := m.Verify(text, sig, *pub); !errors.Is(err, jwt.ErrInvalidKeyType) {
+				col.fail(ht, "%s.Verify with ecdsa.PublicKey by value: %v", alg, err)
+				return
+			}
+		}
+		// an altered signature
+		bad := append([]byte{}, sig...)
+		switch n(ht, 1, 4) {
+		case 1:
+			bad = bad[:len(bad)-1]
+		case 2:
+			bad = append(bad, 0)
+		case 3:
+			bad = nil
+		default:
+			i := n(ht, 0, len(bad)-1)
+			bad[i] ^= byte(1 << n(ht, 0, 7))
+		}
+		if err := m.Verify(text, bad, key.public); err == nil {
+			col.fail(ht, "%s: altered signature %x (from %x) verifies with %s", alg, bad, sig, key.name)
+			return
+		}
+		// another text
+		if err := m.Verify(text+"x", sig, key.public); err == nil {
+			col.fail(ht, "%s: signature of %q verifies %q", alg, text, text+"x")
+			return
+		}
+		col.count(alg)
+
+		// the none method
+		none := jwt.GetSigningMethod("none")
+		nsig, err := none.Sign(text, jwt.UnsafeAllowNoneSignatureType)
+		if err != nil || len(nsig) != 0 {
+			col.fail(ht, "none.Sign with the magic constant: %x, %v", nsig, err)
+			return
+		}
+		if _, err := none.Sign(text, key.private); !errors.Is(err, jwt.ErrTokenUnverifiable) {
+			col.fail(ht, "none.Sign with %s: %v, want NoneSignatureTypeDisallowedError", key.name, err)
+			return
+		}
+		if err := none.Verify(text, nil, jwt.UnsafeAllowNoneSignatureType); err != nil {
+			col.fail(ht, "none.Verify of an empty signature: %v", err)
+			return
+		}
+		if err := none.Verify(text, sig, jwt.UnsafeAllowNoneSignatureType); err == nil {
+			col.fail(ht, "none.Verify accepts a non-empty signature")
+			return
+		}
+		if err := none.Verify(text, nil, key.public); err == nil {
+			col.fail(ht, "none.Verify accepts %s", key.name)
+			return
+		}
+		ntok := jwt.NewWithClaims(none, jwt.MapClaims{"a": 1})
+		nstr, err := ntok.SignedString(jwt.UnsafeAllowNoneSignatureType)
+		if err != nil || !strings.HasSuffix(nstr, ".") {
+			col.fail(ht, "none token %q, %v", nstr, err)
+			return
+		}
+		if p, err := jwt.Parse(nstr, func(*jwt.Token) (any, error) { return jwt.UnsafeAllowNoneSignatureType, nil }); err != nil || !p.Valid {
+			col.fail(ht, "none token does not parse with the magic constant: %v", err)
+			return
+		}
+		if _, err := jwt.Parse(nstr, func(*jwt.Token) (any, error) { return key.public, nil }); !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+			col.fail(ht, "none token parses with %s: %v", key.name, err)
+			return
+		}
+		if _, err := jwt.Parse(nstr, func(*jwt.Token) (any, error) { return jwt.UnsafeAllowNoneSignatureType, nil }, jwt.WithValidMethods([]string{alg})); !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+			col.fail(ht, "none token parses under WithValidMethods(%s): %v", alg, err)
+			return
+		}
+	})
+}
+
+// TestHegelRequestExtractorsFindTheToken: the request package's extractors find the token where
+// the model says (Authorization: Bearer in any case, named headers, query and form arguments, in
+// order, with filters), and ParseFromRequest verifies it.
+func TestHegelRequestExtractorsFindTheToken(t *testing.T) {
+	col := newCollector(t)
+	key := keysFor("HS256")[0]
+	property(t, func(ht *hegel.T) {
+		tok := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{"sub": pick(ht, stringPool)})
+		str, err := tok.SignedString(key.private)
+		if err != nil {
+			col.fail(ht, "sign: %v", err)
+			return
+		}
+		// where the token goes, and what else is around
+		place := pick(ht, []string{"bearer", "header", "query", "form", "nowhere"})
+		headerName := pick(ht, []string{"X-Token", "Authorization", "x-token"})
+		argName := pick(ht, []string{"access_token", "tok"})
+		prefix := pick(ht, []string{"Bearer ", "bearer ", "BEARER ", "Bearer  ", "Token ", ""})
+		q := url.Values{}
+		form := url.Values{}
+		if chance(ht, 30) {
+			q.Set("other", "x")
+		}
+		if place == "query" {
+			q.Set(argName, str)
+		}
+		if place == "form" {
+			form.Set(argName, str)
+		}
+		var req *http.Request
+		if len(form) > 0 || chance(ht, 30) {
+			req, _ = http.NewRequest("POST", "http://example.test/?"+q.Encode(), strings.NewReader(form.Encode()))
+			req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		} else {
+			req, _ = http.NewRequest("GET", "http://example.test/?"+q.Encode(), nil)
+		}
+		if place == "bearer" {
+			req.Header.Set("Authorization", prefix+str)
+		}
+		if place == "header" {
+			req.Header.Set(headerName, str)
+		}
+		if chance(ht, 20) {
+			req.Header.Set("X-Other", "y")
+		}
+
+		// BearerExtractor
+		got, err := request.BearerExtractor{}.ExtractToken(req)
+		auth := req.Header.Get("Authorization")
+		wantBearer := ""
+		if len(auth) >= 7 && strings.EqualFold(auth[:7], "bearer ") {
+			wantBearer = auth[7:]
+		}
+		if wantBearer == "" {
+			if !errors.Is(err, request.ErrNoTokenInRequest) || got != "" {
+				col.fail(ht, "BearerExtractor on %q: %q, %v; want ErrNoTokenInRequest", auth, got, err)
+				return
+			}
+		} else if err != nil || got != wantBearer {
+			col.fail(ht, "BearerExtractor on %q: %q, %v; want %q", auth, got, err, wantBearer)
+			return
+		}
+		// HeaderExtractor: first named header with a value
+		names := []string{"X-Missing", headerName, "Authorization"}
+		got, err = request.HeaderExtractor(names).ExtractToken(req)
+		wantHeader := ""
+		for _, nm := range names {
+			if v := req.Header.Get(nm); v != "" {
+				wantHeader = v
+				break
+			}
+		}
+		if (wantHeader == "") != errors.Is(err, request.ErrNoTokenInRequest) || got != wantHeader {
+			col.fail(ht, "HeaderExtractor%q: %q, %v; want %q", names, got, err, wantHeader)
+			return
+		}
+		// ArgumentExtractor: query and form
+		args := []string{"missing", argName}
+		got, err = request.ArgumentExtractor(args).ExtractToken(req)
+		wantArg := ""
+		if place == "query" || place == "form" {
+			wantArg = str
+		}
+		if (wantArg == "") != errors.Is(err, request.ErrNoTokenInRequest) || got != wantArg {
+			col.fail(ht, "ArgumentExtractor%q (%s): %q, %v; want %q", args, place, got, err, wantArg)
+			return
+		}
+		// MultiExtractor in order, with a filter
+		multi := request.MultiExtractor{request.ArgumentExtractor(args), request.HeaderExtractor([]string{headerName}), &request.PostExtractionFilter{Extractor: request.BearerExtractor{}, Filter: func(s string) (string, error) { return strings.TrimSpace(s), nil }}}
+		got, err = multi.ExtractToken(req)
+		wantMulti := ""
+		switch {
+		case wantArg != "":
+			wantMulti = wantArg
+		case req.Header.Get(headerName) != "":
+			wantMulti = req.Header.Get(headerName)
+		case wantBearer != "":
+			wantMulti = strings.TrimSpace(wantBearer)
+		}
+		if (wantMulti == "") != errors.Is(err, request.ErrNoTokenInRequest) || got != wantMulti {
+			col.fail(ht, "MultiExtractor (%s, prefix %q): %q, %v; want %q", place, prefix, got, err, wantMulti)
+			return
+		}
+		// ParseFromRequest with the extractor that should find the token
+		parsed, err := request.ParseFromRequest(req, multi, func(*jwt.Token) (any, error) { return key.public, nil }, request.WithParser(jwt.NewParser(jwt.WithValidMethods([]string{"HS256"}))))
+		if wantMulti == str {
+			if err != nil || !parsed.Valid {
+				col.fail(ht, "ParseFromRequest (%s): %v, want valid", place, err)
+				return
+			}
+			col.count("found-" + place)
+		} else {
+			if err == nil {
+				col.fail(ht, "ParseFromRequest (%s, prefix %q) found %q valid", place, prefix, wantMulti)
+				return
+			}
+			col.count("not-found-" + place)
+		}
+	})
+}
