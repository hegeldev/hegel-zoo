diff --git a/hegel_keys_test.go b/hegel_keys_test.go
new file mode 100644
index 0000000..bd02527
--- /dev/null
+++ b/hegel_keys_test.go
@@ -0,0 +1,120 @@
+package jwt_test
+
+// The key pool, built once: for every signing method a private key for Go, the matching
+// verification key, and the same key in the form the oracle imports (PEM for RSA/EC/OKP, a JWK
+// dict for oct).
+
+import (
+	"crypto/ecdsa"
+	"crypto/ed25519"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"sync"
+
+	"github.com/golang-jwt/jwt/v5"
+)
+
+type keyPair struct {
+	name    string
+	kty     string   // oct, RSA, EC, OKP
+	algs    []string // the signing methods this key serves
+	private any      // what golang-jwt signs with
+	public  any      // what golang-jwt verifies with
+	oracle  string   // PEM of the private key, or the oct JWK
+}
+
+var (
+	poolOnce sync.Once
+	pool     []keyPair
+)
+
+func pemOf(kind string, der []byte) string {
+	return string(pem.EncodeToMemory(&pem.Block{Type: kind, Bytes: der}))
+}
+
+func keys() []keyPair {
+	poolOnce.Do(func() {
+		octs := func(name string, size int, algs ...string) {
+			k := make([]byte, size)
+			if _, err := rand.Read(k); err != nil {
+				panic(err)
+			}
+			pool = append(pool, keyPair{name: name, kty: "oct", algs: algs, private: k, public: k,
+				oracle: string(mustJSON(map[string]string{"kty": "oct", "k": base64.RawURLEncoding.EncodeToString(k)}))})
+		}
+		octs("oct32", 32, "HS256")
+		octs("oct48", 48, "HS256", "HS384")
+		octs("oct64", 64, "HS256", "HS384", "HS512")
+		octs("oct64b", 64, "HS256", "HS384", "HS512")
+
+		for i, name := range []string{"rsa2048", "rsa2048b"} {
+			k, err := rsa.GenerateKey(rand.Reader, 2048)
+			if err != nil {
+				panic(err)
+			}
+			der, err := x509.MarshalPKCS8PrivateKey(k)
+			if err != nil {
+				panic(err)
+			}
+			_ = i
+			pool = append(pool, keyPair{name: name, kty: "RSA", algs: []string{"RS256", "RS384", "RS512", "PS256", "PS384", "PS512"},
+				private: k, public: &k.PublicKey, oracle: pemOf("PRIVATE KEY", der)})
+		}
+
+		for _, c := range []struct {
+			name  string
+			curve elliptic.Curve
+			alg   string
+		}{{"p256", elliptic.P256(), "ES256"}, {"p384", elliptic.P384(), "ES384"}, {"p521", elliptic.P521(), "ES512"}, {"p256b", elliptic.P256(), "ES256"}} {
+			k, err := ecdsa.GenerateKey(c.curve, rand.Reader)
+			if err != nil {
+				panic(err)
+			}
+			der, err := x509.MarshalPKCS8PrivateKey(k)
+			if err != nil {
+				panic(err)
+			}
+			pool = append(pool, keyPair{name: c.name, kty: "EC", algs: []string{c.alg}, private: k, public: &k.PublicKey, oracle: pemOf("PRIVATE KEY", der)})
+		}
+
+		for _, name := range []string{"ed25519", "ed25519b"} {
+			pub, priv, err := ed25519.GenerateKey(rand.Reader)
+			if err != nil {
+				panic(err)
+			}
+			der, err := x509.MarshalPKCS8PrivateKey(priv)
+			if err != nil {
+				panic(err)
+			}
+			pool = append(pool, keyPair{name: name, kty: "OKP", algs: []string{"EdDSA"}, private: priv, public: pub, oracle: pemOf("PRIVATE KEY", der)})
+		}
+	})
+	return pool
+}
+
+// keysFor lists the pool entries that serve alg.
+func keysFor(alg string) []keyPair {
+	var out []keyPair
+	for _, k := range keys() {
+		for _, a := range k.algs {
+			if a == alg {
+				out = append(out, k)
+			}
+		}
+	}
+	return out
+}
+
+// allAlgs is every signing method golang-jwt registers apart from none.
+var allAlgs = []string{"HS256", "HS384", "HS512", "RS256", "RS384", "RS512", "PS256", "PS384", "PS512", "ES256", "ES384", "ES512", "EdDSA"}
+
+func methodOf(alg string) jwt.SigningMethod { return jwt.GetSigningMethod(alg) }
+
+var _ = json.Marshal
+
+func base64url(b []byte) string { return base64.RawURLEncoding.EncodeToString(b) }
diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..49183d2
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,189 @@
+package jwt_test
+
+// The oracle: joserfc (Python, the JOSE implementation by the author of Authlib, on top of
+// pyca/cryptography), driven as one persistent child: a command and hex-encoded arguments per
+// line in, one JSON object per line out. Every reply has "ok"; a failure carries "error" (the
+// exception class) and "message". Keys cross the boundary as PEM (asymmetric) or as a JWK dict
+// (oct).
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+)
+
+const pythonScript = `
+import sys, json, base64, warnings
+warnings.simplefilter("ignore")
+from joserfc import jwk, jws, jwt
+from joserfc.jws import JWSRegistry
+
+ALGS = ["HS256", "HS384", "HS512", "RS256", "RS384", "RS512", "PS256", "PS384", "PS512", "ES256", "ES384", "ES512", "EdDSA", "none"]
+
+def hx(s):
+    return bytes.fromhex(s)
+
+def key_of(j, kty):
+    # PEM text for RSA/EC/OKP keys, a JWK dict for oct keys
+    if kty == "oct":
+        return jwk.import_key(json.loads(j))
+    return jwk.import_key(j, kty)
+
+def reg(algs):
+    return JWSRegistry(algorithms=algs, strict_check_header=False)
+
+def handle(cmd, a):
+    if cmd == "E":  # encode: header json, claims json, key, kty, alg
+        h = json.loads(a[0])
+        return {"token": jwt.encode(h, json.loads(a[1]), key_of(a[2].decode(), a[3].decode()), algorithms=[a[4].decode()], registry=reg([a[4].decode()]), default_type=None)}
+    if cmd == "D":  # decode: token, key, kty, alg
+        t = jwt.decode(a[0], key_of(a[1].decode(), a[2].decode()), algorithms=[a[3].decode()], registry=reg([a[3].decode()]))
+        return {"header": t.header, "claims": t.claims}
+    if cmd == "S":  # raw JWS verify: token, key, kty, alg -> payload bytes as hex
+        o = jws.deserialize_compact(a[0], key_of(a[1].decode(), a[2].decode()), registry=reg([a[3].decode()]))
+        return {"payload": o.payload.hex(), "protected": o.protected}
+    if cmd == "V":  # validate claims: claims json, now, leeway
+        r = jwt.JWTClaimsRegistry(now=int(a[1]), leeway=int(a[2]))
+        try:
+            r.validate(json.loads(a[0]))
+            return {"valid": True}
+        except Exception as e:
+            return {"valid": False, "error": type(e).__name__, "message": str(e)}
+    return {"error": "unknown command " + cmd}
+
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [hx(p) for p in parts[1:]]
+    try:
+        reply = handle(cmd, args)
+        reply.setdefault("ok", True)
+    except Exception as e:
+        reply = {"ok": False, "error": type(e).__name__, "message": str(e)}
+    print(json.dumps(reply), flush=True)
+`
+
+type pyChild struct {
+	mu    sync.Mutex
+	cmd   *exec.Cmd
+	stdin *bufio.Writer
+	out   *bufio.Reader
+}
+
+var (
+	pyOnce sync.Once
+	py     *pyChild
+)
+
+func oracle() *pyChild {
+	pyOnce.Do(func() {
+		python := "python3"
+		if p := os.Getenv("HEGEL_PYTHON"); p != "" {
+			python = p
+		}
+		cmd := exec.Command(python, "-u", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			panic(err)
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			panic(err)
+		}
+		if err := cmd.Start(); err != nil {
+			panic(fmt.Sprintf("python3 with joserfc is needed as the oracle: %v", err))
+		}
+		py = &pyChild{cmd: cmd, stdin: bufio.NewWriter(in), out: bufio.NewReader(out)}
+	})
+	return py
+}
+
+// reply is the common part of every oracle answer.
+type reply struct {
+	Ok      bool   `json:"ok"`
+	Error   string `json:"error"`
+	Message string `json:"message"`
+}
+
+// ask sends one request and decodes the JSON answer into v (which embeds reply).
+func ask(v interface{}, cmd string, args ...[]byte) {
+	p := oracle()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	line := cmd
+	for _, a := range args {
+		line += " " + hex.EncodeToString(a)
+	}
+	p.stdin.WriteString(line + "\n")
+	if err := p.stdin.Flush(); err != nil {
+		panic(fmt.Sprintf("joserfc oracle: %v", err))
+	}
+	raw, err := p.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("joserfc oracle exited: %v", err))
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		panic(fmt.Sprintf("joserfc oracle reply %q: %v", raw, err))
+	}
+}
+
+func s(x string) []byte { return []byte(x) }
+
+func mustJSON(v interface{}) []byte {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
+
+type encodeReply struct {
+	reply
+	Token string `json:"token"`
+}
+
+type decodeReply struct {
+	reply
+	Header json.RawMessage `json:"header"`
+	Claims json.RawMessage `json:"claims"`
+}
+
+type verifyReply struct {
+	reply
+	Payload   string          `json:"payload"`
+	Protected json.RawMessage `json:"protected"`
+}
+
+type validateReply struct {
+	reply
+	Valid bool `json:"valid"`
+}
+
+// oracleEncode signs claims under header with the key (PEM or oct JWK) and alg.
+func oracleEncode(header, claims []byte, key string, kty, alg string) encodeReply {
+	var r encodeReply
+	ask(&r, "E", header, claims, s(key), s(kty), s(alg))
+	return r
+}
+
+func oracleDecode(token string, key string, kty, alg string) decodeReply {
+	var r decodeReply
+	ask(&r, "D", s(token), s(key), s(kty), s(alg))
+	return r
+}
+
+func oracleVerify(token string, key string, kty, alg string) verifyReply {
+	var r verifyReply
+	ask(&r, "S", s(token), s(key), s(kty), s(alg))
+	return r
+}
+
+func oracleValidate(claims []byte, now, leeway int64) validateReply {
+	var r validateReply
+	ask(&r, "V", claims, s(fmt.Sprint(now)), s(fmt.Sprint(leeway)))
+	return r
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..cd2436c
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,178 @@
+package jwt_test
+
+// One plain test per recorded bug (bugs.toml). Each asserts the correct behaviour, so it fails
+// while the bug exists and passes once upstream fixes it; target.toml lists them as expected
+// failures.
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	jwt "github.com/golang-jwt/jwt/v5"
+)
+
+// golang-jwt/1: newNumericDateFromSeconds converts the float64 fraction to nanoseconds by
+// truncation (int64(frac*1e9)) and NewNumericDate then truncates to TimePrecision, so a date with
+// as many decimals as the precision reads one unit early whenever the float64 lies below the
+// decimal: 1700000000.123 at millisecond precision is .122.
+func TestHegelPinSubsecondDatesReadExactly(t *testing.T) {
+	defer func() { jwt.TimePrecision = time.Second }()
+	jwt.TimePrecision = time.Millisecond
+	for _, in := range []string{"1700000000.123", "1700000000.1", "1600000000.001"} {
+		var d jwt.NumericDate
+		if err := json.Unmarshal([]byte(in), &d); err != nil {
+			t.Fatalf("unmarshal %s: %v", in, err)
+		}
+		out, _ := json.Marshal(d)
+		if string(out) != in {
+			t.Errorf("NumericDate %s at millisecond precision reads back as %s (%d ns)", in, out, d.Nanosecond())
+		}
+	}
+}
+
+// golang-jwt/2: MarshalJSON concatenates the integer Unix seconds with the (always positive)
+// nanosecond offset within that second; for an instant before the epoch with a fraction the two
+// do not add up: -0.5 s is Unix() = -1 with a 500 ms offset, written "-1.500".
+func TestHegelPinPreEpochDatesMarshalTheirInstant(t *testing.T) {
+	defer func() { jwt.TimePrecision = time.Second }()
+	jwt.TimePrecision = time.Millisecond
+	for _, c := range []struct {
+		secs, nanos int64
+		want        string
+	}{{-1, 500_000_000, "-0.500"}, {-2, 500_000_000, "-1.500"}, {-1, 250_000_000, "-0.750"}} {
+		d := jwt.NewNumericDate(time.Unix(c.secs, c.nanos))
+		out, _ := json.Marshal(d)
+		if string(out) != c.want {
+			t.Errorf("NumericDate of %v marshals as %s, want %s", d.Time.UTC(), out, c.want)
+		}
+		var back jwt.NumericDate
+		if err := json.Unmarshal(out, &back); err == nil && !back.Time.Equal(d.Time) {
+			t.Errorf("  and reads back as %v", back.Time.UTC())
+		}
+	}
+}
+
+// golang-jwt/3: newNumericDateFromSeconds does int64(round) on the float64; at or beyond 2^63
+// seconds the conversion gives the minimum int64 (and MapClaims ignores the json.Number range
+// error too), so nbf: 1e19 is a not-before far in the past and the token is accepted, while
+// exp: 1e19 is expired.
+func TestHegelPinHugeDatesDoNotWrap(t *testing.T) {
+	now := time.Unix(1_800_000_000, 0)
+	v := jwt.NewValidator(jwt.WithTimeFunc(func() time.Time { return now }))
+	for _, raw := range []string{"1e19", "9223372036854775808"} {
+		var m jwt.MapClaims
+		if err := json.Unmarshal([]byte(`{"nbf":`+raw+`}`), &m); err != nil {
+			t.Fatal(err)
+		}
+		if err := v.Validate(m); err == nil {
+			t.Errorf("nbf: %s validates as already valid; want ErrTokenNotValidYet (or an error about the value)", raw)
+		}
+		m = jwt.MapClaims{}
+		if err := json.Unmarshal([]byte(`{"exp":`+raw+`}`), &m); err != nil {
+			t.Fatal(err)
+		}
+		if err := v.Validate(m); errors.Is(err, jwt.ErrTokenExpired) {
+			t.Errorf("exp: %s validates as expired: %v; want valid (or an error about the value)", raw, err)
+		}
+		var r jwt.RegisteredClaims
+		if err := json.Unmarshal([]byte(`{"exp":`+raw+`}`), &r); err == nil && r.ExpiresAt != nil && r.ExpiresAt.Unix() < 0 {
+			t.Errorf("RegisteredClaims exp: %s is %v", raw, r.ExpiresAt.Time.UTC())
+		}
+	}
+}
+
+// golang-jwt/4: NumericDate.UnmarshalJSON decodes into a json.Number, and encoding/json accepts
+// a JSON string holding a number there, so RegisteredClaims reads "exp":"1800000000" as a date
+// while MapClaims reports ErrInvalidType for the same document (RFC 7519: a NumericDate is a
+// JSON numeric value).
+func TestHegelPinStringDatesAreRefused(t *testing.T) {
+	raw := []byte(`{"exp":"1800000000","nbf":"1700000000"}`)
+	var r jwt.RegisteredClaims
+	err := json.Unmarshal(raw, &r)
+	if err == nil {
+		t.Errorf("RegisteredClaims accepts %s as exp=%v nbf=%v", raw, r.ExpiresAt, r.NotBefore)
+	}
+	var m jwt.MapClaims
+	if err := json.Unmarshal(raw, &m); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.GetExpirationTime(); !errors.Is(err, jwt.ErrInvalidType) {
+		t.Errorf("MapClaims.GetExpirationTime on %s: %v, want ErrInvalidType", raw, err)
+	}
+}
+
+// golang-jwt/5: MapClaims.parseNumericDate and parseString report ErrInvalidType for an explicit
+// null, while parseClaimsString (aud) treats null as "no value" and RegisteredClaims reads a null
+// date or string as absent; the two claims types validate the same document differently.
+func TestHegelPinNullClaimsAreAbsent(t *testing.T) {
+	raw := []byte(`{"exp":null,"sub":null,"aud":null}`)
+	var m jwt.MapClaims
+	if err := json.Unmarshal(raw, &m); err != nil {
+		t.Fatal(err)
+	}
+	var r jwt.RegisteredClaims
+	if err := json.Unmarshal(raw, &r); err != nil {
+		t.Fatal(err)
+	}
+	v := jwt.NewValidator()
+	merr, rerr := v.Validate(m), v.Validate(r)
+	if (merr == nil) != (rerr == nil) {
+		t.Errorf("Validate of %s: MapClaims %v, RegisteredClaims %v", raw, merr, rerr)
+	}
+	if d, err := m.GetExpirationTime(); err != nil || d != nil {
+		t.Errorf("MapClaims.GetExpirationTime on exp: null = %v, %v; want nil, nil like GetAudience on aud: null", d, err)
+	}
+	if s, err := m.GetSubject(); err != nil || s != "" {
+		t.Errorf("MapClaims.GetSubject on sub: null = %q, %v; want \"\", nil", s, err)
+	}
+}
+
+// golang-jwt/6: MarshalJSON derives the number of fraction digits from log10(second/precision),
+// so a precision that is not a power of ten gets too few digits: at 500 ms 10.5 is written 10,
+// and the date reads back as another instant.
+func TestHegelPinOddPrecisionsRoundTrip(t *testing.T) {
+	defer func() { jwt.TimePrecision = time.Second }()
+	for _, prec := range []time.Duration{500 * time.Millisecond, 250 * time.Millisecond} {
+		jwt.TimePrecision = prec
+		d := jwt.NewNumericDate(time.Unix(10, 500_000_000))
+		out, _ := json.Marshal(d)
+		var back jwt.NumericDate
+		if err := json.Unmarshal(out, &back); err != nil {
+			t.Fatal(err)
+		}
+		if !back.Time.Equal(d.Time) {
+			t.Errorf("at TimePrecision %v, %v marshals as %s and reads back as %v", prec, d.Time.UTC(), out, back.Time.UTC())
+		}
+	}
+}
+
+// golang-jwt/7: Parser.DecodeSegment uses encoding/base64, which skips \r and \n anywhere in
+// the input (Strict() only concerns the trailing bits), so a segment with line breaks decodes,
+// under WithStrictDecoding too: a token with line breaks in its signature parses and verifies
+// (in the header or payload they at least spoil the signature, since the signing text is taken
+// raw), and ParseUnverified takes them anywhere. RFC 7515 section 7.1 has no whitespace in the
+// compact serialization and RFC 4648 section 3.3 rejects non-alphabet characters unless a
+// specification says otherwise.
+func TestHegelPinNewlinesInATokenAreMalformed(t *testing.T) {
+	key := []byte("0123456789abcdef0123456789abcdef")
+	tok := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{"sub": "x"})
+	str, err := tok.SignedString(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parts := strings.Split(str, ".")
+	broken := parts[0] + "." + parts[1] + "." + parts[2][:10] + "\r\n" + parts[2][10:]
+	keyFunc := func(*jwt.Token) (any, error) { return key, nil }
+	for _, opts := range [][]jwt.ParserOption{nil, {jwt.WithStrictDecoding()}} {
+		p, err := jwt.Parse(broken, keyFunc, opts...)
+		if err == nil && p.Valid {
+			t.Errorf("a token with line breaks in its signature parses and verifies (%d options): %q", len(opts), broken)
+		}
+	}
+	if _, err := jwt.NewParser(jwt.WithStrictDecoding()).DecodeSegment("eyJhbGci\nOiJub25lIn0"); err == nil {
+		t.Errorf("DecodeSegment accepts a line break inside the segment under WithStrictDecoding")
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..231e4d1
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,301 @@
+package jwt_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the model of the wide property that found it (checkValidation,
+// checkAgreement, checkDateRoundTrip, modelDecode and the tamper verdict of hegel_test.go), so
+// that each bug has a property that finds it every run (the wide properties reach the shapes at
+// their natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does
+// not touch instead (a whole-second instant at the precision, a pre-epoch whole second, a
+// large date within int64, a quoted text that is not a number, a value where the null was, a
+// whole second at the odd precision, a junk character that is not a line break) and passes.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	jwt "github.com/golang-jwt/jwt/v5"
+)
+
+// --------------------------------------------------------------------------- golang-jwt/1
+
+// fractionCases: an instant with a fraction at millisecond or microsecond precision; under
+// HEGEL_NO_KNOWN=1 a whole-second instant at those precisions, or any instant at second
+// precision (where the fraction is truncated away before it is written).
+var (
+	subsecond = pick(time.Millisecond, time.Microsecond)
+	// fractions: a fraction in microseconds, as nanoseconds.
+	fractions     = hegel.Map(hegel.Integers(1, 999_999), func(us int) int64 { return int64(us) * 1000 })
+	fractionKnown = hegel.Composite(func(tc hegel.TestCase) dateCase {
+		return dateCase{prec: hegel.Draw(tc, subsecond), secs: hegel.Draw(tc, roundTripSecs), nanos: hegel.Draw(tc, fractions)}
+	})
+	fractionPast = hegel.OneOf(
+		hegel.Composite(func(tc hegel.TestCase) dateCase {
+			return dateCase{prec: hegel.Draw(tc, subsecond), secs: hegel.Draw(tc, roundTripSecs)}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) dateCase {
+			return dateCase{prec: time.Second, secs: hegel.Draw(tc, roundTripSecs), nanos: hegel.Draw(tc, fractions)}
+		}),
+	)
+	fractionCases = shaped(fractionKnown, fractionPast)
+)
+
+// TestHegelFractionsRoundTripAtTheirPrecision: a NumericDate with a fraction at millisecond or
+// microsecond precision marshals and reads back as the same instant; it reads one unit early
+// whenever the float64 lies below the decimal (golang-jwt/1).
+func TestHegelFractionsRoundTripAtTheirPrecision(t *testing.T) {
+	col := newCollector(t)
+	defer func() { jwt.TimePrecision = time.Second }()
+	property(t, func(ht *hegel.T) {
+		checkDateRoundTrip(ht, col, hegel.Draw(ht, fractionCases))
+	})
+}
+
+// --------------------------------------------------------------------------- golang-jwt/2
+
+// preEpochCases: an instant before the epoch with a fraction at sub-second precision; under
+// HEGEL_NO_KNOWN=1 a pre-epoch whole second at those precisions, or a pre-epoch instant at
+// second precision.
+var (
+	preEpochSecs  = hegel.Map(hegel.Integers(1, 4_000_000_000), func(s int) int64 { return int64(s) })
+	preEpochKnown = hegel.Composite(func(tc hegel.TestCase) dateCase {
+		return dateCase{prec: hegel.Draw(tc, subsecond), secs: hegel.Draw(tc, preEpochSecs), negative: true, nanos: hegel.Draw(tc, fractions)}
+	})
+	preEpochPast = hegel.OneOf(
+		hegel.Composite(func(tc hegel.TestCase) dateCase {
+			return dateCase{prec: hegel.Draw(tc, subsecond), secs: hegel.Draw(tc, preEpochSecs), negative: true}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) dateCase {
+			return dateCase{prec: time.Second, secs: hegel.Draw(tc, preEpochSecs), negative: true, nanos: hegel.Draw(tc, fractions)}
+		}),
+	)
+	preEpochCases = shaped(preEpochKnown, preEpochPast)
+)
+
+// TestHegelPreEpochInstantsMarshalThemselves: a NumericDate before the epoch marshals as its
+// own instant and reads back; with a fraction the integer seconds and the positive nanosecond
+// offset are concatenated into another instant (-0.5 s is written -1.500, golang-jwt/2).
+func TestHegelPreEpochInstantsMarshalThemselves(t *testing.T) {
+	col := newCollector(t)
+	defer func() { jwt.TimePrecision = time.Second }()
+	property(t, func(ht *hegel.T) {
+		checkDateRoundTrip(ht, col, hegel.Draw(ht, preEpochCases))
+	})
+}
+
+// --------------------------------------------------------------------------- claims regions
+
+// claimsWithDates is a claims document whose exp, nbf and iat (at least one of them, by a
+// mask) come from region, the rest from the general generators.
+func claimsWithDates(region hegel.Generator[dateClaim]) hegel.Generator[claimsDoc] {
+	return hegel.Composite(func(tc hegel.TestCase) claimsDoc {
+		mask := hegel.Draw(tc, hegel.Integers(1, 7))
+		slot := func(bit int) dateClaim {
+			if mask&bit != 0 {
+				return hegel.Draw(tc, region)
+			}
+			return dateClaim{kind: "absent"}
+		}
+		return claimsDoc{
+			exp: slot(1), nbf: slot(2), iat: slot(4),
+			iss: hegel.Draw(tc, strs), sub: hegel.Draw(tc, strs), jti: hegel.Draw(tc, strs),
+			aud:     hegel.Draw(tc, auds),
+			private: hegel.Draw(tc, privates),
+			order:   hegel.Draw(tc, orderTape),
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- golang-jwt/3
+
+// hugeDateCases: a validation case whose dates are at or beyond 2^63 seconds (or beyond
+// float64); under HEGEL_NO_KNOWN=1 large dates within int64 (far-future instants).
+var (
+	bigDates = hegel.Map(pick("1000000000000000000", "4000000000000000000", "4611686018427387904"), func(s string) dateClaim {
+		v, _ := strconv.ParseInt(s, 10, 64)
+		return dateClaim{kind: "int", secs: v}
+	})
+	hugeDateCases = valCasesOf(claimsWithDates(shaped(dateHuge, bigDates)))
+)
+
+// TestHegelDatesBeyondInt64DoNotWrap: a numeric date at or beyond 2^63 seconds is an instant
+// beyond any clock (nbf not yet valid, exp not expired) or refused, never a wrapped past
+// instant; the package converts the float64 to int64 and lands in the year -292277022657, so
+// nbf: 1e19 is accepted and exp: 1e19 is expired (golang-jwt/3).
+func TestHegelDatesBeyondInt64DoNotWrap(t *testing.T) {
+	col := newCollector(t)
+	key := keysFor("HS256")[0]
+	property(t, func(ht *hegel.T) {
+		checkValidation(ht, col, key, hegel.Draw(ht, hugeDateCases))
+	})
+}
+
+// --------------------------------------------------------------------------- golang-jwt/4
+
+// stringDateCases: a validation case whose dates are quoted integers; under HEGEL_NO_KNOWN=1
+// quoted texts that are not number literals.
+var (
+	quotedDates    = hegel.Map(dateSecs, func(s int64) dateClaim { return dateClaim{kind: "string", secs: s} })
+	unnumericDates = hegel.Map(pick(`"soon"`, `""`, `"tomorrow"`, `"1800000000s"`, `"0x10"`, `"+1"`, `" 1"`), func(s string) dateClaim {
+		return dateClaim{kind: "badstring", text: s}
+	})
+	stringDateCases = valCasesOf(claimsWithDates(shaped(quotedDates, unnumericDates)))
+)
+
+// TestHegelStringDatesAreInvalidTypes: a JSON string holding a number is not a NumericDate (RFC
+// 7519 section 2): MapClaims reports ErrInvalidType and RegisteredClaims refuses the document;
+// RegisteredClaims accepts it through json.Number (golang-jwt/4).
+func TestHegelStringDatesAreInvalidTypes(t *testing.T) {
+	col := newCollector(t)
+	key := keysFor("HS256")[0]
+	property(t, func(ht *hegel.T) {
+		checkValidation(ht, col, key, hegel.Draw(ht, stringDateCases))
+	})
+}
+
+// --------------------------------------------------------------------------- golang-jwt/5
+
+// nullClaimCases: a validation case whose exp, nbf, iat, iss and sub (at least one, by a mask)
+// are explicit nulls, the rest of the document one RegisteredClaims holds; under
+// HEGEL_NO_KNOWN=1 the masked claims hold a value instead.
+var (
+	nullDate = shaped(dateNull, dateInt)
+	nullStr  = shaped(strNull, strString)
+	nullDocs = hegel.Composite(func(tc hegel.TestCase) claimsDoc {
+		mask := hegel.Draw(tc, hegel.Integers(1, 31))
+		date := func(bit int) dateClaim {
+			if mask&bit != 0 {
+				return hegel.Draw(tc, nullDate)
+			}
+			return dateClaim{kind: "absent"}
+		}
+		str := func(bit int) strClaim {
+			if mask&bit != 0 {
+				return hegel.Draw(tc, nullStr)
+			}
+			return strClaim{kind: "absent"}
+		}
+		return claimsDoc{
+			exp: date(1), nbf: date(2), iat: date(4),
+			iss: str(8), sub: str(16), jti: hegel.Draw(tc, typedStrs),
+			aud:     hegel.Draw(tc, typedAuds),
+			private: hegel.Draw(tc, privates),
+			order:   hegel.Draw(tc, orderTape),
+		}
+	})
+	nullClaimCases = valCasesOf(nullDocs)
+)
+
+// TestHegelNullClaimsAreAbsentEverywhere: an explicit null exp, nbf, iat, iss or sub is an
+// absent claim for the validator and the accessors of MapClaims as it is for a null aud and
+// for RegisteredClaims; MapClaims reports ErrInvalidType (golang-jwt/5).
+func TestHegelNullClaimsAreAbsentEverywhere(t *testing.T) {
+	col := newCollector(t)
+	key := keysFor("HS256")[0]
+	property(t, func(ht *hegel.T) {
+		vc := hegel.Draw(ht, nullClaimCases)
+		checkValidation(ht, col, key, vc)
+		checkAgreement(ht, col, vc.claims)
+	})
+}
+
+// --------------------------------------------------------------------------- golang-jwt/6
+
+// oddPrecisionCases: an instant with a fraction at a precision that is not a power of ten
+// (500 ms, 250 ms); under HEGEL_NO_KNOWN=1 a whole second at those precisions.
+var (
+	oddPrecisions = pick(500*time.Millisecond, 250*time.Millisecond)
+	quarters      = hegel.Map(hegel.Integers(1, 3), func(q int) int64 { return int64(q) * 250_000_000 })
+	oddKnown      = hegel.Composite(func(tc hegel.TestCase) dateCase {
+		return dateCase{prec: hegel.Draw(tc, oddPrecisions), secs: hegel.Draw(tc, roundTripSecs), nanos: hegel.Draw(tc, quarters)}
+	})
+	oddPast = hegel.Composite(func(tc hegel.TestCase) dateCase {
+		return dateCase{prec: hegel.Draw(tc, oddPrecisions), secs: hegel.Draw(tc, roundTripSecs)}
+	})
+	oddPrecisionCases = shaped(oddKnown, oddPast)
+)
+
+// TestHegelOddPrecisionsWriteTheirFraction: at a TimePrecision that is not a power of ten the
+// fraction is written with as many digits as it needs and reads back; MarshalJSON takes the
+// digit count from log10 and writes none, so 10.5 at 500 ms is "10" (golang-jwt/6).
+func TestHegelOddPrecisionsWriteTheirFraction(t *testing.T) {
+	col := newCollector(t)
+	defer func() { jwt.TimePrecision = time.Second }()
+	property(t, func(ht *hegel.T) {
+		checkDateRoundTrip(ht, col, hegel.Draw(ht, oddPrecisionCases))
+	})
+}
+
+// --------------------------------------------------------------------------- golang-jwt/7
+
+// lineBreakCase: a token golang-jwt signs with HS256, a text inserted into one of its segments
+// (a line break; under HEGEL_NO_KNOWN=1 another character outside the alphabet), and the
+// decoding options.
+type lineBreakCase struct {
+	sub             string
+	edit            tamperEdit
+	padding, strict bool
+}
+
+var (
+	otherJunk      = pick(" ", "!", "=", ".")
+	lineBreakCases = hegel.Composite(func(tc hegel.TestCase) lineBreakCase {
+		return lineBreakCase{
+			sub:     hegel.Draw(tc, poolString),
+			edit:    hegel.Draw(tc, shaped(inserts(lineBreaks), inserts(otherJunk))),
+			padding: hegel.Draw(tc, chance(40)),
+			strict:  hegel.Draw(tc, chance(40)),
+		}
+	})
+)
+
+func (c lineBreakCase) GoString() string {
+	return fmt.Sprintf("sub=%q %#v padding=%v strict=%v", c.sub, c.edit, c.padding, c.strict)
+}
+
+// TestHegelLineBreaksInSegmentsAreMalformed: a token with a line break inside a segment is
+// malformed under every option pair, for DecodeSegment and for Parse (RFC 7515 section 7.1 has
+// no whitespace in the compact serialization, RFC 4648 section 3.3 rejects characters outside
+// the alphabet); encoding/base64 skips line breaks, so the segment decodes and a token with a
+// line break in its signature verifies, under WithStrictDecoding too (golang-jwt/7).
+func TestHegelLineBreaksInSegmentsAreMalformed(t *testing.T) {
+	col := newCollector(t)
+	key := keysFor("HS256")[0]
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, lineBreakCases)
+		tok := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{"sub": c.sub})
+		str, err := tok.SignedString(key.private)
+		if err != nil {
+			col.fail(ht, "sign: %v", err)
+			return
+		}
+		opts := []jwt.ParserOption{jwt.WithoutClaimsValidation()}
+		if c.padding {
+			opts = append(opts, jwt.WithPaddingAllowed())
+		}
+		if c.strict {
+			opts = append(opts, jwt.WithStrictDecoding())
+		}
+		tampered := c.edit.apply(strings.Split(str, "."))
+		shapes := c.edit.shapes()
+		// the segment alone
+		seg := tampered[c.edit.seg]
+		wantBytes, wantOK := modelDecode(seg, c.padding, c.strict)
+		got, err := jwt.NewParser(opts...).DecodeSegment(seg)
+		if (err == nil) != wantOK || (wantOK && string(got) != string(wantBytes)) {
+			col.mismatch(ht, shapes, "DecodeSegment(%q, padding=%v strict=%v) = %x, %v; model %x, %v", seg, c.padding, c.strict, got, err, wantBytes, wantOK)
+			return
+		}
+		// the whole token
+		bad := strings.Join(tampered, ".")
+		btok, err := jwt.Parse(bad, func(*jwt.Token) (any, error) { return key.public, nil }, opts...)
+		if !checkTampered(ht, col, shapes, c.edit.verdict(tampered, c.padding, c.strict), fmt.Sprintf("padding=%v strict=%v", c.padding, c.strict), bad, btok, err) {
+			return
+		}
+		col.count(fmt.Sprintf("segment-%d", c.edit.seg))
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..5ab8d1e
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2783 @@
+package jwt_test
+
+// Hegel property tests for golang-jwt/jwt v5, written for the Hegel zoo.
+// See targets/go/golang-jwt/README.md.
+//
+// Oracles: joserfc (Python) reads what golang-jwt signs and signs what it reads, for every
+// algorithm; a model of RFC 7519 claims validation under a stopped clock (exp, nbf, iat with
+// leeway, aud any/all, iss, sub, required claims, ill-typed claims) for both MapClaims and
+// RegisteredClaims; a model of NumericDate and ClaimStrings serialisation; a model of the
+// parser's segment decoding options; and the signing methods' own contracts (which key types
+// they take, that a changed signature never verifies).
+//
+// Generators are package-level values built from the binding's combinators: a case is a small
+// record (a claims document of claim records and a member order, validation options, a date
+// with its precision, a token of segment spellings and edits) drawn once and rendered by pure
+// functions. The shapes of the recorded bugs (bugs.toml) are drawn by default as explicit
+// alternatives, and a property that meets one fails naming the bug (mismatch); HEGEL_NO_KNOWN=1
+// (noKnown, read once) switches the Known reproductions on and the shapes off, for a run that
+// looks past the known bugs. hegel_shapes_test.go has one narrow property per bug over its
+// shape region; hegel_pins_test.go the regression examples.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"crypto/ecdsa"
+	"crypto/ed25519"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"net/http"
+	"net/url"
+	"os"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	jwt "github.com/golang-jwt/jwt/v5"
+	"github.com/golang-jwt/jwt/v5/request"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the model on a case whose known shapes are named (none
+// for a plain failure): a recorded bug's shape is counted and fails naming the bug, or under
+// HEGEL_NO_KNOWN=1 is assumed away.
+func (c *collector) mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if len(shapes) > 0 {
+		for _, s := range shapes {
+			c.count("shape " + s)
+		}
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.fail(ht, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// every switch below is off: the model says what RFC 7519 and the package's documentation say,
+// the generators draw the shape of every recorded bug as an explicit alternative, and a property
+// that meets one fails naming the bug (it is the expected failure mapped to the bug, beside the
+// pin). Under HEGEL_NO_KNOWN=1 every switch is on: the model reproduces the package where the
+// bug is a reading of the input, the generators do not draw the shapes that are a region of the
+// input, and a remaining disagreement on a known shape is counted and assumed away.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml), one switch each, all equal to noKnown.
+var Known = struct {
+	// golang-jwt/1: a numeric date parsed from JSON with a fraction is truncated, not rounded, to
+	// TimePrecision after the float64 conversion: 1700000000.123 reads as .122 at millisecond
+	// precision. On: the round trip tolerates one unit below at sub-second precision.
+	subsecondTruncates bool
+	// golang-jwt/2: a NumericDate before the epoch with a fraction marshals as a different instant
+	// (-0.5 as -1.500): the integer seconds and the positive nanosecond offset are concatenated.
+	// On: pre-epoch instants are not drawn.
+	preEpochFraction bool
+	// golang-jwt/3: a numeric date at or beyond 2^63 seconds wraps to the minimum int64, so
+	// nbf: 1e19 is accepted and exp: 1e19 is expired. On: huge dates are not drawn.
+	hugeDateWraps bool
+	// golang-jwt/4: RegisteredClaims accepts a JSON string holding a number as a NumericDate
+	// ("exp":"1800000000"), where MapClaims reports an invalid type. On: the model of
+	// RegisteredClaims' unmarshalling accepts it.
+	stringDateAccepted bool
+	// golang-jwt/5: MapClaims treats an explicit null exp/nbf/iat/iss/sub as an invalid type,
+	// where a null aud is "no value" and RegisteredClaims reads a null claim as absent. On: the
+	// validation model expects ErrInvalidType from MapClaims, and the agreement property does
+	// not draw nulls.
+	nullIsInvalid bool
+	// golang-jwt/6: a TimePrecision that is not a power of ten (500ms, 250ms) marshals the
+	// fraction with too few digits (none), so 10.5 is written 10 and reads back as another instant.
+	// On: those precisions are not drawn.
+	oddPrecisionDrops bool
+	// golang-jwt/7: newlines inside a token segment are ignored (encoding/base64 skips \r and \n),
+	// with WithStrictDecoding too, so a token with line breaks in it parses and verifies. On: the
+	// decoding model strips line breaks before judging.
+	newlinesIgnored bool
+}{noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of 0 is an alternative switched off); it shrinks towards the first choice, so
+// the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// unless is the weight w, or 0 when the switch is on: the spelling of an alternative that is the
+// shape of a recorded bug, drawn by default and not under HEGEL_NO_KNOWN=1.
+func unless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what it
+// shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table of values (the first is the shrink target).
+func pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// counted is a list of as many elements as counts says (Lists alone almost never draws the
+// empty list).
+func counted[T any](counts hegel.Generator[int], g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.FlatMap(counts, func(k int) hegel.Generator[[]T] { return hegel.Lists(g).MinSize(k).MaxSize(k) })
+}
+
+// shaped is the generator of a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, of the
+// neighbouring region past it.
+func shaped[T any](known, past hegel.Generator[T]) hegel.Generator[T] {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- JSON helpers
+
+// canon re-encodes JSON with sorted keys and numbers as exact rationals, so both sides compare
+// as text whatever their number formatting.
+func canon(raw []byte) string {
+	dec := json.NewDecoder(strings.NewReader(string(raw)))
+	dec.UseNumber()
+	var v any
+	if err := dec.Decode(&v); err != nil {
+		return "INVALID JSON: " + string(raw)
+	}
+	return string(mustJSON(normNumbers(v)))
+}
+
+func normNumbers(v any) any {
+	switch x := v.(type) {
+	case json.Number:
+		r, ok := new(big.Rat).SetString(string(x))
+		if !ok {
+			return "num:" + string(x)
+		}
+		return "num:" + r.RatString()
+	case map[string]any:
+		out := make(map[string]any, len(x))
+		for k, e := range x {
+			out[k] = normNumbers(e)
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, e := range x {
+			out[i] = normNumbers(e)
+		}
+		return out
+	}
+	return v
+}
+
+func canonOf(v any) string { return canon(mustJSON(v)) }
+
+// canonFloat is canon of the text as MapClaims reads it: every number through a float64 (a
+// 2^63 literal comes out as 9.223372036854776e+18).
+func canonFloat(raw string) string {
+	var v any
+	if err := json.Unmarshal([]byte(raw), &v); err != nil {
+		return "INVALID JSON: " + raw
+	}
+	return canonOf(v)
+}
+
+// --------------------------------------------------------------------------- claims
+
+const fixedNow int64 = 1_800_000_000
+
+// farFuture is the model's reading of a date beyond int64: an instant after any clock.
+const farFuture int64 = 1 << 62
+
+var stringPool = []string{"a", "b", "c", "", "https://issuer.example/", "é", "x y"}
+
+var poolString = hegel.SampledFrom(stringPool)
+
+// dateClaim is one numeric-date claim (exp, nbf, iat): its kind and the data its JSON text is
+// made of.
+type dateClaim struct {
+	kind string // absent int frac string badstring bool null array huge
+	secs int64  // int, frac, string
+	frac string // frac: 1-3 digits
+	text string // bool, huge, badstring: the literal
+}
+
+// json is the claim's JSON text ("" when absent).
+func (d dateClaim) json() string {
+	switch d.kind {
+	case "int":
+		return strconv.FormatInt(d.secs, 10)
+	case "frac":
+		return fmt.Sprintf("%d.%s", d.secs, d.frac)
+	case "string":
+		return fmt.Sprintf(`"%d"`, d.secs)
+	case "bool", "huge", "badstring":
+		return d.text
+	case "null":
+		return "null"
+	case "array":
+		return fmt.Sprintf("[%d]", fixedNow)
+	}
+	return ""
+}
+
+// floorSecs is the whole second golang-jwt keeps at the default TimePrecision (fractions are
+// generated non-negative only, so floor is truncation).
+func (d dateClaim) floorSecs() int64 { return d.secs }
+
+// fitsFloat64 reports whether a numeric claim is within float64 (1e400 is not, and
+// encoding/json refuses it into MapClaims while json.Number carries it).
+func (d dateClaim) fitsFloat64() bool {
+	if d.kind != "huge" {
+		return true
+	}
+	_, err := strconv.ParseFloat(d.text, 64)
+	return err == nil
+}
+
+var (
+	nearNow    = hegel.Map(hegel.Integers(-300, 300), func(d int) int64 { return fixedNow + int64(d) })
+	smallSecs  = hegel.Map(hegel.Integers(-1000, 1000), func(d int) int64 { return int64(d) })
+	dateSecs   = weighted(choice[int64]{9, nearNow}, choice[int64]{1, smallSecs})
+	fracDigits = hegel.Text().Alphabet("0123456789").MinSize(1).MaxSize(3)
+	// hugeDates: at or beyond 2^63 seconds, and beyond float64 (golang-jwt/3's region).
+	hugeDates = []string{"1e19", "9223372036854775808", "1e300", "1e400"}
+
+	dateAbsent = hegel.Just(dateClaim{kind: "absent"})
+	dateInt    = hegel.Map(dateSecs, func(s int64) dateClaim { return dateClaim{kind: "int", secs: s} })
+	dateFrac   = hegel.Composite(func(tc hegel.TestCase) dateClaim {
+		return dateClaim{kind: "frac", secs: hegel.Draw(tc, nearNow), frac: hegel.Draw(tc, fracDigits)}
+	})
+	dateNull      = hegel.Just(dateClaim{kind: "null"})
+	dateString    = hegel.Map(hegel.Integers(-100, 100), func(d int) dateClaim { return dateClaim{kind: "string", secs: fixedNow + int64(d)} })
+	dateHuge      = hegel.Map(hegel.SampledFrom(hugeDates), func(h string) dateClaim { return dateClaim{kind: "huge", text: h} })
+	dateBool      = hegel.Map(pick("true", "false"), func(b string) dateClaim { return dateClaim{kind: "bool", text: b} })
+	dateBadString = hegel.Just(dateClaim{kind: "badstring", text: `"soon"`})
+	dateArray     = hegel.Just(dateClaim{kind: "array"})
+
+	// dates: a date claim of any kind; by default the null (golang-jwt/5) first and often,
+	// since the engine's bounded integer draw favours low values unevenly from run to run and
+	// the validation property mapped to it must reach it every run (it stops at its first
+	// hit, so the rate costs nothing); then the plain integer, and the quoted number
+	// (golang-jwt/4), the null and the huge date (golang-jwt/3, not drawn under
+	// HEGEL_NO_KNOWN=1) as steady alternatives.
+	dates = weighted(
+		choice[dateClaim]{unless(noKnown, 20), dateNull},
+		choice[dateClaim]{40, dateInt},
+		choice[dateClaim]{35, dateAbsent},
+		choice[dateClaim]{16, dateFrac},
+		choice[dateClaim]{3, dateNull},
+		choice[dateClaim]{2, dateString},
+		choice[dateClaim]{unless(Known.hugeDateWraps, 2), dateHuge},
+		choice[dateClaim]{1, dateBool},
+		choice[dateClaim]{1, dateBadString},
+		choice[dateClaim]{1, dateArray},
+	)
+	// typedDates: the kinds RegisteredClaims holds (for the agreement property); the null
+	// (golang-jwt/5) first for the reason dates gives, not drawn under HEGEL_NO_KNOWN=1, nor
+	// the huge date.
+	typedDates = weighted(
+		choice[dateClaim]{unless(Known.nullIsInvalid, 20), dateNull},
+		choice[dateClaim]{40, dateInt},
+		choice[dateClaim]{35, dateAbsent},
+		choice[dateClaim]{16, dateFrac},
+		choice[dateClaim]{unless(Known.hugeDateWraps, 2), dateHuge},
+	)
+)
+
+// strClaim is a string-valued claim (iss, sub, jti).
+type strClaim struct {
+	kind string // absent string number null array
+	val  string
+}
+
+func (s strClaim) json() string {
+	switch s.kind {
+	case "string":
+		return string(mustJSON(s.val))
+	case "number":
+		return "5"
+	case "null":
+		return "null"
+	case "array":
+		return `["a"]`
+	}
+	return ""
+}
+
+var (
+	strAbsent = hegel.Just(strClaim{kind: "absent"})
+	strString = hegel.Map(poolString, func(v string) strClaim { return strClaim{kind: "string", val: v} })
+	strNull   = hegel.Just(strClaim{kind: "null"})
+	strNumber = hegel.Just(strClaim{kind: "number"})
+	strArray  = hegel.Just(strClaim{kind: "array"})
+
+	strs = weighted(
+		choice[strClaim]{51, strString},
+		choice[strClaim]{40, strAbsent},
+		choice[strClaim]{3, strNull},
+		choice[strClaim]{3, strNumber},
+		choice[strClaim]{3, strArray},
+	)
+	typedStrs = weighted(
+		choice[strClaim]{51, strString},
+		choice[strClaim]{40, strAbsent},
+		choice[strClaim]{unless(Known.nullIsInvalid, 3), strNull},
+	)
+)
+
+// audClaim is the aud claim.
+type audClaim struct {
+	kind string // absent string array number mixed null object
+	vals []string
+}
+
+func (a audClaim) json() string {
+	switch a.kind {
+	case "string":
+		return string(mustJSON(a.vals[0]))
+	case "array":
+		if len(a.vals) == 0 {
+			return "[]"
+		}
+		return string(mustJSON(a.vals))
+	case "number":
+		return "7"
+	case "mixed":
+		return `["a", 1]`
+	case "null":
+		return "null"
+	case "object":
+		return `{"a": 1}`
+	}
+	return ""
+}
+
+var (
+	audAbsent = hegel.Just(audClaim{kind: "absent"})
+	audString = hegel.Map(poolString, func(v string) audClaim { return audClaim{kind: "string", vals: []string{v}} })
+	audArray  = hegel.Map(counted(hegel.Integers(0, 3), poolString), func(vs []string) audClaim { return audClaim{kind: "array", vals: vs} })
+	audNull   = hegel.Just(audClaim{kind: "null"})
+	audNumber = hegel.Just(audClaim{kind: "number"})
+	audMixed  = hegel.Just(audClaim{kind: "mixed"})
+	audObject = hegel.Just(audClaim{kind: "object"})
+
+	auds = weighted(
+		choice[audClaim]{26, audString},
+		choice[audClaim]{35, audAbsent},
+		choice[audClaim]{26, audArray},
+		choice[audClaim]{3, audNull},
+		choice[audClaim]{3, audNumber},
+		choice[audClaim]{3, audMixed},
+		choice[audClaim]{3, audObject},
+	)
+	typedAuds = weighted(
+		choice[audClaim]{26, audString},
+		choice[audClaim]{35, audAbsent},
+		choice[audClaim]{26, audArray},
+		choice[audClaim]{3, audNull},
+	)
+)
+
+// Private claims: a key and a JSON value that survives a float64 round trip (integers within
+// 2^53, decimals with few digits), nested two levels at most.
+type member struct {
+	key string
+	val string
+}
+
+var (
+	privateKey    = hegel.Text().Alphabet("abcxyz_ é").MinSize(1).MaxSize(5)
+	objectKey     = hegel.Text().Alphabet("abc_é").MinSize(1).MaxSize(4)
+	privateNumber = hegel.Map(hegel.Integers(-9007199254740992, 9007199254740992), strconv.Itoa)
+	privateDec    = hegel.Composite(func(tc hegel.TestCase) string {
+		return fmt.Sprintf("%d.%s", hegel.Draw(tc, hegel.Integers(-100000, 100000)), hegel.Draw(tc, hegel.Text().Alphabet("0123456789").MinSize(1).MaxSize(6)))
+	})
+	privateText   = hegel.Map(hegel.Text().Alphabet("ab \"\\/é\U0001F600<>&\n\t").MaxSize(6), func(s string) string { return string(mustJSON(s)) })
+	privateScalar = weighted(
+		choice[string]{1, hegel.Just("null")},
+		choice[string]{1, pick("true", "false")},
+		choice[string]{1, privateNumber},
+		choice[string]{1, privateDec},
+		choice[string]{2, privateText},
+		choice[string]{1, pick("[]", "{}")},
+	)
+	privateInner  = containers(privateScalar)
+	privateValues = containers(privateInner)
+	privates      = hegel.Lists(hegel.Composite(func(tc hegel.TestCase) member {
+		return member{key: hegel.Draw(tc, privateKey), val: hegel.Draw(tc, privateValues)}
+	})).MaxSize(3)
+)
+
+// containers is a value of inner, or an array or object of up to three of them.
+func containers(inner hegel.Generator[string]) hegel.Generator[string] {
+	array := hegel.Map(hegel.Lists(inner).MaxSize(3), func(xs []string) string { return "[" + strings.Join(xs, ",") + "]" })
+	object := hegel.Map(hegel.Lists(hegel.Composite(func(tc hegel.TestCase) member {
+		return member{key: hegel.Draw(tc, objectKey), val: hegel.Draw(tc, inner)}
+	})).MaxSize(3), renderObject)
+	return weighted(choice[string]{6, inner}, choice[string]{1, array}, choice[string]{1, object})
+}
+
+// renderObject is the JSON object of the members in order, a repeated key dropped.
+func renderObject(ms []member) string {
+	var b strings.Builder
+	b.WriteByte('{')
+	seen := map[string]bool{}
+	for _, m := range ms {
+		if seen[m.key] {
+			continue
+		}
+		seen[m.key] = true
+		if b.Len() > 1 {
+			b.WriteByte(',')
+		}
+		b.Write(mustJSON(m.key))
+		b.WriteByte(':')
+		b.WriteString(m.val)
+	}
+	b.WriteByte('}')
+	return b.String()
+}
+
+// claimsDoc is a claims set: the registered claims with their model, the private claims, and
+// an order tape that permutes the members when the document is rendered.
+type claimsDoc struct {
+	exp, nbf, iat dateClaim
+	iss, sub, jti strClaim
+	aud           audClaim
+	private       []member
+	order         []int
+}
+
+var orderTape = hegel.Lists(hegel.Integers(0, 11)).MaxSize(10)
+
+// claimsOf is a claims document whose registered claims come from the given generators.
+func claimsOf(date hegel.Generator[dateClaim], str hegel.Generator[strClaim], aud hegel.Generator[audClaim]) hegel.Generator[claimsDoc] {
+	return hegel.Composite(func(tc hegel.TestCase) claimsDoc {
+		return claimsDoc{
+			exp: hegel.Draw(tc, date), nbf: hegel.Draw(tc, date), iat: hegel.Draw(tc, date),
+			iss: hegel.Draw(tc, str), sub: hegel.Draw(tc, str), jti: hegel.Draw(tc, str),
+			aud:     hegel.Draw(tc, aud),
+			private: hegel.Draw(tc, privates),
+			order:   hegel.Draw(tc, orderTape),
+		}
+	})
+}
+
+var (
+	// claimsDocs: any document, ill-typed members included.
+	claimsDocs = claimsOf(dates, strs, auds)
+	// typedClaimsDocs: a document RegisteredClaims holds.
+	typedClaimsDocs = claimsOf(typedDates, typedStrs, typedAuds)
+)
+
+// render is the JSON text: the present members in the order the tape gives (the i-th member
+// taken from those left, modulo their number; an empty tape keeps the declaration order), a
+// private key repeated or clashing with a registered one dropped.
+func (c claimsDoc) render() []byte {
+	var ms []member
+	for _, m := range []member{{"exp", c.exp.json()}, {"nbf", c.nbf.json()}, {"iat", c.iat.json()}, {"iss", c.iss.json()}, {"sub", c.sub.json()}, {"jti", c.jti.json()}, {"aud", c.aud.json()}} {
+		if m.val != "" {
+			ms = append(ms, m)
+		}
+	}
+	seen := map[string]bool{"exp": true, "nbf": true, "iat": true, "iss": true, "sub": true, "jti": true, "aud": true}
+	for _, m := range c.private {
+		if seen[m.key] {
+			continue
+		}
+		seen[m.key] = true
+		ms = append(ms, m)
+	}
+	var ordered []member
+	for i := 0; len(ms) > 0; i++ {
+		j := 0
+		if len(c.order) > 0 {
+			j = c.order[i%len(c.order)] % len(ms)
+		}
+		ordered = append(ordered, ms[j])
+		ms = slices.Delete(ms, j, j+1)
+	}
+	return []byte(renderObject(ordered))
+}
+
+func (c claimsDoc) GoString() string { return string(c.render()) }
+
+// namedDate is a date claim with its name, in the fixed order exp, nbf, iat.
+type namedDate struct {
+	name string
+	date dateClaim
+}
+
+func (c claimsDoc) dates() []namedDate {
+	return []namedDate{{"exp", c.exp}, {"nbf", c.nbf}, {"iat", c.iat}}
+}
+
+func (c claimsDoc) hasDateKind(kinds ...string) bool {
+	for _, d := range c.dates() {
+		if slices.Contains(kinds, d.date.kind) {
+			return true
+		}
+	}
+	return false
+}
+
+// fitsFloat64 reports whether every number of the document is within float64, so that
+// encoding/json reads it into MapClaims.
+func (c claimsDoc) fitsFloat64() bool {
+	for _, d := range c.dates() {
+		if !d.date.fitsFloat64() {
+			return false
+		}
+	}
+	return true
+}
+
+// registeredUnmarshals models whether json.Unmarshal into RegisteredClaims succeeds: dates must
+// be numbers within float64 or null (a numeric string too under Known.stringDateAccepted),
+// strings must be strings or null, aud a string, an array of strings or null.
+func (c claimsDoc) registeredUnmarshals() bool {
+	for _, d := range c.dates() {
+		switch d.date.kind {
+		case "absent", "int", "frac", "null":
+		case "huge":
+			if !d.date.fitsFloat64() {
+				return false // "could not convert json number value to float"
+			}
+		case "string":
+			if !Known.stringDateAccepted {
+				return false
+			}
+		default:
+			return false
+		}
+	}
+	for _, s := range []strClaim{c.iss, c.sub, c.jti} {
+		if s.kind == "number" || s.kind == "array" {
+			return false
+		}
+	}
+	switch c.aud.kind {
+	case "number", "mixed", "object":
+		return false
+	}
+	return true
+}
+
+// shapes names the recorded bugs whose shape the document has: a huge date (golang-jwt/3), a
+// quoted numeric date (golang-jwt/4), a null exp, nbf, iat, iss or sub (golang-jwt/5).
+func (c claimsDoc) shapes() []string {
+	var s []string
+	if c.hasDateKind("huge") {
+		s = append(s, "golang-jwt/3")
+	}
+	if c.hasDateKind("string") {
+		s = append(s, "golang-jwt/4")
+	}
+	if c.hasDateKind("null") || c.iss.kind == "null" || c.sub.kind == "null" {
+		s = append(s, "golang-jwt/5")
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- validation model
+
+type valOpts struct {
+	leeway                           int64
+	requireExp, requireNbf, checkIat bool
+	aud                              []string
+	allAud                           bool
+	iss, sub                         string
+}
+
+var valOptions = hegel.Composite(func(tc hegel.TestCase) valOpts {
+	return valOpts{
+		leeway:     hegel.Draw(tc, maybe(50, hegel.Map(hegel.Integers(1, 30), func(l int) int64 { return int64(l) }))),
+		requireExp: hegel.Draw(tc, chance(30)),
+		requireNbf: hegel.Draw(tc, chance(30)),
+		checkIat:   hegel.Draw(tc, chance(40)),
+		aud:        hegel.Draw(tc, maybe(45, counted(hegel.Integers(1, 3), poolString))),
+		allAud:     hegel.Draw(tc, chance(40)),
+		iss:        hegel.Draw(tc, maybe(40, poolString)),
+		sub:        hegel.Draw(tc, maybe(40, poolString)),
+	}
+})
+
+func (o valOpts) options(now time.Time) []jwt.ParserOption {
+	opts := []jwt.ParserOption{jwt.WithTimeFunc(func() time.Time { return now })}
+	if o.leeway != 0 {
+		opts = append(opts, jwt.WithLeeway(time.Duration(o.leeway)*time.Second))
+	}
+	if o.requireExp {
+		opts = append(opts, jwt.WithExpirationRequired())
+	}
+	if o.requireNbf {
+		opts = append(opts, jwt.WithNotBeforeRequired())
+	}
+	if o.checkIat {
+		opts = append(opts, jwt.WithIssuedAt())
+	}
+	if len(o.aud) > 0 {
+		if o.allAud {
+			opts = append(opts, jwt.WithAllAudiences(o.aud...))
+		} else {
+			opts = append(opts, jwt.WithAudience(o.aud...))
+		}
+	}
+	if o.iss != "" {
+		opts = append(opts, jwt.WithIssuer(o.iss))
+	}
+	if o.sub != "" {
+		opts = append(opts, jwt.WithSubject(o.sub))
+	}
+	return opts
+}
+
+func (o valOpts) String() string {
+	return fmt.Sprintf("leeway=%d reqExp=%v reqNbf=%v iat=%v aud=%q all=%v iss=%q sub=%q", o.leeway, o.requireExp, o.requireNbf, o.checkIat, o.aud, o.allAud, o.iss, o.sub)
+}
+
+// sentinels is every validation error the model can predict.
+var sentinels = []error{jwt.ErrTokenExpired, jwt.ErrTokenNotValidYet, jwt.ErrTokenUsedBeforeIssued, jwt.ErrTokenRequiredClaimMissing, jwt.ErrTokenInvalidAudience, jwt.ErrTokenInvalidIssuer, jwt.ErrTokenInvalidSubject, jwt.ErrInvalidType}
+
+// modelValidate lists the errors Validate must report for claims c under opts at now (integer
+// seconds). forMap selects the MapClaims reading of ill-typed values (RegisteredClaims cannot
+// hold them: the caller only asks when registeredUnmarshals). The result is a set of sentinels.
+// A null claim is absent (ErrInvalidType from MapClaims under Known.nullIsInvalid); a huge
+// date is an instant beyond any clock; a quoted number is an invalid type for MapClaims and,
+// under Known.stringDateAccepted, the number for RegisteredClaims.
+func modelValidate(c claimsDoc, o valOpts, now int64, forMap bool) []error {
+	var errs []error
+	add := func(e error) { errs = append(errs, e) }
+	// a date: (value, present, typeError)
+	date := func(d dateClaim) (int64, bool, bool) {
+		switch d.kind {
+		case "absent":
+			return 0, false, false
+		case "null":
+			if forMap && Known.nullIsInvalid {
+				return 0, false, true
+			}
+			return 0, false, false
+		case "int", "frac":
+			return d.floorSecs(), true, false
+		case "huge":
+			return farFuture, true, false
+		case "string":
+			if forMap {
+				return 0, false, true
+			}
+			return d.secs, true, false
+		}
+		return 0, false, true // bool, array, badstring: never reaches RegisteredClaims
+	}
+	if v, ok, bad := date(c.exp); bad {
+		add(jwt.ErrInvalidType)
+	} else if !ok {
+		if o.requireExp {
+			add(jwt.ErrTokenRequiredClaimMissing)
+		}
+	} else if !(now < v+o.leeway) {
+		add(jwt.ErrTokenExpired)
+	}
+	if v, ok, bad := date(c.nbf); bad {
+		add(jwt.ErrInvalidType)
+	} else if !ok {
+		if o.requireNbf {
+			add(jwt.ErrTokenRequiredClaimMissing)
+		}
+	} else if now < v-o.leeway {
+		add(jwt.ErrTokenNotValidYet)
+	}
+	if o.checkIat {
+		if v, ok, bad := date(c.iat); bad {
+			add(jwt.ErrInvalidType)
+		} else if ok && now < v-o.leeway {
+			add(jwt.ErrTokenUsedBeforeIssued)
+		}
+	}
+	if len(o.aud) > 0 {
+		switch c.aud.kind {
+		case "number", "mixed", "object":
+			add(jwt.ErrInvalidType)
+		default:
+			vals := c.aud.vals
+			if len(vals) == 0 || len(vals) == 1 && vals[0] == "" {
+				add(jwt.ErrTokenRequiredClaimMissing)
+			} else if o.allAud {
+				for _, want := range o.aud {
+					if !slices.Contains(vals, want) {
+						add(jwt.ErrTokenInvalidAudience)
+						break
+					}
+				}
+			} else {
+				found := false
+				for _, have := range vals {
+					if slices.Contains(o.aud, have) {
+						found = true
+						break
+					}
+				}
+				if !found {
+					add(jwt.ErrTokenInvalidAudience)
+				}
+			}
+		}
+	}
+	str := func(s strClaim, want string, invalid error) {
+		switch s.kind {
+		case "number", "array":
+			add(jwt.ErrInvalidType)
+		case "null":
+			if forMap && Known.nullIsInvalid {
+				add(jwt.ErrInvalidType)
+			} else {
+				add(jwt.ErrTokenRequiredClaimMissing)
+			}
+		case "absent":
+			add(jwt.ErrTokenRequiredClaimMissing)
+		default:
+			if s.val == "" {
+				add(jwt.ErrTokenRequiredClaimMissing)
+			} else if s.val != want {
+				add(invalid)
+			}
+		}
+	}
+	if o.iss != "" {
+		str(c.iss, o.iss, jwt.ErrTokenInvalidIssuer)
+	}
+	if o.sub != "" {
+		str(c.sub, o.sub, jwt.ErrTokenInvalidSubject)
+	}
+	return errs
+}
+
+func hasErr(errs []error, e error) bool {
+	for _, x := range errs {
+		if x == e {
+			return true
+		}
+	}
+	return false
+}
+
+// checkErrors compares Validate's error against the modelled set of sentinels.
+func checkErrors(got error, want []error) string {
+	if (got == nil) != (len(want) == 0) {
+		return fmt.Sprintf("got %v, want %v", got, want)
+	}
+	for _, s := range sentinels {
+		if errors.Is(got, s) != hasErr(want, s) {
+			return fmt.Sprintf("got %v, want exactly %v (differs on %v)", got, want, s)
+		}
+	}
+	return ""
+}
+
+// nowOf is the clock for the document under the options: around the fixed instant, and two
+// times in five at a boundary of one of its dates (now == exp + leeway and the like).
+func nowOf(c claimsDoc, o valOpts) hegel.Generator[int64] {
+	around := hegel.Map(hegel.Integers(-400, 400), func(d int) int64 { return fixedNow + int64(d) })
+	var candidates []int64
+	for _, d := range c.dates() {
+		if d.date.kind == "int" || d.date.kind == "frac" {
+			s := d.date.floorSecs()
+			candidates = append(candidates, s+o.leeway, s-o.leeway, s+o.leeway-1, s-o.leeway+1)
+		}
+	}
+	if len(candidates) == 0 {
+		return around
+	}
+	return weighted(choice[int64]{60, around}, choice[int64]{40, hegel.SampledFrom(candidates)})
+}
+
+// valCase is one validation case: the document, the options, the clock, and whether the token
+// also goes through Parse.
+type valCase struct {
+	claims    claimsDoc
+	opts      valOpts
+	now       int64
+	viaParser bool
+}
+
+// valCasesOf is a validation case over the given documents.
+func valCasesOf(docs hegel.Generator[claimsDoc]) hegel.Generator[valCase] {
+	return hegel.Composite(func(tc hegel.TestCase) valCase {
+		c := hegel.Draw(tc, docs)
+		o := hegel.Draw(tc, valOptions)
+		return valCase{claims: c, opts: o, now: hegel.Draw(tc, nowOf(c, o)), viaParser: hegel.Draw(tc, chance(30))}
+	})
+}
+
+var valCases = valCasesOf(claimsDocs)
+
+func (v valCase) GoString() string {
+	return fmt.Sprintf("%s at now=%d %s parser=%v", v.claims.render(), v.now, v.opts, v.viaParser)
+}
+
+// registeredDates checks the dates RegisteredClaims read from the document: an integer or
+// fraction date is its whole seconds, an absent or null one nil, a huge one an instant beyond
+// any clock (golang-jwt/3 wraps it to the minimum int64); "" when they are.
+func registeredDates(rc jwt.RegisteredClaims, c claimsDoc) string {
+	for _, nd := range c.dates() {
+		var got *jwt.NumericDate
+		switch nd.name {
+		case "exp":
+			got = rc.ExpiresAt
+		case "nbf":
+			got = rc.NotBefore
+		case "iat":
+			got = rc.IssuedAt
+		}
+		d := nd.date
+		switch d.kind {
+		case "int", "frac", "string":
+			if got == nil || got.Unix() != d.floorSecs() {
+				return fmt.Sprintf("RegisteredClaims %s = %s from %s", nd.name, showClaim(got), d.json())
+			}
+		case "huge":
+			if got == nil || got.Unix() < fixedNow {
+				return fmt.Sprintf("RegisteredClaims %s = %s from %s, want an instant beyond any clock", nd.name, showClaim(got), d.json())
+			}
+		default:
+			if got != nil {
+				return fmt.Sprintf("RegisteredClaims %s = %s from absent/null", nd.name, showClaim(got))
+			}
+		}
+	}
+	return ""
+}
+
+// checkValidation judges one validation case: the Validator (and the Parser around it) reports
+// exactly the modelled errors for MapClaims read with and without UseNumber, and for
+// RegisteredClaims, which accepts exactly the well-typed documents; joserfc agrees on
+// exp/nbf/iat where it has an opinion.
+func checkValidation(ht *hegel.T, col *collector, key keyPair, vc valCase) {
+	c, o, now := vc.claims, vc.opts, vc.now
+	raw := c.render()
+	shapes := c.shapes()
+	clock := time.Unix(now, 0)
+	validator := jwt.NewValidator(o.options(clock)...)
+	want := modelValidate(c, o, now, true)
+
+	// MapClaims, plain Unmarshal (float64 numbers): a number beyond float64 is refused by
+	// encoding/json itself
+	var m jwt.MapClaims
+	err := json.Unmarshal(raw, &m)
+	if !c.fitsFloat64() {
+		if err == nil {
+			col.fail(ht, "claims %s unmarshal into MapClaims, want encoding/json's range error", raw)
+			return
+		}
+		col.count("map-beyond-float64")
+	} else {
+		if err != nil {
+			col.fail(ht, "claims %s do not unmarshal into MapClaims: %v", raw, err)
+			return
+		}
+		if msg := checkErrors(validator.Validate(m), want); msg != "" {
+			col.mismatch(ht, shapes, "MapClaims %s at now=%d %s: %s", raw, now, o, msg)
+			return
+		}
+		col.count("map")
+	}
+	// MapClaims with UseNumber
+	dec := json.NewDecoder(strings.NewReader(string(raw)))
+	dec.UseNumber()
+	var mn jwt.MapClaims
+	if err := dec.Decode(&mn); err != nil {
+		col.fail(ht, "claims %s do not decode into MapClaims with UseNumber: %v", raw, err)
+		return
+	}
+	if msg := checkErrors(validator.Validate(mn), want); msg != "" {
+		col.mismatch(ht, shapes, "MapClaims(UseNumber) %s at now=%d %s: %s", raw, now, o, msg)
+		return
+	}
+	if len(want) == 0 {
+		col.count("map-valid")
+	}
+	// through the parser
+	if vc.viaParser && c.fitsFloat64() {
+		tok := jwt.NewWithClaims(jwt.SigningMethodHS256, m)
+		str, err := tok.SignedString(key.private)
+		if err != nil {
+			col.fail(ht, "signing %s: %v", raw, err)
+			return
+		}
+		parsed, err := jwt.Parse(str, func(*jwt.Token) (any, error) { return key.public, nil }, o.options(clock)...)
+		if len(want) == 0 {
+			if err != nil || parsed == nil || !parsed.Valid {
+				col.mismatch(ht, shapes, "Parse of a token with claims %s at now=%d %s: err=%v, want valid", raw, now, o, err)
+				return
+			}
+		} else {
+			if err == nil || !errors.Is(err, jwt.ErrTokenInvalidClaims) || parsed == nil || parsed.Valid {
+				col.mismatch(ht, shapes, "Parse of a token with claims %s at now=%d %s: err=%v, want ErrTokenInvalidClaims with %v", raw, now, o, err, want)
+				return
+			}
+			if msg := checkErrors(err, want); msg != "" {
+				col.mismatch(ht, shapes, "Parse of a token with claims %s at now=%d %s: %s", raw, now, o, msg)
+				return
+			}
+		}
+		col.count("parsed")
+	}
+
+	// RegisteredClaims
+	var r jwt.RegisteredClaims
+	err = json.Unmarshal(raw, &r)
+	if c.registeredUnmarshals() {
+		if err != nil {
+			col.mismatch(ht, shapes, "claims %s do not unmarshal into RegisteredClaims: %v", raw, err)
+			return
+		}
+		want := modelValidate(c, o, now, false)
+		if msg := checkErrors(validator.Validate(r), want); msg != "" {
+			col.mismatch(ht, shapes, "RegisteredClaims %s at now=%d %s: %s", raw, now, o, msg)
+			return
+		}
+		col.count("registered")
+	} else {
+		if err == nil {
+			col.mismatch(ht, shapes, "claims %s unmarshal into RegisteredClaims %+v, want an error", raw, r)
+			return
+		}
+		col.count("registered-rejected")
+	}
+
+	// joserfc as a second opinion on exp/nbf/iat: integer dates only, no expectations it does
+	// not have, and not at the exp boundary where the two conventions differ by design.
+	if o.requireExp || o.requireNbf || len(o.aud) > 0 || o.iss != "" || o.sub != "" {
+		return
+	}
+	for _, d := range c.dates() {
+		if d.date.kind != "absent" && d.date.kind != "int" {
+			return
+		}
+	}
+	if c.iat.kind == "int" && !o.checkIat {
+		return
+	}
+	for _, s := range []strClaim{c.iss, c.sub, c.jti} {
+		if s.kind != "absent" && s.kind != "string" {
+			return // joserfc polices the type of every registered claim
+		}
+	}
+	switch c.aud.kind {
+	case "number", "mixed", "object", "null":
+		return
+	}
+	if c.exp.kind == "int" && now == c.exp.secs+o.leeway {
+		col.count("joserfc-boundary")
+		return
+	}
+	rep := oracleValidate(raw, now, o.leeway)
+	if !rep.Ok {
+		col.fail(ht, "joserfc could not validate %s: %s %s", raw, rep.Error, rep.Message)
+		return
+	}
+	want = modelValidate(c, o, now, false)
+	if rep.Valid != (len(want) == 0) {
+		col.fail(ht, "joserfc says valid=%v for %s at now=%d leeway=%d, the model says %v", rep.Valid, raw, now, o.leeway, want)
+		return
+	}
+	col.count("joserfc")
+}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelValidationFollowsTheModel: the Validator (and the Parser around it) reports exactly
+// the modelled errors for MapClaims read with and without UseNumber, and for RegisteredClaims.
+// A huge date (golang-jwt/3), a quoted number (golang-jwt/4) and a null claim (golang-jwt/5)
+// are drawn by default and fail naming the bug.
+func TestHegelValidationFollowsTheModel(t *testing.T) {
+	col := newCollector(t)
+	key := keysFor("HS256")[0]
+	property(t, func(ht *hegel.T) {
+		checkValidation(ht, col, key, hegel.Draw(ht, valCases))
+	})
+}
+
+// goTokenCase is a token golang-jwt signs: the algorithm, which of its keys (modulo the pool),
+// the claims (as RegisteredClaims when asked and they fit), and the header's extras.
+type goTokenCase struct {
+	alg        string
+	keyAt      int
+	claims     claimsDoc
+	registered bool
+	kid, cty   bool
+	zoo        bool
+	zooN       int
+	zooS       string
+	typ        string // JWT (as written), "" (removed), at+jwt
+}
+
+var goTokenCases = hegel.Composite(func(tc hegel.TestCase) goTokenCase {
+	return goTokenCase{
+		alg:        hegel.Draw(tc, hegel.SampledFrom(allAlgs)),
+		keyAt:      hegel.Draw(tc, hegel.Integers(0, 3)),
+		claims:     hegel.Draw(tc, claimsDocs),
+		registered: hegel.Draw(tc, chance(35)),
+		kid:        hegel.Draw(tc, chance(30)),
+		cty:        hegel.Draw(tc, chance(20)),
+		zoo:        hegel.Draw(tc, chance(20)),
+		zooN:       hegel.Draw(tc, hegel.Integers(0, 9)),
+		zooS:       hegel.Draw(tc, poolString),
+		typ:        hegel.Draw(tc, weighted(choice[string]{8, hegel.Just("JWT")}, choice[string]{1, hegel.Just("")}, choice[string]{1, hegel.Just("at+jwt")})),
+	}
+})
+
+func (g goTokenCase) GoString() string {
+	return fmt.Sprintf("%s key#%d registered=%v claims %s kid=%v cty=%v zoo=%v typ=%q", g.alg, g.keyAt, g.registered, g.claims.render(), g.kid, g.cty, g.zoo, g.typ)
+}
+
+// TestHegelGoTokensReadInJoserfc: every token golang-jwt signs verifies in joserfc with the same
+// header and claims, and parses back in golang-jwt; the RegisteredClaims it signs hold the
+// document's dates (a huge one wraps, golang-jwt/3).
+func TestHegelGoTokensReadInJoserfc(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		g := hegel.Draw(ht, goTokenCases)
+		alg, c := g.alg, g.claims
+		pool := keysFor(alg)
+		key := pool[g.keyAt%len(pool)]
+		raw := c.render()
+		var claims jwt.Claims
+		useRegistered := g.registered && c.registeredUnmarshals() && !c.hasDateKind("string")
+		if useRegistered {
+			var r jwt.RegisteredClaims
+			if err := json.Unmarshal(raw, &r); err != nil {
+				col.fail(ht, "claims %s into RegisteredClaims: %v", raw, err)
+				return
+			}
+			if msg := registeredDates(r, c); msg != "" {
+				col.mismatch(ht, c.shapes(), "%s with %s: %s", alg, key.name, msg)
+				return
+			}
+			claims = r
+			col.count("registered")
+		} else {
+			m := jwt.MapClaims{}
+			if err := json.Unmarshal(raw, &m); err != nil {
+				if !c.fitsFloat64() {
+					col.count("map-beyond-float64")
+					ht.Assume(false)
+				}
+				col.fail(ht, "claims %s into MapClaims: %v", raw, err)
+				return
+			}
+			claims = m
+			col.count("map")
+		}
+		tok := jwt.NewWithClaims(methodOf(alg), claims)
+		if g.kid {
+			tok.Header["kid"] = key.name
+		}
+		if g.cty {
+			tok.Header["cty"] = "JWT"
+		}
+		if g.zoo {
+			tok.Header["zoo"] = map[string]any{"n": g.zooN, "s": g.zooS}
+		}
+		switch g.typ {
+		case "":
+			delete(tok.Header, "typ")
+		case "at+jwt":
+			tok.Header["typ"] = "at+jwt"
+		}
+		str, err := tok.SignedString(key.private)
+		if err != nil {
+			col.fail(ht, "%s with %s: SignedString: %v", alg, key.name, err)
+			return
+		}
+		wantHeader := canonOf(tok.Header)
+		wantClaims := canonOf(claims)
+
+		rep := oracleDecode(str, key.oracle, key.kty, alg)
+		if !rep.Ok {
+			col.fail(ht, "%s with %s: joserfc rejects %s: %s %s", alg, key.name, str, rep.Error, rep.Message)
+			return
+		}
+		if got := canon(rep.Header); got != wantHeader {
+			col.fail(ht, "%s with %s: joserfc header %s, golang-jwt wrote %s", alg, key.name, got, wantHeader)
+			return
+		}
+		if got := canon(rep.Claims); got != wantClaims {
+			col.fail(ht, "%s with %s: joserfc claims %s, golang-jwt wrote %s (claims %s)", alg, key.name, got, wantClaims, raw)
+			return
+		}
+		// the raw payload is exactly what SigningString encodes
+		ver := oracleVerify(str, key.oracle, key.kty, alg)
+		parts := strings.Split(str, ".")
+		payload, _ := base64.RawURLEncoding.DecodeString(parts[1])
+		if !ver.Ok || ver.Payload != fmt.Sprintf("%x", payload) {
+			col.fail(ht, "%s with %s: joserfc payload %q, want %x", alg, key.name, ver.Payload, payload)
+			return
+		}
+		// and golang-jwt reads its own token
+		back, err := jwt.Parse(str, func(*jwt.Token) (any, error) { return key.public, nil }, jwt.WithoutClaimsValidation(), jwt.WithValidMethods([]string{alg}))
+		if err != nil || !back.Valid {
+			col.fail(ht, "%s with %s: golang-jwt does not read its own token %s: %v", alg, key.name, str, err)
+			return
+		}
+		if got := canonOf(back.Claims); got != wantClaims {
+			col.fail(ht, "%s with %s: read back claims %s, wrote %s", alg, key.name, got, wantClaims)
+			return
+		}
+		if got := canonOf(back.Header); got != wantHeader {
+			col.fail(ht, "%s with %s: read back header %s, wrote %s", alg, key.name, got, wantHeader)
+			return
+		}
+		col.count(alg)
+	})
+}
+
+// b64Alphabet is the base64url alphabet.
+const b64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
+
+// tamperEdit is one change to a signed token, drawn as data and applied modulo the live
+// lengths: a character of a segment replaced by another of the alphabet, the signature segment
+// resized by four characters, or a text (a line break, golang-jwt/7's shape) inserted into a
+// segment.
+type tamperEdit struct {
+	kind string // replace resize insert
+	seg  int    // 0..2 (replace, insert)
+	at   int    // position modulo the segment's length (replace) or length+1 (insert)
+	repl int    // replace: an offset from the old character in the alphabet
+	grow bool   // resize: four characters added, else removed
+	text string // insert
+}
+
+var (
+	lineBreaks  = pick("\n", "\r", "\r\n")
+	tamperEdits = tampersWith(lineBreaks)
+)
+
+// inserts is an insertion of one of texts into a segment.
+func inserts(texts hegel.Generator[string]) hegel.Generator[tamperEdit] {
+	return hegel.Composite(func(tc hegel.TestCase) tamperEdit {
+		return tamperEdit{kind: "insert", seg: hegel.Draw(tc, hegel.Integers(0, 2)), at: hegel.Draw(tc, hegel.Integers(0, 399)), text: hegel.Draw(tc, texts)}
+	})
+}
+
+// tampersWith is a tamper edit: a replacement most of the time, a resize, or an insertion of
+// one of texts.
+func tampersWith(texts hegel.Generator[string]) hegel.Generator[tamperEdit] {
+	replace := hegel.Composite(func(tc hegel.TestCase) tamperEdit {
+		return tamperEdit{kind: "replace", seg: hegel.Draw(tc, hegel.Integers(0, 2)), at: hegel.Draw(tc, hegel.Integers(0, 399)), repl: hegel.Draw(tc, hegel.Integers(0, 62))}
+	})
+	resize := hegel.Map(chance(50), func(grow bool) tamperEdit { return tamperEdit{kind: "resize", seg: 2, grow: grow} })
+	return weighted(choice[tamperEdit]{7, replace}, choice[tamperEdit]{1, resize}, choice[tamperEdit]{2, inserts(texts)})
+}
+
+// apply is the token's segments after the edit.
+func (e tamperEdit) apply(parts []string) []string {
+	out := slices.Clone(parts)
+	switch e.kind {
+	case "replace":
+		seg := out[e.seg]
+		if len(seg) == 0 {
+			return out
+		}
+		at := e.at % len(seg)
+		if e.seg == 2 && at == len(seg)-1 && len(seg) > 1 {
+			at-- // the last character carries unused bits that a lax decoder ignores
+		}
+		old := strings.IndexByte(b64Alphabet, seg[at])
+		repl := b64Alphabet[(old+1+e.repl)%64]
+		out[e.seg] = seg[:at] + string(repl) + seg[at+1:]
+	case "resize":
+		// drop or add three bytes (four characters keep the segment decodable, though strict
+		// decoding may still refuse the new trailing bits)
+		if e.grow {
+			out[2] += "AAAA"
+		} else if len(out[2]) >= 4 {
+			out[2] = out[2][:len(out[2])-4]
+		}
+	case "insert":
+		seg := out[e.seg]
+		at := e.at % (len(seg) + 1)
+		out[e.seg] = seg[:at] + e.text + seg[at:]
+	}
+	return out
+}
+
+// verdict is what Parse must say of the tampered token: "valid", "signature"
+// (ErrTokenSignatureInvalid), "malformed", "signature-or-malformed" (a resized signature), or
+// "failure" (any of malformed, unverifiable, signature invalid). An inserted text that the
+// decoding model refuses makes the token malformed; one it skips (a line break under
+// Known.newlinesIgnored) leaves the signature verifying when it is in the signature segment
+// and invalid when it is in the signing text.
+func (e tamperEdit) verdict(tampered []string, padding, strict bool) string {
+	switch e.kind {
+	case "replace":
+		if e.seg == 2 {
+			return "signature"
+		}
+		return "failure"
+	case "resize":
+		return "signature-or-malformed"
+	}
+	if _, ok := modelDecode(tampered[e.seg], padding, strict); !ok {
+		return "malformed"
+	}
+	if e.seg == 2 {
+		return "valid"
+	}
+	return "signature"
+}
+
+// shapes names golang-jwt/7 when the edit inserts a line break.
+func (e tamperEdit) shapes() []string {
+	if e.kind == "insert" && strings.ContainsAny(e.text, "\r\n") {
+		return []string{"golang-jwt/7"}
+	}
+	return nil
+}
+
+func (e tamperEdit) GoString() string {
+	switch e.kind {
+	case "replace":
+		return fmt.Sprintf("replace in segment %d at %d by +%d", e.seg, e.at, e.repl)
+	case "resize":
+		return fmt.Sprintf("resize signature grow=%v", e.grow)
+	}
+	return fmt.Sprintf("insert %q in segment %d at %d", e.text, e.seg, e.at)
+}
+
+// checkTampered checks Parse's answer on the tampered token against the verdict.
+func checkTampered(ht *hegel.T, col *collector, shapes []string, verdict string, what string, bad string, tok *jwt.Token, err error) bool {
+	if verdict == "valid" {
+		if err != nil || tok == nil || !tok.Valid {
+			col.mismatch(ht, shapes, "%s: %s gives %v, want valid", what, bad, err)
+			return false
+		}
+		return true
+	}
+	if err == nil || (tok != nil && tok.Valid) {
+		col.mismatch(ht, shapes, "%s: tampered token %s verifies: %v", what, bad, err)
+		return false
+	}
+	switch verdict {
+	case "signature":
+		if !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+			col.mismatch(ht, shapes, "%s: %s gives %v, want ErrTokenSignatureInvalid", what, bad, err)
+			return false
+		}
+	case "malformed":
+		if !errors.Is(err, jwt.ErrTokenMalformed) {
+			col.mismatch(ht, shapes, "%s: %s gives %v, want ErrTokenMalformed", what, bad, err)
+			return false
+		}
+	case "signature-or-malformed":
+		if !errors.Is(err, jwt.ErrTokenSignatureInvalid) && !errors.Is(err, jwt.ErrTokenMalformed) {
+			col.mismatch(ht, shapes, "%s: %s gives %v, want ErrTokenSignatureInvalid or ErrTokenMalformed", what, bad, err)
+			return false
+		}
+	default:
+		if !errors.Is(err, jwt.ErrTokenSignatureInvalid) && !errors.Is(err, jwt.ErrTokenMalformed) && !errors.Is(err, jwt.ErrTokenUnverifiable) {
+			col.mismatch(ht, shapes, "%s: %s gives %v, want a malformed/unverifiable/signature error", what, bad, err)
+			return false
+		}
+	}
+	return true
+}
+
+// parseCase is a token joserfc signs for golang-jwt to parse: the algorithm and key, the
+// claims, the header's extras, the parser options, one tamper edit, and which other key and
+// algorithm to try.
+type parseCase struct {
+	alg          string
+	keyAt        int
+	claims       claimsDoc
+	kid          bool
+	typ          string // "" (absent), JWT, at+jwt
+	zoo          bool
+	validMethods bool
+	jsonNumber   bool
+	strict       bool
+	padding      bool
+	tamper       tamperEdit
+	otherKeyAt   int
+	otherAlg     string
+}
+
+var parseCases = hegel.Composite(func(tc hegel.TestCase) parseCase {
+	return parseCase{
+		alg:          hegel.Draw(tc, hegel.SampledFrom(allAlgs)),
+		keyAt:        hegel.Draw(tc, hegel.Integers(0, 3)),
+		claims:       hegel.Draw(tc, claimsDocs),
+		kid:          hegel.Draw(tc, chance(30)),
+		typ:          hegel.Draw(tc, maybe(50, pick("JWT", "at+jwt"))),
+		zoo:          hegel.Draw(tc, chance(20)),
+		validMethods: hegel.Draw(tc, chance(50)),
+		jsonNumber:   hegel.Draw(tc, chance(30)),
+		strict:       hegel.Draw(tc, chance(20)),
+		padding:      hegel.Draw(tc, chance(20)),
+		tamper:       hegel.Draw(tc, tamperEdits),
+		otherKeyAt:   hegel.Draw(tc, hegel.Integers(0, 3)),
+		otherAlg:     hegel.Draw(tc, hegel.SampledFrom(allAlgs)),
+	}
+})
+
+func (p parseCase) header(keyName string) map[string]any {
+	h := map[string]any{"alg": p.alg}
+	if p.kid {
+		h["kid"] = keyName
+	}
+	if p.typ != "" {
+		h["typ"] = p.typ
+	}
+	if p.zoo {
+		h["zoo"] = []any{1, "two"}
+	}
+	return h
+}
+
+func (p parseCase) options() []jwt.ParserOption {
+	opts := []jwt.ParserOption{jwt.WithoutClaimsValidation()}
+	if p.validMethods {
+		opts = append(opts, jwt.WithValidMethods([]string{p.alg}))
+	}
+	if p.jsonNumber {
+		opts = append(opts, jwt.WithJSONNumber())
+	}
+	if p.strict {
+		opts = append(opts, jwt.WithStrictDecoding())
+	}
+	if p.padding {
+		opts = append(opts, jwt.WithPaddingAllowed())
+	}
+	return opts
+}
+
+func (p parseCase) GoString() string {
+	return fmt.Sprintf("%s key#%d claims %s kid=%v typ=%q zoo=%v validMethods=%v jsonNumber=%v strict=%v padding=%v tamper=%#v otherKey#%d otherAlg=%s",
+		p.alg, p.keyAt, p.claims.render(), p.kid, p.typ, p.zoo, p.validMethods, p.jsonNumber, p.strict, p.padding, p.tamper, p.otherKeyAt, p.otherAlg)
+}
+
+// TestHegelJoserfcTokensParseInGo: tokens joserfc signs parse and verify in golang-jwt with the
+// same header and claims; a changed signature, payload or header, a wrong key, a wrong key type
+// or an excluded algorithm never verifies, and a line break in a segment is malformed
+// (golang-jwt/7); a key set verifies when it holds the right key; RegisteredClaims hold the
+// document's dates (a huge one wraps, golang-jwt/3).
+func TestHegelJoserfcTokensParseInGo(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, parseCases)
+		alg, c := p.alg, p.claims
+		candidates := keysFor(alg)
+		key := candidates[p.keyAt%len(candidates)]
+		raw := c.render()
+		if !c.fitsFloat64() {
+			col.count("beyond-float64-for-joserfc") // python's json writes 1e400 as Infinity
+			ht.Assume(false)
+		}
+		header := p.header(key.name)
+		enc := oracleEncode(mustJSON(header), raw, key.oracle, key.kty, alg)
+		if !enc.Ok {
+			col.fail(ht, "joserfc could not sign %s with %s: %s %s", raw, alg, enc.Error, enc.Message)
+			return
+		}
+		str := enc.Token
+		wantClaims := canon(raw)
+		if !p.jsonNumber {
+			wantClaims = canonFloat(string(raw))
+		}
+		wantHeader := canonOf(header)
+		keyFunc := func(k any) jwt.Keyfunc { return func(*jwt.Token) (any, error) { return k, nil } }
+		opts := p.options()
+		if p.jsonNumber {
+			col.count("json-number")
+		}
+
+		// the good token, into MapClaims
+		tok, err := jwt.Parse(str, keyFunc(key.public), opts...)
+		if err != nil || !tok.Valid {
+			col.fail(ht, "%s with %s: Parse(%s) = %v, want valid", alg, key.name, str, err)
+			return
+		}
+		if got := canonOf(tok.Claims); got != wantClaims {
+			col.fail(ht, "%s with %s: claims %s, joserfc signed %s", alg, key.name, got, wantClaims)
+			return
+		}
+		if got := canonOf(tok.Header); got != wantHeader {
+			col.fail(ht, "%s with %s: header %s, joserfc signed %s", alg, key.name, got, wantHeader)
+			return
+		}
+		if tok.Method.Alg() != alg || tok.Raw != str {
+			col.fail(ht, "%s with %s: Method %s, Raw %q", alg, key.name, tok.Method.Alg(), tok.Raw)
+			return
+		}
+		// into RegisteredClaims when the claims fit
+		if c.registeredUnmarshals() && !c.hasDateKind("string") {
+			rt, err := jwt.ParseWithClaims(str, &jwt.RegisteredClaims{}, keyFunc(key.public), opts...)
+			if err != nil || !rt.Valid {
+				col.fail(ht, "%s with %s: ParseWithClaims(RegisteredClaims) of %s (claims %s) = %v, want valid", alg, key.name, str, raw, err)
+				return
+			}
+			rc := rt.Claims.(*jwt.RegisteredClaims)
+			if msg := registeredDates(*rc, c); msg != "" {
+				col.mismatch(ht, c.shapes(), "%s with %s: %s", alg, key.name, msg)
+				return
+			}
+			if rc.Issuer != c.iss.val || rc.Subject != c.sub.val || rc.ID != c.jti.val {
+				col.fail(ht, "%s with %s: RegisteredClaims iss=%q sub=%q jti=%q from %s", alg, key.name, rc.Issuer, rc.Subject, rc.ID, raw)
+				return
+			}
+			if !reflect.DeepEqual([]string(rc.Audience), c.aud.vals) && !(len(rc.Audience) == 0 && len(c.aud.vals) == 0) {
+				col.fail(ht, "%s with %s: RegisteredClaims aud=%q from %s", alg, key.name, rc.Audience, raw)
+				return
+			}
+			col.count("registered")
+		}
+
+		// a tampered token
+		parts := strings.Split(str, ".")
+		tampered := p.tamper.apply(parts)
+		bad := strings.Join(tampered, ".")
+		btok, err := jwt.Parse(bad, keyFunc(key.public), opts...)
+		what := fmt.Sprintf("%s with %s", alg, key.name)
+		if !checkTampered(ht, col, p.tamper.shapes(), p.tamper.verdict(tampered, p.padding, p.strict), what, bad, btok, err) {
+			return
+		}
+		col.count("tamper-" + p.tamper.kind)
+
+		// another key of the same kind
+		var others []keyPair
+		for _, k := range keys() {
+			if k.kty == key.kty && k.name != key.name {
+				others = append(others, k)
+			}
+		}
+		if len(others) > 0 {
+			other := others[p.otherKeyAt%len(others)]
+			_, err := jwt.Parse(str, keyFunc(other.public), opts...)
+			if !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+				col.fail(ht, "%s with %s: verifies under %s: %v", alg, key.name, other.name, err)
+				return
+			}
+			// a key set with the wrong key first and the right one after
+			set := jwt.VerificationKeySet{Keys: []jwt.VerificationKey{other.public, key.public}}
+			st, err := jwt.Parse(str, keyFunc(set), opts...)
+			if err != nil || !st.Valid {
+				col.fail(ht, "%s with %s: key set {%s, %s} does not verify: %v", alg, key.name, other.name, key.name, err)
+				return
+			}
+			_, err = jwt.Parse(str, keyFunc(jwt.VerificationKeySet{Keys: []jwt.VerificationKey{other.public}}), opts...)
+			if !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+				col.fail(ht, "%s with %s: key set {%s} verifies: %v", alg, key.name, other.name, err)
+				return
+			}
+		}
+		_, err = jwt.Parse(str, keyFunc(jwt.VerificationKeySet{}), opts...)
+		if !errors.Is(err, jwt.ErrTokenUnverifiable) {
+			col.fail(ht, "%s with %s: empty key set gives %v, want ErrTokenUnverifiable", alg, key.name, err)
+			return
+		}
+		// a key of the wrong type
+		var wrongType any = []byte("not the key type")
+		if key.kty == "oct" {
+			wrongType = keysFor("ES256")[0].public
+		}
+		_, err = jwt.Parse(str, keyFunc(wrongType), opts...)
+		if !errors.Is(err, jwt.ErrTokenSignatureInvalid) || !errors.Is(err, jwt.ErrInvalidKeyType) {
+			col.fail(ht, "%s with %s: a key of the wrong type gives %v, want ErrTokenSignatureInvalid wrapping ErrInvalidKeyType", alg, key.name, err)
+			return
+		}
+		// the algorithm excluded
+		if p.otherAlg != alg {
+			_, err = jwt.Parse(str, keyFunc(key.public), jwt.WithoutClaimsValidation(), jwt.WithValidMethods([]string{p.otherAlg}))
+			if !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+				col.fail(ht, "%s with %s: WithValidMethods(%s) gives %v, want ErrTokenSignatureInvalid", alg, key.name, p.otherAlg, err)
+				return
+			}
+		}
+		// no key function, a failing key function
+		_, err = jwt.Parse(str, nil, opts...)
+		if !errors.Is(err, jwt.ErrTokenUnverifiable) {
+			col.fail(ht, "%s with %s: nil Keyfunc gives %v", alg, key.name, err)
+			return
+		}
+		boom := errors.New("boom")
+		_, err = jwt.Parse(str, func(*jwt.Token) (any, error) { return nil, boom }, opts...)
+		if !errors.Is(err, jwt.ErrTokenUnverifiable) || !errors.Is(err, boom) {
+			col.fail(ht, "%s with %s: failing Keyfunc gives %v", alg, key.name, err)
+			return
+		}
+		col.count(alg)
+	})
+}
+
+// checkAgreement judges one document RegisteredClaims holds: the six accessors give the same
+// values from MapClaims (with and without UseNumber) and from RegisteredClaims, the dates are
+// the document's, and RegisteredClaims marshal and unmarshal back to themselves under both
+// settings of MarshalSingleStringAsArray.
+func checkAgreement(ht *hegel.T, col *collector, c claimsDoc) {
+	raw := c.render()
+	shapes := c.shapes()
+	if !c.registeredUnmarshals() {
+		col.count("assume-registered-refuses") // a number beyond float64
+		ht.Assume(false)
+	}
+	var r jwt.RegisteredClaims
+	if err := json.Unmarshal(raw, &r); err != nil {
+		col.mismatch(ht, shapes, "%s into RegisteredClaims: %v", raw, err)
+		return
+	}
+	var m jwt.MapClaims
+	if err := json.Unmarshal(raw, &m); err != nil {
+		col.fail(ht, "%s into MapClaims: %v", raw, err)
+		return
+	}
+	dec := json.NewDecoder(strings.NewReader(string(raw)))
+	dec.UseNumber()
+	var mn jwt.MapClaims
+	if err := dec.Decode(&mn); err != nil {
+		col.fail(ht, "%s into MapClaims with UseNumber: %v", raw, err)
+		return
+	}
+	for _, cl := range []struct {
+		name string
+		v    jwt.Claims
+	}{{"MapClaims", m}, {"MapClaims(UseNumber)", mn}} {
+		for _, acc := range []struct {
+			name string
+			get  func(jwt.Claims) (any, error)
+		}{
+			{"exp", func(x jwt.Claims) (any, error) { return x.GetExpirationTime() }},
+			{"nbf", func(x jwt.Claims) (any, error) { return x.GetNotBefore() }},
+			{"iat", func(x jwt.Claims) (any, error) { return x.GetIssuedAt() }},
+			{"iss", func(x jwt.Claims) (any, error) { return x.GetIssuer() }},
+			{"sub", func(x jwt.Claims) (any, error) { return x.GetSubject() }},
+			{"aud", func(x jwt.Claims) (any, error) { return x.GetAudience() }},
+		} {
+			a, aerr := acc.get(cl.v)
+			b, berr := acc.get(r)
+			if (aerr != nil) != (berr != nil) {
+				col.mismatch(ht, shapes, "%s from %s: %s gives error %v, RegisteredClaims %v", acc.name, raw, cl.name, aerr, berr)
+				return
+			}
+			if aerr != nil {
+				continue
+			}
+			if !sameClaimValue(a, b) {
+				col.mismatch(ht, shapes, "%s from %s: %s gives %s, RegisteredClaims %s", acc.name, raw, cl.name, showClaim(a), showClaim(b))
+				return
+			}
+		}
+	}
+	if msg := registeredDates(r, c); msg != "" {
+		col.mismatch(ht, shapes, "%s", msg)
+		return
+	}
+	col.count("agree")
+
+	// marshal round trip of RegisteredClaims
+	for _, single := range []bool{true, false} {
+		jwt.MarshalSingleStringAsArray = single
+		out, err := json.Marshal(r)
+		jwt.MarshalSingleStringAsArray = true
+		if err != nil {
+			col.fail(ht, "marshal of %+v: %v", r, err)
+			return
+		}
+		// the model of the text: omitempty members, dates as integer seconds, aud per the switch
+		want := map[string]any{}
+		if r.Issuer != "" {
+			want["iss"] = r.Issuer
+		}
+		if r.Subject != "" {
+			want["sub"] = r.Subject
+		}
+		if r.ID != "" {
+			want["jti"] = r.ID
+		}
+		if len(r.Audience) > 0 {
+			if len(r.Audience) == 1 && !single {
+				want["aud"] = r.Audience[0]
+			} else {
+				want["aud"] = []string(r.Audience)
+			}
+		}
+		for name, d := range map[string]*jwt.NumericDate{"exp": r.ExpiresAt, "nbf": r.NotBefore, "iat": r.IssuedAt} {
+			if d != nil {
+				want[name] = json.Number(strconv.FormatInt(d.Unix(), 10))
+			}
+		}
+		if canon(out) != canonOf(want) {
+			col.fail(ht, "marshal of RegisteredClaims from %s (single=%v) = %s, want %s", raw, !single, out, mustJSON(want))
+			return
+		}
+		var back jwt.RegisteredClaims
+		if err := json.Unmarshal(out, &back); err != nil {
+			col.fail(ht, "unmarshal of %s: %v", out, err)
+			return
+		}
+		if !sameRegistered(r, back) {
+			col.fail(ht, "RegisteredClaims %s -> %s -> %s", raw, out, mustJSON(back))
+			return
+		}
+	}
+	col.count("roundtrip")
+}
+
+// TestHegelMapAndRegisteredClaimsAgree: the six accessors give the same values from MapClaims
+// (with and without UseNumber) and from RegisteredClaims for the same JSON; RegisteredClaims
+// marshal and unmarshal back to themselves under both settings of MarshalSingleStringAsArray.
+// A null claim (golang-jwt/5) and a huge date (golang-jwt/3) are drawn by default and fail
+// naming the bug.
+func TestHegelMapAndRegisteredClaimsAgree(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkAgreement(ht, col, hegel.Draw(ht, typedClaimsDocs))
+	})
+}
+
+func isPowerOfTen(x time.Duration) bool {
+	for x > 1 && x%10 == 0 {
+		x /= 10
+	}
+	return x == 1
+}
+
+func showClaim(v any) string {
+	switch x := v.(type) {
+	case *jwt.NumericDate:
+		if x == nil {
+			return "nil"
+		}
+		return x.Time.UTC().Format(time.RFC3339Nano)
+	}
+	return fmt.Sprintf("%#v", v)
+}
+
+func sameClaimValue(a, b any) bool {
+	switch x := a.(type) {
+	case *jwt.NumericDate:
+		y := b.(*jwt.NumericDate)
+		if x == nil || y == nil {
+			return x == nil && y == nil
+		}
+		return x.Time.Equal(y.Time)
+	case jwt.ClaimStrings:
+		y := b.(jwt.ClaimStrings)
+		return reflect.DeepEqual([]string(x), []string(y)) || len(x) == 0 && len(y) == 0
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func sameRegistered(a, b jwt.RegisteredClaims) bool {
+	return a.Issuer == b.Issuer && a.Subject == b.Subject && a.ID == b.ID &&
+		sameClaimValue(a.Audience, b.Audience) && sameClaimValue(a.ExpiresAt, b.ExpiresAt) &&
+		sameClaimValue(a.NotBefore, b.NotBefore) && sameClaimValue(a.IssuedAt, b.IssuedAt)
+}
+
+// --------------------------------------------------------------------------- numeric dates
+
+// dateCase is one NumericDate round trip: the precision and the instant (seconds, negated
+// for a pre-epoch instant, and nanoseconds).
+type dateCase struct {
+	prec     time.Duration
+	secs     int64
+	negative bool
+	nanos    int64
+}
+
+func (d dateCase) instant() time.Time {
+	secs := d.secs
+	if d.negative {
+		secs = -secs
+	}
+	return time.Unix(secs, d.nanos)
+}
+
+// oddPrecision reports whether the precision is not a power of ten below a second (nor a
+// multiple of a second): MarshalJSON's digit count is log10 and writes none for it.
+func (d dateCase) oddPrecision() bool {
+	return time.Second%d.prec != 0 || (d.prec < time.Second && !isPowerOfTen(time.Second/d.prec))
+}
+
+// fraction reports whether the instant keeps a fraction at the precision.
+func (d dateCase) fraction() bool { return d.instant().Truncate(d.prec).Nanosecond() != 0 }
+
+// marshalShapes names the recorded bugs of MarshalJSON the case has the shape of: a pre-epoch
+// instant with a fraction (golang-jwt/2), a precision that is not a power of ten with a
+// fraction (golang-jwt/6).
+func (d dateCase) marshalShapes() []string {
+	var s []string
+	if d.negative && d.fraction() {
+		s = append(s, "golang-jwt/2")
+	}
+	if d.oddPrecision() && d.fraction() {
+		s = append(s, "golang-jwt/6")
+	}
+	return s
+}
+
+// readShapes names the recorded bug of UnmarshalJSON the case has the shape of: a fraction at
+// sub-second precision (golang-jwt/1).
+func (d dateCase) readShapes() []string {
+	if d.prec < time.Second && d.fraction() {
+		return []string{"golang-jwt/1"}
+	}
+	return nil
+}
+
+func (d dateCase) GoString() string {
+	return fmt.Sprintf("%v at %v", d.instant().UTC().Format(time.RFC3339Nano), d.prec)
+}
+
+var (
+	// precisions: the powers of ten and two seconds; 500 ms and 250 ms (golang-jwt/6) by
+	// default, not under HEGEL_NO_KNOWN=1. By default the millisecond is a first alternative
+	// of its own: the round-trip property mapped to golang-jwt/1 (a fraction at sub-second
+	// precision) must reach the shape every run, and the engine's bounded integer draw
+	// favours the lowest values (value 1 above all) unevenly from run to run.
+	precisions = func() hegel.Generator[time.Duration] {
+		table := []time.Duration{time.Second, time.Millisecond, time.Microsecond, 2 * time.Second}
+		if !Known.oddPrecisionDrops {
+			table = append(table, 500*time.Millisecond, 250*time.Millisecond)
+		}
+		return weighted(
+			choice[time.Duration]{unless(noKnown, 20), hegel.Just(time.Millisecond)},
+			choice[time.Duration]{80, hegel.SampledFrom(table)},
+		)
+	}()
+	// roundTripSecs: anywhere up to the year 2096, one time in five near the fixed instant.
+	roundTripSecs = weighted(
+		choice[int64]{4, hegel.Map(hegel.Integers(0, 4_000_000_000), func(s int) int64 { return int64(s) })},
+		choice[int64]{1, hegel.Map(hegel.Integers(-100, 100), func(d int) int64 { return fixedNow + int64(d) })},
+	)
+	// nanos: by default one or more whole milliseconds first (the fraction of golang-jwt/1's
+	// shape at the millisecond precision drawn first, for the reason precisions gives: the
+	// simplest instance of the shape must reach the bug, and nanoseconds under a millisecond
+	// truncate to no fraction), then none, whole milliseconds, or any.
+	nanos = weighted(
+		choice[int64]{unless(noKnown, 2), hegel.Map(hegel.Integers(1, 999), func(ms int) int64 { return int64(ms) * 1_000_000 })},
+		choice[int64]{1, hegel.Just(int64(0))},
+		choice[int64]{1, hegel.Map(hegel.Integers(0, 999), func(ms int) int64 { return int64(ms) * 1_000_000 })},
+		choice[int64]{2, hegel.Map(hegel.Integers(0, 999_999_999), func(ns int) int64 { return int64(ns) })},
+	)
+	dateCases = hegel.Composite(func(tc hegel.TestCase) dateCase {
+		return dateCase{
+			prec:     hegel.Draw(tc, precisions),
+			secs:     hegel.Draw(tc, roundTripSecs),
+			negative: hegel.Draw(tc, chance(unless(Known.preEpochFraction, 15))),
+			nanos:    hegel.Draw(tc, nanos),
+		}
+	})
+)
+
+// modelDateText is the decimal MarshalJSON must write for the instant at the precision: the
+// instant's seconds, then its fraction with as many digits as the precision has (for a
+// precision that is not a power of ten, as many as the fraction needs). A pre-epoch instant
+// is written as itself (-0.5 is "-0.500").
+func modelDateText(truncated time.Time, prec time.Duration) string {
+	unix, ns := truncated.Unix(), int64(truncated.Nanosecond())
+	neg := unix < 0
+	if neg && ns > 0 {
+		unix, ns = unix+1, int64(time.Second)-ns
+	}
+	digits := 0
+	for p := prec; p < time.Second; p *= 10 {
+		digits++
+	}
+	text := strconv.FormatInt(unix, 10)
+	if neg && unix == 0 {
+		text = "-0"
+	}
+	odd := time.Second%prec != 0 || (prec < time.Second && !isPowerOfTen(time.Second/prec))
+	if odd {
+		if frac := strings.TrimRight(fmt.Sprintf("%09d", ns), "0"); frac != "" {
+			text += "." + frac
+		}
+	} else if digits > 0 {
+		text += "." + fmt.Sprintf("%0*d", digits, ns/int64(prec))
+	}
+	return text
+}
+
+// checkDateRoundTrip judges one date case: NewNumericDate truncates to TimePrecision,
+// MarshalJSON writes the modelled decimal, and UnmarshalJSON reads it back exactly (within one
+// unit below at sub-second precision under Known.subsecondTruncates).
+func checkDateRoundTrip(ht *hegel.T, col *collector, dc dateCase) {
+	prec := dc.prec
+	jwt.TimePrecision = prec
+	defer func() { jwt.TimePrecision = time.Second }()
+	instant := dc.instant()
+	d := jwt.NewNumericDate(instant)
+	truncated := instant.Truncate(prec)
+	if !d.Time.Equal(truncated) {
+		col.fail(ht, "NewNumericDate(%v) at %v = %v, want %v", instant, prec, d.Time, truncated)
+		return
+	}
+	out, err := json.Marshal(d)
+	if err != nil {
+		col.fail(ht, "marshal of %v: %v", d.Time, err)
+		return
+	}
+	if want := modelDateText(truncated, prec); string(out) != want {
+		col.mismatch(ht, dc.marshalShapes(), "marshal of %v at %v = %s, want %s", truncated, prec, out, want)
+		return
+	}
+	var back jwt.NumericDate
+	if err := json.Unmarshal(out, &back); err != nil {
+		col.fail(ht, "unmarshal of %s: %v", out, err)
+		return
+	}
+	diff := truncated.Sub(back.Time)
+	if prec == time.Second || !Known.subsecondTruncates {
+		if diff != 0 {
+			col.mismatch(ht, dc.readShapes(), "%s at %v reads back as %v, want %v", out, prec, back.Time, truncated)
+			return
+		}
+	} else if diff < 0 || diff > prec {
+		col.mismatch(ht, dc.readShapes(), "%s at %v reads back as %v, want %v (within one %v below)", out, prec, back.Time, truncated, prec)
+		return
+	}
+	col.count(prec.String())
+}
+
+// claimStringsCase is a ClaimStrings value and the MarshalSingleStringAsArray setting.
+type claimStringsCase struct {
+	vals   []string
+	single bool
+}
+
+var claimStringsCases = hegel.Composite(func(tc hegel.TestCase) claimStringsCase {
+	return claimStringsCase{vals: hegel.Draw(tc, counted(hegel.Integers(0, 3), poolString)), single: hegel.Draw(tc, chance(50))}
+})
+
+// checkClaimStrings judges one ClaimStrings case: it marshals per MarshalSingleStringAsArray
+// and reads a string, an array of strings or null, and nothing else.
+func checkClaimStrings(ht *hegel.T, col *collector, cs claimStringsCase) {
+	vals, single := cs.vals, cs.single
+	if vals == nil {
+		vals = []string{}
+	}
+	jwt.MarshalSingleStringAsArray = !single
+	out, err := json.Marshal(jwt.ClaimStrings(vals))
+	jwt.MarshalSingleStringAsArray = true
+	if err != nil {
+		col.fail(ht, "marshal of ClaimStrings %q: %v", vals, err)
+		return
+	}
+	var want []byte
+	if len(vals) == 1 && single {
+		want = mustJSON(vals[0])
+	} else {
+		want = mustJSON(vals)
+	}
+	if string(out) != string(want) {
+		col.fail(ht, "ClaimStrings %q (single=%v) = %s, want %s", vals, single, out, want)
+		return
+	}
+	var back jwt.ClaimStrings
+	if err := json.Unmarshal(out, &back); err != nil || !reflect.DeepEqual([]string(back), vals) && !(len(back) == 0 && len(vals) == 0) {
+		col.fail(ht, "ClaimStrings %s reads back as %q (%v), want %q", out, back, err, vals)
+		return
+	}
+	for _, badRaw := range []string{"5", "true", `{"a":"b"}`, `["a", 1]`, `[1]`} {
+		var x jwt.ClaimStrings
+		if err := json.Unmarshal([]byte(badRaw), &x); err == nil {
+			col.fail(ht, "ClaimStrings accepts %s as %q", badRaw, x)
+			return
+		}
+	}
+	var nullCS jwt.ClaimStrings = jwt.ClaimStrings{"keep"}
+	if err := json.Unmarshal([]byte("null"), &nullCS); err != nil {
+		col.fail(ht, "ClaimStrings refuses null: %v", err)
+		return
+	}
+	col.count("claimstrings")
+}
+
+// TestHegelNumericDatesRoundTrip: NewNumericDate truncates to TimePrecision, MarshalJSON writes
+// the decimal of that instant, and UnmarshalJSON reads it back exactly; ClaimStrings marshal per
+// MarshalSingleStringAsArray and read a string, an array of strings or null, and nothing else.
+// A fraction at sub-second precision (golang-jwt/1), a pre-epoch instant with a fraction
+// (golang-jwt/2) and a precision that is not a power of ten (golang-jwt/6) are drawn by
+// default and fail naming the bug.
+func TestHegelNumericDatesRoundTrip(t *testing.T) {
+	col := newCollector(t)
+	defer func() { jwt.TimePrecision = time.Second }()
+	property(t, func(ht *hegel.T) {
+		checkDateRoundTrip(ht, col, hegel.Draw(ht, dateCases))
+		checkClaimStrings(ht, col, hegel.Draw(ht, claimStringsCases))
+	})
+}
+
+// --------------------------------------------------------------------------- parsing model
+
+// segSpec is the spelling of one token segment: raw base64url, a line break inside it
+// (golang-jwt/7's shape, a junk character too), padded, the standard alphabet, a junk character
+// at a position (modulo the length plus one), or dirty trailing bits.
+type segSpec struct {
+	spelling string // raw padded standard junk dirty-bits
+	junk     string
+	at       int
+}
+
+// junkAt is the junk spelling with one of chars at a position.
+func junkAt(chars hegel.Generator[string]) hegel.Generator[segSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) segSpec {
+		return segSpec{spelling: "junk", junk: hegel.Draw(tc, chars), at: hegel.Draw(tc, hegel.Integers(0, 99))}
+	})
+}
+
+var (
+	junkChars = []string{"=", " ", "!", ".", "\n", "\r", "é"}
+	segSpecs  = weighted(
+		choice[segSpec]{14, hegel.Just(segSpec{spelling: "raw"})},
+		choice[segSpec]{1, junkAt(pick("\n", "\r"))},
+		choice[segSpec]{3, hegel.Just(segSpec{spelling: "padded"})},
+		choice[segSpec]{1, hegel.Just(segSpec{spelling: "standard"})},
+		choice[segSpec]{1, junkAt(hegel.SampledFrom(junkChars))},
+		choice[segSpec]{1, hegel.Just(segSpec{spelling: "dirty-bits"})},
+	)
+)
+
+// render is the segment text carrying the bytes in the spelling.
+func (s segSpec) render(b []byte) string {
+	raw := base64.RawURLEncoding.EncodeToString(b)
+	switch s.spelling {
+	case "padded":
+		return base64.URLEncoding.EncodeToString(b)
+	case "standard":
+		return base64.RawStdEncoding.EncodeToString(b)
+	case "junk":
+		at := s.at % (len(raw) + 1)
+		return raw[:at] + s.junk + raw[at:]
+	case "dirty-bits":
+		if len(raw) > 0 && len(raw)%4 != 0 {
+			// set the unused trailing bits in the last character
+			last := strings.IndexByte(b64Alphabet, raw[len(raw)-1])
+			unused := 4
+			if len(raw)%4 == 3 {
+				unused = 2
+			}
+			last |= (1 << unused) - 1
+			return raw[:len(raw)-1] + string(b64Alphabet[last])
+		}
+	}
+	return raw
+}
+
+func (s segSpec) GoString() string {
+	if s.spelling == "junk" {
+		return fmt.Sprintf("junk %q at %d", s.junk, s.at)
+	}
+	return s.spelling
+}
+
+// modelDecode says what Parser.DecodeSegment does with text under the options: the bytes, or
+// failure. A line break is a character outside the alphabet (skipped before judging under
+// Known.newlinesIgnored).
+func modelDecode(text string, padding, strict bool) ([]byte, bool) {
+	body := text
+	if padding {
+		// the parser pads by the raw length, before the decoder skips any line break
+		if l := len(body) % 4; l > 0 {
+			body += strings.Repeat("=", 4-l)
+		}
+	}
+	if Known.newlinesIgnored {
+		body = strings.NewReplacer("\n", "", "\r", "").Replace(body)
+	}
+	if padding {
+		// URLEncoding with padding: the text must now be a multiple of four with padding only at
+		// the end (at most two)
+		trimmed := strings.TrimRight(body, "=")
+		pads := len(body) - len(trimmed)
+		if pads > 2 || len(body)%4 != 0 {
+			return nil, false
+		}
+		body = trimmed
+	} else if strings.ContainsRune(body, '=') {
+		return nil, false
+	}
+	for i := 0; i < len(body); i++ {
+		if strings.IndexByte(b64Alphabet, body[i]) < 0 {
+			return nil, false
+		}
+	}
+	if len(body)%4 == 1 {
+		return nil, false
+	}
+	if strict && len(body)%4 != 0 {
+		last := strings.IndexByte(b64Alphabet, body[len(body)-1])
+		unused := 2
+		if len(body)%4 == 2 {
+			unused = 4
+		}
+		if last&((1<<unused)-1) != 0 {
+			return nil, false
+		}
+	}
+	out, err := base64.RawURLEncoding.DecodeString(body)
+	if err != nil {
+		return nil, false
+	}
+	return out, true
+}
+
+// lineBreakShape names golang-jwt/7 when the text has a line break.
+func lineBreakShape(text string) []string {
+	if strings.ContainsAny(text, "\r\n") {
+		return []string{"golang-jwt/7"}
+	}
+	return nil
+}
+
+// tokenEdit is one change to a whole token, applied modulo the live length: a dot appended, or
+// a line break inserted anywhere (golang-jwt/7's shape).
+type tokenEdit struct {
+	kind string // dot break
+	at   int
+	text string
+}
+
+func (e tokenEdit) apply(token string) string {
+	if e.kind == "dot" {
+		return token + "."
+	}
+	at := e.at % (len(token) + 1)
+	return token[:at] + e.text + token[at:]
+}
+
+func (e tokenEdit) GoString() string {
+	if e.kind == "dot" {
+		return "append ."
+	}
+	return fmt.Sprintf("insert %q at %d", e.text, e.at)
+}
+
+var (
+	tokenEdits = weighted(
+		choice[tokenEdit]{1, hegel.Just(tokenEdit{kind: "dot"})},
+		choice[tokenEdit]{1, hegel.Composite(func(tc hegel.TestCase) tokenEdit {
+			return tokenEdit{kind: "break", at: hegel.Draw(tc, hegel.Integers(0, 399)), text: hegel.Draw(tc, pick("\n", "\r"))}
+		})},
+	)
+	// tokenEditLists: no edit most of the time, one otherwise.
+	tokenEditLists = counted(weighted(choice[int]{10, hegel.Just(0)}, choice[int]{2, hegel.Just(1)}), tokenEdits)
+)
+
+// parsingCase is one parsing case: the parser options, a segment for DecodeSegment alone, and
+// a token made of a header (its alg and shape), claims (a document or a broken shape), a
+// signature, three segment spellings and the edits, plus the text the no-panic check uses.
+type parsingCase struct {
+	padding, strict bool
+	bytes           []byte
+	seg             segSpec
+	alg             string
+	algShape        string // string missing number null
+	headerShape     string // json { [1] null ""
+	claims          claimsDoc
+	claimsShape     string // doc { "x" null []
+	sig             []byte
+	segs            []segSpec
+	edits           []tokenEdit
+	useJunk         bool
+	junk            string
+}
+
+var parsingCases = hegel.Composite(func(tc hegel.TestCase) parsingCase {
+	return parsingCase{
+		padding:     hegel.Draw(tc, chance(40)),
+		strict:      hegel.Draw(tc, chance(30)),
+		bytes:       hegel.Draw(tc, hegel.Binary(0, 12)),
+		seg:         hegel.Draw(tc, segSpecs),
+		alg:         hegel.Draw(tc, hegel.SampledFrom(slices.Concat(allAlgs, []string{"none", "XX", "", "hs256"}))),
+		algShape:    hegel.Draw(tc, weighted(choice[string]{9, hegel.Just("string")}, choice[string]{1, hegel.Just("missing")}, choice[string]{1, hegel.Just("number")}, choice[string]{1, hegel.Just("null")})),
+		headerShape: hegel.Draw(tc, weighted(choice[string]{11, hegel.Just("json")}, choice[string]{1, hegel.Just("{")}, choice[string]{1, hegel.Just("[1]")}, choice[string]{1, hegel.Just("null")}, choice[string]{1, hegel.Just("")})),
+		claims:      hegel.Draw(tc, claimsDocs),
+		claimsShape: hegel.Draw(tc, weighted(choice[string]{11, hegel.Just("doc")}, choice[string]{1, hegel.Just("{")}, choice[string]{1, hegel.Just(`"x"`)}, choice[string]{1, hegel.Just("null")}, choice[string]{1, hegel.Just("[]")})),
+		sig:         hegel.Draw(tc, hegel.Binary(0, 70)),
+		segs:        hegel.Draw(tc, hegel.Lists(segSpecs).MinSize(3).MaxSize(3)),
+		edits:       hegel.Draw(tc, tokenEditLists),
+		useJunk:     hegel.Draw(tc, chance(30)),
+		junk:        hegel.Draw(tc, hegel.Text().Alphabet("aZ09-_=.+/ {}\"").MaxSize(30)),
+	}
+})
+
+// header is the header object (alg of the drawn shape).
+func (p parsingCase) header() map[string]any {
+	h := map[string]any{"alg": p.alg, "typ": "JWT"}
+	switch p.algShape {
+	case "missing":
+		delete(h, "alg")
+	case "number":
+		h["alg"] = 5
+	case "null":
+		h["alg"] = nil
+	}
+	return h
+}
+
+// headerText is the header segment's content and whether it is JSON that unmarshals into the
+// header map.
+func (p parsingCase) headerText() (string, bool) {
+	switch p.headerShape {
+	case "json":
+		return string(mustJSON(p.header())), true
+	case "null":
+		return "null", true // unmarshals into a nil map
+	}
+	return p.headerShape, false
+}
+
+// claimsText is the claims segment's content and whether it unmarshals into MapClaims (a
+// number beyond float64 does not).
+func (p parsingCase) claimsText() (string, bool) {
+	switch p.claimsShape {
+	case "doc":
+		return string(p.claims.render()), p.claims.fitsFloat64()
+	case "null":
+		return "null", true
+	}
+	return p.claimsShape, false
+}
+
+// token is the token text: the three segments in their spellings, then the edits.
+func (p parsingCase) token() string {
+	h, _ := p.headerText()
+	c, _ := p.claimsText()
+	token := p.segs[0].render([]byte(h)) + "." + p.segs[1].render([]byte(c)) + "." + p.segs[2].render(p.sig)
+	for _, e := range p.edits {
+		token = e.apply(token)
+	}
+	return token
+}
+
+func (p parsingCase) GoString() string {
+	h, _ := p.headerText()
+	c, _ := p.claimsText()
+	return fmt.Sprintf("padding=%v strict=%v segment %x as %#v; token header %q claims %q sig %x as %#v edits %#v junk=%v %q",
+		p.padding, p.strict, p.bytes, p.seg, h, c, p.sig, p.segs, p.edits, p.useJunk, p.junk)
+}
+
+// modelParseUnverified says what ParseUnverified does with the token under the options: nil
+// when it parses, else the sentinel. Three segments exactly; the header and claims segments
+// decode and are JSON; the header names a known algorithm; the signature decodes.
+func modelParseUnverified(p parsingCase, token string) error {
+	parts := strings.Split(token, ".")
+	if len(parts) != 3 {
+		return jwt.ErrTokenMalformed
+	}
+	headerText, headerJSON := p.headerText()
+	_, claimsJSON := p.claimsText()
+	header := p.header()
+	if _, ok := modelDecode(parts[0], p.padding, p.strict); !ok || !headerJSON {
+		return jwt.ErrTokenMalformed
+	}
+	if _, ok := modelDecode(parts[1], p.padding, p.strict); !ok || !claimsJSON {
+		return jwt.ErrTokenMalformed
+	}
+	if headerText == "null" || header["alg"] == nil {
+		return jwt.ErrTokenUnverifiable
+	}
+	if a, isStr := header["alg"].(string); !isStr || jwt.GetSigningMethod(a) == nil {
+		return jwt.ErrTokenUnverifiable
+	}
+	if _, ok := modelDecode(parts[2], p.padding, p.strict); !ok {
+		return jwt.ErrTokenMalformed
+	}
+	return nil
+}
+
+// TestHegelParsingFollowsBase64AndJSON: DecodeSegment agrees with the model of the options, and
+// ParseUnverified classifies a token (malformed, unverifiable, or parsed with the header and
+// claims read) exactly as the model of its steps says; nothing panics on random tokens through
+// every entry point. A line break in a segment (golang-jwt/7) is drawn by default and fails
+// naming the bug.
+func TestHegelParsingFollowsBase64AndJSON(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, parsingCases)
+		padding, strict := p.padding, p.strict
+		var opts []jwt.ParserOption
+		if padding {
+			opts = append(opts, jwt.WithPaddingAllowed())
+		}
+		if strict {
+			opts = append(opts, jwt.WithStrictDecoding())
+		}
+		parser := jwt.NewParser(opts...)
+
+		// DecodeSegment alone
+		text := p.seg.render(p.bytes)
+		wantBytes, wantOK := modelDecode(text, padding, strict)
+		got, err := parser.DecodeSegment(text)
+		if (err == nil) != wantOK || (wantOK && string(got) != string(wantBytes)) {
+			col.mismatch(ht, lineBreakShape(text), "DecodeSegment(%q, padding=%v strict=%v) = %x, %v; model %x, %v (%#v)", text, padding, strict, got, err, wantBytes, wantOK, p.seg)
+			return
+		}
+		col.count("decode-" + p.seg.spelling)
+
+		// a token from generated segments
+		token := p.token()
+		headerText, _ := p.headerText()
+		claimsText, _ := p.claimsText()
+		header := p.header()
+		wantErr := modelParseUnverified(p, token)
+		shapes := lineBreakShape(token)
+		tok, parts, err := parser.ParseUnverified(token, jwt.MapClaims{})
+		if wantErr == nil {
+			if err != nil {
+				col.mismatch(ht, shapes, "ParseUnverified(%q, padding=%v strict=%v) = %v, want success (%#v)", token, padding, strict, err, p.segs)
+				return
+			}
+			if len(parts) != 3 || canonOf(tok.Header) != canon([]byte(headerText)) || tok.Method.Alg() != header["alg"] || string(tok.Signature) != string(p.sig) {
+				col.mismatch(ht, shapes, "ParseUnverified(%q): header %s (want %s), alg %v, signature %x (want %x)", token, mustJSON(tok.Header), headerText, tok.Method, tok.Signature, p.sig)
+				return
+			}
+			if claimsText != "null" && canonOf(tok.Claims) != canonFloat(claimsText) {
+				col.mismatch(ht, shapes, "ParseUnverified(%q): claims %s, want %s", token, mustJSON(tok.Claims), claimsText)
+				return
+			}
+			col.count("parsed")
+		} else {
+			if err == nil || !errors.Is(err, wantErr) {
+				col.mismatch(ht, shapes, "ParseUnverified(%q, padding=%v strict=%v) = %v, want %v (%#v; header %q claims %q)", token, padding, strict, err, wantErr, p.segs, headerText, claimsText)
+				return
+			}
+			col.count(wantErr.Error())
+		}
+
+		// nothing panics: the full parse of this token and of random text, every claims type
+		junk := token
+		if p.useJunk {
+			junk = p.junk
+		}
+		claimTypes := []jwt.Claims{jwt.MapClaims{}, &jwt.RegisteredClaims{}, jwt.RegisteredClaims{}, &customClaims{}}
+		for _, cl := range claimTypes {
+			keyFunc := func(t *jwt.Token) (any, error) {
+				switch t.Method.Alg() {
+				case "none":
+					return jwt.UnsafeAllowNoneSignatureType, nil
+				case "HS256", "HS384", "HS512":
+					return []byte("k"), nil
+				}
+				return keysFor("ES256")[0].public, nil
+			}
+			ptok, perr := jwt.ParseWithClaims(junk, cl, keyFunc, append(opts, jwt.WithJSONNumber())...)
+			if perr == nil && (ptok == nil || !ptok.Valid) {
+				col.fail(ht, "ParseWithClaims(%q, %T): no error but not valid", junk, cl)
+				return
+			}
+		}
+		col.count("nopanic")
+	})
+}
+
+type customClaims struct {
+	Foo string `json:"foo"`
+	jwt.RegisteredClaims
+}
+
+func (c customClaims) Validate() error {
+	if c.Foo == "bad" {
+		return errors.New("foo is bad")
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- signing methods
+
+// sigEdit is a change to a signature: a bit flipped at a position modulo the length, the last
+// byte dropped, a byte appended, or nothing left.
+type sigEdit struct {
+	kind string // flip truncate extend empty
+	at   int
+	bit  int
+}
+
+func (e sigEdit) apply(sig []byte) []byte {
+	bad := slices.Clone(sig)
+	switch e.kind {
+	case "truncate":
+		return bad[:len(bad)-1]
+	case "extend":
+		return append(bad, 0)
+	case "empty":
+		return nil
+	}
+	i := e.at % len(bad)
+	bad[i] ^= byte(1 << e.bit)
+	return bad
+}
+
+func (e sigEdit) GoString() string {
+	if e.kind == "flip" {
+		return fmt.Sprintf("flip bit %d of byte %d", e.bit, e.at)
+	}
+	return e.kind
+}
+
+var sigEdits = weighted(
+	choice[sigEdit]{3, hegel.Composite(func(tc hegel.TestCase) sigEdit {
+		return sigEdit{kind: "flip", at: hegel.Draw(tc, hegel.Integers(0, 299)), bit: hegel.Draw(tc, hegel.Integers(0, 7))}
+	})},
+	choice[sigEdit]{1, hegel.Just(sigEdit{kind: "truncate"})},
+	choice[sigEdit]{1, hegel.Just(sigEdit{kind: "extend"})},
+	choice[sigEdit]{1, hegel.Just(sigEdit{kind: "empty"})},
+)
+
+// signCase is a signing case: the method, the text, which key of the pool (modulo), the damage.
+type signCase struct {
+	alg    string
+	text   string
+	keyAt  int
+	damage sigEdit
+}
+
+var signCases = hegel.Composite(func(tc hegel.TestCase) signCase {
+	return signCase{
+		alg:    hegel.Draw(tc, hegel.SampledFrom(allAlgs)),
+		text:   hegel.Draw(tc, hegel.Text().Alphabet("abc.xyzé").MaxSize(40)),
+		keyAt:  hegel.Draw(tc, hegel.Integers(0, 15)),
+		damage: hegel.Draw(tc, sigEdits),
+	}
+})
+
+func (s signCase) GoString() string {
+	return fmt.Sprintf("%s of %q with key#%d, damage %#v", s.alg, s.text, s.keyAt, s.damage)
+}
+
+// TestHegelSigningMethodsCheckKeysAndSignatures: Sign takes exactly the key types its method
+// documents (and the matching curve), Verify accepts the matching public key and nothing else,
+// no altered signature verifies, and the none method is only usable with its magic constant.
+func TestHegelSigningMethodsCheckKeysAndSignatures(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, signCases)
+		alg, text := sc.alg, sc.text
+		m := methodOf(alg)
+		if m == nil || m.Alg() != alg {
+			col.fail(ht, "GetSigningMethod(%s) = %v", alg, m)
+			return
+		}
+		pool := keys()
+		key := pool[sc.keyAt%len(pool)]
+		serves := slices.Contains(key.algs, alg)
+		sig, err := m.Sign(text, key.private)
+		ktyOf := map[string]string{"HS": "oct", "RS": "RSA", "PS": "RSA", "ES": "EC", "Ed": "OKP"}[alg[:2]]
+		switch {
+		case serves:
+			if err != nil {
+				col.fail(ht, "%s.Sign with %s: %v", alg, key.name, err)
+				return
+			}
+		case key.kty != ktyOf:
+			// EdDSA takes any crypto.Signer and refuses one whose public key is not Ed25519 with
+			// ErrInvalidKey; the other methods switch on the key type
+			if !errors.Is(err, jwt.ErrInvalidKeyType) && !(alg == "EdDSA" && errors.Is(err, jwt.ErrInvalidKey)) {
+				col.fail(ht, "%s.Sign with %s (%s): %v, want ErrInvalidKeyType", alg, key.name, key.kty, err)
+				return
+			}
+			col.count("sign-wrong-type")
+		default:
+			// the right type but not serving: an EC key of another curve, or an oct key shorter than
+			// the hash (golang-jwt does not enforce RFC 7518 3.2, so those sign)
+			if key.kty == "EC" {
+				if !errors.Is(err, jwt.ErrInvalidKey) {
+					col.fail(ht, "%s.Sign with %s: %v, want ErrInvalidKey", alg, key.name, err)
+					return
+				}
+				col.count("sign-wrong-curve")
+			} else if err != nil {
+				col.fail(ht, "%s.Sign with %s: %v", alg, key.name, err)
+				return
+			}
+		}
+		if err != nil {
+			return
+		}
+		if err := m.Verify(text, sig, key.public); err != nil {
+			col.fail(ht, "%s.Verify of its own signature with %s: %v", alg, key.name, err)
+			return
+		}
+		// the expected signature sizes
+		wantLen := map[string]int{"HS256": 32, "HS384": 48, "HS512": 64, "ES256": 64, "ES384": 96, "ES512": 132, "EdDSA": 64}
+		if l, ok := wantLen[alg]; ok && len(sig) != l {
+			col.fail(ht, "%s signature of %d bytes, want %d", alg, len(sig), l)
+			return
+		}
+		if key.kty == "RSA" && len(sig) != 256 {
+			col.fail(ht, "%s signature of %d bytes, want 256", alg, len(sig))
+			return
+		}
+		// another key of the same type
+		for _, other := range pool {
+			if other.kty == key.kty && other.name != key.name && slices.Contains(other.algs, alg) {
+				if err := m.Verify(text, sig, other.public); err == nil {
+					col.fail(ht, "%s signature by %s verifies under %s", alg, key.name, other.name)
+					return
+				}
+			}
+		}
+		// other key types
+		for _, other := range pool {
+			if other.kty != key.kty {
+				if err := m.Verify(text, sig, other.public); !errors.Is(err, jwt.ErrInvalidKeyType) {
+					col.fail(ht, "%s.Verify with %s (%s): %v, want ErrInvalidKeyType", alg, other.name, other.kty, err)
+					return
+				}
+			}
+		}
+		// pointer forms golang-jwt does not take
+		switch pub := key.public.(type) {
+		case ed25519.PublicKey:
+			if err := m.Verify(text, sig, &pub); !errors.Is(err, jwt.ErrInvalidKeyType) {
+				col.fail(ht, "%s.Verify with *ed25519.PublicKey: %v", alg, err)
+				return
+			}
+		case *ecdsa.PublicKey:
+			if err := m.Verify(text, sig, *pub); !errors.Is(err, jwt.ErrInvalidKeyType) {
+				col.fail(ht, "%s.Verify with ecdsa.PublicKey by value: %v", alg, err)
+				return
+			}
+		}
+		// an altered signature
+		bad := sc.damage.apply(sig)
+		if err := m.Verify(text, bad, key.public); err == nil {
+			col.fail(ht, "%s: altered signature %x (from %x) verifies with %s", alg, bad, sig, key.name)
+			return
+		}
+		// another text
+		if err := m.Verify(text+"x", sig, key.public); err == nil {
+			col.fail(ht, "%s: signature of %q verifies %q", alg, text, text+"x")
+			return
+		}
+		col.count(alg)
+
+		// the none method
+		none := jwt.GetSigningMethod("none")
+		nsig, err := none.Sign(text, jwt.UnsafeAllowNoneSignatureType)
+		if err != nil || len(nsig) != 0 {
+			col.fail(ht, "none.Sign with the magic constant: %x, %v", nsig, err)
+			return
+		}
+		if _, err := none.Sign(text, key.private); !errors.Is(err, jwt.ErrTokenUnverifiable) {
+			col.fail(ht, "none.Sign with %s: %v, want NoneSignatureTypeDisallowedError", key.name, err)
+			return
+		}
+		if err := none.Verify(text, nil, jwt.UnsafeAllowNoneSignatureType); err != nil {
+			col.fail(ht, "none.Verify of an empty signature: %v", err)
+			return
+		}
+		if err := none.Verify(text, sig, jwt.UnsafeAllowNoneSignatureType); err == nil {
+			col.fail(ht, "none.Verify accepts a non-empty signature")
+			return
+		}
+		if err := none.Verify(text, nil, key.public); err == nil {
+			col.fail(ht, "none.Verify accepts %s", key.name)
+			return
+		}
+		ntok := jwt.NewWithClaims(none, jwt.MapClaims{"a": 1})
+		nstr, err := ntok.SignedString(jwt.UnsafeAllowNoneSignatureType)
+		if err != nil || !strings.HasSuffix(nstr, ".") {
+			col.fail(ht, "none token %q, %v", nstr, err)
+			return
+		}
+		if p, err := jwt.Parse(nstr, func(*jwt.Token) (any, error) { return jwt.UnsafeAllowNoneSignatureType, nil }); err != nil || !p.Valid {
+			col.fail(ht, "none token does not parse with the magic constant: %v", err)
+			return
+		}
+		if _, err := jwt.Parse(nstr, func(*jwt.Token) (any, error) { return key.public, nil }); !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+			col.fail(ht, "none token parses with %s: %v", key.name, err)
+			return
+		}
+		if _, err := jwt.Parse(nstr, func(*jwt.Token) (any, error) { return jwt.UnsafeAllowNoneSignatureType, nil }, jwt.WithValidMethods([]string{alg})); !errors.Is(err, jwt.ErrTokenSignatureInvalid) {
+			col.fail(ht, "none token parses under WithValidMethods(%s): %v", alg, err)
+			return
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- request extractors
+
+// requestCase is a request carrying a token: where it goes and what else is around.
+type requestCase struct {
+	sub         string
+	place       string // nowhere bearer header query form
+	headerName  string
+	argName     string
+	prefix      string
+	otherQuery  bool
+	post        bool
+	otherHeader bool
+}
+
+var requestCases = hegel.Composite(func(tc hegel.TestCase) requestCase {
+	return requestCase{
+		sub:         hegel.Draw(tc, poolString),
+		place:       hegel.Draw(tc, pick("nowhere", "bearer", "header", "query", "form")),
+		headerName:  hegel.Draw(tc, pick("X-Token", "Authorization", "x-token")),
+		argName:     hegel.Draw(tc, pick("access_token", "tok")),
+		prefix:      hegel.Draw(tc, pick("Bearer ", "bearer ", "BEARER ", "Bearer  ", "Token ", "")),
+		otherQuery:  hegel.Draw(tc, chance(30)),
+		post:        hegel.Draw(tc, chance(30)),
+		otherHeader: hegel.Draw(tc, chance(20)),
+	}
+})
+
+func (r requestCase) GoString() string {
+	return fmt.Sprintf("sub=%q in %s (header %s, arg %s, prefix %q) otherQuery=%v post=%v otherHeader=%v", r.sub, r.place, r.headerName, r.argName, r.prefix, r.otherQuery, r.post, r.otherHeader)
+}
+
+// request builds the HTTP request carrying the signed token.
+func (r requestCase) request(str string) *http.Request {
+	q := url.Values{}
+	form := url.Values{}
+	if r.otherQuery {
+		q.Set("other", "x")
+	}
+	if r.place == "query" {
+		q.Set(r.argName, str)
+	}
+	if r.place == "form" {
+		form.Set(r.argName, str)
+	}
+	var req *http.Request
+	if len(form) > 0 || r.post {
+		req, _ = http.NewRequest("POST", "http://example.test/?"+q.Encode(), strings.NewReader(form.Encode()))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	} else {
+		req, _ = http.NewRequest("GET", "http://example.test/?"+q.Encode(), nil)
+	}
+	if r.place == "bearer" {
+		req.Header.Set("Authorization", r.prefix+str)
+	}
+	if r.place == "header" {
+		req.Header.Set(r.headerName, str)
+	}
+	if r.otherHeader {
+		req.Header.Set("X-Other", "y")
+	}
+	return req
+}
+
+// TestHegelRequestExtractorsFindTheToken: the request package's extractors find the token where
+// the model says (Authorization: Bearer in any case, named headers, query and form arguments, in
+// order, with filters), and ParseFromRequest verifies it.
+func TestHegelRequestExtractorsFindTheToken(t *testing.T) {
+	col := newCollector(t)
+	key := keysFor("HS256")[0]
+	property(t, func(ht *hegel.T) {
+		rc := hegel.Draw(ht, requestCases)
+		tok := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{"sub": rc.sub})
+		str, err := tok.SignedString(key.private)
+		if err != nil {
+			col.fail(ht, "sign: %v", err)
+			return
+		}
+		place, headerName, argName, prefix := rc.place, rc.headerName, rc.argName, rc.prefix
+		req := rc.request(str)
+
+		// BearerExtractor
+		got, err := request.BearerExtractor{}.ExtractToken(req)
+		auth := req.Header.Get("Authorization")
+		wantBearer := ""
+		if len(auth) >= 7 && strings.EqualFold(auth[:7], "bearer ") {
+			wantBearer = auth[7:]
+		}
+		if wantBearer == "" {
+			if !errors.Is(err, request.ErrNoTokenInRequest) || got != "" {
+				col.fail(ht, "BearerExtractor on %q: %q, %v; want ErrNoTokenInRequest", auth, got, err)
+				return
+			}
+		} else if err != nil || got != wantBearer {
+			col.fail(ht, "BearerExtractor on %q: %q, %v; want %q", auth, got, err, wantBearer)
+			return
+		}
+		// HeaderExtractor: first named header with a value
+		names := []string{"X-Missing", headerName, "Authorization"}
+		got, err = request.HeaderExtractor(names).ExtractToken(req)
+		wantHeader := ""
+		for _, nm := range names {
+			if v := req.Header.Get(nm); v != "" {
+				wantHeader = v
+				break
+			}
+		}
+		if (wantHeader == "") != errors.Is(err, request.ErrNoTokenInRequest) || got != wantHeader {
+			col.fail(ht, "HeaderExtractor%q: %q, %v; want %q", names, got, err, wantHeader)
+			return
+		}
+		// ArgumentExtractor: query and form
+		args := []string{"missing", argName}
+		got, err = request.ArgumentExtractor(args).ExtractToken(req)
+		wantArg := ""
+		if place == "query" || place == "form" {
+			wantArg = str
+		}
+		if (wantArg == "") != errors.Is(err, request.ErrNoTokenInRequest) || got != wantArg {
+			col.fail(ht, "ArgumentExtractor%q (%s): %q, %v; want %q", args, place, got, err, wantArg)
+			return
+		}
+		// MultiExtractor in order, with a filter
+		multi := request.MultiExtractor{request.ArgumentExtractor(args), request.HeaderExtractor([]string{headerName}), &request.PostExtractionFilter{Extractor: request.BearerExtractor{}, Filter: func(s string) (string, error) { return strings.TrimSpace(s), nil }}}
+		got, err = multi.ExtractToken(req)
+		wantMulti := ""
+		switch {
+		case wantArg != "":
+			wantMulti = wantArg
+		case req.Header.Get(headerName) != "":
+			wantMulti = req.Header.Get(headerName)
+		case wantBearer != "":
+			wantMulti = strings.TrimSpace(wantBearer)
+		}
+		if (wantMulti == "") != errors.Is(err, request.ErrNoTokenInRequest) || got != wantMulti {
+			col.fail(ht, "MultiExtractor (%s, prefix %q): %q, %v; want %q", place, prefix, got, err, wantMulti)
+			return
+		}
+		// ParseFromRequest with the extractor that should find the token
+		parsed, err := request.ParseFromRequest(req, multi, func(*jwt.Token) (any, error) { return key.public, nil }, request.WithParser(jwt.NewParser(jwt.WithValidMethods([]string{"HS256"}))))
+		if wantMulti == str {
+			if err != nil || !parsed.Valid {
+				col.fail(ht, "ParseFromRequest (%s): %v, want valid", place, err)
+				return
+			}
+			col.count("found-" + place)
+		} else {
+			if err == nil {
+				col.fail(ht, "ParseFromRequest (%s, prefix %q) found %q valid", place, prefix, wantMulti)
+				return
+			}
+			col.count("not-found-" + place)
+		}
+	})
+}
