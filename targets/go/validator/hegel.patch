+// formatCase: a format tag with one of its values.
+type formatCase struct {
+	tag string
+	fmtValue
+}
+
+var formatCases = hegel.FlatMap(hegel.SampledFrom(formats), func(fc fmtCase) hegel.Generator[formatCase] {
+	return hegel.Map(fc.gen, func(v fmtValue) formatCase { return formatCase{fc.tag, v} })
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c formatCase) GoString() string {
+	return fmt.Sprintf("Var(%#v, %s), want pass=%v", c.value, c.tag, c.want)
+}
+
+// TestHegelStringFormatsFollowTheModel: each format tag on values built valid or invalid by
+// independent code.
+func TestHegelStringFormatsFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, formatCases)
+		errs, bad := errsOf(val.Var(tcase.value, tcase.tag))
+		if bad != "" {
+			ht.Fatalf("Var(%#v, %s): %s", tcase.value, tcase.tag, bad)
+		}
+		if (len(errs) == 0) != tcase.want {
+			ht.Fatalf("Var(%#v, %s) = %v, want pass=%v", tcase.value, tcase.tag, errs, tcase.want)
+		}
+	})
+}
