+	// base64rawurls: raw URL encoding, or the padded one (valid when it has no padding)
+	base64s = hegel.Map(pairs(words, chance(20)), func(p pair[string, bool]) fmtValue {
+		b := []byte(p.a)
+		s := base64.StdEncoding.EncodeToString(b)
