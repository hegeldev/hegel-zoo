+	{"alphanumspace", classified(mixedText, func(s string) bool {
+		return s != "" && all(s, func(r rune) bool { return r == ' ' || (isASCII(r) && (unicode.IsLetter(r) || unicode.IsDigit(r))) })
+	})},
+	{"alphaunicode", classified(mixedText, func(s string) bool { return s != "" && all(s, unicode.IsLetter) })},
+	{"alphanumunicode", classified(mixedText, func(s string) bool {
