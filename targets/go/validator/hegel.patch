+// --------------------------------------------------------------------------- substrings and sets
+
+const (
+	// subPool: the characters of the texts: letters, the tag metacharacters, a non-ASCII letter,
+	// a space and a CJK character; paramPool leaves out the space, which splits tags outside quotes
+	subPool   = "ab,|=\u00e9 \u65e5"
+	paramPool = "ab,|=\u00e9\u65e5"
+)
+
+var (
+	subTexts = runes(subPool, 0, 5)
+	// subTags: the substring tags, and "oneof" standing for the whole family
+	subTags = []string{"contains", "containsany", "containsrune", "excludes", "excludesall", "excludesrune",
+		"startswith", "endswith", "startsnotwith", "endsnotwith", "eq", "ne", "eq_ignore_case", "ne_ignore_case", "oneof"}
+	setNames = []string{"oneof", "oneofci", "noneof", "noneofci"}
+)
+
+// substrings: a slice of s between two positions, spaces dropped (a space splits tags outside
+// quotes).
+func substrings(s string) hegel.Generator[string] {
+	rs := []rune(s)
+	return hegel.Map(pairs(hegel.Integers(0, len(rs)), hegel.Integers(0, len(rs))), func(ij pair[int, int]) string {
+		i, j := ij.a, ij.b
+		if i > j {
+			i, j = j, i
+		}
+		return strings.ReplaceAll(string(rs[i:j]), " ", "")
+	})
+}
+
+// subParams: the parameter of a substring tag on s: a fresh string 60% of the time, a substring
+// of s otherwise; the rune tags need a character.
+func subParams(tag, s string) hegel.Generator[string] {
+	lo := 0
+	if tag == "containsrune" || tag == "excludesrune" {
+		lo = 1
+	}
+	fresh := runes(paramPool, lo, 3)
+	if s == "" {
+		return fresh
+	}
+	subs := substrings(s)
+	if lo == 1 {
+		subs = hegel.Filter(subs, func(p string) bool { return p != "" })
+	}
+	return weighted(choice[string]{60, fresh}, choice[string]{40, subs})
+}
+
+// subCase: a text and a substring tag with its parameter, or a text and a member of the oneof
+// family with the set's values (one to three short strings, some with spaces or commas, plus
+// the text itself 40% of the time).
+type subCase struct {
+	tag  string
+	s, p string
+	vals []string
+}
+
+var subCases = hegel.FlatMap(hegel.SampledFrom(subTags), func(tag string) hegel.Generator[subCase] {
+	if tag != "oneof" {
+		return hegel.FlatMap(subTexts, func(s string) hegel.Generator[subCase] {
+			return hegel.Map(subParams(tag, s), func(p string) subCase { return subCase{tag: tag, s: s, p: p} })
+		})
+	}
+	return hegel.Composite(func(tc hegel.TestCase) subCase {
+		s := hegel.Draw(tc, subTexts)
+		vals := hegel.Draw(tc, hegel.Lists(runes("ab\u00e9 ,", 0, 3)).MinSize(1).MaxSize(3))
+		if hegel.Draw(tc, chance(40)) {
+			vals = append(vals, s)
+		}
+		return subCase{tag: hegel.Draw(tc, hegel.SampledFrom(setNames)), s: s, vals: vals}
+	})
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c subCase) GoString() string {
+	if c.vals != nil {
+		return fmt.Sprintf("%s of %q on %q", c.tag, c.vals, c.s)
+	}
+	return fmt.Sprintf("%s=%q on %q", c.tag, c.p, c.s)
+}
+
+// TestHegelSubstringTagsFollowTheModel: contains/containsany/containsrune/excludes/
+// excludesall/excludesrune/startswith/endswith/startsnotwith/endsnotwith/eq/ne/eq_ignore_case
+// with parameters written through the 0x2C/0x7C escapes, and oneof/oneofci/noneof/noneofci
+// with quoted values, against the strings package.
+func TestHegelSubstringTagsFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, subCases)
+		s, p := tcase.s, tcase.p
+		var tag string
+		var want bool
+		switch tcase.tag {
+		case "contains":
+			tag, want = "contains="+escParam(p), strings.Contains(s, p)
+		case "containsany":
+			tag, want = "containsany="+escParam(p), strings.ContainsAny(s, p)
+		case "containsrune":
+			r := []rune(p)[0]
+			tag, want = "containsrune="+escParam(string(r)), strings.ContainsRune(s, r)
+		case "excludes":
+			tag, want = "excludes="+escParam(p), !strings.Contains(s, p)
+		case "excludesall":
+			tag, want = "excludesall="+escParam(p), !strings.ContainsAny(s, p)
+		case "excludesrune":
+			r := []rune(p)[0]
+			tag, want = "excludesrune="+escParam(string(r)), !strings.ContainsRune(s, r)
+		case "startswith":
+			tag, want = "startswith="+escParam(p), strings.HasPrefix(s, p)
+		case "endswith":
+			tag, want = "endswith="+escParam(p), strings.HasSuffix(s, p)
+		case "startsnotwith":
+			tag, want = "startsnotwith="+escParam(p), !strings.HasPrefix(s, p)
+		case "endsnotwith":
+			tag, want = "endsnotwith="+escParam(p), !strings.HasSuffix(s, p)
+		case "eq":
+			tag, want = "eq="+escParam(p), s == p
+		case "ne":
+			tag, want = "ne="+escParam(p), s != p
+		case "eq_ignore_case":
+			tag, want = "eq_ignore_case="+escParam(p), strings.EqualFold(s, p)
+		case "ne_ignore_case":
+			tag, want = "ne_ignore_case="+escParam(p), !strings.EqualFold(s, p)
+		default:
+			// oneof family: values with spaces (and the empty value) are quoted
+			name := tcase.tag
+			var parts []string
+			for _, x := range tcase.vals {
+				if strings.ContainsAny(x, " ") || x == "" {
+					parts = append(parts, "'"+escParam(x)+"'")
+				} else {
+					parts = append(parts, escParam(x))
+				}
+			}
+			tag = name + "=" + strings.Join(parts, " ")
+			in := false
+			for _, x := range tcase.vals {
+				// an empty quoted value '' is the member ""
+				if x == s || (strings.HasSuffix(name, "ci") && strings.EqualFold(x, s)) {
+					in = true
+				}
+			}
+			want = in == strings.HasPrefix(name, "oneof")
+		}
+		errs, bad := errsOf(val.Var(s, tag))
+		if bad != "" {
+			ht.Fatalf("Var(%q, %q): %s", s, tag, bad)
+		}
+		if (len(errs) == 0) != want {
+			ht.Fatalf("Var(%q, %q) = %v, want pass=%v", s, tag, errs, want)
+		}
+	})
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..9df790e
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,212 @@
+package validator_test
+
+// Pins: one plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and
+// fails while the bug exists; the target lists them as expected failures.
+
+import (
+	"testing"
+	"time"
+
+	"github.com/go-playground/validator/v10"
+)
+
+func passes(t *testing.T, value any, tag string) bool {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("Var(%#v, %q) panicked: %v", value, tag, r)
+		}
+	}()
+	return val.Var(value, tag) == nil
+}
+
+func expectPass(t *testing.T, value any, tag string, want bool) {
+	t.Helper()
+	if got := passes(t, value, tag); got != want {
+		t.Errorf("Var(%#v, %q) pass = %v, want %v", value, tag, got, want)
+	}
+}
+
+// validator/1: numeric parameters are decimal: max=010 is 10 and len=08 is 8.
+func TestHegelPinDecimalParams(t *testing.T) {
+	expectPass(t, 9, "max=010", true)
+	expectPass(t, 10, "max=010", true)
+	expectPass(t, "12345678", "len=08", true)
+	expectPass(t, 9, "eq=09", true)
+}
+
+// validator/2: gtfield and friends measure strings as gt does (in characters).
+func TestHegelPinFieldComparisonCountsRunes(t *testing.T) {
+	type ab struct {
+		A string `validate:"gtfield=B"`
+		B string
+	}
+	// "éé" has 2 characters (4 bytes); "aaa" has 3: A is not longer than B
+	if err := val.Struct(ab{A: "éé", B: "aaa"}); err == nil {
+		t.Errorf("gtfield: 2-character A passed against 3-character B (byte lengths 4 > 3)")
+	}
+	type ab2 struct {
+		A string `validate:"ltfield=B"`
+		B string
+	}
+	if err := val.Struct(ab2{A: "éé", B: "aaa"}); err != nil {
+		t.Errorf("ltfield: 2-character A failed against 3-character B: %v", err)
+	}
+}
+
+type namedTime time.Time
+
+// validator/3: nefield handles a type convertible to time.Time as eqfield does.
+func TestHegelPinNeFieldNamedTime(t *testing.T) {
+	type s struct {
+		A namedTime `validate:"nefield=B"`
+		B namedTime
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("nefield on a named time type panicked: %v", r)
+		}
+	}()
+	err := val.Struct(s{A: namedTime(time.Unix(1, 0)), B: namedTime(time.Unix(2, 0))})
+	if err != nil {
+		t.Errorf("nefield on different named times: %v", err)
+	}
+}
+
+// validator/4: the alpha component of rgba/hsla is any number in [0, 1].
+func TestHegelPinColorAlpha(t *testing.T) {
+	for _, s := range []string{"rgba(0,0,0,0.05)", "rgba(0,0,0,0.50)", "rgba(0,0,0,1.0)", "rgba(0,0,0,.5)"} {
+		expectPass(t, s, "rgba", true)
+	}
+	for _, s := range []string{"rgba(0,0,0,0X)", "rgba(0,0,0,0.)"} {
+		expectPass(t, s, "rgba", false)
+	}
+	expectPass(t, "hsla(0,0%,0%,0.05)", "hsla", true)
+	expectPass(t, "hsla(0,0%,0%,0Z)", "hsla", false)
+}
+
+// validator/5: hostname_port accepts a bracketed IPv6 host as it accepts an IPv4 one.
+func TestHegelPinHostnamePortIPv6(t *testing.T) {
+	expectPass(t, "127.0.0.1:80", "hostname_port", true)
+	expectPass(t, "[::1]:80", "hostname_port", true)
+	expectPass(t, "[2001:db8::1]:443", "hostname_port", true)
+}
+
+// validator/6: a bool in required_if is compared as a bool (as eq does), not as the text "true".
+func TestHegelPinRequiredIfBool(t *testing.T) {
+	type s struct {
+		Flag bool
+		F    string `validate:"required_if=Flag True"`
+	}
+	if err := val.Struct(s{Flag: true}); err == nil {
+		t.Errorf("required_if=Flag True with Flag true and F empty: no error")
+	}
+	type s2 struct {
+		Flag bool
+		F    string `validate:"required_if=Flag 1"`
+	}
+	if err := val.Struct(s2{Flag: true}); err == nil {
+		t.Errorf("required_if=Flag 1 with Flag true and F empty: no error")
+	}
+}
+
+// validator/7: excluded_without takes a list of fields like excluded_with and required_without.
+func TestHegelPinExcludedWithoutList(t *testing.T) {
+	type s struct {
+		A string
+		B string
+		F string `validate:"excluded_without=A B"`
+	}
+	if err := val.Struct(s{A: "a", B: "b", F: "f"}); err != nil {
+		t.Errorf("excluded_without=A B with A and B present and F set: %v", err)
+	}
+	if err := val.Struct(s{F: "f"}); err == nil {
+		t.Errorf("excluded_without=A B with A and B absent and F set: no error")
+	}
+}
+
+// validator/8: a oneof value may contain an apostrophe.
+func TestHegelPinOneOfApostrophe(t *testing.T) {
+	expectPass(t, "don't", "oneof=don't x", true)
+	expectPass(t, "dont", "oneof=don't x", false)
+}
+
+// validator/9: the IPv6 text of an IPv4-mapped address is an IPv6 address, not an IPv4 one.
+func TestHegelPinMappedAddressIsIPv6(t *testing.T) {
+	expectPass(t, "::ffff:192.0.2.1", "ipv4", false)
+	expectPass(t, "::ffff:192.0.2.1", "ipv6", true)
+	expectPass(t, "::ffff:10.0.0.0/104", "cidrv4", false)
+	expectPass(t, "::ffff:10.0.0.0/104", "cidrv6", true)
+}
+
+// validator/10: html_encoded accepts every decimal or hexadecimal character reference.
+func TestHegelPinHTMLEncodedReferences(t *testing.T) {
+	for _, s := range []string{"&#9;", "&#65;", "&#x9;", "&#x41;", "&#128512;"} {
+		expectPass(t, s, "html_encoded", true)
+	}
+	expectPass(t, "&ampx", "html_encoded", false)
+}
+
+// validator/11: SSN area numbers 000, 666 and 900-999 are never issued.
+func TestHegelPinSSNAreas(t *testing.T) {
+	expectPass(t, "123-45-6789", "ssn", true)
+	for _, s := range []string{"000-12-3456", "666-12-3456", "900-12-3456", "999-12-3456"} {
+		expectPass(t, s, "ssn", false)
+	}
+}
+
+// validator/12: unique works on an unexported field under WithPrivateFieldValidation.
+func TestHegelPinUniquePrivateField(t *testing.T) {
+	pv := validator.New(validator.WithPrivateFieldValidation())
+	type s struct {
+		xs []int `validate:"unique"`
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("unique on a private slice panicked: %v", r)
+		}
+	}()
+	if err := pv.Struct(s{xs: []int{1, 2}}); err != nil {
+		t.Errorf("unique on a private slice without duplicates: %v", err)
+	}
+	if err := pv.Struct(s{xs: []int{1, 1}}); err == nil {
+		t.Errorf("unique on a private slice with duplicates: no error")
+	}
+}
+
+// validator/13: FQDN labels do not end in a hyphen (RFC 1123 2.1).
+func TestHegelPinFQDNLabelHyphen(t *testing.T) {
+	expectPass(t, "exa-mple.com", "fqdn", true)
+	expectPass(t, "exa-.com", "fqdn", false)
+	expectPass(t, "example.com-", "fqdn", false)
+}
+
+// validator/14: the documentation says an upper-case UUID does not pass `uuid`.
+func TestHegelPinUUIDUpperCaseDocumented(t *testing.T) {
+	expectPass(t, "6ba7b810-9dad-11d1-80b4-00c04fd430c8", "uuid", true)
+	expectPass(t, "6BA7B810-9DAD-11D1-80B4-00C04FD430C8", "uuid", false)
+	expectPass(t, "6BA7B810-9DAD-11D1-80B4-00C04FD430C8", "uuid_rfc4122", true)
+}
+
+// validator/15: a ULID is 128 bits: its first character is 0-7.
+func TestHegelPinULIDRange(t *testing.T) {
+	expectPass(t, "7ZZZZZZZZZZZZZZZZZZZZZZZZZ", "ulid", true)
+	expectPass(t, "80000000000000000000000000", "ulid", false)
+}
+
+// validator/16: RFC 2397 data URIs need neither a media type nor base64.
+func TestHegelPinDataURIPlain(t *testing.T) {
+	expectPass(t, "data:text/plain;base64,aGVsbG8=", "datauri", true)
+	expectPass(t, "data:text/plain,hello", "datauri", true)
+	expectPass(t, "data:,hello", "datauri", true)
+	expectPass(t, "data:text/plain;charset=utf-8,hello%20world", "datauri", true)
+}
+
+// validator/17: cidrv4 and cidrv6 agree on whether a non-network address is a CIDR.
+func TestHegelPinCIDRHostBitsConsistent(t *testing.T) {
+	v4 := passes(t, "10.1.2.3/8", "cidrv4")
+	v6 := passes(t, "2001:db8::1/32", "cidrv6")
+	if v4 != v6 {
+		t.Errorf("host bits set: cidrv4 pass = %v, cidrv6 pass = %v", v4, v6)
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..d3242d9
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,841 @@
+package validator_test
+
+// Hegel property tests for go-playground/validator, written for the Hegel zoo.
+// See targets/go/validator/README.md.
+//
+// Oracles: the documented semantics of each tag (doc.go and the README), restated as small
+// models: length and value comparisons per kind, cross-field comparisons, the conditional
+// requirement family, string formats built or checked by independent Go code (net/netip,
+// encoding/base64, check-digit arithmetic, unicode tables), and a model of the struct
+// traversal (namespaces, dive, keys, omitempty, or-groups, partial validation).
+//
+// A case is drawn as data: each property draws one record (a value with its kind and a list of
+// tag steps, two fields and a tag, a struct's fields and the names handed to StructPartial)
+// built from the binding's combinators; pure functions render the tag text, and the oracle
+// reads the record.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property().
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/go-playground/validator/v10"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// mutant is 0 for the plain form of a value and 1..n for one of its n mutations, drawn pct
+// percent of the time.
+func mutant(pct, n int) hegel.Generator[int] { return maybe(pct, hegel.Integers(1, n)) }
+
+// runes is a string of lo to hi characters over the pool.
+func runes(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+// fixed is a list of exactly k elements.
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(k).MaxSize(k)
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// nonNil turns the nil slice Lists yields for zero elements into an empty one.
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+// distinct reports whether no element repeats.
+func distinct[T comparable](xs []T) bool {
+	seen := map[T]bool{}
+	for _, x := range xs {
+		if seen[x] {
+			return false
+		}
+		seen[x] = true
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// validator/1: numeric parameters are parsed with base 0, so a leading zero means octal
+	// (max=010 is 8) and 08/09 panic. Generated parameters have no leading zero.
+	octalParams bool
+	// validator/2: gtfield/ltfield/gtefield/ltefield on strings compare byte lengths while
+	// gt/lt/... count runes. Not generated on strings.
+	gtfieldBytes bool
+	// validator/3: nefield panics on a type convertible to time.Time that is not time.Time
+	// (eqfield converts). Cross-field time comparisons use time.Time itself.
+	nefieldNamedTime bool
+	// validator/4: rgba/hsla alpha regex 0.[1-9]* rejects 0.05, 0.50, 1.0, .5 and accepts 0X.
+	// Generated alphas are 0, 1 or 0.<digits 1-9>.
+	alphaRegex bool
+	// validator/5: hostname_port rejects bracketed IPv6 hosts. Only DNS names and IPv4 hosts.
+	hostnamePortIPv6 bool
+	// validator/6: required_if & co compare a bool field with the literal "true" only. Bool
+	// parameters are written true/false.
+	requiredIfBool bool
+	// validator/7: excluded_without takes a single field where its siblings take a list. One
+	// field only.
+	excludedWithoutList bool
+	// validator/8: oneof values cannot contain an apostrophe (all quotes are stripped). No
+	// apostrophes in oneof values.
+	oneofApostrophe bool
+	// validator/9: ipv4/cidrv4 accept the IPv6 text of IPv4-mapped addresses (::ffff:1.2.3.4)
+	// that ipv6 rejects. Mapped addresses are not generated.
+	ipv4Mapped bool
+	// validator/10: html_encoded rejects single-digit references (&#9;). Pin only.
+	htmlEncoded bool
+	// validator/11: ssn accepts area numbers 000, 666 and 900-999. Generated SSNs use valid
+	// areas; invalid ones are not generated.
+	ssnAreas bool
+	// validator/12: unique panics on an unexported field under WithPrivateFieldValidation.
+	// Pin only.
+	uniquePrivate bool
+	// validator/13: fqdn accepts labels ending in a hyphen. Labels never end in "-".
+	fqdnHyphen bool
+	// validator/14: the docs say upper-case UUIDs fail `uuid`; they pass. Upper case is not
+	// generated for uuid/uuid3/4/5.
+	uuidUppercase bool
+	// validator/15: ulid accepts a first character above 7 (a 130-bit value). Generated ULIDs
+	// start with 0-7; the overflow shape is not generated.
+	ulidOverflow bool
+	// validator/16: datauri requires a base64 payload and a media type (RFC 2397 has neither
+	// mandatory). Only base64 data URIs with a media type are generated.
+	datauriPlain bool
+	// validator/17: cidrv4 requires the network address (10.1.2.3/8 fails) while cidrv6 does
+	// not (2001:db8::1/32 passes). IPv6 prefixes are generated masked.
+	cidrv6Unmasked bool
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// --------------------------------------------------------------------------- helpers
+
+var val = validator.New(validator.WithRequiredStructEnabled())
+
+type verr struct{ ns, sns, field, tag, actual, param string }
+
+func (e verr) String() string {
+	return fmt.Sprintf("%s(%s)=%s", e.ns, e.tag, e.param)
+}
+
+// errsOf flattens a validation result: nil for no error, the sorted field errors otherwise; a
+// non-ValidationErrors error is reported in the second value.
+func errsOf(err error) ([]verr, string) {
+	if err == nil {
+		return nil, ""
+	}
+	ves, ok := err.(validator.ValidationErrors)
+	if !ok {
+		return nil, fmt.Sprintf("not ValidationErrors: %T %v", err, err)
+	}
+	var out []verr
+	for _, fe := range ves {
+		out = append(out, verr{fe.Namespace(), fe.StructNamespace(), fe.Field(), fe.Tag(), fe.ActualTag(), fe.Param()})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].ns != out[j].ns {
+			return out[i].ns < out[j].ns
+		}
+		return out[i].tag < out[j].tag
+	})
+	return out, ""
+}
+
+// dynField / structOf: an anonymous struct built at run time so that a property can vary the
+// tags. Its namespace is bare (no type name), so a field's Namespace() is its name.
+type dynField struct {
+	name string
+	val  any
+	tag  string
+}
+
+func structOf(fields ...dynField) any {
+	sf := make([]reflect.StructField, len(fields))
+	for i, f := range fields {
+		tag := ""
+		if f.tag != "" {
+			tag = `validate:"` + f.tag + `"`
+		}
+		sf[i] = reflect.StructField{Name: f.name, Type: reflect.TypeOf(f.val), Tag: reflect.StructTag(tag)}
+	}
+	typ := reflect.StructOf(sf)
+	sv := reflect.New(typ).Elem()
+	for i, f := range fields {
+		sv.Field(i).Set(reflect.ValueOf(f.val))
+	}
+	return sv.Interface()
+}
+
+// wordPool: letters of both cases, digits, a space, punctuation and the non-ASCII characters
+// é, É, ß, 日 and the Arabic-Indic digit ٣; plainPool is the same without the characters a tag
+// parameter cannot hold (comma, pipe, equals, quote, space) and without the upper-case
+// non-ASCII letter.
+const (
+	wordPool  = "abcxyzAZ019 -_.:/\u00e9\u00c9\u00df\u65e5\u0663"
+	plainPool = "abcxyzAZ019-_.:/\u00e9\u00df\u65e5"
+)
+
+// escParam writes a parameter inside a tag: "," as 0x2C and "|" as 0x7C.
+func escParam(s string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(s, ",", "0x2C"), "|", "0x7C")
+}
+
+// --------------------------------------------------------------------------- comparisons
+
+// cmpValue: a value with its measure for the comparison tags (rune count for strings, item
+// count for collections, the number itself otherwise).
+type cmpValue struct {
+	kind    string
+	val     any
+	measure float64
+	str     string
+}
+
+var (
+	smallInts = hegel.Integers(-40, 40)
+	quarters  = hegel.Map(hegel.Integers(-80, 80), func(x int) float64 { return float64(x) / 4 })
+	counts    = hegel.Integers(0, 5)
+)
+
+// cmpValues: one value of each kind the comparison tags accept, the numbers first.
+var cmpValues = hegel.OneOf(
+	hegel.Map(smallInts, func(x int) cmpValue { return cmpValue{"int", x, float64(x), ""} }),
+	hegel.Map(smallInts, func(x int) cmpValue { return cmpValue{"int8", int8(x), float64(x), ""} }),
+	hegel.Map(smallInts, func(x int) cmpValue { return cmpValue{"int64", int64(x), float64(x), ""} }),
+	hegel.Map(hegel.Integers(0, 40), func(x int) cmpValue { return cmpValue{"uint16", uint16(x), float64(x), ""} }),
+	hegel.Map(quarters, func(f float64) cmpValue { return cmpValue{"float64", f, f, ""} }),
+	hegel.Map(quarters, func(f float64) cmpValue { return cmpValue{"float32", float32(f), f, ""} }),
+	hegel.Map(runes(wordPool, 0, 6), func(s string) cmpValue {
+		return cmpValue{"string", s, float64(utf8.RuneCountInString(s)), s}
+	}),
+	hegel.Map(counts, func(k int) cmpValue { return cmpValue{"slice", make([]int, k), float64(k), ""} }),
+	hegel.Map(counts, func(k int) cmpValue {
+		m := map[int]int{}
+		for i := 1; i <= k; i++ {
+			m[i] = i
+		}
+		return cmpValue{"map", m, float64(k), ""}
+	}),
+	hegel.Just(cmpValue{"array", [3]int{}, 3, ""}),
+	hegel.Map(hegel.Integers(0, 40), func(x int) cmpValue {
+		d := time.Duration(x) * time.Second
+		return cmpValue{"duration", d, float64(d), ""}
+	}),
+)
+
+var cmpTags = hegel.SampledFrom([]string{"len", "min", "max", "eq", "ne", "gt", "gte", "lt", "lte"})
+
+// params: a parameter text for tag on v as the tag reads it: a count for strings and
+// collections, a number of the value's type (no leading zeros, validator/1), a duration in
+// seconds or in nanoseconds; string eq/ne take a word, 40% of the time the value itself.
+func params(v cmpValue, tag string) hegel.Generator[string] {
+	itoa := func(g hegel.Generator[int]) hegel.Generator[string] { return hegel.Map(g, strconv.Itoa) }
+	switch v.kind {
+	case "string":
+		if tag == "eq" || tag == "ne" {
+			words := runes(plainPool, 0, 4)
+			if strings.ContainsAny(v.str, ",|=' \"") {
+				return words
+			}
+			return weighted(choice[string]{60, words}, choice[string]{40, hegel.Just(v.str)})
+		}
+		return itoa(hegel.Integers(0, 7))
+	case "slice", "map", "array":
+		return itoa(hegel.Integers(0, 7))
+	case "uint16":
+		return itoa(hegel.Integers(0, 45))
+	case "float64", "float32":
+		return hegel.Map(hegel.Integers(-90, 90), func(x int) string { return strconv.FormatFloat(float64(x)/4, 'f', -1, 64) })
+	case "duration":
+		return hegel.FlatMap(hegel.Integers(0, 45), func(p int) hegel.Generator[string] {
+			ns := time.Duration(p) * time.Second
+			return hegel.OneOf(hegel.Just(fmt.Sprintf("%ds", p)), hegel.Just(strconv.FormatInt(int64(ns), 10)))
+		})
+	default:
+		return itoa(hegel.Integers(-45, 45))
+	}
+}
+
+// expectCmp: the documented verdict of tag=param on c.
+func expectCmp(c cmpValue, tag, param string) bool {
+	if c.kind == "string" && (tag == "eq" || tag == "ne") {
+		return (c.str == param) == (tag == "eq")
+	}
+	var p float64
+	switch c.kind {
+	case "duration":
+		if d, err := time.ParseDuration(param); err == nil {
+			p = float64(d)
+		} else {
+			x, _ := strconv.ParseInt(param, 10, 64)
+			p = float64(x)
+		}
+	default:
+		p, _ = strconv.ParseFloat(param, 64)
+	}
+	m := c.measure
+	switch tag {
+	case "len", "eq":
+		return m == p
+	case "ne":
+		return m != p
+	case "min", "gte":
+		return m >= p
+	case "max", "lte":
+		return m <= p
+	case "gt":
+		return m > p
+	default: // lt
+		return m < p
+	}
+}
+
+// cmpStep is one element of a tag chain: a tag with its parameter, or an a|b group of two.
+type cmpStep struct {
+	text  string // the tag text
+	pass  bool
+	tag   string // Tag() expected on failure
+	param string // Param() expected on failure ("" = not checked)
+}
+
+// singles: one tag with a parameter for v; orGroups: two of them as an a|b group, which passes
+// when either does and is reported as a whole; steps: a single three quarters of the time.
+func singles(v cmpValue) hegel.Generator[cmpStep] {
+	return hegel.FlatMap(cmpTags, func(tag string) hegel.Generator[cmpStep] {
+		return hegel.Map(params(v, tag), func(p string) cmpStep {
+			return cmpStep{tag + "=" + p, expectCmp(v, tag, p), tag, p}
+		})
+	})
+}
+
+func orGroups(v cmpValue) hegel.Generator[cmpStep] {
+	return hegel.Map(pairs(singles(v), singles(v)), func(ab pair[cmpStep, cmpStep]) cmpStep {
+		text := ab.a.text + "|" + ab.b.text
+		return cmpStep{text, ab.a.pass || ab.b.pass, text, ""}
+	})
+}
+
+func steps(v cmpValue) hegel.Generator[cmpStep] {
+	return weighted(choice[cmpStep]{75, singles(v)}, choice[cmpStep]{25, orGroups(v)})
+}
+
+// cmpCase: a value and a chain of one to three steps on it.
+type cmpCase struct {
+	v     cmpValue
+	steps []cmpStep
+}
+
+var cmpCases = hegel.FlatMap(cmpValues, func(v cmpValue) hegel.Generator[cmpCase] {
+	return hegel.Map(hegel.Lists(steps(v)).MinSize(1).MaxSize(3), func(ss []cmpStep) cmpCase { return cmpCase{v, ss} })
+})
+
+// tagText joins the steps with commas; firstFailing is the step the validator should report.
+func (c cmpCase) tagText() string {
+	texts := make([]string, len(c.steps))
+	for i, s := range c.steps {
+		texts[i] = s.text
+	}
+	return strings.Join(texts, ",")
+}
+
+func (c cmpCase) firstFailing() *cmpStep {
+	for i := range c.steps {
+		if !c.steps[i].pass {
+			return &c.steps[i]
+		}
+	}
+	return nil
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c cmpCase) GoString() string {
+	return fmt.Sprintf("%s %#v with %q", c.v.kind, c.v.val, c.tagText())
+}
+
+// TestHegelComparisonsFollowTheModel: len/min/max/eq/ne/gt/gte/lt/lte on strings (rune
+// count), numbers, durations and collections (item count), alone, chained with "," (the first
+// failing tag is reported) and in "|" groups (any passing alternative passes), through Var and
+// through a struct field.
+func TestHegelComparisonsFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, cmpCases)
+		v, tag := tcase.v, tcase.tagText()
+		first := tcase.firstFailing()
+
+		errs, bad := errsOf(val.Var(v.val, tag))
+		if bad != "" {
+			ht.Fatalf("Var(%#v, %q): %s", v.val, tag, bad)
+		}
+		if first == nil {
+			if len(errs) != 0 {
+				ht.Fatalf("Var(%#v, %q) = %v, want no error", v.val, tag, errs)
+			}
+		} else if len(errs) != 1 || errs[0].tag != first.tag || (first.param != "" && errs[0].param != first.param) {
+			ht.Fatalf("Var(%#v, %q) = %v, want one error on %s (param %q)", v.val, tag, errs, first.tag, first.param)
+		}
+		// the same tag on a struct field
+		serrs, bad := errsOf(val.Struct(structOf(dynField{"F", v.val, tag})))
+		if bad != "" {
+			ht.Fatalf("Struct{F %#v %q}: %s", v.val, tag, bad)
+		}
+		if len(serrs) != len(errs) {
+			ht.Fatalf("Struct{F %#v %q} = %v, Var gives %v", v.val, tag, serrs, errs)
+		}
+		if len(serrs) == 1 && (serrs[0].ns != "F" || serrs[0].field != "F" || serrs[0].tag != errs[0].tag) {
+			ht.Fatalf("Struct{F %#v %q} = %+v, want namespace F and tag %s", v.val, tag, serrs[0], errs[0].tag)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- cross-field
+
+// xValue: a field value for the cross-field tags, with its number (times as Unix seconds) or
+// its text.
+type xValue struct {
+	kind string
+	val  any
+	num  float64
+	str  string
+}
+
+var xKinds = []string{"int", "uint", "float64", "string", "time", "slice"}
+
+var xTags = hegel.SampledFrom([]string{"eqfield", "nefield", "gtfield", "gtefield", "ltfield", "ltefield"})
+
+// xValues draws a small value of the kind.
+func xValues(kind string) hegel.Generator[xValue] {
+	switch kind {
+	case "int":
+		return hegel.Map(hegel.Integers(-5, 5), func(x int) xValue { return xValue{kind: kind, val: x, num: float64(x)} })
+	case "uint":
+		return hegel.Map(hegel.Integers(0, 5), func(x int) xValue { return xValue{kind: kind, val: uint(x), num: float64(x)} })
+	case "float64":
+		return hegel.Map(hegel.Integers(-10, 10), func(x int) xValue {
+			f := float64(x) / 2
+			return xValue{kind: kind, val: f, num: f}
+		})
+	case "string":
+		return hegel.Map(runes("ab\u00e9", 0, 3), func(s string) xValue { return xValue{kind: kind, val: s, str: s} })
+	case "time":
+		return hegel.Map(hegel.Integers(0, 3), func(s int) xValue {
+			tm := time.Date(2024, 1, 1, 0, 0, s, 0, time.UTC)
+			return xValue{kind: kind, val: tm, num: float64(tm.Unix())}
+		})
+	default: // slice
+		return hegel.Map(hegel.Integers(0, 3), func(k int) xValue { return xValue{kind: kind, val: make([]int, k), num: float64(k)} })
+	}
+}
+
+// ordered reports whether the tag is one of the four ordered comparisons.
+func ordered(tag string) bool { return tag != "eqfield" && tag != "nefield" }
+
+// xCase: a tag and the two fields it compares, of the same kind 85% of the time. The ordered
+// tags are unspecified for two strings (byte length against rune count, validator/2) and two
+// slices (reflect's String() of a slice), so a string or slice A under an ordered tag gets a
+// B of another kind.
+type xCase struct {
+	tag  string
+	a, b xValue
+}
+
+var xCases = hegel.FlatMap(xTags, func(tag string) hegel.Generator[xCase] {
+	return hegel.FlatMap(hegel.SampledFrom(xKinds), func(ka string) hegel.Generator[xCase] {
+		kbs := weighted(choice[string]{85, hegel.Just(ka)}, choice[string]{15, hegel.SampledFrom(xKinds)})
+		if ordered(tag) && (ka == "string" || ka == "slice") {
+			var others []string
+			for _, k := range xKinds {
+				if k != ka {
+					others = append(others, k)
+				}
+			}
+			kbs = hegel.SampledFrom(others)
+		}
+		return hegel.FlatMap(kbs, func(kb string) hegel.Generator[xCase] {
+			return hegel.Map(pairs(xValues(ka), xValues(kb)), func(ab pair[xValue, xValue]) xCase { return xCase{tag, ab.a, ab.b} })
+		})
+	})
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c xCase) GoString() string {
+	return fmt.Sprintf("%s: A %s %#v, B %s %#v", c.tag, c.a.kind, c.a.val, c.b.kind, c.b.val)
+}
+
+// expectX: the documented comparison of a with b; ok=false when the pair is left unspecified.
+func expectX(a, b xValue, tag string) (want bool, ok bool) {
+	if a.kind != b.kind {
+		// different kinds: eqfield and the ordered tags fail, nefield passes
+		return tag == "nefield", true
+	}
+	var cmp int
+	switch a.kind {
+	case "string":
+		if ordered(tag) {
+			return false, false // byte length vs rune count (validator/2)
+		}
+		cmp = strings.Compare(a.str, b.str)
+	case "slice":
+		if ordered(tag) {
+			return false, false // reflect.Value.String() of slices; unspecified
+		}
+		cmp = int(a.num - b.num)
+	default:
+		switch {
+		case a.num < b.num:
+			cmp = -1
+		case a.num > b.num:
+			cmp = 1
+		}
+	}
+	switch tag {
+	case "eqfield":
+		return cmp == 0, true
+	case "nefield":
+		return cmp != 0, true
+	case "gtfield":
+		return cmp > 0, true
+	case "gtefield":
+		return cmp >= 0, true
+	case "ltfield":
+		return cmp < 0, true
+	default:
+		return cmp <= 0, true
+	}
+}
+
+// TestHegelCrossFieldFollowsTheModel: eqfield/nefield/gtfield/gtefield/ltfield/ltefield on
+// two fields of the same kind (numbers, time.Time, strings and slices for eq/ne) and of
+// different kinds, through VarWithValue and through a struct.
+func TestHegelCrossFieldFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, xCases)
+		a, b, tag := tcase.a, tcase.b, tcase.tag
+		want, ok := expectX(a, b, tag)
+		ht.Assume(ok) // the generator keeps the unspecified pairs out
+		errs, bad := errsOf(val.VarWithValue(a.val, b.val, tag))
+		if bad != "" {
+			ht.Fatalf("VarWithValue(%#v, %#v, %s): %s", a.val, b.val, tag, bad)
+		}
+		if (len(errs) == 0) != want {
+			ht.Fatalf("VarWithValue(%#v, %#v, %s) = %v, want pass=%v", a.val, b.val, tag, errs, want)
+		}
+		serrs, bad := errsOf(val.Struct(structOf(dynField{"A", a.val, tag + "=B"}, dynField{"B", b.val, ""})))
+		if bad != "" {
+			ht.Fatalf("Struct{A %#v %s=B; B %#v}: %s", a.val, tag, b.val, bad)
+		}
+		if (len(serrs) == 0) != want || (len(serrs) == 1 && (serrs[0].ns != "A" || serrs[0].tag != tag || serrs[0].param != "B")) {
+			ht.Fatalf("Struct{A %#v %s=B; B %#v} = %v, want pass=%v (error on A with param B)", a.val, tag, b.val, serrs, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- conditional requirements
+
+// other: the "other" field of a conditional requirement, a parameter text for it, and whether
+// the field equals the parameter under the documented reading.
+type other struct {
+	kind  string
+	val   any
+	param string
+	eq    bool
+}
+
+// others: a string, an int, a bool (parameters written true/false, validator/6), a pointer
+// (nil half the time) or a slice (nil 40% of the time) beside a parameter that may or may not
+// name its value.
+var others = hegel.OneOf(
+	hegel.Map(pairs(hegel.SampledFrom([]string{"", "x", "y", "ab"}), hegel.SampledFrom([]string{"x", "y", "ab"})), func(sp pair[string, string]) other {
+		return other{"string", sp.a, sp.b, sp.a == sp.b}
+	}),
+	hegel.Map(pairs(hegel.Integers(0, 3), hegel.Integers(0, 3)), func(xp pair[int, int]) other {
+		return other{"int", xp.a, strconv.Itoa(xp.b), xp.a == xp.b}
+	}),
+	hegel.Map(pairs(hegel.Booleans(), hegel.SampledFrom([]string{"true", "false"})), func(bp pair[bool, string]) other {
+		return other{"bool", bp.a, bp.b, strconv.FormatBool(bp.a) == bp.b}
+	}),
+	hegel.Map(pairs(
+		hegel.OneOf(hegel.Just((*string)(nil)), hegel.Map(hegel.SampledFrom([]string{"", "x", "y"}), ptrTo[string])),
+		hegel.SampledFrom([]string{"nil", "x", "y"}),
+	), func(sp pair[*string, string]) other {
+		s, p := sp.a, sp.b
+		eq := (s == nil && p == "nil") || (s != nil && p != "nil" && *s == p)
+		return other{"ptr", s, p, eq}
+	}),
+	hegel.Map(pairs(
+		weighted(choice[[]int]{40, hegel.Just([]int(nil))}, choice[[]int]{60, hegel.Map(hegel.Integers(0, 2), func(k int) []int { return make([]int, k) })}),
+		hegel.SampledFrom([]string{"nil", "0", "1", "2"}),
+	), func(xp pair[[]int, string]) other {
+		xs, p := xp.a, xp.b
+		eq := xs == nil
+		if p != "nil" {
+			eq = strconv.Itoa(len(xs)) == p
+		}
+		return other{"slice", xs, p, eq}
+	}),
+)
+
+var condTags = []string{"required_if", "required_unless", "excluded_if", "excluded_unless",
+	"required_with", "required_with_all", "required_without", "required_without_all",
+	"excluded_with", "excluded_with_all", "excluded_without", "excluded_without_all"}
+
+// condCase: the tag on a string field F, the Other field, the two string fields A and B the
+// _with/_without tags name (a single one 30% of the time), and F's own value.
+type condCase struct {
+	other   other
+	a, b, f string
+	tag     string
+	single  bool
+}
+
+var condCases = hegel.Composite(func(tc hegel.TestCase) condCase {
+	return condCase{
+		other:  hegel.Draw(tc, others),
+		a:      hegel.Draw(tc, hegel.SampledFrom([]string{"", "a"})),
+		b:      hegel.Draw(tc, hegel.SampledFrom([]string{"", "b"})),
+		f:      hegel.Draw(tc, hegel.SampledFrom([]string{"", "f"})),
+		tag:    hegel.Draw(tc, hegel.SampledFrom(condTags)),
+		single: hegel.Draw(tc, chance(30)),
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c condCase) GoString() string {
+	return fmt.Sprintf("%s: Other %s %#v (param %q), A %q, B %q, F %q, single %v", c.tag, c.other.kind, c.other.val, c.other.param, c.a, c.b, c.f, c.single)
+}
+
+// TestHegelConditionalRequirementsFollowTheModel: the required_*/excluded_* family on a string
+// field F next to an Other field (string, int, bool, pointer, slice) and two string fields A
+// and B, against the documented conditions.
+func TestHegelConditionalRequirementsFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, condCases)
+		o, a, b, f, tag := tcase.other, tcase.a, tcase.b, tcase.f, tcase.tag
+		present := f != ""
+		aPresent, bPresent := a != "", b != ""
+		var text string
+		var wantErr bool
+		list := "A B"
+		if tcase.single || (tag == "excluded_without" && Known.excludedWithoutList) {
+			list = "A"
+			bPresent = aPresent // one field: "any"/"all" collapse to A
+		}
+		switch tag {
+		case "required_if":
+			text, wantErr = tag+"=Other "+o.param, o.eq && !present
+		case "required_unless":
+			text, wantErr = tag+"=Other "+o.param, !o.eq && !present
+		case "excluded_if":
+			text, wantErr = tag+"=Other "+o.param, o.eq && present
+		case "excluded_unless":
+			text, wantErr = tag+"=Other "+o.param, !o.eq && present
+		case "required_with":
+			text, wantErr = tag+"="+list, (aPresent || bPresent) && !present
+		case "required_with_all":
+			text, wantErr = tag+"="+list, aPresent && bPresent && !present
+		case "required_without":
+			text, wantErr = tag+"="+list, (!aPresent || !bPresent) && !present
+		case "required_without_all":
+			text, wantErr = tag+"="+list, !aPresent && !bPresent && !present
+		case "excluded_with":
+			text, wantErr = tag+"="+list, (aPresent || bPresent) && present
+		case "excluded_with_all":
+			text, wantErr = tag+"="+list, aPresent && bPresent && present
+		case "excluded_without":
+			text, wantErr = tag+"="+list, (!aPresent || !bPresent) && present
+		default: // excluded_without_all
+			text, wantErr = tag+"="+list, !aPresent && !bPresent && present
+		}
+		s := structOf(dynField{"Other", o.val, ""}, dynField{"A", a, ""}, dynField{"B", b, ""}, dynField{"F", f, text})
+		errs, bad := errsOf(val.Struct(s))
+		if bad != "" {
+			ht.Fatalf("%+v with F %q: %s", s, text, bad)
+		}
+		if wantErr {
+			if len(errs) != 1 || errs[0].ns != "F" || errs[0].tag != tag {
+				ht.Fatalf("%+v with F `%s` = %v, want one error on F (%s)", s, text, errs, tag)
+			}
+		} else if len(errs) != 0 {
+			ht.Fatalf("%+v with F `%s` = %v, want no error", s, text, errs)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- unique
+
+// uniqueRec is an element of a slice validated with unique=Name.
+type uniqueRec struct {
+	ID   int
+	Name string
+}
+
+// uniqueCase: a collection, the unique tag for it and whether it holds.
+type uniqueCase struct {
+	kind  string
+	value any
+	tag   string
+	want  bool
+}
+
+var (
+	fewInts = hegel.Integers(0, 4)
+	// nilOrPtrs: nil pointers a quarter of the time (two of them are duplicates), else a
+	// pointer to a small int
+	nilOrPtrs  = weighted(choice[*int]{25, hegel.Just((*int)(nil))}, choice[*int]{75, hegel.Map(fewInts, ptrTo[int])})
+	uniqueRecs = hegel.Map(pairs(hegel.Integers(0, 9), hegel.SampledFrom([]string{"a", "b", "c"})), func(p pair[int, string]) uniqueRec {
+		return uniqueRec{p.a, p.b}
+	})
+)
+
+// uniqueCases: slices of ints, strings, pointers and structs (unique=Name) and a map, up to
+// five elements each.
+var uniqueCases = hegel.OneOf(
+	hegel.Map(hegel.Lists(fewInts).MaxSize(5), func(xs []int) uniqueCase {
+		return uniqueCase{"ints", xs, "unique", distinct(xs)}
+	}),
+	hegel.Map(hegel.Lists(hegel.SampledFrom([]string{"", "a", "b", "\u00e9"})).MaxSize(5), func(xs []string) uniqueCase {
+		return uniqueCase{"strings", xs, "unique", distinct(xs)}
+	}),
+	hegel.Map(hegel.Lists(nilOrPtrs).MaxSize(5), func(xs []*int) uniqueCase {
+		var vals []int
+		nils := 0
+		for _, p := range xs {
+			if p == nil {
+				nils++
+			} else {
+				vals = append(vals, *p)
+			}
+		}
+		return uniqueCase{"ptrs", xs, "unique", distinct(vals) && nils <= 1}
+	}),
+	hegel.Map(hegel.Lists(uniqueRecs).MaxSize(5), func(xs []uniqueRec) uniqueCase {
+		names := make([]string, len(xs))
+		for i, r := range xs {
+			names[i] = r.Name
+		}
+		return uniqueCase{"structs", xs, "unique=Name", distinct(names)}
+	}),
+	hegel.Map(hegel.Lists(fewInts).MaxSize(5), func(xs []int) uniqueCase {
+		m := map[string]int{}
+		for i, x := range xs {
+			m[strconv.Itoa(i)] = x
+		}
+		return uniqueCase{"map", m, "unique", distinct(xs)}
+	}),
+)
+
+// GoString is what the draw report prints (it uses %#v).
+func (c uniqueCase) GoString() string {
+	return fmt.Sprintf("%s %#v with %s, want pass=%v", c.kind, c.value, c.tag, c.want)
+}
+
+// TestHegelUniqueFollowsTheModel: unique on slices (of values, pointers and structs with a
+// field parameter) and on map values.
+func TestHegelUniqueFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, uniqueCases)
+		errs, bad := errsOf(val.Var(tcase.value, tcase.tag))
+		if bad != "" {
+			ht.Fatalf("Var(%#v, %s): %s", tcase.value, tcase.tag, bad)
+		}
+		if (len(errs) == 0) != tcase.want {
+			ht.Fatalf("Var(%#v, %s) = %v, want pass=%v", tcase.value, tcase.tag, errs, tcase.want)
+		}
+	})
+}
diff --git a/hegel_traversal_test.go b/hegel_traversal_test.go
new file mode 100644
index 0000000..491ce0b
--- /dev/null
+++ b/hegel_traversal_test.go
@@ -0,0 +1,261 @@
+package validator_test
+
+// Struct traversal against a model: namespaces, nested structs and pointers, dive over slices
+// and maps with keys/endkeys, omitempty, or-groups, required on pointers, StructPartial and
+// StructExcept.
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+type Leaf struct {
+	S string `validate:"required"`
+	N int    `validate:"min=1"`
+}
+
+type Doc struct {
+	Name  string         `validate:"required,min=2"`
+	Tags  []string       `validate:"omitempty,dive,alpha"`
+	Attrs map[string]int `validate:"dive,keys,alpha,endkeys,gte=0"`
+	Leaf  Leaf
+	PLeaf *Leaf  `validate:"omitempty"`
+	Req   *Leaf  `validate:"required"`
+	Items []Leaf `validate:"dive"`
+	Alt   string `validate:"omitempty,alpha|numeric"`
+	Nums  []int  `validate:"max=3,dive,gt=0"`
+	Skip  string `validate:"-"`
+}
+
+func isAlphaASCII(s string) bool {
+	return s != "" && all(s, func(r rune) bool { return r < 128 && unicode.IsLetter(r) })
+}
+
+// --------------------------------------------------------------------------- the document
+
+var (
+	// leafs: an empty, a plain and a non-ASCII S beside an N around the minimum
+	leafs = hegel.Map(pairs(hegel.SampledFrom([]string{"", "s", "\u00e9"}), hegel.Integers(-1, 2)), func(p pair[string, int]) Leaf {
+		return Leaf{p.a, p.b}
+	})
+	// tagLists: nil 40% of the time, else up to three words, some not alphabetic
+	tagLists = maybe(60, hegel.Map(hegel.Lists(hegel.SampledFrom([]string{"a", "bc", "", "1", "\u00e9"})).MaxSize(3), nonNil[string]))
+	// attrMaps: nil 40% of the time, else up to three keys, some not alphabetic, with values
+	// around the minimum
+	attrMaps = maybe(60, hegel.Maps(hegel.SampledFrom([]string{"k", "key", "k1", "", "\u00e9"}), hegel.Integers(-1, 1)).MaxSize(3))
+	// numLists: nil 30% of the time, else up to five numbers around the minimum (more than
+	// three trip max=3 before dive)
+	numLists = maybe(70, hegel.Map(hegel.Lists(hegel.Integers(-1, 2)).MaxSize(5), nonNil[int]))
+	// reqLeafs: the required pointer, nil 30% of the time
+	reqLeafs = weighted(choice[*Leaf]{30, hegel.Just((*Leaf)(nil))}, choice[*Leaf]{70, hegel.Map(leafs, ptrTo[Leaf])})
+	docs     = hegel.Composite(func(tc hegel.TestCase) Doc {
+		return Doc{
+			Name:  hegel.Draw(tc, hegel.SampledFrom([]string{"", "a", "ab", "\u65e5\u672c"})),
+			Tags:  hegel.Draw(tc, tagLists),
+			Attrs: hegel.Draw(tc, attrMaps),
+			Leaf:  hegel.Draw(tc, leafs),
+			PLeaf: hegel.Draw(tc, hegel.Optional(leafs)),
+			Req:   hegel.Draw(tc, reqLeafs),
+			Items: hegel.Draw(tc, hegel.Lists(leafs).MaxSize(3)),
+			Alt:   hegel.Draw(tc, hegel.SampledFrom([]string{"", "abc", "123", "a1", "-"})),
+			Nums:  hegel.Draw(tc, numLists),
+			Skip:  hegel.Draw(tc, hegel.SampledFrom([]string{"", "x"})),
+		}
+	})
+)
+
+var docFields = []string{"Name", "Tags", "Attrs", "Leaf", "PLeaf", "Req", "Items", "Alt", "Nums", "Skip"}
+
+// chosenFields: each top-level field named 40% of the time, for StructPartial and StructExcept.
+var chosenFields = hegel.Map(fixed(chance(40), len(docFields)), func(on []bool) []string {
+	var fs []string
+	for i, b := range on {
+		if b {
+			fs = append(fs, docFields[i])
+		}
+	}
+	return fs
+})
+
+// traversalCase: a document and the fields named to StructPartial and StructExcept.
+type traversalCase struct {
+	doc    Doc
+	chosen []string
+}
+
+var traversalCases = hegel.Map(pairs(docs, chosenFields), func(p pair[Doc, []string]) traversalCase {
+	return traversalCase{p.a, p.b}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c traversalCase) GoString() string {
+	d := c.doc
+	pleaf, req := "nil", "nil"
+	if d.PLeaf != nil {
+		pleaf = fmt.Sprintf("%+v", *d.PLeaf)
+	}
+	if d.Req != nil {
+		req = fmt.Sprintf("%+v", *d.Req)
+	}
+	return fmt.Sprintf("Doc{Name %q, Tags %q, Attrs %v, Leaf %+v, PLeaf %s, Req %s, Items %+v, Alt %q, Nums %v, Skip %q} with fields %q",
+		d.Name, d.Tags, d.Attrs, d.Leaf, pleaf, req, d.Items, d.Alt, d.Nums, d.Skip, c.chosen)
+}
+
+// --------------------------------------------------------------------------- the model
+
+// modelErrors: the (namespace, tag) pairs the documented rules produce for d.
+func modelErrors(d Doc) []string {
+	var out []string
+	add := func(ns, tag string) { out = append(out, ns+"("+tag+")") }
+	leaf := func(ns string, l Leaf) {
+		if l.S == "" {
+			add(ns+".S", "required")
+		}
+		if l.N < 1 {
+			add(ns+".N", "min")
+		}
+	}
+	switch {
+	case d.Name == "":
+		add("Doc.Name", "required")
+	case utf8.RuneCountInString(d.Name) < 2:
+		add("Doc.Name", "min")
+	}
+	for i, t := range d.Tags {
+		if !isAlphaASCII(t) {
+			add("Doc.Tags["+strconv.Itoa(i)+"]", "alpha")
+		}
+	}
+	for k, v := range d.Attrs {
+		if !isAlphaASCII(k) {
+			add("Doc.Attrs["+k+"]", "alpha")
+		}
+		if v < 0 {
+			add("Doc.Attrs["+k+"]", "gte")
+		}
+	}
+	leaf("Doc.Leaf", d.Leaf)
+	if d.PLeaf != nil {
+		leaf("Doc.PLeaf", *d.PLeaf)
+	}
+	if d.Req == nil {
+		add("Doc.Req", "required")
+	} else {
+		leaf("Doc.Req", *d.Req)
+	}
+	for i, l := range d.Items {
+		leaf("Doc.Items["+strconv.Itoa(i)+"]", l)
+	}
+	if d.Alt != "" && !isAlphaASCII(d.Alt) && !all(d.Alt, unicode.IsDigit) {
+		add("Doc.Alt", "alpha|numeric")
+	}
+	if len(d.Nums) > 3 {
+		add("Doc.Nums", "max")
+	} else {
+		for i, x := range d.Nums {
+			if x <= 0 {
+				add("Doc.Nums["+strconv.Itoa(i)+"]", "gt")
+			}
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func gotErrors(err error) ([]string, string) {
+	errs, bad := errsOf(err)
+	if bad != "" {
+		return nil, bad
+	}
+	var out []string
+	for _, e := range errs {
+		out = append(out, e.ns+"("+e.tag+")")
+	}
+	sort.Strings(out)
+	return out, ""
+}
+
+func filterTop(errs []string, keep func(field string) bool) []string {
+	var out []string
+	for _, e := range errs {
+		f := strings.TrimPrefix(e, "Doc.")
+		f = strings.SplitN(f, ".", 2)[0]
+		f = strings.SplitN(f, "[", 2)[0]
+		f = strings.SplitN(f, "(", 2)[0]
+		if keep(f) {
+			out = append(out, e)
+		}
+	}
+	return out
+}
+
+// TestHegelTraversalFollowsTheModel: Struct on a generated Doc reports exactly the model's
+// (namespace, tag) pairs; StructExcept on top-level field names drops exactly those fields'
+// errors and StructPartial keeps the named fields' own errors (a named struct's inner fields
+// are not validated, as upstream's tests expect); Namespace/StructNamespace/Field agree on this
+// un-renamed type.
+func TestHegelTraversalFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, traversalCases)
+		d, chosen := tcase.doc, tcase.chosen
+		want := modelErrors(d)
+		got, bad := gotErrors(val.Struct(d))
+		if bad != "" {
+			ht.Fatalf("Struct(%+v): %s", d, bad)
+		}
+		if !reflect.DeepEqual(got, want) {
+			ht.Fatalf("Struct(%+v) = %v, want %v", d, got, want)
+		}
+		// pointer to the struct: the same
+		if got2, _ := gotErrors(val.Struct(&d)); !reflect.DeepEqual(got2, want) {
+			ht.Fatalf("Struct(&doc) = %v, Struct(doc) = %v", got2, want)
+		}
+		// error accessors on the plain type
+		errs, _ := errsOf(val.Struct(d))
+		for _, e := range errs {
+			if e.ns != e.sns || e.actual != e.tag {
+				ht.Fatalf("error %+v: Namespace %q vs StructNamespace %q, Tag %q vs ActualTag %q", e, e.ns, e.sns, e.tag, e.actual)
+			}
+			last := e.ns[strings.LastIndex(e.ns, ".")+1:]
+			if e.field != last {
+				ht.Fatalf("error %+v: Field %q, want the last namespace segment %q", e, e.field, last)
+			}
+		}
+		// partial and except on top-level fields
+		in := map[string]bool{}
+		for _, f := range chosen {
+			in[f] = true
+		}
+		gotP, bad := gotErrors(val.StructPartial(d, chosen...))
+		if bad != "" {
+			ht.Fatalf("StructPartial: %s", bad)
+		}
+		// a struct field named alone contributes its own tags only, not its inner fields
+		// (upstream's TestStructPartial names "Sub" and expects nothing inside it validated)
+		var wantP []string
+		for _, e := range filterTop(want, func(f string) bool { return in[f] }) {
+			ns := e[:strings.Index(e, "(")]
+			if strings.Count(ns, ".") == 1 {
+				wantP = append(wantP, e)
+			}
+		}
+		if !reflect.DeepEqual(gotP, wantP) {
+			ht.Fatalf("StructPartial(%+v, %v) = %v, want %v", d, chosen, gotP, wantP)
+		}
+		gotE, bad := gotErrors(val.StructExcept(d, chosen...))
+		if bad != "" {
+			ht.Fatalf("StructExcept: %s", bad)
+		}
+		if wantE := filterTop(want, func(f string) bool { return !in[f] }); !reflect.DeepEqual(gotE, wantE) {
+			ht.Fatalf("StructExcept(%+v, %v) = %v, want %v", d, chosen, gotE, wantE)
+		}
+	})
+}
