+	{"jwt", func(tc hegel.TestCase) (any, bool) {
+		part := func(lo int) string { return genRunes(tc, []rune("abcXYZ019-_"), lo, 8) }
+		s := part(1) + "." + part(1) + "." + part(0)
+		switch n(tc, 0, 6) {
+		case 0:
