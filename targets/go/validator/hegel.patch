+	// semvers: three numbers, a pre-release (two with leading zeros, not valid) and a build 30%
+	// of the time each; 30% of the time a leading zero, a "v" or only two numbers
+	semvers = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		nums := hegel.Draw(tc, fixed(hegel.Integers(0, 30), 3))
+		pre := hegel.Draw(tc, maybe(30, hegel.SampledFrom([]string{"alpha", "rc.1", "0.3.7", "x-y", "01", "beta.02"})))
