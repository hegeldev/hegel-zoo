+	latitudes = hegel.Map(pairs(hegel.Integers(-95000, 95000), chance(30)), func(p pair[int, bool]) fmtValue {
+		f := float64(p.a) / 1000
+		return coordinate(f, p.b, f >= -90 && f <= 90)
+	})
+	longitudes = hegel.Map(pairs(hegel.Integers(-185000, 185000), chance(30)), func(p pair[int, bool]) fmtValue {
+		f := float64(p.a) / 1000
