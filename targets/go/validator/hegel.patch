+		return fv(base64.URLEncoding.EncodeToString(b), len(b) > 0)
+	})
+	base64rawurls = hegel.Map(pairs(words, chance(30)), func(p pair[string, bool]) fmtValue {
+		b := []byte(p.a)
+		if p.b {
+			s := base64.URLEncoding.EncodeToString(b)
