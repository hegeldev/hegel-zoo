+package validator_test
+
+// String-format tags against independent constructions: a value is built to be valid (or
+// mutated to be invalid) by code that does not share the validator's regular expressions. Each
+// tag has a generator of (value, verdict) pairs; the parts of a value are drawn as a small
+// record and rendered by the generator's pure tail.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	_ "time/tzdata"
+	"unicode"
+
+	"hegel.dev/go/hegel"
+)
+
+// fmtValue: a value for a format tag and whether the tag should accept it.
+type fmtValue struct {
+	value any
+	want  bool
+}
+
+func fv(value any, want bool) fmtValue { return fmtValue{value, want} }
+
+// fmtCase: a tag with the generator of its values.
+type fmtCase struct {
+	tag string
+	gen hegel.Generator[fmtValue]
+}
+
+// classified: the strings of g, accepted when ok holds.
+func classified(g hegel.Generator[string], ok func(string) bool) hegel.Generator[fmtValue] {
+	return hegel.Map(g, func(s string) fmtValue { return fv(s, ok(s)) })
+}
+
+const (
+	digitPool = "0123456789"
+	hexPool   = "0123456789abcdef"
+	// mixedPool: letters of both cases, digits, blanks, punctuation and the non-ASCII letters
+	// é, É, ß, 日 and the Arabic-Indic digit ٣, so the character classes see every side
+	mixedPool = "abXZ019 \t-+._\u00e9\u00c9\u00df\u65e5\u0663"
+	crockford = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
+)
+
+var mixedText = runes(mixedPool, 0, 6)
+
+func digits(k int) hegel.Generator[string] { return runes(digitPool, k, k) }
+
+func hexs(k int) hegel.Generator[string] { return runes(hexPool, k, k) }
+
+// labels: a DNS label of lo to hi characters over letters, digits and hyphens, trimmed of
+// leading and trailing hyphens (validator/13), "a" when nothing is left.
+func labels(lo, hi int) hegel.Generator[string] {
+	return hegel.Map(runes("abcz019-", lo, hi), func(s string) string {
+		s = strings.Trim(s, "-")
+		if s == "" {
+			return "a"
+		}
+		return s
+	})
+}
+
+func all(s string, f func(rune) bool) bool {
+	for _, r := range s {
+		if !f(r) {
+			return false
+		}
+	}
+	return true
+}
+
+func isASCII(r rune) bool { return r < 128 }
+
+func isNumeric(s string) bool { // [-+]?[0-9]+(.[0-9]+)?
+	if strings.HasPrefix(s, "-") || strings.HasPrefix(s, "+") {
+		s = s[1:]
+	}
+	parts := strings.Split(s, ".")
+	if len(parts) > 2 {
+		return false
+	}
+	for _, p := range parts {
+		if p == "" || !all(p, func(r rune) bool { return r >= '0' && r <= '9' }) {
+			return false
+		}
+	}
+	return true
+}
+
+func isHexDigits(s string) bool {
+	return s != "" && all(s, func(r rune) bool { return strings.ContainsRune("0123456789abcdefABCDEF", r) })
+}
+
+func luhnCheck(digits string) byte { // the check digit that makes digits+check pass Luhn
+	sum := 0
+	double := true
+	for i := len(digits) - 1; i >= 0; i-- {
+		d := int(digits[i] - '0')
+		if double {
+			d *= 2
+			if d > 9 {
+				d -= 9
+			}
+		}
+		sum += d
+		double = !double
+	}
+	return byte('0' + (10-sum%10)%10)
+}
+
+// wrongCheck is a check digit other than check ('X' becomes '0').
+func wrongCheck(check byte) byte {
+	if check == 'X' {
+		return '0'
+	}
+	return byte('0' + (int(check-'0')+1)%10)
+}
+
+func isbn10Check(d string) byte {
+	sum := 0
+	for i := 0; i < 9; i++ {
+		sum += (i + 1) * int(d[i]-'0')
+	}
+	if r := sum % 11; r == 10 {
+		return 'X'
+	} else {
+		return byte('0' + r)
+	}
+}
+
+func isbn13Check(d string) byte {
+	sum := 0
+	for i := 0; i < 12; i++ {
+		w := 1
+		if i%2 == 1 {
+			w = 3
+		}
+		sum += w * int(d[i]-'0')
+	}
+	return byte('0' + (10-sum%10)%10)
+}
+
+func issnCheck(d string) byte {
+	sum := 0
+	for i := 0; i < 7; i++ {
+		sum += (8 - i) * int(d[i]-'0')
+	}
+	r := (11 - sum%11) % 11
+	if r == 10 {
+		return 'X'
+	}
+	return byte('0' + r)
+}
+
+// --------------------------------------------------------------------------- addresses
+
+// v6Bytes: a pool that makes :: runs and ff bytes likely.
+var v6Bytes = hegel.SampledFrom([]int{0, 0, 0, 1, 255, 0x20, 0xdb})
+
+// v6First: the first byte of an IPv6 address; never 0 while validator/9 stands, so that no
+// IPv4-mapped address (::ffff:a.b.c.d) is drawn.
+var v6First = func() hegel.Generator[int] {
+	if Known.ipv4Mapped {
+		return hegel.Integers(1, 255)
+	}
+	return v6Bytes
+}()
+
+var (
+	v4Addrs = hegel.Map(fixed(hegel.Integers(0, 255), 4), func(bs []int) netip.Addr {
+		var b [4]byte
+		for i, x := range bs {
+			b[i] = byte(x)
+		}
+		return netip.AddrFrom4(b)
+	})
+	v6Addrs = hegel.Map(pairs(v6First, fixed(v6Bytes, 15)), func(p pair[int, []int]) netip.Addr {
+		var b [16]byte
+		b[0] = byte(p.a)
+		for i, x := range p.b {
+			b[i+1] = byte(x)
+		}
+		return netip.AddrFrom16(b)
+	})
+	addrs = hegel.OneOf(v4Addrs, v6Addrs)
+	// prefixes: an address with a prefix length up to its bit length
+	prefixes = hegel.FlatMap(addrs, func(a netip.Addr) hegel.Generator[netip.Prefix] {
+		return hegel.Map(hegel.Integers(0, a.BitLen()), func(bits int) netip.Prefix { return netip.PrefixFrom(a, bits) })
+	})
+)
+
+// --------------------------------------------------------------------------- colours
+
+var (
+	// hexcolors: "#" and k hex digits, k up to 9 (3, 4, 6 and 8 are valid); the hash dropped or
+	// a "g" appended 10% of the time each
+	hexcolors = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		k := hegel.Draw(tc, hegel.Integers(0, 9))
+		body := hegel.Draw(tc, runes("0123456789abcdefABCDEF", k, k))
+		noHash := hegel.Draw(tc, chance(10))
+		junk := hegel.Draw(tc, chance(10))
+		s := "#" + body
+		if noHash {
+			s = body
+		}
+		if junk {
+			s += "g"
+		}
+		return fv(s, !noHash && !junk && (k == 3 || k == 4 || k == 6 || k == 8))
+	})
+	// rgbs: three components up to 270 (255 is the limit), or three percentages up to 110%
+	// (up to 255% are accepted, an accepted difference) 30% of the time
+	rgbs = hegel.FlatMap(chance(30), func(pct bool) hegel.Generator[fmtValue] {
+		hi := 270
+		if pct {
+			hi = 110
+		}
+		return hegel.Map(pairs(fixed(hegel.Integers(0, hi), 3), hegel.SampledFrom([]string{",", ", ", " , "})), func(p pair[[]int, string]) fmtValue {
+			parts := make([]string, 3)
+			ok := true
+			for i, x := range p.a {
+				parts[i] = strconv.Itoa(x)
+				if pct {
+					parts[i] += "%"
+				} else if x > 255 {
+					ok = false
+				}
+			}
+			return fv("rgb("+strings.Join(parts, p.b)+")", ok)
+		})
+	})
+	// alphas: 0, 1 or 0.<digits 1-9> (validator/4), or out of range
+	rgbAlphas = hegel.SampledFrom([]string{"0", "1", "0.5", "0.25", "0.999", "2", "-1", "1.5"})
+	rgbas     = hegel.Map(pairs(fixed(hegel.Integers(0, 270), 3), rgbAlphas), func(p pair[[]int, string]) fmtValue {
+		parts := make([]string, 3)
+		ok := alphaOK(p.b)
+		for i, x := range p.a {
+			parts[i] = strconv.Itoa(x)
+			if x > 255 {
+				ok = false
+			}
+		}
+		return fv("rgba("+strings.Join(parts, ",")+","+p.b+")", ok)
+	})
+	hsls = hegel.Map(hslParts, func(hsl []int) fmtValue {
+		h, s, l := hsl[0], hsl[1], hsl[2]
+		return fv(fmt.Sprintf("hsl(%d, %d%%, %d%%)", h, s, l), h <= 360 && s <= 100 && l <= 100)
+	})
+	hslas = hegel.Map(pairs(hslParts, hegel.SampledFrom([]string{"0", "1", "0.5", "0.75", "2", "1.5"})), func(p pair[[]int, string]) fmtValue {
+		h, s, l := p.a[0], p.a[1], p.a[2]
+		return fv(fmt.Sprintf("hsla(%d,%d%%,%d%%,%s)", h, s, l, p.b), h <= 360 && s <= 100 && l <= 100 && alphaOK(p.b))
+	})
+	cmyks = hegel.Map(fixed(hegel.Integers(0, 110), 4), func(xs []int) fmtValue {
+		parts := make([]string, 4)
+		ok := true
+		for i, x := range xs {
+			parts[i] = strconv.Itoa(x) + "%"
+			if x > 100 {
+				ok = false
+			}
+		}
+		return fv("cmyk("+strings.Join(parts, ",")+")", ok)
+	})
+)
+
+// hslParts: a hue up to 380 (360 is the limit) and a saturation and lightness up to 110%.
+var hslParts = hegel.Composite(func(tc hegel.TestCase) []int {
+	return []int{hegel.Draw(tc, hegel.Integers(0, 380)), hegel.Draw(tc, hegel.Integers(0, 110)), hegel.Draw(tc, hegel.Integers(0, 110))}
+})
+
+func alphaOK(alpha string) bool { return alpha != "2" && alpha != "-1" && alpha != "1.5" }
+
+// --------------------------------------------------------------------------- names and addresses
+
+var (
+	// emails: a local part and a dotted domain, half the time mutated (no @, two @, no local
+	// part, no dot in the domain, a space)
+	emails = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		local := hegel.Draw(tc, runes("abz09._+-", 1, 6))
+		domain := hegel.Draw(tc, labels(1, 5)) + "." + hegel.Draw(tc, runes("abcz", 2, 3))
+		mut := hegel.Draw(tc, mutant(50, 5))
+		switch mut {
+		case 1:
+			return fv(local+domain, false)
+		case 2:
+			return fv(local+"@@"+domain, false)
+		case 3:
+			return fv("@"+domain, false)
+		case 4:
+			return fv(local+"@"+strings.Split(domain, ".")[0], false) // no dot in the domain
+		case 5:
+			return fv(local+" x@"+domain, false)
+		}
+		ok := !strings.HasPrefix(local, ".") && !strings.HasSuffix(local, ".") && !strings.Contains(local, "..")
+		return fv(local+"@"+domain, ok)
+	})
+	// urls: a scheme, a dotted host, and a path, query and fragment some of the time; 37%
+	// of the time the scheme or the host is dropped, or the whole URL
+	urls = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		u := url.URL{
+			Scheme: hegel.Draw(tc, hegel.SampledFrom([]string{"http", "https", "ftp", "rtmp"})),
+			Host:   hegel.Draw(tc, labels(1, 6)) + "." + hegel.Draw(tc, runes("abc", 2, 3)),
+		}
+		if path := hegel.Draw(tc, maybe(40, labels(0, 5))); path != "" {
+			u.Path = "/" + path
+		}
+		if q := hegel.Draw(tc, maybe(30, labels(1, 3))); q != "" {
+			u.RawQuery = "q=" + q
+		}
+		u.Fragment = hegel.Draw(tc, maybe(20, labels(1, 3)))
+		switch hegel.Draw(tc, mutant(37, 3)) {
+		case 1:
+			return fv(u.Host+u.Path, false) // no scheme
+		case 2:
+			return fv(u.Scheme+"://", false) // no host
+		case 3:
+			return fv("", false)
+		}
+		return fv(u.String(), true)
+	})
+	httpURLs = hegel.Map(pairs(hegel.SampledFrom([]string{"http", "https", "ftp"}), pairs(labels(1, 6), labels(0, 3))), func(p pair[string, pair[string, string]]) fmtValue {
+		return fv(p.a+"://"+p.b.a+".org/"+p.b.b, p.a != "ftp")
+	})
+	httpsURLs = hegel.Map(pairs(hegel.SampledFrom([]string{"https", "http", "ftp"}), labels(1, 6)), func(p pair[string, string]) fmtValue {
+		return fv(p.a+"://"+p.b+".org", p.a == "https")
+	})
+	// uris: an absolute path with a query, an http URL with a fragment, a relative path (not
+	// a URI) and the empty string
+	uris = hegel.OneOf(
+		hegel.Map(pairs(labels(0, 5), labels(1, 2)), func(p pair[string, string]) fmtValue { return fv("/"+p.a+"?q="+p.b, true) }),
+		hegel.Map(pairs(labels(1, 5), pairs(labels(0, 3), labels(0, 2))), func(p pair[string, pair[string, string]]) fmtValue {
+			return fv("http://"+p.a+".org/"+p.b.a+"#"+p.b.b, true)
+		}),
+		hegel.Map(pairs(labels(1, 5), labels(0, 3)), func(p pair[string, string]) fmtValue { return fv(p.a+"/"+p.b, false) }),
+		hegel.Just(fv("", false)),
+	)
+	ips = hegel.Map(pairs(addrs, chance(15)), func(p pair[netip.Addr, bool]) fmtValue {
+		if p.b {
+			return fv(p.a.String()+".1", false)
+		}
+		return fv(p.a.String(), true)
+	})
+	ipv4s = hegel.Map(addrs, func(a netip.Addr) fmtValue { return fv(a.String(), a.Is4()) })
+	ipv6s = hegel.Map(addrs, func(a netip.Addr) fmtValue { return fv(a.String(), a.Is6()) })
+	cidrs = hegel.Map(pairs(prefixes, chance(15)), func(p pair[netip.Prefix, bool]) fmtValue {
+		if p.b {
+			return fv(p.a.Addr().String(), false) // no prefix length
+		}
+		return fv(p.a.String(), true)
+	})
+	cidrv4s = hegel.Map(prefixes, func(p netip.Prefix) fmtValue { return fv(p.String(), p.Addr().Is4() && p.Masked() == p) })
+	cidrv6s = hegel.Map(prefixes, func(p netip.Prefix) fmtValue {
+		if Known.cidrv6Unmasked {
+			p = p.Masked()
+		}
+		return fv(p.String(), p.Addr().Is6())
+	})
+	// macs: 6, 8 or 20 bytes (valid), 5 (not), colon- or dash-separated
+	macs = hegel.FlatMap(hegel.SampledFrom([]int{6, 6, 8, 20, 5}), func(k int) hegel.Generator[fmtValue] {
+		return hegel.Map(pairs(fixed(hegel.Integers(0, 255), k), chance(30)), func(p pair[[]int, bool]) fmtValue {
+			b := make([]byte, k)
+			for i, x := range p.a {
+				b[i] = byte(x)
+			}
+			s := net.HardwareAddr(b).String()
+			if p.b {
+				s = strings.ReplaceAll(s, ":", "-")
+			}
+			return fv(s, k == 6 || k == 8 || k == 20)
+		})
+	})
+	// rfc1123Labels: a label, or one of 64 characters (too long) 8% of the time
+	rfc1123Labels    = weighted(choice[string]{92, labels(1, 8)}, choice[string]{8, hegel.Just(strings.Repeat("a", 64))})
+	hostnamesRFC1123 = hegel.Map(hegel.Lists(rfc1123Labels).MinSize(1).MaxSize(3), func(ls []string) fmtValue {
+		ok := true
+		for _, l := range ls {
+			if len(l) > 63 {
+				ok = false
+			}
+		}
+		return fv(strings.Join(ls, "."), ok)
+	})
+	// hostnames: RFC 952, the name starts with a letter
+	hostnames = hegel.Map(hegel.Lists(labels(1, 8)).MinSize(1).MaxSize(3), func(ls []string) fmtValue {
+		s := strings.Join(ls, ".")
+		return fv(s, unicode.IsLetter(rune(s[0])))
+	})
+	// fqdns: labels and a TLD (a numeric one is not valid), a trailing dot, a leading 64-character
+	// label (not valid) or a single label (not an FQDN) 10% of the time each
+	fqdns = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		ls := hegel.Draw(tc, hegel.Lists(labels(1, 8)).MinSize(1).MaxSize(3))
+		tld := hegel.Draw(tc, hegel.SampledFrom([]string{"com", "org", "io", "x1", "123"}))
+		dot := hegel.Draw(tc, chance(10))
+		long := hegel.Draw(tc, chance(10))
+		single := hegel.Draw(tc, chance(10))
+		s := strings.Join(ls, ".") + "." + tld
+		ok := tld != "123"
+		if dot {
+			s += "."
+		}
+		if long {
+			s, ok = strings.Repeat("a", 64)+"."+s, false
+		}
+		if single {
+			return fv(ls[0], false) // a single label is not an FQDN
+		}
+		return fv(s, ok)
+	})
+	// hostPorts: an empty host, localhost, a DNS name or an IPv4 address (no bracketed IPv6,
+	// validator/5) and a port from -1 to 70000
+	hosts = hegel.OneOf(
+		hegel.Just(""),
+		hegel.Just("localhost"),
+		hegel.Map(labels(1, 6), func(l string) string { return l + ".org" }),
+		hegel.Map(hegel.Integers(0, 255), func(x int) string { return "192.0.2." + strconv.Itoa(x) }),
+	)
+	hostPorts = hegel.Map(pairs(hosts, hegel.Integers(-1, 70000)), func(p pair[string, int]) fmtValue {
+		return fv(p.a+":"+strconv.Itoa(p.b), p.b >= 1 && p.b <= 65535)
+	})
+	// ports: as an int, or as a uint32 half the time
+	ports = hegel.Map(pairs(hegel.SampledFrom([]int{80, 1, 8080, 65535, 0, 65536, 70000, -1}), chance(50)), func(p pair[int, bool]) fmtValue {
+		n, ok := p.a, p.a >= 1 && p.a <= 65535
+		if p.b {
+			return fv(uint32(max(n, 0)), ok)
+		}
+		return fv(n, ok)
+	})
+)
+
+// --------------------------------------------------------------------------- identifiers
+
+var (
+	// uuidHex: a lower-case UUID (upper case is not generated for uuid, validator/14)
+	uuidHex = hegel.FromRegex(`[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}`, true)
+	uuids   = hegel.Map(pairs(uuidHex, mutant(24, 2)), func(p pair[string, int]) fmtValue {
+		s := p.a
+		switch p.b {
+		case 1:
+			return fv(strings.Replace(s, "-", "", 1), false)
+		case 2:
+			return fv(s[:len(s)-1]+"g", false)
+		}
+		return fv(s, true)
+	})
+	// uuid4s: the version nibble 4 (valid) or another, the variant nibble 8-b (valid) or another
+	uuid4s = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		ver := hegel.Draw(tc, hegel.SampledFrom([]string{"4", "4", "1", "3", "5"}))
+		variant := hegel.Draw(tc, hegel.SampledFrom([]string{"8", "9", "a", "b", "c", "0"}))
+		s := hegel.Draw(tc, hexs(8)) + "-" + hegel.Draw(tc, hexs(4)) + "-" + ver + hegel.Draw(tc, hexs(3)) + "-" + variant + hegel.Draw(tc, hexs(3)) + "-" + hegel.Draw(tc, hexs(12))
+		return fv(s, ver == "4" && strings.Contains("89ab", variant))
+	})
+	uuidsRFC4122 = hegel.Map(pairs(uuidHex, chance(50)), func(p pair[string, bool]) fmtValue {
+		if p.b {
+			return fv(strings.ToUpper(p.a), true)
+		}
+		return fv(p.a, true)
+	})
+	// ulids: a first character 0-7 (validator/15) and 25 Crockford characters, lower-cased 30%
+	// of the time; 30% of the time cut short or given an I or a U
+	ulids = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		first := hegel.Draw(tc, hegel.SampledFrom(strings.Split("01234567", "")))
+		rest := hegel.Draw(tc, runes(crockford, 25, 25))
+		lower := hegel.Draw(tc, chance(30))
+		mut := hegel.Draw(tc, mutant(30, 3))
+		s := first + rest
+		if lower {
+			s = strings.ToLower(s)
+		}
+		switch mut {
+		case 1:
+			return fv(s[:25], false)
+		case 2:
+			return fv(s[:10]+"I"+s[11:], false)
+		case 3:
+			return fv(s[:10]+"U"+s[11:], false)
+		}
+		return fv(s, true)
+	})
+	// jsonValues: nil, an int, a string with a quote in it, an array, an object
+	jsonValues = hegel.OneOf(
+		hegel.Just[any](nil),
+		hegel.Map(hegel.Integers(-5, 5), func(x int) any { return x }),
+		hegel.Map(runes(wordPool, 0, 4), func(s string) any { return s + "\"" }),
+		hegel.Just[any]([]any{1, "a", nil, true}),
+		hegel.Just[any](map[string]any{"k": []int{1}, "\u00e9": "x"}),
+	)
+	// jsons: a marshalled value, padded with blanks half the time, broken by a trailing "]" 30%
+	// of the time, as []byte 30% of the time
+	jsons = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		v := hegel.Draw(tc, jsonValues)
+		spaced := hegel.Draw(tc, chance(50))
+		broken := hegel.Draw(tc, chance(30))
+		asBytes := hegel.Draw(tc, chance(30))
+		b, _ := json.Marshal(v)
+		s := string(b)
+		if spaced {
+			s = " " + s + "\n"
+		}
+		if broken {
+			return fv(s+"]", false)
+		}
+		if asBytes {
+			return fv([]byte(s), true)
+		}
+		return fv(s, true)
+	})
+	// dates: a date of 1900-2100, half the time in the wrong layout, with a suffix, or not on
+	// the calendar
+	dates = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		tm := time.Date(hegel.Draw(tc, hegel.Integers(1900, 2100)), time.Month(hegel.Draw(tc, hegel.Integers(1, 12))), hegel.Draw(tc, hegel.Integers(1, 28)), 0, 0, 0, 0, time.UTC)
