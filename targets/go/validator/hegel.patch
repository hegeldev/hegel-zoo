+package validator_test
+
+// Hegel property tests for go-playground/validator, written for the Hegel zoo.
+// See targets/go/validator/README.md.
+//
+// Oracles: the documented semantics of each tag (doc.go and the README), restated as small
+// models: length and value comparisons per kind, cross-field comparisons, the conditional
+// requirement family, string formats built or checked by independent Go code (net/netip,
+// encoding/base64, check-digit arithmetic, unicode tables), and a model of the struct
+// traversal (namespaces, dive, keys, omitempty, or-groups, partial validation).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/go-playground/validator/v10"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// validator/1: numeric parameters are parsed with base 0, so a leading zero means octal
+	// (max=010 is 8) and 08/09 panic. Generated parameters have no leading zero.
+	octalParams bool
+	// validator/2: gtfield/ltfield/gtefield/ltefield on strings compare byte lengths while
+	// gt/lt/... count runes. Not generated on strings.
+	gtfieldBytes bool
+	// validator/3: nefield panics on a type convertible to time.Time that is not time.Time
+	// (eqfield converts). Cross-field time comparisons use time.Time itself.
+	nefieldNamedTime bool
+	// validator/4: rgba/hsla alpha regex 0.[1-9]* rejects 0.05, 0.50, 1.0, .5 and accepts 0X.
+	// Generated alphas are 0, 1 or 0.<digits 1-9>.
+	alphaRegex bool
+	// validator/5: hostname_port rejects bracketed IPv6 hosts. Only DNS names and IPv4 hosts.
+	hostnamePortIPv6 bool
+	// validator/6: required_if & co compare a bool field with the literal "true" only. Bool
+	// parameters are written true/false.
+	requiredIfBool bool
+	// validator/7: excluded_without takes a single field where its siblings take a list. One
+	// field only.
+	excludedWithoutList bool
+	// validator/8: oneof values cannot contain an apostrophe (all quotes are stripped). No
+	// apostrophes in oneof values.
+	oneofApostrophe bool
+	// validator/9: ipv4/cidrv4 accept the IPv6 text of IPv4-mapped addresses (::ffff:1.2.3.4)
+	// that ipv6 rejects. Mapped addresses are not generated.
+	ipv4Mapped bool
+	// validator/10: html_encoded rejects single-digit references (&#9;). Pin only.
+	htmlEncoded bool
+	// validator/11: ssn accepts area numbers 000, 666 and 900-999. Generated SSNs use valid
+	// areas; invalid ones are not generated.
+	ssnAreas bool
+	// validator/12: unique panics on an unexported field under WithPrivateFieldValidation.
+	// Pin only.
+	uniquePrivate bool
+	// validator/13: fqdn accepts labels ending in a hyphen. Labels never end in "-".
+	fqdnHyphen bool
+	// validator/14: the docs say upper-case UUIDs fail `uuid`; they pass. Upper case is not
+	// generated for uuid/uuid3/4/5.
+	uuidUppercase bool
+	// validator/15: ulid accepts a first character above 7 (a 130-bit value). Generated ULIDs
+	// start with 0-7; the overflow shape is not generated.
+	ulidOverflow bool
+	// validator/16: datauri requires a base64 payload and a media type (RFC 2397 has neither
+	// mandatory). Only base64 data URIs with a media type are generated.
+	datauriPlain bool
+	// validator/17: cidrv4 requires the network address (10.1.2.3/8 fails) while cidrv6 does
+	// not (2001:db8::1/32 passes). IPv6 prefixes are generated masked.
+	cidrv6Unmasked bool
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// --------------------------------------------------------------------------- helpers
+
+var val = validator.New(validator.WithRequiredStructEnabled())
+
+type verr struct{ ns, sns, field, tag, actual, param string }
+
+func (e verr) String() string {
+	return fmt.Sprintf("%s(%s)=%s", e.ns, e.tag, e.param)
+}
+
+// errsOf flattens a validation result: nil for no error, the sorted field errors otherwise; a
+// non-ValidationErrors error is reported in the second value.
+func errsOf(err error) ([]verr, string) {
+	if err == nil {
+		return nil, ""
+	}
+	ves, ok := err.(validator.ValidationErrors)
+	if !ok {
+		return nil, fmt.Sprintf("not ValidationErrors: %T %v", err, err)
+	}
+	var out []verr
+	for _, fe := range ves {
+		out = append(out, verr{fe.Namespace(), fe.StructNamespace(), fe.Field(), fe.Tag(), fe.ActualTag(), fe.Param()})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].ns != out[j].ns {
+			return out[i].ns < out[j].ns
+		}
+		return out[i].tag < out[j].tag
+	})
+	return out, ""
+}
+
+// dynField / structOf: an anonymous struct built at run time so that a property can vary the
+// tags. Its namespace is bare (no type name), so a field's Namespace() is its name.
+type dynField struct {
+	name string
+	val  any
+	tag  string
+}
+
+func structOf(fields ...dynField) any {
+	sf := make([]reflect.StructField, len(fields))
+	for i, f := range fields {
+		tag := ""
+		if f.tag != "" {
+			tag = `validate:"` + f.tag + `"`
+		}
+		sf[i] = reflect.StructField{Name: f.name, Type: reflect.TypeOf(f.val), Tag: reflect.StructTag(tag)}
+	}
+	typ := reflect.StructOf(sf)
+	sv := reflect.New(typ).Elem()
+	for i, f := range fields {
+		sv.Field(i).Set(reflect.ValueOf(f.val))
+	}
+	return sv.Interface()
+}
+
+var wordRunes = []rune("abcxyzAZ019 -_.:/éÉß日٣")
+
+func genRunes(tc hegel.TestCase, alphabet []rune, lo, hi int) string {
+	k := n(tc, lo, hi)
+	rs := make([]rune, k)
+	for i := range rs {
+		rs[i] = pick(tc, alphabet)
+	}
+	return string(rs)
+}
+
+// plainWord: a value safe inside a tag parameter (no comma, pipe, equals, quote, space).
+func plainWord(tc hegel.TestCase, lo, hi int) string {
+	return genRunes(tc, []rune("abcxyzAZ019-_.:/éß日"), lo, hi)
+}
+
+// escParam writes a parameter inside a tag: "," as 0x2C and "|" as 0x7C.
+func escParam(s string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(s, ",", "0x2C"), "|", "0x7C")
+}
+
+// --------------------------------------------------------------------------- comparisons
+
+// cv: a generated value with its measure for the comparison tags (rune count for strings,
+// item count for collections, the number itself otherwise).
+type cv struct {
+	kind    string
+	val     any
+	measure float64
+	str     string
+}
+
+var cmpKinds = []string{"string", "int", "int8", "int64", "uint16", "float64", "float32", "slice", "map", "array", "duration"}
+
+func genCV(tc hegel.TestCase) cv {
+	switch k := pick(tc, cmpKinds); k {
+	case "string":
+		s := genRunes(tc, wordRunes, 0, 6)
+		return cv{k, s, float64(utf8.RuneCountInString(s)), s}
+	case "int":
+		x := n(tc, -40, 40)
+		return cv{k, x, float64(x), ""}
+	case "int8":
+		x := n(tc, -40, 40)
+		return cv{k, int8(x), float64(x), ""}
+	case "int64":
+		x := n(tc, -40, 40)
+		return cv{k, int64(x), float64(x), ""}
+	case "uint16":
+		x := n(tc, 0, 40)
+		return cv{k, uint16(x), float64(x), ""}
+	case "float64":
+		f := float64(n(tc, -80, 80)) / 4
+		return cv{k, f, f, ""}
+	case "float32":
+		f := float64(n(tc, -80, 80)) / 4
+		return cv{k, float32(f), f, ""}
+	case "slice":
+		xs := make([]int, n(tc, 0, 5))
+		return cv{k, xs, float64(len(xs)), ""}
+	case "map":
+		m := map[int]int{}
+		for i := n(tc, 0, 5); i > 0; i-- {
+			m[i] = i
+		}
+		return cv{k, m, float64(len(m)), ""}
+	case "array":
+		return cv{k, [3]int{}, 3, ""}
+	default: // duration
+		d := time.Duration(n(tc, 0, 40)) * time.Second
+		return cv{k, d, float64(d), ""}
+	}
+}
+
+var cmpTags = []string{"len", "min", "max", "eq", "ne", "gt", "gte", "lt", "lte"}
+
+// genParam: a parameter for tag on c, and its numeric reading (unused for string eq/ne).
+func genParam(tc hegel.TestCase, c cv, tag string) (string, float64) {
+	switch c.kind {
+	case "string":
+		if tag == "eq" || tag == "ne" {
+			if chance(tc, 40) && !strings.ContainsAny(c.str, ",|=' \"") {
+				return c.str, 0
+			}
+			return plainWord(tc, 0, 4), 0
+		}
+		return strconv.Itoa(n(tc, 0, 7)), 0
+	case "slice", "map", "array":
+		return strconv.Itoa(n(tc, 0, 7)), 0
+	case "uint16":
+		p := n(tc, 0, 45)
+		return strconv.Itoa(p), float64(p)
+	case "float64", "float32":
+		p := float64(n(tc, -90, 90)) / 4
+		return strconv.FormatFloat(p, 'f', -1, 64), p
+	case "duration":
+		p := n(tc, 0, 45)
+		if chance(tc, 50) {
+			return fmt.Sprintf("%ds", p), float64(time.Duration(p) * time.Second)
+		}
+		ns := time.Duration(p) * time.Second
+		return strconv.FormatInt(int64(ns), 10), float64(ns)
+	default:
+		p := n(tc, -45, 45)
+		return strconv.Itoa(p), float64(p)
+	}
+}
+
+func expectCmp(c cv, tag, param string) bool {
+	if c.kind == "string" && (tag == "eq" || tag == "ne") {
+		return (c.str == param) == (tag == "eq")
+	}
+	var p float64
+	switch c.kind {
+	case "duration":
+		if d, err := time.ParseDuration(param); err == nil {
+			p = float64(d)
+		} else {
+			x, _ := strconv.ParseInt(param, 10, 64)
+			p = float64(x)
+		}
+	default:
+		p, _ = strconv.ParseFloat(param, 64)
+	}
+	m := c.measure
+	switch tag {
+	case "len", "eq":
+		return m == p
+	case "ne":
+		return m != p
+	case "min", "gte":
+		return m >= p
+	case "max", "lte":
+		return m <= p
+	case "gt":
+		return m > p
+	default: // lt
+		return m < p
+	}
+}
+
+type cmpStep struct {
+	text  string // the tag text
+	pass  bool
+	tag   string // Tag() expected on failure
+	param string // Param() expected on failure ("" = not checked)
+}
+
+// TestHegelComparisonsFollowTheModel: len/min/max/eq/ne/gt/gte/lt/lte on strings (rune
+// count), numbers, durations and collections (item count), alone, chained with "," (the first
+// failing tag is reported) and in "|" groups (any passing alternative passes), through Var and
+// through a struct field.
+func TestHegelComparisonsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		v := genCV(ht)
+		var steps []cmpStep
+		for k := n(ht, 1, 3); k > 0; k-- {
+			tag := pick(ht, cmpTags)
+			param, _ := genParam(ht, v, tag)
+			if chance(ht, 25) {
+				tag2 := pick(ht, cmpTags)
+				param2, _ := genParam(ht, v, tag2)
+				text := tag + "=" + param + "|" + tag2 + "=" + param2
+				steps = append(steps, cmpStep{text, expectCmp(v, tag, param) || expectCmp(v, tag2, param2), text, ""})
+				continue
+			}
+			steps = append(steps, cmpStep{tag + "=" + param, expectCmp(v, tag, param), tag, param})
+		}
+		var texts []string
+		var first *cmpStep
+		for i := range steps {
+			texts = append(texts, steps[i].text)
+			if first == nil && !steps[i].pass {
+				first = &steps[i]
+			}
+		}
+		tag := strings.Join(texts, ",")
+		c.count(v.kind)
+		if first == nil {
+			c.count("pass")
+		} else if strings.Contains(first.text, "|") {
+			c.count("fail-or")
+		} else {
+			c.count("fail")
+		}
+
+		errs, bad := errsOf(val.Var(v.val, tag))
+		if bad != "" {
+			c.fail(ht, "Var(%#v, %q): %s", v.val, tag, bad)
+			return
+		}
+		if first == nil {
+			if len(errs) != 0 {
+				c.fail(ht, "Var(%#v, %q) = %v, want no error", v.val, tag, errs)
+			}
+		} else if len(errs) != 1 || errs[0].tag != first.tag || (first.param != "" && errs[0].param != first.param) {
+			c.fail(ht, "Var(%#v, %q) = %v, want one error on %s (param %q)", v.val, tag, errs, first.tag, first.param)
+			return
+		}
+		// the same tag on a struct field
+		serrs, bad := errsOf(val.Struct(structOf(dynField{"F", v.val, tag})))
+		if bad != "" {
+			c.fail(ht, "Struct{F %#v %q}: %s", v.val, tag, bad)
+			return
+		}
+		if len(serrs) != len(errs) {
+			c.fail(ht, "Struct{F %#v %q} = %v, Var gives %v", v.val, tag, serrs, errs)
+			return
+		}
+		if len(serrs) == 1 && (serrs[0].ns != "F" || serrs[0].field != "F" || serrs[0].tag != errs[0].tag) {
+			c.fail(ht, "Struct{F %#v %q} = %+v, want namespace F and tag %s", v.val, tag, serrs[0], errs[0].tag)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- cross-field
+
+type xv struct {
+	kind string
+	val  any
+	num  float64
+	str  string
+	t    time.Time
+}
+
+func genXV(tc hegel.TestCase, kind string) xv {
+	switch kind {
+	case "int":
+		x := n(tc, -5, 5)
+		return xv{kind, x, float64(x), "", time.Time{}}
+	case "uint":
+		x := n(tc, 0, 5)
+		return xv{kind, uint(x), float64(x), "", time.Time{}}
+	case "float64":
+		f := float64(n(tc, -10, 10)) / 2
+		return xv{kind, f, f, "", time.Time{}}
+	case "string":
+		s := genRunes(tc, []rune("abé"), 0, 3)
+		return xv{kind, s, 0, s, time.Time{}}
+	case "time":
+		tm := time.Date(2024, 1, 1, 0, 0, n(tc, 0, 3), 0, time.UTC)
+		return xv{kind, tm, float64(tm.Unix()), "", tm}
+	default: // slice
+		xs := make([]int, n(tc, 0, 3))
+		return xv{kind, xs, float64(len(xs)), "", time.Time{}}
+	}
+}
+
+var xKinds = []string{"int", "uint", "float64", "string", "time", "slice"}
+var xTags = []string{"eqfield", "nefield", "gtfield", "gtefield", "ltfield", "ltefield"}
+
+// expectX: the documented comparison of a with b; ok=false when the pair is left unspecified.
+func expectX(a, b xv, tag string) (want bool, ok bool) {
+	if a.kind != b.kind {
+		// different kinds: eqfield and the ordered tags fail, nefield passes
+		return tag == "nefield", true
+	}
+	var cmp int
+	switch a.kind {
+	case "string":
+		if tag != "eqfield" && tag != "nefield" {
+			return false, false // byte length vs rune count (validator/2)
+		}
+		cmp = strings.Compare(a.str, b.str)
+	case "slice":
+		if tag != "eqfield" && tag != "nefield" {
+			return false, false // reflect.Value.String() of slices; unspecified
+		}
+		cmp = int(a.num - b.num)
+	default:
+		switch {
+		case a.num < b.num:
+			cmp = -1
+		case a.num > b.num:
+			cmp = 1
+		}
+	}
+	switch tag {
+	case "eqfield":
+		return cmp == 0, true
+	case "nefield":
+		return cmp != 0, true
+	case "gtfield":
+		return cmp > 0, true
+	case "gtefield":
+		return cmp >= 0, true
+	case "ltfield":
+		return cmp < 0, true
+	default:
+		return cmp <= 0, true
+	}
+}
+
+// TestHegelCrossFieldFollowsTheModel: eqfield/nefield/gtfield/gtefield/ltfield/ltefield on
+// two fields of the same kind (numbers, time.Time, strings and slices for eq/ne) and of
+// different kinds, through VarWithValue and through a struct.
+func TestHegelCrossFieldFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ka := pick(ht, xKinds)
+		kb := ka
+		if chance(ht, 15) {
+			kb = pick(ht, xKinds)
+		}
+		a, b := genXV(ht, ka), genXV(ht, kb)
+		tag := pick(ht, xTags)
+		want, ok := expectX(a, b, tag)
+		if !ok {
+			c.count("unspecified")
+			return
+		}
+		c.count(ka + "/" + kb)
+		errs, bad := errsOf(val.VarWithValue(a.val, b.val, tag))
+		if bad != "" {
+			c.fail(ht, "VarWithValue(%#v, %#v, %s): %s", a.val, b.val, tag, bad)
+			return
+		}
+		if (len(errs) == 0) != want {
+			c.fail(ht, "VarWithValue(%#v, %#v, %s) = %v, want pass=%v", a.val, b.val, tag, errs, want)
+			return
+		}
+		serrs, bad := errsOf(val.Struct(structOf(dynField{"A", a.val, tag + "=B"}, dynField{"B", b.val, ""})))
+		if bad != "" {
+			c.fail(ht, "Struct{A %#v %s=B; B %#v}: %s", a.val, tag, b.val, bad)
+			return
+		}
+		if (len(serrs) == 0) != want || (len(serrs) == 1 && (serrs[0].ns != "A" || serrs[0].tag != tag || serrs[0].param != "B")) {
+			c.fail(ht, "Struct{A %#v %s=B; B %#v} = %v, want pass=%v (error on A with param B)", a.val, tag, b.val, serrs, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- conditional requirements
+
+// ov: the "other" field of a conditional requirement and a parameter text for it.
+type ov struct {
+	kind  string
+	val   any
+	param string
+	eq    bool // whether the field equals the parameter under the documented reading
+}
+
+func genOV(tc hegel.TestCase) ov {
+	switch k := pick(tc, []string{"string", "int", "bool", "ptr", "slice"}); k {
+	case "string":
+		s := pick(tc, []string{"", "x", "y", "ab"})
+		p := pick(tc, []string{"x", "y", "ab"})
+		return ov{k, s, p, s == p}
+	case "int":
+		x := n(tc, 0, 3)
+		p := n(tc, 0, 3)
+		return ov{k, x, strconv.Itoa(p), x == p}
+	case "bool":
+		b := chance(tc, 50)
+		p := pick(tc, []string{"true", "false"})
+		return ov{k, b, p, strconv.FormatBool(b) == p}
+	case "ptr":
+		var s *string
+		var cur string
+		if chance(tc, 50) {
+			x := pick(tc, []string{"", "x", "y"})
+			s = &x
+			cur = x
+		}
+		p := pick(tc, []string{"nil", "x", "y"})
+		eq := (s == nil && p == "nil") || (s != nil && p != "nil" && cur == p)
+		return ov{k, s, p, eq}
+	default:
+		var xs []int
+		if chance(tc, 60) {
+			xs = make([]int, n(tc, 0, 2))
+		}
+		p := pick(tc, []string{"nil", "0", "1", "2"})
+		var eq bool
+		if p == "nil" {
+			eq = xs == nil
+		} else {
+			eq = strconv.Itoa(len(xs)) == p
+		}
+		return ov{k, xs, p, eq}
+	}
+}
+
+var condTags = []string{"required_if", "required_unless", "excluded_if", "excluded_unless",
+	"required_with", "required_with_all", "required_without", "required_without_all",
+	"excluded_with", "excluded_with_all", "excluded_without", "excluded_without_all"}
+
+// TestHegelConditionalRequirementsFollowTheModel: the required_*/excluded_* family on a string
+// field F next to an Other field (string, int, bool, pointer, slice) and two string fields A
+// and B, against the documented conditions.
+func TestHegelConditionalRequirementsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOV(ht)
+		a := pick(ht, []string{"", "a"})
+		b := pick(ht, []string{"", "b"})
+		f := pick(ht, []string{"", "f"})
+		tag := pick(ht, condTags)
+		present := f != ""
+		aPresent, bPresent := a != "", b != ""
+		var text string
+		var wantErr bool
+		list := "A B"
+		single := chance(ht, 30)
+		if single || (tag == "excluded_without" && Known.excludedWithoutList) {
+			list = "A"
+			bPresent = aPresent // one field: "any"/"all" collapse to A
+		}
+		switch tag {
+		case "required_if":
+			text, wantErr = tag+"=Other "+o.param, o.eq && !present
+		case "required_unless":
+			text, wantErr = tag+"=Other "+o.param, !o.eq && !present
+		case "excluded_if":
+			text, wantErr = tag+"=Other "+o.param, o.eq && present
+		case "excluded_unless":
+			text, wantErr = tag+"=Other "+o.param, !o.eq && present
+		case "required_with":
+			text, wantErr = tag+"="+list, (aPresent || bPresent) && !present
+		case "required_with_all":
+			text, wantErr = tag+"="+list, aPresent && bPresent && !present
+		case "required_without":
+			text, wantErr = tag+"="+list, (!aPresent || !bPresent) && !present
+		case "required_without_all":
+			text, wantErr = tag+"="+list, !aPresent && !bPresent && !present
+		case "excluded_with":
+			text, wantErr = tag+"="+list, (aPresent || bPresent) && present
+		case "excluded_with_all":
+			text, wantErr = tag+"="+list, aPresent && bPresent && present
+		case "excluded_without":
+			text, wantErr = tag+"="+list, (!aPresent || !bPresent) && present
+		default: // excluded_without_all
+			text, wantErr = tag+"="+list, !aPresent && !bPresent && present
+		}
+		c.count(tag)
+		c.count("other=" + o.kind)
+		s := structOf(dynField{"Other", o.val, ""}, dynField{"A", a, ""}, dynField{"B", b, ""}, dynField{"F", f, text})
+		errs, bad := errsOf(val.Struct(s))
+		if bad != "" {
+			c.fail(ht, "%+v with F %q: %s", s, text, bad)
+			return
+		}
+		if wantErr {
+			if len(errs) != 1 || errs[0].ns != "F" || errs[0].tag != tag {
+				c.fail(ht, "%+v with F `%s` = %v, want one error on F (%s)", s, text, errs, tag)
+			}
+		} else if len(errs) != 0 {
+			c.fail(ht, "%+v with F `%s` = %v, want no error", s, text, errs)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- unique
+
+// TestHegelUniqueFollowsTheModel: unique on slices (of values, pointers and structs with a
+// field parameter) and on map values.
+func TestHegelUniqueFollowsTheModel(t *testing.T) {
+	type rec struct {
+		ID   int
+		Name string
+	}
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 5)
+		var value any
+		var tag string
+		var want bool
+		switch pick(ht, []string{"ints", "strings", "ptrs", "structs", "map"}) {
+		case "ints":
+			xs := make([]int, k)
+			seen := map[int]bool{}
+			want = true
+			for i := range xs {
+				xs[i] = n(ht, 0, 4)
+				if seen[xs[i]] {
+					want = false
+				}
+				seen[xs[i]] = true
+			}
+			value, tag = xs, "unique"
+			c.count("ints")
+		case "strings":
+			xs := make([]string, k)
+			seen := map[string]bool{}
+			want = true
+			for i := range xs {
+				xs[i] = pick(ht, []string{"", "a", "b", "é"})
+				if seen[xs[i]] {
+					want = false
+				}
+				seen[xs[i]] = true
+			}
+			value, tag = xs, "unique"
+			c.count("strings")
+		case "ptrs":
+			xs := make([]*int, k)
+			seen := map[int]bool{}
+			nils := 0
+			want = true
+			for i := range xs {
+				if chance(ht, 25) {
+					nils++
+					continue
+				}
+				x := n(ht, 0, 4)
+				xs[i] = &x
+				if seen[x] {
+					want = false
+				}
+				seen[x] = true
+			}
+			if nils > 1 {
+				want = false
+			}
+			value, tag = xs, "unique"
+			c.count("ptrs")
+		case "structs":
+			xs := make([]rec, k)
+			seen := map[string]bool{}
+			want = true
+			for i := range xs {
+				xs[i] = rec{n(ht, 0, 9), pick(ht, []string{"a", "b", "c"})}
+				if seen[xs[i].Name] {
+					want = false
+				}
+				seen[xs[i].Name] = true
+			}
+			value, tag = xs, "unique=Name"
+			c.count("structs")
+		default:
+			m := map[string]int{}
+			seen := map[int]bool{}
+			want = true
+			for i := 0; i < k; i++ {
+				x := n(ht, 0, 4)
+				m[strconv.Itoa(i)] = x
+				if seen[x] {
+					want = false
+				}
+				seen[x] = true
+			}
+			value, tag = m, "unique"
+			c.count("map")
+		}
+		errs, bad := errsOf(val.Var(value, tag))
+		if bad != "" {
+			c.fail(ht, "Var(%#v, %s): %s", value, tag, bad)
+			return
+		}
+		if (len(errs) == 0) != want {
+			c.fail(ht, "Var(%#v, %s) = %v, want pass=%v", value, tag, errs, want)
+		}
+	})
+}
diff --git a/hegel_traversal_test.go b/hegel_traversal_test.go
new file mode 100644
index 0000000..f659c5d
--- /dev/null
+++ b/hegel_traversal_test.go
@@ -0,0 +1,251 @@
+package validator_test
+
+// Struct traversal against a model: namespaces, nested structs and pointers, dive over slices
+// and maps with keys/endkeys, omitempty, or-groups, required on pointers, StructPartial and
+// StructExcept.
+
+import (
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+type Leaf struct {
+	S string `validate:"required"`
+	N int    `validate:"min=1"`
+}
+
+type Doc struct {
+	Name  string         `validate:"required,min=2"`
+	Tags  []string       `validate:"omitempty,dive,alpha"`
+	Attrs map[string]int `validate:"dive,keys,alpha,endkeys,gte=0"`
+	Leaf  Leaf
+	PLeaf *Leaf  `validate:"omitempty"`
+	Req   *Leaf  `validate:"required"`
+	Items []Leaf `validate:"dive"`
+	Alt   string `validate:"omitempty,alpha|numeric"`
+	Nums  []int  `validate:"max=3,dive,gt=0"`
+	Skip  string `validate:"-"`
+}
+
+func isAlphaASCII(s string) bool {
+	return s != "" && all(s, func(r rune) bool { return r < 128 && unicode.IsLetter(r) })
+}
+
+func genLeaf(tc hegel.TestCase) Leaf {
+	return Leaf{pick(tc, []string{"", "s", "é"}), n(tc, -1, 2)}
+}
+
+func genDoc(tc hegel.TestCase) Doc {
+	d := Doc{
+		Name: pick(tc, []string{"", "a", "ab", "日本"}),
+		Leaf: genLeaf(tc),
+		Alt:  pick(tc, []string{"", "abc", "123", "a1", "-"}),
+		Skip: pick(tc, []string{"", "x"}),
+	}
+	if chance(tc, 60) {
+		d.Tags = []string{}
+		for k := n(tc, 0, 3); k > 0; k-- {
+			d.Tags = append(d.Tags, pick(tc, []string{"a", "bc", "", "1", "é"}))
+		}
+	}
+	if chance(tc, 60) {
+		d.Attrs = map[string]int{}
+		for k := n(tc, 0, 3); k > 0; k-- {
+			d.Attrs[pick(tc, []string{"k", "key", "k1", "", "é"})] = n(tc, -1, 1)
+		}
+	}
+	if chance(tc, 50) {
+		l := genLeaf(tc)
+		d.PLeaf = &l
+	}
+	if chance(tc, 70) {
+		l := genLeaf(tc)
+		d.Req = &l
+	}
+	for k := n(tc, 0, 3); k > 0; k-- {
+		d.Items = append(d.Items, genLeaf(tc))
+	}
+	if chance(tc, 70) {
+		d.Nums = []int{}
+		for k := n(tc, 0, 5); k > 0; k-- {
+			d.Nums = append(d.Nums, n(tc, -1, 2))
+		}
+	}
+	return d
+}
+
+// modelErrors: the (namespace, tag) pairs the documented rules produce for d.
+func modelErrors(d Doc) []string {
+	var out []string
+	add := func(ns, tag string) { out = append(out, ns+"("+tag+")") }
+	leaf := func(ns string, l Leaf) {
+		if l.S == "" {
+			add(ns+".S", "required")
+		}
+		if l.N < 1 {
+			add(ns+".N", "min")
+		}
+	}
+	switch {
+	case d.Name == "":
+		add("Doc.Name", "required")
+	case utf8.RuneCountInString(d.Name) < 2:
+		add("Doc.Name", "min")
+	}
+	for i, t := range d.Tags {
+		if !isAlphaASCII(t) {
+			add("Doc.Tags["+strconv.Itoa(i)+"]", "alpha")
+		}
+	}
+	for k, v := range d.Attrs {
+		if !isAlphaASCII(k) {
+			add("Doc.Attrs["+k+"]", "alpha")
+		}
+		if v < 0 {
+			add("Doc.Attrs["+k+"]", "gte")
+		}
+	}
+	leaf("Doc.Leaf", d.Leaf)
+	if d.PLeaf != nil {
+		leaf("Doc.PLeaf", *d.PLeaf)
+	}
+	if d.Req == nil {
+		add("Doc.Req", "required")
+	} else {
+		leaf("Doc.Req", *d.Req)
+	}
+	for i, l := range d.Items {
+		leaf("Doc.Items["+strconv.Itoa(i)+"]", l)
+	}
+	if d.Alt != "" && !isAlphaASCII(d.Alt) && !all(d.Alt, unicode.IsDigit) {
+		add("Doc.Alt", "alpha|numeric")
+	}
+	if len(d.Nums) > 3 {
+		add("Doc.Nums", "max")
+	} else {
+		for i, x := range d.Nums {
+			if x <= 0 {
+				add("Doc.Nums["+strconv.Itoa(i)+"]", "gt")
+			}
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func gotErrors(err error) ([]string, string) {
+	errs, bad := errsOf(err)
+	if bad != "" {
+		return nil, bad
+	}
+	var out []string
+	for _, e := range errs {
+		out = append(out, e.ns+"("+e.tag+")")
+	}
+	sort.Strings(out)
+	return out, ""
+}
+
+var docFields = []string{"Name", "Tags", "Attrs", "Leaf", "PLeaf", "Req", "Items", "Alt", "Nums", "Skip"}
+
+func filterTop(errs []string, keep func(field string) bool) []string {
+	var out []string
+	for _, e := range errs {
+		f := strings.TrimPrefix(e, "Doc.")
+		f = strings.SplitN(f, ".", 2)[0]
+		f = strings.SplitN(f, "[", 2)[0]
+		f = strings.SplitN(f, "(", 2)[0]
+		if keep(f) {
+			out = append(out, e)
+		}
+	}
+	return out
+}
+
+// TestHegelTraversalFollowsTheModel: Struct on a generated Doc reports exactly the model's
+// (namespace, tag) pairs; StructExcept on top-level field names drops exactly those fields'
+// errors and StructPartial keeps the named fields' own errors (a named struct's inner fields
+// are not validated, as upstream's tests expect); Namespace/StructNamespace/Field agree on this
+// un-renamed type.
+func TestHegelTraversalFollowsTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		d := genDoc(ht)
+		want := modelErrors(d)
+		got, bad := gotErrors(val.Struct(d))
+		if bad != "" {
+			c.fail(ht, "Struct(%+v): %s", d, bad)
+			return
+		}
+		c.count("errors=" + strconv.Itoa(min(len(want), 4)))
+		if !reflect.DeepEqual(got, want) {
+			c.fail(ht, "Struct(%+v) = %v, want %v", d, got, want)
+			return
+		}
+		// pointer to the struct: the same
+		if got2, _ := gotErrors(val.Struct(&d)); !reflect.DeepEqual(got2, want) {
+			c.fail(ht, "Struct(&doc) = %v, Struct(doc) = %v", got2, want)
+			return
+		}
+		// error accessors on the plain type
+		errs, _ := errsOf(val.Struct(d))
+		for _, e := range errs {
+			if e.ns != e.sns || e.actual != e.tag {
+				c.fail(ht, "error %+v: Namespace %q vs StructNamespace %q, Tag %q vs ActualTag %q", e, e.ns, e.sns, e.tag, e.actual)
+				return
+			}
+			last := e.ns[strings.LastIndex(e.ns, ".")+1:]
+			if e.field != last {
+				c.fail(ht, "error %+v: Field %q, want the last namespace segment %q", e, e.field, last)
+				return
+			}
+		}
+		// partial and except on top-level fields
+		var chosen []string
+		for _, f := range docFields {
+			if chance(ht, 40) {
+				chosen = append(chosen, f)
+			}
+		}
+		in := map[string]bool{}
+		for _, f := range chosen {
+			in[f] = true
+		}
+		gotP, bad := gotErrors(val.StructPartial(d, chosen...))
+		if bad != "" {
+			c.fail(ht, "StructPartial: %s", bad)
+			return
+		}
+		// a struct field named alone contributes its own tags only, not its inner fields
+		// (upstream's TestStructPartial names "Sub" and expects nothing inside it validated)
+		wantP := filterTop(want, func(f string) bool { return in[f] })
+		wantP = filterTop(wantP, func(string) bool { return true })
+		var own []string
+		for _, e := range wantP {
+			ns := e[:strings.Index(e, "(")]
+			if strings.Count(ns, ".") == 1 {
+				own = append(own, e)
+			}
+		}
+		wantP = own
+		if !reflect.DeepEqual(gotP, wantP) {
+			c.fail(ht, "StructPartial(%+v, %v) = %v, want %v", d, chosen, gotP, wantP)
+			return
+		}
+		gotE, bad := gotErrors(val.StructExcept(d, chosen...))
+		if bad != "" {
+			c.fail(ht, "StructExcept: %s", bad)
+			return
+		}
+		if wantE := filterTop(want, func(f string) bool { return !in[f] }); !reflect.DeepEqual(gotE, wantE) {
+			c.fail(ht, "StructExcept(%+v, %v) = %v, want %v", d, chosen, gotE, wantE)
+		}
+	})
+}
