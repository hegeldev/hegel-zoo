+package validator_test
+
+// String-format tags against independent constructions: a value is built to be valid (or
+// mutated to be invalid) by code that does not share the validator's regular expressions.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	_ "time/tzdata"
+	"unicode"
+
+	"hegel.dev/go/hegel"
+)
+
+// fmtCase: a tag with a generator of (value, expected validity).
+type fmtCase struct {
+	tag string
+	gen func(tc hegel.TestCase) (any, bool)
+}
+
+func digits(tc hegel.TestCase, k int) string {
+	return genRunes(tc, []rune("0123456789"), k, k)
+}
+
+func label(tc hegel.TestCase, lo, hi int) string {
+	s := genRunes(tc, []rune("abcz019-"), lo, hi)
+	s = strings.Trim(s, "-")
+	if s == "" {
+		s = "a"
+	}
+	return s
+}
+
+func hexs(tc hegel.TestCase, k int) string {
+	return genRunes(tc, []rune("0123456789abcdef"), k, k)
+}
+
+func mixedText(tc hegel.TestCase) string {
+	return genRunes(tc, []rune("abXZ019 \t-+._éÉß日٣"), 0, 6)
+}
+
+func all(s string, f func(rune) bool) bool {
+	for _, r := range s {
+		if !f(r) {
+			return false
+		}
+	}
+	return true
+}
+
+func isNumeric(s string) bool { // [-+]?[0-9]+(.[0-9]+)?
+	if strings.HasPrefix(s, "-") || strings.HasPrefix(s, "+") {
+		s = s[1:]
+	}
+	parts := strings.Split(s, ".")
+	if len(parts) > 2 {
+		return false
+	}
+	for _, p := range parts {
+		if p == "" || !all(p, func(r rune) bool { return r >= '0' && r <= '9' }) {
+			return false
+		}
+	}
+	return true
+}
+
+func isHexDigits(s string) bool {
+	return s != "" && all(s, func(r rune) bool { return strings.ContainsRune("0123456789abcdefABCDEF", r) })
+}
+
+func luhnCheck(digits string) byte { // the check digit that makes digits+check pass Luhn
+	sum := 0
+	double := true
+	for i := len(digits) - 1; i >= 0; i-- {
+		d := int(digits[i] - '0')
+		if double {
+			d *= 2
+			if d > 9 {
+				d -= 9
+			}
+		}
+		sum += d
+		double = !double
+	}
+	return byte('0' + (10-sum%10)%10)
+}
+
+func isbn10Check(d string) byte {
+	sum := 0
+	for i := 0; i < 9; i++ {
+		sum += (i + 1) * int(d[i]-'0')
+	}
+	if r := sum % 11; r == 10 {
+		return 'X'
+	} else {
+		return byte('0' + r)
+	}
+}
+
+func isbn13Check(d string) byte {
+	sum := 0
+	for i := 0; i < 12; i++ {
+		w := 1
+		if i%2 == 1 {
+			w = 3
+		}
+		sum += w * int(d[i]-'0')
+	}
+	return byte('0' + (10-sum%10)%10)
+}
+
+func issnCheck(d string) byte {
+	sum := 0
+	for i := 0; i < 7; i++ {
+		sum += (8 - i) * int(d[i]-'0')
+	}
+	r := (11 - sum%11) % 11
+	if r == 10 {
+		return 'X'
+	}
+	return byte('0' + r)
+}
+
+var crockford = []rune("0123456789ABCDEFGHJKMNPQRSTVWXYZ")
+
+func genAddr(tc hegel.TestCase) netip.Addr {
+	if chance(tc, 50) {
+		var b [4]byte
+		for i := range b {
+			b[i] = byte(n(tc, 0, 255))
+		}
+		return netip.AddrFrom4(b)
+	}
+	var b [16]byte
+	for i := range b {
+		b[i] = byte(pick(tc, []int{0, 0, 0, 1, 255, 0x20, 0xdb}))
+	}
+	if Known.ipv4Mapped {
+		b[0] = byte(n(tc, 1, 255)) // not ::ffff:a.b.c.d
+	}
+	return netip.AddrFrom16(b)
+}
