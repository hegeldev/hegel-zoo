+		return fv(base64.RawURLEncoding.EncodeToString(b), len(b) > 0)
+	})
+	// isbn10s: nine digits and their check digit, hyphenated 30% of the time, the check digit
+	// wrong 25% of the time
+	isbn10s = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		d := hegel.Draw(tc, digits(9))
+		hyphens := hegel.Draw(tc, chance(30))
+		bad := hegel.Draw(tc, chance(25))
+		check := isbn10Check(d)
+		s := d + string(check)
+		if hyphens {
+			s = d[:1] + "-" + d[1:4] + "-" + d[4:] + "-" + string(check)
+		}
+		if bad {
+			return fv(d+string(wrongCheck(check)), false)
+		}
+		return fv(s, true)
+	})
+	isbn13s = hegel.Composite(func(tc hegel.TestCase) fmtValue {
+		d := hegel.Draw(tc, hegel.SampledFrom([]string{"978", "979"})) + hegel.Draw(tc, digits(9))
+		hyphens := hegel.Draw(tc, chance(30))
+		bad := hegel.Draw(tc, chance(25))
+		check := isbn13Check(d)
+		s := d + string(check)
+		if hyphens {
+			s = d[:3] + "-" + d[3:4] + "-" + d[4:7] + "-" + d[7:] + "-" + string(check)
+		}
+		if bad {
+			return fv(d+string(wrongCheck(check)), false)
+		}
+		return fv(s, true)
