+	}},
+	{"ssn", func(tc hegel.TestCase) (any, bool) {
+		area := n(tc, 1, 899)
+		if area == 666 {
+			area = 665
+		}
+		group := n(tc, 1, 99)
+		serial := n(tc, 1, 9999)
+		ok := true
+		if chance(tc, 15) {
+			group, ok = 0, false
+		}
+		if chance(tc, 15) {
+			serial, ok = 0, false
+		}
+		sep := pick(tc, []string{"-", " "})
+		s := fmt.Sprintf("%03d%s%02d%s%04d", area, sep, group, sep, serial)
+		if chance(tc, 10) {
+			return strings.ReplaceAll(s, sep, ""), false // eleven characters expected
+		}
+		return s, ok
+	}},
+	{"cve", func(tc hegel.TestCase) (any, bool) {
+		year := n(tc, 1999, 2999)
+		id := digits(tc, n(tc, 4, 7))
+		ok := true
+		if len(id) == 4 {
+			ok = id != "0000"
+		} else {
+			ok = id[0] != '0'
+		}
+		if chance(tc, 10) {
+			return fmt.Sprintf("CVE-%d-%s", year, digits(tc, 3)), false
+		}
+		return fmt.Sprintf("CVE-%d-%s", year, id), ok
+	}},
+	{"ein", func(tc hegel.TestCase) (any, bool) {
+		if chance(tc, 20) {
+			return digits(tc, 9), false
+		}
+		return digits(tc, 2) + "-" + digits(tc, 7), true
+	}},
+	{"dns_rfc1035_label", func(tc hegel.TestCase) (any, bool) {
+		s := string(pick(tc, []rune("abz"))) + genRunes(tc, []rune("abz019-"), 0, 6)
+		ok := !strings.HasSuffix(s, "-")
+		switch n(tc, 0, 9) {
+		case 0:
+			return strings.ToUpper(s), false
+		case 1:
+			return "1" + s, false
+		case 2:
+			return "a" + strings.Repeat("b", 63), false
+		}
+		return s, ok
+	}},
+	{"timezone", func(tc hegel.TestCase) (any, bool) {
+		s := pick(tc, []string{"UTC", "Europe/Paris", "America/New_York", "Asia/Tokyo", "Etc/GMT+3", "Local", "", "Mars/Base", "utc"})
+		_, err := time.LoadLocation(s)
+		return s, err == nil && s != "" && s != "Local"
+	}},
+	{"datauri", func(tc hegel.TestCase) (any, bool) {
+		mime := pick(tc, []string{"text/plain", "image/png", "application/json"})
+		payload := base64.StdEncoding.EncodeToString([]byte(genRunes(tc, wordRunes, 1, 5)))
+		if chance(tc, 15) {
+			return "data:" + mime + ";base64," + payload + "!", false
+		}
+		return "data:" + mime + ";base64," + payload, true
+	}},
+}
+
+// TestHegelStringFormatsFollowTheModel: each format tag on values built valid or invalid by
+// independent code.
+func TestHegelStringFormatsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		fc := pick(ht, formatCases)
+		value, want := fc.gen(ht)
+		c.count(fc.tag)
+		errs, bad := errsOf(val.Var(value, fc.tag))
+		if bad != "" {
+			c.fail(ht, "Var(%#v, %s): %s", value, fc.tag, bad)
+			return
+		}
+		if (len(errs) == 0) != want {
+			c.fail(ht, "Var(%#v, %s) = %v, want pass=%v", value, fc.tag, errs, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- substrings and sets
+
+// TestHegelSubstringTagsFollowTheModel: contains/containsany/containsrune/excludes/
+// excludesall/excludesrune/startswith/endswith/startsnotwith/endsnotwith/eq/ne/eq_ignore_case
+// with parameters written through the 0x2C/0x7C escapes, and oneof/oneofci/noneof/noneofci
+// with quoted values, against the strings package.
+func TestHegelSubstringTagsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	alphabet := []rune("ab,|=é 日")
+	property(t, func(ht *hegel.T) {
+		s := genRunes(ht, alphabet, 0, 5)
+		var p string
+		if chance(ht, 40) && len(s) > 0 {
+			i := n(ht, 0, len([]rune(s))-1)
+			j := n(ht, i, len([]rune(s)))
+			p = string([]rune(s)[i:j])
+		} else {
+			p = genRunes(ht, alphabet, 0, 3)
+		}
+		if strings.ContainsAny(p, " '") || strings.ContainsAny(s, "'") {
+			c.count("skipped-space-or-quote")
+			return // a space splits tags only inside quotes; quotes are stripped (validator/8)
+		}
+		var tag string
+		var want bool
+		switch pick(ht, []string{"contains", "containsany", "containsrune", "excludes", "excludesall", "excludesrune",
+			"startswith", "endswith", "startsnotwith", "endsnotwith", "eq", "ne", "eq_ignore_case", "ne_ignore_case", "oneof", "oneofci", "noneof", "noneofci"}) {
+		case "contains":
+			tag, want = "contains="+escParam(p), strings.Contains(s, p)
+		case "containsany":
+			tag, want = "containsany="+escParam(p), strings.ContainsAny(s, p)
+		case "containsrune":
+			if p == "" {
+				return
+			}
+			r := []rune(p)[0]
+			tag, want = "containsrune="+escParam(string(r)), strings.ContainsRune(s, r)
+		case "excludes":
+			tag, want = "excludes="+escParam(p), !strings.Contains(s, p)
+		case "excludesall":
+			tag, want = "excludesall="+escParam(p), !strings.ContainsAny(s, p)
+		case "excludesrune":
+			if p == "" {
+				return
+			}
+			r := []rune(p)[0]
+			tag, want = "excludesrune="+escParam(string(r)), !strings.ContainsRune(s, r)
+		case "startswith":
+			tag, want = "startswith="+escParam(p), strings.HasPrefix(s, p)
+		case "endswith":
+			tag, want = "endswith="+escParam(p), strings.HasSuffix(s, p)
+		case "startsnotwith":
+			tag, want = "startsnotwith="+escParam(p), !strings.HasPrefix(s, p)
+		case "endsnotwith":
+			tag, want = "endsnotwith="+escParam(p), !strings.HasSuffix(s, p)
+		case "eq":
+			tag, want = "eq="+escParam(p), s == p
+		case "ne":
+			tag, want = "ne="+escParam(p), s != p
+		case "eq_ignore_case":
+			tag, want = "eq_ignore_case="+escParam(p), strings.EqualFold(s, p)
+		case "ne_ignore_case":
+			tag, want = "ne_ignore_case="+escParam(p), !strings.EqualFold(s, p)
+		default:
+			// oneof family: a set of two or three values, some with spaces (quoted)
+			var vals []string
+			for k := n(ht, 1, 3); k > 0; k-- {
+				vals = append(vals, genRunes(ht, []rune("abé ,"), 0, 3))
+			}
+			if chance(ht, 40) {
+				vals = append(vals, s)
+			}
+			var parts []string
+			for _, x := range vals {
+				if strings.ContainsAny(x, " ") || x == "" {
+					parts = append(parts, "'"+escParam(x)+"'")
+				} else {
+					parts = append(parts, escParam(x))
+				}
+			}
+			name := pick(ht, []string{"oneof", "oneofci", "noneof", "noneofci"})
+			tag = name + "=" + strings.Join(parts, " ")
+			in := false
+			for _, x := range vals {
+				// an empty quoted value '' is the member ""
+				if x == s || (strings.HasSuffix(name, "ci") && strings.EqualFold(x, s)) {
+					in = true
+				}
+			}
+			want = in == strings.HasPrefix(name, "oneof")
+		}
+		c.count(strings.SplitN(tag, "=", 2)[0])
+		errs, bad := errsOf(val.Var(s, tag))
+		if bad != "" {
+			c.fail(ht, "Var(%q, %q): %s", s, tag, bad)
+			return
+		}
+		if (len(errs) == 0) != want {
+			c.fail(ht, "Var(%q, %q) = %v, want pass=%v", s, tag, errs, want)
+		}
+	})
+}
