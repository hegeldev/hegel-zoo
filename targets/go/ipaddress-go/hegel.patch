+// ---------------------------------------------------------------------------
+// Subnets as sets: the model is the per-segment ranges.
+
+type segRanges struct {
+	lo, hi []int
+}
+
+func ranges(addr *ipaddr.IPAddress) segRanges {
+	var r segRanges
+	for i := 0; i < addr.GetSegmentCount(); i++ {
+		seg := addr.GetSegment(i)
+		r.lo = append(r.lo, int(seg.GetSegmentValue()))
+		r.hi = append(r.hi, int(seg.GetUpperSegmentValue()))
+	}
+	return r
+}
+
+// seqBlocks is the number of sequential blocks the subnet splits into: the
+// product of the range sizes of the segments before the last non-full one.
+// A subnet like *.*.*.180 splits into 16 million of them, more than a test
+// case should ask the library to build.
+func (r segRanges) seqBlocks() int64 {
+	last := 0
+	for i := range r.lo {
+		if r.lo[i] != 0 || r.hi[i] != 255 {
+			last = i
+		}
+	}
+	blocks := int64(1)
+	for i := 0; i < last; i++ {
+		blocks *= int64(r.hi[i] - r.lo[i] + 1)
+	}
+	return blocks
+}
+
+// fewSeqBlocks reports a subnet that splits into at most 4000 sequential
+// blocks (as seqBlocks counts them), so that spanning it is cheap.
+func fewSeqBlocks(addr *ipaddr.IPAddress) bool {
+	last := 0
+	for i := 0; i < addr.GetSegmentCount(); i++ {
+		if !addr.GetSegment(i).IsFullRange() {
+			last = i
+		}
+	}
+	blocks := int64(1)
+	for i := 0; i < last; i++ {
+		seg := addr.GetSegment(i)
+		blocks *= int64(seg.GetUpperSegmentValue()-seg.GetSegmentValue()) + 1
+		if blocks > 4000 {
+			return false
+		}
+	}
+	return true
+}
+
+func (r segRanges) count() *big.Int {
+	c := big.NewInt(1)
+	for i := range r.lo {
+		c.Mul(c, big.NewInt(int64(r.hi[i]-r.lo[i]+1)))
+	}
+	return c
+}
+
+func (r segRanges) member(x []int) bool {
+	for i := range r.lo {
+		if x[i] < r.lo[i] || x[i] > r.hi[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func (r segRanges) within(o segRanges) bool {
+	for i := range r.lo {
+		if r.lo[i] < o.lo[i] || r.hi[i] > o.hi[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func (r segRanges) disjoint(o segRanges) bool {
+	for i := range r.lo {
+		if r.hi[i] < o.lo[i] || o.hi[i] < r.lo[i] {
+			return true
+		}
+	}
+	return false
+}
+
+func segsOf(addr *ipaddr.IPAddress) []int {
+	r := ranges(addr)
+	return r.lo
+}
+
+// ipv4From builds a single IPv4 address from segment values.
+func ipv4From(x []int) *ipaddr.IPAddress {
+	a, _ := ipaddr.NewIPv4AddressFromBytes([]byte{byte(x[0]), byte(x[1]), byte(x[2]), byte(x[3])})
+	return a.ToIP()
+}
+
+// sampleNear draws IPv4 addresses in and around the subnets.
+func sampleNear(tc hegel.TestCase, subnets ...*ipaddr.IPAddress) [][]int {
+	var out [][]int
+	k := n(tc, 4, 12)
+	for i := 0; i < k; i++ {
+		x := make([]int, 4)
+		src := subnets[n(tc, 0, len(subnets)-1)]
+		r := ranges(src)
+		for j := range x {
+			switch n(tc, 1, 6) {
+			case 1:
+				x[j] = n(tc, 0, 255)
+			case 2:
+				x[j] = clamp(r.lo[j]-1, 0, 255)
+			case 3:
+				x[j] = clamp(r.hi[j]+1, 0, 255)
+			case 4:
+				x[j] = r.lo[j]
+			case 5:
+				x[j] = r.hi[j]
+			default:
+				x[j] = n(tc, r.lo[j], r.hi[j])
+			}
+		}
+		out = append(out, x)
+	}
+	return out
+}
+
+func clamp(v, lo, hi int) int {
+	if v < lo {
+		return lo
+	}
+	if v > hi {
+		return hi
+	}
+	return v
+}
+
+func genIPv4Subnet(tc hegel.TestCase) *ipaddr.IPAddress {
+	for i := 0; i < 20; i++ {
+		s := wideIPv4(tc)
+		if _, addr := parse(s); addr != nil {
+			return addr
+		}
+	}
+	return ipv4From([]int{1, 2, 3, 4})
+}
+
+// TestHegelIPv4SubnetsAreSets: ipaddr's subnet operations agree with the
+// per-segment-range model: counts, membership, intersection, subtraction,
+// spanning with prefix and sequential blocks, merging, covering,
+// sequential ranges and iteration.
+func TestHegelIPv4SubnetsAreSets(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		A := genIPv4Subnet(ht)
+		B := genIPv4Subnet(ht)
+		rA, rB := ranges(A), ranges(B)
+		desc := fmt.Sprintf("A = %s, B = %s", A.ToNormalizedString(), B.ToNormalizedString())
+		if A.GetCount().Cmp(rA.count()) != 0 {
+			fail(ht, "%s: A.GetCount() = %v, the segment ranges give %v", desc, A.GetCount(), rA.count())
+		}
+		samples := sampleNear(ht, A, B)
+		for _, x := range samples {
+			xa := ipv4From(x)
+			if A.Contains(xa) != rA.member(x) {
+				fail(ht, "%s: A.Contains(%s) = %v, want %v", desc, xa, A.Contains(xa), rA.member(x))
+			}
+		}
+		// Intersection.
+		I := A.Intersect(B)
+		if (I != nil) != !rA.disjoint(rB) {
+			fail(ht, "%s: Intersect = %v, but the ranges are disjoint = %v", desc, I, rA.disjoint(rB))
+		}
+		if A.Overlaps(B) != !rA.disjoint(rB) {
+			fail(ht, "%s: Overlaps = %v, but the ranges are disjoint = %v", desc, A.Overlaps(B), rA.disjoint(rB))
+		}
+		if I != nil {
+			rI := ranges(I)
+			for i := range rI.lo {
+				if rI.lo[i] != max(rA.lo[i], rB.lo[i]) || rI.hi[i] != min(rA.hi[i], rB.hi[i]) {
+					fail(ht, "%s: Intersect = %s, want segment %d in %d-%d", desc, I.ToNormalizedString(), i, max(rA.lo[i], rB.lo[i]), min(rA.hi[i], rB.hi[i]))
+				}
+			}
+		}
+		// Subtraction.
+		D := A.Subtract(B)
+		for i, d := range D {
+			rd := ranges(d)
+			if !rd.within(rA) {
+				fail(ht, "%s: Subtract result %s is not within A", desc, d.ToNormalizedString())
+			}
+			if !rd.disjoint(rB) {
+				fail(ht, "%s: Subtract result %s overlaps B", desc, d.ToNormalizedString())
+			}
+			for j := 0; j < i; j++ {
+				if !rd.disjoint(ranges(D[j])) {
+					fail(ht, "%s: Subtract results %s and %s overlap", desc, D[j].ToNormalizedString(), d.ToNormalizedString())
+				}
+			}
+		}
+		for _, x := range samples {
+			want := rA.member(x) && !rB.member(x)
+			got := false
+			for _, d := range D {
+				if ranges(d).member(x) {
+					got = true
+				}
+			}
+			if got != want {
+				fail(ht, "%s: A - B = %v: contains %s = %v, want %v", desc, D, ipv4From(x), got, want)
+			}
+		}
+		if rA.disjoint(rB) && !(len(D) == 1 && D[0].Equal(A)) {
+			fail(ht, "%s: disjoint, but A - B = %v, not [A]", desc, D)
+		}
+		if self := A.Subtract(A); len(self) != 0 {
+			fail(ht, "%s: A - A = %v", desc, self)
+		}
+		// Spanning: the blocks are disjoint, of the promised kind, and their
+		// union is the subnet's own set (or, for a non-sequential subnet, the
+		// range from its lowest to its highest address, which is what the
+		// documentation of the Span methods describes).
+		checkSpan := func(name string, blocks []*ipaddr.IPAddress, each func(*ipaddr.IPAddress) bool, eachName string) {
+			total := big.NewInt(0)
+			for _, b := range blocks {
+				if !each(b) {
+					fail(ht, "%s: %s gives %s, not %s", desc, name, b.ToNormalizedString(), eachName)
+				}
+				total.Add(total, b.GetCount())
+			}
+			if len(blocks) <= 400 {
+				for i, b := range blocks {
+					rb := ranges(b)
+					for j := 0; j < i; j++ {
+						if !rb.disjoint(ranges(blocks[j])) {
+							fail(ht, "%s: %s gives overlapping %s and %s", desc, name, blocks[j].ToNormalizedString(), b.ToNormalizedString())
+						}
+					}
+				}
+			} else {
+				count(name + " gives more than 400 blocks (pairwise check skipped)")
+			}
+			lower, upper := segsOf(A.GetLower()), segsOf(A.GetUpper())
+			rangeCount := new(big.Int).Sub(A.GetUpper().GetValue(), A.GetLower().GetValue())
+			rangeCount.Add(rangeCount, big.NewInt(1))
+			isSet := total.Cmp(rA.count()) == 0
+			isRange := total.Cmp(rangeCount) == 0
+			for _, x := range samples {
+				got := false
+				for _, b := range blocks {
+					if ranges(b).member(x) {
+						got = true
+						break
+					}
+				}
+				inRange := cmpSegs(x, lower) >= 0 && cmpSegs(x, upper) <= 0
+				isSet = isSet && got == rA.member(x)
+				isRange = isRange && got == inRange
+			}
+			switch {
+			case isSet && isRange:
+			case isSet:
+				count(name + " spans the subnet's own set")
+			case isRange:
+				count(name + " spans the range lower..upper")
+			default:
+				fail(ht, "%s: %s = %v (%d blocks, %v addresses) is neither the subnet (%v addresses) nor its range (%v addresses)", desc, name, blocks, len(blocks), total, rA.count(), rangeCount)
+			}
+		}
+		if rA.seqBlocks() <= 4000 {
+			checkSpan("SpanWithPrefixBlocks", A.SpanWithPrefixBlocks(), (*ipaddr.IPAddress).IsPrefixBlock, "a prefix block")
+			checkSpan("SpanWithSequentialBlocks", A.SpanWithSequentialBlocks(), (*ipaddr.IPAddress).IsSequential, "sequential")
+		} else {
+			count("A splits into more than 4000 sequential blocks (span skipped)")
+		}
+		if !A.IsSequential() {
+			count("non-sequential A")
+		}
+		cover := A.CoverWithPrefixBlock()
+		if !cover.IsPrefixBlock() || !cover.Contains(A) {
+			fail(ht, "%s: CoverWithPrefixBlock = %s", desc, cover.ToNormalizedString())
+		}
+		if pl, _ := prefixLen(cover); pl != commonPrefix(A.GetLower().Bytes(), A.GetUpper().Bytes()) {
+			fail(ht, "%s: CoverWithPrefixBlock = %s, the common prefix of %s and %s is %d bits", desc, cover.ToNormalizedString(), A.GetLower(), A.GetUpper(), commonPrefix(A.GetLower().Bytes(), A.GetUpper().Bytes()))
+		}
+		// Merging.
+		var M []*ipaddr.IPAddress
+		merged := rA.seqBlocks()+rB.seqBlocks() <= 4000
+		if merged {
+			M = A.MergeToPrefixBlocks(B)
+		} else {
+			count("A and B split into more than 4000 sequential blocks (merge skipped)")
+		}
+		for i, m := range M {
+			if !m.IsPrefixBlock() {
+				fail(ht, "%s: MergeToPrefixBlocks gives %s, not a prefix block", desc, m.ToNormalizedString())
+			}
+			if len(M) > 400 {
+				continue
+			}
+			for j := 0; j < i; j++ {
+				if !ranges(m).disjoint(ranges(M[j])) {
+					fail(ht, "%s: MergeToPrefixBlocks gives overlapping %s and %s", desc, M[j].ToNormalizedString(), m.ToNormalizedString())
+				}
+			}
+		}
+		for _, x := range samples {
+			if !merged {
+				break
+			}
+			got := false
+			for _, m := range M {
+				if ranges(m).member(x) {
+					got = true
+				}
+			}
+			if want := rA.member(x) || rB.member(x); got != want {
+				fail(ht, "%s: MergeToPrefixBlocks = %v: contains %s = %v, want %v", desc, M, ipv4From(x), got, want)
+			}
+		}
+		// Sequential ranges.
+		R := A.ToSequentialRange()
+		lower, upper := A.GetLower(), A.GetUpper()
+		if !R.GetLower().Equal(lower.WithoutPrefixLen()) || !R.GetUpper().Equal(upper.WithoutPrefixLen()) {
+			fail(ht, "%s: ToSequentialRange = %s, want %s -> %s", desc, R, lower, upper)
+		}
+		rangeCount := new(big.Int).Sub(upper.GetValue(), lower.GetValue())
+		rangeCount.Add(rangeCount, big.NewInt(1))
+		if R.GetCount().Cmp(rangeCount) != 0 {
+			fail(ht, "%s: range %s has count %v, want %v", desc, R, R.GetCount(), rangeCount)
+		}
+		for _, x := range samples {
+			xa := ipv4From(x)
+			want := cmpSegs(x, segsOf(lower)) >= 0 && cmpSegs(x, segsOf(upper)) <= 0
+			if R.Contains(xa) != want {
+				fail(ht, "%s: range %s Contains(%s) = %v, want %v", desc, R, xa, R.Contains(xa), want)
+			}
+		}
+		RB := B.ToSequentialRange()
+		RI := R.Intersect(RB)
+		lo := maxAddr(lower, B.GetLower())
+		hi := minAddr(upper, B.GetUpper())
+		if (RI != nil) != (lo.Compare(hi) <= 0) {
+			fail(ht, "%s: ranges %s and %s: Intersect = %v", desc, R, RB, RI)
+		}
+		if RI != nil && (!RI.GetLower().Equal(lo.WithoutPrefixLen()) || !RI.GetUpper().Equal(hi.WithoutPrefixLen())) {
+			fail(ht, "%s: ranges %s and %s: Intersect = %s, want %s -> %s", desc, R, RB, RI, lo, hi)
+		}
+		// Iteration.
+		if A.GetCount().Cmp(big.NewInt(2048)) <= 0 {
+			it := A.Iterator()
+			var prev *ipaddr.IPAddress
+			seen := 0
+			for it.HasNext() {
+				x := it.Next()
+				seen++
+				if seen > 2048 {
+					fail(ht, "%s: Iterator does not end after %d addresses (GetCount %v), last %s", desc, seen, A.GetCount(), x)
+				}
+				if x.IsMultiple() || !rA.member(segsOf(x)) {
+					fail(ht, "%s: Iterator yields %s", desc, x)
+				}
+				if prev != nil && prev.Compare(x) >= 0 {
+					fail(ht, "%s: Iterator yields %s after %s", desc, x, prev)
+				}
+				prev = x
+			}
+			if int64(seen) != A.GetCount().Int64() {
+				fail(ht, "%s: Iterator yields %d addresses, GetCount %v", desc, seen, A.GetCount())
+			}
+		}
+	})
+}
+
+func cmpSegs(a, b []int) int {
+	for i := range a {
+		if a[i] != b[i] {
+			return sign(a[i] - b[i])
+		}
+	}
+	return 0
+}
+
+func maxAddr(a, b *ipaddr.IPAddress) *ipaddr.IPAddress {
+	if a.Compare(b) >= 0 {
+		return a
+	}
+	return b
+}
+
+func minAddr(a, b *ipaddr.IPAddress) *ipaddr.IPAddress {
+	if a.Compare(b) <= 0 {
+		return a
+	}
+	return b
+}
+
+// commonPrefix is the number of leading bits a and b share.
+func commonPrefix(a, b []byte) int {
+	for i := range a {
+		if a[i] != b[i] {
+			x := a[i] ^ b[i]
+			bits := 0
+			for x&0x80 == 0 {
+				x <<= 1
+				bits++
+			}
+			return i*8 + bits
+		}
+	}
+	return len(a) * 8
+}
+
+// trieKey is the model's key for an address: the trie treats an address
+// with the full prefix length as the address without a prefix (documented
+// on its nodes), so the model does too.
+func trieKey(a *ipaddr.IPv4Address) string {
+	if p := a.GetPrefixLen(); p != nil && p.Len() == 32 {
+		a = a.WithoutPrefixLen()
+	}
+	return a.ToNormalizedString()
+}
+
+// triePrefixLen is the prefix length of a key, 32 for a single address.
+func triePrefixLen(a *ipaddr.IPv4Address) int {
+	if p := a.GetPrefixLen(); p != nil {
+		return int(p.Len())
+	}
+	return 32
+}
+
+// TestHegelTrieMatchesBruteForce: an IPv4 address trie of prefix blocks
+// and addresses answers Contains, ElementContains and LongestPrefixMatch
+// as a scan of its keys does, and its size and iteration match the keys.
+func TestHegelTrieMatchesBruteForce(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		trie := ipaddr.NewIPv4AddressTrie()
+		keys := map[string]*ipaddr.IPv4Address{}
+		k := n(ht, 0, 12)
+		var keyList []*ipaddr.IPv4Address
+		for i := 0; i < k; i++ {
+			x := []int{octet(ht), octet(ht), octet(ht), octet(ht)}
+			key := ipv4From(x).ToIPv4()
+			if chance(ht, 70) {
+				key = key.SetPrefixLen(ipaddr.BitCount(pick(ht, 0, 8, 16, 24, 31, 32, n(ht, 0, 32)))).ToPrefixBlock()
+			}
+			ks := trieKey(key)
+			_, dup := keys[ks]
+			added := trie.Add(key)
+			if added == dup {
+				fail(ht, "trie.Add(%s) = %v, already present = %v", ks, added, dup)
+			}
+			if !dup {
+				keys[ks] = key
+				keyList = append(keyList, key)
+			}
+		}
+		if trie.Size() != len(keys) {
+			fail(ht, "trie has %d keys, Size() = %d", len(keys), trie.Size())
+		}
+		for i := 0; i < n(ht, 1, 8); i++ {
+			x := []int{octet(ht), octet(ht), octet(ht), octet(ht)}
+			probe := ipv4From(x).ToIPv4()
+			if chance(ht, 40) {
+				probe = probe.SetPrefixLen(ipaddr.BitCount(n(ht, 0, 32))).ToPrefixBlock()
+			}
+			_, exact := keys[trieKey(probe)]
+			if trie.Contains(probe) != exact {
+				fail(ht, "trie %v: Contains(%s) = %v, want %v", keyList, probe, trie.Contains(probe), exact)
+			}
+			var longest *ipaddr.IPv4Address
+			for _, key := range keyList {
+				if key.Contains(probe) {
+					if longest == nil || triePrefixLen(key) > triePrefixLen(longest) {
+						longest = key
+					}
+				}
+			}
+			if trie.ElementContains(probe) != (longest != nil) {
+				fail(ht, "trie %v: ElementContains(%s) = %v, want %v", keyList, probe, trie.ElementContains(probe), longest != nil)
+			}
+			lpm := trie.LongestPrefixMatch(probe)
+			switch {
+			case lpm == nil && longest != nil, lpm != nil && longest == nil:
+				fail(ht, "trie %v: LongestPrefixMatch(%s) = %v, want %v", keyList, probe, lpm, longest)
+			case lpm != nil && !lpm.Equal(longest):
+				fail(ht, "trie %v: LongestPrefixMatch(%s) = %s, want %s", keyList, probe, lpm, longest)
+			}
+		}
+		it := trie.Iterator()
+		seen := 0
+		for it.HasNext() {
+			x := it.Next()
+			seen++
+			if _, ok := keys[trieKey(x)]; !ok {
+				fail(ht, "trie %v: Iterator yields %s, not a key", keyList, x)
+			}
+		}
+		if seen != len(keys) {
+			fail(ht, "trie %v: Iterator yields %d keys of %d", keyList, seen, len(keys))
+		}
+		if len(keyList) > 0 {
+			victim := keyList[n(ht, 0, len(keyList)-1)]
+			if !trie.Remove(victim) || trie.Contains(victim) || trie.Size() != len(keys)-1 {
+				fail(ht, "trie %v: after Remove(%s): Contains %v, Size %d", keyList, victim, trie.Contains(victim), trie.Size())
+			}
+		}
+	})
+}
+
+// TestHegelNeverPanics: any string goes through parsing and the common
+// operations without a panic, and Validate agrees with IsValid.
+func TestHegelNeverPanics(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var s string
+		switch n(ht, 1, 3) {
+		case 1:
+			s = soup(ht)
+		case 2:
+			s = mutateAddress(ht, wideAddress(ht))
+		default:
+			s = wideAddress(ht)
+		}
+		gs := ipaddr.NewIPAddressString(s)
+		valid := gs.IsValid()
+		if (gs.Validate() == nil) != valid {
+			fail(ht, "%q: IsValid %v but Validate %v", s, valid, gs.Validate())
+		}
+		_ = gs.String()
+		_ = gs.ToNormalizedString()
+		_ = gs.GetNetworkPrefixLen()
+		addr := gs.GetAddress()
+		if addr == nil {
+			if valid {
+				count("valid, no address")
+			} else {
+				count("invalid")
+			}
+			return
+		}
+		count("address")
+		_ = addr.ToCanonicalString()
+		_ = addr.ToNormalizedString()
+		_ = addr.ToFullString()
+		_ = addr.ToCanonicalWildcardString()
+		_ = addr.GetCount()
+		_ = addr.ToPrefixBlock()
+		_ = addr.GetLower()
+		_ = addr.GetUpper()
+		_ = addr.ToSequentialRange()
+		if fewSeqBlocks(addr) {
+			_ = addr.SpanWithPrefixBlocks()
+			_ = addr.SpanWithSequentialBlocks()
+		} else {
+			count("too many sequential blocks to span")
+		}
+		_ = addr.CoverWithPrefixBlock()
+		_ = addr.Increment(1)
+		_ = addr.Increment(-1)
+		_ = addr.WithoutPrefixLen()
+		_ = addr.AssignPrefixForSingleBlock()
+		_ = addr.AssignMinPrefixForBlock()
+		_ = addr.IsLoopback()
+		_ = addr.IsLinkLocal()
+		_ = addr.IsMulticast()
+		_ = addr.IsLocal()
+		if addr.IsIPv6() {
+			_, _ = addr.ToIPv6().ToMixedString()
+			_, _ = addr.ToIPv6().ToReverseDNSString()
+			_, _ = addr.ToIPv6().ToBase85String()
+			_ = addr.ToIPv6().WithoutZone()
+		} else {
+			_, _ = addr.ToIPv4().ToReverseDNSString()
+			_, _ = addr.ToIPv4().ToInetAtonJoinedString(ipaddr.Inet_aton_radix_octal, 1)
+		}
+		if addr.Compare(addr) != 0 || !addr.Equal(addr) {
+			fail(ht, "%q: not equal to itself", s)
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..3938873
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,313 @@
+package hegel
+
+// Hegel property tests for ipaddress-go's ipaddr package. Generated address
+// strings are parsed by ipaddr, by Python's ipaddress module (a child
+// process speaking one JSON line each way, oracle.py) and by Go's
+// net/netip in process, and the three are compared; ipaddr's own strings,
+// subnets, ranges and tries are checked against what they promise.
+//
+// Needs python3 (the ipaddress module is in its standard library).
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// ---------------------------------------------------------------------------
+// The oracle: Python's ipaddress in a child process, one JSON line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// call sends one JSON request and returns the answer object.
+func (o *oracle) call(req map[string]any) (map[string]any, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return nil, o.err
+	}
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := o.in.Write(append(line, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	resp, err := o.out.ReadBytes('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return nil, err
+	}
+	var m map[string]any
+	if err := json.Unmarshal(resp, &m); err != nil {
+		return nil, fmt.Errorf("%s oracle: bad answer %.200q: %v", o.name, resp, err)
+	}
+	if e, isErr := m["error"]; isErr {
+		return nil, fmt.Errorf("%s oracle failed on %v: %v", o.name, req, e)
+	}
+	return m, nil
+}
+
+var (
+	pyOnce sync.Once
+	py     *oracle
+)
+
+func pyOracle() *oracle {
+	pyOnce.Do(func() { py = startOracle("python ipaddress", "python3", "-u", "oracle.py") })
+	return py
+}
+
+// pyParse is Python's reading of an address, interface or network string.
+type pyParse struct {
+	ok      bool
+	err     string
+	version int
+	packed  []byte
+	// compressed is str(address) without zone; withPrefixLen str(interface)
+	// (zone included, "/len" when the string had one).
+	compressed, exploded, withPrefixLen, reversePointer string
+	zone                                                string
+	hasPrefix                                           bool
+	prefixLen                                           int
+	network, broadcast, netmask, hostmask               []byte
+	loopback, linkLocal, multicast, unspecified         bool
+	private, global, reserved                           bool
+	ipv4Mapped, sixToFour                               []byte // nil when not such an address
+	teredo                                              [][]byte
+}
+
+func unhex(v any) []byte {
+	s, _ := v.(string)
+	b, _ := hex.DecodeString(s)
+	return b
+}
+
+func str(v any) string {
+	s, _ := v.(string)
+	return s
+}
+
+func boolean(v any) bool {
+	b, _ := v.(bool)
+	return b
+}
+
+func pythonParse(t testing.TB, s string) pyParse {
+	m, err := pyOracle().call(map[string]any{"op": "parse", "s": s})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	p := pyParse{ok: boolean(m["ok"])}
+	if !p.ok {
+		p.err = str(m["reason"])
+		return p
+	}
+	v, _ := m["version"].(float64)
+	p.version = int(v)
+	p.packed = unhex(m["packed"])
+	p.compressed = str(m["compressed"])
+	p.exploded = str(m["exploded"])
+	p.withPrefixLen = str(m["with_prefixlen"])
+	p.reversePointer = str(m["reverse_pointer"])
+	p.zone = str(m["zone"])
+	if pl, ok := m["prefixlen"].(float64); ok {
+		p.hasPrefix, p.prefixLen = true, int(pl)
+	}
+	p.network, p.broadcast, p.netmask, p.hostmask = unhex(m["network"]), unhex(m["broadcast"]), unhex(m["netmask"]), unhex(m["hostmask"])
+	p.loopback, p.linkLocal, p.multicast, p.unspecified = boolean(m["is_loopback"]), boolean(m["is_link_local"]), boolean(m["is_multicast"]), boolean(m["is_unspecified"])
+	p.private, p.global, p.reserved = boolean(m["is_private"]), boolean(m["is_global"]), boolean(m["is_reserved"])
+	if m["ipv4_mapped"] != nil {
+		p.ipv4Mapped = unhex(m["ipv4_mapped"])
+	}
+	if m["sixtofour"] != nil {
+		p.sixToFour = unhex(m["sixtofour"])
+	}
+	if td, ok := m["teredo"].([]any); ok && len(td) == 2 {
+		p.teredo = [][]byte{unhex(td[0]), unhex(td[1])}
+	}
+	return p
+}
+
+// pythonAdd is address + n, or ok=false when Python says it leaves the space.
+func pythonAdd(t testing.TB, s string, delta int64) (packed []byte, ok bool) {
+	m, err := pyOracle().call(map[string]any{"op": "add", "s": s, "n": delta})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	if !boolean(m["ok"]) {
+		return nil, false
+	}
+	return unhex(m["packed"]), true
+}
+
+func pythonCompare(t testing.TB, a, b string) int {
+	m, err := pyOracle().call(map[string]any{"op": "cmp", "a": a, "b": b})
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	c, _ := m["cmp"].(float64)
+	return int(c)
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..c4a26d8
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,64 @@
+package hegel
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/seancfoley/ipaddress-go/ipaddr"
+)
+
+// Known bugs of ipaddress-go at the pinned commit, gated so the properties
+// stay green while they are open. Each rule names the zoo's bug id; the
+// pins in hegel_pins_test.go fail while the bug is open.
+
+// caseInfo describes a failing case for the gates.
+type caseInfo struct {
+	prop  string            // which property
+	input string            // the address string
+	what  string            // which check failed
+	msg   string            // the failure as it would be reported
+	addr  *ipaddr.IPAddress // the parsed input, when there is one
+}
+
+// known returns the id of the bug that explains the case, or "".
+func known(c caseInfo) string {
+	switch {
+	case c.prop == "round-trip" && c.what == "ToFullString" && !strings.Contains(c.input, ":"):
+		// ipaddress-go/1: IPv4 ToFullString pads segments with zeros, which the
+		// default parser reads as octal (inet_aton).
+		return "ipaddress-go/1"
+	case c.prop == "round-trip" && c.what == "ToMixedString" && c.msg == "does not parse" && prefixInsideMixedTail(c.input):
+		// ipaddress-go/2: the mixed string of a CIDR subnet whose prefix
+		// length falls inside the last two segments, off their boundaries,
+		// is a string the library's own parser refuses.
+		return "ipaddress-go/2"
+	case c.prop == "round-trip" && c.what == "ToMixedString" && strings.Contains(c.msg, "parses to") && zeroedMixedTail(c.addr):
+		// ipaddress-go/3: the mixed string of a prefixed subnet that is not
+		// a prefix block prints wildcard last segments as 0.0.0.0.
+		return "ipaddress-go/3"
+	}
+	return ""
+}
+
+// prefixInsideMixedTail reports an IPv6 string with a prefix length in
+// 97..111 or 113..127, the lengths that cut a segment of the mixed tail.
+func prefixInsideMixedTail(s string) bool {
+	if !strings.Contains(s, ":") {
+		return false
+	}
+	i := strings.LastIndex(s, "/")
+	if i < 0 {
+		return false
+	}
+	p, err := strconv.Atoi(strings.TrimSpace(s[i+1:]))
+	return err == nil && p > 96 && p < 128 && p != 112
+}
+
+// zeroedMixedTail reports a prefixed IPv6 subnet, not a prefix block, whose
+// last two segments are full wildcards: the case ipaddress-go/3 mangles.
+func zeroedMixedTail(a *ipaddr.IPAddress) bool {
+	if a == nil || !a.IsIPv6() || !a.IsPrefixed() || a.IsPrefixBlock() {
+		return false
+	}
+	return a.GetSegment(6).IsFullRange() && a.GetSegment(7).IsFullRange()
+}
diff --git a/hegel/oracle.py b/hegel/oracle.py
new file mode 100644
index 0000000..4013376
--- /dev/null
+++ b/hegel/oracle.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Python ipaddress oracle for the ipaddress-go hegel tests: one JSON object per line in,
+one per line out.
+
+  {"op": "parse", "s": str}
+      -> {"ok": false, "reason": "..."} when ipaddress rejects the string as an address,
+         interface or network, else
+         {"ok": true, "kind": "address"|"interface", "version": 4|6, "packed": hex,
+          "compressed": str, "exploded": str, "zone": str|null,
+          "prefixlen": int|null, "network": hex, "broadcast": hex, "netmask": hex, "hostmask": hex,
+          "reverse_pointer": str, "is_loopback", "is_link_local", "is_multicast",
+          "is_unspecified", "is_private", "is_global", "is_reserved": bool,
+          "ipv4_mapped": hex|null, "sixtofour": hex|null, "teredo": [hex, hex]|null}
+  {"op": "add", "s": str, "n": int}  -> {"ok": bool, "packed": hex}   (address + n)
+  {"op": "cmp", "a": str, "b": str}  -> {"cmp": -1|0|1}                 (addresses)
+"""
+import ipaddress
+import json
+import sys
+
+
+def hexpacked(a):
+    return a.packed.hex()
+
+
+def parse(s):
+    try:
+        iface = ipaddress.ip_interface(s)
+    except ValueError as e:
+        return {"ok": False, "reason": str(e)}
+    addr = iface.ip
+    kind = "interface" if "/" in s else "address"
+    net = iface.network
+    # IPv6Interface.ip drops the scope id in 3.12; read it off the interface's string.
+    head = str(iface).split("/")[0]
+    zone = head.split("%", 1)[1] if "%" in head else None
+    out = {
+        "ok": True,
+        "kind": kind,
+        "version": addr.version,
+        "packed": hexpacked(addr),
+        "compressed": addr.compressed,
+        "exploded": addr.exploded,
+        "zone": zone,
+        "prefixlen": net.prefixlen if kind == "interface" else None,
+        "network": hexpacked(net.network_address),
+        "broadcast": hexpacked(net.broadcast_address),
+        "netmask": hexpacked(net.netmask),
+        "hostmask": hexpacked(net.hostmask),
+        "with_prefixlen": iface.with_prefixlen,
+        "reverse_pointer": addr.reverse_pointer,
+        "is_loopback": addr.is_loopback,
+        "is_link_local": addr.is_link_local,
+        "is_multicast": addr.is_multicast,
+        "is_unspecified": addr.is_unspecified,
+        "is_private": addr.is_private,
+        "is_global": addr.is_global,
+        "is_reserved": addr.is_reserved,
+        "ipv4_mapped": None,
+        "sixtofour": None,
+        "teredo": None,
+    }
+    if addr.version == 6:
+        m = addr.ipv4_mapped
+        out["ipv4_mapped"] = hexpacked(m) if m is not None else None
+        s2 = addr.sixtofour
+        out["sixtofour"] = hexpacked(s2) if s2 is not None else None
+        t = addr.teredo
+        out["teredo"] = [hexpacked(t[0]), hexpacked(t[1])] if t is not None else None
+    return out
+
+
+def add(s, n):
+    a = ipaddress.ip_address(s)
+    try:
+        b = a + n
+    except (ValueError, ipaddress.AddressValueError) as e:
+        return {"ok": False, "reason": str(e)}
+    return {"ok": True, "packed": hexpacked(b)}
+
+
+def cmp(a, b):
+    x, y = ipaddress.ip_address(a), ipaddress.ip_address(b)
+    if x.version != y.version:  # Python orders by version first, but refuses to compare directly
+        return {"cmp": (x.version > y.version) - (x.version < y.version)}
+    return {"cmp": (x > y) - (x < y)}
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        req = json.loads(line)
+        try:
+            if req["op"] == "parse":
+                out = parse(req["s"])
+            elif req["op"] == "add":
+                out = add(req["s"], int(req["n"]))
+            elif req["op"] == "cmp":
+                out = cmp(req["a"], req["b"])
+            else:
+                out = {"error": "oracle: unknown op"}
+        except Exception as e:  # noqa: BLE001
+            out = {"error": "%s: %s" % (type(e).__name__, e)}
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
