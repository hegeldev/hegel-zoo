+// TestHegelStringsRoundTrip: every string form ipaddr produces for an
+// address or subnet parses back to the same address or subnet (with the
+// same prefix length and zone for the forms that carry them).
+func TestHegelStringsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := wideAddress(ht)
+		_, addr := parse(s)
+		if addr == nil {
+			count("invalid")
+			return
+		}
+		if addr.IsIPv6() {
+			count("IPv6")
+		} else {
+			count("IPv4")
+		}
+		type form struct {
+			name  string
+			text  string
+			exact bool // prefix length and zone must survive
+			err   error
+			must  bool // must parse (as against forms parsing may not know)
+		}
+		forms := []form{
+			{"ToCanonicalString", addr.ToCanonicalString(), true, nil, true},
+			{"ToNormalizedString", addr.ToNormalizedString(), true, nil, true},
+			{"ToCompressedString", addr.ToCompressedString(), true, nil, true},
+			{"String", addr.String(), true, nil, true},
+			{"ToCanonicalWildcardString", addr.ToCanonicalWildcardString(), false, nil, true},
+			{"ToNormalizedWildcardString", addr.ToNormalizedWildcardString(), false, nil, true},
+			{"ToFullString", addr.ToFullString(), true, nil, true},
+			{"ToSegmentedBinaryString", addr.ToSegmentedBinaryString(), false, nil, false},
+		}
+		if addr.IsIPv6() {
+			v6 := addr.ToIPv6()
+			m, err := v6.ToMixedString()
+			forms = append(forms, form{"ToMixedString", m, true, err, true})
+			h, err := v6.ToHexString(true)
+			forms = append(forms, form{"ToHexString", h, false, err, false})
+			b, err := v6.ToBinaryString(true)
+			forms = append(forms, form{"ToBinaryString", b, false, err, false})
+			b85, err := v6.ToBase85String()
+			forms = append(forms, form{"ToBase85String", b85, false, err, false})
+			rd, err := v6.ToReverseDNSString()
+			forms = append(forms, form{"ToReverseDNSString", rd, false, err, false})
+			forms = append(forms, form{"ToCompressedWildcardString", v6.ToCompressedWildcardString(), false, nil, true})
+		} else {
+			v4 := addr.ToIPv4()
+			h, err := v4.ToHexString(true)
+			forms = append(forms, form{"ToHexString", h, false, err, false})
+			b, err := v4.ToBinaryString(true)
+			forms = append(forms, form{"ToBinaryString", b, false, err, false})
+			o, err := v4.ToOctalString(true)
+			forms = append(forms, form{"ToOctalString", o, false, err, false})
+			d, err := v4.ToInetAtonJoinedString(ipaddr.Inet_aton_radix_hex, 2)
+			forms = append(forms, form{"ToInetAtonJoinedString(hex,2)", d, false, err, false})
+			rd, err := v4.ToReverseDNSString()
+			forms = append(forms, form{"ToReverseDNSString", rd, false, err, false})
+		}
+		gpl, gHas := prefixLen(addr)
+		for _, f := range forms {
+			if f.err != nil {
+				count(f.name + " error")
+				continue
+			}
+			_, back := parse(f.text)
+			info := caseInfo{prop: "round-trip", input: s, what: f.name, addr: addr}
+			if back == nil {
+				if !f.must {
+					count(f.name + " does not parse back")
+					continue
+				}
+				info.msg = "does not parse"
+				if id := known(info); id != "" {
+					count("known " + id)
+					continue
+				}
+				_, perr := ipaddr.NewIPAddressString(f.text).ToAddress()
+				fail(ht, "%q: %s gives %q, which does not parse: %v", s, f.name, f.text, perr)
+			}
+			if !f.must {
+				count(f.name + " parses back")
+			}
+			same := back.Equal(addr)
+			if f.exact {
+				bpl, bHas := prefixLen(back)
+				same = same && bHas == gHas && bpl == gpl && zoneOf(back) == zoneOf(addr)
+			}
+			if !same {
+				info.msg = fmt.Sprintf("%q parses to %s", f.text, back.ToNormalizedString())
+				if id := known(info); id != "" {
+					count("known " + id)
+					continue
+				}
+				fail(ht, "%q (= %s): %s gives %q, which parses to %s (count %v vs %v)", s, addr.ToNormalizedString(), f.name, f.text, back.ToNormalizedString(), back.GetCount(), addr.GetCount())
+			}
+		}
+		if !addr.IsMultiple() {
+			// Bytes carry neither prefix length nor zone.
+			want := addr.WithoutPrefixLen()
+			if want.IsIPv6() {
+				want = want.ToIPv6().WithoutZone().ToIP()
+			}
+			fromBytes, err := ipaddr.NewIPAddressFromBytes(addr.Bytes())
+			if err != nil || !fromBytes.Equal(want) {
+				fail(ht, "%q: NewIPAddressFromBytes(%x) = %v, %v; want %s", s, addr.Bytes(), fromBytes, err, want)
+			}
+		}
+	})
+}
