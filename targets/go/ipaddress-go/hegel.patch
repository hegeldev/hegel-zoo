+// TestHegelArithmeticLikePython: adding a small number to an address, and
+// comparing two addresses, agree with Python (Python raises when the sum
+// leaves the address space; ipaddr returns nil).
+func TestHegelArithmeticLikePython(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := plainAddress(ht)
+		s := strings.SplitN(a.text, "/", 2)[0]
+		py := pythonParse(ht, s)
+		_, addr := parse(s)
+		if !py.ok || addr == nil || addr.IsMultiple() || py.zone != "" {
+			count("not a plain single address")
+			return
+		}
+		delta := int64(pick(ht, 1, -1, 2, 255, 256, 65535, 65536, -256, 1<<31, -(1 << 31), n(ht, -1000, 1000)))
+		if chance(ht, 20) {
+			delta = int64(n(ht, -1<<40, 1<<40))
+		}
+		got := addr.Increment(delta)
+		want, ok := pythonAdd(ht, s, delta)
+		info := caseInfo{prop: "arithmetic", input: s, what: "Increment"}
+		switch {
+		case ok && got == nil:
+			info.msg = fmt.Sprintf("ipaddr nil, Python %x", want)
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%q + %d: ipaddr gives nil, Python %x", s, delta, want)
+		case !ok && got != nil:
+			info.msg = fmt.Sprintf("ipaddr %s, Python overflow", got)
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "%q + %d: ipaddr gives %s, Python says it leaves the address space", s, delta, got)
+		case ok && !bytes.Equal(got.Bytes(), want):
+			fail(ht, "%q + %d: ipaddr %s, Python %x", s, delta, got, want)
+		case ok:
+			if got.Increment(-delta) == nil || !got.Increment(-delta).Equal(addr) {
+				fail(ht, "%q + %d - %d = %v, not the start", s, delta, delta, got.Increment(-delta))
+			}
+		default:
+			count("overflow on both sides")
+		}
+		b := plainAddress(ht)
+		sb := strings.SplitN(b.text, "/", 2)[0]
+		pyb := pythonParse(ht, sb)
+		_, addrB := parse(sb)
+		if !pyb.ok || addrB == nil || addrB.IsMultiple() || pyb.zone != "" {
+			return
+		}
+		gc, pc := sign(addr.Compare(addrB)), pythonCompare(ht, s, sb)
+		if gc != pc {
+			info.what, info.msg = "Compare", fmt.Sprintf("ipaddr %d, Python %d vs %q", gc, pc, sb)
+			if id := known(info); id != "" {
+				count("known " + id)
+				return
+			}
+			fail(ht, "Compare(%q, %q): ipaddr %d, Python %d", s, sb, gc, pc)
+		}
+	})
+}
+
+func sign(x int) int {
+	switch {
+	case x < 0:
+		return -1
+	case x > 0:
+		return 1
+	}
+	return 0
+}
