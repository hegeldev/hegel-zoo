+package koanf_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the oracle of the wide property that found it (the model and
+// compareState, the getters' model), so that each bug has a property that finds it every run;
+// the wide properties in hegel_props_test.go reach the shapes at their natural rate. Under
+// HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch instead (the
+// conflicting leaf alone, a Set on a fresh path, disjoint providers, a number within range, a
+// map in a single slice, a key without the delimiter) and passes.
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/knadh/koanf/maps"
+	"github.com/knadh/koanf/v2"
+	"hegel.dev/go/hegel"
+)
+
+// setPath is the tree with v at the path: a copy, with maps created (or non-maps replaced)
+// along the way.
+func setPath(tree map[string]any, parts []string, v any) map[string]any {
+	out := deepCopy(tree).(map[string]any)
+	cur := out
+	for _, p := range parts[:len(parts)-1] {
+		next, ok := cur[p].(map[string]any)
+		if !ok {
+			next = map[string]any{}
+			cur[p] = next
+		}
+		cur = next
+	}
+	cur[parts[len(parts)-1]] = deepCopy(v)
+	return out
+}
+
+// flatKeys are the sorted keys of the tree flattened with the delimiter.
+func flatKeys(tree map[string]any, delim string) []string {
+	flat, _ := maps.Flatten(tree, nil, delim)
+	return sortedKeys(flat)
+}
+
+// --------------------------------------------------------------------------- koanf/1
+
+// kindGens: scalar values by dynamic type, so that two kinds apart are two types apart.
+var kindGens = []hegel.Generator[any]{
+	asAny(ints),
+	asAny(strs),
+	asAny(hegel.Booleans()),
+	asAny(floats),
+	asAny(hegel.SampledFrom(someUints)),
+}
+
+// strictCase: a base tree with a leaf of one type at a path, and an incoming map that puts a
+// value of another type at that path, beside one to three scalar leaves under other top-level
+// keys (the shape of koanf/1: the keys the library visits before the conflict are merged, and
+// which those are depends on map iteration order); under HEGEL_NO_KNOWN=1 the conflicting
+// leaf alone, which the library refuses before writing anything.
+type strictCase struct {
+	delim    string
+	base     map[string]any
+	parts    []string
+	old, new any
+	others   map[string]any
+}
+
+// docs are the base tree and the incoming map.
+func (c strictCase) docs() (base, incoming map[string]any) {
+	base = setPath(c.base, c.parts, c.old)
+	incoming = map[string]any{}
+	for k, v := range c.others {
+		if k == c.parts[0] {
+			k += "_"
+		}
+		incoming[k] = v
+	}
+	return base, setPath(incoming, c.parts, c.new)
+}
+
+func (c strictCase) GoString() string {
+	base, incoming := c.docs()
+	return fmt.Sprintf("delim %q base %#v\n  strict Load %#v (a %T over a %T at %q)", c.delim, base, incoming, c.new, c.old, strings.Join(c.parts, c.delim))
+}
+
+var strictCases = hegel.Composite(func(tc hegel.TestCase) strictCase {
+	kind := hegel.Draw(tc, hegel.Integers(0, len(kindGens)-1))
+	shift := hegel.Draw(tc, hegel.Integers(1, len(kindGens)-1))
+	others := shaped[hegel.Generator[map[string]any]](
+		hegel.Map(hegel.Maps(keys, scalars).MinSize(1).MaxSize(3), nonNilMap[string, any]),
+		hegel.Just(map[string]any(nil)),
+	)
+	return strictCase{
+		delim:  hegel.Draw(tc, delims),
+		base:   hegel.Draw(tc, trees),
+		parts:  hegel.Draw(tc, many(keys, 1, 3)),
+		old:    hegel.Draw(tc, kindGens[kind]),
+		new:    hegel.Draw(tc, kindGens[(kind+shift)%len(kindGens)]),
+		others: hegel.Draw(tc, others),
+	}
+})
+
+// TestHegelStrictLoadIsAtomic: a strict Load that fails with a type error leaves the
+// configuration as it was, in every run, and Raw() and Keys() describe the same map; the
+// library has merged the keys visited before the conflict (koanf/1).
+func TestHegelStrictLoadIsAtomic(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, strictCases)
+		base, incoming := tcase.docs()
+		for run := 0; run < 20; run++ {
+			ko := koanf.NewWithConf(koanf.Conf{Delim: tcase.delim, StrictMerge: true})
+			if err := ko.Load(mapProvider(deepCopy(base).(map[string]any)), nil); err != nil {
+				c.fail(ht, "Load of the base: %v", err)
+				return
+			}
+			before := ko.Raw()
+			err := ko.Load(mapProvider(deepCopy(incoming).(map[string]any)), nil)
+			if err == nil {
+				c.fail(ht, "strict Load of a %T over a %T: no error", tcase.new, tcase.old)
+				return
+			}
+			if got := ko.Raw(); !reflect.DeepEqual(got, before) {
+				c.mismatch(ht, "strict partial", known("koanf/1"), "run %d: the strict Load failed with %v but changed the map: %#v -> %#v (Keys() %v)", run, err, before, got, ko.Keys())
+				return
+			}
+			if got, want := ko.Keys(), flatKeys(ko.Raw(), tcase.delim); !reflect.DeepEqual(got, want) {
+				c.mismatch(ht, "keys", known("koanf/1"), "run %d: after the failed strict Load Keys() = %v, the flattened Raw() has %v", run, got, want)
+				return
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- koanf/2
+
+// setMapCase: a tree with a non-empty sub map under a top-level key (so that it has a map
+// path), the map value Set, and the path: one of the tree's map paths, at a position (the
+// shape of koanf/2: the library merges the value into the map there) or, under
+// HEGEL_NO_KNOWN=1, a fresh path (where merging and setting coincide).
+type setMapCase struct {
+	delim string
+	tree  map[string]any
+	top   string
+	sub   map[string]any
+	at    int
+	fresh []string
+	val   map[string]any
+}
+
+// loaded is the configuration before the Set.
+func (c setMapCase) loaded() map[string]any {
+	return setPath(c.tree, []string{c.top}, c.sub)
+}
+
+// mapPaths are the keys and prefixes of the model holding a map, sorted.
+func mapPaths(m *model) []string {
+	var out []string
+	for _, k := range sortedKeys(m.keyMap()) {
+		if _, ok := m.get(k).(map[string]any); ok {
+			out = append(out, k)
+		}
+	}
+	return out
+}
+
+// path is the key path Set.
+func (c setMapCase) path(m *model) string {
+	if Known.setMergesMaps {
+		return m.join(c.fresh) + m.delim + "zz"
+	}
+	mp := mapPaths(m)
+	return mp[c.at%len(mp)]
+}
+
+func (c setMapCase) GoString() string {
+	m := newModel(c.delim)
+	_ = m.merge(c.loaded(), nil, false, false)
+	return fmt.Sprintf("delim %q tree %#v\n  Set(%q, %#v)", c.delim, c.loaded(), c.path(m), c.val)
+}
+
+var setMapCases = hegel.Composite(func(tc hegel.TestCase) setMapCase {
+	return setMapCase{
+		delim: hegel.Draw(tc, delims),
+		tree:  hegel.Draw(tc, trees),
+		top:   hegel.Draw(tc, keys),
+		sub:   hegel.Draw(tc, hegel.Map(hegel.Maps(keys, values).MinSize(1).MaxSize(3), nonNilMap[string, any])),
+		at:    hegel.Draw(tc, positions),
+		fresh: hegel.Draw(tc, many(keys, 1, 2)),
+		val:   hegel.Draw(tc, trees),
+	}
+})
+
+// TestHegelSetWithAMapReplacesTheValue: Set sets the value at the key, a map like a scalar, so
+// afterwards Get returns that value and the state is the model's; the library merges a map
+// value into the existing map at the key (koanf/2).
+func TestHegelSetWithAMapReplacesTheValue(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, setMapCases)
+		m := newModel(tcase.delim)
+		_ = m.merge(tcase.loaded(), nil, false, false)
+		ko := fresh(m, false)
+		path := tcase.path(m)
+		if err := ko.Set(path, deepCopy(tcase.val)); err != nil {
+			c.fail(ht, "Set(%q): %v", path, err)
+			return
+		}
+		_ = m.set(path, tcase.val, false)
+		compareState(c, ht, fmt.Sprintf("Set(%q, %#v)", path, tcase.val), ko, m, known("koanf/2")...)
+	})
+}
+
+// --------------------------------------------------------------------------- koanf/3
+
+// aliasCase: two trees sharing a top-level key that holds a non-empty map in both (the shape
+// of koanf/3: the second Load merges into the first provider's map, which the configuration
+// keeps by reference, and the first provider's interface-keyed maps are rewritten in place);
+// under HEGEL_NO_KNOWN=1 the first provider holds no interface-keyed map and the second's
+// top-level keys are disjoint from its own.
+type aliasCase struct {
+	delim      string
+	first      map[string]any
+	shared     string
+	sub1, sub2 map[string]any
+	second     map[string]any
+}
+
+// docs are the two providers' maps.
+func (c aliasCase) docs() (first, second map[string]any) {
+	first = setPath(c.first, []string{c.shared}, c.sub1)
+	if Known.loadAliasesProvider {
+		first = convertKeys(first, 0).(map[string]any)
+		second = map[string]any{}
+		for k, v := range c.second {
+			if _, dup := first[k]; dup {
+				k += "_"
+			}
+			second[k] = deepCopy(v)
+		}
+		return first, second
+	}
+	return first, setPath(c.second, []string{c.shared}, c.sub2)
+}
+
+func (c aliasCase) GoString() string {
+	first, second := c.docs()
+	return fmt.Sprintf("delim %q first %#v\n  second %#v", c.delim, first, second)
+}
+
+var aliasCases = hegel.Composite(func(tc hegel.TestCase) aliasCase {
+	subs := hegel.Map(hegel.Maps(keys, values).MinSize(1).MaxSize(3), nonNilMap[string, any])
+	return aliasCase{
+		delim:  hegel.Draw(tc, delims),
+		first:  hegel.Draw(tc, trees),
+		shared: hegel.Draw(tc, keys),
+		sub1:   hegel.Draw(tc, subs),
+		sub2:   hegel.Draw(tc, subs),
+		second: hegel.Draw(tc, trees),
+	}
+})
+
+// pokeInto writes into every collection under v: the first element of a slice, a new key of
+// a map.
+func pokeInto(v any) {
+	switch x := v.(type) {
+	case map[string]any:
+		for _, e := range x {
+			pokeInto(e)
+		}
+		x["changed"] = 1
+	case map[any]any:
+		for _, e := range x {
+			pokeInto(e)
+		}
+		x["changed"] = 1
+	case []any:
+		for _, e := range x {
+			pokeInto(e)
+		}
+		if len(x) > 0 {
+			x[0] = "changed"
+		}
+	case []string:
+		if len(x) > 0 {
+			x[0] = "changed"
+		}
+	case []int:
+		if len(x) > 0 {
+			x[0] = 77
+		}
+	case map[string]string:
+		x["changed"] = "1"
+	}
+}
+
+// TestHegelLoadCopiesTheProvider: Load does not keep the provider's map: after a second Load
+// the first provider's map is as it was, and writing into the first provider's data afterwards
+// changes nothing in the configuration; the library stores the provider's maps and slices by
+// reference (koanf/3).
+func TestHegelLoadCopiesTheProvider(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, aliasCases)
+		first, second := tcase.docs()
+		snapshot := deepCopy(first).(map[string]any)
+		ko := koanf.New(tcase.delim)
+		m := newModel(tcase.delim)
+		if err := ko.Load(mapProvider(first), nil); err != nil {
+			c.fail(ht, "first Load: %v", err)
+			return
+		}
+		_ = m.merge(snapshot, nil, false, false)
+		if err := ko.Load(mapProvider(deepCopy(second).(map[string]any)), nil); err != nil {
+			c.fail(ht, "second Load: %v", err)
+			return
+		}
+		_ = m.merge(second, nil, false, false)
+		if !reflect.DeepEqual(first, snapshot) {
+			c.mismatch(ht, "provider", known("koanf/3"), "the first provider's map changed after the Loads: %#v -> %#v", snapshot, first)
+			return
+		}
+		if Known.loadAliasesProvider {
+			return
+		}
+		for _, v := range first {
+			pokeInto(v)
+		}
+		compareState(c, ht, "after writing into the first provider's data", ko, m, append(known("koanf/3"), treeShape(snapshot)...)...)
+	})
+}
+
+// --------------------------------------------------------------------------- koanf/4
+
+// overflowCase: a numeric string beyond float64's range: one digit, a fraction of up to three
+// digits 30% of the time, an exponent of 309 to 999 (the shape of koanf/4) or, under
+// HEGEL_NO_KNOWN=1, of 0 to 307 (within range); negative 30% of the time.
+type overflowCase struct {
+	neg   bool
+	whole int
+	frac  string
+	exp   int
+}
+
+func (c overflowCase) text() string {
+	s := fmt.Sprint(c.whole)
+	if c.frac != "" {
+		s += "." + c.frac
+	}
+	s += fmt.Sprintf("e%d", c.exp)
+	if c.neg {
+		s = "-" + s
+	}
+	return s
+}
+
+// tree holds the text as a value, in a slice and in a map.
+func (c overflowCase) tree() map[string]any {
+	return map[string]any{"v": c.text(), "s": []any{c.text()}, "m": map[string]any{"k": c.text()}}
+}
+
+func (c overflowCase) GoString() string { return fmt.Sprintf("number %q", c.text()) }
+
+var overflowCases = hegel.Composite(func(tc hegel.TestCase) overflowCase {
+	return overflowCase{
+		neg:   hegel.Draw(tc, chance(30)),
+		whole: hegel.Draw(tc, hegel.Integers(1, 9)),
+		frac:  hegel.Draw(tc, maybe(30, hegel.Text().Alphabet("0123456789").MinSize(1).MaxSize(3))),
+		exp:   hegel.Draw(tc, shaped(hegel.Integers(309, 999), hegel.Integers(0, 307))),
+	}
+})
+
+// TestHegelFloat64OutOfRangeIsZero: Float64 returns 0 for a numeric string outside float64's
+// range, as the documentation says for a value that is not a valid float64 and as Float64s and
+// Float64Map do for the same string; the library returns the +/-Inf of strconv's range error
+// (koanf/4).
+func TestHegelFloat64OutOfRangeIsZero(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, overflowCases)
+		m := newModel(".")
+		_ = m.merge(tcase.tree(), nil, false, false)
+		ko := fresh(m, false)
+		for _, p := range []string{"v", "s", "m"} {
+			checkGetters(c, ht, ko, m, p, "2006-01-02")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- koanf/5
+
+// deepIfaceCase: an interface-keyed map wrapped in two or three slices, with up to two scalars
+// beside it in each (the shape of koanf/5: IntfaceKeysToStrings does not descend into a slice
+// inside a slice) or, under HEGEL_NO_KNOWN=1, in one slice; under a key of a tree.
+type deepIfaceCase struct {
+	delim string
+	tree  map[string]any
+	key   string
+	inner map[any]any
+	wraps int
+	fill  []any
+}
+
+// value is the wrapped map.
+func (c deepIfaceCase) value() any {
+	v := any(deepCopy(c.inner))
+	for i := 0; i < c.wraps; i++ {
+		v = append([]any{v}, deepCopy(c.fill).([]any)...)
+	}
+	return v
+}
+
+// loaded is the configuration loaded.
+func (c deepIfaceCase) loaded() map[string]any { return setPath(c.tree, []string{c.key}, c.value()) }
+
+func (c deepIfaceCase) GoString() string {
+	return fmt.Sprintf("delim %q tree %#v", c.delim, c.loaded())
+}
+
+var deepIfaceCases = hegel.Composite(func(tc hegel.TestCase) deepIfaceCase {
+	return deepIfaceCase{
+		delim: hegel.Draw(tc, delims),
+		tree:  hegel.Draw(tc, trees),
+		key:   hegel.Draw(tc, keys),
+		inner: hegel.Draw(tc, ifaceMaps),
+		wraps: hegel.Draw(tc, shaped[hegel.Generator[int]](hegel.Integers(2, 3), hegel.Just(1))),
+		fill:  hegel.Draw(tc, hegel.Map(many(scalars, 0, 2), nonNil[any])),
+	}
+})
+
+// TestHegelNestedSliceMapsAreConverted: every map[any]any in the loaded map becomes a
+// map[string]any, however deep in slices, as IntfaceKeysToStrings is documented to do; the
+// library misses a map inside a slice inside a slice (koanf/5).
+func TestHegelNestedSliceMapsAreConverted(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, deepIfaceCases)
+		tree := tcase.loaded()
+		m := newModel(tcase.delim)
+		_ = m.merge(tree, nil, false, false)
+		ko := koanf.New(tcase.delim)
+		if err := ko.Load(mapProvider(deepCopy(tree).(map[string]any)), nil); err != nil {
+			c.fail(ht, "Load: %v", err)
+			return
+		}
+		compareState(c, ht, fmt.Sprintf("Load(%#v)", tree), ko, m, known("koanf/5")...)
+	})
+}
+
+// --------------------------------------------------------------------------- koanf/6
+
+// delimiterKeyCase: a tree with, under a top-level key, a key made of two or three keys joined
+// with the delimiter ("example.com" under ".": the shape of koanf/6) or, under
+// HEGEL_NO_KNOWN=1, one plain key, holding a map with one leaf; the path to that leaf is Set
+// to another scalar.
+type delimiterKeyCase struct {
+	delim    string
+	tree     map[string]any
+	top      string
+	inner    []string
+	leaf     string
+	old, new any
+}
+
+func (c delimiterKeyCase) key() string { return strings.Join(c.inner, c.delim) }
+
+// loaded is the configuration before the Set.
+func (c delimiterKeyCase) loaded() map[string]any {
+	return setPath(c.tree, []string{c.top}, map[string]any{c.key(): map[string]any{c.leaf: c.old}})
+}
+
+// path is the key path of the leaf.
+func (c delimiterKeyCase) path() string {
+	return strings.Join([]string{c.top, c.key(), c.leaf}, c.delim)
+}
+
+// expected is the sub map under top after the Set.
+func (c delimiterKeyCase) expected() map[string]any {
+	return map[string]any{c.key(): map[string]any{c.leaf: c.new}}
+}
+
+func (c delimiterKeyCase) GoString() string {
+	return fmt.Sprintf("delim %q tree %#v\n  Set(%q, %#v)", c.delim, c.loaded(), c.path(), c.new)
+}
+
+var delimiterKeyCases = hegel.Composite(func(tc hegel.TestCase) delimiterKeyCase {
+	return delimiterKeyCase{
+		delim: hegel.Draw(tc, delims),
+		tree:  hegel.Draw(tc, trees),
+		top:   hegel.Draw(tc, keys),
+		inner: hegel.Draw(tc, shaped[hegel.Generator[[]string]](many(keys, 2, 3), many(keys, 1, 1))),
+		leaf:  hegel.Draw(tc, keys),
+		old:   hegel.Draw(tc, scalars),
+		new:   hegel.Draw(tc, scalars),
+	}
+})
+
+// TestHegelSetOnAKeyWithTheDelimiterIsDeterministic: Set on an existing key path whose key
+// contains the delimiter (which Exists, Get and Delete resolve through the key map) sets that
+// value, so Get returns it and the sub map holds one structure; the library splits the path,
+// builds a second structure beside the existing one and Get returns either value (koanf/6).
+func TestHegelSetOnAKeyWithTheDelimiterIsDeterministic(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, delimiterKeyCases)
+		ko := koanf.New(tcase.delim)
+		if err := ko.Load(mapProvider(tcase.loaded()), nil); err != nil {
+			c.fail(ht, "Load: %v", err)
+			return
+		}
+		path := tcase.path()
+		if !ko.Exists(path) {
+			c.fail(ht, "the path %q does not exist before Set", path)
+			return
+		}
+		if err := ko.Set(path, tcase.new); err != nil {
+			c.fail(ht, "Set(%q): %v", path, err)
+			return
+		}
+		if got, want := ko.Get(tcase.top), tcase.expected(); !reflect.DeepEqual(got, want) {
+			c.mismatch(ht, "raw", known("koanf/6"), "after Set(%q, %#v), Get(%q) = %#v, want %#v", path, tcase.new, tcase.top, got, want)
+			return
+		}
+		if got := ko.Get(path); !reflect.DeepEqual(got, tcase.new) {
+			c.mismatch(ht, "get", known("koanf/6"), "after Set(%q, %#v), Get returns %#v", path, tcase.new, got)
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..c37d029
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,215 @@
+package koanf_test
+
+// Hegel property tests for knadh/koanf (module github.com/knadh/koanf/v2), written for the
+// Hegel zoo. See targets/go/koanf/README.md.
+//
+// Oracle: a model of the configuration as a set of leaf paths (the parts of a key) with their
+// values, built from the package's documentation: Load and Merge merge the incoming nested map
+// into the configuration (a nested map merges into a nested map, anything else replaces),
+// strict merging refuses a value of another type, Set and MergeAt merge under a key path,
+// Delete removes a path and every parent map it empties, Cut re-roots a sub map, the getters
+// convert with the rules stated on toInt64/toFloat64/toBool and fmt's %v. The flattened key
+// set, the key map, Exists/Get/MapKeys, Raw/All and the getters are compared with the model
+// after every operation.
+//
+// Every property draws one case record (hegel_model_test.go has the generators, values built
+// from the binding's combinators): the trees, the operations with their paths as positions
+// resolved against the live model, the values the getters are asked for. The shapes of the
+// recorded bugs (bugs.toml) are drawn at their natural rate, so the wide properties that meet
+// them fail, naming the shape, and are the expected failures mapped to the bugs (STYLE.md rule
+// 11); hegel_shapes_test.go has one property per bug over its shape region alone, and
+// hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below): the model then reproduces each recorded behaviour and the narrow properties
+// draw the neighbouring region, for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch is failClass on a case that has the shape of the recorded bugs named (none for a
+// plain failure): the message names the shape, so that a shrunk failure of a wide property
+// says which bug it found.
+func (c *collector) mismatch(ht *hegel.T, class string, shape []string, format string, args ...any) {
+	if len(shape) > 0 {
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes, the model asserts the documented behaviour and the
+// properties that meet a bug fail, naming the shape; under HEGEL_NO_KNOWN=1 the switches of
+// Known are on: the model reproduces each recorded behaviour and the narrow properties draw
+// the neighbouring region instead of the shape.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known: the recorded bugs (bugs.toml). On means the model reproduces the behaviour, which is
+// so only under HEGEL_NO_KNOWN=1; the pins assert the documented behaviour and fail while the
+// bug exists, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	// koanf/1: a strict Load (or Merge, MergeAt, Set) that fails with a type error has already
+	// merged the keys visited before the mismatch into the raw map (which keys depends on the
+	// map iteration order), and the flattened keys are not updated: Raw() and Keys() disagree
+	strictLoadPartial bool
+	// koanf/2: Set with a map value merges the map into the existing map at the key instead of
+	// replacing it: Set("db", {host: x}) keeps db.port, Set("db", {}) changes nothing
+	setMergesMaps bool
+	// koanf/3: Load keeps the provider's maps and slices by reference: a later Load, Set or
+	// MergeAt writes into the first provider's map, and changing the provider's slice changes
+	// the value
+	loadAliasesProvider bool
+	// koanf/4: Float64 returns +/-Inf (or 0) for a numeric string out of float64's range
+	// ("1e400") while Float64s and Float64Map reject it
+	float64RangeErrorReturnsInf bool
+	// koanf/5: a map[any]any inside a slice inside a slice is not converted to map[string]any
+	nestedSliceMapsUnconverted bool
+	// koanf/6: Set on an existing key path whose key contains the delimiter builds a second
+	// structure beside the existing one, and Get returns either value
+	setSplitsDelimiterKeys bool
+}{
+	strictLoadPartial:           noKnown,
+	setMergesMaps:               noKnown,
+	loadAliasesProvider:         noKnown,
+	float64RangeErrorReturnsInf: noKnown,
+	nestedSliceMapsUnconverted:  noKnown,
+	setSplitsDelimiterKeys:      noKnown,
+}
+
+// --------------------------------------------------------------------------- provider
+
+// mapProvider is a Provider that returns a nested map (Read) and no bytes.
+type mapProvider map[string]any
+
+func (m mapProvider) ReadBytes() ([]byte, error)    { return nil, fmt.Errorf("mapProvider: no bytes") }
+func (m mapProvider) Read() (map[string]any, error) { return map[string]any(m), nil }
