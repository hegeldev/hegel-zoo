+package koanf_test
+
+// The model: a configuration is a set of leaf paths (the parts of a key) with their values.
+// A leaf value is anything that is not a non-empty map[string]any: a scalar, a slice, a typed
+// map, or an empty map[string]any (the "empty map" leaf that Flatten keeps as a value). No
+// leaf path is a prefix of another. Keys never contain the delimiter (a documented limitation
+// of delimited key paths), so joined keys are unambiguous.
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- values
+
+func isEmptyMap(v any) bool {
+	mp, ok := v.(map[string]any)
+	return ok && len(mp) == 0
+}
+
+// deepCopy copies the value shapes the generators produce.
+func deepCopy(v any) any {
+	switch x := v.(type) {
+	case map[string]any:
+		out := make(map[string]any, len(x))
+		for k, val := range x {
+			out[k] = deepCopy(val)
+		}
+		return out
+	case map[any]any:
+		out := make(map[any]any, len(x))
+		for k, val := range x {
+			out[k] = deepCopy(val)
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, val := range x {
+			out[i] = deepCopy(val)
+		}
+		return out
+	case []string:
+		return append([]string{}, x...)
+	case []int:
+		return append([]int{}, x...)
+	case []int64:
+		return append([]int64{}, x...)
+	case []float64:
+		return append([]float64{}, x...)
+	case []bool:
+		return append([]bool{}, x...)
+	case map[string]string:
+		out := make(map[string]string, len(x))
+		for k, val := range x {
+			out[k] = val
+		}
+		return out
+	case map[string][]string:
+		out := make(map[string][]string, len(x))
+		for k, val := range x {
+			out[k] = append([]string{}, val...)
+		}
+		return out
+	}
+	return v
+}
+
+// convertKeys is what the documentation of IntfaceKeysToStrings promises: every map[any]any
+// becomes a map[string]any with %v keys, recursively. The library reaches maps inside a slice
+// but not inside a slice inside a slice (Known.nestedSliceMapsUnconverted). The result shares
+// nothing with the input.
+func convertKeys(v any, sliceDepth int) any {
+	switch x := v.(type) {
+	case map[any]any:
+		out := make(map[string]any, len(x))
+		for k, val := range x {
+			out[fmt.Sprintf("%v", k)] = convertKeys(val, 0)
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(x))
+		for k, val := range x {
+			out[k] = convertKeys(val, 0)
+		}
+		return out
+	case []any:
+		if sliceDepth >= 1 && Known.nestedSliceMapsUnconverted {
+			return deepCopy(x)
+		}
+		out := make([]any, len(x))
+		for i, val := range x {
+			out[i] = convertKeys(val, sliceDepth+1)
+		}
+		return out
+	}
+	return deepCopy(v)
+}
+
+// --------------------------------------------------------------------------- the model
+
+type leaf struct {
+	parts []string
+	val   any
+}
+
+type model struct {
+	delim  string
+	leaves map[string]leaf // joined path -> leaf
+}
+
+func newModel(delim string) *model { return &model{delim: delim, leaves: map[string]leaf{}} }
+
+func (m *model) join(parts []string) string { return strings.Join(parts, m.delim) }
+
+func (m *model) split(path string) []string { return strings.Split(path, m.delim) }
+
+func (m *model) clone() *model {
+	n := newModel(m.delim)
+	for k, l := range m.leaves {
+		n.leaves[k] = leaf{append([]string{}, l.parts...), deepCopy(l.val)}
+	}
+	return n
+}
+
+// leavesOf flattens a (converted) nested map under prefix.
+func leavesOf(tree map[string]any, prefix []string) []leaf {
+	var out []leaf
+	for k, v := range tree {
+		parts := append(append([]string{}, prefix...), k)
+		if mp, ok := v.(map[string]any); ok && len(mp) > 0 {
+			out = append(out, leavesOf(mp, parts)...)
+			continue
+		}
+		out = append(out, leaf{parts, v})
+	}
+	return out
+}
+
+// under reports whether key lies strictly under prefix.
+func (m *model) under(key, prefix string) bool {
+	return strings.HasPrefix(key, prefix+m.delim)
+}
+
+// conflict is the strict-merge type check for one incoming leaf.
+func (m *model) conflict(l leaf) bool {
+	key := m.join(l.parts)
+	for k, w := range m.leaves {
+		switch {
+		case k == key:
+			if isEmptyMap(l.val) {
+				if !isEmptyMap(w.val) {
+					return true
+				}
+			} else if reflect.TypeOf(w.val) != reflect.TypeOf(l.val) {
+				return true
+			}
+		case m.under(key, k): // a value at a strict prefix of the incoming key (an empty map merges)
+			if !isEmptyMap(w.val) {
+				return true
+			}
+		case m.under(k, key): // leaves under the incoming key
+			if !isEmptyMap(l.val) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// apply merges one incoming leaf: a nested map merges into a map, anything else replaces.
+func (m *model) apply(l leaf) {
+	key := m.join(l.parts)
+	hasChildren := false
+	for k := range m.leaves {
+		if m.under(key, k) {
+			delete(m.leaves, k) // a map replaces a value at a prefix
+		}
+		if m.under(k, key) {
+			if isEmptyMap(l.val) {
+				hasChildren = true
+			} else {
+				delete(m.leaves, k) // a value replaces a map
+			}
+		}
+	}
+	if isEmptyMap(l.val) && hasChildren {
+		return // an empty map merges nothing
+	}
+	m.leaves[key] = leaf{append([]string{}, l.parts...), deepCopy(l.val)}
+}
+
+// merge merges a tree under prefix. strict: refuse (and change nothing) on a type conflict.
+// keepTop: the custom merge function of the tests, which adds only missing top-level keys.
+func (m *model) merge(tree map[string]any, prefix []string, strict, keepTop bool) error {
+	ls := m.incoming(tree, prefix)
+	if strict {
+		if err := m.conflicts(ls); err != nil {
+			return err
+		}
+	}
+	tops := map[string]bool{}
+	for _, l := range m.leaves {
+		tops[l.parts[0]] = true
+	}
+	for _, l := range ls {
+		if keepTop && tops[l.parts[0]] {
+			continue
+		}
+		m.apply(l)
+	}
+	return nil
+}
+
+// incoming: the leaves of tree under prefix (an empty tree under a prefix is the empty map at
+// the prefix).
+func (m *model) incoming(tree map[string]any, prefix []string) []leaf {
+	conv := convertKeys(tree, 0).(map[string]any)
+	if len(conv) == 0 && len(prefix) > 0 {
+		return []leaf{{append([]string{}, prefix...), map[string]any{}}}
+	}
+	return leavesOf(conv, prefix)
+}
+
+// conflicts: the strict check, the first type conflict of the incoming leaves with the
+// configuration as it is.
+func (m *model) conflicts(ls []leaf) error {
+	for _, l := range ls {
+		if m.conflict(l) {
+			return fmt.Errorf("model: type conflict at %s", m.join(l.parts))
+		}
+	}
+	return nil
+}
+
+// set is Set: the tree {key: val} merged (Known.setMergesMaps), or the value replacing the
+// key's subtree. The strict check is made against the configuration before the subtree goes
+// (a map set over a value of another type is refused, as the library does).
+func (m *model) set(key string, val any, strict bool) error {
+	parts := m.split(key)
+	tree, prefix := map[string]any{parts[len(parts)-1]: val}, parts[:len(parts)-1]
+	if _, ok := val.(map[string]any); ok && !Known.setMergesMaps {
+		if strict {
+			if err := m.conflicts(m.incoming(tree, prefix)); err != nil {
+				return err
+			}
+		}
+		m.removeSubtree(key)
+	}
+	return m.merge(tree, prefix, strict, false)
+}
+
+func (m *model) removeSubtree(key string) {
+	for k := range m.leaves {
+		if k == key || m.under(k, key) {
+			delete(m.leaves, k)
+		}
+	}
+}
+
+func (m *model) exists(path string) bool {
+	_, ok := m.keyMap()[path]
+	return ok
+}
+
+// keyMap: every leaf key and every prefix of it, with the parts.
+func (m *model) keyMap() map[string][]string {
+	out := map[string][]string{}
+	for _, l := range m.leaves {
+		for i := 1; i <= len(l.parts); i++ {
+			k := m.join(l.parts[:i])
+			if _, ok := out[k]; !ok {
+				out[k] = append([]string{}, l.parts[:i]...)
+			}
+		}
+	}
+	return out
+}
+
+func (m *model) keys() []string {
+	out := make([]string, 0, len(m.leaves))
+	for k := range m.leaves {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func (m *model) all() map[string]any {
+	out := make(map[string]any, len(m.leaves))
+	for k, l := range m.leaves {
+		out[k] = deepCopy(l.val)
+	}
+	return out
+}
+
+// subtree builds the nested map of the leaves strictly under prefix ("" is the whole tree).
+func (m *model) subtree(prefix string) map[string]any {
+	out := map[string]any{}
+	for k, l := range m.leaves {
+		if prefix != "" && !m.under(k, prefix) {
+			continue
+		}
+		parts := l.parts
+		if prefix != "" {
+			parts = parts[len(m.split(prefix)):]
+		}
+		cur := out
+		for _, p := range parts[:len(parts)-1] {
+			next, ok := cur[p].(map[string]any)
+			if !ok {
+				next = map[string]any{}
+				cur[p] = next
+			}
+			cur = next
+		}
+		cur[parts[len(parts)-1]] = deepCopy(l.val)
+	}
+	return out
+}
+
+func (m *model) tree() map[string]any { return m.subtree("") }
+
+// get: the leaf value, the sub map of a prefix, the whole tree for "", nil otherwise.
+func (m *model) get(path string) any {
+	if path == "" {
+		return m.tree()
+	}
+	if l, ok := m.leaves[path]; ok {
+		return deepCopy(l.val)
+	}
+	if m.exists(path) {
+		return m.subtree(path)
+	}
+	return nil
+}
+
+func (m *model) mapKeys(path string) []string {
+	out := []string{}
+	if mp, ok := m.get(path).(map[string]any); ok {
+		for k := range mp {
+			out = append(out, k)
+		}
+		sort.Strings(out)
+	}
+	return out
+}
+
+// cut re-roots the sub map at path (an empty model when the path is not a map).
+func (m *model) cut(path string) *model {
+	n := newModel(m.delim)
+	if mp, ok := m.get(path).(map[string]any); ok {
+		_ = n.merge(mp, nil, false, false)
+	}
+	return n
+}
+
+// slices: one model per map element of a []any leaf.
+func (m *model) slices(path string) []*model {
+	out := []*model{}
+	if path == "" {
+		return out
+	}
+	sl, ok := m.get(path).([]any)
+	if !ok {
+		return out
+	}
+	for _, el := range sl {
+		if mp, ok := el.(map[string]any); ok {
+			n := newModel(m.delim)
+			_ = n.merge(mp, nil, false, false)
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// del is Delete: the path and everything under it; a parent left empty disappears.
+func (m *model) del(path string) {
+	if path == "" {
+		m.leaves = map[string]leaf{}
+		return
+	}
+	if !m.exists(path) {
+		return
+	}
+	m.removeSubtree(path)
+}
+
+func (m *model) sprint() string {
+	var b strings.Builder
+	for _, k := range m.keys() {
+		fmt.Fprintf(&b, "%s -> %v\n", k, m.leaves[k].val)
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- conversions
+
+// mInt64 is the documented conversion of toInt64: integers as they are (unsigned ones that
+// fit), anything else through %v and strconv (an integer, else a float truncated).
+func mInt64(v any) (int64, bool) {
+	switch i := v.(type) {
+	case int:
+		return int64(i), true
+	case int8:
+		return int64(i), true
+	case int16:
+		return int64(i), true
+	case int32:
+		return int64(i), true
+	case int64:
+		return i, true
+	case uint8:
+		return int64(i), true
+	case uint16:
+		return int64(i), true
+	case uint32:
+		return int64(i), true
+	case uint:
+		if uint64(i) > math.MaxInt64 {
+			return 0, false
+		}
+		return int64(i), true
+	case uint64:
+		if i > math.MaxInt64 {
+			return 0, false
+		}
+		return int64(i), true
+	}
+	s := fmt.Sprintf("%v", v)
+	if i, err := strconv.ParseInt(s, 10, 64); err == nil {
+		return i, true
+	}
+	f, err := strconv.ParseFloat(s, 64)
+	if err != nil || math.IsNaN(f) || f < math.MinInt64 || f >= 1<<63 {
+		return 0, false
+	}
+	return int64(f), true
+}
+
+// mFloat64: floats as they are, anything else through %v and ParseFloat. The second result
+// is the parse error; Float64 ignores it (Known.float64RangeErrorReturnsInf), the slice and
+// map getters do not.
+func mFloat64(v any) (float64, error) {
+	switch f := v.(type) {
+	case float32:
+		return float64(f), nil
+	case float64:
+		return f, nil
+	}
+	return strconv.ParseFloat(fmt.Sprintf("%v", v), 64)
+}
+
+func mBool(v any) (bool, bool) {
+	if b, ok := v.(bool); ok {
+		return b, true
+	}
+	b, err := strconv.ParseBool(fmt.Sprintf("%v", v))
+	return b, err == nil
+}
+
+func mString(v any) string {
+	if v == nil {
+		return ""
+	}
+	if s, ok := v.(string); ok {
+		return s
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+// getters is the model of every getter on a value (nil: the path does not exist).
+type getters struct{ v any }
+
+func (g getters) Int64() int64 {
+	if g.v == nil {
+		return 0
+	}
+	i, _ := mInt64(g.v)
+	return i
+}
+
+func (g getters) Float64() float64 {
+	if g.v == nil {
+		return 0
+	}
+	f, err := mFloat64(g.v)
+	if err != nil && !Known.float64RangeErrorReturnsInf {
+		return 0
+	}
+	return f
+}
+
+func (g getters) Bool() bool {
+	if g.v == nil {
+		return false
+	}
+	b, _ := mBool(g.v)
+	return b
+}
+
+func (g getters) String() string { return mString(g.v) }
+
+func (g getters) Duration() time.Duration {
+	if i := g.Int64(); i != 0 {
+		return time.Duration(i)
+	}
+	d, _ := time.ParseDuration(g.String())
+	return d
+}
+
+func (g getters) Time(layout string) time.Time {
+	if i := g.Int64(); i != 0 {
+		return time.Unix(i, 0)
+	}
+	if s := g.String(); s != "" {
+		t, _ := time.Parse(layout, s)
+		return t
+	}
+	return time.Time{}
+}
+
+func (g getters) Int64s() []int64 {
+	switch v := g.v.(type) {
+	case []int64:
+		return append([]int64{}, v...)
+	case []int:
+		out := make([]int64, 0, len(v))
+		for _, x := range v {
+			out = append(out, int64(x))
+		}
+		return out
+	case []any:
+		out := make([]int64, 0, len(v))
+		for _, x := range v {
+			i, ok := mInt64(x)
+			if !ok {
+				return []int64{}
+			}
+			out = append(out, i)
+		}
+		return out
+	}
+	return []int64{}
+}
+
+func (g getters) Ints() []int {
+	switch v := g.v.(type) {
+	case []int:
+		return append([]int{}, v...)
+	case []int64:
+		out := make([]int, 0, len(v))
+		for _, x := range v {
+			out = append(out, int(x))
+		}
+		return out
+	case []any:
+		out := make([]int, 0, len(v))
+		for _, x := range v {
+			i, ok := mInt64(x)
+			if !ok {
+				return []int{}
+			}
+			out = append(out, int(i))
+		}
+		return out
+	}
+	return []int{}
+}
+
+func (g getters) Float64s() []float64 {
+	switch v := g.v.(type) {
+	case []float64:
+		return append([]float64{}, v...)
+	case []any:
+		out := make([]float64, 0, len(v))
+		for _, x := range v {
+			f, err := mFloat64(x)
+			if err != nil {
+				return []float64{}
+			}
+			out = append(out, f)
+		}
+		return out
+	}
+	return []float64{}
+}
+
+func (g getters) Strings() []string {
+	switch v := g.v.(type) {
+	case []string:
+		return append([]string{}, v...)
+	case []any:
+		out := make([]string, 0, len(v))
+		for _, x := range v {
+			if s, ok := x.(string); ok {
+				out = append(out, s)
+			} else {
+				out = append(out, fmt.Sprintf("%v", x))
+			}
+		}
+		return out
+	}
+	return []string{}
+}
+
+func (g getters) Bools() []bool {
+	switch v := g.v.(type) {
+	case []bool:
+		return append([]bool{}, v...)
+	case []any:
+		out := make([]bool, 0, len(v))
+		for _, x := range v {
+			b, ok := mBool(x)
+			if !ok {
+				return []bool{}
+			}
+			out = append(out, b)
+		}
+		return out
+	}
+	return []bool{}
+}
+
+func (g getters) Int64Map() map[string]int64 {
+	out := map[string]int64{}
+	mp, ok := g.v.(map[string]any)
+	if !ok {
+		return out
+	}
+	for k, x := range mp {
+		i, ok := mInt64(x)
+		if !ok {
+			return map[string]int64{}
+		}
+		out[k] = i
+	}
+	return out
+}
+
+func (g getters) Float64Map() map[string]float64 {
+	out := map[string]float64{}
+	mp, ok := g.v.(map[string]any)
+	if !ok {
+		return out
+	}
+	for k, x := range mp {
+		f, err := mFloat64(x)
+		if err != nil {
+			return map[string]float64{}
+		}
+		out[k] = f
+	}
+	return out
+}
+
+func (g getters) BoolMap() map[string]bool {
+	out := map[string]bool{}
+	mp, ok := g.v.(map[string]any)
+	if !ok {
+		return out
+	}
+	for k, x := range mp {
+		b, ok := mBool(x)
+		if !ok {
+			return map[string]bool{}
+		}
+		out[k] = b
+	}
+	return out
+}
+
+func (g getters) StringMap() map[string]string {
+	out := map[string]string{}
+	switch mp := g.v.(type) {
+	case map[string]string:
+		for k, s := range mp {
+			out[k] = s
+		}
+	case map[string]any:
+		for k, x := range mp {
+			s, ok := x.(string)
+			if !ok {
+				return map[string]string{}
+			}
+			out[k] = s
+		}
+	}
+	return out
+}
+
+// StringsMap: entries with no strings are dropped (the library keeps a nil entry for an empty
+// []string and none for an empty []any; both are compared as absent).
+func (g getters) StringsMap() map[string][]string {
+	out := map[string][]string{}
+	switch mp := g.v.(type) {
+	case map[string][]string:
+		for k, ss := range mp {
+			if len(ss) > 0 {
+				out[k] = append([]string{}, ss...)
+			}
+		}
+	case map[string]any:
+		for k, x := range mp {
+			switch s := x.(type) {
+			case []string:
+				if len(s) > 0 {
+					out[k] = append([]string{}, s...)
+				}
+			case []any:
+				for _, e := range s {
+					str, ok := e.(string)
+					if !ok {
+						return map[string][]string{}
+					}
+					out[k] = append(out[k], str)
+				}
+			default:
+				return map[string][]string{}
+			}
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// asAny is g as a generator of any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// nonNil and nonNilMap make an empty collection a non-nil one (Lists and Maps yield nil for
+// zero elements; the old generators made every collection with make).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// nesting draws from *g one level deeper, or from flat at the bound: the depth counter lives
+// in the closure of the grammar and is restored by defer, so an aborted draw cannot leave it
+// stale (hegel-go's ExampleComposite_recursive, for a mutually recursive grammar).
+func nesting[T any](depth *int, bound int, g *hegel.Generator[T], flat hegel.Generator[T]) hegel.Generator[T] {
+	return hegel.Composite(func(tc hegel.TestCase) T {
+		if *depth >= bound {
+			return hegel.Draw(tc, flat)
+		}
+		*depth++
+		defer func() { *depth-- }()
+		return hegel.Draw(tc, *g)
+	})
+}
+
+// --------------------------------------------------------------------------- pools
+
+var keyAlphabet = []string{"a", "b", "c", "x", "y", "k1", "k2", "-", "A"}
+
+var delimPool = []string{".", "/", "::"}
+
+var someStrings = []string{
+	"", "12", "-7", "12.7", "1e2", "1e400", "-1e400", "1e-400", "0x1p4", "abc", "true", "T", "1", "0",
+	"f", "yes", "1h30m", "2ms", " 5", "9223372036854775807", "9223372036854775808",
+	"-9223372036854775809", "Inf", "1_000", "2006-01-02", "0.5", "-0", "+3", "007",
+}
+
+var someInts = []int{0, 1, -1, 42, -7, 1 << 40, math.MaxInt64, math.MinInt64}
+
+var someUints = []uint64{0, 5, 1 << 63, math.MaxUint64, math.MaxInt64}
+
+var someFloats = []float64{0, 1, -1, 1.5, -2.25, 1e6, 1e20, 3, 123456789, 1e-7, math.MaxFloat64,
+	math.Inf(1), math.Copysign(0, -1), 9.5e18}
+
+var (
+	keys   = hegel.SampledFrom(keyAlphabet)
+	delims = hegel.SampledFrom(delimPool)
+	ints   = hegel.SampledFrom(someInts)
+	strs   = hegel.SampledFrom(someStrings)
+	floats = hegel.SampledFrom(someFloats)
+	// scalars: nil (the simplest, first) and a bool once each, an int, an int64, a uint64 and
+	// a float64 once, a string twice, by weight. The strings include "1e400" and "-1e400",
+	// the shape of koanf/4 for Float64.
+	scalars = weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{1, asAny(ints)},
+		choice[any]{1, asAny(hegel.Map(ints, func(i int) int64 { return int64(i) }))},
+		choice[any]{1, asAny(hegel.SampledFrom(someUints))},
+		choice[any]{1, asAny(floats)},
+		choice[any]{2, asAny(strs)},
+	)
+	// ifaceKeys: a key of a map[any]any: a string key, or an int of 7 to 9 three times in ten
+	// (distinct from the strings after %v).
+	ifaceKeys = weighted(choice[any]{70, asAny(keys)}, choice[any]{30, asAny(hegel.Integers(7, 9))})
+)
+
+// --------------------------------------------------------------------------- trees and values
+
+// leafChoices: the leaf values, by weight: a scalar four times; a []any (from anyLists), a
+// []string, a []int, a []int64, a []float64 and a []bool of up to three elements, a
+// map[string]string and a map[string][]string of up to three keys, and the empty map once
+// each.
+func leafChoices(anyLists hegel.Generator[any]) []choice[any] {
+	return []choice[any]{
+		{4, scalars},
+		{1, anyLists},
+		{1, asAny(hegel.Map(many(strs, 0, 3), nonNil[string]))},
+		{1, asAny(hegel.Map(many(ints, 0, 3), nonNil[int]))},
+		{1, asAny(hegel.Map(many(ints, 0, 3), func(xs []int) []int64 {
+			out := make([]int64, len(xs))
+			for i, x := range xs {
+				out[i] = int64(x)
+			}
+			return out
+		}))},
+		{1, asAny(hegel.Map(many(floats, 0, 3), nonNil[float64]))},
+		{1, asAny(hegel.Map(many(hegel.Booleans(), 0, 3), nonNil[bool]))},
+		{1, asAny(hegel.Map(hegel.Maps(keys, strs).MaxSize(3), nonNilMap[string, string]))},
+		{1, asAny(hegel.Map(hegel.Maps(keys, hegel.Map(many(strs, 0, 2), nonNil[string])).MaxSize(3), nonNilMap[string, []string]))},
+		{1, hegel.Just[any](map[string]any{})},
+	}
+}
+
+// trees, values and ifaceMaps: the nested shapes of a configuration, mutually recursive. A
+// tree is a map[string]any of up to four keys whose values are leaf values (half of the
+// time), sub trees (35%) or interface-keyed maps (15%); a leaf value is a scalar or a typed
+// collection (leafChoices), its []any of up to four elements holding scalars, trees,
+// interface-keyed maps, lists again (the shape of koanf/5 when such a list holds an
+// interface-keyed map, which IntfaceKeysToStrings does not reach) and leaf values; an
+// interface-keyed map (map[any]any, converted at Load) has up to three keys holding scalars,
+// interface-keyed maps and a list of an interface-keyed map and a scalar. One depth counter
+// bounds the nesting at three containers; at the bound every alternative is flat.
+var trees, values, ifaceMaps = func() (hegel.Generator[map[string]any], hegel.Generator[any], hegel.Generator[map[any]any]) {
+	depth := 0
+	var treeNodes hegel.Generator[map[string]any]
+	var valueNodes hegel.Generator[any]
+	var ifaceNodes hegel.Generator[map[any]any]
+	var anyLists hegel.Generator[any]
+	flatValues := weighted(leafChoices(asAny(hegel.Map(many(scalars, 0, 4), nonNil[any])))...)
+	flatTrees := hegel.Map(hegel.Maps(keys, flatValues).MaxSize(4), nonNilMap[string, any])
+	flatIfaceMaps := hegel.Map(hegel.Maps(ifaceKeys, scalars).MaxSize(3), nonNilMap[any, any])
+	trees := nesting(&depth, 3, &treeNodes, flatTrees)
+	values := nesting(&depth, 3, &valueNodes, flatValues)
+	ifaceMaps := nesting(&depth, 3, &ifaceNodes, flatIfaceMaps)
+	nestedLists := nesting(&depth, 3, &anyLists, asAny(hegel.Map(many(scalars, 0, 4), nonNil[any])))
+	elements := weighted(
+		choice[any]{50, scalars},
+		choice[any]{20, asAny(trees)},
+		choice[any]{10, asAny(ifaceMaps)},
+		choice[any]{10, nestedLists},
+		choice[any]{10, values},
+	)
+	anyLists = asAny(hegel.Map(many(elements, 0, 4), nonNil[any]))
+	treeNodes = hegel.Map(hegel.Maps(keys, weighted(
+		choice[any]{50, values},
+		choice[any]{35, asAny(trees)},
+		choice[any]{15, asAny(ifaceMaps)},
+	)).MaxSize(4), nonNilMap[string, any])
+	valueNodes = weighted(leafChoices(anyLists)...)
+	ifaceNodes = hegel.Map(hegel.Maps(ifaceKeys, weighted(
+		choice[any]{50, scalars},
+		choice[any]{30, asAny(ifaceMaps)},
+		choice[any]{20, hegel.Map(pairs(ifaceMaps, scalars), func(p pair[map[any]any, any]) any { return []any{p.a, p.b} })},
+	)).MaxSize(3), nonNilMap[any, any])
+	return trees, values, ifaceMaps
+}()
+
+// setValues: the value of a Set: a leaf value seven times in ten, else a tree.
+var setValues = weighted(choice[any]{70, values}, choice[any]{30, asAny(trees)})
+
+// deepIfaceMap reports whether v holds a map[any]any anywhere under a []any inside a []any:
+// the shape of koanf/5 (IntfaceKeysToStrings converts a map in a slice, but does not descend
+// into a slice in a slice, as convertKeys mirrors). sliceDepth counts the slices above v; a
+// converted map starts the count again.
+func deepIfaceMap(v any, sliceDepth int) bool {
+	switch x := v.(type) {
+	case map[any]any:
+		for _, val := range x {
+			if deepIfaceMap(val, 0) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, val := range x {
+			if deepIfaceMap(val, 0) {
+				return true
+			}
+		}
+	case []any:
+		for _, val := range x {
+			if sliceDepth >= 1 {
+				if hasIfaceMap(val) {
+					return true
+				}
+			} else if deepIfaceMap(val, 1) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasIfaceMap reports whether v is or holds a map[any]any.
+func hasIfaceMap(v any) bool {
+	switch x := v.(type) {
+	case map[any]any:
+		return true
+	case map[string]any:
+		for _, val := range x {
+			if hasIfaceMap(val) {
+				return true
+			}
+		}
+	case []any:
+		for _, val := range x {
+			if hasIfaceMap(val) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- paths
+
+// pathKind is how a key path is chosen against the live model.
+type pathKind int
+
+const (
+	pathExisting  pathKind = iota // a key or prefix of the model, at a position
+	pathExtension                 // an existing key or prefix extended by one key
+	pathFresh                     // one to three keys
+	pathEmpty                     // "" (the whole map) where the operation allows it
+)
+
+// pathKinds: existing four times in ten, an extension twice, fresh three times, "" once.
+var pathKinds = hegel.SampledFrom([]pathKind{
+	pathExisting, pathExisting, pathExisting, pathExisting,
+	pathExtension, pathExtension,
+	pathFresh, pathFresh, pathFresh,
+	pathEmpty,
+})
+
+// pathSpec is a key path as drawn: resolved against the live model when applied, a kind that
+// does not fit (an existing path of an empty model, "" where it is not allowed) falls back to
+// the fresh path.
+type pathSpec struct {
+	kind  pathKind
+	at    int      // existing, extension: the position in the sorted key map, modulo its size
+	parts []string // fresh: the keys
+	key   string   // extension: the key added
+}
+
+var paths = hegel.Composite(func(tc hegel.TestCase) pathSpec {
+	return pathSpec{
+		kind:  hegel.Draw(tc, pathKinds),
+		at:    hegel.Draw(tc, positions),
+		parts: hegel.Draw(tc, many(keys, 1, 3)),
+		key:   hegel.Draw(tc, keys),
+	}
+})
+
+// resolve is the path against the model.
+func (p pathSpec) resolve(m *model, allowEmpty bool) string {
+	existing := sortedKeys(m.keyMap())
+	switch {
+	case p.kind == pathEmpty && allowEmpty:
+		return ""
+	case p.kind == pathExisting && len(existing) > 0:
+		return existing[p.at%len(existing)]
+	case p.kind == pathExtension && len(existing) > 0:
+		return existing[p.at%len(existing)] + m.delim + p.key
+	}
+	return m.join(p.parts)
+}
+
+func (p pathSpec) String() string {
+	switch p.kind {
+	case pathEmpty:
+		return `""`
+	case pathExisting:
+		return fmt.Sprintf("existing[%d]", p.at)
+	case pathExtension:
+		return fmt.Sprintf("existing[%d]+%q", p.at, p.key)
+	}
+	return fmt.Sprintf("fresh %q", p.parts)
+}
+
+func sortedKeys[V any](m map[string]V) []string {
+	out := make([]string, 0, len(m))
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// sliceKeys: the leaf keys of the model holding a []any, sorted.
+func sliceKeys(m *model) []string {
+	var out []string
+	for k, l := range m.leaves {
+		if _, ok := l.val.([]any); ok {
+			out = append(out, k)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// --------------------------------------------------------------------------- operations
+
+type opKind int
+
+const (
+	opLoad opKind = iota
+	opSet
+	opMerge
+	opMergeAt
+	opDelete
+	opCut
+	opCopy
+	opSlices
+)
+
+var opNames = []string{"Load", "Set", "Merge", "MergeAt", "Delete", "Cut", "Copy", "Slices"}
+
+// op is one operation of a script, as drawn; its path is resolved against the live model when
+// it is applied.
+type op struct {
+	kind   opKind
+	tree   map[string]any // Load, Merge, MergeAt: the incoming map
+	keep   bool           // Load: with the custom merge function keepExisting
+	path   pathSpec       // Set (never ""), MergeAt, Delete, Cut, Slices
+	val    any            // Set: the value
+	delim  string         // Merge, MergeAt: the other instance's delimiter
+	key    string         // Cut, Copy: the key set on the cut or copy afterwards
+	prefer bool           // Slices: a key holding a []any, at path.at, when there is one
+}
+
+func (o op) GoString() string {
+	switch o.kind {
+	case opLoad:
+		return fmt.Sprintf("Load(%#v, keep=%v)", o.tree, o.keep)
+	case opSet:
+		return fmt.Sprintf("Set(%v, %#v)", o.path, o.val)
+	case opMerge:
+		return fmt.Sprintf("Merge(%#v, delim %q)", o.tree, o.delim)
+	case opMergeAt:
+		return fmt.Sprintf("MergeAt(%#v, %v, delim %q)", o.tree, o.path, o.delim)
+	case opDelete:
+		return fmt.Sprintf("Delete(%v)", o.path)
+	case opCut:
+		return fmt.Sprintf("Cut(%v) then Set(%q)", o.path, o.key)
+	case opCopy:
+		return fmt.Sprintf("Copy() then Set(%q)", o.key)
+	}
+	return fmt.Sprintf("Slices(%v, preferSlice=%v)", o.path, o.prefer)
+}
+
+// ops: a Load four times in twelve (with the custom merge function 15% of the time), a Set
+// twice, and a Merge, a MergeAt, a Delete, a Cut, a Copy and a Slices once each.
+var ops = weighted(
+	choice[op]{4, hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opLoad, tree: hegel.Draw(tc, trees), keep: hegel.Draw(tc, chance(15))}
+	})},
+	choice[op]{2, hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opSet, path: hegel.Draw(tc, paths), val: hegel.Draw(tc, setValues)}
+	})},
+	choice[op]{1, hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opMerge, tree: hegel.Draw(tc, trees), delim: hegel.Draw(tc, delims)}
+	})},
+	choice[op]{1, hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opMergeAt, tree: hegel.Draw(tc, trees), delim: hegel.Draw(tc, delims), path: hegel.Draw(tc, paths)}
+	})},
+	choice[op]{1, hegel.Map(paths, func(p pathSpec) op { return op{kind: opDelete, path: p} })},
+	choice[op]{1, hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opCut, path: hegel.Draw(tc, paths), key: hegel.Draw(tc, keys)}
+	})},
+	choice[op]{1, hegel.Map(keys, func(k string) op { return op{kind: opCopy, key: k} })},
+	choice[op]{1, hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: opSlices, path: hegel.Draw(tc, paths), prefer: hegel.Draw(tc, chance(70))}
+	})},
+)
+
+// --------------------------------------------------------------------------- cases
+
+// opsCase: an instance's delimiter, whether it merges strictly (30%), one to eight operations
+// and, 30% of the time, a path whose sub map is unmarshalled at the end.
+type opsCase struct {
+	delim     string
+	strict    bool
+	ops       []op
+	unmarshal *pathSpec
+}
+
+func (c opsCase) GoString() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "delim %q strict=%v", c.delim, c.strict)
+	for i, o := range c.ops {
+		fmt.Fprintf(&b, "\n  %d: %#v", i, o)
+	}
+	if c.unmarshal != nil {
+		fmt.Fprintf(&b, "\n  Unmarshal(%v)", *c.unmarshal)
+	}
+	return b.String()
+}
+
+var opsCases = hegel.Composite(func(tc hegel.TestCase) opsCase {
+	return opsCase{
+		delim:     hegel.Draw(tc, delims),
+		strict:    hegel.Draw(tc, chance(30)),
+		ops:       hegel.Draw(tc, many(ops, 1, 8)),
+		unmarshal: hegel.Draw(tc, optional(30, paths)),
+	}
+})
+
+// getterCase: the value under "v" (a leaf value four times in five, else a tree), the leaf
+// value under "n.v" and the scalar under "n.w", a tree under "m" 30% of the time, and the
+// time layout.
+type getterCase struct {
+	v, nv, w any
+	m        *map[string]any
+	layout   string
+}
+
+// tree is the configuration loaded.
+func (c getterCase) tree() map[string]any {
+	t := map[string]any{"v": c.v, "n": map[string]any{"v": c.nv, "w": c.w}}
+	if c.m != nil {
+		t["m"] = *c.m
+	}
+	return t
+}
+
+func (c getterCase) GoString() string {
+	return fmt.Sprintf("tree %#v layout %q", c.tree(), c.layout)
+}
+
+var layouts = hegel.SampledFrom([]string{"2006-01-02", time.RFC3339, "15:04"})
+
+var getterCases = hegel.Composite(func(tc hegel.TestCase) getterCase {
+	return getterCase{
+		v:      hegel.Draw(tc, weighted(choice[any]{80, values}, choice[any]{20, asAny(trees)})),
+		nv:     hegel.Draw(tc, values),
+		w:      hegel.Draw(tc, scalars),
+		m:      hegel.Draw(tc, optional(30, trees)),
+		layout: hegel.Draw(tc, layouts),
+	}
+})
+
+// copyCase: the delimiter, the provider's tree, the position of the leaf key that is Cut
+// (modulo the number of keys), the keys and values Set on the Copy and on the Cut, the path
+// deleted from the Copy (resolved against its model) and the tree of the second Load.
+type copyCase struct {
+	delim  string
+	orig   map[string]any
+	cutAt  int
+	k1, k2 string
+	v1, v2 any
+	del    pathSpec
+	second map[string]any
+}
+
+func (c copyCase) GoString() string {
+	return fmt.Sprintf("delim %q tree %#v\n  Cut(keys[%d]); Copy.Set(%q, %#v); Cut.Set(%q, %#v); Copy.Delete(%v)\n  second Load %#v",
+		c.delim, c.orig, c.cutAt, c.k1, c.v1, c.k2, c.v2, c.del, c.second)
+}
+
+var copyCases = hegel.Composite(func(tc hegel.TestCase) copyCase {
+	return copyCase{
+		delim:  hegel.Draw(tc, delims),
+		orig:   hegel.Draw(tc, trees),
+		cutAt:  hegel.Draw(tc, positions),
+		k1:     hegel.Draw(tc, keys),
+		v1:     hegel.Draw(tc, values),
+		k2:     hegel.Draw(tc, keys),
+		v2:     hegel.Draw(tc, values),
+		del:    hegel.Draw(tc, paths),
+		second: hegel.Draw(tc, trees),
+	}
+})
