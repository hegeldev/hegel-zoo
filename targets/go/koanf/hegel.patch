+package koanf_test
+
+// Hegel property tests for knadh/koanf (module github.com/knadh/koanf/v2), written for the
+// Hegel zoo. See targets/go/koanf/README.md.
+//
+// Oracle: a model of the configuration as a set of leaf paths (the parts of a key) with their
+// values, built from the package's documentation: Load and Merge merge the incoming nested map
+// into the configuration (a nested map merges into a nested map, anything else replaces),
+// strict merging refuses a value of another type, Set and MergeAt merge under a key path,
+// Delete removes a path and every parent map it empties, Cut re-roots a sub map, the getters
+// convert with the rules stated on toInt64/toFloat64/toBool and fmt's %v. The flattened key
+// set, the key map, Exists/Get/MapKeys, Raw/All and the getters are compared with the model
+// after every operation.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// a strict Load (or Merge, MergeAt, Set) that fails with a type error has already merged
+	// the keys visited before the mismatch into the raw map (which keys depends on the map
+	// iteration order), and the flattened keys are not updated: Raw() and Keys() disagree
+	strictLoadPartial bool
+	// Set with a map value merges the map into the existing map at the key instead of
+	// replacing it: Set("db", {host: x}) keeps db.port, Set("db", {}) changes nothing
+	setMergesMaps bool
+	// Load keeps the provider's maps and slices by reference: a later Load, Set or MergeAt
+	// writes into the first provider's map, and changing the provider's slice changes the value
+	loadAliasesProvider bool
+	// Float64 returns +/-Inf (or 0) for a numeric string out of float64's range ("1e400")
+	// while Float64s and Float64Map reject it
+	float64RangeErrorReturnsInf bool
+	// a map[any]any inside a slice inside a slice is not converted to map[string]any
+	nestedSliceMapsUnconverted bool
+}{
+	strictLoadPartial:           true,
+	setMergesMaps:               true,
+	loadAliasesProvider:         true,
+	float64RangeErrorReturnsInf: true,
+	nestedSliceMapsUnconverted:  true,
+}
+
+// --------------------------------------------------------------------------- provider
+
+// mapProvider is a Provider that returns a nested map (Read) and no bytes.
+type mapProvider map[string]any
+
+func (m mapProvider) ReadBytes() ([]byte, error)    { return nil, fmt.Errorf("mapProvider: no bytes") }
+func (m mapProvider) Read() (map[string]any, error) { return map[string]any(m), nil }
