+package koanf_test
+
+// Pins: one plain test per recorded bug, asserting the documented behaviour. Each fails while
+// its bug exists (target.toml lists them as expected failures).
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"testing"
+
+	"github.com/knadh/koanf/v2"
+)
+
+// koanf/1: a strict Load that fails with a type error must leave the configuration as it was;
+// in any case Raw() and Keys() must describe the same map.
+func TestHegelPinStrictLoadIsAtomic(t *testing.T) {
+	for i := 0; i < 50; i++ {
+		ko := koanf.NewWithConf(koanf.Conf{Delim: ".", StrictMerge: true})
+		if err := ko.Load(mapProvider{"m": map[string]any{"k": 1}}, nil); err != nil {
+			t.Fatal(err)
+		}
+		before := ko.Raw()
+		err := ko.Load(mapProvider{"m": map[string]any{"k": "x"}, "n": 2}, nil)
+		if err == nil {
+			t.Fatal("strict Load of a string over an int: no error")
+		}
+		if !reflect.DeepEqual(ko.Raw(), before) {
+			t.Fatalf("after the failed strict Load, Raw() = %v (was %v), Keys() = %v", ko.Raw(), before, ko.Keys())
+		}
+	}
+}
+
+// koanf/2: Set sets the value at the key: afterwards Get returns that value, whatever was
+// there before.
+func TestHegelPinSetReplacesTheValue(t *testing.T) {
+	ko := koanf.New(".")
+	_ = ko.Load(mapProvider{"db": map[string]any{"host": "h", "port": 1}}, nil)
+	if err := ko.Set("db", map[string]any{"host": "x"}); err != nil {
+		t.Fatal(err)
+	}
+	if got := ko.Get("db"); !reflect.DeepEqual(got, map[string]any{"host": "x"}) {
+		t.Errorf("after Set(\"db\", {host: x}), Get(\"db\") = %v", got)
+	}
+	if err := ko.Set("db", map[string]any{}); err != nil {
+		t.Fatal(err)
+	}
+	if got := ko.Get("db"); !reflect.DeepEqual(got, map[string]any{}) {
+		t.Errorf("after Set(\"db\", {}), Get(\"db\") = %v", got)
+	}
+}
+
+// koanf/3: Load does not keep the provider's map: a later Load must not write into it, and
+// changing the provider's data afterwards must not change the configuration.
+func TestHegelPinLoadCopiesTheProvider(t *testing.T) {
+	defaults := map[string]any{"server": map[string]any{"port": 8080}, "tags": []any{"a"}}
+	ko := koanf.New(".")
+	_ = ko.Load(mapProvider(defaults), nil)
+	_ = ko.Load(mapProvider{"server": map[string]any{"port": 9090}}, nil)
+	if p := defaults["server"].(map[string]any)["port"]; p != 8080 {
+		t.Errorf("the defaults map was written to by the second Load: server.port = %v", p)
+	}
+	defaults["tags"].([]any)[0] = "changed"
+	if got := ko.Strings("tags"); !reflect.DeepEqual(got, []string{"a"}) {
+		t.Errorf("changing the provider's slice changed the configuration: tags = %v", got)
+	}
+}
+
+// koanf/4: Float64 returns 0 for a value that is not a valid float64, as Float64s and
+// Float64Map do for the same value.
+func TestHegelPinFloat64OutOfRangeIsZero(t *testing.T) {
+	ko := koanf.New(".")
+	_ = ko.Load(mapProvider{"a": "1e400", "b": "-1e400", "s": []any{"1e400"}}, nil)
+	for _, k := range []string{"a", "b"} {
+		if f := ko.Float64(k); f != 0 {
+			t.Errorf("Float64(%q) = %v (Inf %v) for %q; Float64s of the same value = %v", k, f, math.IsInf(f, 0), ko.String(k), ko.Float64s("s"))
+		}
+	}
+}
+
+// koanf/5: every map[any]any in the loaded map becomes a map[string]any, however deep.
+func TestHegelPinNestedSliceMapsConverted(t *testing.T) {
+	ko := koanf.New(".")
+	_ = ko.Load(mapProvider{"a": []any{[]any{map[any]any{"b": 1}}}}, nil)
+	got := ko.Get("a")
+	want := []any{[]any{map[string]any{"b": 1}}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("Get(\"a\") = %#v, want %#v", got, want)
+	}
+}
+
+// koanf/6: Set on an existing key path whose key contains the delimiter must not leave two
+// structures behind the same flattened key; Get afterwards must return the set value, every
+// time.
+func TestHegelPinSetOnKeyWithDelimiterIsDeterministic(t *testing.T) {
+	seen := map[string]int{}
+	for i := 0; i < 100; i++ {
+		ko := koanf.New(".")
+		_ = ko.Load(mapProvider{"hosts": map[string]any{"example.com": map[string]any{"port": 1}}}, nil)
+		if !ko.Exists("hosts.example.com.port") {
+			t.Fatal("the path does not exist before Set")
+		}
+		_ = ko.Set("hosts.example.com.port", 2)
+		seen[fmt.Sprint(ko.Get("hosts.example.com.port"))]++
+	}
+	if len(seen) != 1 || seen["2"] != 100 {
+		t.Errorf("Get after Set(\"hosts.example.com.port\", 2) over 100 runs: %v", seen)
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..ba587f4
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,508 @@
+package koanf_test
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"testing"
+
+	"github.com/knadh/koanf/v2"
+	"hegel.dev/go/hegel"
+)
+
+// keepExisting is the custom merge function of the tests: it adds the top-level keys missing
+// from dest and leaves the others alone.
+func keepExisting(src, dest map[string]any) error {
+	for k, v := range src {
+		if _, ok := dest[k]; !ok {
+			dest[k] = v
+		}
+	}
+	return nil
+}
+
+// fresh builds a library instance holding the model's tree.
+func fresh(m *model, strict bool) *koanf.Koanf {
+	ko := koanf.NewWithConf(koanf.Conf{Delim: m.delim, StrictMerge: strict})
+	if err := ko.Load(mapProvider(m.tree()), nil); err != nil {
+		panic(fmt.Sprintf("fresh: %v", err))
+	}
+	return ko
+}
+
+// probePaths: every key and prefix of the model, an absent extension of each, "" and a
+// missing key.
+func probePaths(m *model) []string {
+	out := []string{"", "missing"}
+	for _, k := range sortedKeys(m.keyMap()) {
+		out = append(out, k, k+m.delim+"zz")
+	}
+	return out
+}
+
+// compareState checks the library against the model: keys, key map, raw and flat maps,
+// Sprint, and Exists/Get/MapKeys on the probe paths. shape names the recorded bugs whose
+// shape the case has (none for a plain failure).
+func compareState(c *collector, ht *hegel.T, what string, ko *koanf.Koanf, m *model, shape ...string) bool {
+	ok := true
+	if got, want := ko.Keys(), m.keys(); !reflect.DeepEqual(got, want) {
+		c.mismatch(ht, "keys", shape, "%s: Keys() = %v, model %v", what, got, want)
+		ok = false
+	}
+	if got, want := map[string][]string(ko.KeyMap()), m.keyMap(); !reflect.DeepEqual(got, want) {
+		c.mismatch(ht, "keymap", shape, "%s: KeyMap() = %v, model %v", what, got, want)
+		ok = false
+	}
+	if got, want := ko.Raw(), m.tree(); !reflect.DeepEqual(got, want) {
+		c.mismatch(ht, "raw", shape, "%s: Raw() = %#v, model %#v", what, got, want)
+		ok = false
+	}
+	if got, want := ko.All(), m.all(); !reflect.DeepEqual(got, want) {
+		c.mismatch(ht, "all", shape, "%s: All() = %#v, model %#v", what, got, want)
+		ok = false
+	}
+	if got, want := ko.Sprint(), m.sprint(); got != want {
+		c.mismatch(ht, "sprint", shape, "%s: Sprint() = %q, model %q", what, got, want)
+		ok = false
+	}
+	if ko.Delim() != m.delim {
+		c.mismatch(ht, "delim", shape, "%s: Delim() = %q, want %q", what, ko.Delim(), m.delim)
+		ok = false
+	}
+	for _, p := range probePaths(m) {
+		if got, want := ko.Exists(p), m.exists(p); got != want {
+			c.mismatch(ht, "exists", shape, "%s: Exists(%q) = %v, model %v", what, p, got, want)
+			ok = false
+		}
+		if got, want := ko.Get(p), m.get(p); !reflect.DeepEqual(got, want) {
+			c.mismatch(ht, "get", shape, "%s: Get(%q) = %#v, model %#v", what, p, got, want)
+			ok = false
+		}
+		if got, want := ko.MapKeys(p), m.mapKeys(p); !reflect.DeepEqual(got, want) {
+			c.mismatch(ht, "mapkeys", shape, "%s: MapKeys(%q) = %v, model %v", what, p, got, want)
+			ok = false
+		}
+	}
+	return ok
+}
+
+// afterMerge reconciles a merging operation's error with the model's. A failed strict merge
+// must leave the map as it was; which keys the library has written when it meets the conflict
+// depends on Go's map iteration order (koanf/1), so the operation is repeated on fresh copies
+// of the state (redo) and every outcome is checked. Returns the instance to go on with: under
+// HEGEL_NO_KNOWN=1 (Known.strictLoadPartial) the partial merge is counted and the instance is
+// rebuilt from the model. The shape returned names koanf/1 for the comparison that follows.
+func afterMerge(c *collector, ht *hegel.T, what string, ko *koanf.Koanf, m *model, before map[string]any, err, merr error, strict bool, redo func(*koanf.Koanf) error) (*koanf.Koanf, []string) {
+	if (err != nil) != (merr != nil) {
+		c.failClass(ht, "strict", "%s: err=%v, model err=%v (before %v)", what, err, merr, before)
+		return ko, nil
+	}
+	if err == nil {
+		return ko, nil
+	}
+	c.count("strict error")
+	changed := ko
+	partial := !reflect.DeepEqual(ko.Raw(), before)
+	for i := 0; i < 20 && !partial; i++ {
+		changed = fresh(m, strict)
+		_ = redo(changed)
+		partial = !reflect.DeepEqual(changed.Raw(), before)
+	}
+	if !partial {
+		return ko, nil
+	}
+	if Known.strictLoadPartial {
+		c.count("strict partial (known)")
+		return fresh(m, strict), nil
+	}
+	c.mismatch(ht, "strict partial", []string{"koanf/1"}, "%s: failed with %v but changed the map in some run: %v -> %v (Keys() %v)", what, err, before, changed.Raw(), changed.Keys())
+	return ko, []string{"koanf/1"}
+}
+
+// setShape names koanf/2 when a Set puts a map value on an existing map path (the library
+// merges it instead of setting it).
+func setShape(m *model, path string, val any) []string {
+	_, isMap := val.(map[string]any)
+	_, atMap := m.get(path).(map[string]any)
+	return shapeIf(isMap && atMap, "koanf/2")
+}
+
+// treeShape names koanf/5 when an incoming map holds an interface-keyed map inside a slice
+// inside a slice.
+func treeShape(v any) []string { return shapeIf(deepIfaceMap(v, 0), "koanf/5") }
+
+// TestHegelOperationsFollowTheModel: a random sequence of Load (plain, strict, with a custom
+// merge function), Set, Merge, MergeAt, Delete, Cut, Copy and Slices, each followed by a full
+// comparison with the model. The trees draw an interface-keyed map inside a slice inside a
+// slice (koanf/5), a Set a map value on an existing map path (koanf/2) and a strict instance a
+// conflicting merge (koanf/1) at their natural rates, so this property fails while any of them
+// is open, naming the shape.
+func TestHegelOperationsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, opsCases)
+		delim, strict := tcase.delim, tcase.strict
+		ko := koanf.NewWithConf(koanf.Conf{Delim: delim, StrictMerge: strict})
+		m := newModel(delim)
+		if strict {
+			c.count("strict instance")
+		}
+		for _, o := range tcase.ops {
+			before := ko.Raw()
+			var what string
+			switch o.kind {
+			case opLoad:
+				tree := o.tree
+				var opts []koanf.Option
+				if o.keep {
+					opts = append(opts, koanf.WithMergeFunc(keepExisting))
+					c.count("custom merge")
+				}
+				what = fmt.Sprintf("Load(%#v, keep=%v)", tree, o.keep)
+				load := func(k *koanf.Koanf) error {
+					return k.Load(mapProvider(deepCopy(tree).(map[string]any)), nil, opts...)
+				}
+				err := load(ko)
+				merr := m.merge(tree, nil, strict && !o.keep, o.keep)
+				var shape []string
+				ko, shape = afterMerge(c, ht, what, ko, m, before, err, merr, strict, load)
+				c.count("load")
+				if !compareState(c, ht, what, ko, m, append(shape, treeShape(tree)...)...) {
+					return
+				}
+			case opSet:
+				key := o.path.resolve(m, false)
+				val := o.val
+				what = fmt.Sprintf("Set(%q, %#v)", key, val)
+				shape := append(setShape(m, key, val), treeShape(val)...)
+				set := func(k *koanf.Koanf) error { return k.Set(key, deepCopy(val)) }
+				err := set(ko)
+				merr := m.set(key, val, strict)
+				var partial []string
+				ko, partial = afterMerge(c, ht, what, ko, m, before, err, merr, strict, set)
+				c.count("set")
+				if !compareState(c, ht, what, ko, m, append(partial, shape...)...) {
+					return
+				}
+			case opMerge:
+				tree := o.tree
+				other := koanf.New(o.delim)
+				_ = other.Load(mapProvider(deepCopy(tree).(map[string]any)), nil)
+				what = fmt.Sprintf("Merge(%#v)", tree)
+				merge := func(k *koanf.Koanf) error { return k.Merge(other) }
+				err := merge(ko)
+				merr := m.merge(tree, nil, strict, false)
+				var shape []string
+				ko, shape = afterMerge(c, ht, what, ko, m, before, err, merr, strict, merge)
+				c.count("merge")
+				if !compareState(c, ht, what, ko, m, append(shape, treeShape(tree)...)...) {
+					return
+				}
+			case opMergeAt:
+				tree := o.tree
+				path := o.path.resolve(m, true)
+				other := koanf.New(o.delim)
+				_ = other.Load(mapProvider(deepCopy(tree).(map[string]any)), nil)
+				what = fmt.Sprintf("MergeAt(%#v, %q)", tree, path)
+				mergeAt := func(k *koanf.Koanf) error { return k.MergeAt(other, path) }
+				err := mergeAt(ko)
+				var prefix []string
+				if path != "" {
+					prefix = m.split(path)
+				}
+				merr := m.merge(tree, prefix, strict, false)
+				var shape []string
+				ko, shape = afterMerge(c, ht, what, ko, m, before, err, merr, strict, mergeAt)
+				c.count("mergeat")
+				if !compareState(c, ht, what, ko, m, append(shape, treeShape(tree)...)...) {
+					return
+				}
+			case opDelete:
+				path := o.path.resolve(m, true)
+				what = fmt.Sprintf("Delete(%q)", path)
+				ko.Delete(path)
+				m.del(path)
+				c.count("delete")
+				if !compareState(c, ht, what, ko, m) {
+					return
+				}
+			case opCut:
+				path := o.path.resolve(m, true)
+				what = fmt.Sprintf("Cut(%q)", path)
+				cut := ko.Cut(path)
+				mc := m.cut(path)
+				if !compareState(c, ht, what, cut, mc) {
+					return
+				}
+				// the cut is independent of the original
+				_ = cut.Set(o.key, 1)
+				if len(mc.leaves) > 0 {
+					c.count("cut non-empty")
+				}
+				if !compareState(c, ht, what, ko, m) {
+					return
+				}
+			case opCopy:
+				what = "Copy()"
+				cp := ko.Copy()
+				if !compareState(c, ht, what, cp, m) {
+					return
+				}
+				_ = cp.Set(o.key, 1)
+				cp.Delete("")
+				if !compareState(c, ht, what, ko, m) {
+					return
+				}
+			case opSlices:
+				path := o.path.resolve(m, true)
+				if sk := sliceKeys(m); o.prefer && len(sk) > 0 {
+					path = sk[o.path.at%len(sk)]
+				}
+				what = fmt.Sprintf("Slices(%q)", path)
+				got := ko.Slices(path)
+				want := m.slices(path)
+				if len(got) != len(want) {
+					c.failClass(ht, "slices", "%s: %d instances, model %d", what, len(got), len(want))
+					return
+				}
+				for j := range got {
+					if !compareState(c, ht, fmt.Sprintf("%s[%d]", what, j), got[j], want[j]) {
+						return
+					}
+				}
+				if len(want) > 0 {
+					c.count("slices non-empty")
+				}
+				if !compareState(c, ht, what, ko, m) {
+					return
+				}
+			}
+		}
+		if len(m.leaves) > 0 {
+			c.count("final non-empty")
+		}
+		if tcase.unmarshal != nil {
+			// Unmarshal of a map path into a map reproduces the sub map
+			path := tcase.unmarshal.resolve(m, true)
+			var out map[string]any
+			err := ko.Unmarshal(path, &out)
+			want, isMap := m.get(path).(map[string]any)
+			if isMap {
+				if err != nil {
+					c.failClass(ht, "unmarshal", "Unmarshal(%q): %v", path, err)
+				} else if !reflect.DeepEqual(out, want) {
+					c.failClass(ht, "unmarshal", "Unmarshal(%q) = %#v, model %#v", path, out, want)
+				} else {
+					c.count("unmarshal map")
+				}
+			}
+		}
+	})
+}
+
+// overflows reports whether a value's %v text is a number beyond float64's range: the shape
+// of koanf/4 for Float64 (which returns the +/-Inf strconv gives with its range error).
+func overflows(v any) bool {
+	if v == nil {
+		return false
+	}
+	f, err := mFloat64(v)
+	return err != nil && math.IsInf(f, 0)
+}
+
+// checkGetters compares every getter and Must variant of the library at path p with the model
+// of the value there.
+func checkGetters(c *collector, ht *hegel.T, ko *koanf.Koanf, m *model, p, layout string) {
+	g := getters{m.get(p)}
+	check := func(name string, got, want any, shape ...string) {
+		if !reflect.DeepEqual(got, want) {
+			c.mismatch(ht, name, shape, "%s(%q) on %#v = %#v, model %#v", name, p, m.get(p), got, want)
+		}
+	}
+	floatShape := shapeIf(overflows(m.get(p)), "koanf/4")
+	check("Int64", ko.Int64(p), g.Int64())
+	check("Int", ko.Int(p), int(g.Int64()))
+	check("Float64", ko.Float64(p), g.Float64(), floatShape...)
+	check("Bool", ko.Bool(p), g.Bool())
+	check("String", ko.String(p), g.String())
+	check("Bytes", string(ko.Bytes(p)), g.String())
+	check("Duration", ko.Duration(p), g.Duration())
+	if got, want := ko.Time(p, layout), g.Time(layout); !got.Equal(want) {
+		c.failClass(ht, "Time", "Time(%q, %q) on %#v = %v, model %v", p, layout, m.get(p), got, want)
+	}
+	check("Int64s", ko.Int64s(p), g.Int64s())
+	check("Ints", ko.Ints(p), g.Ints())
+	check("Float64s", ko.Float64s(p), g.Float64s())
+	check("Strings", ko.Strings(p), g.Strings())
+	if got, want := ko.Bools(p), g.Bools(); !(len(got) == 0 && len(want) == 0) && !reflect.DeepEqual(got, want) {
+		c.failClass(ht, "Bools", "Bools(%q) on %#v = %#v, model %#v", p, m.get(p), got, want)
+	}
+	check("Int64Map", ko.Int64Map(p), g.Int64Map())
+	im := map[string]int{}
+	for k, x := range g.Int64Map() {
+		im[k] = int(x)
+	}
+	check("IntMap", ko.IntMap(p), im)
+	check("Float64Map", ko.Float64Map(p), g.Float64Map())
+	check("BoolMap", ko.BoolMap(p), g.BoolMap())
+	check("StringMap", ko.StringMap(p), g.StringMap())
+	sm := ko.StringsMap(p)
+	for k, ss := range sm {
+		if len(ss) == 0 {
+			delete(sm, k)
+		}
+	}
+	check("StringsMap", sm, g.StringsMap())
+	// the Must variants panic exactly on the zero value
+	checkPanics(c, ht, p, "MustInt64", func() { ko.MustInt64(p) }, g.Int64() == 0)
+	checkPanics(c, ht, p, "MustFloat64", func() { ko.MustFloat64(p) }, g.Float64() == 0, floatShape...)
+	checkPanics(c, ht, p, "MustString", func() { ko.MustString(p) }, g.String() == "")
+	checkPanics(c, ht, p, "MustStrings", func() { ko.MustStrings(p) }, len(g.Strings()) == 0)
+	checkPanics(c, ht, p, "MustInt64s", func() { ko.MustInt64s(p) }, len(g.Int64s()) == 0)
+	checkPanics(c, ht, p, "MustDuration", func() { ko.MustDuration(p) }, g.Duration() == 0)
+	checkPanics(c, ht, p, "MustTime", func() { ko.MustTime(p, layout) }, g.Time(layout).IsZero())
+	checkPanics(c, ht, p, "MustStringMap", func() { ko.MustStringMap(p) }, len(g.StringMap()) == 0)
+	checkPanics(c, ht, p, "MustBoolMap", func() { ko.MustBoolMap(p) }, len(g.BoolMap()) == 0)
+}
+
+// TestHegelGettersConvert: every getter on a leaf value, a sub map, a missing key and the root,
+// against the documented conversions. The string pool holds numbers beyond float64's range at
+// its natural rate, so this property meets koanf/4 (Float64 returning Inf) in some runs.
+func TestHegelGettersConvert(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, getterCases)
+		m := newModel(".")
+		_ = m.merge(tcase.tree(), nil, false, false)
+		ko := fresh(m, false)
+		for _, p := range []string{"v", "n", "n.v", "n.w", "m", "zz", ""} {
+			checkGetters(c, ht, ko, m, p, tcase.layout)
+			if p == "v" {
+				c.count(fmt.Sprintf("type %T", m.get(p)))
+			}
+		}
+	})
+}
+
+func checkPanics(c *collector, ht *hegel.T, p, name string, f func(), want bool, shape ...string) {
+	got := false
+	func() {
+		defer func() {
+			if recover() != nil {
+				got = true
+			}
+		}()
+		f()
+	}()
+	if got != want {
+		c.mismatch(ht, name, shape, "%s(%q) panics=%v, model %v", name, p, got, want)
+	}
+}
+
+// TestHegelValuesAreCopied: the configuration shares nothing with the caller: Get and the
+// getters return copies, Copy and Cut are independent instances, and the provider's map is
+// not written to by Load or by later operations. The provider's tree holds interface-keyed
+// maps (rewritten in place at Load) and shares top-level maps with the second Load's tree at
+// their natural rates, so this property fails while koanf/3 is open (and meets koanf/5 in the
+// state comparison).
+func TestHegelValuesAreCopied(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, copyCases)
+		delim := tcase.delim
+		ko := koanf.New(delim)
+		m := newModel(delim)
+		orig := tcase.orig
+		snapshot := deepCopy(orig)
+		if err := ko.Load(mapProvider(orig), nil); err != nil {
+			c.fail(ht, "Load: %v", err)
+			return
+		}
+		_ = m.merge(orig, nil, false, false)
+		shape := treeShape(orig)
+
+		// Get returns copies: writing into a returned slice or map changes nothing
+		for _, k := range m.keys() {
+			switch g := ko.Get(k).(type) {
+			case []any:
+				if len(g) > 0 {
+					g[0] = "changed"
+				}
+			case map[string]any:
+				g["changed"] = 1
+			case []string:
+				if len(g) > 0 {
+					g[0] = "changed"
+				}
+			case map[string]string:
+				g["changed"] = "1"
+			}
+			if s := ko.Strings(k); len(s) > 0 {
+				s[0] = "changed"
+			}
+			if s := ko.Int64s(k); len(s) > 0 {
+				s[0] = 77
+			}
+			if mp := ko.StringMap(k); len(mp) > 0 {
+				mp["changed"] = "1"
+			}
+		}
+		if raw := ko.Raw(); len(raw) > 0 {
+			for k := range raw {
+				delete(raw, k)
+			}
+		}
+		if !compareState(c, ht, "after writing into Get results", ko, m, shape...) {
+			return
+		}
+
+		// Copy and Cut are independent
+		cp := ko.Copy()
+		mcp := m.clone()
+		var cutPath string
+		if ks := m.keys(); len(ks) > 0 {
+			cutPath = ks[tcase.cutAt%len(ks)]
+		}
+		cut := ko.Cut(cutPath)
+		mcut := m.cut(cutPath)
+		if len(mcut.leaves) > 0 {
+			c.count("cut non-empty")
+		}
+		cpShape := append(append(append([]string{}, shape...), treeShape(tcase.v1)...), setShape(mcp, tcase.k1, tcase.v1)...)
+		_ = cp.Set(tcase.k1, deepCopy(tcase.v1))
+		_ = mcp.set(tcase.k1, tcase.v1, false)
+		cutShape := append(append(append([]string{}, cpShape...), treeShape(tcase.v2)...), setShape(mcut, tcase.k2, tcase.v2)...)
+		_ = cut.Set(tcase.k2, deepCopy(tcase.v2))
+		_ = mcut.set(tcase.k2, tcase.v2, false)
+		dp := tcase.del.resolve(mcp, false)
+		cp.Delete(dp)
+		mcp.del(dp)
+		if !compareState(c, ht, "original after writing to Copy and Cut", ko, m, shape...) {
+			return
+		}
+		second := tcase.second
+		err := ko.Load(mapProvider(deepCopy(second).(map[string]any)), nil)
+		_ = m.merge(second, nil, false, false)
+		if err != nil {
+			c.fail(ht, "second Load: %v", err)
+			return
+		}
+		if !compareState(c, ht, "Copy after writing to the original", cp, mcp, cpShape...) {
+			return
+		}
+		if !compareState(c, ht, "Cut after writing to the original", cut, mcut, cutShape...) {
+			return
+		}
+
+		// the first provider's map after the second Load
+		if !reflect.DeepEqual(orig, snapshot) {
+			if Known.loadAliasesProvider {
+				c.count("provider map written (known)")
+			} else {
+				c.mismatch(ht, "provider", []string{"koanf/3"}, "the provider's map changed after Load: %#v -> %#v", snapshot, orig)
+			}
+		} else {
+			c.count("provider map intact")
+		}
+	})
+}
