+package koanf_test
+
+// The model: a configuration is a set of leaf paths (the parts of a key) with their values.
+// A leaf value is anything that is not a non-empty map[string]any: a scalar, a slice, a typed
+// map, or an empty map[string]any (the "empty map" leaf that Flatten keeps as a value). No
+// leaf path is a prefix of another. Keys never contain the delimiter (a documented limitation
+// of delimited key paths), so joined keys are unambiguous.
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- values
+
+func isEmptyMap(v any) bool {
+	mp, ok := v.(map[string]any)
+	return ok && len(mp) == 0
+}
+
+// deepCopy copies the value shapes the generators produce.
+func deepCopy(v any) any {
+	switch x := v.(type) {
+	case map[string]any:
+		out := make(map[string]any, len(x))
+		for k, val := range x {
+			out[k] = deepCopy(val)
+		}
+		return out
+	case map[any]any:
+		out := make(map[any]any, len(x))
+		for k, val := range x {
+			out[k] = deepCopy(val)
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, val := range x {
+			out[i] = deepCopy(val)
+		}
+		return out
+	case []string:
+		return append([]string{}, x...)
+	case []int:
+		return append([]int{}, x...)
+	case []int64:
+		return append([]int64{}, x...)
+	case []float64:
+		return append([]float64{}, x...)
+	case []bool:
+		return append([]bool{}, x...)
+	case map[string]string:
+		out := make(map[string]string, len(x))
+		for k, val := range x {
+			out[k] = val
+		}
+		return out
+	case map[string][]string:
+		out := make(map[string][]string, len(x))
+		for k, val := range x {
+			out[k] = append([]string{}, val...)
+		}
+		return out
+	}
+	return v
+}
+
+// convertKeys is what the documentation of IntfaceKeysToStrings promises: every map[any]any
+// becomes a map[string]any with %v keys, recursively. The library reaches maps inside a slice
+// but not inside a slice inside a slice (Known.nestedSliceMapsUnconverted). The result shares
+// nothing with the input.
+func convertKeys(v any, sliceDepth int) any {
+	switch x := v.(type) {
+	case map[any]any:
+		out := make(map[string]any, len(x))
+		for k, val := range x {
+			out[fmt.Sprintf("%v", k)] = convertKeys(val, 0)
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(x))
+		for k, val := range x {
+			out[k] = convertKeys(val, 0)
+		}
+		return out
+	case []any:
+		if sliceDepth >= 1 && Known.nestedSliceMapsUnconverted {
+			return deepCopy(x)
+		}
+		out := make([]any, len(x))
+		for i, val := range x {
+			out[i] = convertKeys(val, sliceDepth+1)
+		}
+		return out
+	}
+	return deepCopy(v)
+}
+
+// --------------------------------------------------------------------------- the model
+
+type leaf struct {
+	parts []string
+	val   any
+}
+
+type model struct {
+	delim  string
+	leaves map[string]leaf // joined path -> leaf
+}
+
+func newModel(delim string) *model { return &model{delim: delim, leaves: map[string]leaf{}} }
+
+func (m *model) join(parts []string) string { return strings.Join(parts, m.delim) }
+
+func (m *model) split(path string) []string { return strings.Split(path, m.delim) }
+
+func (m *model) clone() *model {
+	n := newModel(m.delim)
+	for k, l := range m.leaves {
+		n.leaves[k] = leaf{append([]string{}, l.parts...), deepCopy(l.val)}
+	}
+	return n
+}
+
+// leavesOf flattens a (converted) nested map under prefix.
+func leavesOf(tree map[string]any, prefix []string) []leaf {
+	var out []leaf
+	for k, v := range tree {
+		parts := append(append([]string{}, prefix...), k)
+		if mp, ok := v.(map[string]any); ok && len(mp) > 0 {
+			out = append(out, leavesOf(mp, parts)...)
+			continue
+		}
+		out = append(out, leaf{parts, v})
+	}
+	return out
+}
+
+// under reports whether key lies strictly under prefix.
+func (m *model) under(key, prefix string) bool {
+	return strings.HasPrefix(key, prefix+m.delim)
+}
+
+// conflict is the strict-merge type check for one incoming leaf.
+func (m *model) conflict(l leaf) bool {
+	key := m.join(l.parts)
+	for k, w := range m.leaves {
+		switch {
+		case k == key:
+			if isEmptyMap(l.val) {
+				if !isEmptyMap(w.val) {
+					return true
+				}
+			} else if reflect.TypeOf(w.val) != reflect.TypeOf(l.val) {
+				return true
+			}
+		case m.under(key, k): // a value at a strict prefix of the incoming key (an empty map merges)
+			if !isEmptyMap(w.val) {
+				return true
+			}
+		case m.under(k, key): // leaves under the incoming key
+			if !isEmptyMap(l.val) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// apply merges one incoming leaf: a nested map merges into a map, anything else replaces.
+func (m *model) apply(l leaf) {
+	key := m.join(l.parts)
+	hasChildren := false
+	for k := range m.leaves {
+		if m.under(key, k) {
+			delete(m.leaves, k) // a map replaces a value at a prefix
+		}
+		if m.under(k, key) {
+			if isEmptyMap(l.val) {
+				hasChildren = true
+			} else {
+				delete(m.leaves, k) // a value replaces a map
+			}
+		}
+	}
+	if isEmptyMap(l.val) && hasChildren {
+		return // an empty map merges nothing
+	}
+	m.leaves[key] = leaf{append([]string{}, l.parts...), deepCopy(l.val)}
+}
+
+// merge merges a tree under prefix. strict: refuse (and change nothing) on a type conflict.
+// keepTop: the custom merge function of the tests, which adds only missing top-level keys.
+func (m *model) merge(tree map[string]any, prefix []string, strict, keepTop bool) error {
+	conv := convertKeys(tree, 0).(map[string]any)
+	var ls []leaf
+	if len(conv) == 0 && len(prefix) > 0 {
+		ls = []leaf{{append([]string{}, prefix...), map[string]any{}}}
+	} else {
+		ls = leavesOf(conv, prefix)
+	}
+	if strict {
+		for _, l := range ls {
+			if m.conflict(l) {
+				return fmt.Errorf("model: type conflict at %s", m.join(l.parts))
+			}
+		}
+	}
+	tops := map[string]bool{}
+	for _, l := range m.leaves {
+		tops[l.parts[0]] = true
+	}
+	for _, l := range ls {
+		if keepTop && tops[l.parts[0]] {
+			continue
+		}
+		m.apply(l)
+	}
+	return nil
+}
+
+// set is Set: the tree {key: val} merged (Known.setMergesMaps), or the value replacing the
+// key's subtree.
+func (m *model) set(key string, val any, strict bool) error {
+	parts := m.split(key)
+	if !Known.setMergesMaps {
+		if _, ok := val.(map[string]any); ok {
+			m.removeSubtree(key)
+		}
+	}
+	return m.merge(map[string]any{parts[len(parts)-1]: val}, parts[:len(parts)-1], strict, false)
+}
+
+func (m *model) removeSubtree(key string) {
+	for k := range m.leaves {
+		if k == key || m.under(k, key) {
+			delete(m.leaves, k)
+		}
+	}
+}
+
+func (m *model) exists(path string) bool {
+	_, ok := m.keyMap()[path]
+	return ok
+}
+
+// keyMap: every leaf key and every prefix of it, with the parts.
+func (m *model) keyMap() map[string][]string {
+	out := map[string][]string{}
+	for _, l := range m.leaves {
+		for i := 1; i <= len(l.parts); i++ {
+			k := m.join(l.parts[:i])
+			if _, ok := out[k]; !ok {
+				out[k] = append([]string{}, l.parts[:i]...)
+			}
+		}
+	}
+	return out
+}
+
+func (m *model) keys() []string {
+	out := make([]string, 0, len(m.leaves))
+	for k := range m.leaves {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func (m *model) all() map[string]any {
+	out := make(map[string]any, len(m.leaves))
+	for k, l := range m.leaves {
+		out[k] = deepCopy(l.val)
+	}
+	return out
+}
+
+// subtree builds the nested map of the leaves strictly under prefix ("" is the whole tree).
+func (m *model) subtree(prefix string) map[string]any {
+	out := map[string]any{}
+	for k, l := range m.leaves {
+		if prefix != "" && !m.under(k, prefix) {
+			continue
+		}
+		parts := l.parts
+		if prefix != "" {
+			parts = parts[len(m.split(prefix)):]
+		}
+		cur := out
+		for _, p := range parts[:len(parts)-1] {
+			next, ok := cur[p].(map[string]any)
+			if !ok {
+				next = map[string]any{}
+				cur[p] = next
+			}
+			cur = next
+		}
+		cur[parts[len(parts)-1]] = deepCopy(l.val)
+	}
+	return out
+}
+
+func (m *model) tree() map[string]any { return m.subtree("") }
+
+// get: the leaf value, the sub map of a prefix, the whole tree for "", nil otherwise.
+func (m *model) get(path string) any {
+	if path == "" {
+		return m.tree()
+	}
+	if l, ok := m.leaves[path]; ok {
+		return deepCopy(l.val)
+	}
+	if m.exists(path) {
+		return m.subtree(path)
+	}
+	return nil
+}
+
+func (m *model) mapKeys(path string) []string {
+	out := []string{}
+	if mp, ok := m.get(path).(map[string]any); ok {
+		for k := range mp {
+			out = append(out, k)
+		}
+		sort.Strings(out)
+	}
+	return out
+}
+
+// cut re-roots the sub map at path (an empty model when the path is not a map).
+func (m *model) cut(path string) *model {
+	n := newModel(m.delim)
+	if mp, ok := m.get(path).(map[string]any); ok {
+		_ = n.merge(mp, nil, false, false)
+	}
+	return n
+}
+
+// slices: one model per map element of a []any leaf.
+func (m *model) slices(path string) []*model {
+	out := []*model{}
+	if path == "" {
+		return out
+	}
+	sl, ok := m.get(path).([]any)
+	if !ok {
+		return out
+	}
+	for _, el := range sl {
+		if mp, ok := el.(map[string]any); ok {
+			n := newModel(m.delim)
+			_ = n.merge(mp, nil, false, false)
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// del is Delete: the path and everything under it; a parent left empty disappears.
+func (m *model) del(path string) {
+	if path == "" {
+		m.leaves = map[string]leaf{}
+		return
+	}
+	if !m.exists(path) {
+		return
+	}
+	m.removeSubtree(path)
+}
+
+func (m *model) sprint() string {
+	var b strings.Builder
+	for _, k := range m.keys() {
+		fmt.Fprintf(&b, "%s -> %v\n", k, m.leaves[k].val)
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- conversions
+
+// mInt64 is the documented conversion of toInt64: integers as they are (unsigned ones that
+// fit), anything else through %v and strconv (an integer, else a float truncated).
+func mInt64(v any) (int64, bool) {
+	switch i := v.(type) {
+	case int:
+		return int64(i), true
+	case int8:
+		return int64(i), true
+	case int16:
+		return int64(i), true
+	case int32:
+		return int64(i), true
+	case int64:
+		return i, true
+	case uint8:
+		return int64(i), true
+	case uint16:
+		return int64(i), true
+	case uint32:
+		return int64(i), true
+	case uint:
+		if uint64(i) > math.MaxInt64 {
+			return 0, false
+		}
+		return int64(i), true
+	case uint64:
+		if i > math.MaxInt64 {
+			return 0, false
+		}
+		return int64(i), true
+	}
+	s := fmt.Sprintf("%v", v)
+	if i, err := strconv.ParseInt(s, 10, 64); err == nil {
+		return i, true
+	}
+	f, err := strconv.ParseFloat(s, 64)
+	if err != nil || math.IsNaN(f) || f < math.MinInt64 || f >= 1<<63 {
+		return 0, false
+	}
+	return int64(f), true
+}
+
+// mFloat64: floats as they are, anything else through %v and ParseFloat. The second result
+// is the parse error; Float64 ignores it (Known.float64RangeErrorReturnsInf), the slice and
+// map getters do not.
+func mFloat64(v any) (float64, error) {
+	switch f := v.(type) {
+	case float32:
+		return float64(f), nil
+	case float64:
+		return f, nil
+	}
+	return strconv.ParseFloat(fmt.Sprintf("%v", v), 64)
+}
+
+func mBool(v any) (bool, bool) {
+	if b, ok := v.(bool); ok {
+		return b, true
+	}
+	b, err := strconv.ParseBool(fmt.Sprintf("%v", v))
+	return b, err == nil
+}
+
+func mString(v any) string {
+	if v == nil {
+		return ""
+	}
+	if s, ok := v.(string); ok {
+		return s
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+// getters is the model of every getter on a value (nil: the path does not exist).
+type getters struct{ v any }
+
+func (g getters) Int64() int64 {
+	if g.v == nil {
+		return 0
+	}
+	i, _ := mInt64(g.v)
+	return i
+}
+
+func (g getters) Float64() float64 {
+	if g.v == nil {
+		return 0
+	}
+	f, err := mFloat64(g.v)
+	if err != nil && !Known.float64RangeErrorReturnsInf {
+		return 0
+	}
+	return f
+}
+
+func (g getters) Bool() bool {
+	if g.v == nil {
+		return false
+	}
+	b, _ := mBool(g.v)
+	return b
+}
+
+func (g getters) String() string { return mString(g.v) }
+
+func (g getters) Duration() time.Duration {
+	if i := g.Int64(); i != 0 {
+		return time.Duration(i)
+	}
+	d, _ := time.ParseDuration(g.String())
+	return d
+}
+
+func (g getters) Time(layout string) time.Time {
+	if i := g.Int64(); i != 0 {
+		return time.Unix(i, 0)
+	}
+	if s := g.String(); s != "" {
+		t, _ := time.Parse(layout, s)
+		return t
+	}
+	return time.Time{}
+}
+
+func (g getters) Int64s() []int64 {
+	switch v := g.v.(type) {
+	case []int64:
+		return append([]int64{}, v...)
+	case []int:
+		out := make([]int64, 0, len(v))
+		for _, x := range v {
+			out = append(out, int64(x))
+		}
+		return out
+	case []any:
+		out := make([]int64, 0, len(v))
+		for _, x := range v {
+			i, ok := mInt64(x)
+			if !ok {
+				return []int64{}
+			}
+			out = append(out, i)
+		}
+		return out
+	}
+	return []int64{}
+}
+
+func (g getters) Ints() []int {
+	switch v := g.v.(type) {
+	case []int:
+		return append([]int{}, v...)
+	case []int64:
+		out := make([]int, 0, len(v))
+		for _, x := range v {
+			out = append(out, int(x))
+		}
+		return out
+	case []any:
+		out := make([]int, 0, len(v))
+		for _, x := range v {
+			i, ok := mInt64(x)
+			if !ok {
+				return []int{}
+			}
+			out = append(out, int(i))
+		}
+		return out
+	}
+	return []int{}
+}
+
+func (g getters) Float64s() []float64 {
+	switch v := g.v.(type) {
+	case []float64:
+		return append([]float64{}, v...)
+	case []any:
+		out := make([]float64, 0, len(v))
+		for _, x := range v {
+			f, err := mFloat64(x)
+			if err != nil {
+				return []float64{}
+			}
+			out = append(out, f)
+		}
+		return out
+	}
+	return []float64{}
+}
+
+func (g getters) Strings() []string {
+	switch v := g.v.(type) {
+	case []string:
+		return append([]string{}, v...)
+	case []any:
+		out := make([]string, 0, len(v))
+		for _, x := range v {
+			if s, ok := x.(string); ok {
+				out = append(out, s)
+			} else {
+				out = append(out, fmt.Sprintf("%v", x))
+			}
+		}
+		return out
+	}
+	return []string{}
+}
+
+func (g getters) Bools() []bool {
+	switch v := g.v.(type) {
+	case []bool:
+		return append([]bool{}, v...)
+	case []any:
+		out := make([]bool, 0, len(v))
+		for _, x := range v {
+			b, ok := mBool(x)
+			if !ok {
+				return []bool{}
+			}
+			out = append(out, b)
+		}
+		return out
+	}
+	return []bool{}
+}
+
+func (g getters) Int64Map() map[string]int64 {
+	out := map[string]int64{}
+	mp, ok := g.v.(map[string]any)
+	if !ok {
+		return out
+	}
+	for k, x := range mp {
+		i, ok := mInt64(x)
+		if !ok {
+			return map[string]int64{}
+		}
+		out[k] = i
+	}
+	return out
+}
+
+func (g getters) Float64Map() map[string]float64 {
+	out := map[string]float64{}
+	mp, ok := g.v.(map[string]any)
+	if !ok {
+		return out
+	}
+	for k, x := range mp {
+		f, err := mFloat64(x)
+		if err != nil {
+			return map[string]float64{}
+		}
+		out[k] = f
+	}
+	return out
+}
+
+func (g getters) BoolMap() map[string]bool {
+	out := map[string]bool{}
+	mp, ok := g.v.(map[string]any)
+	if !ok {
+		return out
+	}
+	for k, x := range mp {
+		b, ok := mBool(x)
+		if !ok {
+			return map[string]bool{}
+		}
+		out[k] = b
+	}
+	return out
+}
+
+func (g getters) StringMap() map[string]string {
+	out := map[string]string{}
+	switch mp := g.v.(type) {
+	case map[string]string:
+		for k, s := range mp {
+			out[k] = s
+		}
+	case map[string]any:
+		for k, x := range mp {
+			s, ok := x.(string)
+			if !ok {
+				return map[string]string{}
+			}
+			out[k] = s
+		}
+	}
+	return out
+}
+
+// StringsMap: entries with no strings are dropped (the library keeps a nil entry for an empty
+// []string and none for an empty []any; both are compared as absent).
+func (g getters) StringsMap() map[string][]string {
+	out := map[string][]string{}
+	switch mp := g.v.(type) {
+	case map[string][]string:
+		for k, ss := range mp {
+			if len(ss) > 0 {
+				out[k] = append([]string{}, ss...)
+			}
+		}
+	case map[string]any:
+		for k, x := range mp {
+			switch s := x.(type) {
+			case []string:
+				if len(s) > 0 {
+					out[k] = append([]string{}, s...)
+				}
+			case []any:
+				for _, e := range s {
+					str, ok := e.(string)
+					if !ok {
+						return map[string][]string{}
+					}
+					out[k] = append(out[k], str)
+				}
+			default:
+				return map[string][]string{}
+			}
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- generators
+
+var keyAlphabet = []string{"a", "b", "c", "x", "y", "k1", "k2", "-", "A"}
+
+var delims = []string{".", "/", "::"}
+
+var someStrings = []string{
+	"", "12", "-7", "12.7", "1e2", "1e400", "-1e400", "1e-400", "0x1p4", "abc", "true", "T", "1", "0",
+	"f", "yes", "1h30m", "2ms", " 5", "9223372036854775807", "9223372036854775808",
+	"-9223372036854775809", "Inf", "1_000", "2006-01-02", "0.5", "-0", "+3", "007",
+}
+
+var someInts = []int{0, 1, -1, 42, -7, 1 << 40, math.MaxInt64, math.MinInt64}
+
+var someUints = []uint64{0, 5, 1 << 63, math.MaxUint64, math.MaxInt64}
+
+var someFloats = []float64{0, 1, -1, 1.5, -2.25, 1e6, 1e20, 3, 123456789, 1e-7, math.MaxFloat64,
+	math.Inf(1), math.Copysign(0, -1), 9.5e18}
+
+func genScalar(tc hegel.TestCase) any {
+	switch drawInt(tc, 0, 7) {
+	case 0:
+		return pick(tc, someInts)
+	case 1:
+		return int64(pick(tc, someInts))
+	case 2:
+		return pick(tc, someUints)
+	case 3:
+		return pick(tc, someFloats)
+	case 4, 5:
+		return pick(tc, someStrings)
+	case 6:
+		return chance(tc, 50)
+	}
+	return nil
+}
+
+func genKey(tc hegel.TestCase) string { return pick(tc, keyAlphabet) }
+
+// genValue draws a leaf value: a scalar, a slice, a typed map, an empty map, a map with
+// interface keys (converted at load).
+func genValue(tc hegel.TestCase, depth int) any {
+	switch drawInt(tc, 0, 12) {
+	case 0, 1, 2, 3:
+		return genScalar(tc)
+	case 4:
+		n := drawInt(tc, 0, 4)
+		out := make([]any, n)
+		for i := range out {
+			if depth < 2 && chance(tc, 25) {
+				out[i] = genTree(tc, depth+1)
+			} else if depth < 2 && chance(tc, 15) {
+				out[i] = genValue(tc, depth+1)
+			} else {
+				out[i] = genScalar(tc)
+			}
+		}
+		return out
+	case 5:
+		n := drawInt(tc, 0, 3)
+		out := make([]string, n)
+		for i := range out {
+			out[i] = pick(tc, someStrings)
+		}
+		return out
+	case 6:
+		n := drawInt(tc, 0, 3)
+		out := make([]int, n)
+		for i := range out {
+			out[i] = pick(tc, someInts)
+		}
+		return out
+	case 7:
+		n := drawInt(tc, 0, 3)
+		out := make([]int64, n)
+		for i := range out {
+			out[i] = int64(pick(tc, someInts))
+		}
+		return out
+	case 8:
+		n := drawInt(tc, 0, 3)
+		out := make([]float64, n)
+		for i := range out {
+			out[i] = pick(tc, someFloats)
+		}
+		return out
+	case 9:
+		n := drawInt(tc, 0, 3)
+		out := make([]bool, n)
+		for i := range out {
+			out[i] = chance(tc, 50)
+		}
+		return out
+	case 10:
+		out := map[string]string{}
+		for i := drawInt(tc, 0, 3); i > 0; i-- {
+			out[genKey(tc)] = pick(tc, someStrings)
+		}
+		return out
+	case 11:
+		out := map[string][]string{}
+		for i := drawInt(tc, 0, 3); i > 0; i-- {
+			n := drawInt(tc, 0, 2)
+			ss := make([]string, n)
+			for j := range ss {
+				ss[j] = pick(tc, someStrings)
+			}
+			out[genKey(tc)] = ss
+		}
+		return out
+	}
+	return map[string]any{}
+}
+
+// genTree draws a nested map[string]any: 0-4 keys, values sub trees, interface-keyed maps or
+// leaf values.
+func genTree(tc hegel.TestCase, depth int) map[string]any {
+	out := map[string]any{}
+	for i := drawInt(tc, 0, 4); i > 0; i-- {
+		k := genKey(tc)
+		switch {
+		case depth < 3 && chance(tc, 35):
+			out[k] = genTree(tc, depth+1)
+		case depth < 3 && chance(tc, 15):
+			out[k] = genIfaceMap(tc, depth+1)
+		default:
+			out[k] = genValue(tc, depth)
+		}
+	}
+	return out
+}
+
+// genIfaceMap draws a map[any]any with string and int keys (distinct after %v).
+func genIfaceMap(tc hegel.TestCase, depth int) map[any]any {
+	out := map[any]any{}
+	for i := drawInt(tc, 0, 3); i > 0; i-- {
+		var k any = genKey(tc)
+		if chance(tc, 30) {
+			k = drawInt(tc, 7, 9)
+		}
+		switch {
+		case depth < 3 && chance(tc, 30):
+			out[k] = genIfaceMap(tc, depth+1)
+		case depth < 3 && chance(tc, 20):
+			out[k] = []any{genIfaceMap(tc, depth+1), genScalar(tc)}
+		default:
+			out[k] = genScalar(tc)
+		}
+	}
+	return out
+}
+
+// genPath draws a key path: an existing key or prefix, a fresh path, an extension of an
+// existing key, or "".
+func genPath(tc hegel.TestCase, m *model, allowEmpty bool) string {
+	km := m.keyMap()
+	existing := make([]string, 0, len(km))
+	for k := range km {
+		existing = append(existing, k)
+	}
+	sort.Strings(existing)
+	switch r := drawInt(tc, 0, 9); {
+	case r == 0 && allowEmpty:
+		return ""
+	case r <= 4 && len(existing) > 0:
+		return pick(tc, existing)
+	case r <= 6 && len(existing) > 0:
+		return pick(tc, existing) + m.delim + genKey(tc)
+	}
+	n := drawInt(tc, 1, 3)
+	parts := make([]string, n)
+	for i := range parts {
+		parts[i] = genKey(tc)
+	}
+	return m.join(parts)
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..861b435
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,109 @@
+package koanf_test
+
+// Pins: one plain test per recorded bug, asserting the documented behaviour. Each fails while
+// its bug exists (target.toml lists them as expected failures).
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"testing"
+
+	"github.com/knadh/koanf/v2"
+)
+
+// koanf/1: a strict Load that fails with a type error must leave the configuration as it was;
+// in any case Raw() and Keys() must describe the same map.
+func TestHegelPinStrictLoadIsAtomic(t *testing.T) {
+	for i := 0; i < 50; i++ {
+		ko := koanf.NewWithConf(koanf.Conf{Delim: ".", StrictMerge: true})
+		if err := ko.Load(mapProvider{"m": map[string]any{"k": 1}}, nil); err != nil {
+			t.Fatal(err)
+		}
+		before := ko.Raw()
+		err := ko.Load(mapProvider{"m": map[string]any{"k": "x"}, "n": 2}, nil)
+		if err == nil {
+			t.Fatal("strict Load of a string over an int: no error")
+		}
+		if !reflect.DeepEqual(ko.Raw(), before) {
+			t.Fatalf("after the failed strict Load, Raw() = %v (was %v), Keys() = %v", ko.Raw(), before, ko.Keys())
+		}
+	}
+}
+
+// koanf/2: Set sets the value at the key: afterwards Get returns that value, whatever was
+// there before.
+func TestHegelPinSetReplacesTheValue(t *testing.T) {
+	ko := koanf.New(".")
+	_ = ko.Load(mapProvider{"db": map[string]any{"host": "h", "port": 1}}, nil)
+	if err := ko.Set("db", map[string]any{"host": "x"}); err != nil {
+		t.Fatal(err)
+	}
+	if got := ko.Get("db"); !reflect.DeepEqual(got, map[string]any{"host": "x"}) {
+		t.Errorf("after Set(\"db\", {host: x}), Get(\"db\") = %v", got)
+	}
+	if err := ko.Set("db", map[string]any{}); err != nil {
+		t.Fatal(err)
+	}
+	if got := ko.Get("db"); !reflect.DeepEqual(got, map[string]any{}) {
+		t.Errorf("after Set(\"db\", {}), Get(\"db\") = %v", got)
+	}
+}
+
+// koanf/3: Load does not keep the provider's map: a later Load must not write into it, and
+// changing the provider's data afterwards must not change the configuration.
+func TestHegelPinLoadCopiesTheProvider(t *testing.T) {
+	defaults := map[string]any{"server": map[string]any{"port": 8080}, "tags": []any{"a"}}
+	ko := koanf.New(".")
+	_ = ko.Load(mapProvider(defaults), nil)
+	_ = ko.Load(mapProvider{"server": map[string]any{"port": 9090}}, nil)
+	if p := defaults["server"].(map[string]any)["port"]; p != 8080 {
+		t.Errorf("the defaults map was written to by the second Load: server.port = %v", p)
+	}
+	defaults["tags"].([]any)[0] = "changed"
+	if got := ko.Strings("tags"); !reflect.DeepEqual(got, []string{"a"}) {
+		t.Errorf("changing the provider's slice changed the configuration: tags = %v", got)
+	}
+}
+
+// koanf/4: Float64 returns 0 for a value that is not a valid float64, as Float64s and
+// Float64Map do for the same value.
+func TestHegelPinFloat64OutOfRangeIsZero(t *testing.T) {
+	ko := koanf.New(".")
+	_ = ko.Load(mapProvider{"a": "1e400", "b": "-1e400", "s": []any{"1e400"}}, nil)
+	for _, k := range []string{"a", "b"} {
+		if f := ko.Float64(k); f != 0 {
+			t.Errorf("Float64(%q) = %v (Inf %v) for %q; Float64s of the same value = %v", k, f, math.IsInf(f, 0), ko.String(k), ko.Float64s("s"))
+		}
+	}
+}
+
+// koanf/5: every map[any]any in the loaded map becomes a map[string]any, however deep.
+func TestHegelPinNestedSliceMapsConverted(t *testing.T) {
+	ko := koanf.New(".")
+	_ = ko.Load(mapProvider{"a": []any{[]any{map[any]any{"b": 1}}}}, nil)
+	got := ko.Get("a")
+	want := []any{[]any{map[string]any{"b": 1}}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("Get(\"a\") = %#v, want %#v", got, want)
+	}
+}
+
+// koanf/6: Set on an existing key path whose key contains the delimiter must not leave two
+// structures behind the same flattened key; Get afterwards must return the set value, every
+// time.
+func TestHegelPinSetOnKeyWithDelimiterIsDeterministic(t *testing.T) {
+	seen := map[string]int{}
+	for i := 0; i < 100; i++ {
+		ko := koanf.New(".")
+		_ = ko.Load(mapProvider{"hosts": map[string]any{"example.com": map[string]any{"port": 1}}}, nil)
+		if !ko.Exists("hosts.example.com.port") {
+			t.Fatal("the path does not exist before Set")
+		}
+		_ = ko.Set("hosts.example.com.port", 2)
+		seen[fmt.Sprint(ko.Get("hosts.example.com.port"))]++
+	}
+	if len(seen) != 1 || seen["2"] != 100 {
+		t.Errorf("Get after Set(\"hosts.example.com.port\", 2) over 100 runs: %v", seen)
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..49b2418
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,460 @@
+package koanf_test
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/knadh/koanf/v2"
+	"hegel.dev/go/hegel"
+)
+
+// keepExisting is the custom merge function of the tests: it adds the top-level keys missing
+// from dest and leaves the others alone.
+func keepExisting(src, dest map[string]any) error {
+	for k, v := range src {
+		if _, ok := dest[k]; !ok {
+			dest[k] = v
+		}
+	}
+	return nil
+}
+
+// fresh builds a library instance holding the model's tree.
+func fresh(m *model, strict bool) *koanf.Koanf {
+	ko := koanf.NewWithConf(koanf.Conf{Delim: m.delim, StrictMerge: strict})
+	if err := ko.Load(mapProvider(m.tree()), nil); err != nil {
+		panic(fmt.Sprintf("fresh: %v", err))
+	}
+	return ko
+}
+
+// probePaths: every key and prefix of the model, an absent extension of each, "" and a
+// missing key.
+func probePaths(m *model) []string {
+	km := m.keyMap()
+	out := []string{"", "missing"}
+	keys := make([]string, 0, len(km))
+	for k := range km {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		out = append(out, k, k+m.delim+"zz")
+	}
+	return out
+}
+
+// compareState checks the library against the model: keys, key map, raw and flat maps,
+// Sprint, and Exists/Get/MapKeys on the probe paths.
+func compareState(c *collector, ht *hegel.T, what string, ko *koanf.Koanf, m *model) bool {
+	ok := true
+	if got, want := ko.Keys(), m.keys(); !reflect.DeepEqual(got, want) {
+		c.failClass(ht, "keys", "%s: Keys() = %v, model %v", what, got, want)
+		ok = false
+	}
+	if got, want := map[string][]string(ko.KeyMap()), m.keyMap(); !reflect.DeepEqual(got, want) {
+		c.failClass(ht, "keymap", "%s: KeyMap() = %v, model %v", what, got, want)
+		ok = false
+	}
+	if got, want := ko.Raw(), m.tree(); !reflect.DeepEqual(got, want) {
+		c.failClass(ht, "raw", "%s: Raw() = %#v, model %#v", what, got, want)
+		ok = false
+	}
+	if got, want := ko.All(), m.all(); !reflect.DeepEqual(got, want) {
+		c.failClass(ht, "all", "%s: All() = %#v, model %#v", what, got, want)
+		ok = false
+	}
+	if got, want := ko.Sprint(), m.sprint(); got != want {
+		c.failClass(ht, "sprint", "%s: Sprint() = %q, model %q", what, got, want)
+		ok = false
+	}
+	if ko.Delim() != m.delim {
+		c.failClass(ht, "delim", "%s: Delim() = %q, want %q", what, ko.Delim(), m.delim)
+		ok = false
+	}
+	for _, p := range probePaths(m) {
+		if got, want := ko.Exists(p), m.exists(p); got != want {
+			c.failClass(ht, "exists", "%s: Exists(%q) = %v, model %v", what, p, got, want)
+			ok = false
+		}
+		if got, want := ko.Get(p), m.get(p); !reflect.DeepEqual(got, want) {
+			c.failClass(ht, "get", "%s: Get(%q) = %#v, model %#v", what, p, got, want)
+			ok = false
+		}
+		if got, want := ko.MapKeys(p), m.mapKeys(p); !reflect.DeepEqual(got, want) {
+			c.failClass(ht, "mapkeys", "%s: MapKeys(%q) = %v, model %v", what, p, got, want)
+			ok = false
+		}
+	}
+	return ok
+}
+
+// afterMerge reconciles a merging operation's error with the model's. Returns the instance to
+// go on with (rebuilt from the model after a failed strict merge while Known.strictLoadPartial).
+func afterMerge(c *collector, ht *hegel.T, what string, ko *koanf.Koanf, m *model, before map[string]any, err, merr error, strict bool) *koanf.Koanf {
+	if (err != nil) != (merr != nil) {
+		c.failClass(ht, "strict", "%s: err=%v, model err=%v (before %v)", what, err, merr, before)
+		return ko
+	}
+	if err == nil {
+		return ko
+	}
+	c.count("strict error")
+	if !reflect.DeepEqual(ko.Raw(), before) {
+		if Known.strictLoadPartial {
+			c.count("strict partial (known)")
+		} else {
+			c.failClass(ht, "strict partial", "%s: failed with %v but changed the map: %v -> %v", what, err, before, ko.Raw())
+		}
+	}
+	if Known.strictLoadPartial {
+		return fresh(m, strict)
+	}
+	return ko
+}
+
+// TestHegelOperationsFollowTheModel: a random sequence of Load (plain, strict, with a custom
+// merge function), Set, Merge, MergeAt, Delete, Cut, Copy and Slices, each followed by a full
+// comparison with the model.
+func TestHegelOperationsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		delim := pick(ht, delims)
+		strict := chance(ht, 30)
+		ko := koanf.NewWithConf(koanf.Conf{Delim: delim, StrictMerge: strict})
+		m := newModel(delim)
+		if strict {
+			c.count("strict instance")
+		}
+		n := drawInt(ht, 1, 8)
+		for i := 0; i < n; i++ {
+			before := ko.Raw()
+			var what string
+			switch op := drawInt(ht, 0, 11); op {
+			case 0, 1, 2, 3:
+				tree := genTree(ht, 0)
+				keep := chance(ht, 15)
+				var opts []koanf.Option
+				if keep {
+					opts = append(opts, koanf.WithMergeFunc(keepExisting))
+					c.count("custom merge")
+				}
+				what = fmt.Sprintf("Load(%#v, keep=%v)", tree, keep)
+				err := ko.Load(mapProvider(deepCopy(tree).(map[string]any)), nil, opts...)
+				merr := m.merge(tree, nil, strict && !keep, keep)
+				ko = afterMerge(c, ht, what, ko, m, before, err, merr, strict)
+				c.count("load")
+			case 4, 5:
+				key := genPath(ht, m, false)
+				var val any
+				if chance(ht, 30) {
+					val = genTree(ht, 1)
+				} else {
+					val = genValue(ht, 1)
+				}
+				what = fmt.Sprintf("Set(%q, %#v)", key, val)
+				err := ko.Set(key, deepCopy(val))
+				merr := m.set(key, val, strict)
+				ko = afterMerge(c, ht, what, ko, m, before, err, merr, strict)
+				c.count("set")
+			case 6:
+				tree := genTree(ht, 0)
+				other := koanf.New(pick(ht, delims))
+				_ = other.Load(mapProvider(deepCopy(tree).(map[string]any)), nil)
+				what = fmt.Sprintf("Merge(%#v)", tree)
+				err := ko.Merge(other)
+				merr := m.merge(tree, nil, strict, false)
+				ko = afterMerge(c, ht, what, ko, m, before, err, merr, strict)
+				c.count("merge")
+			case 7:
+				tree := genTree(ht, 0)
+				path := genPath(ht, m, true)
+				other := koanf.New(pick(ht, delims))
+				_ = other.Load(mapProvider(deepCopy(tree).(map[string]any)), nil)
+				what = fmt.Sprintf("MergeAt(%#v, %q)", tree, path)
+				err := ko.MergeAt(other, path)
+				var prefix []string
+				if path != "" {
+					prefix = m.split(path)
+				}
+				merr := m.merge(tree, prefix, strict, false)
+				ko = afterMerge(c, ht, what, ko, m, before, err, merr, strict)
+				c.count("mergeat")
+			case 8:
+				path := genPath(ht, m, true)
+				what = fmt.Sprintf("Delete(%q)", path)
+				ko.Delete(path)
+				m.del(path)
+				c.count("delete")
+			case 9:
+				path := genPath(ht, m, true)
+				what = fmt.Sprintf("Cut(%q)", path)
+				cut := ko.Cut(path)
+				mc := m.cut(path)
+				if !compareState(c, ht, what, cut, mc) {
+					return
+				}
+				// the cut is independent of the original
+				_ = cut.Set(genKey(ht), 1)
+				if len(mc.leaves) > 0 {
+					c.count("cut non-empty")
+				}
+			case 10:
+				what = "Copy()"
+				cp := ko.Copy()
+				if !compareState(c, ht, what, cp, m) {
+					return
+				}
+				_ = cp.Set(genKey(ht), 1)
+				cp.Delete("")
+			case 11:
+				path := genPath(ht, m, true)
+				if chance(ht, 70) {
+					// prefer a key holding a slice
+					var sliceKeys []string
+					for k, l := range m.leaves {
+						if _, ok := l.val.([]any); ok {
+							sliceKeys = append(sliceKeys, k)
+						}
+					}
+					if len(sliceKeys) > 0 {
+						sort.Strings(sliceKeys)
+						path = pick(ht, sliceKeys)
+					}
+				}
+				what = fmt.Sprintf("Slices(%q)", path)
+				got := ko.Slices(path)
+				want := m.slices(path)
+				if len(got) != len(want) {
+					c.failClass(ht, "slices", "%s: %d instances, model %d", what, len(got), len(want))
+					return
+				}
+				for j := range got {
+					if !compareState(c, ht, fmt.Sprintf("%s[%d]", what, j), got[j], want[j]) {
+						return
+					}
+				}
+				if len(want) > 0 {
+					c.count("slices non-empty")
+				}
+			}
+			if !compareState(c, ht, what, ko, m) {
+				return
+			}
+		}
+		if len(m.leaves) > 0 {
+			c.count("final non-empty")
+		}
+		if chance(ht, 30) {
+			// Unmarshal of a map path into a map reproduces the sub map
+			path := genPath(ht, m, true)
+			var out map[string]any
+			err := ko.Unmarshal(path, &out)
+			want, isMap := m.get(path).(map[string]any)
+			if isMap {
+				if err != nil {
+					c.failClass(ht, "unmarshal", "Unmarshal(%q): %v", path, err)
+				} else if !reflect.DeepEqual(out, want) {
+					c.failClass(ht, "unmarshal", "Unmarshal(%q) = %#v, model %#v", path, out, want)
+				} else {
+					c.count("unmarshal map")
+				}
+			}
+		}
+	})
+}
+
+// TestHegelGettersConvert: every getter on a leaf value, a sub map, a missing key and the root,
+// against the documented conversions.
+func TestHegelGettersConvert(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 0)
+		if chance(ht, 20) {
+			v = genTree(ht, 1)
+		}
+		tree := map[string]any{"v": v, "n": map[string]any{"v": genValue(ht, 1), "w": genScalar(ht)}}
+		if chance(ht, 30) {
+			tree["m"] = genTree(ht, 1)
+		}
+		m := newModel(".")
+		_ = m.merge(tree, nil, false, false)
+		ko := fresh(m, false)
+		layout := pick(ht, []string{"2006-01-02", time.RFC3339, "15:04"})
+		for _, p := range []string{"v", "n", "n.v", "n.w", "m", "zz", ""} {
+			g := getters{m.get(p)}
+			check := func(name string, got, want any) {
+				if !reflect.DeepEqual(got, want) {
+					c.failClass(ht, name, "%s(%q) on %#v = %#v, model %#v", name, p, m.get(p), got, want)
+				}
+			}
+			check("Int64", ko.Int64(p), g.Int64())
+			check("Int", ko.Int(p), int(g.Int64()))
+			check("Float64", ko.Float64(p), g.Float64())
+			check("Bool", ko.Bool(p), g.Bool())
+			check("String", ko.String(p), g.String())
+			check("Bytes", string(ko.Bytes(p)), g.String())
+			check("Duration", ko.Duration(p), g.Duration())
+			if got, want := ko.Time(p, layout), g.Time(layout); !got.Equal(want) {
+				c.failClass(ht, "Time", "Time(%q, %q) on %#v = %v, model %v", p, layout, m.get(p), got, want)
+			}
+			check("Int64s", ko.Int64s(p), g.Int64s())
+			check("Ints", ko.Ints(p), g.Ints())
+			check("Float64s", ko.Float64s(p), g.Float64s())
+			check("Strings", ko.Strings(p), g.Strings())
+			if got, want := ko.Bools(p), g.Bools(); !(len(got) == 0 && len(want) == 0) && !reflect.DeepEqual(got, want) {
+				c.failClass(ht, "Bools", "Bools(%q) on %#v = %#v, model %#v", p, m.get(p), got, want)
+			}
+			check("Int64Map", ko.Int64Map(p), g.Int64Map())
+			im := map[string]int{}
+			for k, x := range g.Int64Map() {
+				im[k] = int(x)
+			}
+			check("IntMap", ko.IntMap(p), im)
+			check("Float64Map", ko.Float64Map(p), g.Float64Map())
+			check("BoolMap", ko.BoolMap(p), g.BoolMap())
+			check("StringMap", ko.StringMap(p), g.StringMap())
+			sm := ko.StringsMap(p)
+			for k, ss := range sm {
+				if len(ss) == 0 {
+					delete(sm, k)
+				}
+			}
+			check("StringsMap", sm, g.StringsMap())
+			// the Must variants panic exactly on the zero value
+			checkPanics(c, ht, p, "MustInt64", func() { ko.MustInt64(p) }, g.Int64() == 0)
+			checkPanics(c, ht, p, "MustFloat64", func() { ko.MustFloat64(p) }, g.Float64() == 0)
+			checkPanics(c, ht, p, "MustString", func() { ko.MustString(p) }, g.String() == "")
+			checkPanics(c, ht, p, "MustStrings", func() { ko.MustStrings(p) }, len(g.Strings()) == 0)
+			checkPanics(c, ht, p, "MustInt64s", func() { ko.MustInt64s(p) }, len(g.Int64s()) == 0)
+			checkPanics(c, ht, p, "MustDuration", func() { ko.MustDuration(p) }, g.Duration() == 0)
+			checkPanics(c, ht, p, "MustTime", func() { ko.MustTime(p, layout) }, g.Time(layout).IsZero())
+			checkPanics(c, ht, p, "MustStringMap", func() { ko.MustStringMap(p) }, len(g.StringMap()) == 0)
+			checkPanics(c, ht, p, "MustBoolMap", func() { ko.MustBoolMap(p) }, len(g.BoolMap()) == 0)
+			if p == "v" {
+				c.count(fmt.Sprintf("type %T", m.get(p)))
+			}
+		}
+	})
+}
+
+func checkPanics(c *collector, ht *hegel.T, p, name string, f func(), want bool) {
+	got := false
+	func() {
+		defer func() {
+			if recover() != nil {
+				got = true
+			}
+		}()
+		f()
+	}()
+	if got != want {
+		c.failClass(ht, name, "%s(%q) panics=%v, model %v", name, p, got, want)
+	}
+}
+
+// TestHegelValuesAreCopied: the configuration shares nothing with the caller: Get and the
+// getters return copies, Copy and Cut are independent instances, and the provider's map is
+// not written to by later operations (Known.loadAliasesProvider).
+func TestHegelValuesAreCopied(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		delim := pick(ht, delims)
+		ko := koanf.New(delim)
+		m := newModel(delim)
+		orig := genTree(ht, 0)
+		snapshot := deepCopy(orig)
+		if err := ko.Load(mapProvider(orig), nil); err != nil {
+			c.fail(ht, "Load: %v", err)
+			return
+		}
+		_ = m.merge(orig, nil, false, false)
+
+		// Get returns copies: writing into a returned slice or map changes nothing
+		for _, k := range m.keys() {
+			switch g := ko.Get(k).(type) {
+			case []any:
+				if len(g) > 0 {
+					g[0] = "changed"
+				}
+			case map[string]any:
+				g["changed"] = 1
+			case []string:
+				if len(g) > 0 {
+					g[0] = "changed"
+				}
+			case map[string]string:
+				g["changed"] = "1"
+			}
+			if s := ko.Strings(k); len(s) > 0 {
+				s[0] = "changed"
+			}
+			if s := ko.Int64s(k); len(s) > 0 {
+				s[0] = 77
+			}
+			if mp := ko.StringMap(k); len(mp) > 0 {
+				mp["changed"] = "1"
+			}
+		}
+		if raw := ko.Raw(); len(raw) > 0 {
+			for k := range raw {
+				delete(raw, k)
+			}
+		}
+		if !compareState(c, ht, "after writing into Get results", ko, m) {
+			return
+		}
+
+		// Copy and Cut are independent
+		cp := ko.Copy()
+		mcp := m.clone()
+		var cutPath string
+		if len(m.leaves) > 0 {
+			cutPath = pick(ht, m.keys())
+		}
+		cut := ko.Cut(cutPath)
+		mcut := m.cut(cutPath)
+		if len(mcut.leaves) > 0 {
+			c.count("cut non-empty")
+		}
+		k1, v1 := genKey(ht), genValue(ht, 1)
+		k2, v2 := genKey(ht), genValue(ht, 1)
+		_ = cp.Set(k1, deepCopy(v1))
+		_ = mcp.set(k1, v1, false)
+		_ = cut.Set(k2, deepCopy(v2))
+		_ = mcut.set(k2, v2, false)
+		dp := genPath(ht, mcp, false)
+		cp.Delete(dp)
+		mcp.del(dp)
+		if !compareState(c, ht, "original after writing to Copy and Cut", ko, m) {
+			return
+		}
+		tree2 := genTree(ht, 0)
+		err := ko.Load(mapProvider(deepCopy(tree2).(map[string]any)), nil)
+		_ = m.merge(tree2, nil, false, false)
+		if err != nil {
+			c.fail(ht, "second Load: %v", err)
+			return
+		}
+		if !compareState(c, ht, "Copy after writing to the original", cp, mcp) {
+			return
+		}
+		if !compareState(c, ht, "Cut after writing to the original", cut, mcut) {
+			return
+		}
+
+		// the first provider's map after the second Load
+		if !reflect.DeepEqual(orig, snapshot) {
+			if Known.loadAliasesProvider {
+				c.count("provider map written (known)")
+			} else {
+				c.failClass(ht, "provider", "the provider's map changed after a second Load: %#v -> %#v", snapshot, orig)
+			}
+		} else {
+			c.count("provider map intact")
+		}
+	})
+}
