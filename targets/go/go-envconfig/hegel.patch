+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on (or the generator avoids the shape); the pins assert the documented behaviour and fail
+// while the bug exists.
+var Known = struct {
+	// an unset url.URL (or *url.URL without noinit) field is walked as a nested struct and its
+	// User pointer is materialized: the URL is no longer zero and prints as "//@"
+	urlUserMaterialized bool
+	// decoders of non-struct types (Decoder, TextUnmarshaler...) run on an unset variable
+	// without decodeunset, with the empty string
+	decodersRunOnUnset bool
+	// overwrite does not apply an empty value: the existing value stays
+	overwriteEmptyKeeps bool
+	// DefaultRequired makes every field with a default an ErrRequiredAndDefault error
+	defaultRequiredRejectsDefaults bool
+	// mutators are not applied to struct-typed fields decoded by a decoder (time.Time,
+	// url.URL...)
+	mutatorsSkipStructs bool
+	// struct-typed decoder fields are decoded regardless of an existing non-zero value and of
+	// overwrite
+	structDecoderIgnoresOverwrite bool
+	// LegacyMutatorFunc stops the mutator chain after itself
+	legacyMutatorStops bool
+	// the README's "C:\\Personal\\\\$name" example expands $name; documentation, pin only
+	readmeBackslashExample bool
+	// a decoder error on a struct-typed field is not prefixed with the field name
+	structDecoderErrorUnprefixed bool
+	// a struct without a decoder as a slice or map element, and func/chan fields, decode
+	// silently to zero values; pin only
+	unsupportedKindsSilent bool
+	// DefaultDecodeUnset is not inherited by nested structs (the other defaults are)
+	decodeUnsetNotInherited bool
+}{
+	urlUserMaterialized:            true,
+	decodersRunOnUnset:             true,
+	overwriteEmptyKeeps:            true,
+	defaultRequiredRejectsDefaults: true,
+	mutatorsSkipStructs:            true,
+	structDecoderIgnoresOverwrite:  true,
+	legacyMutatorStops:             true,
+	readmeBackslashExample:         true,
+	structDecoderErrorUnprefixed:   true,
+	unsupportedKindsSilent:         true,
+	decodeUnsetNotInherited:        true,
+}
