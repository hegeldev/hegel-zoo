+// ProcessFollowsTheDocs: ProcessWith on a copy of the initial struct ends with the model's
+// field values and the model's error (kind and field path).
+func TestHegelProcessFollowsTheDocs(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		o := genOpts(tc)
+		e := genEnv(tc, o)
+		initial := genInitial(tc)
+
+		want := clone(initial)
+		merr := modelProcess(want, e, o)
+
+		got := clone(initial)
+		err := envconfig.ProcessWith(context.Background(), realConfig(got, e, o))
+
+		switch {
+		case merr == nil && err != nil:
+			c.failClass(ht, "unexpected error", "error %v, the model has none\n%s", err, describe(e, o, initial))
+			return
+		case merr != nil && err == nil:
+			c.failClass(ht, "missing error", "no error, the model has %v\n%s", *merr, describe(e, o, initial))
+			return
+		case merr != nil:
+			if k := classify(err); k != merr.kind {
+				c.failClass(ht, "error kind", "error %v is %s, the model has %v\n%s", err, k, *merr, describe(e, o, initial))
+				return
+			}
+			if p := strings.Join(merr.path, ": "); p != "" && !strings.HasPrefix(err.Error(), p+": ") {
+				c.failClass(ht, "error path", "error %v, the model has it at %s\n%s", err, p, describe(e, o, initial))
+				return
+			}
+			c.count("agreed: error " + merr.kind + " at " + strings.Join(merr.path, "."))
+		default:
+			c.count("agreed")
+		}
+		if d := diffCfg(got, want); len(d) > 0 {
+			c.failClass(ht, "fields "+strings.Join(d, ","), "fields %v differ:\n got  %+v\n want %+v\n%s", d, *got, *want, describe(e, o, initial))
+		}
+	})
+}
