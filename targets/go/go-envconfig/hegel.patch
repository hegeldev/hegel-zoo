+// LookupersCompose: a tree of Map, Prefix and Multi lookupers resolves a key as the godoc says:
+// a prefix is prepended before the wrapped lookup, a multi lookuper takes the first hit.
+type lookTree struct {
+	kind   string // map, prefix, multi
+	m      map[string]string
+	prefix string
+	kids   []*lookTree
+}
+
+var lookKeys = []string{"A", "B", "P_A", "P_B", "Q_P_A", "P_Q_A", "X"}
+
+func genTree(tc hegel.TestCase, depth int) *lookTree {
+	if depth == 0 || chance(tc, 40) {
+		m := map[string]string{}
+		for _, k := range lookKeys {
+			if chance(tc, 40) {
+				m[k] = k + "=" + fmt.Sprint(n(tc, 0, 9))
+			}
+		}
+		return &lookTree{kind: "map", m: m}
+	}
+	if chance(tc, 50) {
+		return &lookTree{kind: "prefix", prefix: pick(tc, []string{"P_", "Q_", ""}), kids: []*lookTree{genTree(tc, depth-1)}}
+	}
+	k := n(tc, 0, 3)
+	t := &lookTree{kind: "multi"}
+	for i := 0; i < k; i++ {
+		t.kids = append(t.kids, genTree(tc, depth-1))
+	}
+	return t
+}
+
+func (t *lookTree) build() envconfig.Lookuper {
+	switch t.kind {
+	case "map":
+		return envconfig.MapLookuper(t.m)
+	case "prefix":
+		return envconfig.PrefixLookuper(t.prefix, t.kids[0].build())
+	}
+	var ls []envconfig.Lookuper
+	for _, k := range t.kids {
+		ls = append(ls, k.build())
+	}
+	return envconfig.MultiLookuper(ls...)
+}
+
+func (t *lookTree) lookup(key string) (string, bool) {
+	switch t.kind {
+	case "map":
+		v, ok := t.m[key]
+		return v, ok
+	case "prefix":
+		return t.kids[0].lookup(t.prefix + key)
+	}
+	for _, k := range t.kids {
+		if v, ok := k.lookup(key); ok {
+			return v, true
+		}
+	}
+	return "", false
+}
+
+func TestHegelLookupersCompose(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		tree := genTree(tc, 3)
+		l := tree.build()
+		for _, k := range lookKeys {
+			wv, wok := tree.lookup(k)
+			gv, gok := l.Lookup(k)
+			if wv != gv || wok != gok {
+				c.fail(ht, "Lookup(%q) = %q, %v; the tree says %q, %v", k, gv, gok, wv, wok)
+				return
+			}
+		}
+		c.count("agreed")
+	})
+}
