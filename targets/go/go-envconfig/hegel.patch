diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..97ff042
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,226 @@
+package envconfig_test
+
+// One plain test per recorded bug (bugs.toml): each asserts the documented behaviour and fails
+// while the bug exists; target.toml lists them as expected failures.
+
+import (
+	"context"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/sethvargo/go-envconfig"
+)
+
+func process(target any, m map[string]string, c envconfig.Config) error {
+	c.Target = target
+	c.Lookuper = envconfig.MapLookuper(m)
+	return envconfig.ProcessWith(context.Background(), &c)
+}
+
+// go-envconfig/1: an unset url.URL field is walked as a nested struct and its User pointer is
+// initialized: the URL is no longer the zero value and prints as "//@".
+func TestHegelPinUnsetURLStaysZero(t *testing.T) {
+	var c struct {
+		U  url.URL  `env:"U"`
+		PU *url.URL `env:"PU"`
+	}
+	if err := process(&c, nil, envconfig.Config{}); err != nil {
+		t.Fatal(err)
+	}
+	if c.U != (url.URL{}) || c.U.String() != "" {
+		t.Errorf("unset url.URL = %+v, String() = %q; want the zero URL", c.U, c.U.String())
+	}
+	if c.PU != nil && (*c.PU != (url.URL{}) || c.PU.String() != "") {
+		t.Errorf("unset *url.URL = %+v, String() = %q; want a zero URL", *c.PU, c.PU.String())
+	}
+}
+
+// go-envconfig/2: decoders of non-struct types run on an unset variable without decodeunset
+// ("The default behavior is to skip running decoders on unset environment variable values").
+func TestHegelPinDecodersSkipUnset(t *testing.T) {
+	var c struct {
+		D dec                   `env:"D"`
+		B envconfig.Base64Bytes `env:"B"`
+	}
+	if err := process(&c, nil, envconfig.Config{}); err != nil {
+		t.Fatal(err)
+	}
+	if c.D != "" {
+		t.Errorf("D = %q after an unset variable without decodeunset; the decoder ran", c.D)
+	}
+	if c.B != nil {
+		t.Errorf("B = %#v after an unset variable without decodeunset; the decoder ran", c.B)
+	}
+}
+
+// go-envconfig/3: overwrite does not apply an empty value; the README calls an empty variable a
+// value and says the existing value is overwritten when the variable is specified.
+func TestHegelPinOverwriteAppliesEmpty(t *testing.T) {
+	c := struct {
+		S string `env:"S,overwrite"`
+	}{"existing"}
+	if err := process(&c, map[string]string{"S": ""}, envconfig.Config{}); err != nil {
+		t.Fatal(err)
+	}
+	if c.S != "" {
+		t.Errorf("S = %q after S=\"\" with overwrite; want the empty value", c.S)
+	}
+}
+
+// go-envconfig/4: DefaultRequired turns every field with a default into an
+// ErrRequiredAndDefault error.
+func TestHegelPinDefaultRequiredAllowsDefaults(t *testing.T) {
+	var c struct {
+		Port int `env:"PORT,default=8080"`
+	}
+	err := process(&c, nil, envconfig.Config{DefaultRequired: true})
+	if err != nil || c.Port != 8080 {
+		t.Errorf("DefaultRequired with a defaulted field: %v, Port = %d; want 8080 without error", err, c.Port)
+	}
+}
+
+// go-envconfig/5: mutators are not applied to struct-typed fields decoded by a decoder
+// (time.Time, url.URL).
+func TestHegelPinMutatorsApplyToStructFields(t *testing.T) {
+	var c struct {
+		U url.URL `env:"U"`
+		S string  `env:"S"`
+	}
+	var seen []string
+	mu := envconfig.MutatorFunc(func(ctx context.Context, ok, rk, ov, cv string) (string, bool, error) {
+		seen = append(seen, rk)
+		return strings.ReplaceAll(cv, "secret", "host"), false, nil
+	})
+	err := process(&c, map[string]string{"U": "http://secret/p", "S": "secret"}, envconfig.Config{Mutators: []envconfig.Mutator{mu}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(seen) != 2 || c.U.Host != "host" {
+		t.Errorf("mutator saw %v, U.Host = %q; want it called for U too and Host = host", seen, c.U.Host)
+	}
+}
+
+// go-envconfig/6: a struct-typed field with a decoder is decoded although it has a non-zero
+// value and overwrite is off; every other field keeps its value.
+func TestHegelPinStructDecoderRespectsOverwrite(t *testing.T) {
+	c := struct {
+		T time.Time `env:"T"`
+		D dec       `env:"D"`
+	}{T: time.Date(2000, 1, 1, 0, 0, 0, 0, time.UTC), D: "existing"}
+	err := process(&c, map[string]string{"T": "2020-01-02T03:04:05Z", "D": "v"}, envconfig.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.D != "existing" {
+		t.Errorf("D = %q; the existing value should stay without overwrite", c.D)
+	}
+	if c.T.Year() != 2000 {
+		t.Errorf("T = %v; the existing value should stay without overwrite, as D's does", c.T)
+	}
+}
+
+// go-envconfig/7: LegacyMutatorFunc stops the mutator chain after itself.
+func TestHegelPinLegacyMutatorContinuesTheChain(t *testing.T) {
+	var c struct {
+		S string `env:"S"`
+	}
+	m1 := envconfig.LegacyMutatorFunc(func(ctx context.Context, k, v string) (string, error) { return v + "1", nil })
+	m2 := envconfig.MutatorFunc(func(ctx context.Context, ok, rk, ov, cv string) (string, bool, error) { return cv + "2", false, nil })
+	if err := process(&c, map[string]string{"S": "s"}, envconfig.Config{Mutators: []envconfig.Mutator{m1, m2}}); err != nil {
+		t.Fatal(err)
+	}
+	if c.S != "s12" {
+		t.Errorf("S = %q with a legacy mutator before another; want s12", c.S)
+	}
+}
+
+// go-envconfig/8: the README says `default=C:\\Personal\\\\$name` gives C:\Personal\$name; the
+// $name is expanded (to the empty string when unset).
+func TestHegelPinReadmeBackslashExample(t *testing.T) {
+	var c struct {
+		Filepath string `env:"FILEPATH, default=C:\\Personal\\\\$name"`
+	}
+	if err := process(&c, nil, envconfig.Config{}); err != nil {
+		t.Fatal(err)
+	}
+	if c.Filepath != `C:\Personal\$name` {
+		t.Errorf("Filepath = %q; the README says C:\\Personal\\$name", c.Filepath)
+	}
+}
+
+// go-envconfig/9: a decoder error on a struct-typed field is not prefixed with the field name,
+// unlike every other error.
+func TestHegelPinStructDecoderErrorNamesTheField(t *testing.T) {
+	var c struct {
+		When time.Time `env:"WHEN"`
+	}
+	err := process(&c, map[string]string{"WHEN": "nope"}, envconfig.Config{})
+	if err == nil {
+		t.Fatal("no error for WHEN=nope")
+	}
+	if !strings.HasPrefix(err.Error(), "When: ") {
+		t.Errorf("error %q does not name the field; other errors read \"When: ...\"", err)
+	}
+}
+
+// go-envconfig/10: a struct without a decoder as a slice or map element, and func and chan
+// fields, decode silently to zero values instead of an error.
+func TestHegelPinUnsupportedKindsAreErrors(t *testing.T) {
+	type sub struct {
+		X int `env:"X"`
+	}
+	var a struct {
+		L []sub `env:"L"`
+	}
+	if err := process(&a, map[string]string{"L": "a,b"}, envconfig.Config{}); err == nil {
+		t.Errorf("[]struct without a decoder from L=a,b: no error, L = %v", a.L)
+	}
+	var b struct {
+		F func() `env:"F"`
+	}
+	if err := process(&b, map[string]string{"F": "x"}, envconfig.Config{}); err == nil {
+		t.Errorf("func field from F=x: no error (the godoc excludes Func and Chan)")
+	}
+}
+
+// go-envconfig/11: DefaultDecodeUnset is not inherited by nested structs, while the other
+// defaults (delimiter, separator, noinit, overwrite, required) are: an unset time.Time is a
+// decoding error at the top level and nothing one level down.
+func TestHegelPinDecodeUnsetIsInherited(t *testing.T) {
+	var top struct {
+		T time.Time `env:"T"`
+	}
+	if err := process(&top, nil, envconfig.Config{DefaultDecodeUnset: true}); err == nil {
+		t.Fatal("top level: no error decoding an unset time.Time under DefaultDecodeUnset")
+	}
+	var nested struct {
+		Sub struct {
+			T time.Time `env:"T"`
+		} `env:",prefix=S_"`
+	}
+	if err := process(&nested, nil, envconfig.Config{DefaultDecodeUnset: true}); err == nil {
+		t.Errorf("nested: no error decoding an unset time.Time under DefaultDecodeUnset; the top level reports one")
+	}
+}
+
+// go-envconfig/12: the Mutator doc says mutators are called on defined values "or when
+// decodeunset is true"; under decodeunset an unset variable's field is decoded with "" and
+// no mutator is called.
+func TestHegelPinMutatorsRunUnderDecodeUnset(t *testing.T) {
+	var c struct {
+		S string `env:"S,decodeunset"`
+	}
+	var seen []string
+	mu := envconfig.MutatorFunc(func(ctx context.Context, ok, rk, ov, cv string) (string, bool, error) {
+		seen = append(seen, rk)
+		return "filled", false, nil
+	})
+	if err := process(&c, nil, envconfig.Config{Mutators: []envconfig.Mutator{mu}}); err != nil {
+		t.Fatal(err)
+	}
+	if len(seen) != 1 || seen[0] != "S" {
+		t.Errorf("mutator called for %v under decodeunset with S unset; the Mutator doc says it is called", seen)
+	}
+}
diff --git a/hegel_zoo_cases_test.go b/hegel_zoo_cases_test.go
new file mode 100644
index 0000000..ff8cc0c
--- /dev/null
+++ b/hegel_zoo_cases_test.go
@@ -0,0 +1,860 @@
+package envconfig_test
+
+// The case records of the Process property and their generators: the Config choices
+// (procOpts), the lookup map as an ordered list of entries (envEntry, built into the map by
+// envMap), the initial struct as the record of the pre-set choices (initialSpec, built into a
+// fresh *Cfg by buildInitial on each side), and the narrow properties' splices. The
+// population is the one the old gen* functions drew (the same pools byte for byte, the same
+// chances and counts) with the additions the standard needs: the url pool gains the four
+// mutator-triggering values "~http://a/b", "stop", "muterr" and "Lx" and the time pool
+// "~2020-01-02T03:04:05Z" and "stop" (the shape of go-envconfig/5 was invisible before: no
+// url or time value started with "~" or "L" or was "stop" or "muterr"), the SUBS and SUBM
+// keys for the two fields the struct gained (go-envconfig/10), and the fill mutator
+// (go-envconfig/12). Every weight is nominal, drawn through the fair-bit dice of the idioms
+// (hzChance, dieChoice, evenHalves, rangeHalves), and the figure beside it is the realised
+// rate the probe measured over 3000 cases in context, in percent, at HEGEL_SEED=7 and 8 (a
+// share moves by up to five points between seeds at the same weight, the floor). The
+// simplest alternative comes first in every choice, so the shrink target is the empty lookup
+// map, the zero Config and the zero initial struct.
+
+import (
+	"fmt"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/sethvargo/go-envconfig"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the pools
+
+type pools struct{ ok, bad, trig []string }
+
+// valuePools are the per-kind values, byte for byte the old ones; trig are the additions
+// the mutators act on (url: valid URLs - "~http://a/b" is a parse error unmutated, "first
+// path segment in URL cannot contain colon", and "http://a/b!" under the tilde mutator;
+// time: invalid times, mutated or not, so that their shape is go-envconfig/9's unprefixed
+// error, named before 5 would be).
+var valuePools = map[string]pools{
+	"str":   {ok: []string{"a", "hello", "~abc", "stop", "x y", "$STR", "L", "pre", "0"}, bad: []string{"muterr"}},
+	"dec":   {ok: []string{"a", "~abc", "stop", "v"}, bad: []string{"bad", "muterr"}},
+	"int":   {ok: []string{"0", "1", "-7", "42", "0x10", "010", "1_000", "2147483648"}, bad: []string{"abc", "3.5", "~5", "9223372036854775808", "muterr"}},
+	"int8":  {ok: []string{"127", "-128", "5", "0"}, bad: []string{"128", "-129", "x"}},
+	"u16":   {ok: []string{"0", "65535", "7", "0xff"}, bad: []string{"65536", "-1", "x"}},
+	"float": {ok: []string{"1.5", "-0", "1e3", "NaN", "inf", "0"}, bad: []string{"x", "1,5"}},
+	"bool":  {ok: []string{"true", "false", "1", "0", "T", "F"}, bad: []string{"yes", "x"}},
+	"dur":   {ok: []string{"10m", "1h30m", "-5s", "0", "1.5h"}, bad: []string{"1", "abc"}},
+	"time":  {ok: []string{"2020-01-02T03:04:05Z", "2021-06-07T08:09:10+02:00", "1999-12-31T23:59:59.5Z"}, bad: []string{"nope", "2020-01-02"}, trig: []string{"~2020-01-02T03:04:05Z", "stop"}},
+	"url":   {ok: []string{"http://a/b", "https://u:p@h:8/p?q=1#f", "//x", "mailto:a@b", "relative/path", "http://h/~a"}, bad: []string{"::bad", "http://[::1", "%zz"}, trig: []string{"~http://a/b", "stop", "muterr", "Lx"}},
+	"strs":  {ok: []string{"a,b", "a;b", " a , b ", "a,,b", "one", "a|b", "~a,b"}},
+	"ints":  {ok: []string{"1;2", "1;;2", "0x10;010", "7", " 3 ; 4 "}, bad: []string{"1;x", "1,2"}},
+	"bytes": {ok: []string{"abc", "h\u00e9llo", "a,b"}},
+	"b64":   {ok: []string{"aGVsbG8=", "aGVsbG8", "aGVsbG8-", "YWI+Yw==", "YWI-Yw"}, bad: []string{"!!!", "a"}},
+	"hex":   {ok: []string{"68656c6c6f", "ABCDEF", "00"}, bad: []string{"zz", "abc"}},
+	"map2":  {ok: []string{"1=a|2=b", "1=a,2=b", "1=a|1=b", "1:a", "=a", " 2 = b "}, bad: []string{"x=a", "1"}},
+}
+
+// mapKeys, mapVals, mapDelims and mapSeps are the pieces of a map[string]int value (the old
+// genMap).
+var (
+	mapKeys   = []string{"a", "b", " a ", "k", ""}
+	mapVals   = []string{"1", "2", " 3 ", "0x10", ""}
+	mapDelims = []string{",", ";", "|"}
+	mapSeps   = []string{":", "=", "::"}
+)
+
+type keySpec struct {
+	key, kind string
+	pct       int
+}
+
+// keySpecs are the keys of the lookup map with the kind of their values and their presence
+// (SUBS and SUBM at 35 like the others; "X", "N" and "S" are stray names).
+var keySpecs = []keySpec{
+	{"STR", "str", 50}, {"DEF", "str", 40}, {"REF", "str", 30}, {"ESC", "str", 30},
+	{"I", "int", 45}, {"I8", "int8", 35}, {"U16", "u16", 35}, {"I64", "int", 35},
+	{"F", "float", 35}, {"B", "bool", 35}, {"DUR", "dur", 35},
+	{"T", "time", 40}, {"U", "url", 40}, {"PU", "url", 40},
+	{"PTR", "int", 40}, {"PSTR", "str", 40}, {"NOIN", "str", 40},
+	{"STRS", "strs", 40}, {"INTS", "ints", 40}, {"BYTES", "bytes", 35},
+	{"B64", "b64", 35}, {"HEX", "hex", 35}, {"M", "map", 40}, {"M2", "map2", 40},
+	{"REQ", "str", 92}, {"OVR", "str", 50}, {"OVRDEF", "int", 45},
+	{"DEC", "dec", 45}, {"DECU", "dec", 45},
+	{"IN_N", "int", 40}, {"IN_S", "str", 40}, {"IN_R", "str", 30}, {"IN_D", "dec", 40}, {"IN_T", "time", 35},
+	{"PIN_N", "int", 40}, {"PIN_S", "str", 40}, {"PIN_R", "str", 30}, {"PIN_D", "dec", 40}, {"PIN_T", "time", 35},
+	{"PNO_N", "int", 40}, {"PNO_S", "str", 40}, {"PNO_R", "str", 30}, {"PNO_D", "dec", 40}, {"PNO_T", "time", 35},
+	{"A", "str", 40}, {"SUBS", "strs", 35}, {"SUBM", "map", 35}, {"X", "str", 20}, {"N", "int", 15}, {"S", "str", 15},
+}
+
+// unprefixedNames are the plain names drawn beside a prefixed map, which default expansions
+// refer to.
+var unprefixedNames = []string{"STR", "X", "REQ"}
+
+// --------------------------------------------------------------------------- the records
+
+// procOpts is the Config of a case: the lookuper prefix, the defaults, the mutators in order.
+type procOpts struct {
+	prefix               string
+	delimiter, separator string
+	noInit, overwrite    bool
+	decodeSet, required  bool
+	mutators             []string
+}
+
+// mapSpec is a map[string]int value as drawn: the delimiter and separator (an index into
+// mapDelims/mapSeps for a wrong one now and then, -1 for the Config's) and one to three
+// items, each a key and a value index, bad ("x" for the value) or bare (the key alone,
+// without the separator).
+type mapSpec struct {
+	delim, sep int
+	items      []mapItem
+}
+
+type mapItem struct {
+	key, val  int
+	bad, bare bool
+}
+
+// text renders the value with the Config's delimiter and separator.
+func (m mapSpec) text(o procOpts) string {
+	delim, sep := o.delimiter, o.separator
+	if delim == "" {
+		delim = ","
+	}
+	if sep == "" {
+		sep = ":"
+	}
+	if m.delim >= 0 {
+		delim = mapDelims[m.delim]
+	}
+	if m.sep >= 0 {
+		sep = mapSeps[m.sep]
+	}
+	var items []string
+	for _, it := range m.items {
+		key, val := mapKeys[it.key], mapVals[it.val]
+		if it.bad {
+			val = "x"
+		}
+		if it.bare {
+			items = append(items, key)
+			continue
+		}
+		items = append(items, key+sep+val)
+	}
+	return strings.Join(items, delim)
+}
+
+// envEntry is one entry of the lookup map: the full key (prefix included) and the value, a
+// map value as its spec (rendered against the Config by envMap).
+type envEntry struct {
+	key, value string
+	m          *mapSpec
+}
+
+// The pre-set choices of the initial struct, in struct order (the old genInitial's).
+const (
+	pStr = iota
+	pDef
+	pI
+	pB
+	pT
+	pU
+	pPU
+	pPtr
+	pPStr
+	pNoIn
+	pStrs
+	pInts
+	pBytes
+	pB64
+	pHex
+	pM
+	pM2
+	pReq
+	pOvr
+	pOvrDef
+	pDec
+	pDecU
+	pAnA
+	preCount
+)
+
+var preNames = [preCount]string{"Str", "Def", "I", "B", "T", "U", "PU", "Ptr", "PStr", "NoIn", "Strs", "Ints", "Bytes", "B64", "Hex", "M", "M2", "Req", "Ovr", "OvrDef", "Dec", "DecU", "An.A"}
+
+// innerInit is the pre-set choices of a nested Inner: N (0 for unset, else 1 to 9), S
+// "pre", D "pre", T 2000-01-01.
+type innerInit struct {
+	n       int
+	s, d, t bool
+}
+
+// initialSpec is the initial struct as drawn: zero, or the pre-set choices per field and
+// the three nested records (nil for an unset nested struct).
+type initialSpec struct {
+	zero         bool
+	pre          [preCount]bool
+	in, pin, pno *innerInit
+}
+
+// processCase is one case of the Process property.
+type processCase struct {
+	opts    procOpts
+	env     []envEntry
+	initial initialSpec
+	got     *Cfg // what the library left (processActual records it; the explanation)
+}
+
+// GoString prints the case as the old describe did: the built map, the Config, the built
+// initial struct.
+func (c processCase) GoString() string {
+	return fmt.Sprintf("env %v\nconfig %+v\ninitial %+v", envMap(c), c.opts, *buildInitial(c.initial))
+}
+
+// explain names the fields that differ between what the library left and the documented
+// struct (diffCfg), with both structs.
+func (c processCase) explain(got, want checks) string {
+	if c.got == nil {
+		return ""
+	}
+	model, _ := modelRun(c, hzKnownNone)
+	d := diffCfg(c.got, model)
+	if len(d) == 0 {
+		return ""
+	}
+	return fmt.Sprintf("\nfields %v differ:\n got  %+v\n want %+v", d, *c.got, *model)
+}
+
+// --------------------------------------------------------------------------- the builders
+
+// envMap builds the lookup map from the entries, in order (the keys are distinct by
+// construction).
+func envMap(c processCase) map[string]string {
+	e := map[string]string{}
+	for _, en := range c.env {
+		if en.m != nil {
+			e[en.key] = en.m.text(c.opts)
+			continue
+		}
+		e[en.key] = en.value
+	}
+	return e
+}
+
+// buildInner builds a fresh Inner from its record.
+func buildInner(r *innerInit) *Inner {
+	in := &Inner{N: r.n}
+	if r.s {
+		in.S = "pre"
+	}
+	if r.d {
+		in.D = "pre"
+	}
+	if r.t {
+		in.T = time.Date(2000, 1, 1, 0, 0, 0, 0, time.UTC)
+	}
+	return in
+}
+
+// buildInitial builds a fresh *Cfg from the record: the zero struct, or the pre-set values
+// (the old genInitial's, byte for byte) with NoTag 1 and hidden "h".
+func buildInitial(s initialSpec) *Cfg {
+	c := &Cfg{}
+	if s.zero {
+		return c
+	}
+	pre := s.pre
+	if pre[pStr] {
+		c.Str = "pre"
+	}
+	if pre[pDef] {
+		c.Def = "pre"
+	}
+	if pre[pI] {
+		c.I = 5
+	}
+	if pre[pB] {
+		c.B = true
+	}
+	if pre[pT] {
+		c.T = time.Date(2000, 1, 1, 0, 0, 0, 0, time.UTC)
+	}
+	if pre[pU] {
+		c.U = url.URL{Scheme: "x", Host: "pre"}
+	}
+	if pre[pPU] {
+		c.PU = &url.URL{Host: "pp"}
+	}
+	if pre[pPtr] {
+		v := 5
+		c.Ptr = &v
+	}
+	if pre[pPStr] {
+		v := "ps"
+		c.PStr = &v
+	}
+	if pre[pNoIn] {
+		v := "ni"
+		c.NoIn = &v
+	}
+	if pre[pStrs] {
+		c.Strs = []string{"p"}
+	}
+	if pre[pInts] {
+		c.Ints = []int{9}
+	}
+	if pre[pBytes] {
+		c.Bytes = []byte("pb")
+	}
+	if pre[pB64] {
+		c.B64 = envconfig.Base64Bytes{1}
+	}
+	if pre[pHex] {
+		c.Hex = envconfig.HexBytes{2}
+	}
+	if pre[pM] {
+		c.M = map[string]int{"p": 1}
+	}
+	if pre[pM2] {
+		c.M2 = map[int]string{9: "p"}
+	}
+	if pre[pReq] {
+		c.Req = "pre"
+	}
+	if pre[pOvr] {
+		c.Ovr = "pre"
+	}
+	if pre[pOvrDef] {
+		c.OvrDef = 5
+	}
+	if pre[pDec] {
+		c.Dec = "pre"
+	}
+	if pre[pDecU] {
+		c.DecU = "pre"
+	}
+	if s.in != nil {
+		c.In = *buildInner(s.in)
+	}
+	if s.pin != nil {
+		c.PIn = buildInner(s.pin)
+	}
+	if s.pno != nil {
+		c.PNo = buildInner(s.pno)
+	}
+	if pre[pAnA] {
+		c.An.A = "pa"
+	}
+	c.NoTag = 1
+	c.hidden = "h"
+	return c
+}
+
+// realConfig is the envconfig.Config of a case over the target struct.
+func realConfig(target *Cfg, e map[string]string, o procOpts) *envconfig.Config {
+	var l envconfig.Lookuper = envconfig.MapLookuper(e)
+	if o.prefix != "" {
+		l = envconfig.PrefixLookuper(o.prefix, l)
+	}
+	c := &envconfig.Config{
+		Target:             target,
+		Lookuper:           l,
+		DefaultDelimiter:   o.delimiter,
+		DefaultSeparator:   o.separator,
+		DefaultNoInit:      o.noInit,
+		DefaultOverwrite:   o.overwrite,
+		DefaultDecodeUnset: o.decodeSet,
+		DefaultRequired:    o.required,
+	}
+	for _, m := range o.mutators {
+		c.Mutators = append(c.Mutators, realMutator(m))
+	}
+	return c
+}
+
+// --------------------------------------------------------------------------- the splices
+// (the narrow properties force an ingredient on a drawn case; each returns a fresh record)
+
+// withEntry is the case with the key's value set (the entry replaced, or added at the end);
+// the key is given without the Config's prefix.
+func (c processCase) withEntry(key, value string) processCase {
+	full := c.opts.prefix + key
+	env := make([]envEntry, 0, len(c.env)+1)
+	done := false
+	for _, en := range c.env {
+		if en.key == full {
+			env = append(env, envEntry{key: full, value: value})
+			done = true
+			continue
+		}
+		env = append(env, en)
+	}
+	if !done {
+		env = append(env, envEntry{key: full, value: value})
+	}
+	c.env = env
+	return c
+}
+
+// withValue is withEntry with a drawn value (a map value as its spec).
+func (c processCase) withValue(key string, v envValue) processCase {
+	c = c.withEntry(key, v.text)
+	for i := range c.env {
+		if c.env[i].key == c.opts.prefix+key {
+			c.env[i].m = v.m
+		}
+	}
+	return c
+}
+
+// withPre is the case with the field pre-set in the initial struct.
+func (c processCase) withPre(i int) processCase {
+	c.initial.zero = false
+	c.initial.pre[i] = true
+	return c
+}
+
+// withOpts is the case with the Config changed by f on a copy.
+func (c processCase) withOpts(f func(*procOpts)) processCase {
+	o := c.opts
+	o.mutators = append([]string(nil), c.opts.mutators...)
+	f(&o)
+	c.opts = o
+	return c
+}
+
+// --------------------------------------------------------------------------- the tune
+
+// tune is the population of a property: the wide property's (wideTune) or a narrow
+// property's with its bug's ingredient forced and the other switched shapes' alternatives at
+// weight zero. Every figure is a nominal percent (a weight for the pool shares).
+type tune struct {
+	prefix, delimiter, separator, noInit, overwrite, decodeSet, required int
+	mutators                                                             int            // cases with mutators
+	minCount                                                             int            // the least mutator count when some are drawn (1)
+	fill                                                                 int            // the fill mutator in the pool (1) or not (0)
+	first, last                                                          string         // a mutator forced first or last in the chain ("" none)
+	keys                                                                 map[string]int // per-key presence overrides
+	tDecode                                                              int            // the T key under decodeunset (90)
+	empty                                                                int            // the empty share of the plain kinds (8)
+	emptyBy                                                              map[string]int // per-kind weights of it (where it is not zero)
+	emptyTime                                                            int            // of time (2)
+	emptyURL                                                             int            // of url (2)
+	bad                                                                  int            // the bad share of the kinds with a bad pool (2)
+	badBy                                                                map[string]int // per-kind weights of it (where it is not zero)
+	badTime                                                              int            // of time (2)
+	badURL                                                               int            // of url (2)
+	timeTrig                                                             int            // the share of the two mutator-triggering time values (2)
+	urlTrig                                                              int            // of the four url values (10)
+	subs                                                                 int            // SUBS and SUBM presence (35)
+	zeroInit                                                             int            // the zero initial struct (50)
+	pre                                                                  [preCount]int  // each pre-set field (25)
+	preInner                                                             int            // each nested record (25)
+}
+
+// wideTune is the wide property's population: the old generators' chances, the additions at
+// their shares, and under HEGEL_NO_KNOWN=1 the alternatives that make a switched shape at
+// weight zero: the DefaultRequired coin (go-envconfig/4: every defaulted field reached would
+// be an error), the DefaultDecodeUnset coin (11: an unset nested T; and 9 at an unset T), the
+// SUBS and SUBM keys (10), the url and time values the mutators act on (5), the bad and empty
+// time values and the bad url values (9: an unprefixed decoder error), the fill mutator (12).
+// The shapes of 3, 6 and 7 are relations between the parts (a pre-set field, its value, the
+// overwrite; the mutator order) and are filtered out by the classifier (withoutShapes). The
+// figure after each weight is the one the probe realised at 3000 (HEGEL_SEED=7); where the
+// engine's bias moved a share by more than two points the weight is corrected and the
+// nominal share named.
+var wideTune = tune{
+	prefix:    24,                      // 25 nominal: realised 26.6 and 25.8 (25 realised 25.0, 24.4 and 23.9)
+	delimiter: 24,                      // 25 nominal: 24.4 and 24.2 (25 realised 24.3, 30.3 and 25.8)
+	separator: 24,                      // 25 nominal: 24.2 and 22.2 (25 realised 26.2, 24.1 and 21.5; 26 realised 27.6 and 29.7)
+	noInit:    19,                      // 20 nominal: 21.3 and 17.8 (20 realised 22.0, 22.4 and 17.5)
+	overwrite: 29,                      // 30 nominal: 34.2 and 29.8 (30 realised 29.4, 30.7 and 34.7)
+	decodeSet: hzUnless(hzNoKnown, 15), // 15.7 and 16.4
+	required:  hzUnless(hzNoKnown, 5),  // 5.2 and 5.6 (3.4 in the first run; 7 realised 5.9 and 5.5, 6 realised 7.4 twice)
+	mutators:  40,                      // 39.2 and 39.3 (42.0 in the first run; 37 realised 37.0, 39.7, 34.6 and 35.3)
+	minCount:  1,
+	fill:      hzUnless(hzNoKnown, 1),
+	tDecode:   90, // 91.9 and 88.0 (87 realised 83.7 and 88.1)
+	empty:     8,  // str 8.5 and 7.4, int 7.3 and 7.5, int8 10.4 and 6.2, u16 6.5 and 7.1, float 6.5 and 4.5, bool 8.4 and 5.9, dur 8.0 and 6.0, dec 8.1 and 7.0, strs 6.2 and 8.4, ints 7.8 and 9.5, map 7.1 and 6.5, map2 6.0 and 7.8
+	emptyBy: map[string]int{ // 8 nominal
+		"bytes": 7,            // 9.2 and 7.0 (8 realised 10.2; 6 realised 6.9 and 9.0)
+		"b64":   10, "hex": 9, // b64 6.9 and 12.0, hex 9.1 and 8.9 (8 realised 5.6 and 6.7)
+	},
+	emptyTime: hzUnless(hzNoKnown, 2), // 2.6 and 2.3
+	emptyURL:  2,                      // 1.3 and 2.0
+	bad:       2,                      // str 2.0 and 2.1, int 1.8 and 2.2, int8 2.2 and 2.4, u16 1.0 and 0.9, bool 1.5 and 3.3, dur 0.8 and 1.6, ints 1.9 and 2.4, b64 1.5 and 1.5, hex 1.3 and 2.7, map2 0.6 and 2.0
+	badBy: map[string]int{ // 2 nominal
+		"dec": 3, "float": 3, // dec 2.9 and 3.1, float 4.3 and 6.7 (2 realised 1.4 and 0.9; 3 realised float 1.3 and 2.0 in another run)
+	},
+	badTime:  hzUnless(hzNoKnown, 2),  // 2.5 and 3.2
+	badURL:   hzUnless(hzNoKnown, 2),  // 1.4 and 1.4
+	timeTrig: hzUnless(hzNoKnown, 2),  // 1.9 and 1.7
+	urlTrig:  hzUnless(hzNoKnown, 10), // 12.1 and 9.3
+	subs:     hzUnless(hzNoKnown, 35), // SUBS 35.7 and 32.5, SUBM 36.7 and 34.9
+	zeroInit: 50,                      // 45.1 and 47.1 (50.2, 48.4 and 46.8 in the earlier runs)
+	pre:      preWeights,
+	preInner: 25, // In 26.4 and 24.0, PIn 25.9 and 26.1, PNo 26.6 and 27.2
+}
+
+// preWeights are the weights of the 23 pre-set coins, each 25 nominal, corrected where the
+// share realised at 25 ran off by more than two points on the mean of the probe runs (the
+// first run at 25 throughout realised Str 21.4, Def 19.5, I 22.5, B 27.2, T 22.2, U 26.4,
+// Bytes 27.8, M 26.8, Req 30.8, Ovr 27.8, DecU 27.0; the others 24.3 to 26.4). The final run
+// realised (seeds 7 and 8) Str 26.3 and 24.2, Def 23.8 and 26.7, I 25.2 and 21.6, B 23.7
+// and 24.9, T 21.8 and 24.7, U 25.4 and 24.1, PU 28.5 and 29.9, Ptr 26.0 and 24.5, PStr 24.4
+// and 22.1, NoIn 24.9 and 30.6, Strs 25.8 and 25.1, Ints 26.7 and 27.4, Bytes 26.2 and 28.1,
+// B64 24.9 and 29.7, Hex 24.0 and 27.9, M 19.2 and 24.0, M2 25.8 and 25.8, Req 23.1 and
+// 27.0, Ovr 22.8 and 21.6, OvrDef 24.3 and 22.7, Dec 23.9 and 25.1, DecU 23.1 and 26.0, An.A
+// 23.1 and 23.2. A coin's share moves by up to five points between seeds at the same weight
+// (the engine's draws are not independent across cases), which is the floor of this tuning.
+var preWeights = [preCount]int{
+	pStr: 24, pDef: 26, pI: 24, pB: 25, pT: 24, pU: 23, pPU: 26, pPtr: 25, pPStr: 25, pNoIn: 27,
+	pStrs: 25, pInts: 26, pBytes: 26, pB64: 26, pHex: 26, pM: 24, pM2: 25, pReq: 25, pOvr: 24,
+	pOvrDef: 24, pDec: 25, pDecU: 25, pAnA: 25,
+}
+
+// keyWeights are the weights of the keys whose presence ran off their keySpecs figure by
+// more than two points on the mean of the probe runs at that figure (the first run: PNO_N
+// 44.0 at 40, N 11.8 at 15, M2 35.4 at 40, DECU 47.8 at 45, OVR 47.0 at 50, OVRDEF 45.4 at
+// 45 then 47.6 at 45, B64 32.9 at 35, BYTES 33.4 at 35, PIN_T 33.2 at 35, PNO_T 37.1 at 35, A
+// 41.7 at 40, PSTR 42.1 at 40, PU 41.5 at 40, DUR 31.8 at 35 in a later run). The final run
+// realised (seeds 7 and 8) PNO_N 35.6 and 36.3, N 18.7 and 16.4, M2 42.2 and 40.9, DECU 45.1
+// and 41.6, OVR 49.1 and 48.7, OVRDEF 42.9 and 40.8, B64 33.6 and 33.8, BYTES 37.8 and
+// 37.0, PIN_T 38.2 and 35.9, PNO_T 34.9 and 34.8, A 40.3 and 38.7, PSTR 39.3 and 36.8, PU
+// 39.3 and 39.7, DUR 36.7 and 34.8; the keys at their figure realised within two points of
+// it on the mean but B (34.1 and 32.5 at 35), I8 (32.7 and 33.6), HEX (32.1 and 34.9), INTS
+// (37.5 and 37.7 at 40) and T plain (37.5 and 38.4 at 40), which ran within two in the
+// earlier runs.
+var keyWeights = map[string]int{
+	"PNO_N": 38, "N": 17, "M2": 41, "DECU": 45, "OVR": 50, "OVRDEF": 43, "B64": 36, "BYTES": 35,
+	"PIN_T": 36, "PNO_T": 34, "A": 39, "PSTR": 39, "PU": 40, "DUR": 36,
+}
+
+// with is the tune changed by f on a copy (the maps copied too).
+func (t tune) with(f func(*tune)) tune {
+	t.keys = copied(t.keys)
+	t.emptyBy = copied(t.emptyBy)
+	t.badBy = copied(t.badBy)
+	f(&t)
+	return t
+}
+
+func copied(m map[string]int) map[string]int {
+	out := map[string]int{}
+	for k, v := range m {
+		out[k] = v
+	}
+	return out
+}
+
+// noPreStruct is the tune with T, U and PU never pre-set (the narrow properties whose walk
+// must reach a struct-typed decoder field unset).
+func (t *tune) noPreStruct() { t.pre[pT], t.pre[pU], t.pre[pPU] = 0, 0, 0 }
+
+// --------------------------------------------------------------------------- generators
+
+// coin is true pct percent of the time, drawn from fair bits (dieCoin), shrinking to false.
+func coin(pct int) hegel.Generator[bool] { return dieCoin(pct) }
+
+// mutatorPool is the names a chain is drawn from: the five, or the four without fill.
+func mutatorPool(t tune) []string {
+	var pool []string
+	for _, n := range mutatorNames {
+		if n == "fill" && t.fill == 0 {
+			continue
+		}
+		if n == t.first || n == t.last {
+			continue
+		}
+		pool = append(pool, n)
+	}
+	return pool
+}
+
+// buildMutators is the chain from the drawn seeds: the forced first name, then for each seed
+// the name at that index of the pool with the names taken so far removed (the old loop's
+// draw, as a pure function of the seed list), then the forced last name.
+func buildMutators(t tune, seeds []int) []string {
+	var out []string
+	if t.first != "" {
+		out = append(out, t.first)
+	}
+	names := append([]string(nil), mutatorPool(t)...)
+	for _, j := range seeds {
+		j %= len(names)
+		out = append(out, names[j])
+		names = append(names[:j], names[j+1:]...)
+	}
+	if t.last != "" {
+		out = append(out, t.last)
+	}
+	return out
+}
+
+// optsGen draws the Config choices: the four coins and the four booleans at their shares,
+// the mutators present 40 percent of the time as a count of one to three (less the forced
+// names) and a seed per slot.
+func optsGen(t tune) hegel.Generator[procOpts] {
+	forced := 0
+	if t.first != "" {
+		forced++
+	}
+	if t.last != "" {
+		forced++
+	}
+	pool := len(mutatorPool(t))
+	lo := t.minCount - forced
+	if lo < 0 {
+		lo = 0
+	}
+	hi := 3 - forced
+	if hi > pool {
+		hi = pool
+	}
+	if lo > hi {
+		lo = hi
+	}
+	prefix := coin(t.prefix)
+	delimiter := coin(t.delimiter)
+	separator := coin(t.separator)
+	noInit := coin(t.noInit)
+	overwrite := coin(t.overwrite)
+	decodeSet := coin(t.decodeSet)
+	required := coin(t.required)
+	withMutators := coin(t.mutators)
+	count := rangeHalves(lo, hi) // one, two and three realised 12.7 and 12.6, 12.0 and 13.1, 14.4 and 13.6 of the cases
+	return hegel.Composite(func(tc hegel.TestCase) procOpts {
+		o := procOpts{}
+		if hegel.Draw(tc, prefix) {
+			o.prefix = "APP_"
+		}
+		if hegel.Draw(tc, delimiter) {
+			o.delimiter = ";"
+		}
+		if hegel.Draw(tc, separator) {
+			o.separator = "="
+		}
+		o.noInit = hegel.Draw(tc, noInit)
+		o.overwrite = hegel.Draw(tc, overwrite)
+		o.decodeSet = hegel.Draw(tc, decodeSet)
+		o.required = hegel.Draw(tc, required)
+		if forced > 0 || hegel.Draw(tc, withMutators) {
+			k := hegel.Draw(tc, count)
+			seeds := make([]int, k)
+			for i := range seeds {
+				seeds[i] = hegel.Draw(tc, rangeHalves(0, pool-1-i))
+			}
+			o.mutators = buildMutators(t, seeds)
+		}
+		return o
+	})
+}
+
+// envValue is one key's draw: absent, or a value (a map value as its spec).
+type envValue struct {
+	present bool
+	text    string
+	m       *mapSpec
+}
+
+// mapSpecGen draws a map[string]int value: the Config's delimiter and separator but for a
+// wrong one five percent of the time each, one to three items, each key and value from the
+// five, the value "x" three percent of the time, the item bare three percent of the time.
+var mapSpecGen = func() hegel.Generator[mapSpec] {
+	wrong := coin(6) // 5 nominal: delimiter 5.5 and 6.1, separator 5.3 and 5.7 (5 realised 3.9 and 3.7)
+	count := rangeHalves(1, 3)
+	index := rangeHalves(0, 4)
+	odd := coin(3) // bad 2.3 and 3.1, bare 3.5 and 2.5
+	return hegel.Composite(func(tc hegel.TestCase) mapSpec {
+		m := mapSpec{delim: -1, sep: -1}
+		if hegel.Draw(tc, wrong) {
+			m.delim = hegel.Draw(tc, rangeHalves(0, 2))
+		}
+		if hegel.Draw(tc, wrong) {
+			m.sep = hegel.Draw(tc, rangeHalves(0, 2))
+		}
+		k := hegel.Draw(tc, count) // one, two, three items 31.0 and 30.6, 34.2 and 32.9, 34.8 and 36.5
+		for i := 0; i < k; i++ {
+			m.items = append(m.items, mapItem{
+				key:  hegel.Draw(tc, index),
+				val:  hegel.Draw(tc, index),
+				bad:  hegel.Draw(tc, odd),
+				bare: hegel.Draw(tc, odd),
+			})
+		}
+		return m
+	})
+}()
+
+// valueGen is a present value of the kind: empty at the kind's share (8, time and url 2),
+// else from the ok pool, the bad pool at its share (2) and, for time and url, the
+// mutator-triggering additions at theirs; a map value is its spec.
+func valueGen(t tune, kind string) hegel.Generator[envValue] {
+	text := func(s string) envValue { return envValue{present: true, text: s} }
+	if kind == "map" {
+		return dieChoice(
+			hzW(t.empty, hegel.Just(text(""))),
+			hzW(100-t.empty, hegel.Map(mapSpecGen, func(m mapSpec) envValue { return envValue{present: true, m: &m} })),
+		)
+	}
+	p := valuePools[kind]
+	empty, bad, trig := t.empty, 0, 0
+	if w, ok := t.emptyBy[kind]; ok && empty > 0 {
+		empty = w
+	}
+	if len(p.bad) > 0 {
+		bad = t.bad
+		if w, ok := t.badBy[kind]; ok && bad > 0 {
+			bad = w
+		}
+	}
+	switch kind {
+	case "time":
+		empty, bad, trig = t.emptyTime, t.badTime, t.timeTrig
+	case "url":
+		empty, bad, trig = t.emptyURL, t.badURL, t.urlTrig
+	}
+	choices := []hzChoice[envValue]{hzW(empty, hegel.Just(text("")))}
+	choices = append(choices, hzW(100-empty-bad-trig, hegel.Map(evenHalves(p.ok...), text)))
+	if bad > 0 {
+		choices = append(choices, hzW(bad, hegel.Map(evenHalves(p.bad...), text)))
+	}
+	if trig > 0 {
+		choices = append(choices, hzW(trig, hegel.Map(evenHalves(p.trig...), text)))
+	}
+	return dieChoice(choices...)
+}
+
+// keyGen is the key's draw: absent at 100-pct, else a value.
+func keyGen(pct int, value hegel.Generator[envValue]) hegel.Generator[envValue] {
+	return dieChoice(hzW(100-pct, hegel.Just(envValue{})), hzW(pct, value))
+}
+
+// envGens are the per-key generators of a tune: by key the plain draw, the T key under
+// decodeunset at tDecode, and the three unprefixed names.
+type envGens struct {
+	byKey      []hegel.Generator[envValue]
+	tDecode    hegel.Generator[envValue]
+	unprefixed hegel.Generator[envValue]
+}
+
+func newEnvGens(t tune) envGens {
+	values := map[string]hegel.Generator[envValue]{}
+	for kind := range valuePools {
+		values[kind] = valueGen(t, kind)
+	}
+	values["map"] = valueGen(t, "map")
+	g := envGens{}
+	for _, ks := range keySpecs {
+		pct := ks.pct
+		if w, ok := keyWeights[ks.key]; ok {
+			pct = w
+		}
+		if ks.key == "SUBS" || ks.key == "SUBM" {
+			pct = t.subs
+		}
+		if v, ok := t.keys[ks.key]; ok {
+			pct = v
+		}
+		g.byKey = append(g.byKey, keyGen(pct, values[ks.kind]))
+	}
+	g.tDecode = keyGen(t.tDecode, values["time"])
+	if v, ok := t.keys["T"]; ok {
+		g.tDecode = keyGen(v, values["time"])
+	}
+	g.unprefixed = keyGen(30, values["str"]) // STR 30.8 and 34.6, X 28.5 and 32.2, REQ 33.2 and 32.2 (24 to 37 across the runs)
+	return g
+}
+
+// envGen draws the lookup map of a Config: per key its value at its presence (T at 90
+// under decodeunset, which makes an unset time.Time a decoding error), and under a prefix the
+// three unprefixed names at 30.
+func envGen(g envGens, o procOpts) hegel.Generator[[]envEntry] {
+	return hegel.Composite(func(tc hegel.TestCase) []envEntry {
+		var env []envEntry
+		for i, ks := range keySpecs {
+			gen := g.byKey[i]
+			if ks.key == "T" && o.decodeSet {
+				gen = g.tDecode
+			}
+			v := hegel.Draw(tc, gen)
+			if v.present {
+				env = append(env, envEntry{key: o.prefix + ks.key, value: v.text, m: v.m})
+			}
+		}
+		if o.prefix != "" {
+			for _, k := range unprefixedNames {
+				v := hegel.Draw(tc, g.unprefixed)
+				if v.present {
+					env = append(env, envEntry{key: k, value: v.text})
+				}
+			}
+		}
+		return env
+	})
+}
+
+// innerGen draws the pre-set choices of a nested Inner: N set 40 percent of the time to one
+// of 1 to 9, S 40, D 30, T 30.
+var innerGen = func() hegel.Generator[*innerInit] {
+	n := coin(42)              // 40 nominal: 41.7 and 40.3 (40 realised 37.3)
+	s := coin(40)              // 41.4 and 42.7 (34.8 in the first run; 43 realised 44.2 and 38.7)
+	d := coin(30)              // 27.3 and 31.0
+	t := coin(30)              // 31.4 and 31.3
+	digit := rangeHalves(1, 9) // 1 to 9
+	return hegel.Composite(func(tc hegel.TestCase) *innerInit {
+		r := &innerInit{}
+		if hegel.Draw(tc, n) {
+			r.n = hegel.Draw(tc, digit)
+		}
+		r.s = hegel.Draw(tc, s)
+		r.d = hegel.Draw(tc, d)
+		r.t = hegel.Draw(tc, t)
+		return r
+	})
+}()
+
+// initialGen draws the initial struct: zero half the time, else each of the 26 pre-set
+// choices at 25 (the nested records when their choice is on).
+func initialGen(t tune) hegel.Generator[initialSpec] {
+	zero := coin(t.zeroInit)
+	var pre [preCount]hegel.Generator[bool]
+	for i := range pre {
+		pre[i] = coin(t.pre[i])
+	}
+	inner := dieChoice(hzW(100-t.preInner, hegel.Just[*innerInit](nil)), hzW(t.preInner, innerGen))
+	return hegel.Composite(func(tc hegel.TestCase) initialSpec {
+		if hegel.Draw(tc, zero) {
+			return initialSpec{zero: true}
+		}
+		s := initialSpec{}
+		for i := 0; i < pAnA; i++ {
+			s.pre[i] = hegel.Draw(tc, pre[i])
+		}
+		s.in = hegel.Draw(tc, inner)
+		s.pin = hegel.Draw(tc, inner)
+		s.pno = hegel.Draw(tc, inner)
+		s.pre[pAnA] = hegel.Draw(tc, pre[pAnA])
+		return s
+	})
+}
+
+// casesOver is the cases of a population: the Config, the lookup map for it, the initial
+// struct.
+func casesOver(t tune) hegel.Generator[processCase] {
+	opts := optsGen(t)
+	gens := newEnvGens(t)
+	initial := initialGen(t)
+	return hegel.Composite(func(tc hegel.TestCase) processCase {
+		o := hegel.Draw(tc, opts)
+		return processCase{
+			opts:    o,
+			env:     hegel.Draw(tc, envGen(gens, o)),
+			initial: hegel.Draw(tc, initial),
+		}
+	})
+}
+
+// processCases is the wide property's population.
+var processCases = casesOver(wideTune)
diff --git a/hegel_zoo_idioms_test.go b/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..3b59247
--- /dev/null
+++ b/hegel_zoo_idioms_test.go
@@ -0,0 +1,619 @@
+package envconfig_test
+
+// The generator idioms the properties share, copied from the excelize/graphql-go/cobra/
+// cascadia/carbon/orb/chi/go-debian/gin/cellbuf/kong/roaring/mergo/gotext harness
+// (hegel_zoo_idioms_test.go there) with the hz prefix: hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator. Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on it,
+// except the shape of a recorded bug a wide property must reach every run, which goes first
+// at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a
+// weighted choice drawn alone comes out exact (the engine enumerates a small die), but inside
+// a case with other draws the engine favours the small values of any bounded draw at every
+// scale (go/chi and go/go-debian measured it: Integers(0, 99) lands in 0..9 about 29 percent
+// of the time, coins realise about 0.83 of nominal), so the rates are what the probe and the
+// collector (HEGEL_COLLECT=1) measure; hzFair, fairOver, fairInts, evenOver and fairTree
+// (from go/chi) re-roll the favourite face, the die* family (from go/go-debian) draws from
+// fair bits, the halving helpers at the end (from go/gin and go/kong: evenHalves,
+// rangeHalves, countedHalves, halvesOver, halvesGens, evenGens) halve a range by fair bits,
+// and the figure beside every weight in the generator files is the measured one.
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	from   hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, from: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](parts ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(parts))
+		for i, g := range parts {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](parts ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range parts {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].from
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].from
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var subtrees []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			subtrees = append(subtrees, hegel.Just(vs[i]))
+		} else {
+			subtrees = append(subtrees, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(subtrees)), func(i int) hegel.Generator[T] { return subtrees[i] })
+	}
+	choices := make([]hzChoice[T], len(subtrees))
+	for i, g := range subtrees {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// --------------------------------------------------------------------------- added for
+// go/gin: evenHalves is a table at one weight each drawn by halving: a fair-bit choice
+// between the two halves at their sizes (dieChoice), and each half again, down to one value;
+// the first value is the shrink target. dieTree's three-way splits (hzDie(3)) realised their
+// last face at 12 to 27 instead of 33 in gin's harness, so even tables are halved instead.
+// rangeHalves is the integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
+
+// --------------------------------------------------------------------------- added for
+// go/kong (halvesOver, halvesGens) and go/mergo (evenGens): weighted and even choices over
+// generators drawn by halving.
+
+// halvesOver is a table at the weights (the first value the shrink target) drawn by halving
+// like evenHalves (the go/kong helper): the entries are cut where the cumulative weight is
+// nearest half, a fair-bit choice between the two parts at their summed weights (dieChoice),
+// and each part again, down to one value. Every split is two-way; an entry of weight zero is
+// never drawn.
+func halvesOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	gens := make([]hegel.Generator[T], len(values))
+	for i, v := range values {
+		gens[i] = hegel.Just(v)
+	}
+	return halvesGens(weights, gens...)
+}
+
+// halvesGens is halvesOver over generators: the alternatives of a weighted choice at their
+// weights, drawn by halving (the first the shrink target).
+func halvesGens[T any](weights []int, gens ...hegel.Generator[T]) hegel.Generator[T] {
+	if len(weights) != len(gens) {
+		panic("halvesGens: weights and generators differ in length")
+	}
+	var ws []int
+	var gs []hegel.Generator[T]
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			gs = append(gs, gens[i])
+		}
+	}
+	if len(gs) == 0 {
+		panic("halvesGens: every alternative has weight 0")
+	}
+	if len(gs) == 1 {
+		return gs[0]
+	}
+	total := 0
+	for _, w := range ws {
+		total += w
+	}
+	cut, acc, best := 1, 0, -1
+	for i := 1; i < len(gs); i++ {
+		acc += ws[i-1]
+		d := 2*acc - total
+		if d < 0 {
+			d = -d
+		}
+		if best < 0 || d < best {
+			cut, best = i, d
+		}
+	}
+	left := 0
+	for _, w := range ws[:cut] {
+		left += w
+	}
+	return dieChoice(hzW(left, halvesGens(ws[:cut], gs[:cut]...)), hzW(total-left, halvesGens(ws[cut:], gs[cut:]...)))
+}
+
+// evenGens is halvesGens at one weight each.
+func evenGens[T any](gens ...hegel.Generator[T]) hegel.Generator[T] {
+	ws := make([]int, len(gens))
+	for i := range ws {
+		ws[i] = 1
+	}
+	return halvesGens(ws, gens...)
+}
diff --git a/hegel_zoo_lookupers_test.go b/hegel_zoo_lookupers_test.go
new file mode 100644
index 0000000..b5a2a7d
--- /dev/null
+++ b/hegel_zoo_lookupers_test.go
@@ -0,0 +1,178 @@
+package envconfig_test
+
+// The lookuper tree: a recursive record of Map, Prefix and Multi lookupers of depth at most
+// three (a table per depth, the go/kong precedent: the record is the raw material, the
+// lookuper is built from it by a pure function) resolved by a pure walk and by the built
+// lookuper. The property draws no shape of a recorded bug.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/sethvargo/go-envconfig"
+	"hegel.dev/go/hegel"
+)
+
+// lookKeys are the keys resolved; lookPrefixes the prefixes a Prefix node may carry.
+var (
+	lookKeys     = []string{"A", "B", "P_A", "P_B", "Q_P_A", "P_Q_A", "X"}
+	lookPrefixes = []string{"P_", "Q_", ""}
+)
+
+const (
+	lookMap = iota
+	lookPrefix
+	lookMulti
+)
+
+// lookNode is a node of the tree: a Map lookuper over the keys it holds (vals: -1 for a key
+// it lacks, else the digit of its value "<key>=<digit>"), a Prefix lookuper over one child,
+// or a Multi lookuper over zero to three.
+type lookNode struct {
+	kind   int
+	vals   [7]int
+	prefix int
+	kids   []lookNode
+}
+
+func (n lookNode) GoString() string {
+	switch n.kind {
+	case lookMap:
+		var parts []string
+		for i, k := range lookKeys {
+			if n.vals[i] >= 0 {
+				parts = append(parts, k+"="+strconv.Itoa(n.vals[i]))
+			}
+		}
+		return "Map{" + strings.Join(parts, " ") + "}"
+	case lookPrefix:
+		return fmt.Sprintf("Prefix(%q, %s)", lookPrefixes[n.prefix], n.kids[0].GoString())
+	}
+	var parts []string
+	for _, k := range n.kids {
+		parts = append(parts, k.GoString())
+	}
+	return "Multi(" + strings.Join(parts, ", ") + ")"
+}
+
+// build is the lookuper of the tree.
+func (n lookNode) build() envconfig.Lookuper {
+	switch n.kind {
+	case lookMap:
+		m := map[string]string{}
+		for i, k := range lookKeys {
+			if n.vals[i] >= 0 {
+				m[k] = k + "=" + strconv.Itoa(n.vals[i])
+			}
+		}
+		return envconfig.MapLookuper(m)
+	case lookPrefix:
+		return envconfig.PrefixLookuper(lookPrefixes[n.prefix], n.kids[0].build())
+	}
+	var ls []envconfig.Lookuper
+	for _, k := range n.kids {
+		ls = append(ls, k.build())
+	}
+	return envconfig.MultiLookuper(ls...)
+}
+
+// lookup resolves a key as the godoc says: a Map lookuper answers its own keys, a Prefix
+// lookuper prepends its prefix before the wrapped lookup, a Multi lookuper takes the first
+// hit.
+func (n lookNode) lookup(key string) (string, bool) {
+	switch n.kind {
+	case lookMap:
+		for i, k := range lookKeys {
+			if k == key && n.vals[i] >= 0 {
+				return k + "=" + strconv.Itoa(n.vals[i]), true
+			}
+		}
+		return "", false
+	case lookPrefix:
+		return n.kids[0].lookup(lookPrefixes[n.prefix] + key)
+	}
+	for _, k := range n.kids {
+		if v, ok := k.lookup(key); ok {
+			return v, true
+		}
+	}
+	return "", false
+}
+
+// leafGen is a Map node: each key held 40 percent of the time with a digit.
+var leafGen = func() hegel.Generator[lookNode] {
+	held := dieChoice(hzW(60, hegel.Just(-1)), hzW(40, rangeHalves(0, 9))) // 40 nominal
+	return hegel.Composite(func(tc hegel.TestCase) lookNode {
+		n := lookNode{kind: lookMap}
+		for i := range lookKeys {
+			n.vals[i] = hegel.Draw(tc, held)
+		}
+		return n
+	})
+}()
+
+// treeGen is a node of the given depth: a leaf at depth zero, else a leaf 40 percent of the
+// time, a Prefix node 30 (one child of the depth below) and a Multi node 30 (zero to three
+// children of the depth below); the leaf first, the shrink target.
+func treeGen(depth int) hegel.Generator[lookNode] {
+	if depth == 0 {
+		return leafGen
+	}
+	sub := treeGen(depth - 1)
+	prefix := evenHalves(0, 1, 2)
+	count := rangeHalves(0, 3)
+	prefixNode := hegel.Composite(func(tc hegel.TestCase) lookNode {
+		return lookNode{kind: lookPrefix, prefix: hegel.Draw(tc, prefix), kids: []lookNode{hegel.Draw(tc, sub)}}
+	})
+	multiNode := hegel.Composite(func(tc hegel.TestCase) lookNode {
+		n := lookNode{kind: lookMulti}
+		for i, k := 0, hegel.Draw(tc, count); i < k; i++ {
+			n.kids = append(n.kids, hegel.Draw(tc, sub))
+		}
+		return n
+	})
+	return dieChoice(hzW(40, leafGen), hzW(30, prefixNode), hzW(30, multiNode)) // 40/30/30 nominal
+}
+
+// lookTrees are the trees of depth three.
+var lookTrees = treeGen(3)
+
+// lookExpected states the resolution of every key: "lookup <key>" is "<value> found" or
+// "missing" (no switch applies).
+func lookExpected(n lookNode, k known) checks {
+	out := checks{}
+	for _, key := range lookKeys {
+		v, ok := n.lookup(key)
+		out.set("lookup "+key, lookText(v, ok))
+	}
+	return out
+}
+
+func lookText(v string, ok bool) string {
+	if !ok {
+		return "missing"
+	}
+	return v + " found"
+}
+
+// lookActual asks the built lookuper.
+func lookActual(n *lookNode) checks {
+	out := checks{}
+	l := n.build()
+	for _, key := range lookKeys {
+		v, ok := l.Lookup(key)
+		out.set("lookup "+key, lookText(v, ok))
+	}
+	return out
+}
+
+// TestHegelLookupersCompose: a tree of Map, Prefix and Multi lookupers resolves a key as the
+// godoc says: a prefix is prepended before the wrapped lookup, a multi lookuper takes the
+// first hit.
+func TestHegelLookupersCompose(t *testing.T) {
+	judged(t, lookTrees, func(j *hzCaseJudge, n lookNode) {
+		judgeBy(j, &n, lookExpected, lookActual)
+	})
+}
diff --git a/hegel_zoo_model_test.go b/hegel_zoo_model_test.go
new file mode 100644
index 0000000..044e274
--- /dev/null
+++ b/hegel_zoo_model_test.go
@@ -0,0 +1,1061 @@
+package envconfig_test
+
+// The configuration struct the properties process, and the model of what envconfig documents
+// for it: the README (tags and options, decoding, the overwrite rules, initialization), the
+// package godoc (Config defaults, lookupers, mutators, the error sentinels) and the Mutator
+// doc. The model is driven by a hand-written table of the fields' tags (specs below), walked
+// in struct order; the first error ends the walk, as Process returns its first error. It is a
+// pure function of the case record and the switch set, processExpected(c, k): with every
+// switch off it states the documented behaviour; under a switch the rule changes exactly as
+// the library's code does (the replica of that bug, cited at each read of k). The struct
+// gained two fields over the committed test, Subs []Plain and SubM map[string]Plain, so that
+// the wide property draws the shape of go-envconfig/10 (a struct without a decoder as a
+// slice or map element); func and chan fields stay out, since their values cannot be
+// compared, and the pin covers them.
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/sethvargo/go-envconfig"
+)
+
+// --------------------------------------------------------------------------- the struct
+
+// dec is a non-struct type with a DecoderCtx: "bad" fails, anything else becomes "D-"+value.
+type dec string
+
+var errBadDec = errors.New("bad dec")
+
+func (d *dec) EnvDecode(ctx context.Context, v string) error {
+	if v == "bad" {
+		return errBadDec
+	}
+	*d = dec("D-" + v)
+	return nil
+}
+
+// Inner is the nested struct, used by value, by pointer and by pointer with noinit.
+type Inner struct {
+	N int       `env:"N"`
+	S string    `env:"S,default=inner-default"`
+	R string    `env:"R,default=$STR"`
+	D dec       `env:"D"`
+	T time.Time `env:"T"`
+}
+
+// Anon is a nested struct without a tag: its fields share the parent's namespace.
+type Anon struct {
+	A string `env:"A"`
+}
+
+// Plain is a struct without a decoder: as a slice or map element it is an unsupported kind
+// (go-envconfig/10).
+type Plain struct {
+	X int `env:"X"`
+}
+
+type Cfg struct {
+	Str    string                `env:"STR"`
+	Def    string                `env:"DEF,default=dflt"`
+	Ref    string                `env:"REF,default=$STR-x"`
+	Esc    string                `env:"ESC,default=\\$5,x"`
+	I      int                   `env:"I"`
+	I8     int8                  `env:"I8"`
+	U16    uint16                `env:"U16"`
+	I64    int64                 `env:"I64"`
+	F      float64               `env:"F"`
+	B      bool                  `env:"B"`
+	Dur    time.Duration         `env:"DUR"`
+	T      time.Time             `env:"T"`
+	U      url.URL               `env:"U"`
+	PU     *url.URL              `env:"PU,noinit"`
+	Ptr    *int                  `env:"PTR"`
+	PStr   *string               `env:"PSTR,default=pd"`
+	NoIn   *string               `env:"NOIN,noinit"`
+	Strs   []string              `env:"STRS"`
+	Ints   []int                 `env:"INTS,delimiter=;"`
+	Bytes  []byte                `env:"BYTES"`
+	B64    envconfig.Base64Bytes `env:"B64"`
+	Hex    envconfig.HexBytes    `env:"HEX"`
+	M      map[string]int        `env:"M"`
+	M2     map[int]string        `env:"M2,delimiter=|,separator=="`
+	Req    string                `env:"REQ,required"`
+	Ovr    string                `env:"OVR,overwrite"`
+	OvrDef int                   `env:"OVRDEF,overwrite,default=3"`
+	Dec    dec                   `env:"DEC"`
+	DecU   dec                   `env:"DECU,decodeunset"`
+	In     Inner                 `env:",prefix=IN_"`
+	PIn    *Inner                `env:",prefix=PIN_"`
+	PNo    *Inner                `env:",prefix=PNO_,noinit"`
+	An     Anon
+	Subs   []Plain          `env:"SUBS"`
+	SubM   map[string]Plain `env:"SUBM"`
+	NoTag  int
+	hidden string
+}
+
+// --------------------------------------------------------------------------- specs
+
+// spec restates one field's tag. ptr returns a pointer to the field of the given struct
+// (*Cfg or *Inner).
+type spec struct {
+	name                                   string
+	key, def                               string
+	required, overwrite, noInit, decodeSet bool
+	delimiter, separator, prefix           string
+	ptr                                    func(any) any
+}
+
+func cf(f func(*Cfg) any) func(any) any    { return func(v any) any { return f(v.(*Cfg)) } }
+func inf(f func(*Inner) any) func(any) any { return func(v any) any { return f(v.(*Inner)) } }
+func anf(f func(*Anon) any) func(any) any  { return func(v any) any { return f(v.(*Anon)) } }
+
+var cfgSpecs = []spec{
+	{name: "Str", key: "STR", ptr: cf(func(c *Cfg) any { return &c.Str })},
+	{name: "Def", key: "DEF", def: "dflt", ptr: cf(func(c *Cfg) any { return &c.Def })},
+	{name: "Ref", key: "REF", def: "$STR-x", ptr: cf(func(c *Cfg) any { return &c.Ref })},
+	{name: "Esc", key: "ESC", def: `\$5,x`, ptr: cf(func(c *Cfg) any { return &c.Esc })},
+	{name: "I", key: "I", ptr: cf(func(c *Cfg) any { return &c.I })},
+	{name: "I8", key: "I8", ptr: cf(func(c *Cfg) any { return &c.I8 })},
+	{name: "U16", key: "U16", ptr: cf(func(c *Cfg) any { return &c.U16 })},
+	{name: "I64", key: "I64", ptr: cf(func(c *Cfg) any { return &c.I64 })},
+	{name: "F", key: "F", ptr: cf(func(c *Cfg) any { return &c.F })},
+	{name: "B", key: "B", ptr: cf(func(c *Cfg) any { return &c.B })},
+	{name: "Dur", key: "DUR", ptr: cf(func(c *Cfg) any { return &c.Dur })},
+	{name: "T", key: "T", ptr: cf(func(c *Cfg) any { return &c.T })},
+	{name: "U", key: "U", ptr: cf(func(c *Cfg) any { return &c.U })},
+	{name: "PU", key: "PU", noInit: true, ptr: cf(func(c *Cfg) any { return &c.PU })},
+	{name: "Ptr", key: "PTR", ptr: cf(func(c *Cfg) any { return &c.Ptr })},
+	{name: "PStr", key: "PSTR", def: "pd", ptr: cf(func(c *Cfg) any { return &c.PStr })},
+	{name: "NoIn", key: "NOIN", noInit: true, ptr: cf(func(c *Cfg) any { return &c.NoIn })},
+	{name: "Strs", key: "STRS", ptr: cf(func(c *Cfg) any { return &c.Strs })},
+	{name: "Ints", key: "INTS", delimiter: ";", ptr: cf(func(c *Cfg) any { return &c.Ints })},
+	{name: "Bytes", key: "BYTES", ptr: cf(func(c *Cfg) any { return &c.Bytes })},
+	{name: "B64", key: "B64", ptr: cf(func(c *Cfg) any { return &c.B64 })},
+	{name: "Hex", key: "HEX", ptr: cf(func(c *Cfg) any { return &c.Hex })},
+	{name: "M", key: "M", ptr: cf(func(c *Cfg) any { return &c.M })},
+	{name: "M2", key: "M2", delimiter: "|", separator: "=", ptr: cf(func(c *Cfg) any { return &c.M2 })},
+	{name: "Req", key: "REQ", required: true, ptr: cf(func(c *Cfg) any { return &c.Req })},
+	{name: "Ovr", key: "OVR", overwrite: true, ptr: cf(func(c *Cfg) any { return &c.Ovr })},
+	{name: "OvrDef", key: "OVRDEF", overwrite: true, def: "3", ptr: cf(func(c *Cfg) any { return &c.OvrDef })},
+	{name: "Dec", key: "DEC", ptr: cf(func(c *Cfg) any { return &c.Dec })},
+	{name: "DecU", key: "DECU", decodeSet: true, ptr: cf(func(c *Cfg) any { return &c.DecU })},
+	{name: "In", prefix: "IN_", ptr: cf(func(c *Cfg) any { return &c.In })},
+	{name: "PIn", prefix: "PIN_", ptr: cf(func(c *Cfg) any { return &c.PIn })},
+	{name: "PNo", prefix: "PNO_", noInit: true, ptr: cf(func(c *Cfg) any { return &c.PNo })},
+	{name: "An", ptr: cf(func(c *Cfg) any { return &c.An })},
+	{name: "Subs", key: "SUBS", ptr: cf(func(c *Cfg) any { return &c.Subs })},
+	{name: "SubM", key: "SUBM", ptr: cf(func(c *Cfg) any { return &c.SubM })},
+	{name: "NoTag", ptr: cf(func(c *Cfg) any { return &c.NoTag })},
+}
+
+var innerSpecs = []spec{
+	{name: "N", key: "N", ptr: inf(func(c *Inner) any { return &c.N })},
+	{name: "S", key: "S", def: "inner-default", ptr: inf(func(c *Inner) any { return &c.S })},
+	{name: "R", key: "R", def: "$STR", ptr: inf(func(c *Inner) any { return &c.R })},
+	{name: "D", key: "D", ptr: inf(func(c *Inner) any { return &c.D })},
+	{name: "T", key: "T", ptr: inf(func(c *Inner) any { return &c.T })},
+}
+
+var anonSpecs = []spec{
+	{name: "A", key: "A", ptr: anf(func(c *Anon) any { return &c.A })},
+}
+
+// checkRank: the error first, then the fields in struct order, a nested field after its
+// struct.
+func init() {
+	for i, s := range cfgSpecs {
+		checkRank["field "+s.name] = 10*(i+1) + 0
+		switch s.name {
+		case "In", "PIn", "PNo":
+			for j, is := range innerSpecs {
+				checkRank["field "+s.name+"."+is.name] = 10*(i+1) + j + 1
+			}
+		case "An":
+			checkRank["field An.A"] = 10*(i+1) + 1
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- mutators
+
+// The mutators the properties may install, as pure functions shared by the model and, wrapped
+// as envconfig.Mutator, by the code under test: tilde rewrites "~x" to "x!", stop ends the
+// chain on the original value "stop", err refuses "muterr", legacy (a LegacyMutatorFunc)
+// doubles a value that starts with "L" (so that numbers stay numbers), fill turns an empty
+// current value into "filled" (the shape of go-envconfig/12: a mutator that acts on the
+// empty value an unset variable has under decodeunset; it acts on a set-but-empty value too,
+// which is documented on both sides, and never on a default, which is non-empty here).
+var errMut = errors.New("mutator refused")
+
+func mutTilde(ok, rk, ov, cv string) (string, bool, error) {
+	if strings.HasPrefix(cv, "~") {
+		return cv[1:] + "!", false, nil
+	}
+	return cv, false, nil
+}
+
+func mutStop(ok, rk, ov, cv string) (string, bool, error) {
+	if ov == "stop" {
+		return "stopped", true, nil
+	}
+	return cv, false, nil
+}
+
+func mutErr(ok, rk, ov, cv string) (string, bool, error) {
+	if cv == "muterr" {
+		return "", false, errMut
+	}
+	return cv, false, nil
+}
+
+func mutFill(ok, rk, ov, cv string) (string, bool, error) {
+	if cv == "" {
+		return "filled", false, nil
+	}
+	return cv, false, nil
+}
+
+func legacyFn(ctx context.Context, key, value string) (string, error) {
+	if strings.HasPrefix(value, "L") {
+		return value + "L", nil
+	}
+	return value, nil
+}
+
+var mutatorNames = []string{"tilde", "stop", "err", "legacy", "fill"}
+
+func realMutator(name string) envconfig.Mutator {
+	wrap := func(f func(ok, rk, ov, cv string) (string, bool, error)) envconfig.Mutator {
+		return envconfig.MutatorFunc(func(ctx context.Context, ok, rk, ov, cv string) (string, bool, error) {
+			return f(ok, rk, ov, cv)
+		})
+	}
+	switch name {
+	case "tilde":
+		return wrap(mutTilde)
+	case "stop":
+		return wrap(mutStop)
+	case "err":
+		return wrap(mutErr)
+	case "fill":
+		return wrap(mutFill)
+	}
+	return envconfig.LegacyMutatorFunc(legacyFn)
+}
+
+// modelMutator is the pure form of the named mutator. Documented: a legacy mutator is the old
+// signature wrapped and has no say on the chain; go-envconfig/7 (kLegacyMutatorStops):
+// mutator.go :74 "return v, true, err" ends the chain after it.
+func modelMutator(name string, k known) func(ok, rk, ov, cv string) (string, bool, error) {
+	switch name {
+	case "tilde":
+		return mutTilde
+	case "stop":
+		return mutStop
+	case "err":
+		return mutErr
+	case "fill":
+		return mutFill
+	}
+	return func(ok, rk, ov, cv string) (string, bool, error) {
+		v, err := legacyFn(context.Background(), ok, cv)
+		return v, k[kLegacyMutatorStops], err
+	}
+}
+
+// --------------------------------------------------------------------------- model
+
+// merr is the model's error: the field path (outer to inner) and the kind
+// (missingRequired, requiredAndDefault, mapItem, mutator, parse).
+type merr struct {
+	path  []string
+	kind  string
+	field string // the top-level field the walk failed in, when the path does not say (go-envconfig/9's bare error)
+}
+
+func (e *merr) under(name string) *merr {
+	if e == nil {
+		return nil
+	}
+	return &merr{path: append([]string{name}, e.path...), kind: e.kind, field: name}
+}
+
+// top is the top-level field the walk failed in.
+func (e *merr) top() string {
+	if e.field != "" {
+		return e.field
+	}
+	return e.path[0]
+}
+
+// text is the error check's value: "<kind> at <path>", the path joined with ": " (empty for
+// a bare error, go-envconfig/9).
+func (e *merr) text() string { return e.kind + " at " + strings.Join(e.path, ": ") }
+
+type scope struct {
+	prefix               string // full key prefix: lookuper prefix + nested prefixes
+	delimiter, separator string
+	noInit, overwrite    bool
+	decodeSet, required  bool
+}
+
+type model struct {
+	env  map[string]string
+	opts procOpts
+	k    known
+}
+
+// processExpected states the checks of a case under the switch set k: "error" (none, or the
+// kind and the field path of the first error), and every exported top-level field's value in
+// its comparable form (valueText: the fields of the nested Inner structs as checks of their
+// own). On an expected error the fields BEFORE the failing one in walk order (struct order;
+// the failing field is the first name of the error's path, merr.top) are checked too: Process sets
+// them before it reaches the error, so they hold their documented values. The failing field
+// and every field after it are not checked: the failing field's state is partial by design
+// (a zeroed time.Time, a Base64Bytes partial result) and the walk ends there.
+func processExpected(c processCase, k known) checks {
+	cfg, e := modelRun(c, k)
+	out := checks{}
+	if e != nil {
+		out.set("error", e.text())
+		stateFields(out, cfg, e.top())
+		return out
+	}
+	out.set("error", "none")
+	stateFields(out, cfg, "")
+	return out
+}
+
+// modelRun applies the documented semantics under k to a fresh initial struct built from the
+// case and returns it with the error, if any.
+func modelRun(c processCase, k known) (*Cfg, *merr) {
+	cfg := buildInitial(c.initial)
+	o := c.opts
+	m := &model{env: envMap(c), opts: o, k: k}
+	d := o.delimiter
+	if d == "" {
+		d = ","
+	}
+	s := o.separator
+	if s == "" {
+		s = ":"
+	}
+	e := m.walk(cfg, cfgSpecs, scope{prefix: o.prefix, delimiter: d, separator: s,
+		noInit: o.noInit, overwrite: o.overwrite, decodeSet: o.decodeSet, required: o.required})
+	return cfg, e
+}
+
+// stateFields states the field checks of a Cfg: "field <Name>" for every exported top-level
+// field before the one named upTo in struct order (every field for ""), the nested Inner
+// structs as "field <Name>.<Sub>" (a nil pointer as "nil", a set one as "set" with its
+// sub-fields), Anon as "field An.A".
+func stateFields(out checks, cfg *Cfg, upTo string) {
+	v := reflect.ValueOf(cfg).Elem()
+	for i := 0; i < v.NumField(); i++ {
+		f := v.Type().Field(i)
+		if f.Name == upTo {
+			return
+		}
+		if !f.IsExported() {
+			continue
+		}
+		fv := v.Field(i)
+		switch f.Name {
+		case "In":
+			stateInner(out, "field In.", fv)
+		case "PIn", "PNo":
+			if fv.IsNil() {
+				out["field "+f.Name] = hzValue("nil")
+				continue
+			}
+			out["field "+f.Name] = hzValue("set")
+			stateInner(out, "field "+f.Name+".", fv.Elem())
+		case "An":
+			out["field An.A"] = hzValue(valueText(fv.Field(0)))
+		default:
+			out["field "+f.Name] = hzValue(valueText(fv))
+		}
+	}
+}
+
+func stateInner(out checks, prefix string, v reflect.Value) {
+	for i := 0; i < v.NumField(); i++ {
+		out[prefix+v.Type().Field(i).Name] = hzValue(valueText(v.Field(i)))
+	}
+}
+
+// lookup: the documented resolution of one key. A set-but-empty variable is a value; a default
+// applies only when the variable is unset and is expanded ($NAME) against the plain
+// environment, with \$ a literal dollar and \\ a literal backslash.
+func (m *model) lookup(key string, required bool, def string, sc scope) (val string, found, usedDef bool, kind string) {
+	if key == "" {
+		return "", false, false, "missingKey"
+	}
+	if required && def != "" {
+		return "", false, false, "requiredAndDefault"
+	}
+	val, found = m.env[sc.prefix+key]
+	if found {
+		return val, true, false, ""
+	}
+	if required {
+		return "", false, false, "missingRequired"
+	}
+	if def == "" {
+		return "", false, false, ""
+	}
+	def = strings.ReplaceAll(def, `\\`, "\x00")
+	def = strings.ReplaceAll(def, `\$`, "\x08")
+	val = os.Expand(def, func(name string) string { return m.env[name] })
+	val = strings.ReplaceAll(val, "\x00", `\`)
+	val = strings.ReplaceAll(val, "\x08", "$")
+	return val, false, true, ""
+}
+
+func (m *model) mutate(key string, sc scope, val string) (string, string) {
+	orig := val
+	for _, name := range m.opts.mutators {
+		v, stop, err := modelMutator(name, m.k)(key, sc.prefix+key, orig, val)
+		if err != nil {
+			return "", "mutator"
+		}
+		val = v
+		if stop {
+			break
+		}
+	}
+	return val, ""
+}
+
+// mutated reports whether the mutators run on a field's value. Documented (mutator.go :24):
+// on defined values, or when decodeunset is true (the field's effective decodeunset), on the
+// empty string when unset. go-envconfig/12 (kMutatorsSkipUnset): processWith :588 runs them
+// only when found || usedDefault.
+func (m *model) mutated(found, usedDef bool, fs scope) bool {
+	return found || usedDef || (fs.decodeSet && !m.k[kMutatorsSkipUnset])
+}
+
+func (m *model) fieldScope(sc scope, s spec) scope {
+	f := sc
+	if s.delimiter != "" {
+		f.delimiter = s.delimiter
+	}
+	if s.separator != "" {
+		f.separator = s.separator
+	}
+	f.noInit = sc.noInit || s.noInit
+	f.overwrite = sc.overwrite || s.overwrite
+	f.decodeSet = sc.decodeSet || s.decodeSet
+	// Documented: a Config-level required marks fields required; a field with a default has a
+	// value in every case, so it is not one of them. go-envconfig/4
+	// (kDefaultRequiredRejectsDefaults): processWith :450 "required := structRequired ||
+	// opts.Required" is handed to lookup :518/:573, whose :759-762 refuses required with a
+	// default.
+	f.required = s.required || (sc.required && (s.def == "" || m.k[kDefaultRequiredRejectsDefaults]))
+	return f
+}
+
+func (m *model) walk(target any, specs []spec, sc scope) *merr {
+	for _, s := range specs {
+		p := s.ptr(target)
+		fs := m.fieldScope(sc, s)
+		if isStructKind(p) {
+			if e := m.structField(p, s, sc, fs); e != nil {
+				return e
+			}
+			continue
+		}
+		if s.key == "" {
+			continue
+		}
+		set := isSet(p)
+		if set && !fs.overwrite {
+			continue
+		}
+		val, found, usedDef, kind := m.lookup(s.key, fs.required, s.def, sc)
+		if kind != "" {
+			return &merr{path: []string{s.name}, kind: kind}
+		}
+		if set && !found {
+			continue
+		}
+		if m.mutated(found, usedDef, fs) {
+			if val, kind = m.mutate(s.key, sc, val); kind != "" {
+				return &merr{path: []string{s.name}, kind: kind}
+			}
+		}
+		if val == "" && fs.noInit {
+			continue
+		}
+		if hasDecoder(p) {
+			// Documented (README, decodeunset): decoders run when the variable is set, a default
+			// applies or decodeunset holds. go-envconfig/2 (kDecodersRunOnUnset): processField
+			// :927 hands the looked-up value, the empty string when unset, to processAsDecoder
+			// before any check of it.
+			if found || usedDef || fs.decodeSet || m.k[kDecodersRunOnUnset] {
+				if err := decodeValue(p, val); err != nil {
+					return &merr{path: []string{s.name}, kind: "parse"}
+				}
+			}
+			continue
+		}
+		allocPtr(p)
+		if val == "" {
+			// Documented (README, overwrite and default): a provided empty variable is a
+			// value and overwrites the existing one. go-envconfig/3 (kOverwriteEmptyKeeps):
+			// processField :935-937 returns before the kind switch sets anything.
+			if set && found && !m.k[kOverwriteEmptyKeeps] {
+				setZero(p)
+			}
+			continue
+		}
+		if isUnsupported(p) {
+			// Documented (godoc): "All built-in types are supported except Func and Chan", an
+			// interface is refused with an error (processField :982-983), so an element kind
+			// without a decoder is an error too. go-envconfig/10 (kUnsupportedKindsSilent):
+			// the kind switch :939-1026 has no default case, the elements stay zero.
+			if !m.k[kUnsupportedKindsSilent] {
+				return &merr{path: []string{s.name}, kind: "parse"}
+			}
+			if kind := decodeUnsupported(p, val, fs); kind != "" {
+				return &merr{path: []string{s.name}, kind: kind}
+			}
+			continue
+		}
+		if kind := decodeScalar(p, val, fs); kind != "" {
+			return &merr{path: []string{s.name}, kind: kind}
+		}
+	}
+	return nil
+}
+
+// structField: a struct-kind field (after pointers). With a key and a decoder it is decoded
+// when its variable is set (or a default or decodeunset applies), like any field; otherwise it
+// is walked as a nested struct with its prefix and the inherited defaults. A nil pointer is
+// walked detached and attached afterwards, unless noinit and nothing was set.
+func (m *model) structField(p any, s spec, sc, fs scope) *merr {
+	nilPtr := isNilPtr(p)
+	val, found, usedDef, kind := m.lookup(s.key, fs.required, s.def, sc)
+	if kind != "" && kind != "missingKey" {
+		return &merr{path: []string{s.name}, kind: kind}
+	}
+	if hasStructDecoder(p) && (found || usedDef || fs.decodeSet) {
+		// Documented (README, overwrite rules): an existing non-zero value is kept unless
+		// overwrite and the variable is set. go-envconfig/6 (kStructDecoderIgnoresOverwrite):
+		// the struct path :523-531 decodes whenever found, usedDefault or decodeUnset; the
+		// overwrite rules :567-583 are in the non-struct path alone.
+		if !m.k[kStructDecoderIgnoresOverwrite] {
+			set := isSet(p)
+			if set && !fs.overwrite {
+				return nil
+			}
+			if set && !found {
+				return nil
+			}
+		}
+		// Documented (Mutator doc): mutators alter the looked-up value of every field.
+		// go-envconfig/5 (kMutatorsSkipStructs): the mutator loop :585-606 sits in the
+		// non-struct path only, after the struct path has decoded and continued.
+		if !m.k[kMutatorsSkipStructs] && m.mutated(found, usedDef, fs) {
+			if val, kind = m.mutate(s.key, sc, val); kind != "" {
+				return &merr{path: []string{s.name}, kind: kind}
+			}
+		}
+		tmp := detached(p)
+		if err := decodeValue(tmp, val); err != nil {
+			// Documented (godoc): every error names its field. go-envconfig/9
+			// (kStructDecoderErrorUnprefixed): the struct path :525-527 returns the decoder's
+			// error bare.
+			if m.k[kStructDecoderErrorUnprefixed] {
+				return &merr{kind: "parse", field: s.name}
+			}
+			return &merr{path: []string{s.name}, kind: "parse"}
+		}
+		if !nilPtr || !fs.noInit || !isZeroValue(tmp) {
+			attach(p, tmp)
+		}
+		return nil
+	}
+	inner := detached(p)
+	isc := scope{prefix: sc.prefix + s.prefix, delimiter: fs.delimiter, separator: fs.separator,
+		noInit: fs.noInit, overwrite: fs.overwrite, required: fs.required, decodeSet: fs.decodeSet}
+	// Documented (godoc, Config): the six defaults are of the same standing and nested structs
+	// inherit the resolved ones. go-envconfig/11 (kDecodeUnsetNotInherited): the recursion
+	// :539-548 builds the nested Config without DefaultDecodeUnset.
+	if m.k[kDecodeUnsetNotInherited] {
+		isc.decodeSet = false
+	}
+	var e *merr
+	switch v := inner.(type) {
+	case *Inner:
+		e = m.walk(v, innerSpecs, isc)
+	case *Anon:
+		e = m.walk(v, anonSpecs, isc)
+	case *url.URL:
+		// Documented: nothing in a url.URL is tagged, and a type with a decoder has no fields
+		// of its own to initialize. go-envconfig/1 (kURLUserMaterialized): the struct path
+		// :508-554 walks the unset field as a nested struct and the pointer loop :478-506
+		// materializes its nil User *Userinfo, attached by setNilStruct :454-465 unless noInit.
+		if m.k[kURLUserMaterialized] && !fs.noInit && v.User == nil {
+			v.User = &url.Userinfo{}
+		}
+	case *time.Time:
+		// time.Time has no exported fields: the walk finds nothing to initialize.
+	}
+	if e != nil {
+		return e.under(s.name)
+	}
+	if !nilPtr || !fs.noInit || !isZeroValue(inner) {
+		attach(p, inner)
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- field access
+
+func isStructKind(p any) bool {
+	switch p.(type) {
+	case *time.Time, *url.URL, **url.URL, *Inner, **Inner, *Anon:
+		return true
+	}
+	return false
+}
+
+func hasStructDecoder(p any) bool {
+	switch p.(type) {
+	case *time.Time, *url.URL, **url.URL:
+		return true
+	}
+	return false
+}
+
+func hasDecoder(p any) bool {
+	switch p.(type) {
+	case *dec, *envconfig.Base64Bytes, *envconfig.HexBytes:
+		return true
+	}
+	return false
+}
+
+// isUnsupported: a slice or map whose element is a struct without a decoder.
+func isUnsupported(p any) bool {
+	switch p.(type) {
+	case *[]Plain, *map[string]Plain:
+		return true
+	}
+	return false
+}
+
+func isNilPtr(p any) bool {
+	switch v := p.(type) {
+	case **url.URL:
+		return *v == nil
+	case **Inner:
+		return *v == nil
+	}
+	return false
+}
+
+// detached returns the struct to work on: the field itself for values and set pointers, a
+// fresh one for a nil pointer.
+func detached(p any) any {
+	switch v := p.(type) {
+	case **url.URL:
+		if *v == nil {
+			return &url.URL{}
+		}
+		return *v
+	case **Inner:
+		if *v == nil {
+			return &Inner{}
+		}
+		return *v
+	}
+	return p
+}
+
+func attach(p, tmp any) {
+	switch v := p.(type) {
+	case **url.URL:
+		*v = tmp.(*url.URL)
+	case **Inner:
+		*v = tmp.(*Inner)
+	}
+}
+
+func isZeroValue(p any) bool { return reflect.ValueOf(p).Elem().IsZero() }
+
+// isSet: a non-nil pointer or a non-zero value (the README's "existing non-zero struct
+// values").
+func isSet(p any) bool {
+	v := reflect.ValueOf(p).Elem()
+	return !v.IsZero()
+}
+
+func allocPtr(p any) {
+	switch v := p.(type) {
+	case **int:
+		if *v == nil {
+			*v = new(int)
+		}
+	case **string:
+		if *v == nil {
+			*v = new(string)
+		}
+	}
+}
+
+func setZero(p any) { reflect.ValueOf(p).Elem().Set(reflect.Zero(reflect.TypeOf(p).Elem())) }
+
+// decodeValue: the type's own decoder (Decoder, TextUnmarshaler, BinaryUnmarshaler), as the
+// README lists them.
+func decodeValue(p any, val string) error {
+	switch v := p.(type) {
+	case *dec:
+		return v.EnvDecode(context.Background(), val)
+	case *envconfig.Base64Bytes:
+		// The field takes what was decoded, also the partial result of a failing decode (the
+		// package's own decoders assign before checking; accepted).
+		s := strings.TrimRight(strings.NewReplacer("+", "-", "/", "_").Replace(val), "=")
+		b, err := base64.RawURLEncoding.DecodeString(s)
+		*v = b
+		return err
+	case *envconfig.HexBytes:
+		b, err := hex.DecodeString(val)
+		*v = b
+		return err
+	case *time.Time:
+		return v.UnmarshalText([]byte(val))
+	case *url.URL:
+		u, err := url.Parse(val)
+		if err != nil {
+			return err
+		}
+		*v = *u
+	}
+	return nil
+}
+
+func parseInt(val string, bits int) (int64, error)   { return strconv.ParseInt(val, 0, bits) }
+func parseUint(val string, bits int) (uint64, error) { return strconv.ParseUint(val, 0, bits) }
+
+// decodeUnsupported is the replica of go-envconfig/10: processField's kind switch decodes a
+// slice :1011-1025 or a map :986-1008 of a struct without a decoder to zero elements (the
+// items are split on the delimiter, a map item without the separator is ErrInvalidMapItem
+// :990-993, the key trimmed, the element falls through the switch to zero).
+func decodeUnsupported(p any, val string, fs scope) string {
+	switch v := p.(type) {
+	case *[]Plain:
+		*v = make([]Plain, len(strings.Split(val, fs.delimiter)))
+	case *map[string]Plain:
+		out := map[string]Plain{}
+		for _, item := range strings.Split(val, fs.delimiter) {
+			k, _, ok := strings.Cut(item, fs.separator)
+			if !ok {
+				return "mapItem"
+			}
+			out[strings.TrimSpace(k)] = Plain{}
+		}
+		*v = out
+	}
+	return ""
+}
+
+// decodeScalar: built-in kinds; slices split on the delimiter, maps on the delimiter and the
+// separator, items trimmed; an empty item is the zero value.
+func decodeScalar(p any, val string, fs scope) string {
+	switch v := p.(type) {
+	case *string:
+		*v = val
+	case **string:
+		**v = val
+	case *int:
+		i, err := parseInt(val, 64)
+		if err != nil {
+			return "parse"
+		}
+		*v = int(i)
+	case **int:
+		i, err := parseInt(val, 64)
+		if err != nil {
+			return "parse"
+		}
+		**v = int(i)
+	case *int8:
+		i, err := parseInt(val, 8)
+		if err != nil {
+			return "parse"
+		}
+		*v = int8(i)
+	case *int64:
+		i, err := parseInt(val, 64)
+		if err != nil {
+			return "parse"
+		}
+		*v = i
+	case *uint16:
+		i, err := parseUint(val, 16)
+		if err != nil {
+			return "parse"
+		}
+		*v = uint16(i)
+	case *float64:
+		f, err := strconv.ParseFloat(val, 64)
+		if err != nil {
+			return "parse"
+		}
+		*v = f
+	case *bool:
+		b, err := strconv.ParseBool(val)
+		if err != nil {
+			return "parse"
+		}
+		*v = b
+	case *time.Duration:
+		d, err := time.ParseDuration(val)
+		if err != nil {
+			return "parse"
+		}
+		*v = d
+	case *[]byte:
+		*v = []byte(val)
+	case *[]string:
+		parts := strings.Split(val, fs.delimiter)
+		out := make([]string, len(parts))
+		for i, s := range parts {
+			out[i] = strings.TrimSpace(s)
+		}
+		*v = out
+	case *[]int:
+		parts := strings.Split(val, fs.delimiter)
+		out := make([]int, len(parts))
+		for i, s := range parts {
+			s = strings.TrimSpace(s)
+			if s == "" {
+				continue
+			}
+			n, err := parseInt(s, 64)
+			if err != nil {
+				return "parse"
+			}
+			out[i] = int(n)
+		}
+		*v = out
+	case *map[string]int:
+		out := map[string]int{}
+		for _, item := range strings.Split(val, fs.delimiter) {
+			k, s, ok := strings.Cut(item, fs.separator)
+			if !ok {
+				return "mapItem"
+			}
+			k, s = strings.TrimSpace(k), strings.TrimSpace(s)
+			n := 0
+			if s != "" {
+				i, err := parseInt(s, 64)
+				if err != nil {
+					return "parse"
+				}
+				n = int(i)
+			}
+			out[k] = n
+		}
+		*v = out
+	case *map[int]string:
+		out := map[int]string{}
+		for _, item := range strings.Split(val, fs.delimiter) {
+			k, s, ok := strings.Cut(item, fs.separator)
+			if !ok {
+				return "mapItem"
+			}
+			k, s = strings.TrimSpace(k), strings.TrimSpace(s)
+			n := 0
+			if k != "" {
+				i, err := parseInt(k, 64)
+				if err != nil {
+					return "parse"
+				}
+				n = int(i)
+			}
+			out[n] = s
+		}
+		*v = out
+	}
+	return ""
+}
+
+// --------------------------------------------------------------------------- comparison
+
+// valueText is a field's value in the comparable form the checks carry, faithful to same:
+// time.Time by its instant (Equal), floats with NaN equal to NaN and -0 equal to 0, pointers
+// by nil-ness then target, structs by their exported fields (url.Userinfo, with none, is
+// "{}"), nil and empty slices and maps apart (DeepEqual tells them apart), maps by sorted
+// keys.
+func valueText(v reflect.Value) string {
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return "nil"
+		}
+		return "&" + valueText(v.Elem())
+	case reflect.Struct:
+		if t, ok := v.Interface().(time.Time); ok {
+			return t.UTC().Format(time.RFC3339Nano)
+		}
+		var parts []string
+		for i := 0; i < v.NumField(); i++ {
+			f := v.Type().Field(i)
+			if !f.IsExported() {
+				continue
+			}
+			parts = append(parts, f.Name+":"+valueText(v.Field(i)))
+		}
+		return "{" + strings.Join(parts, " ") + "}"
+	case reflect.Float64:
+		f := v.Float()
+		if f != f {
+			return "NaN"
+		}
+		if f == 0 {
+			return "0"
+		}
+		return strconv.FormatFloat(f, 'g', -1, 64)
+	case reflect.Slice:
+		if v.IsNil() {
+			return "nil"
+		}
+		parts := make([]string, v.Len())
+		for i := range parts {
+			parts[i] = valueText(v.Index(i))
+		}
+		return "[" + strings.Join(parts, " ") + "]"
+	case reflect.Map:
+		if v.IsNil() {
+			return "nil"
+		}
+		var parts []string
+		iter := v.MapRange()
+		for iter.Next() {
+			parts = append(parts, valueText(iter.Key())+":"+valueText(iter.Value()))
+		}
+		sort.Strings(parts)
+		return "map[" + strings.Join(parts, " ") + "]"
+	case reflect.String:
+		return strconv.Quote(v.String())
+	}
+	return fmt.Sprint(v.Interface())
+}
+
+// same compares two values field by field: time.Time by Equal, floats with NaN equal to NaN,
+// pointers by nil-ness then target, everything else by DeepEqual (diffCfg's comparison, for
+// the message of a failure).
+func same(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	switch a.Kind() {
+	case reflect.Pointer:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() == b.IsNil()
+		}
+		return same(a.Elem(), b.Elem())
+	case reflect.Struct:
+		if t, ok := a.Interface().(time.Time); ok {
+			return t.Equal(b.Interface().(time.Time))
+		}
+		for i := 0; i < a.NumField(); i++ {
+			if !a.Type().Field(i).IsExported() {
+				continue
+			}
+			if !same(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Float64:
+		x, y := a.Float(), b.Float()
+		if x != x && y != y {
+			return true
+		}
+		return x == y
+	}
+	return reflect.DeepEqual(a.Interface(), b.Interface())
+}
+
+// diffCfg lists the top-level fields where two configurations differ.
+func diffCfg(a, b *Cfg) []string {
+	var out []string
+	av, bv := reflect.ValueOf(a).Elem(), reflect.ValueOf(b).Elem()
+	for i := 0; i < av.NumField(); i++ {
+		if !av.Type().Field(i).IsExported() {
+			continue
+		}
+		if !same(av.Field(i), bv.Field(i)) {
+			out = append(out, av.Type().Field(i).Name)
+		}
+	}
+	return out
+}
+
+// errKind maps an error of the code under test to the model's kinds.
+func errKind(err error) string {
+	switch {
+	case errors.Is(err, envconfig.ErrMissingRequired):
+		return "missingRequired"
+	case errors.Is(err, envconfig.ErrRequiredAndDefault):
+		return "requiredAndDefault"
+	case errors.Is(err, envconfig.ErrInvalidMapItem):
+		return "mapItem"
+	case errors.Is(err, errMut):
+		return "mutator"
+	}
+	return "parse"
+}
+
+// errText is the error check's value for an error of the code under test: "none", or the
+// kind and the field path read off the message's leading "<Field>: " tokens (a top-level
+// field name, then a nested field name after In, PIn, PNo or An); a bare decoder error
+// (go-envconfig/9) has an empty path.
+func errText(err error) string {
+	if err == nil {
+		return "none"
+	}
+	return errKind(err) + " at " + errPath(err.Error())
+}
+
+var topNames, innerNames = func() (map[string]bool, map[string]bool) {
+	top, in := map[string]bool{}, map[string]bool{}
+	for _, s := range cfgSpecs {
+		top[s.name] = true
+	}
+	for _, s := range innerSpecs {
+		in[s.name] = true
+	}
+	in["A"] = true
+	return top, in
+}()
+
+func errPath(msg string) string {
+	first, rest, ok := strings.Cut(msg, ": ")
+	if !ok || !topNames[first] {
+		return ""
+	}
+	switch first {
+	case "In", "PIn", "PNo", "An":
+		if second, _, ok := strings.Cut(rest, ": "); ok && innerNames[second] {
+			return first + ": " + second
+		}
+	}
+	return first
+}
diff --git a/hegel_zoo_process_test.go b/hegel_zoo_process_test.go
new file mode 100644
index 0000000..3624a32
--- /dev/null
+++ b/hegel_zoo_process_test.go
@@ -0,0 +1,59 @@
+package envconfig_test
+
+// The wide property on Process: the library's outcome on a drawn case against the documented
+// model (processExpected with every switch off). The classifier names the shape of a recorded
+// bug from the model alone before the library is called; the library's values are computed
+// here under the judge (hzCall turns a panic into the check value "panic") and compared check
+// by check.
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sethvargo/go-envconfig"
+)
+
+// processActual asks the library the model's questions: ProcessWith on a fresh initial
+// struct built from the case, the error check and every field check; the struct the library
+// left is recorded on the case for the explanation of a failure.
+func processActual(c *processCase) checks {
+	got := checks{}
+	cfg := buildInitial(c.initial)
+	var err error
+	if p := hzCall(func() {
+		err = envconfig.ProcessWith(context.Background(), realConfig(cfg, envMap(*c), c.opts))
+	}); p != nil {
+		got.set("error", "panic")
+	} else {
+		got.set("error", errText(err))
+	}
+	stateFields(got, cfg, "")
+	c.got = cfg
+	return got
+}
+
+// commonShapes are the switches whose shapes are some fields of nearly every case: an unset
+// url.URL without noinit (go-envconfig/1, the field U) and an unset decoder field without
+// decodeunset (go-envconfig/2: Dec, B64, Hex, In.D, PIn.D, PNo.D). Under HEGEL_NO_KNOWN=1
+// their field checks are dropped from the case (judgeByDropping, counted) and the rest
+// judged; the other shapes are then not drawn (wideTune) or filtered out (withoutShapes over
+// the restricted check set).
+var commonShapes = []int{kURLUserMaterialized, kDecodersRunOnUnset}
+
+// TestHegelProcessFollowsTheDocs: ProcessWith on a fresh copy of the initial struct ends with
+// the model's error (kind and field path), or with no error and the model's field values
+// (time by Equal, NaN equal to NaN, pointers by nil-ness then target). The model is the
+// README and the godoc restated over the fixed struct Cfg; the lookup map is drawn over the
+// fifty keys at their presence from the per-kind pools, the Config with its four coins, four
+// booleans and zero to three mutators in a drawn order, the initial struct zero half the time
+// and otherwise with each of 26 fields pre-set at a quarter. By default the shape of every
+// recorded bug is drawn at its natural rate and the property fails naming the first in bug
+// order (go-envconfig/1 or 2 in most cases); under HEGEL_NO_KNOWN=1 the field checks of 1
+// and 2 are dropped, the alternatives that make 4, 5, 9, 10, 11 and 12 are at weight zero and
+// the relations that make 3, 6 and 7 are filtered out.
+func TestHegelProcessFollowsTheDocs(t *testing.T) {
+	cases := withoutShapes(pastSwitches(processExpected, commonShapes), processCases)
+	judged(t, cases, func(j *hzCaseJudge, c processCase) {
+		judgeByDropping(j, &c, processExpected, processActual, commonShapes)
+	})
+}
diff --git a/hegel_zoo_shapes_test.go b/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..da1d254
--- /dev/null
+++ b/hegel_zoo_shapes_test.go
@@ -0,0 +1,384 @@
+package envconfig_test
+
+// One narrow property per switched bug (bugs.toml), over the shape region of the bug: the
+// bug's ingredient forced on a case drawn as in the wide property (a restricted tune, a
+// splice on the drawn record), the case filtered by the classifier (regionOf: by default
+// the cases named that bug, under HEGEL_NO_KNOWN=1 the cases with no shape, the rejections
+// counted), judged by processExpected and the judge of the wide property. Each fails every
+// run by default naming its bug, and under HEGEL_NO_KNOWN=1 draws the region past the shape
+// (hzShaped) and passes. Because go-envconfig/1 (an unset U) and 2 (an unset decoder field)
+// are in nearly every case and sufficiency names the lower id first, every property from 3 on
+// is judged on the check set with the fields those two change dropped (pastSwitches; the
+// properties of 1 and 2 drop the other's), and the alternatives that make the other switched
+// shapes of a lower id are at weight zero in its tune (narrowTune, and per property); the
+// relations of 3, 6 and 7 that remain are what the region filter rejects.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowTune is the base of the narrow properties: the wide tune with the alternatives
+// that make the switched shapes of 4, 5, 9, 10, 11 and 12 at weight zero in both modes (the
+// DefaultRequired and DefaultDecodeUnset coins, the url and time additions, the bad and empty
+// time and the bad url values, the SUBS and SUBM keys, the fill mutator); each property then
+// forces its own ingredient and switches the rest on where its bug needs it.
+var narrowTune = wideTune.with(func(t *tune) {
+	t.required, t.decodeSet, t.subs = 0, 0, 0
+	t.urlTrig, t.timeTrig, t.badTime, t.badURL, t.emptyTime = 0, 0, 0, 0, 0
+	t.fill = 0
+})
+
+// narrow runs a narrow property for the bug id over its cases: judged on the check set with
+// the fields of the common shapes other than the bug's own dropped, filtered to the bug's
+// region.
+func narrow(t *testing.T, id string, cases hegel.Generator[processCase]) {
+	t.Helper()
+	narrowThrough(t, id, cases, func(c checks) checks { return c })
+}
+
+// narrowThrough is narrow with the check set of both sides seen through a projection: the
+// identity but for go-envconfig/11, whose property is judged through the error's kind alone
+// (its shape is an error the library does not raise; the error's path is what go-envconfig/9
+// changes, and sufficiency in bug order would name 9 on every case of the region).
+func narrowThrough(t *testing.T, id string, cases hegel.Generator[processCase], through func(checks) checks) {
+	t.Helper()
+	var others []int
+	for _, i := range commonShapes {
+		if hzKnownID(i) != id {
+			others = append(others, i)
+		}
+	}
+	past := pastSwitches(processExpected, others)
+	expected := func(c processCase, k known) checks { return through(past(c, k)) }
+	actual := func(c *processCase) checks { return through(processActual(c)) }
+	judged(t, regionOf(id, expected, cases), func(j *hzCaseJudge, c processCase) {
+		judgeBy(j, &c, expected, actual)
+	})
+}
+
+// errorKind is the check set with the error's path dropped: "<kind> at <path>" is "<kind>".
+func errorKind(c checks) checks {
+	out := checks{}
+	for name, v := range c {
+		out[name] = v
+	}
+	if v, ok := c["error"]; ok {
+		var kinds []string
+		for _, m := range hzMembers(v) {
+			kind, _, _ := strings.Cut(m, " at ")
+			kinds = append(kinds, kind)
+		}
+		out["error"] = hzSet(kinds...)
+	}
+	return out
+}
+
+// spliced is the cases of the tune with a drawn splice applied (a pure function of the
+// drawn case and the splice's own draws, applied on a copy).
+func spliced(t tune, splice hegel.Generator[func(processCase) processCase]) hegel.Generator[processCase] {
+	cases := casesOver(t)
+	return hegel.Composite(func(tc hegel.TestCase) processCase {
+		c := hegel.Draw(tc, cases)
+		return hegel.Draw(tc, splice)(c)
+	})
+}
+
+// okValue is a value of the kind from its ok pool.
+func okValue(kind string) hegel.Generator[string] { return evenHalves(valuePools[kind].ok...) }
+
+// --------------------------------------------------------------------------- go-envconfig/1
+
+// TestHegelUnsetURLFieldsStayZero: the shape region of go-envconfig/1 - the U key absent and
+// no noinit at either level (under HEGEL_NO_KNOWN=1 the U key present and the Config noinit
+// at its share), over the narrow tune (the other switched shapes off: an error elsewhere
+// ends the walk and hides the field) - through every check but the fields an unset decoder
+// field changes (go-envconfig/2, dropped). An unset url.URL field without noinit stays the
+// zero URL: its User pointer is not initialized and it prints as "". No bad value: an error
+// elsewhere ends the walk and hides the field.
+func TestHegelUnsetURLFieldsStayZero(t *testing.T) {
+	cases := casesOver(narrowTune.with(func(t *tune) {
+		t.keys["U"] = hzShaped(0, 100)
+		t.noInit = hzShaped(0, 20)
+		t.bad = 0
+	}))
+	narrow(t, "go-envconfig/1", cases)
+}
+
+// --------------------------------------------------------------------------- go-envconfig/2
+
+// TestHegelDecodersWaitForAValue: the shape region of go-envconfig/2 - no DefaultDecodeUnset
+// and at least one of the six decoder fields (Dec, B64, Hex, In.D, PIn.D, PNo.D) with its key
+// absent (the region filter; under HEGEL_NO_KNOWN=1 every decoder key present), over the
+// narrow tune - through every check but the field an unset U changes (go-envconfig/1,
+// dropped). A decoder of a non-struct type does not run on an unset variable without
+// decodeunset: a Decoder-typed string stays "", a Base64Bytes stays nil.
+func TestHegelDecodersWaitForAValue(t *testing.T) {
+	cases := casesOver(narrowTune.with(func(t *tune) {
+		for _, k := range []string{"DEC", "B64", "HEX", "IN_D", "PIN_D", "PNO_D"} {
+			t.keys[k] = hzShaped(keyPct(k), 100)
+		}
+		t.bad = 0
+	}))
+	narrow(t, "go-envconfig/2", cases)
+}
+
+// keyPct is the presence of a key in the wide population.
+func keyPct(key string) int {
+	for _, ks := range keySpecs {
+		if ks.key == key {
+			return ks.pct
+		}
+	}
+	return 0
+}
+
+// --------------------------------------------------------------------------- go-envconfig/3
+
+// overwritable are the fields a pre-set value and an empty variable under overwrite reach
+// go-envconfig/3 on: the built-in kinds with a pre-set choice (string, int, bool, *int,
+// *string, slices, maps, the Anon field), by pre index, key and kind. Left out: NoIn (noinit:
+// an empty variable leaves the field alone on both sides, processField returns first, the
+// README's accepted difference) and the decoder fields Dec, DecU, B64 and Hex (a decoder
+// RECEIVES the empty value under overwrite - "D-", an empty non-nil slice - on both sides).
+var overwritable = []struct {
+	pre  int
+	key  string
+	kind string
+}{
+	{pStr, "STR", "str"}, {pDef, "DEF", "str"}, {pI, "I", "int"}, {pB, "B", "bool"}, {pPtr, "PTR", "int"},
+	{pPStr, "PSTR", "str"}, {pStrs, "STRS", "strs"}, {pInts, "INTS", "ints"}, {pBytes, "BYTES", "bytes"},
+	{pM, "M", "map"}, {pM2, "M2", "map2"}, {pReq, "REQ", "str"}, {pOvr, "OVR", "str"}, {pOvrDef, "OVRDEF", "int"},
+	{pAnA, "A", "str"},
+}
+
+// TestHegelOverwriteAppliesEmptyValues: the shape region of go-envconfig/3 - one of the
+// fifteen overwritable fields pre-set, its variable provided empty (under HEGEL_NO_KNOWN=1
+// provided with a value of its kind), overwrite on by the field's tag (Ovr, OvrDef) or the
+// Config's DefaultOverwrite, no Config noinit - through every check but the fields of
+// go-envconfig/1 and 2. A provided empty variable is a value: with overwrite it replaces the
+// existing one, for every built-in kind.
+func TestHegelOverwriteAppliesEmptyValues(t *testing.T) {
+	which := rangeHalves(0, len(overwritable)-1)
+	splice := hegel.Composite(func(tc hegel.TestCase) func(processCase) processCase {
+		f := overwritable[hegel.Draw(tc, which)]
+		v := envValue{present: true}
+		if hzShaped(false, true) {
+			if f.kind == "map" {
+				v.m = &mapSpec{delim: -1, sep: -1, items: []mapItem{{key: 0, val: 0}}}
+			} else {
+				v.text = hegel.Draw(tc, okValue(f.kind))
+			}
+		}
+		return func(c processCase) processCase {
+			c = c.withPre(f.pre).withValue(f.key, v)
+			if f.key != "OVR" && f.key != "OVRDEF" {
+				c = c.withOpts(func(o *procOpts) { o.overwrite = true })
+			}
+			return c
+		}
+	})
+	narrow(t, "go-envconfig/3", spliced(narrowTune.with(func(t *tune) { t.noInit = 0; t.bad = 0 }), splice))
+}
+
+// --------------------------------------------------------------------------- go-envconfig/4
+
+// TestHegelDefaultRequiredAcceptsDefaults: the shape region of go-envconfig/4 -
+// DefaultRequired on (off under HEGEL_NO_KNOWN=1) with the STR key present, so that the walk
+// reaches Def, the first field with a default - through the error check (the walk ends
+// there). A Config-level required marks the fields without a default required; a field with
+// a default always has a value and is not an error.
+func TestHegelDefaultRequiredAcceptsDefaults(t *testing.T) {
+	cases := casesOver(narrowTune.with(func(t *tune) {
+		t.required = hzShaped(100, 0)
+		t.keys["STR"] = 100
+	}))
+	narrow(t, "go-envconfig/4", cases)
+}
+
+// --------------------------------------------------------------------------- go-envconfig/5
+
+// triggers are the url values a mutator acts on, with the mutator: the tilde mutator makes
+// "~http://a/b" the valid "http://a/b!" (unmutated it is a parse error, which go-envconfig/9
+// would also name; sufficiency names 5 first), the stop mutator makes "stop" "stopped", the
+// err mutator refuses "muterr", the legacy mutator doubles "Lx" to "LxL".
+var triggers = []struct{ name, value string }{
+	{"tilde", "~http://a/b"}, {"stop", "stop"}, {"err", "muterr"}, {"legacy", "Lx"},
+}
+
+// TestHegelMutatorsSeeStructFields: the shape region of go-envconfig/5 - mutators installed
+// with one of the four that act on a url value first in the chain, that value in U or PU
+// (under HEGEL_NO_KNOWN=1 a plain url value instead) - through every check but the fields of
+// go-envconfig/1 and 2. Mutators alter the looked-up value of a struct-typed decoder field
+// as of any other field.
+func TestHegelMutatorsSeeStructFields(t *testing.T) {
+	var byTrigger []hegel.Generator[processCase]
+	for _, tr := range triggers {
+		tr := tr
+		splice := hegel.Composite(func(tc hegel.TestCase) func(processCase) processCase {
+			key := hegel.Draw(tc, evenHalves("U", "PU"))
+			value := tr.value
+			if hzShaped(false, true) {
+				value = hegel.Draw(tc, okValue("url"))
+			}
+			return func(c processCase) processCase { return c.withEntry(key, value) }
+		})
+		byTrigger = append(byTrigger, spliced(narrowTune.with(func(t *tune) {
+			t.mutators, t.first = 100, tr.name
+		}), splice))
+	}
+	cases := hegel.FlatMap(rangeHalves(0, len(byTrigger)-1), func(i int) hegel.Generator[processCase] { return byTrigger[i] })
+	narrow(t, "go-envconfig/5", cases)
+}
+
+// --------------------------------------------------------------------------- go-envconfig/6
+
+// structPreset are the struct-typed decoder fields with a pre-set choice: T, U and PU.
+var structPreset = []struct {
+	pre  int
+	key  string
+	kind string
+}{{pT, "T", "time"}, {pU, "U", "url"}, {pPU, "PU", "url"}}
+
+// TestHegelStructDecodersKeepExistingValues: the shape region of go-envconfig/6 - T, U or PU
+// pre-set, its variable provided with a valid value, no overwrite (under HEGEL_NO_KNOWN=1
+// DefaultOverwrite on) - through every check but the fields of go-envconfig/1 and 2. An
+// existing non-zero value of a struct-typed decoder field is kept without overwrite, as any
+// other field's is.
+func TestHegelStructDecodersKeepExistingValues(t *testing.T) {
+	which := rangeHalves(0, len(structPreset)-1)
+	splice := hegel.Composite(func(tc hegel.TestCase) func(processCase) processCase {
+		f := structPreset[hegel.Draw(tc, which)]
+		value := hegel.Draw(tc, okValue(f.kind))
+		return func(c processCase) processCase { return c.withPre(f.pre).withEntry(f.key, value) }
+	})
+	narrow(t, "go-envconfig/6", spliced(narrowTune.with(func(t *tune) { t.overwrite = hzShaped(0, 100) }), splice))
+}
+
+// --------------------------------------------------------------------------- go-envconfig/7
+
+// actedOn is a value the named mutator acts on (the str kind).
+func actedOn(name string) string {
+	switch name {
+	case "tilde":
+		return "~abc"
+	case "stop":
+		return "stop"
+	case "err":
+		return "muterr"
+	case "fill":
+		return ""
+	}
+	return "L"
+}
+
+// TestHegelLegacyMutatorsContinueTheChain: the shape region of go-envconfig/7 - the legacy
+// mutator first in a chain of two or three, the STR key with a value the mutator after it
+// acts on (under HEGEL_NO_KNOWN=1 the legacy mutator last, the value one the first mutator
+// acts on) - through every check but the fields of go-envconfig/1 and 2. A LegacyMutatorFunc
+// has no say on the chain: the mutators after it run.
+func TestHegelLegacyMutatorsContinueTheChain(t *testing.T) {
+	splice := hegel.Just(func(c processCase) processCase {
+		next := c.opts.mutators[hzShaped(1, 0)]
+		return c.withEntry("STR", actedOn(next))
+	})
+	narrow(t, "go-envconfig/7", spliced(narrowTune.with(func(t *tune) {
+		t.mutators, t.minCount = 100, 2
+		t.first, t.last = hzShaped("legacy", ""), hzShaped("", "legacy")
+	}), splice))
+}
+
+// --------------------------------------------------------------------------- go-envconfig/9
+
+// badStruct are the values a struct-typed decoder field fails on: the bad pool and, for a
+// time, the empty value ("Time.UnmarshalBinary: no data").
+func badStruct(kind string) []string {
+	bad := append([]string(nil), valuePools[kind].bad...)
+	if kind == "time" {
+		bad = append(bad, "")
+	}
+	return bad
+}
+
+// TestHegelStructDecoderErrorsNameTheField: the shape region of go-envconfig/9 - T, U or PU
+// with a value its decoder refuses (under HEGEL_NO_KNOWN=1 a valid one), none of them
+// pre-set, no bad value elsewhere, so that the walk reaches it before any other error -
+// through the error check. A decoder error on a struct-typed field names the field as every
+// other error does.
+func TestHegelStructDecoderErrorsNameTheField(t *testing.T) {
+	which := rangeHalves(0, len(structPreset)-1)
+	splice := hegel.Composite(func(tc hegel.TestCase) func(processCase) processCase {
+		f := structPreset[hegel.Draw(tc, which)]
+		var value string
+		if hzShaped(true, false) {
+			value = hegel.Draw(tc, evenHalves(badStruct(f.kind)...))
+		} else {
+			value = hegel.Draw(tc, okValue(f.kind))
+		}
+		return func(c processCase) processCase { return c.withEntry(f.key, value) }
+	})
+	narrow(t, "go-envconfig/9", spliced(narrowTune.with(func(t *tune) { t.noPreStruct(); t.bad = 0 }), splice))
+}
+
+// --------------------------------------------------------------------------- go-envconfig/10
+
+// TestHegelUnsupportedElementKindsAreErrors: the shape region of go-envconfig/10 - the SUBS
+// and SUBM keys at 70 each (absent under HEGEL_NO_KNOWN=1), at least one with a non-empty
+// value (the region filter), no bad value and no pre-set struct decoder field, so that the
+// walk reaches the two last fields - through the error check. A struct without a decoder as
+// a slice or map element is an unsupported kind: an error, as an interface is.
+func TestHegelUnsupportedElementKindsAreErrors(t *testing.T) {
+	cases := casesOver(narrowTune.with(func(t *tune) {
+		t.subs = hzShaped(70, 0)
+		t.noPreStruct()
+		t.bad = 0
+	}))
+	narrow(t, "go-envconfig/10", cases)
+}
+
+// --------------------------------------------------------------------------- go-envconfig/11
+
+// TestHegelDecodeUnsetReachesNestedStructs: the shape region of go-envconfig/11 -
+// DefaultDecodeUnset on, the T key present (an unset top-level T would be go-envconfig/9's
+// error first), at least one of IN_T, PIN_T and PNO_T absent (all present under
+// HEGEL_NO_KNOWN=1), no bad value and no pre-set struct decoder field - through the error
+// check by its kind (the unset nested T is a decoding error; its path is go-envconfig/9's
+// matter). DefaultDecodeUnset is inherited by nested structs as the other five Config
+// defaults are.
+func TestHegelDecodeUnsetReachesNestedStructs(t *testing.T) {
+	cases := casesOver(narrowTune.with(func(t *tune) {
+		t.decodeSet = 100
+		t.keys["T"] = 100
+		for _, k := range []string{"IN_T", "PIN_T", "PNO_T"} {
+			t.keys[k] = hzShaped(35, 100)
+		}
+		t.noPreStruct()
+		t.bad = 0
+	}))
+	narrowThrough(t, "go-envconfig/11", cases, errorKind)
+}
+
+// --------------------------------------------------------------------------- go-envconfig/12
+
+// TestHegelMutatorsRunUnderDecodeUnset: the shape region of go-envconfig/12 -
+// DefaultDecodeUnset on, the fill mutator first in the chain (under HEGEL_NO_KNOWN=1 a chain
+// without it), the T keys present (an unset T would be go-envconfig/9's or 11's error first)
+// and at least one other field unset (the region filter; Str alone is unset half the time) -
+// through every check but the fields of go-envconfig/1 and 2. The Mutator doc: mutators are
+// called on defined values or when decodeunset is true, so under DefaultDecodeUnset every
+// unset field's empty value goes through the chain: the fill mutator makes it "filled", a
+// string takes it and an int fails to parse it, an error at the first unset int-like field.
+func TestHegelMutatorsRunUnderDecodeUnset(t *testing.T) {
+	cases := casesOver(narrowTune.with(func(t *tune) {
+		t.decodeSet = 100
+		t.mutators, t.fill, t.first = 100, hzShaped(1, 0), hzShaped("fill", "")
+		for _, k := range []string{"T", "IN_T", "PIN_T", "PNO_T"} {
+			t.keys[k] = 100
+		}
+		t.noPreStruct()
+		t.bad = 0
+	}))
+	narrow(t, "go-envconfig/12", cases)
+}
diff --git a/hegel_zoo_test.go b/hegel_zoo_test.go
new file mode 100644
index 0000000..653b2b0
--- /dev/null
+++ b/hegel_zoo_test.go
@@ -0,0 +1,1000 @@
+package envconfig_test
+
+// Hegel property tests for sethvargo/go-envconfig, written for the Hegel zoo.
+// See targets/go/go-envconfig/README.md.
+//
+// Oracle: the README's and the godoc's documented semantics (tags, tag options, Config
+// defaults, lookupers, mutators, decoders, the overwrite rules, initialization) restated as a
+// model over a fixed configuration struct (hegel_zoo_model_test.go): for a drawn lookup map,
+// Config and initial value, the model says which error (if any) ends the process and, when
+// none does, which fields end with which values. Parsing of scalars is strconv/time/net/url,
+// as the README lists the types.
+//
+// The files: hegel_zoo_idioms_test.go has the generator idioms (the weighted choices, the
+// fair-bit dice, the halving helpers); this file the harness (hzOpts, hzProperty, the
+// collector, the known value, the judge, the classifier); hegel_zoo_model_test.go the
+// configuration struct, the specs, the mutators, the model processExpected with the switch set
+// threaded, the field helpers and the comparison; hegel_zoo_cases_test.go the case records,
+// their generators and the pure builders; hegel_zoo_process_test.go the wide property on
+// Process; hegel_zoo_lookupers_test.go the lookuper tree and its property;
+// hegel_zoo_shapes_test.go one narrow property per switched bug; hegel_pins_test.go the pins.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES, HEGEL_SEED
+// and HEGEL_VERBOSE are passed through hzOpts; a panic in the code under test is turned into
+// the check value "panic" by hzCall in the property (judged like any other value) and, as the
+// net under everything else, into a failure naming the shape by the judge's Recover.
+// HEGEL_COLLECT=1 (or ZOO_COLLECT=1) makes the properties record their mismatches instead of
+// failing and print the counts. The model states the documented behaviour (every switch of
+// the known value below off) and the properties judge the library against it; the shape of a
+// recorded bug is named by the classifier shapeBy, which runs the model per switch on the case
+// record before the library is called, fails by default "(the shape of go-envconfig/N)", and
+// under HEGEL_NO_KNOWN=1 the shapes are not drawn (a weight of zero: the DefaultRequired and
+// DefaultDecodeUnset coins, the SUBS/SUBM keys, the mutator-triggering url and time values,
+// the bad and empty time values, the fill mutator), filtered out (hzOnly on the classifier:
+// an empty value on a pre-set field under overwrite, a pre-set struct decoder field with its
+// variable set, the legacy mutator before another) or the checks they cover are dropped from
+// the case (judgeByDropping: the fields an unset url.URL and the unset decoder fields change,
+// go-envconfig/1 and 2, which nearly every case has), and in the narrow properties the region
+// past the shape is drawn (hzShaped, regionOf), so that a run looks past the known bugs.
+// go-envconfig/8 is a documentation bug (the README's own example comment contradicts the
+// README's general rule, which the code's comment states and the model follows): a property
+// cannot draw a contradiction in the documentation, so it stays pin only and its switch index
+// is reserved and read by nothing. The tests never touch the process environment (a
+// MapLookuper is always given).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hzOpts passes HEGEL_TEST_CASES, HEGEL_SEED and HEGEL_VERBOSE through to the engine, which
+// reads no environment variable itself (the seed is for the rate measurements of the probe
+// and the collector), and asks for one failure per run for the shrink budget.
+func hzOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	if hzShrinkBudget > 0 {
+		// The shrink budget: one failure per run (the engine otherwise generates on while
+		// the cases fail, ten times the count on a property that always fails, and its
+		// re-run of the failures before shrinking would meet a rejected attempt and end the
+		// run as "flaky" with nothing printed).
+		opts = append(opts, hegel.WithReportMultipleFailures(false))
+	}
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize ... go/gotext judge).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("HEGEL_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+	fails  int  // failing judgements so far (the shrink budget)
+	budget int  // the failing judgements allowed, set at the first failure
+	armed  bool // past the budget: reject the next attempt before it draws
+	cycles int  // the attempts so rejected
+}
+
+// hzShrinkBudget bounds the shrinking of a failure: the engine (hegel-go v0.6.33 over
+// libhegel) keeps every attempt of a shrink in memory and has no budget for it (go/mergo
+// measured 1.6 GB and 65 s for a shrink of a case of 3000 draws in a module of its own, more
+// inside a test binary). A case here is some hundreds of draws (the probe counts them) and
+// the model and the library are cheap, so the budget is rarely reached; it is kept from the
+// gotext harness as it is: after a budget of failing judgements the next attempt is rejected
+// before its first draw (Assume: counted "budget skipped"), which ends the shrink: the engine
+// ends a shrink at an attempt rejected before it drew, then replays the last failing attempt
+// exactly for its report ("budget replayed", printed as usual). Were the engine to shrink on
+// past the undrawn rejection, the drawn attempt that fails arms the next undrawn rejection,
+// and after hzShrinkCycles such cycles every attempt is rejected undrawn and the run ends
+// without a message ("budget exhausted"). The budget is hzShrinkBudget bytes of the first
+// failure's message: the attempts allowed are the bytes over the message's length, between
+// 100 and 3000. HEGEL_SHRINK_BUDGET sets the bytes, 0 for no budget. Collect mode records
+// every failure and never shrinks.
+var hzShrinkBudget = func() int {
+	if s := os.Getenv("HEGEL_SHRINK_BUDGET"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v >= 0 {
+			return v
+		}
+	}
+	return 400000
+}()
+
+// hzShrinkCycles bounds the alternation past the budget.
+const hzShrinkCycles = 100
+
+// hzShrinkAttempts is the failing judgements the budget allows for a first failure of n
+// bytes.
+func hzShrinkAttempts(n int) int {
+	if n < 1 {
+		n = 1
+	}
+	b := hzShrinkBudget / n
+	if b < 100 {
+		return 100
+	}
+	if b > 3000 {
+		return 3000
+	}
+	return b
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// observe records a message of a class that is not a failure (a replica disagreement):
+// counted, and its first two messages kept.
+func (c *hzCollector) observe(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept; otherwise it is fatal, within the shrink budget.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	c.mu.Lock()
+	if c.fails == 0 && hzShrinkBudget > 0 {
+		c.budget = hzShrinkAttempts(len(msg))
+	}
+	if c.budget > 0 && c.fails >= c.budget {
+		// past the budget: the attempt that drew is the engine's replay of the last failure
+		// (the undrawn rejection before it ended the shrink) and prints as usual; were it a
+		// shrink attempt instead, the next attempt is rejected before drawing again
+		c.armed = true
+		c.counts["budget replayed"]++
+		c.mu.Unlock()
+		ht.Fatalf("%s", msg)
+	}
+	c.fails++
+	if c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+	ht.Fatalf("%s", msg)
+}
+
+// skip is whether the attempt is to be rejected before it draws (the budget spent and the
+// previous attempt drawn); past hzShrinkCycles, always.
+func (c *hzCollector) skip() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.budget == 0 || c.fails < c.budget {
+		return false
+	}
+	if c.cycles >= hzShrinkCycles {
+		c.counts["budget exhausted"]++
+		return true
+	}
+	if !c.armed {
+		return false
+	}
+	c.armed = false
+	c.cycles++
+	c.counts["budget skipped"]++
+	return true
+}
+
+// rearm: an attempt past the budget that drew and did not fail arms the next.
+func (c *hzCollector) rearm() {
+	c.mu.Lock()
+	if c.budget > 0 && c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml), indexed by the constants below (the index of a switch
+// is the bug's id minus one: hzKnownID(i) = "go-envconfig/<i+1>"). The model processExpected
+// (hegel_zoo_model_test.go) is a pure function of (case, known): with every switch off
+// (hzKnownNone) it states the documented behaviour and is what the properties judge the
+// library against; with a switch on it reproduces that bug as a replica of the library's rule,
+// transcribed from envconfig.go, decoding.go and mutator.go at the lines named beside the
+// switch. The classifier runs the model with several sets to name the shape of a case before
+// the library is called; the pins assert the documented behaviour and fail while the bug
+// exists.
+type known [12]bool
+
+const (
+	// go-envconfig/1: an unset url.URL field is not left zero: its User pointer is initialized
+	// and it prints as //@ (processWith's "Special case handle structs" :508-554 walks a
+	// struct-typed field whose variable is unset as a nested struct, and the pointer loop
+	// :478-506 materializes the nil *Userinfo of url.URL as a detached chain that setNilStruct
+	// :454-465 attaches unless noInit: "deeply initialize all fields", Config.DefaultNoInit's
+	// doc :283-286)
+	kURLUserMaterialized = 0
+	// go-envconfig/2: decoders of non-struct types run on unset variables without decodeunset
+	// (processField :927 "processAsDecoder(ctx, v, ef)" with the looked-up value, the empty
+	// string when unset, before any check of v; the struct path alone tests "found ||
+	// usedDefault || decodeUnset" :523)
+	kDecodersRunOnUnset = 1
+	// go-envconfig/3: overwrite does not apply an empty value, the existing value stays
+	// (processField :935-937 "if v == \"\" { return nil }" before the kind switch sets anything;
+	// a decoder-typed field receives the empty value :927 before that line)
+	kOverwriteEmptyKeeps = 2
+	// go-envconfig/4: DefaultRequired turns every field with a default into an
+	// ErrRequiredAndDefault error (processWith :450 "required := structRequired ||
+	// opts.Required" handed to lookup :518/:573, whose :759-762 refuses required with a default)
+	kDefaultRequiredRejectsDefaults = 3
+	// go-envconfig/5: mutators are not applied to struct-typed fields decoded by a decoder
+	// (the mutator loop :585-606 sits in the non-struct path, after the struct path :508-554
+	// has decoded and continued)
+	kMutatorsSkipStructs = 4
+	// go-envconfig/6: struct-typed decoder fields are decoded over an existing non-zero value
+	// without overwrite (the struct path :523-531 decodes whenever found, usedDefault or
+	// decodeUnset; the overwrite rules :567-583 are in the non-struct path alone)
+	kStructDecoderIgnoresOverwrite = 5
+	// go-envconfig/7: LegacyMutatorFunc stops the mutator chain after itself (mutator.go :74
+	// "return v, true, err")
+	kLegacyMutatorStops = 6
+	// go-envconfig/8: the README's escaped-backslash default example does not give the value
+	// it shows: a documentation bug, pin only (the model follows the README's general rule and
+	// the code's comment at lookup :782-786; a property cannot draw a contradiction in the
+	// documentation); this index is reserved and read by nothing
+	kReadmeBackslashExample = 7
+	// go-envconfig/9: a decoder error on a struct-typed field is not prefixed with the field
+	// name (the struct path :525-527 "if err != nil { return err }" bare; every other error is
+	// wrapped "%s: %w" with the field's name)
+	kStructDecoderErrorUnprefixed = 8
+	// go-envconfig/10: unsupported element and field kinds decode silently to zero values
+	// (processField's kind switch :939-1026 has no default case: a struct element without a
+	// decoder of a slice :1020 or a map :1002 falls through to "return nil" :1028)
+	kUnsupportedKindsSilent = 9
+	// go-envconfig/11: DefaultDecodeUnset is not inherited by nested structs (the recursion
+	// :539-548 builds the nested Config with DefaultDelimiter, DefaultSeparator, DefaultNoInit,
+	// DefaultOverwrite and DefaultRequired and without DefaultDecodeUnset; nor does the field's
+	// own decodeunset :449 reach it)
+	kDecodeUnsetNotInherited = 10
+	// go-envconfig/12: mutators are not called on unset variables under decodeunset, although
+	// the Mutator doc says they are (mutator.go :24 "Mutators are only called on defined values
+	// (or when decodeunset is true)"; processWith :588 "if len(mutators) > 0 && (found ||
+	// usedDefault)", its comment :585-587 "we don't call mutators when the environment variable
+	// was not set"; the struct path has no mutator loop at all, go-envconfig/5)
+	kMutatorsSkipUnset = 11
+	hzKnownCount       = 12
+)
+
+// hzKnownRead are the switches the model reads, in bug order: the classifier sweeps these
+// (kReadmeBackslashExample is read by nothing).
+var hzKnownRead = []int{kURLUserMaterialized, kDecodersRunOnUnset, kOverwriteEmptyKeeps, kDefaultRequiredRejectsDefaults,
+	kMutatorsSkipStructs, kStructDecoderIgnoresOverwrite, kLegacyMutatorStops, kStructDecoderErrorUnprefixed,
+	kUnsupportedKindsSilent, kDecodeUnsetNotInherited, kMutatorsSkipUnset}
+
+// hzKnownID is the bug id of a switch ("go-envconfig/N"); hzKnownIndex the switch of a bug id
+// (-1 for none or the hole).
+func hzKnownID(i int) string { return "go-envconfig/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "go-envconfig/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for _, i := range hzKnownRead {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape
+// go-envconfig/N" per case), the rule of the classifier that named them ("shape via
+// sufficiency", "shape via necessity", "shape via hole", the latter two with the id), the
+// cases skipped for them under HEGEL_NO_KNOWN=1 ("known go-envconfig/N"), the cases whose
+// checks were dropped ("dropped go-envconfig/N") and the checks ("dropped check <name>"), the
+// draws the filters rejected ("filtered <name>"), the replica's agreement with the library on
+// the shaped cases ("replica agreement", "replica disagreement"), the properties' own tallies
+// of what their cases reached (the rates of the report), and the cases assumed away for an
+// unrecorded candidate bug ("candidate/go/go-envconfig-N"); printed and reset by the
+// collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize ... go/gotext judge, with the
+// collector's mismatch classes): it names the recorded bug whose shape the case has, so that
+// a mismatch or a library panic fails "(the shape of go-envconfig/N)", and under
+// HEGEL_NO_KNOWN=1 skips the case instead (counted as known) or drops the checks the shape
+// covers (Dropped). The wide and the narrow properties share their judge functions and so
+// this. The classifier that names the shape is computed from the case record alone (the
+// model run with several sets of switches).
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the regions past the shapes
+// are drawn, or the shaped cases filtered out), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped go-envconfig/N") and the case goes on
+// (judgeByDropping: the wide property, whose shapes go-envconfig/1 and 2 are some fields of
+// nearly every case).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow). The properties call the library through hzCall, which
+// turns its panic into the check value "panic" judged like any other value; this is the net
+// under everything else.
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	if !hzCollecting {
+		// The narrow properties fail by design and each shrinks its failure; run them two at
+		// a time (go test's -parallel, the CPU count). In collect mode they run one after the
+		// other, the judge's counters being global.
+		t.Parallel()
+	}
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		if col.skip() {
+			ht.Assume(false)
+		}
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+		col.rearm()
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (the go/carbon ... go/gotext form: every value here is text; a model states a set
+// of acceptable values per check and the library's value agrees by membership).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole map for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two. Every value is a set of strings spelled
+// `{"a" | "b"}` (hzSet: the members quoted, sorted, unique); the library's is a set of one
+// (hzValue). The checks of this target are named in the model file: "error" (none, or the
+// kind and the field path), "field <Name>" for every exported top-level field of Cfg and
+// "field <Name>.<Sub>" for the fields of the nested Inner structs, "lookup <key>" for the
+// lookuper tree.
+type checks map[string]string
+
+// hzSet spells a set of acceptable values; hzValue a set of one.
+func hzSet(vals ...string) string {
+	sort.Strings(vals)
+	var parts []string
+	for i, v := range vals {
+		if i > 0 && v == vals[i-1] {
+			continue
+		}
+		parts = append(parts, strconv.Quote(v))
+	}
+	return "{" + strings.Join(parts, " | ") + "}"
+}
+
+func hzValue(v any) string { return hzSet(fmt.Sprint(v)) }
+
+// hzMembers reads a set back (a value that is not a set is a set of itself).
+func hzMembers(s string) []string {
+	if !strings.HasPrefix(s, "{") || !strings.HasSuffix(s, "}") {
+		return []string{s}
+	}
+	rest := s[1 : len(s)-1]
+	var out []string
+	for rest != "" {
+		q, err := strconv.QuotedPrefix(rest)
+		if err != nil {
+			return []string{s}
+		}
+		v, _ := strconv.Unquote(q)
+		out = append(out, v)
+		rest = strings.TrimPrefix(rest[len(q):], " | ")
+	}
+	return out
+}
+
+func (c checks) set(name string, v any) { c[name] = hzValue(v) }
+
+// checkRank is the order the checks of a case are reported in when it fails (and the first
+// differing one classes the failure): the error first, then the fields in struct order (the
+// model file fills it from the specs), the rest by name.
+var checkRank = map[string]int{"error": 0}
+
+func checkLess(a, b string) bool {
+	ar, aok := checkRank[a]
+	br, bok := checkRank[b]
+	if !aok {
+		ar = 1000
+	}
+	if !bok {
+		br = 1000
+	}
+	if ar != br {
+		return ar < br
+	}
+	return a < b
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two model statements agree: the same checks, each value equal
+// (the classifier's comparison; the sets are spelled canonically).
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeValue reports whether the library's value of a check agrees with a model's: every
+// member of the library's set is a member of the model's.
+func agreeValue(name, got, want string) bool {
+	if got == want {
+		return true
+	}
+	ws := hzMembers(want)
+	for _, g := range hzMembers(got) {
+		found := false
+		for _, w := range ws {
+			if g == w {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeChecks reports whether the library's values agree with a model's: the same checks,
+// each by agreeValue.
+func agreeChecks(got, want checks) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for k, v := range want {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, v) {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order; the long values are cut, the explanation of a case shows the difference.
+func diffChecks(a, b checks) string {
+	var parts []string
+	cut := func(s string) string {
+		if len(s) > 300 {
+			return s[:300] + "..."
+		}
+		return s
+	}
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || !agreeValue(k, a[k], w) {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, cut(a[k])))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, cut(a[k]), cut(w)))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, cut(b[k])))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("go-envconfig/?", a defect of the
+// model). The order matters where two shapes meet (an unset url.URL and an unset decoder field
+// in most cases, 1 before 2; an unmutated "~http://a/b" fails to parse unprefixed, 5 before
+// 9): sufficiency in bug order names the lower id. The first error ends the walk, so a shape
+// that would show in a later field is hidden by an earlier error (the documented behaviour:
+// Process returns its first error), and the expected values are then equal with and without
+// the switch.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "go-envconfig/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule; in collect mode
+// also every switch that alone moves the model ("sufficient go-envconfig/N": the overlaps).
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+		if rule != "sufficiency" {
+			hzTally("shape via " + rule + " " + shape)
+		}
+		if hzCollecting {
+			none := expected(c, hzKnownNone)
+			var ids []string
+			for _, i := range hzKnownRead {
+				if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+					hzTally("sufficient " + hzKnownID(i))
+					ids = append(ids, hzKnownID(i))
+				}
+			}
+			if len(ids) > 1 {
+				hzTally("sufficient together " + strings.Join(ids, "+"))
+			}
+		}
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// classOf is the collector class of a check name: the whole name here (the checks are few
+// and short: "error", "field U", "field In.D", "lookup A").
+func classOf(name string) string { return name }
+
+// explainer is a case record that explains a failure in its own terms (the fields that
+// differ, the two structs); the verdict appends it.
+type explainer interface {
+	explain(got, want checks) string
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agreeChecks(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.observe("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if agreeChecks(got, want) {
+		if shape != "" {
+			// named by the classifier but passing: the replica's sets differ from the
+			// documented ones on checks where the library's one value is in both
+			hzTally("shaped pass")
+			j.col.observe("shaped pass", "%s against %s for\n%#v", diffChecks(expected(c, hzKnownAll), want), shape, c)
+		}
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, want[k]) {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	more := ""
+	if e, ok := any(c).(explainer); ok {
+		more = e.explain(got, want)
+	}
+	j.Fail(classOf(class), "%s for\n%#v%s", diffChecks(got, want), c, more)
+}
+
+// memoized is expected remembering its statements by switch set for one case (the
+// classifier and the verdict ask for the documented and the full replica statements more
+// than once; a known value is a comparable array).
+func memoized[T any](expected func(T, known) checks) func(T, known) checks {
+	memo := map[known]checks{}
+	return func(c T, k known) checks {
+		if out, ok := memo[k]; ok {
+			return out
+		}
+		out := expected(c, k)
+		memo[k] = out
+		return out
+	}
+}
+
+// judgeBy is the judge of a family: the shape first, then the library (the case is one
+// shape, skipped whole under HEGEL_NO_KNOWN=1 where the generators let one through). The
+// case is passed by pointer: actual records on it what the library left (the explanation of
+// a failure).
+func judgeBy[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks) {
+	expected = memoized(expected)
+	got, want := actual(c), expected(*c, hzKnownNone)
+	if documented(got, want) {
+		return
+	}
+	shape := classify(*c, expected)
+	j.Shape(shape)
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// documented reports, by default and outside collect mode, that the library's values are
+// the documented ones: the case passes and there is no shape to name, so the classifier
+// (several model runs) is not run; under HEGEL_NO_KNOWN=1 the shape is needed first (a case
+// is skipped or its checks dropped before the comparison), and in collect mode the counts
+// are. The shrinking of a failure replays mostly passing cases, which this keeps cheap.
+func documented(got, want checks) bool {
+	return !hzNoKnown && !hzCollecting && agreeChecks(restrict(got, want), want)
+}
+
+// droppedChecks is the set of checks the switches ids change on their own: the checks on
+// which expected(c, only id) differs from expected(c, none), by name, with the first id that
+// changes it (the error check is never dropped: it is kept whatever the switches say of it).
+func droppedChecks[T any](c T, expected func(T, known) checks, ids []int) map[string]int {
+	none := expected(c, hzKnownNone)
+	out := map[string]int{}
+	for _, i := range ids {
+		only := expected(c, hzKnownOnly(i))
+		for name, v := range none {
+			if name == "error" {
+				continue
+			}
+			if w, ok := only[name]; !ok || w != v {
+				if _, done := out[name]; !done {
+					out[name] = i
+				}
+			}
+		}
+		for name := range only {
+			if _, ok := none[name]; !ok && name != "error" {
+				if _, done := out[name]; !done {
+					out[name] = i
+				}
+			}
+		}
+	}
+	return out
+}
+
+// pastSwitches is the model over the checks the switches ids do not change on their own (the
+// restricted check set): the wide property's view under HEGEL_NO_KNOWN=1, where the fields an
+// unset url.URL (go-envconfig/1) and the unset decoder fields (go-envconfig/2) change are
+// dropped, and the narrow properties' view in both modes, where the other of the two is
+// dropped so that the property is judged on its own bug.
+func pastSwitches[T any](expected func(T, known) checks, ids []int) func(T, known) checks {
+	return func(c T, k known) checks {
+		drop := droppedChecks(c, expected, ids)
+		out := checks{}
+		for name, v := range expected(c, k) {
+			if _, gone := drop[name]; !gone {
+				out[name] = v
+			}
+		}
+		return out
+	}
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi, go/go-debian, go/roaring, go/gotext form; the wide
+// property here): by default the shape is named and every check judged; under
+// HEGEL_NO_KNOWN=1 the checks the switches drops change on their own (droppedChecks: the
+// fields an unset url.URL and the unset decoder fields change) are dropped from the case
+// (hzCaseJudge.Dropped, counted "dropped go-envconfig/N" per switch and "dropped check
+// <name>"), the rest classified again and judged, the case not skipped unless a shape
+// remains (the generator filters those out).
+func judgeByDropping[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks, drops []int) {
+	expected = memoized(expected)
+	got, want := actual(c), expected(*c, hzKnownNone)
+	if documented(got, want) {
+		return
+	}
+	if hzNoKnown {
+		drop := droppedChecks(*c, expected, drops)
+		if len(drop) > 0 {
+			seen := map[int]bool{}
+			for name, i := range drop {
+				if !seen[i] {
+					seen[i] = true
+					j.Dropped(hzKnownID(i))
+				}
+				hzTally("dropped check " + classOf(name))
+				delete(want, name)
+			}
+			hzTally("dropped case")
+		}
+		past := memoized(pastSwitches(expected, drops))
+		shape := classify(*c, past)
+		j.Shape(shape)
+		verdict(j, *c, got, want, shape, past)
+		return
+	}
+	shape := classify(*c, expected)
+	j.Shape(shape)
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few model runs. The
+// rejections are also counted by the shape the case had ("filtered <id> as <shape>", "as
+// none" for no shape), which says what the surroundings bring in.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool {
+		got := shapeID(c, expected)
+		if got == want {
+			return true
+		}
+		if got == "" {
+			got = "none"
+		}
+		hzTally("filtered " + id + " as " + got)
+		return false
+	})
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered go-envconfig/N" by the shape it had), g itself
+// otherwise: the wide property's filter over the restricted check set (pastSwitches), after
+// the shapes a weight of zero has switched off.
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCall runs a library call and returns what it panicked with (nil when it returned): the
+// properties turn it into the check value "panic".
+func hzCall(f func()) (panicked any) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	f()
+	return nil
+}
