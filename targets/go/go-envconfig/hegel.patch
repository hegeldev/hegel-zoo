+// clone copies a Cfg deeply enough for the two sides not to share pointers.
+func clone(c *Cfg) *Cfg {
+	d := *c
+	if c.PU != nil {
+		u := *c.PU
+		d.PU = &u
+	}
+	if c.Ptr != nil {
+		v := *c.Ptr
+		d.Ptr = &v
+	}
+	if c.PStr != nil {
+		v := *c.PStr
+		d.PStr = &v
+	}
+	if c.NoIn != nil {
+		v := *c.NoIn
+		d.NoIn = &v
+	}
+	if c.PIn != nil {
+		v := *c.PIn
+		d.PIn = &v
+	}
+	if c.PNo != nil {
+		v := *c.PNo
+		d.PNo = &v
+	}
+	d.Strs = append([]string(nil), c.Strs...)
+	d.Ints = append([]int(nil), c.Ints...)
+	d.Bytes = append([]byte(nil), c.Bytes...)
+	d.B64 = append(envconfig.Base64Bytes(nil), c.B64...)
+	d.Hex = append(envconfig.HexBytes(nil), c.Hex...)
+	if c.M != nil {
+		d.M = map[string]int{}
+		for k, v := range c.M {
+			d.M[k] = v
+		}
+	}
+	if c.M2 != nil {
+		d.M2 = map[int]string{}
+		for k, v := range c.M2 {
+			d.M2[k] = v
+		}
+	}
+	return &d
+}
+
+func realConfig(target *Cfg, e map[string]string, o modelCfg) *envconfig.Config {
+	var l envconfig.Lookuper = envconfig.MapLookuper(e)
+	if o.prefix != "" {
+		l = envconfig.PrefixLookuper(o.prefix, l)
+	}
+	c := &envconfig.Config{
+		Target:             target,
+		Lookuper:           l,
+		DefaultDelimiter:   o.delimiter,
+		DefaultSeparator:   o.separator,
+		DefaultNoInit:      o.noInit,
+		DefaultOverwrite:   o.overwrite,
+		DefaultDecodeUnset: o.decodeSet,
+		DefaultRequired:    o.required,
+	}
+	for _, m := range o.mutators {
+		c.Mutators = append(c.Mutators, realMutator(m))
+	}
+	return c
+}
+
+func describe(e map[string]string, o modelCfg, initial *Cfg) string {
+	return fmt.Sprintf("env %v\nconfig %+v\ninitial %+v", e, o, *initial)
+}
