+package period_test
+
+// Pins: one plain test per recorded bug, asserting the documented behaviour. Each fails while
+// its bug exists (target.toml lists them as expected failures).
+
+import (
+	"testing"
+	"time"
+
+	"github.com/govalues/decimal"
+	"github.com/rickb777/period"
+)
+
+// period/1: "P0" is listed among the zero forms in the godoc of Parse.
+func TestHegelPinParseAcceptsP0(t *testing.T) {
+	p, err := period.Parse("P0")
+	if err != nil || !p.IsZero() {
+		t.Fatalf("Parse(\"P0\") = %v, %v; the godoc lists P0 among the zero forms", p, err)
+	}
+}
+
+// period/2: ISO-8601 (and the godoc's "using ISO-8601 rules") fixes the order of the fields.
+func TestHegelPinDesignatorsMustBeOrdered(t *testing.T) {
+	for _, s := range []string{"P1D1Y", "PT1S1H", "P1W1M", "P1DT1S1M"} {
+		if p, err := period.Parse(s); err == nil {
+			t.Errorf("Parse(%q) = %v, want an error: the designators are out of order", s, p)
+		}
+	}
+}
+
+// period/3: a 'T' must introduce a time component.
+func TestHegelPinTrailingTRejected(t *testing.T) {
+	for _, s := range []string{"P1YT", "P1DT", "-P1WT"} {
+		if p, err := period.Parse(s); err == nil {
+			t.Errorf("Parse(%q) = %v, want an error: nothing follows the T", s, p)
+		}
+	}
+}
+
+// period/4: a decimal mark needs digits on both sides.
+func TestHegelPinBareDecimalMarkRejected(t *testing.T) {
+	for _, s := range []string{"P.5Y", "P1.Y", "PT,5S", "P1,D"} {
+		if p, err := period.Parse(s); err == nil {
+			t.Errorf("Parse(%q) = %v, want an error", s, p)
+		}
+	}
+}
+
+// period/5: a fraction with only zero digits is a whole number: "P1.0Y" is one year, added
+// with AddDate and precise like "P1Y", and "P1.0Y1D" is a valid period.
+func TestHegelPinZeroFractionIsWhole(t *testing.T) {
+	a := period.MustParse("P1.0Y")
+	b := period.MustParse("P1Y")
+	tm := time.Date(2024, 1, 31, 0, 0, 0, 0, time.UTC)
+	ta, oka := a.AddTo(tm)
+	tb, okb := b.AddTo(tm)
+	if !ta.Equal(tb) || oka != okb {
+		t.Errorf("P1.0Y.AddTo = %v, %v; P1Y.AddTo = %v, %v", ta, oka, tb, okb)
+	}
+	if a != b {
+		t.Errorf("Parse(\"P1.0Y\") = %v differs from Parse(\"P1Y\") = %v", a, b)
+	}
+	for _, s := range []string{"P1.0Y1D", "P0.0Y1D", "PT1.00H30M"} {
+		if _, err := period.Parse(s); err != nil {
+			t.Errorf("Parse(%q): %v; the fraction is zero", s, err)
+		}
+	}
+}
+
+// period/6: NormaliseDaysToYears must produce a period the package itself accepts.
+func TestHegelPinNormaliseDaysToYearsStaysValid(t *testing.T) {
+	for _, s := range []string{"P366DT1H", "P400DT30M", "P60WT1S"} {
+		n := period.MustParse(s).NormaliseDaysToYears()
+		if _, err := period.Parse(n.String()); err != nil {
+			t.Errorf("%s.NormaliseDaysToYears() = %s, which Parse rejects: %v", s, n, err)
+		}
+	}
+}
+
+// period/7: Add and Mul must produce periods the package itself accepts (or report an error).
+func TestHegelPinArithmeticKeepsOneFraction(t *testing.T) {
+	f := decimal.MustParse("1.5")
+	if m, err := period.MustParse("P1Y1M").Mul(f); err == nil {
+		if _, perr := period.Parse(m.String()); perr != nil {
+			t.Errorf("P1Y1M * 1.5 = %s, which Parse rejects: %v", m, perr)
+		}
+	}
+	if s, err := period.MustParse("P1.5Y").Add(period.MustParse("P1M")); err == nil {
+		if _, perr := period.Parse(s.String()); perr != nil {
+			t.Errorf("P1.5Y + P1M = %s, which Parse rejects: %v", s, perr)
+		}
+	}
+}
+
+// period/8: a duration that does not fit time.Duration cannot be reported precise, nor
+// wrap to a negative value.
+func TestHegelPinDurationOverflowNotPrecise(t *testing.T) {
+	for _, s := range []string{"PT3000000H", "PT200000000M", "PT10000000000S"} {
+		d, precise := period.MustParse(s).Duration()
+		if d < 0 || precise {
+			t.Errorf("%s.Duration() = %v, precise %v: the value overflows time.Duration", s, d, precise)
+		}
+	}
+}
+
+// period/9: Format writes the numbers as decimals, not in floating-point notation.
+func TestHegelPinFormatWritesPlainNumbers(t *testing.T) {
+	cases := map[string]string{
+		"P1000000Y":            "1000000 years",
+		"P123456789.5D":        "123456789.5 days",
+		"PT0.00001S":           "0.00001 second",
+		"P1234567890123456789D": "1234567890123456789 days",
+	}
+	for s, want := range cases {
+		if got := period.MustParse(s).Format(); got != want {
+			t.Errorf("%s.Format() = %q, want %q", s, got, want)
+		}
+	}
+}
+
+// period/10: "whole multiples of 24 hours are also included": 48.5 hours hold two days.
+func TestHegelPinTotalDaysCountsWholeDaysOfFractionalHours(t *testing.T) {
+	cases := map[string]int{"PT48.5H": 2, "PT1440.5M": 1, "PT86400.5S": 1, "P1DT36.5H": 2}
+	for s, want := range cases {
+		if got := period.MustParse(s).TotalDaysApprox(); got != want {
+			t.Errorf("%s.TotalDaysApprox() = %d, want %d", s, got, want)
+		}
+	}
+}
+
+// period/11: a number with more than 19 significant digits is out of the fields' range and
+// must be rejected (as a 20-digit integer part is), not rounded.
+func TestHegelPinParseRejectsMoreThan19Digits(t *testing.T) {
+	for _, tc := range []struct{ s, exact string }{
+		{"P0.00000000000000000001D", "0.00000000000000000001"},
+		{"P1234567890123456789.5D", "1234567890123456789.5"},
+		{"PT1.00000000000000000000S", "1"},
+	} {
+		p, err := period.Parse(tc.s)
+		if err != nil {
+			continue // rejecting is fine
+		}
+		got := p.DaysDecimal()
+		if tc.s[len(tc.s)-1] == 'S' {
+			got = p.SecondsDecimal()
+		}
+		if ratOf(got).Cmp(mustRat(tc.exact)) != 0 {
+			t.Errorf("Parse(%q) = %v: the value was rounded, want an error or the exact value", tc.s, p)
+		}
+	}
+}
+
+// period/12: a result that needs more than 19 digits is an arithmetic error, not a rounding:
+// Add reports an error or the exact sum, Simplify keeps the fields unaltered.
+func TestHegelPinArithmeticDoesNotRound(t *testing.T) {
+	a := period.MustParse("PT1S")
+	b := period.MustParse("PT0.1234567890123456789S")
+	if s, err := a.Add(b); err == nil && ratOf(s.SecondsDecimal()).Cmp(mustRat("1.1234567890123456789")) != 0 {
+		t.Errorf("PT1S + PT0.1234567890123456789S = %s: rounded, want an error or the exact sum", s)
+	}
+	p := period.MustParse("PT7310469896202390.179H")
+	s := p.Simplify(true)
+	if valOf(s).hms().Cmp(valOf(p).hms()) != 0 {
+		t.Errorf("%s.Simplify(true) = %s changes the value (%s -> %s seconds)", p, s, valOf(p).hms().FloatString(3), valOf(s).hms().FloatString(3))
+	}
+}
+
+// period/13: SetInt and SetField keep the sign of the other fields of a negative period.
+func TestHegelPinSetFieldKeepsTheSign(t *testing.T) {
+	p := period.MustParse("-PT1329S")
+	q := p.SetInt(274, period.Month)
+	if q.Seconds() != -1329 || q.Months() != 274 {
+		t.Errorf("-PT1329S.SetInt(274, Month) = %s: want 274 months and -1329 seconds", q)
+	}
+	r := period.MustParse("-P1Y2M").SetInt(3, period.Day)
+	if r.Years() != -1 || r.Months() != -2 || r.Days() != 3 {
+		t.Errorf("-P1Y2M.SetInt(3, Day) = %s: want -1 year, -2 months, 3 days", r)
+	}
+}
+
+// period/14: the whole-number getters truncate: 7.6 hours hold 7 whole hours.
+func TestHegelPinGettersTruncate(t *testing.T) {
+	cases := map[string][2]int{"PT7.6H": {7, 8}, "PT7753.8732S": {7753, 7754}, "P2.5Y": {2, 3}, "PT-0.533S": {0, -1}}
+	for s, want := range cases {
+		p := period.MustParse(s)
+		var got int
+		switch s[len(s)-1] {
+		case 'H':
+			got = p.Hours()
+		case 'S':
+			got = p.Seconds()
+		case 'Y':
+			got = p.Years()
+		}
+		if got != want[0] {
+			t.Errorf("%s: whole number = %d (rounded), want %d", s, got, want[0])
+		}
+	}
+}
+
+// period/15: a normalised period keeps the sign convention (the most significant field
+// positive, the period's sign in front), so Sign is right and String parses back to it.
+func TestHegelPinNormaliseKeepsTheSignConvention(t *testing.T) {
+	for _, s := range []string{"PT7H-5358M7484S", "P8WT7400H-335384068M", "P1M-400D"} {
+		p := period.MustParse(s)
+		for _, r := range []period.Period{p.Normalise(true), p.Normalise(false), p.Simplify(true)} {
+			v := valOf(r)
+			if r.Sign() != v.sign() || r.IsNegative() != (v.sign() < 0) {
+				t.Errorf("%s normalised = %s (%s): Sign %d, IsNegative %v", s, r, v, r.Sign(), r.IsNegative())
+			}
+			if q, err := period.Parse(r.String()); err != nil || q != r {
+				t.Errorf("%s normalised = %s parses back as %s (%v)", s, r, q, err)
+			}
+		}
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..dc293ac
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,884 @@
+package period_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/govalues/decimal"
+	"github.com/rickb777/period"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- helpers
+
+// scales are the library's decimal scales of the seven fields (trailing zeros count).
+func scales(p period.Period) [7]int {
+	return [7]int{p.YearsDecimal().Scale(), p.MonthsDecimal().Scale(), p.WeeksDecimal().Scale(), p.DaysDecimal().Scale(),
+		p.HoursDecimal().Scale(), p.MinutesDecimal().Scale(), p.SecondsDecimal().Scale()}
+}
+
+// exactScales tells whether Duration's fixed-point arithmetic is exact for these scales
+// (the factor of each field divided by 10^scale stays an integer).
+var exactScaleLimit = [7]int{5, 3, 9, 9, 11, 10, 9}
+
+func exactScales(p period.Period) bool {
+	sc := scales(p)
+	for i := range sc {
+		if sc[i] > exactScaleLimit[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// validForm tells whether a period's fields obey the fraction rule: only the least
+// significant non-zero field has a non-integral value.
+func validForm(v val) bool {
+	seen := false
+	for i := range v.f {
+		if v.f[i].Sign() == 0 {
+			continue
+		}
+		if seen {
+			return false
+		}
+		if !v.f[i].IsInt() {
+			seen = true
+		}
+	}
+	return true
+}
+
+var maxInt64 = new(big.Int).SetInt64(math.MaxInt64)
+
+func fitsInt64(x *big.Int) bool { return new(big.Int).Abs(x).Cmp(maxInt64) <= 0 }
+
+// reparse checks that a period's string parses back to the same period.
+func reparse(c *collector, ht *hegel.T, what string, p period.Period) bool {
+	s := p.String()
+	q, err := period.Parse(s)
+	if err != nil {
+		c.failClass(ht, "reparse error", "%s: String %q does not parse: %v", what, s, err)
+		return false
+	}
+	if q != p {
+		// a zero field that kept a decimal scale ("0.0D") prints as nothing and parses back
+		// as a plain zero
+		sc := scales(p)
+		v := valOf(p)
+		for i := range sc {
+			if sc[i] > 0 && v.f[i].Sign() == 0 && Known.zeroFractionKept {
+				c.count("known: zero field with a scale")
+				return false
+			}
+		}
+		c.failClass(ht, "reparse differs", "%s: Parse(%q) = %#v, not the period itself %#v", what, s, q, p)
+		return false
+	}
+	return true
+}
+
+// libValid tells whether the library's own parser would accept the period's string: it
+// counts any field with a non-zero decimal scale as a fraction, trailing zeros included.
+func libValid(p period.Period) bool {
+	sc := scales(p)
+	v := valOf(p)
+	seen := false
+	for i := range sc {
+		if v.f[i].Sign() == 0 && sc[i] == 0 {
+			continue
+		}
+		if seen && v.f[i].Sign() != 0 {
+			return false
+		}
+		if sc[i] > 0 {
+			seen = true
+		}
+	}
+	return true
+}
+
+// checkForm checks that a result prints and parses back, allowing the recorded zero-fraction
+// behaviour; the caller has checked the fraction rule on the values.
+func checkForm(c *collector, ht *hegel.T, what string, r period.Period) bool {
+	if !libValid(r) {
+		if Known.zeroFractionKept {
+			c.count("known: zero fraction in a result")
+			return false
+		}
+	}
+	return reparse(c, ht, what, r)
+}
+
+// sigDigits is the number of significant digits of a decimal value (the coefficient's).
+func sigDigits(r *big.Rat) int {
+	s := strings.TrimPrefix(ratDec(r), "-")
+	s = strings.Replace(s, ".", "", 1)
+	s = strings.TrimLeft(s, "0")
+	return len(s)
+}
+
+// needsRounding tells whether some field of an exact result has more than 19 digits.
+func needsRounding(v val) bool {
+	for i := range v.f {
+		if sigDigits(v.f[i]) > 19 {
+			return true
+		}
+	}
+	return false
+}
+
+// signOK checks that a result's Sign/IsNegative/IsPositive agree with its values (the most
+// significant non-zero field carries the sign); a negative lead is a recorded bug.
+func signOK(c *collector, ht *hegel.T, what string, r period.Period) bool {
+	rv := valOf(r)
+	if r.Sign() == rv.sign() && r.IsNegative() == (rv.sign() < 0) && r.IsPositive() == (rv.sign() >= 0) {
+		return true
+	}
+	if Known.normaliseLeavesNegativeLead {
+		c.count("known: negative lead after " + what)
+		return false
+	}
+	c.failClass(ht, what+" sign", "%s = %s (%s): Sign %d, IsNegative %v", what, r, rv, r.Sign(), r.IsNegative())
+	return false
+}
+
+// normalisedNeedsRounding tells whether Add's precise normalisation of the exact sum would
+// carry a field beyond 19 digits (the whole quotients moved left, ignoring the fraction rule).
+func normalisedNeedsRounding(v val) bool {
+	if needsRounding(v) {
+		return true
+	}
+	q := func(x *big.Rat, n int64) *big.Rat { return new(big.Rat).SetInt(trunc(new(big.Rat).Quo(x, big.NewRat(n, 1)))) }
+	mi1 := new(big.Rat).Add(v.f[fMi], q(v.f[fS], 60))
+	h1 := new(big.Rat).Add(v.f[fH], q(mi1, 60))
+	w1 := new(big.Rat).Add(v.f[fW], q(v.f[fD], 7))
+	y1 := new(big.Rat).Add(v.f[fY], q(v.f[fMo], 12))
+	for _, x := range []*big.Rat{mi1, h1, w1, y1} {
+		if sigDigits(x) > 19 {
+			return true
+		}
+	}
+	return false
+}
+
+// sameSigns tells whether no two non-zero fields have opposite signs.
+func sameSigns(v val) bool {
+	neg, pos := false, false
+	for i := range v.f {
+		switch v.f[i].Sign() {
+		case -1:
+			neg = true
+		case 1:
+			pos = true
+		}
+	}
+	return !(neg && pos)
+}
+
+// --------------------------------------------------------------------------- the grammar
+
+// TestHegelParseFollowsTheGrammar: Parse accepts exactly the documented grammar (with the
+// recorded leniencies), yields the fields the text says, prints the canonical string, and
+// String / MarshalText / JSON / Scan / Value / flag Set round-trip.
+func TestHegelParseFollowsTheGrammar(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := genISO(ht, 12, true)
+		if chance(ht, 45) {
+			s = mutate(ht, s)
+		}
+		m, ok := modelParse(s)
+		expectAccept := ok && m.leniencyAccepted()
+		p, err := period.Parse(s)
+		if (err == nil) != expectAccept {
+			if ok && len(m.tags) > 0 {
+				c.failClass(ht, "leniency "+strings.Join(m.tags, "+"), "Parse(%q): err=%v, model %v (tags %v)", s, err, expectAccept, m.tags)
+			} else {
+				c.failClass(ht, "accept", "Parse(%q): err=%v, model accepts=%v", s, err, ok)
+			}
+			return
+		}
+		if err != nil {
+			c.count("rejected")
+			// MustParse panics on the same input
+			func() {
+				defer func() {
+					if recover() == nil {
+						c.fail(ht, "MustParse(%q) did not panic", s)
+					}
+				}()
+				_ = period.MustParse(s)
+			}()
+			return
+		}
+		if len(m.tags) > 0 {
+			c.count("accepted with " + strings.Join(m.tags, "+"))
+		} else {
+			c.count("accepted")
+		}
+		v := valOf(p)
+		if m.has(tagRounded) {
+			c.count("known: rounded value not checked")
+		} else if !v.eq(m.v) {
+			c.fail(ht, "Parse(%q) fields %s, model %s", s, v.String(), m.v.String())
+			return
+		}
+		// canonical string
+		if m.has(tagTrailingZeros) || m.has(tagRounded) {
+			c.count("known: trailing zeros kept in String")
+		} else if got := p.String(); got != m.v.String() {
+			c.fail(ht, "Parse(%q).String() = %q, canonical %q", s, got, m.v.String())
+			return
+		}
+		if string(p.Period()) != p.String() {
+			c.fail(ht, "Period() %q != String() %q", p.Period(), p.String())
+		}
+		if !reparse(c, ht, "Parse("+strconv.Quote(s)+")", p) {
+			return
+		}
+		// text, JSON, sql and flag round trips
+		txt, err := p.MarshalText()
+		if err != nil || string(txt) != p.String() {
+			c.fail(ht, "MarshalText(%q) = %q, %v", s, txt, err)
+			return
+		}
+		var q period.Period
+		if err := q.UnmarshalText(txt); err != nil || q != p {
+			c.fail(ht, "UnmarshalText(%q) = %v, %v", txt, q, err)
+			return
+		}
+		js, err := json.Marshal(p)
+		if err != nil {
+			c.fail(ht, "json.Marshal: %v", err)
+			return
+		}
+		var r period.Period
+		if err := json.Unmarshal(js, &r); err != nil || r != p {
+			c.fail(ht, "json round trip of %s: %v, %v", js, r, err)
+			return
+		}
+		var sc period.Period
+		if err := sc.Scan([]byte(p.String())); err != nil || sc != p {
+			c.fail(ht, "Scan([]byte %q) = %v, %v", p.String(), sc, err)
+			return
+		}
+		if dv, err := p.Value(); err != nil || dv != p.String() {
+			c.fail(ht, "Value() = %v, %v", dv, err)
+			return
+		}
+		var fl period.Period
+		if err := fl.Set(s); err != nil || fl != p {
+			c.fail(ht, "flag Set(%q) = %v, %v", s, fl, err)
+			return
+		}
+		if fl.Get() != p.String() {
+			c.fail(ht, "flag Get() = %v", fl.Get())
+		}
+		// the sign predicates
+		if p.Sign() != v.sign() || p.IsZero() != v.isZero() || p.IsNegative() != (v.sign() < 0) || p.IsPositive() != (v.sign() >= 0) {
+			c.fail(ht, "%q: Sign %d IsZero %v IsNegative %v IsPositive %v, values %s", s, p.Sign(), p.IsZero(), p.IsNegative(), p.IsPositive(), v.String())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- normalisation
+
+func checkParts(c *collector, ht *hegel.T, what string, before, after val, precise bool) bool {
+	if precise {
+		if before.calDays().Cmp(after.calDays()) != 0 || before.hms().Cmp(after.hms()) != 0 {
+			c.failClass(ht, what, "%s: %s -> %s changes the value (calendar %s -> %s days, time %s -> %s s)", what, before, after,
+				before.calDays().FloatString(6), after.calDays().FloatString(6), before.hms().FloatString(6), after.hms().FloatString(6))
+			return false
+		}
+		return true
+	}
+	if before.total().Cmp(after.total()) != 0 {
+		c.failClass(ht, what, "%s: %s -> %s changes the total (%s -> %s s)", what, before, after, before.total().FloatString(6), after.total().FloatString(6))
+		return false
+	}
+	return true
+}
+
+// TestHegelNormalisePreservesTheValue: Normalise, NormaliseDaysToYears, Simplify,
+// SimplifyWeeks and SimplifyWeeksToDays keep the value (the calendar and time parts
+// separately in precise mode, the 24-hour total otherwise), are idempotent, and produce
+// periods that print and parse back.
+func TestHegelNormalisePreservesTheValue(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := genPeriod(ht)
+		v := valOf(p)
+		for _, precise := range []bool{true, false} {
+			n := p.Normalise(precise)
+			nv := valOf(n)
+			if !checkParts(c, ht, fmt.Sprintf("Normalise(%v)", precise), v, nv, precise) {
+				return
+			}
+			if n.Normalise(precise) != n {
+				c.failClass(ht, "normalise idempotent", "Normalise(%v) of %s = %s, again %s", precise, p, n, n.Normalise(precise))
+				return
+			}
+			if !signOK(c, ht, fmt.Sprintf("Normalise(%v)", precise), n) {
+				continue
+			}
+			if !validForm(nv) {
+				c.failClass(ht, "normalise form", "Normalise(%v) of %s = %s breaks the fraction rule", precise, p, n)
+				return
+			}
+			if !checkForm(c, ht, fmt.Sprintf("Normalise(%v) of %s", precise, p), n) {
+				return
+			}
+			sm := p.Simplify(precise)
+			if simplifyRounds(v, precise) && Known.arithmeticRoundsBeyond19Digits {
+				c.count("known: Simplify rounds")
+				continue
+			}
+			if !checkParts(c, ht, fmt.Sprintf("Simplify(%v)", precise), v, valOf(sm), precise) {
+				return
+			}
+			if sm.Simplify(precise) != sm {
+				c.failClass(ht, "simplify idempotent", "Simplify(%v) of %s = %s, again %s", precise, p, sm, sm.Simplify(precise))
+				return
+			}
+			if !signOK(c, ht, fmt.Sprintf("Simplify(%v)", precise), sm) {
+				continue
+			}
+			if !validForm(valOf(sm)) {
+				c.failClass(ht, "simplify form", "Simplify(%v) of %s = %s breaks the fraction rule", precise, p, sm)
+				return
+			}
+			if !checkForm(c, ht, fmt.Sprintf("Simplify(%v) of %s", precise, p), sm) {
+				return
+			}
+		}
+		// weeks
+		w := p.SimplifyWeeksToDays()
+		wv := valOf(w)
+		if sigDigits(new(big.Rat).Add(new(big.Rat).Mul(v.f[fW], rat7), v.f[fD])) > 19 && Known.arithmeticRoundsBeyond19Digits {
+			c.count("known: SimplifyWeeksToDays rounds")
+			return
+		}
+		if wv.f[fW].Sign() != 0 || !checkParts(c, ht, "SimplifyWeeksToDays", v, wv, true) {
+			c.failClass(ht, "weeks", "SimplifyWeeksToDays of %s = %s", p, w)
+			return
+		}
+		if p.DaysIncWeeks() != w.Days() || p.DaysIncWeeksDecimal().Cmp(w.DaysDecimal()) != 0 {
+			c.fail(ht, "DaysIncWeeks of %s = %d (%s), SimplifyWeeksToDays gives %d (%s)", p, p.DaysIncWeeks(), p.DaysIncWeeksDecimal(), w.Days(), w.DaysDecimal())
+			return
+		}
+		others := false
+		for i, x := range v.f {
+			if i != fW && x.Sign() != 0 {
+				others = true
+			}
+		}
+		sw := p.SimplifyWeeks()
+		if others && sw != w {
+			c.fail(ht, "SimplifyWeeks of %s = %s, SimplifyWeeksToDays %s", p, sw, w)
+			return
+		}
+		if !others && sw != p {
+			c.fail(ht, "SimplifyWeeks of a weeks-only %s = %s", p, sw)
+			return
+		}
+		// days to years
+		dy := p.NormaliseDaysToYears()
+		dv := valOf(dy)
+		if !checkParts(c, ht, "NormaliseDaysToYears", v, dv, true) {
+			return
+		}
+		if !signOK(c, ht, "NormaliseDaysToYears", dy) {
+			return
+		}
+		if sameSigns(v) && v.calDays().Sign() >= 0 {
+			// at most the remainder of a year stays in weeks and days
+			rem := new(big.Rat).Add(new(big.Rat).Mul(dv.f[fW], rat7), dv.f[fD])
+			if rem.Cmp(ratDaysPerYear) >= 0 && v.f[fY].IsInt() {
+				c.fail(ht, "NormaliseDaysToYears of %s = %s keeps %s days", p, dy, rem.FloatString(4))
+				return
+			}
+		}
+		if !validForm(dv) {
+			if Known.daysToYearsLeavesFraction {
+				c.count("known: NormaliseDaysToYears leaves a fraction")
+				return
+			}
+			c.failClass(ht, "days-to-years form", "NormaliseDaysToYears of %s = %s breaks the fraction rule", p, dy)
+			return
+		}
+		if !checkForm(c, ht, fmt.Sprintf("NormaliseDaysToYears of %s", p), dy) {
+			return
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- arithmetic
+
+// checkResultForm checks that an arithmetic result prints and parses back, allowing the
+// recorded spread of fractions.
+func checkResultForm(c *collector, ht *hegel.T, what string, r period.Period) bool {
+	rv := valOf(r)
+	if !validForm(rv) {
+		if Known.arithmeticSpreadsFractions {
+			c.count("known: " + what + " spreads fractions")
+			return false
+		}
+		c.failClass(ht, what+" form", "%s = %s breaks the fraction rule", what, r)
+		return false
+	}
+	return checkForm(c, ht, what, r)
+}
+
+// simplifyRounds tells whether Simplify's candidate products (larger * unit + smaller) of some
+// pair of fields would need more than 19 digits.
+func simplifyRounds(v val, precise bool) bool {
+	pairs := [][3]int{{fY, fMo, 12}, {fH, fMi, 60}, {fMi, fS, 60}, {fW, fD, 7}}
+	if !precise {
+		pairs = append(pairs, [3]int{fD, fH, 24})
+	}
+	for _, pr := range pairs {
+		x := new(big.Rat).Mul(v.f[pr[0]], big.NewRat(int64(pr[2]), 1))
+		x.Add(x, v.f[pr[1]])
+		if sigDigits(x) > 19 {
+			return true
+		}
+	}
+	// the chained moves (days into hours into minutes into seconds) can compound
+	x := new(big.Rat).Set(v.hms())
+	if !precise {
+		days := new(big.Rat).Add(new(big.Rat).Mul(v.f[fW], rat7), v.f[fD])
+		x.Add(x, new(big.Rat).Mul(days, rat86400))
+	}
+	return sigDigits(x) > 19
+}
+
+// TestHegelArithmeticIsExact: Add, Subtract, Mul, Negate and Abs act on the values exactly
+// (Add and Subtract on the calendar and time parts, which Normalise(true) preserves), the
+// results print and parse back, and the sign methods agree with the values.
+func TestHegelArithmeticIsExact(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := genPeriod(ht)
+		b := genPeriod(ht)
+		av, bv := valOf(a), valOf(b)
+		sum, err := a.Add(b)
+		if err != nil {
+			c.count("add overflow")
+		} else if normalisedNeedsRounding(av.add(bv)) && Known.arithmeticRoundsBeyond19Digits {
+			c.count("known: Add rounds")
+		} else {
+			want := av.add(bv)
+			if !checkParts(c, ht, "Add", want, valOf(sum), true) {
+				return
+			}
+			sum2, _ := b.Add(a)
+			if sum2 != sum {
+				c.failClass(ht, "commutative", "%s + %s = %s, but %s + %s = %s", a, b, sum, b, a, sum2)
+				return
+			}
+			checkResultForm(c, ht, "Add", sum)
+		}
+		diff, err := a.Subtract(b)
+		if err != nil {
+			c.count("subtract overflow")
+		} else if normalisedNeedsRounding(av.add(bv.neg())) && Known.arithmeticRoundsBeyond19Digits {
+			c.count("known: Subtract rounds")
+		} else {
+			want := av.add(bv.neg())
+			if !checkParts(c, ht, "Subtract", want, valOf(diff), true) {
+				return
+			}
+			checkResultForm(c, ht, "Subtract", diff)
+		}
+		self, err := a.Subtract(a)
+		if err == nil && !self.IsZero() {
+			c.fail(ht, "%s - itself = %s", a, self)
+			return
+		}
+		if z, err := a.Add(a.Negate()); err == nil && !z.IsZero() {
+			c.fail(ht, "%s + its negation = %s", a, z)
+			return
+		}
+		// Mul
+		fs := pick(ht, mulFactors)
+		f := decimal.MustParse(fs)
+		fr, _ := new(big.Rat).SetString(fs)
+		prod, err := a.Mul(f)
+		if err != nil {
+			c.count("mul overflow")
+		} else if needsRounding(av.scale(fr)) && Known.arithmeticRoundsBeyond19Digits {
+			c.count("known: Mul rounds")
+		} else {
+			want := av.scale(fr)
+			if !valOf(prod).eq(want) {
+				c.fail(ht, "%s * %s = %s (%s), want %s", a, fs, prod, valOf(prod), want)
+				return
+			}
+			checkResultForm(c, ht, "Mul", prod)
+		}
+		// Negate, Abs, sign
+		n := a.Negate()
+		if !valOf(n).eq(av.neg()) || n.Negate() != a {
+			c.fail(ht, "Negate of %s = %s (%s); twice %s", a, n, valOf(n), n.Negate())
+			return
+		}
+		ab := a.Abs()
+		wantAbs := av
+		if av.sign() < 0 {
+			wantAbs = av.neg()
+		}
+		if !valOf(ab).eq(wantAbs) || ab.IsNegative() || ab.Abs() != ab {
+			c.fail(ht, "Abs of %s = %s (%s)", a, ab, valOf(ab))
+			return
+		}
+		if a.Sign() != av.sign() || a.IsZero() != av.isZero() || a.IsNegative() != (av.sign() < 0) || a.IsPositive() != (av.sign() >= 0) {
+			c.fail(ht, "%s: Sign %d IsZero %v IsNegative %v IsPositive %v, values %s", a, a.Sign(), a.IsZero(), a.IsNegative(), a.IsPositive(), av)
+			return
+		}
+		// OnlyYMWD / OnlyHMS
+		y, h := valOf(a.OnlyYMWD()), valOf(a.OnlyHMS())
+		for i := 0; i < 7; i++ {
+			wy, wh := av.f[i], av.f[i]
+			if i >= fH {
+				wy = new(big.Rat)
+			} else {
+				wh = new(big.Rat)
+			}
+			if y.f[i].Cmp(wy) != 0 || h.f[i].Cmp(wh) != 0 {
+				c.fail(ht, "OnlyYMWD/OnlyHMS of %s = %s / %s", a, a.OnlyYMWD(), a.OnlyHMS())
+				return
+			}
+		}
+		c.count("ok")
+	})
+}
+
+// --------------------------------------------------------------------------- durations
+
+// TestHegelDurationIsTheSum: Duration, DurationApprox, AddTo, TotalDaysApprox and
+// TotalMonthsApprox follow the documented approximation (365.2425 days a year, a twelfth of
+// that a month, 24-hour days), the precise flag says whether the calendar part was zero,
+// whole calendar periods are added with AddDate, and NewOf / Between invert Duration / AddTo.
+func TestHegelDurationIsTheSum(t *testing.T) {
+	c := newCollector(t)
+	base := time.Date(2000, 1, 1, 0, 0, 0, 0, time.UTC)
+	property(t, func(ht *hegel.T) {
+		p := genPeriod(ht)
+		v := valOf(p)
+		d, precise := p.Duration()
+		if p.DurationApprox() != d {
+			c.fail(ht, "DurationApprox of %s = %v, Duration %v", p, p.DurationApprox(), d)
+			return
+		}
+		t0 := base.Add(time.Duration(drawInt(ht, -40*365*24, 40*365*24)) * time.Hour).Add(time.Duration(drawInt(ht, 0, 86400*1000000000-1)))
+		if !exactScales(p) {
+			c.count("inexact scale")
+			_, _ = p.AddTo(t0)
+			_ = p.TotalDaysApprox()
+			_ = p.TotalMonthsApprox()
+			return
+		}
+		totalNs := new(big.Rat).Mul(v.total(), rat1e9)
+		calNs := new(big.Rat).Mul(new(big.Rat).Mul(v.calDays(), rat86400), rat1e9)
+		hmsNs := new(big.Rat).Mul(v.hms(), rat1e9)
+		if !totalNs.IsInt() || !calNs.IsInt() || !hmsNs.IsInt() {
+			c.fail(ht, "%s: the exact total %s ns is not integral", p, totalNs.FloatString(3))
+			return
+		}
+		calDaysE9 := new(big.Rat).Mul(v.calDays(), rat1e9)
+		if !fitsInt64(totalNs.Num()) || !fitsInt64(calNs.Num()) || !fitsInt64(hmsNs.Num()) || !fitsInt64(calDaysE9.Num()) {
+			if Known.durationOverflowWraps {
+				c.count("known: duration overflow")
+				return
+			}
+			if precise {
+				c.failClass(ht, "overflow precise", "Duration of %s overflows int64 (%s ns) but is reported precise (%v)", p, totalNs.FloatString(0), d)
+			}
+			return
+		}
+		wantD := time.Duration(totalNs.Num().Int64())
+		wantPrecise := v.calDays().Sign() == 0
+		if d != wantD || precise != wantPrecise {
+			c.fail(ht, "Duration of %s = %v, %v; want %v, %v", p, d, precise, wantD, wantPrecise)
+			return
+		}
+		// AddTo
+		wholeByValue := v.f[fY].IsInt() && v.f[fMo].IsInt() && v.f[fW].IsInt() && v.f[fD].IsInt()
+		calZero := v.f[fY].Sign() == 0 && v.f[fMo].Sign() == 0 && v.f[fW].Sign() == 0 && v.f[fD].Sign() == 0
+		sc := scales(p)
+		wholeByScale := sc[fY] == 0 && sc[fMo] == 0 && sc[fW] == 0 && sc[fD] == 0
+		got, gotPrecise := p.AddTo(t0)
+		small := true
+		for i := fY; i <= fD; i++ {
+			if new(big.Rat).Abs(v.f[i]).Cmp(big.NewRat(1000000, 1)) > 0 {
+				small = false
+			}
+		}
+		switch {
+		case !small:
+			c.count("large calendar")
+		case wholeByValue && !calZero && !wholeByScale:
+			if Known.zeroFractionKept {
+				c.count("known: whole calendar field with a zero fraction")
+				break
+			}
+			fallthrough
+		case wholeByValue && !calZero:
+			days := new(big.Rat).Add(new(big.Rat).Mul(v.f[fW], rat7), v.f[fD])
+			want := t0.AddDate(int(v.f[fY].Num().Int64()), int(v.f[fMo].Num().Int64()), int(days.Num().Int64())).Add(time.Duration(hmsNs.Num().Int64()))
+			if !got.Equal(want) || !gotPrecise {
+				c.fail(ht, "AddTo of whole %s to %v = %v, %v; want %v, true", p, t0, got, gotPrecise, want)
+				return
+			}
+			c.count("addto calendar")
+		default:
+			want := t0.Add(wantD)
+			if !got.Equal(want) || gotPrecise != wantPrecise {
+				c.fail(ht, "AddTo of %s to %v = %v, %v; want %v, %v", p, t0, got, gotPrecise, want, wantPrecise)
+				return
+			}
+			c.count("addto duration")
+		}
+		// totals
+		mixed := false
+		neg, pos := false, false
+		for i := fH; i <= fS; i++ {
+			if v.f[i].Sign() < 0 {
+				neg = true
+			}
+			if v.f[i].Sign() > 0 {
+				pos = true
+			}
+		}
+		mixed = neg && pos
+		fracTime := sc[fH] > 0 || sc[fMi] > 0 || sc[fS] > 0
+		switch {
+		case mixed:
+			c.count("mixed-sign time")
+		case fracTime && Known.approxDaysIgnoreFractionalTime:
+			c.count("known: fractional time in totals")
+		default:
+			wholeDays := trunc(new(big.Rat).Quo(v.hms(), rat86400))
+			days := new(big.Rat).Add(v.calDays(), new(big.Rat).SetInt(wholeDays))
+			wantDays := trunc(days)
+			wantMonths := trunc(new(big.Rat).Quo(days, ratDaysPerMonth))
+			if !fitsInt64(wantDays) {
+				c.count("large total")
+				break
+			}
+			if int64(p.TotalDaysApprox()) != wantDays.Int64() || int64(p.TotalMonthsApprox()) != wantMonths.Int64() {
+				c.fail(ht, "%s: TotalDaysApprox %d, TotalMonthsApprox %d; want %s, %s", p, p.TotalDaysApprox(), p.TotalMonthsApprox(), wantDays, wantMonths)
+				return
+			}
+		}
+		// NewOf and Between
+		dd := time.Duration(drawInt(ht, -1000000000, 1000000000)) * time.Duration(pick(ht, []int{1, 7, 1000, 1000000, 1000000000, 3600000000000}))
+		np := period.NewOf(dd)
+		nd, nPrecise := np.Duration()
+		if nd != dd || !nPrecise {
+			c.fail(ht, "NewOf(%v) = %s, Duration %v, %v", dd, np, nd, nPrecise)
+			return
+		}
+		wantSecs := new(big.Rat).SetFrac(big.NewInt(int64(dd)), big.NewInt(1000000000))
+		if nv := valOf(np); nv.f[fS].Cmp(wantSecs) != 0 || nv.hms().Cmp(wantSecs) != 0 || nv.calDays().Sign() != 0 {
+			c.fail(ht, "NewOf(%v) = %s (%s)", dd, np, nv)
+			return
+		}
+		t1 := t0.Add(dd)
+		bt := period.Between(t0, t1)
+		back, bPrecise := bt.AddTo(t0)
+		if !back.Equal(t1) || !bPrecise {
+			c.fail(ht, "Between(%v, %v) = %s; AddTo gives %v, %v", t0, t1, bt, back, bPrecise)
+			return
+		}
+		if period.Between(t1, t0) != bt.Negate() {
+			c.fail(ht, "Between(%v, %v) = %s, reverse %s", t0, t1, bt, period.Between(t1, t0))
+			return
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- format
+
+var testLocalisation = period.FormatLocalisation{
+	ZeroValue: "nil",
+	Negate:    func(s string) string { return "-" + s },
+	// plural.FromOne semantics: the first form up to one, the second above
+	YearNames:   period.DefaultFormatLocalisation.YearNames,
+	MonthNames:  period.DefaultFormatLocalisation.MonthNames,
+	WeekNames:   period.DefaultFormatLocalisation.WeekNames,
+	DayNames:    period.DefaultFormatLocalisation.DayNames,
+	HourNames:   period.DefaultFormatLocalisation.HourNames,
+	MinuteNames: period.DefaultFormatLocalisation.MinuteNames,
+	SecondNames: period.DefaultFormatLocalisation.SecondNames,
+}
+
+var unitNames = []string{"year", "month", "week", "day", "hour", "minute", "second"}
+
+// modelFormat renders the English form: each non-zero field as its number and unit (singular
+// up to one), negative fields negated, joined by ", ". The overall sign is not shown (the
+// upstream tests assert that). floatDiffers reports whether %v of the float64 would differ.
+func modelFormat(v val, zero, minus string) (string, bool) {
+	if v.isZero() {
+		return zero, false
+	}
+	if v.sign() < 0 {
+		v = v.neg()
+	}
+	floatDiffers := false
+	var parts []string
+	for i, x := range v.f {
+		if x.Sign() == 0 {
+			continue
+		}
+		a := new(big.Rat).Abs(x)
+		num := ratDec(a)
+		f, _ := a.Float64()
+		if strconv.FormatFloat(f, 'g', -1, 64) != num {
+			floatDiffers = true
+		}
+		unit := unitNames[i]
+		if a.Cmp(big.NewRat(1, 1)) > 0 {
+			unit += "s"
+		}
+		part := num + " " + unit
+		if x.Sign() < 0 {
+			part = minus + part
+		}
+		parts = append(parts, part)
+	}
+	return strings.Join(parts, ", "), floatDiffers
+}
+
+// TestHegelFormatListsTheFields: Format and FormatLocalised list the non-zero fields with
+// their units, singular up to one, "minus" for a negative field, the configured zero value.
+func TestHegelFormatListsTheFields(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := genPeriod(ht)
+		v := valOf(p)
+		want, floatDiffers := modelFormat(v, "zero", "minus ")
+		got := p.Format()
+		if got != want {
+			if floatDiffers && Known.formatUsesFloatFormatting {
+				c.count("known: float formatting")
+				return
+			}
+			c.fail(ht, "Format of %s = %q, want %q", p, got, want)
+			return
+		}
+		want2, _ := modelFormat(v, "nil", "-")
+		if got2 := p.FormatLocalised(testLocalisation); got2 != want2 {
+			c.fail(ht, "FormatLocalised of %s = %q, want %q", p, got2, want2)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+// --------------------------------------------------------------------------- accessors
+
+// TestHegelAccessorsAreTheFields: the getters return the fields (whole numbers truncated),
+// GetField/GetInt/SetInt/SetField address them by designator, SetField applies the fraction
+// rule, and the constructors set what they are given.
+func TestHegelAccessorsAreTheFields(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := genPeriod(ht)
+		v := valOf(p)
+		ints := []int{p.Years(), p.Months(), p.Weeks(), p.Days(), p.Hours(), p.Minutes(), p.Seconds()}
+		for i := range v.f {
+			w := trunc(v.f[i])
+			if !fitsInt64(w) {
+				continue
+			}
+			if int64(ints[i]) != w.Int64() || int64(p.GetInt(designators[i])) != w.Int64() {
+				if !v.f[i].IsInt() && Known.gettersRound {
+					c.count("known: getter rounds")
+				} else {
+					c.fail(ht, "%s: %s = %d / GetInt %d, want %s", p, fieldNames[i], ints[i], p.GetInt(designators[i]), w)
+					return
+				}
+			}
+			if ratOf(p.GetField(designators[i])).Cmp(v.f[i]) != 0 {
+				c.fail(ht, "%s: GetField(%s) = %s, want %s", p, fieldNames[i], p.GetField(designators[i]), ratDec(v.f[i]))
+				return
+			}
+		}
+		// SetInt / SetField
+		i := drawInt(ht, 0, 6)
+		if p.IsNegative() && Known.setFieldDropsSign {
+			c.count("known: SetField on a negative period")
+			return
+		}
+		n := drawInt(ht, -1000, 1000)
+		q := p.SetInt(n, designators[i])
+		qv := valOf(q)
+		want := val{}
+		for j := range v.f {
+			want.f[j] = v.f[j]
+		}
+		want.f[i] = big.NewRat(int64(n), 1)
+		if !qv.eq(want) {
+			c.fail(ht, "%s.SetInt(%d, %s) = %s (%s), want %s", p, n, fieldNames[i], q, qv, want)
+			return
+		}
+		txt := genNumber(ht, chance(ht, 50), 6)
+		if chance(ht, 20) {
+			txt = "-" + txt
+		}
+		dec, err := decimal.Parse(txt)
+		if err != nil {
+			return
+		}
+		r := ratOf(dec) // decimal.Parse rounds to 19 digits
+		want.f[i] = r
+		q2, err := p.SetField(dec, designators[i])
+		wantErr := !validForm(want)
+		// the library judges a fraction by the decimal scale, trailing zeros included
+		scaleFraction := false
+		sc := scales(p)
+		sc[i] = dec.Scale()
+		for j := range want.f {
+			if sc[j] > 0 && want.f[j].IsInt() {
+				scaleFraction = true
+			}
+			if j == i && sc[j] > 0 && r.IsInt() {
+				scaleFraction = true
+			}
+		}
+		if (err != nil) != wantErr {
+			if scaleFraction && Known.zeroFractionKept {
+				c.count("known: zero fraction in SetField")
+			} else {
+				c.fail(ht, "%s.SetField(%s, %s): err=%v, want error %v", p, txt, fieldNames[i], err, wantErr)
+			}
+			return
+		}
+		if !valOf(q2).eq(want) {
+			c.fail(ht, "%s.SetField(%s, %s) = %s (%s), want %s", p, txt, fieldNames[i], q2, valOf(q2), want)
+			return
+		}
+		// constructors
+		ys, ms, ws, ds, hs, mis, ss := drawInt(ht, -100, 100), drawInt(ht, -100, 100), drawInt(ht, -100, 100), drawInt(ht, -1000, 1000), drawInt(ht, -100, 100), drawInt(ht, -100, 100), drawInt(ht, -100000, 100000)
+		np := period.New(ys, ms, ws, ds, hs, mis, ss)
+		nv := valOf(np)
+		wantNew := val{[7]*big.Rat{big.NewRat(int64(ys), 1), big.NewRat(int64(ms), 1), big.NewRat(int64(ws), 1), big.NewRat(int64(ds), 1), big.NewRat(int64(hs), 1), big.NewRat(int64(mis), 1), big.NewRat(int64(ss), 1)}}
+		if !nv.eq(wantNew) {
+			c.fail(ht, "New(%d,%d,%d,%d,%d,%d,%d) = %s (%s)", ys, ms, ws, ds, hs, mis, ss, np, nv)
+			return
+		}
+		if period.NewYMWD(ys, ms, ws, ds) != period.New(ys, ms, ws, ds, 0, 0, 0) || period.NewYMD(ys, ms, ds) != period.New(ys, ms, 0, ds, 0, 0, 0) || period.NewHMS(hs, mis, ss) != period.New(0, 0, 0, 0, hs, mis, ss) {
+			c.fail(ht, "NewYMWD/NewYMD/NewHMS differ from New")
+			return
+		}
+		c.count("ok")
+	})
+}
diff --git a/hegel_ref_test.go b/hegel_ref_test.go
new file mode 100644
index 0000000..4422d7b
--- /dev/null
+++ b/hegel_ref_test.go
@@ -0,0 +1,195 @@
+package period_test
+
+// Reference test: the Python isodate library parses a batch of strictly ISO-8601 period
+// strings (one sign, ordered fields, one fraction on the last field, no negative field) and
+// must agree with Parse on the years, the months and the total of the remaining fields.
+// Skipped when python3 with isodate is not on PATH (the CI's venv installs it).
+
+import (
+	"bytes"
+	"encoding/json"
+	"math/big"
+	"os/exec"
+	"strings"
+	"testing"
+
+	"github.com/rickb777/period"
+)
+
+const isodateScript = `
+import sys, json, isodate
+from isodate import Duration
+out = []
+for s in json.load(sys.stdin):
+    try:
+        d = isodate.parse_duration(s)
+    except Exception as e:
+        out.append({"ok": False, "err": str(e)})
+        continue
+    if isinstance(d, Duration):
+        y, m, td = d.years, d.months, d.tdelta
+    else:
+        y, m, td = 0, 0, d
+    out.append({"ok": True, "years": str(y), "months": str(m), "days": td.days, "seconds": td.seconds, "us": td.microseconds})
+json.dump(out, sys.stdout)
+`
+
+type isodateResult struct {
+	OK      bool   `json:"ok"`
+	Err     string `json:"err"`
+	Years   string `json:"years"`
+	Months  string `json:"months"`
+	Days    int64  `json:"days"`
+	Seconds int64  `json:"seconds"`
+	US      int64  `json:"us"`
+}
+
+// xorshift is a small deterministic generator for the batch.
+type xorshift uint64
+
+func (x *xorshift) next() uint64 {
+	v := uint64(*x)
+	v ^= v << 13
+	v ^= v >> 7
+	v ^= v << 17
+	*x = xorshift(v)
+	return v
+}
+
+func (x *xorshift) intn(n int) int { return int(x.next() % uint64(n)) }
+
+// strictISO draws a strictly ISO period string with small numbers (six integer digits, up to
+// six fraction digits on seconds and three elsewhere, so that isodate's floats are exact).
+func strictISO(x *xorshift) string {
+	var b strings.Builder
+	if x.intn(5) == 0 {
+		b.WriteByte('-')
+	}
+	b.WriteByte('P')
+	var present [7]bool
+	n := 0
+	for i := range present {
+		present[i] = x.intn(100) < 40
+		if present[i] {
+			n++
+		}
+	}
+	if n == 0 {
+		present[x.intn(7)] = true
+	}
+	last := -1
+	for i := 6; i >= 0; i-- {
+		if present[i] {
+			last = i
+			break
+		}
+	}
+	wroteT := false
+	for i := 0; i < 7; i++ {
+		if !present[i] {
+			continue
+		}
+		if i >= fH && !wroteT {
+			b.WriteByte('T')
+			wroteT = true
+		}
+		nInt := 1 + x.intn(6)
+		if x.intn(4) == 0 {
+			nInt = 1
+		}
+		for k := 0; k < nInt; k++ {
+			if k == 0 && nInt > 1 {
+				b.WriteByte(digitsAll[1+x.intn(9)])
+			} else {
+				b.WriteByte(digitsAll[x.intn(10)])
+			}
+		}
+		if i == last && x.intn(100) < 40 {
+			maxFrac := 3
+			if i == fS {
+				maxFrac = 6
+			}
+			nf := 1 + x.intn(maxFrac)
+			b.WriteByte('.')
+			for k := 0; k < nf; k++ {
+				if k == nf-1 {
+					b.WriteByte(digitsAll[1+x.intn(9)])
+				} else {
+					b.WriteByte(digitsAll[x.intn(10)])
+				}
+			}
+		}
+		b.WriteByte(fieldDes[i])
+	}
+	return b.String()
+}
+
+func mustRat(s string) *big.Rat {
+	r, ok := new(big.Rat).SetString(s)
+	if !ok {
+		panic("mustRat: " + s)
+	}
+	return r
+}
+
+func TestHegelIsodateAgrees(t *testing.T) {
+	if err := exec.Command("python3", "-c", "import isodate").Run(); err != nil {
+		t.Skip("python3 with isodate is not available")
+	}
+	x := xorshift(0x9E3779B97F4A7C15)
+	var items []string
+	seen := map[string]bool{}
+	for len(items) < 400 {
+		s := strictISO(&x)
+		m, ok := modelParse(s)
+		if !ok || len(m.tags) > 0 || seen[s] {
+			continue
+		}
+		seen[s] = true
+		items = append(items, s)
+	}
+	in, _ := json.Marshal(items)
+	cmd := exec.Command("python3", "-c", isodateScript)
+	cmd.Stdin = bytes.NewReader(in)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("python3: %v: %s", err, stderr.String())
+	}
+	var results []isodateResult
+	if err := json.Unmarshal(out, &results); err != nil || len(results) != len(items) {
+		t.Fatalf("bad output from python3: %v (%d results for %d items)", err, len(results), len(items))
+	}
+	bad := 0
+	for i, s := range items {
+		r := results[i]
+		p, perr := period.Parse(s)
+		if perr != nil {
+			t.Errorf("Parse(%q): %v (isodate ok=%v)", s, perr, r.OK)
+			bad++
+			continue
+		}
+		if !r.OK {
+			t.Errorf("isodate rejects %q (%s), Parse accepts it as %s", s, r.Err, p)
+			bad++
+			continue
+		}
+		v := valOf(p)
+		years, months := mustRat(r.Years), mustRat(r.Months)
+		rest := new(big.Rat).SetInt64(r.Days*86400 + r.Seconds)
+		rest.Add(rest, big.NewRat(r.US, 1000000))
+		wantRest := new(big.Rat).Add(new(big.Rat).Mul(new(big.Rat).Add(new(big.Rat).Mul(v.f[fW], rat7), v.f[fD]), rat86400), v.hms())
+		// isodate builds its timedelta from floats: allow a millisecond on the total
+		diff := new(big.Rat).Abs(new(big.Rat).Sub(wantRest, rest))
+		if v.f[fY].Cmp(years) != 0 || v.f[fMo].Cmp(months) != 0 || diff.Cmp(big.NewRat(1, 1000)) > 0 {
+			t.Errorf("%q: Parse gives %s (years %s, months %s, rest %s s); isodate years %s, months %s, rest %s s", s, p,
+				ratDec(v.f[fY]), ratDec(v.f[fMo]), wantRest.FloatString(6), r.Years, r.Months, rest.FloatString(6))
+			bad++
+		}
+		if bad > 10 {
+			t.Fatalf("too many disagreements")
+		}
+	}
+	t.Logf("isodate agreed on %d strings", len(items)-bad)
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..7f78e74
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,189 @@
+package period_test
+
+// Hegel property tests for rickb777/period, written for the Hegel zoo. See
+// targets/go/period/README.md.
+//
+// Oracle: the package's own documentation (doc.go, the type and method comments) read as a
+// specification, with the values of a period held as exact rationals (math/big): the ISO-8601
+// grammar the docs describe (with the documented extensions: a leading sign, a negative
+// field, weeks mixed with other fields, comma or point, the zero forms), the canonical string,
+// value preservation under Normalise/Simplify/Add/Subtract/Mul, the documented approximation
+// (365.2425 days per year, a twelfth of that per month, 24-hour days) for Duration and the
+// totals, time.AddDate for AddTo of whole calendar periods, the English format strings. The
+// Python isodate library is a reference test that runs when python3 with isodate is on PATH.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// "P0", listed among the zero forms in the godoc of Parse, is rejected
+	pZeroRejected bool
+	// designators are accepted in any order: "P1D1Y", "PT1S1H"
+	fieldOrderUnchecked bool
+	// a 'T' with nothing after it is accepted: "P1YT"
+	trailingTAccepted bool
+	// a number without digits before or after the decimal mark is accepted: "P.5Y", "P1.Y"
+	bareDotAccepted bool
+	// a fraction with only zero digits is kept as a fraction: "P1.0Y" is not "P1Y" (AddTo
+	// approximates it), "P1.0Y1D" and "P0.0Y1D" are rejected, "P1.50Y" keeps its trailing zero
+	zeroFractionKept bool
+	// NormaliseDaysToYears leaves the remainder of the division as a fractional days field in
+	// front of non-zero time fields, a period Parse then rejects
+	daysToYearsLeavesFraction bool
+	// Add and Mul produce periods with fractions in more than one field, which String renders
+	// and Parse then rejects
+	arithmeticSpreadsFractions bool
+	// Duration wraps around on overflow and still reports the result as precise
+	durationOverflowWraps bool
+	// Format prints the numbers with %v of a float64: "1e+06 years", 19-digit values rounded
+	formatUsesFloatFormatting bool
+	// TotalDaysApprox and TotalMonthsApprox ignore whole days of a fractional time field:
+	// PT48.5H gives 0 days
+	approxDaysIgnoreFractionalTime bool
+	// a number with more than 19 significant digits is rounded to 19 instead of rejected:
+	// "P0.00000000000000000001D" parses as P0D, "P1234567890123456789.5D" as P1234567890123456790D
+	parseRoundsBeyond19Digits bool
+	// Add, Mul and Simplify round a result that needs more than 19 digits instead of reporting
+	// an error (Simplify replaces the exact fields by rounded ones)
+	arithmeticRoundsBeyond19Digits bool
+	// SetInt and SetField on a negative period drop the sign of the other fields:
+	// -PT1329S.SetInt(274, Month) is P274MT1329S
+	setFieldDropsSign bool
+	// the whole-number getters round instead of truncating: PT7.6H.Hours() is 8
+	gettersRound bool
+	// Normalise and Simplify can leave the most significant field negative with the period's
+	// own sign positive: PT7H-5358M7484S.Normalise(true) is PT-80H-14M44S with Sign() +1
+	normaliseLeavesNegativeLead bool
+}{
+	pZeroRejected:                  true,
+	fieldOrderUnchecked:            true,
+	trailingTAccepted:              true,
+	bareDotAccepted:                true,
+	zeroFractionKept:               true,
+	daysToYearsLeavesFraction:      true,
+	arithmeticSpreadsFractions:     true,
+	durationOverflowWraps:          true,
+	formatUsesFloatFormatting:      true,
+	approxDaysIgnoreFractionalTime: true,
+	parseRoundsBeyond19Digits:      true,
+	arithmeticRoundsBeyond19Digits: true,
+	setFieldDropsSign:              true,
+	gettersRound:                   true,
+	normaliseLeavesNegativeLead:    true,
+}
