+package period_test
+
+// The model: a period as seven exact rational values, the strict grammar of the documentation
+// (with tags for the leniencies the library shows), the canonical string, and the generators.
+
+import (
+	"math/big"
+	"strings"
+	"time"
+
+	"github.com/govalues/decimal"
+	"github.com/rickb777/period"
+	"hegel.dev/go/hegel"
+)
+
+// field indices
+const (
+	fY = iota
+	fMo
+	fW
+	fD
+	fH
+	fMi
+	fS
+)
+
+var fieldNames = []string{"years", "months", "weeks", "days", "hours", "minutes", "seconds"}
+var fieldDes = []byte{'Y', 'M', 'W', 'D', 'H', 'M', 'S'}
+var designators = []period.Designator{period.Year, period.Month, period.Week, period.Day, period.Hour, period.Minute, period.Second}
+
+// val holds the signed values of the seven fields.
+type val struct{ f [7]*big.Rat }
+
+func zeroVal() val {
+	var v val
+	for i := range v.f {
+		v.f[i] = new(big.Rat)
+	}
+	return v
+}
+
+func ratOf(d decimal.Decimal) *big.Rat {
+	r, ok := new(big.Rat).SetString(d.String())
+	if !ok {
+		panic("ratOf: " + d.String())
+	}
+	return r
+}
+
+func valOf(p period.Period) val {
+	return val{[7]*big.Rat{ratOf(p.YearsDecimal()), ratOf(p.MonthsDecimal()), ratOf(p.WeeksDecimal()),
+		ratOf(p.DaysDecimal()), ratOf(p.HoursDecimal()), ratOf(p.MinutesDecimal()), ratOf(p.SecondsDecimal())}}
+}
+
+func (v val) eq(w val) bool {
+	for i := range v.f {
+		if v.f[i].Cmp(w.f[i]) != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+func (v val) isZero() bool {
+	for i := range v.f {
+		if v.f[i].Sign() != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// sign is the sign of the most significant non-zero field (the library's Sign).
+func (v val) sign() int {
+	for i := range v.f {
+		if s := v.f[i].Sign(); s != 0 {
+			return s
+		}
+	}
+	return 0
+}
+
+func (v val) neg() val {
+	var w val
+	for i := range v.f {
+		w.f[i] = new(big.Rat).Neg(v.f[i])
+	}
+	return w
+}
+
+func (v val) scale(k *big.Rat) val {
+	var w val
+	for i := range v.f {
+		w.f[i] = new(big.Rat).Mul(v.f[i], k)
+	}
+	return w
+}
+
+func (v val) add(w val) val {
+	var u val
+	for i := range v.f {
+		u.f[i] = new(big.Rat).Add(v.f[i], w.f[i])
+	}
+	return u
+}
+
+var (
+	ratDaysPerYear  = big.NewRat(3652425, 10000)
+	ratDaysPerMonth = new(big.Rat).Quo(ratDaysPerYear, big.NewRat(12, 1))
+	rat7            = big.NewRat(7, 1)
+	rat60           = big.NewRat(60, 1)
+	rat3600         = big.NewRat(3600, 1)
+	rat86400        = big.NewRat(86400, 1)
+	rat1e9          = big.NewRat(1000000000, 1)
+)
+
+// calDays is the calendar part in days under the documented approximation.
+func (v val) calDays() *big.Rat {
+	r := new(big.Rat).Mul(v.f[fY], ratDaysPerYear)
+	r.Add(r, new(big.Rat).Mul(v.f[fMo], ratDaysPerMonth))
+	r.Add(r, new(big.Rat).Mul(v.f[fW], rat7))
+	r.Add(r, v.f[fD])
+	return r
+}
+
+// hms is the time part in seconds.
+func (v val) hms() *big.Rat {
+	r := new(big.Rat).Mul(v.f[fH], rat3600)
+	r.Add(r, new(big.Rat).Mul(v.f[fMi], rat60))
+	r.Add(r, v.f[fS])
+	return r
+}
+
+// total is the whole period in seconds under the approximation (24-hour days).
+func (v val) total() *big.Rat {
+	r := new(big.Rat).Mul(v.calDays(), rat86400)
+	r.Add(r, v.hms())
+	return r
+}
+
+// trunc truncates toward zero.
+func trunc(r *big.Rat) *big.Int {
+	return new(big.Int).Quo(r.Num(), r.Denom())
+}
+
+// ratDec renders a rational with a finite decimal expansion as a plain decimal without
+// trailing zeros ("0.5", "-12", "1.25").
+func ratDec(r *big.Rat) string {
+	if r.Sign() == 0 {
+		return "0"
+	}
+	neg := r.Sign() < 0
+	x := new(big.Rat).Abs(r)
+	ten := big.NewRat(10, 1)
+	scale := 0
+	for !x.IsInt() && scale < 80 {
+		x.Mul(x, ten)
+		scale++
+	}
+	if !x.IsInt() {
+		panic("ratDec: not a decimal " + r.String())
+	}
+	digits := x.Num().String()
+	s := digits
+	if scale > 0 {
+		for len(digits) <= scale {
+			digits = "0" + digits
+		}
+		s = digits[:len(digits)-scale] + "." + digits[len(digits)-scale:]
+		s = strings.TrimRight(s, "0")
+		s = strings.TrimSuffix(s, ".")
+	}
+	if neg {
+		s = "-" + s
+	}
+	return s
+}
+
+// String is the canonical ISO form of the value: "P0D" for zero, otherwise the sign of the
+// most significant field in front, the fields in order, 'T' before the time fields.
+func (v val) String() string {
+	if v.isZero() {
+		return "P0D"
+	}
+	var b strings.Builder
+	if v.sign() < 0 {
+		b.WriteByte('-')
+		v = v.neg()
+	}
+	b.WriteByte('P')
+	for i := fY; i <= fD; i++ {
+		if v.f[i].Sign() != 0 {
+			b.WriteString(ratDec(v.f[i]))
+			b.WriteByte(fieldDes[i])
+		}
+	}
+	if v.f[fH].Sign() != 0 || v.f[fMi].Sign() != 0 || v.f[fS].Sign() != 0 {
+		b.WriteByte('T')
+		for i := fH; i <= fS; i++ {
+			if v.f[i].Sign() != 0 {
+				b.WriteString(ratDec(v.f[i]))
+				b.WriteByte(fieldDes[i])
+			}
+		}
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- the grammar
+
+// Leniency tags recorded by the model parser. Their expected effect on the library while the
+// corresponding Known switch is on: tagOrder, tagTrailingT and tagBareDot are accepted (the
+// strict grammar rejects them); tagP0 and tagZeroFraction are rejected (the documentation
+// accepts them). tagTrailingZeros is not a leniency: it marks input whose canonical form drops
+// trailing zeros of a fraction.
+const (
+	tagOrder         = "order"
+	tagTrailingT     = "trailing T"
+	tagBareDot       = "bare dot"
+	tagP0            = "P0"
+	tagZeroFraction  = "zero fraction"
+	tagTrailingZeros = "trailing zeros"
+	tagRounded       = "rounded"
+)
+
+type parsed struct {
+	v    val
+	tags []string
+}
+
+func (p *parsed) tag(t string) {
+	for _, x := range p.tags {
+		if x == t {
+			return
+		}
+	}
+	p.tags = append(p.tags, t)
+}
+
+func (p parsed) has(t string) bool {
+	for _, x := range p.tags {
+		if x == t {
+			return true
+		}
+	}
+	return false
+}
+
+// leniencyAccepted tells whether the library is expected to accept input carrying these tags.
+func (p parsed) leniencyAccepted() bool {
+	for _, t := range p.tags {
+		switch t {
+		case tagOrder:
+			if !Known.fieldOrderUnchecked {
+				return false
+			}
+		case tagTrailingT:
+			if !Known.trailingTAccepted {
+				return false
+			}
+		case tagBareDot:
+			if !Known.bareDotAccepted {
+				return false
+			}
+		case tagP0:
+			if Known.pZeroRejected {
+				return false
+			}
+		case tagZeroFraction:
+			if Known.zeroFractionKept {
+				return false
+			}
+		case tagRounded:
+			if !Known.parseRoundsBeyond19Digits {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func isDigit(c byte) bool { return '0' <= c && c <= '9' }
+
+// modelParse parses the documented grammar: [+|-] 'P' fields, the date fields Y M W D in that
+// order, then optionally 'T' and the time fields H M S in that order, each field a number
+// (optional '-', digits, optional '.' or ',' and digits) and its designator; each designator
+// at most once; only the last field with a non-zero value may have a non-zero fraction; the
+// zero forms P0Y P0M P0W P0D PT0H PT0M PT0S P0. Leniencies are tagged, not rejected.
+func modelParse(s string) (parsed, bool) {
+	out := parsed{v: zeroVal()}
+	i := 0
+	neg := false
+	if i < len(s) && (s[i] == '-' || s[i] == '+') {
+		neg = s[i] == '-'
+		i++
+	}
+	if i >= len(s) || s[i] != 'P' {
+		return out, false
+	}
+	i++
+	if s[i:] == "0" {
+		out.tag(tagP0)
+		return out, true
+	}
+	inTime := false
+	lastRank := 0 // rank within the current section
+	nFields := 0
+	var seenField [7]bool
+	fractionSeen := false // a non-zero fraction was seen on an earlier field
+	zeroFractionSeen := false
+	for i < len(s) {
+		if s[i] == 'T' {
+			if inTime {
+				return out, false
+			}
+			inTime = true
+			lastRank = 0
+			i++
+			if i == len(s) {
+				out.tag(tagTrailingT)
+			}
+			continue
+		}
+		// number
+		start := i
+		fneg := false
+		if s[i] == '-' {
+			fneg = true
+			i++
+		}
+		intDigits := 0
+		for i < len(s) && isDigit(s[i]) {
+			i++
+			intDigits++
+		}
+		hasMark := false
+		fracDigits := 0
+		fracStart := i
+		if i < len(s) && (s[i] == '.' || s[i] == ',') {
+			hasMark = true
+			i++
+			fracStart = i
+			for i < len(s) && isDigit(s[i]) {
+				i++
+				fracDigits++
+			}
+		}
+		if intDigits == 0 && fracDigits == 0 {
+			return out, false
+		}
+		if hasMark && (intDigits == 0 || fracDigits == 0) {
+			out.tag(tagBareDot)
+		}
+		if i >= len(s) {
+			return out, false // missing designator
+		}
+		des := s[i]
+		i++
+		var idx, rank int
+		switch des {
+		case 'Y':
+			idx, rank = fY, 1
+		case 'M':
+			if inTime {
+				idx, rank = fMi, 2
+			} else {
+				idx, rank = fMo, 2
+			}
+		case 'W':
+			idx, rank = fW, 3
+		case 'D':
+			idx, rank = fD, 4
+		case 'H':
+			idx, rank = fH, 1
+		case 'S':
+			idx, rank = fS, 3
+		default:
+			return out, false
+		}
+		if inTime != (idx >= fH) {
+			return out, false // a date designator after T or a time designator before it
+		}
+		if rank == lastRank || out.v.f[idx].Sign() != 0 || seenField[idx] {
+			// the same designator twice
+			return out, false
+		}
+		if rank < lastRank {
+			out.tag(tagOrder)
+		} else {
+			lastRank = rank
+		}
+		seenField[idx] = true
+		// the value
+		numText := strings.Replace(s[start:i-1], ",", ".", 1)
+		numText = strings.TrimPrefix(numText, "-")
+		if strings.HasPrefix(numText, ".") {
+			numText = "0" + numText
+		}
+		if strings.HasSuffix(numText, ".") {
+			numText += "0"
+		}
+		r, ok := new(big.Rat).SetString(numText)
+		if !ok {
+			return out, false
+		}
+		if fneg {
+			r.Neg(r)
+		}
+		// the fields hold 19 digits: a longer integer part is out of range, and more digits
+		// than that in all are rounded away (tagRounded)
+		intPart := len(trunc(new(big.Rat).Abs(r)).String())
+		if trunc(r).Sign() == 0 {
+			intPart = 0
+		}
+		if intPart > 19 {
+			return out, false
+		}
+		if intPart+fracDigits > 19 {
+			out.tag(tagRounded)
+		}
+		fracText := s[fracStart : fracStart+fracDigits]
+		nonZeroFraction := hasMark && strings.Trim(fracText, "0") != ""
+		zeroFraction := hasMark && fracDigits > 0 && !nonZeroFraction
+		if hasMark && fracDigits > 0 && strings.HasSuffix(fracText, "0") {
+			out.tag(tagTrailingZeros)
+		}
+		if r.Sign() != 0 {
+			if fractionSeen {
+				return out, false // a fraction on a field that is not the last non-zero one
+			}
+			if zeroFractionSeen {
+				out.tag(tagZeroFraction)
+			}
+		}
+		if nonZeroFraction {
+			fractionSeen = true
+		}
+		if zeroFraction {
+			zeroFractionSeen = true
+		}
+		out.v.f[idx] = r
+		nFields++
+	}
+	if nFields == 0 {
+		return out, false
+	}
+	if neg {
+		out.v = out.v.neg()
+	}
+	return out, true
+}
+
+// --------------------------------------------------------------------------- generators
+
+var digitsAll = "0123456789"
+
+// genNumber draws the text of a field: digits, optionally a fraction (with mark '.' or ',').
+// wantFraction asks for a non-zero fraction; allowZeroFraction lets a fraction be all zeros.
+func genNumber(tc hegel.TestCase, wantFraction bool, maxFrac int) string {
+	var b strings.Builder
+	nInt := 1
+	switch drawInt(tc, 1, 10) {
+	case 1:
+		nInt = 0
+	case 2, 3, 4, 5:
+		nInt = 1
+	case 6, 7, 8:
+		nInt = drawInt(tc, 2, 4)
+	case 9:
+		nInt = drawInt(tc, 5, 12)
+	case 10:
+		nInt = drawInt(tc, 13, 18)
+	}
+	if nInt == 0 {
+		b.WriteByte('0')
+	}
+	for k := 0; k < nInt; k++ {
+		if k == 0 && nInt > 1 && chance(tc, 90) {
+			b.WriteByte(digitsAll[drawInt(tc, 1, 9)])
+		} else {
+			b.WriteByte(digitsAll[drawInt(tc, 0, 9)])
+		}
+	}
+	if wantFraction {
+		if chance(tc, 15) {
+			b.WriteByte(',')
+		} else {
+			b.WriteByte('.')
+		}
+		n := drawInt(tc, 1, maxFrac)
+		for k := 0; k < n; k++ {
+			if k == n-1 && chance(tc, 85) {
+				b.WriteByte(digitsAll[drawInt(tc, 1, 9)])
+			} else {
+				b.WriteByte(digitsAll[drawInt(tc, 0, 9)])
+			}
+		}
+	}
+	return b.String()
+}
+
+var zeroForms = []string{"P0Y", "P0M", "P0W", "P0D", "PT0H", "PT0M", "PT0S", "P0"}
+
+// genISO draws a period string of the documented grammar (occasionally with the leniencies
+// the model tags: a zero fraction, "P0"). maxFrac bounds the fraction digits.
+func genISO(tc hegel.TestCase, maxFrac int, fieldNeg bool) string {
+	if chance(tc, 4) {
+		return pick(tc, zeroForms)
+	}
+	var b strings.Builder
+	switch drawInt(tc, 1, 20) {
+	case 1, 2, 3:
+		b.WriteByte('-')
+	case 4:
+		b.WriteByte('+')
+	}
+	b.WriteByte('P')
+	var present [7]bool
+	n := 0
+	for i := range present {
+		present[i] = chance(tc, 45)
+		if present[i] {
+			n++
+		}
+	}
+	if n == 0 {
+		present[drawInt(tc, 0, 6)] = true
+	}
+	last := -1
+	for i := 6; i >= 0; i-- {
+		if present[i] {
+			last = i
+			break
+		}
+	}
+	fractionOn := -1
+	if chance(tc, 35) {
+		fractionOn = last
+	}
+	first := true
+	wroteT := false
+	for i := 0; i < 7; i++ {
+		if !present[i] {
+			continue
+		}
+		if i >= fH && !wroteT {
+			b.WriteByte('T')
+			wroteT = true
+		}
+		if !first && fieldNeg && chance(tc, 12) {
+			b.WriteByte('-')
+		}
+		if chance(tc, 6) {
+			b.WriteByte('0') // a zero-valued field
+			if chance(tc, 30) {
+				b.WriteString(".0")
+			}
+		} else {
+			b.WriteString(genNumber(tc, i == fractionOn || (chance(tc, 3) && i != last), maxFrac))
+		}
+		b.WriteByte(fieldDes[i])
+		first = false
+	}
+	return b.String()
+}
+
+var mutAlphabet = "PTYMWDHS0123456789.,-+"
+
+// mutate applies one to three edits to a period string.
+func mutate(tc hegel.TestCase, s string) string {
+	n := drawInt(tc, 1, 3)
+	for k := 0; k < n; k++ {
+		if len(s) == 0 {
+			return string(mutAlphabet[drawInt(tc, 0, len(mutAlphabet)-1)])
+		}
+		i := drawInt(tc, 0, len(s)-1)
+		c := mutAlphabet[drawInt(tc, 0, len(mutAlphabet)-1)]
+		switch drawInt(tc, 1, 5) {
+		case 1:
+			s = s[:i] + string(c) + s[i:]
+		case 2:
+			s = s[:i] + s[i+1:]
+		case 3:
+			s = s[:i] + string(c) + s[i+1:]
+		case 4:
+			if i+1 < len(s) {
+				s = s[:i] + s[i+1:i+2] + s[i:i+1] + s[i+2:]
+			}
+		case 5:
+			j := drawInt(tc, i, len(s)-1)
+			s = s[:j+1] + s[i:j+1] + s[j+1:]
+		}
+	}
+	return s
+}
+
+var mulFactors = []string{"0", "1", "-1", "2", "-2", "0.5", "1.5", "-0.25", "10", "100", "0.001", "3", "7", "1.1", "12", "60"}
+
+// genPeriod draws a period: mostly Parse of a generated string, otherwise the constructors.
+func genPeriod(tc hegel.TestCase) period.Period {
+	switch drawInt(tc, 1, 10) {
+	case 1:
+		return period.New(drawInt(tc, -50, 50), drawInt(tc, -30, 30), drawInt(tc, -10, 10), drawInt(tc, -400, 400),
+			drawInt(tc, -100, 100), drawInt(tc, -200, 200), drawInt(tc, -10000, 10000))
+	case 2:
+		return period.NewOf(time.Duration(drawInt(tc, -100000000, 100000000)) * time.Duration(pick(tc, []int{1, 1000, 1000000, 1000000000, 36000000000})))
+	case 3:
+		var ds [7]decimal.Decimal
+		last := -1
+		for i := range ds {
+			if chance(tc, 50) {
+				last = i
+			}
+		}
+		for i := range ds {
+			if chance(tc, 50) || i == last {
+				txt := genNumber(tc, i == last && chance(tc, 40), 6)
+				if i > 0 && chance(tc, 10) {
+					txt = "-" + txt
+				}
+				d, err := decimal.Parse(txt)
+				if err != nil {
+					d = decimal.Zero
+				}
+				ds[i] = d
+			}
+		}
+		p, err := period.NewDecimal(ds[0], ds[1], ds[2], ds[3], ds[4], ds[5], ds[6])
+		if err != nil {
+			return period.Zero
+		}
+		return p
+	}
+	for k := 0; k < 6; k++ {
+		s := genISO(tc, 9, true)
+		p, err := period.Parse(s)
+		if err == nil {
+			return p
+		}
+	}
+	return period.Zero
+}
