diff --git a/hegel/common.go b/hegel/common.go
new file mode 100644
index 0000000..11b7fed
--- /dev/null
+++ b/hegel/common.go
@@ -0,0 +1,162 @@
+package hegel
+
+// Generators and comparison helpers shared by the JWS, JWE and JWT properties.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"hegel.dev/go/hegel"
+)
+
+var payloads = [][]byte{{}, []byte("hi"), []byte(`{"a":1}`), []byte("a.b.c"), {0, 1, 2, 255, 254}, []byte("é ü 日本"), []byte(strings.Repeat("x", 300)), []byte("\n"), []byte(" "), []byte("===")}
+
+func genPayload(tc hegel.TestCase) []byte {
+	if chance(tc, 30) {
+		return randBytes(n(tc, 0, 64))
+	}
+	return pick(tc, payloads...)
+}
+
+// headerSpec: the extra protected header members generated for a signature or encryption.
+type headerSpec map[string]interface{}
+
+func genHeaders(tc hegel.TestCase) headerSpec {
+	h := headerSpec{}
+	if chance(tc, 40) {
+		h["typ"] = pick(tc, "JWT", "JOSE", "application/example", "jose+json")
+	}
+	if chance(tc, 25) {
+		h["cty"] = pick(tc, "JWT", "text/plain", "example")
+	}
+	if chance(tc, 30) {
+		h["x-custom"] = pick(tc, []interface{}{"v", float64(3), true, nil, []interface{}{"a", float64(1)}, map[string]interface{}{"k": "v"}, "é"}...)
+	}
+	return h
+}
+
+// signerOptions puts the generated headers into SignerOptions (typ and cty through their setters).
+func signerOptions(h headerSpec) *jose.SignerOptions {
+	opts := &jose.SignerOptions{}
+	for k, v := range h {
+		switch k {
+		case "typ":
+			opts.WithType(jose.ContentType(v.(string)))
+		case "cty":
+			opts.WithContentType(jose.ContentType(v.(string)))
+		default:
+			opts.WithHeader(jose.HeaderKey(k), v)
+		}
+	}
+	return opts
+}
+
+func encrypterOptions(h headerSpec, zip bool) *jose.EncrypterOptions {
+	opts := &jose.EncrypterOptions{}
+	if zip {
+		opts.Compression = jose.DEFLATE
+	}
+	for k, v := range h {
+		switch k {
+		case "typ":
+			opts.WithType(jose.ContentType(v.(string)))
+		case "cty":
+			opts.WithContentType(jose.ContentType(v.(string)))
+		default:
+			opts.WithHeader(jose.HeaderKey(k), v)
+		}
+	}
+	return opts
+}
+
+// headerMap is go-jose's parsed Header as the JSON object it came from.
+func headerMap(h jose.Header) map[string]interface{} {
+	m := map[string]interface{}{}
+	if h.Algorithm != "" {
+		m["alg"] = h.Algorithm
+	}
+	if h.KeyID != "" {
+		m["kid"] = h.KeyID
+	}
+	if h.Nonce != "" {
+		m["nonce"] = h.Nonce
+	}
+	if h.JSONWebKey != nil {
+		raw, _ := json.Marshal(h.JSONWebKey)
+		var v interface{}
+		json.Unmarshal(raw, &v)
+		m["jwk"] = v
+	}
+	for k, v := range h.ExtraHeaders {
+		m[string(k)] = v
+	}
+	return m
+}
+
+// compactHeader decodes the protected header of a compact serialization.
+func compactHeader(compact string) map[string]interface{} {
+	part := strings.SplitN(compact, ".", 2)[0]
+	raw, err := base64.RawURLEncoding.DecodeString(part)
+	if err != nil {
+		return map[string]interface{}{"INVALID": part}
+	}
+	var m map[string]interface{}
+	if err := json.Unmarshal(raw, &m); err != nil {
+		return map[string]interface{}{"INVALID": string(raw)}
+	}
+	return m
+}
+
+func isASCII(b []byte) bool {
+	for _, c := range b {
+		if c >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
+
+// algAdded: header members a key-management algorithm adds to the header it is given.
+var algAdded = map[string]bool{"iv": true, "tag": true, "epk": true, "p2s": true, "p2c": true}
+
+// headerDiff reports why got is not want plus algorithm-added members, or "".
+func headerDiff(got, want map[string]interface{}) string {
+	for k, v := range want {
+		if string(mustJSON(got[k])) != string(mustJSON(v)) {
+			return fmt.Sprintf("member %s is %s, want %s", k, mustJSON(got[k]), mustJSON(v))
+		}
+	}
+	for k := range got {
+		if _, ok := want[k]; !ok && !algAdded[k] {
+			return fmt.Sprintf("unexpected member %s", k)
+		}
+	}
+	return ""
+}
+
+// subsetDiff reports a member of want that got lacks or has differently, or "".
+func subsetDiff(got, want map[string]interface{}) string {
+	for k, v := range want {
+		if string(mustJSON(got[k])) != string(mustJSON(v)) {
+			return fmt.Sprintf("member %s is %s, want %s", k, mustJSON(got[k]), mustJSON(v))
+		}
+	}
+	return ""
+}
+
+// normClaims writes a single-string aud as a one-element array (RFC 7519 allows either form).
+func normClaims(m map[string]interface{}) []byte {
+	out := map[string]interface{}{}
+	for k, v := range m {
+		if k == "aud" {
+			if str, ok := v.(string); ok {
+				v = []interface{}{str}
+			}
+		}
+		out[k] = v
+	}
+	return mustJSON(out)
+}
diff --git a/hegel/hegel_jwe_test.go b/hegel/hegel_jwe_test.go
new file mode 100644
index 0000000..2bcfffe
--- /dev/null
+++ b/hegel/hegel_jwe_test.go
@@ -0,0 +1,423 @@
+package hegel
+
+// JWE against joserfc: what one encrypts the other decrypts, with the same plaintext and headers.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"hegel.dev/go/hegel"
+)
+
+var encs = []string{"A128CBC-HS256", "A192CBC-HS384", "A256CBC-HS512", "A128GCM", "A192GCM", "A256GCM"}
+
+func keyAlgs(names ...string) []jose.KeyAlgorithm {
+	var out []jose.KeyAlgorithm
+	for _, n := range names {
+		out = append(out, jose.KeyAlgorithm(n))
+	}
+	return out
+}
+
+// recipientSpec is one generated recipient: a key and a key-management algorithm.
+type recipientSpec struct {
+	key keyInfo
+	alg string
+}
+
+// singleOnly: algorithms that allow one recipient only (the CEK is the key or derived from it).
+func singleOnly(alg string) bool {
+	return alg == "dir" || alg == "ECDH-ES"
+}
+
+// genRecipient picks a key and an algorithm; enc is the content encryption the message uses
+// (for "dir" the key must be of the CEK's length, so the key decides enc).
+func genRecipient(tc hegel.TestCase, enc *string, allowSingle bool) recipientSpec {
+	for {
+		k := pick(tc, encryptionKeys()...)
+		var algs []string
+		algs = append(algs, k.encAlgs...)
+		if k.dirEnc != "" && allowSingle && (*enc == "" || *enc == k.dirEnc) {
+			algs = append(algs, "dir")
+		}
+		if len(algs) == 0 {
+			continue
+		}
+		alg := pick(tc, algs...)
+		if singleOnly(alg) && !allowSingle {
+			continue
+		}
+		if alg == "dir" {
+			*enc = k.dirEnc
+		}
+		return recipientSpec{key: k, alg: alg}
+	}
+}
+
+func (rc recipientSpec) recipient() jose.Recipient {
+	return jose.Recipient{Algorithm: jose.KeyAlgorithm(rc.alg), Key: rc.key.public, KeyID: rc.key.name}
+}
+
+func recipientAlgs(rcpts []recipientSpec) []string {
+	var out []string
+	for _, rc := range rcpts {
+		out = append(out, rc.alg)
+	}
+	return out
+}
+
+// TestHegelEncryptDecryptedByJoserfc: a compact JWE from NewEncrypter/Encrypt (every
+// key-management algorithm × content encryption the key pool supports, optional DEF compression,
+// protected typ, cty and a private member, plaintext of any bytes) decrypts in joserfc with the
+// private key to the same plaintext, and joserfc reads the protected header written; go-jose
+// reads its own output back to the same header.
+func TestHegelEncryptDecryptedByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		enc := ""
+		rcpt := genRecipient(tc, &enc, true)
+		if enc == "" {
+			enc = pick(tc, encs...)
+		}
+		plaintext := genPayload(tc)
+		h := genHeaders(tc)
+		if id := knownNullHeader(h); id != "" {
+			count("known " + id)
+			return
+		}
+		zip := chance(tc, 25)
+		encrypter, err := jose.NewEncrypter(jose.ContentEncryption(enc), rcpt.recipient(), encrypterOptions(h, zip))
+		if err != nil {
+			fail(ht, "NewEncrypter %s/%s with %s: %v", rcpt.alg, enc, rcpt.key.name, err)
+		}
+		obj, err := encrypter.Encrypt(plaintext)
+		if err != nil {
+			fail(ht, "Encrypt %s/%s with %s: %v", rcpt.alg, enc, rcpt.key.name, err)
+		}
+		encrypted, err := obj.CompactSerialize()
+		if err != nil {
+			fail(ht, "CompactSerialize %s/%s: %v", rcpt.alg, enc, err)
+		}
+		var r struct {
+			reply
+			Plaintext string
+			Protected map[string]interface{}
+		}
+		ask(&r, "ED", []byte(encrypted), rcpt.key.privJSON, mustJSON([]string{rcpt.alg, enc}))
+		if !r.Ok {
+			fail(ht, "joserfc cannot decrypt go-jose's %s/%s (zip=%v) %s: %s %s", rcpt.alg, enc, zip, encrypted, r.Error, r.Message)
+		}
+		if r.Plaintext != base64.RawURLEncoding.EncodeToString(plaintext) {
+			fail(ht, "%s/%s: joserfc decrypts to %q, encrypted %q", rcpt.alg, enc, r.Plaintext, plaintext)
+		}
+		want := compactHeader(encrypted)
+		if string(mustJSON(want)) != string(mustJSON(r.Protected)) {
+			fail(ht, "%s/%s: header written %s, joserfc reads %s", rcpt.alg, enc, mustJSON(want), mustJSON(r.Protected))
+		}
+		if want["alg"] != rcpt.alg || want["enc"] != enc || want["kid"] != rcpt.key.name || (zip && want["zip"] != "DEF") || (!zip && want["zip"] != nil) {
+			fail(ht, "%s/%s zip=%v kid %s: go-jose wrote header %s", rcpt.alg, enc, zip, rcpt.key.name, mustJSON(want))
+		}
+		for key, v := range h {
+			if string(mustJSON(want[key])) != string(mustJSON(v)) {
+				fail(ht, "%s/%s: header %s written as %s, set %s", rcpt.alg, enc, key, mustJSON(want[key]), mustJSON(v))
+			}
+		}
+		back, err := jose.ParseEncrypted(encrypted, keyAlgs(rcpt.alg), []jose.ContentEncryption{jose.ContentEncryption(enc)})
+		if err != nil {
+			fail(ht, "ParseEncrypted of its own %s: %v", encrypted, err)
+		} else {
+			if hm := headerMap(back.Header); string(mustJSON(hm)) != string(mustJSON(want)) {
+				fail(ht, "%s/%s: go-jose reads its own header as %s, wrote %s", rcpt.alg, enc, mustJSON(hm), mustJSON(want))
+			}
+			if pt, err := back.Decrypt(rcpt.key.private); err != nil || string(pt) != string(plaintext) {
+				fail(ht, "Decrypt of its own %s: %q, %v", encrypted, pt, err)
+			}
+		}
+		count(rcpt.alg + " " + enc)
+	})
+}
+
+// TestHegelEncryptJSONDecryptedByJoserfc: the full JSON serialization for one to three
+// recipients (each with its own key-management algorithm and kid, optional AAD) decrypts in
+// joserfc against the key set to the same plaintext, with the same protected header, AAD and
+// per-recipient headers; one recipient gives the flattened form; go-jose reads its own output.
+func TestHegelEncryptJSONDecryptedByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		enc := ""
+		nrcpt := pick(tc, 1, 1, 2, 3)
+		var rcpts []recipientSpec
+		seen := map[string]bool{}
+		for i := 0; i < nrcpt; i++ {
+			rc := genRecipient(tc, &enc, nrcpt == 1)
+			if seen[rc.key.name] {
+				continue
+			}
+			seen[rc.key.name] = true
+			rcpts = append(rcpts, rc)
+		}
+		if enc == "" {
+			enc = pick(tc, encs...)
+		}
+		plaintext := genPayload(tc)
+		h := genHeaders(tc)
+		if id := knownNullHeader(h); id != "" {
+			count("known " + id)
+			return
+		}
+		if !isASCII(mustJSON(h)) {
+			count("joserfc re-encodes non-ASCII protected headers")
+			return
+		}
+		zip := chance(tc, 20)
+		var aad []byte
+		if chance(tc, 35) {
+			aad = pick(tc, []byte("extra"), randBytes(n(tc, 1, 40)), []byte("日本"))
+		}
+		var recs []jose.Recipient
+		var keySet []json.RawMessage
+		for _, rc := range rcpts {
+			recs = append(recs, rc.recipient())
+			keySet = append(keySet, rc.key.privJSON)
+		}
+		var encrypter jose.Encrypter
+		var err error
+		if len(recs) == 1 && (singleOnly(rcpts[0].alg) || chance(tc, 50)) {
+			encrypter, err = jose.NewEncrypter(jose.ContentEncryption(enc), recs[0], encrypterOptions(h, zip))
+		} else {
+			encrypter, err = jose.NewMultiEncrypter(jose.ContentEncryption(enc), recs, encrypterOptions(h, zip))
+		}
+		algs := append([]string{enc}, recipientAlgs(rcpts)...)
+		if err != nil {
+			fail(ht, "NewMultiEncrypter %v: %v", algs, err)
+		}
+		var obj *jose.JSONWebEncryption
+		if aad != nil {
+			obj, err = encrypter.EncryptWithAuthData(plaintext, aad)
+		} else {
+			obj, err = encrypter.Encrypt(plaintext)
+		}
+		if err != nil {
+			fail(ht, "Encrypt JSON %v: %v", algs, err)
+		}
+		encrypted := obj.FullSerialize()
+		var r struct {
+			reply
+			Plaintext   string
+			AAD         string `json:"aad"`
+			Protected   map[string]interface{}
+			Unprotected map[string]interface{}
+			Recipients  []map[string]interface{}
+		}
+		ask(&r, "DJ", []byte(encrypted), mustJSON(keySet), mustJSON(algs))
+		if !r.Ok {
+			fail(ht, "joserfc cannot decrypt go-jose's JSON JWE %v (aad=%q): %s %s\n%s", algs, aad, r.Error, r.Message, encrypted)
+		}
+		if r.Plaintext != base64.RawURLEncoding.EncodeToString(plaintext) {
+			fail(ht, "JSON %v: joserfc decrypts to %q, encrypted %q", algs, r.Plaintext, plaintext)
+		}
+		if r.AAD != base64.RawURLEncoding.EncodeToString(aad) {
+			fail(ht, "JSON %v: joserfc reads aad %q, given %q\n%s", algs, r.AAD, aad, encrypted)
+		}
+		if len(r.Recipients) != len(rcpts) {
+			fail(ht, "JSON %v: joserfc sees %d recipients, want %d\n%s", algs, len(r.Recipients), len(rcpts), encrypted)
+		}
+		var top map[string]json.RawMessage
+		json.Unmarshal([]byte(encrypted), &top)
+		_, general := top["recipients"]
+		if flattened := !general; flattened != (len(rcpts) == 1) {
+			fail(ht, "JSON with %d recipients: flattened=%v\n%s", len(rcpts), flattened, encrypted)
+		}
+		wantProtected := map[string]interface{}{"enc": enc}
+		if zip {
+			wantProtected["zip"] = "DEF"
+		}
+		for k, v := range h {
+			wantProtected[k] = v
+		}
+		if len(rcpts) == 1 {
+			wantProtected["alg"] = rcpts[0].alg
+			wantProtected["kid"] = rcpts[0].key.name
+		}
+		if why := headerDiff(r.Protected, wantProtected); why != "" {
+			fail(ht, "JSON %v: protected header joserfc reads %s: %s\n%s", algs, mustJSON(r.Protected), why, encrypted)
+		}
+		for i, rc := range rcpts {
+			if i >= len(r.Recipients) {
+				break
+			}
+			rh := r.Recipients[i]
+			if rh == nil {
+				rh = map[string]interface{}{}
+			}
+			if len(rcpts) > 1 && (rh["alg"] != rc.alg || rh["kid"] != rc.key.name) {
+				fail(ht, "JSON recipient %d: header %s, want alg %s kid %s\n%s", i, mustJSON(rh), rc.alg, rc.key.name, encrypted)
+			}
+		}
+		back, err := jose.ParseEncrypted(encrypted, keyAlgs(recipientAlgs(rcpts)...), []jose.ContentEncryption{jose.ContentEncryption(enc)})
+		if err != nil {
+			fail(ht, "ParseEncrypted of its own output: %v\n%s", err, encrypted)
+		} else {
+			if string(back.GetAuthData()) != string(aad) {
+				fail(ht, "GetAuthData %q, given %q", back.GetAuthData(), aad)
+			}
+			for i, rc := range rcpts {
+				idx, hdr, pt, err := back.DecryptMulti(rc.key.private)
+				if err != nil || idx != i || string(pt) != string(plaintext) {
+					fail(ht, "DecryptMulti of its own output with %s: index %d, %q, %v (want %d)\n%s", rc.key.name, idx, pt, err, i, encrypted)
+				}
+				hm := headerMap(hdr)
+				want := map[string]interface{}{"alg": rc.alg, "kid": rc.key.name}
+				for k, v := range wantProtected {
+					want[k] = v
+				}
+				if why := subsetDiff(hm, want); why != "" {
+					fail(ht, "DecryptMulti header for %s is %s: %s", rc.key.name, mustJSON(hm), why)
+				}
+			}
+		}
+		count(fmt.Sprintf("%d recipients aad=%v", len(rcpts), aad != nil))
+	})
+}
+
+// TestHegelJoserfcEncryptDecryptedByGoJose: a compact or JSON JWE made by joserfc (any
+// algorithms, DEF, AAD and an unprotected header in the JSON form, the alg in the protected or
+// the recipient header) parses with ParseEncrypted, decrypts with any one recipient's private key
+// to the plaintext, and the merged header carries what was written.
+func TestHegelJoserfcEncryptDecryptedByGoJose(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		enc := ""
+		useJSON := chance(tc, 40)
+		nrcpt := 1
+		if useJSON {
+			nrcpt = pick(tc, 1, 1, 2, 3)
+		}
+		var rcpts []recipientSpec
+		seen := map[string]bool{}
+		for i := 0; i < nrcpt; i++ {
+			rc := genRecipient(tc, &enc, nrcpt == 1)
+			if seen[rc.key.name] {
+				continue
+			}
+			seen[rc.key.name] = true
+			rcpts = append(rcpts, rc)
+		}
+		if enc == "" {
+			enc = pick(tc, encs...)
+		}
+		plaintext := genPayload(tc)
+		protected := map[string]interface{}{"enc": enc}
+		h := genHeaders(tc)
+		if id := knownNullHeader(h); id != "" {
+			count("known " + id)
+			return
+		}
+		for k, v := range h {
+			protected[k] = v
+		}
+		if chance(tc, 25) {
+			protected["zip"] = "DEF"
+		}
+		var token string
+		var aad []byte
+		unprotected := map[string]interface{}{}
+		recipientHeaders := map[string]map[string]interface{}{}
+		if useJSON {
+			type rec struct {
+				Header map[string]interface{} `json:"header"`
+				Key    json.RawMessage        `json:"key"`
+			}
+			var recs []rec
+			for _, rc := range rcpts {
+				hdr := map[string]interface{}{"alg": rc.alg, "kid": rc.key.name}
+				recs = append(recs, rec{Header: hdr, Key: rc.key.pubJSON})
+				recipientHeaders[rc.key.name] = hdr
+			}
+			if len(rcpts) == 1 && chance(tc, 40) {
+				protected["alg"] = rcpts[0].alg
+				recs[0].Header = map[string]interface{}{"kid": rcpts[0].key.name}
+				recipientHeaders[rcpts[0].key.name] = recs[0].Header
+			}
+			if chance(tc, 40) {
+				aad = pick(tc, []byte("extra"), []byte(""), randBytes(n(tc, 1, 40)), []byte("日本"))
+			}
+			flattened := "0"
+			if len(rcpts) == 1 && chance(tc, 60) {
+				flattened = "1"
+			}
+			unprot := []byte("")
+			if chance(tc, 30) {
+				unprotected["x-unprotected"] = "u"
+				unprot = mustJSON(unprotected)
+			}
+			var r struct {
+				reply
+				JSON json.RawMessage `json:"json"`
+			}
+			ask(&r, "EJ", mustJSON(protected), plaintext, mustJSON(recs), aad, s(flattened), unprot)
+			if !r.Ok {
+				count("joserfc cannot encrypt: " + r.Error)
+				return
+			}
+			token = string(r.JSON)
+		} else {
+			protected["alg"] = rcpts[0].alg
+			if chance(tc, 50) {
+				protected["kid"] = rcpts[0].key.name
+			}
+			var r struct {
+				reply
+				Compact string
+			}
+			ask(&r, "EE", mustJSON(protected), plaintext, rcpts[0].key.pubJSON)
+			if !r.Ok {
+				count("joserfc cannot encrypt: " + r.Error)
+				return
+			}
+			token = r.Compact
+		}
+		obj, err := jose.ParseEncrypted(token, keyAlgs(recipientAlgs(rcpts)...), []jose.ContentEncryption{jose.ContentEncryption(enc)})
+		if err != nil {
+			fail(ht, "ParseEncrypted of joserfc's %v/%s (json=%v): %v\n%s", recipientAlgs(rcpts), enc, useJSON, err, token)
+		}
+		if string(obj.GetAuthData()) != string(aad) {
+			fail(ht, "GetAuthData %q, joserfc used %q\n%s", obj.GetAuthData(), aad, token)
+		}
+		i := n(tc, 0, len(rcpts)-1)
+		rc := rcpts[i]
+		idx, hdr, got, err := obj.DecryptMulti(rc.key.private)
+		if err != nil {
+			fail(ht, "DecryptMulti of joserfc's %s/%s (json=%v, aad=%q) with %s: %v\n%s", rc.alg, enc, useJSON, aad, rc.key.name, err, token)
+		}
+		if string(got) != string(plaintext) {
+			fail(ht, "%s/%s: DecryptMulti gives %q, joserfc encrypted %q", rc.alg, enc, got, plaintext)
+		}
+		if idx != i {
+			fail(ht, "%s/%s: DecryptMulti with %s says recipient %d, want %d\n%s", rc.alg, enc, rc.key.name, idx, i, token)
+		}
+		if len(rcpts) == 1 {
+			if got, err := obj.Decrypt(rc.key.private); err != nil || string(got) != string(plaintext) {
+				fail(ht, "%s/%s: Decrypt gives %q, %v\n%s", rc.alg, enc, got, err, token)
+			}
+		}
+		want := map[string]interface{}{}
+		for k, v := range protected {
+			want[k] = v
+		}
+		for k, v := range unprotected {
+			want[k] = v
+		}
+		for k, v := range recipientHeaders[rc.key.name] {
+			want[k] = v
+		}
+		hm := headerMap(hdr)
+		if why := headerDiff(hm, want); why != "" {
+			fail(ht, "%s/%s: go-jose's merged header %s, written %s: %s\n%s", rc.alg, enc, mustJSON(hm), mustJSON(want), why, token)
+		}
+		count(fmt.Sprintf("%s %s json=%v", rc.alg, enc, useJSON))
+	})
+}
diff --git a/hegel/hegel_jwk_test.go b/hegel/hegel_jwk_test.go
new file mode 100644
index 0000000..865c018
--- /dev/null
+++ b/hegel/hegel_jwk_test.go
@@ -0,0 +1,184 @@
+package hegel
+
+// JSONWebKey against joserfc: thumbprints, and key JSON read each way.
+
+import (
+	"crypto"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"hegel.dev/go/hegel"
+)
+
+var hashes = map[string]crypto.Hash{"sha256": crypto.SHA256, "sha384": crypto.SHA384, "sha512": crypto.SHA512}
+
+// TestHegelThumbprintMatchesJoserfc: JSONWebKey.Thumbprint (RFC 7638) of every key type, public
+// or private, with SHA-256/384/512, is joserfc's thumbprint of the same key.
+func TestHegelThumbprintMatchesJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, keys()...)
+		hname := pick(tc, "sha256", "sha384", "sha512")
+		key, raw := k.public, k.pubJSON
+		if chance(tc, 40) {
+			key, raw = k.private, k.privJSON
+		}
+		if id := knownThumbprint(k); id != "" {
+			count("known " + id)
+			return
+		}
+		jwk := jose.JSONWebKey{Key: key, KeyID: k.name}
+		tp, err := jwk.Thumbprint(hashes[hname])
+		if err != nil {
+			fail(ht, "%s.Thumbprint(%s): %v", k.name, hname, err)
+		}
+		got := base64.RawURLEncoding.EncodeToString(tp)
+		var r struct {
+			reply
+			Thumbprint string
+		}
+		ask(&r, "T", raw, s(hname))
+		if !r.Ok {
+			fail(ht, "joserfc cannot read %s: %s %s", raw, r.Error, r.Message)
+		}
+		if got != r.Thumbprint {
+			fail(ht, "%s thumbprint %s: go-jose %s, joserfc %s", k.name, hname, got, r.Thumbprint)
+		}
+		count(k.kty)
+	})
+}
+
+// TestHegelKeyJSONReadByJoserfc: the JSON go-jose writes for a key (public or private; with a kid
+// or not; alg and use set or not) is read by joserfc as the same key: the same members, the same
+// public/private nature, and Public() is the public part joserfc computes; IsPublic and Valid
+// agree with joserfc.
+func TestHegelKeyJSONReadByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, keys()...)
+		private := chance(tc, 50)
+		jwk := jose.JSONWebKey{Key: k.public}
+		if private {
+			jwk.Key = k.private
+		}
+		if chance(tc, 70) {
+			jwk.KeyID = pick(tc, k.name, "k1", "a-b.c")
+		}
+		if chance(tc, 30) && len(k.sigAlgs) > 0 {
+			jwk.Algorithm = pick(tc, k.sigAlgs...)
+		}
+		if chance(tc, 30) {
+			jwk.Use = pick(tc, "sig", "enc")
+		}
+		raw, err := json.Marshal(jwk)
+		if err != nil {
+			fail(ht, "marshal %s: %v", k.name, err)
+		}
+		if id := knownValid(k.kty); id != "" {
+			count("known " + id)
+		} else if !jwk.Valid() {
+			fail(ht, "%s: Valid() is false", raw)
+		}
+		var r struct {
+			reply
+			Dict    json.RawMessage
+			Public  json.RawMessage
+			Private bool
+			Kty     string
+		}
+		ask(&r, "K", raw)
+		if !r.Ok {
+			fail(ht, "joserfc rejects go-jose's %s JSON %s: %s %s", k.name, raw, r.Error, r.Message)
+		}
+		if canon(raw) != canon(r.Dict) {
+			fail(ht, "%s: go-jose wrote %s, joserfc reads %s", k.name, canon(raw), canon(r.Dict))
+		}
+		if k.kty != "oct" {
+			if jwk.IsPublic() == r.Private {
+				fail(ht, "%s: IsPublic %v, joserfc is_private %v for %s", k.name, jwk.IsPublic(), r.Private, raw)
+			}
+			pub := jwk.Public()
+			pubRaw, err := json.Marshal(pub)
+			if err != nil {
+				fail(ht, "marshal Public() of %s: %v", k.name, err)
+			}
+			if canon(pubRaw) != canon(r.Public) {
+				fail(ht, "%s: go-jose Public() %s, joserfc public part %s", k.name, canon(pubRaw), canon(r.Public))
+			}
+		} else if jwk.IsPublic() {
+			fail(ht, "%s: IsPublic() is true for a symmetric key", k.name)
+		}
+		count(fmt.Sprintf("%s private=%v", k.kty, private))
+	})
+}
+
+var genShapes = []struct{ kty, crv string }{
+	{"oct", "128"}, {"oct", "256"}, {"oct", "512"}, {"oct", "8"},
+	{"RSA", "2048"},
+	{"EC", "P-256"}, {"EC", "P-384"}, {"EC", "P-521"},
+	{"OKP", "Ed25519"},
+}
+
+// TestHegelJoserfcKeyReadByJwx: a key joserfc generates and writes (private and public JSON,
+// with or without kid) is read by JSONWebKey.UnmarshalJSON, is Valid, marshals back to the same
+// JSON, and Public() gives joserfc's public JSON; a set of such keys parses as a JSONWebKeySet
+// and Key(kid) finds it.
+func TestHegelJoserfcKeyReadByGoJose(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		sh := pick(tc, genShapes...)
+		if sh.kty == "RSA" && !chance(tc, 25) {
+			sh = pick(tc, genShapes[:4]...) // RSA generation is slow
+		}
+		kid := pick(tc, "", "k1", "a-b.c")
+		var r struct {
+			reply
+			Private json.RawMessage
+			Public  json.RawMessage
+		}
+		ask(&r, "G", s(sh.kty), s(sh.crv), s(kid))
+		if !r.Ok {
+			count("joserfc cannot generate")
+			return
+		}
+		for _, side := range []struct {
+			name string
+			raw  json.RawMessage
+		}{{"private", r.Private}, {"public", r.Public}} {
+			if sh.kty == "oct" && side.name == "public" {
+				continue // a symmetric key has no public JSON
+			}
+			var key jose.JSONWebKey
+			if err := json.Unmarshal(side.raw, &key); err != nil {
+				fail(ht, "UnmarshalJSON(%s %s %s): %v", sh.kty, sh.crv, side.raw, err)
+			}
+			if id := knownValid(sh.kty); id != "" {
+				count("known " + id)
+			} else if !key.Valid() {
+				fail(ht, "%s %s %s: Valid() is false for %s", sh.kty, sh.crv, side.name, side.raw)
+			}
+			back, _ := json.Marshal(key)
+			if canon(back) != canon(side.raw) {
+				fail(ht, "%s %s %s: joserfc wrote %s, go-jose writes back %s", sh.kty, sh.crv, side.name, canon(side.raw), canon(back))
+			}
+			if side.name == "private" && sh.kty != "oct" {
+				pubRaw, _ := json.Marshal(key.Public())
+				if canon(pubRaw) != canon(r.Public) {
+					fail(ht, "%s %s: go-jose Public() %s, joserfc public %s", sh.kty, sh.crv, canon(pubRaw), canon(r.Public))
+				}
+			}
+		}
+		var set jose.JSONWebKeySet
+		if err := json.Unmarshal([]byte(fmt.Sprintf(`{"keys":[%s,%s]}`, r.Private, keys()[0].pubJSON)), &set); err != nil {
+			fail(ht, "JSONWebKeySet of a set with %s: %v", r.Private, err)
+		} else if len(set.Keys) != 2 {
+			fail(ht, "set of 2 keys has %d", len(set.Keys))
+		} else if kid != "" && len(set.Key(kid)) != 1 {
+			fail(ht, "Key(%q) finds %d keys in %s", kid, len(set.Key(kid)), r.Private)
+		}
+		count(sh.kty + " " + sh.crv)
+	})
+}
diff --git a/hegel/hegel_jws_test.go b/hegel/hegel_jws_test.go
new file mode 100644
index 0000000..ee0b999
--- /dev/null
+++ b/hegel/hegel_jws_test.go
@@ -0,0 +1,338 @@
+package hegel
+
+// JWS against joserfc: what one signs the other verifies, with the same payload and headers.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"hegel.dev/go/hegel"
+)
+
+func sigAlgs(names ...string) []jose.SignatureAlgorithm {
+	var out []jose.SignatureAlgorithm
+	for _, n := range names {
+		out = append(out, jose.SignatureAlgorithm(n))
+	}
+	return out
+}
+
+// signingKey wraps the private key as a JSONWebKey with a kid, so that the kid is written.
+func signingKey(k keyInfo, alg string) jose.SigningKey {
+	return jose.SigningKey{Algorithm: jose.SignatureAlgorithm(alg), Key: &jose.JSONWebKey{Key: k.private, KeyID: k.name}}
+}
+
+// TestHegelSignVerifiedByJoserfc: a compact JWS from NewSigner/Sign (any algorithm the key
+// supports, a payload of any bytes, protected typ, cty and a private member; a kid through the
+// JSONWebKey) verifies in joserfc with the public key to the same payload, and the protected
+// header joserfc reads is the one written; the detached form verifies with the payload given.
+func TestHegelSignVerifiedByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, signingKeys()...)
+		alg := pick(tc, k.sigAlgs...)
+		payload := genPayload(tc)
+		h := genHeaders(tc)
+		if id := knownNullHeader(h); id != "" {
+			count("known " + id)
+			return
+		}
+		signer, err := jose.NewSigner(signingKey(k, alg), signerOptions(h))
+		if err != nil {
+			fail(ht, "NewSigner %s %s: %v", k.name, alg, err)
+		}
+		obj, err := signer.Sign(payload)
+		if err != nil {
+			fail(ht, "Sign %s %s: %v", k.name, alg, err)
+		}
+		detached := chance(tc, 30)
+		var signed string
+		var args [][]byte
+		if detached {
+			signed, err = obj.DetachedCompactSerialize()
+			args = [][]byte{[]byte(signed), k.pubJSON, s(alg), payload}
+		} else {
+			signed, err = obj.CompactSerialize()
+			args = [][]byte{[]byte(signed), k.pubJSON, s(alg)}
+		}
+		if err != nil {
+			fail(ht, "CompactSerialize %s (detached=%v): %v", alg, detached, err)
+		}
+		var r struct {
+			reply
+			Payload   string
+			Protected map[string]interface{}
+		}
+		ask(&r, "SV", args...)
+		if !r.Ok {
+			fail(ht, "joserfc rejects go-jose's %s signature %s (detached=%v): %s %s", alg, signed, detached, r.Error, r.Message)
+		}
+		if r.Payload != base64.RawURLEncoding.EncodeToString(payload) {
+			fail(ht, "%s: joserfc reads payload %q, signed %q", alg, r.Payload, payload)
+		}
+		want := compactHeader(signed)
+		if string(mustJSON(want)) != string(mustJSON(r.Protected)) {
+			fail(ht, "%s: header written %s, joserfc reads %s", alg, mustJSON(want), mustJSON(r.Protected))
+		}
+		if want["alg"] != alg {
+			fail(ht, "%s: go-jose wrote header %s, want alg %s", alg, mustJSON(want), alg)
+		}
+		if id := knownKeyID(k); id != "" {
+			count("known " + id)
+			if want["kid"] != nil {
+				fail(ht, "%s: kid %v written for a symmetric key after all", alg, want["kid"])
+			}
+		} else if want["kid"] != k.name {
+			fail(ht, "%s: go-jose wrote header %s, want kid %s", alg, mustJSON(want), k.name)
+		}
+		for key, v := range h {
+			if string(mustJSON(want[key])) != string(mustJSON(v)) {
+				fail(ht, "%s: header %s written as %s, set %s", alg, key, mustJSON(want[key]), mustJSON(v))
+			}
+		}
+		// go-jose reads its own compact form back to the same header and payload
+		back, err := jose.ParseSigned(signed, sigAlgs(alg))
+		if detached {
+			back, err = jose.ParseDetached(signed, payload, sigAlgs(alg))
+		}
+		if err != nil {
+			fail(ht, "ParseSigned of its own %s: %v", signed, err)
+		} else {
+			got, err := back.Verify(k.public)
+			if err != nil || string(got) != string(payload) {
+				fail(ht, "Verify of its own %s: %q, %v", signed, got, err)
+			}
+			if pm := headerMap(back.Signatures[0].Protected); string(mustJSON(pm)) != string(mustJSON(want)) {
+				fail(ht, "%s: go-jose reads its own protected header as %s, wrote %s", alg, mustJSON(pm), mustJSON(want))
+			}
+		}
+		count(fmt.Sprintf("%s detached=%v", alg, detached))
+	})
+}
+
+// TestHegelSignJSONVerifiedByJoserfc: the full JSON serialization with one to three signatures
+// (NewMultiSigner, keys with kids, one set of options) verifies in joserfc against the key set
+// with the same payload and per-signature protected headers; one signature gives the flattened
+// form; go-jose reads its own output.
+func TestHegelSignJSONVerifiedByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		payload := genPayload(tc)
+		nsig := pick(tc, 1, 1, 2, 3)
+		var ks []keyInfo
+		var algs []string
+		var sks []jose.SigningKey
+		var keySet []json.RawMessage
+		seen := map[string]bool{}
+		for i := 0; i < nsig; i++ {
+			k := pick(tc, signingKeys()...)
+			if seen[k.name] {
+				continue
+			}
+			seen[k.name] = true
+			alg := pick(tc, k.sigAlgs...)
+			ks = append(ks, k)
+			algs = append(algs, alg)
+			sks = append(sks, signingKey(k, alg))
+			keySet = append(keySet, k.pubJSON)
+		}
+		h := genHeaders(tc)
+		if id := knownNullHeader(h); id != "" {
+			count("known " + id)
+			return
+		}
+		symmetric := ""
+		for _, k := range ks {
+			if id := knownKeyID(k); id != "" {
+				symmetric = id
+			}
+		}
+		if symmetric != "" && len(ks) > 1 {
+			count("known " + symmetric) // without kids joserfc cannot pick the key per signature
+			return
+		}
+		var signer jose.Signer
+		var err error
+		if len(sks) == 1 && chance(tc, 50) {
+			signer, err = jose.NewSigner(sks[0], signerOptions(h))
+		} else {
+			signer, err = jose.NewMultiSigner(sks, signerOptions(h))
+		}
+		if err != nil {
+			fail(ht, "NewMultiSigner %v: %v", algs, err)
+		}
+		obj, err := signer.Sign(payload)
+		if err != nil {
+			fail(ht, "Sign %v: %v", algs, err)
+		}
+		signed := obj.FullSerialize()
+		var r struct {
+			reply
+			Payload   string
+			Flattened bool
+			Members   []struct {
+				Protected map[string]interface{}
+				Header    map[string]interface{}
+			}
+		}
+		ask(&r, "VJ", []byte(signed), mustJSON(keySet), mustJSON(algs))
+		if !r.Ok {
+			fail(ht, "joserfc rejects go-jose's JSON JWS %s (algs %v): %s %s", signed, algs, r.Error, r.Message)
+		}
+		if r.Payload != base64.RawURLEncoding.EncodeToString(payload) {
+			fail(ht, "JSON %v: joserfc reads payload %q, signed %q", algs, r.Payload, payload)
+		}
+		if len(r.Members) != len(ks) {
+			fail(ht, "JSON %v: joserfc sees %d signatures, want %d in %s", algs, len(r.Members), len(ks), signed)
+		}
+		if r.Flattened != (len(ks) == 1) {
+			fail(ht, "JSON with %d keys: flattened=%v in %s", len(ks), r.Flattened, signed)
+		}
+		back, err := jose.ParseSigned(signed, sigAlgs(algs...))
+		if err != nil {
+			fail(ht, "ParseSigned of its own output %s: %v", signed, err)
+		} else {
+			for i, sig := range back.Signatures {
+				pm := headerMap(sig.Protected)
+				if i < len(r.Members) && string(mustJSON(pm)) != string(mustJSON(r.Members[i].Protected)) {
+					fail(ht, "JSON signature %d: go-jose protected %s, joserfc %s", i, mustJSON(pm), mustJSON(r.Members[i].Protected))
+				}
+				if pm["alg"] != algs[i] {
+					fail(ht, "JSON signature %d: protected header %s, want alg %s", i, mustJSON(pm), algs[i])
+				}
+				if id := knownKeyID(ks[i]); id != "" {
+					count("known " + id)
+				} else if pm["kid"] != ks[i].name {
+					fail(ht, "JSON signature %d: protected header %s, want kid %s", i, mustJSON(pm), ks[i].name)
+				}
+				for key, v := range h {
+					if string(mustJSON(pm[key])) != string(mustJSON(v)) {
+						fail(ht, "JSON signature %d: header %s is %s, set %s", i, key, mustJSON(pm[key]), mustJSON(v))
+					}
+				}
+			}
+			for i, k := range ks {
+				idx, _, got, err := back.VerifyMulti(k.public)
+				if err != nil || idx != i || string(got) != string(payload) {
+					fail(ht, "VerifyMulti with %s: index %d, %q, %v (want %d)", k.name, idx, got, err, i)
+				}
+			}
+		}
+		count(fmt.Sprintf("%d signatures", len(ks)))
+	})
+}
+
+// TestHegelJoserfcSignVerifiedByGoJose: a compact or JSON JWS signed by joserfc parses with
+// ParseSigned and verifies with the public key to the payload; the protected and unprotected
+// headers read are the ones written; a corrupted signature is refused by both.
+func TestHegelJoserfcSignVerifiedByGoJose(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, signingKeys()...)
+		alg := pick(tc, k.sigAlgs...)
+		payload := genPayload(tc)
+		protected := map[string]interface{}{"alg": alg}
+		if chance(tc, 60) {
+			protected["kid"] = k.name
+		}
+		h := genHeaders(tc)
+		if id := knownNullHeader(h); id != "" {
+			count("known " + id)
+			return
+		}
+		for key, v := range h {
+			protected[key] = v
+		}
+		useJSON := chance(tc, 30)
+		var token string
+		unprotected := map[string]interface{}{}
+		if useJSON {
+			member := map[string]interface{}{"protected": protected}
+			if chance(tc, 50) {
+				unprotected["kid"] = k.name
+				delete(protected, "kid")
+				member["header"] = unprotected
+			}
+			var r struct {
+				reply
+				JSON json.RawMessage `json:"json"`
+			}
+			ask(&r, "SJ", mustJSON(member), payload, mustJSON([]json.RawMessage{k.privJSON}), mustJSON([]string{alg}))
+			if !r.Ok {
+				count("joserfc cannot sign: " + r.Error)
+				return
+			}
+			token = string(r.JSON)
+		} else {
+			var r struct {
+				reply
+				Compact string
+			}
+			ask(&r, "SS", mustJSON(protected), payload, k.privJSON)
+			if !r.Ok {
+				count("joserfc cannot sign: " + r.Error)
+				return
+			}
+			token = r.Compact
+		}
+		obj, err := jose.ParseSigned(token, sigAlgs(alg))
+		if err != nil {
+			fail(ht, "ParseSigned of joserfc's %s %s: %v", alg, token, err)
+		}
+		got, err := obj.Verify(k.public)
+		if err != nil {
+			fail(ht, "Verify of joserfc's %s %s: %v", alg, token, err)
+		}
+		if string(got) != string(payload) {
+			fail(ht, "%s: Verify gives payload %q, joserfc signed %q", alg, got, payload)
+		}
+		if len(obj.Signatures) != 1 {
+			fail(ht, "ParseSigned sees %d signatures in %s", len(obj.Signatures), token)
+		} else {
+			sig := obj.Signatures[0]
+			if pm := headerMap(sig.Protected); string(mustJSON(pm)) != string(mustJSON(protected)) {
+				fail(ht, "%s: go-jose reads protected header %s, joserfc wrote %s", alg, mustJSON(pm), mustJSON(protected))
+			}
+			if um := headerMap(sig.Unprotected); string(mustJSON(um)) != string(mustJSON(unprotected)) {
+				fail(ht, "%s: go-jose reads unprotected header %s, joserfc wrote %s", alg, mustJSON(um), mustJSON(unprotected))
+			}
+			merged := map[string]interface{}{}
+			for k, v := range protected {
+				merged[k] = v
+			}
+			for k, v := range unprotected {
+				merged[k] = v
+			}
+			if hm := headerMap(sig.Header); string(mustJSON(hm)) != string(mustJSON(merged)) {
+				fail(ht, "%s: merged Header %s, protected %s + unprotected %s", alg, mustJSON(hm), mustJSON(protected), mustJSON(unprotected))
+			}
+		}
+		// corrupt the signature: both must refuse
+		if !useJSON && chance(tc, 50) {
+			parts := strings.Split(token, ".")
+			sig, _ := base64.RawURLEncoding.DecodeString(parts[2])
+			if len(sig) > 0 {
+				sig[n(tc, 0, len(sig)-1)] ^= 1 << uint(n(tc, 0, 7))
+				parts[2] = base64.RawURLEncoding.EncodeToString(sig)
+				bad := strings.Join(parts, ".")
+				if obj, err := jose.ParseSigned(bad, sigAlgs(alg)); err == nil {
+					if _, err := obj.Verify(k.public); err == nil {
+						fail(ht, "%s: Verify accepts a corrupted signature %s", alg, bad)
+					}
+				}
+				var r struct{ reply }
+				ask(&r, "SV", []byte(bad), k.pubJSON, s(alg))
+				if r.Ok {
+					fail(ht, "%s: joserfc accepts a corrupted signature %s", alg, bad)
+				}
+				count("corrupted refused")
+				return
+			}
+		}
+		count(alg)
+	})
+}
diff --git a/hegel/hegel_jwt_test.go b/hegel/hegel_jwt_test.go
new file mode 100644
index 0000000..7aadcb9
--- /dev/null
+++ b/hegel/hegel_jwt_test.go
@@ -0,0 +1,270 @@
+package hegel
+
+// jwt against joserfc: tokens read each way, and claims validation (exp, nbf, iat with leeway).
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+	"time"
+
+	jose "github.com/go-jose/go-jose/v4"
+	"github.com/go-jose/go-jose/v4/jwt"
+	"hegel.dev/go/hegel"
+)
+
+const fixedNow = 1_800_000_000
+
+// claimsSpec is a generated claims set as JSON-compatible values.
+type claimsSpec map[string]interface{}
+
+func genClaims(tc hegel.TestCase, allowEmptyAud bool) claimsSpec {
+	c := claimsSpec{}
+	if chance(tc, 60) {
+		c["iss"] = pick(tc, "issuer", "https://example.com/", "")
+	}
+	if chance(tc, 60) {
+		c["sub"] = pick(tc, "subject", "1234567890", "é")
+	}
+	if chance(tc, 60) {
+		switch pick(tc, 0, 1, 2, 3) {
+		case 0:
+			c["aud"] = "audience"
+		case 1:
+			c["aud"] = []interface{}{"a", "b"}
+		case 2:
+			c["aud"] = []interface{}{"single"}
+		case 3:
+			if allowEmptyAud {
+				c["aud"] = []interface{}{}
+			}
+		}
+	}
+	for _, name := range []string{"exp", "nbf", "iat"} {
+		if chance(tc, 50) {
+			c[name] = float64(fixedNow + n(tc, -120, 120))
+		}
+	}
+	if chance(tc, 40) {
+		c["jti"] = pick(tc, "id-1", "0", "")
+	}
+	if chance(tc, 50) {
+		c["custom"] = pick(tc, []interface{}{"v", float64(42), float64(1.5), true, nil, []interface{}{"a", float64(1)}, map[string]interface{}{"k": "v", "n": float64(2)}, "", "日本"}...)
+	}
+	return c
+}
+
+// standardClaims builds jwt.Claims from the spec; the private claim goes in a map of its own.
+func standardClaims(c claimsSpec) (jwt.Claims, map[string]interface{}) {
+	var std jwt.Claims
+	extra := map[string]interface{}{}
+	for name, v := range c {
+		switch name {
+		case "iss":
+			std.Issuer = v.(string)
+		case "sub":
+			std.Subject = v.(string)
+		case "jti":
+			std.ID = v.(string)
+		case "aud":
+			if str, ok := v.(string); ok {
+				std.Audience = jwt.Audience{str}
+			} else {
+				for _, a := range v.([]interface{}) {
+					std.Audience = append(std.Audience, a.(string))
+				}
+			}
+		case "exp":
+			std.Expiry = jwt.NewNumericDate(time.Unix(int64(v.(float64)), 0))
+		case "nbf":
+			std.NotBefore = jwt.NewNumericDate(time.Unix(int64(v.(float64)), 0))
+		case "iat":
+			std.IssuedAt = jwt.NewNumericDate(time.Unix(int64(v.(float64)), 0))
+		default:
+			extra[name] = v
+		}
+	}
+	return std, extra
+}
+
+// TestHegelTokenSignedReadByJoserfc: a token built with jwt.Signed(signer).Claims(standard)
+// .Claims(private) and serialized decodes in joserfc with the public key to the same claims, with
+// a JWT header (alg, and typ JWT when asked for). Claims omitted by the builder (empty strings
+// and lists: omitempty) are compared as absent.
+func TestHegelTokenSignedReadByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, signingKeys()...)
+		alg := pick(tc, k.sigAlgs...)
+		claims := genClaims(tc, false)
+		std, extra := standardClaims(claims)
+		opts := &jose.SignerOptions{}
+		typ := chance(tc, 60)
+		if typ {
+			opts.WithType("JWT")
+		}
+		signer, err := jose.NewSigner(signingKey(k, alg), opts)
+		if err != nil {
+			fail(ht, "NewSigner %s: %v", alg, err)
+		}
+		signed, err := jwt.Signed(signer).Claims(std).Claims(extra).Serialize()
+		if err != nil {
+			fail(ht, "Serialize %s: %v", alg, err)
+		}
+		var r struct {
+			reply
+			Header map[string]interface{}
+			Claims map[string]interface{}
+		}
+		ask(&r, "JD", []byte(signed), k.pubJSON, s(alg))
+		if !r.Ok {
+			fail(ht, "joserfc rejects go-jose's token %s: %s %s", signed, r.Error, r.Message)
+		}
+		want := map[string]interface{}{}
+		for name, v := range claims {
+			if str, ok := v.(string); ok && str == "" && name != "custom" {
+				continue // omitempty
+			}
+			want[name] = v
+		}
+		if string(normClaims(r.Claims)) != string(normClaims(want)) {
+			fail(ht, "%s: joserfc reads claims %s, set %s\n%s", alg, mustJSON(r.Claims), mustJSON(want), signed)
+		}
+		if r.Header["alg"] != alg || (typ && r.Header["typ"] != "JWT") || (!typ && r.Header["typ"] != nil) {
+			fail(ht, "%s typ=%v: header %s", alg, typ, mustJSON(r.Header))
+		}
+		if id := knownKeyID(k); id != "" {
+			count("known " + id)
+		} else if r.Header["kid"] != k.name {
+			fail(ht, "%s: header %s, want kid %s", alg, mustJSON(r.Header), k.name)
+		}
+		count(alg)
+	})
+}
+
+// TestHegelJoserfcTokenReadByGoJose: a token encoded by joserfc parses with jwt.ParseSigned and
+// its Claims (into jwt.Claims and a map) are the ones encoded; a token built from those parsed
+// claims decodes in joserfc to the same claims again.
+func TestHegelJoserfcTokenReadByGoJose(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, signingKeys()...)
+		alg := pick(tc, k.sigAlgs...)
+		claims := genClaims(tc, true)
+		header := map[string]interface{}{"alg": alg}
+		if chance(tc, 50) {
+			header["kid"] = k.name
+		}
+		if chance(tc, 50) {
+			header["typ"] = pick(tc, "JWT", "at+jwt")
+		}
+		var r struct {
+			reply
+			Token string
+		}
+		ask(&r, "JE", mustJSON(header), mustJSON(claims), k.privJSON)
+		if !r.Ok {
+			count("joserfc cannot encode: " + r.Error)
+			return
+		}
+		tok, err := jwt.ParseSigned(r.Token, sigAlgs(alg))
+		if err != nil {
+			fail(ht, "jwt.ParseSigned of joserfc's %s token %s (claims %s): %v", alg, r.Token, mustJSON(claims), err)
+		}
+		var std jwt.Claims
+		var all map[string]interface{}
+		if err := tok.Claims(k.public, &std, &all); err != nil {
+			fail(ht, "Claims of joserfc's %s token %s: %v", alg, r.Token, err)
+		}
+		if string(normClaims(all)) != string(normClaims(claims)) {
+			fail(ht, "%s: go-jose reads claims %s, joserfc encoded %s", alg, mustJSON(all), mustJSON(claims))
+		}
+		want, _ := standardClaims(claims)
+		stdJSON, _ := json.Marshal(std)
+		wantJSON, _ := json.Marshal(want)
+		if string(stdJSON) != string(wantJSON) {
+			fail(ht, "%s: jwt.Claims read as %s, want %s (from %s)", alg, stdJSON, wantJSON, mustJSON(claims))
+		}
+		if len(tok.Headers) != 1 {
+			fail(ht, "%d headers in %s", len(tok.Headers), r.Token)
+		} else if hm := headerMap(tok.Headers[0]); string(mustJSON(hm)) != string(mustJSON(header)) {
+			fail(ht, "%s: header read as %s, joserfc wrote %s", alg, mustJSON(hm), mustJSON(header))
+		}
+		// build a token from the parsed claims and read it with joserfc again
+		signer, err := jose.NewSigner(signingKey(k, alg), nil)
+		if err != nil {
+			fail(ht, "NewSigner: %v", err)
+		}
+		extra := map[string]interface{}{}
+		for name, v := range all {
+			switch name {
+			case "iss", "sub", "aud", "exp", "nbf", "iat", "jti":
+			default:
+				extra[name] = v
+			}
+		}
+		signed, err := jwt.Signed(signer).Claims(std).Claims(extra).Serialize()
+		if err != nil {
+			fail(ht, "re-sign: %v", err)
+		}
+		var d struct {
+			reply
+			Claims map[string]interface{}
+		}
+		ask(&d, "JD", []byte(signed), k.pubJSON, s(alg))
+		wantAgain := map[string]interface{}{}
+		for name, v := range claims {
+			if str, ok := v.(string); ok && str == "" && name != "custom" {
+				continue // omitempty
+			}
+			if arr, ok := v.([]interface{}); ok && len(arr) == 0 {
+				continue // omitempty
+			}
+			wantAgain[name] = v
+		}
+		if !d.Ok {
+			fail(ht, "joserfc rejects the re-signed token %s: %s %s", signed, d.Error, d.Message)
+		} else if string(normClaims(d.Claims)) != string(normClaims(wantAgain)) {
+			fail(ht, "%s: after ParseSigned and Serialize the claims are %s, were %s", alg, mustJSON(d.Claims), mustJSON(claims))
+		}
+		count(alg)
+	})
+}
+
+// TestHegelValidateMatchesJoserfc: Claims.ValidateWithLeeway with a fixed time accepts a token
+// exactly when joserfc's JWTClaimsRegistry with the same now and leeway does (exp, nbf, iat
+// around now, including the boundaries).
+func TestHegelValidateMatchesJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		claims := claimsSpec{}
+		for _, name := range []string{"exp", "nbf", "iat"} {
+			if chance(tc, 70) {
+				claims[name] = float64(fixedNow + pick(tc, n(tc, -100, 100), n(tc, -5, 5), 0, -1, 1))
+			}
+		}
+		leeway := pick(tc, 0, 0, 1, 5, 30, 100)
+		std, _ := standardClaims(claims)
+		err := std.ValidateWithLeeway(jwt.Expected{Time: time.Unix(fixedNow, 0)}, time.Duration(leeway)*time.Second)
+		var r struct {
+			reply
+			Valid   bool
+			Error   string
+			Message string
+		}
+		ask(&r, "JV", mustJSON(claims), s(fmt.Sprint(fixedNow)), s(fmt.Sprint(leeway)))
+		if !r.Ok {
+			fail(ht, "joserfc validate failed to run: %s %s", r.Error, r.Message)
+		}
+		switch {
+		case err == nil && !r.Valid:
+			fail(ht, "claims %s, leeway %d: go-jose valid, joserfc %s (%s)", mustJSON(claims), leeway, r.Error, r.Message)
+		case err != nil && r.Valid:
+			fail(ht, "claims %s, leeway %d: go-jose %v, joserfc valid", mustJSON(claims), leeway, err)
+		case err == nil:
+			count("valid")
+		default:
+			count("invalid")
+		}
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..42eb570
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,99 @@
+package hegel
+
+// One deterministic reproducer per recorded bug (bugs.toml). Each fails while the bug is open.
+
+import (
+	"crypto"
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	jose "github.com/go-jose/go-jose/v4"
+)
+
+var pinOct = []byte("0123456789abcdef0123456789abcdef")
+
+// go-jose/1: Thumbprint of a symmetric key fails with "unknown key type '[]uint8'"; RFC 7638
+// section 3.2 defines it over {"k", "kty"}.
+func TestHegelPinSymmetricThumbprint(t *testing.T) {
+	k := jose.JSONWebKey{Key: pinOct, KeyID: "k1"}
+	tp, err := k.Thumbprint(crypto.SHA256)
+	if err != nil {
+		t.Fatalf("Thumbprint of a symmetric key: %v", err)
+	}
+	input := fmt.Sprintf(`{"k":%q,"kty":"oct"}`, base64.RawURLEncoding.EncodeToString(pinOct))
+	want := sha256.Sum256([]byte(input))
+	if string(tp) != string(want[:]) {
+		t.Errorf("Thumbprint %x, RFC 7638 gives %x", tp, want)
+	}
+}
+
+// go-jose/2: Valid() is false for a symmetric key, one of the documented Key types.
+func TestHegelPinSymmetricValid(t *testing.T) {
+	k := jose.JSONWebKey{Key: pinOct, KeyID: "k1"}
+	raw, err := json.Marshal(k)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var back jose.JSONWebKey
+	if err := json.Unmarshal(raw, &back); err != nil {
+		t.Fatal(err)
+	}
+	if !k.Valid() || !back.Valid() {
+		t.Errorf("Valid() of a symmetric key is false (%s)", raw)
+	}
+}
+
+// go-jose/3: a symmetric signing key given as a JSONWebKey with a KeyID gets no kid header;
+// an asymmetric one does.
+func TestHegelPinSymmetricKeyID(t *testing.T) {
+	_, edPriv, _ := ed25519.GenerateKey(rand.Reader)
+	for _, c := range []struct {
+		alg jose.SignatureAlgorithm
+		key interface{}
+	}{{jose.EdDSA, edPriv}, {jose.HS256, pinOct}} {
+		signer, err := jose.NewSigner(jose.SigningKey{Algorithm: c.alg, Key: &jose.JSONWebKey{Key: c.key, KeyID: "k1"}}, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		obj, err := signer.Sign([]byte("hi"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		compact, _ := obj.CompactSerialize()
+		hdr, _ := base64.RawURLEncoding.DecodeString(strings.SplitN(compact, ".", 2)[0])
+		if !strings.Contains(string(hdr), `"kid":"k1"`) {
+			t.Errorf("%s: protected header %s has no kid, the JSONWebKey had KeyID k1", c.alg, hdr)
+		}
+	}
+}
+
+// go-jose/4: a protected header member with a JSON null value is dropped when parsing, though
+// Header.ExtraHeaders documents every unknown member as stored.
+func TestHegelPinNullHeaderDropped(t *testing.T) {
+	signer, err := jose.NewSigner(jose.SigningKey{Algorithm: jose.HS256, Key: pinOct}, (&jose.SignerOptions{}).WithHeader("x-custom", nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	obj, err := signer.Sign([]byte("hi"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	compact, _ := obj.CompactSerialize()
+	hdr, _ := base64.RawURLEncoding.DecodeString(strings.SplitN(compact, ".", 2)[0])
+	if !strings.Contains(string(hdr), `"x-custom":null`) {
+		t.Fatalf("protected header written as %s", hdr)
+	}
+	back, err := jose.ParseSigned(compact, []jose.SignatureAlgorithm{jose.HS256})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := back.Signatures[0].Protected.ExtraHeaders["x-custom"]; !ok {
+		t.Errorf("ParseSigned drops the x-custom member (value null) from the protected header %s: ExtraHeaders %v", hdr, back.Signatures[0].Protected.ExtraHeaders)
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..0538819
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,133 @@
+package hegel
+
+// Hegel property tests for fasthttp: generated HTTP requests, responses, URIs,
+// query strings and cookies, parsed by fasthttp and by the standard library
+// (net/http, net/url), must agree; what fasthttp writes, net/http must read as written.
+//
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
diff --git a/hegel/keys.go b/hegel/keys.go
new file mode 100644
index 0000000..c5ff142
--- /dev/null
+++ b/hegel/keys.go
@@ -0,0 +1,130 @@
+package hegel
+
+// The key pool: one key of each kind go-jose supports, with the algorithms each may be used
+// for, as Go keys and as the JSON joserfc reads.
+
+import (
+	"crypto/ecdsa"
+	"crypto/ed25519"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"fmt"
+	"sync"
+
+	jose "github.com/go-jose/go-jose/v4"
+)
+
+type keyInfo struct {
+	name     string
+	kty      string
+	sigAlgs  []string // JWS algorithms the key may sign with
+	encAlgs  []string // JWE key-management algorithms (other than dir)
+	dirEnc   string   // the content encryption the key's length fits, for dir
+	private  interface{}
+	public   interface{}
+	privJSON []byte // joserfc's view of the private (or symmetric) key
+	pubJSON  []byte // joserfc's view of the public key (the same for symmetric keys)
+}
+
+var (
+	keyPool   []keyInfo
+	keyByName = map[string]*keyInfo{}
+	keysOnce  sync.Once
+)
+
+func randBytes(n int) []byte {
+	b := make([]byte, n)
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+	return b
+}
+
+func mustJWK(k interface{}, kid string) []byte {
+	raw, err := json.Marshal(jose.JSONWebKey{Key: k, KeyID: kid})
+	if err != nil {
+		panic(fmt.Sprintf("marshal key %s: %v", kid, err))
+	}
+	return raw
+}
+
+func addKey(name, kty string, private, public interface{}, sigAlgs, encAlgs []string, dirEnc string) {
+	k := keyInfo{name: name, kty: kty, sigAlgs: sigAlgs, encAlgs: encAlgs, dirEnc: dirEnc, private: private, public: public}
+	k.privJSON = mustJWK(private, name)
+	k.pubJSON = mustJWK(public, name)
+	keyPool = append(keyPool, k)
+	keyByName[name] = &keyPool[len(keyPool)-1]
+}
+
+// RFC 7518 section 3.2: an HMAC key must be at least as long as the hash output.
+var (
+	hs256 = []string{"HS256"}
+	hs384 = []string{"HS256", "HS384"}
+	hs512 = []string{"HS256", "HS384", "HS512"}
+)
+var rsaSigAlgs = []string{"RS256", "RS384", "RS512", "PS256", "PS384", "PS512"}
+var rsaEncAlgs = []string{"RSA1_5", "RSA-OAEP", "RSA-OAEP-256"}
+var ecdhAlgs = []string{"ECDH-ES", "ECDH-ES+A128KW", "ECDH-ES+A192KW", "ECDH-ES+A256KW"}
+
+func keys() []keyInfo {
+	keysOnce.Do(func() {
+		oct := func(name string, n int, sig, enc []string, dirEnc string) {
+			b := randBytes(n)
+			addKey(name, "oct", b, b, sig, enc, dirEnc)
+		}
+		oct("oct16", 16, nil, []string{"A128KW", "A128GCMKW"}, "A128GCM")
+		oct("oct24", 24, nil, []string{"A192KW", "A192GCMKW"}, "A192GCM")
+		oct("oct32", 32, hs256, []string{"A256KW", "A256GCMKW"}, "A256GCM")
+		oct("oct32b", 32, hs256, []string{"A256KW", "A256GCMKW"}, "A128CBC-HS256")
+		oct("oct48", 48, hs384, nil, "A192CBC-HS384")
+		oct("oct64", 64, hs512, nil, "A256CBC-HS512")
+		pw := []byte("correct horse battery staple")
+		addKey("password", "oct", pw, pw, nil, []string{"PBES2-HS256+A128KW", "PBES2-HS384+A192KW", "PBES2-HS512+A256KW"}, "")
+		for _, name := range []string{"rsa0", "rsa1"} {
+			priv, err := rsa.GenerateKey(rand.Reader, 2048)
+			if err != nil {
+				panic(err)
+			}
+			addKey(name, "RSA", priv, &priv.PublicKey, rsaSigAlgs, rsaEncAlgs, "")
+		}
+		for _, c := range []struct {
+			name  string
+			curve elliptic.Curve
+			alg   string
+		}{{"p256", elliptic.P256(), "ES256"}, {"p384", elliptic.P384(), "ES384"}, {"p521", elliptic.P521(), "ES512"}} {
+			priv, err := ecdsa.GenerateKey(c.curve, rand.Reader)
+			if err != nil {
+				panic(err)
+			}
+			addKey(c.name, "EC", priv, &priv.PublicKey, []string{c.alg}, ecdhAlgs, "")
+		}
+		pub, priv, err := ed25519.GenerateKey(rand.Reader)
+		if err != nil {
+			panic(err)
+		}
+		addKey("ed25519", "OKP", priv, pub, []string{"EdDSA"}, nil, "")
+	})
+	return keyPool
+}
+
+func signingKeys() []keyInfo {
+	var out []keyInfo
+	for _, k := range keys() {
+		if len(k.sigAlgs) > 0 {
+			out = append(out, k)
+		}
+	}
+	return out
+}
+
+func encryptionKeys() []keyInfo {
+	var out []keyInfo
+	for _, k := range keys() {
+		if len(k.encAlgs) > 0 || k.dirEnc != "" {
+			out = append(out, k)
+		}
+	}
+	return out
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..9c55482
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,53 @@
+package hegel
+
+// Gates for the recorded bugs (bugs.toml), by generated shape. HEGEL_NO_KNOWN=1 lifts them.
+
+import "os"
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// knownThumbprint: go-jose/1, Thumbprint fails for a symmetric key.
+func knownThumbprint(k keyInfo) string {
+	if noKnown {
+		return ""
+	}
+	if k.kty == "oct" {
+		return "go-jose/1"
+	}
+	return ""
+}
+
+// knownValid: go-jose/2, Valid() is false for a symmetric key.
+func knownValid(kty string) string {
+	if noKnown {
+		return ""
+	}
+	if kty == "oct" {
+		return "go-jose/2"
+	}
+	return ""
+}
+
+// knownKeyID: go-jose/3, the KeyID of a symmetric JSONWebKey signing key is not written.
+func knownKeyID(k keyInfo) string {
+	if noKnown {
+		return ""
+	}
+	if k.kty == "oct" {
+		return "go-jose/3"
+	}
+	return ""
+}
+
+// knownNullHeader: go-jose/4, a header member whose value is JSON null is dropped when parsing.
+func knownNullHeader(h headerSpec) string {
+	if noKnown {
+		return ""
+	}
+	for _, v := range h {
+		if v == nil {
+			return "go-jose/4"
+		}
+	}
+	return ""
+}
diff --git a/hegel/oracle.go b/hegel/oracle.go
new file mode 100644
index 0000000..cd937ba
--- /dev/null
+++ b/hegel/oracle.go
@@ -0,0 +1,214 @@
+package hegel
+
+// The oracle: joserfc (Python, the JOSE implementation by the author of Authlib, on top of
+// pyca/cryptography), driven as one persistent child: a command and hex-encoded arguments per
+// line in, one JSON object per line out. Every reply has "ok"; a failure carries "error" (the
+// exception class) and "message".
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+)
+
+const pythonScript = `
+import sys, json, base64, warnings
+warnings.simplefilter("ignore")
+from joserfc import jwk, jws, jwe, jwt
+from joserfc.jwk import KeySet
+from joserfc.registry import HeaderParameter
+import joserfc._rfc7518.jwe_algs as _algs
+
+# joserfc caps the PBES2 iteration count at 300000 as a denial-of-service guard; jwx uses the
+# OWASP figure 600000. The cap is not a correctness point, so the oracle lifts it.
+_algs.PBES2HSAlgKeyEncryption.more_header_registry["p2c"] = HeaderParameter("PBES2 Count", "int", True)
+
+# The registries used to read what jwx wrote: joserfc refuses header members it does not know
+# unless told otherwise (RFC 7515 lets a producer add private members).
+def jws_reg(algs):
+    return jws.JWSRegistry(algorithms=algs, strict_check_header=False)
+
+def jwe_reg(algs):
+    return jwe.JWERegistry(algorithms=algs, strict_check_header=False)
+
+def hx(s):
+    return bytes.fromhex(s)
+
+def b64u(b):
+    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()
+
+def key_of(j):
+    return jwk.import_key(json.loads(j))
+
+def keyset_of(j):
+    return KeySet([jwk.import_key(k) for k in json.loads(j)])
+
+def members(ms):
+    return [{"protected": m.protected, "header": m.header} for m in ms]
+
+def handle(cmd, a):
+    if cmd == "T":  # thumbprint: key json, hash
+        k = key_of(a[0].decode())
+        pub = jwk.import_key(k.as_dict(private=False))
+        fields = [f for f in pub.value_registry if pub.value_registry[f].required] + ["kty"]
+        return {"thumbprint": jwk.thumbprint({f: pub.dict_value[f] for f in fields}, a[1].decode())}
+    if cmd == "K":  # import a key: its dict, private?, key type
+        k = key_of(a[0].decode())
+        return {"dict": k.as_dict(private=k.is_private), "public": k.as_dict(private=False), "private": k.is_private, "kty": k.key_type}
+    if cmd == "G":  # generate: kty, crv or size, kid
+        kty, crv = a[0].decode(), a[1].decode()
+        params = {"kid": a[2].decode()} if len(a) > 2 and a[2] else None
+        k = jwk.generate_key(kty, int(crv) if crv.isdigit() else crv, parameters=params)
+        return {"private": k.as_dict(private=True), "public": k.as_dict(private=False)}
+    if cmd == "SS":  # sign compact: protected json, payload, key json
+        return {"compact": jws.serialize_compact(json.loads(a[0]), a[1], key_of(a[2].decode()), registry=jws_reg([json.loads(a[0])["alg"]]))}
+    if cmd == "SV":  # verify compact: compact, key json, alg, [detached payload]
+        payload = a[3] if len(a) > 3 else None
+        o = jws.deserialize_compact(a[0], key_of(a[1].decode()), registry=jws_reg([a[2].decode()]), payload=payload)
+        return {"payload": b64u(o.payload), "protected": o.protected}
+    if cmd == "SJ":  # sign json: members json (dict or list), payload, keyset json, algs json
+        ms = json.loads(a[0])
+        keys = keyset_of(a[2].decode())
+        out = jws.serialize_json(ms, a[1], keys if isinstance(ms, list) or len(keys.keys) > 1 else keys.keys[0], registry=jws_reg(json.loads(a[3])))
+        return {"json": out}
+    if cmd == "VJ":  # verify json: json, keyset json, algs json
+        keys = keyset_of(a[1].decode())
+        o = jws.deserialize_json(json.loads(a[0]), keys if len(keys.keys) > 1 else keys.keys[0], registry=jws_reg(json.loads(a[2])))
+        return {"payload": b64u(o.payload), "members": members(o.members), "flattened": o.flattened}
+    if cmd == "EE":  # encrypt compact: protected json, plaintext, key json
+        p = json.loads(a[0])
+        return {"compact": jwe.encrypt_compact(p, a[1], key_of(a[2].decode()), registry=jwe_reg([p["alg"], p["enc"], "DEF"]))}
+    if cmd == "ED":  # decrypt compact: compact, key json, algs json
+        o = jwe.decrypt_compact(a[0], key_of(a[1].decode()), registry=jwe_reg(json.loads(a[2]) + ["DEF"]))
+        return {"plaintext": b64u(o.plaintext), "protected": o.protected}
+    if cmd == "EJ":  # encrypt json: protected json, plaintext, recipients json [{header, key}], aad (hex, may be empty), flattened flag, unprotected json
+        p = json.loads(a[0])
+        rec = json.loads(a[2])
+        aad = a[3] if a[3] else None
+        unprot = json.loads(a[5]) if len(a) > 5 and a[5] else None
+        cls = jwe.FlattenedJSONEncryption if a[4] == b"1" else jwe.GeneralJSONEncryption
+        obj = cls(p, a[1], unprotected=unprot, aad=aad)
+        algs = set([p.get("enc")] + ([p["alg"]] if "alg" in p else []))
+        for r in rec:
+            obj.add_recipient(r["header"], jwk.import_key(r["key"]))
+            if r["header"] and "alg" in r["header"]:
+                algs.add(r["header"]["alg"])
+        return {"json": jwe.encrypt_json(obj, None, registry=jwe_reg(list(algs) + ["DEF"]))}
+    if cmd == "DJ":  # decrypt json: json, keyset json, algs json
+        keys = keyset_of(a[1].decode())
+        o = jwe.decrypt_json(json.loads(a[0]), keys if len(keys.keys) > 1 else keys.keys[0], registry=jwe_reg(json.loads(a[2]) + ["DEF"]))
+        return {"plaintext": b64u(o.plaintext), "aad": b64u(o.aad) if o.aad else "", "protected": o.protected,
+                "unprotected": o.unprotected, "recipients": [r.header for r in o.recipients]}
+    if cmd == "JE":  # jwt encode: header json, claims json, key json
+        h = json.loads(a[0])
+        return {"token": jwt.encode(h, json.loads(a[1]), key_of(a[2].decode()), algorithms=[h["alg"]], default_type=None)}
+    if cmd == "JD":  # jwt decode: token, key json, alg
+        t = jwt.decode(a[0], key_of(a[1].decode()), algorithms=[a[2].decode()])
+        return {"header": t.header, "claims": t.claims}
+    if cmd == "JV":  # validate claims: claims json, now, leeway
+        reg = jwt.JWTClaimsRegistry(now=int(a[1]), leeway=int(a[2]))
+        try:
+            reg.validate(json.loads(a[0]))
+            return {"valid": True}
+        except Exception as e:
+            return {"valid": False, "error": type(e).__name__, "message": str(e)}
+    return {"error": "unknown command " + cmd}
+
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [hx(p) for p in parts[1:]]
+    try:
+        reply = handle(cmd, args)
+        reply.setdefault("ok", True)
+    except Exception as e:
+        reply = {"ok": False, "error": type(e).__name__, "message": str(e)}
+    print(json.dumps(reply), flush=True)
+`
+
+type pyChild struct {
+	mu    sync.Mutex
+	cmd   *exec.Cmd
+	stdin *bufio.Writer
+	out   *bufio.Reader
+}
+
+var (
+	pyOnce sync.Once
+	py     *pyChild
+)
+
+func oracle() *pyChild {
+	pyOnce.Do(func() {
+		python := "python3"
+		if p := os.Getenv("HEGEL_PYTHON"); p != "" {
+			python = p
+		}
+		cmd := exec.Command(python, "-u", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			panic(err)
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			panic(err)
+		}
+		if err := cmd.Start(); err != nil {
+			panic(fmt.Sprintf("python3 with joserfc is needed as the oracle: %v", err))
+		}
+		py = &pyChild{cmd: cmd, stdin: bufio.NewWriter(in), out: bufio.NewReader(out)}
+	})
+	return py
+}
+
+// reply is the common part of every oracle answer.
+type reply struct {
+	Ok      bool   `json:"ok"`
+	Error   string `json:"error"`
+	Message string `json:"message"`
+}
+
+// ask sends one request and decodes the JSON answer into v (which embeds reply).
+func ask(v interface{}, cmd string, args ...[]byte) {
+	p := oracle()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	line := cmd
+	for _, a := range args {
+		line += " " + hex.EncodeToString(a)
+	}
+	p.stdin.WriteString(line + "\n")
+	if err := p.stdin.Flush(); err != nil {
+		panic(fmt.Sprintf("joserfc oracle: %v", err))
+	}
+	raw, err := p.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("joserfc oracle exited: %v", err))
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		panic(fmt.Sprintf("joserfc oracle reply %q: %v", raw, err))
+	}
+}
+
+func s(x string) []byte { return []byte(x) }
+
+func mustJSON(v interface{}) []byte {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
+
+// canon re-encodes JSON with sorted keys so the two sides compare as text.
+func canon(raw []byte) string {
+	var v interface{}
+	if err := json.Unmarshal(raw, &v); err != nil {
+		return "INVALID JSON: " + string(raw)
+	}
+	return string(mustJSON(v))
+}
