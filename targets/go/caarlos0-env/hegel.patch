diff --git a/hegel_model_test.go b/hegel_model_test.go
new file mode 100644
index 0000000..28c16d9
--- /dev/null
+++ b/hegel_model_test.go
@@ -0,0 +1,447 @@
+package env_test
+
+// The model: the README's semantics applied to one configuration struct, driven by a table of
+// field specifications written from the struct's tags by hand (so that the model reads no
+// tags itself).
+
+import (
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+)
+
+// textVal implements encoding.TextUnmarshaler; "bad" fails.
+type textVal struct{ V string }
+
+func (t *textVal) UnmarshalText(b []byte) error {
+	if string(b) == "bad" {
+		return errors.New("bad text")
+	}
+	t.V = string(b)
+	return nil
+}
+
+// Inner is the nested struct, used directly, through pointers and in slices.
+type Inner struct {
+	N int    `env:"N"`
+	S string `env:"S" envDefault:"inner-default"`
+}
+
+// Config is the struct under test.
+type Config struct {
+	Str      string          `env:"STR"`
+	Def      string          `env:"DEF" envDefault:"dflt"`
+	I        int             `env:"I"`
+	I8       int8            `env:"I8"`
+	U16      uint16          `env:"U16"`
+	I64      int64           `env:"I64"`
+	F        float64         `env:"F"`
+	B        bool            `env:"B"`
+	D        time.Duration   `env:"D"`
+	URL      url.URL         `env:"URL"`
+	Ptr      *int            `env:"PTR"`
+	PStr     *string         `env:"PSTR" envDefault:"pd"`
+	Strs     []string        `env:"STRS"`
+	Ints     []int           `env:"INTS" envSeparator:";"`
+	Durs     []time.Duration `env:"DURS"`
+	M        map[string]int  `env:"M"`
+	M2       map[int]string  `env:"M2" envSeparator:"|" envKeyValSeparator:"="`
+	Req      string          `env:"REQ,required"`
+	Nonempty string          `env:"NONEMPTY,notEmpty"`
+	ReqDef   string          `env:"REQDEF,required" envDefault:"rd"`
+	Exp      string          `env:"EXP,expand"`
+	ExpDef   string          `env:"EXPDEF,expand" envDefault:"${STR}-x"`
+	Text     textVal         `env:"TEXT"`
+	In       Inner           `envPrefix:"IN_"`
+	Anon     struct {
+		A int `env:"A"`
+	} `envPrefix:"AN_"`
+	PIn        *Inner   `envPrefix:"PIN_"`
+	PInit      *Inner   `env:",init" envPrefix:"PI_"`
+	Items      []Inner  `envPrefix:"IT_"`
+	PItems     *[]Inner `envPrefix:"PT_"`
+	NoTag      int
+	Ign        int `env:"-"`
+	unexported int `env:"UNEXP"` //nolint:unused
+}
+
+// spec: one field of Config or Inner, as its tags say.
+type spec struct {
+	name                       string
+	key                        string
+	def                        *string
+	required, notEmpty, expand bool
+	sep, kvsep                 string
+	kind                       string
+	prefix                     string // nested: the envPrefix
+}
+
+func str(s string) *string { return &s }
+
+var innerSpecs = []spec{
+	{name: "N", key: "N", kind: "int"},
+	{name: "S", key: "S", def: str("inner-default"), kind: "string"},
+}
+
+var configSpecs = []spec{
+	{name: "Str", key: "STR", kind: "string"},
+	{name: "Def", key: "DEF", def: str("dflt"), kind: "string"},
+	{name: "I", key: "I", kind: "int"},
+	{name: "I8", key: "I8", kind: "int8"},
+	{name: "U16", key: "U16", kind: "uint16"},
+	{name: "I64", key: "I64", kind: "int64"},
+	{name: "F", key: "F", kind: "float64"},
+	{name: "B", key: "B", kind: "bool"},
+	{name: "D", key: "D", kind: "duration"},
+	{name: "URL", key: "URL", kind: "url"},
+	{name: "Ptr", key: "PTR", kind: "ptrint"},
+	{name: "PStr", key: "PSTR", def: str("pd"), kind: "ptrstring"},
+	{name: "Strs", key: "STRS", kind: "[]string", sep: ","},
+	{name: "Ints", key: "INTS", kind: "[]int", sep: ";"},
+	{name: "Durs", key: "DURS", kind: "[]duration", sep: ","},
+	{name: "M", key: "M", kind: "map[string]int", sep: ",", kvsep: ":"},
+	{name: "M2", key: "M2", kind: "map[int]string", sep: "|", kvsep: "="},
+	{name: "Req", key: "REQ", required: true, kind: "string"},
+	{name: "Nonempty", key: "NONEMPTY", notEmpty: true, kind: "string"},
+	{name: "ReqDef", key: "REQDEF", required: true, def: str("rd"), kind: "string"},
+	{name: "Exp", key: "EXP", expand: true, kind: "string"},
+	{name: "ExpDef", key: "EXPDEF", expand: true, def: str("${STR}-x"), kind: "string"},
+	{name: "Text", key: "TEXT", kind: "text"},
+	{name: "In", kind: "struct", prefix: "IN_"},
+	{name: "Anon", kind: "anon", prefix: "AN_"},
+	{name: "PIn", kind: "ptrstruct", prefix: "PIN_"},
+	{name: "PInit", kind: "initstruct", prefix: "PI_"},
+	{name: "Items", kind: "[]struct", prefix: "IT_"},
+	{name: "PItems", kind: "ptr[]struct", prefix: "PT_"},
+	{name: "NoTag", kind: "int"},
+	{name: "Ign", key: "-", kind: "int"},
+}
+
+// urlFieldKeys: url.URL's exported fields as UseFieldNameByDefault names them.
+var urlFieldKeys = []string{"SCHEME", "OPAQUE", "USER", "HOST", "PATH", "RAW_PATH", "OMIT_HOST", "FORCE_QUERY", "RAW_QUERY", "FRAGMENT", "RAW_FRAGMENT"}
+
+// nestedKeys: the field names of the nested fields as UseFieldNameByDefault names them.
+var nestedKeys = []string{"IN", "P_IN", "P_INIT", "ITEMS", "P_ITEMS"}
+
+// envName: the README's "converted to conform with environment variable names conventions":
+// underscores dropped, a word boundary before an uppercase letter that follows a lowercase one
+// or precedes one, all uppercase.
+func envName(name string) string {
+	rs := []rune(name)
+	var out []rune
+	for i, c := range rs {
+		if c == '_' {
+			continue
+		}
+		if len(out) > 0 && unicode.IsUpper(c) {
+			prevLower := unicode.IsLower(rs[i-1])
+			nextLower := i+1 < len(rs) && unicode.IsLower(rs[i+1])
+			if prevLower || nextLower {
+				out = append(out, '_')
+			}
+		}
+		out = append(out, unicode.ToUpper(c))
+	}
+	return string(out)
+}
+
+type modelOpts struct {
+	prefix                                  string
+	requiredIfNoDef, useFieldName, zeroOnly bool
+}
+
+// result: what the model predicts besides the struct.
+type result struct {
+	errs    []string          // "required:KEY", "notEmpty:KEY", "parse:Field"
+	onSet   map[string]bool   // keys OnSet is called with (a value was set)
+	skip    map[string]string // top-level field -> reason it is not compared
+	wideInt map[string]bool   // top-level fields whose int value is outside 32 bits (Known.int32)
+	raw     map[string]string // key -> value of the fields processed so far (expansion looks here first)
+	itemErr bool              // an error occurred inside a slice of structs
+}
+
+// expand: `expand` resolves a name through the values of the fields processed so far, then the
+// environment, recursively (as the package's getRawEnv does).
+func (r *result) expand(env map[string]string, val string) string {
+	return os.Expand(val, func(name string) string {
+		v := r.raw[name]
+		if v == "" {
+			v = env[name]
+		}
+		return r.expand(env, v)
+	})
+}
+
+func newResult() *result {
+	return &result{onSet: map[string]bool{}, skip: map[string]string{}, wideInt: map[string]bool{}, raw: map[string]string{}}
+}
+
+// modelParse applies env to cfg (already holding the initial value) as the README says.
+func modelParse(env map[string]string, o modelOpts, cfg *Config) *result {
+	res := newResult()
+	v := reflect.ValueOf(cfg).Elem()
+	for _, s := range configSpecs {
+		switch s.kind {
+		case "struct":
+			modelStruct(env, o, o.prefix+s.prefix, v.FieldByName(s.name), innerSpecs, res, s.name)
+		case "anon":
+			modelStruct(env, o, o.prefix+s.prefix, v.FieldByName(s.name), []spec{{name: "A", key: "A", kind: "int"}}, res, s.name)
+		case "ptrstruct":
+			f := v.FieldByName(s.name)
+			if !f.IsNil() {
+				modelStruct(env, o, o.prefix+s.prefix, f.Elem(), innerSpecs, res, s.name)
+			}
+		case "initstruct":
+			f := v.FieldByName(s.name)
+			if f.IsNil() {
+				f.Set(reflect.New(f.Type().Elem()))
+			}
+			modelStruct(env, o, o.prefix+s.prefix, f.Elem(), innerSpecs, res, s.name)
+		case "[]struct":
+			f := v.FieldByName(s.name)
+			items := f.Interface().([]Inner)
+			f.Set(reflect.ValueOf(modelItems(env, o, o.prefix+s.prefix, items, res, s.name)))
+		case "ptr[]struct":
+			f := v.FieldByName(s.name)
+			var items []Inner
+			if !f.IsNil() {
+				items = *f.Interface().(*[]Inner)
+			}
+			out := modelItems(env, o, o.prefix+s.prefix, items, res, s.name)
+			if len(out) > 0 || !f.IsNil() {
+				f.Set(reflect.ValueOf(&out))
+			}
+		default:
+			modelField(env, o, o.prefix, s, v.FieldByName(s.name), res, s.name)
+		}
+	}
+	sort.Strings(res.errs)
+	return res
+}
+
+func modelStruct(env map[string]string, o modelOpts, prefix string, v reflect.Value, specs []spec, res *result, top string) {
+	for _, s := range specs {
+		modelField(env, o, prefix, s, v.FieldByName(s.name), res, top)
+	}
+}
+
+// modelItems: a slice of structs is sized by the contiguous indices present under the prefix
+// (at least the initial length) and each item parsed with "<prefix><i>_"; nothing changes
+// when no variable under the prefix exists.
+func modelItems(env map[string]string, o modelOpts, prefix string, items []Inner, res *result, top string) []Inner {
+	any := false
+	for k := range env {
+		if strings.HasPrefix(k, prefix) {
+			any = true
+			break
+		}
+	}
+	if !any {
+		return items
+	}
+	count := 0
+	for {
+		p := fmt.Sprintf("%s%d_", prefix, count)
+		found := false
+		for k := range env {
+			if strings.HasPrefix(k, p) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			break
+		}
+		count++
+	}
+	capacity := count
+	if len(items) > capacity {
+		capacity = len(items)
+	}
+	if capacity == 0 {
+		return items
+	}
+	out := make([]Inner, capacity)
+	copy(out, items)
+	before := len(res.errs)
+	for i := range out {
+		modelStruct(env, o, fmt.Sprintf("%s%d_", prefix, i), reflect.ValueOf(&out[i]).Elem(), innerSpecs, res, top)
+	}
+	if len(res.errs) > before {
+		res.itemErr = true
+	}
+	return out
+}
+
+// modelField: one scalar field.
+func modelField(env map[string]string, o modelOpts, prefix string, s spec, f reflect.Value, res *result, top string) {
+	ownKey := s.key
+	if ownKey == "" && o.useFieldName {
+		ownKey = envName(s.name)
+	}
+	if ownKey == "-" {
+		return
+	}
+	key := prefix + ownKey
+	val, exists := env[key]
+	if ownKey == "" {
+		val, exists = "", false
+	}
+	isDefault := false
+	if (!exists || val == "") && s.def != nil {
+		val, exists, isDefault = *s.def, true, true
+	}
+	if !exists {
+		val = ""
+	}
+	if s.expand {
+		val = res.expand(env, val)
+	}
+	res.raw[key] = val
+	if (s.required || o.requiredIfNoDef) && !exists && ownKey != "" {
+		res.errs = append(res.errs, "required:"+key)
+		return
+	}
+	if s.notEmpty && val == "" {
+		res.errs = append(res.errs, "notEmpty:"+key)
+		return
+	}
+	if val == "" {
+		return
+	}
+	if ownKey != "" {
+		res.onSet[key] = true
+	}
+	if o.zeroOnly && !f.IsZero() {
+		if isDefault {
+			return // documented: the default is ignored for a non-zero field
+		}
+		if Known.zeroOnlyIgnoresEnv {
+			// the value is neither parsed nor set upstream: no comparison, no parse error
+			res.skip[top] = "SetDefaultsForZeroValuesOnly with a non-zero field and a value from the environment"
+			return
+		}
+	}
+	parsed, wide, err := parseKind(s, val)
+	if err != nil {
+		res.errs = append(res.errs, "parse:"+s.name)
+		if Known.ptrAllocatedOnError && f.Kind() == reflect.Ptr && f.IsNil() {
+			res.skip[top] = "parse error on a nil pointer field"
+		}
+		return
+	}
+	if wide {
+		res.wideInt[top] = true
+	}
+	f.Set(reflect.ValueOf(parsed))
+}
+
+// parseKind parses val for the field's type; wide reports an int outside the 32-bit range.
+func parseKind(s spec, val string) (parsed any, wide bool, err error) {
+	parseInt := func(v string) (int, error) {
+		i, err := strconv.ParseInt(v, 10, strconv.IntSize)
+		if err == nil && (i > 1<<31-1 || i < -(1<<31)) {
+			wide = true
+		}
+		return int(i), err
+	}
+	switch s.kind {
+	case "string":
+		return val, false, nil
+	case "int":
+		i, err := parseInt(val)
+		return i, wide, err
+	case "int8":
+		i, err := strconv.ParseInt(val, 10, 8)
+		return int8(i), false, err
+	case "uint16":
+		u, err := strconv.ParseUint(val, 10, 16)
+		return uint16(u), false, err
+	case "int64":
+		i, err := strconv.ParseInt(val, 10, 64)
+		return i, false, err
+	case "float64":
+		x, err := strconv.ParseFloat(val, 64)
+		return x, false, err
+	case "bool":
+		b, err := strconv.ParseBool(val)
+		return b, false, err
+	case "duration":
+		d, err := time.ParseDuration(val)
+		return d, false, err
+	case "url":
+		u, err := url.Parse(val)
+		if err != nil {
+			return url.URL{}, false, err
+		}
+		return *u, false, nil
+	case "text":
+		var t textVal
+		err := t.UnmarshalText([]byte(val))
+		return t, false, err
+	case "ptrint":
+		i, err := parseInt(val)
+		return &i, wide, err
+	case "ptrstring":
+		v := val
+		return &v, false, nil
+	case "[]string":
+		return strings.Split(val, s.sep), false, nil
+	case "[]int":
+		var out []int
+		for _, p := range strings.Split(val, s.sep) {
+			i, err := parseInt(p)
+			if err != nil {
+				return nil, false, err
+			}
+			out = append(out, i)
+		}
+		return out, wide, nil
+	case "[]duration":
+		var out []time.Duration
+		for _, p := range strings.Split(val, s.sep) {
+			d, err := time.ParseDuration(p)
+			if err != nil {
+				return nil, false, err
+			}
+			out = append(out, d)
+		}
+		return out, false, nil
+	case "map[string]int":
+		out := map[string]int{}
+		for _, p := range strings.Split(val, s.sep) {
+			k, v, ok := strings.Cut(p, s.kvsep)
+			if !ok {
+				return nil, false, errors.New("not key:value")
+			}
+			i, err := parseInt(v)
+			if err != nil {
+				return nil, false, err
+			}
+			out[k] = i
+		}
+		return out, wide, nil
+	case "map[int]string":
+		out := map[int]string{}
+		for _, p := range strings.Split(val, s.sep) {
+			k, v, ok := strings.Cut(p, s.kvsep)
+			if !ok {
+				return nil, false, errors.New("not key=value")
+			}
+			i, err := parseInt(k)
+			if err != nil {
+				return nil, false, err
+			}
+			out[i] = v
+		}
+		return out, wide, nil
+	}
+	panic("unknown kind " + s.kind)
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..e295430
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,229 @@
+package env_test
+
+// One plain test per recorded bug (bugs.toml): each asserts the documented behaviour and fails
+// while the bug exists; target.toml lists them as expected failures.
+
+import (
+	"net/url"
+	"os"
+	"os/exec"
+	"strconv"
+	"testing"
+
+	"github.com/caarlos0/env/v11"
+)
+
+func errorsAs(err error, target *env.AggregateError) bool {
+	agg, ok := err.(env.AggregateError)
+	if ok {
+		*target = agg
+	}
+	return ok
+}
+
+// caarlos0-env/1: int and uint are parsed with a 32-bit range on every platform.
+func TestHegelPinIntIsPlatformSized(t *testing.T) {
+	if strconv.IntSize != 64 {
+		t.Skip("32-bit platform")
+	}
+	type cfg struct {
+		I int  `env:"I"`
+		U uint `env:"U"`
+	}
+	var c cfg
+	err := env.ParseWithOptions(&c, env.Options{Environment: map[string]string{"I": "2147483648", "U": "4294967296"}})
+	if err != nil || c.I != 2147483648 || c.U != 4294967296 {
+		t.Errorf("int/uint on a %d-bit platform: %+v, %v; want 2147483648 and 4294967296", strconv.IntSize, c, err)
+	}
+}
+
+// caarlos0-env/2: UseFieldNameByDefault does not separate a final uppercase letter that follows
+// a lowercase one ("PortB" -> "PORTB"; "PortBx" -> "PORT_BX").
+func TestHegelPinFieldNameConversionIsConsistent(t *testing.T) {
+	type cfg struct {
+		PortB  int
+		PortBx int
+	}
+	var c cfg
+	err := env.ParseWithOptions(&c, env.Options{UseFieldNameByDefault: true, Environment: map[string]string{"PORT_B": "1", "PORT_BX": "2"}})
+	if err != nil || c.PortB != 1 || c.PortBx != 2 {
+		t.Errorf("PortB/PortBx from PORT_B=1, PORT_BX=2: %+v, %v", c, err)
+	}
+}
+
+// caarlos0-env/3: SetDefaultsForZeroValuesOnly also ignores a value from the environment when
+// the field is not zero; its documentation limits it to envDefault.
+func TestHegelPinZeroValuesOnlyAppliesToDefaults(t *testing.T) {
+	type cfg struct {
+		Port int    `env:"PORT" envDefault:"1"`
+		Name string `env:"NAME"`
+	}
+	c := cfg{Port: 8080, Name: "pre"}
+	err := env.ParseWithOptions(&c, env.Options{SetDefaultsForZeroValuesOnly: true, Environment: map[string]string{"PORT": "9090", "NAME": "fromenv"}})
+	if err != nil || c.Port != 9090 || c.Name != "fromenv" {
+		t.Errorf("SetDefaultsForZeroValuesOnly with PORT=9090, NAME=fromenv on {8080, pre}: %+v, %v; the environment is not a default", c, err)
+	}
+}
+
+// caarlos0-env/4: a struct type handled by a parser (url.URL) is recursed into afterwards: with
+// UseFieldNameByDefault its fields are overwritten from PATH, HOST, SCHEME...; with
+// RequiredIfNoDef they are required.
+func TestHegelPinParserTypesAreNotRecursed(t *testing.T) {
+	type cfg struct {
+		URL url.URL `env:"URL"`
+	}
+	var c cfg
+	err := env.ParseWithOptions(&c, env.Options{UseFieldNameByDefault: true, Environment: map[string]string{"URL": "http://example.com/a/b", "PATH": "/usr/bin", "HOST": "evil"}})
+	if err != nil || c.URL.String() != "http://example.com/a/b" {
+		t.Errorf("url.URL under UseFieldNameByDefault with PATH and HOST set: %q, %v; want http://example.com/a/b", c.URL.String(), err)
+	}
+	var d cfg
+	err = env.ParseWithOptions(&d, env.Options{UseFieldNameByDefault: true, RequiredIfNoDef: true, Environment: map[string]string{"URL": "http://example.com/a"}})
+	if err != nil {
+		t.Errorf("url.URL under UseFieldNameByDefault and RequiredIfNoDef: %v; the URL's own fields are not variables", err)
+	}
+}
+
+// caarlos0-env/5: a nested struct field is also processed as a value: under
+// UseFieldNameByDefault its name becomes a key, required by RequiredIfNoDef and "no parser"
+// when a variable of that name exists.
+func TestHegelPinNestedStructIsNotAValue(t *testing.T) {
+	type inner struct {
+		V int `env:"V"`
+	}
+	type cfg struct {
+		Named inner   `envPrefix:"NM_"`
+		Items []inner `envPrefix:"IT_"`
+	}
+	var c cfg
+	err := env.ParseWithOptions(&c, env.Options{UseFieldNameByDefault: true, RequiredIfNoDef: true, Environment: map[string]string{"NM_V": "1", "IT_0_V": "2"}})
+	if err != nil || c.Named.V != 1 || len(c.Items) != 1 {
+		t.Errorf("nested structs under UseFieldNameByDefault and RequiredIfNoDef: %+v, %v", c, err)
+	}
+	var d cfg
+	err = env.ParseWithOptions(&d, env.Options{UseFieldNameByDefault: true, Environment: map[string]string{"NM_V": "1", "NAMED": "x"}})
+	if err != nil || d.Named.V != 1 {
+		t.Errorf("nested struct with a variable of its own name: %+v, %v", d, err)
+	}
+}
+
+// caarlos0-env/6: `unset` unsets the process variable even when the value came from
+// Options.Environment.
+func TestHegelPinUnsetActsOnTheGivenEnvironment(t *testing.T) {
+	type cfg struct {
+		K string `env:"HEGEL_ZOO_UNSET_PROBE,unset"`
+	}
+	t.Setenv("HEGEL_ZOO_UNSET_PROBE", "process")
+	var c cfg
+	err := env.ParseWithOptions(&c, env.Options{Environment: map[string]string{"HEGEL_ZOO_UNSET_PROBE": "given"}})
+	if err != nil || c.K != "given" {
+		t.Fatalf("parse: %+v, %v", c, err)
+	}
+	if _, ok := os.LookupEnv("HEGEL_ZOO_UNSET_PROBE"); !ok {
+		t.Errorf("the process variable was unset although the value came from Options.Environment")
+	}
+}
+
+// caarlos0-env/7: OnSet is called for a field whose variable is absent (no default) or empty,
+// although nothing is set.
+func TestHegelPinOnSetOnlyWhenSet(t *testing.T) {
+	type cfg struct {
+		A string `env:"A"`
+		B string `env:"B"`
+		C string `env:"C"`
+	}
+	var calls []string
+	var c cfg
+	err := env.ParseWithOptions(&c, env.Options{Environment: map[string]string{"B": "", "C": "v"}, OnSet: func(tag string, _ interface{}, _ bool) { calls = append(calls, tag) }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(calls) != 1 || calls[0] != "C" {
+		t.Errorf("OnSet called for %v; only C was set", calls)
+	}
+}
+
+// caarlos0-env/8: a pre-initialized *[]struct loses its items where []struct keeps them.
+func TestHegelPinPointerSliceKeepsItems(t *testing.T) {
+	type item struct {
+		N int `env:"N"`
+	}
+	type cfg struct {
+		Items []item  `envPrefix:"IT_"`
+		Ptr   *[]item `envPrefix:"PT_"`
+	}
+	c := cfg{Items: []item{{5}, {6}}, Ptr: &[]item{{7}, {8}}}
+	err := env.ParseWithOptions(&c, env.Options{Environment: map[string]string{"IT_0_N": "1", "PT_0_N": "9"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(c.Items) != 2 || c.Items[1].N != 6 {
+		t.Errorf("[]struct: %v", c.Items)
+	}
+	if len(*c.Ptr) != 2 || (*c.Ptr)[1].N != 8 {
+		t.Errorf("*[]struct: %v, want [{9} {8}] as for []struct", *c.Ptr)
+	}
+}
+
+// caarlos0-env/9: a nil pointer field is allocated before its value is parsed, so a parse
+// error leaves a pointer to the zero value.
+func TestHegelPinFailedParseLeavesPointerNil(t *testing.T) {
+	type cfg struct {
+		P *int `env:"P"`
+	}
+	var c cfg
+	err := env.ParseWithOptions(&c, env.Options{Environment: map[string]string{"P": "abc"}})
+	if err == nil {
+		t.Fatal("no error for P=abc")
+	}
+	if c.P != nil {
+		t.Errorf("P = &%d after the parse error; want nil", *c.P)
+	}
+}
+
+// caarlos0-env/10: a variable whose expansion refers to itself overflows the stack (a fatal
+// error that ends the process). The parse runs in a child process: this test binary re-run
+// with HEGEL_ZOO_CHILD set, which must exit cleanly (an error value is fine).
+func TestHegelPinExpandCycleIsAnError(t *testing.T) {
+	if os.Getenv("HEGEL_ZOO_CHILD") == "1" {
+		type cfg struct {
+			A string `env:"A,expand"`
+		}
+		var c cfg
+		_ = env.ParseWithOptions(&c, env.Options{Environment: map[string]string{"A": "x${B}", "B": "y${B}"}})
+		return
+	}
+	cmd := exec.Command(os.Args[0], "-test.run=^TestHegelPinExpandCycleIsAnError$", "-test.count=1")
+	cmd.Env = append(os.Environ(), "HEGEL_ZOO_CHILD=1")
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		msg := string(out)
+		if len(msg) > 300 {
+			msg = msg[:300]
+		}
+		t.Errorf("parsing A=x${B} with B=y${B} (expand) ended the process: %v\n%s", err, msg)
+	}
+}
+
+// caarlos0-env/11: a parse error in one item of a slice of structs discards every item and
+// the errors of the following items; elsewhere every field is set or reported independently.
+func TestHegelPinSliceItemsAreIndependent(t *testing.T) {
+	type item struct {
+		N int `env:"N"`
+	}
+	type cfg struct {
+		Items []item `envPrefix:"IT_"`
+	}
+	var c cfg
+	err := env.ParseWithOptions(&c, env.Options{Environment: map[string]string{"IT_0_N": "1", "IT_1_N": "abc", "IT_2_N": "x"}})
+	if err == nil {
+		t.Fatal("no error")
+	}
+	var agg env.AggregateError
+	if !errorsAs(err, &agg) || len(agg.Errors) != 2 {
+		t.Errorf("errors: %v; want one per failing item (2)", err)
+	}
+	if len(c.Items) != 3 || c.Items[0].N != 1 {
+		t.Errorf("Items = %v; want three items with the first set to 1", c.Items)
+	}
+}
