+package env_test
+
+// Hegel property tests for caarlos0/env, written for the Hegel zoo.
+// See targets/go/caarlos0-env/README.md.
+//
+// Oracle: the README's documented semantics (tags, tag options, parse options, supported
+// types, the set-but-empty caveat) restated as a model over a fixed configuration struct
+// (hegel_model_test.go): for a generated environment, options and initial value, the model
+// says which fields are set to what, which errors are reported and which OnSet calls are made.
+// Parsing of scalars is strconv/time/net/url, as the README lists the types.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing. The properties never touch the process environment (Options.Environment is
+// always given); the one pin about `unset` uses a unique variable name.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// int and uint are parsed with a 32-bit range on every platform
+	int32 bool
+	// a field name ending in a single uppercase letter after a lowercase one is not separated
+	// ("PortB" -> "PORTB", "PortBx" -> "PORT_BX"); pin only
+	envNameTrailingUpper bool
+	// SetDefaultsForZeroValuesOnly also ignores values from the environment for non-zero fields
+	zeroOnlyIgnoresEnv bool
+	// struct types handled by a parser (url.URL, TextUnmarshalers, FuncMap types) are recursed
+	// into afterwards: with UseFieldNameByDefault their fields are overwritten from same-named
+	// variables (PATH, HOST...), with RequiredIfNoDef they are required
+	parserStructRecursed bool
+	// nested struct, pointer-to-struct and slice-of-struct fields are also processed as values:
+	// with UseFieldNameByDefault their field name is a key (required under RequiredIfNoDef, "no
+	// parser" when the variable exists)
+	nestedStructAsValue bool
+	// `unset` unsets the process variable even when the value came from Options.Environment;
+	// pin only
+	unsetIgnoresEnvironment bool
+	// OnSet is called for every keyed field, also when nothing is set (variable absent, no
+	// default, or empty)
+	onSetAlways bool
+	// a pre-initialized *[]struct loses its items where []struct keeps them
+	ptrSliceDropsItems bool
+	// a nil pointer field is allocated before its value is parsed, so a parse error leaves a
+	// pointer to the zero value
+	ptrAllocatedOnError bool
+	// a variable whose expansion refers to itself (directly or through another) overflows the
+	// stack: a fatal error, not an error value; the generator never builds a cycle
+	expandCycle bool
+	// a parse error in one item of a slice of structs discards every item and the errors of
+	// the following items
+	sliceItemErrorAborts bool
+}{
+	int32:                   true,
+	envNameTrailingUpper:    true,
+	zeroOnlyIgnoresEnv:      true,
+	parserStructRecursed:    true,
+	nestedStructAsValue:     true,
+	unsetIgnoresEnvironment: true,
+	onSetAlways:             true,
+	ptrSliceDropsItems:      true,
+	ptrAllocatedOnError:     true,
+	expandCycle:             true,
+	sliceItemErrorAborts:    true,
+}
