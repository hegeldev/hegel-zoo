@@ -0,0 +1,449 @@
+package env_test
+
+import (
+	"errors"
+	"fmt"
+	"net/url"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/caarlos0/env/v11"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- generators
+
+var (
+	intVals = []string{"0", "1", "-5", "42", "2147483647", "2147483648", "-2147483649", "9223372036854775807", "9223372036854775808", "abc", "1.5", " 1", "+7"}
+	// nested int fields: within 32 bits, so that Known.int32 rarely hides the whole case
+	smallIntVals = []string{"0", "1", "-5", "42", "2147483647", "abc", "1.5", " 1", "+7"}
+	int8Vals     = []string{"0", "127", "-128", "128", "x"}
+	uint16Vals   = []string{"0", "65535", "65536", "-1", "x"}
+	floatVals    = []string{"0", "1.5", "-2e3", "1e400", "NaN", "inf", "x"}
+	boolVals     = []string{"true", "false", "T", "1", "0", "yes", " true"}
+	durVals      = []string{"1s", "1h30m", "-2ms", "5", "abc", "0"}
+	urlVals      = []string{"http://example.com/a?b=c", "://bad", "/rel", "http://[::1]:80/x", "%zz", "https://u:p@h/p#f"}
+	strVals      = []string{"a", "b c", "$", "${STR}", "x,y", "k:v", "bad", "pre"}
+	// values of STR, which expansions refer to: no reference back to itself (Known.expandCycle)
+	refVals      = []string{"a", "b c", "$", "x,y", "k:v", "pre", "${DEF}"}
+	plainVals    = []string{"a", "b c", "$", "x,y", "k:v", "pre"}
+	strsVals     = []string{"a,b", "a,,b", ",", "1;2", "x"}
+	intsVals     = []string{"1;2", "1,2", "1;x", "-1;2147483648", "7"}
+	dursVals     = []string{"1s,2m", "1s,,2m", "1s;2m", "3h"}
+	mapVals      = []string{"a:1,b:2", "a:1,a:2", "novalue", "k:v:w", "a:x", "a:2147483648", "x:1"}
+	map2Vals     = []string{"1=x|2=y", "1=x=y", "a=b", "3=", "=v", "1=x,2=y"}
+	expandVals   = []string{"${STR}", "$I-${B}", "${NONE}x", "plain", "$$", "${STR", "a$"}
+	textVals     = []string{"ok", "bad", "x y"}
+	extraStrVals = []string{"/usr/bin", "evil", "ftp", "x"}
+)
+
+// keySpec: an environment variable the generator may set, and the pool for its value.
+type keySpec struct {
+	key  string
+	pool []string
+	pct  int // chance of being present
+}
+
+var keySpecs = []keySpec{
+	{"STR", refVals, 60}, {"DEF", plainVals, 50}, {"I", intVals, 60}, {"I8", int8Vals, 50}, {"U16", uint16Vals, 50},
+	{"I64", intVals, 50}, {"F", floatVals, 50}, {"B", boolVals, 50}, {"D", durVals, 50}, {"URL", urlVals, 50},
+	{"PTR", intVals, 50}, {"PSTR", strVals, 50}, {"STRS", strsVals, 50}, {"INTS", intsVals, 50}, {"DURS", dursVals, 50},
+	{"M", mapVals, 50}, {"M2", map2Vals, 50}, {"REQ", strVals, 70}, {"NONEMPTY", strVals, 70}, {"REQDEF", strVals, 50},
+	{"EXP", expandVals, 60}, {"EXPDEF", expandVals, 50}, {"TEXT", textVals, 50},
+	{"IN_N", smallIntVals, 50}, {"IN_S", strVals, 50}, {"AN_A", smallIntVals, 50}, {"PIN_N", smallIntVals, 40}, {"PIN_S", strVals, 40},
+	{"PI_N", smallIntVals, 50}, {"PI_S", strVals, 50},
+	{"IT_0_N", smallIntVals, 40}, {"IT_0_S", strVals, 40}, {"IT_1_N", smallIntVals, 35}, {"IT_1_S", strVals, 30}, {"IT_2_N", smallIntVals, 25}, {"IT_X", strVals, 10},
+	{"PT_0_N", smallIntVals, 40}, {"PT_0_S", strVals, 30}, {"PT_1_N", smallIntVals, 30},
+	{"NO_TAG", intVals, 40},
+	{"PATH", extraStrVals, 40}, {"HOST", extraStrVals, 30}, {"SCHEME", extraStrVals, 30}, {"FORCE_QUERY", boolVals, 20},
+	{"IN", strVals, 5}, {"ITEMS", strVals, 5}, {"P_INIT", strVals, 5}, {"P_IN", strVals, 5},
+}
+
+func genOpts(tc hegel.TestCase) modelOpts {
+	o := modelOpts{}
+	if chance(tc, 50) {
+		o.prefix = "APP_"
+	}
+	o.requiredIfNoDef = chance(tc, 20)
+	o.useFieldName = chance(tc, 30)
+	o.zeroOnly = chance(tc, 25)
+	return o
+}
+
+func genEnv(tc hegel.TestCase, o modelOpts) map[string]string {
+	e := map[string]string{}
+	for _, ks := range keySpecs {
+		if !chance(tc, ks.pct) {
+			continue
+		}
+		if chance(tc, 10) {
+			e[o.prefix+ks.key] = ""
+		} else {
+			e[o.prefix+ks.key] = pick(tc, ks.pool)
+		}
+	}
+	if o.prefix != "" {
+		// unprefixed names the expansions refer to
+		for _, k := range []string{"STR", "I", "B"} {
+			if chance(tc, 50) {
+				e[k] = pick(tc, refVals[:3])
+			}
+		}
+	}
+	return e
+}
+
+func genInitial(tc hegel.TestCase) Config {
+	var c Config
+	if chance(tc, 50) {
+		return c
+	}
+	if chance(tc, 50) {
+		c.Str = "pre"
+	}
+	if chance(tc, 50) {
+		c.I = 7
+	}
+	if chance(tc, 30) {
+		c.B = true
+	}
+	if chance(tc, 30) {
+		c.Def = "predef"
+	}
+	if chance(tc, 30) {
+		v := 5
+		c.Ptr = &v
+	}
+	if chance(tc, 30) {
+		c.Strs = []string{"p"}
+	}
+	if chance(tc, 30) {
+		c.M = map[string]int{"p": 1}
+	}
+	if chance(tc, 40) {
+		c.In = Inner{N: 1, S: "x"}
+	}
+	if chance(tc, 30) {
+		c.PIn = &Inner{N: 2}
+	}
+	if chance(tc, 40) {
+		c.Items = []Inner{{N: 9, S: "y"}}
+		if chance(tc, 50) {
+			c.Items = append(c.Items, Inner{N: 10})
+		}
+	}
+	if chance(tc, 40) {
+		items := []Inner{{N: 11, S: "z"}, {N: 12}}
+		c.PItems = &items
+	}
+	if chance(tc, 30) {
+		c.NoTag = 3
+	}
+	if chance(tc, 30) {
+		u, _ := url.Parse("http://pre/p")
+		c.URL = *u
+	}
+	if chance(tc, 30) {
+		c.D = time.Second
+	}
+	return c
+}
+
+// clone copies a Config deeply enough that parsing one copy cannot touch the other.
+func clone(c Config) Config {
+	d := c
+	if c.Ptr != nil {
+		v := *c.Ptr
+		d.Ptr = &v
+	}
+	if c.PStr != nil {
+		v := *c.PStr
+		d.PStr = &v
+	}
+	if c.PIn != nil {
+		v := *c.PIn
+		d.PIn = &v
+	}
+	if c.PInit != nil {
+		v := *c.PInit
+		d.PInit = &v
+	}
+	if c.Items != nil {
+		d.Items = append([]Inner(nil), c.Items...)
+	}
+	if c.PItems != nil {
+		items := append([]Inner(nil), *c.PItems...)
+		d.PItems = &items
+	}
+	if c.Strs != nil {
+		d.Strs = append([]string(nil), c.Strs...)
+	}
+	if c.Ints != nil {
+		d.Ints = append([]int(nil), c.Ints...)
+	}
+	if c.Durs != nil {
+		d.Durs = append([]time.Duration(nil), c.Durs...)
+	}
+	if c.M != nil {
+		d.M = map[string]int{}
+		for k, v := range c.M {
+			d.M[k] = v
+		}
+	}
+	if c.M2 != nil {
+		d.M2 = map[int]string{}
+		for k, v := range c.M2 {
+			d.M2[k] = v
+		}
+	}
+	return d
+}
+
+// actualErrs classifies the errors ParseWithOptions returned.
+func actualErrs(err error) []string {
+	if err == nil {
+		return nil
+	}
+	var agg env.AggregateError
+	if !errors.As(err, &agg) {
+		return []string{"other:" + err.Error()}
+	}
+	var out []string
+	for _, e := range agg.Errors {
+		switch e := e.(type) {
+		case env.VarIsNotSetError:
+			out = append(out, "required:"+e.Key)
+		case env.EmptyVarError:
+			out = append(out, "notEmpty:"+e.Key)
+		case env.ParseError:
+			out = append(out, "parse:"+e.Name)
+		case env.NoParserError:
+			out = append(out, "noParser:"+e.Name)
+		default:
+			out = append(out, "other:"+e.Error())
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func without(xs []string, drop func(string) bool) []string {
+	var out []string
+	for _, x := range xs {
+		if !drop(x) {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+func hasAnyKey(e map[string]string, prefix string, keys []string) bool {
+	for _, k := range keys {
+		if _, ok := e[prefix+k]; ok {
+			return true
+		}
+	}
+	return false
+}
+
+var topFields = func() []string {
+	var names []string
+	t := reflect.TypeOf(Config{})
+	for i := 0; i < t.NumField(); i++ {
+		if t.Field(i).IsExported() {
+			names = append(names, t.Field(i).Name)
+		}
+	}
+	return names
+}()
+
+// TestHegelParseFollowsTheReadme: ParseWithOptions on Config against the model: the fields set,
+// the errors reported and (Known aside) the OnSet calls.
+func TestHegelParseFollowsTheReadme(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		o := genOpts(tc)
+		e := genEnv(tc, o)
+		initial := genInitial(tc)
+
+		if Known.nestedStructAsValue && o.useFieldName && (o.requiredIfNoDef || hasAnyKey(e, o.prefix, nestedKeys)) {
+			c.count("skipped: nested struct fields named by UseFieldNameByDefault")
+			return
+		}
+
+		want := clone(initial)
+		res := modelParse(e, o, &want)
+		if Known.sliceItemErrorAborts && res.itemErr {
+			c.count("skipped: parse error inside a slice of structs")
+			return
+		}
+
+		got := clone(initial)
+		var calls []string
+		err := env.ParseWithOptions(&got, env.Options{
+			Environment:                  e,
+			Prefix:                       o.prefix,
+			RequiredIfNoDef:              o.requiredIfNoDef,
+			UseFieldNameByDefault:        o.useFieldName,
+			SetDefaultsForZeroValuesOnly: o.zeroOnly,
+			OnSet:                        func(tag string, _ interface{}, _ bool) { calls = append(calls, tag) },
+		})
+		errs := actualErrs(err)
+
+		skip := map[string]string{}
+		for k, v := range res.skip {
+			skip[k] = v
+		}
+		if Known.parserStructRecursed && o.useFieldName {
+			skip["URL"] = "url.URL recursed into under UseFieldNameByDefault"
+			errs = without(errs, func(s string) bool {
+				for _, k := range urlFieldKeys {
+					if s == "required:"+o.prefix+k {
+						return true
+					}
+				}
+				return s == "parse:ForceQuery" || s == "parse:OmitHost"
+			})
+		}
+		if Known.int32 {
+			nestedWide := false
+			for f := range res.wideInt {
+				switch f {
+				case "In", "Anon", "PIn", "PInit", "Items", "PItems":
+					nestedWide = true
+				default:
+					if n := len(errs); n > 0 {
+						errs = without(errs, func(s string) bool { return s == "parse:"+f })
+						if len(errs) < n {
+							skip[f] = "int outside 32 bits"
+						}
+					}
+				}
+			}
+			if nestedWide {
+				c.count("skipped: int outside 32 bits in a nested struct")
+				return
+			}
+		}
+		if Known.ptrSliceDropsItems && initial.PItems != nil && len(*initial.PItems) > 0 {
+			for k := range e {
+				if strings.HasPrefix(k, o.prefix+"PT_") {
+					// the dropped items are re-parsed from zero, so the errors differ too
+					c.count("skipped: pre-initialized *[]struct with variables under its prefix")
+					return
+				}
+			}
+		}
+
+		if !reflect.DeepEqual(errs, res.errs) {
+			c.failClass(ht, "errors", "ParseWithOptions(%v, env %v, initial %+v): errors %q, the README says %q", o, e, initial, errs, res.errs)
+			return
+		}
+		gv, wv := reflect.ValueOf(got), reflect.ValueOf(want)
+		for _, f := range topFields {
+			if why, ok := skip[f]; ok {
+				c.count("skipped field: " + why)
+				continue
+			}
+			g, w := gv.FieldByName(f).Interface(), wv.FieldByName(f).Interface()
+			if !reflect.DeepEqual(g, w) && !bothNaN(g, w) {
+				c.failClass(ht, "field "+f, "ParseWithOptions(%v, env %v, initial %+v): field %s = %s, the README says %s", o, e, initial, f, show(g), show(w))
+				return
+			}
+		}
+		if Known.onSetAlways {
+			c.count("skipped: OnSet calls")
+		} else {
+			gotCalls := map[string]bool{}
+			for _, k := range calls {
+				gotCalls[k] = true
+			}
+			if !reflect.DeepEqual(gotCalls, res.onSet) {
+				c.failClass(ht, "OnSet", "OnSet called for %v, the README says a value was set for %v (env %v)", calls, res.onSet, e)
+				return
+			}
+		}
+		c.count("agreed")
+	})
+}
+
+func bothNaN(g, w any) bool {
+	gf, ok1 := g.(float64)
+	wf, ok2 := w.(float64)
+	return ok1 && ok2 && gf != gf && wf != wf
+}
+
+func show(v any) string {
+	rv := reflect.ValueOf(v)
+	if rv.Kind() == reflect.Ptr {
+		if rv.IsNil() {
+			return "nil"
+		}
+		return fmt.Sprintf("&%v", rv.Elem().Interface())
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+// TestHegelFieldParamsFollowTheTags: GetFieldParamsWithOptions reports each keyed field's key,
+// default and options as the tags say.
+func TestHegelFieldParamsFollowTheTags(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		o := genOpts(tc)
+		if o.useFieldName && (Known.nestedStructAsValue || Known.parserStructRecursed) {
+			c.count("skipped: UseFieldNameByDefault")
+			return
+		}
+		got, err := env.GetFieldParamsWithOptions(&Config{}, env.Options{Prefix: o.prefix, UseFieldNameByDefault: o.useFieldName, RequiredIfNoDef: o.requiredIfNoDef, Environment: map[string]string{}})
+		if err != nil {
+			c.fail(ht, "GetFieldParamsWithOptions: %v", err)
+			return
+		}
+		var want []env.FieldParams
+		add := func(prefix string, s spec) {
+			ownKey := s.key
+			if ownKey == "" && o.useFieldName {
+				ownKey = envName(s.name)
+			}
+			if ownKey == "" || ownKey == "-" {
+				return // no key, or ignored before its params are reported
+			}
+			p := env.FieldParams{OwnKey: ownKey, Key: prefix + ownKey, Required: s.required || o.requiredIfNoDef, NotEmpty: s.notEmpty, Expand: s.expand, Ignored: ownKey == "-"}
+			if s.def != nil {
+				p.DefaultValue, p.HasDefaultValue = *s.def, true
+			}
+			want = append(want, p)
+		}
+		for _, s := range configSpecs {
+			switch s.kind {
+			case "struct", "initstruct":
+				for _, is := range innerSpecs {
+					add(o.prefix+s.prefix, is)
+				}
+			case "anon":
+				add(o.prefix+s.prefix, spec{name: "A", key: "A", kind: "int"})
+			case "ptrstruct", "[]struct", "ptr[]struct":
+				// nil pointer: nothing; slices: sized by the (empty) environment
+			default:
+				add(o.prefix, s)
+			}
+		}
+		if !reflect.DeepEqual(got, want) {
+			diff := fmt.Sprintf("len %d vs %d", len(got), len(want))
+			for i := 0; i < len(got) && i < len(want); i++ {
+				if got[i] != want[i] {
+					diff = fmt.Sprintf("at %d: %+v vs %+v", i, got[i], want[i])
+					break
+				}
+			}
+			c.failClass(ht, "params", "GetFieldParamsWithOptions(%v): %s", o, diff)
+			return
+		}
+		c.count("agreed")
+	})
+}
