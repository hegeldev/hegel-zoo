+package ldap_test
+
+// RFC 4514 distinguished names: a strict parser of the grammar (the model), generators of DNs
+// as values, a pure renderer that writes a DN with the escaping choices of a drawn tape (and,
+// on request, the library's documented leniencies), and the properties on ParseDN, DN.String,
+// Equal/EqualFold/AncestorOf and EscapeDN.
+
+import (
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	ldap "github.com/go-ldap/ldap/v3"
+	"hegel.dev/go/hegel"
+)
+
+type atv struct{ typ, val string }
+type rdn []atv
+type dname []rdn
+
+func (d dname) String() string {
+	var rs []string
+	for _, r := range d {
+		var as []string
+		for _, a := range r {
+			as = append(as, fmt.Sprintf("%q=%q", a.typ, a.val))
+		}
+		rs = append(rs, strings.Join(as, "+"))
+	}
+	return strings.Join(rs, ",")
+}
+
+func (d dname) equalExact(o dname) bool {
+	if len(d) != len(o) {
+		return false
+	}
+	for i := range d {
+		if len(d[i]) != len(o[i]) {
+			return false
+		}
+		for j := range d[i] {
+			if d[i][j] != o[i][j] {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func dnameOf(d *ldap.DN) dname {
+	out := dname{}
+	for _, r := range d.RDNs {
+		var x rdn
+		for _, a := range r.Attributes {
+			x = append(x, atv{a.Type, a.Value})
+		}
+		out = append(out, x)
+	}
+	return out
+}
+
+func ldapDN(d dname) *ldap.DN {
+	out := &ldap.DN{RDNs: []*ldap.RelativeDN{}}
+	for _, r := range d {
+		x := &ldap.RelativeDN{}
+		for _, a := range r {
+			x.Attributes = append(x.Attributes, &ldap.AttributeTypeAndValue{Type: a.typ, Value: a.val})
+		}
+		out.RDNs = append(out.RDNs, x)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- model comparisons
+
+// RFC 4517 distinguishedNameMatch as the godoc restates it: same number of RDNs, RDNs compared
+// by position as multisets of attributes, types case-insensitive, values exact (or folded).
+func atvEq(a, b atv, fold bool) bool {
+	if !strings.EqualFold(a.typ, b.typ) {
+		return false
+	}
+	if fold {
+		return strings.EqualFold(a.val, b.val)
+	}
+	return a.val == b.val
+}
+
+func rdnEq(a, b rdn, fold bool) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	used := make([]bool, len(b))
+	for _, x := range a {
+		found := false
+		for j, y := range b {
+			if !used[j] && atvEq(x, y, fold) {
+				used[j] = true
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+func dnEq(a, b dname, fold bool) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !rdnEq(a[i], b[i], fold) {
+			return false
+		}
+	}
+	return true
+}
+
+// ancestor: b consists of at least one RDN followed by all the RDNs of a.
+func dnAncestor(a, b dname, fold bool) bool {
+	if len(a) >= len(b) {
+		return false
+	}
+	return dnEq(a, b[len(b)-len(a):], fold)
+}
+
+// --------------------------------------------------------------------------- strict parser
+
+type dparser struct {
+	s   string
+	pos int
+}
+
+func (p *dparser) errf(format string, args ...any) error {
+	return fmt.Errorf("DN grammar at %d: %s", p.pos, fmt.Sprintf(format, args...))
+}
+
+// parseDNStrict parses s by the RFC 4514 grammar: no insignificant spaces, ',' and '+' only,
+// types as descr / numericoid, values as string (with pairs) or hexstring.
+func parseDNStrict(s string) (dname, error) {
+	d := dname{}
+	if s == "" {
+		return d, nil
+	}
+	p := &dparser{s: s}
+	var cur rdn
+	for {
+		typ := p.run()
+		if !validAttrType(typ) {
+			return nil, p.errf("invalid attribute type %q", typ)
+		}
+		if p.pos >= len(s) || s[p.pos] != '=' {
+			return nil, p.errf("expected =")
+		}
+		p.pos++
+		val, err := p.value()
+		if err != nil {
+			return nil, err
+		}
+		cur = append(cur, atv{typ, val})
+		if p.pos >= len(s) {
+			d = append(d, cur)
+			return d, nil
+		}
+		switch s[p.pos] {
+		case '+':
+			p.pos++
+		case ',':
+			d = append(d, cur)
+			cur = nil
+			p.pos++
+		default:
+			return nil, p.errf("unexpected %q", s[p.pos])
+		}
+	}
+}
+
+func validAttrType(s string) bool { return reOID.MatchString(s) }
+
+func (p *dparser) run() string {
+	start := p.pos
+	for p.pos < len(p.s) {
+		c := p.s[p.pos]
+		if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '.' {
+			p.pos++
+			continue
+		}
+		break
+	}
+	return p.s[start:p.pos]
+}
+
+func isHex(c byte) bool {
+	return c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F'
+}
+
+// value = string / hexstring; string = [ (leadchar / pair) [ *( stringchar / pair ) (trailchar / pair) ] ]
+func (p *dparser) value() (string, error) {
+	s := p.s
+	if p.pos < len(s) && s[p.pos] == '#' {
+		start := p.pos + 1
+		for p.pos+1 < len(s) && isHex(s[p.pos+1]) {
+			p.pos++
+		}
+		hs := s[start : p.pos+1]
+		p.pos++
+		if hs == "" || len(hs)%2 == 1 {
+			return "", p.errf("bad hexstring")
+		}
+		raw, _ := hex.DecodeString(hs)
+		return berPrimitiveContent(raw, p)
+	}
+	var b strings.Builder
+	first := true
+	for p.pos < len(s) {
+		c := s[p.pos]
+		if c == ',' || c == '+' {
+			break
+		}
+		switch {
+		case c == '\\':
+			if p.pos+1 >= len(s) {
+				return "", p.errf("trailing backslash")
+			}
+			e := s[p.pos+1]
+			if strings.IndexByte(`\"#+,;<=> `, e) >= 0 {
+				b.WriteByte(e)
+				p.pos += 2
+			} else if p.pos+2 < len(s) && isHex(e) && isHex(s[p.pos+2]) {
+				x, _ := hex.DecodeString(s[p.pos+1 : p.pos+3])
+				b.WriteByte(x[0])
+				p.pos += 3
+			} else {
+				return "", p.errf("bad pair")
+			}
+		case c == 0 || c == '"' || c == ';' || c == '<' || c == '>':
+			return "", p.errf("unescaped %q", c)
+		case c == ' ' && (first || p.pos+1 >= len(s) || s[p.pos+1] == ',' || s[p.pos+1] == '+'):
+			return "", p.errf("unescaped leading or trailing space")
+		case c == '#' && first:
+			return "", p.errf("unescaped leading #")
+		case c < 0x80:
+			b.WriteByte(c)
+			p.pos++
+		default:
+			r, w := utf8.DecodeRuneInString(s[p.pos:])
+			if r == utf8.RuneError && w == 1 {
+				return "", p.errf("invalid UTF-8")
+			}
+			b.WriteString(s[p.pos : p.pos+w])
+			p.pos += w
+		}
+		first = false
+	}
+	return b.String(), nil
+}
+
+// berPrimitiveContent reads exactly one primitive BER element (tag, length, content) and
+// returns its content, as the library reads a hexstring value.
+func berPrimitiveContent(raw []byte, p *dparser) (string, error) {
+	if len(raw) < 2 || raw[0]&0x20 != 0 || raw[0]&0x1f == 0x1f {
+		return "", p.errf("hexstring is not a simple primitive BER element")
+	}
+	l := int(raw[1])
+	i := 2
+	if l >= 0x80 {
+		k := l & 0x7f
+		if k == 0 || k > 4 || len(raw) < 2+k {
+			return "", p.errf("bad BER length")
+		}
+		l = 0
+		for j := 0; j < k; j++ {
+			l = l<<8 | int(raw[2+j])
+		}
+		i = 2 + k
+	}
+	if len(raw) != i+l {
+		return "", p.errf("BER length %d does not match %d content bytes", l, len(raw)-i)
+	}
+	return string(raw[i:]), nil
+}
+
+// --------------------------------------------------------------------------- generators
+
+var typePool = []string{"cn", "CN", "ou", "OU", "dc", "DC", "o", "uid", "sn", "givenName", "l", "st", "street", "c", "2.5.4.3", "0.9.2342.19200300.100.1.25", "1.3.6.1.4.1.1466.0", "x-attr"}
+
+// dvaluePool: the pieces of a DN value: letters, spaces, '#', the specials, '=', digits,
+// non-ASCII runes, NUL, a byte that is not UTF-8, a control byte, the filter meta-characters.
+var dvaluePool = []string{"a", "b", "John", "Doe", "example", "com", " ", "  ", "#", "\"", "+", ",", ";", "<", ">", "\\", "=", "0", "9", "\u00e9", "\u4e2d", "\ud568", "\U0001F600", "\x00", "\xff", "\x01", "*", "(", ")"}
+
+var (
+	dtypes  = hegel.SampledFrom(typePool)
+	dpieces = hegel.SampledFrom(dvaluePool)
+	// dvalues: one to five pieces of the pool, or the empty string (8%).
+	dvalues = weighted(choice[string]{92, joined(many(dpieces, 1, 5))}, choice[string]{8, hegel.Just("")})
+	atvs    = hegel.Composite(func(tc hegel.TestCase) atv {
+		return atv{typ: hegel.Draw(tc, dtypes), val: hegel.Draw(tc, dvalues)}
+	})
+	// rdns: one attribute, or two or three (15%).
+	rdns = weighted(
+		choice[rdn]{85, hegel.Map(atvs, func(a atv) rdn { return rdn{a} })},
+		choice[rdn]{15, asRDN(many(atvs, 2, 3))},
+	)
+	// dnames: one to four RDNs, or the empty DN (3%).
+	dnames = weighted(choice[dname]{97, dnamesOf(1, 4)}, choice[dname]{3, hegel.Just(dname{})})
+	// nonEmptyDNames: one to four RDNs.
+	nonEmptyDNames = dnamesOf(1, 4)
+)
+
+func asRDN(g hegel.Generator[[]atv]) hegel.Generator[rdn] {
+	return hegel.Map(g, func(as []atv) rdn { return rdn(as) })
+}
+
+func dnamesOf(lo, hi int) hegel.Generator[dname] {
+	return hegel.Map(many(rdns, lo, hi), func(rs []rdn) dname { return dname(rs) })
+}
+
+// --------------------------------------------------------------------------- renderer
+
+// dstyle: the freedoms of a DN's text beyond the escaping choices on the tape. lenient adds
+// the library's documented leniencies (insignificant spaces around types and values, ';'
+// between RDNs); rawInvalid writes a byte that is not UTF-8 raw instead of hex-escaped (the
+// shape of go-ldap/8, drawn only by its own property).
+type dstyle struct{ lenient, rawInvalid bool }
+
+// hexEsc is the \XX escape of a byte, in either hex case.
+func hexEsc(c byte, upper bool) string {
+	if upper {
+		return fmt.Sprintf("\\%02X", c)
+	}
+	return fmt.Sprintf("\\%02x", c)
+}
+
+// hexstring is v as a hexstring value: '#' and the hex of a BER OCTET STRING holding v.
+func hexstring(v string, upper bool) string {
+	var l []byte
+	if len(v) < 0x80 {
+		l = []byte{byte(len(v))}
+	} else {
+		l = []byte{0x82, byte(len(v) >> 8), byte(len(v))}
+	}
+	raw := append(append([]byte{0x04}, l...), v...)
+	if upper {
+		return "#" + strings.ToUpper(hex.EncodeToString(raw))
+	}
+	return "#" + hex.EncodeToString(raw)
+}
+
+// renderDString writes v as an RFC 4514 string: the specials, a leading '#' and a leading or
+// trailing space as pairs (\X 70% of the time, else \XX), NUL and a byte that is not UTF-8 as
+// \XX (the byte raw when rawInvalid), an inner '=', ' ' or '#' escaped 20% of the time,
+// another ASCII byte 8% and a non-ASCII rune 20% (byte by byte); the hex case is a coin per
+// escape. An empty tape gives the plain rendering.
+func renderDString(v string, rawInvalid bool, t *tape) string {
+	var b strings.Builder
+	escHex := func(c byte) { b.WriteString(hexEsc(c, t.coin(50))) }
+	escPair := func(c byte) {
+		if t.coin(30) {
+			escHex(c)
+		} else {
+			b.WriteByte('\\')
+			b.WriteByte(c)
+		}
+	}
+	for i := 0; i < len(v); {
+		c := v[i]
+		switch {
+		case c == '"' || c == '+' || c == ',' || c == ';' || c == '<' || c == '>' || c == '\\':
+			escPair(c)
+			i++
+		case c == ' ' && (i == 0 || i == len(v)-1):
+			escPair(c)
+			i++
+		case c == '#' && i == 0:
+			escPair(c)
+			i++
+		case c == 0:
+			escHex(c)
+			i++
+		case c == '=' || c == ' ' || c == '#':
+			if t.coin(20) {
+				escPair(c)
+			} else {
+				b.WriteByte(c)
+			}
+			i++
+		case c < 0x80:
+			if t.coin(8) {
+				escHex(c)
+			} else {
+				b.WriteByte(c)
+			}
+			i++
+		default:
+			r, w := utf8.DecodeRuneInString(v[i:])
+			invalid := r == utf8.RuneError && w == 1
+			switch {
+			case invalid && rawInvalid:
+				b.WriteByte(c)
+			case invalid || t.coin(20):
+				for j := 0; j < w; j++ {
+					escHex(v[i+j])
+				}
+			default:
+				b.WriteString(v[i : i+w])
+			}
+			i += w
+		}
+	}
+	return b.String()
+}
+
+// renderDValue writes v as a hexstring 10% of the time (either hex case), else as a string.
+func renderDValue(v string, st dstyle, t *tape) string {
+	if t.coin(10) {
+		return hexstring(v, t.coin(50))
+	}
+	return renderDString(v, st.rawInvalid, t)
+}
+
+// rendered is a DN's text with what its rendering used: a lenient form, and spaces around a
+// hexstring value (the shape of go-ldap/9).
+type rendered struct {
+	text               string
+	lenient, hexSpaced bool
+}
+
+// renderATV writes type=value; when lenient, one or two insignificant spaces before and after
+// the type and the value 12% of the time each (under HEGEL_NO_KNOWN=1 none around a hexstring
+// value, whose spaces the library does not strip: go-ldap/9).
+func renderATV(a atv, st dstyle, t *tape) rendered {
+	r := rendered{}
+	sp := func() string {
+		if st.lenient && t.coin(12) {
+			r.lenient = true
+			return strings.Repeat(" ", 1+t.next(2))
+		}
+		return ""
+	}
+	v := renderDValue(a.val, st, t)
+	before, after := sp(), sp()
+	if strings.HasPrefix(v, "#") && Known.hexstringSpacesSignificant {
+		r.text = before + a.typ + after + "=" + v
+		return r
+	}
+	lead, trail := sp(), sp()
+	r.hexSpaced = strings.HasPrefix(v, "#") && (lead != "" || trail != "")
+	r.text = before + a.typ + after + "=" + lead + v + trail
+	return r
+}
+
+// renderRDN writes the attributes joined by '+'.
+func renderRDN(x rdn, st dstyle, t *tape) rendered {
+	r := rendered{}
+	var parts []string
+	for _, a := range x {
+		p := renderATV(a, st, t)
+		parts = append(parts, p.text)
+		r.lenient, r.hexSpaced = r.lenient || p.lenient, r.hexSpaced || p.hexSpaced
+	}
+	r.text = strings.Join(parts, "+")
+	return r
+}
+
+// renderDN writes the RDNs joined by ',' (when lenient, by ';' 10% of the time).
+func renderDN(d dname, st dstyle, t *tape) rendered {
+	r := rendered{}
+	var b strings.Builder
+	for i, x := range d {
+		if i > 0 {
+			if st.lenient && t.coin(10) {
+				r.lenient = true
+				b.WriteByte(';')
+			} else {
+				b.WriteByte(',')
+			}
+		}
+		p := renderRDN(x, st, t)
+		b.WriteString(p.text)
+		r.lenient, r.hexSpaced = r.lenient || p.lenient, r.hexSpaced || p.hexSpaced
+	}
+	r.text = b.String()
+	return r
+}
+
+// --------------------------------------------------------------------------- properties
+
+// checkCanonical checks what DN.String() promises: a grammatical string that the library
+// parses back to an Equal DN, unchanged by another String().
+func checkCanonical(c *collector, ht *hegel.T, got *ldap.DN, from string) bool {
+	str := got.String()
+	if m, err := parseDNStrict(str); err != nil {
+		c.failClass(ht, "string grammar", "ParseDN(%q).String() = %q is not grammatical: %v", from, str, err)
+		return false
+	} else if !dnEq(m, dnameOf(got), false) {
+		c.failClass(ht, "string reading", "ParseDN(%q).String() = %q reads as %v; want %v", from, str, m, dnameOf(got))
+		return false
+	}
+	back, err := ldap.ParseDN(str)
+	if err != nil {
+		c.failClass(ht, "string reparse", "ParseDN(%q).String() = %q does not parse: %v", from, str, err)
+		return false
+	}
+	if !back.Equal(got) || !got.Equal(back) {
+		c.failClass(ht, "string equal", "ParseDN(%q).String() = %q reparses as %v, not Equal to %v", from, str, dnameOf(back), dnameOf(got))
+		return false
+	}
+	if back.String() != str {
+		c.failClass(ht, "string idempotent", "String() of %q is %q, then %q", from, str, back.String())
+		return false
+	}
+	return true
+}
+
+// dnCase: a DN and two renderings of it, each lenient 30% of the time with its own tape.
+type dnCase struct {
+	d                  dname
+	lenient1, lenient2 bool
+	tape1, tape2       []int
+}
+
+func (c dnCase) first() rendered { return renderDN(c.d, dstyle{lenient: c.lenient1}, newTape(c.tape1)) }
+func (c dnCase) second() rendered {
+	return renderDN(c.d, dstyle{lenient: c.lenient2}, newTape(c.tape2))
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c dnCase) GoString() string {
+	return fmt.Sprintf("DN %v\ntext %q\ntext2 %q", c.d, c.first().text, c.second().text)
+}
+
+var dnCases = hegel.Composite(func(tc hegel.TestCase) dnCase {
+	return dnCase{
+		d:        hegel.Draw(tc, dnames),
+		lenient1: hegel.Draw(tc, chance(30)),
+		tape1:    hegel.Draw(tc, tapes),
+		lenient2: hegel.Draw(tc, chance(30)),
+		tape2:    hegel.Draw(tc, tapes),
+	}
+})
+
+// lowerTypes is d with its types lower-cased, the canonical form's reading.
+func lowerTypes(d dname) dname {
+	want := dname{}
+	for _, r := range d {
+		var x rdn
+		for _, a := range r {
+			x = append(x, atv{strings.ToLower(a.typ), a.val})
+		}
+		want = append(want, x)
+	}
+	return want
+}
+
+// A grammatical DN string parses to its structure; two renderings of one DN normalize to the
+// same String(), itself grammatical and stable. A hexstring value with insignificant spaces
+// around it (a lenient rendering) is the shape of go-ldap/9.
+func TestHegelDNParsesGrammar(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, dnCases)
+		r := k.first()
+		s := r.text
+		shape := shapeIf(r.hexSpaced, "go-ldap/9")
+		if !r.lenient {
+			if m, err := parseDNStrict(s); err != nil || !m.equalExact(k.d) {
+				c.failClass(ht, "model", "model: %q parsed as %v, want %v (%v)", s, m, k.d, err)
+				return
+			}
+		}
+		got, err := ldap.ParseDN(s)
+		if err != nil {
+			c.mismatch(ht, shape, "rejected", "ParseDN(%q) = %v; want %v", s, err, k.d)
+			return
+		}
+		if g := dnameOf(got); !g.equalExact(k.d) {
+			c.mismatch(ht, shape, "structure", "ParseDN(%q) = %v; want %v", s, g, k.d)
+			return
+		}
+		if !checkCanonical(c, ht, got, s) {
+			return
+		}
+		r2 := k.second()
+		s2 := r2.text
+		shape2 := shapeIf(r2.hexSpaced, "go-ldap/9")
+		got2, err := ldap.ParseDN(s2)
+		if err != nil {
+			c.mismatch(ht, shape2, "rejected", "ParseDN(%q) = %v; want %v", s2, err, k.d)
+			return
+		}
+		if got2.String() != got.String() {
+			c.mismatch(ht, shape2, "normalization", "ParseDN(%q).String() = %q but ParseDN(%q).String() = %q for the same DN %v", s, got.String(), s2, got2.String(), k.d)
+			return
+		}
+		// the canonical form lower-cases the type and keeps the value
+		want := lowerTypes(k.d)
+		m, _ := parseDNStrict(got.String())
+		if !dnEq(m, want, false) {
+			c.failClass(ht, "canonical", "ParseDN(%q).String() = %q reads as %v; want the types lower-cased: %v", s, got.String(), m, want)
+			return
+		}
+		if r.lenient {
+			c.count("ok lenient")
+		} else {
+			c.count("ok")
+		}
+	})
+}
+
+// dnMutationPool: the mutation pieces for a DN text; under HEGEL_NO_KNOWN=1 without the raw
+// bytes that are not UTF-8 (the shape of go-ldap/8).
+var dnMutationPool = func() []string {
+	if !noKnown {
+		return mutationPool
+	}
+	var out []string
+	for _, p := range mutationPool {
+		if utf8.ValidString(p) {
+			out = append(out, p)
+		}
+	}
+	return out
+}()
+
+// dnMutCase: a DN rendered plainly, and one or two mutations of the text.
+type dnMutCase struct {
+	d    dname
+	tape []int
+	muts []mutation
+}
+
+// text is the mutated rendering; under HEGEL_NO_KNOWN=1 the mutations edit runes, so no byte
+// that is not UTF-8 arises from a split rune (the shape of go-ldap/8).
+func (c dnMutCase) text() string {
+	return mutate(renderDN(c.d, dstyle{}, newTape(c.tape)).text, c.muts, shaped(guard{}, guard{runes: true}))
+}
+
+func (c dnMutCase) GoString() string { return fmt.Sprintf("DN %v\nmutated %q", c.d, c.text()) }
+
+var dnMutCases = hegel.Composite(func(tc hegel.TestCase) dnMutCase {
+	return dnMutCase{
+		d:    hegel.Draw(tc, dnames),
+		tape: hegel.Draw(tc, tapes),
+		muts: hegel.Draw(tc, many(mutationsFrom(dnMutationPool), 1, 2)),
+	}
+})
+
+// countFFFD counts the U+FFFD runes of a string.
+func countFFFD(s string) int { return strings.Count(s, "\ufffd") }
+
+// dnShapes names the recorded bugs whose shape a lenient acceptance has: an empty attribute
+// type (go-ldap/7); a U+FFFD in a type or value that the text did not have, from a byte that
+// is not UTF-8 (go-ldap/8).
+func dnShapes(s string, g dname) string {
+	empty, fffd := false, 0
+	for _, r := range g {
+		for _, a := range r {
+			empty = empty || a.typ == ""
+			fffd += countFFFD(a.typ) + countFFFD(a.val)
+		}
+	}
+	return shapes(shapeIf(empty, "go-ldap/7"), shapeIf(fffd > countFFFD(s), "go-ldap/8"))
+}
+
+// A mutated DN string: if the grammar accepts it, ParseDN agrees with the grammar; whatever
+// ParseDN accepts has a grammatical, stable String(), no empty type (go-ldap/7) and no
+// replacement character the text did not have (go-ldap/8).
+func TestHegelDNMutationsAreStable(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, dnMutCases).text()
+		m, merr := parseDNStrict(s)
+		got, err := ldap.ParseDN(s)
+		if merr == nil {
+			if err != nil {
+				c.failClass(ht, "valid rejected", "ParseDN(%q) = %v; the grammar reads %v", s, err, m)
+				return
+			}
+			if g := dnameOf(got); !g.equalExact(m) {
+				c.failClass(ht, "valid structure", "ParseDN(%q) = %v; the grammar reads %v", s, g, m)
+				return
+			}
+			if checkCanonical(c, ht, got, s) {
+				c.count("valid agreed")
+			}
+			return
+		}
+		if err != nil {
+			c.count("invalid agreed")
+			return
+		}
+		g := dnameOf(got)
+		if shape := dnShapes(s, g); shape != "" {
+			c.mismatch(ht, shape, "lenient known", "ParseDN(%q) accepted (grammar: %v) as %v", s, merr, g)
+			return
+		}
+		for _, r := range g {
+			for _, a := range r {
+				if !validAttrType(a.typ) {
+					c.count("lenient: type") // types are not validated (accepted difference); their String() may not be grammatical
+					return
+				}
+			}
+		}
+		if checkCanonical(c, ht, got, s) {
+			c.count("lenient accepted")
+		}
+	})
+}
+
+// relation: how the second DN of a comparison derives from the first.
+type relation interface{ apply(a dname) dname }
+
+// sameRel: the same DN, each type upper-cased and each multi-valued RDN's first and last
+// attributes swapped by a coin of the tape.
+type sameRel struct{ coins []int }
+
+func (r sameRel) apply(a dname) dname {
+	t := newTape(r.coins)
+	b := dname{}
+	for _, x := range a {
+		var y rdn
+		for _, at := range x {
+			typ := at.typ
+			if t.coin(50) {
+				typ = strings.ToUpper(typ)
+			}
+			y = append(y, atv{typ, at.val})
+		}
+		if len(y) > 1 && t.coin(50) {
+			y[0], y[len(y)-1] = y[len(y)-1], y[0]
+		}
+		b = append(b, y)
+	}
+	return b
+}
+
+// recaseRel: the same DN with each value upper- or lower-cased by a coin of the tape.
+type recaseRel struct{ coins []int }
+
+func (r recaseRel) apply(a dname) dname {
+	t := newTape(r.coins)
+	b := dname{}
+	for _, x := range a {
+		var y rdn
+		for _, at := range x {
+			val := strings.ToLower(at.val)
+			if t.coin(50) {
+				val = strings.ToUpper(at.val)
+			}
+			y = append(y, atv{at.typ, val})
+		}
+		b = append(b, y)
+	}
+	return b
+}
+
+// descendantRel: extra RDNs in front.
+type descendantRel struct{ prefix dname }
+
+func (r descendantRel) apply(a dname) dname { return append(append(dname{}, r.prefix...), a...) }
+
+// ancestorRel: RDNs dropped in front (drop modulo one more than the count).
+type ancestorRel struct{ drop int }
+
+func (r ancestorRel) apply(a dname) dname { return append(dname{}, a[r.drop%(len(a)+1):]...) }
+
+// changeRel: one RDN's first value changed (at modulo the count; the empty DN unchanged).
+type changeRel struct{ at int }
+
+func (r changeRel) apply(a dname) dname {
+	b := append(dname{}, a...)
+	if len(b) > 0 {
+		i := r.at % len(b)
+		x := append(rdn{}, b[i]...)
+		x[0] = atv{x[0].typ, x[0].val + "x"}
+		b[i] = x
+	}
+	return b
+}
+
+// otherRel: an unrelated DN.
+type otherRel struct{ b dname }
+
+func (r otherRel) apply(dname) dname { return r.b }
+
+func asRelation[T relation](g hegel.Generator[T]) hegel.Generator[relation] {
+	return hegel.Map(g, func(r T) relation { return r })
+}
+
+// relations: the same DN re-cased and reordered three times in ten, values re-cased once, a
+// descendant twice, an ancestor once, one value changed once, an unrelated DN twice.
+var relations = weighted(
+	choice[relation]{3, asRelation(hegel.Map(tapes, func(vals []int) sameRel { return sameRel{vals} }))},
+	choice[relation]{1, asRelation(hegel.Map(tapes, func(vals []int) recaseRel { return recaseRel{vals} }))},
+	choice[relation]{2, asRelation(hegel.Map(dnames, func(d dname) descendantRel { return descendantRel{d} }))},
+	choice[relation]{1, asRelation(hegel.Map(positions, func(k int) ancestorRel { return ancestorRel{k} }))},
+	choice[relation]{1, asRelation(hegel.Map(positions, func(k int) changeRel { return changeRel{k} }))},
+	choice[relation]{2, asRelation(hegel.Map(dnames, func(d dname) otherRel { return otherRel{d} }))},
+)
+
+// cmpCase: a DN and the relation the second one has to it.
+type cmpCase struct {
+	a   dname
+	rel relation
+}
+
+func (c cmpCase) GoString() string {
+	return fmt.Sprintf("a %v\nb %v (%T)", c.a, c.rel.apply(c.a), c.rel)
+}
+
+var cmpCases = hegel.Composite(func(tc hegel.TestCase) cmpCase {
+	return cmpCase{a: hegel.Draw(tc, dnames), rel: hegel.Draw(tc, relations)}
+})
+
+// Equal, EqualFold, AncestorOf and AncestorOfFold follow the godoc's definitions, and Equal DNs
+// have the same String().
+func TestHegelDNComparisons(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, cmpCases)
+		a, b := k.a, k.rel.apply(k.a)
+		da, db := ldapDN(a), ldapDN(b)
+		if got, want := da.Equal(db), dnEq(a, b, false); got != want {
+			c.failClass(ht, "Equal", "Equal(%v, %v) = %v; want %v", a, b, got, want)
+			return
+		}
+		if got, want := da.EqualFold(db), dnEq(a, b, true); got != want {
+			c.failClass(ht, "EqualFold", "EqualFold(%v, %v) = %v; want %v", a, b, got, want)
+			return
+		}
+		if got, want := da.AncestorOf(db), dnAncestor(a, b, false); got != want {
+			c.failClass(ht, "AncestorOf", "AncestorOf(%v, %v) = %v; want %v", a, b, got, want)
+			return
+		}
+		if got, want := da.AncestorOfFold(db), dnAncestor(a, b, true); got != want {
+			c.failClass(ht, "AncestorOfFold", "AncestorOfFold(%v, %v) = %v; want %v", a, b, got, want)
+			return
+		}
+		if eq := dnEq(a, b, false); eq != (da.String() == db.String()) {
+			c.failClass(ht, "String", "Equal(%v, %v) = %v but String() %q vs %q", a, b, eq, da.String(), db.String())
+			return
+		}
+		if dnEq(a, b, false) {
+			c.count("equal")
+		} else if dnAncestor(a, b, false) {
+			c.count("ancestor")
+		} else {
+			c.count("different")
+		}
+	})
+}
+
+// escDNCase: two values for EscapeDN.
+type escDNCase struct{ v, w string }
+
+// hasInvalidUTF8 reports whether a value holds a byte that is not UTF-8: EscapeDN writes
+// U+FFFD for it, as ParseDN does for a raw one (the shape of go-ldap/8).
+func (c escDNCase) hasInvalidUTF8() bool { return !utf8.ValidString(c.v) || !utf8.ValidString(c.w) }
+
+// escDNValues: DN values; under HEGEL_NO_KNOWN=1 only the UTF-8 pieces of the pool.
+var escDNValues = func() hegel.Generator[string] {
+	if !noKnown {
+		return dvalues
+	}
+	var pool []string
+	for _, p := range dvaluePool {
+		if utf8.ValidString(p) {
+			pool = append(pool, p)
+		}
+	}
+	pieces := hegel.SampledFrom(pool)
+	return weighted(choice[string]{92, joined(many(pieces, 1, 5))}, choice[string]{8, hegel.Just("")})
+}()
+
+var escDNCases = hegel.Composite(func(tc hegel.TestCase) escDNCase {
+	return escDNCase{v: hegel.Draw(tc, escDNValues), w: hegel.Draw(tc, escDNValues)}
+})
+
+// EscapeDN makes any string safe as an attribute value; a byte that is not UTF-8 comes back
+// as U+FFFD (go-ldap/8).
+func TestHegelEscapeDNRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, escDNCases)
+		v, w := k.v, k.w
+		shape := shapeIf(k.hasInvalidUTF8(), "go-ldap/8")
+		s := "cn=" + ldap.EscapeDN(v) + "+sn=" + ldap.EscapeDN(w) + ",dc=example"
+		got, err := ldap.ParseDN(s)
+		if err != nil {
+			c.mismatch(ht, shape, "rejected", "ParseDN(%q) (EscapeDN of %q and %q) = %v", s, v, w, err)
+			return
+		}
+		want := dname{rdn{{"cn", v}, {"sn", w}}, rdn{{"dc", "example"}}}
+		if g := dnameOf(got); !g.equalExact(want) {
+			c.mismatch(ht, shape, "value", "ParseDN(%q) = %v; want %v", s, g, want)
+			return
+		}
+		c.count("ok")
+	})
+}
diff --git a/v3/hegel_filter_test.go b/v3/hegel_filter_test.go
new file mode 100644
index 0000000..2a825e7
--- /dev/null
+++ b/v3/hegel_filter_test.go
@@ -0,0 +1,995 @@
+package ldap_test
+
+// RFC 4515 search filters: a strict parser of the grammar (the model), a recursive generator
+// of filter trees, a pure renderer that writes a tree with the escaping choices of a drawn
+// tape, the reading of the library's BER packet back into the model's structure, and the
+// properties on CompileFilter / DecompileFilter / EscapeFilter.
+
+import (
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	ber "github.com/go-asn1-ber/asn1-ber"
+	ldap "github.com/go-ldap/ldap/v3"
+	"hegel.dev/go/hegel"
+)
+
+// filt is a filter as RFC 4515 describes it; values are byte strings (after unescaping).
+type filt struct {
+	op   int
+	kids []*filt
+	attr string
+	// equality, >=, <=, ~=, extensible
+	value string
+	// substrings
+	hasInitial, hasFinal bool
+	initial, final       string
+	any                  []string
+	// extensible
+	rule string
+	dn   bool
+}
+
+func (f *filt) equal(g *filt) bool {
+	if f.op != g.op || f.attr != g.attr || f.value != g.value || f.rule != g.rule || f.dn != g.dn {
+		return false
+	}
+	if f.hasInitial != g.hasInitial || f.hasFinal != g.hasFinal || f.initial != g.initial || f.final != g.final {
+		return false
+	}
+	if len(f.any) != len(g.any) || len(f.kids) != len(g.kids) {
+		return false
+	}
+	for i := range f.any {
+		if f.any[i] != g.any[i] {
+			return false
+		}
+	}
+	for i := range f.kids {
+		if !f.kids[i].equal(g.kids[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// escFilter is RFC 4515's escaping as DecompileFilter applies it: the four specials, NUL and
+// every byte above ASCII as \xx (lower-case hex).
+func escFilter(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c == '(' || c == ')' || c == '*' || c == '\\' || c == 0 || c > 0x7f {
+			fmt.Fprintf(&b, "\\%02x", c)
+			continue
+		}
+		b.WriteByte(c)
+	}
+	return b.String()
+}
+
+// String is the canonical rendering, which DecompileFilter is expected to produce.
+func (f *filt) String() string {
+	var b strings.Builder
+	b.WriteByte('(')
+	switch f.op {
+	case ldap.FilterAnd, ldap.FilterOr:
+		if f.op == ldap.FilterAnd {
+			b.WriteByte('&')
+		} else {
+			b.WriteByte('|')
+		}
+		for _, k := range f.kids {
+			b.WriteString(k.String())
+		}
+	case ldap.FilterNot:
+		b.WriteByte('!')
+		b.WriteString(f.kids[0].String())
+	case ldap.FilterEqualityMatch:
+		b.WriteString(f.attr + "=" + escFilter(f.value))
+	case ldap.FilterGreaterOrEqual:
+		b.WriteString(f.attr + ">=" + escFilter(f.value))
+	case ldap.FilterLessOrEqual:
+		b.WriteString(f.attr + "<=" + escFilter(f.value))
+	case ldap.FilterApproxMatch:
+		b.WriteString(f.attr + "~=" + escFilter(f.value))
+	case ldap.FilterPresent:
+		b.WriteString(f.attr + "=*")
+	case ldap.FilterSubstrings:
+		b.WriteString(f.attr + "=")
+		if f.hasInitial {
+			b.WriteString(escFilter(f.initial))
+		}
+		b.WriteByte('*')
+		for _, a := range f.any {
+			b.WriteString(escFilter(a))
+			b.WriteByte('*')
+		}
+		if f.hasFinal {
+			b.WriteString(escFilter(f.final))
+		}
+	case ldap.FilterExtensibleMatch:
+		b.WriteString(f.attr)
+		if f.dn {
+			b.WriteString(":dn")
+		}
+		if f.rule != "" {
+			b.WriteString(":" + f.rule)
+		}
+		b.WriteString(":=" + escFilter(f.value))
+	}
+	b.WriteByte(')')
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- strict parser
+
+// RFC 4512: attributedescription = attributetype options; attributetype = descr / numericoid.
+var reAttrDesc = regexp.MustCompile(`^([A-Za-z][A-Za-z0-9-]*|(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*))+)(;[A-Za-z0-9-]+)*$`)
+var reOID = regexp.MustCompile(`^([A-Za-z][A-Za-z0-9-]*|(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*))+)$`)
+
+func validAttrDesc(s string) bool { return reAttrDesc.MatchString(s) }
+
+type fparser struct {
+	s   string
+	pos int
+}
+
+func (p *fparser) peek() byte {
+	if p.pos < len(p.s) {
+		return p.s[p.pos]
+	}
+	return 0
+}
+
+func (p *fparser) eat(c byte) bool {
+	if p.pos < len(p.s) && p.s[p.pos] == c {
+		p.pos++
+		return true
+	}
+	return false
+}
+
+func (p *fparser) errf(format string, args ...any) error {
+	return fmt.Errorf("filter grammar at %d: %s", p.pos, fmt.Sprintf(format, args...))
+}
+
+// parseFilterStrict parses s by the RFC 4515 grammar (with RFC 4526's empty AND/OR).
+func parseFilterStrict(s string) (*filt, error) {
+	p := &fparser{s: s}
+	f, err := p.filter()
+	if err != nil {
+		return nil, err
+	}
+	if p.pos != len(s) {
+		return nil, p.errf("trailing %q", s[p.pos:])
+	}
+	return f, nil
+}
+
+func (p *fparser) filter() (*filt, error) {
+	if !p.eat('(') {
+		return nil, p.errf("expected (")
+	}
+	var f *filt
+	var err error
+	switch {
+	case p.eat('&'):
+		f, err = p.list(ldap.FilterAnd)
+	case p.eat('|'):
+		f, err = p.list(ldap.FilterOr)
+	case p.eat('!'):
+		var k *filt
+		k, err = p.filter()
+		if err == nil {
+			f = &filt{op: ldap.FilterNot, kids: []*filt{k}}
+		}
+	default:
+		f, err = p.item()
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !p.eat(')') {
+		return nil, p.errf("expected )")
+	}
+	return f, nil
+}
+
+func (p *fparser) list(op int) (*filt, error) {
+	f := &filt{op: op}
+	for p.peek() == '(' {
+		k, err := p.filter()
+		if err != nil {
+			return nil, err
+		}
+		f.kids = append(f.kids, k)
+	}
+	return f, nil
+}
+
+// run reads a maximal run of attribute-description characters.
+func (p *fparser) run() string {
+	start := p.pos
+	for p.pos < len(p.s) {
+		c := p.s[p.pos]
+		if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '.' || c == ';' {
+			p.pos++
+			continue
+		}
+		break
+	}
+	return p.s[start:p.pos]
+}
+
+func (p *fparser) item() (*filt, error) {
+	attr := p.run()
+	if attr != "" && !validAttrDesc(attr) {
+		return nil, p.errf("invalid attribute description %q", attr)
+	}
+	if p.peek() == ':' {
+		return p.extensible(attr)
+	}
+	if attr == "" {
+		return nil, p.errf("expected attribute")
+	}
+	switch {
+	case p.eat('~'):
+		if !p.eat('=') {
+			return nil, p.errf("expected ~=")
+		}
+		v, err := p.value(false)
+		if err != nil {
+			return nil, err
+		}
+		return &filt{op: ldap.FilterApproxMatch, attr: attr, value: v}, nil
+	case p.eat('>'):
+		if !p.eat('=') {
+			return nil, p.errf("expected >=")
+		}
+		v, err := p.value(false)
+		if err != nil {
+			return nil, err
+		}
+		return &filt{op: ldap.FilterGreaterOrEqual, attr: attr, value: v}, nil
+	case p.eat('<'):
+		if !p.eat('=') {
+			return nil, p.errf("expected <=")
+		}
+		v, err := p.value(false)
+		if err != nil {
+			return nil, err
+		}
+		return &filt{op: ldap.FilterLessOrEqual, attr: attr, value: v}, nil
+	case p.eat('='):
+		// equality, present or substrings: parts separated by unescaped '*'
+		var parts []string
+		for {
+			v, err := p.value(true)
+			if err != nil {
+				return nil, err
+			}
+			parts = append(parts, v)
+			if !p.eat('*') {
+				break
+			}
+		}
+		if len(parts) == 1 {
+			return &filt{op: ldap.FilterEqualityMatch, attr: attr, value: parts[0]}, nil
+		}
+		if len(parts) == 2 && parts[0] == "" && parts[1] == "" {
+			return &filt{op: ldap.FilterPresent, attr: attr}, nil
+		}
+		f := &filt{op: ldap.FilterSubstrings, attr: attr}
+		if parts[0] != "" {
+			f.hasInitial, f.initial = true, parts[0]
+		}
+		last := parts[len(parts)-1]
+		if last != "" {
+			f.hasFinal, f.final = true, last
+		}
+		for _, a := range parts[1 : len(parts)-1] {
+			if a != "" { // an empty <any> component carries nothing
+				f.any = append(f.any, a)
+			}
+		}
+		if !f.hasInitial && !f.hasFinal && len(f.any) == 0 {
+			return nil, p.errf("substrings without a component")
+		}
+		return f, nil
+	}
+	return nil, p.errf("expected a filter type")
+}
+
+// extensible = ( attr [dnattrs] [matchingrule] COLON EQUALS value ) /
+//
+//	( [dnattrs] matchingrule COLON EQUALS value ); dnattrs = COLON "dn" (an ABNF literal,
+//	case-insensitive: RFC 5234 2.3)
+func (p *fparser) extensible(attr string) (*filt, error) {
+	f := &filt{op: ldap.FilterExtensibleMatch, attr: attr}
+	p.pos++ // the first ':'
+	rest := p.s[p.pos:]
+	if len(rest) >= 3 && rest[2] == ':' && strings.EqualFold(rest[:2], "dn") {
+		f.dn = true
+		p.pos += 3
+	}
+	if !p.eat('=') {
+		rule := p.run()
+		if !reOID.MatchString(rule) {
+			return nil, p.errf("invalid matching rule %q", rule)
+		}
+		f.rule = rule
+		if !p.eat(':') || !p.eat('=') {
+			return nil, p.errf("expected := after the matching rule")
+		}
+	}
+	if f.attr == "" && f.rule == "" {
+		return nil, p.errf("extensible match needs an attribute or a matching rule")
+	}
+	v, err := p.value(false)
+	if err != nil {
+		return nil, err
+	}
+	f.value = v
+	return f, nil
+}
+
+// value = 0*(normal / escaped); normal excludes NUL ( ) * \ and must be UTF-8; escaped = \ HEX HEX.
+// With star set, an unescaped '*' ends the value (substrings); otherwise it is an error.
+func (p *fparser) value(star bool) (string, error) {
+	var b strings.Builder
+	for p.pos < len(p.s) {
+		c := p.s[p.pos]
+		switch {
+		case c == ')' || (c == '*' && star):
+			return b.String(), nil
+		case c == '(' || c == '*' || c == 0:
+			return "", p.errf("unescaped %q in a value", c)
+		case c == '\\':
+			if p.pos+2 >= len(p.s) {
+				return "", p.errf("short escape")
+			}
+			x, err := hex.DecodeString(p.s[p.pos+1 : p.pos+3])
+			if err != nil {
+				return "", p.errf("bad escape %q", p.s[p.pos:p.pos+3])
+			}
+			b.WriteByte(x[0])
+			p.pos += 3
+		case c < 0x80:
+			b.WriteByte(c)
+			p.pos++
+		default:
+			r, w := utf8.DecodeRuneInString(p.s[p.pos:])
+			if r == utf8.RuneError && w == 1 {
+				return "", p.errf("invalid UTF-8")
+			}
+			b.WriteString(p.s[p.pos : p.pos+w])
+			p.pos += w
+		}
+	}
+	return "", p.errf("unexpected end")
+}
+
+// --------------------------------------------------------------------------- packets
+
+// filtOfPacket reads the library's packet back into the model's structure, checking the shape
+// RFC 4511 gives the Filter CHOICE.
+func filtOfPacket(p *ber.Packet) (*filt, error) {
+	if p == nil {
+		return nil, errors.New("nil packet")
+	}
+	str := func(c *ber.Packet) string { return string(c.Data.Bytes()) }
+	f := &filt{op: int(p.Tag)}
+	switch f.op {
+	case ldap.FilterAnd, ldap.FilterOr:
+		for _, k := range p.Children {
+			g, err := filtOfPacket(k)
+			if err != nil {
+				return nil, err
+			}
+			f.kids = append(f.kids, g)
+		}
+	case ldap.FilterNot:
+		if len(p.Children) != 1 {
+			return nil, fmt.Errorf("not with %d children", len(p.Children))
+		}
+		g, err := filtOfPacket(p.Children[0])
+		if err != nil {
+			return nil, err
+		}
+		f.kids = []*filt{g}
+	case ldap.FilterEqualityMatch, ldap.FilterGreaterOrEqual, ldap.FilterLessOrEqual, ldap.FilterApproxMatch:
+		if len(p.Children) != 2 {
+			return nil, fmt.Errorf("assertion with %d children", len(p.Children))
+		}
+		f.attr, f.value = str(p.Children[0]), str(p.Children[1])
+	case ldap.FilterPresent:
+		if len(p.Children) != 0 {
+			return nil, fmt.Errorf("present with %d children", len(p.Children))
+		}
+		f.attr = str(p)
+	case ldap.FilterSubstrings:
+		if len(p.Children) != 2 {
+			return nil, fmt.Errorf("substrings with %d children", len(p.Children))
+		}
+		f.attr = str(p.Children[0])
+		subs := p.Children[1].Children
+		if len(subs) == 0 {
+			return nil, errors.New("substrings with an empty SEQUENCE")
+		}
+		for i, c := range subs {
+			switch int(c.Tag) {
+			case ldap.FilterSubstringsInitial:
+				if i != 0 {
+					return nil, errors.New("initial not first")
+				}
+				f.hasInitial, f.initial = true, str(c)
+			case ldap.FilterSubstringsAny:
+				f.any = append(f.any, str(c))
+			case ldap.FilterSubstringsFinal:
+				if i != len(subs)-1 {
+					return nil, errors.New("final not last")
+				}
+				f.hasFinal, f.final = true, str(c)
+			default:
+				return nil, fmt.Errorf("substring tag %d", c.Tag)
+			}
+		}
+	case ldap.FilterExtensibleMatch:
+		seen := map[int]bool{}
+		for _, c := range p.Children {
+			tag := int(c.Tag)
+			if seen[tag] {
+				return nil, fmt.Errorf("extensible: tag %d twice", tag)
+			}
+			seen[tag] = true
+			switch tag {
+			case ldap.MatchingRuleAssertionMatchingRule:
+				f.rule = str(c)
+			case ldap.MatchingRuleAssertionType:
+				f.attr = str(c)
+			case ldap.MatchingRuleAssertionMatchValue:
+				f.value = str(c)
+			case ldap.MatchingRuleAssertionDNAttributes:
+				b, ok := c.Value.(bool)
+				if !ok {
+					return nil, errors.New("extensible: dnAttributes not a boolean")
+				}
+				f.dn = b
+			default:
+				return nil, fmt.Errorf("extensible: tag %d", tag)
+			}
+		}
+		if !seen[ldap.MatchingRuleAssertionMatchValue] {
+			return nil, errors.New("extensible without a value")
+		}
+	default:
+		return nil, fmt.Errorf("filter tag %d", p.Tag)
+	}
+	return f, nil
+}
+
+// --------------------------------------------------------------------------- generators
+
+var attrPool = []string{"cn", "sn", "objectClass", "memberOf", "o", "ou", "givenName", "mail", "uid", "uid;lang-en", "userCertificate;binary", "2.5.4.3", "1.2.840.113556.1.4.1941", "0.9.2342.19200300.100.1.25", "x-my-attr", "a", "Z9-"}
+var rulePool = []string{"caseIgnoreMatch", "2.5.13.2", "1.2.840.113556.1.4.1941", "test", "dnx"}
+
+// fvaluePool: the pieces of a filter value: printable ASCII, the specials, NUL, '=' and
+// friends, non-ASCII runes, a byte that is not UTF-8, a control byte, and a literal U+FFFD
+// (the shape of go-ldap/4, left out under HEGEL_NO_KNOWN=1); the renderer escapes what it must.
+var fvaluePool = func() []string {
+	pool := []string{"a", "b", "Miller", "Bob", " ", "0", "9", "(", ")", "*", "\\", "\x00", "=", "~", ":", "dn", "<", ">", "&", "|", "!", "\"", "#", ",", "\u00e9", "\ud568", "\u4e2d", "\U0001F600", "\xff", "\x01", "~="}
+	return shaped(append(pool, "\ufffd"), pool)
+}()
+
+var (
+	attrs           = hegel.SampledFrom(attrPool)
+	rules           = hegel.SampledFrom(rulePool)
+	fpieces         = hegel.SampledFrom(fvaluePool)
+	fvalues         = joined(many(fpieces, 0, 5))
+	fvaluesNonEmpty = joined(many(fpieces, 1, 5))
+	orderingOps     = hegel.SampledFrom([]int{ldap.FilterGreaterOrEqual, ldap.FilterLessOrEqual, ldap.FilterApproxMatch})
+	listOps         = hegel.SampledFrom([]int{ldap.FilterAnd, ldap.FilterOr})
+
+	equalities = hegel.Composite(func(tc hegel.TestCase) *filt {
+		return &filt{op: ldap.FilterEqualityMatch, attr: hegel.Draw(tc, attrs), value: hegel.Draw(tc, fvalues)}
+	})
+	presents  = hegel.Map(attrs, func(a string) *filt { return &filt{op: ldap.FilterPresent, attr: a} })
+	orderings = hegel.Composite(func(tc hegel.TestCase) *filt {
+		return &filt{op: hegel.Draw(tc, orderingOps), attr: hegel.Draw(tc, attrs), value: hegel.Draw(tc, fvalues)}
+	})
+	// substrings: an initial 60% of the time, up to three any components, a final 60% of the
+	// time; a substrings filter with no component gets a final.
+	substrings = hegel.Composite(func(tc hegel.TestCase) *filt {
+		f := &filt{op: ldap.FilterSubstrings, attr: hegel.Draw(tc, attrs)}
+		if ini := hegel.Draw(tc, maybe(60, fvaluesNonEmpty)); ini != "" {
+			f.hasInitial, f.initial = true, ini
+		}
+		f.any = hegel.Draw(tc, many(fvaluesNonEmpty, 0, 3))
+		if fin := hegel.Draw(tc, maybe(60, fvaluesNonEmpty)); fin != "" {
+			f.hasFinal, f.final = true, fin
+		}
+		if !f.hasInitial && !f.hasFinal && len(f.any) == 0 {
+			f.hasFinal, f.final = true, hegel.Draw(tc, fvaluesNonEmpty)
+		}
+		return f
+	})
+	// extensibles: dnAttributes 40% of the time, an attribute 80%, a matching rule 50% (always
+	// when there is no attribute).
+	extensibles = hegel.Composite(func(tc hegel.TestCase) *filt {
+		f := &filt{op: ldap.FilterExtensibleMatch, value: hegel.Draw(tc, fvalues), dn: hegel.Draw(tc, chance(40))}
+		f.attr = hegel.Draw(tc, maybe(80, attrs))
+		if rule := hegel.Draw(tc, rules); f.attr == "" || hegel.Draw(tc, chance(50)) {
+			f.rule = rule
+		}
+		return f
+	})
+	// leaves: the filter items, an equality first.
+	leaves = weighted(
+		choice[*filt]{25, equalities},
+		choice[*filt]{10, presents},
+		choice[*filt]{15, orderings},
+		choice[*filt]{22, substrings},
+		choice[*filt]{28, extensibles},
+	)
+	// valuedLeaves: the items with an assertion value.
+	valuedLeaves = weighted(
+		choice[*filt]{25, equalities},
+		choice[*filt]{15, orderings},
+		choice[*filt]{22, substrings},
+		choice[*filt]{28, extensibles},
+	)
+)
+
+// grammar: the filters of a nesting bound and, separately, its lists.
+type grammar struct{ filters, lists hegel.Generator[*filt] }
+
+// filterGrammar builds filters nested bound levels deep: a leaf, or (35% of the time above
+// the bound) a list: AND or OR of up to three filters, or NOT of one (4:1). The counter in
+// the closure tracks the live recursion (hegel-go's ExampleComposite_recursive).
+func filterGrammar(bound int) grammar {
+	var nodes hegel.Generator[*filt]
+	kids := deferred(&nodes)
+	nots := hegel.Map(kids, func(k *filt) *filt { return &filt{op: ldap.FilterNot, kids: []*filt{k}} })
+	andOrs := hegel.Composite(func(tc hegel.TestCase) *filt {
+		return &filt{op: hegel.Draw(tc, listOps), kids: hegel.Draw(tc, many(kids, 0, 3))}
+	})
+	lists := weighted(choice[*filt]{4, andOrs}, choice[*filt]{1, nots})
+	branches := weighted(choice[*filt]{65, leaves}, choice[*filt]{35, lists})
+	depth := 0
+	nodes = hegel.Composite(func(tc hegel.TestCase) *filt {
+		if depth >= bound {
+			return hegel.Draw(tc, leaves)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branches)
+	})
+	return grammar{filters: nodes, lists: lists}
+}
+
+var (
+	deepFilters    = filterGrammar(3)
+	shallowFilters = filterGrammar(2)
+)
+
+// --------------------------------------------------------------------------- renderer
+
+// dnattrsSpellings: the spellings of the dnattrs marker (an ABNF literal, so any case); under
+// HEGEL_NO_KNOWN=1 the lower-case one alone (go-ldap/3).
+var dnattrsSpellings = shaped([]string{":dn", ":DN", ":Dn", ":dN"}, []string{":dn"})
+
+// renderFValue writes v with grammatical escaping: the specials, NUL and a byte that is not
+// UTF-8 as \xx (either hex case, a coin of the tape), any other rune raw or, 15% of the time,
+// hex-escaped byte by byte (under HEGEL_NO_KNOWN=1 a literal U+FFFD always escaped: go-ldap/4).
+func renderFValue(v string, t *tape) string {
+	var b strings.Builder
+	esc := func(c byte) { b.WriteString(hexEsc(c, t.coin(50))) }
+	for i := 0; i < len(v); {
+		c := v[i]
+		if c == '(' || c == ')' || c == '*' || c == '\\' || c == 0 {
+			esc(c)
+			i++
+			continue
+		}
+		r, w := utf8.DecodeRuneInString(v[i:])
+		invalid := r == utf8.RuneError && w == 1
+		literalFFFD := r == utf8.RuneError && w == 3 && Known.replacementCharRejected
+		if invalid || literalFFFD || t.coin(15) {
+			for j := 0; j < w; j++ {
+				esc(v[i+j])
+			}
+		} else {
+			b.WriteString(v[i : i+w])
+		}
+		i += w
+	}
+	return b.String()
+}
+
+// marks are the places of a rendered filter text that the properties refer to: the offsets of
+// the ')' closing each AND/OR/NOT node, in text order, and the spans of the items' heads (the
+// attribute description and the operator, or the attribute, dnattrs marker, matching rule and
+// ":=" of an extensible match), whose bytes decide what the library reads as the attribute
+// and the rule.
+type marks struct {
+	closers   []int
+	protected []span
+}
+
+// filterGuard is the guard of a filter text's mutations: none by default; under
+// HEGEL_NO_KNOWN=1 rune by rune, leaving the attributes and rules alone.
+func filterGuard(m marks) guard {
+	return shaped(guard{}, guard{runes: true, protected: m.protected})
+}
+
+// writer renders filter trees into one text, recording the marks.
+type writer struct {
+	b strings.Builder
+	m marks
+}
+
+// head writes an item's head (everything from after its '(' to the end of its operator) and
+// records its span.
+func (w *writer) head(s string) {
+	w.m.protected = append(w.m.protected, span{w.b.Len(), w.b.Len() + len(s)})
+	w.b.WriteString(s)
+}
+
+// closer writes the ')' of a list and records its offset.
+func (w *writer) closer() {
+	w.m.closers = append(w.m.closers, w.b.Len())
+	w.b.WriteByte(')')
+}
+
+// extensible writes an extensible match with the given dnattrs spelling.
+func (w *writer) extensible(f *filt, dnattrs string, t *tape) {
+	h := f.attr
+	if f.dn {
+		h += dnattrs
+	}
+	if f.rule != "" {
+		h += ":" + f.rule
+	}
+	w.b.WriteByte('(')
+	w.head(h + ":=")
+	w.b.WriteString(renderFValue(f.value, t) + ")")
+}
+
+// filter writes f with the tape's choices: the value escaping, an extra '*' after an any
+// component 10% of the time (an empty <any>, grammatical and carrying nothing), the dnattrs
+// spelling.
+func (w *writer) filter(f *filt, t *tape) {
+	switch f.op {
+	case ldap.FilterAnd, ldap.FilterOr:
+		if f.op == ldap.FilterAnd {
+			w.b.WriteString("(&")
+		} else {
+			w.b.WriteString("(|")
+		}
+		for _, k := range f.kids {
+			w.filter(k, t)
+		}
+		w.closer()
+	case ldap.FilterNot:
+		w.b.WriteString("(!")
+		w.filter(f.kids[0], t)
+		w.closer()
+	case ldap.FilterEqualityMatch:
+		w.item(f, "=", t)
+	case ldap.FilterGreaterOrEqual:
+		w.item(f, ">=", t)
+	case ldap.FilterLessOrEqual:
+		w.item(f, "<=", t)
+	case ldap.FilterApproxMatch:
+		w.item(f, "~=", t)
+	case ldap.FilterPresent:
+		w.b.WriteByte('(')
+		w.head(f.attr + "=")
+		w.b.WriteString("*)")
+	case ldap.FilterSubstrings:
+		w.b.WriteByte('(')
+		w.head(f.attr + "=")
+		if f.hasInitial {
+			w.b.WriteString(renderFValue(f.initial, t))
+		}
+		w.b.WriteByte('*')
+		for _, a := range f.any {
+			w.b.WriteString(renderFValue(a, t))
+			w.b.WriteByte('*')
+			if t.coin(10) {
+				w.b.WriteByte('*')
+			}
+		}
+		if f.hasFinal {
+			w.b.WriteString(renderFValue(f.final, t))
+		}
+		w.b.WriteByte(')')
+	case ldap.FilterExtensibleMatch:
+		w.extensible(f, dnattrsSpellings[t.next(len(dnattrsSpellings))], t)
+	}
+}
+
+// item writes an assertion: attribute, operator, value.
+func (w *writer) item(f *filt, op string, t *tape) {
+	w.b.WriteByte('(')
+	w.head(f.attr + op)
+	w.b.WriteString(renderFValue(f.value, t) + ")")
+}
+
+// renderExtensible is the text of an extensible match with the given dnattrs spelling.
+func renderExtensible(f *filt, dnattrs string, t *tape) string {
+	var w writer
+	w.extensible(f, dnattrs, t)
+	return w.b.String()
+}
+
+// renderFilt is the text of f under the tape's choices.
+func renderFilt(f *filt, t *tape) string {
+	s, _ := renderFiltMarked(f, t)
+	return s
+}
+
+// renderFiltMarked is renderFilt with the text's marks.
+func renderFiltMarked(f *filt, t *tape) (string, marks) {
+	var w writer
+	w.filter(f, t)
+	return w.b.String(), w.m
+}
+
+func describeFilt(f *filt) string { return f.String() }
+
+// --------------------------------------------------------------------------- shapes
+
+// dnattrsUpper reports whether a text spells the dnattrs marker other than ":dn:" (go-ldap/3).
+func dnattrsUpper(s string) bool {
+	for _, sp := range []string{":DN:", ":Dn:", ":dN:"} {
+		if strings.Contains(s, sp) {
+			return true
+		}
+	}
+	return false
+}
+
+// validFilterShapes names the recorded bugs whose shape a grammatical filter text has: a
+// dnattrs marker not in lower case (go-ldap/3), a literal U+FFFD (go-ldap/4).
+func validFilterShapes(s string) string {
+	return shapes(shapeIf(dnattrsUpper(s), "go-ldap/3"), shapeIf(strings.Contains(s, "\ufffd"), "go-ldap/4"))
+}
+
+// lenientFilterShapes names the recorded bugs whose shape a lenient acceptance has: a text not
+// ending in ')' (go-ldap/1: the byte closing a list is not checked), an attribute or matching
+// rule that is no attribute description (go-ldap/5), an extensible match with neither
+// (go-ldap/6).
+func lenientFilterShapes(s string, g *filt) string {
+	attr, none := badHeads(g)
+	return shapes(shapeIf(!strings.HasSuffix(s, ")"), "go-ldap/1"), shapeIf(attr, "go-ldap/5"), shapeIf(none, "go-ldap/6"))
+}
+
+// badHeads walks a compiled tree and reports whether some item has an attribute or matching
+// rule that is no attribute description, and whether some extensible match has neither.
+func badHeads(g *filt) (attr, none bool) {
+	switch g.op {
+	case ldap.FilterAnd, ldap.FilterOr, ldap.FilterNot:
+		for _, k := range g.kids {
+			a, n := badHeads(k)
+			attr, none = attr || a, none || n
+		}
+	case ldap.FilterExtensibleMatch:
+		attr = (g.attr != "" && !validAttrDesc(g.attr)) || (g.rule != "" && !reOID.MatchString(g.rule))
+		none = g.attr == "" && g.rule == ""
+	default:
+		attr = !validAttrDesc(g.attr)
+	}
+	return attr, none
+}
+
+// --------------------------------------------------------------------------- properties
+
+// compilesLike checks a grammatical filter text against its tree: CompileFilter gives the
+// packet the grammar describes, DecompileFilter the canonical form, which compiles back to the
+// same packet; a failure names the shape.
+func compilesLike(c *collector, ht *hegel.T, f *filt, s, shape string) bool {
+	p, err := ldap.CompileFilter(s)
+	if err != nil {
+		c.mismatch(ht, shape, "rejected", "CompileFilter(%q) = %v; want %s", s, err, describeFilt(f))
+		return false
+	}
+	g, err := filtOfPacket(p)
+	if err != nil {
+		c.mismatch(ht, shape, "packet", "CompileFilter(%q): %v", s, err)
+		return false
+	}
+	if !g.equal(f) {
+		c.mismatch(ht, shape, "structure", "CompileFilter(%q) = %s; want %s", s, g, describeFilt(f))
+		return false
+	}
+	d, err := ldap.DecompileFilter(p)
+	if err != nil {
+		c.mismatch(ht, shape, "decompile", "DecompileFilter of %q: %v", s, err)
+		return false
+	}
+	if d != f.String() {
+		c.mismatch(ht, shape, "canonical", "DecompileFilter of %q = %q; want %q", s, d, f.String())
+		return false
+	}
+	p2, err := ldap.CompileFilter(d)
+	if err != nil {
+		c.mismatch(ht, shape, "recompile", "CompileFilter(%q) (decompiled from %q) = %v", d, s, err)
+		return false
+	}
+	if g2, err := filtOfPacket(p2); err != nil || !g2.equal(f) {
+		c.mismatch(ht, shape, "roundtrip", "recompiled %q = %v (%v); want %s", d, g2, err, describeFilt(f))
+		return false
+	}
+	return true
+}
+
+// fCase: a filter tree and the tape of its rendering.
+type fCase struct {
+	f    *filt
+	tape []int
+}
+
+func (c fCase) text() string { return renderFilt(c.f, newTape(c.tape)) }
+
+func (c fCase) GoString() string { return fmt.Sprintf("filter %s\ntext %q", c.f, c.text()) }
+
+func fCasesOf(g hegel.Generator[*filt]) hegel.Generator[fCase] {
+	return hegel.Composite(func(tc hegel.TestCase) fCase {
+		return fCase{f: hegel.Draw(tc, g), tape: hegel.Draw(tc, tapes)}
+	})
+}
+
+var fCases = fCasesOf(deepFilters.filters)
+
+// A grammatical filter string compiles to the packet its grammar describes, decompiles to the
+// canonical form, which compiles back to the same packet. A dnattrs marker not in lower case
+// is the shape of go-ldap/3, a literal U+FFFD in a value that of go-ldap/4.
+func TestHegelFilterCompilesGrammar(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, fCases)
+		s := k.text()
+		if m, err := parseFilterStrict(s); err != nil || !m.equal(k.f) {
+			c.failClass(ht, "model", "model: %q parsed as %v, want %s (%v)", s, m, describeFilt(k.f), err)
+			return
+		}
+		if compilesLike(c, ht, k.f, s, validFilterShapes(s)) {
+			c.count(fmt.Sprintf("ok %s", ldap.FilterMap[uint64(k.f.op)]))
+		}
+	})
+}
+
+// fMutCase: a filter tree, the tape of its rendering, and one or two mutations of the text.
+type fMutCase struct {
+	f    *filt
+	tape []int
+	muts []mutation
+}
+
+func (c fMutCase) text() string {
+	s, m := renderFiltMarked(c.f, newTape(c.tape))
+	return mutate(s, c.muts, filterGuard(m))
+}
+
+func (c fMutCase) GoString() string { return fmt.Sprintf("filter %s\nmutated %q", c.f, c.text()) }
+
+var fMutCases = hegel.Composite(func(tc hegel.TestCase) fMutCase {
+	return fMutCase{
+		f:    hegel.Draw(tc, shallowFilters.filters),
+		tape: hegel.Draw(tc, tapes),
+		muts: hegel.Draw(tc, many(mutationsFrom(mutationPool), 1, 2)),
+	}
+})
+
+// A mutated filter string: if the grammar accepts it, CompileFilter agrees with the grammar;
+// whatever CompileFilter accepts must be a well-formed packet (go-ldap/2) with an attribute
+// description and matching rule as RFC 4512 has them (go-ldap/5, go-ldap/6), from a text ending
+// in ')' (go-ldap/1), whose decompiled form is grammatical and compiles back to the same packet.
+func TestHegelFilterMutationsAreStable(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, fMutCases).text()
+		m, merr := parseFilterStrict(s)
+		p, err := ldap.CompileFilter(s)
+		if merr == nil {
+			shape := validFilterShapes(s)
+			if err != nil {
+				c.mismatch(ht, shape, "valid rejected", "CompileFilter(%q) = %v; the grammar reads %s", s, err, describeFilt(m))
+				return
+			}
+			g, gerr := filtOfPacket(p)
+			if gerr != nil || !g.equal(m) {
+				c.mismatch(ht, shape, "valid structure", "CompileFilter(%q) = %v (%v); the grammar reads %s", s, g, gerr, describeFilt(m))
+				return
+			}
+			if d, derr := ldap.DecompileFilter(p); derr != nil || d != m.String() {
+				c.mismatch(ht, shape, "valid canonical", "DecompileFilter of %q = %q (%v); want %q", s, d, derr, m.String())
+				return
+			}
+			c.count("valid agreed")
+			return
+		}
+		if err != nil {
+			c.count("invalid agreed")
+			return
+		}
+		// lenient acceptance: the result must still be a well-formed, stable filter
+		g, gerr := filtOfPacket(p)
+		if gerr != nil {
+			shape := shapeIf(strings.Contains(gerr.Error(), "empty SEQUENCE"), "go-ldap/2")
+			c.mismatch(ht, shape, "lenient packet", "CompileFilter(%q) accepted (grammar: %v) but the packet is malformed: %v", s, merr, gerr)
+			return
+		}
+		if shape := lenientFilterShapes(s, g); shape != "" {
+			d, _ := ldap.DecompileFilter(p)
+			c.mismatch(ht, shape, "lenient known", "CompileFilter(%q) accepted (grammar: %v) as %s (decompiles as %q)", s, merr, g, d)
+			return
+		}
+		d, derr := ldap.DecompileFilter(p)
+		if derr != nil {
+			c.failClass(ht, "lenient decompile", "CompileFilter(%q) accepted (grammar: %v) but DecompileFilter fails: %v", s, merr, derr)
+			return
+		}
+		m2, err2 := parseFilterStrict(d)
+		if err2 != nil {
+			c.failClass(ht, "lenient canonical", "CompileFilter(%q) accepted (grammar: %v); its decompiled form %q is not grammatical: %v", s, merr, d, err2)
+			return
+		}
+		if !m2.equal(g) {
+			c.failClass(ht, "lenient roundtrip", "CompileFilter(%q) = %s; its decompiled form %q reads as %s", s, g, d, m2)
+			return
+		}
+		c.count("lenient accepted")
+	})
+}
+
+// escFCase: a value, a non-empty value and an attribute for EscapeFilter.
+type escFCase struct{ v, w, attr string }
+
+var escFCases = hegel.Composite(func(tc hegel.TestCase) escFCase {
+	return escFCase{v: hegel.Draw(tc, fvalues), w: hegel.Draw(tc, fvaluesNonEmpty), attr: hegel.Draw(tc, attrs)}
+})
+
+// EscapeFilter makes any byte string safe as an assertion value, in equality and substring
+// positions.
+func TestHegelEscapeFilterRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, escFCases)
+		v, w, attr := k.v, k.w, k.attr
+		s := "(" + attr + "=" + ldap.EscapeFilter(v) + ")"
+		p, err := ldap.CompileFilter(s)
+		if err != nil {
+			c.failClass(ht, "equality", "CompileFilter(%q) (EscapeFilter of %q) = %v", s, v, err)
+			return
+		}
+		g, gerr := filtOfPacket(p)
+		if gerr != nil || g.op != ldap.FilterEqualityMatch || g.attr != attr || g.value != v {
+			c.failClass(ht, "equality value", "CompileFilter(%q) = %v (%v); want equality %s=%q", s, g, gerr, attr, v)
+			return
+		}
+		s = "(" + attr + "=" + ldap.EscapeFilter(w) + "*" + ldap.EscapeFilter(v) + "*" + ldap.EscapeFilter(w) + ")"
+		p, err = ldap.CompileFilter(s)
+		if err != nil {
+			c.failClass(ht, "substrings", "CompileFilter(%q) = %v", s, err)
+			return
+		}
+		g, gerr = filtOfPacket(p)
+		want := &filt{op: ldap.FilterSubstrings, attr: attr, hasInitial: true, initial: w, hasFinal: true, final: w}
+		if v != "" {
+			want.any = []string{v}
+		}
+		if gerr != nil || !g.equal(want) {
+			c.failClass(ht, "substrings value", "CompileFilter(%q) = %v (%v); want %s", s, g, gerr, want)
+			return
+		}
+		c.count("ok")
+	})
+}
diff --git a/v3/hegel_pins_test.go b/v3/hegel_pins_test.go
new file mode 100644
index 0000000..0f8e6d7
--- /dev/null
+++ b/v3/hegel_pins_test.go
@@ -0,0 +1,123 @@
+package ldap_test
+
+// One plain test per recorded bug (bugs.toml): each asserts the documented behaviour and fails
+// while the bug exists; target.toml lists them as expected failures.
+
+import (
+	"testing"
+
+	ldap "github.com/go-ldap/ldap/v3"
+)
+
+// go-ldap/1: the byte that should close an AND/OR/NOT list or a parenthesized filter is
+// skipped without being checked.
+func TestHegelPinFilterClosingParenChecked(t *testing.T) {
+	for _, s := range []string{"(&(a=b)x", "(!(a=b)x", "((a=b)x", "(|(a=b)]", "(&(a=b)(c=d)x"} {
+		if p, err := ldap.CompileFilter(s); err == nil {
+			d, _ := ldap.DecompileFilter(p)
+			t.Errorf("CompileFilter(%q) compiled (as %q); the filter is not well-formed", s, d)
+		}
+	}
+}
+
+// go-ldap/2: "(sn=**)" compiles to a Substrings filter with an empty SEQUENCE and decompiles
+// as "(sn=)", an equality match with the empty string.
+func TestHegelPinEmptySubstringsRejected(t *testing.T) {
+	for _, s := range []string{"(sn=**)", "(sn=***)"} {
+		p, err := ldap.CompileFilter(s)
+		if err != nil {
+			continue
+		}
+		if p.Tag == ldap.FilterSubstrings && len(p.Children) == 2 && len(p.Children[1].Children) == 0 {
+			t.Errorf("CompileFilter(%q): a Substrings filter with no component (RFC 4511: SIZE (1..MAX))", s)
+		}
+		if d, _ := ldap.DecompileFilter(p); d == "(sn=)" {
+			t.Errorf("CompileFilter(%q) decompiles as %q, an equality match", s, d)
+		}
+	}
+}
+
+// go-ldap/3: dnattrs ("dn" in the RFC's ABNF, case-insensitive) is matched case-sensitively:
+// "(o:DN:=x)" is read as the matching rule "DN".
+func TestHegelPinDnattrsCaseInsensitive(t *testing.T) {
+	p, err := ldap.CompileFilter("(o:DN:=x)")
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := filtOfPacket(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !f.dn || f.rule != "" {
+		t.Errorf("(o:DN:=x) compiled with dnAttributes=%v, matchingRule=%q; want dnAttributes and no rule, as for (o:dn:=x)", f.dn, f.rule)
+	}
+}
+
+// go-ldap/4: a literal U+FFFD in a filter value is rejected as an encoding error.
+func TestHegelPinReplacementCharCompiles(t *testing.T) {
+	s := "(cn=a�b)"
+	p, err := ldap.CompileFilter(s)
+	if err != nil {
+		t.Fatalf("CompileFilter(%q) = %v; U+FFFD is a valid UTF-8 character", s, err)
+	}
+	if f, err := filtOfPacket(p); err != nil || f.value != "a�b" {
+		t.Errorf("CompileFilter(%q) = %v (%v)", s, f, err)
+	}
+}
+
+// go-ldap/5: the attribute description of a filter item is not validated: an empty attribute
+// and one with a backslash compile, and the decompiled form of the latter is another attribute.
+func TestHegelPinAttributeDescriptionValidated(t *testing.T) {
+	for _, s := range []string{"(=v)", `(a\2ab=v)`, "(a b=v)"} {
+		p, err := ldap.CompileFilter(s)
+		if err != nil {
+			continue
+		}
+		d, _ := ldap.DecompileFilter(p)
+		t.Errorf("CompileFilter(%q) compiled (decompiles as %q); the attribute is not an attributedescription", s, d)
+	}
+}
+
+// go-ldap/6: an extensible match needs an attribute or a matching rule.
+func TestHegelPinExtensibleNeedsAttrOrRule(t *testing.T) {
+	for _, s := range []string{"(:=a)", "(:dn:=a)"} {
+		if _, err := ldap.CompileFilter(s); err == nil {
+			t.Errorf("CompileFilter(%q) compiled; RFC 4515 wants an attribute or a matching rule", s)
+		}
+	}
+}
+
+// go-ldap/7: a DN with an empty attribute type is accepted, the "=" swallowed.
+func TestHegelPinEmptyTypeRejected(t *testing.T) {
+	for _, s := range []string{"=a=b", "cn=x,=a=b", " =a=b"} {
+		if d, err := ldap.ParseDN(s); err == nil {
+			t.Errorf("ParseDN(%q) = %q; want an error (empty attribute type)", s, d.String())
+		}
+	}
+}
+
+// go-ldap/8: bytes that are not UTF-8 in a DN string are accepted and become U+FFFD.
+func TestHegelPinDNRejectsInvalidUTF8(t *testing.T) {
+	d, err := ldap.ParseDN("cn=a\xffb")
+	if err != nil {
+		return
+	}
+	if v := d.RDNs[0].Attributes[0].Value; v != "a\xffb" {
+		t.Errorf("ParseDN(\"cn=a\\xffb\") = %q (String %q); the byte was neither rejected nor kept", v, d.String())
+	}
+}
+
+// go-ldap/9: spaces around a hex-encoded value are not insignificant as they are around a
+// string value: a leading space makes the value literal, a trailing one an error.
+func TestHegelPinHexstringSpacesInsignificant(t *testing.T) {
+	for _, s := range []string{"cn= #04024869", "cn=#04024869 ", "cn= #04024869 ,dc=x"} {
+		d, err := ldap.ParseDN(s)
+		if err != nil {
+			t.Errorf("ParseDN(%q) = %v; \"cn=#04024869\" gives \"Hi\" and \"cn= Hi \" gives \"Hi\"", s, err)
+			continue
+		}
+		if v := d.RDNs[0].Attributes[0].Value; v != "Hi" {
+			t.Errorf("ParseDN(%q) = %q; \"cn=#04024869\" gives \"Hi\"", s, v)
+		}
+	}
+}
diff --git a/v3/hegel_shapes_test.go b/v3/hegel_shapes_test.go
new file mode 100644
index 0000000..66a5069
--- /dev/null
+++ b/v3/hegel_shapes_test.go
@@ -0,0 +1,572 @@
+package ldap_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the oracle of the wide property that found it, so that each bug
+// has a property that finds it every run (the wide properties in hegel_dn_test.go and
+// hegel_filter_test.go reach the shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each
+// draws the neighbouring region the bug does not touch instead (a list closer deleted rather
+// than replaced, a present filter or a substrings with a component, the lower-case dnattrs
+// marker, an escaped U+FFFD, an attribute description from the pool, an extensible match with
+// an attribute or a rule, a type before the '=', an escaped byte, spaces around a string
+// value) and passes.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	ldap "github.com/go-ldap/ldap/v3"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- go-ldap/1
+
+// closerCase: a list filter (AND, OR or NOT, nested up to two levels), the tape of its
+// rendering, the list closer it damages (modulo their number) and the byte put in its place.
+type closerCase struct {
+	f    *filt
+	tape []int
+	at   int
+	junk string
+}
+
+// text is the rendering with the closer replaced by the junk byte or, under HEGEL_NO_KNOWN=1,
+// deleted (the truncation the library does check).
+func (c closerCase) text() string {
+	s, m := renderFiltMarked(c.f, newTape(c.tape))
+	i := m.closers[c.at%len(m.closers)]
+	return s[:i] + shaped(c.junk, "") + s[i+1:]
+}
+
+func (c closerCase) GoString() string { return fmt.Sprintf("filter %s\ntext %q", c.f, c.text()) }
+
+var (
+	// junkClosers: bytes that cannot close a list.
+	junkClosers = hegel.SampledFrom([]string{"x", "]", " ", "a", "=", "0", "*"})
+	closerCases = hegel.Composite(func(tc hegel.TestCase) closerCase {
+		return closerCase{
+			f:    hegel.Draw(tc, shallowFilters.lists),
+			tape: hegel.Draw(tc, tapes),
+			at:   hegel.Draw(tc, positions),
+			junk: hegel.Draw(tc, junkClosers),
+		}
+	})
+)
+
+// TestHegelFilterListClosersAreChecked: a filter whose AND/OR/NOT list is not closed by ')' is
+// not well-formed (RFC 4515: filter = LPAREN filtercomp RPAREN) and does not compile; the
+// library skips the byte in the closer's place without looking at it (go-ldap/1).
+func TestHegelFilterListClosersAreChecked(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, closerCases).text()
+		if p, err := ldap.CompileFilter(s); err == nil {
+			d, _ := ldap.DecompileFilter(p)
+			c.mismatch(ht, known("go-ldap/1"), "accepted", "CompileFilter(%q) compiled (as %q); the byte closing a list is not ')'", s, d)
+			return
+		}
+		c.count("rejected")
+	})
+}
+
+// --------------------------------------------------------------------------- go-ldap/2
+
+// starCase: an attribute and a condition of '*'s: two to four stars and nothing else (the
+// shape of go-ldap/2); under HEGEL_NO_KNOWN=1 one star (the present filter) or stars with a
+// component (the substrings the library reads right).
+type starCase struct{ attr, cond string }
+
+func (c starCase) text() string { return "(" + c.attr + "=" + c.cond + ")" }
+
+func (c starCase) GoString() string { return fmt.Sprintf("text %q", c.text()) }
+
+var (
+	starsOnly = hegel.Map(hegel.Integers(2, 4), func(n int) string { return strings.Repeat("*", n) })
+	// starsWithPart: a present filter, or a substrings pattern with one non-empty component
+	// (P) and, in the last, an empty any.
+	starsWithPart = hegel.OneOf(
+		hegel.Just("*"),
+		hegel.Composite(func(tc hegel.TestCase) string {
+			part := renderFValue(hegel.Draw(tc, fvaluesNonEmpty), newTape(hegel.Draw(tc, tapes)))
+			return strings.ReplaceAll(hegel.Draw(tc, hegel.SampledFrom([]string{"P*", "*P", "*P*", "P**P"})), "P", part)
+		}),
+	)
+	starCases = hegel.Composite(func(tc hegel.TestCase) starCase {
+		return starCase{attr: hegel.Draw(tc, attrs), cond: hegel.Draw(tc, shaped(starsOnly, starsWithPart))}
+	})
+)
+
+// TestHegelStarOnlyConditionsAreNotEmptySubstrings: a condition of two or more '*'s and nothing
+// else is either an error or the present filter; whatever CompileFilter makes of it must be a
+// well-formed packet (RFC 4511: substrings SIZE (1..MAX)) whose decompiled form compiles back to
+// the same packet. The library builds a Substrings filter with an empty SEQUENCE, which
+// decompiles as an equality match with the empty value (go-ldap/2).
+func TestHegelStarOnlyConditionsAreNotEmptySubstrings(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, starCases).text()
+		p, err := ldap.CompileFilter(s)
+		if err != nil {
+			c.count("rejected")
+			return
+		}
+		g, gerr := filtOfPacket(p)
+		if gerr != nil {
+			c.mismatch(ht, known("go-ldap/2"), "packet", "CompileFilter(%q) accepted but the packet is malformed: %v", s, gerr)
+			return
+		}
+		d, derr := ldap.DecompileFilter(p)
+		if derr != nil {
+			c.failClass(ht, "decompile", "DecompileFilter of %q: %v", s, derr)
+			return
+		}
+		p2, err := ldap.CompileFilter(d)
+		if err != nil {
+			c.failClass(ht, "recompile", "CompileFilter(%q) (decompiled from %q) = %v", d, s, err)
+			return
+		}
+		if g2, err := filtOfPacket(p2); err != nil || !g2.equal(g) {
+			c.failClass(ht, "roundtrip", "CompileFilter(%q) = %s; its decompiled form %q reads as %v (%v)", s, g, d, g2, err)
+			return
+		}
+		c.count("ok " + ldap.FilterMap[uint64(g.op)])
+	})
+}
+
+// --------------------------------------------------------------------------- go-ldap/3
+
+// dnattrsCase: an extensible match with dnAttributes, the spelling of its marker and the tape
+// of its value's rendering.
+type dnattrsCase struct {
+	f        *filt
+	spelling string
+	tape     []int
+}
+
+func (c dnattrsCase) text() string { return renderExtensible(c.f, c.spelling, newTape(c.tape)) }
+
+func (c dnattrsCase) GoString() string { return fmt.Sprintf("filter %s\ntext %q", c.f, c.text()) }
+
+var (
+	// upperDnattrs: the dnattrs marker in a case other than lower; under HEGEL_NO_KNOWN=1 lower.
+	upperDnattrs  = shaped(hegel.SampledFrom([]string{":DN", ":Dn", ":dN"}), hegel.Just(":dn"))
+	dnExtensibles = hegel.Map(extensibles, func(f *filt) *filt {
+		f.dn = true
+		return f
+	})
+	dnattrsCases = hegel.Composite(func(tc hegel.TestCase) dnattrsCase {
+		return dnattrsCase{f: hegel.Draw(tc, dnExtensibles), spelling: hegel.Draw(tc, upperDnattrs), tape: hegel.Draw(tc, tapes)}
+	})
+)
+
+// TestHegelDnattrsMarkerIsCaseInsensitive: dnattrs = COLON "dn" is an ABNF literal (RFC 5234
+// 2.3: case-insensitive), so ":DN:" marks dnAttributes as ":dn:" does; the library compares the
+// three bytes literally and reads "DN" as a matching rule (go-ldap/3).
+func TestHegelDnattrsMarkerIsCaseInsensitive(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, dnattrsCases)
+		if compilesLike(c, ht, k.f, k.text(), known("go-ldap/3")) {
+			c.count("ok")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-ldap/4
+
+// valueSlots: the assertion values of an item, in order.
+func valueSlots(f *filt) []*string {
+	if f.op != ldap.FilterSubstrings {
+		return []*string{&f.value}
+	}
+	var slots []*string
+	if f.hasInitial {
+		slots = append(slots, &f.initial)
+	}
+	for i := range f.any {
+		slots = append(slots, &f.any[i])
+	}
+	if f.hasFinal {
+		slots = append(slots, &f.final)
+	}
+	return slots
+}
+
+// splice inserts piece into s at the at-th rune boundary (modulo their number).
+func splice(s string, at int, piece string) string {
+	starts := runeStarts(s)
+	i := starts[at%len(starts)]
+	return s[:i] + piece + s[i:]
+}
+
+// fffdCase: an item with an assertion value, the slot (modulo their number) and the rune
+// boundary at which a literal U+FFFD is spliced in, and the tape of the rendering (which
+// writes it raw, or under HEGEL_NO_KNOWN=1 escaped).
+type fffdCase struct {
+	f        *filt
+	slot, at int
+	tape     []int
+}
+
+// spliced is the tree with the U+FFFD in its value.
+func (c fffdCase) spliced() *filt {
+	f := *c.f
+	f.any = append([]string(nil), c.f.any...)
+	slots := valueSlots(&f)
+	p := slots[c.slot%len(slots)]
+	*p = splice(*p, c.at, "\ufffd")
+	return &f
+}
+
+func (c fffdCase) text() string { return renderFilt(c.spliced(), newTape(c.tape)) }
+
+func (c fffdCase) GoString() string { return fmt.Sprintf("filter %s\ntext %q", c.spliced(), c.text()) }
+
+var fffdCases = hegel.Composite(func(tc hegel.TestCase) fffdCase {
+	return fffdCase{
+		f:    hegel.Draw(tc, valuedLeaves),
+		slot: hegel.Draw(tc, positions),
+		at:   hegel.Draw(tc, positions),
+		tape: hegel.Draw(tc, tapes),
+	}
+})
+
+// TestHegelReplacementCharacterCompiles: U+FFFD is a character (UTFMB in RFC 4515's value
+// grammar), so a filter whose value holds it literally compiles to the structure the grammar
+// reads, as its escaped form does; the library takes the decoded rune for an encoding error
+// without looking at its width (go-ldap/4).
+func TestHegelReplacementCharacterCompiles(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, fffdCases)
+		if compilesLike(c, ht, k.spliced(), k.text(), known("go-ldap/4")) {
+			c.count("ok")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-ldap/5
+
+// badAttrs: texts in an attribute's place that are no attribute description (RFC 4512): empty,
+// with a space, an escape, a star, a digit first, a hyphen first, a parenthesis, a plus, a quote.
+var badAttrs = []string{"", "a b", `a\2ab`, "a*b", "1a", "-a", "a(b", `a\5c`, "a+b", `a"b`}
+
+// attrCase: an item that is not an extensible match with its attribute replaced by a bad one
+// (under HEGEL_NO_KNOWN=1 by one of the pool), and the tape of the rendering.
+type attrCase struct {
+	f    *filt
+	tape []int
+}
+
+func (c attrCase) text() string { return renderFilt(c.f, newTape(c.tape)) }
+
+func (c attrCase) GoString() string { return fmt.Sprintf("filter %s\ntext %q", c.f, c.text()) }
+
+var (
+	plainItems = weighted(
+		choice[*filt]{25, equalities},
+		choice[*filt]{10, presents},
+		choice[*filt]{15, orderings},
+		choice[*filt]{22, substrings},
+	)
+	attrTexts = shaped(hegel.SampledFrom(badAttrs), attrs)
+	attrCases = hegel.Composite(func(tc hegel.TestCase) attrCase {
+		f := hegel.Draw(tc, plainItems)
+		f.attr = hegel.Draw(tc, attrTexts)
+		return attrCase{f: f, tape: hegel.Draw(tc, tapes)}
+	})
+)
+
+// agreesWithGrammar checks a filter text the grammar rejects is rejected by CompileFilter, and
+// one it accepts compiles to its structure and round-trips; a failure names the shape.
+func agreesWithGrammar(c *collector, ht *hegel.T, s, shape string) {
+	m, merr := parseFilterStrict(s)
+	if merr != nil {
+		if p, err := ldap.CompileFilter(s); err == nil {
+			d, _ := ldap.DecompileFilter(p)
+			c.mismatch(ht, shape, "accepted", "CompileFilter(%q) compiled (decompiles as %q); the grammar rejects it: %v", s, d, merr)
+			return
+		}
+		c.count("rejected")
+		return
+	}
+	if compilesLike(c, ht, m, s, shape) {
+		c.count("ok")
+	}
+}
+
+// TestHegelFilterAttributesAreValidated: attr = attributedescription (RFC 4515, 4512), so an
+// item whose attribute text is none does not compile; the library takes every rune up to the
+// operator as the attribute, and DecompileFilter then escapes what CompileFilter took literally
+// (go-ldap/5).
+func TestHegelFilterAttributesAreValidated(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		agreesWithGrammar(c, ht, hegel.Draw(ht, attrCases).text(), known("go-ldap/5"))
+	})
+}
+
+// --------------------------------------------------------------------------- go-ldap/6
+
+// extNoneCase: an extensible match with neither attribute nor matching rule (under
+// HEGEL_NO_KNOWN=1 with one or both), and the tape of its value's rendering.
+type extNoneCase struct {
+	f    *filt
+	tape []int
+}
+
+func (c extNoneCase) text() string { return renderExtensible(c.f, ":dn", newTape(c.tape)) }
+
+func (c extNoneCase) GoString() string { return fmt.Sprintf("filter %s\ntext %q", c.f, c.text()) }
+
+var (
+	bareExtensibles = hegel.Map(extensibles, func(f *filt) *filt {
+		f.attr, f.rule = "", ""
+		return f
+	})
+	extNoneCases = hegel.Composite(func(tc hegel.TestCase) extNoneCase {
+		return extNoneCase{f: hegel.Draw(tc, shaped(bareExtensibles, extensibles)), tape: hegel.Draw(tc, tapes)}
+	})
+)
+
+// TestHegelExtensibleMatchNeedsAttributeOrRule: extensible = ( attr [dnattrs] [matchingrule]
+// COLON EQUALS assertionvalue ) / ( [dnattrs] matchingrule COLON EQUALS assertionvalue ), so
+// "(:=a)" and "(:dn:=a)" do not compile; the library's ":=" and ":dn:=" cases do not check that
+// anything precedes them (go-ldap/6).
+func TestHegelExtensibleMatchNeedsAttributeOrRule(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		agreesWithGrammar(c, ht, hegel.Draw(ht, extNoneCases).text(), known("go-ldap/6"))
+	})
+}
+
+// --------------------------------------------------------------------------- go-ldap/7
+
+// emptyTypeCase: a DN of one to four RDNs, rendered plainly, with an empty attribute type
+// (spaces 30% of the time, then '=') put before the at-th RDN (modulo their number); under
+// HEGEL_NO_KNOWN=1 a type of the pool and '=' instead, which makes that RDN's text the value.
+type emptyTypeCase struct {
+	d      dname
+	at     int
+	prefix string
+	tape   []int
+}
+
+func (c emptyTypeCase) text() string {
+	t := newTape(c.tape)
+	parts := make([]string, len(c.d))
+	for i, r := range c.d {
+		parts[i] = renderRDN(r, dstyle{}, t).text
+	}
+	k := c.at % len(parts)
+	parts[k] = c.prefix + parts[k]
+	return strings.Join(parts, ",")
+}
+
+func (c emptyTypeCase) GoString() string { return fmt.Sprintf("DN %v\ntext %q", c.d, c.text()) }
+
+var (
+	emptyTypes     = hegel.Map(maybe(30, hegel.SampledFrom([]string{" ", "  "})), func(sp string) string { return sp + "=" })
+	typePrefixes   = shaped(emptyTypes, hegel.Map(dtypes, func(typ string) string { return typ + "=" }))
+	emptyTypeCases = hegel.Composite(func(tc hegel.TestCase) emptyTypeCase {
+		return emptyTypeCase{
+			d:      hegel.Draw(tc, nonEmptyDNames),
+			at:     hegel.Draw(tc, positions),
+			prefix: hegel.Draw(tc, typePrefixes),
+			tape:   hegel.Draw(tc, tapes),
+		}
+	})
+)
+
+// TestHegelEmptyAttributeTypesAreRejected: every attributeTypeAndValue has a non-empty type
+// (RFC 4514: descr / numericoid), so a DN text whose grammar reading fails on an empty type is
+// rejected by ParseDN, and one the grammar reads parses to that structure; the library takes
+// the '=' after an empty type as the type separator again, so "=a=b" parses as a=b (go-ldap/7).
+func TestHegelEmptyAttributeTypesAreRejected(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, emptyTypeCases).text()
+		m, merr := parseDNStrict(s)
+		got, err := ldap.ParseDN(s)
+		if merr != nil {
+			if err == nil {
+				c.mismatch(ht, known("go-ldap/7"), "accepted", "ParseDN(%q) = %q; the grammar rejects it: %v", s, got.String(), merr)
+				return
+			}
+			c.count("rejected")
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "rejected", "ParseDN(%q) = %v; the grammar reads %v", s, err, m)
+			return
+		}
+		if g := dnameOf(got); !g.equalExact(m) {
+			c.failClass(ht, "structure", "ParseDN(%q) = %v; the grammar reads %v", s, g, m)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+// --------------------------------------------------------------------------- go-ldap/8
+
+// rawByteCase: a DN of one to four RDNs with a byte that is not UTF-8 spliced into the at-th
+// value (modulo their number) at a rune boundary, rendered with the byte raw (under
+// HEGEL_NO_KNOWN=1 hex-escaped, which the library keeps).
+type rawByteCase struct {
+	d       dname
+	at, pos int
+	b       string
+	tape    []int
+}
+
+// with is the DN with the byte in its value.
+func (c rawByteCase) with() dname {
+	d := dname{}
+	n := 0
+	for _, r := range c.d {
+		n += len(r)
+	}
+	k := c.at % n
+	i := 0
+	for _, r := range c.d {
+		x := append(rdn{}, r...)
+		for j := range x {
+			if i == k {
+				x[j].val = splice(x[j].val, c.pos, c.b)
+			}
+			i++
+		}
+		d = append(d, x)
+	}
+	return d
+}
+
+func (c rawByteCase) text() string {
+	return renderDN(c.with(), dstyle{rawInvalid: shaped(true, false)}, newTape(c.tape)).text
+}
+
+func (c rawByteCase) GoString() string { return fmt.Sprintf("DN %v\ntext %q", c.with(), c.text()) }
+
+var (
+	invalidBytes = hegel.SampledFrom([]string{"\xff", "\xc3", "\x80", "\xfe", "\xa9"})
+	rawByteCases = hegel.Composite(func(tc hegel.TestCase) rawByteCase {
+		return rawByteCase{
+			d:    hegel.Draw(tc, nonEmptyDNames),
+			at:   hegel.Draw(tc, positions),
+			pos:  hegel.Draw(tc, positions),
+			b:    hegel.Draw(tc, invalidBytes),
+			tape: hegel.Draw(tc, tapes),
+		}
+	})
+)
+
+// TestHegelDNRejectsOrKeepsBytesThatAreNotUTF8: a DN text holding a byte that is not UTF-8 is
+// either rejected (RFC 4514 requires UTF-8, and CompileFilter rejects the same bytes) or parsed
+// with the byte kept (as the escaped form is); the library turns each such byte into U+FFFD
+// (go-ldap/8).
+func TestHegelDNRejectsOrKeepsBytesThatAreNotUTF8(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, rawByteCases)
+		s := k.text()
+		got, err := ldap.ParseDN(s)
+		if err != nil {
+			c.count("rejected")
+			return
+		}
+		if g, want := dnameOf(got), k.with(); !g.equalExact(want) {
+			c.mismatch(ht, known("go-ldap/8"), "value", "ParseDN(%q) = %v; want %v or an error", s, g, want)
+			return
+		}
+		c.count("kept")
+	})
+}
+
+// --------------------------------------------------------------------------- go-ldap/9
+
+// hexSpaceCase: a DN of one to four RDNs whose at-th value (modulo their number) is written
+// as a hexstring (under HEGEL_NO_KNOWN=1 as a string) with one or two insignificant spaces
+// before it, after it, or both; the rest rendered plainly.
+type hexSpaceCase struct {
+	d             dname
+	at            int
+	before, after int
+	upper         bool
+	tape          []int
+}
+
+func (c hexSpaceCase) text() string {
+	t := newTape(c.tape)
+	n := 0
+	for _, r := range c.d {
+		n += len(r)
+	}
+	k := c.at % n
+	i := 0
+	var rdns []string
+	for _, r := range c.d {
+		var parts []string
+		for _, a := range r {
+			if i == k {
+				v := renderDString(a.val, false, t)
+				if !noKnown {
+					v = hexstring(a.val, c.upper)
+				}
+				parts = append(parts, a.typ+"="+strings.Repeat(" ", c.before)+v+strings.Repeat(" ", c.after))
+			} else {
+				parts = append(parts, renderATV(a, dstyle{}, t).text)
+			}
+			i++
+		}
+		rdns = append(rdns, strings.Join(parts, "+"))
+	}
+	return strings.Join(rdns, ",")
+}
+
+func (c hexSpaceCase) GoString() string { return fmt.Sprintf("DN %v\ntext %q", c.d, c.text()) }
+
+var (
+	// gaps: the spaces before and after the value, one or two on at least one side.
+	gaps = hegel.Composite(func(tc hegel.TestCase) [2]int {
+		g := [2]int{hegel.Draw(tc, hegel.Integers(0, 2)), hegel.Draw(tc, hegel.Integers(0, 2))}
+		if g[0]+g[1] == 0 {
+			g[1] = 1
+		}
+		return g
+	})
+	hexSpaceCases = hegel.Composite(func(tc hegel.TestCase) hexSpaceCase {
+		g := hegel.Draw(tc, gaps)
+		return hexSpaceCase{
+			d:      hegel.Draw(tc, nonEmptyDNames),
+			at:     hegel.Draw(tc, positions),
+			before: g[0],
+			after:  g[1],
+			upper:  hegel.Draw(tc, chance(50)),
+			tape:   hegel.Draw(tc, tapes),
+		}
+	})
+)
+
+// TestHegelHexstringValuesIgnoreInsignificantSpaces: ParseDN strips unescaped spaces around a
+// value "for compatibility" ("cn= Hi " is "Hi"), so around a hexstring value they are
+// insignificant too; the library decides on the hexstring form by the first raw byte, so a
+// leading space makes the value the literal text and a trailing one a hex decoding error
+// (go-ldap/9).
+func TestHegelHexstringValuesIgnoreInsignificantSpaces(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := hegel.Draw(ht, hexSpaceCases)
+		s := k.text()
+		got, err := ldap.ParseDN(s)
+		if err != nil {
+			c.mismatch(ht, known("go-ldap/9"), "rejected", "ParseDN(%q) = %v; want %v", s, err, k.d)
+			return
+		}
+		if g := dnameOf(got); !g.equalExact(k.d) {
+			c.mismatch(ht, known("go-ldap/9"), "structure", "ParseDN(%q) = %v; want %v", s, g, k.d)
+			return
+		}
+		c.count("ok")
+	})
+}
diff --git a/v3/hegel_test.go b/v3/hegel_test.go
new file mode 100644
index 0000000..478dd36
--- /dev/null
+++ b/v3/hegel_test.go
@@ -0,0 +1,478 @@
+package ldap_test
+
+// Hegel property tests for go-ldap/ldap (v3): DN parsing and normalization (RFC 4514) and
+// search filter compiling and decompiling (RFC 4515), written for the Hegel zoo. See
+// targets/go/go-ldap/README.md.
+//
+// Oracle: the two RFCs' grammars, restated as strict parsers in hegel_dn_test.go and
+// hegel_filter_test.go, plus the library's documented semantics (DN.String() normalization,
+// Equal/EqualFold/AncestorOf, DecompileFilter's canonical form). Every property draws one case
+// record: a DN or filter tree drawn from the binding's combinators, and a tape of small
+// integers that a pure renderer consumes for the grammatical choices its text leaves free
+// (escape spellings, hex case, hexstring values, the library's lenient spacing); an empty tape
+// is the plainest text, so that is what a case shrinks to. Mutations are drawn as a list of
+// edit records applied with positions taken modulo the live text.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn at their natural rate, so the
+// properties that meet them fail, naming the shape, and are the expected failures mapped to
+// the bugs (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over its shape
+// region alone, and hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 switches the
+// known shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing. No network: only the pure DN and filter functions are exercised.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape (collector.mismatch); under HEGEL_NO_KNOWN=1 the gates of Known are on, the shapes
+// are left out of the generators (shaped, the pools) and a mismatch that still has a known
+// shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the input shapes of the recorded bugs (bugs.toml); on means the shape is left
+// out of the generators, which is so only under HEGEL_NO_KNOWN=1. The pins assert the
+// documented behaviour and fail while a bug exists.
+var Known = struct {
+	// go-ldap/1: the byte closing an AND/OR/NOT list or a parenthesized filter is skipped
+	// without being checked: "(&(a=b)x", "(!(a=b)x", "((a=b)x" compile
+	closingParenUnchecked bool
+	// go-ldap/2: "(sn=**)" compiles to a Substrings filter with an empty SEQUENCE (RFC 4511
+	// wants at least one component) and decompiles as "(sn=)", an equality match
+	emptySubstringsAccepted bool
+	// go-ldap/3: ":dn:" is matched case-sensitively: "(o:DN:=x)" is read as the matching rule "DN"
+	dnattrsCaseSensitive bool
+	// go-ldap/4: a literal U+FFFD in a filter value is rejected as an encoding error
+	replacementCharRejected bool
+	// go-ldap/5: the attribute description of a filter item is not validated: "(=v)" and
+	// "(a\2ab=v)" compile, and DecompileFilter escapes what CompileFilter took literally
+	attrUnvalidated bool
+	// go-ldap/6: an extensible match with neither attribute nor matching rule compiles: "(:=a)", "(:dn:=a)"
+	extensibleWithoutAttrOrRule bool
+	// go-ldap/7: a DN with an empty attribute type is accepted, the "=" swallowed: "=a=b" parses as a=b
+	emptyTypeSwallowed bool
+	// go-ldap/8: bytes that are not UTF-8 in a DN string are accepted and become U+FFFD
+	// (EscapeDN walks its input rune by rune and writes U+FFFD for such a byte too)
+	dnInvalidUTF8Accepted bool
+	// go-ldap/9: spaces around a hex-encoded value are not insignificant as around a string
+	// value: "cn= #04024869" is the string "#04024869" while "cn=#04024869" is "Hi", and
+	// "cn=#04024869 " is an error
+	hexstringSpacesSignificant bool
+}{
+	closingParenUnchecked:       noKnown,
+	emptySubstringsAccepted:     noKnown,
+	dnattrsCaseSensitive:        noKnown,
+	replacementCharRejected:     noKnown,
+	attrUnvalidated:             noKnown,
+	extensibleWithoutAttrOrRule: noKnown,
+	emptyTypeSwallowed:          noKnown,
+	dnInvalidUTF8Accepted:       noKnown,
+	hexstringSpacesSignificant:  noKnown,
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) string {
+	if has {
+		return id
+	}
+	return ""
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) string { return shaped(id, "") }
+
+// shapes joins the shapes a case has (the empty ones dropped).
+func shapes(ids ...string) string {
+	var out []string
+	for _, id := range ids {
+		if id != "" {
+			out = append(out, id)
+		}
+	}
+	return strings.Join(out, ", ")
+}
+
+// --------------------------------------------------------------------------- collector
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is that of the
+// recorded bug shape names ("" for none): the failure names the shape, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out).
+func (c *collector) mismatch(ht *hegel.T, shape, class, format string, args ...any) {
+	if shape != "" {
+		c.count("shape " + shape) // counted before the skip, so ZOO_COLLECT=1 shows the skip rate too
+		format += " (the shape of " + shape + ")"
+	}
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// joined concatenates the strings of a list.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
+
+// deferred draws through a pointer to a generator, so that a recursive grammar can name a
+// generator before it is built (the forward declaration of hegel-go's
+// ExampleComposite_recursive).
+func deferred[T any](g *hegel.Generator[T]) hegel.Generator[T] {
+	return hegel.Composite(func(tc hegel.TestCase) T { return hegel.Draw(tc, *g) })
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// tape is a drawn list of small integers that a pure renderer consumes in order, recycled
+// modulo its length, for the choices a text leaves free (an escape's spelling, the hex case,
+// a hexstring value, lenient spaces). An empty tape answers 0 to every question, so the shrunk
+// form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+func newTape(vals []int) *tape { return &tape{vals: vals} }
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to a hundred values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 100)
+
+// --------------------------------------------------------------------------- mutations
+
+// mutation is one edit of a text, its positions taken modulo the live length when applied:
+// kind 0 deletes the byte at at, 1 inserts piece before it, 2 replaces it with piece, 3 swaps
+// it with the next byte, 4 duplicates the bytes from at up to to; on an empty text the piece
+// is the text.
+type mutation struct {
+	kind, at, to int
+	piece        string
+}
+
+// mutationsFrom draws mutations whose inserted pieces come from the pool.
+func mutationsFrom(pool []string) hegel.Generator[mutation] {
+	pieces := hegel.SampledFrom(pool)
+	return hegel.Composite(func(tc hegel.TestCase) mutation {
+		return mutation{
+			kind:  hegel.Draw(tc, hegel.Integers(0, 4)),
+			at:    hegel.Draw(tc, positions),
+			to:    hegel.Draw(tc, positions),
+			piece: hegel.Draw(tc, pieces),
+		}
+	})
+}
+
+// span is a half-open byte range of a text.
+type span struct{ start, end int }
+
+// guard is what the mutations of a text leave alone under HEGEL_NO_KNOWN=1: with runes the
+// text is edited rune by rune, so no byte that is not UTF-8 arises from a split rune (the
+// shape of go-ldap/8); the protected spans (attribute descriptions and matching rules: the
+// shapes of go-ldap/5 and go-ldap/6) keep their text and their neighbouring bytes. The zero
+// guard edits bytes anywhere.
+type guard struct {
+	runes     bool
+	protected []span
+}
+
+// segmentStarts: the byte offsets at which the segments of s start (each byte, or each rune
+// when runes), and len(s).
+func segmentStarts(s string, runes bool) []int {
+	if runes {
+		return runeStarts(s)
+	}
+	starts := make([]int, len(s)+1)
+	for i := range starts {
+		starts[i] = i
+	}
+	return starts
+}
+
+// runeStarts: the byte offsets at which a rune (or a byte that is not UTF-8) starts, and the
+// length.
+func runeStarts(s string) []int {
+	var starts []int
+	for i := 0; i < len(s); {
+		starts = append(starts, i)
+		_, w := utf8.DecodeRuneInString(s[i:])
+		i += w
+	}
+	return append(starts, len(s))
+}
+
+// protectedAt reports whether an edit of the kind at byte offset p touches a protected span:
+// a deletion, replacement or insertion (a duplication's insertion point too) inside it, or a
+// swap of a byte inside it or of the byte before it.
+func protectedAt(prot []span, p, kind int) bool {
+	for _, sp := range prot {
+		from := sp.start
+		if kind == 3 {
+			from--
+		}
+		if from <= p && p < sp.end {
+			return true
+		}
+	}
+	return false
+}
+
+// shifted moves the spans starting at or after pos by delta.
+func shifted(prot []span, pos, delta int) []span {
+	out := make([]span, len(prot))
+	for i, sp := range prot {
+		if sp.start >= pos {
+			sp.start += delta
+			sp.end += delta
+		}
+		out[i] = sp
+	}
+	return out
+}
+
+// apply edits s (in segments of bytes, or of runes) at a position the guard allows, taken
+// modulo the number of allowed positions, and returns the text with the protected spans
+// moved along; a kind with no allowed position is a no-op.
+func (m mutation) apply(s string, g guard, prot []span) (string, []span) {
+	if s == "" {
+		return m.piece, nil
+	}
+	starts := segmentStarts(s, g.runes)
+	n := len(starts) - 1
+	hi := n - 1 // a segment
+	if m.kind == 1 || m.kind == 4 {
+		hi = n // a boundary
+	}
+	var cands []int
+	for p := 0; p <= hi; p++ {
+		if !protectedAt(prot, starts[p], m.kind) {
+			cands = append(cands, p)
+		}
+	}
+	if len(cands) == 0 {
+		return s, prot
+	}
+	i := cands[m.at%len(cands)]
+	switch m.kind {
+	case 0: // delete the segment
+		bs, be := starts[i], starts[i+1]
+		return s[:bs] + s[be:], shifted(prot, be, bs-be)
+	case 1: // insert the piece before the segment
+		bs := starts[i]
+		return s[:bs] + m.piece + s[bs:], shifted(prot, bs, len(m.piece))
+	case 2: // replace the segment by the piece
+		bs, be := starts[i], starts[i+1]
+		return s[:bs] + m.piece + s[be:], shifted(prot, be, len(m.piece)-(be-bs))
+	case 3: // swap the segment with the next
+		if i+1 >= n {
+			return s, prot
+		}
+		a, b, c := starts[i], starts[i+1], starts[i+2]
+		return s[:a] + s[b:c] + s[a:b] + s[c:], prot
+	default: // duplicate the segments from i up to the boundary j, at j
+		var js []int
+		for _, p := range cands {
+			if p >= i {
+				js = append(js, p)
+			}
+		}
+		j := js[m.to%len(js)]
+		bs, bj := starts[i], starts[j]
+		return s[:bj] + s[bs:bj] + s[bj:], shifted(prot, bj, bj-bs)
+	}
+}
+
+// mutate applies the mutations in order under the guard.
+func mutate(s string, ms []mutation, g guard) string {
+	prot := g.protected
+	for _, m := range ms {
+		s, prot = m.apply(s, g, prot)
+	}
+	return s
+}
+
+// mutationPool: the pieces a mutation inserts: the meta-characters of both grammars, letters,
+// NUL, a space, the bytes of an "\u00e9" and a byte that is not UTF-8, a literal U+FFFD (the
+// shape of go-ldap/4, left out under HEGEL_NO_KNOWN=1), an escape, the extensible markers, "**".
+var mutationPool = shaped(
+	[]string{"(", ")", "*", "\\", "&", "|", "!", "=", "~", "<", ">", ":", "d", "n", " ", "\x00", "a", "Z", "0", ".", ";", "\xc3", "\xa9", "\xff", "\xef\xbf\xbd", "\\2a", ":dn:", ":=", "**"},
+	[]string{"(", ")", "*", "\\", "&", "|", "!", "=", "~", "<", ">", ":", "d", "n", " ", "\x00", "a", "Z", "0", ".", ";", "\xc3", "\xa9", "\xff", "\\2a", ":dn:", ":=", "**"},
+)
