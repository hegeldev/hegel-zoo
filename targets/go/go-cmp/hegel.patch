diff --git a/cmp/hegel_deepequal_test.go b/cmp/hegel_deepequal_test.go
new file mode 100644
index 0000000..ded8ddc
--- /dev/null
+++ b/cmp/hegel_deepequal_test.go
@@ -0,0 +1,303 @@
+package cmp_test
+
+import (
+	"math"
+	"reflect"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+// --------------------------------------------------------------------------- plain values
+
+// S is a struct with exported fields only, no Equal method: cmp.Equal on such values is
+// documented to behave "much like reflect.DeepEqual".
+type S struct {
+	A int
+	B string
+	P *S
+	L []any
+}
+
+// Code is an error with an exported field only, so cmp can compare it without options.
+type Code struct{ C int }
+
+func (c Code) Error() string { return "code" }
+
+var (
+	sharedChan = make(chan int)
+	otherChan  = make(chan int)
+	sharedFunc = func() {}
+)
+
+// genValue draws a value of a random shape; depth bounds the nesting.
+func genValue(tc hegel.TestCase, depth int) any {
+	shapes := []string{"nil", "bool", "int", "int64", "uint8", "float64", "complex", "string", "bytes", "ints", "array", "map", "struct", "ptr", "anys", "error", "chan", "func", "mapany"}
+	if depth <= 0 {
+		shapes = shapes[:9]
+	}
+	switch pick(tc, shapes) {
+	case "nil":
+		return nil
+	case "bool":
+		return chance(tc, 50)
+	case "int":
+		return n(tc, -3, 3)
+	case "int64":
+		return int64(n(tc, -3, 3))
+	case "uint8":
+		return uint8(n(tc, 0, 3))
+	case "float64":
+		return pick(tc, []float64{0, 1, -1, 0.5, math.Copysign(0, -1), math.NaN(), math.Inf(1)})
+	case "complex":
+		return complex(float64(n(tc, 0, 1)), float64(n(tc, 0, 1)))
+	case "string":
+		return pick(tc, []string{"", "a", "b", "ab"})
+	case "bytes":
+		switch n(tc, 0, 2) {
+		case 0:
+			return []byte(nil)
+		case 1:
+			return []byte{}
+		}
+		return []byte(pick(tc, []string{"a", "b"}))
+	case "ints":
+		switch n(tc, 0, 2) {
+		case 0:
+			return []int(nil)
+		case 1:
+			return []int{}
+		}
+		xs := make([]int, n(tc, 1, 3))
+		for i := range xs {
+			xs[i] = n(tc, 0, 2)
+		}
+		return xs
+	case "array":
+		return [2]int{n(tc, 0, 1), n(tc, 0, 1)}
+	case "map":
+		switch n(tc, 0, 2) {
+		case 0:
+			return map[string]int(nil)
+		case 1:
+			return map[string]int{}
+		}
+		m := map[string]int{}
+		for i := n(tc, 1, 2); i > 0; i-- {
+			m[pick(tc, []string{"a", "b", "c"})] = n(tc, 0, 1)
+		}
+		return m
+	case "struct":
+		return genS(tc, depth-1)
+	case "ptr":
+		if chance(tc, 25) {
+			return (*S)(nil)
+		}
+		s := genS(tc, depth-1)
+		return &s
+	case "anys":
+		xs := make([]any, n(tc, 0, 2))
+		for i := range xs {
+			xs[i] = genValue(tc, depth-1)
+		}
+		return xs
+	case "mapany":
+		m := map[int]any{}
+		for i := n(tc, 0, 2); i > 0; i-- {
+			m[n(tc, 0, 1)] = genValue(tc, depth-1)
+		}
+		return m
+	case "error":
+		if chance(tc, 30) {
+			return error(nil)
+		}
+		return error(Code{n(tc, 0, 1)})
+	case "chan":
+		if chance(tc, 50) {
+			return sharedChan
+		}
+		return otherChan
+	case "func":
+		if chance(tc, 50) {
+			return (func())(nil)
+		}
+		return sharedFunc
+	}
+	panic("unreachable")
+}
+
+func genS(tc hegel.TestCase, depth int) S {
+	s := S{A: n(tc, 0, 1), B: pick(tc, []string{"", "x"})}
+	if depth > 0 && chance(tc, 40) {
+		p := genS(tc, depth-1)
+		s.P = &p
+	}
+	if depth > 0 && chance(tc, 40) {
+		s.L = make([]any, n(tc, 0, 2))
+		for i := range s.L {
+			s.L[i] = genValue(tc, depth-1)
+		}
+	}
+	return s
+}
+
+// clone deep-copies the generated shapes (pointers to fresh copies, distinct slice and map
+// storage, channels and functions shared).
+func clone(v any) any {
+	switch x := v.(type) {
+	case []byte:
+		if x == nil {
+			return []byte(nil)
+		}
+		return append([]byte{}, x...)
+	case []int:
+		if x == nil {
+			return []int(nil)
+		}
+		return append([]int{}, x...)
+	case map[string]int:
+		if x == nil {
+			return map[string]int(nil)
+		}
+		m := map[string]int{}
+		for k, v := range x {
+			m[k] = v
+		}
+		return m
+	case map[int]any:
+		m := map[int]any{}
+		for k, v := range x {
+			m[k] = clone(v)
+		}
+		return m
+	case S:
+		return cloneS(x)
+	case *S:
+		if x == nil {
+			return (*S)(nil)
+		}
+		s := cloneS(*x)
+		return &s
+	case []any:
+		if x == nil {
+			return []any(nil)
+		}
+		ys := make([]any, len(x))
+		for i := range x {
+			ys[i] = clone(x[i])
+		}
+		return ys
+	}
+	return v
+}
+
+func cloneS(s S) S {
+	c := S{A: s.A, B: s.B}
+	if s.P != nil {
+		p := cloneS(*s.P)
+		c.P = &p
+	}
+	if s.L != nil {
+		c.L = clone(s.L).([]any)
+	}
+	return c
+}
+
+// selfUnequal reports whether v holds a NaN or a non-nil function, the two things cmp
+// documents as unequal to themselves (reflect.DeepEqual agrees, except that it takes identical
+// pointers, slices and maps as equal whatever they hold).
+func selfUnequal(v any) bool {
+	switch x := v.(type) {
+	case float64:
+		return math.IsNaN(x)
+	case func():
+		return x != nil
+	case []any:
+		for _, e := range x {
+			if selfUnequal(e) {
+				return true
+			}
+		}
+	case map[int]any:
+		for _, e := range x {
+			if selfUnequal(e) {
+				return true
+			}
+		}
+	case S:
+		return (x.P != nil && selfUnequal(*x.P)) || selfUnequal(x.L)
+	case *S:
+		return x != nil && selfUnequal(*x)
+	}
+	return false
+}
+
+// TestHegelEqualFollowsDeepEqual: on values with exported fields only, no Equal methods and no
+// cycles, cmp.Equal agrees with reflect.DeepEqual; Diff is empty exactly when Equal holds and
+// otherwise marks removed and added lines; Equal is symmetric.
+func TestHegelEqualFollowsDeepEqual(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		x := genValue(tc, 3)
+		var y any
+		same := false
+		switch pick(tc, []string{"same", "clone", "other", "other", "wrapped"}) {
+		case "same":
+			y, same = x, true
+			c.count("same")
+		case "clone":
+			y = clone(x)
+			c.count("clone")
+		case "wrapped":
+			// A different static shape around the same value.
+			y = []any{x}
+			x = []any{clone(x)}
+			c.count("wrapped")
+		default:
+			y = genValue(tc, 3)
+			c.count("other")
+		}
+		want := reflect.DeepEqual(x, y)
+		if same && selfUnequal(x) {
+			// reflect.DeepEqual takes identical pointers, slices and maps as equal whatever they
+			// hold; cmp compares the contents, where a NaN or a function is unequal to itself.
+			want = false
+		}
+		got := cmp.Equal(x, y)
+		if got != want {
+			c.fail(ht, "Equal(%#v, %#v) = %v, DeepEqual %v", x, y, got, want)
+			return
+		}
+		if back := cmp.Equal(y, x); back != got {
+			c.fail(ht, "Equal(%#v, %#v) = %v but Equal(y, x) = %v", x, y, got, back)
+		}
+		d := cmp.Diff(x, y)
+		if (d == "") != got {
+			c.fail(ht, "Diff(%#v, %#v) = %q while Equal = %v", x, y, d, got)
+			return
+		}
+		if got {
+			return
+		}
+		minus, plus := false, false
+		for _, line := range strings.Split(strings.TrimSuffix(d, "\n"), "\n") {
+			if len(line) < 2 || (line[0] != ' ' && line[0] != '-' && line[0] != '+') || line[1] != ' ' {
+				c.fail(ht, "Diff(%#v, %#v) has a line without a two-character prefix: %q\n%s", x, y, line, d)
+				return
+			}
+			minus = minus || line[0] == '-'
+			plus = plus || line[0] == '+'
+		}
+		if !minus && !plus {
+			c.fail(ht, "Diff(%#v, %#v) marks nothing removed or added:\n%s", x, y, d)
+		}
+		// Reflexivity: a value equals itself unless it holds a NaN or a function.
+		if self := cmp.Equal(x, x); self == selfUnequal(x) {
+			c.fail(ht, "Equal(x, x) = %v for %#v", self, x)
+		}
+	})
+}
diff --git a/cmp/hegel_diff_test.go b/cmp/hegel_diff_test.go
new file mode 100644
index 0000000..5b4433e
--- /dev/null
+++ b/cmp/hegel_diff_test.go
@@ -0,0 +1,100 @@
+package cmp_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+// --------------------------------------------------------------------------- diff text
+
+// genText draws a multi-line text (tabs, quotes, non-ASCII, a NUL, long lines, CRLF) for the
+// line-oriented part of the Diff reporter.
+func genText(tc hegel.TestCase) string {
+	lines := make([]string, n(tc, 0, 12))
+	for i := range lines {
+		lines[i] = pick(tc, []string{"", "a", "bb", "hello world", "x\ty", "tab\there", " lead", "trail ", "quote\"q", "unié", "\x00nul", "very long line that goes on and on and on for a while to exceed widths"})
+	}
+	s := strings.Join(lines, "\n")
+	if chance(tc, 30) {
+		s += "\n"
+	}
+	if chance(tc, 10) {
+		s = strings.ReplaceAll(s, "\n", "\r\n")
+	}
+	return s
+}
+
+func editText(tc hegel.TestCase, s string) string {
+	lines := strings.Split(s, "\n")
+	for k := n(tc, 1, 3); k > 0; k-- {
+		i := n(tc, 0, len(lines))
+		switch n(tc, 0, 2) {
+		case 0:
+			lines = append(lines[:i], append([]string{pick(tc, []string{"new", "", "zz"})}, lines[i:]...)...)
+		case 1:
+			if i < len(lines) {
+				lines = append(lines[:i], lines[i+1:]...)
+			}
+		default:
+			if i < len(lines) {
+				lines[i] += "!"
+			}
+		}
+	}
+	return strings.Join(lines, "\n")
+}
+
+func genBytes(tc hegel.TestCase) []byte {
+	b := make([]byte, n(tc, 0, 40))
+	for i := range b {
+		b[i] = byte(pick(tc, []int{0, 1, 10, 13, 32, 65, 97, 127, 128, 200, 255, 'a', 'b'}))
+	}
+	return b
+}
+
+// TestHegelDiffTextIsCoherent: on texts, byte slices, slices of lines and structs holding a
+// text against an edited copy, Diff is empty iff Equal and otherwise every line carries the
+// documented two-character prefix (the reporter's line and byte diffing).
+func TestHegelDiffTextIsCoherent(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		var x, y any
+		switch n(tc, 0, 4) {
+		case 0:
+			s := genText(tc)
+			x, y = s, editText(tc, s)
+		case 1:
+			s := genText(tc)
+			x, y = []byte(s), []byte(editText(tc, s))
+		case 2:
+			x, y = genBytes(tc), genBytes(tc)
+		case 3:
+			s := genText(tc)
+			x, y = strings.Split(s, "\n"), strings.Split(editText(tc, s), "\n")
+		default:
+			s := genText(tc)
+			x, y = struct{ A, B string }{s, "k"}, struct{ A, B string }{editText(tc, s), "k"}
+		}
+		eq := cmp.Equal(x, y)
+		d := cmp.Diff(x, y)
+		if (d == "") != eq {
+			c.fail(ht, "Diff/Equal disagree: %v %q", eq, d)
+			return
+		}
+		if eq {
+			return
+		}
+		for _, line := range strings.Split(strings.TrimSuffix(d, "\n"), "\n") {
+			if len(line) < 2 || (line[0] != ' ' && line[0] != '-' && line[0] != '+') || line[1] != ' ' {
+				c.fail(ht, "bad prefix %q in\n%s\nx=%q\ny=%q", line, d, fmt.Sprint(x), fmt.Sprint(y))
+				return
+			}
+		}
+	})
+}
diff --git a/cmp/hegel_misuse_test.go b/cmp/hegel_misuse_test.go
new file mode 100644
index 0000000..a8a99f5
--- /dev/null
+++ b/cmp/hegel_misuse_test.go
@@ -0,0 +1,220 @@
+package cmp_test
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+)
+
+// --------------------------------------------------------------------------- misuse
+
+// fieldsOf lists the field names of the struct types reachable from Doc by IgnoreFields
+// selectors, with the type each field leads to ("" for a leaf).
+var fieldsOf = map[string]map[string]string{
+	"Doc":  {"Base": "Base", "ID": "", "Name": "", "N": "", "F": "", "Tags": "", "Attrs": "", "Sub": "Sub", "When": "Time", "Err": "iface", "M": "Mod", "secret": ""},
+	"Base": {"ID": ""},
+	"Sub":  {"X": "", "Names": ""},
+	"Time": {"wall": "", "ext": "", "loc": "Location"},
+	"Mod":  {"V": ""},
+}
+
+// genSelector draws a dot-separated selector for IgnoreFields(Doc{}, sel): segments that name
+// fields of the struct reached so far, with mistakes mixed in (a missing name, an empty
+// segment, a name beyond a leaf or an interface, a trailing dot).
+func genSelector(tc hegel.TestCase) string {
+	var segs []string
+	typ := "Doc"
+	for i := n(tc, 1, 3); i > 0; i-- {
+		if typ == "" || typ == "iface" || typ == "Location" {
+			segs = append(segs, pick(tc, []string{"X", "V", "Nope", "ID"}))
+			continue
+		}
+		names := make([]string, 0, len(fieldsOf[typ]))
+		for k := range fieldsOf[typ] {
+			names = append(names, k)
+		}
+		sortStrings(names)
+		switch n(tc, 0, 9) {
+		case 0:
+			segs = append(segs, "Nope")
+			typ = ""
+		case 1:
+			segs = append(segs, "")
+			typ = ""
+		default:
+			name := pick(tc, names)
+			segs = append(segs, name)
+			typ = fieldsOf[typ][name]
+		}
+	}
+	sel := strings.Join(segs, ".")
+	if chance(tc, 15) {
+		sel = "." + sel
+	}
+	if chance(tc, 10) {
+		sel += "."
+	}
+	return sel
+}
+
+// selectorValid is the documented rule: one leading dot is harmless, every segment names a
+// field of the struct reached so far (exported fields of embedded structs are visible on the
+// parent) and a segment is followed by another only if it leads to a struct.
+func selectorValid(sel string) bool {
+	sel = strings.TrimPrefix(sel, ".")
+	if sel == "" {
+		return false
+	}
+	typ := "Doc"
+	for _, seg := range strings.Split(sel, ".") {
+		if typ == "" || typ == "iface" || typ == "Location" {
+			return false
+		}
+		next, ok := fieldsOf[typ][seg]
+		if !ok {
+			return false
+		}
+		typ = next
+	}
+	return true
+}
+
+func sortStrings(xs []string) {
+	for i := 1; i < len(xs); i++ {
+		for j := i; j > 0 && xs[j] < xs[j-1]; j-- {
+			xs[j], xs[j-1] = xs[j-1], xs[j]
+		}
+	}
+}
+
+type misuse struct {
+	name  string
+	build func()
+	panic bool   // whether the documentation says this panics
+	text  string // a fragment the panic message should carry, when documented
+}
+
+var misuses = []misuse{
+	{"Comparer ok", func() { cmp.Comparer(func(a, b int) bool { return a == b }) }, false, ""},
+	{"Comparer ok iface", func() { cmp.Comparer(func(a, b error) bool { return a == b }) }, false, ""},
+	{"Comparer two types", func() { cmp.Comparer(func(a int, b int64) bool { return true }) }, true, "invalid comparer function"},
+	{"Comparer one arg", func() { cmp.Comparer(func(a int) bool { return true }) }, true, "invalid comparer function"},
+	{"Comparer int result", func() { cmp.Comparer(func(a, b int) int { return 0 }) }, true, "invalid comparer function"},
+	{"Comparer variadic", func() { cmp.Comparer(func(a ...int) bool { return true }) }, true, "invalid comparer function"},
+	{"Comparer nil func", func() { cmp.Comparer((func(a, b int) bool)(nil)) }, true, "invalid comparer function"},
+	{"Comparer not a func", func() { cmp.Comparer(42) }, true, ""},
+	{"Comparer unfiltered any", func() { cmp.Equal(1, 1, cmp.Comparer(func(a, b any) bool { return true })) }, true, "cannot use an unfiltered option"},
+	{"Comparer ambiguous", func() {
+		cmp.Equal(1, 1, cmp.Comparer(func(a, b int) bool { return true }), cmp.Comparer(func(a, b int) bool { return false }))
+	}, true, "ambiguous set of applicable options"},
+	{"Comparer and Transformer ambiguous", func() {
+		cmp.Equal(1, 1, cmp.Comparer(func(a, b int) bool { return true }), cmp.Transformer("T", func(a int) int64 { return int64(a) }))
+	}, true, "ambiguous set of applicable options"},
+	{"Comparer nil not ambiguous", func() { cmp.Equal(1, 1, nil, cmp.Comparer(func(a, b int) bool { return true }), cmp.Options{nil}) }, false, ""},
+	{"Transformer ok", func() { cmp.Transformer("T", func(a int) int64 { return int64(a) }) }, false, ""},
+	{"Transformer dotted name", func() { cmp.Transformer("pkg.T", func(a int) int64 { return int64(a) }) }, false, ""},
+	{"Transformer empty name", func() { cmp.Transformer("", func(a int) int64 { return int64(a) }) }, false, ""},
+	{"Transformer digit name", func() { cmp.Transformer("1T", func(a int) int64 { return int64(a) }) }, true, "invalid name"},
+	{"Transformer dash name", func() { cmp.Transformer("a-b", func(a int) int64 { return int64(a) }) }, true, "invalid name"},
+	{"Transformer two args", func() { cmp.Transformer("T", func(a, b int) int64 { return 0 }) }, true, "invalid transformer function"},
+	{"Transformer two results", func() { cmp.Transformer("T", func(a int) (int, error) { return 0, nil }) }, true, "invalid transformer function"},
+	{"Transformer nil", func() { cmp.Transformer("T", (func(int) int)(nil)) }, true, "invalid transformer function"},
+	{"Transformer unfiltered any", func() { cmp.Equal(1, 1, cmp.Transformer("T", func(a any) any { return a })) }, true, "cannot use an unfiltered option"},
+	{"FilterValues ok", func() { cmp.FilterValues(func(a, b int) bool { return true }, cmp.Ignore()) }, false, ""},
+	{"FilterValues bad func", func() { cmp.FilterValues(func(a int) bool { return true }, cmp.Ignore()) }, true, "invalid values filter function"},
+	{"FilterPath nil", func() { cmp.FilterPath(nil, cmp.Ignore()) }, true, "invalid path filter function"},
+	{"Ignore unfiltered", func() { cmp.Equal(1, 1, cmp.Ignore()) }, true, "cannot use an unfiltered option"},
+	{"unexported field", func() { cmp.Equal(Doc{}, Doc{}) }, true, "cannot handle unexported field"},
+	{"unexported field pointer", func() { cmp.Equal(&Doc{}, &Doc{}) }, true, "cannot handle unexported field"},
+	{"unexported in slice", func() { cmp.Equal([]Doc{{}}, []Doc{{}}) }, true, "cannot handle unexported field"},
+	{"unexported ignored", func() { cmp.Equal(Doc{}, Doc{}, cmpopts.IgnoreUnexported(Doc{})) }, false, ""},
+	{"unexported allowed", func() { cmp.Equal(Doc{}, Doc{}, cmp.AllowUnexported(Doc{})) }, false, ""},
+	{"AllowUnexported pointer", func() { cmp.AllowUnexported(&Doc{}) }, true, "invalid struct type"},
+	{"AllowUnexported int", func() { cmp.AllowUnexported(0) }, true, "invalid struct type"},
+	{"IgnoreUnexported pointer", func() { cmpopts.IgnoreUnexported(&Doc{}) }, true, "must be a non-pointer struct"},
+	{"IgnoreUnexported nil", func() { cmpopts.IgnoreUnexported(nil) }, true, "must be a non-pointer struct"},
+	{"IgnoreFields pointer", func() { cmpopts.IgnoreFields(&Doc{}, "Name") }, true, "must be a non-pointer struct"},
+	{"IgnoreFields int", func() { cmpopts.IgnoreFields(0, "Name") }, true, "must be a non-pointer struct"},
+	{"IgnoreFields none", func() { cmpopts.IgnoreFields(Doc{}) }, false, ""},
+	{"IgnoreTypes ok", func() { cmpopts.IgnoreTypes(0, "", time.Time{}) }, false, ""},
+	{"IgnoreTypes nil", func() { cmpopts.IgnoreTypes(nil) }, true, "cannot determine type"},
+	{"IgnoreInterfaces ok", func() { cmpopts.IgnoreInterfaces(struct{ error }{}) }, false, ""},
+	{"IgnoreInterfaces two", func() {
+		cmpopts.IgnoreInterfaces(struct {
+			error
+			fmt.Stringer
+		}{})
+	}, false, ""},
+	{"IgnoreInterfaces named", func() { cmpopts.IgnoreInterfaces(Base{}) }, true, "input must be an anonymous struct"},
+	{"IgnoreInterfaces nil", func() { cmpopts.IgnoreInterfaces(nil) }, true, "input must be an anonymous struct"},
+	{"IgnoreInterfaces named field", func() { cmpopts.IgnoreInterfaces(struct{ E error }{}) }, true, "struct cannot have named fields"},
+	{"IgnoreInterfaces non-interface", func() { cmpopts.IgnoreInterfaces(struct{ Base }{}) }, true, "embedded field must be an interface type"},
+	{"IgnoreInterfaces empty interface", func() { cmpopts.IgnoreInterfaces(struct{ any }{}) }, true, "cannot ignore empty interface"},
+	{"IgnoreSliceElements ok", func() { cmpopts.IgnoreSliceElements(func(s string) bool { return s == "" }) }, false, ""},
+	{"IgnoreSliceElements two args", func() { cmpopts.IgnoreSliceElements(func(s, t string) bool { return true }) }, true, "invalid discard function"},
+	{"IgnoreSliceElements nil", func() { cmpopts.IgnoreSliceElements((func(string) bool)(nil)) }, true, "invalid discard function"},
+	{"IgnoreMapEntries ok", func() { cmpopts.IgnoreMapEntries(func(k string, v int) bool { return v < 0 }) }, false, ""},
+	{"IgnoreMapEntries one arg", func() { cmpopts.IgnoreMapEntries(func(k string) bool { return true }) }, true, "invalid discard function"},
+	{"SortSlices less", func() { cmpopts.SortSlices(func(a, b int) bool { return a < b }) }, false, ""},
+	{"SortSlices compare", func() { cmpopts.SortSlices(func(a, b int) int { return a - b }) }, false, ""},
+	{"SortSlices string result", func() { cmpopts.SortSlices(func(a, b int) string { return "" }) }, true, "invalid less or compare function"},
+	{"SortSlices one arg", func() { cmpopts.SortSlices(func(a int) bool { return true }) }, true, "invalid less or compare function"},
+	{"SortSlices nil", func() { cmpopts.SortSlices((func(a, b int) bool)(nil)) }, true, "invalid less or compare function"},
+	{"SortMaps less", func() { cmpopts.SortMaps(func(a, b string) bool { return a < b }) }, false, ""},
+	{"SortMaps bad", func() { cmpopts.SortMaps(func(a, b string) (bool, bool) { return true, true }) }, true, "invalid less or compare function"},
+	{"SortMaps partial order", func() {
+		cmp.Equal(map[int]int{1: 1, 2: 2}, map[int]int{1: 1, 2: 2}, cmpopts.SortMaps(func(a, b int) bool { return false }))
+	}, true, "partial order detected"},
+	{"EquateApprox ok", func() { cmpopts.EquateApprox(0.1, 0.5) }, false, ""},
+	{"EquateApprox zero", func() { cmpopts.EquateApprox(0, 0) }, false, ""},
+	{"EquateApprox negative fraction", func() { cmpopts.EquateApprox(-0.1, 0) }, true, "non-negative"},
+	{"EquateApprox negative margin", func() { cmpopts.EquateApprox(0, -1) }, true, "non-negative"},
+	{"EquateApprox NaN", func() { cmpopts.EquateApprox(math.NaN(), 0) }, true, "non-negative"},
+	{"EquateApproxTime ok", func() { cmpopts.EquateApproxTime(time.Second) }, false, ""},
+	{"EquateApproxTime negative", func() { cmpopts.EquateApproxTime(-time.Second) }, true, "non-negative"},
+	{"EquateComparable ok", func() { cmpopts.EquateComparable(time.Time{}, Base{}) }, false, ""},
+	{"EquateComparable slice", func() { cmpopts.EquateComparable([]int{}) }, true, "not a comparable Go type"},
+	{"EquateComparable twice", func() { cmpopts.EquateComparable(Base{}, Base{}) }, true, "already specified"},
+	{"NaN map key", func() { cmp.Equal(map[float64]int{math.NaN(): 1}, map[float64]int{math.NaN(): 1}) }, true, "map key with NaNs"},
+	{"Reporter and Exporter ok", func() {
+		cmp.Equal(Doc{}, Doc{}, cmp.Reporter(&recorder{}), cmp.Exporter(func(reflect.Type) bool { return true }))
+	}, false, ""},
+}
+
+// TestHegelMisusePanicsAsDocumented: the constructions the documentation calls invalid panic
+// with the documented message, the valid ones do not; an IgnoreFields selector is accepted
+// exactly when every segment names a field of the struct reached.
+func TestHegelMisusePanicsAsDocumented(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		if chance(tc, 50) {
+			m := pick(tc, misuses)
+			c.count("table")
+			r := catch(m.build)
+			if (r != nil) != m.panic {
+				c.fail(ht, "%s: panic %v, want panic %v", m.name, r, m.panic)
+				return
+			}
+			if r != nil && m.text != "" && !strings.Contains(fmt.Sprint(r), m.text) {
+				c.fail(ht, "%s: panic %q does not mention %q", m.name, fmt.Sprint(r), m.text)
+			}
+			return
+		}
+		sel := genSelector(tc)
+		valid := selectorValid(sel)
+		c.count("selector")
+		r := catch(func() { cmpopts.IgnoreFields(Doc{}, sel) })
+		if (r == nil) != valid {
+			c.fail(ht, "IgnoreFields(Doc{}, %q): panic %v, want valid %v", sel, r, valid)
+		}
+	})
+}
diff --git a/cmp/hegel_options_test.go b/cmp/hegel_options_test.go
new file mode 100644
index 0000000..509452b
--- /dev/null
+++ b/cmp/hegel_options_test.go
@@ -0,0 +1,565 @@
+package cmp_test
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+)
+
+// --------------------------------------------------------------------------- the document
+
+type Base struct{ ID int }
+
+// Mod has an Equal method of the documented form "(T) Equal(T) bool".
+type Mod struct{ V int }
+
+func (m Mod) Equal(o Mod) bool { return m.V%5 == o.V%5 }
+
+type Sub struct {
+	X     int
+	Names []string
+}
+
+type Doc struct {
+	Base
+	Name   string
+	N      int
+	F      float64
+	Tags   []string
+	Attrs  map[string]int
+	Sub    *Sub
+	When   time.Time
+	Err    error
+	M      Mod
+	secret int
+}
+
+var (
+	baseTime = time.Date(2026, 9, 21, 12, 0, 0, 0, time.UTC)
+	times    = []time.Time{{}, baseTime, baseTime.Add(time.Second), baseTime.Add(2 * time.Second), baseTime.Add(time.Hour)}
+	floats   = []float64{0, 0.5, 1, 1.05, 1.1, 2, math.NaN()}
+	words    = []string{"a", "A", "b", "B", "x1", "x2", ""}
+	keys     = []string{"a", "A", "b", "c"}
+	codeOne  = Code{1}
+	wrapped  = fmt.Errorf("wrapped: %w", codeOne)
+)
+
+// opts is a random selection of options, with the parameters the model needs.
+type opts struct {
+	unexported    string // "ignore", "allow" or "exporter"
+	equateEmpty   bool
+	equateNaNs    bool
+	approx        bool
+	frac, margin  float64
+	ignoreFields  []string
+	ignoreTypes   []string // "time", "mod", "subptr", "strings", "int", "string"
+	sortSlices    bool
+	sortMaps      bool
+	ignoreSliceEl bool // elements with prefix "x"
+	ignoreMapEnt  bool // entries with a negative value
+	lower         bool // Transformer strings.ToLower
+	compareMod3   bool // Comparer on ints
+	equateErrors  bool
+	ignoreIface   bool // IgnoreInterfaces(struct{ error }{})
+	approxTime    bool
+	timeMargin    time.Duration
+}
+
+var fieldNames = []string{"Name", "N", "F", "Tags", "Attrs", "Sub", "Sub.X", "Sub.Names", "When", "Err", "M", "ID", "Base.ID", "Base", "secret"}
+
+func genOpts(tc hegel.TestCase) opts {
+	o := opts{unexported: pick(tc, []string{"ignore", "allow", "exporter"})}
+	o.equateEmpty = chance(tc, 35)
+	o.equateNaNs = chance(tc, 35)
+	if o.approx = chance(tc, 35); o.approx {
+		o.frac = pick(tc, []float64{0, 0.1, 0.5})
+		o.margin = pick(tc, []float64{0, 0.06, 0.5})
+	}
+	if chance(tc, 40) {
+		for i := n(tc, 1, 3); i > 0; i-- {
+			o.ignoreFields = append(o.ignoreFields, pick(tc, fieldNames))
+		}
+	}
+	if chance(tc, 30) {
+		for i := n(tc, 1, 2); i > 0; i-- {
+			o.ignoreTypes = append(o.ignoreTypes, pick(tc, []string{"time", "mod", "subptr", "strings", "int", "string"}))
+		}
+	}
+	o.sortSlices = chance(tc, 35)
+	o.sortMaps = chance(tc, 35)
+	o.ignoreSliceEl = chance(tc, 30)
+	o.ignoreMapEnt = chance(tc, 30)
+	if Known.sortMapsIgnoreEntries && o.sortMaps {
+		o.ignoreMapEnt = false
+	}
+	o.lower = chance(tc, 30)
+	o.compareMod3 = chance(tc, 30)
+	o.equateErrors = chance(tc, 35)
+	o.ignoreIface = chance(tc, 15)
+	if o.approxTime = chance(tc, 35); o.approxTime {
+		o.timeMargin = pick(tc, []time.Duration{0, time.Second, time.Hour})
+	}
+	return o
+}
+
+func (o opts) ignores(field string) bool {
+	for _, f := range o.ignoreFields {
+		if f == field {
+			return true
+		}
+	}
+	return false
+}
+
+func (o opts) ignoresType(kind string) bool {
+	for _, k := range o.ignoreTypes {
+		if k == kind {
+			return true
+		}
+	}
+	return false
+}
+
+func (o opts) build() []cmp.Option {
+	var out []cmp.Option
+	switch o.unexported {
+	case "ignore":
+		out = append(out, cmpopts.IgnoreUnexported(Doc{}))
+	case "allow":
+		out = append(out, cmp.AllowUnexported(Doc{}))
+	default:
+		docType := reflect.TypeOf(Doc{})
+		out = append(out, cmp.Exporter(func(t reflect.Type) bool { return t == docType }))
+	}
+	if o.equateEmpty {
+		out = append(out, cmpopts.EquateEmpty())
+	}
+	if o.equateNaNs {
+		out = append(out, cmpopts.EquateNaNs())
+	}
+	if o.approx {
+		out = append(out, cmpopts.EquateApprox(o.frac, o.margin))
+	}
+	if len(o.ignoreFields) > 0 {
+		out = append(out, cmpopts.IgnoreFields(Doc{}, o.ignoreFields...))
+	}
+	for _, k := range o.ignoreTypes {
+		var v any
+		switch k {
+		case "time":
+			v = time.Time{}
+		case "mod":
+			v = Mod{}
+		case "subptr":
+			v = (*Sub)(nil)
+		case "strings":
+			v = []string(nil)
+		case "int":
+			v = 0
+		case "string":
+			v = ""
+		}
+		out = append(out, cmpopts.IgnoreTypes(v))
+	}
+	if o.sortSlices {
+		if chanceStatic(o) {
+			out = append(out, cmpopts.SortSlices(func(a, b string) bool { return a < b }))
+		} else {
+			out = append(out, cmpopts.SortSlices(strings.Compare))
+		}
+	}
+	if o.sortMaps {
+		if chanceStatic(o) {
+			out = append(out, cmpopts.SortMaps(func(a, b string) bool { return a < b }))
+		} else {
+			out = append(out, cmpopts.SortMaps(strings.Compare))
+		}
+	}
+	if o.ignoreSliceEl {
+		out = append(out, cmpopts.IgnoreSliceElements(func(s string) bool { return strings.HasPrefix(s, "x") }))
+	}
+	if o.ignoreMapEnt {
+		out = append(out, cmpopts.IgnoreMapEntries(func(k string, v int) bool { return v < 0 }))
+	}
+	if o.lower {
+		out = append(out, cmp.Transformer("Lower", strings.ToLower))
+	}
+	if o.compareMod3 {
+		out = append(out, cmp.Comparer(func(a, b int) bool { return a%3 == b%3 }))
+	}
+	if o.equateErrors {
+		out = append(out, cmpopts.EquateErrors())
+	}
+	if o.ignoreIface {
+		out = append(out, cmpopts.IgnoreInterfaces(struct{ error }{}))
+	}
+	if o.approxTime {
+		out = append(out, cmpopts.EquateApproxTime(o.timeMargin))
+	}
+	// Nest some of the options in cmp.Options to exercise flattening.
+	if len(out) > 2 && o.compareMod3 {
+		out = []cmp.Option{cmp.Options(out[:2]), cmp.Options(out[2:])}
+	}
+	return out
+}
+
+// chanceStatic picks the less-function or compare-function form of the sort options from the
+// option bits, so a build is deterministic for a given opts value.
+func chanceStatic(o opts) bool { return o.equateEmpty != o.equateNaNs }
+
+// genDoc draws a document from small pools so that near-equal pairs are common.
+func genDoc(tc hegel.TestCase, o opts) Doc {
+	d := Doc{Base: Base{ID: n(tc, 0, 2)}, Name: pick(tc, words), N: n(tc, 0, 9), F: pick(tc, floats), secret: n(tc, 0, 1)}
+	d.Tags = genWords(tc)
+	switch n(tc, 0, 3) {
+	case 0:
+	case 1:
+		d.Attrs = map[string]int{}
+	default:
+		d.Attrs = map[string]int{}
+		for i := n(tc, 1, 3); i > 0; i-- {
+			d.Attrs[pick(tc, keys)] = n(tc, -2, 3)
+		}
+	}
+	if chance(tc, 70) {
+		d.Sub = &Sub{X: n(tc, 0, 3), Names: genWords(tc)}
+	}
+	d.When = pick(tc, times)
+	errs := []error{nil, codeOne, Code{2}, cmpopts.AnyError}
+	if o.equateErrors || o.ignoreIface || o.ignores("Err") {
+		errs = append(errs, wrapped, errors.New("plain"))
+	}
+	d.Err = pick(tc, errs)
+	d.M = Mod{V: n(tc, 0, 9)}
+	return d
+}
+
+func genWords(tc hegel.TestCase) []string {
+	switch n(tc, 0, 3) {
+	case 0:
+		return nil
+	case 1:
+		return []string{}
+	}
+	xs := make([]string, n(tc, 1, 4))
+	for i := range xs {
+		xs[i] = pick(tc, words)
+	}
+	return xs
+}
+
+// mutate returns a copy of d with one field redrawn.
+func mutate(tc hegel.TestCase, d Doc, o opts) Doc {
+	fresh := genDoc(tc, o)
+	switch n(tc, 0, 10) {
+	case 0:
+		d.ID = fresh.ID
+	case 1:
+		d.Name = fresh.Name
+	case 2:
+		d.N = fresh.N
+	case 3:
+		d.F = fresh.F
+	case 4:
+		d.Tags = fresh.Tags
+	case 5:
+		d.Attrs = fresh.Attrs
+	case 6:
+		d.Sub = fresh.Sub
+	case 7:
+		d.When = fresh.When
+	case 8:
+		d.Err = fresh.Err
+	case 9:
+		d.M = fresh.M
+	default:
+		d.secret = fresh.secret
+	}
+	return d
+}
+
+// --------------------------------------------------------------------------- the model
+
+type model struct{ o opts }
+
+func (m model) str(a, b string) bool {
+	if m.o.lower {
+		return strings.ToLower(a) == strings.ToLower(b)
+	}
+	return a == b
+}
+
+func (m model) int(a, b int) bool {
+	if m.o.compareMod3 {
+		return a%3 == b%3
+	}
+	return a == b
+}
+
+func (m model) float(a, b float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return m.o.equateNaNs && math.IsNaN(a) && math.IsNaN(b)
+	}
+	if m.o.approx {
+		return math.Abs(a-b) <= math.Max(m.o.margin, m.o.frac*math.Min(math.Abs(a), math.Abs(b)))
+	}
+	return a == b
+}
+
+func (m model) time(a, b time.Time) bool {
+	if m.o.approxTime && !a.IsZero() && !b.IsZero() {
+		d := a.Sub(b)
+		if d < 0 {
+			d = -d
+		}
+		return d <= m.o.timeMargin
+	}
+	return a.Equal(b)
+}
+
+// strList: the documented slice rule (both nil or both non-nil), EquateEmpty, ignored
+// elements dropped on each side, SortSlices, then the remaining elements pairwise.
+func (m model) strList(a, b []string) bool {
+	if a == nil || b == nil {
+		return (a == nil && b == nil) || (m.o.equateEmpty && len(a) == 0 && len(b) == 0)
+	}
+	if m.o.equateEmpty && len(a) == 0 && len(b) == 0 {
+		return true
+	}
+	a, b = m.keep(a), m.keep(b)
+	if m.o.sortSlices {
+		a, b = sortedStrings(a), sortedStrings(b)
+	}
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !m.str(a[i], b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m model) keep(xs []string) []string {
+	var out []string
+	for _, x := range xs {
+		if m.o.ignoresType("string") || (m.o.ignoreSliceEl && strings.HasPrefix(x, "x")) {
+			continue
+		}
+		out = append(out, x)
+	}
+	return out
+}
+
+func sortedStrings(xs []string) []string {
+	ys := append([]string{}, xs...)
+	sort.Strings(ys)
+	return ys
+}
+
+type entry struct {
+	k string
+	v int
+}
+
+func (m model) intMap(a, b map[string]int) bool {
+	if a == nil || b == nil {
+		return (a == nil && b == nil) || (m.o.equateEmpty && len(a) == 0 && len(b) == 0)
+	}
+	if m.o.equateEmpty && len(a) == 0 && len(b) == 0 {
+		return true
+	}
+	if m.o.sortMaps {
+		// The map is flattened to a slice of {K, V} sorted by K; the pairs are then compared
+		// as struct fields, so the string and int rules apply to keys and values.
+		ea, eb := m.entries(a), m.entries(b)
+		if len(ea) != len(eb) {
+			return false
+		}
+		for i := range ea {
+			if !(m.o.ignoresType("string") || m.str(ea[i].k, eb[i].k)) {
+				return false
+			}
+			if !(m.o.ignoresType("int") || m.int(ea[i].v, eb[i].v)) {
+				return false
+			}
+		}
+		return true
+	}
+	union := map[string]bool{}
+	for k := range a {
+		union[k] = true
+	}
+	for k := range b {
+		union[k] = true
+	}
+	for k := range union {
+		if m.o.ignoresType("int") {
+			continue
+		}
+		va, oka := a[k]
+		vb, okb := b[k]
+		if m.o.ignoreMapEnt && ((oka && va < 0) || (okb && vb < 0)) {
+			continue
+		}
+		if !oka || !okb || !m.int(va, vb) {
+			return false
+		}
+	}
+	return true
+}
+
+// entries flattens a map the way SortMaps does, dropping the entries IgnoreMapEntries drops.
+func (m model) entries(a map[string]int) []entry {
+	var es []entry
+	for k, v := range a {
+		if m.o.ignoreMapEnt && v < 0 {
+			continue
+		}
+		es = append(es, entry{k, v})
+	}
+	sort.Slice(es, func(i, j int) bool { return es[i].k < es[j].k })
+	return es
+}
+
+func (m model) err(a, b error) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	if m.o.equateErrors {
+		return errors.Is(a, b) || errors.Is(b, a)
+	}
+	if reflect.TypeOf(a) != reflect.TypeOf(b) {
+		return false
+	}
+	ca, oka := a.(Code)
+	cb, okb := b.(Code)
+	if oka && okb {
+		return m.o.ignoresType("int") || m.int(ca.C, cb.C)
+	}
+	return reflect.DeepEqual(a, b) // AnyError against AnyError
+}
+
+func (m model) sub(a, b *Sub) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	if !(m.o.ignores("Sub.X") || m.o.ignoresType("int") || m.int(a.X, b.X)) {
+		return false
+	}
+	return m.o.ignores("Sub.Names") || m.o.ignoresType("strings") || m.strList(a.Names, b.Names)
+}
+
+func (m model) equal(x, y Doc) bool {
+	o := m.o
+	if !(o.ignores("ID") || o.ignores("Base.ID") || o.ignores("Base") || o.ignoresType("int") || m.int(x.ID, y.ID)) {
+		return false
+	}
+	if !(o.ignores("Name") || o.ignoresType("string") || m.str(x.Name, y.Name)) {
+		return false
+	}
+	if !(o.ignores("N") || o.ignoresType("int") || m.int(x.N, y.N)) {
+		return false
+	}
+	if !(o.ignores("F") || m.float(x.F, y.F)) {
+		return false
+	}
+	if !(o.ignores("Tags") || o.ignoresType("strings") || m.strList(x.Tags, y.Tags)) {
+		return false
+	}
+	if !(o.ignores("Attrs") || m.intMap(x.Attrs, y.Attrs)) {
+		return false
+	}
+	if !(o.ignores("Sub") || o.ignoresType("subptr") || m.sub(x.Sub, y.Sub)) {
+		return false
+	}
+	if !(o.ignores("When") || o.ignoresType("time") || m.time(x.When, y.When)) {
+		return false
+	}
+	if !(o.ignores("Err") || o.ignoreIface || m.err(x.Err, y.Err)) {
+		return false
+	}
+	if !(o.ignores("M") || o.ignoresType("mod") || x.M.V%5 == y.M.V%5) {
+		return false
+	}
+	if o.unexported != "ignore" && !(o.ignores("secret") || o.ignoresType("int") || m.int(x.secret, y.secret)) {
+		return false
+	}
+	return true
+}
+
+// TestHegelOptionsFollowTheModel: cmp.Equal with a random combination of options agrees with
+// the documented meaning of each option on a document type; Diff is empty iff Equal; Equal is
+// symmetric.
+func TestHegelOptionsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		o := genOpts(tc)
+		x := genDoc(tc, o)
+		var y Doc
+		switch pick(tc, []string{"same", "mutated", "mutated", "other"}) {
+		case "same":
+			y = x
+			c.count("same")
+		case "mutated":
+			y = x
+			for i := n(tc, 1, 2); i > 0; i-- {
+				y = mutate(tc, y, o)
+			}
+			c.count("mutated")
+		default:
+			y = genDoc(tc, o)
+			c.count("other")
+		}
+		if Known.sortSlicesNil && o.sortSlices && (o.ignoreSliceEl || o.ignoresType("string")) {
+			if nilAgainstLonger(x.Tags, y.Tags) || (x.Sub != nil && y.Sub != nil && nilAgainstLonger(x.Sub.Names, y.Sub.Names)) {
+				c.count("skipped nil slice")
+				return
+			}
+		}
+		m := model{o}
+		want := m.equal(x, y)
+		options := o.build()
+		got := cmp.Equal(x, y, options...)
+		if got != want {
+			c.fail(ht, "Equal = %v, model %v\nopts %+v\nx %s\ny %s", got, want, o, show(x), show(y))
+			return
+		}
+		if back := cmp.Equal(y, x, options...); back != got {
+			c.fail(ht, "Equal(x, y) = %v but Equal(y, x) = %v\nopts %+v\nx %s\ny %s", got, back, o, show(x), show(y))
+		}
+		d := cmp.Diff(x, y, options...)
+		if (d == "") != got {
+			c.fail(ht, "Diff = %q while Equal = %v\nopts %+v\nx %s\ny %s", d, got, o, show(x), show(y))
+		}
+		if self := cmp.Equal(x, x, options...); self != m.equal(x, x) {
+			c.fail(ht, "Equal(x, x) = %v, model %v\nopts %+v\nx %s", self, m.equal(x, x), o, show(x))
+		}
+	})
+}
+
+// nilAgainstLonger: exactly one side nil and the other with at least two elements (the shape
+// where the SortSlices transform would replace the nil slice).
+func nilAgainstLonger(a, b []string) bool {
+	return (a == nil && len(b) >= 2) || (b == nil && len(a) >= 2)
+}
+
+func show(d Doc) string {
+	sub := "nil"
+	if d.Sub != nil {
+		sub = fmt.Sprintf("&{X:%d Names:%#v}", d.Sub.X, d.Sub.Names)
+	}
+	return fmt.Sprintf("{ID:%d Name:%q N:%d F:%v Tags:%#v Attrs:%v Sub:%s When:%v Err:%v M:%d secret:%d}", d.ID, d.Name, d.N, d.F, d.Tags, d.Attrs, sub, d.When.Format("15:04:05"), d.Err, d.M.V, d.secret)
+}
diff --git a/cmp/hegel_pins_test.go b/cmp/hegel_pins_test.go
