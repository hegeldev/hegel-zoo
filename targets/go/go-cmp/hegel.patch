diff --git a/cmp/hegel_deepequal_test.go b/cmp/hegel_deepequal_test.go
new file mode 100644
index 0000000..b7aa058
--- /dev/null
+++ b/cmp/hegel_deepequal_test.go
@@ -0,0 +1,315 @@
+package cmp_test
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+// --------------------------------------------------------------------------- plain values
+
+// S is a struct with exported fields only, no Equal method: cmp.Equal on such values is
+// documented to behave "much like reflect.DeepEqual".
+type S struct {
+	A int
+	B string
+	P *S
+	L []any
+}
+
+// Code is an error with an exported field only, so cmp can compare it without options.
+type Code struct{ C int }
+
+func (c Code) Error() string { return "code" }
+
+var (
+	sharedChan = make(chan int)
+	otherChan  = make(chan int)
+	sharedFunc = func() {}
+)
+
+// The leaf kinds of a value, plainest first: nil, a bool, small integers of three types, a
+// float (including -0, NaN and +Inf), a complex, a short string, a byte slice (nil, empty or
+// one byte), an int slice, an array, a string-keyed map, an error (nil or a Code), one of two
+// channels, a nil or a shared function.
+var (
+	nils     = hegel.Just[any](nil)
+	bools    = asAny(hegel.Booleans())
+	ints     = asAny(hegel.Integers(-3, 3))
+	int64s   = asAny(hegel.Integers[int64](-3, 3))
+	uint8s   = asAny(hegel.Integers[uint8](0, 3))
+	float64s = asAny(hegel.SampledFrom([]float64{0, 1, -1, 0.5, math.Copysign(0, -1), math.NaN(), math.Inf(1)}))
+	complexs = asAny(hegel.Map(hegel.Integers(0, 3), func(n int) complex128 { return complex(float64(n&1), float64(n>>1)) }))
+	strs     = asAny(hegel.SampledFrom([]string{"", "a", "b", "ab"}))
+	byteSls  = hegel.OneOf(hegel.Just[any]([]byte(nil)), hegel.Just[any]([]byte{}), asAny(hegel.Map(hegel.SampledFrom([]string{"a", "b"}), func(s string) []byte { return []byte(s) })))
+	intSls   = hegel.OneOf(hegel.Just[any]([]int(nil)), hegel.Just[any]([]int{}), asAny(many(hegel.Integers(0, 2), 1, 3)))
+	arrays   = asAny(hegel.Map(hegel.Integers(0, 3), func(n int) [2]int { return [2]int{n & 1, n >> 1} }))
+	strMaps  = hegel.OneOf(hegel.Just[any](map[string]int(nil)), hegel.Just[any](map[string]int{}), asAny(hegel.Maps(hegel.SampledFrom([]string{"a", "b", "c"}), hegel.Integers(0, 1)).MinSize(1).MaxSize(2)))
+	errs     = weighted(choice[any]{30, hegel.Just[any](error(nil))}, choice[any]{70, asAny(hegel.Map(hegel.Integers(0, 1), func(n int) error { return Code{n} }))})
+	chans    = hegel.SampledFrom([]any{sharedChan, otherChan})
+	funcs    = hegel.SampledFrom([]any{(func())(nil), sharedFunc})
+	leaves   = hegel.OneOf(nils, bools, ints, int64s, uint8s, float64s, complexs, strs, byteSls, intSls, arrays, strMaps, errs, chans, funcs)
+)
+
+// values is a value tree of any of the kinds above, or, up to three containers deep, an S, a
+// pointer to one (nil a quarter of the time), a slice of values or an int-keyed map of
+// values; structs is the S generator the tree uses, whose P and L fields are also bounded by
+// the depth. The two refer to each other, so both are built in one initialiser with the depth
+// counter in the closure (hegel-go's recursive Composite example).
+var values, structs = func() (hegel.Generator[any], hegel.Generator[S]) {
+	const maxDepth = 3
+	depth := 0
+	var values hegel.Generator[any]
+	var structs hegel.Generator[S]
+	var nodes hegel.Generator[any]
+	values = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, leaves)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, nodes)
+	})
+	structs = hegel.Composite(func(tc hegel.TestCase) S {
+		s := S{A: hegel.Draw(tc, hegel.Integers(0, 1)), B: hegel.Draw(tc, hegel.SampledFrom([]string{"", "x"}))}
+		if depth >= maxDepth {
+			return s
+		}
+		depth++
+		defer func() { depth-- }()
+		s.P = hegel.Draw(tc, optional(40, structs))
+		s.L = hegel.Draw(tc, maybe(40, anyLists(values)))
+		return s
+	})
+	ptrs := weighted(choice[any]{25, hegel.Just[any]((*S)(nil))}, choice[any]{75, asAny(hegel.Map(structs, ptrTo[S]))})
+	anyMaps := hegel.OneOf(hegel.Just[any](map[int]any(nil)), hegel.Just[any](map[int]any{}), asAny(hegel.Maps(hegel.Integers(0, 1), values).MinSize(1).MaxSize(2)))
+	nodes = hegel.OneOf(nils, bools, ints, int64s, uint8s, float64s, complexs, strs, byteSls, intSls, arrays, strMaps, asAny(structs), ptrs, asAny(anyLists(values)), anyMaps, errs, chans, funcs)
+	return values, structs
+}()
+
+// anyLists is a slice of up to two elements: nil, empty, or drawn.
+func anyLists(elements hegel.Generator[any]) hegel.Generator[[]any] {
+	return hegel.OneOf(hegel.Just[[]any](nil), hegel.Just([]any{}), many(elements, 1, 2))
+}
+
+// clone deep-copies the generated shapes (pointers to fresh copies, distinct slice and map
+// storage, nil kept nil, channels and functions shared).
+func clone(v any) any {
+	switch x := v.(type) {
+	case []byte:
+		if x == nil {
+			return []byte(nil)
+		}
+		return append([]byte{}, x...)
+	case []int:
+		if x == nil {
+			return []int(nil)
+		}
+		return append([]int{}, x...)
+	case map[string]int:
+		if x == nil {
+			return map[string]int(nil)
+		}
+		m := map[string]int{}
+		for k, v := range x {
+			m[k] = v
+		}
+		return m
+	case map[int]any:
+		if x == nil {
+			return map[int]any(nil)
+		}
+		m := map[int]any{}
+		for k, v := range x {
+			m[k] = clone(v)
+		}
+		return m
+	case S:
+		return cloneS(x)
+	case *S:
+		if x == nil {
+			return (*S)(nil)
+		}
+		s := cloneS(*x)
+		return &s
+	case []any:
+		if x == nil {
+			return []any(nil)
+		}
+		ys := make([]any, len(x))
+		for i := range x {
+			ys[i] = clone(x[i])
+		}
+		return ys
+	}
+	return v
+}
+
+func cloneS(s S) S {
+	c := S{A: s.A, B: s.B}
+	if s.P != nil {
+		p := cloneS(*s.P)
+		c.P = &p
+	}
+	if s.L != nil {
+		c.L = clone(s.L).([]any)
+	}
+	return c
+}
+
+// selfUnequal reports whether v holds a NaN or a non-nil function, the two things cmp
+// documents as unequal to themselves (reflect.DeepEqual agrees, except that it takes identical
+// pointers, slices and maps as equal whatever they hold).
+func selfUnequal(v any) bool {
+	switch x := v.(type) {
+	case float64:
+		return math.IsNaN(x)
+	case func():
+		return x != nil
+	case []any:
+		for _, e := range x {
+			if selfUnequal(e) {
+				return true
+			}
+		}
+	case map[int]any:
+		for _, e := range x {
+			if selfUnequal(e) {
+				return true
+			}
+		}
+	case S:
+		return (x.P != nil && selfUnequal(*x.P)) || selfUnequal(x.L)
+	case *S:
+		return x != nil && selfUnequal(*x)
+	}
+	return false
+}
+
+// render writes a value with its pointers dereferenced and its maps in key order, for the
+// draw report and the failure messages.
+func render(v any) string {
+	switch x := v.(type) {
+	case *S:
+		if x == nil {
+			return "(*S)(nil)"
+		}
+		return "&" + render(*x)
+	case S:
+		return fmt.Sprintf("S{A:%d B:%q P:%s L:%s}", x.A, x.B, render(x.P), render(x.L))
+	case []any:
+		if x == nil {
+			return "[]any(nil)"
+		}
+		parts := make([]string, len(x))
+		for i, e := range x {
+			parts[i] = render(e)
+		}
+		return "[]any{" + strings.Join(parts, ", ") + "}"
+	case map[int]any:
+		if x == nil {
+			return "map[int]any(nil)"
+		}
+		keys := make([]int, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Ints(keys)
+		parts := make([]string, len(keys))
+		for i, k := range keys {
+			parts[i] = fmt.Sprintf("%d:%s", k, render(x[k]))
+		}
+		return "map[int]any{" + strings.Join(parts, ", ") + "}"
+	case chan int:
+		if x == sharedChan {
+			return "sharedChan"
+		}
+		return "otherChan"
+	case func():
+		if x == nil {
+			return "(func())(nil)"
+		}
+		return "sharedFunc"
+	}
+	return fmt.Sprintf("%#v", v)
+}
+
+// deepCase is a pair of values and how the second was made from the first: the same value,
+// a deep copy, an independent value, or both wrapped in a []any (a different static shape
+// around the same value).
+type deepCase struct {
+	x, y any
+	kind string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c deepCase) GoString() string {
+	return fmt.Sprintf("%s: x %s, y %s", c.kind, render(c.x), render(c.y))
+}
+
+var (
+	samePairs   = hegel.Map(values, func(x any) deepCase { return deepCase{x, x, "same"} })
+	clonedPairs = hegel.Map(values, func(x any) deepCase { return deepCase{x, clone(x), "clone"} })
+	otherPairs  = hegel.Composite(func(tc hegel.TestCase) deepCase {
+		return deepCase{hegel.Draw(tc, values), hegel.Draw(tc, values), "other"}
+	})
+	wrappedPairs = hegel.Map(values, func(x any) deepCase { return deepCase{[]any{clone(x)}, []any{x}, "wrapped"} })
+	deepCases    = hegel.OneOf(samePairs, clonedPairs, otherPairs, otherPairs, wrappedPairs)
+)
+
+// TestHegelEqualFollowsDeepEqual: on values with exported fields only, no Equal methods and no
+// cycles, cmp.Equal agrees with reflect.DeepEqual; Diff is empty exactly when Equal holds and
+// otherwise marks removed and added lines; Equal is symmetric.
+func TestHegelEqualFollowsDeepEqual(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, deepCases)
+		x, y := p.x, p.y
+		c.count(p.kind)
+		want := reflect.DeepEqual(x, y)
+		if p.kind == "same" && selfUnequal(x) {
+			// reflect.DeepEqual takes identical pointers, slices and maps as equal whatever they
+			// hold; cmp compares the contents, where a NaN or a function is unequal to itself.
+			want = false
+		}
+		got := cmp.Equal(x, y)
+		if got != want {
+			c.fail(ht, "Equal(%s, %s) = %v, DeepEqual %v", render(x), render(y), got, want)
+			return
+		}
+		if back := cmp.Equal(y, x); back != got {
+			c.fail(ht, "Equal(%s, %s) = %v but Equal(y, x) = %v", render(x), render(y), got, back)
+		}
+		d := cmp.Diff(x, y)
+		if (d == "") != got {
+			c.fail(ht, "Diff(%s, %s) = %q while Equal = %v", render(x), render(y), d, got)
+			return
+		}
+		if got {
+			return
+		}
+		minus, plus := false, false
+		for _, line := range strings.Split(strings.TrimSuffix(d, "\n"), "\n") {
+			if len(line) < 2 || (line[0] != ' ' && line[0] != '-' && line[0] != '+') || line[1] != ' ' {
+				c.fail(ht, "Diff(%s, %s) has a line without a two-character prefix: %q\n%s", render(x), render(y), line, d)
+				return
+			}
+			minus = minus || line[0] == '-'
+			plus = plus || line[0] == '+'
+		}
+		if !minus && !plus {
+			c.fail(ht, "Diff(%s, %s) marks nothing removed or added:\n%s", render(x), render(y), d)
+		}
+		// Reflexivity: a value equals itself unless it holds a NaN or a function.
+		if self := cmp.Equal(x, x); self == selfUnequal(x) {
+			c.fail(ht, "Equal(x, x) = %v for %s", self, render(x))
+		}
+	})
+}
diff --git a/cmp/hegel_diff_test.go b/cmp/hegel_diff_test.go
new file mode 100644
index 0000000..0e72284
--- /dev/null
+++ b/cmp/hegel_diff_test.go
@@ -0,0 +1,161 @@
+package cmp_test
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+// --------------------------------------------------------------------------- diff text
+
+// linePool: the lines of a text (tabs, quotes, non-ASCII, a NUL, a long line) for the
+// line-oriented part of the Diff reporter.
+var linePool = []string{"", "a", "bb", "hello world", "x\ty", "tab\there", " lead", "trail ", "quote\"q", "uni\u00e9", "\x00nul", "very long line that goes on and on and on for a while to exceed widths"}
+
+// doc is a multi-line text: its lines, whether a final newline follows them, and whether the
+// line breaks are CRLF.
+type doc struct {
+	lines        []string
+	finalNewline bool
+	crlf         bool
+}
+
+func (d doc) String() string {
+	s := strings.Join(d.lines, "\n")
+	if d.finalNewline {
+		s += "\n"
+	}
+	if d.crlf {
+		s = strings.ReplaceAll(s, "\n", "\r\n")
+	}
+	return s
+}
+
+var docs = hegel.Composite(func(tc hegel.TestCase) doc {
+	return doc{
+		lines:        hegel.Draw(tc, hegel.Lists(hegel.SampledFrom(linePool)).MaxSize(12)),
+		finalNewline: hegel.Draw(tc, chance(30)),
+		crlf:         hegel.Draw(tc, chance(10)),
+	}
+})
+
+// lineEdit is one change to the lines of a text: an insertion of a line, a deletion, or a
+// "!" appended; the position is taken modulo the live number of lines when it is applied.
+type lineEdit struct {
+	op   string
+	at   int
+	line string
+}
+
+var (
+	position = hegel.Integers(0, 12)
+	inserts  = hegel.Composite(func(tc hegel.TestCase) lineEdit {
+		return lineEdit{op: "insert", at: hegel.Draw(tc, position), line: hegel.Draw(tc, hegel.SampledFrom([]string{"new", "", "zz"}))}
+	})
+	deletes   = hegel.Map(position, func(i int) lineEdit { return lineEdit{op: "delete", at: i} })
+	bangs     = hegel.Map(position, func(i int) lineEdit { return lineEdit{op: "bang", at: i} })
+	lineEdits = many(hegel.OneOf(inserts, deletes, bangs), 1, 3)
+)
+
+// editText applies the edits to the lines of s (split at "\n", so a CRLF text keeps its
+// carriage returns on the lines) and joins them again.
+func editText(s string, edits []lineEdit) string {
+	lines := strings.Split(s, "\n")
+	for _, e := range edits {
+		switch e.op {
+		case "insert":
+			lines = slices.Insert(lines, e.at%(len(lines)+1), e.line)
+		case "delete":
+			if len(lines) > 0 {
+				i := e.at % len(lines)
+				lines = slices.Delete(lines, i, i+1)
+			}
+		case "bang":
+			if len(lines) > 0 {
+				lines[e.at%len(lines)] += "!"
+			}
+		}
+	}
+	return strings.Join(lines, "\n")
+}
+
+// byteSlices: up to forty bytes from a pool of controls, ASCII, DEL and high bytes.
+var byteSlices = hegel.Lists(hegel.SampledFrom([]byte{0, 1, 10, 13, 32, 65, 97, 127, 128, 200, 255, 'a', 'b'})).MaxSize(40)
+
+// diffCase is a pair of values for Diff: a text and an edited copy, as strings, as byte
+// slices, as slices of lines or as structs holding the text; or two independent byte slices.
+type diffCase struct {
+	kind  string
+	text  doc
+	edits []lineEdit
+	a, b  []byte
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c diffCase) GoString() string {
+	x, y := c.values()
+	return fmt.Sprintf("%s: x %#v, y %#v", c.kind, x, y)
+}
+
+// values renders the case into the two values compared.
+func (c diffCase) values() (x, y any) {
+	s := c.text.String()
+	e := editText(s, c.edits)
+	switch c.kind {
+	case "text":
+		return s, e
+	case "bytes":
+		return []byte(s), []byte(e)
+	case "lines":
+		return strings.Split(s, "\n"), strings.Split(e, "\n")
+	case "struct":
+		return struct{ A, B string }{s, "k"}, struct{ A, B string }{e, "k"}
+	}
+	return c.a, c.b
+}
+
+var (
+	editedTexts = hegel.Composite(func(tc hegel.TestCase) diffCase {
+		return diffCase{
+			kind:  hegel.Draw(tc, hegel.SampledFrom([]string{"text", "bytes", "lines", "struct"})),
+			text:  hegel.Draw(tc, docs),
+			edits: hegel.Draw(tc, lineEdits),
+		}
+	})
+	bytePairs = hegel.Composite(func(tc hegel.TestCase) diffCase {
+		return diffCase{kind: "raw bytes", a: hegel.Draw(tc, byteSlices), b: hegel.Draw(tc, byteSlices)}
+	})
+	diffCases = weighted(choice[diffCase]{80, editedTexts}, choice[diffCase]{20, bytePairs})
+)
+
+// TestHegelDiffTextIsCoherent: on texts, byte slices, slices of lines and structs holding a
+// text against an edited copy, Diff is empty iff Equal and otherwise every line carries the
+// documented two-character prefix (the reporter's line and byte diffing).
+func TestHegelDiffTextIsCoherent(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, diffCases)
+		x, y := p.values()
+		c.count(p.kind)
+		eq := cmp.Equal(x, y)
+		d := cmp.Diff(x, y)
+		if (d == "") != eq {
+			c.fail(ht, "Diff/Equal disagree: %v %q", eq, d)
+			return
+		}
+		if eq {
+			return
+		}
+		for _, line := range strings.Split(strings.TrimSuffix(d, "\n"), "\n") {
+			if len(line) < 2 || (line[0] != ' ' && line[0] != '-' && line[0] != '+') || line[1] != ' ' {
+				c.fail(ht, "bad prefix %q in\n%s\nx=%q\ny=%q", line, d, fmt.Sprint(x), fmt.Sprint(y))
+				return
+			}
+		}
+	})
+}
diff --git a/cmp/hegel_misuse_test.go b/cmp/hegel_misuse_test.go
new file mode 100644
index 0000000..16e23b8
--- /dev/null
+++ b/cmp/hegel_misuse_test.go
@@ -0,0 +1,268 @@
+package cmp_test
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+)
+
+// --------------------------------------------------------------------------- misuse
+
+// fieldsOf lists the field names of the struct types reachable from Doc by IgnoreFields
+// selectors, with the type each field leads to ("" for a leaf).
+var fieldsOf = map[string]map[string]string{
+	"Doc":  {"Base": "Base", "ID": "", "Name": "", "N": "", "F": "", "Tags": "", "Attrs": "", "Sub": "Sub", "When": "Time", "Err": "iface", "M": "Mod", "secret": ""},
+	"Base": {"ID": ""},
+	"Sub":  {"X": "", "Names": ""},
+	"Time": {"wall": "", "ext": "", "loc": "Location"},
+	"Mod":  {"V": ""},
+}
+
+// leafNames: the names a selector goes on with past a leaf, an interface or a Location,
+// none of which has fields a selector may name.
+var leafNames = []string{"X", "V", "Nope", "ID"}
+
+// segment is one piece of a selector: the k-th field name (modulo the number of names) of
+// the struct reached so far, a name no struct has, or an empty segment.
+type segment struct {
+	kind string // "name", "missing" or "empty"
+	k    int
+}
+
+// selector is a dot-separated selector for IgnoreFields(Doc{}, sel) drawn as data: its
+// segments, and whether a dot leads or trails.
+type selector struct {
+	segs                    []segment
+	leadingDot, trailingDot bool
+}
+
+var (
+	segments = weighted(
+		choice[segment]{80, hegel.Map(hegel.Integers(0, 11), func(k int) segment { return segment{"name", k} })},
+		choice[segment]{10, hegel.Just(segment{kind: "missing"})},
+		choice[segment]{10, hegel.Just(segment{kind: "empty"})},
+	)
+	selectors = hegel.Composite(func(tc hegel.TestCase) selector {
+		return selector{segs: hegel.Draw(tc, many(segments, 1, 3)), leadingDot: hegel.Draw(tc, chance(15)), trailingDot: hegel.Draw(tc, chance(10))}
+	})
+)
+
+// fieldNamesOf: the field names of a struct type, sorted.
+func fieldNamesOf(typ string) []string {
+	names := make([]string, 0, len(fieldsOf[typ]))
+	for k := range fieldsOf[typ] {
+		names = append(names, k)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// String renders the selector by walking the types: a segment past a leaf, an interface or a
+// Location takes a name from leafNames; elsewhere it names a field of the struct reached, a
+// missing name or nothing, after which no type is reached.
+func (s selector) String() string {
+	var segs []string
+	typ := "Doc"
+	for _, seg := range s.segs {
+		if typ == "" || typ == "iface" || typ == "Location" {
+			segs = append(segs, leafNames[seg.k%len(leafNames)])
+			continue
+		}
+		switch seg.kind {
+		case "missing":
+			segs = append(segs, "Nope")
+			typ = ""
+		case "empty":
+			segs = append(segs, "")
+			typ = ""
+		default:
+			names := fieldNamesOf(typ)
+			name := names[seg.k%len(names)]
+			segs = append(segs, name)
+			typ = fieldsOf[typ][name]
+		}
+	}
+	sel := strings.Join(segs, ".")
+	if s.leadingDot {
+		sel = "." + sel
+	}
+	if s.trailingDot {
+		sel += "."
+	}
+	return sel
+}
+
+// selectorValid is the documented rule: one leading dot is harmless, every segment names a
+// field of the struct reached so far (exported fields of embedded structs are visible on the
+// parent) and a segment is followed by another only if it leads to a struct.
+func selectorValid(sel string) bool {
+	sel = strings.TrimPrefix(sel, ".")
+	if sel == "" {
+		return false
+	}
+	typ := "Doc"
+	for _, seg := range strings.Split(sel, ".") {
+		if typ == "" || typ == "iface" || typ == "Location" {
+			return false
+		}
+		next, ok := fieldsOf[typ][seg]
+		if !ok {
+			return false
+		}
+		typ = next
+	}
+	return true
+}
+
+type misuse struct {
+	name  string
+	build func()
+	panic bool   // whether the documentation says this panics
+	text  string // a fragment the panic message should carry, when documented
+}
+
+var misuses = []misuse{
