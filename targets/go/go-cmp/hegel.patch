+		cmp.Equal(map[int]int{1: 1, 2: 2}, map[int]int{1: 1, 2: 2}, cmpopts.SortMaps(func(a, b int) bool { return false }))
+	}, true, "partial order detected"},
+	{"EquateApprox ok", func() { cmpopts.EquateApprox(0.1, 0.5) }, false, ""},
+	{"EquateApprox zero", func() { cmpopts.EquateApprox(0, 0) }, false, ""},
+	{"EquateApprox negative fraction", func() { cmpopts.EquateApprox(-0.1, 0) }, true, "non-negative"},
+	{"EquateApprox negative margin", func() { cmpopts.EquateApprox(0, -1) }, true, "non-negative"},
+	{"EquateApprox NaN", func() { cmpopts.EquateApprox(math.NaN(), 0) }, true, "non-negative"},
+	{"EquateApproxTime ok", func() { cmpopts.EquateApproxTime(time.Second) }, false, ""},
+	{"EquateApproxTime negative", func() { cmpopts.EquateApproxTime(-time.Second) }, true, "non-negative"},
+	{"EquateComparable ok", func() { cmpopts.EquateComparable(time.Time{}, Base{}) }, false, ""},
+	{"EquateComparable slice", func() { cmpopts.EquateComparable([]int{}) }, true, "not a comparable Go type"},
+	{"EquateComparable twice", func() { cmpopts.EquateComparable(Base{}, Base{}) }, true, "already specified"},
+	{"NaN map key", func() { cmp.Equal(map[float64]int{math.NaN(): 1}, map[float64]int{math.NaN(): 1}) }, true, "map key with NaNs"},
+	{"Reporter and Exporter ok", func() {
+		cmp.Equal(Doc{}, Doc{}, cmp.Reporter(&recorder{}), cmp.Exporter(func(reflect.Type) bool { return true }))
+	}, false, ""},
+}
+
+// misuseCase is one construction to try: an entry of the table, or an IgnoreFields selector.
+type misuseCase struct {
+	table    *misuse
+	selector selector
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c misuseCase) GoString() string {
+	if c.table != nil {
+		return "table: " + c.table.name
+	}
+	return fmt.Sprintf("selector %q", c.selector.String())
+}
+
+// misuseCases: a table entry half of the time (hegel-go's OneOf of the two came out one to
+// six), else a selector.
+var misuseCases = weighted(
+	choice[misuseCase]{50, hegel.Map(hegel.Integers(0, len(misuses)-1), func(i int) misuseCase { return misuseCase{table: &misuses[i]} })},
+	choice[misuseCase]{50, hegel.Map(selectors, func(s selector) misuseCase { return misuseCase{selector: s} })},
+)
+
+// TestHegelMisusePanicsAsDocumented: the constructions the documentation calls invalid panic
+// with the documented message, the valid ones do not; an IgnoreFields selector is accepted
+// exactly when every segment names a field of the struct reached.
+func TestHegelMisusePanicsAsDocumented(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		mc := hegel.Draw(ht, misuseCases)
+		if m := mc.table; m != nil {
+			c.count("table")
+			r := catch(m.build)
+			if (r != nil) != m.panic {
+				c.fail(ht, "%s: panic %v, want panic %v", m.name, r, m.panic)
+				return
+			}
+			if r != nil && m.text != "" && !strings.Contains(fmt.Sprint(r), m.text) {
+				c.fail(ht, "%s: panic %q does not mention %q", m.name, fmt.Sprint(r), m.text)
+			}
+			return
+		}
+		sel := mc.selector.String()
+		valid := selectorValid(sel)
+		c.count("selector")
+		r := catch(func() { cmpopts.IgnoreFields(Doc{}, sel) })
+		if (r == nil) != valid {
+			c.fail(ht, "IgnoreFields(Doc{}, %q): panic %v, want valid %v", sel, r, valid)
+		}
+	})
+}
