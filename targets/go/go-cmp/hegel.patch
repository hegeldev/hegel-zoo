+package cmp_test
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+)
+
+// --------------------------------------------------------------------------- the document
+
+type Base struct{ ID int }
+
+// Mod has an Equal method of the documented form "(T) Equal(T) bool".
+type Mod struct{ V int }
+
+func (m Mod) Equal(o Mod) bool { return m.V%5 == o.V%5 }
+
+type Sub struct {
+	X     int
+	Names []string
+}
+
+type Doc struct {
+	Base
+	Name   string
+	N      int
+	F      float64
+	Tags   []string
+	Attrs  map[string]int
+	Sub    *Sub
+	When   time.Time
+	Err    error
+	M      Mod
+	secret int
+}
+
+var (
+	baseTime = time.Date(2026, 9, 21, 12, 0, 0, 0, time.UTC)
+	times    = []time.Time{{}, baseTime, baseTime.Add(time.Second), baseTime.Add(2 * time.Second), baseTime.Add(time.Hour)}
+	floats   = []float64{0, 0.5, 1, 1.05, 1.1, 2, math.NaN()}
+	words    = []string{"a", "A", "b", "B", "x1", "x2", ""}
+	keys     = []string{"a", "A", "b", "c"}
+	codeOne  = Code{1}
+	wrapped  = fmt.Errorf("wrapped: %w", codeOne)
+)
+
+// --------------------------------------------------------------------------- the options
+
+// approx is the parameters of EquateApprox.
+type approx struct{ frac, margin float64 }
+
+// opts is a selection of options, with the parameters the model needs.
+type opts struct {
+	unexported    string // "ignore", "allow" or "exporter"
+	equateEmpty   bool
+	equateNaNs    bool
+	approx        *approx
+	ignoreFields  []string
+	ignoreTypes   []string // "time", "mod", "subptr", "strings", "int", "string"
+	sortSlices    bool
+	sortMaps      bool
+	ignoreSliceEl bool // elements with prefix "x"
+	ignoreMapEnt  bool // entries with a negative value
+	lower         bool // Transformer strings.ToLower
+	compareMod3   bool // Comparer on ints
+	equateErrors  bool
+	ignoreIface   bool // IgnoreInterfaces(struct{ error }{})
+	approxTime    *time.Duration
+}
+
+var (
+	fieldNames = []string{"Name", "N", "F", "Tags", "Attrs", "Sub", "Sub.X", "Sub.Names", "When", "Err", "M", "ID", "Base.ID", "Base", "secret"}
+	typeKinds  = []string{"time", "mod", "subptr", "strings", "int", "string"}
+	approxes   = hegel.Composite(func(tc hegel.TestCase) approx {
+		return approx{frac: hegel.Draw(tc, hegel.SampledFrom([]float64{0, 0.1, 0.5})), margin: hegel.Draw(tc, hegel.SampledFrom([]float64{0, 0.06, 0.5}))}
+	})
+	timeMargins = hegel.SampledFrom([]time.Duration{0, time.Second, time.Hour})
+	// ignoredFields: one to three names from fieldNames, 40% of the time.
+	ignoredFields = maybe(40, many(hegel.SampledFrom(fieldNames), 1, 3))
+)
+
+// allOpts: every option drawn independently, a third of the time each or so, with the
+// unexported-field handling always set (the document has an unexported field). Under
+// HEGEL_NO_KNOWN=1 IgnoreMapEntries is left out beside SortMaps (go-cmp/1).
+var allOpts = hegel.Map(hegel.Composite(func(tc hegel.TestCase) opts {
+	return opts{
+		unexported:    hegel.Draw(tc, hegel.SampledFrom([]string{"ignore", "allow", "exporter"})),
+		equateEmpty:   hegel.Draw(tc, chance(35)),
+		equateNaNs:    hegel.Draw(tc, chance(35)),
+		approx:        hegel.Draw(tc, optional(35, approxes)),
+		ignoreFields:  hegel.Draw(tc, ignoredFields),
+		ignoreTypes:   hegel.Draw(tc, maybe(30, many(hegel.SampledFrom(typeKinds), 1, 2))),
+		sortSlices:    hegel.Draw(tc, chance(35)),
+		sortMaps:      hegel.Draw(tc, chance(35)),
+		ignoreSliceEl: hegel.Draw(tc, chance(30)),
+		ignoreMapEnt:  hegel.Draw(tc, chance(30)),
+		lower:         hegel.Draw(tc, chance(30)),
+		compareMod3:   hegel.Draw(tc, chance(30)),
+		equateErrors:  hegel.Draw(tc, chance(35)),
+		ignoreIface:   hegel.Draw(tc, chance(15)),
+		approxTime:    hegel.Draw(tc, optional(35, timeMargins)),
+	}
+}), withoutKnown)
+
+// withoutKnown leaves the shape of go-cmp/1 out of an option set while its switch is on
+// (HEGEL_NO_KNOWN=1): IgnoreMapEntries is dropped beside SortMaps.
+func withoutKnown(o opts) opts {
+	if Known.sortMapsIgnoreEntries && o.sortMaps {
+		o.ignoreMapEnt = false
+	}
+	return o
+}
+
+func (o opts) ignores(field string) bool {
+	for _, f := range o.ignoreFields {
+		if f == field {
+			return true
+		}
+	}
+	return false
+}
+
+func (o opts) ignoresType(kind string) bool {
+	for _, k := range o.ignoreTypes {
+		if k == kind {
+			return true
+		}
+	}
+	return false
+}
+
+// String lists the options in force, for the draw report and the failure messages.
+func (o opts) String() string {
+	parts := []string{"unexported=" + o.unexported}
+	flag := func(on bool, name string) {
+		if on {
+			parts = append(parts, name)
+		}
+	}
+	flag(o.equateEmpty, "EquateEmpty")
+	flag(o.equateNaNs, "EquateNaNs")
+	if o.approx != nil {
+		parts = append(parts, fmt.Sprintf("EquateApprox(%v, %v)", o.approx.frac, o.approx.margin))
+	}
+	if len(o.ignoreFields) > 0 {
+		parts = append(parts, fmt.Sprintf("IgnoreFields%q", o.ignoreFields))
+	}
+	if len(o.ignoreTypes) > 0 {
+		parts = append(parts, fmt.Sprintf("IgnoreTypes%q", o.ignoreTypes))
+	}
+	flag(o.sortSlices, "SortSlices")
+	flag(o.sortMaps, "SortMaps")
+	flag(o.ignoreSliceEl, "IgnoreSliceElements(x*)")
+	flag(o.ignoreMapEnt, "IgnoreMapEntries(v<0)")
+	flag(o.lower, "Transformer(ToLower)")
+	flag(o.compareMod3, "Comparer(mod 3)")
+	flag(o.equateErrors, "EquateErrors")
+	flag(o.ignoreIface, "IgnoreInterfaces(error)")
+	if o.approxTime != nil {
+		parts = append(parts, fmt.Sprintf("EquateApproxTime(%v)", *o.approxTime))
+	}
+	return strings.Join(parts, " ")
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (o opts) GoString() string { return o.String() }
+
+// build renders the option set into cmp.Options.
+func (o opts) build() []cmp.Option {
+	var out []cmp.Option
+	switch o.unexported {
+	case "ignore":
+		out = append(out, cmpopts.IgnoreUnexported(Doc{}))
+	case "allow":
+		out = append(out, cmp.AllowUnexported(Doc{}))
+	default:
+		docType := reflect.TypeOf(Doc{})
+		out = append(out, cmp.Exporter(func(t reflect.Type) bool { return t == docType }))
+	}
+	if o.equateEmpty {
+		out = append(out, cmpopts.EquateEmpty())
+	}
+	if o.equateNaNs {
+		out = append(out, cmpopts.EquateNaNs())
+	}
+	if o.approx != nil {
+		out = append(out, cmpopts.EquateApprox(o.approx.frac, o.approx.margin))
+	}
+	if len(o.ignoreFields) > 0 {
+		out = append(out, cmpopts.IgnoreFields(Doc{}, o.ignoreFields...))
+	}
+	for _, k := range o.ignoreTypes {
+		var v any
+		switch k {
+		case "time":
+			v = time.Time{}
+		case "mod":
+			v = Mod{}
+		case "subptr":
+			v = (*Sub)(nil)
+		case "strings":
+			v = []string(nil)
+		case "int":
+			v = 0
+		case "string":
+			v = ""
+		}
+		out = append(out, cmpopts.IgnoreTypes(v))
+	}
+	if o.sortSlices {
+		if chanceStatic(o) {
+			out = append(out, cmpopts.SortSlices(func(a, b string) bool { return a < b }))
+		} else {
+			out = append(out, cmpopts.SortSlices(strings.Compare))
+		}
+	}
+	if o.sortMaps {
+		if chanceStatic(o) {
+			out = append(out, cmpopts.SortMaps(func(a, b string) bool { return a < b }))
+		} else {
+			out = append(out, cmpopts.SortMaps(strings.Compare))
+		}
+	}
+	if o.ignoreSliceEl {
+		out = append(out, cmpopts.IgnoreSliceElements(func(s string) bool { return strings.HasPrefix(s, "x") }))
+	}
+	if o.ignoreMapEnt {
+		out = append(out, cmpopts.IgnoreMapEntries(func(k string, v int) bool { return v < 0 }))
+	}
+	if o.lower {
+		out = append(out, cmp.Transformer("Lower", strings.ToLower))
+	}
+	if o.compareMod3 {
+		out = append(out, cmp.Comparer(func(a, b int) bool { return a%3 == b%3 }))
+	}
+	if o.equateErrors {
+		out = append(out, cmpopts.EquateErrors())
+	}
+	if o.ignoreIface {
+		out = append(out, cmpopts.IgnoreInterfaces(struct{ error }{}))
+	}
+	if o.approxTime != nil {
+		out = append(out, cmpopts.EquateApproxTime(*o.approxTime))
+	}
+	// Nest some of the options in cmp.Options to exercise flattening.
+	if len(out) > 2 && o.compareMod3 {
+		out = []cmp.Option{cmp.Options(out[:2]), cmp.Options(out[2:])}
+	}
+	return out
+}
+
+// chanceStatic picks the less-function or compare-function form of the sort options from the
+// option bits, so a build is deterministic for a given opts value.
+func chanceStatic(o opts) bool { return o.equateEmpty != o.equateNaNs }
+
+// --------------------------------------------------------------------------- documents
+
+var (
+	// wordLists: nil, empty, or one to four words (the three spellings cmp treats apart).
+	wordLists = hegel.OneOf(hegel.Just[[]string](nil), hegel.Just([]string{}), many(hegel.SampledFrom(words), 1, 4))
+	// attrs: nil, empty, or one to three entries with values around zero, so that the
+	// entry ignore (v < 0) and the Comparer (mod 3) have something to act on.
+	attrs = hegel.OneOf(hegel.Just[map[string]int](nil), hegel.Just(map[string]int{}), hegel.Maps(hegel.SampledFrom(keys), hegel.Integers(-2, 3)).MinSize(1).MaxSize(3))
+	subs  = optional(70, hegel.Composite(func(tc hegel.TestCase) Sub {
+		return Sub{X: hegel.Draw(tc, hegel.Integers(0, 3)), Names: hegel.Draw(tc, wordLists)}
+	}))
+	plainErrs = []error{nil, codeOne, Code{2}, cmpopts.AnyError}
+	// moreErrs adds errors of other types, which cmp can only compare under EquateErrors or
+	// with the field ignored (a plain error has an unexported field).
+	moreErrs = append(append([]error{}, plainErrs...), wrapped, errors.New("plain"))
+)
+
+// docsOf is a document drawn from small pools, so that near-equal pairs are common; the error
+// field draws the wider pool when the options can compare it.
+func docsOf(o opts) hegel.Generator[Doc] {
+	errPool := plainErrs
+	if o.equateErrors || o.ignoreIface || o.ignores("Err") {
+		errPool = moreErrs
+	}
+	errs := hegel.SampledFrom(errPool)
+	return hegel.Composite(func(tc hegel.TestCase) Doc {
+		return Doc{
+			Base:   Base{ID: hegel.Draw(tc, hegel.Integers(0, 2))},
+			Name:   hegel.Draw(tc, hegel.SampledFrom(words)),
+			N:      hegel.Draw(tc, hegel.Integers(0, 9)),
+			F:      hegel.Draw(tc, hegel.SampledFrom(floats)),
+			Tags:   hegel.Draw(tc, wordLists),
+			Attrs:  hegel.Draw(tc, attrs),
+			Sub:    hegel.Draw(tc, subs),
+			When:   hegel.Draw(tc, hegel.SampledFrom(times)),
+			Err:    hegel.Draw(tc, errs),
+			M:      Mod{V: hegel.Draw(tc, hegel.Integers(0, 9))},
+			secret: hegel.Draw(tc, hegel.Integers(0, 1)),
+		}
+	})
+}
+
+// mutation is one change of a document: the field (an index into the eleven fields) is taken
+// from a fresh document.
+type mutation struct {
+	field int
+	fresh Doc
+}
+
+func mutationsOf(docs hegel.Generator[Doc], lo, hi int) hegel.Generator[[]mutation] {
+	return many(hegel.Composite(func(tc hegel.TestCase) mutation {
+		return mutation{field: hegel.Draw(tc, hegel.Integers(0, 10)), fresh: hegel.Draw(tc, docs)}
+	}), lo, hi)
+}
+
+// mutate returns d with the fields the mutations name taken from their fresh documents.
+func mutate(d Doc, muts []mutation) Doc {
+	for _, m := range muts {
+		fresh := m.fresh
+		switch m.field {
+		case 0:
+			d.ID = fresh.ID
+		case 1:
+			d.Name = fresh.Name
+		case 2:
+			d.N = fresh.N
+		case 3:
+			d.F = fresh.F
+		case 4:
+			d.Tags = fresh.Tags
+		case 5:
+			d.Attrs = fresh.Attrs
+		case 6:
+			d.Sub = fresh.Sub
+		case 7:
+			d.When = fresh.When
+		case 8:
+			d.Err = fresh.Err
+		case 9:
+			d.M = fresh.M
+		default:
+			d.secret = fresh.secret
+		}
+	}
+	return d
+}
+
+// docCase is an option set and two documents: the same one, a mutation of the first, or two
+// independent ones.
+type docCase struct {
+	o    opts
+	x, y Doc
+	kind string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c docCase) GoString() string {
+	return fmt.Sprintf("%s\nopts %v\nx %s\ny %s", c.kind, c.o, show(c.x), show(c.y))
+}
+
+func sameOf(o opts, docs hegel.Generator[Doc]) hegel.Generator[docCase] {
+	return hegel.Map(docs, func(x Doc) docCase { return docCase{o, x, x, "same"} })
+}
+
+func mutatedOf(o opts, docs hegel.Generator[Doc], lo, hi int) hegel.Generator[docCase] {
+	return hegel.Composite(func(tc hegel.TestCase) docCase {
+		x := hegel.Draw(tc, docs)
+		return docCase{o, x, mutate(x, hegel.Draw(tc, mutationsOf(docs, lo, hi))), "mutated"}
+	})
+}
+
+func otherOf(o opts, docs hegel.Generator[Doc]) hegel.Generator[docCase] {
+	return hegel.Composite(func(tc hegel.TestCase) docCase {
+		return docCase{o, hegel.Draw(tc, docs), hegel.Draw(tc, docs), "other"}
+	})
+}
+
+// optCases: an option set and a pair of documents for it: the same document, a document
+// with one or two fields changed (twice as often), or two independent ones.
+var optCases = hegel.FlatMap(allOpts, func(o opts) hegel.Generator[docCase] {
+	docs := docsOf(o)
+	return hegel.OneOf(sameOf(o, docs), mutatedOf(o, docs, 1, 2), mutatedOf(o, docs, 1, 2), otherOf(o, docs))
+})
+
+// --------------------------------------------------------------------------- the model
+
+type model struct{ o opts }
+
+func (m model) str(a, b string) bool {
+	if m.o.lower {
+		return strings.ToLower(a) == strings.ToLower(b)
+	}
+	return a == b
+}
+
+func (m model) int(a, b int) bool {
+	if m.o.compareMod3 {
+		return a%3 == b%3
+	}
+	return a == b
+}
+
+func (m model) float(a, b float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return m.o.equateNaNs && math.IsNaN(a) && math.IsNaN(b)
+	}
+	if m.o.approx != nil {
+		return math.Abs(a-b) <= math.Max(m.o.approx.margin, m.o.approx.frac*math.Min(math.Abs(a), math.Abs(b)))
+	}
+	return a == b
+}
+
+func (m model) time(a, b time.Time) bool {
+	if m.o.approxTime != nil && !a.IsZero() && !b.IsZero() {
+		d := a.Sub(b)
+		if d < 0 {
+			d = -d
+		}
+		return d <= *m.o.approxTime
+	}
+	return a.Equal(b)
+}
+
+// strList: the documented slice rule (both nil or both non-nil), EquateEmpty, ignored
+// elements dropped on each side, SortSlices, then the remaining elements pairwise.
+func (m model) strList(a, b []string) bool {
+	if a == nil || b == nil {
+		return (a == nil && b == nil) || (m.o.equateEmpty && len(a) == 0 && len(b) == 0)
+	}
+	if m.o.equateEmpty && len(a) == 0 && len(b) == 0 {
+		return true
+	}
+	a, b = m.keep(a), m.keep(b)
+	if m.o.sortSlices {
+		a, b = sortedStrings(a), sortedStrings(b)
+	}
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !m.str(a[i], b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m model) keep(xs []string) []string {
+	var out []string
+	for _, x := range xs {
+		if m.o.ignoresType("string") || (m.o.ignoreSliceEl && strings.HasPrefix(x, "x")) {
+			continue
+		}
+		out = append(out, x)
+	}
+	return out
+}
+
+func sortedStrings(xs []string) []string {
+	ys := append([]string{}, xs...)
+	sort.Strings(ys)
+	return ys
+}
+
+type entry struct {
+	k string
+	v int
+}
+
+func (m model) intMap(a, b map[string]int) bool {
+	if a == nil || b == nil {
+		return (a == nil && b == nil) || (m.o.equateEmpty && len(a) == 0 && len(b) == 0)
+	}
+	if m.o.equateEmpty && len(a) == 0 && len(b) == 0 {
+		return true
+	}
+	if m.o.sortMaps {
+		// The map is flattened to a slice of {K, V} sorted by K; the pairs are then compared
+		// as struct fields, so the string and int rules apply to keys and values.
+		ea, eb := m.entries(a), m.entries(b)
+		if len(ea) != len(eb) {
+			return false
+		}
+		for i := range ea {
+			if !(m.o.ignoresType("string") || m.str(ea[i].k, eb[i].k)) {
+				return false
+			}
+			if !(m.o.ignoresType("int") || m.int(ea[i].v, eb[i].v)) {
+				return false
+			}
+		}
+		return true
+	}
+	union := map[string]bool{}
+	for k := range a {
+		union[k] = true
+	}
+	for k := range b {
+		union[k] = true
+	}
+	for k := range union {
+		if m.o.ignoresType("int") {
+			continue
+		}
+		va, oka := a[k]
+		vb, okb := b[k]
+		if m.o.ignoreMapEnt && ((oka && va < 0) || (okb && vb < 0)) {
+			continue
+		}
+		if !oka || !okb || !m.int(va, vb) {
+			return false
+		}
+	}
+	return true
+}
+
+// entries flattens a map the way SortMaps does, dropping the entries IgnoreMapEntries drops.
+func (m model) entries(a map[string]int) []entry {
+	var es []entry
+	for k, v := range a {
+		if m.o.ignoreMapEnt && v < 0 {
+			continue
+		}
+		es = append(es, entry{k, v})
+	}
+	sort.Slice(es, func(i, j int) bool { return es[i].k < es[j].k })
+	return es
+}
+
+func (m model) err(a, b error) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	if m.o.equateErrors {
+		return errors.Is(a, b) || errors.Is(b, a)
+	}
+	if reflect.TypeOf(a) != reflect.TypeOf(b) {
+		return false
+	}
+	ca, oka := a.(Code)
+	cb, okb := b.(Code)
+	if oka && okb {
+		return m.o.ignoresType("int") || m.int(ca.C, cb.C)
+	}
+	return reflect.DeepEqual(a, b) // AnyError against AnyError
+}
+
+func (m model) sub(a, b *Sub) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	if !(m.o.ignores("Sub.X") || m.o.ignoresType("int") || m.int(a.X, b.X)) {
+		return false
+	}
+	return m.o.ignores("Sub.Names") || m.o.ignoresType("strings") || m.strList(a.Names, b.Names)
+}
+
+func (m model) equal(x, y Doc) bool {
+	o := m.o
+	if !(o.ignores("ID") || o.ignores("Base.ID") || o.ignores("Base") || o.ignoresType("int") || m.int(x.ID, y.ID)) {
+		return false
+	}
+	if !(o.ignores("Name") || o.ignoresType("string") || m.str(x.Name, y.Name)) {
+		return false
+	}
+	if !(o.ignores("N") || o.ignoresType("int") || m.int(x.N, y.N)) {
+		return false
+	}
+	if !(o.ignores("F") || m.float(x.F, y.F)) {
+		return false
+	}
+	if !(o.ignores("Tags") || o.ignoresType("strings") || m.strList(x.Tags, y.Tags)) {
+		return false
+	}
+	if !(o.ignores("Attrs") || m.intMap(x.Attrs, y.Attrs)) {
+		return false
+	}
+	if !(o.ignores("Sub") || o.ignoresType("subptr") || m.sub(x.Sub, y.Sub)) {
+		return false
+	}
+	if !(o.ignores("When") || o.ignoresType("time") || m.time(x.When, y.When)) {
+		return false
+	}
+	if !(o.ignores("Err") || o.ignoreIface || m.err(x.Err, y.Err)) {
+		return false
+	}
+	if !(o.ignores("M") || o.ignoresType("mod") || x.M.V%5 == y.M.V%5) {
+		return false
+	}
+	if o.unexported != "ignore" && !(o.ignores("secret") || o.ignoresType("int") || m.int(x.secret, y.secret)) {
+		return false
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- the shapes
+
+// hasIgnoredEntry reports whether the map has an entry IgnoreMapEntries drops.
+func hasIgnoredEntry(m map[string]int) bool {
+	for _, v := range m {
+		if v < 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// nilAgainstLonger: exactly one side nil and the other with at least two elements (the shape
+// where the SortSlices transform would replace the nil slice).
+func nilAgainstLonger(a, b []string) bool {
+	return (a == nil && len(b) >= 2) || (b == nil && len(a) >= 2)
+}
+
+// sortedNilShape: SortSlices beside an element ignore, and a nil slice against a longer one
+// in Tags or Sub.Names (the shape of go-cmp/2).
+func (c docCase) sortedNilShape() bool {
+	o, x, y := c.o, c.x, c.y
+	if !(o.sortSlices && (o.ignoreSliceEl || o.ignoresType("string"))) {
+		return false
+	}
+	return nilAgainstLonger(x.Tags, y.Tags) || (x.Sub != nil && y.Sub != nil && nilAgainstLonger(x.Sub.Names, y.Sub.Names))
+}
+
+// shapes names the recorded bugs whose shape the case has: SortMaps beside IgnoreMapEntries
+// with an ignored entry in either map (go-cmp/1), SortSlices beside an element ignore with a
+// nil slice against a longer one (go-cmp/2).
+func (c docCase) shapes() []string {
+	var s []string
+	if c.o.sortMaps && c.o.ignoreMapEnt && (hasIgnoredEntry(c.x.Attrs) || hasIgnoredEntry(c.y.Attrs)) {
+		s = append(s, "go-cmp/1")
+	}
+	if c.sortedNilShape() {
+		s = append(s, "go-cmp/2")
+	}
+	return s
+}
+
+// checkModel: cmp.Equal with the case's options agrees with the model on the pair; Equal is
+// symmetric; Diff is empty iff Equal; Equal(x, x) agrees with the model.
+func checkModel(ht *hegel.T, c *collector, p docCase) {
+	o, x, y := p.o, p.x, p.y
+	m := model{o}
+	want := m.equal(x, y)
+	options := o.build()
+	got := cmp.Equal(x, y, options...)
+	if got != want {
+		c.mismatch(ht, p.shapes(), "Equal = %v, model %v\nopts %v\nx %s\ny %s", got, want, o, show(x), show(y))
+		return
+	}
+	if back := cmp.Equal(y, x, options...); back != got {
+		c.fail(ht, "Equal(x, y) = %v but Equal(y, x) = %v\nopts %v\nx %s\ny %s", got, back, o, show(x), show(y))
+	}
+	d := cmp.Diff(x, y, options...)
+	if (d == "") != got {
+		c.fail(ht, "Diff = %q while Equal = %v\nopts %v\nx %s\ny %s", d, got, o, show(x), show(y))
+	}
+	if self := cmp.Equal(x, x, options...); self != m.equal(x, x) {
+		c.fail(ht, "Equal(x, x) = %v, model %v\nopts %v\nx %s", self, m.equal(x, x), o, show(x))
+	}
+}
+
+// TestHegelOptionsFollowTheModel: cmp.Equal with a random combination of options agrees with
+// the documented meaning of each option on a document type; Diff is empty iff Equal; Equal is
+// symmetric. Under HEGEL_NO_KNOWN=1 a nil slice against a longer one with SortSlices beside an
+// element ignore is skipped (go-cmp/2).
+func TestHegelOptionsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, optCases)
+		c.count(p.kind)
+		if Known.sortSlicesNil && p.sortedNilShape() {
+			c.count("skipped nil slice")
+			ht.Assume(false)
+		}
+		checkModel(ht, c, p)
+	})
+}
+
+func show(d Doc) string {
+	sub := "nil"
+	if d.Sub != nil {
+		sub = fmt.Sprintf("&{X:%d Names:%#v}", d.Sub.X, d.Sub.Names)
+	}
+	return fmt.Sprintf("{ID:%d Name:%q N:%d F:%v Tags:%#v Attrs:%v Sub:%s When:%v Err:%v M:%d secret:%d}", d.ID, d.Name, d.N, d.F, d.Tags, d.Attrs, sub, d.When.Format("15:04:05"), d.Err, d.M.V, d.secret)
+}
diff --git a/cmp/hegel_pins_test.go b/cmp/hegel_pins_test.go
new file mode 100644
index 0000000..1fff706
--- /dev/null
+++ b/cmp/hegel_pins_test.go
@@ -0,0 +1,47 @@
+package cmp_test
+
+// One plain test per recorded bug (bugs.toml): each asserts the documented behaviour and fails
+// while the bug exists; target.toml lists them as expected failures.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+)
+
+// go-cmp/1: IgnoreMapEntries has no effect once SortMaps flattens the map, so an entry the
+// discard function drops is compared all the same.
+func TestHegelPinSortMapsIgnoreMapEntries(t *testing.T) {
+	negative := cmpopts.IgnoreMapEntries(func(k string, v int) bool { return v < 0 })
+	sorted := cmpopts.SortMaps(func(a, b string) bool { return a < b })
+	x, y := map[string]int{"a": 1, "b": -1}, map[string]int{"a": 1, "b": -2}
+	if !cmp.Equal(x, y, negative) {
+		t.Fatalf("Equal(%v, %v, IgnoreMapEntries) = false", x, y)
+	}
+	if !cmp.Equal(x, y, negative, sorted) {
+		t.Errorf("Equal(%v, %v, IgnoreMapEntries, SortMaps) = false; the negative entries should be ignored", x, y)
+	}
+	x, y = map[string]int{}, map[string]int{"b": -2}
+	if !cmp.Equal(x, y, negative, sorted) {
+		t.Errorf("Equal(%v, %v, IgnoreMapEntries, SortMaps) = false; the negative entry should be ignored", x, y)
+	}
+}
+
+// go-cmp/2: with SortSlices, a nil slice equals a non-nil slice whose elements are all ignored
+// when that slice is unsorted (the sort transform turns nil into an empty slice) and not when
+// it is already sorted (no transform, the nil rule applies).
+func TestHegelPinSortSlicesNilSlice(t *testing.T) {
+	xs := cmpopts.IgnoreSliceElements(func(s string) bool { return strings.HasPrefix(s, "x") })
+	sorted := cmpopts.SortSlices(func(a, b string) bool { return a < b })
+	var none []string
+	a := cmp.Equal(none, []string{"x1", "x2"}, xs, sorted)
+	b := cmp.Equal(none, []string{"x2", "x1"}, xs, sorted)
+	if a != b {
+		t.Errorf("Equal(nil, [x1 x2]) = %v but Equal(nil, [x2 x1]) = %v with IgnoreSliceElements and SortSlices; the element order must not decide", a, b)
+	}
+	if b {
+		t.Errorf("Equal(nil, [x2 x1], IgnoreSliceElements, SortSlices) = true; a nil slice is documented as unequal to a non-nil one")
+	}
+}
diff --git a/cmp/hegel_reporter_test.go b/cmp/hegel_reporter_test.go
new file mode 100644
index 0000000..2692a1b
--- /dev/null
+++ b/cmp/hegel_reporter_test.go
@@ -0,0 +1,245 @@
+package cmp_test
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+// --------------------------------------------------------------------------- reporter
+
+type report struct {
+	path string
+	res  cmp.Result
+}
+
+// recorder is a cmp.Reporter that records every Report with the path to it, written as the
+// concatenation of the steps' String() forms without the root step.
+type recorder struct {
+	steps   []string
+	reports []report
+}
+
+func (r *recorder) PushStep(ps cmp.PathStep) { r.steps = append(r.steps, ps.String()) }
+func (r *recorder) PopStep()                 { r.steps = r.steps[:len(r.steps)-1] }
+func (r *recorder) Report(res cmp.Result) {
+	r.reports = append(r.reports, report{strings.Join(r.steps[1:], ""), res})
+}
+
+// expectation: the leaves the model expects reported unequal (exact paths), the subtrees in
+// which it expects at least one unequal report (prefixes; slices, whose alignment is the diff
+// algorithm's), and the paths it expects reported as ignored.
+type expectation struct {
+	exact   map[string]bool
+	prefix  map[string]bool
+	ignored map[string]bool
+}
+
+func expected(x, y Doc, ign []string) expectation {
+	e := expectation{map[string]bool{}, map[string]bool{}, map[string]bool{}}
+	has := func(name string) bool {
+		for _, f := range ign {
+			if f == name {
+				return true
+			}
+		}
+		return false
+	}
+	switch {
+	case has("Base"):
+		e.ignored[".Base"] = true
+	case has("ID") || has("Base.ID"):
+		e.ignored[".Base.ID"] = true
+	case x.ID != y.ID:
+		e.exact[".Base.ID"] = true
+	}
+	scalar := func(name string, differ bool) {
+		if has(name) {
+			e.ignored["."+name] = true
+		} else if differ {
+			e.exact["."+name] = true
+		}
+	}
+	scalar("Name", x.Name != y.Name)
+	scalar("N", x.N != y.N)
+	scalar("F", x.F != y.F || math.IsNaN(x.F) || math.IsNaN(y.F))
+	scalar("secret", x.secret != y.secret)
+	scalar("M", x.M.V%5 != y.M.V%5)
+	scalar("When", !x.When.Equal(y.When))
+	list := func(path string, a, b []string) {
+		switch {
+		case a == nil || b == nil:
+			if (a == nil) != (b == nil) {
+				e.exact[path] = true
+			}
+		case !reflect.DeepEqual(a, b):
+			e.prefix[path] = true
+		}
+	}
+	if has("Tags") {
+		e.ignored[".Tags"] = true
+	} else {
+		list(".Tags", x.Tags, y.Tags)
+	}
+	switch {
+	case has("Attrs"):
+		e.ignored[".Attrs"] = true
+	case x.Attrs == nil || y.Attrs == nil:
+		if (x.Attrs == nil) != (y.Attrs == nil) {
+			e.exact[".Attrs"] = true
+		}
+	default:
+		for k, v := range x.Attrs {
+			if w, ok := y.Attrs[k]; !ok || v != w {
+				e.exact[fmt.Sprintf(".Attrs[%q]", k)] = true
+			}
+		}
+		for k := range y.Attrs {
+			if _, ok := x.Attrs[k]; !ok {
+				e.exact[fmt.Sprintf(".Attrs[%q]", k)] = true
+			}
+		}
+	}
+	switch {
+	case has("Sub"):
+		e.ignored[".Sub"] = true
+	case x.Sub == nil || y.Sub == nil:
+		if (x.Sub == nil) != (y.Sub == nil) {
+			e.exact[".Sub"] = true
+		}
+	default:
+		if has("Sub.X") {
+			e.ignored[".Sub*.X"] = true
+		} else if x.Sub.X != y.Sub.X {
+			e.exact[".Sub*.X"] = true
+		}
+		if has("Sub.Names") {
+			e.ignored[".Sub*.Names"] = true
+		} else {
+			list(".Sub*.Names", x.Sub.Names, y.Sub.Names)
+		}
+	}
+	switch {
+	case has("Err"):
+		e.ignored[".Err"] = true
+	case x.Err == nil || y.Err == nil:
+		if (x.Err == nil) != (y.Err == nil) {
+			e.exact[".Err"] = true
+		}
+	case reflect.TypeOf(x.Err) != reflect.TypeOf(y.Err):
+		e.exact[".Err"] = true
+	default:
+		if cx, ok := x.Err.(Code); ok && cx.C != y.Err.(Code).C {
+			e.exact[".Err.(cmp_test.Code).C"] = true
+		}
+	}
+	return e
+}
+
+// reporterCases: the unexported field allowed, one to three fields ignored 40% of the time,
+// and a document against a copy with up to three fields changed, or one time in five against
+// an independent document.
+var (
+	reporterOpts  = hegel.Map(ignoredFields, func(fields []string) opts { return opts{unexported: "allow", ignoreFields: fields} })
+	reporterCases = hegel.FlatMap(reporterOpts, func(o opts) hegel.Generator[docCase] {
+		docs := docsOf(o)
+		return weighted(choice[docCase]{80, mutatedOf(o, docs, 0, 3)}, choice[docCase]{20, otherOf(o, docs)})
+	})
+)
+
+// TestHegelReporterSeesTheDifferences: a Reporter is told of every unequal leaf and of every
+// ignored node, at the documented path; the Equal-method fields report ByMethod and the
+// ignored ones ByIgnore; Equal is true iff no unequal report was made.
+func TestHegelReporterSeesTheDifferences(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, reporterCases)
+		o, x, y := p.o, p.x, p.y
+		c.count(p.kind)
+		e := expected(x, y, o.ignoreFields)
+		r := &recorder{}
+		options := o.build()
+		options = append(options, cmp.Reporter(r))
+		got := cmp.Equal(x, y, options...)
+		want := len(e.exact) == 0 && len(e.prefix) == 0
+		ctx := func() string {
+			var lines []string
+			for _, rp := range r.reports {
+				lines = append(lines, fmt.Sprintf("%s equal=%v ignore=%v method=%v", rp.path, rp.res.Equal(), rp.res.ByIgnore(), rp.res.ByMethod()))
+			}
+			return fmt.Sprintf("ignore %v\nx %s\ny %s\nreports:\n  %s", o.ignoreFields, show(x), show(y), strings.Join(lines, "\n  "))
+		}
+		if got != want {
+			c.fail(ht, "Equal = %v, model %v\n%s", got, want, ctx())
+			return
+		}
+		unequal := map[string]bool{}
+		ignored := map[string]bool{}
+		for _, rp := range r.reports {
+			if rp.res.ByIgnore() {
+				ignored[rp.path] = true
+				if !rp.res.Equal() {
+					c.fail(ht, "ignored report at %s is not Equal\n%s", rp.path, ctx())
+					return
+				}
+			} else if !rp.res.Equal() {
+				unequal[rp.path] = true
+			}
+			if !rp.res.ByIgnore() && (rp.path == ".When" || rp.path == ".M") != rp.res.ByMethod() {
+				c.fail(ht, "report at %s: ByMethod = %v\n%s", rp.path, rp.res.ByMethod(), ctx())
+				return
+			}
+		}
+		if !reflect.DeepEqual(ignored, e.ignored) {
+			c.fail(ht, "ignored paths %v, expected %v\n%s", keysOf(ignored), keysOf(e.ignored), ctx())
+			return
+		}
+		for p := range e.exact {
+			if !unequal[p] {
+				c.fail(ht, "no unequal report at %s\n%s", p, ctx())
+				return
+			}
+		}
+		seen := map[string]bool{}
+		for p := range unequal {
+			if e.exact[p] {
+				continue
+			}
+			ok := false
+			for pre := range e.prefix {
+				if strings.HasPrefix(p, pre) {
+					ok, seen[pre] = true, true
+				}
+			}
+			if !ok {
+				c.fail(ht, "unexpected unequal report at %s\n%s", p, ctx())
+				return
+			}
+		}
+		for pre := range e.prefix {
+			if !seen[pre] {
+				c.fail(ht, "no unequal report under %s\n%s", pre, ctx())
+				return
+			}
+		}
+		if got != (len(unequal) == 0) {
+			c.fail(ht, "Equal = %v with %d unequal reports\n%s", got, len(unequal), ctx())
+		}
+	})
+}
+
+func keysOf(m map[string]bool) []string {
+	var ks []string
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
diff --git a/cmp/hegel_shapes_test.go b/cmp/hegel_shapes_test.go
new file mode 100644
index 0000000..8a20426
--- /dev/null
+++ b/cmp/hegel_shapes_test.go
@@ -0,0 +1,130 @@
+package cmp_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the model of the options (checkModel, the judge of
+// TestHegelOptionsFollowTheModel), so that each bug is found every run; the wide property
+// reaches the shapes at their natural rate. Under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring region the bug does not touch instead (SortMaps without IgnoreMapEntries or
+// IgnoreMapEntries without SortMaps; an empty non-nil slice, or a nil slice against an
+// unsorted slice holding an element that is not ignored) and passes.
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- go-cmp/1
+
+var (
+	keptEntries    = hegel.Maps(hegel.SampledFrom(keys), hegel.Integers(0, 3)).MaxSize(2)
+	ignoredEntries = hegel.Maps(hegel.SampledFrom(keys), hegel.Integers(-2, -1)).MinSize(1).MaxSize(2)
+	// mapsWithIgnored: a map with at least one entry IgnoreMapEntries drops (a negative
+	// value), beside up to two it keeps.
+	mapsWithIgnored = hegel.Composite(func(tc hegel.TestCase) map[string]int {
+		m := map[string]int{}
+		for k, v := range hegel.Draw(tc, keptEntries) {
+			m[k] = v
+		}
+		for k, v := range hegel.Draw(tc, ignoredEntries) {
+			m[k] = v
+		}
+		return m
+	})
+	// anyMaps: nil, empty, or one to three entries of either sign.
+	anyMaps = hegel.OneOf(hegel.Just[map[string]int](nil), hegel.Just(map[string]int{}), hegel.Maps(hegel.SampledFrom(keys), hegel.Integers(-2, 3)).MinSize(1).MaxSize(3))
+	// sortMapsFlags: SortMaps beside IgnoreMapEntries (the shape of go-cmp/1), or under
+	// HEGEL_NO_KNOWN=1 one of the two alone.
+	sortMapsFlags = shaped(hegel.Just([2]bool{true, true}), hegel.SampledFrom([][2]bool{{true, false}, {false, true}}))
+	// sortedMapCases: the unexported field ignored, the sort and entry-ignore flags, and
+	// EquateEmpty, the lower-casing Transformer (which reaches the flattened keys) and the
+	// mod-3 Comparer (the flattened values) at random; one document holds a map with an
+	// ignored entry, the other any map.
+	sortedMapCases = hegel.Composite(func(tc hegel.TestCase) docCase {
+		flags := hegel.Draw(tc, sortMapsFlags)
+		o := opts{
+			unexported:   "ignore",
+			sortMaps:     flags[0],
+			ignoreMapEnt: flags[1],
+			equateEmpty:  hegel.Draw(tc, chance(30)),
+			lower:        hegel.Draw(tc, chance(30)),
+			compareMod3:  hegel.Draw(tc, chance(30)),
+		}
+		x := Doc{Attrs: hegel.Draw(tc, mapsWithIgnored)}
+		y := Doc{Attrs: hegel.Draw(tc, anyMaps)}
+		return docCase{o, x, y, "sorted map"}
+	})
+)
+
+// TestHegelSortMapsKeepsIgnoredEntriesIgnored: with SortMaps beside IgnoreMapEntries, the
+// entries the discard function drops play no part in Equal, as they do without SortMaps;
+// the library compares them once the map is flattened (go-cmp/1). HEGEL_NO_KNOWN=1 draws one
+// of the two options alone.
+func TestHegelSortMapsKeepsIgnoredEntriesIgnored(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkModel(ht, c, hegel.Draw(ht, sortedMapCases))
+	})
+}
+
+// --------------------------------------------------------------------------- go-cmp/2
+
+var (
+	ignoredWords = hegel.SampledFrom([]string{"x1", "x2", "x3"})
+	// ignoredLists: one to four elements the element ignore drops (prefix "x").
+	ignoredLists = many(ignoredWords, 1, 4)
+	// mixedLists: two to four elements, at least one of which is kept.
+	mixedLists = hegel.Composite(func(tc hegel.TestCase) []string {
+		return append(hegel.Draw(tc, many(ignoredWords, 1, 3)), hegel.Draw(tc, hegel.SampledFrom([]string{"a", "b"})))
+	})
+	// elementIgnores: the option that drops the elements, IgnoreSliceElements or
+	// IgnoreTypes(""), which has the same effect on a []string.
+	elementIgnores = hegel.SampledFrom([]string{"elements", "strings"})
+	// sortedSlicePairs: a nil slice against a non-nil slice of ignored elements (the shape of
+	// go-cmp/2); under HEGEL_NO_KNOWN=1 an empty non-nil slice against one, or a nil slice
+	// against a slice holding a kept element.
+	sortedSlicePairs = shaped(
+		hegel.Map(ignoredLists, func(ys []string) [2][]string { return [2][]string{nil, ys} }),
+		hegel.OneOf(
+			hegel.Map(ignoredLists, func(ys []string) [2][]string { return [2][]string{{}, ys} }),
+			hegel.Map(mixedLists, func(ys []string) [2][]string { return [2][]string{nil, ys} }),
+		),
+	)
+	// sortedSliceCases: SortSlices and an element ignore, with EquateEmpty and EquateNaNs
+	// (which chooses the less or the compare form of the sort) at random, on a pair of Tags
+	// or of Sub.Names.
+	sortedSliceCases = hegel.Composite(func(tc hegel.TestCase) docCase {
+		o := opts{
+			unexported:  "ignore",
+			sortSlices:  true,
+			equateEmpty: hegel.Draw(tc, chance(30)),
+			equateNaNs:  hegel.Draw(tc, chance(50)),
+		}
+		if hegel.Draw(tc, elementIgnores) == "elements" {
+			o.ignoreSliceEl = true
+		} else {
+			o.ignoreTypes = []string{"string"}
+		}
+		pair := hegel.Draw(tc, sortedSlicePairs)
+		var x, y Doc
+		if hegel.Draw(tc, hegel.SampledFrom([]string{"Tags", "Sub.Names"})) == "Tags" {
+			x.Tags, y.Tags = pair[0], pair[1]
+		} else {
+			x.Sub, y.Sub = &Sub{Names: pair[0]}, &Sub{Names: pair[1]}
+		}
+		return docCase{o, x, y, "sorted slice"}
+	})
+)
+
+// TestHegelSortSlicesKeepsNilUnequalToNonNil: with SortSlices and an element ignore, a nil
+// slice is unequal to a non-nil slice whose elements are all ignored, whatever the order of
+// that slice (the documented rule: slices are equal if both nil or both non-nil); the library
+// equates them when the slice is unsorted, since the sort transform turns nil into an empty
+// slice (go-cmp/2). HEGEL_NO_KNOWN=1 draws an empty non-nil slice, or a slice with a kept
+// element, instead.
+func TestHegelSortSlicesKeepsNilUnequalToNonNil(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkModel(ht, c, hegel.Draw(ht, sortedSliceCases))
+	})
+}
diff --git a/cmp/hegel_test.go b/cmp/hegel_test.go
new file mode 100644
index 0000000..16c0495
--- /dev/null
+++ b/cmp/hegel_test.go
@@ -0,0 +1,237 @@
+package cmp_test
+
+// Hegel property tests for google/go-cmp, written for the Hegel zoo.
+// See targets/go/go-cmp/README.md.
+//
+// Oracles: reflect.DeepEqual for values without unexported fields, Equal methods or cycles
+// (the package documents no difference there); the documented meaning of each cmpopts option
+// and of the Equal-method rule, restated as a model over one fixed document type; the
+// documented contract between Equal and Diff (Diff is empty iff Equal) and between Equal and a
+// Reporter (the unequal leaves reported are the leaves that differ); the documented panics on
+// misuse.
+//
+// Every property draws one case from a generator value built from the binding's combinators
+// (a value tree, a document and its mutations, an option record, an edit list, a selector as
+// segments) and pure functions render the case into what the library and the oracle see. The
+// shapes of the recorded bugs (bugs.toml) are drawn at their natural rate, so the properties
+// that meet them fail naming the shape and are the expected failures mapped to the bugs
+// (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over its shape region
+// alone, and hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 (noKnown, below)
+// switches the known shapes off for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing and print the class counts.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the shape of the recorded
+// bugs named (none for a plain failure): the failure names the shape. Under HEGEL_NO_KNOWN=1
+// the generators leave the shapes out, so a shape that is still met is skipped there.
+func (c *collector) mismatch(ht *hegel.T, shape []string, format string, args ...any) {
+	if len(shape) > 0 {
+		c.count("shape " + strings.Join(shape, "+"))
+		ht.Assume(!noKnown)
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	c.fail(ht, format, args...)
+}
+
+// catch runs f and returns the value it panicked with, or nil.
+func catch(f func()) (r any) {
+	defer func() { r = recover() }()
+	f()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape; under HEGEL_NO_KNOWN=1 the switches of Known are on and the shapes are left out.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of the recorded bugs; on means the shape is left out, which is
+// so only under HEGEL_NO_KNOWN=1. The pins assert the correct behaviour and fail while a bug
+// is open, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	// go-cmp/1: IgnoreMapEntries has no effect on a map SortMaps flattens (the flattened
+	// entries carry no MapIndex step). On, the option generator does not combine the two.
+	sortMapsIgnoreEntries bool
+	// go-cmp/2: with SortSlices, a nil slice equals a non-nil slice whose elements are all
+	// ignored when that slice is unsorted (the transform turns nil into an empty slice) and not
+	// when it is sorted. On, the model property skips a nil slice against a longer one when
+	// SortSlices and an element ignore are both in force.
+	sortSlicesNil bool
+}{
+	sortMapsIgnoreEntries: noKnown,
+	sortSlicesNil:         noKnown,
+}
+
+// shaped is the generator of a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, of the
+// neighbouring region past it.
+func shaped[T any](known, past hegel.Generator[T]) hegel.Generator[T] {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string {
+	if noKnown {
+		return nil
+	}
+	return []string{id}
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements (nil when lo is 0 and no element is drawn).
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// asAny widens a generator's values to any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
