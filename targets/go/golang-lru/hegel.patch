+// TestHegelConcurrent: the thread-safe caches under concurrent Add/Get/Remove keep Len at
+// or below the size and consistent with Keys, and every callback names a key that has been
+// added.
+func TestHegelConcurrent(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		size := drawInt(ht, 1, 8)
+		var mu sync.Mutex
+		var evicted []kv
+		kind := pick(ht, []string{"lru.Cache", "expirable", "2Q"})
+		var add func(k, v int)
+		var lenKeys func() (int, []int)
+		switch kind {
+		case "lru.Cache":
+			c, _ := lru.NewWithEvict[int, int](size, func(k, v int) {
+				mu.Lock()
+				evicted = append(evicted, kv{k, v})
+				mu.Unlock()
+			})
+			add = func(k, v int) { c.Add(k, v); c.Get(k - 1); c.Peek(k + 1); c.Contains(k) }
+			lenKeys = func() (int, []int) { return c.Len(), c.Keys() }
+		case "expirable":
+			c := expirable.NewLRU[int, int](size, func(k, v int) {
+				mu.Lock()
+				evicted = append(evicted, kv{k, v})
+				mu.Unlock()
+			}, 0)
+			add = func(k, v int) { c.Add(k, v); c.Get(k - 1); c.Peek(k + 1); c.Contains(k) }
+			lenKeys = func() (int, []int) { return c.Len(), c.Keys() }
+		default:
+			if size < 2 {
+				size = 2
+			}
+			c, _ := lru.New2Q[int, int](size)
+			add = func(k, v int) { c.Add(k, v); c.Get(k - 1); c.Peek(k + 1); c.Contains(k) }
+			lenKeys = func() (int, []int) { return c.Len(), c.Keys() }
+		}
+		workers := drawInt(ht, 2, 4)
+		per := drawInt(ht, 1, 30)
+		var wg sync.WaitGroup
+		for w := 0; w < workers; w++ {
+			wg.Add(1)
+			go func(w int) {
+				defer wg.Done()
+				for i := 0; i < per; i++ {
+					add(w*100+i%(size+2), i)
+				}
+			}(w)
+		}
+		wg.Wait()
+		n, ks := lenKeys()
+		if n != len(ks) || n > size {
+			col.failClass(ht, "Len", "%s size %d: Len %d, Keys %v", kind, size, n, ks)
+		}
+		mu.Lock()
+		for _, e := range evicted {
+			if e.k < 0 || e.k >= workers*100+size+2 {
+				col.failClass(ht, "Callback", "%s: callback for an unknown key %v", kind, e)
+			}
+		}
+		mu.Unlock()
+	})
+}
+
+// TestHegelExpiry: expirable.LRU with a real TTL: entries older than the TTL are hidden by
+// Get, Peek, Keys and Values, entries refreshed by Add within the TTL survive, and after two
+// TTLs the cache is empty and every entry has been reported to the callback exactly once.
+// Few cases, since each sleeps for three TTLs.
+func TestHegelExpiry(t *testing.T) {
+	col := newCollector(t)
+	// 4 cases; HEGEL_TEST_CASES raises that to at most 8 (each case sleeps for three TTLs)
+	cases := 4
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > cases {
+			cases = 8
+		}
+	}
+	opts := []hegel.Option{hegel.WithTestCases(cases)}
+	hegel.Test(t, func(ht *hegel.T) {
+		const ttl = 200 * time.Millisecond
+		size := 0
+		if chance(ht, 50) {
+			size = drawInt(ht, 2, 6)
+		}
+		var mu sync.Mutex
+		evicted := map[int]int{}
+		c := expirable.NewLRU[int, int](size, func(k, v int) {
+			mu.Lock()
+			evicted[k]++
+			mu.Unlock()
+		}, ttl)
+		defer c.Close()
+		n := drawInt(ht, 1, 4)
+		if size > 0 && n > size {
+			n = size
+		}
+		for k := 0; k < n; k++ {
+			c.Add(k, k)
+		}
+		renew := drawInt(ht, 0, n)
+		time.Sleep(ttl / 2)
+		for k := n - renew; k < n; k++ {
+			c.Add(k, k+100)
+		}
+		// t = ttl + 40ms: the first batch (not renewed) has expired, the renewed keys have
+		// half a TTL left
+		time.Sleep(ttl/2 + 40*time.Millisecond)
+		keys := c.Keys()
+		for k := 0; k < n-renew; k++ {
+			if _, ok := c.Get(k); ok {
+				col.failClass(ht, "GetExpired", "size %d, %d keys, %d renewed: Get(%d) still ok after the TTL", size, n, renew, k)
+			}
+			if _, ok := c.Peek(k); ok {
+				col.failClass(ht, "PeekExpired", "size %d, %d keys, %d renewed: Peek(%d) still ok after the TTL", size, n, renew, k)
+			}
+			for _, kk := range keys {
+				if kk == k {
+					col.failClass(ht, "KeysExpired", "size %d, %d keys, %d renewed: Keys %v lists the expired %d", size, n, renew, keys, k)
+				}
+			}
+		}
+		for k := n - renew; k < n; k++ {
+			if v, ok := c.Get(k); !ok || v != k+100 {
+				col.failClass(ht, "GetRenewed", "size %d, %d keys, %d renewed: Get(%d) = %d, %v within the renewed TTL", size, n, renew, k, v, ok)
+			}
+		}
+		if len(c.Values()) != len(c.Keys()) {
+			col.failClass(ht, "ValuesKeys", "Values %v vs Keys %v", c.Values(), c.Keys())
+		}
+		if !Known.expiredVisibleAfterClose {
+			// a closed cache still hides expired entries (golang-lru/3 says otherwise)
+			c.Close()
+			for k := 0; k < n-renew; k++ {
+				if _, ok := c.Get(k); ok {
+					col.failClass(ht, "GetExpiredClosed", "size %d, %d keys, %d renewed: Get(%d) ok after Close", size, n, renew, k)
+				}
+			}
+			return
+		}
+		time.Sleep(2*ttl + 40*time.Millisecond)
+		if c.Len() != 0 || len(c.Keys()) != 0 {
+			col.failClass(ht, "NotEmpty", "size %d, %d keys, %d renewed: Len %d Keys %v three TTLs after the last Add", size, n, renew, c.Len(), c.Keys())
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		for k := 0; k < n; k++ {
+			if evicted[k] != 1 {
+				col.failClass(ht, "CallbackCount", "size %d, %d keys, %d renewed: key %d reported %d times", size, n, renew, k, evicted[k])
+			}
+		}
+	}, opts...)
+}
