diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..32fe58a
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,282 @@
+package hegel
+
+// The model: an LRU cache as an ordered list of (key, value) pairs, oldest first, a size (0
+// means unlimited, as expirable.NewLRU documents) and a log of the evictions in order; the 2Q
+// cache as the published algorithm over three such lists.
+
+import (
+	"cmp"
+	"fmt"
+	"slices"
+)
+
+type kv struct{ k, v int }
+
+func (p kv) String() string { return fmt.Sprintf("%d:%d", p.k, p.v) }
+
+// lruModel is the reference LRU.
+type lruModel struct {
+	size    int  // 0 = unlimited
+	ents    []kv // oldest first
+	evicted []kv // every entry removed by eviction, Remove, RemoveOldest, Resize or Purge
+}
+
+func newModel(size int) *lruModel { return &lruModel{size: size} }
+
+func (m *lruModel) find(k int) int {
+	for i, e := range m.ents {
+		if e.k == k {
+			return i
+		}
+	}
+	return -1
+}
+
+func (m *lruModel) drop(i int) kv {
+	e := m.ents[i]
+	m.ents = append(m.ents[:i:i], m.ents[i+1:]...)
+	m.evicted = append(m.evicted, e)
+	return e
+}
+
+// add: an existing key is refreshed (moved to newest) and its value replaced, no eviction; a
+// new key is appended and, if the size is exceeded, the oldest entry is evicted.
+func (m *lruModel) add(k, v int) bool {
+	if i := m.find(k); i >= 0 {
+		m.ents = append(m.ents[:i:i], m.ents[i+1:]...)
+		m.ents = append(m.ents, kv{k, v})
+		return false
+	}
+	m.ents = append(m.ents, kv{k, v})
+	if m.size > 0 && len(m.ents) > m.size {
+		m.drop(0)
+		return true
+	}
+	return false
+}
+
+func (m *lruModel) get(k int) (int, bool) {
+	i := m.find(k)
+	if i < 0 {
+		return 0, false
+	}
+	e := m.ents[i]
+	m.ents = append(m.ents[:i:i], m.ents[i+1:]...)
+	m.ents = append(m.ents, e)
+	return e.v, true
+}
+
+func (m *lruModel) peek(k int) (int, bool) {
+	if i := m.find(k); i >= 0 {
+		return m.ents[i].v, true
+	}
+	return 0, false
+}
+
+func (m *lruModel) contains(k int) bool { return m.find(k) >= 0 }
+
+func (m *lruModel) remove(k int) bool {
+	if i := m.find(k); i >= 0 {
+		m.drop(i)
+		return true
+	}
+	return false
+}
+
+func (m *lruModel) removeOldest() (int, int, bool) {
+	if len(m.ents) == 0 {
+		return 0, 0, false
+	}
+	e := m.drop(0)
+	return e.k, e.v, true
+}
+
+func (m *lruModel) getOldest() (int, int, bool) {
+	if len(m.ents) == 0 {
+		return 0, 0, false
+	}
+	return m.ents[0].k, m.ents[0].v, true
+}
+
+// purge evicts everything; the order of the callbacks is the map's, so the log is compared as
+// a multiset for this operation.
+func (m *lruModel) purge() {
+	for len(m.ents) > 0 {
+		m.drop(0)
+	}
+}
+
+// resize evicts the oldest entries beyond the new size and returns how many; a size of 0
+// makes the model unlimited (the documented meaning for expirable.LRU; the other caches are
+// never resized to 0 or below by the properties, see golang-lru/1).
+func (m *lruModel) resize(size int) int {
+	n := 0
+	if size > 0 {
+		for len(m.ents) > size {
+			m.drop(0)
+			n++
+		}
+	}
+	m.size = size
+	return n
+}
+
+func (m *lruModel) keys() []int {
+	ks := make([]int, len(m.ents))
+	for i, e := range m.ents {
+		ks[i] = e.k
+	}
+	return ks
+}
+
+func (m *lruModel) values() []int {
+	vs := make([]int, len(m.ents))
+	for i, e := range m.ents {
+		vs[i] = e.v
+	}
+	return vs
+}
+
+func (m *lruModel) length() int { return len(m.ents) }
+
+// --------------------------------------------------------------------------- 2Q
+
+// twoQModel mirrors TwoQueueCache: a recent list (entries seen once), a frequent list
+// (entries seen twice), a ghost list of keys recently evicted from recent; the total of
+// recent and frequent is bounded by size, recent is kept at or below size*recentRatio when
+// space is needed, the ghost list holds size*ghostRatio keys.
+type twoQModel struct {
+	size, recentSize        int
+	recentRatio, ghostRatio float64
+	recent, frequent, ghost *lruModel
+}
+
+func newTwoQModel(size int, recentRatio, ghostRatio float64) *twoQModel {
+	return &twoQModel{
+		size: size, recentSize: int(float64(size) * recentRatio),
+		recentRatio: recentRatio, ghostRatio: ghostRatio,
+		recent: newModel(size), frequent: newModel(size),
+		ghost: newModel(int(float64(size) * ghostRatio)),
+	}
+}
+
+// ghostAdd: a ghost list resized to 0 keeps nothing (see the model's resize; the real store
+// evicts the key it has just added).
+func (q *twoQModel) ghostAdd(k int) {
+	if q.ghost.size <= 0 {
+		return
+	}
+	q.ghost.add(k, 0)
+}
+
+func (q *twoQModel) get(k int) (int, bool) {
+	if v, ok := q.frequent.get(k); ok {
+		return v, true
+	}
+	if v, ok := q.recent.peek(k); ok {
+		q.recent.remove(k)
+		q.frequent.add(k, v)
+		return v, true
+	}
+	return 0, false
+}
+
+func (q *twoQModel) add(k, v int) {
+	if q.frequent.contains(k) {
+		q.frequent.add(k, v)
+		return
+	}
+	if q.recent.contains(k) {
+		q.recent.remove(k)
+		q.frequent.add(k, v)
+		return
+	}
+	if q.ghost.contains(k) {
+		q.ensureSpace(true)
+		q.ghost.remove(k)
+		q.frequent.add(k, v)
+		return
+	}
+	q.ensureSpace(false)
+	q.recent.add(k, v)
+}
+
+func (q *twoQModel) ensureSpace(recentEvict bool) {
+	rl, fl := q.recent.length(), q.frequent.length()
+	if rl+fl < q.size {
+		return
+	}
+	if rl > 0 && (rl > q.recentSize || (rl == q.recentSize && !recentEvict)) {
+		k, _, _ := q.recent.removeOldest()
+		q.ghostAdd(k)
+		return
+	}
+	q.frequent.removeOldest()
+}
+
+func (q *twoQModel) resize(size int) int {
+	q.size = size
+	q.recentSize = int(float64(size) * q.recentRatio)
+	diff := q.recent.length() + q.frequent.length() - size
+	if diff < 0 {
+		diff = 0
+	}
+	for i := 0; i < diff; i++ {
+		q.ensureSpace(true)
+	}
+	q.recent.resize(size)
+	q.frequent.resize(size)
+	// the ghost list's Resize(0) evicts everything and keeps nothing afterwards
+	es := int(float64(size) * q.ghostRatio)
+	if es <= 0 {
+		q.ghost.purge()
+		q.ghost.size = 0
+	} else {
+		q.ghost.resize(es)
+	}
+	return diff
+}
+
+func (q *twoQModel) remove(k int) {
+	if q.frequent.remove(k) {
+		return
+	}
+	if q.recent.remove(k) {
+		return
+	}
+	q.ghost.remove(k)
+}
+
+func (q *twoQModel) purge() {
+	q.recent.purge()
+	q.frequent.purge()
+	q.ghost.purge()
+}
+
+func (q *twoQModel) contains(k int) bool { return q.frequent.contains(k) || q.recent.contains(k) }
+
+func (q *twoQModel) peek(k int) (int, bool) {
+	if v, ok := q.frequent.peek(k); ok {
+		return v, true
+	}
+	return q.recent.peek(k)
+}
+
+func (q *twoQModel) keys() []int   { return append(q.frequent.keys(), q.recent.keys()...) }
+func (q *twoQModel) values() []int { return append(q.frequent.values(), q.recent.values()...) }
+func (q *twoQModel) length() int   { return q.recent.length() + q.frequent.length() }
+
+// --------------------------------------------------------------------------- helpers
+
+// sortedKV orders an eviction log by key, then value: Purge's callbacks come in map order, so
+// its log is compared as a multiset.
+func sortedKV(xs []kv) []kv {
+	ys := slices.Clone(xs)
+	slices.SortFunc(ys, func(a, b kv) int {
+		if a.k != b.k {
+			return cmp.Compare(a.k, b.k)
+		}
+		return cmp.Compare(a.v, b.v)
+	})
+	return ys
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..6059ee2
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,97 @@
+package hegel
+
+// Pins: one plain test per recorded bug (bugs.toml), asserting the documented behaviour.
+// Each fails while the bug exists and is listed in target.toml's [expected_failures].
+
+import (
+	"testing"
+	"time"
+
+	lru "github.com/hashicorp/golang-lru/v2"
+	"github.com/hashicorp/golang-lru/v2/expirable"
+	"github.com/hashicorp/golang-lru/v2/simplelru"
+)
+
+// golang-lru/1: the constructors refuse a size at or below zero, Resize does not: a cache
+// resized to 0 evicts every key as it is added (Add returns true and the callback fires for
+// the key just added), and Resize(-3) of an empty cache reports 3 evictions.
+func TestHegelPinResizeNonPositive(t *testing.T) {
+	var evicted []int
+	c, _ := simplelru.NewLRU[int, int](3, func(k, v int) { evicted = append(evicted, k) })
+	c.Add(1, 1)
+	c.Resize(0)
+	evicted = nil
+	if ev := c.Add(2, 2); ev || !c.Contains(2) || len(evicted) != 0 {
+		t.Errorf("after Resize(0): Add(2) evicted %v, Contains(2) %v, callbacks %v; Cap %d", ev, c.Contains(2), evicted, c.Cap())
+	}
+	if n := c.Resize(-3); n != 0 || c.Cap() < 1 {
+		t.Errorf("Resize(-3) of a cache holding %d keys: %d evictions, Cap %d", c.Len(), n, c.Cap())
+	}
+	w, _ := lru.New[int, int](3)
+	w.Resize(0)
+	if ev := w.Add(2, 2); ev || !w.Contains(2) {
+		t.Errorf("lru.Cache after Resize(0): Add(2) evicted %v, Contains(2) %v", ev, w.Contains(2))
+	}
+}
+
+// golang-lru/2: New2QParams documents size > 0 and ratios within [0, 1] as valid, but a
+// ghost ratio that rounds the ghost list's size to zero (ghost ratio 0, or New2Q(1) with the
+// default 0.5) fails with the inner LRU's "must provide a positive size".
+func TestHegelPinTwoQueueSmallGhost(t *testing.T) {
+	if _, err := lru.New2Q[int, int](1); err != nil {
+		t.Errorf("New2Q(1): %v", err)
+	}
+	if _, err := lru.New2QParams[int, int](10, 0.25, 0); err != nil {
+		t.Errorf("New2QParams(10, 0.25, 0): %v", err)
+	}
+}
+
+// golang-lru/3: after Close (documented as destroying the cleanup goroutine), expired entries
+// are returned by Get, Peek, Keys and Values as if they were live.
+func TestHegelPinExpiredAfterClose(t *testing.T) {
+	c := expirable.NewLRU[int, int](0, nil, 50*time.Millisecond)
+	c.Close()
+	c.Add(1, 1)
+	time.Sleep(80 * time.Millisecond)
+	if v, ok := c.Get(1); ok {
+		t.Errorf("Get(1) = %d, true 80ms after adding with a 50ms TTL (cache closed); Keys %v", v, c.Keys())
+	}
+}
+
+// golang-lru/4: simplelru.LRU.Purge calls the eviction callback before removing the entry,
+// unlike Remove, RemoveOldest, Resize and Add: the callback still finds the key in the
+// cache, and removing it from there reports the eviction twice.
+func TestHegelPinPurgeCallbackAfterRemoval(t *testing.T) {
+	var c *simplelru.LRU[int, int]
+	var seen []int
+	var present []int
+	c, _ = simplelru.NewLRU[int, int](3, func(k, v int) {
+		seen = append(seen, k)
+		if c.Contains(k) {
+			present = append(present, k)
+		}
+	})
+	c.Add(1, 1)
+	c.Add(2, 2)
+	c.Purge()
+	if len(present) > 0 || len(seen) != 2 {
+		t.Errorf("Purge: callbacks for %v, the key still present for %v", seen, present)
+	}
+}
+
+// golang-lru/5: TwoQueueCache is "a thread-safe fixed size 2Q cache", but with a recent ratio
+// of 1 (documented valid) it holds size+1 entries: when the recent list is full and the
+// frequent list empty, re-adding a key that is in the ghost list evicts nothing (ensureSpace
+// asks the empty frequent list) and adds to frequent.
+func TestHegelPinTwoQueueFixedSize(t *testing.T) {
+	q, err := lru.New2QParams[int, int](2, 1, 0.5)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, k := range []int{2, 0, 1, 2} {
+		q.Add(k, k)
+	}
+	if q.Len() > q.Cap() {
+		t.Errorf("after Add(2), Add(0), Add(1), Add(2): Len %d above the size %d; Keys %v", q.Len(), q.Cap(), q.Keys())
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..453ac81
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,773 @@
+package hegel
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"slices"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	lru "github.com/hashicorp/golang-lru/v2"
+	"github.com/hashicorp/golang-lru/v2/expirable"
+	"github.com/hashicorp/golang-lru/v2/simplelru"
+)
+
+// cache is the interface shared by simplelru.LRU, lru.Cache and expirable.LRU.
+type cache interface {
+	Add(k, v int) bool
+	Get(k int) (int, bool)
+	Contains(k int) bool
+	Peek(k int) (int, bool)
+	Remove(k int) bool
+	RemoveOldest() (int, int, bool)
+	GetOldest() (int, int, bool)
+	Keys() []int
+	Values() []int
+	Len() int
+	Cap() int
+	Purge()
+	Resize(int) int
+}
+
+// evictLog records the eviction callbacks and checks, from inside the callback, that the
+// evicted key is no longer in the cache.
+type evictLog struct {
+	c       cache
+	log     []kv
+	reentry bool // Contains may be called from the callback (thread-safe caches: outside the lock)
+	stillIn []kv
+}
+
+func (l *evictLog) cb(k, v int) {
+	l.log = append(l.log, kv{k, v})
+	if l.reentry && l.c != nil && l.c.Contains(k) {
+		l.stillIn = append(l.stillIn, kv{k, v})
+	}
+}
+
+type flavour struct {
+	name string
+	// make builds a cache of the size with the callback (nil when withCB is false); size 0 is
+	// allowed only for expirable (unlimited).
+	make func(size int, cb func(k, v int)) cache
+	// resizeZero: Resize(0) means unlimited (expirable) rather than being refused
+	resizeZero bool
+	extra      bool // ContainsOrAdd / PeekOrAdd (lru.Cache)
+	reentry    bool // callbacks run outside the lock
+}
+
+var flavours = []flavour{
+	{name: "simplelru", make: func(size int, cb func(k, v int)) cache {
+		c, err := simplelru.NewLRU[int, int](size, cb)
+		if err != nil {
+			panic(err)
+		}
+		return c
+	}, reentry: true},
+	{name: "lru.Cache", make: func(size int, cb func(k, v int)) cache {
+		c, err := lru.NewWithEvict[int, int](size, cb)
+		if err != nil {
+			panic(err)
+		}
+		return c
+	}, extra: true, reentry: true},
+	{name: "expirable", make: func(size int, cb func(k, v int)) cache {
+		return expirable.NewLRU[int, int](size, cb, 0)
+	}, resizeZero: true, reentry: true},
+}
+
+// --------------------------------------------------------------------------- a case as data
+
+const keySpace = 8 // keys are 0..keySpace-1 so that sequences revisit them
+
+var (
+	keys   = hegel.Integers(0, keySpace-1)
+	values = hegel.Integers(0, 1000)
+)
+
+// opKind is what a step does; the reads come first so that a shrunk script is quiet.
+type opKind int
+
+const (
+	opContains opKind = iota
+	opPeek
+	opGet
+	opGetOldest
+	opAdd
+	opRemove
+	opRemoveOldest
+	opPurge
+	opResize
+	opContainsOrAdd // lru.Cache only
+	opPeekOrAdd     // lru.Cache only
+)
+
+var opNames = [...]string{"Contains", "Peek", "Get", "GetOldest", "Add", "Remove", "RemoveOldest", "Purge", "Resize", "ContainsOrAdd", "PeekOrAdd"}
+
+func (k opKind) String() string { return opNames[k] }
+
+// op is one step of a sequence; only the fields its kind uses are drawn.
+type op struct {
+	kind opKind
+	k, v int
+	n    int // Resize target
+}
+
+func (o op) String() string {
+	switch o.kind {
+	case opAdd, opContainsOrAdd, opPeekOrAdd:
+		return fmt.Sprintf("%s(%d, %d)", o.kind, o.k, o.v)
+	case opResize:
+		return fmt.Sprintf("Resize(%d)", o.n)
+	case opPurge, opRemoveOldest, opGetOldest:
+		return o.kind.String() + "()"
+	}
+	return fmt.Sprintf("%s(%d)", o.kind, o.k)
+}
+
+// bare is an op of the kind with no arguments; keyed one on a key; keyedValued one on a key
+// and a value; resizes a Resize to one of the sizes.
+func bare(kind opKind) hegel.Generator[op] { return hegel.Just(op{kind: kind}) }
+
+func keyed(kind opKind) hegel.Generator[op] {
+	return hegel.Map(keys, func(k int) op { return op{kind: kind, k: k} })
+}
+
+func keyedValued(kind opKind) hegel.Generator[op] {
+	return hegel.Composite(func(tc hegel.TestCase) op {
+		return op{kind: kind, k: hegel.Draw(tc, keys), v: hegel.Draw(tc, values)}
+	})
+}
+
+func resizes(sizes hegel.Generator[int]) hegel.Generator[op] {
+	return hegel.Map(sizes, func(n int) op { return op{kind: opResize, n: n} })
+}
+
+// lruOps: the steps of an LRU sequence, Add most often (it builds the state), Purge rarely
+// (it empties it); lru.Cache adds ContainsOrAdd and PeekOrAdd, and only the expirable cache
+// is resized to 0 (unlimited; golang-lru/1 for the others).
+func lruOps(f flavour) hegel.Generator[op] {
+	newSizes := hegel.Integers(1, 8)
+	if f.resizeZero {
+		newSizes = weighted(choice[int]{70, hegel.Integers(1, 8)}, choice[int]{30, hegel.Just(0)})
+	}
+	choices := []choice[op]{
+		{10, keyed(opContains)},
+		{10, keyed(opPeek)},
+		{10, keyed(opGet)},
+		{10, bare(opGetOldest)},
+		{37, keyedValued(opAdd)},
+		{10, keyed(opRemove)},
+		{10, bare(opRemoveOldest)},
+		{3, bare(opPurge)},
+		{10, resizes(newSizes)},
+	}
+	if f.extra {
+		choices = append(choices, choice[op]{10, keyedValued(opContainsOrAdd)}, choice[op]{10, keyedValued(opPeekOrAdd)})
+	}
+	return weighted(choices...)
+}
+
+// cacheSizes: 1 to 6, with the smallest two favoured; the expirable cache is also unlimited
+// (size 0) a quarter of the time.
+var cacheSizes = weighted(choice[int]{80, hegel.Integers(1, 6)}, choice[int]{20, hegel.Integers(1, 2)})
+
+func sizesFor(f flavour) hegel.Generator[int] {
+	if f.resizeZero {
+		return weighted(choice[int]{75, cacheSizes}, choice[int]{25, hegel.Just(0)})
+	}
+	return cacheSizes
+}
+
+// lruCase: one of the three LRU flavours, its size, whether an eviction callback is
+// installed, and the sequence applied.
+type lruCase struct {
+	flavour flavour
+	size    int
+	withCB  bool
+	ops     []op
+}
+
+var lruCases = hegel.Composite(func(tc hegel.TestCase) lruCase {
+	f := hegel.Draw(tc, hegel.SampledFrom(flavours))
+	return lruCase{
+		flavour: f,
+		size:    hegel.Draw(tc, sizesFor(f)),
+		withCB:  hegel.Draw(tc, chance(75)),
+		ops:     hegel.Draw(tc, hegel.Lists(lruOps(f)).MaxSize(40)),
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c lruCase) GoString() string {
+	cb := ""
+	if c.withCB {
+		cb = ", eviction callback"
+	}
+	return fmt.Sprintf("%s size %d%s: %v", c.flavour.name, c.size, cb, c.ops)
+}
+
+// TestHegelLRU: the three LRU caches against the model under random operation sequences,
+// compared after every step (Len, Cap, Keys, Values, Contains, Peek, GetOldest, the result
+// of the operation and the eviction callbacks in order).
+func TestHegelLRU(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, lruCases)
+		f, size := tcase.flavour, tcase.size
+		l := &evictLog{reentry: f.reentry}
+		var cb func(k, v int)
+		if tcase.withCB {
+			cb = l.cb
+		}
+		c := f.make(size, cb)
+		l.c = c
+		m := newModel(size)
+		for i, o := range tcase.ops {
+			where := func() string { return fmt.Sprintf("%s size %d: after %v", f.name, size, tcase.ops[:i+1]) }
+			l.log = l.log[:0]
+			m.evicted = m.evicted[:0]
+			switch o.kind {
+			case opAdd:
+				got, want := c.Add(o.k, o.v), m.add(o.k, o.v)
+				if got != want {
+					ht.Fatalf("%s: Add evicted %v, want %v", where(), got, want)
+				}
+			case opGet:
+				gv, gok := c.Get(o.k)
+				wv, wok := m.get(o.k)
+				if gok != wok || (gok && gv != wv) {
+					ht.Fatalf("%s: Get = %d, %v; want %d, %v", where(), gv, gok, wv, wok)
+				}
+			case opContains:
+				if got, want := c.Contains(o.k), m.contains(o.k); got != want {
+					ht.Fatalf("%s: Contains = %v, want %v", where(), got, want)
+				}
+			case opPeek:
+				gv, gok := c.Peek(o.k)
+				wv, wok := m.peek(o.k)
+				if gok != wok || (gok && gv != wv) {
+					ht.Fatalf("%s: Peek = %d, %v; want %d, %v", where(), gv, gok, wv, wok)
+				}
+			case opRemove:
+				if got, want := c.Remove(o.k), m.remove(o.k); got != want {
+					ht.Fatalf("%s: Remove = %v, want %v", where(), got, want)
+				}
+			case opRemoveOldest:
+				gk, gv, gok := c.RemoveOldest()
+				wk, wv, wok := m.removeOldest()
+				if gok != wok || (gok && (gk != wk || gv != wv)) {
+					ht.Fatalf("%s: RemoveOldest = %d, %d, %v; want %d, %d, %v", where(), gk, gv, gok, wk, wv, wok)
+				}
+			case opGetOldest:
+				gk, gv, gok := c.GetOldest()
+				wk, wv, wok := m.getOldest()
+				if gok != wok || (gok && (gk != wk || gv != wv)) {
+					ht.Fatalf("%s: GetOldest = %d, %d, %v; want %d, %d, %v", where(), gk, gv, gok, wk, wv, wok)
+				}
+			case opPurge:
+				c.Purge()
+				m.purge()
+			case opResize:
+				if got, want := c.Resize(o.n), m.resize(o.n); got != want {
+					ht.Fatalf("%s: Resize evicted %d, want %d", where(), got, want)
+				}
+				size = o.n
+			case opContainsOrAdd:
+				cc := c.(*lru.Cache[int, int])
+				ok, ev := cc.ContainsOrAdd(o.k, o.v)
+				wok := m.contains(o.k)
+				wev := false
+				if !wok {
+					wev = m.add(o.k, o.v)
+				}
+				if ok != wok || ev != wev {
+					ht.Fatalf("%s: ContainsOrAdd = %v, %v; want %v, %v", where(), ok, ev, wok, wev)
+				}
+			case opPeekOrAdd:
+				cc := c.(*lru.Cache[int, int])
+				prev, ok, ev := cc.PeekOrAdd(o.k, o.v)
+				wprev, wok := m.peek(o.k)
+				wev := false
+				if !wok {
+					wev = m.add(o.k, o.v)
+				}
+				if ok != wok || ev != wev || (ok && prev != wprev) {
+					ht.Fatalf("%s: PeekOrAdd = %d, %v, %v; want %d, %v, %v", where(), prev, ok, ev, wprev, wok, wev)
+				}
+			}
+			// callbacks
+			if tcase.withCB {
+				got, want := l.log, m.evicted
+				if o.kind == opPurge {
+					got, want = sortedKV(got), sortedKV(want)
+				}
+				if !slices.Equal(got, want) {
+					ht.Fatalf("%s: eviction callbacks %v, want %v", where(), got, want)
+				}
+				if len(l.stillIn) > 0 && !(Known.purgeCallbackBeforeRemoval && f.name == "simplelru" && o.kind == opPurge) {
+					ht.Fatalf("%s: the eviction callback still finds %v in the cache", where(), l.stillIn)
+				}
+				l.stillIn = nil
+			}
+			// state
+			if got, want := c.Len(), m.length(); got != want {
+				ht.Fatalf("%s: Len %d, want %d", where(), got, want)
+			}
+			if got := c.Cap(); got != size {
+				ht.Fatalf("%s: Cap %d, want %d", where(), got, size)
+			}
+			if got, want := c.Keys(), m.keys(); !slices.Equal(got, want) {
+				ht.Fatalf("%s: Keys %v, want %v", where(), got, want)
+			}
+			if got, want := c.Values(), m.values(); !slices.Equal(got, want) {
+				ht.Fatalf("%s: Values %v, want %v", where(), got, want)
+			}
+			if size > 0 && c.Len() > size {
+				ht.Fatalf("%s: Len %d above the size %d", where(), c.Len(), size)
+			}
+			for k := 0; k < keySpace; k++ {
+				wv, wok := m.peek(k)
+				if got := c.Contains(k); got != wok {
+					ht.Fatalf("%s: Contains(%d) = %v, want %v", where(), k, got, wok)
+				}
+				gv, gok := c.Peek(k)
+				if gok != wok || (gok && gv != wv) {
+					ht.Fatalf("%s: Peek(%d) = %d, %v; want %d, %v", where(), k, gv, gok, wv, wok)
+				}
+			}
+			gk, gv, gok := c.GetOldest()
+			wk, wv, wok := m.getOldest()
+			if gok != wok || (gok && (gk != wk || gv != wv)) {
+				ht.Fatalf("%s: GetOldest = %d, %d, %v; want %d, %d, %v", where(), gk, gv, gok, wk, wv, wok)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- constructors
+
+// ctorCase: a size, valid or not, and a pair of 2Q ratios, valid or not; the valid values
+// come first in every list so that a shrunk case is a plain one.
+type ctorCase struct {
+	size          int
+	recent, ghost float64
+}
+
+var (
+	ctorSizes  = weighted(choice[int]{60, hegel.Integers(1, 6)}, choice[int]{40, hegel.Integers(-3, 0)})
+	ctorRatios = hegel.SampledFrom([]float64{0, 0.1, 0.25, 0.5, 0.75, 1, -0.5, 1.5})
+	ctorCases  = hegel.Composite(func(tc hegel.TestCase) ctorCase {
+		return ctorCase{size: hegel.Draw(tc, ctorSizes), recent: hegel.Draw(tc, ctorRatios), ghost: hegel.Draw(tc, ctorRatios)}
+	})
+)
+
+func (c ctorCase) GoString() string {
+	return fmt.Sprintf("size %d, 2Q ratios recent %g ghost %g", c.size, c.recent, c.ghost)
+}
+
+// TestHegelConstructors: sizes at or below zero refused by the fixed-size constructors and
+// mapped to unlimited by expirable; Cap reports the size; a fresh cache is empty.
+func TestHegelConstructors(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, ctorCases)
+		size, rr, gr := tcase.size, tcase.recent, tcase.ghost
+		if _, err := simplelru.NewLRU[int, int](size, nil); (err == nil) != (size > 0) {
+			ht.Fatalf("simplelru.NewLRU(%d): err %v", size, err)
+		}
+		if _, err := lru.New[int, int](size); (err == nil) != (size > 0) {
+			ht.Fatalf("lru.New(%d): err %v", size, err)
+		}
+		if c, err := lru.NewWithEvict[int, int](size, func(k, v int) {}); (err == nil) != (size > 0) {
+			ht.Fatalf("lru.NewWithEvict(%d): err %v", size, err)
+		} else if err == nil && (c.Cap() != size || c.Len() != 0 || len(c.Keys()) != 0) {
+			ht.Fatalf("lru.New(%d): Cap %d Len %d Keys %v", size, c.Cap(), c.Len(), c.Keys())
+		}
+		e := expirable.NewLRU[int, int](size, nil, 0)
+		wantCap := max(size, 0)
+		if e.Cap() != wantCap || e.Len() != 0 {
+			ht.Fatalf("expirable.NewLRU(%d): Cap %d Len %d", size, e.Cap(), e.Len())
+		}
+		// 2Q: size must be positive, ratios within [0, 1]
+		valid := size > 0 && rr >= 0 && rr <= 1 && gr >= 0 && gr <= 1
+		q, err := lru.New2QParams[int, int](size, rr, gr)
+		switch {
+		case valid && Known.twoQueueSmallGhostFails && int(float64(size)*gr) == 0:
+			// golang-lru/2: a ghost list that rounds to zero entries is refused
+			if err == nil {
+				ht.Fatalf("New2QParams(%d, %g, %g) accepted (the recorded failure is gone?)", size, rr, gr)
+			}
+		case (err == nil) != valid:
+			ht.Fatalf("New2QParams(%d, %g, %g): err %v, valid %v", size, rr, gr, err, valid)
+		case err == nil && (q.Cap() != size || q.Len() != 0 || len(q.Keys()) != 0):
+			ht.Fatalf("New2QParams(%d, %g, %g): Cap %d Len %d", size, rr, gr, q.Cap(), q.Len())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- 2Q
+
+// ratioPair is a 2Q cache's recent and ghost ratios: the defaults, or explicit ones.
+type ratioPair struct{ recent, ghost float64 }
+
+// ghostRatios: a ghost ratio of 0 is documented valid but refused (golang-lru/2), so it is
+// drawn only once the bug is fixed.
+func ghostRatios() []float64 {
+	rs := []float64{0.25, 0.5, 1}
+	if !Known.twoQueueSmallGhostFails {
+		rs = append(rs, 0)
+	}
+	return rs
+}
+
+var (
+	explicitRatios = hegel.Composite(func(tc hegel.TestCase) ratioPair {
+		return ratioPair{
+			recent: hegel.Draw(tc, hegel.SampledFrom([]float64{0.25, 0.5, 0.75, 0, 1})),
+			ghost:  hegel.Draw(tc, hegel.SampledFrom(ghostRatios())),
+		}
+	})
+	ratioPairs = weighted(
+		choice[ratioPair]{60, hegel.Just(ratioPair{lru.Default2QRecentRatio, lru.Default2QGhostEntries})},
+		choice[ratioPair]{40, explicitRatios},
+	)
+)
+
+// minTwoQSize is the smallest size New2QParams accepts with the ghost ratio: while
+// golang-lru/2 stands, one whose ghost list has at least one entry.
+func minTwoQSize(ghost float64) int {
+	if !Known.twoQueueSmallGhostFails || ghost == 0 {
+		return 1
+	}
+	return int(math.Ceil(1 / ghost))
+}
+
+// twoQOps: the LRU steps without RemoveOldest and GetOldest (which the 2Q cache lacks; their
+// share goes to Get), Resize to 1..12 (a ghost list resized to 0 is modelled, ghostAdd).
+var twoQOps = weighted(
+	choice[op]{10, keyed(opContains)},
+	choice[op]{10, keyed(opPeek)},
+	choice[op]{30, keyed(opGet)},
+	choice[op]{37, keyedValued(opAdd)},
+	choice[op]{10, keyed(opRemove)},
+	choice[op]{3, bare(opPurge)},
+	choice[op]{10, resizes(hegel.Integers(1, 12))},
+)
+
+// twoQCase: the cache's size and ratios, and the sequence applied.
+type twoQCase struct {
+	size          int
+	recent, ghost float64
+	ops           []op
+}
+
+var twoQCases = hegel.Composite(func(tc hegel.TestCase) twoQCase {
+	r := hegel.Draw(tc, ratioPairs)
+	return twoQCase{
+		size:   hegel.Draw(tc, hegel.Integers(minTwoQSize(r.ghost), 12)),
+		recent: r.recent,
+		ghost:  r.ghost,
+		ops:    hegel.Draw(tc, hegel.Lists(twoQOps).MaxSize(50)),
+	}
+})
+
+func (c twoQCase) GoString() string {
+	return fmt.Sprintf("2Q(size %d, recent %g, ghost %g): %v", c.size, c.recent, c.ghost, c.ops)
+}
+
+// TestHegelTwoQueue: TwoQueueCache against the 2Q model under random sequences: Len, Cap,
+// Keys (frequent first, each oldest first), Values, Contains, Peek, Get; the cache never
+// exceeds its size; a key seen twice is in the frequent list and survives a burst of new
+// keys while the recent list is above its share.
+func TestHegelTwoQueue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, twoQCases)
+		size, rr, gr := tcase.size, tcase.recent, tcase.ghost
+		q, err := lru.New2QParams[int, int](size, rr, gr)
+		if err != nil {
+			ht.Fatalf("New2QParams(%d, %g, %g): %v", size, rr, gr, err)
+		}
+		m := newTwoQModel(size, rr, gr)
+		for i, o := range tcase.ops {
+			where := func() string {
+				return fmt.Sprintf("2Q(size %d, recent %g, ghost %g): after %v", size, rr, gr, tcase.ops[:i+1])
+			}
+			switch o.kind {
+			case opAdd:
+				q.Add(o.k, o.v)
+				m.add(o.k, o.v)
+			case opGet:
+				gv, gok := q.Get(o.k)
+				wv, wok := m.get(o.k)
+				if gok != wok || (gok && gv != wv) {
+					ht.Fatalf("%s: Get(%d) = %d, %v; want %d, %v", where(), o.k, gv, gok, wv, wok)
+				}
+			case opContains:
+				if got, want := q.Contains(o.k), m.contains(o.k); got != want {
+					ht.Fatalf("%s: Contains(%d) = %v, want %v", where(), o.k, got, want)
+				}
+			case opPeek:
+				gv, gok := q.Peek(o.k)
+				wv, wok := m.peek(o.k)
+				if gok != wok || (gok && gv != wv) {
+					ht.Fatalf("%s: Peek(%d) = %d, %v; want %d, %v", where(), o.k, gv, gok, wv, wok)
+				}
+			case opRemove:
+				q.Remove(o.k)
+				m.remove(o.k)
+			case opPurge:
+				q.Purge()
+				m.purge()
+			case opResize:
+				if got, want := q.Resize(o.n), m.resize(o.n); got != want {
+					ht.Fatalf("%s: Resize evicted %d, want %d", where(), got, want)
+				}
+				size = o.n
+			}
+			if got, want := q.Len(), m.length(); got != want {
+				ht.Fatalf("%s: Len %d, want %d", where(), got, want)
+			}
+			if q.Cap() != size {
+				ht.Fatalf("%s: Cap %d, want %d", where(), q.Cap(), size)
+			}
+			if q.Len() > size && !(Known.twoQueueOverfullAtFullRecent && rr == 1) {
+				ht.Fatalf("%s: Len %d above size %d", where(), q.Len(), size)
+			}
+			if got, want := q.Keys(), m.keys(); !slices.Equal(got, want) {
+				ht.Fatalf("%s: Keys %v, want %v", where(), got, want)
+			}
+			if got, want := q.Values(), m.values(); !slices.Equal(got, want) {
+				ht.Fatalf("%s: Values %v, want %v", where(), got, want)
+			}
+			for k := 0; k < keySpace; k++ {
+				wv, wok := m.peek(k)
+				gv, gok := q.Peek(k)
+				if gok != wok || (gok && gv != wv) || q.Contains(k) != wok {
+					ht.Fatalf("%s: Peek(%d) = %d, %v, Contains %v; want %d, %v", where(), k, gv, gok, q.Contains(k), wv, wok)
+				}
+			}
+		}
+		// the 2Q promise, independent of the model: with a fresh cache, a key added and then
+		// read is in the frequent list; adding size-1 fresh keys afterwards evicts from the
+		// recent list first while it holds more than its share, so the hot key survives when
+		// the recent share is below 1.
+		if size >= 4 && rr < 1 {
+			where := func() string {
+				return fmt.Sprintf("2Q(size %d, recent %g, ghost %g): after %v", size, rr, gr, tcase.ops)
+			}
+			q.Purge()
+			hot := 100
+			q.Add(hot, 1)
+			q.Get(hot)
+			for k := 200; k < 200+size; k++ {
+				q.Add(k, k)
+			}
+			if !q.Contains(hot) {
+				ht.Fatalf("%s: a key read twice was evicted by %d fresh keys (recent ratio %g)", where(), size, rr)
+			}
+			if q.Len() > size {
+				ht.Fatalf("%s: Len %d above size %d after the burst", where(), q.Len(), size)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- concurrency
+
+// concCase: a thread-safe cache, its size, and how many workers add how many keys each.
+type concCase struct {
+	kind         string
+	size         int
+	workers, per int
+}
+
+var concKinds = []string{"lru.Cache", "expirable", "2Q"}
+
+// concSizes: 1 to 8; the 2Q cache needs 2 (New2Q(1) is refused, golang-lru/2).
+func concSizes(kind string) hegel.Generator[int] {
+	if kind == "2Q" {
+		return hegel.Integers(minTwoQSize(lru.Default2QGhostEntries), 8)
+	}
+	return hegel.Integers(1, 8)
+}
+
+var concCases = hegel.Composite(func(tc hegel.TestCase) concCase {
+	kind := hegel.Draw(tc, hegel.SampledFrom(concKinds))
+	return concCase{
+		kind:    kind,
+		size:    hegel.Draw(tc, concSizes(kind)),
+		workers: hegel.Draw(tc, hegel.Integers(2, 4)),
+		per:     hegel.Draw(tc, hegel.Integers(1, 30)),
+	}
+})
+
+func (c concCase) GoString() string {
+	return fmt.Sprintf("%s size %d, %d workers x %d adds", c.kind, c.size, c.workers, c.per)
+}
+
+// TestHegelConcurrent: the thread-safe caches under concurrent Add/Get/Remove keep Len at
+// or below the size and consistent with Keys, and every callback names a key that has been
+// added.
+func TestHegelConcurrent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, concCases)
+		kind, size, workers, per := tcase.kind, tcase.size, tcase.workers, tcase.per
+		var mu sync.Mutex
+		var evicted []kv
+		var add func(k, v int)
+		var lenKeys func() (int, []int)
+		switch kind {
+		case "lru.Cache":
+			c, _ := lru.NewWithEvict[int, int](size, func(k, v int) {
+				mu.Lock()
+				evicted = append(evicted, kv{k, v})
+				mu.Unlock()
+			})
+			add = func(k, v int) { c.Add(k, v); c.Get(k - 1); c.Peek(k + 1); c.Contains(k) }
+			lenKeys = func() (int, []int) { return c.Len(), c.Keys() }
+		case "expirable":
+			c := expirable.NewLRU[int, int](size, func(k, v int) {
+				mu.Lock()
+				evicted = append(evicted, kv{k, v})
+				mu.Unlock()
+			}, 0)
+			add = func(k, v int) { c.Add(k, v); c.Get(k - 1); c.Peek(k + 1); c.Contains(k) }
+			lenKeys = func() (int, []int) { return c.Len(), c.Keys() }
+		default:
+			c, err := lru.New2Q[int, int](size)
+			if err != nil {
+				ht.Fatalf("New2Q(%d): %v", size, err)
+			}
+			add = func(k, v int) { c.Add(k, v); c.Get(k - 1); c.Peek(k + 1); c.Contains(k) }
+			lenKeys = func() (int, []int) { return c.Len(), c.Keys() }
+		}
+		var wg sync.WaitGroup
+		for w := 0; w < workers; w++ {
+			wg.Add(1)
+			go func(w int) {
+				defer wg.Done()
+				for i := 0; i < per; i++ {
+					add(w*100+i%(size+2), i)
+				}
+			}(w)
+		}
+		wg.Wait()
+		n, ks := lenKeys()
+		if n != len(ks) || n > size {
+			ht.Fatalf("%s size %d: Len %d, Keys %v", kind, size, n, ks)
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		for _, e := range evicted {
+			if e.k < 0 || e.k >= workers*100+size+2 {
+				ht.Fatalf("%s: callback for an unknown key %v", kind, e)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- expiry
+
+// expiryCase: an expirable cache, unlimited or of size 2 to 6, holding n keys (at most the
+// size, so that a refresh is a renewal and not a re-add), of which the last renew are
+// re-added within the TTL.
+type expiryCase struct {
+	size, n, renew int
+}
+
+var expiryCases = hegel.Composite(func(tc hegel.TestCase) expiryCase {
+	size := hegel.Draw(tc, hegel.OneOf(hegel.Just(0), hegel.Integers(2, 6)))
+	maxN := 4
+	if size > 0 {
+		maxN = min(maxN, size)
+	}
+	n := hegel.Draw(tc, hegel.Integers(1, maxN))
+	return expiryCase{size: size, n: n, renew: hegel.Draw(tc, hegel.Integers(0, n))}
+})
+
+func (c expiryCase) GoString() string {
+	return fmt.Sprintf("size %d, %d keys, %d renewed", c.size, c.n, c.renew)
+}
+
+// TestHegelExpiry: expirable.LRU with a real TTL: entries older than the TTL are hidden by
+// Get, Peek, Keys and Values, entries refreshed by Add within the TTL survive, and after two
+// TTLs the cache is empty and every entry has been reported to the callback exactly once.
+// Few cases, since each sleeps for three TTLs.
+func TestHegelExpiry(t *testing.T) {
+	// 4 cases; HEGEL_TEST_CASES raises that to at most 8 (each case sleeps for three TTLs)
+	cases := 4
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > cases {
+			cases = 8
+		}
+	}
+	opts := []hegel.Option{hegel.WithTestCases(cases)}
+	hegel.Test(t, func(ht *hegel.T) {
+		const ttl = 200 * time.Millisecond
+		tcase := hegel.Draw(ht, expiryCases)
+		size, n, renew := tcase.size, tcase.n, tcase.renew
+		var mu sync.Mutex
+		evicted := map[int]int{}
+		c := expirable.NewLRU[int, int](size, func(k, v int) {
+			mu.Lock()
+			evicted[k]++
+			mu.Unlock()
+		}, ttl)
+		defer c.Close()
+		for k := 0; k < n; k++ {
+			c.Add(k, k)
+		}
+		time.Sleep(ttl / 2)
+		for k := n - renew; k < n; k++ {
+			c.Add(k, k+100)
+		}
+		// t = ttl + 40ms: the first batch (not renewed) has expired, the renewed keys have
+		// half a TTL left
+		time.Sleep(ttl/2 + 40*time.Millisecond)
+		keys := c.Keys()
+		for k := 0; k < n-renew; k++ {
+			if _, ok := c.Get(k); ok {
+				ht.Fatalf("size %d, %d keys, %d renewed: Get(%d) still ok after the TTL", size, n, renew, k)
+			}
+			if _, ok := c.Peek(k); ok {
+				ht.Fatalf("size %d, %d keys, %d renewed: Peek(%d) still ok after the TTL", size, n, renew, k)
+			}
+			if slices.Contains(keys, k) {
+				ht.Fatalf("size %d, %d keys, %d renewed: Keys %v lists the expired %d", size, n, renew, keys, k)
+			}
+		}
+		for k := n - renew; k < n; k++ {
+			if v, ok := c.Get(k); !ok || v != k+100 {
+				ht.Fatalf("size %d, %d keys, %d renewed: Get(%d) = %d, %v within the renewed TTL", size, n, renew, k, v, ok)
+			}
+		}
+		if len(c.Values()) != len(c.Keys()) {
+			ht.Fatalf("Values %v vs Keys %v", c.Values(), c.Keys())
+		}
+		if !Known.expiredVisibleAfterClose {
+			// a closed cache still hides expired entries (golang-lru/3 says otherwise)
+			c.Close()
+			for k := 0; k < n-renew; k++ {
+				if _, ok := c.Get(k); ok {
+					ht.Fatalf("size %d, %d keys, %d renewed: Get(%d) ok after Close", size, n, renew, k)
+				}
+			}
+		} else {
+			time.Sleep(2*ttl + 40*time.Millisecond)
+			if c.Len() != 0 || len(c.Keys()) != 0 {
+				ht.Fatalf("size %d, %d keys, %d renewed: Len %d Keys %v three TTLs after the last Add", size, n, renew, c.Len(), c.Keys())
+			}
+			mu.Lock()
+			defer mu.Unlock()
+			for k := 0; k < n; k++ {
+				if evicted[k] != 1 {
+					ht.Fatalf("size %d, %d keys, %d renewed: key %d reported %d times", size, n, renew, k, evicted[k])
+				}
+			}
+		}
+	}, opts...)
+}
