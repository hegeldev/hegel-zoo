+// TestHegelConstructors: sizes at or below zero refused by the fixed-size constructors and
+// mapped to unlimited by expirable; Cap reports the size; a fresh cache is empty.
+func TestHegelConstructors(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		size := drawInt(ht, -3, 6)
+		if _, err := simplelru.NewLRU[int, int](size, nil); (err == nil) != (size > 0) {
+			col.failClass(ht, "simplelru", "simplelru.NewLRU(%d): err %v", size, err)
+		}
+		if _, err := lru.New[int, int](size); (err == nil) != (size > 0) {
+			col.failClass(ht, "lru.New", "lru.New(%d): err %v", size, err)
+		}
+		if c, err := lru.NewWithEvict[int, int](size, func(k, v int) {}); (err == nil) != (size > 0) {
+			col.failClass(ht, "lru.NewWithEvict", "lru.NewWithEvict(%d): err %v", size, err)
+		} else if err == nil && (c.Cap() != size || c.Len() != 0 || len(c.Keys()) != 0) {
+			col.failClass(ht, "fresh", "lru.New(%d): Cap %d Len %d Keys %v", size, c.Cap(), c.Len(), c.Keys())
+		}
+		e := expirable.NewLRU[int, int](size, nil, 0)
+		wantCap := size
+		if size < 0 {
+			wantCap = 0
+		}
+		if e.Cap() != wantCap || e.Len() != 0 {
+			col.failClass(ht, "expirable", "expirable.NewLRU(%d): Cap %d Len %d", size, e.Cap(), e.Len())
+		}
+		// 2Q: size must be positive, ratios within [0, 1]
+		ratios := []float64{-0.5, 0, 0.1, 0.25, 0.5, 0.75, 1, 1.5}
+		rr, gr := pick(ht, ratios), pick(ht, ratios)
+		valid := size > 0 && rr >= 0 && rr <= 1 && gr >= 0 && gr <= 1
+		q, err := lru.New2QParams[int, int](size, rr, gr)
+		if valid && Known.twoQueueSmallGhostFails && int(float64(size)*gr) == 0 {
+			if err == nil {
+				col.failClass(ht, "2Q ghost", "New2QParams(%d, %g, %g) accepted (the recorded failure is gone?)", size, rr, gr)
+			}
+			return
+		}
+		if (err == nil) != valid {
+			col.failClass(ht, "New2QParams", "New2QParams(%d, %g, %g): err %v, valid %v", size, rr, gr, err, valid)
+		} else if err == nil && (q.Cap() != size || q.Len() != 0 || len(q.Keys()) != 0) {
+			col.failClass(ht, "fresh 2Q", "New2QParams(%d, %g, %g): Cap %d Len %d", size, rr, gr, q.Cap(), q.Len())
+		}
+	})
+}
