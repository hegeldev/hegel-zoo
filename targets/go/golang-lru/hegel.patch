+// TestHegelTwoQueue: TwoQueueCache against the 2Q model under random sequences: Len, Cap,
+// Keys (frequent first, each oldest first), Values, Contains, Peek, Get; the cache never
+// exceeds its size; a key seen twice is in the frequent list and survives a burst of new
+// keys while the recent list is above its share.
+func TestHegelTwoQueue(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		size := drawInt(ht, 1, 12)
+		rr, gr := lru.Default2QRecentRatio, lru.Default2QGhostEntries
+		if chance(ht, 40) {
+			rr = pick(ht, []float64{0, 0.25, 0.5, 0.75, 1})
+			gr = pick(ht, []float64{0, 0.25, 0.5, 1})
+		}
+		if Known.twoQueueSmallGhostFails && int(float64(size)*gr) == 0 {
+			// New2QParams fails for these (golang-lru/2): pick a size whose ghost list is not empty
+			size = drawInt(ht, 4, 12)
+			if gr == 0 {
+				gr = 0.5
+			}
+		}
+		q, err := lru.New2QParams[int, int](size, rr, gr)
+		if err != nil {
+			col.failClass(ht, "New2QParams", "New2QParams(%d, %g, %g): %v", size, rr, gr, err)
+			return
+		}
+		m := newTwoQModel(size, rr, gr)
+		nops := drawInt(ht, 0, 50)
+		var trace []string
+		for i := 0; i < nops; i++ {
+			o := genOp(ht, false)
+			if o.name == "RemoveOldest" || o.name == "GetOldest" {
+				o.name = "Get"
+			}
+			if o.name == "Resize" {
+				o.n = drawInt(ht, 1, 12) // a ghost list resized to 0 is modelled (ghostAdd)
+			}
+			trace = append(trace, o.String())
+			where := func() string {
+				return fmt.Sprintf("2Q(size %d, recent %g, ghost %g): after %v", size, rr, gr, trace)
+			}
+			switch o.name {
+			case "Add":
+				q.Add(o.k, o.v)
+				m.add(o.k, o.v)
+			case "Get":
+				gv, gok := q.Get(o.k)
+				wv, wok := m.get(o.k)
+				if gok != wok || (gok && gv != wv) {
+					col.failClass(ht, "Get", "%s: Get(%d) = %d, %v; want %d, %v", where(), o.k, gv, gok, wv, wok)
+				}
+			case "Contains":
+				if got, want := q.Contains(o.k), m.contains(o.k); got != want {
+					col.failClass(ht, "Contains", "%s: Contains(%d) = %v, want %v", where(), o.k, got, want)
+				}
+			case "Peek":
+				gv, gok := q.Peek(o.k)
+				wv, wok := m.peek(o.k)
+				if gok != wok || (gok && gv != wv) {
+					col.failClass(ht, "Peek", "%s: Peek(%d) = %d, %v; want %d, %v", where(), o.k, gv, gok, wv, wok)
+				}
+			case "Remove":
+				q.Remove(o.k)
+				m.remove(o.k)
+			case "Purge":
+				q.Purge()
+				m.purge()
+			case "Resize":
+				if got, want := q.Resize(o.n), m.resize(o.n); got != want {
+					col.failClass(ht, "Resize", "%s: Resize evicted %d, want %d", where(), got, want)
+				}
+				size = o.n
+			}
+			if got, want := q.Len(), m.length(); got != want {
+				col.failClass(ht, "Len", "%s: Len %d, want %d", where(), got, want)
+			}
+			if q.Cap() != size {
+				col.failClass(ht, "Cap", "%s: Cap %d, want %d", where(), q.Cap(), size)
+			}
+			if q.Len() > size && !(Known.twoQueueOverfullAtFullRecent && rr == 1) {
+				col.failClass(ht, "Overfull", "%s: Len %d above size %d", where(), q.Len(), size)
+			}
+			if got, want := q.Keys(), m.keys(); !sameInts(got, want) {
+				col.failClass(ht, "Keys", "%s: Keys %v, want %v", where(), got, want)
+			}
+			if got, want := q.Values(), m.values(); !sameInts(got, want) {
+				col.failClass(ht, "Values", "%s: Values %v, want %v", where(), got, want)
+			}
+			for k := 0; k < keySpace; k++ {
+				wv, wok := m.peek(k)
+				gv, gok := q.Peek(k)
+				if gok != wok || (gok && gv != wv) || q.Contains(k) != wok {
+					col.failClass(ht, "PeekAll", "%s: Peek(%d) = %d, %v, Contains %v; want %d, %v", where(), k, gv, gok, q.Contains(k), wv, wok)
+				}
+			}
+		}
+		// the 2Q promise, independent of the model: with a fresh cache, a key added and then
+		// read is in the frequent list; adding size-1 fresh keys afterwards evicts from the
+		// recent list first while it holds more than its share, so the hot key survives when
+		// the recent share is below 1.
+		if size >= 4 && rr < 1 {
+			where := func() string {
+				return fmt.Sprintf("2Q(size %d, recent %g, ghost %g): after %v", size, rr, gr, trace)
+			}
+			q.Purge()
+			hot := 100
+			q.Add(hot, 1)
+			q.Get(hot)
+			for k := 200; k < 200+size; k++ {
+				q.Add(k, k)
+			}
+			if !q.Contains(hot) {
+				col.failClass(ht, "HotEvicted", "%s: a key read twice was evicted by %d fresh keys (recent ratio %g)", where(), size, rr)
+			}
+			if q.Len() > size {
+				col.failClass(ht, "Overfull", "%s: Len %d above size %d after the burst", where(), q.Len(), size)
+			}
+		}
+	})
+}
