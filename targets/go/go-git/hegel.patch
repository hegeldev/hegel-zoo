+package hegel
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/go-git/go-billy/v6/osfs"
+	"hegel.dev/go/hegel"
+
+	"github.com/go-git/go-git/v6/plumbing/format/gitignore"
+)
+
+// ---------------------------------------------------------------------------
+// The generated worktree, as drawn.
+//
+// A worktree is a tree of records: directories holding entries by name
+// (distinct by construction) and, some of them, a .gitignore whose lines are
+// patterns rendered from a pattern record, comments and blank lines. build
+// writes the records into the tree the scratch repository is materialised
+// from; the grammar the records are drawn from is built once per setting of
+// the recorded bugs' shapes (newGrammar).
+
+// treeSpec is a worktree as drawn: the root directory and whether the ignore
+// files use CRLF line ends.
+type treeSpec struct {
+	root dirSpec
+	crlf bool
+}
+
+// dirSpec is a directory: its entries by name and its .gitignore, nil when
+// it declares none (the root always has one, possibly empty).
+type dirSpec struct {
+	entries map[string]entrySpec
+	ignore  *ignoreSpec
+}
+
+// entrySpec is an entry of a directory: a file, or a directory with its own
+// content (none, for an empty directory).
+type entrySpec struct {
+	dir bool
+	sub dirSpec
+}
+
+// ignoreSpec is a .gitignore as drawn: its lines, rendered, and whether a
+// line end follows the last one.
+type ignoreSpec struct {
+	lines   []string
+	finalNL bool
+}
+
+func (s ignoreSpec) render(crlf bool) string {
+	nl := "\n"
+	if crlf {
+		nl = "\r\n"
+	}
+	out := strings.Join(s.lines, nl)
+	if s.finalNL && len(s.lines) > 0 {
+		out += nl
+	}
+	return out
+}
+
+// patternSpec is one pattern line: a negation, a leading slash, one to three
+// slash-free segments, a trailing slash and a tail of spaces (escaped or
+// not).
+type patternSpec struct {
+	negate, leading, trailing bool
+	segments                  []string
+	tail                      string
+}
+
+func (p patternSpec) String() string {
+	var b strings.Builder
+	if p.negate {
+		b.WriteString("!")
+	}
+	if p.leading {
+		b.WriteString("/")
+	}
+	b.WriteString(strings.Join(p.segments, "/"))
+	if p.trailing {
+		b.WriteString("/")
+	}
+	b.WriteString(p.tail)
+	return b.String()
+}
+
+// classSpec is a bracket expression: its negation ("", "!" or "^"), a
+// literal "]" first, one to three items (literals, ranges, POSIX classes,
+// escapes) and whether the closing bracket is missing.
+type classSpec struct {
+	negation string
+	bracket  bool
+	items    []string
+	open     bool
+}
+
+func (c classSpec) String() string {
+	var b strings.Builder
+	b.WriteString("[")
+	b.WriteString(c.negation)
+	if c.bracket {
+		b.WriteString("]")
+	}
+	for _, it := range c.items {
+		b.WriteString(it)
+	}
+	if !c.open {
+		b.WriteString("]")
+	}
+	return b.String()
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (t treeSpec) GoString() string { return t.build().String() }
+
+// build writes the records into a tree: the directories parents first, the
+// files (the .gitignore files among them) and the ignore files' contents.
+func (t treeSpec) build() *tree {
+	out := &tree{ignores: map[string]string{}, crlf: t.crlf}
+	var walk func(prefix string, d dirSpec)
+	walk = func(prefix string, d dirSpec) {
+		if d.ignore != nil {
+			out.ignores[prefix] = d.ignore.render(t.crlf)
+			out.files = append(out.files, joinPath(prefix, ".gitignore"))
+		}
+		for _, name := range sortedKeys(d.entries) {
+			e := d.entries[name]
+			p := joinPath(prefix, name)
+			if e.dir {
+				out.dirs = append(out.dirs, p)
+				walk(p, e.sub)
+			} else {
+				out.files = append(out.files, p)
+			}
+		}
+	}
+	walk("", t.root)
+	return out
+}
+
+func joinPath(prefix, name string) string {
+	if prefix == "" {
+		return name
+	}
+	return prefix + "/" + name
+}
+
+func sortedKeys[V any](m map[string]V) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// ---------------------------------------------------------------------------
+// The grammar.
+
+// names is the alphabet of file and directory names. Small, so that patterns
+// hit and miss; with the characters the pattern syntax cares about.
+var names = []string{
+	"a", "b", "c", "ab", "ba", "aa", "abc", "a.b", "a.c", "b.a", ".a", "a-b", "a_b",
+	"A", "B", "a1", "1", "a b", "[a]", "!a", "#a", "a*", "a?", "a ", "-", "a]",
+}
+
+var (
+	nameTexts    = hegel.SampledFrom(names)
+	escapedNames = hegel.Map(nameTexts, escapeName)
+	// literalChars: the plain characters of a glob piece.
+	literalChars = hegel.SampledFrom([]string{"a", "b", "c", ".", "-", "_", "1", "A", " "})
+	// wildcards: a star three times in four, else a question mark.
+	wildcards = hegel.SampledFrom([]string{"*", "*", "*", "?"})
+	// escapes: a backslash before a character the syntax cares about (or a
+	// plain one).
+	escapes = hegel.Map(hegel.SampledFrom([]string{"*", "?", "[", "]", "!", "#", "\\", " ", "a", "-"}), func(c string) string { return "\\" + c })
+	// ranges: lo-hi inside a bracket expression, sometimes reversed or
+	// degenerate.
+	ranges = hegel.Map(pairs(
+		hegel.SampledFrom([]string{"a", "b", "0", "A", "-", ".", "!"}),
+		hegel.SampledFrom([]string{"c", "z", "9", "Z", "b", "-", "a"}),
+	), func(p pair[string, string]) string { return p.a + "-" + p.b })
+	posixClasses = hegel.Map(hegel.SampledFrom([]string{"alpha", "digit", "alnum", "upper", "lower", "space", "punct", "blank", "xdigit", "print", "graph", "cntrl", "word", ""}), func(n string) string { return "[:" + n + ":]" })
+	classEscapes = hegel.Map(hegel.SampledFrom([]string{"]", "\\", "-", "a", "["}), func(c string) string { return "\\" + c })
+	negations    = hegel.SampledFrom([]string{"!", "^"})
+	// doubleStars and emptySegments: the ** segment and the empty segment (a
+	// doubled slash), as one-entry tables rather than Just so that a name,
+	// which draws once too, wins the shrink (a draw-free alternative would
+	// always win it).
+	doubleStars   = hegel.SampledFrom([]string{"**", "**"})
+	emptySegments = hegel.SampledFrom([]string{"", ""})
+	comments      = hegel.Map(nameTexts, func(n string) string { return "# " + n })
+	blanks        = hegel.SampledFrom([]string{"", " ", "   "})
+)
+
+// escapeName spells a name so that it matches literally.
+func escapeName(name string) string {
+	var b strings.Builder
+	for i := 0; i < len(name); i++ {
+		c := name[i]
+		if strings.IndexByte("*?[]!#\\ ", c) >= 0 {
+			b.WriteByte('\\')
+		}
+		b.WriteByte(c)
+	}
+	return b.String()
+}
+
+// collapseStars folds a run of stars inside a glob segment to one star: git
+// before 2.52.0 mishandles a ** beside a non-slash character (see the
+// README), so the oracle would answer by version.
+func collapseStars(s string) string {
+	for strings.Contains(s, "**") {
+		s = strings.ReplaceAll(s, "**", "*")
+	}
+	return s
+}
+
+// gitStored is the pattern git stores for a line: without its negation
+// mark, its trailing spaces trimmed as git trims them.
+func gitStored(line string) string {
+	return gitTrimmed(strings.TrimPrefix(line, "!"))
+}
+
+// hasNonSlashAdjacentDoubleStar reports whether p contains a `**` with a
+// non-slash neighbour (`foo**`, `**bar`, `a**b`).
+func hasNonSlashAdjacentDoubleStar(p string) bool {
+	for i := 0; i+1 < len(p); i++ {
+		if p[i] != '*' || p[i+1] != '*' {
+			continue
+		}
+		beforeOK := i == 0 || p[i-1] == '/'
+		afterOK := i+2 >= len(p) || p[i+2] == '/'
+		if !beforeOK || !afterOK {
+			return true
+		}
+	}
+	return false
+}
+
+// classesOf: a bracket expression, negated 30% of the time, with a literal
+// "]" first 10%, one to three items (a literal three times in five, else a
+// range, a POSIX class or an escape) and unterminated 4% of the time. With
+// shapes the literals include "/" (the shape of go-git/6).
+func classesOf(shapes bool) hegel.Generator[classSpec] {
+	literals := []string{"a", "b", "c", ".", "_", "1", "A", " ", "!", "*", "?", "-"}
+	if shapes {
+		literals = append(literals, "/")
+	}
+	items := weighted(
+		choice[string]{60, hegel.SampledFrom(literals)},
+		choice[string]{20, ranges},
+		choice[string]{10, posixClasses},
+		choice[string]{10, classEscapes},
+	)
+	return hegel.Composite(func(tc hegel.TestCase) classSpec {
+		return classSpec{
+			negation: hegel.Draw(tc, maybe(30, negations)),
+			bracket:  hegel.Draw(tc, chance(10)),
+			items:    hegel.Draw(tc, many(items, 1, 3)),
+			open:     hegel.Draw(tc, chance(4)),
+		}
+	})
+}
+
+// grammar holds the generators of the ignore-file syntax and the worktree,
+// built once per setting of shapes: on, the pattern shapes of the recorded
+// bugs are drawn at their natural rate (a trailing ** segment, go-git/1; an
+// escaped space before trailing spaces, go-git/2; an empty segment,
+// go-git/3; a slash inside a bracket expression, go-git/6; a ** followed by
+// two segments, go-git/7, whose false-start path is so rare in a drawn tree
+// that one is seeded into about one tree in a hundred); off, they are left
+// out by construction (HEGEL_NO_KNOWN=1, and the surroundings of the narrow
+// properties in hegel_shapes_test.go). go-git/5's shape is a property of the
+// tree (a negation matching a directory, an exclusion matching something
+// inside), recognised when judged.
+type grammar struct {
+	patterns hegel.Generator[patternSpec]
+	ignores  hegel.Generator[ignoreSpec]
+	subdirs  hegel.Generator[dirSpec] // a directory below the root, with up to two levels of content
+	trees    hegel.Generator[treeSpec]
+}
+
+func newGrammar(shapes bool) grammar {
+	classes := hegel.Map(classesOf(shapes), classSpec.String)
+	// pieces: a literal, a wildcard, a bracket expression or an escape; a glob
+	// is one to four of them.
+	pieces := weighted(
+		choice[string]{30, literalChars},
+		choice[string]{40, wildcards},
+		choice[string]{20, classes},
+		choice[string]{10, escapes},
+	)
+	globs := hegel.Map(many(pieces, 1, 4), func(ps []string) string { return collapseStars(strings.Join(ps, "")) })
+	// solo: the one segment of a single-segment pattern: a name half of the
+	// time (escaped 15%), else a glob.
+	solo := weighted(choice[string]{35, nameTexts}, choice[string]{15, escapedNames}, choice[string]{50, globs})
+	// inner and last: a segment of a multi-segment pattern: a name, an
+	// escaped name, a glob, ** a quarter of the time; with shapes an empty
+	// segment 2% (go-git/3), and ** last (go-git/1). multi: one or two inner
+	// segments and a last one; without shapes a ** is drawn only right before
+	// the last segment, so that no ** is followed by two segments (go-git/7).
+	inner := []choice[string]{{25, nameTexts}, {11, escapedNames}, {33, globs}, {25, doubleStars}}
+	last := inner
+	var multi hegel.Generator[[]string]
+	if shapes {
+		inner = append(inner, choice[string]{2, emptySegments})
+		last = inner
+		multi = hegel.Composite(func(tc hegel.TestCase) []string {
+			return append(hegel.Draw(tc, many(weighted(inner...), 1, 2)), hegel.Draw(tc, weighted(last...)))
+		})
+	} else {
+		last = inner[:3]
+		multi = hegel.Composite(func(tc hegel.TestCase) []string {
+			return append(hegel.Draw(tc, many(weighted(last...), 0, 1)), hegel.Draw(tc, weighted(inner...)), hegel.Draw(tc, weighted(last...)))
+		})
+	}
+	segments := weighted(
+		choice[[]string]{55, hegel.Map(solo, func(s string) []string { return []string{s} })},
+		choice[[]string]{45, multi},
+	)
+	// tails: trailing spaces, escaped or not; with shapes an escaped space
+	// followed by another (go-git/2).
+	tailPool := []string{" ", "  ", "\\ "}
+	if shapes {
+		tailPool = append(tailPool, "\\  ")
+	}
+	tails := hegel.SampledFrom(tailPool)
+	patterns := hegel.Filter(hegel.Composite(func(tc hegel.TestCase) patternSpec {
+		return patternSpec{
+			negate:   hegel.Draw(tc, chance(25)),
+			leading:  hegel.Draw(tc, chance(20)),
+			segments: hegel.Draw(tc, segments),
+			trailing: hegel.Draw(tc, chance(20)),
+			tail:     hegel.Draw(tc, maybe(10, tails)),
+		}
+	}), func(p patternSpec) bool {
+		// a ** segment before an escaped-space tail (`a/**\ `): the version-dependent shape again
+		return !hasNonSlashAdjacentDoubleStar(gitStored(p.String()))
+	})
+	// lines: a pattern nine times in ten, else a comment or a blank line (the
+	// pattern first: a line is deleted by the list shrinker rather than
+	// blanked, and the first alternative of a weighted choice absorbs the
+	// integer draw's bias, which would make a 4% blank line a 20% one).
+	lines := weighted(
+		choice[string]{90, hegel.Map(patterns, patternSpec.String)},
+		choice[string]{6, comments},
+		choice[string]{4, blanks},
+	)
+	ignores := hegel.Composite(func(tc hegel.TestCase) ignoreSpec {
+		return ignoreSpec{lines: hegel.Draw(tc, many(lines, 0, 6)), finalNL: hegel.Draw(tc, chance(80))}
+	})
+	// dirsAt: a directory depth levels below the root's parent: up to four
+	// entries by name (at least one at the root), each a file, or a directory
+	// with content of its own 45% of the time (at the third level an empty
+	// one 15%); a .gitignore always at the root, 25% of the time below.
+	var dirsAt func(depth int) hegel.Generator[dirSpec]
+	dirsAt = func(depth int) hegel.Generator[dirSpec] {
+		var entries hegel.Generator[entrySpec]
+		if depth >= 3 {
+			entries = weighted(choice[entrySpec]{85, hegel.Just(entrySpec{})}, choice[entrySpec]{15, hegel.Just(entrySpec{dir: true})})
+		} else {
+			sub := hegel.Map(dirsAt(depth+1), func(d dirSpec) entrySpec { return entrySpec{dir: true, sub: d} })
+			entries = weighted(choice[entrySpec]{55, hegel.Just(entrySpec{})}, choice[entrySpec]{45, sub})
+		}
+		byName := hegel.Maps(nameTexts, entries).MaxSize(4)
+		own := optional(25, ignores)
+		if depth == 1 {
+			byName = byName.MinSize(1)
+			own = hegel.Map(ignores, ptrTo[ignoreSpec])
+		}
+		return hegel.Composite(func(tc hegel.TestCase) dirSpec {
+			return dirSpec{entries: hegel.Draw(tc, byName), ignore: hegel.Draw(tc, own)}
+		})
+	}
+	// roots: the root directory; with shapes, one tree in a hundred gets a
+	// ** pattern and the false-start path it misses (go-git/7) forced in,
+	// since a drawn tree holds such a path for a drawn pattern once in many
+	// thousand cases.
+	roots := dirsAt(1)
+	if shapes {
+		seeds := optional(1, backtrackSpecs)
+		roots = hegel.Composite(func(tc hegel.TestCase) dirSpec {
+			root := hegel.Draw(tc, dirsAt(1))
+			if seed := hegel.Draw(tc, seeds); seed != nil {
+				root = seed.into(root)
+			}
+			return root
+		})
+	}
+	trees := hegel.Composite(func(tc hegel.TestCase) treeSpec {
+		return treeSpec{root: hegel.Draw(tc, roots), crlf: hegel.Draw(tc, chance(10))}
+	})
+	return grammar{patterns: patterns, ignores: ignores, subdirs: dirsAt(2), trees: trees}
+}
+
+// wide: the grammar of the wide property, with the recorded bugs' shapes
+// unless HEGEL_NO_KNOWN=1; quiet: without them, the surroundings of the
+// narrow properties.
+var (
+	wide  = newGrammar(!noKnown)
+	quiet = newGrammar(false)
+)
+
+// ---------------------------------------------------------------------------
+// The generated worktree, as written.
+
+// tree is a generated worktree: directories, files and the .gitignore files
+// some directories declare. Paths are slash-joined, relative to the root.
+type tree struct {
+	dirs    []string          // every directory (not the root), parents before children
+	files   []string          // every regular file, including the .gitignore files
+	ignores map[string]string // .gitignore contents by directory ("" is the root)
+	crlf    bool              // the ignore files use CRLF line ends
+}
+
+// entries lists every path of the tree with whether it is a directory,
+// sorted.
+func (t *tree) entries() []entry {
+	var es []entry
+	for _, d := range t.dirs {
+		es = append(es, entry{d, true})
+	}
+	for _, f := range t.files {
+		es = append(es, entry{f, false})
+	}
+	sort.Slice(es, func(i, j int) bool { return es[i].path < es[j].path })
+	return es
+}
+
+type entry struct {
+	path  string
+	isDir bool
+}
+
+func (t *tree) String() string {
+	var b strings.Builder
+	for _, e := range t.entries() {
+		if e.isDir {
+			fmt.Fprintf(&b, "  %s/\n", e.path)
+		} else {
+			fmt.Fprintf(&b, "  %s\n", e.path)
+		}
+	}
+	for _, d := range sortedKeys(t.ignores) {
+		name := ".gitignore"
+		if d != "" {
+			name = d + "/.gitignore"
+		}
+		fmt.Fprintf(&b, "--- %s (%q)\n", name, t.ignores[d])
+	}
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// The scratch repository.
+
+// scratch is a git repository whose worktree is rewritten for every case.
+type scratch struct {
+	dir string
+}
+
+func newScratch(t testing.TB) *scratch {
+	t.Helper()
+	if _, err := exec.LookPath("git"); err != nil {
+		t.Skip("git not found")
+	}
+	dir := t.TempDir()
+	if out, err := gitCmd(dir, "init", "-q").CombinedOutput(); err != nil {
+		t.Fatalf("git init: %v\n%s", err, out)
+	}
+	return &scratch{dir: dir}
+}
+
+func gitCmd(dir string, args ...string) *exec.Cmd {
+	cmd := exec.Command("git", args...)
+	cmd.Dir = dir
+	cmd.Env = append(os.Environ(),
+		"GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_SYSTEM=/dev/null", "GIT_CONFIG_NOSYSTEM=1",
+		"HOME="+dir, "LC_ALL=C")
+	return cmd
+}
+
+// materialize empties the worktree and writes the tree into it.
+func (s *scratch) materialize(t *tree) error {
+	des, err := os.ReadDir(s.dir)
+	if err != nil {
+		return err
+	}
+	for _, de := range des {
+		if de.Name() == ".git" {
+			continue
+		}
+		if err := os.RemoveAll(filepath.Join(s.dir, de.Name())); err != nil {
+			return err
+		}
+	}
+	for _, d := range t.dirs {
+		if err := os.MkdirAll(filepath.Join(s.dir, filepath.FromSlash(d)), 0o755); err != nil {
+			return err
+		}
+	}
+	for _, f := range t.files {
+		content := ""
+		if strings.HasSuffix(f, ".gitignore") {
+			d := strings.TrimSuffix(strings.TrimSuffix(f, ".gitignore"), "/")
+			content = t.ignores[d]
+		}
+		if err := os.WriteFile(filepath.Join(s.dir, filepath.FromSlash(f)), []byte(content), 0o644); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// gitVerdict is git check-ignore's answer for one path.
+type gitVerdict struct {
+	ignored bool
+	source  string // the file and line of the deciding pattern, "" when none matched
+	pattern string
+}
+
+// checkIgnore asks git check-ignore about every entry.
+func (s *scratch) checkIgnore(es []entry) (map[string]gitVerdict, error) {
+	var in bytes.Buffer
+	for _, e := range es {
+		in.WriteString(e.path)
+		in.WriteByte(0)
+	}
+	cmd := gitCmd(s.dir, "check-ignore", "-v", "-z", "--non-matching", "--stdin")
+	cmd.Stdin = &in
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		if ee, ok := err.(*exec.ExitError); !ok || ee.ExitCode() != 1 {
+			return nil, fmt.Errorf("git check-ignore: %v\n%s", err, stderr.String())
+		}
+	}
+	fields := strings.Split(string(out), "\x00")
+	if len(fields) == 0 || fields[len(fields)-1] != "" {
+		return nil, fmt.Errorf("git check-ignore: output not NUL-terminated: %q", out)
+	}
+	fields = fields[:len(fields)-1]
+	if len(fields) != 4*len(es) {
+		return nil, fmt.Errorf("git check-ignore: %d fields for %d paths: %q", len(fields), len(es), out)
+	}
+	vs := map[string]gitVerdict{}
+	for i := range es {
+		source, _, pattern, path := fields[4*i], fields[4*i+1], fields[4*i+2], fields[4*i+3]
+		if path != es[i].path {
+			return nil, fmt.Errorf("git check-ignore: answered %q for %q", path, es[i].path)
+		}
+		vs[path] = gitVerdict{
+			ignored: source != "" && !strings.HasPrefix(pattern, "!"),
+			source:  source + ":" + fields[4*i+1],
+			pattern: pattern,
+		}
+	}
+	return vs, nil
+}
+
+// ---------------------------------------------------------------------------
+// go-git's walk.
+
+// goVerdicts walks the tree with gitignore.Scope, as Worktree.Status does:
+// the root patterns (info/exclude and the root .gitignore), then each
+// directory's own .gitignore as the walk descends, and the directory's
+// exclusion carried to everything below it.
+func goVerdicts(dir string, t *tree) (map[string]bool, error) {
+	fs := osfs.New(dir)
+	base, err := gitignore.RootPatterns(fs)
+	if err != nil {
+		return nil, fmt.Errorf("RootPatterns: %v", err)
+	}
+	vs := map[string]bool{}
+	var walk func(scope *gitignore.Scope, path []string) error
+	walk = func(scope *gitignore.Scope, path []string) error {
+		des, err := os.ReadDir(filepath.Join(dir, filepath.FromSlash(strings.Join(path, "/"))))
+		if err != nil {
+			return err
+		}
+		for _, de := range des {
+			if len(path) == 0 && de.Name() == ".git" {
+				continue
+			}
+			child := append(append([]string(nil), path...), de.Name())
+			rel := strings.Join(child, "/")
+			isDir := de.IsDir()
+			vs[rel] = scope.Match(child, isDir)
+			if !isDir {
+				continue
+			}
+			var readOwn func() ([]gitignore.Pattern, error)
+			if _, ok := t.ignores[rel]; ok {
+				readOwn = func() ([]gitignore.Pattern, error) { return gitignore.DirPatterns(fs, child) }
+			}
+			sub, err := scope.Descend(child, readOwn)
+			if err != nil {
+				return fmt.Errorf("Descend(%q): %v", rel, err)
+			}
+			if sub.Excluded() != vs[rel] {
+				return fmt.Errorf("Descend(%q).Excluded() = %v, Match = %v", rel, sub.Excluded(), vs[rel])
+			}
+			if err := walk(sub, child); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	if err := walk(gitignore.NewScope(base), nil); err != nil {
+		return nil, err
+	}
+	return vs, nil
+}
+
+// ---------------------------------------------------------------------------
+// The judge and the property.
+
+// judge writes the tree into the scratch repository, asks git check-ignore
+// and go-git's Scope walk about every entry, and reports the first entry
+// they disagree on as a mismatch of the shape known names.
+func judge(ht *hegel.T, s *scratch, tr *tree) {
+	if err := s.materialize(tr); err != nil {
+		fail(ht, "materialize: %v\n%s", err, tr)
+	}
+	es := tr.entries()
+	want, err := s.checkIgnore(es)
+	if err != nil {
+		fail(ht, "%v\n%s", err, tr)
+	}
+	got, err := goVerdicts(s.dir, tr)
+	if err != nil {
+		fail(ht, "go-git: %v\n%s", err, tr)
+	}
+	if len(got) != len(es) {
+		fail(ht, "go-git walked %d entries, the tree has %d\n%s", len(got), len(es), tr)
+	}
+	ignored := 0
+	for _, e := range es {
+		w := want[e.path]
+		g, ok := got[e.path]
+		if !ok {
+			fail(ht, "go-git did not walk %q\n%s", e.path, tr)
+		}
+		if w.ignored {
+			ignored++
+		}
+		if g != w.ignored {
+			shape := known(tr, e, w)
+			if shape != "" {
+				count("known " + shape)
+			}
+			kind := "file"
+			if e.isDir {
+				kind = "directory"
+			}
+			mismatch(ht, shape, "%s %q: go-git ignored=%v, git ignored=%v (git: %s %q)\n%s", kind, e.path, g, w.ignored, w.source, w.pattern, tr)
+		}
+	}
+	switch {
+	case ignored == 0:
+		count("nothing ignored")
+	case ignored == len(es):
+		count("everything ignored")
+	default:
+		count("some ignored")
+	}
+}
+
+// TestHegelIgnoreMatchesGit: a generated worktree with generated .gitignore
+// files, walked with Scope the way Worktree.Status walks it, gets the same
+// verdict for every entry as git check-ignore. The shapes of the recorded
+// bugs are drawn at their natural rate; each has its own property in
+// hegel_shapes_test.go.
+func TestHegelIgnoreMatchesGit(t *testing.T) {
+	s := newScratch(t)
+	property(t, func(ht *hegel.T) {
+		judge(ht, s, hegel.Draw(ht, wide.trees).build())
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..262d97a
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,220 @@
+package hegel
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/go-git/go-billy/v6/osfs"
+
+	git "github.com/go-git/go-git/v6"
+	"github.com/go-git/go-git/v6/plumbing/format/gitignore"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. They compare with git's documented behaviour, checked
+// against git 2.43 (git check-ignore -v and git status --ignored).
+
+// writeTree writes files (path -> content) under dir, creating directories;
+// a path ending in "/" is an empty directory.
+func writeTree(t *testing.T, dir string, files map[string]string) {
+	t.Helper()
+	for p, content := range files {
+		full := filepath.Join(dir, filepath.FromSlash(p))
+		if strings.HasSuffix(p, "/") {
+			if err := os.MkdirAll(full, 0o755); err != nil {
+				t.Fatal(err)
+			}
+			continue
+		}
+		if err := os.MkdirAll(filepath.Dir(full), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(full, []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// scopeMatch walks to the directory of path with Scope, reading each
+// directory's .gitignore, and reports whether path is ignored.
+func scopeMatch(t *testing.T, dir string, path string, isDir bool) bool {
+	t.Helper()
+	fs := osfs.New(dir)
+	base, err := gitignore.RootPatterns(fs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	scope := gitignore.NewScope(base)
+	comps := strings.Split(path, "/")
+	for i := 1; i < len(comps); i++ {
+		// A copy: DirPatterns appends to its argument (go-git/4), which with a
+		// sub-slice of comps would overwrite comps[i].
+		d := append([]string(nil), comps[:i]...)
+		scope, err = scope.Descend(d, func() ([]gitignore.Pattern, error) { return gitignore.DirPatterns(fs, d) })
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	return scope.Match(comps, isDir)
+}
+
+// go-git/1: "ba/**" ignores everything inside ba, not ba itself; git therefore
+// still reads ba/.gitignore, whose "!x" re-includes ba/x (git status shows
+// "?? ba/x"). go-git's Scope reports ba excluded, never reads ba/.gitignore,
+// and Worktree.Status omits ba/x.
+func TestHegelPinTrailingDoubleStarKeepsDirectory(t *testing.T) {
+	dir := t.TempDir()
+	writeTree(t, dir, map[string]string{
+		".gitignore":    "ba/**\n",
+		"ba/.gitignore": "!x\n",
+		"ba/x":          "",
+		"ba/y":          "",
+	})
+	if scopeMatch(t, dir, "ba", true) {
+		t.Errorf("Scope: directory ba is excluded by \"ba/**\"; git check-ignore does not match it (only its contents)")
+	}
+	if !scopeMatch(t, dir, "ba/y", false) {
+		t.Errorf("Scope: ba/y not ignored; git ignores it")
+	}
+	if scopeMatch(t, dir, "ba/x", false) {
+		t.Errorf("Scope: ba/x ignored; git re-includes it through ba/.gitignore")
+	}
+
+	repo, err := git.PlainInit(dir, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w, err := repo.Worktree()
+	if err != nil {
+		t.Fatal(err)
+	}
+	st, err := w.Status()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !st.IsUntracked("ba/x") {
+		t.Errorf("Worktree.Status: ba/x not untracked (ignored); git status: ?? ba/x\n%s", st)
+	}
+	if st.IsUntracked("ba/y") {
+		t.Errorf("Worktree.Status: ba/y untracked; git status ignores it")
+	}
+}
+
+// go-git/2: git's trim_trailing_spaces keeps an escaped space and drops the
+// unescaped spaces after it: the line `a\  ` is the pattern `a\ `, matching
+// the file "a ". go-git strips every trailing space, leaving `a\`, which
+// matches nothing.
+func TestHegelPinEscapedSpaceThenSpaces(t *testing.T) {
+	dir := t.TempDir()
+	writeTree(t, dir, map[string]string{
+		".gitignore": "a\\  \n",
+		"a ":         "",
+		"a":          "",
+	})
+	if !scopeMatch(t, dir, "a ", false) {
+		t.Errorf("`a\\  ` (escaped space, then a space) does not ignore the file \"a \"; git does (the pattern is `a\\ `)")
+	}
+	if scopeMatch(t, dir, "a", false) {
+		t.Errorf("`a\\  ` ignores the file \"a\"; git does not")
+	}
+}
+
+// go-git/3: a doubled slash in a pattern matches nothing in git (no path has
+// an empty component); go-git skips the empty segment, so "a//b" matches a/b
+// and "a//" is "a/".
+func TestHegelPinDoubledSlashMatchesNothing(t *testing.T) {
+	dir := t.TempDir()
+	writeTree(t, dir, map[string]string{
+		".gitignore": "a//b\nc//\n",
+		"a/b":        "",
+		"c/x":        "",
+	})
+	if scopeMatch(t, dir, "a/b", false) {
+		t.Errorf("\"a//b\" ignores a/b; git matches nothing with a doubled slash")
+	}
+	if scopeMatch(t, dir, "c/x", false) {
+		t.Errorf("\"c//\" ignores c/x; git matches nothing with a doubled slash")
+	}
+}
+
+// go-git/4: DirPatterns (readIgnoreFile) builds the file name with
+// append(path, ".gitignore"), writing into the caller's slice when it has
+// spare capacity: the component after the prefix is replaced by ".gitignore".
+func TestHegelPinDirPatternsLeavesPathAlone(t *testing.T) {
+	dir := t.TempDir()
+	writeTree(t, dir, map[string]string{"a/.gitignore": "x\n", "a/b": ""})
+	comps := []string{"a", "b"}
+	if _, err := gitignore.DirPatterns(osfs.New(dir), comps[:1]); err != nil {
+		t.Fatal(err)
+	}
+	if comps[1] != "b" {
+		t.Errorf("after DirPatterns(fs, comps[:1]), comps = %q; the caller's slice was written to", comps)
+	}
+}
+
+// go-git/5: a negated pattern re-includes the entries it matches, not what
+// lies below one that is a directory: with `*` then `!ba`, git shows ba as
+// not ignored and ba/x as ignored by `*`. go-git's Pattern.Match reports a
+// match of an ancestor directory as a match of the path (right for an
+// exclusion, whose effect reaches everything below), for negations too, so
+// `!ba`, `!/*` or `!/*/` re-include everything below the directories they
+// name.
+func TestHegelPinNegatedDirectoryDoesNotReincludeContents(t *testing.T) {
+	for _, neg := range []string{"!ba", "!/*", "!/*/", "!b?/"} {
+		dir := t.TempDir()
+		writeTree(t, dir, map[string]string{
+			".gitignore": "*\n" + neg + "\n",
+			"ba/x":       "",
+		})
+		if scopeMatch(t, dir, "ba", true) {
+			t.Errorf("%q: directory ba ignored; git re-includes it", neg)
+		}
+		if !scopeMatch(t, dir, "ba/x", false) {
+			t.Errorf("%q: ba/x not ignored; git ignores it by \"*\" (the negation names only ba)", neg)
+		}
+	}
+}
+
+// go-git/6: a bracket expression may contain "/" (it cannot match a slash,
+// but "[a/b]" is one segment matching the names a and b in git); go-git splits
+// the pattern on every slash first, so "[a/b]" becomes the segments "[a" and
+// "b]" and matches nothing.
+func TestHegelPinSlashInsideBrackets(t *testing.T) {
+	dir := t.TempDir()
+	writeTree(t, dir, map[string]string{
+		".gitignore": "[a/b]\n",
+		"a":          "",
+		"b":          "",
+		"c":          "",
+	})
+	for _, f := range []string{"a", "b"} {
+		if !scopeMatch(t, dir, f, false) {
+			t.Errorf("\"[a/b]\" does not ignore %s; git does", f)
+		}
+	}
+	if scopeMatch(t, dir, "c", false) {
+		t.Errorf("\"[a/b]\" ignores c; git does not")
+	}
+}
+
+// go-git/7: a ** segment stands for any run of directories, so in git
+// "**/*/b" ignores a/c/b (the ** is a, the * is c) and "**/a/b" ignores a/a/b
+// (the ** is the first a). go-git's globMatch lets the ** consume components
+// only up to the first one the next segment matches (a in both) and never
+// backtracks, so b is tried against c, or against the second a, and both
+// paths are missed.
+func TestHegelPinDoubleStarBacktracks(t *testing.T) {
+	for _, c := range []struct{ pattern, path string }{{"**/*/b", "a/c/b"}, {"**/a/b", "a/a/b"}} {
+		comps := strings.Split(c.path, "/")
+		if got := gitignore.ParsePattern(c.pattern, nil).Match(comps, false); got != gitignore.Exclude {
+			t.Errorf("ParsePattern(%q).Match(%q) = %v, want Exclude as git gives", c.pattern, comps, got)
+		}
+		dir := t.TempDir()
+		writeTree(t, dir, map[string]string{".gitignore": c.pattern + "\n", c.path: ""})
+		if !scopeMatch(t, dir, c.path, false) {
+			t.Errorf("Scope: %q does not ignore %s; git does (the ** stands for the first directory)", c.pattern, c.path)
+		}
+	}
+}
diff --git a/hegel/hegel_shapes_test.go b/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..66455c4
--- /dev/null
+++ b/hegel/hegel_shapes_test.go
@@ -0,0 +1,489 @@
+package hegel
+
+// One property per recorded bug (bugs.toml): a worktree of the shapes-off
+// grammar with the entries and root patterns of the bug's shape region forced
+// in, judged as the wide property judges (every entry's verdict against git
+// check-ignore), so that each bug has a property that finds it every run (the
+// wide property reaches the shapes at their natural rate). Under
+// HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch
+// instead (a trailing /**/*, an escaped space alone, a single slash, a path
+// prefix without spare capacity, a negation naming the file, a bracket
+// expression without a slash, a ** path without a false start) and passes.
+
+import (
+	"maps"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/go-git/go-billy/v6/osfs"
+	"hegel.dev/go/hegel"
+
+	"github.com/go-git/go-git/v6/plumbing/format/gitignore"
+)
+
+// shapeCase: a tree of the shapes-off grammar with the entries and root
+// lines of one bug's region forced in: a forced entry replaces a drawn root
+// entry of its name, the forced lines follow the root .gitignore's own.
+type shapeCase struct {
+	tree    treeSpec
+	entries map[string]entrySpec
+	lines   []string
+}
+
+func (c shapeCase) build() *tree {
+	root := c.tree.root
+	entries := maps.Clone(root.entries)
+	if entries == nil {
+		entries = map[string]entrySpec{}
+	}
+	maps.Copy(entries, c.entries)
+	ignore := *root.ignore
+	ignore.lines = append(slices.Clone(ignore.lines), c.lines...)
+	root.entries, root.ignore = entries, &ignore
+	return treeSpec{root: root, crlf: c.tree.crlf}.build()
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c shapeCase) GoString() string { return c.build().String() }
+
+// dirWith is the directory sub with the file f among its entries.
+func dirWith(sub dirSpec, f string) dirSpec {
+	entries := maps.Clone(sub.entries)
+	if entries == nil {
+		entries = map[string]entrySpec{}
+	}
+	entries[f] = entrySpec{}
+	return dirSpec{entries: entries, ignore: sub.ignore}
+}
+
+// distinctNames: two different names of the pool: the i-th and the one shift
+// places after it, modulo the pool.
+func distinctNames(pool []string) hegel.Generator[pair[string, string]] {
+	return hegel.Map(pairs(hegel.Integers(0, len(pool)-1), hegel.Integers(1, len(pool)-1)), func(p pair[int, int]) pair[string, string] {
+		return pair[string, string]{pool[p.a], pool[(p.a+p.b)%len(pool)]}
+	})
+}
+
+// --------------------------------------------------------------------------- go-git/1
+
+// doubleStarCases: a directory at the root (holding a drawn subtree) and a
+// root line naming it with a trailing /** (anchored or with a trailing slash
+// some of the time), the shape of go-git/1; under HEGEL_NO_KNOWN=1 with a
+// trailing /**/*, which names the contents alone in both.
+var doubleStarCases = hegel.Composite(func(tc hegel.TestCase) shapeCase {
+	name := hegel.Draw(tc, nameTexts)
+	p := patternSpec{
+		leading:  hegel.Draw(tc, chance(20)),
+		segments: append([]string{escapeName(name)}, shaped([]string{"**"}, []string{"**", "*"})...),
+		trailing: hegel.Draw(tc, chance(20)),
+	}
+	return shapeCase{
+		tree:    hegel.Draw(tc, quiet.trees),
+		entries: map[string]entrySpec{name: {dir: true, sub: hegel.Draw(tc, quiet.subdirs)}},
+		lines:   []string{p.String()},
+	}
+})
+
+// TestHegelTrailingDoubleStarLeavesTheDirectoryAlone: a pattern ending in /**
+// matches everything inside the directory it names and not the directory
+// (gitignore(5)), as git check-ignore answers; go-git's globMatch takes a
+// directory candidate with nothing left after the earlier segments as a
+// match, so Scope excludes the directory and never reads its .gitignore
+// (go-git/1).
+func TestHegelTrailingDoubleStarLeavesTheDirectoryAlone(t *testing.T) {
+	s := newScratch(t)
+	property(t, func(ht *hegel.T) {
+		judge(ht, s, hegel.Draw(ht, doubleStarCases).build())
+	})
+}
+
+// --------------------------------------------------------------------------- go-git/2
+
+// escapedSpaceCases: a file whose name ends in a space, and a root line
+// spelling the name with the space escaped and one or two more spaces after
+// it (the shape of go-git/2); under HEGEL_NO_KNOWN=1 with the escaped space
+// alone.
+var escapedSpaceCases = hegel.Composite(func(tc hegel.TestCase) shapeCase {
+	base := hegel.Draw(tc, nameTexts)
+	p := patternSpec{
+		leading:  hegel.Draw(tc, chance(20)),
+		segments: []string{escapeName(base)},
+		tail:     hegel.Draw(tc, shaped(hegel.SampledFrom([]string{"\\  ", "\\   "}), hegel.Just("\\ "))),
+	}
+	return shapeCase{
+		tree:    hegel.Draw(tc, quiet.trees),
+		entries: map[string]entrySpec{base + " ": {}},
+		lines:   []string{p.String()},
+	}
+})
+
+// TestHegelEscapedSpaceKeepsItsBackslash: git's trim_trailing_spaces drops
+// the unescaped trailing spaces of a line and keeps an escaped one with its
+// backslash, so `a\` followed by two spaces is the pattern `a\ `, which
+// ignores the file "a "; go-git strips every trailing space, leaving `a\`,
+// which matches nothing (go-git/2).
+func TestHegelEscapedSpaceKeepsItsBackslash(t *testing.T) {
+	s := newScratch(t)
+	property(t, func(ht *hegel.T) {
+		judge(ht, s, hegel.Draw(ht, escapedSpaceCases).build())
+	})
+}
+
+// --------------------------------------------------------------------------- go-git/3
+
+// doubledSlashLine spells the pattern of variant v (modulo three) for the
+// directory d and its file f: d//f, d//, //d with a doubled slash, else with
+// a single one.
+func doubledSlashLine(d, f string, v int, doubled bool) string {
+	sep := "/"
+	if doubled {
+		sep = "//"
+	}
+	switch v % 3 {
+	case 0:
+		return d + sep + f
+	case 1:
+		return d + sep
+	}
+	return sep + d
+}
+
+// doubledSlashCases: a directory d with a file f inside and a root line with
+// a doubled slash naming them (the shape of go-git/3); under HEGEL_NO_KNOWN=1
+// the single-slash spelling.
+var doubledSlashCases = hegel.Composite(func(tc hegel.TestCase) shapeCase {
+	d, f := hegel.Draw(tc, nameTexts), hegel.Draw(tc, nameTexts)
+	return shapeCase{
+		tree:    hegel.Draw(tc, quiet.trees),
+		entries: map[string]entrySpec{d: {dir: true, sub: dirWith(hegel.Draw(tc, quiet.subdirs), f)}},
+		lines:   []string{doubledSlashLine(escapeName(d), escapeName(f), hegel.Draw(tc, hegel.Integers(0, 2)), shaped(true, false))},
+	}
+})
+
+// TestHegelDoubledSlashMatchesNothing: a doubled slash in a pattern matches
+// nothing in git (no path has an empty component, and wildmatch wants a
+// slash for each slash of the pattern); go-git skips the empty segment, so
+// a//b ignores a/b, c// the contents of c and //d the entry d (go-git/3).
+func TestHegelDoubledSlashMatchesNothing(t *testing.T) {
+	s := newScratch(t)
+	property(t, func(ht *hegel.T) {
+		judge(ht, s, hegel.Draw(ht, doubledSlashCases).build())
+	})
+}
+
+// --------------------------------------------------------------------------- go-git/4
+
+// pathCase: the components of a path being walked, and which proper prefix
+// of them (modulo the choices) DirPatterns is called with.
+type pathCase struct {
+	comps []string
+	at    int
+}
+
+var pathCases = hegel.Composite(func(tc hegel.TestCase) pathCase {
+	return pathCase{comps: hegel.Draw(tc, many(nameTexts, 2, 4)), at: hegel.Draw(tc, positions)}
+})
+
+// TestHegelDirPatternsLeavesThePathAlone: DirPatterns reads the .gitignore of
+// the directory at path and leaves its argument as it was; go-git builds the
+// file name with append(path, ".gitignore"), which writes into the caller's
+// slice when it has spare capacity, so a prefix of the path being walked
+// (the argument Scope.Descend's readOwn naturally takes) has its next
+// component replaced by ".gitignore" (go-git/4). Under HEGEL_NO_KNOWN=1 the
+// prefix is passed without spare capacity.
+func TestHegelDirPatternsLeavesThePathAlone(t *testing.T) {
+	fs := osfs.New(t.TempDir())
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pathCases)
+		comps := slices.Clone(c.comps)
+		k := 1 + c.at%(len(comps)-1)
+		if _, err := gitignore.DirPatterns(fs, shaped(comps[:k], comps[:k:k])); err != nil {
+			ht.Fatalf("DirPatterns(%q): %v", comps[:k], err)
+		}
+		if !slices.Equal(comps, c.comps) {
+			mismatch(ht, shaped("go-git/4", ""), "after DirPatterns(fs, comps[:%d]) the path is %q, was %q: the caller's slice was written to", k, comps, c.comps)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-git/5
+
+// negationLine spells the negation of variant v (modulo five) re-including
+// the directory d: !d, !/d, !d/, !/*, !/*/; without dirOnly the one
+// re-including its file f alone, !d/f.
+func negationLine(d, f string, v int, dirOnly bool) string {
+	if !dirOnly {
+		return "!" + d + "/" + f
+	}
+	switch v % 5 {
+	case 0:
+		return "!" + d
+	case 1:
+		return "!/" + d
+	case 2:
+		return "!" + d + "/"
+	case 3:
+		return "!/*"
+	}
+	return "!/*/"
+}
+
+// negatedDirCases: a directory d holding a file f of another name, and two
+// root lines: an exclusion matching everything (* or **) and a negation
+// matching the directory (the shape of go-git/5); under HEGEL_NO_KNOWN=1 a
+// negation naming the file inside, which re-includes nothing in either since
+// the directory stays excluded.
+var negatedDirCases = hegel.Composite(func(tc hegel.TestCase) shapeCase {
+	dirAndFile := hegel.Draw(tc, distinctNames(names))
+	d, f := dirAndFile.a, dirAndFile.b
+	return shapeCase{
+		tree:    hegel.Draw(tc, quiet.trees),
+		entries: map[string]entrySpec{d: {dir: true, sub: dirWith(hegel.Draw(tc, quiet.subdirs), f)}},
+		lines: []string{
+			hegel.Draw(tc, hegel.SampledFrom([]string{"*", "**"})),
+			negationLine(escapeName(d), escapeName(f), hegel.Draw(tc, hegel.Integers(0, 4)), shaped(true, false)),
+		},
+	}
+})
+
+// TestHegelNegatedDirectoryReincludesOnlyItself: a negated pattern
+// re-includes the entries it matches and nothing below one that is a
+// directory: with * then !ba, git re-includes ba and ignores ba/x by *.
+// go-git's Pattern.Match reports a match of an ancestor directory as a match
+// of the path, for negations too, so ba/x is re-included (go-git/5).
+func TestHegelNegatedDirectoryReincludesOnlyItself(t *testing.T) {
+	s := newScratch(t)
+	property(t, func(ht *hegel.T) {
+		judge(ht, s, hegel.Draw(ht, negatedDirCases).build())
+	})
+}
+
+// --------------------------------------------------------------------------- go-git/6
+
+// singleChars: one-character names a bracket expression can name.
+var singleChars = []string{"a", "b", "c", "A", "B", "1"}
+
+// bracketLine spells the bracket expression of variant v (modulo three)
+// naming x and y: [x/y], [/x], [x/] with a slash inside, else [xy], [x], [x].
+func bracketLine(x, y string, v int, slash bool) string {
+	sep := ""
+	if slash {
+		sep = "/"
+	}
+	switch v % 3 {
+	case 0:
+		return "[" + x + sep + y + "]"
+	case 1:
+		return "[" + sep + x + "]"
+	}
+	return "[" + x + sep + "]"
+}
+
+// slashInBracketsCases: two files at the root with distinct one-character
+// names and a root line whose bracket expression names them with a slash
+// inside (the shape of go-git/6); under HEGEL_NO_KNOWN=1 without the slash.
+var slashInBracketsCases = hegel.Composite(func(tc hegel.TestCase) shapeCase {
+	xy := hegel.Draw(tc, distinctNames(singleChars))
+	return shapeCase{
+		tree:    hegel.Draw(tc, quiet.trees),
+		entries: map[string]entrySpec{xy.a: {}, xy.b: {}},
+		lines:   []string{bracketLine(xy.a, xy.b, hegel.Draw(tc, hegel.Integers(0, 2)), shaped(true, false))},
+	}
+})
+
+// TestHegelSlashInsideBracketsIsOneSegment: a bracket expression may contain
+// a slash (it cannot match one, but [a/b] is one segment matching the names
+// a and b in git); go-git splits the pattern on every slash first, so [a/b]
+// becomes the segments [a and b] and matches nothing (go-git/6).
+func TestHegelSlashInsideBracketsIsOneSegment(t *testing.T) {
+	s := newScratch(t)
+	property(t, func(ht *hegel.T) {
+		judge(ht, s, hegel.Draw(ht, slashInBracketsCases).build())
+	})
+}
+
+// --------------------------------------------------------------------------- go-git/7
+
+// segmentKind is a slash-free pattern segment with the names of the pool it
+// matches, so that a path can be built to match or to miss it without
+// asking the library.
+type segmentKind struct {
+	seg  string
+	hits []string
+}
+
+// globKinds: the wildcard segments a ** may be followed by, the plain star
+// first, each with the names of the pool it matches (checked against
+// wildmatch and git check-ignore).
+var globKinds = []segmentKind{
+	{"*", names},
+	{"?", []string{"a", "b", "c", "A", "B", "1", "-"}},
+	{"a*", []string{"a", "ab", "aa", "abc", "a.b", "a.c", "a-b", "a_b", "a1", "a b", "a*", "a?", "a ", "a]"}},
+	{"*a", []string{"a", "ba", "aa", "b.a", ".a", "!a", "#a"}},
+	{"a?", []string{"ab", "aa", "a1", "a ", "a*", "a?", "a]"}},
+	{"[ab]", []string{"a", "b"}},
+	{"[!a]", []string{"b", "c", "A", "B", "1", "-"}},
+}
+
+// segmentKinds: a wildcard segment half of the time, else a name spelled
+// literally, matching itself alone.
+var segmentKinds = weighted(
+	choice[segmentKind]{50, hegel.SampledFrom(globKinds)},
+	choice[segmentKind]{50, hegel.Map(nameTexts, func(n string) segmentKind { return segmentKind{escapeName(n), []string{n}} })},
+)
+
+// without is pool without the excluded names.
+func without(pool []string, excluded ...string) []string {
+	var out []string
+	for _, n := range pool {
+		if !slices.Contains(excluded, n) {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// at is the element of pool at position i modulo its size, or "" for no
+// position or an empty pool.
+func at(pool []string, i *int) string {
+	if i == nil || len(pool) == 0 {
+		return ""
+	}
+	return pool[*i%len(pool)]
+}
+
+// backtrackSpec: a pattern with a ** followed by a segment S and a segment
+// R (`**/S/R`, `x/**/S/R`, `**/S/*/R`, with a trailing slash some of the
+// time) and the path it names in git through a false start: F/T/R, where S
+// matches F and T and R matches neither (`**/*/b` against a/c/b, `**/a/b`
+// against a/a/b), so that git ignores the path and go-git's **, which
+// stops at F and never backtracks, misses it (go-git/7). The negated
+// variant excludes R's name everywhere and re-includes the path with the
+// pattern, which go-git misses too. Under HEGEL_NO_KNOWN=1 the components
+// before T are ones S does not match (none at all after a star), the
+// neighbouring region without a false start.
+type backtrackSpec struct {
+	lead       string      // "" or a literal first segment, the path's first component
+	above      string      // "" or a component the ** consumes before the false start
+	kind       segmentKind // S
+	falseStart string      // F, "" for none
+	match      string      // T
+	middle     string      // "" or the component of an extra * segment between S and R
+	rest       string      // R's name
+	dirOnly    bool
+	negate     bool
+}
+
+var backtrackSpecs = hegel.Composite(func(tc hegel.TestCase) backtrackSpec {
+	kind := hegel.Draw(tc, segmentKinds)
+	match := at(kind.hits, ptrTo(hegel.Draw(tc, positions)))
+	rest := at(without(names, match), ptrTo(hegel.Draw(tc, positions)))
+	// starts: what may stand before T: with shapes the names S matches, else
+	// the names it does not; never R's name, which the negated variant
+	// excludes everywhere.
+	starts := shaped(without(kind.hits, rest), without(names, append([]string{rest}, kind.hits...)...))
+	return backtrackSpec{
+		kind:       kind,
+		match:      match,
+		rest:       rest,
+		lead:       at(without(names, rest), hegel.Draw(tc, optional(25, positions))),
+		above:      at(starts, hegel.Draw(tc, optional(25, positions))),
+		falseStart: at(starts, ptrTo(hegel.Draw(tc, positions))),
+		middle:     at(without(names, rest), hegel.Draw(tc, optional(20, positions))),
+		dirOnly:    hegel.Draw(tc, chance(15)),
+		negate:     hegel.Draw(tc, chance(20)),
+	}
+})
+
+// pattern spells the line without its negation mark: [lead/]**/S[/*]/R[/].
+func (s backtrackSpec) pattern() string {
+	var segs []string
+	if s.lead != "" {
+		segs = append(segs, escapeName(s.lead))
+	}
+	segs = append(segs, "**", s.kind.seg)
+	if s.middle != "" {
+		segs = append(segs, "*")
+	}
+	segs = append(segs, escapeName(s.rest))
+	p := strings.Join(segs, "/")
+	if s.dirOnly {
+		p += "/"
+	}
+	return p
+}
+
+// lines: the root .gitignore lines: the pattern, or for the negated variant
+// the exclusion of R's name everywhere and the negated pattern.
+func (s backtrackSpec) lines() []string {
+	if s.negate {
+		return []string{escapeName(s.rest), "!" + s.pattern()}
+	}
+	return []string{s.pattern()}
+}
+
+// path: the components of the entry the pattern names in git.
+func (s backtrackSpec) path() []string {
+	var comps []string
+	for _, c := range []string{s.lead, s.above, s.falseStart, s.match, s.middle, s.rest} {
+		if c != "" {
+			comps = append(comps, c)
+		}
+	}
+	return comps
+}
+
+// into is the directory root with the lines added to its .gitignore and the
+// path forced into its entries.
+func (s backtrackSpec) into(root dirSpec) dirSpec {
+	ignore := *root.ignore
+	ignore.lines = append(slices.Clone(ignore.lines), s.lines()...)
+	return dirSpec{entries: withPath(root.entries, s.path(), s.dirOnly), ignore: &ignore}
+}
+
+// withPath is entries with the entry at comps forced in (an empty directory
+// when dir, else a file): the directories on the way keep their content and
+// their .gitignore, a file or directory in the entry's place is replaced.
+func withPath(entries map[string]entrySpec, comps []string, dir bool) map[string]entrySpec {
+	out := maps.Clone(entries)
+	if out == nil {
+		out = map[string]entrySpec{}
+	}
+	name := comps[0]
+	if len(comps) == 1 {
+		out[name] = entrySpec{dir: dir}
+		return out
+	}
+	var sub dirSpec
+	if e := out[name]; e.dir {
+		sub = e.sub
+	}
+	out[name] = entrySpec{dir: true, sub: dirSpec{entries: withPath(sub.entries, comps[1:], dir), ignore: sub.ignore}}
+	return out
+}
+
+// doubleStarBacktrackCases: a tree of the shapes-off grammar with a **
+// pattern and its false-start path forced in at the root (the shape of
+// go-git/7); under HEGEL_NO_KNOWN=1 the path without the false start.
+var doubleStarBacktrackCases = hegel.Composite(func(tc hegel.TestCase) shapeCase {
+	s := hegel.Draw(tc, backtrackSpecs)
+	return shapeCase{
+		tree:    hegel.Draw(tc, quiet.trees),
+		entries: withPath(nil, s.path(), s.dirOnly),
+		lines:   s.lines(),
+	}
+})
+
+// TestHegelDoubleStarBacktracks: a ** segment stands for any run of
+// directories, so `**/*/b` ignores a/c/b and `**/a/b` ignores a/a/b in git;
+// go-git's globMatch lets the ** consume components only up to the first one
+// the next segment matches and never backtracks, so a path whose first
+// candidate is a false start is missed, and a negation of that shape
+// re-includes nothing (go-git/7).
+func TestHegelDoubleStarBacktracks(t *testing.T) {
+	s := newScratch(t)
+	property(t, func(ht *hegel.T) {
+		judge(ht, s, hegel.Draw(ht, doubleStarBacktrackCases).build())
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..fc99aae
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,241 @@
+package hegel
+
+// Hegel property tests for go-git. A generated worktree (directories, files,
+// .gitignore files with generated patterns) is walked with
+// plumbing/format/gitignore's Scope, the way Worktree.Status walks it, and
+// every entry's verdict is compared with git check-ignore's on the same tree.
+//
+// The worktree is drawn as a small tree of records (hegel_gitignore_test.go)
+// and written by pure functions. The pattern shapes of the recorded bugs
+// (bugs.toml) are drawn at their natural rate, so the wide property fails on
+// them, naming the shape, and is an expected failure mapped to the bug
+// (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over its
+// shape region alone, and hegel_pins_test.go the regression examples.
+// HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below) for a run
+// that looks past the bugs: the generators leave the shapes out, and a
+// disagreement that still has a known shape is skipped.
+//
+// Needs the git binary. Set HEGEL_COLLECT=1 to make the properties record
+// mismatches instead of failing and print them at the end of each test.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape (mismatch); under HEGEL_NO_KNOWN=1
+// the shapes are left out of the generators (newGrammar(false), shaped) and a
+// disagreement that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with git on a case whose shape is that of
+// the recorded bug shape names ("" for none): the failure names the shape,
+// and under HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped
+// instead (rare then, since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
