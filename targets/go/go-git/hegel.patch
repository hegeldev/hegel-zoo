new file mode 100644
index 0000000..d0baaa4
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,181 @@
+package hegel
+
+import (
+	"strings"
+
+	"github.com/go-git/go-git/v6/plumbing/format/gitignore"
+)
+
+// known names the recorded bug (bugs.toml) that explains a disagreement
+// between go-git and git about entry e, or "" when none does. By default the
+// name only decorates the failure (the properties draw the bugs' shapes and
+// fail on them); under HEGEL_NO_KNOWN=1 the generators leave the shapes out
+// and a disagreement with a name is skipped (mismatch). The gates are on the
+// shape of the patterns in effect, coarsely: a tree with such a pattern
+// anywhere is attributed to it (go-git/1, /2, /3, /6); go-git/5 is
+// recognised on the entry's ancestors and go-git/7 on git's deciding
+// pattern, in that order, since a negation re-including an ancestor decides
+// the entry whatever the deciding pattern's shape. The pins in
+// hegel_pins_test.go reproduce each bug deterministically.
+func known(t *tree, e entry, git gitVerdict) string {
+	for _, content := range t.ignores {
+		for _, line := range lines(content) {
+			if k := knownShape(line); k != "" {
+				return k
+			}
+		}
+	}
+	// go-git/5: a negated pattern that matches an ancestor directory of the
+	// entry re-includes the entry (git re-includes the directory only).
+	if git.ignored {
+		comps := strings.Split(e.path, "/")
+		for dir, content := range t.ignores {
+			var domain []string
+			if dir != "" {
+				domain = strings.Split(dir, "/")
+			}
+			for _, line := range lines(content) {
+				if strings.HasPrefix(line, "#") || strings.TrimSpace(line) == "" || !strings.HasPrefix(line, "!") {
+					continue
+				}
+				p := gitignore.ParsePattern(line, domain)
+				for i := 1; i < len(comps); i++ {
+					if p.Match(comps[:i], true) == gitignore.Include {
+						return "go-git/5"
+					}
+				}
+			}
+		}
+	}
+	// go-git/7: the pattern git decided by has a ** followed by two segments,
+	// which go-git's ** never backtracks to satisfy.
+	if git.pattern != "" && doubleStarThenTwo(gitStored(git.pattern)) {
+		return "go-git/7"
+	}
+	return ""
+}
+
+// doubleStarThenTwo reports whether the pattern p (as git stores it) has a
+// ** segment followed by two segments neither of which is ** (`**/*/b`,
+// `**/a/b`, `x/**/a/b`, `**/a/b/**`; not `**/a/**/b`, whose second ** takes
+// whatever the first left). globMatch (pattern.go) lets a ** consume path
+// components only up to the first one the following segment matches and
+// never backtracks, so `**/*/b` misses a/c/b and `**/a/b` misses a/a/b,
+// which git's wildmatch matches (and a negation of that shape re-includes
+// nothing in go-git): the shape of go-git/7.
+func doubleStarThenTwo(p string) bool {
+	segs := strings.Split(strings.Trim(p, "/"), "/")
+	for i := 0; i+2 < len(segs); i++ {
+		if segs[i] == "**" && segs[i+1] != "**" && segs[i+2] != "**" {
+			return true
+		}
+	}
+	return false
+}
+
+// knownShape names the recorded bug whose pattern shape line has, or "".
+// The generator avoids these shapes under HEGEL_NO_KNOWN=1, so that rounds
+// look past the known bugs.
+func knownShape(line string) string {
+	if strings.HasPrefix(line, "#") || strings.TrimSpace(line) == "" {
+		return ""
+	}
+	p := gitTrimmed(line)
+	// go-git/1: a trailing "**" segment matches the directory that the
+	// pattern's earlier segments name, so the directory is excluded (or
+	// re-included) itself, and its .gitignore is never read.
+	q := strings.TrimSuffix(p, "/")
+	if q != "**" && strings.HasSuffix(q, "/**") {
+		return "go-git/1"
+	}
+	// go-git/2: trailing spaces after an escaped space are all stripped, the
+	// backslash included ("a\  " -> "a\").
+	if strings.HasSuffix(p, "\\ ") && strings.HasSuffix(line, "  ") {
+		return "go-git/2"
+	}
+	// go-git/3: a doubled slash is skipped instead of matching nothing
+	// ("a//b" matches a/b).
+	if strings.Contains(p, "//") {
+		return "go-git/3"
+	}
+	// go-git/6: a slash inside a bracket expression is split as a path
+	// separator ("[a/b]" matches nothing instead of the names a and b).
+	if slashInBrackets(p) {
+		return "go-git/6"
+	}
+	return ""
+}
+
+// slashInBrackets reports whether p has a "/" between a "[" and the "]"
+// closing it, read the way wildmatch reads brackets: an escaped character is
+// literal, a "]" first in the set is literal, "[:name:]" is a class.
+func slashInBrackets(p string) bool {
+	for i := 0; i < len(p); i++ {
+		switch p[i] {
+		case '\\':
+			i++
+		case '[':
+			j := i + 1
+			if j < len(p) && (p[j] == '!' || p[j] == '^') {
+				j++
+			}
+			if j < len(p) && p[j] == ']' {
+				j++
+			}
+			for ; j < len(p) && p[j] != ']'; j++ {
+				switch {
+				case p[j] == '\\':
+					j++
+				case p[j] == '[' && j+1 < len(p) && p[j+1] == ':':
+					if k := strings.Index(p[j+2:], ":]"); k >= 0 {
+						j += 2 + k + 1
+					}
+				case p[j] == '/':
+					return true
+				}
+			}
+			if j >= len(p) {
+				return false // unterminated: a literal "[" for wildmatch
+			}
+			i = j
+		}
+	}
+	return false
+}
+
+// lines splits an ignore file into lines, as both readers do: on "\n", a
+// trailing "\r" dropped.
+func lines(content string) []string {
+	ls := strings.Split(content, "\n")
+	for i, l := range ls {
+		ls[i] = strings.TrimSuffix(l, "\r")
+	}
+	return ls
+}
+
+// gitTrimmed applies git's trim_trailing_spaces (dir.c): trailing spaces are
+// dropped, except one preceded by a backslash, which is kept with the
+// backslash.
+func gitTrimmed(s string) string {
+	lastSpace := -1
+	for i := 0; i < len(s); i++ {
+		switch s[i] {
+		case ' ':
+			if lastSpace < 0 {
+				lastSpace = i
+			}
+		case '\\':
+			i++
+			if i >= len(s) {
+				return s
+			}
+			lastSpace = -1
+		default:
+			lastSpace = -1
+		}
+	}
+	if lastSpace >= 0 {
+		return s[:lastSpace]
+	}
+	return s
+}
