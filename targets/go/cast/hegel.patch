+// A slice (or array) of convertible scalars converts element-wise through
+// every ToXxxSliceE; a slice containing an unconvertible element is an
+// error; a []T comes back equal; a string splits on white space for
+// ToStringSliceE; a scalar becomes a one-element string slice.
+func TestHegelSlicesConvertElementWise(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, sliceCases)
+		in, items, vals, bad := c.build()
+		k := len(items)
+
+		gotI, err := cast.ToInt64SliceE(in)
+		if bad {
+			if err == nil {
+				fail(ht, "ToInt64SliceE(%v) = %v with no error", in, gotI)
+			}
+			if g := cast.ToInt64Slice(in); g != nil {
+				fail(ht, "ToInt64Slice(%v) = %v, want nil", in, g)
+			}
+		} else {
+			if err != nil {
+				fail(ht, "ToInt64SliceE(%v) failed: %v", in, err)
+			}
+			if !reflect.DeepEqual(gotI, append([]int64{}, vals...)) && !(k == 0 && len(gotI) == 0) {
+				fail(ht, "ToInt64SliceE(%v) = %v, want %v", in, gotI, vals)
+			}
+			wantI := make([]int, k)
+			wantS := make([]string, k)
+			wantF := make([]float64, k)
+			wantB := make([]bool, k)
+			wantD := make([]time.Duration, k)
+			for i, v := range vals {
+				wantI[i] = int(v)
+				wantS[i] = cast.ToString(items[i])
+				wantF[i] = float64(v)
+				wantB[i] = v != 0
+				wantD[i] = time.Duration(v)
+			}
+			if g, err := cast.ToIntSliceE(in); err != nil || !(reflect.DeepEqual(g, wantI) || k == 0 && len(g) == 0) {
+				fail(ht, "ToIntSliceE(%v) = %v, %v; want %v", in, g, err, wantI)
+			}
+			if g, err := cast.ToFloat64SliceE(in); err != nil || !(reflect.DeepEqual(g, wantF) || k == 0 && len(g) == 0) {
+				fail(ht, "ToFloat64SliceE(%v) = %v, %v; want %v", in, g, err, wantF)
+			}
+			if g, err := cast.ToDurationSliceE(in); err != nil || !(reflect.DeepEqual(g, wantD) || k == 0 && len(g) == 0) {
+				fail(ht, "ToDurationSliceE(%v) = %v, %v; want %v", in, g, err, wantD)
+			}
+			if g, err := cast.ToStringSliceE(in); err != nil || !(reflect.DeepEqual(g, wantS) || k == 0 && len(g) == 0) {
+				fail(ht, "ToStringSliceE(%v) = %v, %v; want %v", in, g, err, wantS)
+			}
+			noStrings := true
+			for _, s := range c.items {
+				noStrings = noStrings && !s.isText()
+			}
+			if noStrings {
+				if g, err := cast.ToBoolSliceE(in); err != nil || !(reflect.DeepEqual(g, wantB) || k == 0 && len(g) == 0) {
+					fail(ht, "ToBoolSliceE(%v) = %v, %v; want %v", in, g, err, wantB)
+				}
+			}
+		}
+		// a string splits on white space; a scalar is one element
+		line, words := c.line()
+		if g, err := cast.ToStringSliceE(line); err != nil || !(reflect.DeepEqual(g, words) || len(words) == 0 && len(g) == 0) {
+			fail(ht, "ToStringSliceE(%q) = %v, %v; want %v", line, g, err, words)
+		}
+		if k > 0 && !bad {
+			if g, err := cast.ToStringSliceE(items[0]); err != nil || !reflect.DeepEqual(g, []string{cast.ToString(items[0])}) {
+				fail(ht, "ToStringSliceE(%T %v) = %v, %v", items[0], items[0], g, err)
+			}
+		}
+	})
+}
+
+// mapKeys: the keys of the map cases.
+var mapKeys = []string{"a", "b", "c", "key", "K", "", "x y", "1", "-2", "é"}
+
+// mapCase: up to five entries of scalars under distinct keys, the Go map
+// type they arrive in, and an unconvertible spot at one of the keys (25%).
+type mapCase struct {
+	entries map[string]scalar
+	shape   int // 0 map[string]any, 1 map[any]any, 2 map[any]string, 3 map[string]int64, 4 map[string]string, 5 JSON text
+	bad     *badSpot
+}
+
+// badKey is the key the bad value goes under, when the map type can carry
+// it (never map[string]int64, and not the any-valued maps under
+// HEGEL_NO_KNOWN=1, whose conversions swallow the error: cast/7).
+func (c mapCase) badKey() (string, bool) {
+	if c.bad == nil || len(c.entries) == 0 || c.shape == 3 || (c.shape <= 1 && Known.mapValueErrors) {
+		return "", false
+	}
+	keys := sortedKeys(c.entries)
+	return keys[c.bad.at%len(keys)], true
+}
+
+// stored is the values as the map of the shape carries them: the scalar's
+// Go value (the any-valued maps), its string (the string-valued maps), its
+// int64 (map[string]int64 and the JSON text); the bad value replaces the
+// entry at the bad key (as its string in the string-valued maps).
+func (c mapCase) stored() map[string]any {
+	m := map[string]any{}
+	for k, s := range c.entries {
+		switch c.shape {
+		case 2, 4:
+			m[k] = cast.ToString(s.value())
+		case 3, 5:
+			m[k] = s.v
+		default:
+			m[k] = s.value()
+		}
+	}
+	if bk, ok := c.badKey(); ok {
+		v := c.bad.val
+		if c.shape == 2 || c.shape == 4 {
+			v = cast.ToString(v)
+		}
+		m[bk] = v
+	}
+	return m
+}
+
+// input is the stored values in the Go map type of the shape.
+func (c mapCase) input() any {
+	st := c.stored()
+	switch c.shape {
+	case 1:
+		m := map[any]any{}
+		for k, v := range st {
+			m[k] = v
+		}
+		return m
+	case 2:
+		m := map[any]string{}
+		for k, v := range st {
+			m[k] = v.(string)
+		}
+		return m
+	case 3:
+		m := map[string]int64{}
+		for k, v := range st {
+			m[k] = v.(int64)
+		}
+		return m
+	case 4:
+		m := map[string]string{}
+		for k, v := range st {
+			m[k] = v.(string)
+		}
+		return m
+	case 5:
+		// JSON text with numeric values: json.Unmarshal into the target map
+		// type does the conversion, so only the integer maps and ToStringMapE
+		// apply
+		b, _ := json.Marshal(st)
+		return string(b)
+	}
+	return st
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c mapCase) GoString() string {
+	in := c.input()
+	bk, ok := c.badKey()
+	if ok {
+		return fmt.Sprintf("%T %v (bad at %q)", in, in, bk)
+	}
+	return fmt.Sprintf("%T %v", in, in)
+}
+
+// mapWant is the expected result of each conversion: the model's value for
+// every drawn scalar and, for the bad entry, what the element conversion
+// says (an error, or its value).
+type mapWant struct {
+	int64s          map[string]int64
+	ints            map[string]int
+	strs            map[string]string
+	bools           map[string]bool
+	errInt, errStr  bool
+	errBool, hasTxt bool
+}
+
+func (c mapCase) want() mapWant {
+	w := mapWant{int64s: map[string]int64{}, ints: map[string]int{}, strs: map[string]string{}, bools: map[string]bool{}}
+	st := c.stored()
+	bk, hasBad := c.badKey()
+	for k, v := range st {
+		switch x := v.(type) {
+		case string, json.Number:
+			w.hasTxt = true
+		default:
+			_ = x
+		}
+		if hasBad && k == bk {
+			if i, err := cast.ToInt64E(v); err != nil {
+				w.errInt = true
+			} else {
+				w.int64s[k], w.ints[k] = i, int(i)
+			}
+			if s, err := cast.ToStringE(v); err != nil {
+				w.errStr = true
+			} else {
+				w.strs[k] = s
+			}
+			if b, err := cast.ToBoolE(v); err != nil {
+				w.errBool = true
+			} else {
+				w.bools[k] = b
+			}
+			continue
+		}
+		s := c.entries[k]
+		w.int64s[k], w.ints[k] = s.v, int(s.v)
+		w.strs[k] = cast.ToString(v)
+		w.bools[k] = s.v != 0
+	}
+	return w
+}
+
+// checkMap judges one map conversion: refused names the recorded bug when
+// the map type is refused (cast/12) and swallowed the one when a value
+// error is missing (cast/7); "" for a plain failure.
+func checkMap[V comparable](ht *hegel.T, name string, in any, got map[string]V, err error, want map[string]V, wantErr bool, refused, swallowed string) {
+	switch {
+	case wantErr && err == nil:
+		mismatch(ht, swallowed, "%s(%T %v) = %v with no error; a value does not convert", name, in, in, got)
+	case wantErr:
+	case err != nil:
+		mismatch(ht, refused, "%s(%T %v) failed: %v", name, in, in, err)
+	case !(reflect.DeepEqual(got, want) || len(got) == 0 && len(want) == 0):
+		fail(ht, "%s(%T %v) = %v, want %v", name, in, in, got, want)
+	}
+}
+
+var mapCases = hegel.Composite(func(tc hegel.TestCase) mapCase {
+	return mapCase{
+		entries: hegel.Draw(tc, hegel.Maps(hegel.SampledFrom(mapKeys), scalars).MaxSize(5)),
+		shape:   hegel.Draw(tc, hegel.Integers(0, 5)),
+		bad:     hegel.Draw(tc, optional(25, badSpots)),
+	}
+})
+
+// A map with string or any keys and convertible scalar values converts
+// value-wise through ToStringMapIntE / Int64E / StringE / BoolE /
+// ToStringMapE, whatever the Go map type carrying it (map[string]any,
+// map[any]any, map[string]int64, map[any]string…), with keys stringified
+// (map[any]string reaches a reflect path that panics: cast/11; the maps of
+// other value types are refused by the string, bool and any maps: cast/12);
+// the JSON text of the same map converts equally; a map containing an
+// unconvertible value is an error (the map[string]any / map[any]any kinds
+// swallow it: cast/7).
+func TestHegelMapsConvertValueWise(t *testing.T) {
+	property(t, func(ht *hegel.T) { checkMapCase(ht, hegel.Draw(ht, mapCases)) })
+}
+
+// checkMapCase is the body of TestHegelMapsConvertValueWise.
+func checkMapCase(ht *hegel.T, c mapCase) {
+	in := c.input()
+	k := len(c.entries)
+	w := c.want()
+	swallowed := ""
+	if c.shape <= 1 {
+		swallowed = "cast/7"
+	}
+
+	// the integer maps: map[any]string reaches the reflect path
+	if !(c.shape == 2 && k > 0 && Known.mapKeyPanic) {
+		panicShape := ""
+		if c.shape == 2 && k > 0 {
+			panicShape = "cast/11"
+		}
+		var gotI64 map[string]int64
+		var gotI map[string]int
+		var err64, errI error
+		if p := caught(func() { gotI64, err64 = cast.ToStringMapInt64E(in) }); p != nil {
+			mismatch(ht, panicShape, "ToStringMapInt64E(%T %v) panicked: %v", in, in, p)
+		}
+		checkMap(ht, "ToStringMapInt64E", in, gotI64, err64, w.int64s, w.errInt, "", swallowed)
+		if p := caught(func() { gotI, errI = cast.ToStringMapIntE(in) }); p != nil {
+			mismatch(ht, panicShape, "ToStringMapIntE(%T %v) panicked: %v", in, in, p)
+		}
+		checkMap(ht, "ToStringMapIntE", in, gotI, errI, w.ints, w.errInt, "", swallowed)
+	}
+	// the string map: not the JSON text (its numbers are not strings to
+	// json.Unmarshal, by design); map[string]int64 is refused (cast/12)
+	if c.shape != 5 && !(c.shape == 3 && Known.mapValueTypes) {
+		refused := ""
+		if c.shape == 3 {
+			refused = "cast/12"
+		}
+		g, err := cast.ToStringMapStringE(in)
+		checkMap(ht, "ToStringMapStringE", in, g, err, w.strs, w.errStr, refused, swallowed)
+	}
+	// the bool map: string values go through strconv.ParseBool ("7" is
+	// not a bool), checked elsewhere; map[string]int64 is refused (cast/12)
+	if (c.shape <= 1 && !w.hasTxt) || (c.shape == 3 && !Known.mapValueTypes) {
+		refused := ""
+		if c.shape == 3 {
+			refused = "cast/12"
+		}
+		g, err := cast.ToStringMapBoolE(in)
+		checkMap(ht, "ToStringMapBoolE", in, g, err, w.bools, w.errBool, refused, swallowed)
+	}
+	// the any map: the maps of other value types are refused (cast/12)
+	if other := c.shape >= 2 && c.shape <= 4; !(other && Known.mapValueTypes) {
+		refused := ""
+		if other {
+			refused = "cast/12"
+		}
+		g, err := cast.ToStringMapE(in)
+		switch {
+		case err != nil:
+			mismatch(ht, refused, "ToStringMapE(%T %v) failed: %v", in, in, err)
+		case len(g) != k:
+			fail(ht, "ToStringMapE(%T %v) = %v, want %d entries", in, in, g, k)
+		}
+	}
+	// the reflect path reports an unconvertible value
+	if m, ok := in.(map[string]string); ok && k > 0 {
+		bad := map[string]string{}
+		for key, v := range m {
+			bad[key] = v
+		}
+		bad[sortedKeys(m)[0]] = "x"
+		if g, err := cast.ToStringMapInt64E(bad); err == nil {
+			fail(ht, "ToStringMapInt64E(%v) = %v with no error", bad, g)
+		}
+	}
+}
+
+// sliceMapCase: up to four entries under the keys a to d, each a scalar or
+// a list of up to three, and the Go map type they arrive in.
+type sliceMapCase struct {
+	entries map[string]any // scalar or []scalar
+	shape   int            // 0 map[string]any, 1 map[any]any, 2 map[string][]any
+}
+
+// build is the input, the expected result, and whether a string value with
+// a blank sits directly in the map (the shape of cast/8 for map[any]any,
+// which splits it).
+func (c sliceMapCase) build() (in any, want map[string][]string, blank bool) {
+	items := map[string]any{}
+	want = map[string][]string{}
+	for k, v := range c.entries {
+		switch x := v.(type) {
+		case scalar:
+			items[k] = x.value()
+			want[k] = []string{cast.ToString(x.value())}
+			blank = blank || x.kind == 7
+		case []scalar:
+			var xs []any
+			var ws []string
+			for _, s := range x {
+				xs = append(xs, s.value())
+				ws = append(ws, cast.ToString(s.value()))
+			}
+			items[k], want[k] = xs, ws
+		}
+	}
+	in = items
+	switch c.shape {
+	case 1:
+		m := map[any]any{}
+		for k, x := range items {
+			m[k] = x
+		}
+		in = m
+	case 2:
+		m := map[string][]any{}
+		for k, x := range items {
+			if xs, ok := x.([]any); ok {
+				m[k] = xs
+			} else {
+				m[k] = []any{x}
+			}
+		}
+		in = m
+	}
+	return
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c sliceMapCase) GoString() string {
+	in, _, _ := c.build()
+	return fmt.Sprintf("%T %v", in, in)
+}
+
+var (
+	// sliceMapScalars: the scalars, and (unless HEGEL_NO_KNOWN=1) a string
+	// with a blank.
+	sliceMapScalars = shaped[hegel.Generator[scalar]](hegel.OneOf(scalars, spacedScalars), scalars)
+	// sliceMapValues: a scalar, or a list of up to three.
+	sliceMapValues = hegel.OneOf(asAny(sliceMapScalars), asAny(hegel.Lists(sliceMapScalars).MaxSize(3)))
+	sliceMapCases  = hegel.Composite(func(tc hegel.TestCase) sliceMapCase {
+		return sliceMapCase{
+			entries: hegel.Draw(tc, hegel.Maps(hegel.SampledFrom([]string{"a", "b", "c", "d"}), sliceMapValues).MaxSize(4)),
+			shape:   hegel.Draw(tc, hegel.Integers(0, 2)),
+		}
+	})
+)
+
+// ToStringMapStringSliceE: slice values are stringified element-wise,
+// scalar values become one-element slices, for every map kind alike (a
+// string value with a blank is split for map[any]any: cast/8).
+func TestHegelStringSliceMapsKeepValuesWhole(t *testing.T) {
+	property(t, func(ht *hegel.T) { checkSliceMap(ht, hegel.Draw(ht, sliceMapCases)) })
+}
+
+// checkSliceMap is the body of TestHegelStringSliceMapsKeepValuesWhole.
+func checkSliceMap(ht *hegel.T, c sliceMapCase) {
+	in, want, blank := c.build()
+	shape := ""
+	if c.shape == 1 && blank {
+		shape = "cast/8"
+	}
+	got, err := cast.ToStringMapStringSliceE(in)
+	if err != nil {
+		fail(ht, "ToStringMapStringSliceE(%T %v) failed: %v", in, in, err)
+	}
+	for key, ws := range want {
+		if g := got[key]; !(reflect.DeepEqual(g, ws) || len(g) == 0 && len(ws) == 0) {
+			mismatch(ht, shape, "ToStringMapStringSliceE(%T %v)[%q] = %q, want %q", in, in, key, g, ws)
+		}
+	}
+	if len(got) != len(want) {
+		fail(ht, "ToStringMapStringSliceE(%T %v) has %d keys, want %d", in, in, len(got), len(want))
+	}
+}
