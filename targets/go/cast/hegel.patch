+package cast_test
+
+// Hegel property tests for github.com/spf13/cast.
+//
+// There is no second implementation of cast to compare against, so the
+// oracle is the package's own contract as the README and doc comments state
+// it ("Cast does this intelligently when an obvious conversion is possible…
+// you can only convert a string to an int when it is a string representation
+// of an int"; the E variants "tell you if it successfully converted"; the
+// plain variants return the zero value on failure), made concrete by small
+// models: the exact value of a number and the range of each Go type, the
+// standard library's strconv/time parsers, element-wise conversion for
+// slices and maps, and the round trip ToX(ToString(v)) == v.
+//
+// Set CAST_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/spf13/cast"
+	"github.com/spf13/cast/internal"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("CAST_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func wide(tc hegel.TestCase, lo, hi int64) int64 {
+	return hegel.Draw(tc, hegel.Integers[int64](lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Numbers: the value model.
+
+// num is an exact numeric value: its integer part truncated toward zero
+// (big), whether a fractional part was dropped, its sign, its float64
+// reading, and whether it is NaN or an infinity.
+type num struct {
+	big     *big.Int
+	frac    bool
+	neg     bool
+	f       float64
+	special bool
+}
+
+func fromInt64(v int64) num {
+	return num{big: big.NewInt(v), neg: v < 0, f: float64(v)}
+}
+
+func fromUint64(v uint64) num {
+	return num{big: new(big.Int).SetUint64(v), f: float64(v)}
+}
+
+func fromFloat(v float64) num {
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return num{special: true, f: v}
+	}
+	ip, fp := math.Modf(v)
+	b, _ := new(big.Float).SetFloat64(ip).Int(nil)
+	return num{big: b, frac: fp != 0, neg: v < 0, f: v}
+}
+
+var (
+	minInt64  = big.NewInt(math.MinInt64)
+	maxInt64  = big.NewInt(math.MaxInt64)
+	maxUint64 = new(big.Int).SetUint64(math.MaxUint64)
+)
+
+func bounds(bits int, signed bool) (lo, hi *big.Int) {
+	if signed {
+		lo = new(big.Int).Neg(new(big.Int).Lsh(big.NewInt(1), uint(bits-1)))
+		hi = new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), uint(bits-1)), big.NewInt(1))
+		return
+	}
+	return big.NewInt(0), new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), uint(bits)), big.NewInt(1))
+}
+
+// fitsSigned reports whether the integer part fits a signed type of bits.
+func (v num) fitsSigned(bits int) bool {
+	if v.special {
+		return false
+	}
+	lo, hi := bounds(bits, true)
+	return v.big.Cmp(lo) >= 0 && v.big.Cmp(hi) <= 0
+}
+
+// fitsUnsigned reports whether the value is acceptable for an unsigned
+// type of bits: not negative (cast refuses any negative value, -0.5 too)
+// and within range.
+func (v num) fitsUnsigned(bits int) bool {
+	if v.special || v.neg {
+		return false
+	}
+	_, hi := bounds(bits, false)
+	return v.big.Cmp(hi) <= 0
+}
+
+// ---------------------------------------------------------------------------
+// Numbers: inputs.
+
+type myInt int
+type myInt64 int64
+type myUint8 uint8
+type myFloat float64
+type myString string
+type myBool bool
+
+// input is a Go value handed to cast together with the exact number it
+// denotes, how it is shaped, and the decimal string when it is textual.
+type input struct {
+	value any
+	num   num
+	desc  string
+	text  string // the decimal text for string/json.Number inputs, else ""
+}
+
+// genInt64 draws an integer with the type boundaries over-represented.
+func genInt64(tc hegel.TestCase) int64 {
+	switch n(tc, 0, 9) {
+	case 0:
+		return 0
+	case 1:
+		return pick(tc, []int64{math.MaxInt8, math.MinInt8, math.MaxInt16, math.MinInt16, math.MaxInt32, math.MinInt32, math.MaxInt64, math.MinInt64, math.MaxUint8, math.MaxUint16, math.MaxUint32})
+	case 2:
+		b := pick(tc, []int64{math.MaxInt8, math.MinInt8, math.MaxInt16, math.MinInt16, math.MaxInt32, math.MinInt32, math.MaxUint8, math.MaxUint16, math.MaxUint32})
+		return b + wide(tc, -3, 3)
+	case 3, 4:
+		return wide(tc, -1000, 1000)
+	default:
+		return wide(tc, math.MinInt64, math.MaxInt64)
+	}
+}
+
+// wrapInt returns v as a typed Go value: the narrowest widths it fits,
+// named types, pointers.
+func typedInt(tc hegel.TestCase, v int64) (any, string) {
+	var choices []any
+	if v >= math.MinInt8 && v <= math.MaxInt8 {
+		choices = append(choices, int8(v))
+	}
+	if v >= math.MinInt16 && v <= math.MaxInt16 {
+		choices = append(choices, int16(v))
+	}
+	if v >= math.MinInt32 && v <= math.MaxInt32 {
+		choices = append(choices, int32(v))
+	}
+	choices = append(choices, v, int(v), myInt(v), myInt64(v))
+	if v >= 0 {
+		if v <= math.MaxUint8 {
+			choices = append(choices, uint8(v), myUint8(v))
+		}
+		if v <= math.MaxUint16 {
+			choices = append(choices, uint16(v))
+		}
+		if v <= math.MaxUint32 {
+			choices = append(choices, uint32(v))
+		}
+		choices = append(choices, uint64(v), uint(v))
+	}
+	if v > -1<<53 && v < 1<<53 {
+		choices = append(choices, float64(v), myFloat(v))
+	}
+	if v > -1<<24 && v < 1<<24 {
+		choices = append(choices, float32(v))
+	}
+	x := pick(tc, choices)
+	return x, fmt.Sprintf("%T(%v)", x, x)
+}
+
+// decimal renders an integer as cast accepts it: optional +, optional
+// ".0…" tail (cast drops a decimal part). Leading zeros are pinned (cast/3)
+// and not produced.
+func decimal(tc hegel.TestCase, v *big.Int, frac string) string {
+	s := v.String()
+	if v.Sign() >= 0 && chance(tc, 20) {
+		s = "+" + s
+	}
+	if frac != "" {
+		s += "." + frac
+	} else if chance(tc, 20) {
+		s += "." + strings.Repeat("0", n(tc, 0, 3))
+	}
+	return s
+}
+
+func genIntInput(tc hegel.TestCase) input {
+	v := genInt64(tc)
+	nm := fromInt64(v)
+	switch n(tc, 0, 5) {
+	case 0, 1:
+		x, d := typedInt(tc, v)
+		if chance(tc, 20) {
+			p := reflect.New(reflect.TypeOf(x))
+			p.Elem().Set(reflect.ValueOf(x))
+			return input{value: p.Interface(), num: nm, desc: "*" + d}
+		}
+		return input{value: x, num: nm, desc: d}
+	case 2:
+		u := uint64(v)
+		if chance(tc, 50) {
+			u = uint64(wide(tc, 0, math.MaxInt64))*2 + uint64(n(tc, 0, 1))
+		}
+		return input{value: u, num: fromUint64(u), desc: fmt.Sprintf("uint64(%d)", u)}
+	case 3, 4:
+		s := decimal(tc, nm.big, "")
+		return input{value: s, num: nm, desc: fmt.Sprintf("%q", s), text: s}
+	default:
+		s := decimal(tc, nm.big, "")
+		return input{value: json.Number(s), num: nm, desc: fmt.Sprintf("json.Number(%q)", s), text: s}
+	}
+}
+
+func genFloatInput(tc hegel.TestCase) input {
+	var f float64
+	switch n(tc, 0, 6) {
+	case 0:
+		f = pick(tc, []float64{math.NaN(), math.Inf(1), math.Inf(-1)})
+	case 1:
+		f = pick(tc, []float64{math.MaxFloat64, -math.MaxFloat64, math.MaxFloat32, -math.MaxFloat32, math.SmallestNonzeroFloat64, 1e300, -1e300, 1e20, 9.3e18, -9.3e18, 4.3e9, 65536.5, 255.5, 128.5, -128.5, -0.5, 0.5, -0.0})
+	case 2:
+		f = float64(wide(tc, -1000, 1000)) + pick(tc, []float64{0.25, 0.5, 0.75, 0.1, 0.9, 0.999})*float64(pick(tc, []int{1, -1}))
+	case 3:
+		f = float64(float32(math.Float32frombits(uint32(wide(tc, 0, math.MaxUint32)))))
+	default:
+		f = math.Float64frombits(uint64(wide(tc, math.MinInt64, math.MaxInt64)))
+	}
+	nm := fromFloat(f)
+	switch n(tc, 0, 3) {
+	case 0:
+		if f32 := float32(f); float64(f32) == f || nm.special {
+			return input{value: f32, num: fromFloat(float64(f32)), desc: fmt.Sprintf("float32(%v)", f32)}
+		}
+		return input{value: f, num: nm, desc: fmt.Sprintf("float64(%v)", f)}
+	case 1:
+		if chance(tc, 30) {
+			return input{value: myFloat(f), num: nm, desc: fmt.Sprintf("myFloat(%v)", f)}
+		}
+		return input{value: f, num: nm, desc: fmt.Sprintf("float64(%v)", f)}
+	default:
+		if nm.special {
+			return input{value: f, num: nm, desc: fmt.Sprintf("float64(%v)", f)}
+		}
+		s := strconv.FormatFloat(f, 'f', -1, 64)
+		if strings.HasPrefix(s, "-") {
+			nm.neg = true // "-0": a minus sign is refused by the unsigned parsers, as strconv does
+		}
+		if chance(tc, 50) {
+			return input{value: json.Number(s), num: nm, desc: fmt.Sprintf("json.Number(%q)", s), text: s}
+		}
+		return input{value: s, num: nm, desc: fmt.Sprintf("%q", s), text: s}
+	}
+}
+
+func genNumberInput(tc hegel.TestCase) input {
+	if chance(tc, 35) {
+		return genFloatInput(tc)
+	}
+	return genIntInput(tc)
+}
+
+// ---------------------------------------------------------------------------
+// Numbers: the property.
+
+// checkInt compares one signed conversion with the model.
+func checkInt[T int | int8 | int16 | int32 | int64](ht *hegel.T, in input, bits int, name string, fn func(any) (T, error), plain func(any) T) {
+	got, err := fn(in.value)
+	fits := in.num.fitsSigned(bits)
+	if !fits {
+		// out of range, NaN or Inf: pinned (cast/1 numeric inputs, cast/2 strings)
+		note(ht, "%s of %s: out of range, pinned", name, in.desc)
+		return
+	}
+	if err != nil {
+		fail(ht, "%s(%s) failed: %v; the value %s fits", name, in.desc, err, in.num.big)
+	}
+	want := T(in.num.big.Int64())
+	if got != want {
+		fail(ht, "%s(%s) = %v, want %v", name, in.desc, got, want)
+	}
+	if g := plain(in.value); g != want {
+		fail(ht, "plain %s(%s) = %v, want %v", name, in.desc, g, want)
+	}
+	if g, e := cast.ToE[T](in.value); e != nil || g != want {
+		fail(ht, "ToE[%T](%s) = %v, %v; %s gives %v", want, in.desc, g, e, name, want)
+	}
+	if g, e := cast.ToNumberE[T](in.value); e != nil || g != want {
+		fail(ht, "ToNumberE[%T](%s) = %v, %v; %s gives %v", want, in.desc, g, e, name, want)
+	}
+}
+
+func checkUint[T uint | uint8 | uint16 | uint32 | uint64](ht *hegel.T, in input, bits int, name string, fn func(any) (T, error), plain func(any) T) {
+	got, err := fn(in.value)
+	fits := in.num.fitsUnsigned(bits)
+	if !fits && !in.num.neg {
+		note(ht, "%s of %s: out of range, pinned", name, in.desc)
+		return
+	}
+	if !fits {
+		if err == nil {
+			fail(ht, "%s(%s) = %v with no error; negative values cannot convert", name, in.desc, got)
+		}
+		if plain(in.value) != 0 {
+			fail(ht, "%s(%s) = %v; the plain variant must return 0 on failure", name, in.desc, plain(in.value))
+		}
+		return
+	}
+	if err != nil {
+		fail(ht, "%s(%s) failed: %v; the value %s fits", name, in.desc, err, in.num.big)
+	}
+	want := T(in.num.big.Uint64())
+	if got != want {
+		fail(ht, "%s(%s) = %v, want %v", name, in.desc, got, want)
+	}
+	if g := plain(in.value); g != want {
+		fail(ht, "plain %s(%s) = %v, want %v", name, in.desc, g, want)
+	}
+	if g, e := cast.ToE[T](in.value); e != nil || g != want {
+		fail(ht, "ToE[%T](%s) = %v, %v; %s gives %v", want, in.desc, g, e, name, want)
+	}
+	if g, e := cast.ToNumberE[T](in.value); e != nil || g != want {
+		fail(ht, "ToNumberE[%T](%s) = %v, %v; %s gives %v", want, in.desc, g, e, name, want)
+	}
+}
+
+func sameFloat(a, b float64) bool {
+	return a == b || (math.IsNaN(a) && math.IsNaN(b))
+}
+
+// Every number-shaped input — integers of every width, named integer and
+// float types, pointers, floats with fractions, NaN and infinities, decimal
+// strings and json.Numbers with an optional sign and ".0" tail — converts
+// through every ToXxxE to the value the model gives (the integer part,
+// truncated toward zero, when it fits the target type; an error for
+// negative values into unsigned types and for NaN/Inf into integers), the
+// plain variants return the same value or zero, and the generic ToE /
+// ToNumberE agree with the typed functions.
+func TestHegelNumbersConvertByValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		in := genNumberInput(ht)
+		note(ht, "input %s", in.desc)
+		checkInt(ht, in, 64, "ToInt64E", cast.ToInt64E, cast.ToInt64)
+		checkInt(ht, in, strconv.IntSize, "ToIntE", cast.ToIntE, cast.ToInt)
+		checkInt(ht, in, 32, "ToInt32E", cast.ToInt32E, cast.ToInt32)
+		checkInt(ht, in, 16, "ToInt16E", cast.ToInt16E, cast.ToInt16)
+		checkInt(ht, in, 8, "ToInt8E", cast.ToInt8E, cast.ToInt8)
+		checkUint(ht, in, 64, "ToUint64E", cast.ToUint64E, cast.ToUint64)
+		checkUint(ht, in, strconv.IntSize, "ToUintE", cast.ToUintE, cast.ToUint)
+		checkUint(ht, in, 32, "ToUint32E", cast.ToUint32E, cast.ToUint32)
+		checkUint(ht, in, 16, "ToUint16E", cast.ToUint16E, cast.ToUint16)
+		checkUint(ht, in, 8, "ToUint8E", cast.ToUint8E, cast.ToUint8)
+
+		// float64: the float64 reading of a Go value, or strconv's reading of the text
+		want64 := in.num.f
+		if in.text != "" {
+			want64, _ = strconv.ParseFloat(in.text, 64)
+		}
+		got64, err := cast.ToFloat64E(in.value)
+		if err != nil {
+			fail(ht, "ToFloat64E(%s) failed: %v", in.desc, err)
+		}
+		if !sameFloat(got64, want64) {
+			fail(ht, "ToFloat64E(%s) = %v, want %v", in.desc, got64, want64)
+		}
+		if g := cast.ToFloat64(in.value); !sameFloat(g, want64) {
+			fail(ht, "ToFloat64(%s) = %v, want %v", in.desc, g, want64)
+		}
+		if g, e := cast.ToE[float64](in.value); e != nil || !sameFloat(g, want64) {
+			fail(ht, "ToE[float64](%s) = %v, %v, want %v", in.desc, g, e, want64)
+		}
+
+		// float32
+		if in.text != "" {
+			w, perr := strconv.ParseFloat(in.text, 32)
+			got32, err := cast.ToFloat32E(in.value)
+			if (perr == nil) != (err == nil) {
+				fail(ht, "ToFloat32E(%s) = %v, %v; strconv.ParseFloat(_, 32) says %v, %v", in.desc, got32, err, w, perr)
+			}
+			if err == nil && !sameFloat(float64(got32), w) {
+				fail(ht, "ToFloat32E(%s) = %v, want %v", in.desc, got32, w)
+			}
+		} else if in.num.special || math.Abs(in.num.f) <= math.MaxFloat32 {
+			got32, err := cast.ToFloat32E(in.value)
+			if err != nil {
+				fail(ht, "ToFloat32E(%s) failed: %v", in.desc, err)
+			}
+			// Go's conversion rounds once from the exact value; going through
+			// float64 first would round twice, so integers use big.Float.
+			want32 := float32(in.num.f)
+			if !in.num.special && !in.num.frac {
+				want32, _ = new(big.Float).SetInt(in.num.big).Float32()
+			}
+			if !sameFloat(float64(got32), float64(want32)) {
+				fail(ht, "ToFloat32E(%s) = %v, want %v", in.desc, got32, want32)
+			}
+		} else {
+			note(ht, "float32 of %s: out of range, pinned", in.desc)
+		}
+
+		// bool: non-zero is true (strings are strconv.ParseBool's business, checked elsewhere)
+		if in.text == "" {
+			wantB := in.num.f != 0
+			gotB, err := cast.ToBoolE(in.value)
+			if err != nil || gotB != wantB {
+				fail(ht, "ToBoolE(%s) = %v, %v; want %v", in.desc, gotB, err, wantB)
+			}
+		}
+	})
+}
+
+// Non-numeric text, and text that is a number only loosely (exponents,
+// blanks, units, hex floats, words), is refused by every integer
+// conversion with an error and a zero result; strconv's verdict on the
+// text as a float decides the float conversions.
+func TestHegelMalformedTextIsRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var s string
+		switch n(tc(ht), 0, 5) {
+		case 0:
+			// "." / "-." / "+." are pinned (cast/4) and left out
+			s = pick(ht, []string{"abc", "1a", "a1", "--1", "1-", "1..0", "-", "+", "1.2.3", "0x", "1,000", "１２", "1 ", " 1", "\t1", "1\n", "১", "٣", "1.", "-1.", ".5", "-.5"})
+		case 1:
+			s = fmt.Sprintf("%de%d", wide(ht, -99, 99), n(ht, 0, 30))
+		case 2:
+			s = fmt.Sprintf("%d %d", wide(ht, -99, 99), wide(ht, -99, 99))
+		case 3:
+			s = fmt.Sprintf("%d%s", wide(ht, 0, 999), pick(ht, []string{"ns", "ms", "s", "m", "h", "kg", "%", "px"}))
+		case 4:
+			s = pick(ht, []string{"inf", "Inf", "+Inf", "-inf", "infinity", "nan", "NaN", "0x1p-2", "0X1P4"})
+		default:
+			b := make([]byte, n(ht, 1, 6))
+			for i := range b {
+				b[i] = byte(n(ht, 32, 126))
+			}
+			s = string(b)
+			if _, err := strconv.ParseFloat(s, 64); err == nil {
+				return
+			}
+			if _, err := strconv.ParseInt(s, 10, 64); err == nil {
+				return
+			}
+		}
+		note(ht, "text %q", s)
+		if _, err := strconv.ParseInt(strings.TrimSuffix(s, ".0"), 10, 64); err == nil {
+			return // a plain integer after all
+		}
+		if strings.TrimLeft(s, "+-") == "." {
+			return // pinned, cast/4
+		}
+		if strings.Contains(s, ".") {
+			// a decimal: cast keeps the integer part, which is its documented
+			// reading of "8.31"; checked by the value property, not here
+			if _, err := strconv.ParseFloat(s, 64); err == nil {
+				return
+			}
+		}
+		for _, v := range []any{s, json.Number(s), myString(s)} {
+			if got, err := cast.ToInt64E(v); err == nil {
+				if strings.ContainsAny(s, "xXbBoO_") {
+					continue // base prefixes and underscores: pinned as cast/3 territory
+				}
+				fail(ht, "ToInt64E(%T %q) = %v with no error", v, s, got)
+			}
+			if got := cast.ToInt64(v); got != 0 {
+				fail(ht, "ToInt64(%T %q) = %v, want 0", v, s, got)
+			}
+			if got, err := cast.ToUint64E(v); err == nil {
+				if strings.ContainsAny(s, "xXbBoO_") {
+					continue
+				}
+				fail(ht, "ToUint64E(%T %q) = %v with no error", v, s, got)
+			}
+			wantF, perr := strconv.ParseFloat(s, 64)
+			gotF, err := cast.ToFloat64E(v)
+			if (perr == nil) != (err == nil) || (err == nil && !sameFloat(gotF, wantF)) {
+				fail(ht, "ToFloat64E(%T %q) = %v, %v; strconv says %v, %v", v, s, gotF, err, wantF, perr)
+			}
+		}
+	})
+}
+
+func tc(ht *hegel.T) hegel.TestCase { return ht }
+
+// ---------------------------------------------------------------------------
+// Bool, string, duration round trips.
+
+// ToString of every basic value is read back by the matching conversion:
+// integers and unsigned integers of every width, floats (the shortest
+// representation strconv produces), bools, durations (through
+// Duration.String), and times (through Time.String, which cast lists among
+// its formats), in UTC and fixed zones with and without a name.
+func TestHegelToStringRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch n(ht, 0, 7) {
+		case 0:
+			v := genInt64(ht)
+			s := cast.ToString(v)
+			if s != strconv.FormatInt(v, 10) {
+				fail(ht, "ToString(int64 %d) = %q", v, s)
+			}
+			if got, err := cast.ToInt64E(s); err != nil || got != v {
+				fail(ht, "ToInt64E(ToString(%d) = %q) = %v, %v", v, s, got, err)
+			}
+			for _, x := range []any{int8(v), int16(v), int32(v), int(v)} {
+				if got := cast.ToString(x); got != fmt.Sprint(x) {
+					fail(ht, "ToString(%T %v) = %q", x, x, got)
+				}
+			}
+		case 1:
+			u := uint64(genInt64(ht))
+			s := cast.ToString(u)
+			if got, err := cast.ToUint64E(s); err != nil || got != u {
+				fail(ht, "ToUint64E(ToString(%d) = %q) = %v, %v", u, s, got, err)
+			}
+			for _, x := range []any{uint8(u), uint16(u), uint32(u), uint(u)} {
+				if got := cast.ToString(x); got != fmt.Sprint(x) {
+					fail(ht, "ToString(%T %v) = %q", x, x, got)
+				}
+			}
+		case 2:
+			f := math.Float64frombits(uint64(wide(ht, math.MinInt64, math.MaxInt64)))
+			if chance(ht, 30) {
+				f = float64(wide(ht, -1000000, 1000000)) / float64(pick(ht, []int64{1, 2, 4, 8, 10, 100, 1000}))
+			}
+			s := cast.ToString(f)
+			got, err := cast.ToFloat64E(s)
+			if math.IsNaN(f) || math.IsInf(f, 0) {
+				if err != nil || !sameFloat(got, f) {
+					fail(ht, "ToFloat64E(ToString(%v) = %q) = %v, %v", f, s, got, err)
+				}
+				return
+			}
+			if err != nil || got != f {
+				fail(ht, "ToFloat64E(ToString(%v) = %q) = %v, %v", f, s, got, err)
+			}
+			if strings.ContainsAny(s, "eE") {
+				fail(ht, "ToString(%v) = %q uses an exponent", f, s)
+			}
+		case 3:
+			f := math.Float32frombits(uint32(wide(ht, 0, math.MaxUint32)))
+			s := cast.ToString(f)
+			got, err := cast.ToFloat32E(s)
+			if err != nil || !sameFloat(float64(got), float64(f)) {
+				fail(ht, "ToFloat32E(ToString(float32 %v) = %q) = %v, %v", f, s, got, err)
+			}
+		case 4:
+			b := chance(ht, 50)
+			s := cast.ToString(b)
+			if got, err := cast.ToBoolE(s); err != nil || got != b {
+				fail(ht, "ToBoolE(ToString(%v) = %q) = %v, %v", b, s, got, err)
+			}
+			if got, err := cast.ToBoolE(myBool(b)); err != nil || got != b {
+				fail(ht, "ToBoolE(myBool(%v)) = %v, %v", b, got, err)
+			}
+			for _, x := range []any{int8(1), uint(7), 0.5, myInt(3), time.Duration(2), time.Month(1)} {
+				if got, err := cast.ToBoolE(x); err != nil || !got {
+					fail(ht, "ToBoolE(%T %v) = %v, %v; non-zero is true", x, x, got, err)
+				}
+			}
+		case 5:
+			d := time.Duration(wide(ht, math.MinInt64, math.MaxInt64))
+			if chance(ht, 50) {
+				d = time.Duration(wide(ht, -1000000, 1000000)) * pick(ht, []time.Duration{time.Nanosecond, time.Microsecond, time.Millisecond, time.Second, time.Minute, time.Hour})
+			}
+			s := cast.ToString(d)
+			if s != d.String() {
+				fail(ht, "ToString(%v) = %q", d, s)
+			}
+			if got, err := cast.ToDurationE(s); err != nil || got != d {
+				fail(ht, "ToDurationE(ToString(%v) = %q) = %v, %v", d, s, got, err)
+			}
+			if got, err := cast.ToDurationE(int64(d)); err != nil || got != d {
+				fail(ht, "ToDurationE(int64 %d) = %v, %v", int64(d), got, err)
+			}
+			if got, err := cast.ToDurationE(strconv.FormatInt(int64(d), 10)); err != nil || got != d {
+				fail(ht, "ToDurationE(%q) = %v, %v; a bare number is nanoseconds", strconv.FormatInt(int64(d), 10), got, err)
+			}
+			if got, err := cast.ToE[time.Duration](s); err != nil || got != d {
+				fail(ht, "ToE[time.Duration](%q) = %v, %v", s, got, err)
+			}
+		default:
+			tm := genTime(ht, genZone(ht))
+			s := cast.ToString(tm)
+			if s != tm.String() {
+				fail(ht, "ToString(%v) = %q", tm, s)
+			}
+			got, err := cast.ToTimeE(s)
+			if err != nil {
+				fail(ht, "ToTimeE(ToString(%v) = %q) failed: %v", tm, s, err)
+			}
+			if !got.Equal(tm) {
+				fail(ht, "ToTimeE(%q) = %v, not the same instant as %v", s, got, tm)
+			}
+			_, o1 := got.Zone()
+			_, o2 := tm.Zone()
+			if o1 != o2 {
+				fail(ht, "ToTimeE(%q) = %v has offset %d, the original %d", s, got, o1, o2)
+			}
+		}
+	})
+}
+
+// genZone draws UTC or a named fixed zone. Zone names are the shapes Go's
+// time.Parse reads back (three upper-case letters, or four/five ending in
+// T). A nameless zone prints its numeric offset in the name slot, which
+// time.Parse only accepts up to "+23" — Go's limit, not cast's — so those
+// are left out.
+func genZone(tc hegel.TestCase) *time.Location {
+	if chance(tc, 40) {
+		return time.UTC
+	}
+	return time.FixedZone(pick(tc, []string{"XYZ", "AEST", "ABCDT", "EST", "PST", "CET"}), int(wide(tc, -14*60, 14*60))*60)
+}
+
+// genTime draws a time in loc between the years 1 and 9999 with random
+// nanoseconds (or none).
+func genTime(tc hegel.TestCase, loc *time.Location) time.Time {
+	year := int(wide(tc, 1, 9999))
+	if chance(tc, 50) {
+		year = int(wide(tc, 1970, 2100))
+	}
+	ns := 0
+	switch n(tc, 0, 2) {
+	case 0:
+		ns = int(wide(tc, 0, 999999999))
+	case 1:
+		ns = int(wide(tc, 0, 999)) * 1000000
+	}
+	return time.Date(year, time.Month(n(tc, 1, 12)), n(tc, 1, 28), n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59), ns, loc)
+}
+
+// ---------------------------------------------------------------------------
+// Times.
+
+// truncateFor drops the parts of t a layout does not carry.
+func truncateFor(layout string, t time.Time) time.Time {
+	switch {
+	case strings.Contains(layout, ".999999999") || strings.Contains(layout, ".000000000"):
+		return t
+	case strings.Contains(layout, ".000000"):
+		return t.Truncate(time.Microsecond)
+	case strings.Contains(layout, ".000"):
+		return t.Truncate(time.Millisecond)
+	case strings.Contains(layout, "05"):
+		return t.Truncate(time.Second)
+	case strings.Contains(layout, "04"):
+		return t.Truncate(time.Minute)
+	default:
+		return time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, t.Location())
+	}
+}
+
+// A time formatted with any of cast's own layouts is parsed back by
+// ToTimeInDefaultLocationE with the documented meaning: layouts with a
+// numeric offset give the same instant and offset; layouts with no
+// timezone (and, by design, those with a zone name only) give the wall
+// clock in the default location; time-only layouts give the clock on
+// January 1 of year 0 (Stamp layouts keep the month and day) in UTC.
+// Fractional seconds appended to a layout without them are accepted, as
+// time.Parse does.
+func TestHegelOwnLayoutsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := pick(ht, internal.TimeFormats)
+		loc := genZone(ht)
+		zone := genZone(ht)
+		if f.Typ == internal.TimeFormatNamedTimezone {
+			zone = time.UTC // the only zone name that reads back as itself; the rest are pinned/design
+		}
+		tm := genTime(ht, zone)
+		s := tm.Format(f.Format)
+		if !strings.Contains(f.Format, ".") && strings.Contains(f.Format, "05") && chance(ht, 30) {
+			// fractional seconds are accepted after a seconds field
+			s = tm.Format(strings.Replace(f.Format, "05", "05.000", 1))
+			tm = tm.Truncate(time.Millisecond)
+		} else {
+			tm = truncateFor(f.Format, tm)
+		}
+		if strings.Contains(f.Format, "06") && !strings.Contains(f.Format, "2006") {
+			// two-digit years: Go reads 69-99 as 19xx and 00-68 as 20xx
+			yy := tm.Year() % 100
+			year := 2000 + yy
+			if yy >= 69 {
+				year = 1900 + yy
+			}
+			tm = time.Date(year, tm.Month(), tm.Day(), tm.Hour(), tm.Minute(), tm.Second(), tm.Nanosecond(), tm.Location())
+		}
+		if _, off := tm.Zone(); f.Format == time.RubyDate && off > -24*60 && off < 24*60 {
+			// pinned (cast/5): UnixDate precedes RubyDate in the list and
+			// Go's MST slot accepts "+0000".."+0023" as a zone name, so the
+			// offset is lost for those
+			note(ht, "RubyDate strings with a small offset are claimed by UnixDate, pinned")
+			return
+		}
+		note(ht, "layout %q (%v), default location %v: %q", f.Format, f.Typ, loc, s)
+		got, err := cast.ToTimeInDefaultLocationE(s, loc)
+		if err != nil {
+			fail(ht, "ToTimeInDefaultLocationE(%q, %v) failed: %v (layout %q)", s, loc, err, f.Format)
+		}
+		var want time.Time
+		switch f.Typ {
+		case internal.TimeFormatNumericTimezone, internal.TimeFormatNumericAndNamedTimezone:
+			want = tm
+			_, o1 := got.Zone()
+			_, o2 := tm.Zone()
+			if o1 != o2 {
+				fail(ht, "ToTimeInDefaultLocationE(%q) = %v: offset %d, want %d (layout %q)", s, got, o1, o2, f.Format)
+			}
+		case internal.TimeFormatNoTimezone, internal.TimeFormatNamedTimezone:
+			want = time.Date(tm.Year(), tm.Month(), tm.Day(), tm.Hour(), tm.Minute(), tm.Second(), tm.Nanosecond(), loc)
+			if got.Location() != loc {
+				fail(ht, "ToTimeInDefaultLocationE(%q, %v) = %v is not in the default location (layout %q)", s, loc, got, f.Format)
+			}
+		default: // time only
+			day := 1
+			month := time.January
+			if strings.Contains(f.Format, "Jan") {
+				day, month = tm.Day(), tm.Month()
+			}
+			want = time.Date(0, month, day, tm.Hour(), tm.Minute(), tm.Second(), tm.Nanosecond(), time.UTC)
+		}
+		if !got.Equal(want) {
+			fail(ht, "ToTimeInDefaultLocationE(%q, %v) = %v, want %v (layout %q)", s, loc, got, want, f.Format)
+		}
+		// ToTimeE is the UTC case
+		if loc == time.UTC {
+			if g, err := cast.ToTimeE(s); err != nil || !g.Equal(got) {
+				fail(ht, "ToTimeE(%q) = %v, %v; ToTimeInDefaultLocationE(_, UTC) = %v", s, g, err, got)
+			}
+			if g, err := cast.ToE[time.Time](s); err != nil || !g.Equal(got) {
+				fail(ht, "ToE[time.Time](%q) = %v, %v; want %v", s, g, err, got)
+			}
+			if g, err := cast.StringToDate(s); err != nil || !g.Equal(got) {
+				fail(ht, "StringToDate(%q) = %v, %v; want %v", s, g, err, got)
+			}
+		}
+	})
+}
+
+// Integer inputs to ToTimeE are Unix seconds, for every integer kind
+// cast's number conversions accept (json.Number with a ".0" tail too);
+// a time.Time comes back as itself; nil is the zero time.
+func TestHegelIntegersAreUnixSeconds(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := wide(ht, -1<<40, 1<<40)
+		if chance(ht, 30) {
+			v = wide(ht, 0, 1<<31)
+		}
+		want := time.Unix(v, 0)
+		var in any
+		switch n(ht, 0, 4) {
+		case 0:
+			in = v
+		case 1:
+			in = int(v)
+		case 2:
+			if v >= 0 {
+				in = uint64(v)
+			} else {
+				in = v
+			}
+		case 3:
+			in = json.Number(strconv.FormatInt(v, 10) + pick(ht, []string{"", ".0", ".00"}))
+		default:
+			// int32/uint32 when it fits; other widths are pinned (cast/7)
+			if v >= 0 && v <= math.MaxUint32 {
+				in = uint32(v)
+			} else if v >= math.MinInt32 && v <= math.MaxInt32 {
+				in = int32(v)
+			} else {
+				in = v
+			}
+		}
+		note(ht, "input %T(%v)", in, in)
+		got, err := cast.ToTimeE(in)
+		if err != nil || !got.Equal(want) {
+			fail(ht, "ToTimeE(%T %v) = %v, %v; want %v", in, in, got, err, want)
+		}
+		if got := cast.ToTime(want); !got.Equal(want) {
+			fail(ht, "ToTime(time.Time) changed the value")
+		}
+		if got, err := cast.ToTimeE(nil); err != nil || !got.IsZero() {
+			fail(ht, "ToTimeE(nil) = %v, %v", got, err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Slices and maps.
+
+// genScalar draws a convertible scalar: a small integer in a random Go
+// type, a decimal string, a bool, or a float with an integer value.
+func genScalar(tc hegel.TestCase) (any, int64) {
+	v := wide(tc, -200, 200)
+	switch n(tc, 0, 6) {
+	case 0:
+		return int(v), v
+	case 1:
+		return v, v
+	case 2:
+		if v >= 0 {
+			return uint8(v), v
+		}
+		if v >= math.MinInt8 {
+			return int8(v), v
+		}
+		return int16(v), v
+	case 3:
+		return strconv.FormatInt(v, 10), v
+	case 4:
+		return float64(v), v
+	case 5:
+		return json.Number(strconv.FormatInt(v, 10)), v
+	default:
+		return myInt(v), v
+	}
+}
+
+// A slice (or array) of convertible scalars converts element-wise through
+// every ToXxxSliceE; a slice containing an unconvertible element is an
+// error; a []T comes back equal; a string splits on white space for
+// ToStringSliceE; a scalar becomes a one-element string slice.
+func TestHegelSlicesConvertElementWise(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 5)
+		var items []any
+		var vals []int64
+		for i := 0; i < k; i++ {
+			x, v := genScalar(ht)
+			items = append(items, x)
+			vals = append(vals, v)
+		}
+		bad := k > 0 && chance(ht, 25)
+		if bad {
+			items[n(ht, 0, k-1)] = pick(ht, []any{"x", struct{}{}, []int{1}, "1.5.2"})
+		}
+		var in any = items
+		switch n(ht, 0, 3) {
+		case 0:
+			// a typed slice when every item has the same type
+			if k > 0 && !bad {
+				same := true
+				for _, x := range items {
+					if reflect.TypeOf(x) != reflect.TypeOf(items[0]) {
+						same = false
+					}
+				}
+				if same {
+					sl := reflect.MakeSlice(reflect.SliceOf(reflect.TypeOf(items[0])), 0, k)
+					for _, x := range items {
+						sl = reflect.Append(sl, reflect.ValueOf(x))
+					}
+					in = sl.Interface()
+				}
+			}
+		case 1:
+			arr := reflect.New(reflect.ArrayOf(k, reflect.TypeOf((*any)(nil)).Elem())).Elem()
+			for i, x := range items {
+				arr.Index(i).Set(reflect.ValueOf(&x).Elem())
+			}
+			in = arr.Interface()
+		}
+		note(ht, "input %T %v (bad=%v)", in, in, bad)
+
+		gotI, err := cast.ToInt64SliceE(in)
+		if bad {
+			if err == nil {
+				fail(ht, "ToInt64SliceE(%v) = %v with no error", in, gotI)
+			}
+			if g := cast.ToInt64Slice(in); g != nil {
+				fail(ht, "ToInt64Slice(%v) = %v, want nil", in, g)
+			}
+			return
+		}
+		if err != nil {
+			fail(ht, "ToInt64SliceE(%v) failed: %v", in, err)
+		}
+		if !reflect.DeepEqual(gotI, append([]int64{}, vals...)) && !(k == 0 && len(gotI) == 0) {
+			fail(ht, "ToInt64SliceE(%v) = %v, want %v", in, gotI, vals)
+		}
+		wantI := make([]int, k)
+		wantS := make([]string, k)
+		wantF := make([]float64, k)
+		wantB := make([]bool, k)
+		wantD := make([]time.Duration, k)
+		for i, v := range vals {
+			wantI[i] = int(v)
+			wantS[i] = cast.ToString(items[i])
+			wantF[i] = float64(v)
+			wantB[i] = v != 0
+			wantD[i] = time.Duration(v)
+		}
+		if g, err := cast.ToIntSliceE(in); err != nil || !(reflect.DeepEqual(g, wantI) || k == 0 && len(g) == 0) {
+			fail(ht, "ToIntSliceE(%v) = %v, %v; want %v", in, g, err, wantI)
+		}
+		if g, err := cast.ToFloat64SliceE(in); err != nil || !(reflect.DeepEqual(g, wantF) || k == 0 && len(g) == 0) {
+			fail(ht, "ToFloat64SliceE(%v) = %v, %v; want %v", in, g, err, wantF)
+		}
+		if g, err := cast.ToDurationSliceE(in); err != nil || !(reflect.DeepEqual(g, wantD) || k == 0 && len(g) == 0) {
+			fail(ht, "ToDurationSliceE(%v) = %v, %v; want %v", in, g, err, wantD)
+		}
+		if g, err := cast.ToStringSliceE(in); err != nil || !(reflect.DeepEqual(g, wantS) || k == 0 && len(g) == 0) {
+			fail(ht, "ToStringSliceE(%v) = %v, %v; want %v", in, g, err, wantS)
+		}
+		noStrings := true
+		for _, x := range items {
+			switch x.(type) {
+			case string, json.Number:
+				noStrings = false
+			}
+		}
+		if noStrings {
+			if g, err := cast.ToBoolSliceE(in); err != nil || !(reflect.DeepEqual(g, wantB) || k == 0 && len(g) == 0) {
+				fail(ht, "ToBoolSliceE(%v) = %v, %v; want %v", in, g, err, wantB)
+			}
+		}
+		// a string splits on white space; a scalar is one element
+		words := make([]string, n(ht, 0, 4))
+		for i := range words {
+			words[i] = strconv.FormatInt(wide(ht, -99, 99), 10)
+		}
+		line := strings.Join(words, pick(ht, []string{" ", "  ", "\t", "\n", " \t "}))
+		if chance(ht, 30) {
+			line = " " + line + " "
+		}
+		if g, err := cast.ToStringSliceE(line); err != nil || !(reflect.DeepEqual(g, words) || len(words) == 0 && len(g) == 0) {
+			fail(ht, "ToStringSliceE(%q) = %v, %v; want %v", line, g, err, words)
+		}
+		if k > 0 {
+			if g, err := cast.ToStringSliceE(items[0]); err != nil || !reflect.DeepEqual(g, []string{cast.ToString(items[0])}) {
+				fail(ht, "ToStringSliceE(%T %v) = %v, %v", items[0], items[0], g, err)
+			}
+		}
+	})
+}
+
+// A map with string or any keys and convertible scalar values converts
+// value-wise through ToStringMapIntE / Int64E / StringE / BoolE /
+// ToStringMapE, whatever the Go map type carrying it (map[string]any,
+// map[any]any, map[string]int, map[any]string…), with keys stringified;
+// the JSON text of the same map converts equally; a map containing an
+// unconvertible value is an error for the reflect-driven map kinds (the
+// map[string]any / map[any]any kinds swallow it: pinned, cast/5).
+func TestHegelMapsConvertValueWise(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 5)
+		keys := map[string]bool{}
+		items := map[string]any{}
+		vals := map[string]int64{}
+		for i := 0; i < k; i++ {
+			key := pick(ht, []string{"a", "b", "c", "key", "K", "", "x y", "1", "-2", "é"})
+			if keys[key] {
+				continue
+			}
+			keys[key] = true
+			x, v := genScalar(ht)
+			items[key] = x
+			vals[key] = v
+		}
+		wantInt := map[string]int{}
+		wantInt64 := map[string]int64{}
+		wantStr := map[string]string{}
+		wantBool := map[string]bool{}
+		for key, v := range vals {
+			wantInt[key] = int(v)
+			wantInt64[key] = v
+			wantStr[key] = cast.ToString(items[key])
+			wantBool[key] = v != 0
+		}
+		var in any = items
+		shape := n(ht, 0, 5)
+		switch shape {
+		case 1:
+			m := map[any]any{}
+			for key, x := range items {
+				m[key] = x
+			}
+			in = m
+		case 2:
+			m := map[any]string{}
+			for key, x := range items {
+				m[key] = cast.ToString(x)
+			}
+			in = m
+		case 3:
+			m := map[string]int64{}
+			for key := range items {
+				m[key] = vals[key]
+			}
+			in = m
+		case 4:
+			m := map[string]string{}
+			for key, x := range items {
+				m[key] = cast.ToString(x)
+			}
+			in = m
+		case 5:
+			// JSON text with numeric values: json.Unmarshal into the target
+			// map type does the conversion, so only the integer maps and
+			// ToStringMapE apply
+			m := map[string]int64{}
+			for key := range items {
+				m[key] = vals[key]
+			}
+			b, _ := json.Marshal(m)
+			in = string(b)
+		}
+		note(ht, "input %T %v", in, in)
+		noStrings := true
+		for _, x := range items {
+			switch x.(type) {
+			case string, json.Number:
+				noStrings = false
+			}
+		}
+
+		if shape == 2 && k > 0 {
+			// map[any]string reaches the reflect path, which panics (cast/11); pinned
+			note(ht, "integer maps from map[any]string are pinned")
+		} else {
+			gotI, err := cast.ToStringMapInt64E(in)
+			if err != nil {
+				fail(ht, "ToStringMapInt64E(%v) failed: %v", in, err)
+			}
+			if !reflect.DeepEqual(gotI, wantInt64) && !(len(gotI) == 0 && len(wantInt64) == 0) {
+				fail(ht, "ToStringMapInt64E(%T %v) = %v, want %v", in, in, gotI, wantInt64)
+			}
+			if g, err := cast.ToStringMapIntE(in); err != nil || !(reflect.DeepEqual(g, wantInt) || len(g) == 0 && len(wantInt) == 0) {
+				fail(ht, "ToStringMapIntE(%T %v) = %v, %v; want %v", in, in, g, err, wantInt)
+			}
+		}
+		// ToStringMapStringE, ToStringMapBoolE and ToStringMapE only accept
+		// map[string]any, map[any]any, map[any]<value type> and their own
+		// type; other value types (map[string]int64 for a string map,
+		// map[string]string for ToStringMapE) are refused — pinned as cast/12
+		if shape != 5 && shape != 3 {
+			if g, err := cast.ToStringMapStringE(in); err != nil || !(reflect.DeepEqual(g, wantStr) || len(g) == 0 && len(wantStr) == 0) {
+				fail(ht, "ToStringMapStringE(%T %v) = %v, %v; want %v", in, in, g, err, wantStr)
+			}
+		}
+		if (shape == 0 || shape == 1) && noStrings {
+			// string values go through strconv.ParseBool ("7" is not a bool), checked elsewhere
+			if g, err := cast.ToStringMapBoolE(in); err != nil || !(reflect.DeepEqual(g, wantBool) || len(g) == 0 && len(wantBool) == 0) {
+				fail(ht, "ToStringMapBoolE(%T %v) = %v, %v; want %v", in, in, g, err, wantBool)
+			}
+		}
+		if shape == 0 || shape == 1 || shape == 5 {
+			if g, err := cast.ToStringMapE(in); err != nil || len(g) != len(items) {
+				fail(ht, "ToStringMapE(%T %v) = %v, %v; want %d entries", in, in, g, err, len(items))
+			}
+		}
+		// the reflect path reports an unconvertible value
+		if k > 0 && shape == 4 {
+			m := in.(map[string]string)
+			bad := map[string]string{}
+			for key, v := range m {
+				bad[key] = v
+			}
+			for key := range bad {
+				bad[key] = "x"
+				break
+			}
+			if g, err := cast.ToStringMapInt64E(bad); err == nil {
+				fail(ht, "ToStringMapInt64E(%v) = %v with no error", bad, g)
+			}
+		}
+	})
+}
+
+// ToStringMapStringSliceE: slice values are stringified element-wise,
+// scalar values become one-element slices, for every map kind alike.
+func TestHegelStringSliceMapsKeepValuesWhole(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 4)
+		items := map[string]any{}
+		want := map[string][]string{}
+		for i := 0; i < k; i++ {
+			key := pick(ht, []string{"a", "b", "c", "d"})
+			if chance(ht, 50) {
+				var xs []any
+				var ws []string
+				for j := 0; j < n(ht, 0, 3); j++ {
+					x, _ := genScalar(ht)
+					xs = append(xs, x)
+					ws = append(ws, cast.ToString(x))
+				}
+				items[key] = xs
+				want[key] = ws
+			} else {
+				x, _ := genScalar(ht)
+				items[key] = x
+				want[key] = []string{cast.ToString(x)}
+			}
+		}
+		var in any = items
+		switch n(ht, 0, 2) {
+		case 1:
+			m := map[any]any{}
+			for key, x := range items {
+				m[key] = x
+			}
+			in = m
+		case 2:
+			m := map[string][]any{}
+			for key, x := range items {
+				if xs, ok := x.([]any); ok {
+					m[key] = xs
+				} else {
+					m[key] = []any{x}
+				}
+			}
+			in = m
+		}
+		note(ht, "input %T %v", in, in)
+		got, err := cast.ToStringMapStringSliceE(in)
+		if err != nil {
+			fail(ht, "ToStringMapStringSliceE(%T %v) failed: %v", in, in, err)
+		}
+		for key, ws := range want {
+			if g := got[key]; !(reflect.DeepEqual(g, ws) || len(g) == 0 && len(ws) == 0) {
+				fail(ht, "ToStringMapStringSliceE(%T %v)[%q] = %q, want %q", in, in, key, g, ws)
+			}
+		}
+		if len(got) != len(want) {
+			fail(ht, "ToStringMapStringSliceE(%T %v) has %d keys, want %d", in, in, len(got), len(want))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Pins.  Each records one difference between cast's behaviour and its
+// contract; listed in targets/go/cast/bugs.toml and expected to fail.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// cast/1: numeric inputs are converted with a plain Go conversion, so
+// values outside the target's range wrap or turn into garbage instead of
+// failing: int(300) → int8 44, uint64 max → int64 -1, float64 1e20 → int64
+// MinInt64, NaN → MinInt64, float64 1e40 → float32 +Inf.
+func TestHegelPinOutOfRangeNumbersAreErrors(t *testing.T) {
+	defer guard(t)
+	if v, err := cast.ToInt8E(300); err == nil {
+		t.Errorf("ToInt8E(300) = %d, nil; want an error", v)
+	}
+	if v, err := cast.ToUint8E(uint16(256)); err == nil {
+		t.Errorf("ToUint8E(uint16(256)) = %d, nil; want an error", v)
+	}
+	if v, err := cast.ToInt64E(uint64(math.MaxUint64)); err == nil {
+		t.Errorf("ToInt64E(MaxUint64) = %d, nil; want an error", v)
+	}
+	if v, err := cast.ToInt64E(1e20); err == nil {
+		t.Errorf("ToInt64E(1e20) = %d, nil; want an error", v)
+	}
+	if v, err := cast.ToIntE(math.NaN()); err == nil {
+		t.Errorf("ToIntE(NaN) = %d, nil; want an error", v)
+	}
+	if v, err := cast.ToFloat32E(1e40); err == nil {
+		t.Errorf("ToFloat32E(1e40) = %v, nil; want an error", v)
+	}
+}
+
+// cast/2: decimal strings are parsed as 64-bit integers and then converted
+// to the narrower type without a range check, so "300" → int8 44 and
+// "256" → uint8 0, where strconv.ParseInt(s, 10, 8) reports a range error.
+func TestHegelPinOutOfRangeStringsAreErrors(t *testing.T) {
+	defer guard(t)
+	if v, err := cast.ToInt8E("300"); err == nil {
+		t.Errorf("ToInt8E(%q) = %d, nil; want an error", "300", v)
+	}
+	if v, err := cast.ToUint8E("256"); err == nil {
+		t.Errorf("ToUint8E(%q) = %d, nil; want an error", "256", v)
+	}
+	if v, err := cast.ToInt32E(json.Number("4294967297")); err == nil {
+		t.Errorf("ToInt32E(json.Number(4294967297)) = %d, nil; want an error", v)
+	}
+}
+
+// cast/3: strings are parsed with base 0 (Go literal syntax), so a leading
+// zero means octal: "010" is 8 and "08" is an error, and "0x1f", "0b11",
+// "0o17" and "1_000" are accepted — none of which is "a string
+// representation of an int such as 8" as the README puts it.
+func TestHegelPinLeadingZerosAreDecimal(t *testing.T) {
+	defer guard(t)
+	if v, err := cast.ToIntE("010"); err != nil || v != 10 {
+		t.Errorf("ToIntE(%q) = %d, %v; want 10", "010", v, err)
+	}
+	if v, err := cast.ToIntE("08"); err != nil || v != 8 {
+		t.Errorf("ToIntE(%q) = %d, %v; want 8", "08", v, err)
+	}
+	if v, err := cast.ToUintE("09"); err != nil || v != 9 {
+		t.Errorf("ToUintE(%q) = %d, %v; want 9", "09", v, err)
+	}
+}
+
+// cast/4: ".", "-." and "+." convert to 0 without error (the decimal
+// trimming turns them into "0", "-0" and "+0").
+func TestHegelPinBareDotIsNotANumber(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{".", "-.", "+."} {
+		if v, err := cast.ToIntE(s); err == nil {
+			t.Errorf("ToIntE(%q) = %d, nil; want an error", s, v)
+		}
+	}
+}
+
+// cast/5: time.UnixDate ("Mon Jan _2 15:04:05 MST 2006") precedes
+// time.RubyDate ("Mon Jan 02 15:04:05 -0700 2006") in the layout list, and
+// Go's zone-name slot accepts "+0000".."+0023" (and the negatives) as a
+// name, so a RubyDate string with such an offset — "+0000" is what UTC
+// looks like in that format — is parsed by UnixDate, classified "named
+// timezone", and re-read as a wall clock in the default location:
+// "Mon Jan 02 15:04:05 +0000 2006" with a UTC+1 default becomes
+// 15:04:05+01:00, an hour early. Larger offsets fall through to RubyDate
+// and are right.
+func TestHegelPinRubyDateKeepsItsOffset(t *testing.T) {
+	defer guard(t)
+	want := time.Date(2006, 1, 2, 15, 4, 5, 0, time.UTC)
+	s := want.Format(time.RubyDate) // "Mon Jan 02 15:04:05 +0000 2006"
+	got, err := cast.ToTimeInDefaultLocationE(s, time.FixedZone("CET", 3600))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !got.Equal(want) {
+		t.Fatalf("ToTimeInDefaultLocationE(%q, CET) = %v, want the instant %v", s, got, want)
+	}
+}
+
+// cast/6: ToBoolE of a json.Number goes through the integer conversion, so
+// "0.5" is false (its integer part is 0) although 0.5 as a float64 is true,
+// and "1e3", a valid JSON number, is an error.
+func TestHegelPinJSONNumberBoolIsNonZero(t *testing.T) {
+	defer guard(t)
+	if v, err := cast.ToBoolE(json.Number("0.5")); err != nil || !v {
+		t.Errorf("ToBoolE(json.Number(0.5)) = %v, %v; want true", v, err)
+	}
+	if v, err := cast.ToBoolE(json.Number("1e3")); err != nil || !v {
+		t.Errorf("ToBoolE(json.Number(1e3)) = %v, %v; want true", v, err)
+	}
+}
+
+// cast/7: for map[string]any and map[any]any inputs the map conversions
+// convert values with the plain (error-swallowing) functions, so an
+// unconvertible value silently becomes the zero value; the same map as
+// map[string]string reports the error.
+func TestHegelPinMapValuesReportErrors(t *testing.T) {
+	defer guard(t)
+	if m, err := cast.ToStringMapIntE(map[string]any{"a": "x"}); err == nil {
+		t.Errorf("ToStringMapIntE(map[string]any{a: x}) = %v, nil; map[string]string{a: x} is an error", m)
+	}
+	if m, err := cast.ToStringMapInt64E(map[any]any{"a": "x"}); err == nil {
+		t.Errorf("ToStringMapInt64E(map[any]any{a: x}) = %v, nil; want an error", m)
+	}
+	if m, err := cast.ToStringMapBoolE(map[string]any{"a": "maybe"}); err == nil {
+		t.Errorf("ToStringMapBoolE(map[string]any{a: maybe}) = %v, nil; want an error", m)
+	}
+	if m, err := cast.ToStringMapStringE(map[string]any{"a": struct{}{}}); err == nil {
+		t.Errorf("ToStringMapStringE(map[string]any{a: struct{}}) = %v, nil; want an error", m)
+	}
+}
+
+// cast/8: ToStringMapStringSliceE splits a string value on white space
+// when the map is map[any]string or map[any]any (it calls ToStringSlice)
+// but keeps it whole for map[string]string and map[string]any.
+func TestHegelPinStringSliceMapValuesAreNotSplit(t *testing.T) {
+	defer guard(t)
+	want := []string{"x y"}
+	if m, err := cast.ToStringMapStringSliceE(map[any]string{"a": "x y"}); err != nil || !reflect.DeepEqual(m["a"], want) {
+		t.Errorf("ToStringMapStringSliceE(map[any]string{a: %q}) = %v, %v; map[string]string gives %q", "x y", m, err, want)
+	}
+	if m, err := cast.ToStringMapStringSliceE(map[any]any{"a": "x y"}); err != nil || !reflect.DeepEqual(m["a"], want) {
+		t.Errorf("ToStringMapStringSliceE(map[any]any{a: %q}) = %v, %v; map[string]any gives %q", "x y", m, err, want)
+	}
+}
+
+// cast/9: ToTimeE accepts int, int32, int64, uint, uint32 and uint64 as
+// Unix seconds but rejects int8, int16, uint8, uint16, floats and named
+// integer types, which every other conversion accepts.
+func TestHegelPinEveryIntegerKindIsUnixSeconds(t *testing.T) {
+	defer guard(t)
+	want := time.Unix(5, 0)
+	for _, in := range []any{int8(5), int16(5), uint8(5), uint16(5), myInt(5), float64(5)} {
+		got, err := cast.ToTimeE(in)
+		if err != nil || !got.Equal(want) {
+			t.Errorf("ToTimeE(%T %v) = %v, %v; ToTimeE(int 5) = %v", in, in, got, err, want)
+		}
+	}
+}
+
+// cast/10: the unsigned parsers strip every leading '+', so "++5" and
+// "+++5" are 5; the signed parsers (and strconv) reject them.
+func TestHegelPinDoublePlusIsRejected(t *testing.T) {
+	defer guard(t)
+	if v, err := cast.ToUintE("++5"); err == nil {
+		t.Errorf("ToUintE(%q) = %d, nil; want an error (ToIntE gives %v)", "++5", v, func() error { _, e := cast.ToIntE("++5"); return e }())
+	}
+}
+
+// cast/12: ToStringMapE, ToStringMapStringE and ToStringMapBoolE accept
+// only map[string]any, map[any]any, map[any]<their value type> and their
+// own type; every other map is "unable to cast" — ToStringMapE refuses a
+// map[string]string, ToStringMapStringE a map[string]int — although
+// ToStringMapIntE converts any map through reflection and the element
+// conversions exist.
+func TestHegelPinStringMapsAcceptAnyMap(t *testing.T) {
+	defer guard(t)
+	if m, err := cast.ToStringMapE(map[string]string{"a": "1"}); err != nil || len(m) != 1 {
+		t.Errorf("ToStringMapE(map[string]string{a: 1}) = %v, %v; want one entry", m, err)
+	}
+	if m, err := cast.ToStringMapStringE(map[string]int{"a": 1}); err != nil || m["a"] != "1" {
+		t.Errorf("ToStringMapStringE(map[string]int{a: 1}) = %v, %v; want {a: 1}", m, err)
+	}
+	if m, err := cast.ToStringMapBoolE(map[string]int{"a": 1}); err != nil || !m["a"] {
+		t.Errorf("ToStringMapBoolE(map[string]int{a: 1}) = %v, %v; want {a: true}", m, err)
+	}
+}
+
+// cast/11: ToStringMapIntE / ToStringMapInt64E panic on a map whose key
+// type is neither string nor any once it reaches the reflect path
+// (map[any]string, map[any]int64 for the int variant, map[int]int…):
+// reflect.Value.SetMapIndex is given the original key.
+func TestHegelPinIntegerMapsWithOtherKeysDoNotPanic(t *testing.T) {
+	defer guard(t)
+	m, err := cast.ToStringMapInt64E(map[any]string{"a": "1"})
+	if err != nil || m["a"] != 1 {
+		t.Errorf("ToStringMapInt64E(map[any]string{a: 1}) = %v, %v; want {a: 1}", m, err)
+	}
+	m2, err := cast.ToStringMapIntE(map[int]int{7: 1})
+	if err != nil || m2["7"] != 1 {
+		t.Errorf("ToStringMapIntE(map[int]int{7: 1}) = %v, %v; want {7: 1}", m2, err)
+	}
+}
