+package cast_test
+
+// Hegel property tests for github.com/spf13/cast.
+//
+// There is no second implementation of cast to compare against, so the
+// oracle is the package's own contract as the README and doc comments state
+// it ("Cast does this intelligently when an obvious conversion is possible…
+// you can only convert a string to an int when it is a string representation
+// of an int"; the E variants "tell you if it successfully converted"; the
+// plain variants return the zero value on failure), made concrete by small
+// models: the exact value of a number and the range of each Go type, the
+// standard library's strconv/time parsers, element-wise conversion for
+// slices and maps, and the round trip ToX(ToString(v)) == v.
+//
+// Every property draws one case record built from the binding's combinators
+// (a number with the Go kind it is handed in, a text, a round-trip value, a
+// layout with a clock and two zones, a Unix second with its kind, a slice or
+// a map of small scalars with an optional unconvertible spot) and pure
+// functions turn the record into the Go value cast is given. The shapes of
+// the recorded bugs (bugs.toml) are drawn by default and the properties that
+// meet them fail, naming the shape; HEGEL_NO_KNOWN=1 switches the shapes off
+// (noKnown, below) for a run that looks past the bugs. The pins at the end
+// are the regression examples.
+//
+// Set CAST_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/spf13/cast"
+	"github.com/spf13/cast/internal"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("CAST_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// caught runs fn and returns what it panicked with, nil when it returned.
+func caught(fn func()) (p any) {
+	defer func() { p = recover() }()
+	fn()
+	return nil
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape; under HEGEL_NO_KNOWN=1 the gates of
+// Known are on: the shapes are left out of the generators (shaped) or the
+// sub-check that meets them is left out, and a mismatch that still has a
+// known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the sub-checks and generator shapes of recorded bugs (see
+// bugs.toml); on means the shape is left out or the sub-check that meets
+// it is not made, which is so only under HEGEL_NO_KNOWN=1. The shapes that
+// are pools or spellings (the zero-padded and bare-dot and doubled-plus
+// texts of cast/3, cast/4 and cast/10, the blank-holding map values of
+// cast/8) are switched by shaped at the generator. The pins at the end
+// assert the correct behaviour and fail while a bug is open.
+var Known = struct {
+	outOfRange      bool // cast/1, cast/2: numbers and decimal texts beyond the target's range wrap instead of failing
+	rubyDateOffsets bool // cast/5: a RubyDate text with an offset under 24 minutes is claimed by UnixDate
+	jsonNumberBool  bool // cast/6: ToBoolE of a json.Number goes through the integer parser
+	mapValueErrors  bool // cast/7: map[string]any / map[any]any conversions swallow value errors
+	timeIntegerKind bool // cast/9: ToTimeE rejects the narrow, named and float kinds as Unix seconds
+	mapKeyPanic     bool // cast/11: ToStringMapIntE / Int64E panic on map[any]string
+	mapValueTypes   bool // cast/12: ToStringMapE / StringE / BoolE refuse maps of other value types
+}{
+	outOfRange:      noKnown,
+	rubyDateOffsets: noKnown,
+	jsonNumberBool:  noKnown,
+	mapValueErrors:  noKnown,
+	timeIntegerKind: noKnown,
+	mapKeyPanic:     noKnown,
+	mapValueTypes:   noKnown,
+}
+
+// mismatch reports a disagreement with the contract on a case whose shape is
+// that of the recorded bug shape names ("" for none): the failure names the
+// shape, and under HEGEL_NO_KNOWN=1 a disagreement on a known shape is
+// skipped instead (rare then, since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// asAny widens a generator's values to any.
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(v T) any { return v })
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+func sortedKeys[V any](m map[string]V) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// ---------------------------------------------------------------------------
+// Numbers: the value model.
+
+// num is an exact numeric value: its integer part truncated toward zero
+// (big), whether a fractional part was dropped, its sign, its float64
+// reading, and whether it is NaN or an infinity.
+type num struct {
+	big     *big.Int
+	frac    bool
+	neg     bool
+	f       float64
+	special bool
+}
+
+func fromInt64(v int64) num {
+	return num{big: big.NewInt(v), neg: v < 0, f: float64(v)}
+}
+
+func fromUint64(v uint64) num {
+	return num{big: new(big.Int).SetUint64(v), f: float64(v)}
+}
+
+func fromFloat(v float64) num {
+	if math.IsNaN(v) || math.IsInf(v, 0) {
+		return num{special: true, f: v}
+	}
+	ip, fp := math.Modf(v)
+	b, _ := new(big.Float).SetFloat64(ip).Int(nil)
+	return num{big: b, frac: fp != 0, neg: v < 0, f: v}
+}
+
+func bounds(bits int, signed bool) (lo, hi *big.Int) {
+	if signed {
+		lo = new(big.Int).Neg(new(big.Int).Lsh(big.NewInt(1), uint(bits-1)))
+		hi = new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), uint(bits-1)), big.NewInt(1))
+		return
+	}
+	return big.NewInt(0), new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), uint(bits)), big.NewInt(1))
+}
+
+// fitsSigned reports whether the integer part fits a signed type of bits.
+func (v num) fitsSigned(bits int) bool {
+	if v.special {
+		return false
+	}
+	lo, hi := bounds(bits, true)
+	return v.big.Cmp(lo) >= 0 && v.big.Cmp(hi) <= 0
+}
+
+// fitsUnsigned reports whether the value is acceptable for an unsigned
+// type of bits: not negative (cast refuses any negative value, -0.5 too)
+// and within range.
+func (v num) fitsUnsigned(bits int) bool {
+	if v.special || v.neg {
+		return false
+	}
+	_, hi := bounds(bits, false)
+	return v.big.Cmp(hi) <= 0
+}
+
+// ---------------------------------------------------------------------------
+// Numbers: inputs.
+
+type myInt int
+type myInt64 int64
+type myUint8 uint8
+type myFloat float64
+type myString string
+type myBool bool
+
+// input is a Go value handed to cast together with the exact number it
+// denotes, how it is shaped, and the decimal string when it is textual.
+type input struct {
+	value any
+	num   num
+	desc  string
+	text  string // the decimal text for string/json.Number inputs, else ""
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (in input) GoString() string { return in.desc }
+
+// exact is the number's integer part as text, or NaN/Inf.
+func (in input) exact() string {
+	if in.num.special {
+		return fmt.Sprint(in.num.f)
+	}
+	return in.num.big.String()
+}
+
+// rangeShape names the recorded bug an out-of-range input meets: a decimal
+// text is parsed at 64 bits and truncated (cast/2), a Go number converted
+// with a plain conversion (cast/1); a text with a base-0 shape is cast/3.
+func (in input) rangeShape() string {
+	if in.text == "" {
+		return "cast/1"
+	}
+	if s := textShape(in.text); s != "" {
+		return s
+	}
+	return "cast/2"
+}
+
+var (
+	// boundaries: the limits of every Go integer width.
+	boundaries = []int64{math.MaxInt8, math.MinInt8, math.MaxInt16, math.MinInt16, math.MaxInt32, math.MinInt32, math.MaxInt64, math.MinInt64, math.MaxUint8, math.MaxUint16, math.MaxUint32}
+	// innerBoundaries: the limits a step of up to three can cross without leaving int64.
+	innerBoundaries = boundaries[:6:6]
+	// nearBoundaries: a boundary plus or minus up to three.
+	nearBoundaries = hegel.Composite(func(tc hegel.TestCase) int64 {
+		return hegel.Draw(tc, hegel.SampledFrom(append(innerBoundaries, math.MaxUint8, math.MaxUint16, math.MaxUint32))) + hegel.Draw(tc, hegel.Integers[int64](-3, 3))
+	})
+	// intValues: an integer with the type boundaries over-represented: a small
+	// value (3), a boundary (1), a value near one (1), the whole int64 range (5).
+	intValues = weighted(
+		choice[int64]{3, hegel.Integers[int64](-1000, 1000)},
+		choice[int64]{1, hegel.SampledFrom(boundaries)},
+		choice[int64]{1, nearBoundaries},
+		choice[int64]{5, hegel.Integers[int64](math.MinInt64, math.MaxInt64)},
+	)
+	// uint64s: the whole uint64 range (beyond int64 half of the time).
+	uint64s = hegel.Integers[uint64](0, math.MaxUint64)
+)
+
+// intKindsFor lists the Go kinds an integer may be handed in, plainest
+// first: int and int64, the narrower signed widths that hold it, the named
+// types, the unsigned widths that hold it (non-negative values only) and
+// the float types in which it is exact.
+func intKindsFor(v int64) []string {
+	kinds := []string{"int", "int64"}
+	if v >= math.MinInt8 && v <= math.MaxInt8 {
+		kinds = append(kinds, "int8")
+	}
+	if v >= math.MinInt16 && v <= math.MaxInt16 {
+		kinds = append(kinds, "int16")
+	}
+	if v >= math.MinInt32 && v <= math.MaxInt32 {
+		kinds = append(kinds, "int32")
+	}
+	kinds = append(kinds, "myInt", "myInt64")
+	if v >= 0 {
+		if v <= math.MaxUint8 {
+			kinds = append(kinds, "uint8", "myUint8")
+		}
+		if v <= math.MaxUint16 {
+			kinds = append(kinds, "uint16")
+		}
+		if v <= math.MaxUint32 {
+			kinds = append(kinds, "uint32")
+		}
+		kinds = append(kinds, "uint64", "uint")
+	}
+	if v > -1<<53 && v < 1<<53 {
+		kinds = append(kinds, "float64", "myFloat")
+	}
+	if v > -1<<24 && v < 1<<24 {
+		kinds = append(kinds, "float32")
+	}
+	return kinds
+}
+
+// typedInt is v in the named Go kind.
+func typedInt(kind string, v int64) any {
+	switch kind {
+	case "int":
+		return int(v)
+	case "int8":
+		return int8(v)
+	case "int16":
+		return int16(v)
+	case "int32":
+		return int32(v)
+	case "myInt":
+		return myInt(v)
+	case "myInt64":
+		return myInt64(v)
+	case "uint8":
+		return uint8(v)
+	case "myUint8":
+		return myUint8(v)
+	case "uint16":
+		return uint16(v)
+	case "uint32":
+		return uint32(v)
+	case "uint64":
+		return uint64(v)
+	case "uint":
+		return uint(v)
+	case "float64":
+		return float64(v)
+	case "myFloat":
+		return myFloat(v)
+	case "float32":
+		return float32(v)
+	}
+	return v
+}
+
+// decimalStyle is the freedom a decimal text has: a '+' sign on a
+// non-negative value, leading zeros (the shape of cast/3: base-0 parsing
+// reads them as octal; none under HEGEL_NO_KNOWN=1) and a "." tail of up to
+// three zeros (cast drops a decimal part).
+type decimalStyle struct {
+	plus  bool
+	zeros int
+	tail  *int
+}
+
+var decimalStyles = hegel.Composite(func(tc hegel.TestCase) decimalStyle {
+	return decimalStyle{
+		plus:  hegel.Draw(tc, chance(20)),
+		zeros: hegel.Draw(tc, shaped[hegel.Generator[int]](maybe(20, hegel.Integers(1, 3)), hegel.Just(0))),
+		tail:  hegel.Draw(tc, optional(20, hegel.Integers(0, 3))),
+	}
+})
+
+// render writes v in the style.
+func (st decimalStyle) render(v *big.Int) string {
+	s, sign := v.String(), ""
+	switch {
+	case v.Sign() < 0:
+		sign, s = "-", s[1:]
+	case st.plus:
+		sign = "+"
+	}
+	s = strings.Repeat("0", st.zeros) + s
+	if st.tail != nil {
+		s += "." + strings.Repeat("0", *st.tail)
+	}
+	return sign + s
+}
+
+// intInputs: an integer handed over as a typed Go value (2; a pointer to it
+// one time in five), as a uint64 (1: the value's own bits, or any uint64
+// half of the time), as a decimal string (2) or as a json.Number (1).
+var intInputs = hegel.FlatMap(intValues, func(v int64) hegel.Generator[input] {
+	nm := fromInt64(v)
+	typed := hegel.Composite(func(tc hegel.TestCase) input {
+		x := typedInt(hegel.Draw(tc, hegel.SampledFrom(intKindsFor(v))), v)
+		in := input{value: x, num: nm, desc: fmt.Sprintf("%T(%v)", x, x)}
+		if hegel.Draw(tc, chance(20)) {
+			p := reflect.New(reflect.TypeOf(x))
+			p.Elem().Set(reflect.ValueOf(x))
+			in.value, in.desc = p.Interface(), "*"+in.desc
+		}
+		return in
+	})
+	unsigned := hegel.Map(weighted(choice[uint64]{50, hegel.Just(uint64(v))}, choice[uint64]{50, uint64s}), func(u uint64) input {
+		return input{value: u, num: fromUint64(u), desc: fmt.Sprintf("uint64(%d)", u)}
+	})
+	texts := hegel.Map(decimalStyles, func(st decimalStyle) input { return textInput(false, st.render(nm.big), nm) })
+	jsons := hegel.Map(decimalStyles, func(st decimalStyle) input { return textInput(true, st.render(nm.big), nm) })
+	return weighted(choice[input]{2, typed}, choice[input]{1, unsigned}, choice[input]{2, texts}, choice[input]{1, jsons})
+})
+
+// textInput is the decimal text s of the number nm, as a json.Number when
+// asJSON and a string otherwise.
+func textInput(asJSON bool, s string, nm num) input {
+	if asJSON {
+		return input{value: json.Number(s), num: nm, desc: fmt.Sprintf("json.Number(%q)", s), text: s}
+	}
+	return input{value: s, num: nm, desc: strconv.Quote(s), text: s}
+}
+
+var (
+	specialFloats = []float64{math.NaN(), math.Inf(1), math.Inf(-1)}
+	floatPool     = []float64{math.MaxFloat64, -math.MaxFloat64, math.MaxFloat32, -math.MaxFloat32, math.SmallestNonzeroFloat64, 1e300, -1e300, 1e20, 9.3e18, -9.3e18, 4.3e9, 65536.5, 255.5, 128.5, -128.5, -0.5, 0.5, -0.0}
+	fractions     = []float64{0.25, 0.5, 0.75, 0.1, 0.9, 0.999}
+	// smallFractions: a small integer plus or minus a fraction.
+	smallFractions = hegel.Composite(func(tc hegel.TestCase) float64 {
+		return float64(hegel.Draw(tc, hegel.Integers[int64](-1000, 1000))) + hegel.Draw(tc, hegel.SampledFrom(fractions))*float64(hegel.Draw(tc, hegel.SampledFrom([]int{1, -1})))
+	})
+	float32Bits = hegel.Map(hegel.Integers[uint32](0, math.MaxUint32), func(b uint32) float64 { return float64(math.Float32frombits(b)) })
+	float64Bits = hegel.Map(hegel.Integers[int64](math.MinInt64, math.MaxInt64), func(b int64) float64 { return math.Float64frombits(uint64(b)) })
+	// floatValues: a small value with a fraction (1), NaN or an infinity (1),
+	// a limit or an interesting value (1), any float32 (1), any float64 (3).
+	floatValues = weighted(
+		choice[float64]{1, smallFractions},
+		choice[float64]{1, hegel.SampledFrom(specialFloats)},
+		choice[float64]{1, hegel.SampledFrom(floatPool)},
+		choice[float64]{1, float32Bits},
+		choice[float64]{3, float64Bits},
+	)
+	// floatInputs: a float handed over in one of the kinds that hold it.
+	floatInputs = hegel.FlatMap(floatValues, func(f float64) hegel.Generator[input] {
+		return hegel.Map(hegel.SampledFrom(floatKindsFor(f)), func(kind string) input { return floatInput(kind, f) })
+	})
+	// numberInputs: an integer-valued input (65%) or a float one (35%).
+	numberInputs = weighted(choice[input]{65, intInputs}, choice[input]{35, floatInputs})
+)
+
+// floatKindsFor lists the kinds a float may be handed in, plainest first:
+// float64, the named type, float32 when it is exact in it, and (finite
+// values) its shortest decimal text as a string or a json.Number, twice each.
+func floatKindsFor(f float64) []string {
+	kinds := []string{"float64", "myFloat"}
+	nm := fromFloat(f)
+	if float64(float32(f)) == f || nm.special {
+		kinds = append(kinds, "float32")
+	}
+	if !nm.special {
+		kinds = append(kinds, "string", "string", "json", "json")
+	}
+	return kinds
+}
+
+// floatInput is f in the named kind.
+func floatInput(kind string, f float64) input {
+	nm := fromFloat(f)
+	switch kind {
+	case "float32":
+		f32 := float32(f)
+		return input{value: f32, num: fromFloat(float64(f32)), desc: fmt.Sprintf("float32(%v)", f32)}
+	case "myFloat":
+		return input{value: myFloat(f), num: nm, desc: fmt.Sprintf("myFloat(%v)", f)}
+	case "string", "json":
+		s := strconv.FormatFloat(f, 'f', -1, 64)
+		if strings.HasPrefix(s, "-") {
+			nm.neg = true // "-0": a minus sign is refused by the unsigned parsers, as strconv does
+		}
+		if kind == "json" {
+			return input{value: json.Number(s), num: nm, desc: fmt.Sprintf("json.Number(%q)", s), text: s}
+		}
+		return input{value: s, num: nm, desc: strconv.Quote(s), text: s}
+	}
+	return input{value: f, num: nm, desc: fmt.Sprintf("float64(%v)", f)}
+}
+
+// ---------------------------------------------------------------------------
+// Numbers: the property.
+
+// checkInt compares one signed conversion with the model.
+func checkInt[T int | int8 | int16 | int32 | int64](ht *hegel.T, in input, bits int, name string, fn func(any) (T, error), plain func(any) T) {
+	got, err := fn(in.value)
+	if !in.num.fitsSigned(bits) {
+		// out of range, NaN or Inf: an error and a zero (cast/1 for Go
+		// numbers, cast/2 for texts); the sub-check is left out under
+		// HEGEL_NO_KNOWN=1
+		if Known.outOfRange {
+			return
+		}
+		shape := in.rangeShape()
+		if err == nil {
+			mismatch(ht, shape, "%s(%s) = %v with no error; the value %s does not fit", name, in.desc, got, in.exact())
+		}
+		if g := plain(in.value); g != 0 {
+			mismatch(ht, shape, "%s(%s) = %v; the plain variant must return 0 on failure", name, in.desc, g)
+		}
+		if g, e := cast.ToE[T](in.value); e == nil {
+			mismatch(ht, shape, "ToE[%T](%s) = %v with no error; %s fails", got, in.desc, g, name)
+		}
+		if g, e := cast.ToNumberE[T](in.value); e == nil {
+			mismatch(ht, shape, "ToNumberE[%T](%s) = %v with no error; %s fails", got, in.desc, g, name)
+		}
+		return
+	}
+	if err != nil {
+		mismatch(ht, textShape(in.text), "%s(%s) failed: %v; the value %s fits", name, in.desc, err, in.num.big)
+	}
+	want := T(in.num.big.Int64())
+	if got != want {
+		mismatch(ht, textShape(in.text), "%s(%s) = %v, want %v", name, in.desc, got, want)
+	}
+	if g := plain(in.value); g != want {
+		fail(ht, "plain %s(%s) = %v, want %v", name, in.desc, g, want)
+	}
+	if g, e := cast.ToE[T](in.value); e != nil || g != want {
+		fail(ht, "ToE[%T](%s) = %v, %v; %s gives %v", want, in.desc, g, e, name, want)
+	}
+	if g, e := cast.ToNumberE[T](in.value); e != nil || g != want {
+		fail(ht, "ToNumberE[%T](%s) = %v, %v; %s gives %v", want, in.desc, g, e, name, want)
+	}
+}
+
+func checkUint[T uint | uint8 | uint16 | uint32 | uint64](ht *hegel.T, in input, bits int, name string, fn func(any) (T, error), plain func(any) T) {
+	got, err := fn(in.value)
+	fits := in.num.fitsUnsigned(bits)
+	if !fits && !in.num.neg {
+		// out of range, NaN or Inf: as for the signed conversions
+		if Known.outOfRange {
+			return
+		}
+		shape := in.rangeShape()
+		if err == nil {
+			mismatch(ht, shape, "%s(%s) = %v with no error; the value %s does not fit", name, in.desc, got, in.exact())
+		}
+		if g := plain(in.value); g != 0 {
+			mismatch(ht, shape, "%s(%s) = %v; the plain variant must return 0 on failure", name, in.desc, g)
+		}
+		if g, e := cast.ToE[T](in.value); e == nil {
+			mismatch(ht, shape, "ToE[%T](%s) = %v with no error; %s fails", got, in.desc, g, name)
+		}
+		if g, e := cast.ToNumberE[T](in.value); e == nil {
+			mismatch(ht, shape, "ToNumberE[%T](%s) = %v with no error; %s fails", got, in.desc, g, name)
+		}
+		return
+	}
+	if !fits {
+		if err == nil {
+			mismatch(ht, textShape(in.text), "%s(%s) = %v with no error; negative values cannot convert", name, in.desc, got)
+		}
+		if plain(in.value) != 0 {
+			mismatch(ht, textShape(in.text), "%s(%s) = %v; the plain variant must return 0 on failure", name, in.desc, plain(in.value))
+		}
+		return
+	}
+	if err != nil {
+		mismatch(ht, textShape(in.text), "%s(%s) failed: %v; the value %s fits", name, in.desc, err, in.num.big)
+	}
+	want := T(in.num.big.Uint64())
+	if got != want {
+		mismatch(ht, textShape(in.text), "%s(%s) = %v, want %v", name, in.desc, got, want)
+	}
+	if g := plain(in.value); g != want {
+		fail(ht, "plain %s(%s) = %v, want %v", name, in.desc, g, want)
+	}
+	if g, e := cast.ToE[T](in.value); e != nil || g != want {
+		fail(ht, "ToE[%T](%s) = %v, %v; %s gives %v", want, in.desc, g, e, name, want)
+	}
+	if g, e := cast.ToNumberE[T](in.value); e != nil || g != want {
+		fail(ht, "ToNumberE[%T](%s) = %v, %v; %s gives %v", want, in.desc, g, e, name, want)
+	}
+}
+
+func sameFloat(a, b float64) bool {
+	return a == b || (math.IsNaN(a) && math.IsNaN(b))
+}
+
+// Every number-shaped input — integers of every width, named integer and
+// float types, pointers, floats with fractions, NaN and infinities, decimal
+// strings and json.Numbers with an optional sign and ".0" tail — converts
+// through every ToXxxE to the value the model gives (the integer part,
+// truncated toward zero, when it fits the target type; an error for
+// negative values into unsigned types and for NaN/Inf into integers), the
+// plain variants return the same value or zero, and the generic ToE /
+// ToNumberE agree with the typed functions. A value beyond the target's
+// range is an error and a zero (cast/1, cast/2), a zero-padded text is
+// decimal (cast/3) and a json.Number is true when it is not zero (cast/6).
+func TestHegelNumbersConvertByValue(t *testing.T) {
+	property(t, func(ht *hegel.T) { checkNumber(ht, hegel.Draw(ht, numberInputs)) })
+}
+
+// checkNumber is the body of TestHegelNumbersConvertByValue.
+func checkNumber(ht *hegel.T, in input) {
+	checkInt(ht, in, 64, "ToInt64E", cast.ToInt64E, cast.ToInt64)
+	checkInt(ht, in, strconv.IntSize, "ToIntE", cast.ToIntE, cast.ToInt)
+	checkInt(ht, in, 32, "ToInt32E", cast.ToInt32E, cast.ToInt32)
+	checkInt(ht, in, 16, "ToInt16E", cast.ToInt16E, cast.ToInt16)
+	checkInt(ht, in, 8, "ToInt8E", cast.ToInt8E, cast.ToInt8)
+	checkUint(ht, in, 64, "ToUint64E", cast.ToUint64E, cast.ToUint64)
+	checkUint(ht, in, strconv.IntSize, "ToUintE", cast.ToUintE, cast.ToUint)
+	checkUint(ht, in, 32, "ToUint32E", cast.ToUint32E, cast.ToUint32)
+	checkUint(ht, in, 16, "ToUint16E", cast.ToUint16E, cast.ToUint16)
+	checkUint(ht, in, 8, "ToUint8E", cast.ToUint8E, cast.ToUint8)
+
+	// float64: the float64 reading of a Go value, or strconv's reading of the text
+	want64 := in.num.f
+	if in.text != "" {
+		want64, _ = strconv.ParseFloat(in.text, 64)
+	}
+	got64, err := cast.ToFloat64E(in.value)
+	if err != nil {
+		fail(ht, "ToFloat64E(%s) failed: %v", in.desc, err)
+	}
+	if !sameFloat(got64, want64) {
+		fail(ht, "ToFloat64E(%s) = %v, want %v", in.desc, got64, want64)
+	}
+	if g := cast.ToFloat64(in.value); !sameFloat(g, want64) {
+		fail(ht, "ToFloat64(%s) = %v, want %v", in.desc, g, want64)
+	}
+	if g, e := cast.ToE[float64](in.value); e != nil || !sameFloat(g, want64) {
+		fail(ht, "ToE[float64](%s) = %v, %v, want %v", in.desc, g, e, want64)
+	}
+
+	// float32
+	if in.text != "" {
+		w, perr := strconv.ParseFloat(in.text, 32)
+		got32, err := cast.ToFloat32E(in.value)
+		if (perr == nil) != (err == nil) {
+			fail(ht, "ToFloat32E(%s) = %v, %v; strconv.ParseFloat(_, 32) says %v, %v", in.desc, got32, err, w, perr)
+		}
+		if err == nil && !sameFloat(float64(got32), w) {
+			fail(ht, "ToFloat32E(%s) = %v, want %v", in.desc, got32, w)
+		}
+	} else if in.num.special || math.Abs(in.num.f) <= math.MaxFloat32 {
+		got32, err := cast.ToFloat32E(in.value)
+		if err != nil {
+			fail(ht, "ToFloat32E(%s) failed: %v", in.desc, err)
+		}
+		// Go's conversion rounds once from the exact value; going through
+		// float64 first would round twice, so integers use big.Float.
+		want32 := float32(in.num.f)
+		if !in.num.special && !in.num.frac {
+			want32, _ = new(big.Float).SetInt(in.num.big).Float32()
+		}
+		if !sameFloat(float64(got32), float64(want32)) {
+			fail(ht, "ToFloat32E(%s) = %v, want %v", in.desc, got32, want32)
+		}
+	} else if !Known.outOfRange {
+		// beyond float32: an error and a zero (cast/1)
+		if got32, err := cast.ToFloat32E(in.value); err == nil {
+			mismatch(ht, "cast/1", "ToFloat32E(%s) = %v with no error; the value is beyond float32", in.desc, got32)
+		}
+		if g := cast.ToFloat32(in.value); g != 0 {
+			mismatch(ht, "cast/1", "ToFloat32(%s) = %v; the plain variant must return 0 on failure", in.desc, g)
+		}
+	}
+
+	// bool: non-zero is true; a string is strconv.ParseBool's business
+	// (checked elsewhere), a json.Number a number (cast/6)
+	_, isJSON := in.value.(json.Number)
+	switch {
+	case in.text == "":
+		wantB := in.num.f != 0
+		gotB, err := cast.ToBoolE(in.value)
+		if err != nil || gotB != wantB {
+			fail(ht, "ToBoolE(%s) = %v, %v; want %v", in.desc, gotB, err, wantB)
+		}
+	case isJSON && !Known.jsonNumberBool:
+		wantB := want64 != 0
+		gotB, err := cast.ToBoolE(in.value)
+		if err != nil || gotB != wantB {
+			shape := textShape(in.text)
+			if shape == "" {
+				shape = "cast/6"
+			}
+			mismatch(ht, shape, "ToBoolE(%s) = %v, %v; want %v (the number is %v)", in.desc, gotB, err, wantB, want64)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Malformed text.
+
+// textShape names the recorded bug whose shape a text has: a bare dot with
+// or without a sign (cast/4), two or more leading plus signs (cast/10), an
+// underscore, a base prefix or a leading zero before a digit (cast/3, the
+// base-0 syntax of strconv); "" for none.
+func textShape(s string) string {
+	body := strings.TrimLeft(s, "+-")
+	switch {
+	case body == ".":
+		return "cast/4"
+	case strings.HasPrefix(s, "++"):
+		return "cast/10"
+	case strings.Contains(body, "_"), len(body) > 1 && body[0] == '0' && strings.ContainsRune("0123456789xXbBoO", rune(body[1])):
+		return "cast/3"
+	}
+	return ""
+}
+
+var (
+	// malformedWords: texts that are not a number, or a number only loosely.
+	malformedWords = []string{"abc", "1a", "a1", "--1", "1-", "1..0", "-", "+", "1.2.3", "0x", "1,000", "１２", "1 ", " 1", "\t1", "1\n", "১", "٣", "1.", "-1.", ".5", "-.5"}
+	// knownWords: the texts of the recorded bugs: a bare dot (cast/4), a
+	// doubled plus (cast/10), base prefixes and an underscore (cast/3);
+	// left out under HEGEL_NO_KNOWN=1.
+	knownWords = []string{".", "-.", "+.", "++5", "0x1f", "0b11", "0o17", "1_000"}
+	floatWords = []string{"inf", "Inf", "+Inf", "-inf", "infinity", "nan", "NaN", "0x1p-2", "0X1P4"}
+	unitWords  = []string{"ns", "ms", "s", "m", "h", "kg", "%", "px"}
+	// printableASCII: the bytes 32 to 126.
+	printableASCII = func() string {
+		var sb strings.Builder
+		for c := 32; c <= 126; c++ {
+			sb.WriteByte(byte(c))
+		}
+		return sb.String()
+	}()
+	// asciiTexts: one to six printable ASCII bytes that are not a plain
+	// integer (those belong to the value property); under HEGEL_NO_KNOWN=1
+	// none with a known shape either.
+	asciiTexts = hegel.Filter(hegel.Text().Alphabet(printableASCII).MinSize(1).MaxSize(6), func(s string) bool {
+		return !plainInteger(s) && (!noKnown || textShape(s) == "")
+	})
+	// malformedTexts: a word (1), an exponent (1), two numbers with a blank
+	// (1), a number with a unit (1), a float word (1), random ASCII (1).
+	malformedTexts = weighted(
+		choice[string]{1, hegel.SampledFrom(shaped(append(append([]string{}, malformedWords...), knownWords...), malformedWords))},
+		choice[string]{1, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%de%d", hegel.Draw(tc, hegel.Integers(-99, 99)), hegel.Draw(tc, hegel.Integers(0, 30)))
+		})},
+		choice[string]{1, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%d %d", hegel.Draw(tc, hegel.Integers(-99, 99)), hegel.Draw(tc, hegel.Integers(-99, 99)))
+		})},
+		choice[string]{1, hegel.Composite(func(tc hegel.TestCase) string {
+			return fmt.Sprintf("%d%s", hegel.Draw(tc, hegel.Integers(0, 999)), hegel.Draw(tc, hegel.SampledFrom(unitWords)))
+		})},
+		choice[string]{1, hegel.SampledFrom(floatWords)},
+		choice[string]{1, asciiTexts},
+	)
+	// decimalRe is cast's own grammar of a decimal text (trimDecimal).
+	decimalRe = regexp.MustCompile(`^[-+]?\d*\.\d*$`)
+)
+
+// plainInteger reports whether strconv reads the text as a decimal integer.
+func plainInteger(s string) bool {
+	_, err := strconv.ParseInt(s, 10, 64)
+	return err == nil
+}
+
+// Non-numeric text, and text that is a number only loosely (exponents,
+// blanks, units, hex floats, words), is refused by every integer
+// conversion with an error and a zero result; strconv's verdict on the
+// text as a float decides the float conversions. A decimal in cast's own
+// grammar ("1.", ".5") converts to its integer part, the documented
+// reading of "8.31". A bare dot is refused (cast/4), a doubled plus sign
+// (cast/10) and base prefixes, underscores and leading zeros (cast/3) too.
+func TestHegelMalformedTextIsRefused(t *testing.T) {
+	property(t, func(ht *hegel.T) { checkText(ht, hegel.Draw(ht, malformedTexts)) })
+}
+
+// checkText is the body of TestHegelMalformedTextIsRefused.
+func checkText(ht *hegel.T, s string) {
+	ht.Assume(!plainInteger(s)) // the pools hold none and asciiTexts filters them
+	shape := textShape(s)
+	if f, perr := strconv.ParseFloat(s, 64); perr == nil && decimalRe.MatchString(s) {
+		// a decimal: cast keeps the integer part, truncated toward zero
+		want := int64(math.Trunc(f))
+		for _, v := range []any{s, json.Number(s), myString(s)} {
+			if got, err := cast.ToInt64E(v); err != nil || got != want {
+				mismatch(ht, shape, "ToInt64E(%T %q) = %v, %v; the integer part is %d", v, s, got, err, want)
+			}
+			got, err := cast.ToUint64E(v)
+			switch {
+			case strings.HasPrefix(s, "-") && err == nil:
+				mismatch(ht, shape, "ToUint64E(%T %q) = %v with no error; a minus sign is refused by the unsigned parsers", v, s, got)
+			case !strings.HasPrefix(s, "-") && (err != nil || got != uint64(want)):
+				mismatch(ht, shape, "ToUint64E(%T %q) = %v, %v; the integer part is %d", v, s, got, err, want)
+			}
+			if gotF, err := cast.ToFloat64E(v); err != nil || !sameFloat(gotF, f) {
+				fail(ht, "ToFloat64E(%T %q) = %v, %v; strconv says %v", v, s, gotF, err, f)
+			}
+		}
+		return
+	}
+	for _, v := range []any{s, json.Number(s), myString(s)} {
+		if got, err := cast.ToInt64E(v); err == nil {
+			mismatch(ht, shape, "ToInt64E(%T %q) = %v with no error", v, s, got)
+		}
+		if got := cast.ToInt64(v); got != 0 {
+			mismatch(ht, shape, "ToInt64(%T %q) = %v, want 0", v, s, got)
+		}
+		if got, err := cast.ToUint64E(v); err == nil {
+			mismatch(ht, shape, "ToUint64E(%T %q) = %v with no error", v, s, got)
+		}
+		if got := cast.ToUint64(v); got != 0 {
+			mismatch(ht, shape, "ToUint64(%T %q) = %v, want 0", v, s, got)
+		}
+		wantF, perr := strconv.ParseFloat(s, 64)
+		gotF, err := cast.ToFloat64E(v)
+		if (perr == nil) != (err == nil) || (err == nil && !sameFloat(gotF, wantF)) {
+			fail(ht, "ToFloat64E(%T %q) = %v, %v; strconv says %v, %v", v, s, gotF, err, wantF, perr)
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Clocks and zones.
+
+// clock is a wall-clock reading, placed in a zone by in.
+type clock struct {
+	year, day, hour, min, sec, ns int
+	month                         time.Month
+}
+
+func (c clock) in(loc *time.Location) time.Time {
+	return time.Date(c.year, c.month, c.day, c.hour, c.min, c.sec, c.ns, loc)
+}
+
+var (
+	// years: a modern year half of the time, any year of 1 to 9999 otherwise.
+	years = weighted(choice[int]{50, hegel.Integers(1970, 2100)}, choice[int]{50, hegel.Integers(1, 9999)})
+	// nanos: none, whole milliseconds, or any.
+	nanos = weighted(
+		choice[int]{1, hegel.Just(0)},
+		choice[int]{1, hegel.Map(hegel.Integers(0, 999), func(ms int) int { return ms * 1000000 })},
+		choice[int]{1, hegel.Integers(0, 999999999)},
+	)
+	// clocks: a reading of the years with a day every month has.
+	clocks = hegel.Composite(func(tc hegel.TestCase) clock {
+		return clock{
+			year:  hegel.Draw(tc, years),
+			month: time.Month(hegel.Draw(tc, hegel.Integers(1, 12))),
+			day:   hegel.Draw(tc, hegel.Integers(1, 28)),
+			hour:  hegel.Draw(tc, hegel.Integers(0, 23)),
+			min:   hegel.Draw(tc, hegel.Integers(0, 59)),
+			sec:   hegel.Draw(tc, hegel.Integers(0, 59)),
+			ns:    hegel.Draw(tc, nanos),
+		}
+	})
+	// zoneNames are the shapes Go's time.Parse reads back as a zone name
+	// (three upper-case letters, or four or five ending in T).
+	zoneNames = []string{"XYZ", "AEST", "ABCDT", "EST", "PST", "CET"}
+	// zones: UTC (40%) or a named fixed zone of up to 14 hours either way. A
+	// nameless zone prints its numeric offset in the name slot, which
+	// time.Parse only accepts up to "+23" — Go's limit, not cast's — so
+	// those are left out.
+	zones = weighted(choice[*time.Location]{40, hegel.Just(time.UTC)}, choice[*time.Location]{60, fixedZones(hegel.Integers(-14*60, 14*60))})
+	// wideOffsetZones: named fixed zones 24 minutes or more from UTC (the
+	// region past cast/5, for RubyDate under HEGEL_NO_KNOWN=1).
+	wideOffsetZones = fixedZones(hegel.OneOf(hegel.Integers(24, 14*60), hegel.Integers(-14*60, -24)))
+)
+
+// fixedZones: a named zone at an offset (in minutes) of offsets.
+func fixedZones(offsets hegel.Generator[int]) hegel.Generator[*time.Location] {
+	return hegel.Composite(func(tc hegel.TestCase) *time.Location {
+		return time.FixedZone(hegel.Draw(tc, hegel.SampledFrom(zoneNames)), hegel.Draw(tc, offsets)*60)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// ToString round trips.
+
+// roundTrip is one value that goes through ToString and back.
+type roundTrip interface{ check(ht *hegel.T) }
+
+func asRoundTrip[T roundTrip](g hegel.Generator[T]) hegel.Generator[roundTrip] {
+	return hegel.Map(g, func(x T) roundTrip { return x })
+}
+
+type rtInt struct{ v int64 }
+type rtUint struct{ u uint64 }
+type rtFloat struct{ f float64 }
+type rtFloat32 struct{ f float32 }
+type rtBool struct{ b bool }
+type rtDuration struct{ d time.Duration }
+type rtTime struct{ tm time.Time }
+
+func (c rtTime) GoString() string { return fmt.Sprintf("time %v", c.tm) }
+
+var (
+	denominators = []int64{1, 2, 4, 8, 10, 100, 1000}
+	// rtFloats: a small fraction (30%) or any float64.
+	rtFloats = weighted(
+		choice[float64]{30, hegel.Composite(func(tc hegel.TestCase) float64 {
+			return float64(hegel.Draw(tc, hegel.Integers[int64](-1000000, 1000000))) / float64(hegel.Draw(tc, hegel.SampledFrom(denominators)))
+		})},
+		choice[float64]{70, float64Bits},
+	)
+	durationUnits = []time.Duration{time.Nanosecond, time.Microsecond, time.Millisecond, time.Second, time.Minute, time.Hour}
+	// durations: a small count of a unit (50%) or any duration.
+	durations = weighted(
+		choice[time.Duration]{50, hegel.Composite(func(tc hegel.TestCase) time.Duration {
+			return time.Duration(hegel.Draw(tc, hegel.Integers[int64](-1000000, 1000000))) * hegel.Draw(tc, hegel.SampledFrom(durationUnits))
+		})},
+		choice[time.Duration]{50, hegel.Map(hegel.Integers[int64](math.MinInt64, math.MaxInt64), func(v int64) time.Duration { return time.Duration(v) })},
+	)
+	// times: a clock in a zone.
+	times = hegel.Composite(func(tc hegel.TestCase) time.Time {
+		return hegel.Draw(tc, clocks).in(hegel.Draw(tc, zones))
+	})
+	// roundTrips: one of the seven value kinds.
+	roundTrips = hegel.OneOf(
+		asRoundTrip(hegel.Map(intValues, func(v int64) rtInt { return rtInt{v} })),
+		asRoundTrip(hegel.Map(intValues, func(v int64) rtUint { return rtUint{uint64(v)} })),
+		asRoundTrip(hegel.Map(rtFloats, func(f float64) rtFloat { return rtFloat{f} })),
+		asRoundTrip(hegel.Map(hegel.Integers[uint32](0, math.MaxUint32), func(b uint32) rtFloat32 { return rtFloat32{math.Float32frombits(b)} })),
+		asRoundTrip(hegel.Map(hegel.Booleans(), func(b bool) rtBool { return rtBool{b} })),
+		asRoundTrip(hegel.Map(durations, func(d time.Duration) rtDuration { return rtDuration{d} })),
+		asRoundTrip(hegel.Map(times, func(tm time.Time) rtTime { return rtTime{tm} })),
+	)
+)
+
+func (c rtInt) check(ht *hegel.T) {
+	v := c.v
+	s := cast.ToString(v)
+	if s != strconv.FormatInt(v, 10) {
+		fail(ht, "ToString(int64 %d) = %q", v, s)
+	}
+	if got, err := cast.ToInt64E(s); err != nil || got != v {
+		fail(ht, "ToInt64E(ToString(%d) = %q) = %v, %v", v, s, got, err)
+	}
+	for _, x := range []any{int8(v), int16(v), int32(v), int(v)} {
+		if got := cast.ToString(x); got != fmt.Sprint(x) {
+			fail(ht, "ToString(%T %v) = %q", x, x, got)
+		}
+	}
+}
+
+func (c rtUint) check(ht *hegel.T) {
+	u := c.u
+	s := cast.ToString(u)
+	if got, err := cast.ToUint64E(s); err != nil || got != u {
+		fail(ht, "ToUint64E(ToString(%d) = %q) = %v, %v", u, s, got, err)
+	}
+	for _, x := range []any{uint8(u), uint16(u), uint32(u), uint(u)} {
+		if got := cast.ToString(x); got != fmt.Sprint(x) {
+			fail(ht, "ToString(%T %v) = %q", x, x, got)
+		}
+	}
+}
+
+func (c rtFloat) check(ht *hegel.T) {
+	f := c.f
+	s := cast.ToString(f)
+	got, err := cast.ToFloat64E(s)
+	if math.IsNaN(f) || math.IsInf(f, 0) {
+		if err != nil || !sameFloat(got, f) {
+			fail(ht, "ToFloat64E(ToString(%v) = %q) = %v, %v", f, s, got, err)
+		}
+		return
+	}
+	if err != nil || got != f {
+		fail(ht, "ToFloat64E(ToString(%v) = %q) = %v, %v", f, s, got, err)
+	}
+	if strings.ContainsAny(s, "eE") {
+		fail(ht, "ToString(%v) = %q uses an exponent", f, s)
+	}
+}
+
+func (c rtFloat32) check(ht *hegel.T) {
+	f := c.f
+	s := cast.ToString(f)
+	got, err := cast.ToFloat32E(s)
+	if err != nil || !sameFloat(float64(got), float64(f)) {
+		fail(ht, "ToFloat32E(ToString(float32 %v) = %q) = %v, %v", f, s, got, err)
+	}
+}
+
+func (c rtBool) check(ht *hegel.T) {
+	b := c.b
+	s := cast.ToString(b)
+	if got, err := cast.ToBoolE(s); err != nil || got != b {
+		fail(ht, "ToBoolE(ToString(%v) = %q) = %v, %v", b, s, got, err)
+	}
+	if got, err := cast.ToBoolE(myBool(b)); err != nil || got != b {
+		fail(ht, "ToBoolE(myBool(%v)) = %v, %v", b, got, err)
+	}
+	for _, x := range []any{int8(1), uint(7), 0.5, myInt(3), time.Duration(2), time.Month(1)} {
+		if got, err := cast.ToBoolE(x); err != nil || !got {
+			fail(ht, "ToBoolE(%T %v) = %v, %v; non-zero is true", x, x, got, err)
+		}
+	}
+}
+
+func (c rtDuration) check(ht *hegel.T) {
+	d := c.d
+	s := cast.ToString(d)
+	if s != d.String() {
+		fail(ht, "ToString(%v) = %q", d, s)
+	}
+	if got, err := cast.ToDurationE(s); err != nil || got != d {
+		fail(ht, "ToDurationE(ToString(%v) = %q) = %v, %v", d, s, got, err)
+	}
+	if got, err := cast.ToDurationE(int64(d)); err != nil || got != d {
+		fail(ht, "ToDurationE(int64 %d) = %v, %v", int64(d), got, err)
+	}
+	if got, err := cast.ToDurationE(strconv.FormatInt(int64(d), 10)); err != nil || got != d {
+		fail(ht, "ToDurationE(%q) = %v, %v; a bare number is nanoseconds", strconv.FormatInt(int64(d), 10), got, err)
+	}
+	if got, err := cast.ToE[time.Duration](s); err != nil || got != d {
+		fail(ht, "ToE[time.Duration](%q) = %v, %v", s, got, err)
+	}
+}
+
+func (c rtTime) check(ht *hegel.T) {
+	tm := c.tm
+	s := cast.ToString(tm)
+	if s != tm.String() {
+		fail(ht, "ToString(%v) = %q", tm, s)
+	}
+	got, err := cast.ToTimeE(s)
+	if err != nil {
+		fail(ht, "ToTimeE(ToString(%v) = %q) failed: %v", tm, s, err)
+	}
+	if !got.Equal(tm) {
+		fail(ht, "ToTimeE(%q) = %v, not the same instant as %v", s, got, tm)
+	}
+	_, o1 := got.Zone()
+	_, o2 := tm.Zone()
+	if o1 != o2 {
+		fail(ht, "ToTimeE(%q) = %v has offset %d, the original %d", s, got, o1, o2)
+	}
+}
+
+// ToString of every basic value is read back by the matching conversion:
+// integers and unsigned integers of every width, floats (the shortest
+// representation strconv produces), bools, durations (through
+// Duration.String), and times (through Time.String, which cast lists among
+// its formats), in UTC and fixed zones with and without a name.
+func TestHegelToStringRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		hegel.Draw(ht, roundTrips).check(ht)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Times.
+
+// truncateFor drops the parts of t a layout does not carry.
+func truncateFor(layout string, t time.Time) time.Time {
+	switch {
+	case strings.Contains(layout, ".999999999") || strings.Contains(layout, ".000000000"):
+		return t
+	case strings.Contains(layout, ".000000"):
+		return t.Truncate(time.Microsecond)
+	case strings.Contains(layout, ".000"):
+		return t.Truncate(time.Millisecond)
+	case strings.Contains(layout, "05"):
+		return t.Truncate(time.Second)
+	case strings.Contains(layout, "04"):
+		return t.Truncate(time.Minute)
+	default:
+		return time.Date(t.Year(), t.Month(), t.Day(), 0, 0, 0, 0, t.Location())
+	}
+}
+
+// layoutCase: one of cast's layouts, the default location, the zone the
+// time is formatted in, its clock, and whether fractional seconds are
+// appended to a seconds field the layout has without them.
+type layoutCase struct {
+	f     internal.TimeFormat
+	loc   *time.Location
+	zone  *time.Location
+	clock clock
+	frac  bool
+}
+
+// withFrac reports whether the case appends fractional seconds.
+func (c layoutCase) withFrac() bool {
+	return c.frac && !strings.Contains(c.f.Format, ".") && strings.Contains(c.f.Format, "05")
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c layoutCase) GoString() string {
+	return fmt.Sprintf("layout %q (%v), default location %v, time %v, fraction %v", c.f.Format, c.f.Typ, c.loc, c.clock.in(c.zone), c.withFrac())
+}
+
+// zonesFor: the zones a layout's time is formatted in: UTC for the layouts
+// with a zone name only (the one name that reads back as itself; the rest
+// is design, see the README), any zone otherwise; under HEGEL_NO_KNOWN=1 a
+// RubyDate time keeps 24 minutes or more from UTC (cast/5).
+func zonesFor(f internal.TimeFormat) hegel.Generator[*time.Location] {
+	switch {
+	case f.Typ == internal.TimeFormatNamedTimezone:
+		return hegel.Just(time.UTC)
+	case f.Format == time.RubyDate && Known.rubyDateOffsets:
+		return wideOffsetZones
+	}
+	return zones
+}
+
+// layoutCases: a layout and, for it, a default location, a zone, a clock
+// and the fraction flag (30%).
+var layoutCases = hegel.FlatMap(hegel.SampledFrom(internal.TimeFormats), func(f internal.TimeFormat) hegel.Generator[layoutCase] {
+	zone := zonesFor(f)
+	return hegel.Composite(func(tc hegel.TestCase) layoutCase {
+		return layoutCase{
+			f:     f,
+			loc:   hegel.Draw(tc, zones),
+			zone:  hegel.Draw(tc, zone),
+			clock: hegel.Draw(tc, clocks),
+			frac:  hegel.Draw(tc, chance(30)),
+		}
+	})
+})
+
+// A time formatted with any of cast's own layouts is parsed back by
+// ToTimeInDefaultLocationE with the documented meaning: layouts with a
+// numeric offset give the same instant and offset (a RubyDate text with an
+// offset under 24 minutes too: cast/5); layouts with no timezone (and, by
+// design, those with a zone name only) give the wall clock in the default
+// location; time-only layouts give the clock on January 1 of year 0 (Stamp
+// layouts keep the month and day) in UTC. Fractional seconds appended to a
+// layout without them are accepted, as time.Parse does.
+func TestHegelOwnLayoutsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) { checkLayout(ht, hegel.Draw(ht, layoutCases)) })
+}
+
+// checkLayout is the body of TestHegelOwnLayoutsRoundTrip.
+func checkLayout(ht *hegel.T, c layoutCase) {
+	f, loc := c.f, c.loc
+	tm := c.clock.in(c.zone)
+	s := tm.Format(f.Format)
+	if c.withFrac() {
+		// fractional seconds are accepted after a seconds field
+		s = tm.Format(strings.Replace(f.Format, "05", "05.000", 1))
+		tm = tm.Truncate(time.Millisecond)
+	} else {
+		tm = truncateFor(f.Format, tm)
+	}
+	if strings.Contains(f.Format, "06") && !strings.Contains(f.Format, "2006") {
+		// two-digit years: Go reads 69-99 as 19xx and 00-68 as 20xx
+		yy := tm.Year() % 100
+		year := 2000 + yy
+		if yy >= 69 {
+			year = 1900 + yy
+		}
+		tm = time.Date(year, tm.Month(), tm.Day(), tm.Hour(), tm.Minute(), tm.Second(), tm.Nanosecond(), tm.Location())
+	}
+	// the shape of cast/5: UnixDate precedes RubyDate in the list and Go's
+	// MST slot accepts "+0000".."+0023" as a zone name, so a RubyDate text
+	// with such an offset is re-read in the default location
+	shape := ""
+	if _, off := tm.Zone(); f.Format == time.RubyDate && off > -24*60 && off < 24*60 {
+		shape = "cast/5"
+	}
+	note(ht, "text %q", s)
+	got, err := cast.ToTimeInDefaultLocationE(s, loc)
+	if err != nil {
+		fail(ht, "ToTimeInDefaultLocationE(%q, %v) failed: %v (layout %q)", s, loc, err, f.Format)
+	}
+	var want time.Time
+	switch f.Typ {
+	case internal.TimeFormatNumericTimezone, internal.TimeFormatNumericAndNamedTimezone:
+		want = tm
+		_, o1 := got.Zone()
+		_, o2 := tm.Zone()
+		if o1 != o2 {
+			mismatch(ht, shape, "ToTimeInDefaultLocationE(%q, %v) = %v: offset %d, want %d (layout %q)", s, loc, got, o1, o2, f.Format)
+		}
+	case internal.TimeFormatNoTimezone, internal.TimeFormatNamedTimezone:
+		want = time.Date(tm.Year(), tm.Month(), tm.Day(), tm.Hour(), tm.Minute(), tm.Second(), tm.Nanosecond(), loc)
+		if got.Location() != loc {
+			fail(ht, "ToTimeInDefaultLocationE(%q, %v) = %v is not in the default location (layout %q)", s, loc, got, f.Format)
+		}
+	default: // time only
+		day := 1
+		month := time.January
+		if strings.Contains(f.Format, "Jan") {
+			day, month = tm.Day(), tm.Month()
+		}
+		want = time.Date(0, month, day, tm.Hour(), tm.Minute(), tm.Second(), tm.Nanosecond(), time.UTC)
+	}
+	if !got.Equal(want) {
+		mismatch(ht, shape, "ToTimeInDefaultLocationE(%q, %v) = %v, want %v (layout %q)", s, loc, got, want, f.Format)
+	}
+	// ToTimeE is the UTC case
+	if loc == time.UTC {
+		if g, err := cast.ToTimeE(s); err != nil || !g.Equal(got) {
+			fail(ht, "ToTimeE(%q) = %v, %v; ToTimeInDefaultLocationE(_, UTC) = %v", s, g, err, got)
+		}
+		if g, err := cast.ToE[time.Time](s); err != nil || !g.Equal(got) {
+			fail(ht, "ToE[time.Time](%q) = %v, %v; want %v", s, g, err, got)
+		}
+		if g, err := cast.StringToDate(s); err != nil || !g.Equal(got) {
+			fail(ht, "StringToDate(%q) = %v, %v; want %v", s, g, err, got)
+		}
+	}
+}
+
+// unixCase: a Unix second and the Go kind it is handed in.
+type unixCase struct {
+	v    int64
+	kind string
+}
+
+// unixKindsAccepted are the kinds ToTimeE lists; unixKindsRejected the ones
+// it does not, although every other conversion accepts them (cast/9).
+var (
+	unixKindsAccepted = []string{"int64", "int", "json", "json.0", "json.00", "uint64", "int32", "uint32"}
+	unixKindsRejected = []string{"int8", "int16", "uint8", "uint16", "myInt", "myInt64", "float64"}
+)
+
+// input is v in the kind.
+func (c unixCase) input() any {
+	v := c.v
+	switch c.kind {
+	case "int":
+		return int(v)
+	case "json":
+		return json.Number(strconv.FormatInt(v, 10))
+	case "json.0":
+		return json.Number(strconv.FormatInt(v, 10) + ".0")
+	case "json.00":
+		return json.Number(strconv.FormatInt(v, 10) + ".00")
+	case "uint64":
+		return uint64(v)
+	case "int32":
+		return int32(v)
+	case "uint32":
+		return uint32(v)
+	case "int8":
+		return int8(v)
+	case "int16":
+		return int16(v)
+	case "uint8":
+		return uint8(v)
+	case "uint16":
+		return uint16(v)
+	case "myInt":
+		return myInt(v)
+	case "myInt64":
+		return myInt64(v)
+	case "float64":
+		return float64(v)
+	}
+	return v
+}
+
+// shape names cast/9 for the rejected kinds.
+func (c unixCase) shape() string {
+	for _, k := range unixKindsRejected {
+		if k == c.kind {
+			return "cast/9"
+		}
+	}
+	return ""
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c unixCase) GoString() string {
+	in := c.input()
+	return fmt.Sprintf("%T(%v)", in, in)
+}
+
+// unixKindsFor lists the kinds that hold v: the accepted ones first, then
+// (unless HEGEL_NO_KNOWN=1) the rejected ones.
+func unixKindsFor(v int64) []string {
+	kinds := []string{"int64", "int", "json", "json.0", "json.00"}
+	if v >= 0 {
+		kinds = append(kinds, "uint64")
+	}
+	if v >= math.MinInt32 && v <= math.MaxInt32 {
+		kinds = append(kinds, "int32")
+	}
+	if v >= 0 && v <= math.MaxUint32 {
+		kinds = append(kinds, "uint32")
+	}
+	if Known.timeIntegerKind {
+		return kinds
+	}
+	if v >= math.MinInt8 && v <= math.MaxInt8 {
+		kinds = append(kinds, "int8")
+	}
+	if v >= math.MinInt16 && v <= math.MaxInt16 {
+		kinds = append(kinds, "int16")
+	}
+	if v >= 0 && v <= math.MaxUint8 {
+		kinds = append(kinds, "uint8")
+	}
+	if v >= 0 && v <= math.MaxUint16 {
+		kinds = append(kinds, "uint16")
+	}
+	return append(kinds, "myInt", "myInt64", "float64")
+}
+
+var (
+	// unixSeconds: a second within 2^31 of the epoch (30%) or within 2^40.
+	unixSeconds = weighted(choice[int64]{30, hegel.Integers[int64](0, 1<<31)}, choice[int64]{70, hegel.Integers[int64](-1<<40, 1<<40)})
+	// unixCases: a second in one of the kinds that hold it.
+	unixCases = hegel.FlatMap(unixSeconds, func(v int64) hegel.Generator[unixCase] {
+		return hegel.Map(hegel.SampledFrom(unixKindsFor(v)), func(kind string) unixCase { return unixCase{v, kind} })
+	})
+)
+
+// Integer inputs to ToTimeE are Unix seconds, for every integer kind
+// cast's number conversions accept (json.Number with a ".0" tail too, and
+// the narrow, named and float kinds: cast/9); a time.Time comes back as
+// itself; nil is the zero time.
+func TestHegelIntegersAreUnixSeconds(t *testing.T) {
+	property(t, func(ht *hegel.T) { checkUnix(ht, hegel.Draw(ht, unixCases)) })
+}
+
+// checkUnix is the body of TestHegelIntegersAreUnixSeconds.
+func checkUnix(ht *hegel.T, c unixCase) {
+	in := c.input()
+	want := time.Unix(c.v, 0)
+	got, err := cast.ToTimeE(in)
+	if err != nil || !got.Equal(want) {
+		mismatch(ht, c.shape(), "ToTimeE(%T %v) = %v, %v; want %v", in, in, got, err, want)
+	}
+	if got := cast.ToTime(want); !got.Equal(want) {
+		fail(ht, "ToTime(time.Time) changed the value")
+	}
+	if got, err := cast.ToTimeE(nil); err != nil || !got.IsZero() {
+		fail(ht, "ToTimeE(nil) = %v, %v", got, err)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Slices and maps.
+
+// scalar is a small integer handed over in one of the convertible kinds: an
+// int, an int64, the narrowest width that holds it, a decimal string, a
+// float64, a json.Number, a named int; kind 7 is a string of two numbers
+// with a blank between them (whole to ToString, split by ToStringSlice).
+type scalar struct {
+	v    int64
+	kind int
+}
+
+func (s scalar) value() any {
+	v := s.v
+	switch s.kind {
+	case 0:
+		return int(v)
+	case 2:
+		switch {
+		case v >= 0:
+			return uint8(v)
+		case v >= math.MinInt8:
+			return int8(v)
+		}
+		return int16(v)
+	case 3:
+		return strconv.FormatInt(v, 10)
+	case 4:
+		return float64(v)
+	case 5:
+		return json.Number(strconv.FormatInt(v, 10))
+	case 6:
+		return myInt(v)
+	case 7:
+		return fmt.Sprintf("%d %d", v, -v)
+	}
+	return v
+}
+
+// isText reports whether the value is a string or a json.Number (whose
+// bool reading is strconv.ParseBool's business).
+func (s scalar) isText() bool { return s.kind == 3 || s.kind == 5 || s.kind == 7 }
+
+// GoString is what the draw report prints (it uses %#v).
+func (s scalar) GoString() string {
+	x := s.value()
+	return fmt.Sprintf("%T(%v)", x, x)
+}
+
+var (
+	smallInts = hegel.Integers[int64](-200, 200)
+	// scalars: a small integer in one of the seven convertible kinds.
+	scalars = hegel.Composite(func(tc hegel.TestCase) scalar {
+		return scalar{v: hegel.Draw(tc, smallInts), kind: hegel.Draw(tc, hegel.Integers(0, 6))}
+	})
+	// spacedScalars: two numbers with a blank between them.
+	spacedScalars = hegel.Map(smallInts, func(v int64) scalar { return scalar{v: v, kind: 7} })
+	// badValues: values no integer conversion accepts.
+	badValues = []any{"x", struct{}{}, []int{1}, "1.5.2"}
+	// badSpots: a position (modulo the live size) and the value put there.
+	badSpots = hegel.Composite(func(tc hegel.TestCase) badSpot {
+		return badSpot{at: hegel.Draw(tc, positions), val: hegel.Draw(tc, hegel.SampledFrom(badValues))}
+	})
+	separators = []string{" ", "  ", "\t", "\n", " \t "}
+)
+
+// badSpot is an unconvertible value at a position of a slice or map.
+type badSpot struct {
+	at  int
+	val any
+}
+
+// sliceCase: up to five scalars, an unconvertible spot in one of them
+// (25%), the Go container they arrive in, and a line of words for the
+// string split check.
+type sliceCase struct {
+	items  []scalar
+	bad    *badSpot
+	shape  string // "[]any", "typed" (a []T when every item has one type and none is bad), "array"
+	words  []int64
+	sep    string
+	padded bool
+}
+
+var anyType = reflect.TypeOf((*any)(nil)).Elem()
+
+// build is the input, its items, their values and whether one is bad.
+func (c sliceCase) build() (in any, items []any, vals []int64, bad bool) {
+	for _, s := range c.items {
+		items = append(items, s.value())
+		vals = append(vals, s.v)
+	}
+	bad = c.bad != nil && len(items) > 0
+	if bad {
+		items[c.bad.at%len(items)] = c.bad.val
+	}
+	in = items
+	switch c.shape {
+	case "typed":
+		same := len(items) > 0 && !bad
+		for _, x := range items {
+			same = same && reflect.TypeOf(x) == reflect.TypeOf(items[0])
+		}
+		if same {
+			sl := reflect.MakeSlice(reflect.SliceOf(reflect.TypeOf(items[0])), 0, len(items))
+			for _, x := range items {
+				sl = reflect.Append(sl, reflect.ValueOf(x))
+			}
+			in = sl.Interface()
+		}
+	case "array":
+		arr := reflect.New(reflect.ArrayOf(len(items), anyType)).Elem()
+		for i, x := range items {
+			arr.Index(i).Set(reflect.ValueOf(&x).Elem())
+		}
+		in = arr.Interface()
+	}
+	return
+}
+
+// line is the words joined by the separator, padded with a blank on each
+// side when padded.
+func (c sliceCase) line() (line string, words []string) {
+	for _, w := range c.words {
+		words = append(words, strconv.FormatInt(w, 10))
+	}
+	line = strings.Join(words, c.sep)
+	if c.padded {
+		line = " " + line + " "
+	}
+	return
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c sliceCase) GoString() string {
+	in, _, _, bad := c.build()
+	line, _ := c.line()
+	return fmt.Sprintf("%T %v (bad=%v), line %q", in, in, bad, line)
+}
+
+var sliceCases = hegel.Composite(func(tc hegel.TestCase) sliceCase {
+	return sliceCase{
+		items:  hegel.Draw(tc, hegel.Lists(scalars).MaxSize(5)),
+		bad:    hegel.Draw(tc, optional(25, badSpots)),
+		shape:  hegel.Draw(tc, hegel.SampledFrom([]string{"[]any", "[]any", "typed", "array"})),
+		words:  hegel.Draw(tc, hegel.Lists(hegel.Integers[int64](-99, 99)).MaxSize(4)),
+		sep:    hegel.Draw(tc, hegel.SampledFrom(separators)),
+		padded: hegel.Draw(tc, chance(30)),
+	}
+})
