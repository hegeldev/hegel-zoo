+// ---------------------------------------------------------------------------
+// The shapes of the recorded bugs: one property per bug over its shape
+// region alone, judged as the wide property that found it judges, so that
+// each bug has a property that finds it every run (the wide properties
+// reach the shapes at their natural rate and stop at the first bug they
+// meet). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug
+// does not touch instead, and passes.
+
+// beyondInt8: an integer beyond int8, which the narrower conversions wrap
+// (cast/1, cast/2); under HEGEL_NO_KNOWN=1 one within it.
+var beyondInt8 = shaped[hegel.Generator[int64]](
+	hegel.OneOf(hegel.Integers[int64](math.MaxInt8+1, math.MaxInt64), hegel.Integers[int64](math.MinInt64, math.MinInt8-1)),
+	hegel.Integers[int64](math.MinInt8, math.MaxInt8),
+)
+
+// asJSON: a text is a json.Number or a string.
+var asJSON = hegel.Booleans()
+
+// TestHegelNumbersBeyondTheTargetAreErrors: a Go number beyond the target's
+// range is an error and a zero from every conversion; cast converts it with
+// a plain Go conversion and wraps it (cast/1).
+func TestHegelNumbersBeyondTheTargetAreErrors(t *testing.T) {
+	wideInts := hegel.FlatMap(beyondInt8, func(v int64) hegel.Generator[input] {
+		return hegel.Map(hegel.SampledFrom(intKindsFor(v)), func(kind string) input {
+			x := typedInt(kind, v)
+			return input{value: x, num: fromInt64(v), desc: fmt.Sprintf("%T(%v)", x, x)}
+		})
+	})
+	property(t, func(ht *hegel.T) { checkNumber(ht, hegel.Draw(ht, wideInts)) })
+}
+
+// TestHegelTextsBeyondTheTargetAreErrors: a decimal text beyond the target's
+// range is an error and a zero; cast parses it at 64 bits and truncates it
+// to the target (cast/2).
+func TestHegelTextsBeyondTheTargetAreErrors(t *testing.T) {
+	wideTexts := hegel.FlatMap(beyondInt8, func(v int64) hegel.Generator[input] {
+		return hegel.Map(asJSON, func(j bool) input { return textInput(j, strconv.FormatInt(v, 10), fromInt64(v)) })
+	})
+	property(t, func(ht *hegel.T) { checkNumber(ht, hegel.Draw(ht, wideTexts)) })
+}
+
+// zeroPaddedTexts: a text of an integer of 8 or more in magnitude (whose
+// octal reading differs or does not exist) with one to three leading zeros,
+// a sign and a tail at the usual rates (cast/3); under HEGEL_NO_KNOWN=1
+// without the zeros.
+var zeroPaddedTexts = hegel.Composite(func(tc hegel.TestCase) input {
+	v := hegel.Draw(tc, hegel.OneOf(hegel.Integers[int64](8, 1000), hegel.Integers[int64](-1000, -8)))
+	st := decimalStyle{
+		plus:  hegel.Draw(tc, chance(20)),
+		zeros: hegel.Draw(tc, shaped[hegel.Generator[int]](hegel.Integers(1, 3), hegel.Just(0))),
+		tail:  hegel.Draw(tc, optional(20, hegel.Integers(0, 3))),
+	}
+	return textInput(hegel.Draw(tc, asJSON), st.render(big.NewInt(v)), fromInt64(v))
+})
