+// jsondiff/8: the inverse of an append addresses the element by its index,
+// not by the "-" of the add.
+func TestHegelInvertOfAnAppend(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		xs := numbers(ht, 0, 3)
+		ys := append(append([]any(nil), xs...), numbers(ht, 1, 2)...)
+		va, vb := inMember(ht, xs, ys)
+		// LCS addresses the added elements by index: past the region.
+		o := optSet{invertible: true, lcs: shaped(false, true)}
+		invertsBack(ht, mustJSON(va), mustJSON(vb), o, region("jsondiff/8"))
+	})
+}
