+// valueOfKind draws a JSON value of the kind named.
+func valueOfKind(ht *hegel.T, kind string) any {
+	switch kind {
+	case "bool":
+		return chance(ht, 50)
+	case "number":
+		return float64(n(ht, -5, 20))
+	case "string":
+		return pick(ht, "", "x", "hello", "a/b")
+	case "array":
+		return []any{genScalar(ht)}
+	case "object":
+		return map[string]any{pick(ht, plainKeys...): genScalar(ht)}
+	}
+	return nil
+}
+
+// invertsBack checks that the invertible patch for (a, b) under o inverts,
+// and that the inverse applied to b gives a (model applier).
+func invertsBack(ht *hegel.T, a, b []byte, o optSet, shapes []string) {
+	note(ht, "a = %s", a)
+	note(ht, "b = %s", b)
+	note(ht, "opts = %s", o)
+	patch := compare(ht, a, b, o)
+	pb := mustJSON(patch)
+	note(ht, "patch = %s", pb)
+	inv, err := patch.Invert()
+	if err != nil {
+		mismatch(ht, shapes, "Invert: %v\n  patch %s", err, pb)
+	}
+	ib := mustJSON(inv)
+	note(ht, "inverse = %s", ib)
+	got, err := applyModel(b, ib)
+	if err != nil {
+		mismatch(ht, shapes, "the inverse does not apply to b: %v\n  inverse %s", err, ib)
+	}
+	if !sameJSON(got, a, false) {
+		mismatch(ht, shapes, "the inverse applied to b gives %s, want a = %s\n  inverse %s", got, a, ib)
+	}
+}
