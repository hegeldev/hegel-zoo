+// escapedKeys are object keys written with escapes in JSON text (findKey in
+// json.go looks them up as decoded): the region of jsondiff/5.
+var escapedKeys = []string{"\\", "a\\b", "\\\\", "\"", "\"q\"", "a\"b", "\n", "a\nb", "\t"}
+
+// jsondiff/5: Rationalize handles a member whose key needs escaping like any
+// other: no panic, and no larger patch than without it.
+func TestHegelRationalizeHandlesEscapedKeys(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		key := pick(ht, shaped(escapedKeys, plainKeys)...)
+		keys := someKeys(ht, n(ht, 2, 4))
+		inner := map[string]any{}
+		for _, k := range keys {
+			inner[k] = float64(n(ht, 0, 99))
+		}
+		obj := map[string]any{key: inner}
+		a := mustJSON(obj)
+		inner[pick(ht, keys...)] = float64(n(ht, 100, 199))
+		b := mustJSON(obj)
+		o := optSet{rationalize: true}
+		patchGives(ht, a, b, o, region("jsondiff/5"))
+		pb := mustJSON(compare(ht, a, b, o))
+		plainB := mustJSON(compare(ht, a, b, optSet{}))
+		if len(pb) > len(plainB) {
+			mismatch(ht, region("jsondiff/5"), "Rationalize gives %s (%d bytes), larger than the plain patch %s (%d bytes)", pb, len(pb), plainB, len(plainB))
+		}
+	})
+}
+
+// jsondiff/6: under Invertible, Rationalize counts the test it adds before a
+// replace.
+func TestHegelRationalizeCountsTheTestOperation(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// The array loses its last element: the plain invertible patch is a
+		// test and a remove, which Rationalize weighs against a replace of
+		// the array without the test it will put in front. Short filler
+		// makes the replace win, and the test it then adds carries the whole
+		// array (the region); filler of thirty bytes or more keeps the two
+		// operations (past it).
+		var filler []any
+		if noKnown {
+			for i, k := 0, n(ht, 3, 4); i < k; i++ {
+				filler = append(filler, pick(ht, longWords...))
+			}
+		} else {
+			filler = append(filler, numbers(ht, 0, 2)...)
+		}
+		keys := someKeys(ht, 1+n(ht, 0, 2))
+		obj := map[string]any{keys[0]: append(append([]any(nil), filler...), genScalar(ht))}
+		for _, k := range keys[1:] {
+			obj[k] = float64(n(ht, 0, 9))
+		}
+		a := mustJSON(obj)
+		obj[keys[0]] = filler
+		b := mustJSON(obj)
+		o := optSet{rationalize: true, invertible: true}
+		patchGives(ht, a, b, o, region("jsondiff/6"))
+		pb := mustJSON(compare(ht, a, b, o))
+		plainB := mustJSON(compare(ht, a, b, optSet{invertible: true}))
+		if len(pb) > len(plainB) {
+			mismatch(ht, region("jsondiff/6"), "Rationalize+Invertible gives %s (%d bytes), larger than the plain invertible patch %s (%d bytes)", pb, len(pb), plainB, len(plainB))
+		}
+	})
+}
