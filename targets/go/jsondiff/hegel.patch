+// jsondiff/12: Rationalize keeps the smaller patch under Factorize, with LCS
+// and, since 2026-10-06, for an add without it.
+func TestHegelRationalizeKeepsTheSmallerFactorizedPatch(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var a, b []byte
+		var o optSet
+		if chance(ht, 50) {
+			// A value added at the front of an array under LCS, beside a
+			// member removed from a long object in it: the two operations are
+			// smaller than a replace of the array, yet with Factorize the add
+			// is weighed as the whole array's text (the region); without
+			// Factorize the weights are right (past it).
+			keys := someKeys(ht, n(ht, 3, 5))
+			obj := map[string]any{}
+			for _, k := range keys {
+				obj[k] = pick(ht, longWords...)
+			}
+			x, y := float64(n(ht, 0, 9)), float64(n(ht, 10, 19))
+			a = mustJSON([]any{x, clone(obj)})
+			delete(obj, pick(ht, keys...))
+			b = mustJSON([]any{y, x, obj})
+			o = optSet{rationalize: true, lcs: true, factorize: shaped(true, false)}
+		} else if chance(ht, 50) {
+			// The same weighing without LCS: an element replaced beside an
+			// append, in an array whose text is longer than the two
+			// operations.
+			w := pick(ht, longWords...) + strings.Repeat("!", n(ht, 25, 40))
+			x, y, z := float64(n(ht, 0, 9)), float64(n(ht, 10, 19)), float64(n(ht, 20, 29))
+			a = mustJSON([]any{w, x})
+			b = mustJSON([]any{w, y, z})
+			o = optSet{rationalize: true, factorize: shaped(true, false)}
+		} else {
+			// And in an object: a member with a short value added to an
+			// empty object is weighed as the object's whole text.
+			k := pick(ht, "name", "id", "k e", "x.y", "a/b")
+			a = mustJSON(map[string]any{})
+			b = mustJSON(map[string]any{k: pick(ht, any(map[string]any{}), any([]any{}), any(""), any(float64(n(ht, 0, 9))))})
+			o = optSet{rationalize: true, factorize: shaped(true, false)}
+		}
+		patchGives(ht, a, b, o, region("jsondiff/12"))
+		pb := mustJSON(compare(ht, a, b, o))
+		o2 := o
+		o2.rationalize = false
+		plainB := mustJSON(compare(ht, a, b, o2))
+		if len(pb) > len(plainB) {
+			mismatch(ht, region("jsondiff/12"), "Rationalize gives %s (%d bytes), larger than the patch without it %s (%d bytes)", pb, len(pb), plainB, len(plainB))
+		}
+	})
+}
