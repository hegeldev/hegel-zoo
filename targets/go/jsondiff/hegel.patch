+// jsondiff/7: an invertible patch between documents of different root kinds
+// inverts back to the source.
+func TestHegelInvertibleAcrossRootKinds(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		kinds := []string{"null", "bool", "number", "string", "array", "object"}
+		var va, vb any
+		if noKnown { // past the region: two scalars of one kind
+			va = valueOfKind(ht, pick(ht, "bool", "number", "string"))
+			switch x := va.(type) {
+			case bool:
+				vb = !x
+			case float64:
+				vb = x + 1
+			case string:
+				vb = x + "!"
+			}
+		} else {
+			i := n(ht, 0, len(kinds)-1)
+			j := (i + n(ht, 1, len(kinds)-1)) % len(kinds)
+			va, vb = valueOfKind(ht, kinds[i]), valueOfKind(ht, kinds[j])
+		}
+		invertsBack(ht, mustJSON(va), mustJSON(vb), optSet{invertible: true}, region("jsondiff/7"))
+	})
+}
