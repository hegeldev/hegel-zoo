+// jsondiff/10: Factorize with LCS moves the element it names.
+func TestHegelFactorizeMovesTheRightElement(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// [x, m, y] to [y, m]: the LCS differ removes x and adds y before m
+		// with indices valid in order, and Factorize folds the later removal
+		// of y into a move placed first.
+		xs := distinctScalars(ht, 3, 3)
+		ys := []any{xs[2], xs[1]}
+		va, vb := inMember(ht, xs, ys)
+		// LCS alone gets the indices right: past the region.
+		o := optSet{factorize: shaped(true, false), lcs: true}
+		patchGives(ht, mustJSON(va), mustJSON(vb), o, region("jsondiff/10"))
+	})
+}
