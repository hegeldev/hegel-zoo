+// ---------------------------------------------------------------------------
+// Property 4: the entry points agree, and a Differ is reusable.
+
+func TestHegelEntryPoints(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		o.inPlace = false
+		o.skipCompact = false
+		o.useNumber = false
+		a, b := genPair(ht, keysFor(o))
+		note(ht, "a = %s", a)
+		note(ht, "b = %s", b)
+		note(ht, "opts = %s", o)
+		va, _ := decode(a)
+		vb, _ := decode(b)
+		// Under Equivalent, hashing reorders arrays in place with a per-call
+		// seed (jsondiff/3), so the entry points disagree on such pairs;
+		// under its gate they are only asked to agree once applied.
+		reordered := o.equivalent && (hasReorderableArray(va) || hasReorderableArray(vb))
+		permuted := Known.equivalentSortsInput && reordered
+		ref := compare(ht, a, b, o)
+		rb := mustJSON(ref)
+		note(ht, "patch = %s", rb)
+		// agrees: the same patch, or under Factorize one that differs only in
+		// which of several equal members a copy takes its value from (the
+		// candidates are found through a hash table whose order varies), which
+		// is judged by applying it.
+		agrees := func(p jsondiff.Patch) bool {
+			got := mustJSON(p)
+			if sameJSON(got, rb, false) {
+				return true
+			}
+			if !o.factorize {
+				return false
+			}
+			out, err := applyModel(a, got)
+			return err == nil && sameJSON(out, b, o.equivalent)
+		}
+		disagrees := func(what string, p jsondiff.Patch) {
+			mismatch(ht, append(ids(shape{"jsondiff/3", reordered}), applyShapes(p, va, vb, o)...), "%s gives %s, CompareJSON %s", what, mustJSON(p), rb)
+		}
+		shapes := panicShapes(va, vb, o)
+		var p2 jsondiff.Patch
+		calling(ht, shapes, "Compare", func() {
+			var err error
+			if p2, err = jsondiff.Compare(va, vb, o.options()...); err != nil {
+				fail(ht, "Compare: %v", err)
+			}
+		})
+		if !permuted && !agrees(p2) {
+			disagrees("Compare", p2)
+		}
+		va3, vb3 := clone(va), clone(vb)
+		var p3 jsondiff.Patch
+		calling(ht, shapes, "CompareWithoutMarshal", func() {
+			var err error
+			if p3, err = jsondiff.CompareWithoutMarshal(va3, vb3, o.options()...); err != nil {
+				fail(ht, "CompareWithoutMarshal: %v", err)
+			}
+		})
+		if !(Known.equivalentSortsInput && o.equivalent) && (canonical(va3, false) != canonical(va, false) || canonical(vb3, false) != canonical(vb, false)) {
+			mismatch(ht, ids(shape{"jsondiff/3", o.equivalent}), "CompareWithoutMarshal changed its arguments: source now %s, target now %s", mustJSON(va3), mustJSON(vb3))
+		}
+		if !o.rationalize && !permuted && !agrees(p3) {
+			disagrees("CompareWithoutMarshal", p3)
+		}
+		// MarshalFunc/UnmarshalFunc wrappers around the standard library
+		// change nothing.
+		opts := append(o.options(), jsondiff.MarshalFunc(func(v any) ([]byte, error) { return json.Marshal(v) }), jsondiff.UnmarshalFunc(func(b []byte, v any) error { return json.Unmarshal(b, v) }))
+		var p4 jsondiff.Patch
+		calling(ht, shapes, "Compare with the standard marshal funcs", func() {
+			var err error
+			if p4, err = jsondiff.Compare(va, vb, opts...); err != nil {
+				fail(ht, "Compare with marshal funcs: %v", err)
+			}
+		})
+		if !permuted && !agrees(p4) {
+			disagrees("Compare with the standard marshal funcs", p4)
+		}
+		// A Differ, reused after Reset, gives the same patch each time.
+		d := (&jsondiff.Differ{}).WithOpts(o.options()...)
+		for i := 0; i < 2; i++ {
+			d.Reset()
+			calling(ht, shapes, "Differ.Compare", func() { d.Compare(decodeOrNil(a), decodeOrNil(b)) })
+			if p := d.Patch(); !o.rationalize && !permuted && !agrees(p) {
+				disagrees(fmt.Sprintf("Differ round %d", i), p)
+			}
+		}
+		// Swapping the documents gives a patch that goes the other way.
+		back := compare(ht, b, a, o)
+		bb := mustJSON(back)
+		backShapes := applyShapes(back, vb, va, o)
+		got, err := applyModel(b, bb)
+		if err != nil {
+			mismatch(ht, backShapes, "model cannot apply the reverse patch: %v\n  patch %s", err, bb)
+		}
+		if !sameJSON(got, a, o.equivalent) {
+			mismatch(ht, append(backShapes, equivalentShapes(b, a, o)...), "CompareJSON(b, a) applied to b gives %s, want %s\n  patch %s", got, a, bb)
+		}
+	})
+}
+
+func decodeOrNil(b []byte) any {
+	v, _ := decode(b)
+	return v
+}
+
+// ---------------------------------------------------------------------------
+// Property 5: MergePatch (RFC 7386).
+
+// stripNulls removes null-valued members from objects (recursively through
+// objects, not arrays): what a merge patch cannot express.
+func stripNulls(v any) any {
+	if m, ok := v.(map[string]any); ok {
+		out := make(map[string]any, len(m))
+		for k, c := range m {
+			if c == nil {
+				continue
+			}
+			out[k] = stripNulls(c)
+		}
+		return out
+	}
+	return v
+}
+
+// mergeApply is RFC 7386 section 2.
+func mergeApply(target, patch any) any {
+	pm, ok := patch.(map[string]any)
+	if !ok {
+		return patch
+	}
+	tm, ok := target.(map[string]any)
+	if !ok {
+		tm = map[string]any{}
+	}
+	for k, v := range pm {
+		if v == nil {
+			delete(tm, k)
+			continue
+		}
+		tm[k] = mergeApply(tm[k], v)
+	}
+	return tm
+}
+
+// mergeExpected is the closest document to b a merge patch from a can
+// produce: nulls that a merge patch would have to add are lost, nulls
+// already in a and unchanged stay.
+func mergeExpected(a, b any) any {
+	if canonical(a, false) == canonical(b, false) {
+		return clone(a)
+	}
+	am, aObj := a.(map[string]any)
+	bm, bObj := b.(map[string]any)
+	if !bObj {
+		return clone(b)
+	}
+	if !aObj {
+		return stripNulls(b)
+	}
+	out := map[string]any{}
+	for k, bv := range bm {
+		if bv == nil {
+			if av, ok := am[k]; ok && av == nil {
+				out[k] = nil // unchanged, nothing to patch
+			}
+			continue
+		}
+		if av, ok := am[k]; ok {
+			out[k] = mergeExpected(av, bv)
+		} else {
+			out[k] = stripNulls(bv)
+		}
+	}
+	return out
+}
+
+func TestHegelMergePatch(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a, b := genPair(ht, keyPool)
+		va, _ := decode(a)
+		vb, _ := decode(b)
+		if Known.mergePatchNullTarget && vb == nil {
+			// A null target is jsondiff/4's region: under its gate it is
+			// drawn as false, the neighbouring scalar.
+			vb = false
+			b = mustJSON(vb)
+		}
+		note(ht, "a = %s", a)
+		note(ht, "b = %s", b)
+		mp, err := jsondiff.MergePatchJSON(a, b)
+		if err != nil {
+			fail(ht, "MergePatchJSON: %v", err)
+		}
+		note(ht, "merge patch = %s", mp)
+		if !json.Valid(mp) {
+			mismatch(ht, ids(shape{"jsondiff/4", vb == nil}), "MergePatchJSON produced invalid JSON: %q", mp)
+		}
+		want := mustJSON(mergeExpected(va, vb))
+		_, aObj := va.(map[string]any)
+		pv, _ := decode(mp)
+		if got := mustJSON(mergeApply(clone(va), pv)); !sameJSON(got, want, false) {
+			fail(ht, "applying the merge patch to a (RFC 7386) gives %s, want %s\n  merge patch %s", got, want, mp)
+		}
+		if aObj && !hasNull(vb) { // evanphx prunes nulls inside arrays, beyond RFC 7386
+			got, err := jsonpatch.MergePatch(a, mp)
+			if err != nil {
+				fail(ht, "evanphx MergePatch: %v\n  merge patch %s", err, mp)
+			}
+			if !sameJSON(got, want, false) {
+				fail(ht, "evanphx: applying the merge patch to a gives %s, want %s\n  merge patch %s", got, want, mp)
+			}
+		}
+		// The value form agrees with the JSON form.
+		mp2, err := jsondiff.MergePatch(va, vb)
+		if err != nil {
+			fail(ht, "MergePatch: %v", err)
+		}
+		if !sameJSON(mp, mp2, false) {
+			fail(ht, "MergePatch gives %s, MergePatchJSON %s", mp2, mp)
+		}
+		// Equal objects give an empty merge patch.
+		if sameJSON(a, b, false) && aObj && string(bytes.TrimSpace(mp)) != "{}" {
+			fail(ht, "equal objects give the merge patch %s, want {}", mp)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// One narrow property per recorded bug: each draws random contents inside the
+// bug's shape region (under HEGEL_NO_KNOWN=1 the neighbouring region past it,
+// see shaped) and checks them with the oracles above.
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// region names the bug whose shape region a narrow property draws; nothing
+// under HEGEL_NO_KNOWN=1, when it draws the region past it, where a failure
+// is nobody's shape.
+func region(id string) []string { return shaped([]string{id}, nil) }
+
+// patchGives checks that the patch for (a, b) under o applies to a with the
+// model applier and gives b (up to array order under Equivalent).
+func patchGives(ht *hegel.T, a, b []byte, o optSet, shapes []string) {
+	note(ht, "a = %s", a)
+	note(ht, "b = %s", b)
+	note(ht, "opts = %s", o)
+	patch := compare(ht, a, b, o)
+	pb := mustJSON(patch)
+	note(ht, "patch = %s", pb)
+	got, err := applyModel(a, pb)
+	if err != nil {
+		mismatch(ht, shapes, "model cannot apply the patch: %v\n  patch %s", err, pb)
+	}
+	if !sameJSON(got, b, o.equivalent) {
+		mismatch(ht, shapes, "model: applying the patch to a gives %s, want %s\n  patch %s", got, b, pb)
+	}
+}
+
+// someKeys draws k distinct keys of plainKeys (a run of the pool from a drawn
+// start; k at most its length).
+func someKeys(ht *hegel.T, k int) []string {
+	start := n(ht, 0, len(plainKeys)-1)
+	out := make([]string, k)
+	for i := range out {
+		out[i] = plainKeys[(start+i)%len(plainKeys)]
+	}
+	return out
+}
+
+// numbers draws lo to hi numbers in [100, 199]: they write their own eight
+// bytes into the differ's hasher and so collide with nothing else drawn here.
+func numbers(ht *hegel.T, lo, hi int) []any {
+	out := make([]any, n(ht, lo, hi))
+	for i := range out {
+		out[i] = float64(n(ht, 100, 199))
+	}
+	return out
+}
+
+// distinctScalars draws lo to hi scalars that differ pairwise: the i-th is a
+// number in [10i, 10i+9] or the text of one.
+func distinctScalars(ht *hegel.T, lo, hi int) []any {
+	out := make([]any, n(ht, lo, hi))
+	for i := range out {
+		v := 10*i + n(ht, 0, 9)
+		if chance(ht, 50) {
+			out[i] = strconv.Itoa(v)
+		} else {
+			out[i] = float64(v)
+		}
+	}
+	return out
+}
+
+// longWords are string values of eleven bytes or more.
+var longWords = []string{"hello world", "quick brown fox", "lorem ipsum", "jsondiff zoo", "abcdefghijkl"}
+
+// inMember wraps a and b as the value of one drawn member half of the time.
+func inMember(ht *hegel.T, a, b any) (any, any) {
+	if chance(ht, 50) {
+		k := pick(ht, plainKeys...)
+		return map[string]any{k: a}, map[string]any{k: b}
+	}
+	return a, b
+}
+
+// collidingPair draws two values that differ but that the differ's hasher
+// (hash.go) writes identically: it tags no types and delimits nothing, so an
+// empty array, one nested in empties, "" and {} are alike; null and false
+// write '0' and true '1', like the strings "0" and "1"; a string is the
+// concatenation of its pieces; [x] is x; an object is its keys and values run
+// together. The pair's values are the region of jsondiff/1 and jsondiff/2;
+// under HEGEL_NO_KNOWN=1 the second is a copy of the first.
+func collidingPair(ht *hegel.T) (any, any) {
+	two := func(xs ...any) (any, any) {
+		i := n(ht, 0, len(xs)-1)
+		j := (i + n(ht, 1, len(xs)-1)) % len(xs)
+		return xs[i], xs[j]
+	}
+	var v1, v2 any
+	switch n(ht, 0, 5) {
+	case 0:
+		v1, v2 = two([]any{}, []any{[]any{}}, []any{[]any{[]any{}}}, "", map[string]any{})
+	case 1:
+		v1, v2 = two(nil, false, "0")
+	case 2:
+		v1, v2 = two(true, "1")
+	case 3:
+		s := pick(ht, "ab", "abc", "hello", "foo", "null")
+		cut := n(ht, 1, len(s)-1)
+		v1, v2 = s, []any{s[:cut], s[cut:]}
+	case 4:
+		x := float64(n(ht, 2, 99))
+		v1, v2 = []any{x}, x
+	default:
+		k, v := pick(ht, plainKeys...), pick(ht, "b", "foo", "x")
+		v1, v2 = map[string]any{k: v}, map[string]any{k + v: ""}
+	}
+	return v1, shaped(v2, clone(v1))
+}
+
+// jsondiff/1: with Factorize, a copy stands in for an add only when the
+// value at the copy's source equals the added one.
+func TestHegelFactorizeCopiesOnlyEqualValues(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v1, v2 := collidingPair(ht)
+		keys := someKeys(ht, 2+n(ht, 0, 3))
+		obj := map[string]any{keys[0]: v1}
+		for _, k := range keys[2:] {
+			obj[k] = float64(n(ht, 100, 199))
+		}
+		a := mustJSON(obj)
+		obj[keys[1]] = v2
+		b := mustJSON(obj)
+		patchGives(ht, a, b, optSet{factorize: true}, region("jsondiff/1"))
+	})
+}
+
+// jsondiff/2: under Equivalent, arrays whose elements differ are not
+// equivalent, whatever their digests.
+func TestHegelEquivalentTellsCollidingElementsApart(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v1, v2 := collidingPair(ht)
+		xs := numbers(ht, 0, 3)
+		insert := func(v any) any {
+			at := n(ht, 0, len(xs))
+			out := append([]any(nil), xs[:at]...)
+			return append(append(out, v), xs[at:]...)
+		}
+		va, vb := inMember(ht, insert(v1), insert(v2))
+		patchGives(ht, mustJSON(va), mustJSON(vb), optSet{equivalent: true}, region("jsondiff/2"))
+	})
+}
+
+// jsondiff/3: Equivalent leaves the caller's arrays in the order given.
+func TestHegelEquivalentKeepsTheCallerArraysInOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// Two arrays of the same elements in opposite orders are sorted into
+		// one order by hash, so at least one changes. The differ hashes (and
+		// so sorts) the target's element only when the roots have the same
+		// length and differ, hence the one-element source; past the region
+		// the source is empty and the element is appended, never hashed.
+		xs := distinctScalars(ht, 2, 4)
+		rev := make([]any, len(xs))
+		for i := range xs {
+			rev[len(xs)-1-i] = xs[i]
+		}
+		tgt := []any{[]any{xs, rev}}
+		src := []any{}
+		if !noKnown {
+			src = []any{genScalar(ht)}
+		}
+		note(ht, "src = %s", mustJSON(src))
+		before := mustJSON(tgt)
+		note(ht, "tgt = %s", before)
+		calling(ht, region("jsondiff/3"), "CompareWithoutMarshal", func() {
+			if _, err := jsondiff.CompareWithoutMarshal(src, tgt, jsondiff.Equivalent()); err != nil {
+				fail(ht, "CompareWithoutMarshal: %v", err)
+			}
+		})
+		if after := mustJSON(tgt); string(after) != string(before) {
+			mismatch(ht, region("jsondiff/3"), "CompareWithoutMarshal with Equivalent reordered the caller's target: %s -> %s", before, after)
+		}
+	})
+}
+
+// jsondiff/4: the merge patch that turns a document into null is the JSON
+// text null (RFC 7386: a patch that is not an object replaces the document).
+func TestHegelMergePatchToNullIsValidJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		va := genValue(ht, 2, keyPool)
+		var vb any // past the region, a scalar that is not null
+		if noKnown {
+			vb = pick[any](ht, false, true, float64(n(ht, -5, 20)), "x")
+		}
+		a, b := mustJSON(va), mustJSON(vb)
+		note(ht, "a = %s", a)
+		note(ht, "b = %s", b)
+		var mp []byte
+		calling(ht, region("jsondiff/4"), "MergePatchJSON", func() {
+			var err error
+			if mp, err = jsondiff.MergePatchJSON(a, b); err != nil {
+				fail(ht, "MergePatchJSON: %v", err)
+			}
+		})
+		note(ht, "merge patch = %s", mp)
+		if !json.Valid(mp) {
+			mismatch(ht, region("jsondiff/4"), "MergePatchJSON(%s, %s) = %q, not a JSON document", a, b, mp)
+		}
+		pv, _ := decode(mp)
+		if got := mustJSON(mergeApply(clone(va), pv)); !sameJSON(got, b, false) {
+			mismatch(ht, region("jsondiff/4"), "applying the merge patch to a (RFC 7386) gives %s, want %s\n  merge patch %s", got, b, mp)
+		}
+		mp2, err := jsondiff.MergePatch(va, vb)
+		if err != nil {
+			fail(ht, "MergePatch: %v", err)
+		}
+		if !sameJSON(mp, mp2, false) {
+			mismatch(ht, region("jsondiff/4"), "MergePatch gives %s, MergePatchJSON %s", mp2, mp)
+		}
+	})
+}
