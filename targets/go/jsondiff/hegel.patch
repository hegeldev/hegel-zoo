+// jsondiff/13: Equivalent tells arrays apart that hold the same elements with
+// different multiplicities.
+func TestHegelEquivalentTellsMultiplicitiesApart(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// k elements drawn from two distinct numbers x and y: a holds i copies
+		// of x, b another number of them (the region: the same set of
+		// digests and the same length), in the same or the reverse order;
+		// past it, b holds i copies too, so it is a permutation of a.
+		x, y := float64(n(ht, 100, 149)), float64(n(ht, 150, 199))
+		k := n(ht, 2, 5)
+		i := n(ht, 1, k-1)
+		j := n(ht, 0, k-1)
+		if j >= i {
+			j++
+		}
+		copies := func(c int) []any {
+			out := make([]any, 0, k)
+			for m := 0; m < k; m++ {
+				if m < c {
+					out = append(out, x)
+				} else {
+					out = append(out, y)
+				}
+			}
+			return out
+		}
+		xb := copies(shaped(j, i))
+		if chance(ht, 50) {
+			for l, r := 0, len(xb)-1; l < r; l, r = l+1, r-1 {
+				xb[l], xb[r] = xb[r], xb[l]
+			}
+		}
+		va, vb := inMember(ht, copies(i), xb)
+		patchGives(ht, mustJSON(va), mustJSON(vb), optSet{equivalent: true}, region("jsondiff/13"))
+	})
+}
