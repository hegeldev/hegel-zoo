+// jsondiff/9: with Factorize, LCS and Invertible, the test guarding a moved
+// array element is checked before the move.
+func TestHegelFactorizeTestsBeforeMoving(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		xs := distinctScalars(ht, 2, 4)
+		i := n(ht, 0, len(xs)-2)
+		j := n(ht, i+1, len(xs)-1)
+		ys := append([]any(nil), xs...)
+		ys[i], ys[j] = ys[j], ys[i]
+		va, vb := inMember(ht, xs, ys)
+		// Without LCS the swap is two test/replace pairs: past the region.
+		o := optSet{factorize: true, invertible: true, lcs: shaped(true, false)}
+		patchGives(ht, mustJSON(va), mustJSON(vb), o, region("jsondiff/9"))
+	})
+}
