diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..b5667ef
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,285 @@
+package jsondiff_test
+
+// One plain test per recorded bug (see bugs.toml). Each asserts the behaviour
+// the documentation (and RFC 6902 / RFC 7386) promises and fails while the
+// bug is open; target.toml lists them as expected failures.
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/wI2L/jsondiff"
+)
+
+// applies is the patch for (a, b) applied to a by the model applier.
+func applies(t *testing.T, a, b string, opts ...jsondiff.Option) (patch string, result string) {
+	t.Helper()
+	p, err := jsondiff.CompareJSON([]byte(a), []byte(b), opts...)
+	if err != nil {
+		t.Fatalf("CompareJSON: %v", err)
+	}
+	pb, _ := json.Marshal(p)
+	got, err := applyModel([]byte(a), pb)
+	if err != nil {
+		t.Fatalf("applying %s to %s: %v", pb, a, err)
+	}
+	return string(pb), string(got)
+}
+
+// jsondiff/1
+func TestHegelPinFactorizeCopiesEqualValues(t *testing.T) {
+	for _, c := range [][2]string{
+		{`{"x":[],"y":1}`, `{"x":[],"y":1,"z":[[]]}`},
+		{`{"x":null}`, `{"x":null,"y":false}`},
+		{`{"x":["ab"]}`, `{"x":["ab"],"y":["a","b"]}`},
+		{`{"x":"1"}`, `{"x":"1","y":true}`},
+	} {
+		patch, got := applies(t, c[0], c[1], jsondiff.Factorize())
+		if !sameJSON([]byte(got), []byte(c[1]), false) {
+			t.Errorf("Factorize: the patch %s applied to %s gives %s, want %s", patch, c[0], got, c[1])
+		}
+	}
+}
+
+// jsondiff/2
+func TestHegelPinEquivalentArraysHaveEqualElements(t *testing.T) {
+	for _, c := range [][2]string{
+		{`[null]`, `[false]`},
+		{`[[]]`, `[[[]]]`},
+		{`{"a":[3,15,[],[]]}`, `{"a":[[[]],[],15,3]}`},
+		{`["1"]`, `[true]`},
+	} {
+		p, err := jsondiff.CompareJSON([]byte(c[0]), []byte(c[1]), jsondiff.Equivalent())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(p) == 0 {
+			t.Errorf("Equivalent: %s and %s give an empty patch, but they are not permutations of each other", c[0], c[1])
+		}
+	}
+}
+
+// jsondiff/3
+func TestHegelPinEquivalentLeavesTheInputAlone(t *testing.T) {
+	// The arrays are sorted by maphash digest, in an order that changes with
+	// the seed, so a single array keeps its order by chance (one time in n!,
+	// one in six for the three-element array this pin used to hold). Two
+	// arrays holding the same elements in opposite orders are sorted into
+	// one and the same order, so at least one of them changes whatever the
+	// seed. The differ hashes (and so sorts) only when it compares two arrays
+	// of equal length that are not deep-equal, hence the one-element source.
+	src := []any{"bar"}
+	tgt := []any{[]any{[]any{1.0, 2.0, 3.0}, []any{3.0, 2.0, 1.0}}}
+	before, _ := json.Marshal(tgt)
+	if _, err := jsondiff.CompareWithoutMarshal(src, tgt, jsondiff.Equivalent()); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := json.Marshal(tgt)
+	if string(before) != string(after) {
+		t.Errorf("CompareWithoutMarshal with Equivalent reordered the caller's target: %s -> %s", before, after)
+	}
+	// The test value Rationalize emits under Invertible must be the source
+	// as given, so that the patch applies to the caller's document. The
+	// documents are root arrays: an object member equal on both sides is
+	// never hashed, so the object form would not reach the bug.
+	a := `[[[1,2,3],[3,2,1]],1]`
+	b := `[[[1,2,3],[3,2,1]],2]`
+	pj, err := jsondiff.CompareJSON([]byte(a), []byte(b), jsondiff.Equivalent(), jsondiff.Invertible(), jsondiff.Rationalize())
+	if err != nil {
+		t.Fatal(err)
+	}
+	pb, _ := json.Marshal(pj)
+	got, err := applyModel([]byte(a), pb)
+	if err != nil {
+		t.Errorf("the patch %s does not apply to %s: %v", pb, a, err)
+	} else if !sameJSON(got, []byte(b), true) {
+		t.Errorf("the patch %s applied to %s gives %s, want %s (up to array order)", pb, a, got, b)
+	}
+}
+
+// jsondiff/4
+func TestHegelPinMergePatchToNull(t *testing.T) {
+	for _, a := range []string{`{}`, `{"a":1}`, `[]`} {
+		mp, err := jsondiff.MergePatchJSON([]byte(a), []byte(`null`))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(mp) != "null" {
+			t.Errorf("MergePatchJSON(%s, null) = %q, want null (RFC 7386: a non-object patch replaces the document)", a, mp)
+		}
+	}
+}
+
+// jsondiff/5
+func TestHegelPinRationalizeHandlesEscapedKeys(t *testing.T) {
+	a := `{"\\":{"a":1,"b":2}}`
+	b := `{"\\":{"a":1,"b":3}}`
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Errorf("CompareJSON(%s, %s, Rationalize()) panics: %v", a, b, r)
+			}
+		}()
+		if _, err := jsondiff.CompareJSON([]byte(a), []byte(b), jsondiff.Rationalize()); err != nil {
+			t.Errorf("CompareJSON: %v", err)
+		}
+	}()
+	// A key that needs escaping must not make the replacement look free.
+	a, b = `{"a\"b":{"a":1,"b":2}}`, `{"a\"b":{"a":1,"b":3}}`
+	p, err := jsondiff.CompareJSON([]byte(a), []byte(b), jsondiff.Rationalize())
+	if err != nil {
+		t.Fatal(err)
+	}
+	plain, _ := jsondiff.CompareJSON([]byte(a), []byte(b))
+	pb, _ := json.Marshal(p)
+	qb, _ := json.Marshal(plain)
+	if len(pb) > len(qb) {
+		t.Errorf("Rationalize gives %s (%d bytes), larger than the plain patch %s (%d bytes)", pb, len(pb), qb, len(qb))
+	}
+}
+
+// jsondiff/6
+func TestHegelPinRationalizeCountsTheTestOperation(t *testing.T) {
+	a := `{"0":[[{},[]],""]}`
+	b := `{"0":[[{},[]]]}`
+	p, err := jsondiff.CompareJSON([]byte(a), []byte(b), jsondiff.Rationalize(), jsondiff.Invertible())
+	if err != nil {
+		t.Fatal(err)
+	}
+	plain, _ := jsondiff.CompareJSON([]byte(a), []byte(b), jsondiff.Invertible())
+	pb, _ := json.Marshal(p)
+	qb, _ := json.Marshal(plain)
+	if len(pb) > len(qb) {
+		t.Errorf("Rationalize+Invertible gives %s (%d bytes), larger than the plain invertible patch %s (%d bytes)", pb, len(pb), qb, len(qb))
+	}
+}
+
+// jsondiff/7
+func TestHegelPinInvertibleAcrossRootTypes(t *testing.T) {
+	a := `1`
+	b := `{"a":1}`
+	p, err := jsondiff.CompareJSON([]byte(a), []byte(b), jsondiff.Invertible())
+	if err != nil {
+		t.Fatal(err)
+	}
+	inv, err := p.Invert()
+	if err != nil {
+		t.Fatalf("Invert: %v", err)
+	}
+	ib, _ := json.Marshal(inv)
+	got, err := applyModel([]byte(b), ib)
+	if err != nil {
+		t.Fatalf("the inverse %s of %s does not apply to %s: %v", ib, p.String(), b, err)
+	}
+	if string(got) != a {
+		t.Errorf("the inverse %s applied to %s gives %s, want %s", ib, b, got, a)
+	}
+}
+
+// jsondiff/8
+func TestHegelPinInvertOfAnAppend(t *testing.T) {
+	a := `[1]`
+	b := `[1,2]`
+	p, err := jsondiff.CompareJSON([]byte(a), []byte(b), jsondiff.Invertible())
+	if err != nil {
+		t.Fatal(err)
+	}
+	inv, err := p.Invert()
+	if err != nil {
+		t.Fatalf("Invert: %v", err)
+	}
+	ib, _ := json.Marshal(inv)
+	got, err := applyModel([]byte(b), ib)
+	if err != nil {
+		t.Fatalf("the inverse %s of %s does not apply to %s: %v (RFC 6902: the \"-\" index is only valid for add)", ib, p.String(), b, err)
+	}
+	if string(got) != a {
+		t.Errorf("the inverse %s applied to %s gives %s, want %s", ib, b, got, a)
+	}
+}
+
+// jsondiff/9
+func TestHegelPinFactorizeTestsBeforeMoving(t *testing.T) {
+	a := `[null,[1]]`
+	b := `[[1],null]`
+	patch, got := applies(t, a, b, jsondiff.Factorize(), jsondiff.LCS(), jsondiff.Invertible())
+	if got != b {
+		t.Errorf("the patch %s applied to %s gives %s, want %s", patch, a, got, b)
+	}
+}
+
+// jsondiff/10
+func TestHegelPinFactorizeMovesTheRightElement(t *testing.T) {
+	for _, c := range [][2]string{
+		{`["x",{},1]`, `[1,{}]`},
+		{`[1,2,3]`, `[3,4,2]`},
+		{`["foo!",{},-1.25]`, `[-1.25,"foo",{}]`},
+	} {
+		patch, got := applies(t, c[0], c[1], jsondiff.Factorize(), jsondiff.LCS())
+		if got != c[1] {
+			t.Errorf("Factorize+LCS: the patch %s applied to %s gives %s, want %s", patch, c[0], got, c[1])
+		}
+	}
+}
+
+// jsondiff/11
+func TestHegelPinRationalizeWithEquivalentDoesNotPanic(t *testing.T) {
+	a := `[[[[null,null]],""]]`
+	b := `[[[[null]],""]]`
+	// The array order used while hashing changes with the seed, so the panic
+	// shows on about a third of the calls; sixty calls make a miss negligible.
+	for i := 0; i < 60; i++ {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Fatalf("call %d: CompareJSON(%s, %s, Rationalize(), Equivalent()) panics: %v", i, a, b, r)
+				}
+			}()
+			if _, err := jsondiff.CompareJSON([]byte(a), []byte(b), jsondiff.Rationalize(), jsondiff.Equivalent()); err != nil {
+				t.Fatalf("CompareJSON: %v", err)
+			}
+		}()
+	}
+}
+
+// jsondiff/12: with LCS, and the second shape of 2026-10-06, an add without it.
+func TestHegelPinRationalizeKeepsTheSmallerFactorizedPatch(t *testing.T) {
+	long := `"` + strings.Repeat("a", 40) + `"`
+	for _, c := range []struct {
+		name, a, b string
+		opts       []jsondiff.Option
+	}{
+		{"Factorize+LCS", `[0.5,{"d":-2,"name":"baz","k":"long string value"}]`, `[false,0.5,{"name":"baz","k":"long string value"}]`, []jsondiff.Option{jsondiff.Factorize(), jsondiff.LCS()}},
+		{"Factorize", `[` + long + `,1]`, `[` + long + `,2,3]`, []jsondiff.Option{jsondiff.Factorize()}},
+		{"Factorize", `{}`, `{"name":{}}`, []jsondiff.Option{jsondiff.Factorize()}},
+	} {
+		p, err := jsondiff.CompareJSON([]byte(c.a), []byte(c.b), append([]jsondiff.Option{jsondiff.Rationalize()}, c.opts...)...)
+		if err != nil {
+			t.Fatal(err)
+		}
+		plain, _ := jsondiff.CompareJSON([]byte(c.a), []byte(c.b), c.opts...)
+		pb, _ := json.Marshal(p)
+		qb, _ := json.Marshal(plain)
+		if len(pb) > len(qb) {
+			t.Errorf("Rationalize+%s gives %s (%d bytes), larger than the patch without Rationalize %s (%d bytes)", c.name, pb, len(pb), qb, len(qb))
+		}
+	}
+}
+
+// jsondiff/13
+func TestHegelPinEquivalentCountsRepeatedElements(t *testing.T) {
+	for _, c := range [][2]string{
+		{`[1,1,2]`, `[1,2,2]`},
+		{`[0,0,1]`, `[0,1,1]`},
+		{`{"x":[1,1,2]}`, `{"x":[1,2,2]}`},
+	} {
+		p, err := jsondiff.CompareJSON([]byte(c[0]), []byte(c[1]), jsondiff.Equivalent())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(p) == 0 {
+			t.Errorf("Equivalent: %s and %s give an empty patch, but they hold their elements with different multiplicities", c[0], c[1])
+		}
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..c4ea662
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2387 @@
+package jsondiff_test
+
+// Hegel property tests for github.com/wI2L/jsondiff.
+//
+// Oracles: RFC 6902 itself, through two independent appliers of the patches
+// the package produces (github.com/evanphx/json-patch and a small model
+// applier written from the RFC in this file): applying the patch for (a, b)
+// to a must give b; RFC 7386 for MergePatch through evanphx's merge-patch
+// applier and a model of what a merge patch can express; and the documented
+// contracts of the options (no move/copy without Factorize, test operations
+// before every remove/replace with Invertible and no copy, Invert undoing
+// the patch, Ignores leaving the named values alone, Rationalize never
+// enlarging the patch, Equivalent skipping permuted arrays, an empty patch
+// for equal documents, Differ reuse after Reset).
+//
+// The properties draw the shapes of the recorded bugs (bugs.toml) and fail on
+// them, naming the bug (the expected failures of target.toml), and a narrow
+// property per bug draws its shape region alone; HEGEL_NO_KNOWN=1 switches
+// the shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// Set JSONDIFF_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	jsonpatch "github.com/evanphx/json-patch/v5"
+	"github.com/wI2L/jsondiff"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("JSONDIFF_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// noKnown is HEGEL_NO_KNOWN=1, read once: the shapes of the recorded bugs,
+// which the properties draw and fail on by default, are left out of the
+// generators or skipped (see Known and mismatch) for a run that looks past
+// the bugs.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case. The message is also remembered as the running
+// case's verdict (see verdicts).
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, msg+"\n  case: "+lastNote)
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	if caseKey != "" {
+		verdicts[caseKey] = msg
+	}
+	ht.Fatalf("%s", msg)
+}
+
+var lastNote string // the notes of the running case, for collect mode
+
+// verdicts remembers, by the notes a case had made before its first call of
+// the package (its documents and options), the failure it met. The package's
+// result can depend on a hash seed drawn per call (Equivalent sorts arrays by
+// it, Factorize takes a copy's source from a hash table), so a failure met
+// once might not show when the engine runs the same case again, which it
+// then reports as a nondeterministic test: the test fails without a report
+// (hegel.Test drops the engine's diagnostic). calling replays the verdict
+// instead, through fail, so the engine sees the same failure.
+var (
+	verdicts = map[string]string{}
+	caseKey  string // the running case's key, set at its first call of the package
+)
+
+// hegelPanic reports whether a recovered value is the harness's own (a
+// collected mismatch) or Hegel's (a stopped case, a rejected assumption),
+// which must propagate; anything else is a panic of the code under test.
+func hegelPanic(r any) bool {
+	if _, ok := r.(collected); ok {
+		return true
+	}
+	tn := reflect.TypeOf(r).String()
+	return strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.")
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	verdicts = map[string]string{} // one property's verdicts are not another's
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			// A histogram of the shapes named (see mismatch): "jsondiff/6 x12,
+			// skipped jsondiff/3 x3, unexplained x1".
+			byShape := map[string]int{}
+			for _, m := range collectedMsgs {
+				first, _, _ := strings.Cut(m, "\n")
+				tag := "unexplained"
+				if i := strings.Index(first, "(the shape of "); i >= 0 {
+					tag, _, _ = strings.Cut(first[i+len("(the shape of "):], ")")
+					if strings.HasPrefix(first, "skipped: ") {
+						tag = "skipped " + tag
+					}
+				}
+				byShape[tag]++
+			}
+			var hist []string
+			for tag, k := range byShape {
+				hist = append(hist, fmt.Sprintf("%s x%d", tag, k))
+			}
+			sort.Strings(hist)
+			t.Logf("COLLECT %s: %d mismatches: %s", t.Name(), len(collectedMsgs), strings.Join(hist, ", "))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		lastNote, caseKey = "", ""
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			if hegelPanic(r) {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+// chance is true about pct% of the time and shrinks to false (the draw
+// shrinks to 0, which must be the false case).
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 0, 99) >= 100-pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) {
+	m := fmt.Sprintf(format, args...)
+	lastNote += "\n  " + m
+	ht.Note(m)
+}
+
+// Known gates the shapes of the recorded bugs (see bugs.toml): a switch that
+// is on leaves the bug's shape out of a generator (genOpts, keysFor, the
+// shaped draws of the properties), leaves out the sub-check that meets it, or,
+// when the shape shows only in the patch, skips the mismatch (see mismatch and
+// gated). Every switch is off by default, so the properties draw the shapes
+// and fail on them, naming the bug, and on under HEGEL_NO_KNOWN=1. The pin
+// tests in hegel_pins_test.go assert the correct behaviour on fixed examples.
+var Known = struct {
+	copyFromHashCollision         bool // jsondiff/1: Factorize copies from an unchanged value whose hash collides with the added one
+	equivalentCollision           bool // jsondiff/2: Equivalent treats arrays whose elements' hashes collide as equivalent
+	equivalentSortsInput          bool // jsondiff/3: Equivalent sorts the caller's arrays in place while hashing
+	mergePatchNullTarget          bool // jsondiff/4: MergePatch returns no bytes for a null target
+	rationalizeEscapedKeys        bool // jsondiff/5: Rationalize panics on a backslash key and misjudges values under keys that need escaping
+	rationalizeIgnoresTest        bool // jsondiff/6: Rationalize does not count the test operation it adds under Invertible
+	invertibleRootAdd             bool // jsondiff/7: differing root types give a bare add at the root, which Invert turns into remove ""
+	invertAppend                  bool // jsondiff/8: Invert keeps the "-" index of an append in the test and remove it produces
+	testAfterMove                 bool // jsondiff/9: Factorize+LCS+Invertible put the test of a moved element after the move
+	factorizeLCSMoves             bool // jsondiff/10: Factorize+LCS emit moves with wrong array indices
+	rationalizeEquivalent         bool // jsondiff/11: Rationalize+Equivalent panics in findIndex when the arrays were reordered while hashing
+	rationalizeFactorizeLCS       bool // jsondiff/12: Rationalize with Factorize weighs an add into an array as the whole array (with LCS, or an append beside another change)
+	equivalentIgnoresMultiplicity bool // jsondiff/13: Equivalent compares arrays as sets of digests, so [1,1,2] and [1,2,2] give an empty patch
+}{
+	copyFromHashCollision:         noKnown,
+	equivalentCollision:           noKnown,
+	equivalentSortsInput:          noKnown,
+	mergePatchNullTarget:          noKnown,
+	rationalizeEscapedKeys:        noKnown,
+	rationalizeIgnoresTest:        noKnown,
+	invertibleRootAdd:             noKnown,
+	invertAppend:                  noKnown,
+	testAfterMove:                 noKnown,
+	factorizeLCSMoves:             noKnown,
+	rationalizeEquivalent:         noKnown,
+	rationalizeFactorizeLCS:       noKnown,
+	equivalentIgnoresMultiplicity: noKnown,
+}
+
+// movesArrayElements reports whether the patch moves to or from an array
+// index (or a key that looks like one), the shape of jsondiff/10.
+func movesArrayElements(patch jsondiff.Patch) bool {
+	last := func(ptr string) string {
+		if i := strings.LastIndex(ptr, "/"); i >= 0 {
+			return ptr[i+1:]
+		}
+		return ptr
+	}
+	for _, op := range patch {
+		if op.Type != jsondiff.OperationMove {
+			continue
+		}
+		for _, tok := range []string{last(op.From), last(op.Path)} {
+			if tok == "-" {
+				return true
+			}
+			if _, err := strconv.Atoi(tok); err == nil {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// testAfterMove reports whether a test follows a move from the same path
+// (jsondiff/9): it then checks the moved-in value, not the one it was meant for.
+func testAfterMove(patch jsondiff.Patch) bool {
+	for i, op := range patch {
+		if op.Type != jsondiff.OperationMove {
+			continue
+		}
+		for _, later := range patch[i+1:] {
+			if later.Type == jsondiff.OperationTest && later.Path == op.From {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// invertibleShape returns "" when every remove and replace has a test at its
+// path before it with no other operation at that path in between, and no
+// copy is present; otherwise a description of the first offence.
+func invertibleShape(patch jsondiff.Patch) string {
+	for i, op := range patch {
+		switch op.Type {
+		case jsondiff.OperationRemove, jsondiff.OperationReplace:
+			guarded := false
+			for j := i - 1; j >= 0; j-- {
+				if patch[j].Path != op.Path {
+					continue
+				}
+				guarded = patch[j].Type == jsondiff.OperationTest
+				break
+			}
+			if !guarded {
+				return fmt.Sprintf("operation %d (%s %s) is not preceded by a test at its path", i, op.Type, op.Path)
+			}
+		case jsondiff.OperationCopy:
+			return fmt.Sprintf("operation %d is a copy", i)
+		}
+	}
+	return ""
+}
+
+// hasReorderableArray reports whether v contains an array of two or more
+// elements, which Equivalent sorts in place (jsondiff/3), so that the
+// patch's paths and values may refer to the reordered document.
+func hasReorderableArray(v any) bool {
+	switch x := v.(type) {
+	case []any:
+		if len(x) > 1 {
+			return true
+		}
+		for _, e := range x {
+			if hasReorderableArray(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range x {
+			if hasReorderableArray(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// appends reports whether the patch adds with the "-" index (jsondiff/8).
+func appends(patch jsondiff.Patch) bool {
+	for _, op := range patch {
+		if (op.Type == jsondiff.OperationAdd || op.Type == jsondiff.OperationMove) && strings.HasSuffix(op.Path, "/-") {
+			return true
+		}
+	}
+	return false
+}
+
+// hasEscapedKey reports whether an object key anywhere in v needs escaping
+// in JSON text (the shape of jsondiff/5).
+func hasEscapedKey(v any) bool {
+	switch x := v.(type) {
+	case []any:
+		for _, e := range x {
+			if hasEscapedKey(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for k, e := range x {
+			if needsEscape(k) || hasEscapedKey(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func hasNull(v any) bool {
+	switch x := v.(type) {
+	case nil:
+		return true
+	case []any:
+		for _, e := range x {
+			if hasNull(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range x {
+			if hasNull(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func jsonKind(v any) string {
+	switch v.(type) {
+	case nil:
+		return "null"
+	case bool:
+		return "bool"
+	case float64, json.Number:
+		return "number"
+	case string:
+		return "string"
+	case []any:
+		return "array"
+	case map[string]any:
+		return "object"
+	}
+	return "?"
+}
+
+// copiesFromDifferentValue reports the shape of jsondiff/1: a copy operation
+// whose source value in a is not the value added in b.
+func copiesFromDifferentValue(patch jsondiff.Patch, va, vb any) bool {
+	for _, op := range patch {
+		if op.Type != jsondiff.OperationCopy {
+			continue
+		}
+		f, err1 := parsePointer(op.From)
+		p, err2 := parsePointer(op.Path)
+		if err1 != nil || err2 != nil {
+			return true
+		}
+		from, ok1 := getPath(va, f)
+		to, ok2 := getPath(vb, p)
+		if !ok1 || !ok2 || canonical(from, false) != canonical(to, false) {
+			return true
+		}
+	}
+	return false
+}
+
+// arrayToken reports whether the last token of a pointer addresses an array
+// element: an index or "-".
+func arrayToken(ptr string) bool {
+	tok := ptr
+	if i := strings.LastIndex(ptr, "/"); i >= 0 {
+		tok = ptr[i+1:]
+	}
+	if tok == "-" {
+		return true
+	}
+	_, err := strconv.Atoi(tok)
+	return err == nil
+}
+
+// addsAValue reports whether the patch adds a value (an add that Factorize
+// turned into neither a copy nor a move), which, with Factorize, the differ
+// weighs as the text of the whole enclosing container when Rationalize
+// compares the operations with a replace of it (differ.go, add: valueLen =
+// len(doc)): jsondiff/12, found with LCS and, its second shape of 2026-10-06,
+// without it ({} to {"name":{}} becomes a replace of the root; an append
+// beside another change in an array of more than about forty bytes becomes a
+// replace of the array).
+func addsAValue(patch jsondiff.Patch) bool {
+	for _, op := range patch {
+		if op.Type == jsondiff.OperationAdd {
+			return true
+		}
+	}
+	return false
+}
+
+// canonicalSets renders v like canonical with every array sorted and its
+// duplicates removed: two documents that agree on it hold the same sets of
+// elements, whatever their multiplicities.
+func canonicalSets(v any) string {
+	switch x := v.(type) {
+	case []any:
+		seen := map[string]bool{}
+		var parts []string
+		for i := range x {
+			s := canonicalSets(x[i])
+			if !seen[s] {
+				seen[s] = true
+				parts = append(parts, s)
+			}
+		}
+		sort.Strings(parts)
+		return "[" + strings.Join(parts, ",") + "]"
+	case map[string]any:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		parts := make([]string, 0, len(x))
+		for _, k := range keys {
+			parts = append(parts, string(mustJSON(k))+":"+canonicalSets(x[k]))
+		}
+		return "{" + strings.Join(parts, ",") + "}"
+	}
+	return canonical(v, false)
+}
+
+// ---------------------------------------------------------------------------
+// Naming the recorded bugs' shapes.
+
+// shape is a recorded bug's id (or a candidate's, "candidate/go/jsondiff-N":
+// a shape the properties found and reproduced that is not recorded yet) with
+// whether the case at hand has its shape.
+type shape struct {
+	id  string
+	has bool
+}
+
+// ids lists the ids of the shapes the case has.
+func ids(shapes ...shape) []string {
+	var out []string
+	for _, s := range shapes {
+		if s.has {
+			out = append(out, s.id)
+		}
+	}
+	return out
+}
+
+// gated reports whether a shape's gate is on: the Known switch of a recorded
+// bug (so under HEGEL_NO_KNOWN=1); always for a candidate, which is skipped
+// until it is recorded.
+func gated(id string) bool {
+	switch id {
+	case "jsondiff/1":
+		return Known.copyFromHashCollision
+	case "jsondiff/2":
+		return Known.equivalentCollision
+	case "jsondiff/3":
+		return Known.equivalentSortsInput
+	case "jsondiff/4":
+		return Known.mergePatchNullTarget
+	case "jsondiff/5":
+		return Known.rationalizeEscapedKeys
+	case "jsondiff/6":
+		return Known.rationalizeIgnoresTest
+	case "jsondiff/7":
+		return Known.invertibleRootAdd
+	case "jsondiff/8":
+		return Known.invertAppend
+	case "jsondiff/9":
+		return Known.testAfterMove
+	case "jsondiff/10":
+		return Known.factorizeLCSMoves
+	case "jsondiff/11":
+		return Known.rationalizeEquivalent
+	case "jsondiff/12":
+		return Known.rationalizeFactorizeLCS
+	case "jsondiff/13":
+		return Known.equivalentIgnoresMultiplicity
+	}
+	return strings.HasPrefix(id, "candidate/")
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the
+// shapes of the recorded bugs named (none for an unexplained one): the failure
+// names them on its first line; a case whose shapes are all gated is skipped
+// instead (recorded as skipped in collect mode), which is rare, since the
+// generators leave the gated shapes out where they can.
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if len(shapes) > 0 {
+		skip := true
+		for _, s := range shapes {
+			skip = skip && gated(s)
+		}
+		if skip && !collecting {
+			ht.Assume(false)
+		}
+		tag := " (the shape of " + strings.Join(shapes, ", ") + ")"
+		if i := strings.Index(format, "\n"); i >= 0 {
+			format = format[:i] + tag + format[i:]
+		} else {
+			format += tag
+		}
+		if skip {
+			format = "skipped: " + format
+		}
+	}
+	fail(ht, format, args...)
+}
+
+// calling runs a step of the property that calls the package; a panic of the
+// code under test is the property's failure (what names the call), with the
+// shapes of the recorded bugs the case has. The case's first call keys it by
+// its notes so far and replays the verdict it met before, if any (verdicts).
+func calling(ht *hegel.T, shapes []string, what string, fn func()) {
+	if caseKey == "" {
+		caseKey = lastNote
+		if msg, ok := verdicts[caseKey]; ok && !collecting {
+			fail(ht, "%s", msg) // through fail, so that the engine sees the same failure at the same origin
+		}
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			if hegelPanic(r) {
+				panic(r)
+			}
+			mismatch(ht, shapes, "%s panics: %v", what, r)
+		}
+	}()
+	fn()
+}
+
+// compare is CompareJSON(a, b) under o as a step of the property.
+func compare(ht *hegel.T, a, b []byte, o optSet) (patch jsondiff.Patch) {
+	calling(ht, panicShapes(decodeOrNil(a), decodeOrNil(b), o), "CompareJSON", func() {
+		p, err := jsondiff.CompareJSON(a, b, o.options()...)
+		if err != nil {
+			fail(ht, "CompareJSON: %v", err)
+		}
+		patch = p
+	})
+	return patch
+}
+
+// panicShapes names the recorded bugs that make the differ panic on the pair
+// under o: a key that needs escaping under Rationalize (jsondiff/5),
+// Rationalize with Equivalent (jsondiff/11).
+func panicShapes(va, vb any, o optSet) []string {
+	return ids(
+		shape{"jsondiff/5", o.rationalize && (hasEscapedKey(va) || hasEscapedKey(vb))},
+		shape{"jsondiff/11", o.rationalize && o.equivalent},
+	)
+}
+
+// applyShapes names the recorded bugs that make the patch for (va, vb) under
+// o fail to apply or give the wrong document: a copy from a value that differs
+// from the added one (jsondiff/1), a test after a move from its path
+// (jsondiff/9), moves of array elements under Factorize+LCS (jsondiff/10),
+// arrays that Equivalent reordered in place (jsondiff/3).
+func applyShapes(patch jsondiff.Patch, va, vb any, o optSet) []string {
+	return ids(
+		shape{"jsondiff/1", copiesFromDifferentValue(patch, va, vb)},
+		shape{"jsondiff/9", testAfterMove(patch)},
+		shape{"jsondiff/10", o.factorize && o.lcs && movesArrayElements(patch)},
+		shape{"jsondiff/3", o.equivalent && (hasReorderableArray(va) || hasReorderableArray(vb))},
+	)
+}
+
+// equivalentShapes names what explains a patch under Equivalent that leaves a
+// short of want, when the same pair round-trips without it: arrays holding
+// the same elements with different multiplicities, which the differ compares
+// as a set of digests and a length (jsondiff/13: [1,1,2] and [1,2,2] give an
+// empty patch), or otherwise elements whose digests collide (jsondiff/2).
+func equivalentShapes(a, want []byte, o optSet) []string {
+	if !o.equivalent || !equivalentToBlame(a, want, o) {
+		return nil
+	}
+	if canonicalSets(decodeOrNil(a)) == canonicalSets(decodeOrNil(want)) {
+		return []string{"jsondiff/13"}
+	}
+	return []string{"jsondiff/2"}
+}
+
+// sizeShapes names the recorded bugs that make Rationalize enlarge the patch
+// under o, plain being the patch without it: a key that needs escaping
+// (jsondiff/5), the test it adds under Invertible that it does not count
+// (jsondiff/6), arrays reordered under Equivalent (jsondiff/3), and Factorize
+// with LCS or when the plain patch adds a value (jsondiff/12, see addsAValue).
+func sizeShapes(plain jsondiff.Patch, va, vb any, o optSet) []string {
+	return ids(
+		shape{"jsondiff/5", hasEscapedKey(va) || hasEscapedKey(vb)},
+		shape{"jsondiff/6", o.invertible},
+		shape{"jsondiff/3", o.equivalent},
+		shape{"jsondiff/12", o.factorize && (o.lcs || addsAValue(plain))},
+	)
+}
+
+// ---------------------------------------------------------------------------
+// JSON documents: generation, paths, mutation.
+
+var keyPool = []string{"a", "b", "c", "d", "id", "name", "0", "1", "10", "-", "", "a/b", "~", "~0", "x.y", "k e", "é", "\"q\"", "\\"}
+
+// needsEscape reports whether a key is written with escapes in JSON text.
+func needsEscape(k string) bool { return strings.ContainsAny(k, "\\\"<>&\n\t") }
+
+// plainKeys is keyPool without the keys that need escaping: the region past
+// jsondiff/5, for Rationalize under HEGEL_NO_KNOWN=1 (see keysFor), and the
+// keys of the narrow properties whose shape is elsewhere.
+var plainKeys = func() []string {
+	var out []string
+	for _, k := range keyPool {
+		if !needsEscape(k) {
+			out = append(out, k)
+		}
+	}
+	return out
+}()
+
+// keysFor is the key pool of the documents compared under o: the whole pool,
+// without the keys that need escaping only where Rationalize would meet them
+// under the gate of jsondiff/5.
+func keysFor(o optSet) []string {
+	if Known.rationalizeEscapedKeys && o.rationalize {
+		return plainKeys
+	}
+	return keyPool
+}
+
+func genScalar(ht *hegel.T) any {
+	switch n(ht, 0, 6) {
+	case 0:
+		return nil
+	case 1:
+		return chance(ht, 50)
+	case 2:
+		return float64(n(ht, -5, 20))
+	case 3:
+		return pick(ht, 0.5, -1.25, 1e6, 3.0, 1e-3, 123456789.0)
+	case 4:
+		return pick(ht, "", "x", "y", "hello", "a/b", "~", "é中", "line\nbreak", "\"quoted\"", "1", "null", "true")
+	default:
+		return pick(ht, "foo", "bar", "baz")
+	}
+}
+
+// genValue draws a JSON value of bounded depth with object keys from keys;
+// the same scalars and small subtrees recur so that documents share pieces
+// (moves, copies, equivalent arrays).
+func genValue(ht *hegel.T, depth int, keys []string) any {
+	if depth <= 0 || chance(ht, 35) {
+		return genScalar(ht)
+	}
+	if chance(ht, 50) {
+		k := n(ht, 0, 5)
+		arr := make([]any, 0, k)
+		for i := 0; i < k; i++ {
+			arr = append(arr, genValue(ht, depth-1, keys))
+		}
+		return arr
+	}
+	k := n(ht, 0, 5)
+	obj := make(map[string]any, k)
+	for i := 0; i < k; i++ {
+		obj[pick(ht, keys...)] = genValue(ht, depth-1, keys)
+	}
+	return obj
+}
+
+func clone(v any) any {
+	switch x := v.(type) {
+	case []any:
+		out := make([]any, len(x))
+		for i := range x {
+			out[i] = clone(x[i])
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(x))
+		for k := range x {
+			out[k] = clone(x[k])
+		}
+		return out
+	}
+	return v
+}
+
+// paths lists every location in v as a token path, root first.
+func paths(v any) [][]string {
+	var out [][]string
+	var walk func(v any, p []string)
+	walk = func(v any, p []string) {
+		out = append(out, append([]string(nil), p...))
+		switch x := v.(type) {
+		case []any:
+			for i := range x {
+				walk(x[i], append(p, strconv.Itoa(i)))
+			}
+		case map[string]any:
+			keys := make([]string, 0, len(x))
+			for k := range x {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			for _, k := range keys {
+				walk(x[k], append(p, k))
+			}
+		}
+	}
+	walk(v, nil)
+	return out
+}
+
+func getPath(v any, p []string) (any, bool) {
+	for _, t := range p {
+		switch x := v.(type) {
+		case []any:
+			i, err := strconv.Atoi(t)
+			if err != nil || i < 0 || i >= len(x) {
+				return nil, false
+			}
+			v = x[i]
+		case map[string]any:
+			c, ok := x[t]
+			if !ok {
+				return nil, false
+			}
+			v = c
+		default:
+			return nil, false
+		}
+	}
+	return v, true
+}
+
+// setPath replaces the value at p (p non-empty, parent existing).
+func setPath(root any, p []string, val any) any {
+	if len(p) == 0 {
+		return val
+	}
+	parent, _ := getPath(root, p[:len(p)-1])
+	last := p[len(p)-1]
+	switch x := parent.(type) {
+	case []any:
+		i, _ := strconv.Atoi(last)
+		x[i] = val
+	case map[string]any:
+		x[last] = val
+	}
+	return root
+}
+
+func deletePath(root any, p []string) any {
+	if len(p) == 0 {
+		return nil
+	}
+	parent, _ := getPath(root, p[:len(p)-1])
+	last := p[len(p)-1]
+	switch x := parent.(type) {
+	case []any:
+		i, _ := strconv.Atoi(last)
+		copy(x[i:], x[i+1:])
+		return setPath(root, p[:len(p)-1], x[:len(x)-1])
+	case map[string]any:
+		delete(x, last)
+	}
+	return root
+}
+
+// mutate applies 1-6 random edits to a copy of a, with new keys from keys.
+func mutate(ht *hegel.T, a any, keys []string) any {
+	b := clone(a)
+	k := n(ht, 1, 6)
+	for i := 0; i < k; i++ {
+		ps := paths(b)
+		p := ps[n(ht, 0, len(ps)-1)]
+		cur, _ := getPath(b, p)
+		switch n(ht, 0, 7) {
+		case 0: // replace with a fresh value
+			b = setPath(b, p, genValue(ht, 2, keys))
+		case 1: // delete
+			if len(p) > 0 {
+				b = deletePath(b, p)
+			} else {
+				b = genValue(ht, 3, keys)
+			}
+		case 2: // add a member or element
+			switch x := cur.(type) {
+			case map[string]any:
+				x[pick(ht, keys...)] = genValue(ht, 2, keys)
+			case []any:
+				at := n(ht, 0, len(x))
+				x = append(x[:at], append([]any{genValue(ht, 2, keys)}, x[at:]...)...)
+				b = setPath(b, p, x)
+			default:
+				b = setPath(b, p, genValue(ht, 2, keys))
+			}
+		case 3: // copy an existing subtree elsewhere
+			q := ps[n(ht, 0, len(ps)-1)]
+			src, _ := getPath(b, q)
+			switch x := cur.(type) {
+			case map[string]any:
+				x[pick(ht, keys...)] = clone(src)
+			case []any:
+				b = setPath(b, p, append(x, clone(src)))
+			}
+		case 4: // move: copy then delete the original
+			q := ps[n(ht, 0, len(ps)-1)]
+			if len(q) > 0 && !isPrefix(q, p) {
+				src, _ := getPath(b, q)
+				switch x := cur.(type) {
+				case map[string]any:
+					k := pick(ht, keys...)
+					x[k] = clone(src)
+					// When the source lay under the member just written
+					// (or was that member), the write has removed it
+					// already and q no longer leads where it did:
+					// deleting it would index into the moved value.
+					if dst := append(append([]string(nil), p...), k); !isPrefix(dst, q) {
+						b = deletePath(b, q)
+					}
+				case []any:
+					b = setPath(b, p, append(x, clone(src)))
+					b = deletePath(b, q)
+				}
+			}
+		case 5: // permute an array
+			if x, ok := cur.([]any); ok && len(x) > 1 {
+				i, j := n(ht, 0, len(x)-1), n(ht, 0, len(x)-1)
+				x[i], x[j] = x[j], x[i]
+			}
+		case 6: // reverse an array
+			if x, ok := cur.([]any); ok {
+				for i, j := 0, len(x)-1; i < j; i, j = i+1, j-1 {
+					x[i], x[j] = x[j], x[i]
+				}
+			}
+		default: // change a scalar slightly
+			switch x := cur.(type) {
+			case float64:
+				b = setPath(b, p, x+1)
+			case string:
+				b = setPath(b, p, x+"!")
+			case bool:
+				b = setPath(b, p, !x)
+			case nil:
+				b = setPath(b, p, float64(0))
+			}
+		}
+	}
+	return b
+}
+
+func isPrefix(prefix, p []string) bool {
+	if len(prefix) > len(p) {
+		return false
+	}
+	for i := range prefix {
+		if prefix[i] != p[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func mustJSON(v any) []byte {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
+
+func decode(b []byte) (any, error) {
+	var v any
+	err := json.Unmarshal(b, &v)
+	return v, err
+}
+
+// canonical renders a value with sorted keys; with sortArrays, arrays are
+// sorted by their elements' canonical form (equivalence up to permutation).
+func canonical(v any, sortArrays bool) string {
+	switch x := v.(type) {
+	case []any:
+		parts := make([]string, len(x))
+		for i := range x {
+			parts[i] = canonical(x[i], sortArrays)
+		}
+		if sortArrays {
+			sort.Strings(parts)
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case map[string]any:
+		keys := make([]string, 0, len(x))
+		for k := range x {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		parts := make([]string, 0, len(x))
+		for _, k := range keys {
+			parts = append(parts, string(mustJSON(k))+":"+canonical(x[k], sortArrays))
+		}
+		return "{" + strings.Join(parts, ",") + "}"
+	case json.Number:
+		f, _ := x.Float64()
+		return strconv.FormatFloat(f, 'g', -1, 64)
+	case float64:
+		return strconv.FormatFloat(x, 'g', -1, 64)
+	}
+	return string(mustJSON(v))
+}
+
+func sameJSON(a, b []byte, equivalent bool) bool {
+	va, err1 := decode(a)
+	vb, err2 := decode(b)
+	if err1 != nil || err2 != nil {
+		return false
+	}
+	return canonical(va, equivalent) == canonical(vb, equivalent)
+}
+
+func pointer(p []string) string {
+	var sb strings.Builder
+	for _, t := range p {
+		sb.WriteByte('/')
+		sb.WriteString(strings.ReplaceAll(strings.ReplaceAll(t, "~", "~0"), "/", "~1"))
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------------------
+// The model applier (RFC 6902) and the evanphx applier.
+
+type rawOp struct {
+	Op    string
+	Path  *string
+	From  *string
+	Value *json.RawMessage
+}
+
+// parseOps reads a marshaled patch, keeping track of which fields are present
+// (a "value" of null is present).
+func parseOps(patch []byte) ([]rawOp, error) {
+	var raw []map[string]json.RawMessage
+	if err := json.Unmarshal(patch, &raw); err != nil {
+		return nil, err
+	}
+	ops := make([]rawOp, len(raw))
+	for i, m := range raw {
+		var op rawOp
+		if v, ok := m["op"]; ok {
+			if err := json.Unmarshal(v, &op.Op); err != nil {
+				return nil, err
+			}
+		}
+		if v, ok := m["path"]; ok {
+			var s string
+			if err := json.Unmarshal(v, &s); err != nil {
+				return nil, err
+			}
+			op.Path = &s
+		}
+		if v, ok := m["from"]; ok {
+			var s string
+			if err := json.Unmarshal(v, &s); err != nil {
+				return nil, err
+			}
+			op.From = &s
+		}
+		if v, ok := m["value"]; ok {
+			vv := v
+			op.Value = &vv
+		}
+		ops[i] = op
+	}
+	return ops, nil
+}
+
+func parsePointer(s string) ([]string, error) {
+	if s == "" {
+		return nil, nil
+	}
+	if s[0] != '/' {
+		return nil, fmt.Errorf("pointer %q has no leading slash", s)
+	}
+	parts := strings.Split(s[1:], "/")
+	for i, t := range parts {
+		for j := 0; j < len(t); j++ {
+			if t[j] == '~' && (j+1 >= len(t) || (t[j+1] != '0' && t[j+1] != '1')) {
+				return nil, fmt.Errorf("pointer %q has a bad escape", s)
+			}
+		}
+		parts[i] = strings.ReplaceAll(strings.ReplaceAll(t, "~1", "/"), "~0", "~")
+	}
+	return parts, nil
+}
+
+var errModel = errors.New("model")
+
+// modelGet resolves a token path, treating "-" as beyond the end of an array
+// only when asked (for add).
+func modelGet(root any, p []string) (any, error) {
+	v := root
+	for _, t := range p {
+		switch x := v.(type) {
+		case []any:
+			i, err := strconv.Atoi(t)
+			if err != nil || i < 0 || i >= len(x) || (len(t) > 1 && t[0] == '0') {
+				return nil, fmt.Errorf("%w: index %q out of %d", errModel, t, len(x))
+			}
+			v = x[i]
+		case map[string]any:
+			c, ok := x[t]
+			if !ok {
+				return nil, fmt.Errorf("%w: no member %q", errModel, t)
+			}
+			v = c
+		default:
+			return nil, fmt.Errorf("%w: %q into a scalar", errModel, t)
+		}
+	}
+	return v, nil
+}
+
+func modelAdd(root any, p []string, val any) (any, error) {
+	if len(p) == 0 {
+		return val, nil
+	}
+	parent, err := modelGet(root, p[:len(p)-1])
+	if err != nil {
+		return nil, err
+	}
+	last := p[len(p)-1]
+	switch x := parent.(type) {
+	case []any:
+		i := len(x)
+		if last != "-" {
+			i, err = strconv.Atoi(last)
+			if err != nil || i < 0 || i > len(x) || (len(last) > 1 && last[0] == '0') {
+				return nil, fmt.Errorf("%w: add index %q out of %d", errModel, last, len(x))
+			}
+		}
+		x = append(x[:i], append([]any{val}, x[i:]...)...)
+		return setPath(root, p[:len(p)-1], x), nil
+	case map[string]any:
+		x[last] = val
+		return root, nil
+	}
+	return nil, fmt.Errorf("%w: add into a scalar", errModel)
+}
+
+func modelRemove(root any, p []string) (any, any, error) {
+	if len(p) == 0 {
+		return nil, root, fmt.Errorf("%w: remove the root", errModel)
+	}
+	old, err := modelGet(root, p)
+	if err != nil {
+		return nil, nil, err
+	}
+	return deletePath(root, p), old, nil
+}
+
+// applyModel applies the marshaled patch to doc as RFC 6902 reads it.
+func applyModel(doc []byte, patch []byte) ([]byte, error) {
+	ops, err := parseOps(patch)
+	if err != nil {
+		return nil, fmt.Errorf("%w: patch is not a list of operations: %v", errModel, err)
+	}
+	root, err := decode(doc)
+	if err != nil {
+		return nil, err
+	}
+	for i, op := range ops {
+		var err error
+		if op.Path == nil {
+			return nil, fmt.Errorf("%w: op %d has no path", errModel, i)
+		}
+		p, err := parsePointer(*op.Path)
+		if err != nil {
+			return nil, fmt.Errorf("%w: op %d: %v", errModel, i, err)
+		}
+		var val any
+		if op.Value != nil {
+			if err := json.Unmarshal(*op.Value, &val); err != nil {
+				return nil, err
+			}
+		}
+		needValue := func() error {
+			if op.Value == nil {
+				return fmt.Errorf("%w: op %d (%s) has no value", errModel, i, op.Op)
+			}
+			return nil
+		}
+		switch op.Op {
+		case "add":
+			if err := needValue(); err != nil {
+				return nil, err
+			}
+			root, err = modelAdd(root, p, clone(val))
+		case "remove":
+			root, _, err = modelRemove(root, p)
+		case "replace":
+			if err := needValue(); err != nil {
+				return nil, err
+			}
+			if _, err = modelGet(root, p); err == nil {
+				root = setPath(root, p, clone(val))
+			}
+		case "test":
+			if err := needValue(); err != nil {
+				return nil, err
+			}
+			var cur any
+			cur, err = modelGet(root, p)
+			if err == nil && canonical(cur, false) != canonical(val, false) {
+				err = fmt.Errorf("%w: op %d: test failed at %q", errModel, i, *op.Path)
+			}
+		case "move", "copy":
+			if op.From == nil {
+				return nil, fmt.Errorf("%w: op %d (%s) has no from", errModel, i, op.Op)
+			}
+			var f []string
+			f, err = parsePointer(*op.From)
+			if err != nil {
+				return nil, err
+			}
+			var v any
+			v, err = modelGet(root, f)
+			if err != nil {
+				break
+			}
+			v = clone(v)
+			if op.Op == "move" {
+				if isPrefix(f, p) && len(p) > len(f) {
+					return nil, fmt.Errorf("%w: op %d moves %q into itself %q", errModel, i, *op.From, *op.Path)
+				}
+				root, _, err = modelRemove(root, f)
+				if err != nil {
+					break
+				}
+			}
+			root, err = modelAdd(root, p, v)
+		default:
+			return nil, fmt.Errorf("%w: op %d has unknown op %q", errModel, i, op.Op)
+		}
+		if err != nil {
+			return nil, fmt.Errorf("op %d %s %q: %w", i, op.Op, *op.Path, err)
+		}
+	}
+	return mustJSON(root), nil
+}
+
+func applyEvanphx(doc []byte, patch []byte) (out []byte, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("evanphx panicked: %v", r)
+		}
+	}()
+	p, err := jsonpatch.DecodePatch(patch)
+	if err != nil {
+		return nil, fmt.Errorf("evanphx decode: %w", err)
+	}
+	opts := jsonpatch.NewApplyOptions()
+	return p.ApplyWithOptions(doc, opts)
+}
+
+// evanphxCanJudge reports whether the evanphx applier handles this case: it
+// wants object or array documents and does not operate on the root pointer.
+func evanphxCanJudge(doc, target []byte, patch jsondiff.Patch) bool {
+	for _, b := range [][]byte{doc, target} {
+		t := bytes.TrimSpace(b)
+		if len(t) == 0 || (t[0] != '{' && t[0] != '[') {
+			return false
+		}
+	}
+	for _, op := range patch {
+		if op.Type == jsondiff.OperationTest && op.Value == nil {
+			return false // evanphx fails a test of null against null
+		}
+		for _, ptr := range []string{op.Path, op.From} {
+			if ptr == "" && (op.Path == "" || op.Type == jsondiff.OperationMove || op.Type == jsondiff.OperationCopy) {
+				return false
+			}
+			toks, err := parsePointer(ptr)
+			if err != nil {
+				return false
+			}
+			for _, t := range toks {
+				if t == "" || t == "-" {
+					return false // evanphx misreads empty keys and "-" keys of objects
+				}
+			}
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// Options.
+
+type optSet struct {
+	factorize, rationalize, equivalent, lcs, invertible, skipCompact, inPlace, useNumber bool
+	ignores                                                                              []string
+}
+
+func (o optSet) String() string {
+	var parts []string
+	for _, f := range []struct {
+		on   bool
+		name string
+	}{{o.factorize, "Factorize"}, {o.rationalize, "Rationalize"}, {o.equivalent, "Equivalent"}, {o.lcs, "LCS"}, {o.invertible, "Invertible"}, {o.skipCompact, "SkipCompact"}, {o.inPlace, "InPlaceCompaction"}, {o.useNumber, "UseNumber"}} {
+		if f.on {
+			parts = append(parts, f.name)
+		}
+	}
+	if len(o.ignores) > 0 {
+		parts = append(parts, fmt.Sprintf("Ignores%q", o.ignores))
+	}
+	return strings.Join(parts, "+")
+}
+
+func (o optSet) options() []jsondiff.Option {
+	var opts []jsondiff.Option
+	if o.factorize {
+		opts = append(opts, jsondiff.Factorize())
+	}
+	if o.rationalize {
+		opts = append(opts, jsondiff.Rationalize())
+	}
+	if o.equivalent {
+		opts = append(opts, jsondiff.Equivalent())
+	}
+	if o.lcs {
+		opts = append(opts, jsondiff.LCS())
+	}
+	if o.invertible {
+		opts = append(opts, jsondiff.Invertible())
+	}
+	if o.skipCompact {
+		opts = append(opts, jsondiff.SkipCompact())
+	}
+	if o.inPlace {
+		opts = append(opts, jsondiff.InPlaceCompaction())
+	}
+	if o.useNumber {
+		opts = append(opts, jsondiff.UnmarshalFunc(func(b []byte, v any) error {
+			dec := json.NewDecoder(bytes.NewReader(b))
+			dec.UseNumber()
+			return dec.Decode(v)
+		}))
+	}
+	if len(o.ignores) > 0 {
+		opts = append(opts, jsondiff.Ignores(o.ignores...))
+	}
+	return opts
+}
+
+func genOpts(ht *hegel.T) optSet {
+	var o optSet
+	o.factorize = chance(ht, 40)
+	o.rationalize = chance(ht, 35)
+	// Equivalent beside Rationalize is jsondiff/11's region (a panic on
+	// about a third of the calls): not drawn under its gate.
+	if !(Known.rationalizeEquivalent && o.rationalize) {
+		o.equivalent = chance(ht, 25)
+	}
+	o.lcs = chance(ht, 35)
+	o.invertible = chance(ht, 30)
+	o.skipCompact = chance(ht, 30)
+	o.inPlace = chance(ht, 20)
+	o.useNumber = chance(ht, 15)
+	return o
+}
+
+// genPair draws a source document and a target derived from it (mostly) or
+// independent, with object keys from keys; both are returned as compact JSON.
+func genPair(ht *hegel.T, keys []string) (a, b []byte) {
+	va := genValue(ht, 4, keys)
+	var vb any
+	if chance(ht, 80) {
+		vb = mutate(ht, va, keys)
+	} else {
+		vb = genValue(ht, 4, keys)
+	}
+	return mustJSON(va), mustJSON(vb)
+}
+
+// pretty re-indents a compact document (whitespace the differ must ignore).
+func pretty(ht *hegel.T, b []byte) []byte {
+	var out bytes.Buffer
+	if err := json.Indent(&out, b, pick(ht, "", " "), pick(ht, "  ", "\t", " ")); err != nil {
+		return b
+	}
+	return out.Bytes()
+}
+
+// equivalentToBlame reports whether the same case without Equivalent (and
+// without Factorize, whose copies have their own shape) gives want: then the
+// failure is Equivalent's.
+func equivalentToBlame(a, want []byte, o optSet) bool {
+	o2 := o
+	o2.equivalent = false
+	o2.factorize = false
+	o2.inPlace = false
+	patch, err := jsondiff.CompareJSON(a, want, o2.options()...)
+	if err != nil {
+		return false
+	}
+	got, err := applyModel(a, mustJSON(patch))
+	return err == nil && sameJSON(got, want, false)
+}
+
+// hasTestBefore reports whether every remove/replace is preceded by a test
+// at the same path.
+func checkInvertible(ht *hegel.T, patch jsondiff.Patch) {
+	if bad := invertibleShape(patch); bad != "" {
+		fail(ht, "Invertible: %s: %s", bad, patch.String())
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Property 1: applying the patch gives the target, under every option set.
+
+func TestHegelRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		a, b := genPair(ht, keysFor(o))
+		note(ht, "a = %s", a)
+		note(ht, "b = %s", b)
+		note(ht, "opts = %s", o)
+		src, tgt := a, b
+		if !o.skipCompact && chance(ht, 50) {
+			src, tgt = pretty(ht, a), pretty(ht, b)
+		}
+		tgtArg := append([]byte(nil), tgt...) // InPlaceCompaction rewrites it (documented)
+		patch := compare(ht, src, tgtArg, o)
+		pb, err := json.Marshal(patch)
+		if err != nil {
+			fail(ht, "marshaling the patch: %v", err)
+		}
+		note(ht, "patch = %s", pb)
+		// Documented shape of the patch.
+		for _, op := range patch {
+			if (op.Type == jsondiff.OperationMove || op.Type == jsondiff.OperationCopy) && !o.factorize {
+				fail(ht, "a %s operation without Factorize: %s", op.Type, pb)
+			}
+		}
+		if o.invertible {
+			checkInvertible(ht, patch)
+		}
+		if sameJSON(a, b, false) && len(patch) != 0 {
+			fail(ht, "equal documents give a non-empty patch: %s", pb)
+		}
+		va, vb := decodeOrNil(a), decodeOrNil(b)
+		if !o.equivalent && len(patch) == 0 && !sameJSON(a, b, false) {
+			fail(ht, "different documents give an empty patch")
+		}
+		// The two appliers agree with the target.
+		shapes := applyShapes(patch, va, vb, o)
+		got2, err := applyModel(a, pb)
+		if err != nil {
+			mismatch(ht, shapes, "model cannot apply the patch: %v\n  patch %s", err, pb)
+		}
+		if !sameJSON(got2, b, o.equivalent) {
+			mismatch(ht, append(shapes, equivalentShapes(a, b, o)...), "model: applying the patch to a gives %s, want %s\n  patch %s", got2, b, pb)
+		}
+		if evanphxCanJudge(a, b, patch) {
+			got, err := applyEvanphx(a, pb)
+			if err != nil {
+				if strings.Contains(err.Error(), "panicked") {
+					return // evanphx's own crash (see the README), not jsondiff's
+				}
+				mismatch(ht, shapes, "evanphx cannot apply the patch: %v\n  patch %s", err, pb)
+			}
+			if !sameJSON(got, b, o.equivalent) {
+				mismatch(ht, shapes, "evanphx: applying the patch to a gives %s, want %s\n  patch %s", got, b, pb)
+			}
+		}
+		// Rationalize never enlarges the patch. Under the gates of jsondiff/6,
+		// jsondiff/3 and jsondiff/12 the check is left out where they would
+		// make it fail.
+		if o.rationalize && !(Known.rationalizeIgnoresTest && o.invertible) && !(Known.equivalentSortsInput && o.equivalent) && !(Known.rationalizeFactorizeLCS && o.factorize && o.lcs) {
+			o2 := o
+			o2.rationalize = false
+			o2.inPlace = false
+			plain := compare(ht, a, b, o2)
+			plainB := mustJSON(plain)
+			if len(pb) > len(plainB) {
+				mismatch(ht, sizeShapes(plain, va, vb, o), "Rationalize enlarged the patch: %d bytes %s vs %d bytes %s", len(pb), pb, len(plainB), plainB)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 2: Invert undoes an invertible patch, and refuses the others.
+
+// sameKindAs returns v as a value of the JSON kind of ref: v itself when the
+// kinds agree, otherwise v wrapped in a container or rendered as a scalar of
+// ref's kind. Differing root kinds are jsondiff/7's region; under its gate the
+// Invert property draws the target in the source's kind.
+func sameKindAs(ref, v any) any {
+	if jsonKind(ref) == jsonKind(v) {
+		return v
+	}
+	switch ref.(type) {
+	case map[string]any:
+		return map[string]any{"v": v}
+	case []any:
+		return []any{v}
+	case string:
+		return canonical(v, false)
+	case float64, json.Number:
+		return float64(len(canonical(v, false)))
+	case bool:
+		return v != nil
+	}
+	return nil
+}
+
+func TestHegelInvert(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		o.inPlace = false
+		o.invertible = chance(ht, 70)
+		a, b := genPair(ht, keysFor(o))
+		va, vb := decodeOrNil(a), decodeOrNil(b)
+		if Known.invertibleRootAdd && jsonKind(va) != jsonKind(vb) {
+			vb = sameKindAs(va, vb)
+			b = mustJSON(vb)
+		}
+		note(ht, "a = %s", a)
+		note(ht, "b = %s", b)
+		note(ht, "opts = %s", o)
+		patch := compare(ht, a, b, o)
+		if Known.invertAppend && appends(patch) {
+			// An append is jsondiff/8's region: under its gate the pair is
+			// diffed with LCS, which addresses the added elements by index.
+			o.lcs = true
+			patch = compare(ht, a, b, o)
+		}
+		pb := mustJSON(patch)
+		note(ht, "patch = %s", pb)
+		inv, err := patch.Invert()
+		reversible := invertibleShape(patch) == ""
+		if !reversible {
+			if err == nil {
+				fail(ht, "Invert accepted a patch that is not invertible: %s -> %s", pb, mustJSON(inv))
+			}
+			return
+		}
+		if err != nil {
+			fail(ht, "Invert of an invertible patch: %v\n  patch %s", err, pb)
+		}
+		ib := mustJSON(inv)
+		note(ht, "inverse = %s", ib)
+		// Sanity: the forward patch works.
+		fwd, err := applyModel(a, pb)
+		if err != nil || !sameJSON(fwd, b, o.equivalent) {
+			return // the round-trip property reports this
+		}
+		// What makes an inverse fail: a bare add at the root for differing
+		// root kinds (jsondiff/7), the "-" of an append kept (jsondiff/8),
+		// arrays reordered under Equivalent (jsondiff/3).
+		shapes := ids(
+			shape{"jsondiff/7", jsonKind(va) != jsonKind(vb)},
+			shape{"jsondiff/8", appends(patch)},
+			shape{"jsondiff/3", o.equivalent && (hasReorderableArray(va) || hasReorderableArray(vb))},
+		)
+		if evanphxCanJudge(fwd, a, inv) {
+			got, err := applyEvanphx(fwd, ib)
+			if err != nil {
+				if strings.Contains(err.Error(), "panicked") {
+					return // evanphx's own crash (see the README), not jsondiff's
+				}
+				mismatch(ht, shapes, "evanphx cannot apply the inverse: %v\n  inverse %s", err, ib)
+			}
+			if !sameJSON(got, a, o.equivalent) {
+				mismatch(ht, shapes, "applying the inverse to b gives %s, want a = %s\n  patch %s\n  inverse %s", got, a, pb, ib)
+			}
+		}
+		got2, err := applyModel(fwd, ib)
+		if err != nil {
+			mismatch(ht, shapes, "model cannot apply the inverse: %v\n  inverse %s", err, ib)
+		}
+		if !sameJSON(got2, a, o.equivalent) {
+			mismatch(ht, shapes, "model: applying the inverse to b gives %s, want a = %s\n  inverse %s", got2, a, ib)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 3: Ignores leaves the named values as they are in the source.
+
+// objectPaths lists the paths of v whose every segment is an object key.
+func objectPaths(v any) [][]string {
+	var out [][]string
+	for _, p := range paths(v) {
+		if len(p) == 0 {
+			continue
+		}
+		ok := true
+		cur := v
+		for _, t := range p {
+			m, isObj := cur.(map[string]any)
+			if !isObj {
+				ok = false
+				break
+			}
+			cur = m[t]
+		}
+		if ok {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+func TestHegelIgnores(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		// Rationalize replaces a whole value, ignored members included,
+		// which the model below does not describe; the compaction and
+		// number options change nothing here.
+		o.rationalize, o.skipCompact, o.inPlace, o.useNumber = false, false, false, false
+		a, b := genPair(ht, keysFor(o))
+		va, _ := decode(a)
+		vb, _ := decode(b)
+		cands := append(objectPaths(va), objectPaths(vb)...)
+		if len(cands) == 0 {
+			return
+		}
+		k := n(ht, 1, 3)
+		var ign [][]string
+		seen := map[string]bool{}
+		for i := 0; i < k; i++ {
+			p := cands[n(ht, 0, len(cands)-1)]
+			if !seen[pointer(p)] {
+				seen[pointer(p)] = true
+				ign = append(ign, p)
+			}
+		}
+		sort.Slice(ign, func(i, j int) bool { return len(ign[i]) < len(ign[j]) })
+		for _, p := range ign {
+			o.ignores = append(o.ignores, pointer(p))
+		}
+		note(ht, "a = %s", a)
+		note(ht, "b = %s", b)
+		note(ht, "opts = %s", o)
+		patch := compare(ht, a, b, o)
+		pb := mustJSON(patch)
+		note(ht, "patch = %s", pb)
+		under := func(ptr, ig string) bool { return ptr == ig || strings.HasPrefix(ptr, ig+"/") }
+		for _, op := range patch {
+			for _, ig := range o.ignores {
+				if under(op.Path, ig) || (op.Type == jsondiff.OperationMove && under(op.From, ig)) {
+					fail(ht, "an operation touches the ignored pointer %q: %s", ig, pb)
+				}
+			}
+		}
+		// Expected: b, with the ignored values as in a. An ignore takes
+		// effect only where the differ descends to the pointer: every proper
+		// ancestor must be an object in both documents (otherwise the
+		// ancestor is added, removed or replaced as a whole).
+		want := clone(vb)
+		for _, p := range ign {
+			effective := true
+			for i := 0; i < len(p); i++ {
+				x, okA := getPath(va, p[:i])
+				y, okB := getPath(vb, p[:i])
+				_, xo := x.(map[string]any)
+				_, yo := y.(map[string]any)
+				if !okA || !okB || !xo || !yo {
+					effective = false
+				}
+			}
+			if !effective {
+				continue
+			}
+			av, inA := getPath(va, p)
+			if inA {
+				want = setPath(want, p, clone(av))
+			} else {
+				want = deletePath(want, p)
+			}
+		}
+		wb := mustJSON(want)
+		shapes := applyShapes(patch, va, vb, o)
+		got, err := applyModel(a, pb)
+		if err != nil {
+			mismatch(ht, shapes, "model cannot apply the patch: %v\n  patch %s", err, pb)
+		}
+		if !sameJSON(got, wb, o.equivalent) {
+			mismatch(ht, append(shapes, equivalentShapes(a, wb, o)...), "with Ignores%q applying the patch gives %s, want %s\n  patch %s", o.ignores, got, wb, pb)
+		}
+	})
+}
