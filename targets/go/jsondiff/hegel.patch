+// jsondiff/11: Rationalize with Equivalent returns a patch, whatever order
+// the hasher sorts the arrays into.
+func TestHegelRationalizeWithEquivalentDoesNotPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// Inside an element that the hasher sorts in place: an array A that
+		// differs between the documents beside a short string s whose text
+		// squashValue reads past (empty, or starting like true/null/false).
+		// When s sorts first, the differ reads A's text at s's position in
+		// the unsorted text and runs off its end. Past the region the roots
+		// have different lengths, so the element is never hashed.
+		A := numbers(ht, 1, 3)
+		A2 := append([]any(nil), A...)
+		A2[n(ht, 0, len(A)-1)] = float64(n(ht, 0, 9))
+		s := pick(ht, "", "t", "n", "f", "tt", "nf", "tn", "ft")
+		elem, elem2 := []any{A, s}, []any{A2, s}
+		if chance(ht, 50) {
+			elem, elem2 = []any{s, A}, []any{s, A2}
+		}
+		va, vb := []any{elem}, []any{elem2}
+		if noKnown {
+			vb = append(vb, float64(n(ht, 0, 9)))
+		}
+		a, b := mustJSON(va), mustJSON(vb)
+		note(ht, "a = %s", a)
+		note(ht, "b = %s", b)
+		o := optSet{rationalize: true, equivalent: true}
+		// The order follows the hasher's seed, new for every call, and the
+		// panic shows on about a third of them: forty calls make a miss
+		// negligible.
+		for i := 0; i < 40; i++ {
+			calling(ht, region("jsondiff/11"), fmt.Sprintf("call %d: CompareJSON(a, b, Rationalize(), Equivalent())", i), func() {
+				if _, err := jsondiff.CompareJSON(a, b, o.options()...); err != nil {
+					fail(ht, "CompareJSON: %v", err)
+				}
+			})
+		}
+	})
+}
