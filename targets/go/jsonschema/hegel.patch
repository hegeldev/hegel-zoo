+package jsonschema_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged as the wide property that found
+// the bug judges (the Python differential, the transparency of a reference,
+// the format grammars, the well-formedness of the output units), so that
+// each bug has a property that finds it every run; the wide properties reach
+// the shapes at their natural rate. Under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring region the bug does not touch instead (an enum beside $ref, a
+// count within int64, a negative field, names no encoder touches, a
+// satisfied propertyNames, the schema form of dependencies, a failing object
+// that nothing is validated after) and passes.
+
+import (
+	"fmt"
+	"math"
+	"math/big"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/santhosh-tekuri/jsonschema/v6"
+	"hegel.dev/go/hegel"
+)
+
+// bodyOf is a rendered schema document without its $schema.
+func bodyOf(root map[string]any) map[string]any {
+	s := map[string]any{}
+	for k, v := range root {
+		if k != "$schema" {
+			s[k] = v
+		}
+	}
+	return s
+}
+
+// mustCompileDoc compiles a document or fails the case.
+func mustCompileDoc(ht *hegel.T, doc map[string]any, what string) *jsonschema.Schema {
+	sch, err := compileDoc(reparse(doc), false)
+	if err != nil {
+		ht.Fatalf("%s does not compile: %v\n%s", what, err, jsonText(doc))
+	}
+	return sch
+}
+
+// --------------------------------------------------------------------------- jsonschema/1
+
+// constSiblingCase: a schema of draft 6 or 7 (without references of its own)
+// reached through a root's $ref, the root also carrying a const with a
+// random value (the shape of jsonschema/1: every sibling of $ref must be
+// ignored up to draft 7, and const is not) or, under HEGEL_NO_KNOWN=1, an
+// enum of it (which is); and instances shaped after the schema.
+type constSiblingCase struct {
+	d     draftInfo
+	s     map[string]any
+	c     any
+	insts []any
+}
+
+// docs are the plain schema and the referencing root.
+func (c constSiblingCase) docs() (plain, wrapped map[string]any) {
+	plain = map[string]any{"$schema": c.d.url}
+	for k, v := range c.s {
+		plain[k] = v
+	}
+	wrapped = defsWith(c.d, "t", deepCopy(c.s))
+	wrapped["$schema"] = c.d.url
+	wrapped["$ref"] = "#/" + c.d.defsKw + "/t"
+	if Known.refSiblingConst {
+		wrapped["enum"] = []any{c.c}
+	} else {
+		wrapped["const"] = c.c
+	}
+	return plain, wrapped
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c constSiblingCase) GoString() string {
+	plain, wrapped := c.docs()
+	return fmt.Sprintf("draft %d\nplain %s\nwrapped %s\ninstances %s", c.d.version, jsonText(plain), jsonText(wrapped), strings.Join(instTexts(c.insts), " "))
+}
+
+// constSiblingCases: drafts 6 and 7 (draft 4 has no const).
+var constSiblingCases = hegel.FlatMap(hegel.SampledFrom(drafts[1:3]), func(d draftInfo) hegel.Generator[constSiblingCase] {
+	return hegel.FlatMap(schemasOf(d, plainOpts), func(root map[string]any) hegel.Generator[constSiblingCase] {
+		s := bodyOf(root)
+		return hegel.Composite(func(tc hegel.TestCase) constSiblingCase {
+			return constSiblingCase{d: d, s: s, c: hegel.Draw(tc, valuesOf(d, 1)), insts: hegel.Draw(tc, instancesOf(d, s))}
+		})
+	})
+})
+
+// TestHegelConstBesideRefIsIgnored: up to draft 7 a schema object with $ref
+// is that reference and nothing else, so a const beside it changes nothing
+// (as an enum or a type beside it does not); the library enforces the const
+// in drafts 6 and 7 (jsonschema/1).
+func TestHegelConstBesideRefIsIgnored(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, constSiblingCases)
+		plainDoc, wrapped := c.docs()
+		plain := mustCompileDoc(ht, plainDoc, "plain schema")
+		sch := mustCompileDoc(ht, wrapped, "referencing schema")
+		for _, inst := range c.insts {
+			e1, e2 := plain.Validate(reparse(inst)), sch.Validate(reparse(inst))
+			if (e1 == nil) != (e2 == nil) {
+				mismatch(ht, known("jsonschema/1"), "draft %d: plain valid=%v, through $ref with a sibling valid=%v\ninstance %s\nplain %s\nwrapped %s\nwrapped error: %v",
+					c.d.version, e1 == nil, e2 == nil, jsonText(inst), jsonText(plainDoc), jsonText(wrapped), e2)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- jsonschema/2
+
+// countKeyword is a non-negative-integer keyword and the JSON type it
+// constrains.
+type countKeyword struct{ kw, typ string }
+
+var countKeywords = []countKeyword{
+	{"minLength", "string"}, {"maxLength", "string"},
+	{"minItems", "array"}, {"maxItems", "array"},
+	{"minProperties", "object"}, {"maxProperties", "object"},
+}
+
+// countTexts: the text of a count beyond int64 (the shape of jsonschema/2:
+// the library takes the low 64 bits): 2^63 plus a random amount below 2^63
+// (which wraps negative) seven times in ten, 2^64 followed by one to twelve
+// random digits, or 1eN with N in 19..30 (drafts 6 and up: Python reads a
+// float as a non-integer in draft 4). Under HEGEL_NO_KNOWN=1 a count within
+// int64: any non-negative one, or 1eN with N up to 18.
+func countTexts(d draftInfo) hegel.Generator[string] {
+	if Known.bigIntegerKeywords {
+		within := dec(hegel.Integers(0, math.MaxInt64))
+		if d.version == 4 {
+			return within
+		}
+		return weighted(choice[string]{85, within}, choice[string]{15, hegel.Map(hegel.Integers(0, 18), func(n int) string { return fmt.Sprintf("1e%d", n) })})
+	}
+	past63 := hegel.Map(hegel.Integers(0, math.MaxInt64), func(k int) string {
+		return new(big.Int).Add(new(big.Int).Lsh(big.NewInt(1), 63), big.NewInt(int64(k))).String()
+	})
+	past64 := cat(lit("18446744073709551616"), hegel.Text().Alphabet("0123456789").MinSize(1).MaxSize(12))
+	if d.version == 4 {
+		return weighted(choice[string]{80, past63}, choice[string]{20, past64})
+	}
+	exps := hegel.Map(hegel.Integers(19, 30), func(n int) string { return fmt.Sprintf("1e%d", n) })
+	return weighted(choice[string]{70, past63}, choice[string]{15, past64}, choice[string]{15, exps})
+}
+
+// countCase: a draft, a count keyword with a value from countTexts, and one
+// to four instances of the type it constrains.
+type countCase struct {
+	d     draftInfo
+	kw    string
+	text  string
+	insts []any
+}
+
+func (c countCase) schema() map[string]any {
+	return map[string]any{"$schema": c.d.url, c.kw: num(c.text)}
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c countCase) GoString() string {
+	return fmt.Sprintf("draft %d schema %s\ninstances %s", c.d.version, jsonText(c.schema()), strings.Join(instTexts(c.insts), " "))
+}
+
+var countCases = hegel.FlatMap(hegel.SampledFrom(drafts), func(d draftInfo) hegel.Generator[countCase] {
+	texts := countTexts(d)
+	values := valuesOf(d, 0)
+	ofType := map[string]hegel.Generator[any]{
+		"string": strings_,
+		"array":  hegel.Map(hegel.Lists(values).MaxSize(4), func(xs []any) any { return nonNil(xs) }),
+		"object": hegel.Map(hegel.Maps(propNames, values).MaxSize(4), func(m map[string]any) any { return nonNilMap(m) }),
+	}
+	return hegel.FlatMap(hegel.SampledFrom(countKeywords), func(k countKeyword) hegel.Generator[countCase] {
+		insts := hegel.Lists(ofType[k.typ]).MinSize(1).MaxSize(4)
+		return hegel.Composite(func(tc hegel.TestCase) countCase {
+			return countCase{d: d, kw: k.kw, text: hegel.Draw(tc, texts), insts: hegel.Draw(tc, insts)}
+		})
+	})
+})
+
+// TestHegelCountKeywordsBeyondInt64MatchPython: minLength, maxLength,
+// minItems, maxItems, minProperties and maxProperties compare the size with
+// their value as a number, however large, as Python's jsonschema does; the
+// library reads the value through int64 and wraps it around (jsonschema/2).
+func TestHegelCountKeywordsBeyondInt64MatchPython(t *testing.T) {
+	py := startOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, countCases)
+		root := c.schema()
+		schemaText := jsonText(root)
+		texts := instTexts(c.insts)
+		reply, err := py.ask(schemaText, texts)
+		if err != nil {
+			ht.Fatalf("oracle failure: %v\nschema %s", err, schemaText)
+		}
+		if !reply.SchemaOK {
+			ht.Fatalf("python rejects the schema (%s): %s", reply.SchemaErr, schemaText)
+		}
+		sch, cerr := compileDoc(reparse(root), false)
+		if cerr != nil {
+			ht.Fatalf("Compile rejects a schema python accepts: %v\nschema %s", cerr, schemaText)
+		}
+		for i, in := range c.insts {
+			want := reply.Results[i]
+			if want == nil {
+				ht.Fatalf("python raised %s on instance %s\nschema %s", reply.Exc, texts[i], schemaText)
+			}
+			verr := sch.Validate(reparse(in))
+			if got := verr == nil; got != *want {
+				mismatch(ht, known("jsonschema/2"), "draft %d: Validate valid=%v, python valid=%v\ninstance %s\nschema %s\nerror: %v", c.d.version, got, *want, texts[i], schemaText, verr)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- jsonschema/3
+
+// signedFieldCase: a valid time, date-time or ipv4 text with one of its
+// fields written with a sign before its digits: '+' before a digit, or '-'
+// before 0 (both read by strconv.Atoi: the shape of jsonschema/3; RFC 3339
+// wants 2DIGIT fields and a dotted quad has dec-octets); under
+// HEGEL_NO_KNOWN=1 '-' before a digit other than 0, a negative field, which
+// the library rejects as the grammar does.
+type signedFieldCase struct {
+	format string
+	date   [3]int // year, month, day (date-time)
+	fields [5]int // hour, minute, second, offset hour, offset minute; or the four octets
+	frac   string
+	zone   int // 0 Z, 1 +hh:mm, 2 -hh:mm
+	at     int // the signed field, modulo the fields present
+	sign   int // 0: '+' and the field's last digit; 1: "-0"
+}
+
+// count is the number of fields the text has.
+func (c signedFieldCase) count() int {
+	switch {
+	case c.format == "ipv4":
+		return 4
+	case c.zone == 0:
+		return 3
+	}
+	return 5
+}
+
+// field renders the i-th field: two digits (a whole octet), or signed.
+func (c signedFieldCase) field(i int) string {
+	v := c.fields[i]
+	switch {
+	case i != c.at%c.count():
+		if c.format == "ipv4" {
+			return fmt.Sprint(v)
+		}
+		return fmt.Sprintf("%02d", v)
+	case noKnown:
+		return fmt.Sprintf("-%d", 1+v%9)
+	case c.sign == 0 && c.format == "ipv4":
+		return fmt.Sprintf("+%d", v)
+	case c.sign == 0:
+		return fmt.Sprintf("+%d", v%10)
+	}
+	return "-0"
+}
+
+func (c signedFieldCase) text() string {
+	if c.format == "ipv4" {
+		return c.field(0) + "." + c.field(1) + "." + c.field(2) + "." + c.field(3)
+	}
+	t := c.field(0) + ":" + c.field(1) + ":" + c.field(2) + c.frac
+	switch c.zone {
+	case 0:
+		t += "Z"
+	case 1:
+		t += "+" + c.field(3) + ":" + c.field(4)
+	default:
+		t += "-" + c.field(3) + ":" + c.field(4)
+	}
+	if c.format == "date-time" {
+		return fmt.Sprintf("%04d-%02d-%02dT", c.date[0], c.date[1], c.date[2]) + t
+	}
+	return t
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c signedFieldCase) GoString() string { return fmt.Sprintf("format %s: %q", c.format, c.text()) }
+
+var signedFieldCases = hegel.FlatMap(hegel.SampledFrom([]string{"time", "date-time", "ipv4"}), func(format string) hegel.Generator[signedFieldCase] {
+	highs := [5]int{23, 59, 59, 23, 59}
+	if format == "ipv4" {
+		highs = [5]int{255, 255, 255, 255, 0}
+	}
+	return hegel.Composite(func(tc hegel.TestCase) signedFieldCase {
+		var fields [5]int
+		for i, hi := range highs {
+			fields[i] = hegel.Draw(tc, hegel.Integers(0, hi))
+		}
+		return signedFieldCase{
+			format: format,
+			date:   [3]int{hegel.Draw(tc, hegel.Integers(1, 9999)), hegel.Draw(tc, hegel.Integers(1, 12)), hegel.Draw(tc, hegel.Integers(1, 28))},
+			fields: fields,
+			frac:   hegel.Draw(tc, fractions),
+			zone:   hegel.Draw(tc, hegel.Integers(0, 2)),
+			at:     hegel.Draw(tc, hegel.Integers(0, 4)),
+			sign:   hegel.Draw(tc, hegel.Integers(0, 1)),
+		}
+	})
+})
+
+// TestHegelSignedFormatFieldsAreRejected: a time, date-time or ipv4 field is
+// digits (RFC 3339 2DIGIT, a dec-octet), so a field with a sign before its
+// digits is invalid, as the grammar models say; the library reads it with
+// strconv.Atoi and accepts "+1:00:00Z" and "1.2.3.-0" (jsonschema/3).
+func TestHegelSignedFormatFieldsAreRejected(t *testing.T) {
+	schemas := map[string]*jsonschema.Schema{}
+	models := map[string]func(string) bool{}
+	for _, fc := range formatCases {
+		sch, err := compileDoc(map[string]any{"format": fc.name}, true)
+		if err != nil {
+			t.Fatalf("format %s: %v", fc.name, err)
+		}
+		schemas[fc.name], models[fc.name] = sch, fc.model
+	}
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, signedFieldCases)
+		s := c.text()
+		want := models[c.format](s)
+		err := schemas[c.format].Validate(s)
+		if got := err == nil; got != want {
+			mismatch(ht, known("jsonschema/3"), "format %s: %q valid=%v, grammar says %v (error: %v)", c.format, s, got, want, err)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- jsonschema/4
+
+// encodedNames: a property name with at least one character url.PathEscape
+// percent-encodes, between up to three plain characters on each side (the
+// shape of jsonschema/4: the output's keywordLocation, a JSON pointer, is
+// built from the schema URL's fragment and carries the encoding); under
+// HEGEL_NO_KNOWN=1 plain characters only, which no encoder touches (the
+// pointer's own ~ and / among them).
+var (
+	plainNameChars = "ab0~/-_:@"
+	plainNameText  = hegel.Text().Alphabet(plainNameChars).MaxSize(3)
+	encodedChars   = hegel.Text().Alphabet(" %\"#<>?[]{}|\u00e9").MinSize(1).MaxSize(1)
+	encodedNames   = cat(plainNameText, shaped(encodedChars, hegel.Text().Alphabet(plainNameChars).MinSize(1).MaxSize(1)), plainNameText)
+)
+
+// typesNotOf are the type names a value does not have.
+func typesNotOf(v any) []string {
+	own := jsonType(v)
+	var out []string
+	for _, t := range typeNames {
+		if t != own && !(own == "number" && t == "integer") {
+			out = append(out, t)
+		}
+	}
+	return out
+}
+
+// encodedNameCase: a draft, the name and its place (a properties member, or
+// a patternProperties pattern matching exactly it), a scalar value and a
+// type it does not have (so that {"type": t} under the name fails), and up
+// to two more members.
+type encodedNameCase struct {
+	d       draftInfo
+	name    string
+	pattern bool
+	value   any
+	typ     string
+	extra   map[string]any
+}
+
+func (c encodedNameCase) schema() map[string]any {
+	sub := map[string]any{"type": c.typ}
+	root := map[string]any{"$schema": c.d.url}
+	if c.pattern {
+		root["patternProperties"] = map[string]any{"^" + regexp.QuoteMeta(c.name) + "$": sub}
+	} else {
+		root["properties"] = map[string]any{c.name: sub}
+	}
+	return root
+}
+
+func (c encodedNameCase) instance() map[string]any {
+	obj := map[string]any{}
+	for k, v := range c.extra {
+		obj[k] = v
+	}
+	obj[c.name] = c.value
+	return obj
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c encodedNameCase) GoString() string {
+	return fmt.Sprintf("draft %d schema %s\ninstance %s", c.d.version, jsonText(c.schema()), jsonText(c.instance()))
+}
+
+var encodedNameCases = hegel.FlatMap(hegel.SampledFrom(drafts), func(d draftInfo) hegel.Generator[encodedNameCase] {
+	scalars := valuesOf(d, 0)
+	extras := hegel.Maps(propNames, scalars).MaxSize(2)
+	return hegel.FlatMap(scalars, func(v any) hegel.Generator[encodedNameCase] {
+		types := hegel.SampledFrom(typesNotOf(v))
+		return hegel.Composite(func(tc hegel.TestCase) encodedNameCase {
+			return encodedNameCase{
+				d:       d,
+				name:    hegel.Draw(tc, encodedNames),
+				pattern: hegel.Draw(tc, chance(30)),
+				value:   v,
+				typ:     hegel.Draw(tc, types),
+				extra:   hegel.Draw(tc, extras),
+			}
+		})
+	})
+})
+
+// TestHegelKeywordLocationsUnderEncodedNamesResolve: the keywordLocation of
+// an output unit is a JSON pointer into the schema, so under a property name
+// (or pattern) with a space, a percent sign, a quote or a non-ASCII letter
+// it holds the name itself; the library writes the percent-encoded token of
+// the schema URL's fragment ("/properties/a%20b/type"), which resolves to
+// nothing (jsonschema/4).
+func TestHegelKeywordLocationsUnderEncodedNamesResolve(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, encodedNameCases)
+		root := c.schema()
+		outputsWellFormed(ht, mustCompileDoc(ht, root, "schema"), reparse(root), reparse(c.instance()), c.d, root)
+	})
+}
+
+// --------------------------------------------------------------------------- jsonschema/5 and jsonschema/7
+
+// namedObject: an object of one to three names of a to c, and a
+// propertyNames subschema its names all fail (or, when satisfied, all
+// satisfy): maxLength k against names longer (no longer) than k, a
+// digits-only (letters-only) pattern, an enum of other names (of the names
+// themselves), type integer (string).
+type namedObject struct {
+	kind      int
+	k         int
+	satisfied bool
+	obj       map[string]any
+}
+
+func (n namedObject) subschema() map[string]any {
+	switch n.kind {
+	case 0:
+		return map[string]any{"maxLength": num(fmt.Sprint(n.k))}
+	case 1:
+		if n.satisfied {
+			return map[string]any{"pattern": "^[a-c]+$"}
+		}
+		return map[string]any{"pattern": "^[0-9]+$"}
+	case 2:
+		if n.satisfied {
+			return map[string]any{"enum": anyList(sortedKeys(n.obj))}
+		}
+		return map[string]any{"enum": []any{"x", "y"}}
+	}
+	if n.satisfied {
+		return map[string]any{"type": "string"}
+	}
+	return map[string]any{"type": "integer"}
+}
+
+// namedObjects: k in 1..3, the names longer than k when failing and no
+// longer than k when satisfied, the values scalars of the draft.
+func namedObjects(d draftInfo, satisfied bool) hegel.Generator[namedObject] {
+	return hegel.FlatMap(hegel.Integers(1, 3), func(k int) hegel.Generator[namedObject] {
+		lo, hi := k+1, 4
+		if satisfied {
+			lo, hi = 1, k
+		}
+		names := hegel.Text().Alphabet("abc").MinSize(lo).MaxSize(hi)
+		objs := hegel.Maps(names, valuesOf(d, 0)).MinSize(1).MaxSize(3)
+		return hegel.Composite(func(tc hegel.TestCase) namedObject {
+			return namedObject{kind: hegel.Draw(tc, hegel.Integers(0, 3)), k: k, satisfied: satisfied, obj: hegel.Draw(tc, objs)}
+		})
+	})
+}
+
+// propertyNamesCase: a draft from 6 (propertyNames) and a named object
+// against a root propertyNames its names fail (the shape of jsonschema/5)
+// or, under HEGEL_NO_KNOWN=1, satisfy, with a maxProperties of 0 failing
+// instead.
+type propertyNamesCase struct {
+	d draftInfo
+	n namedObject
+}
+
+func (c propertyNamesCase) schema() map[string]any {
+	root := map[string]any{"$schema": c.d.url, "propertyNames": c.n.subschema()}
+	if c.n.satisfied {
+		root["maxProperties"] = num("0")
+	}
+	return root
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c propertyNamesCase) GoString() string {
+	return fmt.Sprintf("draft %d schema %s\ninstance %s", c.d.version, jsonText(c.schema()), jsonText(c.n.obj))
+}
+
+var propertyNamesCases = hegel.FlatMap(hegel.SampledFrom(drafts[1:]), func(d draftInfo) hegel.Generator[propertyNamesCase] {
+	return hegel.Map(namedObjects(d, noKnown), func(n namedObject) propertyNamesCase { return propertyNamesCase{d, n} })
+})
+
+// TestHegelPropertyNamesFailuresLocateTheKeyword: a propertyNames failure is
+// reported at the propertyNames keyword, so its keywordLocation and
+// absoluteKeywordLocation resolve in the schema; the library reports it at
+// ".../propertyNames/propertyNames" (jsonschema/5).
+func TestHegelPropertyNamesFailuresLocateTheKeyword(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, propertyNamesCases)
+		root := c.schema()
+		outputsWellFormed(ht, mustCompileDoc(ht, root, "schema"), reparse(root), reparse(c.n.obj), c.d, root)
+	})
+}
+
+// aliasedCase: an array whose items' names must satisfy a subschema
+// ({"items": {"propertyNames": ...}}), one object failing it among scalars:
+// by default followed by one to three of them (the shape of jsonschema/7:
+// the failure's instanceLocation shares the validator's path buffer, which
+// the next item overwrites), under HEGEL_NO_KNOWN=1 the last item.
+type aliasedCase struct {
+	d      draftInfo
+	n      namedObject
+	before []any
+	after  []any
+}
+
+func (c aliasedCase) schema() map[string]any {
+	return map[string]any{"$schema": c.d.url, "items": map[string]any{"propertyNames": c.n.subschema()}}
+}
+
+func (c aliasedCase) instance() []any {
+	items := append([]any{}, c.before...)
+	items = append(items, c.n.obj)
+	return append(items, c.after...)
+}
+
+// want is the location of the failing object.
+func (c aliasedCase) want() string { return fmt.Sprintf("/%d", len(c.before)) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c aliasedCase) GoString() string {
+	return fmt.Sprintf("draft %d schema %s\ninstance %s", c.d.version, jsonText(c.schema()), jsonText(c.instance()))
+}
+
+var aliasedCases = hegel.FlatMap(hegel.SampledFrom(drafts[1:]), func(d draftInfo) hegel.Generator[aliasedCase] {
+	scalars := valuesOf(d, 0)
+	objs := namedObjects(d, false)
+	before := hegel.Lists(scalars).MaxSize(3)
+	after := shaped[hegel.Generator[[]any]](hegel.Lists(scalars).MinSize(1).MaxSize(3), hegel.Just([]any(nil)))
+	return hegel.Composite(func(tc hegel.TestCase) aliasedCase {
+		return aliasedCase{d: d, n: hegel.Draw(tc, objs), before: hegel.Draw(tc, before), after: hegel.Draw(tc, after)}
+	})
+})
+
+// propertyNamesUnits are the units of a basic output reporting a
+// propertyNames failure (the flat output carries the kind of every unit).
+func propertyNamesUnits(out *jsonschema.OutputUnit) []jsonschema.OutputUnit {
+	var units []jsonschema.OutputUnit
+	for i := range out.Errors {
+		if propertyNamesOf(&out.Errors[i]) != nil {
+			units = append(units, out.Errors[i])
+		}
+	}
+	return units
+}
+
+// TestHegelPropertyNamesFailuresLocateTheObject: the instanceLocation of a
+// propertyNames failure is the location of the object whose name failed,
+// whatever is validated after it; the library reports the location of the
+// last item validated at that depth (jsonschema/7).
+func TestHegelPropertyNamesFailuresLocateTheObject(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, aliasedCases)
+		root := c.schema()
+		sch := mustCompileDoc(ht, root, "schema")
+		inst := reparse(c.instance())
+		err := sch.Validate(inst)
+		if err == nil {
+			ht.Fatalf("instance unexpectedly valid\ninstance %s\nschema %s", jsonText(inst), jsonText(root))
+		}
+		units := propertyNamesUnits(err.(*jsonschema.ValidationError).BasicOutput())
+		if len(units) == 0 {
+			ht.Fatalf("no propertyNames unit in the output of: %v", err)
+		}
+		for _, u := range units {
+			if u.InstanceLocation != c.want() {
+				mismatch(ht, known("jsonschema/7"), "propertyNames failure on %q reported at instanceLocation %q, the object is at %q\ninstance %s\nschema %s",
+					propertyNamesOf(&u).Property, u.InstanceLocation, c.want(), jsonText(inst), jsonText(root))
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- jsonschema/6
+
+// dependencyCase: drafts 4 to 7, a dependencies entry for a property naming
+// one to three others (the array form: the shape of jsonschema/6, reported
+// at "/dependency/<prop>"; under HEGEL_NO_KNOWN=1 the schema form
+// {"required": [...]}) and an object holding the property and all but one
+// of the others.
+type dependencyCase struct {
+	d    draftInfo
+	prop string
+	deps []string
+	obj  map[string]any
+}
+
+func (c dependencyCase) schema() map[string]any {
+	var dep any = anyList(c.deps)
+	if noKnown {
+		dep = map[string]any{"required": anyList(c.deps)}
+	}
+	return map[string]any{"$schema": c.d.url, "dependencies": map[string]any{c.prop: dep}}
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c dependencyCase) GoString() string {
+	return fmt.Sprintf("draft %d schema %s\ninstance %s", c.d.version, jsonText(c.schema()), jsonText(c.obj))
+}
+
+var dependencyCases = hegel.FlatMap(hegel.SampledFrom(drafts[:3]), func(d draftInfo) hegel.Generator[dependencyCase] {
+	scalars := valuesOf(d, 0)
+	return hegel.FlatMap(propNames, func(prop string) hegel.Generator[dependencyCase] {
+		others := hegel.Lists(hegel.SampledFrom(without(propNamePool, prop))).MinSize(1).MaxSize(3)
+		return hegel.Composite(func(tc hegel.TestCase) dependencyCase {
+			deps := distinct(hegel.Draw(tc, others))
+			missing := hegel.Draw(tc, hegel.Integers(0, 2)) % len(deps)
+			obj := map[string]any{prop: hegel.Draw(tc, scalars)}
+			for i, dep := range deps {
+				if i != missing && hegel.Draw(tc, chance(50)) {
+					obj[dep] = hegel.Draw(tc, scalars)
+				}
+			}
+			return dependencyCase{d: d, prop: prop, deps: deps, obj: obj}
+		})
+	})
+})
+
+// TestHegelDependenciesFailuresLocateTheKeyword: a dependencies failure is
+// reported under the dependencies keyword ("/dependencies/<prop>"), where
+// its keywordLocation resolves; the library reports "/dependency/<prop>",
+// a keyword that does not exist (jsonschema/6).
+func TestHegelDependenciesFailuresLocateTheKeyword(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, dependencyCases)
+		root := c.schema()
+		outputsWellFormed(ht, mustCompileDoc(ht, root, "schema"), reparse(root), reparse(c.obj), c.d, root)
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..bfe2a53
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,302 @@
+package jsonschema_test
+
+// Hegel properties for github.com/santhosh-tekuri/jsonschema/v6: random
+// schemas in drafts 4, 6, 7, 2019-09 and 2020-12 validated against Python's
+// `jsonschema` package (validation results and schema checking), plus
+// library-internal identities: reference transparency, well-formed output
+// units, exact-number semantics and the format validators against models
+// of their RFCs.
+//
+// A case is drawn as data: each property draws one record (a draft, a
+// schema tree rendered into a document, the instances validated against it;
+// a wrapping of a schema; the numeric keywords and probes of an exact
+// arithmetic check; a format and a string) built from the binding's
+// combinators, and pure functions turn the record into the documents the
+// library and the oracle read.
+//
+// Needs python3 with the `jsonschema` package (4.x) on PATH.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn by default and the
+// properties that meet them fail, naming the shape; hegel_shapes_test.go has
+// one property per bug over its shape region alone, and hegel_pins_test.go
+// the regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below) for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so
+// HEGEL_TEST_CASES (and HEGEL_VERBOSE) are passed through hegelOpts; a panic
+// in the code under test is turned into a failure of the current test case
+// by property().
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// gates are the switches of Known by bug id.
+var gates = map[string]bool{
+	"jsonschema/1": Known.refSiblingConst,
+	"jsonschema/2": Known.bigIntegerKeywords,
+	"jsonschema/3": Known.signedFormatFields,
+	"jsonschema/4": Known.keywordLocationEncoded,
+	"jsonschema/5": Known.propertyNamesLocationDoubled,
+	"jsonschema/6": Known.dependencyKeywordPath,
+	"jsonschema/7": Known.propertyNamesLocationAliased,
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the
+// shape of the recorded bugs named (none for a plain failure): the failure
+// names the shape, and while every gate of the shape is on (HEGEL_NO_KNOWN=1)
+// a disagreement on it is skipped instead (rare then, since the generators
+// leave the shapes out).
+func mismatch(ht *hegel.T, shape []string, format string, args ...any) {
+	if len(shape) > 0 {
+		gated := true
+		for _, id := range shape {
+			gated = gated && gates[id]
+		}
+		ht.Assume(!gated)
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	ht.Fatalf(format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing
+// under HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// ptrs: pointers to the values of g.
+func ptrs[T any](g hegel.Generator[T]) hegel.Generator[*T] { return hegel.Map(g, ptrTo[T]) }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value, such as a JSON null, is a
+// value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, ptrs(g))
+}
+
+// asAny widens a generator's values to any.
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(v T) any { return v })
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// fixed is a list of exactly k elements.
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(k).MaxSize(k)
+}
+
+// cat draws one string from each generator and joins them: the pieces of a
+// token.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// dec is the decimal text of an integer generator.
+func dec(g hegel.Generator[int]) hegel.Generator[string] {
+	return hegel.Map(g, func(x int) string { return fmt.Sprint(x) })
+}
+
+// padded is the decimal text of an integer generator, zero-padded to width.
+func padded(width int, g hegel.Generator[int]) hegel.Generator[string] {
+	return hegel.Map(g, func(x int) string { return fmt.Sprintf("%0*d", width, x) })
+}
+
+// deferred draws through a pointer to a generator, so that a recursive
+// grammar can name a generator before it is built (the forward declaration
+// of hegel-go's ExampleComposite_recursive).
+func deferred[T any](g *hegel.Generator[T]) hegel.Generator[T] {
+	return hegel.Composite(func(tc hegel.TestCase) T { return hegel.Draw(tc, *g) })
+}
+
+// distinct drops the repeats of a list, keeping the first occurrences.
+func distinct[T comparable](xs []T) []T {
+	seen := map[T]bool{}
+	var out []T
+	for _, x := range xs {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// without is the list less the value.
+func without[T comparable](xs []T, x T) []T {
+	var out []T
+	for _, y := range xs {
+		if y != x {
+			out = append(out, y)
+		}
+	}
+	return out
+}
+
+// nonNilMap makes an empty map a non-nil one (hegel-go's Maps yields nil for
+// zero elements, whose JSON text would be null).
+func nonNilMap(m map[string]any) map[string]any {
+	if m == nil {
+		return map[string]any{}
+	}
+	return m
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape; under HEGEL_NO_KNOWN=1 the gates of
+// Known are on: the shapes are left out of the generators (shaped, the
+// per-draft pools) and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); on means
+// the shape is left out, which is so only under HEGEL_NO_KNOWN=1. The pin
+// tests in hegel_pins_test.go assert the correct behaviour and fail while a
+// bug is open, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	refSiblingConst    bool // jsonschema/1: in drafts 6 and 7 a const beside $ref is enforced although every sibling of $ref must be ignored
+	signedFormatFields bool // jsonschema/3: format fields parsed with strconv.Atoi accept a sign: "+1:00:00Z" (time), "1.2.3.-0" (ipv4)
+
+	bigIntegerKeywords bool // jsonschema/2: minLength/maxLength/minItems/maxItems/minProperties/maxProperties beyond int64 wrap around (maxLength: 1e19 rejects every string)
+
+	keywordLocationEncoded       bool // jsonschema/4: the output units' keywordLocation (a JSON pointer) carries the percent-encoding of the schema URL fragment
+	propertyNamesLocationDoubled bool // jsonschema/5: a propertyNames failure reports keywordLocation ".../propertyNames/propertyNames"
+	dependencyKeywordPath        bool // jsonschema/6: a dependencies failure reports keywordLocation ".../dependency/<prop>"
+	propertyNamesLocationAliased bool // jsonschema/7: a propertyNames failure's instanceLocation shares the validator's path buffer and is overwritten by later validation
+}{
+	refSiblingConst:              noKnown,
+	signedFormatFields:           noKnown,
+	bigIntegerKeywords:           noKnown,
+	keywordLocationEncoded:       noKnown,
+	propertyNamesLocationDoubled: noKnown,
+	dependencyKeywordPath:        noKnown,
+	propertyNamesLocationAliased: noKnown,
+}
