+
+// ---------------------------------------------------------------------------
+// Output units.
+
+func unescapeToken(tok string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(tok, "~1", "/"), "~0", "~")
+}
+
+// lookupPointer follows a JSON pointer in a value.
+func lookupPointer(v any, ptr string) (any, bool) {
+	if ptr == "" {
+		return v, true
+	}
+	if !strings.HasPrefix(ptr, "/") {
+		return nil, false
+	}
+	for _, tok := range strings.Split(ptr[1:], "/") {
+		tok = unescapeToken(tok)
+		switch cur := v.(type) {
+		case map[string]any:
+			x, ok := cur[tok]
+			if !ok {
+				return nil, false
+			}
+			v = x
+		case []any:
+			i, err := strconv.Atoi(tok)
+			if err != nil || i < 0 || i >= len(cur) || (len(tok) > 1 && tok[0] == '0') {
+				return nil, false
+			}
+			v = cur[i]
+		default:
+			return nil, false
+		}
+	}
+	return v, true
+}
+
+// findAnchor locates the subschema declaring a plain-name anchor in a
+// single-resource document.
+func findAnchor(doc any, anchor string, d draftInfo) (any, bool) {
+	var found any
+	var walk func(v any) bool
+	walk = func(v any) bool {
+		switch v := v.(type) {
+		case map[string]any:
+			if d.version >= 2019 {
+				if v["$anchor"] == anchor || v["$dynamicAnchor"] == anchor {
+					found = v
+					return true
+				}
+			} else if _, hasRef := v["$ref"]; !hasRef && v[d.idKw] == "#"+anchor {
+				found = v
+				return true
+			}
+			for _, k := range sortedKeys(v) {
+				if walk(v[k]) {
+					return true
+				}
+			}
+		case []any:
+			for _, x := range v {
+				if walk(x) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	if walk(doc) {
+		return found, true
+	}
+	return nil, false
+}
+
+// resolveKeywordLocation follows a keywordLocation (a JSON pointer whose
+// $ref-family tokens jump to the referenced schema) in a single-resource
+// document, returning the value it lands on.
+func resolveKeywordLocation(doc any, loc string, d draftInfo) (any, error) {
+	if loc == "" {
+		return doc, nil
+	}
+	if !strings.HasPrefix(loc, "/") {
+		return nil, fmt.Errorf("not a pointer")
+	}
+	cur := doc
+	nameNext := false // the previous token was a keyword whose members are named/indexed subschemas
+	for _, tok := range strings.Split(loc[1:], "/") {
+		tok = unescapeToken(tok)
+		obj, isObj := cur.(map[string]any)
+		isName := nameNext
+		nameNext = false
+		if !isName {
+			switch tok {
+			case "properties", "patternProperties", "$defs", "definitions", "dependentSchemas", "dependencies":
+				nameNext = true // the next token is a property name, whatever it looks like
+			}
+		}
+		switch {
+		case !isName && (tok == "$ref" || tok == "$dynamicRef" || tok == "$recursiveRef"):
+			if !isObj {
+				return nil, fmt.Errorf("%s on a non-object", tok)
+			}
+			ref, ok := obj[tok].(string)
+			if !ok {
+				return nil, fmt.Errorf("no %s here", tok)
+			}
+			target, err := resolveRef(doc, ref, d)
+			if err != nil {
+				return nil, err
+			}
+			cur = target
+		default:
+			switch c := cur.(type) {
+			case map[string]any:
+				x, ok := c[tok]
+				if !ok {
+					return nil, fmt.Errorf("no member %q", tok)
+				}
+				cur = x
+			case []any:
+				i, err := strconv.Atoi(tok)
+				if err != nil || i < 0 || i >= len(c) {
+					return nil, fmt.Errorf("bad index %q", tok)
+				}
+				cur = c[i]
+			default:
+				return nil, fmt.Errorf("cannot descend %q into a scalar", tok)
+			}
+		}
+	}
+	return cur, nil
+}
+
+func resolveRef(doc any, ref string, d draftInfo) (any, error) {
+	if !strings.HasPrefix(ref, "#") {
+		return nil, fmt.Errorf("non-local reference %q", ref)
+	}
+	frag, err := url.PathUnescape(ref[1:])
+	if err != nil {
+		return nil, err
+	}
+	if frag == "" || strings.HasPrefix(frag, "/") {
+		v, ok := lookupPointer(doc, frag)
+		if !ok {
+			return nil, fmt.Errorf("pointer %q not found", frag)
+		}
+		return v, nil
+	}
+	v, ok := findAnchor(doc, frag, d)
+	if !ok {
+		return nil, fmt.Errorf("anchor %q not found", frag)
+	}
+	return v, nil
+}
+
+// propertyNamesOf is the propertyNames failure a unit reports (the flat basic
+// output carries the kind of every unit, the detailed one of its leaves),
+// nil for another kind or none.
+func propertyNamesOf(u *jsonschema.OutputUnit) *kind.PropertyNames {
+	if u.Error == nil {
+		return nil
+	}
+	pn, _ := u.Error.Kind.(*kind.PropertyNames)
+	return pn
+}
+
+// holdsName reports whether the value is an object with the name.
+func holdsName(v any, name string) bool {
+	obj, ok := v.(map[string]any)
+	if !ok {
+		return false
+	}
+	_, has := obj[name]
+	return has
+}
+
+// repaired is a location with the corrections the recorded output bugs call
+// for, applied in turn: its percent-encoding decoded (jsonschema/4; for a
+// keywordLocation only, the absolute one is a URI), a doubled propertyNames
+// token dropped (jsonschema/5), dependency read as dependencies
+// (jsonschema/6); and the ids of the corrections that changed it. A location
+// that resolves only once repaired has the shape of those bugs.
+func repaired(loc string, encoded bool) (string, []string) {
+	var shape []string
+	if dec, err := url.PathUnescape(loc); encoded && err == nil && dec != loc {
+		loc, shape = dec, append(shape, "jsonschema/4")
+	}
+	if strings.HasSuffix(loc, "/propertyNames/propertyNames") {
+		loc, shape = strings.TrimSuffix(loc, "/propertyNames"), append(shape, "jsonschema/5")
+	}
+	if strings.Contains(loc, "/dependency/") {
+		loc, shape = strings.ReplaceAll(loc, "/dependency/", "/dependencies/"), append(shape, "jsonschema/6")
+	}
+	return loc, shape
+}
+
+// checkUnit checks that a unit of a failing output is well formed: invalid,
+// its instanceLocation resolving in the instance (for a propertyNames
+// failure, to the object holding the failing name: the failure is about that
+// name), its keywordLocation (with the $ref jumps followed) and its
+// absoluteKeywordLocation resolving in the schema as written, an error on
+// every leaf; and so its errors. With the error it returns the recorded bugs
+// whose shape the unit has (none for a plain failure): an instanceLocation
+// of a propertyNames failure that is not that object (jsonschema/7, the
+// location shares the validator's path buffer), a location that resolves
+// only once repaired (jsonschema/4, /5, /6).
+func checkUnit(u *jsonschema.OutputUnit, doc any, inst any, d draftInfo, path string) ([]string, error) {
+	if u.Valid {
+		return nil, fmt.Errorf("%s: valid=true in a failing output", path)
+	}
+	pn := propertyNamesOf(u)
+	at, ok := lookupPointer(inst, u.InstanceLocation)
+	if !ok {
+		return shapeIf(pn != nil, "jsonschema/7"), fmt.Errorf("%s: instanceLocation %q does not resolve in the instance", path, u.InstanceLocation)
+	}
+	if pn != nil && !holdsName(at, pn.Property) {
+		return []string{"jsonschema/7"}, fmt.Errorf("%s: instanceLocation %q of the failure on property name %q is not the object holding that name", path, u.InstanceLocation, pn.Property)
+	}
+	if _, err := resolveKeywordLocation(doc, u.KeywordLocation, d); err != nil {
+		fixed, shape := repaired(u.KeywordLocation, true)
+		if _, err := resolveKeywordLocation(doc, fixed, d); err != nil {
+			shape = nil
+		}
+		return shape, fmt.Errorf("%s: keywordLocation %q does not resolve in the schema: %v", path, u.KeywordLocation, err)
+	}
+	if u.AbsoluteKeywordLocation != "" {
+		i := strings.Index(u.AbsoluteKeywordLocation, "#")
+		if i < 0 {
+			return nil, fmt.Errorf("%s: absoluteKeywordLocation %q has no fragment", path, u.AbsoluteKeywordLocation)
+		}
+		frag, err := url.PathUnescape(u.AbsoluteKeywordLocation[i+1:])
+		if err != nil {
+			return nil, fmt.Errorf("%s: absoluteKeywordLocation %q: %v", path, u.AbsoluteKeywordLocation, err)
+		}
+		if _, ok := lookupPointer(doc, frag); !ok {
+			fixed, shape := repaired(frag, false)
+			if _, ok := lookupPointer(doc, fixed); !ok {
+				shape = nil
+			}
+			return shape, fmt.Errorf("%s: absoluteKeywordLocation %q does not resolve in the schema", path, u.AbsoluteKeywordLocation)
+		}
+	}
+	if u.Error == nil && len(u.Errors) == 0 {
+		return nil, fmt.Errorf("%s: unit with neither error nor errors", path)
+	}
+	for i := range u.Errors {
+		if shape, err := checkUnit(&u.Errors[i], doc, inst, d, fmt.Sprintf("%s/errors/%d", path, i)); err != nil {
+			return shape, err
+		}
+	}
+	return nil, nil
+}
+
+// outputsWellFormed validates the instance, which must fail, and judges the
+// basic and detailed outputs unit by unit: a unit that is not well formed is
+// a mismatch with the shape checkUnit names.
+func outputsWellFormed(ht *hegel.T, sch *jsonschema.Schema, doc any, inst any, d draftInfo, root map[string]any) {
+	err := sch.Validate(inst)
+	if err == nil {
+		return
+	}
+	verr, ok := err.(*jsonschema.ValidationError)
+	if !ok {
+		ht.Fatalf("Validate returned a %T: %v", err, err)
+	}
+	if verr.FlagOutput().Valid {
+		ht.Fatalf("FlagOutput valid for a failing validation")
+	}
+	if verr.Error() == "" || verr.GoString() == "" {
+		ht.Fatalf("empty error text")
+	}
+	for _, format := range []string{"basic", "detailed"} {
+		var out *jsonschema.OutputUnit
+		if format == "basic" {
+			out = verr.BasicOutput()
+		} else {
+			out = verr.DetailedOutput()
+		}
+		if _, err := json.Marshal(out); err != nil {
+			ht.Fatalf("%s output does not marshal: %v", format, err)
+		}
+		if shape, err := checkUnit(out, doc, inst, d, format); err != nil {
+			b, _ := json.MarshalIndent(out, "", " ")
+			mismatch(ht, shape, "draft %d: %v\ninstance %s\nschema %s\noutput %s", d.version, err, jsonText(inst), jsonText(root), b)
+		}
+	}
+}
+
+// outputCases: single-resource schemas (no embedded ids, whose locations
+// the checks do not follow) with references and the unevaluated keywords.
+var outputCases = pyCases(outputOpts)
+
+// TestHegelOutputsAreWellFormed: for a failing validation, the flag, basic
