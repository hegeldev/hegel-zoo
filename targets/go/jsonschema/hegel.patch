+package jsonschema_test
+
+// The Python `jsonschema` oracle: one python3 process per property, fed
+// JSON lines {schema, instances} and answering {schema_ok, results, ...}.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const oracleScript = `
+import sys, json
+import jsonschema
+from jsonschema import validators
+
+def main():
+    sys.stdout.write(json.dumps({"hello": True, "version": jsonschema.__version__, "python": sys.version.split()[0]}) + "\n")
+    sys.stdout.flush()
+    for line in sys.stdin:
+        req = json.loads(line)
+        out = {}
+        try:
+            schema = json.loads(req["schema"])
+            cls = validators.validator_for(schema, default=validators.Draft202012Validator)
+            out["draft"] = cls.__name__
+            try:
+                try:
+                    cls.check_schema(schema, format_checker=cls.FORMAT_CHECKER)
+                except TypeError:
+                    cls.check_schema(schema)
+                out["schema_ok"] = True
+            except jsonschema.SchemaError as e:
+                out["schema_ok"] = False
+                out["schema_err"] = str(e).splitlines()[0][:200]
+            if out["schema_ok"]:
+                v = cls(schema)
+                res = []
+                for t in req.get("instances", []):
+                    inst = json.loads(t)
+                    try:
+                        res.append(v.is_valid(inst))
+                    except RecursionError:
+                        res.append(None)
+                        out["exc"] = "RecursionError"
+                    except Exception as e:
+                        res.append(None)
+                        out["exc"] = type(e).__name__ + ": " + str(e)[:200]
+                out["results"] = res
+        except Exception as e:
+            out["fatal"] = repr(e)[:300]
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+main()
+`
+
+type oracleReply struct {
+	Draft     string  `json:"draft"`
+	SchemaOK  bool    `json:"schema_ok"`
+	SchemaErr string  `json:"schema_err"`
+	Results   []*bool `json:"results"`
+	Exc       string  `json:"exc"`
+	Fatal     string  `json:"fatal"`
+}
+
+type oracle struct {
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+func startOracle(t *testing.T) *oracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	if err := os.WriteFile(script, []byte(oracleScript), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &oracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<20)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	// handshake: the oracle's version decides what it can judge (referencing,
+	// $recursiveRef and $dynamicRef need 4.18; the properties are calibrated
+	// against 4.26)
+	hello, err := o.out.ReadString('\n')
+	if err != nil {
+		t.Fatalf("python jsonschema oracle did not start: %v", err)
+	}
+	var h struct {
+		Version string `json:"version"`
+		Python  string `json:"python"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(hello)), &h); err != nil {
+		t.Fatalf("bad oracle greeting %q: %v", hello, err)
+	}
+	t.Logf("oracle: python %s jsonschema %s", h.Python, h.Version)
+	if major, minor := versionParts(h.Version); major < 4 || (major == 4 && minor < 18) {
+		t.Fatalf("python jsonschema %s is too old for the oracle (need 4.18+, tests calibrated against 4.26)", h.Version)
+	}
+	// smoke test
+	r, err := o.ask(`{"type":"string"}`, []string{`"a"`, `1`})
+	if err != nil || !r.SchemaOK || len(r.Results) != 2 || r.Results[0] == nil || !*r.Results[0] || r.Results[1] == nil || *r.Results[1] {
+		t.Fatalf("python jsonschema oracle not working: %+v %v", r, err)
+	}
+	return o
+}
+
+func (o *oracle) ask(schema string, instances []string) (*oracleReply, error) {
+	req, _ := json.Marshal(map[string]any{"schema": schema, "instances": instances})
+	if _, err := o.in.Write(append(req, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	line, err := o.out.ReadString('\n')
+	if err != nil {
+		return nil, fmt.Errorf("reading oracle reply: %v", err)
+	}
+	var r oracleReply
+	if err := json.Unmarshal([]byte(strings.TrimSpace(line)), &r); err != nil {
+		return nil, fmt.Errorf("bad oracle reply %q: %v", line, err)
+	}
+	if r.Fatal != "" {
+		return nil, fmt.Errorf("oracle: %s", r.Fatal)
+	}
+	return &r, nil
+}
+
+func versionParts(v string) (int, int) {
+	var major, minor int
+	fmt.Sscanf(v, "%d.%d", &major, &minor)
+	return major, minor
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..b76061e
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,168 @@
+package jsonschema_test
+
+// Deterministic pins for the bugs in bugs.toml. Each asserts the correct
+// behaviour and fails while the bug exists ([expected_failures] in target.toml).
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/santhosh-tekuri/jsonschema/v6"
+)
+
+func mustCompile(t *testing.T, schema string, assertFormat bool) *jsonschema.Schema {
+	t.Helper()
+	doc, err := jsonschema.UnmarshalJSON(strings.NewReader(schema))
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := jsonschema.NewCompiler()
+	if assertFormat {
+		c.AssertFormat()
+	}
+	if err := c.AddResource("http://example.com/s.json", doc); err != nil {
+		t.Fatal(err)
+	}
+	sch, err := c.Compile("http://example.com/s.json")
+	if err != nil {
+		t.Fatalf("compile %s: %v", schema, err)
+	}
+	return sch
+}
+
+func mustValue(t *testing.T, text string) any {
+	t.Helper()
+	v, err := jsonschema.UnmarshalJSON(strings.NewReader(text))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+
+// jsonschema/1: up to draft 7 every sibling of $ref must be ignored; const is
+// not (type and enum are).
+func TestHegelPinRefSiblingConstIsIgnored(t *testing.T) {
+	for _, draft := range []string{"http://json-schema.org/draft-06/schema#", "http://json-schema.org/draft-07/schema#"} {
+		sch := mustCompile(t, `{"$schema":"`+draft+`","$ref":"#/definitions/a","const":5,"definitions":{"a":true}}`, false)
+		if err := sch.Validate(mustValue(t, `6`)); err != nil {
+			t.Errorf("%s: const beside $ref was enforced: %v", draft, err)
+		}
+	}
+}
+
+// jsonschema/2: integer keywords beyond int64 wrap around.
+func TestHegelPinIntegerKeywordsBeyondInt64(t *testing.T) {
+	cases := []struct {
+		schema, inst string
+		valid        bool
+	}{
+		{`{"maxLength":1e19}`, `"a"`, true},
+		{`{"maxLength":18446744073709551616}`, `"a"`, true},
+		{`{"maxItems":9223372036854775808}`, `[1]`, true},
+		{`{"maxProperties":9223372036854775808}`, `{"a":1}`, true},
+		{`{"minItems":9223372036854775808}`, `[1]`, false},
+		{`{"minLength":1e19}`, `"a"`, false},
+	}
+	for _, c := range cases {
+		sch := mustCompile(t, c.schema, false)
+		err := sch.Validate(mustValue(t, c.inst))
+		if (err == nil) != c.valid {
+			t.Errorf("%s on %s: valid=%v, want %v (%v)", c.schema, c.inst, err == nil, c.valid, err)
+		}
+	}
+}
+
+// jsonschema/3: format fields accept a sign.
+func TestHegelPinFormatFieldsRejectSigns(t *testing.T) {
+	cases := []struct{ format, inst string }{
+		{"time", `"+1:00:00Z"`},
+		{"time", `"12:00:00-+1:30"`},
+		{"date-time", `"2020-01-01T+1:00:00Z"`},
+		{"ipv4", `"1.2.3.-0"`},
+		{"ipv4", `"1.2.3.+4"`},
+		{"ipv4", `"+1.2.3.4"`},
+	}
+	for _, c := range cases {
+		sch := mustCompile(t, `{"format":"`+c.format+`"}`, true)
+		if err := sch.Validate(mustValue(t, c.inst)); err == nil {
+			t.Errorf("format %s accepts %s", c.format, c.inst)
+		}
+	}
+}
+
+func basicLocations(t *testing.T, sch *jsonschema.Schema, inst string) []string {
+	t.Helper()
+	err := sch.Validate(mustValue(t, inst))
+	if err == nil {
+		t.Fatalf("%s unexpectedly valid", inst)
+	}
+	verr, ok := err.(*jsonschema.ValidationError)
+	if !ok {
+		t.Fatalf("%T", err)
+	}
+	var locs []string
+	for _, u := range verr.BasicOutput().Errors {
+		locs = append(locs, u.KeywordLocation)
+	}
+	return locs
+}
+
+// jsonschema/4: keywordLocation is a JSON pointer, not a percent-encoded URI fragment.
+func TestHegelPinKeywordLocationIsAJSONPointer(t *testing.T) {
+	sch := mustCompile(t, `{"properties":{"a b":{"type":"string"},"c%d":{"type":"string"}}}`, false)
+	locs := basicLocations(t, sch, `{"a b":1,"c%d":2}`)
+	want := map[string]bool{"/properties/a b/type": true, "/properties/c%d/type": true}
+	for _, loc := range locs {
+		if !want[loc] {
+			b, _ := json.Marshal(locs)
+			t.Fatalf("keywordLocations %s, want /properties/a b/type and /properties/c%%d/type", b)
+		}
+	}
+	if len(locs) != 2 {
+		t.Fatalf("got %d units, want 2", len(locs))
+	}
+}
+
+// jsonschema/5: a propertyNames failure is reported at ".../propertyNames", not ".../propertyNames/propertyNames".
+func TestHegelPinPropertyNamesLocation(t *testing.T) {
+	sch := mustCompile(t, `{"propertyNames":{"maxLength":1}}`, false)
+	locs := basicLocations(t, sch, `{"ab":1}`)
+	for _, loc := range locs {
+		if strings.Contains(loc, "/propertyNames/propertyNames") {
+			t.Fatalf("keywordLocation %q doubles the keyword", loc)
+		}
+	}
+}
+
+// jsonschema/6: a dependencies failure is reported under "/dependencies/<prop>".
+func TestHegelPinDependenciesLocation(t *testing.T) {
+	sch := mustCompile(t, `{"$schema":"http://json-schema.org/draft-07/schema#","dependencies":{"a":["b"]}}`, false)
+	locs := basicLocations(t, sch, `{"a":1}`)
+	if len(locs) != 1 || locs[0] != "/dependencies/a" {
+		t.Fatalf("keywordLocations %v, want [/dependencies/a]", locs)
+	}
+}
+
+// jsonschema/7: the instanceLocation of a propertyNames failure is the
+// location of the object whose property name failed, not of whatever the
+// validator visited afterwards.
+func TestHegelPinPropertyNamesInstanceLocation(t *testing.T) {
+	// array items are visited in order, so the element after the failing one
+	// always overwrites the recorded location while the bug exists
+	sch := mustCompile(t, `{"items":{"propertyNames":{"maxLength":1}}}`, false)
+	err := sch.Validate(mustValue(t, `[{"xx":1},{},{}]`))
+	if err == nil {
+		t.Fatal("unexpectedly valid")
+	}
+	verr := err.(*jsonschema.ValidationError)
+	for _, u := range verr.BasicOutput().Errors {
+		if strings.Contains(u.KeywordLocation, "propertyNames") && !strings.Contains(u.KeywordLocation, "maxLength") {
+			if u.InstanceLocation != "/0" {
+				t.Fatalf("propertyNames failure reported at %q, want /0 (%v)", u.InstanceLocation, err)
+			}
+			return
+		}
+	}
+	t.Fatalf("no propertyNames unit in %v", err)
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..36253ae
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,181 @@
+package jsonschema_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"strings"
+
+	"testing"
+
+	"github.com/santhosh-tekuri/jsonschema/v6"
+	"hegel.dev/go/hegel"
+)
+
+// compileDoc compiles a schema document (as produced by the generator) under
+// the root URL "root.json".
+func compileDoc(doc any, assertFormat bool) (*jsonschema.Schema, error) {
+	c := jsonschema.NewCompiler()
+	if assertFormat {
+		c.AssertFormat()
+	}
+	if err := c.AddResource("root.json", doc); err != nil {
+		return nil, err
+	}
+	return c.Compile("root.json")
+}
+
+// reparse round-trips a value through its JSON text so that the library sees
+// exactly what the oracle sees.
+func reparse(v any) any {
+	out, err := jsonschema.UnmarshalJSON(strings.NewReader(jsonText(v)))
+	if err != nil {
+		panic(err)
+	}
+	return out
+}
+
+// validationCases: every feature of the drafts: references, embedded ids,
+// the unevaluated keywords, siblings of $ref.
+var validationCases = pyCases(fullOpts)
+
+var (
+	countKeywordNames = []string{"minLength", "maxLength", "minItems", "maxItems", "minProperties", "maxProperties"}
+	maxInt64          = big.NewRat(math.MaxInt64, 1)
+)
+
+// beyondInt64 reports a keyword value above 2^63-1 (the shape of
+// jsonschema/2: the library wraps it around).
+func beyondInt64(v any) bool {
+	n, ok := v.(json.Number)
+	if !ok {
+		return false
+	}
+	r, ok := new(big.Rat).SetString(string(n))
+	return ok && r.Cmp(maxInt64) > 0
+}
+
+// schemaShapes names the recorded bugs whose shape a rendered schema of the
+// draft has, from its object nodes: a const beside $ref in drafts 6 and 7
+// (jsonschema/1), a count keyword beyond int64 (jsonschema/2). Under
+// HEGEL_NO_KNOWN=1 the generators draw neither.
+func schemaShapes(root map[string]any, d draftInfo) []string {
+	var refConst, bigCount bool
+	for _, n := range objectNodes(root) {
+		if _, isRef := n["$ref"].(string); isRef {
+			if _, hasConst := n["const"]; hasConst && d.version >= 6 && d.version < 2019 {
+				refConst = true
+			}
+		}
+		for _, kw := range countKeywordNames {
+			if beyondInt64(n[kw]) {
+				bigCount = true
+			}
+		}
+	}
+	return append(shapeIf(refConst, "jsonschema/1"), shapeIf(bigCount, "jsonschema/2")...)
+}
+
+// TestHegelValidationMatchesPython: a random schema in a random draft and a
+// handful of instances validate the same way in this library and in Python's
+// jsonschema.
+func TestHegelValidationMatchesPython(t *testing.T) {
+	py := startOracle(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, validationCases)
+		d, root, insts := tcase.d, tcase.root, tcase.insts
+		schemaText := jsonText(root)
+		texts := instTexts(insts)
+
+		reply, err := py.ask(schemaText, texts)
+		if err != nil {
+			ht.Fatalf("oracle failure: %v\nschema %s", err, schemaText)
+		}
+		sch, cerr := compileDoc(reparse(root), false)
+		if !reply.SchemaOK {
+			ht.Fatalf("generator produced a schema python rejects (%s): %s", reply.SchemaErr, schemaText)
+		}
+		if cerr != nil {
+			ht.Fatalf("Compile rejects a schema python accepts: %v\nschema %s", cerr, schemaText)
+		}
+		// python could not evaluate it (deep recursion): nothing to compare
+		ht.Assume(!strings.HasPrefix(reply.Exc, "RecursionError"))
+		for i, in := range insts {
+			want := reply.Results[i]
+			if want == nil {
+				// Python's jsonschema itself fails on some legacy-anchor schemas
+				// (AttributeError while resolving a draft-6 "$id": "#a"); nothing to compare.
+				note(ht, "python raised %s on instance %s", reply.Exc, texts[i])
+				continue
+			}
+			verr := sch.Validate(reparse(in))
+			got := verr == nil
+			if got != *want {
+				mismatch(ht, schemaShapes(root, d), "draft %d: Validate valid=%v, python valid=%v\ninstance %s\nschema %s\nerror: %v", d.version, got, *want, texts[i], schemaText, verr)
+			}
+		}
+	})
+}
+
+// checkCase: a schema with its instances, damaged in one place 75% of the
+// time.
+type checkCase struct {
+	pyCase
+	mut *mutation
+}
+
+// damaged is the schema after the mutation, with a description of the change.
+func (c checkCase) damaged() (map[string]any, string) {
+	root := deepCopy(c.root).(map[string]any)
+	what := "unchanged"
+	if c.mut != nil {
+		what = c.mut.apply(root, c.d)
+	}
+	return root, what
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c checkCase) GoString() string {
+	root, what := c.damaged()
+	return fmt.Sprintf("draft %d mutation %q schema %s\ninstances %s", c.d.version, what, jsonText(root), strings.Join(instTexts(c.insts), " "))
+}
+
+var checkCases = hegel.FlatMap(pyCases(fullOpts), func(c pyCase) hegel.Generator[checkCase] {
+	return hegel.Map(optional(75, mutations), func(m *mutation) checkCase { return checkCase{c, m} })
+})
+
+// TestHegelSchemaCheckMatchesPython: a random schema, sometimes damaged in
+// one place, is accepted by Compile exactly when Python's check_schema
+// accepts it (and its references resolve).
+func TestHegelSchemaCheckMatchesPython(t *testing.T) {
+	py := startOracle(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, checkCases)
+		d := tcase.d
+		root, what := tcase.damaged()
+		schemaText := jsonText(root)
+
+		reply, err := py.ask(schemaText, instTexts(tcase.insts))
+		if err != nil {
+			ht.Fatalf("oracle failure: %v\nschema %s", err, schemaText)
+		}
+		_, cerr := compileDoc(reparse(root), false)
+		// Python's jsonschema itself crashes crawling some legacy schemas
+		// ("$id": "#a" anchors, array-form dependencies in embedded resources); no verdict.
+		ht.Assume(!strings.HasPrefix(reply.Exc, "AttributeError"))
+		pyOK := reply.SchemaOK && !(reply.Exc != "" && !strings.HasPrefix(reply.Exc, "RecursionError"))
+		if what == "$ref unresolvable" || what == "pattern invalid" {
+			// python only notices an unresolvable reference when validation reaches
+			// it, and whether check_schema checks the "regex" format of a pattern
+			// depends on the jsonschema version; both must be compile errors here
+			if cerr == nil {
+				ht.Fatalf("Compile accepts a schema with %s: %s", what, schemaText)
+			}
+			return
+		}
+		if (cerr == nil) != pyOK {
+			ht.Fatalf("draft %d, %s: Compile error %v; python ok=%v (%s %s)\nschema %s", d.version, what, cerr, pyOK, reply.SchemaErr, reply.Exc, schemaText)
+		}
+	})
+}
diff --git a/hegel_refs_test.go b/hegel_refs_test.go
new file mode 100644
index 0000000..86a1853
--- /dev/null
+++ b/hegel_refs_test.go
@@ -0,0 +1,256 @@
+package jsonschema_test
+
+import (
+	"fmt"
+	"strings"
+
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// wrapping is one way of reaching a schema S through the reference and
+// applicator machinery without changing what it accepts.
+type wrapping struct {
+	name string
+	doc  func(s map[string]any, d draftInfo, k int) map[string]any // k: a small random number for variants
+	min  int                                                       // minimum draft version
+}
+
+var anchorNames = []string{"a", "A0", "_x", "n.o-p", "anchor_1", "Z9"}
+
+func defsWith(d draftInfo, name string, s any) map[string]any {
+	return map[string]any{d.defsKw: map[string]any{name: s}}
+}
+
+var wrappings = []wrapping{
+	{"identity", func(s map[string]any, d draftInfo, k int) map[string]any { return s }, 4},
+	{"allOf", func(s map[string]any, d draftInfo, k int) map[string]any {
+		return map[string]any{"allOf": []any{s}}
+	}, 4},
+	{"anyOf", func(s map[string]any, d draftInfo, k int) map[string]any {
+		return map[string]any{"anyOf": []any{s}}
+	}, 4},
+	{"oneOf", func(s map[string]any, d draftInfo, k int) map[string]any {
+		return map[string]any{"oneOf": []any{s}}
+	}, 4},
+	{"not not", func(s map[string]any, d draftInfo, k int) map[string]any {
+		return map[string]any{"not": map[string]any{"not": s}}
+	}, 4},
+	{"if then else", func(s map[string]any, d draftInfo, k int) map[string]any {
+		return map[string]any{"if": s, "then": true, "else": false}
+	}, 7},
+	{"ref by pointer", func(s map[string]any, d draftInfo, k int) map[string]any {
+		name := defNamePool[k%len(defNamePool)]
+		doc := defsWith(d, name, s)
+		doc["$ref"] = "#" + fragmentEscape("/"+d.defsKw+"/"+escapeToken(name))
+		return doc
+	}, 4},
+	{"ref chain", func(s map[string]any, d draftInfo, k int) map[string]any {
+		doc := map[string]any{d.defsKw: map[string]any{
+			"x": s,
+			"y": map[string]any{"$ref": "#/" + d.defsKw + "/x"},
+		}}
+		doc["$ref"] = "#/" + d.defsKw + "/y"
+		return doc
+	}, 4},
+	{"ref to anchor", func(s map[string]any, d draftInfo, k int) map[string]any {
+		anchor := anchorNames[k%len(anchorNames)]
+		if d.version < 2020 && strings.HasPrefix(anchor, "_") {
+			anchor = "u" + anchor
+		}
+		target := map[string]any{}
+		for key, v := range s {
+			target[key] = v
+		}
+		if d.version >= 2019 {
+			target["$anchor"] = anchor
+		} else {
+			target[d.idKw] = "#" + anchor
+		}
+		doc := defsWith(d, "t", target)
+		doc["$ref"] = "#" + anchor
+		return doc
+	}, 4},
+	{"ref to embedded id", func(s map[string]any, d draftInfo, k int) map[string]any {
+		target := map[string]any{}
+		for key, v := range s {
+			target[key] = v
+		}
+		ids := []string{"sub.json", "dir/sub.json", "http://example.com/other/x.json", "sub.json#", "../up.json"}
+		refs := []string{"sub.json", "dir/sub.json", "http://example.com/other/x.json", "sub.json", "http://example.com/up.json"}
+		i := k % len(ids)
+		target[d.idKw] = ids[i]
+		doc := defsWith(d, "t", target)
+		doc[d.idKw] = "http://example.com/base/root.json"
+		ref := refs[i]
+		if i == 1 && k%2 == 0 {
+			ref = "http://example.com/base/dir/sub.json"
+		}
+		if i == 0 && k%3 == 0 {
+			ref = "/base/sub.json"
+		}
+		// under allOf: up to draft 7 a root-level $ref would silence the root's $id
+		doc["allOf"] = []any{map[string]any{"$ref": ref}}
+		return doc
+	}, 4},
+	{"dynamicRef without dynamic scope", func(s map[string]any, d draftInfo, k int) map[string]any {
+		doc := defsWith(d, "t", s)
+		doc["$dynamicRef"] = "#/$defs/t"
+		return doc
+	}, 2020},
+	{"dynamicRef to dynamicAnchor", func(s map[string]any, d draftInfo, k int) map[string]any {
+		target := map[string]any{"$dynamicAnchor": "node"}
+		for key, v := range s {
+			target[key] = v
+		}
+		doc := defsWith(d, "t", target)
+		doc["$dynamicRef"] = "#node"
+		return doc
+	}, 2020},
+	{"recursiveRef", func(s map[string]any, d draftInfo, k int) map[string]any {
+		// $recursiveRef: "#" without any $recursiveAnchor is a plain reference to the root
+		doc := defsWith(d, "t", s)
+		doc["allOf"] = []any{map[string]any{"$recursiveRef": "#/$defs/t"}}
+		return doc
+	}, 2019},
+	{"ref with ignored siblings", func(s map[string]any, d draftInfo, k int) map[string]any {
+		doc := defsWith(d, "t", s)
+		doc["$ref"] = "#/" + d.defsKw + "/t"
+		doc["type"] = "null" // must be ignored beside $ref up to draft 7
+		doc["enum"] = []any{"never"}
+		doc["minimum"] = num("1000")
+		doc["not"] = map[string]any{}
+		if !Known.refSiblingConst {
+			doc["const"] = "never" // enforced in drafts 6 and 7 (jsonschema/1); left out under HEGEL_NO_KNOWN=1
+		}
+		return doc
+	}, 4},
+}
+
+// wrappingsOf: the wrappings that apply to each draft: from the wrapping's
+// minimum draft on, $recursiveRef in 2019-09 only, and the ignored siblings
+// of $ref up to draft 7 only (from 2019-09 the siblings apply).
+var wrappingsOf = func() map[int][]wrapping {
+	m := map[int][]wrapping{}
+	for _, d := range drafts {
+		for _, w := range wrappings {
+			if d.version >= w.min && !(w.min == 2019 && d.version != 2019) && !(w.name == "ref with ignored siblings" && d.version >= 2019) {
+				m[d.version] = append(m[d.version], w)
+			}
+		}
+	}
+	return m
+}()
+
+// wrapUnder puts the wrapped schema under a property so that the equality
+// is also checked one level down.
+func wrapUnder(doc map[string]any, d draftInfo) map[string]any {
+	inner := map[string]any{}
+	for k, v := range doc {
+		if k == "$schema" || k == d.idKw || k == d.defsKw {
+			continue
+		}
+		inner[k] = v
+	}
+	out := map[string]any{"properties": map[string]any{"p": inner}}
+	if v, ok := doc[d.idKw]; ok {
+		out[d.idKw] = v
+	}
+	if v, ok := doc[d.defsKw]; ok {
+		out[d.defsKw] = v
+	}
+	return out
+}
+
+// refCase: a schema of a draft (without references of its own), a wrapping
+// of it with the variant number the wrapping reads, whether both are put
+// under a property, and the instances shaped after the schema.
+type refCase struct {
+	d     draftInfo
+	s     map[string]any
+	w     wrapping
+	k     int
+	under bool
+	insts []any
+}
+
+// docs are the plain and the wrapped schema documents.
+func (c refCase) docs() (plain, wrapped map[string]any) {
+	d := c.d
+	wrapped = c.w.doc(deepCopy(c.s).(map[string]any), d, c.k)
+	plain = map[string]any{}
+	for key, v := range c.s {
+		plain[key] = v
+	}
+	if c.under {
+		wrapped = wrapUnder(wrapped, d)
+		plain = wrapUnder(plain, d)
+	}
+	wrapped["$schema"] = d.url
+	plain["$schema"] = d.url
+	return plain, wrapped
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c refCase) GoString() string {
+	plain, wrapped := c.docs()
+	return fmt.Sprintf("draft %d %s under=%v\nplain %s\nwrapped %s\ninstances %s", c.d.version, c.w.name, c.under, jsonText(plain), jsonText(wrapped), strings.Join(instTexts(c.insts), " "))
+}
+
+var refCases = hegel.FlatMap(hegel.SampledFrom(drafts), func(d draftInfo) hegel.Generator[refCase] {
+	applicable := hegel.SampledFrom(wrappingsOf[d.version])
+	return hegel.FlatMap(schemasOf(d, plainOpts), func(root map[string]any) hegel.Generator[refCase] {
+		s := map[string]any{}
+		for k, v := range root {
+			if k != "$schema" {
+				s[k] = v
+			}
+		}
+		insts := instancesOf(d, s)
+		return hegel.Composite(func(tc hegel.TestCase) refCase {
+			return refCase{
+				d:     d,
+				s:     s,
+				w:     hegel.Draw(tc, applicable),
+				k:     hegel.Draw(tc, hegel.Integers(0, 29)),
+				under: hegel.Draw(tc, chance(30)),
+				insts: hegel.Draw(tc, insts),
+			}
+		})
+	})
+})
+
+// TestHegelReferencesAreTransparent: reaching a schema through $ref (by JSON
+// pointer with escaping, by anchor, by embedded $id in its various URI forms,
+// through chains, $dynamicRef, $recursiveRef, with ignored siblings) or
+// through a one-armed applicator accepts exactly the same instances.
+func TestHegelReferencesAreTransparent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, refCases)
+		d, w, under := tcase.d, tcase.w, tcase.under
+		plainDoc, wrapped := tcase.docs()
+
+		plain, err := compileDoc(reparse(plainDoc), false)
+		if err != nil {
+			ht.Fatalf("plain schema does not compile: %v\n%s", err, jsonText(plainDoc))
+		}
+		sch, err := compileDoc(reparse(wrapped), false)
+		if err != nil {
+			ht.Fatalf("%s: wrapped schema does not compile: %v\n%s", w.name, err, jsonText(wrapped))
+		}
+		for _, inst := range tcase.insts {
+			if under {
+				inst = map[string]any{"p": inst}
+			}
+			text := jsonText(inst)
+			e1 := plain.Validate(reparse(inst))
+			e2 := sch.Validate(reparse(inst))
+			if (e1 == nil) != (e2 == nil) {
+				constSibling := w.name == "ref with ignored siblings" && d.version >= 6 // const beside $ref (drafts 6 and 7)
+				mismatch(ht, shapeIf(constSibling, "jsonschema/1"), "draft %d, %s (under=%v): plain valid=%v, wrapped valid=%v\ninstance %s\nplain %s\nwrapped %s\nplain error: %v\nwrapped error: %v",
+					d.version, w.name, under, e1 == nil, e2 == nil, text, jsonText(plainDoc), jsonText(wrapped), e1, e2)
+			}
+		}
+	})
+}
