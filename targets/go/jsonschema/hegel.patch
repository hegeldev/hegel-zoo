+package jsonschema_test
+
+// Hegel properties for github.com/santhosh-tekuri/jsonschema/v6: random
+// schemas in drafts 4, 6, 7, 2019-09 and 2020-12 validated against Python's
+// `jsonschema` package (validation results and schema checking), plus
+// library-internal identities: reference transparency, well-formed output
+// units, exact-number semantics and the format validators against models
+// of their RFCs.
+//
+// Needs python3 with the `jsonschema` package (4.x) on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	refSiblingConst    bool // jsonschema/1: in drafts 6 and 7 a const beside $ref is enforced although every sibling of $ref must be ignored
+	signedFormatFields bool // format fields parsed with strconv.Atoi accept a sign: "+1:00:00Z" (time), "1.2.3.-0" (ipv4)
+
+	bigIntegerKeywords bool // minLength/maxLength/minItems/maxItems/minProperties/maxProperties beyond int64 wrap around (maxLength: 1e19 rejects every string)
+
+	keywordLocationEncoded       bool // the output units' keywordLocation (a JSON pointer) carries the percent-encoding of the schema URL fragment
+	propertyNamesLocationDoubled bool // a propertyNames failure reports keywordLocation ".../propertyNames/propertyNames"
+	dependencyKeywordPath        bool // a dependencies failure reports keywordLocation ".../dependency/<prop>"
+	propertyNamesLocationAliased bool // a propertyNames failure's instanceLocation shares the validator's path buffer and is overwritten by later validation
+}{refSiblingConst: true, signedFormatFields: true, bigIntegerKeywords: true, keywordLocationEncoded: true, propertyNamesLocationDoubled: true, dependencyKeywordPath: true, propertyNamesLocationAliased: true}
