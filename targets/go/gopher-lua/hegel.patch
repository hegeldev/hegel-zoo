+// numOrStr is an operand for concatenation: a string, or a number whose
+// string form is the same in both implementations while numberToString is
+// open.
+func (g *gen) numOrStr(d int) ex {
+	if chance(g.ht, 50) {
+		return g.expr(kStr, d)
+	}
+	return g.safeNum(d)
+}
+
+// safeNum is a number whose tostring is beyond doubt: while
+// Known.numberToString is open, a small integer or a short fraction.
+func (g *gen) safeNum(d int) ex {
+	if !Known.numberToString {
+		return g.expr(kNum, d)
+	}
+	switch n(g.ht, 1, 4) {
+	case 1:
+		return atom(pick(g.ht, "0", "1", "2", "7", "10", "42", "100", "1000", "1.5", "0.5", "2.25", "0.125", "-3", "-1.5", "12345", "3.75"))
+	case 2:
+		x := g.expr(kNum, d)
+		// beyond 2^53 the reference's a - floor(a/b)*b loses the low digits of a huge a
+		return atom(fmt.Sprintf("(function(z) if z ~= z or z >= 2^53 or z <= -2^53 then return 0 end return math.floor(z) %% 100 end)(%s)", x.s))
+	case 3:
+		return ex{"#" + g.lenOperand(d).s, unaryPrec}
+	default:
+		return atom(fmt.Sprintf("select('#', %s)", g.exprList(d, n(g.ht, 0, 3))))
+	}
+}
+
+func (g *gen) safeNumTab(d int) ex {
+	m := n(g.ht, 0, 4)
+	parts := make([]string, m)
+	for i := range parts {
+		parts[i] = g.safeNum(d).s
+	}
+	return atom("{" + strings.Join(parts, ", ") + "}")
+}
