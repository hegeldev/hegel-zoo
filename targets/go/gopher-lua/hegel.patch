+// The reference Lua 5.1 interpreter as a child process running a small
+// driver: one program per request (a line with the byte length, then the
+// bytes), one reply per program (a status line - ok, compile or runtime -
+// then a line with the byte length of the payload and the payload). The
+// payload is the return values, serialised the same way on both sides:
+//
+//	nil, true, false; numbers as integers when integral and below 2^53
+//	(with -0 kept), else %.14g, inf/-inf/nan; strings quoted with every
+//	byte outside printable ASCII escaped as \ddd; tables as {k=v,...} with
+//	the keys sorted (numbers, then strings, then booleans); functions,
+//	threads and userdata by type; several return values as (a, b, c).
+//
+// For a failed program the payload is the error value, serialised the same
+// way (compared only when the pins ask for it: GopherLua words its own
+// messages).
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"os/exec"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	lua "github.com/yuin/gopher-lua"
+)
+
+const luaDriver = `
+local type, tostring, next, pairs, select, pcall, loadstring, setfenv, setmetatable, error =
+      type, tostring, next, pairs, select, pcall, loadstring, setfenv, setmetatable, error
+local format, byte, gsub, concat, sort, floor, abs, huge = string.format, string.byte, string.gsub, table.concat, table.sort, math.floor, math.abs, math.huge
+local read, write, flush = io.read, io.write, io.flush
+local sethook = debug.sethook
+
+local function fmtnum(v)
+  if v ~= v then return "nan" end
+  if v == huge then return "inf" end
+  if v == -huge then return "-inf" end
+  if v == floor(v) and abs(v) < 2^53 then
+    if v == 0 and 1/v < 0 then return "-0" end
+    return format("%d", v)
+  end
+  return format("%.14g", v)
+end
+
+local function fmtstr(s)
+  return '"' .. gsub(s, '[%z\1-\31\127-\255\\"]', function(c) return format("\\%03d", byte(c)) end) .. '"'
+end
+
+local rank = { number = 1, string = 2, boolean = 3, table = 4, ["function"] = 5, thread = 6, userdata = 7, ["nil"] = 8 }
+
+local ser
+local function keyless(a, b)
+  local ta, tb = type(a), type(b)
+  if ta ~= tb then return rank[ta] < rank[tb] end
+  if ta == "number" or ta == "string" then return a < b end
+  if ta == "boolean" then return (not a) and b end
+  return ser(a, {}, 0) < ser(b, {}, 0)
+end
+
+function ser(v, seen, depth)
+  local t = type(v)
+  if t == "nil" then return "nil" end
+  if t == "boolean" then return v and "true" or "false" end
+  if t == "number" then return fmtnum(v) end
+  if t == "string" then return fmtstr(v) end
+  if t ~= "table" then return "<" .. t .. ">" end
+  if seen[v] then return "<cycle>" end
+  if depth > 8 then return "<deep>" end
+  seen[v] = true
+  local keys = {}
+  local k = next(v)
+  while k ~= nil do
+    keys[#keys + 1] = k
+    k = next(v, k)
+  end
+  sort(keys, keyless)
+  local parts = {}
+  for i = 1, #keys do
+    local key = keys[i]
+    parts[i] = ser(key, seen, depth + 1) .. "=" .. ser(v[key], seen, depth + 1)
+  end
+  seen[v] = nil
+  return "{" .. concat(parts, ",") .. "}"
+end
+
+local function pack(...) return select("#", ...), { ... } end
+
+local function reply(status, payload)
+  write(status, "\n", #payload, "\n", payload)
+  flush()
+end
+
+write("lua5.1 driver ", _VERSION, "\n")
+flush()
+
+while true do
+  local line = read("*l")
+  if line == nil then break end
+  local size = tonumber(line)
+  local src = size > 0 and read(size) or ""
+  local f, cerr = loadstring(src, "=snip")
+  if f == nil then
+    reply("compile", ser(cerr, {}, 0))
+  else
+    local env = setmetatable({ print = function() end }, { __index = _G })
+    setfenv(f, env)
+    sethook(function() error("instruction budget exhausted", 0) end, "", 20000000)
+    local n, rs = pack(pcall(f))
+    sethook()
+    if rs[1] then
+      local parts = {}
+      for i = 2, n do parts[i - 1] = ser(rs[i], {}, 0) end
+      reply("ok", "(" .. concat(parts, ", ") .. ")")
+    else
+      reply("runtime", ser(rs[2], {}, 0))
+    end
+  end
+end
+`
+
+type luaResult struct {
+	Status  string // ok, compile, runtime
+	Payload string
+}
+
+var (
+	oracleOnce   sync.Once
+	oracleMu     sync.Mutex
+	oracleIn     io.WriteCloser
+	oracleOut    *bufio.Reader
+	oracleErr    error
+	oracleBanner string
+	oracleCmd    *exec.Cmd
+	oracleStderr strings.Builder
+)
+
+func startOracle() {
+	cmd := exec.Command("lua5.1", "-e", luaDriver)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	cmd.Stderr = &oracleStderr
+	oracleCmd = cmd
+	if err := cmd.Start(); err != nil {
+		oracleErr = fmt.Errorf("starting lua5.1: %v", err)
+		return
+	}
+	oracleIn = stdin
+	oracleOut = bufio.NewReaderSize(stdout, 1<<20)
+	banner, err := oracleOut.ReadString('\n')
+	if err != nil {
+		_ = cmd.Wait()
+		oracleErr = fmt.Errorf("lua5.1 driver did not start (lua5.1 needed on PATH): %v: %s", err, oracleStderr.String())
+		return
+	}
+	oracleBanner = strings.TrimSpace(banner)
+}
+
+// luaRun runs one program in the reference interpreter.
+func luaRun(t testing.TB, src string) luaResult {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("oracle: %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	if _, err := fmt.Fprintf(oracleIn, "%d\n%s", len(src), src); err != nil {
+		_ = oracleCmd.Wait()
+		t.Fatalf("oracle write: %v\nstderr: %s", err, oracleStderr.String())
+	}
+	readLine := func() string {
+		line, err := oracleOut.ReadString('\n')
+		if err != nil {
+			_ = oracleCmd.Wait()
+			t.Fatalf("oracle died: %v\nprogram: %q\nstderr: %s", err, src, oracleStderr.String())
+		}
+		return strings.TrimSuffix(line, "\n")
+	}
+	status := readLine()
+	size, err := strconv.Atoi(readLine())
+	if err != nil {
+		t.Fatalf("oracle reply: bad length: %v", err)
+	}
+	buf := make([]byte, size)
+	if _, err := io.ReadFull(oracleOut, buf); err != nil {
+		t.Fatalf("oracle payload: %v", err)
+	}
+	return luaResult{Status: status, Payload: string(buf)}
+}
+
+// ---------------------------------------------------------------------------
+// GopherLua side.
+
+func fmtNum(v float64) string {
+	switch {
+	case v != v:
+		return "nan"
+	case math.IsInf(v, 1):
+		return "inf"
+	case math.IsInf(v, -1):
+		return "-inf"
+	case v == math.Floor(v) && math.Abs(v) < 1<<53:
+		if v == 0 && math.Signbit(v) {
+			return "-0"
+		}
+		return strconv.FormatInt(int64(v), 10)
+	}
+	return fmt.Sprintf("%.14g", v)
+}
+
+func fmtStr(s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c < 32 || c >= 127 || c == '\\' || c == '"' {
+			fmt.Fprintf(&b, "\\%03d", c)
+		} else {
+			b.WriteByte(c)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+func typeRank(v lua.LValue) int {
+	switch v.Type() {
+	case lua.LTNumber:
+		return 1
+	case lua.LTString:
+		return 2
+	case lua.LTBool:
+		return 3
+	case lua.LTTable:
+		return 4
+	case lua.LTFunction:
+		return 5
+	case lua.LTThread:
+		return 6
+	case lua.LTUserData:
+		return 7
+	}
+	return 8
+}
+
+// serialize mirrors the driver's ser: a raw walk, no metamethods.
+func serialize(v lua.LValue, seen map[*lua.LTable]bool, depth int) string {
+	switch x := v.(type) {
+	case *lua.LNilType:
+		return "nil"
+	case lua.LBool:
+		if x {
+			return "true"
+		}
+		return "false"
+	case lua.LNumber:
+		return fmtNum(float64(x))
+	case lua.LString:
+		return fmtStr(string(x))
+	case *lua.LTable:
+		if seen[x] {
+			return "<cycle>"
+		}
+		if depth > 8 {
+			return "<deep>"
+		}
+		seen[x] = true
+		var keys []lua.LValue
+		k := lua.LValue(lua.LNil)
+		for {
+			var val lua.LValue
+			k, val = x.Next(k)
+			if k == lua.LNil {
+				break
+			}
+			_ = val
+			keys = append(keys, k)
+		}
+		sort.SliceStable(keys, func(i, j int) bool {
+			a, b := keys[i], keys[j]
+			ra, rb := typeRank(a), typeRank(b)
+			if ra != rb {
+				return ra < rb
+			}
+			switch a.Type() {
+			case lua.LTNumber:
+				return float64(a.(lua.LNumber)) < float64(b.(lua.LNumber))
+			case lua.LTString:
+				return string(a.(lua.LString)) < string(b.(lua.LString))
+			case lua.LTBool:
+				return !bool(a.(lua.LBool)) && bool(b.(lua.LBool))
+			}
+			return serialize(a, map[*lua.LTable]bool{}, 0) < serialize(b, map[*lua.LTable]bool{}, 0)
+		})
+		parts := make([]string, len(keys))
+		for i, key := range keys {
+			parts[i] = serialize(key, seen, depth+1) + "=" + serialize(x.RawGet(key), seen, depth+1)
+		}
+		delete(seen, x)
+		return "{" + strings.Join(parts, ",") + "}"
+	}
+	return "<" + v.Type().String() + ">"
+}
+
+// shortStack keeps the gopher-lua frames of a panic's stack.
+func shortStack(b []byte) string {
+	var keep []string
+	lines := strings.Split(string(b), "\n")
+	for i := 0; i+1 < len(lines); i++ {
+		if strings.Contains(lines[i], "gopher-lua.") && !strings.Contains(lines[i], "_test.") {
+			keep = append(keep, strings.TrimSpace(lines[i])+" "+strings.TrimSpace(lines[i+1]))
+		}
+		if len(keep) == 6 {
+			break
+		}
+	}
+	return strings.Join(keep, "\n")
+}
+
+// goRun runs one program in a fresh GopherLua state. A panic in GopherLua
+// gives the status "panic" with the message and stack as the payload; a run
+// that does not finish within the deadline gives "timeout".
+// traceFile, when HEGEL_TRACE names a file, receives every program before
+// it runs in GopherLua: the last one written is the one that killed the
+// process when it dies without a stack (out of memory).
+var traceFile = func() *os.File {
+	if p := os.Getenv("HEGEL_TRACE"); p != "" {
+		f, _ := os.Create(p)
+		return f
+	}
+	return nil
+}()
+
+func goRun(src string) (res luaResult) {
+	if traceFile != nil {
+		traceFile.Truncate(0)
+		traceFile.Seek(0, 0)
+		traceFile.WriteString(src)
+		traceFile.Sync()
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			res = luaResult{Status: "panic", Payload: fmt.Sprintf("%v\n%s", r, shortStack(debug.Stack()))}
+		}
+	}()
+	L := lua.NewState(lua.Options{RegistrySize: 1024 * 20, CallStackSize: 1024})
+	defer L.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	L.SetContext(ctx)
+	L.SetGlobal("print", L.NewFunction(func(L *lua.LState) int { return 0 })) // programs must not write to stdout (the oracle's channel)
+	fn, err := L.Load(strings.NewReader(src), "snip")                         // the same chunk name as the driver gives, so positions in messages compare
+	if err != nil {
+		return luaResult{Status: "compile", Payload: fmtStr(err.Error())}
+	}
+	L.Push(fn)
+	if err := L.PCall(0, lua.MultRet, nil); err != nil {
+		if ctx.Err() != nil {
+			return luaResult{Status: "timeout", Payload: err.Error()}
+		}
+		if ae, ok := err.(*lua.ApiError); ok {
+			return luaResult{Status: "runtime", Payload: serialize(ae.Object, map[*lua.LTable]bool{}, 0)}
+		}
+		return luaResult{Status: "runtime", Payload: fmtStr(err.Error())}
+	}
+	top := L.GetTop()
+	parts := make([]string, top)
+	for i := 1; i <= top; i++ {
+		parts[i-1] = serialize(L.Get(i), map[*lua.LTable]bool{}, 0)
+	}
+	return luaResult{Status: "ok", Payload: "(" + strings.Join(parts, ", ") + ")"}
+}
+
+func TestHegelOracleVersion(t *testing.T) {
+	const smoke = "return 1, 'a\\0b', {3, x = 1e100, [true] = 1.5, [2.5] = 'q'}, nil, 0.1 + 0.2, 2^53"
+	r := luaRun(t, smoke)
+	t.Logf("%s", oracleBanner)
+	if !strings.Contains(oracleBanner, "Lua 5.1") {
+		t.Fatalf("the oracle should be the reference Lua 5.1: %s", oracleBanner)
+	}
+	want := `(1, "a\000b", {1=3,2.5="q","x"=1e+100,true=1.5}, nil, 0.3, 9.007199254741e+15)`
+	if r.Status != "ok" || r.Payload != want {
+		t.Fatalf("oracle smoke test: %+v", r)
+	}
+	g := goRun(smoke)
+	if g.Status != "ok" || g.Payload != want {
+		t.Fatalf("gopher-lua smoke test: %+v", g)
+	}
+}
