+// gopher-lua/22: the stack trace built for an error appends one line per
+// tail call made so far, so an error after many tail calls allocates without
+// bound (about 90 bytes each; after ten seconds of return f() the process
+// dies of memory). The reference keeps tail calls in constant space. The pin
+// measures the allocation of an error raised after a million tail calls,
+// which is about 8 MB without the trace and about 90 MB with it.
+func TestHegelPinTailCallTraceMemory(t *testing.T) {
+	src := `local function f(n) if n == 0 then error('x') end return f(n - 1) end return pcall(f, 1e6)`
+	l := luaRun(t, src)
+	var before, after runtime.MemStats
+	runtime.GC()
+	runtime.ReadMemStats(&before)
+	g := goRun(src)
+	runtime.ReadMemStats(&after)
+	alloc := after.TotalAlloc - before.TotalAlloc
+	t.Logf("gopher-lua: %s %s (%d MB allocated)\nlua5.1:     %s %s", g.Status, g.Payload, alloc>>20, l.Status, l.Payload)
+	if g.Status != l.Status || g.Payload != l.Payload {
+		t.Fatalf("results differ\nprogram: %s\ngopher-lua: %s %s\nlua5.1:     %s %s", src, g.Status, g.Payload, l.Status, l.Payload)
+	}
+	if alloc > 32<<20 {
+		t.Fatalf("raising an error after a million tail calls allocated %d MB (expected a few)", alloc>>20)
+	}
+}
