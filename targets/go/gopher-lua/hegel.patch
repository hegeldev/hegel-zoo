+package lua_test
+
+// A generator of small Lua 5.1 programs. Expressions are generated by kind
+// (number, string, boolean, nil, table, function) so that most programs run
+// to a value; a few deliberately wrong shapes (arithmetic on nil, indexing
+// a number, calling a string, error(), a failing assert, a syntax error)
+// check that both implementations fail at the same stage. Binary operators
+// are printed with Lua's precedence and associativity, parenthesising only
+// where needed, so the parser's precedence table is exercised.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+type kind int
+
+const (
+	kAny kind = iota
+	kNum
+	kStr
+	kBool
+	kNil
+	kTab
+	kFunc
+)
+
+type variable struct {
+	name  string
+	k     kind
+	elem  kind // for tables: the kind of the sequence elements (kAny: mixed)
+	seq   bool // for tables: a sequence without holes
+	ret   kind // for functions: the kind returned
+	np    int  // for functions: the number of parameters (all numbers)
+	fixed bool // a loop counter: never assigned to
+}
+
+type ex struct {
+	s    string
+	prec int
+}
+
+const atomPrec = 100
+
+type gen struct {
+	ht      *hegel.T
+	vars    []variable
+	counter int
+	depth   int
+	loops   int
+	generic int // generic for loops open (see Known.breakGenericFor)
+	funcs   int
+	vararg  bool
+	budget  int
+}
+
+func newGen(ht *hegel.T) *gen { return &gen{ht: ht, budget: 60} }
+
+func (g *gen) fresh(prefix string) string {
+	g.counter++
+	return fmt.Sprintf("%s%d", prefix, g.counter)
+}
+
+func (g *gen) tick() bool {
+	g.budget--
+	return g.budget > 0
+}
+
+func (g *gen) visible(k kind) []variable {
+	var out []variable
+	for _, v := range g.vars {
+		if k == kAny || v.k == k {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+func (g *gen) pickVar(k kind) (variable, bool) {
+	vs := g.visible(k)
+	if len(vs) == 0 || !chance(g.ht, 70) {
+		return variable{}, false
+	}
+	return vs[n(g.ht, 0, len(vs)-1)], true
+}
+
+func atom(s string) ex { return ex{s, atomPrec} }
+
+// ---------------------------------------------------------------------------
+// Literals.
+
+func (g *gen) numLit() string {
+	switch n(g.ht, 1, 12) {
+	case 1, 2, 3, 4:
+		return fmt.Sprint(n(g.ht, 0, 10))
+	case 5:
+		return fmt.Sprint(n(g.ht, 11, 100000))
+	case 6:
+		return pick(g.ht, "1.5", "0.5", "2.25", "0.1", "3.14", "100.75", "0.001", "1e3", "2e-2", "1E2", "5.", ".5", "1e15", "1e100", "1.25e-3", "0.30000000000000004")
+	case 7:
+		return pick(g.ht, "0x10", "0xff", "0XA", "0x0", "0x7fffffff", "0x1F")
+	case 8:
+		if Known.numberOverflow {
+			return pick(g.ht, "2147483647", "2147483648", "4294967296", "9007199254740992", "9007199254740993", "1e308", "123456789012345")
+		}
+		return pick(g.ht, "2147483647", "4294967296", "9007199254740993", "1e308", "1e309", "0xffffffffffffffff", "1.7976931348623159e308", "1e400")
+	case 9:
+		return pick(g.ht, "0", "1", "2", "3", "10", "100")
+	default:
+		return fmt.Sprint(n(g.ht, 0, 30))
+	}
+}
+
+var strPieces = []string{"a", "b", "c", "x", "ab", "hello", " ", "  ", "1", "42", "-3", "0x10", "1e2", ".", ",", "_", "-", "%", "[", "]", "(", ")", "A", "Z", "aBc", "12ab", "3.5", "\\n", "\\t", "\\\\", "\\'", "\\\"", "\\65", "\\0", "\\255", "\\10", "\\9", "tab\\tsep", "ab\\ncd"}
+
+func (g *gen) strContent() string {
+	k := n(g.ht, 0, 3)
+	var b strings.Builder
+	prevEsc := false
+	for i := 0; i < k; i++ {
+		piece := pick(g.ht, strPieces...)
+		if Known.escapeRange && prevEsc && piece[0] >= '0' && piece[0] <= '9' {
+			piece = "x" + piece // \65 followed by a digit would be an escape over 255
+		}
+		b.WriteString(piece)
+		prevEsc = strings.HasPrefix(piece, "\\") && piece[len(piece)-1] >= '0' && piece[len(piece)-1] <= '9'
+	}
+	return b.String()
+}
+
+func (g *gen) strLit() string {
+	switch n(g.ht, 1, 10) {
+	case 1, 2, 3, 4, 5, 6:
+		return "\"" + g.strContent() + "\""
+	case 7, 8:
+		return "'" + g.strContent() + "'"
+	case 9:
+		// long bracket; the content has no escapes and no closing bracket
+		level := pick(g.ht, "", "=", "==")
+		body := strings.NewReplacer("\\n", "\n", "\\t", "\t", "\\\\", "\\", "\\'", "'", "\\\"", "\"", "\\65", "A", "\\0", "", "\\255", "", "\\10", "\n", "\\9", "\t", "]", "").Replace(g.strContent())
+		if chance(g.ht, 30) {
+			body = "\n" + body // a newline right after the opening bracket is skipped
+		}
+		if Known.nestedLongBracket && level == "" && strings.Contains(body, "[[") {
+			level = "=" // [[ inside [[...]] is an error in Lua 5.1 that GopherLua accepts (gopher-lua/72)
+		}
+		return "[" + level + "[" + body + "]" + level + "]"
+	default:
+		return pick(g.ht, `""`, `''`, `"a\
+b"`, `"\x41"`, `"\z  b"`, `"%d"`, `"%5.2f"`, `"%s"`)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Expressions.
+
+func (g *gen) expr(k kind, d int) ex {
+	if k == kAny {
+		k = pick(g.ht, kNum, kNum, kStr, kStr, kBool, kNil, kTab, kFunc)
+	}
+	if d <= 0 || !g.tick() {
+		return g.leaf(k)
+	}
+	if chance(g.ht, 25) {
+		return g.leaf(k)
+	}
+	switch k {
+	case kNum:
+		return g.numExpr(d)
+	case kStr:
+		return g.strExpr(d)
+	case kBool:
+		return g.boolExpr(d)
+	case kNil:
+		return g.nilExpr(d)
+	case kTab:
+		return g.tabExpr(d)
+	case kFunc:
+		return g.funcExpr(d)
+	}
+	return atom("nil")
+}
+
+func (g *gen) leaf(k kind) ex {
+	if v, ok := g.pickVar(k); ok {
+		return atom(v.name)
+	}
+	switch k {
+	case kNum:
+		return atom(g.numLit())
+	case kStr:
+		return atom(g.strLit())
+	case kBool:
+		return atom(pick(g.ht, "true", "false"))
+	case kNil:
+		return atom("nil")
+	case kTab:
+		return g.tabLit(0)
+	case kFunc:
+		return g.funcLit(0)
+	}
+	return atom("nil")
+}
+
+type binop struct {
+	op    string
+	prec  int
+	right bool
+}
+
+var (
+	opOr      = binop{"or", 1, false}
+	opAnd     = binop{"and", 2, false}
+	opConcat  = binop{"..", 5, true}
+	opPow     = binop{"^", 10, true}
+	unaryPrec = 8
+)
+
+func cmpOp(op string) binop { return binop{op, 3, false} }
+func addOp(op string) binop { return binop{op, 6, false} }
+func mulOp(op string) binop { return binop{op, 7, false} }
+
+func (g *gen) bin(op binop, l, r ex) ex {
+	ls, rs := l.s, r.s
+	// a child of lower precedence needs parentheses; so does a child of the
+	// same precedence on the non-associative side
+	if l.prec < op.prec || (l.prec == op.prec && op.right) || chance(g.ht, 10) {
+		ls = "(" + ls + ")"
+	}
+	if r.prec < op.prec || (r.prec == op.prec && !op.right) || chance(g.ht, 10) {
+		rs = "(" + rs + ")"
+	}
+	if Known.negZero && (op.op == "*" || op.op == "/" || op.op == "^" || op.op == "-" || op.op == "+") {
+		// 0 * -1, 0 / -5, (-0) ^ 3, -0 - 0 and -0 + -0 are -0 in the reference and 0 in
+		// GopherLua: adding 0 makes both 0 (and a divisor of -0 is made +0 as well, for
+		// 1 / (0 * -1))
+		if op.op == "/" {
+			rs = "(" + rs + " + 0)"
+		}
+		return atom("(" + ls + " " + op.op + " " + rs + " + 0)")
+	}
+	return ex{ls + " " + op.op + " " + rs, op.prec}
+}
+
+// modOperand makes an operand of % an integer below 2^31 in magnitude (nan
+// and infinities become 7); see numExpr.
+func modOperand(s string) string {
+	return "(function(z) if z ~= z or z >= 2^31 or z <= -2^31 then return 7 end return math.floor(z) end)(" + s + ")"
+}
+
+// isEmptyStrLit reports whether s is a string literal denoting "": quotes with
+// nothing between, or a long bracket holding at most the newline the lexer skips.
+func isEmptyStrLit(s string) bool {
+	if s == `""` || s == "''" {
+		return true
+	}
+	if !strings.HasPrefix(s, "[") {
+		return false
+	}
+	open := strings.Index(s, "[")
+	level := strings.IndexByte(s[open+1:], '[')
+	if level < 0 {
+		return false
+	}
+	body := s[open+1+level+1:]
+	closing := "]" + strings.Repeat("=", level) + "]"
+	if !strings.HasSuffix(body, closing) {
+		return false
+	}
+	body = strings.TrimSuffix(body, closing)
+	return body == "" || body == "\n"
+}
+
+// isZeroLit reports whether s is a numeral spelling zero (0, 0x0, 0.0, 0e0).
+func isZeroLit(s string) bool {
+	if i, err := strconv.ParseInt(s, 0, 64); err == nil {
+		return i == 0
+	}
+	f, err := strconv.ParseFloat(s, 64)
+	return err == nil && f == 0
+}
+
+func (g *gen) unary(op string, x ex) ex {
+	if op == "-" && isZeroLit(x.s) {
+		// the reference folds -0 into a constant and then reuses it for every later 0
+		// in the same function (constants are looked up by value): keep -0 out of the
+		// constant table by making it at run time
+		return atom("(-tonumber('0'))")
+	}
+	s := x.s
+	if x.prec < unaryPrec || chance(g.ht, 10) {
+		s = "(" + s + ")"
+	}
+	if op == "-" && strings.HasPrefix(s, "-") {
+		s = " " + s // "- -1", never the comment "--"
+	}
+	if op == "not" {
+		s = " " + s
+	}
+	return ex{op + s, unaryPrec}
+}
+
+func (g *gen) paren(x ex) ex { return atom("(" + x.s + ")") }
+
+func (g *gen) numExpr(d int) ex {
+	switch n(g.ht, 1, 20) {
+	case 1, 2, 3, 4:
+		return g.bin(addOp(pick(g.ht, "+", "-")), g.expr(kNum, d-1), g.expr(kNum, d-1))
+	case 5, 6:
+		op := pick(g.ht, "*", "/", "%")
+		l, r := g.expr(kNum, d-1), g.expr(kNum, d-1)
+		if op == "%" {
+			// the reference's a - floor(a/b)*b is not fmod: they differ in the last bits for
+			// non-integral operands (5 % 1.25e-3) and wholly beyond 2^53 (1e308 % 100, 2^60 % 7),
+			// so both operands are made integers below 2^31 (a C quirk, not judged)
+			l, r = atom(modOperand(l.s)), atom(modOperand(r.s))
+		}
+		x := g.bin(mulOp(op), l, r)
+		if op == "%" && Known.modNegativeZero {
+			x = atom("(" + x.s + " + 0)") // -0 + 0 is 0
+		}
+		return x
+	case 7:
+		e := pick(g.ht, "2", "0.5", "3", "0", "-1", "10", "1")
+		base := g.expr(kNum, d-1)
+		if e == "3" || e == "10" {
+			// Go's math.Pow rounds more than once for an integer exponent above 2 (1.7^10 and
+			// (152^10)^10 are one ulp off glibc's pow): keep the result exactly representable
+			base = atom("(" + modOperand(base.s) + " % 100)")
+		}
+		return g.bin(opPow, base, atom(e))
+	case 8:
+		return g.unary("-", g.expr(kNum, d-1))
+	case 9:
+		return ex{"#" + g.lenOperand(d-1).s, unaryPrec}
+	case 10:
+		// string arithmetic coercion
+		return g.bin(addOp("+"), atom(pick(g.ht, `"10"`, `"0x10"`, `" 3 "`, `"1e2"`, `"2.5"`, `"-7"`, `'3'`)), g.expr(kNum, d-1))
+	case 11:
+		return g.mathCall(d - 1)
+	case 12:
+		return g.strNumCall(d - 1)
+	case 13:
+		s := pick(g.ht, `"10"`, `"  12  "`, `"0x1f"`, `"1e2"`, `"3.5"`, `"-0"`, `"1."`, `".5"`, `"0x"`, `"1e"`, `"10 "`, `"\t7\n"`, `"1 2"`, `"08"`, `"1_000"`, `"+5"`, `"- 5"`, `"1.5e+2"`)
+		if Known.tonumberExponent && s == `"1e2"` {
+			s = `"1.5e2"`
+		}
+		if Known.tonumberNegZero && s == `"-0"` {
+			s = `"-0.0"` // tonumber("-0") is 0 (gopher-lua/60); with a point the sign survives
+		}
+		return atom(fmt.Sprintf("tonumber(%s)", s))
+	case 14:
+		arg := pick(g.ht, `"10"`, `"ff"`, `"FF"`, `"z"`, `"  11 "`, `"1.5"`, `"7"`, `"zz"`, `"0x10"`, `""`, `" "`, `"1 1"`)
+		base := pick(g.ht, 2, 8, 10, 16, 36, 3, 1, 37, 0)
+		if Known.tonumberBaseCheck {
+			if arg == `"1.5"` {
+				arg = `"15"`
+			}
+			if base < 2 || base > 36 {
+				base = 10
+			}
+		}
+		if Known.tonumberBase10 && base == 10 && arg == `"0x10"` {
+			arg = `"10"`
+		}
+		if base == 16 && arg == `"0x10"` {
+			arg = `"1f"` // the reference's strtoul takes a 0x prefix in base 16 (a C quirk, not judged)
+		}
+		if !Known.tonumberBase && chance(g.ht, 30) {
+			arg = pick(g.ht, "10", "11", "7", "1.5")
+		}
+		return atom(fmt.Sprintf("tonumber(%s, %d)", arg, base))
+	case 15:
+		c := g.expr(kBool, d-1)
+		return g.bin(opOr, g.bin(opAnd, c, g.expr(kNum, d-1)), g.expr(kNum, d-1))
+	case 16:
+		return g.callNumFunc(d - 1)
+	case 17:
+		return g.indexNum(d - 1)
+	case 18:
+		return g.paren(g.numExpr(d - 1))
+	case 19:
+		return atom(fmt.Sprintf("select('#', %s)", g.exprList(d-1, n(g.ht, 0, 3))))
+	default:
+		return atom(g.numLit())
+	}
+}
+
+func (g *gen) lenOperand(d int) ex {
+	if chance(g.ht, 50) {
+		x := g.expr(kStr, d)
+		if x.prec < atomPrec {
+			return g.paren(x)
+		}
+		return x
+	}
+	x := g.seqTab(d)
+	if x.prec < atomPrec {
+		return g.paren(x)
+	}
+	return x
+}
+
+// seqTab is a table expression that is a proper sequence (no holes), so
+// that # has one defined value.
+func (g *gen) seqTab(d int) ex {
+	for _, v := range g.visible(kTab) {
+		if v.seq && chance(g.ht, 60) {
+			return atom(v.name)
+		}
+	}
+	k := n(g.ht, 0, 4)
+	parts := make([]string, k)
+	for i := range parts {
+		parts[i] = g.expr(pick(g.ht, kNum, kStr, kBool, kTab), d-1).s
+	}
+	return atom("{" + strings.Join(parts, ", ") + "}")
+}
+
+func (g *gen) mathCall(d int) ex {
+	x := g.expr(kNum, d).s
+	y := g.expr(kNum, d).s
+	switch n(g.ht, 1, 14) {
+	case 1:
+		return atom("math.floor(" + x + ")")
+	case 2:
+		return atom("math.ceil(" + x + ")")
+	case 3:
+		return atom("math.abs(" + x + ")")
+	case 4:
+		return atom(fmt.Sprintf("math.max(%s, %s)", x, y))
+	case 5:
+		return atom(fmt.Sprintf("math.min(%s, %s)", x, y))
+	case 6:
+		return atom(fmt.Sprintf("math.fmod(%s, %s)", x, y))
+	case 7:
+		return atom(fmt.Sprintf("(math.modf(%s))", x))
+	case 8:
+		return atom(fmt.Sprintf("select(2, math.modf(%s))", x))
+	case 9:
+		s := pick(g.ht, "math.sqrt(16)", "math.sqrt(2.25)", "math.sqrt(0)", "math.sqrt(-1)", "math.huge", "-math.huge", "math.pi", "math.pow(2, 10)", "math.pow(2, 0.5)", "math.exp(0)", "math.log(1)", "math.log10(1000)", "math.ldexp(1, 4)", "math.frexp(8)", "math.sin(0)", "math.cos(0)", "math.deg(math.pi)", "math.rad(180)", "math.atan(0)", "math.tan(0)")
+		if Known.infArith && strings.Contains(s, "huge") {
+			s = "math.pi"
+		}
+		return atom(s)
+	case 10:
+		return atom(fmt.Sprintf("math.max(%s, %s, %s)", x, y, g.expr(kNum, d).s))
+	case 11:
+		return atom(fmt.Sprintf("math.fmod(%s, %s)", pick(g.ht, "7", "-7", "7.5", "0", "1e15"), pick(g.ht, "3", "-3", "0.5", "1", "2.5", "0")))
+	case 12:
+		return atom(fmt.Sprintf("math.floor(%s)", pick(g.ht, "-0.5", "2.5", "-2.5", "1e15 + 0.5", "-tonumber('0')", "1e308", "-1e308", "0.9999999999999999")))
+	case 13:
+		dv := pick(g.ht, "3", "-3", "4", "-4", "0", "1", "math.huge", "-math.huge") // integers: see numExpr
+		if Known.infArith && strings.Contains(dv, "huge") {
+			dv = "3"
+		}
+		x := fmt.Sprintf("%s %% %s", pick(g.ht, "5", "-5", "6", "-6", "0", "1e9", "7"), dv)
+		if Known.modNegativeZero {
+			x = "(" + x + " + 0)"
+		}
+		return atom(x)
+	default:
+		return atom(fmt.Sprintf("%s / %s", pick(g.ht, "1", "-1", "0", "7", "1e308"), pick(g.ht, "0", "-tonumber('0')", "3", "0.5", "2", "1e308", "-tonumber('0.0')")))
+	}
+}
+
+// strNumCall: numbers out of strings.
+func (g *gen) strNumCall(d int) ex {
+	s := g.expr(kStr, d)
+	ss := s.s
+	if s.prec < atomPrec {
+		ss = "(" + ss + ")"
+	}
+	switch n(g.ht, 1, 8) {
+	case 1:
+		return atom(ss + ":len()")
+	case 2:
+		return atom("string.len(" + ss + ")")
+	case 3:
+		return atom(fmt.Sprintf("(%s:byte(%s) or -1)", ss, pick(g.ht, "1", "2", "-1", "0", "10", "1, 3", "-2, -1")))
+	case 4:
+		needle := g.strLit()
+		if Known.findEmptyInit && isEmptyStrLit(needle) {
+			needle = `"a"`
+		}
+		init, plain := pick(g.ht, "1", "2", "-1", "0", "-3", "100"), pick(g.ht, "true", "false")
+		if Known.findPlainInitBeyond && plain == "true" {
+			// a plain find with init past the end panics (gopher-lua/65): clamp it to #s + 1
+			return atom(fmt.Sprintf("((function(s) return s:find(%s, math.min(%s, #s + 1), true) end)(%s) or -1)", needle, init, ss))
+		}
+		return atom(fmt.Sprintf("(%s:find(%s, %s, %s) or -1)", ss, needle, init, plain))
+	case 5:
+		return atom(fmt.Sprintf("(%s:find(%s) or -1)", ss, g.pattern()))
+	case 6:
+		return atom(fmt.Sprintf("select(2, %s:gsub(%s, %s))", ss, g.pattern(), g.replacement(d))) // replacement(): "%s" as a replacement is gopher-lua/53
+	case 7:
+		return atom(fmt.Sprintf("(tonumber((%s:gsub('%%z', ''))) or -1)", ss)) // no NUL: strtod stops there (a C quirk, not judged)
+	default:
+		return atom(fmt.Sprintf("(select(2, %s:find(%s)) or -1)", ss, g.pattern()))
+	}
+}
+
+// pattern is a Lua pattern.
+func (g *gen) pattern() string {
+	k := n(g.ht, 1, 4)
+	var b strings.Builder
+	if chance(g.ht, 20) {
+		b.WriteString("^")
+	}
+	for i := 0; i < k; i++ {
+		var atomp string
+		switch n(g.ht, 1, 9) {
+		case 1, 2:
+			atomp = pick(g.ht, "a", "b", "c", "1", " ", "_", "-", ".", "x", "l")
+		case 3, 4:
+			atomp = pick(g.ht, "%a", "%d", "%s", "%w", "%l", "%u", "%p", "%x", "%c", "%A", "%D", "%S", "%W", "%.", "%%", "%-", "%[", "%]", "%(", "%)")
+		case 5:
+			atomp = pick(g.ht, "[abc]", "[^abc]", "[a-c]", "[%d_]", "[%a%d]", "[^%s]", "[]]", "[^]]", "[a-]", "[%-]", "[.]", "[^a-z]", "[%w_]", "[-a]", "[%]]", "[a%-z]")
+		case 6:
+			atomp = "(" + pick(g.ht, "a", "%a+", "%d*", ".", "[ab]", "%w+", "x?", "%s*", "..") + ")"
+		case 7:
+			atomp = pick(g.ht, "()", "%b()", "%b[]", "%bab", "%f[%w]", "%f[%W]", "%f[a]", "%b<>")
+		case 8:
+			atomp = pick(g.ht, ".", "..", "a.", ".b")
+		default:
+			atomp = pick(g.ht, "ab", "abc", "12", "a b")
+		}
+		if Known.frontierBoundary && strings.HasPrefix(atomp, "%f") {
+			atomp = "%bab"
+		}
+		b.WriteString(atomp)
+		if chance(g.ht, 35) && !strings.HasPrefix(atomp, "(") && !strings.HasPrefix(atomp, "%b") && !strings.HasPrefix(atomp, "%f") {
+			b.WriteString(pick(g.ht, "*", "+", "-", "?"))
+		}
+	}
+	if chance(g.ht, 20) {
+		b.WriteString("$")
+	}
+	p := b.String()
+	if chance(g.ht, 8) {
+		// malformed only at the first element: the reference validates a pattern as it matches, so a malformed tail after a failing head is no error there
+		p = pick(g.ht, "", "%", "[a", "[", "%1", "%b", "%f", "^^a", "$$", "%z", "[%z]", "%g", "(%")
+		if Known.patternIncomplete && (p == "%b" || p == "%f") {
+			p = "%bxy"
+		}
+		if Known.patternTrailingPercent && strings.HasSuffix(p, "%") {
+			p = "%%"
+		}
+	}
+	return "\"" + strings.ReplaceAll(strings.ReplaceAll(p, "\\", "\\\\"), "\"", "\\\"") + "\""
+}
+
+// subject is a string with letters, digits, spaces and punctuation for the
+// pattern functions to chew on.
+func (g *gen) subject() string {
+	if chance(g.ht, 30) {
+		x := g.expr(kStr, 1)
+		if x.prec < atomPrec {
+			return "(" + x.s + ")"
+		}
+		return x.s
+	}
+	k := n(g.ht, 1, 8) // never empty: the reference does not look at a pattern it never tries
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		b.WriteString(pick(g.ht, "a", "b", "c", "x", "1", "2", "9", " ", "_", "-", ".", ",", "(", ")", "[", "]", "<", ">", "ab", "hello", "42", "A", "%"))
+	}
+	return "\"" + b.String() + "\""
+}
+
+func (g *gen) strExpr(d int) ex {
+	switch n(g.ht, 1, 22) {
+	case 1, 2, 3:
+		return g.bin(opConcat, g.expr(kStr, d-1), g.expr(kStr, d-1))
+	case 4:
+		// concatenation coerces numbers
+		return g.bin(opConcat, g.numOrStr(d-1), g.numOrStr(d-1))
+	case 5, 6:
+		return g.strMethod(d - 1)
+	case 7:
+		if chance(g.ht, 40) {
+			return atom(fmt.Sprintf("tostring(%s)", g.safeNum(d-1).s))
+		}
+		return atom(fmt.Sprintf("tostring(%s)", g.expr(pick(g.ht, kStr, kBool, kNil), d-1).s))
+	case 8:
+		return atom(fmt.Sprintf("type(%s)", g.expr(kAny, d-1).s))
+	case 9, 10:
+		return g.formatCall(d - 1)
+	case 11:
+		return g.patternCall(d - 1)
+	case 12:
+		args := pick(g.ht, "", `, ","`, `, ", "`, `, "", 2`, `, "-", 1, 2`, `, "", 2, 1`, `, "x", 3`, `, nil`, `, "", 0`)
+		tab := g.seqTabOf(kStr, d-1)
+		if chance(g.ht, 40) {
+			tab = g.safeNumTab(d - 1)
+		}
+		if Known.concatNilRange && (strings.HasSuffix(args, ", 0") || strings.Contains(args, ", 1, 2") || strings.HasSuffix(args, ", 2") || strings.HasSuffix(args, ", 3")) ||
+			Known.concatClamp && strings.HasSuffix(args, ", 2, 1") {
+			// a range: only over a table known to cover it
+			tab = atom(fmt.Sprintf("{%s, %s, %s}", g.safeNum(0).s, g.safeNum(0).s, g.safeNum(0).s))
+			if strings.HasSuffix(args, ", 0") {
+				args = `, "-", 1, 3`
+			}
+		}
+		x := fmt.Sprintf("table.concat(%s%s)", tab.s, args)
+		if Known.concatSingleNumber {
+			x = "(" + x + " .. \"\")"
+		}
+		return atom(x)
+	case 13:
+		c := pick(g.ht, "65", "97, 98, 99", "0", "255", "48, 57", "", "65.0", "300", "-1", "10, 9")
+		if Known.charRange && (c == "300" || c == "-1") {
+			c = "65"
+		}
+		return atom(fmt.Sprintf("string.char(%s)", c))
+	case 14:
+		return atom(fmt.Sprintf("string.rep(%s, %s)", g.expr(kStr, d-1).s, pick(g.ht, "0", "1", "2", "3", "-1", "2.5", "10", "0.5")))
+	case 15:
+		c := g.expr(kBool, d-1)
+		return g.bin(opOr, g.bin(opAnd, c, g.expr(kStr, d-1)), g.expr(kStr, d-1))
+	case 16:
+		return g.indexStr(d - 1)
+	case 17:
+		return g.callFunc(kStr, d-1)
+	case 18:
+		return atom(fmt.Sprintf("(%s):sub(%s)", g.expr(kStr, d-1).s, pick(g.ht, "1", "2", "-1", "0", "1, 1", "2, -2", "-3, -1", "1, 100", "3, 2", "0, 0", "-100, 2", "2, 2.5", "1.5", "5, 3", "-1, -3")))
+	case 19:
+		lhs := pick(g.ht, "1", "1.5", "0.1", "100", "10/2", "2^31", "-7", "1e15", "2^53", "-tonumber('0')", "1/3", "1e100", "0.30000000000000004")
+		if Known.numberToString {
+			lhs = pick(g.ht, "1", "1.5", "0.1", "100", "10/2", "2^31", "-7", "0.5", "2.25", "1e-3")
+		}
+		return atom(fmt.Sprintf("%s .. %s", lhs, pick(g.ht, `""`, `"x"`, "2", "3.5")))
+	case 20:
+		return g.paren(g.strExpr(d - 1))
+	case 21:
+		m := pick(g.ht, "upper", "lower", "reverse", "reverse", "upper", "lower") // no len: this is a string expression
+		s := g.expr(kStr, d-1).s
+		if Known.caseNonASCII && (m == "upper" || m == "lower") {
+			s = "(" + s + "):gsub('[\\128-\\255]', '')"
+		}
+		return atom(fmt.Sprintf("(%s):%s()", s, m))
+	default:
+		return atom(g.strLit())
+	}
+}
+
+func (g *gen) strMethod(d int) ex {
+	s := g.expr(kStr, d)
+	ss := s.s
+	if s.prec < atomPrec {
+		ss = "(" + ss + ")"
+	}
+	switch n(g.ht, 1, 6) {
+	case 1:
+		if Known.caseNonASCII {
+			return atom("((" + ss + "):gsub('[\\128-\\255]', '')):upper()")
+		}
+		return atom(ss + ":upper()")
+	case 2:
+		if Known.caseNonASCII {
+			return atom("((" + ss + "):gsub('[\\128-\\255]', '')):lower()")
+		}
+		return atom(ss + ":lower()")
+	case 3:
+		return atom(ss + ":reverse()")
+	case 4:
+		return atom(fmt.Sprintf("%s:sub(%s, %s)", ss, g.expr(kNum, 0).s, g.expr(kNum, 0).s))
+	case 5:
+		return atom(fmt.Sprintf("%s:rep(%d)", ss, n(g.ht, 0, 3)))
+	default:
+		m := pick(g.ht, "upper", "lower", "reverse")
+		if Known.caseNonASCII && m != "reverse" {
+			ss = "(" + ss + ":gsub('[\\128-\\255]', ''))"
+		}
+		return atom(fmt.Sprintf("string.%s(%s)", m, ss))
+	}
+}
+
+// noNul strips NUL bytes from a string argument of %s: the reference's
+// sprintf stops at an embedded NUL (a C quirk, not judged).
+func (g *gen) noNul(s string) string {
+	return "((" + s + "):gsub('%z', ''))"
+}
+
+// numOrZero makes a number expression that may be nil (tonumber of junk) a
+// number for %d: GopherLua prints nil as &{} where the reference fails
+// (gopher-lua/8).
+func (g *gen) numOrZero(s string) string {
+	if Known.formatArgs {
+		// nil -> 0; nan and the infinities -> 0 too (their spelling is the platform's, not
+		// judged) - compared with 1/0, not math.huge, which is finite in GopherLua (gopher-lua/28)
+		return "(function(z) if z ~= z or z == 1/0 or z == -1/0 then return 0 end return z or 0 end)(" + s + ")"
+	}
+	return s
+}
+
+func (g *gen) formatCall(d int) ex {
+	k := n(g.ht, 0, 3)
+	var f strings.Builder
+	var args []string
+	for i := 0; i < k; i++ {
+		if chance(g.ht, 30) {
+			f.WriteString(pick(g.ht, "a", " ", "-", ":", "%%", "x"))
+		}
+		switch n(g.ht, 1, 12) {
+		case 1, 2:
+			f.WriteString(pick(g.ht, "%d", "%5d", "%-5d", "%05d", "%+d", "%i", "%.3d", "% d"))
+			args = append(args, g.numOrZero(g.expr(kNum, d).s))
+		case 3:
+			c := pick(g.ht, "%x", "%X", "%o", "%#x", "%08x", "%c")
+			if Known.formatG && c == "%#x" {
+				c = "%x"
+			}
+			f.WriteString(c)
+			a := pick(g.ht, "65", "255", "0", "16", "97", "3", "10")
+			if Known.formatCUTF8 && c == "%c" && a == "255" {
+				a = "66" // %c of a byte above 127 is its UTF-8 encoding: gopher-lua/61
+			}
+			if c == "%c" && a == "0" {
+				a = "65" // the reference's %c of 0 is an empty string (sprintf + strlen: a C quirk, not judged)
+			}
+			args = append(args, a)
+		case 4, 5:
+			f.WriteString(pick(g.ht, "%s", "%5s", "%-5s", "%.2s", "%10.3s", "%s"))
+			if Known.formatArgs {
+				if chance(g.ht, 30) {
+					args = append(args, g.safeNum(d).s)
+				} else {
+					args = append(args, g.noNul(g.expr(kStr, d).s))
+				}
+			} else {
+				args = append(args, g.expr(pick(g.ht, kStr, kStr, kNum, kBool, kNil), d).s)
+			}
+		case 6:
+			if Known.formatQ {
+				f.WriteString("%s")
+			} else {
+				f.WriteString("%q")
+			}
+			args = append(args, g.noNul(g.expr(kStr, d).s))
+		case 7, 8:
+			fl := pick(g.ht, "%f", "%.2f", "%10.3f", "%-8.1f", "%.0f", "%+.1f", "%e", "%.3e", "%E", "%g", "%.3g", "%G", "%10.4g")
+			if Known.formatG && (fl == "%g" || fl == "%G" || fl == "%10.4g") {
+				fl = "%.3g"
+			}
+			f.WriteString(fl)
+			args = append(args, g.safeNum(d).s) // finite: the spelling of nan is the platform's
+		case 9:
+			if Known.formatArgs {
+				c := pick(g.ht, "%d", "%x", "%5.1f")
+				f.WriteString(c)
+				if c == "%x" {
+					args = append(args, pick(g.ht, "3", "2^31", "255")) // %x of a negative is "-3" (gopher-lua/8)
+				} else {
+					args = append(args, pick(g.ht, "3", "-3", "2^31", "-1", "255"))
+				}
+			} else {
+				f.WriteString(pick(g.ht, "%d", "%x", "%5.1f"))
+				args = append(args, pick(g.ht, `"10"`, `"3.5"`, `"0x10"`, `"abc"`, "3.5", "-3.5", "2^31", "2^53", "-1", "1e100", "0/0", "1/0"))
+			}
+		case 10:
+			if Known.formatArgs {
+				f.WriteString("%d")
+				args = append(args, g.numOrZero(g.expr(kNum, d).s))
+			} else {
+				f.WriteString(pick(g.ht, "%s", "%d"))
+				// fewer arguments than conversions
+			}
+		case 11:
+			if Known.formatArgs {
+				f.WriteString(pick(g.ht, "%5d", "%-3d", "%.3f"))
+			} else {
+				f.WriteString(pick(g.ht, "%", "%y", "%10", "%-", "%.", "%ld", "%lld", "%100d", "%.100f", "%1$d", "%*d", "%a", "%n", "%p", "%hd", "%b", "%u"))
+			}
+			args = append(args, g.numOrZero(g.expr(kNum, d).s))
+		default:
+			f.WriteString(pick(g.ht, "%s"))
+			if Known.formatArgs {
+				args = append(args, g.noNul(g.expr(kStr, d).s))
+			} else {
+				args = append(args, g.expr(kAny, d).s)
+			}
+		}
+	}
+	if chance(g.ht, 20) && !(Known.formatPercentExtra && strings.Contains(f.String(), "%%")) {
+		args = append(args, g.expr(kAny, d).s) // extra arguments are ignored
+	}
+	all := append([]string{"\"" + f.String() + "\""}, args...)
+	if chance(g.ht, 50) {
+		return atom("string.format(" + strings.Join(all, ", ") + ")")
+	}
+	return atom("(" + all[0] + "):format(" + strings.Join(all[1:], ", ") + ")")
+}
+
+// gmSubjBind binds a gmatch subject to a local while gopher-lua/64 is open (a
+// generic for over (f() .. s):gmatch(p) dereferences a nil pointer): it returns
+// the binding statement and replaces *subj by the local's name.
+func (g *gen) gmSubjBind(subj *string) string {
+	if !Known.gmatchConcatCall {
+		return ""
+	}
+	s := *subj
+	*subj = "s"
+	return "local s = " + s + " "
+}
+
+func (g *gen) patternCall(d int) ex {
+	subj := g.subject()
+	pat := g.pattern()
+	init := pick(g.ht, "", "", ", 2", ", -1", ", 0", ", 100", ", -100")
+	if Known.initPastEnd && init == ", 100" {
+		init = ", 1" // an init past the end is clamped by the reference, not by GopherLua (gopher-lua/67)
+	}
+	switch n(g.ht, 1, 9) {
+	case 1, 2:
+		return atom(fmt.Sprintf("(%s:match(%s%s) or 'nomatch')", subj, pat, init))
+	case 3, 4:
+		return atom(fmt.Sprintf("(%s:gsub(%s, %s))", subj, pat, g.replacement(d)))
+	case 5:
+		lim := pick(g.ht, "0", "1", "2", "-1", "1.5", "100")
+		if Known.gsubLimit && (lim == "0" || lim == "-1") {
+			lim = "2"
+		}
+		return atom(fmt.Sprintf("(%s:gsub(%s, %s, %s))", subj, pat, g.replacement(d), lim))
+	case 6:
+		return atom(fmt.Sprintf("(function() local t = {} %sfor w in %s:gmatch(%s) do t[#t + 1] = w end return table.concat(t, '|') end)()", g.gmSubjBind(&subj), subj, gmPat(pat)))
+	case 7:
+		return atom(fmt.Sprintf("(function() local t = {} %sfor a, b in %s:gmatch(%s) do t[#t + 1] = tostring(a) .. '/' .. tostring(b) end return table.concat(t, '|') end)()", g.gmSubjBind(&subj), subj, gmPat(pat)))
+	case 8:
+		init2 := pick(g.ht, "", ", 2", ", -2", ", 1, true", ", 1, false", ", 0", ", 100", ", 4")
+		if Known.initPastEnd && (init2 == ", 100" || init2 == ", 4") {
+			init2 = ", 1" // gopher-lua/67 (subjects are 1..8 bytes; 4 may be past the end)
+		}
+		return atom(fmt.Sprintf("table.concat({%s:find(%s%s)}, ',')", subj, pat, init2))
+	default:
+		return atom(fmt.Sprintf("table.concat({%s:match(%s)}, ',')", subj, pat))
+	}
+}
+
+// gmPat is a gmatch pattern; while Known.gmatchAnchor a leading ^ is
+// stripped at run time (Lua 5.1 does not anchor there).
+func gmPat(pat string) string {
+	if Known.gmatchAnchor {
+		return "((" + pat + "):gsub('^%^', ''))"
+	}
+	return pat
+}
+
+func (g *gen) replacement(d int) string {
+	switch n(g.ht, 1, 7) {
+	case 1, 2:
+		r := pick(g.ht, "", "X", "%0", "%1", "<%0>", "%1%1", "%%", "%2", "%9", "a%", "%a", "[%0]", "%0%1", "\\\\")
+		if Known.gsubPercentEscape && (r == "a%" || r == "%a") {
+			r = "%%"
+		}
+		return "\"" + r + "\""
+	case 3:
+		if Known.gsubTableValue {
+			return pick(g.ht, `{a = "A", b = 1, c = false, x = "y"}`, `{}`, `{["1"] = "one", ab = true}`)
+		}
+		return pick(g.ht, `{a = "A", b = 1, c = false, x = "y"}`, `{}`, `{["1"] = "one", ab = true}`, `{a = {}}`)
+	case 4:
+		f := pick(g.ht, `function(c) return c:upper() end`, `function(c) return nil end`, `function(c) return false end`, `function(c) return #c end`, `function(a, b) return (b or '?') .. (a or '?') end`, `function(c) return {} end`, `string.upper`, `function() end`, `function(c) return 1.5 end`)
+		if Known.gsubTableValue && f == `function(c) return {} end` {
+			f = `function(c) return 'T' end`
+		}
+		return f
+	case 5:
+		if Known.gsubNumber {
+			return g.expr(kStr, d).s
+		}
+		return g.expr(kNum, d).s
+	case 6:
+		return g.expr(kStr, d).s
+	default:
+		if Known.gsubNumber {
+			return pick(g.ht, "nil", "true")
+		}
+		return pick(g.ht, "nil", "true", "3")
+	}
+}
+
+func (g *gen) boolExpr(d int) ex {
+	switch n(g.ht, 1, 14) {
+	case 1, 2, 3:
+		k := pick(g.ht, kNum, kStr, kBool, kNil, kTab, kAny)
+		return g.bin(cmpOp(pick(g.ht, "==", "~=")), g.expr(k, d-1), g.expr(k, d-1))
+	case 4, 5:
+		k := pick(g.ht, kNum, kNum, kStr)
+		return g.bin(cmpOp(pick(g.ht, "<", "<=", ">", ">=")), g.expr(k, d-1), g.expr(k, d-1))
+	case 6:
+		return g.unary("not", g.expr(pick(g.ht, kBool, kNil, kNum, kStr, kTab), d-1))
+	case 7, 8:
+		return g.bin(pick(g.ht, opAnd, opOr), g.expr(kBool, d-1), g.expr(kBool, d-1))
+	case 9:
+		return atom(fmt.Sprintf("rawequal(%s, %s)", g.expr(kAny, d-1).s, g.expr(kAny, d-1).s))
+	case 10:
+		return g.bin(cmpOp("=="), g.expr(kAny, d-1), atom("nil"))
+	case 11:
+		return atom(fmt.Sprintf("(pcall(%s))", g.pcallTarget(d-1)))
+	case 12:
+		return g.paren(g.boolExpr(d - 1))
+	case 13:
+		return g.callFunc(kBool, d-1)
+	default:
+		return atom(pick(g.ht, "true", "false"))
+	}
+}
+
+func (g *gen) pcallTarget(d int) string {
+	switch n(g.ht, 1, 6) {
+	case 1:
+		lvl := ""
+		if Known.errorLevel {
+			lvl = ", 0"
+		}
+		if Known.errorNumberMessage {
+			return "error, " + g.expr(pick(g.ht, kStr, kBool, kNil, kTab), d).s + lvl
+		}
+		return "error, " + g.expr(kAny, d).s + lvl
+	case 2:
+		return fmt.Sprintf("function() return %s end", g.expr(kAny, d).s)
+	case 3:
+		return fmt.Sprintf("function() return %s + %s end", g.expr(kAny, d).s, g.expr(kAny, d).s)
+	case 4:
+		return fmt.Sprintf("function() return (%s)[1] end", g.expr(kAny, d).s)
+	case 5:
+		return fmt.Sprintf("function() return (%s)() end", g.expr(kAny, d).s)
+	default:
+		mk := pick(g.ht, kStr, kNum, kTab, kNil)
+		if Known.assertNumberMessage && mk == kNum {
+			mk = kStr
+		}
+		return fmt.Sprintf("function() assert(%s, %s) end", g.expr(kAny, d).s, g.expr(mk, d).s)
+	}
+}
+
+func (g *gen) nilExpr(d int) ex {
+	switch n(g.ht, 1, 6) {
+	case 1:
+		return atom(fmt.Sprintf("(%s).%s", g.expr(kTab, d-1).s, pick(g.ht, "missing", "zz", "n")))
+	case 2:
+		return atom(fmt.Sprintf("(%s)[%s]", g.expr(kTab, d-1).s, pick(g.ht, "100", "-1", "0", "1.5", `"q"`, "true", "{}")))
+	case 3:
+		return atom("(function() end)()")
+	case 4:
+		return atom("(select(5, 1, 2))")
+	case 5:
+		return atom(fmt.Sprintf("(%s)[%s]", g.expr(kTab, d-1).s, g.expr(pick(g.ht, kNum, kStr), d-1).s))
+	default:
+		return atom("nil")
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Tables.
+
+func (g *gen) tabExpr(d int) ex {
+	switch n(g.ht, 1, 10) {
+	case 1, 2, 3, 4:
+		return g.tabLit(d - 1)
+	case 5:
+		return atom(fmt.Sprintf("{%s}", g.exprList(d-1, n(g.ht, 0, 3))))
+	case 6:
+		return atom(fmt.Sprintf("setmetatable(%s, %s)", g.tabLit(d-1).s, g.metatable(d-1)))
+	case 7:
+		return g.callFunc(kTab, d-1)
+	case 8:
+		return atom(fmt.Sprintf("{%s}", g.multiCall(d-1)))
+	case 9:
+		return atom(fmt.Sprintf("{%s:byte(1, -1)}", g.expr(kStr, d-1).s))
+	default:
+		return g.tabLit(d - 1)
+	}
+}
+
+func (g *gen) tabLit(d int) ex {
+	k := n(g.ht, 0, 4)
+	parts := make([]string, 0, k)
+	for i := 0; i < k; i++ {
+		switch n(g.ht, 1, 6) {
+		case 1, 2, 3:
+			parts = append(parts, g.expr(kAny, d).s)
+		case 4:
+			parts = append(parts, fmt.Sprintf("%s = %s", pick(g.ht, "a", "b", "x", "n", "s", "k"), g.keyedValue(d)))
+		case 5:
+			parts = append(parts, fmt.Sprintf("[%s] = %s", g.keyExpr(pick(g.ht, kNum, kStr, kBool, kTab), d), g.keyedValue(d)))
+		default:
+			// no -0 key: -0 and 0 are one key, and which spelling the table keeps depends on the
+			// insertion history ({[0] = nil, [-0] = false} keeps 0 in the reference, -0 in GopherLua)
+			parts = append(parts, fmt.Sprintf("[%s] = %s", pick(g.ht, "10", "20", "0", "-1", "1.5", "2^53", `"1"`, "true", "1e100", "0/0 == 0/0 and 1 or 2"), g.keyedValue(d)))
+		}
+	}
+	sep := pick(g.ht, ", ", ", ", "; ")
+	s := strings.Join(parts, sep)
+	if len(parts) > 0 && chance(g.ht, 20) {
+		s += strings.TrimSpace(sep)
+	}
+	return atom("{" + s + "}")
+}
+
+// keyedValue is the value of a keyed constructor field; while
+// Known.constructorCall a call there is parenthesised.
+func (g *gen) keyedValue(d int) string {
+	s := g.expr(kAny, d).s
+	if Known.constructorCall {
+		return "(" + s + ")"
+	}
+	return s
+}
+
+func (g *gen) seqTabOf(k kind, d int) ex {
+	for _, v := range g.visible(kTab) {
+		if v.seq && (v.elem == k) && !v.fixed && chance(g.ht, 60) {
+			return atom(v.name)
+		}
+	}
+	m := n(g.ht, 0, 4)
+	parts := make([]string, m)
+	for i := range parts {
+		parts[i] = g.expr(k, d).s
+	}
+	return atom("{" + strings.Join(parts, ", ") + "}")
+}
+
+func (g *gen) metatable(d int) string {
+	k := n(g.ht, 1, 3)
+	var parts []string
+	for i := 0; i < k; i++ {
+		switch n(g.ht, 1, 12) {
+		case 1, 2:
+			parts = append(parts, fmt.Sprintf("__index = %s", pick(g.ht, `{a = 1, b = "B", [1] = "one"}`, `function(t, k) return k end`, `function(t, k) if type(k) == 'table' or type(k) == 'function' then return -1 end return #tostring(k) end`, `{}`, `function(t, k) return nil end`)))
+		case 3:
+			parts = append(parts, fmt.Sprintf("__newindex = %s", pick(g.ht, `function(t, k, v) rawset(t, k, v .. "!") end`, `function(t, k, v) end`, `function(t, k, v) rawset(t, "last", k) end`, `{}`)))
+		case 4:
+			parts = append(parts, fmt.Sprintf("__%s = function(a, b) return %s end", pick(g.ht, "add", "sub", "mul", "div", "mod", "pow", "concat"), pick(g.ht, "1", `"m"`, "type(a) .. type(b)", "a", "b", "{}", "rawequal(a, b)")))
+		case 5:
+			parts = append(parts, fmt.Sprintf("__eq = function(a, b) return %s end", pick(g.ht, "true", "false", "1", "nil", "rawequal(a, b)")))
+		case 6:
+			parts = append(parts, fmt.Sprintf("__%s = function(a, b) return %s end", pick(g.ht, "lt", "le"), pick(g.ht, "true", "false", "1", "nil")))
+		case 7:
+			parts = append(parts, fmt.Sprintf("__call = function(self, ...) return %s end", pick(g.ht, "select('#', ...)", "self", "...", "42", `"called"`, "(...)")))
+		case 8:
+			parts = append(parts, fmt.Sprintf("__tostring = function(t) return %s end", pick(g.ht, `"T"`, "'obj'", "1", "nil", "{}", "rawget(t, 1)")))
+		case 9:
+			parts = append(parts, fmt.Sprintf("__unm = function(a) return %s end", pick(g.ht, "0", `"neg"`, "a")))
+		case 10:
+			if !Known.lenMetamethod {
+				parts = append(parts, fmt.Sprintf("__len = function(a) return %s end", pick(g.ht, "99", "0", `"len"`, "nil")))
+			}
+		case 11:
+			parts = append(parts, fmt.Sprintf("__metatable = %s", pick(g.ht, `"locked"`, "false", "{}", "1")))
+		default:
+			// no __mode: what a weak table still holds when it is serialised depends on when the
+			// reference's collector ran (and GopherLua's tables are never weak: gopher-lua/69)
+			parts = append(parts, fmt.Sprintf("__unm = function(t) return %s end", pick(g.ht, `0`, `"neg"`, `t`)))
+		}
+	}
+	return "{" + strings.Join(parts, ", ") + "}"
+}
+
+func (g *gen) tabOperand(d int) string {
+	x := g.expr(kTab, d)
+	if x.prec < atomPrec {
+		return "(" + x.s + ")"
+	}
+	return x.s
+}
+
+func (g *gen) indexNum(d int) ex {
+	switch n(g.ht, 1, 5) {
+	case 1:
+		return atom(fmt.Sprintf("(%s[%s] or 0)", g.tabOperand(d), g.expr(pick(g.ht, kNum, kStr), d).s))
+	case 2:
+		return atom(fmt.Sprintf("(%s.%s or 0)", g.tabOperand(d), pick(g.ht, "a", "b", "x", "n")))
+	case 3:
+		return atom(fmt.Sprintf("#%s", g.seqTab(d).s))
+	case 4:
+		if Known.maxnLargeKey {
+			return atom(fmt.Sprintf("table.maxn(%s)", g.seqTab(d).s))
+		}
+		return atom(fmt.Sprintf("table.maxn(%s)", g.tabOperand(d)))
+	default:
+		return atom(fmt.Sprintf("(rawget(%s, %s) or 0)", g.tabOperand(d), g.expr(pick(g.ht, kNum, kStr), d).s))
+	}
+}
+
+func (g *gen) indexStr(d int) ex {
+	switch n(g.ht, 1, 3) {
+	case 1:
+		return atom(fmt.Sprintf("(%s[%s] or 'none')", g.tabOperand(d), g.expr(pick(g.ht, kNum, kStr), d).s))
+	case 2:
+		return atom(fmt.Sprintf("(%s.%s or 'none')", g.tabOperand(d), pick(g.ht, "a", "b", "x", "s")))
+	default:
+		return atom(fmt.Sprintf("(rawget(%s, %s) or 'none')", g.tabOperand(d), g.expr(pick(g.ht, kNum, kStr), d).s))
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Functions and calls.
+
+func (g *gen) funcExpr(d int) ex {
+	if chance(g.ht, 25) {
+		f := pick(g.ht, "string.upper", "string.len", "tostring", "type", "math.floor", "select", "rawequal", "print", "table.concat", "unpack", "next", "pairs", "ipairs", "tonumber", "string.format", "error", "pcall", "setmetatable", "assert", "rawget", "string.rep")
+		if Known.errorNoValue && f == "error" {
+			f = "assert" // a stored error called with no arguments: gopher-lua/5
+		}
+		if Known.setmetatableArgs && f == "setmetatable" {
+			f = "type" // a stored setmetatable called with whatever arguments: gopher-lua/19
+		}
+		return atom(f)
+	}
+	return g.funcLit(d - 1)
+}
+
+func (g *gen) funcLit(d int) ex {
+	np := n(g.ht, 0, 3)
+	params := make([]string, np)
+	saved := g.vars
+	savedVararg := g.vararg
+	if Known.caughtErrorDetachesUpvalues {
+		// no upvalues while gopher-lua/68 is open: an error caught anywhere between this
+		// closure's creation and a later use of a shared local would detach it
+		g.vars = nil
+	}
+	for i := range params {
+		params[i] = g.fresh("p")
+		g.vars = append(g.vars, variable{name: params[i], k: pick(g.ht, kNum, kStr, kAny)})
+	}
+	g.vararg = chance(g.ht, 30)
+	if g.vararg {
+		params = append(params, "...")
+	}
+	g.funcs++
+	body := g.block(d, n(g.ht, 0, 2))
+	ret := g.retStmt(d)
+	g.funcs--
+	g.vars = saved
+	g.vararg = savedVararg
+	sep := " "
+	if body != "" {
+		sep = "\n" + body + "\n"
+	}
+	return atom(fmt.Sprintf("function(%s)%s%s end", strings.Join(params, ", "), sep, ret))
+}
+
+func (g *gen) retStmt(d int) string {
+	if g.vararg && chance(g.ht, 30) {
+		return pick(g.ht, "return ...", "return select('#', ...)", "return (...)", "return {...}", "return select(2, ...)", "return ..., 'end'", "return #{...}", "local a, b = ... return b, a", "return select(-1, ...)")
+	}
+	switch n(g.ht, 1, 6) {
+	case 1:
+		return ""
+	case 2:
+		return "return"
+	case 3:
+		return "return " + g.exprList(d, n(g.ht, 2, 3))
+	default:
+		return "return " + g.expr(kAny, d).s
+	}
+}
+
+func (g *gen) exprList(d, k int) string {
+	parts := make([]string, k)
+	for i := range parts {
+		if i == k-1 && chance(g.ht, 25) {
+			parts[i] = g.multiCall(d)
+		} else {
+			parts[i] = g.expr(kAny, d).s
+		}
+	}
+	return strings.Join(parts, ", ")
+}
+
+// multiCall is an expression that may produce several values.
+func (g *gen) multiCall(d int) string {
+	switch n(g.ht, 1, 8) {
+	case 1:
+		return fmt.Sprintf("unpack(%s)", g.seqTab(d).s)
+	case 2:
+		return fmt.Sprintf("unpack(%s, %s)", g.seqTab(d).s, pick(g.ht, "2", "1, 3", "0", "-1, 1", "3, 2", "1, 1", "2, 4"))
+	case 3:
+		return fmt.Sprintf("select(%s, %s)", pick(g.ht, "1", "2", "-1", "-2", "3", "'#'", "1.5", "0", "-10"), g.exprList(d, n(g.ht, 0, 3)))
+	case 4:
+		return fmt.Sprintf("(function(...) return ... end)(%s)", g.exprList(d, n(g.ht, 0, 3)))
+	case 5:
+		return fmt.Sprintf("(%s):byte(1, -1)", g.expr(kStr, d).s)
+	case 6:
+		return fmt.Sprintf("(%s):find(%s)", g.subject(), g.pattern())
+	case 7:
+		return fmt.Sprintf("(pcall(%s))", g.pcallTarget(d))
+	default:
+		if g.vararg {
+			return "..."
+		}
+		return fmt.Sprintf("(%s):gsub(%s, %s)", g.subject(), g.pattern(), g.replacement(d))
+	}
+}
+
+// callFunc calls a visible local function that returns kind k, or a literal.
+func (g *gen) callFunc(k kind, d int) ex {
+	var fs []variable
+	for _, v := range g.visible(kFunc) {
+		if v.ret == k {
+			fs = append(fs, v)
+		}
+	}
+	if len(fs) > 0 && chance(g.ht, 70) {
+		f := fs[n(g.ht, 0, len(fs)-1)]
+		args := make([]string, f.np)
+		for i := range args {
+			args[i] = g.expr(kNum, d).s
+		}
+		if chance(g.ht, 20) {
+			args = append(args, g.expr(kAny, d).s) // extra argument
+		}
+		if len(args) > 0 && chance(g.ht, 20) {
+			args = args[:len(args)-1] // missing argument
+		}
+		return atom(fmt.Sprintf("%s(%s)", f.name, strings.Join(args, ", ")))
+	}
+	switch k {
+	case kNum:
+		mul := "a * b"
+		if Known.negZero {
+			mul = "a * b + 0" // 21 * -0: gopher-lua/56
+		}
+		return atom(fmt.Sprintf("(function(a, b) return %s end)(%s, %s)", pick(g.ht, "a + b", mul, "a - b", "b", "a", "(a or 0) + (b or 0)"), g.expr(kNum, d).s, g.expr(kNum, d).s))
+	case kStr:
+		shape := pick(g.ht, "table.concat({...}, ',', 1, select('#', ...))", "(type((...)) == 'string' and (...)) or ''", "tostring(select('#', ...))", "type(...)")
+		if Known.concatClamp && strings.HasPrefix(shape, "table.concat") {
+			// a nil argument in the range: the reference refuses it, GopherLua clamps the range to the border (gopher-lua/14, 57)
+			// numbers reduced to a small integer, since their spelling is gopher-lua/13 (nan and
+			// the infinities go with them: the range test rather than a comparison with
+			// math.huge, which is finite in GopherLua, gopher-lua/28; + 0 for a -0 remainder,
+			// gopher-lua/20); .. "" because a single number comes back as a number (gopher-lua/15)
+			shape = "(function(n, t) for i = 1, n do local z = t[i] if z == nil then t[i] = 'nil' elseif type(z) == 'number' then if z ~= z or z >= 2^53 or z <= -2^53 then t[i] = 0 else t[i] = math.floor(z) % 100 + 0 end end end return table.concat(t, ',', 1, n) .. '' end)(select('#', ...), {...})"
+		}
+		return atom(fmt.Sprintf("(function(...) return %s end)(%s)", shape, g.exprList(d, n(g.ht, 0, 3))))
+	case kBool:
+		return atom(fmt.Sprintf("(function(x) return %s end)(%s)", pick(g.ht, "not x", "x == nil", "x ~= x", "not not x", "x and true or false"), g.expr(kAny, d).s))
+	default:
+		return atom(fmt.Sprintf("(function(...) return {...} end)(%s)", g.exprList(d, n(g.ht, 0, 3))))
+	}
+}
+
+func (g *gen) callNumFunc(d int) ex { return g.callFunc(kNum, d) }
+
+// ---------------------------------------------------------------------------
+// Statements.
+
+func (g *gen) indent() string { return strings.Repeat("  ", g.depth) }
+
+// block generates k statements in a new scope and returns them as lines.
+func (g *gen) block(d, k int) string {
+	saved := g.vars
+	g.depth++
+	var lines []string
+	for i := 0; i < k && g.tick(); i++ {
+		if s := g.stmt(d); s != "" {
+			lines = append(lines, g.indent()+s)
+		}
+	}
+	g.depth--
+	g.vars = saved
+	return joinStmts(lines)
+}
+
+// joinStmts joins statements on lines; while Known.ambiguousCall a
+// statement starting with a parenthesis gets a semicolon after the one
+// before it, since Lua 5.1 rejects the two-line form as ambiguous.
+func joinStmts(lines []string) string {
+	if Known.ambiguousCall {
+		for i := 1; i < len(lines); i++ {
+			if strings.HasPrefix(strings.TrimLeft(lines[i], " "), "(") && !strings.HasSuffix(lines[i-1], ";") && strings.TrimSpace(lines[i-1]) != "" {
+				lines[i-1] += ";" // one only: ;; is an empty statement (gopher-lua/66)
+			}
+		}
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (g *gen) stmt(d int) string {
+	switch n(g.ht, 1, 24) {
+	case 1, 2, 3, 4, 5:
+		return g.localStmt(d)
+	case 6, 7:
+		return g.assignStmt(d)
+	case 8, 9:
+		return g.ifStmt(d)
+	case 10:
+		return g.numericFor(d)
+	case 11:
+		return g.whileStmt(d)
+	case 12:
+		return g.repeatStmt(d)
+	case 13:
+		return g.genericFor(d)
+	case 14, 15:
+		return g.localFunc(d)
+	case 16, 17:
+		return g.tableStmt(d)
+	case 18:
+		return fmt.Sprintf("do\n%s\n%send", g.block(d, n(g.ht, 1, 2)), g.indent())
+	case 19:
+		return g.callStmt(d)
+	case 20:
+		if g.loops > 0 && !(Known.breakGenericFor && g.generic > 0) {
+			return "break"
+		}
+		return g.localStmt(d)
+	case 21:
+		return g.closureStmt(d)
+	case 22:
+		return g.coroutineStmt(d)
+	case 23:
+		return g.localStmt(d) + pick(g.ht, ";", "", " ;")
+	default:
+		return g.localStmt(d)
+	}
+}
+
+func (g *gen) localStmt(d int) string {
+	k := n(g.ht, 1, 3)
+	names := make([]string, k)
+	kinds := make([]kind, k)
+	for i := range names {
+		names[i] = g.fresh("v")
+		kinds[i] = pick(g.ht, kNum, kNum, kStr, kStr, kBool, kTab, kTab, kFunc, kNil)
+	}
+	var vals []string
+	m := k
+	if chance(g.ht, 25) {
+		m = n(g.ht, 0, k+1) // adjustment: fewer or more values
+	}
+	var multi bool
+	for i := 0; i < m; i++ {
+		if i < k {
+			if i == m-1 && chance(g.ht, 20) {
+				vals = append(vals, g.multiCall(d))
+				multi = true
+			} else {
+				vals = append(vals, g.expr(kinds[i], d).s)
+			}
+		} else {
+			vals = append(vals, g.expr(kAny, d).s)
+		}
+	}
+	for i, name := range names {
+		v := variable{name: name, k: kinds[i]}
+		if i >= m || multi && i >= m-1 {
+			v.k = kAny
+		}
+		if kinds[i] == kTab {
+			// a sequence only when built from plain literals: any hole makes # a choice
+			v.elem = kAny
+			if i < len(vals) {
+				val := vals[i]
+				v.seq = strings.HasPrefix(val, "{") && !strings.ContainsAny(val, "=(") && !strings.Contains(val, "nil") && !strings.Contains(val, "...")
+			}
+		}
+		g.vars = append(g.vars, v)
+	}
+	if m == 0 {
+		return "local " + strings.Join(names, ", ")
+	}
+	return "local " + strings.Join(names, ", ") + " = " + strings.Join(vals, ", ")
+}
+
+func minInt(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+func (g *gen) assignStmt(d int) string {
+	vs := g.visible(kAny)
+	if len(vs) == 0 {
+		return g.localStmt(d)
+	}
+	k := n(g.ht, 1, 2)
+	if Known.multiAssign {
+		k = 1
+	}
+	var names, vals []string
+	for i := 0; i < k; i++ {
+		v := vs[n(g.ht, 0, len(vs)-1)]
+		if v.k == kFunc || v.k == kTab || v.fixed || (len(names) > 0 && names[0] == v.name) {
+			continue
+		}
+		names = append(names, v.name)
+		vals = append(vals, g.expr(v.k, d).s)
+	}
+	if len(names) == 0 {
+		return g.localStmt(d)
+	}
+	if len(names) == 2 && chance(g.ht, 30) {
+		// swap
+		return fmt.Sprintf("%s, %s = %s, %s", names[0], names[1], names[1], names[0])
+	}
+	return strings.Join(names, ", ") + " = " + strings.Join(vals, ", ")
+}
+
+func (g *gen) ifStmt(d int) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "if %s then\n%s\n", g.expr(pick(g.ht, kBool, kBool, kAny), d).s, g.block(d, n(g.ht, 1, 2)))
+	for i := n(g.ht, 0, 2); i > 0; i-- {
+		fmt.Fprintf(&b, "%selseif %s then\n%s\n", g.indent(), g.expr(kBool, d).s, g.block(d, 1))
+	}
+	if chance(g.ht, 50) {
+		fmt.Fprintf(&b, "%selse\n%s\n", g.indent(), g.block(d, 1))
+	}
+	b.WriteString(g.indent() + "end")
+	return b.String()
+}
+
+func (g *gen) numericFor(d int) string {
+	acc := g.fresh("acc")
+	i := g.fresh("i")
+	lo := pick(g.ht, "1", "0", "-2", "3", "1.5", "10", "2^31") // not 2^53: i + 1 == i there, an endless loop on both sides
+	hi := pick(g.ht, "3", "5", "0", "-1", "4.5", "1", "10", "lo + 2", "lo", "lo - 1")
+	if strings.HasPrefix(hi, "lo") {
+		hi = lo + hi[2:]
+	}
+	if lo == "2^31" && !strings.HasPrefix(hi, lo) {
+		hi = lo + " + 1" // a small bound with a huge start would run for ages
+	}
+	step := pick(g.ht, "", "", ", 1", ", 2", ", -1", ", 0.5", ", -2", ", 3")
+	saved := g.vars
+	g.vars = append(g.vars, variable{name: i, k: kNum, fixed: true})
+	g.loops++
+	body := g.block(d, n(g.ht, 0, 2))
+	g.loops--
+	g.vars = saved
+	g.vars = append(g.vars, variable{name: acc, k: kNum})
+	upd := pick(g.ht, acc+" = "+acc+" + "+i, acc+" = "+acc+" * 2 + "+i, acc+" = "+acc+" + 1", acc+" = "+i)
+	if body != "" {
+		body += "\n"
+	}
+	return fmt.Sprintf("local %s = 0\n%sfor %s = %s, %s%s do\n%s%s  %s\n%send", acc, g.indent(), i, lo, hi, step, body, g.indent(), upd, g.indent())
+}
+
+func (g *gen) whileStmt(d int) string {
+	c := g.fresh("c")
+	limit := n(g.ht, 0, 4)
+	g.loops++
+	saved := g.vars
+	g.vars = append(g.vars, variable{name: c, k: kNum, fixed: true})
+	body := g.block(d, n(g.ht, 0, 2))
+	g.vars = saved
+	g.loops--
+	g.vars = append(g.vars, variable{name: c, k: kNum, fixed: true})
+	if body != "" {
+		body += "\n"
+	}
+	return fmt.Sprintf("local %s = 0\n%swhile %s < %d do\n%s%s  %s = %s + 1\n%send", c, g.indent(), c, limit, body, g.indent(), c, c, g.indent())
+}
+
+// keyExpr is an expression of kind k used as a table key. While gopher-lua/38
+// is open a computed number between 2^20 and 2^27 is folded into 0..999: a
+// key like 6 ^ 10 would otherwise make GopherLua allocate an array up to it
+// (hundreds of megabytes, a fatal out-of-memory for the whole test binary).
+func (g *gen) keyExpr(k kind, d int) string {
+	e := g.expr(k, d).s
+	if k == kNum && Known.sparseArrayAlloc {
+		return "(function(k) if k > 2^20 and k < 2^27 then return k % 1000 end return k end)(" + e + ")"
+	}
+	return e
+}
+
+func (g *gen) repeatStmt(d int) string {
+	c := g.fresh("r")
+	limit := n(g.ht, 1, 4)
+	g.loops++
+	saved := g.vars
+	g.vars = append(g.vars, variable{name: c, k: kNum, fixed: true})
+	nstmts := n(g.ht, 0, 2)
+	if Known.deadIfRepeat {
+		nstmts = 0 // a dead if with an else declaring locals breaks the loop: gopher-lua/58
+	}
+	body := g.block(d, nstmts)
+	g.vars = saved
+	g.loops--
+	g.vars = append(g.vars, variable{name: c, k: kNum, fixed: true})
+	if body != "" {
+		body += "\n"
+	}
+	// the until condition sees the body's locals
+	inner := g.fresh("done")
+	return fmt.Sprintf("local %s = 0\n%srepeat\n%s%s  %s = %s + 1\n%s  local %s = %s >= %d\n%suntil %s", c, g.indent(), body, g.indent(), c, c, g.indent(), inner, c, limit, g.indent(), inner)
+}
+
+func (g *gen) genericFor(d int) string {
+	t := g.seqTab(d).s
+	acc := g.fresh("acc")
+	k, v := g.fresh("k"), g.fresh("v")
+	saved := g.vars
+	g.vars = append([]variable(nil), g.vars...)
+	for i := range g.vars {
+		if g.vars[i].name == t {
+			g.vars[i].fixed = true // not modified while iterated (undefined in Lua)
+		}
+	}
+	g.vars = append(g.vars, variable{name: k, k: kNum, fixed: true}, variable{name: v, k: kAny, fixed: true})
+	g.loops++
+	g.generic++
+	bodyN := n(g.ht, 0, 1)
+	if Known.breakGenericFor {
+		bodyN = 0 // a body with a break or a dead if is miscompiled
+	}
+	body := g.block(d, bodyN)
+	g.generic--
+	g.loops--
+	g.vars = saved
+	g.vars = append(g.vars, variable{name: acc, k: kNum})
+	if body != "" {
+		body += "\n"
+	}
+	switch n(g.ht, 1, 4) {
+	case 1:
+		return fmt.Sprintf("local %s = 0\n%sfor %s, %s in ipairs(%s) do\n%s%s  %s = %s + %s\n%send", acc, g.indent(), k, v, t, body, g.indent(), acc, acc, k, g.indent())
+	case 2:
+		// pairs: the order is unspecified, so only count
+		return fmt.Sprintf("local %s = 0\n%sfor %s, %s in pairs(%s) do\n%s%s  %s = %s + 1\n%send", acc, g.indent(), k, v, t, body, g.indent(), acc, acc, g.indent())
+	case 3:
+		if Known.nextIterator {
+			return fmt.Sprintf("local %s = 0\n%sfor %s, %s in pairs(%s) do\n%s%s  %s = %s + (type(%s) == 'number' and %s or 0)\n%send", acc, g.indent(), k, v, t, body, g.indent(), acc, acc, v, v, g.indent())
+		}
+		return fmt.Sprintf("local %s = 0\n%sfor %s, %s in next, %s do\n%s%s  %s = %s + (type(%s) == 'number' and %s or 0)\n%send", acc, g.indent(), k, v, t, body, g.indent(), acc, acc, v, v, g.indent())
+	default:
+		return fmt.Sprintf("local %s = 0\n%sfor %s, %s in ipairs(%s) do\n%s%s  %s = %s + (type(%s) == 'number' and %s or 1)\n%send", acc, g.indent(), k, v, t, body, g.indent(), acc, acc, v, v, g.indent())
+	}
+}
+
+func (g *gen) localFunc(d int) string {
+	name := g.fresh("f")
+	np := n(g.ht, 0, 2)
+	params := make([]string, np)
+	saved := g.vars
+	ret := pick(g.ht, kNum, kStr, kBool, kTab, kAny)
+	if Known.caughtErrorDetachesUpvalues {
+		g.vars = nil // no upvalues: see funcLit
+	}
+	// not visible inside itself: an unguarded `return f()` never ends on either
+	// side; the bounded recursion below is the only self-call
+	for i := range params {
+		params[i] = g.fresh("a")
+		g.vars = append(g.vars, variable{name: params[i], k: kNum})
+	}
+	savedVararg := g.vararg
+	g.vararg = false
+	g.funcs++
+	body := g.block(d, n(g.ht, 0, 2))
+	var retS string
+	if ret == kNum && np >= 1 && chance(g.ht, 30) {
+		// bounded recursion
+		retS = fmt.Sprintf("if %s <= 0 then return %s end return %s(%s - 1) + %s", params[0], pick(g.ht, "0", "1"), name, params[0], pick(g.ht, "1", params[0], "2"))
+		body = fmt.Sprintf("%s  if %s > 40 then %s = 40 end\n%s", g.indent(), params[0], params[0], body)
+	} else {
+		retS = "return " + g.expr(ret, d).s
+	}
+	g.funcs--
+	g.vararg = savedVararg
+	g.vars = saved
+	g.vars = append(g.vars, variable{name: name, k: kFunc, ret: ret, np: np})
+	if body != "" {
+		body += "\n"
+	}
+	return fmt.Sprintf("local function %s(%s)\n%s%s  %s\n%send", name, strings.Join(params, ", "), body, g.indent(), retS, g.indent())
+}
+
+func (g *gen) tableStmt(d int) string {
+	var t string
+	tabs := g.visible(kTab)
+	if len(tabs) == 0 {
+		return g.localStmt(d)
+	}
+	tv := tabs[n(g.ht, 0, len(tabs)-1)]
+	if tv.fixed {
+		return g.localStmt(d)
+	}
+	t = tv.name
+	if !tv.seq {
+		// a table with holes: # is any border, so nothing that depends on it
+		switch n(g.ht, 1, 4) {
+		case 1:
+			return fmt.Sprintf("%s.%s = %s", t, pick(g.ht, "a", "b", "x", "n", "s", "k"), g.expr(kAny, d).s)
+		case 2:
+			return fmt.Sprintf("%s[%s] = %s", t, g.keyExpr(pick(g.ht, kNum, kStr, kBool), d), g.expr(kAny, d).s)
+		case 3:
+			return fmt.Sprintf("rawset(%s, %s, %s)", t, g.keyExpr(pick(g.ht, kNum, kStr), d), g.expr(kAny, d).s)
+		default:
+			return fmt.Sprintf("setmetatable(%s, %s)", t, g.metatable(d))
+		}
+	}
+	switch n(g.ht, 1, 10) {
+	case 1:
+		return fmt.Sprintf("%s[#%s + 1] = %s", t, t, g.expr(kAny, d).s)
+	case 2:
+		return fmt.Sprintf("%s.%s = %s", t, pick(g.ht, "a", "b", "x", "n", "s", "k"), g.expr(kAny, d).s)
+	case 3:
+		return fmt.Sprintf("table.insert(%s, %s)", t, g.expr(kAny, d).s)
+	case 4:
+		return fmt.Sprintf("table.insert(%s, %s, %s)", t, pick(g.ht, "1", "#"+t+" + 1", "#"+t), g.expr(kAny, d).s)
+	case 5:
+		pos := pick(g.ht, "", ", 1", ", 2", ", #"+t, ", 0", ", -1", ", 5")
+		if Known.removeOutOfRange && (pos == ", 0" || pos == ", -1") {
+			pos = ", 1"
+		}
+		return fmt.Sprintf("table.remove(%s%s)", t, pos)
+	case 6:
+		tab := g.seqTabOf(pick(g.ht, kNum, kStr), d).s
+		if Known.sortPastBorder {
+			// a nil in the constructor (tonumber of junk) is sorted along by GopherLua (gopher-lua/71): sort a copy up to the border
+			tab = "(function(t) local r = {} for i = 1, #t do if t[i] == nil then r[i] = 0 else r[i] = t[i] end end return r end)(" + tab + ")"
+		}
+		return fmt.Sprintf("table.sort(%s%s)", tab, pick(g.ht, "", "", ", function(a, b) return a > b end", ", function(a, b) return tostring(a) < tostring(b) end", ", function(a, b) return false end", ", function(a, b) return #tostring(a) < #tostring(b) end")) // strict orders only: the manual leaves an invalid order function undefined
+	case 7:
+		return fmt.Sprintf("%s[%s] = %s", t, g.expr(pick(g.ht, kStr, kBool), d).s, g.expr(kAny, d).s) // no numeric keys: no holes
+	case 8:
+		return fmt.Sprintf("rawset(%s, %s, %s)", t, g.expr(kStr, d).s, g.expr(kAny, d).s)
+	case 9:
+		return fmt.Sprintf("%s[%s] = nil", t, pick(g.ht, "#"+t, `"a"`, "0"))
+	default:
+		return fmt.Sprintf("setmetatable(%s, %s)", t, g.metatable(d))
+	}
+}
+
+func (g *gen) callStmt(d int) string {
+	fs := g.visible(kFunc)
+	if len(fs) > 0 && chance(g.ht, 60) {
+		f := fs[n(g.ht, 0, len(fs)-1)]
+		args := make([]string, f.np)
+		for i := range args {
+			args[i] = g.expr(kNum, d).s
+		}
+		return fmt.Sprintf("%s(%s)", f.name, strings.Join(args, ", "))
+	}
+	switch n(g.ht, 1, 5) {
+	case 1:
+		m := pick(g.ht, "", ", 'msg'", ", 42", ", {}", ", nil")
+		if Known.assertNumberMessage && m == ", 42" {
+			m = ", 'm'"
+		}
+		return fmt.Sprintf("assert(%s%s)", g.expr(kAny, d).s, m)
+	case 2:
+		// the value in parentheses: a call returning nothing would be error() (gopher-lua/5)
+		return fmt.Sprintf("error((%s)%s)", g.expr(pick(g.ht, kStr, kNum, kTab, kNil, kBool), d).s, pick(g.ht, "", ", 0", ", 1", ", 2", ", 3", ", -1"))
+	case 3:
+		return fmt.Sprintf("(%s)(%s)", g.expr(kFunc, d).s, g.exprList(d, n(g.ht, 0, 2)))
+	case 4:
+		return fmt.Sprintf("pcall(%s)", g.pcallTarget(d))
+	default:
+		m := pick(g.ht, "upper", "rep", "sub", "len", "byte", "format")
+		if Known.formatArgs && m == "format" {
+			m = "len" // an arbitrary string as a format: a lone trailing % is accepted (gopher-lua/8)
+		}
+		args := g.exprList(d, n(g.ht, 0, 2))
+		if Known.numericStringArgs && (m == "rep" || m == "sub" || m == "byte") {
+			args = g.expr(kNum, d).s // a numeric string where a number is expected: gopher-lua/9
+		}
+		return fmt.Sprintf("(%s):%s(%s)", g.expr(kStr, d).s, m, args)
+	}
+}
+
+// closureStmt builds closures in a loop; each iteration has its own copy of
+// the loop variable and of the body's locals.
+func (g *gen) closureStmt(d int) string {
+	fs := g.fresh("fs")
+	i := g.fresh("i")
+	res := g.fresh("cl")
+	n1 := n(g.ht, 1, 4)
+	saved := g.vars
+	g.vars = append(g.vars, variable{name: i, k: kNum, fixed: true})
+	inner := g.expr(kNum, d).s
+	g.vars = saved
+	g.vars = append(g.vars, variable{name: res, k: kTab, seq: true, elem: kNum}, variable{name: fs, k: kTab, seq: true, elem: kFunc})
+	shared := g.fresh("sh")
+	switch n(g.ht, 1, 3) {
+	case 1:
+		return fmt.Sprintf("local %s, %s = {}, {}\n%sfor %s = 1, %d do %s[%s] = function() return %s + %s end end\n%sfor %s = 1, %d do %s[%s] = %s[%s]() end", fs, res, g.indent(), i, n1, fs, i, i, inner, g.indent(), i, n1, res, i, fs, i)
+	case 2:
+		if Known.caughtErrorDetachesUpvalues && (strings.Contains(inner, "pcall") || strings.Contains(inner, "error")) {
+			inner = i // a caught error between the closures' creation and their calls detaches the shared variable (gopher-lua/68)
+		}
+		return fmt.Sprintf("local %s, %s, %s = {}, {}, 0\n%sfor %s = 1, %d do local x = %s %s[%s] = function() %s = %s + x return x end end\n%sfor %s = %d, 1, -1 do local r = %s[%s]() %s[%s] = r + %s end", fs, res, shared, g.indent(), i, n1, inner, fs, i, shared, shared, g.indent(), i, n1, fs, i, res, i, shared)
+	default:
+		return fmt.Sprintf("local %s, %s = {}, {}\n%sdo local %s = 0 while %s < %d do %s = %s + 1 local j = %s %s[%s] = function(z) j = j + (z or 0) return j end end end\n%sfor %s = 1, %d do %s[%s] = %s[%s](%s) + %s[%s](0) end", fs, res, g.indent(), i, i, n1, i, i, i, fs, i, g.indent(), i, n1, res, i, fs, i, inner, fs, i)
+	}
+}
+
+func (g *gen) coroutineStmt(d int) string {
+	res := g.fresh("co")
+	c := n(g.ht, 1, 6)
+	// the first shape stores the yielded x and y, which may be nil: then the table has
+	// holes and # (so unpack) may pick either border
+	g.vars = append(g.vars, variable{name: res, k: kTab, seq: c != 1, elem: kAny})
+	x := g.expr(kAny, d).s
+	y := g.expr(kAny, d).s
+	switch c {
+	case 1:
+		// the arguments in parentheses: a call returning nothing would make a gen() (gopher-lua/51)
+		return fmt.Sprintf("local %s = {}\n%sdo local gen = coroutine.wrap(function(a) local b = coroutine.yield(a) coroutine.yield(b, %s) return 'done' end)\n%s  %s[1] = gen((%s)) %s[2], %s[3] = gen((%s)) %s[4] = gen() end", res, g.indent(), y, g.indent(), res, x, res, res, y, res)
+	case 2:
+		return fmt.Sprintf("local %s = {}\n%sdo local co = coroutine.create(function(...) local n = select('#', ...) coroutine.yield(n) error(%s) end)\n%s  %s[1], %s[2] = coroutine.resume(co, %s) %s[3] = coroutine.status(co) %s[4] = coroutine.resume(co) %s[5] = coroutine.status(co) %s[6] = coroutine.resume(co) end", res, g.indent(), pick(g.ht, "{}", "'boom'", "42", "nil", "false"), g.indent(), res, res, x, res, res, res, res)
+	case 3:
+		return fmt.Sprintf("local %s = {}\n%sdo local co = coroutine.create(function() for i = 1, 3 do coroutine.yield(i * 10) end return 'fin' end)\n%s  for i = 1, 5 do local ok, v = coroutine.resume(co) %s[#%s + 1] = tostring(ok) .. ':' .. (ok and tostring(v) or type(v)) end %s[#%s + 1] = coroutine.status(co) end", res, g.indent(), g.indent(), res, res, res, res)
+	case 4:
+		return fmt.Sprintf("local %s = {}\n%sdo local co = coroutine.create(function() return %s end)\n%s  %s[1] = coroutine.status(co) %s[2] = select('#', coroutine.resume(co)) %s[3] = coroutine.status(co) %s[4] = coroutine.isyieldable and 1 or 0 %s[5] = coroutine.running() == nil %s[6] = select(2, pcall(coroutine.yield)) ~= nil end", res, g.indent(), x, g.indent(), res, res, res, res, res, res)
+	case 5:
+		return fmt.Sprintf("local %s = {}\n%sdo local gen = coroutine.wrap(function() coroutine.yield(1) end)\n%s  %s[1] = gen() %s[2] = gen() %s[3] = pcall(gen) %s[4] = pcall(gen) end", res, g.indent(), g.indent(), res, res, res, res)
+	default:
+		return fmt.Sprintf("local %s = {}\n%sdo local co = coroutine.create(function(a, b) local c, d = coroutine.yield(a + b) return c .. d end)\n%s  %s[1], %s[2] = coroutine.resume(co, 1, 2) %s[3], %s[4] = coroutine.resume(co, 'x', 'y') %s[5], %s[6] = coroutine.resume(co) %s[6] = type(%s[6]) %s[7] = coroutine.status(co) end", res, g.indent(), g.indent(), res, res, res, res, res, res, res, res)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Programs.
+
+// program is a Lua chunk: statements, then a return of visible values.
+func (g *gen) program() string {
+	k := n(g.ht, 0, 6)
+	var lines []string
+	for i := 0; i < k && g.tick(); i++ {
+		if s := g.stmt(2); s != "" {
+			lines = append(lines, s)
+		}
+	}
+	var rets []string
+	vs := g.visible(kAny)
+	for _, v := range vs {
+		if v.k == kFunc {
+			continue
+		}
+		rets = append(rets, v.name)
+	}
+	if len(rets) > 6 {
+		rets = rets[len(rets)-6:]
+	}
+	switch n(g.ht, 1, 6) {
+	case 1:
+		rets = append(rets, g.exprList(2, n(g.ht, 1, 3)))
+	case 2:
+		rets = append(rets, g.expr(kAny, 3).s)
+	case 3:
+		rets = []string{g.exprList(3, n(g.ht, 1, 3))}
+	}
+	if len(rets) > 0 {
+		lines = append(lines, "return "+strings.Join(rets, ", "))
+	}
+	src := joinStmts(lines)
+	if chance(g.ht, 4) {
+		src = g.mangle(src)
+	}
+	return src
+}
+
+// mangle injects a syntax-level variation, some of them errors.
+func (g *gen) mangle(src string) string {
+	switch n(g.ht, 1, 10) {
+	case 1:
+		m := pick(g.ht, "end", "return", "local", "x = = 1", "if then end", "for i = 1 do end", "local 1 = 2", "return return", "a.b.c = ", "f(", "{", "'unterminated", "[[unterminated", "goto x", "x = 1 y = 2", "local x <const> = 1", "::", "x = 1 // 2", "x = 1 & 2", "x = ~1", "x = 0x1p4", "x = 1e", "x = 08", "x = .e1", "x = 3..4", "x = 'a' 'b'", "::lbl::", "return;", "return 1;", ";", ";;", "do ; end", "x = #", "x = -", "x = 1 +", "local function() end", "function f.g:h() end", "function f() return end", "x = function() end()", "x = (f)", "x = a.b[c].d:e(f).g", "break", "return 1, 2, 3,", "x = {,}", "x = {1,,2}", "x = 1 .. .. 2", "x = not", "x = 'a\\", "x = '\\x'", "x = '\\u{41}'", "x = \"\n\"", "--[==[ comment\n]==] return 7", "--[[ unterminated", "#! shebang", "x = 9223372036854775808", "x = 0x", "x = 0xg", "x = 1.2.3", "x = 2^^3", "x = (1)(2)", "x = 1 2", "local a, = 1", "local , a = 1", "x, = 1", "x = y = 1", "x = 1 y = 2 return x + y", "return (1)", "return ((1))", "return (f())", "return 1;;", "local x = 1; local x = 2; return x")
+		if m == "::lbl::" {
+			m = "::" // labels and goto are GopherLua's documented Lua 5.2 extension, not judged
+		}
+		if Known.emptyStatement && (m == ";" || m == ";;" || m == "do ; end" || m == "return 1;;") {
+			m = "return;" // empty statements are accepted: gopher-lua/66
+		}
+		if Known.doubleSeparator && (m == "x = {1,,2}" || m == "x = {,}") {
+			m = "x = {1, 2}" // doubled separators are accepted: gopher-lua/50
+		}
+		return src + "\n" + m
+	case 2:
+		return strings.Replace(src, "local ", "", 1)
+	case 3:
+		return strings.Replace(src, "return", "return\n", 1)
+	case 4:
+		if Known.doubleSeparator {
+			return strings.Replace(src, " end\n", " end;\n", 1) // not before a , or ) inside an expression
+		}
+		return strings.Replace(src, " end", " end;", 1)
+	case 5:
+		return strings.Replace(src, "\n", " ", -1)
+	case 6:
+		return strings.Replace(src, "\n", "\r\n", -1)
+	case 7:
+		return "-- comment\n" + src
+	case 8:
+		return "--[[ block\ncomment ]] " + src
+	case 9:
+		return strings.Replace(src, " = ", "= ", 1)
+	default:
+		return src + " --[==[ tail ]==]"
+	}
+}
+
+// probes are fixed programs over the corners of the language and the
+// libraries; both implementations must agree on them like on any other.
+var probes = []string{
+	"for i = 1, 2, 0 do end",
+	"local t = {}\nt[nil] = 1",
+	"local t = {}\nt[0/0] = 1",
+	"return table.concat({1, {}, 3})",
+	"return table.concat({1, true})",
+	"return table.concat({1, nil, 3}, ',', 1, 3)",
+	"table.sort({3, 'a', 1})",
+	"table.sort({3, 1}, 5)",
+	"return setmetatable({}, 1)",
+	"local t = setmetatable({}, {__metatable = 'locked'}) setmetatable(t, {})",
+	"return getmetatable(setmetatable({}, {__metatable = 'locked'}))",
+	"return tonumber()",
+	"return tostring()",
+	"return select(0, 1)",
+	"return select(-3, 1, 2)",
+	"return select('x', 1)",
+	"return rawget(1, 2)",
+	"return rawset({}, nil, 1)",
+	"return ipairs()",
+	"return math.floor('1.5')",
+	"return math.max()",
+	"return math.max('a', 1)",
+	"return ('abc'):find('a', 1, 1)",
+	"return ('abc'):gsub('a')",
+	"return ('abc'):gsub('a', 'b', 'c')",
+	"return ('abc'):gsub('(a)', '%2')",
+	"return ('abc'):match('(a')",
+	"return ('abc'):match('a)')",
+	"return ('abc'):match('[a')",
+	"return ('abc'):match('%1')",
+	"return ('abc'):match('(%1)')",
+	"return ('abc'):find('%g')",
+	"return coroutine.resume(1)",
+	"return coroutine.create(1)",
+	"return coroutine.yield(1)",
+	"return coroutine.status({})",
+	"local w = coroutine.wrap(function() end) w() w()",
+	"return assert(false)",
