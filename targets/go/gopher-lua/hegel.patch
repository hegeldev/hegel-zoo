diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..ea5eb9b
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,157 @@
+package lua_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// compare judges GopherLua's result against the reference interpreter's for
+// one program: both compile, run and return the same values, or both fail
+// at the same stage (compiling, or running). Error messages are not
+// compared (GopherLua words its own), except that an error value that is
+// not a string must be the same value.
+func compare(ht *hegel.T, src string, g, l luaResult) {
+	switch g.Status {
+	case "panic":
+		fail(ht, "gopher-lua panics\nprogram:\n%s\n%s", src, g.Payload)
+	case "timeout":
+		fail(ht, "gopher-lua does not finish\nprogram:\n%s\nlua5.1: %s %s", src, l.Status, l.Payload)
+	}
+	if g.Status != l.Status {
+		fail(ht, "gopher-lua %s, lua5.1 %s\nprogram:\n%s\ngopher: %s\nlua5.1: %s", g.Status, l.Status, src, cut(g.Payload), cut(l.Payload))
+	}
+	switch g.Status {
+	case "ok":
+		if g.Payload != l.Payload {
+			fail(ht, "results differ\nprogram:\n%s\ngopher: %s\nlua5.1: %s", src, cut(g.Payload), cut(l.Payload))
+		}
+	case "runtime":
+		// a non-string error value travels through both intact
+		if !strings.HasPrefix(l.Payload, "\"") && g.Payload != l.Payload {
+			fail(ht, "error values differ\nprogram:\n%s\ngopher: %s\nlua5.1: %s", src, cut(g.Payload), cut(l.Payload))
+		}
+	}
+}
+
+func cut(s string) string {
+	if len(s) > 600 {
+		return s[:600] + "..."
+	}
+	return s
+}
+
+// TestHegelRunAgreesWithLua: a generated program (literals of every kind,
+// locals, assignments, if/while/repeat/for, closures, varargs, multiple
+// returns and their adjustment, tables and metatables, coroutines, pcall
+// and error, the operators with their precedence, the string, table and
+// math libraries) returns the same values in GopherLua and in the reference
+// Lua 5.1, or fails in both at the same stage; the probes (fixed programs
+// over the language's and the libraries' corners) likewise.
+func TestHegelRunAgreesWithLua(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 3)
+		for i := 0; i < k; i++ {
+			g := newGen(ht)
+			var src string
+			if chance(ht, 20) {
+				src = g.wrong(2)
+			} else {
+				src = g.program()
+			}
+			note(ht, "program:\n%s", src)
+			gr := goRun(src)
+			lr := luaRun(ht, src)
+			compare(ht, src, gr, lr)
+		}
+	})
+}
+
+// foldable builds an expression over literals (folded by the compiler
+// where it can) and the same expression over locals holding those
+// literals (evaluated at run time).
+func (g *gen) foldable(d int) (lit, dyn string) {
+	if d <= 0 || chance(g.ht, 30) {
+		switch n(g.ht, 1, 6) {
+		case 1, 2, 3:
+			l := g.numLit()
+			return l, "id(" + l + ")"
+		case 4:
+			l := g.strLit()
+			return l, "id(" + l + ")"
+		case 5:
+			l := pick(g.ht, "true", "false", "nil")
+			return l, "id(" + l + ")"
+		default:
+			l := pick(g.ht, "1", "2", "0", "-1", "0.5", "10", "2^53", "1e15", "0/0", "1/0", "-0")
+			if Known.negZero && l == "-0" {
+				l = "-2" // 2 * (-0) folds to -0 and evaluates to 0: gopher-lua/56
+			}
+			return "(" + l + ")", "id(" + l + ")"
+		}
+	}
+	switch n(g.ht, 1, 10) {
+	case 1, 2, 3:
+		op := pick(g.ht, "+", "-", "*", "/", "%", "^")
+		a1, a2 := g.foldable(d - 1)
+		b1, b2 := g.foldable(d - 1)
+		if Known.negZero && op != "%" || Known.modNegativeZero && op == "%" {
+			// the folded 4 * (-0), (-0) - 0 and (-0) + (-0) are -0, the evaluated ones 0
+			// (gopher-lua/56, 20): + 0 makes both 0
+			return fmt.Sprintf("((%s %s %s) + 0)", a1, op, b1), fmt.Sprintf("((%s %s %s) + 0)", a2, op, b2)
+		}
+		return fmt.Sprintf("(%s %s %s)", a1, op, b1), fmt.Sprintf("(%s %s %s)", a2, op, b2)
+	case 4:
+		a1, a2 := g.foldable(d - 1)
+		if Known.negZero {
+			return "((-" + a1 + ") + 0)", "((-" + a2 + ") + 0)" // -(0) is -0 folded: gopher-lua/56
+		}
+		return "(-" + a1 + ")", "(-" + a2 + ")"
+	case 5:
+		a1, a2 := g.foldable(d - 1)
+		return "(not " + a1 + ")", "(not " + a2 + ")"
+	case 6:
+		a1, a2 := g.foldable(d - 1)
+		b1, b2 := g.foldable(d - 1)
+		return fmt.Sprintf("(%s .. %s)", a1, b1), fmt.Sprintf("(%s .. %s)", a2, b2)
+	case 7:
+		op := pick(g.ht, "==", "~=", "<", "<=", ">", ">=")
+		a1, a2 := g.foldable(d - 1)
+		b1, b2 := g.foldable(d - 1)
+		return fmt.Sprintf("(%s %s %s)", a1, op, b1), fmt.Sprintf("(%s %s %s)", a2, op, b2)
+	case 8:
+		op := pick(g.ht, "and", "or")
+		a1, a2 := g.foldable(d - 1)
+		b1, b2 := g.foldable(d - 1)
+		return fmt.Sprintf("(%s %s %s)", a1, op, b1), fmt.Sprintf("(%s %s %s)", a2, op, b2)
+	case 9:
+		a1, a2 := g.foldable(d - 1)
+		return "(#" + a1 + ")", "(#" + a2 + ")"
+	default:
+		a1, a2 := g.foldable(d - 1)
+		return fmt.Sprintf("(%s and %s or %s)", a1, a1, a1), fmt.Sprintf("(%s and %s or %s)", a2, a2, a2)
+	}
+}
+
+// TestHegelConstantFoldingAgrees: an expression over literals gives, in
+// GopherLua, the same value (or the same kind of failure) as the same
+// expression over locals holding the literals - whatever the compiler
+// folds must agree with the VM.
+func TestHegelConstantFoldingAgrees(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		g := newGen(ht)
+		lit, dyn := g.foldable(n(ht, 1, 4))
+		src1 := "return " + lit
+		src2 := "local function id(x) return x end\nreturn " + dyn
+		note(ht, "folded: %s\ndynamic: %s", src1, src2)
+		r1, r2 := goRun(src1), goRun(src2)
+		if r1.Status == "panic" || r2.Status == "panic" {
+			fail(ht, "gopher-lua panics\n%s\n%s\n%s\n%s", src1, r1.Payload, src2, r2.Payload)
+		}
+		if r1.Status != r2.Status || (r1.Status == "ok" && r1.Payload != r2.Payload) {
+			fail(ht, "folded and dynamic evaluation differ\nfolded:  %s\n  -> %s %s\ndynamic: %s\n  -> %s %s", src1, r1.Status, cut(r1.Payload), src2, r2.Status, cut(r2.Payload))
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..611786d
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,255 @@
+package lua_test
+
+// Generated Lua 5.1 programs run by GopherLua and by the reference
+// interpreter (lua5.1, as a child process) must agree: the same programs
+// compile, run and return the same values, or fail at the same stage.
+//
+// Needs lua5.1 (the reference Lua 5.1 interpreter) on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 400 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	// A case is a batch of programs through the oracle: large and slow by
+	// hegel's defaults.
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Known bugs (see bugs.toml). Each gate keeps the generator away from a
+// shape that is known to differ from the reference interpreter while the
+// bug is open; the pins in hegel_pins_test.go fail while it is.
+
+var Known = struct {
+	tonumberBase                bool // tonumber(10, 16) converts the number without going through its string form (10, not 16)
+	insertArity                 bool // table.insert accepts more than three arguments
+	gsubNumber                  bool // string.gsub rejects a number as the replacement (the reference coerces it to a string)
+	gsubTableValue              bool // string.gsub accepts a table or true as a replacement value from a table/function (the reference fails: invalid replacement value)
