+package lua_test
+
+// One plain test per recorded bug (bugs.toml). Each runs a program in
+// GopherLua and in the reference interpreter and asks for the same result;
+// while the bug is open the test fails, and the matching Known gate keeps
+// the generator away from the shape.
+
+import (
+	"runtime"
+	"testing"
+)
+
+func pin(t *testing.T, src string) {
+	t.Helper()
+	g := goRun(src)
+	l := luaRun(t, src)
+	t.Logf("gopher-lua: %s %s\nlua5.1:     %s %s", g.Status, g.Payload, l.Status, l.Payload)
+	if g.Status != l.Status {
+		t.Fatalf("gopher-lua %s, lua5.1 %s\nprogram: %s\ngopher-lua: %s\nlua5.1:     %s", g.Status, l.Status, src, g.Payload, l.Payload)
+	}
+	if g.Status == "ok" && g.Payload != l.Payload {
+		t.Fatalf("results differ\nprogram: %s\ngopher-lua: %s\nlua5.1:     %s", src, g.Payload, l.Payload)
+	}
+}
+
