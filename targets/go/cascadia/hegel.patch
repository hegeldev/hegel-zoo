index 0000000..2d55490
--- /dev/null
+++ b/hegel_selectors_test.go
@@ -0,0 +1,388 @@
+package cascadia_test
+
+// The selectors of the properties, drawn as the records of
+// hegel_sel_test.go (group, complex, compound, simple, relative) from
+// package-level generators: the same grammar, depths and rates as the old
+// draw-helper generator genGroup had (1-3 complex selectors of 1-3 compounds
+// joined by the four combinators, compounds of a type and 0-2 simple
+// selectors, the simple kinds' table, the attribute operators and the i
+// flag, the pseudo-class table with :not, :has and :haschild to depth 2, the
+// nth forms, the extensions with ext). The arguments (ids, classes, attribute
+// values, :lang arguments, :contains words) are drawn from the pools
+// independently of the document, so the shapes of the recorded bugs meet a
+// document at the rates the pools give them; a narrow property draws its
+// selector from the document instead (hegel_match_shapes_test.go). The
+// avoidance rules of the old generator's gates are the HEGEL_NO_KNOWN=1 form
+// here: a compound of :lang and the text pseudo-classes alone takes a type
+// selector (cascadia/1), a :has argument is a single compound (6), no blank
+// operand with the substring operators (8), the i flag on the HTML
+// case-insensitive attributes (12), :disabled instead of :enabled for a
+// document with a link (7).
+
+import (
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// selOpts: the grammar of a selector family.
+type selOpts struct {
+	ext       bool // the library's extensions (the model property): :contains, :containsOwn, :matches, :matchesOwn, :haschild, :input, != and #=
+	noEnabled bool // :enabled is not drawn (:disabled takes its place, as the old soupsieve property had it): under HEGEL_NO_KNOWN=1 for a document with a link, cascadia/7
+}
+
+// The tables of the old selector generator, as generators (the first entry
+// is the shrink target). The weights are tuned to the engine's bias as
+// hegel_docs_test.go explains (the first alternative of a weighted choice and
+// index 1 of a table are favoured; a uniform table is a weightedOver): the
+// comment beside each gives the nominal rate, what the weight realises over
+// 3000 selector lists with four seeds, and what the nominal form realised.
+var (
+	groupCounts    = weightedOver([]int{74, 14, 12}, 1, 2, 3)                                                         // 75/12.5/12.5 nominal: realises 75/13/12 (weights 75/25 over hzInts(2, 3) realised 77/11/12)
+	complexCounts  = weightedOver([]int{52, 25, 24}, 1, 2, 3)                                                         // 55/22.5/22.5 nominal: realises 54/23.5/22 (weights 55/45 over hzInts(2, 3) realised 57/18/25)
+	combinators    = weightedOver([]int{12, 26, 30, 31}, byte(' '), '>', '+', '~')                                    // uniform: realises 24/26/25/25 (hzSampled realised 21/41/19/19)
+	relCombinators = weightedOver([]int{16, 29, 28, 28}, byte(' '), '>', '+', '~')                                    // uniform inside :has, where combinators' weights realised 21/29/24/26: realises 26/28/22/24 (two to four points of run-to-run spread on a thousand draws)
+	selTags        = hzWeighted(hzW(41, hegel.Just("")), hzW(47, hzSampled(selTagPool...)), hzW(12, hegel.Just("*"))) // 50/40/10 nominal: realises 51/39/10 (weights 50/40/10 realised 59/32/9)
+	namedTags      = hzSampled(selTagPool...)
+	selIDs         = hegel.Map(idValues, func(v string) simple { return simple{kind: "id", name: v} })
+	selClasses     = hegel.Map(classValues, func(v string) simple { return simple{kind: "class", name: v} })
+	attrNames      = hzSampled(attrKeys...)
+	stdOps         = weightedOver([]int{8, 13, 15, 19, 16, 18, 17}, stdAttrOps...)                                                       // uniform: realises 15/13/14/14/14/15/15 on the keys other than class (hzSampled realised 13/16/13/12/10/10/11; class takes ~= for the other operators)
+	extOps         = weightedOver([]int{5, 10, 11, 11, 13, 14, 13, 13, 12}, append(append([]string{}, stdAttrOps...), extAttrOps...)...) // uniform: realises 9/11.5/11/11/11/12.5/11/12/10.5 (hzSampled realised 11/18/13/10/9/10/10/10/8)
+	rxs            = hzSampled(rxPool...)
+	langArgs       = hegel.Map(hzSampled(langPool[:6]...), strings.ToLower)
+	nthNames       = weightedOver([]int{16, 25, 29, 30}, nthPseudos...)         // uniform: realises 26/22.5/25/26.5 (hzSampled realised 23/31/24/22)
+	hasCounts      = hzWeighted(hzW(71, hegel.Just(1)), hzW(29, hegel.Just(2))) // 75/25 nominal: weights 71/29 realise 75 to 77 (weights 75/25 realised 80/20)
+	containsNames  = weightedOver([]int{9, 11}, "contains", "containsown")      // 50/50: realises 54 to 56 (hzSampled realised 48/52; a thousand draws, four points of spread)
+	matchesNames   = weightedOver([]int{9, 11}, "matches", "matchesown")        // 50/50: realises 50 to 54 (hzSampled realised 44/56)
+	// The nth forms: odd, even, a plain index, a general an+b (each a sixth,
+	// the last three sixths; the an+b half covers odd, even and an index too,
+	// so the forms are seen at about 17/17/24/41: the weights realise
+	// 17/15.5/23.5/44, the nominal 2/2/2/6 realised 22.5/16/23/38.5).
+	nthForms = hzWeighted(
+		hzW(7, hegel.Just([2]int{2, 1})),
+		hzW(13, hegel.Just([2]int{2, 0})),
+		hzW(17, hegel.Map(hzInts(-1, 4), func(b int) [2]int { return [2]int{0, b} })),
+		hzW(56, hegel.FlatMap(hzInts(-3, 3), func(a int) hegel.Generator[[2]int] {
+			return hegel.Map(hzInts(-4, 5), func(b int) [2]int { return [2]int{a, b} })
+		})),
+	)
+	nths = hegel.FlatMap(nthNames, func(name string) hegel.Generator[simple] {
+		return hegel.Map(nthForms, func(ab [2]int) simple { return simple{kind: "pseudo", name: name, a: ab[0], b: ab[1]} })
+	})
+	langs    = hegel.Map(langArgs, func(arg string) simple { return simple{kind: "pseudo", name: "lang", val: arg} })
+	contains = hegel.FlatMap(containsNames, func(name string) hegel.Generator[simple] {
+		return hegel.Map(words, func(w string) simple { return simple{kind: "pseudo", name: name, val: w} })
+	})
+	matches = hegel.FlatMap(matchesNames, func(name string) hegel.Generator[simple] {
+		return hegel.Map(rxs, func(rx string) simple { return simple{kind: "pseudo", name: name, rx: rx} })
+	})
+)
+
+// countedBy: a list of as many elements as counts draws; nil for none.
+func countedBy[T any](g hegel.Generator[T], counts hegel.Generator[int]) hegel.Generator[[]T] {
+	return hegel.FlatMap(counts, func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// poolFor is the pool an attribute selector's operand comes from, by key.
+func poolFor(name string) hegel.Generator[string] {
+	switch name {
+	case "id":
+		return idValues
+	case "class":
+		return classValues
+	case "lang":
+		return hzSampled(langPool...)
+	case "type":
+		return typeValues
+	case "dir":
+		return dirValues
+	}
+	return attrValues
+}
+
+// attrOperands: an operand for the key: from the key's pool, or 30 % of the
+// time from the general value pool.
+func attrOperands(name string) hegel.Generator[string] {
+	return hegel.FlatMap(hzCoin(35), func(any bool) hegel.Generator[string] { // 30 nominal: hzCoin(35) realises 28 to 30 (hzCoin(30) realised 20)
+		if any {
+			return attrValues
+		}
+		return poolFor(name)
+	})
+}
+
+// ciFlags: the i flag 20 % of the time; under HEGEL_NO_KNOWN=1 always on the
+// attributes HTML compares case-insensitively (cascadia/12).
+func ciFlags(name string) hegel.Generator[bool] {
+	if hzNoKnown && caseInsensitiveHTMLAttrs[name] {
+		return hegel.Just(true)
+	}
+	return hzCoin(24) // 20 nominal: hzCoin(24) realises 19 to 21 (hzCoin(20) realised 16.5)
+}
+
+func substringOp(op string) bool { return op == "^=" || op == "$=" || op == "*=" }
+
+// attrsIn: an attribute selector: a key, an operator (the extensions' != and
+// #= with ext; on class only presence and ~=, since BeautifulSoup parses class
+// as a list and soupsieve matches its single-space join: the README's
+// exclusion, not a gate), its operand or regular expression, the i flag.
+// Under HEGEL_NO_KNOWN=1 a blank operand of a substring operator becomes "a"
+// (cascadia/8).
+func attrsIn(o selOpts) hegel.Generator[simple] {
+	ops := stdOps
+	if o.ext {
+		ops = extOps
+	}
+	return hegel.Composite(func(tc hegel.TestCase) simple {
+		s := simple{kind: "attr", name: hegel.Draw(tc, attrNames)}
+		s.op = hegel.Draw(tc, ops)
+		if !o.ext && s.name == "class" && s.op != "" && s.op != "~=" {
+			s.op = "~="
+		}
+		switch s.op {
+		case "":
+		case "#=":
+			s.rx = hegel.Draw(tc, rxs)
+		default:
+			s.val = hegel.Draw(tc, attrOperands(s.name))
+			if hzNoKnown && substringOp(s.op) && strings.Trim(s.val, cssSpace) == "" {
+				s.val = "a"
+			}
+			s.ci = hegel.Draw(tc, ciFlags(s.name))
+		}
+		return s
+	})
+}
+
+// simplePseudosIn: a plain pseudo-class of the table (:input with ext;
+// :disabled for :enabled with noEnabled).
+func simplePseudosIn(o selOpts) hegel.Generator[simple] {
+	pool := append([]string{}, simplePseudos...)
+	if o.ext {
+		pool = append(pool, extPseudos...)
+	}
+	return hegel.Map(hzSampled(pool...), func(name string) simple {
+		if name == "enabled" && o.noEnabled {
+			name = "disabled"
+		}
+		return simple{kind: "pseudo", name: name}
+	})
+}
+
+// nots: :not over a selector list of the depth below.
+func nots(o selOpts, depth int) hegel.Generator[simple] {
+	return hegel.Map(groupsAt(o, depth+1), func(g group) simple { return simple{kind: "pseudo", name: "not", group: g} })
+}
+
+// relativesAt: a relative selector of a :has or :haschild of the depth: a
+// complex selector of the depth below (under HEGEL_NO_KNOWN=1 a single
+// compound: cascadia/6) with an explicit combinator 50 % of the time (white
+// space is the implicit one, the child combinator for :haschild).
+func relativesAt(o selOpts, depth int, name string) hegel.Generator[relative] {
+	args := hzShaped(complexAt(o, depth+1), hegel.Map(compoundAt(o, depth+1), func(c compound) complex { return complex{parts: []compound{c}} }))
+	return hegel.Composite(func(tc hegel.TestCase) relative {
+		rel := relative{sel: hegel.Draw(tc, args)}
+		rel.comb = hegel.Draw(tc, hzMaybe(58, relCombinators)) // 50 nominal: weight 58 realises 47 to 50 (weight 50 realised 42)
+		if rel.comb == ' ' && name == "haschild" {
+			rel.comb = 0
+		}
+		return rel
+	})
+}
+
+// hases: :has (or, with ext, :haschild 30 % of the time) over one or two
+// (25 %) relative selectors.
+func hases(o selOpts, depth int) hegel.Generator[simple] {
+	names := hegel.Just("has")
+	if o.ext {
+		names = hzWeighted(hzW(65, hegel.Just("has")), hzW(35, hegel.Just("haschild"))) // 70/30 nominal: weights 65/35 realise 69 to 73 (weights 70/30 realised 75/25)
+	}
+	return hegel.FlatMap(names, func(name string) hegel.Generator[simple] {
+		return hegel.Map(countedBy(relativesAt(o, depth, name), hasCounts), func(rels []relative) simple {
+			return simple{kind: "pseudo", name: name, rels: rels}
+		})
+	})
+}
+
+// pseudosAt: a pseudo-class at the depth: the old table's rates (plain 35,
+// nth 20, lang 7, not 13, has 13, contains 6, matches 6), the recursive ones
+// only above depth 2 and the extensions only with ext (their shares go to the
+// plain pseudo-classes, as the old draw did).
+func pseudosAt(o selOpts, depth int) hegel.Generator[simple] {
+	deep := depth >= 2
+	// The weights of plain, nth, lang, not, has, contains and matches, tuned
+	// per grammar and depth (the nominal weights 35 (+26 deep, +12 without
+	// ext), 20, 7, 13, 13, 6, 6 realised plain 54 (std) and 46 (ext), nth 16,
+	// lang 5, not 12, has 12.5, contains 4, matches 4 at depth 0 and 1, and
+	// plain 76/66 at depth 2); the depth-2 tables are a few hundred draws per
+	// run and move three points between runs.
+	var w [7]int
+	switch {
+	case !o.ext && !deep:
+		w = [7]int{43, 23, 9, 14, 11, 0, 0} // 47/20/7/13/13 nominal: realises 48/21/7/13/10.5
+	case !o.ext:
+		w = [7]int{68, 25, 7, 0, 0, 0, 0} // 73/20/7 nominal: realises 69 to 72/21 to 23/7 to 10
+	case !deep:
+		w = [7]int{29, 23, 9, 12, 13, 7, 7} // 35/20/7/13/13/6/6 nominal: realises 35/20/7.5/14/12.7/5.4/5.8
+	default:
+		w = [7]int{58, 24, 7, 0, 0, 7, 7} // 61/20/7/6/6 nominal: realises 59/24/6/6/5
+	}
+	// The recursion must stop: a placeholder of weight zero at depth 2.
+	notsAt, hasesAt := hegel.Just(simple{}), hegel.Just(simple{})
+	if !deep {
+		notsAt, hasesAt = nots(o, depth), hases(o, depth)
+	}
+	return hzWeighted(
+		hzW(w[0], simplePseudosIn(o)),
+		hzW(w[1], nths),
+		hzW(w[2], langs),
+		hzW(w[3], notsAt),
+		hzW(w[4], hasesAt),
+		hzW(w[5], contains),
+		hzW(w[6], matches),
+	)
+}
+
+// simpleAt: a simple selector: an id (15 %), a class (20), an attribute
+// selector (25) or a pseudo-class (40).
+func simpleAt(o selOpts, depth int) hegel.Generator[simple] {
+	return hzWeighted(hzW(7, selIDs), hzW(20, selClasses), hzW(28, attrsIn(o)), hzW(45, pseudosAt(o, depth))) // 15/20/25/40 nominal: realises 15/21/25/39 (weights 15/20/25/40 realised 27/19/19.5/34.5; an id weight of 2 realised 4 with the surplus on class, 30)
+}
+
+// allTextPseudos: are the simple selectors all :lang or text pseudo-classes?
+func allTextPseudos(simples []simple) bool {
+	for _, s := range simples {
+		if !isTextPseudo(s) {
+			return false
+		}
+	}
+	return true
+}
+
+// compoundAt: a compound selector: no type (50 %), a type of the pool (40)
+// or the universal selector (10), then 0-2 simple selectors (1-2 without a
+// type: one twice as often). Under HEGEL_NO_KNOWN=1 a compound of :lang and
+// the text pseudo-classes alone takes a type of the pool (cascadia/1: the
+// library tests those on every node, so such a compound as the subject, before
+// ~, before the html element's document ancestor or inside :has sees text,
+// comment, doctype and document nodes; the universal selector would not do,
+// the parser drops it before other simple selectors).
+func compoundAt(o selOpts, depth int) hegel.Generator[compound] {
+	simples := simpleAt(o, depth)
+	return hegel.Composite(func(tc hegel.TestCase) compound {
+		c := compound{tag: hegel.Draw(tc, selTags)}
+		counts := evenInts(0, 27, 37, 36) // 0-2 uniform: realises 33/34.5/32.5 (hzInts realised 26/40/34)
+		if c.tag == "" {
+			counts = hzWeighted(hzW(3, hegel.Just(1)), hzW(2, hegel.Just(2))) // 2:1 nominal: weights 3/2 realise 65/35 (weights 2/1 realised 71/29)
+		}
+		c.simples = hegel.Draw(tc, countedBy(simples, counts))
+		if hzNoKnown && c.tag == "" && allTextPseudos(c.simples) {
+			c.tag = hegel.Draw(tc, namedTags)
+		}
+		return c
+	})
+}
+
+// complexAt: a complex selector: one compound (55 %) or 2-3 joined by the
+// four combinators.
+func complexAt(o selOpts, depth int) hegel.Generator[complex] {
+	compounds := compoundAt(o, depth)
+	return hegel.FlatMap(complexCounts, func(k int) hegel.Generator[complex] {
+		return hegel.Composite(func(tc hegel.TestCase) complex {
+			parts := hegel.Draw(tc, hzCounted(compounds, k, k))
+			combs := hegel.Draw(tc, hzCounted(combinators, k-1, k-1))
+			return complex{parts: parts, combs: combs}
+		})
+	})
+}
+
+// groupsAt: a selector list: one complex selector (75 %) or 2-3.
+func groupsAt(o selOpts, depth int) hegel.Generator[group] {
+	return hegel.Map(countedBy(complexAt(o, depth), groupCounts), func(cs []complex) group { return group(cs) })
+}
+
+// The four families of the wide properties, built once: the standard grammar
+// (the soupsieve property) and the extended one (the model property), each
+// with and without :enabled.
+var (
+	stdGroups          = groupsAt(selOpts{}, 0)
+	extGroups          = groupsAt(selOpts{ext: true}, 0)
+	stdGroupsNoEnabled = groupsAt(selOpts{noEnabled: true}, 0)
+	extGroupsNoEnabled = groupsAt(selOpts{ext: true, noEnabled: true}, 0)
+)
+
+// groupsFor: the selector lists of the grammar for the document: under
+// HEGEL_NO_KNOWN=1 without :enabled when the document has a link with href
+// (cascadia/7, the one shape that is a relation between the selector and the
+// document).
+func groupsFor(ext bool, d *dnode) hegel.Generator[group] {
+	switch {
+	case hzNoKnown && hasLink(d) && ext:
+		return extGroupsNoEnabled
+	case hzNoKnown && hasLink(d):
+		return stdGroupsNoEnabled
+	case ext:
+		return extGroups
+	}
+	return stdGroups
+}
+
+// --------------------------------------------------------------------------- record constructors
+
+// The narrow properties build their selectors from these.
+
+func pseudo(name string) simple           { return simple{kind: "pseudo", name: name} }
+func langOf(arg string) simple            { return simple{kind: "pseudo", name: "lang", val: arg} }
+func not(g group) simple                  { return simple{kind: "pseudo", name: "not", group: g} }
+func attrSel(name, op, val string) simple { return simple{kind: "attr", name: name, op: op, val: val} }
+
+// relSel: a :has or :haschild over one relative selector.
+func relSel(name string, comb byte, sel complex) simple {
+	return simple{kind: "pseudo", name: name, rels: []relative{{comb: comb, sel: sel}}}
+}
+
+// compoundOf: a compound of the type (or none) and the simple selectors.
+func compoundOf(tag string, simples ...simple) compound { return compound{tag: tag, simples: simples} }
+
+// complexOf: a complex selector of the compounds joined by the combinators.
+func complexOf(combs string, parts ...compound) complex {
+	return complex{parts: parts, combs: []byte(combs)}
+}
+
+// groupOf: a selector list of one complex selector.
+func groupOf(c complex) group { return group{c} }
+
+// single: a selector list of one compound.
+func single(c compound) group { return groupOf(complexOf("", c)) }
+
+// anySimple: does a simple selector anywhere in the selector list (inside
+// :not and :has too) satisfy pred?
+func anySimple(g group, pred func(simple) bool) bool {
+	for _, c := range g {
+		for _, p := range c.parts {
+			for _, s := range p.simples {
+				if pred(s) {
+					return true
+				}
+				if s.kind == "pseudo" {
+					switch s.name {
+					case "not":
+						if anySimple(s.group, pred) {
+							return true
+						}
+					case "has", "haschild":
+						for _, r := range s.rels {
+							if anySimple(group{r.sel}, pred) {
+								return true
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	return false
+}
diff --git a/hegel_syntax_shapes_test.go b/hegel_syntax_shapes_test.go
new file mode 100644
index 0000000..b013e82
--- /dev/null
+++ b/hegel_syntax_shapes_test.go
@@ -0,0 +1,156 @@
+package cascadia_test
+
+// The shape regions of the recorded serialisation, specificity and parsing
+// bugs (bugs.toml cascadia/2, 3, 4 and 13) and the narrow properties over
+// them: each region is a drawn selector list of the full grammar with the
+// shape's ingredient appended to a drawn compound (an attribute value or
+// :contains argument holding a quote or a backslash; a class beginning with a
+// digit; a never-matching pseudo-class, alone or the most specific argument of
+// :not or :has; an identifier holding U+FFFD spelled with a zero escape), over
+// a drawn document where the property has one, judged exactly like the wide
+// property of the family (the judges of hegel_props_test.go, the classifier
+// naming the bug). By default every drawn case is named its bug (the region
+// of 3 is filtered by the classifier, since the base list may carry a quoted
+// value, which is named first; the rejections are counted "filtered
+// cascadia/3"); under HEGEL_NO_KNOWN=1 the ingredient is one from the region
+// next to the shape instead (hzShaped), over a base the wide property's
+// filter keeps unshaped, and the property passes. The runner is judged, the
+// wide properties' own.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- cascadia/2
+
+// quotedValues: the pool entries holding a double quote or a backslash (the
+// value, id and class pools); plainValues the value pool's other entries.
+var (
+	quotedValues = hzSampled("\"", "\\", "u\"v", "w\\z", "j\"k", "l\\m")
+	plainValues  = hzSampled(without(valuePool, "\"\\")...)
+	quotedOps    = hzSampled("=", "~=", "|=", "^=", "$=", "*=", "!=")
+)
+
+// without: the entries of the pool holding none of the characters.
+func without(pool []string, chars string) []string {
+	var out []string
+	for _, v := range pool {
+		if !strings.ContainsAny(v, chars) {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// quotedSimples: an attribute selector of a drawn key and operator (other
+// than none and #=) with a drawn value, or :contains/:containsOwn of it.
+func quotedSimples(values hegel.Generator[string]) hegel.Generator[simple] {
+	return hegel.FlatMap(values, func(v string) hegel.Generator[simple] {
+		attrs := hegel.FlatMap(attrNames, func(key string) hegel.Generator[simple] {
+			return hegel.Map(quotedOps, func(op string) simple { return attrSel(key, op, v) })
+		})
+		contains := hegel.Map(containsNames, func(name string) simple { return simple{kind: "pseudo", name: name, val: v} })
+		return hzWeighted(hzW(2, attrs), hzW(1, contains))
+	})
+}
+
+var quotedRegion = regionOf("cascadia/2", syntaxShapeOf, syntaxCasesOf(docs, inserted(syntaxGroups, quotedSimples(hzShaped(quotedValues, plainValues)))))
+
+// TestHegelSerializationEscapesAttributeValues: String() of a selector list
+// with an attribute value or :contains argument holding a quote or a
+// backslash parses again to the same selector list (cascadia/2). Past the
+// shape: a value of the pool without them.
+func TestHegelSerializationEscapesAttributeValues(t *testing.T) {
+	judged(t, quotedRegion, judgeRoundTrip)
+}
+
+// --------------------------------------------------------------------------- cascadia/3
+
+// digitClasses: class names beginning with a digit; letterClasses the names
+// past the shape: beginning with a letter, and the note's hyphen-digit names,
+// which escape() escapes at the hyphen (`.\-1x`) so that they reparse.
+var (
+	digitClasses  = hzSampled("1x", "9", "0a", "42")
+	letterClasses = hzSampled("x1", "a9", "-1x", "-0a")
+	classSimples  = hegel.Map(hzShaped(digitClasses, letterClasses), func(name string) simple { return simple{kind: "class", name: name} })
+)
+
+var digitRegion = regionOf("cascadia/3", syntaxShapeOf, syntaxCasesOf(docs, inserted(syntaxGroups, classSimples)))
+
+// TestHegelSerializationEscapesLeadingDigits: String() of a selector list
+// with a class name beginning with a digit parses again (cascadia/3). Past
+// the shape: a name beginning with a letter or a hyphen.
+func TestHegelSerializationEscapesLeadingDigits(t *testing.T) { judged(t, digitRegion, judgeRoundTrip) }
+
+// --------------------------------------------------------------------------- cascadia/4
+
+// neverMatching: the five pseudo-classes that never match in a static
+// context; countingPseudos the plain pseudo-classes past the shape, which
+// the library counts.
+var (
+	neverMatching   = hzSampled("hover", "visited", "active", "focus", "target")
+	countingPseudos = hzSampled("first-child", "last-child", "first-of-type", "last-of-type", "only-child", "only-of-type", "empty", "root", "link", "enabled", "disabled", "checked", "input")
+)
+
+// pseudoForms: the pseudo-class alone, alone inside :not, inside :not beside
+// a type selector (the pseudo-class the most specific argument), or inside
+// :has.
+func pseudoForms(names hegel.Generator[string]) hegel.Generator[simple] {
+	return hegel.FlatMap(names, func(name string) hegel.Generator[simple] {
+		p := pseudo(name)
+		return hzWeighted(
+			hzW(2, hegel.Just(p)),
+			hzW(1, hegel.Just(not(single(compoundOf("", p))))),
+			hzW(1, hegel.Map(namedTags, func(tag string) simple {
+				return not(group{complexOf("", compoundOf("", p)), complexOf("", compoundOf(tag))})
+			})),
+			hzW(1, hegel.Just(relSel("has", 0, complexOf("", compoundOf("", p))))),
+		)
+	})
+}
+
+var neverMatchRegion = regionOf("cascadia/4", specificityShapeOf, specificityCasesOf(inserted(specificityGroups, pseudoForms(hzShaped(neverMatching, countingPseudos)))))
+
+// TestHegelNeverMatchingPseudoClassesCount: a selector list with :hover,
+// :visited, :active, :focus or :target in a compound, or the most specific
+// argument of :not or :has, has the specification's specificity: every
+// pseudo-class counts (0,1,0) (cascadia/4). Past the shape: another plain
+// pseudo-class in the same forms.
+func TestHegelNeverMatchingPseudoClassesCount(t *testing.T) {
+	judged(t, neverMatchRegion, judgeSpecificity)
+}
+
+// --------------------------------------------------------------------------- cascadia/13
+
+// zeroEscapeStyles: a drawn style with the zero escape (the shape) or, past
+// it, without: U+FFFD written raw, or as `\fffd ` in the all-escaping style
+// (escapes on, every flip true).
+var zeroEscapeStyles = hzShaped(
+	hegel.Map(styles, func(st style) style {
+		st.zeroEscape = true
+		return st
+	}),
+	hzWeighted(
+		hzW(1, hegel.Map(styles, func(st style) style {
+			st.zeroEscape = false
+			return st
+		})),
+		hzW(1, hegel.Map(styles, func(st style) style {
+			st.zeroEscape, st.escapes, st.dice = false, true, []int{99}
+			return st
+		})),
+	),
+)
+
+var zeroEscapeRegion = regionOf("cascadia/13", spellingShape, spellingCasesOf(docs, inserted(extGroups, replacementSimples), hzOne(zeroEscapeStyles)))
+
+// TestHegelZeroEscapeIsReplacementCharacter: a selector list with an id or
+// class holding U+FFFD, spelled with the zero hex escape `\0 ` (CSS Syntax:
+// U+FFFD), parses to the same selector list as the canonical spelling
+// (cascadia/13). Past the shape: the character raw or as `\fffd `.
+func TestHegelZeroEscapeIsReplacementCharacter(t *testing.T) {
+	judged(t, zeroEscapeRegion, judgeSpelling)
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..5aacf0e
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,323 @@
+package cascadia_test
+
+// Hegel properties for github.com/andybalholm/cascadia: CSS selectors over
+// generated HTML documents against soupsieve (the Python CSS selector
+// engine, as a child process) and against a plain model of the Selectors
+// specification, plus library-internal identities (serialisation round
+// trips, spelling variants, specificity, pseudo-elements, the query APIs).
+// The documents and selectors are records drawn from package-level
+// generators (hegel_docs_test.go, hegel_selectors_test.go); the recorded
+// bugs are drawn by default and named by a classifier before the library is
+// called (hegel_match_test.go, hegel_props_test.go).
+//
+// Needs python3 with the `soupsieve` and `beautifulsoup4` packages on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+// ---------------------------------------------------------------------------
+// The harness of the properties (the go/excelize, go/graphql-go and go/cobra
+// judge; hegel_idioms_test.go has the generator idioms). hegel-go reads no
+// environment variable itself, so HEGEL_TEST_CASES is passed through
+// hegelOpts; a panic in the code under test is turned into a failure of the
+// current test case by hzProperty. HEGEL_COLLECT=1 (or ZOO_COLLECT=1) makes
+// the properties record their mismatches instead of failing and print the
+// counts. The model takes the set of recorded bugs it follows as a value
+// (known); the properties judge the library against the documented behaviour
+// (hzKnownNone), name the shape of the recorded bug a case has before the
+// library is called (hzCaseJudge.Shape) and skip the shapes under
+// HEGEL_NO_KNOWN=1 (hzNoKnown).
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var hzCollecting = os.Getenv("HEGEL_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and
+// prints them at the end in collect mode ("COLLECT TestHegel...: N mismatches;
+// class=count ..."), with the judge's counters (hzStats) and the first two
+// messages of each mismatch class.
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// note records a message of a class that is not a failure (a replica
+// disagreement): counted, and its first two messages kept.
+func (c *hzCollector) note(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// ---------------------------------------------------------------------------
+// Known bugs.
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the
+// constants below in bug order. The model is a pure function of (selector,
+// node, known): with every switch off (hzKnownNone) it states the documented
+// behaviour (Selectors Level 4, the HTML definitions of the pseudo-classes
+// and of attribute case-sensitivity, the library's documentation of its
+// extensions), which is what the properties judge the library against; with a
+// switch on it reproduces that bug as a replica of the library's rule. The
+// classifier (matchShape) runs the model with several sets to name the shape
+// of a case before the library is called; the pins assert the documented
+// behaviour and fail while the bug exists. The switch of 4 acts in the
+// specificity model (specComplex, run twice by specificityShape); those of 2,
+// 3 and 13 act in serialisation and parsing, where there is no model to
+// follow: their shapes are named from the records by syntaxShape and
+// spellingShape (hegel_props_test.go), and the switches exist so that the
+// set is complete.
+type known [14]bool
+
+const (
+	kTextNodesMatch         = iota // cascadia/1: :lang, :contains and :matches match text, comment, doctype and document nodes, which QueryAll, :has and the ~ walk see
+	kStringUnescaped               // cascadia/2: String() does not escape quotes and backslashes in attribute values and :contains arguments
+	kLeadingDigitUnescaped         // cascadia/3: String() does not escape a leading digit of a class name (an id reparses: parseName allows a leading digit)
+	kNeverMatchSpecificity         // cascadia/4: :hover and the other never-matching pseudo-classes have specificity 0
+	kOptionIgnoresOptgroup         // cascadia/5: an option in a disabled optgroup is :enabled
+	kHasUnscoped                   // cascadia/6: :has(a b) is not anchored at the subject: the a may be above it
+	kLinksAreEnabled               // cascadia/7: :enabled matches a, area and link elements with an href
+	kBlankValuesNeverMatch         // cascadia/8: ^=, $= and *= never match a white-space-only attribute value
+	kLangCaseSensitive             // cascadia/9: :lang compares the attribute case-sensitively
+	kLangInheritsThroughOwn        // cascadia/10: :lang looks past an element's own lang attribute to its ancestors
+	kEmptyTrimsUnicodeSpace        // cascadia/11: :empty ignores text of Unicode (not just document) white space
+	kHTMLAttrsCaseSensitive        // cascadia/12: [type=...] and the other HTML case-insensitive attributes are compared case-sensitively without the i flag
+	kZeroEscapeIsNUL               // cascadia/13: a zero hex escape yields U+0000 instead of U+FFFD
+	kNestedFieldsetEnabled         // cascadia/14: a fieldset inside a disabled fieldset is :enabled
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("cascadia/N").
+func hzKnownID(i int) string { return "cascadia/" + strconv.Itoa(i+1) }
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have
+// ("shape cascadia/N" per case, "selector cascadia/N" per selector), the rule
+// of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape hole"), the cases skipped for them under HEGEL_NO_KNOWN=1
+// ("known cascadia/N"), the draws hzOnly rejected ("filtered <name>"), the
+// replica's agreement with the library on the shaped cases ("replica
+// agreement", "replica disagreement") and the cases skipped for an unrecorded
+// candidate bug ("candidate/go/cascadia-N"); printed and reset by the
+// collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go
+// and go/cobra judge, with the collector's mismatch classes): it names the
+// recorded bug whose shape the case has, so that a mismatch or a library
+// panic fails "(the shape of cascadia/N)", and under HEGEL_NO_KNOWN=1 skips
+// the case instead (counted as known). The wide and the narrow properties of
+// a family share their judge function (judgeMatch) and so this. The
+// classifier that names the shape is computed from the case alone (the model
+// run with several sets of switches), before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are alternatives
+// of weight zero or filtered relations), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
