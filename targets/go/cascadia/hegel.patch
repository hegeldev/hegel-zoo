diff --git a/hegel_doc_test.go b/hegel_doc_test.go
new file mode 100644
index 0000000..2fd383a
--- /dev/null
+++ b/hegel_doc_test.go
@@ -0,0 +1,98 @@
+package cascadia_test
+
+// The document record (dnode, drawn by hegel_docs_test.go), the pools, its
+// serialisation and parsing: a tree of elements whose parsing is the same in
+// every HTML parser (no auto-closing tags, no entity edge cases, no nested a
+// or button, options only inside optgroups), with attributes chosen to
+// exercise attribute selectors, :lang, :checked, :enabled and :disabled.
+
+import (
+	"strings"
+
+	"golang.org/x/net/html"
+)
+
+type dnode struct {
+	kind  int // 0 element, 1 text, 2 comment
+	tag   string
+	attrs [][2]string
+	text  string
+	kids  []*dnode
+	mark  string // the role of a forced node in a narrow property's document ("subject", "inner", "outer"; hegel_docs_test.go)
+}
+
+var (
+	containerTags = []string{"div", "span", "section", "article", "aside", "nav", "header", "footer", "main", "em", "strong", "b", "i", "u", "s", "small", "code", "sub", "sup", "label", "fieldset", "legend", "blockquote", "figure", "mark", "abbr", "x-widget", "a", "button"}
+	idPool        = []string{"a1", "b-2", "C", "x y", "1st", "-x", "q.r", "s:t", "u\"v", "w\\z", "d_e", "Zed", "-", "--f", "g#h", "i[j]", "k'l", "m,n", "o>p", "nbsp\u00a0q", "café", "a1"}
+	classPool     = []string{"a", "b", "c", "A", "a-b", "x_y", "1x", "d.e", "f:g", "-h", "_i", "j\"k", "l\\m", "café", "n-", "--o", "a"}
+	valuePool     = []string{"", " ", "a", "ab", "a b", "a-b", "A", "abc", "  a  ", "b\ta", "\"", "\\", "-a", "a-", "x\u00a0y", "'", "ab-cd", "a  b"}
+	langPool      = []string{"en", "en-US", "EN", "fr", "fr-CA", "de", "", "en-", "en-Latn-US", "e"}
+	dirPool       = []string{"ltr", "rtl", "LTR", "auto"}
+	typePool      = []string{"text", "checkbox", "radio", "submit", "Checkbox", "RADIO", "password", "email"}
+	wordPool      = []string{"lorem", "Ipsum", "dolor", "SIT", "amet", "a", "42", "x.y", "a,b", "c-d", "q'r", "Lorem"}
+	spacePool     = []string{" ", "\n", "\t ", "  ", "\n\t"}
+)
+
+// html serialises the document.
+func (d *dnode) html() string {
+	var b strings.Builder
+	b.WriteString("<!DOCTYPE html>")
+	d.write(&b)
+	return b.String()
+}
+
+func (d *dnode) write(b *strings.Builder) {
+	switch d.kind {
+	case 1:
+		b.WriteString(d.text)
+		return
+	case 2:
+		b.WriteString("<!--" + d.text + "-->")
+		return
+	}
+	b.WriteByte('<')
+	b.WriteString(d.tag)
+	for _, a := range d.attrs {
+		b.WriteByte(' ')
+		b.WriteString(a[0])
+		b.WriteString(`="`)
+		b.WriteString(strings.ReplaceAll(a[1], `"`, "&quot;"))
+		b.WriteByte('"')
+	}
+	b.WriteByte('>')
+	if d.tag == "input" || d.tag == "area" {
+		return
+	}
+	for _, k := range d.kids {
+		k.write(b)
+	}
+	b.WriteString("</" + d.tag + ">")
+}
+
+func mustParse(src string) *html.Node {
+	doc, err := html.Parse(strings.NewReader(src))
+	if err != nil {
+		panic(err)
+	}
+	return doc
+}
+
+func tagsOf(els []*html.Node) []string {
+	out := make([]string, len(els))
+	for i, e := range els {
+		out[i] = e.Data
+	}
+	return out
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
diff --git a/hegel_docs_test.go b/hegel_docs_test.go
new file mode 100644
index 0000000..12d55e8
--- /dev/null
+++ b/hegel_docs_test.go
@@ -0,0 +1,659 @@
+package cascadia_test
+
+// The documents of the properties, drawn as dnode records
+// (hegel_doc_test.go) from package-level generators: the same shapes, ranges
+// and rates as the old draw-helper generator genDoc had (the tree under a
+// synthetic html element with an optional lang attribute, 1-5 kids of the
+// body at depth 0-3, the kid kinds, the tags, the attributes). Every element
+// is one hegel.Composite over the docCtx of its ancestors (inside an a, a
+// button, a lang attribute, a disabled fieldset; the nearest lang value)
+// passed down as a value, the idiom of go/cobra's tree generator; the records
+// are built fresh per draw. The simplest alternative comes first in every
+// choice (the plain text kid, an element with no attributes). The shapes of
+// the recorded bugs are drawn at the natural rates of the pools (a cased
+// lang, a lang under a lang, a Unicode-space text, a disabled optgroup, a
+// fieldset inside a disabled one, a link with href, a white-space-only value,
+// a cased type or dir) and the ones that are the document's alone are never
+// drawn under HEGEL_NO_KNOWN=1 (hzUnless, hzShaped, the docCtx rules);
+// docsWith forces one of them at a kid of the body for the narrow properties.
+
+import (
+	"strings"
+
+	"golang.org/x/net/html"
+	"hegel.dev/go/hegel"
+)
+
+// docCtx is the context of an element's ancestors, passed down as a value.
+type docCtx struct {
+	inA, inButton, inLang bool
+	lang                  string // the nearest ancestor's lang attribute (with inLang)
+	inFieldset            bool   // inside a disabled fieldset
+	quiet                 bool   // no link with href, disabled optgroup or nested fieldset in the surroundings (the narrow properties of :enabled)
+}
+
+// The pools of hegel_doc_test.go as generators (the first entry is the shrink
+// target); langValues are lower-cased under HEGEL_NO_KNOWN=1 (cascadia/9).
+var (
+	idValues       = hzSampled(idPool...)
+	classValues    = hzSampled(classPool...)
+	attrValues     = hzSampled(valuePool...)
+	langValues     = hzShaped(hzSampled(langPool...), hegel.Map(hzSampled(langPool...), strings.ToLower))
+	dirValues      = hzSampled(dirPool...)
+	typeValues     = hzSampled(typePool...)
+	words          = hzSampled(wordPool...)
+	wordSeps       = hzSampled(" ", "  ", "\n")
+	classSeps      = hzSampled(" ", "  ", "\t", "\n")
+	spaces         = hzSampled(spacePool...)
+	unicodeSpaces  = hzSampled("\u00a0", " \u00a0", "\u2003")
+	commentTexts   = hzSampled("c", " note ", "")
+	hrefValues     = hzSampled("#", "x.html", "", "https://example.com/")
+	checkedValues  = hzSampled("", "checked")
+	selectedValues = hzSampled("", "selected")
+	disabledValues = hzSampled("", "disabled")
+	nameValues     = hzSampled("q", "Q", "user-name")
+
+	// The ingredients of the shapes the narrow properties force.
+	casedLangs   = hzSampled("EN", "en-US", "fr-CA", "en-Latn-US")             // the pool's cased entries (cascadia/9, 12)
+	lowerLangs   = hzSampled("en", "fr", "de", "en-us", "fr-ca", "en-latn-us") // the region past cascadia/9
+	textLangs    = hzSampled("en", "en-US", "fr", "fr-CA", "de", "en-Latn-US") // a language :lang(primary subtag) matches on both sides (cascadia/1, 10)
+	blankValues  = hzSampled(" ", "  ")                                        // a white-space-only value (cascadia/8)
+	spacedValues = hzSampled("  a  ", " a", "a ")                              // a value that trims to something (past cascadia/8)
+	casedTypes   = hzSampled("Checkbox", "RADIO")                              // the pool's cased type values (cascadia/12)
+	casedDirs    = hzSampled("LTR")
+)
+
+// The weights below are tuned, not nominal (the go/cobra precedent): the
+// engine's bounded integer draw favours the first alternative of a weighted
+// choice by ten to fifteen points beyond its weight and shrinks the others in
+// proportion (hzMaybe(40, g) realised g 30 to 34 % of the time, the 30/55/7/4/4
+// kid kinds 41/47/5/3/4; with a first weight under about ten the surplus spills
+// into the second alternative), and puts the same surplus on lo+1 of an hzInts
+// range and on index 1 of a SampledFrom table (hzInts(0, 3) realised
+// 21/34/23/22, the four combinators 21/41/19/19), so a uniform range or table
+// is a weighted choice of its values with a low first weight (weightedOver,
+// evenInts). Every weight was tuned until the realised rate was the nominal
+// one, measured over 3000 draws with four seeds (a probe drawing docs,
+// stdGroups and extGroups through the harness); the comment beside it gives
+// the nominal rate and what the weight realises, as a range where the same
+// weight moved between runs (the bias is per run: two to three points on a
+// rate drawn a thousand times per run). The order stays: the first alternative
+// is the shrink target. The pools (hzSampled) are not tuned: index 1 of a
+// long table is drawn at about twice its share (class 16 % of the attribute
+// keys, last-child 17 % of the plain pseudo-classes, span 7 % of the
+// container tags).
+
+// weightedOver: a choice over the values at the weights (the first the shrink
+// target), the form of a uniform table here.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform
+// range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// texts is a text node's content: one to three words of the pool joined by
+// one separator.
+var texts = hegel.FlatMap(hzCounted(words, 1, 3), func(ws []string) hegel.Generator[string] {
+	return hegel.Map(wordSeps, func(sep string) string { return strings.Join(ws, sep) })
+})
+
+// classLists is a class attribute's value: zero to three classes of the pool
+// joined by one separator.
+var classLists = hegel.FlatMap(countedBy(classValues, evenInts(0, 16, 27, 29, 30)), func(cls []string) hegel.Generator[string] { // 0-3 uniform: realises 25/26/25/24 (hzCounted realised 22/29/24/25)
+	return hegel.Map(classSeps, func(sep string) string { return strings.Join(cls, sep) })
+})
+
+func textNodes(g hegel.Generator[string]) hegel.Generator[*dnode] {
+	return hegel.Map(g, func(t string) *dnode { return &dnode{kind: 1, text: t} })
+}
+
+// The non-element kids: a text of words, a comment, document white space, and
+// Unicode white space (U+00A0, U+2003: the shape of cascadia/11).
+var (
+	textKids         = textNodes(texts)
+	commentKids      = hegel.Map(commentTexts, func(t string) *dnode { return &dnode{kind: 2, text: t} })
+	spaceKids        = textNodes(spaces)
+	unicodeSpaceKids = textNodes(unicodeSpaces)
+)
+
+// attrAt is the attribute key with a drawn value pct percent of the time, as a
+// list of none or one (hzSeq joins them).
+func attrAt(pct int, key string, values hegel.Generator[string]) hegel.Generator[[][2]string] {
+	return hzMaybe(pct, hzOne(hegel.Map(values, func(v string) [2]string { return [2]string{key, v} })))
+}
+
+// attrForce is an attribute the narrow properties force on the forced
+// element: always drawn from values, or never drawn with values nil.
+type attrForce struct {
+	key    string
+	values hegel.Generator[string]
+}
+
+type attrForces []attrForce
+
+// at is attrAt, or the forced form of the key.
+func (fs attrForces) at(pct int, key string, values hegel.Generator[string]) hegel.Generator[[][2]string] {
+	for _, f := range fs {
+		if f.key == key {
+			if f.values == nil {
+				return hegel.Just[[][2]string](nil)
+			}
+			return attrAt(100, key, f.values)
+		}
+	}
+	return attrAt(pct, key, values)
+}
+
+// attrsOf: the attributes of an element of the tag under the context, at the
+// old rates: id 40, class 50, data-x 30, title 15, lang 20, dir 10; href 60
+// on a and area, type 80 and checked 40 on input, selected 40 on option,
+// disabled 30 on the form elements, name 10. Under HEGEL_NO_KNOWN=1 no lang
+// under a lang (cascadia/10) and no disabled optgroup (cascadia/5); in a
+// quiet context (the narrow properties of :enabled) no href and no disabled
+// optgroup either.
+func attrsOf(tag string, ctx docCtx, fs attrForces) hegel.Generator[[][2]string] {
+	parts := []hegel.Generator[[][2]string]{
+		fs.at(46, "id", idValues),                                        // 40 nominal: weight 46 realises 39 to 40 (weight 40 realised 34)
+		fs.at(59, "class", classLists),                                   // 50 nominal: weight 59 realises 50 (weight 50 realised 43)
+		fs.at(36, "data-x", attrValues),                                  // 30 nominal: weight 36 realises 30 to 31 (weight 30 realised 24)
+		fs.at(18, "title", attrValues),                                   // 15 nominal: weight 18 realises 15 (weight 15 realised 13)
+		fs.at(hzUnless(hzNoKnown && ctx.inLang, 24), "lang", langValues), // 20 nominal: weight 24 realises 20 to 21 (weight 20 realised 16)
+		fs.at(12, "dir", dirValues),                                      // 10 nominal: weight 12 realises 10.5 (weight 10 realised 9.6)
+	}
+	switch tag {
+	case "a", "area":
+		parts = append(parts, fs.at(hzUnless(ctx.quiet, 68), "href", hrefValues)) // 60 nominal: weight 68 realises 57 to 60 (weight 60 realised 54; 69 realised 63)
+	case "input":
+		parts = append(parts, fs.at(90, "type", typeValues), fs.at(47, "checked", checkedValues)) // 80 and 40 nominal: weights 90 and 47 realise 79 to 81 and 41 to 42 (weights 80 and 40 realised 70 and 30)
+	case "option":
+		parts = append(parts, fs.at(48, "selected", selectedValues)) // 40 nominal: weight 48 realises 40 to 42 (weight 40 realised 36)
+	}
+	switch tag {
+	case "input", "button", "textarea", "fieldset", "optgroup", "option", "select":
+		parts = append(parts, fs.at(hzUnless(tag == "optgroup" && (hzNoKnown || ctx.quiet), 36), "disabled", disabledValues)) // 30 nominal: weight 36 realises 31 (weight 30 realised 24.5)
+	}
+	parts = append(parts, fs.at(11, "name", nameValues)) // 10 nominal: weight 11 realises 10 (weight 10 realised 8.5)
+	return hzSeq(parts...)
+}
+
+// attr is the value of the node's attribute.
+func (d *dnode) attr(key string) (string, bool) {
+	for _, a := range d.attrs {
+		if a[0] == key {
+			return a[1], true
+		}
+	}
+	return "", false
+}
+
+// under is the context of the element's kids.
+func (ctx docCtx) under(e *dnode) docCtx {
+	if v, ok := e.attr("lang"); ok {
+		ctx.inLang, ctx.lang = true, v
+	}
+	switch e.tag {
+	case "a":
+		ctx.inA = true
+	case "button":
+		ctx.inButton = true
+	case "fieldset":
+		if _, ok := e.attr("disabled"); ok {
+			ctx.inFieldset = true
+		}
+	}
+	return ctx
+}
+
+// containersIn is a container tag of the pool, a span instead of an a inside
+// an a or a button inside a button (the parsers would disagree), and instead
+// of a fieldset inside a disabled fieldset under HEGEL_NO_KNOWN=1 or in a quiet
+// context (cascadia/14).
+func containersIn(ctx docCtx) hegel.Generator[string] {
+	return hegel.Map(hzSampled(containerTags...), func(t string) string {
+		if (t == "a" && ctx.inA) || (t == "button" && ctx.inButton) || (t == "fieldset" && ctx.inFieldset && (hzNoKnown || ctx.quiet)) {
+			return "span"
+		}
+		return t
+	})
+}
+
+// tagsIn is an element's tag: a container (68 %), input 12, area 4, textarea
+// 6, optgroup 6, option 4.
+func tagsIn(ctx docCtx) hegel.Generator[string] {
+	return hzWeighted(
+		hzW(64, containersIn(ctx)),     // 68 nominal: weight 64 realises 68 to 69 (weight 68 realised 75)
+		hzW(13, hegel.Just("input")),   // 12 nominal: weight 13 realises 11 (weight 12 realised 9.5)
+		hzW(5, hegel.Just("area")),     // 4 nominal: weight 5 realises 3.8 (weight 4 realised 3.1)
+		hzW(7, hegel.Just("textarea")), // 6 nominal: weight 7 realises 5.3 to 5.7 (weight 6 realised 4.4)
+		hzW(8, hegel.Just("optgroup")), // 6 nominal: weight 8 realises 6.8 (weight 6 realised 4.1)
+		hzW(5, hegel.Just("option")),   // 4 nominal: weight 5 realises 4.4 to 4.6 (weight 4 realised 3.7)
+	)
+}
+
+// kidsFunc draws the kids of a forced element: the element, its depth and
+// the context under it.
+type kidsFunc func(e *dnode, depth int, ctx docCtx) hegel.Generator[[]*dnode]
+
+// elementsOf: an element with a tag drawn from tags, its attributes (with the
+// forced ones) and its kids: contentOf's by tag, or the forced kids.
+func elementsOf(tags hegel.Generator[string], depth int, ctx docCtx, fs attrForces, kids kidsFunc) hegel.Generator[*dnode] {
+	return hegel.Composite(func(tc hegel.TestCase) *dnode {
+		e := &dnode{tag: hegel.Draw(tc, tags)}
+		e.attrs = hegel.Draw(tc, attrsOf(e.tag, ctx, fs))
+		under := ctx.under(e)
+		if kids == nil {
+			e.kids = hegel.Draw(tc, contentOf(e.tag, depth, under))
+		} else {
+			e.kids = hegel.Draw(tc, kids(e, depth, under))
+		}
+		return e
+	})
+}
+
+// elementsAt: an element at the depth under the context.
+func elementsAt(depth int, ctx docCtx) hegel.Generator[*dnode] {
+	return elementsOf(tagsIn(ctx), depth, ctx, nil, nil)
+}
+
+// contentOf: the kids of an element of the tag: none for the void input and
+// area; a text 60 % of the time for textarea and option; 0-3 options for an
+// optgroup; for a container 0-4 kids at the depth below, or at depth 0 a text
+// 40 % of the time.
+func contentOf(tag string, depth int, ctx docCtx) hegel.Generator[[]*dnode] {
+	switch tag {
+	case "input", "area":
+		return hegel.Just[[]*dnode](nil)
+	case "textarea", "option":
+		return hzMaybe(68, hzOne(textKids)) // 60 nominal: weight 68 realises 58 to 60 (weight 60 realised 51)
+	case "optgroup":
+		return countedBy(optionsIn(ctx), evenInts(0, 17, 28, 26, 28)) // 0-3 uniform: realises 26/26/24/25 (hzCounted realised 25/30/24/21)
+	}
+	if depth > 0 {
+		return countedBy(kidsAt(depth-1, ctx), evenInts(0, 12, 21, 24, 21, 23)) // 0-4 uniform: realises 20/21/18/20/20 (hzCounted realised 18/27/19/18/19)
+	}
+	return hzMaybe(46, hzOne(textKids)) // 40 nominal: weight 46 realises 39 (weight 40 realised 33.5)
+}
+
+// optionsIn: an option of an optgroup, with a text 50 % of the time.
+func optionsIn(ctx docCtx) hegel.Generator[*dnode] { return optionsWith(ctx, nil) }
+
+func optionsWith(ctx docCtx, fs attrForces) hegel.Generator[*dnode] {
+	return elementsOf(hegel.Just("option"), 0, ctx, fs, func(*dnode, int, docCtx) hegel.Generator[[]*dnode] {
+		return hzMaybe(60, hzOne(textKids)) // 50 nominal: weight 60 realises 48 to 50 (weight 50 realised 42)
+	})
+}
+
+// kidsAt: a kid at the depth under the context: a text (30 %), an element
+// (55), a comment (7), document white space (4) or Unicode white space (4;
+// never under HEGEL_NO_KNOWN=1, when the document white space takes its
+// share: cascadia/11).
+func kidsAt(depth int, ctx docCtx) hegel.Generator[*dnode] {
+	// The weights of a text and an element differ by depth: 18 and 64
+	// realised 29/56 at every depth but 33/52 at depth 0 (an element there
+	// draws little after its kind) and 27/58 at depth 2; the weights by depth
+	// realise 29.5/55.6, 27.3/57.4, 28.5/55.8 and 29.8/57.3 at depths 0 to 3
+	// (28.7/56.4 over all).
+	text, element := 18, 64
+	switch depth {
+	case 0:
+		text, element = 16, 67
+	case 2:
+		text, element = 20, 60
+	case 3:
+		text, element = 19, 61
+	}
+	return hzWeighted(
+		hzW(text, textKids),                           // 30 nominal: weights 16 to 20 realise 27 to 30 (weight 30 realised 41)
+		hzW(element, elementsAt(depth, ctx)),          // 55 nominal: weights 60 to 67 realise 55 to 57 (weight 55 realised 47.5)
+		hzW(9, commentKids),                           // 7 nominal: weight 9 realises 7 (weight 7 realised 5)
+		hzW(hzShaped(5, 10), spaceKids),               // 4 nominal: weight 5 realises 3.6 (weight 4 realised 3)
+		hzW(hzUnless(hzNoKnown, 5), unicodeSpaceKids), // 4 nominal: weight 5 realises 4.4 (weight 4 realised 3.9)
+	)
+}
+
+// The top of a document: a root lang 25 % of the time, 1-5 kids of the body
+// at depth 0-3.
+var (
+	rootLangs     = attrAt(28, "lang", langValues)  // 25 nominal: weight 28 realises 23 to 26 (weight 25 realised 21)
+	bodyDepths    = evenInts(0, 14, 26, 30, 31)     // 0-3 uniform: realises 25/24/26/25 (hzInts realised 21/34/23/22)
+	bodyKidCounts = evenInts(1, 15, 20, 23, 20, 22) // 1-5 uniform: realises 19/19/20/21/21 (hzCounted realised 18/23/20/18/21)
+)
+
+// bodyKidsIn: a kid of the body at a drawn depth 0-3.
+func bodyKidsIn(ctx docCtx) hegel.Generator[*dnode] {
+	return hegel.FlatMap(bodyDepths, func(depth int) hegel.Generator[*dnode] { return kidsAt(depth, ctx) })
+}
+
+// --------------------------------------------------------------------------- the forced kids
+
+// docShapes: the ingredient a narrow property forces on one kid of the body
+// (docsWith); the zero value is the plain document of the wide properties
+// (docs). The forced kid is built from the ingredient at a forced point with
+// random surroundings (its other attributes, its other kids, the kids around
+// it, its position among the body's kids); the nodes a shape names are marked
+// for the selector constructions of the narrow properties ("subject",
+// "inner", "outer").
+type docShapes struct {
+	forced string // one of the kinds below; "" for none
+	quiet  bool   // no link with href, disabled optgroup or nested fieldset in the surroundings, so that :enabled reaches the forced ingredient alone
+}
+
+const (
+	fLangText         = "lang text"         // cascadia/1: an element with a lang (textLangs) whose first kid is a text node, then 0-3 kids
+	fDisabledOptgroup = "disabled optgroup" // cascadia/5: a disabled optgroup with 1-3 options
+	fEnabledOptgroup  = "enabled optgroup"  // past 5: an optgroup without the attribute with 1-3 options
+	fHasAbove         = "has above"         // cascadia/6: an outer container, a subject container inside it and an element inside the subject
+	fLink             = "link"              // cascadia/7: an a or area with href
+	fPlainLink        = "plain link"        // past 7: an a or area without href
+	fBlankValue       = "blank value"       // cascadia/8: a container whose title or data-x is white space only
+	fSpacedValue      = "spaced value"      // past 8: a container whose title or data-x has surrounding white space
+	fCasedLang        = "cased lang"        // cascadia/9: a container with a cased lang outside its ancestors' language
+	fLowerLang        = "lower lang"        // past 9: a container with a lower-case lang
+	fNestedLang       = "nested lang"       // cascadia/10: a container with a lang (textLangs) and an inner element of another language
+	fSameLang         = "same lang"         // past 10: the inner element of the same primary subtag
+	fUnicodeSpace     = "unicode space"     // cascadia/11: a container whose only kid is Unicode white space
+	fDocSpace         = "document space"    // past 11: a container whose only kid is document white space
+	fCasedValue       = "cased value"       // cascadia/12: an input with a cased type, or a container with a cased dir or lang
+	fNestedFieldset   = "nested fieldset"   // cascadia/14: a disabled fieldset with a fieldset among its kids
+	fLegendFieldset   = "legend fieldset"   // past 14: a disabled fieldset whose first kid is a legend holding the inner fieldset
+)
+
+// marked gives the drawn node the role.
+func marked(mark string, g hegel.Generator[*dnode]) hegel.Generator[*dnode] {
+	return hegel.Map(g, func(e *dnode) *dnode {
+		e.mark = mark
+		return e
+	})
+}
+
+// around: the inner node among 0-2 kids before and after it at the depth below.
+func around(inner hegel.Generator[*dnode], depth int, ctx docCtx) hegel.Generator[[]*dnode] {
+	return hzSeq(hzCounted(kidsAt(depth-1, ctx), 0, 2), hzOne(inner), hzCounted(kidsAt(depth-1, ctx), 0, 2))
+}
+
+// primaryOf is the primary subtag of a language tag, lower-cased.
+func primaryOf(lang string) string {
+	if i := strings.IndexByte(lang, '-'); i >= 0 {
+		lang = lang[:i]
+	}
+	return asciiLower(lang)
+}
+
+// langsOutside is the languages of g whose primary subtag differs from the
+// context's nearest lang attribute (an ancestor's matching lang would mask
+// cascadia/9 and 10: the library climbs to it).
+func langsOutside(g hegel.Generator[string], ctx docCtx) hegel.Generator[string] {
+	if !ctx.inLang {
+		return g
+	}
+	return hegel.Filter(g, func(l string) bool { return primaryOf(l) != primaryOf(ctx.lang) })
+}
+
+// innerLangsFor: a lang of the pool of the same primary subtag as the outer
+// one (same: the region past cascadia/10, where the library's climb changes
+// nothing) or of another one (the shape: "" and "e" included).
+func innerLangsFor(outer string, same bool) hegel.Generator[string] {
+	return hegel.Filter(hzSampled(langPool...), func(l string) bool { return (primaryOf(l) == primaryOf(outer)) == same })
+}
+
+// forcedAt: the forced kid of the kind at the depth under the context.
+func forcedAt(kind string, depth int, ctx docCtx) hegel.Generator[*dnode] {
+	containers := containersIn(ctx)
+	textFirst := func(e *dnode, depth int, under docCtx) hegel.Generator[[]*dnode] {
+		return hzSeq(hzOne(textKids), hzCounted(kidsAt(depth-1, under), 0, 3))
+	}
+	innerLang := func(same bool) kidsFunc {
+		return func(e *dnode, depth int, under docCtx) hegel.Generator[[]*dnode] {
+			outer, _ := e.attr("lang")
+			return around(marked("inner", elementsOf(containersIn(under), depth-1, under, attrForces{{"lang", innerLangsFor(outer, same)}}, nil)), depth, under)
+		}
+	}
+	only := func(kid hegel.Generator[*dnode]) kidsFunc {
+		return func(*dnode, int, docCtx) hegel.Generator[[]*dnode] { return hzOne(kid) }
+	}
+	// The first option without the disabled attribute (an option disabled by
+	// its own attribute is disabled on both sides), 0-2 more at random.
+	options := func(e *dnode, depth int, under docCtx) hegel.Generator[[]*dnode] {
+		return hzSeq(hzOne(optionsWith(under, attrForces{{"disabled", nil}})), hzCounted(optionsIn(under), 0, 2))
+	}
+	innerFieldset := func(e *dnode, depth int, under docCtx) hegel.Generator[[]*dnode] {
+		return around(marked("inner", elementsOf(hegel.Just("fieldset"), depth-1, under, attrForces{{"disabled", nil}}, nil)), depth, under)
+	}
+	legendFieldset := func(e *dnode, depth int, under docCtx) hegel.Generator[[]*dnode] {
+		legend := elementsOf(hegel.Just("legend"), depth, under, nil, innerFieldset)
+		return hzSeq(hzOne(legend), hzCounted(kidsAt(depth-1, under), 0, 3))
+	}
+	valued := func(values hegel.Generator[string]) hegel.Generator[*dnode] {
+		return hegel.FlatMap(hzSampled("title", "data-x"), func(key string) hegel.Generator[*dnode] {
+			return marked("subject", elementsOf(containers, depth, ctx, attrForces{{key, values}}, nil))
+		})
+	}
+	switch kind {
+	case fLangText:
+		return marked("subject", elementsOf(containers, depth, ctx, attrForces{{"lang", textLangs}}, textFirst))
+	case fDisabledOptgroup:
+		return marked("subject", elementsOf(hegel.Just("optgroup"), depth, ctx, attrForces{{"disabled", disabledValues}}, options))
+	case fEnabledOptgroup:
+		return marked("subject", elementsOf(hegel.Just("optgroup"), depth, ctx, attrForces{{"disabled", nil}}, options))
+	case fHasAbove:
+		return marked("outer", elementsOf(containers, depth, ctx, nil, func(x *dnode, depth int, under docCtx) hegel.Generator[[]*dnode] {
+			subject := elementsOf(containersIn(under), depth-1, under, nil, func(s *dnode, depth int, under docCtx) hegel.Generator[[]*dnode] {
+				return around(marked("inner", elementsAt(depth-1, under)), depth, under)
+			})
+			return around(marked("subject", subject), depth, under)
+		}))
+	case fLink:
+		return marked("subject", elementsOf(hzSampled("a", "area"), depth, ctx, attrForces{{"href", hrefValues}}, nil))
+	case fPlainLink:
+		return marked("subject", elementsOf(hzSampled("a", "area"), depth, ctx, attrForces{{"href", nil}}, nil))
+	case fBlankValue:
+		return valued(blankValues)
+	case fSpacedValue:
+		return valued(spacedValues)
+	case fCasedLang:
+		return marked("subject", elementsOf(containers, depth, ctx, attrForces{{"lang", langsOutside(casedLangs, ctx)}}, nil))
+	case fLowerLang:
+		return marked("subject", elementsOf(containers, depth, ctx, attrForces{{"lang", langsOutside(lowerLangs, ctx)}}, nil))
+	case fNestedLang:
+		return marked("outer", elementsOf(containers, depth, ctx, attrForces{{"lang", textLangs}}, innerLang(false)))
+	case fSameLang:
+		return marked("outer", elementsOf(containers, depth, ctx, attrForces{{"lang", textLangs}}, innerLang(true)))
+	case fUnicodeSpace:
+		return marked("subject", elementsOf(containers, depth, ctx, nil, only(unicodeSpaceKids)))
+	case fDocSpace:
+		return marked("subject", elementsOf(containers, depth, ctx, nil, only(spaceKids)))
+	case fCasedValue:
+		return marked("subject", hzWeighted(
+			hzW(2, elementsOf(hegel.Just("input"), depth, ctx, attrForces{{"type", casedTypes}}, nil)),
+			hzW(1, elementsOf(containers, depth, ctx, attrForces{{"dir", casedDirs}}, nil)),
+			hzW(1, elementsOf(containers, depth, ctx, attrForces{{"lang", langsOutside(casedLangs, ctx)}}, nil)),
+		))
+	case fNestedFieldset:
+		return marked("outer", elementsOf(hegel.Just("fieldset"), depth, ctx, attrForces{{"disabled", disabledValues}}, innerFieldset))
+	case fLegendFieldset:
+		return marked("outer", elementsOf(hegel.Just("fieldset"), depth, ctx, attrForces{{"disabled", disabledValues}}, legendFieldset))
+	}
+	panic("forced kid " + kind)
+}
+
+// forcedKidsIn: the forced kid at a drawn depth: 1-3, so that it has kids of
+// its own where its kind needs them (2-3 for the two levels of cascadia/6).
+func forcedKidsIn(kind string, ctx docCtx) hegel.Generator[*dnode] {
+	lo := 1
+	if kind == fHasAbove {
+		lo = 2
+	}
+	return hegel.FlatMap(hzInts(lo, 3), func(depth int) hegel.Generator[*dnode] { return forcedAt(kind, depth, ctx) })
+}
+
+// docsWith: a document with the shape's ingredient forced on one kid of the
+// body; the rest as the plain documents: a root lang 25 % of the time, body
+// attributes 30 %, 1-5 kids at depth 0-3 (0-2 before and after the forced
+// kid). The head is empty.
+func docsWith(o docShapes) hegel.Generator[*dnode] {
+	return hegel.Composite(func(tc hegel.TestCase) *dnode {
+		root := &dnode{tag: "html"}
+		ctx := docCtx{quiet: o.quiet}
+		root.attrs = hegel.Draw(tc, rootLangs)
+		ctx = ctx.under(root)
+		body := &dnode{tag: "body"}
+		body.attrs = hegel.Draw(tc, hzMaybe(34, attrsOf("body", ctx, nil))) // 30 nominal: weight 34 realises 29 to 30 (weight 30 realised 26)
+		ctx = ctx.under(body)
+		kids := countedBy(bodyKidsIn(ctx), bodyKidCounts)
+		if o.forced != "" {
+			kids = hzSeq(hzCounted(bodyKidsIn(ctx), 0, 2), hzOne(forcedKidsIn(o.forced, ctx)), hzCounted(bodyKidsIn(ctx), 0, 2))
+		}
+		body.kids = hegel.Draw(tc, kids)
+		root.kids = []*dnode{{tag: "head"}, body}
+		return root
+	})
+}
+
+// docs: the plain documents of the wide properties.
+var docs = docsWith(docShapes{})
+
+// find is the first node of the document with the mark, in document order.
+func (d *dnode) find(mark string) *dnode {
+	if d.mark == mark {
+		return d
+	}
+	for _, k := range d.kids {
+		if f := k.find(mark); f != nil {
+			return f
+		}
+	}
+	return nil
+}
+
+// hasLink: does the document have an a or area with an href (cascadia/7)?
+func hasLink(d *dnode) bool {
+	if d.kind == 0 && (d.tag == "a" || d.tag == "area") {
+		if _, ok := d.attr("href"); ok {
+			return true
+		}
+	}
+	for _, k := range d.kids {
+		if hasLink(k) {
+			return true
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- the parsed nodes
+
+// docNodes is a parsed document's nodes: all of them in pre-order from the
+// document node (MatchAll's walk; QueryAll's is all[1:]), their positions,
+// and the elements in document order (the oracle's indices).
+type docNodes struct {
+	all []*html.Node
+	pos map[*html.Node]int
+	els []*html.Node
+}
+
+func nodesOf(doc *html.Node) *docNodes {
+	d := &docNodes{pos: map[*html.Node]int{}}
+	var walk func(*html.Node)
+	walk = func(n *html.Node) {
+		d.pos[n] = len(d.all)
+		d.all = append(d.all, n)
+		if n.Type == html.ElementNode {
+			d.els = append(d.els, n)
+		}
+		for c := n.FirstChild; c != nil; c = c.NextSibling {
+			walk(c)
+		}
+	}
+	walk(doc)
+	return d
+}
+
+// label describes a node with its pre-order position: "7:span#a1",
+// "9:\"lorem\"" (a text node), "2:<!--c-->", "1:doctype", "0:document".
+func (d *docNodes) label(n *html.Node) string {
+	pos := "?"
+	if i, ok := d.pos[n]; ok {
+		pos = itoa(i)
+	}
+	switch n.Type {
+	case html.ElementNode:
+		if id, ok := attrOf(n, "id"); ok {
+			return pos + ":" + n.Data + "#" + id
+		}
+		return pos + ":" + n.Data
+	case html.TextNode:
+		return pos + ":" + quoted(n.Data)
+	case html.CommentNode:
+		return pos + ":<!--" + n.Data + "-->"
+	case html.DoctypeNode:
+		return pos + ":doctype"
+	case html.DocumentNode:
+		return pos + ":document"
+	}
+	return pos + ":node"
+}
+
+func (d *docNodes) labels(ns []*html.Node) []string {
+	out := []string{}
+	for _, n := range ns {
+		out = append(out, d.label(n))
+	}
+	return out
+}
+
+// elementLabels: the labels of the elements at the oracle's indices.
+func (d *docNodes) elementLabels(idx []int) []string {
+	out := []string{}
+	for _, i := range idx {
+		if i >= 0 && i < len(d.els) {
+			out = append(out, d.label(d.els[i]))
+		} else {
+			out = append(out, "?:element "+itoa(i))
+		}
+	}
+	return out
+}
+
+// modelNodes: the nodes the model matches with the switches k, among all the
+// nodes (withDoc: MatchAll's walk) or the document's descendants (QueryAll's).
+func (d *docNodes) modelNodes(g group, k known, withDoc bool) []*html.Node {
+	var out []*html.Node
+	nodes := d.all
+	if !withDoc {
+		nodes = d.all[1:]
+	}
+	for _, n := range nodes {
+		if modelGroup(g, n, k) {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// mask: the model's verdict on every node as a string of 0 and 1 (the
+// classifier compares the verdicts of several sets of switches).
+func (d *docNodes) mask(g group, k known) string {
+	b := make([]byte, len(d.all))
+	for i, n := range d.all {
+		b[i] = '0'
+		if modelGroup(g, n, k) {
+			b[i] = '1'
+		}
+	}
+	return string(b)
+}
diff --git a/hegel_idioms_test.go b/hegel_idioms_test.go
new file mode 100644
index 0000000..be42df4
--- /dev/null
+++ b/hegel_idioms_test.go
@@ -0,0 +1,159 @@
+package cascadia_test
+
+// The generator idioms the properties share, copied from the go/excelize, go/graphql-go and
+// go/cobra harness (hegel/hegel_zoo_idioms_test.go there; go/bubbles' internal/zootest/gen.go
+// before it) with the hz prefix: hegel-go has no weighted choice, biased coin, tuple or
+// counted-list combinator. Every generator built from them is a package-level value; the
+// simplest alternative comes first so that shrinking lands on it, except the shape of a
+// recorded bug a wide property must reach every run, which goes first at a solid weight and
+// is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a weighted choice drawn
+// alone comes out exact (the engine enumerates a small die), but inside a case with other
+// draws the engine favours the first alternative (excelize measured the first of a 2:18:10
+// choice drawn 40% of the time when another draw precedes or follows it, 7% alone), so the
+// rates are what the collector (HEGEL_COLLECT=1) measures.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
diff --git a/hegel_match_shapes_test.go b/hegel_match_shapes_test.go
new file mode 100644
index 0000000..0f3f181
--- /dev/null
+++ b/hegel_match_shapes_test.go
@@ -0,0 +1,362 @@
+package cascadia_test
+
+// The shape regions of the recorded matching bugs (bugs.toml cascadia/1, 5,
+// 6, 7, 8, 9, 10, 11, 12 and 14) and the narrow properties over them: each
+// region is a drawn document with the shape's ingredient forced at one kid of
+// the body (docsWith) and a selector drawn from that document to reach it,
+// with random surroundings (the other attributes and kids, the kids around,
+// the other selectors' forms), judged exactly like the wide properties
+// (judgeMatch, with the classifier matchShape naming the bug): against
+// soupsieve where the grammar is standard (every one but the :contains and
+// :matches forms of cascadia/1) and against the model always. Every narrow
+// property fails every run by default: its cases are filtered by the
+// classifier naming its bug, so that an instance of the documented shape the
+// library happens to get right is rejected and counted ("filtered
+// cascadia/N"; the rates are in the comments); under HEGEL_NO_KNOWN=1 the
+// construction is one from the region next to the shape instead (hzShaped)
+// and the property passes.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowMatch runs a narrow property: every drawn case through the wide
+// properties' judge.
+func narrowMatch(t *testing.T, cases hegel.Generator[matchCase]) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeMatch(j, c)
+		col.count("cases")
+	})
+}
+
+// regionOf: the cases of the bug's region, filtered by default by the
+// classifier naming the bug (the rejections counted "filtered cascadia/N");
+// under HEGEL_NO_KNOWN=1 the cases are the region past the shape, unfiltered
+// (a case that happens to have a shape is skipped by the judge and counted
+// as known). The narrow properties of hegel_syntax_shapes_test.go share it
+// with their own classifiers.
+func regionOf[T any](id string, shape func(T) string, cases hegel.Generator[T]) hegel.Generator[T] {
+	return hzOnly(!hzNoKnown, id, cases, func(c T) bool { return shape(c) == id })
+}
+
+// matchShapeID: the name of the shape of a matching case (matchShape).
+func matchShapeID(c matchCase) string {
+	shape, _ := matchShape(c)
+	return shape
+}
+
+// casesFrom: cases of one selector list drawn from the document.
+func casesFrom(drawn string, ext bool, docs hegel.Generator[*dnode], sels func(*dnode) hegel.Generator[group]) hegel.Generator[matchCase] {
+	return casesOf(drawn, ext, docs, func(d *dnode) hegel.Generator[[]group] { return hzOne(sels(d)) })
+}
+
+// shapedDocs: the documents of the shape, or past it under HEGEL_NO_KNOWN=1.
+func shapedDocs(shape, past docShapes) hegel.Generator[*dnode] {
+	return docsWith(hzShaped(shape, past))
+}
+
+// --------------------------------------------------------------------------- cascadia/1
+
+// textOnlyStd: over a document with an element S of a language (lang L,
+// textLangs) whose first kid is a text node, a standard selector whose
+// compound of :lang(p) alone (p the primary subtag of L) is tested on text
+// nodes by the library: as the subject (the text kid is returned), before ~
+// where S has an element kid (the first one, preceded by the text kid only,
+// is matched) or inside :has where it has none (S matches through its text
+// kid). Past the shape the compound carries S's type.
+func textOnlyStd(d *dnode) hegel.Generator[group] {
+	s := d.find("subject")
+	l, _ := s.attr("lang")
+	lang := compoundOf(hzShaped("", s.tag), langOf(primaryOf(l)))
+	sibling := groupOf(complexOf("~", lang, compoundOf("*")))
+	has := single(compoundOf("", relSel("has", 0, complexOf("", lang))))
+	other := has
+	for _, kid := range s.kids {
+		if kid.kind == 0 {
+			other = sibling
+			break
+		}
+	}
+	return hzWeighted(hzW(2, hegel.Just(single(lang))), hzW(2, hegel.Just(other)))
+}
+
+// textOnlyExt: the extensions' forms: :contains of a word of S's text kid
+// (the text node is returned), :matchesOwn(^$) and :matches(^$) (the doctype
+// and the comments are returned). Past the shape the compound carries S's
+// type.
+func textOnlyExt(d *dnode) hegel.Generator[group] {
+	s := d.find("subject")
+	tag := hzShaped("", s.tag)
+	ws := strings.Fields(s.kids[0].text)
+	empty := func(name string) simple { return simple{kind: "pseudo", name: name, rx: "^$"} }
+	return hzWeighted(
+		hzW(2, hegel.Map(hzSampled(ws...), func(w string) group {
+			return single(compoundOf(tag, simple{kind: "pseudo", name: "contains", val: w}))
+		})),
+		hzW(2, hegel.Just(single(compoundOf(tag, empty("matchesown"))))),
+		hzW(2, hegel.Just(single(compoundOf(tag, empty("matches"))))),
+	)
+}
+
+var textOnlyRegion = regionOf("cascadia/1", matchShapeID, hzWeighted(
+	hzW(2, casesFrom("text only", false, docsWith(docShapes{forced: fLangText}), textOnlyStd)),
+	hzW(2, casesFrom("text only", true, docsWith(docShapes{forced: fLangText}), textOnlyExt)),
+))
+
+func TestHegelSelectorsMatchOnlyElements(t *testing.T) { narrowMatch(t, textOnlyRegion) }
+
+// --------------------------------------------------------------------------- :enabled and :disabled
+
+// enabledForms: :enabled, :disabled, :not(:enabled), :not(:disabled).
+var enabledForms = hzWeighted(
+	hzW(2, hegel.Just(pseudo("enabled"))),
+	hzW(2, hegel.Just(pseudo("disabled"))),
+	hzW(1, hegel.Just(not(single(compoundOf("", pseudo("enabled")))))),
+	hzW(1, hegel.Just(not(single(compoundOf("", pseudo("disabled")))))),
+)
+
+// enabledOn: a selector of one of the forms on a drawn type.
+func enabledOn(tags hegel.Generator[string]) func(*dnode) hegel.Generator[group] {
+	return func(*dnode) hegel.Generator[group] {
+		return hegel.FlatMap(tags, func(tag string) hegel.Generator[group] {
+			return hegel.Map(enabledForms, func(s simple) group { return single(compoundOf(tag, s)) })
+		})
+	}
+}
+
+// --------------------------------------------------------------------------- cascadia/5
+
+// optgroupRegion: a disabled optgroup with 1-3 options (the first without
+// the attribute) reached by :enabled, :disabled or their negations, on no
+// type, option or *; the surroundings quiet (no link, no nested fieldset:
+// the forms would reach cascadia/7 or 14 there too, and 5 is named first in
+// bug order only for the options). Past the shape: the optgroup without the
+// attribute.
+var optgroupRegion = regionOf("cascadia/5", matchShapeID, casesFrom("disabled optgroup", false,
+	shapedDocs(docShapes{forced: fDisabledOptgroup, quiet: true}, docShapes{forced: fEnabledOptgroup, quiet: true}),
+	enabledOn(hzSampled("", "option", "*"))))
+
+func TestHegelOptionsInDisabledOptgroupsAreDisabled(t *testing.T) { narrowMatch(t, optgroupRegion) }
+
+// --------------------------------------------------------------------------- cascadia/6
+
+// hasAboveSels: over a document with an outer container X, a subject
+// container S inside it and an element Y among S's kids, S's type (or none)
+// with :has(X Y) or :has(> X Y) (X and Y their types, or * a quarter of the
+// time each: with both * the kids of S's kids satisfy the argument inside S
+// too, so the case is rejected): the X is above the subject, so the subject
+// matches in the library only. Past the shape: :has(Y) and, where X's type
+// is not S's, :has(X > Y) with X's type (Y's parent is S, so neither side
+// matches through X; with * or S's type for X the library would match S
+// through S itself).
+func hasAboveSels(d *dnode) hegel.Generator[group] {
+	x, s, y := d.find("outer"), d.find("subject"), d.find("inner")
+	subjects := hzSampled("", s.tag)
+	typeOrStar := func(tag string) hegel.Generator[string] {
+		return hzWeighted(hzW(3, hegel.Just(tag)), hzW(1, hegel.Just("*")))
+	}
+	xs, ys := typeOrStar(x.tag), typeOrStar(y.tag)
+	args := hegel.FlatMap(xs, func(xt string) hegel.Generator[simple] {
+		return hegel.FlatMap(ys, func(yt string) hegel.Generator[simple] {
+			past := hzWeighted(
+				hzW(2, hegel.Just(relSel("has", 0, complexOf("", compoundOf(yt))))),
+				hzW(hzUnless(x.tag == s.tag, 2), hegel.Just(relSel("has", 0, complexOf(">", compoundOf(x.tag), compoundOf(yt))))),
+			)
+			return hzShaped(
+				hegel.Map(hzSampled(byte(0), '>'), func(comb byte) simple { return relSel("has", comb, complexOf(" ", compoundOf(xt), compoundOf(yt))) }),
+				past,
+			)
+		})
+	})
+	return hegel.FlatMap(subjects, func(tag string) hegel.Generator[group] {
+		return hegel.Map(args, func(has simple) group { return single(compoundOf(tag, has)) })
+	})
+}
+
+var hasAboveRegion = regionOf("cascadia/6", matchShapeID, casesFrom("has above", false, docsWith(docShapes{forced: fHasAbove}), hasAboveSels))
+
+func TestHegelHasIsAnchoredAtTheSubject(t *testing.T) { narrowMatch(t, hasAboveRegion) }
+
+// --------------------------------------------------------------------------- cascadia/7
+
+// linkRegion: an a or area with href reached by :enabled or :not(:enabled)
+// (a link is not :disabled on either side) on no type, its type or *, in
+// quiet surroundings (no disabled optgroup or nested fieldset, which 5 would
+// name first). Past the shape: the link without href.
+func linkSels(d *dnode) hegel.Generator[group] {
+	forms := hzWeighted(hzW(2, hegel.Just(pseudo("enabled"))), hzW(1, hegel.Just(not(single(compoundOf("", pseudo("enabled")))))))
+	return hegel.FlatMap(hzSampled("", d.find("subject").tag, "*"), func(tag string) hegel.Generator[group] {
+		return hegel.Map(forms, func(s simple) group { return single(compoundOf(tag, s)) })
+	})
+}
+
+var linkRegion = regionOf("cascadia/7", matchShapeID, casesFrom("link", false,
+	shapedDocs(docShapes{forced: fLink, quiet: true}, docShapes{forced: fPlainLink, quiet: true}), linkSels))
+
+func TestHegelLinksAreNotEnabled(t *testing.T) { narrowMatch(t, linkRegion) }
+
+// --------------------------------------------------------------------------- cascadia/8
+
+// valuedAttr: the subject's title or data-x attribute (the forced one).
+func valuedAttr(s *dnode) (string, string) {
+	for _, key := range []string{"title", "data-x"} {
+		if v, ok := s.attr(key); ok {
+			return key, v
+		}
+	}
+	panic("no forced value")
+}
+
+// blankSels: over a document with an element whose title or data-x is white
+// space only, [key^=v], [key$=v] or [key*=v] with v a space or the whole
+// value (both contained in it). Past the shape the value has surrounding
+// white space around a letter and v is the whole value or the value trimmed
+// (a space alone would reach a white-space-only value in the surroundings:
+// the shape).
+func blankSels(d *dnode) hegel.Generator[group] {
+	key, val := valuedAttr(d.find("subject"))
+	operands := hzShaped(hzSampled(" ", val), hzSampled(val, strings.TrimSpace(val)))
+	return hegel.FlatMap(hzSampled("^=", "$=", "*="), func(op string) hegel.Generator[group] {
+		return hegel.Map(operands, func(v string) group { return single(compoundOf("", attrSel(key, op, v))) })
+	})
+}
+
+var blankRegion = regionOf("cascadia/8", matchShapeID, casesFrom("blank value", false,
+	shapedDocs(docShapes{forced: fBlankValue}, docShapes{forced: fSpacedValue}), blankSels))
+
+func TestHegelBlankValuesMatchSubstrings(t *testing.T) { narrowMatch(t, blankRegion) }
+
+// --------------------------------------------------------------------------- cascadia/9
+
+// casedCuts: the lower-cased prefixes of the language tag at subtag
+// boundaries that cover a capital letter ("en-us" for en-US; "en-latn" and
+// "en-latn-us" for en-Latn-US): :lang of a cut below the capital (en for
+// en-US) matches on both sides. For a lower-case tag, its primary subtag.
+func casedCuts(l string) []string {
+	var out []string
+	parts := strings.Split(l, "-")
+	for i := 1; i <= len(parts); i++ {
+		cut := strings.Join(parts[:i], "-")
+		if strings.ToLower(cut) != cut {
+			out = append(out, asciiLower(cut))
+		}
+	}
+	if len(out) == 0 {
+		out = []string{primaryOf(l)}
+	}
+	return out
+}
+
+// casedLangSels: over a document with an element of a cased lang (outside
+// its ancestors' language), :lang of a cut of it on the element's type (on
+// no type the element's text kids would be the shape of cascadia/1, named
+// first). Past the shape the lang is lower-case.
+func casedLangSels(d *dnode) hegel.Generator[group] {
+	s := d.find("subject")
+	l, _ := s.attr("lang")
+	return hegel.Map(hzSampled(casedCuts(l)...), func(arg string) group { return single(compoundOf(s.tag, langOf(arg))) })
+}
+
+var casedLangRegion = regionOf("cascadia/9", matchShapeID, casesFrom("cased lang", false,
+	shapedDocs(docShapes{forced: fCasedLang}, docShapes{forced: fLowerLang}), casedLangSels))
+
+func TestHegelLangIsCaseInsensitive(t *testing.T) { narrowMatch(t, casedLangRegion) }
+
+// --------------------------------------------------------------------------- cascadia/10
+
+// nestedLangSels: over a document with an outer element of a language and an
+// inner element of another (an empty lang included), :lang of the outer's
+// primary subtag on the inner element's type (on no type the outer's text
+// kids would be the shape of cascadia/1, named first): the inner element
+// matches in the library only. Past the shape the inner element is of the
+// same primary subtag.
+func nestedLangSels(d *dnode) hegel.Generator[group] {
+	l, _ := d.find("outer").attr("lang")
+	return hegel.Just(single(compoundOf(d.find("inner").tag, langOf(primaryOf(l)))))
+}
+
+var nestedLangRegion = regionOf("cascadia/10", matchShapeID, casesFrom("nested lang", false,
+	shapedDocs(docShapes{forced: fNestedLang}, docShapes{forced: fSameLang}), nestedLangSels))
+
+func TestHegelLangUsesTheNearestAttribute(t *testing.T) { narrowMatch(t, nestedLangRegion) }
+
+// --------------------------------------------------------------------------- cascadia/11
+
+// emptySels: over a document with an element whose only kid is Unicode white
+// space, :empty or :not(:empty) on no type or the element's. Past the shape
+// the kid is document white space.
+func emptySels(d *dnode) hegel.Generator[group] {
+	s := d.find("subject")
+	forms := hzWeighted(hzW(2, hegel.Just(pseudo("empty"))), hzW(1, hegel.Just(not(single(compoundOf("", pseudo("empty")))))))
+	return hegel.FlatMap(hzSampled("", s.tag), func(tag string) hegel.Generator[group] {
+		return hegel.Map(forms, func(f simple) group { return single(compoundOf(tag, f)) })
+	})
+}
+
+var emptyRegion = regionOf("cascadia/11", matchShapeID, casesFrom("unicode space", false,
+	shapedDocs(docShapes{forced: fUnicodeSpace}, docShapes{forced: fDocSpace}), emptySels))
+
+func TestHegelEmptyKeepsNonBreakingSpace(t *testing.T) { narrowMatch(t, emptyRegion) }
+
+// --------------------------------------------------------------------------- cascadia/12
+
+// casedAttr: the subject's type, dir or lang attribute with a capital letter
+// (the forced one).
+func casedAttr(s *dnode) (string, string) {
+	for _, key := range []string{"type", "dir", "lang"} {
+		if v, ok := s.attr(key); ok && strings.ToLower(v) != v {
+			return key, v
+		}
+	}
+	panic("no cased value")
+}
+
+// caseVariants: the value lower-cased and upper-cased, without the value
+// itself.
+func caseVariants(v string) []string {
+	var out []string
+	for _, w := range []string{strings.ToLower(v), strings.ToUpper(v)} {
+		if w != v {
+			out = append(out, w)
+		}
+	}
+	return out
+}
+
+// casedValueSels: over a document with an input of a cased type or an
+// element of a cased dir or lang, [key op v] with v another spelling of the
+// value and any of =, ~=, |=, ^=, $= and *=, without the i flag: HTML compares
+// these attributes case-insensitively. Past the shape the i flag is given.
+func casedValueSels(d *dnode) hegel.Generator[group] {
+	key, val := casedAttr(d.find("subject"))
+	ci := hzShaped(false, true)
+	return hegel.FlatMap(hzSampled("=", "~=", "|=", "^=", "$=", "*="), func(op string) hegel.Generator[group] {
+		return hegel.Map(hzSampled(caseVariants(val)...), func(v string) group {
+			return single(compoundOf("", simple{kind: "attr", name: key, op: op, val: v, ci: ci}))
+		})
+	})
+}
+
+var casedValueRegion = regionOf("cascadia/12", matchShapeID, casesFrom("cased value", false, docsWith(docShapes{forced: fCasedValue}), casedValueSels))
+
+func TestHegelHTMLAttributeValuesAreCaseInsensitive(t *testing.T) { narrowMatch(t, casedValueRegion) }
+
+// --------------------------------------------------------------------------- cascadia/14
+
+// fieldsetRegion: a disabled fieldset with a fieldset (without the
+// attribute) among its kids, reached by the :enabled forms on no type,
+// fieldset or *, in quiet surroundings (no link, which 7 would name first).
+// Past the shape the inner fieldset is inside the outer one's first legend,
+// where HTML does not disable it.
+var fieldsetRegion = regionOf("cascadia/14", matchShapeID, casesFrom("nested fieldset", false,
+	shapedDocs(docShapes{forced: fNestedFieldset, quiet: true}, docShapes{forced: fLegendFieldset, quiet: true}),
+	enabledOn(hzSampled("", "fieldset", "*"))))
+
+func TestHegelNestedFieldsetsAreDisabled(t *testing.T) { narrowMatch(t, fieldsetRegion) }
diff --git a/hegel_match_test.go b/hegel_match_test.go
new file mode 100644
index 0000000..f7e30d6
--- /dev/null
+++ b/hegel_match_test.go
@@ -0,0 +1,450 @@
+package cascadia_test
+
+// The matching properties: TestHegelSelectorsAgreeWithSoupsieve (the
+// standard grammar over generated documents against soupsieve and against the
+// model) and TestHegelSelectorsAgreeWithTheModel (the full grammar, the
+// extensions included, against the model, and the query APIs against each
+// other). The cases are records drawn from package-level generators: a
+// document (hegel_docs_test.go) and one to six selector lists
+// (hegel_selectors_test.go); the shape of a case is named by the classifier
+// matchShape (the model run with several sets of switches) before the library
+// is called, and under HEGEL_NO_KNOWN=1 the shapes are not drawn. The narrow
+// properties of hegel_match_shapes_test.go share judgeMatch.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/andybalholm/cascadia"
+	"golang.org/x/net/html"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the cases
+
+// matchCase: a document and the selector lists run over it; ext says the
+// selectors use the library's extensions, which soupsieve cannot be asked
+// about (its :contains is case-sensitive, its :matches is :is, it has no
+// :haschild, != or #=): such a case is judged by the model alone. drawn names
+// the generator the case came from (the collector counts "drawn <name>").
+type matchCase struct {
+	doc   *dnode
+	sels  []group
+	ext   bool
+	drawn string
+}
+
+func (c matchCase) GoString() string {
+	texts := make([]string, len(c.sels))
+	for i, g := range c.sels {
+		texts[i] = canonical(g)
+	}
+	return fmt.Sprintf("selectors %q\ndocument %s", texts, c.doc.html())
+}
+
+func itoa(i int) string { return strconv.Itoa(i) }
+
+func quoted(s string) string { return strconv.Quote(s) }
+
+// casesOf: the cases of the named generator over a document generator and a
+// selector-list generator per document.
+func casesOf(drawn string, ext bool, docs hegel.Generator[*dnode], sels func(*dnode) hegel.Generator[[]group]) hegel.Generator[matchCase] {
+	return hegel.FlatMap(docs, func(d *dnode) hegel.Generator[matchCase] {
+		return hegel.Map(sels(d), func(gs []group) matchCase { return matchCase{doc: d, sels: gs, ext: ext, drawn: drawn} })
+	})
+}
+
+// unshaped: has the case no shape of a recorded bug (the HEGEL_NO_KNOWN=1
+// filter of the wide properties; the generators' own rules make the filter
+// reject nothing, and the collector counts what it does reject as "filtered
+// shaped")?
+func unshaped(c matchCase) bool {
+	shape, _ := matchShape(c)
+	return shape == ""
+}
+
+// The cases of the wide properties: the plain documents with one to six
+// selector lists of the standard grammar (the soupsieve property) or one to
+// five of the full grammar (the model property), the same population as the
+// old generators drew with their gates off.
+var (
+	soupsieveCases = hzOnly(hzNoKnown, "shaped", casesOf("plain", false, docs, func(d *dnode) hegel.Generator[[]group] {
+		return hzCounted(groupsFor(false, d), 1, 6)
+	}), unshaped)
+	modelCases = hzOnly(hzNoKnown, "shaped", casesOf("plain", true, docs, func(d *dnode) hegel.Generator[[]group] {
+		return hzCounted(groupsFor(true, d), 1, 5)
+	}), unshaped)
+)
+
+// --------------------------------------------------------------------------- the classifier
+
+// matchBugs: the switches of the matching bugs, in bug order; the switches of
+// cascadia/2, 3, 4 and 13 act in serialisation, specificity and parsing and
+// never change a match.
+var matchBugs = []int{kTextNodesMatch, kOptionIgnoresOptgroup, kHasUnscoped, kLinksAreEnabled, kBlankValuesNeverMatch, kLangCaseSensitive, kLangInheritsThroughOwn, kEmptyTrimsUnicodeSpace, kHTMLAttrsCaseSensitive, kNestedFieldsetEnabled}
+
+// selectorShape names the recorded bug one selector list reaches over the
+// document, from the records alone: the model with every switch on is a
+// replica of the library, so the selector departs from the documented
+// behaviour where model(all) differs from model(none) on some node. The name
+// is the first bug N in bug order whose switch alone reproduces a departure
+// (model(only N) differs from model(none): sufficiency), else the first whose
+// switch is necessary to it (model(all but N) differs from model(all):
+// necessity, counted "shape via necessity"); a departure neither rule names is
+// a hole of the classifier, named "cascadia/?" and counted. The order matters
+// where several switches act at once: a disabled optgroup's options reached
+// by :enabled in a document that also has a link are cascadia/5 before 7, a
+// nested fieldset reached by :enabled beside a link is 7 before 14, a
+// text-only compound before ~ in a document with a disabled optgroup is 1
+// before 5; a cased lang under another lang with :lang of the inner language
+// is 9 (the raw comparison alone departs), with :lang of the outer language
+// 10 (only the climb departs), and with :lang of the inner language under an
+// outer of the same language nothing at all (the two departures cancel: the
+// library climbs to the outer and matches). The second return is the rule.
+func selectorShape(g group, d *docNodes) (string, string) {
+	all, none := d.mask(g, hzKnownAll), d.mask(g, hzKnownNone)
+	if all == none {
+		return "", ""
+	}
+	for _, i := range matchBugs {
+		if d.mask(g, hzKnownOnly(i)) != none {
+			hzTally("shape via sufficiency")
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for _, i := range matchBugs {
+		if d.mask(g, hzKnownAllBut(i)) != all {
+			hzTally("shape via necessity")
+			return hzKnownID(i), "necessity"
+		}
+	}
+	hzTally("shape hole")
+	return "cascadia/?", "hole"
+}
+
+// matchShapeOf names the shape of the case over its parsed document: the
+// shape of the first selector list in order that has one (the judge reports
+// the first failing selector), every shaped selector counted ("selector
+// cascadia/N"). The string is computed once per case before the library
+// runs.
+func matchShapeOf(c matchCase, d *docNodes) (string, string) {
+	shape, rule := "", ""
+	for _, g := range c.sels {
+		s, r := selectorShape(g, d)
+		if s == "" {
+			continue
+		}
+		hzTally("selector " + s)
+		if shape == "" {
+			shape, rule = s, r
+		}
+	}
+	return shape, rule
+}
+
+// matchShape names the shape of the case (the generators' filters).
+func matchShape(c matchCase) (string, string) {
+	return matchShapeOf(c, nodesOf(mustParse(c.doc.html())))
+}
+
+// --------------------------------------------------------------------------- the judge
+
+// soupsieveCased: does the selector list compare, without the i flag, the
+// value of an attribute HTML defines as case-insensitive other than type?
+// soupsieve folds the case of type alone (css_parser.py, is_type), the model
+// follows HTML's list, so the model is not compared with soupsieve on such a
+// selector: soupsieve's choice, documented here, not a known-bug gate (the
+// library is compared with both as usual: with the i flag forced under
+// HEGEL_NO_KNOWN=1 by the generator, and by default the shape of cascadia/12
+// that the model finds and soupsieve does not show).
+func soupsieveCased(g group) bool {
+	return anySimple(g, func(s simple) bool {
+		return s.kind == "attr" && caseInsensitiveHTMLAttrs[s.name] && s.name != "type" && s.op != "" && s.op != "#=" && !s.ci
+	})
+}
+
+// soupsieveEmptyLang: does the selector list use :lang over a document with
+// an element of lang="" below an element with a lang? HTML makes the
+// language of such an element unknown (the lang and xml:lang attributes:
+// "the empty string ... must be interpreted as meaning that the language of
+// the node is unknown"), which the model follows; soupsieve (css_match.py,
+// match_lang: "while not found_lang") climbs past the empty value to the
+// ancestor's, so the model is not compared with soupsieve on such a case:
+// soupsieve's choice, documented here, not a known-bug gate (the library
+// climbs too: by default the shape of cascadia/10; under HEGEL_NO_KNOWN=1
+// the documents do not nest lang attributes).
+func soupsieveEmptyLang(g group, d *dnode) bool {
+	return anySimple(g, func(s simple) bool { return s.kind == "pseudo" && s.name == "lang" }) && emptyLangUnderLang(d, false)
+}
+
+// emptyLangUnderLang: is there an element with lang="" below one with a lang?
+func emptyLangUnderLang(d *dnode, inLang bool) bool {
+	if d.kind != 0 {
+		return false
+	}
+	if v, ok := d.attr("lang"); ok {
+		if v == "" && inLang {
+			return true
+		}
+		inLang = true
+	}
+	for _, k := range d.kids {
+		if emptyLangUnderLang(k, inLang) {
+			return true
+		}
+	}
+	return false
+}
+
+// soupsieveExtendedLang: does the selector list use :lang with a language
+// range that soupsieve matches to a lang attribute of the document by RFC
+// 4647 extended filtering (Selectors Level 4: :lang(en-us) matches
+// lang="en-Latn-US", the script subtag skipped) where the library's rule
+// (Selectors Level 3: the tag is the range or begins with it and a hyphen,
+// which the model follows) does not, or the other way round? Neither the
+// library nor the model is compared with soupsieve on such a case: the two
+// levels' documented difference, not a known-bug gate (the library is still
+// compared with the model). The pools pair the range en-us with the tag
+// en-Latn-US (en-latn-us under HEGEL_NO_KNOWN=1); the other pairs agree.
+func soupsieveExtendedLang(g group, d *dnode) bool {
+	var ranges []string
+	anySimple(g, func(s simple) bool {
+		if s.kind == "pseudo" && s.name == "lang" {
+			ranges = append(ranges, s.val)
+		}
+		return false
+	})
+	if len(ranges) == 0 {
+		return false
+	}
+	return anyLang(d, func(tag string) bool {
+		tag = strings.ToLower(tag)
+		for _, r := range ranges {
+			if extendedLangMatch(tag, r) != (tag == r || strings.HasPrefix(tag, r+"-")) {
+				return true
+			}
+		}
+		return false
+	})
+}
+
+// anyLang: does an element of the document have a lang attribute f accepts?
+func anyLang(d *dnode, f func(string) bool) bool {
+	if d.kind != 0 {
+		return false
+	}
+	if v, ok := d.attr("lang"); ok && f(v) {
+		return true
+	}
+	for _, k := range d.kids {
+		if anyLang(k, f) {
+			return true
+		}
+	}
+	return false
+}
+
+// extendedLangMatch: does the language tag match the range by RFC 4647
+// extended filtering (3.3.2; both lower-cased)? The first subtags must be
+// equal (or the range's a wildcard); then each further subtag of the range is
+// a wildcard, equal to the tag's next subtag, or reached by skipping the
+// tag's subtags that are longer than one letter.
+func extendedLangMatch(tag, rng string) bool {
+	ts, rs := strings.Split(tag, "-"), strings.Split(rng, "-")
+	if rs[0] != "*" && ts[0] != rs[0] {
+		return false
+	}
+	i, j := 1, 1
+	for i < len(rs) {
+		switch {
+		case rs[i] == "*":
+			i++
+		case j >= len(ts):
+			return false
+		case ts[j] == rs[i]:
+			i++
+			j++
+		case len(ts[j]) == 1:
+			return false
+		default:
+			j++
+		}
+	}
+	return true
+}
+
+func describeNodes(ns []string) string { return "[" + strings.Join(ns, " ") + "]" }
+
+// judgeMatch judges one case: the shape named, every selector list parsed,
+// run by the library (QueryAll over the parsed document) and compared with
+// soupsieve (the standard grammar) and with the model's documented result
+// over every node of the document, the model compared with soupsieve as a
+// check on the model, and the query APIs (MatchAll, Query, MatchFirst, Filter,
+// Selector.Filter, Match) compared with the model too. The result of a
+// selector is the list of its nodes in document order, labelled with their
+// kind, so that a non-element node in the library's result is named. For a
+// shaped case the library's result is also compared with the replica
+// (model(all)): a disagreement is a defect of the replica or a second bug in
+// the case, counted and noted for the collector, not a failure.
+func judgeMatch(j *hzCaseJudge, c matchCase) {
+	j.col.count("drawn " + c.drawn)
+	src := c.doc.html()
+	doc := mustParse(src)
+	d := nodesOf(doc)
+	shape, rule := matchShapeOf(c, d)
+	if rule == "necessity" {
+		j.col.note("via necessity "+shape, "%#v", c)
+	}
+	j.Shape(shape)
+	texts := make([]string, len(c.sels))
+	for i, g := range c.sels {
+		texts[i] = canonical(g)
+	}
+	var resp oracleResp
+	if !c.ext {
+		resp = oracle(j.ht, src, texts)
+		if !equalStrings(resp.Tags, tagsOf(d.els)) {
+			j.Fail("parsers", "HTML parsers disagree\ngo %v\npython %v\n%s", tagsOf(d.els), resp.Tags, src)
+			return
+		}
+	}
+	agree := true
+	for i, g := range c.sels {
+		text := texts[i]
+		sel, err := cascadia.ParseGroup(text)
+		if err != nil {
+			j.Fail("parse", "cascadia rejects the selector: %v\n%s", err, describe(text, src))
+			continue
+		}
+		got := d.labels(cascadia.QueryAll(doc, sel))
+		want := d.labels(d.modelNodes(g, hzKnownNone, false))
+		if j.shape != "" {
+			if replica := d.labels(d.modelNodes(g, hzKnownAll, false)); !equalStrings(got, replica) {
+				agree = false
+				j.col.note("replica disagreement", "%s\ncascadia %s\nreplica  %s\n%s", firstKind(text), describeNodes(got), describeNodes(replica), describe(text, src))
+			}
+		}
+		if !c.ext {
+			r := resp.Results[i]
+			if r.Error != "" {
+				j.Fail("oracle", "soupsieve rejects the selector: %s\n%s", r.Error, describe(text, src))
+				continue
+			}
+			ss := d.elementLabels(r.M)
+			switch {
+			case soupsieveExtendedLang(g, c.doc):
+				j.col.count("not compared with soupsieve (an extended language range)")
+			case !equalStrings(got, ss):
+				j.Fail("soupsieve", "matches differ: %s\ncascadia  %s\nsoupsieve %s\n%s", firstKind(text), describeNodes(got), describeNodes(ss), describe(text, src))
+				continue
+			case soupsieveCased(g):
+				j.col.count("model not compared with soupsieve (a cased attribute)")
+			case soupsieveEmptyLang(g, c.doc):
+				j.col.count("model not compared with soupsieve (an empty lang)")
+			case !equalStrings(want, ss):
+				j.Fail("model/soupsieve", "the model disagrees with soupsieve: %s\nmodel     %s\nsoupsieve %s\n%s", firstKind(text), describeNodes(want), describeNodes(ss), describe(text, src))
+				continue
+			}
+		}
+		if !equalStrings(got, want) {
+			j.Fail("model", "matches differ from the model: %s\ncascadia %s\nmodel    %s\n%s", firstKind(text), describeNodes(got), describeNodes(want), describe(text, src))
+			continue
+		}
+		// The query APIs against the model: MatchAll walks from the document
+		// node itself, QueryAll and Query from its descendants, Filter and Match
+		// take any node.
+		compiled := cascadia.MustCompile(text)
+		wantAll := d.modelNodes(g, hzKnownNone, true)
+		if ma := d.labels(compiled.MatchAll(doc)); !equalStrings(ma, d.labels(wantAll)) {
+			j.Fail("MatchAll", "MatchAll differs from the model\nMatchAll %s\nmodel    %s\n%s", describeNodes(ma), describeNodes(d.labels(wantAll)), describe(text, src))
+			continue
+		}
+		var wantFirst *html.Node
+		if len(wantAll) > 0 {
+			wantFirst = wantAll[0]
+		}
+		if first := cascadia.Query(doc, sel); first != wantFirst {
+			j.Fail("Query", "Query is not the first match of the model\nQuery %v\nmodel %v\n%s", d.labels(nonNil(first)), d.labels(nonNil(wantFirst)), describe(text, src))
+			continue
+		}
+		if mf := compiled.MatchFirst(doc); mf != wantFirst {
+			j.Fail("MatchFirst", "MatchFirst is not the first match of the model\nMatchFirst %v\nmodel %v\n%s", d.labels(nonNil(mf)), d.labels(nonNil(wantFirst)), describe(text, src))
+			continue
+		}
+		if f := d.labels(cascadia.Filter(d.all[1:], sel)); !equalStrings(f, want) {
+			j.Fail("Filter", "Filter differs from the model\nFilter %s\nmodel  %s\n%s", describeNodes(f), describeNodes(want), describe(text, src))
+			continue
+		}
+		if f := d.labels(compiled.Filter(d.all[1:])); !equalStrings(f, want) {
+			j.Fail("Selector.Filter", "Selector.Filter differs from the model\nFilter %s\nmodel  %s\n%s", describeNodes(f), describeNodes(want), describe(text, src))
+			continue
+		}
+		bad := ""
+		for _, n := range d.all {
+			in := modelGroup(g, n, hzKnownNone)
+			if sel.Match(n) != in || compiled.Match(n) != in {
+				bad = d.label(n)
+				break
+			}
+		}
+		if bad != "" {
+			j.Fail("Match", "Match disagrees with the model on %s\n%s", bad, describe(text, src))
+			continue
+		}
+		j.col.count("ok " + strings.TrimSpace(firstKind(text)))
+	}
+	if j.shape != "" {
+		if agree {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+		}
+	}
+}
+
+func nonNil(n *html.Node) []*html.Node {
+	if n == nil {
+		return nil
+	}
+	return []*html.Node{n}
+}
+
+// --------------------------------------------------------------------------- the properties
+
+// TestHegelSelectorsAgreeWithSoupsieve: standard selector lists over
+// generated documents select the same nodes, in the same order, as soupsieve
+// over BeautifulSoup's parse of the same HTML, and as the model; the model
+// agrees with soupsieve. The cases carry the shapes of the matching bugs at
+// the pools' natural rates (cascadia/1 through :lang, 5, 6, 7, 8, 9, 10, 11,
+// 12 through type, 14), every one named by matchShape before the library is
+// called; under HEGEL_NO_KNOWN=1 none is drawn.
+func TestHegelSelectorsAgreeWithSoupsieve(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, soupsieveCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeMatch(j, c)
+		col.count("cases")
+	})
+}
+
+// TestHegelSelectorsAgreeWithTheModel: every selector list of the full
+// grammar, the extensions included, selects the nodes the model of Selectors
+// Level 4, the HTML pseudo-class definitions and the library's documentation
+// says, and QueryAll, Query, MatchAll, MatchFirst, Filter and Match agree with
+// it (so non-element nodes never match). The cases carry the shapes of the
+// ten matching bugs (cascadia/1 through :lang, :contains and :matches as
+// well); under HEGEL_NO_KNOWN=1 none is drawn.
+func TestHegelSelectorsAgreeWithTheModel(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, modelCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeMatch(j, c)
+		col.count("cases")
+	})
+}
diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..0755e2c
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,136 @@
+package cascadia_test
+
+// soupsieve as a child process: one JSON request per line (an HTML document
+// and selectors), one JSON reply per line (the element tags in document
+// order and, per selector, the matched element indices or an error).
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os/exec"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+const pyScript = `
+import sys, json, warnings
+warnings.simplefilter('ignore')
+import soupsieve as sv
+from bs4 import BeautifulSoup
+sys.stdout.write(json.dumps({'version': sv.__version__}) + '\n')
+sys.stdout.flush()
+for line in sys.stdin:
+    req = json.loads(line)
+    soup = BeautifulSoup(req['html'], 'html.parser')
+    # The html element is detached from the BeautifulSoup document object,
+    # which would otherwise take part in matching as the parent of html.
+    root = soup.html.extract()
+    els = [root] + root.find_all(True)
+    idx = {id(e): i for i, e in enumerate(els)}
+    out = {'tags': [e.name for e in els], 'results': []}
+    for s in req['selectors']:
+        try:
+            m = [0] if sv.match(s, root) else []
+            m += [idx[id(e)] for e in sv.select(s, root)]
+            out['results'].append({'m': m})
+        except Exception as e:
+            out['results'].append({'m': [], 'error': type(e).__name__ + ': ' + str(e).splitlines()[0]})
+    sys.stdout.write(json.dumps(out) + '\n')
+    sys.stdout.flush()
+`
+
+type oracleReq struct {
+	HTML      string   `json:"html"`
+	Selectors []string `json:"selectors"`
+}
+
+type oracleResult struct {
+	M     []int  `json:"m"`
+	Error string `json:"error"`
+}
+
+type oracleResp struct {
+	Tags    []string       `json:"tags"`
+	Results []oracleResult `json:"results"`
+}
+
+var (
+	oracleOnce    sync.Once
+	oracleMu      sync.Mutex
+	oracleIn      io.WriteCloser
+	oracleOut     *bufio.Scanner
+	oracleErr     error
+	oracleVersion string
+)
+
+func startOracle() {
+	cmd := exec.Command("python3", "-c", pyScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		oracleErr = fmt.Errorf("starting python3: %v", err)
+		return
+	}
+	oracleIn = stdin
+	oracleOut = bufio.NewScanner(stdout)
+	oracleOut.Buffer(make([]byte, 1<<20), 64<<20)
+	if !oracleOut.Scan() {
+		_ = cmd.Wait()
+		oracleErr = fmt.Errorf("soupsieve oracle did not start (python3 with soupsieve and beautifulsoup4 needed): %s", stderr.String())
+		return
+	}
+	var v struct {
+		Version string `json:"version"`
+	}
+	if err := json.Unmarshal(oracleOut.Bytes(), &v); err != nil {
+		oracleErr = err
+		return
+	}
+	oracleVersion = v.Version
+}
+
+func oracle(t testing.TB, src string, selectors []string) oracleResp {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("oracle: %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	req, _ := json.Marshal(oracleReq{HTML: src, Selectors: selectors})
+	if _, err := oracleIn.Write(append(req, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	if !oracleOut.Scan() {
+		t.Fatalf("oracle died: %v", oracleOut.Err())
+	}
+	var resp oracleResp
+	if err := json.Unmarshal(oracleOut.Bytes(), &resp); err != nil {
+		t.Fatalf("oracle reply: %v: %s", err, oracleOut.Bytes())
+	}
+	return resp
+}
+
+func TestHegelOracleVersion(t *testing.T) {
+	oracle(t, "<html></html>", []string{"html"})
+	t.Logf("soupsieve %s", oracleVersion)
+	if !strings.HasPrefix(oracleVersion, "2.") {
+		t.Fatalf("soupsieve 2.x expected, got %s", oracleVersion)
+	}
+}
+
+var _ = hegel.Test
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..97b7947
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,193 @@
+package cascadia_test
+
+// Pins: one plain test per recorded bug (bugs.toml), asserting the correct
+// behaviour; each fails while its bug is open.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/andybalholm/cascadia"
+	"golang.org/x/net/html"
+)
+
+func pinDoc(t *testing.T, body string) *html.Node {
+	t.Helper()
+	return mustParse("<!DOCTYPE html><html><head></head><body>" + body + "</body></html>")
+}
+
+func pinSel(t *testing.T, text string) cascadia.Sel {
+	t.Helper()
+	s, err := cascadia.Parse(text)
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", text, err)
+	}
+	return s
+}
+
+// ids lists the id attributes (or tag names) of nodes; non-elements are
+// marked.
+func ids(nodes []*html.Node) []string {
+	var out []string
+	for _, x := range nodes {
+		switch x.Type {
+		case html.ElementNode:
+			if v, ok := attrOf(x, "id"); ok {
+				out = append(out, "#"+v)
+			} else {
+				out = append(out, x.Data)
+			}
+		case html.TextNode:
+			out = append(out, "text("+x.Data+")")
+		case html.CommentNode:
+			out = append(out, "comment")
+		case html.DocumentNode:
+			out = append(out, "document")
+		default:
+			out = append(out, "node")
+		}
+	}
+	return out
+}
+
+func expectIDs(t *testing.T, doc *html.Node, text string, want ...string) {
+	t.Helper()
+	got := ids(cascadia.QueryAll(doc, pinSel(t, text)))
+	if strings.Join(got, " ") != strings.Join(want, " ") {
+		t.Errorf("QueryAll(%q) = %v, want %v", text, got, want)
+	}
+}
+
+// 1: :lang, :contains and :matches match text and comment nodes (and the
+// document node): QueryAll returns them, :has and ~ see them.
+func TestHegelPinPseudoClassesMatchOnlyElements(t *testing.T) {
+	doc := pinDoc(t, `<div id="d" lang="en">text<!--c--><span id="s"></span></div>`)
+	expectIDs(t, doc, ":lang(en)", "#d", "#s")
+	expectIDs(t, doc, `:contains("text")`, "html", "body", "#d")
+	expectIDs(t, doc, ":matches(text)", "html", "body", "#d")
+	expectIDs(t, doc, ":matchesown(^$)", "html", "head", "#s")
+	expectIDs(t, doc, ":has(:lang(fr))")
+	expectIDs(t, doc, ":lang(fr) ~ span")
+	if got := ids(cascadia.MustCompile(":matchesown(^$)").MatchAll(doc)); got[0] == "document" {
+		t.Errorf("MatchAll(:matchesown(^$)) returns the document node: %v", got)
+	}
+}
+
+// 2: String() does not escape quotes and backslashes in attribute values.
+func TestHegelPinStringEscapesAttributeValues(t *testing.T) {
+	for _, text := range []string{`[title="a\"b"]`, `[title="a\\b"]`, `:contains("a\"b")`} {
+		s := pinSel(t, text).String()
+		back, err := cascadia.Parse(s)
+		if err != nil {
+			t.Errorf("Parse(%q).String() = %q, which does not parse: %v", text, s, err)
+			continue
+		}
+		if back.String() != s {
+			t.Errorf("Parse(%q).String() = %q, reparsed String() = %q", text, s, back.String())
+		}
+	}
+	doc := pinDoc(t, `<div id="d" title="a&quot;b"></div>`)
+	s := pinSel(t, `[title="a\"b"]`).String()
+	if back, err := cascadia.Parse(s); err == nil {
+		if got := ids(cascadia.QueryAll(doc, back)); strings.Join(got, " ") != "#d" {
+			t.Errorf("reparsed %q matches %v", s, got)
+		}
+	}
+}
+
+// 3: String() does not escape a leading digit of a class (or id).
+func TestHegelPinStringEscapesLeadingDigits(t *testing.T) {
+	for _, text := range []string{`.\31 x`, `.-\31 x`, `#\31 st`} {
+		s := pinSel(t, text).String()
+		if _, err := cascadia.Parse(s); err != nil {
+			t.Errorf("Parse(%q).String() = %q, which does not parse: %v", text, s, err)
+		}
+	}
+}
+
+// 4: the never-matching pseudo-classes have specificity 0.
+func TestHegelPinNeverMatchingPseudoClassSpecificity(t *testing.T) {
+	for _, text := range []string{":hover", ":visited", ":active", ":focus", ":target"} {
+		if got := pinSel(t, text).Specificity(); got != (cascadia.Specificity{0, 1, 0}) {
+			t.Errorf("Specificity(%q) = %v, want [0 1 0]", text, got)
+		}
+	}
+}
+
+// 5: an option in a disabled optgroup is :enabled, not :disabled.
+func TestHegelPinOptionInDisabledOptgroup(t *testing.T) {
+	doc := pinDoc(t, `<optgroup id="g" disabled><option id="o"></option></optgroup>`)
+	expectIDs(t, doc, ":disabled", "#g", "#o")
+	expectIDs(t, doc, ":enabled")
+	// The converse instance: the fieldset ancestry disables form controls, not
+	// options (HTML, "actually disabled"), but the library applies it to options.
+	doc = pinDoc(t, `<fieldset disabled><select id="s"><option id="o"></option></select></fieldset>`)
+	expectIDs(t, doc, "option:disabled")
+	expectIDs(t, doc, "option:enabled", "#o")
+}
+
+// 6: :has() relative selectors are not anchored at the subject.
+func TestHegelPinHasIsScoped(t *testing.T) {
+	doc := pinDoc(t, `<div id="d"><span id="s"><b id="b"></b></span></div>`)
+	expectIDs(t, doc, "span:has(div b)")
+	expectIDs(t, doc, "div:has(div b)")
+	expectIDs(t, doc, ":has(* *)", "html", "body", "#d")
+	expectIDs(t, doc, "span:has(> div > b)")
+}
+
+// 7: :enabled matches a, area and link elements with an href.
+func TestHegelPinLinksAreNotEnabled(t *testing.T) {
+	doc := pinDoc(t, `<a id="a" href="#"></a><area id="r" href="#"><input id="i">`)
+	expectIDs(t, doc, ":enabled", "#i")
+}
+
+// 8: ^=, $= and *= never match a white-space-only attribute value.
+func TestHegelPinBlankValuesMatchSubstrings(t *testing.T) {
+	doc := pinDoc(t, `<div id="d" title=" "></div>`)
+	expectIDs(t, doc, `[title^=" "]`, "#d")
+	expectIDs(t, doc, `[title$=" "]`, "#d")
+	expectIDs(t, doc, `[title*=" "]`, "#d")
+}
+
+// 9: :lang compares the attribute case-sensitively.
+func TestHegelPinLangIsCaseInsensitive(t *testing.T) {
+	doc := pinDoc(t, `<div id="d" lang="EN"><span id="s" lang="en-US"></span></div>`)
+	expectIDs(t, doc, ":lang(en)", "#d", "#s")
+	expectIDs(t, doc, ":lang(en-us)", "#s")
+}
+
+// 10: :lang looks past an element's own lang attribute to its ancestors.
+func TestHegelPinLangUsesTheNearestAttribute(t *testing.T) {
+	doc := pinDoc(t, `<div id="d" lang="en"><span id="s" lang="fr"></span><em id="e" lang=""></em></div>`)
+	expectIDs(t, doc, ":lang(en)", "#d")
+	expectIDs(t, doc, ":lang(fr)", "#s")
+}
+
+// 11: :empty ignores text of Unicode white space, not just document white
+// space.
+func TestHegelPinEmptyKeepsNonBreakingSpace(t *testing.T) {
+	doc := pinDoc(t, "<p id=\"p\">\u00a0</p><q id=\"q\"> \n\t</q>")
+	expectIDs(t, doc, ":empty", "head", "#q")
+}
+
+// 12: attribute selectors on the HTML attributes whose values are defined
+// as case-insensitive (type, lang, dir, ...) compare case-sensitively.
+func TestHegelPinHTMLAttributeValuesCaseInsensitive(t *testing.T) {
+	doc := pinDoc(t, `<input id="i" type="CHECKBOX"><div id="d" dir="LTR"></div>`)
+	expectIDs(t, doc, `[type=checkbox]`, "#i")
+	expectIDs(t, doc, `[dir="ltr"]`, "#d")
+	expectIDs(t, doc, `[type^=check]`, "#i")
+}
+
+// 13: a zero hex escape yields U+0000 instead of U+FFFD.
+func TestHegelPinZeroEscapeIsReplacementCharacter(t *testing.T) {
+	doc := pinDoc(t, "<div id=\"a\ufffdb\"></div>")
+	expectIDs(t, doc, `#a\0 b`, "#a\ufffdb")
+}
+
+// 14: a fieldset inside a disabled fieldset is :disabled.
+func TestHegelPinNestedFieldsetIsDisabled(t *testing.T) {
+	doc := pinDoc(t, `<fieldset id="f" disabled><fieldset id="g"><input id="i"></fieldset></fieldset>`)
+	expectIDs(t, doc, ":disabled", "#f", "#g", "#i")
+	expectIDs(t, doc, ":enabled")
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..666df09
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,547 @@
+package cascadia_test
+
+// The serialisation, spelling, specificity and pseudo-element properties
+// (TestHegelSerializationRoundTrips, TestHegelParserIgnoresSpelling,
+// TestHegelSpecificityFollowsTheSpec, TestHegelPseudoElements) over the
+// records of hegel_docs_test.go and hegel_selectors_test.go and the pure
+// renderer of hegel_sel_test.go: a case is a document, a selector list of the
+// full grammar and, for the spelling property, drawn styles. The shape of a
+// case (cascadia/2, 3, 4 or 13) is named by a classifier from the records
+// before the library is called (syntaxShape, specificityShape,
+// spellingShape); under HEGEL_NO_KNOWN=1 the shape of 13 is not drawn
+// (zeroEscape) and the selector lists carrying 2, 3 or 4 are filtered out of
+// the generators (hzOnly, counted "filtered shaped"). The narrow properties of
+// hegel_syntax_shapes_test.go share the judges.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/andybalholm/cascadia"
+	"hegel.dev/go/hegel"
+)
+
+func describe(text, src string) string {
+	return fmt.Sprintf("selector %q\ndocument %s", text, src)
+}
+
+// firstKind gives a mismatch a coarse class for triage: the pseudo-classes
+// and attribute operators the selector uses.
+func firstKind(text string) string {
+	var kinds []string
+	for _, p := range []string{":not", ":has", ":haschild", ":nth-", ":first", ":last", ":only", ":empty", ":root", ":link", ":enabled", ":disabled", ":checked", ":lang", ":input", ":contains", ":matches", "~=", "|=", "^=", "$=", "*=", "!=", "#=", " i]", "#", "."} {
+		if strings.Contains(text, p) {
+			kinds = append(kinds, p)
+		}
+	}
+	return strings.Join(kinds, " ")
+}
+
+// judged runs a property over the cases: every drawn case through the judge
+// of its family, which the wide and the narrow properties share.
+func judged[T any](t *testing.T, cases hegel.Generator[T], judge func(*hzCaseJudge, T)) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judge(j, c)
+		col.count("cases")
+	})
+}
+
+// --------------------------------------------------------------------------- the classifiers
+
+// quotedUnescaped: is the simple selector an attribute selector (an operator
+// other than none and #=) or a :contains/:containsOwn whose value holds a
+// double quote or a backslash?
+func quotedUnescaped(s simple) bool {
+	switch {
+	case s.kind == "attr":
+		return s.op != "" && s.op != "#=" && strings.ContainsAny(s.val, "\"\\")
+	case s.kind == "pseudo" && (s.name == "contains" || s.name == "containsown"):
+		return strings.ContainsAny(s.val, "\"\\")
+	}
+	return false
+}
+
+// leadingDigitClass: is the simple selector a class whose name begins with a
+// digit?
+func leadingDigitClass(s simple) bool {
+	return s.kind == "class" && s.name != "" && isDigit([]rune(s.name)[0])
+}
+
+// syntaxShape names the recorded bug the String() round trip of a selector
+// list reaches, from the records alone (verified against the library over
+// every pool value and more, 2026-10-10). cascadia/2: an attribute value (an
+// operator other than none and #=) or a :contains/:containsOwn argument holds
+// a double quote or a backslash - attrSelector.String and
+// containsPseudoClassSelector.String print the value between double quotes
+// unescaped, so a quote ends the string early and the output does not parse
+// (`expected ']'`, `expected ')'`), a trailing backslash escapes the closing
+// quote and the output does not parse (`EOF in string`), and any other
+// backslash is consumed by the reparse as an escape (`\z` is z, `\b` is
+// U+000B, `\ ` a space, `\\` one backslash), so the reparsed value differs and
+// String() is not idempotent. cascadia/3: a class name begins with a digit -
+// escape() leaves it and parseIdentifier requires a name-start character;
+// an id is parsed by parseName, which allows a leading digit, so ids reparse,
+// and a hyphen before the digit is itself escaped by escape() (`.\-1x`), so
+// the note's hyphen-digit instance reparses too. Inside :not and :has as at
+// the top; 2 before 3 in order (the reparse fails on the quote first).
+func syntaxShape(g group) string {
+	if anySimple(g, quotedUnescaped) {
+		return "cascadia/2"
+	}
+	if anySimple(g, leadingDigitClass) {
+		return "cascadia/3"
+	}
+	return ""
+}
+
+func unshapedSyntax(g group) bool { return syntaxShape(g) == "" }
+
+// specificityShape names cascadia/4 where the specificity model with the
+// switch of 4 alone differs from the model with none for some selector of the
+// list: a :hover, :visited, :active, :focus or :target that changes the
+// count - at the top it always does; inside :not or :has the most specific
+// argument may mask it (`:not(:hover, .a)` counts (0,1,0) on both sides,
+// `:not(:hover, div)` does not), which the model run twice decides.
+func specificityShape(g group) string {
+	for _, c := range g {
+		if specComplex(c, hzKnownOnly(kNeverMatchSpecificity)) != specComplex(c, hzKnownNone) {
+			return "cascadia/4"
+		}
+	}
+	return ""
+}
+
+func unshapedSpecificity(g group) bool { return specificityShape(g) == "" }
+
+// --------------------------------------------------------------------------- the selector lists
+
+// The selector lists of the round-trip and specificity properties: the full
+// grammar, the same population as the matching properties' extended one;
+// under HEGEL_NO_KNOWN=1 the lists carrying the shape of 2 or 3 (or of 4) are
+// filtered out, at the rate the old roundTrippable gate rejected (counted
+// "filtered shaped": 8 %, 11 % and 7 % of the draws of the round-trip,
+// specificity and pseudo-element properties at three thousand cases).
+var (
+	syntaxGroups      = hzOnly(hzNoKnown, "shaped", extGroups, unshapedSyntax)
+	syntaxComplexes   = hzOnly(hzNoKnown, "shaped", complexAt(selOpts{ext: true}, 0), func(c complex) bool { return unshapedSyntax(groupOf(c)) })
+	specificityGroups = hzOnly(hzNoKnown, "shaped", extGroups, unshapedSpecificity)
+)
+
+// withSimple: the selector list with the simple selector appended to the
+// compound j of the complex selector i (both taken modulo the counts); the
+// records are copied, not shared.
+func withSimple(g group, s simple, i, j int) group {
+	out := make(group, len(g))
+	copy(out, g)
+	i %= len(out)
+	parts := append([]compound{}, out[i].parts...)
+	j %= len(parts)
+	parts[j].simples = append(append([]simple{}, parts[j].simples...), s)
+	out[i] = complex{parts: parts, combs: out[i].combs}
+	return out
+}
+
+// inserted: a drawn selector list with a drawn simple selector appended to a
+// drawn compound (the narrow properties' constructions, and the identifiers
+// holding U+FFFD of the spelling property).
+func inserted(sels hegel.Generator[group], simples hegel.Generator[simple]) hegel.Generator[group] {
+	return hegel.Composite(func(tc hegel.TestCase) group {
+		g := hegel.Draw(tc, sels)
+		s := hegel.Draw(tc, simples)
+		i := hegel.Draw(tc, hzInts(0, 2))
+		j := hegel.Draw(tc, hzInts(0, 2))
+		return withSimple(g, s, i, j)
+	})
+}
+
+// --------------------------------------------------------------------------- the round trip
+
+// syntaxCase: a selector list over a document (the round-trip property and
+// the narrow properties of cascadia/2 and 3).
+type syntaxCase struct {
+	doc *dnode
+	sel group
+}
+
+func (c syntaxCase) GoString() string { return describe(canonical(c.sel), c.doc.html()) }
+
+func syntaxShapeOf(c syntaxCase) string { return syntaxShape(c.sel) }
+
+func syntaxCasesOf(docs hegel.Generator[*dnode], sels hegel.Generator[group]) hegel.Generator[syntaxCase] {
+	return hegel.FlatMap(docs, func(d *dnode) hegel.Generator[syntaxCase] {
+		return hegel.Map(sels, func(g group) syntaxCase { return syntaxCase{doc: d, sel: g} })
+	})
+}
+
+var syntaxCases = syntaxCasesOf(docs, syntaxGroups)
+
+// judgeRoundTrip judges one case: the shape named; the selector list parsed,
+// its String() parsed again and compared (String() idempotent, the same
+// nodes of the document in the same order, the same number of selectors with
+// the same specificities).
+func judgeRoundTrip(j *hzCaseJudge, c syntaxCase) {
+	j.Shape(syntaxShape(c.sel))
+	src := c.doc.html()
+	doc := mustParse(src)
+	d := nodesOf(doc)
+	text := canonical(c.sel)
+	sel, err := cascadia.ParseGroup(text)
+	if err != nil {
+		j.Fail("parse", "cascadia rejects the selector: %v\n%s", err, describe(text, src))
+		return
+	}
+	s := sel.String()
+	sel2, err := cascadia.ParseGroup(s)
+	if err != nil {
+		j.Fail("reparse", "String() output does not parse: %v\nString %q\n%s", err, s, describe(text, src))
+		return
+	}
+	if s2 := sel2.String(); s2 != s {
+		j.Fail("idempotence", "String() is not idempotent\nfirst  %q\nsecond %q\n%s", s, s2, describe(text, src))
+		return
+	}
+	got, got2 := d.labels(cascadia.QueryAll(doc, sel)), d.labels(cascadia.QueryAll(doc, sel2))
+	if !equalStrings(got, got2) {
+		j.Fail("matches", "String() output matches differently: %s\noriginal %s\nreparsed %s\nString %q\n%s", firstKind(text), describeNodes(got), describeNodes(got2), s, describe(text, src))
+		return
+	}
+	if len(sel) != len(sel2) {
+		j.Fail("count", "String() output has %d selectors, not %d\nString %q\n%s", len(sel2), len(sel), s, describe(text, src))
+		return
+	}
+	for i := range sel {
+		if sel[i].Specificity() != sel2[i].Specificity() {
+			j.Fail("specificity", "String() output has another specificity\noriginal %v\nreparsed %v\nString %q\n%s", sel[i].Specificity(), sel2[i].Specificity(), s, describe(text, src))
+			return
+		}
+	}
+	j.col.count("ok")
+}
+
+// TestHegelSerializationRoundTrips: String() of a parsed selector list parses
+// to an equivalent selector list (same matches, same specificities), and
+// String() is idempotent. The lists carry the shapes of cascadia/2 (a quote
+// or a backslash in an attribute value or :contains argument) and 3 (a class
+// beginning with a digit) at the pools' natural rates, named by syntaxShape
+// before the library is called; under HEGEL_NO_KNOWN=1 they are filtered out.
+func TestHegelSerializationRoundTrips(t *testing.T) { judged(t, syntaxCases, judgeRoundTrip) }
+
+// --------------------------------------------------------------------------- the spellings
+
+// The styles of the spelling property, drawn as records: the old randomStyle's
+// rates (the quote 50/50, a whitespace set 60 % of the time, one of the three
+// sets uniformly, comments 30, upper case 40, escapes 40, bare values 50, the
+// nth aliases 50) and the dice of the renderer's flips; zeroEscape (the shape
+// of cascadia/13) 20 % of the time and never under HEGEL_NO_KNOWN=1. The
+// weights are tuned to the realised rates as hegel_docs_test.go explains
+// (measured over 3000 styles with the probe; the nominal form in brackets).
+var (
+	quotes    = weightedOver([]int{39, 61}, byte('"'), '\'')                                                                 // 50/50 nominal: weights 39/61 realise 49 to 52 double quotes (weights 50/50 realised 56: a weighted choice favours its first alternative)
+	spaceSets = weightedOver([]int{25, 37, 38}, []string{" "}, []string{" ", "\t", "\n", "  "}, []string{"\r\n", "\f", " "}) // uniform: weights 25/37/38 realise 32/33/35 (hzSampled realised 29/39/32, a table favouring its second entry; weights 38/28/34 realised 44/26/30)
+	rawDice   = hzCounted(hzInts(0, 99), 8, 24)
+	offsets   = hzInts(0, 99)
+	styles    = hegel.Composite(func(tc hegel.TestCase) style {
+		var st style
+		st.quote = hegel.Draw(tc, quotes)
+		st.spaces = hegel.Draw(tc, hzMaybe(70, spaceSets))              // 60 nominal: weight 70 realises 60 to 61 (hzMaybe(60) realised 50)
+		st.comments = hegel.Draw(tc, hzCoin(37))                        // 30 nominal: hzCoin(37) realises 30 to 32 (hzCoin(30) realised 27)
+		st.upper = hegel.Draw(tc, hzCoin(48))                           // 40 nominal: hzCoin(48) realises 41 (hzCoin(40) realised 38, hzCoin(44) 36)
+		st.escapes = hegel.Draw(tc, hzCoin(47))                         // 40 nominal: hzCoin(47) realises 39 to 40 (hzCoin(40) realised 36)
+		st.bare = hegel.Draw(tc, hzCoin(62))                            // 50 nominal: hzCoin(62) realises 51 to 52 (hzCoin(50) realised 46, hzCoin(58) 48)
+		st.nthAlias = hegel.Draw(tc, hzCoin(60))                        // 50 nominal: hzCoin(60) realises 50 (hzCoin(50) realised 45)
+		st.zeroEscape = hegel.Draw(tc, hzCoin(hzUnless(hzNoKnown, 24))) // 20 nominal: hzCoin(24) realises 20 to 22 (hzCoin(20) realised 17 to 20)
+		st.dice = evened(hegel.Draw(tc, rawDice), hegel.Draw(tc, offsets))
+		return st
+	})
+)
+
+// evened: the dice shifted by the offset modulo 100. The engine's bounded
+// draw puts a fifth of its mass on the first decile, so raw dice realised the
+// flips at 20, 30, 50, 60 and 70 as 17, 26, 45, 53 and 63; the sum of two
+// such draws is uniform within a point (the evened dice realise 20, 30, 49,
+// 59 and 69 inside the spelling cases), and the zero dice with the zero
+// offset still spell the plain form.
+func evened(raw []int, offset int) []int {
+	out := make([]int, len(raw))
+	for i, d := range raw {
+		out[i] = (d + offset) % 100
+	}
+	return out
+}
+
+// styleCounts: 1-3 variants per case, uniform.
+var styleCounts = evenInts(1, 19, 41, 40) // 1-3 uniform: weights 19/41/40 realise 31/33/36 inside the spelling cases (hzInts realised 30/38/32 at the top level; weights 27/31/42 realised 39/27/33 inside the cases, the first alternative favoured by twelve points there)
+
+// replacementIDs: identifiers holding U+FFFD, the ingredient of cascadia/13
+// (the pools of the matching properties have none: the spelling property
+// compares a variant's parse with the canonical one, and the document side
+// matches nothing on either, so the documents need none).
+var replacementIDs = hzSampled("nul\ufffdx", "\ufffd", "a\ufffd")
+
+// replacementSimples: an id or a class of the replacement identifiers.
+var replacementSimples = hegel.FlatMap(hzSampled("id", "class"), func(kind string) hegel.Generator[simple] {
+	return hegel.Map(replacementIDs, func(name string) simple { return simple{kind: kind, name: name} })
+})
+
+// spellingGroups: the full grammar with, one selector list in ten, an id or
+// class holding U+FFFD appended to a compound.
+var spellingGroups = hzWeighted(hzW(88, extGroups), hzW(12, inserted(extGroups, replacementSimples))) // 10 nominal: weights 88/12 realise 11 to 12 inside the spelling cases (weights 90/10 realised 7 there, 10 at the top level)
+
+// spellingCase: a selector list, a document and the styles of its variants.
+type spellingCase struct {
+	doc    *dnode
+	sel    group
+	styles []style
+}
+
+func (c spellingCase) GoString() string {
+	variants := make([]string, len(c.styles))
+	for i, st := range c.styles {
+		variants[i] = render(c.sel, st)
+	}
+	return fmt.Sprintf("selector %q\nvariants %q\ndocument %s", canonical(c.sel), variants, c.doc.html())
+}
+
+// spellingShape names cascadia/13 where a style spells a U+FFFD of the
+// selector list as the zero hex escape (the renderer asked): the library
+// parses `\0 ` as U+0000, so the variant's String() holds U+0000 where the
+// canonical holds U+FFFD. Nothing is re-parsed from String() here, so 2 and
+// 3 do not act.
+func spellingShape(c spellingCase) string {
+	for _, st := range c.styles {
+		if spelledWithZeroEscape(c.sel, st) {
+			return "cascadia/13"
+		}
+	}
+	return ""
+}
+
+func spellingCasesOf(docs hegel.Generator[*dnode], sels hegel.Generator[group], styles hegel.Generator[[]style]) hegel.Generator[spellingCase] {
+	return hegel.FlatMap(docs, func(d *dnode) hegel.Generator[spellingCase] {
+		return hegel.Composite(func(tc hegel.TestCase) spellingCase {
+			c := spellingCase{doc: d}
+			c.sel = hegel.Draw(tc, sels)
+			c.styles = hegel.Draw(tc, styles)
+			return c
+		})
+	})
+}
+
+var spellingCases = hzOnly(hzNoKnown, "shaped", spellingCasesOf(docs, spellingGroups, countedBy(styles, styleCounts)), func(c spellingCase) bool { return spellingShape(c) == "" })
+
+// judgeSpelling judges one case: the shape named; the canonical spelling
+// parsed and run; every variant parsed and compared with it (the same
+// String(), the same nodes of the document).
+func judgeSpelling(j *hzCaseJudge, c spellingCase) {
+	j.Shape(spellingShape(c))
+	src := c.doc.html()
+	doc := mustParse(src)
+	d := nodesOf(doc)
+	text := canonical(c.sel)
+	sel, err := cascadia.ParseGroup(text)
+	if err != nil {
+		j.Fail("parse", "cascadia rejects the selector: %v\n%s", err, describe(text, src))
+		return
+	}
+	got := d.labels(cascadia.QueryAll(doc, sel))
+	clean := true
+	for _, st := range c.styles {
+		variant := render(c.sel, st)
+		v, err := cascadia.ParseGroup(variant)
+		if err != nil {
+			j.Fail("variant parse", "cascadia rejects a spelling variant: %v\nvariant %q\n%s", err, variant, describe(text, src))
+			clean = false
+			continue
+		}
+		if v.String() != sel.String() {
+			j.Fail("variant String", "a spelling variant parses differently\nvariant  %q\n  gives  %q\ncanonical gives %q\n%s", variant, v.String(), sel.String(), describe(text, src))
+			clean = false
+			continue
+		}
+		if gv := d.labels(cascadia.QueryAll(doc, v)); !equalStrings(gv, got) {
+			j.Fail("variant matches", "a spelling variant matches differently\nvariant %q\nvariant %s\ncanonical %s\n%s", variant, describeNodes(gv), describeNodes(got), describe(text, src))
+			clean = false
+			continue
+		}
+	}
+	if clean {
+		j.col.count("ok")
+	}
+}
+
+// TestHegelParserIgnoresSpelling: the same selector list written with other
+// whitespace, comments, case, quotes, bare values, escapes and nth aliases
+// (1-3 drawn styles) parses to the same selector list (same String(), same
+// matches). The lists carry an identifier holding U+FFFD one time in ten and
+// the styles the zero escape one time in five, the shape of cascadia/13,
+// named by spellingShape before the library is called; under
+// HEGEL_NO_KNOWN=1 the zero escape is not drawn.
+func TestHegelParserIgnoresSpelling(t *testing.T) { judged(t, spellingCases, judgeSpelling) }
+
+// --------------------------------------------------------------------------- the specificity
+
+// specificityCase: a selector list (no document).
+type specificityCase struct {
+	sel group
+}
+
+func (c specificityCase) GoString() string { return fmt.Sprintf("selector %q", canonical(c.sel)) }
+
+func specificityShapeOf(c specificityCase) string { return specificityShape(c.sel) }
+
+func specificityCasesOf(sels hegel.Generator[group]) hegel.Generator[specificityCase] {
+	return hegel.Map(sels, func(g group) specificityCase { return specificityCase{sel: g} })
+}
+
+var specificityCases = specificityCasesOf(specificityGroups)
+
+// judgeSpecificity judges one case: the shape named; the selector list parsed
+// and each selector's Specificity() compared with the model's documented
+// count (hzKnownNone), with no pseudo-element reported.
+func judgeSpecificity(j *hzCaseJudge, c specificityCase) {
+	j.Shape(specificityShape(c.sel))
+	text := canonical(c.sel)
+	sel, err := cascadia.ParseGroup(text)
+	if err != nil {
+		j.Fail("parse", "cascadia rejects the selector: %v\nselector %q", err, text)
+		return
+	}
+	if len(sel) != len(c.sel) {
+		j.Fail("count", "%d selectors parsed, %d written\nselector %q", len(sel), len(c.sel), text)
+		return
+	}
+	for i, cx := range c.sel {
+		one := canonical(group{cx})
+		want := specComplex(cx, hzKnownNone)
+		if got := sel[i].Specificity(); spec(got) != want {
+			j.Fail("specificity", "specificity differs: %s\ncascadia %v\nmodel %v\nselector %q", firstKind(one), got, want, one)
+			return
+		}
+		if sel[i].PseudoElement() != "" {
+			j.Fail("pseudo-element", "a pseudo-element appeared from nowhere: %q\nselector %q", sel[i].PseudoElement(), text)
+			return
+		}
+	}
+	j.col.count("ok")
+}
+
+// TestHegelSpecificityFollowsTheSpec: Specificity() equals the count of the
+// Selectors specification (ids; classes, attributes and pseudo-classes;
+// types; the most specific argument for :not and :has). The lists carry the
+// never-matching pseudo-classes at the table's natural rate, the shape of
+// cascadia/4, named by specificityShape before the library is called; under
+// HEGEL_NO_KNOWN=1 the lists where they change the count are filtered out.
+func TestHegelSpecificityFollowsTheSpec(t *testing.T) { judged(t, specificityCases, judgeSpecificity) }
+
+// --------------------------------------------------------------------------- the pseudo-elements
+
+var pseudoElements = []string{"after", "backdrop", "before", "cue", "first-letter", "first-line", "grammar-error", "marker", "placeholder", "selection", "spelling-error"}
+
+// pseudoElementCase: a complex selector of the full grammar, the
+// pseudo-element appended to its last compound, over a document.
+type pseudoElementCase struct {
+	doc *dnode
+	sel complex
+	pe  string
+}
+
+// withElement: the selector list of the one selector with the pseudo-element
+// on its last compound (the records copied, not shared).
+func (c pseudoElementCase) withElement() group {
+	parts := append([]compound{}, c.sel.parts...)
+	parts[len(parts)-1].pseudoElement = c.pe
+	return groupOf(complex{parts: parts, combs: c.sel.combs})
+}
+
+func (c pseudoElementCase) GoString() string {
+	return describe(canonical(c.withElement()), c.doc.html())
+}
+
+var pseudoElementCases = hegel.FlatMap(docs, func(d *dnode) hegel.Generator[pseudoElementCase] {
+	return hegel.Composite(func(tc hegel.TestCase) pseudoElementCase {
+		c := pseudoElementCase{doc: d}
+		c.sel = hegel.Draw(tc, syntaxComplexes)
+		c.pe = hegel.Draw(tc, hzSampled(pseudoElements...))
+		return c
+	})
+})
+
+// judgePseudoElement judges one case: the shape named (syntaxShape of the
+// selector: its String() round trip reaches 2 and 3 as the round-trip
+// property's does); the pseudo-element refused by Parse and ParseGroup,
+// accepted by ParseWithPseudoElement, reported by PseudoElement(), adding
+// (0,0,1) to the specificity, changing no match, surviving String() (which
+// parses again, idempotent), and ParseGroupWithPseudoElements keeping it on
+// the one selector that has it.
+func judgePseudoElement(j *hzCaseJudge, c pseudoElementCase) {
+	j.Shape(syntaxShape(groupOf(c.sel)))
+	src := c.doc.html()
+	doc := mustParse(src)
+	d := nodesOf(doc)
+	plain := canonical(groupOf(c.sel))
+	text := canonical(c.withElement())
+	if _, err := cascadia.Parse(text); err == nil {
+		j.Fail("Parse", "Parse accepts a pseudo-element\nselector %q", text)
+		return
+	}
+	if _, err := cascadia.ParseGroup(text); err == nil {
+		j.Fail("ParseGroup", "ParseGroup accepts a pseudo-element\nselector %q", text)
+		return
+	}
+	base, err := cascadia.Parse(plain)
+	if err != nil {
+		j.Fail("parse", "cascadia rejects the selector: %v\nselector %q", err, plain)
+		return
+	}
+	sel, err := cascadia.ParseWithPseudoElement(text)
+	if err != nil {
+		j.Fail("ParseWithPseudoElement", "ParseWithPseudoElement rejects the selector: %v\nselector %q", err, text)
+		return
+	}
+	if sel.PseudoElement() != c.pe {
+		j.Fail("PseudoElement", "PseudoElement() is %q, not %q\nselector %q", sel.PseudoElement(), c.pe, text)
+		return
+	}
+	if want := spec(base.Specificity()).add(spec{0, 0, 1}); spec(sel.Specificity()) != want {
+		j.Fail("specificity", "specificity with a pseudo-element is %v, not %v\nselector %q", sel.Specificity(), want, text)
+		return
+	}
+	got := d.labels(cascadia.QueryAll(doc, sel))
+	if want := d.labels(cascadia.QueryAll(doc, base)); !equalStrings(got, want) {
+		j.Fail("matches", "a pseudo-element changes the matches\nwith %s\nwithout %s\n%s", describeNodes(got), describeNodes(want), describe(text, src))
+		return
+	}
+	s := sel.String()
+	sel2, err := cascadia.ParseWithPseudoElement(s)
+	if err != nil {
+		j.Fail("reparse", "String() output does not parse: %v\nString %q\nselector %q", err, s, text)
+		return
+	}
+	if sel2.PseudoElement() != c.pe {
+		j.Fail("round trip", "String() round trip changes the pseudo-element\nString %q\nreparsed %q %q\nselector %q", s, sel2.String(), sel2.PseudoElement(), text)
+		return
+	}
+	if s2 := sel2.String(); s2 != s {
+		j.Fail("idempotence", "String() is not idempotent\nfirst  %q\nsecond %q\nselector %q", s, s2, text)
+		return
+	}
+	g, err := cascadia.ParseGroupWithPseudoElements(text + ", " + plain)
+	if err != nil || len(g) != 2 || g[0].PseudoElement() != c.pe || g[1].PseudoElement() != "" {
+		j.Fail("ParseGroupWithPseudoElements", "ParseGroupWithPseudoElements: %v %v\nselector %q", err, g, text+", "+plain)
+		return
+	}
+	j.col.count("ok")
+}
+
+// TestHegelPseudoElements: a pseudo-element is accepted only by the
+// *WithPseudoElement parsers, reported by PseudoElement(), adds (0,0,1) to
+// the specificity, does not change what matches, and round-trips. The
+// selectors carry the shapes of cascadia/2 and 3 at the pools' natural rates
+// (the String() round trip reaches them), named by syntaxShape before the
+// library is called; under HEGEL_NO_KNOWN=1 they are filtered out.
+func TestHegelPseudoElements(t *testing.T) { judged(t, pseudoElementCases, judgePseudoElement) }
diff --git a/hegel_sel_test.go b/hegel_sel_test.go
new file mode 100644
index 0000000..9113e7a
--- /dev/null
+++ b/hegel_sel_test.go
@@ -0,0 +1,1122 @@
+package cascadia_test
+
+// Selector ASTs (the records hegel_selectors_test.go draws), their rendering
+// (canonical and spelling variants, a pure function of the records and a
+// style record), a model matcher over html.Node following the Selectors
+// specification and the HTML spec's pseudo-class definitions, and a
+// specificity model.
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"sync"
+
+	"golang.org/x/net/html"
+)
+
+type simple struct {
+	kind  string // "id", "class", "attr", "pseudo"
+	name  string // id, class, attribute key or pseudo-class name (lower case)
+	op    string // attribute operator
+	val   string // attribute value, :lang / :contains argument
+	ci    bool   // attribute case flag
+	a, b  int    // nth arguments
+	group group  // :not arguments
+	rels  []relative
+	rx    string     // :matches / #= regular expression
+	node  *html.Node // the :scope element of an anchored relative selector
+}
+
+type compound struct {
+	tag           string // "" for none, "*" for the universal selector
+	simples       []simple
+	pseudoElement string
+}
+
+type complex struct {
+	parts []compound
+	combs []byte // combs[i] joins parts[i] and parts[i+1]
+}
+
+type relative struct {
+	comb byte // 0 for the implicit one
+	sel  complex
+}
+
+type group []complex
+
+var (
+	attrKeys      = []string{"id", "class", "data-x", "title", "lang", "dir", "type", "href", "name", "checked", "disabled"}
+	stdAttrOps    = []string{"", "=", "~=", "|=", "^=", "$=", "*="}
+	extAttrOps    = []string{"!=", "#="}
+	simplePseudos = []string{"first-child", "last-child", "first-of-type", "last-of-type", "only-child", "only-of-type", "empty", "root", "link", "enabled", "disabled", "checked", "hover", "visited", "active", "focus", "target"}
+	extPseudos    = []string{"input"}
+	nthPseudos    = []string{"nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type"}
+	rxPool        = []string{"^a", "b$", "a.c", "[ab]+", "^$", "\\d", "(?i)lorem", "x|y"}
+	selTagPool    = append(append([]string{}, containerTags...), "input", "area", "textarea", "optgroup", "option", "html", "body", "head", "p", "select")
+)
+
+// caseInsensitiveHTMLAttrs are the attributes whose values HTML compares
+// ASCII case-insensitively in attribute selectors.
+var caseInsensitiveHTMLAttrs = map[string]bool{"type": true, "lang": true, "dir": true, "checked": true, "disabled": true, "selected": true, "name": false}
+
+// ---------------------------------------------------------------------------
+// Rendering.
+
+// style is the spelling of a selector list: the choices of the old
+// randomStyle as flags (the whitespace set, comments, upper case, escapes,
+// the quote, bare values, the nth aliases) and every choice the old renderer
+// drew while rendering (whether to put whitespace at an optional slot and
+// which, whether to add a comment and which, whether to upper-case a name or
+// a hex digit, whether to hex-escape a character or escape it literally,
+// whether to write an attribute value bare, which nth spelling to use) as a
+// drawn list of dice cycled over the renderer's coin flips in rendering
+// order, so that render is a pure function of (selector, style). A flip at
+// rate p is die >= 100-p, so the zero dice (the shrink target) spell the plain
+// form of the style, and the canonical style (no flags, no dice) draws
+// nothing at all. zeroEscape is the shape of cascadia/13: every U+FFFD of an
+// identifier or string is written as the zero hex escape `\0 `, which CSS
+// Syntax Level 3 defines as U+FFFD ("consume an escaped code point": a zero
+// hex number yields U+FFFD) and the library parses as U+0000.
+type style struct {
+	spaces     []string // the whitespace set of the optional slots (nil: no optional whitespace)
+	comments   bool     // comments with the whitespace
+	upper      bool     // upper-case tag, attribute and pseudo-class names and hex digits
+	escapes    bool     // hex escapes inside identifiers and strings, literal escapes of some characters that need one
+	quote      byte     // the string quote
+	bare       bool     // attribute values that are identifiers written bare
+	nthAlias   bool     // odd / even / n / -n spellings
+	zeroEscape bool     // U+FFFD written as `\0 ` (cascadia/13)
+	dice       []int    // 0..99, cycled over the renderer's flips in rendering order (nil: every flip false)
+}
+
+var canon = style{quote: '"'}
+
+var commentPool = []string{"/**/", "/* c */", "/* * / */"}
+
+// renderer renders one selector list in one style; the dice are read in
+// rendering order, so the same records give the same text.
+type renderer struct {
+	st   style
+	next int  // the next die
+	zero bool // a zero escape was written (the shape of cascadia/13 reached)
+}
+
+func (r *renderer) die() int {
+	if len(r.st.dice) == 0 {
+		return 0
+	}
+	d := r.st.dice[r.next%len(r.st.dice)]
+	r.next++
+	return d
+}
+
+// flip is true pct percent of the dice (the zero die is false).
+func (r *renderer) flip(pct int) bool { return r.die() >= 100-pct }
+
+// pick is one of the table by the next die (the zero die picks the first).
+func (r *renderer) pick(xs []string) string { return xs[r.die()%len(xs)] }
+
+// render spells the selector list in the style.
+func render(g group, st style) string {
+	text, _ := renderWith(g, st)
+	return text
+}
+
+// renderWith spells the selector list and says whether a zero escape was
+// written: the classifier of cascadia/13 asks it (spelledWithZeroEscape).
+func renderWith(g group, st style) (string, bool) {
+	r := &renderer{st: st}
+	return r.group(g), r.zero
+}
+
+// spelledWithZeroEscape: does the style spell a U+FFFD of the selector list
+// as `\0 ` (the shape of cascadia/13)?
+func spelledWithZeroEscape(g group, st style) bool {
+	_, zero := renderWith(g, st)
+	return zero
+}
+
+// ws returns optional whitespace (and maybe a comment).
+func (r *renderer) ws() string {
+	if r.st.spaces == nil || !r.flip(50) {
+		return ""
+	}
+	s := r.pick(r.st.spaces)
+	if r.st.comments && r.flip(30) {
+		s += r.pick(commentPool) + r.pick(r.st.spaces)
+	}
+	return s
+}
+
+// mandatory returns whitespace where some is required.
+func (r *renderer) mandatory() string {
+	if r.st.spaces == nil {
+		return " "
+	}
+	return r.pick(r.st.spaces)
+}
+
+func (r *renderer) caseOf(s string) string {
+	if r.st.upper && r.flip(60) {
+		return strings.ToUpper(s)
+	}
+	return s
+}
+
+func isNameChar(c rune) bool {
+	return c == '_' || c == '-' || c >= 0x80 || ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z') || ('0' <= c && c <= '9')
+}
+
+func isDigit(c rune) bool { return '0' <= c && c <= '9' }
+
+func isHexDigit(c rune) bool {
+	return isDigit(c) || ('a' <= c && c <= 'f') || ('A' <= c && c <= 'F')
+}
+
+func allHyphens(s string) bool {
+	for _, c := range s {
+		if c != '-' {
+			return false
+		}
+	}
+	return true
+}
+
+// hexEscape is the hex escape of the character, `\0 ` for U+FFFD in the
+// zeroEscape style.
+func (r *renderer) hexEscape(c rune) string {
+	if c == '\ufffd' && r.st.zeroEscape {
+		r.zero = true
+		return "\\0 "
+	}
+	h := fmt.Sprintf("%x", c)
+	if r.st.upper && r.flip(50) {
+		h = strings.ToUpper(h)
+	}
+	return "\\" + h + " "
+}
+
+// ident renders an identifier (a type, class, attribute or pseudo-class
+// name), escaping what must be escaped and, in the escaping style, more;
+// in the zeroEscape style every U+FFFD.
+func (r *renderer) ident(s string) string {
+	var b strings.Builder
+	rs := []rune(s)
+	for i, c := range rs {
+		must := !isNameChar(c) || (isDigit(c) && (i == 0 || (i == 1 && rs[0] == '-'))) || (c == '-' && i == len(rs)-1 && allHyphens(s))
+		switch {
+		case must:
+			if r.st.escapes && r.flip(50) && !isHexDigit(c) && c >= 0x20 && c < 0x80 {
+				b.WriteString("\\" + string(c))
+			} else {
+				b.WriteString(r.hexEscape(c))
+			}
+		case c == '\ufffd' && r.st.zeroEscape:
+			b.WriteString(r.hexEscape(c))
+		case r.st.escapes && r.flip(20):
+			b.WriteString(r.hexEscape(c))
+		default:
+			b.WriteRune(c)
+		}
+	}
+	return b.String()
+}
+
+// str renders a quoted string.
+func (r *renderer) str(s string) string {
+	q := r.st.quote
+	var b strings.Builder
+	b.WriteByte(q)
+	for _, c := range s {
+		switch {
+		case c == rune(q) || c == '\\':
+			if r.st.escapes && r.flip(50) {
+				b.WriteString(r.hexEscape(c))
+			} else {
+				b.WriteByte('\\')
+				b.WriteRune(c)
+			}
+		case c == '\n' || c == '\r' || c == '\f':
+			b.WriteString(r.hexEscape(c))
+		case c == '\ufffd' && r.st.zeroEscape:
+			b.WriteString(r.hexEscape(c))
+		case r.st.escapes && r.flip(20):
+			b.WriteString(r.hexEscape(c))
+		default:
+			b.WriteRune(c)
+		}
+	}
+	b.WriteByte(q)
+	return b.String()
+}
+
+// isIdent reports whether s is a CSS identifier as written.
+func isIdent(s string) bool {
+	rs := []rune(s)
+	if len(rs) == 0 {
+		return false
+	}
+	i := 0
+	if rs[0] == '-' {
+		i = 1
+		if len(rs) == 1 {
+			return false
+		}
+		if rs[1] == '-' {
+			i = 2
+		}
+	}
+	if i < len(rs) && isDigit(rs[i]) {
+		return false
+	}
+	for ; i < len(rs); i++ {
+		if !isNameChar(rs[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (r *renderer) group(g group) string {
+	parts := make([]string, len(g))
+	for i, c := range g {
+		parts[i] = r.complex(c)
+	}
+	return strings.Join(parts, r.ws()+","+r.ws())
+}
+
+func (r *renderer) complex(c complex) string {
+	var b strings.Builder
+	for i, p := range c.parts {
+		if i > 0 {
+			b.WriteString(r.combinator(c.combs[i-1]))
+		}
+		b.WriteString(r.compound(p))
+	}
+	return b.String()
+}
+
+func (r *renderer) combinator(comb byte) string {
+	if comb == ' ' {
+		return r.mandatory() + r.ws()
+	}
+	return r.ws() + string(comb) + r.ws()
+}
+
+func (r *renderer) compound(c compound) string {
+	var b strings.Builder
+	switch c.tag {
+	case "":
+	case "*":
+		b.WriteString("*")
+	default:
+		b.WriteString(r.ident(r.caseOf(c.tag)))
+	}
+	for _, s := range c.simples {
+		b.WriteString(r.simple(s))
+	}
+	if c.pseudoElement != "" {
+		b.WriteString("::" + r.caseOf(c.pseudoElement))
+	}
+	return b.String()
+}
+
+func (r *renderer) simple(s simple) string {
+	switch s.kind {
+	case "id":
+		return "#" + r.ident(s.name)
+	case "class":
+		return "." + r.ident(s.name)
+	case "attr":
+		var b strings.Builder
+		b.WriteString("[" + r.ws() + r.ident(r.caseOf(s.name)))
+		if s.op != "" {
+			b.WriteString(r.ws() + s.op + r.ws())
+			if s.op == "#=" {
+				b.WriteString(s.rx)
+			} else if r.st.bare && isIdent(s.val) && r.flip(70) {
+				b.WriteString(r.ident(s.val))
+			} else {
+				b.WriteString(r.str(s.val))
+			}
+			if s.ci {
+				b.WriteString(r.mandatory() + r.caseOf("i"))
+			}
+		}
+		if s.op != "#=" { // a regular expression runs to the bracket
+			b.WriteString(r.ws())
+		}
+		b.WriteString("]")
+		return b.String()
+	}
+	name := ":" + r.caseOf(s.name)
+	switch s.name {
+	case "not":
+		return name + "(" + r.ws() + r.group(s.group) + r.ws() + ")"
+	case "has", "haschild":
+		parts := make([]string, len(s.rels))
+		for i, rel := range s.rels {
+			if rel.comb != 0 {
+				parts[i] = string(rel.comb) + r.ws() + r.complex(rel.sel)
+			} else {
+				parts[i] = r.complex(rel.sel)
+			}
+		}
+		return name + "(" + r.ws() + strings.Join(parts, r.ws()+","+r.ws()) + r.ws() + ")"
+	case "nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type":
+		return name + "(" + r.ws() + r.nth(s.a, s.b) + r.ws() + ")"
+	case "lang":
+		return name + "(" + r.ws() + r.ident(r.caseOf(s.val)) + r.ws() + ")"
+	case "contains", "containsown":
+		return name + "(" + r.ws() + r.str(s.val) + r.ws() + ")"
+	case "matches", "matchesown":
+		return name + "(" + s.rx + ")"
+	}
+	return name
+}
+
+func (r *renderer) nth(a, b int) string {
+	if r.st.nthAlias {
+		switch {
+		case a == 2 && b == 1 && r.flip(70):
+			return r.caseOf("odd")
+		case a == 2 && b == 0 && r.flip(70):
+			return r.caseOf("even")
+		}
+	}
+	if a == 0 {
+		return fmt.Sprintf("%d", b)
+	}
+	var s string
+	switch {
+	case a == 1 && r.st.nthAlias && r.flip(60):
+		s = r.caseOf("n")
+	case a == -1 && r.st.nthAlias && r.flip(60):
+		s = "-" + r.caseOf("n")
+	default:
+		s = fmt.Sprintf("%d", a) + r.caseOf("n")
+	}
+	if b == 0 && !(r.st.nthAlias && r.flip(30)) {
+		return s
+	}
+	sign := "+"
+	if b < 0 {
+		sign = "-"
+		b = -b
+	}
+	return s + r.ws() + sign + r.ws() + fmt.Sprintf("%d", b)
+}
+
+// canonical renders the selector list in the canonical style: no optional
+// whitespace, lower-case names, double quotes, hex escapes only where an
+// identifier or string needs one; no flag is set and there are no dice, so
+// no flip is reached.
+func canonical(g group) string { return render(g, canon) }
+
+// ---------------------------------------------------------------------------
+// The model matcher: a pure function of (selector, node, known). With every
+// switch off (hzKnownNone) it follows Selectors Level 4, the HTML definitions
+// of the pseudo-classes and of attribute case-sensitivity, and the library's
+// documentation of its extensions, over the element nodes; with a switch on
+// it reproduces the recorded bug's rule as the library has it (the switches
+// are documented in hegel_test.go), so that the model with every switch on
+// is a replica of the library and the classifier matchShape can name the
+// shape of a case from the records alone.
+
+// modelGroup: does n match the selector list?
+func modelGroup(g group, n *html.Node, k known) bool {
+	for _, c := range g {
+		if modelComplex(c, n, k) {
+			return true
+		}
+	}
+	return false
+}
+
+func modelComplex(c complex, n *html.Node, k known) bool {
+	return modelComplexAt(c, len(c.parts)-1, n, k)
+}
+
+func prevElement(el *html.Node) *html.Node {
+	for p := el.PrevSibling; p != nil; p = p.PrevSibling {
+		if p.Type == html.ElementNode {
+			return p
+		}
+	}
+	return nil
+}
+
+func nextElement(el *html.Node) *html.Node {
+	for p := el.NextSibling; p != nil; p = p.NextSibling {
+		if p.Type == html.ElementNode {
+			return p
+		}
+	}
+	return nil
+}
+
+func parentElement(el *html.Node) *html.Node {
+	if el.Parent != nil && el.Parent.Type == html.ElementNode {
+		return el.Parent
+	}
+	return nil
+}
+
+// modelComplexAt: does n match the complex selector up to its compound i (the
+// subject is the last)? With every switch off the walks are over elements: n
+// is an element, the ancestors are the parent elements, the siblings the
+// element siblings. Under kTextNodesMatch the walks are the library's, which
+// test every node: n may be a node of any type, the ancestors are every
+// parent up to the document node (descendantMatch, childMatch), the + walk
+// takes the nearest previous sibling that is not a text or comment node (the
+// doctype before html; siblingMatch adjacent) and the ~ walk every previous
+// sibling (siblingMatch).
+func modelComplexAt(c complex, i int, n *html.Node, k known) bool {
+	if n == nil || (!k[kTextNodesMatch] && n.Type != html.ElementNode) || !modelCompound(c.parts[i], n, k) {
+		return false
+	}
+	if i == 0 {
+		return true
+	}
+	switch c.combs[i-1] {
+	case ' ':
+		for p := ancestorOf(n, k); p != nil; p = ancestorOf(p, k) {
+			if modelComplexAt(c, i-1, p, k) {
+				return true
+			}
+		}
+		return false
+	case '>':
+		return modelComplexAt(c, i-1, ancestorOf(n, k), k)
+	case '+':
+		return modelComplexAt(c, i-1, adjacentOf(n, k), k)
+	case '~':
+		for p := siblingOf(n, k); p != nil; p = siblingOf(p, k) {
+			if modelComplexAt(c, i-1, p, k) {
+				return true
+			}
+		}
+		return false
+	}
+	panic("combinator")
+}
+
+// ancestorOf is the parent element, or under kTextNodesMatch the parent node
+// of any type (the document node included).
+func ancestorOf(n *html.Node, k known) *html.Node {
+	if k[kTextNodesMatch] {
+		return n.Parent
+	}
+	return parentElement(n)
+}
+
+// adjacentOf is the previous element sibling, or under kTextNodesMatch the
+// nearest previous sibling that is not a text or comment node.
+func adjacentOf(n *html.Node, k known) *html.Node {
+	if !k[kTextNodesMatch] {
+		return prevElement(n)
+	}
+	for p := n.PrevSibling; p != nil; p = p.PrevSibling {
+		if p.Type == html.TextNode || p.Type == html.CommentNode {
+			continue
+		}
+		return p
+	}
+	return nil
+}
+
+// siblingOf is the previous element sibling, or under kTextNodesMatch the
+// previous sibling of any type.
+func siblingOf(n *html.Node, k known) *html.Node {
+	if k[kTextNodesMatch] {
+		return n.PrevSibling
+	}
+	return prevElement(n)
+}
+
+// modelCompound: does n match the compound? A non-element node (reached under
+// kTextNodesMatch only) matches no type selector, not even the universal one
+// alone (the library's empty compound tests the node type; the parser drops a
+// universal selector written before other simple selectors, so *:lang(en) is
+// :lang(en) and does test text nodes), and among the simple selectors only
+// :lang and the text pseudo-classes (modelSimple).
+func modelCompound(c compound, n *html.Node, k known) bool {
+	if n.Type != html.ElementNode {
+		if c.tag != "" && (c.tag != "*" || len(c.simples) == 0) {
+			return false
+		}
+	} else if c.tag != "" && c.tag != "*" && n.Data != strings.ToLower(c.tag) {
+		return false
+	}
+	for _, s := range c.simples {
+		if !modelSimple(s, n, k) {
+			return false
+		}
+	}
+	return true
+}
+
+func attrOf(el *html.Node, key string) (string, bool) {
+	for _, a := range el.Attr {
+		if a.Key == key && a.Namespace == "" {
+			return a.Val, true
+		}
+	}
+	return "", false
+}
+
+func hasAttrOf(el *html.Node, key string) bool {
+	_, ok := attrOf(el, key)
+	return ok
+}
+
+func asciiLower(s string) string {
+	var b []byte
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if 'A' <= c && c <= 'Z' {
+			if b == nil {
+				b = []byte(s)
+			}
+			b[i] = c + 32
+		}
+	}
+	if b == nil {
+		return s
+	}
+	return string(b)
+}
+
+const cssSpace = " \t\n\r\f"
+
+// modelAttr follows Selectors Level 4 and HTML's "case-sensitivity of
+// selectors": in an HTML document the values of type, lang, dir, checked,
+// disabled and selected (caseInsensitiveHTMLAttrs) are compared ASCII
+// case-insensitively whatever the flag; under kHTMLAttrsCaseSensitive only
+// with the i flag, as the library has it. The library's regular-expression
+// operator #= tests the raw value. The substring operators ^=, $= and *=
+// match nothing with an empty operand; under kBlankValuesNeverMatch nothing
+// with a value that trims to empty either (attributePrefixMatch and its
+// siblings).
+func modelAttr(s simple, el *html.Node, k known) bool {
+	ci := s.ci || (!k[kHTMLAttrsCaseSensitive] && caseInsensitiveHTMLAttrs[s.name])
+	raw, ok := attrOf(el, s.name)
+	if s.op == "!=" {
+		return !(ok && fold(raw, ci) == fold(s.val, ci))
+	}
+	if !ok {
+		return false
+	}
+	val := fold(s.val, ci)
+	v := fold(raw, ci)
+	blank := k[kBlankValuesNeverMatch] && strings.TrimSpace(raw) == ""
+	switch s.op {
+	case "":
+		return true
+	case "=":
+		return v == val
+	case "~=":
+		if val == "" || strings.ContainsAny(val, cssSpace) {
+			return false
+		}
+		for _, tok := range strings.FieldsFunc(v, func(r rune) bool { return strings.ContainsRune(cssSpace, r) }) {
+			if tok == val {
+				return true
+			}
+		}
+		return false
+	case "|=":
+		return v == val || strings.HasPrefix(v, val+"-")
+	case "^=":
+		return val != "" && !blank && strings.HasPrefix(v, val)
+	case "$=":
+		return val != "" && !blank && strings.HasSuffix(v, val)
+	case "*=":
+		return val != "" && !blank && strings.Contains(v, val)
+	case "#=":
+		return compiledRx(s.rx).MatchString(raw)
+	}
+	panic("attribute operator " + s.op)
+}
+
+// compiledRx compiles the regular expression once (the model runs a selector
+// over every node of a document a dozen times for the classifier).
+func compiledRx(rx string) *regexp.Regexp {
+	rxMu.Lock()
+	defer rxMu.Unlock()
+	if r, ok := rxCache[rx]; ok {
+		return r
+	}
+	r := regexp.MustCompile(rx)
+	rxCache[rx] = r
+	return r
+}
+
+var (
+	rxMu    sync.Mutex
+	rxCache = map[string]*regexp.Regexp{}
+)
+
+func fold(s string, ci bool) string {
+	if ci {
+		return asciiLower(s)
+	}
+	return s
+}
+
+func elementChildren(el *html.Node) []*html.Node {
+	var out []*html.Node
+	for c := el.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.ElementNode {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// position returns the 1-based index of el among its element siblings (of
+// its type when ofType), counted from the end when last, and whether it has
+// a parent element at all.
+func position(el *html.Node, ofType, last bool) (int, bool) {
+	if el.Parent == nil {
+		return 0, false
+	}
+	sibs := elementChildren(el.Parent)
+	idx := 0
+	for _, s := range sibs {
+		if ofType && s.Data != el.Data {
+			continue
+		}
+		idx++
+		if s == el {
+			if !last {
+				return idx, true
+			}
+			count := 0
+			for _, t := range sibs {
+				if !ofType || t.Data == el.Data {
+					count++
+				}
+			}
+			return count - idx + 1, true
+		}
+	}
+	return 0, false
+}
+
+func matchesAnB(a, b, idx int) bool {
+	if a == 0 {
+		return idx == b
+	}
+	d := idx - b
+	return d%a == 0 && d/a >= 0
+}
+
+// textOf is the text of a node as the library's nodeText (own false) and
+// nodeOwnText (own true) read it: the text of an element's descendant (or
+// direct) text nodes; a text node's own data, and nothing as its direct text
+// (it has no children); nothing for a comment, a doctype or the document node
+// (writeNodeText writes text and element nodes only). Only elements are
+// asked with every switch off; under kTextNodesMatch every node is.
+func textOf(n *html.Node, own bool) string {
+	switch n.Type {
+	case html.TextNode:
+		if own {
+			return ""
+		}
+		return n.Data
+	case html.ElementNode:
+	default:
+		return ""
+	}
+	var b strings.Builder
+	var walk func(*html.Node)
+	walk = func(x *html.Node) {
+		for c := x.FirstChild; c != nil; c = c.NextSibling {
+			if c.Type == html.TextNode {
+				b.WriteString(c.Data)
+			} else if c.Type == html.ElementNode && !own {
+				walk(c)
+			}
+		}
+	}
+	walk(n)
+	return b.String()
+}
+
+// langMatch is :lang(arg) on n (the argument lower-cased by the parser): the
+// language of an element is given by its nearest lang attribute (HTML, "the
+// lang and xml:lang attributes"), compared ASCII case-insensitively as the
+// tag itself or a prefix of it at a hyphen (Selectors: "the comparison is
+// performed case-insensitively"; the library's own prefix rule). Under
+// kLangCaseSensitive the attribute is compared raw (langPseudoClassSelector
+// compares the lower-cased argument with the raw value); under
+// kLangInheritsThroughOwn a non-matching own attribute is climbed past (own
+// || s.Match(n.Parent)); under kTextNodesMatch a non-element node, which has
+// no attribute, climbs to its parent like any other (the library tests no node
+// type). The document node has no parent and no attribute.
+func langMatch(n *html.Node, arg string, k known) bool {
+	if v, ok := attrOf(n, "lang"); ok {
+		if !k[kLangCaseSensitive] {
+			v = asciiLower(v)
+		}
+		if v == arg || strings.HasPrefix(v, arg+"-") {
+			return true
+		}
+		if !k[kLangInheritsThroughOwn] {
+			return false
+		}
+	}
+	if n.Parent == nil {
+		return false
+	}
+	return langMatch(n.Parent, arg, k)
+}
+
+func isFormControl(tag string) bool {
+	switch tag {
+	case "button", "input", "select", "textarea", "fieldset":
+		return true
+	}
+	return false
+}
+
+// actuallyDisabled follows the HTML specification ("actually disabled"): a
+// button, input, select or textarea with the disabled attribute or inside a
+// disabled fieldset outside that fieldset's first legend; a fieldset with the
+// attribute or so inside another fieldset (under kNestedFieldsetEnabled the
+// attribute alone, as the library has it); an optgroup with the attribute; an
+// option with the attribute or whose parent is a disabled optgroup (under
+// kOptionIgnoresOptgroup the library's rule instead: the attribute or the
+// disabled-fieldset ancestry, which the specification does not apply to
+// options - enabledPseudoClassSelector and disabledPseudoClassSelector treat
+// an option like an input).
+func actuallyDisabled(el *html.Node, k known) bool {
+	switch el.Data {
+	case "button", "input", "select", "textarea", "fieldset", "optgroup", "option":
+	default:
+		return false
+	}
+	if hasAttrOf(el, "disabled") {
+		return true
+	}
+	switch el.Data {
+	case "optgroup":
+		return false
+	case "option":
+		if k[kOptionIgnoresOptgroup] {
+			return inDisabledFieldset(el)
+		}
+		p := parentElement(el)
+		return p != nil && p.Data == "optgroup" && hasAttrOf(p, "disabled")
+	case "fieldset":
+		if k[kNestedFieldsetEnabled] {
+			return false
+		}
+	}
+	return inDisabledFieldset(el)
+}
+
+// inDisabledFieldset: is el a descendant of a disabled fieldset, outside that
+// fieldset's first legend child?
+func inDisabledFieldset(el *html.Node) bool {
+	child := el
+	for p := parentElement(el); p != nil; child, p = p, parentElement(p) {
+		if p.Data == "fieldset" && hasAttrOf(p, "disabled") {
+			inFirstLegend := false
+			for _, c := range elementChildren(p) {
+				if c.Data == "legend" {
+					inFirstLegend = c == child
+					break
+				}
+			}
+			if !inFirstLegend {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// isTextPseudo: is the simple selector one of those the library tests on any
+// node (cascadia/1): :lang, :contains, :containsOwn, :matches, :matchesOwn?
+func isTextPseudo(s simple) bool {
+	if s.kind != "pseudo" {
+		return false
+	}
+	switch s.name {
+	case "lang", "contains", "containsown", "matches", "matchesown":
+		return true
+	}
+	return false
+}
+
+// modelSimple: does the node match the simple selector? A non-element node
+// (reached under kTextNodesMatch only) matches only :lang and the text
+// pseudo-classes, as the library has it: every other selector tests the node
+// type.
+func modelSimple(s simple, el *html.Node, k known) bool {
+	if el.Type != html.ElementNode && !isTextPseudo(s) {
+		return false
+	}
+	switch s.kind {
+	case "scope":
+		return el == s.node
+	case "id":
+		v, ok := attrOf(el, "id")
+		return ok && v == s.name
+	case "class":
+		return modelAttr(simple{name: "class", op: "~=", val: s.name}, el, k)
+	case "attr":
+		return modelAttr(s, el, k)
+	}
+	switch s.name {
+	case "not":
+		return !modelGroup(s.group, el, k)
+	case "has", "haschild":
+		for _, rel := range s.rels {
+			comb := rel.comb
+			if comb == 0 {
+				comb = ' '
+				if s.name == "haschild" {
+					comb = '>'
+				}
+			}
+			if modelRelative(comb, rel.sel, el, k) {
+				return true
+			}
+		}
+		return false
+	case "nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type":
+		idx, ok := position(el, strings.Contains(s.name, "of-type"), strings.Contains(s.name, "last"))
+		return ok && matchesAnB(s.a, s.b, idx)
+	case "first-child", "first-of-type":
+		idx, ok := position(el, s.name == "first-of-type", false)
+		return ok && idx == 1
+	case "last-child", "last-of-type":
+		idx, ok := position(el, s.name == "last-of-type", true)
+		return ok && idx == 1
+	case "only-child", "only-of-type":
+		i1, ok := position(el, s.name == "only-of-type", false)
+		i2, _ := position(el, s.name == "only-of-type", true)
+		return ok && i1 == 1 && i2 == 1
+	case "empty":
+		// Selectors Level 4 lets :empty ignore document white space only
+		// (space, tab, line feed, carriage return, form feed); under
+		// kEmptyTrimsUnicodeSpace all Unicode white space, as strings.TrimSpace
+		// does in the library.
+		for c := el.FirstChild; c != nil; c = c.NextSibling {
+			if c.Type == html.ElementNode {
+				return false
+			}
+			if c.Type == html.TextNode {
+				text := strings.Trim(c.Data, cssSpace)
+				if k[kEmptyTrimsUnicodeSpace] {
+					text = strings.TrimSpace(c.Data)
+				}
+				if text != "" {
+					return false
+				}
+			}
+		}
+		return true
+	case "root":
+		return el.Parent != nil && el.Parent.Type == html.DocumentNode
+	case "link":
+		return (el.Data == "a" || el.Data == "area") && hasAttrOf(el, "href")
+	case "enabled":
+		// HTML: button, input, select, textarea, optgroup, option and fieldset
+		// elements that are not actually disabled; under kLinksAreEnabled the
+		// library's a, area and link elements with an href as well.
+		switch el.Data {
+		case "button", "input", "select", "textarea", "fieldset", "optgroup", "option":
+			return !actuallyDisabled(el, k)
+		case "a", "area", "link":
+			return k[kLinksAreEnabled] && hasAttrOf(el, "href")
+		}
+		return false
+	case "disabled":
+		return actuallyDisabled(el, k)
+	case "checked":
+		switch el.Data {
+		case "input":
+			t, _ := attrOf(el, "type")
+			t = asciiLower(t)
+			return hasAttrOf(el, "checked") && (t == "checkbox" || t == "radio")
+		case "option":
+			return hasAttrOf(el, "selected")
+		}
+		return false
+	case "lang":
+		return langMatch(el, s.val, k)
+	case "input":
+		return el.Data == "input" || el.Data == "select" || el.Data == "textarea" || el.Data == "button"
+	case "contains", "containsown":
+		return strings.Contains(strings.ToLower(textOf(el, s.name == "containsown")), strings.ToLower(s.val))
+	case "matches", "matchesown":
+		return compiledRx(s.rx).MatchString(textOf(el, s.name == "matchesown"))
+	case "hover", "visited", "active", "focus", "target":
+		return false
+	}
+	panic("pseudo-class " + s.name)
+}
+
+// descendantsOf lists the descendant elements of n in document order, or
+// with all every descendant node (a non-element node has no children).
+func descendantsOf(n *html.Node, all bool) []*html.Node {
+	var out []*html.Node
+	var walk func(*html.Node)
+	walk = func(x *html.Node) {
+		for c := x.FirstChild; c != nil; c = c.NextSibling {
+			if c.Type == html.ElementNode || all {
+				out = append(out, c)
+			}
+			if c.Type == html.ElementNode {
+				walk(c)
+			}
+		}
+	}
+	walk(n)
+	return out
+}
+
+// childrenOf lists the child elements of n, or with all every child node.
+func childrenOf(n *html.Node, all bool) []*html.Node {
+	var out []*html.Node
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.ElementNode || all {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// modelRelative anchors the relative selector at el (the :scope, Selectors
+// Level 4) and looks for an element matching it: the anchored complex
+// selector is the scope compound, the combinator and sel, tested on the
+// descendants of el (the descendant and child combinators) or on the
+// following element siblings and their descendants (+ and ~). Under
+// kHasUnscoped it is the library's relativeMatch instead: every descendant
+// (:has, the descendant combinator) or child (:haschild, >) of el, the first
+// following element sibling (+) or every one (~), tested against the whole
+// complex selector with no bound on where its earlier compounds are found;
+// under kTextNodesMatch the descendants and children tested include the
+// non-element nodes (hasDescendantMatch and hasChildMatch test every child).
+func modelRelative(comb byte, sel complex, el *html.Node, k known) bool {
+	all := k[kTextNodesMatch]
+	var candidates []*html.Node
+	switch {
+	case comb == ' ' || (comb == '>' && !k[kHasUnscoped]):
+		candidates = descendantsOf(el, all)
+	case comb == '>':
+		candidates = childrenOf(el, all)
+	case comb == '+' && k[kHasUnscoped]:
+		if nx := nextElement(el); nx != nil {
+			candidates = []*html.Node{nx}
+		}
+	case comb == '~' && k[kHasUnscoped]:
+		for nx := nextElement(el); nx != nil; nx = nextElement(nx) {
+			candidates = append(candidates, nx)
+		}
+	case comb == '+' || comb == '~':
+		for nx := nextElement(el); nx != nil; nx = nextElement(nx) {
+			candidates = append(append(candidates, nx), descendantsOf(nx, all)...)
+		}
+	default:
+		panic("relative combinator")
+	}
+	if k[kHasUnscoped] {
+		for _, c := range candidates {
+			if modelComplex(sel, c, k) {
+				return true
+			}
+		}
+		return false
+	}
+	anchored := complex{
+		parts: append([]compound{{simples: []simple{{kind: "scope", node: el}}}}, sel.parts...),
+		combs: append([]byte{comb}, sel.combs...),
+	}
+	for _, c := range candidates {
+		if modelComplex(anchored, c, k) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Specificity.
+
+type spec [3]int
+
+func (s spec) add(o spec) spec { return spec{s[0] + o[0], s[1] + o[1], s[2] + o[2]} }
+
+func (s spec) less(o spec) bool {
+	for i := range s {
+		if s[i] != o[i] {
+			return s[i] < o[i]
+		}
+	}
+	return false
+}
+
+// specComplex is the specificity of the selector per the Selectors
+// specification; under kNeverMatchSpecificity the never-matching
+// pseudo-classes count nothing, as the library has it (cascadia/4, the
+// subject of part 2 of the rewrite).
+func specComplex(c complex, k known) spec {
+	var out spec
+	for _, p := range c.parts {
+		out = out.add(specCompound(p, k))
+	}
+	return out
+}
+
+func specCompound(c compound, k known) spec {
+	var out spec
+	if c.tag != "" && c.tag != "*" {
+		out = out.add(spec{0, 0, 1})
+	}
+	for _, s := range c.simples {
+		out = out.add(specSimple(s, k))
+	}
+	if c.pseudoElement != "" {
+		out = out.add(spec{0, 0, 1})
+	}
+	return out
+}
+
+func specSimple(s simple, k known) spec {
+	switch s.kind {
+	case "id":
+		return spec{1, 0, 0}
+	case "class", "attr":
+		return spec{0, 1, 0}
+	}
+	switch s.name {
+	case "not":
+		var max spec
+		for _, c := range s.group {
+			if sp := specComplex(c, k); max.less(sp) {
+				max = sp
+			}
+		}
+		return max
+	case "has", "haschild":
+		var max spec
+		for _, r := range s.rels {
+			if sp := specComplex(r.sel, k); max.less(sp) {
+				max = sp
+			}
+		}
+		return max
+	case "hover", "visited", "active", "focus", "target":
+		if k[kNeverMatchSpecificity] {
+			return spec{}
+		}
+	}
+	return spec{0, 1, 0}
+}
