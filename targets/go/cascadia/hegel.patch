new file mode 100644
index 0000000..376d6d8
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,138 @@
+package cascadia_test
+
+// Hegel properties for github.com/andybalholm/cascadia: CSS selectors over
+// generated HTML documents against soupsieve (the Python CSS selector
+// engine, as a child process) and against a plain model of the Selectors
+// specification, plus library-internal identities (serialisation round
+// trips, spelling variants, specificity, pseudo-elements, the query APIs).
+//
+// Needs python3 with the `soupsieve` and `beautifulsoup4` packages on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 400 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	langCaseSensitive      bool // :lang compares the attribute case-sensitively
+	langInheritsThroughOwn bool // :lang looks past an element's own lang attribute to its ancestors
+	emptyTrimsUnicodeSpace bool // :empty ignores text of Unicode (not just CSS) white space
+	htmlAttrsCaseSensitive bool // [type=...] and the other HTML case-insensitive attributes compared case-sensitively
+	textNodesMatch         bool // :lang, :contains, :matches match text and comment nodes
+	stringUnescaped        bool // String() does not escape quotes and backslashes in attribute values
+	leadingDigitUnescaped  bool // String() does not escape a leading digit of a class or id
+	neverMatchSpecificity  bool // :hover and the other never-matching pseudo-classes have specificity 0
+	optionIgnoresOptgroup  bool // an option in a disabled optgroup is :enabled
+	hasUnscoped            bool // :has(a b) is not anchored at the subject: the a may be above it
+	linksAreEnabled        bool // :enabled matches a, area and link elements with an href
+	blankValuesNeverMatch  bool // ^=, $= and *= never match a white-space-only attribute value
+	nestedFieldsetEnabled  bool // a fieldset inside a disabled fieldset is :enabled
+}{
+	nestedFieldsetEnabled:  true,
+	blankValuesNeverMatch:  true,
+	hasUnscoped:            true,
+	linksAreEnabled:        true,
+	langCaseSensitive:      true,
+	langInheritsThroughOwn: true,
+	emptyTrimsUnicodeSpace: true,
+	htmlAttrsCaseSensitive: true,
+	textNodesMatch:         true,
+	stringUnescaped:        true,
+	leadingDigitUnescaped:  true,
+	neverMatchSpecificity:  true,
+	optionIgnoresOptgroup:  true,
+}
