diff --git a/hegel_doc_test.go b/hegel_doc_test.go
new file mode 100644
index 0000000..5ff2d79
--- /dev/null
+++ b/hegel_doc_test.go
@@ -0,0 +1,313 @@
+package cascadia_test
+
+// Generated HTML documents: a tree of elements whose parsing is the same in
+// every HTML parser (no auto-closing tags, no entity edge cases, no nested a
+// or button, options only inside optgroups), with attributes chosen to
+// exercise attribute selectors, :lang, :checked, :enabled and :disabled.
+
+import (
+	"strings"
+
+	"golang.org/x/net/html"
+	"hegel.dev/go/hegel"
+)
+
+type dnode struct {
+	kind  int // 0 element, 1 text, 2 comment
+	tag   string
+	attrs [][2]string
+	text  string
+	kids  []*dnode
+}
+
+var (
+	containerTags = []string{"div", "span", "section", "article", "aside", "nav", "header", "footer", "main", "em", "strong", "b", "i", "u", "s", "small", "code", "sub", "sup", "label", "fieldset", "legend", "blockquote", "figure", "mark", "abbr", "x-widget", "a", "button"}
+	idPool        = []string{"a1", "b-2", "C", "x y", "1st", "-x", "q.r", "s:t", "u\"v", "w\\z", "d_e", "Zed", "-", "--f", "g#h", "i[j]", "k'l", "m,n", "o>p", "nbsp\u00a0q", "café", "a1"}
+	classPool     = []string{"a", "b", "c", "A", "a-b", "x_y", "1x", "d.e", "f:g", "-h", "_i", "j\"k", "l\\m", "café", "n-", "--o", "a"}
+	valuePool     = []string{"", " ", "a", "ab", "a b", "a-b", "A", "abc", "  a  ", "b\ta", "\"", "\\", "-a", "a-", "x\u00a0y", "'", "ab-cd", "a  b"}
+	langPool      = []string{"en", "en-US", "EN", "fr", "fr-CA", "de", "", "en-", "en-Latn-US", "e"}
+	dirPool       = []string{"ltr", "rtl", "LTR", "auto"}
+	typePool      = []string{"text", "checkbox", "radio", "submit", "Checkbox", "RADIO", "password", "email"}
+	wordPool      = []string{"lorem", "Ipsum", "dolor", "SIT", "amet", "a", "42", "x.y", "a,b", "c-d", "q'r", "Lorem"}
+	spacePool     = []string{" ", "\n", "\t ", "  ", "\n\t"}
+)
+
+type docCtx struct {
+	inA, inButton, inLang bool
+}
+
+// genDoc generates a document; the body's children are returned as the tree
+// under a synthetic html element (with an optional lang attribute).
+func genDoc(tc hegel.TestCase) *dnode {
+	root := &dnode{tag: "html"}
+	var ctx docCtx
+	if chance(tc, 25) {
+		root.attrs = append(root.attrs, [2]string{"lang", genLang(tc)})
+		ctx.inLang = true
+	}
+	body := &dnode{tag: "body"}
+	if chance(tc, 30) {
+		body.attrs = genAttrs(tc, "body", &ctx)
+	}
+	count := n(tc, 1, 5)
+	for i := 0; i < count; i++ {
+		body.kids = append(body.kids, genKid(tc, n(tc, 0, 3), ctx))
+	}
+	root.kids = []*dnode{{tag: "head"}, body}
+	return root
+}
+
+func genLang(tc hegel.TestCase) string {
+	l := pick(tc, langPool...)
+	if Known.langCaseSensitive {
+		l = strings.ToLower(l)
+	}
+	return l
+}
+
+func genText(tc hegel.TestCase) string {
+	k := n(tc, 1, 3)
+	var parts []string
+	for i := 0; i < k; i++ {
+		parts = append(parts, pick(tc, wordPool...))
+	}
+	sep := pick(tc, " ", "  ", "\n")
+	return strings.Join(parts, sep)
+}
+
+func genKid(tc hegel.TestCase, depth int, ctx docCtx) *dnode {
+	switch r := n(tc, 1, 100); {
+	case r <= 55:
+		return genElement(tc, depth, ctx)
+	case r <= 85:
+		return &dnode{kind: 1, text: genText(tc)}
+	case r <= 92:
+		return &dnode{kind: 2, text: pick(tc, "c", " note ", "")}
+	case r <= 96 || Known.emptyTrimsUnicodeSpace:
+		return &dnode{kind: 1, text: pick(tc, spacePool...)}
+	default:
+		return &dnode{kind: 1, text: pick(tc, "\u00a0", " \u00a0", "\u2003")}
+	}
+}
+
+func genElement(tc hegel.TestCase, depth int, ctx docCtx) *dnode {
+	var tag string
+	switch r := n(tc, 1, 100); {
+	case r <= 12:
+		tag = "input"
+	case r <= 16:
+		tag = "area"
+	case r <= 22:
+		tag = "textarea"
+	case r <= 28:
+		tag = "optgroup"
+	case r <= 32:
+		tag = "option"
+	default:
+		tag = pick(tc, containerTags...)
+		if (tag == "a" && ctx.inA) || (tag == "button" && ctx.inButton) {
+			tag = "span"
+		}
+	}
+	e := &dnode{tag: tag}
+	e.attrs = genAttrs(tc, tag, &ctx)
+	switch tag {
+	case "input", "area":
+		// void
+	case "textarea", "option":
+		if chance(tc, 60) {
+			e.kids = append(e.kids, &dnode{kind: 1, text: genText(tc)})
+		}
+	case "optgroup":
+		k := n(tc, 0, 3)
+		for i := 0; i < k; i++ {
+			o := &dnode{tag: "option"}
+			o.attrs = genAttrs(tc, "option", &ctx)
+			if chance(tc, 50) {
+				o.kids = append(o.kids, &dnode{kind: 1, text: genText(tc)})
+			}
+			e.kids = append(e.kids, o)
+		}
+	default:
+		if tag == "a" {
+			ctx.inA = true
+		}
+		if tag == "button" {
+			ctx.inButton = true
+		}
+		if depth > 0 {
+			k := n(tc, 0, 4)
+			for i := 0; i < k; i++ {
+				e.kids = append(e.kids, genKid(tc, depth-1, ctx))
+			}
+		} else if chance(tc, 40) {
+			e.kids = append(e.kids, &dnode{kind: 1, text: genText(tc)})
+		}
+	}
+	return e
+}
+
+func genAttrs(tc hegel.TestCase, tag string, ctx *docCtx) [][2]string {
+	var attrs [][2]string
+	add := func(k, v string) { attrs = append(attrs, [2]string{k, v}) }
+	if chance(tc, 40) {
+		add("id", pick(tc, idPool...))
+	}
+	if chance(tc, 50) {
+		k := n(tc, 0, 3)
+		var cls []string
+		for i := 0; i < k; i++ {
+			cls = append(cls, pick(tc, classPool...))
+		}
+		add("class", strings.Join(cls, pick(tc, " ", "  ", "\t", "\n")))
+	}
+	if chance(tc, 30) {
+		add("data-x", pick(tc, valuePool...))
+	}
+	if chance(tc, 15) {
+		add("title", pick(tc, valuePool...))
+	}
+	if chance(tc, 20) && (!ctx.inLang || !Known.langInheritsThroughOwn) {
+		add("lang", genLang(tc))
+		ctx.inLang = true
+	}
+	if chance(tc, 10) {
+		add("dir", pick(tc, dirPool...))
+	}
+	switch tag {
+	case "a", "area":
+		if chance(tc, 60) {
+			add("href", pick(tc, "#", "x.html", "", "https://example.com/"))
+		}
+	case "input":
+		if chance(tc, 80) {
+			add("type", pick(tc, typePool...))
+		}
+		if chance(tc, 40) {
+			add("checked", pick(tc, "", "checked"))
+		}
+	case "option":
+		if chance(tc, 40) {
+			add("selected", pick(tc, "", "selected"))
+		}
+	}
+	switch tag {
+	case "input", "button", "textarea", "fieldset", "optgroup", "option", "select":
+		if chance(tc, 30) && !(tag == "optgroup" && Known.optionIgnoresOptgroup) {
+			add("disabled", pick(tc, "", "disabled"))
+		}
+	}
+	if chance(tc, 10) {
+		add("name", pick(tc, "q", "Q", "user-name"))
+	}
+	return attrs
+}
+
+// html serialises the document.
+func (d *dnode) html() string {
+	var b strings.Builder
+	b.WriteString("<!DOCTYPE html>")
+	d.write(&b)
+	return b.String()
+}
+
+func (d *dnode) write(b *strings.Builder) {
+	switch d.kind {
+	case 1:
+		b.WriteString(d.text)
+		return
+	case 2:
+		b.WriteString("<!--" + d.text + "-->")
+		return
+	}
+	b.WriteByte('<')
+	b.WriteString(d.tag)
+	for _, a := range d.attrs {
+		b.WriteByte(' ')
+		b.WriteString(a[0])
+		b.WriteString(`="`)
+		b.WriteString(strings.ReplaceAll(a[1], `"`, "&quot;"))
+		b.WriteByte('"')
+	}
+	b.WriteByte('>')
+	if d.tag == "input" || d.tag == "area" {
+		return
+	}
+	for _, k := range d.kids {
+		k.write(b)
+	}
+	b.WriteString("</" + d.tag + ">")
+}
+
+func mustParse(src string) *html.Node {
+	doc, err := html.Parse(strings.NewReader(src))
+	if err != nil {
+		panic(err)
+	}
+	return doc
+}
+
+// elements lists the element nodes of a document in document order.
+func elements(doc *html.Node) []*html.Node {
+	var out []*html.Node
+	var walk func(*html.Node)
+	walk = func(x *html.Node) {
+		for c := x.FirstChild; c != nil; c = c.NextSibling {
+			if c.Type == html.ElementNode {
+				out = append(out, c)
+			}
+			walk(c)
+		}
+	}
+	walk(doc)
+	return out
+}
+
+func tagsOf(els []*html.Node) []string {
+	out := make([]string, len(els))
+	for i, e := range els {
+		out[i] = e.Data
+	}
+	return out
+}
+
+// indices maps matched nodes to their positions in the element list.
+func indices(els []*html.Node, nodes []*html.Node) []int {
+	pos := make(map[*html.Node]int, len(els))
+	for i, e := range els {
+		pos[e] = i
+	}
+	out := []int{}
+	for _, x := range nodes {
+		if i, ok := pos[x]; ok {
+			out = append(out, i)
+		} else {
+			out = append(out, -1)
+		}
+	}
+	return out
+}
+
+func equalInts(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..0755e2c
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,136 @@
+package cascadia_test
+
+// soupsieve as a child process: one JSON request per line (an HTML document
+// and selectors), one JSON reply per line (the element tags in document
+// order and, per selector, the matched element indices or an error).
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os/exec"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+const pyScript = `
+import sys, json, warnings
+warnings.simplefilter('ignore')
+import soupsieve as sv
+from bs4 import BeautifulSoup
+sys.stdout.write(json.dumps({'version': sv.__version__}) + '\n')
+sys.stdout.flush()
+for line in sys.stdin:
+    req = json.loads(line)
+    soup = BeautifulSoup(req['html'], 'html.parser')
+    # The html element is detached from the BeautifulSoup document object,
+    # which would otherwise take part in matching as the parent of html.
+    root = soup.html.extract()
+    els = [root] + root.find_all(True)
+    idx = {id(e): i for i, e in enumerate(els)}
+    out = {'tags': [e.name for e in els], 'results': []}
+    for s in req['selectors']:
+        try:
+            m = [0] if sv.match(s, root) else []
+            m += [idx[id(e)] for e in sv.select(s, root)]
+            out['results'].append({'m': m})
+        except Exception as e:
+            out['results'].append({'m': [], 'error': type(e).__name__ + ': ' + str(e).splitlines()[0]})
+    sys.stdout.write(json.dumps(out) + '\n')
+    sys.stdout.flush()
+`
+
+type oracleReq struct {
+	HTML      string   `json:"html"`
+	Selectors []string `json:"selectors"`
+}
+
+type oracleResult struct {
+	M     []int  `json:"m"`
+	Error string `json:"error"`
+}
+
+type oracleResp struct {
+	Tags    []string       `json:"tags"`
+	Results []oracleResult `json:"results"`
+}
+
+var (
+	oracleOnce    sync.Once
+	oracleMu      sync.Mutex
+	oracleIn      io.WriteCloser
+	oracleOut     *bufio.Scanner
+	oracleErr     error
+	oracleVersion string
+)
+
+func startOracle() {
+	cmd := exec.Command("python3", "-c", pyScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		oracleErr = fmt.Errorf("starting python3: %v", err)
+		return
+	}
+	oracleIn = stdin
+	oracleOut = bufio.NewScanner(stdout)
+	oracleOut.Buffer(make([]byte, 1<<20), 64<<20)
+	if !oracleOut.Scan() {
+		_ = cmd.Wait()
+		oracleErr = fmt.Errorf("soupsieve oracle did not start (python3 with soupsieve and beautifulsoup4 needed): %s", stderr.String())
+		return
+	}
+	var v struct {
+		Version string `json:"version"`
+	}
+	if err := json.Unmarshal(oracleOut.Bytes(), &v); err != nil {
+		oracleErr = err
+		return
+	}
+	oracleVersion = v.Version
+}
+
+func oracle(t testing.TB, src string, selectors []string) oracleResp {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("oracle: %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	req, _ := json.Marshal(oracleReq{HTML: src, Selectors: selectors})
+	if _, err := oracleIn.Write(append(req, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	if !oracleOut.Scan() {
+		t.Fatalf("oracle died: %v", oracleOut.Err())
+	}
+	var resp oracleResp
+	if err := json.Unmarshal(oracleOut.Bytes(), &resp); err != nil {
+		t.Fatalf("oracle reply: %v: %s", err, oracleOut.Bytes())
+	}
+	return resp
+}
+
+func TestHegelOracleVersion(t *testing.T) {
+	oracle(t, "<html></html>", []string{"html"})
+	t.Logf("soupsieve %s", oracleVersion)
+	if !strings.HasPrefix(oracleVersion, "2.") {
+		t.Fatalf("soupsieve 2.x expected, got %s", oracleVersion)
+	}
+}
+
+var _ = hegel.Test
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..ebe814b
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,188 @@
+package cascadia_test
+
+// Pins: one plain test per recorded bug (bugs.toml), asserting the correct
+// behaviour; each fails while its bug is open.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/andybalholm/cascadia"
+	"golang.org/x/net/html"
+)
+
+func pinDoc(t *testing.T, body string) *html.Node {
+	t.Helper()
+	return mustParse("<!DOCTYPE html><html><head></head><body>" + body + "</body></html>")
+}
+
+func pinSel(t *testing.T, text string) cascadia.Sel {
+	t.Helper()
+	s, err := cascadia.Parse(text)
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", text, err)
+	}
+	return s
+}
+
+// ids lists the id attributes (or tag names) of nodes; non-elements are
+// marked.
+func ids(nodes []*html.Node) []string {
+	var out []string
+	for _, x := range nodes {
+		switch x.Type {
+		case html.ElementNode:
+			if v, ok := attrOf(x, "id"); ok {
+				out = append(out, "#"+v)
+			} else {
+				out = append(out, x.Data)
+			}
+		case html.TextNode:
+			out = append(out, "text("+x.Data+")")
+		case html.CommentNode:
+			out = append(out, "comment")
+		case html.DocumentNode:
+			out = append(out, "document")
+		default:
+			out = append(out, "node")
+		}
+	}
+	return out
+}
+
+func expectIDs(t *testing.T, doc *html.Node, text string, want ...string) {
+	t.Helper()
+	got := ids(cascadia.QueryAll(doc, pinSel(t, text)))
+	if strings.Join(got, " ") != strings.Join(want, " ") {
+		t.Errorf("QueryAll(%q) = %v, want %v", text, got, want)
+	}
+}
+
+// 1: :lang, :contains and :matches match text and comment nodes (and the
+// document node): QueryAll returns them, :has and ~ see them.
+func TestHegelPinPseudoClassesMatchOnlyElements(t *testing.T) {
+	doc := pinDoc(t, `<div id="d" lang="en">text<!--c--><span id="s"></span></div>`)
+	expectIDs(t, doc, ":lang(en)", "#d", "#s")
+	expectIDs(t, doc, `:contains("text")`, "html", "body", "#d")
+	expectIDs(t, doc, ":matches(text)", "html", "body", "#d")
+	expectIDs(t, doc, ":matchesown(^$)", "html", "head", "#s")
+	expectIDs(t, doc, ":has(:lang(fr))")
+	expectIDs(t, doc, ":lang(fr) ~ span")
+	if got := ids(cascadia.MustCompile(":matchesown(^$)").MatchAll(doc)); got[0] == "document" {
+		t.Errorf("MatchAll(:matchesown(^$)) returns the document node: %v", got)
+	}
+}
+
+// 2: String() does not escape quotes and backslashes in attribute values.
+func TestHegelPinStringEscapesAttributeValues(t *testing.T) {
+	for _, text := range []string{`[title="a\"b"]`, `[title="a\\b"]`, `:contains("a\"b")`} {
+		s := pinSel(t, text).String()
+		back, err := cascadia.Parse(s)
+		if err != nil {
+			t.Errorf("Parse(%q).String() = %q, which does not parse: %v", text, s, err)
+			continue
+		}
+		if back.String() != s {
+			t.Errorf("Parse(%q).String() = %q, reparsed String() = %q", text, s, back.String())
+		}
+	}
+	doc := pinDoc(t, `<div id="d" title="a&quot;b"></div>`)
+	s := pinSel(t, `[title="a\"b"]`).String()
+	if back, err := cascadia.Parse(s); err == nil {
+		if got := ids(cascadia.QueryAll(doc, back)); strings.Join(got, " ") != "#d" {
+			t.Errorf("reparsed %q matches %v", s, got)
+		}
+	}
+}
+
+// 3: String() does not escape a leading digit of a class (or id).
+func TestHegelPinStringEscapesLeadingDigits(t *testing.T) {
+	for _, text := range []string{`.\31 x`, `.-\31 x`, `#\31 st`} {
+		s := pinSel(t, text).String()
+		if _, err := cascadia.Parse(s); err != nil {
+			t.Errorf("Parse(%q).String() = %q, which does not parse: %v", text, s, err)
+		}
+	}
+}
+
+// 4: the never-matching pseudo-classes have specificity 0.
+func TestHegelPinNeverMatchingPseudoClassSpecificity(t *testing.T) {
+	for _, text := range []string{":hover", ":visited", ":active", ":focus", ":target"} {
+		if got := pinSel(t, text).Specificity(); got != (cascadia.Specificity{0, 1, 0}) {
+			t.Errorf("Specificity(%q) = %v, want [0 1 0]", text, got)
+		}
+	}
+}
+
+// 5: an option in a disabled optgroup is :enabled, not :disabled.
+func TestHegelPinOptionInDisabledOptgroup(t *testing.T) {
+	doc := pinDoc(t, `<optgroup id="g" disabled><option id="o"></option></optgroup>`)
+	expectIDs(t, doc, ":disabled", "#g", "#o")
+	expectIDs(t, doc, ":enabled")
+}
+
+// 6: :has() relative selectors are not anchored at the subject.
+func TestHegelPinHasIsScoped(t *testing.T) {
+	doc := pinDoc(t, `<div id="d"><span id="s"><b id="b"></b></span></div>`)
+	expectIDs(t, doc, "span:has(div b)")
+	expectIDs(t, doc, "div:has(div b)")
+	expectIDs(t, doc, ":has(* *)", "html", "body", "#d")
+	expectIDs(t, doc, "span:has(> div > b)")
+}
+
+// 7: :enabled matches a, area and link elements with an href.
+func TestHegelPinLinksAreNotEnabled(t *testing.T) {
+	doc := pinDoc(t, `<a id="a" href="#"></a><area id="r" href="#"><input id="i">`)
+	expectIDs(t, doc, ":enabled", "#i")
+}
+
+// 8: ^=, $= and *= never match a white-space-only attribute value.
+func TestHegelPinBlankValuesMatchSubstrings(t *testing.T) {
+	doc := pinDoc(t, `<div id="d" title=" "></div>`)
+	expectIDs(t, doc, `[title^=" "]`, "#d")
+	expectIDs(t, doc, `[title$=" "]`, "#d")
+	expectIDs(t, doc, `[title*=" "]`, "#d")
+}
+
+// 9: :lang compares the attribute case-sensitively.
+func TestHegelPinLangIsCaseInsensitive(t *testing.T) {
+	doc := pinDoc(t, `<div id="d" lang="EN"><span id="s" lang="en-US"></span></div>`)
+	expectIDs(t, doc, ":lang(en)", "#d", "#s")
+	expectIDs(t, doc, ":lang(en-us)", "#s")
+}
+
+// 10: :lang looks past an element's own lang attribute to its ancestors.
+func TestHegelPinLangUsesTheNearestAttribute(t *testing.T) {
+	doc := pinDoc(t, `<div id="d" lang="en"><span id="s" lang="fr"></span><em id="e" lang=""></em></div>`)
+	expectIDs(t, doc, ":lang(en)", "#d")
+	expectIDs(t, doc, ":lang(fr)", "#s")
+}
+
+// 11: :empty ignores text of Unicode white space, not just document white
+// space.
+func TestHegelPinEmptyKeepsNonBreakingSpace(t *testing.T) {
+	doc := pinDoc(t, "<p id=\"p\">\u00a0</p><q id=\"q\"> \n\t</q>")
+	expectIDs(t, doc, ":empty", "head", "#q")
+}
+
+// 12: attribute selectors on the HTML attributes whose values are defined
+// as case-insensitive (type, lang, dir, ...) compare case-sensitively.
+func TestHegelPinHTMLAttributeValuesCaseInsensitive(t *testing.T) {
+	doc := pinDoc(t, `<input id="i" type="CHECKBOX"><div id="d" dir="LTR"></div>`)
+	expectIDs(t, doc, `[type=checkbox]`, "#i")
+	expectIDs(t, doc, `[dir="ltr"]`, "#d")
+	expectIDs(t, doc, `[type^=check]`, "#i")
+}
+
+// 13: a zero hex escape yields U+0000 instead of U+FFFD.
+func TestHegelPinZeroEscapeIsReplacementCharacter(t *testing.T) {
+	doc := pinDoc(t, "<div id=\"a\ufffdb\"></div>")
+	expectIDs(t, doc, `#a\0 b`, "#a\ufffdb")
+}
+
+// 14: a fieldset inside a disabled fieldset is :disabled.
+func TestHegelPinNestedFieldsetIsDisabled(t *testing.T) {
+	doc := pinDoc(t, `<fieldset id="f" disabled><fieldset id="g"><input id="i"></fieldset></fieldset>`)
+	expectIDs(t, doc, ":disabled", "#f", "#g", "#i")
+	expectIDs(t, doc, ":enabled")
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..068ccf9
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,316 @@
+package cascadia_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/andybalholm/cascadia"
+	"golang.org/x/net/html"
+	"hegel.dev/go/hegel"
+)
+
+// query runs QueryAll and, while the text-node bug is open, keeps only the
+// element nodes it returns.
+func query(doc *html.Node, sel cascadia.Matcher) []*html.Node {
+	out := cascadia.QueryAll(doc, sel)
+	if !Known.textNodesMatch {
+		return out
+	}
+	var els []*html.Node
+	for _, x := range out {
+		if x.Type == html.ElementNode {
+			els = append(els, x)
+		}
+	}
+	return els
+}
+
+// onlyElements drops the non-element nodes MatchAll returns while the
+// text-node bug is open (MatchAll also tests the document node itself).
+func onlyElements(nodes []*html.Node) []*html.Node {
+	if !Known.textNodesMatch {
+		return nodes
+	}
+	var els []*html.Node
+	for _, x := range nodes {
+		if x.Type == html.ElementNode {
+			els = append(els, x)
+		}
+	}
+	return els
+}
+
+func describe(text, src string) string {
+	return fmt.Sprintf("selector %q\ndocument %s", text, src)
+}
+
+// TestHegelSelectorsAgreeWithSoupsieve: standard selectors over generated
+// documents match the same elements in cascadia and in soupsieve.
+func TestHegelSelectorsAgreeWithSoupsieve(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := genDoc(ht)
+		src := d.html()
+		doc := mustParse(src)
+		els := elements(doc)
+		k := n(ht, 1, 6)
+		var texts []string
+		for i := 0; i < k; i++ {
+			texts = append(texts, render(genGroup(ht, false, 0), canon, ht))
+		}
+		resp := oracle(ht, src, texts)
+		if !equalStrings(resp.Tags, tagsOf(els)) {
+			fail(ht, "HTML parsers disagree\ngo %v\npython %v\n%s", tagsOf(els), resp.Tags, src)
+		}
+		for i, text := range texts {
+			r := resp.Results[i]
+			sel, err := cascadia.ParseGroup(text)
+			if r.Error != "" {
+				fail(ht, "soupsieve rejects the selector: %s\n%s", r.Error, describe(text, src))
+			}
+			if err != nil {
+				fail(ht, "cascadia rejects the selector: %v\n%s", err, describe(text, src))
+			}
+			got := indices(els, query(doc, sel))
+			if !equalInts(got, r.M) {
+				fail(ht, "matches differ: %s\ncascadia %v\nsoupsieve %v\n%s", firstKind(text), got, r.M, describe(text, src))
+			}
+		}
+	})
+}
+
+// firstKind gives a mismatch a coarse class for triage: the pseudo-classes
+// and attribute operators the selector uses.
+func firstKind(text string) string {
+	var kinds []string
+	for _, p := range []string{":not", ":has", ":haschild", ":nth-", ":first", ":last", ":only", ":empty", ":root", ":link", ":enabled", ":disabled", ":checked", ":lang", ":input", ":contains", ":matches", "~=", "|=", "^=", "$=", "*=", "!=", "#=", " i]", "#", "."} {
+		if strings.Contains(text, p) {
+			kinds = append(kinds, p)
+		}
+	}
+	return strings.Join(kinds, " ")
+}
+
+// TestHegelSelectorsAgreeWithTheModel: every selector of the full grammar
+// (including cascadia's extensions) matches the elements the model says,
+// and the query APIs agree with each other.
+func TestHegelSelectorsAgreeWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := genDoc(ht)
+		src := d.html()
+		doc := mustParse(src)
+		els := elements(doc)
+		k := n(ht, 1, 5)
+		for i := 0; i < k; i++ {
+			g := genGroup(ht, true, 0)
+			text := render(g, canon, ht)
+			sel, err := cascadia.ParseGroup(text)
+			if err != nil {
+				fail(ht, "cascadia rejects the selector: %v\n%s", err, describe(text, src))
+			}
+			var want []int
+			for j, el := range els {
+				if modelGroup(g, el) {
+					want = append(want, j)
+				}
+			}
+			if want == nil {
+				want = []int{}
+			}
+			got := indices(els, query(doc, sel))
+			if !equalInts(got, want) {
+				fail(ht, "matches differ from the model: %s\ncascadia %v\nmodel %v\n%s", firstKind(text), got, want, describe(text, src))
+			}
+			// The other APIs.
+			compiled := cascadia.MustCompile(text)
+			if all := indices(els, query(doc, sel)); !equalInts(all, indices(els, onlyElements(compiled.MatchAll(doc)))) {
+				all2 := indices(els, onlyElements(compiled.MatchAll(doc)))
+				fail(ht, "MatchAll differs from QueryAll\nMatchAll %v\nQueryAll %v\n%s", all2, all, describe(text, src))
+			}
+			first := cascadia.Query(doc, sel)
+			if all := cascadia.QueryAll(doc, sel); len(all) == 0 && first != nil || len(all) > 0 && first != all[0] {
+				fail(ht, "Query is not the first of QueryAll\n%s", describe(text, src))
+			}
+			if mf := compiled.MatchFirst(doc); mf != first && !(Known.textNodesMatch && mf != nil && mf.Type != html.ElementNode) {
+				fail(ht, "MatchFirst differs from Query\n%s", describe(text, src))
+			}
+			if f := indices(els, cascadia.Filter(els, sel)); !equalInts(f, got) {
+				fail(ht, "Filter differs from QueryAll\nFilter %v\nQueryAll %v\n%s", f, got, describe(text, src))
+			}
+			if f := indices(els, compiled.Filter(els)); !equalInts(f, got) {
+				fail(ht, "Selector.Filter differs from QueryAll\nFilter %v\nQueryAll %v\n%s", f, got, describe(text, src))
+			}
+			for j, el := range els {
+				in := false
+				for _, x := range got {
+					if x == j {
+						in = true
+					}
+				}
+				if sel.Match(el) != in || compiled.Match(el) != in {
+					fail(ht, "Match disagrees with QueryAll for element %d\n%s", j, describe(text, src))
+				}
+			}
+			if !Known.textNodesMatch {
+				for _, x := range cascadia.QueryAll(doc, sel) {
+					if x.Type != html.ElementNode {
+						fail(ht, "a non-element node matches\n%s", describe(text, src))
+					}
+				}
+			}
+		}
+	})
+}
+
+// TestHegelSerializationRoundTrips: String() of a parsed selector parses to
+// an equivalent selector (same matches, same specificity), and String() is
+// idempotent.
+func TestHegelSerializationRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := genDoc(ht)
+		src := d.html()
+		doc := mustParse(src)
+		els := elements(doc)
+		g := genRoundTrippable(ht, true)
+		text := render(g, canon, ht)
+		sel, err := cascadia.ParseGroup(text)
+		if err != nil {
+			fail(ht, "cascadia rejects the selector: %v\n%s", err, describe(text, src))
+		}
+		s := sel.String()
+		sel2, err := cascadia.ParseGroup(s)
+		if err != nil {
+			fail(ht, "String() output does not parse: %v\nString %q\n%s", err, s, describe(text, src))
+		}
+		if s2 := sel2.String(); s2 != s {
+			fail(ht, "String() is not idempotent\nfirst  %q\nsecond %q\n%s", s, s2, describe(text, src))
+		}
+		got := indices(els, query(doc, sel))
+		got2 := indices(els, query(doc, sel2))
+		if !equalInts(got, got2) {
+			fail(ht, "String() output matches differently: %s\noriginal %v\nreparsed %v\nString %q\n%s", firstKind(text), got, got2, s, describe(text, src))
+		}
+		if len(sel) != len(sel2) {
+			fail(ht, "String() output has %d selectors, not %d\nString %q\n%s", len(sel2), len(sel), s, describe(text, src))
+		}
+		for i := range sel {
+			if sel[i].Specificity() != sel2[i].Specificity() {
+				fail(ht, "String() output has another specificity\noriginal %v\nreparsed %v\nString %q\n%s", sel[i].Specificity(), sel2[i].Specificity(), s, describe(text, src))
+			}
+		}
+	})
+}
+
+// TestHegelParserIgnoresSpelling: the same selector written with other
+// whitespace, comments, case, quotes and escapes parses to the same
+// selector (same String(), same matches).
+func TestHegelParserIgnoresSpelling(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := genDoc(ht)
+		src := d.html()
+		doc := mustParse(src)
+		els := elements(doc)
+		g := genGroup(ht, true, 0)
+		text := render(g, canon, ht)
+		sel, err := cascadia.ParseGroup(text)
+		if err != nil {
+			fail(ht, "cascadia rejects the selector: %v\n%s", err, describe(text, src))
+		}
+		got := indices(els, query(doc, sel))
+		k := n(ht, 1, 3)
+		for i := 0; i < k; i++ {
+			st := randomStyle(ht)
+			variant := render(g, st, ht)
+			v, err := cascadia.ParseGroup(variant)
+			if err != nil {
+				fail(ht, "cascadia rejects a spelling variant: %v\nvariant %q\n%s", err, variant, describe(text, src))
+			}
+			if v.String() != sel.String() {
+				fail(ht, "a spelling variant parses differently\nvariant  %q\n  gives  %q\ncanonical gives %q\n%s", variant, v.String(), sel.String(), describe(text, src))
+			}
+			if gv := indices(els, query(doc, v)); !equalInts(gv, got) {
+				fail(ht, "a spelling variant matches differently\nvariant %q\nvariant %v\ncanonical %v\n%s", variant, gv, got, describe(text, src))
+			}
+		}
+	})
+}
+
+// TestHegelSpecificityFollowsTheSpec: Specificity() equals the model's.
+func TestHegelSpecificityFollowsTheSpec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		g := genGroup(ht, true, 0)
+		text := render(g, canon, ht)
+		sel, err := cascadia.ParseGroup(text)
+		if err != nil {
+			fail(ht, "cascadia rejects the selector: %v\nselector %q", err, text)
+		}
+		if len(sel) != len(g) {
+			fail(ht, "%d selectors parsed, %d written\nselector %q", len(sel), len(g), text)
+		}
+		for i := range g {
+			want := specComplex(g[i])
+			got := sel[i].Specificity()
+			if spec(got) != want {
+				fail(ht, "specificity differs: %s\ncascadia %v\nmodel %v\nselector %q", firstKind(render(group{g[i]}, canon, ht)), got, want, render(group{g[i]}, canon, ht))
+			}
+			if sel[i].PseudoElement() != "" {
+				fail(ht, "a pseudo-element appeared from nowhere: %q\nselector %q", sel[i].PseudoElement(), text)
+			}
+		}
+	})
+}
+
+var pseudoElements = []string{"after", "backdrop", "before", "cue", "first-letter", "first-line", "grammar-error", "marker", "placeholder", "selection", "spelling-error"}
+
+// TestHegelPseudoElements: a pseudo-element is accepted only by the
+// *WithPseudoElement parsers, reported by PseudoElement(), adds (0,0,1) to
+// the specificity, does not change what matches, and round-trips.
+func TestHegelPseudoElements(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := genDoc(ht)
+		src := d.html()
+		doc := mustParse(src)
+		els := elements(doc)
+		c := genRoundTrippable(ht, true)[0]
+		plain := render(group{c}, canon, ht)
+		pe := pick(ht, pseudoElements...)
+		c.parts[len(c.parts)-1].pseudoElement = pe
+		text := render(group{c}, canon, ht)
+		if _, err := cascadia.Parse(text); err == nil {
+			fail(ht, "Parse accepts a pseudo-element\nselector %q", text)
+		}
+		if _, err := cascadia.ParseGroup(text); err == nil {
+			fail(ht, "ParseGroup accepts a pseudo-element\nselector %q", text)
+		}
+		base, err := cascadia.Parse(plain)
+		if err != nil {
+			fail(ht, "cascadia rejects the selector: %v\nselector %q", err, plain)
+		}
+		sel, err := cascadia.ParseWithPseudoElement(text)
+		if err != nil {
+			fail(ht, "ParseWithPseudoElement rejects the selector: %v\nselector %q", err, text)
+		}
+		if sel.PseudoElement() != pe {
+			fail(ht, "PseudoElement() is %q, not %q\nselector %q", sel.PseudoElement(), pe, text)
+		}
+		if want := spec(base.Specificity()).add(spec{0, 0, 1}); spec(sel.Specificity()) != want {
+			fail(ht, "specificity with a pseudo-element is %v, not %v\nselector %q", sel.Specificity(), want, text)
+		}
+		got := indices(els, query(doc, sel))
+		if want := indices(els, query(doc, base)); !equalInts(got, want) {
+			fail(ht, "a pseudo-element changes the matches\nwith %v\nwithout %v\n%s", got, want, describe(text, src))
+		}
+		s := sel.String()
+		sel2, err := cascadia.ParseWithPseudoElement(s)
+		if err != nil {
+			fail(ht, "String() output does not parse: %v\nString %q\nselector %q", err, s, text)
+		}
+		if sel2.PseudoElement() != pe || sel2.String() != s {
+			fail(ht, "String() round trip changes the pseudo-element\nString %q\nreparsed %q %q\nselector %q", s, sel2.String(), sel2.PseudoElement(), text)
+		}
+		g, err := cascadia.ParseGroupWithPseudoElements(text + ", " + plain)
+		if err != nil || len(g) != 2 || g[0].PseudoElement() != pe || g[1].PseudoElement() != "" {
+			fail(ht, "ParseGroupWithPseudoElements: %v %v\nselector %q", err, g, text+", "+plain)
+		}
+	})
+}
diff --git a/hegel_sel_test.go b/hegel_sel_test.go
new file mode 100644
index 0000000..0567757
--- /dev/null
+++ b/hegel_sel_test.go
@@ -0,0 +1,1103 @@
+package cascadia_test
+
+// Selector ASTs: generation, rendering (canonical and spelling variants),
+// a model matcher over html.Node following the Selectors specification and
+// the HTML spec's pseudo-class definitions, and a specificity model.
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+
+	"golang.org/x/net/html"
+	"hegel.dev/go/hegel"
+)
+
+type simple struct {
+	kind  string // "id", "class", "attr", "pseudo"
+	name  string // id, class, attribute key or pseudo-class name (lower case)
+	op    string // attribute operator
+	val   string // attribute value, :lang / :contains argument
+	ci    bool   // attribute case flag
+	a, b  int    // nth arguments
+	group group  // :not arguments
+	rels  []relative
+	rx    string     // :matches / #= regular expression
+	node  *html.Node // the :scope element of an anchored relative selector
+}
+
+type compound struct {
+	tag           string // "" for none, "*" for the universal selector
+	simples       []simple
+	pseudoElement string
+}
+
+type complex struct {
+	parts []compound
+	combs []byte // combs[i] joins parts[i] and parts[i+1]
+}
+
+type relative struct {
+	comb byte // 0 for the implicit one
+	sel  complex
+}
+
+type group []complex
+
+var (
+	attrKeys      = []string{"id", "class", "data-x", "title", "lang", "dir", "type", "href", "name", "checked", "disabled"}
+	stdAttrOps    = []string{"", "=", "~=", "|=", "^=", "$=", "*="}
+	extAttrOps    = []string{"!=", "#="}
+	simplePseudos = []string{"first-child", "last-child", "first-of-type", "last-of-type", "only-child", "only-of-type", "empty", "root", "link", "enabled", "disabled", "checked", "hover", "visited", "active", "focus", "target"}
+	extPseudos    = []string{"input"}
+	nthPseudos    = []string{"nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type"}
+	rxPool        = []string{"^a", "b$", "a.c", "[ab]+", "^$", "\\d", "(?i)lorem", "x|y"}
+	selTagPool    = append(append([]string{}, containerTags...), "input", "area", "textarea", "optgroup", "option", "html", "body", "head", "p", "select")
+)
+
+// caseInsensitiveHTMLAttrs are the attributes whose values HTML compares
+// ASCII case-insensitively in attribute selectors.
+var caseInsensitiveHTMLAttrs = map[string]bool{"type": true, "lang": true, "dir": true, "checked": true, "disabled": true, "selected": true, "name": false}
+
+func genGroup(tc hegel.TestCase, ext bool, depth int) group {
+	k := 1
+	if chance(tc, 25) {
+		k = n(tc, 2, 3)
+	}
+	g := make(group, k)
+	for i := range g {
+		g[i] = genComplex(tc, ext, depth)
+	}
+	return g
+}
+
+func genComplex(tc hegel.TestCase, ext bool, depth int) complex {
+	k := 1
+	if chance(tc, 45) {
+		k = n(tc, 2, 3)
+	}
+	var c complex
+	for i := 0; i < k; i++ {
+		c.parts = append(c.parts, genCompound(tc, ext, depth))
+		if i+1 < k {
+			c.combs = append(c.combs, pick(tc, byte(' '), '>', '+', '~'))
+			if Known.textNodesMatch && c.combs[i] == '~' {
+				stripTextPseudos(&c.parts[i])
+			}
+		}
+	}
+	return c
+}
+
+func genCompound(tc hegel.TestCase, ext bool, depth int) compound {
+	var c compound
+	switch n(tc, 1, 10) {
+	case 1, 2, 3, 4:
+		c.tag = pick(tc, selTagPool...)
+	case 5:
+		c.tag = "*"
+	}
+	k := n(tc, 0, 2)
+	if c.tag == "" && k == 0 {
+		k = 1
+	}
+	for i := 0; i < k; i++ {
+		c.simples = append(c.simples, genSimple(tc, ext, depth))
+	}
+	return c
+}
+
+func genSimple(tc hegel.TestCase, ext bool, depth int) simple {
+	switch r := n(tc, 1, 100); {
+	case r <= 15:
+		return simple{kind: "id", name: pick(tc, idPool...)}
+	case r <= 35:
+		return simple{kind: "class", name: pick(tc, classPool...)}
+	case r <= 60:
+		return genAttr(tc, ext)
+	default:
+		return genPseudo(tc, ext, depth)
+	}
+}
+
+func genAttr(tc hegel.TestCase, ext bool) simple {
+	s := simple{kind: "attr", name: pick(tc, attrKeys...)}
+	ops := stdAttrOps
+	if ext {
+		ops = append(append([]string{}, stdAttrOps...), extAttrOps...)
+	}
+	s.op = pick(tc, ops...)
+	if !ext && s.name == "class" && s.op != "" && s.op != "~=" {
+		// BeautifulSoup parses class as a list and soupsieve matches its
+		// single-space join, so only ~= and presence are compared there.
+		s.op = "~="
+	}
+	switch s.op {
+	case "":
+	case "#=":
+		s.rx = pick(tc, rxPool...)
+	default:
+		switch s.name {
+		case "id":
+			s.val = pick(tc, idPool...)
+		case "class":
+			s.val = pick(tc, classPool...)
+		case "lang":
+			s.val = pick(tc, langPool...)
+		case "type":
+			s.val = pick(tc, typePool...)
+		case "dir":
+			s.val = pick(tc, dirPool...)
+		default:
+			s.val = pick(tc, valuePool...)
+		}
+		if chance(tc, 30) {
+			s.val = pick(tc, valuePool...)
+		}
+		if Known.blankValuesNeverMatch && (s.op == "^=" || s.op == "$=" || s.op == "*=") && strings.Trim(s.val, cssSpace) == "" {
+			s.val = "a"
+		}
+		s.ci = chance(tc, 20)
+		if !ext && Known.htmlAttrsCaseSensitive && caseInsensitiveHTMLAttrs[s.name] && !s.ci {
+			// HTML compares these values case-insensitively; the library does not.
+			s.ci = true
+		}
+	}
+	return s
+}
+
+func genPseudo(tc hegel.TestCase, ext bool, depth int) simple {
+	r := n(tc, 1, 100)
+	switch {
+	case r <= 35:
+		pool := simplePseudos
+		if ext {
+			pool = append(append([]string{}, simplePseudos...), extPseudos...)
+		}
+		name := pick(tc, pool...)
+		if name == "enabled" && !ext && Known.linksAreEnabled {
+			name = "disabled"
+		}
+		return simple{kind: "pseudo", name: name}
+	case r <= 55:
+		s := simple{kind: "pseudo", name: pick(tc, nthPseudos...)}
+		switch n(tc, 1, 6) {
+		case 1:
+			s.a, s.b = 2, 1 // odd
+		case 2:
+			s.a, s.b = 2, 0 // even
+		case 3:
+			s.a, s.b = 0, n(tc, -1, 4)
+		default:
+			s.a, s.b = n(tc, -3, 3), n(tc, -4, 5)
+		}
+		return s
+	case r <= 62:
+		return simple{kind: "pseudo", name: "lang", val: strings.ToLower(pick(tc, langPool[:6]...))}
+	case r <= 75 && depth < 2:
+		return simple{kind: "pseudo", name: "not", group: genGroup(tc, ext, depth+1)}
+	case r <= 88 && depth < 2:
+		name := "has"
+		if ext && chance(tc, 30) {
+			name = "haschild"
+		}
+		k := 1
+		if chance(tc, 25) {
+			k = 2
+		}
+		s := simple{kind: "pseudo", name: name}
+		for i := 0; i < k; i++ {
+			rel := relative{sel: genComplex(tc, ext, depth+1)}
+			if Known.hasUnscoped {
+				rel.sel = complex{parts: rel.sel.parts[:1]}
+			}
+			if chance(tc, 50) {
+				rel.comb = pick(tc, byte(' '), '>', '+', '~')
+				if rel.comb == ' ' && name == "haschild" {
+					rel.comb = 0 // white space is the implicit combinator, child for :haschild
+				}
+			}
+			if Known.textNodesMatch {
+				for j := range rel.sel.parts {
+					stripTextPseudos(&rel.sel.parts[j])
+				}
+			}
+			s.rels = append(s.rels, rel)
+		}
+		return s
+	case r <= 94 && ext:
+		return simple{kind: "pseudo", name: pick(tc, "contains", "containsown"), val: pick(tc, wordPool...)}
+	case ext:
+		return simple{kind: "pseudo", name: pick(tc, "matches", "matchesown"), rx: pick(tc, rxPool...)}
+	default:
+		name := pick(tc, simplePseudos...)
+		if name == "enabled" && !ext && Known.linksAreEnabled {
+			name = "disabled"
+		}
+		return simple{kind: "pseudo", name: name}
+	}
+}
+
+// stripTextPseudos removes the pseudo-classes that match text nodes (bug:
+// textNodesMatch) from a compound that the library tests against text
+// nodes (the left side of ~, the subject of :has / :haschild).
+func stripTextPseudos(c *compound) {
+	var kept []simple
+	for _, s := range c.simples {
+		switch s.name {
+		case "lang", "contains", "containsown", "matches", "matchesown":
+			continue
+		}
+		kept = append(kept, s)
+	}
+	c.simples = kept
+	if c.tag == "" && len(kept) == 0 {
+		c.tag = "*"
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Rendering.
+
+type style struct {
+	spaces   []string // whitespace inserted where whitespace is optional (nil: none)
+	comments bool     // comments inserted with the whitespace
+	upper    bool     // upper-case tag, attribute and pseudo-class names
+	escapes  bool     // random hex escapes inside identifiers and strings
+	quote    byte     // string quote
+	bare     bool     // attribute values as identifiers when they are ones
+	nthAlias bool     // odd / even / n / -n spellings
+}
+
+var canon = style{quote: '"'}
+
+type renderer struct {
+	tc hegel.TestCase
+	st style
+}
+
+func render(g group, st style, tc hegel.TestCase) string {
+	r := &renderer{tc: tc, st: st}
+	return r.group(g)
+}
+
+func randomStyle(tc hegel.TestCase) style {
+	st := style{quote: pick(tc, byte('"'), '\'')}
+	if chance(tc, 60) {
+		st.spaces = pick(tc, []string{" "}, []string{" ", "\t", "\n", "  "}, []string{"\r\n", "\f", " "})
+	}
+	st.comments = chance(tc, 30)
+	st.upper = chance(tc, 40)
+	st.escapes = chance(tc, 40)
+	st.bare = chance(tc, 50)
+	st.nthAlias = chance(tc, 50)
+	return st
+}
+
+// ws returns optional whitespace (and maybe a comment).
+func (r *renderer) ws() string {
+	if r.st.spaces == nil {
+		return ""
+	}
+	if !chance(r.tc, 50) {
+		return ""
+	}
+	s := pick(r.tc, r.st.spaces...)
+	if r.st.comments && chance(r.tc, 30) {
+		s += pick(r.tc, "/**/", "/* c */", "/* * / */") + pick(r.tc, r.st.spaces...)
+	}
+	return s
+}
+
+// mandatory returns whitespace where some is required.
+func (r *renderer) mandatory() string {
+	if r.st.spaces == nil {
+		return " "
+	}
+	return pick(r.tc, r.st.spaces...)
+}
+
+func (r *renderer) caseOf(s string) string {
+	if r.st.upper && chance(r.tc, 60) {
+		return strings.ToUpper(s)
+	}
+	return s
+}
+
+func isNameChar(c rune) bool {
+	return c == '_' || c == '-' || c >= 0x80 || ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z') || ('0' <= c && c <= '9')
+}
+
+func isDigit(c rune) bool { return '0' <= c && c <= '9' }
+
+func allHyphens(s string) bool {
+	for _, c := range s {
+		if c != '-' {
+			return false
+		}
+	}
+	return true
+}
+
+func (r *renderer) hexEscape(c rune) string {
+	h := fmt.Sprintf("%x", c)
+	if r.st.upper && chance(r.tc, 50) {
+		h = strings.ToUpper(h)
+	}
+	return "\\" + h + " "
+}
+
+// ident renders an identifier (a type, class, attribute or pseudo-class
+// name), escaping what must be escaped and, in the escaping style, more.
+func (r *renderer) ident(s string) string {
+	var b strings.Builder
+	rs := []rune(s)
+	for i, c := range rs {
+		must := !isNameChar(c) || (isDigit(c) && (i == 0 || (i == 1 && rs[0] == '-'))) || (c == '-' && i == len(rs)-1 && allHyphens(s))
+		if must {
+			if r.st.escapes && chance(r.tc, 50) && !isDigit(c) && !(c >= 'a' && c <= 'f') && !(c >= 'A' && c <= 'F') && c >= 0x20 && c < 0x80 {
+				b.WriteString("\\" + string(c))
+			} else {
+				b.WriteString(r.hexEscape(c))
+			}
+			continue
+		}
+		if r.st.escapes && chance(r.tc, 20) {
+			b.WriteString(r.hexEscape(c))
+			continue
+		}
+		b.WriteRune(c)
+	}
+	return b.String()
+}
+
+// str renders a quoted string.
+func (r *renderer) str(s string) string {
+	q := r.st.quote
+	var b strings.Builder
+	b.WriteByte(q)
+	for _, c := range s {
+		switch {
+		case c == rune(q) || c == '\\':
+			if r.st.escapes && chance(r.tc, 50) {
+				b.WriteString(r.hexEscape(c))
+			} else {
+				b.WriteByte('\\')
+				b.WriteRune(c)
+			}
+		case c == '\n' || c == '\r' || c == '\f':
+			b.WriteString(r.hexEscape(c))
+		case r.st.escapes && chance(r.tc, 20):
+			b.WriteString(r.hexEscape(c))
+		default:
+			b.WriteRune(c)
+		}
+	}
+	b.WriteByte(q)
+	return b.String()
+}
+
+// isIdent reports whether s is a CSS identifier as written.
+func isIdent(s string) bool {
+	rs := []rune(s)
+	if len(rs) == 0 {
+		return false
+	}
+	i := 0
+	if rs[0] == '-' {
+		i = 1
+		if len(rs) == 1 {
+			return false
+		}
+		if rs[1] == '-' {
+			i = 2
+		}
+	}
+	if i < len(rs) && isDigit(rs[i]) {
+		return false
+	}
+	for ; i < len(rs); i++ {
+		if !isNameChar(rs[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func (r *renderer) group(g group) string {
+	parts := make([]string, len(g))
+	for i, c := range g {
+		parts[i] = r.complex(c)
+	}
+	return strings.Join(parts, r.ws()+","+r.ws())
+}
+
+func (r *renderer) complex(c complex) string {
+	var b strings.Builder
+	for i, p := range c.parts {
+		if i > 0 {
+			b.WriteString(r.combinator(c.combs[i-1]))
+		}
+		b.WriteString(r.compound(p))
+	}
+	return b.String()
+}
+
+func (r *renderer) combinator(comb byte) string {
+	if comb == ' ' {
+		return r.mandatory() + r.ws()
+	}
+	return r.ws() + string(comb) + r.ws()
+}
+
+func (r *renderer) compound(c compound) string {
+	var b strings.Builder
+	switch c.tag {
+	case "":
+	case "*":
+		b.WriteString("*")
+	default:
+		b.WriteString(r.ident(r.caseOf(c.tag)))
+	}
+	for _, s := range c.simples {
+		b.WriteString(r.simple(s))
+	}
+	if c.pseudoElement != "" {
+		b.WriteString("::" + r.caseOf(c.pseudoElement))
+	}
+	return b.String()
+}
+
+func (r *renderer) simple(s simple) string {
+	switch s.kind {
+	case "id":
+		return "#" + r.ident(s.name)
+	case "class":
+		return "." + r.ident(s.name)
+	case "attr":
+		var b strings.Builder
+		b.WriteString("[" + r.ws() + r.ident(r.caseOf(s.name)))
+		if s.op != "" {
+			b.WriteString(r.ws() + s.op + r.ws())
+			if s.op == "#=" {
+				b.WriteString(s.rx)
+			} else if r.st.bare && isIdent(s.val) && chance(r.tc, 70) {
+				b.WriteString(r.ident(s.val))
+			} else {
+				b.WriteString(r.str(s.val))
+			}
+			if s.ci {
+				b.WriteString(r.mandatory() + r.caseOf("i"))
+			}
+		}
+		if s.op != "#=" { // a regular expression runs to the bracket
+			b.WriteString(r.ws())
+		}
+		b.WriteString("]")
+		return b.String()
+	}
+	name := ":" + r.caseOf(s.name)
+	switch s.name {
+	case "not":
+		return name + "(" + r.ws() + r.group(s.group) + r.ws() + ")"
+	case "has", "haschild":
+		parts := make([]string, len(s.rels))
+		for i, rel := range s.rels {
+			if rel.comb != 0 {
+				parts[i] = string(rel.comb) + r.ws() + r.complex(rel.sel)
+			} else {
+				parts[i] = r.complex(rel.sel)
+			}
+		}
+		return name + "(" + r.ws() + strings.Join(parts, r.ws()+","+r.ws()) + r.ws() + ")"
+	case "nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type":
+		return name + "(" + r.ws() + r.nth(s.a, s.b) + r.ws() + ")"
+	case "lang":
+		return name + "(" + r.ws() + r.ident(r.caseOf(s.val)) + r.ws() + ")"
+	case "contains", "containsown":
+		return name + "(" + r.ws() + r.str(s.val) + r.ws() + ")"
+	case "matches", "matchesown":
+		return name + "(" + s.rx + ")"
+	}
+	return name
+}
+
+func (r *renderer) nth(a, b int) string {
+	if r.st.nthAlias {
+		switch {
+		case a == 2 && b == 1 && chance(r.tc, 70):
+			return r.caseOf("odd")
+		case a == 2 && b == 0 && chance(r.tc, 70):
+			return r.caseOf("even")
+		}
+	}
+	if a == 0 {
+		return fmt.Sprintf("%d", b)
+	}
+	var s string
+	switch {
+	case a == 1 && r.st.nthAlias && chance(r.tc, 60):
+		s = r.caseOf("n")
+	case a == -1 && r.st.nthAlias && chance(r.tc, 60):
+		s = "-" + r.caseOf("n")
+	default:
+		s = fmt.Sprintf("%d", a) + r.caseOf("n")
+	}
+	if b == 0 && !(r.st.nthAlias && chance(r.tc, 30)) {
+		return s
+	}
+	sign := "+"
+	if b < 0 {
+		sign = "-"
+		b = -b
+	}
+	return s + r.ws() + sign + r.ws() + fmt.Sprintf("%d", b)
+}
+
+// ---------------------------------------------------------------------------
+// The model matcher.
+
+func modelGroup(g group, el *html.Node) bool {
+	for _, c := range g {
+		if modelComplex(c, el) {
+			return true
+		}
+	}
+	return false
+}
+
+func modelComplex(c complex, el *html.Node) bool {
+	return modelComplexAt(c, len(c.parts)-1, el)
+}
+
+func prevElement(el *html.Node) *html.Node {
+	for p := el.PrevSibling; p != nil; p = p.PrevSibling {
+		if p.Type == html.ElementNode {
+			return p
+		}
+	}
+	return nil
+}
+
+func nextElement(el *html.Node) *html.Node {
+	for p := el.NextSibling; p != nil; p = p.NextSibling {
+		if p.Type == html.ElementNode {
+			return p
+		}
+	}
+	return nil
+}
+
+func parentElement(el *html.Node) *html.Node {
+	if el.Parent != nil && el.Parent.Type == html.ElementNode {
+		return el.Parent
+	}
+	return nil
+}
+
+func modelComplexAt(c complex, i int, el *html.Node) bool {
+	if el == nil || el.Type != html.ElementNode || !modelCompound(c.parts[i], el) {
+		return false
+	}
+	if i == 0 {
+		return true
+	}
+	switch c.combs[i-1] {
+	case ' ':
+		for p := parentElement(el); p != nil; p = parentElement(p) {
+			if modelComplexAt(c, i-1, p) {
+				return true
+			}
+		}
+		return false
+	case '>':
+		return modelComplexAt(c, i-1, parentElement(el))
+	case '+':
+		return modelComplexAt(c, i-1, prevElement(el))
+	case '~':
+		for p := prevElement(el); p != nil; p = prevElement(p) {
+			if modelComplexAt(c, i-1, p) {
+				return true
+			}
+		}
+		return false
+	}
+	panic("combinator")
+}
+
+func modelCompound(c compound, el *html.Node) bool {
+	if c.tag != "" && c.tag != "*" && el.Data != strings.ToLower(c.tag) {
+		return false
+	}
+	for _, s := range c.simples {
+		if !modelSimple(s, el) {
+			return false
+		}
+	}
+	return true
+}
+
+func attrOf(el *html.Node, key string) (string, bool) {
+	for _, a := range el.Attr {
+		if a.Key == key && a.Namespace == "" {
+			return a.Val, true
+		}
+	}
+	return "", false
+}
+
+func hasAttrOf(el *html.Node, key string) bool {
+	_, ok := attrOf(el, key)
+	return ok
+}
+
+func asciiLower(s string) string {
+	var b []byte
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if 'A' <= c && c <= 'Z' {
+			if b == nil {
+				b = []byte(s)
+			}
+			b[i] = c + 32
+		}
+	}
+	if b == nil {
+		return s
+	}
+	return string(b)
+}
+
+const cssSpace = " \t\n\r\f"
+
+func modelAttr(s simple, el *html.Node) bool {
+	v, ok := attrOf(el, s.name)
+	if s.op == "!=" {
+		return !(ok && fold(v, s.ci) == fold(s.val, s.ci))
+	}
+	if !ok {
+		return false
+	}
+	val := fold(s.val, s.ci)
+	v = fold(v, s.ci)
+	switch s.op {
+	case "":
+		return true
+	case "=":
+		return v == val
+	case "~=":
+		if val == "" || strings.ContainsAny(val, cssSpace) {
+			return false
+		}
+		for _, tok := range strings.FieldsFunc(v, func(r rune) bool { return strings.ContainsRune(cssSpace, r) }) {
+			if tok == val {
+				return true
+			}
+		}
+		return false
+	case "|=":
+		return v == val || strings.HasPrefix(v, val+"-")
+	case "^=":
+		return val != "" && strings.HasPrefix(v, val)
+	case "$=":
+		return val != "" && strings.HasSuffix(v, val)
+	case "*=":
+		return val != "" && strings.Contains(v, val)
+	case "#=":
+		return regexp.MustCompile(s.rx).MatchString(v)
+	}
+	panic("attribute operator " + s.op)
+}
+
+func fold(s string, ci bool) string {
+	if ci {
+		return asciiLower(s)
+	}
+	return s
+}
+
+func elementChildren(el *html.Node) []*html.Node {
+	var out []*html.Node
+	for c := el.FirstChild; c != nil; c = c.NextSibling {
+		if c.Type == html.ElementNode {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// position returns the 1-based index of el among its element siblings (of
+// its type when ofType), counted from the end when last, and whether it has
+// a parent element at all.
+func position(el *html.Node, ofType, last bool) (int, bool) {
+	if el.Parent == nil {
+		return 0, false
+	}
+	sibs := elementChildren(el.Parent)
+	idx := 0
+	for _, s := range sibs {
+		if ofType && s.Data != el.Data {
+			continue
+		}
+		idx++
+		if s == el {
+			if !last {
+				return idx, true
+			}
+			count := 0
+			for _, t := range sibs {
+				if !ofType || t.Data == el.Data {
+					count++
+				}
+			}
+			return count - idx + 1, true
+		}
+	}
+	return 0, false
+}
+
+func matchesAnB(a, b, idx int) bool {
+	if a == 0 {
+		return idx == b
+	}
+	d := idx - b
+	return d%a == 0 && d/a >= 0
+}
+
+func textOf(el *html.Node, own bool) string {
+	var b strings.Builder
+	var walk func(*html.Node)
+	walk = func(x *html.Node) {
+		for c := x.FirstChild; c != nil; c = c.NextSibling {
+			if c.Type == html.TextNode {
+				b.WriteString(c.Data)
+			} else if c.Type == html.ElementNode && !own {
+				walk(c)
+			}
+		}
+	}
+	walk(el)
+	return b.String()
+}
+
+// langOf returns the language of an element: its nearest lang attribute.
+func langOf(el *html.Node) (string, bool) {
+	for p := el; p != nil && p.Type == html.ElementNode; p = p.Parent {
+		if v, ok := attrOf(p, "lang"); ok {
+			return v, true
+		}
+	}
+	return "", false
+}
+
+func isFormControl(tag string) bool {
+	switch tag {
+	case "button", "input", "select", "textarea", "fieldset":
+		return true
+	}
+	return false
+}
+
+// actuallyDisabled follows the HTML specification.
+func actuallyDisabled(el *html.Node) bool {
+	switch el.Data {
+	case "button", "input", "select", "textarea", "fieldset", "optgroup", "option":
+	default:
+		return false
+	}
+	if hasAttrOf(el, "disabled") {
+		return true
+	}
+	if el.Data == "option" {
+		p := parentElement(el)
+		return p != nil && p.Data == "optgroup" && hasAttrOf(p, "disabled")
+	}
+	if el.Data == "optgroup" || (el.Data == "fieldset" && Known.nestedFieldsetEnabled) {
+		return false
+	}
+	// A descendant of a disabled fieldset, unless inside its first legend.
+	child := el
+	for p := parentElement(el); p != nil; child, p = p, parentElement(p) {
+		if p.Data == "fieldset" && hasAttrOf(p, "disabled") {
+			inFirstLegend := false
+			for _, c := range elementChildren(p) {
+				if c.Data == "legend" {
+					inFirstLegend = c == child
+					break
+				}
+			}
+			if !inFirstLegend {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func modelSimple(s simple, el *html.Node) bool {
+	switch s.kind {
+	case "scope":
+		return el == s.node
+	case "id":
+		v, ok := attrOf(el, "id")
+		return ok && v == s.name
+	case "class":
+		return modelAttr(simple{name: "class", op: "~=", val: s.name}, el)
+	case "attr":
+		return modelAttr(s, el)
+	}
+	switch s.name {
+	case "not":
+		return !modelGroup(s.group, el)
+	case "has", "haschild":
+		for _, rel := range s.rels {
+			comb := rel.comb
+			if comb == 0 {
+				comb = ' '
+				if s.name == "haschild" {
+					comb = '>'
+				}
+			}
+			if modelRelative(comb, rel.sel, el) {
+				return true
+			}
+		}
+		return false
+	case "nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type":
+		idx, ok := position(el, strings.Contains(s.name, "of-type"), strings.Contains(s.name, "last"))
+		return ok && matchesAnB(s.a, s.b, idx)
+	case "first-child", "first-of-type":
+		idx, ok := position(el, s.name == "first-of-type", false)
+		return ok && idx == 1
+	case "last-child", "last-of-type":
+		idx, ok := position(el, s.name == "last-of-type", true)
+		return ok && idx == 1
+	case "only-child", "only-of-type":
+		i1, ok := position(el, s.name == "only-of-type", false)
+		i2, _ := position(el, s.name == "only-of-type", true)
+		return ok && i1 == 1 && i2 == 1
+	case "empty":
+		for c := el.FirstChild; c != nil; c = c.NextSibling {
+			if c.Type == html.ElementNode {
+				return false
+			}
+			if c.Type == html.TextNode && strings.Trim(c.Data, cssSpace) != "" {
+				return false
+			}
+		}
+		return true
+	case "root":
+		return el.Parent != nil && el.Parent.Type == html.DocumentNode
+	case "link":
+		return (el.Data == "a" || el.Data == "area") && hasAttrOf(el, "href")
+	case "enabled":
+		switch el.Data {
+		case "button", "input", "select", "textarea", "fieldset", "optgroup", "option":
+			return !actuallyDisabled(el)
+		case "a", "area", "link":
+			return Known.linksAreEnabled && hasAttrOf(el, "href")
+		}
+		return false
+	case "disabled":
+		return actuallyDisabled(el)
+	case "checked":
+		switch el.Data {
+		case "input":
+			t, _ := attrOf(el, "type")
+			t = asciiLower(t)
+			return hasAttrOf(el, "checked") && (t == "checkbox" || t == "radio")
+		case "option":
+			return hasAttrOf(el, "selected")
+		}
+		return false
+	case "lang":
+		l, ok := langOf(el)
+		if !ok {
+			return false
+		}
+		l = asciiLower(l)
+		return l == s.val || strings.HasPrefix(l, s.val+"-")
+	case "input":
+		return el.Data == "input" || el.Data == "select" || el.Data == "textarea" || el.Data == "button"
+	case "contains", "containsown":
+		return strings.Contains(strings.ToLower(textOf(el, s.name == "containsown")), strings.ToLower(s.val))
+	case "matches", "matchesown":
+		return regexp.MustCompile(s.rx).MatchString(textOf(el, s.name == "matchesown"))
+	case "hover", "visited", "active", "focus", "target":
+		return false
+	}
+	panic("pseudo-class " + s.name)
+}
+
+// modelRelative anchors the relative selector at el (the :scope) and looks
+// for an element matching it: the anchored complex selector is the scope
+// compound, the combinator and sel.
+func modelRelative(comb byte, sel complex, el *html.Node) bool {
+	anchored := complex{
+		parts: append([]compound{{simples: []simple{{kind: "scope", node: el}}}}, sel.parts...),
+		combs: append([]byte{comb}, sel.combs...),
+	}
+	var candidates []*html.Node
+	switch comb {
+	case ' ', '>':
+		var walk func(*html.Node)
+		walk = func(x *html.Node) {
+			for c := x.FirstChild; c != nil; c = c.NextSibling {
+				if c.Type == html.ElementNode {
+					candidates = append(candidates, c)
+					walk(c)
+				}
+			}
+		}
+		walk(el)
+	case '+', '~':
+		for nx := nextElement(el); nx != nil; nx = nextElement(nx) {
+			candidates = append(candidates, nx)
+			var walk func(*html.Node)
+			walk = func(x *html.Node) {
+				for c := x.FirstChild; c != nil; c = c.NextSibling {
+					if c.Type == html.ElementNode {
+						candidates = append(candidates, c)
+						walk(c)
+					}
+				}
+			}
+			walk(nx)
+		}
+	default:
+		panic("relative combinator")
+	}
+	for _, c := range candidates {
+		if modelComplex(anchored, c) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Specificity.
+
+type spec [3]int
+
+func (s spec) add(o spec) spec { return spec{s[0] + o[0], s[1] + o[1], s[2] + o[2]} }
+
+func (s spec) less(o spec) bool {
+	for i := range s {
+		if s[i] != o[i] {
+			return s[i] < o[i]
+		}
+	}
+	return false
+}
+
+func specComplex(c complex) spec {
+	var out spec
+	for _, p := range c.parts {
+		out = out.add(specCompound(p))
+	}
+	return out
+}
+
+func specCompound(c compound) spec {
+	var out spec
+	if c.tag != "" && c.tag != "*" {
+		out = out.add(spec{0, 0, 1})
+	}
+	for _, s := range c.simples {
+		out = out.add(specSimple(s))
+	}
+	if c.pseudoElement != "" {
+		out = out.add(spec{0, 0, 1})
+	}
+	return out
+}
+
+func specSimple(s simple) spec {
+	switch s.kind {
+	case "id":
+		return spec{1, 0, 0}
+	case "class", "attr":
+		return spec{0, 1, 0}
+	}
+	switch s.name {
+	case "not":
+		var max spec
+		for _, c := range s.group {
+			if sp := specComplex(c); max.less(sp) {
+				max = sp
+			}
+		}
+		return max
+	case "has", "haschild":
+		var max spec
+		for _, r := range s.rels {
+			if sp := specComplex(r.sel); max.less(sp) {
+				max = sp
+			}
+		}
+		return max
+	case "hover", "visited", "active", "focus", "target":
+		if Known.neverMatchSpecificity {
+			return spec{}
+		}
+	}
+	return spec{0, 1, 0}
+}
+
+// roundTrippable reports whether String() can be expected to reproduce the
+// selector while the serialisation bugs are open.
+func roundTrippable(g group) bool {
+	ok := true
+	var visitGroup func(group)
+	var visitComplex func(complex)
+	visitComplex = func(c complex) {
+		for _, p := range c.parts {
+			for _, s := range p.simples {
+				switch s.kind {
+				case "attr":
+					if Known.stringUnescaped && s.op != "" && s.op != "#=" && strings.ContainsAny(s.val, "\"\\") {
+						ok = false
+					}
+				case "class", "id":
+					rs := []rune(s.name)
+					if Known.leadingDigitUnescaped && (isDigit(rs[0]) || (len(rs) > 1 && rs[0] == '-' && isDigit(rs[1]))) {
+						ok = false
+					}
+				}
+				if s.kind == "pseudo" {
+					switch s.name {
+					case "contains", "containsown":
+						if Known.stringUnescaped && strings.ContainsAny(s.val, "\"\\") {
+							ok = false
+						}
+					case "not":
+						visitGroup(s.group)
+					case "has", "haschild":
+						for _, r := range s.rels {
+							visitComplex(r.sel)
+						}
+					}
+				}
+			}
+		}
+	}
+	visitGroup = func(g group) {
+		for _, c := range g {
+			visitComplex(c)
+		}
+	}
+	visitGroup(g)
+	return ok
+}
+
+// genRoundTrippable draws selectors until one is roundTrippable.
+func genRoundTrippable(tc hegel.TestCase, ext bool) group {
+	for i := 0; i < 8; i++ {
+		g := genGroup(tc, ext, 0)
+		if roundTrippable(g) {
+			return g
+		}
+	}
+	return group{{parts: []compound{{tag: "div"}}}}
+}
