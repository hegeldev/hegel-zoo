+// The matcher returns one of its supported tags (index and tag agree), with
+// the desired tag's -u extension carried over, and an exact desired tag wins.
+func TestHegelMatcherReturnsASupportedTag(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		supported := make([]language.Tag, k)
+		for i := range supported {
+			supported[i] = language.MustParse(pick(ht, "en", "en-US", "en-GB", "de", "de-CH", "fr", "es-419", "es-MX", "pt-BR", "zh-Hans", "zh-Hant", "sr-Latn", "und"))
+		}
+		m := language.NewMatcher(supported)
+		want := drawTag(ht)
+		want.variants = nil
+		want.attrs = nil
+		desired, err := language.Parse(want.String())
+		if err != nil {
+			fail(ht, "Parse(%q): %v", want.String(), err)
+		}
+		tag, idx, conf := m.Match(desired)
+		if idx < 0 || idx >= k {
+			fail(ht, "Match(%v) among %v: index %d", desired, supported, idx)
+		}
+		b1, s1, _ := tag.Raw()
+		b2, s2, _ := supported[idx].Raw()
+		if b1 != b2 || (s1 != s2 && s2.String() != "Zzzz") {
+			fail(ht, "Match(%v) among %v = %v, index %d (%v), %v", desired, supported, tag, idx, supported[idx], conf)
+		}
+		for key, v := range want.uext {
+			if got := tag.TypeForKey(key); got != v {
+				if key == "rg" && Known.MatchOverwritesRg {
+					count(ht, "known x-text/19")
+					return
+				}
+				if conf == language.No {
+					count(ht, "no-match-extension")
+					return
+				}
+				fail(ht, "Match(%v) = %v: TypeForKey(%q) = %q, the desired tag had %q", desired, tag, key, got, v)
+			}
+		}
+		for i, s := range supported {
+			if s.String() == desired.String() && conf != language.Exact {
+				fail(ht, "Match(%v) among %v: supported[%d] is the desired tag but confidence is %v (index %d)", desired, supported, i, conf, idx)
+			}
+		}
+		// MatchStrings falls back to the default when nothing matched.
+		if t2, i2 := language.MatchStrings(m, desired.String()); conf != language.No && (i2 != idx || t2.String() != tag.String()) {
+			fail(ht, "MatchStrings(%q) = %v, %d but Match = %v, %d", desired.String(), t2, i2, tag, idx)
+		}
+	})
+}
