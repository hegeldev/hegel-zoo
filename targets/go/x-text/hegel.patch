+					fail(ht, "ParseBase(%q.ISO3() = %q) = %v, %v", b, b.ISO3(), pb, err)
+				}
+			}
+		}
+		if p.script != "" {
+			if ps, err := language.ParseScript(p.script); err != nil || ps != sc {
+				fail(ht, "ParseScript(%q) = %v, %v; Raw gives %v", p.script, ps, err, sc)
+			}
+			if s2, conf := tag.Script(); s2 != sc || conf != language.Exact {
+				fail(ht, "%v.Script() = %v, %v with an explicit script", tag, s2, conf)
+			}
+		}
+		if p.region != "" {
+			if pr, err := language.ParseRegion(p.region); err != nil || pr != r {
+				fail(ht, "ParseRegion(%q) = %v, %v; Raw gives %v", p.region, pr, err, r)
+			}
+			if r2, conf := tag.Region(); r2 != r || conf != language.Exact {
+				fail(ht, "%v.Region() = %v, %v with an explicit region", tag, r2, conf)
+			}
+			if m := r.M49(); m != 0 {
+				if er, err := language.EncodeM49(m); err != nil || er != r {
+					count(ht, "m49-alias")
+				}
+			}
+		}
+		// Parent chains end at und.
+		for i, x := 0, tag; ; i++ {
+			if x.IsRoot() {
+				break
+			}
+			if i > 10 {
+				fail(ht, "%v: Parent chain does not reach und", tag)
+			}
+			x = x.Parent()
+		}
+	})
+}
+
+type opt struct {
+	name string
+	o    collate.Option
+}
+
+var (
+	collatorOpts    = []opt{{"IgnoreCase", collate.IgnoreCase}, {"IgnoreDiacritics", collate.IgnoreDiacritics}, {"Numeric", collate.Numeric}, {"Loose", collate.Loose}, {"IgnoreWidth", collate.IgnoreWidth}, {"Force", collate.Force}}
+	collatorLocales = []string{"und", "en", "de", "fr", "da", "sv", "es", "tr", "ja", "zh", "de-u-co-phonebk", "fr-u-kb-true", "und-u-ka-shifted", "und-u-ks-identic", "fr-u-kb"}
+	collAlphabet    = []rune{'a', 'b', 'A', 'B', 'z', 'Z', 0x00E9, 0x00E8, 0x00C5, 0x00E5, 0x00F6, 0x00DF, 0x0131, 0x0130, 'i', 'I', ' ', '-', '1', '2', '0', '9', 0x0661, 0xFF11, 0xFF41, 0x30AB, 0xFF76, 0x3042, 0x4E00, 0x0301, 0x0300, 0x00E6, 'x', 'y'}
+)
+
+// collatorCase: the locale (by index), a coin per option (heads one time in
+// five) and two to six words of up to five letters of the alphabet.
+type collatorCase struct {
+	loc   int
+	flags []bool
+	strs  []string
+}
+
+// chosen are the options whose coin came up heads.
+func (c collatorCase) chosen() []opt {
+	var os []opt
+	for i, o := range collatorOpts {
+		if c.flags[i] {
+			os = append(os, o)
+		}
+	}
+	return os
+}
+
+// desc names the locale and the options.
+func (c collatorCase) desc() string {
+	d := collatorLocales[c.loc]
+	for _, o := range c.chosen() {
+		d += "+" + o.name
+	}
+	return d
+}
+
+func (c collatorCase) GoString() string { return c.desc() + ": " + show(strings.Join(c.strs, "|")) }
+
+var collatorCases = hegel.Composite(func(tc hegel.TestCase) collatorCase {
+	return collatorCase{
+		loc:   hegel.Draw(tc, hegel.Integers(0, len(collatorLocales)-1)),
+		flags: hegel.Draw(tc, fixed(chance(20), len(collatorOpts))),
+		strs:  hegel.Draw(tc, many(alphabet(collAlphabet, 0, 5), 2, 6)),
+	}
+})
+
+// Collators are total preorders whose keys order like Compare, in every
+// locale and option combination.
+func TestHegelCollatorIsATotalPreorder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, collatorCases)
+		loc := collatorLocales[cs.loc]
+		chosen := cs.chosen()
+		var os []collate.Option
+		for _, o := range chosen {
+			os = append(os, o.o)
+		}
+		desc := cs.desc()
+		c := collate.New(language.MustParse(loc), os...)
+		strs := cs.strs
+		var buf collate.Buffer
+		keys := make([][]byte, len(strs))
+		for i, s := range strs {
+			keys[i] = append([]byte{}, c.KeyFromString(&buf, s)...)
+			if k2 := c.Key(&buf, []byte(s)); !bytes.Equal(k2, keys[i]) {
+				fail(ht, "%s: Key and KeyFromString differ on %s", desc, show(s))
+			}
+		}
+		shifted, force := strings.Contains(loc, "ka-shifted"), strings.Contains(loc, "ks-identic")
+		if has(chosen, "Force") {
+			force = true
+		}
+		// Known bugs seen in this case, tallied once each.
+		keysOff, shiftedEqual := false, false
+		for i, a := range strs {
+			if c.CompareString(a, a) != 0 {
+				fail(ht, "%s: Compare(%s, %s) != 0", desc, show(a), show(a))
+			}
+			for j, b := range strs {
+				cmp := c.CompareString(a, b)
+				if cmp != c.Compare([]byte(a), []byte(b)) {
+					fail(ht, "%s: Compare and CompareString differ on %s, %s", desc, show(a), show(b))
+				}
+				if cmp != -c.CompareString(b, a) {
+					fail(ht, "%s: Compare(%s, %s) = %d but Compare(b, a) = %d", desc, show(a), show(b), cmp, c.CompareString(b, a))
+				}
+				if kc := bytes.Compare(keys[i], keys[j]); sign(kc) != sign(cmp) && !keysOff {
+					switch {
+					case Known.ShiftedCompare && shifted:
+						count(ht, "known x-text/8")
+						keysOff = true
+					case Known.ForceNotInKey && force:
+						count(ht, "known x-text/10")
+						keysOff = true
+					default:
+						fail(ht, "%s: Compare(%s, %s) = %d but the keys compare %d (%x vs %x)", desc, show(a), show(b), cmp, kc, keys[i], keys[j])
+					}
+				}
+				if shifted && a != b && cmp == 0 && Known.ShiftedCompare && strings.Trim(a, " -") == a && strings.Trim(b, " -") == b {
+					// Letters must still order under ka=shifted.
+					plain := collate.New(language.MustParse(strings.Replace(loc, "-u-ka-shifted", "", 1)), os...)
+					if plain.CompareString(a, b) != 0 {
+						shiftedEqual = true
+					}
+				}
+			}
+		}
+		if shiftedEqual {
+			count(ht, "known x-text/8")
+		}
+		// Transitivity on the triples.
+		for _, a := range strs {
+			for _, b := range strs {
+				for _, d := range strs {
+					if c.CompareString(a, b) <= 0 && c.CompareString(b, d) <= 0 && c.CompareString(a, d) > 0 {
+						fail(ht, "%s: %s <= %s <= %s but Compare(a, d) > 0", desc, show(a), show(b), show(d))
+					}
+				}
+			}
+		}
+		// Sort agrees with Compare.
+		sorted := append([]string{}, strs...)
+		c.SortStrings(sorted)
+		for i := 1; i < len(sorted); i++ {
+			if c.CompareString(sorted[i-1], sorted[i]) > 0 {
+				if Known.ForceNotInKey && force {
+					count(ht, "known x-text/10")
+					break
+				}
+				fail(ht, "%s: SortStrings gives %v but Compare(%s, %s) > 0", desc, sorted, show(sorted[i-1]), show(sorted[i]))
+			}
+		}
+		// Documented equivalences (Force and ks-identic distinguish the
+		// spellings again, as documented).
+		for _, o := range chosen {
+			if force {
+				break
+			}
+			switch o.name {
+			case "IgnoreCase":
+				if !shifted && c.CompareString("a", "A") != 0 {
+					fail(ht, "%s: IgnoreCase but Compare(a, A) = %d", desc, c.CompareString("a", "A"))
+				}
+			case "IgnoreDiacritics":
+				if !shifted && c.CompareString("e", "\u00e9") != 0 {
+					// Bug 24: the marks keep their tertiary weights unless
+					// case is ignored too.
+					if Known.IgnoreDiacriticsTertiary && !has(chosen, "IgnoreCase") && !has(chosen, "Loose") {
+						count(ht, "known x-text/24")
+					} else {
+						fail(ht, "%s: IgnoreDiacritics but Compare(e, e-acute) = %d", desc, c.CompareString("e", "\u00e9"))
+					}
+				}
+			case "IgnoreWidth":
+				if !shifted && c.CompareString("a", "\uff41") != 0 {
+					if Known.IgnoreWidthNoop {
+						count(ht, "known x-text/9")
+					} else {
+						fail(ht, "%s: IgnoreWidth but Compare(a, fullwidth a) = %d", desc, c.CompareString("a", "\uff41"))
+					}
+				}
+			case "Numeric":
+				if !shifted && c.CompareString("2", "12") >= 0 {
+					fail(ht, "%s: Numeric but Compare(2, 12) = %d", desc, c.CompareString("2", "12"))
+				}
+			}
+		}
+		if loc == "fr-u-kb" && c.CompareString("c\u00f4te", "cot\u00e9") != collate.New(language.MustParse("fr-u-kb-true")).CompareString("c\u00f4te", "cot\u00e9") {
+			if Known.BoolKeyWithoutType {
+				count(ht, "known x-text/11")
+			} else {
+				fail(ht, "fr-u-kb and fr-u-kb-true order cote/cote differently")
+			}
+		}
+	})
+}
+
+func has(opts []opt, name string) bool {
+	for _, o := range opts {
+		if o.name == name {
+			return true
+		}
+	}
+	return false
+}
+
+func sign(x int) int {
+	switch {
+	case x < 0:
+		return -1
+	case x > 0:
+		return 1
+	}
+	return 0
+}
+
+var (
+	searchOpts = []struct {
+		name string
+		o    search.Option
+	}{{"IgnoreCase", search.IgnoreCase}, {"IgnoreDiacritics", search.IgnoreDiacritics}, {"IgnoreWidth", search.IgnoreWidth}, {"Loose", search.Loose}}
+	searchLocales  = []string{"und", "en", "da", "de", "tr"}
+	searchAlphabet = []rune{'a', 'b', 'A', 'B', 0x00E9, 'e', 0x0301, 0x00E5, 'x', ' ', 0xFF41, 0x30AB, 0xFF76, '1', 0xFF11}
+)
+
+// patSpec is the pattern searched for: a word of the alphabet (empty one
+// time in fifty, the case Equal is known to get wrong), or (half of the
+// time, when the text is not empty) a non-empty rune-aligned substring of
+// the text, at a position and of a length taken modulo what fits.
+type patSpec struct {
+	sub      bool
+	at, span int
+	word     string
+}
+
+func (p patSpec) of(text string) string {
+	rs := []rune(text)
+	if !p.sub || len(rs) == 0 {
+		return p.word
+	}
+	i := p.at % len(rs)
+	j := i + 1 + p.span%(len(rs)-i)
+	return string(rs[i:j])
+}
+
+var patSpecs = hegel.Composite(func(tc hegel.TestCase) patSpec {
+	return patSpec{
+		sub:  hegel.Draw(tc, chance(50)),
+		at:   hegel.Draw(tc, positions),
+		span: hegel.Draw(tc, positions),
+		word: hegel.Draw(tc, weighted(choice[string]{2, lit("")}, choice[string]{98, alphabet(searchAlphabet, 1, 3)})),
+	}
+})
+
+// searchCase: the locale (by index), a coin per option (heads one time in
+// four), the text and the pattern.
+type searchCase struct {
+	loc   int
+	flags []bool
+	text  string
+	pat   patSpec
+}
+
+// desc names the locale and the options.
+func (c searchCase) desc() string {
+	d := searchLocales[c.loc]
+	for i, o := range searchOpts {
+		if c.flags[i] {
+			d += "+" + o.name
+		}
+	}
+	return d
+}
+
+func (c searchCase) GoString() string {
+	return fmt.Sprintf("%s: %s in %s", c.desc(), show(c.pat.of(c.text)), show(c.text))
+}
+
+var searchCases = hegel.Composite(func(tc hegel.TestCase) searchCase {
+	return searchCase{
+		loc:   hegel.Draw(tc, hegel.Integers(0, len(searchLocales)-1)),
+		flags: hegel.Draw(tc, fixed(chance(25), len(searchOpts))),
+		text:  hegel.Draw(tc, alphabet(searchAlphabet, 0, 8)),
+		pat:   hegel.Draw(tc, patSpecs),
+	}
+})
+
+// A search hit is a rune-aligned span the matcher itself considers equal to
+// the pattern; a pattern always matches itself; Equal is reflexive.
+func TestHegelSearchHitsAreEqualToThePattern(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, searchCases)
+		loc := searchLocales[c.loc]
+		var os []search.Option
+		for i, o := range searchOpts {
+			if c.flags[i] {
+				os = append(os, o.o)
+			}
+		}
+		desc := c.desc()
+		m := search.New(language.MustParse(loc), os...)
+		text := c.text
+		pat := c.pat.of(text)
+		start, end := m.IndexString(text, pat)
+		if s2, e2 := m.Index([]byte(text), []byte(pat)); s2 != start || e2 != end {
+			fail(ht, "%s: Index and IndexString differ on %s in %s", desc, show(pat), show(text))
+		}
+		if start >= 0 {
+			if end < start || end > len(text) || !utf8.RuneStart(text[start]) && start < len(text) || end < len(text) && !utf8.RuneStart(text[end]) {
+				fail(ht, "%s: IndexString(%s, %s) = %d, %d is not a rune-aligned span", desc, show(text), show(pat), start, end)
+			}
+			if !m.EqualString(text[start:end], pat) {
+				fail(ht, "%s: IndexString(%s, %s) = %d, %d but Equal(%s, pattern) is false", desc, show(text), show(pat), start, end, show(text[start:end]))
+			}
+		}
+		const acute = "\u0301"
+		selfEqual := m.EqualString(pat, pat)
+		missed := strings.Contains(text, pat) && start < 0
+		if (!selfEqual || missed) && Known.SearchEqualEmptyMarks && (pat == "" || strings.Trim(pat, acute) == "") {
+			count(ht, "known x-text/14")
+			return
+		}
+		if !selfEqual {
+			fail(ht, "%s: Equal(%s, %s) is false", desc, show(pat), show(pat))
+		}
+		if missed {
+			switch {
+			case loc == "da" && (strings.Contains(strings.ToLower(text), "aa") || strings.Contains(strings.ToLower(text), "\u00e5")):
+				// Danish collates aa (in any case) as one letter, \u00e5.
+				count(ht, "danish-contraction")
+			case strings.HasPrefix(pat, acute) || strings.HasPrefix(text[strings.Index(text, pat)+len(pat):], acute):
+				count(ht, "mark-split")
+			default:
+				fail(ht, "%s: %s is a substring of %s but IndexString = -1", desc, show(pat), show(text))
+			}
+		}
+	})
+}
+
+var supportedPool = []string{"en", "en-US", "en-GB", "de", "de-CH", "fr", "es-419", "es-MX", "pt-BR", "zh-Hans", "zh-Hant", "sr-Latn", "und"}
+
+// matcherCase: one to four supported tags and the desired tag's parts
+// (without variants and attributes).
+type matcherCase struct {
+	supported []string
+	want      tagParts
+}
+
+func (c matcherCase) GoString() string { return fmt.Sprintf("%v among %v", c.want, c.supported) }
+
+var matcherCases = hegel.Composite(func(tc hegel.TestCase) matcherCase {
+	return matcherCase{
+		supported: hegel.Draw(tc, many(hegel.SampledFrom(supportedPool), 1, 4)),
+		want:      hegel.Draw(tc, tagPartsOf(false)),
+	}
+})
+
+// The matcher returns one of its supported tags (index and tag agree), with
+// the desired tag's -u extension carried over, and an exact desired tag wins.
+func TestHegelMatcherReturnsASupportedTag(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, matcherCases)
+		k := len(c.supported)
+		supported := make([]language.Tag, k)
+		for i, s := range c.supported {
+			supported[i] = language.MustParse(s)
+		}
+		m := language.NewMatcher(supported)
+		want := c.want
+		desired, err := language.Parse(want.String())
+		if err != nil {
+			fail(ht, "Parse(%q): %v", want.String(), err)
+		}
+		tag, idx, conf := m.Match(desired)
+		if idx < 0 || idx >= k {
+			fail(ht, "Match(%v) among %v: index %d", desired, supported, idx)
+		}
+		b1, s1, _ := tag.Raw()
+		b2, s2, _ := supported[idx].Raw()
+		if b1 != b2 || (s1 != s2 && s2.String() != "Zzzz") {
+			fail(ht, "Match(%v) among %v = %v, index %d (%v), %v", desired, supported, tag, idx, supported[idx], conf)
+		}
+		for key, v := range want.uext {
+			if got := tag.TypeForKey(key); got != v {
+				switch {
+				case key == "rg" && Known.MatchOverwritesRg:
+					count(ht, "known x-text/19")
+				case v == "true" && got == "" && Known.BoolKeyWithoutType:
+					// Bug 11: a boolean key without a type has no type either.
+					count(ht, "known x-text/11")
+				case conf == language.No:
+					count(ht, "no-match-extension")
+				default:
+					fail(ht, "Match(%v) = %v: TypeForKey(%q) = %q, the desired tag had %q", desired, tag, key, got, v)
+				}
+			}
+		}
+		for i, s := range supported {
+			if s.String() == desired.String() && conf != language.Exact {
+				fail(ht, "Match(%v) among %v: supported[%d] is the desired tag but confidence is %v (index %d)", desired, supported, i, conf, idx)
+			}
+		}
+		// MatchStrings falls back to the default when nothing matched.
+		if t2, i2 := language.MatchStrings(m, desired.String()); conf != language.No && (i2 != idx || t2.String() != tag.String()) {
+			fail(ht, "MatchStrings(%q) = %v, %d but Match = %v, %d", desired.String(), t2, i2, tag, idx)
+		}
+	})
+}
+
+var (
+	currencyUnits = func() []currency.Unit {
+		var units []currency.Unit
+		for it := currency.Query(currency.Historical, currency.NonTender); it.Next(); {
+			units = append(units, it.Unit())
+		}
+		return units
+	}()
+	currencyRegions = []string{"US", "GB", "DE", "CH", "JP", "BR", "IN", "ZZ", "001", "XK", "ZW"}
+	rgOverrides     = []string{"gbzzzz", "dezzzz", "jpzzzz"}
+)
+
+// currencyCase: the unit, whether ParseISO gets its code in lower case, a
+// region, and an rg override for the region's tag half of the time.
+type currencyCase struct {
+	u      currency.Unit
+	lower  bool
+	region string
+	rg     string
+}
+
+func (c currencyCase) GoString() string {
+	return fmt.Sprintf("%v (lower case %v), region %s, rg %q", c.u, c.lower, c.region, c.rg)
+}
+
+var currencyCases = hegel.Composite(func(tc hegel.TestCase) currencyCase {
+	return currencyCase{
+		u:      hegel.Draw(tc, hegel.SampledFrom(currencyUnits)),
+		lower:  hegel.Draw(tc, chance(50)),
+		region: hegel.Draw(tc, hegel.SampledFrom(currencyRegions)),
+		rg:     hegel.Draw(tc, maybe(50, hegel.SampledFrom(rgOverrides))),
+	}
+})
+
+// Currency units round-trip through their ISO code, FromRegion agrees with
+// the Query, and FromTag follows the region.
+func TestHegelCurrencyUnitsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, currencyCases)
+		u := c.u
+		code := u.String()
+		if len(code) != 3 {
+			fail(ht, "currency %v has code %q", u, code)
+		}
+		// Units compare by table index and the query may yield a unit under
+		// another index than ParseISO; compare the codes.
+		spelled := code
+		if c.lower {
+			spelled = strings.ToLower(code)
+		}
+		back, err := currency.ParseISO(spelled)
+		if err != nil || back.String() != code {
+			fail(ht, "ParseISO(%q) = %v, %v", spelled, back, err)
+		}
+		for _, k := range []currency.Kind{currency.Standard, currency.Cash, currency.Accounting} {
+			scale, inc := k.Rounding(u)
+			if scale < 0 || scale > 4 || inc < 1 {
+				fail(ht, "%v rounding of %v: scale %d increment %d", k, u, scale, inc)
+			}
+		}
+		region := c.region
+		r := language.MustParseRegion(region)
+		fr, ok := currency.FromRegion(r)
+		tag := language.MustParse("en-" + region)
+		ft, conf := currency.FromTag(tag)
+		if ok && (ft != fr || conf != language.Exact) {
+			fail(ht, "FromRegion(%s) = %v but FromTag(%v) = %v, %v", region, fr, tag, ft, conf)
+		}
+		if rg := c.rg; ok && rg != "" {
+			t2 := language.MustParse("en-" + region + "-u-rg-" + rg)
+			want, _ := currency.FromRegion(language.MustParseRegion(strings.ToUpper(rg[:2])))
+			if got, _ := currency.FromTag(t2); got != want {
+				if Known.CurrencyIgnoresRg {
+					count(ht, "known x-text/20")
+				} else {
+					fail(ht, "FromTag(%v) = %v, the rg override says %v", t2, got, want)
+				}
+			}
+		}
+	})
+}
