+// Collators are total preorders whose keys order like Compare, in every
+// locale and option combination.
+func TestHegelCollatorIsATotalPreorder(t *testing.T) {
+	opts := []opt{{"IgnoreCase", collate.IgnoreCase}, {"IgnoreDiacritics", collate.IgnoreDiacritics}, {"Numeric", collate.Numeric}, {"Loose", collate.Loose}, {"IgnoreWidth", collate.IgnoreWidth}, {"Force", collate.Force}}
+	locales := []string{"und", "en", "de", "fr", "da", "sv", "es", "tr", "ja", "zh", "de-u-co-phonebk", "fr-u-kb-true", "und-u-ka-shifted", "und-u-ks-identic", "fr-u-kb"}
+	alphabet := []rune{'a', 'b', 'A', 'B', 'z', 'Z', 0x00E9, 0x00E8, 0x00C5, 0x00E5, 0x00F6, 0x00DF, 0x0131, 0x0130, 'i', 'I', ' ', '-', '1', '2', '0', '9', 0x0661, 0xFF11, 0xFF41, 0x30AB, 0xFF76, 0x3042, 0x4E00, 0x0301, 0x0300, 0x00E6, 'x', 'y'}
+	property(t, func(ht *hegel.T) {
+		loc := pick(ht, locales...)
+		var chosen []opt
+		var os []collate.Option
+		for _, o := range opts {
+			if chance(ht, 20) {
+				chosen = append(chosen, o)
+				os = append(os, o.o)
+			}
+		}
+		desc := loc
+		for _, o := range chosen {
+			desc += "+" + o.name
+		}
+		c := collate.New(language.MustParse(loc), os...)
+		strs := make([]string, n(ht, 2, 6))
+		for i := range strs {
+			strs[i] = word(ht, alphabet, 0, 5)
+		}
+		var buf collate.Buffer
+		keys := make([][]byte, len(strs))
+		for i, s := range strs {
+			keys[i] = append([]byte{}, c.KeyFromString(&buf, s)...)
+			if k2 := c.Key(&buf, []byte(s)); !bytes.Equal(k2, keys[i]) {
+				fail(ht, "%s: Key and KeyFromString differ on %s", desc, show(s))
+			}
+		}
+		shifted, force := strings.Contains(loc, "ka-shifted"), strings.Contains(loc, "ks-identic")
+		for _, o := range chosen {
+			if o.name == "Force" {
+				force = true
+			}
+		}
+		for i, a := range strs {
+			if c.CompareString(a, a) != 0 {
+				fail(ht, "%s: Compare(%s, %s) != 0", desc, show(a), show(a))
+			}
+			for j, b := range strs {
+				cmp := c.CompareString(a, b)
+				if cmp != c.Compare([]byte(a), []byte(b)) {
+					fail(ht, "%s: Compare and CompareString differ on %s, %s", desc, show(a), show(b))
+				}
+				if cmp != -c.CompareString(b, a) {
+					fail(ht, "%s: Compare(%s, %s) = %d but Compare(b, a) = %d", desc, show(a), show(b), cmp, c.CompareString(b, a))
+				}
+				if kc := bytes.Compare(keys[i], keys[j]); sign(kc) != sign(cmp) {
+					if Known.ShiftedCompare && shifted {
+						count(ht, "known x-text/8")
+						return
+					}
+					if Known.ForceNotInKey && force {
+						count(ht, "known x-text/10")
+						return
+					}
+					fail(ht, "%s: Compare(%s, %s) = %d but the keys compare %d (%x vs %x)", desc, show(a), show(b), cmp, kc, keys[i], keys[j])
+				}
+				if shifted && a != b && cmp == 0 && Known.ShiftedCompare {
+					// Letters must still order under ka=shifted.
+					if strings.Trim(a, " -") != a || strings.Trim(b, " -") != b {
+						continue
+					}
+					plain := collate.New(language.MustParse(strings.Replace(loc, "-u-ka-shifted", "", 1)), os...)
+					if plain.CompareString(a, b) != 0 {
+						count(ht, "known x-text/8")
+						return
+					}
+				}
+			}
+		}
+		// Transitivity on the triples.
+		for _, a := range strs {
+			for _, b := range strs {
+				for _, d := range strs {
+					if c.CompareString(a, b) <= 0 && c.CompareString(b, d) <= 0 && c.CompareString(a, d) > 0 {
+						fail(ht, "%s: %s <= %s <= %s but Compare(a, d) > 0", desc, show(a), show(b), show(d))
+					}
+				}
+			}
+		}
+		// Sort agrees with Compare.
+		sorted := append([]string{}, strs...)
+		c.SortStrings(sorted)
+		for i := 1; i < len(sorted); i++ {
+			if c.CompareString(sorted[i-1], sorted[i]) > 0 {
+				if Known.ForceNotInKey && force {
+					count(ht, "known x-text/10")
+					return
+				}
+				fail(ht, "%s: SortStrings gives %v but Compare(%s, %s) > 0", desc, sorted, show(sorted[i-1]), show(sorted[i]))
+			}
+		}
+		// Documented equivalences (Force and ks-identic distinguish the
+		// spellings again, as documented).
+		for _, o := range chosen {
+			if force {
+				break
+			}
+			switch o.name {
+			case "IgnoreCase":
+				if !shifted && c.CompareString("a", "A") != 0 {
+					fail(ht, "%s: IgnoreCase but Compare(a, A) = %d", desc, c.CompareString("a", "A"))
+				}
+			case "IgnoreDiacritics":
+				if !shifted && c.CompareString("e", "é") != 0 {
+					// Bug 24: the marks keep their tertiary weights unless
+					// case is ignored too.
+					if Known.IgnoreDiacriticsTertiary && !has(chosen, "IgnoreCase") && !has(chosen, "Loose") {
+						count(ht, "known x-text/24")
+						return
+					}
+					fail(ht, "%s: IgnoreDiacritics but Compare(e, e-acute) = %d", desc, c.CompareString("e", "é"))
+				}
+			case "IgnoreWidth":
+				if !shifted && c.CompareString("a", "ａ") != 0 {
+					if Known.IgnoreWidthNoop {
+						count(ht, "known x-text/9")
+						return
+					}
+					fail(ht, "%s: IgnoreWidth but Compare(a, fullwidth a) = %d", desc, c.CompareString("a", "ａ"))
+				}
+			case "Numeric":
+				if !shifted && c.CompareString("2", "12") >= 0 {
+					fail(ht, "%s: Numeric but Compare(2, 12) = %d", desc, c.CompareString("2", "12"))
+				}
+			}
+		}
+		if loc == "fr-u-kb" && c.CompareString("côte", "coté") != collate.New(language.MustParse("fr-u-kb-true")).CompareString("côte", "coté") {
+			if Known.BoolKeyWithoutType {
+				count(ht, "known x-text/11")
+				return
+			}
+			fail(ht, "fr-u-kb and fr-u-kb-true order cote/cote differently")
+		}
+	})
+}
+
+func has(opts []opt, name string) bool {
+	for _, o := range opts {
+		if o.name == name {
+			return true
+		}
+	}
+	return false
+}
+
+type opt struct {
+	name string
+	o    collate.Option
+}
+
+func sign(x int) int {
+	switch {
+	case x < 0:
+		return -1
+	case x > 0:
+		return 1
+	}
+	return 0
+}
+
+// word draws lo..hi runes from an alphabet.
+func word(tc hegel.TestCase, alphabet []rune, lo, hi int) string {
+	k := n(tc, lo, hi)
+	rs := make([]rune, k)
+	for i := range rs {
+		rs[i] = pick(tc, alphabet...)
+	}
+	return string(rs)
+}
+
+// A search hit is a rune-aligned span the matcher itself considers equal to
+// the pattern; a pattern always matches itself; Equal is reflexive.
+func TestHegelSearchHitsAreEqualToThePattern(t *testing.T) {
+	alphabet := []rune{'a', 'b', 'A', 'B', 0x00E9, 'e', 0x0301, 0x00E5, 'a', 'x', ' ', 0xFF41, 0x30AB, 0xFF76, '1', 0xFF11}
+	property(t, func(ht *hegel.T) {
+		loc := pick(ht, "und", "en", "da", "de", "tr")
+		var os []search.Option
+		desc := loc
+		for _, o := range []struct {
+			name string
+			o    search.Option
+		}{{"IgnoreCase", search.IgnoreCase}, {"IgnoreDiacritics", search.IgnoreDiacritics}, {"IgnoreWidth", search.IgnoreWidth}, {"Loose", search.Loose}} {
+			if chance(ht, 25) {
+				os = append(os, o.o)
+				desc += "+" + o.name
+			}
+		}
+		m := search.New(language.MustParse(loc), os...)
+		text := word(ht, alphabet, 0, 8)
+		var pat string
+		if chance(ht, 50) && len(text) > 0 {
+			// A substring of the text, on rune boundaries.
+			rs := []rune(text)
+			i := n(ht, 0, len(rs)-1)
+			j := n(ht, i, len(rs))
+			pat = string(rs[i:j])
+		} else {
+			pat = word(ht, alphabet, 0, 3)
+		}
+		start, end := m.IndexString(text, pat)
+		if s2, e2 := m.Index([]byte(text), []byte(pat)); s2 != start || e2 != end {
+			fail(ht, "%s: Index and IndexString differ on %s in %s", desc, show(pat), show(text))
+		}
+		if start >= 0 {
+			if end < start || end > len(text) || !utf8.RuneStart(text[start]) && start < len(text) || end < len(text) && !utf8.RuneStart(text[end]) {
+				fail(ht, "%s: IndexString(%s, %s) = %d, %d is not a rune-aligned span", desc, show(text), show(pat), start, end)
+			}
+			if !m.EqualString(text[start:end], pat) {
+				fail(ht, "%s: IndexString(%s, %s) = %d, %d but Equal(%s, pattern) is false", desc, show(text), show(pat), start, end, show(text[start:end]))
+			}
+		}
+		if !m.EqualString(pat, pat) {
+			if Known.SearchEqualEmptyMarks && (pat == "" || strings.Trim(pat, "́") == "") {
+				count(ht, "known x-text/14")
+				return
+			}
+			fail(ht, "%s: Equal(%s, %s) is false", desc, show(pat), show(pat))
+		}
+		if strings.Contains(text, pat) && start < 0 {
+			if Known.SearchEqualEmptyMarks && (pat == "" || strings.Trim(pat, "́") == "") {
+				count(ht, "known x-text/14")
+				return
+			}
+			if loc == "da" && (strings.Contains(text, "aa") || strings.Contains(text, "å")) {
+				count(ht, "danish-contraction")
+				return
+			}
+			if strings.HasPrefix(pat, "́") || strings.HasPrefix(text[strings.Index(text, pat)+len(pat):], "́") {
+				count(ht, "mark-split")
+				return
+			}
+			fail(ht, "%s: %s is a substring of %s but IndexString = -1", desc, show(pat), show(text))
+		}
+	})
+}
