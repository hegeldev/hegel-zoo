+
+var (
+	bases     = []string{"en", "de", "fr", "es", "pt", "zh", "ja", "ar", "he", "sr", "az", "nl", "da", "sv", "tr", "ru", "und", "hi", "kk", "nan", "cmn", "tlh"}
+	scripts   = []string{"Latn", "Cyrl", "Hans", "Hant", "Arab", "Hebr", "Deva", "Jpan", "Zzzz", "Qaaa"}
+	regions   = []string{"US", "GB", "DE", "FR", "CH", "AT", "BR", "PT", "CN", "TW", "419", "001", "150", "ZZ", "XA"}
+	variants  = []string{"1996", "1901", "nedis", "rozaj", "fonipa", "valencia", "1994", "biske"}
+	ukeys     = []string{"co", "ca", "nu", "cu", "rg", "va", "kb", "kn", "hc"}
+	utypes    = []string{"phonebk", "emoji", "gregory", "latn", "usd", "gbzzzz", "posix", "true", "h12", "arab"}
+	attrNames = []string{"abcd", "abce", "attr", "zzz", "aaa"}
+	privNames = []string{"priv", "foo", "a1"}
+)
+
+// tagParts are the pieces of a well-formed tag, so the property knows what
+// to expect of the parsed tag.
+type tagParts struct {
+	base, script, region string
+	variants             []string
+	uext                 map[string]string
+	attrs                []string
+	priv                 string
+}
+
+func (p tagParts) String() string {
+	var sb strings.Builder
+	sb.WriteString(p.base)
+	if p.script != "" {
+		sb.WriteString("-" + p.script)
+	}
+	if p.region != "" {
+		sb.WriteString("-" + p.region)
+	}
+	for _, v := range p.variants {
+		sb.WriteString("-" + v)
+	}
+	if len(p.uext) > 0 || len(p.attrs) > 0 {
+		sb.WriteString("-u")
+		for _, a := range p.attrs {
+			sb.WriteString("-" + a)
+		}
+		keys := make([]string, 0, len(p.uext))
+		for k := range p.uext {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			sb.WriteString("-" + k)
+			if p.uext[k] != "true" {
+				sb.WriteString("-" + p.uext[k])
+			}
+		}
+	}
+	if p.priv != "" {
+		sb.WriteString("-x-" + p.priv)
+	}
+	return sb.String()
+}
+
+func (p tagParts) GoString() string { return p.String() }
+
+// distinct drops the repeated strings, keeping the first occurrences in
+// order.
+func distinct(xs []string) []string {
+	var out []string
+	seen := map[string]bool{}
+	for _, x := range xs {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// uextOf folds key/type pairs into a -u extension (a later pair for a key
+// wins); "true" is a type of the boolean keys kb and kn only.
+func uextOf(ps []pair[string, string]) map[string]string {
+	m := map[string]string{}
+	for _, p := range ps {
+		k, v := p.a, p.b
+		if v == "true" && k != "kb" && k != "kn" {
+			v = "latn"
+		}
+		m[k] = v
+	}
+	return m
+}
+
+// tagPartsOf: a base; a script three times in ten; a region half of the
+// time; up to two distinct variants and an attribute one time in ten (when
+// full); a -u extension of one to three keys two times in five; a private
+// use subtag 15 times in a hundred.
+func tagPartsOf(full bool) hegel.Generator[tagParts] {
+	variantsGen := hegel.Just[[]string](nil)
+	attrsGen := hegel.Just[[]string](nil)
+	if full {
+		variantsGen = hegel.Map(many(hegel.SampledFrom(variants), 0, 2), distinct)
+		attrsGen = maybe(10, hegel.Map(hegel.SampledFrom(attrNames), func(a string) []string { return []string{a} }))
+	}
+	return hegel.Composite(func(tc hegel.TestCase) tagParts {
+		return tagParts{
+			base:     hegel.Draw(tc, hegel.SampledFrom(bases)),
+			script:   hegel.Draw(tc, maybe(30, hegel.SampledFrom(scripts))),
+			region:   hegel.Draw(tc, maybe(50, hegel.SampledFrom(regions))),
+			variants: hegel.Draw(tc, variantsGen),
+			uext:     hegel.Draw(tc, maybe(40, hegel.Map(many(pairs(hegel.SampledFrom(ukeys), hegel.SampledFrom(utypes)), 1, 3), uextOf))),
+			attrs:    hegel.Draw(tc, attrsGen),
+			priv:     hegel.Draw(tc, maybe(15, hegel.SampledFrom(privNames))),
+		}
+	})
+}
+
+// tagCase: the tag's parts, the key and type given to SetTypeForKey (each
+// upper-cased three times in ten) and another attribute to reorder with.
+type tagCase struct {
+	p                   tagParts
+	key, typ            string
+	upperKey, upperType bool
+	other               string
+}
+
+// setKey and setType are the key and type as SetTypeForKey gets them.
+func (c tagCase) setKey() string {
+	if c.upperKey {
+		return strings.ToUpper(c.key)
+	}
+	return c.key
+}
+
+func (c tagCase) setType() string {
+	if c.upperType {
+		return strings.ToUpper(c.typ)
+	}
+	return c.typ
+}
+
+func (c tagCase) GoString() string {
+	return fmt.Sprintf("%s; SetTypeForKey(%q, %q); other attribute %q", c.p, c.setKey(), c.setType(), c.other)
+}
+
+var tagCases = hegel.Composite(func(tc hegel.TestCase) tagCase {
+	return tagCase{
+		p:         hegel.Draw(tc, tagPartsOf(true)),
+		key:       hegel.Draw(tc, hegel.SampledFrom(ukeys)),
+		typ:       hegel.Draw(tc, hegel.SampledFrom(utypes)),
+		upperKey:  hegel.Draw(tc, chance(30)),
+		upperType: hegel.Draw(tc, chance(30)),
+		other:     hegel.Draw(tc, hegel.SampledFrom(attrNames)),
+	}
+})
+
+// Parsing a well-formed tag and printing it gives the tag back with its parts
+// intact; the -u extension survives SetTypeForKey/TypeForKey; the base, script
+// and region subtags parse on their own; EncodeM49 and ISO3 round-trip.
+func TestHegelLanguageTagsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, tagCases)
+		p := c.p
+		s := p.String()
+		tag, err := language.Parse(s)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", s, err)
+		}
+		// Tags holding a non-compact tag compare by pointer; compare strings.
+		back, err := language.Parse(tag.String())
+		if err != nil || back.String() != tag.String() {
+			fail(ht, "Parse(%q) = %v, Parse of its String %q = %v, %v", s, tag, tag.String(), back, err)
+		}
+		// Variants are kept (in canonical order, deduplicated) and so are the
+		// extensions.
+		var vs []string
+		for _, v := range tag.Variants() {
+			vs = append(vs, v.String())
+		}
+		sort.Strings(vs)
+		want := append([]string{}, p.variants...)
+		sort.Strings(want)
+		wantExt := 0
+		if len(p.uext) > 0 || len(p.attrs) > 0 {
+			wantExt++
+		}
+		if p.priv != "" {
+			wantExt++
+		}
+		extSwallowed := false
+		if strings.Join(vs, ",") != strings.Join(want, ",") || len(tag.Extensions()) != wantExt {
+			// Bug 6: variants that had to be reordered swallow the extension.
+			if Known.SortedVariantsExtension && len(p.variants) == 2 && wantExt > 0 {
+				count(ht, "known x-text/6")
+				extSwallowed = true
+			} else {
+				fail(ht, "Parse(%q): variants %v (expected %v), extensions %v", s, vs, want, tag.Extensions())
+			}
+		}
+		if !extSwallowed {
+			for k, v := range p.uext {
+				if got := tag.TypeForKey(k); got != v {
+					// Bug 11: a boolean key without a type has no type either.
+					if Known.BoolKeyWithoutType && v == "true" && got == "" {
+						count(ht, "known x-text/11")
+					} else {
+						fail(ht, "Parse(%q).TypeForKey(%q) = %q, expected %q", s, k, got, v)
+					}
+				}
+			}
+		}
+		// SetTypeForKey then TypeForKey, in any case (not on a tag bug 6
+		// corrupted: its String then has the singleton twice, `-u-u-co-...`,
+		// and is not well-formed).
+		if !extSwallowed {
+			k, v := c.setKey(), c.setType()
+			t2, err := tag.SetTypeForKey(k, v)
+			if err != nil {
+				fail(ht, "%v.SetTypeForKey(%q, %q): %v", tag, k, v, err)
+			}
+			lk, lv := strings.ToLower(k), strings.ToLower(v)
+			got := t2.TypeForKey(lk)
+			p2, err2 := language.Parse(t2.String())
+			if got != lv || err2 != nil || p2.String() != t2.String() {
+				if Known.SetTypeForKeyCase && (k != lk || v != lv) {
+					count(ht, "known x-text/16")
+				} else {
+					fail(ht, "%v.SetTypeForKey(%q, %q) = %v: TypeForKey(%q) = %q, its string parses to %v, %v", tag, k, v, t2, lk, got, p2, err2)
+				}
+			}
+		}
+		// Two attribute orders are one tag.
+		if len(p.attrs) == 1 && c.other != p.attrs[0] {
+			other := c.other
+			a := strings.Replace(s, "-u-"+p.attrs[0], "-u-"+p.attrs[0]+"-"+other, 1)
+			b := strings.Replace(s, "-u-"+p.attrs[0], "-u-"+other+"-"+p.attrs[0], 1)
+			ta, ea := language.Parse(a)
+			tb, eb := language.Parse(b)
+			if ea != nil || eb != nil || ta.String() != tb.String() {
+				if Known.AttributeSort3 && other[:3] == p.attrs[0][:3] {
+					count(ht, "known x-text/17")
+				} else {
+					fail(ht, "Parse(%q) = %v, %v but Parse(%q) = %v, %v", a, ta, ea, b, tb, eb)
+				}
+			}
+		}
+		// Subtags on their own.
+		b, sc, r := tag.Raw()
+		if p.base != "und" {
+			if pb, err := language.ParseBase(p.base); err != nil || pb != b {
+				count(ht, "base-canonicalised") // nan, cmn, tlh: Parse and ParseBase may canonicalise differently
+			}
