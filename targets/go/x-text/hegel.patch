+// ---------------------------------------------------------------------------
+// number
+
+// decimalValue is a number with its exact decimal expansion (sign, integer
+// digits, fraction digits without trailing zeros).
+type decimalValue struct {
+	v    interface{}
+	neg  bool
+	ip   string
+	fp   string
+	desc string
+}
+
+func drawDecimal(tc hegel.TestCase) decimalValue {
+	neg := chance(tc, 30)
+	var d decimalValue
+	switch n(tc, 1, 4) {
+	case 1:
+		k := int64(n(tc, 0, 2000000))
+		if chance(tc, 20) {
+			k = int64(n(tc, 0, 1000000000)) * int64(n(tc, 1, 1000000))
+		}
+		d.ip = fmt.Sprint(k)
+		if neg {
+			k = -k
+		}
+		d.v = k
+		d.desc = fmt.Sprint(k)
+	case 2:
+		k := n(tc, 0, 60000)
+		d.ip = fmt.Sprint(k)
+		if neg {
+			d.v = int32(-k)
+		} else {
+			d.v = uint16(k)
+		}
+		d.desc = fmt.Sprint(d.v)
+	default:
+		// k / 10^e, exactly representable as a decimal; the float64 is the
+		// nearest double, whose exact expansion %.80f gives.
+		k := n(tc, 0, 99999999)
+		e := n(tc, 0, 7)
+		f := float64(k)
+		for i := 0; i < e; i++ {
+			f /= 10
+		}
+		if chance(tc, 15) {
+			f = float64(n(tc, 1, 1000000)) / float64(n(tc, 1, 1000))
+		}
+		if neg {
+			f = -f
+		}
+		d.v = f
+		d.desc = fmt.Sprintf("%v", f)
+		s := fmt.Sprintf("%.80f", f)
+		s = strings.TrimPrefix(s, "-")
+		dot := strings.IndexByte(s, '.')
+		d.ip, d.fp = s[:dot], strings.TrimRight(s[dot+1:], "0")
+	}
+	d.ip = strings.TrimLeft(d.ip, "0")
+	if d.ip == "" {
+		d.ip = "0"
+	}
+	d.neg = neg && (d.ip != "0" || d.fp != "")
+	return d
+}
+
+// shift moves the decimal point k places to the right.
+func (d decimalValue) shift(k int) decimalValue {
+	for i := 0; i < k; i++ {
+		if d.fp == "" {
+			d.ip += "0"
+		} else {
+			d.ip += d.fp[:1]
+			d.fp = d.fp[1:]
+		}
+	}
+	d.ip = strings.TrimLeft(d.ip, "0")
+	if d.ip == "" {
+		d.ip = "0"
+	}
+	return d
+}
+
+// roundHalfEven rounds the fraction to at most maxFrac digits.
+func (d decimalValue) roundHalfEven(maxFrac int) decimalValue {
+	if len(d.fp) <= maxFrac {
+		return d
+	}
+	keep, rest := d.fp[:maxFrac], d.fp[maxFrac:]
+	digits := []byte(d.ip + keep)
+	up := false
+	switch {
+	case rest[0] > '5':
+		up = true
+	case rest[0] == '5' && strings.TrimRight(rest[1:], "0") != "":
+		up = true
+	case rest[0] == '5':
+		up = (digits[len(digits)-1]-'0')%2 == 1
+	}
+	if up {
+		i := len(digits) - 1
+		for ; i >= 0; i-- {
+			if digits[i] == '9' {
+				digits[i] = '0'
+			} else {
+				digits[i]++
+				break
+			}
+		}
+		if i < 0 {
+			digits = append([]byte{'1'}, digits...)
+		}
+	}
+	d.ip = string(digits[:len(digits)-maxFrac])
+	d.fp = strings.TrimRight(string(digits[len(digits)-maxFrac:]), "0")
+	d.ip = strings.TrimLeft(d.ip, "0")
+	if d.ip == "" {
+		d.ip = "0"
+	}
+	return d
+}
+
+// intDigits applies MaxIntegerDigits (keep the last max digits, then drop
+// the leading zeros that leaves) and MinIntegerDigits (pad with zeros).
+func intDigits(ip string, minInt, maxInt int) string {
+	if maxInt > 0 && len(ip) > maxInt {
+		ip = strings.TrimLeft(ip[len(ip)-maxInt:], "0")
+		if ip == "" {
+			ip = "0"
+		}
+	}
+	for len(ip) < minInt {
+		ip = "0" + ip
+	}
+	return ip
+}
+
+func group(ip string, primary, secondary int) string {
+	if primary == 0 || len(ip) <= primary {
+		return ip
+	}
+	out := ip[len(ip)-primary:]
+	rest := ip[:len(ip)-primary]
+	for len(rest) > secondary {
+		out = rest[len(rest)-secondary:] + "," + out
+		rest = rest[:len(rest)-secondary]
+	}
+	return rest + "," + out
+}
+
+// localeSymbols are the digits and separators of a locale, read from the
+// library once (the structure of the output is what the model checks).
+type localeSymbols struct {
+	tag       language.Tag
+	digits    [10]string
+	group     string
+	decimal   string
+	minus     string
+	secondary int
+}
+
+func readSymbols(t testing.TB, tag string, secondary int) localeSymbols {
+	ls := localeSymbols{tag: language.MustParse(tag), secondary: secondary}
+	p := message.NewPrinter(ls.tag)
+	s := p.Sprintf("%v", number.Decimal(1234567890, number.NoSeparator()))
+	rs := []rune(s)
+	if len(rs) != 10 {
+		t.Fatalf("%s: digits of 1234567890 are %+q", tag, s)
+	}
+	for i, r := range rs {
+		ls.digits[(i+1)%10] = string(r)
+	}
+	s = p.Sprintf("%v", number.Decimal(1234567))
+	i := strings.Index(s, ls.digits[4])
+	j := strings.Index(s, ls.digits[5])
+	if i < 0 || j <= i {
+		t.Fatalf("%s: 1234567 is %+q", tag, s)
+	}
+	ls.group = s[i+len(ls.digits[4]) : j]
+	s = p.Sprintf("%v", number.Decimal(1.5))
+	i = strings.Index(s, ls.digits[1])
+	j = strings.Index(s, ls.digits[5])
+	if i < 0 || j <= i {
+		t.Fatalf("%s: 1.5 is %+q", tag, s)
+	}
+	ls.decimal = s[i+len(ls.digits[1]) : j]
+	s = p.Sprintf("%v", number.Decimal(-7))
+	ls.minus = strings.TrimSuffix(s, ls.digits[7])
+	if ls.minus == s || ls.minus == "" {
+		t.Fatalf("%s: -7 is %+q", tag, s)
+	}
+	return ls
+}
+
+func (ls localeSymbols) render(en string) string {
+	var b strings.Builder
+	for _, r := range en {
+		switch {
+		case '0' <= r && r <= '9':
+			b.WriteString(ls.digits[r-'0'])
+		case r == ',':
+			b.WriteString(ls.group)
+		case r == '.':
+			b.WriteString(ls.decimal)
+		case r == '-':
+			b.WriteString(ls.minus)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// number.Decimal/Percent/PerMille follow the CLDR patterns written out:
+// half-even rounding of the exact value, the fraction and integer digit
+// options, grouping, width and padding, in English; and the same digits and
+// separators substituted in other locales.
+func TestHegelDecimalFormattingFollowsThePatterns(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	locales := []localeSymbols{
+		readSymbols(t, "de", 3), readSymbols(t, "de-CH", 3), readSymbols(t, "fr", 3), readSymbols(t, "es", 3),
+		readSymbols(t, "ru", 3), readSymbols(t, "ja", 3), readSymbols(t, "bn", 2), readSymbols(t, "hi", 2),
+		readSymbols(t, "en-IN", 2), readSymbols(t, "ar", 3), readSymbols(t, "th", 3), readSymbols(t, "ne", 3),
+	}
+	property(t, func(ht *hegel.T) {
+		d := drawDecimal(ht)
+		kind := pick(ht, "Decimal", "Decimal", "Percent", "PerMille")
+		minFrac, maxFrac := 0, 3
+		suffix := ""
+		switch kind {
+		case "Percent":
+			d = d.shift(2)
+			maxFrac = 0
+			suffix = "%"
+		case "PerMille":
+			d = d.shift(3)
+			maxFrac = 0
+			suffix = "\u2030"
+		}
+		var opts []number.Option
+		var names []string
+		separator, minInt, maxInt, width, libMax := true, 1, 0, 0, -1
+		pad := " "
+		for i := 0; i < n(ht, 0, 3); i++ {
+			switch n(ht, 1, 8) {
+			case 1:
+				opts = append(opts, number.NoSeparator())
+				names = append(names, "NoSeparator")
+				separator = false
+			case 2:
+				k := n(ht, 0, 6)
+				opts = append(opts, number.MaxFractionDigits(k))
+				names = append(names, fmt.Sprintf("MaxFractionDigits(%d)", k))
+				maxFrac = k
+				libMax = -1
+				if minFrac > k {
+					libMax = k
+					// (documented: the minimum wins over an earlier maximum;
+					// the model lowers the minimum instead, x-text/39 either way)
+					maxFrac = minFrac
+				}
+			case 3:
+				k := n(ht, 0, 4)
+				opts = append(opts, number.MinFractionDigits(k))
+				names = append(names, fmt.Sprintf("MinFractionDigits(%d)", k))
+				minFrac = k
+				if maxFrac < k {
+					libMax = maxFrac // the library keeps rounding here (x-text/39)
+					maxFrac = k
+				}
+			case 4:
+				k := n(ht, 0, 5)
+				opts = append(opts, number.Scale(k))
+				names = append(names, fmt.Sprintf("Scale(%d)", k))
+				minFrac, maxFrac, libMax = k, k, -1
+			case 5:
+				k := n(ht, 1, 8)
+				opts = append(opts, number.MinIntegerDigits(k))
+				names = append(names, fmt.Sprintf("MinIntegerDigits(%d)", k))
+				minInt = k
+			case 6:
+				k := n(ht, 1, 6)
+				opts = append(opts, number.MaxIntegerDigits(k))
+				names = append(names, fmt.Sprintf("MaxIntegerDigits(%d)", k))
+				maxInt = k
+			case 7:
+				k := n(ht, 1, 20)
+				opts = append(opts, number.FormatWidth(k))
+				names = append(names, fmt.Sprintf("FormatWidth(%d)", k))
+				width = k
+			default:
+				pad = pick(ht, "*", "0", "\u00a0", "\u4e00")
+				opts = append(opts, number.Pad([]rune(pad)[0]))
+				names = append(names, fmt.Sprintf("Pad(%q)", pad))
+				if width == 0 {
+					// Without FormatWidth a pad rune pads to the pattern's own
+					// length (9 for #,##0.###), so give a width.
+					width = n(ht, 1, 20)
+					opts = append(opts, number.FormatWidth(width))
+					names = append(names, fmt.Sprintf("FormatWidth(%d)", width))
+				}
+			}
+		}
+		desc := fmt.Sprintf("%s(%s, %s)", kind, d.desc, strings.Join(names, ", "))
+		var f number.Formatter
+		switch kind {
+		case "Percent":
+			f = number.Percent(d.v, opts...)
+		case "PerMille":
+			f = number.PerMille(d.v, opts...)
+		default:
+			f = number.Decimal(d.v, opts...)
+		}
+		// The model.
+		model := func(maxFrac int) (string, string) {
+			r := d.roundHalfEven(maxFrac)
+			fp := r.fp
+			for len(fp) < minFrac {
+				fp += "0"
+			}
+			ip := intDigits(r.ip, minInt, maxInt)
+			if separator {
+				ip = group(ip, 3, 3)
+			}
+			body := ip
+			if fp != "" {
+				body += "." + fp
+			}
+			want := body + suffix
+			if d.neg {
+				want = "-" + want
+			}
+			if utf8.RuneCountInString(want) < width {
+				want = strings.Repeat(pad, width-utf8.RuneCountInString(want)) + want
+			}
+			return want, body
+		}
+		want, body := model(maxFrac)
+		got := en.Sprintf("%v", f)
+		if got != want && libMax >= 0 && Known.MinFractionAboveMax {
+			if alt, _ := model(libMax); alt == got {
+				count(ht, "known x-text/39")
+				return
+			}
+		}
+		if got != want {
+			if d.neg && strings.Trim(body, "0.,") == suffix {
+				count(ht, "negative-zero")
+				note(ht, "%s = %s (model %s)", desc, show(got), show(want))
+				return
+			}
+			fail(ht, "%s = %s, model %s", desc, show(got), show(want))
+			return
+		}
+		// A width in the directive is documented to override the option.
+		if w := n(ht, 1, 20); chance(ht, 30) {
+			g := en.Sprintf("%*v", w, f)
+			if utf8.RuneCountInString(g) < w {
+				if Known.FormatterIgnoresWidth && pad == " " && width == 0 {
+					count(ht, "known x-text/36")
+				} else {
+					fail(ht, "%%%dv of %s = %s, %d runes", w, desc, show(g), utf8.RuneCountInString(g))
+				}
+			}
+		}
+		// Other locales: the English structure with their symbols.
+		if kind == "Decimal" && width == 0 {
+			ls := pick(ht, locales...)
+			p := message.NewPrinter(ls.tag)
+			w := ls.render(want)
+			r := d.roundHalfEven(maxFrac)
+			fp := r.fp
+			for len(fp) < minFrac {
+				fp += "0"
+			}
+			if separator && ls.secondary != 3 {
+				b := group(intDigits(r.ip, minInt, maxInt), 3, ls.secondary)
+				if fp != "" {
+					b += "." + fp
+				}
+				if d.neg {
+					b = "-" + b
+				}
+				w = ls.render(b)
+			}
+			if g := p.Sprintf("%v", f); g != w {
+				fail(ht, "%v: %s = %s, model %s", ls.tag, desc, show(g), show(w))
+			}
+		}
+	})
+}
