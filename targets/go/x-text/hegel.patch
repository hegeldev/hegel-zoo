+// ---------------------------------------------------------------------------
+// message
+
+var superscripts = map[rune]byte{
+	'\u2070': '0', '\u00b9': '1', '\u00b2': '2', '\u00b3': '3', '\u2074': '4',
+	'\u2075': '5', '\u2076': '6', '\u2077': '7', '\u2078': '8', '\u2079': '9',
+}
+
+// unlocalize turns the English Printer's rendering into fmt's: grouping
+// commas (between a digit and three digits) removed, "x10^exp" exponents
+// into e+exp (E+exp when upper is set).
+func unlocalize(s string, upper bool) string {
+	for {
+		i := strings.Index(s, ",")
+		found := false
+		for i >= 0 {
+			if i > 0 && isDigit(s[i-1]) && i+3 < len(s)+0 && isDigit(s[i+1]) && i+3 <= len(s)-1+1 && len(s) > i+3 && isDigit(s[i+2]) && isDigit(s[i+3]) && (i+4 >= len(s) || !isDigit(s[i+4])) {
+				s = s[:i] + s[i+1:]
+				found = true
+				break
+			}
+			j := strings.Index(s[i+1:], ",")
+			if j < 0 {
+				break
+			}
+			i += 1 + j
+		}
+		if !found {
+			break
+		}
+	}
+	e := byte('e')
+	if upper {
+		e = 'E'
+	}
+	var b strings.Builder
+	rs := []rune(s)
+	for i := 0; i < len(rs); i++ {
+		if rs[i] == '\u00d7' && i+2 < len(rs) && rs[i+1] == '1' && rs[i+2] == '0' {
+			i += 3
+			b.WriteByte(e)
+			if i < len(rs) && rs[i] == '\u207b' {
+				b.WriteByte('-')
+				i++
+			} else {
+				b.WriteByte('+')
+			}
+			for ; i < len(rs); i++ {
+				if d, ok := superscripts[rs[i]]; ok {
+					b.WriteByte(d)
+				} else {
+					break
+				}
+			}
+			i--
+			continue
+		}
+		b.WriteRune(rs[i])
+	}
+	return b.String()
+}
+
+func isDigit(c byte) bool { return '0' <= c && c <= '9' }
+
+type fmtArg struct {
+	v       interface{}
+	numeric bool
+	float   bool
+	small   bool // no grouping in any rendering
+}
+
+func drawArg(tc hegel.TestCase) fmtArg {
+	switch n(tc, 1, 9) {
+	case 1:
+		return fmtArg{v: word(tc, []rune("abcXYZ \u00e9\u4e00"), 0, 6)}
+	case 2:
+		return fmtArg{v: chance(tc, 50)}
+	case 3:
+		r := rune(pick(tc, 'a', '\u00e9', '\u4e00', 0x1F600))
+		return fmtArg{v: r, numeric: true, small: r < 1000}
+	case 4:
+		k := n(tc, -999, 999)
+		return fmtArg{v: k, numeric: true, small: true}
+	case 5:
+		k := n(tc, -2000000000, 2000000000)
+		return fmtArg{v: int64(k), numeric: true, small: -1000 < k && k < 1000}
+	case 6:
+		k := n(tc, 0, 70000)
+		return fmtArg{v: uint32(k), numeric: true, small: k < 1000}
+	case 7:
+		f := float64(n(tc, -99999, 99999)) / float64(pick(tc, 1, 10, 100, 1000))
+		return fmtArg{v: f, numeric: true, float: true, small: -1000 < f && f < 1000}
+	case 8:
+		f := pick(tc, 0.5, 1e6, 1e21, 123456.7, 1e-5, 1e-7, 1.5e300, 0.1, 2.5, 1234.5678)
+		return fmtArg{v: f, numeric: true, float: true, small: f < 1000}
+	default:
+		// The int element is formatted like a number (grouped padding).
+		return fmtArg{v: []interface{}{n(tc, 0, 5), word(tc, []rune("ab"), 0, 3)}, numeric: true, small: true}
+	}
+}
+
+// The English Printer is fmt with grouping and the x10 exponent notation:
+// Sprintf agrees with fmt.Sprintf on every verb, flag, width and precision
+// once those are undone, and exactly with the # flag; Sprint and Sprintln
+// agree likewise.
+func TestHegelPrinterAgreesWithFmt(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 3)
+		var format strings.Builder
+		var args []interface{}
+		var argsInfo []fmtArg
+		compare := true // exact comparison after unlocalize
+		upper, lower, prevWidth := false, false, false
+		for i := 0; i < k; i++ {
+			a := drawArg(ht)
+			args = append(args, a.v)
+			argsInfo = append(argsInfo, a)
+			format.WriteString(pick(ht, "", " ", "x=", "|"))
+			format.WriteByte('%')
+			flags := ""
+			for _, fl := range []string{"-", "+", " ", "#", "0"} {
+				if chance(ht, 12) {
+					flags += fl
+				}
+			}
+			format.WriteString(flags)
+			width, prec := 0, -1
+			if chance(ht, 30) {
+				width = n(ht, 1, 12)
+				fmt.Fprint(&format, width)
+			}
+			if chance(ht, 30) {
+				prec = n(ht, 0, 6)
+				fmt.Fprintf(&format, ".%d", prec)
+			}
+			var verb string
+			switch {
+			case a.float:
+				verb = pick(ht, "v", "f", "e", "g", "E", "G", "d", "x", "s")
+			case a.numeric:
+				verb = pick(ht, "v", "d", "x", "X", "o", "O", "b", "c", "q", "U", "f", "s")
+			default:
+				verb = pick(ht, "v", "s", "q", "x", "X", "d", "t", "c", "T")
+			}
+			format.WriteString(verb)
+			// Where the Printer is documented or known to differ. A bad verb
+			// on a number renders it as %v, so it is localized too.
+			localized := a.numeric && !strings.Contains("xXobcqUO", verb) && !strings.Contains(flags, "#")
+			if localized && a.float && width > 0 && !strings.Contains("fF", verb) {
+				// The x10 notation is longer than e+NN, so the padding differs.
+				count(ht, "width-with-exponent")
+				compare = false
+			}
+			if localized && strings.Contains(flags, "0") && width > 0 {
+				// The 0 flag becomes a minimum number of integer digits (grouped),
+				// so the output can exceed the width; asserted by upstream's tests.
+				count(ht, "zero-flag-width")
+				compare = false
+			}
+			if localized && width > 0 && !a.small {
+				count(ht, "width-with-grouping")
+				compare = false
+			}
+			if localized && a.float && prec >= 0 && strings.Contains("vgG", verb) {
+				if Known.PrecisionGOneTooMany {
+					count(ht, "known x-text/37")
+					compare = false
+				}
+			}
+			if a.float && strings.Contains("xX", verb) {
+				if Known.FloatHexVerb {
+					count(ht, "known x-text/38")
+					compare = false
+				}
+			}
+			if a.float && !strings.Contains(flags, "#") {
+				// A bad verb on a float renders the value as %v, so the
+				// exponent notation (and x-text/37 with a precision) show there too.
+				if strings.Contains("EG", verb) {
+					upper = true
+				} else {
+					lower = true
+				}
+				count(ht, "exponent-notation")
+				if prec >= 0 && !strings.Contains("feE", verb) && Known.PrecisionGOneTooMany {
+					count(ht, "known x-text/37")
+					compare = false
+				}
+			}
+			if a.numeric && !a.float && verb == "q" && Known.QuoteNegativeInt {
+				var x int64
+				switch v := a.v.(type) {
+				case int:
+					x = int64(v)
+				case int64:
+					x = v
+				case uint32:
+					x = int64(v)
+				}
+				if x < 0 || x > utf8.MaxRune {
+					count(ht, "known x-text/40")
+					compare = false
+				}
+			}
+			if a.numeric && !a.float && Known.Go113IntVerbs && (verb == "O" || (verb == "b" && strings.Contains(flags, "#"))) {
+				count(ht, "known x-text/41")
+				compare = false
+			}
+			if a.float && Known.Go113IntVerbs && strings.Contains(flags, "#") && !strings.Contains("feE", verb) {
+				// %#g pads one digit too few below 1.
+				count(ht, "known x-text/41")
+				compare = false
+			}
+			if prevWidth && width == 0 && prec >= 0 && Known.WidthLeaks {
+				count(ht, "known x-text/43")
+				compare = false
+			}
+			if width > 0 {
+				prevWidth = true
+			}
+			if localized && !a.float && prec >= 0 {
+				// The precision of an integer is a minimum number of digits,
+				// and the padding zeros are grouped (asserted by upstream's tests).
+				count(ht, "int-precision-grouping")
+				compare = false
+			}
+		}
+		got := en.Sprintf(format.String(), args...)
+		want := fmt.Sprintf(format.String(), args...)
+		if upper && lower {
+			count(ht, "mixed-exponent-case")
+			compare = false
+		}
+		if compare && unlocalize(got, upper) != want {
+			fail(ht, "Sprintf(%q, %v) = %s, fmt %s", format.String(), args, show(got), show(want))
+		}
+		if !compare {
+			return
+		}
+		if unlocalize(en.Sprint(args...), false) != fmt.Sprint(args...) {
+			fail(ht, "Sprint(%v) = %s, fmt %s", args, show(en.Sprint(args...)), show(fmt.Sprint(args...)))
+		}
+		if unlocalize(en.Sprintln(args...), false) != fmt.Sprintln(args...) {
+			fail(ht, "Sprintln(%v) = %s, fmt %s", args, show(en.Sprintln(args...)), show(fmt.Sprintln(args...)))
+		}
+		var buf bytes.Buffer
+		nn, err := en.Fprintf(&buf, format.String(), args...)
+		if err != nil || nn != buf.Len() || buf.String() != got {
+			fail(ht, "Fprintf(%q, %v) = %d, %v, wrote %s; Sprintf %s", format.String(), args, nn, err, show(buf.String()), show(got))
+		}
+	})
+}
+
+// catalogTags are the tags a catalog is built for: a tree under und.
+var catalogTags = []string{"und", "en", "en-US", "en-GB", "de", "de-AT", "de-CH", "fr", "pt", "pt-BR", "zh-Hant", "zh-Hant-TW"}
+
+// Messages set on a catalog.Builder are found for the tag they were set on
+// and its descendants (the parent chain), the nearest wins, a key with no
+// message renders itself, Key falls back as documented, and the arguments
+// are substituted as by Sprintf; Languages lists the tags set.
+func TestHegelCatalogMessagesResolveThroughParents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b := catalog.NewBuilder()
+		type entry struct {
+			tag language.Tag
+			key string
+			msg string
+		}
+		set := map[string]map[string]string{} // tag -> key -> msg
+		langs := map[string]bool{}
+		k := n(ht, 0, 8)
+		keys := []string{"hello %s", "%d files", "plain", "%s and %d"}
+		for i := 0; i < k; i++ {
+			tag := language.MustParse(pick(ht, catalogTags...))
+			key := pick(ht, keys...)
+			msg := pick(ht, "Hallo %s", "%d Dateien", "Bonjour", "%s et %d", "%[2]d before %[1]s", "%s%s")
+			if err := b.SetString(tag, key, msg); err != nil {
+				fail(ht, "SetString(%v, %q, %q): %v", tag, key, msg, err)
+				return
+			}
+			if set[tag.String()] == nil {
+				set[tag.String()] = map[string]string{}
+			}
+			set[tag.String()][key] = msg
+			langs[tag.String()] = true
+		}
+		got := map[string]bool{}
+		for _, l := range b.Languages() {
+			got[l.String()] = true
+		}
+		if fmt.Sprint(got) != fmt.Sprint(langs) {
+			fail(ht, "Languages() = %v, set %v", got, langs)
+		}
+		lookup := func(tag language.Tag, key string) (string, bool) {
+			for t := tag; ; t = t.Parent() {
+				if m, ok := set[t.String()][key]; ok {
+					return m, true
+				}
+				if t == language.Und {
+					return "", false
+				}
+			}
+		}
+		tag := language.MustParse(pick(ht, catalogTags...))
+		p := message.NewPrinter(tag, message.Catalog(b))
+		key := pick(ht, keys...)
+		s := word(ht, []rune("abc"), 0, 4)
+		d := n(ht, 0, 999)
+		// A message without verbs ignores its arguments silently (fmt would
+		// append an EXTRA marker): translations need not use every argument.
+		render := func(format string) string {
+			if !strings.Contains(format, "%") {
+				return format
+			}
+			return fmt.Sprintf(format, s, d)
+		}
+		want := key
+		if m, ok := lookup(tag, key); ok {
+			want = m
+		}
+		if g := p.Sprintf(key, s, d); g != render(want) {
+			fail(ht, "%v: Sprintf(%q, %q, %d) = %s, want %s from %s", tag, key, s, d, show(g), show(render(want)), show(want))
+		}
+		// Key(id, fallback): the id's message, else the fallback's, else the
+		// fallback text itself.
+		id, fb := pick(ht, keys...), pick(ht, keys...)
+		want = fb
+		if m, ok := lookup(tag, id); ok {
+			want = m
+		} else if m, ok := lookup(tag, fb); ok {
+			want = m
+		}
+		if g := p.Sprintf(message.Key(id, fb), s, d); g != render(want) {
+			fail(ht, "%v: Sprintf(Key(%q, %q), %q, %d) = %s, want %s", tag, id, fb, s, d, show(g), show(render(want)))
+		}
+		// The matcher matches a catalog language exactly.
+		if langs[tag.String()] {
+			if _, _, conf := b.Matcher().Match(tag); conf != language.Exact {
+				fail(ht, "%v is a catalog language but Matcher().Match gives %v", tag, conf)
+			}
+		}
+	})
+}
+
+// pluralLangs are languages with different cardinal rules.
+var pluralLangs = []string{"en", "fr", "de", "ru", "pl", "ar", "ja", "cy", "he", "cs", "lt", "lv", "ga", "sl", "mt"}
+
+// plural.Selectf picks the first case whose selector matches the argument
+// as documented: "=x" by value, "<x" by bound, a Form by
+// Cardinal.MatchPlural, Other always; and MatchPlural follows the CLDR rule
+// for English and Japanese.
+func TestHegelSelectfPicksTheFirstMatchingCase(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tag := language.MustParse(pick(ht, pluralLangs...))
+		v := n(ht, 0, 25)
+		if chance(ht, 25) {
+			v = pick(ht, 100, 101, 102, 111, 1000, 1000000, 70000, 21, 22, 5, 11)
+		}
+		form := plural.Cardinal.MatchPlural(tag, v, 0, 0, 0, 0)
+		if tag == language.English && (form == plural.One) != (v == 1) {
+			fail(ht, "en: MatchPlural(%d) = %v", v, form)
+		}
+		if tag == language.Japanese && form != plural.Other {
+			fail(ht, "ja: MatchPlural(%d) = %v", v, form)
+		}
+		k := n(ht, 0, 5)
+		var cases []interface{}
+		wantIdx := -1
+		for i := 0; i < k; i++ {
+			var sel interface{}
+			matches := false
+			switch n(ht, 1, 4) {
+			case 1:
+				x := pick(ht, v, n(ht, 0, 30))
+				sel = fmt.Sprintf("=%d", x)
+				matches = x == v
+			case 2:
+				x := n(ht, 0, 30)
+				sel = fmt.Sprintf("<%d", x)
+				matches = v < x
+			case 3:
+				f := pick(ht, plural.Zero, plural.One, plural.Two, plural.Few, plural.Many)
+				sel = f
+				matches = f == form
+			default:
+				name := pick(ht, "zero", "one", "two", "few", "many")
+				sel = name
+				matches = map[string]plural.Form{"zero": plural.Zero, "one": plural.One, "two": plural.Two, "few": plural.Few, "many": plural.Many}[name] == form
+			}
+			cases = append(cases, sel, fmt.Sprintf("case%d", i))
+			if matches && wantIdx < 0 {
+				wantIdx = i
+			}
+		}
+		cases = append(cases, pick[interface{}](ht, plural.Other, "other"), fmt.Sprintf("case%d", k))
+		if wantIdx < 0 {
+			wantIdx = k
+		}
+		b := catalog.NewBuilder()
+		if err := b.Set(tag, "%d things", plural.Selectf(1, "%d", cases...)); err != nil {
+			msg := err.Error()
+			switch {
+			case strings.Contains(msg, "not supported for language"):
+				// A form the language's rules never produce is rejected.
+				count(ht, "unsupported-form")
+			case Known.SelectorUint16 && strings.Contains(msg, "value out of range"):
+				count(ht, "known x-text/42")
+			default:
+				fail(ht, "%v: Set(Selectf(%v)): %v", tag, cases, err)
+			}
+			return
+		}
+		p := message.NewPrinter(tag, message.Catalog(b))
+		got := p.Sprintf("%d things", v)
+		if got != fmt.Sprintf("case%d", wantIdx) {
+			fail(ht, "%v: Selectf(%v) for %d (form %v) = %s, want case%d", tag, cases, v, form, show(got), wantIdx)
+		}
+	})
+}
diff --git a/hegel/hegel_norm_test.go b/hegel/hegel_norm_test.go
new file mode 100644
index 0000000..60ec784
--- /dev/null
+++ b/hegel/hegel_norm_test.go
@@ -0,0 +1,456 @@
+package hegel
+
+// unicode/norm, unicode/rangetable, unicode/runenames against Python's
+// unicodedata (Unicode 15.0) and against the package's own contracts.
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/text/unicode/norm"
+	"golang.org/x/text/unicode/rangetable"
+	"golang.org/x/text/unicode/runenames"
+	"hegel.dev/go/hegel"
+)
+
+var forms = []norm.Form{norm.NFC, norm.NFD, norm.NFKC, norm.NFKD}
+var formNames = map[norm.Form]string{norm.NFC: "NFC", norm.NFD: "NFD", norm.NFKC: "NFKC", norm.NFKD: "NFKD"}
+
+// Every form's String, Bytes and Append agree with Python's
+// unicodedata.normalize, and the forms satisfy the standard's identities.
+func TestHegelNormFormsAgreeWithPython(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		s := text15(ht, 0, 12)
+		if chance(ht, 10) {
+			// A long run of non-starters (and of Hangul V/T jamo, which combine
+			// backwards) around the 30-rune stream-safe limit.
+			var rs []rune
+			k := n(ht, 20, 40)
+			for i := 0; i < k; i++ {
+				rs = append(rs, pick[rune](ht, 0x0300, 0x0301, 0x0323, 0x05B0, 0x0334, 0x0345, 0x1161, 0x11A8, 0x0F73, 0x0344))
+			}
+			s = pick(ht, "a", "", "\u1100") + string(rs) + s
+		}
+		var want map[string]string
+		py.call(map[string]any{"op": "norm", "s": s}, &want)
+		got := map[string]string{}
+		for _, f := range forms {
+			name := formNames[f]
+			got[name] = f.String(s)
+			if got[name] != want[name] {
+				// The inserted CGJ also stops the canonical reordering at that point.
+				if Known.StreamSafeCGJ && strings.Count(got[name], "\u034f") > strings.Count(s, "\u034f") {
+					count(ht, "known x-text/1")
+					return
+				}
+				fail(ht, "%s(%s): got %s, Python %s", name, show(s), show(got[name]), show(want[name]))
+			}
+			if b := f.Bytes([]byte(s)); string(b) != got[name] {
+				fail(ht, "%s.Bytes(%s) = %s but String = %s", name, show(s), show(string(b)), show(got[name]))
+			}
+			if b := f.Append(nil, []byte(s)...); string(b) != got[name] {
+				fail(ht, "%s.Append(nil, %s) = %s but String = %s", name, show(s), show(string(b)), show(got[name]))
+			}
+			// Append returns f(append(out, src...)): the join may combine.
+			if b := f.AppendString([]byte("x"), s); string(b) != f.String("x"+s) {
+				fail(ht, "%s.AppendString(x, %s) = %s, %s(x + s) = %s", name, show(s), show(string(b)), name, show(f.String("x"+s)))
+			}
+			isNormal := got[name] == s
+			if f.IsNormalString(s) != isNormal || f.IsNormal([]byte(s)) != isNormal {
+				fail(ht, "%s.IsNormal(%s) = %v but %s(s) = %s", name, show(s), f.IsNormalString(s), name, show(got[name]))
+			}
+			q := f.QuickSpanString(s)
+			if q < 0 || q > len(s) || !utf8.ValidString(s[:q]) || f.String(s[:q]) != s[:q] {
+				fail(ht, "%s.QuickSpanString(%s) = %d but %s(prefix) = %s", name, show(s), q, name, show(f.String(s[:q])))
+			}
+			if isNormal && q != len(s) {
+				count(ht, "quickspan-conservative")
+			}
+			if f.QuickSpan([]byte(s)) != q {
+				fail(ht, "%s.QuickSpan bytes/string disagree on %s: %d vs %d", name, show(s), f.QuickSpan([]byte(s)), q)
+			}
+		}
+		// Identities of UAX #15.
+		if x := norm.NFC.String(got["NFD"]); x != got["NFC"] {
+			fail(ht, "NFC(NFD(%s)) = %s but NFC = %s", show(s), show(x), show(got["NFC"]))
+		}
+		if x := norm.NFD.String(got["NFC"]); x != got["NFD"] {
+			fail(ht, "NFD(NFC(%s)) = %s but NFD = %s", show(s), show(x), show(got["NFD"]))
+		}
+		if x := norm.NFKC.String(got["NFKD"]); x != got["NFKC"] {
+			fail(ht, "NFKC(NFKD(%s)) = %s but NFKC = %s", show(s), show(x), show(got["NFKC"]))
+		}
+		if x := norm.NFKD.String(got["NFKC"]); x != got["NFKD"] {
+			fail(ht, "NFKD(NFKC(%s)) = %s but NFKD = %s", show(s), show(x), show(got["NFKD"]))
+		}
+		for _, f := range forms {
+			name := formNames[f]
+			if x := f.String(got[name]); x != got[name] {
+				fail(ht, "%s is not idempotent on %s: %s then %s", name, show(s), show(got[name]), show(x))
+			}
+		}
+	})
+}
+
+// The streaming paths (Transform driven by the contract, Reader, Writer,
+// Iter) produce the same bytes as the one-shot Bytes, on any input including
+// ill-formed UTF-8 and long combining sequences.
+func TestHegelNormStreamingMatchesWholeString(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := pick(ht, forms...)
+		name := formNames[f]
+		var src []byte
+		if chance(ht, 20) {
+			// A long run of non-starters, around and past the segment limit.
+			src = []byte(pick(ht, "a", "", "ᄀ", "̈́"))
+			k := n(ht, 1, 40)
+			for i := 0; i < k; i++ {
+				src = utf8.AppendRune(src, pick[rune](ht, 0x0300, 0x0301, 0x0323, 0x05B0, 0x0334, 0x0345, 0x034F, 0x1161, 0x11A8, 0x0F73, 0x0344))
+			}
+			if chance(ht, 50) {
+				src = append(src, []byte(text15(ht, 0, 4))...)
+			}
+		} else {
+			src = bytesAny(ht, 0, 16)
+		}
+		want := f.Bytes(src)
+		chunk, dstSize := n(ht, 1, 9), pick(ht, 1, 2, 3, 4, 7, 16, 64)
+		got, err := drive(f, src, chunk, dstSize)
+		if err != nil {
+			fail(ht, "%s.Transform on %q (chunk %d, dst %d): %v", name, src, chunk, dstSize, err)
+		}
+		if !bytes.Equal(got, want) {
+			fail(ht, "%s.Transform on %q in chunks of %d with dst %d: %q, one-shot %q", name, src, chunk, dstSize, got, want)
+		}
+		k, m := n(ht, 1, 7), pick(ht, 1, 3, 8, 64)
+		if got, err := viaReader(f, src, k, m); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s via transform.NewReader on %q (%d bytes per read, buffer %d): %q, %v; one-shot %q", name, src, k, m, got, err, want)
+		}
+		if got, err := viaWriter(f, src, k); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s via transform.NewWriter on %q (writes of %d): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		if got, err := viaReader(readerForm{f}, src, k, m); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s.Reader on %q (%d bytes per read): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		if got, err := writerForm(f, src, k); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s.Writer on %q (writes of %d): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		var it norm.Iter
+		it.Init(f, src)
+		var acc []byte
+		pos := 0
+		for i := 0; !it.Done(); i++ {
+			if i > 10*len(src)+10 {
+				fail(ht, "%s Iter over %q does not finish", name, src)
+			}
+			if p := it.Pos(); p < pos || p > len(src) {
+				fail(ht, "%s Iter.Pos on %q went from %d to %d", name, src, pos, p)
+			} else {
+				pos = p
+			}
+			acc = append(acc, it.Next()...)
+		}
+		if !bytes.Equal(acc, want) {
+			// The two paths place the stream-safe CGJ differently (and the
+			// reordering stops at it), never otherwise.
+			if Known.IterJamoCGJ && (bytes.Contains(acc, []byte("\u034f")) || bytes.Contains(want, []byte("\u034f"))) {
+				count(ht, "known x-text/2")
+				return
+			}
+			fail(ht, "%s Iter over %q yields %q, one-shot %q", name, src, acc, want)
+		}
+		if p := it.Pos(); p != len(src) {
+			fail(ht, "%s Iter over %q is Done at Pos %d of %d", name, src, p, len(src))
+		}
+	})
+}
+
+// readerForm adapts norm.Form.Reader to the viaReader helper's Transformer
+// argument (only Transform's identity matters: viaReader builds its own
+// transform.Reader, so wrap Form.Reader directly instead).
+type readerForm struct{ f norm.Form }
+
+func (r readerForm) Transform(dst, src []byte, atEOF bool) (int, int, error) {
+	return r.f.Transform(dst, src, atEOF)
+}
+func (r readerForm) Reset() {}
+
+func writerForm(f norm.Form, src []byte, k int) ([]byte, error) {
+	var buf bytes.Buffer
+	w := f.Writer(&buf)
+	for i := 0; i < len(src); i += k {
+		j := i + k
+		if j > len(src) {
+			j = len(src)
+		}
+		if _, err := w.Write(src[i:j]); err != nil {
+			return buf.Bytes(), err
+		}
+	}
+	if err := w.Close(); err != nil {
+		return buf.Bytes(), err
+	}
+	return buf.Bytes(), nil
+}
+
+// Boundaries split the input into independently normalizable pieces, Span
+// prefixes are normal, and Properties match unicodedata.
+func TestHegelNormBoundariesAndProperties(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		s := text15(ht, 0, 10)
+		b := []byte(s)
+		f := pick(ht, forms...)
+		name := formNames[f]
+		// Boundaries are shared between NFC and NFD, and between NFKC and NFKD
+		// (the compatibility decompositions add non-starters of their own, as
+		// U+FF9F -> U+309A).
+		kin := []norm.Form{norm.NFC, norm.NFD}
+		if f == norm.NFKC || f == norm.NFKD {
+			kin = []norm.Form{norm.NFKC, norm.NFKD}
+		}
+		splitsCleanly := func(i int, what string) {
+			for _, g := range kin {
+				if x := g.String(s[:i]) + g.String(s[i:]); x != g.String(s) {
+					fail(ht, "%s reports a boundary at %d in %s, but %s of the parts %s + %s != %s", what, i, show(s), formNames[g], show(g.String(s[:i])), show(g.String(s[i:])), show(g.String(s)))
+				}
+			}
+		}
+		if i := f.FirstBoundary(b); i != -1 {
+			if i < 0 || i > len(b) || i != f.FirstBoundaryInString(s) {
+				fail(ht, "%s.FirstBoundary(%s) = %d (string version %d)", name, show(s), i, f.FirstBoundaryInString(s))
+			}
+			splitsCleanly(i, name+".FirstBoundary")
+		}
+		if i := f.LastBoundary(b); i != -1 {
+			if i < 0 || i > len(b) {
+				fail(ht, "%s.LastBoundary(%s) = %d", name, show(s), i)
+			}
+			splitsCleanly(i, name+".LastBoundary")
+		}
+		// Walk the segments with NextBoundary.
+		pos, segs := 0, 0
+		for pos < len(b) {
+			i := f.NextBoundary(b[pos:], true)
+			if i <= 0 || i > len(b)-pos {
+				fail(ht, "%s.NextBoundary(%s[%d:], true) = %d", name, show(s), pos, i)
+			}
+			if j := f.NextBoundaryInString(s[pos:], true); j != i {
+				fail(ht, "%s.NextBoundary bytes %d vs string %d on %s[%d:]", name, i, j, show(s), pos)
+			}
+			if j := f.NextBoundary(b[pos:], false); j != -1 && j != i {
+				fail(ht, "%s.NextBoundary(%s[%d:]) = %d at EOF but %d without", name, show(s), pos, i, j)
+			}
+			splitsCleanly(pos+i, name+".NextBoundary")
+			pos += i
+			segs++
+			if segs > len(b)+1 {
+				fail(ht, "%s.NextBoundary loops on %s", name, show(s))
+			}
+		}
+		if len(b) == 0 && f.NextBoundary(b, true) != 0 {
+			fail(ht, "%s.NextBoundary(empty, true) = %d", name, f.NextBoundary(b, true))
+		}
+		// Span: a boundary prefix that is already normal.
+		if k, err := f.Span(b, true); k < 0 || k > len(b) || f.String(s[:k]) != s[:k] || (k < len(b)) != (err != nil) {
+			fail(ht, "%s.Span(%s, true) = %d, %v", name, show(s), k, err)
+		}
+		if k, err := f.SpanString(s, false); k < 0 || k > len(b) || f.String(s[:k]) != s[:k] || (k < len(b)) != (err != nil) {
+			fail(ht, "%s.SpanString(%s, false) = %d, %v", name, show(s), k, err)
+		}
+		// Properties against unicodedata.
+		ps := py.props(s)
+		rs := []rune(s)
+		for i, r := range rs {
+			if i >= len(ps) {
+				break
+			}
+			p := f.PropertiesString(string(r))
+			if p.Size() != utf8.RuneLen(r) {
+				fail(ht, "%s.Properties(%U).Size() = %d", name, r, p.Size())
+			}
+			if int(p.CCC()) != ps[i].CCC {
+				fail(ht, "%s.Properties(%U).CCC() = %d, unicodedata.combining = %d", name, r, p.CCC(), ps[i].CCC)
+			}
+			d := p.Decomposition()
+			hangul := r >= 0xAC00 && r <= 0xD7A3
+			var full string
+			if f == norm.NFC || f == norm.NFD {
+				full = norm.NFD.String(string(r))
+			} else {
+				full = norm.NFKD.String(string(r))
+			}
+			if hangul {
+				count(ht, "hangul-decomposition")
+			} else if d == nil && full != string(r) {
+				fail(ht, "%s.Properties(%U).Decomposition() is nil but the rune decomposes to %s", name, r, show(full))
+			} else if d != nil && string(d) != full {
+				fail(ht, "%s.Properties(%U).Decomposition() = %s, full decomposition %s", name, r, show(string(d)), show(full))
+			}
+			if d != nil {
+				dr := []rune(string(d))
+				if p.LeadCCC() != f.PropertiesString(string(dr[0])).CCC() || p.TrailCCC() != f.PropertiesString(string(dr[len(dr)-1])).CCC() {
+					fail(ht, "%s.Properties(%U): LeadCCC %d TrailCCC %d, decomposition %s", name, r, p.LeadCCC(), p.TrailCCC(), show(string(d)))
+				}
+			} else if p.LeadCCC() != p.CCC() || p.TrailCCC() != p.CCC() {
+				fail(ht, "%s.Properties(%U): no decomposition but LeadCCC %d TrailCCC %d CCC %d", name, r, p.LeadCCC(), p.TrailCCC(), p.CCC())
+			}
+			if p.BoundaryBefore() && ps[i].CCC != 0 {
+				fail(ht, "%s.Properties(%U).BoundaryBefore() with CCC %d", name, r, ps[i].CCC)
+			}
+			if p.BoundaryBefore() {
+				// A rune that starts a segment: the normalization of any prefix + r splits before r.
+				pre := pick(ht, "a", "́", "ᄀ", "क")
+				for _, g := range kin {
+					if g.String(pre+string(r)) != g.String(pre)+g.String(string(r)) {
+						fail(ht, "%s.Properties(%U).BoundaryBefore() but %s(%s + %U) = %s", name, r, formNames[g], show(pre), r, show(g.String(pre+string(r))))
+					}
+				}
+			}
+		}
+	})
+}
+
+// rangetable.Merge is the union of its tables, in a well-formed table, and
+// New/Visit round-trip a set of runes.
+func TestHegelRangeTableMergeIsTheUnion(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 4)
+		var tables []*unicode.RangeTable
+		in := map[rune]bool{}
+		for i := 0; i < k; i++ {
+			switch n(ht, 1, 4) {
+			case 1:
+				tables = append(tables, pick(ht, unicode.Letter, unicode.Greek, unicode.Han, unicode.Nd, unicode.Zs, unicode.Latin, unicode.Cc))
+				rangetable.Visit(tables[len(tables)-1], func(r rune) { in[r] = true })
+			case 2:
+				// A hand-built table with strides.
+				rt := &unicode.RangeTable{}
+				m := n(ht, 1, 3)
+				lo := rune(n(ht, 0, 0x2000))
+				for j := 0; j < m; j++ {
+					stride := rune(n(ht, 1, 3))
+					cnt := rune(n(ht, 0, 5))
+					hi := lo + stride*cnt
+					if hi <= unicode.MaxLatin1 {
+						rt.LatinOffset++
+					}
+					rt.R16 = append(rt.R16, unicode.Range16{Lo: uint16(lo), Hi: uint16(hi), Stride: uint16(stride)})
+					for r := lo; r <= hi; r += stride {
+						in[r] = true
+					}
+					lo = hi + rune(n(ht, 1, 20))
+				}
+				if chance(ht, 50) {
+					lo32 := rune(n(ht, 0x10000, 0x20000))
+					stride := rune(n(ht, 1, 3))
+					hi32 := lo32 + stride*rune(n(ht, 0, 5))
+					rt.R32 = append(rt.R32, unicode.Range32{Lo: uint32(lo32), Hi: uint32(hi32), Stride: uint32(stride)})
+					for r := lo32; r <= hi32; r += stride {
+						in[r] = true
+					}
+				}
+				tables = append(tables, rt)
+			default:
+				m := n(ht, 0, 8)
+				rs := make([]rune, 0, m)
+				for j := 0; j < m; j++ {
+					r := anyRune(ht, true)
+					rs = append(rs, r)
+					in[r] = true
+				}
+				nt := rangetable.New(rs...)
+				var back []rune
+				rangetable.Visit(nt, func(r rune) { back = append(back, r) })
+				set := map[rune]bool{}
+				for _, r := range rs {
+					set[r] = true
+				}
+				if len(back) != len(set) {
+					fail(ht, "rangetable.New(%v) visits %v", rs, back)
+				}
+				for i, r := range back {
+					if !set[r] || (i > 0 && back[i-1] >= r) {
+						fail(ht, "rangetable.New(%v) visits %v", rs, back)
+					}
+				}
+				tables = append(tables, nt)
+			}
+		}
+		merged := rangetable.Merge(tables...)
+		// Well-formed: sorted, non-overlapping, strides positive, LatinOffset right.
+		prev := rune(-1)
+		latin := 0
+		for _, r := range merged.R16 {
+			if r.Stride == 0 || r.Lo > r.Hi || rune(r.Lo) <= prev || (r.Hi-r.Lo)%r.Stride != 0 {
+				fail(ht, "Merge of %d tables: malformed R16 %+v after %d", k, r, prev)
+			}
+			prev = rune(r.Hi)
+			if r.Hi <= unicode.MaxLatin1 {
+				latin++
+			}
+		}
+		if merged.LatinOffset != latin {
+			fail(ht, "Merge of %d tables: LatinOffset %d, %d ranges end in Latin-1: %+v", k, merged.LatinOffset, latin, merged.R16)
+		}
+		for _, r := range merged.R32 {
+			if r.Stride == 0 || r.Lo > r.Hi || rune(r.Lo) <= prev || (r.Hi-r.Lo)%r.Stride != 0 || r.Lo <= 0xFFFF {
+				fail(ht, "Merge of %d tables: malformed R32 %+v after %d", k, r, prev)
+			}
+			prev = rune(r.Hi)
+		}
+		// Membership.
+		var visited []rune
+		rangetable.Visit(merged, func(r rune) { visited = append(visited, r) })
+		if len(visited) != len(in) {
+			fail(ht, "Merge of %d tables has %d runes, the union %d", k, len(visited), len(in))
+		}
+		for _, r := range visited {
+			if !in[r] {
+				fail(ht, "Merge of %d tables contains %U, not in the union", k, r)
+			}
+		}
+		for i := 0; i < 20; i++ {
+			r := anyRune(ht, true)
+			if unicode.Is(merged, r) != in[r] {
+				fail(ht, "unicode.Is(Merge of %d tables, %U) = %v, union says %v", k, r, unicode.Is(merged, r), in[r])
+			}
+		}
+	})
+}
+
+// runenames.Name agrees with unicodedata.name on every named Unicode 15.0
+// character.
+func TestHegelRuneNamesMatchPython(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		s := text15(ht, 1, 8)
+		ps := py.props(s)
+		for i, r := range []rune(s) {
+			if i >= len(ps) {
+				break
+			}
+			got := runenames.Name(r)
+			if strings.HasPrefix(got, "<") && strings.HasSuffix(got, ">") {
+				// The UnicodeData range label (<Hangul Syllable>, <CJK Ideograph>, <Private Use>)
+				// stands for the whole range; the standard's derived names are not computed.
+				count(ht, "range-label")
+				continue
+			}
+			if ps[i].Name == "" {
+				count(ht, "unnamed-in-python")
+				if got != "" && !(ps[i].Cat == "Cc" && got == "<control>") {
+					note(ht, "%U: Go %q, Python has no name (category %s)", r, got, ps[i].Cat)
+				}
+				continue
+			}
+			if got != ps[i].Name {
+				fail(ht, "runenames.Name(%U) = %q, unicodedata.name = %q", r, got, ps[i].Name)
+			}
+		}
+	})
+}
