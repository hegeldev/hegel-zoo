+
+// ---------------------------------------------------------------------------
+// runes and transform
+
+// runeSet is a named runes.Set with the predicate it was built from.
+type runeSet struct {
+	name string
+	set  runes.Set
+	f    func(rune) bool
+}
+
+func drawSet(tc hegel.TestCase) runeSet {
+	switch n(tc, 1, 6) {
+	case 1:
+		return runeSet{"In(Mn)", runes.In(unicode.Mn), func(r rune) bool { return unicode.Is(unicode.Mn, r) }}
+	case 2:
+		return runeSet{"NotIn(Latin)", runes.NotIn(unicode.Latin), func(r rune) bool { return !unicode.Is(unicode.Latin, r) }}
+	case 3:
+		return runeSet{"Predicate(a)", runes.Predicate(func(r rune) bool { return r == 'a' }), func(r rune) bool { return r == 'a' }}
+	case 4:
+		return runeSet{"Predicate(RuneError)", runes.Predicate(func(r rune) bool { return r == utf8.RuneError }), func(r rune) bool { return r == utf8.RuneError }}
+	case 5:
+		return runeSet{"In(ASCII)", runes.In(&unicode.RangeTable{R16: []unicode.Range16{{Lo: 0, Hi: 0x7f, Stride: 1}}}), func(r rune) bool { return r < 0x80 }}
+	default:
+		return runeSet{"Predicate(upper)", runes.Predicate(unicode.IsUpper), unicode.IsUpper}
+	}
+}
+
+// eachRune walks src the way utf8.DecodeRune does: every byte of an
+// ill-formed sequence is one RuneError of size 1.
+func eachRune(src []byte, fn func(r rune, b []byte)) {
+	for i := 0; i < len(src); {
+		r, size := utf8.DecodeRune(src[i:])
+		fn(r, src[i:i+size])
+		i += size
+	}
+}
+
+func mapRune(r rune) rune {
+	switch {
+	case r == 'a':
+		return 'b'
+	case r == utf8.RuneError:
+		return '?'
+	case r >= 0x80 && r < 0x800:
+		return r + 0x10000 // grows from two to four bytes
+	case r >= 0x10000:
+		return 'x' // shrinks
+	}
+	return r
+}
+
+// Remove, Map, ReplaceIllFormed and If follow their documented models on any
+// bytes (ill-formed sequences become RuneError before the predicate or mapping
+// sees them), their Span is exact, and streaming matches the one shot.
+func TestHegelRunesTransformersFollowTheirModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := bytesAny(ht, 0, 24)
+		if chance(ht, 30) {
+			src = []byte(strings.Repeat("a", n(ht, 0, 3)) + text15(ht, 0, 6) + string(pick(ht, "", "\xff", "\xc3", "a")))
+		}
+		set := drawSet(ht)
+		mp := runes.Map(mapRune)
+		var want bytes.Buffer
+		var tr runes.Transformer
+		var name string
+		switch n(ht, 1, 4) {
+		case 1:
+			name = "Remove(" + set.name + ")"
+			tr = runes.Remove(set.set)
+			eachRune(src, func(r rune, b []byte) {
+				if !set.f(r) {
+					if r == utf8.RuneError && len(b) == 1 {
+						want.WriteString("\ufffd")
+					} else {
+						want.Write(b)
+					}
+				}
+			})
+		case 2:
+			name = "Map"
+			tr = mp
+			eachRune(src, func(r rune, b []byte) { want.WriteRune(mapRune(r)) })
+		case 3:
+			name = "ReplaceIllFormed"
+			tr = runes.ReplaceIllFormed()
+			eachRune(src, func(r rune, b []byte) {
+				if r == utf8.RuneError && len(b) == 1 {
+					want.WriteString("\ufffd")
+				} else {
+					want.Write(b)
+				}
+			})
+		default:
+			// If: Map on the runes in the set, Remove(Mn) on the others; runs
+			// of each are transformed independently (both are stateless).
+			name = "If(" + set.name + ")"
+			rm := runes.Remove(runes.In(unicode.Mn))
+			tr = runes.If(set.set, mp, rm)
+			eachRune(src, func(r rune, b []byte) {
+				if set.f(r) {
+					want.WriteRune(mapRune(r))
+				} else if !unicode.Is(unicode.Mn, r) {
+					if r == utf8.RuneError && len(b) == 1 {
+						want.WriteString("\ufffd") // Remove's replacement
+					} else {
+						want.Write(b)
+					}
+				}
+			})
+		}
+		got := tr.String(string(src))
+		if got != want.String() {
+			fail(ht, "%s(%s) = %s, model %s", name, show(string(src)), show(got), show(want.String()))
+		}
+		if b := tr.Bytes(src); string(b) != got {
+			fail(ht, "%s.Bytes(%s) = %s but String = %s", name, show(string(src)), show(string(b)), show(got))
+		}
+		k, err := tr.Span(src, true)
+		if k < 0 || k > len(src) || tr.String(string(src[:k])) != string(src[:k]) {
+			fail(ht, "%s.Span(%s) = %d, %v but the prefix transforms to %s", name, show(string(src)), k, err, show(tr.String(string(src[:k]))))
+		}
+		if (k == len(src) && err == nil) != (got == string(src)) {
+			fail(ht, "%s.Span(%s) = %d, %v but String = %s", name, show(string(src)), k, err, show(got))
+		}
+		out, err := drive(tr, src, n(ht, 1, 5), n(ht, 1, 9))
+		if err != nil || string(out) != got {
+			fail(ht, "%s streamed %s to %s, %v; String = %s", name, show(string(src)), show(string(out)), err, show(got))
+		}
+	})
+}
+
+// upperASCII is a stateless transformer with its own Span, for chains.
+type upperASCII struct{ transform.NopResetter }
+
+func (upperASCII) Transform(dst, src []byte, atEOF bool) (nDst, nSrc int, err error) {
+	for ; nSrc < len(src); nSrc++ {
+		if nDst >= len(dst) {
+			return nDst, nSrc, transform.ErrShortDst
+		}
+		c := src[nSrc]
+		if 'a' <= c && c <= 'z' {
+			c -= 'a' - 'A'
+		}
+		dst[nDst] = c
+		nDst++
+	}
+	return nDst, nSrc, nil
+}
+
+// transform.Chain is the composition of its links, String/Bytes/Append and
+// NewReader/NewWriter agree with it on any bytes, Nop and Discard do what
+// they say, and RemoveFunc is Remove.
+func TestHegelTransformChainIsTheComposition(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		src := bytesAny(ht, 0, 40)
+		links := []struct {
+			name string
+			t    transform.Transformer
+		}{
+			{"Map", runes.Map(mapRune)},
+			{"Remove(Mn)", runes.Remove(runes.In(unicode.Mn))},
+			{"NFD", norm.NFD},
+			{"NFC", norm.NFC},
+			{"upperASCII", upperASCII{}},
+			{"ReplaceIllFormed", runes.ReplaceIllFormed()},
+			{"Nop", transform.Nop},
+		}
+		k := n(ht, 0, 4)
+		var ts []transform.Transformer
+		var names []string
+		want := src
+		for i := 0; i < k; i++ {
+			l := pick(ht, links...)
+			ts = append(ts, l.t)
+			names = append(names, l.name)
+			var err error
+			want, _, err = transform.Bytes(l.t, want)
+			if err != nil {
+				fail(ht, "%s on %s: %v", l.name, show(string(src)), err)
+				return
+			}
+		}
+		name := "Chain(" + strings.Join(names, ", ") + ")"
+		c := transform.Chain(ts...)
+		got, nn, err := transform.Bytes(c, src)
+		if err != nil || nn != len(src) || !bytes.Equal(got, want) {
+			fail(ht, "%s on %s = %s, %d, %v; composition %s", name, show(string(src)), show(string(got)), nn, err, show(string(want)))
+			return
+		}
+		if s, nn, err := transform.String(c, string(src)); err != nil || nn != len(src) || s != string(want) {
+			fail(ht, "transform.String(%s, %s) = %s, %d, %v", name, show(string(src)), show(s), nn, err)
+		}
+		prefix := []byte(pick(ht, "", "xy"))
+		if a, _, err := transform.Append(c, append([]byte{}, prefix...), src); err != nil || string(a) != string(prefix)+string(want) {
+			fail(ht, "transform.Append(%s, %s, %s) = %s, %v", name, show(string(prefix)), show(string(src)), show(string(a)), err)
+		}
+		if out, err := drive(c, src, n(ht, 1, 7), n(ht, 1, 16)); err != nil || !bytes.Equal(out, want) {
+			fail(ht, "%s streamed %s to %s, %v; one shot %s", name, show(string(src)), show(string(out)), err, show(string(want)))
+		}
+		if out, err := viaReader(c, src, n(ht, 1, 7), n(ht, 1, 16)); err != nil || !bytes.Equal(out, want) {
+			fail(ht, "%s via NewReader on %s: %s, %v; one shot %s", name, show(string(src)), show(string(out)), err, show(string(want)))
+		}
+		if out, err := viaWriter(c, src, n(ht, 1, 7)); err != nil || !bytes.Equal(out, want) {
+			fail(ht, "%s via NewWriter on %s: %s, %v; one shot %s", name, show(string(src)), show(string(out)), err, show(string(want)))
+		}
+		if out, _, err := transform.Bytes(transform.Discard, src); err != nil || len(out) != 0 {
+			fail(ht, "Discard on %s: %s, %v", show(string(src)), show(string(out)), err)
+		}
+		if out, _, err := transform.Bytes(transform.Nop, src); err != nil || !bytes.Equal(out, src) {
+			fail(ht, "Nop on %s: %s, %v", show(string(src)), show(string(out)), err)
+		}
+		set := drawSet(ht)
+		a, _, _ := transform.Bytes(transform.RemoveFunc(set.f), src)
+		b := runes.Remove(set.set).Bytes(src)
+		if !bytes.Equal(a, b) {
+			fail(ht, "RemoveFunc(%s) on %s = %s, runes.Remove = %s", set.name, show(string(src)), show(string(a)), show(string(b)))
+		}
+	})
+}
