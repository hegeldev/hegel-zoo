+package hegel
+
+// One plain test per recorded bug in number, message and feature/plural,
+// asserting the correct behaviour so that it fails while the bug exists;
+// listed as expected failures in target.toml.
+
+import (
+	"fmt"
+	"testing"
+	"unicode/utf8"
+
+	"golang.org/x/text/feature/plural"
+	"golang.org/x/text/language"
+	"golang.org/x/text/message"
+	"golang.org/x/text/message/catalog"
+	"golang.org/x/text/number"
+)
+
+// x-text/36
+func TestHegelPinFormatterHonoursTheDirectiveWidth(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	if got := en.Sprintf("%8v", number.Decimal(12)); utf8.RuneCountInString(got) != 8 {
+		t.Errorf("Sprintf(%%8v, number.Decimal(12)) = %q (%d runes), want 8 runes: the package doc says the width in the directive overrides the formatter's configuration", got, utf8.RuneCountInString(got))
+	}
+	if got := en.Sprintf("%8d", number.Decimal(12)); utf8.RuneCountInString(got) != 8 {
+		t.Errorf("Sprintf(%%8d, number.Decimal(12)) = %q (%d runes), want 8 runes", got, utf8.RuneCountInString(got))
+	}
+}
+
+// x-text/37
+func TestHegelPinPrecisionOfGIsTheNumberOfSignificantDigits(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	if got, want := en.Sprintf("%.2g", 1234.5678), "1.2\u00d710\u2070\u00b3"; got != want {
+		t.Errorf("Sprintf(%%.2g, 1234.5678) = %q, want %q (fmt: %q)", got, want, fmt.Sprintf("%.2g", 1234.5678))
+	}
+	if got, want := en.Sprintf("%.3g", 12.345), "12.3"; got != want {
+		t.Errorf("Sprintf(%%.3g, 12.345) = %q, want %q (fmt: %q)", got, want, fmt.Sprintf("%.3g", 12.345))
+	}
+}
+
+// x-text/38
+func TestHegelPinHexFloatVerbs(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	for _, f := range []string{"%x", "%X", "%.3x"} {
+		if got, want := en.Sprintf(f, 1.5), fmt.Sprintf(f, 1.5); got != want {
+			t.Errorf("Sprintf(%q, 1.5) = %q, fmt %q", f, got, want)
+		}
+	}
+}
+
+// x-text/39
+func TestHegelPinMinFractionDigitsRaisesTheMaximum(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	if got := en.Sprintf("%v", number.Decimal(1.23456, number.MinFractionDigits(4))); got != "1.2346" {
+		t.Errorf("Decimal(1.23456, MinFractionDigits(4)) = %q, want 1.2346: four fraction digits are asked for, so the value is rounded to four, not to the pattern's three and padded", got)
+	}
+	if got := en.Sprintf("%v", number.PerMille(0.0462617, number.MinFractionDigits(2))); got != "46.26\u2030" {
+		t.Errorf("PerMille(0.0462617, MinFractionDigits(2)) = %q, want 46.26 per mille", got)
+	}
+}
+
+// x-text/40
+func TestHegelPinQuoteVerbOnANegativeInteger(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	format := "%q" // fmt prints the quoted (replacement) character for an integer
+	for _, v := range []int{-7, 0x110000} {
+		if got, want := en.Sprintf(format, v), fmt.Sprintf(format, v); got != want {
+			t.Errorf("Sprintf(%%q, %d) = %q, fmt %q", v, got, want)
+		}
+	}
+}
+
+// x-text/41
+func TestHegelPinGo113IntegerVerbs(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	if got, want := en.Sprintf("%#b", 8), fmt.Sprintf("%#b", 8); got != want {
+		t.Errorf("Sprintf(%%#b, 8) = %q, fmt %q", got, want)
+	}
+	if got, want := en.Sprintf("%O", 8), fmt.Sprintf("%O", 8); got != want {
+		t.Errorf("Sprintf(%%O, 8) = %q, fmt %q", got, want)
+	}
+	if got, want := en.Sprintf("%#g", 0.5), fmt.Sprintf("%#g", 0.5); got != want {
+		t.Errorf("Sprintf(%%#g, 0.5) = %q, fmt %q", got, want)
+	}
+}
+
+// x-text/43
+func TestHegelPinWidthDoesNotLeakIntoLaterDirectives(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	for _, f := range []string{"%5d|%.3d", "%5d|%.2f", "%6s|%.1f"} {
+		if got, want := en.Sprintf(f, 1, 2), fmt.Sprintf(f, 1, 2); got != want {
+			t.Errorf("Sprintf(%q, 1, 2) = %q, fmt %q: the second directive has no width", f, got, want)
+		}
+	}
+}
+
+// x-text/42
+func TestHegelPinSelectfAcceptsLargeExactSelectors(t *testing.T) {
+	b := catalog.NewBuilder()
+	err := b.Set(language.English, "%d things", plural.Selectf(1, "%d", "=70000", "seventy thousand", plural.Other, "%d things"))
+	if err != nil {
+		t.Fatalf("Set(Selectf(=70000 ...)): %v; the doc says x is an integer that matches the value of the argument", err)
+	}
+	p := message.NewPrinter(language.English, message.Catalog(b))
+	if got := p.Sprintf("%d things", 70000); got != "seventy thousand" {
+		t.Errorf("Selectf for 70000 = %q, want the =70000 case", got)
+	}
+}
