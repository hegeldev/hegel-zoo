@@ -0,0 +1,313 @@
+package hegel
+
+// Hegel properties for golang.org/x/text: the Unicode packages (norm, cases,
+// width, bidi, runenames, rangetable) against Python 3's unicodedata and
+// against their own doc comments, the encodings against round trips and the
+// streaming/one-shot equivalence every transform.Transformer promises, and
+// language, collate, precis, bidirule, number and message against models of
+// their documentation. Python 3 is the only external tool (python3 on PATH).
+//
+// Every property draws one case record built from the binding's combinators
+// (Composite for records, Lists for collections, OneOf and the local weighted
+// for choices) and renders it with pure functions; a position into live data
+// is drawn as a small integer and taken modulo the live size when applied.
+//
+// Conventions: hegel-go reads no environment variable itself, so
+// HEGEL_TEST_CASES (and HEGEL_VERBOSE) are passed through hegelOpts; a panic
+// in the code under test is turned into a failure of the current test case
+// by property().
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the gated shapes of each property so a run shows how often
+// the Known gates fire (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// fail is the properties' spelling of a failed check.
+func fail(ht *hegel.T, format string, args ...any) { ht.Fatalf(format, args...) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// show renders a string with every non-ASCII or control rune escaped, so a
+// failure message can be read and replayed.
+func show(s string) string { return strconv.QuoteToASCII(s) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// fixed is a list of exactly k elements.
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] { return many(g, k, k) }
+
+// cat draws one string from each generator and joins them: the pieces of a
+// text.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// runeStrings is a string of lo to hi runes of g (a weighted pool; for a
+// plain alphabet use alphabet).
+func runeStrings(g hegel.Generator[rune], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(many(g, lo, hi), func(rs []rune) string { return string(rs) })
+}
+
+// alphabet is a string of lo to hi runes from pool (a set: repeated runes do
+// not weight).
+func alphabet(pool []rune, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(string(pool)).MinSize(lo).MaxSize(hi)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// bytesOf: the bytes 0 to 255 as a byte.
+var bytesOf = hegel.Map(hegel.Integers(0, 255), func(b int) byte { return byte(b) })
+
+// ---------------------------------------------------------------------------
+// The Python oracle: one long-lived python3 process per test, spoken to in
+// JSON lines. Only valid UTF-8 travels over it (encoding/json replaces
+// anything else with U+FFFD).
+
+type oracle struct {
+	t   testing.TB
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  io.WriteCloser
+	out *bufio.Reader
+}
+
+const oracleScript = `
+import sys, json, unicodedata
+for line in sys.stdin:
+    r = json.loads(line)
+    op = r["op"]
+    s = r.get("s", "")
+    if op == "norm":
+        out = {f: unicodedata.normalize(f, s) for f in ("NFC", "NFD", "NFKC", "NFKD")}
+    elif op == "props":
+        out = [{"cat": unicodedata.category(c), "ccc": unicodedata.combining(c),
+                "name": unicodedata.name(c, ""), "eaw": unicodedata.east_asian_width(c),
+                "bidi": unicodedata.bidirectional(c), "decomp": unicodedata.decomposition(c),
+                "mirrored": unicodedata.mirrored(c)} for c in s]
+    elif op == "case":
+        out = {"upper": s.upper(), "lower": s.lower(), "fold": s.casefold(), "title": s.title()}
+    elif op == "decode":
+        try:
+            out = bytes(r["b"]).decode(r["codec"], errors="replace")
+        except LookupError:
+            out = None
+    elif op == "encode":
+        try:
+            out = list(s.encode(r["codec"]))
+        except UnicodeEncodeError:
+            out = None
+    else:
+        out = None
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+`
+
+func newOracle(t testing.TB) *oracle {
+	t.Helper()
+	cmd := exec.Command("python3", "-c", oracleScript)
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	outPipe, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &oracle{t: t, cmd: cmd, in: in, out: bufio.NewReaderSize(outPipe, 1<<20)}
+	t.Cleanup(func() {
+		in.Close()
+		cmd.Wait()
+	})
+	return o
+}
+
+func (o *oracle) call(req map[string]any, into any) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		o.t.Fatal(err)
+	}
+	if _, err := o.in.Write(append(b, '\n')); err != nil {
+		o.t.Fatalf("writing to python3: %v", err)
+	}
+	line, err := o.out.ReadBytes('\n')
+	if err != nil {
+		o.t.Fatalf("reading from python3: %v", err)
+	}
+	if err := json.Unmarshal(line, into); err != nil {
+		o.t.Fatalf("python3 answered %q: %v", line, err)
+	}
+}
+
+type runeProps struct {
+	Cat      string `json:"cat"`
+	CCC      int    `json:"ccc"`
+	Name     string `json:"name"`
+	EAW      string `json:"eaw"`
+	Bidi     string `json:"bidi"`
+	Decomp   string `json:"decomp"`
+	Mirrored int    `json:"mirrored"`
+}
+
+// props asks Python for the Unicode 15.0 properties of every rune of s.
+func (o *oracle) props(s string) []runeProps {
+	var ps []runeProps
+	o.call(map[string]any{"op": "props", "s": s}, &ps)
+	return ps
+}
