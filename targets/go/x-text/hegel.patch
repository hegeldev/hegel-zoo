+	0xE0100, 0x0300, 0x00E9,
+}
+
+var kindNames = map[width.Kind]string{
+	width.Neutral: "N", width.EastAsianAmbiguous: "A", width.EastAsianWide: "W",
+	width.EastAsianNarrow: "Na", width.EastAsianFullwidth: "F", width.EastAsianHalfwidth: "H",
+}
+
+var widthTransformerNames = []string{"Fold", "Narrow", "Widen"}
+
+// widthCase: up to ten runes (a width rune half of the time, a halfwidth or
+// fullwidth form one time in five, any rune otherwise), the transformer
+// whose streaming is checked, and how it is streamed.
+type widthCase struct {
+	rs     []rune
+	tr     int
+	stream streaming
+}
+
+func (c widthCase) GoString() string {
+	return fmt.Sprintf("%s, %s: %#v", show(string(c.rs)), widthTransformerNames[c.tr], c.stream)
+}
+
+var widthCases = hegel.Composite(func(tc hegel.TestCase) widthCase {
+	return widthCase{
+		rs: hegel.Draw(tc, many(weighted(
+			choice[rune]{5, hegel.SampledFrom(widthRunes)},
+			choice[rune]{2, hegel.Integers[rune](0xFF01, 0xFFEE)},
+			choice[rune]{3, anyRunes},
+		), 0, 10)),
+		tr:     hegel.Draw(tc, hegel.Integers(0, len(widthTransformerNames)-1)),
+		stream: hegel.Draw(tc, streamings(30, 16, 6, 12)),
+	}
+})
+
+// The East Asian width kinds agree with Python's east_asian_width; Folded,
+// Narrow and Wide are consistent with the kinds and with NFKC; the Fold,
+// Narrow and Widen transformers map rune by rune, span exactly and stream.
+func TestHegelWidthAgreesWithPython(t *testing.T) {
+	py := newOracle(t)
+	transformers := []struct {
+		name string
+		t    width.Transformer
+		fn   func(width.Properties) rune
+	}{
+		{"Fold", width.Fold, width.Properties.Folded},
+		{"Narrow", width.Narrow, width.Properties.Narrow},
+		{"Widen", width.Widen, width.Properties.Wide},
+	}
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, widthCases)
+		rs := c.rs
+		s := string(rs)
+		ps := py.props(s)
+		if len(ps) != len(rs) {
+			fail(ht, "Python saw %d runes in %s, Go %d", len(ps), show(s), len(rs))
+			return
+		}
+		for i, r := range rs {
+			if ps[i].Cat == "Cn" {
+				count(ht, "unassigned-in-15")
+				continue
+			}
+			p := width.LookupRune(r)
+			k := p.Kind()
+			if kindNames[k] != ps[i].EAW {
+				if 0x1D300 <= r && r <= 0x1D356 {
+					// The Tai Xuan Jing symbols became Wide after Unicode 15.
+					count(ht, "width-newer-than-python")
+				} else {
+					fail(ht, "LookupRune(%U).Kind() = %v, Python east_asian_width %s", r, k, ps[i].EAW)
+				}
+			}
+			f, nw, wd := p.Folded(), p.Narrow(), p.Wide()
+			isFH := k == width.EastAsianFullwidth || k == width.EastAsianHalfwidth
+			if (f != 0) != isFH {
+				if r == 0x20A9 {
+					// The won sign is halfwidth by fiat and has no decomposition.
+					count(ht, "won-sign")
+				} else {
+					fail(ht, "%U is %v but Folded() = %U", r, k, f)
+				}
+			}
+			// Folded is the width decomposition alone (a halfwidth Hangul letter
+			// folds to the compatibility jamo, which NFKC decomposes further).
+			if f != 0 && norm.NFKC.String(string(r)) != norm.NFKC.String(string(f)) {
+				fail(ht, "%U Folded() = %U but NFKC = %s", r, f, show(norm.NFKC.String(string(r))))
+			}
+			if nw != 0 {
+				if nw == r || (k != width.EastAsianFullwidth && k != width.EastAsianWide && k != width.EastAsianAmbiguous) {
+					fail(ht, "%U (%v) has Narrow() = %U", r, k, nw)
+				}
+				if kk := width.LookupRune(nw).Kind(); kk == width.EastAsianFullwidth || kk == width.EastAsianWide {
+					fail(ht, "Narrow(%U) = %U is %v", r, nw, kk)
+				}
+				if back := width.LookupRune(nw).Wide(); back != r {
+					count(ht, "wide-of-narrow-differs")
+					note(ht, "Wide(Narrow(%U) = %U) = %U", r, nw, back)
+				}
+				if k == width.EastAsianFullwidth && f != nw {
+					fail(ht, "fullwidth %U: Folded() = %U, Narrow() = %U", r, f, nw)
+				}
+			}
+			if wd != 0 {
+				if wd == r || (k != width.EastAsianHalfwidth && k != width.EastAsianNarrow) {
+					fail(ht, "%U (%v) has Wide() = %U", r, k, wd)
+				}
+				if kk := width.LookupRune(wd).Kind(); kk == width.EastAsianNarrow || kk == width.EastAsianHalfwidth {
+					fail(ht, "Wide(%U) = %U is %v", r, wd, kk)
+				}
+				if back := width.LookupRune(wd).Narrow(); back != r {
+					count(ht, "narrow-of-wide-differs")
+					note(ht, "Narrow(Wide(%U) = %U) = %U", r, wd, back)
+				}
+				if k == width.EastAsianHalfwidth && f != 0 && f != wd {
+					fail(ht, "halfwidth %U: Folded() = %U, Wide() = %U", r, f, wd)
+				}
+			}
+		}
+		// The transformers map rune by rune.
+		for _, tr := range transformers {
+			var b strings.Builder
+			for _, r := range rs {
+				if x := tr.fn(width.LookupRune(r)); x != 0 {
+					b.WriteRune(x)
+				} else {
+					b.WriteRune(r)
+				}
+			}
+			want := b.String()
+			got := tr.t.String(s)
+			if got != want {
+				fail(ht, "width.%s(%s) = %s, rune by rune %s", tr.name, show(s), show(got), show(want))
+			}
+			if x := string(tr.t.Bytes([]byte(s))); x != got {
+				fail(ht, "width.%s.Bytes(%s) = %s but String = %s", tr.name, show(s), show(x), show(got))
+			}
+			tr.t.Reset()
+			sp, _ := tr.t.Span([]byte(s), true)
+			if sp < 0 || sp > len(s) || (sp == len(s)) != (got == s) || tr.t.String(s[:sp]) != s[:sp] {
+				fail(ht, "width.%s.Span(%s) = %d, String = %s", tr.name, show(s), sp, show(got))
+			}
+		}
+		// Streaming, on any bytes.
+		tr := transformers[c.tr]
+		src := c.stream.src(s)
+		out, err := drive(tr.t, src, c.stream.chunk, c.stream.dst)
+		if err != nil {
+			fail(ht, "width.%s streaming %s: %v", tr.name, show(string(src)), err)
+		}
+		if whole := tr.t.Bytes(src); !bytes.Equal(out, whole) {
+			fail(ht, "width.%s streamed %s to %s, Bytes gives %s", tr.name, show(string(src)), show(string(out)), show(string(whole)))
+		}
+	})
+}
