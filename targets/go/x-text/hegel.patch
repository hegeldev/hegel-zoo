+}
+
+var assigned15 = rangetable.Assigned("15.0.0")
+
+// assignedPools are the runes assigned in Unicode 15.0 (known to Python 3.12
+// and to x/text alike), never a surrogate, in three bands: below U+3000 (the
+// scripts), the rest of the BMP (CJK, Hangul, the compatibility forms) and
+// the astral planes.
+var assignedPools = func() (pools [3][]rune) {
+	rangetable.Visit(assigned15, func(r rune) {
+		switch {
+		case r >= 0xD800 && r <= 0xDFFF:
+		case r < 0x3000:
+			pools[0] = append(pools[0], r)
+		case r <= 0xFFFF:
+			pools[1] = append(pools[1], r)
+		default:
+			pools[2] = append(pools[2], r)
+		}
+	})
+	return pools
+}()
+
+// assignedRunes: an assigned rune, from the three bands five, two and three
+// times in ten.
+var assignedRunes = weighted(
+	choice[rune]{5, hegel.SampledFrom(assignedPools[0])},
+	choice[rune]{2, hegel.SampledFrom(assignedPools[1])},
+	choice[rune]{3, hegel.SampledFrom(assignedPools[2])},
+)
+
+// anyRunes: an interesting rune half of the time, a letter a to e once in
+// ten, else an assigned one.
+var anyRunes = weighted(
+	choice[rune]{5, hegel.SampledFrom(interestingRunes)},
+	choice[rune]{1, hegel.Integers[rune]('a', 'e')},
+	choice[rune]{4, assignedRunes},
+)
+
+// wideRunes: anyRunes with a fifth of the draws from all of the code space
+// (a surrogate becomes U+FFFD).
+var wideRunes = weighted(
+	choice[rune]{5, hegel.SampledFrom(interestingRunes)},
+	choice[rune]{1, hegel.Integers[rune]('a', 'e')},
+	choice[rune]{2, assignedRunes},
+	choice[rune]{2, hegel.Map(hegel.Integers[rune](0, unicode.MaxRune), func(r rune) rune {
+		if r >= 0xD800 && r <= 0xDFFF {
+			return 0xFFFD
+		}
+		return r
+	})},
+)
+
+// texts15 is a string of lo to hi runes assigned in Unicode 15.0 (valid
+// UTF-8).
+func texts15(lo, hi int) hegel.Generator[string] { return runeStrings(anyRunes, lo, hi) }
+
+// illFormed are ill-formed UTF-8 sequences: a lone continuation byte, an
+// overlong NUL, a truncated sequence, a code point past U+10FFFF, a
+// surrogate, an invalid byte and a truncated two-byte lead.
+var illFormed = hegel.SampledFrom([][]byte{{0x80}, {0xC0, 0x80}, {0xE2, 0x82}, {0xF4, 0x90, 0x80, 0x80}, {0xED, 0xA0, 0x80}, {0xFF}, {0xC3}})
+
+// anyBytes is a byte string of lo to hi pieces: the UTF-8 of a rune of all
+// of the code space, or an ill-formed sequence eight times in a hundred.
+func anyBytes(lo, hi int) hegel.Generator[[]byte] {
+	piece := weighted(
+		choice[[]byte]{92, hegel.Map(wideRunes, func(r rune) []byte { return utf8.AppendRune(nil, r) })},
+		choice[[]byte]{8, illFormed},
+	)
+	return hegel.Map(many(piece, lo, hi), func(ps [][]byte) []byte { return bytes.Join(ps, nil) })
+}
+
+// ---------------------------------------------------------------------------
+// Driving a transform.Transformer by the letter of its contract.
+
+var errNoProgress = errors.New("Transform made no progress with a large destination")
+
+// drive feeds src to t in pieces of at most chunk bytes (growing the piece on
+// ErrShortSrc) through a destination buffer of dstSize bytes (doubled when a
+// call makes no progress with ErrShortDst), and returns the concatenated
+// output. It checks the contract: a nil error means nSrc == len(src), and
+// ErrShortSrc is never returned with atEOF.
+func drive(t transform.Transformer, src []byte, chunk, dstSize int) ([]byte, error) {
+	t.Reset()
+	var out []byte
+	dst := make([]byte, dstSize)
+	pos, span := 0, chunk
+	for steps := 0; ; steps++ {
+		if steps > 20000 {
+			return out, errNoProgress
+		}
+		end := pos + span
+		if end > len(src) {
+			end = len(src)
+		}
+		atEOF := end == len(src)
+		nDst, nSrc, err := t.Transform(dst, src[pos:end], atEOF)
+		if nDst > len(dst) || nSrc > end-pos || nDst < 0 || nSrc < 0 {
+			return out, fmt.Errorf("Transform returned nDst=%d nSrc=%d for len(dst)=%d len(src)=%d", nDst, nSrc, len(dst), end-pos)
+		}
+		out = append(out, dst[:nDst]...)
+		pos += nSrc
+		switch err {
+		case nil:
+			if nSrc != end-pos+nSrc {
+				return out, fmt.Errorf("nil error with nSrc=%d < len(src)=%d", nSrc, end-pos+nSrc)
+			}
+			if atEOF {
+				return out, nil
+			}
+			span = chunk
+		case transform.ErrShortDst:
+			if nDst == 0 && nSrc == 0 {
+				if len(dst) > 1<<20 {
+					return out, errNoProgress
+				}
+				dst = make([]byte, 2*len(dst))
+			}
+		case transform.ErrShortSrc:
+			if atEOF {
+				return out, errors.New("ErrShortSrc returned with atEOF")
+			}
+			span = end - pos + chunk
+			if nSrc == 0 && nDst == 0 && span > len(src)-pos+chunk {
+				return out, errNoProgress
+			}
+		default:
+			return out, err
+		}
+	}
+}
+
+// chunkedReader returns at most k bytes per Read.
+type chunkedReader struct {
+	r io.Reader
+	k int
+}
+
+func (c *chunkedReader) Read(p []byte) (int, error) {
+	if len(p) > c.k {
+		p = p[:c.k]
+	}
+	return c.r.Read(p)
+}
+
+// viaReader runs t through transform.NewReader over a source that yields k
+// bytes at a time, reading with buffers of size m.
+func viaReader(t transform.Transformer, src []byte, k, m int) ([]byte, error) {
+	t.Reset()
+	r := transform.NewReader(&chunkedReader{bytes.NewReader(src), k}, t)
+	var out []byte
+	buf := make([]byte, m)
+	for i := 0; i < 1000000; i++ {
+		nr, err := r.Read(buf)
+		out = append(out, buf[:nr]...)
+		if err == io.EOF {
+			return out, nil
+		}
+		if err != nil {
+			return out, err
+		}
+	}
+	return out, errNoProgress
+}
+
+// viaWriter runs t through transform.NewWriter with writes of k bytes.
+func viaWriter(t transform.Transformer, src []byte, k int) ([]byte, error) {
+	t.Reset()
+	var buf bytes.Buffer
+	w := transform.NewWriter(&buf, t)
+	for i := 0; i < len(src); i += k {
+		j := i + k
+		if j > len(src) {
+			j = len(src)
+		}
+		if _, err := w.Write(src[i:j]); err != nil {
+			return buf.Bytes(), err
+		}
+	}
+	if err := w.Close(); err != nil {
+		return buf.Bytes(), err
+	}
+	return buf.Bytes(), nil
+}
