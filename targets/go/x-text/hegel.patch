+
+func cjkString(tc hegel.TestCase, lo, hi int) string {
+	k := n(tc, lo, hi)
+	rs := make([]rune, 0, k)
+	for i := 0; i < k; i++ {
+		if chance(tc, 15) {
+			rs = append(rs, assignedRune(tc))
+		} else {
+			rs = append(rs, pick(tc, cjkRunes...))
+		}
+	}
+	return string(rs)
+}
