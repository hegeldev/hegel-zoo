+// Currency units round-trip through their ISO code, FromRegion agrees with
+// the Query, and FromTag follows the region.
+func TestHegelCurrencyUnitsRoundTrip(t *testing.T) {
+	var units []currency.Unit
+	for it := currency.Query(currency.Historical, currency.NonTender); it.Next(); {
+		units = append(units, it.Unit())
+	}
+	property(t, func(ht *hegel.T) {
+		u := pick(ht, units...)
+		code := u.String()
+		if len(code) != 3 {
+			fail(ht, "currency %v has code %q", u, code)
+		}
+		// Units compare by table index and the query may yield a unit under
+		// another index than ParseISO; compare the codes.
+		back, err := currency.ParseISO(pick(ht, code, strings.ToLower(code)))
+		if err != nil || back.String() != code {
+			fail(ht, "ParseISO(%q) = %v, %v", code, back, err)
+		}
+		for _, k := range []currency.Kind{currency.Standard, currency.Cash, currency.Accounting} {
+			scale, inc := k.Rounding(u)
+			if scale < 0 || scale > 4 || inc < 1 {
+				fail(ht, "%v rounding of %v: scale %d increment %d", k, u, scale, inc)
+			}
+		}
+		region := pick(ht, "US", "GB", "DE", "CH", "JP", "BR", "IN", "ZZ", "001", "XK", "ZW")
+		r := language.MustParseRegion(region)
+		fr, ok := currency.FromRegion(r)
+		tag := language.MustParse("en-" + region)
+		ft, conf := currency.FromTag(tag)
+		if ok && (ft != fr || conf != language.Exact) {
+			fail(ht, "FromRegion(%s) = %v but FromTag(%v) = %v, %v", region, fr, tag, ft, conf)
+		}
+		if rg := pick(ht, "gbzzzz", "dezzzz", "jpzzzz"); ok && chance(ht, 50) {
+			t2 := language.MustParse("en-" + region + "-u-rg-" + rg)
+			want, _ := currency.FromRegion(language.MustParseRegion(strings.ToUpper(rg[:2])))
+			if got, _ := currency.FromTag(t2); got != want {
+				if Known.CurrencyIgnoresRg {
+					count(ht, "known x-text/20")
+					return
+				}
+				fail(ht, "FromTag(%v) = %v, the rg override says %v", t2, got, want)
+			}
+		}
+		_ = fmt.Sprint
+	})
+}
