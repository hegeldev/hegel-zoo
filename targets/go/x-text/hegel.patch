+package hegel
+
+// Known lists the recorded bugs (bugs.toml) the properties gate on: a
+// property counts a shape as `x-text/N` only when the mismatch actually occurs,
+// and never works around a bug otherwise.
+var Known = struct {
+	// 1: Form.String/Bytes/Transform insert U+034F into a run of more than 30
+	// non-starters (stream-safe processing), undocumented and not the
+	// normalization form.
+	StreamSafeCGJ bool
+	// 2: Iter does not count Hangul V/T jamo towards the 30 non-starters
+	// while String/Bytes do, so their outputs differ.
+	IterJamoCGJ bool
+	// 3: the HZ-GB2312 encoder writes ~} on an unsupported rune but stays in
+	// GB mode, so the wrappers' output is not decodable.
+	HZModeAfterError bool
+	// 4: GB18030 encodes 2,068 private-use runes to four-byte sequences its
+	// decoder reads as other runes.
+	GB18030PrivateUse bool
+	// 5: ianaindex names the UTF-32 encodings but Encoding(name) is nil.
+	IANAUTF32 bool
+	// 6: variants that Parse has to reorder swallow the extensions.
+	SortedVariantsExtension bool
+	// 8: a -u-ka-shifted collator compares every pair of strings equal.
+	ShiftedCompare bool
+	// 9: collate.IgnoreWidth does nothing.
+	IgnoreWidthNoop bool
+	// 10: collate.Force is honoured by Compare but not by Key.
+	ForceNotInKey bool
+	// 11: a boolean -u key without a type (fr-u-kb) is ignored.
+	BoolKeyWithoutType bool
+	// 14: search.Equal is false on the empty string and on mark-only strings.
+	SearchEqualEmptyMarks bool
+	// 16: SetTypeForKey keeps the case of its arguments.
+	SetTypeForKeyCase bool
+	// 17: -u attributes are sorted by their first three bytes only.
+	AttributeSort3 bool
+	// 18: ParseBase of an ISO 639-3 code returns the deprecated 639-1 code.
+	ParseBaseDeprecated bool
+	// 19: Matcher.Match overwrites the desired tag's -u-rg-.
+	MatchOverwritesRg bool
+	// 20: currency.FromTag ignores -u-rg-.
+	CurrencyIgnoresRg bool
+	// 24: collate.IgnoreDiacritics drops the secondary level only, so the
+	// marks' tertiary weights still tell o from o-diaeresis unless case is
+	// ignored too.
+	IgnoreDiacriticsTertiary bool
+	// 25: bidi.ReverseString reverses rune by rune, so a combining mark ends
+	// up before its base rune, against its documentation.
+	ReverseSplitsMarks bool
+	// 26: the username profiles accept the empty string, which RFC 8265
+	// forbids after mapping.
+	UsernameEmpty bool
+	// 27: the username profiles apply the Bidi Rule to non-ASCII strings
+	// without RTL characters (and skip it for ASCII ones).
+	BidiRuleOnLTR bool
+	// 28: Paragraph.RunAt always returns the last run.
+	RunAtIsLastRun bool
+	// 29: Ordering.Direction is the first run's direction, never Mixed or
+	// Neutral.
+	DirectionIsFirstRun bool
+	// 31: Order includes the text after the first paragraph separator in the
+	// last run.
+	OrderPastSeparator bool
+	// 32: cases.Fold maps the Cherokee capitals to the small letters (the
+	// folding goes the other way), so folding is not idempotent.
+	FoldCherokee bool
+	// 33: Lower and Title forget across Transform calls that the previous
+	// rune was a cased letter, so a capital sigma at a call boundary becomes
+	// a medial sigma instead of the final one.
+	SigmaAcrossCalls bool
+	// 34: bidirule.Transformer's Span checks that the label ended in a final
+	// class even when atEOF is false, so a chunk ending after ES, CS, ET, ON
+	// or BN fails a valid label.
+	BidiRuleSpanNotFinal bool
+	// 35: bidi.Lookup decodes surrogates and code points past U+10FFFF as
+	// characters, so bidirule.Valid accepts those ill-formed sequences.
+	BidiLookupLenient bool
+	// 36: number.Formatter ignores the width of the formatting directive
+	// unless a Pad option was given (the pad rune stays 0).
+	FormatterIgnoresWidth bool
+	// 37: the Printer's %.Ng (and %.Nv) on a float prints N+1 significant
+	// digits.
+	PrecisionGOneTooMany bool
+	// 38: the Printer's %x and %X on a float print a bad-verb marker where
+	// fmt prints the hexadecimal float.
+	FloatHexVerb bool
+	// 39: number.MinFractionDigits above the maximum rounds at the maximum
+	// and pads zeros (1.23456 -> 1.2350) instead of raising the maximum.
+	MinFractionAboveMax bool
+	// 40: the Printer's %q on a negative integer prints a bad-verb marker
+	// where fmt prints the quoted replacement character.
+	QuoteNegativeInt bool
+	// 41: the Printer predates Go 1.13: %O is a bad verb and %#b has no 0b
+	// prefix.
+	Go113IntVerbs bool
+	// 42: plural.Selectf parses the number of an =x or <x selector as a
+	// 16-bit integer, so values above 65535 cannot be selected.
+	SelectorUint16 bool
+	// 43: a width given in an earlier directive is applied again by a later
+	// directive that has a precision but no width.
+	WidthLeaks bool
+	// 44: the ISO-2022-JP encoder passes U+001B through unescaped, and the
+	// decoder reads it as the start of an escape sequence.
+	ISO2022JPEscape bool
+	// 45: under NFKC, BoundaryBefore is true for the compatibility Hangul
+	// letters that decompose to a V or T jamo, which compose to the left.
+	NFKCCompatJamoBoundary bool
+}{
+	StreamSafeCGJ:           true,
+	IterJamoCGJ:             true,
+	HZModeAfterError:        true,
+	GB18030PrivateUse:       true,
+	IANAUTF32:               true,
+	SortedVariantsExtension: true,
+	ShiftedCompare:          true,
+	IgnoreWidthNoop:         true,
+	ForceNotInKey:           true,
+	BoolKeyWithoutType:      true,
+	SearchEqualEmptyMarks:   true,
+	SetTypeForKeyCase:       true,
+	AttributeSort3:          true,
+	ParseBaseDeprecated:     true,
+	MatchOverwritesRg:       true,
+	CurrencyIgnoresRg:       true,
+
+	IgnoreDiacriticsTertiary: true,
+	ReverseSplitsMarks:       true,
+	UsernameEmpty:            true,
+	BidiRuleOnLTR:            true,
+	RunAtIsLastRun:           true,
+	DirectionIsFirstRun:      true,
+	OrderPastSeparator:       true,
+	FoldCherokee:             true,
+	SigmaAcrossCalls:         true,
+	BidiRuleSpanNotFinal:     true,
+	BidiLookupLenient:        true,
+	FormatterIgnoresWidth:    true,
+	PrecisionGOneTooMany:     true,
+	FloatHexVerb:             true,
+	MinFractionAboveMax:      true,
+	QuoteNegativeInt:         true,
+	Go113IntVerbs:            true,
+	SelectorUint16:           true,
+	WidthLeaks:               true,
+	ISO2022JPEscape:          true,
+	NFKCCompatJamoBoundary:   true,
+}
