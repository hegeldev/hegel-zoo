+package hegel
+
+// cases, width, unicode/bidi, secure/bidirule and secure/precis against
+// Python's unicodedata (Unicode 15.0), RFC 5893 and RFC 8265, and against the
+// packages' own contracts.
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/text/cases"
+	"golang.org/x/text/language"
+	"golang.org/x/text/secure/bidirule"
+	"golang.org/x/text/secure/precis"
+	"golang.org/x/text/unicode/bidi"
+	"golang.org/x/text/unicode/norm"
+	"golang.org/x/text/width"
+	"hegel.dev/go/hegel"
+)
+
+// catch runs fn and returns the message of the panic it raised, if any.
+func catch(fn func()) (msg string) {
+	defer func() {
+		if r := recover(); r != nil {
+			msg = fmt.Sprint(r)
+		}
+	}()
+	fn()
+	return ""
+}
+
+// streaming is how a Transformer is driven in a case: on the case's own
+// text, or on any bytes when alt is set, in pieces of chunk bytes through a
+// destination buffer of dst bytes.
+type streaming struct {
+	alt        *[]byte
+	chunk, dst int
+}
+
+// src is the bytes to stream: alt when set, else the text.
+func (s streaming) src(text string) []byte {
+	if s.alt != nil {
+		return *s.alt
+	}
+	return []byte(text)
+}
+
+func (s streaming) GoString() string {
+	if s.alt != nil {
+		return fmt.Sprintf("stream %s in %d-byte pieces, dst %d", show(string(*s.alt)), s.chunk, s.dst)
+	}
+	return fmt.Sprintf("stream the text in %d-byte pieces, dst %d", s.chunk, s.dst)
+}
+
+// streamings: any bytes of up to altMax instead of the text altPct percent
+// of the time, pieces of 1 to maxChunk bytes, a destination of 1 to maxDst.
+func streamings(altPct, altMax, maxChunk, maxDst int) hegel.Generator[streaming] {
+	return hegel.Composite(func(tc hegel.TestCase) streaming {
+		return streaming{
+			alt:   hegel.Draw(tc, optional(altPct, anyBytes(0, altMax))),
+			chunk: hegel.Draw(tc, hegel.Integers(1, maxChunk)),
+			dst:   hegel.Draw(tc, hegel.Integers(1, maxDst)),
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// cases
+
+// caseRunes have interesting case mappings: one-to-many mappings, sigma,
+// dotted and dotless i, titlecase digraphs, Cherokee (which folds to upper
+// case), Greek with iota subscript, combining marks, and some punctuation.
+var caseRunes = []rune{
+	'a', 'b', 'z', 'A', 'Z', 'i', 'I', 0x0130, 0x0131, 0x0307, 0x00DF, 0x1E9E, 0x0149, 0x01F0, 0x0390, 0x03B0,
+	0xFB01, 0xFB00, 0xFB05, 0xFB13, 0x03A3, 0x03C3, 0x03C2, 0x0345, 0x1FB3, 0x1F88, 0x1FBC, 0x01C4, 0x01C5, 0x01C6,
+	0x01C8, 0x13A0, 0xAB70, 0xAB78, 0x13F8, 0x00B5, 0x017F, 0x03D0, 0x03D1, 0x03F5, 0x1E9B, 0x0587, 0x2126, 0x212A,
+	0x212B, 0x0301, 0x0308, 0x0300, 0x0323, ' ', '\'', '-', '1', '.', 0x2019, 0x00A0, 0x200D, 0x10D0, 0x1C90,
+	0x10400, 0x10428, 0x1E900, 0x1E922, 0x2C00, 0x2C30, 0x0410, 0x0430, 0x1C80, 0x1C88, 0xA64A, 0x1E00, 0x1E01,
+	0x0100, 0x0101, 0x01C7, 0x01CB, 0x1F50, 0x1F56, 0x1FE4, 0x03A9, 0x03C9, 0x0049, 0x0069,
+}
+
+// titleRunes are the cased letters of caseRunes and the space: a text of
+// them alone is one whose title case Python and the Title caser agree on.
+var titleRunes = func() []rune {
+	rs := []rune{' '}
+	for _, r := range caseRunes {
+		if unicode.In(r, unicode.Lu, unicode.Ll, unicode.Lt) {
+			rs = append(rs, r)
+		}
+	}
+	return rs
+}()
+
+// caseTexts: a short string biased towards the case-interesting runes: up to
+// ten runes, each a case rune three times in five and any rune otherwise;
+// three times in ten cased letters and spaces only; one time in five a
+// plain text.
+var caseTexts = weighted(
+	choice[string]{50, runeStrings(weighted(choice[rune]{60, hegel.SampledFrom(caseRunes)}, choice[rune]{40, anyRunes}), 0, 10)},
+	choice[string]{30, alphabet(titleRunes, 0, 10)},
+	choice[string]{20, texts15(0, 10)},
+)
+
+// titleSafe reports whether s is made of cased letters and spaces only; there
+// Python's str.title (which titles the first cased letter after an uncased
+// one) and the word-break based Title caser agree by construction.
+func titleSafe(s string) bool {
+	for _, r := range s {
+		if r != ' ' && !unicode.In(r, unicode.Lu, unicode.Ll, unicode.Lt) {
+			return false
+		}
+	}
+	return true
+}
+
+// allAssigned15 reports whether every rune of s is assigned in Unicode 15.
+func allAssigned15(s string) bool {
+	for _, r := range s {
+		if !unicode.Is(assigned15, r) {
+			return false
+		}
+	}
+	return true
+}
+
+// hasCherokee reports whether s has a Cherokee letter (the script whose
+// small letters fold to the capitals).
+func hasCherokee(s string) bool {
+	for _, r := range s {
+		if (0x13A0 <= r && r <= 0x13FD) || (0xAB70 <= r && r <= 0xABBF) {
+			return true
+		}
+	}
+	return false
+}
+
+// sameButSigmas reports whether a and b differ only in final versus
+// non-final small sigmas (U+03C2 against U+03C3).
+func sameButSigmas(a, b string) bool {
+	final, nonFinal := string(rune(0x03C2)), string(rune(0x03C3))
+	return strings.ReplaceAll(a, final, nonFinal) == strings.ReplaceAll(b, final, nonFinal)
+}
+
+type pyCase struct {
+	Upper string `json:"upper"`
+	Lower string `json:"lower"`
+	Fold  string `json:"fold"`
+	Title string `json:"title"`
+}
+
+var caserNames = []string{"Upper", "Lower", "Fold", "Title"}
+
+// caseMapCase: the text, the caser (by index) whose streaming is checked,
+// and how it is streamed.
+type caseMapCase struct {
+	s      string
+	caser  int
+	stream streaming
+}
+
+func (c caseMapCase) GoString() string {
+	return fmt.Sprintf("%s, %s: %#v", show(c.s), caserNames[c.caser], c.stream)
+}
+
+var caseMapCases = hegel.Composite(func(tc hegel.TestCase) caseMapCase {
+	return caseMapCase{
+		s:      hegel.Draw(tc, caseTexts),
+		caser:  hegel.Draw(tc, hegel.Integers(0, len(caserNames)-1)),
+		stream: hegel.Draw(tc, streamings(30, 16, 7, 16)),
+	}
+})
+
+// The root-locale Upper, Lower, Fold and Title casers agree with Python's
+// str.upper/lower/casefold/title, satisfy the standard's identities, span
+// exactly what they leave unchanged and stream like they map whole strings.
+func TestHegelCaseMappingsAgreeWithPython(t *testing.T) {
+	py := newOracle(t)
+	upper, lower, fold, title := cases.Upper(language.Und), cases.Lower(language.Und), cases.Fold(), cases.Title(language.Und)
+	casers := []struct {
+		name string
+		c    cases.Caser
+	}{{"Upper", upper}, {"Lower", lower}, {"Fold", fold}, {"Title", title}}
+	property(t, func(ht *hegel.T) {
+		cs := hegel.Draw(ht, caseMapCases)
+		s := cs.s
+		var want pyCase
+		py.call(map[string]any{"op": "case", "s": s}, &want)
+		got := map[string]string{}
+		for _, c := range casers {
+			got[c.name] = c.c.String(s)
+			if b := string(c.c.Bytes([]byte(s))); b != got[c.name] {
+				// Bytes grows its buffer mid-word when a mapping expands (U+0130
+				// to i + U+0307), and the final-sigma context is lost across the
+				// calls (bug 33).
+				if Known.SigmaAcrossCalls && c.name != "Upper" && c.name != "Fold" && sameButSigmas(b, got[c.name]) {
+					count(ht, "known x-text/33")
+				} else {
+					fail(ht, "%s.Bytes(%s) = %s but String = %s", c.name, show(s), show(b), show(got[c.name]))
+				}
+			}
+		}
+		// A mapping to a rune Unicode 15 did not have (U+0264's capital U+A7CB
+		// came with Unicode 16) is a version difference, not a disagreement.
+		newer := func(name string) bool {
+			if allAssigned15(got[name]) {
+				return false
+			}
+			count(ht, "mapping-newer-than-python")
+			return true
+		}
+		if got["Upper"] != want.Upper && !newer("Upper") {
+			fail(ht, "Upper(%s) = %s, Python %s", show(s), show(got["Upper"]), show(want.Upper))
+		}
+		if got["Lower"] != want.Lower && !newer("Lower") {
+			fail(ht, "Lower(%s) = %s, Python %s", show(s), show(got["Lower"]), show(want.Lower))
+		}
+		if got["Fold"] != want.Fold && !newer("Fold") {
+			if Known.FoldCherokee && hasCherokee(s) {
+				count(ht, "known x-text/32")
+			} else {
+				fail(ht, "Fold(%s) = %s, Python casefold %s", show(s), show(got["Fold"]), show(want.Fold))
+			}
+		}
+		if titleSafe(s) {
+			if got["Title"] != want.Title && !newer("Title") {
+				fail(ht, "Title(%s) = %s, Python %s", show(s), show(got["Title"]), show(want.Title))
+			}
+		} else {
+			count(ht, "title-not-compared")
+		}
+		// The mappings are idempotent (Unicode 3.13).
+		for _, c := range casers {
+			if c.name == "Title" {
+				continue
+			}
+			if x := c.c.String(got[c.name]); x != got[c.name] {
+				if c.name == "Fold" && Known.FoldCherokee && hasCherokee(s) {
+					count(ht, "known x-text/32")
+				} else {
+					fail(ht, "%s is not idempotent on %s: %s then %s", c.name, show(s), show(got[c.name]), show(x))
+				}
+			}
+		}
+		// Span: the unchanged prefix is a fixed point, and a full span means
+		// the whole string is one. The casers are stateful: Reset first (as
+		// String does), or Title's word state carries over.
+		for _, c := range casers {
+			c.c.Reset()
+			k, _ := c.c.Span([]byte(s), true)
+			if k < 0 || k > len(s) || !utf8.ValidString(s[:k]) {
+				fail(ht, "%s.Span(%s) = %d", c.name, show(s), k)
+				return
+			}
+			if x := c.c.String(s[:k]); x != s[:k] {
+				fail(ht, "%s.Span(%s) = %d but %s(prefix) = %s", c.name, show(s), k, c.name, show(x))
+			} else if k == len(s) && got[c.name] != s {
+				fail(ht, "%s.Span(%s) is the whole string but %s = %s", c.name, show(s), c.name, show(got[c.name]))
+			}
+			if k < len(s) && got[c.name] == s {
+				count(ht, "span-conservative")
+				note(ht, "%s.Span(%s) = %d although the string is unchanged", c.name, show(s), k)
+			}
+		}
+		// Streaming, on any bytes.
+		c := casers[cs.caser]
+		src := cs.stream.src(s)
+		out, err := drive(c.c, src, cs.stream.chunk, cs.stream.dst)
+		if err != nil {
+			fail(ht, "%s streaming %s: %v", c.name, show(string(src)), err)
+		}
+		if whole := c.c.Bytes(src); !bytes.Equal(out, whole) {
+			if Known.SigmaAcrossCalls && c.name != "Upper" && c.name != "Fold" && sameButSigmas(string(out), string(whole)) {
+				count(ht, "known x-text/33")
+			} else {
+				fail(ht, "%s streamed %s to %s, Bytes gives %s", c.name, show(string(src)), show(string(out)), show(string(whole)))
+			}
+		}
+	})
+}
+
+// langCaserCase is one of the three rules the language-specific casers are
+// checked against.
+type langCaserCase interface{ GoString() string }
+
+// turkicCase: a Turkish or Azeri caser on a word of the Turkic i alphabet.
+type turkicCase struct {
+	tag language.Tag
+	s   string
+}
+
+// dutchCase: the Dutch title caser on one to four words, each starting with
+// the digraph ij two times in five.
+type dutchCase struct{ words []dutchWord }
+
+type dutchWord struct {
+	ij bool
+	w  string
+}
+
+func (w dutchWord) text() string {
+	if w.ij {
+		return "ij" + w.w
+	}
+	return w.w
+}
+
+// plainCase: a caser of a language without rules of its own on a case text.
+type plainCase struct {
+	tag language.Tag
+	s   string
+}
+
+func (c turkicCase) GoString() string { return fmt.Sprintf("%v: %s", c.tag, show(c.s)) }
+func (c dutchCase) GoString() string {
+	var ws []string
+	for _, w := range c.words {
+		ws = append(ws, w.text())
+	}
+	return "nl: " + show(strings.Join(ws, " "))
+}
+func (c plainCase) GoString() string { return fmt.Sprintf("%v: %s", c.tag, show(c.s)) }
+
+var (
+	trAlphabet = []rune("abcxyzABCXYZiI\u0130\u0131\u0307\u0300 \u03a3\u03c3\u03c2\u00df\u01c5")
+	turkicTags = hegel.SampledFrom([]language.Tag{language.Turkish, language.Azerbaijani})
+	plainTags  = hegel.SampledFrom([]language.Tag{language.German, language.French, language.Japanese, language.Russian, language.English, language.Spanish, language.MustParse("pt-BR")})
+	dutchWords = hegel.Map(pairs(chance(40), alphabet([]rune("abcijklmz"), 1, 6)), func(p pair[bool, string]) dutchWord { return dutchWord{p.a, p.b} })
+	// langCaserCases: the three rules, one of them per case.
+	langCaserCases = hegel.OneOf(
+		hegel.Map(pairs(turkicTags, alphabet(trAlphabet, 0, 10)), func(p pair[language.Tag, string]) langCaserCase { return turkicCase{p.a, p.b} }),
+		hegel.Map(many(dutchWords, 1, 4), func(ws []dutchWord) langCaserCase { return dutchCase{ws} }),
+		hegel.Map(pairs(plainTags, caseTexts), func(p pair[language.Tag, string]) langCaserCase { return plainCase{p.a, p.b} }),
+	)
+)
+
+// The language-specific casers follow their documented rules: Turkish and
+// Azeri map i and I to the dotted capital and dotless small letters, Dutch
+// title case keeps the digraph ij together, and languages without rules use
+// the root mappings.
+func TestHegelLanguageCasersFollowTheirRules(t *testing.T) {
+	undUpper, undLower, undTitle := cases.Upper(language.Und), cases.Lower(language.Und), cases.Title(language.Und)
+	property(t, func(ht *hegel.T) {
+		switch c := hegel.Draw(ht, langCaserCases).(type) {
+		case turkicCase:
+			tag, s := c.tag, c.s
+			if got, want := cases.Upper(tag).String(s), undUpper.String(strings.ReplaceAll(s, "i", "\u0130")); got != want {
+				fail(ht, "Upper(%v)(%s) = %s, want %s", tag, show(s), show(got), show(want))
+			}
+			// I + dot above is the small i; the dotted capital lowers to a plain
+			// i; a plain I to the dotless i.
+			m := strings.ReplaceAll(s, "I\u0307", "i")
+			m = strings.ReplaceAll(m, "\u0130", "i")
+			m = strings.ReplaceAll(m, "I", "\u0131")
+			if got, want := cases.Lower(tag).String(s), undLower.String(m); got != want {
+				fail(ht, "Lower(%v)(%s) = %s, want %s", tag, show(s), show(got), show(want))
+			}
+		case dutchCase:
+			var words, want []string
+			for _, dw := range c.words {
+				w := dw.text()
+				words = append(words, w)
+				if strings.HasPrefix(w, "ij") {
+					want = append(want, "IJ"+w[2:])
+				} else {
+					want = append(want, undTitle.String(w))
+				}
+			}
+			s := strings.Join(words, " ")
+			if got := cases.Title(language.Dutch).String(s); got != strings.Join(want, " ") {
+				fail(ht, "Title(nl)(%s) = %s, want %s", show(s), show(got), show(strings.Join(want, " ")))
+			}
+		case plainCase:
+			tag, s := c.tag, c.s
+			if got, want := cases.Upper(tag).String(s), undUpper.String(s); got != want {
+				fail(ht, "Upper(%v)(%s) = %s, und gives %s", tag, show(s), show(got), show(want))
+			}
+			if got, want := cases.Lower(tag).String(s), undLower.String(s); got != want {
+				fail(ht, "Lower(%v)(%s) = %s, und gives %s", tag, show(s), show(got), show(want))
+			}
+			if got, want := cases.Title(tag).String(s), undTitle.String(s); got != want {
+				fail(ht, "Title(%v)(%s) = %s, und gives %s", tag, show(s), show(got), show(want))
+			}
+		}
+	})
+}
