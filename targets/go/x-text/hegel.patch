+var bidiClassNames = map[bidi.Class]string{
+	bidi.L: "L", bidi.R: "R", bidi.EN: "EN", bidi.ES: "ES", bidi.ET: "ET", bidi.AN: "AN", bidi.CS: "CS",
+	bidi.B: "B", bidi.S: "S", bidi.WS: "WS", bidi.ON: "ON", bidi.BN: "BN", bidi.NSM: "NSM", bidi.AL: "AL",
+	bidi.LRO: "LRO", bidi.RLO: "RLO", bidi.LRE: "LRE", bidi.RLE: "RLE", bidi.PDF: "PDF",
+	bidi.LRI: "LRI", bidi.RLI: "RLI", bidi.FSI: "FSI", bidi.PDI: "PDI",
+}
+
+// bidiRunes cover every bidi class: Latin, Hebrew, Arabic, European and
+// Arabic digits, separators, terminators, brackets, neutrals, marks,
+// separators and the explicit formatting characters.
+var bidiRunes = []rune{
+	'a', 'Z', 0x00E9, 0x05D0, 0x05D1, 0x05EA, 0x0627, 0x0628, 0x064A, '0', '5', '9', 0x0660, 0x0665, 0x06F1,
+	'-', '+', '.', ',', ':', '/', '$', '%', '#', 0x00B0, '!', '(', ')', '[', ']', '{', '}', 0x2329, 0x232A,
+	0x3008, 0x3009, 0x201C, 0x200B, 0x00AD, 0x200D, 0x0301, 0x05B0, 0x064B, 0x0308, ' ', 0x3000, '\n', 0x2029,
+	0x001C, '\t', 0x001F, 0x202A, 0x202B, 0x202C, 0x202D, 0x202E, 0x2066, 0x2067, 0x2068, 0x2069, 0x0600,
+	0x05BE, 0x05C0, 0x061C, 0x200E, 0x200F, 0x2212, 0x2044, 0x066A, 0x066B, 0x066C,
+}
+
+func bidiText(tc hegel.TestCase, lo, hi int) []rune {
+	k := n(tc, lo, hi)
+	rs := make([]rune, 0, k)
+	for i := 0; i < k; i++ {
+		if chance(tc, 60) {
+			rs = append(rs, pick(tc, bidiRunes...))
+		} else {
+			rs = append(rs, anyRune(tc, false))
+		}
+	}
+	return rs
+}
+
+func bidiClass(r rune) bidi.Class {
+	p, _ := bidi.LookupRune(r)
+	return p.Class()
+}
+
+func isExplicit(c bidi.Class) bool {
+	switch c {
+	case bidi.LRO, bidi.RLO, bidi.LRE, bidi.RLE, bidi.PDF, bidi.LRI, bidi.RLI, bidi.FSI, bidi.PDI:
+		return true
+	}
+	return false
+}
+
+// hasRTL reports whether s contains a character of class R, AL or AN (RFC
+// 5893's definition of an RTL label).
+func hasRTL(s string) bool {
+	for _, r := range s {
+		if c := bidiClass(r); c == bidi.R || c == bidi.AL || c == bidi.AN {
+			return true
+		}
+	}
+	return false
+}
+
+// The bidi classes agree with Python's bidirectional, brackets are mirrored
+// characters, the byte and string lookups agree with the rune lookup, and
+// ReverseString is an involution that swaps brackets and keeps modifiers
+// after the runes they modify, as documented.
+func TestHegelBidiClassesAgreeWithPython(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		rs := bidiText(ht, 0, 12)
+		s := string(rs)
+		ps := py.props(s)
+		if len(ps) != len(rs) {
+			fail(ht, "Python saw %d runes in %s, Go %d", len(ps), show(s), len(rs))
+			return
+		}
+		for i, r := range rs {
+			p, sz := bidi.LookupRune(r)
+			if sz != utf8.RuneLen(r) {
+				fail(ht, "LookupRune(%U) size %d", r, sz)
+			}
+			b := []byte(string(r))
+			pb, szb := bidi.Lookup(b)
+			pst, szs := bidi.LookupString(string(r))
+			if szb != len(b) || szs != len(b) || pb.Class() != p.Class() || pst.Class() != p.Class() || pb.IsBracket() != p.IsBracket() {
+				fail(ht, "Lookup/LookupString(%U) disagree with LookupRune: sizes %d %d, classes %v %v %v", r, szb, szs, pb.Class(), pst.Class(), p.Class())
+			}
+			if p.IsOpeningBracket() && !p.IsBracket() {
+				fail(ht, "%U is an opening bracket but not a bracket", r)
+			}
+			if ps[i].Cat == "Cn" {
+				count(ht, "unassigned-in-15")
+				continue
+			}
+			if bidiClassNames[p.Class()] != ps[i].Bidi {
+				fail(ht, "LookupRune(%U).Class() = %s, Python bidirectional %s", r, bidiClassNames[p.Class()], ps[i].Bidi)
+			}
+			if p.IsBracket() && ps[i].Mirrored != 1 {
+				fail(ht, "%U is a bracket but not Bidi_Mirrored in Python", r)
+			}
+		}
+		// Reversal.
+		rev := bidi.ReverseString(s)
+		if back := bidi.ReverseString(rev); back != s {
+			fail(ht, "ReverseString twice on %s: %s then %s", show(s), show(rev), show(back))
+		}
+		if utf8.RuneCountInString(rev) != len(rs) {
+			fail(ht, "ReverseString(%s) = %s has another number of runes", show(s), show(rev))
+		}
+		if x := string(bidi.AppendReverse([]byte("xy"), []byte(s))); x != "xy"+rev {
+			fail(ht, "AppendReverse(xy, %s) = %s, ReverseString %s", show(s), show(x), show(rev))
+		}
+		// Modifiers stay after the runes they modify: reverse the clusters
+		// (a rune with the nonspacing marks following it), swapping brackets.
+		var clusters [][]rune
+		marksAfterBase := false
+		for _, r := range rs {
+			if bidiClass(r) == bidi.NSM && len(clusters) > 0 {
+				clusters[len(clusters)-1] = append(clusters[len(clusters)-1], r)
+				marksAfterBase = true
+				continue
+			}
+			clusters = append(clusters, []rune{r})
+		}
+		var b strings.Builder
+		for i := len(clusters) - 1; i >= 0; i-- {
+			for _, r := range clusters[i] {
+				b.WriteString(bidi.ReverseString(string(r)))
+			}
+		}
+		if want := b.String(); rev != want {
+			if Known.ReverseSplitsMarks && marksAfterBase {
+				count(ht, "known x-text/25")
+			} else {
+				fail(ht, "ReverseString(%s) = %s, want %s", show(s), show(rev), show(want))
+			}
+		}
+	})
+}
+
+// A Paragraph's runs partition its first paragraph in order, strong
+// characters sit in runs of their own direction, the ordering's direction
+// summarizes the runs as documented, and RunAt finds the run of a position.
+func TestHegelBidiParagraphRunsPartitionTheText(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		rs := bidiText(ht, 0, 12)
+		s := string(rs)
+		explicit := false
+		for _, r := range rs {
+			if isExplicit(bidiClass(r)) {
+				explicit = true
+			}
+		}
+		var opts []bidi.Option
+		defaultDir := bidi.Neutral
+		if chance(ht, 20) {
+			defaultDir = pick(ht, bidi.LeftToRight, bidi.RightToLeft)
+			opts = append(opts, bidi.DefaultDirection(defaultDir))
+		}
+		var p bidi.Paragraph
+		nb, err := p.SetString(s, opts...)
+		if err != nil {
+			fail(ht, "SetString(%s): %v", show(s), err)
+			return
+		}
+		wantN, off, sepLen := len(s), 0, 0
+		for _, r := range rs {
+			off += utf8.RuneLen(r)
+			if bidiClass(r) == bidi.B {
+				wantN, sepLen = off, utf8.RuneLen(r)
+				break
+			}
+		}
+		if nb != wantN {
+			fail(ht, "SetString(%s) = %d, the first paragraph ends at %d", show(s), nb, wantN)
+			return
+		}
+		para := s[:nb]
+		var o bidi.Ordering
+		if msg := catch(func() { o, err = p.Order() }); msg != "" {
+			fail(ht, "Order() of %s panicked: %s", show(s), msg)
+			return
+		}
+		if err != nil {
+			count(ht, "order-error")
+			note(ht, "Order() of %s: %v", show(s), err)
+			return
+		}
+		if len(rs) == 0 {
+			if o.NumRuns() != 0 {
+				fail(ht, "Order() of the empty string has %d runs", o.NumRuns())
+			}
+			return
+		}
+		if o.NumRuns() == 0 {
+			// A paragraph that is just its separator has nothing to order
+			// (and its Ordering's Direction() would panic, x-text/30).
+			if sepLen == 0 || utf8.RuneCountInString(para) != 1 {
+				fail(ht, "Order() of %s has no runs", show(s))
+			}
+			return
+		}
+		// The runs are contiguous, in order, and cover the first paragraph.
+		var acc strings.Builder
+		prev := 0
+		dirAt := map[int]bidi.Direction{}
+		for i := 0; i < o.NumRuns(); i++ {
+			r := o.Run(i)
+			a, b := r.Pos()
+			if a != prev || b-a+1 != utf8.RuneCountInString(r.String()) {
+				fail(ht, "run %d of %s is at %d-%d (%s) after %d", i, show(s), a, b, show(r.String()), prev)
+				return
+			}
+			if string(r.Bytes()) != r.String() {
+				fail(ht, "run %d of %s: Bytes %s, String %s", i, show(s), show(string(r.Bytes())), show(r.String()))
+			}
+			if r.Direction() != bidi.LeftToRight && r.Direction() != bidi.RightToLeft {
+				fail(ht, "run %d of %s has direction %v", i, show(s), r.Direction())
+			}
+			for j := a; j <= b; j++ {
+				dirAt[j] = r.Direction()
+			}
+			prev = b + 1
+			acc.WriteString(r.String())
+		}
+		if acc.String() != para && acc.String() != para[:len(para)-sepLen] {
+			if Known.OrderPastSeparator && nb < len(s) && acc.String() == s {
+				count(ht, "known x-text/31")
+			} else {
+				fail(ht, "the runs of %s spell %s, the first paragraph is %s", show(s), show(acc.String()), show(para))
+			}
+		}
+		hasL, hasR := false, false
+		for j, r := range []rune(para) {
+			switch bidiClass(r) {
+			case bidi.L:
+				hasL = true
+				if !explicit && dirAt[j] != bidi.LeftToRight {
+					fail(ht, "%U at %d of %s is in a right-to-left run", r, j, show(s))
+				}
+			case bidi.R, bidi.AL:
+				hasR = true
+				if !explicit && dirAt[j] != bidi.RightToLeft {
+					fail(ht, "%U at %d of %s is in a left-to-right run", r, j, show(s))
+				}
+			}
+		}
+		wantDir := defaultDir
+		switch {
+		case hasL && hasR:
+			wantDir = bidi.Mixed
+		case hasL:
+			wantDir = bidi.LeftToRight
+		case hasR:
+			wantDir = bidi.RightToLeft
+		}
+		first := o.Run(0)
+		if !explicit && o.Direction() != wantDir {
+			if Known.DirectionIsFirstRun && o.Direction() == first.Direction() {
+				count(ht, "known x-text/29")
+			} else {
+				fail(ht, "Order() of %s has direction %v, want %v", show(s), o.Direction(), wantDir)
+			}
+		}
+		if p.Direction() != o.Direction() {
+			fail(ht, "Paragraph.Direction() = %v but the ordering's is %v", p.Direction(), o.Direction())
+		}
+		// RunAt.
+		pos := n(ht, 0, utf8.RuneCountInString(para)-1)
+		r := p.RunAt(pos)
+		a, b := r.Pos()
+		if pos < a || b < pos {
+			last := o.Run(o.NumRuns() - 1)
+			la, lb := last.Pos()
+			if Known.RunAtIsLastRun && a == la && b == lb {
+				count(ht, "known x-text/28")
+			} else {
+				fail(ht, "RunAt(%d) of %s is the run at %d-%d", pos, show(s), a, b)
+			}
+		}
+	})
+}
+
+// rfc5893 is the Bidi Rule of RFC 5893 section 2, written out on the bidi
+// classes; ill-formed UTF-8 never conforms (the package's convention).
+func rfc5893(src []byte) bool {
+	if !utf8.Valid(src) {
+		return false
+	}
+	rs := []rune(string(src))
+	if len(rs) == 0 {
+		return true
+	}
+	cls := make([]bidi.Class, len(rs))
+	rtl, hasEN, hasAN := false, false, false
+	for i, r := range rs {
+		cls[i] = bidiClass(r)
+		switch cls[i] {
+		case bidi.R, bidi.AL:
+			rtl = true
+		case bidi.AN:
+			rtl = true
+			hasAN = true
+		case bidi.EN:
+			hasEN = true
+		}
+	}
+	last := len(cls) - 1
+	for last > 0 && cls[last] == bidi.NSM {
+		last--
+	}
+	if rtl {
+		if cls[0] != bidi.R && cls[0] != bidi.AL {
+			return false
+		}
+		for _, c := range cls {
+			switch c {
+			case bidi.R, bidi.AL, bidi.AN, bidi.EN, bidi.ES, bidi.CS, bidi.ET, bidi.ON, bidi.BN, bidi.NSM:
+			default:
+				return false
+			}
+		}
+		if hasEN && hasAN {
+			return false
+		}
+		switch cls[last] {
+		case bidi.R, bidi.AL, bidi.EN, bidi.AN:
+			return true
+		}
+		return false
+	}
+	if cls[0] != bidi.L {
+		return false
+	}
+	for _, c := range cls {
+		switch c {
+		case bidi.L, bidi.EN, bidi.ES, bidi.CS, bidi.ET, bidi.ON, bidi.BN, bidi.NSM:
+		default:
+			return false
+		}
+	}
+	return cls[last] == bidi.L || cls[last] == bidi.EN
+}
+
+// bidirule.Valid/ValidString agree with RFC 5893's rule written out on the
+// classes, Direction reports RTL labels, and the Transformer passes valid
+// labels through unchanged and rejects the others.
+func TestHegelBidiRuleAgreesWithRFC5893(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var src []byte
+		if chance(ht, 15) {
+			src = bytesAny(ht, 0, 10)
+		} else {
+			src = []byte(string(bidiText(ht, 0, 10)))
+		}
+		want := rfc5893(src)
+		got := bidirule.Valid(src)
+		if gotS := bidirule.ValidString(string(src)); gotS != got {
+			fail(ht, "Valid(%s) = %v but ValidString = %v", show(string(src)), got, gotS)
+		}
+		if got != want {
+			if got && !utf8.Valid(src) && Known.BidiLookupLenient {
+				// Surrogates and code points past U+10FFFF decode as characters.
+				count(ht, "known x-text/35")
+				return
+			}
+			fail(ht, "Valid(%s) = %v, RFC 5893 says %v", show(string(src)), got, want)
+		}
+		if want {
+			count(ht, "valid")
+		}
+		if utf8.Valid(src) {
+			wantDir := bidi.LeftToRight
+			if hasRTL(string(src)) {
+				wantDir = bidi.RightToLeft
+			}
+			if got := bidirule.Direction(src); got != wantDir {
+				fail(ht, "Direction(%s) = %v, want %v", show(string(src)), got, wantDir)
+			}
+			if got := bidirule.DirectionString(string(src)); got != wantDir {
+				fail(ht, "DirectionString(%s) = %v, want %v", show(string(src)), got, wantDir)
+			}
+		} else if bidirule.Direction(src) != bidirule.DirectionString(string(src)) {
+			fail(ht, "Direction and DirectionString disagree on %s", show(string(src)))
+		}
+		tr := bidirule.New()
+		out, err := drive(tr, src, n(ht, 1, 5), n(ht, 1, 8))
+		if want {
+			if err != nil || !bytes.Equal(out, src) {
+				if err == bidirule.ErrInvalid && Known.BidiRuleSpanNotFinal {
+					count(ht, "known x-text/34")
+				} else {
+					fail(ht, "Transformer on the valid label %s: %s, %v", show(string(src)), show(string(out)), err)
+				}
+			}
+		} else if err != bidirule.ErrInvalid {
+			fail(ht, "Transformer on the invalid label %s: %s, %v", show(string(src)), show(string(out)), err)
+		}
+		tr.Reset()
+		sp, err := tr.Span(src, true)
+		if want && (sp != len(src) || err != nil) {
+			fail(ht, "Span(%s) = %d, %v on a valid label", show(string(src)), sp, err)
+		}
+		if !want && err != bidirule.ErrInvalid {
+			fail(ht, "Span(%s) = %d, %v on an invalid label", show(string(src)), sp, err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// secure/precis
+
+// contextual reports whether r has a contextual rule in RFC 5892 appendix A
+// (CONTEXTJ and CONTEXTO); the profiles' Allowed sets exclude them although
+// the enforcement accepts them in context.
+func contextual(r rune) bool {
+	switch r {
+	case 0x200C, 0x200D, 0x00B7, 0x0375, 0x05F3, 0x05F4, 0x30FB:
+		return true
+	}
+	return (0x0660 <= r && r <= 0x0669) || (0x06F0 <= r && r <= 0x06F9)
+}
+
+func hasContextual(s string) bool {
+	for _, r := range s {
+		if contextual(r) {
+			return true
+		}
+	}
+	return false
+}
+
+func mapSpaces(s string) string {
+	return strings.Map(func(r rune) rune {
+		if unicode.Is(unicode.Zs, r) {
+			return ' '
+		}
+		return r
+	}, s)
+}
+
+var lowerNoSigma = cases.Lower(language.Und, cases.HandleFinalSigma(false))
+
+// precisModel is a profile with its rules of RFC 8265/8266 written out: the
+// mapping steps (applied `repeat` times), whether the Bidi Rule applies (to
+// strings with RTL characters), and that the result must not be empty.
+type precisModel struct {
+	name          string
+	p             *precis.Profile
+	mapping       func(string) string
+	bidiRule      bool
+	disallowEmpty bool
+	repeat        int
+	ignoreCase    bool
+}
+
+var precisModels = []precisModel{
+	{"UsernameCaseMapped", precis.UsernameCaseMapped, func(s string) string {
+		return norm.NFC.String(lowerNoSigma.String(width.Fold.String(s)))
+	}, true, true, 1, false},
+	{"UsernameCasePreserved", precis.UsernameCasePreserved, func(s string) string {
+		return norm.NFC.String(width.Fold.String(s))
+	}, true, true, 1, false},
+	{"OpaqueString", precis.OpaqueString, func(s string) string {
+		return norm.NFC.String(mapSpaces(s))
+	}, false, true, 1, false},
+	{"Nickname", precis.Nickname, func(s string) string {
+		fields := strings.FieldsFunc(s, func(r rune) bool { return unicode.Is(unicode.Zs, r) })
+		return norm.NFKC.String(strings.Join(fields, " "))
+	}, false, true, 4, true},
+}
+
+// The PRECIS profiles enforce the rules of RFC 8265 and RFC 8266: the
+// mapping steps in order, the string class, the Bidi Rule on strings with
+// RTL characters, no empty results; String, Bytes and Append agree, and
+// Compare is equality of the CompareKeys.
+func TestHegelRFC8265ProfilesEnforceTheirRules(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := pick(ht, precisModels...)
+		s := caseText(ht)
+		if chance(ht, 30) {
+			s = string(bidiText(ht, 0, 8))
+		}
+		if chance(ht, 10) {
+			s = pick(ht, "", " ", "\u00a0", "\u00ad", "\u200b", "1", "-", "\u0301")
+		}
+		mapped := s
+		for i := 0; i < m.repeat; i++ {
+			mapped = m.mapping(mapped)
+		}
+		if hasContextual(s) || hasContextual(mapped) {
+			count(ht, "contextual-rune")
+			return
+		}
+		wantOK := true
+		for _, r := range mapped {
+			if !m.p.Allowed().Contains(r) {
+				wantOK = false
+			}
+		}
+		if m.bidiRule && hasRTL(mapped) && !bidirule.ValidString(mapped) {
+			wantOK = false
+		}
+		if m.disallowEmpty && mapped == "" {
+			wantOK = false
+		}
+		got, err := m.p.String(s)
+		switch {
+		case err == nil && !wantOK:
+			if mapped == "" && strings.HasPrefix(m.name, "Username") && Known.UsernameEmpty {
+				count(ht, "known x-text/26")
+			} else {
+				fail(ht, "%s.String(%s) = %s, RFC 8265 rejects it (mapped %s)", m.name, show(s), show(got), show(mapped))
+			}
+		case err != nil && wantOK:
+			if m.bidiRule && err == bidirule.ErrInvalid && !hasRTL(mapped) && !bidirule.ValidString(mapped) && Known.BidiRuleOnLTR {
+				count(ht, "known x-text/27")
+			} else {
+				fail(ht, "%s.String(%s): %v, RFC 8265 gives %s", m.name, show(s), err, show(mapped))
+			}
+		case err == nil:
+			if got != mapped {
+				fail(ht, "%s.String(%s) = %s, RFC 8265 gives %s", m.name, show(s), show(got), show(mapped))
+			}
+			count(ht, "enforced")
+		default:
+			count(ht, "rejected")
+		}
+		// Bytes and Append agree with String.
+		b, errB := m.p.Bytes([]byte(s))
+		if (errB == nil) != (err == nil) || string(b) != got {
+			fail(ht, "%s.Bytes(%s) = %s, %v but String = %s, %v", m.name, show(s), show(string(b)), errB, show(got), err)
+		}
+		ap, errA := m.p.Append([]byte("z"), []byte(s))
+		if (errA == nil) != (err == nil) || (err == nil && string(ap) != "z"+got) {
+			fail(ht, "%s.Append(z, %s) = %s, %v but String = %s, %v", m.name, show(s), show(string(ap)), errA, show(got), err)
+		}
+		if err == nil {
+			if again, err2 := m.p.String(got); err2 != nil || again != got {
+				count(ht, "not-idempotent")
+				note(ht, "%s.String(%s) = %s, then %s, %v", m.name, show(s), show(got), show(again), err2)
+			}
+		}
+		// Compare is equality of the compare keys.
+		other := s
+		switch n(ht, 1, 3) {
+		case 1:
+			other = strings.Map(func(r rune) rune {
+				if chance(ht, 50) {
+					return unicode.SimpleFold(r)
+				}
+				return r
+			}, s)
+		case 2:
+			other = caseText(ht)
+		}
+		ka, ea := m.p.CompareKey(s)
+		kb, eb := m.p.CompareKey(other)
+		want := ea == nil && eb == nil && ka == kb
+		if got := m.p.Compare(s, other); got != want {
+			fail(ht, "%s.Compare(%s, %s) = %v, keys %s (%v) and %s (%v)", m.name, show(s), show(other), got, show(ka), ea, show(kb), eb)
+		}
+		if !m.ignoreCase && ((ea == nil) != (err == nil) || ka != got) {
+			fail(ht, "%s.CompareKey(%s) = %s, %v but String = %s, %v", m.name, show(s), show(ka), ea, show(got), err)
+		}
+		if ea == nil {
+			if again, err2 := m.p.CompareKey(ka); err2 != nil || again != ka {
+				count(ht, "key-not-idempotent")
+				note(ht, "%s.CompareKey(%s) = %s, then %s, %v", m.name, show(s), show(ka), show(again), err2)
+			}
+		}
+	})
+}
