+var cjkEncodings = func() []encoding.Encoding {
+	var es []encoding.Encoding
+	es = append(es, japanese.All...)
+	es = append(es, korean.All...)
+	es = append(es, simplifiedchinese.All...)
+	es = append(es, traditionalchinese.All...)
+	return es
+}()
