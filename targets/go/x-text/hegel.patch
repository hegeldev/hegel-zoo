+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,91 @@
+package hegel
+
+// One plain test per recorded bug, asserting the correct behaviour so that it
+// fails while the bug exists; listed as expected failures in target.toml.
+
+import (
+	"strings"
+	"testing"
+
+	"golang.org/x/text/encoding"
+	"golang.org/x/text/encoding/ianaindex"
+	"golang.org/x/text/encoding/simplifiedchinese"
+	"golang.org/x/text/encoding/unicode/utf32"
+	"golang.org/x/text/unicode/norm"
+)
+
+func iterAll(f norm.Form, s string) string {
+	var it norm.Iter
+	it.InitString(f, s)
+	var acc []byte
+	for !it.Done() {
+		acc = append(acc, it.Next()...)
+	}
+	return string(acc)
+}
+
+// x-text/1
+func TestHegelPinNormDoesNotInsertCGJ(t *testing.T) {
+	s := "a" + strings.Repeat("́", 31)
+	for _, f := range forms {
+		if got := f.String(s); got != s {
+			t.Errorf("%s of a + 31 x U+0301 = %+q; the string is already in every normalization form (unicodedata.normalize agrees)", formNames[f], got)
+		}
+	}
+}
+
+// x-text/2
+func TestHegelPinIterAgreesWithStringAcrossJamo(t *testing.T) {
+	s := "ᅡְְཱི̀ᅡ̀ᆨְᆨְ̣̀ᆨͅᅡ̴ཱཱིི̣̈́ᆨᅡְ̣̣ͅ"
+	for _, f := range []norm.Form{norm.NFD, norm.NFKD} {
+		if a, b := iterAll(f, s), f.String(s); a != b {
+			t.Errorf("%s: Iter yields %+q, String %+q", formNames[f], a, b)
+		}
+	}
+}
+
+// x-text/3
+func TestHegelPinHZEncoderLeavesGBModeOnAnUnsupportedRune(t *testing.T) {
+	e := simplifiedchinese.HZGB2312
+	out, err := encoding.HTMLEscapeUnsupported(e.NewEncoder()).Bytes([]byte("\u4e2d\U0001F600\u4e2d"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	back, err := e.NewDecoder().Bytes(out)
+	if err != nil || string(back) != "\u4e2d&#128512;\u4e2d" {
+		t.Errorf("HZ-GB2312 with HTMLEscapeUnsupported writes %q, which decodes to %+q, %v; expected \u4e2d&#128512;\u4e2d", out, back, err)
+	}
+}
+
+// x-text/4
+func TestHegelPinGB18030RoundTripsPrivateUse(t *testing.T) {
+	enc, dec := simplifiedchinese.GB18030.NewEncoder(), simplifiedchinese.GB18030.NewDecoder()
+	for _, r := range []rune{0xE000, 0xE4C6, 0xE5E5, 0xE766} {
+		b, err := enc.Bytes([]byte(string(r)))
+		if err != nil {
+			t.Errorf("%U: %v", r, err)
+			continue
+		}
+		back, err := dec.Bytes(b)
+		if err != nil || string(back) != string(r) {
+			t.Errorf("GB18030: %U -> % x -> %+q, %v", r, b, back, err)
+		}
+	}
+}
+
+// x-text/5
+func TestHegelPinIANAIndexKnowsUTF32(t *testing.T) {
+	for _, e := range utf32.All {
+		for _, x := range []*ianaindex.Index{ianaindex.IANA, ianaindex.MIME} {
+			name, err := x.Name(e)
+			if err != nil {
+				t.Errorf("Name(%v): %v", e, err)
+				continue
+			}
+			got, err := x.Encoding(name)
+			if err != nil || got == nil {
+				t.Errorf("Name(%v) = %q but Encoding(%q) = %v, %v", e, name, name, got, err)
+			}
+		}
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..7998118
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,264 @@
+package hegel
+
+// Hegel properties for golang.org/x/text: the Unicode packages (norm, cases,
+// width, bidi, runenames, rangetable) against Python 3's unicodedata and
+// against their own doc comments, the encodings against round trips and the
+// streaming/one-shot equivalence every transform.Transformer promises, and
+// language, collate, precis, bidirule, number and message against models of
+// their documentation. Python 3 is the only external tool (python3 on PATH).
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing (shared with the other Go targets of the zoo).
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the gated shapes of each property so a run shows how often
+// the Known gates fire (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("PANIC in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	if lo > hi {
+		panic(fmt.Sprintf("n(%d, %d): empty range", lo, hi))
+	}
+	return hegel.Draw(tc, hegel.Integers(lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// show renders a string with every non-ASCII or control rune escaped, so a
+// failure message can be read and replayed.
+func show(s string) string { return strconv.QuoteToASCII(s) }
+
+// ---------------------------------------------------------------------------
+// The Python oracle: one long-lived python3 process per test, spoken to in
+// JSON lines. Only valid UTF-8 travels over it (encoding/json replaces
+// anything else with U+FFFD).
+
+type oracle struct {
+	t   testing.TB
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  io.WriteCloser
+	out *bufio.Reader
+}
+
+const oracleScript = `
+import sys, json, unicodedata
+for line in sys.stdin:
+    r = json.loads(line)
+    op = r["op"]
+    s = r.get("s", "")
+    if op == "norm":
+        out = {f: unicodedata.normalize(f, s) for f in ("NFC", "NFD", "NFKC", "NFKD")}
+    elif op == "props":
+        out = [{"cat": unicodedata.category(c), "ccc": unicodedata.combining(c),
+                "name": unicodedata.name(c, ""), "eaw": unicodedata.east_asian_width(c),
+                "bidi": unicodedata.bidirectional(c), "decomp": unicodedata.decomposition(c),
+                "mirrored": unicodedata.mirrored(c)} for c in s]
+    elif op == "case":
+        out = {"upper": s.upper(), "lower": s.lower(), "fold": s.casefold(), "title": s.title()}
+    elif op == "decode":
+        try:
+            out = bytes(r["b"]).decode(r["codec"], errors="replace")
+        except LookupError:
+            out = None
+    elif op == "encode":
+        try:
+            out = list(s.encode(r["codec"]))
+        except UnicodeEncodeError:
+            out = None
+    else:
+        out = None
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+`
+
+func newOracle(t testing.TB) *oracle {
+	t.Helper()
+	cmd := exec.Command("python3", "-c", oracleScript)
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	outPipe, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &oracle{t: t, cmd: cmd, in: in, out: bufio.NewReaderSize(outPipe, 1<<20)}
+	t.Cleanup(func() {
+		in.Close()
+		cmd.Wait()
+	})
+	return o
+}
+
+func (o *oracle) call(req map[string]any, into any) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		o.t.Fatal(err)
+	}
+	if _, err := o.in.Write(append(b, '\n')); err != nil {
+		o.t.Fatalf("writing to python3: %v", err)
+	}
+	line, err := o.out.ReadBytes('\n')
+	if err != nil {
+		o.t.Fatalf("reading from python3: %v", err)
+	}
+	if err := json.Unmarshal(line, into); err != nil {
+		o.t.Fatalf("python3 answered %q: %v", line, err)
+	}
+}
+
+type runeProps struct {
+	Cat      string `json:"cat"`
+	CCC      int    `json:"ccc"`
+	Name     string `json:"name"`
+	EAW      string `json:"eaw"`
+	Bidi     string `json:"bidi"`
+	Decomp   string `json:"decomp"`
+	Mirrored int    `json:"mirrored"`
+}
+
+// props asks Python for the Unicode 15.0 properties of every rune of s.
+func (o *oracle) props(s string) []runeProps {
+	var ps []runeProps
+	o.call(map[string]any{"op": "props", "s": s}, &ps)
+	return ps
+}
+
+// assigned15 keeps the runes of s that Python's Unicode 15.0 tables assign
+// (Go 1.27's x/text tables are Unicode 17.0; the differential properties
+// compare only what both know).
+func (o *oracle) assigned15(s string) string {
+	rs := []rune(s)
+	ps := o.props(s)
+	var b strings.Builder
+	for i, p := range ps {
+		if i < len(rs) && p.Cat != "Cn" && p.Cat != "Cs" {
+			b.WriteRune(rs[i])
+		}
+	}
+	return b.String()
+}
