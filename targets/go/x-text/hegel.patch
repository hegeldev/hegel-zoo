+// UTF-16 and UTF-32 with every endianness and BOM policy: encode/decode round
+// trips, the BOM appears exactly when the policy says, ExpectBOM fails without
+// one, ill-formed input yields U+FFFD and never an error or a panic, streaming
+// equals one-shot.
+func TestHegelUtf16And32RoundTrip(t *testing.T) {
+	type enc struct {
+		name string
+		e    encoding.Encoding
+		bom  bool // whether the encoder writes a BOM
+		exp  bool // ExpectBOM
+		unit int
+	}
+	var encs []enc
+	for _, en := range []xunicode.Endianness{xunicode.BigEndian, xunicode.LittleEndian} {
+		for _, pol := range []xunicode.BOMPolicy{xunicode.IgnoreBOM, xunicode.UseBOM, xunicode.ExpectBOM} {
+			encs = append(encs, enc{fmt.Sprintf("UTF16(%v,%v)", en, pol), xunicode.UTF16(en, pol), pol != xunicode.IgnoreBOM, pol == xunicode.ExpectBOM, 2})
+		}
+	}
+	for _, en := range []utf32.Endianness{utf32.BigEndian, utf32.LittleEndian} {
+		for _, pol := range []utf32.BOMPolicy{utf32.IgnoreBOM, utf32.UseBOM, utf32.ExpectBOM} {
+			encs = append(encs, enc{fmt.Sprintf("UTF32(%v,%v)", en, pol), utf32.UTF32(en, pol), pol != utf32.IgnoreBOM, pol == utf32.ExpectBOM, 4})
+		}
+	}
+	encs = append(encs, enc{"UTF8", xunicode.UTF8, false, false, 1}, enc{"UTF8BOM", xunicode.UTF8BOM, true, false, 1})
+	property(t, func(ht *hegel.T) {
+		e := pick(ht, encs...)
+		s := text15(ht, 0, 10)
+		encoded, err := e.e.NewEncoder().Bytes([]byte(s))
+		if err != nil {
+			fail(ht, "%s: encoding %s: %v", e.name, show(s), err)
+		}
+		if e.unit > 1 && len(encoded)%e.unit != 0 {
+			fail(ht, "%s: encoding %s gives %d bytes", e.name, show(s), len(encoded))
+		}
+		back, err := e.e.NewDecoder().Bytes(encoded)
+		if err != nil || string(back) != s {
+			fail(ht, "%s: %s -> %q -> %s, %v", e.name, show(s), encoded, show(string(back)), err)
+		}
+		// The BOM.
+		units := len(encoded) / e.unit
+		if e.unit > 1 && units != utf16Len(s, e.unit)+boolInt(e.bom) {
+			fail(ht, "%s: %s encodes to %d code units, expected %d (+%d BOM)", e.name, show(s), units, utf16Len(s, e.unit), boolInt(e.bom))
+		}
+		if e.unit == 1 && len(encoded) != len(s)+3*boolInt(e.bom) {
+			fail(ht, "%s: %s encodes to %q", e.name, show(s), encoded)
+		}
+		if e.exp {
+			if _, err := e.e.NewDecoder().Bytes(encoded[e.unit:]); err == nil && len(encoded) > e.unit {
+				fail(ht, "%s: decoding without the BOM succeeds on %q", e.name, encoded[e.unit:])
+			}
+		}
+		// Streaming.
+		if got, err := drive(e.e.NewEncoder(), []byte(s), n(ht, 1, 4), pick(ht, 1, 2, 3, 4, 5, 32)); err != nil || !bytes.Equal(got, encoded) {
+			fail(ht, "%s: streaming encode of %s = %q, %v; one-shot %q", e.name, show(s), got, err, encoded)
+		}
+		if got, err := drive(e.e.NewDecoder(), encoded, n(ht, 1, 5), pick(ht, 1, 2, 3, 4, 5, 32)); err != nil || string(got) != s {
+			fail(ht, "%s: streaming decode of %q = %s, %v", e.name, encoded, show(string(got)), err)
+		}
+		// Ill-formed input: surrogates, odd lengths, out-of-range code units.
+		if e.unit > 1 && !e.exp {
+			raw := append([]byte{}, encoded...)
+			switch n(ht, 1, 4) {
+			case 1:
+				raw = append(raw, byte(n(ht, 0, 255)))
+			case 2:
+				raw = append(raw, 0xD8, 0x00, 0x00, 0xD8, 0x00, 0x41)
+			case 3:
+				raw = append(raw, 0xDC, 0x00, 0xDC, 0x00)
+			default:
+				raw = append(raw, 0x00, 0x11, 0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF)
+			}
+			got, err := e.e.NewDecoder().Bytes(raw)
+			if err != nil {
+				fail(ht, "%s: decoding ill-formed %q: %v", e.name, raw, err)
+			}
+			if !utf8.Valid(got) {
+				fail(ht, "%s: decoding ill-formed %q gives non-UTF-8 %q", e.name, raw, got)
+			}
+			if !strings.HasPrefix(string(got), s) {
+				fail(ht, "%s: decoding %q with junk appended gives %s, prefix %s lost", e.name, raw, show(string(got)), show(s))
+			}
+			if got2, err := drive(e.e.NewDecoder(), raw, n(ht, 1, 5), pick(ht, 1, 2, 3, 4, 5, 32)); err != nil || !bytes.Equal(got, got2) {
+				fail(ht, "%s: streaming decode of ill-formed %q = %q, %v; one-shot %q", e.name, raw, got2, err, got)
+			}
+		}
+	})
+}
+
+// sameEncoding compares two encodings by identity, or by name for the
+// encodings whose values are not comparable.
+func sameEncoding(a, b encoding.Encoding) bool {
+	defer func() { recover() }()
+	if a == b {
+		return true
+	}
+	return fmt.Sprint(a) == fmt.Sprint(b)
+}
+
+func boolInt(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// utf16Len is the number of code units of s in UTF-16 (unit 2) or UTF-32.
+func utf16Len(s string, unit int) int {
+	k := 0
+	for _, r := range s {
+		if unit == 2 && r > 0xFFFF {
+			k += 2
+		} else {
+			k++
+		}
+	}
+	return k
+}
+
+// The HTML and IANA indexes: Name and Get/Encoding round-trip for every
+// encoding they know, case-insensitively.
+func TestHegelEncodingIndexesRoundTrip(t *testing.T) {
+	var all []encoding.Encoding
+	all = append(all, charmap.All...)
+	all = append(all, cjkEncodings...)
+	all = append(all, xunicode.All...)
+	all = append(all, utf32.All...)
+	property(t, func(ht *hegel.T) {
+		e := pick(ht, all...)
+		if name, err := htmlindex.Name(e); err == nil {
+			variants := []string{name, strings.ToUpper(name), strings.ToLower(name), " " + name + "\t"}
+			for _, v := range variants {
+				got, err := htmlindex.Get(v)
+				if err != nil {
+					fail(ht, "htmlindex.Name(%v) = %q but Get(%q): %v", e, name, v, err)
+				}
+				if !sameEncoding(got, e) {
+					fail(ht, "htmlindex.Get(%q) = %v, not %v", v, got, e)
+				}
+			}
+		} else {
+			count(ht, "not-in-htmlindex")
+		}
+		for _, idx := range []struct {
+			name string
+			x    *ianaindex.Index
+		}{{"IANA", ianaindex.IANA}, {"MIME", ianaindex.MIME}, {"MIB", ianaindex.MIB}} {
+			name, err := idx.x.Name(e)
+			if err != nil {
+				count(ht, "no-"+idx.name+"-name")
+				continue
+			}
+			if idx.name == "MIB" {
+				// Encoding accepts IANA names; the MIB index only differs in the names it returns.
+				count(ht, "mib-name")
+				continue
+			}
+			for _, v := range []string{name, strings.ToUpper(name), strings.ToLower(name)} {
+				got, err := idx.x.Encoding(v)
+				if err != nil || got == nil {
+					if Known.IANAUTF32 && strings.HasPrefix(name, "UTF-32") {
+						count(ht, "known x-text/5")
+						continue
+					}
+					fail(ht, "ianaindex.%s.Name(%v) = %q but Encoding(%q) = %v, %v", idx.name, e, name, v, got, err)
+				}
+				if !sameEncoding(got, e) {
+					fail(ht, "ianaindex.%s.Encoding(%q) = %v, not %v", idx.name, v, got, e)
+				}
+			}
+		}
+		// An unknown name is an error, not a panic.
+		junk := pick(ht, "", "x-nonsense", "utf-9", "iso-8859-99", "windows-9999", "\x00")
+		if _, err := htmlindex.Get(junk); err == nil {
+			fail(ht, "htmlindex.Get(%q) succeeds", junk)
+		}
+		if got, err := ianaindex.IANA.Encoding(junk); err == nil && got != nil {
+			fail(ht, "ianaindex.IANA.Encoding(%q) = %v", junk, got)
+		}
+		_ = transform.Nop
+	})
+}
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..96595be
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,221 @@
+package hegel
+
+// Generators and the Transformer driver shared by the properties.
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/text/transform"
+	"golang.org/x/text/unicode/rangetable"
+	"hegel.dev/go/hegel"
+)
+
+// interestingRunes are the runes normalization, casing, width and bidi care
+// about: composed and decomposed Latin, combining marks of many classes,
+// Hangul jamo and syllables, compatibility characters, singletons,
+// exclusions, multi-segment decompositions, format and control characters.
+var interestingRunes = []rune{
+	'a', 'A', 'z', '0', '9', ' ', '\n', '.', '-', '\'',
+	0x00C5, 0x00E9, 0x00F1, 0x00DF, 0x00B2, 0x00BD, 0x00B5, 0x00A0, 0x00AD,
+	0x212B, 0x212A, 0x2126, 0x00C5, 0x1E9B, 0x03D3, 0x1F80, 0x1FBC, 0x0390, 0x0130, 0x0131, 0x0149,
+	0xFB01, 0xFB03, 0xFF21, 0xFF76, 0xFF9E, 0x3300, 0xFDFA, 0x2460, 0x2075, 0x2153,
+	0x0300, 0x0301, 0x0323, 0x031B, 0x0327, 0x0316, 0x05B0, 0x05B8, 0x093C, 0x0334, 0x0345, 0x034F,
+	0x0344, 0x0F73, 0x0F75, 0x0F81, 0x0958, 0x2ADC, 0x0DDD, 0x0CC0, 0xFB2C, 0x0B4B, 0x1B06,
+	0x1100, 0x1112, 0x1161, 0x1175, 0x11A8, 0x11C2, 0xAC00, 0xAC01, 0xD7A3, 0x3131, 0x3164,
+	0xF900, 0xFA10, 0x2F800, 0x1D160, 0x1D15E, 0x11099, 0x1109A,
+	0x0301, 0x0302, 0x0303, 0x0304, 0x0305, 0x0306, 0x0307, 0x0308,
+	0x03C2, 0x03C3, 0x03A3, 0x0345, 0x1E9E, 0x0587, 0x1F50, 0x1FB3, 0x00FF, 0x0178,
+	0x05D0, 0x05D1, 0x0627, 0x0628, 0x0661, 0x0669, 0x06F1, 0x200F, 0x200E, 0x202B, 0x202C, 0x2066, 0x2069,
+	0x200D, 0x200C, 0x2060, 0xFEFF, 0x061C, 0x0009, 0x000D, 0x0085, 0x2028, 0x2029,
+	0x00B7, 0x0375, 0x05F3, 0x05F4, 0x30FB, 0x0660, 0x06F0, 0x0640,
+	0x4E00, 0x9FFF, 0x3042, 0x30AB, 0x30F4, 0x3099, 0x309A, 0xFF9E, 0xFF9F, 0x3000, 0xFF01, 0xFF61, 0xFFE0,
+	0x1F600, 0x1F1E6, 0x1F3FB, 0xE000, 0xF8FF, 0xFFFD, 0xFFFE, 0x10FFFF, 0x0000, 0x007F,
+	0x0130, 0x0131, 0x0049, 0x0069, 0x0307, 0x0308, 0x00CD, 0x0128, 0x012E, 0x0116, 0x0041,
+}
+
+var assigned15 = rangetable.Assigned("15.0.0")
+
+// assignedRune draws a rune assigned in Unicode 15.0 (known to Python 3.12 and
+// to x/text alike), never a surrogate.
+func assignedRune(tc hegel.TestCase) rune {
+	for i := 0; i < 50; i++ {
+		var r rune
+		switch n(tc, 1, 10) {
+		case 1, 2, 3, 4, 5:
+			r = rune(n(tc, 0, 0x3000))
+		case 6, 7:
+			r = rune(n(tc, 0x3000, 0xFFFF))
+		default:
+			r = rune(n(tc, 0x10000, 0x10FFFF))
+		}
+		if unicode.Is(assigned15, r) && !(r >= 0xD800 && r <= 0xDFFF) {
+			return r
+		}
+	}
+	return 'x'
+}
+
+// anyRune draws from the interesting runes and from the assigned ones; with
+// wide, also from all of the code space.
+func anyRune(tc hegel.TestCase, wide bool) rune {
+	switch n(tc, 1, 10) {
+	case 1, 2, 3, 4, 5:
+		return pick(tc, interestingRunes...)
+	case 6:
+		return rune(n(tc, 'a', 'e'))
+	case 7, 8:
+		return assignedRune(tc)
+	default:
+		if wide {
+			r := rune(n(tc, 0, 0x10FFFF))
+			if r >= 0xD800 && r <= 0xDFFF {
+				r = 0xFFFD
+			}
+			return r
+		}
+		return assignedRune(tc)
+	}
+}
+
+// text15 draws lo..hi runes assigned in Unicode 15.0 (valid UTF-8).
+func text15(tc hegel.TestCase, lo, hi int) string {
+	k := n(tc, lo, hi)
+	rs := make([]rune, 0, k)
+	for i := 0; i < k; i++ {
+		rs = append(rs, anyRune(tc, false))
+	}
+	return string(rs)
+}
+
+// bytesAny draws a byte string: valid UTF-8 from any code point, with a few
+// ill-formed sequences injected now and then.
+func bytesAny(tc hegel.TestCase, lo, hi int) []byte {
+	k := n(tc, lo, hi)
+	var b []byte
+	for i := 0; i < k; i++ {
+		if chance(tc, 8) {
+			b = append(b, pick(tc, []byte{0x80}, []byte{0xC0, 0x80}, []byte{0xE2, 0x82}, []byte{0xF4, 0x90, 0x80, 0x80}, []byte{0xED, 0xA0, 0x80}, []byte{0xFF}, []byte{0xC3})...)
+			continue
+		}
+		b = utf8.AppendRune(b, anyRune(tc, true))
+	}
+	return b
+}
+
+// ---------------------------------------------------------------------------
+// Driving a transform.Transformer by the letter of its contract.
+
+var errNoProgress = errors.New("Transform made no progress with a large destination")
+
+// drive feeds src to t in pieces of at most chunk bytes (growing the piece on
+// ErrShortSrc) through a destination buffer of dstSize bytes (doubled when a
+// call makes no progress with ErrShortDst), and returns the concatenated
+// output. It checks the contract: a nil error means nSrc == len(src), and
+// ErrShortSrc is never returned with atEOF.
+func drive(t transform.Transformer, src []byte, chunk, dstSize int) ([]byte, error) {
+	t.Reset()
+	var out []byte
+	dst := make([]byte, dstSize)
+	pos, span := 0, chunk
+	for steps := 0; ; steps++ {
+		if steps > 20000 {
+			return out, errNoProgress
+		}
+		end := pos + span
+		if end > len(src) {
+			end = len(src)
+		}
+		atEOF := end == len(src)
+		nDst, nSrc, err := t.Transform(dst, src[pos:end], atEOF)
+		if nDst > len(dst) || nSrc > end-pos || nDst < 0 || nSrc < 0 {
+			return out, fmt.Errorf("Transform returned nDst=%d nSrc=%d for len(dst)=%d len(src)=%d", nDst, nSrc, len(dst), end-pos)
+		}
+		out = append(out, dst[:nDst]...)
+		pos += nSrc
+		switch err {
+		case nil:
+			if nSrc != end-pos+nSrc {
+				return out, fmt.Errorf("nil error with nSrc=%d < len(src)=%d", nSrc, end-pos+nSrc)
+			}
+			if atEOF {
+				return out, nil
+			}
+			span = chunk
+		case transform.ErrShortDst:
+			if nDst == 0 && nSrc == 0 {
+				if len(dst) > 1<<20 {
+					return out, errNoProgress
+				}
+				dst = make([]byte, 2*len(dst))
+			}
+		case transform.ErrShortSrc:
+			if atEOF {
+				return out, errors.New("ErrShortSrc returned with atEOF")
+			}
+			span = end - pos + chunk
+			if nSrc == 0 && nDst == 0 && span > len(src)-pos+chunk {
+				return out, errNoProgress
+			}
+		default:
+			return out, err
+		}
+	}
+}
+
+// chunkedReader returns at most k bytes per Read.
+type chunkedReader struct {
+	r io.Reader
+	k int
+}
+
+func (c *chunkedReader) Read(p []byte) (int, error) {
+	if len(p) > c.k {
+		p = p[:c.k]
+	}
+	return c.r.Read(p)
+}
+
+// viaReader runs t through transform.NewReader over a source that yields k
+// bytes at a time, reading with buffers of size m.
+func viaReader(t transform.Transformer, src []byte, k, m int) ([]byte, error) {
+	t.Reset()
+	r := transform.NewReader(&chunkedReader{bytes.NewReader(src), k}, t)
+	var out []byte
+	buf := make([]byte, m)
+	for i := 0; i < 1000000; i++ {
+		nr, err := r.Read(buf)
+		out = append(out, buf[:nr]...)
+		if err == io.EOF {
+			return out, nil
+		}
+		if err != nil {
+			return out, err
+		}
+	}
+	return out, errNoProgress
+}
+
+// viaWriter runs t through transform.NewWriter with writes of k bytes.
+func viaWriter(t transform.Transformer, src []byte, k int) ([]byte, error) {
+	t.Reset()
+	var buf bytes.Buffer
+	w := transform.NewWriter(&buf, t)
+	for i := 0; i < len(src); i += k {
+		j := i + k
+		if j > len(src) {
+			j = len(src)
+		}
+		if _, err := w.Write(src[i:j]); err != nil {
+			return buf.Bytes(), err
+		}
+	}
+	if err := w.Close(); err != nil {
+		return buf.Bytes(), err
+	}
+	return buf.Bytes(), nil
+}
diff --git a/hegel/hegel_norm_test.go b/hegel/hegel_norm_test.go
new file mode 100644
index 0000000..60ec784
--- /dev/null
+++ b/hegel/hegel_norm_test.go
@@ -0,0 +1,456 @@
+package hegel
+
+// unicode/norm, unicode/rangetable, unicode/runenames against Python's
+// unicodedata (Unicode 15.0) and against the package's own contracts.
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/text/unicode/norm"
+	"golang.org/x/text/unicode/rangetable"
+	"golang.org/x/text/unicode/runenames"
+	"hegel.dev/go/hegel"
+)
+
+var forms = []norm.Form{norm.NFC, norm.NFD, norm.NFKC, norm.NFKD}
+var formNames = map[norm.Form]string{norm.NFC: "NFC", norm.NFD: "NFD", norm.NFKC: "NFKC", norm.NFKD: "NFKD"}
+
+// Every form's String, Bytes and Append agree with Python's
+// unicodedata.normalize, and the forms satisfy the standard's identities.
+func TestHegelNormFormsAgreeWithPython(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		s := text15(ht, 0, 12)
+		if chance(ht, 10) {
+			// A long run of non-starters (and of Hangul V/T jamo, which combine
+			// backwards) around the 30-rune stream-safe limit.
+			var rs []rune
+			k := n(ht, 20, 40)
+			for i := 0; i < k; i++ {
+				rs = append(rs, pick[rune](ht, 0x0300, 0x0301, 0x0323, 0x05B0, 0x0334, 0x0345, 0x1161, 0x11A8, 0x0F73, 0x0344))
+			}
+			s = pick(ht, "a", "", "\u1100") + string(rs) + s
+		}
+		var want map[string]string
+		py.call(map[string]any{"op": "norm", "s": s}, &want)
+		got := map[string]string{}
+		for _, f := range forms {
+			name := formNames[f]
+			got[name] = f.String(s)
+			if got[name] != want[name] {
+				// The inserted CGJ also stops the canonical reordering at that point.
+				if Known.StreamSafeCGJ && strings.Count(got[name], "\u034f") > strings.Count(s, "\u034f") {
+					count(ht, "known x-text/1")
+					return
+				}
+				fail(ht, "%s(%s): got %s, Python %s", name, show(s), show(got[name]), show(want[name]))
+			}
+			if b := f.Bytes([]byte(s)); string(b) != got[name] {
+				fail(ht, "%s.Bytes(%s) = %s but String = %s", name, show(s), show(string(b)), show(got[name]))
+			}
+			if b := f.Append(nil, []byte(s)...); string(b) != got[name] {
+				fail(ht, "%s.Append(nil, %s) = %s but String = %s", name, show(s), show(string(b)), show(got[name]))
+			}
+			// Append returns f(append(out, src...)): the join may combine.
+			if b := f.AppendString([]byte("x"), s); string(b) != f.String("x"+s) {
+				fail(ht, "%s.AppendString(x, %s) = %s, %s(x + s) = %s", name, show(s), show(string(b)), name, show(f.String("x"+s)))
+			}
+			isNormal := got[name] == s
+			if f.IsNormalString(s) != isNormal || f.IsNormal([]byte(s)) != isNormal {
+				fail(ht, "%s.IsNormal(%s) = %v but %s(s) = %s", name, show(s), f.IsNormalString(s), name, show(got[name]))
+			}
+			q := f.QuickSpanString(s)
+			if q < 0 || q > len(s) || !utf8.ValidString(s[:q]) || f.String(s[:q]) != s[:q] {
+				fail(ht, "%s.QuickSpanString(%s) = %d but %s(prefix) = %s", name, show(s), q, name, show(f.String(s[:q])))
+			}
+			if isNormal && q != len(s) {
+				count(ht, "quickspan-conservative")
+			}
+			if f.QuickSpan([]byte(s)) != q {
+				fail(ht, "%s.QuickSpan bytes/string disagree on %s: %d vs %d", name, show(s), f.QuickSpan([]byte(s)), q)
+			}
+		}
+		// Identities of UAX #15.
+		if x := norm.NFC.String(got["NFD"]); x != got["NFC"] {
+			fail(ht, "NFC(NFD(%s)) = %s but NFC = %s", show(s), show(x), show(got["NFC"]))
+		}
+		if x := norm.NFD.String(got["NFC"]); x != got["NFD"] {
+			fail(ht, "NFD(NFC(%s)) = %s but NFD = %s", show(s), show(x), show(got["NFD"]))
+		}
+		if x := norm.NFKC.String(got["NFKD"]); x != got["NFKC"] {
+			fail(ht, "NFKC(NFKD(%s)) = %s but NFKC = %s", show(s), show(x), show(got["NFKC"]))
+		}
+		if x := norm.NFKD.String(got["NFKC"]); x != got["NFKD"] {
+			fail(ht, "NFKD(NFKC(%s)) = %s but NFKD = %s", show(s), show(x), show(got["NFKD"]))
+		}
+		for _, f := range forms {
+			name := formNames[f]
+			if x := f.String(got[name]); x != got[name] {
+				fail(ht, "%s is not idempotent on %s: %s then %s", name, show(s), show(got[name]), show(x))
+			}
+		}
+	})
+}
+
+// The streaming paths (Transform driven by the contract, Reader, Writer,
+// Iter) produce the same bytes as the one-shot Bytes, on any input including
+// ill-formed UTF-8 and long combining sequences.
+func TestHegelNormStreamingMatchesWholeString(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := pick(ht, forms...)
+		name := formNames[f]
+		var src []byte
+		if chance(ht, 20) {
+			// A long run of non-starters, around and past the segment limit.
+			src = []byte(pick(ht, "a", "", "ᄀ", "̈́"))
+			k := n(ht, 1, 40)
+			for i := 0; i < k; i++ {
+				src = utf8.AppendRune(src, pick[rune](ht, 0x0300, 0x0301, 0x0323, 0x05B0, 0x0334, 0x0345, 0x034F, 0x1161, 0x11A8, 0x0F73, 0x0344))
+			}
+			if chance(ht, 50) {
+				src = append(src, []byte(text15(ht, 0, 4))...)
+			}
+		} else {
+			src = bytesAny(ht, 0, 16)
+		}
+		want := f.Bytes(src)
+		chunk, dstSize := n(ht, 1, 9), pick(ht, 1, 2, 3, 4, 7, 16, 64)
+		got, err := drive(f, src, chunk, dstSize)
+		if err != nil {
+			fail(ht, "%s.Transform on %q (chunk %d, dst %d): %v", name, src, chunk, dstSize, err)
+		}
+		if !bytes.Equal(got, want) {
+			fail(ht, "%s.Transform on %q in chunks of %d with dst %d: %q, one-shot %q", name, src, chunk, dstSize, got, want)
+		}
+		k, m := n(ht, 1, 7), pick(ht, 1, 3, 8, 64)
+		if got, err := viaReader(f, src, k, m); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s via transform.NewReader on %q (%d bytes per read, buffer %d): %q, %v; one-shot %q", name, src, k, m, got, err, want)
+		}
+		if got, err := viaWriter(f, src, k); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s via transform.NewWriter on %q (writes of %d): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		if got, err := viaReader(readerForm{f}, src, k, m); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s.Reader on %q (%d bytes per read): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		if got, err := writerForm(f, src, k); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s.Writer on %q (writes of %d): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		var it norm.Iter
+		it.Init(f, src)
+		var acc []byte
+		pos := 0
+		for i := 0; !it.Done(); i++ {
+			if i > 10*len(src)+10 {
+				fail(ht, "%s Iter over %q does not finish", name, src)
+			}
+			if p := it.Pos(); p < pos || p > len(src) {
+				fail(ht, "%s Iter.Pos on %q went from %d to %d", name, src, pos, p)
+			} else {
+				pos = p
+			}
+			acc = append(acc, it.Next()...)
+		}
+		if !bytes.Equal(acc, want) {
+			// The two paths place the stream-safe CGJ differently (and the
+			// reordering stops at it), never otherwise.
+			if Known.IterJamoCGJ && (bytes.Contains(acc, []byte("\u034f")) || bytes.Contains(want, []byte("\u034f"))) {
+				count(ht, "known x-text/2")
+				return
+			}
+			fail(ht, "%s Iter over %q yields %q, one-shot %q", name, src, acc, want)
+		}
+		if p := it.Pos(); p != len(src) {
+			fail(ht, "%s Iter over %q is Done at Pos %d of %d", name, src, p, len(src))
+		}
+	})
+}
+
+// readerForm adapts norm.Form.Reader to the viaReader helper's Transformer
+// argument (only Transform's identity matters: viaReader builds its own
+// transform.Reader, so wrap Form.Reader directly instead).
+type readerForm struct{ f norm.Form }
+
+func (r readerForm) Transform(dst, src []byte, atEOF bool) (int, int, error) {
+	return r.f.Transform(dst, src, atEOF)
+}
+func (r readerForm) Reset() {}
+
+func writerForm(f norm.Form, src []byte, k int) ([]byte, error) {
+	var buf bytes.Buffer
+	w := f.Writer(&buf)
+	for i := 0; i < len(src); i += k {
+		j := i + k
+		if j > len(src) {
+			j = len(src)
+		}
+		if _, err := w.Write(src[i:j]); err != nil {
+			return buf.Bytes(), err
+		}
+	}
+	if err := w.Close(); err != nil {
+		return buf.Bytes(), err
+	}
+	return buf.Bytes(), nil
+}
+
+// Boundaries split the input into independently normalizable pieces, Span
+// prefixes are normal, and Properties match unicodedata.
+func TestHegelNormBoundariesAndProperties(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		s := text15(ht, 0, 10)
+		b := []byte(s)
+		f := pick(ht, forms...)
+		name := formNames[f]
+		// Boundaries are shared between NFC and NFD, and between NFKC and NFKD
+		// (the compatibility decompositions add non-starters of their own, as
+		// U+FF9F -> U+309A).
+		kin := []norm.Form{norm.NFC, norm.NFD}
+		if f == norm.NFKC || f == norm.NFKD {
+			kin = []norm.Form{norm.NFKC, norm.NFKD}
+		}
+		splitsCleanly := func(i int, what string) {
+			for _, g := range kin {
+				if x := g.String(s[:i]) + g.String(s[i:]); x != g.String(s) {
+					fail(ht, "%s reports a boundary at %d in %s, but %s of the parts %s + %s != %s", what, i, show(s), formNames[g], show(g.String(s[:i])), show(g.String(s[i:])), show(g.String(s)))
+				}
+			}
+		}
+		if i := f.FirstBoundary(b); i != -1 {
+			if i < 0 || i > len(b) || i != f.FirstBoundaryInString(s) {
+				fail(ht, "%s.FirstBoundary(%s) = %d (string version %d)", name, show(s), i, f.FirstBoundaryInString(s))
+			}
+			splitsCleanly(i, name+".FirstBoundary")
+		}
+		if i := f.LastBoundary(b); i != -1 {
+			if i < 0 || i > len(b) {
+				fail(ht, "%s.LastBoundary(%s) = %d", name, show(s), i)
+			}
+			splitsCleanly(i, name+".LastBoundary")
+		}
+		// Walk the segments with NextBoundary.
+		pos, segs := 0, 0
+		for pos < len(b) {
+			i := f.NextBoundary(b[pos:], true)
+			if i <= 0 || i > len(b)-pos {
+				fail(ht, "%s.NextBoundary(%s[%d:], true) = %d", name, show(s), pos, i)
+			}
+			if j := f.NextBoundaryInString(s[pos:], true); j != i {
+				fail(ht, "%s.NextBoundary bytes %d vs string %d on %s[%d:]", name, i, j, show(s), pos)
+			}
+			if j := f.NextBoundary(b[pos:], false); j != -1 && j != i {
+				fail(ht, "%s.NextBoundary(%s[%d:]) = %d at EOF but %d without", name, show(s), pos, i, j)
+			}
+			splitsCleanly(pos+i, name+".NextBoundary")
+			pos += i
+			segs++
+			if segs > len(b)+1 {
+				fail(ht, "%s.NextBoundary loops on %s", name, show(s))
+			}
+		}
+		if len(b) == 0 && f.NextBoundary(b, true) != 0 {
+			fail(ht, "%s.NextBoundary(empty, true) = %d", name, f.NextBoundary(b, true))
+		}
+		// Span: a boundary prefix that is already normal.
+		if k, err := f.Span(b, true); k < 0 || k > len(b) || f.String(s[:k]) != s[:k] || (k < len(b)) != (err != nil) {
+			fail(ht, "%s.Span(%s, true) = %d, %v", name, show(s), k, err)
+		}
+		if k, err := f.SpanString(s, false); k < 0 || k > len(b) || f.String(s[:k]) != s[:k] || (k < len(b)) != (err != nil) {
+			fail(ht, "%s.SpanString(%s, false) = %d, %v", name, show(s), k, err)
+		}
+		// Properties against unicodedata.
+		ps := py.props(s)
+		rs := []rune(s)
+		for i, r := range rs {
+			if i >= len(ps) {
+				break
+			}
+			p := f.PropertiesString(string(r))
+			if p.Size() != utf8.RuneLen(r) {
+				fail(ht, "%s.Properties(%U).Size() = %d", name, r, p.Size())
+			}
+			if int(p.CCC()) != ps[i].CCC {
+				fail(ht, "%s.Properties(%U).CCC() = %d, unicodedata.combining = %d", name, r, p.CCC(), ps[i].CCC)
+			}
+			d := p.Decomposition()
+			hangul := r >= 0xAC00 && r <= 0xD7A3
+			var full string
+			if f == norm.NFC || f == norm.NFD {
+				full = norm.NFD.String(string(r))
+			} else {
+				full = norm.NFKD.String(string(r))
+			}
+			if hangul {
+				count(ht, "hangul-decomposition")
+			} else if d == nil && full != string(r) {
+				fail(ht, "%s.Properties(%U).Decomposition() is nil but the rune decomposes to %s", name, r, show(full))
+			} else if d != nil && string(d) != full {
+				fail(ht, "%s.Properties(%U).Decomposition() = %s, full decomposition %s", name, r, show(string(d)), show(full))
+			}
+			if d != nil {
+				dr := []rune(string(d))
+				if p.LeadCCC() != f.PropertiesString(string(dr[0])).CCC() || p.TrailCCC() != f.PropertiesString(string(dr[len(dr)-1])).CCC() {
+					fail(ht, "%s.Properties(%U): LeadCCC %d TrailCCC %d, decomposition %s", name, r, p.LeadCCC(), p.TrailCCC(), show(string(d)))
+				}
+			} else if p.LeadCCC() != p.CCC() || p.TrailCCC() != p.CCC() {
+				fail(ht, "%s.Properties(%U): no decomposition but LeadCCC %d TrailCCC %d CCC %d", name, r, p.LeadCCC(), p.TrailCCC(), p.CCC())
+			}
+			if p.BoundaryBefore() && ps[i].CCC != 0 {
+				fail(ht, "%s.Properties(%U).BoundaryBefore() with CCC %d", name, r, ps[i].CCC)
+			}
+			if p.BoundaryBefore() {
+				// A rune that starts a segment: the normalization of any prefix + r splits before r.
+				pre := pick(ht, "a", "́", "ᄀ", "क")
+				for _, g := range kin {
+					if g.String(pre+string(r)) != g.String(pre)+g.String(string(r)) {
+						fail(ht, "%s.Properties(%U).BoundaryBefore() but %s(%s + %U) = %s", name, r, formNames[g], show(pre), r, show(g.String(pre+string(r))))
+					}
+				}
+			}
+		}
+	})
+}
+
+// rangetable.Merge is the union of its tables, in a well-formed table, and
+// New/Visit round-trip a set of runes.
+func TestHegelRangeTableMergeIsTheUnion(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 4)
+		var tables []*unicode.RangeTable
+		in := map[rune]bool{}
+		for i := 0; i < k; i++ {
+			switch n(ht, 1, 4) {
+			case 1:
+				tables = append(tables, pick(ht, unicode.Letter, unicode.Greek, unicode.Han, unicode.Nd, unicode.Zs, unicode.Latin, unicode.Cc))
+				rangetable.Visit(tables[len(tables)-1], func(r rune) { in[r] = true })
+			case 2:
+				// A hand-built table with strides.
+				rt := &unicode.RangeTable{}
+				m := n(ht, 1, 3)
+				lo := rune(n(ht, 0, 0x2000))
+				for j := 0; j < m; j++ {
+					stride := rune(n(ht, 1, 3))
+					cnt := rune(n(ht, 0, 5))
+					hi := lo + stride*cnt
+					if hi <= unicode.MaxLatin1 {
+						rt.LatinOffset++
+					}
+					rt.R16 = append(rt.R16, unicode.Range16{Lo: uint16(lo), Hi: uint16(hi), Stride: uint16(stride)})
+					for r := lo; r <= hi; r += stride {
+						in[r] = true
+					}
+					lo = hi + rune(n(ht, 1, 20))
+				}
+				if chance(ht, 50) {
+					lo32 := rune(n(ht, 0x10000, 0x20000))
+					stride := rune(n(ht, 1, 3))
+					hi32 := lo32 + stride*rune(n(ht, 0, 5))
+					rt.R32 = append(rt.R32, unicode.Range32{Lo: uint32(lo32), Hi: uint32(hi32), Stride: uint32(stride)})
+					for r := lo32; r <= hi32; r += stride {
+						in[r] = true
+					}
+				}
+				tables = append(tables, rt)
+			default:
+				m := n(ht, 0, 8)
+				rs := make([]rune, 0, m)
+				for j := 0; j < m; j++ {
+					r := anyRune(ht, true)
+					rs = append(rs, r)
+					in[r] = true
+				}
+				nt := rangetable.New(rs...)
+				var back []rune
+				rangetable.Visit(nt, func(r rune) { back = append(back, r) })
+				set := map[rune]bool{}
+				for _, r := range rs {
+					set[r] = true
+				}
+				if len(back) != len(set) {
+					fail(ht, "rangetable.New(%v) visits %v", rs, back)
+				}
+				for i, r := range back {
+					if !set[r] || (i > 0 && back[i-1] >= r) {
+						fail(ht, "rangetable.New(%v) visits %v", rs, back)
+					}
+				}
+				tables = append(tables, nt)
+			}
+		}
+		merged := rangetable.Merge(tables...)
+		// Well-formed: sorted, non-overlapping, strides positive, LatinOffset right.
+		prev := rune(-1)
+		latin := 0
+		for _, r := range merged.R16 {
+			if r.Stride == 0 || r.Lo > r.Hi || rune(r.Lo) <= prev || (r.Hi-r.Lo)%r.Stride != 0 {
+				fail(ht, "Merge of %d tables: malformed R16 %+v after %d", k, r, prev)
+			}
+			prev = rune(r.Hi)
+			if r.Hi <= unicode.MaxLatin1 {
+				latin++
+			}
+		}
+		if merged.LatinOffset != latin {
+			fail(ht, "Merge of %d tables: LatinOffset %d, %d ranges end in Latin-1: %+v", k, merged.LatinOffset, latin, merged.R16)
+		}
+		for _, r := range merged.R32 {
+			if r.Stride == 0 || r.Lo > r.Hi || rune(r.Lo) <= prev || (r.Hi-r.Lo)%r.Stride != 0 || r.Lo <= 0xFFFF {
+				fail(ht, "Merge of %d tables: malformed R32 %+v after %d", k, r, prev)
+			}
+			prev = rune(r.Hi)
+		}
+		// Membership.
+		var visited []rune
+		rangetable.Visit(merged, func(r rune) { visited = append(visited, r) })
+		if len(visited) != len(in) {
+			fail(ht, "Merge of %d tables has %d runes, the union %d", k, len(visited), len(in))
+		}
+		for _, r := range visited {
+			if !in[r] {
+				fail(ht, "Merge of %d tables contains %U, not in the union", k, r)
+			}
+		}
+		for i := 0; i < 20; i++ {
+			r := anyRune(ht, true)
+			if unicode.Is(merged, r) != in[r] {
+				fail(ht, "unicode.Is(Merge of %d tables, %U) = %v, union says %v", k, r, unicode.Is(merged, r), in[r])
+			}
+		}
+	})
+}
+
+// runenames.Name agrees with unicodedata.name on every named Unicode 15.0
+// character.
+func TestHegelRuneNamesMatchPython(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		s := text15(ht, 1, 8)
+		ps := py.props(s)
+		for i, r := range []rune(s) {
+			if i >= len(ps) {
+				break
+			}
+			got := runenames.Name(r)
+			if strings.HasPrefix(got, "<") && strings.HasSuffix(got, ">") {
+				// The UnicodeData range label (<Hangul Syllable>, <CJK Ideograph>, <Private Use>)
+				// stands for the whole range; the standard's derived names are not computed.
+				count(ht, "range-label")
+				continue
+			}
+			if ps[i].Name == "" {
+				count(ht, "unnamed-in-python")
+				if got != "" && !(ps[i].Cat == "Cc" && got == "<control>") {
+					note(ht, "%U: Go %q, Python has no name (category %s)", r, got, ps[i].Cat)
+				}
+				continue
+			}
+			if got != ps[i].Name {
+				fail(ht, "runenames.Name(%U) = %q, unicodedata.name = %q", r, got, ps[i].Name)
+			}
+		}
+	})
+}
