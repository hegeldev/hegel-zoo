+package hegel
+
+// transform, runes, number, message and feature/plural against models of
+// their documentation and against the standard library's fmt.
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/text/feature/plural"
+	"golang.org/x/text/language"
+	"golang.org/x/text/message"
+	"golang.org/x/text/message/catalog"
+	"golang.org/x/text/number"
+	"golang.org/x/text/runes"
+	"golang.org/x/text/transform"
+	"golang.org/x/text/unicode/norm"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// runes and transform
+
+// runeSet is a named runes.Set with the predicate it was built from.
+type runeSet struct {
+	name string
+	set  runes.Set
+	f    func(rune) bool
+}
+
+func (s runeSet) GoString() string { return s.name }
+
+var runeSets = hegel.SampledFrom([]runeSet{
+	{"In(Mn)", runes.In(unicode.Mn), func(r rune) bool { return unicode.Is(unicode.Mn, r) }},
+	{"NotIn(Latin)", runes.NotIn(unicode.Latin), func(r rune) bool { return !unicode.Is(unicode.Latin, r) }},
+	{"Predicate(a)", runes.Predicate(func(r rune) bool { return r == 'a' }), func(r rune) bool { return r == 'a' }},
+	{"Predicate(RuneError)", runes.Predicate(func(r rune) bool { return r == utf8.RuneError }), func(r rune) bool { return r == utf8.RuneError }},
+	{"In(ASCII)", runes.In(&unicode.RangeTable{R16: []unicode.Range16{{Lo: 0, Hi: 0x7f, Stride: 1}}}), func(r rune) bool { return r < 0x80 }},
+	{"Predicate(upper)", runes.Predicate(unicode.IsUpper), unicode.IsUpper},
+})
+
+// eachRune walks src the way utf8.DecodeRune does: every byte of an
+// ill-formed sequence is one RuneError of size 1.
+func eachRune(src []byte, fn func(r rune, b []byte)) {
+	for i := 0; i < len(src); {
+		r, size := utf8.DecodeRune(src[i:])
+		fn(r, src[i:i+size])
+		i += size
+	}
+}
+
+func mapRune(r rune) rune {
+	switch {
+	case r == 'a':
+		return 'b'
+	case r == utf8.RuneError:
+		return '?'
+	case r >= 0x80 && r < 0x800:
+		return r + 0x10000 // grows from two to four bytes
+	case r >= 0x10000:
+		return 'x' // shrinks
+	}
+	return r
+}
+
+var runesOps = []string{"Remove", "Map", "ReplaceIllFormed", "If"}
+
+// runesSources: any bytes, or (three times in ten) some a's, a short text
+// and a tail that may be a truncated sequence.
+var runesSources = weighted(
+	choice[[]byte]{70, anyBytes(0, 24)},
+	choice[[]byte]{30, hegel.Map(cat(alphabet([]rune{'a'}, 0, 3), texts15(0, 6), hegel.SampledFrom([]string{"", "\xff", "\xc3", "a"})), func(s string) []byte { return []byte(s) })},
+)
+
+// runesCase: the source, the set, the transformer (by index) and how it is
+// streamed.
+type runesCase struct {
+	src        []byte
+	set        runeSet
+	op         int
+	chunk, dst int
+}
+
+func (c runesCase) GoString() string {
+	return fmt.Sprintf("%s with %s on %s, pieces of %d, dst %d", runesOps[c.op], c.set.name, show(string(c.src)), c.chunk, c.dst)
+}
+
+var runesCases = hegel.Composite(func(tc hegel.TestCase) runesCase {
+	return runesCase{
+		src:   hegel.Draw(tc, runesSources),
+		set:   hegel.Draw(tc, runeSets),
+		op:    hegel.Draw(tc, hegel.Integers(0, len(runesOps)-1)),
+		chunk: hegel.Draw(tc, hegel.Integers(1, 5)),
+		dst:   hegel.Draw(tc, hegel.Integers(1, 9)),
+	}
+})
+
+// Remove, Map, ReplaceIllFormed and If follow their documented models on any
+// bytes (ill-formed sequences become RuneError before the predicate or mapping
+// sees them), their Span is exact, and streaming matches the one shot.
+func TestHegelRunesTransformersFollowTheirModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, runesCases)
+		src, set := c.src, c.set
+		mp := runes.Map(mapRune)
+		var want bytes.Buffer
+		var tr runes.Transformer
+		var name string
+		switch runesOps[c.op] {
+		case "Remove":
+			name = "Remove(" + set.name + ")"
+			tr = runes.Remove(set.set)
+			eachRune(src, func(r rune, b []byte) {
+				if !set.f(r) {
+					if r == utf8.RuneError && len(b) == 1 {
+						want.WriteString("\ufffd")
+					} else {
+						want.Write(b)
+					}
+				}
+			})
+		case "Map":
+			name = "Map"
+			tr = mp
+			eachRune(src, func(r rune, b []byte) { want.WriteRune(mapRune(r)) })
+		case "ReplaceIllFormed":
+			name = "ReplaceIllFormed"
+			tr = runes.ReplaceIllFormed()
+			eachRune(src, func(r rune, b []byte) {
+				if r == utf8.RuneError && len(b) == 1 {
+					want.WriteString("\ufffd")
+				} else {
+					want.Write(b)
+				}
+			})
+		default:
+			// If: Map on the runes in the set, Remove(Mn) on the others; runs
+			// of each are transformed independently (both are stateless).
+			name = "If(" + set.name + ")"
+			rm := runes.Remove(runes.In(unicode.Mn))
+			tr = runes.If(set.set, mp, rm)
+			eachRune(src, func(r rune, b []byte) {
+				if set.f(r) {
+					want.WriteRune(mapRune(r))
+				} else if !unicode.Is(unicode.Mn, r) {
+					if r == utf8.RuneError && len(b) == 1 {
+						want.WriteString("\ufffd") // Remove's replacement
+					} else {
+						want.Write(b)
+					}
+				}
+			})
+		}
+		got := tr.String(string(src))
+		if got != want.String() {
+			fail(ht, "%s(%s) = %s, model %s", name, show(string(src)), show(got), show(want.String()))
+		}
+		if b := tr.Bytes(src); string(b) != got {
+			fail(ht, "%s.Bytes(%s) = %s but String = %s", name, show(string(src)), show(string(b)), show(got))
+		}
+		k, err := tr.Span(src, true)
+		if k < 0 || k > len(src) || tr.String(string(src[:k])) != string(src[:k]) {
+			fail(ht, "%s.Span(%s) = %d, %v but the prefix transforms to %s", name, show(string(src)), k, err, show(tr.String(string(src[:k]))))
+		}
+		if (k == len(src) && err == nil) != (got == string(src)) {
+			fail(ht, "%s.Span(%s) = %d, %v but String = %s", name, show(string(src)), k, err, show(got))
+		}
+		out, err := drive(tr, src, c.chunk, c.dst)
+		if err != nil || string(out) != got {
+			fail(ht, "%s streamed %s to %s, %v; String = %s", name, show(string(src)), show(string(out)), err, show(got))
+		}
+	})
+}
+
+// upperASCII is a stateless transformer with its own Span, for chains.
+type upperASCII struct{ transform.NopResetter }
+
+func (upperASCII) Transform(dst, src []byte, atEOF bool) (nDst, nSrc int, err error) {
+	for ; nSrc < len(src); nSrc++ {
+		if nDst >= len(dst) {
+			return nDst, nSrc, transform.ErrShortDst
+		}
+		c := src[nSrc]
+		if 'a' <= c && c <= 'z' {
+			c -= 'a' - 'A'
+		}
+		dst[nDst] = c
+		nDst++
+	}
+	return nDst, nSrc, nil
+}
+
+// chainLinks are the transformers a chain is made of.
+var chainLinks = []struct {
+	name string
+	t    transform.Transformer
+}{
+	{"Map", runes.Map(mapRune)},
+	{"Remove(Mn)", runes.Remove(runes.In(unicode.Mn))},
+	{"NFD", norm.NFD},
+	{"NFC", norm.NFC},
+	{"upperASCII", upperASCII{}},
+	{"ReplaceIllFormed", runes.ReplaceIllFormed()},
+	{"Nop", transform.Nop},
+}
+
+// chainCase: the source, up to four links (by index), a prefix for Append,
+// the driver's, reader's and writer's sizes, and a set for RemoveFunc.
+type chainCase struct {
+	src        []byte
+	links      []int
+	prefix     string
+	chunk, dst int
+	rk, rm, wk int
+	set        runeSet
+}
+
+func (c chainCase) name() string {
+	var names []string
+	for _, l := range c.links {
+		names = append(names, chainLinks[l].name)
+	}
+	return "Chain(" + strings.Join(names, ", ") + ")"
+}
+
+func (c chainCase) GoString() string {
+	return fmt.Sprintf("%s on %s, prefix %q, pieces of %d, dst %d, reads of %d into %d, writes of %d, RemoveFunc(%s)", c.name(), show(string(c.src)), c.prefix, c.chunk, c.dst, c.rk, c.rm, c.wk, c.set.name)
+}
+
+var chainCases = hegel.Composite(func(tc hegel.TestCase) chainCase {
+	return chainCase{
+		src:    hegel.Draw(tc, anyBytes(0, 40)),
+		links:  hegel.Draw(tc, many(hegel.Integers(0, len(chainLinks)-1), 0, 4)),
+		prefix: hegel.Draw(tc, hegel.SampledFrom([]string{"", "xy"})),
+		chunk:  hegel.Draw(tc, hegel.Integers(1, 7)),
+		dst:    hegel.Draw(tc, hegel.Integers(1, 16)),
+		rk:     hegel.Draw(tc, hegel.Integers(1, 7)),
+		rm:     hegel.Draw(tc, hegel.Integers(1, 16)),
+		wk:     hegel.Draw(tc, hegel.Integers(1, 7)),
+		set:    hegel.Draw(tc, runeSets),
+	}
+})
+
+// transform.Chain is the composition of its links, String/Bytes/Append and
+// NewReader/NewWriter agree with it on any bytes, Nop and Discard do what
+// they say, and RemoveFunc is Remove.
+func TestHegelTransformChainIsTheComposition(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, chainCases)
+		src := c.src
+		var ts []transform.Transformer
+		want := src
+		for _, i := range c.links {
+			l := chainLinks[i]
+			ts = append(ts, l.t)
+			var err error
+			want, _, err = transform.Bytes(l.t, want)
+			if err != nil {
+				fail(ht, "%s on %s: %v", l.name, show(string(src)), err)
+				return
+			}
+		}
+		name := c.name()
+		ch := transform.Chain(ts...)
+		got, nn, err := transform.Bytes(ch, src)
+		if err != nil || nn != len(src) || !bytes.Equal(got, want) {
+			fail(ht, "%s on %s = %s, %d, %v; composition %s", name, show(string(src)), show(string(got)), nn, err, show(string(want)))
+			return
+		}
+		if s, nn, err := transform.String(ch, string(src)); err != nil || nn != len(src) || s != string(want) {
+			fail(ht, "transform.String(%s, %s) = %s, %d, %v", name, show(string(src)), show(s), nn, err)
+		}
+		prefix := []byte(c.prefix)
+		if a, _, err := transform.Append(ch, append([]byte{}, prefix...), src); err != nil || string(a) != string(prefix)+string(want) {
+			fail(ht, "transform.Append(%s, %s, %s) = %s, %v", name, show(string(prefix)), show(string(src)), show(string(a)), err)
+		}
+		if out, err := drive(ch, src, c.chunk, c.dst); err != nil || !bytes.Equal(out, want) {
+			fail(ht, "%s streamed %s to %s, %v; one shot %s", name, show(string(src)), show(string(out)), err, show(string(want)))
+		}
+		if out, err := viaReader(ch, src, c.rk, c.rm); err != nil || !bytes.Equal(out, want) {
+			fail(ht, "%s via NewReader on %s: %s, %v; one shot %s", name, show(string(src)), show(string(out)), err, show(string(want)))
+		}
+		if out, err := viaWriter(ch, src, c.wk); err != nil || !bytes.Equal(out, want) {
+			fail(ht, "%s via NewWriter on %s: %s, %v; one shot %s", name, show(string(src)), show(string(out)), err, show(string(want)))
+		}
+		if out, _, err := transform.Bytes(transform.Discard, src); err != nil || len(out) != 0 {
+			fail(ht, "Discard on %s: %s, %v", show(string(src)), show(string(out)), err)
+		}
+		if out, _, err := transform.Bytes(transform.Nop, src); err != nil || !bytes.Equal(out, src) {
+			fail(ht, "Nop on %s: %s, %v", show(string(src)), show(string(out)), err)
+		}
+		set := c.set
+		a, _, _ := transform.Bytes(transform.RemoveFunc(set.f), src)
+		b := runes.Remove(set.set).Bytes(src)
+		if !bytes.Equal(a, b) {
+			fail(ht, "RemoveFunc(%s) on %s = %s, runes.Remove = %s", set.name, show(string(src)), show(string(a)), show(string(b)))
+		}
+	})
+}
