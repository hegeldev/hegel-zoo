+// ---------------------------------------------------------------------------
+// number
+
+// decimalValue is a number with its exact decimal expansion (sign, integer
+// digits, fraction digits without trailing zeros).
+type decimalValue struct {
+	v    interface{}
+	neg  bool
+	ip   string
+	fp   string
+	desc string
+}
+
+// numSpec is the magnitude of a number to format, in one of the Go types
+// the formatters take; value gives it a sign and its exact expansion.
+type numSpec interface{ value(neg bool) decimalValue }
+
+type (
+	int64Spec struct{ k int64 }
+	smallSpec struct{ k int } // an int32 when negative, a uint16 otherwise
+	floatSpec struct{ f float64 }
+)
+
+func (s int64Spec) value(neg bool) decimalValue {
+	k := s.k
+	d := decimalValue{ip: fmt.Sprint(k)}
+	if neg {
+		k = -k
+	}
+	d.v, d.desc = k, fmt.Sprint(k)
+	return d.normalized(neg)
+}
+
+func (s smallSpec) value(neg bool) decimalValue {
+	d := decimalValue{ip: fmt.Sprint(s.k)}
+	if neg {
+		d.v = int32(-s.k)
+	} else {
+		d.v = uint16(s.k)
+	}
+	d.desc = fmt.Sprint(d.v)
+	return d.normalized(neg)
+}
+
+func (s floatSpec) value(neg bool) decimalValue {
+	// The float64 is the nearest double, whose exact expansion %.80f gives.
+	f := s.f
+	if neg {
+		f = -f
+	}
+	d := decimalValue{v: f, desc: fmt.Sprintf("%v", f)}
+	x := strings.TrimPrefix(fmt.Sprintf("%.80f", f), "-")
+	dot := strings.IndexByte(x, '.')
+	d.ip, d.fp = x[:dot], strings.TrimRight(x[dot+1:], "0")
+	return d.normalized(neg)
+}
+
+// normalized strips the leading zeros and settles the sign (minus zero is
+// not negative).
+func (d decimalValue) normalized(neg bool) decimalValue {
+	d.ip = strings.TrimLeft(d.ip, "0")
+	if d.ip == "" {
+		d.ip = "0"
+	}
+	d.neg = neg && (d.ip != "0" || d.fp != "")
+	return d
+}
+
+var (
+	// int64Specs: up to two million, or (one time in five) a product of up to
+	// a billion by up to a million.
+	int64Specs = weighted(
+		choice[numSpec]{80, hegel.Map(hegel.Integers(0, 2000000), func(k int) numSpec { return int64Spec{int64(k)} })},
+		choice[numSpec]{20, hegel.Map(pairs(hegel.Integers(0, 1000000000), hegel.Integers(1, 1000000)), func(p pair[int, int]) numSpec { return int64Spec{int64(p.a) * int64(p.b)} })},
+	)
+	smallSpecs = hegel.Map(hegel.Integers(0, 60000), func(k int) numSpec { return smallSpec{k} })
+	// floatSpecs: k / 10^e, exactly representable as a decimal; or (15 times
+	// in a hundred) a quotient of small integers.
+	floatSpecs = weighted(
+		choice[numSpec]{85, hegel.Map(pairs(hegel.Integers(0, 99999999), hegel.Integers(0, 7)), func(p pair[int, int]) numSpec {
+			f := float64(p.a)
+			for i := 0; i < p.b; i++ {
+				f /= 10
+			}
+			return floatSpec{f}
+		})},
+		choice[numSpec]{15, hegel.Map(pairs(hegel.Integers(1, 1000000), hegel.Integers(1, 1000)), func(p pair[int, int]) numSpec { return floatSpec{float64(p.a) / float64(p.b)} })},
+	)
+	// numSpecs: an int64 one time in four, a small integer one time in four,
+	// a float otherwise.
+	numSpecs = weighted(choice[numSpec]{1, int64Specs}, choice[numSpec]{1, smallSpecs}, choice[numSpec]{2, floatSpecs})
+)
+
+// shift moves the decimal point k places to the right.
+func (d decimalValue) shift(k int) decimalValue {
+	for i := 0; i < k; i++ {
+		if d.fp == "" {
+			d.ip += "0"
+		} else {
+			d.ip += d.fp[:1]
+			d.fp = d.fp[1:]
+		}
+	}
+	d.ip = strings.TrimLeft(d.ip, "0")
+	if d.ip == "" {
+		d.ip = "0"
+	}
+	return d
+}
+
+// roundHalfEven rounds the fraction to at most maxFrac digits.
+func (d decimalValue) roundHalfEven(maxFrac int) decimalValue {
+	if len(d.fp) <= maxFrac {
+		return d
+	}
+	keep, rest := d.fp[:maxFrac], d.fp[maxFrac:]
+	digits := []byte(d.ip + keep)
+	up := false
+	switch {
+	case rest[0] > '5':
+		up = true
+	case rest[0] == '5' && strings.TrimRight(rest[1:], "0") != "":
+		up = true
+	case rest[0] == '5':
+		up = (digits[len(digits)-1]-'0')%2 == 1
+	}
+	if up {
+		i := len(digits) - 1
+		for ; i >= 0; i-- {
+			if digits[i] == '9' {
+				digits[i] = '0'
+			} else {
+				digits[i]++
+				break
+			}
+		}
+		if i < 0 {
+			digits = append([]byte{'1'}, digits...)
+		}
+	}
+	d.ip = string(digits[:len(digits)-maxFrac])
+	d.fp = strings.TrimRight(string(digits[len(digits)-maxFrac:]), "0")
+	d.ip = strings.TrimLeft(d.ip, "0")
+	if d.ip == "" {
+		d.ip = "0"
+	}
+	return d
+}
+
+// intDigits applies MaxIntegerDigits (keep the last max digits, then drop
+// the leading zeros that leaves) and MinIntegerDigits (pad with zeros).
+func intDigits(ip string, minInt, maxInt int) string {
+	if maxInt > 0 && len(ip) > maxInt {
+		ip = strings.TrimLeft(ip[len(ip)-maxInt:], "0")
+		if ip == "" {
+			ip = "0"
+		}
+	}
+	for len(ip) < minInt {
+		ip = "0" + ip
+	}
+	return ip
+}
+
+func group(ip string, primary, secondary int) string {
+	if primary == 0 || len(ip) <= primary {
+		return ip
+	}
+	out := ip[len(ip)-primary:]
+	rest := ip[:len(ip)-primary]
+	for len(rest) > secondary {
+		out = rest[len(rest)-secondary:] + "," + out
+		rest = rest[:len(rest)-secondary]
+	}
+	return rest + "," + out
+}
+
+// numModel is the state of the pattern as the options are applied in order:
+// the options and their names for the library, and what the model expects.
+type numModel struct {
+	opts                                            []number.Option
+	names                                           []string
+	separator                                       bool
+	minFrac, maxFrac, minInt, maxInt, width, libMax int
+	pad                                             string
+}
+
+func newNumModel(maxFrac int) numModel {
+	return numModel{separator: true, minInt: 1, maxFrac: maxFrac, libMax: -1, pad: " "}
+}
+
+func (m *numModel) add(o number.Option, name string) {
+	m.opts = append(m.opts, o)
+	m.names = append(m.names, name)
+}
+
+// numOpt is one number.Option with its effect on the model.
+type numOpt interface {
+	apply(m *numModel)
+	String() string
+}
+
+type (
+	noSeparatorOpt struct{}
+	maxFracOpt     struct{ k int }
+	minFracOpt     struct{ k int }
+	scaleOpt       struct{ k int }
+	minIntOpt      struct{ k int }
+	maxIntOpt      struct{ k int }
+	widthOpt       struct{ k int }
+	// padOpt pads with the rune; without a FormatWidth so far it brings its
+	// own (a pad rune alone pads to the pattern's own length, 9 for
+	// #,##0.###).
+	padOpt struct {
+		pad   string
+		width int
+	}
+)
+
+func (noSeparatorOpt) String() string { return "NoSeparator" }
+func (o maxFracOpt) String() string   { return fmt.Sprintf("MaxFractionDigits(%d)", o.k) }
+func (o minFracOpt) String() string   { return fmt.Sprintf("MinFractionDigits(%d)", o.k) }
+func (o scaleOpt) String() string     { return fmt.Sprintf("Scale(%d)", o.k) }
+func (o minIntOpt) String() string    { return fmt.Sprintf("MinIntegerDigits(%d)", o.k) }
+func (o maxIntOpt) String() string    { return fmt.Sprintf("MaxIntegerDigits(%d)", o.k) }
+func (o widthOpt) String() string     { return fmt.Sprintf("FormatWidth(%d)", o.k) }
+func (o padOpt) String() string       { return fmt.Sprintf("Pad(%q)", o.pad) }
+
+func (o noSeparatorOpt) apply(m *numModel) {
+	m.add(number.NoSeparator(), o.String())
+	m.separator = false
+}
+
+func (o maxFracOpt) apply(m *numModel) {
+	m.add(number.MaxFractionDigits(o.k), o.String())
+	m.maxFrac = o.k
+	m.libMax = -1
+	if m.minFrac > o.k {
+		m.libMax = o.k
+		// (documented: the minimum wins over an earlier maximum;
+		// the model lowers the minimum instead, x-text/39 either way)
+		m.maxFrac = m.minFrac
+	}
+}
+
+func (o minFracOpt) apply(m *numModel) {
+	m.add(number.MinFractionDigits(o.k), o.String())
+	m.minFrac = o.k
+	if m.maxFrac < o.k {
+		if m.libMax < 0 {
+			// The library keeps rounding at its last maximum (x-text/39),
+			// however many minimums raise the model's afterwards.
+			m.libMax = m.maxFrac
+		}
+		m.maxFrac = o.k
+	}
+}
+
+func (o scaleOpt) apply(m *numModel) {
+	m.add(number.Scale(o.k), o.String())
+	m.minFrac, m.maxFrac, m.libMax = o.k, o.k, -1
+}
+
+func (o minIntOpt) apply(m *numModel) {
+	m.add(number.MinIntegerDigits(o.k), o.String())
+	m.minInt = o.k
+}
+
+func (o maxIntOpt) apply(m *numModel) {
+	m.add(number.MaxIntegerDigits(o.k), o.String())
+	m.maxInt = o.k
+}
+
+func (o widthOpt) apply(m *numModel) {
+	m.add(number.FormatWidth(o.k), o.String())
+	m.width = o.k
+}
+
+func (o padOpt) apply(m *numModel) {
+	m.pad = o.pad
+	m.add(number.Pad([]rune(o.pad)[0]), o.String())
+	if m.width == 0 {
+		m.width = o.width
+		m.add(number.FormatWidth(o.width), widthOpt{o.width}.String())
+	}
+}
+
+// numOpts: one option, the simplest first.
+var numOpts = hegel.OneOf(
+	hegel.Just[numOpt](noSeparatorOpt{}),
+	hegel.Map(hegel.Integers(0, 6), func(k int) numOpt { return maxFracOpt{k} }),
+	hegel.Map(hegel.Integers(0, 4), func(k int) numOpt { return minFracOpt{k} }),
+	hegel.Map(hegel.Integers(0, 5), func(k int) numOpt { return scaleOpt{k} }),
+	hegel.Map(hegel.Integers(1, 8), func(k int) numOpt { return minIntOpt{k} }),
+	hegel.Map(hegel.Integers(1, 6), func(k int) numOpt { return maxIntOpt{k} }),
+	hegel.Map(hegel.Integers(1, 20), func(k int) numOpt { return widthOpt{k} }),
+	hegel.Map(pairs(hegel.SampledFrom([]string{"*", "0", "\u00a0", "\u4e00"}), hegel.Integers(1, 20)), func(p pair[string, int]) numOpt { return padOpt{p.a, p.b} }),
+)
+
+// localeSymbols are the digits and separators of a locale, read from the
+// library once (the structure of the output is what the model checks).
+type localeSymbols struct {
+	tag       language.Tag
+	digits    [10]string
+	group     string
+	decimal   string
+	minus     string
+	secondary int
+}
+
+// numberLocales are the locales whose symbols are substituted into the
+// English structure, with their secondary grouping.
+var numberLocales = []struct {
+	tag       string
+	secondary int
+}{
+	{"de", 3}, {"de-CH", 3}, {"fr", 3}, {"es", 3}, {"ru", 3}, {"ja", 3}, {"bn", 2}, {"hi", 2},
+	{"en-IN", 2}, {"ar", 3}, {"th", 3}, {"ne", 3},
+}
+
+func readSymbols(t testing.TB, tag string, secondary int) localeSymbols {
+	ls := localeSymbols{tag: language.MustParse(tag), secondary: secondary}
+	p := message.NewPrinter(ls.tag)
+	s := p.Sprintf("%v", number.Decimal(1234567890, number.NoSeparator()))
+	rs := []rune(s)
+	if len(rs) != 10 {
+		t.Fatalf("%s: digits of 1234567890 are %+q", tag, s)
+	}
+	for i, r := range rs {
+		ls.digits[(i+1)%10] = string(r)
+	}
+	s = p.Sprintf("%v", number.Decimal(1234567))
+	i := strings.Index(s, ls.digits[4])
+	j := strings.Index(s, ls.digits[5])
+	if i < 0 || j <= i {
+		t.Fatalf("%s: 1234567 is %+q", tag, s)
+	}
+	ls.group = s[i+len(ls.digits[4]) : j]
+	s = p.Sprintf("%v", number.Decimal(1.5))
+	i = strings.Index(s, ls.digits[1])
+	j = strings.Index(s, ls.digits[5])
+	if i < 0 || j <= i {
+		t.Fatalf("%s: 1.5 is %+q", tag, s)
+	}
+	ls.decimal = s[i+len(ls.digits[1]) : j]
+	s = p.Sprintf("%v", number.Decimal(-7))
+	ls.minus = strings.TrimSuffix(s, ls.digits[7])
+	if ls.minus == s || ls.minus == "" {
+		t.Fatalf("%s: -7 is %+q", tag, s)
+	}
+	return ls
+}
+
+func (ls localeSymbols) render(en string) string {
+	var b strings.Builder
+	for _, r := range en {
+		switch {
+		case '0' <= r && r <= '9':
+			b.WriteString(ls.digits[r-'0'])
+		case r == ',':
+			b.WriteString(ls.group)
+		case r == '.':
+			b.WriteString(ls.decimal)
+		case r == '-':
+			b.WriteString(ls.minus)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// decimalCase: the sign and magnitude, the formatter (Decimal twice as
+// often), up to three options in order, the width of a %*v directive (0 for
+// none, three times in ten) and another locale (by index).
+type decimalCase struct {
+	neg      bool
+	spec     numSpec
+	kind     string
+	opts     []numOpt
+	dirWidth int
+	locale   int
+}
+
+func (c decimalCase) GoString() string {
+	var names []string
+	for _, o := range c.opts {
+		names = append(names, o.String())
+	}
+	return fmt.Sprintf("%s(%s, %s), %%*v width %d, locale %s", c.kind, c.spec.value(c.neg).desc, strings.Join(names, ", "), c.dirWidth, numberLocales[c.locale].tag)
+}
+
+var decimalCases = hegel.Composite(func(tc hegel.TestCase) decimalCase {
+	return decimalCase{
+		neg:      hegel.Draw(tc, chance(30)),
+		spec:     hegel.Draw(tc, numSpecs),
+		kind:     hegel.Draw(tc, hegel.SampledFrom([]string{"Decimal", "Decimal", "Percent", "PerMille"})),
+		opts:     hegel.Draw(tc, many(numOpts, 0, 3)),
+		dirWidth: hegel.Draw(tc, maybe(30, hegel.Integers(1, 20))),
+		locale:   hegel.Draw(tc, hegel.Integers(0, len(numberLocales)-1)),
+	}
+})
+
+// number.Decimal/Percent/PerMille follow the CLDR patterns written out:
+// half-even rounding of the exact value, the fraction and integer digit
+// options, grouping, width and padding, in English; and the same digits and
+// separators substituted in other locales.
+func TestHegelDecimalFormattingFollowsThePatterns(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	var locales []localeSymbols
+	for _, l := range numberLocales {
+		locales = append(locales, readSymbols(t, l.tag, l.secondary))
+	}
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, decimalCases)
+		d := c.spec.value(c.neg)
+		kind := c.kind
+		m := newNumModel(3)
+		suffix := ""
+		switch kind {
+		case "Percent":
+			d = d.shift(2)
+			m.maxFrac = 0
+			suffix = "%"
+		case "PerMille":
+			d = d.shift(3)
+			m.maxFrac = 0
+			suffix = "\u2030"
+		}
+		for _, o := range c.opts {
+			o.apply(&m)
+		}
+		desc := fmt.Sprintf("%s(%s, %s)", kind, d.desc, strings.Join(m.names, ", "))
+		var f number.Formatter
+		switch kind {
+		case "Percent":
+			f = number.Percent(d.v, m.opts...)
+		case "PerMille":
+			f = number.PerMille(d.v, m.opts...)
+		default:
+			f = number.Decimal(d.v, m.opts...)
+		}
+		// The model.
+		model := func(maxFrac int) (string, string) {
+			r := d.roundHalfEven(maxFrac)
+			fp := r.fp
+			for len(fp) < m.minFrac {
+				fp += "0"
+			}
+			ip := intDigits(r.ip, m.minInt, m.maxInt)
+			if m.separator {
+				ip = group(ip, 3, 3)
+			}
+			body := ip
+			if fp != "" {
+				body += "." + fp
+			}
+			want := body + suffix
+			if d.neg {
+				want = "-" + want
+			}
+			if utf8.RuneCountInString(want) < m.width {
+				want = strings.Repeat(m.pad, m.width-utf8.RuneCountInString(want)) + want
+			}
+			return want, body
+		}
+		want, body := model(m.maxFrac)
+		got := en.Sprintf("%v", f)
+		if got != want && m.libMax >= 0 && Known.MinFractionAboveMax {
+			if alt, _ := model(m.libMax); alt == got {
+				count(ht, "known x-text/39")
+				return
+			}
+		}
+		if got != want {
+			if d.neg && strings.Trim(body, "0.,") == suffix {
+				count(ht, "negative-zero")
+				note(ht, "%s = %s (model %s)", desc, show(got), show(want))
+				return
+			}
+			fail(ht, "%s = %s, model %s", desc, show(got), show(want))
+			return
+		}
+		// A width in the directive is documented to override the option.
+		if w := c.dirWidth; w > 0 {
+			g := en.Sprintf("%*v", w, f)
+			if utf8.RuneCountInString(g) < w {
+				if Known.FormatterIgnoresWidth && m.pad == " " && m.width == 0 {
+					count(ht, "known x-text/36")
+				} else {
+					fail(ht, "%%%dv of %s = %s, %d runes", w, desc, show(g), utf8.RuneCountInString(g))
+				}
+			}
+		}
+		// Other locales: the English structure with their symbols.
+		if kind == "Decimal" && m.width == 0 {
+			ls := locales[c.locale]
+			p := message.NewPrinter(ls.tag)
+			w := ls.render(want)
+			r := d.roundHalfEven(m.maxFrac)
+			fp := r.fp
+			for len(fp) < m.minFrac {
+				fp += "0"
+			}
+			if m.separator && ls.secondary != 3 {
+				b := group(intDigits(r.ip, m.minInt, m.maxInt), 3, ls.secondary)
+				if fp != "" {
+					b += "." + fp
+				}
+				if d.neg {
+					b = "-" + b
+				}
+				w = ls.render(b)
+			}
+			if g := p.Sprintf("%v", f); g != w {
+				fail(ht, "%v: %s = %s, model %s", ls.tag, desc, show(g), show(w))
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// message
+
+var superscripts = map[rune]byte{
+	'\u2070': '0', '\u00b9': '1', '\u00b2': '2', '\u00b3': '3', '\u2074': '4',
+	'\u2075': '5', '\u2076': '6', '\u2077': '7', '\u2078': '8', '\u2079': '9',
+}
+
+// unlocalize turns the English Printer's rendering into fmt's: grouping
+// commas (between a digit and three digits; the arguments' strings have no
+// commas or digits, and the digits of the next directive may follow
+// without a separator) removed, "x10^exp" exponents into e+exp (E+exp when
+// upper is set).
+func unlocalize(s string, upper bool) string {
+	for {
+		i := strings.Index(s, ",")
+		found := false
+		for i >= 0 {
+			if i > 0 && isDigit(s[i-1]) && i+3 < len(s) && isDigit(s[i+1]) && isDigit(s[i+2]) && isDigit(s[i+3]) {
+				s = s[:i] + s[i+1:]
+				found = true
+				break
+			}
+			j := strings.Index(s[i+1:], ",")
+			if j < 0 {
+				break
+			}
+			i += 1 + j
+		}
+		if !found {
+			break
+		}
+	}
+	e := byte('e')
+	if upper {
+		e = 'E'
+	}
+	var b strings.Builder
+	rs := []rune(s)
+	for i := 0; i < len(rs); i++ {
+		if rs[i] == '\u00d7' && i+2 < len(rs) && rs[i+1] == '1' && rs[i+2] == '0' {
+			i += 3
+			b.WriteByte(e)
+			if i < len(rs) && rs[i] == '\u207b' {
+				b.WriteByte('-')
+				i++
+			} else {
+				b.WriteByte('+')
+			}
+			for ; i < len(rs); i++ {
+				if d, ok := superscripts[rs[i]]; ok {
+					b.WriteByte(d)
+				} else {
+					break
+				}
+			}
+			i--
+			continue
+		}
+		b.WriteRune(rs[i])
+	}
+	return b.String()
+}
+
+func isDigit(c byte) bool { return '0' <= c && c <= '9' }
+
+type fmtArg struct {
+	v       interface{}
+	numeric bool
+	float   bool
+	small   bool // no grouping in any rendering
+}
+
+// fmtArgs: a string, a bool, a rune, an int, an int64, a uint32, a float of
+// a few decimals, a float of note, or a slice whose int element is formatted
+// like a number (grouped padding).
+var fmtArgs = hegel.OneOf(
+	hegel.Map(alphabet([]rune{'a', 'b', 'c', 'X', 'Y', 'Z', ' ', 0x00E9, 0x4E00}, 0, 6), func(s string) fmtArg { return fmtArg{v: s} }),
+	hegel.Map(hegel.Booleans(), func(b bool) fmtArg { return fmtArg{v: b} }),
+	hegel.Map(hegel.SampledFrom([]rune{'a', 0x00E9, 0x4E00, 0x1F600}), func(r rune) fmtArg { return fmtArg{v: r, numeric: true, small: r < 1000} }),
+	hegel.Map(hegel.Integers(-999, 999), func(k int) fmtArg { return fmtArg{v: k, numeric: true, small: true} }),
+	hegel.Map(hegel.Integers(-2000000000, 2000000000), func(k int) fmtArg { return fmtArg{v: int64(k), numeric: true, small: -1000 < k && k < 1000} }),
+	hegel.Map(hegel.Integers(0, 70000), func(k int) fmtArg { return fmtArg{v: uint32(k), numeric: true, small: k < 1000} }),
+	hegel.Map(pairs(hegel.Integers(-99999, 99999), hegel.SampledFrom([]int{1, 10, 100, 1000})), func(p pair[int, int]) fmtArg {
+		f := float64(p.a) / float64(p.b)
+		return fmtArg{v: f, numeric: true, float: true, small: -1000 < f && f < 1000}
+	}),
+	hegel.Map(hegel.SampledFrom([]float64{0.5, 1e6, 1e21, 123456.7, 1e-5, 1e-7, 1.5e300, 0.1, 2.5, 1234.5678}), func(f float64) fmtArg {
+		return fmtArg{v: f, numeric: true, float: true, small: f < 1000}
+	}),
+	hegel.Map(pairs(hegel.Integers(0, 5), alphabet([]rune{'a', 'b'}, 0, 3)), func(p pair[int, string]) fmtArg {
+		return fmtArg{v: []interface{}{p.a, p.b}, numeric: true, small: true}
+	}),
+)
+
+const flagChars = "-+ #0"
+
+// verbsFor are the verbs tried on an argument of the kind: the usual ones
+// mostly, the odd ones (a float as an integer or a string, an integer as a
+// rune, a quoted rune or a code point) one time in ten.
+func verbsFor(a fmtArg) hegel.Generator[string] {
+	switch {
+	case a.float:
+		return weighted(
+			choice[string]{9, hegel.SampledFrom([]string{"v", "f", "e", "g", "E", "G"})},
+			choice[string]{1, hegel.SampledFrom([]string{"d", "x", "s"})},
+		)
+	case a.numeric:
+		return weighted(
+			choice[string]{9, hegel.SampledFrom([]string{"v", "d", "x", "X", "f", "s"})},
+			choice[string]{1, hegel.SampledFrom([]string{"o", "O", "b", "c", "q", "U"})},
+		)
+	}
+	return hegel.SampledFrom([]string{"v", "s", "q", "x", "X", "d", "t", "c", "T"})
+}
+
+// precisionPct is how often a directive has a precision: three times in ten
+// on a float, one time in ten otherwise (on an integer it is a minimum
+// number of digits, which the Printer groups).
+func precisionPct(a fmtArg) int {
+	if a.float {
+		return 30
+	}
+	return 10
+}
+
+// directive is one %-directive of a format with its argument: the text
+// before it, a coin per flag (heads 12 times in a hundred), a width (three
+// times in ten), a precision (see precisionPct) and a verb for the
+// argument's kind.
+type directive struct {
+	arg   fmtArg
+	sep   string
+	flags []bool
+	width int
+	prec  *int
+	verb  string
+}
+
+func (d directive) flagString() string {
+	var b strings.Builder
+	for i, on := range d.flags {
+		if on {
+			b.WriteByte(flagChars[i])
+		}
+	}
+	return b.String()
+}
+
+// text is the directive as it appears in the format.
+func (d directive) text() string {
+	var b strings.Builder
+	b.WriteString(d.sep)
+	b.WriteByte('%')
+	b.WriteString(d.flagString())
+	if d.width > 0 {
+		fmt.Fprint(&b, d.width)
+	}
+	if d.prec != nil {
+		fmt.Fprintf(&b, ".%d", *d.prec)
+	}
+	b.WriteString(d.verb)
+	return b.String()
+}
+
+func (d directive) GoString() string { return fmt.Sprintf("%q of %#v", d.text(), d.arg.v) }
+
+var directives = hegel.FlatMap(fmtArgs, func(a fmtArg) hegel.Generator[directive] {
+	return hegel.Composite(func(tc hegel.TestCase) directive {
+		return directive{
+			arg:   a,
+			sep:   hegel.Draw(tc, hegel.SampledFrom([]string{"", " ", "x=", "|"})),
+			flags: hegel.Draw(tc, fixed(chance(12), len(flagChars))),
+			width: hegel.Draw(tc, maybe(30, hegel.Integers(1, 12))),
+			prec:  hegel.Draw(tc, optional(precisionPct(a), hegel.Integers(0, 6))),
+			verb:  hegel.Draw(tc, verbsFor(a)),
+		}
+	})
+})
+
+// printerCases: one to three directives.
+var printerCases = many(directives, 1, 3)
+
+// The English Printer is fmt with grouping and the x10 exponent notation:
+// Sprintf agrees with fmt.Sprintf on every verb, flag, width and precision
+// once those are undone, and exactly with the # flag; Sprint and Sprintln
+// agree likewise.
+func TestHegelPrinterAgreesWithFmt(t *testing.T) {
+	en := message.NewPrinter(language.English)
+	property(t, func(ht *hegel.T) {
+		dirs := hegel.Draw(ht, printerCases)
+		var format strings.Builder
+		var args []interface{}
+		compare := true // exact comparison after unlocalize
+		upper, lower, prevWidth := false, false, false
+		for _, d := range dirs {
+			a := d.arg
+			args = append(args, a.v)
+			format.WriteString(d.text())
+			flags, verb, width := d.flagString(), d.verb, d.width
+			prec := -1
+			if d.prec != nil {
+				prec = *d.prec
+			}
+			// Where the Printer is documented or known to differ. A bad verb
+			// on a number renders it as %v, so it is localized too.
+			localized := a.numeric && !strings.Contains("xXobcqUO", verb) && !strings.Contains(flags, "#")
+			if localized && a.float && width > 0 && !strings.Contains("fF", verb) {
+				// The x10 notation is longer than e+NN, so the padding differs.
+				count(ht, "width-with-exponent")
+				compare = false
+			}
+			if localized && strings.Contains(flags, "0") && width > 0 {
+				// The 0 flag becomes a minimum number of integer digits (grouped),
+				// so the output can exceed the width; asserted by upstream's tests.
+				count(ht, "zero-flag-width")
+				compare = false
+			}
+			if localized && width > 0 && !a.small {
+				count(ht, "width-with-grouping")
+				compare = false
+			}
+			if localized && a.float && prec >= 0 && strings.Contains("vgG", verb) {
+				if Known.PrecisionGOneTooMany {
+					count(ht, "known x-text/37")
+					compare = false
+				}
+			}
+			if a.float && strings.Contains("xX", verb) {
+				if Known.FloatHexVerb {
+					count(ht, "known x-text/38")
+					compare = false
+				}
+			}
+			if a.float && !strings.Contains(flags, "#") {
+				// A bad verb on a float renders the value as %v, so the
+				// exponent notation (and x-text/37 with a precision) show there too.
+				if strings.Contains("EG", verb) {
+					upper = true
+				} else {
+					lower = true
+				}
+				count(ht, "exponent-notation")
+				if prec >= 0 && !strings.Contains("feE", verb) && Known.PrecisionGOneTooMany {
+					count(ht, "known x-text/37")
+					compare = false
+				}
+			}
+			if a.numeric && !a.float && verb == "q" && Known.QuoteNegativeInt {
+				var x int64
+				switch v := a.v.(type) {
+				case int:
+					x = int64(v)
+				case int64:
+					x = v
+				case uint32:
+					x = int64(v)
+				}
+				if x < 0 || x > utf8.MaxRune {
+					count(ht, "known x-text/40")
+					compare = false
+				}
+			}
+			if a.numeric && !a.float && Known.Go113IntVerbs && (verb == "O" || (verb == "b" && strings.Contains(flags, "#"))) {
+				count(ht, "known x-text/41")
+				compare = false
+			}
+			if a.float && Known.Go113IntVerbs && strings.Contains(flags, "#") && !strings.Contains("feE", verb) {
+				// %#g pads one digit too few below 1.
+				count(ht, "known x-text/41")
+				compare = false
+			}
+			if prevWidth && width == 0 && prec >= 0 && Known.WidthLeaks {
+				count(ht, "known x-text/43")
+				compare = false
+			}
+			if width > 0 {
+				prevWidth = true
+			}
+			if localized && !a.float && prec >= 0 {
+				// The precision of an integer is a minimum number of digits,
+				// and the padding zeros are grouped (asserted by upstream's tests).
+				count(ht, "int-precision-grouping")
+				compare = false
+			}
+		}
+		got := en.Sprintf(format.String(), args...)
+		want := fmt.Sprintf(format.String(), args...)
+		if upper && lower {
+			count(ht, "mixed-exponent-case")
+			compare = false
+		}
+		// Fprintf writes what Sprintf returns, whatever the directives.
+		var buf bytes.Buffer
+		nn, err := en.Fprintf(&buf, format.String(), args...)
+		if err != nil || nn != buf.Len() || buf.String() != got {
+			fail(ht, "Fprintf(%q, %v) = %d, %v, wrote %s; Sprintf %s", format.String(), args, nn, err, show(buf.String()), show(got))
+		}
+		if !compare {
+			count(ht, "not-compared")
+			return
+		}
+		if unlocalize(got, upper) != want {
+			fail(ht, "Sprintf(%q, %v) = %s, fmt %s", format.String(), args, show(got), show(want))
+		}
+		if unlocalize(en.Sprint(args...), false) != fmt.Sprint(args...) {
+			fail(ht, "Sprint(%v) = %s, fmt %s", args, show(en.Sprint(args...)), show(fmt.Sprint(args...)))
+		}
+		if unlocalize(en.Sprintln(args...), false) != fmt.Sprintln(args...) {
+			fail(ht, "Sprintln(%v) = %s, fmt %s", args, show(en.Sprintln(args...)), show(fmt.Sprintln(args...)))
+		}
+	})
+}
+
+// catalogTags are the tags a catalog is built for: a tree under und.
+var catalogTags = []string{"und", "en", "en-US", "en-GB", "de", "de-AT", "de-CH", "fr", "pt", "pt-BR", "zh-Hant", "zh-Hant-TW"}
+
+var (
+	messageKeys = []string{"hello %s", "%d files", "plain", "%s and %d"}
+	messageMsgs = []string{"Hallo %s", "%d Dateien", "Bonjour", "%s et %d", "%[2]d before %[1]s", "%s%s"}
+)
+
+// catalogEntry is one message set on the builder.
+type catalogEntry struct{ tag, key, msg string }
+
+// catalogCase: up to eight entries, the tag and key looked up, the string
+// and number arguments, and the id and fallback of a Key lookup.
+type catalogCase struct {
+	entries  []catalogEntry
+	tag, key string
+	s        string
+	d        int
+	id, fb   string
+}
+
+func (c catalogCase) GoString() string {
+	return fmt.Sprintf("%v; %s: %q with (%q, %d), Key(%q, %q)", c.entries, c.tag, c.key, c.s, c.d, c.id, c.fb)
+}
+
+var catalogEntries = hegel.Composite(func(tc hegel.TestCase) catalogEntry {
+	return catalogEntry{
+		tag: hegel.Draw(tc, hegel.SampledFrom(catalogTags)),
+		key: hegel.Draw(tc, hegel.SampledFrom(messageKeys)),
+		msg: hegel.Draw(tc, hegel.SampledFrom(messageMsgs)),
+	}
+})
+
+var catalogCases = hegel.Composite(func(tc hegel.TestCase) catalogCase {
+	return catalogCase{
+		entries: hegel.Draw(tc, many(catalogEntries, 0, 8)),
+		tag:     hegel.Draw(tc, hegel.SampledFrom(catalogTags)),
+		key:     hegel.Draw(tc, hegel.SampledFrom(messageKeys)),
+		s:       hegel.Draw(tc, alphabet([]rune{'a', 'b', 'c'}, 0, 4)),
+		d:       hegel.Draw(tc, hegel.Integers(0, 999)),
+		id:      hegel.Draw(tc, hegel.SampledFrom(messageKeys)),
+		fb:      hegel.Draw(tc, hegel.SampledFrom(messageKeys)),
+	}
+})
+
+// Messages set on a catalog.Builder are found for the tag they were set on
+// and its descendants (the parent chain), the nearest wins, a key with no
+// message renders itself, Key falls back as documented, and the arguments
+// are substituted as by Sprintf; Languages lists the tags set.
+func TestHegelCatalogMessagesResolveThroughParents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, catalogCases)
+		b := catalog.NewBuilder()
+		set := map[string]map[string]string{} // tag -> key -> msg
+		langs := map[string]bool{}
+		for _, e := range c.entries {
+			tag := language.MustParse(e.tag)
+			if err := b.SetString(tag, e.key, e.msg); err != nil {
+				fail(ht, "SetString(%v, %q, %q): %v", tag, e.key, e.msg, err)
+				return
+			}
+			if set[tag.String()] == nil {
+				set[tag.String()] = map[string]string{}
+			}
+			set[tag.String()][e.key] = e.msg
+			langs[tag.String()] = true
+		}
+		got := map[string]bool{}
+		for _, l := range b.Languages() {
+			got[l.String()] = true
+		}
+		if fmt.Sprint(got) != fmt.Sprint(langs) {
+			fail(ht, "Languages() = %v, set %v", got, langs)
+		}
+		lookup := func(tag language.Tag, key string) (string, bool) {
+			for t := tag; ; t = t.Parent() {
+				if m, ok := set[t.String()][key]; ok {
+					return m, true
+				}
+				if t == language.Und {
+					return "", false
+				}
+			}
+		}
+		tag := language.MustParse(c.tag)
+		p := message.NewPrinter(tag, message.Catalog(b))
+		key, s, d := c.key, c.s, c.d
+		// A message without verbs ignores its arguments silently (fmt would
+		// append an EXTRA marker): translations need not use every argument.
+		render := func(format string) string {
+			if !strings.Contains(format, "%") {
+				return format
+			}
+			return fmt.Sprintf(format, s, d)
+		}
+		want := key
+		if m, ok := lookup(tag, key); ok {
+			want = m
+		}
+		if g := p.Sprintf(key, s, d); g != render(want) {
+			fail(ht, "%v: Sprintf(%q, %q, %d) = %s, want %s from %s", tag, key, s, d, show(g), show(render(want)), show(want))
+		}
+		// Key(id, fallback): the id's message, else the fallback's, else the
+		// fallback text itself.
+		id, fb := c.id, c.fb
+		want = fb
+		if m, ok := lookup(tag, id); ok {
+			want = m
+		} else if m, ok := lookup(tag, fb); ok {
+			want = m
+		}
+		if g := p.Sprintf(message.Key(id, fb), s, d); g != render(want) {
+			fail(ht, "%v: Sprintf(Key(%q, %q), %q, %d) = %s, want %s", tag, id, fb, s, d, show(g), show(render(want)))
+		}
+		// The matcher matches a catalog language exactly.
+		if langs[tag.String()] {
+			if _, _, conf := b.Matcher().Match(tag); conf != language.Exact {
+				fail(ht, "%v is a catalog language but Matcher().Match gives %v", tag, conf)
+			}
+		}
+	})
+}
+
+// pluralLangs are languages with different cardinal rules.
+var pluralLangs = []string{"en", "fr", "de", "ru", "pl", "ar", "ja", "cy", "he", "cs", "lt", "lv", "ga", "sl", "mt"}
+
+var (
+	pluralForms = []plural.Form{plural.Zero, plural.One, plural.Two, plural.Few, plural.Many}
+	formNames15 = map[plural.Form]string{plural.Zero: "zero", plural.One: "one", plural.Two: "two", plural.Few: "few", plural.Many: "many"}
+)
+
+// supportedForms are, per language, the forms its cardinal rules produce:
+// the builder rejects a selector on any other form, so a case naming one
+// has nothing left to check. Read from the library once.
+var supportedForms = func() map[string][]plural.Form {
+	m := map[string][]plural.Form{}
+	for _, lang := range pluralLangs {
+		tag := language.MustParse(lang)
+		for _, f := range pluralForms {
+			if catalog.NewBuilder().Set(tag, "probe", plural.Selectf(1, "%d", f, "a", plural.Other, "b")) == nil {
+				m[lang] = append(m[lang], f)
+			}
+		}
+	}
+	return m
+}()
+
+// selector is one case of a Selectf: its selector value and whether it
+// matches the argument.
+type selector interface {
+	sel() interface{}
+	matches(v int, form plural.Form) bool
+}
+
+type (
+	eqSel   struct{ x int }         // "=x"
+	eqVSel  struct{}                // "=v", the argument itself
+	ltSel   struct{ x int }         // "<x"
+	formSel struct{ f plural.Form } // a Form
+	nameSel struct{ f plural.Form } // the Form's name
+)
+
+func (s eqSel) sel() interface{}   { return fmt.Sprintf("=%d", s.x) }
+func (eqVSel) sel() interface{}    { return nil } // rendered with the argument
+func (s ltSel) sel() interface{}   { return fmt.Sprintf("<%d", s.x) }
+func (s formSel) sel() interface{} { return s.f }
+func (s nameSel) sel() interface{} { return formNames15[s.f] }
+
+func (s eqSel) matches(v int, _ plural.Form) bool      { return s.x == v }
+func (eqVSel) matches(int, plural.Form) bool           { return true }
+func (s ltSel) matches(v int, _ plural.Form) bool      { return v < s.x }
+func (s formSel) matches(_ int, form plural.Form) bool { return s.f == form }
+func (s nameSel) matches(_ int, form plural.Form) bool { return s.f == form }
+
+// selectorsFor: "=x" or "=v" (a coin), "<x", a Form or a Form's name; the
+// form is one the language supports 49 times in 50 (a case with several
+// selectors names an unsupported one, and is rejected whole, a few times
+// in a hundred).
+func selectorsFor(lang string) hegel.Generator[selector] {
+	forms := hegel.SampledFrom(pluralForms)
+	if sup := supportedForms[lang]; len(sup) > 0 {
+		forms = weighted(choice[plural.Form]{49, hegel.SampledFrom(sup)}, choice[plural.Form]{1, hegel.SampledFrom(pluralForms)})
+	}
+	return hegel.OneOf(
+		hegel.Map(pairs(chance(50), hegel.Integers(0, 30)), func(p pair[bool, int]) selector {
+			if p.a {
+				return eqVSel{}
+			}
+			return eqSel{p.b}
+		}),
+		hegel.Map(hegel.Integers(0, 30), func(x int) selector { return ltSel{x} }),
+		hegel.Map(forms, func(f plural.Form) selector { return formSel{f} }),
+		hegel.Map(forms, func(f plural.Form) selector { return nameSel{f} }),
+	)
+}
+
+// selectfCase: the language (by index), the argument (a small number, or
+// one of note one time in four), up to five selectors and whether the
+// catch-all is spelled "other" rather than plural.Other.
+type selectfCase struct {
+	lang      int
+	v         int
+	sels      []selector
+	otherName bool
+}
+
+func (c selectfCase) GoString() string {
+	var ss []string
+	for _, s := range c.sels {
+		if _, ok := s.(eqVSel); ok {
+			ss = append(ss, fmt.Sprintf("=%d (the argument)", c.v))
+		} else {
+			ss = append(ss, fmt.Sprint(s.sel()))
+		}
+	}
+	return fmt.Sprintf("%s: %d against %v, other spelled by name: %v", pluralLangs[c.lang], c.v, ss, c.otherName)
+}
+
+var selectfCases = hegel.FlatMap(hegel.Integers(0, len(pluralLangs)-1), func(lang int) hegel.Generator[selectfCase] {
+	sels := selectorsFor(pluralLangs[lang])
+	return hegel.Composite(func(tc hegel.TestCase) selectfCase {
+		return selectfCase{
+			lang:      lang,
+			v:         hegel.Draw(tc, weighted(choice[int]{75, hegel.Integers(0, 25)}, choice[int]{25, hegel.SampledFrom([]int{100, 101, 102, 111, 1000, 1000000, 70000, 21, 22, 5, 11})})),
+			sels:      hegel.Draw(tc, many(sels, 0, 5)),
+			otherName: hegel.Draw(tc, chance(50)),
+		}
+	})
+})
+
+// plural.Selectf picks the first case whose selector matches the argument
+// as documented: "=x" by value, "<x" by bound, a Form by
+// Cardinal.MatchPlural, Other always; and MatchPlural follows the CLDR rule
+// for English and Japanese.
+func TestHegelSelectfPicksTheFirstMatchingCase(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, selectfCases)
+		tag := language.MustParse(pluralLangs[c.lang])
+		v := c.v
+		form := plural.Cardinal.MatchPlural(tag, v, 0, 0, 0, 0)
+		if tag == language.English && (form == plural.One) != (v == 1) {
+			fail(ht, "en: MatchPlural(%d) = %v", v, form)
+		}
+		if tag == language.Japanese && form != plural.Other {
+			fail(ht, "ja: MatchPlural(%d) = %v", v, form)
+		}
+		k := len(c.sels)
+		var cases []interface{}
+		wantIdx := -1
+		for i, s := range c.sels {
+			sel := s.sel()
+			if _, ok := s.(eqVSel); ok {
+				sel = fmt.Sprintf("=%d", v)
+			}
+			cases = append(cases, sel, fmt.Sprintf("case%d", i))
+			if s.matches(v, form) && wantIdx < 0 {
+				wantIdx = i
+			}
+		}
+		var other interface{} = plural.Other
+		if c.otherName {
+			other = "other"
+		}
+		cases = append(cases, other, fmt.Sprintf("case%d", k))
+		if wantIdx < 0 {
+			wantIdx = k
+		}
+		b := catalog.NewBuilder()
+		if err := b.Set(tag, "%d things", plural.Selectf(1, "%d", cases...)); err != nil {
+			msg := err.Error()
+			switch {
+			case strings.Contains(msg, "not supported for language"):
+				// A form the language's rules never produce is rejected.
+				count(ht, "unsupported-form")
+			case Known.SelectorUint16 && strings.Contains(msg, "value out of range"):
+				count(ht, "known x-text/42")
+			default:
+				fail(ht, "%v: Set(Selectf(%v)): %v", tag, cases, err)
+			}
+			return
+		}
+		p := message.NewPrinter(tag, message.Catalog(b))
+		got := p.Sprintf("%d things", v)
+		if got != fmt.Sprintf("case%d", wantIdx) {
+			fail(ht, "%v: Selectf(%v) for %d (form %v) = %s, want case%d", tag, cases, v, form, show(got), wantIdx)
+		}
+	})
+}
diff --git a/hegel/hegel_norm_test.go b/hegel/hegel_norm_test.go
