+// bidirule.Valid/ValidString agree with RFC 5893's rule written out on the
+// classes, Direction reports RTL labels, and the Transformer passes valid
+// labels through unchanged and rejects the others.
+func TestHegelBidiRuleAgreesWithRFC5893(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bidiRuleCases)
+		src := c.src
+		want := rfc5893(src)
+		got := bidirule.Valid(src)
+		if gotS := bidirule.ValidString(string(src)); gotS != got {
+			fail(ht, "Valid(%s) = %v but ValidString = %v", show(string(src)), got, gotS)
+		}
+		if got != want {
+			if got && !utf8.Valid(src) && Known.BidiLookupLenient {
+				// Surrogates and code points past U+10FFFF decode as characters.
+				count(ht, "known x-text/35")
+				return
+			}
+			fail(ht, "Valid(%s) = %v, RFC 5893 says %v", show(string(src)), got, want)
+		}
+		if want {
+			count(ht, "valid")
+		}
+		if utf8.Valid(src) {
+			wantDir := bidi.LeftToRight
+			if hasRTL(string(src)) {
+				wantDir = bidi.RightToLeft
+			}
+			if got := bidirule.Direction(src); got != wantDir {
+				fail(ht, "Direction(%s) = %v, want %v", show(string(src)), got, wantDir)
+			}
+			if got := bidirule.DirectionString(string(src)); got != wantDir {
+				fail(ht, "DirectionString(%s) = %v, want %v", show(string(src)), got, wantDir)
+			}
+		} else if bidirule.Direction(src) != bidirule.DirectionString(string(src)) {
+			fail(ht, "Direction and DirectionString disagree on %s", show(string(src)))
+		}
+		tr := bidirule.New()
+		out, err := drive(tr, src, c.chunk, c.dst)
+		if want {
+			if err != nil || !bytes.Equal(out, src) {
+				if err == bidirule.ErrInvalid && Known.BidiRuleSpanNotFinal {
+					count(ht, "known x-text/34")
+				} else {
+					fail(ht, "Transformer on the valid label %s: %s, %v", show(string(src)), show(string(out)), err)
+				}
+			}
+		} else if err != bidirule.ErrInvalid {
+			fail(ht, "Transformer on the invalid label %s: %s, %v", show(string(src)), show(string(out)), err)
+		}
+		tr.Reset()
+		sp, err := tr.Span(src, true)
+		if want && (sp != len(src) || err != nil) {
+			fail(ht, "Span(%s) = %d, %v on a valid label", show(string(src)), sp, err)
+		}
+		if !want && err != bidirule.ErrInvalid {
+			fail(ht, "Span(%s) = %d, %v on an invalid label", show(string(src)), sp, err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// secure/precis
+
+// contextual reports whether r has a contextual rule in RFC 5892 appendix A
+// (CONTEXTJ and CONTEXTO); the profiles' Allowed sets exclude them although
+// the enforcement accepts them in context.
+func contextual(r rune) bool {
+	switch r {
+	case 0x200C, 0x200D, 0x00B7, 0x0375, 0x05F3, 0x05F4, 0x30FB:
+		return true
+	}
+	return (0x0660 <= r && r <= 0x0669) || (0x06F0 <= r && r <= 0x06F9)
+}
+
+func hasContextual(s string) bool {
+	for _, r := range s {
+		if contextual(r) {
+			return true
+		}
+	}
+	return false
+}
+
+func mapSpaces(s string) string {
+	return strings.Map(func(r rune) rune {
+		if unicode.Is(unicode.Zs, r) {
+			return ' '
+		}
+		return r
+	}, s)
+}
+
+var lowerNoSigma = cases.Lower(language.Und, cases.HandleFinalSigma(false))
+
+// precisModel is a profile with its rules of RFC 8265/8266 written out: the
+// mapping steps (applied `repeat` times), whether the Bidi Rule applies (to
+// strings with RTL characters), and that the result must not be empty.
+type precisModel struct {
+	name          string
+	p             *precis.Profile
+	mapping       func(string) string
+	bidiRule      bool
+	disallowEmpty bool
+	repeat        int
+	ignoreCase    bool
+}
+
+// mapped is the mapping applied its `repeat` times.
+func (m precisModel) mapped(s string) string {
+	for i := 0; i < m.repeat; i++ {
+		s = m.mapping(s)
+	}
+	return s
+}
+
+var precisModels = []precisModel{
+	{"UsernameCaseMapped", precis.UsernameCaseMapped, func(s string) string {
+		return norm.NFC.String(lowerNoSigma.String(width.Fold.String(s)))
+	}, true, true, 1, false},
+	{"UsernameCasePreserved", precis.UsernameCasePreserved, func(s string) string {
+		return norm.NFC.String(width.Fold.String(s))
+	}, true, true, 1, false},
+	{"OpaqueString", precis.OpaqueString, func(s string) string {
+		return norm.NFC.String(mapSpaces(s))
+	}, false, true, 1, false},
+	{"Nickname", precis.Nickname, func(s string) string {
+		fields := strings.FieldsFunc(s, func(r rune) bool { return unicode.Is(unicode.Zs, r) })
+		return norm.NFKC.String(strings.Join(fields, " "))
+	}, false, true, 4, true},
+}
+
+// otherString is the second string Compare is asked about: the string
+// itself, the string with some of its runes simply case-folded (a coin per
+// rune, recycled), or another case text.
+type otherString interface{ of(s string) string }
+
+type (
+	sameString   struct{}
+	foldedString struct{ coins []bool }
+	otherText    struct{ text string }
+)
+
+func (sameString) of(s string) string { return s }
+func (f foldedString) of(s string) string {
+	i := 0
+	return strings.Map(func(r rune) rune {
+		flip := f.coins[i%len(f.coins)]
+		i++
+		if flip {
+			return unicode.SimpleFold(r)
+		}
+		return r
+	}, s)
+}
+func (o otherText) of(string) string { return o.text }
+
+var otherStrings = hegel.OneOf(
+	hegel.Just[otherString](sameString{}),
+	hegel.Map(many(hegel.Booleans(), 1, 8), func(cs []bool) otherString { return foldedString{cs} }),
+	hegel.Map(caseTexts, func(t string) otherString { return otherText{t} }),
+)
+
+// without is pool less the runes f holds of.
+func without(pool []rune, f func(rune) bool) []rune {
+	var out []rune
+	for _, r := range pool {
+		if !f(r) {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+// precisAnyRunes is anyRunes with the contextual runes taken out of the
+// pool of interesting runes (the assigned pools keep their dozen, which the
+// filter below catches).
+var precisAnyRunes = weighted(
+	choice[rune]{5, hegel.SampledFrom(without(interestingRunes, contextual))},
+	choice[rune]{1, hegel.Integers[rune]('a', 'e')},
+	choice[rune]{4, assignedRunes},
+)
+
+// precisTexts: a case text 63% of the time; a bidi text 27%; one of a few
+// edge strings (empty, spaces, ignorable characters, a digit, a hyphen, a
+// lone mark) 10%. The case and bidi pools are without their contextual
+// runes.
+var precisTexts = weighted(
+	choice[string]{63, runeStrings(weighted(choice[rune]{60, hegel.SampledFrom(without(caseRunes, contextual))}, choice[rune]{40, precisAnyRunes}), 0, 10)},
+	choice[string]{27, runeStrings(weighted(choice[rune]{60, hegel.SampledFrom(without(bidiRunes, contextual))}, choice[rune]{40, precisAnyRunes}), 0, 8)},
+	choice[string]{10, hegel.SampledFrom([]string{"", " ", "\u00a0", "\u00ad", "\u200b", "1", "-", "\u0301"})},
+)
+
+// precisCase: the profile (by index), the string, and the other string of
+// Compare. Strings with CONTEXTJ/CONTEXTO runes (before or after the
+// profile's mapping) are excluded: Allowed() excludes them while the
+// enforcement accepts them in context. The pools are without them, so the
+// filter fires on well under one text in a hundred (measured).
+type precisCase struct {
+	profile int
+	s       string
+	other   otherString
+}
+
+func (c precisCase) GoString() string {
+	return fmt.Sprintf("%s: %s, Compare with %s", precisModels[c.profile].name, show(c.s), show(c.other.of(c.s)))
+}
+
+var precisCases = hegel.FlatMap(hegel.Integers(0, len(precisModels)-1), func(i int) hegel.Generator[precisCase] {
+	m := precisModels[i]
+	texts := hegel.Filter(precisTexts, func(s string) bool { return !hasContextual(s) && !hasContextual(m.mapped(s)) })
+	return hegel.Composite(func(tc hegel.TestCase) precisCase {
+		return precisCase{profile: i, s: hegel.Draw(tc, texts), other: hegel.Draw(tc, otherStrings)}
+	})
+})
+
+// The PRECIS profiles enforce the rules of RFC 8265 and RFC 8266: the
+// mapping steps in order, the string class, the Bidi Rule on strings with
+// RTL characters, no empty results; String, Bytes and Append agree, and
+// Compare is equality of the CompareKeys.
+func TestHegelRFC8265ProfilesEnforceTheirRules(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, precisCases)
+		m := precisModels[c.profile]
+		s := c.s
+		mapped := m.mapped(s)
+		wantOK := true
+		for _, r := range mapped {
+			if !m.p.Allowed().Contains(r) {
+				wantOK = false
+			}
+		}
+		if m.bidiRule && hasRTL(mapped) && !bidirule.ValidString(mapped) {
+			wantOK = false
+		}
+		if m.disallowEmpty && mapped == "" {
+			wantOK = false
+		}
+		got, err := m.p.String(s)
+		switch {
+		case err == nil && !wantOK:
+			if mapped == "" && strings.HasPrefix(m.name, "Username") && Known.UsernameEmpty {
+				count(ht, "known x-text/26")
+			} else {
+				fail(ht, "%s.String(%s) = %s, RFC 8265 rejects it (mapped %s)", m.name, show(s), show(got), show(mapped))
+			}
+		case err != nil && wantOK:
+			if m.bidiRule && err == bidirule.ErrInvalid && !hasRTL(mapped) && !bidirule.ValidString(mapped) && Known.BidiRuleOnLTR {
+				count(ht, "known x-text/27")
+			} else {
+				fail(ht, "%s.String(%s): %v, RFC 8265 gives %s", m.name, show(s), err, show(mapped))
+			}
+		case err == nil:
+			if got != mapped {
+				fail(ht, "%s.String(%s) = %s, RFC 8265 gives %s", m.name, show(s), show(got), show(mapped))
+			}
+			count(ht, "enforced")
+		default:
+			count(ht, "rejected")
+		}
+		// Bytes and Append agree with String.
+		b, errB := m.p.Bytes([]byte(s))
+		if (errB == nil) != (err == nil) || string(b) != got {
+			fail(ht, "%s.Bytes(%s) = %s, %v but String = %s, %v", m.name, show(s), show(string(b)), errB, show(got), err)
+		}
+		ap, errA := m.p.Append([]byte("z"), []byte(s))
+		if (errA == nil) != (err == nil) || (err == nil && string(ap) != "z"+got) {
+			fail(ht, "%s.Append(z, %s) = %s, %v but String = %s, %v", m.name, show(s), show(string(ap)), errA, show(got), err)
+		}
+		if err == nil {
+			if again, err2 := m.p.String(got); err2 != nil || again != got {
+				count(ht, "not-idempotent")
+				note(ht, "%s.String(%s) = %s, then %s, %v", m.name, show(s), show(got), show(again), err2)
+			}
+		}
+		// Compare is equality of the compare keys.
+		other := c.other.of(s)
+		ka, ea := m.p.CompareKey(s)
+		kb, eb := m.p.CompareKey(other)
+		want := ea == nil && eb == nil && ka == kb
+		if got := m.p.Compare(s, other); got != want {
+			fail(ht, "%s.Compare(%s, %s) = %v, keys %s (%v) and %s (%v)", m.name, show(s), show(other), got, show(ka), ea, show(kb), eb)
+		}
+		if !m.ignoreCase && ((ea == nil) != (err == nil) || ka != got) {
+			fail(ht, "%s.CompareKey(%s) = %s, %v but String = %s, %v", m.name, show(s), show(ka), ea, show(got), err)
+		}
+		if ea == nil {
+			if again, err2 := m.p.CompareKey(ka); err2 != nil || again != ka {
+				count(ht, "key-not-idempotent")
+				note(ht, "%s.CompareKey(%s) = %s, then %s, %v", m.name, show(s), show(ka), show(again), err2)
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_encoding_test.go b/hegel/hegel_encoding_test.go
new file mode 100644
index 0000000..0250ee5
--- /dev/null
+++ b/hegel/hegel_encoding_test.go
@@ -0,0 +1,624 @@
+package hegel
+
+// The encoding packages: round trips, Charmap's byte-level API against the
+// Decoder/Encoder, streaming against one-shot conversion, UTF-16/32 BOM
+// policies, the HTML and IANA name indexes, and Python's codecs where the
+// tables are the same.
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"golang.org/x/text/encoding"
+	"golang.org/x/text/encoding/charmap"
+	"golang.org/x/text/encoding/htmlindex"
+	"golang.org/x/text/encoding/ianaindex"
+	"golang.org/x/text/encoding/japanese"
+	"golang.org/x/text/encoding/korean"
+	"golang.org/x/text/encoding/simplifiedchinese"
+	"golang.org/x/text/encoding/traditionalchinese"
+	xunicode "golang.org/x/text/encoding/unicode"
+	"golang.org/x/text/encoding/unicode/utf32"
+	"hegel.dev/go/hegel"
+)
+
+// pieces is how a Transformer is driven: in pieces of chunk bytes through a
+// destination buffer of dst bytes.
+type pieces struct{ chunk, dst int }
+
+func (p pieces) GoString() string { return fmt.Sprintf("pieces of %d, dst %d", p.chunk, p.dst) }
+
+// piecesOf: pieces of 1 to maxChunk bytes and one of the destination sizes.
+func piecesOf(maxChunk int, dsts ...int) hegel.Generator[pieces] {
+	return hegel.Map(pairs(hegel.Integers(1, maxChunk), hegel.SampledFrom(dsts)), func(p pair[int, int]) pieces { return pieces{p.a, p.b} })
+}
+
+// byteRange: a byte between lo and hi.
+func byteRange(lo, hi int) hegel.Generator[byte] {
+	return hegel.Map(hegel.Integers(lo, hi), func(b int) byte { return byte(b) })
+}
+
+// pythonCodec names Python's codec for a charmap, or "" when Python has none
+// or its table is known to differ (vendor tables against the WHATWG index).
+func pythonCodec(m *charmap.Charmap) string {
+	s := m.String()
+	switch {
+	case strings.HasPrefix(s, "IBM Code Page "):
+		return "cp" + strings.TrimPrefix(s, "IBM Code Page ")
+	case strings.HasPrefix(s, "ISO 8859-"):
+		return "iso8859_" + strings.TrimPrefix(s, "ISO 8859-")
+	case strings.HasPrefix(s, "Windows "):
+		return "cp" + strings.TrimPrefix(s, "Windows ")
+	case s == "KOI8-R":
+		return "koi8_r"
+	case s == "KOI8-U":
+		return "koi8_u"
+	case s == "Macintosh":
+		return "mac_roman"
+	case s == "Macintosh Cyrillic":
+		return "mac_cyrillic"
+	}
+	return ""
+}
+
+var charmaps = func() []*charmap.Charmap {
+	var ms []*charmap.Charmap
+	for _, e := range charmap.All {
+		if m, ok := e.(*charmap.Charmap); ok {
+			ms = append(ms, m)
+		}
+	}
+	return ms
+}()
+
+// charmapCase: the charmap, eight bytes whose DecodeByte is checked against
+// the Decoder and Python, a rune to encode, up to twelve bytes whose
+// repertoire runes are round-tripped (one-shot and streamed), and some bytes
+// that may be ill-formed UTF-8 for the encoder.
+type charmapCase struct {
+	m        *charmap.Charmap
+	probes   []byte
+	r        rune
+	raw      []byte
+	dec, enc pieces
+	bad      []byte
+}
+
+func (c charmapCase) GoString() string {
+	return fmt.Sprintf("%s: probes % x, rune %U, raw % x (decode %#v, encode %#v), bad %s", c.m, c.probes, c.r, c.raw, c.dec, c.enc, show(string(c.bad)))
+}
+
+var charmapCases = hegel.Composite(func(tc hegel.TestCase) charmapCase {
+	return charmapCase{
+		m:      hegel.Draw(tc, hegel.SampledFrom(charmaps)),
+		probes: hegel.Draw(tc, fixed(bytesOf, 8)),
+		r:      hegel.Draw(tc, anyRunes),
+		raw:    hegel.Draw(tc, many(bytesOf, 0, 12)),
+		dec:    hegel.Draw(tc, piecesOf(4, 1, 2, 5, 32)),
+		enc:    hegel.Draw(tc, piecesOf(4, 1, 2, 5, 32)),
+		bad:    hegel.Draw(tc, anyBytes(0, 6)),
+	}
+})
+
+// Every single-byte charmap: DecodeByte/EncodeRune agree with the
+// Decoder/Encoder, decoding is injective on the repertoire, round trips hold
+// both ways, streaming equals one-shot, and Python's table agrees where it
+// exists.
+func TestHegelCharmapsRoundTrip(t *testing.T) {
+	py := newOracle(t)
+	pyMissing := map[string]bool{"cp1047": true}
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, charmapCases)
+		m := c.m
+		dec, enc := m.NewDecoder(), m.NewEncoder()
+		// Byte-level API against the transformers, on a few bytes.
+		for _, b := range c.probes {
+			r := m.DecodeByte(b)
+			got, err := dec.Bytes([]byte{b})
+			if err != nil || string(got) != string(r) {
+				fail(ht, "%s: DecodeByte(%#x) = %U but Decoder gives %q, %v", m, b, r, got, err)
+			}
+			if r != utf8.RuneError {
+				if eb, ok := m.EncodeRune(r); !ok || eb != b {
+					fail(ht, "%s: DecodeByte(%#x) = %U but EncodeRune(%U) = %#x, %v", m, b, r, r, eb, ok)
+				}
+				if eg, err := enc.Bytes([]byte(string(r))); err != nil || !bytes.Equal(eg, []byte{b}) {
+					fail(ht, "%s: Encoder of %U = %q, %v; DecodeByte(%#x) gives that rune", m, r, eg, err, b)
+				}
+			}
+			codec := pythonCodec(m)
+			if codec != "" && !pyMissing[codec] {
+				var want *string
+				py.call(map[string]any{"op": "decode", "codec": codec, "b": []int{int(b)}}, &want)
+				if want == nil {
+					count(ht, "no-python-codec")
+				} else if *want != string(r) {
+					w := []rune(*want)
+					switch {
+					case r == utf8.RuneError || len(w) != 1 || w[0] == utf8.RuneError:
+						count(ht, "undefined-byte-differs")
+					case r >= 0x80 && r < 0xA0 || w[0] >= 0x80 && w[0] < 0xA0:
+						count(ht, "c1-control-differs")
+					case m.String() == "KOI8-U" && (b == 0xAE || b == 0xBE):
+						// WHATWG's koi8-u is KOI8-RU: the Byelorussian short u
+						// (U+045E, U+040E) at 0xAE and 0xBE, where RFC 2319 and
+						// Python's koi8_u have box-drawing characters.
+						count(ht, "koi8u-short-u")
+					default:
+						fail(ht, "%s: DecodeByte(%#x) = %U, Python %s gives %U", m, b, r, codec, w[0])
+					}
+				}
+			}
+		}
+		// A random rune that is not in the repertoire is refused by EncodeRune and by the Encoder.
+		r := c.r
+		eb, ok := m.EncodeRune(r)
+		if ok && m.DecodeByte(eb) != r {
+			fail(ht, "%s: EncodeRune(%U) = %#x, ok, but DecodeByte(%#x) = %U", m, r, eb, eb, m.DecodeByte(eb))
+		}
+		if _, err := enc.Bytes([]byte(string(r))); (err == nil) != ok {
+			fail(ht, "%s: EncodeRune(%U) ok=%v but Encoder error %v", m, r, ok, err)
+		}
+		// Round trip of a random string in the repertoire, one-shot and streaming.
+		var bs []byte
+		var rs []rune
+		for _, b := range c.raw {
+			if rr := m.DecodeByte(b); rr != utf8.RuneError {
+				bs = append(bs, b)
+				rs = append(rs, rr)
+			}
+		}
+		s := string(rs)
+		if got, err := dec.Bytes(bs); err != nil || string(got) != s {
+			fail(ht, "%s: Decoder.Bytes(%q) = %q, %v; DecodeByte says %s", m, bs, got, err, show(s))
+		}
+		if got, err := enc.Bytes([]byte(s)); err != nil || !bytes.Equal(got, bs) {
+			fail(ht, "%s: Encoder.Bytes(%s) = %q, %v; expected %q", m, show(s), got, err, bs)
+		}
+		if got, err := drive(dec, bs, c.dec.chunk, c.dec.dst); err != nil || string(got) != s {
+			fail(ht, "%s: streaming decode of %q = %q, %v", m, bs, got, err)
+		}
+		if got, err := drive(enc, []byte(s), c.enc.chunk, c.enc.dst); err != nil || !bytes.Equal(got, bs) {
+			fail(ht, "%s: streaming encode of %s = %q, %v", m, show(s), got, err)
+		}
+		// Ill-formed UTF-8 to the encoder: an error, or replacement with the substitute.
+		bad := c.bad
+		if _, err := enc.Bytes(bad); err == nil && !utf8.Valid(bad) {
+			count(ht, "ill-formed-utf8-accepted")
+		}
+		// Every byte decodes to something; the decoder never fails.
+		if _, err := dec.Bytes(bad); err != nil {
+			fail(ht, "%s: Decoder.Bytes(%q) fails: %v", m, bad, err)
+		}
+	})
+}
+
+var cjkEncodings = func() []encoding.Encoding {
+	var es []encoding.Encoding
+	es = append(es, japanese.All...)
+	es = append(es, korean.All...)
+	es = append(es, simplifiedchinese.All...)
+	es = append(es, traditionalchinese.All...)
+	return es
+}()
+
+var cjkRunes = []rune{
+	'a', 'Z', '0', ' ', '\n', '~', '\\', 0x00A5, 0x203E, 0x00A9, 0x00E9, 0x00FC,
+	0x3042, 0x3093, 0x30A2, 0x30F4, 0x30FC, 0xFF76, 0xFF9E, 0x3000, 0x3001, 0xFF01, 0xFF5E, 0xFFE3, 0xFFE5,
+	0x4E00, 0x4E2D, 0x6587, 0x65E5, 0x672C, 0x8A9E, 0x9FA5, 0x9FFF, 0x5341, 0x9EA6, 0x7368, 0x6A2A, 0x4E9C,
+	0xAC00, 0xD7A3, 0xB098, 0xB2E4, 0x3131, 0x314F, 0x3164,
+	0x2015, 0x2014, 0x2225, 0x223C, 0x301C, 0xFF5E, 0x2212, 0xFF0D, 0x00B7, 0x30FB,
+	0x0391, 0x03A9, 0x0410, 0x044F, 0x2460, 0x2160, 0x3220, 0x33A1, 0xFA10, 0xF900, 0xF92C,
+	0x20AC, 0x00B1, 0x00D7, 0x00F7, 0x2018, 0x201D, 0x2026, 0x00B0, 0x2032,
+	0x1F600, 0x0100, 0x0410, 0x1E00, 0x10000, 0xE000, 0xE5E5, 0xFFFD, 0x0080,
+	0x2E81, 0x9FB4, 0x20087, 0x2A6A5, 0x0251, 0x01F9, 0x1E3F, 0x2170, 0x2179, 0xFE10,
+}
+
+// cjkTexts: up to ten runes, from the CJK pool 85 times in a hundred and any
+// assigned rune otherwise.
+var cjkTexts = runeStrings(weighted(choice[rune]{85, hegel.SampledFrom(cjkRunes)}, choice[rune]{15, assignedRunes}), 0, 10)
+
+// rawBytes: up to eight bytes, three in five with the high bit set.
+var rawBytes = many(weighted(choice[byte]{40, byteRange(0, 0x7F)}, choice[byte]{60, byteRange(0x80, 0xFF)}), 0, 8)
+
+// cjkCase: the encoding, the text, how the encoder and decoder are driven,
+// the reader's piece and buffer sizes and the writer's piece size, and raw
+// bytes for the decoder with their driving.
+type cjkCase struct {
+	e          encoding.Encoding
+	s          string
+	enc, dec   pieces
+	rk, rm, wk int
+	raw        []byte
+	rawDec     pieces
+}
+
+func (c cjkCase) GoString() string {
+	return fmt.Sprintf("%v: %s (encode %#v, decode %#v, reads of %d into %d, writes of %d), raw % x (%#v)", c.e, show(c.s), c.enc, c.dec, c.rk, c.rm, c.wk, c.raw, c.rawDec)
+}
+
+var cjkCases = hegel.Composite(func(tc hegel.TestCase) cjkCase {
+	return cjkCase{
+		e:      hegel.Draw(tc, hegel.SampledFrom(cjkEncodings)),
+		s:      hegel.Draw(tc, cjkTexts),
+		enc:    hegel.Draw(tc, piecesOf(4, 1, 2, 3, 5, 32)),
+		dec:    hegel.Draw(tc, piecesOf(4, 1, 2, 3, 5, 32)),
+		rk:     hegel.Draw(tc, hegel.Integers(1, 3)),
+		rm:     hegel.Draw(tc, hegel.SampledFrom([]int{1, 4, 64})),
+		wk:     hegel.Draw(tc, hegel.Integers(1, 3)),
+		raw:    hegel.Draw(tc, rawBytes),
+		rawDec: hegel.Draw(tc, piecesOf(3, 1, 2, 3, 5, 32)),
+	}
+})
+
+// The CJK encodings: what the encoder accepts decodes back to the same
+// text, streaming equals one-shot in both directions, decoding never fails,
+// and the HTML-escape/replacement wrappers do what they say.
+func TestHegelCjkEncodingsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cjkCases)
+		e := c.e
+		name := fmt.Sprint(e)
+		dec, enc := e.NewDecoder(), e.NewEncoder()
+		s := c.s
+		// Bug 44: the ISO-2022-JP encoder passes U+001B through (WHATWG's
+		// errors on U+000E, U+000F and U+001B), and its own decoder reads a
+		// bare ESC as U+FFFD and an escape sequence spelled in the text
+		// ("\x1b$B") as a mode switch: no round trip. Only the raw-bytes checks
+		// remain for such a text.
+		escInText := Known.ISO2022JPEscape && e == japanese.ISO2022JP && strings.ContainsRune(s, 0x1B)
+		if escInText {
+			count(ht, "known x-text/44")
+		}
+		if !escInText {
+			encoded, err := enc.Bytes([]byte(s))
+			if err == nil {
+				back, err := dec.Bytes(encoded)
+				if err != nil {
+					fail(ht, "%s: Decoder fails on its own Encoder's output %q for %s: %v", name, encoded, show(s), err)
+				}
+				// What the private use runes of GB18030 decode to is bug 4; the
+				// streamed decoders are then held to the one-shot decoder's text.
+				if string(back) != s {
+					if Known.GB18030PrivateUse && e == simplifiedchinese.GB18030 && strings.ContainsFunc(s, func(r rune) bool { return r >= 0xE000 && r <= 0xF8FF }) {
+						count(ht, "known x-text/4")
+					} else {
+						fail(ht, "%s: %s encodes to %q which decodes to %s", name, show(s), encoded, show(string(back)))
+					}
+				}
+				decoded := string(back)
+				// Streaming both ways.
+				if got, err := drive(enc, []byte(s), c.enc.chunk, c.enc.dst); err != nil || !bytes.Equal(got, encoded) {
+					fail(ht, "%s: streaming encode of %s = %q, %v; one-shot %q", name, show(s), got, err, encoded)
+				}
+				if got, err := drive(dec, encoded, c.dec.chunk, c.dec.dst); err != nil || string(got) != decoded {
+					fail(ht, "%s: streaming decode of %q (chunk %d, dst %d) = %s, %v; expected %s", name, encoded, c.dec.chunk, c.dec.dst, show(string(got)), err, show(decoded))
+				}
+				if got, err := viaReader(dec, encoded, c.rk, c.rm); err != nil || string(got) != decoded {
+					fail(ht, "%s: transform.Reader decode of %q = %s, %v", name, encoded, show(string(got)), err)
+				}
+				if got, err := viaWriter(enc, []byte(s), c.wk); err != nil || !bytes.Equal(got, encoded) {
+					fail(ht, "%s: transform.Writer encode of %s = %q, %v; one-shot %q", name, show(s), got, err, encoded)
+				}
+				count(ht, "encodable")
+			} else {
+				count(ht, "unencodable")
+				// Which rune failed: the wrappers must get past it.
+				esc, err := encoding.HTMLEscapeUnsupported(e.NewEncoder()).Bytes([]byte(s))
+				if err != nil {
+					fail(ht, "%s: HTMLEscapeUnsupported fails on %s: %v", name, show(s), err)
+				}
+				back, err := dec.Bytes(esc)
+				if err != nil {
+					fail(ht, "%s: decoding the HTML-escaped %q of %s: %v", name, esc, show(s), err)
+				}
+				// Model: every rune either survives or becomes &#N;.
+				var want strings.Builder
+				for _, r := range s {
+					if _, err := e.NewEncoder().Bytes([]byte(string(r))); err != nil {
+						fmt.Fprintf(&want, "&#%d;", r)
+					} else {
+						want.WriteRune(r)
+					}
+				}
+				if string(back) != want.String() {
+					if Known.HZModeAfterError && e == simplifiedchinese.HZGB2312 {
+						count(ht, "known x-text/3")
+						return
+					}
+					fail(ht, "%s: HTMLEscapeUnsupported of %s decodes to %s, expected %s", name, show(s), show(string(back)), show(want.String()))
+				}
+				rep, err := encoding.ReplaceUnsupported(e.NewEncoder()).Bytes([]byte(s))
+				if err != nil {
+					fail(ht, "%s: ReplaceUnsupported fails on %s: %v", name, show(s), err)
+				}
+				back, err = dec.Bytes(rep)
+				if err != nil {
+					fail(ht, "%s: decoding the replaced %q of %s: %v", name, rep, show(s), err)
+				}
+				// Model: every unencodable rune becomes the encoding's substitute
+				// (U+001A or U+FFFD): the encodable ones must survive in order. A
+				// substitute character in the text itself cannot be told from a
+				// replacement, so it is left out on both sides.
+				isSubstitute := func(r rune) bool { return r == 0x1A || r == utf8.RuneError }
+				var kept strings.Builder
+				for _, r := range s {
+					if _, err := e.NewEncoder().Bytes([]byte(string(r))); err == nil && !isSubstitute(r) {
+						kept.WriteRune(r)
+					}
+				}
+				var gotKept strings.Builder
+				for _, r := range string(back) {
+					if strings.ContainsRune(s, r) && !isSubstitute(r) {
+						gotKept.WriteRune(r)
+					}
+				}
+				if gotKept.String() != kept.String() {
+					if Known.HZModeAfterError && e == simplifiedchinese.HZGB2312 {
+						count(ht, "known x-text/3")
+						return
+					}
+					fail(ht, "%s: ReplaceUnsupported of %s decodes to %s; the encodable runes %s did not survive", name, show(s), show(string(back)), show(kept.String()))
+				}
+			}
+		}
+		// Random bytes decode without error, and what decodes cleanly re-encodes to the same bytes.
+		raw := c.raw
+		got, err := dec.Bytes(raw)
+		if err != nil {
+			fail(ht, "%s: Decoder.Bytes(%q) fails: %v", name, raw, err)
+		}
+		if !utf8.Valid(got) {
+			fail(ht, "%s: Decoder.Bytes(%q) = %q is not UTF-8", name, raw, got)
+		}
+		if got2, err := drive(dec, raw, c.rawDec.chunk, c.rawDec.dst); err != nil || !bytes.Equal(got, got2) {
+			fail(ht, "%s: streaming decode of %q = %q, %v; one-shot %q", name, raw, got2, err, got)
+		}
+		if !bytes.ContainsRune(got, utf8.RuneError) {
+			if re, err := enc.Bytes(got); err != nil || !bytes.Equal(re, raw) {
+				count(ht, "decode-encode-not-identity")
+				note(ht, "%s: %q decodes to %s which encodes to %q, %v", name, raw, show(string(got)), re, err)
+			}
+		}
+	})
+}
+
+// bomEncoding is a UTF-16/32 encoding with a BOM policy (or UTF-8 with or
+// without one): whether its encoder writes a BOM, whether its decoder
+// expects one, and its code unit in bytes.
+type bomEncoding struct {
+	name string
+	e    encoding.Encoding
+	bom  bool
+	exp  bool
+	unit int
+}
+
+var bomEncodings = func() []bomEncoding {
+	var encs []bomEncoding
+	for _, en := range []xunicode.Endianness{xunicode.BigEndian, xunicode.LittleEndian} {
+		for _, pol := range []xunicode.BOMPolicy{xunicode.IgnoreBOM, xunicode.UseBOM, xunicode.ExpectBOM} {
+			encs = append(encs, bomEncoding{fmt.Sprintf("UTF16(%v,%v)", en, pol), xunicode.UTF16(en, pol), pol != xunicode.IgnoreBOM, pol == xunicode.ExpectBOM, 2})
+		}
+	}
+	for _, en := range []utf32.Endianness{utf32.BigEndian, utf32.LittleEndian} {
+		for _, pol := range []utf32.BOMPolicy{utf32.IgnoreBOM, utf32.UseBOM, utf32.ExpectBOM} {
+			encs = append(encs, bomEncoding{fmt.Sprintf("UTF32(%v,%v)", en, pol), utf32.UTF32(en, pol), pol != utf32.IgnoreBOM, pol == utf32.ExpectBOM, 4})
+		}
+	}
+	return append(encs, bomEncoding{"UTF8", xunicode.UTF8, false, false, 1}, bomEncoding{"UTF8BOM", xunicode.UTF8BOM, true, false, 1})
+}()
+
+// junkUnits are ill-formed tails for a UTF-16/32 stream: an odd byte, high
+// surrogates without a low one, lone low surrogates, code units past
+// U+10FFFF.
+var junkUnits = hegel.OneOf(
+	hegel.Map(bytesOf, func(b byte) []byte { return []byte{b} }),
+	hegel.Just([]byte{0xD8, 0x00, 0x00, 0xD8, 0x00, 0x41}),
+	hegel.Just([]byte{0xDC, 0x00, 0xDC, 0x00}),
+	hegel.Just([]byte{0x00, 0x11, 0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF}),
+)
+
+// utfCase: the encoding (by index), the text, how the encoder and decoder
+// are driven, and the junk appended to the encoded text with its driving.
+type utfCase struct {
+	e        int
+	s        string
+	enc, dec pieces
+	junk     []byte
+	junkDec  pieces
+}
+
+func (c utfCase) GoString() string {
+	return fmt.Sprintf("%s: %s (encode %#v, decode %#v), junk % x (%#v)", bomEncodings[c.e].name, show(c.s), c.enc, c.dec, c.junk, c.junkDec)
+}
+
+var utfCases = hegel.Composite(func(tc hegel.TestCase) utfCase {
+	return utfCase{
+		e:       hegel.Draw(tc, hegel.Integers(0, len(bomEncodings)-1)),
+		s:       hegel.Draw(tc, texts15(0, 10)),
+		enc:     hegel.Draw(tc, piecesOf(4, 1, 2, 3, 4, 5, 32)),
+		dec:     hegel.Draw(tc, piecesOf(5, 1, 2, 3, 4, 5, 32)),
+		junk:    hegel.Draw(tc, junkUnits),
+		junkDec: hegel.Draw(tc, piecesOf(5, 1, 2, 3, 4, 5, 32)),
+	}
+})
+
+// UTF-16 and UTF-32 with every endianness and BOM policy: encode/decode round
+// trips, the BOM appears exactly when the policy says, ExpectBOM fails without
+// one, ill-formed input yields U+FFFD and never an error or a panic, streaming
+// equals one-shot.
+func TestHegelUtf16And32RoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, utfCases)
+		e := bomEncodings[c.e]
+		s := c.s
+		encoded, err := e.e.NewEncoder().Bytes([]byte(s))
+		if err != nil {
+			fail(ht, "%s: encoding %s: %v", e.name, show(s), err)
+		}
+		if e.unit > 1 && len(encoded)%e.unit != 0 {
+			fail(ht, "%s: encoding %s gives %d bytes", e.name, show(s), len(encoded))
+		}
+		back, err := e.e.NewDecoder().Bytes(encoded)
+		if err != nil || string(back) != s {
+			fail(ht, "%s: %s -> %q -> %s, %v", e.name, show(s), encoded, show(string(back)), err)
+		}
+		// The BOM.
+		units := len(encoded) / e.unit
+		if e.unit > 1 && units != utf16Len(s, e.unit)+boolInt(e.bom) {
+			fail(ht, "%s: %s encodes to %d code units, expected %d (+%d BOM)", e.name, show(s), units, utf16Len(s, e.unit), boolInt(e.bom))
+		}
+		if e.unit == 1 && len(encoded) != len(s)+3*boolInt(e.bom) {
+			fail(ht, "%s: %s encodes to %q", e.name, show(s), encoded)
+		}
+		// (A text starting with U+FEFF, or with U+FFFE which is the other
+		// endianness' BOM, itself supplies a BOM once the encoder's is
+		// dropped.)
+		bomLike := strings.HasPrefix(s, string(rune(0xFEFF))) || strings.HasPrefix(s, string(rune(0xFFFE)))
+		if e.exp && !bomLike {
+			if _, err := e.e.NewDecoder().Bytes(encoded[e.unit:]); err == nil && len(encoded) > e.unit {
+				fail(ht, "%s: decoding without the BOM succeeds on %q", e.name, encoded[e.unit:])
+			}
+		}
+		// Streaming.
+		if got, err := drive(e.e.NewEncoder(), []byte(s), c.enc.chunk, c.enc.dst); err != nil || !bytes.Equal(got, encoded) {
+			fail(ht, "%s: streaming encode of %s = %q, %v; one-shot %q", e.name, show(s), got, err, encoded)
+		}
+		if got, err := drive(e.e.NewDecoder(), encoded, c.dec.chunk, c.dec.dst); err != nil || string(got) != s {
+			fail(ht, "%s: streaming decode of %q = %s, %v", e.name, encoded, show(string(got)), err)
+		}
+		// Ill-formed input: surrogates, odd lengths, out-of-range code units.
+		if e.unit > 1 && !e.exp {
+			raw := append(append([]byte{}, encoded...), c.junk...)
+			got, err := e.e.NewDecoder().Bytes(raw)
+			if err != nil {
+				fail(ht, "%s: decoding ill-formed %q: %v", e.name, raw, err)
+			}
+			if !utf8.Valid(got) {
+				fail(ht, "%s: decoding ill-formed %q gives non-UTF-8 %q", e.name, raw, got)
+			}
+			if !strings.HasPrefix(string(got), s) {
+				fail(ht, "%s: decoding %q with junk appended gives %s, prefix %s lost", e.name, raw, show(string(got)), show(s))
+			}
+			if got2, err := drive(e.e.NewDecoder(), raw, c.junkDec.chunk, c.junkDec.dst); err != nil || !bytes.Equal(got, got2) {
+				fail(ht, "%s: streaming decode of ill-formed %q = %q, %v; one-shot %q", e.name, raw, got2, err, got)
+			}
+		}
+	})
+}
+
+// sameEncoding compares two encodings by identity, or by name for the
+// encodings whose values are not comparable.
+func sameEncoding(a, b encoding.Encoding) bool {
+	defer func() { recover() }()
+	if a == b {
+		return true
+	}
+	return fmt.Sprint(a) == fmt.Sprint(b)
+}
+
+func boolInt(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// utf16Len is the number of code units of s in UTF-16 (unit 2) or UTF-32.
+func utf16Len(s string, unit int) int {
+	k := 0
+	for _, r := range s {
+		if unit == 2 && r > 0xFFFF {
+			k += 2
+		} else {
+			k++
+		}
+	}
+	return k
+}
+
+var allEncodings = func() []encoding.Encoding {
+	var all []encoding.Encoding
+	all = append(all, charmap.All...)
+	all = append(all, cjkEncodings...)
+	all = append(all, xunicode.All...)
+	return append(all, utf32.All...)
+}()
+
+// indexCase: an encoding of every family and a name no index knows.
+type indexCase struct {
+	e    encoding.Encoding
+	junk string
+}
+
+func (c indexCase) GoString() string { return fmt.Sprintf("%v, junk name %q", c.e, c.junk) }
+
+var indexCases = hegel.Composite(func(tc hegel.TestCase) indexCase {
+	return indexCase{
+		e:    hegel.Draw(tc, hegel.SampledFrom(allEncodings)),
+		junk: hegel.Draw(tc, hegel.SampledFrom([]string{"", "x-nonsense", "utf-9", "iso-8859-99", "windows-9999", "\x00"})),
+	}
+})
+
+// The HTML and IANA indexes: Name and Get/Encoding round-trip for every
+// encoding they know, case-insensitively.
+func TestHegelEncodingIndexesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, indexCases)
+		e := c.e
+		if name, err := htmlindex.Name(e); err == nil {
+			variants := []string{name, strings.ToUpper(name), strings.ToLower(name), " " + name + "\t"}
+			for _, v := range variants {
+				got, err := htmlindex.Get(v)
+				if err != nil {
+					fail(ht, "htmlindex.Name(%v) = %q but Get(%q): %v", e, name, v, err)
+				}
+				if !sameEncoding(got, e) {
+					fail(ht, "htmlindex.Get(%q) = %v, not %v", v, got, e)
+				}
+			}
+		} else {
+			count(ht, "not-in-htmlindex")
+		}
+		for _, idx := range []struct {
+			name string
+			x    *ianaindex.Index
+		}{{"IANA", ianaindex.IANA}, {"MIME", ianaindex.MIME}, {"MIB", ianaindex.MIB}} {
+			name, err := idx.x.Name(e)
+			if err != nil {
+				count(ht, "no-"+idx.name+"-name")
+				continue
+			}
+			if idx.name == "MIB" {
+				// Encoding accepts IANA names; the MIB index only differs in the names it returns.
+				count(ht, "mib-name")
+				continue
+			}
+			for _, v := range []string{name, strings.ToUpper(name), strings.ToLower(name)} {
+				got, err := idx.x.Encoding(v)
+				if err != nil || got == nil {
+					if Known.IANAUTF32 && strings.HasPrefix(name, "UTF-32") {
+						count(ht, "known x-text/5")
+						continue
+					}
+					fail(ht, "ianaindex.%s.Name(%v) = %q but Encoding(%q) = %v, %v", idx.name, e, name, v, got, err)
+				}
+				if !sameEncoding(got, e) {
+					fail(ht, "ianaindex.%s.Encoding(%q) = %v, not %v", idx.name, v, got, e)
+				}
+			}
+		}
+		// An unknown name is an error, not a panic.
+		junk := c.junk
+		if _, err := htmlindex.Get(junk); err == nil {
+			fail(ht, "htmlindex.Get(%q) succeeds", junk)
+		}
+		if got, err := ianaindex.IANA.Encoding(junk); err == nil && got != nil {
+			fail(ht, "ianaindex.IANA.Encoding(%q) = %v", junk, got)
+		}
+	})
+}
