@@ -0,0 +1,607 @@
+package hegel
+
+// unicode/norm, unicode/rangetable, unicode/runenames against Python's
+// unicodedata (Unicode 15.0) and against the package's own contracts.
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/text/unicode/norm"
+	"golang.org/x/text/unicode/rangetable"
+	"golang.org/x/text/unicode/runenames"
+	"hegel.dev/go/hegel"
+)
+
+var forms = []norm.Form{norm.NFC, norm.NFD, norm.NFKC, norm.NFKD}
+var formNames = map[norm.Form]string{norm.NFC: "NFC", norm.NFD: "NFD", norm.NFKC: "NFKC", norm.NFKD: "NFKD"}
+
+// formIndexes draws a form by its index into forms.
+var formIndexes = hegel.Integers(0, len(forms)-1)
+
+// nonStarters are combining marks of several classes and the Hangul V/T
+// jamo, which combine backwards; a run of them around the 30-rune
+// stream-safe limit is where the forms insert a CGJ.
+var nonStarters = hegel.SampledFrom([]rune{0x0300, 0x0301, 0x0323, 0x05B0, 0x0334, 0x0345, 0x1161, 0x11A8, 0x0F73, 0x0344})
+
+// normTexts: a text of up to twelve runes; one time in ten it follows a run
+// of 20 to 40 non-starters after nothing, a starter or a Hangul L jamo.
+var normTexts = weighted(
+	choice[string]{90, texts15(0, 12)},
+	choice[string]{10, cat(hegel.SampledFrom([]string{"", "a", "\u1100"}), runeStrings(nonStarters, 20, 40), texts15(0, 12))},
+)
+
+// Every form's String, Bytes and Append agree with Python's
+// unicodedata.normalize, and the forms satisfy the standard's identities.
+func TestHegelNormFormsAgreeWithPython(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, normTexts)
+		var want map[string]string
+		py.call(map[string]any{"op": "norm", "s": s}, &want)
+		got := map[string]string{}
+		cgj := false // a stream-safe CGJ was inserted (bug 1): Python and the identities differ
+		for _, f := range forms {
+			name := formNames[f]
+			got[name] = f.String(s)
+			if got[name] != want[name] {
+				// The inserted CGJ also stops the canonical reordering at that point.
+				if Known.StreamSafeCGJ && strings.Count(got[name], "\u034f") > strings.Count(s, "\u034f") {
+					cgj = true
+				} else {
+					fail(ht, "%s(%s): got %s, Python %s", name, show(s), show(got[name]), show(want[name]))
+				}
+			}
+			if b := f.Bytes([]byte(s)); string(b) != got[name] {
+				fail(ht, "%s.Bytes(%s) = %s but String = %s", name, show(s), show(string(b)), show(got[name]))
+			}
+			if b := f.Append(nil, []byte(s)...); string(b) != got[name] {
+				fail(ht, "%s.Append(nil, %s) = %s but String = %s", name, show(s), show(string(b)), show(got[name]))
+			}
+			// Append returns f(append(out, src...)): the join may combine.
+			if b := f.AppendString([]byte("x"), s); string(b) != f.String("x"+s) {
+				fail(ht, "%s.AppendString(x, %s) = %s, %s(x + s) = %s", name, show(s), show(string(b)), name, show(f.String("x"+s)))
+			}
+			isNormal := got[name] == s
+			if f.IsNormalString(s) != isNormal || f.IsNormal([]byte(s)) != isNormal {
+				fail(ht, "%s.IsNormal(%s) = %v but %s(s) = %s", name, show(s), f.IsNormalString(s), name, show(got[name]))
+			}
+			q := f.QuickSpanString(s)
+			if q < 0 || q > len(s) || !utf8.ValidString(s[:q]) || f.String(s[:q]) != s[:q] {
+				fail(ht, "%s.QuickSpanString(%s) = %d but %s(prefix) = %s", name, show(s), q, name, show(f.String(s[:q])))
+			}
+			if isNormal && q != len(s) {
+				count(ht, "quickspan-conservative")
+			}
+			if f.QuickSpan([]byte(s)) != q {
+				fail(ht, "%s.QuickSpan bytes/string disagree on %s: %d vs %d", name, show(s), f.QuickSpan([]byte(s)), q)
+			}
+		}
+		// Identities of UAX #15.
+		if cgj {
+			count(ht, "known x-text/1")
+			return
+		}
+		if x := norm.NFC.String(got["NFD"]); x != got["NFC"] {
+			fail(ht, "NFC(NFD(%s)) = %s but NFC = %s", show(s), show(x), show(got["NFC"]))
+		}
+		if x := norm.NFD.String(got["NFC"]); x != got["NFD"] {
+			fail(ht, "NFD(NFC(%s)) = %s but NFD = %s", show(s), show(x), show(got["NFD"]))
+		}
+		if x := norm.NFKC.String(got["NFKD"]); x != got["NFKC"] {
+			fail(ht, "NFKC(NFKD(%s)) = %s but NFKC = %s", show(s), show(x), show(got["NFKC"]))
+		}
+		if x := norm.NFKD.String(got["NFKC"]); x != got["NFKD"] {
+			fail(ht, "NFKD(NFKC(%s)) = %s but NFKD = %s", show(s), show(x), show(got["NFKD"]))
+		}
+		for _, f := range forms {
+			name := formNames[f]
+			if x := f.String(got[name]); x != got[name] {
+				fail(ht, "%s is not idempotent on %s: %s then %s", name, show(s), show(got[name]), show(x))
+			}
+		}
+	})
+}
+
+// longRuns: a run of 1 to 40 non-starters (with an input CGJ among the
+// choices) after nothing, a starter, a Hangul L jamo or a dialytika tonos,
+// followed by a short text half of the time: around and past the segment
+// limit.
+var longRuns = cat(
+	hegel.SampledFrom([]string{"", "a", "\u1100", "\u0344"}),
+	runeStrings(hegel.SampledFrom([]rune{0x0300, 0x0301, 0x0323, 0x05B0, 0x0334, 0x0345, 0x034F, 0x1161, 0x11A8, 0x0F73, 0x0344}), 1, 40),
+	maybe(50, texts15(0, 4)),
+)
+
+// normStreamCase: the form (by index), the input (any bytes, or a long run
+// of non-starters one time in five), the driver's piece and destination
+// sizes, and the reader's piece and buffer sizes (the piece is the writer's
+// too).
+type normStreamCase struct {
+	form       int
+	src        []byte
+	chunk, dst int
+	k, m       int
+}
+
+func (c normStreamCase) GoString() string {
+	return fmt.Sprintf("%s on %s: pieces of %d, dst %d; reads of %d into %d", formNames[forms[c.form]], show(string(c.src)), c.chunk, c.dst, c.k, c.m)
+}
+
+var normStreamCases = hegel.Composite(func(tc hegel.TestCase) normStreamCase {
+	return normStreamCase{
+		form: hegel.Draw(tc, formIndexes),
+		src: hegel.Draw(tc, weighted(
+			choice[[]byte]{80, anyBytes(0, 16)},
+			choice[[]byte]{20, hegel.Map(longRuns, func(s string) []byte { return []byte(s) })},
+		)),
+		chunk: hegel.Draw(tc, hegel.Integers(1, 9)),
+		dst:   hegel.Draw(tc, hegel.SampledFrom([]int{1, 2, 3, 4, 7, 16, 64})),
+		k:     hegel.Draw(tc, hegel.Integers(1, 7)),
+		m:     hegel.Draw(tc, hegel.SampledFrom([]int{1, 3, 8, 64})),
+	}
+})
+
+// The streaming paths (Transform driven by the contract, Reader, Writer,
+// Iter) produce the same bytes as the one-shot Bytes, on any input including
+// ill-formed UTF-8 and long combining sequences.
+func TestHegelNormStreamingMatchesWholeString(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, normStreamCases)
+		f := forms[c.form]
+		name := formNames[f]
+		src := c.src
+		want := f.Bytes(src)
+		chunk, dstSize := c.chunk, c.dst
+		got, err := drive(f, src, chunk, dstSize)
+		if err != nil {
+			fail(ht, "%s.Transform on %q (chunk %d, dst %d): %v", name, src, chunk, dstSize, err)
+		}
+		if !bytes.Equal(got, want) {
+			fail(ht, "%s.Transform on %q in chunks of %d with dst %d: %q, one-shot %q", name, src, chunk, dstSize, got, want)
+		}
+		k, m := c.k, c.m
+		if got, err := viaReader(f, src, k, m); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s via transform.NewReader on %q (%d bytes per read, buffer %d): %q, %v; one-shot %q", name, src, k, m, got, err, want)
+		}
+		if got, err := viaWriter(f, src, k); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s via transform.NewWriter on %q (writes of %d): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		if got, err := readerForm(f, src, k, m); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s.Reader on %q (%d bytes per read): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		if got, err := writerForm(f, src, k); err != nil || !bytes.Equal(got, want) {
+			fail(ht, "%s.Writer on %q (writes of %d): %q, %v; one-shot %q", name, src, k, got, err, want)
+		}
+		var it norm.Iter
+		it.Init(f, src)
+		var acc []byte
+		pos := 0
+		for i := 0; !it.Done(); i++ {
+			if i > 10*len(src)+10 {
+				fail(ht, "%s Iter over %q does not finish", name, src)
+			}
+			if p := it.Pos(); p < pos || p > len(src) {
+				fail(ht, "%s Iter.Pos on %q went from %d to %d", name, src, pos, p)
+			} else {
+				pos = p
+			}
+			acc = append(acc, it.Next()...)
+		}
+		if !bytes.Equal(acc, want) {
+			// The two paths place the stream-safe CGJ differently (and the
+			// reordering stops at it), never otherwise.
+			if Known.IterJamoCGJ && (bytes.Contains(acc, []byte("\u034f")) || bytes.Contains(want, []byte("\u034f"))) {
+				count(ht, "known x-text/2")
+				return
+			}
+			fail(ht, "%s Iter over %q yields %q, one-shot %q", name, src, acc, want)
+		}
+		if p := it.Pos(); p != len(src) {
+			fail(ht, "%s Iter over %q is Done at Pos %d of %d", name, src, p, len(src))
+		}
+	})
+}
+
+// readerForm reads src through f.Reader over a source that yields k bytes at
+// a time, with buffers of m bytes.
+func readerForm(f norm.Form, src []byte, k, m int) ([]byte, error) {
+	r := f.Reader(&chunkedReader{bytes.NewReader(src), k})
+	var out []byte
+	buf := make([]byte, m)
+	for i := 0; i < 1000000; i++ {
+		nr, err := r.Read(buf)
+		out = append(out, buf[:nr]...)
+		if err == io.EOF {
+			return out, nil
+		}
+		if err != nil {
+			return out, err
+		}
+	}
+	return out, errNoProgress
+}
+
+// writerForm writes src through f.Writer in writes of k bytes.
+func writerForm(f norm.Form, src []byte, k int) ([]byte, error) {
+	var buf bytes.Buffer
+	w := f.Writer(&buf)
+	for i := 0; i < len(src); i += k {
+		j := i + k
+		if j > len(src) {
+			j = len(src)
+		}
+		if _, err := w.Write(src[i:j]); err != nil {
+			return buf.Bytes(), err
+		}
+	}
+	if err := w.Close(); err != nil {
+		return buf.Bytes(), err
+	}
+	return buf.Bytes(), nil
+}
+
+// boundaryCase: the text, the form (by index) and the prefixes put before a
+// segment-starting rune (a starter, a mark, a Hangul L jamo, a Devanagari
+// letter; recycled over the runes).
+type boundaryCase struct {
+	s    string
+	form int
+	pres []string
+}
+
+func (c boundaryCase) GoString() string {
+	return fmt.Sprintf("%s: %s, prefixes %s", formNames[forms[c.form]], show(c.s), show(strings.Join(c.pres, "|")))
+}
+
+var boundaryCases = hegel.Composite(func(tc hegel.TestCase) boundaryCase {
+	return boundaryCase{
+		s:    hegel.Draw(tc, texts15(0, 10)),
+		form: hegel.Draw(tc, formIndexes),
+		pres: hegel.Draw(tc, many(hegel.SampledFrom([]string{"a", "\u0301", "\u1100", "\u0915"}), 1, 4)),
+	}
+})
+
+// Boundaries split the input into independently normalizable pieces, Span
+// prefixes are normal, and Properties match unicodedata.
+func TestHegelNormBoundariesAndProperties(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, boundaryCases)
+		s := c.s
+		b := []byte(s)
+		f := forms[c.form]
+		name := formNames[f]
+		// Boundaries are shared between NFC and NFD, and between NFKC and NFKD
+		// (the compatibility decompositions add non-starters of their own, as
+		// U+FF9F -> U+309A).
+		kin := []norm.Form{norm.NFC, norm.NFD}
+		if f == norm.NFKC || f == norm.NFKD {
+			kin = []norm.Form{norm.NFKC, norm.NFKD}
+		}
+		splitsCleanly := func(i int, what string) {
+			for _, g := range kin {
+				if x := g.String(s[:i]) + g.String(s[i:]); x != g.String(s) {
+					fail(ht, "%s reports a boundary at %d in %s, but %s of the parts %s + %s != %s", what, i, show(s), formNames[g], show(g.String(s[:i])), show(g.String(s[i:])), show(g.String(s)))
+				}
+			}
+		}
+		if i := f.FirstBoundary(b); i != -1 {
+			if i < 0 || i > len(b) || i != f.FirstBoundaryInString(s) {
+				fail(ht, "%s.FirstBoundary(%s) = %d (string version %d)", name, show(s), i, f.FirstBoundaryInString(s))
+			}
+			splitsCleanly(i, name+".FirstBoundary")
+		}
+		if i := f.LastBoundary(b); i != -1 {
+			if i < 0 || i > len(b) {
+				fail(ht, "%s.LastBoundary(%s) = %d", name, show(s), i)
+			}
+			splitsCleanly(i, name+".LastBoundary")
+		}
+		// Walk the segments with NextBoundary.
+		pos, segs := 0, 0
+		for pos < len(b) {
+			i := f.NextBoundary(b[pos:], true)
+			if i <= 0 || i > len(b)-pos {
+				fail(ht, "%s.NextBoundary(%s[%d:], true) = %d", name, show(s), pos, i)
+			}
+			if j := f.NextBoundaryInString(s[pos:], true); j != i {
+				fail(ht, "%s.NextBoundary bytes %d vs string %d on %s[%d:]", name, i, j, show(s), pos)
+			}
+			if j := f.NextBoundary(b[pos:], false); j != -1 && j != i {
+				fail(ht, "%s.NextBoundary(%s[%d:]) = %d at EOF but %d without", name, show(s), pos, i, j)
+			}
+			splitsCleanly(pos+i, name+".NextBoundary")
+			pos += i
+			segs++
+			if segs > len(b)+1 {
+				fail(ht, "%s.NextBoundary loops on %s", name, show(s))
+			}
+		}
+		if len(b) == 0 && f.NextBoundary(b, true) != 0 {
+			fail(ht, "%s.NextBoundary(empty, true) = %d", name, f.NextBoundary(b, true))
+		}
+		// Span: a boundary prefix that is already normal.
+		if k, err := f.Span(b, true); k < 0 || k > len(b) || f.String(s[:k]) != s[:k] || (k < len(b)) != (err != nil) {
+			fail(ht, "%s.Span(%s, true) = %d, %v", name, show(s), k, err)
+		}
+		if k, err := f.SpanString(s, false); k < 0 || k > len(b) || f.String(s[:k]) != s[:k] || (k < len(b)) != (err != nil) {
+			fail(ht, "%s.SpanString(%s, false) = %d, %v", name, show(s), k, err)
+		}
+		// Properties against unicodedata.
+		ps := py.props(s)
+		rs := []rune(s)
+		for i, r := range rs {
+			if i >= len(ps) {
+				break
+			}
+			p := f.PropertiesString(string(r))
+			if p.Size() != utf8.RuneLen(r) {
+				fail(ht, "%s.Properties(%U).Size() = %d", name, r, p.Size())
+			}
+			if int(p.CCC()) != ps[i].CCC {
+				fail(ht, "%s.Properties(%U).CCC() = %d, unicodedata.combining = %d", name, r, p.CCC(), ps[i].CCC)
+			}
+			d := p.Decomposition()
+			hangul := r >= 0xAC00 && r <= 0xD7A3
+			var full string
+			if f == norm.NFC || f == norm.NFD {
+				full = norm.NFD.String(string(r))
+			} else {
+				full = norm.NFKD.String(string(r))
+			}
+			if hangul {
+				count(ht, "hangul-decomposition")
+			} else if d == nil && full != string(r) {
+				fail(ht, "%s.Properties(%U).Decomposition() is nil but the rune decomposes to %s", name, r, show(full))
+			} else if d != nil && string(d) != full {
+				fail(ht, "%s.Properties(%U).Decomposition() = %s, full decomposition %s", name, r, show(string(d)), show(full))
+			}
+			if d != nil {
+				dr := []rune(string(d))
+				if p.LeadCCC() != f.PropertiesString(string(dr[0])).CCC() || p.TrailCCC() != f.PropertiesString(string(dr[len(dr)-1])).CCC() {
+					fail(ht, "%s.Properties(%U): LeadCCC %d TrailCCC %d, decomposition %s", name, r, p.LeadCCC(), p.TrailCCC(), show(string(d)))
+				}
+			} else if p.LeadCCC() != p.CCC() || p.TrailCCC() != p.CCC() {
+				fail(ht, "%s.Properties(%U): no decomposition but LeadCCC %d TrailCCC %d CCC %d", name, r, p.LeadCCC(), p.TrailCCC(), p.CCC())
+			}
+			if p.BoundaryBefore() && ps[i].CCC != 0 {
+				fail(ht, "%s.Properties(%U).BoundaryBefore() with CCC %d", name, r, ps[i].CCC)
+			}
+			// Bug 45: under NFKC the 60 compatibility and halfwidth Hangul
+			// letters whose decomposition is a V or T jamo (U+314F -> U+1161)
+			// have BoundaryBefore() true, yet NFKC composes them with an L or LV
+			// on the left (U+1100 + U+314F -> U+AC00). The other forms are exact.
+			dr := []rune(norm.NFKD.String(string(r)))
+			compatVT := len(dr) == 1 && dr[0] != r && 0x1160 <= dr[0] && dr[0] <= 0x11FF
+			if Known.NFKCCompatJamoBoundary && p.BoundaryBefore() && f == norm.NFKC && compatVT {
+				count(ht, "known x-text/45")
+			} else if p.BoundaryBefore() {
+				// A rune that starts a segment: the normalization of any prefix + r splits before r.
+				pre := c.pres[i%len(c.pres)]
+				for _, g := range kin {
+					if g.String(pre+string(r)) != g.String(pre)+g.String(string(r)) {
+						fail(ht, "%s.Properties(%U).BoundaryBefore() but %s(%s + %U) = %s", name, r, formNames[g], show(pre), r, show(g.String(pre+string(r))))
+					}
+				}
+			}
+		}
+	})
+}
+
+// stdTables are the standard library's tables a merge may take.
+var stdTables = []struct {
+	name string
+	t    *unicode.RangeTable
+}{
+	{"Letter", unicode.Letter}, {"Greek", unicode.Greek}, {"Han", unicode.Han}, {"Nd", unicode.Nd},
+	{"Zs", unicode.Zs}, {"Latin", unicode.Latin}, {"Cc", unicode.Cc},
+}
+
+// tableSpec is one table of a merge: a standard table, a hand-built table
+// with strides, or rangetable.New of some runes.
+type tableSpec interface{ GoString() string }
+
+type stdTable struct{ i int }
+
+// builtTable: R16 ranges laid out one after the other from lo (each of
+// stride and count runes, then a gap to the next), and an R32 range half of
+// the time.
+type builtTable struct {
+	lo     int
+	ranges []rangeSpec
+	wide   *wideRange
+}
+
+type rangeSpec struct{ stride, count, gap int }
+
+type wideRange struct{ lo, stride, count int }
+
+type newTable struct{ rs []rune }
+
+func (t stdTable) GoString() string { return stdTables[t.i].name }
+func (t builtTable) GoString() string {
+	return fmt.Sprintf("built from %#x %v %v", t.lo, t.ranges, t.wide)
+}
+func (t newTable) GoString() string { return fmt.Sprintf("New(%U)", t.rs) }
+
+// build lays the table out and returns it with the runes it holds.
+func (t builtTable) build() (*unicode.RangeTable, []rune) {
+	rt := &unicode.RangeTable{}
+	var in []rune
+	lo := rune(t.lo)
+	for _, r := range t.ranges {
+		stride, cnt := rune(r.stride), rune(r.count)
+		hi := lo + stride*cnt
+		if hi <= unicode.MaxLatin1 {
+			rt.LatinOffset++
+		}
+		rt.R16 = append(rt.R16, unicode.Range16{Lo: uint16(lo), Hi: uint16(hi), Stride: uint16(stride)})
+		for x := lo; x <= hi; x += stride {
+			in = append(in, x)
+		}
+		lo = hi + rune(r.gap)
+	}
+	if w := t.wide; w != nil {
+		lo32, stride := rune(w.lo), rune(w.stride)
+		hi32 := lo32 + stride*rune(w.count)
+		rt.R32 = append(rt.R32, unicode.Range32{Lo: uint32(lo32), Hi: uint32(hi32), Stride: uint32(stride)})
+		for x := lo32; x <= hi32; x += stride {
+			in = append(in, x)
+		}
+	}
+	return rt, in
+}
+
+var (
+	rangeSpecs = hegel.Composite(func(tc hegel.TestCase) rangeSpec {
+		return rangeSpec{stride: hegel.Draw(tc, hegel.Integers(1, 3)), count: hegel.Draw(tc, hegel.Integers(0, 5)), gap: hegel.Draw(tc, hegel.Integers(1, 20))}
+	})
+	wideRanges = hegel.Composite(func(tc hegel.TestCase) wideRange {
+		return wideRange{lo: hegel.Draw(tc, hegel.Integers(0x10000, 0x20000)), stride: hegel.Draw(tc, hegel.Integers(1, 3)), count: hegel.Draw(tc, hegel.Integers(0, 5))}
+	})
+	// tableSpecs: a standard table once, a built table once, New of up to
+	// eight runes of all of the code space twice, by weight.
+	tableSpecs = weighted(
+		choice[tableSpec]{1, hegel.Map(hegel.Integers(0, len(stdTables)-1), func(i int) tableSpec { return stdTable{i} })},
+		choice[tableSpec]{1, hegel.Composite(func(tc hegel.TestCase) tableSpec {
+			return builtTable{lo: hegel.Draw(tc, hegel.Integers(0, 0x2000)), ranges: hegel.Draw(tc, many(rangeSpecs, 1, 3)), wide: hegel.Draw(tc, optional(50, wideRanges))}
+		})},
+		choice[tableSpec]{2, hegel.Map(many(wideRunes, 0, 8), func(rs []rune) tableSpec { return newTable{rs} })},
+	)
+)
+
+// mergeCase: up to four tables and twenty runes whose membership is probed.
+type mergeCase struct {
+	tables []tableSpec
+	probes []rune
+}
+
+func (c mergeCase) GoString() string { return fmt.Sprintf("%#v, probes %U", c.tables, c.probes) }
+
+var mergeCases = hegel.Composite(func(tc hegel.TestCase) mergeCase {
+	return mergeCase{tables: hegel.Draw(tc, many(tableSpecs, 0, 4)), probes: hegel.Draw(tc, fixed(wideRunes, 20))}
+})
+
+// rangetable.Merge is the union of its tables, in a well-formed table, and
+// New/Visit round-trip a set of runes.
+func TestHegelRangeTableMergeIsTheUnion(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, mergeCases)
+		k := len(c.tables)
+		var tables []*unicode.RangeTable
+		in := map[rune]bool{}
+		for _, spec := range c.tables {
+			switch spec := spec.(type) {
+			case stdTable:
+				tables = append(tables, stdTables[spec.i].t)
+				rangetable.Visit(tables[len(tables)-1], func(r rune) { in[r] = true })
+			case builtTable:
+				rt, rs := spec.build()
+				for _, r := range rs {
+					in[r] = true
+				}
+				tables = append(tables, rt)
+			case newTable:
+				rs := spec.rs
+				for _, r := range rs {
+					in[r] = true
+				}
+				nt := rangetable.New(rs...)
+				var back []rune
+				rangetable.Visit(nt, func(r rune) { back = append(back, r) })
+				set := map[rune]bool{}
+				for _, r := range rs {
+					set[r] = true
+				}
+				if len(back) != len(set) {
+					fail(ht, "rangetable.New(%v) visits %v", rs, back)
+				}
+				for i, r := range back {
+					if !set[r] || (i > 0 && back[i-1] >= r) {
+						fail(ht, "rangetable.New(%v) visits %v", rs, back)
+					}
+				}
+				tables = append(tables, nt)
+			}
+		}
+		merged := rangetable.Merge(tables...)
+		// Well-formed: sorted, non-overlapping, strides positive, LatinOffset right.
+		prev := rune(-1)
+		latin := 0
+		for _, r := range merged.R16 {
+			if r.Stride == 0 || r.Lo > r.Hi || rune(r.Lo) <= prev || (r.Hi-r.Lo)%r.Stride != 0 {
+				fail(ht, "Merge of %d tables: malformed R16 %+v after %d", k, r, prev)
+			}
+			prev = rune(r.Hi)
+			if r.Hi <= unicode.MaxLatin1 {
+				latin++
+			}
+		}
+		if merged.LatinOffset != latin {
+			fail(ht, "Merge of %d tables: LatinOffset %d, %d ranges end in Latin-1: %+v", k, merged.LatinOffset, latin, merged.R16)
+		}
+		for _, r := range merged.R32 {
+			if r.Stride == 0 || r.Lo > r.Hi || rune(r.Lo) <= prev || (r.Hi-r.Lo)%r.Stride != 0 || r.Lo <= 0xFFFF {
+				fail(ht, "Merge of %d tables: malformed R32 %+v after %d", k, r, prev)
+			}
+			prev = rune(r.Hi)
+		}
+		// Membership.
+		var visited []rune
+		rangetable.Visit(merged, func(r rune) { visited = append(visited, r) })
+		if len(visited) != len(in) {
+			fail(ht, "Merge of %d tables has %d runes, the union %d", k, len(visited), len(in))
+		}
+		for _, r := range visited {
+			if !in[r] {
+				fail(ht, "Merge of %d tables contains %U, not in the union", k, r)
+			}
+		}
+		for _, r := range c.probes {
+			if unicode.Is(merged, r) != in[r] {
+				fail(ht, "unicode.Is(Merge of %d tables, %U) = %v, union says %v", k, r, unicode.Is(merged, r), in[r])
+			}
+		}
+	})
+}
+
+// runeNameTexts: one to eight runes assigned in Unicode 15.
+var runeNameTexts = texts15(1, 8)
+
+// runenames.Name agrees with unicodedata.name on every named Unicode 15.0
+// character.
+func TestHegelRuneNamesMatchPython(t *testing.T) {
+	py := newOracle(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, runeNameTexts)
+		ps := py.props(s)
+		for i, r := range []rune(s) {
+			if i >= len(ps) {
+				break
+			}
+			got := runenames.Name(r)
+			if strings.HasPrefix(got, "<") && strings.HasSuffix(got, ">") {
+				// The UnicodeData range label (<Hangul Syllable>, <CJK Ideograph>, <Private Use>)
+				// stands for the whole range; the standard's derived names are not computed.
+				count(ht, "range-label")
+				continue
+			}
+			if ps[i].Name == "" {
+				count(ht, "unnamed-in-python")
+				if got != "" && !(ps[i].Cat == "Cc" && got == "<control>") {
+					note(ht, "%U: Go %q, Python has no name (category %s)", r, got, ps[i].Cat)
+				}
+				continue
+			}
+			if got != ps[i].Name {
+				fail(ht, "runenames.Name(%U) = %q, unicodedata.name = %q", r, got, ps[i].Name)
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_pins_cases_test.go b/hegel/hegel_pins_cases_test.go
new file mode 100644
index 0000000..a6150af
--- /dev/null
+++ b/hegel/hegel_pins_cases_test.go
@@ -0,0 +1,170 @@
+package hegel
+
+// One plain test per recorded bug in unicode/bidi and secure/precis, asserting
+// the correct behaviour so that it fails while the bug exists; listed as
+// expected failures in target.toml.
+
+import (
+	"testing"
+
+	"golang.org/x/text/cases"
+	"golang.org/x/text/language"
+	"golang.org/x/text/secure/bidirule"
+	"golang.org/x/text/secure/precis"
+	"golang.org/x/text/transform"
+	"golang.org/x/text/unicode/bidi"
+)
+
+// x-text/34
+func TestHegelPinBidiRuleTransformerAcceptsAChunkEndingInAHyphen(t *testing.T) {
+	tr := bidirule.New()
+	dst := make([]byte, 16)
+	nDst, nSrc, err := tr.Transform(dst, []byte("a-"), false)
+	if err != nil {
+		t.Errorf("Transform(a-, atEOF=false) = %d, %d, %v; the label may continue with b, so nothing has failed yet", nDst, nSrc, err)
+	}
+	tr.Reset()
+	if n, err := tr.Span([]byte("a-"), false); err != nil {
+		t.Errorf("Span(a-, atEOF=false) = %d, %v; a valid label can still follow", n, err)
+	}
+	if !bidirule.Valid([]byte("a-b")) {
+		t.Fatal("Valid(a-b) is false")
+	}
+}
+
+// x-text/35
+func TestHegelPinBidiRuleRejectsSurrogatesAndCodePointsPastTheMaximum(t *testing.T) {
+	for _, b := range [][]byte{{0xED, 0xA0, 0x80}, {0xF4, 0x90, 0x80, 0x80}, {'a', 0xED, 0xA0, 0x80}} {
+		if bidirule.Valid(b) {
+			t.Errorf("Valid(% x) is true on ill-formed UTF-8 (the lone byte 0x80 and the overlong C0 80 are rejected)", b)
+		}
+		if _, sz := bidi.Lookup(b); sz > 1 {
+			t.Errorf("bidi.Lookup(% x) decodes %d bytes as a character", b, sz)
+		}
+	}
+}
+
+// x-text/32
+func TestHegelPinFoldLeavesCherokeeCapitalsAlone(t *testing.T) {
+	f := cases.Fold()
+	if got := f.String("Ꭰ"); got != "Ꭰ" {
+		t.Errorf("Fold(U+13A0 CHEROKEE LETTER A) = %+q; CaseFolding.txt folds U+AB70 to U+13A0 and has no mapping for U+13A0 (Python casefold agrees)", got)
+	}
+	once := f.String("ꭰ")
+	if twice := f.String(once); twice != once {
+		t.Errorf("Fold is not idempotent: Fold(U+AB70) = %+q, Fold of that = %+q", once, twice)
+	}
+}
+
+// x-text/33
+func TestHegelPinLowerKeepsTheFinalSigmaContextAcrossCalls(t *testing.T) {
+	c := cases.Lower(language.Und)
+	whole := c.String("aΣ◈")
+	if whole != "aς◈" {
+		t.Fatalf("Lower(a SIGMA U+25C8) = %+q", whole)
+	}
+	c.Reset()
+	dst := make([]byte, 32)
+	nDst, nSrc, err := c.Transform(dst, []byte("aΣ"), false)
+	if err != transform.ErrShortSrc || nSrc != 1 {
+		t.Fatalf("Transform(a SIGMA, atEOF=false) = %d, %d, %v", nDst, nSrc, err)
+	}
+	out := string(dst[:nDst])
+	nDst, nSrc, err = c.Transform(dst, []byte("Σ◈"), true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out += string(dst[:nDst])
+	if out != whole {
+		t.Errorf("Lower in two calls (a SIGMA | SIGMA U+25C8) = %+q, in one call %+q: the sigma is final, the previous call ended in a cased letter", out, whole)
+	}
+}
+
+// x-text/25
+func TestHegelPinReverseStringKeepsMarksAfterTheirBase(t *testing.T) {
+	if got := bidi.ReverseString("áb"); got != "bá" {
+		t.Errorf("ReverseString(a + U+0301 + b) = %+q, want %+q: the doc says modifiers still follow the runes they modify", got, "bá")
+	}
+	if got := string(bidi.AppendReverse(nil, []byte("áb"))); got != "bá" {
+		t.Errorf("AppendReverse(nil, a + U+0301 + b) = %+q, want %+q", got, "bá")
+	}
+}
+
+// x-text/26
+func TestHegelPinUsernameProfilesRejectTheEmptyString(t *testing.T) {
+	for name, p := range map[string]*precis.Profile{"UsernameCaseMapped": precis.UsernameCaseMapped, "UsernameCasePreserved": precis.UsernameCasePreserved} {
+		if got, err := p.String(""); err == nil {
+			t.Errorf("%s.String(\"\") = %+q, nil; RFC 8265 section 3.3: a username MUST NOT be zero bytes in length", name, got)
+		}
+	}
+}
+
+// x-text/27
+func TestHegelPinUsernameProfilesApplyTheBidiRuleOnlyToRTLStrings(t *testing.T) {
+	for _, tc := range []struct{ s, ascii string }{{"1é", "1e"}, {"é-", "e-"}} {
+		if _, err := precis.UsernameCasePreserved.String(tc.ascii); err != nil {
+			t.Fatalf("UsernameCasePreserved.String(%+q): %v", tc.ascii, err)
+		}
+		if _, err := precis.UsernameCasePreserved.String(tc.s); err != nil {
+			t.Errorf("UsernameCasePreserved.String(%+q): %v; the string has no right-to-left character, so RFC 8265's rule 5 does not apply, and the ASCII %+q is accepted", tc.s, err, tc.ascii)
+		}
+	}
+}
+
+// x-text/28
+func TestHegelPinRunAtReturnsTheRunAtThePosition(t *testing.T) {
+	var p bidi.Paragraph
+	p.SetString("abc אבג def")
+	if _, err := p.Order(); err != nil {
+		t.Fatal(err)
+	}
+	r := p.RunAt(0)
+	if a, b := r.Pos(); a != 0 || b != 3 {
+		t.Errorf("RunAt(0) of abc + Hebrew + def is the run at %d-%d (%+q), want 0-3 (%+q)", a, b, r.String(), "abc ")
+	}
+}
+
+// x-text/29
+func TestHegelPinOrderingDirectionIsMixedForMixedText(t *testing.T) {
+	var p bidi.Paragraph
+	p.SetString("abc א")
+	o, err := p.Order()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if d := o.Direction(); d != bidi.Mixed {
+		t.Errorf("Direction() of abc + Hebrew alef = %d, want Mixed (%d)", d, bidi.Mixed)
+	}
+}
+
+// x-text/30
+func TestHegelPinParagraphDirectionDoesNotPanicBeforeOrder(t *testing.T) {
+	var p bidi.Paragraph
+	p.SetString("א")
+	if msg := catch(func() { p.IsLeftToRight() }); msg != "" {
+		t.Errorf("Paragraph.IsLeftToRight() before Order() panicked: %s", msg)
+	}
+	p.SetString("")
+	o, _ := p.Order()
+	if msg := catch(func() { o.Direction() }); msg != "" {
+		t.Errorf("Ordering.Direction() of the empty paragraph panicked: %s", msg)
+	}
+}
+
+// x-text/31
+func TestHegelPinOrderStopsAtTheParagraphSeparator(t *testing.T) {
+	var p bidi.Paragraph
+	n, _ := p.SetString("a\nb")
+	o, err := p.Order()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var acc string
+	for i := 0; i < o.NumRuns(); i++ {
+		r := o.Run(i)
+		acc += r.String()
+	}
+	if n != 2 || (acc != "a" && acc != "a\n") {
+		t.Errorf("SetString(a NL b) = %d and the runs spell %+q; SetString says only the first paragraph is processed", n, acc)
+	}
+}
diff --git a/hegel/hegel_pins_lang_test.go b/hegel/hegel_pins_lang_test.go
