+// pythonCodec names Python's codec for a charmap, or "" when Python has none
+// or its table is known to differ (vendor tables against the WHATWG index).
+func pythonCodec(m *charmap.Charmap) string {
+	s := m.String()
+	switch {
+	case strings.HasPrefix(s, "IBM Code Page "):
+		return "cp" + strings.TrimPrefix(s, "IBM Code Page ")
+	case strings.HasPrefix(s, "ISO 8859-"):
+		return "iso8859_" + strings.TrimPrefix(s, "ISO 8859-")
+	case strings.HasPrefix(s, "Windows "):
+		return "cp" + strings.TrimPrefix(s, "Windows ")
+	case s == "KOI8-R":
+		return "koi8_r"
+	case s == "KOI8-U":
+		return "koi8_u"
+	case s == "Macintosh":
+		return "mac_roman"
+	case s == "Macintosh Cyrillic":
+		return "mac_cyrillic"
+	}
+	return ""
+}
+
+var charmaps = func() []*charmap.Charmap {
+	var ms []*charmap.Charmap
+	for _, e := range charmap.All {
+		if m, ok := e.(*charmap.Charmap); ok {
+			ms = append(ms, m)
+		}
+	}
+	return ms
+}()
+
+// Every single-byte charmap: DecodeByte/EncodeRune agree with the
+// Decoder/Encoder, decoding is injective on the repertoire, round trips hold
+// both ways, streaming equals one-shot, and Python's table agrees where it
+// exists.
+func TestHegelCharmapsRoundTrip(t *testing.T) {
+	py := newOracle(t)
+	pyMissing := map[string]bool{"cp1047": true}
+	property(t, func(ht *hegel.T) {
+		m := pick(ht, charmaps...)
+		dec, enc := m.NewDecoder(), m.NewEncoder()
+		// Byte-level API against the transformers, on a few bytes.
+		for i := 0; i < 8; i++ {
+			b := byte(n(ht, 0, 255))
+			r := m.DecodeByte(b)
+			got, err := dec.Bytes([]byte{b})
+			if err != nil || string(got) != string(r) {
+				fail(ht, "%s: DecodeByte(%#x) = %U but Decoder gives %q, %v", m, b, r, got, err)
+			}
+			if r != utf8.RuneError {
+				if eb, ok := m.EncodeRune(r); !ok || eb != b {
+					fail(ht, "%s: DecodeByte(%#x) = %U but EncodeRune(%U) = %#x, %v", m, b, r, r, eb, ok)
+				}
+				if eg, err := enc.Bytes([]byte(string(r))); err != nil || !bytes.Equal(eg, []byte{b}) {
+					fail(ht, "%s: Encoder of %U = %q, %v; DecodeByte(%#x) gives that rune", m, r, eg, err, b)
+				}
+			}
+			codec := pythonCodec(m)
+			if codec != "" && !pyMissing[codec] {
+				var want *string
+				py.call(map[string]any{"op": "decode", "codec": codec, "b": []int{int(b)}}, &want)
+				if want == nil {
+					count(ht, "no-python-codec")
+				} else if *want != string(r) {
+					w := []rune(*want)
+					if r == utf8.RuneError || len(w) != 1 || w[0] == utf8.RuneError {
+						count(ht, "undefined-byte-differs")
+					} else if r >= 0x80 && r < 0xA0 || w[0] >= 0x80 && w[0] < 0xA0 {
+						count(ht, "c1-control-differs")
+					} else {
+						fail(ht, "%s: DecodeByte(%#x) = %U, Python %s gives %U", m, b, r, codec, w[0])
+					}
+				}
+			}
+		}
+		// A random rune that is not in the repertoire is refused by EncodeRune and by the Encoder.
+		r := anyRune(ht, false)
+		eb, ok := m.EncodeRune(r)
+		if ok && m.DecodeByte(eb) != r {
+			fail(ht, "%s: EncodeRune(%U) = %#x, ok, but DecodeByte(%#x) = %U", m, r, eb, eb, m.DecodeByte(eb))
+		}
+		if _, err := enc.Bytes([]byte(string(r))); (err == nil) != ok {
+			fail(ht, "%s: EncodeRune(%U) ok=%v but Encoder error %v", m, r, ok, err)
+		}
+		// Round trip of a random string in the repertoire, one-shot and streaming.
+		k := n(ht, 0, 12)
+		var bs []byte
+		var rs []rune
+		for i := 0; i < k; i++ {
+			b := byte(n(ht, 0, 255))
+			if rr := m.DecodeByte(b); rr != utf8.RuneError {
+				bs = append(bs, b)
+				rs = append(rs, rr)
+			}
+		}
+		s := string(rs)
+		if got, err := dec.Bytes(bs); err != nil || string(got) != s {
+			fail(ht, "%s: Decoder.Bytes(%q) = %q, %v; DecodeByte says %s", m, bs, got, err, show(s))
+		}
+		if got, err := enc.Bytes([]byte(s)); err != nil || !bytes.Equal(got, bs) {
+			fail(ht, "%s: Encoder.Bytes(%s) = %q, %v; expected %q", m, show(s), got, err, bs)
+		}
+		if got, err := drive(dec, bs, n(ht, 1, 4), pick(ht, 1, 2, 5, 32)); err != nil || string(got) != s {
+			fail(ht, "%s: streaming decode of %q = %q, %v", m, bs, got, err)
+		}
+		if got, err := drive(enc, []byte(s), n(ht, 1, 4), pick(ht, 1, 2, 5, 32)); err != nil || !bytes.Equal(got, bs) {
+			fail(ht, "%s: streaming encode of %s = %q, %v", m, show(s), got, err)
+		}
+		// Ill-formed UTF-8 to the encoder: an error, or replacement with the substitute.
+		bad := bytesAny(ht, 0, 6)
+		if _, err := enc.Bytes(bad); err == nil && !utf8.Valid(bad) {
+			count(ht, "ill-formed-utf8-accepted")
+		}
+		// Every byte decodes to something; the decoder never fails.
+		if _, err := dec.Bytes(bad); err != nil {
+			fail(ht, "%s: Decoder.Bytes(%q) fails: %v", m, bad, err)
+		}
+	})
+}
+
+var cjkEncodings = func() []encoding.Encoding {
+	var es []encoding.Encoding
+	es = append(es, japanese.All...)
+	es = append(es, korean.All...)
+	es = append(es, simplifiedchinese.All...)
+	es = append(es, traditionalchinese.All...)
+	return es
+}()
+
+var cjkRunes = []rune{
+	'a', 'Z', '0', ' ', '\n', '~', '\\', 0x00A5, 0x203E, 0x00A9, 0x00E9, 0x00FC,
+	0x3042, 0x3093, 0x30A2, 0x30F4, 0x30FC, 0xFF76, 0xFF9E, 0x3000, 0x3001, 0xFF01, 0xFF5E, 0xFFE3, 0xFFE5,
+	0x4E00, 0x4E2D, 0x6587, 0x65E5, 0x672C, 0x8A9E, 0x9FA5, 0x9FFF, 0x5341, 0x9EA6, 0x7368, 0x6A2A, 0x4E9C,
+	0xAC00, 0xD7A3, 0xB098, 0xB2E4, 0x3131, 0x314F, 0x3164,
+	0x2015, 0x2014, 0x2225, 0x223C, 0x301C, 0xFF5E, 0x2212, 0xFF0D, 0x00B7, 0x30FB,
+	0x0391, 0x03A9, 0x0410, 0x044F, 0x2460, 0x2160, 0x3220, 0x33A1, 0xFA10, 0xF900, 0xF92C,
+	0x20AC, 0x00B1, 0x00D7, 0x00F7, 0x2018, 0x201D, 0x2026, 0x00B0, 0x2032,
+	0x1F600, 0x0100, 0x0410, 0x1E00, 0x10000, 0xE000, 0xE5E5, 0xFFFD, 0x0080,
+	0x2E81, 0x9FB4, 0x20087, 0x2A6A5, 0x0251, 0x01F9, 0x1E3F, 0x2170, 0x2179, 0xFE10,
+}
+
+func cjkString(tc hegel.TestCase, lo, hi int) string {
+	k := n(tc, lo, hi)
+	rs := make([]rune, 0, k)
+	for i := 0; i < k; i++ {
+		if chance(tc, 15) {
+			rs = append(rs, assignedRune(tc))
+		} else {
+			rs = append(rs, pick(tc, cjkRunes...))
+		}
+	}
+	return string(rs)
+}
+
+// The CJK encodings: what the encoder accepts decodes back to the same
+// text, streaming equals one-shot in both directions, decoding never fails,
+// and the HTML-escape/replacement wrappers do what they say.
+func TestHegelCjkEncodingsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		e := pick(ht, cjkEncodings...)
+		name := fmt.Sprint(e)
+		dec, enc := e.NewDecoder(), e.NewEncoder()
+		s := cjkString(ht, 0, 10)
+		encoded, err := enc.Bytes([]byte(s))
+		if err == nil {
+			back, err := dec.Bytes(encoded)
+			if err != nil {
+				fail(ht, "%s: Decoder fails on its own Encoder's output %q for %s: %v", name, encoded, show(s), err)
+			}
+			if string(back) != s {
+				if Known.GB18030PrivateUse && e == simplifiedchinese.GB18030 && strings.ContainsFunc(s, func(r rune) bool { return r >= 0xE000 && r <= 0xF8FF }) {
+					count(ht, "known x-text/4")
+					return
+				}
+				fail(ht, "%s: %s encodes to %q which decodes to %s", name, show(s), encoded, show(string(back)))
+			}
+			// Streaming both ways.
+			if got, err := drive(enc, []byte(s), n(ht, 1, 4), pick(ht, 1, 2, 3, 5, 32)); err != nil || !bytes.Equal(got, encoded) {
+				fail(ht, "%s: streaming encode of %s = %q, %v; one-shot %q", name, show(s), got, err, encoded)
+			}
+			chunk, dst := n(ht, 1, 4), pick(ht, 1, 2, 3, 5, 32)
+			if got, err := drive(dec, encoded, chunk, dst); err != nil || string(got) != s {
+				fail(ht, "%s: streaming decode of %q (chunk %d, dst %d) = %s, %v; expected %s", name, encoded, chunk, dst, show(string(got)), err, show(s))
+			}
+			if got, err := viaReader(dec, encoded, n(ht, 1, 3), pick(ht, 1, 4, 64)); err != nil || string(got) != s {
+				fail(ht, "%s: transform.Reader decode of %q = %s, %v", name, encoded, show(string(got)), err)
+			}
+			if got, err := viaWriter(enc, []byte(s), n(ht, 1, 3)); err != nil || !bytes.Equal(got, encoded) {
+				fail(ht, "%s: transform.Writer encode of %s = %q, %v; one-shot %q", name, show(s), got, err, encoded)
+			}
+			count(ht, "encodable")
+		} else {
+			count(ht, "unencodable")
+			// Which rune failed: the wrappers must get past it.
+			esc, err := encoding.HTMLEscapeUnsupported(e.NewEncoder()).Bytes([]byte(s))
+			if err != nil {
+				fail(ht, "%s: HTMLEscapeUnsupported fails on %s: %v", name, show(s), err)
+			}
+			back, err := dec.Bytes(esc)
+			if err != nil {
+				fail(ht, "%s: decoding the HTML-escaped %q of %s: %v", name, esc, show(s), err)
+			}
+			// Model: every rune either survives or becomes &#N;.
+			var want strings.Builder
+			for _, r := range s {
+				if _, err := e.NewEncoder().Bytes([]byte(string(r))); err != nil {
+					fmt.Fprintf(&want, "&#%d;", r)
+				} else {
+					want.WriteRune(r)
+				}
+			}
+			if string(back) != want.String() {
+				if Known.HZModeAfterError && e == simplifiedchinese.HZGB2312 {
+					count(ht, "known x-text/3")
+					return
+				}
+				fail(ht, "%s: HTMLEscapeUnsupported of %s decodes to %s, expected %s", name, show(s), show(string(back)), show(want.String()))
+			}
+			rep, err := encoding.ReplaceUnsupported(e.NewEncoder()).Bytes([]byte(s))
+			if err != nil {
+				fail(ht, "%s: ReplaceUnsupported fails on %s: %v", name, show(s), err)
+			}
+			back, err = dec.Bytes(rep)
+			if err != nil {
+				fail(ht, "%s: decoding the replaced %q of %s: %v", name, rep, show(s), err)
+			}
+			// Model: every unencodable rune becomes the encoding's substitute (U+001A or U+FFFD...): the
+			// encodable ones must survive in order.
+			var kept strings.Builder
+			for _, r := range s {
+				if _, err := e.NewEncoder().Bytes([]byte(string(r))); err == nil {
+					kept.WriteRune(r)
+				}
+			}
+			var gotKept strings.Builder
+			for _, r := range string(back) {
+				if strings.ContainsRune(s, r) && r != 0x1A && r != utf8.RuneError {
+					gotKept.WriteRune(r)
+				}
+			}
+			if gotKept.String() != kept.String() {
+				if Known.HZModeAfterError && e == simplifiedchinese.HZGB2312 {
+					count(ht, "known x-text/3")
+					return
+				}
+				fail(ht, "%s: ReplaceUnsupported of %s decodes to %s; the encodable runes %s did not survive", name, show(s), show(string(back)), show(kept.String()))
+			}
+		}
+		// Random bytes decode without error, and what decodes cleanly re-encodes to the same bytes.
+		raw := make([]byte, n(ht, 0, 8))
+		for i := range raw {
+			if chance(ht, 60) {
+				raw[i] = byte(n(ht, 0x80, 0xFF))
+			} else {
+				raw[i] = byte(n(ht, 0, 0x7F))
+			}
+		}
+		got, err := dec.Bytes(raw)
+		if err != nil {
+			fail(ht, "%s: Decoder.Bytes(%q) fails: %v", name, raw, err)
+		}
+		if !utf8.Valid(got) {
+			fail(ht, "%s: Decoder.Bytes(%q) = %q is not UTF-8", name, raw, got)
+		}
+		if got2, err := drive(dec, raw, n(ht, 1, 3), pick(ht, 1, 2, 3, 5, 32)); err != nil || !bytes.Equal(got, got2) {
+			fail(ht, "%s: streaming decode of %q = %q, %v; one-shot %q", name, raw, got2, err, got)
+		}
+		if !bytes.ContainsRune(got, utf8.RuneError) {
+			if re, err := enc.Bytes(got); err != nil || !bytes.Equal(re, raw) {
+				count(ht, "decode-encode-not-identity")
+				note(ht, "%s: %q decodes to %s which encodes to %q, %v", name, raw, show(string(got)), re, err)
+			}
+		}
+	})
+}
+
+// UTF-16 and UTF-32 with every endianness and BOM policy: encode/decode round
+// trips, the BOM appears exactly when the policy says, ExpectBOM fails without
+// one, ill-formed input yields U+FFFD and never an error or a panic, streaming
+// equals one-shot.
+func TestHegelUtf16And32RoundTrip(t *testing.T) {
+	type enc struct {
+		name string
+		e    encoding.Encoding
+		bom  bool // whether the encoder writes a BOM
+		exp  bool // ExpectBOM
+		unit int
+	}
+	var encs []enc
+	for _, en := range []xunicode.Endianness{xunicode.BigEndian, xunicode.LittleEndian} {
+		for _, pol := range []xunicode.BOMPolicy{xunicode.IgnoreBOM, xunicode.UseBOM, xunicode.ExpectBOM} {
+			encs = append(encs, enc{fmt.Sprintf("UTF16(%v,%v)", en, pol), xunicode.UTF16(en, pol), pol != xunicode.IgnoreBOM, pol == xunicode.ExpectBOM, 2})
+		}
+	}
+	for _, en := range []utf32.Endianness{utf32.BigEndian, utf32.LittleEndian} {
+		for _, pol := range []utf32.BOMPolicy{utf32.IgnoreBOM, utf32.UseBOM, utf32.ExpectBOM} {
+			encs = append(encs, enc{fmt.Sprintf("UTF32(%v,%v)", en, pol), utf32.UTF32(en, pol), pol != utf32.IgnoreBOM, pol == utf32.ExpectBOM, 4})
+		}
+	}
+	encs = append(encs, enc{"UTF8", xunicode.UTF8, false, false, 1}, enc{"UTF8BOM", xunicode.UTF8BOM, true, false, 1})
+	property(t, func(ht *hegel.T) {
+		e := pick(ht, encs...)
+		s := text15(ht, 0, 10)
+		encoded, err := e.e.NewEncoder().Bytes([]byte(s))
+		if err != nil {
+			fail(ht, "%s: encoding %s: %v", e.name, show(s), err)
+		}
+		if e.unit > 1 && len(encoded)%e.unit != 0 {
+			fail(ht, "%s: encoding %s gives %d bytes", e.name, show(s), len(encoded))
+		}
+		back, err := e.e.NewDecoder().Bytes(encoded)
+		if err != nil || string(back) != s {
+			fail(ht, "%s: %s -> %q -> %s, %v", e.name, show(s), encoded, show(string(back)), err)
+		}
+		// The BOM.
+		units := len(encoded) / e.unit
+		if e.unit > 1 && units != utf16Len(s, e.unit)+boolInt(e.bom) {
+			fail(ht, "%s: %s encodes to %d code units, expected %d (+%d BOM)", e.name, show(s), units, utf16Len(s, e.unit), boolInt(e.bom))
+		}
+		if e.unit == 1 && len(encoded) != len(s)+3*boolInt(e.bom) {
+			fail(ht, "%s: %s encodes to %q", e.name, show(s), encoded)
+		}
+		if e.exp {
+			if _, err := e.e.NewDecoder().Bytes(encoded[e.unit:]); err == nil && len(encoded) > e.unit {
+				fail(ht, "%s: decoding without the BOM succeeds on %q", e.name, encoded[e.unit:])
+			}
+		}
+		// Streaming.
+		if got, err := drive(e.e.NewEncoder(), []byte(s), n(ht, 1, 4), pick(ht, 1, 2, 3, 4, 5, 32)); err != nil || !bytes.Equal(got, encoded) {
+			fail(ht, "%s: streaming encode of %s = %q, %v; one-shot %q", e.name, show(s), got, err, encoded)
+		}
+		if got, err := drive(e.e.NewDecoder(), encoded, n(ht, 1, 5), pick(ht, 1, 2, 3, 4, 5, 32)); err != nil || string(got) != s {
+			fail(ht, "%s: streaming decode of %q = %s, %v", e.name, encoded, show(string(got)), err)
+		}
+		// Ill-formed input: surrogates, odd lengths, out-of-range code units.
+		if e.unit > 1 && !e.exp {
+			raw := append([]byte{}, encoded...)
+			switch n(ht, 1, 4) {
+			case 1:
+				raw = append(raw, byte(n(ht, 0, 255)))
+			case 2:
+				raw = append(raw, 0xD8, 0x00, 0x00, 0xD8, 0x00, 0x41)
+			case 3:
+				raw = append(raw, 0xDC, 0x00, 0xDC, 0x00)
+			default:
+				raw = append(raw, 0x00, 0x11, 0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF)
+			}
+			got, err := e.e.NewDecoder().Bytes(raw)
+			if err != nil {
+				fail(ht, "%s: decoding ill-formed %q: %v", e.name, raw, err)
+			}
+			if !utf8.Valid(got) {
+				fail(ht, "%s: decoding ill-formed %q gives non-UTF-8 %q", e.name, raw, got)
+			}
+			if !strings.HasPrefix(string(got), s) {
+				fail(ht, "%s: decoding %q with junk appended gives %s, prefix %s lost", e.name, raw, show(string(got)), show(s))
+			}
+			if got2, err := drive(e.e.NewDecoder(), raw, n(ht, 1, 5), pick(ht, 1, 2, 3, 4, 5, 32)); err != nil || !bytes.Equal(got, got2) {
+				fail(ht, "%s: streaming decode of ill-formed %q = %q, %v; one-shot %q", e.name, raw, got2, err, got)
+			}
+		}
+	})
+}
+
+// sameEncoding compares two encodings by identity, or by name for the
+// encodings whose values are not comparable.
+func sameEncoding(a, b encoding.Encoding) bool {
+	defer func() { recover() }()
+	if a == b {
+		return true
+	}
+	return fmt.Sprint(a) == fmt.Sprint(b)
+}
+
+func boolInt(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// utf16Len is the number of code units of s in UTF-16 (unit 2) or UTF-32.
+func utf16Len(s string, unit int) int {
+	k := 0
+	for _, r := range s {
+		if unit == 2 && r > 0xFFFF {
+			k += 2
+		} else {
+			k++
+		}
+	}
+	return k
+}
+
+// The HTML and IANA indexes: Name and Get/Encoding round-trip for every
+// encoding they know, case-insensitively.
+func TestHegelEncodingIndexesRoundTrip(t *testing.T) {
+	var all []encoding.Encoding
+	all = append(all, charmap.All...)
+	all = append(all, cjkEncodings...)
+	all = append(all, xunicode.All...)
+	all = append(all, utf32.All...)
+	property(t, func(ht *hegel.T) {
+		e := pick(ht, all...)
+		if name, err := htmlindex.Name(e); err == nil {
+			variants := []string{name, strings.ToUpper(name), strings.ToLower(name), " " + name + "\t"}
+			for _, v := range variants {
+				got, err := htmlindex.Get(v)
+				if err != nil {
+					fail(ht, "htmlindex.Name(%v) = %q but Get(%q): %v", e, name, v, err)
+				}
+				if !sameEncoding(got, e) {
+					fail(ht, "htmlindex.Get(%q) = %v, not %v", v, got, e)
+				}
+			}
+		} else {
+			count(ht, "not-in-htmlindex")
+		}
+		for _, idx := range []struct {
+			name string
+			x    *ianaindex.Index
+		}{{"IANA", ianaindex.IANA}, {"MIME", ianaindex.MIME}, {"MIB", ianaindex.MIB}} {
+			name, err := idx.x.Name(e)
+			if err != nil {
+				count(ht, "no-"+idx.name+"-name")
+				continue
+			}
+			if idx.name == "MIB" {
+				// Encoding accepts IANA names; the MIB index only differs in the names it returns.
+				count(ht, "mib-name")
+				continue
+			}
+			for _, v := range []string{name, strings.ToUpper(name), strings.ToLower(name)} {
+				got, err := idx.x.Encoding(v)
+				if err != nil || got == nil {
+					if Known.IANAUTF32 && strings.HasPrefix(name, "UTF-32") {
+						count(ht, "known x-text/5")
+						continue
+					}
+					fail(ht, "ianaindex.%s.Name(%v) = %q but Encoding(%q) = %v, %v", idx.name, e, name, v, got, err)
+				}
+				if !sameEncoding(got, e) {
+					fail(ht, "ianaindex.%s.Encoding(%q) = %v, not %v", idx.name, v, got, e)
+				}
+			}
+		}
+		// An unknown name is an error, not a panic.
+		junk := pick(ht, "", "x-nonsense", "utf-9", "iso-8859-99", "windows-9999", "\x00")
+		if _, err := htmlindex.Get(junk); err == nil {
+			fail(ht, "htmlindex.Get(%q) succeeds", junk)
+		}
+		if got, err := ianaindex.IANA.Encoding(junk); err == nil && got != nil {
+			fail(ht, "ianaindex.IANA.Encoding(%q) = %v", junk, got)
+		}
+		_ = transform.Nop
+	})
+}
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..96595be
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,221 @@
+package hegel
+
+// Generators and the Transformer driver shared by the properties.
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/text/transform"
+	"golang.org/x/text/unicode/rangetable"
+	"hegel.dev/go/hegel"
+)
+
+// interestingRunes are the runes normalization, casing, width and bidi care
+// about: composed and decomposed Latin, combining marks of many classes,
+// Hangul jamo and syllables, compatibility characters, singletons,
+// exclusions, multi-segment decompositions, format and control characters.
+var interestingRunes = []rune{
+	'a', 'A', 'z', '0', '9', ' ', '\n', '.', '-', '\'',
+	0x00C5, 0x00E9, 0x00F1, 0x00DF, 0x00B2, 0x00BD, 0x00B5, 0x00A0, 0x00AD,
+	0x212B, 0x212A, 0x2126, 0x00C5, 0x1E9B, 0x03D3, 0x1F80, 0x1FBC, 0x0390, 0x0130, 0x0131, 0x0149,
+	0xFB01, 0xFB03, 0xFF21, 0xFF76, 0xFF9E, 0x3300, 0xFDFA, 0x2460, 0x2075, 0x2153,
+	0x0300, 0x0301, 0x0323, 0x031B, 0x0327, 0x0316, 0x05B0, 0x05B8, 0x093C, 0x0334, 0x0345, 0x034F,
+	0x0344, 0x0F73, 0x0F75, 0x0F81, 0x0958, 0x2ADC, 0x0DDD, 0x0CC0, 0xFB2C, 0x0B4B, 0x1B06,
+	0x1100, 0x1112, 0x1161, 0x1175, 0x11A8, 0x11C2, 0xAC00, 0xAC01, 0xD7A3, 0x3131, 0x3164,
+	0xF900, 0xFA10, 0x2F800, 0x1D160, 0x1D15E, 0x11099, 0x1109A,
+	0x0301, 0x0302, 0x0303, 0x0304, 0x0305, 0x0306, 0x0307, 0x0308,
+	0x03C2, 0x03C3, 0x03A3, 0x0345, 0x1E9E, 0x0587, 0x1F50, 0x1FB3, 0x00FF, 0x0178,
+	0x05D0, 0x05D1, 0x0627, 0x0628, 0x0661, 0x0669, 0x06F1, 0x200F, 0x200E, 0x202B, 0x202C, 0x2066, 0x2069,
+	0x200D, 0x200C, 0x2060, 0xFEFF, 0x061C, 0x0009, 0x000D, 0x0085, 0x2028, 0x2029,
+	0x00B7, 0x0375, 0x05F3, 0x05F4, 0x30FB, 0x0660, 0x06F0, 0x0640,
+	0x4E00, 0x9FFF, 0x3042, 0x30AB, 0x30F4, 0x3099, 0x309A, 0xFF9E, 0xFF9F, 0x3000, 0xFF01, 0xFF61, 0xFFE0,
+	0x1F600, 0x1F1E6, 0x1F3FB, 0xE000, 0xF8FF, 0xFFFD, 0xFFFE, 0x10FFFF, 0x0000, 0x007F,
+	0x0130, 0x0131, 0x0049, 0x0069, 0x0307, 0x0308, 0x00CD, 0x0128, 0x012E, 0x0116, 0x0041,
+}
+
+var assigned15 = rangetable.Assigned("15.0.0")
+
+// assignedRune draws a rune assigned in Unicode 15.0 (known to Python 3.12 and
+// to x/text alike), never a surrogate.
+func assignedRune(tc hegel.TestCase) rune {
+	for i := 0; i < 50; i++ {
+		var r rune
+		switch n(tc, 1, 10) {
+		case 1, 2, 3, 4, 5:
+			r = rune(n(tc, 0, 0x3000))
+		case 6, 7:
+			r = rune(n(tc, 0x3000, 0xFFFF))
+		default:
+			r = rune(n(tc, 0x10000, 0x10FFFF))
+		}
+		if unicode.Is(assigned15, r) && !(r >= 0xD800 && r <= 0xDFFF) {
+			return r
+		}
+	}
+	return 'x'
+}
+
+// anyRune draws from the interesting runes and from the assigned ones; with
+// wide, also from all of the code space.
+func anyRune(tc hegel.TestCase, wide bool) rune {
+	switch n(tc, 1, 10) {
+	case 1, 2, 3, 4, 5:
+		return pick(tc, interestingRunes...)
+	case 6:
+		return rune(n(tc, 'a', 'e'))
+	case 7, 8:
+		return assignedRune(tc)
+	default:
+		if wide {
+			r := rune(n(tc, 0, 0x10FFFF))
+			if r >= 0xD800 && r <= 0xDFFF {
+				r = 0xFFFD
+			}
+			return r
+		}
+		return assignedRune(tc)
+	}
+}
+
+// text15 draws lo..hi runes assigned in Unicode 15.0 (valid UTF-8).
+func text15(tc hegel.TestCase, lo, hi int) string {
+	k := n(tc, lo, hi)
+	rs := make([]rune, 0, k)
+	for i := 0; i < k; i++ {
+		rs = append(rs, anyRune(tc, false))
+	}
+	return string(rs)
+}
+
+// bytesAny draws a byte string: valid UTF-8 from any code point, with a few
+// ill-formed sequences injected now and then.
+func bytesAny(tc hegel.TestCase, lo, hi int) []byte {
+	k := n(tc, lo, hi)
+	var b []byte
+	for i := 0; i < k; i++ {
+		if chance(tc, 8) {
+			b = append(b, pick(tc, []byte{0x80}, []byte{0xC0, 0x80}, []byte{0xE2, 0x82}, []byte{0xF4, 0x90, 0x80, 0x80}, []byte{0xED, 0xA0, 0x80}, []byte{0xFF}, []byte{0xC3})...)
+			continue
+		}
+		b = utf8.AppendRune(b, anyRune(tc, true))
+	}
+	return b
+}
+
+// ---------------------------------------------------------------------------
+// Driving a transform.Transformer by the letter of its contract.
+
+var errNoProgress = errors.New("Transform made no progress with a large destination")
+
+// drive feeds src to t in pieces of at most chunk bytes (growing the piece on
+// ErrShortSrc) through a destination buffer of dstSize bytes (doubled when a
+// call makes no progress with ErrShortDst), and returns the concatenated
+// output. It checks the contract: a nil error means nSrc == len(src), and
+// ErrShortSrc is never returned with atEOF.
+func drive(t transform.Transformer, src []byte, chunk, dstSize int) ([]byte, error) {
+	t.Reset()
+	var out []byte
+	dst := make([]byte, dstSize)
+	pos, span := 0, chunk
+	for steps := 0; ; steps++ {
+		if steps > 20000 {
+			return out, errNoProgress
+		}
+		end := pos + span
+		if end > len(src) {
+			end = len(src)
+		}
+		atEOF := end == len(src)
+		nDst, nSrc, err := t.Transform(dst, src[pos:end], atEOF)
+		if nDst > len(dst) || nSrc > end-pos || nDst < 0 || nSrc < 0 {
+			return out, fmt.Errorf("Transform returned nDst=%d nSrc=%d for len(dst)=%d len(src)=%d", nDst, nSrc, len(dst), end-pos)
+		}
+		out = append(out, dst[:nDst]...)
+		pos += nSrc
+		switch err {
+		case nil:
+			if nSrc != end-pos+nSrc {
+				return out, fmt.Errorf("nil error with nSrc=%d < len(src)=%d", nSrc, end-pos+nSrc)
+			}
+			if atEOF {
+				return out, nil
+			}
+			span = chunk
+		case transform.ErrShortDst:
+			if nDst == 0 && nSrc == 0 {
+				if len(dst) > 1<<20 {
+					return out, errNoProgress
+				}
+				dst = make([]byte, 2*len(dst))
+			}
+		case transform.ErrShortSrc:
+			if atEOF {
+				return out, errors.New("ErrShortSrc returned with atEOF")
+			}
+			span = end - pos + chunk
+			if nSrc == 0 && nDst == 0 && span > len(src)-pos+chunk {
+				return out, errNoProgress
+			}
+		default:
+			return out, err
+		}
+	}
+}
+
+// chunkedReader returns at most k bytes per Read.
+type chunkedReader struct {
+	r io.Reader
+	k int
+}
+
+func (c *chunkedReader) Read(p []byte) (int, error) {
+	if len(p) > c.k {
+		p = p[:c.k]
+	}
+	return c.r.Read(p)
+}
+
+// viaReader runs t through transform.NewReader over a source that yields k
+// bytes at a time, reading with buffers of size m.
+func viaReader(t transform.Transformer, src []byte, k, m int) ([]byte, error) {
+	t.Reset()
+	r := transform.NewReader(&chunkedReader{bytes.NewReader(src), k}, t)
+	var out []byte
+	buf := make([]byte, m)
+	for i := 0; i < 1000000; i++ {
+		nr, err := r.Read(buf)
+		out = append(out, buf[:nr]...)
+		if err == io.EOF {
+			return out, nil
+		}
+		if err != nil {
+			return out, err
+		}
+	}
+	return out, errNoProgress
+}
+
+// viaWriter runs t through transform.NewWriter with writes of k bytes.
+func viaWriter(t transform.Transformer, src []byte, k int) ([]byte, error) {
+	t.Reset()
+	var buf bytes.Buffer
+	w := transform.NewWriter(&buf, t)
+	for i := 0; i < len(src); i += k {
+		j := i + k
+		if j > len(src) {
+			j = len(src)
+		}
+		if _, err := w.Write(src[i:j]); err != nil {
+			return buf.Bytes(), err
+		}
+	}
+	if err := w.Close(); err != nil {
+		return buf.Bytes(), err
+	}
+	return buf.Bytes(), nil
+}
diff --git a/hegel/hegel_lang_test.go b/hegel/hegel_lang_test.go
new file mode 100644
index 0000000..9bc7e89
--- /dev/null
+++ b/hegel/hegel_lang_test.go
@@ -0,0 +1,596 @@
+package hegel
+
+// language, collate, search and currency against their documentation, BCP 47
+// and UTS #35.
+
+import (
+	"bytes"
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"golang.org/x/text/collate"
+	"golang.org/x/text/currency"
+	"golang.org/x/text/language"
+	"golang.org/x/text/search"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	bases    = []string{"en", "de", "fr", "es", "pt", "zh", "ja", "ar", "he", "sr", "az", "nl", "da", "sv", "tr", "ru", "und", "hi", "kk", "nan", "cmn", "tlh"}
+	scripts  = []string{"Latn", "Cyrl", "Hans", "Hant", "Arab", "Hebr", "Deva", "Jpan", "Zzzz", "Qaaa"}
+	regions  = []string{"US", "GB", "DE", "FR", "CH", "AT", "BR", "PT", "CN", "TW", "419", "001", "150", "ZZ", "XA"}
+	variants = []string{"1996", "1901", "nedis", "rozaj", "fonipa", "valencia", "1994", "biske"}
+	ukeys    = []string{"co", "ca", "nu", "cu", "rg", "va", "kb", "kn", "hc"}
+	utypes   = []string{"phonebk", "emoji", "gregory", "latn", "usd", "gbzzzz", "posix", "true", "h12", "arab"}
+)
+
+// composeTag draws a tag from parts and returns it with the pieces that went
+// in, so the property knows what to expect.
+type tagParts struct {
+	base, script, region string
+	variants             []string
+	uext                 map[string]string
+	attrs                []string
+	priv                 string
+}
+
+func (p tagParts) String() string {
+	var sb strings.Builder
+	sb.WriteString(p.base)
+	if p.script != "" {
+		sb.WriteString("-" + p.script)
+	}
+	if p.region != "" {
+		sb.WriteString("-" + p.region)
+	}
+	for _, v := range p.variants {
+		sb.WriteString("-" + v)
+	}
+	if len(p.uext) > 0 || len(p.attrs) > 0 {
+		sb.WriteString("-u")
+		for _, a := range p.attrs {
+			sb.WriteString("-" + a)
+		}
+		keys := make([]string, 0, len(p.uext))
+		for k := range p.uext {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			sb.WriteString("-" + k)
+			if p.uext[k] != "true" {
+				sb.WriteString("-" + p.uext[k])
+			}
+		}
+	}
+	if p.priv != "" {
+		sb.WriteString("-x-" + p.priv)
+	}
+	return sb.String()
+}
+
+func drawTag(tc hegel.TestCase) tagParts {
+	p := tagParts{base: pick(tc, bases...)}
+	if chance(tc, 30) {
+		p.script = pick(tc, scripts...)
+	}
+	if chance(tc, 50) {
+		p.region = pick(tc, regions...)
+	}
+	k := n(tc, 0, 2)
+	seen := map[string]bool{}
+	for i := 0; i < k; i++ {
+		v := pick(tc, variants...)
+		if !seen[v] {
+			seen[v] = true
+			p.variants = append(p.variants, v)
+		}
+	}
+	if chance(tc, 40) {
+		p.uext = map[string]string{}
+		m := n(tc, 1, 3)
+		for i := 0; i < m; i++ {
+			k, v := pick(tc, ukeys...), pick(tc, utypes...)
+			if v == "true" && k != "kb" && k != "kn" {
+				v = "latn"
+			}
+			p.uext[k] = v
+		}
+	}
+	if chance(tc, 10) {
+		p.attrs = []string{pick(tc, "abcd", "abce", "attr", "zzz", "aaa")}
+		if p.uext == nil {
+			p.uext = map[string]string{}
+		}
+	}
+	if chance(tc, 15) {
+		p.priv = pick(tc, "priv", "foo", "a1")
+	}
+	return p
+}
+
+// Parsing a well-formed tag and printing it gives the tag back with its parts
+// intact; the -u extension survives SetTypeForKey/TypeForKey; the base, script
+// and region subtags parse on their own; EncodeM49 and ISO3 round-trip.
+func TestHegelLanguageTagsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := drawTag(ht)
+		s := p.String()
+		tag, err := language.Parse(s)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", s, err)
+		}
+		// Tags holding a non-compact tag compare by pointer; compare strings.
+		back, err := language.Parse(tag.String())
+		if err != nil || back.String() != tag.String() {
+			fail(ht, "Parse(%q) = %v, Parse of its String %q = %v, %v", s, tag, tag.String(), back, err)
+		}
+		// Variants are kept (in canonical order, deduplicated) and so are the
+		// extensions.
+		var vs []string
+		for _, v := range tag.Variants() {
+			vs = append(vs, v.String())
+		}
+		sort.Strings(vs)
+		want := append([]string{}, p.variants...)
+		sort.Strings(want)
+		wantExt := 0
+		if len(p.uext) > 0 || len(p.attrs) > 0 {
+			wantExt++
+		}
+		if p.priv != "" {
+			wantExt++
+		}
+		if strings.Join(vs, ",") != strings.Join(want, ",") || len(tag.Extensions()) != wantExt {
+			// Bug 6: variants that had to be reordered swallow the extension.
+			if Known.SortedVariantsExtension && len(p.variants) == 2 && wantExt > 0 {
+				count(ht, "known x-text/6")
+				return
+			}
+			fail(ht, "Parse(%q): variants %v (expected %v), extensions %v", s, vs, want, tag.Extensions())
+		}
+		for k, v := range p.uext {
+			if got := tag.TypeForKey(k); got != v {
+				// Bug 11: a boolean key without a type has no type either.
+				if Known.BoolKeyWithoutType && v == "true" && got == "" {
+					count(ht, "known x-text/11")
+					return
+				}
+				fail(ht, "Parse(%q).TypeForKey(%q) = %q, expected %q", s, k, got, v)
+			}
+		}
+		// SetTypeForKey then TypeForKey, in any case.
+		k, v := pick(ht, ukeys...), pick(ht, utypes...)
+		if chance(ht, 30) {
+			k = strings.ToUpper(k)
+		}
+		if chance(ht, 30) {
+			v = strings.ToUpper(v)
+		}
+		t2, err := tag.SetTypeForKey(k, v)
+		if err != nil {
+			fail(ht, "%v.SetTypeForKey(%q, %q): %v", tag, k, v, err)
+		}
+		lk, lv := strings.ToLower(k), strings.ToLower(v)
+		if got := t2.TypeForKey(lk); got != lv {
+			if Known.SetTypeForKeyCase && (k != lk || v != lv) {
+				count(ht, "known x-text/16")
+				return
+			}
+			fail(ht, "%v.SetTypeForKey(%q, %q) = %v, TypeForKey(%q) = %q", tag, k, v, t2, lk, got)
+		}
+		if p2, err := language.Parse(t2.String()); err != nil || p2.String() != t2.String() {
+			if Known.SetTypeForKeyCase && (k != lk || v != lv) {
+				count(ht, "known x-text/16")
+				return
+			}
+			fail(ht, "%v.SetTypeForKey(%q, %q) = %v, whose string parses to %v, %v", tag, k, v, t2, p2, err)
+		}
+		// Two attribute orders are one tag.
+		if len(p.attrs) == 1 {
+			other := pick(ht, "abcd", "abce", "attr", "zzz", "aaa")
+			if other != p.attrs[0] {
+				a := strings.Replace(s, "-u-"+p.attrs[0], "-u-"+p.attrs[0]+"-"+other, 1)
+				b := strings.Replace(s, "-u-"+p.attrs[0], "-u-"+other+"-"+p.attrs[0], 1)
+				ta, ea := language.Parse(a)
+				tb, eb := language.Parse(b)
+				if ea != nil || eb != nil || ta.String() != tb.String() {
+					if Known.AttributeSort3 && other[:3] == p.attrs[0][:3] {
+						count(ht, "known x-text/17")
+						return
+					}
+					fail(ht, "Parse(%q) = %v, %v but Parse(%q) = %v, %v", a, ta, ea, b, tb, eb)
+				}
+			}
+		}
+		// Subtags on their own.
+		b, sc, r := tag.Raw()
+		if p.base != "und" {
+			if pb, err := language.ParseBase(p.base); err != nil || pb != b {
+				count(ht, "base-canonicalised") // nan, cmn, tlh: Parse and ParseBase may canonicalise differently
+			}
+			if pb, err := language.ParseBase(b.ISO3()); err != nil || pb != b {
+				if Known.ParseBaseDeprecated && (b.String() == "he" || b.String() == "id" || b.String() == "jv" || b.String() == "yi") {
+					count(ht, "known x-text/18")
+					return
+				}
+				fail(ht, "ParseBase(%q.ISO3() = %q) = %v, %v", b, b.ISO3(), pb, err)
+			}
+		}
+		if p.script != "" {
+			if ps, err := language.ParseScript(p.script); err != nil || ps != sc {
+				fail(ht, "ParseScript(%q) = %v, %v; Raw gives %v", p.script, ps, err, sc)
+			}
+			if s2, conf := tag.Script(); s2 != sc || conf != language.Exact {
+				fail(ht, "%v.Script() = %v, %v with an explicit script", tag, s2, conf)
+			}
+		}
+		if p.region != "" {
+			if pr, err := language.ParseRegion(p.region); err != nil || pr != r {
+				fail(ht, "ParseRegion(%q) = %v, %v; Raw gives %v", p.region, pr, err, r)
+			}
+			if r2, conf := tag.Region(); r2 != r || conf != language.Exact {
+				fail(ht, "%v.Region() = %v, %v with an explicit region", tag, r2, conf)
+			}
+			if m := r.M49(); m != 0 {
+				if er, err := language.EncodeM49(m); err != nil || er != r {
+					count(ht, "m49-alias")
+				}
+			}
+		}
+		// Parent chains end at und.
+		for i, x := 0, tag; ; i++ {
+			if x.IsRoot() {
+				break
+			}
+			if i > 10 {
+				fail(ht, "%v: Parent chain does not reach und", tag)
+			}
+			x = x.Parent()
+		}
+	})
+}
