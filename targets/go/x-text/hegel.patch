+package hegel
+
+// Pins for the language, collate, search, currency and display bugs.
+
+import (
+	"bytes"
+	"sort"
+	"testing"
+
+	"golang.org/x/text/collate"
+	"golang.org/x/text/currency"
+	"golang.org/x/text/language"
+	"golang.org/x/text/language/display"
+	"golang.org/x/text/search"
+)
+
+// x-text/6
+func TestHegelPinSortedVariantsKeepTheirExtension(t *testing.T) {
+	tag, err := language.Parse("de-1996-1901-u-co-phonebk")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := tag.String(); got != "de-1901-1996-u-co-phonebk" || tag.TypeForKey("co") != "phonebk" || len(tag.Variants()) != 2 || len(tag.Extensions()) != 1 {
+		t.Errorf("de-1996-1901-u-co-phonebk parses to %q with variants %v, extensions %v, co=%q", got, tag.Variants(), tag.Extensions(), tag.TypeForKey("co"))
+	}
+	tag, err = language.Parse("en-nedis-nedis-a-foo")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := tag.String(); got != "en-nedis-a-foo" {
+		t.Errorf("en-nedis-nedis-a-foo parses to %q (variants %v, extensions %v)", got, tag.Variants(), tag.Extensions())
+	}
+}
+
+// x-text/7
+func TestHegelPinTExtensionFieldsAfterTlang(t *testing.T) {
+	for _, s := range []string{"ja-t-it-m0-ungegn", "en-t-de-h0-hybrid"} {
+		tag, err := language.Parse(s)
+		if err != nil || tag.String() != s {
+			t.Errorf("Parse(%q) = %q, %v", s, tag, err)
+		}
+	}
+	if _, err := language.ParseExtension("t-en-h0-hybrid"); err != nil {
+		t.Errorf("ParseExtension(t-en-h0-hybrid): %v", err)
+	}
+}
+
+// x-text/8
+func TestHegelPinShiftedCollatorStillComparesLetters(t *testing.T) {
+	c := collate.New(language.MustParse("und-u-ka-shifted"))
+	if c.CompareString("a", "b") != -1 || c.CompareString("abc", "xyz") != -1 {
+		t.Errorf("und-u-ka-shifted: Compare(a, b) = %d, Compare(abc, xyz) = %d", c.CompareString("a", "b"), c.CompareString("abc", "xyz"))
+	}
+}
+
+// x-text/9
+func TestHegelPinIgnoreWidthEquatesWidths(t *testing.T) {
+	c := collate.New(language.Und, collate.IgnoreWidth)
+	if a, b, d := c.CompareString("a", "ａ"), c.CompareString("ｶ", "カ"), c.CompareString("1", "１"); a != 0 || b != 0 || d != 0 {
+		t.Errorf("IgnoreWidth: a/fullwidth a %d, halfwidth/fullwidth ka %d, 1/fullwidth 1 %d", a, b, d)
+	}
+}
+
+// x-text/10
+func TestHegelPinForceIsInTheKey(t *testing.T) {
+	c := collate.New(language.Und, collate.Force)
+	var buf collate.Buffer
+	k1 := append([]byte{}, c.KeyFromString(&buf, "é")...)
+	k2 := c.KeyFromString(&buf, "é")
+	if c.CompareString("é", "é") != 0 && bytes.Equal(k1, k2) {
+		t.Errorf("Force: Compare distinguishes the two spellings but the keys are equal (%x)", k1)
+	}
+	c2 := collate.New(language.Und, collate.Force, collate.Loose)
+	s := []string{"B", "b"}
+	c2.SortStrings(s)
+	if c2.CompareString(s[0], s[1]) > 0 {
+		t.Errorf("Force+Loose: SortStrings gives %v but Compare(%q, %q) = %d", s, s[0], s[1], c2.CompareString(s[0], s[1]))
+	}
+}
+
+// x-text/11
+func TestHegelPinBooleanCollationKeyWithoutType(t *testing.T) {
+	implicit := collate.New(language.MustParse("fr-u-kb")).CompareString("côte", "coté")
+	explicit := collate.New(language.MustParse("fr-u-kb-true")).CompareString("côte", "coté")
+	if implicit != explicit {
+		t.Errorf("fr-u-kb compares cote/cote as %d, fr-u-kb-true as %d", implicit, explicit)
+	}
+}
+
+// x-text/12
+func TestHegelPinSearchWholeWordAndExactAreOptions(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("search.New with WholeWord/Exact panics: %v", r)
+		}
+	}()
+	search.New(language.English, search.WholeWord)
+	search.New(language.English, search.Exact)
+}
+
+// x-text/13
+func TestHegelPinSearchBackwardsIsImplemented(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("IndexString with Backwards panics: %v", r)
+		}
+	}()
+	if s, e := search.New(language.English).IndexString("abcb", "b", search.Backwards); s != 3 || e != 4 {
+		t.Errorf("IndexString(abcb, b, Backwards) = %d, %d", s, e)
+	}
+}
+
+// x-text/14
+func TestHegelPinSearchEqualIsReflexive(t *testing.T) {
+	m := search.New(language.English)
+	if !m.EqualString("", "") {
+		t.Errorf("Equal(\"\", \"\") is false")
+	}
+	if s, e := m.IndexString("abc", ""); s != 0 || e != 0 {
+		t.Errorf("Index(abc, \"\") = %d, %d", s, e)
+	}
+	if !m.EqualString("́", "́") {
+		t.Errorf("Equal(U+0301, U+0301) is false")
+	}
+}
+
+// x-text/15
+func TestHegelPinDanishAarhus(t *testing.T) {
+	m := search.New(language.Danish)
+	if !m.EqualString("Århus", "Aarhus") {
+		t.Errorf("search.New(Danish).Equal(Aarhus with A-ring, Aarhus) is false (the package doc's example)")
+	}
+}
+
+// x-text/16
+func TestHegelPinSetTypeForKeyIsCaseInsensitive(t *testing.T) {
+	tag, err := language.Make("en").SetTypeForKey("co", "ABC")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, _ := language.Parse(tag.String())
+	if tag.String() != "en-u-co-abc" || p != tag {
+		t.Errorf("SetTypeForKey(co, ABC) = %q, Parse of it %q", tag, p)
+	}
+	tag, err = language.Make("en").SetTypeForKey("CO", "abc")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tag.TypeForKey("co") != "abc" {
+		t.Errorf("SetTypeForKey(CO, abc) = %q, TypeForKey(co) = %q", tag, tag.TypeForKey("co"))
+	}
+}
+
+// x-text/17
+func TestHegelPinUnicodeAttributesSortFully(t *testing.T) {
+	a, b := language.Make("en-u-abce-abcd"), language.Make("en-u-abcd-abce")
+	if a != b || a.String() != "en-u-abcd-abce" {
+		t.Errorf("en-u-abce-abcd -> %q, en-u-abcd-abce -> %q", a, b)
+	}
+}
+
+// x-text/18
+func TestHegelPinParseBaseUsesThePreferredCode(t *testing.T) {
+	for _, iso3 := range []string{"heb", "ind", "jav", "yid"} {
+		b, err := language.ParseBase(iso3)
+		if err != nil {
+			t.Fatal(err)
+		}
+		tag := language.Make(iso3)
+		if b.String() != tag.String() || len(b.String()) != 2 || b.String() == "iw" || b.String() == "in" || b.String() == "jw" || b.String() == "ji" {
+			t.Errorf("ParseBase(%s) = %q, Make(%s) = %q", iso3, b, iso3, tag)
+		}
+		back, _ := language.ParseBase(b.ISO3())
+		if back != b {
+			t.Errorf("ParseBase(%q.ISO3() = %q) = %q", b, b.ISO3(), back)
+		}
+	}
+}
+
+// x-text/19
+func TestHegelPinMatchKeepsTheDesiredRegionOverride(t *testing.T) {
+	m := language.NewMatcher([]language.Tag{language.Make("de"), language.Make("en")})
+	tag, _, _ := m.Match(language.Make("de-AT-u-rg-chzzzz"))
+	if tag.TypeForKey("rg") != "chzzzz" {
+		t.Errorf("Match(de-AT-u-rg-chzzzz) = %q, rg = %q", tag, tag.TypeForKey("rg"))
+	}
+}
+
+// x-text/20
+func TestHegelPinCurrencyFromTagHonoursRg(t *testing.T) {
+	u, _ := currency.FromTag(language.MustParse("en-US-u-rg-gbzzzz"))
+	if u != currency.GBP {
+		t.Errorf("FromTag(en-US-u-rg-gbzzzz) = %v", u)
+	}
+}
+
+// x-text/21
+func TestHegelPinEncodeM49ErrorNamesTheCode(t *testing.T) {
+	_, err := language.EncodeM49(1000)
+	if err == nil {
+		t.Fatal("EncodeM49(1000) succeeds")
+	}
+	if ve, ok := err.(language.ValueError); !ok || ve.Subtag() != "1000" {
+		t.Errorf("EncodeM49(1000): %v, subtag %q", err, subtagOf(err))
+	}
+}
+
+func subtagOf(err error) string {
+	if ve, ok := err.(language.ValueError); ok {
+		return ve.Subtag()
+	}
+	return ""
+}
+
+// x-text/22
+func TestHegelPinDisplayNamesAzArab(t *testing.T) {
+	tag := language.Make("az-Arab")
+	if got := display.Languages(language.English).Name(tag); got != "Azerbaijani" {
+		t.Errorf("Languages(English).Name(az-Arab) = %q", got)
+	}
+	if got := display.Tags(language.English).Name(tag); got != "Azerbaijani (Arabic)" {
+		t.Errorf("Tags(English).Name(az-Arab) = %q", got)
+	}
+}
+
+// x-text/23
+func TestHegelPinPrivateUseTagHasNoScriptOrRegion(t *testing.T) {
+	tag := language.Make("x-foo")
+	if _, c := tag.Script(); c != language.No {
+		t.Errorf("x-foo: Script confidence %v", c)
+	}
+	if _, c := tag.Region(); c != language.No {
+		t.Errorf("x-foo: Region confidence %v", c)
+	}
+}
