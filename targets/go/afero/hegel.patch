@@ -0,0 +1,201 @@
+package hegel
+
+// Hegel properties for github.com/spf13/afero: MemMapFs against an OsFs
+// confined to a temporary directory, the package-level helpers against os
+// and path/filepath, and the wrapping file systems (ReadOnlyFs,
+// CopyOnWriteFs, CacheOnReadFs, RegexpFs, BasePathFs, IOFS) against small
+// models. No external tools.
+//
+// Every property draws one case record (a tree to build and a list of
+// operations) from generator values and applies it with positions taken
+// modulo the live tree, so a step that does not fit the state is a no-op the
+// shrinker can delete. The recorded bugs (bugs.toml) are reached by default:
+// a step whose shape is a recorded bug runs, and a mismatch names the bug.
+// With HEGEL_NO_KNOWN=1 such steps are no-ops (or the shape is left out of
+// the generator) and the recorded outcomes are accepted, so the properties
+// must pass; see known.go.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing (shared with the other Go targets of the zoo).
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the no-op steps and accepted outcomes of each property so a
+// run shows how often the known-bug gates fire (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+// property runs fn as a Hegel property with the harness options (opts are
+// added; the narrow properties stop at their first failure).
+func property(t *testing.T, fn func(ht *hegel.T), opts ...hegel.Option) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			if controlFlow(r) {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("PANIC in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, append(hegelOpts(), opts...)...)
+}
+
+// controlFlow reports whether a recovered value is Hegel's own (a Fatalf,
+// an Assume, libhegel's stop), which must propagate.
+func controlFlow(r any) bool {
+	if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+		return true
+	}
+	tn := reflect.TypeOf(r).String()
+	return strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.")
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms (the same in the other Go targets of the zoo).
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted draws one of the alternatives with probability proportional to
+// its weight. The first alternative is the shrink target, so it should be
+// the plainest one.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(x int) hegel.Generator[T] {
+		for _, c := range choices {
+			if x < c.weight {
+				return c.gen
+			}
+			x -= c.weight
+		}
+		return choices[len(choices)-1].gen
+	})
+}
+
+// chance is a biased coin that shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// many draws lo..hi values of g.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions are indices taken modulo a live size when a case is applied.
+var positions = hegel.Integers(0, 99)
+
+// at picks the element of xs at a drawn position (modulo the live size).
+func at[T any](xs []T, pos int) T { return xs[pos%len(xs)] }
+
+// shaped picks the generator for the current mode: withBugs draws the shapes
+// of the recorded bugs too, without leaves them out (HEGEL_NO_KNOWN=1).
+func shaped[T any](withBugs, without hegel.Generator[T]) hegel.Generator[T] {
+	if noKnown {
+		return without
+	}
+	return withBugs
+}
+
+// join renders drawn pieces as one string (a Map over many).
+func join(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
