+package hegel
+
+// One narrow property per recorded bug (bugs.toml): each draws the bug's
+// shape region with random contents (a drawn tree, the construct placed in a
+// drawn directory of it with drawn names, decorations, modes and data, and
+// drawn read-only steps before it) and checks it with the very helpers of the
+// wide property that meets the bug, so it fails on every run while the bug
+// exists and shrinks to the bug's minimal shape. Under HEGEL_NO_KNOWN=1 the
+// region is the recorded bug itself, so the property is skipped.
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"os/exec"
+	"path"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"github.com/spf13/afero"
+	"hegel.dev/go/hegel"
+)
+
+// shapeProperty runs a narrow property: skipped while the bugs are switched
+// off, stopping at the first failure otherwise (one bug, one failure).
+func shapeProperty(t *testing.T, id string, fn func(ht *hegel.T)) {
+	t.Helper()
+	if noKnown {
+		t.Skipf("%s: the shape region is the recorded bug, left out under HEGEL_NO_KNOWN=1", id)
+	}
+	property(t, fn, hegel.WithReportMultipleFailures(false))
+}
+
+// dirShape runs a narrow property whose cases each get a fresh directory.
+func dirShape(t *testing.T, id string, fn func(ht *hegel.T, dir string)) {
+	t.Helper()
+	root := ""
+	shapeProperty(t, id, func(ht *hegel.T) {
+		if root == "" {
+			r, err := os.MkdirTemp("", "hegel-afero-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			root = r
+			t.Cleanup(func() { os.RemoveAll(r) })
+		}
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		fn(ht, dir)
+	})
+}
+
+// shapeNames are the names of the construct entries: disjoint from treeNames,
+// so a construct never lands on an entry of the drawn tree.
+var shapeNames = []string{"s", "t", "u", "s.txt", "t-u", "u y"}
+
+var shapeName = hegel.SampledFrom(shapeNames)
+
+// otherName draws a construct name different from taken.
+func otherName(ht *hegel.T, taken string) string {
+	var pool []string
+	for _, n := range shapeNames {
+		if n != taken {
+			pool = append(pool, n)
+		}
+	}
+	return hegel.Draw(ht, hegel.SampledFrom(pool))
+}
+
+// spec is the literal pathSpec of a canonical path with a decoration.
+func spec(p, deco string) pathSpec {
+	return pathSpec{Below: -1, Parts: strings.Split(strings.TrimPrefix(p, "/"), "/"), Deco: deco}
+}
+
+var nonEmptyData = many(dataAlphabet, 1, 12)
+
+// quietSteps are 0..2 read-only steps of the MemMapFs script (no shape).
+var quietSteps = many(weighted(
+	choice[memStep]{2, step("Stat", nil)},
+	choice[memStep]{1, step("ReadDir", nil)},
+	choice[memStep]{1, step("Chtimes", func(tc hegel.TestCase, s *memStep) {
+		s.When = int64(hegel.Draw(tc, hegel.Integers(0, 2_000_000_000)))
+	})},
+), 0, 2)
+
+// ---------------------------------------------------------------------------
+// MemMapFs regions: a pair (MemMapFs, OsFs in a fresh directory) holding a
+// drawn tree, the construct below a drawn directory of it (the spot).
+
+type memRun struct {
+	p       *pair
+	dirs    []string
+	files   []string
+	content map[string][]byte
+	spot    string
+}
+
+func newMemRun(ht *hegel.T, dir string) *memRun {
+	p := &pair{ht: ht, mem: afero.NewMemMapFs(), os: afero.NewBasePathFs(afero.NewOsFs(), dir)}
+	r := &memRun{p: p}
+	r.dirs, r.files, r.content = hegel.Draw(ht, treeSpecs).build(p.mem, p.os)
+	r.spot = at(r.dirs, hegel.Draw(ht, positions))
+	return r
+}
+
+// memShape runs a narrow MemMapFs property: fn gets a fresh run per case.
+func memShape(t *testing.T, id string, fn func(ht *hegel.T, r *memRun)) {
+	t.Helper()
+	dirShape(t, id, func(ht *hegel.T, dir string) {
+		r := newMemRun(ht, dir)
+		defer r.p.recoverPanics()
+		fn(ht, r)
+	})
+}
+
+// fresh draws a fresh path below the spot.
+func (r *memRun) fresh(ht *hegel.T) string { return childOf(r.spot, hegel.Draw(ht, shapeName)) }
+
+// mkdir creates a construct directory on both file systems.
+func (r *memRun) mkdir(p string) {
+	for _, f := range []afero.Fs{r.p.mem, r.p.os} {
+		if err := f.MkdirAll(p, 0o755); err != nil {
+			panic(err)
+		}
+	}
+	r.dirs = append(r.dirs, p)
+	sort.Strings(r.dirs)
+}
+
+// write creates a construct file on both file systems.
+func (r *memRun) write(p string, data []byte, perm os.FileMode) {
+	for _, f := range []afero.Fs{r.p.mem, r.p.os} {
+		if err := afero.WriteFile(f, p, data, 0o644); err != nil {
+			panic(err)
+		}
+		if perm != 0o644 {
+			if err := f.Chmod(p, perm); err != nil {
+				panic(err)
+			}
+		}
+	}
+	r.files = append(r.files, p)
+	sort.Strings(r.files)
+	r.content[p] = data
+}
+
+// run applies a step to both file systems and compares the trees.
+func (r *memRun) run(s memStep) bool { return r.p.step(s) && r.p.checkTrees() }
+
+// quiet applies drawn read-only steps before the construct.
+func (r *memRun) quiet(ht *hegel.T) bool {
+	for _, s := range hegel.Draw(ht, quietSteps) {
+		if !r.run(s) {
+			return false
+		}
+	}
+	return true
+}
