+		defer c.p.recoverPanics()
+		f := "/" + hegel.Draw(ht, shapeName)
+		c.addFile(f, hegel.Draw(ht, dataBytes), perm)
+		c.run(wrapStep{Op: "CreateWrite", Data: data}, f, "")
+	})
+}
