+)
+
+func osPair(t *testing.T) (base, layer afero.Fs) {
+	dir := t.TempDir()
+	os.Mkdir(dir+"/base", 0o755)
+	os.Mkdir(dir+"/layer", 0o755)
+	return afero.NewBasePathFs(afero.NewOsFs(), dir+"/base"), afero.NewBasePathFs(afero.NewOsFs(), dir+"/layer")
+}
+
+// afero/1
+func TestHegelPinMkdirNeedsItsParent(t *testing.T) {
+	m := afero.NewMemMapFs()
+	if err := m.Mkdir("/a/b", 0o755); err == nil {
+		t.Errorf("MemMapFs.Mkdir(/a/b) without /a succeeded (MkdirAll is the call that creates parents)")
+	}
+}
+
+// afero/2
