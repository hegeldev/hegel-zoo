+// ---------------------------------------------------------------------------
+// Helper regions: a helperRun holding a drawn tree plus the construct.
+
+type helperShape struct {
+	*helperRun
+	spot string
+}
+
+func newHelperShape(ht *hegel.T, dir string) *helperShape {
+	r := newHelperRun(ht, dir)
+	r.build(hegel.Draw(ht, treeSpecs))
+	return &helperShape{helperRun: r, spot: at(r.dirs, hegel.Draw(ht, positions))}
+}
+
+func (h *helperShape) fresh(ht *hegel.T) string { return childOf(h.spot, hegel.Draw(ht, shapeName)) }
+
+func (h *helperShape) addDir(p string) {
+	for _, f := range []afero.Fs{h.mem, h.osfs} {
+		if err := f.MkdirAll(p, 0o755); err != nil {
+			panic(err)
+		}
+	}
+	h.dirs = append(h.dirs, p)
+	sort.Strings(h.dirs)
+}
+
+func (h *helperShape) addFile(p string, data []byte) {
+	for _, f := range []afero.Fs{h.mem, h.osfs} {
+		if err := afero.WriteFile(f, p, data, 0o644); err != nil {
+			panic(err)
+		}
+	}
+	h.files = append(h.files, p)
+	sort.Strings(h.files)
+	h.content[p] = data
+}
+
+// index is the position of p in xs (a sorted list holding it).
+func index(xs []string, p string) int {
+	for i, x := range xs {
+		if x == p {
+			return i
+		}
+	}
+	panic("not in the list: " + p)
+}
+
+func helperShapeProperty(t *testing.T, id string, fn func(ht *hegel.T, h *helperShape)) {
+	t.Helper()
+	dirShape(t, id, func(ht *hegel.T, dir string) {
+		h := newHelperShape(ht, dir)
+		defer h.p.recoverPanics()
+		fn(ht, h)
+	})
+}
