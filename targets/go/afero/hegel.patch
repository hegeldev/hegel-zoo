+	base, layer := afero.NewMemMapFs(), afero.NewMemMapFs()
+	base.MkdirAll("/d", 0o755)
+	layer.MkdirAll("/d", 0o755)
+	cow := afero.NewCopyOnWriteFs(base, layer)
+	f, err := cow.Open("/d")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Errorf("UnionFile.Close() = %v after closing both files", err)
+	}
+	cache := afero.NewCacheOnReadFs(base, layer, 0)
+	afero.WriteFile(base, "/f", []byte("x"), 0o644)
+	afero.ReadFile(cache, "/f") // cache it
+	if err := afero.WriteFile(cache, "/f", []byte("y"), 0o644); err != nil {
+		t.Errorf("WriteFile through a CacheOnReadFs = %v although the file was written", err)
+	}
+}
