+				return false
+			}
+		}
+		var keep []rune
+		for _, r := range s.Name {
+			if unicode.IsLetter(r) || unicode.IsDigit(r) || unicode.IsMark(r) || strings.ContainsRune("./\\_-% #", r) {
+				keep = append(keep, r)
+			}
+		}
+		if san != string(keep) {
