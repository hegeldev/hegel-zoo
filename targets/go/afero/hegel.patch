+		for _, r := range norm.NFD.String(s.Name) {
+			if !unicode.Is(unicode.Mn, r) {
+				want = append(want, r)
+			}
+		}
+		if neu != norm.NFC.String(string(want)) {
+			p.fail("NeuterAccents(%q) = %q, want %q", s.Name, neu, norm.NFC.String(string(want)))
+			return false
+		}
+	}
+	return true
+}
+
+// entries lists the directories and files of a built tree.
+func entries(dirs, files []string) []string {
+	out := append([]string(nil), dirs...)
+	return append(out, files...)
+}
+
+// walkList lists what Walk visits below q as "path dir=bool"; with f == nil
+// it uses filepath.Walk on the OS path and strips the prefix.
+func walkList(f afero.Fs, q, prefix string) ([]string, error) {
+	var out []string
+	fn := func(pth string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		out = append(out, fmt.Sprintf("%s dir=%v", canon(strings.TrimPrefix(pth, prefix)), info.IsDir()))
+		return nil
+	}
+	if f == nil {
+		return out, filepath.Walk(q, fn)
+	}
+	return out, afero.Walk(f, q, fn)
+}
