+// ---------------------------------------------------------------------------
+// CopyOnWriteFs regions: a cowRun whose base holds a drawn tree plus the
+// construct below a drawn directory of it (the spot).
+
+type cowShape struct {
+	*cowRun
+	dirs  []string
+	files []string
+	spot  string
+}
+
+func newCowShape(ht *hegel.T, dir string) *cowShape {
+	r := newCowRun(ht, dir)
+	dirs, files, _ := hegel.Draw(ht, treeSpecs).build(r.base)
+	return &cowShape{cowRun: r, dirs: dirs, files: files, spot: at(dirs, hegel.Draw(ht, positions))}
+}
+
+func cowShapeProperty(t *testing.T, id string, fn func(ht *hegel.T, c *cowShape)) {
+	t.Helper()
+	dirShape(t, id, func(ht *hegel.T, dir string) {
+		c := newCowShape(ht, dir)
+		defer c.p.recoverPanics()
+		fn(ht, c)
+	})
+}
+
+func (c *cowShape) fresh(ht *hegel.T) string { return childOf(c.spot, hegel.Draw(ht, shapeName)) }
+
+func (c *cowShape) baseDir(p string, perm os.FileMode) {
+	if err := c.base.MkdirAll(p, 0o755); err != nil {
+		panic(err)
+	}
+	if perm != 0o755 {
+		if err := c.base.Chmod(p, perm); err != nil {
+			panic(err)
+		}
+	}
+}
+
+func (c *cowShape) baseFile(p string, data []byte, perm os.FileMode) {
+	if err := afero.WriteFile(c.base, p, data, 0o644); err != nil {
+		panic(err)
+	}
+	if perm != 0o644 {
+		if err := c.base.Chmod(p, perm); err != nil {
+			panic(err)
+		}
+	}
+}
+
+// begin records the base in the model; mirrored, the spot and its ancestors
+// are created in the layer too (with the base's mode) and recorded, so a
+// write below the spot recreates nothing there (afero/34 stays out).
+func (c *cowShape) begin(mirrored bool) {
+	if mirrored && c.spot != "/" {
+		if err := c.layer.MkdirAll(c.spot, 0o755); err != nil {
+			panic(err)
+		}
+	}
+	c.start()
+	if mirrored {
+		for d := c.spot; d != "/"; d = path.Dir(d) {
+			e := *c.m.base[d]
+			c.m.layer[d] = &e
+		}
+	}
+}
+
+// run applies a step and, when it ran, the checks; false ends the case.
+func (c *cowShape) run(s wrapStep, q, q2 string) bool {
+	res := c.step(s, q, q2)
+	return res != stepFail && (res != stepRan || c.check())
+}
