+// The wrapping file systems: ReadOnlyFs, CopyOnWriteFs, CacheOnReadFs,
+// RegexpFs, BasePathFs and the io/fs adapter IOFS.
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path"
+	"regexp"
