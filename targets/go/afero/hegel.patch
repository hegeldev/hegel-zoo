+		}
+		f := r.fresh(ht)
+		r.write(f, hegel.Draw(ht, dataBytes), hegel.Draw(ht, readOnlyPerms))
+		var flags openFlags
+		var ops []handleOp
+		if hegel.Draw(ht, chance(30)) {
+			flags = openFlags{Acc: hegel.Draw(ht, hegel.SampledFrom([]int{accessRW, accessW})), Create: true, Excl: true}
+		} else {
+			flags = openFlags{Acc: accessR, Create: hegel.Draw(ht, chance(30))}
+			if hegel.Draw(ht, chance(30)) {
+				ops = []handleOp{{Op: "Stat"}}
+			}
+		}
+		r.run(memStep{Op: "OpenFile", Path: spec(f, hegel.Draw(ht, pathDecos)), Flags: flags, Perm: hegel.Draw(ht, filePerms), Handle: ops})
+	})
+}
