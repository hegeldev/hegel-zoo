+// Package hegel holds Hegel property-based tests for github.com/spf13/afero,
+// kept in the hegel zoo (github.com/hegeldev/hegel-zoo, targets/go/afero).
+//
+// The MemMapFs is compared with an OsFs restricted to a temporary directory
+// under the same random sequence of operations; the package-level helpers
+// are compared with os and path/filepath; the wrapping file systems
+// (ReadOnlyFs, CopyOnWriteFs, CacheOnReadFs, RegexpFs, BasePathFs) with
+// small models of their documented semantics; and the io/fs adapter with
+// testing/fstest. known.go lists the recorded bugs the properties gate on and
+// hegel_pins_test.go pins each of them.
+package hegel
diff --git a/hegel/hegel_memmap_test.go b/hegel/hegel_memmap_test.go
new file mode 100644
index 0000000..7d1c097
--- /dev/null
+++ b/hegel/hegel_memmap_test.go
@@ -0,0 +1,798 @@
+package hegel
+
+// MemMapFs against OsFs: the same random sequence of operations is applied
+// to a MemMapFs and to an OsFs restricted (BasePathFs) to a fresh temporary
+// directory; every result and, after every step, the visible tree must agree.
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"sort"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/spf13/afero"
+	"hegel.dev/go/hegel"
+)
+
+// errClass maps an error to the class the two file systems must agree on.
+func errClass(err error) string {
+	switch {
+	case err == nil:
+		return "ok"
+	case errors.Is(err, io.EOF):
+		return "eof"
+	case errors.Is(err, io.ErrUnexpectedEOF):
+		return "unexpected-eof"
+	case errors.Is(err, fs.ErrNotExist), errors.Is(err, syscall.ENOTDIR), strings.Contains(err.Error(), "not a dir"):
+		return "not-exist"
+	case errors.Is(err, fs.ErrExist):
+		return "exist"
+	case errors.Is(err, fs.ErrPermission):
+		return "permission"
+	case errors.Is(err, fs.ErrClosed), strings.Contains(err.Error(), "closed"):
+		return "closed"
+	default:
+		return "other"
+	}
+}
+
+var pathComps = []string{"a", "b", "c"}
+
+// genPath draws a clean absolute path of depth 1..3 over three names; with
+// some probability it is decorated with redundant separators and dots that
+// filepath.Clean removes.
+func genPath(tc hegel.TestCase) string {
+	parts := make([]string, n(tc, 1, 3))
+	for i := range parts {
+		parts[i] = pick(tc, pathComps...)
+	}
+	p := "/" + strings.Join(parts, "/")
+	switch n(tc, 0, 9) {
+	case 0:
+		p = strings.Replace(p, "/", "//", 1)
+	case 1:
+		p = p + "/"
+	case 2:
+		p = "/./" + p[1:]
+	case 3:
+		p = p[1:] // relative: both file systems root it
+	case 4:
+		p = p + "/x/.."
+	}
+	return p
+}
+
+func canon(p string) string {
+	p = path.Clean("/" + p)
+	return p
+}
+
+// universe lists every canonical path the generator can produce.
+var universe = func() []string {
+	var out []string
+	var rec func(prefix string, depth int)
+	rec = func(prefix string, depth int) {
+		for _, c := range pathComps {
+			p := prefix + "/" + c
+			out = append(out, p)
+			if depth < 3 {
+				rec(p, depth+1)
+			}
+		}
+	}
+	rec("", 1)
+	return out
+}()
+
+const (
+	kindMissing = iota
+	kindFile
+	kindDir
+)
+
+func kindOf(f afero.Fs, p string) int {
+	fi, err := f.Stat(p)
+	if err != nil {
+		return kindMissing
+	}
+	if fi.IsDir() {
+		return kindDir
+	}
+	return kindFile
+}
+
+func hasChildren(f afero.Fs, p string) bool {
+	d, err := f.Open(p)
+	if err != nil {
+		return false
+	}
+	defer d.Close()
+	names, _ := d.Readdirnames(-1)
+	return len(names) > 0
+}
+
+func isRoot() bool { return os.Geteuid() == 0 }
+
+var dirModes = []os.FileMode{0o755, 0o700, 0o777, 0o750}
+var fileModes = []os.FileMode{0o644, 0o600, 0o666, 0o755, 0o444, 0o400}
+
+func genFileMode(tc hegel.TestCase) os.FileMode {
+	m := pick(tc, fileModes...)
+	if isRoot() && m&0o222 == 0 {
+		m = 0o644
+	}
+	return m
+}
+
+func genData(tc hegel.TestCase) []byte {
+	k := n(tc, 0, 12)
+	b := make([]byte, k)
+	alphabet := []byte("abcxyz0\x00\xff")
+	for i := range b {
+		b[i] = alphabet[n(tc, 0, len(alphabet)-1)]
+	}
+	return b
+}
+
+// entry is one node of a tree snapshot.
+type entry struct {
+	path    string
+	dir     bool
+	perm    os.FileMode
+	size    int64
+	content string
+}
+
+func (e entry) String() string {
+	if e.dir {
+		return fmt.Sprintf("%s/ %o", e.path, e.perm)
+	}
+	return fmt.Sprintf("%s %o %d %q", e.path, e.perm, e.size, e.content)
+}
+
+// snapshot walks the tree from the root and records what is reachable.
+func snapshot(f afero.Fs) ([]entry, error) {
+	var out []entry
+	err := afero.Walk(f, "/", func(p string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if p == "/" {
+			return nil
+		}
+		e := entry{path: canon(p), dir: info.IsDir(), perm: info.Mode().Perm()}
+		if !info.IsDir() {
+			e.size = info.Size()
+			data, rerr := afero.ReadFile(f, p)
+			if rerr != nil {
+				if os.IsPermission(rerr) {
+					e.content = "<unreadable>"
+				} else {
+					return rerr
+				}
+			} else {
+				e.content = string(data)
+			}
+		}
+		out = append(out, e)
+		return nil
+	})
+	sort.Slice(out, func(i, j int) bool { return out[i].path < out[j].path })
+	return out, err
+}
+
+func joinEntries(es []entry) string {
+	var b strings.Builder
+	for _, e := range es {
+		b.WriteString(e.String())
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+// pair holds the two file systems under comparison.
+type pair struct {
+	ht  *hegel.T
+	mem afero.Fs
+	os  afero.Fs
+}
+
+func (p *pair) same(what string, memv, osv any) bool {
+	if fmt.Sprint(memv) != fmt.Sprint(osv) {
+		fail(p.ht, "%s: MemMapFs %v, OsFs %v", what, memv, osv)
+		return false
+	}
+	return true
+}
+
+func (p *pair) sameErr(what string, memErr, osErr error) bool {
+	mc, oc := errClass(memErr), errClass(osErr)
+	if mc != oc {
+		fail(p.ht, "%s: MemMapFs %v (%s), OsFs %v (%s)", what, memErr, mc, osErr, oc)
+		return false
+	}
+	return true
+}
+
+// checkTrees compares the reachable trees and the Stat of every path of the
+// universe (which also finds entries a bug left reachable by name only).
+func (p *pair) checkTrees() bool {
+	ms, merr := snapshot(p.mem)
+	oss, oerr := snapshot(p.os)
+	if merr != nil || oerr != nil {
+		fail(p.ht, "snapshot: MemMapFs %v, OsFs %v", merr, oerr)
+		return false
+	}
+	if joinEntries(ms) != joinEntries(oss) {
+		fail(p.ht, "trees differ\nMemMapFs:\n%sOsFs:\n%s", joinEntries(ms), joinEntries(oss))
+		return false
+	}
+	for _, u := range universe {
+		mk, ok := kindOf(p.mem, u), kindOf(p.os, u)
+		if mk != ok {
+			fail(p.ht, "Stat(%s) kind: MemMapFs %d, OsFs %d (missing/file/dir)", u, mk, ok)
+			return false
+		}
+	}
+	return true
+}
+
+func statSummary(fi os.FileInfo, err error, withName bool) string {
+	if err != nil {
+		return "err " + errClass(err)
+	}
+	s := fmt.Sprintf("dir=%v perm=%o", fi.IsDir(), fi.Mode().Perm())
+	if !fi.IsDir() {
+		s += fmt.Sprintf(" size=%d", fi.Size())
+	}
+	if withName {
+		s += " name=" + fi.Name()
+	}
+	return s
+}
+
+// TestHegelMemMapFsMatchesTheOs: MemMapFs and OsFs agree on every operation
+// and on the resulting tree. Steps that would reach a recorded bug are
+// skipped (see known.go).
+func TestHegelMemMapFsMatchesTheOs(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		p := &pair{ht: ht, mem: afero.NewMemMapFs(), os: afero.NewBasePathFs(afero.NewOsFs(), dir)}
+		steps := n(tc, 1, 25)
+		for i := 0; i < steps; i++ {
+			if !p.step(tc) {
+				return
+			}
+			if !p.checkTrees() {
+				return
+			}
+		}
+	})
+}
+
+// existingPath draws a path below an existing directory of the OsFs (the
+// truth) so that trees grow deep; falls back to genPath.
+func (p *pair) existingPath(tc hegel.TestCase) string {
+	if chance(tc, 40) {
+		return genPath(tc)
+	}
+	dirs := []string{"/"}
+	for _, u := range universe {
+		if strings.Count(u, "/") < 3 && kindOf(p.os, u) == kindDir {
+			dirs = append(dirs, u)
+		}
+	}
+	d := pick(tc, dirs...)
+	if d == "/" {
+		d = ""
+	}
+	return d + "/" + pick(tc, pathComps...)
+}
+
+// step performs one random operation on both file systems; false ends the case.
+func (p *pair) step(tc hegel.TestCase) bool {
+	ht := p.ht
+	raw := p.existingPath(tc)
+	cp := canon(raw)
+	parent := path.Dir(cp)
+	parentKind := kindOf(p.os, parent)
+	kind := kindOf(p.os, cp)
+	switch n(tc, 0, 12) {
+	case 0: // Mkdir
+		perm := pick(tc, dirModes...)
+		if Known.MkdirCreatesParents && parentKind == kindMissing {
+			count(ht, "skip: Mkdir without parent (afero/1)")
+			return true
+		}
+		if Known.FileBecomesDir && parentKind == kindFile {
+			count(ht, "skip: Mkdir below a file (afero/5)")
+			return true
+		}
+		note(ht, "Mkdir(%q, %o)", raw, perm)
+		return p.sameErr("Mkdir("+raw+")", p.mem.Mkdir(raw, perm), p.os.Mkdir(raw, perm))
+	case 1: // MkdirAll
+		perm := pick(tc, dirModes...)
+		if Known.MkdirAllOverFile && kind == kindFile {
+			count(ht, "skip: MkdirAll over a file (afero/4)")
+			return true
+		}
+		if Known.FileBecomesDir && fileOnTheWay(p.os, cp) {
+			count(ht, "skip: MkdirAll through a file (afero/5)")
+			return true
+		}
+		note(ht, "MkdirAll(%q, %o)", raw, perm)
+		return p.sameErr("MkdirAll("+raw+")", p.mem.MkdirAll(raw, perm), p.os.MkdirAll(raw, perm))
+	case 2: // Create
+		if Known.CreateCreatesParents && parentKind == kindMissing {
+			count(ht, "skip: Create without parent (afero/2)")
+			return true
+		}
+		if Known.FileBecomesDir && parentKind == kindFile {
+			count(ht, "skip: Create below a file (afero/5)")
+			return true
+		}
+		if Known.CreateOverDir && kind == kindDir {
+			count(ht, "skip: Create over a directory (afero/6)")
+			return true
+		}
+		if Known.CreateIgnoresPermission && kind == kindFile && !writable(p.os, cp) {
+			count(ht, "skip: Create over a read-only file (afero/30)")
+			return true
+		}
+		if Known.CreateReplacesFile && kind == kindFile && permOf(p.os, cp) != 0o666 {
+			count(ht, "skip: Create over a file with another mode (afero/15)")
+			return true
+		}
+		note(ht, "Create(%q)", raw)
+		mf, merr := p.mem.Create(raw)
+		of, oerr := p.os.Create(raw)
+		if !p.sameErr("Create("+raw+")", merr, oerr) {
+			return false
+		}
+		if merr != nil {
+			return true
+		}
+		return p.handleOps(tc, cp, mf, of, accessRW, false, false)
+	case 3: // Open
+		note(ht, "Open(%q)", raw)
+		mf, merr := p.mem.Open(raw)
+		of, oerr := p.os.Open(raw)
+		if !p.sameErr("Open("+raw+")", merr, oerr) {
+			return false
+		}
+		if merr != nil {
+			return true
+		}
+		return p.handleOps(tc, cp, mf, of, accessR, false, kind == kindDir)
+	case 4: // OpenFile
+		flag, acc := genFlags(tc)
+		perm := genFileMode(tc)
+		create := flag&os.O_CREATE != 0
+		if create && Known.CreateCreatesParents && parentKind == kindMissing {
+			count(ht, "skip: OpenFile(O_CREATE) without parent (afero/2)")
+			return true
+		}
+		if create && Known.FileBecomesDir && parentKind == kindFile {
+			count(ht, "skip: OpenFile below a file (afero/5)")
+			return true
+		}
+		if kind == kindDir && Known.DirectoryHandleIsAFile && flag != os.O_RDONLY {
+			count(ht, "skip: OpenFile on a directory with flags (afero/14)")
+			return true
+		}
+		if kind == kindFile && Known.ReadOnlyOpenNeedsWrite && !writable(p.os, cp) && (acc == accessR || flag&os.O_EXCL != 0) {
+			count(ht, "skip: OpenFile(O_RDONLY or O_EXCL) on a read-only file (afero/13)")
+			return true
+		}
+		note(ht, "OpenFile(%q, %s, %o)", raw, flagString(flag), perm)
+		mf, merr := p.mem.OpenFile(raw, flag, perm)
+		of, oerr := p.os.OpenFile(raw, flag, perm)
+		if !p.sameErr("OpenFile("+raw+", "+flagString(flag)+")", merr, oerr) {
+			return false
+		}
+		if merr != nil {
+			return true
+		}
+		return p.handleOps(tc, cp, mf, of, acc, flag&os.O_APPEND != 0, kind == kindDir)
+	case 5: // Remove
+		if Known.RemoveNonEmptyDir && kind == kindDir && hasChildren(p.os, cp) {
+			count(ht, "skip: Remove of a non-empty directory (afero/3)")
+			return true
+		}
+		note(ht, "Remove(%q)", raw)
+		return p.sameErr("Remove("+raw+")", p.mem.Remove(raw), p.os.Remove(raw))
+	case 6: // RemoveAll
+		if fileOnTheWay(p.os, cp) {
+			// os.RemoveAll reports ENOTDIR for a path below a regular file;
+			// MemMapFs returns nil as for any missing path. Convention.
+			count(ht, "skip: RemoveAll below a file")
+			return true
+		}
+		note(ht, "RemoveAll(%q)", raw)
+		return p.sameErr("RemoveAll("+raw+")", p.mem.RemoveAll(raw), p.os.RemoveAll(raw))
+	case 7: // Rename
+		raw2 := p.existingPath(tc)
+		cq := canon(raw2)
+		qKind := kindOf(p.os, cq)
+		qParentKind := kindOf(p.os, path.Dir(cq))
+		switch {
+		case cp == cq && kind == kindMissing && Known.RenameSelfMissing:
+			count(ht, "skip: Rename(x, x) of a missing path (afero/29)")
+			return true
+		case cp == cq && kind == kindDir:
+			// Go's os.Rename reports EEXIST for a directory renamed onto
+			// itself; MemMapFs treats equal names as a no-op. Convention.
+			count(ht, "skip: Rename(dir, dir)")
+			return true
+		case kind == kindMissing:
+			// fails on both; nothing else to guard
+		case cq != cp && strings.HasPrefix(cq, cp+"/") && Known.RenameIntoItself:
+			count(ht, "skip: Rename into itself (afero/8)")
+			return true
+		case qKind == kindDir && cq != cp:
+			// Go's os.Rename refuses any existing directory as destination
+			// (EEXIST), even an empty one. Convention.
+			count(ht, "skip: Rename onto a directory")
+			return true
+		case qKind == kindFile && kind == kindDir && Known.RenameOverwrites:
+			count(ht, "skip: Rename of a directory over a file (afero/7)")
+			return true
+		case qParentKind == kindMissing && Known.CreateCreatesParents:
+			count(ht, "skip: Rename into a missing directory (afero/2)")
+			return true
+		case qParentKind == kindFile && Known.FileBecomesDir:
+			count(ht, "skip: Rename below a file (afero/5)")
+			return true
+		}
+		note(ht, "Rename(%q, %q)", raw, raw2)
+		return p.sameErr("Rename("+raw+", "+raw2+")", p.mem.Rename(raw, raw2), p.os.Rename(raw, raw2))
+	case 8: // Chmod
+		var mode os.FileMode
+		if kind == kindDir {
+			mode = pick(tc, dirModes...)
+		} else {
+			mode = genFileMode(tc)
+		}
+		note(ht, "Chmod(%q, %o)", raw, mode)
+		return p.sameErr("Chmod("+raw+")", p.mem.Chmod(raw, mode), p.os.Chmod(raw, mode))
+	case 9: // Chtimes
+		when := time.Unix(int64(n(tc, 0, 2_000_000_000)), 0)
+		note(ht, "Chtimes(%q, %v)", raw, when)
+		if !p.sameErr("Chtimes("+raw+")", p.mem.Chtimes(raw, when, when), p.os.Chtimes(raw, when, when)) {
+			return false
+		}
+		mfi, merr := p.mem.Stat(raw)
+		ofi, oerr := p.os.Stat(raw)
+		if merr == nil && oerr == nil {
+			return p.same("ModTime after Chtimes("+raw+")", mfi.ModTime().Unix(), ofi.ModTime().Unix())
+		}
+		return true
+	case 10, 11: // Stat
+		note(ht, "Stat(%q)", raw)
+		mfi, merr := p.mem.Stat(raw)
+		ofi, oerr := p.os.Stat(raw)
+		return p.same("Stat("+raw+")", statSummary(mfi, merr, cp != "/"), statSummary(ofi, oerr, cp != "/"))
+	default: // ReadDir / ReadFile
+		if kind == kindDir || chance(tc, 30) {
+			note(ht, "ReadDir(%q)", raw)
+			ml, merr := afero.ReadDir(p.mem, raw)
+			ol, oerr := afero.ReadDir(p.os, raw)
+			if !p.sameErr("ReadDir("+raw+")", merr, oerr) {
+				return false
+			}
+			return p.same("ReadDir("+raw+")", dirList(ml), dirList(ol))
+		}
+		note(ht, "ReadFile(%q)", raw)
+		md, merr := afero.ReadFile(p.mem, raw)
+		od, oerr := afero.ReadFile(p.os, raw)
+		if !p.sameErr("ReadFile("+raw+")", merr, oerr) {
+			return false
+		}
+		return p.same("ReadFile("+raw+")", string(md), string(od))
+	}
+}
+
+func dirList(l []os.FileInfo) string {
+	var parts []string
+	for _, fi := range l {
+		parts = append(parts, statSummary(fi, nil, true))
+	}
+	return strings.Join(parts, "; ")
+}
+
+// fileOnTheWay reports whether some proper ancestor of p is a regular file.
+func fileOnTheWay(f afero.Fs, p string) bool {
+	for d := path.Dir(p); d != "/"; d = path.Dir(d) {
+		if kindOf(f, d) == kindFile {
+			return true
+		}
+	}
+	return false
+}
+
+func permOf(f afero.Fs, p string) os.FileMode {
+	fi, err := f.Stat(p)
+	if err != nil {
+		return 0
+	}
+	return fi.Mode().Perm()
+}
+
+func writable(f afero.Fs, p string) bool {
+	fi, err := f.Stat(p)
+	return err == nil && fi.Mode().Perm()&0o222 != 0
+}
+
+const (
+	accessR = iota
+	accessW
+	accessRW
+)
+
+func genFlags(tc hegel.TestCase) (int, int) {
+	acc := pick(tc, accessR, accessW, accessRW)
+	flag := [...]int{os.O_RDONLY, os.O_WRONLY, os.O_RDWR}[acc]
+	if chance(tc, 50) {
+		flag |= os.O_CREATE
+		if chance(tc, 30) {
+			flag |= os.O_EXCL
+		}
+	}
+	if acc != accessR {
+		if chance(tc, 30) {
+			flag |= os.O_TRUNC
+		}
+		if chance(tc, 30) {
+			flag |= os.O_APPEND
+			if Known.AppendSeeksOnce {
+				// MemMapFs seeks to the end before truncating: the first write
+				// of an O_TRUNC|O_APPEND handle lands past a zero (afero/11).
+				flag &^= os.O_TRUNC
+			}
+		}
+	}
+	return flag, acc
+}
+
+func flagString(flag int) string {
+	var parts []string
+	switch flag & (os.O_RDONLY | os.O_WRONLY | os.O_RDWR) {
+	case os.O_RDONLY:
+		parts = append(parts, "O_RDONLY")
+	case os.O_WRONLY:
+		parts = append(parts, "O_WRONLY")
+	case os.O_RDWR:
+		parts = append(parts, "O_RDWR")
+	}
+	for _, f := range []struct {
+		bit  int
+		name string
+	}{{os.O_CREATE, "O_CREATE"}, {os.O_EXCL, "O_EXCL"}, {os.O_TRUNC, "O_TRUNC"}, {os.O_APPEND, "O_APPEND"}} {
+		if flag&f.bit != 0 {
+			parts = append(parts, f.name)
+		}
+	}
+	return strings.Join(parts, "|")
+}
+
+// handleOps runs a short random sequence of operations on the two open
+// files, compares every result and closes both.
+func (p *pair) handleOps(tc hegel.TestCase, cp string, mf, of afero.File, acc int, appendMode, isDir bool) bool {
+	ok := p.handleOpsInner(tc, cp, mf, of, acc, appendMode, isDir)
+	merr, oerr := mf.Close(), of.Close()
+	if ok {
+		ok = p.sameErr("Close", merr, oerr)
+	}
+	if ok && chance(tc, 20) {
+		ok = p.sameErr("second Close", mf.Close(), of.Close())
+	}
+	return true
+}
+
+func (p *pair) handleOpsInner(tc hegel.TestCase, cp string, mf, of afero.File, acc int, appendMode, isDir bool) bool {
+	ht := p.ht
+	if cp != "/" && !p.same("Name()", mf.Name(), of.Name()) {
+		return false
+	}
+	for k := n(tc, 0, 6); k > 0; k-- {
+		var op int
+		if isDir {
+			op = pick(tc, 6, 7, 8)
+		} else {
+			op = n(tc, 0, 8)
+		}
+		switch op {
+		case 0, 1: // Write / WriteString
+			if acc == accessR && Known.AccessModeIgnored {
+				count(ht, "skip: write on a read-only handle (afero/12)")
+				continue
+			}
+			data := genData(tc)
+			if len(data) == 0 && Known.EmptyWriteAtGrows {
+				count(ht, "skip: Write of an empty slice (afero/31)")
+				continue
+			}
+			var mn, on int
+			var merr, oerr error
+			if op == 0 {
+				mn, merr = mf.Write(data)
+				on, oerr = of.Write(data)
+			} else {
+				mn, merr = mf.WriteString(string(data))
+				on, oerr = of.WriteString(string(data))
+			}
+			note(ht, "  Write(%q)", data)
+			if !p.sameErr("Write", merr, oerr) || !p.same("Write count", mn, on) {
+				return false
+			}
+		case 2: // Read
+			if acc == accessW && Known.AccessModeIgnored {
+				count(ht, "skip: read on a write-only handle (afero/12)")
+				continue
+			}
+			if appendMode && Known.AppendSeeksOnce {
+				count(ht, "skip: Read on an O_APPEND handle (afero/11)")
+				continue
+			}
+			buf1, buf2 := make([]byte, n(tc, 0, 8)), make([]byte, 0)
+			buf2 = append(buf2, buf1...)
+			mn, merr := mf.Read(buf1)
+			on, oerr := of.Read(buf2)
+			note(ht, "  Read(%d) -> %d %v / %d %v", len(buf1), mn, merr, on, oerr)
+			if Known.UnexpectedEOF && errors.Is(merr, io.ErrUnexpectedEOF) && (errors.Is(oerr, io.EOF) || (oerr == nil && on == 0)) {
+				count(ht, "accepted: Read past the end gives ErrUnexpectedEOF (afero/10)")
+				merr = oerr
+			}
+			if !p.sameErr("Read", merr, oerr) || !p.same("Read result", fmt.Sprintf("%d %q", mn, buf1[:mn]), fmt.Sprintf("%d %q", on, buf2[:on])) {
+				return false
+			}
+		case 3: // ReadAt
+			if acc == accessW && Known.AccessModeIgnored {
+				count(ht, "skip: ReadAt on a write-only handle (afero/12)")
+				continue
+			}
+			buf1, buf2 := make([]byte, n(tc, 0, 8)), make([]byte, 0)
+			buf2 = append(buf2, buf1...)
+			off := int64(n(tc, 0, 14))
+			mn, merr := mf.ReadAt(buf1, off)
+			on, oerr := of.ReadAt(buf2, off)
+			note(ht, "  ReadAt(%d, %d) -> %d %v / %d %v", len(buf1), off, mn, merr, on, oerr)
+			if Known.UnexpectedEOF && errors.Is(merr, io.ErrUnexpectedEOF) && (errors.Is(oerr, io.EOF) || (oerr == nil && on == 0)) {
+				count(ht, "accepted: ReadAt past the end gives ErrUnexpectedEOF (afero/10)")
+				merr = oerr
+			}
+			if !p.sameErr("ReadAt", merr, oerr) || !p.same("ReadAt result", fmt.Sprintf("%d %q", mn, buf1[:mn]), fmt.Sprintf("%d %q", on, buf2[:on])) {
+				return false
+			}
+		case 4: // WriteAt
+			if acc == accessR && Known.AccessModeIgnored {
+				count(ht, "skip: WriteAt on a read-only handle (afero/12)")
+				continue
+			}
+			if appendMode && Known.AppendSeeksOnce {
+				count(ht, "skip: WriteAt on an O_APPEND handle (afero/11)")
+				continue
+			}
+			data := genData(tc)
+			off := int64(n(tc, 0, 14))
+			if len(data) == 0 && Known.EmptyWriteAtGrows {
+				count(ht, "skip: WriteAt of an empty slice (afero/31)")
+				continue
+			}
+			mn, merr := mf.WriteAt(data, off)
+			on, oerr := of.WriteAt(data, off)
+			note(ht, "  WriteAt(%q, %d)", data, off)
+			if !p.sameErr("WriteAt", merr, oerr) || !p.same("WriteAt count", mn, on) {
+				return false
+			}
+		case 5: // Seek
+			if appendMode && Known.AppendSeeksOnce {
+				count(ht, "skip: Seek on an O_APPEND handle (afero/11)")
+				continue
+			}
+			whence := pick(tc, io.SeekStart, io.SeekCurrent, io.SeekEnd)
+			if !Known.SeekBadWhence && chance(tc, 5) {
+				whence = 7
+			}
+			off := int64(n(tc, -3, 14))
+			mpos, merr := mf.Seek(off, whence)
+			opos, oerr := of.Seek(off, whence)
+			note(ht, "  Seek(%d, %d) -> %d %v / %d %v", off, whence, mpos, merr, opos, oerr)
+			if oerr != nil && merr == nil && Known.NegativeSeek {
+				// The MemMapFs position is negative now and the next Read or
+				// Write would panic: end the handle's life here.
+				count(ht, "accepted: Seek to a negative position succeeded (afero/9)")
+				return true
+			}
+			if !p.sameErr("Seek", merr, oerr) || (merr == nil && !p.same("Seek position", mpos, opos)) {
+				return false
+			}
+		case 6: // Stat / Sync
+			mfi, merr := mf.Stat()
+			ofi, oerr := of.Stat()
+			if !p.same("File.Stat()", statSummary(mfi, merr, !isDir || mf.Name() != "/"), statSummary(ofi, oerr, !isDir || mf.Name() != "/")) {
+				return false
+			}
+			if !p.sameErr("Sync", mf.Sync(), of.Sync()) {
+				return false
+			}
+		case 7: // Readdir / Readdirnames pages
+			if !isDir {
+				merr := errClass(func() error { _, err := mf.Readdir(-1); return err }())
+				oerr := errClass(func() error { _, err := of.Readdir(-1); return err }())
+				if merr == "ok" || oerr == "ok" {
+					fail(ht, "Readdir on a file handle: MemMapFs %s, OsFs %s", merr, oerr)
+					return false
+				}
+				continue
+			}
+			page := pick(tc, -1, 0, 1, 2, 5)
+			names := chance(tc, 50)
+			var mAll, oAll []string
+			for calls := 0; calls < 5; calls++ {
+				var mn, on []string
+				var merr, oerr error
+				if names {
+					mn, merr = mf.Readdirnames(page)
+					on, oerr = of.Readdirnames(page)
+				} else {
+					var ml, ol []os.FileInfo
+					ml, merr = mf.Readdir(page)
+					ol, oerr = of.Readdir(page)
+					for _, fi := range ml {
+						mn = append(mn, fi.Name())
+					}
+					for _, fi := range ol {
+						on = append(on, fi.Name())
+					}
+				}
+				note(ht, "  Readdir(%d) -> %v %v / %v %v", page, mn, merr, on, oerr)
+				if !p.sameErr("Readdir page error", merr, oerr) || !p.same("Readdir page size", len(mn), len(on)) {
+					return false
+				}
+				mAll = append(mAll, mn...)
+				oAll = append(oAll, on...)
+				if merr != nil || page <= 0 {
+					break
+				}
+			}
+			sort.Strings(mAll)
+			sort.Strings(oAll)
+			if !p.same("Readdir names", mAll, oAll) {
+				return false
+			}
+		case 8: // Truncate
+			if acc == accessR && Known.AccessModeIgnored {
+				count(ht, "skip: Truncate on a read-only handle (afero/12)")
+				continue
+			}
+			if appendMode && Known.AppendSeeksOnce {
+				count(ht, "skip: Truncate on an O_APPEND handle (afero/11)")
+				continue
+			}
+			size := int64(n(tc, -1, 14))
+			note(ht, "  Truncate(%d)", size)
+			if !p.sameErr("Truncate", mf.Truncate(size), of.Truncate(size)) {
+				return false
+			}
+		}
+	}
+	return true
+}
