+		got1, err1 := afero.FileContainsBytes(mem, q, subs[0])
+		want1 := len(subs[0]) > 0 && bytes.Contains(data, subs[0])
+		ogot, oerr := afero.FileContainsAnyBytes(osfs, q, subs)
+		note(ht, "FileContainsAnyBytes(%s=%q, %q) = %v %v (os %v %v), want %v", q, data, subs, got, err, ogot, oerr, want)
+		if err != nil || err1 != nil || oerr != nil {
+			p.fail("FileContainsBytes errors: %v %v %v", err, err1, oerr)
+			return false
+		}
+		if got != ogot {
