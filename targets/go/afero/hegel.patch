+// afero/39. The Rename aborts the whole process (a log.Panic inside a read lock, then the
+// deferred RUnlock's fatal error), so the call runs in a child: the test binary itself,
+// running only this test with HEGEL_AFERO_CHILD set.
+func TestHegelPinRenameBelowAMissingParentIsAnError(t *testing.T) {
+	if os.Getenv("HEGEL_AFERO_CHILD") == "1" {
+		m := afero.NewMemMapFs()
+		m.MkdirAll("/b", 0o755)
+		err := m.Rename("/b", "/b/c/c")
+		os.Stdout.WriteString("rename returned: " + errString(err) + "\n")
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run", "^TestHegelPinRenameBelowAMissingParentIsAnError$", "-test.v")
+	cmd.Env = append(os.Environ(), "HEGEL_AFERO_CHILD=1")
+	cmd.WaitDelay = 5 * time.Second
+	out, err := cmd.CombinedOutput()
+	text := string(out)
+	if !strings.Contains(text, "rename returned: ") {
+		t.Errorf("MemMapFs.Rename(/b, /b/c/c) of a directory below itself to a path whose parent does not exist aborted the process (OsFs: ENOENT); child exit %v, output:\n%s", err, short(text))
+		return
+	}
+	if strings.Contains(text, "rename returned: <nil>") {
+		t.Errorf("MemMapFs.Rename(/b, /b/c/c) of a directory below itself to a path whose parent does not exist succeeded (OsFs: ENOENT)")
+	}
+}
+
+func errString(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+func short(s string) string {
+	if len(s) > 1500 {
+		return s[:1500] + "..."
+	}
+	return s
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..205a01f
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,199 @@
+package hegel
+
+// Hegel properties for github.com/spf13/afero: MemMapFs against an OsFs
+// confined to a temporary directory, the package-level helpers against os
+// and path/filepath, and the wrapping file systems (ReadOnlyFs,
+// CopyOnWriteFs, CacheOnReadFs, RegexpFs, BasePathFs, IOFS) against small
+// models. No external tools.
+//
+// Every property draws one case record (a tree to build and a list of
+// operations) from generator values and applies it with positions taken
+// modulo the live tree, so a step that does not fit the state is a no-op the
+// shrinker can delete. The recorded bugs (bugs.toml) are reached by default:
+// a step whose shape is a recorded bug runs, and a mismatch names the bug.
+// With HEGEL_NO_KNOWN=1 such steps are no-ops (or the shape is left out of
+// the generator) and the recorded outcomes are accepted, so the properties
+// must pass; see known.go.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing (shared with the other Go targets of the zoo).
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the no-op steps and accepted outcomes of each property so a
+// run shows how often the known-bug gates fire (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			if controlFlow(r) {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("PANIC in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// controlFlow reports whether a recovered value is Hegel's own (a Fatalf,
+// an Assume, libhegel's stop), which must propagate.
+func controlFlow(r any) bool {
+	if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+		return true
+	}
+	tn := reflect.TypeOf(r).String()
+	return strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.")
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms (the same in the other Go targets of the zoo).
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted draws one of the alternatives with probability proportional to
+// its weight. The first alternative is the shrink target, so it should be
+// the plainest one.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(x int) hegel.Generator[T] {
+		for _, c := range choices {
+			if x < c.weight {
+				return c.gen
+			}
+			x -= c.weight
+		}
+		return choices[len(choices)-1].gen
+	})
+}
+
+// chance is a biased coin that shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// many draws lo..hi values of g.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions are indices taken modulo a live size when a case is applied.
+var positions = hegel.Integers(0, 99)
+
+// at picks the element of xs at a drawn position (modulo the live size).
+func at[T any](xs []T, pos int) T { return xs[pos%len(xs)] }
+
+// shaped picks the generator for the current mode: withBugs draws the shapes
+// of the recorded bugs too, without leaves them out (HEGEL_NO_KNOWN=1).
+func shaped[T any](withBugs, without hegel.Generator[T]) hegel.Generator[T] {
+	if noKnown {
+		return without
+	}
+	return withBugs
+}
+
+// join renders drawn pieces as one string (a Map over many).
+func join(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
diff --git a/hegel/hegel_unix_test.go b/hegel/hegel_unix_test.go
new file mode 100644
index 0000000..1d2fe91
--- /dev/null
+++ b/hegel/hegel_unix_test.go
@@ -0,0 +1,9 @@
+//go:build unix
+
+package hegel
+
+import "syscall"
+
+// The OsFs side applies the process umask to the modes it is given and the
+// MemMapFs does not; clear it so that both keep the requested bits.
+func init() { syscall.Umask(0) }
diff --git a/hegel/hegel_util_test.go b/hegel/hegel_util_test.go
new file mode 100644
index 0000000..aee0986
--- /dev/null
+++ b/hegel/hegel_util_test.go
@@ -0,0 +1,681 @@
+package hegel
+
+// The package-level helpers (ReadDir, ReadFile, WriteFile, Exists, DirExists,
+// IsDir, IsEmpty, Walk, WalkDir, Glob, FileContainsBytes, TempFile, TempDir,
+// WriteReader, SafeWriteReader, ReadAll) on a MemMapFs and on an OsFs holding
+// the same tree, against each other and against os/filepath.
+
+import (
+	"bytes"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/spf13/afero"
+	"golang.org/x/text/unicode/norm"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Trees.
+
+var treeNames = []string{"a", "b", "c", "x y", "\u00e9", ".h", "a-b", "b.txt", "c.log"}
+
+var names = hegel.SampledFrom(treeNames)
+
+// treeDir is a directory to create below the live directory at a position;
+// treeFile a file with its content. A name already taken is a no-op.
+type treeDir struct {
+	At   int
+	Name string
+}
+
+type treeFile struct {
+	At   int
+	Name string
+	Data []byte
+}
+
+// treeSpec is a drawn tree: up to 5 directories, then up to 7 files.
+type treeSpec struct {
+	Dirs  []treeDir
+	Files []treeFile
+}
+
+var treeDirs = hegel.Composite(func(tc hegel.TestCase) treeDir {
+	return treeDir{At: hegel.Draw(tc, positions), Name: hegel.Draw(tc, names)}
+})
+
+var treeFiles = hegel.Composite(func(tc hegel.TestCase) treeFile {
+	return treeFile{At: hegel.Draw(tc, positions), Name: hegel.Draw(tc, names), Data: hegel.Draw(tc, dataBytes)}
+})
+
+var treeSpecs = hegel.Composite(func(tc hegel.TestCase) treeSpec {
+	return treeSpec{Dirs: hegel.Draw(tc, many(treeDirs, 0, 5)), Files: hegel.Draw(tc, many(treeFiles, 0, 7))}
+})
+
+func (t treeSpec) GoString() string {
+	var parts []string
+	for _, d := range t.Dirs {
+		parts = append(parts, fmt.Sprintf("dir <%d>/%s", d.At, d.Name))
+	}
+	for _, f := range t.Files {
+		parts = append(parts, fmt.Sprintf("file <%d>/%s %q", f.At, f.Name, f.Data))
+	}
+	return "tree{" + strings.Join(parts, ", ") + "}"
+}
+
+// build creates the tree (directories first, then files) on every given file
+// system and returns the directories and files created, sorted.
+func (t treeSpec) build(fss ...afero.Fs) (dirs, files []string, content map[string][]byte) {
+	dirs = []string{"/"}
+	content = map[string][]byte{}
+	isDir := func(p string) bool {
+		for _, e := range dirs {
+			if e == p {
+				return true
+			}
+		}
+		return false
+	}
+	for _, d := range t.Dirs {
+		nd := childOf(at(dirs, d.At), d.Name)
+		if content[nd] != nil || isDir(nd) {
+			continue
+		}
+		for _, f := range fss {
+			if err := f.MkdirAll(nd, 0o755); err != nil {
+				panic(err)
+			}
+		}
+		dirs = append(dirs, nd)
+	}
+	for _, fl := range t.Files {
+		nf := childOf(at(dirs, fl.At), fl.Name)
+		if isDir(nf) || content[nf] != nil {
+			continue
+		}
+		for _, f := range fss {
+			if err := afero.WriteFile(f, nf, fl.Data, 0o644); err != nil {
+				panic(err)
+			}
+		}
+		files = append(files, nf)
+		content[nf] = fl.Data
+	}
+	sort.Strings(dirs)
+	sort.Strings(files)
+	return dirs, files, content
+}
+
+// childOf joins a directory and a name without doubling the root's slash.
+func childOf(d, name string) string {
+	if d == "/" {
+		d = ""
+	}
+	return d + "/" + name
+}
+
+// pathPick is a drawn path of a built tree: one of its directories, one of
+// its files (a directory when there are none), or a fresh name below one of
+// its directories.
+type pathPick struct {
+	Kind int // 0 directory, 1 file, 2 fresh name
+	At   int
+	Name string
+}
+
+var pathPicks = hegel.Composite(func(tc hegel.TestCase) pathPick {
+	return pathPick{
+		Kind: hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 2, 2})),
+		At:   hegel.Draw(tc, positions),
+		Name: hegel.Draw(tc, names),
+	}
+})
+
+func (q pathPick) resolve(dirs, files []string) string {
+	switch {
+	case q.Kind == 0, q.Kind == 1 && len(files) == 0:
+		return at(dirs, q.At)
+	case q.Kind == 1:
+		return at(files, q.At)
+	}
+	return childOf(at(dirs, q.At), q.Name)
+}
+
+func (q pathPick) GoString() string {
+	switch q.Kind {
+	case 0:
+		return fmt.Sprintf("dir<%d>", q.At)
+	case 1:
+		return fmt.Sprintf("file<%d>", q.At)
+	}
+	return fmt.Sprintf("dir<%d>/%s", q.At, q.Name)
+}
+
+// ---------------------------------------------------------------------------
+// Steps of the helpers property.
+
+// subSpec is one needle of FileContainsAnyBytes: fresh bytes, or a slice of
+// the file's content between two positions.
+type subSpec struct {
+	Slice  bool
+	Lo, Hi int
+	Fresh  []byte
+}
+
+var subSpecs = weighted(
+	choice[subSpec]{1, hegel.Composite(func(tc hegel.TestCase) subSpec {
+		return subSpec{Fresh: hegel.Draw(tc, dataBytes)}
+	})},
+	choice[subSpec]{1, hegel.Composite(func(tc hegel.TestCase) subSpec {
+		return subSpec{Slice: true, Lo: hegel.Draw(tc, positions), Hi: hegel.Draw(tc, positions)}
+	})},
+)
+
+func (s subSpec) resolve(data []byte) []byte {
+	if !s.Slice {
+		return s.Fresh
+	}
+	if len(data) == 0 {
+		return nil
+	}
+	lo := s.Lo % len(data)
+	hi := lo + s.Hi%(len(data)-lo+1)
+	return append([]byte(nil), data[lo:hi]...)
+}
+
+// Glob decorations of one path element: plain, "*", first letter and "*",
+// "?" and the rest, a class around the first letter, and (while afero/28 is
+// switched on) a backslash escape.
+var globDecos = shaped(
+	hegel.SampledFrom([]string{"plain", "plain", "star", "prefix", "question", "class", "backslash"}),
+	hegel.SampledFrom([]string{"plain", "plain", "star", "prefix", "question", "class"}),
+)
+
+func decorate(part, deco string) string {
+	switch deco {
+	case "star":
+		return "*"
+	case "prefix":
+		return part[:1] + "*"
+	case "question":
+		return "?" + part[1:]
+	case "class":
+		return "[" + part[:1] + "x]" + part[1:]
+	case "backslash":
+		return `\` + part
+	}
+	return part
+}
+
+// pattern renders the glob pattern of a path: every element takes the
+// decoration at its index of the tape (plain when the tape is empty).
+func pattern(base string, tape []string) string {
+	parts := strings.Split(strings.TrimPrefix(base, "/"), "/")
+	for i, part := range parts {
+		if part == "" || len(tape) == 0 {
+			continue
+		}
+		parts[i] = decorate(part, at(tape, i))
+	}
+	return "/" + strings.Join(parts, "/")
+}
+
+var unicodePool = []string{"a", "Z", "9", ".", "/", "\\", "_", "-", "%", " ", "#", "\u00e9", "e\u0301", "\u4e2d", "!", "*", ":", "\u0301", "\u0f04", "\ufb01"}
+
+var unicodeNames = join(many(hegel.SampledFrom(unicodePool), 0, 8))
+
+// helperStep is one operation of the helpers property; only the fields the
+// operation uses are drawn.
+type helperStep struct {
+	Op      string // Exists, ReadDir, ReadFile, Walk, WalkSkip, Glob, Contains, Temp, Unicode, Write
+	Path    pathPick
+	Stop    int  // WalkSkip: position among the tree's entries
+	SkipAll bool // WalkSkip: SkipAll instead of SkipDir
+	Tape    []string
+	Subs    []subSpec
+	Prefix  string
+	Suffix  string
+	Star    bool
+	Data    []byte
+	Kind    int // Write: 0 WriteReader, 1 SafeWriteReader, 2 WriteFile
+	Name    string
+}
+
+func (s helperStep) GoString() string {
+	switch s.Op {
+	case "WalkSkip":
+		return fmt.Sprintf("WalkSkip(%#v, stop <%d>, all %v)", s.Path, s.Stop, s.SkipAll)
+	case "Glob":
+		return fmt.Sprintf("Glob(%#v, %v)", s.Path, s.Tape)
+	case "Contains":
+		return fmt.Sprintf("Contains(file<%d>, %#v)", s.Path.At, s.Subs)
+	case "Temp":
+		return fmt.Sprintf("Temp(dir<%d>, %q, %q, star %v)", s.Path.At, s.Prefix, s.Suffix, s.Star)
+	case "Unicode":
+		return fmt.Sprintf("Unicode(%q)", s.Name)
+	case "Write":
+		return fmt.Sprintf("%s(%#v, %q)", [...]string{"WriteReader", "SafeWriteReader", "WriteFile"}[s.Kind], s.Path, s.Data)
+	}
+	return fmt.Sprintf("%s(%#v)", s.Op, s.Path)
+}
+
+func helperStepOf(op string, fields func(tc hegel.TestCase, s *helperStep)) hegel.Generator[helperStep] {
+	return hegel.Composite(func(tc hegel.TestCase) helperStep {
+		s := helperStep{Op: op, Path: hegel.Draw(tc, pathPicks)}
+		if fields != nil {
+			fields(tc, &s)
+		}
+		return s
+	})
+}
+
+var helperSteps = weighted(
+	choice[helperStep]{1, helperStepOf("Exists", nil)},
+	choice[helperStep]{1, helperStepOf("ReadDir", nil)},
+	choice[helperStep]{1, helperStepOf("ReadFile", nil)},
+	choice[helperStep]{1, helperStepOf("Walk", nil)},
+	choice[helperStep]{1, helperStepOf("WalkSkip", func(tc hegel.TestCase, s *helperStep) {
+		s.Stop = hegel.Draw(tc, positions)
+		s.SkipAll = hegel.Draw(tc, hegel.Booleans())
+	})},
+	choice[helperStep]{1, helperStepOf("Glob", func(tc hegel.TestCase, s *helperStep) {
+		s.Tape = hegel.Draw(tc, many(globDecos, 0, 4))
+	})},
+	choice[helperStep]{1, helperStepOf("Contains", func(tc hegel.TestCase, s *helperStep) {
+		s.Subs = hegel.Draw(tc, many(subSpecs, 1, 3))
+	})},
+	choice[helperStep]{1, helperStepOf("Temp", func(tc hegel.TestCase, s *helperStep) {
+		s.Prefix = hegel.Draw(tc, hegel.SampledFrom([]string{"tmp", "", "x-"}))
+		s.Suffix = hegel.Draw(tc, hegel.SampledFrom([]string{"", ".txt"}))
+		s.Star = hegel.Draw(tc, chance(30))
+	})},
+	choice[helperStep]{1, helperStepOf("Unicode", func(tc hegel.TestCase, s *helperStep) {
+		s.Name = hegel.Draw(tc, unicodeNames)
+	})},
+	choice[helperStep]{1, helperStepOf("Write", func(tc hegel.TestCase, s *helperStep) {
+		s.Data = hegel.Draw(tc, dataBytes)
+		s.Kind = hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 2}))
+	})},
+)
+
+// helperCase is the case of the helpers property: a tree and 1..8 steps.
+type helperCase struct {
+	Tree  treeSpec
+	Steps []helperStep
+}
+
+func (c helperCase) GoString() string {
+	var b strings.Builder
+	b.WriteString("helperCase{\n\t" + c.Tree.GoString())
+	for _, s := range c.Steps {
+		b.WriteString("\n\t" + s.GoString())
+	}
+	b.WriteString("\n}")
+	return b.String()
+}
+
+var helperCases = hegel.Composite(func(tc hegel.TestCase) helperCase {
+	return helperCase{Tree: hegel.Draw(tc, treeSpecs), Steps: hegel.Draw(tc, many(helperSteps, 1, 8))}
+})
+
+// ---------------------------------------------------------------------------
+// The property.
+
+// TestHegelHelpersMatchTheOs: the helpers give the same answers on a
+// MemMapFs and on an OsFs holding the same tree, and the answers are the
+// ones os and path/filepath give.
+func TestHegelHelpersMatchTheOs(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, helperCases)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		mem := afero.NewMemMapFs()
+		osfs := afero.NewBasePathFs(afero.NewOsFs(), dir)
+		p := &pair{ht: ht, mem: mem, os: osfs}
+		defer p.recoverPanics()
+		dirs, files, content := c.Tree.build(mem, osfs)
+		for _, s := range c.Steps {
+			p.shapes = nil
+			q := s.Path.resolve(dirs, files)
+			switch s.Op {
+			case "ReadDir":
+				ml, merr := afero.ReadDir(mem, q)
+				ol, oerr := afero.ReadDir(osfs, q)
+				if !p.sameErr("ReadDir("+q+")", merr, oerr) || !p.same("ReadDir("+q+")", dirList(ml), dirList(ol)) {
+					return
+				}
+				if merr == nil {
+					// Sorted by name, as documented.
+					for j := 1; j < len(ml); j++ {
+						if ml[j-1].Name() >= ml[j].Name() {
+							p.fail("ReadDir(%s) is not sorted: %v", q, dirList(ml))
+							return
+						}
+					}
+				}
+			case "ReadFile": // ReadFile / ReadAll
+				isDir, _ := afero.IsDir(osfs, q)
+				if !p.gate(shapeIf(isDir, "afero/14")) {
+					continue
+				}
+				md, merr := afero.ReadFile(mem, q)
+				od, oerr := afero.ReadFile(osfs, q)
+				if !p.sameErr("ReadFile("+q+")", merr, oerr) || !p.same("ReadFile("+q+")", string(md), string(od)) {
+					return
+				}
+				if want, ok := content[q]; ok && string(md) != string(want) {
+					p.fail("ReadFile(%s) = %q, want %q", q, md, want)
+					return
+				}
+				if merr == nil {
+					f, _ := mem.Open(q)
+					all, err := afero.ReadAll(f)
+					f.Close()
+					if err != nil || string(all) != string(md) {
+						p.fail("ReadAll(Open(%s)) = %q, %v; ReadFile gave %q", q, all, err, md)
+						return
+					}
+				}
+			case "Exists": // Exists / DirExists / IsDir / IsEmpty
+				type answers struct {
+					exists, dirExists, isDir, isEmpty bool
+					isDirErr, isEmptyErr              string
+				}
+				ask := func(f afero.Fs) answers {
+					var a answers
+					a.exists, _ = afero.Exists(f, q)
+					a.dirExists, _ = afero.DirExists(f, q)
+					var err error
+					a.isDir, err = afero.IsDir(f, q)
+					a.isDirErr = errClass(err)
+					a.isEmpty, err = afero.IsEmpty(f, q)
+					a.isEmptyErr = fmt.Sprint(err != nil)
+					return a
+				}
+				ma, oa := ask(mem), ask(osfs)
+				if !p.same("Exists/DirExists/IsDir/IsEmpty("+q+")", fmt.Sprintf("%+v", ma), fmt.Sprintf("%+v", oa)) {
+					return
+				}
+				_, serr := os.Stat(filepath.Join(dir, q))
+				if ma.exists != (serr == nil) {
+					p.fail("Exists(%s) = %v, os.Stat says %v", q, ma.exists, serr)
+					return
+				}
+			case "Walk":
+				mw, merr := walkList(mem, q, "")
+				ow, oerr := walkList(osfs, q, "")
+				if !p.sameErr("Walk("+q+")", merr, oerr) || !p.same("Walk("+q+")", mw, ow) {
+					return
+				}
+				want, werr := walkList(nil, filepath.Join(dir, q), dir)
+				if errClass(werr) != errClass(oerr) || fmt.Sprint(want) != fmt.Sprint(ow) {
+					p.fail("Walk(%s) visited %v (%v); filepath.Walk visited %v (%v)", q, ow, oerr, want, werr)
+					return
+				}
+				// WalkDir agrees with Walk on the visited paths.
+				var wd []string
+				afero.WalkDir(mem, q, func(pth string, d fs.DirEntry, err error) error {
+					if err == nil {
+						wd = append(wd, fmt.Sprintf("%s dir=%v", canon(pth), d.IsDir()))
+					}
+					return nil
+				})
+				if fmt.Sprint(wd) != fmt.Sprint(mw) {
+					p.fail("WalkDir(%s) visited %v, Walk visited %v", q, wd, mw)
+					return
+				}
+			case "WalkSkip": // Walk with SkipDir / SkipAll
+				stopAt := at(entries(dirs, files), s.Stop)
+				skip := filepath.SkipDir
+				if s.SkipAll {
+					skip = filepath.SkipAll
+				}
+				visit := func(f afero.Fs) (string, error) {
+					var seen []string
+					err := afero.Walk(f, q, func(pth string, info os.FileInfo, err error) error {
+						seen = append(seen, canon(pth))
+						if canon(pth) == stopAt {
+							return skip
+						}
+						return nil
+					})
+					return strings.Join(seen, " "), err
+				}
+				var want []string
+				werr := filepath.Walk(filepath.Join(dir, q), func(pth string, info os.FileInfo, err error) error {
+					rel := canon(strings.TrimPrefix(pth, dir))
+					want = append(want, rel)
+					if rel == stopAt {
+						return skip
+					}
+					return nil
+				})
+				ms, merr := visit(mem)
+				os_, oerr := visit(osfs)
+				note(ht, "Walk(%s) with %v at %s: mem %q %v, os %q %v, filepath %q %v", q, skip, stopAt, ms, merr, os_, oerr, strings.Join(want, " "), werr)
+				if ms != os_ || ms != strings.Join(want, " ") {
+					p.fail("Walk(%s) returning %v at %s visited: MemMapFs %q, OsFs %q, filepath.Walk %q", q, skip, stopAt, ms, os_, strings.Join(want, " "))
+					return
+				}
+				if merr == skip && oerr == skip && werr == nil && p.accept("afero/27") {
+					continue
+				}
+				if !p.sameErr("Walk error", merr, oerr) || !p.sameErr("Walk error vs filepath.Walk", oerr, werr) {
+					return
+				}
+			case "Glob":
+				pat := pattern(q, s.Tape)
+				mg, merr := afero.Glob(mem, pat)
+				og, oerr := afero.Glob(osfs, pat)
+				want, werr := filepath.Glob(filepath.Join(dir, pat))
+				for i := range want {
+					want[i] = canon(strings.TrimPrefix(want[i], dir))
+				}
+				for i := range og {
+					og[i] = canon(og[i])
+				}
+				for i := range mg {
+					mg[i] = canon(mg[i])
+				}
+				note(ht, "Glob(%s): mem %v %v, os %v %v, filepath %v %v", pat, mg, merr, og, oerr, want, werr)
+				if !p.sameErr("Glob("+pat+")", merr, oerr) || !p.same("Glob("+pat+")", mg, og) {
+					return
+				}
+				if !p.gate(shapeIf(strings.Contains(pat, `\`), "afero/28")) {
+					continue
+				}
+				if (werr != nil) != (oerr != nil) || fmt.Sprint(want) != fmt.Sprint(og) {
+					p.fail("Glob(%s) = %v, %v; filepath.Glob = %v, %v", pat, og, oerr, want, werr)
+					return
+				}
+			case "Contains": // FileContainsBytes / FileContainsAnyBytes
+				if len(files) == 0 {
+					continue
+				}
+				q = at(files, s.Path.At)
+				data := content[q]
+				var subs [][]byte
+				for _, sub := range s.Subs {
+					subs = append(subs, sub.resolve(data))
+				}
+				want := false
+				for _, sub := range subs {
+					want = want || (len(sub) > 0 && bytes.Contains(data, sub))
+				}
+				got, err := afero.FileContainsAnyBytes(mem, q, subs)
+				got1, err1 := afero.FileContainsBytes(mem, q, subs[0])
+				want1 := len(subs[0]) > 0 && bytes.Contains(data, subs[0])
+				ogot, oerr := afero.FileContainsAnyBytes(osfs, q, subs)
+				note(ht, "FileContainsAnyBytes(%s=%q, %q) = %v %v (os %v %v), want %v", q, data, subs, got, err, ogot, oerr, want)
+				if err != nil || err1 != nil || oerr != nil {
+					p.fail("FileContainsBytes errors: %v %v %v", err, err1, oerr)
+					return
+				}
+				if got != ogot {
+					p.fail("FileContainsAnyBytes(%s, %q): MemMapFs %v, OsFs %v", q, subs, got, ogot)
+					return
+				}
+				if got != want || got1 != want1 {
+					if ((got && !want) || (got1 && !want1)) && p.accept("afero/19") {
+						continue
+					}
+					p.fail("FileContainsAnyBytes(%q, %q) = %v, want %v; FileContainsBytes(%q) = %v, want %v", data, subs, got, want, subs[0], got1, want1)
+					return
+				}
+			case "Temp": // TempFile / TempDir
+				d := at(dirs, s.Path.At)
+				pat := s.Prefix
+				if s.Suffix != "" || s.Star {
+					pat = s.Prefix + "*" + s.Suffix
+				}
+				for _, f := range []afero.Fs{mem, osfs} {
+					tf, err := afero.TempFile(f, d, pat)
+					if err != nil {
+						p.fail("TempFile(%s, %s) on %s: %v", d, pat, f.Name(), err)
+						return
+					}
+					name := tf.Name()
+					fi, serr := tf.Stat()
+					tf.Close()
+					base := path.Base(name)
+					if canon(path.Dir(name)) != canon(d) || !strings.HasPrefix(base, s.Prefix) || !strings.HasSuffix(base, s.Suffix) || len(base) <= len(s.Prefix)+len(s.Suffix) {
+						p.fail("TempFile(%s, %s) on %s named the file %q", d, pat, f.Name(), name)
+						return
+					}
+					if serr != nil || fi.IsDir() || fi.Size() != 0 || fi.Mode().Perm() != 0o600 {
+						p.fail("TempFile(%s, %s) on %s: Stat %v %v", d, pat, f.Name(), statSummary(fi, serr, true), fi.Mode())
+						return
+					}
+					if ex, _ := afero.Exists(f, name); !ex {
+						p.fail("TempFile %q does not exist afterwards on %s", name, f.Name())
+						return
+					}
+					td, err := afero.TempDir(f, d, s.Prefix)
+					if err != nil {
+						p.fail("TempDir(%s, %s) on %s: %v", d, s.Prefix, f.Name(), err)
+						return
+					}
+					tfi, serr := f.Stat(td)
+					if serr != nil || !tfi.IsDir() || tfi.Mode().Perm() != 0o700 || canon(path.Dir(td)) != canon(d) || !strings.HasPrefix(path.Base(td), s.Prefix) {
+						p.fail("TempDir(%s, %s) on %s = %q: %s", d, s.Prefix, f.Name(), td, statSummary(tfi, serr, true))
+						return
+					}
+					if _, err := afero.TempDir(f, d, "a/b"); err == nil {
+						p.fail("TempDir with a separator in the prefix succeeded on %s", f.Name())
+						return
+					}
+					f.Remove(name)
+					f.Remove(td)
+				}
+			case "Write": // WriteReader / SafeWriteReader / WriteFile
+				exists, _ := afero.Exists(osfs, q)
+				isDir, _ := afero.IsDir(osfs, q)
+				parentIsDir, _ := afero.IsDir(osfs, path.Dir(canon(q)))
+				if !p.gate(
+					shapeIf(!parentIsDir, "afero/2"),
+					shapeIf(isDir, "afero/6"),
+					shapeIf(exists && !isDir && permOf(osfs, q) != 0o666, "afero/15"),
+				) {
+					continue
+				}
+				var merr, oerr error
+				switch s.Kind {
+				case 0:
+					merr = afero.WriteReader(mem, q, bytes.NewReader(s.Data))
+					oerr = afero.WriteReader(osfs, q, bytes.NewReader(s.Data))
+				case 1:
+					merr = afero.SafeWriteReader(mem, q, bytes.NewReader(s.Data))
+					oerr = afero.SafeWriteReader(osfs, q, bytes.NewReader(s.Data))
+					if (merr == nil) == exists {
+						p.fail("SafeWriteReader(%s) with exists=%v: %v", q, exists, merr)
+						return
+					}
+				default:
+					merr = afero.WriteFile(mem, q, s.Data, 0o600)
+					oerr = afero.WriteFile(osfs, q, s.Data, 0o600)
+				}
+				note(ht, "write %s (%d bytes): %v / %v", q, len(s.Data), merr, oerr)
+				if !p.sameErr("write("+q+")", merr, oerr) {
+					return
+				}
+				if merr == nil {
+					content[q] = s.Data
+					if !isDir && !exists {
+						files = append(files, q)
+					}
+				}
+				if !p.checkTrees() {
+					return
+				}
+			default: // UnicodeSanitize / NeuterAccents
+				san := afero.UnicodeSanitize(s.Name)
+				for _, r := range san {
+					if !(unicode.IsLetter(r) || unicode.IsDigit(r) || unicode.IsMark(r) || strings.ContainsRune("./\\_-% #", r)) {
+						p.fail("UnicodeSanitize(%q) = %q keeps %q", s.Name, san, r)
+						return
+					}
+				}
+				var keep []rune
+				for _, r := range s.Name {
+					if unicode.IsLetter(r) || unicode.IsDigit(r) || unicode.IsMark(r) || strings.ContainsRune("./\\_-% #", r) {
+						keep = append(keep, r)
+					}
+				}
+				if san != string(keep) {
+					p.fail("UnicodeSanitize(%q) = %q, want %q", s.Name, san, string(keep))
+					return
+				}
+				neu := afero.NeuterAccents(s.Name)
+				var want []rune
+				for _, r := range norm.NFD.String(s.Name) {
+					if !unicode.Is(unicode.Mn, r) {
+						want = append(want, r)
+					}
+				}
+				if neu != norm.NFC.String(string(want)) {
+					p.fail("NeuterAccents(%q) = %q, want %q", s.Name, neu, norm.NFC.String(string(want)))
+					return
+				}
+			}
+		}
+	})
+}
+
+// entries lists the directories and files of a built tree.
+func entries(dirs, files []string) []string {
+	out := append([]string(nil), dirs...)
+	return append(out, files...)
+}
+
+// walkList lists what Walk visits below q as "path dir=bool"; with f == nil
+// it uses filepath.Walk on the OS path and strips the prefix.
+func walkList(f afero.Fs, q, prefix string) ([]string, error) {
+	var out []string
+	fn := func(pth string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		out = append(out, fmt.Sprintf("%s dir=%v", canon(strings.TrimPrefix(pth, prefix)), info.IsDir()))
+		return nil
+	}
+	if f == nil {
+		return out, filepath.Walk(q, fn)
+	}
+	return out, afero.Walk(f, q, fn)
+}
