+// ---------------------------------------------------------------------------
+// CacheOnReadFs regions: a cacheRun whose base and reference hold a drawn
+// tree plus the construct; nothing is cached before the first step.
+
+type cacheShape struct {
+	*cacheRun
+	dirs  []string
+	files []string
+	spot  string
+}
+
+func newCacheShape(ht *hegel.T, dir string) *cacheShape {
+	r := newCacheRun(ht, dir)
+	dirs, files, _ := hegel.Draw(ht, treeSpecs).build(r.base, r.ref)
+	return &cacheShape{cacheRun: r, dirs: dirs, files: files, spot: at(dirs, hegel.Draw(ht, positions))}
+}
+
+func cacheShapeProperty(t *testing.T, id string, fn func(ht *hegel.T, c *cacheShape)) {
+	t.Helper()
+	dirShape(t, id, func(ht *hegel.T, dir string) {
+		c := newCacheShape(ht, dir)
+		defer c.p.recoverPanics()
+		fn(ht, c)
+	})
+}
+
+func (c *cacheShape) fresh(ht *hegel.T) string { return childOf(c.spot, hegel.Draw(ht, shapeName)) }
+
+func (c *cacheShape) addDir(p string) {
+	for _, f := range []afero.Fs{c.base, c.ref} {
+		if err := f.MkdirAll(p, 0o755); err != nil {
+			panic(err)
+		}
+	}
+}
+
+func (c *cacheShape) addFile(p string, data []byte, perm os.FileMode) {
+	for _, f := range []afero.Fs{c.base, c.ref} {
+		if err := afero.WriteFile(f, p, data, 0o644); err != nil {
+			panic(err)
+		}
+		if perm != 0o644 {
+			if err := f.Chmod(p, perm); err != nil {
+				panic(err)
+			}
+		}
+	}
+}
+
+func (c *cacheShape) run(s wrapStep, q, q2 string) bool {
+	res := c.step(s, q, q2)
+	return res != stepFail && (res != stepRan || c.check())
+}
