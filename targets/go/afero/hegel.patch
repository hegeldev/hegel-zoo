+)
+
+var time0 = time.Unix(1_000_000_000, 0)
+
+// wrapStep is one operation of a wrapper property; only the fields the
+// operation uses are drawn.
+type wrapStep struct {
+	Op       string
+	Path     pathPick
+	Path2    pathPick // Rename destination
+	Flag     int      // ReadOnlyFs.OpenFile
+	Data     []byte
+	DirMode  os.FileMode
+	FileMode os.FileMode
+	Paged    bool // RegexpFile.Readdirnames in pages of two
+}
+
+func (s wrapStep) GoString() string {
+	switch s.Op {
+	case "Rename":
+		return fmt.Sprintf("Rename(%#v, %#v)", s.Path, s.Path2)
+	case "OpenFile":
+		return fmt.Sprintf("OpenFile(%#v, %s)", s.Path, flagString(s.Flag))
+	case "WriteFile", "CreateWrite":
+		return fmt.Sprintf("%s(%#v, %q)", s.Op, s.Path, s.Data)
+	case "Chmod":
+		if s.DirMode != 0 {
+			return fmt.Sprintf("Chmod(%#v, dir %o / file %o)", s.Path, s.DirMode, s.FileMode)
+		}
+	case "List":
+		return fmt.Sprintf("List(%#v, paged %v)", s.Path, s.Paged)
+	}
+	return fmt.Sprintf("%s(%#v)", s.Op, s.Path)
+}
+
+func wrapStepOf(op string, fields func(tc hegel.TestCase, s *wrapStep)) hegel.Generator[wrapStep] {
+	return hegel.Composite(func(tc hegel.TestCase) wrapStep {
+		s := wrapStep{Op: op, Path: hegel.Draw(tc, pathPicks)}
+		if fields != nil {
+			fields(tc, &s)
+		}
+		return s
+	})
+}
+
+func plain(op string) choice[wrapStep] { return choice[wrapStep]{1, wrapStepOf(op, nil)} }
+
+var withDest = func(tc hegel.TestCase, s *wrapStep) { s.Path2 = hegel.Draw(tc, pathPicks) }
+
+var withData = func(tc hegel.TestCase, s *wrapStep) { s.Data = hegel.Draw(tc, dataBytes) }
+
+var withModes = func(tc hegel.TestCase, s *wrapStep) {
+	s.DirMode = hegel.Draw(tc, hegel.SampledFrom([]os.FileMode{0o700, 0o755}))
+	s.FileMode = hegel.Draw(tc, hegel.SampledFrom([]os.FileMode{0o600, 0o644, 0o700}))
+}
+
+// wrapCase is the case of a wrapper property: a tree and a script.
+type wrapCase struct {
+	Tree  treeSpec
+	Steps []wrapStep
+}
+
+func (c wrapCase) GoString() string {
+	var b strings.Builder
+	b.WriteString("wrapCase{\n\t" + c.Tree.GoString())
+	for _, s := range c.Steps {
+		b.WriteString("\n\t" + s.GoString())
+	}
+	b.WriteString("\n}")
+	return b.String()
+}
+
+func wrapCases(steps hegel.Generator[wrapStep], lo, hi int) hegel.Generator[wrapCase] {
+	return hegel.Composite(func(tc hegel.TestCase) wrapCase {
+		return wrapCase{Tree: hegel.Draw(tc, treeSpecs), Steps: hegel.Draw(tc, many(steps, lo, hi))}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// ReadOnlyFs.
+
+var roSteps = weighted(
+	plain("Read"),
+	plain("Create"),
+	plain("Mkdir"),
+	plain("MkdirAll"),
+	plain("Remove"),
+	plain("RemoveAll"),
+	choice[wrapStep]{1, wrapStepOf("Rename", withDest)},
+	plain("Chmod"),
+	plain("Chtimes"),
+	choice[wrapStep]{1, wrapStepOf("OpenFile", func(tc hegel.TestCase, s *wrapStep) {
+		s.Flag = hegel.Draw(tc, hegel.SampledFrom([]int{os.O_WRONLY, os.O_RDWR, os.O_RDONLY | os.O_CREATE, os.O_RDONLY | os.O_APPEND, os.O_RDONLY | os.O_TRUNC}))
+	})},
+)
+
+var roCases = wrapCases(roSteps, 1, 8)
+
+// TestHegelReadOnlyFsRefusesEveryWrite: on a ReadOnlyFs every mutating call
+// returns EPERM and leaves the source unchanged (MkdirAll of an existing
+// directory is the documented exception), and every reading call answers
+// like the source.
+func TestHegelReadOnlyFsRefusesEveryWrite(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, roCases)
+		src := afero.NewMemMapFs()
+		dirs, files, _ := c.Tree.build(src)
+		ro := afero.NewReadOnlyFs(src)
+		before, _ := snapshot(src)
+		for _, s := range c.Steps {
+			q := s.Path.resolve(dirs, files)
+			isDir, _ := afero.IsDir(src, q)
+			var err error
+			switch s.Op {
+			case "Create":
+				_, err = ro.Create(q)
+			case "Mkdir":
+				err = ro.Mkdir(q, 0o755)
+			case "MkdirAll":
+				err = ro.MkdirAll(q, 0o755)
+				if isDir {
+					if err != nil {
+						fail(ht, "ReadOnlyFs.MkdirAll(%s) of an existing directory: %v, want nil", q, err)
+						return
+					}
+					continue
+				}
+			case "Remove":
+				err = ro.Remove(q)
+			case "RemoveAll":
+				err = ro.RemoveAll(q)
+			case "Rename":
+				err = ro.Rename(q, s.Path2.resolve(dirs, files))
+			case "Chmod":
+				err = ro.Chmod(q, 0o600)
+			case "Chtimes":
+				err = ro.Chtimes(q, time0, time0)
+			case "OpenFile":
+				_, err = ro.OpenFile(q, s.Flag, 0o644)
+			default: // reads
+				sfi, serr := src.Stat(q)
+				rfi, rerr := ro.Stat(q)
+				if statSummary(sfi, serr, true) != statSummary(rfi, rerr, true) {
+					fail(ht, "ReadOnlyFs.Stat(%s) = %s, source %s", q, statSummary(rfi, rerr, true), statSummary(sfi, serr, true))
+					return
+				}
+				sd, serr := afero.ReadFile(src, q)
+				rd, rerr := afero.ReadFile(ro, q)
+				if errClass(serr) != errClass(rerr) || string(sd) != string(rd) {
+					fail(ht, "ReadOnlyFs.ReadFile(%s) = %q, %v; source %q, %v", q, rd, rerr, sd, serr)
+					return
+				}
+				sl, serr := afero.ReadDir(src, q)
+				rl, rerr := afero.ReadDir(ro, q)
+				if errClass(serr) != errClass(rerr) || dirList(sl) != dirList(rl) {
+					fail(ht, "ReadOnlyFs.ReadDir(%s) = %s, %v; source %s, %v", q, dirList(rl), rerr, dirList(sl), serr)
+					return
+				}
+				f, rerr := ro.OpenFile(q, os.O_RDONLY, 0)
+				_, serr = src.Open(q)
+				if errClass(serr) != errClass(rerr) {
+					fail(ht, "ReadOnlyFs.OpenFile(%s, O_RDONLY) = %v, source Open %v", q, rerr, serr)
+					return
+				}
+				if rerr == nil {
+					f.Close()
+				}
+				continue
+			}
+			note(ht, "%s(%s) = %v", s.Op, q, err)
+			if !errors.Is(err, syscall.EPERM) {
+				fail(ht, "ReadOnlyFs.%s(%s) = %v, want EPERM", s.Op, q, err)
+				return
+			}
+		}
+		after, _ := snapshot(src)
+		if joinEntries(before) != joinEntries(after) {
+			fail(ht, "the source changed under a ReadOnlyFs:\n%s\n->\n%s", joinEntries(before), joinEntries(after))
+		}
+	})
+}
