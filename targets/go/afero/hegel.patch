+var time0 = time.Unix(1_000_000_000, 0)
+
+// TestHegelReadOnlyFsRefusesEveryWrite: on a ReadOnlyFs every mutating call
+// returns EPERM and leaves the source unchanged (MkdirAll of an existing
+// directory is the documented exception), and every reading call answers
+// like the source.
+func TestHegelReadOnlyFsRefusesEveryWrite(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		src := afero.NewMemMapFs()
+		dirs, files, _ := buildTree(tc, src)
+		ro := afero.NewReadOnlyFs(src)
+		before, _ := snapshot(src)
+		for i, k := 0, n(tc, 1, 8); i < k; i++ {
+			q := anyPath(tc, dirs, files)
+			isDir, _ := afero.IsDir(src, q)
+			var err error
+			var op string
+			switch n(tc, 0, 11) {
+			case 0:
+				op, err = "Create", func() error { _, err := ro.Create(q); return err }()
+			case 1:
+				op, err = "Mkdir", ro.Mkdir(q, 0o755)
+			case 2:
+				op, err = "MkdirAll", ro.MkdirAll(q, 0o755)
+				if isDir {
+					if err != nil {
+						fail(ht, "ReadOnlyFs.MkdirAll(%s) of an existing directory: %v, want nil", q, err)
+						return
+					}
+					continue
+				}
+			case 3:
+				op, err = "Remove", ro.Remove(q)
+			case 4:
+				op, err = "RemoveAll", ro.RemoveAll(q)
+			case 5:
+				op, err = "Rename", ro.Rename(q, anyPath(tc, dirs, files))
+			case 6:
+				op, err = "Chmod", ro.Chmod(q, 0o600)
+			case 7:
+				op, err = "Chtimes", ro.Chtimes(q, time0, time0)
+			case 8:
+				flag := pick(tc, os.O_WRONLY, os.O_RDWR, os.O_RDONLY|os.O_CREATE, os.O_RDONLY|os.O_APPEND, os.O_RDONLY|os.O_TRUNC)
+				op, err = "OpenFile(write flags)", func() error { _, err := ro.OpenFile(q, flag, 0o644); return err }()
+			case 9: // reads
+				sfi, serr := src.Stat(q)
+				rfi, rerr := ro.Stat(q)
+				if statSummary(sfi, serr, true) != statSummary(rfi, rerr, true) {
+					fail(ht, "ReadOnlyFs.Stat(%s) = %s, source %s", q, statSummary(rfi, rerr, true), statSummary(sfi, serr, true))
+					return
+				}
+				sd, serr := afero.ReadFile(src, q)
+				rd, rerr := afero.ReadFile(ro, q)
+				if errClass(serr) != errClass(rerr) || string(sd) != string(rd) {
+					fail(ht, "ReadOnlyFs.ReadFile(%s) = %q, %v; source %q, %v", q, rd, rerr, sd, serr)
+					return
+				}
+				sl, serr := afero.ReadDir(src, q)
+				rl, rerr := afero.ReadDir(ro, q)
+				if errClass(serr) != errClass(rerr) || dirList(sl) != dirList(rl) {
+					fail(ht, "ReadOnlyFs.ReadDir(%s) = %s, %v; source %s, %v", q, dirList(rl), rerr, dirList(sl), serr)
+					return
+				}
+				f, rerr := ro.OpenFile(q, os.O_RDONLY, 0)
+				_, serr = src.Open(q)
+				if errClass(serr) != errClass(rerr) {
+					fail(ht, "ReadOnlyFs.OpenFile(%s, O_RDONLY) = %v, source Open %v", q, rerr, serr)
+					return
+				}
+				if rerr == nil {
+					f.Close()
+				}
+				continue
+			default:
+				continue
+			}
+			note(ht, "%s(%s) = %v", op, q, err)
+			if !errors.Is(err, syscall.EPERM) {
+				fail(ht, "ReadOnlyFs.%s(%s) = %v, want EPERM", op, q, err)
+				return
+			}
+		}
+		after, _ := snapshot(src)
+		if joinEntries(before) != joinEntries(after) {
+			fail(ht, "the source changed under a ReadOnlyFs:\n%s\n->\n%s", joinEntries(before), joinEntries(after))
+		}
+	})
+}
+
+// cowModel is the expected content of a CopyOnWriteFs: the base never
+// changes; the layer holds what was written; the view is the layer over the
+// base.
+type cowModel struct {
+	base, layer map[string]*entry // canonical path -> entry (dir or file)
+}
+
+func (m *cowModel) view(p string) *entry {
+	if e, ok := m.layer[p]; ok {
+		return e
+	}
+	return m.base[p]
+}
+
+func (m *cowModel) children(p string) []string {
+	seen := map[string]bool{}
+	for _, layer := range []map[string]*entry{m.layer, m.base} {
+		for q := range layer {
+			if path.Dir(q) == p && q != "/" {
+				seen[path.Base(q)] = true
+			}
+		}
+	}
+	var out []string
+	for name := range seen {
+		out = append(out, name)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// permUnknown marks a directory the layer recreated with some other mode
+// (afero/34): its permissions are not compared while the bug is known.
+const permUnknown os.FileMode = 0o7777
+
+// parentsIntoLayer records that a write below q made the CopyOnWriteFs
+// create q's base-only ancestors in the layer.
+func (m *cowModel) parentsIntoLayer(q string) {
+	for d := path.Dir(q); d != "/"; d = path.Dir(d) {
+		if m.layer[d] == nil && m.base[d] != nil {
+			ne := *m.base[d]
+			if Known.CowParentModeChanges {
+				ne.perm = permUnknown
+			}
+			m.layer[d] = &ne
+		}
+	}
+}
+
+func (m *cowModel) layerHasChildren(p string) bool {
+	for q := range m.layer {
+		if path.Dir(q) == p && q != "/" {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *cowModel) deleteSubtree(layer map[string]*entry, p string) {
+	for q := range layer {
+		if q == p || strings.HasPrefix(q, p+"/") {
+			delete(layer, q)
+		}
+	}
+}
+
+// TestHegelCopyOnWriteFsMatchesItsModel: a CopyOnWriteFs over two OsFs
+// directories behaves as the documented union: reads see the layer over the
+// base, writes go to the layer (copying a base file first), the base is never
+// modified, removing a layer copy exposes the base file again, and base-only
+// entries cannot be renamed.
+func TestHegelCopyOnWriteFsMatchesItsModel(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		os.Mkdir(dir+"/base", 0o755)
+		os.Mkdir(dir+"/layer", 0o755)
+		base := afero.NewBasePathFs(afero.NewOsFs(), dir+"/base")
+		layer := afero.NewBasePathFs(afero.NewOsFs(), dir+"/layer")
+		dirs, files, _ := buildTree(tc, base)
+		m := &cowModel{base: map[string]*entry{}, layer: map[string]*entry{}}
+		bs, _ := snapshot(base)
+		for i := range bs {
+			m.base[bs[i].path] = &bs[i]
+		}
+		m.base["/"] = &entry{path: "/", dir: true, perm: 0o755}
+		baseBefore := joinEntries(bs)
+		cow := afero.NewCopyOnWriteFs(base, layer)
+		for i, k := 0, n(tc, 1, 10); i < k; i++ {
+			q := canon(anyPath(tc, dirs, files))
+			cur := m.view(q)
+			parent := m.view(path.Dir(q))
+			parentIsDir := parent != nil && parent.dir
+			op := n(tc, 0, 9)
+			if q == "/" && op < 7 {
+				op = 8 // the root is only read
+			}
+			switch op {
+			case 0: // WriteFile
+				if Known.CowCopyLosesMode && cur != nil && !cur.dir && m.layer[q] == nil && cur.perm != 0o666 {
+					count(ht, "skip: write to a base-only file with a mode other than 0666 (afero/33)")
+					continue
+				}
+				data := genData(tc)
+				err := afero.WriteFile(cow, q, data, 0o600)
+				note(ht, "WriteFile(%s, %q) = %v", q, data, err)
+				switch {
+				case !parentIsDir || (cur != nil && cur.dir):
+					if err == nil {
+						fail(ht, "WriteFile(%s) succeeded (parent dir %v, existing dir %v)", q, parentIsDir, cur != nil && cur.dir)
+						return
+					}
+					if cur != nil && cur.dir && m.layer[q] == nil {
+						// The failed copy of the base directory already
+						// recreated its parents in the layer (afero/34).
+						m.parentsIntoLayer(q)
+					}
+				default:
+					if err != nil {
+						fail(ht, "WriteFile(%s): %v", q, err)
+						return
+					}
+					perm := os.FileMode(0o600)
+					if cur != nil {
+						perm = cur.perm
+					}
+					m.layer[q] = &entry{path: q, perm: perm, size: int64(len(data)), content: string(data)}
+					m.parentsIntoLayer(q)
+				}
+			case 1: // Mkdir
+				if Known.CowMkdirExisting && (!parentIsDir || (cur != nil && m.base[q] != nil && !m.base[q].dir) || (cur != nil && m.layer[q] != nil)) {
+					count(ht, "skip: Mkdir over a layer entry, a base file or without parent (afero/22)")
+					continue
+				}
+				err := cow.Mkdir(q, 0o700)
+				note(ht, "Mkdir(%s) = %v", q, err)
+				if cur != nil {
+					if err == nil {
+						fail(ht, "Mkdir(%s) over an existing entry succeeded", q)
+						return
+					}
+					continue
+				}
+				if err != nil {
+					fail(ht, "Mkdir(%s): %v", q, err)
+					return
+				}
+				m.layer[q] = &entry{path: q, dir: true, perm: 0o700}
+				m.parentsIntoLayer(q)
+			case 2: // MkdirAll
+				fileOnWay := false
+				for d := q; d != "/"; d = path.Dir(d) {
+					if e := m.view(d); e != nil && !e.dir {
+						fileOnWay = true
+					}
+				}
+				if Known.CowMkdirExisting && fileOnWay {
+					count(ht, "skip: MkdirAll over or through a file (afero/22)")
+					continue
+				}
+				err := cow.MkdirAll(q, 0o700)
+				note(ht, "MkdirAll(%s) = %v", q, err)
+				if err != nil {
+					fail(ht, "MkdirAll(%s): %v", q, err)
+					return
+				}
+				if cur == nil {
+					for d := q; d != "/"; d = path.Dir(d) {
+						if m.view(d) == nil {
+							m.layer[d] = &entry{path: d, dir: true, perm: 0o700}
+						}
+					}
+					m.parentsIntoLayer(q)
+				}
+			case 3: // Remove
+				if Known.CowRemoveBaseOnly && cur != nil && m.layer[q] == nil {
+					count(ht, "skip: Remove of a base-only entry (afero/21)")
+					continue
+				}
+				err := cow.Remove(q)
+				note(ht, "Remove(%s) = %v", q, err)
+				switch {
+				case cur == nil:
+					if !os.IsNotExist(err) {
+						fail(ht, "Remove(%s) of a missing path: %v", q, err)
+						return
+					}
+				case m.layer[q] != nil:
+					if m.layer[q].dir && m.layerHasChildren(q) {
+						if err == nil {
+							fail(ht, "Remove(%s) of a non-empty layer directory succeeded", q)
+							return
+						}
+						continue
+					}
+					if err != nil {
+						fail(ht, "Remove(%s) of a layer entry: %v", q, err)
+						return
+					}
+					delete(m.layer, q)
+				default:
+					if !errors.Is(err, syscall.EPERM) {
+						fail(ht, "Remove(%s) of a base-only entry = %v, want EPERM", q, err)
+						return
+					}
+				}
+			case 4: // RemoveAll
+				if Known.CowRemoveBaseOnly && cur != nil && m.layer[q] == nil {
+					count(ht, "skip: RemoveAll of a base-only entry (afero/21)")
+					continue
+				}
+				err := cow.RemoveAll(q)
+				note(ht, "RemoveAll(%s) = %v", q, err)
+				switch {
+				case cur == nil || m.layer[q] != nil:
+					if err != nil {
+						fail(ht, "RemoveAll(%s): %v", q, err)
+						return
+					}
+					m.deleteSubtree(m.layer, q)
+				default:
+					if !errors.Is(err, syscall.EPERM) {
+						fail(ht, "RemoveAll(%s) of a base-only entry = %v, want EPERM", q, err)
+						return
+					}
+				}
+			case 5: // Rename
+				q2 := canon(anyPath(tc, dirs, files))
+				dst := m.view(q2)
+				dstParent := m.view(path.Dir(q2))
+				if Known.CowRenameIntoBaseDir && m.layer[q] != nil && dstParent != nil && dstParent.dir && m.layer[path.Dir(q2)] == nil && path.Dir(q2) != "/" {
+					count(ht, "skip: Rename into a base-only directory (afero/37)")
+					continue
+				}
+				err := cow.Rename(q, q2)
+				note(ht, "Rename(%s, %s) = %v", q, q2, err)
+				switch {
+				case cur == nil:
+					if err == nil {
+						fail(ht, "Rename(%s, %s) of a missing path succeeded", q, q2)
+						return
+					}
+				case m.layer[q] == nil:
+					if !errors.Is(err, syscall.EPERM) {
+						fail(ht, "Rename(%s, %s) of a base-only entry = %v, want EPERM", q, q2, err)
+						return
+					}
+				case q == q2 || dst != nil || dstParent == nil || !dstParent.dir || strings.HasPrefix(q2, q+"/"):
+					// Plain os.Rename semantics on the layer are involved here
+					// (see the MemMapFs property for those); only require that
+					// a success moved the layer entry.
+					if err == nil {
+						moved := map[string]*entry{}
+						for p, e := range m.layer {
+							if p == q || strings.HasPrefix(p, q+"/") {
+								np := q2 + strings.TrimPrefix(p, q)
+								ne := *e
+								ne.path = np
+								moved[np] = &ne
+								delete(m.layer, p)
+							}
+						}
+						for p, e := range moved {
+							m.layer[p] = e
+						}
+					}
+				default:
+					if err != nil {
+						fail(ht, "Rename(%s, %s) of a layer entry into %s: %v", q, q2, path.Dir(q2), err)
+						return
+					}
+					for p, e := range m.layer {
+						if p == q || strings.HasPrefix(p, q+"/") {
+							np := q2 + strings.TrimPrefix(p, q)
+							ne := *e
+							ne.path = np
+							delete(m.layer, p)
+							m.layer[np] = &ne
+						}
+					}
+				}
+			case 6: // Chmod
+				mode := pick(tc, os.FileMode(0o600), 0o644, 0o700)
+				if cur != nil && cur.dir {
+					mode = pick(tc, os.FileMode(0o700), 0o755)
+				}
+				if cur != nil && cur.dir && m.layer[q] == nil && Known.CopyToLayerOfDir {
+					count(ht, "skip: Chmod of a base-only directory (afero/32)")
+					continue
+				}
+				err := cow.Chmod(q, mode)
+				note(ht, "Chmod(%s, %o) = %v", q, mode, err)
+				if cur == nil {
+					if err == nil {
+						fail(ht, "Chmod(%s) of a missing path succeeded", q)
+						return
+					}
+					continue
+				}
+				if err != nil {
+					fail(ht, "Chmod(%s): %v", q, err)
+					return
+				}
+				ne := *cur
+				ne.perm = mode
+				m.layer[q] = &ne
+				m.parentsIntoLayer(q)
+			default: // reads: Stat, ReadFile, Readdirnames, Exists
+				fi, err := cow.Stat(q)
+				ex, _ := afero.Exists(cow, q)
+				if cur == nil {
+					if err == nil || ex {
+						fail(ht, "Stat(%s) of a missing path: %v (Exists %v)", q, err, ex)
+						return
+					}
+					continue
+				}
+				if err != nil || fi.IsDir() != cur.dir || (!cur.dir && fi.Size() != cur.size) || (cur.perm != permUnknown && fi.Mode().Perm() != cur.perm) || !ex {
+					fail(ht, "Stat(%s) = %s, want dir=%v perm=%o size=%d", q, statSummary(fi, err, false), cur.dir, cur.perm, cur.size)
+					return
+				}
+				if cur.dir {
+					f, err := cow.Open(q)
+					if err != nil {
+						fail(ht, "Open(%s) of a directory: %v", q, err)
+						return
+					}
+					names, err := f.Readdirnames(-1)
+					sort.Strings(names)
+					cerr := f.Close()
+					if err != nil || fmt.Sprint(names) != fmt.Sprint(m.children(q)) {
+						fail(ht, "Readdirnames(%s) = %v, %v; want %v", q, names, err, m.children(q))
+						return
+					}
+					if cerr != nil {
+						if Known.UnionCloseBadFD && errors.Is(cerr, afero.BADFD) {
+							count(ht, "accepted: UnionFile.Close returned BADFD (afero/20)")
+						} else {
+							fail(ht, "Close of the directory %s: %v", q, cerr)
+							return
+						}
+					}
+				} else {
+					data, err := afero.ReadFile(cow, q)
+					if err != nil || string(data) != cur.content {
+						fail(ht, "ReadFile(%s) = %q, %v; want %q", q, data, err, cur.content)
+						return
+					}
+				}
+			}
+			// The base never changes.
+			bs, _ := snapshot(base)
+			if joinEntries(bs) != baseBefore {
+				fail(ht, "the base changed under the CopyOnWriteFs:\n%s\n->\n%s", baseBefore, joinEntries(bs))
+				return
+			}
+			// The view of every model path.
+			for _, e := range m.layer {
+				if !checkCowEntry(ht, cow, e) {
+					return
+				}
+			}
+			for p, e := range m.base {
+				if p != "/" && m.layer[p] == nil && !checkCowEntry(ht, cow, e) {
+					return
+				}
+			}
+		}
+	})
+}
+
+func checkCowEntry(ht *hegel.T, cow afero.Fs, e *entry) bool {
+	fi, err := cow.Stat(e.path)
+	if err != nil || fi.IsDir() != e.dir || (e.perm != permUnknown && fi.Mode().Perm() != e.perm) {
+		fail(ht, "view of %s: Stat %s, model %s", e.path, statSummary(fi, err, false), e.String())
+		return false
+	}
+	if !e.dir {
+		data, err := afero.ReadFile(cow, e.path)
+		if err != nil || string(data) != e.content {
+			fail(ht, "view of %s: content %q, %v; model %s", e.path, data, err, e.String())
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelCacheOnReadFsMirrorsTheBase: with an unlimited cache time, a
+// CacheOnReadFs over two OsFs directories answers every call like a plain
+// file system receiving the same calls, and its base holds exactly that
+// file system's tree.
+func TestHegelCacheOnReadFsMirrorsTheBase(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		for _, d := range []string{"base", "layer", "ref"} {
+			os.Mkdir(dir+"/"+d, 0o755)
+		}
+		base := afero.NewBasePathFs(afero.NewOsFs(), dir+"/base")
+		layer := afero.NewBasePathFs(afero.NewOsFs(), dir+"/layer")
+		ref := afero.NewBasePathFs(afero.NewOsFs(), dir+"/ref")
+		dirs, files, _ := buildTree(tc, base, ref)
+		cache := afero.NewCacheOnReadFs(base, layer, 0)
+		p := &pair{ht: ht, mem: cache, os: ref}
+		for i, k := 0, n(tc, 1, 10); i < k; i++ {
+			q := canon(anyPath(tc, dirs, files))
+			cached, _ := afero.Exists(layer, q)
+			kind := kindOf(ref, q)
+			op := n(tc, 0, 8)
+			if q == "/" {
+				op = 8 // the root is only read (below)
+			}
+			if Known.CowCopyLosesMode && (op == 0 || op == 7) && kind == kindFile && !cached && permOf(ref, q) != 0o666 {
+				count(ht, "skip: write to an uncached file with a mode other than 0666 (afero/33)")
+				continue
+			}
+			if Known.CacheWriteOnlyUncached && op == 0 && kind != kindDir && !cached {
+				count(ht, "skip: WriteFile of a file not in the layer (afero/36)")
+				continue
+			}
+			switch op {
+			case 0:
+				data := genData(tc)
+				note(ht, "WriteFile(%s, %q)", q, data)
+				cerr := afero.WriteFile(cache, q, data, 0o600)
+				if cerr != nil && Known.UnionCloseBadFD && errors.Is(cerr, afero.BADFD) {
+					count(ht, "accepted: WriteFile returned UnionFile.Close's BADFD (afero/20)")
+					cerr = nil
+				}
+				if !p.sameErr("WriteFile("+q+")", cerr, afero.WriteFile(ref, q, data, 0o600)) {
+					return
+				}
+			case 1:
+				note(ht, "Mkdir(%s)", q)
+				if !p.sameErr("Mkdir("+q+")", cache.Mkdir(q, 0o700), ref.Mkdir(q, 0o700)) {
+					return
+				}
+			case 2:
+				note(ht, "MkdirAll(%s)", q)
+				if !p.sameErr("MkdirAll("+q+")", cache.MkdirAll(q, 0o700), ref.MkdirAll(q, 0o700)) {
+					return
+				}
+			case 3:
+				if Known.CacheRemoveMiss && kind != kindMissing && !cached {
+					count(ht, "skip: Remove of an uncached entry (afero/23)")
+					continue
+				}
+				note(ht, "Remove(%s)", q)
+				if !p.sameErr("Remove("+q+")", cache.Remove(q), ref.Remove(q)) {
+					return
+				}
+			case 4:
+				note(ht, "RemoveAll(%s)", q)
+				if !p.sameErr("RemoveAll("+q+")", cache.RemoveAll(q), ref.RemoveAll(q)) {
+					return
+				}
+			case 5:
+				q2 := canon(anyPath(tc, dirs, files))
+				if kind == kindDir && !cached && Known.CopyToLayerOfDir {
+					count(ht, "skip: Rename of an uncached directory (afero/32)")
+					continue
+				}
+				if parentCached, _ := afero.Exists(layer, path.Dir(q2)); !parentCached && kind != kindMissing && Known.CacheCreateInBaseDir {
+					count(ht, "skip: Rename into a directory not in the layer (afero/38)")
+					continue
+				}
+				note(ht, "Rename(%s, %s)", q, q2)
+				if !p.sameErr("Rename("+q+", "+q2+")", cache.Rename(q, q2), ref.Rename(q, q2)) {
+					return
+				}
+			case 6:
+				mode := pick(tc, os.FileMode(0o600), 0o644, 0o700)
+				if kind == kindDir {
+					mode = pick(tc, os.FileMode(0o700), 0o755)
+				}
+				if kind == kindDir && !cached && Known.CopyToLayerOfDir {
+					count(ht, "skip: Chmod of an uncached directory (afero/32)")
+					continue
+				}
+				note(ht, "Chmod(%s, %o)", q, mode)
+				if !p.sameErr("Chmod("+q+")", cache.Chmod(q, mode), ref.Chmod(q, mode)) {
+					return
+				}
+			default: // Create + Write + Close through the union
+				if kind == kindDir || kindOf(ref, path.Dir(q)) != kindDir {
+					continue
+				}
+				if parentCached, _ := afero.Exists(layer, path.Dir(q)); !parentCached && Known.CacheCreateInBaseDir {
+					count(ht, "skip: Create in a directory not in the layer (afero/38)")
+					continue
+				}
+				data := genData(tc)
+				note(ht, "Create(%s) + Write(%q)", q, data)
+				cf, cerr := cache.Create(q)
+				rf, rerr := ref.Create(q)
+				if !p.sameErr("Create("+q+")", cerr, rerr) {
+					return
+				}
+				if cerr != nil {
+					continue
+				}
+				_, cerr = cf.Write(data)
+				_, rerr = rf.Write(data)
+				if !p.sameErr("Write", cerr, rerr) {
+					return
+				}
+				cerr, rerr = cf.Close(), rf.Close()
+				if cerr != nil && Known.UnionCloseBadFD && errors.Is(cerr, afero.BADFD) {
+					count(ht, "accepted: UnionFile.Close returned BADFD (afero/20)")
+					cerr = nil
+				}
+				if !p.sameErr("Close", cerr, rerr) {
+					return
+				}
+			}
+			// The base is the reference tree; the cache answers like it.
+			bs, _ := snapshot(base)
+			rs, _ := snapshot(ref)
+			// Directories recreated in the layer carry another mode
+			// (afero/34), files copied into it 0666 (afero/33), and Stat
+			// prefers the layer's FileInfo: those modes are not compared.
+			hidePerms(bs)
+			hidePerms(rs)
+			if joinEntries(bs) != joinEntries(rs) {
+				fail(ht, "base differs from the reference:\n%s\n->\n%s", joinEntries(bs), joinEntries(rs))
+				return
+			}
+			for _, e := range rs {
+				fi, err := cache.Stat(e.path)
+				if err != nil || fi.IsDir() != e.dir || (e.perm != permUnknown && fi.Mode().Perm() != e.perm) {
+					fail(ht, "cache.Stat(%s) = %s, reference %s", e.path, statSummary(fi, err, false), e.String())
+					return
+				}
+				if !e.dir {
+					data, err := afero.ReadFile(cache, e.path)
+					if err != nil || string(data) != e.content {
+						fail(ht, "cache.ReadFile(%s) = %q, %v; reference %s", e.path, data, err, e.String())
+						return
+					}
+				}
+			}
+			cs, err := snapshot(cache)
+			if err != nil {
+				fail(ht, "walking the cache: %v", err)
+				return
+			}
+			hidePerms(cs)
+			if joinEntries(cs) != joinEntries(rs) {
+				fail(ht, "the cache's tree differs from the reference:\n%s\n->\n%s", joinEntries(cs), joinEntries(rs))
+				return
+			}
+		}
+	})
+}
+
+// hidePerms marks the modes the known layer bugs change as not compared.
+func hidePerms(es []entry) {
+	for i := range es {
+		if (es[i].dir && Known.CowParentModeChanges) || (!es[i].dir && Known.CowCopyLosesMode) {
+			es[i].perm = permUnknown
+		}
+	}
+}
+
+var regexps = []*regexp.Regexp{
+	regexp.MustCompile(`\.txt$`),
+	regexp.MustCompile(`^[ab]`),
+	regexp.MustCompile(`.`),
+	regexp.MustCompile(`^c`),
+}
+
+// TestHegelRegexpFsHidesTheOtherFiles: a RegexpFs shows every directory and
+// exactly the files whose name matches; an operation on a hidden or
+// non-matching file name fails with ENOENT and touches nothing; every other
+// operation acts as on the source.
+func TestHegelRegexpFsHidesTheOtherFiles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		src := afero.NewMemMapFs()
+		ref := afero.NewMemMapFs()
+		dirs, files, _ := buildTree(tc, src, ref)
+		re := pick(tc, regexps...)
+		rfs := afero.NewRegexpFs(src, re)
+		visible := func(q string) bool {
+			isDir, _ := afero.IsDir(ref, q)
+			return isDir || re.MatchString(path.Base(q))
+		}
+		p := &pair{ht: ht, mem: rfs, os: ref}
+		note(ht, "regexp %v", re)
+		for i, k := 0, n(tc, 1, 8); i < k; i++ {
+			q := canon(anyPath(tc, dirs, files))
+			kind := kindOf(ref, q)
+			vis := visible(q)
+			if q == "/" {
+				continue
+			}
+			// An operation on a hidden path fails with ENOENT and does nothing.
+			check := func(op string, rerr error, refOp func() error) bool {
+				if !vis {
+					if !os.IsNotExist(rerr) {
+						fail(ht, "RegexpFs.%s(%s) on a hidden name (%v): %v, want ENOENT", op, q, re, rerr)
+						return false
+					}
+					return true
+				}
+				return p.sameErr("RegexpFs."+op+"("+q+")", rerr, refOp())
+			}
+			switch n(tc, 0, 9) {
+			case 0:
+				if !check("Stat", func() error { _, err := rfs.Stat(q); return err }(), func() error { _, err := ref.Stat(q); return err }) {
+					return
+				}
+			case 1:
+				d, err := afero.ReadFile(rfs, q)
+				if !check("ReadFile", err, func() error {
+					rd, rerr := afero.ReadFile(ref, q)
+					if rerr == nil && string(rd) != string(d) {
+						return errors.New("content differs")
+					}
+					return rerr
+				}) {
+					return
+				}
+			case 2:
+				if kind == kindDir && Known.RemoveNonEmptyDir && hasChildren(ref, q) {
+					count(ht, "skip: Remove of a non-empty directory (afero/3)")
+					continue
+				}
+				if !check("Remove", rfs.Remove(q), func() error { return ref.Remove(q) }) {
+					return
+				}
+			case 3:
+				if kind == kindDir && Known.RemoveNonEmptyDir && hasChildren(ref, q) {
+					continue
+				}
+				if kind == kindMissing && Known.RegexpRemoveAllMissing {
+					count(ht, "skip: RemoveAll of a missing path (afero/35)")
+					continue
+				}
+				if !check("RemoveAll", rfs.RemoveAll(q), func() error { return ref.RemoveAll(q) }) {
+					return
+				}
+			case 4:
+				if !check("Chmod", rfs.Chmod(q, 0o600), func() error { return ref.Chmod(q, 0o600) }) {
+					return
+				}
+			case 5: // Create of a new or existing name (directories excluded: MemMapFs afero/6)
+				if kind == kindDir || kindOf(ref, path.Dir(q)) != kindDir {
+					continue
+				}
+				vis = re.MatchString(path.Base(q))
+				f, err := rfs.Create(q)
+				if err == nil {
+					f.Close()
+				}
+				if !check("Create", err, func() error {
+					f, err := ref.Create(q)
+					if err == nil {
+						f.Close()
+					}
+					return err
+				}) {
+					return
+				}
+			case 6: // OpenFile(O_CREATE) of an existing or new matching name
+				if kind == kindDir || kindOf(ref, path.Dir(q)) != kindDir {
+					continue
+				}
+				if kind == kindMissing && Known.RegexpOpenFileCreate {
+					count(ht, "skip: OpenFile(O_CREATE) of a new file (afero/25)")
+					continue
+				}
+				f, err := rfs.OpenFile(q, os.O_RDWR|os.O_CREATE, 0o644)
+				if err == nil {
+					f.Close()
+				}
+				if !check("OpenFile", err, func() error {
+					f, err := ref.OpenFile(q, os.O_RDWR|os.O_CREATE, 0o644)
+					if err == nil {
+						f.Close()
+					}
+					return err
+				}) {
+					return
+				}
+			case 7: // Rename
+				q2 := canon(anyPath(tc, dirs, files))
+				if kind == kindDir {
+					if Known.RegexpRenameDir {
+						count(ht, "skip: Rename of a directory (afero/24)")
+						continue
+					}
+				}
+				if kind == kindMissing || kindOf(ref, q2) != kindMissing || kindOf(ref, path.Dir(q2)) != kindDir {
+					continue
+				}
+				vis = vis && re.MatchString(path.Base(q2))
+				if !check("Rename", rfs.Rename(q, q2), func() error { return ref.Rename(q, q2) }) {
+					return
+				}
+			default: // directory listing
+				if kind != kindDir {
+					continue
+				}
+				f, err := rfs.Open(q)
+				if err != nil {
+					fail(ht, "RegexpFs.Open(%s) of a directory: %v", q, err)
+					return
+				}
+				var names []string
+				if Known.RegexpReaddirEmptyPage || chance(tc, 50) {
+					names, err = f.Readdirnames(-1)
+				} else {
+					for {
+						page, perr := f.Readdirnames(2)
+						names = append(names, page...)
+						if perr != nil {
+							break
+						}
+						if len(page) == 0 {
+							fail(ht, "RegexpFile.Readdirnames(2) returned an empty page with a nil error")
+							return
+						}
+					}
+				}
+				f.Close()
+				if err != nil {
+					fail(ht, "RegexpFile.Readdirnames(%s): %v", q, err)
+					return
+				}
+				var want []string
+				rl, _ := afero.ReadDir(ref, q)
+				for _, fi := range rl {
+					if fi.IsDir() || re.MatchString(fi.Name()) {
+						want = append(want, fi.Name())
+					}
+				}
+				sort.Strings(names)
+				if fmt.Sprint(names) != fmt.Sprint(want) {
+					fail(ht, "RegexpFile.Readdirnames(%s) = %v, want %v", q, names, want)
+					return
+				}
+			}
+			// The source is the reference (hidden names were never touched)
+			// and the RegexpFs shows the reference minus the hidden files.
+			ss, _ := snapshot(src)
+			rs, _ := snapshot(ref)
+			if joinEntries(ss) != joinEntries(rs) {
+				fail(ht, "source differs from the reference:\n%s\n->\n%s", joinEntries(ss), joinEntries(rs))
+				return
+			}
+			var want []entry
+			for _, e := range rs {
+				if e.dir || re.MatchString(path.Base(e.path)) {
+					want = append(want, e)
+				}
+			}
+			got, err := snapshot(rfs)
+			if err != nil || joinEntries(got) != joinEntries(want) {
+				fail(ht, "walking the RegexpFs (%v): %v\n%s\nwant\n%s", re, err, joinEntries(got), joinEntries(want))
+				return
+			}
+		}
+	})
+}
