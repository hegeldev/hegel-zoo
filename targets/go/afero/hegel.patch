+// TestHegelCreateTruncatesInPlace: Create of an existing file with a mode
+// other than 0666 (its mode must stay), or a second Create of a file whose
+// first handle is still open (both handles must see one file) (afero/15).
+func TestHegelCreateTruncatesInPlace(t *testing.T) {
+	memShape(t, "afero/15", func(ht *hegel.T, r *memRun) {
+		if !r.quiet(ht) {
+			return
+		}
+		f := r.fresh(ht)
+		if !hegel.Draw(ht, chance(40)) {
+			r.write(f, hegel.Draw(ht, dataBytes), hegel.Draw(ht, hegel.SampledFrom([]os.FileMode{0o644, 0o600, 0o755})))
+			var ops []handleOp
+			for _, d := range hegel.Draw(ht, many(nonEmptyData, 0, 2)) {
+				ops = append(ops, handleOp{Op: "Write", Data: d})
+			}
+			r.run(memStep{Op: "Create", Path: spec(f, hegel.Draw(ht, pathDecos)), Handle: ops})
+			return
+		}
+		p := r.p
+		d1 := hegel.Draw(ht, many(hegel.SampledFrom([]byte("abc")), 1, 6))
+		d2 := hegel.Draw(ht, many(hegel.SampledFrom([]byte("xyz")), 0, 6))
+		if !p.gate(known("afero/15")) {
+			return
+		}
+		note(ht, "Create(%q) twice, Write(%q) through the second, Write(%q) through the first", f, d2, d1)
+		m1, merr := p.mem.Create(f)
+		o1, oerr := p.os.Create(f)
+		if !p.sameErr("first Create("+f+")", merr, oerr) {
+			return
+		}
+		m2, merr := p.mem.Create(f)
+		o2, oerr := p.os.Create(f)
+		if !p.sameErr("second Create("+f+")", merr, oerr) {
+			return
+		}
+		m2.Write(d2)
+		o2.Write(d2)
+		if !p.sameErr("Close of the second handle", m2.Close(), o2.Close()) {
+			return
+		}
+		mn, merr := m1.Write(d1)
+		on, oerr := o1.Write(d1)
+		if !p.sameErr("Write through the first handle", merr, oerr) || !p.same("Write count", mn, on) {
+			return
+		}
+		if !p.sameErr("Close of the first handle", m1.Close(), o1.Close()) {
+			return
+		}
+		md, _ := afero.ReadFile(p.mem, f)
+		od, _ := afero.ReadFile(p.os, f)
+		if !p.same("ReadFile("+f+") after writes through both handles", string(md), string(od)) {
+			return
+		}
+		p.checkTrees()
+	})
+}
