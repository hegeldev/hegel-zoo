+// ---------------------------------------------------------------------------
+// CopyOnWriteFs.
+
+// cowModel is the expected content of a CopyOnWriteFs: the base never
+// changes; the layer holds what was written; the view is the layer over the
+// base.
+type cowModel struct {
+	base, layer map[string]*entry // canonical path -> entry (dir or file)
+}
+
+func (m *cowModel) view(p string) *entry {
+	if e, ok := m.layer[p]; ok {
+		return e
+	}
+	return m.base[p]
+}
+
+func (m *cowModel) children(p string) []string {
+	seen := map[string]bool{}
+	for _, layer := range []map[string]*entry{m.layer, m.base} {
+		for q := range layer {
+			if path.Dir(q) == p && q != "/" {
+				seen[path.Base(q)] = true
+			}
+		}
+	}
+	var out []string
+	for name := range seen {
+		out = append(out, name)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// permUnknown marks a directory the layer recreated with some other mode
+// (afero/34) or a file it copied with mode 0666 (afero/33): while the bugs
+// are switched off (HEGEL_NO_KNOWN=1) such permissions are not compared.
+const permUnknown os.FileMode = 0o7777
+
+// parentsIntoLayer records that a write below q made the CopyOnWriteFs
+// create q's base-only ancestors in the layer, and reports whether it did
+// (the shape of afero/34: the copies carry another mode).
+func (m *cowModel) parentsIntoLayer(q string) (recreated bool) {
+	for d := path.Dir(q); d != "/"; d = path.Dir(d) {
+		if m.layer[d] == nil && m.base[d] != nil {
+			ne := *m.base[d]
+			if noKnown {
+				ne.perm = permUnknown
+			}
+			m.layer[d] = &ne
+			recreated = true
+		}
+	}
+	return recreated
+}
+
+func (m *cowModel) layerHasChildren(p string) bool {
+	for q := range m.layer {
+		if path.Dir(q) == p && q != "/" {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *cowModel) deleteSubtree(layer map[string]*entry, p string) {
+	for q := range layer {
+		if q == p || strings.HasPrefix(q, p+"/") {
+			delete(layer, q)
+		}
+	}
+}
+
+// moveSubtree renames the layer entries at or below q to q2.
+func (m *cowModel) moveSubtree(q, q2 string) {
+	moved := map[string]*entry{}
+	for p, e := range m.layer {
+		if p == q || strings.HasPrefix(p, q+"/") {
+			np := q2 + strings.TrimPrefix(p, q)
+			ne := *e
+			ne.path = np
+			moved[np] = &ne
+			delete(m.layer, p)
+		}
+	}
+	for p, e := range moved {
+		m.layer[p] = e
+	}
+}
+
+var cowSteps = weighted(
+	choice[wrapStep]{3, wrapStepOf("Read", nil)},
+	choice[wrapStep]{1, wrapStepOf("WriteFile", withData)},
+	plain("Mkdir"),
+	plain("MkdirAll"),
+	plain("Remove"),
+	plain("RemoveAll"),
+	choice[wrapStep]{1, wrapStepOf("Rename", withDest)},
+	choice[wrapStep]{1, wrapStepOf("Chmod", withModes)},
+)
+
+var cowCases = wrapCases(cowSteps, 1, 10)
+
+// TestHegelCopyOnWriteFsMatchesItsModel: a CopyOnWriteFs over two OsFs
+// directories behaves as the documented union: reads see the layer over the
+// base, writes go to the layer (copying a base file first), the base is never
+// modified, removing a layer copy exposes the base file again, and base-only
+// entries cannot be renamed. The root is only read.
+func TestHegelCopyOnWriteFsMatchesItsModel(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cowCases)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		r := newCowRun(ht, dir)
+		defer r.p.recoverPanics()
+		dirs, files, _ := c.Tree.build(r.base)
+		r.start()
+		for _, s := range c.Steps {
+			q := canon(s.Path.resolve(dirs, files))
+			q2 := ""
+			if s.Op == "Rename" {
+				q2 = canon(s.Path2.resolve(dirs, files))
+			}
+			if res := r.step(s, q, q2); res == stepFail || (res == stepRan && !r.check()) {
+				return
+			}
+		}
+	})
+}
+
+// The result of one step of a wrapper property: it failed (the case ends),
+// it was a no-op (the checks are skipped, as the wide properties skip them),
+// or it ran (the checks follow).
+const (
+	stepFail = iota
+	stepSkip
+	stepRan
+)
+
+// cowRun is the state of one case of the CopyOnWriteFs property: the union
+// over two OsFs directories under dir and its model.
+type cowRun struct {
+	p          *pair
+	m          *cowModel
+	cow        afero.Fs
+	base       afero.Fs
+	layer      afero.Fs
+	baseBefore string
+}
+
+// newCowRun makes the two directories and the union; the base tree is built
+// by the caller before start.
+func newCowRun(ht *hegel.T, dir string) *cowRun {
+	os.Mkdir(dir+"/base", 0o755)
+	os.Mkdir(dir+"/layer", 0o755)
+	base := afero.NewBasePathFs(afero.NewOsFs(), dir+"/base")
+	layer := afero.NewBasePathFs(afero.NewOsFs(), dir+"/layer")
+	cow := afero.NewCopyOnWriteFs(base, layer)
+	return &cowRun{p: &pair{ht: ht, mem: cow, os: base}, cow: cow, base: base, layer: layer}
+}
+
+// start records the built base tree in the model.
+func (r *cowRun) start() {
+	r.m = &cowModel{base: map[string]*entry{}, layer: map[string]*entry{}}
+	bs, _ := snapshot(r.base)
+	for i := range bs {
+		r.m.base[bs[i].path] = &bs[i]
+	}
+	r.m.base["/"] = &entry{path: "/", dir: true, perm: 0o755}
+	r.baseBefore = joinEntries(bs)
+}
+
+// step applies one operation (on the canonical path q, and q2 for a Rename)
+// to the union and the model.
+func (r *cowRun) step(s wrapStep, q, q2 string) int {
+	p, m, cow, ht := r.p, r.m, r.cow, r.p.ht
+	p.shapes = nil
+	cur := m.view(q)
+	parent := m.view(path.Dir(q))
+	parentIsDir := parent != nil && parent.dir
+	op := s.Op
+	if q == "/" {
+		op = "Read"
+	}
+	switch op {
+	case "WriteFile":
+		if !p.gate(shapeIf(cur != nil && !cur.dir && m.layer[q] == nil && cur.perm != 0o666, "afero/33")) {
+			return stepSkip
+		}
+		err := afero.WriteFile(cow, q, s.Data, 0o600)
+		note(ht, "WriteFile(%s, %q) = %v", q, s.Data, err)
+		switch {
+		case !parentIsDir || (cur != nil && cur.dir):
+			if err == nil {
+				p.fail("WriteFile(%s) succeeded (parent dir %v, existing dir %v)", q, parentIsDir, cur != nil && cur.dir)
+				return stepFail
+			}
+			if cur != nil && cur.dir && m.layer[q] == nil {
+				// The failed copy of the base directory already
+				// recreated its parents in the layer (afero/34).
+				if m.parentsIntoLayer(q) {
+					p.accept("afero/34")
+				}
+			}
+		default:
+			if err != nil {
+				p.fail("WriteFile(%s): %v", q, err)
+				return stepFail
+			}
+			perm := os.FileMode(0o600)
+			if cur != nil {
+				perm = cur.perm
+			}
+			m.layer[q] = &entry{path: q, perm: perm, size: int64(len(s.Data)), content: string(s.Data)}
+			if m.parentsIntoLayer(q) {
+				p.accept("afero/34")
+			}
+		}
+	case "Mkdir":
+		if !p.gate(shapeIf(!parentIsDir || (cur != nil && m.base[q] != nil && !m.base[q].dir) || (cur != nil && m.layer[q] != nil), "afero/22")) {
+			return stepSkip
+		}
+		err := cow.Mkdir(q, 0o700)
+		note(ht, "Mkdir(%s) = %v", q, err)
+		if cur != nil {
+			if err == nil {
+				p.fail("Mkdir(%s) over an existing entry succeeded", q)
+				return stepFail
+			}
+			return stepSkip
+		}
+		if err != nil {
+			p.fail("Mkdir(%s): %v", q, err)
+			return stepFail
+		}
+		m.layer[q] = &entry{path: q, dir: true, perm: 0o700}
+		if m.parentsIntoLayer(q) {
+			p.accept("afero/34")
+		}
+	case "MkdirAll":
+		fileOnWay := false
+		for d := q; d != "/"; d = path.Dir(d) {
+			if e := m.view(d); e != nil && !e.dir {
+				fileOnWay = true
+			}
+		}
+		if !p.gate(shapeIf(fileOnWay, "afero/22")) {
+			return stepSkip
+		}
+		err := cow.MkdirAll(q, 0o700)
+		note(ht, "MkdirAll(%s) = %v", q, err)
+		if err != nil {
+			p.fail("MkdirAll(%s): %v", q, err)
+			return stepFail
+		}
+		if cur == nil {
+			for d := q; d != "/"; d = path.Dir(d) {
+				if m.view(d) == nil {
+					m.layer[d] = &entry{path: d, dir: true, perm: 0o700}
+				}
+			}
+			if m.parentsIntoLayer(q) {
+				p.accept("afero/34")
+			}
+		}
+	case "Remove":
+		if !p.gate(shapeIf(cur != nil && m.layer[q] == nil, "afero/21")) {
+			return stepSkip
+		}
+		err := cow.Remove(q)
+		note(ht, "Remove(%s) = %v", q, err)
+		switch {
+		case cur == nil:
+			if !os.IsNotExist(err) {
+				p.fail("Remove(%s) of a missing path: %v", q, err)
+				return stepFail
+			}
+		case m.layer[q] != nil:
+			if m.layer[q].dir && m.layerHasChildren(q) {
+				if err == nil {
+					p.fail("Remove(%s) of a non-empty layer directory succeeded", q)
+					return stepFail
+				}
+				return stepSkip
+			}
+			if err != nil {
+				p.fail("Remove(%s) of a layer entry: %v", q, err)
+				return stepFail
+			}
+			delete(m.layer, q)
+		default:
+			if !errors.Is(err, syscall.EPERM) {
+				p.fail("Remove(%s) of a base-only entry = %v, want EPERM", q, err)
+				return stepFail
+			}
+		}
+	case "RemoveAll":
+		if !p.gate(shapeIf(cur != nil && m.layer[q] == nil, "afero/21")) {
+			return stepSkip
+		}
+		err := cow.RemoveAll(q)
+		note(ht, "RemoveAll(%s) = %v", q, err)
+		switch {
+		case cur == nil || m.layer[q] != nil:
+			if err != nil {
+				p.fail("RemoveAll(%s): %v", q, err)
+				return stepFail
+			}
+			m.deleteSubtree(m.layer, q)
+		default:
+			if !errors.Is(err, syscall.EPERM) {
+				p.fail("RemoveAll(%s) of a base-only entry = %v, want EPERM", q, err)
+				return stepFail
+			}
+		}
+	case "Rename":
+		dst := m.view(q2)
+		dstParent := m.view(path.Dir(q2))
+		if !p.gate(shapeIf(m.layer[q] != nil && dstParent != nil && dstParent.dir && m.layer[path.Dir(q2)] == nil && path.Dir(q2) != "/", "afero/37")) {
+			return stepSkip
+		}
+		err := cow.Rename(q, q2)
+		note(ht, "Rename(%s, %s) = %v", q, q2, err)
+		switch {
+		case cur == nil:
+			if err == nil {
+				p.fail("Rename(%s, %s) of a missing path succeeded", q, q2)
+				return stepFail
+			}
+		case m.layer[q] == nil:
+			if !errors.Is(err, syscall.EPERM) {
+				p.fail("Rename(%s, %s) of a base-only entry = %v, want EPERM", q, q2, err)
+				return stepFail
+			}
+		case q == q2 || dst != nil || dstParent == nil || !dstParent.dir || strings.HasPrefix(q2, q+"/"):
+			// Plain os.Rename semantics on the layer are involved here
+			// (see the MemMapFs property for those); only require that
+			// a success moved the layer entry.
+			if err == nil {
+				m.moveSubtree(q, q2)
+			}
+		default:
+			if err != nil {
+				p.fail("Rename(%s, %s) of a layer entry into %s: %v", q, q2, path.Dir(q2), err)
+				return stepFail
+			}
+			m.moveSubtree(q, q2)
+		}
+	case "Chmod":
+		mode := s.FileMode
+		if cur != nil && cur.dir {
+			mode = s.DirMode
+		}
+		if !p.gate(shapeIf(cur != nil && cur.dir && m.layer[q] == nil, "afero/32")) {
+			return stepSkip
+		}
+		err := cow.Chmod(q, mode)
+		note(ht, "Chmod(%s, %o) = %v", q, mode, err)
+		if cur == nil {
+			if err == nil {
+				p.fail("Chmod(%s) of a missing path succeeded", q)
+				return stepFail
+			}
+			return stepSkip
+		}
+		if err != nil {
+			p.fail("Chmod(%s): %v", q, err)
+			return stepFail
+		}
+		ne := *cur
+		ne.perm = mode
+		m.layer[q] = &ne
+		if m.parentsIntoLayer(q) {
+			p.accept("afero/34")
+		}
+	default: // reads: Stat, ReadFile, Readdirnames, Exists
+		fi, err := cow.Stat(q)
+		ex, _ := afero.Exists(cow, q)
+		if cur == nil {
+			if err == nil || ex {
+				p.fail("Stat(%s) of a missing path: %v (Exists %v)", q, err, ex)
+				return stepFail
+			}
+			return stepSkip
+		}
+		if err != nil || fi.IsDir() != cur.dir || (!cur.dir && fi.Size() != cur.size) || (cur.perm != permUnknown && fi.Mode().Perm() != cur.perm) || !ex {
+			p.fail("Stat(%s) = %s, want dir=%v perm=%o size=%d", q, statSummary(fi, err, false), cur.dir, cur.perm, cur.size)
+			return stepFail
+		}
+		if cur.dir {
+			f, err := cow.Open(q)
+			if err != nil {
+				p.fail("Open(%s) of a directory: %v", q, err)
+				return stepFail
+			}
+			names, err := f.Readdirnames(-1)
+			sort.Strings(names)
+			cerr := f.Close()
+			if err != nil || fmt.Sprint(names) != fmt.Sprint(m.children(q)) {
+				p.fail("Readdirnames(%s) = %v, %v; want %v", q, names, err, m.children(q))
+				return stepFail
+			}
+			if cerr != nil && !(errors.Is(cerr, afero.BADFD) && p.accept("afero/20")) {
+				p.fail("Close of the directory %s: %v", q, cerr)
+				return stepFail
+			}
+		} else {
+			data, err := afero.ReadFile(cow, q)
+			if err != nil || string(data) != cur.content {
+				p.fail("ReadFile(%s) = %q, %v; want %q", q, data, err, cur.content)
+				return stepFail
+			}
+		}
+	}
+	return stepRan
+}
+
+// check: the base never changes and the union shows the model's view of
+// every path.
+func (r *cowRun) check() bool {
+	p, m, cow, base, baseBefore := r.p, r.m, r.cow, r.base, r.baseBefore
+	// The base never changes.
+	bs, _ := snapshot(base)
+	if joinEntries(bs) != baseBefore {
+		p.fail("the base changed under the CopyOnWriteFs:\n%s\n->\n%s", baseBefore, joinEntries(bs))
+		return false
+	}
+	// The view of every model path.
+	for _, e := range m.layer {
+		if !checkCowEntry(p, cow, e) {
+			return false
+		}
+	}
+	for q, e := range m.base {
+		if q != "/" && m.layer[q] == nil && !checkCowEntry(p, cow, e) {
+			return false
+		}
+	}
+	return true
+}
+
+func checkCowEntry(p *pair, cow afero.Fs, e *entry) bool {
+	fi, err := cow.Stat(e.path)
+	if err != nil || fi.IsDir() != e.dir || (e.perm != permUnknown && fi.Mode().Perm() != e.perm) {
+		p.fail("view of %s: Stat %s, model %s", e.path, statSummary(fi, err, false), e.String())
+		return false
+	}
+	if !e.dir {
+		data, err := afero.ReadFile(cow, e.path)
+		if err != nil || string(data) != e.content {
+			p.fail("view of %s: content %q, %v; model %s", e.path, data, err, e.String())
+			return false
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// CacheOnReadFs.
+
+var cacheSteps = weighted(
+	choice[wrapStep]{1, wrapStepOf("WriteFile", withData)},
+	plain("Mkdir"),
+	plain("MkdirAll"),
+	plain("Remove"),
+	plain("RemoveAll"),
+	choice[wrapStep]{1, wrapStepOf("Rename", withDest)},
+	choice[wrapStep]{1, wrapStepOf("Chmod", withModes)},
+	choice[wrapStep]{2, wrapStepOf("CreateWrite", withData)},
+)
+
+var cacheCases = wrapCases(cacheSteps, 1, 10)
+
+// TestHegelCacheOnReadFsMirrorsTheBase: with an unlimited cache time, a
+// CacheOnReadFs over two OsFs directories answers every call like a plain
+// file system receiving the same calls, and its base holds exactly that
+// file system's tree. The root is only checked, never operated on.
+func TestHegelCacheOnReadFsMirrorsTheBase(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cacheCases)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		r := newCacheRun(ht, dir)
+		defer r.p.recoverPanics()
+		dirs, files, _ := c.Tree.build(r.base, r.ref)
+		for _, s := range c.Steps {
+			q := canon(s.Path.resolve(dirs, files))
+			q2 := ""
+			if s.Op == "Rename" {
+				q2 = canon(s.Path2.resolve(dirs, files))
+			}
+			if res := r.step(s, q, q2); res == stepFail || (res == stepRan && !r.check()) {
+				return
+			}
+		}
+	})
+}
+
+// cacheRun is the state of one case of the CacheOnReadFs property: the
+// cache over two OsFs directories under dir and the reference directory
+// receiving the same calls.
+type cacheRun struct {
+	p     *pair
+	base  afero.Fs
+	layer afero.Fs
+	ref   afero.Fs
+	cache afero.Fs
+}
+
+// newCacheRun makes the three directories and the cache; the tree is built
+// on base and ref by the caller.
+func newCacheRun(ht *hegel.T, dir string) *cacheRun {
+	for _, d := range []string{"base", "layer", "ref"} {
+		os.Mkdir(dir+"/"+d, 0o755)
+	}
+	base := afero.NewBasePathFs(afero.NewOsFs(), dir+"/base")
+	layer := afero.NewBasePathFs(afero.NewOsFs(), dir+"/layer")
+	ref := afero.NewBasePathFs(afero.NewOsFs(), dir+"/ref")
+	cache := afero.NewCacheOnReadFs(base, layer, 0)
+	return &cacheRun{p: &pair{ht: ht, mem: cache, os: ref}, base: base, layer: layer, ref: ref, cache: cache}
+}
+
+// step applies one operation (on the canonical path q, and q2 for a Rename)
+// to the cache and the reference.
+func (r *cacheRun) step(s wrapStep, q, q2 string) int {
+	p, ht, layer, ref, cache := r.p, r.p.ht, r.layer, r.ref, r.cache
+	p.shapes = nil
+	cached, _ := afero.Exists(layer, q)
+	kind := kindOf(ref, q)
+	op := s.Op
+	if q == "/" {
+		op = "" // the root is only checked
+	}
+	switch op {
+	case "WriteFile":
+		if !p.gate(
+			shapeIf(kind == kindFile && !cached && permOf(ref, q) != 0o666, "afero/33"),
+			shapeIf(kind != kindDir && !cached, "afero/36"),
+		) {
+			return stepSkip
+		}
+		note(ht, "WriteFile(%s, %q)", q, s.Data)
+		cerr := afero.WriteFile(cache, q, s.Data, 0o600)
+		if cerr != nil && errors.Is(cerr, afero.BADFD) && p.accept("afero/20") {
+			cerr = nil
+		}
+		if !p.sameErr("WriteFile("+q+")", cerr, afero.WriteFile(ref, q, s.Data, 0o600)) {
+			return stepFail
+		}
+	case "Mkdir":
+		note(ht, "Mkdir(%s)", q)
+		if !p.sameErr("Mkdir("+q+")", cache.Mkdir(q, 0o700), ref.Mkdir(q, 0o700)) {
+			return stepFail
+		}
+	case "MkdirAll":
+		note(ht, "MkdirAll(%s)", q)
+		if !p.sameErr("MkdirAll("+q+")", cache.MkdirAll(q, 0o700), ref.MkdirAll(q, 0o700)) {
+			return stepFail
+		}
+	case "Remove":
+		if !p.gate(shapeIf(kind != kindMissing && !cached, "afero/23")) {
+			return stepSkip
+		}
+		note(ht, "Remove(%s)", q)
+		if !p.sameErr("Remove("+q+")", cache.Remove(q), ref.Remove(q)) {
+			return stepFail
+		}
+	case "RemoveAll":
+		note(ht, "RemoveAll(%s)", q)
+		if !p.sameErr("RemoveAll("+q+")", cache.RemoveAll(q), ref.RemoveAll(q)) {
+			return stepFail
+		}
+	case "Rename":
+		parentCached, _ := afero.Exists(layer, path.Dir(q2))
+		if !p.gate(
+			shapeIf(kind == kindDir && !cached, "afero/32"),
+			shapeIf(!parentCached && kind != kindMissing, "afero/38"),
+		) {
+			return stepSkip
+		}
+		note(ht, "Rename(%s, %s)", q, q2)
+		if !p.sameErr("Rename("+q+", "+q2+")", cache.Rename(q, q2), ref.Rename(q, q2)) {
+			return stepFail
+		}
+	case "Chmod":
+		mode := s.FileMode
+		if kind == kindDir {
+			mode = s.DirMode
+		}
+		if !p.gate(shapeIf(kind == kindDir && !cached, "afero/32")) {
+			return stepSkip
+		}
+		note(ht, "Chmod(%s, %o)", q, mode)
+		if !p.sameErr("Chmod("+q+")", cache.Chmod(q, mode), ref.Chmod(q, mode)) {
+			return stepFail
+		}
+	case "CreateWrite": // Create + Write + Close through the union
+		if kind == kindDir || kindOf(ref, path.Dir(q)) != kindDir {
+			return stepSkip
+		}
+		parentCached, _ := afero.Exists(layer, path.Dir(q))
+		if !p.gate(
+			shapeIf(kind == kindFile && !cached && permOf(ref, q) != 0o666, "afero/33"),
+			shapeIf(!parentCached, "afero/38"),
+		) {
+			return stepSkip
+		}
+		note(ht, "Create(%s) + Write(%q)", q, s.Data)
+		cf, cerr := cache.Create(q)
+		rf, rerr := ref.Create(q)
+		if !p.sameErr("Create("+q+")", cerr, rerr) {
+			return stepFail
+		}
+		if cerr != nil {
+			return stepSkip
+		}
+		_, cerr = cf.Write(s.Data)
+		_, rerr = rf.Write(s.Data)
+		if !p.sameErr("Write", cerr, rerr) {
+			return stepFail
+		}
+		cerr, rerr = cf.Close(), rf.Close()
+		if cerr != nil && errors.Is(cerr, afero.BADFD) && p.accept("afero/20") {
+			cerr = nil
+		}
+		if !p.sameErr("Close", cerr, rerr) {
+			return stepFail
+		}
+	}
+	return stepRan
+}
+
+// check: the base is the reference tree and the cache answers like it.
+func (r *cacheRun) check() bool {
+	p, base, ref, cache := r.p, r.base, r.ref, r.cache
+	// The base is the reference tree; the cache answers like it.
+	bs, _ := snapshot(base)
+	rs, _ := snapshot(ref)
+	// Directories recreated in the layer carry another mode
+	// (afero/34), files copied into it 0666 (afero/33), and Stat
+	// prefers the layer's FileInfo: while the bugs are switched off
+	// those modes are not compared; by default a difference of modes
+	// alone names the bug.
+	hidePerms(bs)
+	hidePerms(rs)
+	if joinEntries(bs) != joinEntries(rs) {
+		p.namePermShapes(bs, rs)
+		p.fail("base differs from the reference:\n%s\n->\n%s", joinEntries(bs), joinEntries(rs))
+		return false
+	}
+	for _, e := range rs {
+		fi, err := cache.Stat(e.path)
+		permOK := err != nil || e.perm == permUnknown || fi.Mode().Perm() == e.perm
+		if err == nil && !permOK && fi.IsDir() == e.dir {
+			p.accept(permShape(e.dir))
+		}
+		if err != nil || fi.IsDir() != e.dir || (!e.dir && fi.Size() != e.size) || !permOK {
+			p.fail("cache.Stat(%s) = %s, reference %s", e.path, statSummary(fi, err, false), e.String())
+			return false
+		}
+		if !e.dir {
+			data, err := afero.ReadFile(cache, e.path)
+			if err != nil || string(data) != e.content {
+				p.fail("cache.ReadFile(%s) = %q, %v; reference %s", e.path, data, err, e.String())
+				return false
+			}
+		}
+	}
+	cs, err := snapshot(cache)
+	if err != nil {
+		p.fail("walking the cache: %v", err)
+		return false
+	}
+	hidePerms(cs)
+	if joinEntries(cs) != joinEntries(rs) {
+		p.namePermShapes(cs, rs)
+		p.fail("the cache's tree differs from the reference:\n%s\n->\n%s", joinEntries(cs), joinEntries(rs))
+		return false
+	}
+	return true
+}
+
+// hidePerms marks the modes the known layer bugs change as not compared
+// (only while the bugs are switched off).
+func hidePerms(es []entry) {
+	if !noKnown {
+		return
+	}
+	for i := range es {
+		es[i].perm = permUnknown
+	}
+}
+
+// permShape is the bug a wrong mode of a layer copy is the shape of.
+func permShape(dir bool) string {
+	if dir {
+		return "afero/34"
+	}
+	return "afero/33"
+}
+
+// namePermShapes records the shapes of two snapshots that differ in modes
+// alone (the message of the mismatch that follows names them).
+func (p *pair) namePermShapes(got, want []entry) {
+	if len(got) != len(want) {
+		return
+	}
+	for i := range got {
+		g, w := got[i], want[i]
+		g.perm, w.perm = 0, 0
+		if g != w {
+			return
+		}
+	}
+	for i := range got {
+		if got[i].perm != want[i].perm {
+			p.accept(permShape(got[i].dir))
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// RegexpFs.
+
+var regexps = []*regexp.Regexp{
+	regexp.MustCompile(`\.txt$`),
+	regexp.MustCompile(`^[ab]`),
+	regexp.MustCompile(`.`),
+	regexp.MustCompile(`^c`),
+}
+
+// paged: RegexpFile.Readdirnames in pages of two, the shape of afero/26;
+// while the bug is switched off every listing is one call.
+var paged = shaped(chance(50), hegel.Just(false))
+
+var regexpSteps = weighted(
+	plain("Stat"),
+	plain("ReadFile"),
+	plain("Remove"),
+	plain("RemoveAll"),
+	plain("Chmod"),
+	plain("Create"),
+	plain("OpenFile"),
+	choice[wrapStep]{1, wrapStepOf("Rename", withDest)},
+	choice[wrapStep]{2, wrapStepOf("List", func(tc hegel.TestCase, s *wrapStep) { s.Paged = hegel.Draw(tc, paged) })},
+)
+
+// regexpCase is the case of the RegexpFs property: a tree, the regexp's
+// index and a script.
+type regexpCase struct {
+	Tree  treeSpec
+	Re    int
+	Steps []wrapStep
+}
+
+func (c regexpCase) GoString() string {
+	return fmt.Sprintf("regexpCase{%v, %s}", regexps[c.Re], wrapCase{c.Tree, c.Steps}.GoString())
+}
+
+var regexpCases = hegel.Composite(func(tc hegel.TestCase) regexpCase {
+	return regexpCase{
+		Tree:  hegel.Draw(tc, treeSpecs),
+		Re:    hegel.Draw(tc, hegel.Integers(0, len(regexps)-1)),
+		Steps: hegel.Draw(tc, many(regexpSteps, 1, 8)),
+	}
+})
+
+// TestHegelRegexpFsHidesTheOtherFiles: a RegexpFs shows every directory and
+// exactly the files whose name matches; an operation on a hidden or
+// non-matching file name fails with ENOENT and touches nothing; every other
+// operation acts as on the source.
+func TestHegelRegexpFsHidesTheOtherFiles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, regexpCases)
+		r := newRegexpRun(ht, regexps[c.Re])
+		defer r.p.recoverPanics()
+		dirs, files, _ := c.Tree.build(r.src, r.ref)
+		for _, s := range c.Steps {
+			q := canon(s.Path.resolve(dirs, files))
+			q2 := ""
+			if s.Op == "Rename" {
+				q2 = canon(s.Path2.resolve(dirs, files))
+			}
+			if res := r.step(s, q, q2); res == stepFail || (res == stepRan && !r.check()) {
+				return
+			}
+		}
+	})
+}
+
+// regexpRun is the state of one case of the RegexpFs property: the filter
+// over a MemMapFs source and a MemMapFs reference holding the same tree.
+type regexpRun struct {
+	p   *pair
+	src afero.Fs
+	ref afero.Fs
+	rfs afero.Fs
+	re  *regexp.Regexp
+}
+
+// newRegexpRun makes the source, the reference and the filter; the tree is
+// built on src and ref by the caller.
+func newRegexpRun(ht *hegel.T, re *regexp.Regexp) *regexpRun {
+	src := afero.NewMemMapFs()
+	ref := afero.NewMemMapFs()
+	rfs := afero.NewRegexpFs(src, re)
+	return &regexpRun{p: &pair{ht: ht, mem: rfs, os: ref}, src: src, ref: ref, rfs: rfs, re: re}
+}
+
+// visible reports whether the filter shows q: every directory and the files
+// whose name matches.
+func (r *regexpRun) visible(q string) bool {
+	isDir, _ := afero.IsDir(r.ref, q)
+	return isDir || r.re.MatchString(path.Base(q))
+}
+
+// step applies one operation (on the canonical path q, and q2 for a Rename)
+// to the filter and the reference.
+func (r *regexpRun) step(s wrapStep, q, q2 string) int {
+	p, re, rfs, ref := r.p, r.re, r.rfs, r.ref
+	p.shapes = nil
+	kind := kindOf(ref, q)
+	vis := r.visible(q)
+	if q == "/" {
+		return stepSkip
+	}
+	// An operation on a hidden path fails with ENOENT and does nothing.
+	check := func(op string, rerr error, refOp func() error) bool {
+		if !vis {
+			if !os.IsNotExist(rerr) {
+				p.fail("RegexpFs.%s(%s) on a hidden name (%v): %v, want ENOENT", op, q, re, rerr)
+				return false
+			}
+			return true
+		}
+		return p.sameErr("RegexpFs."+op+"("+q+")", rerr, refOp())
+	}
+	switch s.Op {
+	case "Stat":
+		if !check("Stat", func() error { _, err := rfs.Stat(q); return err }(), func() error { _, err := ref.Stat(q); return err }) {
+			return stepFail
+		}
+	case "ReadFile":
+		d, err := afero.ReadFile(rfs, q)
+		if !check("ReadFile", err, func() error {
+			rd, rerr := afero.ReadFile(ref, q)
+			if rerr == nil && string(rd) != string(d) {
+				return errors.New("content differs")
+			}
+			return rerr
+		}) {
+			return stepFail
+		}
+	case "Remove":
+		if !p.gate(shapeIf(kind == kindDir && hasChildren(ref, q), "afero/3")) {
+			return stepSkip
+		}
+		if !check("Remove", rfs.Remove(q), func() error { return ref.Remove(q) }) {
+			return stepFail
+		}
+	case "RemoveAll":
+		if !p.gate(shapeIf(kind == kindMissing, "afero/35")) {
+			return stepSkip
+		}
+		if !check("RemoveAll", rfs.RemoveAll(q), func() error { return ref.RemoveAll(q) }) {
+			return stepFail
+		}
+	case "Chmod":
+		if !check("Chmod", rfs.Chmod(q, 0o600), func() error { return ref.Chmod(q, 0o600) }) {
+			return stepFail
+		}
+	case "Create": // of a new or existing name (directories excluded: MemMapFs afero/6)
+		if kind == kindDir || kindOf(ref, path.Dir(q)) != kindDir {
+			return stepSkip
+		}
+		vis = re.MatchString(path.Base(q))
+		f, err := rfs.Create(q)
+		if err == nil {
+			f.Close()
+		}
+		if !check("Create", err, func() error {
+			f, err := ref.Create(q)
+			if err == nil {
+				f.Close()
+			}
+			return err
+		}) {
+			return stepFail
+		}
+	case "OpenFile": // OpenFile(O_CREATE) of an existing or new matching name
+		if kind == kindDir || kindOf(ref, path.Dir(q)) != kindDir {
+			return stepSkip
+		}
+		if !p.gate(shapeIf(kind == kindMissing, "afero/25")) {
+			return stepSkip
+		}
+		f, err := rfs.OpenFile(q, os.O_RDWR|os.O_CREATE, 0o644)
+		if err == nil {
+			f.Close()
+		}
+		if !check("OpenFile", err, func() error {
+			f, err := ref.OpenFile(q, os.O_RDWR|os.O_CREATE, 0o644)
+			if err == nil {
+				f.Close()
+			}
+			return err
+		}) {
+			return stepFail
+		}
+	case "Rename":
+		if kind == kindMissing || kindOf(ref, q2) != kindMissing || kindOf(ref, path.Dir(q2)) != kindDir {
+			return stepSkip
+		}
+		if !p.gate(shapeIf(kind == kindDir, "afero/24")) {
+			return stepSkip
+		}
+		vis = vis && re.MatchString(path.Base(q2))
+		if !check("Rename", rfs.Rename(q, q2), func() error { return ref.Rename(q, q2) }) {
+			return stepFail
+		}
+	default: // directory listing
+		if kind != kindDir {
+			return stepSkip
+		}
+		f, err := rfs.Open(q)
+		if err != nil {
+			p.fail("RegexpFs.Open(%s) of a directory: %v", q, err)
+			return stepFail
+		}
+		var names []string
+		if !s.Paged {
+			names, err = f.Readdirnames(-1)
+		} else {
+			for {
+				page, perr := f.Readdirnames(2)
+				names = append(names, page...)
+				if perr != nil {
+					break
+				}
+				if len(page) == 0 {
+					p.accept("afero/26")
+					p.fail("RegexpFile.Readdirnames(2) returned an empty page with a nil error")
+					return stepFail
+				}
+			}
+		}
+		f.Close()
+		if err != nil {
+			p.fail("RegexpFile.Readdirnames(%s): %v", q, err)
+			return stepFail
+		}
+		var want []string
+		rl, _ := afero.ReadDir(ref, q)
+		for _, fi := range rl {
+			if fi.IsDir() || re.MatchString(fi.Name()) {
+				want = append(want, fi.Name())
+			}
+		}
+		sort.Strings(names)
+		if fmt.Sprint(names) != fmt.Sprint(want) {
+			p.fail("RegexpFile.Readdirnames(%s) = %v, want %v", q, names, want)
+			return stepFail
+		}
+	}
+	return stepRan
+}
+
+// check: the source is the reference and the filter shows the reference
+// minus the hidden files.
+func (r *regexpRun) check() bool {
+	p, re, rfs, src, ref := r.p, r.re, r.rfs, r.src, r.ref
+	// The source is the reference (hidden names were never touched)
+	// and the RegexpFs shows the reference minus the hidden files.
+	ss, _ := snapshot(src)
+	rs, _ := snapshot(ref)
+	if joinEntries(ss) != joinEntries(rs) {
+		p.fail("source differs from the reference:\n%s\n->\n%s", joinEntries(ss), joinEntries(rs))
+		return false
+	}
+	var want []entry
+	for _, e := range rs {
+		if e.dir || re.MatchString(path.Base(e.path)) {
+			want = append(want, e)
+		}
+	}
+	got, err := snapshot(rfs)
+	if err != nil || joinEntries(got) != joinEntries(want) {
+		p.fail("walking the RegexpFs (%v): %v\n%s\nwant\n%s", re, err, joinEntries(got), joinEntries(want))
+		return false
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// BasePathFs.
+
+// escapeStep probes one path through a BasePathFs: a path of the tree and an
+// escaping fragment placed alone, before or after it.
+type escapeStep struct {
+	Path  pathPick
+	Esc   string
+	Where int // 0 the fragment alone, 1 fragment then path, 2 path then fragment
+}
+
+func (s escapeStep) GoString() string {
+	return fmt.Sprintf("escape{%#v, %q, where %d}", s.Path, s.Esc, s.Where)
+}
+
+var escapeSteps = hegel.Composite(func(tc hegel.TestCase) escapeStep {
+	return escapeStep{
+		Path:  hegel.Draw(tc, pathPicks),
+		Esc:   hegel.Draw(tc, hegel.SampledFrom([]string{"/..", "/../..", "/../x", "/a/../../y", "../z"})),
+		Where: hegel.Draw(tc, hegel.Integers(0, 2)),
+	}
+})
+
+// basePathCase is the case of the BasePathFs property.
+type basePathCase struct {
+	Base  string
+	Tree  treeSpec
+	Steps []escapeStep
+}
+
+func (c basePathCase) GoString() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "basePathCase{%q\n\t%s", c.Base, c.Tree.GoString())
+	for _, s := range c.Steps {
+		b.WriteString("\n\t" + s.GoString())
+	}
+	b.WriteString("\n}")
+	return b.String()
+}
+
+var basePathCases = hegel.Composite(func(tc hegel.TestCase) basePathCase {
+	return basePathCase{
+		Base:  hegel.Draw(tc, hegel.SampledFrom([]string{"/base", "/base/x", "/b a se/", "/base/./x"})),
+		Tree:  hegel.Draw(tc, treeSpecs),
+		Steps: hegel.Draw(tc, many(escapeSteps, 1, 6)),
+	}
+})
+
+// TestHegelBasePathFsStaysInsideItsBase: a BasePathFs maps a path to base +
+// path, reports a path that escapes the base as not existing, trims the base
+// from File.Name, and FullBaseFsPath composes nested bases.
+func TestHegelBasePathFsStaysInsideItsBase(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, basePathCases)
+		src := afero.NewMemMapFs()
+		base := c.Base
+		src.MkdirAll(base, 0o755)
+		bp := afero.NewBasePathFs(src, base)
+		dirs, files, content := c.Tree.build(bp)
+		// Everything landed under the base in the source.
+		for _, f := range files {
+			data, err := afero.ReadFile(src, path.Join(base, f))
+			if err != nil || string(data) != string(content[f]) {
+				fail(ht, "source has %q at %s: %v", data, path.Join(base, f), err)
+				return
+			}
+			bf, err := bp.Open(f)
+			if err != nil || bf.Name() != canon(f) {
+				fail(ht, "BasePathFs.Open(%s).Name() = %q, %v", f, bf.Name(), err)
+				return
+			}
+			bf.Close()
+		}
+		outside, _ := snapshot(afero.NewBasePathFs(src, "/"))
+		var outsideOnly []entry
+		for _, e := range outside {
+			if !strings.HasPrefix(e.path+"/", canon(base)+"/") {
+				outsideOnly = append(outsideOnly, e)
+			}
+		}
+		for _, s := range c.Steps {
+			q := s.Path.resolve(dirs, files)
+			ep := [...]string{s.Esc, s.Esc + q, q + s.Esc}[s.Where]
+			real, err := bp.(*afero.BasePathFs).RealPath(ep)
+			escapes := !strings.HasPrefix(canon(path.Join(base, ep))+"/", canon(base)+"/")
+			if escapes != (err != nil) || (err == nil && real != path.Join(base, ep)) {
+				fail(ht, "RealPath(%q) = %q, %v (base %q, escapes %v)", ep, real, err, base, escapes)
+				return
+			}
+			if escapes {
+				for _, op := range []func() error{
+					func() error { _, err := bp.Stat(ep); return err },
+					func() error { _, err := bp.Open(ep); return err },
+					func() error { _, err := bp.Create(ep); return err },
+					func() error { return bp.Mkdir(ep, 0o755) },
+					func() error { return bp.MkdirAll(ep, 0o755) },
+					func() error { return bp.Remove(ep) },
+					func() error { return bp.RemoveAll(ep) },
+					func() error { return bp.Rename(ep, "/z") },
+					func() error { return bp.Rename("/z", ep) },
+					func() error { return bp.Chmod(ep, 0o600) },
+				} {
+					if err := op(); !os.IsNotExist(err) {
+						fail(ht, "an operation on the escaping path %q returned %v, want not-exist", ep, err)
+						return
+					}
+				}
+				after, _ := snapshot(afero.NewBasePathFs(src, "/"))
+				var afterOutside []entry
+				for _, e := range after {
+					if !strings.HasPrefix(e.path+"/", canon(base)+"/") {
+						afterOutside = append(afterOutside, e)
+					}
+				}
+				if joinEntries(afterOutside) != joinEntries(outsideOnly) {
+					fail(ht, "operations on %q touched the source outside %q:\n%s\n->\n%s", ep, base, joinEntries(outsideOnly), joinEntries(afterOutside))
+					return
+				}
+			}
+			// Stat through the base equals Stat of the joined path in the source.
+			sfi, serr := src.Stat(path.Join(base, q))
+			bfi, berr := bp.Stat(q)
+			if statSummary(sfi, serr, true) != statSummary(bfi, berr, true) {
+				fail(ht, "BasePathFs.Stat(%s) = %s, source Stat(%s) = %s", q, statSummary(bfi, berr, true), path.Join(base, q), statSummary(sfi, serr, true))
+				return
+			}
+			// Nested bases compose.
+			inner := afero.NewBasePathFs(bp, "/in")
+			full := afero.FullBaseFsPath(inner.(*afero.BasePathFs), q)
+			if full != path.Join(base, "in", q) {
+				fail(ht, "FullBaseFsPath(%q in %q, %q) = %q", "/in", base, q, full)
+				return
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// IOFS.
+
+// TestHegelIOFSPassesTheStandardChecks: testing/fstest.TestFS accepts the
+// io/fs adapter of a MemMapFs, bare and behind a BasePathFs, for a drawn
+// tree, and the adapter's ReadFile/ReadDir/Stat agree with the helpers.
+func TestHegelIOFSPassesTheStandardChecks(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tree := hegel.Draw(ht, treeSpecs)
+		mem := afero.NewMemMapFs()
+		root := afero.NewBasePathFs(mem, "/root")
+		mem.MkdirAll("/root", 0o755)
+		dirs, files, content := tree.build(root)
+		var expected []string
+		for _, f := range files {
+			expected = append(expected, strings.TrimPrefix(f, "/"))
+		}
+		for _, d := range dirs {
+			if d != "/" {
+				expected = append(expected, strings.TrimPrefix(d, "/"))
+			}
+		}
+		if len(expected) == 0 {
+			count(ht, "empty tree")
+		}
+		note(ht, "expected %v", expected)
+		if err := fstest.TestFS(afero.NewIOFS(root), expected...); err != nil {
+			fail(ht, "fstest.TestFS(IOFS(BasePathFs)): %v", err)
+			return
+		}
+		withRoot := []string{"root"}
+		for _, e := range expected {
+			withRoot = append(withRoot, "root/"+e)
+		}
+		if err := fstest.TestFS(afero.NewIOFS(mem), withRoot...); err != nil {
+			fail(ht, "fstest.TestFS(IOFS(MemMapFs)): %v", err)
+			return
+		}
+		iofs := afero.NewIOFS(root)
+		for _, f := range files {
+			name := strings.TrimPrefix(f, "/")
+			data, err := iofs.ReadFile(name)
+			if err != nil || string(data) != string(content[f]) {
+				fail(ht, "IOFS.ReadFile(%s) = %q, %v; want %q", name, data, err, content[f])
+				return
+			}
+			if _, err := iofs.Open("/" + name); err == nil {
+				fail(ht, "IOFS.Open(%q) with a leading slash succeeded", "/"+name)
+				return
+			}
+		}
+		for _, d := range dirs {
+			name := strings.TrimPrefix(d, "/")
+			if name == "" {
+				name = "."
+			}
+			entries, err := iofs.ReadDir(name)
+			if err != nil {
+				fail(ht, "IOFS.ReadDir(%s): %v", name, err)
+				return
+			}
+			want, _ := afero.ReadDir(root, d)
+			var got, wantNames []string
+			for _, e := range entries {
+				got = append(got, fmt.Sprintf("%s dir=%v", e.Name(), e.IsDir()))
+			}
+			for _, e := range want {
+				wantNames = append(wantNames, fmt.Sprintf("%s dir=%v", e.Name(), e.IsDir()))
+			}
+			if fmt.Sprint(got) != fmt.Sprint(wantNames) {
+				fail(ht, "IOFS.ReadDir(%s) = %v, ReadDir = %v", name, got, wantNames)
+				return
+			}
+		}
+	})
+}
