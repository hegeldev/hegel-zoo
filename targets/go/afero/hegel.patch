+var zeroFree = hegel.SampledFrom([]byte("abcxyz\xff"))
+
+// TestHegelFileContainsBytesIgnoresItsPadding: FileContainsBytes of a file
+// without zero bytes with a needle made of a tail of the file followed by
+// zeros, short enough that the tail and the zeros fit the read buffer
+// (afero/19).
+func TestHegelFileContainsBytesIgnoresItsPadding(t *testing.T) {
+	helperShapeProperty(t, "afero/19", func(ht *hegel.T, h *helperShape) {
+		data := hegel.Draw(ht, many(zeroFree, 1, 12))
+		f := h.fresh(ht)
+		h.addFile(f, data)
+		n := len(data)
+		tail := hegel.Draw(ht, hegel.Integers(0, n))
+		zerosMin := 1
+		for 4*tail+3*zerosMin < n {
+			zerosMin++
+		}
+		zeros := hegel.Draw(ht, hegel.Integers(zerosMin, 4))
+		needle := append(append([]byte(nil), data[n-tail:]...), make([]byte, zeros)...)
+		subs := []subSpec{{Fresh: needle}}
+		for _, extra := range hegel.Draw(ht, many(many(zeroFree, 1, 6), 0, 2)) {
+			subs = append(subs, subSpec{Fresh: extra})
+		}
+		h.step(helperStep{Op: "Contains", Path: pathPick{Kind: 1, At: index(h.files, f)}, Subs: subs})
+	})
