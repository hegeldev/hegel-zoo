+// TestHegelGlobHonoursBackslashEscapes: Glob of the path of an entry with
+// one element written as a backslash escape, the elements before it plain
+// and the ones after it decorated at random (afero/28).
+func TestHegelGlobHonoursBackslashEscapes(t *testing.T) {
+	helperShapeProperty(t, "afero/28", func(ht *hegel.T, h *helperShape) {
+		e := h.fresh(ht)
+		pick := pathPick{Kind: 0}
+		if hegel.Draw(ht, chance(50)) {
+			h.addDir(e)
+			pick.At = index(h.dirs, e)
+		} else {
+			h.addFile(e, hegel.Draw(ht, dataBytes))
+			pick.Kind = 1
+			pick.At = index(h.files, e)
+		}
+		parts := spec(e, "").Parts
+		i := hegel.Draw(ht, hegel.Integers(0, len(parts)-1))
+		tape := make([]string, len(parts))
+		for j, part := range parts {
+			switch {
+			case j < i:
+				tape[j] = "plain"
+			case j == i:
+				tape[j] = "backslash"
+			case !utf8.ValidString(part[:1]):
+				// decorate splits after the first byte: a multi-byte first
+				// rune would make a pattern nothing matches on either side.
+				tape[j] = hegel.Draw(ht, hegel.SampledFrom([]string{"plain", "star"}))
+			default:
+				tape[j] = hegel.Draw(ht, hegel.SampledFrom([]string{"plain", "star", "prefix", "question", "class"}))
+			}
+		}
+		h.step(helperStep{Op: "Glob", Path: pick, Tape: tape})
+	})
+}
+
+// malformedElements: pattern elements filepath.Match rejects (an unclosed
+// class, empty or not, with or without a negation or a range start).
+var malformedElements = hegel.SampledFrom([]string{"[", "[a", "[]", "[!", "[a-", "a[", "a[b", "[-"})
+
+// TestHegelGlobRejectsAMalformedPattern: Glob of a malformed pattern element
