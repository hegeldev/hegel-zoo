--- /dev/null
+++ b/hegel/hegel_memmap_test.go
@@ -0,0 +1,1075 @@
+package hegel
+
+// MemMapFs against OsFs: the same drawn script of operations is applied to a
+// MemMapFs and to an OsFs restricted (BasePathFs) to a fresh temporary
+// directory; every result and, after every step, the visible tree must agree.
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"slices"
+	"sort"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/spf13/afero"
+	"hegel.dev/go/hegel"
+)
+
+// errClass maps an error to the class the two file systems must agree on.
+func errClass(err error) string {
+	switch {
+	case err == nil:
+		return "ok"
+	case errors.Is(err, io.EOF):
+		return "eof"
+	case errors.Is(err, io.ErrUnexpectedEOF):
+		return "unexpected-eof"
+	case errors.Is(err, fs.ErrNotExist), errors.Is(err, syscall.ENOTDIR), strings.Contains(err.Error(), "not a dir"):
+		return "not-exist"
+	case errors.Is(err, fs.ErrExist):
+		return "exist"
+	case errors.Is(err, fs.ErrPermission):
+		return "permission"
+	case errors.Is(err, fs.ErrClosed), strings.Contains(err.Error(), "closed"):
+		return "closed"
+	default:
+		return "other"
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Paths.
+
+var pathComps = []string{"a", "b", "c"}
+
+// pathSpec is a drawn path: an absolute path of 1..3 names, or (Below >= 0)
+// a child of the live directory at that position, so that trees grow deep;
+// either one decorated with redundant separators and dots that
+// filepath.Clean removes.
+type pathSpec struct {
+	Below int      // -1: the absolute path of Parts; else a position among the live directories
+	Parts []string // 1..3 names; below a live directory only the first is used
+	Deco  string   // "", "double", "trailing", "dot", "relative", "updir"
+}
+
+var pathDecos = hegel.SampledFrom([]string{"", "", "", "", "", "double", "trailing", "dot", "relative", "updir"})
+
+var pathSpecs = hegel.Composite(func(tc hegel.TestCase) pathSpec {
+	return pathSpec{
+		Below: hegel.Draw(tc, weighted(choice[int]{40, hegel.Just(-1)}, choice[int]{60, positions})),
+		Parts: hegel.Draw(tc, many(hegel.SampledFrom(pathComps), 1, 3)),
+		Deco:  hegel.Draw(tc, pathDecos),
+	}
+})
+
+// render resolves the spec against the live directories (the root first).
+func (s pathSpec) render(live []string) string {
+	p := "/" + strings.Join(s.Parts, "/")
+	if s.Below >= 0 {
+		d := at(live, s.Below)
+		if d == "/" {
+			d = ""
+		}
+		p = d + "/" + s.Parts[0]
+	}
+	switch s.Deco {
+	case "double":
+		p = strings.Replace(p, "/", "//", 1)
+	case "trailing":
+		p = p + "/"
+	case "dot":
+		p = "/./" + p[1:]
+	case "relative":
+		p = p[1:] // both file systems root it
+	case "updir":
+		p = p + "/x/.."
+	}
+	return p
+}
+
+func (s pathSpec) GoString() string {
+	p := "/" + strings.Join(s.Parts, "/")
+	if s.Below >= 0 {
+		p = fmt.Sprintf("<dir %d>/%s", s.Below, s.Parts[0])
+	}
+	if s.Deco != "" {
+		p += "+" + s.Deco
+	}
+	return p
+}
+
+func canon(p string) string {
+	p = path.Clean("/" + p)
+	return p
+}
+
+// universe lists every canonical path the generator can produce.
+var universe = func() []string {
+	var out []string
+	var rec func(prefix string, depth int)
+	rec = func(prefix string, depth int) {
+		for _, c := range pathComps {
+			p := prefix + "/" + c
+			out = append(out, p)
+			if depth < 3 {
+				rec(p, depth+1)
+			}
+		}
+	}
+	rec("", 1)
+	return out
+}()
+
+const (
+	kindMissing = iota
+	kindFile
+	kindDir
+)
+
+func kindOf(f afero.Fs, p string) int {
+	fi, err := f.Stat(p)
+	if err != nil {
+		return kindMissing
+	}
+	if fi.IsDir() {
+		return kindDir
+	}
+	return kindFile
+}
+
+// liveDirs lists the root and the directories of depth 1 and 2 that exist on
+// the truth side, the pool a pathSpec below a live directory resolves in.
+func liveDirs(f afero.Fs) []string {
+	dirs := []string{"/"}
+	for _, u := range universe {
+		if strings.Count(u, "/") < 3 && kindOf(f, u) == kindDir {
+			dirs = append(dirs, u)
+		}
+	}
+	return dirs
+}
+
+func hasChildren(f afero.Fs, p string) bool {
+	d, err := f.Open(p)
+	if err != nil {
+		return false
+	}
+	defer d.Close()
+	names, _ := d.Readdirnames(-1)
+	return len(names) > 0
+}
+
+func isRoot() bool { return os.Geteuid() == 0 }
+
+// ---------------------------------------------------------------------------
+// Modes, data, flags.
+
+var dirModes = []os.FileMode{0o755, 0o700, 0o777, 0o750}
+var fileModes = []os.FileMode{0o644, 0o600, 0o666, 0o755, 0o444, 0o400}
+
+var dirPerms = hegel.SampledFrom(dirModes)
+
+// filePerms never yields a read-only mode when running as root, who ignores it.
+var filePerms = hegel.Map(hegel.SampledFrom(fileModes), func(m os.FileMode) os.FileMode {
+	if isRoot() && m&0o222 == 0 {
+		return 0o644
+	}
+	return m
+})
+
+var dataAlphabet = hegel.SampledFrom([]byte("abcxyz0\x00\xff"))
+
+// dataBytes is a file content of 0..12 bytes.
+var dataBytes = many(dataAlphabet, 0, 12)
+
+// writeData is what a handle writes; an empty write is afero/31's shape.
+var writeData = shaped(dataBytes, many(dataAlphabet, 1, 12))
+
+const (
+	accessR = iota
+	accessW
+	accessRW
+)
+
+// openFlags is a drawn OpenFile flag set. O_TRUNC without write access and
+// O_EXCL without O_CREATE are not generated (convention).
+type openFlags struct {
+	Acc                         int
+	Create, Excl, Trunc, Append bool
+}
+
+func (f openFlags) flag() int {
+	flag := [...]int{os.O_RDONLY, os.O_WRONLY, os.O_RDWR}[f.Acc]
+	for _, b := range []struct {
+		on  bool
+		bit int
+	}{{f.Create, os.O_CREATE}, {f.Excl, os.O_EXCL}, {f.Trunc, os.O_TRUNC}, {f.Append, os.O_APPEND}} {
+		if b.on {
+			flag |= b.bit
+		}
+	}
+	return flag
+}
+
+var openFlagSets = hegel.Composite(func(tc hegel.TestCase) openFlags {
+	f := openFlags{Acc: hegel.Draw(tc, hegel.SampledFrom([]int{accessR, accessW, accessRW}))}
+	f.Create = hegel.Draw(tc, chance(50))
+	if f.Create {
+		f.Excl = hegel.Draw(tc, chance(30))
+	}
+	if f.Acc != accessR {
+		f.Append = hegel.Draw(tc, chance(30))
+		// MemMapFs seeks to the end before truncating, so the first write of
+		// an O_TRUNC|O_APPEND handle lands past a zero (afero/11): the
+		// combination is left out while the bug is switched off.
+		if !f.Append || !noKnown {
+			f.Trunc = hegel.Draw(tc, chance(30))
+		}
+	}
+	return f
+})
+
+func flagString(flag int) string {
+	var parts []string
+	switch flag & (os.O_RDONLY | os.O_WRONLY | os.O_RDWR) {
+	case os.O_RDONLY:
+		parts = append(parts, "O_RDONLY")
+	case os.O_WRONLY:
+		parts = append(parts, "O_WRONLY")
+	case os.O_RDWR:
+		parts = append(parts, "O_RDWR")
+	}
+	for _, f := range []struct {
+		bit  int
+		name string
+	}{{os.O_CREATE, "O_CREATE"}, {os.O_EXCL, "O_EXCL"}, {os.O_TRUNC, "O_TRUNC"}, {os.O_APPEND, "O_APPEND"}} {
+		if flag&f.bit != 0 {
+			parts = append(parts, f.name)
+		}
+	}
+	return strings.Join(parts, "|")
+}
+
+// ---------------------------------------------------------------------------
+// Operations on an open handle.
+
+// handleOp is one operation on the two open files.
+type handleOp struct {
+	Op     string // Stat, Readdir, Read, ReadAt, Seek, Write, WriteString, WriteAt, Truncate
+	Data   []byte
+	Size   int
+	Off    int64
+	Whence int
+	Page   int
+	Names  bool
+}
+
+func (h handleOp) GoString() string {
+	switch h.Op {
+	case "Readdir":
+		if h.Names {
+			return fmt.Sprintf("Readdirnames(%d)", h.Page)
+		}
+		return fmt.Sprintf("Readdir(%d)", h.Page)
+	case "Read":
+		return fmt.Sprintf("Read(%d)", h.Size)
+	case "ReadAt":
+		return fmt.Sprintf("ReadAt(%d, %d)", h.Size, h.Off)
+	case "Seek":
+		return fmt.Sprintf("Seek(%d, %d)", h.Off, h.Whence)
+	case "Write", "WriteString":
+		return fmt.Sprintf("%s(%q)", h.Op, h.Data)
+	case "WriteAt":
+		return fmt.Sprintf("WriteAt(%q, %d)", h.Data, h.Off)
+	case "Truncate":
+		return fmt.Sprintf("Truncate(%d)", h.Off)
+	}
+	return h.Op
+}
+
+func hop(op string, fields func(tc hegel.TestCase, h *handleOp)) hegel.Generator[handleOp] {
+	return hegel.Composite(func(tc hegel.TestCase) handleOp {
+		h := handleOp{Op: op}
+		if fields != nil {
+			fields(tc, &h)
+		}
+		return h
+	})
+}
+
+var bufSizes = hegel.Integers(0, 8)
+var offsets = hegel.Integers(0, 14)
+
+// whences: the three valid ones and, while afero/18 is switched on, an
+// invalid one about one time in twenty.
+var whences = shaped(
+	hegel.SampledFrom(slices.Concat(slices.Repeat([]int{io.SeekStart, io.SeekCurrent, io.SeekEnd}, 6), []int{7})),
+	hegel.SampledFrom([]int{io.SeekStart, io.SeekCurrent, io.SeekEnd}),
+)
+
+var (
+	hStat    = hop("Stat", nil)
+	hReaddir = hop("Readdir", func(tc hegel.TestCase, h *handleOp) {
+		h.Page = hegel.Draw(tc, hegel.SampledFrom([]int{-1, 0, 1, 2, 5}))
+		h.Names = hegel.Draw(tc, chance(50))
+	})
+	hRead   = hop("Read", func(tc hegel.TestCase, h *handleOp) { h.Size = hegel.Draw(tc, bufSizes) })
+	hReadAt = hop("ReadAt", func(tc hegel.TestCase, h *handleOp) {
+		h.Size = hegel.Draw(tc, bufSizes)
+		h.Off = int64(hegel.Draw(tc, offsets))
+	})
+	hSeek = hop("Seek", func(tc hegel.TestCase, h *handleOp) {
+		h.Off = int64(hegel.Draw(tc, hegel.Integers(-3, 14)))
+		h.Whence = hegel.Draw(tc, whences)
+	})
+	hWrite       = hop("Write", func(tc hegel.TestCase, h *handleOp) { h.Data = hegel.Draw(tc, writeData) })
+	hWriteString = hop("WriteString", func(tc hegel.TestCase, h *handleOp) { h.Data = hegel.Draw(tc, writeData) })
+	hWriteAt     = hop("WriteAt", func(tc hegel.TestCase, h *handleOp) {
+		h.Data = hegel.Draw(tc, writeData)
+		h.Off = int64(hegel.Draw(tc, offsets))
+	})
+	hTruncate = hop("Truncate", func(tc hegel.TestCase, h *handleOp) { h.Off = int64(hegel.Draw(tc, hegel.Integers(-1, 14))) })
+)
+
+// handleScript builds the generator of 0..6 handle operations for a handle
+// opened with the given access mode. While the bugs are switched off, the
+// operations the mode does not allow (afero/12) and the ones an O_APPEND
+// handle gets wrong (afero/11) are left out.
+func handleScript(acc int, appendMode bool) hegel.Generator[[]handleOp] {
+	reads := acc != accessW || !noKnown
+	writes := acc != accessR || !noKnown
+	moves := !appendMode || !noKnown
+	ops := []choice[handleOp]{{1, hStat}, {1, hReaddir}}
+	if reads && moves {
+		ops = append(ops, choice[handleOp]{1, hRead})
+	}
+	if reads {
+		ops = append(ops, choice[handleOp]{1, hReadAt})
+	}
+	if moves {
+		ops = append(ops, choice[handleOp]{1, hSeek})
+	}
+	if writes {
+		ops = append(ops, choice[handleOp]{1, hWrite}, choice[handleOp]{1, hWriteString})
+	}
+	if writes && moves {
+		ops = append(ops, choice[handleOp]{1, hWriteAt}, choice[handleOp]{1, hTruncate})
+	}
+	return many(weighted(ops...), 0, 6)
+}
+
+var handleScripts = func() map[[2]int]hegel.Generator[[]handleOp] {
+	m := map[[2]int]hegel.Generator[[]handleOp]{}
+	for acc := accessR; acc <= accessRW; acc++ {
+		for app := 0; app < 2; app++ {
+			m[[2]int{acc, app}] = handleScript(acc, app == 1)
+		}
+	}
+	return m
+}()
+
+func scriptFor(acc int, appendMode bool) hegel.Generator[[]handleOp] {
+	app := 0
+	if appendMode {
+		app = 1
+	}
+	return handleScripts[[2]int{acc, app}]
+}
+
+// ---------------------------------------------------------------------------
+// Steps.
+
+// memStep is one operation of the script. Only the fields the operation uses
+// are drawn.
+type memStep struct {
+	Op       string
+	Path     pathSpec
+	Path2    pathSpec // Rename destination
+	Perm     os.FileMode
+	FilePerm os.FileMode // Chmod of a file (Perm is for a directory)
+	Flags    openFlags
+	When     int64
+	Handle   []handleOp
+	Again    bool // a second Close
+}
+
+func (s memStep) GoString() string {
+	again := ""
+	if s.Again {
+		again = " Close again"
+	}
+	switch s.Op {
+	case "Rename":
+		return fmt.Sprintf("Rename(%#v, %#v)", s.Path, s.Path2)
+	case "Mkdir", "MkdirAll":
+		return fmt.Sprintf("%s(%#v, %o)", s.Op, s.Path, s.Perm)
+	case "Chmod":
+		return fmt.Sprintf("Chmod(%#v, dir %o / file %o)", s.Path, s.Perm, s.FilePerm)
+	case "Chtimes":
+		return fmt.Sprintf("Chtimes(%#v, %d)", s.Path, s.When)
+	case "Create", "Open":
+		return fmt.Sprintf("%s(%#v) %#v%s", s.Op, s.Path, s.Handle, again)
+	case "OpenFile":
+		return fmt.Sprintf("OpenFile(%#v, %s, %o) %#v%s", s.Path, flagString(s.Flags.flag()), s.Perm, s.Handle, again)
+	}
+	return fmt.Sprintf("%s(%#v)", s.Op, s.Path)
+}
+
+func step(op string, fields func(tc hegel.TestCase, s *memStep)) hegel.Generator[memStep] {
+	return hegel.Composite(func(tc hegel.TestCase) memStep {
+		s := memStep{Op: op, Path: hegel.Draw(tc, pathSpecs)}
+		if fields != nil {
+			fields(tc, &s)
+		}
+		return s
+	})
+}
+
+var memSteps = weighted(
+	choice[memStep]{2, step("Stat", nil)},
+	choice[memStep]{1, step("ReadDir", nil)},
+	choice[memStep]{1, step("ReadFile", nil)},
+	choice[memStep]{1, step("Mkdir", func(tc hegel.TestCase, s *memStep) { s.Perm = hegel.Draw(tc, dirPerms) })},
+	choice[memStep]{1, step("MkdirAll", func(tc hegel.TestCase, s *memStep) { s.Perm = hegel.Draw(tc, dirPerms) })},
+	choice[memStep]{1, step("Create", func(tc hegel.TestCase, s *memStep) {
+		s.Handle = hegel.Draw(tc, scriptFor(accessRW, false))
+		s.Again = hegel.Draw(tc, chance(20))
+	})},
+	choice[memStep]{1, step("Open", func(tc hegel.TestCase, s *memStep) {
+		s.Handle = hegel.Draw(tc, scriptFor(accessR, false))
+		s.Again = hegel.Draw(tc, chance(20))
+	})},
+	choice[memStep]{1, step("OpenFile", func(tc hegel.TestCase, s *memStep) {
+		s.Flags = hegel.Draw(tc, openFlagSets)
+		s.Perm = hegel.Draw(tc, filePerms)
+		s.Handle = hegel.Draw(tc, scriptFor(s.Flags.Acc, s.Flags.Append))
+		s.Again = hegel.Draw(tc, chance(20))
+	})},
+	choice[memStep]{1, step("Remove", nil)},
+	choice[memStep]{1, step("RemoveAll", nil)},
+	choice[memStep]{1, step("Rename", func(tc hegel.TestCase, s *memStep) { s.Path2 = hegel.Draw(tc, pathSpecs) })},
+	choice[memStep]{1, step("Chmod", func(tc hegel.TestCase, s *memStep) {
+		s.Perm = hegel.Draw(tc, dirPerms)
+		s.FilePerm = hegel.Draw(tc, filePerms)
+	})},
+	choice[memStep]{1, step("Chtimes", func(tc hegel.TestCase, s *memStep) {
+		s.When = int64(hegel.Draw(tc, hegel.Integers(0, 2_000_000_000)))
+	})},
+)
+
+// memScript is the case of the MemMapFs property: 1..25 steps.
+type memScript []memStep
+
+func (s memScript) GoString() string {
+	var b strings.Builder
+	b.WriteString("memScript{")
+	for _, st := range s {
+		b.WriteString("\n\t")
+		b.WriteString(st.GoString())
+	}
+	b.WriteString("\n}")
+	return b.String()
+}
+
+var memScripts = hegel.Map(many(memSteps, 1, 25), func(s []memStep) memScript { return memScript(s) })
+
+// ---------------------------------------------------------------------------
+// Snapshots and the pair of file systems.
+
+// entry is one node of a tree snapshot.
+type entry struct {
+	path    string
+	dir     bool
+	perm    os.FileMode
+	size    int64
+	content string
+}
+
+func (e entry) String() string {
+	if e.dir {
+		return fmt.Sprintf("%s/ %o", e.path, e.perm)
+	}
+	return fmt.Sprintf("%s %o %d %q", e.path, e.perm, e.size, e.content)
+}
+
+// snapshot walks the tree from the root and records what is reachable.
+func snapshot(f afero.Fs) ([]entry, error) {
+	var out []entry
+	err := afero.Walk(f, "/", func(p string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if p == "/" {
+			return nil
+		}
+		e := entry{path: canon(p), dir: info.IsDir(), perm: info.Mode().Perm()}
+		if !info.IsDir() {
+			e.size = info.Size()
+			data, rerr := afero.ReadFile(f, p)
+			if rerr != nil {
+				if os.IsPermission(rerr) {
+					e.content = "<unreadable>"
+				} else {
+					return rerr
+				}
+			} else {
+				e.content = string(data)
+			}
+		}
+		out = append(out, e)
+		return nil
+	})
+	sort.Slice(out, func(i, j int) bool { return out[i].path < out[j].path })
+	return out, err
+}
+
+func joinEntries(es []entry) string {
+	var b strings.Builder
+	for _, e := range es {
+		b.WriteString(e.String())
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+// pair holds the two file systems under comparison and the known-bug shapes
+// of the step being applied (mem is the system under test, os the truth).
+type pair struct {
+	ht     *hegel.T
+	mem    afero.Fs
+	os     afero.Fs
+	shapes []string // shapes of the current step
+	seen   []string // shapes of the earlier steps of the case
+}
+
+// shapeIf names a recorded bug's shape when cond holds.
+func shapeIf(cond bool, id string) string {
+	if cond {
+		return known(id)
+	}
+	return ""
+}
+
+// gate records the shapes a step (or one of its operations) has and reports
+// whether it runs: by default it does and a mismatch names the shapes; with
+// HEGEL_NO_KNOWN=1 a step with a shape is a no-op.
+func (p *pair) gate(shapes ...string) bool {
+	var real []string
+	for _, s := range shapes {
+		if s != "" {
+			real = append(real, s)
+		}
+	}
+	if len(real) == 0 {
+		return true
+	}
+	if noKnown {
+		for _, s := range real {
+			count(p.ht, "skip: "+s)
+		}
+		return false
+	}
+	p.shapes = append(p.shapes, real...)
+	p.seen = append(p.seen, real...)
+	return true
+}
+
+// accept reports whether a recorded outcome met at comparison time is
+// accepted (HEGEL_NO_KNOWN=1); by default it is not and the mismatch that
+// follows names the bug.
+func (p *pair) accept(id string) bool {
+	if noKnown {
+		count(p.ht, "accepted: "+known(id))
+		return true
+	}
+	p.shapes = append(p.shapes, known(id))
+	p.seen = append(p.seen, known(id))
+	return false
+}
+
+func (p *pair) fail(format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	switch {
+	case len(p.shapes) > 0:
+		msg += fmt.Sprintf(" (the shape of %s)", strings.Join(p.shapes, "; "))
+	case len(p.seen) > 0:
+		msg += fmt.Sprintf(" (after steps with the shape of %s)", strings.Join(p.seen, "; "))
+	}
+	fail(p.ht, "%s", msg)
+}
+
+// recoverPanics (deferred in a property's body) turns a panic of the library
+// into a failure that names the shapes of the case; the harness alone would
+// report it without them.
+func (p *pair) recoverPanics() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	if _, ok := r.(collected); ok || controlFlow(r) {
+		panic(r)
+	}
+	p.fail("panic in the code under test: %v", r)
+}
+
+func (p *pair) same(what string, memv, osv any) bool {
+	if fmt.Sprint(memv) != fmt.Sprint(osv) {
+		p.fail("%s: %s %v, %s %v", what, p.memName(), memv, p.osName(), osv)
+		return false
+	}
+	return true
+}
+
+func (p *pair) sameErr(what string, memErr, osErr error) bool {
+	mc, oc := errClass(memErr), errClass(osErr)
+	if mc != oc {
+		p.fail("%s: %s %v (%s), %s %v (%s)", what, p.memName(), memErr, mc, p.osName(), osErr, oc)
+		return false
+	}
+	return true
+}
+
+func (p *pair) memName() string { return p.mem.Name() }
+func (p *pair) osName() string  { return p.os.Name() }
+
+// checkTrees compares the reachable trees and the Stat of every path of the
+// universe (which also finds entries a bug left reachable by name only).
+func (p *pair) checkTrees() bool {
+	ms, merr := snapshot(p.mem)
+	oss, oerr := snapshot(p.os)
+	if merr != nil || oerr != nil {
+		p.fail("snapshot: %s %v, %s %v", p.memName(), merr, p.osName(), oerr)
+		return false
+	}
+	if joinEntries(ms) != joinEntries(oss) {
+		p.fail("trees differ\n%s:\n%s%s:\n%s", p.memName(), joinEntries(ms), p.osName(), joinEntries(oss))
+		return false
+	}
+	for _, u := range universe {
+		mk, ok := kindOf(p.mem, u), kindOf(p.os, u)
+		if mk != ok {
+			p.fail("Stat(%s) kind: %s %d, %s %d (missing/file/dir)", u, p.memName(), mk, p.osName(), ok)
+			return false
+		}
+	}
+	return true
+}
+
+func statSummary(fi os.FileInfo, err error, withName bool) string {
+	if err != nil {
+		return "err " + errClass(err)
+	}
+	s := fmt.Sprintf("dir=%v perm=%o", fi.IsDir(), fi.Mode().Perm())
+	if !fi.IsDir() {
+		s += fmt.Sprintf(" size=%d", fi.Size())
+	}
+	if withName {
+		s += " name=" + fi.Name()
+	}
+	return s
+}
+
+func dirList(l []os.FileInfo) string {
+	var parts []string
+	for _, fi := range l {
+		parts = append(parts, statSummary(fi, nil, true))
+	}
+	return strings.Join(parts, "; ")
+}
+
+// fileOnTheWay reports whether some proper ancestor of p is a regular file.
+func fileOnTheWay(f afero.Fs, p string) bool {
+	for d := path.Dir(p); d != "/"; d = path.Dir(d) {
+		if kindOf(f, d) == kindFile {
+			return true
+		}
+	}
+	return false
+}
+
+func permOf(f afero.Fs, p string) os.FileMode {
+	fi, err := f.Stat(p)
+	if err != nil {
+		return 0
+	}
+	return fi.Mode().Perm()
+}
+
+func writable(f afero.Fs, p string) bool {
+	fi, err := f.Stat(p)
+	return err == nil && fi.Mode().Perm()&0o222 != 0
+}
+
+// ---------------------------------------------------------------------------
+// The property.
+
+// TestHegelMemMapFsMatchesTheOs: MemMapFs and OsFs agree on every operation
+// and on the resulting tree. A step whose shape is a recorded bug runs by
+// default and its mismatch names the bug (see known.go).
+func TestHegelMemMapFsMatchesTheOs(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		script := hegel.Draw(ht, memScripts)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		p := &pair{ht: ht, mem: afero.NewMemMapFs(), os: afero.NewBasePathFs(afero.NewOsFs(), dir)}
+		defer p.recoverPanics()
+		for _, s := range script {
+			if !p.step(s) || !p.checkTrees() {
+				return
+			}
+		}
+	})
+}
+
+// step applies one operation to both file systems; false ends the case.
+func (p *pair) step(s memStep) bool {
+	ht := p.ht
+	p.shapes = nil
+	live := liveDirs(p.os)
+	raw := s.Path.render(live)
+	cp := canon(raw)
+	parent := path.Dir(cp)
+	parentKind := kindOf(p.os, parent)
+	kind := kindOf(p.os, cp)
+	switch s.Op {
+	case "Mkdir":
+		if !p.gate(shapeIf(parentKind == kindMissing, "afero/1"), shapeIf(parentKind == kindFile, "afero/5")) {
+			return true
+		}
+		note(ht, "Mkdir(%q, %o)", raw, s.Perm)
+		return p.sameErr("Mkdir("+raw+")", p.mem.Mkdir(raw, s.Perm), p.os.Mkdir(raw, s.Perm))
+	case "MkdirAll":
+		if !p.gate(shapeIf(kind == kindFile, "afero/4"), shapeIf(fileOnTheWay(p.os, cp), "afero/5")) {
+			return true
+		}
+		note(ht, "MkdirAll(%q, %o)", raw, s.Perm)
+		return p.sameErr("MkdirAll("+raw+")", p.mem.MkdirAll(raw, s.Perm), p.os.MkdirAll(raw, s.Perm))
+	case "Create":
+		if !p.gate(
+			shapeIf(parentKind == kindMissing, "afero/2"),
+			shapeIf(parentKind == kindFile, "afero/5"),
+			shapeIf(kind == kindDir, "afero/6"),
+			shapeIf(kind == kindFile && !writable(p.os, cp), "afero/30"),
+			shapeIf(kind == kindFile && permOf(p.os, cp) != 0o666, "afero/15"),
+		) {
+			return true
+		}
+		note(ht, "Create(%q)", raw)
+		mf, merr := p.mem.Create(raw)
+		of, oerr := p.os.Create(raw)
+		if !p.sameErr("Create("+raw+")", merr, oerr) {
+			return false
+		}
+		if merr != nil {
+			return true
+		}
+		return p.handleOps(s, cp, mf, of, accessRW, false, false)
+	case "Open":
+		note(ht, "Open(%q)", raw)
+		mf, merr := p.mem.Open(raw)
+		of, oerr := p.os.Open(raw)
+		if !p.sameErr("Open("+raw+")", merr, oerr) {
+			return false
+		}
+		if merr != nil {
+			return true
+		}
+		return p.handleOps(s, cp, mf, of, accessR, false, kind == kindDir)
+	case "OpenFile":
+		f := s.Flags
+		flag := f.flag()
+		if !p.gate(
+			shapeIf(f.Create && parentKind == kindMissing, "afero/2"),
+			shapeIf(f.Create && parentKind == kindFile, "afero/5"),
+			shapeIf(kind == kindDir && flag != os.O_RDONLY, "afero/14"),
+			shapeIf(kind == kindFile && !writable(p.os, cp) && (f.Acc == accessR || f.Excl), "afero/13"),
+			shapeIf(f.Trunc && f.Append, "afero/11"),
+		) {
+			return true
+		}
+		note(ht, "OpenFile(%q, %s, %o)", raw, flagString(flag), s.Perm)
+		mf, merr := p.mem.OpenFile(raw, flag, s.Perm)
+		of, oerr := p.os.OpenFile(raw, flag, s.Perm)
+		if !p.sameErr("OpenFile("+raw+", "+flagString(flag)+")", merr, oerr) {
+			return false
+		}
+		if merr != nil {
+			return true
+		}
+		return p.handleOps(s, cp, mf, of, f.Acc, f.Append, kind == kindDir)
+	case "Remove":
+		if !p.gate(shapeIf(kind == kindDir && hasChildren(p.os, cp), "afero/3")) {
+			return true
+		}
+		note(ht, "Remove(%q)", raw)
+		return p.sameErr("Remove("+raw+")", p.mem.Remove(raw), p.os.Remove(raw))
+	case "RemoveAll":
+		if fileOnTheWay(p.os, cp) {
+			// os.RemoveAll reports ENOTDIR for a path below a regular file;
+			// MemMapFs returns nil as for any missing path. Convention.
+			count(ht, "convention: RemoveAll below a file")
+			return true
+		}
+		note(ht, "RemoveAll(%q)", raw)
+		return p.sameErr("RemoveAll("+raw+")", p.mem.RemoveAll(raw), p.os.RemoveAll(raw))
+	case "Rename":
+		raw2 := s.Path2.render(live)
+		cq := canon(raw2)
+		qKind := kindOf(p.os, cq)
+		qParentKind := kindOf(p.os, path.Dir(cq))
+		switch {
+		case cp == cq && kind == kindDir:
+			// Go's os.Rename reports EEXIST for a directory renamed onto
+			// itself; MemMapFs treats equal names as a no-op. Convention.
+			count(ht, "convention: Rename(dir, dir)")
+			return true
+		case kind != kindMissing && qKind == kindDir && cq != cp:
+			// Go's os.Rename refuses any existing directory as destination
+			// (EEXIST), even an empty one. Convention.
+			count(ht, "convention: Rename onto a directory")
+			return true
+		case kind != kindMissing && strings.HasPrefix(cq, cp+"/") && (kind == kindFile || qParentKind == kindMissing):
+			// MemMapFs.Rename of an entry to a path below itself whose parent
+			// does not exist (or of a file to any path below itself) panics
+			// in unRegisterWithParent ("parent of ... is nil", memmap.go:74)
+			// and the deferred RUnlock then aborts the process; OsFs returns
+			// EINVAL/ENOTDIR. Not recorded yet; the shape is left out in
+			// both modes because the crash cannot be recovered in-process.
+			count(ht, "candidate/go/afero-1: Rename below itself with a missing parent panics")
+			return true
+		}
+		var shapes []string
+		if kind == kindMissing {
+			shapes = []string{shapeIf(cp == cq, "afero/29")} // fails on both otherwise
+		} else {
+			shapes = []string{
+				shapeIf(strings.HasPrefix(cq, cp+"/"), "afero/8"),
+				shapeIf(qKind == kindFile && kind == kindDir, "afero/7"),
+				shapeIf(qParentKind == kindMissing, "afero/2"),
+				shapeIf(qParentKind == kindFile, "afero/5"),
+			}
+		}
+		if !p.gate(shapes...) {
+			return true
+		}
+		note(ht, "Rename(%q, %q)", raw, raw2)
+		return p.sameErr("Rename("+raw+", "+raw2+")", p.mem.Rename(raw, raw2), p.os.Rename(raw, raw2))
+	case "Chmod":
+		mode := s.FilePerm
+		if kind == kindDir {
+			mode = s.Perm
+		}
+		note(ht, "Chmod(%q, %o)", raw, mode)
+		return p.sameErr("Chmod("+raw+")", p.mem.Chmod(raw, mode), p.os.Chmod(raw, mode))
+	case "Chtimes":
+		when := time.Unix(s.When, 0)
+		note(ht, "Chtimes(%q, %v)", raw, when)
+		if !p.sameErr("Chtimes("+raw+")", p.mem.Chtimes(raw, when, when), p.os.Chtimes(raw, when, when)) {
+			return false
+		}
+		mfi, merr := p.mem.Stat(raw)
+		ofi, oerr := p.os.Stat(raw)
+		if merr == nil && oerr == nil {
+			return p.same("ModTime after Chtimes("+raw+")", mfi.ModTime().Unix(), ofi.ModTime().Unix())
+		}
+		return true
+	case "Stat":
+		note(ht, "Stat(%q)", raw)
+		mfi, merr := p.mem.Stat(raw)
+		ofi, oerr := p.os.Stat(raw)
+		return p.same("Stat("+raw+")", statSummary(mfi, merr, cp != "/"), statSummary(ofi, oerr, cp != "/"))
+	case "ReadDir":
+		note(ht, "ReadDir(%q)", raw)
+		ml, merr := afero.ReadDir(p.mem, raw)
+		ol, oerr := afero.ReadDir(p.os, raw)
+		if !p.sameErr("ReadDir("+raw+")", merr, oerr) {
+			return false
+		}
+		return p.same("ReadDir("+raw+")", dirList(ml), dirList(ol))
+	default: // ReadFile
+		if !p.gate(shapeIf(kind == kindDir, "afero/14")) {
+			return true
+		}
+		note(ht, "ReadFile(%q)", raw)
+		md, merr := afero.ReadFile(p.mem, raw)
+		od, oerr := afero.ReadFile(p.os, raw)
+		if !p.sameErr("ReadFile("+raw+")", merr, oerr) {
+			return false
+		}
+		return p.same("ReadFile("+raw+")", string(md), string(od))
+	}
+}
+
+// handleOps applies the step's handle operations to the two open files,
+// compares every result and closes both.
+func (p *pair) handleOps(s memStep, cp string, mf, of afero.File, acc int, appendMode, isDir bool) bool {
+	ok := p.handleOpsInner(s.Handle, cp, mf, of, acc, appendMode, isDir)
+	merr, oerr := mf.Close(), of.Close()
+	if ok {
+		ok = p.sameErr("Close", merr, oerr)
+	}
+	if ok && s.Again {
+		ok = p.sameErr("second Close", mf.Close(), of.Close())
+	}
+	return ok
+}
+
+func (p *pair) handleOpsInner(ops []handleOp, cp string, mf, of afero.File, acc int, appendMode, isDir bool) bool {
+	ht := p.ht
+	if cp != "/" && !p.same("Name()", mf.Name(), of.Name()) {
+		return false
+	}
+	for _, h := range ops {
+		fileOp := h.Op != "Stat" && h.Op != "Readdir"
+		writeOp := h.Op == "Write" || h.Op == "WriteString" || h.Op == "WriteAt" || h.Op == "Truncate"
+		readOp := h.Op == "Read" || h.Op == "ReadAt"
+		moveOp := h.Op == "Read" || h.Op == "WriteAt" || h.Op == "Seek" || h.Op == "Truncate"
+		if !p.gate(
+			shapeIf(isDir && fileOp, "afero/14"),
+			shapeIf(writeOp && acc == accessR, "afero/12"),
+			shapeIf(readOp && acc == accessW, "afero/12"),
+			shapeIf(moveOp && appendMode, "afero/11"),
+			shapeIf((h.Op == "Write" || h.Op == "WriteString" || h.Op == "WriteAt") && len(h.Data) == 0, "afero/31"),
+		) {
+			continue
+		}
+		switch h.Op {
+		case "Write", "WriteString":
+			var mn, on int
+			var merr, oerr error
+			if h.Op == "Write" {
+				mn, merr = mf.Write(h.Data)
+				on, oerr = of.Write(h.Data)
+			} else {
+				mn, merr = mf.WriteString(string(h.Data))
+				on, oerr = of.WriteString(string(h.Data))
+			}
+			note(ht, "  %s(%q)", h.Op, h.Data)
+			if !p.sameErr(h.Op, merr, oerr) || !p.same(h.Op+" count", mn, on) {
+				return false
+			}
+		case "Read":
+			buf1, buf2 := make([]byte, h.Size), make([]byte, h.Size)
+			mn, merr := mf.Read(buf1)
+			on, oerr := of.Read(buf2)
+			note(ht, "  Read(%d) -> %d %v / %d %v", h.Size, mn, merr, on, oerr)
+			if errors.Is(merr, io.ErrUnexpectedEOF) && (errors.Is(oerr, io.EOF) || (oerr == nil && on == 0)) && p.accept("afero/10") {
+				merr = oerr
+			}
+			if !p.sameErr("Read", merr, oerr) || !p.same("Read result", fmt.Sprintf("%d %q", mn, buf1[:mn]), fmt.Sprintf("%d %q", on, buf2[:on])) {
+				return false
+			}
+		case "ReadAt":
+			buf1, buf2 := make([]byte, h.Size), make([]byte, h.Size)
+			mn, merr := mf.ReadAt(buf1, h.Off)
+			on, oerr := of.ReadAt(buf2, h.Off)
+			note(ht, "  ReadAt(%d, %d) -> %d %v / %d %v", h.Size, h.Off, mn, merr, on, oerr)
+			if errors.Is(merr, io.ErrUnexpectedEOF) && (errors.Is(oerr, io.EOF) || (oerr == nil && on == 0)) && p.accept("afero/10") {
+				merr = oerr
+			}
+			if !p.sameErr("ReadAt", merr, oerr) || !p.same("ReadAt result", fmt.Sprintf("%d %q", mn, buf1[:mn]), fmt.Sprintf("%d %q", on, buf2[:on])) {
+				return false
+			}
+		case "WriteAt":
+			mn, merr := mf.WriteAt(h.Data, h.Off)
+			on, oerr := of.WriteAt(h.Data, h.Off)
+			note(ht, "  WriteAt(%q, %d)", h.Data, h.Off)
+			if !p.sameErr("WriteAt", merr, oerr) || !p.same("WriteAt count", mn, on) {
+				return false
+			}
+		case "Seek":
+			mpos, merr := mf.Seek(h.Off, h.Whence)
+			opos, oerr := of.Seek(h.Off, h.Whence)
+			note(ht, "  Seek(%d, %d) -> %d %v / %d %v", h.Off, h.Whence, mpos, merr, opos, oerr)
+			if oerr != nil && merr == nil {
+				// MemMapFs accepted what the OS refused: a bad whence
+				// (afero/18) or a negative position (afero/9), after which
+				// its next Read or Write would panic. While accepted, the
+				// handle's life ends here.
+				id := "afero/9"
+				if h.Whence < io.SeekStart || h.Whence > io.SeekEnd {
+					id = "afero/18"
+				}
+				if p.accept(id) {
+					return true
+				}
+			}
+			if !p.sameErr("Seek", merr, oerr) || (merr == nil && !p.same("Seek position", mpos, opos)) {
+				return false
+			}
+		case "Stat":
+			mfi, merr := mf.Stat()
+			ofi, oerr := of.Stat()
+			if !p.same("File.Stat()", statSummary(mfi, merr, !isDir || mf.Name() != "/"), statSummary(ofi, oerr, !isDir || mf.Name() != "/")) {
+				return false
+			}
+			if !p.sameErr("Sync", mf.Sync(), of.Sync()) {
+				return false
+			}
+		case "Readdir":
+			if !isDir {
+				merr := errClass(func() error { _, err := mf.Readdir(-1); return err }())
+				oerr := errClass(func() error { _, err := of.Readdir(-1); return err }())
+				if merr == "ok" || oerr == "ok" {
+					p.fail("Readdir on a file handle: %s %s, %s %s", p.memName(), merr, p.osName(), oerr)
+					return false
+				}
+				continue
+			}
+			var mAll, oAll []string
+			for calls := 0; calls < 5; calls++ {
+				var mn, on []string
+				var merr, oerr error
+				if h.Names {
+					mn, merr = mf.Readdirnames(h.Page)
+					on, oerr = of.Readdirnames(h.Page)
+				} else {
+					var ml, ol []os.FileInfo
+					ml, merr = mf.Readdir(h.Page)
+					ol, oerr = of.Readdir(h.Page)
+					for _, fi := range ml {
+						mn = append(mn, fi.Name())
+					}
+					for _, fi := range ol {
+						on = append(on, fi.Name())
+					}
+				}
+				note(ht, "  Readdir(%d) -> %v %v / %v %v", h.Page, mn, merr, on, oerr)
+				if !p.sameErr("Readdir page error", merr, oerr) || !p.same("Readdir page size", len(mn), len(on)) {
+					return false
+				}
+				mAll = append(mAll, mn...)
+				oAll = append(oAll, on...)
+				if merr != nil || h.Page <= 0 {
+					break
+				}
+			}
+			sort.Strings(mAll)
+			sort.Strings(oAll)
+			if !p.same("Readdir names", mAll, oAll) {
+				return false
+			}
+		case "Truncate":
+			note(ht, "  Truncate(%d)", h.Off)
+			if !p.sameErr("Truncate", mf.Truncate(h.Off), of.Truncate(h.Off)) {
+				return false
+			}
+		}
+	}
+	return true
+}
