+// TestHegelADirectoryIsNotAFile: ReadFile of a directory, OpenFile of one
+// with write flags, or Read/ReadAt on a directory handle (afero/14).
+func TestHegelADirectoryIsNotAFile(t *testing.T) {
+	memShape(t, "afero/14", func(ht *hegel.T, r *memRun) {
+		if !r.quiet(ht) {
+			return
+		}
+		d := r.fresh(ht)
+		r.mkdir(d)
+		if hegel.Draw(ht, chance(40)) {
+			r.write(d+"/"+hegel.Draw(ht, shapeName), hegel.Draw(ht, dataBytes), 0o644)
+		}
+		p := spec(d, hegel.Draw(ht, pathDecos))
+		switch hegel.Draw(ht, hegel.SampledFrom([]string{"ReadFile", "OpenFile", "Open"})) {
+		case "ReadFile":
+			r.run(memStep{Op: "ReadFile", Path: p})
+		case "OpenFile":
+			// O_RDONLY|O_APPEND is left out: the OS opens a directory with it.
+			flags := hegel.Draw(ht, hegel.SampledFrom([]openFlags{{Acc: accessW}, {Acc: accessRW}, {Acc: accessR, Create: true}, {Acc: accessRW, Create: true}}))
+			r.run(memStep{Op: "OpenFile", Path: p, Flags: flags, Perm: hegel.Draw(ht, filePerms)})
+		default:
+			op := handleOp{Op: hegel.Draw(ht, hegel.SampledFrom([]string{"Read", "ReadAt"})), Size: hegel.Draw(ht, hegel.Integers(1, 8))}
+			if op.Op == "ReadAt" {
+				op.Off = int64(hegel.Draw(ht, hegel.Integers(0, 3)))
+			}
+			r.run(memStep{Op: "Open", Path: p, Handle: []handleOp{op}})
+		}
+	})
+}
