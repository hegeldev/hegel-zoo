new file mode 100644
index 0000000..ef03c3e
--- /dev/null
+++ b/hegel/hegel_util_test.go
@@ -0,0 +1,733 @@
+package hegel
+
+// The package-level helpers (ReadDir, ReadFile, WriteFile, Exists, DirExists,
+// IsDir, IsEmpty, Walk, WalkDir, Glob, FileContainsBytes, TempFile, TempDir,
+// WriteReader, SafeWriteReader, ReadAll) on a MemMapFs and on an OsFs holding
+// the same tree, against each other and against os/filepath.
+
+import (
+	"bytes"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/spf13/afero"
+	"golang.org/x/text/unicode/norm"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Trees.
+
+var treeNames = []string{"a", "b", "c", "x y", "\u00e9", ".h", "a-b", "b.txt", "c.log"}
+
+var names = hegel.SampledFrom(treeNames)
+
+// treeDir is a directory to create below the live directory at a position;
+// treeFile a file with its content. A name already taken is a no-op.
+type treeDir struct {
+	At   int
+	Name string
+}
+
+type treeFile struct {
+	At   int
+	Name string
+	Data []byte
+}
+
+// treeSpec is a drawn tree: up to 5 directories, then up to 7 files.
+type treeSpec struct {
+	Dirs  []treeDir
+	Files []treeFile
+}
+
+var treeDirs = hegel.Composite(func(tc hegel.TestCase) treeDir {
+	return treeDir{At: hegel.Draw(tc, positions), Name: hegel.Draw(tc, names)}
+})
+
+var treeFiles = hegel.Composite(func(tc hegel.TestCase) treeFile {
+	return treeFile{At: hegel.Draw(tc, positions), Name: hegel.Draw(tc, names), Data: hegel.Draw(tc, dataBytes)}
+})
+
+var treeSpecs = hegel.Composite(func(tc hegel.TestCase) treeSpec {
+	return treeSpec{Dirs: hegel.Draw(tc, many(treeDirs, 0, 5)), Files: hegel.Draw(tc, many(treeFiles, 0, 7))}
+})
+
+func (t treeSpec) GoString() string {
+	var parts []string
+	for _, d := range t.Dirs {
+		parts = append(parts, fmt.Sprintf("dir <%d>/%s", d.At, d.Name))
+	}
+	for _, f := range t.Files {
+		parts = append(parts, fmt.Sprintf("file <%d>/%s %q", f.At, f.Name, f.Data))
+	}
+	return "tree{" + strings.Join(parts, ", ") + "}"
+}
+
+// build creates the tree (directories first, then files) on every given file
+// system and returns the directories and files created, sorted.
+func (t treeSpec) build(fss ...afero.Fs) (dirs, files []string, content map[string][]byte) {
+	dirs = []string{"/"}
+	content = map[string][]byte{}
+	isDir := func(p string) bool {
+		for _, e := range dirs {
+			if e == p {
+				return true
+			}
+		}
+		return false
+	}
+	for _, d := range t.Dirs {
+		nd := childOf(at(dirs, d.At), d.Name)
+		if content[nd] != nil || isDir(nd) {
+			continue
+		}
+		for _, f := range fss {
+			if err := f.MkdirAll(nd, 0o755); err != nil {
+				panic(err)
+			}
+		}
+		dirs = append(dirs, nd)
+	}
+	for _, fl := range t.Files {
+		nf := childOf(at(dirs, fl.At), fl.Name)
+		if isDir(nf) || content[nf] != nil {
+			continue
+		}
+		for _, f := range fss {
+			if err := afero.WriteFile(f, nf, fl.Data, 0o644); err != nil {
+				panic(err)
+			}
+		}
+		files = append(files, nf)
+		content[nf] = fl.Data
+	}
+	sort.Strings(dirs)
+	sort.Strings(files)
+	return dirs, files, content
+}
+
+// childOf joins a directory and a name without doubling the root's slash.
+func childOf(d, name string) string {
+	if d == "/" {
+		d = ""
+	}
+	return d + "/" + name
+}
+
+// pathPick is a drawn path of a built tree: one of its directories, one of
+// its files (a directory when there are none), or a fresh name below one of
+// its directories.
+type pathPick struct {
+	Kind int // 0 directory, 1 file, 2 fresh name
+	At   int
+	Name string
+}
+
+var pathPicks = hegel.Composite(func(tc hegel.TestCase) pathPick {
+	return pathPick{
+		Kind: hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 2, 2})),
+		At:   hegel.Draw(tc, positions),
+		Name: hegel.Draw(tc, names),
+	}
+})
+
+func (q pathPick) resolve(dirs, files []string) string {
+	switch {
+	case q.Kind == 0, q.Kind == 1 && len(files) == 0:
+		return at(dirs, q.At)
+	case q.Kind == 1:
+		return at(files, q.At)
+	}
+	return childOf(at(dirs, q.At), q.Name)
+}
+
+func (q pathPick) GoString() string {
+	switch q.Kind {
+	case 0:
+		return fmt.Sprintf("dir<%d>", q.At)
+	case 1:
+		return fmt.Sprintf("file<%d>", q.At)
+	}
+	return fmt.Sprintf("dir<%d>/%s", q.At, q.Name)
+}
+
+// ---------------------------------------------------------------------------
+// Steps of the helpers property.
+
+// subSpec is one needle of FileContainsAnyBytes: fresh bytes, or a slice of
+// the file's content between two positions.
+type subSpec struct {
+	Slice  bool
+	Lo, Hi int
+	Fresh  []byte
+}
+
+var subSpecs = weighted(
+	choice[subSpec]{1, hegel.Composite(func(tc hegel.TestCase) subSpec {
+		return subSpec{Fresh: hegel.Draw(tc, dataBytes)}
+	})},
+	choice[subSpec]{1, hegel.Composite(func(tc hegel.TestCase) subSpec {
+		return subSpec{Slice: true, Lo: hegel.Draw(tc, positions), Hi: hegel.Draw(tc, positions)}
+	})},
+)
+
+func (s subSpec) resolve(data []byte) []byte {
+	if !s.Slice {
+		return s.Fresh
+	}
+	if len(data) == 0 {
+		return nil
+	}
+	lo := s.Lo % len(data)
+	hi := lo + s.Hi%(len(data)-lo+1)
+	return append([]byte(nil), data[lo:hi]...)
+}
+
+// Glob decorations of one path element: plain, "*", first letter and "*",
+// "?" and the rest, a class around the first letter, and (while afero/28 and
+// afero/40 are switched on) a backslash escape and an unclosed class, which
+// is a malformed pattern.
+var globDecos = shaped(
+	hegel.SampledFrom([]string{"plain", "plain", "star", "prefix", "question", "class", "backslash", "bracket"}),
+	hegel.SampledFrom([]string{"plain", "plain", "star", "prefix", "question", "class"}),
+)
+
+func decorate(part, deco string) string {
+	switch deco {
+	case "star":
+		return "*"
+	case "prefix":
+		return part[:1] + "*"
+	case "question":
+		return "?" + part[1:]
+	case "class":
+		return "[" + part[:1] + "x]" + part[1:]
+	case "backslash":
+		return `\` + part
+	case "bracket":
+		return "[" + part
+	}
+	return part
+}
+
+// malformed reports whether filepath.Match rejects the pattern (an unclosed
+// class, an invalid byte in a class): filepath.Glob checks that first, Glob
+// only while matching the entries of a directory (afero/40).
+func malformed(pat string) bool {
+	_, err := filepath.Match(pat, "")
+	return err != nil
+}
+
+// pattern renders the glob pattern of a path: every element takes the
+// decoration at its index of the tape (plain when the tape is empty).
+func pattern(base string, tape []string) string {
+	parts := strings.Split(strings.TrimPrefix(base, "/"), "/")
+	for i, part := range parts {
+		if part == "" || len(tape) == 0 {
+			continue
+		}
+		parts[i] = decorate(part, at(tape, i))
+	}
+	return "/" + strings.Join(parts, "/")
+}
+
+var unicodePool = []string{"a", "Z", "9", ".", "/", "\\", "_", "-", "%", " ", "#", "\u00e9", "e\u0301", "\u4e2d", "!", "*", ":", "\u0301", "\u0f04", "\ufb01"}
+
+var unicodeNames = join(many(hegel.SampledFrom(unicodePool), 0, 8))
+
+// helperStep is one operation of the helpers property; only the fields the
+// operation uses are drawn.
+type helperStep struct {
+	Op      string // Exists, ReadDir, ReadFile, Walk, WalkSkip, Glob, Contains, Temp, Unicode, Write
+	Path    pathPick
+	Stop    int  // WalkSkip: position among the tree's entries
+	SkipAll bool // WalkSkip: SkipAll instead of SkipDir
+	Tape    []string
+	Sub     string // Glob: an element added below the path (the narrow properties)
+	Subs    []subSpec
+	Prefix  string
+	Suffix  string
+	Star    bool
+	Data    []byte
+	Kind    int // Write: 0 WriteReader, 1 SafeWriteReader, 2 WriteFile
+	Name    string
+}
+
+func (s helperStep) GoString() string {
+	switch s.Op {
+	case "WalkSkip":
+		return fmt.Sprintf("WalkSkip(%#v, stop <%d>, all %v)", s.Path, s.Stop, s.SkipAll)
+	case "Glob":
+		if s.Sub != "" {
+			return fmt.Sprintf("Glob(%#v, %v, %q)", s.Path, s.Tape, s.Sub)
+		}
+		return fmt.Sprintf("Glob(%#v, %v)", s.Path, s.Tape)
+	case "Contains":
+		return fmt.Sprintf("Contains(file<%d>, %#v)", s.Path.At, s.Subs)
+	case "Temp":
+		return fmt.Sprintf("Temp(dir<%d>, %q, %q, star %v)", s.Path.At, s.Prefix, s.Suffix, s.Star)
+	case "Unicode":
+		return fmt.Sprintf("Unicode(%q)", s.Name)
+	case "Write":
+		return fmt.Sprintf("%s(%#v, %q)", [...]string{"WriteReader", "SafeWriteReader", "WriteFile"}[s.Kind], s.Path, s.Data)
+	}
+	return fmt.Sprintf("%s(%#v)", s.Op, s.Path)
+}
+
+func helperStepOf(op string, fields func(tc hegel.TestCase, s *helperStep)) hegel.Generator[helperStep] {
+	return hegel.Composite(func(tc hegel.TestCase) helperStep {
+		s := helperStep{Op: op, Path: hegel.Draw(tc, pathPicks)}
+		if fields != nil {
+			fields(tc, &s)
+		}
+		return s
+	})
+}
+
+var helperSteps = weighted(
+	choice[helperStep]{1, helperStepOf("Exists", nil)},
+	choice[helperStep]{1, helperStepOf("ReadDir", nil)},
+	choice[helperStep]{1, helperStepOf("ReadFile", nil)},
+	choice[helperStep]{1, helperStepOf("Walk", nil)},
+	choice[helperStep]{1, helperStepOf("WalkSkip", func(tc hegel.TestCase, s *helperStep) {
+		s.Stop = hegel.Draw(tc, positions)
+		s.SkipAll = hegel.Draw(tc, hegel.Booleans())
+	})},
+	choice[helperStep]{1, helperStepOf("Glob", func(tc hegel.TestCase, s *helperStep) {
+		s.Tape = hegel.Draw(tc, many(globDecos, 0, 4))
+	})},
+	choice[helperStep]{1, helperStepOf("Contains", func(tc hegel.TestCase, s *helperStep) {
+		s.Subs = hegel.Draw(tc, many(subSpecs, 1, 3))
+	})},
+	choice[helperStep]{1, helperStepOf("Temp", func(tc hegel.TestCase, s *helperStep) {
+		s.Prefix = hegel.Draw(tc, hegel.SampledFrom([]string{"tmp", "", "x-"}))
+		s.Suffix = hegel.Draw(tc, hegel.SampledFrom([]string{"", ".txt"}))
+		s.Star = hegel.Draw(tc, chance(30))
+	})},
+	choice[helperStep]{1, helperStepOf("Unicode", func(tc hegel.TestCase, s *helperStep) {
+		s.Name = hegel.Draw(tc, unicodeNames)
+	})},
+	choice[helperStep]{1, helperStepOf("Write", func(tc hegel.TestCase, s *helperStep) {
+		s.Data = hegel.Draw(tc, dataBytes)
+		s.Kind = hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 2}))
+	})},
+)
+
+// helperCase is the case of the helpers property: a tree and 1..8 steps.
+type helperCase struct {
+	Tree  treeSpec
+	Steps []helperStep
+}
+
+func (c helperCase) GoString() string {
+	var b strings.Builder
+	b.WriteString("helperCase{\n\t" + c.Tree.GoString())
+	for _, s := range c.Steps {
+		b.WriteString("\n\t" + s.GoString())
+	}
+	b.WriteString("\n}")
+	return b.String()
+}
+
+var helperCases = hegel.Composite(func(tc hegel.TestCase) helperCase {
+	return helperCase{Tree: hegel.Draw(tc, treeSpecs), Steps: hegel.Draw(tc, many(helperSteps, 1, 8))}
+})
+
+// ---------------------------------------------------------------------------
+// The property.
+
+// TestHegelHelpersMatchTheOs: the helpers give the same answers on a
+// MemMapFs and on an OsFs holding the same tree, and the answers are the
+// ones os and path/filepath give.
+func TestHegelHelpersMatchTheOs(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, helperCases)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		r := newHelperRun(ht, dir)
+		defer r.p.recoverPanics()
+		r.build(c.Tree)
+		for _, s := range c.Steps {
+			if !r.step(s) {
+				return
+			}
+		}
+	})
+}
+
+// helperRun is the state of one case of the helpers property: a MemMapFs
+// and an OsFs confined to dir holding the same tree, and the lists a step's
+// path is resolved in.
+type helperRun struct {
+	p       *pair
+	mem     afero.Fs
+	osfs    afero.Fs
+	dir     string
+	dirs    []string
+	files   []string
+	content map[string][]byte
+}
+
+func newHelperRun(ht *hegel.T, dir string) *helperRun {
+	mem := afero.NewMemMapFs()
+	osfs := afero.NewBasePathFs(afero.NewOsFs(), dir)
+	return &helperRun{p: &pair{ht: ht, mem: mem, os: osfs}, mem: mem, osfs: osfs, dir: dir}
+}
+
+// build creates the tree on both file systems.
+func (r *helperRun) build(tree treeSpec) {
+	r.dirs, r.files, r.content = tree.build(r.mem, r.osfs)
+}
+
+// step applies one operation to both file systems and compares the answers
+// (and, for the helpers with one, the answer of os or path/filepath); false
+// ends the case.
+func (r *helperRun) step(s helperStep) bool {
+	p, ht, mem, osfs, dir := r.p, r.p.ht, r.mem, r.osfs, r.dir
+	dirs, files, content := r.dirs, r.files, r.content
+	p.shapes = nil
+	q := s.Path.resolve(dirs, files)
+	switch s.Op {
+	case "ReadDir":
+		ml, merr := afero.ReadDir(mem, q)
+		ol, oerr := afero.ReadDir(osfs, q)
+		if !p.sameErr("ReadDir("+q+")", merr, oerr) || !p.same("ReadDir("+q+")", dirList(ml), dirList(ol)) {
+			return false
+		}
+		if merr == nil {
+			// Sorted by name, as documented.
+			for j := 1; j < len(ml); j++ {
+				if ml[j-1].Name() >= ml[j].Name() {
+					p.fail("ReadDir(%s) is not sorted: %v", q, dirList(ml))
+					return false
+				}
+			}
+		}
+	case "ReadFile": // ReadFile / ReadAll
+		isDir, _ := afero.IsDir(osfs, q)
+		if !p.gate(shapeIf(isDir, "afero/14")) {
+			return true
+		}
+		md, merr := afero.ReadFile(mem, q)
+		od, oerr := afero.ReadFile(osfs, q)
+		if !p.sameErr("ReadFile("+q+")", merr, oerr) || !p.same("ReadFile("+q+")", string(md), string(od)) {
+			return false
+		}
+		if want, ok := content[q]; ok && string(md) != string(want) {
+			p.fail("ReadFile(%s) = %q, want %q", q, md, want)
+			return false
+		}
+		if merr == nil {
+			f, _ := mem.Open(q)
+			all, err := afero.ReadAll(f)
+			f.Close()
+			if err != nil || string(all) != string(md) {
+				p.fail("ReadAll(Open(%s)) = %q, %v; ReadFile gave %q", q, all, err, md)
+				return false
+			}
+		}
+	case "Exists": // Exists / DirExists / IsDir / IsEmpty
+		type answers struct {
+			exists, dirExists, isDir, isEmpty bool
+			isDirErr, isEmptyErr              string
+		}
+		ask := func(f afero.Fs) answers {
+			var a answers
+			a.exists, _ = afero.Exists(f, q)
+			a.dirExists, _ = afero.DirExists(f, q)
+			var err error
+			a.isDir, err = afero.IsDir(f, q)
+			a.isDirErr = errClass(err)
+			a.isEmpty, err = afero.IsEmpty(f, q)
+			a.isEmptyErr = fmt.Sprint(err != nil)
+			return a
+		}
+		ma, oa := ask(mem), ask(osfs)
+		if !p.same("Exists/DirExists/IsDir/IsEmpty("+q+")", fmt.Sprintf("%+v", ma), fmt.Sprintf("%+v", oa)) {
+			return false
+		}
+		_, serr := os.Stat(filepath.Join(dir, q))
+		if ma.exists != (serr == nil) {
+			p.fail("Exists(%s) = %v, os.Stat says %v", q, ma.exists, serr)
+			return false
+		}
+	case "Walk":
+		mw, merr := walkList(mem, q, "")
+		ow, oerr := walkList(osfs, q, "")
+		if !p.sameErr("Walk("+q+")", merr, oerr) || !p.same("Walk("+q+")", mw, ow) {
+			return false
+		}
+		want, werr := walkList(nil, filepath.Join(dir, q), dir)
+		if errClass(werr) != errClass(oerr) || fmt.Sprint(want) != fmt.Sprint(ow) {
