@@ -0,0 +1,9 @@
+//go:build unix
+
+package hegel
+
+import "syscall"
+
+// The OsFs side applies the process umask to the modes it is given and the
+// MemMapFs does not; clear it so that both keep the requested bits.
+func init() { syscall.Umask(0) }
diff --git a/hegel/hegel_util_test.go b/hegel/hegel_util_test.go
new file mode 100644
index 0000000..4185695
--- /dev/null
+++ b/hegel/hegel_util_test.go
@@ -0,0 +1,497 @@
+package hegel
+
+// The package-level helpers (ReadDir, ReadFile, WriteFile, Exists, DirExists,
+// IsDir, IsEmpty, Walk, WalkDir, Glob, FileContainsBytes, TempFile, TempDir,
+// WriteReader, SafeWriteReader, ReadAll) on a MemMapFs and on an OsFs holding
+// the same tree, against each other and against os/filepath.
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/spf13/afero"
+	"golang.org/x/text/unicode/norm"
+	"hegel.dev/go/hegel"
+)
+
+var treeNames = []string{"a", "b", "c", "x y", "\u00e9", ".h", "a-b", "b.txt", "c.log"}
+
+// buildTree creates the same random tree (directories first, then files) on
+// every given file system and returns the directories and files created.
+func buildTree(tc hegel.TestCase, fss ...afero.Fs) (dirs, files []string, content map[string][]byte) {
+	dirs = []string{"/"}
+	content = map[string][]byte{}
+	for i, k := 0, n(tc, 0, 5); i < k; i++ {
+		d := pick(tc, dirs...)
+		if d == "/" {
+			d = ""
+		}
+		nd := d + "/" + pick(tc, treeNames...)
+		if content[nd] != nil {
+			continue
+		}
+		dup := false
+		for _, e := range dirs {
+			dup = dup || e == nd
+		}
+		if dup {
+			continue
+		}
+		for _, f := range fss {
+			if err := f.MkdirAll(nd, 0o755); err != nil {
+				panic(err)
+			}
+		}
+		dirs = append(dirs, nd)
+	}
+	for i, k := 0, n(tc, 0, 7); i < k; i++ {
+		d := pick(tc, dirs...)
+		if d == "/" {
+			d = ""
+		}
+		nf := d + "/" + pick(tc, treeNames...)
+		isDir := false
+		for _, e := range dirs {
+			isDir = isDir || e == nf
+		}
+		if isDir || content[nf] != nil {
+			continue
+		}
+		data := genData(tc)
+		for _, f := range fss {
+			if err := afero.WriteFile(f, nf, data, 0o644); err != nil {
+				panic(err)
+			}
+		}
+		files = append(files, nf)
+		content[nf] = data
+	}
+	sort.Strings(dirs)
+	sort.Strings(files)
+	return dirs, files, content
+}
+
+func anyPath(tc hegel.TestCase, dirs, files []string) string {
+	switch n(tc, 0, 3) {
+	case 0:
+		return pick(tc, dirs...)
+	case 1:
+		if len(files) > 0 {
+			return pick(tc, files...)
+		}
+		return pick(tc, dirs...)
+	default:
+		d := pick(tc, dirs...)
+		if d == "/" {
+			d = ""
+		}
+		return d + "/" + pick(tc, treeNames...)
+	}
+}
+
+// TestHegelHelpersMatchTheOs: the helpers give the same answers on a
+// MemMapFs and on an OsFs holding the same tree, and the answers are the
+// ones os and path/filepath give.
+func TestHegelHelpersMatchTheOs(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-afero-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer os.RemoveAll(dir)
+		mem := afero.NewMemMapFs()
+		osfs := afero.NewBasePathFs(afero.NewOsFs(), dir)
+		p := &pair{ht: ht, mem: mem, os: osfs}
+		dirs, files, content := buildTree(tc, mem, osfs)
+		note(ht, "dirs %v files %v", dirs, files)
+		for i, k := 0, n(tc, 1, 8); i < k; i++ {
+			q := anyPath(tc, dirs, files)
+			switch n(tc, 0, 9) {
+			case 0: // ReadDir
+				ml, merr := afero.ReadDir(mem, q)
+				ol, oerr := afero.ReadDir(osfs, q)
+				if !p.sameErr("ReadDir("+q+")", merr, oerr) || !p.same("ReadDir("+q+")", dirList(ml), dirList(ol)) {
+					return
+				}
+				if merr == nil {
+					// Sorted by name, as documented.
+					for j := 1; j < len(ml); j++ {
+						if ml[j-1].Name() >= ml[j].Name() {
+							fail(ht, "ReadDir(%s) is not sorted: %v", q, dirList(ml))
+							return
+						}
+					}
+				}
+			case 1: // ReadFile / ReadAll
+				if isDir, _ := afero.IsDir(osfs, q); isDir && Known.DirectoryHandleIsAFile {
+					count(ht, "skip: ReadFile of a directory (afero/14)")
+					continue
+				}
+				md, merr := afero.ReadFile(mem, q)
+				od, oerr := afero.ReadFile(osfs, q)
+				if !p.sameErr("ReadFile("+q+")", merr, oerr) || !p.same("ReadFile("+q+")", string(md), string(od)) {
+					return
+				}
+				if want, ok := content[q]; ok && string(md) != string(want) {
+					fail(ht, "ReadFile(%s) = %q, want %q", q, md, want)
+					return
+				}
+				if merr == nil {
+					f, _ := mem.Open(q)
+					all, err := afero.ReadAll(f)
+					f.Close()
+					if err != nil || string(all) != string(md) {
+						fail(ht, "ReadAll(Open(%s)) = %q, %v; ReadFile gave %q", q, all, err, md)
+						return
+					}
+				}
+			case 2: // Exists / DirExists / IsDir / IsEmpty
+				type answers struct {
+					exists, dirExists, isDir, isEmpty bool
+					isDirErr, isEmptyErr              string
+				}
+				ask := func(f afero.Fs) answers {
+					var a answers
+					a.exists, _ = afero.Exists(f, q)
+					a.dirExists, _ = afero.DirExists(f, q)
+					var err error
+					a.isDir, err = afero.IsDir(f, q)
+					a.isDirErr = errClass(err)
+					a.isEmpty, err = afero.IsEmpty(f, q)
+					a.isEmptyErr = fmt.Sprint(err != nil)
+					return a
+				}
+				ma, oa := ask(mem), ask(osfs)
+				if !p.same("Exists/DirExists/IsDir/IsEmpty("+q+")", fmt.Sprintf("%+v", ma), fmt.Sprintf("%+v", oa)) {
+					return
+				}
+				_, serr := os.Stat(filepath.Join(dir, q))
+				if ma.exists != (serr == nil) {
+					fail(ht, "Exists(%s) = %v, os.Stat says %v", q, ma.exists, serr)
+					return
+				}
+			case 3: // Walk
+				mw, merr := walkList(mem, q, "")
+				ow, oerr := walkList(osfs, q, "")
+				if !p.sameErr("Walk("+q+")", merr, oerr) || !p.same("Walk("+q+")", mw, ow) {
+					return
+				}
+				want, werr := walkList(nil, filepath.Join(dir, q), dir)
+				if errClass(werr) != errClass(oerr) || fmt.Sprint(want) != fmt.Sprint(ow) {
+					fail(ht, "Walk(%s) visited %v (%v); filepath.Walk visited %v (%v)", q, ow, oerr, want, werr)
+					return
+				}
+				// WalkDir agrees with Walk on the visited paths.
+				var wd []string
+				afero.WalkDir(mem, q, func(pth string, d fs.DirEntry, err error) error {
+					if err == nil {
+						wd = append(wd, fmt.Sprintf("%s dir=%v", canon(pth), d.IsDir()))
+					}
+					return nil
+				})
+				if fmt.Sprint(wd) != fmt.Sprint(mw) {
+					fail(ht, "WalkDir(%s) visited %v, Walk visited %v", q, wd, mw)
+					return
+				}
+			case 4: // Walk with SkipDir / SkipAll
+				if len(mw(dirs, files)) == 0 {
+					continue
+				}
+				stopAt := pick(tc, mw(dirs, files)...)
+				skip := pick(tc, filepath.SkipDir, filepath.SkipAll)
+				visit := func(f afero.Fs) (string, error) {
+					var seen []string
+					err := afero.Walk(f, q, func(pth string, info os.FileInfo, err error) error {
+						seen = append(seen, canon(pth))
+						if canon(pth) == stopAt {
+							return skip
+						}
+						return nil
+					})
+					return strings.Join(seen, " "), err
+				}
+				var want []string
+				werr := filepath.Walk(filepath.Join(dir, q), func(pth string, info os.FileInfo, err error) error {
+					rel := canon(strings.TrimPrefix(pth, dir))
+					want = append(want, rel)
+					if rel == stopAt {
+						return skip
+					}
+					return nil
+				})
+				ms, merr := visit(mem)
+				os_, oerr := visit(osfs)
+				note(ht, "Walk(%s) with %v at %s: mem %q %v, os %q %v, filepath %q %v", q, skip, stopAt, ms, merr, os_, oerr, strings.Join(want, " "), werr)
+				if ms != os_ || ms != strings.Join(want, " ") {
+					fail(ht, "Walk(%s) returning %v at %s visited: MemMapFs %q, OsFs %q, filepath.Walk %q", q, skip, stopAt, ms, os_, strings.Join(want, " "))
+					return
+				}
+				if Known.WalkReturnsSkip && merr == skip && oerr == skip && werr == nil {
+					count(ht, "accepted: Walk returned the skip sentinel (afero/27)")
+				} else if !p.sameErr("Walk error", merr, oerr) || !p.sameErr("Walk error vs filepath.Walk", oerr, werr) {
+					return
+				}
+			case 5: // Glob
+				pattern := genPattern(tc, dirs, files)
+				mg, merr := afero.Glob(mem, pattern)
+				og, oerr := afero.Glob(osfs, pattern)
+				want, werr := filepath.Glob(filepath.Join(dir, pattern))
+				for i := range want {
+					want[i] = canon(strings.TrimPrefix(want[i], dir))
+				}
+				for i := range og {
+					og[i] = canon(og[i])
+				}
+				for i := range mg {
+					mg[i] = canon(mg[i])
+				}
+				note(ht, "Glob(%s): mem %v %v, os %v %v, filepath %v %v", pattern, mg, merr, og, oerr, want, werr)
+				if !p.sameErr("Glob("+pattern+")", merr, oerr) || !p.same("Glob("+pattern+")", mg, og) {
+					return
+				}
+				if Known.GlobBackslash && strings.Contains(pattern, `\`) {
+					count(ht, "skip: Glob with a backslash escape (afero/28)")
+					continue
+				}
+				if (werr != nil) != (oerr != nil) || fmt.Sprint(want) != fmt.Sprint(og) {
+					fail(ht, "Glob(%s) = %v, %v; filepath.Glob = %v, %v", pattern, og, oerr, want, werr)
+					return
+				}
+			case 6: // FileContainsBytes / FileContainsAnyBytes
+				if len(files) == 0 {
+					continue
+				}
+				q = pick(tc, files...)
+				data := content[q]
+				var subs [][]byte
+				for i, k := 0, n(tc, 1, 3); i < k; i++ {
+					if len(data) > 0 && chance(tc, 50) {
+						lo := n(tc, 0, len(data)-1)
+						hi := n(tc, lo, len(data))
+						subs = append(subs, append([]byte(nil), data[lo:hi]...))
+					} else {
+						subs = append(subs, genData(tc))
+					}
+				}
+				want := false
+				for _, s := range subs {
+					want = want || (len(s) > 0 && bytes.Contains(data, s))
+				}
+				got, err := afero.FileContainsAnyBytes(mem, q, subs)
+				got1, err1 := afero.FileContainsBytes(mem, q, subs[0])
+				want1 := len(subs[0]) > 0 && bytes.Contains(data, subs[0])
+				ogot, oerr := afero.FileContainsAnyBytes(osfs, q, subs)
+				note(ht, "FileContainsAnyBytes(%s=%q, %q) = %v %v (os %v %v), want %v", q, data, subs, got, err, ogot, oerr, want)
+				if err != nil || err1 != nil || oerr != nil {
+					fail(ht, "FileContainsBytes errors: %v %v %v", err, err1, oerr)
+					return
+				}
+				if got != ogot {
+					fail(ht, "FileContainsAnyBytes(%s, %q): MemMapFs %v, OsFs %v", q, subs, got, ogot)
+					return
+				}
+				if got != want || got1 != want1 {
+					if Known.ContainsBytesPadding && ((got && !want) || (got1 && !want1)) {
+						count(ht, "accepted: FileContainsBytes false positive (afero/19)")
+						continue
+					}
+					fail(ht, "FileContainsAnyBytes(%q, %q) = %v, want %v; FileContainsBytes(%q) = %v, want %v", data, subs, got, want, subs[0], got1, want1)
+					return
+				}
+			case 7: // TempFile / TempDir
+				d := pick(tc, dirs...)
+				prefix := pick(tc, "tmp", "", "x-")
+				suffix := pick(tc, "", ".txt")
+				pattern := prefix
+				if suffix != "" || chance(tc, 30) {
+					pattern = prefix + "*" + suffix
+				}
+				for _, f := range []afero.Fs{mem, osfs} {
+					tf, err := afero.TempFile(f, d, pattern)
+					if err != nil {
+						fail(ht, "TempFile(%s, %s) on %s: %v", d, pattern, f.Name(), err)
+						return
+					}
+					name := tf.Name()
+					fi, serr := tf.Stat()
+					tf.Close()
+					base := path.Base(name)
+					if canon(path.Dir(name)) != canon(d) || !strings.HasPrefix(base, prefix) || !strings.HasSuffix(base, suffix) || len(base) <= len(prefix)+len(suffix) {
+						fail(ht, "TempFile(%s, %s) on %s named the file %q", d, pattern, f.Name(), name)
+						return
+					}
+					if serr != nil || fi.IsDir() || fi.Size() != 0 || fi.Mode().Perm() != 0o600 {
+						fail(ht, "TempFile(%s, %s) on %s: Stat %v %v", d, pattern, f.Name(), statSummary(fi, serr, true), fi.Mode())
+						return
+					}
+					if ex, _ := afero.Exists(f, name); !ex {
+						fail(ht, "TempFile %q does not exist afterwards on %s", name, f.Name())
+						return
+					}
+					td, err := afero.TempDir(f, d, prefix)
+					if err != nil {
+						fail(ht, "TempDir(%s, %s) on %s: %v", d, prefix, f.Name(), err)
+						return
+					}
+					tfi, serr := f.Stat(td)
+					if serr != nil || !tfi.IsDir() || tfi.Mode().Perm() != 0o700 || canon(path.Dir(td)) != canon(d) || !strings.HasPrefix(path.Base(td), prefix) {
+						fail(ht, "TempDir(%s, %s) on %s = %q: %s", d, prefix, f.Name(), td, statSummary(tfi, serr, true))
+						return
+					}
+					if _, err := afero.TempDir(f, d, "a/b"); err == nil {
+						fail(ht, "TempDir with a separator in the prefix succeeded on %s", f.Name())
+						return
+					}
+					f.Remove(name)
+					f.Remove(td)
+				}
+			case 8: // WriteReader / SafeWriteReader / WriteFile
+				data := genData(tc)
+				exists, _ := afero.Exists(osfs, q)
+				isDir, _ := afero.IsDir(osfs, q)
+				var merr, oerr error
+				parentIsDir, _ := afero.IsDir(osfs, path.Dir(canon(q)))
+				if Known.CreateCreatesParents && !parentIsDir {
+					count(ht, "skip: write below a missing directory (afero/2)")
+					continue
+				}
+				if Known.CreateOverDir && isDir {
+					count(ht, "skip: write over a directory (afero/6)")
+					continue
+				}
+				if Known.CreateReplacesFile && exists && permOf(osfs, q) != 0o666 {
+					count(ht, "skip: write over a file with another mode (afero/15)")
+					continue
+				}
+				switch n(tc, 0, 2) {
+				case 0:
+					merr = afero.WriteReader(mem, q, bytes.NewReader(data))
+					oerr = afero.WriteReader(osfs, q, bytes.NewReader(data))
+				case 1:
+					merr = afero.SafeWriteReader(mem, q, bytes.NewReader(data))
+					oerr = afero.SafeWriteReader(osfs, q, bytes.NewReader(data))
+					if (merr == nil) == exists {
+						fail(ht, "SafeWriteReader(%s) with exists=%v: %v", q, exists, merr)
+						return
+					}
+				default:
+					merr = afero.WriteFile(mem, q, data, 0o600)
+					oerr = afero.WriteFile(osfs, q, data, 0o600)
+				}
+				note(ht, "write %s (%d bytes): %v / %v", q, len(data), merr, oerr)
+				if !p.sameErr("write("+q+")", merr, oerr) {
+					return
+				}
+				if merr == nil {
+					content[q] = data
+					if !isDir && !exists {
+						files = append(files, q)
+					}
+				}
+				if !p.checkTrees() {
+					return
+				}
+			default: // UnicodeSanitize / NeuterAccents
+				s := genUnicodeName(tc)
+				san := afero.UnicodeSanitize(s)
+				for _, r := range san {
+					if !(unicode.IsLetter(r) || unicode.IsDigit(r) || unicode.IsMark(r) || strings.ContainsRune("./\\_-% #", r)) {
+						fail(ht, "UnicodeSanitize(%q) = %q keeps %q", s, san, r)
+						return
+					}
+				}
+				var keep []rune
+				for _, r := range s {
+					if unicode.IsLetter(r) || unicode.IsDigit(r) || unicode.IsMark(r) || strings.ContainsRune("./\\_-% #", r) {
+						keep = append(keep, r)
+					}
+				}
+				if san != string(keep) {
+					fail(ht, "UnicodeSanitize(%q) = %q, want %q", s, san, string(keep))
+					return
+				}
+				neu := afero.NeuterAccents(s)
+				var want []rune
+				for _, r := range norm.NFD.String(s) {
+					if !unicode.Is(unicode.Mn, r) {
+						want = append(want, r)
+					}
+				}
+				if neu != norm.NFC.String(string(want)) {
+					fail(ht, "NeuterAccents(%q) = %q, want %q", s, neu, norm.NFC.String(string(want)))
+					return
+				}
+			}
+		}
+	})
+}
+
+func mw(dirs, files []string) []string {
+	out := append([]string(nil), dirs...)
+	return append(out, files...)
+}
+
+// walkList lists what Walk visits below q as "path dir=bool"; with f == nil
+// it uses filepath.Walk on the OS path and strips the prefix.
+func walkList(f afero.Fs, q, prefix string) ([]string, error) {
+	var out []string
+	fn := func(pth string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		out = append(out, fmt.Sprintf("%s dir=%v", canon(strings.TrimPrefix(pth, prefix)), info.IsDir()))
+		return nil
+	}
+	if f == nil {
+		return out, filepath.Walk(q, fn)
+	}
+	return out, afero.Walk(f, q, fn)
+}
+
+func genPattern(tc hegel.TestCase, dirs, files []string) string {
+	base := anyPath(tc, dirs, files)
+	parts := strings.Split(strings.TrimPrefix(base, "/"), "/")
+	for i, part := range parts {
+		if part == "" {
+			continue
+		}
+		switch n(tc, 0, 6) {
+		case 0:
+			parts[i] = "*"
+		case 1:
+			parts[i] = part[:1] + "*"
+		case 2:
+			parts[i] = "?" + part[1:]
+		case 3:
+			parts[i] = "[" + part[:1] + "x]" + part[1:]
+		case 4:
+			parts[i] = `\` + part
+		}
+	}
+	return "/" + strings.Join(parts, "/")
+}
+
+func genUnicodeName(tc hegel.TestCase) string {
+	var b strings.Builder
+	for i, k := 0, n(tc, 0, 8); i < k; i++ {
+		b.WriteString(pick(tc, "a", "Z", "9", ".", "/", "\\", "_", "-", "%", " ", "#", "\u00e9", "e\u0301", "\u4e2d", "!", "*", ":", "\u0301", "\u0f04", "\ufb01"))
+	}
+	return b.String()
+}
