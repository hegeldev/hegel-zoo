+package hegel
+
+import "os"
+
+// noKnown is read once from HEGEL_NO_KNOWN. By default (false) the
+// properties draw the shapes of every recorded bug and fail on them, naming
+// the bug; with HEGEL_NO_KNOWN=1 a step whose shape is a recorded bug is a
+// no-op, a shape the generator can leave out is left out, and a recorded
+// outcome met at comparison time is accepted, so the properties pass. Each
+// pin in hegel_pins_test.go asserts the correct behaviour independently.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// knownShapes names the shape of every bug recorded in bugs.toml that a
+// property can reach; known(id) is the text a failure message carries.
+var knownShapes = map[string]string{
+	"afero/1":  "MemMapFs.Mkdir creates missing parents",
+	"afero/2":  "Create, OpenFile(O_CREATE) and Rename create missing parents",
+	"afero/3":  "Remove deletes a non-empty directory, children stay reachable",
+	"afero/4":  "MkdirAll on an existing regular file returns nil",
+	"afero/5":  "MkdirAll/Create below a regular file turn it into a directory",
+	"afero/6":  "Create over a directory replaces it, children stay reachable",
+	"afero/7":  "Rename of a directory over a file succeeds",
+	"afero/8":  "Rename of a directory into its own subtree detaches the tree",
+	"afero/9":  "Seek to a negative offset succeeds, the next Read/Write panics",
+	"afero/10": "Read/ReadAt past the end return io.ErrUnexpectedEOF",
+	"afero/11": "O_APPEND only seeks to the end at open",
+	"afero/12": "O_WRONLY handles read, O_RDONLY handles write",
+	"afero/13": "OpenFile(O_RDONLY) needs write permission",
+	"afero/14": "a directory handle acts as a file",
+	"afero/15": "Create of an existing file replaces it: mode reset to 0666, open handles detached",
+	"afero/19": "FileContainsBytes matches the zero padding of its buffer",
+	"afero/20": "UnionFile.Close returns BADFD after closing both files",
+	"afero/21": "CopyOnWriteFs.Remove/RemoveAll of a base-only entry do not return EPERM",
+	"afero/22": "CopyOnWriteFs.Mkdir over a layer directory or a base file succeeds",
+	"afero/23": "CacheOnReadFs.Remove of an uncached file removes it but reports not-exist",
+	"afero/24": "RegexpFs.Rename of a directory is a silent no-op",
+	"afero/25": "RegexpFs.OpenFile(O_CREATE) cannot create a new file",
