+
+// TestHegelEmptyWriteAtDoesNotGrowTheFile: WriteAt of an empty slice beyond
+// the end of a file, or Write of one after a Seek beyond it (afero/31).
+func TestHegelEmptyWriteAtDoesNotGrowTheFile(t *testing.T) {
+	memShape(t, "afero/31", func(ht *hegel.T, r *memRun) {
+		if !r.quiet(ht) {
+			return
+		}
+		f := r.fresh(ht)
+		data := hegel.Draw(ht, dataBytes)
+		r.write(f, data, 0o644)
+		off := int64(hegel.Draw(ht, hegel.Integers(len(data)+1, 14)))
+		var ops []handleOp
+		if hegel.Draw(ht, chance(50)) {
+			ops = []handleOp{{Op: "WriteAt", Data: []byte{}, Off: off}}
+		} else {
+			ops = []handleOp{{Op: "Seek", Off: off, Whence: io.SeekStart}, {Op: hegel.Draw(ht, hegel.SampledFrom([]string{"Write", "WriteString"})), Data: []byte{}}}
+		}
+		flags := hegel.Draw(ht, hegel.SampledFrom([]openFlags{{Acc: accessRW}, {Acc: accessW}}))
+		r.run(openStep(ht, f, flags, ops))
+	})
+}
+
+// renameCase is the case of afero/39 handed to the child process: the tree
+// to build on a MemMapFs and the Rename to attempt.
+type renameCase struct {
+	Dirs  []string
+	Files map[string][]byte
+	Src   string
+	Dst   string
+}
+
+const renameChildEnv = "HEGEL_AFERO_SHAPE_CASE"
+
+const renameChildTest = "TestHegelRenameBelowItselfToAMissingParentFails"
+
+// renameVerdicts caches the class of the Rename's error per drawn case ("":
+// the child aborted).
+var renameVerdicts = map[string]string{}
+
+// renameInChild runs the Rename of c on a MemMapFs in a child process (the
+// test binary running only renameChildTest, memory-capped, with a deadline)
+// and returns the class of the error it reported, or "" if it aborted.
+func renameInChild(c renameCase) string {
+	key, err := json.Marshal(c)
+	if err != nil {
+		panic(err)
+	}
+	if v, ok := renameVerdicts[string(key)]; ok {
+		return v
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/bin/sh", "-c", `ulimit -v 2200000 && exec "$0" "$@"`, os.Args[0], "-test.run", "^"+renameChildTest+"$")
+	cmd.Env = append(os.Environ(), renameChildEnv+"="+string(key))
+	cmd.WaitDelay = 2 * time.Second
+	out, _ := cmd.CombinedOutput()
+	verdict := ""
+	const marker = "rename returned: "
+	if i := strings.Index(string(out), marker); i >= 0 {
+		rest := string(out[i+len(marker):])
+		if j := strings.IndexByte(rest, '\n'); j >= 0 {
+			rest = rest[:j]
+		}
+		verdict = rest
+	}
+	renameVerdicts[string(key)] = verdict
+	return verdict
+}
+
+// renameChild is the child's side: build the tree, attempt the Rename,
+// report the class of its error.
+func renameChild(key string) {
+	var c renameCase
+	if err := json.Unmarshal([]byte(key), &c); err != nil {
+		panic(err)
+	}
+	m := afero.NewMemMapFs()
+	for _, d := range c.Dirs {
+		if err := m.MkdirAll(d, 0o755); err != nil {
+			panic(err)
+		}
+	}
+	for p, data := range c.Files {
+		if err := afero.WriteFile(m, p, data, 0o644); err != nil {
+			panic(err)
+		}
+	}
+	err := m.Rename(c.Src, c.Dst)
+	os.Stdout.WriteString("rename returned: " + errClass(err) + "\n")
+}
+
+// TestHegelRenameBelowItselfToAMissingParentFails: Rename of a file to a
+// path below itself, or of a directory to a path below itself whose parent
+// is missing, against the OsFs; the MemMapFs call runs in a child process
+// because it aborts the process (afero/39).
+func TestHegelRenameBelowItselfToAMissingParentFails(t *testing.T) {
+	if key := os.Getenv(renameChildEnv); key != "" {
+		renameChild(key)
+		return
+	}
+	memShape(t, "afero/39", func(ht *hegel.T, r *memRun) {
+		if !r.quiet(ht) {
+			return
+		}
+		src := r.fresh(ht)
+		isFile := hegel.Draw(ht, chance(50))
+		if isFile {
+			r.write(src, hegel.Draw(ht, dataBytes), 0o644)
+		} else {
+			r.mkdir(src)
+			if hegel.Draw(ht, chance(30)) {
+				r.write(src+"/"+hegel.Draw(ht, shapeName), hegel.Draw(ht, dataBytes), 0o644)
+			}
+		}
+		dst := src + "/" + hegel.Draw(ht, shapeName)
+		if !isFile || hegel.Draw(ht, chance(30)) {
+			dst += "/" + hegel.Draw(ht, shapeName)
+		}
+		p := r.p
+		if !p.gate(known("afero/39")) {
+			return
+		}
+		note(ht, "Rename(%q, %q) on the MemMapFs in a child process", src, dst)
+		oerr := p.os.Rename(src, dst)
+		mc := renameInChild(renameCase{Dirs: r.dirs, Files: r.content, Src: src, Dst: dst})
+		if mc == "" {
+			p.fail("Rename(%s, %s): %s aborted the process, %s %v (%s)", src, dst, p.memName(), p.osName(), oerr, errClass(oerr))
+			return
+		}
+		if !p.same("Rename("+src+", "+dst+")", mc, errClass(oerr)) {
+			return
+		}
+		p.checkTrees()
+	})
+}
