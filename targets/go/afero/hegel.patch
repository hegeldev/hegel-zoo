+		}
+		// WalkDir agrees with Walk on the visited paths.
+		var wd []string
+		afero.WalkDir(mem, q, func(pth string, d fs.DirEntry, err error) error {
+			if err == nil {
+				wd = append(wd, fmt.Sprintf("%s dir=%v", canon(pth), d.IsDir()))
+			}
+			return nil
