+// ---------------------------------------------------------------------------
+// RegexpFs regions: a regexpRun whose source and reference hold a drawn tree
+// plus the construct; the construct names match or miss the drawn regexp.
+
+// regexpNames are the construct names of the RegexpFs regions: for each of
+// the regexps some match and (but for the third) some do not.
+var regexpNames = []string{"s", "t", "s.txt", "as", "cs", "u y"}
+
+// namesWhere draws a construct name the regexp matches (or does not).
+func namesWhere(re *regexpRun, match bool) hegel.Generator[string] {
+	var pool []string
+	for _, n := range regexpNames {
+		if re.re.MatchString(n) == match {
+			pool = append(pool, n)
+		}
+	}
+	return hegel.SampledFrom(pool)
+}
+
+type regexpShape struct {
+	*regexpRun
+	dirs  []string
+	files []string
+	spot  string
+}
+
+// newRegexpShape draws the regexp among the given indices of regexps.
+func newRegexpShape(ht *hegel.T, res []int) *regexpShape {
+	r := newRegexpRun(ht, regexps[hegel.Draw(ht, hegel.SampledFrom(res))])
+	dirs, files, _ := hegel.Draw(ht, treeSpecs).build(r.src, r.ref)
+	return &regexpShape{regexpRun: r, dirs: dirs, files: files, spot: at(dirs, hegel.Draw(ht, positions))}
+}
+
+func regexpShapeProperty(t *testing.T, id string, res []int, fn func(ht *hegel.T, c *regexpShape)) {
