+package hegel
+
+// knownBugs lists the bugs recorded in bugs.toml that the properties gate on:
+// a property that would otherwise reach a recorded bug skips the offending
+// step (or accepts the recorded outcome) while the switch is true. Each pin in
+// hegel_pins_test.go asserts the correct behaviour, so the switches can be
+// turned off one by one as upstream fixes land.
+type knownBugs struct {
+	MkdirCreatesParents     bool // afero/1: MemMapFs.Mkdir creates missing parents
+	CreateCreatesParents    bool // afero/2: Create, OpenFile(O_CREATE) and Rename create missing parents
+	RemoveNonEmptyDir       bool // afero/3: Remove deletes a non-empty directory, children stay reachable
+	MkdirAllOverFile        bool // afero/4: MkdirAll on an existing regular file returns nil
+	FileBecomesDir          bool // afero/5: MkdirAll/Create below a regular file turn it into a directory
+	CreateOverDir           bool // afero/6: Create over a directory replaces it, children stay reachable
+	RenameOverwrites        bool // afero/7: Rename of a directory over a file succeeds (and over a non-empty directory)
+	RenameIntoItself        bool // afero/8: Rename of a directory into its own subtree detaches the tree
+	NegativeSeek            bool // afero/9: Seek to a negative offset succeeds, the next Read/Write panics
+	UnexpectedEOF           bool // afero/10: Read/ReadAt past the end return io.ErrUnexpectedEOF
+	AppendSeeksOnce         bool // afero/11: O_APPEND only seeks to the end at open
+	AccessModeIgnored       bool // afero/12: O_WRONLY handles read, O_RDONLY|O_CREATE handles write
+	ReadOnlyOpenNeedsWrite  bool // afero/13: OpenFile(O_RDONLY) needs write permission
+	DirectoryHandleIsAFile  bool // afero/14: a directory handle acts as a file: Read gives empty content, OpenFile with O_CREATE or write flags succeeds and Write works
+	CreateReplacesFile      bool // afero/15: Create of an existing file replaces it: mode reset to 0666, open handles detached
+	RemoveAllEmptyPath      bool // afero/16: RemoveAll("") deletes everything including the root
+	EmptyNameEntry          bool // afero/17: Mkdir("")/Create("") add an entry with an empty name to the root
+	SeekBadWhence           bool // afero/18: Seek with an invalid whence returns nil
+	ContainsBytesPadding    bool // afero/19: FileContainsBytes matches the zero padding of its buffer
+	UnionCloseBadFD         bool // afero/20: UnionFile.Close returns BADFD (EBADFD) after closing both files, so WriteFile through a union fails after writing
+	CowRemoveBaseOnly       bool // afero/21: CopyOnWriteFs.Remove/RemoveAll of a base-only file do not return EPERM
+	CowMkdirExisting        bool // afero/22: CopyOnWriteFs.Mkdir over a layer directory or a base file succeeds
+	CacheRemoveMiss         bool // afero/23: CacheOnReadFs.Remove of an uncached file removes it but reports not-exist
+	RegexpRenameDir         bool // afero/24: RegexpFs.Rename of a directory is a silent no-op
+	RegexpOpenFileCreate    bool // afero/25: RegexpFs.OpenFile(O_CREATE) cannot create a new file
+	RegexpReaddirEmptyPage  bool // afero/26: RegexpFile.Readdir(n) returns an empty page with a nil error
+	WalkReturnsSkip         bool // afero/27: Walk returns filepath.SkipDir/SkipAll to its caller
+	GlobBackslash           bool // afero/28: Glob does not count a backslash escape as a meta character and takes such an element literally
+	RenameSelfMissing       bool // afero/29: Rename(x, x) of a missing file returns nil
+	CreateIgnoresPermission bool // afero/30: Create of an existing file without write permission succeeds
+	EmptyWriteAtGrows       bool // afero/31: WriteAt of an empty slice past the end grows the file with zeros
+	CopyToLayerOfDir        bool // afero/32: copyToLayer cannot copy a directory: cow Chmod/Chtimes/Chown and cache Chmod/Chtimes/Chown/Rename of a base-only directory fail
+	CowCopyLosesMode        bool // afero/33: the copy of a base file made in the layer gets mode 0666 instead of the base file's mode
+	CowParentModeChanges    bool // afero/34: CopyOnWriteFs/CacheOnReadFs recreate a base directory in the layer with the new entry's mode (or 0777) and report that mode
+	RegexpRemoveAllMissing  bool // afero/35: RegexpFs.RemoveAll of a missing path returns an error instead of nil
+	CacheWriteOnlyUncached  bool // afero/36: CacheOnReadFs.OpenFile(O_WRONLY...) of a file not in the layer copies through the write-only handle and fails, after O_TRUNC/O_CREATE changed the base
+	CowRenameIntoBaseDir    bool // afero/37: CopyOnWriteFs.Rename of a layer entry into a directory that exists only in the base fails
+	CacheCreateInBaseDir    bool // afero/38: CacheOnReadFs.Create and Rename into a directory not yet in the layer fail after changing the base
+}
+
+var Known = knownBugs{
+	MkdirCreatesParents:     true,
+	CreateCreatesParents:    true,
+	RemoveNonEmptyDir:       true,
+	MkdirAllOverFile:        true,
+	FileBecomesDir:          true,
+	CreateOverDir:           true,
+	RenameOverwrites:        true,
+	RenameIntoItself:        true,
+	NegativeSeek:            true,
+	UnexpectedEOF:           true,
+	AppendSeeksOnce:         true,
+	AccessModeIgnored:       true,
+	ReadOnlyOpenNeedsWrite:  true,
+	DirectoryHandleIsAFile:  true,
+	CreateReplacesFile:      true,
+	RemoveAllEmptyPath:      true,
+	EmptyNameEntry:          true,
+	SeekBadWhence:           true,
+	ContainsBytesPadding:    true,
+	UnionCloseBadFD:         true,
+	CowRemoveBaseOnly:       true,
+	CowMkdirExisting:        true,
+	CacheRemoveMiss:         true,
+	RegexpRenameDir:         true,
+	RegexpOpenFileCreate:    true,
+	RegexpReaddirEmptyPage:  true,
+	WalkReturnsSkip:         true,
+	GlobBackslash:           true,
+	RenameSelfMissing:       true,
+	CreateIgnoresPermission: true,
+	EmptyWriteAtGrows:       true,
+	CopyToLayerOfDir:        true,
+	CowCopyLosesMode:        true,
+	CowParentModeChanges:    true,
+	RegexpRemoveAllMissing:  true,
+	CacheWriteOnlyUncached:  true,
+	CowRenameIntoBaseDir:    true,
+	CacheCreateInBaseDir:    true,
+}
