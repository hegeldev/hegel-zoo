diff --git a/hegel/hegel_zoo_default_test.go b/hegel/hegel_zoo_default_test.go
new file mode 100644
index 0000000..f4650ee
--- /dev/null
+++ b/hegel/hegel_zoo_default_test.go
@@ -0,0 +1,265 @@
+package hegel
+
+// TestHegelDefaultList: names built from the rules of the packaged list (DefaultRules) parsed
+// with Parse, Domain, DefaultList.Find, the net/publicsuffix adapter and CookieJarList, against
+// the model over the same rules.
+//
+// TestHegelCookieJar: a net/http/cookiejar with CookieJarList and one with the model's public
+// suffix list receive the same cookies (Domain attributes on and around public suffixes) and
+// must return the same cookies for the same URLs.
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/cookiejar"
+	"net/url"
+	"sort"
+	"strings"
+	"testing"
+
+	wnet "github.com/weppos/publicsuffix-go/net/publicsuffix"
+	"github.com/weppos/publicsuffix-go/publicsuffix"
+	"hegel.dev/go/hegel"
+)
+
+// hzDefaultCase is a name around a rule of the packaged list: the rule's value (none for a free
+// name) and the recipe rendered over it.
+type hzDefaultCase struct {
+	values []string
+	name   hzName
+}
+
+func hzOneValue(r publicsuffix.Rule) []string { return []string{r.Value} }
+
+var (
+	// hzDefaultValues: no rule value (a free name), a rule of the packaged list, or one of the
+	// few wildcard and exception rules, picked often.
+	hzDefaultValues = weighted(
+		choice[[]string]{15, hegel.Just[[]string](nil)},
+		choice[[]string]{68, hegel.Map(hegel.SampledFrom(hzDefaultRulesOf()), hzOneValue)},
+		choice[[]string]{17, hegel.Map(hegel.SampledFrom(hzSpecialRules), hzOneValue)},
+	)
+	hzDefaultCases = hegel.Composite(func(tc hegel.TestCase) hzDefaultCase {
+		return hzDefaultCase{values: hegel.Draw(tc, hzDefaultValues), name: hegel.Draw(tc, hzNames)}
+	})
+)
+
+func hzDefaultRulesOf() []publicsuffix.Rule {
+	_, rules := hzDefault()
+	return rules
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c hzDefaultCase) GoString() string {
+	return fmt.Sprintf("name %q around %q", c.name.render(c.values), c.values)
+}
+
+func TestHegelDefaultList(t *testing.T) {
+	c := hzNewCollector(t)
+	model, _ := hzDefault()
+	hzProperty(t, func(tc *hegel.T) {
+		dc := hegel.Draw(tc, hzDefaultCases)
+		name := dc.name.render(dc.values)
+
+		// Parse and Domain.
+		dn, err := publicsuffix.Parse(name)
+		wantDN, wantClass := model.parse(name, false, hzDefaultRule)
+		if hzErrClass(err) != wantClass {
+			c.failClass(tc, "parse error", "Parse(%q): %v (%s), want %s", name, err, hzErrClass(err), wantClass)
+			return
+		}
+		if err == nil {
+			c.count("parse ok")
+			if hzFmtDN(dn) != wantDN.String() {
+				c.failClass(tc, "parse", "Parse(%q) = %s, want %s", name, hzFmtDN(dn), wantDN)
+				return
+			}
+			d, err := publicsuffix.Domain(name)
+			if err != nil || d != wantDN.SLD+"."+wantDN.TLD {
+				c.failClass(tc, "domain", "Domain(%q) = %q, %v, want %q", name, d, err, wantDN.SLD+"."+wantDN.TLD)
+				return
+			}
+		} else {
+			c.count("parse " + wantClass)
+		}
+
+		// Find on the raw name, and the cookiejar list.
+		got := publicsuffix.DefaultList.Find(name, nil)
+		wantRule := model.find(name, false, hzDefaultRule)
+		if hzFmtRule(got) != wantRule.String() {
+			c.failClass(tc, "find", "DefaultList.Find(%q) = %s, want %s", name, hzFmtRule(got), wantRule)
+			return
+		}
+		wantPS, _ := model.publicSuffix(name)
+		if ps := publicsuffix.CookieJarList.PublicSuffix(name); ps != wantPS {
+			c.failClass(tc, "cookiejar", "CookieJarList.PublicSuffix(%q) = %q, want %q", name, ps, wantPS)
+			return
+		}
+
+		// The x/net-compatible adapter.
+		ps, icann := wnet.PublicSuffix(name)
+		wantICANN := !wantRule.Private && !wantRule.def
+		if ps != wantPS || icann != wantICANN {
+			c.failClass(tc, "adapter", "net/publicsuffix.PublicSuffix(%q) = %q, %v, want %q, %v", name, ps, icann, wantPS, wantICANN)
+			return
+		}
+		e1, err := wnet.EffectiveTLDPlusOne(name)
+		if (err == nil) != (wantClass == "ok") || (err == nil && e1 != wantDN.SLD+"."+wantDN.TLD) {
+			c.failClass(tc, "etld1", "net/publicsuffix.EffectiveTLDPlusOne(%q) = %q, %v, want %s", name, e1, err, wantDN)
+			return
+		}
+	})
+}
+
+// hzModelPSL is the model as a cookiejar.PublicSuffixList over the packaged list.
+type hzModelPSL struct{}
+
+func (hzModelPSL) PublicSuffix(domain string) string {
+	model, _ := hzDefault()
+	ps, _ := model.publicSuffix(domain)
+	return ps
+}
+
+func (hzModelPSL) String() string { return "model" }
+
+func hzCookieStrings(cs []*http.Cookie) string {
+	var out []string
+	for _, ck := range cs {
+		out = append(out, ck.Name+"="+ck.Value)
+	}
+	sort.Strings(out)
+	return strings.Join(out, "; ")
+}
+
+// hzCookie is a cookie's Domain attribute: the host's labels from the at-th on (modulo the
+// count plus one; the count itself means no Domain), with a leading dot or not.
+type hzCookie struct {
+	at     int
+	dotted bool
+}
+
+// hzJarCase is a host under a public suffix of the packaged list (a label under a wildcard
+// rule's value, one to three labels above the suffix) and the cookies set on it.
+type hzJarCase struct {
+	rule    publicsuffix.Rule
+	under   string
+	above   []string
+	cookies []hzCookie
+}
+
+// hzJarRules and hzJarSpecial are the rules of the packaged list whose value makes a host
+// name (every value is in A-labels and has no empty label, so these are all of them).
+var hzJarRules, hzJarSpecial = func() (all, special []publicsuffix.Rule) {
+	_, rules := hzDefault()
+	for _, r := range rules {
+		if !hzIsASCII(r.Value) || strings.Contains(r.Value, "..") {
+			continue
+		}
+		all = append(all, r)
+		if r.Type != publicsuffix.NormalType {
+			special = append(special, r)
+		}
+	}
+	return all, special
+}()
+
+var (
+	// hzJarRule: a rule of the packaged list, the wildcard and exception rules picked often.
+	hzJarRule = weighted(
+		choice[publicsuffix.Rule]{70, hegel.SampledFrom(hzJarRules)},
+		choice[publicsuffix.Rule]{30, hegel.SampledFrom(hzJarSpecial)},
+	)
+	hzCookies = hegel.Composite(func(tc hegel.TestCase) hzCookie {
+		return hzCookie{at: hegel.Draw(tc, hzIndex), dotted: hegel.Draw(tc, chance(20))}
+	})
+	hzJarCases = hegel.Composite(func(tc hegel.TestCase) hzJarCase {
+		return hzJarCase{
+			rule:    hegel.Draw(tc, hzJarRule),
+			under:   hegel.Draw(tc, hzHostLabel),
+			above:   hegel.Draw(tc, many(hzHostLabel, 1, 3)),
+			cookies: hegel.Draw(tc, many(hzCookies, 1, 3)),
+		}
+	})
+)
+
+// hostLabels is the host: the labels above, the label under a wildcard, the rule's value.
+func (j hzJarCase) hostLabels() []string {
+	suffix := j.rule.Value
+	if j.rule.Type == publicsuffix.WildcardType {
+		suffix = j.under + "." + suffix
+	}
+	return append(append([]string{}, j.above...), strings.Split(suffix, ".")...)
+}
+
+// cookieList is the cookies as set: the Domain attribute a suffix of the host at a label
+// boundary, or none.
+func (j hzJarCase) cookieList(labels []string) []*http.Cookie {
+	var cookies []*http.Cookie
+	for k, ck := range j.cookies {
+		i := ck.at % (len(labels) + 1)
+		domain := strings.Join(labels[i:], ".")
+		if ck.dotted {
+			domain = "." + domain
+		}
+		if i == len(labels) {
+			domain = ""
+		}
+		cookies = append(cookies, &http.Cookie{Name: "c" + string(rune('1'+k)), Value: strings.ReplaceAll(domain, ".", "_"), Domain: domain})
+	}
+	return cookies
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (j hzJarCase) GoString() string {
+	labels := j.hostLabels()
+	return fmt.Sprintf("host %q under %s, cookie domains %v", strings.Join(labels, "."), hzFmtRule(&j.rule), hzCookieDomains(j.cookieList(labels)))
+}
+
+// hzCheckJar sets the case's cookies on a jar with CookieJarList and one with the model, and
+// reads both back from the host, a child, and every parent of the host.
+func hzCheckJar(ht *hegel.T, c *hzCollector, j hzJarCase) {
+	labels := j.hostLabels()
+	host := strings.Join(labels, ".")
+	jars := [2]*cookiejar.Jar{}
+	for i, psl := range []cookiejar.PublicSuffixList{publicsuffix.CookieJarList, hzModelPSL{}} {
+		jars[i], _ = cookiejar.New(&cookiejar.Options{PublicSuffixList: psl})
+	}
+	u, _ := url.Parse("http://" + host + "/")
+	cookies := j.cookieList(labels)
+	for _, jar := range jars {
+		jar.SetCookies(u, cookies)
+	}
+	reads := []string{host, "sub." + host}
+	for i := 1; i < len(labels); i++ {
+		reads = append(reads, strings.Join(labels[i:], "."))
+	}
+	for _, h := range reads {
+		ru, _ := url.Parse("http://" + h + "/")
+		got := hzCookieStrings(jars[0].Cookies(ru))
+		want := hzCookieStrings(jars[1].Cookies(ru))
+		if got != want {
+			c.failClass(ht, "cookies", "cookies set on %s with domains %v, read from %s: CookieJarList gives %q, the model %q", host, hzCookieDomains(cookies), h, got, want)
+			return
+		}
+		if got != "" {
+			c.count("read some")
+		} else {
+			c.count("read none")
+		}
+	}
+}
+
+func TestHegelCookieJar(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(tc *hegel.T) {
+		hzCheckJar(tc, c, hegel.Draw(tc, hzJarCases))
+	})
+}
+
+func hzCookieDomains(cs []*http.Cookie) []string {
+	var out []string
+	for _, ck := range cs {
+		out = append(out, ck.Domain)
+	}
+	return out
+}
diff --git a/hegel/hegel_zoo_list_test.go b/hegel/hegel_zoo_list_test.go
new file mode 100644
index 0000000..6d5ee15
--- /dev/null
+++ b/hegel/hegel_zoo_list_test.go
@@ -0,0 +1,327 @@
+package hegel
+
+// TestHegelList: generated Public Suffix List text parsed with NewListFromString and looked up
+// with generated names (Find, ParseFromListWithOptions, DomainFromListWithOptions, Decompose),
+// against the model of the format and algorithm.
+//
+// The list is a Lists of line records rendered by a pure function; the names are recipes over
+// the list's rule values (an index taken modulo the live count, so the shrinker can delete
+// lines and the names stay coherent); the parser and find options are records.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/weppos/publicsuffix-go/publicsuffix"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the list
+
+// hzRuleLine is the content of a rule line: a marker and labels; reuse and under are indices
+// the renderer resolves modulo the live counts.
+type hzRuleLine struct {
+	marker string   // "" normal, "*." wildcard, "!" exception, "*" the bare star line
+	labels []string // 1-3 labels
+	reuse  int      // -1: own labels; else the value of an earlier rule (modulo their count) again, possibly under another marker
+	under  int      // exceptions: -1: own labels; else the first label under an earlier wildcard's value (modulo their count)
+}
+
+// hzLine is a line of the list: a rule with its whitespace and trailing text, a comment of
+// words, a blank line, or the private marker (as a comment, or bare).
+type hzLine struct {
+	kind  string // "rule", "comment", "blank", "marker"
+	rule  hzRuleLine
+	words []string
+	bare  bool
+	lead  string // whitespace before a rule
+	trail string // whitespace after it
+	junk  string // trailing text after whitespace (publicsuffix-go/3's shape)
+}
+
+var (
+	// hzMarkers: normal first; a bare "*" line one time in thirty-three.
+	hzMarkers = weighted(
+		choice[string]{65, hegel.Just("")},
+		choice[string]{19, hegel.Just("*.")},
+		choice[string]{13, hegel.Just("!")},
+		choice[string]{3, hegel.Just("*")},
+	)
+	hzRuleLines = hegel.Composite(func(tc hegel.TestCase) hzRuleLine {
+		r := hzRuleLine{
+			marker: hegel.Draw(tc, hzMarkers),
+			labels: hegel.Draw(tc, hzLabelList(1, 3)),
+			reuse:  hegel.Draw(tc, maybeIndex(8)),
+			under:  -1,
+		}
+		if r.marker == "!" {
+			r.under = hegel.Draw(tc, maybeIndex(80))
+		}
+		return r
+	})
+	hzLeads  = maybe(8, hegel.SampledFrom([]string{" ", "\t", "  "}))
+	hzTrails = maybe(8, hegel.SampledFrom([]string{" ", "\t"}))
+	hzJunks  = maybe(5, hegel.SampledFrom([]string{" // comment", "\tjunk", " b"}))
+
+	hzRuleKind = hegel.Composite(func(tc hegel.TestCase) hzLine {
+		return hzLine{
+			kind:  "rule",
+			rule:  hegel.Draw(tc, hzRuleLines),
+			lead:  hegel.Draw(tc, hzLeads),
+			trail: hegel.Draw(tc, hzTrails),
+			junk:  hegel.Draw(tc, hzJunks),
+		}
+	})
+	hzCommentKind = hegel.Map(hzLabelList(0, 2), func(ws []string) hzLine { return hzLine{kind: "comment", words: ws} })
+	hzBlankKind   = hegel.Just(hzLine{kind: "blank"})
+	hzMarkerKind  = hegel.Map(chance(30), func(bare bool) hzLine { return hzLine{kind: "marker", bare: bare} })
+	// hzLines: a rule line four times in five; comments, blank lines and the private marker
+	// for the rest.
+	hzLines = weighted(
+		choice[hzLine]{80, hzRuleKind},
+		choice[hzLine]{10, hzCommentKind},
+		choice[hzLine]{5, hzBlankKind},
+		choice[hzLine]{5, hzMarkerKind},
+	)
+)
+
+// maybeIndex is -1 (none) or, pct percent of the time, an index to take modulo a live count.
+func maybeIndex(pct int) hegel.Generator[int] {
+	return weighted(choice[int]{100 - pct, hegel.Just(-1)}, choice[int]{pct, hzIndex})
+}
+
+// hzParserOpt is the ParserOption: absent (the defaults), or with the private domains skipped
+// and the list taken as A-labels.
+type hzParserOpt struct {
+	absent      bool
+	skipPrivate bool
+	ascii       bool
+}
+
+var hzParserOpts = hegel.Composite(func(tc hegel.TestCase) hzParserOpt {
+	return hzParserOpt{
+		absent:      hegel.Draw(tc, chance(15)),
+		skipPrivate: hegel.Draw(tc, chance(20)),
+		ascii:       hegel.Draw(tc, chance(20)),
+	}
+})
+
+func (o hzParserOpt) options() *publicsuffix.ParserOption {
+	if o.absent {
+		return nil
+	}
+	return &publicsuffix.ParserOption{PrivateDomains: !o.skipPrivate, ASCIIEncoded: o.ascii}
+}
+
+func (o hzParserOpt) String() string {
+	if o.absent {
+		return "nil options"
+	}
+	return fmt.Sprintf("{PrivateDomains:%v ASCIIEncoded:%v}", !o.skipPrivate, o.ascii)
+}
+
+// hzListSpec is a list: its lines, the line break and whether the last line has one, and the
+// parser options.
+type hzListSpec struct {
+	lines        []hzLine
+	crlf         bool
+	noFinalBreak bool
+	opt          hzParserOpt
+}
+
+var hzLists = hegel.Composite(func(tc hegel.TestCase) hzListSpec {
+	return hzListSpec{
+		lines:        hegel.Draw(tc, many(hzLines, 1, 8)),
+		crlf:         hegel.Draw(tc, chance(20)),
+		noFinalBreak: hegel.Draw(tc, chance(20)),
+		opt:          hegel.Draw(tc, hzParserOpts),
+	}
+})
+
+// render is the list text and the rule values as written (U-labels; "" for a bare "*" line),
+// in order, for the names.
+func (l hzListSpec) render() (text string, values []string) {
+	var lines, wildcards []string
+	for _, ln := range l.lines {
+		switch ln.kind {
+		case "comment":
+			lines = append(lines, "// "+strings.Join(ln.words, " "))
+		case "blank":
+			lines = append(lines, "")
+		case "marker":
+			if ln.bare {
+				lines = append(lines, hzPrivateMarker)
+			} else {
+				lines = append(lines, "// "+hzPrivateMarker)
+			}
+		case "rule":
+			r := ln.rule
+			value := strings.Join(r.labels, ".")
+			if r.reuse >= 0 && len(values) > 0 {
+				value = values[r.reuse%len(values)] // the same value again, possibly with another type
+			}
+			content := value
+			switch r.marker {
+			case "*":
+				content, value = "*", ""
+			case "*.":
+				content = "*." + value
+				wildcards = append(wildcards, value)
+			case "!":
+				if r.under >= 0 && len(wildcards) > 0 {
+					value = r.labels[0] + "." + wildcards[r.under%len(wildcards)]
+				}
+				content = "!" + value
+			}
+			values = append(values, value)
+			lines = append(lines, ln.lead+content+ln.trail+ln.junk)
+		}
+	}
+	sep := "\n"
+	if l.crlf {
+		sep = "\r\n"
+	}
+	text = strings.Join(lines, sep)
+	if !l.noFinalBreak {
+		text += sep
+	}
+	return text, values
+}
+
+// --------------------------------------------------------------------------- the case
+
+// hzLookup is one name looked up with its find options.
+type hzLookup struct {
+	name hzName
+	find hzFind
+}
+
+var hzLookups = hegel.Composite(func(tc hegel.TestCase) hzLookup {
+	return hzLookup{name: hegel.Draw(tc, hzNames), find: hegel.Draw(tc, hzFinds)}
+})
+
+// hzListCase is a list and one to four lookups on it.
+type hzListCase struct {
+	list    hzListSpec
+	lookups []hzLookup
+}
+
+var hzListCases = hegel.Composite(func(tc hegel.TestCase) hzListCase {
+	return hzListCase{list: hegel.Draw(tc, hzLists), lookups: hegel.Draw(tc, many(hzLookups, 1, 4))}
+})
+
+// suffixes is the values the names are built around: the rule values as written, the bare
+// "*" lines' empty value left out.
+func (c hzListCase) suffixes(values []string) []string {
+	var out []string
+	for _, v := range values {
+		if v != "" {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// GoString is what the draw report prints (it uses %#v): the rendered list and names.
+func (c hzListCase) GoString() string {
+	text, values := c.list.render()
+	var b strings.Builder
+	fmt.Fprintf(&b, "list %q %s", text, c.list.opt)
+	for _, l := range c.lookups {
+		fmt.Fprintf(&b, "\n  lookup %q with %s", l.name.render(c.suffixes(values)), l.find)
+	}
+	return b.String()
+}
+
+// hzCheckList loads the case's list and looks its names up, against the model.
+func hzCheckList(ht *hegel.T, c *hzCollector, lc hzListCase) {
+	text, values := lc.list.render()
+	opt := lc.list.opt.options()
+	want, wantN, wantErr := hzModelLoad(text, opt)
+	list := publicsuffix.NewList()
+	rules, err := list.LoadString(text, opt)
+	if (err != nil) != (wantErr != nil) {
+		c.failClass(ht, "load error", "LoadString(%q, %s): err %v, want %v", text, lc.list.opt, err, wantErr)
+		return
+	}
+	if err != nil {
+		c.count("load error")
+		return
+	}
+	if len(rules) != wantN {
+		c.failClass(ht, "rules returned", "LoadString(%q, %s) returned %d rules, want %d", text, lc.list.opt, len(rules), wantN)
+		return
+	}
+	if list.Size() != want.size {
+		c.failClass(ht, "size", "Size of list %q (%s) = %d, want %d", text, lc.list.opt, list.Size(), want.size)
+		return
+	}
+	c.count("rules " + hzBucket(wantN))
+	suffixes := lc.suffixes(values)
+	for _, l := range lc.lookups {
+		name := l.name.render(suffixes)
+		fo, ignorePrivate, def := l.find.options()
+
+		// Find on the raw name.
+		got := list.Find(name, fo)
+		wantRule := want.find(name, ignorePrivate, def)
+		if hzFmtRule(got) != wantRule.String() {
+			c.failClass(ht, "find", "Find(%q, %s) on list %q (%s) = %s, want %s", name, l.find, text, lc.list.opt, hzFmtRule(got), wantRule)
+			return
+		}
+		if got != nil {
+			parts := got.Decompose(name)
+			left, tld, _ := wantRule.decompose(name)
+			if parts[0] != left || parts[1] != tld {
+				c.failClass(ht, "decompose", "Decompose(%q) by %s = %q, want [%q %q] (list %q)", name, hzFmtRule(got), parts, left, tld, text)
+				return
+			}
+		}
+
+		// Parse and Domain.
+		dn, err := publicsuffix.ParseFromListWithOptions(list, name, fo)
+		wantDN, wantClass := want.parse(name, ignorePrivate, def)
+		if hzErrClass(err) != wantClass {
+			c.failClass(ht, "parse error", "Parse(%q, %s) on list %q (%s): %v (%s), want %s", name, l.find, text, lc.list.opt, err, hzErrClass(err), wantClass)
+			return
+		}
+		if err != nil {
+			c.count("parse " + wantClass)
+			continue
+		}
+		c.count("parse ok")
+		if hzFmtDN(dn) != wantDN.String() {
+			c.failClass(ht, "parse", "Parse(%q, %s) on list %q (%s) = %s, want %s", name, l.find, text, lc.list.opt, hzFmtDN(dn), wantDN)
+			return
+		}
+		if s := dn.String(); s != hzModelDNString(wantDN) {
+			c.failClass(ht, "string", "Parse(%q).String() = %q, want %q", name, s, hzModelDNString(wantDN))
+			return
+		}
+		d, err := publicsuffix.DomainFromListWithOptions(list, name, fo)
+		if err != nil || d != wantDN.SLD+"."+wantDN.TLD {
+			c.failClass(ht, "domain", "Domain(%q, %s) on list %q = %q, %v, want %q", name, l.find, text, d, err, wantDN.SLD+"."+wantDN.TLD)
+			return
+		}
+	}
+}
+
+func TestHegelList(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckList(ht, c, hegel.Draw(ht, hzListCases))
+	})
+}
+
+func hzBucket(n int) string {
+	switch {
+	case n == 0:
+		return "0"
+	case n <= 2:
+		return "1-2"
+	case n <= 5:
+		return "3-5"
+	}
+	return "6+"
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..97219cd
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,135 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the documented behaviour. They fail
+// while the bug exists and are listed as expected failures in target.toml.
+
+import (
+	"net/http"
+	"net/http/cookiejar"
+	"net/url"
+	"testing"
+
+	wnet "github.com/weppos/publicsuffix-go/net/publicsuffix"
+	"github.com/weppos/publicsuffix-go/publicsuffix"
+)
+
+// publicsuffix-go/1: CookieJarList.PublicSuffix returns "" for a name that is a public suffix,
+// so a cookie jar accepts a cookie with Domain=co.uk from foo.co.uk.
+func TestHegelPinCookieJarPublicSuffix(t *testing.T) {
+	if ps := publicsuffix.CookieJarList.PublicSuffix("co.uk"); ps != "co.uk" {
+		t.Errorf("CookieJarList.PublicSuffix(co.uk) = %q, want co.uk", ps)
+	}
+	jar, _ := cookiejar.New(&cookiejar.Options{PublicSuffixList: publicsuffix.CookieJarList})
+	u, _ := url.Parse("http://foo.co.uk/")
+	jar.SetCookies(u, []*http.Cookie{{Name: "a", Value: "1", Domain: "co.uk"}})
+	if cs := jar.Cookies(u); len(cs) != 0 {
+		t.Errorf("a cookie with Domain=co.uk set from foo.co.uk was accepted: %v", cs)
+	}
+}
+
+// publicsuffix-go/2: net/publicsuffix.PublicSuffix returns "" for a name that is itself a
+// public suffix, where golang.org/x/net/publicsuffix returns the name.
+func TestHegelPinAdapterPublicSuffix(t *testing.T) {
+	if ps, icann := wnet.PublicSuffix("com"); ps != "com" || !icann {
+		t.Errorf("PublicSuffix(com) = %q, %v, want com, true", ps, icann)
+	}
+	if ps, icann := wnet.PublicSuffix("example"); ps != "example" || icann {
+		t.Errorf("PublicSuffix(example) = %q, %v, want example, false", ps, icann)
+	}
+}
+
+// publicsuffix-go/3: a rule line is read whole instead of up to its first whitespace.
+func TestHegelPinRuleLineWhitespace(t *testing.T) {
+	l, err := publicsuffix.NewListFromString("com // the rule is com\n", nil)
+	if err != nil {
+		t.Fatalf("NewListFromString: %v", err)
+	}
+	r := l.Find("example.com", nil)
+	if r == nil || r.Value != "com" {
+		t.Errorf("Find(example.com) = %s, want the rule com", hzFmtRule(r))
+	}
+}
+
+// publicsuffix-go/4: rules with the same value overwrite each other, so "foo" after "*.foo"
+// removes the wildcard.
+func TestHegelPinSameValueRules(t *testing.T) {
+	l, err := publicsuffix.NewListFromString("*.foo\nfoo\n", nil)
+	if err != nil {
+		t.Fatalf("NewListFromString: %v", err)
+	}
+	if l.Size() != 2 {
+		t.Errorf("Size = %d, want 2", l.Size())
+	}
+	if d, err := publicsuffix.DomainFromListWithOptions(l, "a.foo", nil); err == nil {
+		t.Errorf("Domain(a.foo) = %q, want an error: a.foo is a public suffix under *.foo", d)
+	}
+}
+
+// publicsuffix-go/5: a matching normal rule with more labels prevails over an exception rule.
+func TestHegelPinExceptionPrevails(t *testing.T) {
+	l, err := publicsuffix.NewListFromString("*.ck\n!www.ck\nx.www.ck\n", nil)
+	if err != nil {
+		t.Fatalf("NewListFromString: %v", err)
+	}
+	d, err := publicsuffix.DomainFromListWithOptions(l, "y.x.www.ck", nil)
+	if err != nil || d != "www.ck" {
+		t.Errorf("Domain(y.x.www.ck) = %q, %v, want www.ck (the exception rule prevails)", d, err)
+	}
+}
+
+// publicsuffix-go/6: a DefaultRule other than publicsuffix.DefaultRule decomposes wrongly.
+func TestHegelPinCustomDefaultRule(t *testing.T) {
+	o := &publicsuffix.FindOptions{DefaultRule: publicsuffix.MustNewRule("*")}
+	dn, err := publicsuffix.ParseFromListWithOptions(publicsuffix.NewList(), "www.example.com", o)
+	if err != nil || dn.TLD != "com" || dn.SLD != "example" || dn.TRD != "www" {
+		t.Errorf("Parse(www.example.com) with an own * rule = %s, %v, want {com example www}", hzFmtDN(dn), err)
+	}
+	o = &publicsuffix.FindOptions{DefaultRule: publicsuffix.MustNewRule("zz")}
+	dn, err = publicsuffix.ParseFromListWithOptions(publicsuffix.NewList(), "www.example.com", o)
+	if err != nil || dn.TLD != "zz" || dn.SLD != "com" || dn.TRD != "www.example" {
+		t.Errorf("Parse(www.example.com) with the default rule zz = %s, %v, want {zz com www.example}", hzFmtDN(dn), err)
+	}
+}
+
+// publicsuffix-go/7: NewRule panics on empty content and reads "*x" as "*".
+func TestHegelPinNewRuleMalformed(t *testing.T) {
+	if r := hzCatch(func() {
+		if _, err := publicsuffix.NewRule(""); err == nil {
+			t.Errorf("NewRule(\"\") returned no error")
+		}
+	}); r != nil {
+		t.Errorf("NewRule(\"\") panicked: %v", r)
+	}
+	r, err := publicsuffix.NewRule("* b")
+	if err == nil && r.Type == publicsuffix.WildcardType && r.Value == "b" {
+		t.Errorf("NewRule(\"* b\") = %s: read as the wildcard *.b", hzFmtRule(r))
+	}
+}
+
+// publicsuffix-go/8: Rule.Length counts the empty value of "*" as a label.
+func TestHegelPinStarLength(t *testing.T) {
+	if n := publicsuffix.DefaultRule.Length; n != 1 {
+		t.Errorf("DefaultRule.Length = %d, want 1", n)
+	}
+}
+
+// publicsuffix-go/9: NewRuleUnicode reads an exception rule whose first label is Unicode as a
+// normal rule.
+func TestHegelPinUnicodeException(t *testing.T) {
+	r, err := publicsuffix.NewRuleUnicode("!日本.ck")
+	if err != nil {
+		t.Fatalf("NewRuleUnicode: %v", err)
+	}
+	if r.Type != publicsuffix.ExceptionType || r.Value != "xn--wgv71a.ck" {
+		t.Errorf("NewRuleUnicode(!<nihon>.ck) = %s, want {3 xn--wgv71a.ck}", hzFmtRule(r))
+	}
+}
+
+// publicsuffix-go/10: a name with an empty label is accepted and decomposed, where a leading
+// dot is rejected.
+func TestHegelPinEmptyLabel(t *testing.T) {
+	dn, err := publicsuffix.Parse("a..com")
+	if err == nil {
+		t.Errorf("Parse(a..com) = %s (String %q), want an error like for .com", hzFmtDN(dn), dn.String())
+	}
+}
diff --git a/hegel/hegel_zoo_shapes_test.go b/hegel/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..71c137d
--- /dev/null
+++ b/hegel/hegel_zoo_shapes_test.go
@@ -0,0 +1,476 @@
+package hegel
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the same model as the wide properties (the documented behaviour),
+// so that each bug has a property that finds it every run; the wide properties reach the
+// shapes at their natural rate. Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the
+// bug does not touch instead (a name one label above the suffix, a rule line without trailing
+// text, distinct values, an exception beside a shorter normal rule, the package's DefaultRule,
+// well-formed NewRule content, a normal rule's Length, an exception with an ASCII first label,
+// a name without empty labels) and passes.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	wnet "github.com/weppos/publicsuffix-go/net/publicsuffix"
+	"github.com/weppos/publicsuffix-go/publicsuffix"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- publicsuffix-go/1 and /2
+
+// publicSuffixAt is the index of the host's labels at which its public suffix starts: after
+// the labels above, and after the first label of an exception rule's value.
+func (j hzJarCase) publicSuffixAt() int {
+	if j.rule.Type == publicsuffix.ExceptionType {
+		return len(j.above) + 1
+	}
+	return len(j.above)
+}
+
+// hzSuffixCookieCases: a host one to three labels above a public suffix of the packaged list
+// and one cookie whose Domain is the suffix itself (publicsuffix-go/1's shape), or under
+// HEGEL_NO_KNOWN=1 the name one label above the suffix.
+var hzSuffixCookieCases = hegel.Composite(func(tc hegel.TestCase) hzJarCase {
+	j := hzJarCase{
+		rule:  hegel.Draw(tc, hzJarRule),
+		under: hegel.Draw(tc, hzHostLabel),
+		above: hegel.Draw(tc, many(hzHostLabel, 1, 3)),
+	}
+	j.cookies = []hzCookie{{at: shaped(j.publicSuffixAt(), j.publicSuffixAt()-1), dotted: hegel.Draw(tc, chance(20))}}
+	return j
+})
+
+// TestHegelCookieJarRejectsCookiesOnAPublicSuffix: a cookie whose Domain is a public suffix,
+// set from a host under it, is rejected by a jar on CookieJarList as it is by a jar on the
+// model's list (net/http/cookiejar asks the list for the public suffix of the Domain and
+// refuses a Domain that is one); CookieJarList.PublicSuffix returns "" for a name that is a
+// public suffix, so the jar accepts the cookie (publicsuffix-go/1). HEGEL_NO_KNOWN=1 sets the
+// Domain one label above the suffix.
+func TestHegelCookieJarRejectsCookiesOnAPublicSuffix(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckJar(ht, c, hegel.Draw(ht, hzSuffixCookieCases))
+	})
+}
+
+// hzSuffixNameCases: a name that is a public suffix of the packaged list (a normal rule's
+// value, a label under a wildcard rule's value, an exception rule's value without its first
+// label), or under HEGEL_NO_KNOWN=1 the name one label above it.
+var hzSuffixNameCases = hegel.Composite(func(tc hegel.TestCase) hzJarCase {
+	return hzJarCase{
+		rule:  hegel.Draw(tc, hzJarRule),
+		under: hegel.Draw(tc, hzHostLabel),
+		above: hegel.Draw(tc, shaped(hegel.Just[[]string](nil), many(hzHostLabel, 1, 1))),
+	}
+})
+
+// suffixName is the public suffix with the labels above it.
+func (j hzJarCase) suffixName() string {
+	labels := j.hostLabels()
+	return strings.Join(labels[j.publicSuffixAt()-len(j.above):], ".")
+}
+
+// TestHegelAdapterPublicSuffixOfASuffix: net/publicsuffix.PublicSuffix of a name that is
+// itself a public suffix is the name, with icann as the rule says, as golang.org/x/net's
+// is; the adapter returns "" (publicsuffix-go/2). HEGEL_NO_KNOWN=1 draws the name one label
+// above the suffix.
+func TestHegelAdapterPublicSuffixOfASuffix(t *testing.T) {
+	c := hzNewCollector(t)
+	model, _ := hzDefault()
+	hzProperty(t, func(ht *hegel.T) {
+		name := hegel.Draw(ht, hzSuffixNameCases).suffixName()
+		ps, icann := wnet.PublicSuffix(name)
+		wantPS, wantRule := model.publicSuffix(name)
+		wantICANN := !wantRule.Private && !wantRule.def
+		if ps != wantPS || icann != wantICANN {
+			c.failClass(ht, "adapter", "net/publicsuffix.PublicSuffix(%q) = %q, %v, want %q, %v", name, ps, icann, wantPS, wantICANN)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- publicsuffix-go/3
+
+// hzUnderLookups: a lookup of a name under the first value of the list (labels in front, no
+// decoration) with any find options.
+var hzUnderLookups = hegel.Composite(func(tc hegel.TestCase) hzLookup {
+	return hzLookup{name: hzName{rule: 0, labels: hegel.Draw(tc, hzLabelList(0, 2))}, find: hegel.Draw(tc, hzFinds)}
+})
+
+// hzRuleLineOf is a rule line of the marker and labels, alone in its list.
+func hzRuleLineOf(marker string, labels []string) hzLine {
+	return hzLine{kind: "rule", rule: hzRuleLine{marker: marker, labels: labels, reuse: -1, under: -1}}
+}
+
+var (
+	// hzJunkTexts: trailing text after whitespace on a rule line.
+	hzJunkTexts = hegel.SampledFrom([]string{" // comment", "\tjunk", " b", " x.y", "  *.z"})
+	// hzLineMarkers: a rule's marker, the bare "*" line left out (its value is empty, so no
+	// name is built under it).
+	hzLineMarkers = weighted(choice[string]{65, hegel.Just("")}, choice[string]{19, hegel.Just("*.")}, choice[string]{16, hegel.Just("!")})
+	// hzJunkRuleCases: a list of one rule line with trailing whitespace-separated text
+	// (publicsuffix-go/3's shape), or under HEGEL_NO_KNOWN=1 without it, and one or two
+	// lookups under its value.
+	hzJunkRuleCases = hegel.Composite(func(tc hegel.TestCase) hzListCase {
+		line := hzRuleLineOf(hegel.Draw(tc, hzLineMarkers), hegel.Draw(tc, hzLabelList(1, 3)))
+		line.lead = hegel.Draw(tc, hzLeads)
+		line.trail = hegel.Draw(tc, hzTrails)
+		line.junk = hegel.Draw(tc, shaped(hzJunkTexts, hegel.Just("")))
+		return hzListCase{
+			list:    hzListSpec{lines: []hzLine{line}, crlf: hegel.Draw(tc, chance(20)), noFinalBreak: hegel.Draw(tc, chance(20)), opt: hegel.Draw(tc, hzParserOpts)},
+			lookups: hegel.Draw(tc, many(hzUnderLookups, 1, 2)),
+		}
+	})
+)
+
+// TestHegelRuleLineReadUpToWhitespace: a rule line is read up to its first whitespace, so a
+// name under the rule finds it whatever follows; the package reads the line whole
+// (publicsuffix-go/3). HEGEL_NO_KNOWN=1 draws the line without trailing text.
+func TestHegelRuleLineReadUpToWhitespace(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckList(ht, c, hegel.Draw(ht, hzJunkRuleCases))
+	})
+}
+
+// --------------------------------------------------------------------------- publicsuffix-go/4
+
+// hzSameValueCases: two rule lines with the same labels under any markers (publicsuffix-go/4's
+// shape), or under HEGEL_NO_KNOWN=1 the second with one label more, and lookups under the
+// first.
+var hzSameValueCases = hegel.Composite(func(tc hegel.TestCase) hzListCase {
+	labels := hegel.Draw(tc, hzLabelList(1, 2))
+	second := labels
+	if noKnown {
+		second = append([]string{hegel.Draw(tc, hzASCIILabel)}, labels...)
+	}
+	lines := []hzLine{
+		hzRuleLineOf(hegel.Draw(tc, hzLineMarkers), labels),
+		hzRuleLineOf(hegel.Draw(tc, hzLineMarkers), second),
+	}
+	return hzListCase{
+		list:    hzListSpec{lines: lines, opt: hegel.Draw(tc, hzParserOpts)},
+		lookups: hegel.Draw(tc, many(hzUnderLookups, 1, 2)),
+	}
+})
+
+// TestHegelSameValueRulesAreBothKept: two rules with the same value (a normal rule, a wildcard
+// and an exception can share one) are both in the list, so Size counts both and the lookup
+// finds the prevailing one; the package keys its rules by value and keeps the last
+// (publicsuffix-go/4). HEGEL_NO_KNOWN=1 draws distinct values.
+func TestHegelSameValueRulesAreBothKept(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckList(ht, c, hegel.Draw(ht, hzSameValueCases))
+	})
+}
+
+// --------------------------------------------------------------------------- publicsuffix-go/5
+
+// hzExceptionCases: an exception rule w.X (under a wildcard *.X or not) beside a normal rule
+// y.w.X one label longer, and a lookup under the normal rule (publicsuffix-go/5's shape); under
+// HEGEL_NO_KNOWN=1 the normal rule is X, shorter than the exception, and the lookup is under
+// the exception. ASCII labels, so that the names reach the rules whatever the parser options.
+var hzExceptionCases = hegel.Composite(func(tc hegel.TestCase) hzListCase {
+	base := hegel.Draw(tc, many(hzASCIILabel, 1, 2))
+	exception := append([]string{hegel.Draw(tc, hzASCIILabel)}, base...)
+	longer := append([]string{hegel.Draw(tc, hzASCIILabel)}, exception...)
+	var lines []hzLine
+	if hegel.Draw(tc, shaped(chance(50), hegel.Just(false))) {
+		lines = append(lines, hzRuleLineOf("*.", base))
+	}
+	lines = append(lines, hzRuleLineOf("!", exception), hzRuleLineOf("", shaped(longer, base)))
+	under := shaped(len(lines)-1, len(lines)-2) // the normal rule, or the exception
+	return hzListCase{
+		list:    hzListSpec{lines: lines, opt: hegel.Draw(tc, hzParserOpts)},
+		lookups: []hzLookup{{name: hzName{rule: under, labels: hegel.Draw(tc, many(hzASCIILabel, 1, 2))}, find: hegel.Draw(tc, hzFinds)}},
+	}
+})
+
+// TestHegelExceptionPrevailsOverLongerRule: among the rules matching a name an exception rule
+// prevails, whatever the number of labels of a normal rule that matches too; the package
+// returns the first rule found from the longest suffix (publicsuffix-go/5). HEGEL_NO_KNOWN=1
+// draws the normal rule shorter than the exception.
+func TestHegelExceptionPrevailsOverLongerRule(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		hzCheckList(ht, c, hegel.Draw(ht, hzExceptionCases))
+	})
+}
+
+// --------------------------------------------------------------------------- publicsuffix-go/6
+
+// hzOwnStarCase is a name of two to four labels looked up on an empty list with find options
+// whose default rule is an own "*" rule (publicsuffix-go/6's shape), or under HEGEL_NO_KNOWN=1
+// the package's DefaultRule.
+type hzOwnStarCase struct {
+	labels []string
+	find   hzFind
+}
+
+var hzOwnStarCases = hegel.Composite(func(tc hegel.TestCase) hzOwnStarCase {
+	return hzOwnStarCase{
+		labels: hegel.Draw(tc, hzLabelList(2, 4)),
+		find:   hzFind{ignorePrivate: hegel.Draw(tc, chance(30)), def: shaped("star", "package")},
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c hzOwnStarCase) GoString() string {
+	return fmt.Sprintf("name %q with %s", strings.Join(c.labels, "."), c.find)
+}
+
+// TestHegelOwnStarDefaultRuleDecomposes: with an own "*" rule as the DefaultRule of
+// FindOptions, a name that matches no rule decomposes as under the package's DefaultRule (the
+// last label is the public suffix); the package special-cases its DefaultRule by pointer and
+// decomposes an own one wrongly, a TLD ending in "." (publicsuffix-go/6). The rule found is not
+// compared, since its Length is publicsuffix-go/8's shape. HEGEL_NO_KNOWN=1 draws the package's
+// DefaultRule.
+func TestHegelOwnStarDefaultRuleDecomposes(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		oc := hegel.Draw(ht, hzOwnStarCases)
+		name := strings.Join(oc.labels, ".")
+		fo, ignorePrivate, def := oc.find.options()
+		list, model := publicsuffix.NewList(), hzNewList()
+		parts := fo.DefaultRule.Decompose(name)
+		left, tld, _ := def.decompose(name)
+		if parts[0] != left || parts[1] != tld {
+			c.failClass(ht, "decompose", "Decompose(%q) by the default rule %s = %q, want [%q %q]", name, oc.find, parts, left, tld)
+			return
+		}
+		dn, err := publicsuffix.ParseFromListWithOptions(list, name, fo)
+		wantDN, wantClass := model.parse(name, ignorePrivate, def)
+		if hzErrClass(err) != wantClass {
+			c.failClass(ht, "parse error", "Parse(%q, %s) on an empty list: %v (%s), want %s", name, oc.find, err, hzErrClass(err), wantClass)
+			return
+		}
+		if err != nil {
+			c.count("parse " + wantClass)
+			return
+		}
+		c.count("parse ok")
+		if dn.TLD != wantDN.TLD || dn.SLD != wantDN.SLD || dn.TRD != wantDN.TRD {
+			c.failClass(ht, "parse", "Parse(%q, %s) on an empty list = %s, want %s", name, oc.find, hzFmtDN(dn), wantDN)
+			return
+		}
+		d, err := publicsuffix.DomainFromListWithOptions(list, name, fo)
+		if err != nil || d != wantDN.SLD+"."+wantDN.TLD {
+			c.failClass(ht, "domain", "Domain(%q, %s) on an empty list = %q, %v, want %q", name, oc.find, d, err, wantDN.SLD+"."+wantDN.TLD)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- publicsuffix-go/7
+
+var (
+	// hzMalformedContents: content for NewRule that is empty, or starts with "*" followed by
+	// something other than "." (publicsuffix-go/7's shape).
+	hzMalformedContents = weighted(
+		choice[string]{1, hegel.Just("")},
+		choice[string]{3, hegel.Composite(func(tc hegel.TestCase) string {
+			return "*" + hegel.Draw(tc, hegel.SampledFrom([]string{" ", "", "x", "*"})) + strings.Join(hegel.Draw(tc, hzLabelList(1, 2)), ".")
+		})},
+	)
+	// hzWellFormedContents: "*", or labels under a marker.
+	hzWellFormedContents = weighted(
+		choice[string]{1, hegel.Just("*")},
+		choice[string]{3, hegel.Composite(func(tc hegel.TestCase) string {
+			return hegel.Draw(tc, hzLineMarkers) + strings.Join(hegel.Draw(tc, hzLabelList(1, 2)), ".")
+		})},
+	)
+	hzNewRuleContents = shaped(hzMalformedContents, hzWellFormedContents)
+)
+
+// TestHegelNewRuleRejectsMalformedContent: NewRule returns an error for empty content and
+// reads content starting with "*" but not "*." as what it is (a normal rule of that text, or
+// an error), never as a wildcard of the text after two bytes; the package panics on "" and
+// makes "* b" the wildcard "*.b" (publicsuffix-go/7). HEGEL_NO_KNOWN=1 draws well-formed
+// content.
+func TestHegelNewRuleRejectsMalformedContent(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		content := hegel.Draw(ht, hzNewRuleContents)
+		var r *publicsuffix.Rule
+		var err error
+		if p := hzCatch(func() { r, err = publicsuffix.NewRule(content) }); p != nil {
+			c.failClass(ht, "panic", "NewRule(%q) panicked: %v", content, p)
+			return
+		}
+		if content == "" {
+			if err == nil {
+				c.failClass(ht, "error", "NewRule(\"\") = %s, want an error", hzFmtRule(r))
+			}
+			return
+		}
+		want, _ := hzParseRuleText(content, false)
+		if err != nil {
+			c.failClass(ht, "error", "NewRule(%q): %v, want %s", content, err, want)
+			return
+		}
+		if hzFmtRule(r) != want.String() {
+			c.failClass(ht, "rule", "NewRule(%q) = %s, want %s", content, hzFmtRule(r), want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- publicsuffix-go/8
+
+// hzLengthCase is a rule whose Length is checked: its content and where it comes from
+// (DefaultRule, NewRule, or a list loaded from the content).
+type hzLengthCase struct {
+	source  string
+	content string
+}
+
+var (
+	hzStarLengthCases = hegel.Map(hegel.SampledFrom([]string{"DefaultRule", "NewRule", "list"}), func(source string) hzLengthCase {
+		return hzLengthCase{source: source, content: "*"}
+	})
+	hzNormalLengthCases = hegel.Composite(func(tc hegel.TestCase) hzLengthCase {
+		return hzLengthCase{source: hegel.Draw(tc, hegel.SampledFrom([]string{"NewRule", "list"})), content: strings.Join(hegel.Draw(tc, hzLabelList(1, 3)), ".")}
+	})
+	// hzLengthCases: the "*" rule (publicsuffix-go/8's shape), or under HEGEL_NO_KNOWN=1 a
+	// normal rule of one to three labels.
+	hzLengthCases = shaped(hzStarLengthCases, hzNormalLengthCases)
+)
+
+// rule is the rule of the case.
+func (lc hzLengthCase) rule() (*publicsuffix.Rule, error) {
+	switch lc.source {
+	case "DefaultRule":
+		return publicsuffix.DefaultRule, nil
+	case "NewRule":
+		return publicsuffix.NewRule(lc.content)
+	}
+	rules, err := publicsuffix.NewList().LoadString(lc.content+"\n", &publicsuffix.ParserOption{PrivateDomains: true, ASCIIEncoded: true})
+	if err != nil {
+		return nil, err
+	}
+	return &rules[0], nil
+}
+
+// TestHegelStarRuleLengthIsOne: Rule.Length is the number of labels of the rule as written,
+// one for "*" (DefaultRule, NewRule("*"), a "*" line of a list); the package counts the empty
+// value as a label and gives 2 (publicsuffix-go/8). HEGEL_NO_KNOWN=1 draws a normal rule.
+func TestHegelStarRuleLengthIsOne(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		lc := hegel.Draw(ht, hzLengthCases)
+		r, err := lc.rule()
+		if err != nil {
+			c.failClass(ht, "error", "the %s rule %q: %v", lc.source, lc.content, err)
+			return
+		}
+		want, _ := hzParseRuleText(lc.content, false)
+		if r.Length != want.length() {
+			c.failClass(ht, "length", "the %s rule %q has Length %d, want %d", lc.source, lc.content, r.Length, want.length())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- publicsuffix-go/9
+
+// hzExceptionContent is an exception rule in U-labels: its first label and the labels after.
+type hzExceptionContent struct {
+	first string
+	rest  []string
+}
+
+func (e hzExceptionContent) text() string { return "!" + e.first + "." + strings.Join(e.rest, ".") }
+
+// hzUnicodeExceptions: an exception whose first label is a U-label (publicsuffix-go/9's shape),
+// or under HEGEL_NO_KNOWN=1 an ASCII label; the labels after it from the table.
+var hzUnicodeExceptions = hegel.Composite(func(tc hegel.TestCase) hzExceptionContent {
+	return hzExceptionContent{first: hegel.Draw(tc, shaped(hzUnicodeLabel, hzASCIILabel)), rest: hegel.Draw(tc, hzLabelList(1, 2))}
+})
+
+// TestHegelUnicodeExceptionStaysAnException: NewRuleUnicode of an exception rule gives the
+// exception with its value in A-labels; the package converts the whole content first and
+// Punycode-encodes the "!" with a Unicode first label, giving a normal rule
+// (publicsuffix-go/9). HEGEL_NO_KNOWN=1 draws an ASCII first label.
+func TestHegelUnicodeExceptionStaysAnException(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		content := hegel.Draw(ht, hzUnicodeExceptions).text()
+		r, err := publicsuffix.NewRuleUnicode(content)
+		want, wantErr := hzParseRuleText(content, true)
+		if (err != nil) != (wantErr != nil) {
+			c.failClass(ht, "error", "NewRuleUnicode(%q): %v, want %v", content, err, wantErr)
+			return
+		}
+		if err == nil && hzFmtRule(r) != want.String() {
+			c.failClass(ht, "rule", "NewRuleUnicode(%q) = %s, want %s", content, hzFmtRule(r), want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- publicsuffix-go/10
+
+// hzEmptyLabelName is a name of one or two labels, an empty label (publicsuffix-go/10's shape;
+// none under HEGEL_NO_KNOWN=1) and the labels of a rule value of the packaged list or free
+// labels.
+type hzEmptyLabelName struct {
+	front []string
+	empty bool
+	back  []string
+}
+
+func (n hzEmptyLabelName) name() string {
+	labels := append([]string{}, n.front...)
+	if n.empty {
+		labels = append(labels, "")
+	}
+	return strings.Join(append(labels, n.back...), ".")
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (n hzEmptyLabelName) GoString() string { return fmt.Sprintf("name %q", n.name()) }
+
+var (
+	hzRuleValueLabels = hegel.Map(hegel.SampledFrom(hzDefaultRulesOf()), func(r publicsuffix.Rule) []string { return strings.Split(r.Value, ".") })
+	hzEmptyLabelNames = hegel.Composite(func(tc hegel.TestCase) hzEmptyLabelName {
+		return hzEmptyLabelName{
+			front: hegel.Draw(tc, hzLabelList(1, 2)),
+			empty: shaped(true, false),
+			back:  hegel.Draw(tc, weighted(choice[[]string]{3, hzRuleValueLabels}, choice[[]string]{1, hzLabelList(1, 2)})),
+		}
+	})
+)
+
+// TestHegelEmptyLabelNamesAreRejected: Parse rejects a name with an empty label as it rejects
+// one with a leading dot; the package accepts and decomposes it, and its String drops the TRD
+// once the SLD is empty (publicsuffix-go/10). HEGEL_NO_KNOWN=1 draws the name without the
+// empty label.
+func TestHegelEmptyLabelNamesAreRejected(t *testing.T) {
+	c := hzNewCollector(t)
+	model, _ := hzDefault()
+	hzProperty(t, func(ht *hegel.T) {
+		name := hegel.Draw(ht, hzEmptyLabelNames).name()
+		dn, err := publicsuffix.Parse(name)
+		wantDN, wantClass := model.parse(name, false, hzDefaultRule)
+		if hzErrClass(err) != wantClass {
+			c.failClass(ht, "parse error", "Parse(%q): %v (%s), want %s", name, err, hzErrClass(err), wantClass)
+			return
+		}
+		if err != nil {
+			c.count("parse " + wantClass)
+			return
+		}
+		c.count("parse ok")
+		if hzFmtDN(dn) != wantDN.String() {
+			c.failClass(ht, "parse", "Parse(%q) = %s, want %s", name, hzFmtDN(dn), wantDN)
+			return
+		}
+		if s := dn.String(); s != hzModelDNString(wantDN) {
+			c.failClass(ht, "string", "Parse(%q).String() = %q, want %q", name, s, hzModelDNString(wantDN))
+			return
+		}
+		d, err := publicsuffix.Domain(name)
+		if err != nil || d != wantDN.SLD+"."+wantDN.TLD {
+			c.failClass(ht, "domain", "Domain(%q) = %q, %v, want %q", name, d, err, wantDN.SLD+"."+wantDN.TLD)
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..437a2de
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,804 @@
+package hegel
+
+// Hegel property tests for weppos/publicsuffix-go, written for the Hegel zoo. See
+// targets/go/publicsuffix-go/README.md. They live in a package of their own (hegel/) and drive
+// the public API: lists parsed from generated Public Suffix List text and looked up with
+// generated names, the default list, the net/publicsuffix adapter and the cookiejar list.
+//
+// Oracle: a model of the Public Suffix List format and algorithm (https://publicsuffix.org/list/)
+// over the same rules, with the package's documented normalisation.
+//
+// Generators are package-level values built from hegel's combinators: a list is a Lists of line
+// records (a rule of a marker and labels, a comment, a blank line, the private marker) with its
+// whitespace, trailing text and line breaks drawn as data and rendered by a pure function; a name
+// is a recipe (which rule value, modulo the live count, how many labels in front, a decoration)
+// rendered against the drawn list; the parser and find options are records. The shapes of the
+// recorded bugs (bugs.toml) are drawn by default and the model states the documented behaviour,
+// so the properties that meet them fail and are the expected failures mapped to the bugs
+// (STYLE.md rule 11); hegel_zoo_shapes_test.go has one property per bug over its shape region,
+// and hegel_zoo_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 (noKnown, read once)
+// makes the model reproduce the bugs instead, for a run that looks past them.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+
+	"github.com/weppos/publicsuffix-go/publicsuffix"
+	"golang.org/x/net/idna"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the model states the documented behaviour, the generators draw the bugs' shapes and the
+// properties that meet them fail; under HEGEL_NO_KNOWN=1 the switches of HZKnown are on and the
+// model reproduces the package's behaviour, and the narrow properties of
+// hegel_zoo_shapes_test.go draw the region beside each bug instead of its shape.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on, which is so only under HEGEL_NO_KNOWN=1; the pins assert
+// the documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	suffixPublicSuffixEmpty       bool // publicsuffix-go/1, /2: CookieJarList.PublicSuffix and net/publicsuffix.PublicSuffix return "" for a name that is a public suffix
+	wholeLineIsRule               bool // publicsuffix-go/3: a rule line is read whole, not up to its first whitespace
+	sameValueOverwrites           bool // publicsuffix-go/4: rules with the same value (foo, *.foo, !foo) overwrite each other in the list
+	longestBeatsException         bool // publicsuffix-go/5: a matching normal rule with more labels prevails over an exception rule
+	foreignStarMisdecomposes      bool // publicsuffix-go/6: a "*" rule other than DefaultRule cuts the last byte and yields a TLD ending in "."; an own normal default rule that does not match trims the name's last byte
+	emptyValueHasOneLabel         bool // publicsuffix-go/8: Rule.Length counts the empty value as one label ("*" has Length 2)
+	unicodeExceptionPrefixEncoded bool // publicsuffix-go/9: NewRuleUnicode encodes "!" with a Unicode first label, making a normal rule
+	emptySLDDropsTRD              bool // publicsuffix-go/10: a name with an empty label is accepted, and DomainName.String prints only the TLD when the SLD is empty
+	starTakesTwoBytes             bool // publicsuffix-go/7: NewRule reads any content starting with "*" as "*." + content[2:] ("* b" is the wildcard "*.b")
+}{
+	suffixPublicSuffixEmpty:       noKnown,
+	wholeLineIsRule:               noKnown,
+	sameValueOverwrites:           noKnown,
+	longestBeatsException:         noKnown,
+	foreignStarMisdecomposes:      noKnown,
+	emptyValueHasOneLabel:         noKnown,
+	unicodeExceptionPrefixEncoded: noKnown,
+	emptySLDDropsTRD:              noKnown,
+	starTakesTwoBytes:             noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// repeated is a table with its first entry repeated n times, for a SampledFrom that shrinks to
+// the plain entry and draws it most often.
+func repeated[T any](n int, table []T) []T {
+	return slices.Concat(slices.Repeat(table[:1], n), table[1:])
+}
+
+// hzIndex is an index into a list of the case, taken modulo the live count when applied.
+var hzIndex = hegel.Integers(0, 7)
+
+// --------------------------------------------------------------------------- model
+
+// hzRule is a rule of the model: the same three types as the package, the value in A-labels.
+type hzRule struct {
+	Type    int
+	Value   string
+	Private bool
+	def     bool // the model's stand-in for publicsuffix.DefaultRule
+	custom  bool // an own default rule of FindOptions, not a rule of the list
+}
+
+var hzDefaultRule = &hzRule{Type: publicsuffix.WildcardType, Value: "", def: true}
+
+func hzLabelCount(v string) int {
+	if v == "" {
+		if HZKnown.emptyValueHasOneLabel {
+			return 1
+		}
+		return 0
+	}
+	return strings.Count(v, ".") + 1
+}
+
+// length is the number of labels of the rule as written (the "*" of a wildcard counted).
+func (r *hzRule) length() int {
+	n := hzLabelCount(r.Value)
+	if r.Type == publicsuffix.WildcardType {
+		n++
+	}
+	return n
+}
+
+func (r *hzRule) String() string {
+	if r == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%d %q %v %d}", r.Type, r.Value, r.Private, r.length())
+}
+
+// hzFmtRule prints a package rule the way hzRule.String prints a model rule.
+func hzFmtRule(r *publicsuffix.Rule) string {
+	if r == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%d %q %v %d}", r.Type, r.Value, r.Private, r.Length)
+}
+
+// hzList is the model's list: the rules in load order and by value.
+type hzList struct {
+	rules   []*hzRule
+	byValue map[string][]*hzRule
+	size    int
+}
+
+func hzNewList() *hzList { return &hzList{byValue: map[string][]*hzRule{}} }
+
+func (l *hzList) add(r *hzRule) {
+	if HZKnown.sameValueOverwrites {
+		if _, ok := l.byValue[r.Value]; !ok {
+			l.size++
+		}
+		l.byValue[r.Value] = []*hzRule{r}
+		return
+	}
+	l.byValue[r.Value] = append(l.byValue[r.Value], r)
+	l.size++
+}
+
+const hzPrivateMarker = "===BEGIN PRIVATE DOMAINS==="
+
+// hzParseRuleText turns the text of a rule line into a model rule. unicode says whether the
+// list is in U-labels (the value is then converted to A-labels).
+func hzParseRuleText(text string, unicode bool) (*hzRule, error) {
+	if unicode && HZKnown.unicodeExceptionPrefixEncoded {
+		// The package converts the whole line before reading its type, so the label "!first"
+		// of an exception with a Unicode first label is Punycode-encoded together with its
+		// "!", and the rule is read as a normal one.
+		v, err := idna.ToASCII(text)
+		if err != nil {
+			return nil, err
+		}
+		text, unicode = v, false
+	}
+	r := &hzRule{Type: publicsuffix.NormalType, Value: text}
+	switch {
+	case text == "*":
+		r.Type, r.Value = publicsuffix.WildcardType, ""
+	case strings.HasPrefix(text, "*."):
+		r.Type, r.Value = publicsuffix.WildcardType, text[2:]
+	case strings.HasPrefix(text, "*") && HZKnown.starTakesTwoBytes:
+		r.Type, r.Value = publicsuffix.WildcardType, ""
+		if len(text) > 2 {
+			r.Value = text[2:]
+		}
+	case strings.HasPrefix(text, "!"):
+		r.Type, r.Value = publicsuffix.ExceptionType, text[1:]
+	}
+	if unicode {
+		v, err := idna.ToASCII(r.Value)
+		if err != nil {
+			return nil, err
+		}
+		r.Value = v
+	}
+	return r, nil
+}
+
+func hzIsASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
+
+// hzModelLoad parses list text the way the format is documented: one rule per line, read up to
+// the first whitespace, blank lines and "//" comments skipped, the rules after the private
+// marker private (or the parse stopped there when private domains are not wanted). It returns
+// the list, the number of rules parsed and the conversion error, if any.
+func hzModelLoad(src string, opt *publicsuffix.ParserOption) (*hzList, int, error) {
+	if opt == nil {
+		opt = publicsuffix.DefaultParserOptions
+	}
+	l := hzNewList()
+	lines := strings.Split(src, "\n")
+	if strings.HasSuffix(src, "\n") {
+		lines = lines[:len(lines)-1]
+	}
+	private := false
+	n := 0
+	for _, line := range lines {
+		line = strings.TrimSuffix(line, "\r")
+		line = strings.TrimSpace(line)
+		switch {
+		case line == "":
+			continue
+		case strings.Contains(line, hzPrivateMarker):
+			if !opt.PrivateDomains {
+				return l, n, nil
+			}
+			private = true
+			continue
+		case strings.HasPrefix(line, "//"):
+			continue
+		}
+		if !HZKnown.wholeLineIsRule {
+			if i := strings.IndexFunc(line, unicode.IsSpace); i >= 0 {
+				line = line[:i]
+			}
+		}
+		r, err := hzParseRuleText(line, !opt.ASCIIEncoded)
+		if err != nil {
+			return l, n, err
+		}
+		r.Private = private
+		l.add(r)
+		n++
+	}
+	return l, n, nil
+}
+
+func hzRank(r *hzRule) int {
+	switch r.Type {
+	case publicsuffix.ExceptionType:
+		return 3
+	case publicsuffix.WildcardType:
+		return 2
+	}
+	return 1
+}
+
+// find is the algorithm: among the rules matching the name, an exception rule prevails, then
+// the one with the most labels; none matching, the default rule. A wildcard rule needs one
+// label more than its value.
+func (l *hzList) find(name string, ignorePrivate bool, def *hzRule) *hzRule {
+	if !HZKnown.longestBeatsException {
+		for part := name; ; {
+			for _, r := range l.byValue[part] {
+				if r.Type == publicsuffix.ExceptionType && !(ignorePrivate && r.Private) {
+					return r
+				}
+			}
+			i := strings.IndexByte(part, '.')
+			if i < 0 {
+				break
+			}
+			part = part[i+1:]
+		}
+	}
+	for part := name; ; {
+		var best *hzRule
+		for _, r := range l.byValue[part] {
+			if ignorePrivate && r.Private {
+				continue
+			}
+			if r.Type == publicsuffix.WildcardType && part == name {
+				continue
+			}
+			if best == nil || hzRank(r) > hzRank(best) {
+				best = r
+			}
+		}
+		if best != nil {
+			return best
+		}
+		i := strings.IndexByte(part, '.')
+		if i < 0 {
+			return def
+		}
+		part = part[i+1:]
+	}
+}
+
+// hzEndsWithValue says the name is the value or has it as a label suffix.
+func hzEndsWithValue(name, value string) bool {
+	return name == value || strings.HasSuffix(name, "."+value)
+}
+
+// decompose splits the name into the part left of the public suffix and the public suffix
+// itself (the rule's labels, one more for a wildcard, one fewer for an exception, the last
+// label for the default rule); isSuffix says the name has no more labels than the suffix,
+// when both parts are empty as the package documents.
+func (r *hzRule) decompose(name string) (left, tld string, isSuffix bool) {
+	labels := strings.Split(name, ".")
+	var n int
+	switch {
+	case r.def:
+		n = 1
+	case r.custom && r.Type == publicsuffix.NormalType && !hzEndsWithValue(name, r.Value):
+		// An own normal default rule reached by a name it does not match: the rule's value is
+		// the public suffix and the whole name is left of it (the pin of publicsuffix-go/6);
+		// the package trims the value as a string suffix, then the last byte, which it takes
+		// for the dot.
+		if name == "" {
+			return "", "", true
+		}
+		if HZKnown.foreignStarMisdecomposes {
+			s := strings.TrimSuffix(name, r.Value)
+			if s == "" {
+				return "", "", true
+			}
+			return s[:len(s)-1], r.Value, false
+		}
+		return name, r.Value, false
+	case r.Type == publicsuffix.NormalType:
+		n = len(strings.Split(r.Value, "."))
+	case r.Type == publicsuffix.WildcardType:
+		if r.Value == "" {
+			if HZKnown.foreignStarMisdecomposes {
+				// The package trims the empty value, then a byte it takes for the dot.
+				if name == "" {
+					return "", "", true
+				}
+				s := name[:len(name)-1]
+				i := strings.LastIndexByte(s, '.')
+				if i < 0 {
+					return "", "", true
+				}
+				return s[:i], s[i+1:] + ".", false
+			}
+			n = 1
+		} else {
+			n = len(strings.Split(r.Value, ".")) + 1
+		}
+	default:
+		n = len(strings.Split(r.Value, ".")) - 1
+		if n == 0 {
+			return "", "", true
+		}
+	}
+	if len(labels) <= n {
+		return "", "", true
+	}
+	return strings.Join(labels[:len(labels)-n], "."), strings.Join(labels[len(labels)-n:], "."), false
+}
+
+// hzModelDN is the model's DomainName.
+type hzModelDN struct {
+	TLD, SLD, TRD string
+	Rule          *hzRule
+}
+
+func (d *hzModelDN) String() string {
+	if d == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%q %q %q %s}", d.TLD, d.SLD, d.TRD, d.Rule)
+}
+
+func hzFmtDN(d *publicsuffix.DomainName) string {
+	if d == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%q %q %q %s}", d.TLD, d.SLD, d.TRD, hzFmtRule(d.Rule))
+}
+
+// hzErrClass classifies the package's errors by their message.
+func hzErrClass(err error) string {
+	switch {
+	case err == nil:
+		return "ok"
+	case strings.Contains(err.Error(), "is blank"):
+		return "blank"
+	case strings.Contains(err.Error(), "starts with a dot"):
+		return "dot"
+	case strings.Contains(err.Error(), "no rule matching"):
+		return "no rule"
+	case strings.Contains(err.Error(), "is a suffix"):
+		return "suffix"
+	}
+	return "other: " + err.Error()
+}
+
+// hzHasEmptyInnerLabel says the name has an empty label that is neither its first (a leading
+// dot) nor its last (a trailing dot).
+func hzHasEmptyInnerLabel(name string) bool {
+	labels := strings.Split(name, ".")
+	for i := 1; i < len(labels)-1; i++ {
+		if labels[i] == "" {
+			return true
+		}
+	}
+	return false
+}
+
+// parse is ParseFromListWithOptions: the name lowercased, blank and leading-dot names
+// rejected, then find and decompose; the error class is returned instead of an error.
+func (l *hzList) parse(name string, ignorePrivate bool, def *hzRule) (*hzModelDN, string) {
+	n := strings.ToLower(name)
+	if n == "" {
+		return nil, "blank"
+	}
+	if n[0] == '.' {
+		return nil, "dot"
+	}
+	if !HZKnown.emptySLDDropsTRD && hzHasEmptyInnerLabel(n) {
+		// A name with an empty label is rejected as one with a leading dot is (the pin of
+		// publicsuffix-go/10); the package accepts and decomposes it.
+		return nil, "empty label"
+	}
+	r := l.find(n, ignorePrivate, def)
+	if r == nil {
+		return nil, "no rule"
+	}
+	left, tld, _ := r.decompose(n)
+	if tld == "" {
+		return nil, "suffix"
+	}
+	d := &hzModelDN{TLD: tld, Rule: r}
+	if i := strings.LastIndexByte(left, '.'); i < 0 {
+		d.SLD = left
+	} else {
+		d.TRD, d.SLD = left[:i], left[i+1:]
+	}
+	return d, "ok"
+}
+
+// publicSuffix is the public suffix of a name as a cookie jar wants it: the suffix part of
+// the decomposition, the name itself when the name is a public suffix.
+func (l *hzList) publicSuffix(name string) (string, *hzRule) {
+	r := l.find(name, false, hzDefaultRule)
+	_, tld, isSuffix := r.decompose(name)
+	if isSuffix && !HZKnown.suffixPublicSuffixEmpty {
+		return name, r
+	}
+	return tld, r
+}
+
+// hzModelDNString is DomainName.String as documented: the components joined, empty ones
+// skipped.
+func hzModelDNString(d *hzModelDN) string {
+	var parts []string
+	for _, p := range []string{d.TRD, d.SLD, d.TLD} {
+		if p != "" {
+			parts = append(parts, p)
+		}
+	}
+	if d.TLD == "" {
+		return ""
+	}
+	if d.SLD == "" && HZKnown.emptySLDDropsTRD {
+		return d.TLD
+	}
+	return strings.Join(parts, ".")
+}
+
+// --------------------------------------------------------------------------- default list
+
+var (
+	hzDefaultOnce  sync.Once
+	hzDefaultModel *hzList
+	hzDefaultRules []publicsuffix.Rule
+)
+
+func hzDefault() (*hzList, []publicsuffix.Rule) {
+	hzDefaultOnce.Do(func() {
+		all := publicsuffix.DefaultRules()
+		hzDefaultRules = all[:]
+		hzDefaultModel = hzNewList()
+		for i := range hzDefaultRules {
+			r := hzDefaultRules[i]
+			hzDefaultModel.add(&hzRule{Type: r.Type, Value: r.Value, Private: r.Private})
+		}
+	})
+	return hzDefaultModel, hzDefaultRules
+}
+
+// hzSpecialRules is the wildcard and exception rules of the packaged list (296 of 10326).
+var hzSpecialRules = func() []publicsuffix.Rule {
+	_, rules := hzDefault()
+	var special []publicsuffix.Rule
+	for _, r := range rules {
+		if r.Type != publicsuffix.NormalType {
+			special = append(special, r)
+		}
+	}
+	return special
+}()
+
+// --------------------------------------------------------------------------- labels and names
+
+var hzLabels = []string{"a", "b", "c", "co", "uk", "ck", "www", "city", "x-1", "0", "xn--p1ai", "blogspot", "example"}
+
+var hzUnicodeLabels = []string{"日本", "bücher", "рф"}
+
+var (
+	hzASCIILabel   = hegel.SampledFrom(hzLabels)
+	hzUnicodeLabel = hegel.SampledFrom(hzUnicodeLabels)
+	// hzLabel: a label of the table, one in twenty-five a U-label.
+	hzLabel = weighted(choice[string]{96, hzASCIILabel}, choice[string]{4, hzUnicodeLabel})
+	// hzHostLabel: the short labels, for host names of the cookie properties.
+	hzHostLabel = hegel.SampledFrom(hzLabels[:8])
+)
+
+// hzLabelList is lo to hi labels.
+func hzLabelList(lo, hi int) hegel.Generator[[]string] { return many(hzLabel, lo, hi) }
+
+// hzName is the recipe of a name: around the rule-th value of the drawn list (modulo the count
+// of values; its parent; converted to A-labels) with labels in front, or free labels; then a
+// decoration. It is rendered against the list's values by render.
+type hzName struct {
+	rule   int      // -1: a free name of labels; else the index of the value, modulo the count
+	parent bool     // the suffix of the value (its labels after the first)
+	ascii  bool     // a U-label value converted to A-labels, as the list keeps its rules
+	labels []string // the labels in front of the value, or the whole free name
+	deco   string   // one of hzDecorations
+}
+
+// hzDecorations: as drawn, upper case, the first letter upper case, a leading dot, a trailing
+// dot, an empty label after the first, the empty string.
+var hzDecorations = []string{"", "upper", "upper-first", "leading-dot", "trailing-dot", "empty-label", "blank"}
+
+var (
+	hzRuleNames = hegel.Composite(func(tc hegel.TestCase) hzName {
+		return hzName{
+			rule:   hegel.Draw(tc, hzIndex),
+			parent: hegel.Draw(tc, chance(15)),
+			ascii:  hegel.Draw(tc, chance(60)),
+			labels: hegel.Draw(tc, hzLabelList(0, 3)),
+		}
+	})
+	hzFreeNames = hegel.Map(hzLabelList(1, 4), func(ls []string) hzName { return hzName{rule: -1, labels: ls} })
+	// hzDecoration: none in 34 of 40, else one of the six.
+	hzDecoration = hegel.SampledFrom(repeated(34, hzDecorations))
+	// hzNames: a name around a rule value three times in four, else free labels, decorated.
+	hzNames = hegel.Composite(func(tc hegel.TestCase) hzName {
+		n := hegel.Draw(tc, weighted(choice[hzName]{75, hzRuleNames}, choice[hzName]{25, hzFreeNames}))
+		n.deco = hegel.Draw(tc, hzDecoration)
+		return n
+	})
+)
+
+// render is the name over the values of the drawn list (the rule values as written, so names
+// in U-labels reach a list in U-labels and the A-label conversion reaches its rules).
+func (n hzName) render(values []string) string {
+	var name string
+	if n.rule >= 0 && len(values) > 0 {
+		s := values[n.rule%len(values)]
+		if n.parent {
+			if i := strings.IndexByte(s, '.'); i >= 0 {
+				s = s[i+1:]
+			}
+		}
+		if n.ascii && !hzIsASCII(s) {
+			if a, err := idna.ToASCII(s); err == nil {
+				s = a
+			}
+		}
+		name = strings.Join(append(slices.Clone(n.labels), s), ".")
+	} else {
+		name = strings.Join(n.labels, ".")
+	}
+	switch n.deco {
+	case "upper":
+		name = strings.ToUpper(name)
+	case "upper-first":
+		if name != "" {
+			name = strings.ToUpper(name[:1]) + name[1:]
+		}
+	case "leading-dot":
+		name = "." + name
+	case "trailing-dot":
+		name += "."
+	case "empty-label":
+		if i := strings.IndexByte(name, '.'); i >= 0 {
+			name = name[:i] + "." + name[i:]
+		}
+	case "blank":
+		name = ""
+	}
+	return name
+}
+
+// --------------------------------------------------------------------------- find options
+
+// hzFind is the FindOptions of a lookup: nil, or IgnorePrivate and a default rule: the
+// package's, none, an own "*" rule, an own normal rule of one label (publicsuffix-go/6's
+// region, drawn by default; the model states the pin's expectation for it).
+type hzFind struct {
+	absent        bool
+	ignorePrivate bool
+	def           string // "package", "nil", "star", "normal"
+	defLabel      string // the value of the own normal rule
+}
+
+var hzOwnStar = publicsuffix.MustNewRule("*")
+
+var hzFinds = hegel.Composite(func(tc hegel.TestCase) hzFind {
+	return hzFind{
+		absent:        hegel.Draw(tc, chance(20)),
+		ignorePrivate: hegel.Draw(tc, chance(30)),
+		def:           hegel.Draw(tc, hegel.SampledFrom(repeated(7, []string{"package", "nil", "star", "normal"}))),
+		defLabel:      hegel.Draw(tc, hzASCIILabel),
+	}
+})
+
+// options is the FindOptions, whether private rules are ignored, and the model's default rule.
+func (f hzFind) options() (*publicsuffix.FindOptions, bool, *hzRule) {
+	if f.absent {
+		return nil, false, hzDefaultRule
+	}
+	o := &publicsuffix.FindOptions{IgnorePrivate: f.ignorePrivate, DefaultRule: publicsuffix.DefaultRule}
+	def := hzDefaultRule
+	switch f.def {
+	case "nil":
+		o.DefaultRule, def = nil, nil
+	case "star":
+		o.DefaultRule, def = hzOwnStar, &hzRule{Type: publicsuffix.WildcardType, custom: true}
+	case "normal":
+		o.DefaultRule, def = publicsuffix.MustNewRule(f.defLabel), &hzRule{Type: publicsuffix.NormalType, Value: f.defLabel, custom: true}
+	}
+	return o, o.IgnorePrivate, def
+}
+
+func (f hzFind) String() string {
+	if f.absent {
+		return "nil options"
+	}
+	def := f.def
+	if f.def == "normal" {
+		def = "own " + f.defLabel
+	}
+	return fmt.Sprintf("{IgnorePrivate:%v DefaultRule:%s}", f.ignorePrivate, def)
+}
