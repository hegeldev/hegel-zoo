+// transformer's error on a "b" stops the merge before the array in one case in twenty).
+// Past the shape under HEGEL_NO_KNOWN=1 both
+// arrays are non-zero and no option overrides (the source's MA is nil: a map-of-interfaces entry
+// of another kind than the destination's is a crash without any option, mergo/17's rule).
+func TestHegelZeroArraysAreEmpty(t *testing.T) {
+	inner := innerLight
+	plain := optsWith(func(o *opts) {
+		o.override, o.owe, o.deepCopy, o.deprecated, o.transformers = false, false, false, false, false
+	})
+	override := optsWith(func(o *opts) { o.override, o.owe, o.deepCopy, o.transformers = true, false, false, false })
+	filled := mergeCases(innerType, plain,
