+// --------------------------------------------------------------------------- mergo/14
+
+// typedFields are the exported fields of a struct type (the promoted ones included) exactly
+// of type elem.
+func typedFields(st, elem reflect.Type) []string {
+	var names []string
+	var walk func(t reflect.Type)
+	walk = func(t reflect.Type) {
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			if f.Anonymous && f.Type.Kind() == reflect.Struct {
+				walk(f.Type)
+			} else if f.Type == elem {
+				names = append(names, f.Name)
+			}
+		}
+	}
+	walk(st)
+	return names
+}
