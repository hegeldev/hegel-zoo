+		quiet(dst.FieldByName("In"), src.FieldByName("In"))
+		quiet(dst.FieldByName("PIn").Elem(), src.FieldByName("PIn").Elem())
+		src.FieldByName("PIn").Elem().FieldByName("PL").Set(reflect.Zero(reflect.PointerTo(leafType)))
