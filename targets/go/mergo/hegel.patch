+// hzTuple2 draws a pair (hzTuple over two generators, as an array).
+func hzTuple2(a, b hegel.Generator[reflect.Value]) hegel.Generator[[2]reflect.Value] {
+	return hegel.Map(hzTuple(a, b), func(vs []reflect.Value) [2]reflect.Value { return [2]reflect.Value{vs[0], vs[1]} })
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..d03437d
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,1414 @@
+package hegel
+
+// Hegel property tests for darccio/mergo, written for the Hegel zoo. See
+// targets/go/mergo/README.md.
+//
+// Oracles: a model of the documented Merge (empty destination attributes take the source's,
+// recursively through exported struct fields, pointers and maps; the options WithOverride,
+// WithOverwriteWithEmptyValue, WithOverrideEmptySlice, WithoutDereference, WithAppendSlice,
+// WithTypeCheck, WithSliceDeepCopy and WithTransformers) over generated values of a type
+// universe covering every supported kind; laws that hold regardless of the model (a zero source
+// changes nothing, Merge is idempotent, the source is left alone, errors only where documented);
+// a model of Map in both directions (struct <-> map[string]interface{}, keys in lower camel
+// case, nested maps into nested structs, kind mismatches as errors).
+//
+// The files: hegel_zoo_idioms_test.go has the generator idioms (the weighted choices, the
+// fair-bit dice, the halving helpers); this file the harness (hzOpts, hzProperty, the
+// collector, the known value, the judge, the classifier) and the structural comparison of
+// values (same, diffPath, show, canon); hegel_zoo_values_test.go the type universe, the value
+// generators (one per type and depth, memoised) and deepCopy; hegel_zoo_model_test.go the
+// options, the transformers, the model of Merge and Map with the switch set threaded, the
+// statements (mergeExpected, mapExpected, the laws) and the classifier's use of them;
+// hegel_zoo_merge_test.go the merge case record, its generators and the two wide properties on
+// Merge; hegel_zoo_map_test.go the map case record and the wide property on Map;
+// hegel_zoo_shapes_test.go one narrow property per recorded bug the wide ones reach;
+// hegel_pins_test.go the pins.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES, HEGEL_SEED
+// and HEGEL_VERBOSE are passed through hzOpts; a panic in the code under test is turned into
+// a failure of the current test case by the judge's Recover, which names the shape of the
+// recorded bug the case has (the properties catch the library's panics themselves into the
+// outcome "panic", which is judged like any other value; Recover is the net under everything
+// else). MERGO_COLLECT=1 (or ZOO_COLLECT=1) makes the properties record their mismatches
+// instead of failing and print the counts. The model states the documented behaviour (every
+// switch of the known value below off) and the properties judge the library against it; the
+// shape of a recorded bug is named by the classifier shapeBy, which runs the model per switch
+// on the case record, fails by default "(the shape of mergo/N)", and under HEGEL_NO_KNOWN=1
+// the cases with a shape are not drawn (the wide properties filter their case generators by
+// the classifier, withoutShapes) or, in the narrow properties, the region past the shape is
+// drawn (hzShaped, regionOf), so that a run looks past the known bugs.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hzOpts passes HEGEL_TEST_CASES, HEGEL_SEED and HEGEL_VERBOSE through to the engine, which
+// reads no environment variable itself (the seed is for the rate measurements of the probe
+// and the collector), and asks for one failure per run for the shrink budget.
+func hzOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	if hzShrinkBudget > 0 {
+		// The shrink budget: one failure per run (the engine otherwise generates on while
+		// the cases fail, ten times the count on a property that always fails, and its
+		// re-run of the failures before shrinking would meet a rejected attempt and end the
+		// run as "flaky" with nothing printed).
+		opts = append(opts, hegel.WithReportMultipleFailures(false))
+	}
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi, go/go-debian, go/gin, go/cellbuf, go/kong and
+// go/roaring judge).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("MERGO_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+	fails  int  // failing judgements so far (the shrink budget)
+	budget int  // the failing judgements allowed, set at the first failure
+	armed  bool // past the budget: reject the next attempt before it draws
+	cycles int  // the attempts so rejected
+}
+
+// hzShrinkBudget bounds the shrinking of a failure: the engine (hegel-go v0.6.33 over
+// libhegel) keeps every attempt of a shrink in memory and has no budget for it. Measured
+// with a property of n plain Integers(0, 3) draws that always fails: in a module of its own
+// under go test, maxrss of the whole process, 180 MB and 3 s at n = 300, 817 MB and 21 s at
+// 1500, 1.6 GB and 65 s at 3000; inside this package's test binary (RSS sampled while
+// shrinking), 250 MB at 300, 1.8 GB at 1500, 5.3 GB in 35 s at 3000. A merge case of this
+// target is a sequence of that length (an Inner at depth 0 is about 350 draws, an Outer at
+// depth 2 thousands), and a shrink of one Outer case ran five minutes and 4 GB. So after a
+// budget of failing judgements the next attempt is rejected before its first draw (Assume:
+// counted "budget skipped"), which ends the shrink: the engine ends a shrink at an attempt
+// rejected before it drew (measured: one such rejection, then the replay), but shrinks on
+// past attempts rejected after drawing (measured on the Map model: 1476 drawn rejections
+// and 2277 attempts repeating the last message, the shrinker's re-rolls of hzDie's faces
+// making many choice sequences of one case, 309 s and 4.8 GB). The engine then replays the
+// last failing attempt exactly for its report: that attempt draws, is judged and fails as
+// usual, so the failure prints ("budget replayed"; nothing the property sees tells the
+// phases apart, and the replay is not told by its message either, whose first difference
+// in a map follows map order). Were the engine to shrink on past the undrawn rejection, the
+// drawn attempt that fails arms the next undrawn rejection, and after hzShrinkCycles such
+// cycles every attempt is rejected undrawn and the run ends without a message ("budget
+// exhausted"). The engine's memory per attempt grows with the case's draws, as the text of
+// the case does, so the budget is hzShrinkBudget bytes of the first failure's message: the
+// attempts allowed are the bytes over the message's length, between 100 and 3000 (an Outer
+// case prints 10 to 20 KB and an attempt on it costs about 0.3 s and 6 to 8 MB resident:
+// 100 to 150 attempts, 50 to 80 s, 0.9 to 1.5 GB, two properties shrinking at a time under
+// go test's -parallel; a narrow property's case prints a few hundred bytes and shrinks
+// thousands of times in seconds). HEGEL_SHRINK_BUDGET sets the bytes, 0 for no budget.
+// Collect mode records every failure and never shrinks.
+var hzShrinkBudget = func() int {
+	if s := os.Getenv("HEGEL_SHRINK_BUDGET"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v >= 0 {
+			return v
+		}
+	}
+	return 1500000
+}()
+
+// hzShrinkCycles bounds the alternation past the budget.
+const hzShrinkCycles = 100
+
+// hzShrinkAttempts is the failing judgements the budget allows for a first failure of n
+// bytes.
+func hzShrinkAttempts(n int) int {
+	if n < 1 {
+		n = 1
+	}
+	b := hzShrinkBudget / n
+	if b < 100 {
+		return 100
+	}
+	if b > 3000 {
+		return 3000
+	}
+	return b
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// observe records a message of a class that is not a failure (a replica disagreement):
+// counted, and its first two messages kept.
+func (c *hzCollector) observe(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept; otherwise it is fatal, within the shrink budget.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	c.mu.Lock()
+	if c.fails == 0 && hzShrinkBudget > 0 {
+		c.budget = hzShrinkAttempts(len(msg))
+	}
+	if c.budget > 0 && c.fails >= c.budget {
+		// past the budget: the attempt that drew is the engine's replay of the last failure
+		// (the undrawn rejection before it ended the shrink) and prints as usual; were it a
+		// shrink attempt instead, the next attempt is rejected before drawing again
+		c.armed = true
+		c.counts["budget replayed"]++
+		c.mu.Unlock()
+		ht.Fatalf("%s", msg)
+	}
+	c.fails++
+	if c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+	ht.Fatalf("%s", msg)
+}
+
+// skip is whether the attempt is to be rejected before it draws (the budget spent and the
+// previous attempt drawn); past hzShrinkCycles, always.
+func (c *hzCollector) skip() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.budget == 0 || c.fails < c.budget {
+		return false
+	}
+	if c.cycles >= hzShrinkCycles {
+		c.counts["budget exhausted"]++
+		return true
+	}
+	if !c.armed {
+		return false
+	}
+	c.armed = false
+	c.cycles++
+	c.counts["budget skipped"]++
+	return true
+}
+
+// rearm: an attempt past the budget that drew and did not fail arms the next.
+func (c *hzCollector) rearm() {
+	c.mu.Lock()
+	if c.budget > 0 && c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the constants below
+// (the index of a switch is the bug's id minus one: hzKnownID(i) = "mergo/<i+1>"; the bugs
+// the model does not reach by a drawn ingredient have no constant and their switches stay
+// unused, kept so that the second part can fill them in without renumbering). The replicas
+// (hegel_zoo_model_test.go) are pure functions of (case, known): with every switch off
+// (hzKnownNone) they state the documented behaviour (the README, the options' documentation)
+// and are what the properties judge the library against; with a switch on they reproduce
+// that bug as a replica of the library's rule, transcribed from the source at the point named
+// beside the switch. The classifier runs the model with several sets to name the shape of a
+// case before the library's answers are judged; the pins assert the documented behaviour and
+// fail while the bug exists.
+type known [20]bool
+
+const (
+	// mergo/1: Merge and Map panic on a typed nil pointer source instead of returning ErrNilArguments (mergo.go resolveValues :77-79 dereferences a pointer source without checking it, "vSrc = vSrc.Elem()" is the zero Value; merge.go :392 "vDst.Type() != vSrc.Type()" asks it for its type; map.go _map :162-176 asks it for its Kind, Invalid, and falls to "default: return ErrNotSupported": Map returns that error, Merge panics)
+	kNilPointerSourcePanics = 0
+	// mergo/2: WithOverwriteWithEmptyValue panics on a non-nil unexported map field (merge.go :93-94 visits every field, "deepMerge(dst.Field(i), src.Field(i)"; the Map case returns on a nil destination map it cannot set :104-110, skips every entry it cannot interface :136, and the loop :217-223 "Ensure that all keys in dst are deleted if they are not in src" calls dst.SetMapIndex on the unexported map for a key the source lacks)
+	kUnexportedMapPanics = 1
+	// mergo/3: Map into a struct panics when a value has the kind of its field but another type (map.go :101 "if srcKind == dstKind" hands the value to deepMerge, which sets it as it is: reflect.Set :100, :230, :264, :274, :304, Field :94 by position on a struct of another type, SetMapIndex :130, :195, :212 and IsNil :160 on a map of another type)
+	kMapKindNotTypePanics = 2
+	// mergo/4: Map into a nil map[string]interface{} destination panics (map.go :52 "dstMap := dst.Interface().(map[string]interface{})", :62 "dstMap[fieldName] = src.Field(i).Interface()" into the nil map)
+	kNilMapDestinationPanics = 3
+	// mergo/5: Map panics on a typed nil pointer value for a non-pointer field (map.go :86-88 "srcElement = srcElement.Elem(); srcKind = reflect.TypeOf(srcElement.Interface()).Kind()" on the zero Value, the interface field included)
+	kTypedNilValuePanics = 4
+	// mergo/6: WithSliceDeepCopy merges no slice element that is not a pointer or a map (merge.go Slice case :240-246 and the slice branch of the Map case :182-187 merge reflect.ValueOf(element.Interface()) copies, which only a pointer or a map target can change)
+	kSliceDeepCopyPointersOnly = 5
+	// mergo/7: an array is never an empty value, so a zero array field is never filled and a zero source array overrides (mergo.go isEmptyValue: Array by Len() == 0)
+	kArraysNeverEmpty = 6
+	// mergo/8: WithoutDereference with WithOverride leaves a pointer to a struct untouched (merge.go :272 "else if src.Elem().Kind() != reflect.Struct")
+	kNoDerefStructPointer = 7
+	// mergo/9: Map into a non-nil interface field fails with ErrDifferentArgumentsTypes when the dynamic types differ (merge.go :282)
+	kIfaceMismatchError = 8
+	// mergo/10: Map into a struct removes map entries and pointers that the source map lacks (map.go :75 sets config.overwriteWithEmptyValue = true for every key)
+	kMapForcesEmptyOverwrite = 9
+	// mergo/11: Map panics on a map destination that is not a map[string]interface{} (map.go :52 "dst.Interface().(map[string]interface{})" asserts the type)
+	kTypedMapDestinationPanics = 10
+	// mergo/12: WithOverride on a map of interfaces merges into the replaced pointer's target before replacing it (merge.go :140-153 merge the entries' dynamic values, through the pointers of a pointer entry and of the pointer fields of a struct entry, :208-212 then replace the entry, "srcElement.Kind() != reflect.Ptr && overwrite")
+	kReplacedPointerMerged = 11
+	// mergo/13: Map panics on a key naming a promoted field when the embedded pointer is nil (map.go :78 "dstElement := dst.FieldByName(fieldName)" follows the nil pointer)
+	kNilEmbeddedPointerPanics = 12
+	// mergo/14: Map panics on a map source that is not a map[string]interface{} (map.go :73 "srcMap := src.Interface().(map[string]interface{})" asserts the type)
+	kTypedMapSourcePanics = 13
+	// mergo/15: a nil slice, map or interface entry of the source map overrides under WithOverride alone; a nil pointer entry never does (merge.go :127-133, and :208 "srcElement.Kind() != reflect.Ptr")
+	kNilMapEntries = 14
+	// mergo/16: WithOverride replaces a struct without exported fields (time.Time) with a zero source value (merge.go :99 "!isEmptyValue(src)" is true of every struct)
+	kZeroStructOverrides = 15
+	// mergo/17: WithSliceDeepCopy panics on []interface{} elements of different kinds (merge.go :94 reads src.Field(i) of a non-struct, :104 asks src.IsNil() of a non-nilable, on the dynamic values of the elements and of map entries)
+	kDeepCopyKindPanic = 16
+	// mergo/18: Merge panics when interface entries hold maps of different types (merge.go :144-153 merge two map entries whenever both dynamic values are maps, with no type check; the Map case then inserts the source's entries, :212 "dst.SetMapIndex(key, srcElement)", which reflect refuses when the entry's static type is not assignable to the destination's element type, and keeps the merged entry, :203)
+	kTypedMapsInInterfacesPanic = 17
+	// mergo/19: WithoutDereference with WithOverride panics on pointer entries of maps and slices of interfaces (merge.go :274 dst.Set(src) without CanSet on an unaddressable entry)
+	kNoDerefUnaddressablePanic = 18
+	// mergo/20: WithSliceDeepCopy panics when a map-of-interfaces entry holds a slice in the source and a scalar, struct, pointer or non-empty map in the destination (merge.go :163 takes the entry as it is, :178 calls Len on it, :180 Index)
+	kDeepCopyEntryPanic = 19
+	hzKnownCount        = 20
+)
+
+// hzKnownRead are the switches the model reads, in bug order (every recorded bug since the
+// second part): the classifier sweeps these.
+var hzKnownRead = []int{
+	kNilPointerSourcePanics, kUnexportedMapPanics, kMapKindNotTypePanics, kNilMapDestinationPanics,
+	kTypedNilValuePanics, kSliceDeepCopyPointersOnly, kArraysNeverEmpty, kNoDerefStructPointer,
+	kIfaceMismatchError, kMapForcesEmptyOverwrite, kTypedMapDestinationPanics, kReplacedPointerMerged,
+	kNilEmbeddedPointerPanics, kTypedMapSourcePanics, kNilMapEntries, kZeroStructOverrides,
+	kDeepCopyKindPanic, kTypedMapsInInterfacesPanic, kNoDerefUnaddressablePanic, kDeepCopyEntryPanic,
+}
+
+// hzKnownID is the bug id of a switch ("mergo/N"); hzKnownIndex the switch of a bug id (-1
+// for none or the hole).
+func hzKnownID(i int) string { return "mergo/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "mergo/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for _, i := range hzKnownRead {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape mergo/N"
+// per case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape hole"), the cases skipped for them under HEGEL_NO_KNOWN=1 ("known
+// mergo/N"), the draws the filters rejected ("filtered <name>"), the replica's agreement with
+// the library on the shaped cases ("replica agreement", "replica disagreement"), the
+// properties' own tallies of what their cases reached (the rates of the report), and the
+// cases assumed away for an unrecorded candidate bug ("candidate/go/mergo-N"); printed and
+// reset by the collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi, go/go-debian, go/gin, go/cellbuf, go/kong and
+// go/roaring judge, with the collector's mismatch classes): it names the recorded bug whose
+// shape the case has, so that a mismatch or a library panic fails "(the shape of mergo/N)",
+// and under HEGEL_NO_KNOWN=1 skips the case instead (counted as known) or drops the checks
+// the shape covers (Dropped). The wide and the narrow properties share their judge functions
+// and so this. The classifier that names the shape is computed from the case record alone
+// (the model run with several sets of switches).
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the regions past the shapes
+// are drawn, or the shaped cases filtered out), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped mergo/N") and the case goes on
+// (judgeByDropping; no property of this target needs it, the form is kept with the harness).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow). The properties catch the panics of the library's calls
+// themselves (hzCall) into the outcome "panic" so that they are judged like any other value;
+// this is the net under everything else.
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	if !hzCollecting {
+		// The narrow properties fail by design and each shrinks its failure; run them two at
+		// a time (go test's -parallel, the CPU count). In collect mode they run one after the
+		// other, the judge's counters being global.
+		t.Parallel()
+	}
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		if col.skip() {
+			ht.Assume(false)
+		}
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+		col.rearm()
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (the go/carbon, go/orb, go/chi, go/go-debian, go/gin, go/cellbuf, go/kong and
+// go/roaring form: every value here is text; the outcome of a call is compared as a set, the
+// rest exactly).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole set for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two. The checks of this target: "outcome" (the
+// model's: "ok", "error {text | text}", "panic", "panic or error {text}"; the library's:
+// "ok", "error: text", "panic"), "result" (the destination as canon prints it, stated only
+// when the outcome is ok), "handles" (the targets of every pointer held in the destination
+// before the merge, read after it, by path: a target changes only where the merge went
+// through it, mergo/12) and "private" (the unexported maps of every Inner in the result, by
+// path: never merged, mergo/2), both stated with the result, and the laws' "source", "second"
+// and "idempotent".
+type checks map[string]string
+
+func (c checks) set(name string, v any) { c[name] = fmt.Sprint(v) }
+
+// add merges the checks of a part of a case under a prefix ("<prefix> <name>").
+func (c checks) add(prefix string, part checks) {
+	for k, v := range part {
+		c[prefix+" "+k] = v
+	}
+}
+
+// checkOrder is the order the checks of a case are reported in when it fails: the outcome
+// first, the result last.
+var checkOrder = map[string]int{
+	"outcome": 0, "source": 1, "second": 2, "idempotent": 3, "result": 4, "handles": 5, "private": 6,
+}
+
+func checkLess(a, b string) bool {
+	ap, an := splitCheck(a)
+	bp, bn := splitCheck(b)
+	if ap != bp {
+		return ap < bp
+	}
+	ar, aok := checkOrder[an]
+	br, bok := checkOrder[bn]
+	if aok && bok && ar != br {
+		return ar < br
+	}
+	if aok != bok {
+		return aok
+	}
+	return an < bn
+}
+
+// splitCheck is the prefix and the last word of a check name.
+func splitCheck(name string) (string, string) {
+	if i := strings.LastIndexByte(name, ' '); i > 0 {
+		return name[:i], name[i+1:]
+	}
+	return "", name
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two model statements agree: the same checks, each value equal
+// (the classifier's comparison).
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeValue reports whether the library's value of a check agrees with a model's: an
+// outcome by membership (the model states the set of errors the merge can hit and whether it
+// reaches a crash, the library stops at the first error in map order), anything else by text.
+func agreeValue(name, got, want string) bool {
+	if _, last := splitCheck(name); last != "outcome" {
+		return got == want
+	}
+	return outcomeAgrees(got, want)
+}
+
+// outcomeAgrees: the library's outcome ("ok", "error: text", "panic") against the model's
+// ("ok", "error {a | b}", "panic", "panic or error {a | b}"): a panic where none is predicted
+// fails, no panic where one is predicted and no error is possible fails, an error outside
+// the set fails, an error where none is predicted fails.
+func outcomeAgrees(got, want string) bool {
+	if got == want {
+		return true
+	}
+	if got == "panic" {
+		return strings.HasPrefix(want, "panic")
+	}
+	if strings.HasPrefix(got, "error: ") {
+		set := want
+		if i := strings.Index(set, "error {"); i >= 0 {
+			set = set[i+len("error {") : len(set)-1]
+		} else {
+			return false
+		}
+		text := strings.TrimPrefix(got, "error: ")
+		for _, e := range strings.Split(set, " | ") {
+			if e == text {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// agreeChecks reports whether the library's values agree with a model's: the same checks,
+// each by agreeValue.
+func agreeChecks(got, want checks) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for k, v := range want {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, v) {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order; the long values (a result) are cut, the explanation of a case shows the path.
+func diffChecks(a, b checks) string {
+	var parts []string
+	cut := func(s string) string {
+		if len(s) > 200 {
+			return s[:200] + "..."
+		}
+		return s
+	}
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || !agreeValue(k, a[k], w) {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, cut(a[k])))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, cut(a[k]), cut(w)))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, cut(b[k])))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("mergo/?", a defect of the model). The
+// order matters where two shapes meet (a []interface{} of elements of different kinds under
+// WithSliceDeepCopy meets mergo/6 and mergo/17, the crash being inside the copies; a zero
+// array beside a zero time under WithOverride mergo/7 and mergo/16): sufficiency in bug order
+// names the lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "mergo/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule.
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// classOf is the collector class of a check name: the name's first word.
+func classOf(name string) string {
+	if i := strings.IndexByte(name, ' '); i > 0 {
+		return name[:i]
+	}
+	return name
+}
+
+// explainer is a case record that explains a failure in its own terms (the root type, the
+// options, the path of the first difference, the source, the wanted and the got values, as
+// the properties always printed them); the verdict appends it.
+type explainer interface {
+	explain(got, want checks) string
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agreeChecks(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.observe("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if agreeChecks(got, want) {
+		if shape != "" {
+			// named by the classifier but passing: the model's statements differ on the
+			// outcome's error set only, which the library's one error agrees with both of
+			hzTally("shaped pass")
+			j.col.observe("shaped pass", "%s against %s for\n%#v", diffChecks(expected(c, hzKnownAll), want), shape, c)
+		}
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, want[k]) {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	more := ""
+	if e, ok := any(c).(explainer); ok {
+		more = e.explain(got, want)
+	}
+	j.Fail(classOf(class), "%s for\n%#v%s", diffChecks(got, want), c, more)
+}
+
+// memoized is expected remembering its statements by switch set for one case (the
+// classifier and the verdict ask for the documented and the full replica statements more
+// than once; a known value is a comparable array).
+func memoized[T any](expected func(T, known) checks) func(T, known) checks {
+	memo := map[known]checks{}
+	return func(c T, k known) checks {
+		if out, ok := memo[k]; ok {
+			return out
+		}
+		out := expected(c, k)
+		memo[k] = out
+		return out
+	}
+}
+
+// judgeBy is the judge of a family: the shape first, then the library (every property here:
+// the case is one shape, skipped whole under HEGEL_NO_KNOWN=1 where the generators let one
+// through). The case is passed by pointer: actual records on it what the library left (the
+// explanation of a failure) and may be called more than once (observeLibrary).
+func judgeBy[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks) {
+	expected = memoized(expected)
+	got, want := observeLibrary(c, expected, actual), expected(*c, hzKnownNone)
+	if documented(got, want) {
+		return
+	}
+	shape := classify(*c, expected)
+	j.Shape(shape)
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// hzOrders bounds the library calls on one case whose outcome depends on the order the
+// library meets the keys of a map in.
+const hzOrders = 64
+
+// observeLibrary is the library's checks for the case: one call; or, where the replica (every
+// switch on) states an outcome of several alternatives that the documented statement does
+// not state the same (an error on one key and a panic or another error on another, the
+// first key met deciding; the library meets the keys of a map in Go's map order, different
+// at every call), up to hzOrders calls on fresh copies until one disagrees with the
+// documented statement (counted "order retried"). The documented statement holds on every
+// order or not at all, and a judgement that changed with the order would be nondeterministic
+// to the engine, which then reports the failure without a message or a shrink (measured on
+// the Map model before this: a Map into Inner with a Leaf under "emb" and a string under
+// "mL" passed or failed by the key the package met first, and a fourth of the runs at that
+// seed ended so).
+func observeLibrary[T any](c *T, expected func(T, known) checks, actual func(*T) checks) checks {
+	got := actual(c)
+	want := expected(*c, hzKnownNone)
+	if !severalOutcomes(expected(*c, hzKnownAll), want) {
+		return got
+	}
+	for i := 1; i < hzOrders && agreeChecks(restrict(got, want), want); i++ {
+		hzTally("order retried")
+		got = actual(c)
+	}
+	return got
+}
+
+// severalOutcomes reports a check the replica states with several alternatives ("panic or
+// error {...}", "error {a | b}") and the documented statement states otherwise.
+func severalOutcomes(replica, want checks) bool {
+	for name, r := range replica {
+		if r != want[name] && (strings.HasPrefix(r, "panic or error") || strings.Contains(r, " | ")) {
+			return true
+		}
+	}
+	return false
+}
+
+// documented reports, by default and outside collect mode, that the library's values are
+// the documented ones: the case passes and there is no shape to name, so the classifier
+// (several model runs) is not run beyond the replica run observeLibrary needs; under
+// HEGEL_NO_KNOWN=1 the shape is needed first (a case is skipped or its checks dropped
+// before the comparison), and in collect mode the counts are. The shrinking of a failure
+// replays mostly passing cases, which this keeps cheap.
+func documented(got, want checks) bool {
+	return !hzNoKnown && !hzCollecting && agreeChecks(restrict(got, want), want)
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi, go/go-debian and go/roaring form; no property here
+// needs it, the wide ones filter their generators instead): by default the shape is named and
+// every check judged; under HEGEL_NO_KNOWN=1 the checks the shapes cover (those on which the
+// replica with every switch on differs from the documented model, or which it does not state)
+// are dropped from the case (hzCaseJudge.Dropped, counted "dropped mergo/N") and the rest
+// judged, the case not skipped.
+func judgeByDropping[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks) {
+	expected = memoized(expected)
+	got, want := observeLibrary(c, expected, actual), expected(*c, hzKnownNone)
+	if documented(got, want) {
+		return
+	}
+	shape := classify(*c, expected)
+	if shape != "" && j.Dropped(shape) {
+		all := expected(*c, hzKnownAll)
+		kept := checks{}
+		for name, v := range want {
+			if w, ok := all[name]; ok && w == v {
+				kept[name] = v
+			}
+		}
+		want = kept
+		verdict(j, *c, got, want, "", expected)
+		return
+	}
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few model runs. The
+// rejections are also counted by the shape the case had ("filtered <id> as <shape>", "as
+// none" for no shape), which says what the surroundings bring in.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool {
+		got := shapeID(c, expected)
+		if got == want {
+			return true
+		}
+		if got == "" {
+			got = "none"
+		}
+		hzTally("filtered " + id + " as " + got)
+		return false
+	})
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered mergo/N" by the shape it had), g itself otherwise: the
+// wide properties' filter, their shapes being a property of the record alone, so that a case
+// with a known shape is drawn again rather than skipped.
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCall runs a library call and returns its error and what it panicked with (nil when it
+// returned): the properties turn both into the outcome check.
+func hzCall(f func() error) (err error, panicked any) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	return f(), nil
+}
+
+// outcomeOf is the library's outcome check value.
+func outcomeOf(err error, panicked any) string {
+	switch {
+	case panicked != nil:
+		return "panic"
+	case err != nil:
+		return "error: " + err.Error()
+	}
+	return "ok"
+}
+
+// --------------------------------------------------------------------------- comparison
+
+// same compares two values of one type structurally: nil and empty slices and maps alike,
+// interfaces by dynamic type and value, times by Equal, unexported fields ignored, pointers by
+// their targets.
+func same(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	if a.Type() == timeType {
+		return a.Interface().(time.Time).Equal(b.Interface().(time.Time))
+	}
+	switch a.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() && b.IsNil()
+		}
+		return same(a.Elem(), b.Elem())
+	case reflect.Slice:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Array:
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for _, k := range a.MapKeys() {
+			bv := b.MapIndex(k)
+			if !bv.IsValid() || !same(a.MapIndex(k), bv) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			if a.Type().Field(i).PkgPath != "" {
+				continue
+			}
+			if !same(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Float32, reflect.Float64:
+		return a.Float() == b.Float() || (a.Float() != a.Float() && b.Float() != b.Float())
+	case reflect.String:
+		return a.String() == b.String()
+	case reflect.Bool:
+		return a.Bool() == b.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return a.Int() == b.Int()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return a.Uint() == b.Uint()
+	}
+	panic("same: " + a.Type().String())
+}
+
+// diffPath is the path of the first difference between a and b (as same() sees them), with
+// both values there; "" when they are the same.
+func diffPath(a, b reflect.Value, path string) string {
+	if path == "" {
+		path = "root"
+	}
+	if a.Type() != b.Type() {
+		return fmt.Sprintf("%s: types %s and %s", path, a.Type(), b.Type())
+	}
+	leaf := func() string { return fmt.Sprintf("%s: want %s, got %s", path, show(a), show(b)) }
+	if a.Type() == timeType {
+		if !a.Interface().(time.Time).Equal(b.Interface().(time.Time)) {
+			return leaf()
+		}
+		return ""
+	}
+	switch a.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			if a.IsNil() && b.IsNil() {
+				return ""
+			}
+			return leaf()
+		}
+		if a.Kind() == reflect.Interface && a.Elem().Type() != b.Elem().Type() {
+			return leaf()
+		}
+		return diffPath(a.Elem(), b.Elem(), path)
+	case reflect.Slice, reflect.Array:
+		if a.Len() != b.Len() {
+			return leaf()
+		}
+		for i := 0; i < a.Len(); i++ {
+			if d := diffPath(a.Index(i), b.Index(i), fmt.Sprintf("%s[%d]", path, i)); d != "" {
+				return d
+			}
+		}
+		return ""
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return leaf()
+		}
+		for _, k := range a.MapKeys() {
+			bv := b.MapIndex(k)
+			if !bv.IsValid() {
+				return leaf()
+			}
+			if d := diffPath(a.MapIndex(k), bv, fmt.Sprintf("%s[%v]", path, k)); d != "" {
+				return d
+			}
+		}
+		return ""
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			f := a.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			if d := diffPath(a.Field(i), b.Field(i), path+"."+f.Name); d != "" {
+				return d
+			}
+		}
+		return ""
+	}
+	if !same(a, b) {
+		return leaf()
+	}
+	return ""
+}
+
+// show prints a value for a failure message, pointers by their targets.
+func show(v reflect.Value) string {
+	var sb strings.Builder
+	showTo(&sb, v, 0)
+	s := sb.String()
+	if len(s) > 2500 {
+		s = s[:2500] + "..."
+	}
+	return s
+}
+
+func showTo(sb *strings.Builder, v reflect.Value, depth int) {
+	if depth > 8 {
+		sb.WriteString("...")
+		return
+	}
+	if v.Type() == timeType {
+		fmt.Fprintf(sb, "%v", v.Interface())
+		return
+	}
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		sb.WriteString("&")
+		showTo(sb, v.Elem(), depth+1)
+	case reflect.Interface:
+		if v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		fmt.Fprintf(sb, "%s(", v.Elem().Type())
+		showTo(sb, v.Elem(), depth+1)
+		sb.WriteString(")")
+	case reflect.Slice, reflect.Array:
+		if v.Kind() == reflect.Slice && v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		sb.WriteString("[")
+		for i := 0; i < v.Len(); i++ {
+			if i > 0 {
+				sb.WriteString(" ")
+			}
+			showTo(sb, v.Index(i), depth+1)
+		}
+		sb.WriteString("]")
+	case reflect.Map:
+		if v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		keys := v.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return fmt.Sprint(keys[i]) < fmt.Sprint(keys[j]) })
+		sb.WriteString("{")
+		for i, k := range keys {
+			if i > 0 {
+				sb.WriteString(" ")
+			}
+			fmt.Fprintf(sb, "%v:", k)
+			showTo(sb, v.MapIndex(k), depth+1)
+		}
+		sb.WriteString("}")
+	case reflect.Struct:
+		sb.WriteString("{")
+		first := true
+		for i := 0; i < v.NumField(); i++ {
+			f := v.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			if !first {
+				sb.WriteString(" ")
+			}
+			first = false
+			sb.WriteString(f.Name + ":")
+			showTo(sb, v.Field(i), depth+1)
+		}
+		sb.WriteString("}")
+	case reflect.String:
+		fmt.Fprintf(sb, "%q", v.String())
+	default:
+		fmt.Fprintf(sb, "%v", v.Interface())
+	}
+}
+
+// canon prints a value as the text of its structure under same(): two values print alike
+// exactly when same() holds (nil and empty slices and maps alike, times by instant, floats
+// with -0 as 0 and every NaN alike, interfaces by dynamic type and value, unexported fields
+// left out, pointers by their targets, map keys sorted), uncut; the "result" check compares
+// these, and a failure shows the path of the first difference (diffPath) on the values.
+func canon(v reflect.Value) string {
+	var sb strings.Builder
+	canonTo(&sb, v)
+	return sb.String()
+}
+
+func canonTo(sb *strings.Builder, v reflect.Value) {
+	if v.Type() == timeType {
+		fmt.Fprintf(sb, "%d", v.Interface().(time.Time).UnixNano())
+		return
+	}
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		sb.WriteString("&")
+		canonTo(sb, v.Elem())
+	case reflect.Interface:
+		if v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		fmt.Fprintf(sb, "%s(", v.Elem().Type())
+		canonTo(sb, v.Elem())
+		sb.WriteString(")")
+	case reflect.Slice, reflect.Array:
+		sb.WriteString("[")
+		for i := 0; i < v.Len(); i++ {
+			if i > 0 {
+				sb.WriteString(" ")
+			}
+			canonTo(sb, v.Index(i))
+		}
+		sb.WriteString("]")
+	case reflect.Map:
+		keys := v.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return fmt.Sprint(keys[i]) < fmt.Sprint(keys[j]) })
+		sb.WriteString("{")
+		for i, k := range keys {
+			if i > 0 {
+				sb.WriteString(" ")
+			}
+			fmt.Fprintf(sb, "%q:", fmt.Sprint(k))
+			canonTo(sb, v.MapIndex(k))
+		}
+		sb.WriteString("}")
+	case reflect.Struct:
+		sb.WriteString("{")
+		first := true
+		for i := 0; i < v.NumField(); i++ {
+			f := v.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			if !first {
+				sb.WriteString(" ")
+			}
+			first = false
+			sb.WriteString(f.Name + ":")
+			canonTo(sb, v.Field(i))
+		}
+		sb.WriteString("}")
+	case reflect.String:
+		fmt.Fprintf(sb, "%q", v.String())
+	case reflect.Float32, reflect.Float64:
+		f := v.Float()
+		if f == 0 {
+			f = 0 // -0 prints as 0
+		}
+		fmt.Fprintf(sb, "%v", f)
+	default:
+		fmt.Fprintf(sb, "%v", v.Interface())
+	}
+}
+
+// --------------------------------------------------------------------------- observations
+
+// handle is a non-nil pointer held somewhere in a value, with its path: the "handles" check
+// collects the destination's before a merge (handlesOf) and shows their targets after it
+// (showHandles), so that a merge into a target the merge then discards (mergo/12: the
+// replaced entry's pointer, the pointer fields of a replaced struct entry) is observed where
+// the result cannot show it. Every pointer counts (struct fields, map entries, slice
+// elements, the values of interfaces); the documented statement is what the documented model
+// leaves them, which is merged through where the merge is documented to go through pointers.
+type handle struct {
+	path string
+	ptr  reflect.Value
+}
+
+func handlesOf(v reflect.Value) []handle {
+	var hs []handle
+	collectHandles(&hs, v, "root")
+	return hs
+}
+
+func collectHandles(hs *[]handle, v reflect.Value, path string) {
+	if !v.IsValid() || v.Type() == timeType {
+		return
+	}
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			return
+		}
+		// the pointer itself (a copy), not the slot holding it: the merge may set the slot
+		// to another pointer or nil, and the handle is what the caller held before
+		*hs = append(*hs, handle{path, reflect.ValueOf(v.Interface())})
+		collectHandles(hs, v.Elem(), path)
+	case reflect.Interface:
+		if !v.IsNil() {
+			collectHandles(hs, v.Elem(), path)
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			collectHandles(hs, v.Index(i), fmt.Sprintf("%s[%d]", path, i))
+		}
+	case reflect.Map:
+		keys := v.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return fmt.Sprint(keys[i]) < fmt.Sprint(keys[j]) })
+		for _, k := range keys {
+			collectHandles(hs, v.MapIndex(k), fmt.Sprintf("%s[%v]", path, k))
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			f := v.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			collectHandles(hs, v.Field(i), path+"."+f.Name)
+		}
+	}
+}
+
+// showHandles is the targets of the handles now, "path=target" per handle.
+func showHandles(hs []handle) string {
+	parts := make([]string, len(hs))
+	for i, h := range hs {
+		parts[i] = h.path + "=" + show(h.ptr.Elem())
+	}
+	return strings.Join(parts, "; ")
+}
+
+// privateOf is the unexported map pm of every Inner reached in a value, "path=map" per
+// Inner (the "private" check: the README says "Mergo won't merge unexported (private) fields",
+// so the maps are those of the values the merge moved, never merged; mergo/2 crashes on
+// them instead). The map is read through the type (reflect refuses Interface on an
+// unexported field); same, canon and show keep ignoring unexported fields.
+func privateOf(v reflect.Value) string {
+	var parts []string
+	collectPrivate(&parts, v, "root")
+	return strings.Join(parts, "; ")
+}
+
+func collectPrivate(parts *[]string, v reflect.Value, path string) {
+	if !v.IsValid() || v.Type() == timeType {
+		return
+	}
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		if !v.IsNil() {
+			collectPrivate(parts, v.Elem(), path)
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			collectPrivate(parts, v.Index(i), fmt.Sprintf("%s[%d]", path, i))
+		}
+	case reflect.Map:
+		keys := v.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return fmt.Sprint(keys[i]) < fmt.Sprint(keys[j]) })
+		for _, k := range keys {
+			collectPrivate(parts, v.MapIndex(k), fmt.Sprintf("%s[%v]", path, k))
+		}
+	case reflect.Struct:
+		if v.Type() == innerType {
+			*parts = append(*parts, path+"="+showPrivate(privateMapOf(v)))
+		}
+		for i := 0; i < v.NumField(); i++ {
+			f := v.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			collectPrivate(parts, v.Field(i), path+"."+f.Name)
+		}
+	}
+}
+
+// privateMapOf is Inner's pm, read through the type.
+func privateMapOf(v reflect.Value) map[string]int { return v.Interface().(Inner).pm }
+
+func showPrivate(m map[string]int) string {
+	if m == nil {
+		return "nil"
+	}
+	return fmt.Sprint(m) // fmt sorts the keys
+}
