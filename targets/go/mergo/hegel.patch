+			}
+			src := reflect.New(anyMapT).Elem()
+			src.Set(reflect.MakeMap(anyMapT))
+			src.SetMapIndex(key, boxAnyValue(hegel.Draw(tc, sg)))
+			return mergeCase{rt: anyMapT, o: o, dst: dst, src: src}
