diff --git a/hegel/hegel_map_test.go b/hegel/hegel_map_test.go
new file mode 100644
index 0000000..5227ad0
--- /dev/null
+++ b/hegel/hegel_map_test.go
@@ -0,0 +1,299 @@
+package hegel
+
+import (
+	"reflect"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"dario.cat/mergo"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- Map model
+//
+// map.go: "Map sets fields' values in dst from src. src can be a map with string keys or a
+// struct. dst must be the opposite: if src is a map, dst must be a valid pointer to struct. If
+// src is a struct, dst must be map[string]interface{}. It won't merge unexported (private)
+// fields and will do recursively any exported field. If dst is a map, keys will be src fields'
+// names in lower camel case. Missing key in src that doesn't match a field in dst will be
+// skipped." README: "Keys are capitalized to find each corresponding exported field", "if you
+// map a struct to map, it won't do it recursively ... They will be just assigned as values",
+// and the values follow "the same restrictions as in Merge()".
+
+func changeInitial(s string, mapper func(rune) rune) string {
+	if s == "" {
+		return s
+	}
+	r, n := utf8.DecodeRuneInString(s)
+	return string(mapper(r)) + s[n:]
+}
+
+func lowerFirst(s string) string { return changeInitial(s, unicode.ToLower) }
+func upperFirst(s string) string { return changeInitial(s, unicode.ToUpper) }
+
+// mapInto maps the entries of src (a map[string]interface{}) into the fields of dst (a struct
+// or a pointer to one): a key names the field with its initial capitalised; a value of the
+// field's kind is merged in, a pointer to one is dereferenced first, a nested map maps into a
+// struct field, anything else is a type mismatch error. Other destination kinds take nothing.
+func (m *mm) mapInto(dst, src reflect.Value) {
+	if dst.Kind() == reflect.Pointer {
+		if dst.IsNil() {
+			dst.Set(reflect.New(dst.Type().Elem()))
+		}
+		dst = dst.Elem()
+	}
+	if dst.Kind() != reflect.Struct {
+		return
+	}
+	if Known.mapForcesEmptyOverwrite {
+		m.o.owe = true // and stays so for the rest of the call
+	}
+	for _, key := range src.MapKeys() {
+		name := upperFirst(key.String())
+		f := dst.FieldByName(name)
+		if !f.IsValid() {
+			continue
+		}
+		se := reflect.ValueOf(src.MapIndex(key).Interface())
+		if !se.IsValid() {
+			continue
+		}
+		if se.Kind() == reflect.Pointer && f.Kind() != reflect.Pointer {
+			se = se.Elem()
+		}
+		switch {
+		case se.Kind() == f.Kind(), f.Kind() == reflect.Interface:
+			m.merge(f, se)
+		case se.Kind() == reflect.Map:
+			m.mapInto(f, se)
+		default:
+			m.fail("type mismatch on %s field: found %v, expected %v", name, se.Kind(), f.Kind())
+		}
+	}
+}
+
+// mapFrom sets the exported fields of src (a struct) into dst (a map[string]interface{}) under
+// their names in lower camel case: missing keys are added, present ones replaced with
+// WithOverride when the field is not empty, always with WithOverwriteWithEmptyValue.
+func (m *mm) mapFrom(dst, src reflect.Value) {
+	t := src.Type()
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.PkgPath != "" {
+			continue
+		}
+		key := reflect.ValueOf(lowerFirst(f.Name))
+		fv := src.Field(i)
+		// emptiness is that of the dynamic value (an interface holding a nil slice is empty)
+		if !dst.MapIndex(key).IsValid() || (!m.empty(reflect.ValueOf(fv.Interface())) && m.o.override) || m.o.owe {
+			dst.SetMapIndex(key, fv)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- generators
+
+var junkKeys = []string{"zzz", "Zzz", "", "n2", "nAme"}
+
+// genMapFor makes a map[string]interface{} for the fields of struct type t: values of the
+// field's type mostly, sometimes behind a pointer, a nested map for a struct field, a value of
+// another kind (an error) or nothing; embedded structs appear under their own key or through
+// their promoted fields.
+func genMapFor(tc hegel.TestCase, t reflect.Type, depth int) map[string]interface{} {
+	out := map[string]interface{}{}
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.PkgPath != "" {
+			continue
+		}
+		if f.Anonymous && f.Type.Kind() == reflect.Struct && chance(tc, 50) {
+			for k, v := range genMapFor(tc, f.Type, depth) {
+				out[k] = v
+			}
+			continue
+		}
+		if chance(tc, 15) {
+			continue
+		}
+		key := lowerFirst(f.Name)
+		ft := f.Type
+		if ft != anyType && chance(tc, 3) {
+			// a value of another kind: a type mismatch error (a struct for a pointer too)
+			switch {
+			case ft.Kind() == reflect.String:
+				out[key] = drawInt(tc, 0, 3)
+			case ft.Kind() == reflect.Pointer && ft.Elem() != timeType && chance(tc, 50):
+				out[key] = genValue(tc, ft.Elem(), depth).Interface()
+			default:
+				out[key] = "x"
+			}
+			continue
+		}
+		switch {
+		case ft == timeType:
+			out[key] = genValue(tc, ft, depth).Interface()
+		case ft == anyType:
+			v := genAny(tc, depth)
+			if v.IsNil() || (v.Elem().Kind() == reflect.Pointer && v.Elem().IsNil()) {
+				out[key] = nil // a typed nil pointer would be dereferenced (bug 5)
+			} else {
+				out[key] = v.Interface()
+			}
+		case ft.Kind() == reflect.Struct:
+			if chance(tc, 45) {
+				out[key] = genMapFor(tc, ft, depth-1)
+			} else {
+				out[key] = genValue(tc, ft, depth).Interface()
+			}
+		case ft.Kind() == reflect.Pointer && ft.Elem().Kind() == reflect.Struct && ft.Elem() != timeType:
+			switch drawInt(tc, 0, 9) {
+			case 0, 1, 2, 3:
+				out[key] = genMapFor(tc, ft.Elem(), depth-1)
+			case 4:
+				out[key] = nil
+			default:
+				out[key] = genValue(tc, ft, depth).Interface()
+			}
+		case ft.Kind() == reflect.Pointer:
+			if chance(tc, 10) {
+				out[key] = nil
+			} else {
+				out[key] = genValue(tc, ft, depth).Interface()
+			}
+		case ft.Kind() == reflect.Map, ft.Kind() == reflect.Slice, ft.Kind() == reflect.Array:
+			if chance(tc, 10) {
+				out[key] = nil
+			} else {
+				out[key] = genValue(tc, ft, depth).Interface()
+			}
+		default: // scalars, sometimes behind a pointer
+			switch drawInt(tc, 0, 9) {
+			case 0:
+				out[key] = nil
+			case 1, 2:
+				p := reflect.New(ft)
+				p.Elem().Set(genValue(tc, ft, depth))
+				out[key] = p.Interface()
+			default:
+				out[key] = genValue(tc, ft, depth).Interface()
+			}
+		}
+	}
+	if chance(tc, 20) {
+		out[pick(tc, junkKeys)] = drawInt(tc, 0, 2)
+	}
+	return out
+}
+
+// mapStructTypes are the struct types mapped from and into maps.
+var mapStructTypes = []reflect.Type{leafType, innerType, innerType, outerType, outerType, reflect.TypeOf(Emb{})}
+
+// TestHegelMapModel: Map does what the documented model says, in both directions.
+func TestHegelMapModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		o.deprecated = false
+		st := pick(ht, mapStructTypes)
+		if chance(ht, 50) {
+			// map -> struct
+			dst := genRoot(ht, st)
+			if chance(ht, 30) {
+				dst.Set(reflect.Zero(st))
+			}
+			src := genMapFor(ht, st, 2)
+			want := deepCopy(dst)
+			m := &mm{o: o}
+			m.mapInto(want, deepCopy(reflect.ValueOf(src)))
+			for _, e := range m.errs {
+				if e == mergo.ErrDifferentArgumentsTypes.Error() {
+					c.count("into: interface mismatch")
+				}
+			}
+			var srcArg interface{} = src
+			if chance(ht, 20) {
+				srcArg = &src
+			}
+			err, panicked := call(func() error {
+				if o.override && chance(ht, 20) {
+					return mergo.MapWithOverwrite(dst.Addr().Interface(), srcArg, o.funcs()...)
+				}
+				return mergo.Map(dst.Addr().Interface(), srcArg, o.funcs()...)
+			})
+			if panicked != nil {
+				if m.panics {
+					c.count("into: panic (recorded)")
+					return
+				}
+				c.failClass(ht, "into: panic", "Map(*%s, map) under %s panicked: %v\n  dst %s\n  src %s", st, o, panicked, show(want), show(reflect.ValueOf(src)))
+				return
+			}
+			if m.panics && (len(m.errs) == 0 || err == nil) {
+				// an error met first (in map order) stops the mapping before the crash
+				c.failClass(ht, "into: no panic", "Map(*%s, map) under %s did not panic where the recorded bug does (%s)\n  dst %s\n  src %s", st, o, m.why, show(want), show(reflect.ValueOf(src)))
+				return
+			}
+			if len(m.errs) > 0 {
+				c.count("into: error")
+				if err == nil {
+					c.failClass(ht, "into: missing error", "Map(*%s, map) under %s returned no error, want one of %q\n  src %s", st, o, m.errs, show(reflect.ValueOf(src)))
+					return
+				}
+				for _, w := range m.errs {
+					if err.Error() == w {
+						return
+					}
+				}
+				c.failClass(ht, "into: error", "Map(*%s, map) under %s: %v, want one of %q\n  src %s", st, o, err, m.errs, show(reflect.ValueOf(src)))
+				return
+			}
+			if err != nil {
+				c.failClass(ht, "into: unexpected error", "Map(*%s, map) under %s: %v\n  dst %s\n  src %s", st, o, err, show(want), show(reflect.ValueOf(src)))
+				return
+			}
+			c.count("into: " + o.String())
+			if d := diffPath(want, dst, ""); d != "" {
+				c.failClass(ht, "into: result", "Map(*%s, map) under %s: %s\n  src  %s\n  want %s\n  got  %s", st, o, d, show(reflect.ValueOf(src)), show(want), show(dst))
+			}
+			return
+		}
+		// struct -> map
+		src := genRoot(ht, st)
+		dst := reflect.ValueOf(map[string]interface{}{})
+		if chance(ht, 70) {
+			// some of the struct's own keys, holding values of the same or another shape
+			other := genRoot(ht, st)
+			m := &mm{}
+			m.mapFrom(dst, other)
+			for _, k := range dst.MapKeys() {
+				switch drawInt(ht, 0, 3) {
+				case 0:
+					dst.SetMapIndex(k, reflect.Value{})
+				case 1:
+					dst.SetMapIndex(k, reflect.ValueOf(pick(ht, stringAtoms)))
+				}
+			}
+		}
+		if chance(ht, 30) {
+			dst.SetMapIndex(reflect.ValueOf(pick(ht, junkKeys)), reflect.ValueOf(drawInt(ht, 0, 2)))
+		}
+		want := deepCopy(dst)
+		m := &mm{o: o}
+		m.mapFrom(want, deepCopy(src))
+		var srcArg interface{} = src.Interface()
+		if chance(ht, 20) {
+			srcArg = src.Addr().Interface()
+		}
+		dm := dst.Interface().(map[string]interface{})
+		err := mergo.Map(&dm, srcArg, o.funcs()...)
+		if err != nil {
+			c.failClass(ht, "from: unexpected error", "Map(*map, %s) under %s: %v", st, o, err)
+			return
+		}
+		c.count("from: " + o.String())
+		if d := diffPath(want, reflect.ValueOf(dm), ""); d != "" {
+			c.failClass(ht, "from: result", "Map(*map, %s) under %s: %s\n  src  %s\n  want %s\n  got  %s", st, o, d, show(src), show(want), show(reflect.ValueOf(dm)))
+		}
+	})
+}
diff --git a/hegel/hegel_merge_test.go b/hegel/hegel_merge_test.go
new file mode 100644
index 0000000..39af5c5
--- /dev/null
+++ b/hegel/hegel_merge_test.go
@@ -0,0 +1,654 @@
+package hegel
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"dario.cat/mergo"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- options
+
+// opts are the merge options of one test case.
+type opts struct {
+	override     bool // WithOverride: non-empty src attributes override non-empty dst ones
+	owe          bool // WithOverwriteWithEmptyValue: empty src attributes override too (implies override)
+	oes          bool // WithOverrideEmptySlice: an empty src slice overrides
+	noDeref      bool // WithoutDereference: a non-nil pointer is never empty
+	appendSlice  bool // WithAppendSlice
+	typeCheck    bool // WithTypeCheck
+	deepCopy     bool // WithSliceDeepCopy (implies override)
+	transformers bool // WithTransformers: time.Time and Color merged by the transformer
+	deprecated   bool // the entry point is MergeWithOverwrite (override)
+}
+
+func genOpts(tc hegel.TestCase) opts {
+	o := opts{
+		override:     chance(tc, 40),
+		owe:          chance(tc, 15),
+		oes:          chance(tc, 20),
+		noDeref:      chance(tc, 25),
+		appendSlice:  chance(tc, 25),
+		typeCheck:    chance(tc, 20),
+		deepCopy:     chance(tc, 15),
+		transformers: chance(tc, 25),
+		deprecated:   chance(tc, 10),
+	}
+	if o.owe || o.deepCopy || o.deprecated {
+		o.override = true
+	}
+	return o
+}
+
+func (o opts) funcs() []func(*mergo.Config) {
+	var fs []func(*mergo.Config)
+	if o.override && !o.owe && !o.deepCopy && !o.deprecated {
+		fs = append(fs, mergo.WithOverride)
+	}
+	if o.owe {
+		fs = append(fs, mergo.WithOverwriteWithEmptyValue)
+	}
+	if o.oes {
+		fs = append(fs, mergo.WithOverrideEmptySlice)
+	}
+	if o.noDeref {
+		fs = append(fs, mergo.WithoutDereference)
+	}
+	if o.appendSlice {
+		fs = append(fs, mergo.WithAppendSlice)
+	}
+	if o.typeCheck {
+		fs = append(fs, mergo.WithTypeCheck)
+	}
+	if o.deepCopy {
+		fs = append(fs, mergo.WithSliceDeepCopy)
+	}
+	if o.transformers {
+		fs = append(fs, mergo.WithTransformers(zooTransformers{}))
+	}
+	return fs
+}
+
+// merge runs the package's Merge with the options.
+func (o opts) merge(dst, src interface{}) error {
+	if o.deprecated {
+		return mergo.MergeWithOverwrite(dst, src, o.funcs()...)
+	}
+	return mergo.Merge(dst, src, o.funcs()...)
+}
+
+func (o opts) String() string {
+	var parts []string
+	add := func(on bool, s string) {
+		if on {
+			parts = append(parts, s)
+		}
+	}
+	add(o.override, "override")
+	add(o.owe, "owe")
+	add(o.oes, "oes")
+	add(o.noDeref, "noDeref")
+	add(o.appendSlice, "append")
+	add(o.typeCheck, "typeCheck")
+	add(o.deepCopy, "deepCopy")
+	add(o.transformers, "transformers")
+	add(o.deprecated, "deprecated")
+	if len(parts) == 0 {
+		return "plain"
+	}
+	return strings.Join(parts, "+")
+}
+
+// zooTransformers: time.Time as in the documentation (set when the destination is zero), Color
+// prefixed with "t:" when the destination is empty, and an error on the source "b".
+type zooTransformers struct{}
+
+var errColor = errors.New("zoo: color b")
+
+func (zooTransformers) Transformer(typ reflect.Type) func(dst, src reflect.Value) error {
+	switch typ {
+	case timeType:
+		return func(dst, src reflect.Value) error {
+			if dst.CanSet() && dst.MethodByName("IsZero").Call(nil)[0].Bool() {
+				dst.Set(src)
+			}
+			return nil
+		}
+	case colorType:
+		return func(dst, src reflect.Value) error {
+			if src.String() == "b" {
+				return errColor
+			}
+			if dst.CanSet() && dst.Len() == 0 && src.Len() > 0 {
+				dst.SetString("t:" + src.String())
+			}
+			return nil
+		}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- merge model
+//
+// README: "Mergo merges same-type structs and maps by setting default values in zero-value
+// fields. Mergo won't merge unexported (private) fields. It will do recursively any exported
+// one. It also won't merge structs inside maps (because they are not addressable using Go
+// reflection)". WithOverride: "override non-empty dst attributes with non-empty src attributes
+// values"; WithOverwriteWithEmptyValue: "override non empty dst attributes with empty src
+// attributes values"; WithOverrideEmptySlice: "override empty dst slice with empty src slice";
+// WithoutDereference: "a non-nil pointer is never considered empty"; WithAppendSlice: "append
+// slices instead of overwriting"; WithTypeCheck: "check types while overwriting";
+// WithSliceDeepCopy: "merge slice element one by one with Overwrite flag"; transformers replace
+// the merge of a type. An empty value is a zero scalar, a nil or empty container or a nil
+// pointer (or a pointer to an empty value unless WithoutDereference); a struct is never empty
+// (only its fields are), so a struct without exported fields (time.Time) moves only with
+// WithOverride.
+
+type mm struct {
+	o      opts
+	errs   []string // every error the merge can hit (the package stops at the first, in map order)
+	panics bool     // the merge reaches a recorded crash
+	why    string   // where
+}
+
+func (m *mm) fail(format string, args ...interface{}) {
+	m.errs = append(m.errs, fmt.Sprintf(format, args...))
+}
+
+func isNilable(k reflect.Kind) bool {
+	switch k {
+	case reflect.Chan, reflect.Func, reflect.Map, reflect.Interface, reflect.Slice, reflect.Pointer:
+		return true
+	}
+	return false
+}
+
+// empty is the merge's emptiness: the zero value of scalars, no elements, nil pointers and
+// interfaces (dereferenced unless WithoutDereference).
+func (m *mm) empty(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.Array:
+		if Known.arraysNeverEmpty {
+			return v.Len() == 0
+		}
+		return v.IsZero()
+	case reflect.Map, reflect.Slice, reflect.String:
+		return v.Len() == 0
+	case reflect.Bool:
+		return !v.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return v.Int() == 0
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		return v.Uint() == 0
+	case reflect.Float32, reflect.Float64:
+		return v.Float() == 0
+	case reflect.Interface, reflect.Pointer:
+		if v.IsNil() {
+			return true
+		}
+		if !m.o.noDeref {
+			return m.empty(v.Elem())
+		}
+		return false
+	case reflect.Func:
+		return v.IsNil()
+	case reflect.Invalid:
+		return true
+	}
+	return false
+}
+
+func hasExportedFields(t reflect.Type) bool {
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.Anonymous && f.Type.Kind() == reflect.Struct {
+			if hasExportedFields(f.Type) {
+				return true
+			}
+		} else if f.PkgPath == "" {
+			return true
+		}
+	}
+	return false
+}
+
+// dyn is the value behind an interface (a container element), as the package sees it.
+func dyn(v reflect.Value) reflect.Value {
+	if v.IsValid() && v.Kind() == reflect.Interface && !v.IsNil() {
+		return v.Elem()
+	}
+	return v
+}
+
+// merge merges src into dst; dst may be unaddressable (an element taken out of a map or an
+// interface), in which case only what it references (pointer targets, map entries) can change.
+func (m *mm) merge(dst, src reflect.Value) {
+	if !src.IsValid() {
+		return
+	}
+	if m.o.transformers && dst.IsValid() && !(isNilable(dst.Kind()) && dst.IsNil()) {
+		if fn := (zooTransformers{}).Transformer(dst.Type()); fn != nil {
+			if err := fn(dst, src); err != nil {
+				m.fail("%s", err.Error())
+			}
+			return
+		}
+	}
+	switch dst.Kind() {
+	case reflect.Struct:
+		if hasExportedFields(dst.Type()) {
+			if src.Kind() != reflect.Struct {
+				// elements of a []interface{} under WithSliceDeepCopy: nothing to merge
+				if Known.deepCopyKindPanic {
+					m.panics = true // the package reads the fields of a non-struct
+					m.why = fmt.Sprintf("%s against %s", dst.Type(), src.Type())
+				}
+				return
+			}
+			for i := 0; i < dst.NumField(); i++ {
+				if dst.Type().Field(i).PkgPath != "" {
+					continue // unexported fields are not merged
+				}
+				m.merge(dst.Field(i), src.Field(i))
+			}
+		} else if dst.CanSet() && m.o.override && (!m.empty(src) || m.o.owe) {
+			// a struct is never empty, so a struct without exported fields (time.Time) moves
+			// with WithOverride even when it is zero
+			if !src.IsZero() || m.o.owe || Known.zeroStructOverrides {
+				dst.Set(src)
+			}
+		}
+	case reflect.Map:
+		m.mergeMap(dst, src)
+	case reflect.Slice:
+		if !dst.CanSet() {
+			return
+		}
+		m.mergeSlice(dst, src, func(v reflect.Value) { dst.Set(v) })
+	case reflect.Pointer, reflect.Interface:
+		m.mergeRef(dst, src)
+	default:
+		if (m.empty(dst) || m.o.override) && (!m.empty(src) || m.o.owe) && dst.CanSet() {
+			dst.Set(src)
+		}
+	}
+}
+
+// mergeRef merges into a pointer or an interface: a nil source moves only with
+// WithOverwriteWithEmptyValue; a nil destination takes the source; two pointers are merged
+// through (or the pointer assigned with WithoutDereference and WithOverride); two interfaces
+// are replaced with WithOverride, else merged through when they hold the same kind; a
+// non-interface source (a Map value) into an interface is set, merged when of the held type.
+func (m *mm) mergeRef(dst, src reflect.Value) {
+	if isNilable(src.Kind()) && src.IsNil() {
+		if m.o.owe && dst.CanSet() && src.Type().AssignableTo(dst.Type()) {
+			dst.Set(src)
+		}
+		return
+	}
+	if src.Kind() != reflect.Interface {
+		if dst.IsNil() || (src.Kind() != reflect.Pointer && m.o.override) {
+			if dst.CanSet() && (m.o.override || m.empty(dst)) {
+				dst.Set(src)
+			}
+		} else if src.Kind() == reflect.Pointer {
+			if !m.o.noDeref {
+				m.merge(dst.Elem(), src.Elem())
+			} else if src.Elem().Kind() != reflect.Struct || !Known.noDerefStructPointer {
+				if m.o.owe || m.o.override {
+					if dst.CanSet() {
+						dst.Set(src)
+					} else if Known.noDerefUnaddressablePanic {
+						m.panics = true // the package sets an unaddressable value
+						m.why = fmt.Sprintf("WithoutDereference: %s = %s", dst.Type(), show(src))
+					}
+				}
+			}
+		} else if dst.Elem().Type() == src.Type() {
+			m.merge(dst.Elem(), src)
+		} else if Known.ifaceMismatchError {
+			m.fail("%s", mergo.ErrDifferentArgumentsTypes.Error())
+		}
+		return
+	}
+	if dst.IsNil() || m.o.override {
+		if dst.CanSet() && (m.o.override || m.empty(dst)) {
+			dst.Set(src)
+		}
+		return
+	}
+	if dst.Elem().Kind() == src.Elem().Kind() {
+		m.merge(dst.Elem(), src.Elem())
+	}
+}
+
+// mergeSlice: the whole src slice replaces an empty dst (or any dst with WithOverride) unless
+// appending or deep-copying; set applies the new slice.
+func (m *mm) mergeSlice(dst, src reflect.Value, set func(reflect.Value)) {
+	if (!m.empty(src) || m.o.owe || m.o.oes) && (m.o.override || m.empty(dst)) && !m.o.appendSlice && !m.o.deepCopy {
+		set(src)
+	} else if m.o.appendSlice {
+		if src.Type() != dst.Type() {
+			m.fail("cannot append two slice with different type (%s, %s)", src.Type(), dst.Type())
+			return
+		}
+		set(reflect.AppendSlice(dst, src))
+	} else if m.o.deepCopy {
+		for i := 0; i < src.Len() && i < dst.Len(); i++ {
+			de, se := dst.Index(i), src.Index(i)
+			if Known.sliceDeepCopyPointersOnly {
+				de, se = reflect.ValueOf(de.Interface()), reflect.ValueOf(se.Interface())
+			}
+			m.merge(de, se)
+		}
+	}
+}
+
+// mergeMap merges the entries of src into dst: a missing or empty entry takes the source's;
+// pointer and map entries are merged through (they are references), struct entries are not
+// (they are copies); slices follow the slice rules; WithOverride replaces entries (pointers
+// excepted in typed maps); WithOverwriteWithEmptyValue removes the entries src lacks.
+func (m *mm) mergeMap(dst, src reflect.Value) {
+	if dst.IsNil() {
+		if !isNilable(src.Kind()) {
+			// a nil map element of a []interface{} against a struct or scalar under
+			// WithSliceDeepCopy: nothing to merge
+			if Known.deepCopyKindPanic {
+				m.panics = true // the package asks a non-nilable value whether it is nil
+				m.why = fmt.Sprintf("nil %s against %s", dst.Type(), src.Type())
+			}
+			return
+		}
+		if !src.IsNil() {
+			if !dst.CanSet() {
+				return
+			}
+			dst.Set(reflect.MakeMap(dst.Type()))
+		}
+	}
+	if src.Kind() != reflect.Map {
+		if m.o.override && dst.CanSet() {
+			dst.Set(src)
+		}
+		return
+	}
+	for _, key := range src.MapKeys() {
+		se := src.MapIndex(key)
+		de := dst.MapIndex(key)
+		if isNilable(se.Kind()) && se.IsNil() {
+			// a nil entry is empty: it overrides only with WithOverwriteWithEmptyValue; the
+			// package lets nil slices, maps and interfaces override with WithOverride alone
+			// and treats a nil pointer like any pointer (never overriding, added when missing)
+			if Known.nilMapEntries {
+				if se.Kind() != reflect.Pointer {
+					if m.o.override {
+						dst.SetMapIndex(key, se)
+					}
+					continue
+				}
+			} else {
+				if m.o.owe {
+					dst.SetMapIndex(key, se)
+				} else if !de.IsValid() || m.empty(de) {
+					dst.SetMapIndex(key, se)
+				}
+				continue
+			}
+		}
+		sd := dyn(se)
+		switch sd.Kind() {
+		case reflect.Struct, reflect.Pointer, reflect.Map:
+			var dd reflect.Value
+			if de.IsValid() {
+				dd = reflect.ValueOf(de.Interface())
+			}
+			m.merge(dd, reflect.ValueOf(se.Interface()))
+		case reflect.Slice:
+			ss := reflect.ValueOf(se.Interface())
+			var ds reflect.Value
+			if !de.IsValid() || de.IsNil() {
+				ds = reflect.MakeSlice(ss.Type(), 0, ss.Len())
+			} else {
+				ds = reflect.ValueOf(de.Interface())
+			}
+			if (!m.empty(src) || m.o.owe || m.o.oes) && (m.o.override || m.empty(dst)) && !m.o.appendSlice && !m.o.deepCopy {
+				if m.o.typeCheck && ss.Type() != ds.Type() {
+					m.fail("cannot override two slices with different type (%s, %s)", ss.Type(), ds.Type())
+					continue
+				}
+				ds = ss
+			} else if m.o.appendSlice {
+				if ss.Type() != ds.Type() {
+					m.fail("cannot append two slices with different type (%s, %s)", ss.Type(), ds.Type())
+					continue
+				}
+				ds = reflect.AppendSlice(ds, ss)
+			} else if m.o.deepCopy {
+				for i := 0; i < ss.Len() && i < ds.Len(); i++ {
+					de, se := ds.Index(i), ss.Index(i)
+					if Known.sliceDeepCopyPointersOnly {
+						de, se = reflect.ValueOf(de.Interface()), reflect.ValueOf(se.Interface())
+					}
+					m.merge(de, se)
+				}
+			}
+			dst.SetMapIndex(key, ds)
+		}
+		if de.IsValid() && !m.empty(de) {
+			if sd.Kind() == reflect.Slice {
+				continue
+			}
+			if sd.Kind() == reflect.Map && dyn(de).Kind() == reflect.Map {
+				continue
+			}
+		}
+		if (se.Kind() != reflect.Pointer && m.o.override) || !de.IsValid() || m.empty(de) {
+			dst.SetMapIndex(key, se)
+		}
+	}
+	if m.o.owe {
+		for _, key := range dst.MapKeys() {
+			if !src.MapIndex(key).IsValid() {
+				dst.SetMapIndex(key, reflect.Value{})
+			}
+		}
+	}
+}
+
+// modelMerge merges src into dst (both are modified: dst takes values, and references, from
+// src) and returns the errors the merge can hit and whether it reaches a recorded crash.
+func modelMerge(dst, src reflect.Value, o opts) ([]string, string) {
+	m := &mm{o: o}
+	m.merge(dst, src)
+	return m.errs, m.why
+}
+
+// call runs f, reporting a panic in the code under test as a value instead of failing.
+func call(f func() error) (err error, panicked interface{}) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	return f(), nil
+}
+
+// --------------------------------------------------------------------------- properties
+
+// genRoot makes a value of a root type, addressable.
+func genRoot(tc hegel.TestCase, t reflect.Type) reflect.Value {
+	p := reflect.New(t)
+	p.Elem().Set(genValue(tc, t, 2))
+	return p.Elem()
+}
+
+// TestHegelMergeModel: Merge does what the documented model says, for every option.
+func TestHegelMergeModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		rt := pick(ht, rootTypes)
+		dst := genRoot(ht, rt)
+		src := genRoot(ht, rt)
+		if chance(ht, 15) {
+			dst.Set(reflect.Zero(rt)) // a zero destination takes the source
+		}
+		want := deepCopy(dst)
+		wantErrs, wantPanic := modelMerge(want, deepCopy(src), o)
+		var srcArg interface{} = src.Interface()
+		if chance(ht, 30) {
+			srcArg = src.Addr().Interface() // a pointer source is dereferenced
+		}
+		err, panicked := call(func() error { return o.merge(dst.Addr().Interface(), srcArg) })
+		if panicked != nil {
+			if wantPanic != "" {
+				c.count("panic (recorded)")
+				return
+			}
+			c.failClass(ht, "panic", "Merge(%s) under %s panicked: %v\n  dst %s\n  src %s", rt, o, panicked, show(want), show(src))
+			return
+		}
+		if wantPanic != "" && (len(wantErrs) == 0 || err == nil) {
+			// an error met first (in map order) stops the merge before the crash
+			c.failClass(ht, "no panic", "Merge(%s) under %s did not panic where the recorded bug does (%s)\n  dst %s\n  src %s", rt, o, wantPanic, show(want), show(src))
+			return
+		}
+		if len(wantErrs) > 0 {
+			c.count("error")
+			if err == nil {
+				c.failClass(ht, "missing error", "Merge(%s) under %s returned no error, want one of %q\n  dst %s\n  src %s", rt, o, wantErrs, show(want), show(src))
+				return
+			}
+			for _, w := range wantErrs {
+				if err.Error() == w {
+					return
+				}
+			}
+			c.failClass(ht, "error", "Merge(%s) under %s: %v, want one of %q", rt, o, err, wantErrs)
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "unexpected error", "Merge(%s) under %s: %v\n  dst %s\n  src %s", rt, o, err, show(want), show(src))
+			return
+		}
+		c.count(o.String())
+		if d := diffPath(want, dst, ""); d != "" {
+			c.failClass(ht, "result", "Merge(%s) under %s: %s\n  src  %s\n  want %s\n  got  %s", rt, o, d, show(src), show(want), show(dst))
+		}
+	})
+}
+
+// recordedPanic says whether a panic message is one of the recorded crashes (bugs 17 and 19).
+func recordedPanic(r interface{}) bool {
+	s := fmt.Sprint(r)
+	return strings.Contains(s, "reflect.Value.Field on") || strings.Contains(s, "reflect.Value.IsNil on") ||
+		strings.Contains(s, "using unaddressable value")
+}
+
+// zeroLawNorm zeroes what a zero source overrides under WithOverride while the bugs exist: the
+// arrays (never empty, bug 7) and the structs without exported fields (bug 16).
+func zeroLawNorm(v reflect.Value, transformers bool) {
+	// a zero source has nil pointers, slices and maps: the merge reaches fields by value only
+	switch v.Kind() {
+	case reflect.Array:
+		if Known.arraysNeverEmpty && v.CanSet() {
+			v.Set(reflect.Zero(v.Type()))
+		}
+	case reflect.Struct:
+		if !hasExportedFields(v.Type()) {
+			// the documented transformer leaves a non-zero time alone
+			if Known.zeroStructOverrides && v.CanSet() && !(transformers && v.Type() == timeType) {
+				v.Set(reflect.Zero(v.Type()))
+			}
+			return
+		}
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).PkgPath == "" {
+				zeroLawNorm(v.Field(i), transformers)
+			}
+		}
+	}
+}
+
+// TestHegelMergeLaws: laws that hold whatever the model says. The source is left alone; a zero
+// source changes nothing (unless empty values override); merging the same source twice is the
+// same as once (unless appending).
+func TestHegelMergeLaws(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		o := genOpts(ht)
+		rt := pick(ht, rootTypes)
+		dst := genRoot(ht, rt)
+		src := genRoot(ht, rt)
+		before := deepCopy(dst)
+		srcBefore := deepCopy(src)
+		// a recorded crash ends the case; any other panic fails it
+		merge := func(dst, src interface{}) (error, bool) {
+			err, r := call(func() error { return o.merge(dst, src) })
+			if r != nil {
+				if recordedPanic(r) {
+					c.count("panic (recorded)")
+					return nil, false
+				}
+				panic(r)
+			}
+			return err, true
+		}
+		switch drawInt(ht, 0, 2) {
+		case 0:
+			// the source is not modified
+			if err, ok := merge(dst.Addr().Interface(), src.Interface()); err != nil || !ok {
+				if err != nil {
+					c.count("error")
+				}
+				return
+			}
+			if d := diffPath(srcBefore, src, ""); d != "" {
+				c.failClass(ht, "source modified", "Merge(%s) under %s modified its source: %s\n  dst    %s\n  before %s\n  after  %s", rt, o, d, show(before), show(srcBefore), show(src))
+			}
+		case 1:
+			// a zero source changes nothing
+			if o.owe || (o.oes && o.override) {
+				o.owe, o.oes = false, false
+			}
+			zero := reflect.New(rt).Elem()
+			if err, ok := merge(dst.Addr().Interface(), zero.Interface()); err != nil || !ok {
+				if err != nil {
+					c.failClass(ht, "zero error", "Merge(%s, zero) under %s: %v", rt, o, err)
+				}
+				return
+			}
+			c.count("zero")
+			if o.override {
+				zeroLawNorm(before, o.transformers)
+			}
+			if d := diffPath(before, dst, ""); d != "" {
+				c.failClass(ht, "zero changed", "Merge(%s, zero) under %s changed the destination: %s\n  before %s\n  after  %s", rt, o, d, show(before), show(dst))
+			}
+		case 2:
+			// idempotence (the transformer's error depends on what the merge reaches)
+			o.appendSlice, o.transformers = false, false
+			if err, ok := merge(dst.Addr().Interface(), src.Interface()); err != nil || !ok {
+				if err != nil {
+					c.count("error")
+				}
+				return
+			}
+			once := deepCopy(dst)
+			if err, ok := merge(dst.Addr().Interface(), src.Interface()); err != nil || !ok {
+				if err != nil {
+					c.failClass(ht, "second error", "second Merge(%s) under %s: %v", rt, o, err)
+				}
+				return
+			}
+			c.count("twice")
+			if d := diffPath(once, dst, ""); d != "" {
+				c.failClass(ht, "not idempotent", "Merge(%s) twice under %s: %s\n  src   %s\n  once  %s\n  twice %s", rt, o, d, show(src), show(once), show(dst))
+			}
+		}
+	})
+}
