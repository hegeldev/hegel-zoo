+// the pointers to structs nil in the source.
+func TestHegelNoDerefOverridesStructPointers(t *testing.T) {
+	mergeJudged(t, shape8Cases(), mergeExpected)
+}
+
+// shape8Cases is the generator of TestHegelNoDerefOverridesStructPointers.
+func shape8Cases() hegel.Generator[mergeCase] {
+	og := optsWith(func(o *opts) { o.noDeref, o.override, o.deepCopy, o.transformers = true, true, false, false })
+	inner := innerLight
+	outer := outerLight
+	quiet := func(dst reflect.Value, src reflect.Value) {
+		src.FieldByName("A").Set(dst.FieldByName("A"))
+		src.FieldByName("T").Set(dst.FieldByName("T"))
+		src.FieldByName("MA").Set(reflect.Zero(anyMapT))
+	}
+	innerWith := func(name string, dg, sg hegel.Generator[reflect.Value]) hegel.Generator[mergeCase] {
+		return hegel.Composite(func(tc hegel.TestCase) mergeCase {
+			o := hegel.Draw(tc, og)
+			dst := hegel.Draw(tc, withFields(inner, fieldOf{name, dg}))
+			src := hegel.Draw(tc, withFields(inner, fieldOf{name, sg}))
+			quiet(dst, src)
+			if name != "PT" {
