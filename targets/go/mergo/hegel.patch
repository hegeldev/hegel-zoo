+package hegel
+
+// One narrow property per recorded bug the wide properties reach by a drawn ingredient: a
+// generator over the bug's shape region with random surroundings (the ingredient forced, the
+// rest of the value and the other options drawn), judged by mergeExpected/mapExpected and the
+// shared judge, so that it fails every run by default naming the shape, and under
+// HEGEL_NO_KNOWN=1 draws the neighbouring region past the shape (hzShaped) and passes (the
+// struct values around the ingredient are drawn at depth 0 and the lists are short: every
+// draw is a call into the engine, and the shrinking of a failure replays the case thousands
+// of times, so a case of a few hundred draws shrinks for minutes). Where
+// the shape of an earlier bug would be named first by the classifier, the property's
+// generator leaves that shape out (the other ingredient equal on both sides, an option off)
+// or its check set is restricted to the outcome (the crashes inside WithSliceDeepCopy's
+// copies, mergo/17 and mergo/19, which mergo/6 would otherwise name first by the result).
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- ingredients
+
+// optsWith is optsGen with the fixed options applied after the draw.
+func optsWith(fix func(o *opts)) hegel.Generator[opts] {
+	return hegel.Map(optsGen, func(o opts) opts {
+		fix(&o)
+		return o
+	})
+}
+
+// fieldOf is one field of a struct value set to a drawn value.
+type fieldOf struct {
+	name string
+	g    hegel.Generator[reflect.Value]
+}
+
+// withFields draws a struct value of g and sets the named fields to values of their own
+// generators (the drawn value is fresh, so setting it is safe).
+func withFields(g hegel.Generator[reflect.Value], fields ...fieldOf) hegel.Generator[reflect.Value] {
+	return hegel.Composite(func(tc hegel.TestCase) reflect.Value {
+		v := hegel.Draw(tc, g)
+		for _, f := range fields {
+			v.FieldByName(f.name).Set(hegel.Draw(tc, f.g))
+		}
+		return v
+	})
+}
+
+// boxed is a non-nil pointer to a drawn value.
+func boxed(g hegel.Generator[reflect.Value]) hegel.Generator[reflect.Value] {
+	return hegel.Map(g, func(e reflect.Value) reflect.Value {
+		p := reflect.New(e.Type())
+		p.Elem().Set(e)
+		return p
+	})
+}
+
+// nonEmptyList is a slice of t with one to three elements; shortList one or two.
+func nonEmptyList(t reflect.Type, elem hegel.Generator[reflect.Value]) hegel.Generator[reflect.Value] {
+	return listOf(t, countedHalves(elem, 1, 3))
+}
+
+func shortList(t reflect.Type, elem hegel.Generator[reflect.Value]) hegel.Generator[reflect.Value] {
+	return listOf(t, countedHalves(elem, 1, 2))
+}
+
+func listOf(t reflect.Type, elems hegel.Generator[[]reflect.Value]) hegel.Generator[reflect.Value] {
+	return hegel.Map(elems, func(es []reflect.Value) reflect.Value {
+		s := reflect.MakeSlice(t, len(es), len(es))
+		for i, e := range es {
+			s.Index(i).Set(e)
+		}
+		return s
+	})
+}
+
+var (
+	arrayType = reflect.TypeOf([2]int{})
+	intType   = reflect.TypeOf(0)
+	strType   = reflect.TypeOf("")
+	mapIntT   = reflect.TypeOf(map[string]int{})
+
+	// nonZeroInt is an int in -2..3 but 0; nonZeroArray a [2]int whose first element is not 0.
+	nonZeroInt   = hegel.Map(evenHalves(-2, -1, 1, 2, 3), func(n int) reflect.Value { return reflect.ValueOf(n) })
+	nonZeroArray = hegel.Map(hzTuple(nonZeroInt, valueGen(intType, 0)), func(es []reflect.Value) reflect.Value {
+		a := reflect.New(arrayType).Elem()
+		a.Index(0).Set(es[0])
+		a.Index(1).Set(es[1])
+		return a
+	})
+	zeroArray = zeroOf(arrayType)
+
+	// nonZeroTime and zeroTime are the two faces of timeGen.
+	nonZeroTime = hegel.Map(hzInts(1, 2000000000), func(s int) reflect.Value {
+		return reflect.ValueOf(time.Unix(int64(s), 0).UTC())
+	})
+	zeroTime = zeroOf(timeType)
+
+	// nonNilAny is an interface{} holding a value (never a nil interface, never a typed nil
+	// pointer).
+	nonNilAny = boxAny(evenGens(
+		valueGen(strType, 0), valueGen(intType, 0), valueGen(reflect.TypeOf(float64(0)), 0), valueGen(reflect.TypeOf(false), 0),
+		valueGen(anyMapT, 0), valueGen(anySliceT, 0), valueGen(leafType, 0), boxed(valueGen(leafType, 0)),
+	))
+
+	// innerLight is an Inner whose scalar, pointer, array and time fields are random and
+	// whose slices, maps and interface are zero: the surroundings of the narrow properties on
+	// Inner (a full Inner at depth 0 is some 350 draws, and every draw is a call into the
+	// engine, so a failure of two full Inners shrinks for minutes); outerLight an Outer with a
+	// random In and Name.
+	innerLight = withFields(zeroOf(innerType),
+		fieldOf{"Leaf", valueGen(leafType, 0)},
+		fieldOf{"E", valueGen(intType, 0)},
+		fieldOf{"N", valueGen(intType, 0)},
+		fieldOf{"PS", valueGen(reflect.PointerTo(strType), 0)},
+		fieldOf{"PI", valueGen(reflect.PointerTo(intType), 0)},
+		fieldOf{"PL", valueGen(reflect.PointerTo(leafType), 0)},
+		fieldOf{"A", valueGen(arrayType, 0)},
+		fieldOf{"T", timeGen},
+		fieldOf{"PT", valueGen(reflect.PointerTo(timeType), 0)},
+	)
+	outerLight = withFields(zeroOf(outerType), fieldOf{"In", innerLight}, fieldOf{"Name", valueGen(strType, 0)})
+)
+
+// mergeCases is the merge cases of a root type from an options generator and the two value
+// generators (the destination first).
+func mergeCases(rt reflect.Type, og hegel.Generator[opts], dg, sg hegel.Generator[reflect.Value]) hegel.Generator[mergeCase] {
+	return hegel.Composite(func(tc hegel.TestCase) mergeCase {
+		o := hegel.Draw(tc, og)
+		dst := hegel.Draw(tc, dg)
+		src := hegel.Draw(tc, sg)
+		return mergeCase{rt: rt, o: o, dst: dst, src: src}
+	})
+}
+
+// mergeJudged runs a narrow property over merge cases with the statement (mergeExpected or
+// its outcome alone).
+func mergeJudged(t *testing.T, cases hegel.Generator[mergeCase], expected func(mergeCase, known) checks) {
+	t.Helper()
+	judged(t, cases, func(j *hzCaseJudge, c mergeCase) {
+		judgeBy(j, &c, expected, mergeActual)
+	})
+}
+
+// mapJudged is mergeJudged for Map cases.
+func mapJudged(t *testing.T, cases hegel.Generator[mapCase]) {
+	t.Helper()
+	judged(t, cases, func(j *hzCaseJudge, c mapCase) {
+		judgeBy(j, &c, mapExpected, mapActual)
+	})
+}
+
+// --------------------------------------------------------------------------- mergo/6
+
+// TestHegelDeepCopyMergesScalarAndStructElements: WithSliceDeepCopy over a slice of ints,
+// Leafs or Inners at the root or in a field of Inner, both sides non-empty: the documented
+// option merges the elements one by one with override (mergo/6: the package merges copies and
+// changes no element that is not a pointer or a map). The int elements of the source are not
+// zero, and the Leaf and Inner elements random, so that the element merge changes something
+// in nearly every case; the classifier filters the rest (regionOf). Past the shape under
+// HEGEL_NO_KNOWN=1 the source is a copy of the destination, which the element merge leaves as
+// it is. The transformers are off (the Color transformer's error inside the elements is
+// mergo/6's shape too).
+func TestHegelDeepCopyMergesScalarAndStructElements(t *testing.T) {
+	og := optsWith(func(o *opts) { o.deepCopy, o.override, o.appendSlice, o.transformers = true, true, false, false })
+	pair := func(rt reflect.Type, dg, sg hegel.Generator[reflect.Value]) hegel.Generator[mergeCase] {
+		return hegel.Composite(func(tc hegel.TestCase) mergeCase {
+			o := hegel.Draw(tc, og)
+			dst := hegel.Draw(tc, dg)
+			src := hegel.Draw(tc, sg)
+			if hzNoKnown {
+				src = deepCopy(dst)
+			}
+			return mergeCase{rt: rt, o: o, dst: dst, src: src}
+		})
+	}
+	root := func(rt reflect.Type, elem hegel.Generator[reflect.Value]) hegel.Generator[mergeCase] {
+		return pair(rt, shortList(rt, valueGen(rt.Elem(), 0)), shortList(rt, elem))
+	}
+	field := func(name string, st reflect.Type, elem hegel.Generator[reflect.Value]) hegel.Generator[mergeCase] {
+		inner := innerLight
+		return pair(innerType,
+			withFields(inner, fieldOf{name, shortList(st, valueGen(st.Elem(), 0))}),
+			withFields(inner, fieldOf{name, shortList(st, elem)}))
+	}
+	cases := evenGens(
+		root(intSliceT, nonZeroInt),
+		root(reflect.TypeOf([]Leaf{}), valueGen(leafType, 0)),
+		root(reflect.TypeOf([]Inner{}), valueGen(innerType, 0)),
+		field("SI", intSliceT, nonZeroInt),
+		field("SL", reflect.TypeOf([]Leaf{}), valueGen(leafType, 0)),
+	)
+	mergeJudged(t, regionOf("mergo/6", mergeExpected, cases), mergeExpected)
+}
+
+// --------------------------------------------------------------------------- mergo/7
+
+// TestHegelZeroArraysAreEmpty: a zero array field (Inner.A) is an empty value: the destination's
+// takes a non-zero source array, and a zero source array does not override under WithOverride
+// (mergo/7: an array is never empty for the package, so neither happens). The rest of the Inner
+// values is random; WithSliceDeepCopy is off (mergo/6 would be named first) and, in the form
