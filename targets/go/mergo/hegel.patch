+// anyList is a []interface{} of the elements, as a value.
+func anyList(es []reflect.Value) reflect.Value {
+	s := reflect.MakeSlice(anySliceT, len(es), len(es))
+	for i, e := range es {
+		s.Index(i).Set(e)
