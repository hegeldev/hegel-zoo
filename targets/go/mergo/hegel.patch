+// TestHegelPinMapKeepsEntries: mergo/10. Map into a struct follows "the same restrictions as in
+// Merge()": the destination's map entries and pointers that the source map lacks stay.
+func TestHegelPinMapKeepsEntries(t *testing.T) {
+	dst := Inner{M: map[string]int{"a": 1}}
+	if err := mergo.Map(&dst, map[string]interface{}{"m": map[string]int{"b": 2}}); err != nil {
+		t.Fatalf("Map: %v", err)
+	}
+	if !reflect.DeepEqual(dst.M, map[string]int{"a": 1, "b": 2}) {
+		t.Errorf("Map({m: {b: 2}}) into M = {a: 1}: M = %v", dst.M)
+	}
+	x := 3
+	dst = Inner{PI: &x}
+	if err := mergo.Map(&dst, map[string]interface{}{"pI": (*int)(nil)}); err != nil {
+		t.Fatalf("Map: %v", err)
+	}
+	if dst.PI == nil {
+		t.Errorf("Map({pI: nil pointer}) into PI = &3: PI = nil")
+	}
+}
+
+// TestHegelPinMapDestinationType: mergo/11. A map destination that is not a
+// map[string]interface{} is an error (ErrExpectedMapAsDestination), not a panic.
+func TestHegelPinMapDestinationType(t *testing.T) {
+	noPanic(t, func() {
+		m := map[string]int{}
+		if err := mergo.Map(&m, Leaf{I: 1}); err == nil {
+			t.Errorf("Map(&map[string]int, Leaf): no error, m = %v", m)
+		}
+	})
+}
+
+// TestHegelPinReplacedPointerUntouched: mergo/12. With WithOverride, a pointer entry of a map of
+// interfaces is replaced by the source's; the value it pointed to is not written to.
+func TestHegelPinReplacedPointerUntouched(t *testing.T) {
+	old := &Leaf{S: "d"}
+	dst := map[string]interface{}{"a": old}
+	src := map[string]interface{}{"a": &Leaf{I: 1}}
+	if err := mergo.Merge(&dst, src, mergo.WithOverride); err != nil {
+		t.Fatalf("Merge: %v", err)
+	}
+	if dst["a"] != src["a"] {
+		t.Errorf("Merge(WithOverride): entry a = %+v, not the source's pointer", dst["a"])
+	}
+	if *old != (Leaf{S: "d"}) {
+		t.Errorf("Merge(WithOverride) wrote to the replaced pointer's target: %+v", *old)
+	}
+}
+
+// TestHegelPinNilEmbeddedPointer: mergo/13. Map into a struct whose embedded pointer is nil: a
+// key naming a promoted field allocates the embedded struct or is skipped, without a panic.
+func TestHegelPinNilEmbeddedPointer(t *testing.T) {
+	noPanic(t, func() {
+		var dst Outer
+		err := mergo.Map(&dst, map[string]interface{}{"e": 1})
+		if err == nil && dst.Emb != nil && dst.E != 1 {
+			t.Errorf("Map({e: 1}) into Outer{Emb: nil}: E = %d", dst.E)
+		}
+	})
+}
+
+// TestHegelPinNilMapEntries: mergo/15. A nil entry of the source map is an empty value: it
+// overrides the destination's entry only with WithOverwriteWithEmptyValue, whatever its kind.
+func TestHegelPinNilMapEntries(t *testing.T) {
+	dst := map[string]interface{}{"a": []int{1}, "b": map[string]interface{}{"x": 1}}
+	src := map[string]interface{}{"a": []int(nil), "b": nil}
+	if err := mergo.Merge(&dst, src, mergo.WithOverride); err != nil {
+		t.Fatalf("Merge: %v", err)
+	}
+	if !reflect.DeepEqual(dst["a"], []int{1}) || dst["b"] == nil {
+		t.Errorf("Merge(WithOverride) with nil source entries: %v", dst)
+	}
+	dp := map[string]*Leaf{"a": {S: "d"}}
+	if err := mergo.Merge(&dp, map[string]*Leaf{"a": nil}, mergo.WithOverwriteWithEmptyValue); err != nil {
+		t.Fatalf("Merge: %v", err)
+	}
+	if dp["a"] != nil {
+		t.Errorf("Merge(WithOverwriteWithEmptyValue) with a nil pointer entry: a = %+v", dp["a"])
+	}
+}
+
+// TestHegelPinZeroTimeOverride: mergo/16. WithOverride overrides with non-empty source values:
+// a zero time.Time (an empty struct value) leaves the destination's time alone.
+func TestHegelPinZeroTimeOverride(t *testing.T) {
+	dst := Inner{T: time.Unix(100, 0)}
+	if err := mergo.Merge(&dst, Inner{}, mergo.WithOverride); err != nil {
+		t.Fatalf("Merge: %v", err)
+	}
+	if dst.T.IsZero() {
+		t.Errorf("Merge(WithOverride) with a zero source time zeroed T")
+	}
+}
+
+// TestHegelPinDeepCopyKinds: mergo/17. WithSliceDeepCopy over a []interface{} whose elements
+// hold values of different kinds merges nothing there (or overrides), without a panic.
+func TestHegelPinDeepCopyKinds(t *testing.T) {
+	noPanic(t, func() {
+		dst := []interface{}{Leaf{S: "d"}}
+		src := []interface{}{"x"}
+		if err := mergo.Merge(&dst, src, mergo.WithSliceDeepCopy); err != nil {
+			t.Fatalf("Merge(struct vs string): %v", err)
+		}
+	})
+	noPanic(t, func() {
+		dst := []interface{}{map[string]interface{}(nil)}
+		src := []interface{}{Leaf{S: "s"}}
+		if err := mergo.Merge(&dst, src, mergo.WithSliceDeepCopy); err != nil {
+			t.Fatalf("Merge(nil map vs struct): %v", err)
+		}
+	})
+}
+
+// TestHegelPinTypedMapsInInterfaces: mergo/18. Entries of a map of interfaces holding maps of
+// different types are not merged into each other (overridden or left), without a panic.
+func TestHegelPinTypedMapsInInterfaces(t *testing.T) {
+	noPanic(t, func() {
+		dst := map[string]interface{}{"a": map[string]int{"x": 1}}
+		src := map[string]interface{}{"a": map[string]string{"y": "s"}}
+		if err := mergo.Merge(&dst, src); err != nil {
+			t.Fatalf("Merge: %v", err)
+		}
+	})
+}
+
+// TestHegelPinNoDerefMapEntries: mergo/19. WithoutDereference with WithOverride assigns the
+// source's pointer where it can and leaves the other pointer entries of a map of interfaces
+// alone, without a panic.
+func TestHegelPinNoDerefMapEntries(t *testing.T) {
+	noPanic(t, func() {
+		x, y := 1, 2
+		dst := map[string]interface{}{"a": &x}
+		src := map[string]interface{}{"a": &y}
+		if err := mergo.Merge(&dst, src, mergo.WithOverride, mergo.WithoutDereference); err != nil {
+			t.Fatalf("Merge: %v", err)
+		}
+		if dst["a"] != src["a"] {
+			t.Errorf("Merge(WithOverride, WithoutDereference): a = %v, not the source's pointer", dst["a"])
+		}
+	})
+}
+
+// TestHegelPinMapSourceType: mergo/14. "src can be a map with string keys": a map[string]int
+// source is mapped or reported as unsupported, not a panic.
+func TestHegelPinMapSourceType(t *testing.T) {
+	noPanic(t, func() {
+		var dst Leaf
+		err := mergo.Map(&dst, map[string]int{"i": 1})
+		if err == nil && dst.I != 1 {
+			t.Errorf("Map(map[string]int{i: 1}): I = %d, no error", dst.I)
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..594df12
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,651 @@
+package hegel
+
+// Hegel property tests for darccio/mergo, written for the Hegel zoo. See
+// targets/go/mergo/README.md.
+//
+// Oracles: a model of the documented Merge (empty destination attributes take the source's,
+// recursively through exported struct fields, pointers and maps; the options WithOverride,
+// WithOverwriteWithEmptyValue, WithOverrideEmptySlice, WithoutDereference, WithAppendSlice,
+// WithTypeCheck, WithSliceDeepCopy and WithTransformers) over generated values of a type
+// universe covering every supported kind; laws that hold regardless of the model (a zero source
+// changes nothing, Merge is idempotent, the source is left alone, errors only where documented);
+// a model of Map in both directions (struct <-> map[string]interface{}, keys in lower camel
+// case, nested maps into nested structs, kind mismatches as errors).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces a
+// behaviour while its switch is on; the pins assert the documented behaviour and fail while the
+// bug exists.
+var Known = struct {
+	sliceDeepCopyPointersOnly bool // 6: WithSliceDeepCopy merges no element that is not a pointer or a map
+	arraysNeverEmpty          bool // 7: an array is never an empty value, so a zero array field is never filled
+	noDerefStructPointer      bool // 8: WithoutDereference with WithOverride leaves a pointer to a struct untouched
+	ifaceMismatchError        bool // 9: Map into a non-nil interface field fails with ErrDifferentArgumentsTypes when the dynamic types differ
+	mapForcesEmptyOverwrite   bool // 10: Map into a struct removes map entries and pointers that the source map lacks
+	nilMapEntries             bool // 15: a nil slice, map or interface entry of the source map overrides under WithOverride alone; a nil pointer entry never does
+	zeroStructOverrides       bool // 16: WithOverride replaces a struct without exported fields (time.Time) with a zero source value
+	deepCopyKindPanic         bool // 17: WithSliceDeepCopy panics on []interface{} elements of different kinds
+	noDerefUnaddressablePanic bool // 19: WithoutDereference with WithOverride panics on pointer entries of maps and slices of interfaces
+}{true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- type universe
+
+// Color is a named string type.
+type Color string
+
+// Leaf has scalar fields only.
+type Leaf struct {
+	S  string
+	C  Color
+	I  int
+	I8 int8
+	U  uint16
+	F  float64
+	B  bool
+}
+
+// Emb is embedded, by value in Inner and by pointer in Outer.
+type Emb struct {
+	E  int
+	ES []string
+}
+
+// Inner has a field of every supported shape.
+type Inner struct {
+	Emb
+	Leaf
+	N    int
+	PS   *string
+	PI   *int
+	PL   *Leaf
+	SS   []string
+	SI   []int
+	SL   []Leaf
+	SPL  []*Leaf
+	A    [2]int
+	M    map[string]int
+	ML   map[string]Leaf
+	MPL  map[string]*Leaf
+	MA   map[string]interface{}
+	Any  interface{}
+	T    time.Time
+	PT   *time.Time
+	priv int
+	pm   map[string]int
+}
+
+// Outer nests Inner in every container.
+type Outer struct {
+	*Emb
+	In   Inner
+	PIn  *Inner
+	Ins  []Inner
+	PIns []*Inner
+	MI   map[string]Inner
+	MPI  map[string]*Inner
+	SS   [][]int
+	Anys []interface{}
+	MA   map[string]interface{}
+	Name string
+}
+
+var (
+	timeType  = reflect.TypeOf(time.Time{})
+	colorType = reflect.TypeOf(Color(""))
+	leafType  = reflect.TypeOf(Leaf{})
+	innerType = reflect.TypeOf(Inner{})
+	outerType = reflect.TypeOf(Outer{})
+	anyType   = reflect.TypeOf((*interface{})(nil)).Elem()
+	anyMapT   = reflect.TypeOf(map[string]interface{}{})
+	anySliceT = reflect.TypeOf([]interface{}{})
+
+	// rootTypes are the types merged at the top level: structs, maps and slices are supported.
+	rootTypes = []reflect.Type{
+		outerType, outerType, outerType, innerType, innerType, leafType,
+		anyMapT, anyMapT, reflect.TypeOf(map[string]Inner{}), reflect.TypeOf(map[string]*Leaf{}),
+		reflect.TypeOf(map[string][]int{}), reflect.TypeOf([]Inner{}), reflect.TypeOf([]*Leaf{}),
+		reflect.TypeOf([]int{}), anySliceT,
+	}
+)
+
+var stringAtoms = []string{"", "", "a", "b", "hello world", "0", "x.y", string(rune(0xe9))}
+
+var floatAtoms = []float64{0, 0, 1, -1, 0.5, 1e10, negZero()}
+
+func zeroF() float64   { return 0 }
+func negZero() float64 { return -zeroF() }
+
+var mapKeys = []string{"a", "b", "c", "d", "k"}
+
+func genTime(tc hegel.TestCase) time.Time {
+	if chance(tc, 40) {
+		return time.Time{}
+	}
+	return time.Unix(int64(drawInt(tc, 1, 2000000000)), 0).UTC()
+}
+
+// genAny makes a dynamic value for an interface{}: nothing, a scalar, a slice, a map of
+// interfaces, a Leaf or a pointer to one; the empty scalars are frequent because emptiness is
+// what Merge decides on.
+func genAny(tc hegel.TestCase, depth int) reflect.Value {
+	v := reflect.New(anyType).Elem()
+	switch drawInt(tc, 0, 9) {
+	case 0, 1:
+		return v // nil
+	case 2:
+		v.Set(reflect.ValueOf(pick(tc, stringAtoms)))
+	case 3:
+		v.Set(reflect.ValueOf(drawInt(tc, -1, 2)))
+	case 4:
+		v.Set(reflect.ValueOf(pick(tc, floatAtoms)))
+	case 5:
+		v.Set(reflect.ValueOf(chance(tc, 50)))
+	case 6:
+		if depth > 0 {
+			v.Set(genValue(tc, anyMapT, depth-1))
+		} else {
+			v.Set(genValue(tc, reflect.TypeOf([]string{}), 0))
+		}
+	case 7:
+		if depth > 0 {
+			v.Set(genValue(tc, anySliceT, depth-1))
+		} else {
+			v.Set(genValue(tc, reflect.TypeOf([]int{}), 0))
+		}
+	case 8:
+		v.Set(genValue(tc, leafType, 0))
+	case 9:
+		v.Set(genValue(tc, reflect.PointerTo(leafType), 0))
+	}
+	return v
+}
+
+// genValue makes a random value of type t; empty values (zero scalars, nil and empty
+// containers) are frequent. Unexported fields stay zero.
+func genValue(tc hegel.TestCase, t reflect.Type, depth int) reflect.Value {
+	v := reflect.New(t).Elem()
+	if t == timeType {
+		v.Set(reflect.ValueOf(genTime(tc)))
+		return v
+	}
+	if t == anyType {
+		return genAny(tc, depth)
+	}
+	switch t.Kind() {
+	case reflect.Pointer:
+		if chance(tc, 40) {
+			return v
+		}
+		p := reflect.New(t.Elem())
+		p.Elem().Set(genValue(tc, t.Elem(), depth))
+		v.Set(p)
+	case reflect.Slice:
+		if chance(tc, 35) {
+			return v
+		}
+		n := drawInt(tc, 0, 3)
+		if depth <= 0 && t.Elem().Kind() != reflect.String && t.Elem().Kind() != reflect.Int {
+			n = drawInt(tc, 0, 1)
+		}
+		s := reflect.MakeSlice(t, n, n)
+		for i := 0; i < n; i++ {
+			s.Index(i).Set(genValue(tc, t.Elem(), depth-1))
+		}
+		v.Set(s)
+	case reflect.Array:
+		if chance(tc, 40) {
+			return v
+		}
+		for i := 0; i < t.Len(); i++ {
+			v.Index(i).Set(genValue(tc, t.Elem(), depth-1))
+		}
+	case reflect.Map:
+		if chance(tc, 35) {
+			return v
+		}
+		n := drawInt(tc, 0, 3)
+		if depth <= 0 {
+			n = drawInt(tc, 0, 1)
+		}
+		m := reflect.MakeMap(t)
+		for i := 0; i < n; i++ {
+			m.SetMapIndex(reflect.ValueOf(pick(tc, mapKeys)), genValue(tc, t.Elem(), depth-1))
+		}
+		v.Set(m)
+	case reflect.Struct:
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			v.Field(i).Set(genValue(tc, f.Type, depth))
+		}
+	case reflect.String:
+		v.SetString(pick(tc, stringAtoms))
+	case reflect.Bool:
+		v.SetBool(chance(tc, 50))
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		v.SetInt(int64(drawInt(tc, -2, 3)))
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		v.SetUint(uint64(drawInt(tc, 0, 3)))
+	case reflect.Float32, reflect.Float64:
+		v.SetFloat(pick(tc, floatAtoms))
+	default:
+		panic("genValue: " + t.String())
+	}
+	return v
+}
+
+// deepCopy copies a value so that the model and the package work on separate memory.
+func deepCopy(v reflect.Value) reflect.Value {
+	out := reflect.New(v.Type()).Elem()
+	switch v.Kind() {
+	case reflect.Pointer:
+		if !v.IsNil() {
+			p := reflect.New(v.Type().Elem())
+			p.Elem().Set(deepCopy(v.Elem()))
+			out.Set(p)
+		}
+	case reflect.Interface:
+		if !v.IsNil() {
+			out.Set(deepCopy(v.Elem()))
+		}
+	case reflect.Slice:
+		if !v.IsNil() {
+			s := reflect.MakeSlice(v.Type(), v.Len(), v.Len())
+			for i := 0; i < v.Len(); i++ {
+				s.Index(i).Set(deepCopy(v.Index(i)))
+			}
+			out.Set(s)
+		}
+	case reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			out.Index(i).Set(deepCopy(v.Index(i)))
+		}
+	case reflect.Map:
+		if !v.IsNil() {
+			m := reflect.MakeMap(v.Type())
+			for _, k := range v.MapKeys() {
+				m.SetMapIndex(k, deepCopy(v.MapIndex(k)))
+			}
+			out.Set(m)
+		}
+	case reflect.Struct:
+		if v.Type() == timeType {
+			out.Set(v)
+			return out
+		}
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).PkgPath != "" {
+				continue
+			}
+			out.Field(i).Set(deepCopy(v.Field(i)))
+		}
+	default:
+		out.Set(v)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- comparison
+
+// same compares two values of one type structurally: nil and empty slices and maps alike,
+// interfaces by dynamic type and value, times by Equal, unexported fields ignored, pointers by
+// their targets.
+func same(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	if a.Type() == timeType {
+		return a.Interface().(time.Time).Equal(b.Interface().(time.Time))
+	}
+	switch a.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() && b.IsNil()
+		}
+		return same(a.Elem(), b.Elem())
+	case reflect.Slice:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Array:
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for _, k := range a.MapKeys() {
+			bv := b.MapIndex(k)
+			if !bv.IsValid() || !same(a.MapIndex(k), bv) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			if a.Type().Field(i).PkgPath != "" {
+				continue
+			}
+			if !same(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Float32, reflect.Float64:
+		return a.Float() == b.Float() || (a.Float() != a.Float() && b.Float() != b.Float())
+	case reflect.String:
+		return a.String() == b.String()
+	case reflect.Bool:
+		return a.Bool() == b.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return a.Int() == b.Int()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return a.Uint() == b.Uint()
+	}
+	panic("same: " + a.Type().String())
+}
+
+// diffPath is the path of the first difference between a and b (as same() sees them), with
+// both values there; "" when they are the same.
+func diffPath(a, b reflect.Value, path string) string {
+	if path == "" {
+		path = "root"
+	}
+	if a.Type() != b.Type() {
+		return fmt.Sprintf("%s: types %s and %s", path, a.Type(), b.Type())
+	}
+	leaf := func() string { return fmt.Sprintf("%s: want %s, got %s", path, show(a), show(b)) }
+	if a.Type() == timeType {
+		if !a.Interface().(time.Time).Equal(b.Interface().(time.Time)) {
+			return leaf()
+		}
+		return ""
+	}
+	switch a.Kind() {
+	case reflect.Pointer, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			if a.IsNil() && b.IsNil() {
+				return ""
+			}
+			return leaf()
+		}
+		if a.Kind() == reflect.Interface && a.Elem().Type() != b.Elem().Type() {
+			return leaf()
+		}
+		return diffPath(a.Elem(), b.Elem(), path)
+	case reflect.Slice, reflect.Array:
+		if a.Len() != b.Len() {
+			return leaf()
+		}
+		for i := 0; i < a.Len(); i++ {
+			if d := diffPath(a.Index(i), b.Index(i), fmt.Sprintf("%s[%d]", path, i)); d != "" {
+				return d
+			}
+		}
+		return ""
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return leaf()
+		}
+		for _, k := range a.MapKeys() {
+			bv := b.MapIndex(k)
+			if !bv.IsValid() {
+				return leaf()
+			}
+			if d := diffPath(a.MapIndex(k), bv, fmt.Sprintf("%s[%v]", path, k)); d != "" {
+				return d
+			}
+		}
+		return ""
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			f := a.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			if d := diffPath(a.Field(i), b.Field(i), path+"."+f.Name); d != "" {
+				return d
+			}
+		}
+		return ""
+	}
+	if !same(a, b) {
+		return leaf()
+	}
+	return ""
+}
+
+// show prints a value for a failure message, pointers by their targets.
+func show(v reflect.Value) string {
+	var sb strings.Builder
+	showTo(&sb, v, 0)
+	s := sb.String()
+	if len(s) > 2500 {
+		s = s[:2500] + "..."
+	}
+	return s
+}
+
+func showTo(sb *strings.Builder, v reflect.Value, depth int) {
+	if depth > 8 {
+		sb.WriteString("...")
+		return
+	}
+	if v.Type() == timeType {
+		fmt.Fprintf(sb, "%v", v.Interface())
+		return
+	}
+	switch v.Kind() {
+	case reflect.Pointer:
+		if v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		sb.WriteString("&")
+		showTo(sb, v.Elem(), depth+1)
+	case reflect.Interface:
+		if v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		fmt.Fprintf(sb, "%s(", v.Elem().Type())
+		showTo(sb, v.Elem(), depth+1)
+		sb.WriteString(")")
+	case reflect.Slice, reflect.Array:
+		if v.Kind() == reflect.Slice && v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		sb.WriteString("[")
+		for i := 0; i < v.Len(); i++ {
+			if i > 0 {
+				sb.WriteString(" ")
+			}
+			showTo(sb, v.Index(i), depth+1)
+		}
+		sb.WriteString("]")
+	case reflect.Map:
+		if v.IsNil() {
+			sb.WriteString("nil")
+			return
+		}
+		keys := v.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return fmt.Sprint(keys[i]) < fmt.Sprint(keys[j]) })
+		sb.WriteString("{")
+		for i, k := range keys {
+			if i > 0 {
+				sb.WriteString(" ")
+			}
+			fmt.Fprintf(sb, "%v:", k)
+			showTo(sb, v.MapIndex(k), depth+1)
+		}
+		sb.WriteString("}")
+	case reflect.Struct:
+		sb.WriteString("{")
+		first := true
+		for i := 0; i < v.NumField(); i++ {
+			f := v.Type().Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			if !first {
+				sb.WriteString(" ")
+			}
+			first = false
+			sb.WriteString(f.Name + ":")
+			showTo(sb, v.Field(i), depth+1)
+		}
+		sb.WriteString("}")
+	case reflect.String:
+		fmt.Fprintf(sb, "%q", v.String())
+	default:
+		fmt.Fprintf(sb, "%v", v.Interface())
+	}
+}
