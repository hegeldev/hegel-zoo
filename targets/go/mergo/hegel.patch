+		src.FieldByName("Emb").Set(reflect.Zero(reflect.PointerTo(embType)))
+		for _, name := range []string{"Ins", "PIns", "MI", "MPI", "Anys", "MA"} {
+			src.FieldByName(name).Set(reflect.Zero(src.FieldByName(name).Type()))
+		}
+		return mergeCase{rt: outerType, o: o, dst: dst, src: src}
+	})
+	shape := evenGens(
