+	mp    *mapCase
+}
+
+func (c eitherCase) GoString() string {
+	if c.merge != nil {
+		return c.merge.GoString()
+	}
+	return c.mp.GoString()
+}
+
+func (c eitherCase) explain(got, want checks) string {
+	if c.merge != nil {
+		return c.merge.explain(got, want)
+	}
+	return c.mp.explain(got, want)
+}
+
+func eitherExpected(c eitherCase, k known) checks {
+	if c.merge != nil {
+		return mergeExpected(*c.merge, k)
+	}
+	return mapExpected(*c.mp, k)
+}
+
+func eitherActual(c *eitherCase) checks {
+	if c.merge != nil {
+		return mergeActual(c.merge)
+	}
+	return mapActual(c.mp)
+}
