+// TestHegelNoDerefOverPointerEntries: under WithoutDereference and WithOverride a map of
+// interfaces whose entry holds a pointer to a scalar on both sides, or two []interface{} holding
+// such pointers at one index under WithSliceDeepCopy: the documented merge replaces the entry
+// (an unaddressable pointer value cannot be assigned, the entry rule then replaces it) and
+// merges the elements (mergo/19: the package assigns the unaddressable value and panics). Judged
+// on the outcome alone (mergo/6 moves the result of the slice form). The source map holds the
+// entry alone. Past the shape under HEGEL_NO_KNOWN=1 the pointers are to Leafs (left alone by
+// the package's rule and replaced by the entry rule), or the destination lacks the entry.
+func TestHegelNoDerefOverPointerEntries(t *testing.T) {
+	og := optsWith(func(o *opts) { o.noDeref, o.override = true, true })
+	withDeepCopy := func(on bool) hegel.Generator[opts] {
+		return hegel.Map(og, func(o opts) opts {
+			o.deepCopy = on
+			if on {
+				o.appendSlice = false // appending comes before the deep copy
+			}
+			return o
+		})
+	}
+	ptrScalar := evenGens(boxed(valueGen(intType, 0)), boxed(valueGen(strType, 0)))
+	ptrLeaf := boxed(valueGen(leafType, 1))
+	entries := func(og hegel.Generator[opts], dg, sg hegel.Generator[reflect.Value], present bool) hegel.Generator[mergeCase] {
+		vals := valueGen(anyMapT, 2)
+		return hegel.Composite(func(tc hegel.TestCase) mergeCase {
+			o := hegel.Draw(tc, og)
+			key := reflect.ValueOf(hegel.Draw(tc, evenHalves(mapKeys...)))
+			dst := hegel.Draw(tc, vals)
+			if dst.IsNil() {
+				dst.Set(reflect.MakeMap(anyMapT))
+			}
+			if present {
+				dst.SetMapIndex(key, boxAnyValue(hegel.Draw(tc, dg)))
