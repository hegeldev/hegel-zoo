+// --------------------------------------------------------------------------- pins
+//
+// One test per recorded bug (bugs.toml), asserting the documented behaviour; they are expected
+// failures while the bug exists. A pin that can panic recovers, so that the test binary goes on.
+
+func noPanic(t *testing.T, f func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("panic: %v", r)
+		}
+	}()
+	f()
+}
+
+// TestHegelPinNilPointerSource: mergo/1. A typed nil pointer as the source is an
+// ErrNilArguments (or any error), not a panic.
+func TestHegelPinNilPointerSource(t *testing.T) {
+	noPanic(t, func() {
+		var dst Leaf
+		if err := mergo.Merge(&dst, (*Leaf)(nil)); err == nil {
+			t.Errorf("Merge(&dst, (*Leaf)(nil)): no error")
+		}
+		var m map[string]interface{}
+		if err := mergo.Map(&dst, (*map[string]interface{})(nil)); err == nil {
+			t.Errorf("Map(&dst, (*map)(nil)): no error, m = %v", m)
+		}
+	})
+}
+
+// TestHegelPinUnexportedMap: mergo/2. Unexported fields are not merged, so an unexported map
+// field is left alone under WithOverwriteWithEmptyValue rather than panicking.
+func TestHegelPinUnexportedMap(t *testing.T) {
+	noPanic(t, func() {
+		dst := Inner{N: 1, pm: map[string]int{"a": 1}}
+		src := Inner{N: 2, pm: map[string]int{"b": 2}}
+		if err := mergo.Merge(&dst, src, mergo.WithOverwriteWithEmptyValue); err != nil {
+			t.Fatalf("Merge: %v", err)
+		}
+		if !reflect.DeepEqual(dst.pm, map[string]int{"a": 1}) {
+			t.Errorf("unexported map merged: %v", dst.pm)
+		}
+	})
+}
+
+// TestHegelPinMapValueType: mergo/3. Map checks that a value is assignable to its field: a value
+// of the field's kind but another type (a plain string for a named string type, a slice or a map
+// of another element type) is set when convertible or reported as a type mismatch, not a panic.
+func TestHegelPinMapValueType(t *testing.T) {
+	noPanic(t, func() {
+		var dst Inner
+		err := mergo.Map(&dst, map[string]interface{}{"c": "red"})
+		if err == nil && dst.C != "red" {
+			t.Errorf("Map({c: red}): C = %q, no error", dst.C)
+		}
+	})
+	noPanic(t, func() {
+		var dst Inner
+		err := mergo.Map(&dst, map[string]interface{}{"m": map[string]interface{}{"a": 1}})
+		if err == nil && !reflect.DeepEqual(dst.M, map[string]int{"a": 1}) {
+			t.Errorf("Map({m: {a: 1}}): M = %v, no error", dst.M)
+		}
+	})
+	noPanic(t, func() {
+		var dst Inner
+		err := mergo.Map(&dst, map[string]interface{}{"sI": []interface{}{1}})
+		if err == nil && !reflect.DeepEqual(dst.SI, []int{1}) {
+			t.Errorf("Map({sI: [1]}): SI = %v, no error", dst.SI)
+		}
+	})
+}
+
+// TestHegelPinNilMapDestination: mergo/4. A nil map[string]interface{} is a valid destination
+// for Map: it is allocated, as a nil map field is by Merge.
+func TestHegelPinNilMapDestination(t *testing.T) {
+	noPanic(t, func() {
