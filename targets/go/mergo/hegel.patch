+		withFields(inner, fieldOf{"A", nonZeroArray}))
+	overridden := mergeCases(innerType, override,
+		withFields(inner, fieldOf{"A", nonZeroArray}),
+		withFields(inner, fieldOf{"A", zeroArray}))
+	past := mergeCases(innerType, plain,
+		withFields(inner, fieldOf{"A", nonZeroArray}),
