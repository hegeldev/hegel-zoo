+// pairedLists draws two []interface{} of the same length (one to three) with the given pair
+// at one index; the destination's other elements are random, the source's nil (nothing is
+// merged from a nil element).
+func pairedLists(dg, sg hegel.Generator[reflect.Value]) hegel.Generator[[2]reflect.Value] {
+	return hegel.Composite(func(tc hegel.TestCase) [2]reflect.Value {
+		n := hegel.Draw(tc, rangeHalves(1, 3))
+		at := hegel.Draw(tc, rangeHalves(0, n-1))
+		ds, ss := make([]reflect.Value, n), make([]reflect.Value, n)
+		for i := 0; i < n; i++ {
+			if i == at {
+				ds[i], ss[i] = boxAnyValue(hegel.Draw(tc, dg)), boxAnyValue(hegel.Draw(tc, sg))
+				continue
+			}
+			ds[i] = hegel.Draw(tc, valueGen(anyType, 1))
+			ss[i] = reflect.New(anyType).Elem()
+		}
+		return [2]reflect.Value{anyList(ds), anyList(ss)}
+	})
+}
