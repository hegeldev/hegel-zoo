+package hegel
+
+// The Map case record, its generators (the map for a struct type, the pre-filled map of a
+// struct) and the wide property on Map (TestHegelMapModel).
+
+import (
+	"fmt"
+	"reflect"
+	"sync"
+	"testing"
+
+	"dario.cat/mergo"
+	"hegel.dev/go/hegel"
+)
+
+var junkKeys = []string{"zzz", "Zzz", "", "n2", "nAme"}
+
+// mapCase is one Map: into a struct (strct the destination, zero when zeroDst; m the source
+// map drawn for the struct type, or ts a typed map built from it, mergo/14; ptrSrc passes a
+// pointer to the map; overwrite uses the deprecated MapWithOverwrite entry point when the
+// options have override) or from a struct (strct the source; m the destination map,
+// pre-filled from another value of the type with entries removed or replaced, with a junk
+// key, or nil, mergo/4, or tm a typed map, mergo/11; ptrSrc passes a pointer to the struct).
+// nilSrc makes the source a typed nil pointer either way (mergo/1; ptrSrc holds). got and
+// panicked are set by the property for the explanation of a failure.
+type mapCase struct {
+	st        reflect.Type
+	o         opts
+	into      bool
+	strct     reflect.Value
+	m         map[string]interface{}
+	ts, tm    reflect.Value
+	zeroDst   bool
+	ptrSrc    bool
+	nilSrc    bool
+	nilDst    bool
+	overwrite bool
+	prefilled bool
+	junk      bool
+
+	got      reflect.Value
+	panicked any
+}
+
+func (c mapCase) GoString() string {
+	how := ""
+	if c.zeroDst {
+		how += " (zero destination)"
+	}
+	switch {
+	case c.nilSrc:
+		how += " (nil pointer source)"
+	case c.ptrSrc:
+		how += " (pointer source)"
+	}
+	if c.into {
+		if c.overwrite && c.o.override {
+			how += " (MapWithOverwrite)"
+		}
+		srcT, src := "map", show(reflect.ValueOf(c.m))
+		switch {
+		case c.nilSrc:
+			srcT, src = "(*map)(nil)", "nil"
+		case c.ts.IsValid():
+			srcT, src = c.ts.Type().String(), show(c.ts)
+		}
+		return fmt.Sprintf("Map(*%s, %s) under %s%s\n  dst %s\n  src %s", c.st, srcT, c.o, how, show(c.strct), src)
+	}
+	if c.prefilled {
+		how += " (pre-filled)"
+	}
+	if c.junk {
+		how += " (junk key)"
+	}
+	dstT, dst := "*map", show(reflect.ValueOf(c.m))
+	switch {
+	case c.nilDst:
+		how += " (nil destination map)"
+		dst = "nil"
+	case c.tm.IsValid():
+		dstT, dst = "*"+c.tm.Type().String(), show(c.tm)
+	}
+	src := "nil"
+	if !c.nilSrc {
+		src = show(c.strct)
+	}
+	return fmt.Sprintf("Map(%s, %s) under %s%s\n  dst %s\n  src %s", dstT, c.st, c.o, how, dst, src)
+}
+
+func (c mapCase) explain(got, want checks) string {
+	out := ""
+	if c.panicked != nil {
+		out += fmt.Sprintf("\n  panic: %v", c.panicked)
+	}
+	if want["result"] != "" && got["result"] != "" && want["result"] != got["result"] && c.got.IsValid() {
+		if _, w := mapModel(c, hzKnownNone); w.IsValid() {
+			d := diffPath(w, c.got, "")
+			if d == "" {
+				d = "(same() finds no difference where canon does)"
+			}
+			out += fmt.Sprintf("\n  %s\n  want %s\n  got  %s", d, show(w), show(c.got))
+		}
+	}
+	out += explainObserved(got, want)
+	return out
+}
+
+// --------------------------------------------------------------------------- the map for a
+// struct type
+
+// fieldEntry is what the source map holds for one exported field: nothing (skipped), a value
+// under the field's key, or (an embedded struct) the entries of its own map, flattened.
+type fieldEntry struct {
+	present bool
+	key     string
+	val     interface{}
+	flat    map[string]interface{}
+}
+
+var (
+	mapForGensMu sync.Mutex
+	mapForGens   = map[valueKey]hegel.Generator[map[string]interface{}]{}
+)
+
+// mapForGen makes a map[string]interface{} for the fields of struct type t: values of the
+// field's type mostly, sometimes behind a pointer, a nested map for a struct field, a value
+// of another kind (an error), a value of the field's kind but another type (mergo/3), a typed
+// nil pointer (mergo/5) or nothing; embedded structs appear under their own key or through
+// their promoted fields, Outer's embedded *Emb too (mergo/13 when it is nil); a junk key one
+// time in five.
+func mapForGen(t reflect.Type, depth int) hegel.Generator[map[string]interface{}] {
+	mapForGensMu.Lock()
+	defer mapForGensMu.Unlock()
+	return mapForGenLocked(t, depth)
+}
+
+func mapForGenLocked(t reflect.Type, depth int) hegel.Generator[map[string]interface{}] {
+	key := valueKey{t, depth}
+	if g, ok := mapForGens[key]; ok {
+		return g
+	}
+	var fields []hegel.Generator[fieldEntry]
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.PkgPath != "" {
+			continue
+		}
+		fields = append(fields, fieldGen(f, depth))
+	}
+	junk := hegel.Composite(func(tc hegel.TestCase) fieldEntry {
+		if !hegel.Draw(tc, hzChance(1, 5)) { // junk key 20 nominal
+			return fieldEntry{}
+		}
+		k := hegel.Draw(tc, evenHalves(junkKeys...))
+		return fieldEntry{present: true, key: k, val: hegel.Draw(tc, rangeHalves(0, 2))}
+	})
+	g := hegel.Map(hzTuple(append(fields, junk)...), func(es []fieldEntry) map[string]interface{} {
+		out := map[string]interface{}{}
+		for _, e := range es {
+			if e.flat != nil {
+				for k, v := range e.flat {
+					out[k] = v
+				}
+			} else if e.present {
+				out[e.key] = e.val
+			}
+		}
+		return out
+	})
+	mapForGens[key] = g
+	return g
+}
+
+// valued is the entry of a drawn value under the field's key.
+func valued(key string, g hegel.Generator[reflect.Value]) hegel.Generator[fieldEntry] {
+	return hegel.Map(g, func(v reflect.Value) fieldEntry { return fieldEntry{present: true, key: key, val: v.Interface()} })
+}
+
+// nilEntry is the entry of an untyped nil under the key; typedNilEntry the entry of a typed
+// nil pointer to the type (mergo/5's shape for a non-pointer field).
+func nilEntry(key string) hegel.Generator[fieldEntry] {
+	return hegel.Map(hegel.Just(key), func(key string) fieldEntry { return fieldEntry{present: true, key: key, val: nil} })
+}
+
+func typedNilEntry(key string, t reflect.Type) hegel.Generator[fieldEntry] {
+	return hegel.Map(hegel.Just(key), func(key string) fieldEntry {
+		return fieldEntry{present: true, key: key, val: reflect.Zero(reflect.PointerTo(t)).Interface()}
+	})
+}
+
+// otherStruct is a struct type of the universe other than t (a value of it for a struct
+// field has the field's kind but another type, mergo/3).
+func otherStruct(t reflect.Type) reflect.Type {
+	if t == leafType {
+		return embType
+	}
+	return leafType
+}
+
+// fieldGen is the source map's entry for one exported field: an embedded struct (by value,
+// or Outer's pointer) is flattened one time in two (realised 51.1 for Inner's Leaf); else
+// the field is skipped 15 times in 100 (realised 14.1 for Inner's C, 15.1 for SI, 11.4 for
+// Outer's In, 16.3 for Leaf when not flattened); else a value of another kind 3 times in 100
+// (a type mismatch error; a struct for a pointer too), a value of the field's kind but
+// another type 3 times in 100 (mergo/3: a string for the Color, a map[string]interface{} for
+// a typed map, a []interface{} for a typed slice, a struct of another type for a struct field
+// but the time; realised of the present entries: 2.8 for C, 3.4 for SI, 3.8 for In, 4.4 for
+// Leaf), else by the field's type, with a typed nil pointer at a third of the untyped nil's
+// share for the non-pointer fields (mergo/5; realised 2.3 for C, 2.2 for SI, 2.4 for In, 3.2
+// for Leaf; a typed nil for a pointer field is the documented empty value, mergo/10's
+// region). Over the whole Map population the present entries realise typed nil 2.2, kind
+// but not type 1.4, another kind 2.5, untyped nil 8.8, a pointer to the value 4.9, a nested
+// map 4.7 (the fields without an alternative dilute the shares). The alternatives of the
+// recorded bugs are never drawn under HEGEL_NO_KNOWN=1.
+func fieldGen(f reflect.StructField, depth int) hegel.Generator[fieldEntry] {
+	key := lowerFirst(f.Name)
+	ft := f.Type
+	skip := hegel.Map(hegel.Just(key), func(string) fieldEntry { return fieldEntry{} })
+	var mismatch hegel.Generator[fieldEntry]
+	x := hegel.Map(hegel.Just(key), func(key string) fieldEntry { return fieldEntry{present: true, key: key, val: "x"} })
+	switch {
+	case ft == anyType:
+		mismatch = nil
+	case ft.Kind() == reflect.String:
+		mismatch = hegel.Map(rangeHalves(0, 3), func(n int) fieldEntry { return fieldEntry{present: true, key: key, val: n} })
+	case ft.Kind() == reflect.Pointer && ft.Elem() != timeType:
+		mismatch = dieChoice(hzW(50, valued(key, valueGen(ft.Elem(), depth))), hzW(50, x))
+	default:
+		mismatch = x
+	}
+	var other hegel.Generator[fieldEntry]
+	switch {
+	case ft == colorType:
+		other = valued(key, valueGen(strType, depth))
+	case ft.Kind() == reflect.Map && ft != anyMapT:
+		other = valued(key, valueGen(anyMapT, 0))
+	case ft.Kind() == reflect.Slice && ft != anySliceT:
+		other = valued(key, valueGen(anySliceT, 0))
+	case ft.Kind() == reflect.Struct && ft != timeType:
+		other = valued(key, valueGen(otherStruct(ft), 0))
+	}
+	typedNil := hzUnless(hzNoKnown, 3)
+	var typed hegel.Generator[fieldEntry]
+	switch {
+	case ft == timeType:
+		typed = halvesGens([]int{97, typedNil}, valued(key, valueGen(ft, depth)), typedNilEntry(key, ft)) // typed nil 3 nominal: realised 1.8 of Inner's t entries
+	case ft == anyType:
+		typed = halvesGens([]int{97, typedNil}, // typed nil 3 nominal: a (*Leaf)(nil), the one typed nil anyGen holds (realised 3.8 of Inner's any entries)
+			hegel.Map(valueGen(anyType, depth), func(v reflect.Value) fieldEntry {
+				if v.IsNil() || (v.Elem().Kind() == reflect.Pointer && v.Elem().IsNil()) {
+					return fieldEntry{present: true, key: key, val: nil}
+				}
+				return fieldEntry{present: true, key: key, val: v.Interface()}
+			}),
+			typedNilEntry(key, leafType),
+		)
+	case ft.Kind() == reflect.Struct:
+		typed = halvesGens([]int{45, 52, typedNil}, // nested map 45, value 52, typed nil 3 nominal: realised 39.4, 51.2, 3.2 of Inner's leaf entries
+			hegel.Map(mapForGenLocked(ft, depth-1), func(m map[string]interface{}) fieldEntry { return fieldEntry{present: true, key: key, val: m} }),
+			valued(key, valueGen(ft, depth)),
+			typedNilEntry(key, ft),
+		)
+	case ft.Kind() == reflect.Pointer && ft.Elem().Kind() == reflect.Struct && ft.Elem() != timeType:
+		typed = halvesGens([]int{4, 1, 5}, // nested map 40, nil 10, value 50 nominal
+			hegel.Map(mapForGenLocked(ft.Elem(), depth-1), func(m map[string]interface{}) fieldEntry { return fieldEntry{present: true, key: key, val: m} }),
+			nilEntry(key),
+			valued(key, valueGen(ft, depth)),
+		)
+	case ft.Kind() == reflect.Pointer:
+		typed = dieChoice(hzW(10, nilEntry(key)), hzW(90, valued(key, valueGen(ft, depth)))) // nil 10 nominal
+	case ft.Kind() == reflect.Map, ft.Kind() == reflect.Slice, ft.Kind() == reflect.Array:
+		typed = halvesGens([]int{10, 87, typedNil}, nilEntry(key), valued(key, valueGen(ft, depth)), typedNilEntry(key, ft)) // nil 10, typed nil 3 nominal: realised 9.5 and 2.2 of Inner's sI entries, 5.7 and 2.7 of its a entries
+	default: // scalars, sometimes behind a pointer
+		typed = halvesGens([]int{10, 20, 67, typedNil}, // nil 10, pointer 20, value 67, typed nil 3 nominal: realised 9.0, 18.6, 64.5, 2.3 of Inner's c entries
+			nilEntry(key),
+			hegel.Map(valueGen(ft, depth), func(v reflect.Value) fieldEntry {
+				p := reflect.New(ft)
+				p.Elem().Set(v)
+				return fieldEntry{present: true, key: key, val: p.Interface()}
+			}),
+			valued(key, valueGen(ft, depth)),
+			typedNilEntry(key, ft),
+		)
+	}
+	var plain hegel.Generator[fieldEntry]
+	switch {
+	case mismatch == nil:
+		plain = typed
+	case other == nil:
+		plain = dieChoice(hzW(3, mismatch), hzW(97, typed)) // mismatch 3 nominal: realised 3.4 of the present
+	default:
+		plain = halvesGens([]int{3, 94, hzUnless(hzNoKnown, 3)}, mismatch, typed, other) // mismatch 3, kind-but-not-type 3 nominal: realised 2.7 and 2.8 of Inner's c entries, 2.7 and 3.4 of its sI, 1.5 and 3.8 of Outer's in, 1.9 and 4.4 of Inner's leaf
+	}
+	plain = dieChoice(hzW(15, skip), hzW(85, plain)) // skipped 15 nominal: realised 13.9 of the fields
+	if f.Anonymous && (ft.Kind() == reflect.Struct || (ft.Kind() == reflect.Pointer && ft.Elem().Kind() == reflect.Struct)) {
+		st := ft
+		if ft.Kind() == reflect.Pointer {
+			st = ft.Elem()
+		}
+		flat := hegel.Map(mapForGenLocked(st, depth), func(m map[string]interface{}) fieldEntry {
+			if m == nil {
+				m = map[string]interface{}{}
+			}
+			return fieldEntry{flat: m}
+		})
+		return dieChoice(hzW(50, flat), hzW(50, plain)) // flattened 50 nominal: realised 51.1 (Inner's Leaf), Outer's e and eS keys 38.7 and 38.9 of its maps, emb 45.8
+	}
+	return plain
+}
+
+// mapStructTypes are the struct types mapped from and into maps (the repeats the weights).
+var mapStructTypes = []reflect.Type{leafType, innerType, innerType, outerType, outerType, embType}
+
+// typedMapOf is the entries of m whose value is exactly of type elem, as a map[string]elem
+// (the typed source map of mergo/14: the keys of the struct's fields of that type, the junk
+// key when its value is an int; the other entries dropped).
+func typedMapOf(m map[string]interface{}, elem reflect.Type) reflect.Value {
+	out := reflect.MakeMap(reflect.MapOf(strType, elem))
+	for k, v := range m {
+		if v != nil && reflect.TypeOf(v) == elem {
+			out.SetMapIndex(reflect.ValueOf(k), reflect.ValueOf(v))
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the pre-filled
+// map of a struct
+
+// edit is what happens to one key of the pre-filled map (one per exported field of the
+// struct, in field order): removed, replaced by a string atom, or kept (two faces).
+type edit struct {
+	kind int // 0 removed, 1 replaced, 2 and 3 kept
+	repl string
+}
+
+var editGen = hegel.Composite(func(tc hegel.TestCase) edit {
+	return edit{kind: hegel.Draw(tc, rangeHalves(0, 3)), repl: hegel.Draw(tc, evenHalves(stringAtoms...))}
+})
+
+// prefill is the pre-filled destination map of the struct -> map direction: nothing, or the
+// map of another value of the type (mapFrom, no options) with its keys removed, replaced or
+// kept, then a junk key or not.
+type prefill struct {
+	other reflect.Value
+	edits []edit
+	junk  bool
+	jkey  string
+	jval  int
+}
+
+func prefillGen(st reflect.Type) hegel.Generator[prefill] {
+	n := 0
+	for i := 0; i < st.NumField(); i++ {
+		if st.Field(i).PkgPath == "" {
+			n++
+		}
+	}
+	other := valueGen(st, 2)
+	edits := hzCounted(editGen, n, n)
+	filled := hegel.Composite(func(tc hegel.TestCase) prefill {
+		return prefill{other: hegel.Draw(tc, other), edits: hegel.Draw(tc, edits)}
+	})
+	base := dieChoice(hzW(33, hegel.Map(hegel.Just(0), func(int) prefill { return prefill{} })), hzW(67, filled)) // pre-filled 70 nominal: 30/70 realised 74.8, this 75.5 (75.2 of the map[string]interface{} destinations of the second part)
+	return hegel.Composite(func(tc hegel.TestCase) prefill {
+		p := hegel.Draw(tc, base)
+		if hegel.Draw(tc, hzChance(3, 10)) { // junk key 30 nominal: realised 24.4 of the from cases
+			p.junk = true
+			p.jkey = hegel.Draw(tc, evenHalves(junkKeys...))
+			p.jval = hegel.Draw(tc, rangeHalves(0, 2))
+		}
+		return p
+	})
+}
+
+// build is the destination map of the pre-fill.
+func (p prefill) build() map[string]interface{} {
+	dst := reflect.ValueOf(map[string]interface{}{})
+	if p.other.IsValid() {
+		m := &mm{}
+		m.mapFrom(dst, p.other)
+		t := p.other.Type()
+		j := 0
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			k := reflect.ValueOf(lowerFirst(f.Name))
+			switch p.edits[j].kind {
+			case 0:
+				dst.SetMapIndex(k, reflect.Value{})
+			case 1:
+				dst.SetMapIndex(k, reflect.ValueOf(p.edits[j].repl))
+			}
+			j++
+		}
+	}
+	if p.junk {
+		dst.SetMapIndex(reflect.ValueOf(p.jkey), reflect.ValueOf(p.jval))
+	}
+	return dst.Interface().(map[string]interface{})
+}
+
+// mapDst is the destination of the struct -> map direction: the pre-filled map, a nil map
+// (mergo/4) or a typed map (mergo/11: map[string]int, map[string]string or map[string]Leaf,
+// its entries by valueGen of the type).
+type mapDst struct {
+	m         map[string]interface{}
+	nilDst    bool
+	typed     reflect.Value
+	prefilled bool
+	junk      bool
+}
+
+var typedMapTypes = []reflect.Type{mapIntT, mapStrT, reflect.TypeOf(map[string]Leaf{})}
+
+func dstGen(st reflect.Type) hegel.Generator[mapDst] {
+	pre := hegel.Map(prefillGen(st), func(p prefill) mapDst {
+		return mapDst{m: p.build(), prefilled: p.other.IsValid(), junk: p.junk}
+	})
+	nilDst := hegel.Map(hegel.Just(0), func(int) mapDst { return mapDst{nilDst: true} })
+	typed := hegel.Map(hegel.FlatMap(evenHalves(typedMapTypes...), func(t reflect.Type) hegel.Generator[reflect.Value] { return valueGen(t, 1) }),
+		func(v reflect.Value) mapDst { return mapDst{typed: v} })
+	return halvesGens([]int{84, hzUnless(hzNoKnown, 8), hzUnless(hzNoKnown, 8)}, pre, nilDst, typed) // nil 8, typed 8 nominal of the from cases: realised 6.4 and 7.9 (map[string]Leaf 2.8, map[string]int 2.5, map[string]string 2.7)
+}
+
+// --------------------------------------------------------------------------- the cases
+
+// typedSrcGen is the element type of the typed source map of the map -> struct direction
+// (mergo/14), 8 times in 100 of the into cases, nil for the map[string]interface{} itself.
+var typedSrcGen = halvesGens([]int{92, hzUnless(hzNoKnown, 8)}, hegel.Just[reflect.Type](nil), evenHalves(intType, strType)) // typed 8 nominal: realised 6.3 of the into cases (map[string]int 3.1, map[string]string 3.2)
+
+// intoGen is the map -> struct cases of one struct type: the options (the deprecated entry
+// point off), the destination at depth 2 (zero 30 times in 100), a typed nil pointer source
+// (the nil coin), or the map for the type, a pointer source 20 times in 100, MapWithOverwrite
+// 20 times in 100 (when override is on), and the map rebuilt as a typed map 8 times in 100.
+func intoGen(st reflect.Type) hegel.Generator[mapCase] {
+	vals, maps := valueGen(st, 2), mapForGen(st, 2)
+	return hegel.Composite(func(tc hegel.TestCase) mapCase {
+		o := hegel.Draw(tc, optsGen)
+		o.deprecated = false
+		dst := hegel.Draw(tc, vals)
+		zero := hegel.Draw(tc, hzChance(3, 10)) // zeroDst 30 nominal: realised 32.9, 31.2 with the nil coin
+		if zero {
+			dst = reflect.New(st).Elem()
+		}
+		if hegel.Draw(tc, nilSrcCoin) {
+			return mapCase{st: st, o: o, into: true, strct: dst, zeroDst: zero, ptrSrc: true, nilSrc: true}
+		}
+		src := hegel.Draw(tc, maps)
+		ptr := hegel.Draw(tc, hzChance(1, 5))       // ptrSrc 20 nominal: realised 20.5, 19.5 of the cases with a map
+		overwrite := hegel.Draw(tc, hzChance(1, 5)) // MapWithOverwrite 20 nominal (of the override cases): realised 20.5
+		c := mapCase{st: st, o: o, into: true, strct: dst, m: src, zeroDst: zero, ptrSrc: ptr, overwrite: overwrite}
+		if elem := hegel.Draw(tc, typedSrcGen); elem != nil {
+			c.ts = typedMapOf(src, elem)
+		}
+		return c
+	})
+}
+
+// fromGen is the struct -> map cases of one struct type: the options, the source at depth 2
+// (or a typed nil pointer, the nil coin), the destination map, a pointer source 20 times in
+// 100.
+func fromGen(st reflect.Type) hegel.Generator[mapCase] {
+	vals, dsts := valueGen(st, 2), dstGen(st)
+	return hegel.Composite(func(tc hegel.TestCase) mapCase {
+		o := hegel.Draw(tc, optsGen)
+		o.deprecated = false
+		src := hegel.Draw(tc, vals)
+		nilSrc := hegel.Draw(tc, nilSrcCoin)
+		d := hegel.Draw(tc, dsts)
+		ptr := hegel.Draw(tc, hzChance(1, 5)) // ptrSrc 20 nominal: realised 20.0, 19.8 of the cases with a source
+		return mapCase{st: st, o: o, strct: src, m: d.m, tm: d.typed, nilDst: d.nilDst, ptrSrc: ptr || nilSrc, nilSrc: nilSrc, prefilled: d.prefilled, junk: d.junk}
+	})
+}
+
+// mapGen: into a struct or from one (evenly), the struct type at the weights of its repeats
+// in mapStructTypes (Leaf 1, Inner 2, Outer 2, Emb 1); into a zero Leaf from an empty map is
+// the shrink target.
+var mapGen = func() hegel.Generator[mapCase] {
+	var types []reflect.Type
+	var weights []int
+	for _, t := range mapStructTypes {
+		if n := len(types); n > 0 && types[n-1] == t {
+			weights[n-1]++
+			continue
+		}
+		types = append(types, t)
+		weights = append(weights, 1)
+	}
+	intos := make([]hegel.Generator[mapCase], len(types))
+	froms := make([]hegel.Generator[mapCase], len(types))
+	for i, t := range types {
+		intos[i], froms[i] = intoGen(t), fromGen(t)
+	}
+	return dieChoice(hzW(50, halvesGens(weights, intos...)), hzW(50, halvesGens(weights, froms...))) // into 50 nominal: realised 49.3, 50.5 in the second part (Leaf 13.1, Inner 35.5, Outer 34.7, Emb 16.7)
+}()
+
+// mapActual runs the library on copies of the case's values and states its outcome and
+// result, with the destination's pointer targets (collected before the call) and private
+// maps after it.
+func mapActual(c *mapCase) checks {
+	if c.into {
+		dst := deepCopy(c.strct)
+		var srcArg interface{}
+		switch {
+		case c.nilSrc:
+			srcArg = (*map[string]interface{})(nil)
+		case c.ts.IsValid():
+			src := deepCopy(c.ts)
+			srcArg = src.Interface()
+			if c.ptrSrc {
+				srcArg = src.Addr().Interface()
+			}
+		default:
+			src := deepCopy(reflect.ValueOf(c.m)).Interface().(map[string]interface{})
+			srcArg = src
+			if c.ptrSrc {
+				srcArg = &src
+			}
+		}
+		hs := handlesOf(dst)
+		err, panicked := hzCall(func() error {
+			if c.o.override && c.overwrite {
+				return mergo.MapWithOverwrite(dst.Addr().Interface(), srcArg, c.o.funcs()...)
+			}
+			return mergo.Map(dst.Addr().Interface(), srcArg, c.o.funcs()...)
+		})
+		c.got, c.panicked = dst, panicked
+		return mergeStatement(outcomeOf(err, panicked), dst, observed{handles: showHandles(hs), private: privateOf(dst)})
+	}
+	var srcArg interface{}
+	if c.nilSrc {
+		srcArg = reflect.Zero(reflect.PointerTo(c.st)).Interface()
+	} else {
+		src := deepCopy(c.strct)
+		srcArg = src.Interface()
+		if c.ptrSrc {
+			srcArg = src.Addr().Interface()
+		}
+	}
+	var dm reflect.Value
+	switch {
+	case c.nilDst:
+		dm = reflect.New(anyMapT).Elem()
+	case c.tm.IsValid():
+		dm = deepCopy(c.tm)
+	default:
+		dm = deepCopy(reflect.ValueOf(c.m))
+	}
+	hs := handlesOf(dm)
+	err, panicked := hzCall(func() error { return mergo.Map(dm.Addr().Interface(), srcArg, c.o.funcs()...) })
+	c.got, c.panicked = dm, panicked
+	return mergeStatement(outcomeOf(err, panicked), dm, observed{handles: showHandles(hs), private: privateOf(dm)})
+}
+
+// TestHegelMapModel: Map does what the documented model says, in both directions. Under
+// HEGEL_NO_KNOWN=1 the cases with the shape of a recorded bug are not drawn (withoutShapes).
+func TestHegelMapModel(t *testing.T) {
+	judged(t, withoutShapes(mapExpected, mapGen), func(j *hzCaseJudge, c mapCase) {
+		judgeBy(j, &c, mapExpected, mapActual)
+	})
+}
diff --git a/hegel/hegel_zoo_merge_test.go b/hegel/hegel_zoo_merge_test.go
new file mode 100644
index 0000000..5a845a4
--- /dev/null
+++ b/hegel/hegel_zoo_merge_test.go
@@ -0,0 +1,320 @@
+package hegel
+
+// The merge case record, its generators and the two wide properties on Merge: the model
+// (TestHegelMergeModel) and the laws (TestHegelMergeLaws).
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// mergeCase is one merge: the root type, the options, the destination (zero when zeroDst)
+// and the source, both drawn by valueGen(rt, 2), and whether the source is passed by pointer
+// (dereferenced by the package) or is a typed nil pointer (nilSrc, mergo/1: no source is
+// drawn then, ptrSrc holds). The library runs on deep copies under the judge; got is the
+// destination it left and panicked what it panicked with (set by the property, for the
+// explanation of a failure).
+type mergeCase struct {
+	rt       reflect.Type
+	o        opts
+	dst, src reflect.Value
+	zeroDst  bool
+	ptrSrc   bool
+	nilSrc   bool
+
+	got      reflect.Value
+	panicked any
+}
+
+func (c mergeCase) GoString() string {
+	how := ""
+	if c.zeroDst {
+		how += " (zero destination)"
+	}
+	src := "nil"
+	switch {
+	case c.nilSrc:
+		how += " (nil pointer source)"
+	case c.ptrSrc:
+		how += " (pointer source)"
+	}
+	if !c.nilSrc {
+		src = show(c.src)
+	}
+	return fmt.Sprintf("Merge(%s) under %s%s\n  dst %s\n  src %s", c.rt, c.o, how, show(c.dst), src)
+}
+
+// explain adds the path of the first difference between the documented result and the
+// library's, with both values, the first differing handle or private map, and the panic
+// text, as the properties always printed them.
+func (c mergeCase) explain(got, want checks) string {
+	return explainResult(c.o, c.dst, c.src, c.got, c.panicked, got, want)
+}
+
+func explainResult(o opts, dst, src, got reflect.Value, panicked any, g, w checks) string {
+	out := ""
+	if panicked != nil {
+		out += fmt.Sprintf("\n  panic: %v", panicked)
+	}
+	if w["result"] != "" && g["result"] != "" && w["result"] != g["result"] && got.IsValid() && src.IsValid() {
+		_, want, _ := modelMerge(dst, src, o, hzKnownNone)
+		d := diffPath(want, got, "")
+		if d == "" {
+			d = "(same() finds no difference where canon does)"
+		}
+		out += fmt.Sprintf("\n  %s\n  want %s\n  got  %s", d, show(want), show(got))
+	}
+	out += explainObserved(g, w)
+	return out
+}
+
+// explainObserved is the first handle (or private map) on which the library's values and
+// the model's differ.
+func explainObserved(g, w checks) string {
+	out := ""
+	for _, name := range []string{"handles", "private"} {
+		if w[name] == "" || g[name] == "" || w[name] == g[name] {
+			continue
+		}
+		ws, gs := strings.Split(w[name], "; "), strings.Split(g[name], "; ")
+		for i := 0; i < len(ws) || i < len(gs); i++ {
+			a, b := "(none)", "(none)"
+			if i < len(ws) {
+				a = ws[i]
+			}
+			if i < len(gs) {
+				b = gs[i]
+			}
+			if a != b {
+				out += fmt.Sprintf("\n  %s: want %s\n  got  %s", name, a, b)
+				break
+			}
+		}
+	}
+	return out
+}
+
+// nilSrcCoin is whether the source is a typed nil pointer (mergo/1): 5 times in 100, never
+// under HEGEL_NO_KNOWN=1 (draw-free then).
+var nilSrcCoin = dieCoin(hzUnless(hzNoKnown, 5)) // 5 nominal: realised 3.5 of the merge cases, 3.9 of the Map into cases, 4.8 of the from cases
+
+// caseGen is the merge cases of one root type: the options, the destination at depth 2, a
+// zero destination 15 times in 100, then the source at depth 2 and a pointer source 30
+// times in 100, unless the nil coin makes the source a typed nil pointer (no source draws).
+func caseGen(rt reflect.Type, nilSrc hegel.Generator[bool]) hegel.Generator[mergeCase] {
+	vals := valueGen(rt, 2)
+	return hegel.Composite(func(tc hegel.TestCase) mergeCase {
+		o := hegel.Draw(tc, optsGen)
+		dst := hegel.Draw(tc, vals)
+		zero := hegel.Draw(tc, hzChance(3, 20)) // zeroDst 15 nominal: realised 13.9, 13.8 with the nil coin
+		if zero {
+			dst = reflect.New(rt).Elem()
+		}
+		if hegel.Draw(tc, nilSrc) {
+			return mergeCase{rt: rt, o: o, dst: dst, zeroDst: zero, ptrSrc: true, nilSrc: true}
+		}
+		src := hegel.Draw(tc, vals)
+		ptr := hegel.Draw(tc, hzChance(3, 10)) // ptrSrc 30 nominal: realised 29.6, 29.2 of the cases with a source
+		return mergeCase{rt: rt, o: o, dst: dst, src: src, zeroDst: zero, ptrSrc: ptr}
+	})
+}
+
+// rootWeights are the weights rootGen draws the root types at, the nominal shares being the
+// repeats in rootTypes (Outer 3, Inner 2, Leaf 1, map[string]interface{} 2, the other maps
+// and the slices 1 each of 15): the engine draws the small cases (Leaf, []int) again when
+// their choice sequence repeats an earlier case's, so their realised shares drift (at the
+// nominal weights Leaf realised 9.2 for 6.7 and []int 4.2) and the weights are tuned by the
+// probe's measure (at these: Outer 19.0, Inner 13.7, Leaf 5.3, map[string]interface{} 16.8,
+// map[string]Inner 6.6, map[string]*Leaf 6.0, map[string][]int 4.9, []Inner 6.0, []*Leaf 8.0,
+// []int 8.5, []interface{} 5.2; with the nil coin of the second part: Outer 20.9, Inner 13.9,
+// Leaf 3.7, map[string]interface{} 12.7, map[string]Inner 6.1, map[string]*Leaf 6.7,
+// map[string][]int 4.1, []Inner 8.9, []*Leaf 6.5, []int 9.4, []interface{} 7.0).
+var rootWeights = []int{9, 6, 2, 7, 3, 3, 3, 3, 3, 4, 3}
+
+// rootGenWith draws a case of one of the root types with the nil coin given; Outer with zero
+// values and no options is the shrink target.
+func rootGenWith(nilSrc hegel.Generator[bool]) hegel.Generator[mergeCase] {
+	var types []reflect.Type
+	for _, t := range rootTypes {
+		if n := len(types); n > 0 && types[n-1] == t {
+			continue
+		}
+		types = append(types, t)
+	}
+	gens := make([]hegel.Generator[mergeCase], len(types))
+	for i, t := range types {
+		gens[i] = caseGen(t, nilSrc)
+	}
+	return halvesGens(rootWeights, gens...)
+}
+
+// rootGen is the merge model's cases; lawRootGen the laws', which keep their population
+// (a nil source is not a case of the laws: nilSrc is never drawn there).
+var (
+	rootGen    = rootGenWith(nilSrcCoin)
+	lawRootGen = rootGenWith(hegel.Just(false))
+)
+
+// mergeActual runs the library on copies of the case's values and states its outcome and
+// result, with the destination's pointer targets (collected before the call) and private
+// maps after it.
+func mergeActual(c *mergeCase) checks {
+	dst := deepCopy(c.dst)
+	var srcArg interface{}
+	if c.nilSrc {
+		srcArg = reflect.Zero(reflect.PointerTo(c.rt)).Interface()
+	} else {
+		src := deepCopy(c.src)
+		srcArg = src.Interface()
+		if c.ptrSrc {
+			srcArg = src.Addr().Interface()
+		}
+	}
+	hs := handlesOf(dst)
+	err, panicked := hzCall(func() error { return c.o.merge(dst.Addr().Interface(), srcArg) })
+	c.got, c.panicked = dst, panicked
+	return mergeStatement(outcomeOf(err, panicked), dst, observed{handles: showHandles(hs), private: privateOf(dst)})
+}
+
+// TestHegelMergeModel: Merge does what the documented model says, for every option. Under
+// HEGEL_NO_KNOWN=1 the cases with the shape of a recorded bug are not drawn (withoutShapes).
+func TestHegelMergeModel(t *testing.T) {
+	judged(t, withoutShapes(mergeExpected, rootGen), func(j *hzCaseJudge, c mergeCase) {
+		judgeBy(j, &c, mergeExpected, mergeActual)
+	})
+}
+
+// --------------------------------------------------------------------------- laws
+
+const (
+	lawSource = iota // the source is not modified
+	lawZero          // a zero source changes nothing (unless empty values override)
+	lawIdem          // merging the same source twice is the same as once (unless appending)
+)
+
+var lawNames = []string{"source law", "zero law", "idempotence law"}
+
+// lawCase is a merge case under one of the laws, with the options the law needs off turned
+// off (the zero law: owe, and oes with override; idempotence: append and transformers, the
+// transformer's error depending on what the merge reaches).
+type lawCase struct {
+	law int
+	mergeCase
+	once reflect.Value // the idempotence law: the destination after the first merge
+}
+
+func (c lawCase) GoString() string {
+	return lawNames[c.law] + ": " + c.mergeCase.GoString()
+}
+
+func (c lawCase) explain(got, want checks) string {
+	out := ""
+	if c.panicked != nil {
+		out += fmt.Sprintf("\n  panic: %v", c.panicked)
+	}
+	switch c.law {
+	case lawSource:
+		if want["source"] != "" && got["source"] != "" && want["source"] != got["source"] && c.got.IsValid() {
+			out += fmt.Sprintf("\n  %s\n  before %s\n  after  %s", diffPath(c.src, c.got, ""), show(c.src), show(c.got))
+		}
+	case lawZero:
+		if want["result"] != "" && got["result"] != "" && want["result"] != got["result"] && c.got.IsValid() {
+			out += fmt.Sprintf("\n  %s\n  before %s\n  after  %s", diffPath(c.dst, c.got, ""), show(c.dst), show(c.got))
+		}
+		out += explainObserved(got, want)
+	default:
+		if c.once.IsValid() && c.got.IsValid() && got["idempotent"] != want["idempotent"] {
+			out += fmt.Sprintf("\n  once  %s\n  twice %s", show(c.once), show(c.got))
+		}
+	}
+	return out
+}
+
+// lawGen: one of the three laws (evenly: at one weight each the source law realised 28.6, at
+// 4/3/3 40.2; at these 36.6, 29.2, 34.3, re-measured 38.5, 26.4, 35.2) over a root case
+// without the nil coin (lawRootGen:
+// the laws keep their population, a typed nil pointer source being mergo/1's shape and no
+// merge).
+var lawGen = hegel.Composite(func(tc hegel.TestCase) lawCase {
+	law := hegel.Draw(tc, halvesOver([]int{7, 6, 6}, lawSource, lawZero, lawIdem))
+	c := hegel.Draw(tc, lawRootGen)
+	switch law {
+	case lawZero:
+		if c.o.owe || (c.o.oes && c.o.override) {
+			c.o.owe, c.o.oes = false, false
+		}
+	case lawIdem:
+		c.o.appendSlice, c.o.transformers = false, false
+	}
+	return lawCase{law: law, mergeCase: c}
+})
+
+// lawActual runs the law on the library: the source law merges and states the source after;
+// the zero law merges a zero source and states the destination after (its pointer targets
+// and private maps too); the idempotence law merges twice and states whether the second
+// merge changed anything.
+func lawActual(c *lawCase) checks {
+	dst, src := deepCopy(c.dst), deepCopy(c.src)
+	merge := func(s reflect.Value) string {
+		err, panicked := hzCall(func() error { return c.o.merge(dst.Addr().Interface(), s.Interface()) })
+		c.panicked = panicked
+		return outcomeOf(err, panicked)
+	}
+	switch c.law {
+	case lawSource:
+		outcome := merge(src)
+		c.got = src
+		out := checks{"outcome": outcome}
+		if outcome == "ok" {
+			out["source"] = canon(src)
+		}
+		return out
+	case lawZero:
+		hs := handlesOf(dst)
+		outcome := merge(reflect.New(c.rt).Elem())
+		c.got = dst
+		return mergeStatement(outcome, dst, observed{handles: showHandles(hs), private: privateOf(dst)})
+	}
+	outcome := merge(src)
+	out := checks{"outcome": outcome}
+	if outcome != "ok" {
+		return out
+	}
+	once := deepCopy(dst)
+	c.once = once
+	second := merge(src)
+	c.got = dst
+	out["second"] = second
+	if second == "ok" {
+		if d := diffPath(once, dst, ""); d == "" {
+			out["idempotent"] = "yes"
+		} else {
+			out["idempotent"] = "no: " + d
+		}
+	}
+	return out
+}
+
+// TestHegelMergeLaws: laws that hold whatever the model says. The source is left alone; a zero
+// source changes nothing (unless empty values override); merging the same source twice is the
+// same as once (unless appending). Each case is judged against the law's statement, which is
+// what the model states with every switch off (checked: "zero law model deviates" counts the
+// cases where the documented model says a zero source changes something, which it never
+// does), and classified by the model. Under HEGEL_NO_KNOWN=1 the cases with a shape are not
+// drawn (withoutShapes).
+func TestHegelMergeLaws(t *testing.T) {
+	judged(t, withoutShapes(lawExpected, lawGen), func(j *hzCaseJudge, c lawCase) {
+		if c.law == lawZero {
+			want := lawExpected(c, hzKnownNone)
+			if want["outcome"] != "ok" || want["result"] != canon(c.dst) {
+				hzTally("zero law model deviates")
+				j.Note("the documented model says a zero source changes the destination: %s", diffChecks(checks{"outcome": "ok", "result": canon(c.dst)}, want))
+			}
+		}
+		judgeBy(j, &c, lawExpected, lawActual)
+	})
+}
diff --git a/hegel/hegel_zoo_model_test.go b/hegel/hegel_zoo_model_test.go
new file mode 100644
index 0000000..4083e32
--- /dev/null
+++ b/hegel/hegel_zoo_model_test.go
@@ -0,0 +1,999 @@
+package hegel
+
+// The model: the options, the transformers, the documented Merge and Map with the switch set
+// threaded (a replica of a recorded bug behind each switch), and the statements the
+// properties judge the library against (mergeExpected, mapExpected, the laws' statements),
+// pure functions of (case, known).
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"dario.cat/mergo"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- options
+
+// opts are the merge options of one test case.
+type opts struct {
+	override     bool // WithOverride: non-empty src attributes override non-empty dst ones
+	owe          bool // WithOverwriteWithEmptyValue: empty src attributes override too (implies override)
+	oes          bool // WithOverrideEmptySlice: an empty src slice overrides
+	noDeref      bool // WithoutDereference: a non-nil pointer is never empty
+	appendSlice  bool // WithAppendSlice
+	typeCheck    bool // WithTypeCheck
+	deepCopy     bool // WithSliceDeepCopy (implies override)
+	transformers bool // WithTransformers: time.Time and Color merged by the transformer
+	deprecated   bool // the entry point is MergeWithOverwrite (override)
+}
+
+// optsGen draws the nine coins at the committed chances; owe, deepCopy and the deprecated
+// entry point imply override.
+var optsGen = hegel.Map(hzTuple(
+	hzChance(2, 5),    // override 40 nominal (realised 64.4 with the three that imply it)
+	hzChance(3, 20),   // owe 15 nominal: realised 15.5
+	hzChance(1, 5),    // oes 20 nominal: realised 18.6
+	hzChance(1, 4),    // noDeref 25 nominal: realised 24.1 (hzChance(23, 100) 21.3)
+	hzChance(1, 4),    // appendSlice 25 nominal: realised 25.7
+	hzChance(11, 50),  // typeCheck 20 nominal: hzChance(1, 5) realised 17.3, this 21.8
+	hzChance(4, 25),   // deepCopy 15 nominal: hzChance(3, 20) realised 13.3, hzChance(17, 100) 17.7, this 17.8
+	hzChance(27, 100), // transformers 25 nominal: hzChance(1, 4) realised 22.2, this 28.9
+	hzChance(1, 10),   // deprecated 10 nominal: realised 11.9
+), func(c []bool) opts {
+	o := opts{
+		override:     c[0],
+		owe:          c[1],
+		oes:          c[2],
+		noDeref:      c[3],
+		appendSlice:  c[4],
+		typeCheck:    c[5],
+		deepCopy:     c[6],
+		transformers: c[7],
+		deprecated:   c[8],
+	}
+	if o.owe || o.deepCopy || o.deprecated {
+		o.override = true
+	}
+	return o
+})
+
+func (o opts) funcs() []func(*mergo.Config) {
+	var fs []func(*mergo.Config)
+	if o.override && !o.owe && !o.deepCopy && !o.deprecated {
+		fs = append(fs, mergo.WithOverride)
+	}
+	if o.owe {
+		fs = append(fs, mergo.WithOverwriteWithEmptyValue)
+	}
+	if o.oes {
+		fs = append(fs, mergo.WithOverrideEmptySlice)
+	}
+	if o.noDeref {
+		fs = append(fs, mergo.WithoutDereference)
+	}
+	if o.appendSlice {
+		fs = append(fs, mergo.WithAppendSlice)
+	}
+	if o.typeCheck {
+		fs = append(fs, mergo.WithTypeCheck)
+	}
+	if o.deepCopy {
+		fs = append(fs, mergo.WithSliceDeepCopy)
+	}
+	if o.transformers {
+		fs = append(fs, mergo.WithTransformers(zooTransformers{}))
+	}
+	return fs
+}
+
+// merge runs the package's Merge with the options.
+func (o opts) merge(dst, src interface{}) error {
+	if o.deprecated {
+		return mergo.MergeWithOverwrite(dst, src, o.funcs()...)
+	}
+	return mergo.Merge(dst, src, o.funcs()...)
+}
+
+func (o opts) String() string {
+	var parts []string
+	add := func(on bool, s string) {
+		if on {
+			parts = append(parts, s)
+		}
+	}
+	add(o.override, "override")
+	add(o.owe, "owe")
+	add(o.oes, "oes")
+	add(o.noDeref, "noDeref")
+	add(o.appendSlice, "append")
+	add(o.typeCheck, "typeCheck")
+	add(o.deepCopy, "deepCopy")
+	add(o.transformers, "transformers")
+	add(o.deprecated, "deprecated")
+	if len(parts) == 0 {
+		return "plain"
+	}
+	return strings.Join(parts, "+")
+}
+
+// zooTransformers: time.Time as in the documentation (set when the destination is zero), Color
+// prefixed with "t:" when the destination is empty, and an error on the source "b".
+type zooTransformers struct{}
+
+var errColor = errors.New("zoo: color b")
+
+func (zooTransformers) Transformer(typ reflect.Type) func(dst, src reflect.Value) error {
+	switch typ {
+	case timeType:
+		return func(dst, src reflect.Value) error {
+			if dst.CanSet() && dst.MethodByName("IsZero").Call(nil)[0].Bool() {
+				dst.Set(src)
+			}
+			return nil
+		}
+	case colorType:
+		return func(dst, src reflect.Value) error {
+			if src.String() == "b" {
+				return errColor
+			}
+			if dst.CanSet() && dst.Len() == 0 && src.Len() > 0 {
+				dst.SetString("t:" + src.String())
+			}
+			return nil
+		}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- merge model
+//
+// README: "Mergo merges same-type structs and maps by setting default values in zero-value
+// fields. Mergo won't merge unexported (private) fields. It will do recursively any exported
+// one. It also won't merge structs inside maps (because they are not addressable using Go
+// reflection)". WithOverride: "override non-empty dst attributes with non-empty src attributes
+// values"; WithOverwriteWithEmptyValue: "override non empty dst attributes with empty src
+// attributes values"; WithOverrideEmptySlice: "override empty dst slice with empty src slice";
+// WithoutDereference: "a non-nil pointer is never considered empty"; WithAppendSlice: "append
+// slices instead of overwriting"; WithTypeCheck: "check types while overwriting";
+// WithSliceDeepCopy: "merge slice element one by one with Overwrite flag"; transformers replace
+// the merge of a type. An empty value is a zero scalar, a nil or empty container or a nil
+// pointer (or a pointer to an empty value unless WithoutDereference); a struct is never empty
+// (only its fields are), so a struct without exported fields (time.Time) moves only with
+// WithOverride.
+//
+// The second part draws the shapes the first part kept away from, and the model states what
+// the documentation says of them: a typed nil pointer source is ErrNilArguments (mergo/1); an
+// unexported map is never merged (2); a Map value of the field's kind but another type is a
+// type mismatch error (3); a nil map destination of Map is allocated (4); a typed nil pointer
+// value is skipped like an untyped nil (5); a typed map destination of Map is
+// ErrExpectedMapAsDestination (11), a typed map source is mapped like a map[string]interface{}
+// (14); a replaced entry's old value is left alone (12); a promoted key through a nil embedded
+// pointer is skipped (13); maps of different types held in interfaces are not merged into each
+// other (18). Where the pin accepts two outcomes the statement picks one (the README's Bugs
+// paragraph says which); the texts of the errors the library never returns (1, 3, 11) are
+// conjectures.
+
+// mm is one model run: the options, the switch set, the errors the merge can hit (the
+// package stops at the first, in map order) and whether it reaches a crash (where).
+type mm struct {
+	o      opts
+	k      known
+	errs   []string
+	panics bool
+	why    string
+}
+
+func (m *mm) fail(format string, args ...interface{}) {
+	m.errs = append(m.errs, fmt.Sprintf(format, args...))
+}
+
+func (m *mm) crash(format string, args ...interface{}) {
+	if !m.panics {
+		m.panics = true
+		m.why = fmt.Sprintf(format, args...)
+	}
+}
+
+// outcome is the model's outcome check: "ok", the set of the errors the merge can hit, a
+// crash, or either when an error met first (in map order) would stop the merge before it.
+func (m *mm) outcome() string {
+	set := map[string]bool{}
+	for _, e := range m.errs {
+		set[e] = true
+	}
+	errs := make([]string, 0, len(set))
+	for e := range set {
+		errs = append(errs, e)
+	}
+	sort.Strings(errs)
+	switch {
+	case m.panics && len(errs) == 0:
+		return "panic"
+	case m.panics:
+		return "panic or error {" + strings.Join(errs, " | ") + "}"
+	case len(errs) > 0:
+		return "error {" + strings.Join(errs, " | ") + "}"
+	}
+	return "ok"
+}
+
+func isNilable(k reflect.Kind) bool {
+	switch k {
+	case reflect.Chan, reflect.Func, reflect.Map, reflect.Interface, reflect.Slice, reflect.Pointer:
+		return true
+	}
+	return false
+}
+
+// empty is the merge's emptiness: the zero value of scalars, no elements, nil pointers and
+// interfaces (dereferenced unless WithoutDereference). mergo/7: the package asks an array for
+// its length, so an array is never empty.
+func (m *mm) empty(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.Array:
+		if m.k[kArraysNeverEmpty] {
+			return v.Len() == 0
+		}
+		return v.IsZero()
+	case reflect.Map, reflect.Slice, reflect.String:
+		return v.Len() == 0
+	case reflect.Bool:
+		return !v.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return v.Int() == 0
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		return v.Uint() == 0
+	case reflect.Float32, reflect.Float64:
+		return v.Float() == 0
+	case reflect.Interface, reflect.Pointer:
+		if v.IsNil() {
+			return true
+		}
+		if !m.o.noDeref {
+			return m.empty(v.Elem())
+		}
+		return false
+	case reflect.Func:
+		return v.IsNil()
+	case reflect.Invalid:
+		return true
+	}
+	return false
+}
+
+func hasExportedFields(t reflect.Type) bool {
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.Anonymous && f.Type.Kind() == reflect.Struct {
+			if hasExportedFields(f.Type) {
+				return true
+			}
+		} else if f.PkgPath == "" {
+			return true
+		}
+	}
+	return false
+}
+
+// dyn is the value behind an interface (a container element), as the package sees it.
+func dyn(v reflect.Value) reflect.Value {
+	if v.IsValid() && v.Kind() == reflect.Interface && !v.IsNil() {
+		return v.Elem()
+	}
+	return v
+}
+
+// set assigns src to dst, which the merge reaches with a value of another type only through
+// a Map value of the field's kind but another type (mergo/3: the package's reflect.Set
+// panics there; the documented model never gets here with such a value, mapInto states the
+// error first).
+func (m *mm) set(dst, src reflect.Value) {
+	if src.Type().AssignableTo(dst.Type()) {
+		dst.Set(src)
+		return
+	}
+	if m.k[kMapKindNotTypePanics] {
+		m.crash("reflect.Set: value of type %s is not assignable to type %s", src.Type(), dst.Type())
+	}
+}
+
+// setMapIndex sets (or deletes, for an invalid v) an entry of dst, which the merge reaches
+// with a value of another type only across maps of different types followed as the package
+// does (mergo/3 and mergo/18: reflect refuses the static type, an interface{} entry of a
+// map[string]interface{} included, whatever it holds).
+func (m *mm) setMapIndex(dst, key, v reflect.Value) {
+	if !v.IsValid() || v.Type().AssignableTo(dst.Type().Elem()) {
+		dst.SetMapIndex(key, v)
+		return
+	}
+	m.crash("reflect.Value.SetMapIndex: value of type %s is not assignable to type %s", v.Type(), dst.Type().Elem())
+}
+
+// isNil asks a map entry whether it is nil as the package does (merge.go :160
+// "dstElement.IsNil()"), which reflect refuses on a value that cannot be nil (a scalar or
+// struct entry of a typed map met across map types); the crash is reported and false
+// returned.
+func (m *mm) isNil(v reflect.Value) bool {
+	if isNilable(v.Kind()) {
+		return v.IsNil()
+	}
+	m.crash("reflect: call of reflect.Value.IsNil on %s Value", v.Kind())
+	return false
+}
+
+// dry runs the merge of src into dst on a sub-model and keeps its errors and crash alone:
+// for a merge whose effect the documented model does not want (into an entry it replaces,
+// mergo/12) but whose outcome the package meets.
+func (m *mm) dry(dst, src reflect.Value) {
+	d := &mm{o: m.o, k: m.k}
+	d.merge(dst, src)
+	m.errs = append(m.errs, d.errs...)
+	if d.panics {
+		m.crash("%s", d.why)
+	}
+}
+
+// merge merges src into dst; dst may be unaddressable (an element taken out of a map or an
+// interface), in which case only what it references (pointer targets, map entries) can change.
+func (m *mm) merge(dst, src reflect.Value) {
+	if !src.IsValid() {
+		return
+	}
+	if m.o.transformers && dst.IsValid() && !(isNilable(dst.Kind()) && dst.IsNil()) {
+		if fn := (zooTransformers{}).Transformer(dst.Type()); fn != nil {
+			if err := fn(dst, src); err != nil {
+				m.fail("%s", err.Error())
+			}
+			return
+		}
+	}
+	switch dst.Kind() {
+	case reflect.Struct:
+		if hasExportedFields(dst.Type()) {
+			if src.Kind() != reflect.Struct {
+				// a struct against a value of another kind (elements of a []interface{}
+				// under WithSliceDeepCopy, entries of a map of interfaces): nothing to merge.
+				// mergo/17: the package reads the fields of the non-struct
+				if m.k[kDeepCopyKindPanic] {
+					m.crash("%s against %s", dst.Type(), src.Type())
+				}
+				return
+			}
+			if src.Type() != dst.Type() {
+				// a struct of another type (a Map value of the field's kind but another type):
+				// nothing to merge. mergo/3: the package merges the fields by position
+				if m.k[kMapKindNotTypePanics] {
+					m.mergeByPosition(dst, src)
+				}
+				return
+			}
+			for i := 0; i < dst.NumField(); i++ {
+				f := dst.Type().Field(i)
+				if f.PkgPath != "" {
+					// unexported fields are not merged. mergo/2: the package visits them and,
+					// under WithOverwriteWithEmptyValue, deletes the keys of an unexported map
+					// the source's lacks, which reflect refuses
+					if f.Type.Kind() == reflect.Map && m.o.owe && m.k[kUnexportedMapPanics] {
+						m.unexportedOwe(dst.Field(i), src.Field(i))
+					}
+					continue
+				}
+				m.merge(dst.Field(i), src.Field(i))
+			}
+		} else if dst.CanSet() && m.o.override && (!m.empty(src) || m.o.owe) {
+			// a struct is never empty, so a struct without exported fields (time.Time) moves
+			// with WithOverride when it is not zero (or with WithOverwriteWithEmptyValue).
+			// mergo/16: the package moves it when it is zero too
+			if !src.IsZero() || m.o.owe || m.k[kZeroStructOverrides] {
+				m.set(dst, src)
+			}
+		}
+	case reflect.Map:
+		m.mergeMap(dst, src, m.k[kTypedMapsInInterfacesPanic])
+	case reflect.Slice:
+		if !dst.CanSet() {
+			return
+		}
+		m.mergeSlice(dst, src, func(v reflect.Value) { m.set(dst, v) })
+	case reflect.Pointer, reflect.Interface:
+		m.mergeRef(dst, src)
+	default:
+		// elements of slices of different types (a map-of-interfaces entry holding []int
+		// against one holding []string under WithSliceDeepCopy): nothing to merge
+		if (m.empty(dst) || m.o.override) && (!m.empty(src) || m.o.owe) && dst.CanSet() {
+			m.set(dst, src)
+		}
+	}
+}
+
+// mergeByPosition is the package's Struct case on a source of another struct type (merge.go
+// :93-94 "for i, n := 0, dst.NumField(); i < n; i++ { ... src.Field(i)"): the fields are
+// merged by position, the unexported ones visited too, until reflect refuses a set across
+// types (set), a struct against a value of another kind (mergo/17's site) or an index past
+// the source's fields.
+func (m *mm) mergeByPosition(dst, src reflect.Value) {
+	for i := 0; i < dst.NumField() && !m.panics; i++ {
+		if i >= src.NumField() {
+			m.crash("reflect: Field index out of range")
+			return
+		}
+		m.merge(dst.Field(i), src.Field(i))
+	}
+}
+
+// unexportedOwe is the package's Map case on an unexported map under
+// WithOverwriteWithEmptyValue (merge.go :103-224): a nil destination map returns at once
+// (:104-110, it cannot be set), the entries are skipped (:136, they cannot be interfaced),
+// and the loop that deletes the keys the source lacks (:217-223) calls dst.SetMapIndex on
+// the unexported map, which reflect refuses, at the first such key.
+func (m *mm) unexportedOwe(dst, src reflect.Value) {
+	if dst.IsNil() {
+		return
+	}
+	for _, key := range dst.MapKeys() {
+		if !src.MapIndex(key).IsValid() {
+			m.crash("reflect: reflect.Value.SetMapIndex using value obtained using unexported field")
+			return
+		}
+	}
+}
+
+// mergeRef merges into a pointer or an interface: a nil source moves only with
+// WithOverwriteWithEmptyValue; a nil destination takes the source; two pointers are merged
+// through (or the pointer assigned with WithoutDereference and WithOverride); two interfaces
+// are replaced with WithOverride, else merged through when they hold the same kind; a
+// non-interface source (a Map value) into an interface is set, merged when of the held type,
+// left alone otherwise.
+func (m *mm) mergeRef(dst, src reflect.Value) {
+	if isNilable(src.Kind()) && src.IsNil() {
+		if m.o.owe && dst.CanSet() && src.Type().AssignableTo(dst.Type()) {
+			dst.Set(src)
+		}
+		return
+	}
+	if src.Kind() != reflect.Interface {
+		if dst.IsNil() || (src.Kind() != reflect.Pointer && m.o.override) {
+			if dst.CanSet() && (m.o.override || m.empty(dst)) {
+				m.set(dst, src)
+			}
+		} else if src.Kind() == reflect.Pointer {
+			if !m.o.noDeref {
+				m.merge(dst.Elem(), src.Elem())
+			} else if src.Elem().Kind() != reflect.Struct || !m.k[kNoDerefStructPointer] {
+				// mergo/8: the package assigns no pointer to a struct under WithoutDereference
+				if m.o.owe || m.o.override {
+					if dst.CanSet() {
+						m.set(dst, src)
+					} else if m.k[kNoDerefUnaddressablePanic] {
+						// mergo/19: the package sets the unaddressable value
+						m.crash("WithoutDereference: %s = %s", dst.Type(), show(src))
+					}
+				}
+			}
+		} else if dst.Elem().Type() == src.Type() {
+			m.merge(dst.Elem(), src)
+		} else if m.k[kIfaceMismatchError] {
+			// mergo/9: the package returns ErrDifferentArgumentsTypes
+			m.fail("%s", mergo.ErrDifferentArgumentsTypes.Error())
+		}
+		return
+	}
+	if dst.IsNil() || m.o.override {
+		if dst.CanSet() && (m.o.override || m.empty(dst)) {
+			m.set(dst, src)
+		}
+		return
+	}
+	if dst.Elem().Kind() == src.Elem().Kind() {
+		m.merge(dst.Elem(), src.Elem())
+	}
+}
+
+// elements is the pair of elements WithSliceDeepCopy merges at one index. mergo/6: the
+// package merges copies of the dynamic values (reflect.ValueOf(element.Interface())), so
+// only a pointer or a map target changes. The crashes of mergo/17 and mergo/19 happen inside
+// those copies: when the copies are not followed but a crash switch is on, a dry run of the
+// copies' merge (on unaddressable deep copies, under mergo/6) predicts the crash alone, so
+// that the crash is the shape of its own switch and not only of mergo/6.
+func (m *mm) elements(de, se reflect.Value) (reflect.Value, reflect.Value) {
+	if m.k[kSliceDeepCopyPointersOnly] {
+		return reflect.ValueOf(de.Interface()), reflect.ValueOf(se.Interface())
+	}
+	if (m.k[kDeepCopyKindPanic] || m.k[kNoDerefUnaddressablePanic]) && !m.panics {
+		dd, sd := reflect.ValueOf(de.Interface()), reflect.ValueOf(se.Interface())
+		if dd.IsValid() && sd.IsValid() {
+			dry := &mm{o: m.o, k: m.k}
+			dry.k[kSliceDeepCopyPointersOnly] = true
+			dry.merge(reflect.ValueOf(deepCopy(dd).Interface()), reflect.ValueOf(deepCopy(sd).Interface()))
+			if dry.panics {
+				m.crash("%s", dry.why)
+			}
+		}
+	}
+	return de, se
+}
+
+// mergeSlice: the whole src slice replaces an empty dst (or any dst with WithOverride) unless
+// appending or deep-copying; set applies the new slice.
+func (m *mm) mergeSlice(dst, src reflect.Value, set func(reflect.Value)) {
+	if (!m.empty(src) || m.o.owe || m.o.oes) && (m.o.override || m.empty(dst)) && !m.o.appendSlice && !m.o.deepCopy {
+		set(src)
+	} else if m.o.appendSlice {
+		if src.Type() != dst.Type() {
+			m.fail("cannot append two slice with different type (%s, %s)", src.Type(), dst.Type())
+			return
+		}
+		set(reflect.AppendSlice(dst, src))
+	} else if m.o.deepCopy {
+		if src.Kind() != reflect.Slice {
+			// a source of another kind (an element of a []interface{} against a slice
+			// element of Outer's SS, a Map value of the field's kind but another type):
+			// nothing to merge. mergo/17: the package asks it for its length
+			if m.k[kDeepCopyKindPanic] {
+				m.crash("reflect: call of reflect.Value.Len on %s Value", src.Kind())
+			}
+			return
+		}
+		m.deepCopyElements(dst, src)
+	}
+}
+
+// deepCopyElements merges the elements of src into those of dst index by index
+// (WithSliceDeepCopy: "merge slice element one by one"): an element of a []interface{}
+// against a typed element (a Map value of the field's kind but another type, mergo/3) is
+// the value it holds, a nil one nothing.
+func (m *mm) deepCopyElements(dst, src reflect.Value) {
+	for i := 0; i < src.Len() && i < dst.Len(); i++ {
+		de, se := m.elements(dst.Index(i), src.Index(i))
+		if se.Kind() == reflect.Interface && de.Kind() != reflect.Interface {
+			if se.IsNil() {
+				continue
+			}
+			se = se.Elem()
+		}
+		m.merge(de, se)
+	}
+}
+
+// mergeMap merges the entries of src into dst: a missing or empty entry takes the source's;
+// pointer and map entries are merged through (they are references), struct entries are not
+// (they are copies); slices follow the slice rules; WithOverride replaces entries (pointers
+// excepted in typed maps); WithOverwriteWithEmptyValue removes the entries src lacks. Two
+// maps of different types (interface entries or elements holding typed maps, an interface
+// field; a Map value for a typed map field) are not merged into each other: the entry rules
+// then replace an empty destination map, or any under WithOverride, and the destination's
+// stays otherwise; with follow (the switch of mergo/18 for interfaces, of mergo/3 under Map)
+// the package's loop runs across the types as it does, inserting the entries reflect admits
+// and crashing at the first it refuses (setMapIndex, isNil).
+func (m *mm) mergeMap(dst, src reflect.Value, follow bool) {
+	if dst.IsNil() {
+		if !isNilable(src.Kind()) {
+			// a nil map element of a []interface{} against a struct or scalar under
+			// WithSliceDeepCopy: nothing to merge. mergo/17: the package asks the non-nilable
+			// value whether it is nil
+			if m.k[kDeepCopyKindPanic] {
+				m.crash("nil %s against %s", dst.Type(), src.Type())
+			}
+			return
+		}
+		if !src.IsNil() {
+			if !dst.CanSet() {
+				return
+			}
+			dst.Set(reflect.MakeMap(dst.Type()))
+		}
+	}
+	if src.Kind() != reflect.Map {
+		if m.o.override && dst.CanSet() {
+			m.set(dst, src)
+		}
+		return
+	}
+	if src.Type() != dst.Type() && !follow {
+		return
+	}
+	for _, key := range src.MapKeys() {
+		se := src.MapIndex(key)
+		de := dst.MapIndex(key)
+		if isNilable(se.Kind()) && se.IsNil() {
+			// a nil entry is empty: it overrides only with WithOverwriteWithEmptyValue.
+			// mergo/15: the package lets nil slices, maps and interfaces override with
+			// WithOverride alone and treats a nil pointer like any pointer (never overriding,
+			// added when missing)
+			if m.k[kNilMapEntries] {
+				if se.Kind() != reflect.Pointer {
+					if m.o.override {
+						m.setMapIndex(dst, key, se)
+					}
+					continue
+				}
+			} else {
+				if m.o.owe {
+					m.setMapIndex(dst, key, se)
+				} else if !de.IsValid() || m.empty(de) {
+					m.setMapIndex(dst, key, se)
+				}
+				continue
+			}
+		}
+		sd := dyn(se)
+		switch sd.Kind() {
+		case reflect.Struct, reflect.Pointer, reflect.Map:
+			var dd reflect.Value
+			if de.IsValid() {
+				dd = reflect.ValueOf(de.Interface())
+			}
+			if m.o.override && se.Kind() != reflect.Pointer && sd.Kind() != reflect.Map && !m.k[kReplacedPointerMerged] {
+				// the entry is replaced below (WithOverride; a pointer entry of a typed map is
+				// not): nothing is merged into the value it replaces, whose pointers the caller
+				// may still hold. mergo/12: the package merges the source's value into it first
+				// (through a pointer entry, or the pointer fields of a struct entry). The errors
+				// and crashes the package meets inside that merge are met on copies
+				if de.IsValid() {
+					m.dry(reflect.ValueOf(deepCopy(de).Interface()), reflect.ValueOf(deepCopy(se).Interface()))
+				}
+			} else {
+				m.merge(dd, reflect.ValueOf(se.Interface()))
+			}
+		case reflect.Slice:
+			ss := reflect.ValueOf(se.Interface())
+			var ds reflect.Value
+			if !de.IsValid() || m.isNil(de) {
+				if m.panics {
+					continue
+				}
+				ds = reflect.MakeSlice(ss.Type(), 0, ss.Len())
+			} else {
+				ds = reflect.ValueOf(de.Interface())
+			}
+			if (!m.empty(src) || m.o.owe || m.o.oes) && (m.o.override || m.empty(dst)) && !m.o.appendSlice && !m.o.deepCopy {
+				if m.o.typeCheck && ss.Type() != ds.Type() {
+					m.fail("cannot override two slices with different type (%s, %s)", ss.Type(), ds.Type())
+					continue
+				}
+				ds = ss
+			} else if m.o.appendSlice {
+				if ss.Type() != ds.Type() {
+					m.fail("cannot append two slices with different type (%s, %s)", ss.Type(), ds.Type())
+					continue
+				}
+				ds = reflect.AppendSlice(ds, ss)
+			} else if m.o.deepCopy {
+				m.deepCopyEntry(ds, ss)
+			}
+			m.setMapIndex(dst, key, ds)
+		}
+		if de.IsValid() && !m.empty(de) {
+			if sd.Kind() == reflect.Slice {
+				continue
+			}
+			// two maps are merged through, never replaced: of one type; mergo/18: the package
+			// keeps the merged entry across types too (the documented statement replaces it
+			// under WithOverride, since nothing was merged)
+			if sd.Kind() == reflect.Map && dyn(de).Kind() == reflect.Map && (dyn(de).Type() == sd.Type() || m.k[kTypedMapsInInterfacesPanic]) {
+				continue
+			}
+		}
+		if (se.Kind() != reflect.Pointer && m.o.override) || !de.IsValid() || m.empty(de) {
+			m.setMapIndex(dst, key, se)
+		}
+	}
+	if m.o.owe {
+		for _, key := range dst.MapKeys() {
+			if !src.MapIndex(key).IsValid() {
+				dst.SetMapIndex(key, reflect.Value{})
+			}
+		}
+	}
+}
+
+// deepCopyEntry merges a source slice entry of a map into the destination's entry under
+// WithSliceDeepCopy ("merge slice element one by one"): element by element into a slice (or
+// an array copy, whose pointer elements are merged through); nothing into anything else,
+// which has no elements to merge into (a string's bytes cannot change; a scalar, struct,
+// pointer or map entry is left as it is here, and the entry rules then replace an empty one
+// with the source slice and keep a non-empty one). mergo/20: the package asks a scalar,
+// struct or pointer entry for its length, and a non-empty map entry for its elements, and
+// panics (an empty source slice, or an empty map entry, is not reached).
+func (m *mm) deepCopyEntry(ds, ss reflect.Value) {
+	switch ds.Kind() {
+	case reflect.Slice, reflect.Array:
+		m.deepCopyElements(ds, ss)
+	case reflect.String:
+	case reflect.Map:
+		if ss.Len() > 0 && ds.Len() > 0 && m.k[kDeepCopyEntryPanic] {
+			m.crash("WithSliceDeepCopy: %s entry against %s", ds.Type(), ss.Type())
+		}
+	default:
+		if ss.Len() > 0 && m.k[kDeepCopyEntryPanic] {
+			m.crash("WithSliceDeepCopy: %s entry against %s", ds.Type(), ss.Type())
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- Map model
+//
+// map.go: "Map sets fields' values in dst from src. src can be a map with string keys or a
+// struct. dst must be the opposite: if src is a map, dst must be a valid pointer to struct. If
+// src is a struct, dst must be map[string]interface{}. It won't merge unexported (private)
+// fields and will do recursively any exported field. If dst is a map, keys will be src fields'
+// names in lower camel case. Missing key in src that doesn't match a field in dst will be
+// skipped." README: "Keys are capitalized to find each corresponding exported field", "if you
+// map a struct to map, it won't do it recursively ... They will be just assigned as values",
+// and the values follow "the same restrictions as in Merge()".
+
+func changeInitial(s string, mapper func(rune) rune) string {
+	if s == "" {
+		return s
+	}
+	r, n := utf8.DecodeRuneInString(s)
+	return string(mapper(r)) + s[n:]
+}
+
+func lowerFirst(s string) string { return changeInitial(s, unicode.ToLower) }
+func upperFirst(s string) string { return changeInitial(s, unicode.ToUpper) }
+
+// fieldByName is the field of a struct value by name, walking the embedded pointers itself:
+// a promoted field through a nil embedded pointer is reported (true) rather than followed
+// (reflect's FieldByName panics there, mergo/13); an unknown name is the invalid value.
+func fieldByName(v reflect.Value, name string) (reflect.Value, bool) {
+	sf, ok := v.Type().FieldByName(name)
+	if !ok {
+		return reflect.Value{}, false
+	}
+	for _, i := range sf.Index {
+		if v.Kind() == reflect.Pointer {
+			if v.IsNil() {
+				return reflect.Value{}, true
+			}
+			v = v.Elem()
+		}
+		v = v.Field(i)
+	}
+	return v, false
+}
+
+// mapInto maps the entries of src (a map with string keys: a map[string]interface{}, or a
+// typed map, mergo/14) into the fields of dst (a struct or a pointer to one): a key names the
+// field with its initial capitalised (a key promoted through a nil embedded pointer matches
+// no field and is skipped, mergo/13); a value of the field's kind and type is merged in, a
+// pointer to one is dereferenced first (a typed nil pointer is skipped like an untyped nil,
+// mergo/5), a nested map maps into a struct field, a value of the field's kind but another
+// type (mergo/3) or of another kind is a type mismatch error. Other destination kinds take
+// nothing. mergo/10: the package turns WithOverwriteWithEmptyValue on for every key (and for
+// the rest of the call); the model run's own copy of the options takes it.
+func (m *mm) mapInto(dst, src reflect.Value) {
+	if dst.Kind() == reflect.Pointer {
+		if dst.IsNil() {
+			dst.Set(reflect.New(dst.Type().Elem()))
+		}
+		dst = dst.Elem()
+	}
+	if dst.Kind() != reflect.Struct {
+		return
+	}
+	if m.k[kMapForcesEmptyOverwrite] {
+		m.o.owe = true
+	}
+	for _, key := range src.MapKeys() {
+		name := upperFirst(key.String())
+		f, throughNil := fieldByName(dst, name)
+		if throughNil {
+			// mergo/13: the package follows the nil embedded pointer
+			if m.k[kNilEmbeddedPointerPanics] {
+				m.crash("reflect: indirection through nil pointer to embedded struct")
+			}
+			continue
+		}
+		if !f.IsValid() {
+			continue
+		}
+		se := reflect.ValueOf(src.MapIndex(key).Interface())
+		if !se.IsValid() {
+			continue
+		}
+		if se.Kind() == reflect.Pointer && f.Kind() != reflect.Pointer {
+			se = se.Elem()
+			if !se.IsValid() {
+				// mergo/5: the package asks the zero Value for its interface
+				if m.k[kTypedNilValuePanics] {
+					m.crash("reflect: call of reflect.Value.Interface on zero Value")
+				}
+				continue
+			}
+		}
+		switch {
+		case se.Kind() == f.Kind() && f.Kind() != reflect.Interface && se.Type() != f.Type():
+			// mergo/3: the package hands the value to the merge, which sets it as it is
+			if !m.k[kMapKindNotTypePanics] {
+				m.fail("type mismatch on %s field: found %v, expected %v", name, se.Type(), f.Type())
+			} else if f.Kind() == reflect.Map {
+				m.mergeMap(f, se, true)
+			} else {
+				m.merge(f, se)
+			}
+		case se.Kind() == f.Kind(), f.Kind() == reflect.Interface:
+			m.merge(f, se)
+		case se.Kind() == reflect.Map:
+			m.mapInto(f, se)
+		default:
+			m.fail("type mismatch on %s field: found %v, expected %v", name, se.Kind(), f.Kind())
+		}
+	}
+}
+
+// mapFrom sets the exported fields of src (a struct) into dst (a map[string]interface{}) under
+// their names in lower camel case: missing keys are added, present ones replaced with
+// WithOverride when the field is not empty, always with WithOverwriteWithEmptyValue.
+func (m *mm) mapFrom(dst, src reflect.Value) {
+	t := src.Type()
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.PkgPath != "" {
+			continue
+		}
+		key := reflect.ValueOf(lowerFirst(f.Name))
+		fv := src.Field(i)
+		// emptiness is that of the dynamic value (an interface holding a nil slice is empty)
+		if !dst.MapIndex(key).IsValid() || (!m.empty(reflect.ValueOf(fv.Interface())) && m.o.override) || m.o.owe {
+			dst.SetMapIndex(key, fv)
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- statements
+
+// observed is what a merge statement observes beside the result: the targets of the
+// destination's pointers before the merge, read after it (handlesOf, showHandles), and the
+// unexported maps of the Inners in the result (privateOf).
+type observed struct {
+	handles, private string
+}
+
+// modelMerge runs the model on copies of dst and src with the options and the switch set:
+// the outcome, the destination after (as the model left it) and the observations.
+func modelMerge(dst, src reflect.Value, o opts, k known) (outcome string, result reflect.Value, obs observed) {
+	m := &mm{o: o, k: k}
+	want := deepCopy(dst)
+	hs := handlesOf(want)
+	m.merge(want, deepCopy(src))
+	return m.outcome(), want, observed{handles: showHandles(hs), private: privateOf(want)}
+}
+
+// mergeStatement is the checks of one merge: the outcome, and the result (canon) with the
+// observations when the outcome is ok.
+func mergeStatement(outcome string, result reflect.Value, obs observed) checks {
+	c := checks{"outcome": outcome}
+	if outcome == "ok" {
+		c["result"] = canon(result)
+		c["handles"] = obs.handles
+		c["private"] = obs.private
+	}
+	return c
+}
+
+func errorOutcome(err error) string { return "error {" + err.Error() + "}" }
+
+// mergeExpected is the model's statement for a merge case under the switch set. A typed nil
+// pointer source is ErrNilArguments, "src and dst must not be nil" (mergo/1: the package
+// panics; the pin accepts any error, the text is a conjecture).
+func mergeExpected(c mergeCase, k known) checks {
+	if c.nilSrc {
+		if k[kNilPointerSourcePanics] {
+			return checks{"outcome": "panic"}
+		}
+		return checks{"outcome": errorOutcome(mergo.ErrNilArguments)}
+	}
+	outcome, result, obs := modelMerge(c.dst, c.src, c.o, k)
+	return mergeStatement(outcome, result, obs)
+}
+
+// outcomeOnly is a statement restricted to the outcome (the narrow properties over the
+// crashes inside WithSliceDeepCopy's copies, where mergo/6 moves the result of every case).
+func outcomeOnly[T any](expected func(T, known) checks) func(T, known) checks {
+	return func(c T, k known) checks {
+		return checks{"outcome": expected(c, k)["outcome"]}
+	}
+}
+
+// mapModel is the model's statement for a Map case under the switch set, with the
+// destination it leaves (invalid when the outcome is not ok): into a struct, the outcome and
+// the result (a typed map source mapped like a map[string]interface{}, mergo/14: the package
+// panics; the pin accepts an error too); from a struct, the result (a nil destination map
+// allocated and filled as an empty one, mergo/4; a typed map destination
+// ErrExpectedMapAsDestination, "dst was expected to be a map", mergo/11: the package panics,
+// the pin accepts any error, the text is a conjecture). A typed nil pointer source is
+// ErrNilArguments either way (mergo/1: the package returns ErrNotSupported, "only structs,
+// maps, and slices are supported", from the zero Value's Invalid kind).
+func mapModel(c mapCase, k known) (checks, reflect.Value) {
+	m := &mm{o: c.o, k: k}
+	if c.nilSrc {
+		if k[kNilPointerSourcePanics] {
+			return checks{"outcome": errorOutcome(mergo.ErrNotSupported)}, reflect.Value{}
+		}
+		return checks{"outcome": errorOutcome(mergo.ErrNilArguments)}, reflect.Value{}
+	}
+	if c.into {
+		want := deepCopy(c.strct)
+		src := reflect.ValueOf(c.m)
+		if c.ts.IsValid() {
+			if k[kTypedMapSourcePanics] {
+				m.crash("interface conversion: interface {} is %s, not map[string]interface {}", c.ts.Type())
+				return checks{"outcome": m.outcome()}, reflect.Value{}
+			}
+			src = c.ts
+		}
+		hs := handlesOf(want)
+		m.mapInto(want, deepCopy(src))
+		return mergeStatement(m.outcome(), want, observed{handles: showHandles(hs), private: privateOf(want)}), want
+	}
+	var want reflect.Value
+	switch {
+	case c.nilDst:
+		if k[kNilMapDestinationPanics] && hasExportedFields(c.st) {
+			m.crash("assignment to entry in nil map")
+			return checks{"outcome": m.outcome()}, reflect.Value{}
+		}
+		want = reflect.ValueOf(map[string]interface{}{})
+	case c.tm.IsValid():
+		if k[kTypedMapDestinationPanics] {
+			m.crash("interface conversion: interface {} is %s, not map[string]interface {}", c.tm.Type())
+		} else {
+			m.fail("%s", mergo.ErrExpectedMapAsDestination.Error())
+		}
+		return checks{"outcome": m.outcome()}, reflect.Value{}
+	default:
+		want = deepCopy(reflect.ValueOf(c.m))
+	}
+	hs := handlesOf(want)
+	m.mapFrom(want, deepCopy(c.strct))
+	return mergeStatement(m.outcome(), want, observed{handles: showHandles(hs), private: privateOf(want)}), want
+}
+
+// mapExpected is the model's statement for a Map case under the switch set.
+func mapExpected(c mapCase, k known) checks {
+	out, _ := mapModel(c, k)
+	return out
+}
+
+// lawExpected is the model's statement of a law case under the switch set, what the law
+// observes: the source law, the outcome and the source (the model never modifies it; a crash
+// is the outcome); the zero law, the outcome and the result of merging a zero source (the
+// law says: ok, and the destination unchanged, its pointers' targets and private maps too);
+// the idempotence law, the outcome of the first merge, that of a second on the model's own
+// result, and whether the second changed anything.
+func lawExpected(c lawCase, k known) checks {
+	switch c.law {
+	case lawSource:
+		outcome, _, _ := modelMerge(c.dst, c.src, c.o, k)
+		out := checks{"outcome": outcome}
+		if outcome == "ok" {
+			out["source"] = canon(c.src)
+		}
+		return out
+	case lawZero:
+		outcome, result, obs := modelMerge(c.dst, reflect.New(c.rt).Elem(), c.o, k)
+		return mergeStatement(outcome, result, obs)
+	}
+	outcome, once, _ := modelMerge(c.dst, c.src, c.o, k)
+	out := checks{"outcome": outcome}
+	if outcome != "ok" {
+		return out
+	}
+	second, twice, _ := modelMerge(once, c.src, c.o, k)
+	out["second"] = second
+	if second == "ok" {
+		if canon(once) == canon(twice) {
+			out["idempotent"] = "yes"
+		} else {
+			out["idempotent"] = "no: " + diffPath(once, twice, "")
+		}
+	}
+	return out
+}
