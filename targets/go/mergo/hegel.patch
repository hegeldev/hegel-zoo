+
+// TestHegelPinSliceDeepCopy: mergo/6. WithSliceDeepCopy "will merge slice element one by one
+// with Overwrite flag": the elements of a slice of ints (and of structs) are merged, not only
+// those that are pointers or maps.
+func TestHegelPinSliceDeepCopy(t *testing.T) {
