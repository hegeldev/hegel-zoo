+}
+
+// --------------------------------------------------------------------------- mergo/9
+
+// anyOfAnotherType is a value of another dynamic type than v holds (the alternatives of
+// anyGen but v's); sameTypeAs a value of the type v holds. A pointer value is never nil (a
+// typed nil pointer for a non-pointer field is mergo/5, part 2).
+var anyAlternatives = []reflect.Type{strType, intType, reflect.TypeOf(float64(0)), reflect.TypeOf(false), anyMapT, anySliceT, leafType, reflect.PointerTo(leafType)}
+
+func anyOfAnotherType(v reflect.Value) hegel.Generator[reflect.Value] {
+	var types []reflect.Type
+	for _, t := range anyAlternatives {
+		if t != v.Elem().Type() {
+			types = append(types, t)
+		}
+	}
+	return hegel.FlatMap(evenHalves(types...), nonNilOf)
+}
+
+func sameTypeAs(v reflect.Value) hegel.Generator[reflect.Value] { return nonNilOf(v.Elem().Type()) }
+
+func nonNilOf(t reflect.Type) hegel.Generator[reflect.Value] {
+	if t.Kind() == reflect.Pointer {
+		return boxed(valueGen(t.Elem(), 0))
+	}
+	return valueGen(t, 0)
+}
+
+// TestHegelKeysOfAnotherDynamicTypeAreLeftAlone: Map into an Inner whose Any field holds a
+// value, the key "any" holding a value of another dynamic type, without override: the
+// documented Map leaves the field alone, nothing being mergeable (mergo/9: the package fails with
+// ErrDifferentArgumentsTypes). A pointer to a Leaf against a Leaf is dereferenced first and is
+// not the shape (the classifier filters it, regionOf). Past the shape under HEGEL_NO_KNOWN=1 the
+// value is of the held type (merged through, which changes nothing in a value held by an
+// interface).
+func TestHegelKeysOfAnotherDynamicTypeAreLeftAlone(t *testing.T) {
+	og := optsWith(func(o *opts) { o.override, o.owe, o.deepCopy, o.deprecated = false, false, false, false })
+	inner := withFields(innerLight, fieldOf{"Any", nonNilAny})
+	cases := hegel.Composite(func(tc hegel.TestCase) mapCase {
+		o := hegel.Draw(tc, og)
+		dst := hegel.Draw(tc, inner)
+		var v reflect.Value
+		if hzNoKnown {
+			v = hegel.Draw(tc, sameTypeAs(dst.FieldByName("Any")))
+		} else {
+			v = hegel.Draw(tc, anyOfAnotherType(dst.FieldByName("Any")))
+		}
+		return mapCase{st: innerType, o: o, into: true, strct: dst, m: map[string]interface{}{"any": v.Interface()}}
+	})
+	mapJudged(t, regionOf("mergo/9", mapExpected, cases))
+}
+
+// --------------------------------------------------------------------------- mergo/10
+
+// TestHegelEntriesTheSourceMapLacksStay: Map into an Inner with a non-empty map field (M, ML,
+// MPL, MA) whose key holds a map lacking one of the destination's entries, or with a non-nil
+// pointer field (PS, PI, PL, PT) whose key holds a typed nil pointer: the documented Map leaves what the source
+// lacks (mergo/10: the package removes the entries and the pointers, WithOverwriteWithEmptyValue
+// being forced). WithSliceDeepCopy is off. Past the shape under HEGEL_NO_KNOWN=1 the source map
+// for M holds every entry of the destination's and more.
+func TestHegelEntriesTheSourceMapLacksStay(t *testing.T) {
+	og := optsWith(func(o *opts) { o.owe, o.deepCopy, o.deprecated = false, false, false })
+	inner := innerLight
+	nonEmptyMap := func(mt reflect.Type) hegel.Generator[reflect.Value] {
+		elem := valueGen(mt.Elem(), 1)
+		entry := hegel.Composite(func(tc hegel.TestCase) mapEntry {
+			return mapEntry{hegel.Draw(tc, evenHalves(mapKeys...)), hegel.Draw(tc, elem)}
+		})
+		return hegel.Map(countedHalves(entry, 1, 3), func(es []mapEntry) reflect.Value {
+			m := reflect.MakeMap(mt)
+			for _, e := range es {
+				m.SetMapIndex(reflect.ValueOf(e.key), e.val)
+			}
+			return m
+		})
+	}
+	lacking := func(name string, mt reflect.Type) hegel.Generator[mapCase] {
+		return hegel.Composite(func(tc hegel.TestCase) mapCase {
+			o := hegel.Draw(tc, og)
+			dst := hegel.Draw(tc, withFields(inner, fieldOf{name, nonEmptyMap(mt)}))
+			m := dst.FieldByName(name)
+			keys := m.MapKeys()
+			drop := hegel.Draw(tc, rangeHalves(0, len(keys)-1))
+			src := deepCopy(hegel.Draw(tc, valueGen(mt, 2)))
+			if src.IsNil() {
