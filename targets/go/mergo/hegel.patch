+			}
+			src.SetMapIndex(keys[drop], reflect.Value{})
+			return mapCase{st: innerType, o: o, into: true, strct: dst, m: map[string]interface{}{lowerFirst(name): src.Interface()}}
+		})
+	}
+	nilPointer := func(name string, pt reflect.Type) hegel.Generator[mapCase] {
+		return hegel.Composite(func(tc hegel.TestCase) mapCase {
+			o := hegel.Draw(tc, og)
+			dst := hegel.Draw(tc, withFields(inner, fieldOf{name, boxed(valueGen(pt.Elem(), 1))}))
+			// a typed nil pointer for a pointer field (an untyped nil is skipped by Map; the
+			// typed nil of mergo/5 is one for a non-pointer field)
+			return mapCase{st: innerType, o: o, into: true, strct: dst, m: map[string]interface{}{lowerFirst(name): reflect.Zero(pt).Interface()}}
+		})
+	}
+	superset := hegel.Composite(func(tc hegel.TestCase) mapCase {
+		o := hegel.Draw(tc, og)
+		dst := hegel.Draw(tc, withFields(inner, fieldOf{"M", nonEmptyMap(mapIntT)}))
+		src := deepCopy(dst.FieldByName("M"))
