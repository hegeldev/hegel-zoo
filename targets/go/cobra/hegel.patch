diff --git a/hegel/hegel_zoo_argv_test.go b/hegel/hegel_zoo_argv_test.go
new file mode 100644
index 0000000..e4a7ae6
--- /dev/null
+++ b/hegel/hegel_zoo_argv_test.go
@@ -0,0 +1,438 @@
+package hegel
+
+// The argument lists of the properties, drawn as lists of token records (hzTok: a flag
+// occurrence with its form and value, a combined short token, an odd token, a command name in
+// a variant, a positional) rendered to strings by pure functions (renderTokens): the plain
+// walk of the old argument generator towards one command (walkTokens) and the corner shapes of
+// its old shape generator, each with the contents it drew (hegel_zoo_props_test.go). Every token pool and
+// value pool is the old one (hzStringValues ... hzPositionals, hegel_zoo_exec_test.go).
+
+import (
+	"sort"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// The token kinds.
+const (
+	tokPos      = iota // a positional, or a literal of a shape (text)
+	tokFlag            // one occurrence of a flag (flag, form, value)
+	tokCombined        // several short flags in one token, the last one possibly taking a value (letters, form, value)
+	tokOdd             // a token of the odd table (text)
+	tokCmd             // a command's name in a variant (cmd, text: the name or alias, variant, n)
+)
+
+// The forms of a flag occurrence: the bare form of a bool or count flag, or the value joined
+// by "=", after a space (a token of its own) or, for a shorthand, attached.
+const (
+	formLongBare = iota
+	formLongEq
+	formLongSep
+	formShortBare
+	formShortEq
+	formShortSep
+	formShortAttached
+)
+
+// The forms of the value of a combined token's last letter.
+const (
+	combSep = iota
+	combAttached
+	combEq
+	combBare // the value left out: the flag needs an argument
+)
+
+// The variants of a command name.
+const (
+	varExact     = iota
+	varPrefix    // the first n letters
+	varCaseFirst // the first letter upper-cased
+	varUpper     // upper-cased
+	varTypo      // the letters n and n+1 swapped
+)
+
+// hzTok is one token record of an argument list.
+type hzTok struct {
+	kind    int
+	text    string        // tokPos, tokOdd: the literal; tokCmd: the name or alias the variant is of
+	flag    *hzFlagSpec   // tokFlag
+	letters []*hzFlagSpec // tokCombined: the flags of the letters
+	form    int           // tokFlag: the form; tokCombined: the value's form
+	value   string        // tokFlag, tokCombined: the value
+	cmd     *hzCmdSpec    // tokCmd
+	variant int           // tokCmd
+	n       int           // tokCmd: the prefix length or the typo index
+}
+
+// render: the strings of the token (none for a combined token without shorthands).
+func (t hzTok) render() []string {
+	switch t.kind {
+	case tokFlag:
+		long, short := "--"+t.flag.name, "-"+t.flag.short
+		switch t.form {
+		case formLongBare:
+			return []string{long}
+		case formLongEq:
+			return []string{long + "=" + t.value}
+		case formLongSep:
+			return []string{long, t.value}
+		case formShortBare:
+			return []string{short}
+		case formShortEq:
+			return []string{short + "=" + t.value}
+		case formShortSep:
+			return []string{short, t.value}
+		}
+		return []string{short + t.value}
+	case tokCombined:
+		if len(t.letters) == 0 {
+			return nil
+		}
+		tok := "-"
+		for _, f := range t.letters {
+			tok += f.short
+		}
+		if t.letters[len(t.letters)-1].noOptDef() {
+			return []string{tok}
+		}
+		switch t.form {
+		case combSep:
+			return []string{tok, t.value}
+		case combAttached:
+			return []string{tok + t.value}
+		case combEq:
+			return []string{tok + "=" + t.value}
+		}
+		return []string{tok}
+	case tokCmd:
+		return []string{nameVariant(t.text, t.variant, t.n)}
+	}
+	return []string{t.text}
+}
+
+// nameVariant: the name in the variant.
+func nameVariant(name string, variant, n int) string {
+	switch variant {
+	case varPrefix:
+		return name[:n]
+	case varCaseFirst:
+		return strings.ToUpper(name[:1]) + name[1:]
+	case varUpper:
+		return strings.ToUpper(name)
+	case varTypo:
+		return swapped(name, n)
+	}
+	return name
+}
+
+// swapped: the name with the letters i and i+1 swapped.
+func swapped(name string, i int) string {
+	b := []byte(name)
+	b[i], b[i+1] = b[i+1], b[i]
+	return string(b)
+}
+
+// renderTokens: the argument list of the tokens, at most twelve arguments.
+func renderTokens(toks []hzTok) []string {
+	argv := []string{}
+	for _, t := range toks {
+		argv = append(argv, t.render()...)
+	}
+	if len(argv) > 12 {
+		argv = argv[:12]
+	}
+	return argv
+}
+
+// lit: a literal token (a positional of the pool, or a fixed word of a shape).
+func lit(s string) hzTok { return hzTok{kind: tokPos, text: s} }
+
+// exact: the exact name of the command.
+func exact(c *hzCmdSpec) hzTok { return hzTok{kind: tokCmd, cmd: c, text: c.name} }
+
+// lits: the literal tokens of the words.
+func lits(words ...string) []hzTok {
+	out := make([]hzTok, len(words))
+	for i, w := range words {
+		out[i] = lit(w)
+	}
+	return out
+}
+
+// pathTokens: the exact names of the commands from the root's child down to c.
+func pathTokens(c *hzCmdSpec) []hzTok {
+	var out []hzTok
+	for ; c.parent != nil; c = c.parent {
+		out = append([]hzTok{exact(c)}, out...)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the tokens
+
+// The value pools by kind.
+var (
+	stringValues = hzSampled(hzStringValues...)
+	intValues    = hzSampled(hzIntValues...)
+	boolValues   = hzSampled(hzBoolValues...)
+	countValues  = hzSampled(hzCountValues...)
+	listValues   = hzSampled(hzListValues...)
+	positionals  = hzSampled(hzPositionals...)
+	posTokens    = hegel.Map(positionals, lit)
+)
+
+// valuesFor: a value from the pool of the flag's kind.
+func valuesFor(f *hzFlagSpec) hegel.Generator[string] {
+	switch f.kind {
+	case hzBool:
+		return boolValues
+	case hzInt:
+		return intValues
+	case hzCount:
+		return countValues
+	case hzSlice, hzArray:
+		return listValues
+	}
+	return stringValues
+}
+
+// wordValuesFor: a value of the flag's kind that the dispatcher can take for a command name:
+// not empty and not flag-like (the combined-short shape, cobra/1).
+func wordValuesFor(f *hzFlagSpec) hegel.Generator[string] {
+	return hegel.Filter(valuesFor(f), func(v string) bool { return v != "" && !strings.HasPrefix(v, "-") })
+}
+
+// flagTokensOf: one occurrence of the flag: the long form (55 % when it has a shorthand) or
+// the short one; a bool or count flag bare (the shrink target), with "=value" (25 % long, 20 %
+// short) or, long, with a separate value (7.5 %); a flag taking a value with a separate value
+// (55 % long, 40 % short), "=value" (45 % long, 30 % short) or attached (30 % short).
+func flagTokensOf(f *hzFlagSpec) hegel.Generator[hzTok] {
+	bare := func(form int) hegel.Generator[hzTok] { return hegel.Just(hzTok{kind: tokFlag, flag: f, form: form}) }
+	valued := func(form int) hegel.Generator[hzTok] {
+		return hegel.Map(valuesFor(f), func(v string) hzTok { return hzTok{kind: tokFlag, flag: f, form: form, value: v} })
+	}
+	var long, short hegel.Generator[hzTok]
+	if f.noOptDef() {
+		long = hzWeighted(hzW(27, bare(formLongBare)), hzW(10, valued(formLongEq)), hzW(3, valued(formLongSep)))
+		short = hzWeighted(hzW(8, bare(formShortBare)), hzW(2, valued(formShortEq)))
+	} else {
+		long = hzWeighted(hzW(55, valued(formLongSep)), hzW(45, valued(formLongEq)))
+		short = hzWeighted(hzW(4, valued(formShortSep)), hzW(3, valued(formShortEq)), hzW(3, valued(formShortAttached)))
+	}
+	if f.short == "" {
+		return long
+	}
+	return hzWeighted(hzW(55, long), hzW(45, short))
+}
+
+// shortsOf: the flags of the pool with a shorthand.
+func shortsOf(pool []*hzFlagSpec) []*hzFlagSpec {
+	var out []*hzFlagSpec
+	for _, f := range pool {
+		if f.short != "" {
+			out = append(out, f)
+		}
+	}
+	return out
+}
+
+var combForms = hzSampled(combSep, combAttached, combEq, combBare)
+
+// combinedTokensOf: 2-3 letters of the pool's shorthands in one token, the letters stopping
+// at the first flag taking a value, whose value follows separately, attached, after "=" or
+// not at all; no token when the pool has no shorthand.
+func combinedTokensOf(pool []*hzFlagSpec) hegel.Generator[hzTok] {
+	shorts := shortsOf(pool)
+	if len(shorts) == 0 {
+		return hegel.Just(hzTok{kind: tokCombined})
+	}
+	return hegel.Composite(func(tc hegel.TestCase) hzTok {
+		t := hzTok{kind: tokCombined}
+		n := hegel.Draw(tc, hzInts(2, 3))
+		for i := 0; i < n; i++ {
+			f := hegel.Draw(tc, hzSampled(shorts...))
+			t.letters = append(t.letters, f)
+			if !f.noOptDef() {
+				t.form = hegel.Draw(tc, combForms)
+				t.value = hegel.Draw(tc, valuesFor(f))
+				break
+			}
+		}
+		return t
+	})
+}
+
+// The odd tokens: the table of the old generator, each entry at one weight; the help and
+// version flags are one entry, drawn in Find mode before a command name they reach cobra/8
+// (the plain walk is filtered by the classifier under HEGEL_NO_KNOWN=1, hegel_zoo_props_test.go).
+var (
+	helpFamily = hzSampled("--help", "-h", "--help=false", "--version", "-v", "-hv")
+	oddTokens  = hegel.Map(hzWeighted(
+		hzW(2, hegel.Just("--")),
+		hzW(2, hegel.Just("-")),
+		hzW(2, hegel.Just("")),
+		hzW(2, hegel.Just("--bogus")),
+		hzW(2, hegel.Just("--bogus=1")),
+		hzW(2, hegel.Just("-Z")),
+		hzW(2, hegel.Just("---x")),
+		hzW(2, hegel.Just("--=x")),
+		hzW(2, hegel.Just("-1")),
+		hzW(2, helpFamily),
+		hzW(2, hegel.Just("-Zx")),
+		hzW(2, hegel.Map(hzSampled(hzFlagNames...), func(n string) string { return "--" + n + "x" })),
+	), func(s string) hzTok { return hzTok{kind: tokOdd, text: s} })
+)
+
+// cmdTokensOf: the command's name (or an alias, 35 % when it has any) exact (six in ten), as
+// a proper prefix, with its first letter upper-cased, upper-cased, or with two adjacent
+// letters swapped (a one-letter name has no proper prefix and a two-letter one no typo: the
+// exact name then).
+func cmdTokensOf(c *hzCmdSpec) hegel.Generator[hzTok] {
+	return hegel.FlatMap(namesOf(c, 35), func(name string) hegel.Generator[hzTok] {
+		tok := func(variant, n int) hzTok { return hzTok{kind: tokCmd, cmd: c, text: name, variant: variant, n: n} }
+		exactW := 6
+		if len(name) <= 1 {
+			exactW++
+		}
+		if len(name) <= 2 {
+			exactW++
+		}
+		return hzWeighted(
+			hzW(exactW, hegel.Just(tok(varExact, 0))),
+			hzW(hzUnless(len(name) <= 1, 1), hegel.Map(hzInts(1, len(name)-1), func(n int) hzTok { return tok(varPrefix, n) })),
+			hzW(1, hegel.Just(tok(varCaseFirst, 0))),
+			hzW(1, hegel.Just(tok(varUpper, 0))),
+			hzW(hzUnless(len(name) <= 2, 1), hegel.Map(hzInts(0, len(name)-2), func(n int) hzTok { return tok(varTypo, n) })),
+		)
+	})
+}
+
+// namesOf: the command's name, or one of its aliases pct percent of the time when it has any.
+func namesOf(c *hzCmdSpec, pct int) hegel.Generator[string] {
+	if len(c.aliases) == 0 {
+		return hegel.Just(c.name)
+	}
+	return hzWeighted(hzW(100-pct, hegel.Just(c.name)), hzW(pct, hzSampled(c.aliases...)))
+}
+
+// typosOf: a typo of the name: the name without its last letter, or (60 %, when it has two
+// different adjacent letters) those two letters swapped.
+func typosOf(name string) hegel.Generator[string] {
+	truncated := hegel.Just(name[:len(name)-1])
+	var swaps []string
+	for i := 0; i+1 < len(name); i++ {
+		if name[i] != name[i+1] {
+			swaps = append(swaps, swapped(name, i))
+		}
+	}
+	if len(swaps) == 0 {
+		return truncated
+	}
+	return hzWeighted(hzW(40, truncated), hzW(60, hzSampled(swaps...)))
+}
+
+// validArgsOf: a valid argument of the command (the word before the tab of a described one).
+func validArgsOf(c *hzCmdSpec) hegel.Generator[string] {
+	words := make([]string, len(c.validArgs))
+	for i, v := range c.validArgs {
+		words[i] = strings.SplitN(v, "\t", 2)[0]
+	}
+	return hzSampled(words...)
+}
+
+// --------------------------------------------------------------------------- the plain walk
+
+// tokensOver: one token of a sprinkle over the flag pool: a positional (16.8 %), one of the
+// pool's flags (60 %), a combined token of them (16 %) or an odd token (7.2 %); without a
+// pool a positional (70 %) or an odd token.
+func tokensOver(pool []*hzFlagSpec) hegel.Generator[hzTok] {
+	if len(pool) == 0 {
+		return hzWeighted(hzW(70, posTokens), hzW(30, oddTokens))
+	}
+	return hzWeighted(
+		hzW(168, posTokens),
+		hzW(600, hegel.FlatMap(hzSampled(pool...), flagTokensOf)),
+		hzW(160, combinedTokensOf(pool)),
+		hzW(72, oddTokens),
+	)
+}
+
+// sprinkleCounts: how many tokens the old sprinkle(pct) appended: one more at pct percent,
+// the rate falling by twenty points per token.
+func sprinkleCounts(pct int) hegel.Generator[int] {
+	var choices []hzChoice[int]
+	rest := 1000
+	for k := 0; rest > 0; k++ {
+		p := pct - 20*k
+		if p < 0 {
+			p = 0
+		}
+		more := rest * p / 100
+		choices = append(choices, hzW(rest-more, hegel.Just(k)))
+		rest = more
+	}
+	return hzWeighted(choices...)
+}
+
+// sprinklesOver: the tokens of a sprinkle at the rate over the pool.
+func sprinklesOver(pool []*hzFlagSpec, pct int) hegel.Generator[[]hzTok] {
+	return countedBy(tokensOver(pool), sprinkleCounts(pct))
+}
+
+// walkTokens: the plain walk of the old argument generator over the tree: a target command (a drawn
+// one, or a drawn deeper one at 50 %; the help command 12 %), the flag pool of what it sees
+// (plus another command's at 15 %), a sprinkle before the names and after each name (50 %),
+// the help command's topic (0-2 names or positionals), 0-3 positionals (a valid one 60 % at a
+// command with ValidArgs) each followed by a sprinkle (30 %), everything shuffled 10 % (by a
+// drawn sort key per token).
+func walkTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	cmds := t.allCmds()
+	commands := hzSampled(cmds...)
+	return hegel.Composite(func(tc hegel.TestCase) []hzTok {
+		target := hegel.Draw(tc, commands)
+		if other := hegel.Draw(tc, commands); hegel.Draw(tc, hzCoin(50)) && other.parent != nil && (target.parent == nil || other.parent.parent != nil) {
+			target = other // towards the deeper commands
+		}
+		if t.help != nil && hegel.Draw(tc, hzCoin(12)) {
+			target = t.help
+		}
+		pool := target.visible()
+		if hegel.Draw(tc, hzCoin(15)) { // flags of other commands too
+			pool = append(pool, hegel.Draw(tc, commands).visible()...)
+		}
+		var toks []hzTok
+		toks = append(toks, hegel.Draw(tc, sprinklesOver(pool, 40))...)
+		for _, c := range pathTokens(target) {
+			toks = append(toks, hegel.Draw(tc, cmdTokensOf(c.cmd)))
+			toks = append(toks, hegel.Draw(tc, sprinklesOver(pool, 50))...)
+		}
+		if target.isHelp { // a topic for the help command
+			topics := hzWeighted(hzW(70, hegel.FlatMap(commands, cmdTokensOf)), hzW(30, posTokens))
+			toks = append(toks, hegel.Draw(tc, hzCounted(topics, 0, 2))...)
+		}
+		// positional arguments (valid ones for a command with ValidArgs)
+		args := posTokens
+		if len(target.validArgs) > 0 {
+			args = hzWeighted(hzW(40, posTokens), hzW(60, hegel.Map(validArgsOf(target), lit)))
+		}
+		for _, a := range hegel.Draw(tc, hzCounted(args, 0, 3)) {
+			toks = append(toks, a)
+			toks = append(toks, hegel.Draw(tc, sprinklesOver(pool, 30))...)
+		}
+		if hegel.Draw(tc, hzCoin(10)) { // shuffle everything once in a while
+			keys := hegel.Draw(tc, hzCounted(hzInts(0, 999), len(toks), len(toks)))
+			idx := make([]int, len(toks))
+			for i := range idx {
+				idx[i] = i
+			}
+			sort.SliceStable(idx, func(a, b int) bool { return keys[idx[a]] < keys[idx[b]] })
+			out := make([]hzTok, len(toks))
+			for i, k := range idx {
+				out[i] = toks[k]
+			}
+			toks = out
+		}
+		return toks
+	})
+}
diff --git a/hegel/hegel_zoo_complete_shapes_test.go b/hegel/hegel_zoo_complete_shapes_test.go
new file mode 100644
index 0000000..29ce923
--- /dev/null
+++ b/hegel/hegel_zoo_complete_shapes_test.go
@@ -0,0 +1,287 @@
+package hegel
+
+// The shape regions of the recorded completion bugs (bugs.toml cobra/11 to cobra/15) and the
+// narrow properties over them, the pattern of hegel_zoo_execute_shapes_test.go: each region
+// is a drawn tree with the options and the completion extras the shape needs forced
+// (treesWith, completionTreesWith) and the shape's request drawn with random contents,
+// judged exactly like the wide property (judgeComplete, with the classifier completeShape
+// naming the bug). Every narrow property fails every run by default: its cases are filtered
+// by the classifier naming its bug (an instance the library happens to get right is rejected
+// and counted "filtered cobra/N"; the rates are in the comments); under HEGEL_NO_KNOWN=1 the
+// construction is one from the region next to the shape instead (hzShaped) and the property
+// passes.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowComplete runs a narrow property: every drawn case through the wide property's judge.
+func narrowComplete(t *testing.T, cases hegel.Generator[completeCase]) {
+	col := hzNewCollector(t)
+	hzGlobals(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeComplete(j, c)
+		col.count("cases")
+	})
+}
+
+// completeRegionOf: the cases of the bug's region, filtered by default by the classifier
+// naming the bug (the rejections counted "filtered cobra/N"); under HEGEL_NO_KNOWN=1 the
+// cases are the region past the shape, unfiltered (a case that happens to have a shape is
+// skipped by the judge and counted as known).
+func completeRegionOf(id string, cases hegel.Generator[completeCase]) hegel.Generator[completeCase] {
+	return hzOnly(!hzNoKnown, id, cases, func(c completeCase) bool { return completeShape(c) == id })
+}
+
+// nounWords: a word a completion function completes: empty, or a positional that is not
+// flag-like (a "-" would ask for the flag names).
+var nounWords = hzWeighted(
+	hzW(2, hegel.Just(lit(""))),
+	hzW(2, hegel.Map(hegel.Filter(positionals, func(w string) bool { return !strings.HasPrefix(w, "-") }), lit)),
+)
+
+// bareTokensOf: the flag as a bare token, long (or short, one time in three when it has a
+// shorthand).
+func bareTokensOf(f *hzFlagSpec) hegel.Generator[hzTok] {
+	return hzWeighted(
+		hzW(2, hegel.Just(hzTok{kind: tokFlag, flag: f, form: formLongBare})),
+		hzW(hzUnless(f.short == "", 1), hegel.Just(hzTok{kind: tokFlag, flag: f, form: formShortBare})),
+	)
+}
+
+// --------------------------------------------------------------------------- cobra/11
+
+// flagsOnceRegion: at an anchor with a count, slice or array flag M and a string or int flag
+// S, no ValidArgs and an echo ValidArgsFunction, M set once or twice then a word the function
+// completes; or S with an echo completion function, M set once or twice, S bare and the word
+// (the function completing S's value). Past the shape: S set once or twice instead of M (a
+// second occurrence overwrites; the function sees it once either way). An instance the
+// library gets right is a count flag set with "=value" (set, not accumulated), a slice flag
+// set to the empty value (nothing to double), a value pflag rejects, or M's short form with
+// an attached value as the last token before the word (the completion reads it as a combined
+// token whose last letter's value is being typed); measured rejection 11 % (300 cases).
+func flagsOnceCases(s compShapes, flagAt func(*hzCmdSpec) *hzFlagSpec, bare bool) hegel.Generator[completeCase] {
+	return completeCasesOf(completionTreesWith(treesWith(treeShapes{multiPair: true, noValidArgs: true}), s), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		set := hzCounted(flagTokensOf(flagAt(t.anchor)), 1, 2)
+		if bare {
+			return hzSeq(hegel.Just(pathTokens(t.anchor)), set, hzOne(bareTokensOf(t.anchor.flags[1])), hzOne(nounWords))
+		}
+		return hzSeq(hegel.Just(pathTokens(t.anchor)), set, hzOne(nounWords))
+	})
+}
+
+func multiOf(c *hzCmdSpec) *hzFlagSpec  { return c.flags[0] }
+func singleOf(c *hzCmdSpec) *hzFlagSpec { return c.flags[1] }
+
+var flagsOnceRegion = completeRegionOf("cobra/11", hzShaped(
+	hzWeighted(
+		hzW(2, flagsOnceCases(compShapes{anchorEcho: true}, multiOf, false)),
+		hzW(2, flagsOnceCases(compShapes{pairEcho: true}, multiOf, true)),
+	),
+	hzWeighted(
+		hzW(2, flagsOnceCases(compShapes{anchorEcho: true}, singleOf, false)),
+		hzW(2, flagsOnceCases(compShapes{pairEcho: true}, singleOf, true)),
+	),
+))
+
+func TestHegelCompleteFunctionsSeeFlagsOnce(t *testing.T) { narrowComplete(t, flagsOnceRegion) }
+
+// --------------------------------------------------------------------------- cobra/12
+
+// combinedValueWords: the word being typed as the value flag's value: empty, or a value of
+// its kind that is not flag-like.
+func combinedValueWords(v *hzFlagSpec) hegel.Generator[hzTok] {
+	return hzWeighted(
+		hzW(2, hegel.Just(lit(""))),
+		hzW(2, hegel.Map(hegel.Filter(valuesFor(v), func(w string) bool { return !strings.HasPrefix(w, "-") }), lit)),
+	)
+}
+
+// combinedValueCases: at an anchor with a bool flag and a value flag with shorthands, the
+// letters of one or two bool flags the anchor sees and the value flag's letter in one token,
+// as separate tokens when separate, then the word being typed as the value. Bool flags only:
+// a count letter is parsed twice when kept (cobra/11's switch alone changes the result as
+// well, and it comes first in the order), and bare after the token it is doubled too.
+func combinedValueCases(s compShapes, separate bool) hegel.Generator[completeCase] {
+	return completeCasesOf(completionTreesWith(treesWith(treeShapes{shortPair: true}), s), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		v := t.anchor.flags[1]
+		var bools []*hzFlagSpec
+		for _, f := range shortsOf(t.anchor.visible()) {
+			if f.kind == hzBool {
+				bools = append(bools, f)
+			}
+		}
+		letters := hzCounted(hzSampled(bools...), 1, 2)
+		tokens := hegel.Map(letters, func(ls []*hzFlagSpec) []hzTok {
+			if separate {
+				var toks []hzTok
+				for _, b := range ls {
+					toks = append(toks, hzTok{kind: tokFlag, flag: b, form: formShortBare})
+				}
+				return append(toks, hzTok{kind: tokFlag, flag: v, form: formShortBare})
+			}
+			return []hzTok{{kind: tokCombined, letters: append(ls, v), form: combBare}}
+		})
+		return hzSeq(hegel.Just(pathTokens(t.anchor)), tokens, hzOne(combinedValueWords(v)))
+	})
+}
+
+// combinedValueRegion: the combined token at an anchor whose value flag has an echo
+// completion function, then the word. Past the shape: the letters as separate tokens (the
+// function sees the bool flags set on both sides), or the combined token before a value flag
+// with no completion function and no file annotation (nothing to see). Measured rejection
+// 0 % (300 cases).
+var combinedValueRegion = completeRegionOf("cobra/12", hzShaped(
+	combinedValueCases(compShapes{pairEcho: true}, false),
+	hzWeighted(
+		hzW(2, combinedValueCases(compShapes{pairEcho: true}, true)),
+		hzW(2, combinedValueCases(compShapes{pairPlain: true}, false)),
+	),
+))
+
+func TestHegelCompleteCombinedShortValuesKeepTheirLetters(t *testing.T) {
+	narrowComplete(t, combinedValueRegion)
+}
+
+// --------------------------------------------------------------------------- cobra/13
+
+// casedNameCases: at an anchor whose first subcommand is available, a proper prefix of that
+// subcommand's name as the word, in a case variant when cased.
+func casedNameCases(o treeShapes, cased bool) hegel.Generator[completeCase] {
+	o.parent, o.availableChild = true, true
+	return completeCasesOf(completionTrees(treesWith(o)), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		name := t.anchor.subs[0].name
+		words := hegel.Map(hzInts(1, len(name)-1), func(n int) string { return name[:n] })
+		if cased {
+			words = hegel.FlatMap(words, caseVariants)
+		}
+		return hzSeq(hegel.Just(pathTokens(t.anchor)), hzOne(hegel.Map(words, lit)))
+	})
+}
+
+// casedNameRegion: with case-insensitive names, a case variant of a proper prefix of the
+// subcommand's name (aliases are never completed, so a prefix of one completes nothing on
+// both sides). Past the shape: the prefix as it is, or the case variant without
+// case-insensitive names (nothing completed on both sides). Measured rejection 0 % (300
+// cases).
+var casedNameRegion = completeRegionOf("cobra/13", hzShaped(
+	casedNameCases(treeShapes{caseInsensitive: true}, true),
+	hzWeighted(
+		hzW(2, casedNameCases(treeShapes{caseInsensitive: true}, false)),
+		hzW(2, casedNameCases(treeShapes{caseSensitive: true}, true)),
+	),
+))
+
+func TestHegelCompleteSubcommandPrefixesAreCaseInsensitive(t *testing.T) {
+	narrowComplete(t, casedNameRegion)
+}
+
+// --------------------------------------------------------------------------- cobra/14
+
+// persistentNoOpt: the command's own persistent flags taking no value; the bool ones alone
+// when bools (a bare count flag parsed by the final command is doubled: cobra/11's shape).
+func persistentNoOpt(c *hzCmdSpec, bools bool) []*hzFlagSpec {
+	var out []*hzFlagSpec
+	for _, f := range c.flags {
+		if f.persistent && (f.kind == hzBool || (!bools && f.kind == hzCount)) {
+			out = append(out, f)
+		}
+	}
+	return out
+}
+
+// The forms of the flag token of the Traverse shape: bare before the sub-subcommand's name
+// (the shape), bare after it (a bool flag), or with "=value" before it.
+const (
+	flagBefore = iota
+	flagAfter
+	flagEqBefore
+)
+
+// traversePersistentCases: at an anchor below the root with a persistent bool flag and a
+// persistent count flag of its own, no flag group, and a first subcommand with no ValidArgs
+// and an echo ValidArgsFunction, one token of one of those flags (the bool one alone when
+// bools) and the sub-subcommand's name in the form, then a word the function completes.
+func traversePersistentCases(o treeShapes, form int, bools bool) hegel.Generator[completeCase] {
+	o.anchorDeep, o.persistentFlag, o.noValidArgs = true, true, true
+	return completeCasesOf(completionTreesWith(treesWith(o), compShapes{childEcho: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		flags := hzSampled(persistentNoOpt(t.anchor, bools)...)
+		child := hegel.Just([]hzTok{exact(t.anchor.subs[0])})
+		var tokens hegel.Generator[[]hzTok]
+		switch form {
+		case flagBefore:
+			tokens = hzSeq(hzOne(hegel.FlatMap(flags, bareTokensOf)), child)
+		case flagAfter:
+			tokens = hzSeq(child, hzOne(hegel.FlatMap(flags, bareTokensOf)))
+		default:
+			tokens = hzSeq(hzOne(hegel.FlatMap(flags, func(f *hzFlagSpec) hegel.Generator[hzTok] {
+				return hegel.Map(valuesFor(f), func(v string) hzTok { return hzTok{kind: tokFlag, flag: f, form: formLongEq, value: v} })
+			})), child)
+		}
+		return hzSeq(hegel.Just(pathTokens(t.anchor)), tokens, hzOne(nounWords))
+	})
+}
+
+// traversePersistentRegion: with TraverseChildren, one bare token of the anchor's persistent
+// bool or count flag before the sub-subcommand's name, then the word. One token: a second
+// bare token is taken for the first one's value and the name is then found; a flag taking a
+// value takes the next argument on both sides, so only the flags taking none reach the bug.
+// Past the shape: the bool flag after the name, the flag with "=value" before it, or the
+// bool flag bare in Find mode (the count flag bare in those two places is parsed by the
+// final command, twice: cobra/11). Measured rejection 0 % (300 cases).
+var traversePersistentRegion = completeRegionOf("cobra/14", hzShaped(
+	traversePersistentCases(treeShapes{traverse: true}, flagBefore, false),
+	hzWeighted(
+		hzW(2, traversePersistentCases(treeShapes{traverse: true}, flagAfter, true)),
+		hzW(2, traversePersistentCases(treeShapes{traverse: true}, flagEqBefore, false)),
+		hzW(2, traversePersistentCases(treeShapes{noTraverse: true}, flagBefore, true)),
+	),
+))
+
+func TestHegelCompleteTraversePersistentFlagsBeforeNames(t *testing.T) {
+	narrowComplete(t, traversePersistentRegion)
+}
+
+// --------------------------------------------------------------------------- cobra/15
+
+// dashWords: the word "-" or "--" (the flag names).
+var dashWords = hzSampled(lit("-"), lit("--"))
+
+// emptyArgRequests: an empty argument at the root, then the word.
+func emptyArgRequests(words hegel.Generator[hzTok]) func(*hzTreeSpec) hegel.Generator[[]hzTok] {
+	return func(*hzTreeSpec) hegel.Generator[[]hzTok] { return hzSeq(tokensOf(lit("")), hzOne(words)) }
+}
+
+// emptyPrefixCases: at a root with subcommands, the request `"" -` or `"" --` under
+// __completeNoDesc (the descriptions printed); at a root without subcommands, ValidArgs
+// (they would answer before the function) and with an echo ValidArgsFunction, `"" ""`,
+// `"" -` or `"" --` under either request (the request dispatched to the __complete command
+// itself: its own help flag listed, the root's function not called).
+func emptyPrefixCases(o treeShapes) hegel.Generator[completeCase] {
+	parent, leaf := o, o
+	parent.anchorRoot, leaf.leaf, leaf.noValidArgs = true, true, true
+	return hzWeighted(
+		hzW(2, completeCasesAt(hegel.Just(true), completionTrees(treesWith(parent)), emptyArgRequests(dashWords))),
+		hzW(2, completeCasesOf(completionTreesWith(treesWith(leaf), compShapes{rootEcho: true}), emptyArgRequests(hzWeighted(hzW(2, hegel.Just(lit(""))), hzW(2, dashWords))))),
+	)
+}
+
+// emptyPrefixRegion: with prefix matching and TraverseChildren, the empty argument at the
+// root. Past the shape: the same requests without prefix matching (the empty argument
+// matches nothing), or in Find mode (an empty argument names no command). Measured rejection
+// 0 % (300 cases).
+var emptyPrefixRegion = completeRegionOf("cobra/15", hzShaped(
+	emptyPrefixCases(treeShapes{traverse: true, prefix: true}),
+	hzWeighted(
+		hzW(2, emptyPrefixCases(treeShapes{traverse: true, noPrefix: true})),
+		hzW(2, emptyPrefixCases(treeShapes{noTraverse: true, prefix: true})),
+	),
+))
+
+func TestHegelCompleteNoDescHidesDescriptions(t *testing.T) { narrowComplete(t, emptyPrefixRegion) }
diff --git a/hegel/hegel_zoo_complete_test.go b/hegel/hegel_zoo_complete_test.go
new file mode 100644
index 0000000..7b393c3
--- /dev/null
+++ b/hegel/hegel_zoo_complete_test.go
@@ -0,0 +1,931 @@
+package hegel
+
+// TestHegelComplete: the shell-completion request `root __complete <args...> <toComplete>`
+// (getCompletions in completions.go) over the generated trees, against a model of the
+// documented behaviour (site/content/completions/_index.md and the doc comments): subcommand
+// names, ValidArgs and ArgAliases, ValidArgsFunction after the flags are parsed, flag names
+// (the required ones first, the used ones no longer), flag values through
+// RegisterFlagCompletionFunc, MarkFlagFilename and MarkFlagDirname, the directives, and the
+// help and version flags ending the completion (the completion half of hzModel, below, with
+// every switch off). The cases are records (completeCase) drawn from package-level
+// generators: part 1's trees with the completion extras drawn as a transform
+// (completionTrees) and the request as a list of token records (hzTok) rendered to strings:
+// a prefix (a well-formed walk to a drawn command, or the plain walk of TestHegelExecute cut
+// short), a last flag wanting a value, and the word to complete from a fourteen-way table.
+// The shape of a case (one of cobra/1 to 15: the dispatcher's bugs act in a completion
+// request too, since the final command is found by the same Find or Traverse) is named by
+// the classifier completeShape before the library is called, and under HEGEL_NO_KNOWN=1 the
+// cases with a shape are filtered out. The narrow properties of
+// hegel_zoo_complete_shapes_test.go share judgeComplete.
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/spf13/cobra"
+	"hegel.dev/go/hegel"
+)
+
+const (
+	hzCompNone = iota
+	hzCompEcho
+	hzCompFixed
+)
+
+var hzFixedChoices = []string{"one\tthe first", "two", " three "}
+var hzDirectivePool = []int{0, 4, 2 | 4, 8, 16, 32 | 4, 1}
+
+// hzCompEchoLines: what the echo completion functions return: the arguments, the word to
+// complete and the changed flags as the function sees them.
+func hzCompEchoLines(args []string, toComplete string, flags []string) []string {
+	return []string{"args:" + strings.Join(args, " "), "to:" + toComplete, "flags:" + strings.Join(flags, ";")}
+}
+
+// --------------------------------------------------------------------------- the extras
+
+// compFn: a completion function of a command (ValidArgsFunction) or a flag
+// (RegisterFlagCompletionFunc): none, the echo one, or fixed choices with a directive.
+type compFn struct{ kind, directive int }
+
+// fileAnnotation: MarkFlagFilename with extensions, with none, or MarkFlagDirname.
+type fileAnnotation struct {
+	exts    []string
+	dirname bool
+}
+
+// The tables of the old extras generator, as generators (the simplest first: no function,
+// no directive, no annotation).
+var (
+	fixedFns = hegel.Map(hzSampled(hzDirectivePool...), func(d int) compFn { return compFn{kind: hzCompFixed, directive: d} })
+	// validArgsFns: a command's ValidArgsFunction, none/echo/fixed at 3:2:1; flagFns: a
+	// flag's completion function at 3:2:2.
+	validArgsFns = hzWeighted(hzW(3, hegel.Just(compFn{})), hzW(2, hegel.Just(compFn{kind: hzCompEcho})), hzW(1, fixedFns))
+	flagFns      = hzWeighted(hzW(3, hegel.Just(compFn{})), hzW(2, hegel.Just(compFn{kind: hzCompEcho})), hzW(2, fixedFns))
+	// defaultDirectives: a DefaultShellCompDirective on 15 % of the commands.
+	defaultDirectives = hzWeighted(hzW(85, hegel.Just(-1)), hzW(15, hzSampled(4, 0, 2|4)))
+	// fileAnnotations: none, extensions (15 %), an empty extension list (5 %), a directory (10 %).
+	fileAnnotations = hzWeighted(
+		hzW(70, hegel.Just(fileAnnotation{})),
+		hzW(15, hegel.Just(fileAnnotation{exts: []string{"yaml", "json"}})),
+		hzW(5, hegel.Just(fileAnnotation{exts: []string{}})),
+		hzW(10, hegel.Just(fileAnnotation{dirname: true})),
+	)
+)
+
+// compShapes: the completion extras a narrow property forces on the drawn tree
+// (completionTreesWith); the zero value forces nothing (completionTrees).
+type compShapes struct {
+	anchorEcho bool // the anchor has an echo ValidArgsFunction (cobra/11)
+	childEcho  bool // the anchor's first subcommand has one (cobra/14)
+	rootEcho   bool // the root has one (cobra/15)
+	pairEcho   bool // the second flag of the anchor's forced pair (the one taking a value) has an echo completion function and no file annotation, which would answer before it (cobra/11, 12)
+	pairPlain  bool // that flag has no completion function and no file annotation (the region past cobra/12)
+}
+
+// completionTreesWith: the trees with the completion-only parts drawn per command (a
+// ValidArgsFunction, ArgAliases at 40 % when it has ValidArgs, a DefaultShellCompDirective)
+// and per flag (hidden 10 %, a completion function, a file annotation), the failing
+// persistent hooks downgraded to plain E hooks (the __complete command runs the persistent
+// hooks of its parents and none may fail), and the extras of the shape forced. The drawn
+// tree is fresh per draw (treesWith builds one), so its fields are set inside the same draw.
+func completionTreesWith(trees hegel.Generator[*hzTreeSpec], s compShapes) hegel.Generator[*hzTreeSpec] {
+	flagExtras := hegel.Composite(func(tc hegel.TestCase) func(*hzFlagSpec) {
+		hidden, fn, annotation := hegel.Draw(tc, hzCoin(10)), hegel.Draw(tc, flagFns), hegel.Draw(tc, fileAnnotations)
+		return func(f *hzFlagSpec) {
+			f.hidden, f.compFn, f.fixedDirective, f.exts, f.dirname = hidden, fn.kind, fn.directive, annotation.exts, annotation.dirname
+		}
+	})
+	cmdExtras := func(c *hzCmdSpec) hegel.Generator[func()] {
+		aliases := hegel.Just(false)
+		if len(c.validArgs) > 0 {
+			aliases = hzCoin(40)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) func() {
+			fn, al, directive := hegel.Draw(tc, validArgsFns), hegel.Draw(tc, aliases), hegel.Draw(tc, defaultDirectives)
+			return func() {
+				c.validArgsFn, c.fixedDirective, c.defaultDirective = fn.kind, fn.directive, directive
+				if al {
+					c.argAliases = []string{"al", "be", "alias"}
+				}
+			}
+		})
+	}
+	return hegel.FlatMap(trees, func(t *hzTreeSpec) hegel.Generator[*hzTreeSpec] {
+		return hegel.Composite(func(tc hegel.TestCase) *hzTreeSpec {
+			for _, c := range t.allCmds() {
+				if c.ppre == hzHookEFail {
+					c.ppre = hzHookE
+				}
+				if c.ppost == hzHookEFail {
+					c.ppost = hzHookE
+				}
+				hegel.Draw(tc, cmdExtras(c))()
+				for _, f := range c.flags {
+					hegel.Draw(tc, flagExtras)(f)
+				}
+			}
+			if s.anchorEcho {
+				t.anchor.validArgsFn = hzCompEcho
+			}
+			if s.childEcho {
+				t.anchor.subs[0].validArgsFn = hzCompEcho
+			}
+			if s.rootEcho {
+				t.root.validArgsFn = hzCompEcho
+			}
+			if s.pairEcho || s.pairPlain {
+				f := t.anchor.flags[1]
+				f.compFn, f.exts, f.dirname = hzCompNone, nil, false
+				if s.pairEcho {
+					f.compFn = hzCompEcho
+				}
+			}
+			return t
+		})
+	})
+}
+
+// completionTrees: the plain trees with the extras drawn.
+func completionTrees(trees hegel.Generator[*hzTreeSpec]) hegel.Generator[*hzTreeSpec] {
+	return completionTreesWith(trees, compShapes{})
+}
+
+// --------------------------------------------------------------------------- the requests
+
+// completeCase: a tree and a completion request (the arguments of __complete, the last one
+// the word to complete), under __completeNoDesc when noDesc.
+type completeCase struct {
+	tree   *hzTreeSpec
+	args   []string
+	noDesc bool
+}
+
+// request: the name of the hidden command the request goes to.
+func (c completeCase) request() string {
+	if c.noDesc {
+		return "__completeNoDesc"
+	}
+	return "__complete"
+}
+
+func (c completeCase) GoString() string {
+	return fmt.Sprintf("%s %q\n%s", c.request(), c.args, c.tree.describe())
+}
+
+// renderRequest: the arguments of the request, every token rendered (no cap: the last
+// token, the word, must stay).
+func renderRequest(toks []hzTok) []string {
+	argv := []string{}
+	for _, t := range toks {
+		argv = append(argv, t.render()...)
+	}
+	return argv
+}
+
+// completeCasesAt: the cases over a tree generator and a request generator per tree (the
+// prefix tokens, then the word), the request under __completeNoDesc when noDesc says so.
+func completeCasesAt(noDesc hegel.Generator[bool], trees hegel.Generator[*hzTreeSpec], requests func(*hzTreeSpec) hegel.Generator[[]hzTok]) hegel.Generator[completeCase] {
+	return hegel.FlatMap(trees, func(t *hzTreeSpec) hegel.Generator[completeCase] {
+		return hegel.Composite(func(tc hegel.TestCase) completeCase {
+			toks := hegel.Draw(tc, requests(t))
+			return completeCase{tree: t, args: renderRequest(toks), noDesc: hegel.Draw(tc, noDesc)}
+		})
+	})
+}
+
+// completeCasesOf: the cases with __completeNoDesc 30 % of the time.
+func completeCasesOf(trees hegel.Generator[*hzTreeSpec], requests func(*hzTreeSpec) hegel.Generator[[]hzTok]) hegel.Generator[completeCase] {
+	return completeCasesAt(hzCoin(30), trees, requests)
+}
+
+// flagOrCombined: one of the pool's flags (75 %) or a combined token of them.
+func flagOrCombined(pool []*hzFlagSpec) hegel.Generator[hzTok] {
+	return hzWeighted(hzW(75, hegel.FlatMap(hzSampled(pool...), flagTokensOf)), hzW(25, combinedTokensOf(pool)))
+}
+
+// trailingAt: one trailing token of the well-formed walk at c: a positional, one of the
+// flags it sees (50 %), "--" (8 %) or a valid argument (when it has ValidArgs; the old
+// generator's 50 % of the rest).
+func trailingAt(c *hzCmdSpec, vis []*hzFlagSpec) hegel.Generator[hzTok] {
+	choices := []hzChoice[hzTok]{hzW(21, posTokens)}
+	if len(vis) > 0 {
+		choices = append(choices, hzW(50, hegel.FlatMap(hzSampled(vis...), flagTokensOf)))
+	}
+	choices = append(choices, hzW(8, hegel.Just(lit("--"))))
+	if len(c.validArgs) > 0 {
+		choices = append(choices, hzW(21, hegel.Map(validArgsOf(c), lit)))
+	}
+	return hzWeighted(choices...)
+}
+
+// wellFormedAt: a well-formed walk to c: its path names, each exact (80 %) or in a variant
+// (cmdTokensOf), after each 0-2 of the flags c sees (a combined token 25 %), then 0-3
+// trailing tokens.
+func wellFormedAt(c *hzCmdSpec, vis []*hzFlagSpec) hegel.Generator[[]hzTok] {
+	flags := hegel.Just[[]hzTok](nil)
+	if len(vis) > 0 {
+		flags = hzCounted(flagOrCombined(vis), 0, 2)
+	}
+	var gens []hegel.Generator[[]hzTok]
+	for _, p := range pathTokens(c) {
+		gens = append(gens, hzOne(hzWeighted(hzW(80, hegel.Just(p)), hzW(20, cmdTokensOf(p.cmd)))), flags)
+	}
+	gens = append(gens, hzCounted(trailingAt(c, vis), 0, 3))
+	return hzSeq(gens...)
+}
+
+// cutArgv: the argument list of a case of TestHegelExecute cut to at most six arguments,
+// then (60 %) cut again at a drawn point; as literal tokens.
+func cutArgv(argv []string) hegel.Generator[[]hzTok] {
+	return hegel.Composite(func(tc hegel.TestCase) []hzTok {
+		if len(argv) > 6 {
+			argv = argv[:hegel.Draw(tc, hzInts(0, 6))]
+		}
+		if hegel.Draw(tc, hzCoin(60)) && len(argv) > 0 {
+			argv = argv[:hegel.Draw(tc, hzInts(0, len(argv)))]
+		}
+		return lits(argv...)
+	})
+}
+
+// firstNoOptShort: the first flag of the pool with a shorthand that takes no value.
+func firstNoOptShort(pool []*hzFlagSpec) *hzFlagSpec {
+	for _, g := range pool {
+		if g.short != "" && g.noOptDef() {
+			return g
+		}
+	}
+	return nil
+}
+
+// lastFlagsAt: nothing, or (25 %, when c sees flags) a last flag token wanting a value: the
+// long form, or (40 % when it has a shorthand) the short one, with the first bool or count
+// letter of the pool prepended 30 % of the time (a combined token).
+func lastFlagsAt(vis []*hzFlagSpec) hegel.Generator[[]hzTok] {
+	if len(vis) == 0 {
+		return hegel.Just[[]hzTok](nil)
+	}
+	one := hegel.FlatMap(hzSampled(vis...), func(f *hzFlagSpec) hegel.Generator[hzTok] {
+		long := hegel.Just(hzTok{kind: tokFlag, flag: f, form: formLongBare})
+		if f.short == "" {
+			return long
+		}
+		short := hegel.Just(hzTok{kind: tokFlag, flag: f, form: formShortBare})
+		if g := firstNoOptShort(vis); g != nil {
+			short = hzWeighted(hzW(70, short), hzW(30, hegel.Just(hzTok{kind: tokCombined, letters: []*hzFlagSpec{g, f}, form: combBare})))
+		}
+		return hzWeighted(hzW(60, long), hzW(40, short))
+	})
+	return hzMaybe(25, hzOne(one))
+}
+
+// The words to complete that need no flag or command: the odd words of the old table.
+var oddWords = hzSampled("a", "al", "he", "x", "-Z", "--bogus", "--bogus=1", "-Z=1", "--=x", "-=x", "--help", "-h", "--version")
+
+// prefixesOf: a prefix of length 0 to len(w) of the word.
+func prefixesOf(w string) hegel.Generator[string] {
+	return hegel.Map(hzInts(0, len(w)), func(n int) string { return w[:n] })
+}
+
+// wordsAt: the word to complete at c, the fourteen-way table of the old generator: empty
+// (3), "-", "--", "--" and a prefix of the long name of a flag c sees (2), a short flag,
+// "--name=" with a value 50 %, "-s=value", a prefix of a subcommand's name (or of a valid
+// argument), an odd word, a positional (2); the empty word where the table has nothing to
+// draw from (no flag, no shorthand, no subcommand).
+func wordsAt(c *hzCmdSpec, vis []*hzFlagSpec) hegel.Generator[hzTok] {
+	empty := hegel.Just("")
+	longPrefix, short, longEq, shortEq := empty, empty, empty, empty
+	if len(vis) > 0 {
+		flags := hzSampled(vis...)
+		longPrefix = hegel.FlatMap(flags, func(f *hzFlagSpec) hegel.Generator[string] {
+			return hegel.Map(prefixesOf(f.name), func(p string) string { return "--" + p })
+		})
+		short = hegel.Map(flags, func(f *hzFlagSpec) string {
+			if f.short == "" {
+				return ""
+			}
+			return "-" + f.short
+		})
+		longEq = hegel.FlatMap(flags, func(f *hzFlagSpec) hegel.Generator[string] {
+			return hzWeighted(hzW(50, hegel.Just("--"+f.name+"=")), hzW(50, hegel.Map(valuesFor(f), func(v string) string { return "--" + f.name + "=" + v })))
+		})
+		shortEq = hegel.FlatMap(flags, func(f *hzFlagSpec) hegel.Generator[string] {
+			if f.short == "" {
+				return empty
+			}
+			return hegel.Map(valuesFor(f), func(v string) string { return "-" + f.short + "=" + v })
+		})
+	}
+	names := empty
+	switch {
+	case len(c.subs) > 0:
+		names = hegel.FlatMap(hzSampled(c.subs...), func(s *hzCmdSpec) hegel.Generator[string] { return prefixesOf(s.name) })
+	case len(c.validArgs) > 0:
+		names = hegel.FlatMap(validArgsOf(c), prefixesOf)
+	}
+	return hegel.Map(hzWeighted(
+		hzW(3, empty),
+		hzW(1, hegel.Just("-")),
+		hzW(1, hegel.Just("--")),
+		hzW(2, longPrefix),
+		hzW(1, short),
+		hzW(1, longEq),
+		hzW(1, shortEq),
+		hzW(1, names),
+		hzW(1, oddWords),
+		hzW(2, positionals),
+	), lit)
+}
+
+// requestsAt: a completion request over the tree with the given prefix generator per drawn
+// command c (the prefix reaches it, mostly): the prefix, then a last flag of c wanting a
+// value (25 %), then the word to complete at c.
+func requestsAt(t *hzTreeSpec, prefix func(c *hzCmdSpec, vis []*hzFlagSpec) hegel.Generator[[]hzTok]) hegel.Generator[[]hzTok] {
+	return hegel.FlatMap(hzSampled(t.allCmds()...), func(c *hzCmdSpec) hegel.Generator[[]hzTok] {
+		vis := c.visible()
+		return hzSeq(prefix(c, vis), lastFlagsAt(vis), hzOne(wordsAt(c, vis)))
+	})
+}
+
+// wellFormedCases: the cases whose prefix is a well-formed walk to the drawn command, over
+// the plain trees with the extras.
+var wellFormedCases = completeCasesOf(completionTrees(trees), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	return requestsAt(t, wellFormedAt)
+})
+
+// cutCases: the cases whose prefix is the argument list of a case of TestHegelExecute (the
+// plain walk, or one of the corner shapes of the dispatcher's bugs: so the dispatcher's
+// shapes reach the completion requests as the old generator's did) cut short, over that
+// case's tree with the extras drawn (the tree is fresh per draw of executeCases).
+var cutCases = hegel.FlatMap(executeCases, func(e executeCase) hegel.Generator[completeCase] {
+	return completeCasesOf(completionTrees(hegel.Just(e.tree)), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		return requestsAt(t, func(*hzCmdSpec, []*hzFlagSpec) hegel.Generator[[]hzTok] { return cutArgv(e.argv) })
+	})
+})
+
+// completeCases: the cases of the wide property: the well-formed walks (55 %) or the cut
+// argument lists of the execution cases (45 %). Under HEGEL_NO_KNOWN=1 the cases with the
+// shape of a recorded bug (the classifier names them) are filtered out (counted "filtered
+// shaped"; the execution cases are already filtered by their own classifier and their corner
+// shapes not drawn).
+var completeCases = hzOnly(hzNoKnown, "shaped", hzWeighted(hzW(55, wellFormedCases), hzW(45, cutCases)), func(c completeCase) bool { return completeShape(c) == "" })
+
+// --------------------------------------------------------------------------- the model
+
+type hzCompResult struct {
+	lines     []string
+	directive int
+	err       string
+}
+
+func (r hzCompResult) String() string {
+	if r.err != "" {
+		return fmt.Sprintf("err=%q lines=%q", r.err, r.lines)
+	}
+	return fmt.Sprintf("lines=%q directive=%d", r.lines, r.directive)
+}
+
+func hzDirectiveName(d int) string {
+	var parts []string
+	for _, p := range []struct {
+		bit  int
+		name string
+	}{{1, "Error"}, {2, "NoSpace"}, {4, "NoFileComp"}, {8, "FilterFileExt"}, {16, "FilterDirs"}, {32, "KeepOrder"}} {
+		if d&p.bit != 0 {
+			parts = append(parts, p.name)
+		}
+	}
+	if len(parts) == 0 {
+		return "Default"
+	}
+	return strings.Join(parts, "|")
+}
+
+// snapshot/restore of the flag values, for the parse that only counts the arguments.
+func (m *hzModel) snapshot() map[*hzFlagSpec]hzMFlag {
+	s := map[*hzFlagSpec]hzMFlag{}
+	for k, v := range m.flags {
+		c := *v
+		c.list = append([]string{}, v.list...)
+		s[k] = c
+	}
+	return s
+}
+
+func (m *hzModel) restore(s map[*hzFlagSpec]hzMFlag) {
+	for k, v := range s {
+		c := v
+		*m.flags[k] = c
+	}
+}
+
+func (m *hzModel) usage(f *hzFlagSpec) string {
+	if f.synthetic {
+		return f.name + " for " + f.owner.name
+	}
+	return "usage of " + f.name
+}
+
+func (m *hzModel) flagNameComps(f *hzFlagSpec, toComplete string) []string {
+	if m.flags[f].hidden {
+		return nil
+	}
+	var out []string
+	if strings.HasPrefix("--"+f.name, toComplete) {
+		out = append(out, "--"+f.name+"\t"+m.usage(f))
+	}
+	if f.short != "" && strings.HasPrefix("-"+f.short, toComplete) {
+		out = append(out, "-"+f.short+"\t"+m.usage(f))
+	}
+	return out
+}
+
+// inheritedThenLocal: the flags as InheritedFlags().VisitAll then NonInheritedFlags().VisitAll
+// list them (each set sorted by name).
+func (m *hzModel) inheritedThenLocal(c *hzCmdSpec) []*hzFlagSpec {
+	var inh, loc []*hzFlagSpec
+	for _, f := range m.defined(c) {
+		if f.owner == c {
+			loc = append(loc, f)
+		} else {
+			inh = append(inh, f)
+		}
+	}
+	sort.Slice(inh, func(i, j int) bool { return inh[i].name < inh[j].name })
+	sort.Slice(loc, func(i, j int) bool { return loc[i].name < loc[j].name })
+	return append(inh, loc...)
+}
+
+func (m *hzModel) requiredFlagComps(c *hzCmdSpec, toComplete string) []string {
+	var out []string
+	for _, f := range m.inheritedThenLocal(c) {
+		if m.flags[f].required && !m.flags[f].changed {
+			out = append(out, m.flagNameComps(f, toComplete)...)
+		}
+	}
+	return out
+}
+
+// enforceGroupsForCompletion: flag_groups.go enforceFlagGroupsForCompletion - a set flag of a
+// required-together group makes the others required, an unsatisfied one-required group makes
+// all its flags required, a set flag of a mutually exclusive group hides the others.
+func (m *hzModel) enforceGroupsForCompletion(c *hzCmdSpec) {
+	defined := map[string]*hzFlagSpec{}
+	for _, f := range m.defined(c) {
+		defined[f.name] = f
+	}
+	for _, owner := range m.tree.allCmds() {
+		for _, g := range owner.groups {
+			all := true
+			for _, n := range g.names {
+				if defined[n] == nil {
+					all = false
+				}
+			}
+			if !all {
+				continue
+			}
+			anySet := false
+			for _, n := range g.names {
+				if m.flags[defined[n]].changed {
+					anySet = true
+				}
+			}
+			switch g.kind {
+			case hzGroupTogether:
+				if anySet {
+					for _, n := range g.names {
+						m.flags[defined[n]].required = true
+					}
+				}
+			case hzGroupOne:
+				if !anySet {
+					for _, n := range g.names {
+						m.flags[defined[n]].required = true
+					}
+				}
+			case hzGroupExclusive:
+				for _, n := range g.names {
+					if m.flags[defined[n]].changed {
+						for _, o := range g.names {
+							if o != n {
+								m.flags[defined[o]].hidden = true
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+func (m *hzModel) findFlag(c *hzCmdSpec, name string) *hzFlagSpec {
+	if len(name) == 1 {
+		return m.lookupShort(c, name[0])
+	}
+	return m.lookupLong(c, name)
+}
+
+// checkIfFlagCompletion: completions.go checkIfFlagCompletion.
+func (m *hzModel) checkIfFlagCompletion(c *hzCmdSpec, args []string, lastArg string) (*hzFlagSpec, []string, string, string) {
+	var flagName string
+	trimmed := args
+	withEqual := false
+	orgLastArg := lastArg
+	if len(lastArg) > 0 && lastArg[0] == '-' {
+		if i := strings.Index(lastArg, "="); i >= 0 {
+			if strings.HasPrefix(lastArg[:i], "--") {
+				flagName = lastArg[2:i]
+			} else {
+				flagName = lastArg[i-1 : i]
+			}
+			lastArg = lastArg[i+1:]
+			withEqual = true
+		} else {
+			return nil, args, lastArg, ""
+		}
+	}
+	if len(flagName) == 0 && len(args) > 0 {
+		prev := args[len(args)-1]
+		if hzIsFlagArg(prev) && !strings.Contains(prev, "=") {
+			if strings.HasPrefix(prev, "--") {
+				flagName = prev[2:]
+				trimmed = args[:len(args)-1]
+			} else {
+				flagName = prev[len(prev)-1:]
+				trimmed = args[:len(args)-1]
+				if len(prev) > 2 && !m.known[kCombinedFlagValueDropsLetters] {
+					// -abf: the flags a and b stay on the command line
+					trimmed = append(append([]string{}, trimmed...), prev[:len(prev)-1])
+				}
+			}
+		}
+	}
+	if len(flagName) == 0 {
+		return nil, trimmed, lastArg, ""
+	}
+	f := m.findFlag(c, flagName)
+	if f == nil {
+		return nil, args, orgLastArg, "Subcommand '" + c.name + "' does not support flag '" + flagName + "'"
+	}
+	if !withEqual && f.noOptDef() {
+		return nil, args, lastArg, ""
+	}
+	return f, trimmed, lastArg, ""
+}
+
+func (m *hzModel) changedFlagsEcho(c *hzCmdSpec) []string {
+	var out []string
+	for _, f := range m.defined(c) {
+		if m.flags[f].changed {
+			out = append(out, f.name+"="+m.flags[f].str())
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func (m *hzModel) complete(args []string, noDesc bool) hzCompResult {
+	m.inCompletion = true
+	m.merged[m.tree.root] = true // the pre-Find over the request merges the root's flags
+	m.compCmd = &hzCmdSpec{name: "__complete", parent: m.tree.root, hidden: true, defaultDirective: -1}
+	r := m.completions(args)
+	if m.calledAsReset {
+		noDesc = false
+	}
+	r.lines = hzPrintedLines(r.lines, noDesc)
+	return r
+}
+
+// completeCompCmd: the request dispatched to the __complete command itself (DisableFlagParsing:
+// no flag parsing, no flag value completion; its own help flag was added by execute()): after a
+// "-" the required flags, or the inherited then its own flag names; otherwise the required
+// flags with the default directive of the chain.
+func (m *hzModel) completeCompCmd(toComplete string) hzCompResult {
+	c := m.compCmd
+	m.addHelpFlags(c)
+	var comps []string
+	if len(toComplete) > 0 && toComplete[0] == '-' && !strings.Contains(toComplete, "=") {
+		comps = m.requiredFlagComps(c, toComplete)
+		if len(comps) == 0 {
+			for _, f := range m.inheritedThenLocal(c) {
+				multi := f.kind == hzSlice || f.kind == hzArray
+				if !m.flags[f].changed || multi {
+					comps = append(comps, m.flagNameComps(f, toComplete)...)
+				}
+			}
+		}
+		directive := 4
+		if len(comps) == 1 && strings.HasSuffix(strings.SplitN(comps[0], "\t", 2)[0], "=") {
+			directive = 2
+		}
+		return hzCompResult{lines: comps, directive: directive}
+	}
+	directive := 0
+	for p := c; p != nil; p = p.parent {
+		if p.defaultDirective >= 0 {
+			directive = p.defaultDirective
+			break
+		}
+	}
+	comps = append(comps, m.requiredFlagComps(c, toComplete)...)
+	return hzCompResult{lines: comps, directive: directive}
+}
+
+func (m *hzModel) completions(args []string) hzCompResult {
+	toComplete := args[len(args)-1]
+	trimmed := append([]string{}, args[:len(args)-1]...)
+	var final *hzCmdSpec
+	var finalArgs []string
+	var err string
+	if m.tree.traverse {
+		final, finalArgs, err = m.traverse(m.tree.root, trimmed)
+	} else {
+		final, finalArgs, err = m.find(trimmed)
+	}
+	if err != "" {
+		return hzCompResult{lines: []string{}, directive: 0}
+	}
+	if final == m.compCmd {
+		return m.completeCompCmd(toComplete)
+	}
+	m.addHelpFlags(final)
+	flag, finalArgs, toComplete, flagErr := m.checkIfFlagCompletion(final, finalArgs, toComplete)
+
+	// the parse that counts the arguments with a "--" appended tells whether a "--" was
+	// already there (then no flag completion); it also sets the flags once more
+	snap := m.snapshot()
+	_, pos1, _ := m.parse(final, append(append([]string{}, finalArgs...), "--"))
+	if !m.known[kCompletionParsesTwice] {
+		m.restore(snap)
+	}
+	e2, pos2, _ := m.parse(final, finalArgs)
+	if e2 != "" {
+		return hzCompResult{lines: []string{}, directive: 0}
+	}
+	flagCompletion := !(len(pos1) > len(pos2))
+	if flagErr != "" && flagCompletion {
+		return hzCompResult{lines: []string{}, directive: 0}
+	}
+	if m.flags[m.helpFlags[final]].changed || (final.version != "" && m.flags[m.versionFlags[final]].changed) {
+		return hzCompResult{lines: []string{}, directive: 4}
+	}
+	finalArgs = pos2
+	if flag != nil && flagCompletion {
+		if flag.exts != nil && len(flag.exts) > 0 {
+			return hzCompResult{lines: flag.exts, directive: 8}
+		}
+		if flag.dirname {
+			return hzCompResult{lines: []string{}, directive: 16}
+		}
+	}
+	var comps []string
+	directive := 0
+	m.enforceGroupsForCompletion(final)
+	if flag == nil && len(toComplete) > 0 && toComplete[0] == '-' && !strings.Contains(toComplete, "=") && flagCompletion {
+		comps = m.requiredFlagComps(final, toComplete)
+		if len(comps) == 0 {
+			for _, f := range m.inheritedThenLocal(final) {
+				multi := f.kind == hzSlice || f.kind == hzArray
+				if !m.flags[f].changed || multi {
+					comps = append(comps, m.flagNameComps(f, toComplete)...)
+				}
+			}
+		}
+		return hzCompResult{lines: comps, directive: 4}
+	}
+	for c := final; c != nil; c = c.parent {
+		if c.defaultDirective >= 0 {
+			directive = c.defaultDirective
+			break
+		}
+	}
+	if flag == nil {
+		foundLocal := false
+		if !m.tree.traverse {
+			for _, f := range final.flags {
+				if !f.persistent && m.flags[f].changed {
+					foundLocal = true
+				}
+			}
+		}
+		if len(finalArgs) == 0 && !foundLocal {
+			subs := append([]*hzCmdSpec{}, m.tree.children(final)...)
+			sort.Slice(subs, func(i, j int) bool { return subs[i].name < subs[j].name })
+			for _, s := range subs {
+				if m.isAvailable(s) || s.isHelp {
+					if m.hasCompPrefix(s.name, toComplete) {
+						comps = append(comps, s.name+"\t"+m.short(s))
+					}
+					directive = 4
+				}
+			}
+		}
+		comps = append(comps, m.requiredFlagComps(final, toComplete)...)
+		if len(final.validArgs) > 0 {
+			if len(finalArgs) == 0 {
+				for _, v := range final.validArgs {
+					if strings.HasPrefix(v, toComplete) {
+						comps = append(comps, v)
+					}
+				}
+				directive = 4
+				if len(comps) == 0 {
+					for _, a := range final.argAliases {
+						if strings.HasPrefix(a, toComplete) {
+							comps = append(comps, a)
+						}
+					}
+				}
+			}
+			return hzCompResult{lines: comps, directive: directive}
+		}
+	}
+	fn, fixed := hzCompNone, 0
+	if flag != nil && flagCompletion {
+		fn, fixed = flag.compFn, flag.fixedDirective
+	} else {
+		fn, fixed = final.validArgsFn, final.fixedDirective
+	}
+	if final.isHelp && (flag == nil || !flagCompletion) {
+		// the help command's ValidArgsFunction: the subcommands of the topic found from the root
+		topic, _, e := m.find(finalArgs)
+		if e == "" {
+			subs := append([]*hzCmdSpec{}, m.tree.children(topic)...)
+			sort.Slice(subs, func(i, j int) bool { return subs[i].name < subs[j].name })
+			for _, s := range subs {
+				if (m.isAvailable(s) || s.isHelp) && strings.HasPrefix(s.name, toComplete) {
+					comps = append(comps, s.name+"\t"+m.short(s))
+				}
+			}
+		}
+		return hzCompResult{lines: comps, directive: 4}
+	}
+	switch fn {
+	case hzCompEcho:
+		comps = append(comps, hzCompEchoLines(finalArgs, toComplete, m.changedFlagsEcho(final))...)
+		directive = 4
+	case hzCompFixed:
+		comps = append(comps, hzFixedChoices...)
+		directive = fixed
+	}
+	return hzCompResult{lines: comps, directive: directive}
+}
+
+// hasCompPrefix: the subcommand-name completion compares case-sensitively whatever
+// EnableCaseInsensitive says.
+func (m *hzModel) hasCompPrefix(name, p string) bool {
+	if m.tree.caseInsensitive && !m.known[kCompletionCaseSensitive] {
+		return strings.HasPrefix(strings.ToLower(name), strings.ToLower(p))
+	}
+	return strings.HasPrefix(name, p)
+}
+
+func (m *hzModel) short(c *hzCmdSpec) string {
+	if c.isHelp {
+		return "Help about any command"
+	}
+	return "short of " + c.name
+}
+
+// hzPrintedLines: what the __complete command prints for the completions (descriptions cut
+// for __completeNoDesc, first line only, trimmed).
+func hzPrintedLines(comps []string, noDesc bool) []string {
+	out := []string{}
+	for _, c := range comps {
+		if noDesc {
+			c = strings.SplitN(c, "\t", 2)[0]
+		}
+		c = strings.SplitN(c, "\n", 2)[0]
+		out = append(out, strings.TrimSpace(c))
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the classifier
+
+// completeShape names the recorded bug the case reaches, from the case alone, before the
+// library is called, the way executeShape does for an execution: the model is the oracle,
+// and the old model with every switch on agreed with the library on every case the old
+// generator drew, so the case departs from the documented behaviour where model(all) differs
+// from model(none) on the completion result. The name is the first bug N in order 1..15
+// whose switch alone reproduces the departure (sufficiency), else the first whose switch is
+// necessary to it (necessity, counted "shape via necessity"). The dispatcher's bugs come
+// first in the order and act in a completion request too (the final command is found by the
+// same Find or Traverse): a combined short token or a help flag before a command name in the
+// prefix, "--" under TraverseChildren, a case variant of a prefix; a case with such a
+// prefix and a completion shape at once is named by the dispatcher's bug. A departure
+// neither rule names is a hole of the classifier, named "cobra/?" (counted; none in three
+// thousand cases).
+func completeShape(c completeCase) string {
+	run := func(k known) string { return hzNewModel(c.tree, k).complete(c.args, c.noDesc).String() }
+	all, none := run(hzKnownAll), run(hzKnownNone)
+	if all == none {
+		return ""
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if run(hzKnownOnly(i)) != none {
+			hzTally("shape via sufficiency")
+			return hzKnownID(i)
+		}
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if run(hzKnownAllBut(i)) != all {
+			hzTally("shape via necessity")
+			return hzKnownID(i)
+		}
+	}
+	hzTally("shape hole")
+	return "cobra/?"
+}
+
+// --------------------------------------------------------------------------- the judge
+
+// hzCompClass: the collector's class of a completion result.
+func hzCompClass(r hzCompResult) string {
+	switch {
+	case r.err != "":
+		return "error"
+	case len(r.lines) == 0:
+		return "empty " + hzDirectiveName(r.directive)
+	case strings.HasPrefix(r.lines[0], "args:"):
+		return "echo"
+	case strings.HasPrefix(r.lines[0], "-"):
+		return "flag names"
+	case r.directive == 8:
+		return "file ext"
+	}
+	return "nouns " + hzDirectiveName(r.directive)
+}
+
+// hzRealCompletion: what the library printed for the request: the lines and the directive
+// line, or the error.
+func hzRealCompletion(r *hzReal, err error) hzCompResult {
+	var got hzCompResult
+	if err != nil {
+		got.err = err.Error()
+	}
+	out := strings.TrimSuffix(r.out.String(), "\n")
+	lines := strings.Split(out, "\n")
+	got.lines = []string{}
+	if len(lines) > 0 && strings.HasPrefix(lines[len(lines)-1], ":") {
+		fmt.Sscanf(lines[len(lines)-1], ":%d", &got.directive)
+		lines = lines[:len(lines)-1]
+	} else if err == nil {
+		got.err = "no directive line in " + fmt.Sprintf("%q", out)
+	}
+	if len(lines) == 1 && lines[0] == "" {
+		lines = nil
+	}
+	got.lines = append(got.lines, lines...)
+	return got
+}
+
+// judgeComplete judges one case: the shape named, the library's __complete or
+// __completeNoDesc on the built tree against the model's documented completion (the printed
+// lines and the directive).
+func judgeComplete(j *hzCaseJudge, c completeCase) {
+	j.Shape(completeShape(c))
+	want := hzNewModel(c.tree, hzKnownNone).complete(c.args, c.noDesc)
+	cobra.EnablePrefixMatching, cobra.EnableCaseInsensitive, cobra.EnableTraverseRunHooks = c.tree.prefix, c.tree.caseInsensitive, c.tree.traverseHooks
+	var got hzCompResult
+	if r := hzCatch(func() {
+		real := hzBuild(c.tree)
+		real.root.SetArgs(append([]string{c.request()}, c.args...))
+		_, err := real.root.ExecuteC()
+		got = hzRealCompletion(real, err)
+	}); r != nil {
+		j.Fail("panic", "%#v\npanic: %v", c, r)
+		return
+	}
+	if got.String() != want.String() {
+		class := hzCompClass(want)
+		if j.shape == "cobra/?" {
+			class = "hole"
+		}
+		j.Fail(class, "%#v\n got %s\nwant %s", c, got, want)
+		return
+	}
+	j.col.count(hzCompClass(want))
+	if c.tree.traverse {
+		j.col.count("traverse")
+	}
+}
+
+// TestHegelComplete: the completion request on a generated tree must print the documented
+// completions. The cases carry the shapes of cobra/1 to 15 at the natural rate of the request
+// table (no dedicated shape is drawn), every one named by completeShape before the library is
+// called; under HEGEL_NO_KNOWN=1 the shaped cases are filtered out.
+func TestHegelComplete(t *testing.T) {
+	col := hzNewCollector(t)
+	hzGlobals(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, completeCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeComplete(j, c)
+		col.count("cases")
+	})
+}
diff --git a/hegel/hegel_zoo_exec_test.go b/hegel/hegel_zoo_exec_test.go
new file mode 100644
index 0000000..e5f5c3e
--- /dev/null
+++ b/hegel/hegel_zoo_exec_test.go
@@ -0,0 +1,1552 @@
+package hegel
+
+// The spec records of the command trees (hzFlagSpec, hzCmdSpec, hzTreeSpec), the real tree
+// built from them (hzBuild), the result compared (hzResult) and the MODEL of the documented
+// dispatch (hzModel: Find, or Traverse with TraverseChildren; pflag's grammar for the flags;
+// the Args validators, required flags and flag groups; the help and version flags and the
+// help command; the hooks in their documented order), following the recorded bugs whose
+// switches are on in the known value it is given (none: the documented behaviour). The name
+// and value pools below serve the generators of hegel_zoo_trees_test.go and
+// hegel_zoo_argv_test.go; the completion half of the model is in hegel_zoo_complete_test.go.
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/spf13/cobra"
+	flag "github.com/spf13/pflag"
+)
+
+// --------------------------------------------------------------------------- spec
+
+const (
+	hzBool = iota
+	hzString
+	hzInt
+	hzCount
+	hzSlice
+	hzArray
+)
+
+var hzKindNames = []string{"bool", "string", "int", "count", "slice", "array"}
+
+type hzFlagSpec struct {
+	name, short string
+	kind        int
+	persistent  bool
+	required    bool
+	def         string // the default of a string or int flag
+	owner       *hzCmdSpec
+	synthetic   bool // the help and version flags cobra adds itself
+	// completion only
+	hidden         bool
+	compFn         int // hzCompNone, hzCompEcho, hzCompFixed (RegisterFlagCompletionFunc)
+	fixedDirective int
+	exts           []string // MarkFlagFilename (nil: not marked)
+	dirname        bool     // MarkFlagDirname
+}
+
+func (f *hzFlagSpec) noOptDef() bool { return f.kind == hzBool || f.kind == hzCount }
+
+func (f *hzFlagSpec) String() string {
+	s := "--" + f.name
+	if f.short != "" {
+		s += "/-" + f.short
+	}
+	s += " " + hzKindNames[f.kind]
+	if f.persistent {
+		s += " persistent"
+	}
+	if f.required {
+		s += " required"
+	}
+	if f.def != "" {
+		s += " default=" + f.def
+	}
+	if f.hidden {
+		s += " hidden"
+	}
+	switch f.compFn {
+	case hzCompEcho:
+		s += " compFn=echo"
+	case hzCompFixed:
+		s += fmt.Sprintf(" compFn=fixed(%d)", f.fixedDirective)
+	}
+	if f.exts != nil {
+		s += fmt.Sprintf(" filename=%v", f.exts)
+	}
+	if f.dirname {
+		s += " dirname"
+	}
+	return s
+}
+
+const (
+	hzArgsNil = iota
+	hzArgsNo
+	hzArgsArbitrary
+	hzArgsMin
+	hzArgsMax
+	hzArgsExact
+	hzArgsRange
+	hzArgsValid
+	hzArgsNoDup
+	hzArgsExactValid // MatchAll(ExactArgs(n), OnlyValidArgs)
+	hzArgsMinNoDup   // MatchAll(MinimumNArgs(n), NoDuplicateArgs)
+)
+
+var hzArgsNames = []string{"nil", "NoArgs", "ArbitraryArgs", "MinimumNArgs", "MaximumNArgs", "ExactArgs", "RangeArgs", "OnlyValidArgs", "NoDuplicateArgs", "MatchAll(ExactArgs,OnlyValidArgs)", "MatchAll(MinimumNArgs,NoDuplicateArgs)"}
+
+const (
+	hzGroupTogether = iota
+	hzGroupOne
+	hzGroupExclusive
+)
+
+var hzGroupNames = []string{"RequiredTogether", "OneRequired", "MutuallyExclusive"}
+
+type hzGroupSpec struct {
+	kind  int
+	names []string
+}
+
+const (
+	hzHookNone = iota
+	hzHookPlain
+	hzHookE
+	hzHookEFail
+)
+
+type hzCmdSpec struct {
+	name               string
+	aliases            []string
+	suggestFor         []string
+	runnable           bool
+	runE, runFails     bool
+	hidden             bool
+	deprecated         string
+	flags              []*hzFlagSpec
+	groups             []hzGroupSpec
+	argsKind, n1, n2   int
+	validArgs          []string // may carry a "\tdescription"
+	ppre, pre          int
+	post, ppost        int
+	subs               []*hzCmdSpec
+	parent             *hzCmdSpec
+	version            string
+	isHelp             bool
+	disableSuggestions bool
+	minDistance        int
+	// completion only
+	argAliases       []string
+	validArgsFn      int // hzCompNone, hzCompEcho, hzCompFixed (ValidArgsFunction)
+	fixedDirective   int
+	defaultDirective int // CompletionOptions.DefaultShellCompDirective, -1 unset
+}
+
+type hzTreeSpec struct {
+	root             *hzCmdSpec
+	traverse, prefix bool
+	caseInsensitive  bool
+	traverseHooks    bool
+	help             *hzCmdSpec // the help command cobra adds to a root with subcommands
+	anchor           *hzCmdSpec // the command with subcommands the corner shapes are built at (treesWith); nil in a plain tree
+}
+
+func (c *hzCmdSpec) path() string {
+	if c.parent == nil {
+		return c.name
+	}
+	return c.parent.path() + " " + c.name
+}
+
+// visible: the flags a command's Flags() holds once the persistent flags are merged: its own
+// (local and persistent) and its ancestors' persistent ones.
+func (c *hzCmdSpec) visible() []*hzFlagSpec {
+	var out []*hzFlagSpec
+	out = append(out, c.flags...)
+	for p := c.parent; p != nil; p = p.parent {
+		for _, f := range p.flags {
+			if f.persistent {
+				out = append(out, f)
+			}
+		}
+	}
+	return out
+}
+
+func hzHookName(k int) string {
+	return []string{"-", "plain", "E", "E-fails"}[k]
+}
+
+func (c *hzCmdSpec) describe(indent string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%s%s", indent, c.name)
+	if len(c.aliases) > 0 {
+		fmt.Fprintf(&b, " aliases=%v", c.aliases)
+	}
+	if len(c.suggestFor) > 0 {
+		fmt.Fprintf(&b, " suggestFor=%v", c.suggestFor)
+	}
+	switch {
+	case !c.runnable:
+		b.WriteString(" not-runnable")
+	case c.runFails:
+		b.WriteString(" RunE-fails")
+	case c.runE:
+		b.WriteString(" RunE")
+	default:
+		b.WriteString(" Run")
+	}
+	if c.hidden {
+		b.WriteString(" hidden")
+	}
+	if c.deprecated != "" {
+		b.WriteString(" deprecated")
+	}
+	if c.version != "" {
+		b.WriteString(" version=" + c.version)
+	}
+	if c.disableSuggestions {
+		b.WriteString(" no-suggestions")
+	}
+	if c.minDistance != 0 {
+		fmt.Fprintf(&b, " minDistance=%d", c.minDistance)
+	}
+	fmt.Fprintf(&b, " args=%s", hzArgsNames[c.argsKind])
+	switch c.argsKind {
+	case hzArgsMin, hzArgsMax, hzArgsExact, hzArgsExactValid, hzArgsMinNoDup:
+		fmt.Fprintf(&b, "(%d)", c.n1)
+	case hzArgsRange:
+		fmt.Fprintf(&b, "(%d,%d)", c.n1, c.n2)
+	}
+	if len(c.validArgs) > 0 {
+		fmt.Fprintf(&b, " validArgs=%q", c.validArgs)
+	}
+	if len(c.argAliases) > 0 {
+		fmt.Fprintf(&b, " argAliases=%q", c.argAliases)
+	}
+	switch c.validArgsFn {
+	case hzCompEcho:
+		b.WriteString(" validArgsFn=echo")
+	case hzCompFixed:
+		fmt.Fprintf(&b, " validArgsFn=fixed(%d)", c.fixedDirective)
+	}
+	if c.defaultDirective > 0 || (c.defaultDirective == 0 && c.parent != nil || c.defaultDirective == 0 && c.isHelp) {
+		fmt.Fprintf(&b, " defaultDirective=%d", c.defaultDirective)
+	}
+	if c.ppre+c.pre+c.post+c.ppost > 0 {
+		fmt.Fprintf(&b, " hooks[ppre=%s pre=%s post=%s ppost=%s]", hzHookName(c.ppre), hzHookName(c.pre), hzHookName(c.post), hzHookName(c.ppost))
+	}
+	b.WriteString("\n")
+	for _, f := range c.flags {
+		fmt.Fprintf(&b, "%s  flag %s\n", indent, f)
+	}
+	for _, g := range c.groups {
+		fmt.Fprintf(&b, "%s  group %s %v\n", indent, hzGroupNames[g.kind], g.names)
+	}
+	for _, s := range c.subs {
+		b.WriteString(s.describe(indent + "  "))
+	}
+	return b.String()
+}
+
+func (t *hzTreeSpec) describe() string {
+	var opts []string
+	if t.traverse {
+		opts = append(opts, "TraverseChildren")
+	}
+	if t.prefix {
+		opts = append(opts, "EnablePrefixMatching")
+	}
+	if t.caseInsensitive {
+		opts = append(opts, "EnableCaseInsensitive")
+	}
+	if t.traverseHooks {
+		opts = append(opts, "EnableTraverseRunHooks")
+	}
+	return fmt.Sprintf("options %v\n%s", opts, t.root.describe(""))
+}
+
+// --------------------------------------------------------------------------- generator
+
+var hzCmdNames = []string{"add", "get", "list", "lost", "run", "set", "del", "sync", "status", "start", "stop", "ls", "push", "pull", "init", "info", "rm", "show"}
+var hzFlagNames = []string{"file", "force", "name", "num", "verbose", "out", "tag", "label", "count", "dry", "all", "quiet", "level", "mode", "path", "zone", "depth", "color"}
+var hzShorts = []string{"a", "b", "c", "d", "e", "f", "g", "i", "j", "k", "l", "m", "o", "p", "q", "r", "s", "t", "u", "w", "x", "y", "z", "n"}
+var hzValidArgPool = []string{"alpha", "beta", "gamma\tthe third one", "delta", "a", "b"}
+var hzSuggestPool = []string{"remove", "create", "ps", "dir", "exec"}
+
+// children: the subcommands in the order cobra holds them (the help command last, on the root).
+func (t *hzTreeSpec) children(c *hzCmdSpec) []*hzCmdSpec {
+	if c == t.root && t.help != nil {
+		return append(append([]*hzCmdSpec{}, c.subs...), t.help)
+	}
+	return c.subs
+}
+
+func (t *hzTreeSpec) allCmds() []*hzCmdSpec {
+	var out []*hzCmdSpec
+	var walk func(c *hzCmdSpec)
+	walk = func(c *hzCmdSpec) {
+		out = append(out, c)
+		for _, s := range c.subs {
+			walk(s)
+		}
+	}
+	walk(t.root)
+	return out
+}
+
+// --- argument lists
+
+var hzStringValues = []string{"x", "a.txt", "-", "--", "-x", "a,b", "", "sub", "help", "TRUE", "3"}
+var hzIntValues = []string{"0", "7", "-3", "42", "0x1f", "010", "08", "1_0", "abc", "", "9999999999999999999", "+5"}
+var hzBoolValues = []string{"true", "false", "1", "0", "t", "F", "yes", "", "TRUE"}
+var hzCountValues = []string{"3", "0", "+1", "-2", "x", "0x2"}
+var hzListValues = []string{"a", "b", "a,b", "", "x.y", "a,,b", "c"}
+var hzPositionals = []string{"a", "b", "alpha", "beta", "gamma", "delta", "x", "-", "", "1", "help", "lst", "sup", "remove", "create", "add", "ps", "dir"}
+
+// --------------------------------------------------------------------------- the real tree
+
+type hzReal struct {
+	root  *cobra.Command
+	cmds  map[*hzCmdSpec]*cobra.Command
+	paths map[*cobra.Command]string
+	log   []string
+	out   bytes.Buffer
+	errb  bytes.Buffer
+}
+
+func hzBuild(t *hzTreeSpec) *hzReal {
+	r := &hzReal{cmds: map[*hzCmdSpec]*cobra.Command{}, paths: map[*cobra.Command]string{}}
+	var build func(c *hzCmdSpec) *cobra.Command
+	build = func(c *hzCmdSpec) *cobra.Command {
+		cmd := &cobra.Command{Use: c.name, Short: "short of " + c.name, Aliases: c.aliases, SuggestFor: c.suggestFor, Hidden: c.hidden, Deprecated: c.deprecated, Version: c.version,
+			DisableSuggestions: c.disableSuggestions, SuggestionsMinimumDistance: c.minDistance, ArgAliases: c.argAliases}
+		switch c.validArgsFn {
+		case hzCompEcho:
+			cmd.ValidArgsFunction = func(cc *cobra.Command, args []string, toComplete string) ([]string, cobra.ShellCompDirective) {
+				return hzCompEchoLines(args, toComplete, hzChangedFlags(cc)), cobra.ShellCompDirectiveNoFileComp
+			}
+		case hzCompFixed:
+			cmd.ValidArgsFunction = cobra.FixedCompletions(hzFixedChoices, cobra.ShellCompDirective(c.fixedDirective))
+		}
+		if c.defaultDirective >= 0 {
+			cmd.CompletionOptions.SetDefaultShellCompDirective(cobra.ShellCompDirective(c.defaultDirective))
+		}
+		path := c.path()
+		r.cmds[c] = cmd
+		r.paths[cmd] = path
+		hook := func(kind int, name string) (func(*cobra.Command, []string), func(*cobra.Command, []string) error) {
+			switch kind {
+			case hzHookPlain:
+				return func(cc *cobra.Command, args []string) { r.log = append(r.log, name+":"+path) }, nil
+			case hzHookE:
+				return nil, func(cc *cobra.Command, args []string) error { r.log = append(r.log, name+":"+path); return nil }
+			case hzHookEFail:
+				return nil, func(cc *cobra.Command, args []string) error {
+					r.log = append(r.log, name+":"+path)
+					return errors.New(name + " " + path + " failed")
+				}
+			}
+			return nil, nil
+		}
+		cmd.PersistentPreRun, cmd.PersistentPreRunE = hook(c.ppre, "ppre")
+		cmd.PreRun, cmd.PreRunE = hook(c.pre, "pre")
+		cmd.PostRun, cmd.PostRunE = hook(c.post, "post")
+		cmd.PersistentPostRun, cmd.PersistentPostRunE = hook(c.ppost, "ppost")
+		if c.runnable {
+			run := func(cc *cobra.Command, args []string) {
+				r.log = append(r.log, fmt.Sprintf("run:%s as=%s args=%q dash=%d", path, cc.CalledAs(), args, cc.ArgsLenAtDash()))
+			}
+			if c.runE {
+				cmd.RunE = func(cc *cobra.Command, args []string) error {
+					run(cc, args)
+					if c.runFails {
+						return errors.New("run " + path + " failed")
+					}
+					return nil
+				}
+			} else {
+				cmd.Run = run
+			}
+		}
+		for _, f := range c.flags {
+			fs := cmd.Flags()
+			if f.persistent {
+				fs = cmd.PersistentFlags()
+			}
+			switch f.kind {
+			case hzBool:
+				fs.BoolP(f.name, f.short, false, "usage of "+f.name)
+			case hzString:
+				fs.StringP(f.name, f.short, f.def, "usage of "+f.name)
+			case hzInt:
+				d := 0
+				if f.def != "" {
+					d, _ = strconv.Atoi(f.def)
+				}
+				fs.IntP(f.name, f.short, d, "usage of "+f.name)
+			case hzCount:
+				fs.CountP(f.name, f.short, "usage of "+f.name)
+			case hzSlice:
+				fs.StringSliceP(f.name, f.short, nil, "usage of "+f.name)
+			case hzArray:
+				fs.StringArrayP(f.name, f.short, nil, "usage of "+f.name)
+			}
+			if f.required {
+				if f.persistent {
+					_ = cmd.MarkPersistentFlagRequired(f.name)
+				} else {
+					_ = cmd.MarkFlagRequired(f.name)
+				}
+			}
+			if f.hidden {
+				_ = fs.MarkHidden(f.name)
+			}
+			switch f.compFn {
+			case hzCompEcho:
+				_ = cmd.RegisterFlagCompletionFunc(f.name, func(cc *cobra.Command, args []string, toComplete string) ([]string, cobra.ShellCompDirective) {
+					return hzCompEchoLines(args, toComplete, hzChangedFlags(cc)), cobra.ShellCompDirectiveNoFileComp
+				})
+			case hzCompFixed:
+				_ = cmd.RegisterFlagCompletionFunc(f.name, cobra.FixedCompletions(hzFixedChoices, cobra.ShellCompDirective(f.fixedDirective)))
+			}
+			if f.exts != nil {
+				if f.persistent {
+					_ = cmd.MarkPersistentFlagFilename(f.name, f.exts...)
+				} else {
+					_ = cmd.MarkFlagFilename(f.name, f.exts...)
+				}
+			}
+			if f.dirname {
+				if f.persistent {
+					_ = cmd.MarkPersistentFlagDirname(f.name)
+				} else {
+					_ = cmd.MarkFlagDirname(f.name)
+				}
+			}
+		}
+		switch c.argsKind {
+		case hzArgsNo:
+			cmd.Args = cobra.NoArgs
+		case hzArgsArbitrary:
+			cmd.Args = cobra.ArbitraryArgs
+		case hzArgsMin:
+			cmd.Args = cobra.MinimumNArgs(c.n1)
+		case hzArgsMax:
+			cmd.Args = cobra.MaximumNArgs(c.n1)
+		case hzArgsExact:
+			cmd.Args = cobra.ExactArgs(c.n1)
+		case hzArgsRange:
+			cmd.Args = cobra.RangeArgs(c.n1, c.n2)
+		case hzArgsValid:
+			cmd.Args = cobra.OnlyValidArgs
+		case hzArgsNoDup:
+			cmd.Args = cobra.NoDuplicateArgs
+		case hzArgsExactValid:
+			cmd.Args = cobra.MatchAll(cobra.ExactArgs(c.n1), cobra.OnlyValidArgs)
+		case hzArgsMinNoDup:
+			cmd.Args = cobra.MatchAll(cobra.MinimumNArgs(c.n1), cobra.NoDuplicateArgs)
+		}
+		cmd.ValidArgs = c.validArgs
+		for _, s := range c.subs {
+			cmd.AddCommand(build(s))
+		}
+		return cmd
+	}
+	r.root = build(t.root)
+	// the groups need the parents' persistent flags, so once the tree is complete
+	for _, c := range t.allCmds() {
+		cmd := r.cmds[c]
+		for _, g := range c.groups {
+			switch g.kind {
+			case hzGroupTogether:
+				cmd.MarkFlagsRequiredTogether(g.names...)
+			case hzGroupOne:
+				cmd.MarkFlagsOneRequired(g.names...)
+			case hzGroupExclusive:
+				cmd.MarkFlagsMutuallyExclusive(g.names...)
+			}
+		}
+	}
+	r.root.TraverseChildren = t.traverse
+	r.root.SilenceErrors, r.root.SilenceUsage = true, true
+	r.root.CompletionOptions.DisableDefaultCmd = true
+	r.root.SetOut(&r.out)
+	r.root.SetErr(&r.errb)
+	r.root.SetHelpFunc(func(c *cobra.Command, args []string) { r.log = append(r.log, "help:"+r.path(c)) })
+	r.root.SetUsageFunc(func(c *cobra.Command) error { r.log = append(r.log, "usage:"+r.path(c)); return nil })
+	return r
+}
+
+// hzChangedFlags: name=value of the changed flags a command sees, sorted.
+func hzChangedFlags(c *cobra.Command) []string {
+	var out []string
+	c.Flags().VisitAll(func(f *flag.Flag) {
+		if f.Changed {
+			out = append(out, f.Name+"="+f.Value.String())
+		}
+	})
+	sort.Strings(out)
+	return out
+}
+
+func (r *hzReal) path(c *cobra.Command) string {
+	if c == nil {
+		return "<nil>"
+	}
+	if p, ok := r.paths[c]; ok {
+		return p
+	}
+	return c.CommandPath() // the help command
+}
+
+// --------------------------------------------------------------------------- results
+
+type hzResult struct {
+	cmd   string
+	err   string
+	log   []string
+	out   string
+	flags []string // name=value/changed of the executed command's flags, when it ran without error
+}
+
+func (r hzResult) String() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "cmd=%s", r.cmd)
+	if r.err != "" {
+		fmt.Fprintf(&b, " err=%q", r.err)
+	}
+	fmt.Fprintf(&b, "\n  log=%q", r.log)
+	if r.out != "" {
+		fmt.Fprintf(&b, "\n  out=%q", r.out)
+	}
+	if r.flags != nil {
+		fmt.Fprintf(&b, "\n  flags=%q", r.flags)
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- the model
+
+type hzMFlag struct {
+	spec             *hzFlagSpec
+	b                bool
+	s                string
+	n                int64
+	list             []string
+	changed          bool
+	required, hidden bool // as the completion sees them (flag groups change them)
+}
+
+func hzCSVField(s string) string {
+	if strings.ContainsAny(s, ",\"\r\n") || strings.HasPrefix(s, " ") || strings.HasPrefix(s, "\t") {
+		return `"` + strings.ReplaceAll(s, `"`, `""`) + `"`
+	}
+	return s
+}
+
+func (f *hzMFlag) str() string {
+	switch f.spec.kind {
+	case hzBool:
+		return strconv.FormatBool(f.b)
+	case hzString:
+		return f.s
+	case hzInt, hzCount:
+		return strconv.FormatInt(f.n, 10)
+	}
+	parts := make([]string, len(f.list))
+	for i, v := range f.list {
+		parts[i] = hzCSVField(v)
+	}
+	return "[" + strings.Join(parts, ",") + "]"
+}
+
+// set: pflag's Value.Set for the kind; the error text is the cause pflag wraps.
+func (f *hzMFlag) set(value string) string {
+	switch f.spec.kind {
+	case hzBool:
+		v, err := strconv.ParseBool(value)
+		f.b = v
+		if err != nil {
+			return err.Error()
+		}
+	case hzString:
+		f.s = value
+	case hzInt:
+		v, err := strconv.ParseInt(value, 0, 64)
+		f.n = v
+		if err != nil {
+			return err.Error()
+		}
+	case hzCount:
+		if value == "+1" {
+			f.n++
+		} else {
+			v, err := strconv.ParseInt(value, 0, 0)
+			f.n = v
+			if err != nil {
+				return err.Error()
+			}
+		}
+	case hzSlice:
+		var items []string
+		if value != "" {
+			items = strings.Split(value, ",") // the generated values hold no quotes or spaces
+		}
+		if !f.changed {
+			f.list = items
+		} else {
+			f.list = append(f.list, items...)
+		}
+	case hzArray:
+		if !f.changed {
+			f.list = []string{value}
+		} else {
+			f.list = append(f.list, value)
+		}
+	}
+	f.changed = true
+	return ""
+}
+
+// The sentinels of a dispatch that ends in help or the version (the result carries no error).
+const (
+	hzErrHelp    = "\x00help"
+	hzErrVersion = "\x00version"
+)
+
+// hzModel: the model of one dispatch of argv over the tree, following the recorded bugs in
+// known (hzKnownNone: the documented behaviour). It is a pure function of (tree, argv,
+// known): every state it keeps is its own (the flag values, the help and version flags it
+// defines, the names the commands were called as, the merge state), nothing is written to
+// the tree, and no map is iterated in an order that reaches the result (flagState sorts;
+// flagGroups walks the commands in tree order and the groups by kind and key).
+type hzModel struct {
+	tree     *hzTreeSpec
+	known    known
+	flags    map[*hzFlagSpec]*hzMFlag
+	log      []string
+	out      strings.Builder
+	calledAs map[*hzCmdSpec]string
+	// helpFlags, versionFlags: the help and version flags execute() adds to a command
+	helpFlags, versionFlags map[*hzCmdSpec]*hzFlagSpec
+	// merged: the commands whose Flags() have had the persistent flags merged in
+	// (mergePersistentFlags: by stripFlags, argsMinusFirstX, ParseFlags and the help flag)
+	merged map[*hzCmdSpec]bool
+	// inTraverse: Traverse looks flags up in Flags() without merging first
+	inTraverse    bool
+	inCompletion  bool
+	calledAsReset bool       // prefix matching reset the __complete command's CalledAs
+	compCmd       *hzCmdSpec // the hidden __complete command, a child of the root in a completion request
+}
+
+func hzNewModel(t *hzTreeSpec, k known) *hzModel {
+	m := &hzModel{tree: t, known: k, flags: map[*hzFlagSpec]*hzMFlag{}, calledAs: map[*hzCmdSpec]string{}, merged: map[*hzCmdSpec]bool{},
+		helpFlags: map[*hzCmdSpec]*hzFlagSpec{}, versionFlags: map[*hzCmdSpec]*hzFlagSpec{}}
+	for _, c := range t.allCmds() {
+		if len(c.groups) > 0 {
+			// MarkFlags* merge the persistent flags into Flags() when the tree is built
+			m.merged[c] = true
+		}
+		for _, f := range c.flags {
+			mf := &hzMFlag{spec: f, required: f.required, hidden: f.hidden}
+			switch f.kind {
+			case hzString:
+				mf.s = f.def
+			case hzInt:
+				mf.n, _ = strconv.ParseInt(f.def, 10, 64)
+			}
+			m.flags[f] = mf
+		}
+	}
+	return m
+}
+
+// defined: the flags a command's FlagSet holds at this moment, the help and version flags
+// once execute() has added them.
+func (m *hzModel) defined(c *hzCmdSpec) []*hzFlagSpec {
+	out := c.visible()
+	if m.inTraverse && !m.merged[c] && m.known[kTraverseUnmergedFlags] {
+		// Flags() before any merge: the command's own local flags only
+		out = nil
+		for _, f := range c.flags {
+			if !f.persistent {
+				out = append(out, f)
+			}
+		}
+	}
+	if f := m.helpFlags[c]; f != nil {
+		out = append(out, f)
+	}
+	if f := m.versionFlags[c]; f != nil {
+		out = append(out, f)
+	}
+	return out
+}
+
+func (m *hzModel) lookupLong(c *hzCmdSpec, name string) *hzFlagSpec {
+	for _, f := range m.defined(c) {
+		if f.name == name {
+			return f
+		}
+	}
+	return nil
+}
+
+func (m *hzModel) lookupShort(c *hzCmdSpec, ch byte) *hzFlagSpec {
+	for _, f := range m.defined(c) {
+		if f.short != "" && f.short[0] == ch {
+			return f
+		}
+	}
+	return nil
+}
+
+func (m *hzModel) addHelpFlags(c *hzCmdSpec) {
+	m.merged[c] = true
+	if m.helpFlags[c] == nil {
+		m.helpFlags[c] = &hzFlagSpec{name: "help", short: "h", kind: hzBool, owner: c, synthetic: true}
+		m.flags[m.helpFlags[c]] = &hzMFlag{spec: m.helpFlags[c]}
+	}
+	if c.version != "" && m.versionFlags[c] == nil {
+		short := "v"
+		if m.lookupShort(c, 'v') != nil {
+			short = ""
+		}
+		m.versionFlags[c] = &hzFlagSpec{name: "version", short: short, kind: hzBool, owner: c, synthetic: true}
+		m.flags[m.versionFlags[c]] = &hzMFlag{spec: m.versionFlags[c]}
+	}
+}
+
+// --- pflag's grammar
+
+func (m *hzModel) flagLabel(f *hzFlagSpec) string {
+	if f.short != "" {
+		return "-" + f.short + ", --" + f.name
+	}
+	return "--" + f.name
+}
+
+func (m *hzModel) setFlag(f *hzFlagSpec, value string) string {
+	if cause := m.flags[f].set(value); cause != "" {
+		return fmt.Sprintf("invalid argument %q for %q flag: %v", value, m.flagLabel(f), cause)
+	}
+	return ""
+}
+
+func (m *hzModel) parseLong(c *hzCmdSpec, s string, args []string) ([]string, string) {
+	name := s[2:]
+	if len(name) == 0 || name[0] == '-' || name[0] == '=' {
+		return args, "bad flag syntax: " + s
+	}
+	value, hasValue := "", false
+	if i := strings.Index(name, "="); i >= 0 {
+		name, value, hasValue = name[:i], name[i+1:], true
+	}
+	f := m.lookupLong(c, name)
+	if f == nil {
+		if name == "help" {
+			return args, "pflag: help requested"
+		}
+		return args, "unknown flag: --" + name
+	}
+	switch {
+	case hasValue:
+	case f.noOptDef():
+		value = "true"
+		if f.kind == hzCount {
+			value = "+1"
+		}
+	case len(args) > 0:
+		value, args = args[0], args[1:]
+	default:
+		return args, "flag needs an argument: --" + name
+	}
+	return args, m.setFlag(f, value)
+}
+
+func (m *hzModel) parseShort(c *hzCmdSpec, s string, args []string) ([]string, string) {
+	shorthands := s[1:]
+	for len(shorthands) > 0 {
+		ch := shorthands[0]
+		f := m.lookupShort(c, ch)
+		if f == nil {
+			if ch == 'h' {
+				return args, "pflag: help requested"
+			}
+			return args, fmt.Sprintf("unknown shorthand flag: %q in -%s", rune(ch), shorthands)
+		}
+		var value string
+		switch {
+		case len(shorthands) > 2 && shorthands[1] == '=':
+			value, shorthands = shorthands[2:], ""
+		case f.noOptDef():
+			value = "true"
+			if f.kind == hzCount {
+				value = "+1"
+			}
+			shorthands = shorthands[1:]
+		case len(shorthands) > 1:
+			value, shorthands = shorthands[1:], ""
+		case len(args) > 0:
+			value, args = args[0], args[1:]
+			shorthands = ""
+		default:
+			return args, fmt.Sprintf("flag needs an argument: %q in -%s", rune(ch), shorthands)
+		}
+		if err := m.setFlag(f, value); err != "" {
+			return args, err
+		}
+	}
+	return args, ""
+}
+
+// parse: pflag's FlagSet.Parse with interspersed arguments; the positional arguments and the
+// index of "--" among them (-1 without one).
+func (m *hzModel) parse(c *hzCmdSpec, args []string) (err string, pos []string, dash int) {
+	m.merged[c] = true
+	dash = -1
+	pos = []string{}
+	for len(args) > 0 {
+		s := args[0]
+		args = args[1:]
+		if len(s) == 0 || s[0] != '-' || len(s) == 1 {
+			pos = append(pos, s)
+			continue
+		}
+		if s[1] == '-' {
+			if len(s) == 2 {
+				dash = len(pos)
+				pos = append(pos, args...)
+				break
+			}
+			args, err = m.parseLong(c, s, args)
+		} else {
+			args, err = m.parseShort(c, s, args)
+		}
+		if err != "" {
+			return err, pos, dash
+		}
+	}
+	return "", pos, dash
+}
+
+// --- the dispatcher
+
+// dispatchNoOptLong: whether the dispatcher knows --name as a flag that takes no value (a bool
+// or count flag). The help and version flags are added by execute(), after the dispatch, so
+// cobra does not know them at this point; the documented grammar does.
+func (m *hzModel) dispatchNoOptLong(c *hzCmdSpec, name string) bool {
+	if f := m.lookupLong(c, name); f != nil {
+		return f.noOptDef()
+	}
+	if !m.known[kHelpFlagSwallowsNext] && (name == "help" || (c.version != "" && name == "version")) {
+		return true
+	}
+	return false
+}
+
+func (m *hzModel) dispatchNoOptShort(c *hzCmdSpec, ch byte) bool {
+	if f := m.lookupShort(c, ch); f != nil {
+		return f.noOptDef()
+	}
+	if !m.known[kHelpFlagSwallowsNext] && (ch == 'h' || (c.version != "" && ch == 'v')) {
+		return true
+	}
+	return false
+}
+
+// consumesNext: whether the dispatcher takes the argument after token s as its value. A flag
+// it does not know (an unknown one, or the help flag before execute() adds it) is assumed to
+// take one; a bool or count flag does not.
+func (m *hzModel) consumesNext(c *hzCmdSpec, s string) bool {
+	if strings.Contains(s, "=") || !strings.HasPrefix(s, "-") || s == "--" {
+		return false
+	}
+	if strings.HasPrefix(s, "--") {
+		return !m.dispatchNoOptLong(c, s[2:])
+	}
+	if len(s) == 2 {
+		return !m.dispatchNoOptShort(c, s[1])
+	}
+	if !m.known[kCombinedShortKeepsValue] {
+		// -abf value: the letters before the last must be bool or count flags
+		letters := s[1:]
+		for i := 0; i < len(letters); i++ {
+			if m.dispatchNoOptShort(c, letters[i]) {
+				continue
+			}
+			return i == len(letters)-1
+		}
+	}
+	return false
+}
+
+// stripFlags: the arguments that can name a command (neither flags nor their values), up to "--".
+func (m *hzModel) stripFlags(c *hzCmdSpec, args []string) []string {
+	if len(args) > 0 {
+		m.merged[c] = true
+	}
+	var cmds []string
+	for len(args) > 0 {
+		s := args[0]
+		args = args[1:]
+		switch {
+		case s == "--":
+			return cmds
+		case m.consumesNext(c, s):
+			if len(args) <= 1 {
+				return cmds
+			}
+			args = args[1:]
+		case s != "" && !strings.HasPrefix(s, "-"):
+			cmds = append(cmds, s)
+		}
+	}
+	return cmds
+}
+
+// argsMinusFirstX: args without the first occurrence of x that is not a flag's value.
+func (m *hzModel) argsMinusFirstX(c *hzCmdSpec, args []string, x string) []string {
+	if len(args) > 0 {
+		m.merged[c] = true
+	}
+	for pos := 0; pos < len(args); pos++ {
+		s := args[pos]
+		switch {
+		case s == "--":
+			return args
+		case m.consumesNext(c, s):
+			pos++
+		case !strings.HasPrefix(s, "-"):
+			if s == x {
+				out := append([]string{}, args[:pos]...)
+				return append(out, args[pos+1:]...)
+			}
+		}
+	}
+	return args
+}
+
+func (m *hzModel) nameMatches(name, s string) bool {
+	if m.tree.caseInsensitive {
+		return strings.EqualFold(name, s)
+	}
+	return name == s
+}
+
+// hasPrefix: prefix matching, which cobra does case-sensitively whatever EnableCaseInsensitive says.
+func (m *hzModel) hasPrefix(name, p string) bool {
+	if m.tree.caseInsensitive && !m.known[kPrefixCaseSensitive] {
+		return strings.HasPrefix(strings.ToLower(name), strings.ToLower(p))
+	}
+	return strings.HasPrefix(name, p)
+}
+
+func (m *hzModel) findNext(c *hzCmdSpec, next string) *hzCmdSpec {
+	var matches []*hzCmdSpec
+	if m.tree.prefix && next == "" && c == m.tree.root && m.inCompletion && m.known[kPrefixMatchResetsCalledAs] {
+		// hasNameOrAliasPrefix("") sets commandCalledAs.name on every child, the __complete command included
+		m.calledAsReset = true
+	}
+	for _, sub := range m.tree.children(c) {
+		if m.nameMatches(sub.name, next) {
+			m.calledAs[sub] = next
+			return sub
+		}
+		for _, a := range sub.aliases {
+			if m.nameMatches(a, next) {
+				m.calledAs[sub] = next
+				return sub
+			}
+		}
+		if m.tree.prefix && (next != "" || m.known[kEmptyPrefixDispatch]) {
+			if m.hasPrefix(sub.name, next) {
+				m.calledAs[sub] = sub.name
+				matches = append(matches, sub)
+				continue
+			}
+			for _, a := range sub.aliases {
+				if m.hasPrefix(a, next) {
+					m.calledAs[sub] = a
+					matches = append(matches, sub)
+					break
+				}
+			}
+		}
+	}
+	if m.tree.prefix && next == "" && c == m.tree.root && m.inCompletion && m.known[kPrefixMatchResetsCalledAs] {
+		// the hidden __complete command is one more prefix match of the empty argument: the only
+		// one when the root has no other subcommand, otherwise it makes a single match ambiguous
+		if len(matches) == 0 {
+			return m.compCmd
+		}
+		return nil
+	}
+	if len(matches) == 1 {
+		return matches[0]
+	}
+	return nil
+}
+
+func (m *hzModel) isAvailable(c *hzCmdSpec) bool {
+	if c.deprecated != "" || c.hidden || c.isHelp {
+		return false
+	}
+	if c.runnable {
+		return true
+	}
+	for _, s := range c.subs {
+		if m.isAvailable(s) {
+			return true
+		}
+	}
+	return false
+}
+
+func hzLevenshtein(s, t string) int {
+	s, t = strings.ToLower(s), strings.ToLower(t)
+	d := make([][]int, len(s)+1)
+	for i := range d {
+		d[i] = make([]int, len(t)+1)
+		d[i][0] = i
+	}
+	for j := range d[0] {
+		d[0][j] = j
+	}
+	for j := 1; j <= len(t); j++ {
+		for i := 1; i <= len(s); i++ {
+			if s[i-1] == t[j-1] {
+				d[i][j] = d[i-1][j-1]
+			} else {
+				min := d[i-1][j]
+				if d[i][j-1] < min {
+					min = d[i][j-1]
+				}
+				if d[i-1][j-1] < min {
+					min = d[i-1][j-1]
+				}
+				d[i][j] = min + 1
+			}
+		}
+	}
+	return d[len(s)][len(t)]
+}
+
+// suggestions: the "Did you mean this?" tail of an unknown-command error (the user guide,
+// "Suggestions when unknown command happens": distance 2 ignoring case, or SuggestFor).
+func (m *hzModel) suggestions(c *hzCmdSpec, typed string) string {
+	if c.disableSuggestions {
+		return ""
+	}
+	min := c.minDistance
+	if min <= 0 {
+		min = 2
+	}
+	var names []string
+	for _, sub := range m.tree.children(c) {
+		if !m.isAvailable(sub) {
+			continue
+		}
+		if hzLevenshtein(typed, sub.name) <= min || strings.HasPrefix(strings.ToLower(sub.name), strings.ToLower(typed)) {
+			names = append(names, sub.name)
+		}
+		for _, s := range sub.suggestFor {
+			if strings.EqualFold(typed, s) && (m.known[kDuplicateSuggestions] || len(names) == 0 || names[len(names)-1] != sub.name) {
+				names = append(names, sub.name)
+			}
+		}
+	}
+	if len(names) == 0 {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString("\n\nDid you mean this?\n")
+	for _, n := range names {
+		fmt.Fprintf(&b, "\t%v\n", n)
+	}
+	return b.String()
+}
+
+// legacyArgs: a root with subcommands and no Args validator rejects a positional argument as
+// an unknown command (args.go).
+func (m *hzModel) legacyArgs(c *hzCmdSpec, args []string) string {
+	if len(m.tree.children(c)) == 0 {
+		return ""
+	}
+	if c.parent == nil && len(args) > 0 {
+		return fmt.Sprintf("unknown command %q for %q%s", args[0], c.path(), m.suggestions(c, args[0]))
+	}
+	return ""
+}
+
+// preFind: initCompleteCmd runs a Find over the arguments before the dispatch proper; its
+// effect that lasts is the merging of the persistent flags of the commands it visits.
+func (m *hzModel) preFind(args []string) {
+	c := m.tree.root
+	a := args
+	for {
+		stripped := m.stripFlags(c, a)
+		if len(stripped) == 0 {
+			return
+		}
+		next := m.findNext(c, stripped[0])
+		if next == nil {
+			return
+		}
+		a = m.argsMinusFirstX(c, a, stripped[0])
+		c = next
+	}
+}
+
+func (m *hzModel) find(args []string) (*hzCmdSpec, []string, string) {
+	c := m.tree.root
+	a := args
+	for {
+		stripped := m.stripFlags(c, a)
+		if len(stripped) == 0 {
+			break
+		}
+		next := m.findNext(c, stripped[0])
+		if next == nil {
+			break
+		}
+		a = m.argsMinusFirstX(c, a, stripped[0])
+		c = next
+	}
+	if c.argsKind == hzArgsNil {
+		return c, a, m.legacyArgs(c, m.stripFlags(c, a))
+	}
+	return c, a, ""
+}
+
+func hzIsFlagArg(arg string) bool {
+	return (len(arg) >= 3 && arg[0:2] == "--") || (len(arg) >= 2 && arg[0] == '-' && arg[1] != '-')
+}
+
+func (m *hzModel) traverse(c *hzCmdSpec, args []string) (*hzCmdSpec, []string, string) {
+	m.inTraverse = true
+	defer func() { m.inTraverse = false }()
+	var flags []string
+	inFlag := false
+	for i, arg := range args {
+		switch {
+		case strings.HasPrefix(arg, "--") && !strings.Contains(arg, "="):
+			if arg == "--" && !m.known[kTraverseDashDashValue] {
+				return c, args, "" // the rest is positional, for c
+			}
+			inFlag = !m.dispatchNoOptLong(c, arg[2:])
+			flags = append(flags, arg)
+			continue
+		case strings.HasPrefix(arg, "-") && !strings.Contains(arg, "=") && len(arg) == 2 && m.consumesNext(c, arg):
+			inFlag = true
+			flags = append(flags, arg)
+			continue
+		case inFlag:
+			inFlag = false
+			flags = append(flags, arg)
+			continue
+		case hzIsFlagArg(arg):
+			if m.consumesNext(c, arg) { // only a combined token with the switch off
+				inFlag = true
+			}
+			flags = append(flags, arg)
+			continue
+		}
+		cmd := m.findNext(c, arg)
+		if cmd == nil {
+			return c, args, ""
+		}
+		if !m.known[kTraverseHelpFlagError] {
+			// The documented model knows a parent's help and version flags when it parses the
+			// flags before a command name; the library defines them in execute(), after the
+			// dispatch, so pflag reports the help flag as "pflag: help requested" (cobra/6) and
+			// the version flag as unknown.
+			m.addHelpFlags(c)
+		}
+		if err, _, _ := m.parse(c, flags); err != "" {
+			return nil, args, err
+		}
+		if !m.known[kTraverseHelpFlagError] {
+			if m.flags[m.helpFlags[c]].b {
+				return c, args, hzErrHelp // a help flag among the parent's flags asks for its help
+			}
+			if c.version != "" && m.flags[m.versionFlags[c]].b {
+				return c, args, hzErrVersion // a version flag among them prints its version
+			}
+		}
+		return m.traverse(cmd, args[i+1:])
+	}
+	return c, args, ""
+}
+
+// --- execution
+
+func (m *hzModel) validateArgs(c *hzCmdSpec, args []string) string {
+	onlyValid := func() string {
+		if len(c.validArgs) == 0 {
+			return ""
+		}
+		var valid []string
+		for _, v := range c.validArgs {
+			valid = append(valid, strings.SplitN(v, "\t", 2)[0])
+		}
+		for _, v := range args {
+			found := false
+			for _, ok := range valid {
+				if ok == v {
+					found = true
+				}
+			}
+			if !found {
+				typed := v
+				if m.known[kValidArgsSuggestFirst] {
+					typed = args[0]
+				}
+				return fmt.Sprintf("invalid argument %q for %q%s", v, c.path(), m.suggestions(c, typed))
+			}
+		}
+		return ""
+	}
+	noDup := func() string {
+		seen := map[string]bool{}
+		for _, a := range args {
+			if seen[a] {
+				return fmt.Sprintf("duplicate argument %q for %q", a, c.path())
+			}
+			seen[a] = true
+		}
+		return ""
+	}
+	min := func(n int) string {
+		if len(args) < n {
+			return fmt.Sprintf("requires at least %d arg(s), only received %d", n, len(args))
+		}
+		return ""
+	}
+	exact := func(n int) string {
+		if len(args) != n {
+			return fmt.Sprintf("accepts %d arg(s), received %d", n, len(args))
+		}
+		return ""
+	}
+	switch c.argsKind {
+	case hzArgsNo:
+		if len(args) > 0 {
+			return fmt.Sprintf("unknown command %q for %q", args[0], c.path())
+		}
+	case hzArgsMin:
+		return min(c.n1)
+	case hzArgsMax:
+		if len(args) > c.n1 {
+			return fmt.Sprintf("accepts at most %d arg(s), received %d", c.n1, len(args))
+		}
+	case hzArgsExact:
+		return exact(c.n1)
+	case hzArgsRange:
+		if len(args) < c.n1 || len(args) > c.n2 {
+			return fmt.Sprintf("accepts between %d and %d arg(s), received %d", c.n1, c.n2, len(args))
+		}
+	case hzArgsValid:
+		return onlyValid()
+	case hzArgsNoDup:
+		return noDup()
+	case hzArgsExactValid:
+		if e := exact(c.n1); e != "" {
+			return e
+		}
+		return onlyValid()
+	case hzArgsMinNoDup:
+		if e := min(c.n1); e != "" {
+			return e
+		}
+		return noDup()
+	}
+	return ""
+}
+
+func (m *hzModel) requiredFlags(c *hzCmdSpec) string {
+	var missing []string
+	for _, f := range m.defined(c) {
+		if f.required && !m.flags[f].changed {
+			missing = append(missing, f.name)
+		}
+	}
+	if len(missing) == 0 {
+		return ""
+	}
+	sort.Strings(missing)
+	return fmt.Sprintf(`required flag(s) "%s" not set`, strings.Join(missing, `", "`))
+}
+
+// flagGroups: the groups whose every flag the command sees, checked in the documented way
+// (flag_groups.go: required-together groups first, then one-required, then mutually
+// exclusive, each kind in the order of the group keys).
+func (m *hzModel) flagGroups(c *hzCmdSpec) string {
+	defined := map[string]*hzFlagSpec{}
+	for _, f := range m.defined(c) {
+		defined[f.name] = f
+	}
+	type group struct {
+		key   string
+		names []string
+	}
+	byKind := map[int][]group{}
+	seen := map[string]bool{}
+	for _, owner := range m.tree.allCmds() {
+		for _, g := range owner.groups {
+			all := true
+			for _, n := range g.names {
+				if defined[n] == nil {
+					all = false
+				}
+			}
+			key := strings.Join(g.names, " ")
+			if !all || seen[fmt.Sprint(g.kind, key)] {
+				continue
+			}
+			seen[fmt.Sprint(g.kind, key)] = true
+			byKind[g.kind] = append(byKind[g.kind], group{key, g.names})
+		}
+	}
+	for _, kind := range []int{hzGroupTogether, hzGroupOne, hzGroupExclusive} {
+		groups := byKind[kind]
+		sort.Slice(groups, func(i, j int) bool { return groups[i].key < groups[j].key })
+		for _, g := range groups {
+			var set, unset []string
+			for _, n := range g.names {
+				if m.flags[defined[n]].changed {
+					set = append(set, n)
+				} else {
+					unset = append(unset, n)
+				}
+			}
+			sort.Strings(set)
+			sort.Strings(unset)
+			switch kind {
+			case hzGroupTogether:
+				if len(unset) != len(g.names) && len(unset) != 0 {
+					return fmt.Sprintf("if any flags in the group [%v] are set they must all be set; missing %v", g.key, unset)
+				}
+			case hzGroupOne:
+				if len(set) == 0 {
+					return fmt.Sprintf("at least one of the flags in the group [%v] is required", g.key)
+				}
+			case hzGroupExclusive:
+				if len(set) > 1 {
+					return fmt.Sprintf("if any flags in the group [%v] are set none of the others can be; %v were all set", g.key, set)
+				}
+			}
+		}
+	}
+	return ""
+}
+
+func (m *hzModel) hook(c *hzCmdSpec, kind int, name string) string {
+	if kind == hzHookNone {
+		return ""
+	}
+	m.log = append(m.log, name+":"+c.path())
+	if kind == hzHookEFail {
+		return name + " " + c.path() + " failed"
+	}
+	return ""
+}
+
+func (m *hzModel) execute(c *hzCmdSpec, a []string) string {
+	if c.deprecated != "" {
+		fmt.Fprintf(&m.out, "Command %q is deprecated, %s\n", c.name, c.deprecated)
+	}
+	m.addHelpFlags(c)
+	err, pos, dash := m.parse(c, a)
+	if err != "" {
+		return err
+	}
+	if m.flags[m.helpFlags[c]].b {
+		return hzErrHelp
+	}
+	if c.version != "" && m.flags[m.versionFlags[c]].b {
+		fmt.Fprintf(&m.out, "%s version %s\n", c.name, c.version)
+		return ""
+	}
+	if !c.runnable {
+		return hzErrHelp
+	}
+	if e := m.validateArgs(c, pos); e != "" {
+		return e
+	}
+	var chain []*hzCmdSpec // c up to the root
+	for p := c; p != nil; p = p.parent {
+		chain = append(chain, p)
+	}
+	if m.tree.traverseHooks {
+		for i := len(chain) - 1; i >= 0; i-- {
+			if e := m.hook(chain[i], chain[i].ppre, "ppre"); e != "" {
+				return e
+			}
+		}
+	} else {
+		for _, p := range chain {
+			if p.ppre != hzHookNone {
+				if e := m.hook(p, p.ppre, "ppre"); e != "" {
+					return e
+				}
+				break
+			}
+		}
+	}
+	if e := m.hook(c, c.pre, "pre"); e != "" {
+		return e
+	}
+	if !c.isHelp || m.known[kHelpCommandChecksFlags] {
+		if e := m.requiredFlags(c); e != "" {
+			return e
+		}
+		if e := m.flagGroups(c); e != "" {
+			return e
+		}
+	}
+	if c.isHelp {
+		m.helpCommand(pos)
+	} else {
+		m.log = append(m.log, fmt.Sprintf("run:%s as=%s args=%q dash=%d", c.path(), m.calledAs[c], pos, dash))
+		if c.runFails {
+			return "run " + c.path() + " failed"
+		}
+	}
+	if e := m.hook(c, c.post, "post"); e != "" {
+		return e
+	}
+	for _, p := range chain {
+		if p.ppost != hzHookNone {
+			if e := m.hook(p, p.ppost, "ppost"); e != "" {
+				return e
+			}
+			if !m.tree.traverseHooks {
+				break
+			}
+		}
+	}
+	return ""
+}
+
+// helpCommand: `root help [topic...]` finds the topic from the root and shows its help, or
+// reports an unknown topic and the root's usage (InitDefaultHelpCmd).
+func (m *hzModel) helpCommand(args []string) {
+	cmd, _, err := m.find(args)
+	if cmd == nil || err != "" {
+		fmt.Fprintf(&m.out, "Unknown help topic %#q\n", args)
+		m.log = append(m.log, "usage:"+m.tree.root.path())
+		return
+	}
+	m.log = append(m.log, "help:"+cmd.path())
+}
+
+func (m *hzModel) flagState(c *hzCmdSpec) []string {
+	out := []string{}
+	for _, f := range m.defined(c) {
+		out = append(out, fmt.Sprintf("%s=%s/%v", f.name, m.flags[f].str(), m.flags[f].changed))
+	}
+	sort.Strings(out)
+	return out
+}
+
+func (m *hzModel) run(argv []string) hzResult {
+	// the help command is the only command whose help-command Find sees before its execute:
+	// the pre-Find of initCompleteCmd has the same effect as the real one, nothing to model.
+	m.preFind(argv)
+	var cmd *hzCmdSpec
+	var flags []string
+	var err string
+	if m.tree.traverse {
+		cmd, flags, err = m.traverse(m.tree.root, argv)
+		if err == "" && cmd.argsKind == hzArgsNil && !m.known[kTraverseSkipsUnknownCheck] {
+			err = m.legacyArgs(cmd, m.stripFlags(cmd, flags))
+		}
+	} else {
+		cmd, flags, err = m.find(argv)
+	}
+	// a parent's help or version flag before a command name (the documented model with
+	// cobra/6 off): the parent answers as execute() would, its deprecation notice first
+	if err == hzErrHelp || err == hzErrVersion {
+		if cmd.deprecated != "" {
+			fmt.Fprintf(&m.out, "Command %q is deprecated, %s\n", cmd.name, cmd.deprecated)
+		}
+		if err == hzErrHelp {
+			m.log = append(m.log, "help:"+cmd.path())
+		} else {
+			fmt.Fprintf(&m.out, "%s version %s\n", cmd.name, cmd.version)
+		}
+		return hzResult{cmd: cmd.path(), log: m.log, out: m.out.String(), flags: m.flagState(cmd)}
+	}
+	if err != "" {
+		c := m.tree.root
+		if cmd != nil {
+			c = cmd
+		}
+		return hzResult{cmd: c.path(), err: err, log: m.log, out: m.out.String()}
+	}
+	if m.calledAs[cmd] == "" {
+		m.calledAs[cmd] = cmd.name
+	}
+	e := m.execute(cmd, flags)
+	if e == hzErrHelp {
+		m.log = append(m.log, "help:"+cmd.path())
+		e = ""
+	}
+	res := hzResult{cmd: cmd.path(), err: e, log: m.log, out: m.out.String()}
+	if e == "" {
+		res.flags = m.flagState(cmd)
+	}
+	return res
+}
+
+// --------------------------------------------------------------------------- the property
+
+func hzRealResult(r *hzReal, c *cobra.Command, err error) hzResult {
+	res := hzResult{cmd: r.path(c), log: r.log, out: r.out.String()}
+	if err != nil {
+		res.err = err.Error()
+		return res
+	}
+	if c != nil {
+		res.flags = []string{}
+		c.Flags().VisitAll(func(f *flag.Flag) {
+			res.flags = append(res.flags, fmt.Sprintf("%s=%s/%v", f.Name, f.Value.String(), f.Changed))
+		})
+		sort.Strings(res.flags)
+	}
+	return res
+}
+
+func hzErrClass(err string) string {
+	switch {
+	case strings.HasPrefix(err, "unknown command"):
+		return "unknown command"
+	case strings.HasPrefix(err, "unknown flag"), strings.HasPrefix(err, "unknown shorthand"):
+		return "unknown flag"
+	case strings.HasPrefix(err, "flag needs an argument"):
+		return "needs argument"
+	case strings.HasPrefix(err, "invalid argument") && strings.Contains(err, " flag: "):
+		return "invalid value"
+	case strings.HasPrefix(err, "invalid argument"):
+		return "invalid positional"
+	case strings.HasPrefix(err, "required flag"):
+		return "required flag"
+	case strings.Contains(err, "group ["):
+		return "flag group"
+	case strings.HasSuffix(err, "failed"):
+		return "hook"
+	case strings.HasPrefix(err, "bad flag syntax"):
+		return "bad syntax"
+	case strings.HasPrefix(err, "pflag: help"):
+		return "pflag help"
+	}
+	return "args validator"
+}
diff --git a/hegel/hegel_zoo_execute_shapes_test.go b/hegel/hegel_zoo_execute_shapes_test.go
new file mode 100644
index 0000000..abdf323
--- /dev/null
+++ b/hegel/hegel_zoo_execute_shapes_test.go
@@ -0,0 +1,379 @@
+package hegel
+
+// The shape regions of the recorded dispatcher bugs (bugs.toml cobra/1 to cobra/10) and the
+// narrow properties over them: each region is a drawn tree with the options the shape needs
+// forced (treesWith) and the shape's tokens drawn with random contents (the flags, values,
+// names and surroundings), judged exactly like the wide property (judgeExecute, with the
+// classifier executeShape naming the bug). Every narrow property fails every run by default:
+// its cases are filtered by the classifier naming its bug, so that an instance of the
+// documented shape the library happens to get right is rejected and counted ("filtered
+// cobra/N"; the rates are in the comments); under HEGEL_NO_KNOWN=1 the construction is one
+// from the region next to the shape instead (hzShaped) and the property passes.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// narrowExecute runs a narrow property: every drawn case through the wide property's judge.
+func narrowExecute(t *testing.T, cases hegel.Generator[executeCase]) {
+	col := hzNewCollector(t)
+	hzGlobals(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeExecute(j, c)
+		col.count("cases")
+	})
+}
+
+// regionOf: the cases of the bug's region, filtered by default by the classifier naming the
+// bug (the rejections counted "filtered cobra/N"); under HEGEL_NO_KNOWN=1 the cases are the
+// region past the shape, unfiltered (a case that happens to have a shape is skipped by the
+// judge and counted as known).
+func regionOf(id string, cases hegel.Generator[executeCase]) hegel.Generator[executeCase] {
+	return hzOnly(!hzNoKnown, id, cases, func(c executeCase) bool { return executeShape(c) == id })
+}
+
+// strangers: the positionals that name no command under c in the tree (no name, alias,
+// unique prefix with prefix matching, nor the help command at the root); "" and "-" are
+// skipped by the legacy check on both sides.
+func strangers(t *hzTreeSpec, c *hzCmdSpec) hegel.Generator[hzTok] {
+	m := hzNewModel(t, hzKnownNone)
+	return hegel.Map(hegel.Filter(positionals, func(w string) bool { return w != "" && w != "-" && m.findNext(c, w) == nil }), lit)
+}
+
+// tokensOf: a token-list generator of the fixed tokens.
+func tokensOf(toks ...hzTok) hegel.Generator[[]hzTok] { return hegel.Just(toks) }
+
+// withTail: the tokens followed by a tail (nothing, or a positional).
+func withTail(toks hegel.Generator[[]hzTok]) hegel.Generator[[]hzTok] { return hzSeq(toks, tails) }
+
+// before: the path to the anchor, then the tokens.
+func before(t *hzTreeSpec, toks hegel.Generator[[]hzTok]) hegel.Generator[[]hzTok] {
+	return hzSeq(hegel.Just(pathTokens(t.anchor)), toks)
+}
+
+// --------------------------------------------------------------------------- cobra/1
+
+// combinedShortRegion: at the anchor, a combined short token of one or two bool letters and
+// a value flag's letter, then the value (a word: an empty or flag-like value is skipped on
+// both sides) as a token of its own, the subcommand's name and a tail (70 %), or the name at
+// once (the flag needs an argument). Past the shape: the value attached or after "=", or
+// the letters as separate flags. Measured rejection 0 % (300 cases).
+var combinedShortRegion = regionOf("cobra/1", casesOf("combined short", treesWith(treeShapes{parent: true, shortPair: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	var bools, vals []*hzFlagSpec
+	for _, f := range shortsOf(t.anchor.visible()) {
+		if f.noOptDef() {
+			bools = append(bools, f)
+		} else {
+			vals = append(vals, f)
+		}
+	}
+	letters := hegel.Map(hzTuple(hzCounted(hzSampled(bools...), 1, 2), hzOne(hzSampled(vals...))), func(ls [][]*hzFlagSpec) []*hzFlagSpec {
+		return append(ls[0], ls[1]...)
+	})
+	tokens := func(form int, values func(*hzFlagSpec) hegel.Generator[string]) hegel.Generator[[]hzTok] {
+		return hegel.Composite(func(tc hegel.TestCase) []hzTok {
+			ls := hegel.Draw(tc, letters)
+			child := hegel.Draw(tc, anchorChildren(t))
+			tok := hzTok{kind: tokCombined, letters: ls, form: form}
+			if values != nil {
+				tok.value = hegel.Draw(tc, values(ls[len(ls)-1]))
+			}
+			return append(pathTokens(t.anchor), tok, exact(child))
+		})
+	}
+	// an attached empty value is the bare token: the shape
+	nonEmptyValues := func(f *hzFlagSpec) hegel.Generator[string] {
+		return hegel.Filter(valuesFor(f), func(v string) bool { return v != "" })
+	}
+	separate := hegel.Composite(func(tc hegel.TestCase) []hzTok {
+		ls := hegel.Draw(tc, letters)
+		child := hegel.Draw(tc, anchorChildren(t))
+		toks := pathTokens(t.anchor)
+		for _, b := range ls[:len(ls)-1] {
+			toks = append(toks, hzTok{kind: tokFlag, flag: b, form: formShortBare})
+		}
+		v := ls[len(ls)-1]
+		toks = append(toks, hzTok{kind: tokFlag, flag: v, form: formShortSep, value: hegel.Draw(tc, valuesFor(v))})
+		return append(toks, exact(child))
+	})
+	shape := hzWeighted(hzW(70, withTail(tokens(combSep, wordValuesFor))), hzW(30, tokens(combBare, nil)))
+	past := hzWeighted(hzW(2, withTail(tokens(combAttached, nonEmptyValues))), hzW(2, withTail(tokens(combEq, valuesFor))), hzW(2, withTail(separate)))
+	return hzShaped(shape, past)
+}))
+
+func TestHegelExecuteCombinedShortValuesAreSkipped(t *testing.T) {
+	narrowExecute(t, combinedShortRegion)
+}
+
+// --------------------------------------------------------------------------- cobra/2
+
+// dashDashRegion: with TraverseChildren, "--", a positional, the subcommand's name and a
+// tail at the anchor. Past the shape: the name before "--", one or two positionals naming
+// no command after it, or the same tokens in Find mode. Measured rejection 0 % (300 cases).
+var dashDashRegion = regionOf("cobra/2", hzShaped(
+	casesOf("dash dash", treesWith(treeShapes{parent: true, traverse: true}), dashDashTokens),
+	hzWeighted(
+		hzW(2, casesOf("dash dash", treesWith(treeShapes{parent: true, traverse: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+			return hegel.FlatMap(anchorChildren(t), func(child *hzCmdSpec) hegel.Generator[[]hzTok] {
+				return hzWeighted(
+					hzW(2, withTail(before(t, hzSeq(tokensOf(exact(child), lit("--")), hzOne(posTokens))))),
+					hzW(2, before(t, hzSeq(tokensOf(lit("--")), hzCounted(strangers(t, t.anchor), 1, 2)))),
+				)
+			})
+		})),
+		hzW(2, casesOf("dash dash", treesWith(treeShapes{parent: true, noTraverse: true}), dashDashTokens)),
+	),
+))
+
+func TestHegelExecuteDashDashEndsTheCommandNames(t *testing.T) { narrowExecute(t, dashDashRegion) }
+
+// --------------------------------------------------------------------------- cobra/3
+
+// unknownCommandRegion: with TraverseChildren, a runnable root with subcommands and Args
+// nil, a positional naming no command and a tail. Past the shape: a subcommand's name, or
+// the same in Find mode (the unknown command is rejected on both sides). Measured
+// rejection 0 % (300 cases).
+var unknownCommandRegion = regionOf("cobra/3", hzShaped(
+	casesOf("unknown command", treesWith(treeShapes{anchorRoot: true, traverse: true, runnable: true, argsNil: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		return withTail(hzOne(strangers(t, t.root)))
+	}),
+	hzWeighted(
+		hzW(2, casesOf("unknown command", treesWith(treeShapes{anchorRoot: true, traverse: true, runnable: true, argsNil: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+			return withTail(hzOne(hegel.Map(anchorChildren(t), exact)))
+		})),
+		hzW(2, casesOf("unknown command", treesWith(treeShapes{anchorRoot: true, noTraverse: true, runnable: true, argsNil: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+			return withTail(hzOne(strangers(t, t.root)))
+		})),
+	),
+))
+
+func TestHegelExecuteTraverseRejectsUnknownCommands(t *testing.T) {
+	narrowExecute(t, unknownCommandRegion)
+}
+
+// --------------------------------------------------------------------------- cobra/4
+
+// validThenTypoRegion: at the anchor with OnlyValidArgs (or MatchAll(ExactArgs(2),
+// OnlyValidArgs)), ValidArgs and suggestions on, a valid argument that is no suggestion for
+// the first subcommand's name itself (within the distance or a prefix of it: "a" for add,
+// "delta" for del; then both arguments suggest it) and names no command (with prefix
+// matching, "a" dispatches add), then a typo of that name. Past the shape: the typo first
+// (the suggestions are for the first argument on both sides), or valid arguments only.
+// Measured rejection 0 % (300 cases).
+var validThenTypoRegion = regionOf("cobra/4", casesOf("valid then typo", treesWith(treeShapes{onlyValid: true, availableChild: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	c, child := t.anchor, t.anchor.subs[0]
+	m := hzNewModel(t, hzKnownNone)
+	valid := hegel.Map(hegel.Filter(validArgsOf(c), func(v string) bool {
+		return hzLevenshtein(v, child.name) > 2 && !strings.HasPrefix(child.name, v) && m.findNext(c, v) == nil
+	}), lit)
+	typo := hegel.Map(typosOf(child.name), lit)
+	return hzShaped(
+		before(t, hzSeq(hzOne(valid), hzOne(typo))),
+		hzWeighted(hzW(2, before(t, hzSeq(hzOne(typo), hzOne(valid)))), hzW(2, before(t, hzCounted(valid, 1, 2)))),
+	)
+}))
+
+func TestHegelExecuteInvalidArgumentsAreSuggested(t *testing.T) {
+	narrowExecute(t, validThenTypoRegion)
+}
+
+// --------------------------------------------------------------------------- cobra/5
+
+// emptyArgRegion: with prefix matching and TraverseChildren, an empty argument at the
+// anchor, a command with a single subcommand, and a tail. Past the shape: the subcommand's
+// name, or the empty argument without prefix matching. The anchor is below the root: there
+// the help command is a second match of the empty prefix, and a tail at a root with Args
+// nil is an unknown command first (cobra/3). Measured rejection 0 % (300 cases).
+var emptyArgRegion = regionOf("cobra/5", hzShaped(
+	casesOf("empty argument", treesWith(treeShapes{anchorDeep: true, traverse: true, prefix: true, singleChild: true}), emptyArgTokens),
+	hzWeighted(
+		hzW(2, casesOf("empty argument", treesWith(treeShapes{anchorDeep: true, traverse: true, prefix: true, singleChild: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+			return withTail(before(t, hzOne(hegel.Map(anchorChildren(t), exact))))
+		})),
+		hzW(2, casesOf("empty argument", treesWith(treeShapes{anchorDeep: true, traverse: true, noPrefix: true, singleChild: true}), emptyArgTokens)),
+	),
+))
+
+func TestHegelExecuteEmptyArgumentsNameNoCommand(t *testing.T) { narrowExecute(t, emptyArgRegion) }
+
+// --------------------------------------------------------------------------- cobra/6
+
+// helpWords: the help flag's spellings.
+var helpWords = hzSampled("--help", "-h")
+
+// namesUnder: the subcommand's name and (50 %, when it has subcommands whose names name
+// nothing at the anchor: one that does is a command name once swallowed) a sub-subcommand's.
+func namesUnder(t *hzTreeSpec, child *hzCmdSpec) hegel.Generator[[]hzTok] {
+	m := hzNewModel(t, hzKnownNone)
+	var further []*hzCmdSpec
+	for _, s := range child.subs {
+		if m.findNext(t.anchor, s.name) == nil {
+			further = append(further, s)
+		}
+	}
+	names := hzOne(hegel.Just(exact(child)))
+	if len(further) > 0 {
+		names = hzSeq(names, hzMaybe(50, hzOne(hegel.Map(hzSampled(further...), exact))))
+	}
+	return names
+}
+
+// traverseHelpRegion: with TraverseChildren, at an anchor that is not a root with Args nil
+// (there the swallowed positional is cobra/8 first), --help or -h, a positional, the
+// subcommand's name and (50 %, when it has subcommands) a sub-subcommand's. Past the shape:
+// the help flag after the names, or before the name with no positional between (the parent's
+// help on both sides). Measured rejection 0 % (300 cases).
+var traverseHelpRegion = regionOf("cobra/6", casesOf("help flag", treesWith(treeShapes{parent: true, traverse: true, argsSome: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	return hegel.FlatMap(anchorChildren(t), func(child *hzCmdSpec) hegel.Generator[[]hzTok] {
+		names := namesUnder(t, child)
+		flag := hzOne(hegel.Map(helpWords, lit))
+		return hzShaped(
+			before(t, hzSeq(flag, hzOne(posTokens), names)),
+			hzWeighted(hzW(2, withTail(before(t, hzSeq(names, flag)))), hzW(2, before(t, hzSeq(flag, names)))),
+		)
+	})
+}))
+
+func TestHegelExecuteHelpFlagsOnParentsShowHelp(t *testing.T) { narrowExecute(t, traverseHelpRegion) }
+
+// --------------------------------------------------------------------------- cobra/7
+
+// helpCommandRegion: the help command, with (70 %) a subcommand of the anchor as its topic,
+// at a root with a required persistent flag or a one-required group over two persistent
+// flags that the arguments leave unset. Past the shape: the flag set before the help
+// command (with a value that is a word: "--" would be cobra/2). Measured rejection 0 % (300
+// cases).
+var helpCommandRegion = regionOf("cobra/7", casesOf("help command", treesWith(treeShapes{parent: true, requiredFlag: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	set := hegel.Filter(flagTokensOf(t.root.flags[0]), func(tok hzTok) bool { return !strings.HasPrefix(tok.value, "-") })
+	return hzShaped(helpCommandTokens(t), hzSeq(hzOne(set), helpCommandTokens(t)))
+}))
+
+func TestHegelExecuteHelpCommandNeedsNoFlags(t *testing.T) { narrowExecute(t, helpCommandRegion) }
+
+// --------------------------------------------------------------------------- cobra/8
+
+// helpFlagRegion: in Find mode, --help, -h, --version or -v (Version on the root, at the
+// root: the version flag is unknown to a subcommand on both sides) before the subcommand's
+// name and (50 %, when it has subcommands) a sub-subcommand's, at the anchor. Past the
+// shape: the flag after the names, or a long flag with "=false" before them (a token with
+// "=" is skipped alone). Measured rejection 0 % (300 cases).
+var helpFlagRegion = regionOf("cobra/8", hegel.FlatMap(helpFlagWords, func(flag string) hegel.Generator[executeCase] {
+	o := versionShapes(flag)
+	o.noTraverse = true
+	return casesOf("help flag", treesWith(o), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		return hegel.FlatMap(anchorChildren(t), func(child *hzCmdSpec) hegel.Generator[[]hzTok] {
+			names := namesUnder(t, child)
+			past := withTail(before(t, hzSeq(names, tokensOf(lit(flag)))))
+			if strings.HasPrefix(flag, "--") {
+				past = hzWeighted(hzW(2, past), hzW(2, withTail(before(t, hzSeq(tokensOf(lit(flag+"=false")), names)))))
+			}
+			return hzShaped(before(t, hzSeq(tokensOf(lit(flag)), names)), past)
+		})
+	})
+}))
+
+func TestHegelExecuteHelpFlagsTakeNoValue(t *testing.T) { narrowExecute(t, helpFlagRegion) }
+
+// --------------------------------------------------------------------------- cobra/9
+
+// uniquePrefixes: the proper prefixes of the subcommands' names and aliases that match one
+// subcommand of the parent alone (case-insensitively, as the documented matcher compares),
+// as (prefix, length) pairs; a prefix matching two subcommands is unknown on both sides.
+func uniquePrefixes(t *hzTreeSpec, parent *hzCmdSpec) []string {
+	var words []string
+	for _, s := range t.children(parent) {
+		words = append(append(words, s.name), s.aliases...)
+	}
+	matches := func(p string) int {
+		n := 0
+		for _, w := range words {
+			if strings.HasPrefix(strings.ToLower(w), strings.ToLower(p)) {
+				n++
+			}
+		}
+		return n
+	}
+	var out []string
+	for _, s := range parent.subs {
+		for _, w := range append([]string{s.name}, s.aliases...) {
+			for n := 1; n < len(w); n++ {
+				if matches(w[:n]) == 1 {
+					out = append(out, w[:n])
+				}
+			}
+		}
+	}
+	return out
+}
+
+// caseVariants: the word with its first letter upper-cased, or upper-cased.
+func caseVariants(w string) hegel.Generator[string] {
+	return hzWeighted(hzW(2, hegel.Just(strings.ToUpper(w[:1])+w[1:])), hzW(1, hegel.Just(strings.ToUpper(w))))
+}
+
+// casedPrefixRegion: with prefix matching and case-insensitive names, a case variant of a
+// unique proper prefix of a subcommand's name or alias at the anchor, and a tail. Past the
+// shape: the prefix as it is, the whole name in a case variant, or the case variant without
+// case-insensitive names (unknown on both sides). Measured rejection 0 % (300 cases).
+func casedPrefixTokens(cased bool) func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	return func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		prefixes := uniquePrefixes(t, t.anchor)
+		if len(prefixes) == 0 {
+			return before(t, tokensOf(exact(t.anchor.subs[0])))
+		}
+		words := hzSampled(prefixes...)
+		if cased {
+			words = hegel.FlatMap(words, caseVariants)
+		}
+		return withTail(before(t, hzOne(hegel.Map(words, lit))))
+	}
+}
+
+var casedPrefixRegion = regionOf("cobra/9", hzShaped(
+	casesOf("case variant", treesWith(treeShapes{parent: true, prefix: true, caseInsensitive: true}), casedPrefixTokens(true)),
+	hzWeighted(
+		hzW(2, casesOf("case variant", treesWith(treeShapes{parent: true, prefix: true, caseInsensitive: true}), casedPrefixTokens(false))),
+		hzW(2, casesOf("case variant", treesWith(treeShapes{parent: true, prefix: true, caseInsensitive: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+			return withTail(before(t, hzOne(hegel.Map(hegel.FlatMap(anchorChildren(t), func(c *hzCmdSpec) hegel.Generator[string] { return caseVariants(c.name) }), lit))))
+		})),
+		hzW(2, casesOf("case variant", treesWith(treeShapes{parent: true, prefix: true, caseSensitive: true, noTraverse: true}), casedPrefixTokens(true))),
+	),
+))
+
+func TestHegelExecutePrefixesAreCaseInsensitive(t *testing.T) { narrowExecute(t, casedPrefixRegion) }
+
+// --------------------------------------------------------------------------- cobra/10
+
+// otherTypo: a typo of the name other than w (the truncation, or the first swap).
+func otherTypo(name, w string) string {
+	if t := name[:len(name)-1]; t != w {
+		return t
+	}
+	return swapped(name, 0)
+}
+
+// duplicateSuggestionRegion: without prefix matching (which would dispatch a truncated
+// name), the SuggestFor word of the anchor's first subcommand, a typo of its name the tree
+// carries, at an anchor that suggests. Past the shape: another typo of the name (suggested
+// once, by distance). Measured rejection 0 % (300 cases).
+var duplicateSuggestionRegion = regionOf("cobra/10", casesOf("suggestion", treesWith(treeShapes{anchorRoot: true, argsNil: true, suggestTypo: true, noPrefix: true, noTraverse: true}), func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	child := t.anchor.subs[0]
+	w := child.suggestFor[len(child.suggestFor)-1]
+	return hzShaped(
+		before(t, tokensOf(lit(w))),
+		before(t, hzOne(hegel.Map(typosOf(child.name), func(x string) hzTok {
+			if x == w {
+				x = otherTypo(child.name, w)
+			}
+			return lit(x)
+		}))),
+	)
+}))
+
+func TestHegelExecuteSuggestionsAreUnique(t *testing.T) { narrowExecute(t, duplicateSuggestionRegion) }
diff --git a/hegel/hegel_zoo_idioms_test.go b/hegel/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..a6e291e
--- /dev/null
+++ b/hegel/hegel_zoo_idioms_test.go
@@ -0,0 +1,159 @@
+package hegel
+
+// The generator idioms the properties share, copied from the go/excelize and go/graphql-go
+// harness (hegel/hegel_zoo_idioms_test.go there; go/bubbles' internal/zootest/gen.go before
+// it) with the hz prefix of this package: hegel-go has no weighted choice, biased coin, tuple
+// or counted-list combinator. Every generator built from them is a package-level value; the
+// simplest alternative comes first so that shrinking lands on it, except the shape of a
+// recorded bug a wide property must reach every run, which goes first at a solid weight and
+// is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a weighted choice drawn
+// alone comes out exact (the engine enumerates a small die), but inside a case with other
+// draws the engine favours the first alternative (excelize measured the first of a 2:18:10
+// choice drawn 40% of the time when another draw precedes or follows it, 7% alone), so the
+// rates are what the collector (ZOO_COLLECT=1) measures.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..2668da7
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,358 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml cobra/1 ...), each asserting the documented
+// behaviour; they fail while the bug exists and are listed as expected failures in target.toml.
+
+import (
+	"bytes"
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/spf13/cobra"
+)
+
+// hzPinTree: root with a persistent bool -a/--all and a persistent string -f/--file, the
+// subcommands sub (with a child), ls (SuggestFor ps) and list, every Run recording itself.
+type hzPinTree struct {
+	root, sub, child, ls, list *cobra.Command
+	log                        []string
+	out                        bytes.Buffer
+}
+
+func hzNewPinTree() *hzPinTree {
+	p := &hzPinTree{}
+	mk := func(name string) *cobra.Command {
+		return &cobra.Command{Use: name, Run: func(c *cobra.Command, args []string) {
+			f, _ := c.Flags().GetString("file")
+			p.log = append(p.log, fmt.Sprintf("ran %s args=%q file=%q", c.CommandPath(), args, f))
+		}}
+	}
+	p.root, p.sub, p.child, p.ls, p.list = mk("root"), mk("sub"), mk("child"), mk("ls"), mk("list")
+	p.ls.SuggestFor = []string{"ps"}
+	p.root.PersistentFlags().BoolP("all", "a", false, "all")
+	p.root.PersistentFlags().StringP("file", "f", "", "file")
+	p.sub.AddCommand(p.child)
+	p.root.AddCommand(p.sub, p.ls, p.list)
+	p.root.SilenceErrors, p.root.SilenceUsage = true, true
+	p.root.SetOut(&p.out)
+	p.root.SetErr(&p.out)
+	p.root.CompletionOptions.DisableDefaultCmd = true
+	p.root.SetHelpFunc(func(c *cobra.Command, args []string) { p.log = append(p.log, "help:"+c.CommandPath()) })
+	return p
+}
+
+// run executes the tree on args (panics recovered as errors) and returns the recorded log.
+func (p *hzPinTree) run(args ...string) (log string, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("panic: %v", r)
+		}
+	}()
+	p.root.SetArgs(args)
+	_, err = p.root.ExecuteC()
+	return strings.Join(p.log, "; "), err
+}
+
+func hzPinGlobals(t *testing.T) {
+	prefix, ci := cobra.EnablePrefixMatching, cobra.EnableCaseInsensitive
+	t.Cleanup(func() { cobra.EnablePrefixMatching, cobra.EnableCaseInsensitive = prefix, ci })
+}
+
+// TestHegelPinCombinedShortValue: cobra/1. In a combined short token the last letter may take
+// the next argument as its value (pflag's grammar): `root -af x sub` sets --file to x and runs
+// sub. The dispatcher (stripFlags/Traverse) takes x for a command name instead.
+func TestHegelPinCombinedShortValue(t *testing.T) {
+	p := hzNewPinTree()
+	log, err := p.run("-af", "x", "sub")
+	if err != nil || log != `ran root sub args=[] file="x"` {
+		t.Errorf("root -af x sub: log %q, err %v; want sub run with file=x", log, err)
+	}
+	p = hzNewPinTree()
+	p.root.TraverseChildren = true
+	log, err = p.run("-af", "x", "sub")
+	if err != nil || log != `ran root sub args=[] file="x"` {
+		t.Errorf("root -af x sub (TraverseChildren): log %q, err %v; want sub run with file=x", log, err)
+	}
+}
+
+// TestHegelPinTraverseDashDash: cobra/2. "--" ends the flags and the command names alike:
+// `root -- x sub` runs root with the arguments [x sub]. With TraverseChildren, Traverse takes
+// "--" for a flag with the value x and dispatches sub, which runs with no arguments.
+func TestHegelPinTraverseDashDash(t *testing.T) {
+	p := hzNewPinTree()
+	p.root.TraverseChildren = true
+	log, err := p.run("--", "x", "sub")
+	if err != nil || log != `ran root args=["x" "sub"] file=""` {
+		t.Errorf("root -- x sub (TraverseChildren): log %q, err %v; want root run with [x sub]", log, err)
+	}
+}
+
+// TestHegelPinTraverseUnknownCommand: cobra/3. A root with subcommands and no Args validator
+// rejects a positional argument as an unknown command (args.go, legacyArgs); with
+// TraverseChildren the check is skipped and the root runs with the argument.
+func TestHegelPinTraverseUnknownCommand(t *testing.T) {
+	p := hzNewPinTree()
+	p.root.TraverseChildren = true
+	log, err := p.run("extra")
+	if err == nil || !strings.HasPrefix(err.Error(), `unknown command "extra" for "root"`) {
+		t.Errorf("root extra (TraverseChildren): log %q, err %v; want the unknown command error", log, err)
+	}
+}
+
+// TestHegelPinValidArgsSuggestion: cobra/4. OnlyValidArgs suggests commands for the invalid
+// argument; it computes the suggestions for the first argument instead.
+func TestHegelPinValidArgsSuggestion(t *testing.T) {
+	p := hzNewPinTree()
+	p.root.ValidArgs = []string{"alpha", "beta"}
+	p.root.Args = cobra.OnlyValidArgs
+	_, err := p.run("alpha", "lis")
+	want := "invalid argument \"lis\" for \"root\"\n\nDid you mean this?\n\tlist\n"
+	if err == nil || err.Error() != want {
+		t.Errorf("root alpha lis: err %q; want %q", err, want)
+	}
+}
+
+// TestHegelPinEmptyArgPrefix: cobra/5. An empty argument names no command; with
+// EnablePrefixMatching and TraverseChildren it is a prefix of every name and dispatches a
+// command's only subcommand.
+func TestHegelPinEmptyArgPrefix(t *testing.T) {
+	hzPinGlobals(t)
+	cobra.EnablePrefixMatching = true
+	p := hzNewPinTree()
+	p.root.TraverseChildren = true
+	log, err := p.run("sub", "")
+	if err != nil || log != `ran root sub args=[""] file=""` {
+		t.Errorf("root sub \"\" (prefix matching, TraverseChildren): log %q, err %v; want sub run with [\"\"]", log, err)
+	}
+}
+
+// TestHegelPinTraverseHelpFlag: cobra/6. With TraverseChildren a help flag among a parent's
+// flags, followed by a positional argument and a command name, is reported as the error
+// "pflag: help requested" (pflag's sentinel for an undefined help flag) instead of showing help.
+func TestHegelPinTraverseHelpFlag(t *testing.T) {
+	p := hzNewPinTree()
+	p.root.TraverseChildren = true
+	log, err := p.run("--help", "x", "sub")
+	if err != nil || !strings.Contains(log, "help:") {
+		t.Errorf("root --help x sub (TraverseChildren): log %q, err %v; want help shown without error", log, err)
+	}
+	// the version flag is defined at the same point: with Version set it is unknown to a
+	// parent's parse too, "unknown flag: --version" instead of the version
+	v := hzNewPinTree()
+	v.root.TraverseChildren = true
+	v.root.Version = "1.2.3"
+	if _, err := v.run("--version", "x", "sub"); err != nil || !strings.Contains(v.out.String(), "version 1.2.3") {
+		t.Errorf("root --version x sub (TraverseChildren, Version set): out %q, err %v; want the version printed without error", v.out.String(), err)
+	}
+}
+
+// TestHegelPinHelpCommandRequiredFlag: cobra/7. The help command shows help; it is refused
+// when a required persistent flag of the root is not set (or a one-required flag group is not
+// satisfied), although help is what the user asks for.
+func TestHegelPinHelpCommandRequiredFlag(t *testing.T) {
+	p := hzNewPinTree()
+	_ = p.root.MarkPersistentFlagRequired("file")
+	log, err := p.run("help", "sub")
+	if err != nil || log != "help:root sub" {
+		t.Errorf("root help sub with --file required: log %q, err %v; want the help of sub", log, err)
+	}
+}
+
+// TestHegelPinHelpFlagBeforeCommand: cobra/8. The help flag is a bool flag: `root --help sub
+// child` asks for help (of sub child, as `root --all sub child` runs it). The dispatcher does
+// not know the help flag yet, takes sub for its value and fails on child as an unknown command.
+func TestHegelPinHelpFlagBeforeCommand(t *testing.T) {
+	p := hzNewPinTree()
+	log, err := p.run("--help", "sub", "child")
+	if err != nil || log != "help:root sub child" {
+		t.Errorf("root --help sub child: log %q, err %v; want the help of sub child", log, err)
+	}
+}
+
+// TestHegelPinPrefixCaseInsensitive: cobra/9. With EnableCaseInsensitive and
+// EnablePrefixMatching, `root Su` should reach sub as `root SUB` and `root su` do; prefix
+// matching compares case-sensitively.
+func TestHegelPinPrefixCaseInsensitive(t *testing.T) {
+	hzPinGlobals(t)
+	cobra.EnablePrefixMatching, cobra.EnableCaseInsensitive = true, true
+	p := hzNewPinTree()
+	log, err := p.run("Su")
+	if err != nil || log != `ran root sub args=[] file=""` {
+		t.Errorf("root Su (prefix matching, case-insensitive): log %q, err %v; want sub run", log, err)
+	}
+}
+
+// TestHegelPinDuplicateSuggestion: cobra/10. A command whose name is within the distance and
+// whose SuggestFor matches is suggested twice.
+func TestHegelPinDuplicateSuggestion(t *testing.T) {
+	p := hzNewPinTree()
+	_, err := p.run("ps")
+	want := "unknown command \"ps\" for \"root\"\n\nDid you mean this?\n\tls\n"
+	if err == nil || err.Error() != want {
+		t.Errorf("root ps: err %q; want %q", err, want)
+	}
+}
+
+// complete runs a __complete (or __completeNoDesc) request on the tree and returns the
+// completion lines and the directive it printed.
+func (p *hzPinTree) complete(request string, args ...string) (lines []string, directive int, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("panic: %v", r)
+		}
+	}()
+	p.out.Reset()
+	p.root.SetArgs(append([]string{request}, args...))
+	if _, err = p.root.ExecuteC(); err != nil {
+		return nil, 0, err
+	}
+	// the completions, the ":<directive>" line, then a note on the directive on the error writer
+	for i, l := range strings.Split(p.out.String(), "\n") {
+		if strings.HasPrefix(l, ":") {
+			directive, err = strconv.Atoi(l[1:])
+			return lines, directive, err
+		}
+		if i > 0 {
+			lines = append(lines, "")
+		}
+		lines = append(lines, l)
+	}
+	return nil, 0, fmt.Errorf("no directive line in %q", p.out.String())
+}
+
+// cobra/11: the completion functions are called "after having parsed all flags and
+// arguments provided in the command-line ... as it would have done when calling the RunE
+// function" (the completions guide), but getCompletions parses them twice, so a count flag
+// is doubled and a slice flag holds every value twice.
+func TestHegelPinCompletionFlagsParsedOnce(t *testing.T) {
+	p := hzNewPinTree()
+	var tags []string
+	p.root.Flags().StringSlice("tag", nil, "tag")
+	p.root.ValidArgsFunction = func(c *cobra.Command, args []string, toComplete string) ([]string, cobra.ShellCompDirective) {
+		tags, _ = c.Flags().GetStringSlice("tag")
+		return nil, cobra.ShellCompDirectiveNoFileComp
+	}
+	if _, _, err := p.complete("__complete", "--tag", "a", "--tag", "b", ""); err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"a", "b"}; fmt.Sprint(tags) != fmt.Sprint(want) {
+		t.Errorf("root __complete --tag a --tag b \"\": ValidArgsFunction saw --tag %q; want %q", tags, want)
+	}
+}
+
+// cobra/12: completing the value of the last letter of a combined short token (`-af <TAB>`)
+// parses only that letter, so the flag's completion function does not see the other flags
+// of the token set.
+func TestHegelPinCompletionCombinedShort(t *testing.T) {
+	p := hzNewPinTree()
+	called, all := false, false
+	if err := p.root.RegisterFlagCompletionFunc("file", func(c *cobra.Command, args []string, toComplete string) ([]string, cobra.ShellCompDirective) {
+		called = true
+		all, _ = c.Flags().GetBool("all")
+		return []string{"x"}, cobra.ShellCompDirectiveNoFileComp
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := p.complete("__complete", "-af", ""); err != nil {
+		t.Fatal(err)
+	}
+	if !called {
+		t.Fatalf("root __complete -af \"\": the completion function of --file was not called")
+	}
+	if !all {
+		t.Errorf("root __complete -af \"\": the completion function of --file saw --all=false; want true (-a is set in the same token)")
+	}
+}
+
+// cobra/13: EnableCaseInsensitive "allows case-insensitive commands names"; `root SU<TAB>`
+// completes nothing although `root SUB` runs sub.
+func TestHegelPinCompletionCaseInsensitive(t *testing.T) {
+	hzPinGlobals(t)
+	cobra.EnableCaseInsensitive = true
+	if log, err := hzNewPinTree().run("SUB"); err != nil || !strings.Contains(log, "ran root sub") {
+		t.Fatalf("root SUB: log %q err %v", log, err)
+	}
+	lines, _, err := hzNewPinTree().complete("__complete", "SU")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []string{"sub"}; fmt.Sprint(lines) != fmt.Sprint(want) {
+		t.Errorf("root __complete SU: %q; want %q", lines, want)
+	}
+}
+
+// cobra/14: with TraverseChildren, `root set -k show` runs show (-k is a persistent count
+// flag of set), but completing `root set -k show <TAB>` stops at set: Traverse looks -k up
+// in set's Flags() before set's persistent flags are merged in, takes it for a flag with a
+// value and swallows "show".
+func TestHegelPinCompletionTraversePersistentFlag(t *testing.T) {
+	var ran, completed string
+	build := func() *hzPinTree {
+		p := hzNewPinTree()
+		p.root.TraverseChildren = true
+		set := &cobra.Command{Use: "set"}
+		set.PersistentFlags().CountP("out", "k", "out")
+		show := &cobra.Command{Use: "show", Run: func(c *cobra.Command, args []string) { ran = c.CommandPath() }}
+		show.ValidArgsFunction = func(c *cobra.Command, args []string, toComplete string) ([]string, cobra.ShellCompDirective) {
+			completed = c.CommandPath()
+			return []string{"x"}, cobra.ShellCompDirectiveNoFileComp
+		}
+		set.AddCommand(show)
+		p.root.AddCommand(set)
+		return p
+	}
+	if _, err := build().run("set", "-k", "show"); err != nil || ran != "root set show" {
+		t.Fatalf("root set -k show: ran %q err %v", ran, err)
+	}
+	lines, _, err := build().complete("__complete", "set", "-k", "show", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if completed != "root set show" || fmt.Sprint(lines) != "[x]" {
+		t.Errorf("root __complete set -k show \"\": ValidArgsFunction of %q answered, lines %q; want root set show, [x]", completed, lines)
+	}
+}
+
+// cobra/15: a __completeNoDesc request must print no descriptions; with EnablePrefixMatching
+// and TraverseChildren an empty argument is prefix-matched against every subcommand,
+// including the hidden __complete command, whose CalledAs is reset to "__complete" on the
+// way, and the descriptions are printed.
+func TestHegelPinCompletionNoDescPrefix(t *testing.T) {
+	hzPinGlobals(t)
+	cobra.EnablePrefixMatching = true
+	p := hzNewPinTree()
+	p.root.TraverseChildren = true
+	lines, _, err := p.complete("__completeNoDesc", "", "-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(lines) == 0 {
+		t.Fatalf("root __completeNoDesc \"\" -: no completions")
+	}
+	for _, l := range lines {
+		if strings.Contains(l, "\t") {
+			t.Errorf("root __completeNoDesc \"\" -: completion %q carries a description", l)
+		}
+	}
+	// and on a root without subcommands the __complete command is the only prefix match of the
+	// empty argument, so the request is dispatched to it and the root's completions are lost
+	root := &cobra.Command{Use: "root", TraverseChildren: true, Run: func(*cobra.Command, []string) {}}
+	called := false
+	root.ValidArgsFunction = func(c *cobra.Command, args []string, toComplete string) ([]string, cobra.ShellCompDirective) {
+		called = true
+		return []string{"x"}, cobra.ShellCompDirectiveNoFileComp
+	}
+	var out bytes.Buffer
+	root.SetOut(&out)
+	root.SetErr(&out)
+	root.CompletionOptions.DisableDefaultCmd = true
+	root.SetArgs([]string{"__complete", "", ""})
+	if _, err := root.ExecuteC(); err != nil {
+		t.Fatal(err)
+	}
+	if !called {
+		t.Errorf("root __complete \"\" \"\" on a root without subcommands: the root's ValidArgsFunction was not called; output %q", out.String())
+	}
+}
diff --git a/hegel/hegel_zoo_props_test.go b/hegel/hegel_zoo_props_test.go
new file mode 100644
index 0000000..db3f4e5
--- /dev/null
+++ b/hegel/hegel_zoo_props_test.go
@@ -0,0 +1,352 @@
+package hegel
+
+// TestHegelExecute: a generated cobra.Command tree executed on a generated argument list,
+// against the model of the documented dispatch (Find, or Traverse with TraverseChildren), of
+// pflag's grammar for the flags, of the Args validators, required flags and flag groups, of
+// the help and version flags and the help command, and of the hooks in their documented order
+// (hzModel, hegel_zoo_exec_test.go, with every switch off). The cases are records drawn from
+// package-level generators: a tree (hegel_zoo_trees_test.go) and an argument list
+// (hegel_zoo_argv_test.go), the plain walk or one of the corner shapes of the old shape generator
+// that reach the recorded bugs cobra/1 to cobra/10; the shape of a case is named by the
+// classifier executeShape (the model run with several sets of switches) before the library is
+// called, and under HEGEL_NO_KNOWN=1 the shapes are not drawn.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/spf13/cobra"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the cases
+
+// executeCase: a tree and an argument list, executed by the library and the model; drawn
+// names the generator the case came from (the collector counts "drawn <name>").
+type executeCase struct {
+	tree  *hzTreeSpec
+	argv  []string
+	drawn string
+}
+
+func (c executeCase) GoString() string {
+	return fmt.Sprintf("argv %q\n%s", c.argv, c.tree.describe())
+}
+
+// casesOf: the cases of the named generator over a tree generator and a token-list
+// generator per tree.
+func casesOf(drawn string, trees hegel.Generator[*hzTreeSpec], tokens func(*hzTreeSpec) hegel.Generator[[]hzTok]) hegel.Generator[executeCase] {
+	return hegel.FlatMap(trees, func(t *hzTreeSpec) hegel.Generator[executeCase] {
+		return hegel.Map(tokens(t), func(toks []hzTok) executeCase { return executeCase{tree: t, argv: renderTokens(toks), drawn: drawn} })
+	})
+}
+
+// traversedAt: the cases of the shape over trees with TraverseChildren forced on pct percent
+// of the time (the old shapes set it so) and drawn as usual otherwise.
+func traversedAt(drawn string, pct int, o treeShapes, tokens func(*hzTreeSpec) hegel.Generator[[]hzTok]) hegel.Generator[executeCase] {
+	on := o
+	on.traverse = true
+	return hzWeighted(hzW(100-pct, casesOf(drawn, treesWith(o), tokens)), hzW(pct, casesOf(drawn, treesWith(on), tokens)))
+}
+
+// --------------------------------------------------------------------------- the corner shapes
+
+// The corner shapes of the old shape generator, each built at the tree's anchor (a command with
+// subcommands) and one of its subcommands, with the contents it drew; the recorded bug each
+// reaches is named by the classifier (the shape's own, or another one first in bug order).
+
+// tails: nothing, or (50 %) a positional after the shape.
+var tails = hzMaybe(50, hzOne(posTokens))
+
+// anchorChildren: a subcommand of the tree's anchor.
+func anchorChildren(t *hzTreeSpec) hegel.Generator[*hzCmdSpec] { return hzSampled(t.anchor.subs...) }
+
+// combinedShortTokens: a combined short token of a bool flag's letter and a value flag's letter
+// the anchor sees, then (30 %) the subcommand's name (the flag needs an argument: cobra/1), or
+// the flag's value (a word: an empty or flag-like one is skipped on both sides), the
+// subcommand's name and a tail (the value taken for a command name).
+func combinedShortTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	c := t.anchor
+	var bools, vals []*hzFlagSpec
+	for _, f := range shortsOf(c.visible()) {
+		if f.noOptDef() {
+			bools = append(bools, f)
+		} else {
+			vals = append(vals, f)
+		}
+	}
+	return hegel.Composite(func(tc hegel.TestCase) []hzTok {
+		b, v := hegel.Draw(tc, hzSampled(bools...)), hegel.Draw(tc, hzSampled(vals...))
+		child := hegel.Draw(tc, anchorChildren(t))
+		tok := hzTok{kind: tokCombined, letters: []*hzFlagSpec{b, v}, form: combBare}
+		if hegel.Draw(tc, hzCoin(30)) {
+			return append(pathTokens(c), tok, exact(child))
+		}
+		tok.form, tok.value = combSep, hegel.Draw(tc, wordValuesFor(v))
+		return append(append(pathTokens(c), tok, exact(child)), hegel.Draw(tc, tails)...)
+	})
+}
+
+// dashDashTokens: "--", a positional, the subcommand's name and a tail (cobra/2 with
+// TraverseChildren, which the tree has 70 % of the time).
+func dashDashTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	return hegel.Composite(func(tc hegel.TestCase) []hzTok {
+		child := hegel.Draw(tc, anchorChildren(t))
+		return append(append(pathTokens(t.anchor), lit("--"), hegel.Draw(tc, posTokens), exact(child)), hegel.Draw(tc, tails)...)
+	})
+}
+
+// validThenTypoTokens: at the anchor with OnlyValidArgs, a valid argument then a typo of the
+// subcommand's name (cobra/4).
+func validThenTypoTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	c := t.anchor
+	return hegel.Composite(func(tc hegel.TestCase) []hzTok {
+		child := hegel.Draw(tc, anchorChildren(t))
+		return append(pathTokens(c), lit(hegel.Draw(tc, validArgsOf(c))), lit(hegel.Draw(tc, typosOf(child.name))))
+	})
+}
+
+// emptyArgTokens: an empty argument at the anchor, a command with a single subcommand, and a
+// tail (cobra/5 with prefix matching and TraverseChildren).
+func emptyArgTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	return hegel.Map(tails, func(tail []hzTok) []hzTok { return append(append(pathTokens(t.anchor), lit("")), tail...) })
+}
+
+// helpFlagWords: the help and version flags of the help-flag shape (the version ones with
+// Version on the root, at the root: a parent's version flag is only defined there).
+var helpFlagWords = hzSampled("--help", "-h", "--help", "-h", "--version", "-v")
+
+// versionShapes: the tree options of the help-flag shape for the flag: Version on the root
+// and the root as the anchor for the version flags.
+func versionShapes(flag string) treeShapes {
+	v := strings.Contains(flag, "v")
+	return treeShapes{parent: true, version: v, anchorRoot: v}
+}
+
+// helpFlagTokens: the help or version flag, a positional (50 %), the subcommand's name and
+// (50 %, when it has subcommands) a sub-subcommand's: cobra/8 in Find mode, cobra/6 or 8 with
+// TraverseChildren (60 %).
+func helpFlagTokens(flag string) func(*hzTreeSpec) hegel.Generator[[]hzTok] {
+	return func(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+		return hegel.Composite(func(tc hegel.TestCase) []hzTok {
+			child := hegel.Draw(tc, anchorChildren(t))
+			toks := append(pathTokens(t.anchor), lit(flag))
+			toks = append(toks, hegel.Draw(tc, hzMaybe(50, hzOne(posTokens)))...)
+			toks = append(toks, exact(child))
+			if len(child.subs) > 0 {
+				toks = append(toks, hegel.Draw(tc, hzMaybe(50, hzOne(hegel.Map(hzSampled(child.subs...), exact))))...)
+			}
+			return toks
+		})
+	}
+}
+
+// helpCommandTokens: the help command, with (70 %) a subcommand of the anchor as its topic,
+// under whatever required flags and groups the root has (cobra/7).
+func helpCommandTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	return hegel.Map(hzMaybe(70, hegel.Map(anchorChildren(t), pathTokens)), func(topic []hzTok) []hzTok {
+		return append([]hzTok{lit("help")}, topic...)
+	})
+}
+
+// caseVariantTokens: the subcommand's name (or an alias, 30 %), or (70 %) a proper prefix of
+// it, with its first letter upper-cased, and a tail (cobra/9 with prefix matching and
+// case-insensitive names).
+func caseVariantTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	return hegel.Composite(func(tc hegel.TestCase) []hzTok {
+		child := hegel.Draw(tc, anchorChildren(t))
+		name := hegel.Draw(tc, namesOf(child, 30))
+		if len(name) > 1 && hegel.Draw(tc, hzCoin(70)) {
+			name = name[:hegel.Draw(tc, hzInts(1, len(name)-1))]
+		}
+		return append(append(pathTokens(t.anchor), lit(strings.ToUpper(name[:1])+name[1:])), hegel.Draw(tc, tails)...)
+	})
+}
+
+// suggestForTokens: the SuggestFor word of the anchor's first subcommand, a typo of its name
+// the tree carries (cobra/10).
+func suggestForTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	child := t.anchor.subs[0]
+	return hegel.Just(append(pathTokens(t.anchor), lit(child.suggestFor[len(child.suggestFor)-1])))
+}
+
+// typoTokens: a subcommand's SuggestFor word (60 % when it has one) or a typo of its name,
+// for the unknown-command suggestions.
+func typoTokens(t *hzTreeSpec) hegel.Generator[[]hzTok] {
+	return hegel.FlatMap(anchorChildren(t), func(child *hzCmdSpec) hegel.Generator[[]hzTok] {
+		words := typosOf(child.name)
+		if len(child.suggestFor) > 0 {
+			words = hzWeighted(hzW(40, typosOf(child.name)), hzW(60, hegel.Just(child.suggestFor[0])))
+		}
+		return hegel.Map(words, func(w string) []hzTok { return append(pathTokens(t.anchor), lit(w)) })
+	})
+}
+
+// The cases of the corner shapes, each a fortieth of the cases by default (the eight shapes
+// share the old 35 %) and never drawn under HEGEL_NO_KNOWN=1.
+var (
+	combinedShortCases = casesOf("combined short", treesWith(treeShapes{parent: true, shortPair: true}), combinedShortTokens)
+	dashDashCases      = traversedAt("dash dash", 70, treeShapes{parent: true}, dashDashTokens)
+	validThenTypoCases = casesOf("valid then typo", treesWith(treeShapes{parent: true, onlyValid: true}), validThenTypoTokens)
+	emptyArgCases      = casesOf("empty argument", treesWith(treeShapes{parent: true, traverse: true, prefix: true, singleChild: true}), emptyArgTokens)
+	helpFlagCases      = hegel.FlatMap(helpFlagWords, func(flag string) hegel.Generator[executeCase] {
+		return traversedAt("help flag", 60, versionShapes(flag), helpFlagTokens(flag))
+	})
+	helpCommandCases = casesOf("help command", treesWith(treeShapes{parent: true}), helpCommandTokens)
+	caseVariantCases = casesOf("case variant", treesWith(treeShapes{parent: true, prefix: true, caseInsensitive: true}), caseVariantTokens)
+	suggestionCases  = hzWeighted(
+		hzW(40, casesOf("suggestion", treesWith(treeShapes{parent: true, suggestTypo: true}), suggestForTokens)),
+		hzW(60, casesOf("suggestion", treesWith(treeShapes{parent: true}), typoTokens)),
+	)
+)
+
+// plainCases: the plain walk over the plain trees. Under HEGEL_NO_KNOWN=1 the walk's cases
+// that have the shape of a recorded bug (the classifier names them: a combined short token
+// or a help flag before a command name, an argument naming no command at a root with
+// TraverseChildren and Args nil, and the rarer ones) are filtered out: 2.8 % of the walk's
+// cases at 3000 (counted "filtered shaped"; by default the walk's shapes are tallied "plain
+// cobra/N": nearly all cobra/3).
+var plainCases = hzOnly(hzNoKnown, "shaped", casesOf("plain", trees, walkTokens), func(c executeCase) bool { return executeShape(c) == "" })
+
+// executeCases: the cases of the wide property: the plain walk (65 %) or one of the corner
+// shapes (35 % together, as the old generator drew them).
+var executeCases = hzWeighted(
+	hzW(300, plainCases),
+	hzW(hzUnless(hzNoKnown, 35), combinedShortCases),
+	hzW(hzUnless(hzNoKnown, 35), dashDashCases),
+	hzW(hzUnless(hzNoKnown, 35), validThenTypoCases),
+	hzW(hzUnless(hzNoKnown, 35), emptyArgCases),
+	hzW(hzUnless(hzNoKnown, 35), helpFlagCases),
+	hzW(hzUnless(hzNoKnown, 35), helpCommandCases),
+	hzW(hzUnless(hzNoKnown, 35), caseVariantCases),
+	hzW(hzUnless(hzNoKnown, 35), suggestionCases),
+)
+
+// --------------------------------------------------------------------------- the classifier
+
+// hzExecuteBugs: the switches of the dispatcher's bugs, cobra/1 to cobra/10; the five after
+// them act in completion requests only (hegel_zoo_complete_test.go).
+const hzExecuteBugs = 10
+
+// executeShape names the recorded bug the case reaches, from the case alone, before the
+// library is called: the model is the oracle, and the old model with every switch on agreed
+// with the library on every case the old generator drew, so the case departs from the
+// documented behaviour where model(all) differs from model(none). The name is the first bug
+// N in order 1..10 whose switch alone reproduces the departure (model(only N) differs from
+// model(none): sufficiency), else the first whose switch is necessary to it (model(all but N)
+// differs from model(all): necessity, counted "shape via necessity"). The order matters where
+// several switches act at once: a combined short token before a command name under
+// TraverseChildren at a root with Args nil is cobra/1 (its switch alone changes the result)
+// before cobra/3; an empty argument there with a tail is cobra/3 before cobra/5; a help flag
+// before a positional and a command name under TraverseChildren is cobra/8 at a root with
+// Args nil (the swallowed positional alone changes the legacy check's verdict) and cobra/6
+// elsewhere, where no switch alone departs (the parent's help wins either way) and the
+// error "pflag: help requested" needs the switch of 6. A departure neither rule names is a
+// hole of the classifier, named "cobra/?" (counted; none in three thousand cases). In a hole
+// the switches of the completion bugs are tried too and counted when they alone or
+// necessarily change an Execute result ("sufficient cobra/N", "necessary cobra/N"); a probe
+// over three thousand cases found none that does.
+func executeShape(c executeCase) string {
+	run := func(k known) string { return hzNewModel(c.tree, k).run(c.argv).String() }
+	all, none := run(hzKnownAll), run(hzKnownNone)
+	if all == none {
+		return ""
+	}
+	for i := 0; i < hzExecuteBugs; i++ {
+		if run(hzKnownOnly(i)) != none {
+			hzTally("shape via sufficiency")
+			return hzKnownID(i)
+		}
+	}
+	for i := 0; i < hzExecuteBugs; i++ {
+		if run(hzKnownAllBut(i)) != all {
+			hzTally("shape via necessity")
+			return hzKnownID(i)
+		}
+	}
+	for i := hzExecuteBugs; i < hzKnownCount; i++ {
+		if run(hzKnownOnly(i)) != none {
+			hzTally("sufficient " + hzKnownID(i))
+		}
+		if run(hzKnownAllBut(i)) != all {
+			hzTally("necessary " + hzKnownID(i))
+		}
+	}
+	hzTally("shape hole")
+	return "cobra/?"
+}
+
+// --------------------------------------------------------------------------- the judge
+
+// hzGlobals restores cobra's package options after the test; the judge sets them per case
+// from the tree.
+func hzGlobals(t *testing.T) {
+	p, c, h := cobra.EnablePrefixMatching, cobra.EnableCaseInsensitive, cobra.EnableTraverseRunHooks
+	t.Cleanup(func() {
+		cobra.EnablePrefixMatching, cobra.EnableCaseInsensitive, cobra.EnableTraverseRunHooks = p, c, h
+	})
+}
+
+// judgeExecute judges one case: the shape named, the library's ExecuteC on the built tree
+// against the model's documented result (the command, the error, the hook log, the output
+// and the flag state).
+func judgeExecute(j *hzCaseJudge, c executeCase) {
+	j.col.count("drawn " + c.drawn)
+	shape := executeShape(c)
+	if c.drawn == "plain" && shape != "" {
+		hzTally("plain " + shape) // the plain walk's natural rate of the shape
+	}
+	j.Shape(shape)
+	want := hzNewModel(c.tree, hzKnownNone).run(c.argv)
+	cobra.EnablePrefixMatching, cobra.EnableCaseInsensitive, cobra.EnableTraverseRunHooks = c.tree.prefix, c.tree.caseInsensitive, c.tree.traverseHooks
+	var got hzResult
+	if r := hzCatch(func() {
+		real := hzBuild(c.tree)
+		real.root.SetArgs(c.argv)
+		cmd, err := real.root.ExecuteC()
+		got = hzRealResult(real, cmd, err)
+	}); r != nil {
+		j.Fail("panic", "%#v\npanic: %v", c, r)
+		return
+	}
+	if got.String() != want.String() {
+		class := "result"
+		switch {
+		case j.shape == "cobra/?":
+			class = "hole"
+		case got.err != "" || want.err != "":
+			class = "error"
+		}
+		j.Fail(class, "%#v\n got %s\nwant %s", c, got, want)
+		return
+	}
+	switch {
+	case want.err != "":
+		j.col.count("error " + hzErrClass(want.err))
+	case len(want.log) > 0 && strings.HasPrefix(want.log[len(want.log)-1], "help:"):
+		j.col.count("help")
+	default:
+		j.col.count("ok depth " + fmt.Sprint(strings.Count(want.cmd, " ")))
+	}
+	if c.tree.traverse {
+		j.col.count("traverse")
+	}
+}
+
+// TestHegelExecute: ExecuteC on a generated tree and argument list must give the documented
+// result. The cases carry the shapes of cobra/1 to cobra/10 (the corner shapes at 35 % of the
+// cases, the plain walk's own at its natural rate), every one named by executeShape before
+// the library is called; under HEGEL_NO_KNOWN=1 none is drawn. The narrow properties of
+// hegel_zoo_execute_shapes_test.go share judgeExecute.
+func TestHegelExecute(t *testing.T) {
+	col := hzNewCollector(t)
+	hzGlobals(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, executeCases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		judgeExecute(j, c)
+		col.count("cases")
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..54b8b3e
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,294 @@
+package hegel
+
+// Hegel property tests for spf13/cobra, written for the Hegel zoo. See targets/go/cobra/README.md.
+// They live in a package of their own (hegel/) and drive the public API: a generated
+// cobra.Command tree executed with ExecuteC on generated argument lists, the Run hooks
+// recording which command ran, in which order the hooks fired, its positional arguments and
+// the state of every flag it could see.
+//
+// Oracle: a model of the documented command-line grammar (the user guide, the doc comments of
+// Command, args.go and flag_groups.go, and pflag's grammar for the flags themselves): the
+// walk from the root to the command named by the first positional argument (Find) or, with
+// TraverseChildren, with the parents' flags parsed on the way (Traverse); prefix and
+// case-insensitive matching; the help command and flag; the version flag; the Args
+// validators; required flags and flag groups; the hooks in their documented order.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing. The model takes the set of recorded bugs it follows as a value (known); the
+// properties judge the library against the documented behaviour (hzKnownNone), name the
+// shape of the recorded bug a case has before the library is called (hzCaseJudge) and skip
+// the shapes under HEGEL_NO_KNOWN=1 (hzNoKnown, hegel_zoo_idioms_test.go).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the constants below
+// in bug order. The model is a pure function of (tree, argv, known): with every switch off
+// (hzKnownNone) it states the documented behaviour, which is what the properties judge the
+// library against; with a switch on it reproduces that bug. The classifier (executeShape)
+// runs the model with several sets to name the shape of a case before the library is called;
+// the pins assert the documented behaviour and fail while the bug exists.
+type known [15]bool
+
+const (
+	kCombinedShortKeepsValue       = iota // cobra/1: the dispatcher does not see that the last letter of a combined short token takes the next argument
+	kTraverseDashDashValue                // cobra/2: Traverse treats "--" as a flag taking the next argument and goes on matching commands after it
+	kTraverseSkipsUnknownCheck            // cobra/3: Traverse never reports an unknown command for a root with subcommands
+	kValidArgsSuggestFirst                // cobra/4: OnlyValidArgs computes its suggestions for the first argument, not the invalid one
+	kEmptyPrefixDispatch                  // cobra/5: with prefix matching, Traverse dispatches an empty argument to a command's only subcommand
+	kTraverseHelpFlagError                // cobra/6: Traverse reports a help flag among a parent's flags as the error "pflag: help requested"
+	kHelpCommandChecksFlags               // cobra/7: the help command is refused when the root's required persistent flags or flag groups are not satisfied
+	kHelpFlagSwallowsNext                 // cobra/8: the dispatcher takes the argument after --help/-h (and --version/-v) as the flag's value
+	kPrefixCaseSensitive                  // cobra/9: prefix matching ignores EnableCaseInsensitive
+	kDuplicateSuggestions                 // cobra/10: a command whose name and SuggestFor both match is suggested twice
+	kCompletionParsesTwice                // cobra/11: getCompletions parses the flags twice, so count and slice flags reach the completion functions doubled
+	kCombinedFlagValueDropsLetters        // cobra/12: completing the value of the last letter of a combined short token drops the other letters' flags
+	kCompletionCaseSensitive              // cobra/13: subcommand-name completion ignores EnableCaseInsensitive
+	kTraverseUnmergedFlags                // cobra/14: Traverse looks a command's flags up before its persistent flags are merged in
+	kPrefixMatchResetsCalledAs            // cobra/15: the hidden __complete command takes part in prefix matching an empty argument: its CalledAs is reset, and it is dispatched when the root has no other subcommand
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("cobra/N").
+func hzKnownID(i int) string { return "cobra/" + strconv.Itoa(i+1) }
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally; hzCount is the count-flag kind) the shapes of the recorded bugs the cases have ("shape cobra/N"), the rule
+// of the classifier that named them ("shape via sufficiency", "shape via necessity"), the
+// cases skipped for them under HEGEL_NO_KNOWN=1 ("known cobra/N"), the draws hzOnly rejected
+// ("filtered <name>") and the cases skipped for an unrecorded candidate bug
+// ("candidate/go/cobra-N"); printed and reset by the collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles and go/graphql-go judge,
+// with the collector's mismatch classes): it names the recorded bug whose shape the case
+// has, so that a mismatch or a library panic fails "(the shape of cobra/N)", and under
+// HEGEL_NO_KNOWN=1 skips the case instead (counted as known). The wide and the narrow
+// properties of a family share their judge function (judgeExecute) and so this. The
+// classifier that names the shape is computed from the case alone (the model run with
+// several sets of switches), before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are alternatives
+// of weight zero or filtered relations), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
diff --git a/hegel/hegel_zoo_trees_test.go b/hegel/hegel_zoo_trees_test.go
new file mode 100644
index 0000000..fe15120
--- /dev/null
+++ b/hegel/hegel_zoo_trees_test.go
@@ -0,0 +1,402 @@
+package hegel
+
+// The command trees of the properties, drawn as the records hzTreeSpec, hzCmdSpec and
+// hzFlagSpec from package-level generators: the same shapes, ranges and rates as the old
+// draw-helper generator (removed in part 2 of the rewrite). The simplest alternative
+// comes first in every choice (no flags, no aliases, no groups, Args nil, no hooks). The names
+// unique over the tree (the flag names and shorthands) and among siblings (the subcommand
+// names and aliases, against the help and completion commands) come from a used set threaded
+// through the draw: the tree is one Composite over a small live state (treeState), the idiom
+// of go/graphql-go's operation generator.
+
+import (
+	"hegel.dev/go/hegel"
+)
+
+// treeShapes: the options a shape needs forced on a drawn tree (treesWith); the zero value is
+// the plain tree of the wide property (trees). The corner shapes and the narrow properties
+// are built at the tree's anchor, a command with subcommands: the root (three in five) or the
+// first subcommand (two in five, drawn with a subcommand of its own).
+type treeShapes struct {
+	traverse, prefix, caseInsensitive   bool // the global options forced on
+	noTraverse, noPrefix, caseSensitive bool // the global options forced off (the Find-mode shapes; a typo that prefix matching would dispatch; the region past cobra/9)
+	version                             bool // Version on the root
+	requiredFlag                        bool // the root has a required persistent flag, or a one-required group over two persistent flags of its own, and nothing else the help command would fail on: no other required flag or group on the root, no group over inherited flags below it (the groups annotate the shared flag objects), no failing persistent pre-run hook (cobra/7)
+	parent                              bool // the root has a subcommand, so that the tree has an anchor
+	anchorRoot, anchorDeep              bool // the anchor is the root (the legacy check's unknown command and its suggestions: cobra/10); the first subcommand (an empty argument at the root also prefix-matches the help command: cobra/5)
+	shortPair                           bool // the anchor has a bool flag and a flag taking a value, both with shorthands (cobra/1)
+	onlyValid                           bool // the anchor runs with Args OnlyValidArgs (or MatchAll(ExactArgs(2), OnlyValidArgs)), ValidArgs, and suggests (cobra/4)
+	singleChild                         bool // the anchor has exactly one subcommand (cobra/5)
+	argsSome, argsNil                   bool // the root has an Args validator (cobra/6 at the root: the help flag is reached before the legacy check); has none (the legacy check: cobra/3, cobra/10)
+	runnable                            bool // the root runs (cobra/3)
+	availableChild                      bool // the anchor's first subcommand is available (runs, not hidden, not deprecated: the suggestions name it; cobra/4)
+	suggestTypo                         bool // the anchor suggests and its first subcommand is available with a SuggestFor word that is a typo of its name (cobra/10)
+	// the completion shapes (hegel_zoo_complete_shapes_test.go)
+	multiPair      bool // the anchor has a count, slice or array flag and a string or int flag, both with shorthands (cobra/11)
+	persistentFlag bool // the anchor has a persistent bool flag and a persistent count flag of its own and no flag group (MarkFlags* merge the flags; cobra/14)
+	leaf           bool // the root has no subcommand (cobra/15)
+	noValidArgs    bool // the anchor (the root of a tree without one) and the anchor's first subcommand have no ValidArgs, so that a completion calls their ValidArgsFunction (cobra/11, 14, 15)
+}
+
+// anchored: does the shape need an anchor?
+func (o treeShapes) anchored() bool {
+	return o.parent || o.anchorRoot || o.anchorDeep || o.shortPair || o.onlyValid || o.singleChild || o.availableChild || o.suggestTypo || o.multiPair || o.persistentFlag
+}
+
+// treeState: the live state of one tree draw: the flag names and shorthands used so far, the
+// depth the anchor is placed at (-1 for none), the anchor once placed and whether its first
+// subcommand has been drawn.
+type treeState struct {
+	o           treeShapes
+	flagNames   map[string]bool
+	shorts      map[string]bool
+	anchorDepth int
+	anchor      *hzCmdSpec
+	anchorChild bool
+}
+
+// The tables of the old tree generator, as generators (the first entry is the shrink target).
+var (
+	flagKinds      = hzSampled(hzBool, hzBool, hzString, hzString, hzInt, hzCount, hzSlice, hzArray)
+	valueKinds     = hzSampled(hzString, hzString, hzInt, hzSlice, hzArray) // the kinds taking a value
+	multiKinds     = hzSampled(hzCount, hzSlice, hzArray)                   // the kinds pflag accumulates over repeated occurrences
+	singleKinds    = hzSampled(hzString, hzInt)                             // the kinds taking a value that a second occurrence overwrites
+	stringDefaults = hzSampled("", "", "def", "x.txt")
+	intDefaults    = hzSampled("", "", "7", "-3")
+	argsKinds      = hzSampled(hzArgsNil, hzArgsNil, hzArgsNil, hzArgsNo, hzArgsArbitrary, hzArgsMin, hzArgsMax, hzArgsExact, hzArgsRange, hzArgsValid, hzArgsNoDup, hzArgsExactValid, hzArgsMinNoDup)
+	someArgsKinds  = hzSampled(hzArgsNo, hzArgsArbitrary, hzArgsMin, hzArgsMax, hzArgsExact, hzArgsRange, hzArgsValid, hzArgsNoDup, hzArgsExactValid, hzArgsMinNoDup)
+	plainArgsKinds = hzSampled(hzArgsNil, hzArgsNil, hzArgsNil, hzArgsNo, hzArgsArbitrary, hzArgsMin, hzArgsMax, hzArgsExact, hzArgsRange, hzArgsNoDup, hzArgsMinNoDup) // without ValidArgs
+	validKinds     = hzWeighted(hzW(3, hegel.Just(hzArgsValid)), hzW(1, hegel.Just(hzArgsExactValid)))
+	hookKinds      = hzSampled(hzHookNone, hzHookNone, hzHookNone, hzHookNone, hzHookNone, hzHookNone, hzHookPlain, hzHookPlain, hzHookPlain, hzHookPlain, hzHookE, hzHookE, hzHookE, hzHookEFail)
+	rootSubCounts  = hzSampled(0, 1, 2, 2, 3, 3)
+	someSubCounts  = hzSampled(1, 2, 2, 3, 3) // a root with subcommands
+	subSubCounts   = hzSampled(0, 0, 0, 1, 2)
+	anchorSubs     = hzSampled(1, 2) // the anchor at depth 1 has a subcommand
+	minDistances   = hzSampled(1, 3)
+	groupKinds     = hzInts(hzGroupTogether, hzGroupExclusive)
+	suggestWords   = hzSampled(hzSuggestPool...)
+	anchorDepths   = hzWeighted(hzW(3, hegel.Just(0)), hzW(2, hegel.Just(1)))
+	requiredForms  = hzWeighted(hzW(2, hegel.Just(false)), hzW(1, hegel.Just(true))) // a required flag; a one-required group
+)
+
+// freshNames: a name of the pool not in used ("" when none is left), marked used.
+func freshNames(used map[string]bool, pool []string) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var free []string
+		for _, n := range pool {
+			if !used[n] {
+				free = append(free, n)
+			}
+		}
+		if len(free) == 0 {
+			return ""
+		}
+		n := hegel.Draw(tc, hzSampled(free...))
+		used[n] = true
+		return n
+	})
+}
+
+// countedBy: a list of as many elements as counts draws (hzCounted with the count's own
+// table); nil for none.
+func countedBy[T any](g hegel.Generator[T], counts hegel.Generator[int]) hegel.Generator[[]T] {
+	return hegel.FlatMap(counts, func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// nonEmpty: the names drawn, without the "" of an exhausted pool.
+func nonEmpty(names []string) []string {
+	var out []string
+	for _, n := range names {
+		if n != "" {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// flagDefaults: the default value of a flag of the kind (string and int flags only).
+func flagDefaults(kind int) hegel.Generator[string] {
+	switch kind {
+	case hzString:
+		return stringDefaults
+	case hzInt:
+		return intDefaults
+	}
+	return hegel.Just("")
+}
+
+// flagsOf: one flag of the owner (nil when the names are exhausted): a fresh name, the kind
+// drawn by kinds, a fresh shorthand at 70 % (always when short), persistent 40 %, required
+// 15 %, the default of its kind.
+func flagsOf(st *treeState, owner *hzCmdSpec, kinds hegel.Generator[int], short bool) hegel.Generator[*hzFlagSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzFlagSpec {
+		name := hegel.Draw(tc, freshNames(st.flagNames, hzFlagNames))
+		if name == "" {
+			return nil
+		}
+		f := &hzFlagSpec{name: name, owner: owner}
+		f.kind = hegel.Draw(tc, kinds)
+		if short || hegel.Draw(tc, hzCoin(70)) {
+			f.short = hegel.Draw(tc, freshNames(st.shorts, hzShorts))
+		}
+		f.persistent = hegel.Draw(tc, hzCoin(40))
+		f.required = hegel.Draw(tc, hzCoin(15))
+		f.def = hegel.Draw(tc, flagDefaults(f.kind))
+		return f
+	})
+}
+
+// groupsOver: a flag group of 2-3 (at most all) of the visible flags, of a drawn kind.
+func groupsOver(vis []*hzFlagSpec) hegel.Generator[hzGroupSpec] {
+	names := make([]string, len(vis))
+	for i, f := range vis {
+		names[i] = f.name
+	}
+	hi := 3
+	if hi > len(vis) {
+		hi = len(vis)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) hzGroupSpec {
+		size := hegel.Draw(tc, hzInts(2, hi))
+		members := hegel.Draw(tc, hzCounted(freshNames(map[string]bool{}, names), size, size))
+		return hzGroupSpec{kind: hegel.Draw(tc, groupKinds), names: members}
+	})
+}
+
+// cmdsAt: a command of the name at the depth under the parent (nil for the root), its
+// subcommands drawn recursively with the sibling names and aliases unique in siblings. The
+// forced options of the shape apply to the root, to the anchor and to the anchor's first
+// subcommand.
+func cmdsAt(st *treeState, name string, parent *hzCmdSpec, depth int, siblings map[string]bool) hegel.Generator[*hzCmdSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzCmdSpec {
+		o := st.o
+		c := &hzCmdSpec{name: name, parent: parent, defaultDirective: -1}
+		root := depth == 0
+		anchor := depth == st.anchorDepth && st.anchor == nil
+		if anchor {
+			st.anchor = c
+		}
+		anchorChild := parent != nil && parent == st.anchor && !st.anchorChild
+		if anchorChild {
+			st.anchorChild = true
+		}
+		available := anchorChild && (o.availableChild || o.suggestTypo) // isAvailable: runs, not hidden, not deprecated
+		suggestive := anchor && (o.onlyValid || o.suggestTypo)
+
+		runnable := hzCoin(85)
+		if root {
+			runnable = hzCoin(70)
+		}
+		c.runnable = (anchor && o.onlyValid) || (root && o.runnable) || available || hegel.Draw(tc, runnable)
+		if c.runnable {
+			c.runE = hegel.Draw(tc, hzCoin(50))
+			c.runFails = c.runE && hegel.Draw(tc, hzCoin(10))
+		}
+		if depth > 0 {
+			c.hidden = !available && hegel.Draw(tc, hzCoin(10))
+			if !available && hegel.Draw(tc, hzCoin(10)) {
+				c.deprecated = "use something else"
+			}
+			c.aliases = nonEmpty(hegel.Draw(tc, hzMaybe(40, hzCounted(freshNames(siblings, hzCmdNames), 1, 2))))
+			if hegel.Draw(tc, hzCoin(15)) {
+				c.suggestFor = []string{hegel.Draw(tc, suggestWords)}
+			}
+			if anchorChild && o.suggestTypo {
+				c.suggestFor = append(c.suggestFor, hegel.Draw(tc, typosOf(c.name)))
+			}
+		}
+		c.disableSuggestions = !suggestive && hegel.Draw(tc, hzCoin(10))
+		if !suggestive && hegel.Draw(tc, hzCoin(15)) {
+			c.minDistance = hegel.Draw(tc, minDistances)
+		}
+
+		// the flags: the forced pair of cobra/1 first, the required flag or group of cobra/7
+		// first on the root, then 0-3 (fewer when some were forced)
+		lo, hi := 0, 3
+		if anchor && o.shortPair {
+			c.flags = append(c.flags, hegel.Draw(tc, flagsOf(st, c, hzSampled(hzBool), true)), hegel.Draw(tc, flagsOf(st, c, valueKinds, true)))
+			lo, hi = 0, 1
+		}
+		if anchor && o.multiPair {
+			c.flags = append(c.flags, hegel.Draw(tc, flagsOf(st, c, multiKinds, true)), hegel.Draw(tc, flagsOf(st, c, singleKinds, true)))
+			lo, hi = 0, 1
+		}
+		if anchor && o.persistentFlag {
+			for _, kind := range []int{hzBool, hzCount} {
+				if f := hegel.Draw(tc, flagsOf(st, c, hegel.Just(kind), false)); f != nil {
+					f.persistent = true
+					c.flags = append(c.flags, f)
+				}
+			}
+			lo, hi = 0, 1
+		}
+		group := false
+		if root && o.requiredFlag {
+			group = hegel.Draw(tc, requiredForms)
+			n := 1
+			if group {
+				n = 2
+			}
+			for i := 0; i < n; i++ {
+				f := hegel.Draw(tc, flagsOf(st, c, flagKinds, false))
+				if f != nil {
+					f.persistent, f.required = true, !group
+					c.flags = append(c.flags, f)
+				}
+			}
+			lo, hi = 0, 3-n
+		}
+		for _, f := range hegel.Draw(tc, hzCounted(flagsOf(st, c, flagKinds, false), lo, hi)) {
+			if f != nil {
+				if root && o.requiredFlag {
+					f.required = false // the forced flag or group is what the help command lacks
+				}
+				c.flags = append(c.flags, f)
+			}
+		}
+		c.flags = nonNilFlags(c.flags)
+
+		noValid := o.noValidArgs && (anchor || anchorChild || (root && st.anchorDepth < 0))
+		kinds := argsKinds
+		switch {
+		case anchor && o.onlyValid:
+			kinds = validKinds
+		case noValid:
+			kinds = plainArgsKinds
+		case root && o.argsNil:
+			kinds = hegel.Just(hzArgsNil)
+		case root && o.argsSome:
+			kinds = someArgsKinds
+		}
+		c.argsKind = hegel.Draw(tc, kinds)
+		switch c.argsKind {
+		case hzArgsMin, hzArgsMax, hzArgsExact, hzArgsExactValid, hzArgsMinNoDup:
+			c.n1 = hegel.Draw(tc, hzInts(0, 2))
+		case hzArgsRange:
+			c.n1 = hegel.Draw(tc, hzInts(0, 2))
+			c.n2 = c.n1 + hegel.Draw(tc, hzInts(0, 2))
+		}
+		if anchor && o.onlyValid && c.argsKind == hzArgsExactValid {
+			c.n1 = 2 // the valid argument and the invalid one
+		}
+		if c.argsKind == hzArgsValid || c.argsKind == hzArgsExactValid || (!noValid && hegel.Draw(tc, hzCoin(10))) {
+			lo := 0
+			if anchor && o.onlyValid {
+				lo = 1
+			}
+			c.validArgs = nonEmpty(hegel.Draw(tc, hzCounted(freshNames(map[string]bool{}, hzValidArgPool), lo, 3)))
+		}
+		c.ppre, c.pre, c.post, c.ppost = hegel.Draw(tc, hookKinds), hegel.Draw(tc, hookKinds), hegel.Draw(tc, hookKinds), hegel.Draw(tc, hookKinds)
+		if root && o.requiredFlag && c.ppre == hzHookEFail {
+			c.ppre = hzHookE // the help command runs it before its flags are checked
+		}
+
+		var counts hegel.Generator[int]
+		switch {
+		case root && o.leaf:
+			counts = hegel.Just(0)
+		case anchor && o.singleChild:
+			counts = hegel.Just(1)
+		case root && (o.anchored() || st.anchorDepth == 1):
+			counts = someSubCounts
+		case root:
+			counts = rootSubCounts
+		case anchor:
+			counts = anchorSubs
+		case depth == 1:
+			counts = subSubCounts
+		default:
+			counts = hegel.Just(0)
+		}
+		children := map[string]bool{"help": true, "completion": true}
+		for _, s := range hegel.Draw(tc, countedBy(subcommandsOf(st, c, depth+1, children), counts)) {
+			if s != nil {
+				c.subs = append(c.subs, s)
+			}
+		}
+
+		// flag groups over the flags this command sees (its own and its ancestors' persistent ones)
+		vis := c.visible()
+		if group {
+			c.groups = append(c.groups, hzGroupSpec{kind: hzGroupOne, names: []string{c.flags[0].name, c.flags[1].name}})
+		}
+		if o.requiredFlag { // a group over an inherited flag binds the help command too
+			vis = c.flags
+			if root {
+				vis = nil
+			}
+		}
+		if anchor && o.persistentFlag { // a group merges the anchor's flags before Traverse looks them up
+			vis = nil
+		}
+		if len(vis) >= 2 {
+			c.groups = append(c.groups, hegel.Draw(tc, hzMaybe(35, hzCounted(groupsOver(vis), 1, 2)))...)
+		}
+		return c
+	})
+}
+
+// nonNilFlags: the flags drawn, without the nil of an exhausted name pool.
+func nonNilFlags(flags []*hzFlagSpec) []*hzFlagSpec {
+	var out []*hzFlagSpec
+	for _, f := range flags {
+		if f != nil {
+			out = append(out, f)
+		}
+	}
+	return out
+}
+
+// subcommandsOf: a subcommand of the parent with a fresh name among its siblings (nil when
+// the names are exhausted).
+func subcommandsOf(st *treeState, parent *hzCmdSpec, depth int, siblings map[string]bool) hegel.Generator[*hzCmdSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzCmdSpec {
+		name := hegel.Draw(tc, freshNames(siblings, hzCmdNames))
+		if name == "" {
+			return nil
+		}
+		return hegel.Draw(tc, cmdsAt(st, name, parent, depth, siblings))
+	})
+}
+
+// treesWith: a tree with the options the shape needs forced; the rest as the plain trees.
+func treesWith(o treeShapes) hegel.Generator[*hzTreeSpec] {
+	option := func(on, off bool, pct int) hegel.Generator[bool] {
+		switch {
+		case on:
+			return hegel.Just(true)
+		case off:
+			return hegel.Just(false)
+		}
+		return hzCoin(pct)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) *hzTreeSpec {
+		st := &treeState{o: o, flagNames: map[string]bool{}, shorts: map[string]bool{}, anchorDepth: -1}
+		switch {
+		case o.anchorRoot:
+			st.anchorDepth = 0
+		case o.anchorDeep:
+			st.anchorDepth = 1
+		case o.anchored():
+			st.anchorDepth = hegel.Draw(tc, anchorDepths)
+		}
+		root := hegel.Draw(tc, cmdsAt(st, "root", nil, 0, map[string]bool{}))
+		t := &hzTreeSpec{root: root, anchor: st.anchor}
+		t.traverse = hegel.Draw(tc, option(o.traverse, o.noTraverse, 30))
+		t.prefix = hegel.Draw(tc, option(o.prefix, o.noPrefix, 30))
+		t.caseInsensitive = hegel.Draw(tc, option(o.caseInsensitive, o.caseSensitive, 25))
+		t.traverseHooks = hegel.Draw(tc, hzCoin(30))
+		if hegel.Draw(tc, option(o.version, false, 30)) {
+			root.version = "1.2.3"
+		}
+		if len(root.subs) > 0 {
+			t.help = &hzCmdSpec{name: "help", parent: root, runnable: true, isHelp: true, defaultDirective: -1}
+		}
+		return t
+	})
+}
+
+// trees: the plain trees of the wide property.
+var trees = treesWith(treeShapes{})
