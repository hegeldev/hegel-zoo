+// ---------------------------------------------------------------- breakpoints on full lines (x-ansi/8, /9)
+
+// breakpointCasesWith: a wrap case over hyphenated text with a hyphen in it and a breakpoint
+// set (x-ansi/8, /9); under HEGEL_NO_KNOWN=1 no hyphens or breakpoints at all. For the
+// wrappers that split words (splits) the limit is at least the widest cluster: a cluster wider
+// than the limit is x-ansi/12's region, with a property of its own.
+func breakpointCasesWith(spacesOn hegel.Generator[bool], splits, words bool) hegel.Generator[wrapCase] {
+	return hegel.Composite(func(tc hegel.TestCase) wrapCase {
+		c := wrapCase{m: hegel.Draw(tc, methods), hyphen: !Known.breakpoints, spaces: hegel.Draw(tc, spacesOn)}
+		cfg := wrapCfg(c.hyphen, c.spaces)
+		c.toks = pastLineShapes(hegel.Draw(tc, docsAround(cfg, shaped(Known.breakpoints, hegel.Just(hyphenCl.tok()), clustersOf(cfg)))))
+		c.bps = hegel.Draw(tc, breakpointSets)
+		lo := 1
+		if splits {
+			lo = max(1, maxCluster(c.toks, c.m))
+		}
+		c.limit = hegel.Draw(tc, limitsOf(lo, c.toks, c.m, c.bps, splits, words))
+		return c
+	})
+}
+
+var (
+	wrapBreakpointCases     = breakpointCasesWith(chance(75), true, false)
+	wordwrapBreakpointCases = breakpointCasesWith(hegel.Just(true), false, true)
