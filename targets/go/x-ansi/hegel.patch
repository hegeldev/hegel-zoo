+// ---------------------------------------------------------------- palette conversions
+
+func paletteRGB(i int) color.RGBA {
+	r, g, b, _ := ansi.IndexedColor(i).RGBA()
+	return color.RGBA{uint8(r >> 8), uint8(g >> 8), uint8(b >> 8), 0xff}
+}
+
+func TestHegelPaletteConversionsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		i := n(ht, 0, 255)
+		c := paletteRGB(i)
+		note(ht, "palette %d = %v", i, c)
+		if got := ansi.Convert256(ansi.IndexedColor(i)); int(got) != i {
+			fail(ht, "Convert256(IndexedColor(%d)) = %d", i, got)
+		}
+		if i >= 16 {
+			if got := ansi.Convert256(c); int(got) != i {
+				fail(ht, "Convert256(%v) = %d, want %d", c, got, i)
+			}
+		} else {
+			if got := ansi.Convert16(ansi.BasicColor(i)); int(got) != i {
+				fail(ht, "Convert16(BasicColor(%d)) = %d", i, got)
+			}
+			if got := ansi.Convert16(ansi.IndexedColor(i)); int(got) != i {
+				fail(ht, "Convert16(IndexedColor(%d)) = %d", i, got)
+			}
+			if i == 7 || i == 8 {
+				count("basic-7-8-skipped") // x-ansi/17
+			} else if got := ansi.Convert16(c); int(got) != i {
+				fail(ht, "Convert16(%v) = %d, want %d", c, got, i)
+			}
+		}
+		// Any colour lands in the cube or the greys, and Convert16 agrees with the table.
+		rc := color.RGBA{uint8(n(ht, 0, 255)), uint8(n(ht, 0, 255)), uint8(n(ht, 0, 255)), 0xff}
+		c256 := ansi.Convert256(rc)
+		if c256 < 16 {
+			fail(ht, "Convert256(%v) = %d, a basic colour", rc, c256)
+		}
+		if got, want := ansi.Convert16(rc), ansi.Convert16(c256); got != want {
+			fail(ht, "Convert16(%v) = %d, Convert16(Convert256) = %d", rc, got, want)
+		}
+		count("ok")
+	})
+}
