+// ---------------------------------------------------------------- ByteToGraphemeRange (x-ansi/16)
+
+type rangeCase struct {
+	toks []tok
+	i, j int // token boundaries, modulo the count
+}
+
+func (c rangeCase) GoString() string {
+	return fmt.Sprintf("input %q boundaries %d %d", join(c.toks), c.i, c.j)
+}
+
+var (
+	// rangeCfg: documents with sequences and controls; text only under HEGEL_NO_KNOWN=1.
+	rangeCfg = docCfg{
+		seqs: !Known.seqRanges, newlines: !Known.seqRanges, ctrls: !Known.seqRanges, eightBit: !Known.seqRanges,
+		spaces: true, hyphen: true, nbsp: true,
+	}
+	rangeCases = hegel.Composite(func(tc hegel.TestCase) rangeCase {
+		return rangeCase{toks: hegel.Draw(tc, docsOf(rangeCfg)), i: hegel.Draw(tc, positions), j: hegel.Draw(tc, positions)}
+	})
+)
+
+// byteOffset is the byte offset of token boundary k.
+func byteOffset(toks []tok, k int) int { return len(join(toks[:k])) }
+
+// TestHegelByteToGraphemeRangeCountsCells: for byte offsets on token boundaries,
+// ByteToGraphemeRange gives the cell positions of the text before them, sequences and controls
+// taking no cells (x-ansi/16 counts their bytes as cells). Past the shape: text only.
+func TestHegelByteToGraphemeRangeCountsCells(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, rangeCases)
+		i, j := at(c.i, len(c.toks)+1), at(c.j, len(c.toks)+1)
+		if i > j {
+			i, j = j, i
+		}
+		s := join(c.toks)
+		bs, be := byteOffset(c.toks, i), byteOffset(c.toks, j)
+		var sh shapes
+		sh.add("x-ansi/16", has(c.toks, func(t tok) bool { return t.kind != kText }))
+		start, stop := ansi.ByteToGraphemeRange(s, bs, be)
+		if want1, want2 := cellsBefore(c.toks, bs), cellsBefore(c.toks, be); start != want1 || stop != want2 {
+			mismatch(ht, sh, "ByteToGraphemeRange(%q, %d, %d) = %d, %d, want %d, %d", s, bs, be, start, stop, want1, want2)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- the basic greys (x-ansi/17)
+
+// greyIndices: basic colours 7 and 8; the other basic colours under HEGEL_NO_KNOWN=1.
+var greyIndices = shaped(Known.greys78, pick(7, 8), hegel.Map(hegel.Integers(0, 13), skipGreys))
+
+// TestHegelConvert16ReturnsTheBasicGreys: the exact RGB of a basic colour converts back to its
+// index through Convert16 (x-ansi/17 misses 7 and 8). Past the shape: the other basic colours.
+func TestHegelConvert16ReturnsTheBasicGreys(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		i := hegel.Draw(ht, greyIndices)
+		var sh shapes
+		sh.add("x-ansi/17", i == 7 || i == 8)
+		checkPaletteEntry(ht, i, sh)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- UTF-8 in SOS, PM and APC (x-ansi/18)
+
+var (
+	// utf8StrPayloads: a payload with a non-ASCII character; ASCII under HEGEL_NO_KNOWN=1.
+	utf8StrPayloads = shaped(Known.utf8InStrings, payloadsWith(nonASCIIPayloadChars, utf8PayloadChars), payloadsOf(asciiPayloadChars))
+	utf8StrCases    = textCasesAround(narrowCfg, strsWith(narrowCfg, utf8StrPayloads))
+)
+
+// TestHegelStringsKeepUTF8Payloads: an SOS, PM or APC string with a UTF-8 character in its
+// payload is one string to the parser and to Strip, as it is to the decoder (x-ansi/18 ends
+// it at the character). Past the shape: ASCII payloads.
+func TestHegelStringsKeepUTF8Payloads(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, utf8StrCases)
+		checkDecode(ht, c.m, c.toks, decoderShapes(c.toks))
+		checkParser(ht, c.toks, parserShapes(c.toks))
+		checkStrip(ht, c.toks, c.k, tableShapes(c.toks))
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- leading spaces (x-ansi/19)
+
+// leadingSpaceCases: a line of the input starting with one to three spaces; with a letter
+// under HEGEL_NO_KNOWN=1.
+var leadingSpaceCases = hegel.Composite(func(tc hegel.TestCase) wrapCase {
+	c := wrapCase{m: hegel.Draw(tc, methods), hyphen: hegel.Draw(tc, hyphensOn), spaces: true}
+	cfg := wrapCfg(c.hyphen, true)
+	c.toks = pastLineShapes(concat(
+		hegel.Draw(tc, hegel.Map(docsOf(cfg), afterNewline)),
+		hegel.Draw(tc, shaped(Known.leadingSpace, many(hegel.Just(spaceCl.tok()), 1, 3), many(clusterToks(letters), 1, 1))),
+		hegel.Draw(tc, docsOf(cfg)),
+	))
+	c.bps = hegel.Draw(tc, breakpointSets)
+	c.limit = hegel.Draw(tc, limitsOf(1, c.toks, c.m, c.bps, true, true))
+	return c
+})
+
+// TestHegelWrappersKeepLeadingSpaces: Wordwrap and Wrap over a line starting with spaces keep
+// the text and every line within the limit (x-ansi/19 miscounts the spaces). Past the shape:
+// a line starting with a letter.
+func TestHegelWrappersKeepLeadingSpaces(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, leadingSpaceCases)
+		checkWordwrap(ht, c, nil)
+		checkWrap(ht, c, nil)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- two private markers (x-ansi/20)
+
+var (
+	twoMarkCSIs = csisFrom(csiParts{
+		eightBitOf(narrowCfg), shaped(Known.twoMarks, many(marks, 2, 2), many(marks, 1, 1)), shortParamLists, hegel.Just(byte(0)),
+	})
+	twoMarkCases = docCasesAround(narrowCfg, twoMarkCSIs)
+)
+
+// TestHegelParserAndDecoderAgreeOnTwoPrivateMarkers: a CSI with two private markers has the
+// same prefix to the decoder and to the parser (x-ansi/20: the decoder keeps the last, the
+// parser the first). Past the shape: one marker.
+func TestHegelParserAndDecoderAgreeOnTwoPrivateMarkers(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, twoMarkCases)
+		checkDecode(ht, c.m, c.toks, decoderShapes(c.toks))
+		checkParser(ht, c.toks, parserShapes(c.toks))
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- whitespace, sequences, whitespace (x-ansi/21)
+
+// spaceSeqCases: spaces, one or two sequences, then a space or the end of the text; a letter
+// after the sequences under HEGEL_NO_KNOWN=1.
+var spaceSeqCases = hegel.Composite(func(tc hegel.TestCase) wrapCase {
+	c := wrapCase{m: hegel.Draw(tc, methods), hyphen: hegel.Draw(tc, hyphensOn), spaces: true}
+	cfg := wrapCfg(c.hyphen, true)
+	tail := shaped(Known.spaceSeqSpace,
+		weighted(choice[[]tok]{1, hegel.Just([]tok(nil))}, choice[[]tok]{1, hegel.Map(docsOf(cfg), withLead(spaceCl.tok()))}),
+		hegel.FlatMap(clusterToks(letters), func(l tok) hegel.Generator[[]tok] { return hegel.Map(docsOf(cfg), withLead(l)) }))
+	c.toks = pastLineShapes(concat(
+		hegel.Draw(tc, docsOf(cfg)),
+		[]tok{hegel.Draw(tc, clusterToks(letters))}, // something on the line before the whitespace
+		hegel.Draw(tc, many(hegel.Just(spaceCl.tok()), 1, 2)),
+		hegel.Draw(tc, many(seqsOf(cfg), 1, 2)),
+		hegel.Draw(tc, tail),
+	))
+	c.bps = hegel.Draw(tc, breakpointSets)
+	c.limit = hegel.Draw(tc, limitsOf(1, c.toks, c.m, c.bps, true, true))
+	return c
+})
+
+// TestHegelWrappersKeepWhitespaceBeforeASequenceWithinTheLimit: Wordwrap and Wrap over
+// whitespace followed by sequences and then whitespace or the end of the text keep every line
+// within the limit (x-ansi/21 flushes the whitespace past it). Past the shape: text after the
+// sequences.
+func TestHegelWrappersKeepWhitespaceBeforeASequenceWithinTheLimit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, spaceSeqCases)
+		checkWordwrap(ht, c, nil)
+		checkWrap(ht, c, nil)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- MouseX10 (x-ansi/22)
+
+type mouseCase struct{ b, x, y int }
+
+func (c mouseCase) GoString() string { return fmt.Sprintf("MouseX10(%d, %d, %d)", c.b, c.x, c.y) }
+
+// mouseCases: a button and coordinates, one of them from 95 up; both below under
+// HEGEL_NO_KNOWN=1.
+var mouseCases = hegel.Composite(func(tc hegel.TestCase) mouseCase {
+	return mouseCase{
+		b: hegel.Draw(tc, hegel.Integers(0, 63)),
+		x: hegel.Draw(tc, shaped(Known.mouseBytes, hegel.Integers(95, 222), hegel.Integers(0, 94))),
+		y: hegel.Draw(tc, shaped(Known.mouseBytes, hegel.Integers(0, 222), hegel.Integers(0, 94))),
+	}
+})
+
+// TestHegelMouseX10PayloadIsThreeBytes: MouseX10 is CSI M and three bytes, the button plus 32
+// and the coordinates plus 33 (x-ansi/22 encodes a byte from 0x80 up as two). Past the shape:
+// coordinates below 95.
+func TestHegelMouseX10PayloadIsThreeBytes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, mouseCases)
+		got := ansi.MouseX10(byte(c.b), c.x, c.y)
+		want := "\x1b[M" + string([]byte{byte(c.b + 32), byte(c.x + 33), byte(c.y + 33)})
+		var sh shapes
+		sh.add("x-ansi/22", c.x >= 95 || c.y >= 95)
+		if got != want {
+			mismatch(ht, sh, "MouseX10(%d, %d, %d) = %q (%d bytes), want %q", c.b, c.x, c.y, got, len(got), want)
+		}
+		count("ok")
+	})
+}
diff --git a/ansi/hegel_test.go b/ansi/hegel_test.go
new file mode 100644
index 0000000..4460cf0
--- /dev/null
+++ b/ansi/hegel_test.go
@@ -0,0 +1,297 @@
+// Hegel properties for charmbracelet/x/ansi: the escape-sequence decoder and state-machine
+// parser, Strip and the cell widths, truncation and cutting, the three wrappers, the SGR style
+// builder and colour reader, XParseColor and the palette conversions.
+//
+// Oracles: a token grammar of ECMA-48 sequences (CSI, ESC, OSC, DCS, APC/PM/SOS strings), C0
+// controls and grapheme clusters of known width (hegel_gen_test.go) - every generated document
+// is a token list, so the decoder, the parser, Strip and the widths are all compared against
+// the list they were built from; models of Truncate/TruncateLeft/Cut and Hardwrap written from
+// the documentation; an SGR model (every printable rune of a wrapper's output carries the style
+// it had in the input) and line-width invariants for Wordwrap and Wrap; the SGR parameter table
+// for the style builder and ITU T.416 for ReadStyleColor; X11's XParseColor rules; the xterm
+// palette for the colour conversions (hegel_model_test.go, hegel_props_test.go).
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn by default, so the wide properties
+// that meet them fail naming the bug and are the expected failures mapped to it; each bug also
+// has a narrow property over its shape region (hegel_shapes_test.go) and a pin
+// (hegel_pins_test.go). HEGEL_NO_KNOWN=1 (noKnown, read once below) switches every known shape
+// off, at the generator or at the mismatch site, for a run that looks past the known bugs.
+// X_ANSI_COLLECT=1 turns failures into a tally per property.
+package ansi_test
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("X_ANSI_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// isControlPanic reports whether a recovered value is Hegel's own control flow (or the
+// collector's), which must be re-raised rather than reported as a failure.
+func isControlPanic(r any) bool {
+	if _, ok := r.(collected); ok {
+		return true
+	}
+	tn := reflect.TypeOf(r).String()
+	if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+		return true
+	}
+	return strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.")
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			if isControlPanic(r) {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+// count tallies an outcome for the collect-mode summary.
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- known shapes
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// every switch of Known is off and the generators draw the bugs' shapes at their natural rate;
+// a disagreement on one fails naming the bug (the wide properties are then the expected
+// failures mapped to the bugs they find, beside the narrow properties and the pins).
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known holds one switch per recorded shape. A switch that is on keeps the shape out of the
+// generators (or, where the shape is only recognisable on the result, makes mismatch assume
+// the case away); every switch is noKnown.
+var Known = struct {
+	bufferParams  bool // x-ansi/1, /2: a CSI/DCS parameter list at or beyond the parser's buffer
+	stInUTF8      bool // x-ansi/3: a 0x9C byte inside a UTF-8 character of a string payload
+	lateMark      bool // x-ansi/4: a private marker after the parameters
+	splitCluster  bool // x-ansi/5: a cluster starting with an ASCII character (arbitrary text)
+	zwjWc         bool // x-ansi/6: a cluster whose grapheme and wc widths differ, truncated by wcwidth
+	cutWcLeft     bool // x-ansi/7: CutWc with left > 0
+	breakpoints   bool // x-ansi/8, /9: a line holding a breakpoint, or followed by one
+	longWord      bool // x-ansi/10: a line ending in a word exactly as wide as the limit
+	wideSpace     bool // x-ansi/11: the ideographic space in Wordwrap
+	wideCluster   bool // x-ansi/12: a cluster wider than the limit (Hardwrap, Wrap)
+	nbspHardwrap  bool // x-ansi/13: the no-break space in Hardwrap
+	hexDigits     bool // x-ansi/14: one-, three- and four-digit rgb: components
+	bigComponents bool // x-ansi/15: a colour component beyond 255
+	seqRanges     bool // x-ansi/16: ByteToGraphemeRange over sequences and controls
+	greys78       bool // x-ansi/17: the exact RGB of basic colours 7 and 8
+	utf8InStrings bool // x-ansi/18: a UTF-8 character inside an SOS, PM or APC string
+	leadingSpace  bool // x-ansi/19: a line of the input starting with a space (Wordwrap, Wrap)
+	twoMarks      bool // x-ansi/20: two private markers
+	spaceSeqSpace bool // x-ansi/21: whitespace, sequences, then whitespace or the end
+	mouseBytes    bool // x-ansi/22: MouseX10 coordinates from 95 upwards
+}{
+	bufferParams: noKnown, stInUTF8: noKnown, lateMark: noKnown, splitCluster: noKnown,
+	zwjWc: noKnown, cutWcLeft: noKnown, breakpoints: noKnown, longWord: noKnown,
+	wideSpace: noKnown, wideCluster: noKnown, nbspHardwrap: noKnown, hexDigits: noKnown,
+	bigComponents: noKnown, seqRanges: noKnown, greys78: noKnown, utf8InStrings: noKnown,
+	leadingSpace: noKnown, twoMarks: noKnown, spaceSeqSpace: noKnown, mouseBytes: noKnown,
+}
+
+// shapes names the recorded bugs whose shape a case has.
+type shapes []string
+
+func (s *shapes) add(id string, present bool) {
+	if present {
+		for _, have := range *s {
+			if have == id {
+				return
+			}
+		}
+		*s = append(*s, id)
+	}
+}
+
+// mismatch reports a disagreement with the model on a case whose known shapes are named (none
+// for a plain failure): the shapes are counted and the failure names them; under
+// HEGEL_NO_KNOWN=1 a case with a known shape is assumed away instead.
+func mismatch(ht *hegel.T, known shapes, format string, args ...any) {
+	if len(known) > 0 {
+		for _, b := range known {
+			count("shape " + b)
+		}
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(known, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// recovering runs fn and turns a panic of the code under test into a mismatch naming the
+// case's known shapes (the harness's own recover above stays as the backstop).
+func recovering(ht *hegel.T, known shapes, what string, fn func()) {
+	defer func() {
+		r := recover()
+		if r == nil {
+			return
+		}
+		if isControlPanic(r) {
+			panic(r)
+		}
+		mismatch(ht, known, "%s panics: %v", what, r)
+	}()
+	fn()
+}
+
+// ---------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices in proportion to their weights with one draw; it
+// shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (the die shrinks to 0, so the true
+// range is the top of it).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table (the first is the shrink target).
+func pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// shaped is the generator of a recorded bug's shape region, or, when its switch is on
+// (HEGEL_NO_KNOWN=1), of the region past it.
+func shaped[T any](off bool, known, past hegel.Generator[T]) hegel.Generator[T] {
+	if off {
+		return past
+	}
+	return known
+}
+
+// positions is an index into something of unknown length, taken modulo the length when used.
+var positions = hegel.Integers(0, 99)
+
+// at is i taken modulo n (0 when n is 0).
+func at(i, n int) int {
+	if n <= 0 {
+		return 0
+	}
+	return i % n
+}
