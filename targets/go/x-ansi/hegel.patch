+// ---------------------------------------------------------------- fixed examples
+
+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	for _, c := range clusters {
+		if w := ansi.StringWidth(c.s); w != c.w {
+			t.Errorf("StringWidth(%q) = %d, table %d", c.s, w, c.w)
+		}
+		if w := ansi.StringWidthWc(c.s); w != c.wc {
+			t.Errorf("StringWidthWc(%q) = %d, table %d", c.s, w, c.wc)
+		}
+	}
+	if got := ansi.Truncate("Hello, World!", 5, "\u2026"); got != "Hell\u2026" {
+		t.Errorf("Truncate = %q", got)
+	}
+	if got := ansi.Wordwrap("the quick brown fox", 10, ""); got != "the quick\nbrown fox" {
+		t.Errorf("Wordwrap = %q", got)
+	}
+	if got := ansi.Hardwrap("foobarfoo", 4, true); got != "foob\narfo\no" {
+		t.Errorf("Hardwrap = %q", got)
+	}
+	if got := ansi.NewStyle(ansi.AttrBold, ansi.AttrRedForegroundColor).String(); got != "\x1b[1;31m" {
+		t.Errorf("Style = %q", got)
+	}
+	if got := ansi.Strip("\x1b[1mbold\x1b[m \x1b]8;;http://x\x1b\\link\x1b]8;;\x1b\\"); got != "bold link" {
+		t.Errorf("Strip = %q", got)
+	}
+}
