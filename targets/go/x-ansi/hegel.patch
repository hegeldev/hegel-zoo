+// ---------------------------------------------------------------- the state machine
+
+type parserCase struct{ toks []tok }
+
+func (c parserCase) GoString() string { return fmt.Sprintf("input %q", join(c.toks)) }
+
+var parserCases = hegel.Map(docsOf(decodeCfg), func(toks []tok) parserCase { return parserCase{toks} })
+
+// checkParser: Parser.Advance over the text reports the grammar's events.
+func checkParser(ht *hegel.T, toks []tok, known shapes) {
+	s := join(toks)
+	got := parseEvents(s)
+	want := expectedEvents(toks)
+	if !sameStrings(got, want) {
+		mismatch(ht, known, "parser events for %q:\n got %q\nwant %q", s, got, want)
+	}
+}
+
+// TestHegelParserReportsTheGrammarsEvents: the state-machine parser reports every token's
+// event. Drawn shapes: a buffer-sized parameter list (x-ansi/2), a 0x9C byte inside a UTF-8
+// character (x-ansi/3), UTF-8 inside SOS/PM/APC strings (x-ansi/18), two private markers
+// (x-ansi/20).
+func TestHegelParserReportsTheGrammarsEvents(t *testing.T) {
