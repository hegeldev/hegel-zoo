+// TestHegelWordwrapKeepsBreakpointLinesWithinTheLimit: Wordwrap over text with hyphens and
+// breakpoints keeps every line within the limit (x-ansi/9 writes a breakpoint past the limit).
+// Past the shape: no breakpoints.
+func TestHegelWordwrapKeepsBreakpointLinesWithinTheLimit(t *testing.T) {
