+// ---------------------------------------------------------------- fixed examples
+
+// TestHegelExamples: the widths of every cluster the generators use agree with the library
+// (the token grammar's widths are its oracle), and the documentation's examples hold.
+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	table := append(append(append([]cl(nil), clusters...), asciiStartClusters...), spaceCl, hyphenCl, wideSpaceCl)
+	for _, c := range table {
+		if w := ansi.StringWidth(c.s); w != c.w {
+			t.Errorf("StringWidth(%q) = %d, table %d", c.s, w, c.w)
+		}
+		if w := ansi.StringWidthWc(c.s); w != c.wc {
+			t.Errorf("StringWidthWc(%q) = %d, table %d", c.s, w, c.wc)
+		}
+	}
+	if got := ansi.Truncate("Hello, World!", 5, "\u2026"); got != "Hell\u2026" {
+		t.Errorf("Truncate = %q", got)
+	}
+	if got := ansi.Wordwrap("the quick brown fox", 10, ""); got != "the quick\nbrown fox" {
+		t.Errorf("Wordwrap = %q", got)
+	}
+	if got := ansi.Hardwrap("foobarfoo", 4, true); got != "foob\narfo\no" {
+		t.Errorf("Hardwrap = %q", got)
+	}
+	if got := ansi.NewStyle(ansi.AttrBold, ansi.AttrRedForegroundColor).String(); got != "\x1b[1;31m" {
+		t.Errorf("Style = %q", got)
+	}
+	if got := ansi.Strip("\x1b[1mbold\x1b[m \x1b]8;;http://x\x1b\\link\x1b]8;;\x1b\\"); got != "bold link" {
+		t.Errorf("Strip = %q", got)
+	}
+}
+
+// x-ansi/22: MouseX10 builds the three payload bytes with string(byte), which converts each
+// byte to a rune and encodes it in UTF-8: any byte from 0x80 up (coordinates from 95, or a
+// button byte with the wheel/extra bits and modifiers) becomes two bytes, and the sequence is
+// no longer CSI M plus three bytes.
+func TestHegelPinMouseX10EncodesBytesAsRunes(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct{ x, y int }{{100, 0}, {0, 100}, {222, 222}} {
+		seq := ansi.MouseX10(0, c.x, c.y)
+		if len(seq) != 6 {
+			t.Errorf("MouseX10(0, %d, %d) = %q (%d bytes), want CSI M and three bytes", c.x, c.y, seq, len(seq))
+		}
+	}
+}
