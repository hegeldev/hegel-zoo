+// x-ansi/1: DecodeSequence indexes past the parser's parameter buffer.
+func TestHegelPinDecodeSequenceWithManyParameters(t *testing.T) {
+	defer guard(t)
+	s := csiWithParams(parser.MaxParamsSize + 1)
+	p := ansi.NewParser()
+	seq, _, k, _ := ansi.DecodeSequence([]byte(s), ansi.NormalState, p)
+	if string(seq) != s || k != len(s) {
+		t.Fatalf("DecodeSequence(%q) = %q, %d", s, seq, k)
+	}
+	if got := len(p.Params()); got != parser.MaxParamsSize {
+		t.Fatalf("%d parameters kept of %d, buffer %d", got, parser.MaxParamsSize+1, parser.MaxParamsSize)
+	}
+}
