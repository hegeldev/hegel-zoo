+// Hegel properties for charmbracelet/x/ansi: the escape-sequence decoder and state-machine
+// parser, Strip and the cell widths, truncation and cutting, the three wrappers, the SGR style
+// builder and colour reader, XParseColor and the palette conversions.
+//
+// Oracles: a token grammar of ECMA-48 sequences (CSI, ESC, OSC, DCS, APC/PM/SOS strings), C0
+// controls and grapheme clusters of known width — every generated document is a token list, so
+// the decoder, the parser, Strip and the widths are all compared against the list they were
+// built from; models of Truncate/TruncateLeft/Cut and Hardwrap written from the documentation;
+// an SGR model (every printable rune of a wrapper's output carries the style it had in the
+// input) and line-width invariants for Wordwrap and Wrap; the SGR parameter table for the style
+// builder and ITU T.416 for ReadStyleColor; X11's XParseColor rules; the xterm palette for the
+// colour conversions. X_ANSI_COLLECT=1 turns failures into a tally per property.
+package ansi_test
+
+import (
+	"fmt"
+	"image/color"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/ansi/parser"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("X_ANSI_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+// count tallies an outcome for the collect-mode summary.
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- the token grammar
+
+type kind int
+
+const (
+	kText kind = iota // one grapheme cluster
+	kCtrl             // one C0 control byte
+	kCSI
+	kESC
+	kOSC
+	kDCS
+	kStr // APC, PM or SOS string
+)
+
+type tok struct {
+	kind   kind
+	s      string // the raw bytes
+	w, wc  int    // cell widths under GraphemeWidth and WcWidth (text only)
+	prefix byte   // CSI/DCS private marker, 0 if none (the last one written)
+	inter  byte   // CSI/DCS/ESC intermediate, 0 if none (the last one written)
+	final  byte   // CSI/DCS/ESC final byte
+	params []int  // CSI/DCS packed parameters, as the decoder reports them
+	cmd    int    // OSC command number (parser.MissingCommand when there is none); kStr: the introducer
+	data   string // OSC/DCS/kStr payload as the decoder and the parser report it
+	escST  bool   // string terminated by ESC \ (the state machine dispatches that ESC too)
+}
+
+// A cluster and its widths. Grapheme widths from displaywidth and wc widths from runewidth agree
+// with these for every entry (checked once in TestHegelExamples).
+type cl struct {
+	s     string
+	w, wc int
+}
+
+var clusters = []cl{
+	{"a", 1, 1}, {"b", 1, 1}, {"Z", 1, 1}, {"0", 1, 1}, {"\u00e9", 1, 1},
+	{"\u65e5", 2, 2}, {"\U0001F600", 2, 2},
+	{"\U0001F468\u200d\U0001F469\u200d\U0001F467", 2, 6}, // family ZWJ sequence
+	{"\u00a0", 1, 1}, // no-break space: text for every algorithm here
+}
+
+var (
+	spaceCl  = cl{" ", 1, 1}
+	hyphenCl = cl{"-", 1, 1}
+)
+
+type docCfg struct {
+	seqs     bool // CSI/ESC/OSC/DCS/string tokens
+	sgrOnly  bool // with seqs: only SGR sequences and OSC 8 hyperlinks (the style model reads them)
+	spaces   bool // ASCII spaces
+	newlines bool
+	ctrls    bool // C0 controls other than newline
+	hyphen   bool
+	wcSafe   bool // no cluster whose grapheme and wc widths differ
+	narrow   bool // no width-2 clusters
+	nbsp     bool // allow the no-break space
+	eightBit bool // 8-bit C1 introducers and terminators now and then
+	twoMarks bool // two private markers in a CSI now and then (the Parser keeps the first: x-ansi/20)
+}
+
+func genCluster(tc hegel.TestCase, cfg docCfg) tok {
+	for {
+		c := pick(tc, clusters)
+		if cfg.wcSafe && c.w != c.wc {
+			continue
+		}
+		if cfg.narrow && c.w != 1 {
+			continue
+		}
+		if !cfg.nbsp && c.s == "\u00a0" {
+			continue
+		}
+		return tok{kind: kText, s: c.s, w: c.w, wc: c.wc}
+	}
+}
+
+// genParamText draws a CSI/DCS parameter string and returns the packed parameters the decoder
+// documents: ';' separates parameters, ':' marks the one before it as having sub-parameters,
+// an empty parameter is missing, and a lone empty string is no parameter at all.
+func genParamText(tc hegel.TestCase) (string, []int) {
+	np := n(tc, 0, 4)
+	var sb strings.Builder
+	for i := 0; i < np; i++ {
+		if i > 0 {
+			if chance(tc, 25) {
+				sb.WriteByte(':')
+			} else {
+				sb.WriteByte(';')
+			}
+		}
+		if chance(tc, 20) {
+			continue // missing
+		}
+		if chance(tc, 10) {
+			sb.WriteByte('0')
+		}
+		sb.WriteString(strconv.Itoa(n(tc, 0, 999)))
+	}
+	return sb.String(), packParams(sb.String())
+}
+
+// packParams is the model of the parameter format.
+func packParams(text string) []int {
+	if text == "" {
+		return nil
+	}
+	var out []int
+	cur := -1 // -1 = missing
+	flush := func(more bool) {
+		v := parser.MissingParam
+		if cur >= 0 {
+			v = cur
+		}
+		if more {
+			v |= parser.HasMoreFlag
+		}
+		out = append(out, v)
+		cur = -1
+	}
+	for i := 0; i < len(text); i++ {
+		c := text[i]
+		switch {
+		case c >= '0' && c <= '9':
+			if cur < 0 {
+				cur = 0
+			}
+			cur = cur*10 + int(c-'0')
+		case c == ';':
+			flush(false)
+		case c == ':':
+			flush(true)
+		}
+	}
+	flush(false)
+	return out
+}
+
+const (
+	intermediates = " !\"#$%&'()*+,-./"
+	prefixes      = "<=>?"
+)
+
+func genFinal(tc hegel.TestCase) byte { return byte(n(tc, 0x40, 0x7e)) }
+
+func genCSI(tc hegel.TestCase, cfg docCfg) tok {
+	var sb strings.Builder
+	if cfg.eightBit && chance(tc, 15) {
+		sb.WriteByte(0x9b)
+	} else {
+		sb.WriteString("\x1b[")
+	}
+	t := tok{kind: kCSI}
+	if chance(tc, 30) {
+		k := 1
+		if cfg.twoMarks && chance(tc, 30) {
+			k = 2
+		}
+		for i := k; i > 0; i-- {
+			t.prefix = prefixes[n(tc, 0, len(prefixes)-1)]
+			sb.WriteByte(t.prefix)
+		}
+	}
+	text, params := genParamText(tc)
+	sb.WriteString(text)
+	t.params = params
+	if chance(tc, 30) {
+		for i := n(tc, 1, 2); i > 0; i-- {
+			t.inter = intermediates[n(tc, 0, len(intermediates)-1)]
+			sb.WriteByte(t.inter)
+		}
+	}
+	t.final = genFinal(tc)
+	sb.WriteByte(t.final)
+	t.s = sb.String()
+	return t
+}
+
+// genSGR draws an SGR sequence (CSI … m) built from a random Style; a reset one in five.
+func genSGR(tc hegel.TestCase) tok {
+	var st ansi.Style
+	if !chance(tc, 20) {
+		st, _ = genStyle(tc)
+	}
+	s := st.String()
+	t := tok{kind: kCSI, s: s, final: 'm'}
+	t.params = packParams(s[2 : len(s)-1])
+	return t
+}
+
+func genESC(tc hegel.TestCase) tok {
+	var sb strings.Builder
+	sb.WriteByte(0x1b)
+	t := tok{kind: kESC}
+	ni := n(tc, 0, 2)
+	for i := 0; i < ni; i++ {
+		t.inter = intermediates[n(tc, 0, len(intermediates)-1)]
+		sb.WriteByte(t.inter)
+	}
+	for {
+		t.final = byte(n(tc, 0x30, 0x7e))
+		// Those start other kinds of sequence; the decoder takes them so even after an
+		// intermediate, so they are kept out of the grammar altogether.
+		if strings.IndexByte("[]PX^_\\", t.final) < 0 {
+			break
+		}
+	}
+	sb.WriteByte(t.final)
+	t.s = sb.String()
+	return t
+}
+
+// payloadChars are safe inside OSC/DCS/APC strings: no C0 byte and no 0x9C byte in their UTF-8.
+var payloadChars = []string{" ", "a", "Z", "0", "7", ";", ":", "/", "=", "~", "\u00e9", "\u65e5", "\U0001F600"}
+
+func genPayload(tc hegel.TestCase, ascii bool) string {
+	var sb strings.Builder
+	for i := n(tc, 0, 6); i > 0; i-- {
+		c := pick(tc, payloadChars)
+		if ascii && c[0] >= 0x80 {
+			continue
+		}
+		sb.WriteString(c)
+	}
+	return sb.String()
+}
+
+func genST(tc hegel.TestCase, cfg docCfg, t *tok) string {
+	if cfg.eightBit && chance(tc, 20) {
+		return "\x9c"
+	}
+	t.escST = true
+	return "\x1b\\"
+}
+
+func oscCmd(data string) int {
+	i := 0
+	for i < len(data) && data[i] >= '0' && data[i] <= '9' {
+		i++
+	}
+	if i == 0 {
+		return parser.MissingCommand
+	}
+	v, _ := strconv.Atoi(data[:i])
+	return v
+}
+
+func genOSC(tc hegel.TestCase, cfg docCfg) tok {
+	t := tok{kind: kOSC}
+	var sb strings.Builder
+	if cfg.eightBit && chance(tc, 15) {
+		sb.WriteByte(0x9d)
+	} else {
+		sb.WriteString("\x1b]")
+	}
+	var data strings.Builder
+	if chance(tc, 85) {
+		data.WriteString(strconv.Itoa(n(tc, 0, 999)))
+		if chance(tc, 90) {
+			data.WriteByte(';')
+			data.WriteString(genPayload(tc, false))
+		}
+	} else {
+		data.WriteString(genPayload(tc, false))
+	}
+	t.data = data.String()
+	t.cmd = oscCmd(t.data)
+	sb.WriteString(t.data)
+	switch n(tc, 1, 3) {
+	case 1:
+		sb.WriteByte(0x07)
+	default:
+		sb.WriteString(genST(tc, cfg, &t))
+	}
+	t.s = sb.String()
+	return t
+}
+
+// genHyperlink draws an OSC 8 hyperlink open or close.
+func genHyperlink(tc hegel.TestCase) tok {
+	t := tok{kind: kOSC, cmd: 8}
+	if chance(tc, 50) {
+		t.data = "8;;"
+	} else {
+		t.data = "8;;https://example.com/" + strings.Repeat("x", n(tc, 0, 3))
+	}
+	t.s = "\x1b]" + t.data + "\x1b\\"
+	t.escST = true
+	return t
+}
+
+func genDCS(tc hegel.TestCase, cfg docCfg) tok {
+	t := tok{kind: kDCS}
+	var sb strings.Builder
+	if cfg.eightBit && chance(tc, 15) {
+		sb.WriteByte(0x90)
+	} else {
+		sb.WriteString("\x1bP")
+	}
+	if chance(tc, 30) {
+		t.prefix = prefixes[n(tc, 0, len(prefixes)-1)]
+		sb.WriteByte(t.prefix)
+	}
+	text, params := genParamText(tc)
+	sb.WriteString(text)
+	t.params = params
+	if chance(tc, 30) {
+		t.inter = intermediates[n(tc, 0, len(intermediates)-1)]
+		sb.WriteByte(t.inter)
+	}
+	t.final = genFinal(tc)
+	sb.WriteByte(t.final)
+	t.data = genPayload(tc, false)
+	sb.WriteString(t.data)
+	sb.WriteString(genST(tc, cfg, &t))
+	t.s = sb.String()
+	return t
+}
+
+func genStr(tc hegel.TestCase, cfg docCfg) tok {
+	t := tok{kind: kStr}
+	var sb strings.Builder
+	t.cmd = int(pick(tc, []byte{'_', '^', 'X'}))
+	if cfg.eightBit && chance(tc, 15) {
+		sb.WriteByte(map[int]byte{'_': 0x9f, '^': 0x9e, 'X': 0x98}[t.cmd])
+	} else {
+		sb.WriteByte(0x1b)
+		sb.WriteByte(byte(t.cmd))
+	}
+	// The table-driven parser lets a UTF-8 character break out of these strings (x-ansi/18).
+	t.data = genPayload(tc, true)
+	sb.WriteString(t.data)
+	sb.WriteString(genST(tc, cfg, &t))
+	t.s = sb.String()
+	return t
+}
+
+func genSeq(tc hegel.TestCase, cfg docCfg) tok {
+	if cfg.sgrOnly {
+		if chance(tc, 80) {
+			return genSGR(tc)
+		}
+		return genHyperlink(tc)
+	}
+	switch n(tc, 1, 10) {
+	case 1, 2, 3:
+		return genCSI(tc, cfg)
+	case 4, 5:
+		return genSGR(tc)
+	case 6:
+		return genESC(tc)
+	case 7, 8:
+		return genOSC(tc, cfg)
+	case 9:
+		return genDCS(tc, cfg)
+	default:
+		return genStr(tc, cfg)
+	}
+}
+
+func genDoc(tc hegel.TestCase, cfg docCfg) []tok {
+	var toks []tok
+	for i := n(tc, 0, 12); i > 0; i-- {
+		r := n(tc, 1, 100)
+		switch {
+		case cfg.seqs && r <= 25:
+			toks = append(toks, genSeq(tc, cfg))
+		case cfg.spaces && r <= 40:
+			toks = append(toks, tok{kind: kText, s: spaceCl.s, w: 1, wc: 1})
+		case cfg.newlines && r <= 48:
+			toks = append(toks, tok{kind: kCtrl, s: "\n"})
+		case cfg.ctrls && r <= 53:
+			toks = append(toks, tok{kind: kCtrl, s: pick(tc, []string{"\r", "\t", "\a", "\b"})})
+		case cfg.hyphen && r <= 60:
+			toks = append(toks, tok{kind: kText, s: hyphenCl.s, w: 1, wc: 1})
+		default:
+			toks = append(toks, genCluster(tc, cfg))
+		}
+	}
+	return toks
+}
+
+func join(toks []tok) string {
+	var sb strings.Builder
+	for _, t := range toks {
+		sb.WriteString(t.s)
+	}
+	return sb.String()
+}
+
+func (t tok) isSeq() bool { return t.kind >= kCSI }
+
+func (t tok) width(m ansi.Method) int {
+	if t.kind != kText {
+		return 0
+	}
+	if m == ansi.WcWidth {
+		return t.wc
+	}
+	return t.w
+}
+
+func totalWidth(toks []tok, m ansi.Method) int {
+	w := 0
+	for _, t := range toks {
+		w += t.width(m)
+	}
+	return w
+}
+
+func maxCluster(toks []tok, m ansi.Method) int {
+	w := 0
+	for _, t := range toks {
+		if t.kind == kText && t.width(m) > w {
+			w = t.width(m)
+		}
+	}
+	return w
+}
+
+func paramsOf(ps ansi.Params) []int {
+	if len(ps) == 0 {
+		return nil
+	}
+	out := make([]int, len(ps))
+	for i, p := range ps {
+		out[i] = int(p)
+	}
+	return out
+}
+
+func paramsText(ps []int) string {
+	var parts []string
+	for _, p := range ps {
+		v := ansi.Param(p)
+		s := "-"
+		if v.Param(-1) >= 0 {
+			s = strconv.Itoa(v.Param(-1))
+		}
+		if v.HasMore() {
+			s += ":"
+		}
+		parts = append(parts, s)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+// ---------------------------------------------------------------- the decoder
+
+type piece struct {
+	s      string
+	w      int
+	state  byte
+	cmd    int
+	params []int
+	data   string
+}
+
+func decodeAll(s string, m ansi.Method) []piece {
+	p := ansi.NewParser()
+	var out []piece
+	state := ansi.NormalState
+	for len(s) > 0 {
+		seq, w, k, ns := m.DecodeSequenceInString(s, state, p)
+		if k <= 0 {
+			panic("DecodeSequence made no progress")
+		}
+		out = append(out, piece{s: seq, w: w, state: ns, cmd: p.Command(), params: paramsOf(p.Params()), data: string(p.Data())})
+		s = s[k:]
+		state = ns
+	}
+	return out
+}
+
+func TestHegelDecodeSequenceFollowsTheGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := pick(ht, []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth})
+		cfg := docCfg{seqs: true, spaces: true, newlines: true, ctrls: true, hyphen: true, nbsp: true, eightBit: true, twoMarks: true}
+		toks := genDoc(ht, cfg)
+		s := join(toks)
+		note(ht, "method %d input %q", m, s)
+		pieces := decodeAll(s, m)
+		if len(pieces) != len(toks) {
+			var got []string
+			for _, p := range pieces {
+				got = append(got, fmt.Sprintf("%q", p.s))
+			}
+			fail(ht, "decoded %d pieces for %d tokens:\n%s", len(pieces), len(toks), strings.Join(got, " "))
+		}
+		for i, p := range pieces {
+			tk := toks[i]
+			if p.s != tk.s {
+				fail(ht, "piece %d = %q, token %q", i, p.s, tk.s)
+			}
+			if p.state != ansi.NormalState {
+				fail(ht, "piece %d %q left state %d", i, p.s, p.state)
+			}
+			if p.w != tk.width(m) {
+				fail(ht, "piece %d %q width %d, want %d", i, p.s, p.w, tk.width(m))
+			}
+			switch tk.kind {
+			case kCSI, kDCS, kESC:
+				want := ansi.Command(tk.prefix, tk.inter, tk.final)
+				if p.cmd != want {
+					fail(ht, "piece %d %q cmd %#x, want %#x", i, p.s, p.cmd, want)
+				}
+				if tk.kind != kESC && !reflect.DeepEqual(p.params, tk.params) {
+					fail(ht, "piece %d %q params %s, want %s", i, p.s, paramsText(p.params), paramsText(tk.params))
+				}
+				if tk.kind == kDCS && p.data != tk.data {
+					fail(ht, "piece %d %q data %q, want %q", i, p.s, p.data, tk.data)
+				}
+			case kOSC:
+				if p.cmd != tk.cmd {
+					fail(ht, "piece %d %q OSC cmd %d, want %d", i, p.s, p.cmd, tk.cmd)
+				}
+				if p.data != tk.data {
+					fail(ht, "piece %d %q OSC data %q, want %q", i, p.s, p.data, tk.data)
+				}
+			case kStr:
+				if p.cmd != parser.MissingCommand {
+					fail(ht, "piece %d %q cmd %d, want none", i, p.s, p.cmd)
+				}
+				if p.data != tk.data {
+					fail(ht, "piece %d %q data %q, want %q", i, p.s, p.data, tk.data)
+				}
+			}
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- the state machine
+
+func parseEvents(s string) []string {
+	var ev []string
+	p := ansi.NewParser()
+	p.SetHandler(ansi.Handler{
+		Print:   func(r rune) { ev = append(ev, "print "+string(r)) },
+		Execute: func(b byte) { ev = append(ev, fmt.Sprintf("exec %#x", b)) },
+		HandleCsi: func(c ansi.Cmd, ps ansi.Params) {
+			ev = append(ev, fmt.Sprintf("csi %#x %s", int(c), paramsText(paramsOf(ps))))
+		},
+		HandleEsc: func(c ansi.Cmd) { ev = append(ev, fmt.Sprintf("esc %#x", int(c))) },
+		HandleDcs: func(c ansi.Cmd, ps ansi.Params, d []byte) {
+			ev = append(ev, fmt.Sprintf("dcs %#x %s %q", int(c), paramsText(paramsOf(ps)), d))
+		},
+		HandleOsc: func(cmd int, d []byte) { ev = append(ev, fmt.Sprintf("osc %d %q", cmd, d)) },
+		HandleApc: func(d []byte) { ev = append(ev, fmt.Sprintf("apc %q", d)) },
+		HandlePm:  func(d []byte) { ev = append(ev, fmt.Sprintf("pm %q", d)) },
+		HandleSos: func(d []byte) { ev = append(ev, fmt.Sprintf("sos %q", d)) },
+	})
+	for i := 0; i < len(s); i++ {
+		p.Advance(s[i])
+	}
+	return ev
+}
+
+func expectedEvents(toks []tok) []string {
+	var ev []string
+	for _, tk := range toks {
+		switch tk.kind {
+		case kText:
+			for _, r := range tk.s {
+				ev = append(ev, "print "+string(r))
+			}
+		case kCtrl:
+			ev = append(ev, fmt.Sprintf("exec %#x", tk.s[0]))
+		case kCSI:
+			ev = append(ev, fmt.Sprintf("csi %#x %s", ansi.Command(tk.prefix, tk.inter, tk.final), paramsText(tk.params)))
+		case kESC:
+			ev = append(ev, fmt.Sprintf("esc %#x", ansi.Command(0, tk.inter, tk.final)))
+		case kDCS:
+			ev = append(ev, fmt.Sprintf("dcs %#x %s %q", ansi.Command(tk.prefix, tk.inter, tk.final), paramsText(tk.params), tk.data))
+		case kOSC:
+			ev = append(ev, fmt.Sprintf("osc %d %q", tk.cmd, tk.data))
+		case kStr:
+			ev = append(ev, fmt.Sprintf("%s %q", map[int]string{'_': "apc", '^': "pm", 'X': "sos"}[tk.cmd], tk.data))
+		}
+		if tk.escST {
+			// ESC \ is itself an escape sequence to a VT parser: the string is dispatched at
+			// the ESC and the ST at the backslash.
+			ev = append(ev, fmt.Sprintf("esc %#x", int('\\')))
+		}
+	}
+	return ev
+}
+
+func TestHegelParserReportsTheGrammarsEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		cfg := docCfg{seqs: true, spaces: true, newlines: true, ctrls: true, hyphen: true, nbsp: true, eightBit: true}
+		toks := genDoc(ht, cfg)
+		s := join(toks)
+		note(ht, "input %q", s)
+		got := parseEvents(s)
+		want := expectedEvents(toks)
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "parser events for %q:\n got %q\nwant %q", s, got, want)
+		}
+		count("ok")
+	})
+}
