+// ---------------------------------------------------------------- a word as wide as the limit (x-ansi/10)
+
+// longWordCases: a line of a space and then a word exactly as wide as the limit, the bug's
+// own shape (`Wordwrap(" cdefg", 5, "")`: the line held one cell before the word, which is
+// never wrapped once it is as wide as the limit; a hyphen before the word would put the case
+// in x-ansi/9's region, and the space at the line start is x-ansi/19's shape too, so both are
+// named). Under HEGEL_NO_KNOWN=1 the line starts with a letter and the word is one cell
+// narrower, when no other word of the document is as wide as the limit either. What follows
+// starts a new line.
+var longWordCases = hegel.Composite(func(tc hegel.TestCase) wrapCase {
+	c := wrapCase{m: hegel.Draw(tc, methods), spaces: true, limit: hegel.Draw(tc, hegel.Integers(2, 6))}
+	cfg := wrapCfg(false, true)
+	n := hegel.Draw(tc, shaped(Known.longWord, hegel.Just(c.limit), hegel.Just(c.limit-1)))
+	c.toks = pastLineShapes(concat(
+		hegel.Draw(tc, hegel.Map(docsOf(cfg), afterNewline)),
+		hegel.Draw(tc, shaped(Known.longWord, hegel.Just([]tok(nil)), many(clusterToks(letters), 1, 1))), // nothing, or a letter, before the space
+		[]tok{spaceCl.tok()},
+		hegel.Draw(tc, many(clusterToks(letters), n, n)),
+		hegel.Draw(tc, hegel.Map(docsOf(cfg), leadNewline)),
+	))
+	if Known.longWord {
+		c.toks = withoutWordsOfWidth(c.toks, c.limit, c.m)
+	}
+	return c
+})
