+// ---------------------------------------------------------------- XParseColor
+
+const hexDigits = "0123456789abcdefABCDEF"
+
+// scaleHex is X11's rule: h, hh, hhh and hhhh are fractions of 4, 8, 12 and 16 bits; the
+// 8-bit value is the top byte of the 16-bit scaling.
+func scaleHex(digits string) int {
+	v, _ := strconv.ParseUint(digits, 16, 32)
+	switch len(digits) {
+	case 1:
+		return int(v) * 0x11
+	case 2:
+		return int(v)
+	case 3:
+		return int(v >> 4)
+	default:
+		return int(v >> 8)
+	}
+}
+
+// genHexComponent draws a two-digit component: the one-, three- and four-digit forms are
+// scaled wrongly and invalid components read as zero (x-ansi/14, pinned).
+func genHexComponent(tc hegel.TestCase) string {
+	var sb strings.Builder
+	for i := 2; i > 0; i-- {
+		sb.WriteByte(hexDigits[n(tc, 0, len(hexDigits)-1)])
+	}
+	return sb.String()
+}
+
+func TestHegelXParseColorFollowsX11(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var s string
+		var want []int
+		switch n(ht, 0, 2) {
+		case 0:
+			parts := make([]string, 3)
+			for i := range parts {
+				parts[i] = genHexComponent(ht)
+				want = append(want, scaleHex(parts[i]))
+			}
+			s = "rgb:" + strings.Join(parts, "/")
+			want = append(want, 255)
+		case 1:
+			parts := make([]string, 4)
+			for i := range parts {
+				parts[i] = genHexComponent(ht)
+				want = append(want, scaleHex(parts[i]))
+			}
+			s = "rgba:" + strings.Join(parts, "/")
+		default:
+			d := pick(ht, []int{1, 2})
+			var sb strings.Builder
+			sb.WriteByte('#')
+			for i := 0; i < 3; i++ {
+				var comp strings.Builder
+				for j := 0; j < d; j++ {
+					comp.WriteByte(hexDigits[n(ht, 0, len(hexDigits)-1)])
+				}
+				sb.WriteString(comp.String())
+				want = append(want, scaleHex(comp.String()))
+			}
+			s = sb.String()
+			want = append(want, 255)
+		}
+		note(ht, "XParseColor(%q)", s)
+		got := ansi.XParseColor(s)
+		if got == nil {
+			fail(ht, "XParseColor(%q) = nil, want %v", s, want)
+		}
+		r, g, b, a := got.RGBA()
+		if gotV := []int{int(r >> 8), int(g >> 8), int(b >> 8), int(a >> 8)}; !reflect.DeepEqual(gotV, want) {
+			fail(ht, "XParseColor(%q) = %v (%v), want %v", s, gotV, got, want)
+		}
+		count("ok")
+	})
+}
