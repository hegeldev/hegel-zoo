+// ---------------------------------------------------------------- styles
+
+type colorKind int
+
+const (
+	cNil colorKind = iota
+	cBasic
+	cIndexed
+	cRGB
+	cTrue
+	cStd
+)
+
+func genColor(tc hegel.TestCase) (ansi.Color, colorKind) {
+	switch n(tc, 0, 5) {
+	case 0:
+		return nil, cNil
+	case 1:
+		return ansi.BasicColor(n(tc, 0, 15)), cBasic
+	case 2:
+		return ansi.IndexedColor(n(tc, 0, 255)), cIndexed
+	case 3:
+		return ansi.RGBColor{R: uint8(n(tc, 0, 255)), G: uint8(n(tc, 0, 255)), B: uint8(n(tc, 0, 255))}, cRGB
+	case 4:
+		return ansi.TrueColor(n(tc, 0, 0xffffff)), cTrue
+	default:
+		return color.RGBA{R: uint8(n(tc, 0, 255)), G: uint8(n(tc, 0, 255)), B: uint8(n(tc, 0, 255)), A: 0xff}, cStd
+	}
+}
+
+func rgb8(c color.Color) (int, int, int) {
+	r, g, b, _ := c.RGBA()
+	return int(r >> 8), int(g >> 8), int(b >> 8)
+}
+
+// colorParams is the SGR parameter text for a colour, from the table: 30-37/90-97 for the basic
+// foregrounds (40-47/100-107 backgrounds), 38;5;n indexed, 38;2;r;g;b direct; underline colours
+// (58) have no basic form and take the indexed one.
+func colorParams(base int, c ansi.Color, k colorKind) string {
+	switch k {
+	case cNil:
+		return strconv.Itoa(base + 1)
+	case cBasic:
+		v := int(c.(ansi.BasicColor))
+		if base == 58 {
+			return "58;5;" + strconv.Itoa(v)
+		}
+		if v < 8 {
+			return strconv.Itoa(base - 8 + v)
+		}
+		return strconv.Itoa(base + 52 + v - 8)
+	case cIndexed:
+		return strconv.Itoa(base) + ";5;" + strconv.Itoa(int(c.(ansi.IndexedColor)))
+	default:
+		r, g, b := rgb8(c)
+		return fmt.Sprintf("%d;2;%d;%d;%d", base, r, g, b)
+	}
+}
+
+type styleStep struct {
+	params string // expected parameter text
+	base   int    // 38/48/58 for a colour step, 0 otherwise
+	color  ansi.Color
+	kind   colorKind
+}
+
+// genStyle builds a Style through its methods and the parameter text each one should append.
+func genStyle(tc hegel.TestCase) (ansi.Style, []styleStep) {
+	st := ansi.Style{}
+	var steps []styleStep
+	for i := n(tc, 1, 5); i > 0; i-- {
+		v := chance(tc, 60)
+		onoff := func(on, off string) string {
+			if v {
+				return on
+			}
+			return off
+		}
+		switch n(tc, 0, 14) {
+		case 0:
+			st = st.Bold()
+			steps = append(steps, styleStep{params: "1"})
+		case 1:
+			st = st.Faint()
+			steps = append(steps, styleStep{params: "2"})
+		case 2:
+			st = st.Italic(v)
+			steps = append(steps, styleStep{params: onoff("3", "23")})
+		case 3:
+			st = st.Underline(v)
+			steps = append(steps, styleStep{params: onoff("4", "24")})
+		case 4:
+			u := ansi.Underline(n(tc, 0, 5))
+			st = st.UnderlineStyle(u)
+			steps = append(steps, styleStep{params: []string{"24", "4", "4:2", "4:3", "4:4", "4:5"}[u]})
+		case 5:
+			st = st.Blink(v)
+			steps = append(steps, styleStep{params: onoff("5", "25")})
+		case 6:
+			st = st.RapidBlink(v)
+			steps = append(steps, styleStep{params: onoff("6", "25")})
+		case 7:
+			st = st.Reverse(v)
+			steps = append(steps, styleStep{params: onoff("7", "27")})
+		case 8:
+			st = st.Conceal(v)
+			steps = append(steps, styleStep{params: onoff("8", "28")})
+		case 9:
+			st = st.Strikethrough(v)
+			steps = append(steps, styleStep{params: onoff("9", "29")})
+		case 10:
+			st = st.Normal()
+			steps = append(steps, styleStep{params: "22"})
+		case 11:
+			st = st.Reset()
+			steps = append(steps, styleStep{params: "0"})
+		case 12:
+			c, k := genColor(tc)
+			st = st.ForegroundColor(c)
+			steps = append(steps, styleStep{params: colorParams(38, c, k), base: 38, color: c, kind: k})
+		case 13:
+			c, k := genColor(tc)
+			st = st.BackgroundColor(c)
+			steps = append(steps, styleStep{params: colorParams(48, c, k), base: 48, color: c, kind: k})
+		default:
+			c, k := genColor(tc)
+			st = st.UnderlineColor(c)
+			steps = append(steps, styleStep{params: colorParams(58, c, k), base: 58, color: c, kind: k})
+		}
+	}
+	return st, steps
+}
+
+func sameColor(a, b color.Color) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	r1, g1, b1, a1 := a.RGBA()
+	r2, g2, b2, a2 := b.RGBA()
+	return r1 == r2 && g1 == g2 && b1 == b2 && a1 == a2
+}
+
+func TestHegelStylesRoundTripThroughTheDecoder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		st, steps := genStyle(ht)
+		var parts []string
+		for _, s := range steps {
+			parts = append(parts, s.params)
+		}
+		want := "\x1b[" + strings.Join(parts, ";") + "m"
+		got := st.String()
+		note(ht, "style %q", got)
+		if got != want {
+			fail(ht, "Style.String() = %q, want %q", got, want)
+		}
+		text := pick(ht, []string{"", "x", "\u65e5"})
+		if s2 := st.Styled(text); s2 != got+text+ansi.ResetStyle {
+			fail(ht, "Styled(%q) = %q, want %q", text, s2, got+text+ansi.ResetStyle)
+		}
+		// Back through the decoder and ReadStyleColor.
+		p := ansi.NewParser()
+		seq, _, k, _ := ansi.DecodeSequence(got, ansi.NormalState, p)
+		if k != len(got) || seq != got {
+			fail(ht, "decoding %q consumed %d of %d bytes", got, k, len(got))
+		}
+		params := p.Params()
+		i := 0
+		for _, step := range steps {
+			if i >= len(params) {
+				fail(ht, "%q: parameters run out at step %q", got, step.params)
+			}
+			if step.base == 0 || step.kind == cBasic && step.base != 58 {
+				// one attribute, possibly with one sub-parameter
+				v, more := params[i].Param(-1), params[i].HasMore()
+				text := strconv.Itoa(v)
+				i++
+				if more {
+					text += ":" + strconv.Itoa(params[i].Param(-1))
+					i++
+				}
+				if text != step.params {
+					fail(ht, "%q: step %q decoded as %q", got, step.params, text)
+				}
+				continue
+			}
+			if step.kind == cNil {
+				if v := params[i].Param(-1); v != step.base+1 {
+					fail(ht, "%q: default colour decoded as %d", got, v)
+				}
+				i++
+				continue
+			}
+			var c color.Color
+			consumed := ansi.ReadStyleColor(params[i:], &c)
+			wantN := 3
+			if step.kind >= cRGB {
+				wantN = 5
+			}
+			if consumed != wantN {
+				fail(ht, "%q: ReadStyleColor read %d parameters at %s, want %d", got, consumed, paramsText(paramsOf(params[i:])), wantN)
+			}
+			var wantC color.Color
+			switch step.kind {
+			case cBasic, cIndexed:
+				wantC = ansi.IndexedColor(uint8(reflect.ValueOf(step.color).Uint()))
+			default:
+				r, g, b := rgb8(step.color)
+				wantC = color.RGBA{uint8(r), uint8(g), uint8(b), 0xff}
+			}
+			if !sameColor(c, wantC) {
+				fail(ht, "%q: ReadStyleColor at %s gave %v, want %v", got, paramsText(paramsOf(params[i:])), c, wantC)
+			}
+			i += consumed
+		}
+		if i != len(params) {
+			fail(ht, "%q: %d parameters left after the steps", got, len(params)-i)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- ReadStyleColor and T.416
+
+type colorForm struct {
+	text  string
+	n     int
+	color color.Color // nil = untouched
+}
+
+func genColorForm(tc hegel.TestCase) colorForm {
+	t := pick(tc, []int{38, 48, 58})
+	ts := strconv.Itoa(t)
+	v := func() int { return n(tc, 0, 255) }
+	r, g, b, a := v(), v(), v(), v()
+	rgba := color.RGBA{uint8(r), uint8(g), uint8(b), 0xff}
+	cmy := color.CMYK{uint8(r), uint8(g), uint8(b), 0}
+	cs := strconv.Itoa(n(tc, 0, 9))
+	x := strconv.Itoa(n(tc, 0, 99))
+	switch n(tc, 0, 13) {
+	case 0:
+		return colorForm{fmt.Sprintf("%s;5;%d", ts, r), 3, ansi.IndexedColor(r)}
+	case 1:
+		return colorForm{fmt.Sprintf("%s:5:%d", ts, r), 3, ansi.IndexedColor(r)}
+	case 2:
+		return colorForm{fmt.Sprintf("%s;2;%d;%d;%d", ts, r, g, b), 5, rgba}
+	case 3:
+		return colorForm{fmt.Sprintf("%s:2:%d:%d:%d", ts, r, g, b), 5, rgba}
+	case 4:
+		return colorForm{fmt.Sprintf("%s:2::%d:%d:%d", ts, r, g, b), 6, rgba}
+	case 5:
+		return colorForm{fmt.Sprintf("%s:2:%s:%d:%d:%d", ts, cs, r, g, b), 6, rgba}
+	case 6:
+		return colorForm{fmt.Sprintf("%s:2::%d:%d:%d:%s", ts, r, g, b, x), 7, rgba}
+	case 7:
+		return colorForm{fmt.Sprintf("%s:2::%d:%d:%d:%s:%s", ts, r, g, b, x, x), 8, rgba}
+	case 8:
+		return colorForm{fmt.Sprintf("%s:2::%d:%d:%d:%s:%s:%s", ts, r, g, b, x, x, cs), 9, rgba}
+	case 9:
+		return colorForm{fmt.Sprintf("%s:3::%d:%d:%d", ts, r, g, b), 6, cmy}
+	case 10:
+		return colorForm{fmt.Sprintf("%s:4::%d:%d:%d:%d", ts, r, g, b, a), 7, color.CMYK{uint8(r), uint8(g), uint8(b), uint8(a)}}
+	case 11:
+		return colorForm{fmt.Sprintf("%s:6::%d:%d:%d:%d", ts, r, g, b, a), 7, color.RGBA{uint8(r), uint8(g), uint8(b), uint8(a)}}
+	case 12:
+		return colorForm{ts + ":1", 2, color.Transparent}
+	default:
+		return colorForm{ts + ":0", 2, nil}
+	}
+}
+
+func TestHegelReadStyleColorFollowsT416(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := genColorForm(ht)
+		text := f.text
+		if chance(ht, 50) {
+			text += ";" + strconv.Itoa(n(ht, 0, 9))
+		}
+		if chance(ht, 30) {
+			text = strconv.Itoa(n(ht, 1, 9)) + ";" + text
+		}
+		note(ht, "params %q", text)
+		p := ansi.NewParser()
+		seq := "\x1b[" + text + "m"
+		if _, _, k, _ := ansi.DecodeSequence(seq, ansi.NormalState, p); k != len(seq) {
+			fail(ht, "decoding %q consumed %d bytes", seq, k)
+		}
+		params := p.Params()
+		start := 0
+		if strings.HasPrefix(text, f.text) {
+			start = 0
+		} else {
+			start = 1
+		}
+		sentinel := color.Gray{Y: 77}
+		var c color.Color = sentinel
+		got := ansi.ReadStyleColor(params[start:], &c)
+		if got != f.n {
+			fail(ht, "ReadStyleColor(%q) read %d parameters, want %d", f.text, got, f.n)
+		}
+		want := f.color
+		if want == nil {
+			want = sentinel
+		}
+		if !reflect.DeepEqual(c, want) {
+			fail(ht, "ReadStyleColor(%q) = %#v, want %#v", f.text, c, want)
+		}
+		count("ok")
+	})
+}
