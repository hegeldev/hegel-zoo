+// decoderShapes, parserShapes and tableShapes name the recorded shapes of a token list for the
+// decoder, the state-machine parser, and everything built on the transition table (Strip, the
+// widths, truncation, the wrappers).
+func decoderShapes(toks []tok) shapes {
+	var sh shapes
+	sh.add("x-ansi/1", paramsAtLeast(toks, parser.MaxParamsSize+1))
+	sh.add("x-ansi/2", paramsExactly(toks, parser.MaxParamsSize))
+	sh.add("x-ansi/3", stInsideUTF8(toks))
+	sh.add("x-ansi/4", has(toks, func(t tok) bool { return t.late }))
+	return sh
+}
+
+func parserShapes(toks []tok) shapes {
+	var sh shapes
+	sh.add("x-ansi/2", paramsExactly(toks, parser.MaxParamsSize))
+	sh.add("x-ansi/3", stInsideUTF8(toks))
+	sh.add("x-ansi/18", utf8InStrings(toks))
+	sh.add("x-ansi/20", has(toks, func(t tok) bool { return t.marks >= 2 }))
+	return sh
+}
+
+func tableShapes(toks []tok) shapes {
+	var sh shapes
+	sh.add("x-ansi/3", stInsideUTF8(toks))
+	sh.add("x-ansi/18", utf8InStrings(toks))
+	return sh
+}
+
+// ---------------------------------------------------------------- the decoder
+
+type docCase struct {
+	m    ansi.Method
+	toks []tok
+}
+
+func (c docCase) GoString() string { return fmt.Sprintf("method %d input %q", c.m, join(c.toks)) }
+
+var (
+	decodeCfg   = docCfg{seqs: true, spaces: true, newlines: true, ctrls: true, hyphen: true, nbsp: true, eightBit: true}
+	decodeCases = hegel.Composite(func(tc hegel.TestCase) docCase {
+		return docCase{m: hegel.Draw(tc, methods), toks: hegel.Draw(tc, docsOf(decodeCfg))}
+	})
+)
+
+// checkDecode: DecodeSequence over the text gives the tokens back, one piece each, with the
+// widths, commands, packed parameters and payloads of the grammar.
+func checkDecode(ht *hegel.T, m ansi.Method, toks []tok, known shapes) {
+	s := join(toks)
+	var pieces []piece
+	recovering(ht, known, fmt.Sprintf("DecodeSequence on %q", s), func() { pieces = decodeAll(s, m) })
+	if len(pieces) != len(toks) {
+		var got []string
+		for _, p := range pieces {
+			got = append(got, fmt.Sprintf("%q", p.s))
+		}
+		mismatch(ht, known, "decoded %d pieces for %d tokens of %q:\n%s", len(pieces), len(toks), s, strings.Join(got, " "))
+	}
+	for i, p := range pieces {
+		tk := toks[i]
+		if p.s != tk.s {
+			mismatch(ht, known, "piece %d = %q, token %q", i, p.s, tk.s)
+		}
+		if p.state != ansi.NormalState {
+			mismatch(ht, known, "piece %d %q left state %d", i, p.s, p.state)
+		}
+		if p.w != tk.width(m) {
+			mismatch(ht, known, "piece %d %q width %d, want %d", i, p.s, p.w, tk.width(m))
+		}
+		switch tk.kind {
+		case kCSI, kDCS, kESC:
+			want := ansi.Command(tk.prefix, tk.inter, tk.final)
+			if p.cmd != want {
+				mismatch(ht, known, "piece %d %q cmd %#x, want %#x", i, p.s, p.cmd, want)
+			}
+			if tk.kind != kESC && !sameInts(p.params, tk.expectedParams()) {
+				mismatch(ht, known, "piece %d %q params %s, want %s", i, p.s, paramsText(p.params), paramsText(tk.expectedParams()))
+			}
+			if tk.kind == kDCS && p.data != tk.data {
+				mismatch(ht, known, "piece %d %q data %q, want %q", i, p.s, p.data, tk.data)
+			}
+		case kOSC:
+			if p.cmd != tk.cmd {
+				mismatch(ht, known, "piece %d %q OSC cmd %d, want %d", i, p.s, p.cmd, tk.cmd)
+			}
+			if p.data != tk.data {
+				mismatch(ht, known, "piece %d %q OSC data %q, want %q", i, p.s, p.data, tk.data)
+			}
+		case kStr:
+			if p.cmd != parser.MissingCommand {
+				mismatch(ht, known, "piece %d %q cmd %d, want none", i, p.s, p.cmd)
+			}
+			if p.data != tk.data {
+				mismatch(ht, known, "piece %d %q data %q, want %q", i, p.s, p.data, tk.data)
+			}
+		}
+	}
+}
+
+// TestHegelDecodeSequenceFollowsTheGrammar: DecodeSequence over a document gives its tokens
+// back. Drawn shapes: parameter lists at and beyond the buffer (x-ansi/1 panics, /2 loses the
+// last parameter), a 0x9C byte inside a UTF-8 character of a string (x-ansi/3), a private
+// marker after the parameters (x-ansi/4).
+func TestHegelDecodeSequenceFollowsTheGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, decodeCases)
+		checkDecode(ht, c.m, c.toks, decoderShapes(c.toks))
+		count("ok")
+	})
+}
