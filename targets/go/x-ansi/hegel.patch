+
+// ---------------------------------------------------------------- truncation
+
+// truncateModel follows the documentation of Truncate: unchanged when it fits; otherwise the
+// clusters that fit in length - width(tail) cells, the tail where the first one does not, and
+// every escape sequence of the input in place (so styles are closed); controls after the cut
+// are dropped.
+func truncateModel(toks []tok, m ansi.Method, length int, tail string) string {
+	if totalWidth(toks, m) <= length {
+		return join(toks)
+	}
+	limit := length - ansi.StringWidth(tail)
+	if limit < 0 {
+		return ""
+	}
+	var sb strings.Builder
+	cur, ignoring := 0, false
+	for _, tk := range toks {
+		switch {
+		case tk.isSeq():
+			sb.WriteString(tk.s)
+		case ignoring:
+		case tk.kind == kCtrl:
+			sb.WriteString(tk.s)
+		case cur+tk.w > limit && m == ansi.GraphemeWidth, cur+tk.wc > limit && m == ansi.WcWidth:
+			sb.WriteString(tail)
+			ignoring = true
+		default:
+			sb.WriteString(tk.s)
+			cur += tk.width(m)
+		}
+	}
+	return sb.String()
+}
+
+// truncateLeftModel: the first n cells are removed (a cluster straddling the boundary is kept
+// whole, as the documentation's examples have it), escape sequences before the cut are kept,
+// controls before it dropped, and the prefix goes where the kept text starts.
+func truncateLeftModel(toks []tok, m ansi.Method, nn int, prefix string) string {
+	if nn <= 0 {
+		return join(toks)
+	}
+	var sb strings.Builder
+	cur, ignoring := 0, true
+	for _, tk := range toks {
+		switch {
+		case !ignoring:
+			sb.WriteString(tk.s)
+		case tk.isSeq():
+			sb.WriteString(tk.s)
+		case tk.kind == kCtrl:
+		default:
+			cur += tk.width(m)
+			if cur > nn {
+				sb.WriteString(prefix)
+				sb.WriteString(tk.s)
+				ignoring = false
+			}
+		}
+	}
+	return sb.String()
+}
+
+// retokenize splits a string the models produced back into tokens, using the token list it
+// came from (the pieces are all substrings of the input's tokens, in order).
+func retokenize(toks []tok, s string) []tok {
+	var out []tok
+	for _, tk := range toks {
+		if strings.HasPrefix(s, tk.s) {
+			out = append(out, tk)
+			s = s[len(tk.s):]
+		}
+	}
+	return out
+}
+
+var tails = []string{"", ".", "\u2026", "..", "\u65e5"}
+
+func TestHegelTruncateFollowsItsModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := pick(ht, []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth})
+		cfg := docCfg{seqs: true, spaces: true, newlines: true, nbsp: true, wcSafe: m == ansi.WcWidth}
+		toks := genDoc(ht, cfg)
+		s := join(toks)
+		length := n(ht, 0, 8)
+		tail := pick(ht, tails)
+		note(ht, "method %d input %q length %d tail %q", m, s, length, tail)
+
+		got := m.Truncate(s, length, tail)
+		if want := truncateModel(toks, m, length, tail); got != want {
+			fail(ht, "Truncate(%q, %d, %q) = %q, want %q", s, length, tail, got, want)
+		}
+		if ansi.StringWidth(tail) <= length && m.StringWidth(got) > length {
+			fail(ht, "Truncate(%q, %d, %q) = %q is %d cells wide", s, length, tail, got, m.StringWidth(got))
+		}
+		if m == ansi.GraphemeWidth {
+			if g2 := ansi.Truncate(s, length, tail); g2 != got {
+				fail(ht, "ansi.Truncate and GraphemeWidth.Truncate differ on %q: %q vs %q", s, g2, got)
+			}
+		} else if g2 := ansi.TruncateWc(s, length, tail); g2 != got {
+			fail(ht, "ansi.TruncateWc and WcWidth.Truncate differ on %q: %q vs %q", s, g2, got)
+		}
+
+		prefix := pick(ht, tails)
+		left := n(ht, 0, 8)
+		gotL := m.TruncateLeft(s, left, prefix)
+		if want := truncateLeftModel(toks, m, left, prefix); gotL != want {
+			fail(ht, "TruncateLeft(%q, %d, %q) = %q, want %q", s, left, prefix, gotL, want)
+		}
+		if m == ansi.GraphemeWidth {
+			if g2 := ansi.TruncateLeft(s, left, prefix); g2 != gotL {
+				fail(ht, "ansi.TruncateLeft and GraphemeWidth.TruncateLeft differ on %q", s)
+			}
+		} else if g2 := ansi.TruncateLeftWc(s, left, prefix); g2 != gotL {
+			fail(ht, "ansi.TruncateLeftWc and WcWidth.TruncateLeft differ on %q", s)
+		}
+
+		// Cut is a Truncate followed by a TruncateLeft.
+		l, r := n(ht, 0, 6), n(ht, 0, 8)
+		want := ""
+		if r > l {
+			cutR := truncateModel(toks, m, r, "")
+			want = truncateLeftModel(retokenize(toks, cutR), m, l, "")
+		}
+		if m == ansi.WcWidth && l > 0 {
+			count("cutwc-left-skipped") // x-ansi/7
+		} else if gotC := m.Cut(s, l, r); gotC != want {
+			fail(ht, "Cut(%q, %d, %d) = %q, want %q", s, l, r, gotC, want)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- hard wrapping
+
+// hardwrapModel: clusters are laid out greedily, a cluster that would exceed the limit starts a
+// new line, an explicit newline starts one too, escape sequences are transparent, and unless
+// preserveSpace is set a space at the start of a line the wrap created is dropped.
+func hardwrapModel(toks []tok, m ansi.Method, limit int, preserveSpace bool) string {
+	if limit < 1 {
+		return join(toks)
+	}
+	var sb strings.Builder
+	cur, forced := 0, false
+	for _, tk := range toks {
+		switch {
+		case tk.isSeq():
+			sb.WriteString(tk.s)
+		case tk.kind == kCtrl: // "\n" only in this property
+			sb.WriteByte('\n')
+			cur, forced = 0, false
+		default:
+			w := tk.width(m)
+			if cur > 0 && cur+w > limit {
+				sb.WriteByte('\n')
+				cur, forced = 0, true
+			}
+			if cur == 0 {
+				if !preserveSpace && forced && tk.s == " " {
+					continue
+				}
+				forced = false
+			}
+			sb.WriteString(tk.s)
+			cur += w
+		}
+	}
+	return sb.String()
+}
+
+func TestHegelHardwrapFollowsTheGreedyModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := pick(ht, []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth})
+		cfg := docCfg{seqs: true, spaces: true, newlines: true, hyphen: true}
+		toks := genDoc(ht, cfg)
+		s := join(toks)
+		limit := n(ht, 0, 6)
+		preserve := chance(ht, 40)
+		note(ht, "method %d input %q limit %d preserveSpace %v", m, s, limit, preserve)
+		if limit >= 1 && maxCluster(toks, m) > limit {
+			count("cluster-wider-than-limit") // x-ansi/12
+			return
+		}
+		got := m.Hardwrap(s, limit, preserve)
+		if want := hardwrapModel(toks, m, limit, preserve); got != want {
+			fail(ht, "Hardwrap(%q, %d, %v) = %q, want %q", s, limit, preserve, got, want)
+		}
+		if m == ansi.GraphemeWidth {
+			if g2 := ansi.Hardwrap(s, limit, preserve); g2 != got {
+				fail(ht, "ansi.Hardwrap and GraphemeWidth.Hardwrap differ on %q", s)
+			}
+		} else if g2 := ansi.HardwrapWc(s, limit, preserve); g2 != got {
+			fail(ht, "ansi.HardwrapWc and WcWidth.Hardwrap differ on %q", s)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- the SGR model
+
+// srune is a printable rune with the SGR style in force where it appears: the SGR sequences
+// since the last reset, concatenated. "*" marks a rune whose style is not judged.
+type srune struct {
+	r     rune
+	style string
+}
+
+func isReset(seq string) bool { return seq == "\x1b[m" || seq == "\x1b[0m" }
+
+// styled reads a string with the decoder (checked against the grammar above) and attaches to
+// every printable rune the style in force.
+func styled(s string) []srune {
+	var out []srune
+	style := ""
+	p := ansi.NewParser()
+	state := ansi.NormalState
+	for len(s) > 0 {
+		seq, _, k, ns := ansi.DecodeSequence(s, state, p)
+		if k <= 0 {
+			panic("no progress")
+		}
+		switch {
+		case strings.HasSuffix(seq, "m") && (strings.HasPrefix(seq, "\x1b[") || seq[0] == 0x9b):
+			if isReset(seq) {
+				style = ""
+			} else {
+				style += seq
+			}
+		case seq[0] == 0x1b || seq[0] >= 0x80 && seq[0] < 0xa0:
+			// other sequences: transparent
+		case seq[0] < 0x20 || seq[0] == 0x7f:
+			out = append(out, srune{rune(seq[0]), "*"})
+		default:
+			for _, r := range seq {
+				out = append(out, srune{r, style})
+			}
+		}
+		s = s[k:]
+		state = ns
+	}
+	return out
+}
+
+func isWS(r rune) bool { return r == ' ' || r == '\n' }
+
+func nonSpace(rs []srune) []srune {
+	var out []srune
+	for _, r := range rs {
+		if !isWS(r.r) {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+func sameStyled(a, b []srune) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].r != b[i].r {
+			return false
+		}
+		if a[i].style != b[i].style && a[i].style != "*" && b[i].style != "*" {
+			return false
+		}
+	}
+	return true
+}
+
+func showStyled(rs []srune) string {
+	var sb strings.Builder
+	for _, r := range rs {
+		fmt.Fprintf(&sb, "%q", string(r.r))
+		if r.style != "" {
+			fmt.Fprintf(&sb, "{%q}", r.style)
+		}
+		sb.WriteByte(' ')
+	}
+	return sb.String()
+}
+
+// sequences lists the escape sequences of a string in order.
+func sequences(s string) []string {
+	var out []string
+	p := ansi.NewParser()
+	state := ansi.NormalState
+	for len(s) > 0 {
+		seq, _, k, ns := ansi.DecodeSequence(s, state, p)
+		if k <= 0 {
+			panic("no progress")
+		}
+		if seq[0] == 0x1b || seq[0] >= 0x80 && seq[0] < 0xa0 {
+			out = append(out, seq)
+		}
+		s = s[k:]
+		state = ns
+	}
+	return out
+}
+
+// lastWordWidth is the width of the text after the last space or breakpoint of a line.
+func lastWordWidth(line string, breakpoints string) int {
+	plain := strings.TrimRight(ansi.Strip(line), " ")
+	i := strings.LastIndexAny(plain, " -"+breakpoints)
+	return ansi.StringWidth(plain[i+1:])
+}
+
+// hasLeadingSpace reports whether a line of the input starts with a space (x-ansi/19).
+func hasLeadingSpace(s string) bool {
+	for _, line := range strings.Split(ansi.Strip(s), "\n") {
+		if strings.HasPrefix(line, " ") {
+			return true
+		}
+	}
+	return false
+}
+
+// spaceSequenceSpace reports whether the document has a space followed by escape sequences
+// and then another space or the end of the text: the wrappers flush the pending whitespace
+// when the word buffer holds only sequences, without checking the limit (x-ansi/21).
+func spaceSequenceSpace(toks []tok) bool {
+	for i, t := range toks {
+		if t.s != " " || t.kind != kText {
+			continue
+		}
+		j := i + 1
+		for j < len(toks) && toks[j].isSeq() {
+			j++
+		}
+		if j > i+1 && (j == len(toks) || toks[j].s == " ") {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------- word wrapping
+
+func TestHegelWordwrapKeepsWordsAndStyles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := pick(ht, []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth})
+		cfg := docCfg{seqs: true, sgrOnly: true, spaces: true, newlines: true, hyphen: chance(ht, 40), wcSafe: m == ansi.WcWidth, nbsp: true}
+		toks := genDoc(ht, cfg)
+		s := join(toks)
+		limit := n(ht, 0, 6)
+		bps := pick(ht, []string{"", "", "Z", "0"})
+		note(ht, "method %d input %q limit %d breakpoints %q", m, s, limit, bps)
+
+		got := m.Wordwrap(s, limit, bps)
+		if m == ansi.GraphemeWidth {
+			if g2 := ansi.Wordwrap(s, limit, bps); g2 != got {
+				fail(ht, "ansi.Wordwrap and GraphemeWidth.Wordwrap differ on %q", s)
+			}
+		} else if g2 := ansi.WordwrapWc(s, limit, bps); g2 != got {
+			fail(ht, "ansi.WordwrapWc and WcWidth.Wordwrap differ on %q", s)
+		}
+		if limit < 1 {
+			if got != s {
+				fail(ht, "Wordwrap(%q, %d) = %q, want the input", s, limit, got)
+			}
+			count("passthrough")
+			return
+		}
+		// Every non-whitespace rune, in order, with its style; every sequence, in order.
+		in, out := nonSpace(styled(s)), nonSpace(styled(got))
+		if !sameStyled(in, out) {
+			fail(ht, "Wordwrap(%q, %d, %q) = %q changes the text or styles:\n in  %s\n out %s", s, limit, bps, got, showStyled(in), showStyled(out))
+		}
+		if !reflect.DeepEqual(sequences(s), sequences(got)) {
+			fail(ht, "Wordwrap(%q, %d, %q) = %q changes the sequences", s, limit, bps, got)
+		}
+		if strings.Count(got, "\n") < strings.Count(s, "\n") {
+			fail(ht, "Wordwrap(%q, %d, %q) = %q loses newlines", s, limit, bps, got)
+		}
+		// Lines within the limit, unless the line ends in a word at least as wide as the
+		// limit (a word is never split; x-ansi/10 for the exact-width case) or holds a
+		// breakpoint (x-ansi/9); lines of the input starting with a space are not judged
+		// (x-ansi/19).
+		if hasLeadingSpace(s) {
+			count("leading-space")
+			return
+		}
+		if spaceSequenceSpace(toks) {
+			count("space-sequence-space") // x-ansi/21
+			return
+		}
+		for _, line := range strings.Split(got, "\n") {
+			w := m.StringWidth(line)
+			if w <= limit {
+				continue
+			}
+			switch {
+			case strings.ContainsAny(ansi.Strip(line), "-"+bps):
+				count("breakpoint-line")
+			case lastWordWidth(line, bps) >= limit:
+				count("long-word")
+			default:
+				fail(ht, "Wordwrap(%q, %d, %q) = %q: line %q is %d cells wide", s, limit, bps, got, line, w)
+			}
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- wrapping
+
+func TestHegelWrapKeepsLinesWithinTheLimit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := pick(ht, []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth})
+		hyphen := chance(ht, 40)
+		spaces := chance(ht, 75)
+		cfg := docCfg{seqs: true, sgrOnly: true, spaces: spaces, newlines: spaces, hyphen: hyphen, wcSafe: m == ansi.WcWidth, nbsp: true}
+		toks := genDoc(ht, cfg)
+		s := join(toks)
+		limit := n(ht, 0, 6)
+		bps := pick(ht, []string{"", "", "Z", "0"})
+		note(ht, "method %d input %q limit %d breakpoints %q", m, s, limit, bps)
+
+		got := m.Wrap(s, limit, bps)
+		if m == ansi.GraphemeWidth {
+			if g2 := ansi.Wrap(s, limit, bps); g2 != got {
+				fail(ht, "ansi.Wrap and GraphemeWidth.Wrap differ on %q", s)
+			}
+		} else if g2 := ansi.WrapWc(s, limit, bps); g2 != got {
+			fail(ht, "ansi.WrapWc and WcWidth.Wrap differ on %q", s)
+		}
+		if limit < 1 {
+			if got != s {
+				fail(ht, "Wrap(%q, %d) = %q, want the input", s, limit, got)
+			}
+			count("passthrough")
+			return
+		}
+		if maxCluster(toks, m) > limit {
+			count("cluster-wider-than-limit") // x-ansi/12
+			return
+		}
+		in, out := nonSpace(styled(s)), nonSpace(styled(got))
+		if !sameStyled(in, out) {
+			fail(ht, "Wrap(%q, %d, %q) = %q changes the text or styles:\n in  %s\n out %s", s, limit, bps, got, showStyled(in), showStyled(out))
+		}
+		if !reflect.DeepEqual(sequences(s), sequences(got)) {
+			fail(ht, "Wrap(%q, %d, %q) = %q changes the sequences", s, limit, bps, got)
+		}
+		if hasLeadingSpace(s) {
+			count("leading-space") // x-ansi/19
+			return
+		}
+		if spaceSequenceSpace(toks) {
+			count("space-sequence-space") // x-ansi/21
+			return
+		}
+		if strings.Count(got, "\n") < strings.Count(s, "\n") {
+			fail(ht, "Wrap(%q, %d, %q) = %q loses newlines", s, limit, bps, got)
+		}
+		lines := strings.Split(got, "\n")
+		for i, line := range lines {
+			w := m.StringWidth(line)
+			if w <= limit {
+				continue
+			}
+			// A breakpoint is written, with the whitespace before it, without checking the
+			// limit (x-ansi/8): the line holds one, or the next non-empty line starts with one.
+			next := ""
+			for j := i + 1; j < len(lines) && next == ""; j++ {
+				next = ansi.Strip(lines[j])
+			}
+			if strings.ContainsAny(ansi.Strip(line), "-"+bps) || next != "" && strings.ContainsAny(next[:1], "-"+bps) {
+				count("breakpoint-line")
+				continue
+			}
+			fail(ht, "Wrap(%q, %d, %q) = %q: line %q is %d cells wide", s, limit, bps, got, line, w)
+		}
+		// Without whitespace or breakpoints, Wrap is a hard wrap.
+		if !spaces && !hyphen && !strings.ContainsAny(ansi.Strip(s), bps+"\u00a0") {
+			hw := m.Hardwrap(s, limit, false)
+			if !sameStyled(styled(got), styled(hw)) {
+				fail(ht, "Wrap(%q, %d) = %q, Hardwrap %q", s, limit, got, hw)
+			}
+			count("hardwrap-equal")
+		}
+		count("ok")
+	})
+}
