+// ---------------------------------------------------------------- arbitrary input
+
+var arbitraryRunes = []rune{
+	0x1b, '[', ']', 'P', '_', '\\', ';', ':', '?', '<', '$', ' ', 'm', 'h', 'q', '0', '1', '9', 'a', 'Z', '~',
+	'\a', '\n', '\r', 0x18, 0x7f, 0x9b, 0x9c, 0x9d, 0x90,
+	'\u00e9', '\u65e5', '\U0001F600', '\u0301', '\u200d', '\ufe0f', '\u20e3', '\u00a0', '\u3000', '-',
+}
+
+// csiParamCount counts the separators of the longest CSI parameter list in s (x-ansi/1 gate).
+func csiParamCount(s string) int {
+	best := 0
+	for i := 0; i < len(s); i++ {
+		if !(s[i] == 0x9b || s[i] == 0x1b && i+1 < len(s) && s[i+1] == '[') {
+			continue
+		}
+		c := 0
+		for j := i + 1; j < len(s) && (s[j] < 0x40 || s[j] > 0x7e); j++ {
+			if s[j] == ';' || s[j] == ':' {
+				c++
+			}
+		}
+		if c > best {
+			best = c
+		}
+	}
+	return best
+}
+
+func TestHegelArbitraryTextIsDecodedWithoutLossOrPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var sb strings.Builder
+		for i := n(ht, 0, 30); i > 0; i-- {
+			sb.WriteRune(pick(ht, arbitraryRunes))
+		}
+		s := sb.String()
+		note(ht, "input %q", s)
+		if csiParamCount(s) >= parser.MaxParamsSize-1 {
+			count("too-many-params") // x-ansi/1
+			return
+		}
+		for _, m := range []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth} {
+			var back strings.Builder
+			width := 0
+			for _, p := range decodeAll(s, m) {
+				back.WriteString(p.s)
+				width += p.w
+			}
+			if back.String() != s {
+				fail(ht, "decoded pieces of %q join to %q", s, back.String())
+			}
+			if !utf8.ValidString(s) {
+				continue
+			}
+			// Widths add up unless a cluster starts with an ASCII character the decoder
+			// takes on its own (x-ansi/5).
+			if w := m.StringWidth(s); w != width {
+				count("split-cluster")
+			}
+		}
+		parseEvents(s)
+		plain := ansi.Strip(s)
+		if ansi.StringWidth(plain) != ansi.StringWidth(s) {
+			count("strip-width-differs")
+		}
+		limit := n(ht, 0, 5)
+		for _, m := range []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth} {
+			m.Truncate(s, limit, ".")
+			m.TruncateLeft(s, limit, ".")
+			m.Cut(s, limit, limit+2)
+			m.Hardwrap(s, limit, false)
+			m.Wordwrap(s, limit, "")
+			m.Wrap(s, limit, "")
+		}
+		ansi.ByteToGraphemeRange(s, n(ht, 0, len(s)), n(ht, 0, len(s)))
+		count("ok")
+	})
+}
