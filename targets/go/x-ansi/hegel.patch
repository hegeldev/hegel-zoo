+package ansi_test
+
+// One narrow property per recorded bug (bugs.toml), named after what it tests: random contents
+// in the bug's shape region, checked with the wide properties' check functions so that a
+// failure names the bug. Under HEGEL_NO_KNOWN=1 each draws the region next to the shape
+// instead and must pass.
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/ansi/parser"
+	"hegel.dev/go/hegel"
+)
+
+// narrowCfg: the surroundings of a sequence shape: every token kind, the sequences past the
+// recorded shapes.
+var narrowCfg = docCfg{seqs: true, plainSeqs: true, spaces: true, newlines: true, ctrls: true, hyphen: true, nbsp: true, eightBit: true}
+
+// docCasesAround: a method and a document with one token of middle in narrow surroundings.
+func docCasesAround(cfg docCfg, middle hegel.Generator[tok]) hegel.Generator[docCase] {
+	return hegel.Composite(func(tc hegel.TestCase) docCase {
+		return docCase{m: hegel.Draw(tc, methods), toks: hegel.Draw(tc, docsAround(cfg, middle))}
+	})
+}
+
+// textCase is a docCase with a token boundary for checkStrip.
+type textCase struct {
+	m    ansi.Method
+	toks []tok
+	k    int
+}
+
+func (c textCase) GoString() string {
+	return fmt.Sprintf("method %d input %q split %d", c.m, join(c.toks), c.k)
+}
+
+func textCasesAround(cfg docCfg, middle hegel.Generator[tok]) hegel.Generator[textCase] {
+	return hegel.Composite(func(tc hegel.TestCase) textCase {
+		return textCase{m: hegel.Draw(tc, methods), toks: hegel.Draw(tc, docsAround(cfg, middle)), k: hegel.Draw(tc, positions)}
+	})
+}
+
+// clusterToks: the tokens of a cluster table.
+func clusterToks(table []cl) hegel.Generator[tok] { return hegel.Map(hegel.SampledFrom(table), cl.tok) }
+
+// clustersWhere: the entries of the clusters table satisfying pred.
+func clustersWhere(pred func(cl) bool) []cl {
+	var out []cl
+	for _, c := range clusters {
+		if pred(c) {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+var (
+	// letters: the one-cell ASCII clusters.
+	letters = clustersWhere(func(c cl) bool { return c.s[0] < 0x80 && c.w == 1 && c.wc == 1 })
+	// wideClusters: two cells wide under both methods.
+	wideClusters = clustersWhere(func(c cl) bool { return c.w >= 2 && c.wc >= 2 })
+	// unsafeWcClusters: grapheme and wc widths differ.
+	unsafeWcClusters = clustersWhere(func(c cl) bool { return c.w != c.wc })
+	nbspCl           = cl{string(noBreakSpace), 1, 1}
+)
+
+// withLead puts a token in front of a document.
+func withLead(lead tok) func([]tok) []tok {
+	return func(toks []tok) []tok { return concat([]tok{lead}, toks) }
+}
+
+// afterNewline ends a non-empty document with a newline, so that what follows starts a line.
+func afterNewline(toks []tok) []tok {
+	if len(toks) > 0 {
+		return concat(toks, []tok{ctrlTok("\n")})
+	}
+	return toks
+}
+
+// ---------------------------------------------------------------- the parameter buffer (x-ansi/1, /2)
+
+// paramHeavySeqs: a CSI or DCS with the given parameter lists, otherwise past the shapes.
+func paramHeavySeqs(params hegel.Generator[[]paramSpec]) hegel.Generator[tok] {
+	return weighted(
+		choice[tok]{2, csisFrom(csiParts{eightBitOf(narrowCfg), maybe(25, many(marks, 1, 1)), params, hegel.Just(byte(0))})},
+		choice[tok]{1, dcssWith(narrowCfg, params, payloadsOf(asciiPayloadChars))},
+	)
+}
+
+var (
+	// longParamLists: beyond the parser's buffer (x-ansi/1); within it under HEGEL_NO_KNOWN=1.
+	longParamLists = shaped(Known.bufferParams,
+		many(paramSpecs, parser.MaxParamsSize+1, parser.MaxParamsSize+8),
+		many(paramSpecs, 1, parser.MaxParamsSize-1))
+	longParamCases = docCasesAround(narrowCfg, paramHeavySeqs(longParamLists))
+	// bufferSizedParamLists: exactly the buffer (x-ansi/2).
+	bufferSizedParamLists = shaped(Known.bufferParams,
+		many(paramSpecs, parser.MaxParamsSize, parser.MaxParamsSize),
+		many(paramSpecs, 1, parser.MaxParamsSize-1))
+	bufferSizedCases = docCasesAround(narrowCfg, paramHeavySeqs(bufferSizedParamLists))
+)
+
+// TestHegelDecodeSequenceKeepsTheBufferOnLongParameterLists: a CSI or DCS with more parameters
+// than the parser's buffer decodes to the first MaxParamsSize of them (x-ansi/1 indexes past
+// the buffer and panics). Past the shape: lists within the buffer.
+func TestHegelDecodeSequenceKeepsTheBufferOnLongParameterLists(t *testing.T) {
+	property(t, func(ht *hegel.T) {
