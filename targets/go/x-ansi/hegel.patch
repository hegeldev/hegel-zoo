+// ---------------------------------------------------------------- pins
+
+func csiWithParams(k int) string {
+	parts := make([]string, k)
+	for i := range parts {
+		parts[i] = "1"
+	}
+	return "\x1b[" + strings.Join(parts, ";") + "m"
+}
+
+// x-ansi/1: DecodeSequence indexes past the parser's parameter buffer.
+func TestHegelPinDecodeSequenceWithManyParameters(t *testing.T) {
+	defer guard(t)
+	s := csiWithParams(parser.MaxParamsSize + 1)
+	p := ansi.NewParser()
+	seq, _, k, _ := ansi.DecodeSequence([]byte(s), ansi.NormalState, p)
+	if string(seq) != s || k != len(s) {
+		t.Fatalf("DecodeSequence(%q) = %q, %d", s, seq, k)
+	}
+	if got := len(p.Params()); got != parser.MaxParamsSize {
+		t.Fatalf("%d parameters kept of %d, buffer %d", got, parser.MaxParamsSize+1, parser.MaxParamsSize)
+	}
+}
+
+// x-ansi/2: a sequence with exactly as many parameters as the buffer loses the last one.
+func TestHegelPinParameterBufferSizedSequence(t *testing.T) {
+	defer guard(t)
+	s := csiWithParams(parser.MaxParamsSize)
+	p := ansi.NewParser()
+	ansi.DecodeSequence([]byte(s), ansi.NormalState, p)
+	if got := len(p.Params()); got != parser.MaxParamsSize {
+		t.Errorf("DecodeSequence kept %d of %d parameters", got, parser.MaxParamsSize)
+	}
+	ev := parseEvents(s)
+	want := fmt.Sprintf("csi %#x %s", int('m'), paramsText(packParams(s[2:len(s)-1])))
+	if len(ev) != 1 || ev[0] != want {
+		t.Errorf("Parser events %q, want [%q]", ev, want)
+	}
+}
+
+// x-ansi/3: a 0x9C byte inside a UTF-8 character ends a control string (upstream #848).
+func TestHegelPinControlStringWithUTF8ContainingST(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"\x1b]2;\u00dc\x07", "\x1b]0;\u2733\x1b\\", "\x1bPq\u00dc\x1b\\"} {
+		p := ansi.NewParser()
+		seq, _, k, _ := ansi.DecodeSequence(s, ansi.NormalState, p)
+		if seq != s || k != len(s) {
+			t.Errorf("DecodeSequence(%q) = %q (%d bytes)", s, seq, k)
+		}
+		if got := ansi.Strip(s); got != "" {
+			t.Errorf("Strip(%q) = %q", s, got)
+		}
+		if got := ansi.StringWidth(s); got != 0 {
+			t.Errorf("StringWidth(%q) = %d", s, got)
+		}
+	}
+	ev := parseEvents("\x1b]2;\u00dc\x07x")
+	want := []string{"osc 2 \"2;\\u00dc\"", "print x"}
+	if !reflect.DeepEqual(ev, want) {
+		t.Errorf("Parser events %q, want %q", ev, want)
+	}
+}
+
+// x-ansi/4: a private marker after the parameters: the parser dispatches the sequence, the
+// decoder rejects it and lets "?m" print.
+func TestHegelPinPrivateMarkerAfterParameters(t *testing.T) {
+	defer guard(t)
+	s := "\x1b[1?mx"
+	p := ansi.NewParser()
+	seq, _, k, _ := ansi.DecodeSequence(s, ansi.NormalState, p)
+	ev := parseEvents(s)
+	decoderTookIt := seq == "\x1b[1?m" && k == 5
+	parserTookIt := len(ev) == 2 && strings.HasPrefix(ev[0], "csi")
+	if decoderTookIt != parserTookIt {
+		t.Fatalf("DecodeSequence(%q) = %q (%d bytes) but the Parser reports %q", s, seq, k, ev)
+	}
+}
+
+// x-ansi/5: a grapheme cluster that starts with an ASCII character is split by the decoder,
+// and Truncate returns a keycap wider than the length.
+func TestHegelPinClustersStartingWithASCII(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"e\u0301", "1\ufe0f\u20e3", "#\ufe0f\u20e3"} {
+		seq, _, _, _ := ansi.DecodeSequence(s, ansi.NormalState, nil)
+		if seq != s {
+			t.Errorf("DecodeSequence(%q) = %q, want the whole cluster", s, seq)
+		}
+	}
+	s := "1\ufe0f\u20e3x"
+	if w := ansi.StringWidth(s); w != 3 {
+		t.Fatalf("StringWidth(%q) = %d", s, w)
+	}
+	for _, length := range []int{1, 2} {
+		got := ansi.Truncate(s, length, "")
+		if w := ansi.StringWidth(got); w > length {
+			t.Errorf("Truncate(%q, %d) = %q is %d cells wide", s, length, got, w)
+		}
+	}
+}
+
+// x-ansi/6: TruncateWc decides whether the text fits with grapheme widths.
+func TestHegelPinTruncateWcFitsCheck(t *testing.T) {
+	defer guard(t)
+	fam := "\U0001F468\u200d\U0001F469\u200d\U0001F467"
+	if w := ansi.StringWidthWc(fam); w != 6 {
+		t.Fatalf("StringWidthWc = %d", w)
+	}
+	got := ansi.TruncateWc(fam, 3, "")
+	if w := ansi.StringWidthWc(got); w > 3 {
+		t.Errorf("TruncateWc(%q, 3) = %q is %d cells wide under WcWidth", fam, got, w)
+	}
+}
+
+// x-ansi/7: CutWc truncates to `left` instead of removing `left` cells.
+func TestHegelPinCutWc(t *testing.T) {
+	defer guard(t)
+	if got := ansi.CutWc("abcdef", 2, 4); got != "cd" {
+		t.Errorf("CutWc(%q, 2, 4) = %q, want %q", "abcdef", got, "cd")
+	}
+	if got := ansi.WcWidth.Cut("abcdef", 2, 4); got != "cd" {
+		t.Errorf("WcWidth.Cut(%q, 2, 4) = %q, want %q", "abcdef", got, "cd")
+	}
+}
+
+// x-ansi/8: Wrap keeps a breakpoint on a full line (upstream #785).
+func TestHegelPinWrapBreakpointOnAFullLine(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		s     string
+		limit int
+		bps   string
+	}{{"ab-", 2, ""}, {"foo bar, fo", 7, ","}, {"a-b", 1, ""}, {"a  0b", 1, "0"}} {
+		got := ansi.Wrap(c.s, c.limit, c.bps)
+		for _, line := range strings.Split(got, "\n") {
+			if w := ansi.StringWidth(line); w > c.limit {
+				t.Errorf("Wrap(%q, %d, %q) = %q: line %q is %d cells wide", c.s, c.limit, c.bps, got, line, w)
+			}
+		}
+	}
+}
+
+// x-ansi/9: Wordwrap writes a breakpoint without checking the limit.
+func TestHegelPinWordwrapBreakpointBeyondTheLimit(t *testing.T) {
+	defer guard(t)
+	got := ansi.Wordwrap("ab-cd-ef", 5, "")
+	if want := "ab-\ncd-ef"; got != want {
+		t.Errorf("Wordwrap(%q, 5) = %q, want %q", "ab-cd-ef", got, want)
+	}
+}
+
+// x-ansi/10: a word exactly as wide as the limit is never moved to its own line.
+func TestHegelPinWordwrapWordAsWideAsTheLimit(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct{ s, want string }{{" cdefg", "\ncdefg"}, {"a-bcdef", "a-\nbcdef"}} {
+		if got := ansi.Wordwrap(c.s, 5, ""); got != c.want {
+			t.Errorf("Wordwrap(%q, 5) = %q, want %q", c.s, got, c.want)
+		}
+	}
+}
+
+// x-ansi/11: Wordwrap measures whitespace in bytes.
+func TestHegelPinWordwrapMeasuresSpacesInBytes(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		s     string
+		limit int
+		want  string
+	}{{"a\u3000b\u3000c", 4, "a\u3000b\nc"}, {"a\u2003b\u2003c", 4, "a\u2003b\u2003c"}} {
+		if got := ansi.Wordwrap(c.s, c.limit, ""); got != c.want {
+			t.Errorf("Wordwrap(%q, %d) = %q, want %q", c.s, c.limit, got, c.want)
+		}
+	}
+}
+
+// x-ansi/12: a cluster wider than the limit starts with an empty line.
+func TestHegelPinClusterWiderThanTheLimit(t *testing.T) {
+	defer guard(t)
+	for _, f := range []struct {
+		name string
+		fn   func(string, int) string
+	}{
+		{"Hardwrap", func(s string, l int) string { return ansi.Hardwrap(s, l, false) }},
+		{"Wrap", func(s string, l int) string { return ansi.Wrap(s, l, "") }},
+	} {
+		if got := f.fn("\u65e5", 1); got != "\u65e5" {
+			t.Errorf("%s(%q, 1) = %q", f.name, "\u65e5", got)
+		}
+		if got := f.fn("\u65e5\u65e5", 1); got != "\u65e5\n\u65e5" {
+			t.Errorf("%s(%q, 1) = %q", f.name, "\u65e5\u65e5", got)
+		}
+	}
+}
+
+// x-ansi/13: Hardwrap drops a non-ASCII space at the start of the text but keeps an ASCII one.
+func TestHegelPinHardwrapLeadingNonASCIISpace(t *testing.T) {
+	defer guard(t)
+	if got := ansi.Hardwrap(" foo", 4, false); got != " foo" {
+		t.Fatalf("Hardwrap(%q) = %q", " foo", got)
+	}
+	for _, s := range []string{"\u00a0foo", "\u3000foo", "a\n\u00a0foo"} {
+		if got := ansi.Hardwrap(s, 5, false); got != s {
+			t.Errorf("Hardwrap(%q, 5, false) = %q", s, got)
+		}
+	}
+}
+
+// x-ansi/14: XParseColor scales rgb: components as if they always had two digits, and reads
+// invalid hex as zero.
+func TestHegelPinXParseColorScaling(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		s    string
+		want [3]int
+	}{{"rgb:f/f/f", [3]int{255, 255, 255}}, {"rgb:fff/fff/fff", [3]int{255, 255, 255}}, {"rgb:1/2/3", [3]int{0x11, 0x22, 0x33}}} {
+		got := ansi.XParseColor(c.s)
+		if got == nil {
+			t.Errorf("XParseColor(%q) = nil", c.s)
+			continue
+		}
+		r, g, b := rgb8(got)
+		if [3]int{r, g, b} != c.want {
+			t.Errorf("XParseColor(%q) = %v, want %v", c.s, [3]int{r, g, b}, c.want)
+		}
+	}
+	if got := ansi.XParseColor("rgb:zz/0/0"); got != nil {
+		t.Errorf("XParseColor(%q) = %v, want nil", "rgb:zz/0/0", got)
+	}
+}
+
+// x-ansi/15: ReadStyleColor truncates colour components modulo 256.
+func TestHegelPinReadStyleColorOutOfRange(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"38;5;256", "38;2;300;0;0"} {
+		p := ansi.NewParser()
+		ansi.DecodeSequence("\x1b["+text+"m", ansi.NormalState, p)
+		var c color.Color
+		k := ansi.ReadStyleColor(p.Params(), &c)
+		if k != 0 || c != nil {
+			t.Errorf("ReadStyleColor(%q) read %d parameters and gave %v, want a rejection", text, k, c)
+		}
+	}
+}
+
+// x-ansi/16: ByteToGraphemeRange counts escape-sequence bytes and controls as cells.
+func TestHegelPinByteToGraphemeRangeWithSequences(t *testing.T) {
+	defer guard(t)
+	s := "\x1b[31mab"
+	start, stop := ansi.ByteToGraphemeRange(s, 5, 7)
+	if got := ansi.Cut(s, start, stop); ansi.Strip(got) != "ab" {
+		t.Errorf("ByteToGraphemeRange(%q, 5, 7) = %d, %d; Cut gives %q", s, start, stop, got)
+	}
+	s = "a\nb"
+	start, stop = ansi.ByteToGraphemeRange(s, 2, 3)
+	if got := ansi.Cut(s, start, stop); got != "b" {
+		t.Errorf("ByteToGraphemeRange(%q, 2, 3) = %d, %d; Cut gives %q", s, start, stop, got)
+	}
+}
+
+// x-ansi/17: Convert16 does not return the basic colour for the exact RGB of colours 7 and 8.
+func TestHegelPinConvert16BasicGreys(t *testing.T) {
+	defer guard(t)
+	for _, i := range []int{7, 8} {
+		if got := ansi.Convert16(paletteRGB(i)); int(got) != i {
+			t.Errorf("Convert16(%v) = %d, want %d", paletteRGB(i), got, i)
+		}
+	}
+}
+
+// x-ansi/18: a UTF-8 character inside an SOS, PM or APC string ends the string in the
+// table-driven parser (the decoder keeps it).
+func TestHegelPinUTF8InsideSosPmApcStrings(t *testing.T) {
+	defer guard(t)
+	s := "\x1b^a\u00e9b\x1b\\x"
+	if got := ansi.Strip(s); got != "x" {
+		t.Errorf("Strip(%q) = %q", s, got)
+	}
+	if got := ansi.StringWidth(s); got != 1 {
+		t.Errorf("StringWidth(%q) = %d", s, got)
+	}
+	if got := ansi.Truncate(s, 1, ""); got != s {
+		t.Errorf("Truncate(%q, 1) = %q", s, got)
+	}
+	ev := parseEvents(s)
+	want := []string{"pm \"a\u00e9b\"", fmt.Sprintf("esc %#x", int('\\')), "print x"}
+	if !reflect.DeepEqual(ev, want) {
+		t.Errorf("Parser events %q, want %q", ev, want)
+	}
+	if seq, _, k, _ := ansi.DecodeSequence(s, ansi.NormalState, nil); seq != s[:len(s)-1] || k != len(s)-1 {
+		t.Errorf("DecodeSequence(%q) = %q", s, seq)
+	}
+}
+
+// x-ansi/19: leading spaces confuse Wrap and Wordwrap.
+func TestHegelPinWrapLeadingSpaces(t *testing.T) {
+	defer guard(t)
+	if got := ansi.Wrap(" abc", 3, ""); got != " abc" && got != "abc" {
+		t.Errorf("Wrap(%q, 3) = %q", " abc", got)
+	}
+	for _, f := range []struct {
+		name string
+		fn   func(string, int) string
+	}{
+		{"Wrap", func(s string, l int) string { return ansi.Wrap(s, l, "") }},
+		{"Wordwrap", func(s string, l int) string { return ansi.Wordwrap(s, l, "") }},
+	} {
+		if got := f.fn("  ab", 3); strings.HasPrefix(got, "\n") {
+			t.Errorf("%s(%q, 3) = %q starts with an empty line", f.name, "  ab", got)
+		}
+	}
+}
+
+// x-ansi/20: with two private markers the Parser keeps the first, the decoder the last.
+func TestHegelPinTwoPrivateMarkers(t *testing.T) {
+	defer guard(t)
+	s := "\x1b[=>1P"
+	p := ansi.NewParser()
+	ansi.DecodeSequence(s, ansi.NormalState, p)
+	dec := ansi.Cmd(p.Command()).Prefix()
+	ev := parseEvents(s)
+	want := fmt.Sprintf("csi %#x [1]", ansi.Command('>', 0, 'P'))
+	if len(ev) != 1 || ev[0] != want || dec != '>' {
+		t.Errorf("Parser events %q (want [%q]), decoder prefix %q", ev, want, dec)
+	}
+}
+
+// x-ansi/21: whitespace followed by an escape sequence is flushed past the limit: Wordwrap at
+// the end of the text, Wrap when more whitespace follows the sequence.
+func TestHegelPinWhitespaceBeforeASequence(t *testing.T) {
+	defer guard(t)
+	s := "ab \x1b[1m"
+	got := ansi.Wordwrap(s, 2, "")
+	if w := ansi.StringWidth(got); w > 2 {
+		t.Errorf("Wordwrap(%q, 2) = %q is %d cells wide", s, got, w)
+	}
+	s = "a  \x1b[m "
+	got = ansi.Wrap(s, 2, "")
+	for _, line := range strings.Split(got, "\n") {
+		if w := ansi.StringWidth(line); w > 2 {
+			t.Errorf("Wrap(%q, 2) = %q: line %q is %d cells wide", s, got, line, w)
+		}
+	}
+}
