+// x-ansi/3: a 0x9C byte inside a UTF-8 character ends a control string (upstream #848).
+func TestHegelPinControlStringWithUTF8ContainingST(t *testing.T) {
+	defer guard(t)
+	for _, s := range []string{"\x1b]2;\u00dc\x07", "\x1b]0;\u2733\x1b\\", "\x1bPq\u00dc\x1b\\"} {
+		p := ansi.NewParser()
+		seq, _, k, _ := ansi.DecodeSequence(s, ansi.NormalState, p)
+		if seq != s || k != len(s) {
+			t.Errorf("DecodeSequence(%q) = %q (%d bytes)", s, seq, k)
+		}
+		if got := ansi.Strip(s); got != "" {
+			t.Errorf("Strip(%q) = %q", s, got)
+		}
+		if got := ansi.StringWidth(s); got != 0 {
+			t.Errorf("StringWidth(%q) = %d", s, got)
+		}
+	}
+	ev := parseEvents("\x1b]2;\u00dc\x07x")
+	want := []string{"osc 2 \"2;\\u00dc\"", "print x"}
+	if !reflect.DeepEqual(ev, want) {
+		t.Errorf("Parser events %q, want %q", ev, want)
+	}
+}
