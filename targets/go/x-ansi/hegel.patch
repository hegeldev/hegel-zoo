+// ---------------------------------------------------------------- Strip and the widths
+
+type stripCase struct {
+	toks []tok
+	k    int // a token boundary (modulo the count) to check that widths add up
+}
+
+func (c stripCase) GoString() string { return fmt.Sprintf("input %q split %d", join(c.toks), c.k) }
+
+var stripCases = hegel.Composite(func(tc hegel.TestCase) stripCase {
+	return stripCase{toks: hegel.Draw(tc, docsOf(decodeCfg)), k: hegel.Draw(tc, positions)}
+})
+
+// checkStrip: Strip gives the text tokens, the widths add up over the tokens, the method
+// forms agree with the functions, and widths are additive at the token boundary k.
+func checkStrip(ht *hegel.T, toks []tok, k int, known shapes) {
+	s := join(toks)
+	if got, want := ansi.Strip(s), plainText(toks); got != want {
+		mismatch(ht, known, "Strip(%q) = %q, want %q", s, got, want)
+	}
+	if got, want := ansi.StringWidth(s), totalWidth(toks, ansi.GraphemeWidth); got != want {
+		mismatch(ht, known, "StringWidth(%q) = %d, want %d", s, got, want)
+	}
+	if got, want := ansi.StringWidthWc(s), totalWidth(toks, ansi.WcWidth); got != want {
+		mismatch(ht, known, "StringWidthWc(%q) = %d, want %d", s, got, want)
+	}
+	if got, want := ansi.GraphemeWidth.StringWidth(s), ansi.StringWidth(s); got != want {
+		mismatch(ht, known, "GraphemeWidth.StringWidth(%q) = %d, StringWidth %d", s, got, want)
+	}
+	if got, want := ansi.WcWidth.StringWidth(s), ansi.StringWidthWc(s); got != want {
+		mismatch(ht, known, "WcWidth.StringWidth(%q) = %d, StringWidthWc %d", s, got, want)
+	}
+	k = at(k, len(toks)+1)
+	a, b := join(toks[:k]), join(toks[k:])
+	if got, want := ansi.StringWidth(a)+ansi.StringWidth(b), ansi.StringWidth(s); got != want {
+		mismatch(ht, known, "StringWidth(%q)+StringWidth(%q) = %d, whole %d", a, b, got, want)
+	}
+}
+
+// TestHegelStripAndWidthsFollowTheTokens: Strip and the widths follow the token list. Drawn
+// shapes: a 0x9C byte inside a UTF-8 character (x-ansi/3), UTF-8 inside SOS/PM/APC strings
+// (x-ansi/18).
+func TestHegelStripAndWidthsFollowTheTokens(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, stripCases)
+		checkStrip(ht, c.toks, c.k, tableShapes(c.toks))
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- truncation
+
+var tails = pick("", ".", "\u2026", "..", "\u65e5")
+
+type truncateCase struct {
+	m          ansi.Method
+	toks       []tok
+	length     int
+	tail       string
+	left       int
+	prefix     string
+	cutL, cutR int
+}
+
+func (c truncateCase) GoString() string {
+	return fmt.Sprintf("method %d input %q length %d tail %q left %d prefix %q cut %d..%d", c.m, join(c.toks), c.length, c.tail, c.left, c.prefix, c.cutL, c.cutR)
+}
+
+// truncateCfg: the documents of the Truncate property; under HEGEL_NO_KNOWN=1 no cluster whose
+// widths differ under WcWidth (x-ansi/6).
+func truncateCfg(m ansi.Method) docCfg {
+	return docCfg{seqs: true, spaces: true, newlines: true, nbsp: true, wcSafe: Known.zwjWc && m == ansi.WcWidth}
+}
+
+// cutLeftsOf: the left edge of a Cut; under HEGEL_NO_KNOWN=1 none under WcWidth (x-ansi/7).
+func cutLeftsOf(m ansi.Method) hegel.Generator[int] {
+	if Known.cutWcLeft && m == ansi.WcWidth {
+		return hegel.Just(0)
+	}
+	return hegel.Integers(0, 6)
+}
+
+var truncateCases = hegel.Composite(func(tc hegel.TestCase) truncateCase {
+	m := hegel.Draw(tc, methods)
+	return truncateCase{
+		m:      m,
+		toks:   hegel.Draw(tc, docsOf(truncateCfg(m))),
+		length: hegel.Draw(tc, hegel.Integers(0, 8)),
+		tail:   hegel.Draw(tc, tails),
+		left:   hegel.Draw(tc, hegel.Integers(0, 8)),
+		prefix: hegel.Draw(tc, tails),
+		cutL:   hegel.Draw(tc, cutLeftsOf(m)),
+		cutR:   hegel.Draw(tc, hegel.Integers(0, 8)),
+	}
+})
+
+// truncateShapes: the table shapes and, under WcWidth, a cluster whose widths differ (x-ansi/6).
+func truncateShapes(c truncateCase) shapes {
+	sh := tableShapes(c.toks)
+	sh.add("x-ansi/6", c.m == ansi.WcWidth && unsafeWc(c.toks))
+	return sh
+}
+
+// checkTruncate: Truncate and TruncateLeft follow their models and the function forms agree
+// with the method forms.
+func checkTruncate(ht *hegel.T, c truncateCase, known shapes) {
+	s, m := join(c.toks), c.m
+	got := m.Truncate(s, c.length, c.tail)
+	if want := truncateModel(c.toks, m, c.length, c.tail); got != want {
+		mismatch(ht, known, "Truncate(%q, %d, %q) = %q, want %q", s, c.length, c.tail, got, want)
+	}
+	if ansi.StringWidth(c.tail) <= c.length && m.StringWidth(got) > c.length {
+		mismatch(ht, known, "Truncate(%q, %d, %q) = %q is %d cells wide", s, c.length, c.tail, got, m.StringWidth(got))
+	}
+	if m == ansi.GraphemeWidth {
+		if g2 := ansi.Truncate(s, c.length, c.tail); g2 != got {
+			mismatch(ht, known, "ansi.Truncate and GraphemeWidth.Truncate differ on %q: %q vs %q", s, g2, got)
+		}
+	} else if g2 := ansi.TruncateWc(s, c.length, c.tail); g2 != got {
+		mismatch(ht, known, "ansi.TruncateWc and WcWidth.Truncate differ on %q: %q vs %q", s, g2, got)
+	}
+
+	gotL := m.TruncateLeft(s, c.left, c.prefix)
+	if want := truncateLeftModel(c.toks, m, c.left, c.prefix); gotL != want {
+		mismatch(ht, known, "TruncateLeft(%q, %d, %q) = %q, want %q", s, c.left, c.prefix, gotL, want)
+	}
+	if m == ansi.GraphemeWidth {
+		if g2 := ansi.TruncateLeft(s, c.left, c.prefix); g2 != gotL {
+			mismatch(ht, known, "ansi.TruncateLeft and GraphemeWidth.TruncateLeft differ on %q", s)
+		}
+	} else if g2 := ansi.TruncateLeftWc(s, c.left, c.prefix); g2 != gotL {
+		mismatch(ht, known, "ansi.TruncateLeftWc and WcWidth.TruncateLeft differ on %q", s)
+	}
+}
+
+// checkCut: Cut is a Truncate followed by a TruncateLeft. CutWc with left > 0 is x-ansi/7's
+// shape.
+func checkCut(ht *hegel.T, c truncateCase, known shapes) {
+	s, m := join(c.toks), c.m
+	sh := append(shapes(nil), known...)
+	sh.add("x-ansi/7", m == ansi.WcWidth && c.cutL > 0 && c.cutR > c.cutL)
+	if gotC, want := m.Cut(s, c.cutL, c.cutR), cutModel(c.toks, m, c.cutL, c.cutR); gotC != want {
+		mismatch(ht, sh, "Cut(%q, %d, %d) = %q, want %q", s, c.cutL, c.cutR, gotC, want)
+	}
+}
+
+// TestHegelTruncateFollowsItsModel: Truncate, TruncateLeft and Cut follow the documentation's
+// models under both width methods. Drawn shapes: the string shapes (x-ansi/3, /18), the ZWJ
+// family under WcWidth (x-ansi/6), CutWc with left > 0 (x-ansi/7).
+func TestHegelTruncateFollowsItsModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, truncateCases)
+		known := truncateShapes(c)
+		checkTruncate(ht, c, known)
+		checkCut(ht, c, known)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- hard wrapping
+
+type hardwrapCase struct {
+	m        ansi.Method
+	toks     []tok
+	limit    int
+	preserve bool
+}
+
+func (c hardwrapCase) GoString() string {
+	return fmt.Sprintf("method %d input %q limit %d preserveSpace %v", c.m, join(c.toks), c.limit, c.preserve)
+}
+
+// hardwrapCfg: the documents of the Hardwrap property, with the no-break space (x-ansi/13)
+// unless its switch is on.
+var hardwrapCfg = docCfg{seqs: true, spaces: true, newlines: true, hyphen: true, nbsp: !Known.nbspHardwrap}
+
+// limitsOf: a wrapping limit of lo to 6 (0 is no wrapping). Under HEGEL_NO_KNOWN=1 the
+// wrappers that split words (splits: Hardwrap, Wrap) get none below the widest cluster of the
+// document (x-ansi/12) and Wordwrap (words) none equal to a word's width (x-ansi/10); 0 when
+// nothing is left.
+func limitsOf(lo int, toks []tok, m ansi.Method, bps string, splits, words bool) hegel.Generator[int] {
+	splits, words = splits && Known.wideCluster, words && Known.longWord
+	if !splits && !words {
+		return hegel.Integers(lo, 6)
+	}
+	widths := wordWidths(toks, m, bps)
+	var ok []int
+	for l := lo; l <= 6; l++ {
+		if splits && l >= 1 && l < maxCluster(toks, m) || words && widths[l] {
+			continue
+		}
+		ok = append(ok, l)
+	}
+	if len(ok) == 0 {
+		return hegel.Just(0)
+	}
+	return hegel.SampledFrom(ok)
+}
+
+var hardwrapCases = hegel.Composite(func(tc hegel.TestCase) hardwrapCase {
+	m := hegel.Draw(tc, methods)
+	toks := hegel.Draw(tc, docsOf(hardwrapCfg))
+	return hardwrapCase{m: m, toks: toks, limit: hegel.Draw(tc, limitsOf(0, toks, m, "", true, false)), preserve: hegel.Draw(tc, chance(40))}
+})
+
+// hardwrapShapes: the table shapes, a cluster wider than the limit (x-ansi/12) and the
+// no-break space without preserveSpace (x-ansi/13).
+func hardwrapShapes(c hardwrapCase) shapes {
+	sh := tableShapes(c.toks)
+	sh.add("x-ansi/12", c.limit >= 1 && maxCluster(c.toks, c.m) > c.limit)
+	sh.add("x-ansi/13", !c.preserve && hasText(c.toks, string(noBreakSpace)))
+	return sh
+}
+
+// checkHardwrap: Hardwrap follows the greedy model and the function form agrees with the
+// method form.
+func checkHardwrap(ht *hegel.T, c hardwrapCase, known shapes) {
+	s, m := join(c.toks), c.m
+	got := m.Hardwrap(s, c.limit, c.preserve)
+	if want := hardwrapModel(c.toks, m, c.limit, c.preserve); got != want {
+		mismatch(ht, known, "Hardwrap(%q, %d, %v) = %q, want %q", s, c.limit, c.preserve, got, want)
+	}
+	if m == ansi.GraphemeWidth {
+		if g2 := ansi.Hardwrap(s, c.limit, c.preserve); g2 != got {
+			mismatch(ht, known, "ansi.Hardwrap and GraphemeWidth.Hardwrap differ on %q", s)
+		}
+	} else if g2 := ansi.HardwrapWc(s, c.limit, c.preserve); g2 != got {
+		mismatch(ht, known, "ansi.HardwrapWc and WcWidth.Hardwrap differ on %q", s)
+	}
+}
+
+// TestHegelHardwrapFollowsTheGreedyModel: Hardwrap lays clusters out greedily. Drawn shapes:
+// the string shapes (x-ansi/3, /18), a cluster wider than the limit (x-ansi/12), the no-break
+// space (x-ansi/13).
+func TestHegelHardwrapFollowsTheGreedyModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hardwrapCases)
+		checkHardwrap(ht, c, hardwrapShapes(c))
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- word wrapping and wrapping
+
+type wrapCase struct {
+	m      ansi.Method
+	hyphen bool
+	spaces bool
+	toks   []tok
+	limit  int
+	bps    string
+}
+
+func (c wrapCase) GoString() string {
+	return fmt.Sprintf("method %d input %q limit %d breakpoints %q", c.m, join(c.toks), c.limit, c.bps)
+}
+
+// wrapCfg: the documents of the Wordwrap and Wrap properties: SGR sequences and hyperlinks,
+// spaces and newlines when spaces is set (the ideographic space among them, x-ansi/11, unless
+// its switch is on), hyphens when hyphen is set.
+func wrapCfg(hyphen, spaces bool) docCfg {
+	return docCfg{seqs: true, sgrOnly: true, spaces: spaces, newlines: spaces, hyphen: hyphen, nbsp: true, wideSpace: spaces && !Known.wideSpace}
+}
+
+var (
+	// breakpointSets: none most of the time, 'Z' or '0'; none under HEGEL_NO_KNOWN=1 (x-ansi/8,
+	// /9: a breakpoint on an overflowing line).
+	breakpointSets = shaped(Known.breakpoints, pick("", "", "Z", "0"), hegel.Just(""))
+	// hyphensOn: hyphens in the text two times in five; never under HEGEL_NO_KNOWN=1.
+	hyphensOn = shaped(Known.breakpoints, chance(40), hegel.Just(false))
+)
+
+// pastLineShapes takes a wrapper's document past the line shapes only recognisable on the
+// result, when their switches are on: spaces at a line start (x-ansi/19), sequences between
+// whitespace and whitespace or the end (x-ansi/21).
+func pastLineShapes(toks []tok) []tok {
+	if Known.leadingSpace {
+		toks = withoutLeadingSpaces(toks)
+	}
+	if Known.spaceSeqSpace {
+		toks = withoutSpaceSeqSpace(toks)
+	}
+	return toks
+}
+
+// wrapCasesWith draws a case for Wordwrap (spaces always, words set) or Wrap (spaces three
+// times in four, splits set): limitsOf keeps the limits past the switched-off shapes.
+func wrapCasesWith(spacesOn hegel.Generator[bool], splits, words bool) hegel.Generator[wrapCase] {
+	return hegel.Composite(func(tc hegel.TestCase) wrapCase {
+		c := wrapCase{m: hegel.Draw(tc, methods), hyphen: hegel.Draw(tc, hyphensOn), spaces: hegel.Draw(tc, spacesOn)}
+		c.toks = pastLineShapes(hegel.Draw(tc, docsOf(wrapCfg(c.hyphen, c.spaces))))
+		c.bps = hegel.Draw(tc, breakpointSets)
+		c.limit = hegel.Draw(tc, limitsOf(0, c.toks, c.m, c.bps, splits, words))
+		return c
+	})
+}
+
+var (
+	wordwrapCases = wrapCasesWith(hegel.Just(true), false, true)
+	wrappingCases = wrapCasesWith(chance(75), true, false)
+)
+
+// lineShapes: the recorded shapes of a wrapper's input that bear on its line widths: a line
+// starting with a space (x-ansi/19), whitespace followed by sequences and whitespace
+// (x-ansi/21), the ideographic space (x-ansi/11, Wordwrap only).
+func lineShapes(c wrapCase, wordwrap bool) shapes {
+	var sh shapes
+	sh.add("x-ansi/19", hasLeadingSpace(join(c.toks)))
+	sh.add("x-ansi/21", spaceSequenceSpace(c.toks))
+	sh.add("x-ansi/11", wordwrap && hasText(c.toks, string(ideographicSpace)))
+	return sh
+}
+
+// checkStylesKept: every non-whitespace rune of the output, in order, carries its input style;
+// every sequence is there in order; no newline is lost.
+func checkStylesKept(ht *hegel.T, name, s, got string, c wrapCase, known shapes) {
+	in, out := nonSpace(styled(s)), nonSpace(styled(got))
+	if !sameStyled(in, out) {
+		mismatch(ht, known, "%s(%q, %d, %q) = %q changes the text or styles:\n in  %s\n out %s", name, s, c.limit, c.bps, got, showStyled(in), showStyled(out))
+	}
+	if !sameStrings(sequences(s), sequences(got)) {
+		mismatch(ht, known, "%s(%q, %d, %q) = %q changes the sequences", name, s, c.limit, c.bps, got)
+	}
+	if strings.Count(got, "\n") < strings.Count(s, "\n") {
+		mismatch(ht, known, "%s(%q, %d, %q) = %q loses newlines", name, s, c.limit, c.bps, got)
+	}
+}
+
+// checkWordwrap: the method and function forms agree; a limit below one passes the text
+// through; the styles and sequences are kept; every line is within the limit unless it ends in
+// a word wider than the limit (a word is never split).
+func checkWordwrap(ht *hegel.T, c wrapCase, known shapes) {
+	s, m := join(c.toks), c.m
+	got := m.Wordwrap(s, c.limit, c.bps)
+	if m == ansi.GraphemeWidth {
+		if g2 := ansi.Wordwrap(s, c.limit, c.bps); g2 != got {
+			mismatch(ht, known, "ansi.Wordwrap and GraphemeWidth.Wordwrap differ on %q", s)
+		}
+	} else if g2 := ansi.WordwrapWc(s, c.limit, c.bps); g2 != got {
+		mismatch(ht, known, "ansi.WordwrapWc and WcWidth.Wordwrap differ on %q", s)
+	}
+	if c.limit < 1 {
+		if got != s {
+			mismatch(ht, known, "Wordwrap(%q, %d) = %q, want the input", s, c.limit, got)
+		}
+		count("passthrough")
+		return
+	}
+	checkStylesKept(ht, "Wordwrap", s, got, c, known)
+	known = append(known, lineShapes(c, true)...)
+	for _, line := range strings.Split(got, "\n") {
+		w := m.StringWidth(line)
+		if w <= c.limit {
+			continue
+		}
+		if lw := lastWordWidth(line, c.bps, m); lw > c.limit {
+			count("long-word") // a word wider than the limit fits nowhere
+			continue
+		} else {
+			sh := append(shapes(nil), known...)
+			sh.add("x-ansi/9", hasBreakpoint(line, c.bps))
+			sh.add("x-ansi/10", lw == c.limit)
+			mismatch(ht, sh, "Wordwrap(%q, %d, %q) = %q: line %q is %d cells wide", s, c.limit, c.bps, got, line, w)
+		}
+	}
+}
+
+// TestHegelWordwrapKeepsWordsAndStyles: Wordwrap keeps every word and its style and every line
+// within the limit. Drawn shapes: a breakpoint on an overflowing line (x-ansi/9), a word exactly
+// as wide as the limit after something (x-ansi/10), the ideographic space (x-ansi/11), leading
+// spaces (x-ansi/19), whitespace before a sequence (x-ansi/21).
+func TestHegelWordwrapKeepsWordsAndStyles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wordwrapCases)
+		checkWordwrap(ht, c, nil)
+		count("ok")
+	})
+}
+
+// checkWrap: as checkWordwrap for Wrap, which splits words: every line is within the limit
+// unless it holds a breakpoint or the next line starts with one (x-ansi/8); without whitespace
+// or breakpoints Wrap is a hard wrap.
+func checkWrap(ht *hegel.T, c wrapCase, known shapes) {
+	s, m := join(c.toks), c.m
+	got := m.Wrap(s, c.limit, c.bps)
+	if m == ansi.GraphemeWidth {
+		if g2 := ansi.Wrap(s, c.limit, c.bps); g2 != got {
+			mismatch(ht, known, "ansi.Wrap and GraphemeWidth.Wrap differ on %q", s)
+		}
+	} else if g2 := ansi.WrapWc(s, c.limit, c.bps); g2 != got {
+		mismatch(ht, known, "ansi.WrapWc and WcWidth.Wrap differ on %q", s)
+	}
+	if c.limit < 1 {
+		if got != s {
+			mismatch(ht, known, "Wrap(%q, %d) = %q, want the input", s, c.limit, got)
+		}
+		count("passthrough")
+		return
+	}
+	known = append(append(shapes(nil), known...), lineShapes(c, false)...)
+	known.add("x-ansi/12", maxCluster(c.toks, m) > c.limit)
+	checkStylesKept(ht, "Wrap", s, got, c, known)
+	lines := strings.Split(got, "\n")
+	for i, line := range lines {
+		w := m.StringWidth(line)
+		if w <= c.limit {
+			continue
+		}
+		// A breakpoint is written, with the whitespace before it, without checking the
+		// limit (x-ansi/8): the line holds one, or the next non-empty line starts with one.
+		next := ""
+		for j := i + 1; j < len(lines) && next == ""; j++ {
+			next = ansi.Strip(lines[j])
+		}
+		sh := append(shapes(nil), known...)
+		sh.add("x-ansi/8", hasBreakpoint(line, c.bps) || next != "" && strings.ContainsAny(next[:1], "-"+c.bps))
+		mismatch(ht, sh, "Wrap(%q, %d, %q) = %q: line %q is %d cells wide", s, c.limit, c.bps, got, line, w)
+	}
+	// Without whitespace or breakpoints, Wrap is a hard wrap.
+	if !c.spaces && !c.hyphen && !strings.ContainsAny(ansi.Strip(s), c.bps+string(noBreakSpace)) {
+		hw := m.Hardwrap(s, c.limit, false)
+		if !sameStyled(styled(got), styled(hw)) {
+			mismatch(ht, known, "Wrap(%q, %d) = %q, Hardwrap %q", s, c.limit, got, hw)
+		}
+		count("hardwrap-equal")
+	}
+}
+
+// TestHegelWrapKeepsLinesWithinTheLimit: Wrap keeps the text and styles and every line within
+// the limit. Drawn shapes: a breakpoint on a full line (x-ansi/8), a cluster wider than the
+// limit (x-ansi/12), leading spaces (x-ansi/19), whitespace before a sequence (x-ansi/21).
+func TestHegelWrapKeepsLinesWithinTheLimit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wrappingCases)
+		checkWrap(ht, c, nil)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- styles
+
+type styleCase struct {
+	steps []styleStep
+	text  string
+}
+
+func (c styleCase) GoString() string {
+	var parts []string
+	for _, s := range c.steps {
+		parts = append(parts, s.params())
+	}
+	return fmt.Sprintf("style %q text %q", "\x1b["+strings.Join(parts, ";")+"m", c.text)
+}
+
+var styleCases = hegel.Composite(func(tc hegel.TestCase) styleCase {
+	return styleCase{steps: hegel.Draw(tc, styleLists), text: hegel.Draw(tc, pick("", "x", "\u65e5"))}
+})
+
+// TestHegelStylesRoundTripThroughTheDecoder: a Style built by its methods writes the table's
+// parameters, Styled wraps the text, and the decoder and ReadStyleColor read the steps back.
+func TestHegelStylesRoundTripThroughTheDecoder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, styleCases)
+		st := renderStyle(c.steps)
+		var parts []string
+		for _, s := range c.steps {
+			parts = append(parts, s.params())
+		}
+		want := "\x1b[" + strings.Join(parts, ";") + "m"
+		got := st.String()
+		if got != want {
+			fail(ht, "Style.String() = %q, want %q", got, want)
+		}
+		if s2 := st.Styled(c.text); s2 != got+c.text+ansi.ResetStyle {
+			fail(ht, "Styled(%q) = %q, want %q", c.text, s2, got+c.text+ansi.ResetStyle)
+		}
+		// Back through the decoder and ReadStyleColor.
+		p := ansi.NewParser()
+		seq, _, k, _ := ansi.DecodeSequence(got, ansi.NormalState, p)
+		if k != len(got) || seq != got {
+			fail(ht, "decoding %q consumed %d of %d bytes", got, k, len(got))
+		}
+		params := p.Params()
+		i := 0
+		for _, step := range c.steps {
+			if i >= len(params) {
+				fail(ht, "%q: parameters run out at step %q", got, step.params())
+			}
+			if step.base() == 0 || step.color.kind == cBasic && step.base() != 58 {
+				// one attribute, possibly with one sub-parameter
+				v, more := params[i].Param(-1), params[i].HasMore()
+				text := strconv.Itoa(v)
+				i++
+				if more {
+					text += ":" + strconv.Itoa(params[i].Param(-1))
+					i++
+				}
+				if text != step.params() {
+					fail(ht, "%q: step %q decoded as %q", got, step.params(), text)
+				}
+				continue
+			}
+			if step.color.kind == cNil {
+				if v := params[i].Param(-1); v != step.base()+1 {
+					fail(ht, "%q: default colour decoded as %d", got, v)
+				}
+				i++
+				continue
+			}
+			var cc color.Color
+			consumed := ansi.ReadStyleColor(params[i:], &cc)
+			wantN := 3
+			if step.color.kind >= cRGB {
+				wantN = 5
+			}
+			if consumed != wantN {
+				fail(ht, "%q: ReadStyleColor read %d parameters at %s, want %d", got, consumed, paramsText(paramsOf(params[i:])), wantN)
+			}
+			var wantC color.Color
+			switch step.color.kind {
+			case cBasic, cIndexed:
+				wantC = ansi.IndexedColor(uint8(step.color.index()))
+			default:
+				r, g, b := rgb8(step.color.color())
+				wantC = color.RGBA{uint8(r), uint8(g), uint8(b), 0xff}
+			}
+			if !sameColor(cc, wantC) {
+				fail(ht, "%q: ReadStyleColor at %s gave %v, want %v", got, paramsText(paramsOf(params[i:])), cc, wantC)
+			}
+			i += consumed
+		}
+		if i != len(params) {
+			fail(ht, "%q: %d parameters left after the steps", got, len(params)-i)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- ReadStyleColor and T.416
+
+// checkReadStyleColor: ReadStyleColor on the form's parameters reads the count T.416 gives
+// the form and the colour it names, or nothing for one it cannot (a component beyond 255 is
+// x-ansi/15's shape).
+func checkReadStyleColor(ht *hegel.T, f colorForm, known shapes) {
+	text := f.whole()
+	p := ansi.NewParser()
+	seq := "\x1b[" + text + "m"
+	if _, _, k, _ := ansi.DecodeSequence(seq, ansi.NormalState, p); k != len(seq) {
+		mismatch(ht, known, "decoding %q consumed %d bytes", seq, k)
+	}
+	params := p.Params()
+	start := 0
+	if f.lead > 0 {
+		start = 1
+	}
+	sentinel := color.Gray{Y: 77}
+	var c color.Color = sentinel
+	got := ansi.ReadStyleColor(params[start:], &c)
+	wantN, want := f.want()
+	if got != wantN {
+		mismatch(ht, known, "ReadStyleColor(%q) read %d parameters, want %d", f.text(), got, wantN)
+	}
+	if want == nil {
+		want = sentinel
+	}
+	if !sameColor(c, want) || fmt.Sprintf("%T", c) != fmt.Sprintf("%T", want) {
+		mismatch(ht, known, "ReadStyleColor(%q) = %#v, want %#v", f.text(), c, want)
+	}
+}
+
+// TestHegelReadStyleColorFollowsT416: every colour form of T.416 is read as the standard says.
+// Drawn shape: a component beyond 255 (x-ansi/15).
+func TestHegelReadStyleColorFollowsT416(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := hegel.Draw(ht, colorForms)
+		var sh shapes
+		sh.add("x-ansi/15", f.big())
+		checkReadStyleColor(ht, f, sh)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- XParseColor
+
+// checkXParseColor: XParseColor scales every component as X11 does.
+func checkXParseColor(ht *hegel.T, h hexCase, known shapes) {
+	s, want := h.text(), h.want()
+	got := ansi.XParseColor(s)
+	if got == nil {
+		mismatch(ht, known, "XParseColor(%q) = nil, want %v", s, want)
+	}
+	r, g, b, a := got.RGBA()
+	if gotV := []int{int(r >> 8), int(g >> 8), int(b >> 8), int(a >> 8)}; !sameInts(gotV, want) {
+		mismatch(ht, known, "XParseColor(%q) = %v (%v), want %v", s, gotV, got, want)
+	}
+}
+
+// TestHegelXParseColorFollowsX11: rgb:, rgba: and # colours scale by digit count. Drawn shape:
+// one-, three- and four-digit rgb: components (x-ansi/14).
+func TestHegelXParseColorFollowsX11(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		h := hegel.Draw(ht, hexCases)
+		var sh shapes
+		sh.add("x-ansi/14", h.oddDigits())
+		checkXParseColor(ht, h, sh)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- palette conversions
+
+type paletteCase struct {
+	i  int
+	rc colorSpec
+}
+
+func (c paletteCase) GoString() string {
+	return fmt.Sprintf("palette %d = %v, colour %v", c.i, paletteRGB(c.i), c.rc.color())
+}
+
+var (
+	// paletteIndices: a basic colour (the sixteen that go through Convert16) half the time, any
+	// entry otherwise; under HEGEL_NO_KNOWN=1 never the basic greys 7 and 8 (x-ansi/17).
+	paletteIndices = weighted(
+		choice[int]{1, shaped(Known.greys78, hegel.Integers(0, 15), hegel.Map(hegel.Integers(0, 13), skipGreys))},
+		choice[int]{1, shaped(Known.greys78, bytes_, hegel.Map(hegel.Integers(0, 253), skipGreys))},
+	)
+	paletteCases = hegel.Composite(func(tc hegel.TestCase) paletteCase {
+		return paletteCase{i: hegel.Draw(tc, paletteIndices), rc: hegel.Draw(tc, rgbs)}
+	})
+)
+
+// skipGreys maps 0..253 onto the palette indices other than 7 and 8.
+func skipGreys(i int) int {
+	if i >= 7 {
+		return i + 2
+	}
+	return i
+}
+
+// checkPaletteEntry: palette entry i converts to itself through Convert256 and, for a basic
+// colour, through Convert16 from its index and from its exact RGB.
+func checkPaletteEntry(ht *hegel.T, i int, known shapes) {
+	c := paletteRGB(i)
+	if got := ansi.Convert256(ansi.IndexedColor(i)); int(got) != i {
+		mismatch(ht, known, "Convert256(IndexedColor(%d)) = %d", i, got)
+	}
+	if i >= 16 {
+		if got := ansi.Convert256(c); int(got) != i {
+			mismatch(ht, known, "Convert256(%v) = %d, want %d", c, got, i)
+		}
+		return
+	}
+	if got := ansi.Convert16(ansi.BasicColor(i)); int(got) != i {
+		mismatch(ht, known, "Convert16(BasicColor(%d)) = %d", i, got)
+	}
+	if got := ansi.Convert16(ansi.IndexedColor(i)); int(got) != i {
+		mismatch(ht, known, "Convert16(IndexedColor(%d)) = %d", i, got)
+	}
+	if got := ansi.Convert16(c); int(got) != i {
+		mismatch(ht, known, "Convert16(%v) = %d, want %d", c, got, i)
+	}
+}
+
+// TestHegelPaletteConversionsRoundTrip: every palette entry converts to its own index, any
+// colour lands in the cube or the greys, and Convert16 agrees with the table. Drawn shape: the
+// exact RGB of basic colours 7 and 8 (x-ansi/17).
+func TestHegelPaletteConversionsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, paletteCases)
+		var sh shapes
+		sh.add("x-ansi/17", c.i == 7 || c.i == 8)
+		checkPaletteEntry(ht, c.i, sh)
+		rc := c.rc.color()
+		c256 := ansi.Convert256(rc)
+		if c256 < 16 {
+			fail(ht, "Convert256(%v) = %d, a basic colour", rc, c256)
+		}
+		if got, want := ansi.Convert16(rc), ansi.Convert16(c256); got != want {
+			fail(ht, "Convert16(%v) = %d, Convert16(Convert256) = %d", rc, got, want)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- arbitrary input
+
+type arbitraryCase struct {
+	s      string
+	limit  int
+	bs, be int // byte positions, modulo the length
+}
+
+func (c arbitraryCase) GoString() string { return fmt.Sprintf("input %q limit %d", c.s, c.limit) }
+
+var arbitraryCases = hegel.Composite(func(tc hegel.TestCase) arbitraryCase {
+	return arbitraryCase{s: hegel.Draw(tc, arbitraryTexts), limit: hegel.Draw(tc, hegel.Integers(0, 5)), bs: hegel.Draw(tc, positions), be: hegel.Draw(tc, positions)}
+})
+
+// TestHegelArbitraryTextIsDecodedWithoutLossOrPanic: over arbitrary text, decoding makes
+// progress, joins back to the input and never panics, the decoded widths add up to
+// StringWidth, nor do the parser, the widths, truncation, the wrappers or ByteToGraphemeRange
+// panic. Drawn shapes: a CSI or DCS with more parameters than the buffer (x-ansi/1), a private
+// marker after the parameters (x-ansi/4), a cluster starting with an ASCII character
+// (x-ansi/5), UTF-8 inside an SOS/PM/APC string (x-ansi/18).
+func TestHegelArbitraryTextIsDecodedWithoutLossOrPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, arbitraryCases)
+		s := c.s
+		var known shapes
+		known.add("x-ansi/1", paramSeparators(s) >= parser.MaxParamsSize)
+		var widthShapes shapes
+		widthShapes.add("x-ansi/5", splitClusterShape(s))
+		for _, m := range []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth} {
+			var back strings.Builder
+			var pieces []piece
+			width := 0
+			recovering(ht, known, fmt.Sprintf("DecodeSequence on %q", s), func() { pieces = decodeAll(s, m) })
+			for _, p := range pieces {
+				back.WriteString(p.s)
+				width += p.w
+			}
+			if back.String() != s {
+				mismatch(ht, known, "decoded pieces of %q join to %q", s, back.String())
+			}
+			if !utf8.ValidString(s) {
+				continue
+			}
+			// Widths add up unless a cluster starts with an ASCII character the decoder
+			// takes on its own (x-ansi/5), a private marker follows a CSI's parameters
+			// (x-ansi/4), an SOS/PM/APC string holds UTF-8 (x-ansi/18), or the decoder gave a
+			// sequence up where the table-driven width goes on with it: at a C0 control, at
+			// an introducer after an intermediate, at an ESC inside a DCS (candidates
+			// go/x-ansi-1, -2, -3: counted, not judged).
+			if w := m.StringWidth(s); w != width {
+				if c := decoderBailCandidate(pieces); c != "" {
+					count(c)
+					continue
+				}
+				sh := append(shapes(nil), widthShapes...)
+				sh.add("x-ansi/4", lateMarkerPieces(pieces))
+				sh.add("x-ansi/18", utf8InStringPieces(pieces))
+				mismatch(ht, sh, "decoded widths of %q add up to %d, StringWidth %d (method %d)", s, width, w, m)
+			}
+		}
+		parseEvents(s)
+		plain := ansi.Strip(s)
+		if ansi.StringWidth(plain) != ansi.StringWidth(s) {
+			count("strip-width-differs")
+		}
+		for _, m := range []ansi.Method{ansi.GraphemeWidth, ansi.WcWidth} {
+			m.Truncate(s, c.limit, ".")
+			m.TruncateLeft(s, c.limit, ".")
+			m.Cut(s, c.limit, c.limit+2)
+			m.Hardwrap(s, c.limit, false)
+			m.Wordwrap(s, c.limit, "")
+			m.Wrap(s, c.limit, "")
+		}
+		ansi.ByteToGraphemeRange(s, at(c.bs, len(s)+1), at(c.be, len(s)+1))
+		count("ok")
+	})
+}
