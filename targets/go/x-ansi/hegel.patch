+package ansi_test
+
+// Generators: a document is a list of tokens drawn from a grammar built once per docCfg
+// (docsOf), every sequence a record (csiSpec, escSpec, oscSpec, dcsSpec, strSpec) rendered by
+// its tok method, parameter lists a list of paramSpec rendered by paramText, styles a list of
+// styleStep records and colours colorSpec records rendered by pure functions, T.416 colour forms
+// and X11 hex components records too. Every generator is a package-level value; the plain
+// alternative comes first in every choice. The shapes of the recorded bugs are drawn by
+// default and switched off by the Known switches (hegel_test.go) under HEGEL_NO_KNOWN=1.
+
+import (
+	"fmt"
+	"image/color"
+	"strconv"
+	"strings"
+	"sync"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/ansi/parser"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- the token grammar
+
+type kind int
+
+const (
+	kText kind = iota // one grapheme cluster
+	kCtrl             // one C0 control byte
+	kCSI
+	kESC
+	kOSC
+	kDCS
+	kStr // APC, PM or SOS string
+)
+
+type tok struct {
+	kind   kind
+	s      string // the raw bytes
+	w, wc  int    // cell widths under GraphemeWidth and WcWidth (text only)
+	prefix byte   // CSI/DCS private marker as the decoder reports it (the last one before the parameters), 0 if none
+	marks  int    // CSI/DCS: the number of private markers before the parameters (two: x-ansi/20)
+	late   bool   // CSI: a private marker after the parameters (x-ansi/4)
+	inter  byte   // CSI/DCS/ESC intermediate, 0 if none (the last one written)
+	final  byte   // CSI/DCS/ESC final byte
+	params []int  // CSI/DCS packed parameters as written (the parser keeps parser.MaxParamsSize: expectedParams)
+	cmd    int    // OSC command number (parser.MissingCommand when there is none); kStr: the introducer
+	data   string // OSC/DCS/kStr payload as the decoder and the parser report it
+	escST  bool   // string terminated by ESC \ (the state machine dispatches that ESC too)
+}
+
+// A cluster and its widths. Grapheme widths from displaywidth and wc widths from runewidth agree
+// with these for every entry (checked once in TestHegelExamples).
+type cl struct {
+	s     string
+	w, wc int
+}
+
+var clusters = []cl{
+	{"a", 1, 1}, {"b", 1, 1}, {"Z", 1, 1}, {"0", 1, 1}, {"\u00e9", 1, 1},
+	{"\u65e5", 2, 2}, {"\U0001F600", 2, 2},
+	{"\U0001F468\u200d\U0001F469\u200d\U0001F467", 2, 6}, // family ZWJ sequence
+	{"\u00a0", 1, 1}, // no-break space: text for every algorithm here
+}
+
+var (
+	spaceCl     = cl{" ", 1, 1}
+	hyphenCl    = cl{"-", 1, 1}
+	wideSpaceCl = cl{"\u3000", 2, 2} // the ideographic space: whitespace to the wrappers (x-ansi/11)
+	// asciiStartClusters start with an ASCII character, which the decoder takes on its own
+	// (x-ansi/5); the keycaps are two cells by grapheme and one by wcwidth.
+	asciiStartClusters = []cl{{"e\u0301", 1, 1}, {"1\ufe0f\u20e3", 2, 1}, {"#\ufe0f\u20e3", 2, 1}}
+)
+
+func (c cl) tok() tok { return tok{kind: kText, s: c.s, w: c.w, wc: c.wc} }
+
+func ctrlTok(s string) tok { return tok{kind: kCtrl, s: s} }
+
+// docCfg says which tokens a document may hold.
+type docCfg struct {
+	seqs      bool // CSI/ESC/OSC/DCS/string tokens
+	sgrOnly   bool // with seqs: only SGR sequences and OSC 8 hyperlinks (the style model reads them)
+	spaces    bool // ASCII spaces
+	newlines  bool
+	ctrls     bool // C0 controls other than newline
+	hyphen    bool
+	wcSafe    bool // no cluster whose grapheme and wc widths differ
+	nbsp      bool // allow the no-break space
+	eightBit  bool // 8-bit C1 introducers and terminators now and then
+	wideSpace bool // the ideographic space now and then
+	plainSeqs bool // with seqs: sequences past the recorded shapes (short parameter lists, one marker at most, ASCII payloads): the narrow properties' surroundings
+}
+
+// clustersOf is a weighted choice over the clusters table, the ASCII clusters first and as
+// often as all the others together, without the clusters the config leaves out.
+func clustersOf(cfg docCfg) hegel.Generator[tok] {
+	var ascii, other []cl
+	for _, c := range clusters {
+		switch {
+		case cfg.wcSafe && c.w != c.wc, !cfg.nbsp && c.s == string(noBreakSpace):
+		case c.s[0] < 0x80:
+			ascii = append(ascii, c)
+		default:
+			other = append(other, c)
+		}
+	}
+	return weighted(
+		choice[tok]{1, hegel.Map(hegel.SampledFrom(ascii), cl.tok)},
+		choice[tok]{1, hegel.Map(hegel.SampledFrom(other), cl.tok)},
+	)
+}
+
+// ---------------------------------------------------------------- parameters
+
+// paramSpec is one CSI/DCS parameter: missing (empty), or a number of up to three digits with
+// an optional leading zero; sub marks it as having sub-parameters (a ':' before the next one).
+type paramSpec struct {
+	missing bool
+	zero    bool
+	value   int
+	sub     bool
+}
+
+var paramSpecs = hegel.Composite(func(tc hegel.TestCase) paramSpec {
+	return paramSpec{
+		missing: hegel.Draw(tc, chance(20)),
+		zero:    hegel.Draw(tc, chance(10)),
+		value:   hegel.Draw(tc, hegel.Integers(0, 999)),
+		sub:     hegel.Draw(tc, chance(25)),
+	}
+})
+
+var (
+	// bufferParamLists: a list at or beyond the parser's buffer (x-ansi/1, /2); under
+	// HEGEL_NO_KNOWN=1 a long list within it.
+	bufferParamLists = shaped(Known.bufferParams,
+		many(paramSpecs, parser.MaxParamsSize-1, parser.MaxParamsSize+2),
+		many(paramSpecs, 16, parser.MaxParamsSize-1))
+	// shortParamLists: up to four parameters; paramLists: those, one time in twenty a
+	// buffer-sized list.
+	shortParamLists = many(paramSpecs, 0, 4)
+	paramLists      = weighted(choice[[]paramSpec]{19, shortParamLists}, choice[[]paramSpec]{1, bufferParamLists})
+)
+
+// paramText renders a parameter list: ';' between parameters, ':' after one with
+// sub-parameters, nothing for a missing one.
+func paramText(specs []paramSpec) string {
+	var sb strings.Builder
+	for i, p := range specs {
+		if i > 0 {
+			if specs[i-1].sub {
+				sb.WriteByte(':')
+			} else {
+				sb.WriteByte(';')
+			}
+		}
+		if p.missing {
+			continue
+		}
+		if p.zero {
+			sb.WriteByte('0')
+		}
+		sb.WriteString(strconv.Itoa(p.value))
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------- sequences
+
+const (
+	intermediates = " !\"#$%&'()*+,-./"
+	prefixes      = "<=>?"
+)
+
+var (
+	finals = hegel.Map(hegel.Integers(0x40, 0x7e), func(i int) byte { return byte(i) })
+	marks  = hegel.SampledFrom([]byte(prefixes))
+	inters = hegel.SampledFrom([]byte(intermediates))
+	// markLists: no private marker most of the time, one, and one time in twenty two
+	// (x-ansi/20; one under HEGEL_NO_KNOWN=1).
+	markLists = weighted(
+		choice[[]byte]{70, hegel.Just([]byte(nil))},
+		choice[[]byte]{25, many(marks, 1, 1)},
+		choice[[]byte]{5, shaped(Known.twoMarks, many(marks, 2, 2), many(marks, 1, 1))},
+	)
+	// lateMarks: a private marker after the parameters one time in twenty (x-ansi/4).
+	lateMarks = shaped(Known.lateMark, maybe(5, marks), hegel.Just(byte(0)))
+	// interLists: none, or one or two intermediates.
+	interLists = maybe(30, many(inters, 1, 2))
+)
+
+// eightBitOf: whether a sequence uses its 8-bit C1 introducer, when the config allows it.
+func eightBitOf(cfg docCfg) hegel.Generator[bool] {
+	if cfg.eightBit {
+		return chance(15)
+	}
+	return hegel.Just(false)
+}
+
+// csiSpec is a CSI sequence: introducer form, private markers, parameters, a marker after
+// them, intermediates, final.
+type csiSpec struct {
+	eightBit bool
+	marks    []byte
+	params   []paramSpec
+	late     byte
+	inters   []byte
+	final    byte
+}
+
+// csiParts are the generators a CSI is drawn from (the narrow properties swap some).
+type csiParts struct {
+	eightBit hegel.Generator[bool]
+	marks    hegel.Generator[[]byte]
+	params   hegel.Generator[[]paramSpec]
+	late     hegel.Generator[byte]
+}
+
+func csisFrom(p csiParts) hegel.Generator[tok] {
+	return hegel.Map(hegel.Composite(func(tc hegel.TestCase) csiSpec {
+		return csiSpec{
+			eightBit: hegel.Draw(tc, p.eightBit),
+			marks:    hegel.Draw(tc, p.marks),
+			params:   hegel.Draw(tc, p.params),
+			late:     hegel.Draw(tc, p.late),
+			inters:   hegel.Draw(tc, interLists),
+			final:    hegel.Draw(tc, finals),
+		}
+	}), csiSpec.tok)
+}
+
+func csisOf(cfg docCfg) hegel.Generator[tok] {
+	if cfg.plainSeqs {
+		return csisFrom(csiParts{eightBitOf(cfg), maybe(25, many(marks, 1, 1)), shortParamLists, hegel.Just(byte(0))})
+	}
+	return csisFrom(csiParts{eightBitOf(cfg), markLists, paramLists, lateMarks})
+}
+
+func (c csiSpec) tok() tok {
+	var sb strings.Builder
+	if c.eightBit {
+		sb.WriteByte(0x9b)
+	} else {
+		sb.WriteString("\x1b[")
+	}
+	t := tok{kind: kCSI}
+	text := paramText(c.params)
+	ms := c.marks
+	if c.late != 0 && text == "" {
+		ms = append(append([]byte(nil), ms...), c.late) // nothing before it: a leading marker
+	}
+	for _, m := range ms {
+		t.prefix = m
+		sb.WriteByte(m)
+	}
+	t.marks = len(ms)
+	sb.WriteString(text)
+	t.params = packParams(text)
+	if c.late != 0 && text != "" {
+		t.late = true
+		sb.WriteByte(c.late)
+	}
+	for _, i := range c.inters {
+		t.inter = i
+		sb.WriteByte(i)
+	}
+	t.final = c.final
+	sb.WriteByte(c.final)
+	t.s = sb.String()
+	return t
+}
+
+// sgrTokens: an SGR sequence (CSI ... m) built from a drawn style; a reset one in five.
+var sgrTokens = hegel.Map(
+	weighted(choice[[]styleStep]{1, hegel.Just([]styleStep(nil))}, choice[[]styleStep]{4, styleLists}),
+	func(steps []styleStep) tok {
+		s := renderStyle(steps).String()
+		return tok{kind: kCSI, s: s, final: 'm', params: packParams(s[2 : len(s)-1])}
+	})
+
+// escFinals: the finals of a plain ESC sequence. Those that start other kinds of sequence are
+// kept out of the grammar: the decoder takes them so even after an intermediate.
+var escFinals = func() []byte {
+	var out []byte
+	for b := byte(0x30); b <= 0x7e; b++ {
+		if strings.IndexByte("[]PX^_\\", b) < 0 {
+			out = append(out, b)
+		}
+	}
+	return out
+}()
+
+type escSpec struct {
+	inters []byte
+	final  byte
+}
+
+var escTokens = hegel.Map(hegel.Composite(func(tc hegel.TestCase) escSpec {
+	return escSpec{inters: hegel.Draw(tc, many(inters, 0, 2)), final: hegel.Draw(tc, hegel.SampledFrom(escFinals))}
+}), escSpec.tok)
+
+func (e escSpec) tok() tok {
+	t := tok{kind: kESC, final: e.final}
+	var sb strings.Builder
+	sb.WriteByte(0x1b)
+	for _, i := range e.inters {
+		t.inter = i
+		sb.WriteByte(i)
+	}
+	sb.WriteByte(e.final)
+	t.s = sb.String()
+	return t
+}
+
+// Payloads of OSC, DCS and APC/PM/SOS strings: no C0 byte. stPayloadChars hold a 0x9C byte
+// in their UTF-8 (x-ansi/3); nonASCIIPayloadChars end an SOS, PM or APC string in the
+// table-driven parser (x-ansi/18).
+var (
+	asciiPayloadChars    = []string{" ", "a", "Z", "0", "7", ";", ":", "/", "=", "~"}
+	nonASCIIPayloadChars = []string{"\u00e9", "\u65e5", "\U0001F600"}
+	stPayloadChars       = []string{"\u00dc", "\u2733"}
+	utf8PayloadChars     = concat(asciiPayloadChars, nonASCIIPayloadChars)
+	// stringPayloads: for OSC and DCS; strPayloads: for the three strings.
+	stringPayloads = payloadsOf(shapedChars(Known.stInUTF8, concat(utf8PayloadChars, stPayloadChars), utf8PayloadChars))
+	strPayloads    = shaped(Known.utf8InStrings, stringPayloads, payloadsOf(asciiPayloadChars))
+)
+
+func concat[T any](xs ...[]T) []T {
+	var out []T
+	for _, x := range xs {
+		out = append(out, x...)
+	}
+	return out
+}
+
+func shapedChars(off bool, known, past []string) []string {
+	if off {
+		return past
+	}
+	return known
+}
+
+func payloadsOf(chars []string) hegel.Generator[string] {
+	return joined(many(hegel.SampledFrom(chars), 0, 6))
+}
+
+// payloadsWith: a payload of chars with one of must somewhere in it.
+func payloadsWith(must, chars []string) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		before := hegel.Draw(tc, payloadsOf(chars))
+		m := hegel.Draw(tc, hegel.SampledFrom(must))
+		after := hegel.Draw(tc, payloadsOf(chars))
+		return before + m + after
+	})
+}
+
+// payloadsFor: the string payloads of a config (ASCII only for plainSeqs surroundings).
+func payloadsFor(cfg docCfg, full hegel.Generator[string]) hegel.Generator[string] {
+	if cfg.plainSeqs {
+		return payloadsOf(asciiPayloadChars)
+	}
+	return full
+}
+
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
+
+// terminator is how a string ends: ESC \ (the plainest), BEL (OSC only), or the 8-bit ST.
+type terminator int
+
+const (
+	stEsc terminator = iota
+	stBel
+	st8bit
+)
+
+func (t terminator) String() string {
+	switch t {
+	case stBel:
+		return "\a"
+	case st8bit:
+		return "\x9c"
+	}
+	return "\x1b\\"
+}
+
+func terminatorsOf(cfg docCfg, bel bool) hegel.Generator[terminator] {
+	cs := []choice[terminator]{{8, hegel.Just(stEsc)}}
+	if bel {
+		cs = append(cs, choice[terminator]{5, hegel.Just(stBel)})
+	}
+	if cfg.eightBit {
+		cs = append(cs, choice[terminator]{2, hegel.Just(st8bit)})
+	}
+	return weighted(cs...)
+}
+
+func oscCmd(data string) int {
+	i := 0
+	for i < len(data) && data[i] >= '0' && data[i] <= '9' {
+		i++
+	}
+	if i == 0 {
+		return parser.MissingCommand
+	}
+	v, _ := strconv.Atoi(data[:i])
+	return v
+}
+
+// oscSpec is an OSC string: a number and a payload after ';', or a payload alone.
+type oscSpec struct {
+	eightBit    bool
+	numbered    bool
+	num         int
+	withPayload bool
+	payload     string
+	term        terminator
+}
+
+func oscsWith(cfg docCfg, payloads hegel.Generator[string]) hegel.Generator[tok] {
+	return hegel.Map(hegel.Composite(func(tc hegel.TestCase) oscSpec {
+		return oscSpec{
+			eightBit:    hegel.Draw(tc, eightBitOf(cfg)),
+			numbered:    hegel.Draw(tc, chance(85)),
+			num:         hegel.Draw(tc, hegel.Integers(0, 999)),
+			withPayload: hegel.Draw(tc, chance(90)),
+			payload:     hegel.Draw(tc, payloads),
+			term:        hegel.Draw(tc, terminatorsOf(cfg, true)),
+		}
+	}), oscSpec.tok)
+}
+
+func oscsOf(cfg docCfg) hegel.Generator[tok] { return oscsWith(cfg, payloadsFor(cfg, stringPayloads)) }
+
+func (o oscSpec) tok() tok {
+	t := tok{kind: kOSC, escST: o.term == stEsc}
+	switch {
+	case o.numbered && o.withPayload:
+		t.data = strconv.Itoa(o.num) + ";" + o.payload
+	case o.numbered:
+		t.data = strconv.Itoa(o.num)
+	default:
+		t.data = o.payload
+	}
+	t.cmd = oscCmd(t.data)
+	intro := "\x1b]"
+	if o.eightBit {
+		intro = "\x9d"
+	}
+	t.s = intro + t.data + o.term.String()
+	return t
+}
+
+// hyperlinkTokens: an OSC 8 hyperlink close, or an open with a short URL.
+var hyperlinkTokens = hegel.Map(
+	weighted(
+		choice[string]{1, hegel.Just("")},
+		choice[string]{1, hegel.Map(hegel.Integers(0, 3), func(n int) string { return "https://example.com/" + strings.Repeat("x", n) })},
+	),
+	func(url string) tok {
+		data := "8;;" + url
+		return tok{kind: kOSC, cmd: 8, data: data, s: "\x1b]" + data + "\x1b\\", escST: true}
+	})
+
+// dcsSpec is a DCS: introducer form, a private marker, parameters, an intermediate, final,
+// payload, terminator.
+type dcsSpec struct {
+	eightBit bool
+	mark     byte
+	params   []paramSpec
+	inter    byte
+	final    byte
+	payload  string
+	term     terminator
+}
+
+func dcssWith(cfg docCfg, params hegel.Generator[[]paramSpec], payloads hegel.Generator[string]) hegel.Generator[tok] {
+	return hegel.Map(hegel.Composite(func(tc hegel.TestCase) dcsSpec {
+		return dcsSpec{
+			eightBit: hegel.Draw(tc, eightBitOf(cfg)),
+			mark:     hegel.Draw(tc, maybe(30, marks)),
+			params:   hegel.Draw(tc, params),
+			inter:    hegel.Draw(tc, maybe(30, inters)),
+			final:    hegel.Draw(tc, finals),
+			payload:  hegel.Draw(tc, payloads),
+			term:     hegel.Draw(tc, terminatorsOf(cfg, false)),
+		}
+	}), dcsSpec.tok)
+}
+
+func dcssOf(cfg docCfg) hegel.Generator[tok] {
+	if cfg.plainSeqs {
+		return dcssWith(cfg, shortParamLists, payloadsOf(asciiPayloadChars))
+	}
+	return dcssWith(cfg, paramLists, stringPayloads)
+}
+
+func (d dcsSpec) tok() tok {
+	t := tok{kind: kDCS, prefix: d.mark, inter: d.inter, final: d.final, data: d.payload, escST: d.term == stEsc}
+	var sb strings.Builder
+	if d.eightBit {
+		sb.WriteByte(0x90)
+	} else {
+		sb.WriteString("\x1bP")
+	}
+	if d.mark != 0 {
+		t.marks = 1
+		sb.WriteByte(d.mark)
+	}
+	text := paramText(d.params)
+	sb.WriteString(text)
+	t.params = packParams(text)
+	if d.inter != 0 {
+		sb.WriteByte(d.inter)
+	}
+	sb.WriteByte(d.final)
+	sb.WriteString(d.payload)
+	sb.WriteString(d.term.String())
+	t.s = sb.String()
+	return t
+}
+
+// strSpec is an APC ('_'), PM ('^') or SOS ('X') string.
+type strSpec struct {
+	intro    byte
+	eightBit bool
+	payload  string
+	term     terminator
+}
+
+var strIntros = pick(byte('_'), '^', 'X')
+
+func strsWith(cfg docCfg, payloads hegel.Generator[string]) hegel.Generator[tok] {
+	return hegel.Map(hegel.Composite(func(tc hegel.TestCase) strSpec {
+		return strSpec{
+			intro:    hegel.Draw(tc, strIntros),
+			eightBit: hegel.Draw(tc, eightBitOf(cfg)),
+			payload:  hegel.Draw(tc, payloads),
+			term:     hegel.Draw(tc, terminatorsOf(cfg, false)),
+		}
+	}), strSpec.tok)
+}
+
+func strsOf(cfg docCfg) hegel.Generator[tok] { return strsWith(cfg, payloadsFor(cfg, strPayloads)) }
+
+func (s strSpec) tok() tok {
+	t := tok{kind: kStr, cmd: int(s.intro), data: s.payload, escST: s.term == stEsc}
+	intro := "\x1b" + string(s.intro)
+	if s.eightBit {
+		intro = string([]byte{map[byte]byte{'_': 0x9f, '^': 0x9e, 'X': 0x98}[s.intro]}) // the raw C1 byte, not its UTF-8
+	}
+	t.s = intro + s.payload + s.term.String()
+	return t
+}
+
+// seqsOf: one sequence token of any kind the config allows.
+func seqsOf(cfg docCfg) hegel.Generator[tok] {
+	if cfg.sgrOnly {
+		return weighted(choice[tok]{4, sgrTokens}, choice[tok]{1, hyperlinkTokens})
+	}
+	return weighted(
+		choice[tok]{3, csisOf(cfg)},
+		choice[tok]{2, sgrTokens},
+		choice[tok]{1, escTokens},
+		choice[tok]{2, oscsOf(cfg)},
+		choice[tok]{1, dcssOf(cfg)},
+		choice[tok]{1, strsOf(cfg)},
+	)
+}
+
+// ---------------------------------------------------------------- documents
+
+// plainTableOf is the table of the config's text and control tokens, the clusters first (the
+// ASCII ones as often as the rest together), each entry repeated for its weight.
+func plainTableOf(cfg docCfg) []tok {
+	var table []tok
+	add := func(on bool, n int, ts ...tok) {
+		if on {
+			for i := 0; i < n; i++ {
+				table = append(table, ts...)
+			}
+		}
+	}
+	var ascii, other []tok
+	for _, c := range clusters {
+		switch {
+		case cfg.wcSafe && c.w != c.wc, !cfg.nbsp && c.s == string(noBreakSpace):
+		case c.s[0] < 0x80:
+			ascii = append(ascii, c.tok())
+		default:
+			other = append(other, c.tok())
+		}
+	}
+	add(true, 5, ascii...)
+	add(true, 20/len(other), other...)
+	add(cfg.spaces, 15, spaceCl.tok())
+	add(cfg.newlines, 8, ctrlTok("\n"))
+	add(cfg.ctrls, 1, ctrlTok("\r"), ctrlTok("\t"), ctrlTok("\a"), ctrlTok("\b"))
+	add(cfg.hyphen, 7, hyphenCl.tok())
+	add(cfg.wideSpace, 3, wideSpaceCl.tok())
+	return table
+}
+
+// tokensOf: a token of the config, a sequence one time in four when allowed.
+func tokensOf(cfg docCfg) hegel.Generator[tok] {
+	plain := hegel.SampledFrom(plainTableOf(cfg))
+	if !cfg.seqs {
+		return plain
+	}
+	return weighted(choice[tok]{3, plain}, choice[tok]{1, seqsOf(cfg)})
+}
+
+var (
+	docsMu    sync.Mutex
+	docsCache = map[docCfg]hegel.Generator[[]tok]{}
+)
+
+// docsOf is the document generator of a config, built once: up to twelve tokens.
+func docsOf(cfg docCfg) hegel.Generator[[]tok] {
+	docsMu.Lock()
+	defer docsMu.Unlock()
+	if g, ok := docsCache[cfg]; ok {
+		return g
+	}
+	g := many(tokensOf(cfg), 0, 12)
+	docsCache[cfg] = g
+	return g
+}
+
+// docsAround: a document with one token of middle in it (the narrow properties' way of
+// putting a shape into random surroundings).
+func docsAround(cfg docCfg, middle hegel.Generator[tok]) hegel.Generator[[]tok] {
+	return hegel.Composite(func(tc hegel.TestCase) []tok {
+		before := hegel.Draw(tc, docsOf(cfg))
+		mid := hegel.Draw(tc, middle)
+		after := hegel.Draw(tc, docsOf(cfg))
+		return concat(before, []tok{mid}, after)
+	})
+}
+
+var methods = pick(ansi.GraphemeWidth, ansi.WcWidth)
+
+// ---------------------------------------------------------------- styles and colours
+
+type colorKind int
+
+const (
+	cNil colorKind = iota
+	cBasic
+	cIndexed
+	cRGB
+	cTrue
+	cStd
+)
+
+// colorSpec is a colour as the Style builder takes it: none, a basic one (v 0-15), an
+// indexed one (v 0-255), an RGBColor or a color.RGBA (r, g, b), or a TrueColor (v).
+type colorSpec struct {
+	kind    colorKind
+	v       int
+	r, g, b int
+}
+
+func (c colorSpec) color() ansi.Color {
+	switch c.kind {
+	case cBasic:
+		return ansi.BasicColor(c.v)
+	case cIndexed:
+		return ansi.IndexedColor(c.v)
+	case cRGB:
+		return ansi.RGBColor{R: uint8(c.r), G: uint8(c.g), B: uint8(c.b)}
+	case cTrue:
+		return ansi.TrueColor(c.v)
+	case cStd:
+		return color.RGBA{R: uint8(c.r), G: uint8(c.g), B: uint8(c.b), A: 0xff}
+	}
+	return nil
+}
+
+// index is the palette index of a basic or indexed colour.
+func (c colorSpec) index() int { return c.v }
+
+var (
+	bytes_ = hegel.Integers(0, 255)
+	// rgbs: an RGB triple as an RGBColor (colorsOf sets the other kinds).
+	rgbs = hegel.Composite(func(tc hegel.TestCase) colorSpec {
+		return colorSpec{kind: cRGB, r: hegel.Draw(tc, bytes_), g: hegel.Draw(tc, bytes_), b: hegel.Draw(tc, bytes_)}
+	})
+	colors = hegel.FlatMap(pick(cNil, cBasic, cIndexed, cRGB, cTrue, cStd), colorsOf)
+)
+
+func colorsOf(k colorKind) hegel.Generator[colorSpec] {
+	with := func(c colorSpec) colorSpec { c.kind = k; return c }
+	switch k {
+	case cBasic:
+		return hegel.Map(hegel.Integers(0, 15), func(v int) colorSpec { return with(colorSpec{v: v}) })
+	case cIndexed:
+		return hegel.Map(bytes_, func(v int) colorSpec { return with(colorSpec{v: v}) })
+	case cTrue:
+		return hegel.Map(hegel.Integers(0, 0xffffff), func(v int) colorSpec { return with(colorSpec{v: v}) })
+	case cRGB, cStd:
+		return hegel.Map(rgbs, with)
+	}
+	return hegel.Just(colorSpec{})
+}
+
+// colorParams is the SGR parameter text for a colour, from the table: 30-37/90-97 for the basic
+// foregrounds (40-47/100-107 backgrounds), 38;5;n indexed, 38;2;r;g;b direct; underline colours
+// (58) have no basic form and take the indexed one.
+func colorParams(base int, c colorSpec) string {
+	switch c.kind {
+	case cNil:
+		return strconv.Itoa(base + 1)
+	case cBasic:
+		if base == 58 {
+			return "58;5;" + strconv.Itoa(c.v)
+		}
+		if c.v < 8 {
+			return strconv.Itoa(base - 8 + c.v)
+		}
+		return strconv.Itoa(base + 52 + c.v - 8)
+	case cIndexed:
+		return strconv.Itoa(base) + ";5;" + strconv.Itoa(c.v)
+	default:
+		r, g, b := rgb8(c.color())
+		return fmt.Sprintf("%d;2;%d;%d;%d", base, r, g, b)
+	}
+}
+
+// styleStep is one call of the Style builder: the attribute, and the draws the attributes
+// with an argument use (on/off, the underline style, a colour).
+type styleStep struct {
+	attr  string
+	on    bool
+	ul    int
+	color colorSpec
+}
+
+var (
+	styleAttrs = []string{"bold", "faint", "italic", "underline", "ulstyle", "blink", "rapid", "reverse", "conceal", "strike", "normal", "reset", "fg", "bg", "ulcolor"}
+	styleSteps = hegel.Composite(func(tc hegel.TestCase) styleStep {
+		return styleStep{
+			attr:  hegel.Draw(tc, hegel.SampledFrom(styleAttrs)),
+			on:    hegel.Draw(tc, chance(60)),
+			ul:    hegel.Draw(tc, hegel.Integers(0, 5)),
+			color: hegel.Draw(tc, colors),
+		}
+	})
+	styleLists = many(styleSteps, 1, 5)
+)
+
+// base is 38/48/58 for a colour step, 0 otherwise.
+func (s styleStep) base() int {
+	switch s.attr {
+	case "fg":
+		return 38
+	case "bg":
+		return 48
+	case "ulcolor":
+		return 58
+	}
+	return 0
+}
+
+func onoff(v bool, on, off string) string {
+	if v {
+		return on
+	}
+	return off
+}
+
+// params is the parameter text the step should append.
+func (s styleStep) params() string {
+	switch s.attr {
+	case "bold":
+		return "1"
+	case "faint":
+		return "2"
+	case "italic":
+		return onoff(s.on, "3", "23")
+	case "underline":
+		return onoff(s.on, "4", "24")
+	case "ulstyle":
+		return []string{"24", "4", "4:2", "4:3", "4:4", "4:5"}[s.ul]
+	case "blink":
+		return onoff(s.on, "5", "25")
+	case "rapid":
+		return onoff(s.on, "6", "25")
+	case "reverse":
+		return onoff(s.on, "7", "27")
+	case "conceal":
+		return onoff(s.on, "8", "28")
+	case "strike":
+		return onoff(s.on, "9", "29")
+	case "normal":
+		return "22"
+	case "reset":
+		return "0"
+	}
+	return colorParams(s.base(), s.color)
+}
+
+// apply is the builder call.
+func (s styleStep) apply(st ansi.Style) ansi.Style {
+	switch s.attr {
+	case "bold":
+		return st.Bold()
+	case "faint":
+		return st.Faint()
+	case "italic":
+		return st.Italic(s.on)
+	case "underline":
+		return st.Underline(s.on)
+	case "ulstyle":
+		return st.UnderlineStyle(ansi.Underline(s.ul))
+	case "blink":
+		return st.Blink(s.on)
+	case "rapid":
+		return st.RapidBlink(s.on)
+	case "reverse":
+		return st.Reverse(s.on)
+	case "conceal":
+		return st.Conceal(s.on)
+	case "strike":
+		return st.Strikethrough(s.on)
+	case "normal":
+		return st.Normal()
+	case "reset":
+		return st.Reset()
+	case "fg":
+		return st.ForegroundColor(s.color.color())
+	case "bg":
+		return st.BackgroundColor(s.color.color())
+	}
+	return st.UnderlineColor(s.color.color())
+}
+
+func renderStyle(steps []styleStep) ansi.Style {
+	st := ansi.Style{}
+	for _, s := range steps {
+		st = s.apply(st)
+	}
+	return st
+}
+
+// ---------------------------------------------------------------- T.416 colour forms
+
+// colorForm is a colour parameter list for ReadStyleColor in one of the shapes of T.416
+// (form 0-13), with components r, g, b, a, a colour-space id and an ignored value, between an
+// optional parameter before (lead, 0 = none) and after (trail, -1 = none). bigAt bumps one
+// used component beyond 255 (x-ansi/15) when bump is set.
+type colorForm struct {
+	t          int
+	form       int
+	r, g, b, a int
+	cs         int
+	x          int
+	lead       int
+	trail      int
+	bump       bool
+	bigAt      int
+}
+
+var (
+	// components: 0-255, and one time in ten beyond (x-ansi/15); within range under
+	// HEGEL_NO_KNOWN=1.
+	components = shaped(Known.bigComponents,
+		weighted(choice[int]{9, bytes_}, choice[int]{1, hegel.Integers(256, 999)}),
+		bytes_)
+	colorForms = colorFormsWith(hegel.Integers(0, 13), components, hegel.Just(false))
+)
+
+func colorFormsWith(forms, comps hegel.Generator[int], bumps hegel.Generator[bool]) hegel.Generator[colorForm] {
+	return hegel.Composite(func(tc hegel.TestCase) colorForm {
+		return colorForm{
+			t:     hegel.Draw(tc, pick(38, 48, 58)),
+			form:  hegel.Draw(tc, forms),
+			r:     hegel.Draw(tc, comps),
+			g:     hegel.Draw(tc, comps),
+			b:     hegel.Draw(tc, comps),
+			a:     hegel.Draw(tc, comps),
+			cs:    hegel.Draw(tc, hegel.Integers(0, 9)),
+			x:     hegel.Draw(tc, hegel.Integers(0, 99)),
+			lead:  hegel.Draw(tc, maybe(30, hegel.Integers(1, 9))),
+			trail: hegel.Draw(tc, weighted(choice[int]{1, hegel.Just(-1)}, choice[int]{1, hegel.Integers(0, 9)})),
+			bump:  hegel.Draw(tc, bumps),
+			bigAt: hegel.Draw(tc, hegel.Integers(0, 3)),
+		}
+	})
+}
+
+// used is how many of r, g, b, a the form reads.
+func (f colorForm) used() int {
+	switch f.form {
+	case 0, 1:
+		return 1
+	case 2, 3, 4, 5, 6, 7, 8, 9:
+		return 3
+	case 10, 11:
+		return 4
+	}
+	return 0
+}
+
+// comps are the components as rendered, with the bump applied.
+func (f colorForm) comps() [4]int {
+	c := [4]int{f.r, f.g, f.b, f.a}
+	if f.bump && f.used() > 0 {
+		c[f.bigAt%f.used()] += 256
+	}
+	return c
+}
+
+// big reports whether a component the form reads is beyond 255 (x-ansi/15).
+func (f colorForm) big() bool {
+	c := f.comps()
+	for i := 0; i < f.used(); i++ {
+		if c[i] > 255 {
+			return true
+		}
+	}
+	return false
+}
+
+// text is the colour's own parameter text.
+func (f colorForm) text() string {
+	ts := strconv.Itoa(f.t)
+	c := f.comps()
+	r, g, b, a := c[0], c[1], c[2], c[3]
+	switch f.form {
+	case 0:
+		return fmt.Sprintf("%s;5;%d", ts, r)
+	case 1:
+		return fmt.Sprintf("%s:5:%d", ts, r)
+	case 2:
+		return fmt.Sprintf("%s;2;%d;%d;%d", ts, r, g, b)
+	case 3:
+		return fmt.Sprintf("%s:2:%d:%d:%d", ts, r, g, b)
+	case 4:
+		return fmt.Sprintf("%s:2::%d:%d:%d", ts, r, g, b)
+	case 5:
+		return fmt.Sprintf("%s:2:%d:%d:%d:%d", ts, f.cs, r, g, b)
+	case 6:
+		return fmt.Sprintf("%s:2::%d:%d:%d:%d", ts, r, g, b, f.x)
+	case 7:
+		return fmt.Sprintf("%s:2::%d:%d:%d:%d:%d", ts, r, g, b, f.x, f.x)
+	case 8:
+		return fmt.Sprintf("%s:2::%d:%d:%d:%d:%d:%d", ts, r, g, b, f.x, f.x, f.cs)
+	case 9:
+		return fmt.Sprintf("%s:3::%d:%d:%d", ts, r, g, b)
+	case 10:
+		return fmt.Sprintf("%s:4::%d:%d:%d:%d", ts, r, g, b, a)
+	case 11:
+		return fmt.Sprintf("%s:6::%d:%d:%d:%d", ts, r, g, b, a)
+	case 12:
+		return ts + ":1"
+	}
+	return ts + ":0"
+}
+
+// whole is the full parameter text with the lead and trail parameters.
+func (f colorForm) whole() string {
+	s := f.text()
+	if f.trail >= 0 {
+		s += ";" + strconv.Itoa(f.trail)
+	}
+	if f.lead > 0 {
+		s = strconv.Itoa(f.lead) + ";" + s
+	}
+	return s
+}
+
+// want is what ReadStyleColor should read: the parameter count and the colour (nil = left
+// untouched). A component beyond 255 is not a colour: nothing read, nothing touched.
+func (f colorForm) want() (int, color.Color) {
+	if f.big() {
+		return 0, nil
+	}
+	c := f.comps()
+	r, g, b, a := c[0], c[1], c[2], c[3]
+	rgba := color.RGBA{uint8(r), uint8(g), uint8(b), 0xff}
+	switch f.form {
+	case 0, 1:
+		return 3, ansi.IndexedColor(r)
+	case 2, 3:
+		return 5, rgba
+	case 4, 5:
+		return 6, rgba
+	case 6:
+		return 7, rgba
+	case 7:
+		return 8, rgba
+	case 8:
+		return 9, rgba
+	case 9:
+		return 6, color.CMYK{uint8(r), uint8(g), uint8(b), 0}
+	case 10:
+		return 7, color.CMYK{uint8(r), uint8(g), uint8(b), uint8(a)}
+	case 11:
+		return 7, color.RGBA{uint8(r), uint8(g), uint8(b), uint8(a)}
+	case 12:
+		return 2, color.Transparent
+	}
+	return 2, nil
+}
+
+func (f colorForm) GoString() string { return fmt.Sprintf("params %q", f.whole()) }
+
+// ---------------------------------------------------------------- X11 hex components
+
+// hexComponent is one component of an rgb:/rgba: colour: its digit count and value (taken
+// modulo the digits' range), written in upper case or not.
+type hexComponent struct {
+	digits int
+	value  int
+	upper  bool
+}
+
+// text renders the component with its digit count; textWith with another.
+func (h hexComponent) text() string { return h.textWith(h.digits) }
+
+func (h hexComponent) textWith(digits int) string {
+	v := h.value % (1 << (4 * digits))
+	if h.upper {
+		return fmt.Sprintf("%0*X", digits, v)
+	}
+	return fmt.Sprintf("%0*x", digits, v)
+}
+
+var (
+	// hexDigitCounts: two digits first; one, three and four are x-ansi/14's shape.
+	hexDigitCounts = shaped(Known.hexDigits, pick(2, 1, 3, 4), hegel.Just(2))
+	hexComponents  = hexComponentsWith(hexDigitCounts)
+)
+
+func hexComponentsWith(digits hegel.Generator[int]) hegel.Generator[hexComponent] {
+	return hegel.Composite(func(tc hegel.TestCase) hexComponent {
+		return hexComponent{digits: hegel.Draw(tc, digits), value: hegel.Draw(tc, hegel.Integers(0, 0xffff)), upper: hegel.Draw(tc, chance(30))}
+	})
+}
+
+// hexCase is an XParseColor input: rgb:r/g/b, rgba:r/g/b/a, or #rgb / #rrggbb (every
+// component with hashDigits digits).
+type hexCase struct {
+	form       string
+	comps      []hexComponent
+	hashDigits int
+}
+
+var (
+	rgbCases  = hegel.Map(many(hexComponents, 3, 3), func(cs []hexComponent) hexCase { return hexCase{form: "rgb", comps: cs} })
+	rgbaCases = hegel.Map(many(hexComponents, 4, 4), func(cs []hexComponent) hexCase { return hexCase{form: "rgba", comps: cs} })
+	hashCases = hegel.Composite(func(tc hegel.TestCase) hexCase {
+		return hexCase{form: "#", comps: hegel.Draw(tc, many(hexComponents, 3, 3)), hashDigits: hegel.Draw(tc, pick(1, 2))}
+	})
+	hexCases = hegel.OneOf(rgbCases, rgbaCases, hashCases)
+)
+
+// parts are the components' texts.
+func (h hexCase) parts() []string {
+	var out []string
+	for _, c := range h.comps {
+		if h.form == "#" {
+			out = append(out, c.textWith(h.hashDigits))
+		} else {
+			out = append(out, c.text())
+		}
+	}
+	return out
+}
+
+func (h hexCase) text() string {
+	if h.form == "#" {
+		return "#" + strings.Join(h.parts(), "")
+	}
+	return h.form + ":" + strings.Join(h.parts(), "/")
+}
+
+// want is the 8-bit RGBA XParseColor should give.
+func (h hexCase) want() []int {
+	var out []int
+	for _, p := range h.parts() {
+		out = append(out, scaleHex(p))
+	}
+	if h.form != "rgba" {
+		out = append(out, 255)
+	}
+	return out
+}
+
+// oddDigits reports whether an rgb:/rgba: component has one, three or four digits (x-ansi/14).
+func (h hexCase) oddDigits() bool {
+	if h.form == "#" {
+		return false
+	}
+	for _, c := range h.comps {
+		if c.digits != 2 {
+			return true
+		}
+	}
+	return false
+}
+
+func (h hexCase) GoString() string { return fmt.Sprintf("XParseColor(%q)", h.text()) }
+
+// ---------------------------------------------------------------- arbitrary text
+
+// arbitraryPieces: sequence bytes, controls, clusters and their parts, and a run of
+// parameter separators (so that a parameter list can reach the parser's buffer, x-ansi/1).
+var arbitraryPieces = []string{
+	"\x1b", "[", "]", "P", "_", "\\", ";", ":", "?", "<", "$", " ", "m", "h", "q", "0", "1", "9", "a", "Z", "~",
+	"\a", "\n", "\r", "\x18", "\x7f", "\u009b", "\u009c", "\u009d", "\u0090",
+	"\u00e9", "\u65e5", "\U0001F600", "\u0301", "\u200d", "\ufe0f", "\u20e3", "\u00a0", "\u3000", "-",
+	";;;;;;;;",
+}
+
+var arbitraryTexts = hegel.Map(joined(many(hegel.SampledFrom(arbitraryPieces), 0, 30)), pastSplitClusters)
+
+// pastSplitClusters drops a combining mark, joiner, variation selector or keycap that follows
+// a printable ASCII character, the space included (the region past x-ansi/5) when the switch
+// is on.
+func pastSplitClusters(s string) string {
+	if !Known.splitCluster {
+		return s
+	}
+	var sb strings.Builder
+	prevASCII := false
+	for _, r := range s {
+		if prevASCII && (r == 0x301 || r == 0x200d || r == 0xfe0f || r == 0x20e3) {
+			continue
+		}
+		prevASCII = r >= 0x20 && r <= 0x7e
+		sb.WriteRune(r)
+	}
+	return sb.String()
+}
diff --git a/ansi/hegel_model_test.go b/ansi/hegel_model_test.go
new file mode 100644
index 0000000..ff366dd
--- /dev/null
+++ b/ansi/hegel_model_test.go
@@ -0,0 +1,889 @@
+package ansi_test
+
+// The models: what the decoder, the parser, Strip and the widths must report for a token list
+// (the list is the oracle), the documentation's Truncate/TruncateLeft/Cut and Hardwrap, the
+// SGR model of the wrappers, the SGR parameter table, X11's hex scaling, the palette, and the
+// recognisers of the recorded bugs' shapes on a token list or a result.
+
+import (
+	"fmt"
+	"image/color"
+	"strconv"
+	"strings"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/ansi/parser"
+)
+
+// ---------------------------------------------------------------- the token list
+
+func join(toks []tok) string {
+	var sb strings.Builder
+	for _, t := range toks {
+		sb.WriteString(t.s)
+	}
+	return sb.String()
+}
+
+func (t tok) isSeq() bool { return t.kind >= kCSI }
+
+func (t tok) width(m ansi.Method) int {
+	if t.kind != kText {
+		return 0
+	}
+	if m == ansi.WcWidth {
+		return t.wc
+	}
+	return t.w
+}
+
+func totalWidth(toks []tok, m ansi.Method) int {
+	w := 0
+	for _, t := range toks {
+		w += t.width(m)
+	}
+	return w
+}
+
+func maxCluster(toks []tok, m ansi.Method) int {
+	w := 0
+	for _, t := range toks {
+		if t.kind == kText && t.width(m) > w {
+			w = t.width(m)
+		}
+	}
+	return w
+}
+
+// plainText is the text of the list without its sequences (what Strip returns).
+func plainText(toks []tok) string {
+	var sb strings.Builder
+	for _, tk := range toks {
+		if !tk.isSeq() {
+			sb.WriteString(tk.s)
+		}
+	}
+	return sb.String()
+}
+
+// expectedParams is the parameter list the parser documents for a token: the packed
+// parameters, of which it keeps at most parser.MaxParamsSize.
+func (t tok) expectedParams() []int {
+	if len(t.params) > parser.MaxParamsSize {
+		return t.params[:parser.MaxParamsSize]
+	}
+	return t.params
+}
+
+// packParams is the model of the parameter format: ';' separates parameters, ':' marks the
+// one before it as having sub-parameters, an empty parameter is missing, and a lone empty
+// string is no parameter at all.
+func packParams(text string) []int {
+	if text == "" {
+		return nil
+	}
+	var out []int
+	cur := -1 // -1 = missing
+	flush := func(more bool) {
+		v := parser.MissingParam
+		if cur >= 0 {
+			v = cur
+		}
+		if more {
+			v |= parser.HasMoreFlag
+		}
+		out = append(out, v)
+		cur = -1
+	}
+	for i := 0; i < len(text); i++ {
+		c := text[i]
+		switch {
+		case c >= '0' && c <= '9':
+			if cur < 0 {
+				cur = 0
+			}
+			cur = cur*10 + int(c-'0')
+		case c == ';':
+			flush(false)
+		case c == ':':
+			flush(true)
+		}
+	}
+	flush(false)
+	return out
+}
+
+func paramsOf(ps ansi.Params) []int {
+	if len(ps) == 0 {
+		return nil
+	}
+	out := make([]int, len(ps))
+	for i, p := range ps {
+		out[i] = int(p)
+	}
+	return out
+}
+
+func paramsText(ps []int) string {
+	var parts []string
+	for _, p := range ps {
+		v := ansi.Param(p)
+		s := "-"
+		if v.Param(-1) >= 0 {
+			s = strconv.Itoa(v.Param(-1))
+		}
+		if v.HasMore() {
+			s += ":"
+		}
+		parts = append(parts, s)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func sameInts(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------- the decoder
+
+type piece struct {
+	s      string
+	w      int
+	state  byte
+	cmd    int
+	params []int
+	data   string
+}
+
+func decodeAll(s string, m ansi.Method) []piece {
+	p := ansi.NewParser()
+	var out []piece
+	state := ansi.NormalState
+	for len(s) > 0 {
+		seq, w, k, ns := m.DecodeSequenceInString(s, state, p)
+		if k <= 0 {
+			panic("DecodeSequence made no progress")
+		}
+		out = append(out, piece{s: seq, w: w, state: ns, cmd: p.Command(), params: paramsOf(p.Params()), data: string(p.Data())})
+		s = s[k:]
+		state = ns
+	}
+	return out
+}
+
+// ---------------------------------------------------------------- the state machine
+
+func parseEvents(s string) []string {
+	var ev []string
+	p := ansi.NewParser()
+	p.SetHandler(ansi.Handler{
+		Print:   func(r rune) { ev = append(ev, "print "+string(r)) },
+		Execute: func(b byte) { ev = append(ev, fmt.Sprintf("exec %#x", b)) },
+		HandleCsi: func(c ansi.Cmd, ps ansi.Params) {
+			ev = append(ev, fmt.Sprintf("csi %#x %s", int(c), paramsText(paramsOf(ps))))
+		},
+		HandleEsc: func(c ansi.Cmd) { ev = append(ev, fmt.Sprintf("esc %#x", int(c))) },
+		HandleDcs: func(c ansi.Cmd, ps ansi.Params, d []byte) {
+			ev = append(ev, fmt.Sprintf("dcs %#x %s %q", int(c), paramsText(paramsOf(ps)), d))
+		},
+		HandleOsc: func(cmd int, d []byte) { ev = append(ev, fmt.Sprintf("osc %d %q", cmd, d)) },
+		HandleApc: func(d []byte) { ev = append(ev, fmt.Sprintf("apc %q", d)) },
+		HandlePm:  func(d []byte) { ev = append(ev, fmt.Sprintf("pm %q", d)) },
+		HandleSos: func(d []byte) { ev = append(ev, fmt.Sprintf("sos %q", d)) },
+	})
+	for i := 0; i < len(s); i++ {
+		p.Advance(s[i])
+	}
+	return ev
+}
+
+func expectedEvents(toks []tok) []string {
+	var ev []string
+	for _, tk := range toks {
+		switch tk.kind {
+		case kText:
+			for _, r := range tk.s {
+				ev = append(ev, "print "+string(r))
+			}
+		case kCtrl:
+			ev = append(ev, fmt.Sprintf("exec %#x", tk.s[0]))
+		case kCSI:
+			ev = append(ev, fmt.Sprintf("csi %#x %s", ansi.Command(tk.prefix, tk.inter, tk.final), paramsText(tk.expectedParams())))
+		case kESC:
+			ev = append(ev, fmt.Sprintf("esc %#x", ansi.Command(0, tk.inter, tk.final)))
+		case kDCS:
+			ev = append(ev, fmt.Sprintf("dcs %#x %s %q", ansi.Command(tk.prefix, tk.inter, tk.final), paramsText(tk.expectedParams()), tk.data))
+		case kOSC:
+			ev = append(ev, fmt.Sprintf("osc %d %q", tk.cmd, tk.data))
+		case kStr:
+			ev = append(ev, fmt.Sprintf("%s %q", map[int]string{'_': "apc", '^': "pm", 'X': "sos"}[tk.cmd], tk.data))
+		}
+		if tk.escST {
+			// ESC \ is itself an escape sequence to a VT parser: the string is dispatched at
+			// the ESC and the ST at the backslash.
+			ev = append(ev, fmt.Sprintf("esc %#x", int('\\')))
+		}
+	}
+	return ev
+}
+
+// ---------------------------------------------------------------- truncation
+
+// truncateModel follows the documentation of Truncate: unchanged when it fits; otherwise the
+// clusters that fit in length - width(tail) cells, the tail where the first one does not, and
+// every escape sequence of the input in place (so styles are closed); controls after the cut
+// are dropped.
+func truncateModel(toks []tok, m ansi.Method, length int, tail string) string {
+	if totalWidth(toks, m) <= length {
+		return join(toks)
+	}
+	limit := length - ansi.StringWidth(tail)
+	if limit < 0 {
+		return ""
+	}
+	var sb strings.Builder
+	cur, ignoring := 0, false
+	for _, tk := range toks {
+		switch {
+		case tk.isSeq():
+			sb.WriteString(tk.s)
+		case ignoring:
+		case tk.kind == kCtrl:
+			sb.WriteString(tk.s)
+		case cur+tk.w > limit && m == ansi.GraphemeWidth, cur+tk.wc > limit && m == ansi.WcWidth:
+			sb.WriteString(tail)
+			ignoring = true
+		default:
+			sb.WriteString(tk.s)
+			cur += tk.width(m)
+		}
+	}
+	return sb.String()
+}
+
+// truncateLeftModel: the first n cells are removed (a cluster straddling the boundary is kept
+// whole, as the documentation's examples have it), escape sequences before the cut are kept,
+// controls before it dropped, and the prefix goes where the kept text starts.
+func truncateLeftModel(toks []tok, m ansi.Method, nn int, prefix string) string {
+	if nn <= 0 {
+		return join(toks)
+	}
+	var sb strings.Builder
+	cur, ignoring := 0, true
+	for _, tk := range toks {
+		switch {
+		case !ignoring:
+			sb.WriteString(tk.s)
+		case tk.isSeq():
+			sb.WriteString(tk.s)
+		case tk.kind == kCtrl:
+		default:
+			cur += tk.width(m)
+			if cur > nn {
+				sb.WriteString(prefix)
+				sb.WriteString(tk.s)
+				ignoring = false
+			}
+		}
+	}
+	return sb.String()
+}
+
+// retokenize splits a string the models produced back into tokens, using the token list it
+// came from (the pieces are all substrings of the input's tokens, in order).
+func retokenize(toks []tok, s string) []tok {
+	var out []tok
+	for _, tk := range toks {
+		if strings.HasPrefix(s, tk.s) {
+			out = append(out, tk)
+			s = s[len(tk.s):]
+		}
+	}
+	return out
+}
+
+// cutModel: Cut is a Truncate to right followed by a TruncateLeft of left cells.
+func cutModel(toks []tok, m ansi.Method, l, r int) string {
+	if r <= l {
+		return ""
+	}
+	return truncateLeftModel(retokenize(toks, truncateModel(toks, m, r, "")), m, l, "")
+}
+
+// cellsBefore is the cell position of a byte offset of the list's text, counting the widths
+// of the tokens before it (what ByteToGraphemeRange should report for an offset on a token
+// boundary).
+func cellsBefore(toks []tok, offset int) int {
+	pos, cells := 0, 0
+	for _, tk := range toks {
+		if pos >= offset {
+			break
+		}
+		pos += len(tk.s)
+		cells += tk.width(ansi.GraphemeWidth)
+	}
+	return cells
+}
+
+// ---------------------------------------------------------------- hard wrapping
+
+// hardwrapModel: clusters are laid out greedily, a cluster that would exceed the limit starts a
+// new line, an explicit newline starts one too, escape sequences are transparent, and unless
+// preserveSpace is set a space at the start of a line the wrap created is dropped (the no-break
+// space is text and never dropped).
+func hardwrapModel(toks []tok, m ansi.Method, limit int, preserveSpace bool) string {
+	if limit < 1 {
+		return join(toks)
+	}
+	var sb strings.Builder
+	cur, forced := 0, false
+	for _, tk := range toks {
+		switch {
+		case tk.isSeq():
+			sb.WriteString(tk.s)
+		case tk.kind == kCtrl: // "\n" only in this property
+			sb.WriteByte('\n')
+			cur, forced = 0, false
+		default:
+			w := tk.width(m)
+			if cur > 0 && cur+w > limit {
+				sb.WriteByte('\n')
+				cur, forced = 0, true
+			}
+			if cur == 0 {
+				if !preserveSpace && forced && tk.s == " " {
+					continue
+				}
+				forced = false
+			}
+			sb.WriteString(tk.s)
+			cur += w
+		}
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------- the SGR model
+
+// srune is a printable rune with the SGR style in force where it appears: the SGR sequences
+// since the last reset, concatenated. "*" marks a rune whose style is not judged.
+type srune struct {
+	r     rune
+	style string
+}
+
+func isReset(seq string) bool { return seq == "\x1b[m" || seq == "\x1b[0m" }
+
+// styled reads a string with the decoder (checked against the grammar above) and attaches to
+// every printable rune the style in force.
+func styled(s string) []srune {
+	var out []srune
+	style := ""
+	p := ansi.NewParser()
+	state := ansi.NormalState
+	for len(s) > 0 {
+		seq, _, k, ns := ansi.DecodeSequence(s, state, p)
+		if k <= 0 {
+			panic("no progress")
+		}
+		switch {
+		case strings.HasSuffix(seq, "m") && (strings.HasPrefix(seq, "\x1b[") || seq[0] == 0x9b):
+			if isReset(seq) {
+				style = ""
+			} else {
+				style += seq
+			}
+		case seq[0] == 0x1b || seq[0] >= 0x80 && seq[0] < 0xa0:
+			// other sequences: transparent
+		case seq[0] < 0x20 || seq[0] == 0x7f:
+			out = append(out, srune{rune(seq[0]), "*"})
+		default:
+			for _, r := range seq {
+				out = append(out, srune{r, style})
+			}
+		}
+		s = s[k:]
+		state = ns
+	}
+	return out
+}
+
+// isWS: the whitespace the wrappers break at and may drop (the ideographic space is one; the
+// no-break space is text).
+func isWS(r rune) bool { return r == ' ' || r == '\n' || r == ideographicSpace }
+
+const (
+	noBreakSpace     rune = 0xa0
+	ideographicSpace rune = 0x3000
+)
+
+func nonSpace(rs []srune) []srune {
+	var out []srune
+	for _, r := range rs {
+		if !isWS(r.r) {
+			out = append(out, r)
+		}
+	}
+	return out
+}
+
+func sameStyled(a, b []srune) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].r != b[i].r {
+			return false
+		}
+		if a[i].style != b[i].style && a[i].style != "*" && b[i].style != "*" {
+			return false
+		}
+	}
+	return true
+}
+
+func showStyled(rs []srune) string {
+	var sb strings.Builder
+	for _, r := range rs {
+		fmt.Fprintf(&sb, "%q", string(r.r))
+		if r.style != "" {
+			fmt.Fprintf(&sb, "{%q}", r.style)
+		}
+		sb.WriteByte(' ')
+	}
+	return sb.String()
+}
+
+// sequences lists the escape sequences of a string in order.
+func sequences(s string) []string {
+	var out []string
+	p := ansi.NewParser()
+	state := ansi.NormalState
+	for len(s) > 0 {
+		seq, _, k, ns := ansi.DecodeSequence(s, state, p)
+		if k <= 0 {
+			panic("no progress")
+		}
+		if seq[0] == 0x1b || seq[0] >= 0x80 && seq[0] < 0xa0 {
+			out = append(out, seq)
+		}
+		s = s[k:]
+		state = ns
+	}
+	return out
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// lastWordWidth is the width, under m, of the text after the last space or breakpoint of a
+// line.
+func lastWordWidth(line string, breakpoints string, m ansi.Method) int {
+	plain := strings.TrimRight(ansi.Strip(line), " ")
+	i := strings.LastIndexAny(plain, " -"+breakpoints+string(ideographicSpace))
+	return m.StringWidth(plain[i+1:])
+}
+
+// hasLeadingSpace reports whether a line of the input starts with a space (x-ansi/19).
+func hasLeadingSpace(s string) bool {
+	for _, line := range strings.Split(ansi.Strip(s), "\n") {
+		if strings.HasPrefix(line, " ") {
+			return true
+		}
+	}
+	return false
+}
+
+// spaceSequenceSpace reports whether the document has a space followed by escape sequences
+// and then another space or the end of the text: the wrappers flush the pending whitespace
+// when the word buffer holds only sequences, without checking the limit (x-ansi/21).
+func spaceSequenceSpace(toks []tok) bool {
+	for i, t := range toks {
+		if !t.isSpace() {
+			continue
+		}
+		j := i + 1
+		for j < len(toks) && toks[j].isSeq() {
+			j++
+		}
+		if j > i+1 && (j == len(toks) || toks[j].isSpace()) {
+			return true
+		}
+	}
+	return false
+}
+
+// isSpace: a whitespace cluster the wrappers break at (not the no-break space).
+func (t tok) isSpace() bool {
+	return t.kind == kText && (t.s == " " || t.s == string(ideographicSpace))
+}
+
+// withoutLeadingSpaces drops the spaces at the start of the text and after a newline (the
+// region past x-ansi/19); sequences there are transparent.
+func withoutLeadingSpaces(toks []tok) []tok {
+	var out []tok
+	lineStart := true
+	for _, t := range toks {
+		switch {
+		case t.kind == kCtrl && t.s == "\n":
+			lineStart = true
+		case t.isSeq():
+		case t.s == " " && lineStart:
+			continue
+		default:
+			lineStart = false
+		}
+		out = append(out, t)
+	}
+	return out
+}
+
+// withoutSpaceSeqSpace drops the sequences between whitespace and whitespace or the end of
+// the text (the region past x-ansi/21).
+func withoutSpaceSeqSpace(toks []tok) []tok {
+	var out []tok
+	for i := 0; i < len(toks); i++ {
+		out = append(out, toks[i])
+		if !toks[i].isSpace() {
+			continue
+		}
+		j := i + 1
+		for j < len(toks) && toks[j].isSeq() {
+			j++
+		}
+		if j > i+1 && (j == len(toks) || toks[j].isSpace()) {
+			i = j - 1
+		}
+	}
+	return out
+}
+
+// wordWidths is the set of widths under m of the words of a document: the runs of text between
+// whitespace, hyphens, breakpoints and newlines, sequences transparent (what lastWordWidth
+// measures on a line).
+func wordWidths(toks []tok, m ansi.Method, breakpoints string) map[int]bool {
+	ws := map[int]bool{}
+	w := 0
+	for _, t := range toks {
+		switch {
+		case t.isSeq():
+		case t.kind == kText && !t.isSpace() && !strings.ContainsAny(t.s, "-"+breakpoints):
+			w += t.width(m)
+		default:
+			if w > 0 {
+				ws[w] = true
+			}
+			w = 0
+		}
+	}
+	if w > 0 {
+		ws[w] = true
+	}
+	return ws
+}
+
+// hasBreakpoint reports whether a line (or the start of the next non-empty line) holds a
+// breakpoint: a hyphen or one of bps.
+func hasBreakpoint(line, bps string) bool {
+	return strings.ContainsAny(ansi.Strip(line), "-"+bps)
+}
+
+// ---------------------------------------------------------------- shape recognisers
+
+// has reports whether a token of the list satisfies the predicate.
+func has(toks []tok, pred func(tok) bool) bool {
+	for _, t := range toks {
+		if pred(t) {
+			return true
+		}
+	}
+	return false
+}
+
+func hasText(toks []tok, s string) bool {
+	return has(toks, func(t tok) bool { return t.kind == kText && t.s == s })
+}
+
+// paramsAtLeast reports whether a CSI/DCS token has at least n parameters; paramsExactly,
+// exactly n.
+func paramsAtLeast(toks []tok, n int) bool {
+	return has(toks, func(t tok) bool { return (t.kind == kCSI || t.kind == kDCS) && len(t.params) >= n })
+}
+
+func paramsExactly(toks []tok, n int) bool {
+	return has(toks, func(t tok) bool { return (t.kind == kCSI || t.kind == kDCS) && len(t.params) == n })
+}
+
+// stInsideUTF8 reports whether a string payload holds a 0x9C byte inside a UTF-8 character
+// (x-ansi/3).
+func stInsideUTF8(toks []tok) bool {
+	return has(toks, func(t tok) bool { return t.kind >= kOSC && strings.IndexByte(t.data, 0x9c) >= 0 })
+}
+
+// utf8InStrings reports whether an SOS, PM or APC string holds a non-ASCII character
+// (x-ansi/18).
+func utf8InStrings(toks []tok) bool {
+	return has(toks, func(t tok) bool { return t.kind == kStr && t.data != asciiOnly(t.data) })
+}
+
+func asciiOnly(s string) string {
+	var sb strings.Builder
+	for i := 0; i < len(s); i++ {
+		if s[i] < 0x80 {
+			sb.WriteByte(s[i])
+		}
+	}
+	return sb.String()
+}
+
+// unsafeWc reports whether a cluster's grapheme and wc widths differ (x-ansi/6 under WcWidth).
+func unsafeWc(toks []tok) bool {
+	return has(toks, func(t tok) bool { return t.kind == kText && t.w != t.wc })
+}
+
+// splitClusterShape reports whether an arbitrary text has a printable ASCII byte (the space
+// included) followed by a combining mark, a joiner, a variation selector or a keycap
+// (x-ansi/5: the decoder takes the ASCII byte on its own; StringWidth clusters from it on).
+func splitClusterShape(s string) bool {
+	prevASCII := false
+	for _, r := range s {
+		if prevASCII && (r == 0x301 || r == 0x200d || r == 0xfe0f || r == 0x20e3) {
+			return true
+		}
+		prevASCII = r >= 0x20 && r <= 0x7e
+	}
+	return false
+}
+
+// introducerAfterIntermediate reports whether the decoder took ESC, intermediates and one of
+// [ ] P X ^ _ as the start of a CSI, OSC, DCS or string: candidate go/x-ansi-2, where the
+// table-driven functions dispatch the ESC sequence at that byte and print what follows.
+func introducerAfterIntermediate(pieces []piece) bool {
+	for _, p := range pieces {
+		s := p.s
+		if len(s) < 3 || s[0] != 0x1b || s[1] < 0x20 || s[1] > 0x2f {
+			continue
+		}
+		j := 1
+		for j < len(s) && s[j] >= 0x20 && s[j] <= 0x2f {
+			j++
+		}
+		if j < len(s) && strings.IndexByte("[]PX^_", s[j]) >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// utf8InStringPieces reports whether a decoded SOS, PM or APC string holds a non-ASCII byte
+// (x-ansi/18 met in arbitrary text: the table-driven width ends the string there and prints
+// the character; the decoder keeps it in the string).
+func utf8InStringPieces(pieces []piece) bool {
+	for _, p := range pieces {
+		s := p.s
+		switch {
+		case strings.HasPrefix(s, "\x1b_"), strings.HasPrefix(s, "\x1b^"), strings.HasPrefix(s, "\x1bX"):
+			s = s[2:]
+		case len(s) > 0 && (s[0] == 0x9f || s[0] == 0x9e || s[0] == 0x98):
+			s = s[1:]
+		default:
+			continue
+		}
+		for i := 0; i < len(s); i++ {
+			if s[i] >= 0x80 && s[i] != 0x9c {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// withoutWordsOfWidth lengthens every word of width w by a letter (the region past x-ansi/10
+// for the limit w): words as in wordWidths, sequences transparent.
+func withoutWordsOfWidth(toks []tok, w int, m ansi.Method) []tok {
+	var out []tok
+	run := 0
+	flush := func() {
+		if run == w {
+			out = append(out, cl{"a", 1, 1}.tok())
+		}
+		run = 0
+	}
+	for _, t := range toks {
+		switch {
+		case t.isSeq():
+		case t.kind == kText && !t.isSpace() && t.s != "-":
+			run += t.width(m)
+		default:
+			flush()
+		}
+		out = append(out, t)
+	}
+	flush()
+	return out
+}
+
+// isSeqPiece reports whether a decoded piece starts a sequence: ESC or a C1 introducer.
+func isSeqPiece(s string) bool {
+	return len(s) > 0 && (s[0] == 0x1b || strings.IndexByte("\x9b\x90\x9d\x9f\x9e\x98", s[0]) >= 0)
+}
+
+// bails walks the pieces where the decoder gave a sequence up (an unterminated sequence piece
+// followed by another piece) and calls fn with the two; it reports whether fn said yes to one.
+func bails(pieces []piece, fn func(p, next string) bool) bool {
+	for i := 0; i+1 < len(pieces); i++ {
+		if p := pieces[i].s; isSeqPiece(p) && !terminatedSeq(p) && fn(p, pieces[i+1].s) {
+			return true
+		}
+	}
+	return false
+}
+
+// lateMarkerPieces reports whether the decoder gave a CSI up at a private marker after its
+// parameters, printing the marker and the final (x-ansi/4 met in arbitrary text).
+func lateMarkerPieces(pieces []piece) bool {
+	return bails(pieces, func(p, next string) bool {
+		return (strings.HasPrefix(p, "\x1b[") && len(p) > 2 || p[0] == 0x9b && len(p) > 1) && len(next) == 1 && next[0] >= '<' && next[0] <= '?'
+	})
+}
+
+// controlInsideSequence reports whether the decoder gave a sequence up at a C0 control or DEL
+// (CAN, SUB and ESC aside). The table-driven functions (StringWidth, Strip, the wrappers)
+// execute the control and go on with the sequence instead, so the decoded widths and
+// StringWidth disagree: candidate go/x-ansi-1 (repro "\x1b\a[": decoded widths 1, StringWidth 0).
+func controlInsideSequence(pieces []piece) bool {
+	return bails(pieces, func(_, q string) bool {
+		return len(q) == 1 && (q[0] < 0x20 || q[0] == 0x7f) && q[0] != 0x18 && q[0] != 0x1a && q[0] != 0x1b
+	})
+}
+
+// escInsideDCS reports whether the decoder gave a DCS up at an ESC and started a sequence
+// there, where the table-driven functions take any ESC in a DCS but ESC \ as the start of an
+// ignored run and print nothing until an ST: candidate go/x-ansi-3 (repro "\x1bP\x1bP\u00e9":
+// decoded widths 1, StringWidth 0, Strip "").
+func escInsideDCS(pieces []piece) bool {
+	return bails(pieces, func(p, next string) bool {
+		return (strings.HasPrefix(p, "\x1bP") || p[0] == 0x90) && len(next) > 0 && next[0] == 0x1b
+	})
+}
+
+// decoderBailCandidate names the candidate library bug (counted, not judged) a disagreement
+// of the decoded widths with StringWidth falls under, or "" for none.
+func decoderBailCandidate(pieces []piece) string {
+	switch {
+	case controlInsideSequence(pieces):
+		return "candidate/go/x-ansi-1"
+	case introducerAfterIntermediate(pieces):
+		return "candidate/go/x-ansi-2"
+	case escInsideDCS(pieces):
+		return "candidate/go/x-ansi-3"
+	}
+	return ""
+}
+
+// terminatedSeq reports whether a sequence piece of the decoder ends where its grammar ends:
+// a CSI at a final byte, a plain ESC sequence at its final, a string at an ST (or BEL for OSC).
+func terminatedSeq(s string) bool {
+	intro, last := s[0], s[len(s)-1]
+	body := s[1:]
+	if intro == 0x1b {
+		if len(s) < 2 {
+			return false
+		}
+		switch s[1] {
+		case '[':
+			intro, body = 0x9b, s[2:]
+		case 'P':
+			intro, body = 0x90, s[2:]
+		case ']':
+			intro, body = 0x9d, s[2:]
+		case '_', '^', 'X':
+			intro, body = 0x9f, s[2:]
+		default:
+			return last >= 0x30 && last <= 0x7e
+		}
+	}
+	switch intro {
+	case 0x9b:
+		return len(body) > 0 && last >= 0x40 && last <= 0x7e
+	case 0x9d:
+		return last == 0x9c || last == '\a' || strings.HasSuffix(s, "\x1b\\")
+	default:
+		return last == 0x9c || strings.HasSuffix(s, "\x1b\\")
+	}
+}
+
+// paramSeparators counts the separators of the longest CSI or DCS parameter list in s: from
+// parser.MaxParamsSize on, the list has more parameters than the buffer (x-ansi/1).
+func paramSeparators(s string) int {
+	best := 0
+	for i := 0; i < len(s); i++ {
+		if !(s[i] == 0x9b || s[i] == 0x90 || s[i] == 0x1b && i+1 < len(s) && (s[i+1] == '[' || s[i+1] == 'P')) {
+			continue
+		}
+		c := 0
+		for j := i + 1; j < len(s) && (s[j] < 0x40 || s[j] > 0x7e); j++ {
+			if s[j] == ';' || s[j] == ':' {
+				c++
+			}
+		}
+		if c > best {
+			best = c
+		}
+	}
+	return best
+}
+
+// ---------------------------------------------------------------- colours
+
+func rgb8(c color.Color) (int, int, int) {
+	r, g, b, _ := c.RGBA()
+	return int(r >> 8), int(g >> 8), int(b >> 8)
+}
+
+func sameColor(a, b color.Color) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	r1, g1, b1, a1 := a.RGBA()
+	r2, g2, b2, a2 := b.RGBA()
+	return r1 == r2 && g1 == g2 && b1 == b2 && a1 == a2
+}
+
+// scaleHex is X11's rule: h, hh, hhh and hhhh are fractions of 4, 8, 12 and 16 bits; the
+// 8-bit value is the top byte of the 16-bit scaling.
+func scaleHex(digits string) int {
+	v, _ := strconv.ParseUint(digits, 16, 32)
+	switch len(digits) {
+	case 1:
+		return int(v) * 0x11
+	case 2:
+		return int(v)
+	case 3:
+		return int(v >> 4)
+	default:
+		return int(v >> 8)
+	}
+}
+
+func paletteRGB(i int) color.RGBA {
+	r, g, b, _ := ansi.IndexedColor(i).RGBA()
+	return color.RGBA{uint8(r >> 8), uint8(g >> 8), uint8(b >> 8), 0xff}
+}
