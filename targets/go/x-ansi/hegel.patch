+// TestHegelWrapKeepsBreakpointLinesWithinTheLimit: Wrap over text with hyphens and
+// breakpoints keeps every line within the limit (x-ansi/8 writes a breakpoint, and the
+// whitespace before it, past the limit). Past the shape: no breakpoints.
+func TestHegelWrapKeepsBreakpointLinesWithinTheLimit(t *testing.T) {
