+func (c filterMatchCase) path() pathCase {
+	elems := make([]any, len(c.vals))
+	for i, v := range c.vals {
+		switch {
+		case i == 0 || !noKnown:
+			elems[i] = map[string]any{"a": v}
+		case c.op == "":
+			elems[i] = map[string]any{"b": v}
+		default:
+			elems[i] = map[string]any{"a": filterMatchVal}
+		}
+	}
+	data, p := c.h.place(elems)
+	f := frag{kind: "filter", fkey: "a", fop: c.op}
+	if c.op != "" {
+		f.fval = filterMatchVal
+	}
+	return pathCase{data: data, fs: append(stepsFrags(p), f), max: 1}
