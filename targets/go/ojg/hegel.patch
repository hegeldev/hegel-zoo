+package hegel
+
+// Pins: one deterministic test per recorded bug, asserting the documented behaviour. Each
+// fails while the bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/ohler55/ojg/jp"
+	"github.com/ohler55/ojg/oj"
+	"github.com/ohler55/ojg/sen"
+)
+
+// ojg/1: integer literals within int64 parse as int64.
+func TestHegelPinIntLimits(t *testing.T) {
+	for _, s := range []string{"9223372036854775807", "9223372036854775800", "-9223372036854775808"} {
+		v, err := oj.ParseString(s)
+		if err != nil {
+			t.Fatalf("ParseString(%s): %v", s, err)
+		}
+		if _, ok := v.(int64); !ok {
+			t.Errorf("ParseString(%s) = %T %v, want int64", s, v, v)
+		}
+	}
+}
+
+// ojg/2: Validate rejects documents with unclosed arrays or objects.
+func TestHegelPinValidateTruncated(t *testing.T) {
+	for _, s := range []string{"[", "[1,2", `{"a":1`, `["a"`, "[[", "{} ["} {
+		if err := oj.ValidateString(s); err == nil {
+			t.Errorf("ValidateString(%q) accepted a truncated document", s)
+		}
+	}
+}
+
+// ojg/3: Set on the index just past the end of an array adds the element, as documented.
+func TestHegelPinSetAppend(t *testing.T) {
+	a := []any{int64(1)}
+	if err := jp.MustParseString("$[1]").Set(a, int64(2)); err != nil {
+		t.Fatalf("Set $[1] on [1]: %v", err)
+	}
+	m := map[string]any{"a": []any{int64(1)}}
+	if err := jp.MustParseString("$.a[1]").Set(m, int64(2)); err != nil {
+		t.Fatalf("Set $.a[1] on {a:[1]}: %v", err)
+	}
+	if got := canon(m); got != `{"a":[i1,i2]}` {
+		t.Errorf("Set $.a[1] on {a:[1]} = %s", got)
+	}
+}
+
+// ojg/4: Del of an index outside the array is a no-op, like Remove and like a missing key.
+func TestHegelPinDelOutOfRange(t *testing.T) {
+	a := []any{int64(1)}
+	if err := jp.MustParseString("$[5]").Del(a); err != nil {
+		t.Errorf("Del $[5] on [1]: %v", err)
+	}
+	if err := jp.MustParseString("$[-5]").DelOne(a); err != nil {
+		t.Errorf("DelOne $[-5] on [1]: %v", err)
+	}
+	if got := canon(a); got != "[i1]" {
+		t.Errorf("array changed to %s", got)
+	}
+}
+
+// ojg/5: a string starting with '-' survives a SEN round trip.
+func TestHegelPinSENDash(t *testing.T) {
+	for _, s := range []string{"-", "-a", "-1", "--"} {
+		out := sen.String(s)
+		v, err := sen.Parse([]byte(out))
+		if err != nil {
+			t.Errorf("sen.Parse(sen.String(%q) = %q): %v", s, out, err)
+		} else if v != s {
+			t.Errorf("sen.Parse(sen.String(%q) = %q) = %#v", s, out, v)
+		}
+	}
+}
+
+// ojg/6: the strings "null", "true" and "false" survive a SEN round trip.
+func TestHegelPinSENLiteral(t *testing.T) {
+	for _, s := range []string{"null", "true", "false"} {
+		out := sen.String(s)
+		v, err := sen.Parse([]byte(out))
+		if err != nil {
+			t.Errorf("sen.Parse(sen.String(%q) = %q): %v", s, out, err)
+		} else if v != s {
+			t.Errorf("sen.Parse(sen.String(%q) = %q) = %#v", s, out, v)
+		}
+	}
+}
+
+// ojg/7: String() of a descent followed by a bracket fragment parses back.
+func TestHegelPinDescentString(t *testing.T) {
+	for _, s := range []string{"$..[0]", "$..[1:2]", "$..['a b']", "$..[?(@.a)]", "$..[0,1]"} {
+		x := jp.MustParseString(s)
+		if _, err := jp.ParseString(x.String()); err != nil {
+			t.Errorf("ParseString(%s).String() = %q does not parse: %v", s, x.String(), err)
+		}
+	}
+}
+
+// ojg/8: BracketString() of an expression with a descent parses back.
+func TestHegelPinDescentBracket(t *testing.T) {
+	for _, s := range []string{"$..a", "$..*", "$[0]..b"} {
+		x := jp.MustParseString(s)
+		if _, err := jp.ParseString(x.BracketString()); err != nil {
+			t.Errorf("ParseString(%s).BracketString() = %q does not parse: %v", s, x.BracketString(), err)
+		}
+	}
+}
+
+// ojg/9: a number with a decimal point but no fraction digits is rejected, as by Validate.
+func TestHegelPinParseBareDot(t *testing.T) {
+	for _, s := range []string{"1.", "[1.]", "1.e5", `{"a":2.}`} {
+		if v, err := oj.ParseString(s); err == nil {
+			t.Errorf("ParseString(%q) = %v, want an error", s, v)
+		}
+	}
+}
+
+// ojg/10: Remove with a union resolves negative indices like Del and Set do.
+func TestHegelPinRemoveUnionNegative(t *testing.T) {
+	r, err := jp.MustParseString("$[0,-1]").Remove([]any{"a", "b", "c"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := canon(r); got != `["b"]` {
+		t.Errorf("Remove $[0,-1] on [a,b,c] = %s, want [b]", got)
+	}
+}
+
+// ojg/11: a negative-step slice on an empty array selects nothing and does not panic.
+func TestHegelPinSliceEmpty(t *testing.T) {
+	for _, s := range []string{"$[:0:-1]", "$[-1::-1]", "$[1:0:-1]", "$[:5:-1]"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("%s on []: panic %v", s, r)
+				}
+			}()
+			if got := jp.MustParseString(s).Get([]any{}); len(got) != 0 {
+				t.Errorf("%s on [] = %v", s, got)
+			}
+		}()
+	}
+}
+
+// ojg/12: negative-step slices with bounds outside the array select nothing (RFC 9535).
+func TestHegelPinSliceNegClamp(t *testing.T) {
+	a := []any{"a", "b", "c"}
+	for _, s := range []string{"$[:5:-1]", "$[-5::-1]", "$[3:1:-1]"} {
+		want := ""
+		if s == "$[3:1:-1]" {
+			want = `["c"]`
+		}
+		got := canonList(jp.MustParseString(s).Get(a))
+		if want == "" && got != "[]" || want != "" && got != "["+strings.Trim(want, "[]")+"]" {
+			t.Errorf("%s on [a,b,c] = %s", s, got)
+		}
+	}
+}
+
+// ojg/13: a UTF-16 surrogate pair escape decodes to the character it encodes (RFC 8259, 7).
+func TestHegelPinSurrogatePair(t *testing.T) {
+	bs := string(rune(92))
+	for _, esc := range []string{"ud83d" + bs + "ude00", "uD83D" + bs + "uDE00"} {
+		v, err := oj.ParseString("\"" + bs + esc + "\"")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if v != "\U0001F600" {
+			t.Errorf("ParseString(%q) = %q, want %q", bs+esc, v, "\U0001F600")
+		}
+	}
+}
+
+// ojg/14: String() of a union with a quote or backslash in a key escapes it and parses back
+// to the same selection.
+func TestHegelPinUnionQuote(t *testing.T) {
+	bs := string(rune(92))
+	data := map[string]any{"k'q": int64(1), "back" + bs + "slash": int64(2), "backslash": int64(3), "kq": int64(4)}
+	for _, src := range []string{"$[0,'k" + bs + "'q']", "$[0,'back" + bs + bs + "slash']"} {
+		x := jp.MustParseString(src)
+		for _, s := range []string{x.String(), x.BracketString()} {
+			y, err := jp.ParseString(s)
+			if err != nil {
+				t.Errorf("%s: %q does not parse: %v", src, s, err)
+			} else if !sameMulti(y.Get(data), x.Get(data)) {
+				t.Errorf("%s: %q selects %s, want %s", src, s, canonList(y.Get(data)), canonList(x.Get(data)))
+			}
+		}
+	}
+}
+
+// ojg/15: Locate returns at most max paths for a slice too.
+func TestHegelPinLocateMaxSlice(t *testing.T) {
+	a := []any{"a", "b", "c"}
+	for _, s := range []string{"$[::-1]", "$[1:3]", "$[:]"} {
+		if l := jp.MustParseString(s).Locate(a, 1); len(l) != 1 {
+			t.Errorf("%s: Locate(max 1) = %v", s, l)
+		}
+	}
+}
+
+// ojg/16: Match with a descent visits every descendant, like Get, including the contents of
+// an element that matched.
+func TestHegelPinMatchDescentWildcard(t *testing.T) {
+	for _, tc := range []struct {
+		data string
+		path string
+		want int
+	}{{`["a",["d","e"],{"a":"f"}]`, "$..*", 6}, {`[0,[0,1]]`, "$..[1]", 2}, {`{"a":{"b":1}}`, "$..*", 2}} {
+		var found []any
+		if err := oj.MatchString(tc.data, func(_ jp.Expr, v any) { found = append(found, v) }, jp.MustParseString(tc.path)); err != nil {
+			t.Fatal(err)
+		}
+		if len(found) != tc.want {
+			t.Errorf("Match %s on %s found %d values %s, want %d", tc.path, tc.data, len(found), canonList(found), tc.want)
+		}
+	}
+}
+
+// ojg/17: Match with a filter calls back once per matching element, with its own path.
+func TestHegelPinMatchFilterAll(t *testing.T) {
+	data := []any{"a", "b", "c"}
+	var found []any
+	var paths []string
+	if err := oj.MatchString(oj.JSON(data), func(p jp.Expr, v any) { found = append(found, v); paths = append(paths, p.String()) }, jp.MustParseString("$[?(@ != 1)]")); err != nil {
+		t.Fatal(err)
+	}
+	if canonList(found) != `["a" "b" "c"]` || strings.Join(paths, " ") != "$[0] $[1] $[2]" {
+		t.Errorf("Match found %s at %v", canonList(found), paths)
+	}
+}
+
+// ojg/18: a truncated literal followed by a comma is a parse error, not a dropped value.
+func TestHegelPinTruncatedLiteral(t *testing.T) {
+	for _, s := range []string{"[nul,1]", "[n,1]", "[tru,2]", "[fals,3]", "nul,1"} {
+		if v, err := oj.ParseString(s); err == nil {
+			t.Errorf("ParseString(%q) = %s, want an error", s, canon(v))
+		}
+		if err := oj.ValidateString(s); err == nil {
+			t.Errorf("ValidateString(%q) accepted", s)
+		}
+	}
+}
+
+// ojg/19: an object member with no value before the closing brace is a parse error, not a
+// dropped member.
+func TestHegelPinMemberWithoutValue(t *testing.T) {
+	for _, s := range []string{`{"a":}`, `{"a": }`, `{"b":1,"a":}`, `[{"a":}]`, `{"a":{"b":}}`} {
+		if v, err := oj.ParseString(s); err == nil {
+			t.Errorf("ParseString(%q) = %s, want an error", s, canon(v))
+		}
+		if err := oj.ValidateString(s); err == nil {
+			t.Errorf("ValidateString(%q) accepted", s)
+		}
+	}
+}
+
+// ojg/20: a truncated literal member followed by a comma and another member is a clean parse
+// error, not a panic.
+func TestHegelPinTruncatedLiteralMember(t *testing.T) {
+	for _, s := range []string{`{"k":nul,"a":1}`, `{"k":tru,"a":1}`, `{"k":fals,"a":1}`, `{"k":n, "a":1}`, `{"a":{"k":nul,"b":1}}`} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("ParseString(%q): panic %v", s, r)
+				}
+			}()
+			if v, err := oj.ParseString(s); err == nil {
+				t.Errorf("ParseString(%q) = %s, want an error", s, canon(v))
+			}
+		}()
+		if err := oj.ValidateString(s); err == nil {
+			t.Errorf("ValidateString(%q) accepted", s)
+		}
+	}
+}
+
+// ojg/21: a filter comparing a float member with "!=" to a string, a boolean, null or a
+// different float selects the element, as it does for an integer member.
+func TestHegelPinFilterFloatNotEqual(t *testing.T) {
+	data := []any{map[string]any{"a": 0.5}}
+	for _, s := range []string{"$[?(@.a != 'zzz')]", "$[?(@.a != true)]", "$[?(@.a != null)]", "$[?(@.a != 1.5)]"} {
+		if got := jp.MustParseString(s).Get(data); len(got) != 1 {
+			t.Errorf("%s on [{a:0.5}] = %s, want the element", s, canonList(got))
+		}
+	}
+}
+
+// ojg/22: a string starting with a byte order mark survives a SEN round trip.
+func TestHegelPinSENBOM(t *testing.T) {
+	for _, s := range []string{"\ufeff123", "\ufeffabc", "\ufefftrue", "\ufeff-1"} {
+		out := sen.String(s)
+		v, err := sen.Parse([]byte(out))
+		if err != nil {
+			t.Errorf("sen.Parse(sen.String(%q) = %q): %v", s, out, err)
+		} else if v != s {
+			t.Errorf("sen.Parse(sen.String(%q) = %q) = %#v", s, out, v)
+		}
+	}
+}
+
+// ojg/23: a zero integer part followed by an exponent is a valid JSON number.
+func TestHegelPinZeroExponent(t *testing.T) {
+	for _, s := range []string{"0e5", "0e+100", "-0E1", "0E5", "0e-1", "[0e5]"} {
+		if _, err := oj.ParseString(s); err != nil {
+			t.Errorf("ParseString(%q): %v", s, err)
+		}
+		if err := oj.ValidateString(s); err != nil {
+			t.Errorf("ValidateString(%q): %v", s, err)
+		}
+		if _, err := sen.Parse([]byte(s)); err != nil {
+			t.Errorf("sen.Parse(%q): %v", s, err)
+		}
+	}
+}
