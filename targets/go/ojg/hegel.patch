+package hegel
+
+// The seven wide properties. Each draws one case record (a value, a spelling tape, a
+// mutation list, a path, an edit) and judges it with the checks below, which the narrow
+// properties of hegel_shapes_test.go reuse over the recorded bugs' shape regions.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/ohler55/ojg"
+	"github.com/ohler55/ojg/alt"
+	"github.com/ohler55/ojg/jp"
+	"github.com/ohler55/ojg/oj"
+	"github.com/ohler55/ojg/sen"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- helpers
+
+// stdDecode decodes JSON text with encoding/json and applies ojg's number convention: an
+// integer literal that fits int64 is an int64, any other number a float64.
+func stdDecode(s string) (any, error) {
+	dec := json.NewDecoder(strings.NewReader(s))
+	dec.UseNumber()
+	var v any
+	if err := dec.Decode(&v); err != nil {
+		return nil, err
+	}
+	if _, err := dec.Token(); err == nil {
+		return nil, fmt.Errorf("trailing data")
+	}
+	return stdNumbers(v), nil
+}
+
+func stdNumbers(v any) any {
+	switch t := v.(type) {
+	case json.Number:
+		s := string(t)
+		if !strings.ContainsAny(s, ".eE") {
+			if i, err := strconv.ParseInt(s, 10, 64); err == nil {
+				return i
+			}
+			return t
+		}
+		f, _ := strconv.ParseFloat(s, 64)
+		return f
+	case []any:
+		for i, e := range t {
+			t[i] = stdNumbers(e)
+		}
+	case map[string]any:
+		for k, e := range t {
+			t[k] = stdNumbers(e)
+		}
+	}
+	return v
+}
+
+// stdStreamValid reports whether s is a sequence of zero or more valid JSON documents (the
+// contract of oj.Validate, which accepts streams), whether consecutive documents are
+// separated by whitespace (where they are not, as in "7-9", the split is a matter of taste),
+// and the text from the first document that fails.
+func stdStreamValid(s string) (valid, separated bool, rest string) {
+	dec := json.NewDecoder(strings.NewReader(s))
+	separated = true
+	end := int64(0)
+	for {
+		var v json.RawMessage // syntax only: a number out of float64 range is still valid JSON
+		if end > 0 {
+			i := int(end)
+			if i < len(s) && !strings.ContainsRune(" \t\r\n", rune(s[i])) {
+				separated = false
+			}
+		}
+		err := dec.Decode(&v)
+		if err == io.EOF {
+			return true, separated, ""
+		}
+		if err != nil {
+			return false, separated, s[end:]
+		}
+		end = dec.InputOffset()
+	}
+}
+
+// safeParse is oj.ParseString with a recover, for the recorded panic (ojg/20).
+func safeParse(s string) (v any, panicked any, err error) {
+	defer func() { panicked = recover() }()
+	v, err = oj.ParseString(s)
+	return
+}
+
+// incomplete reports whether oj.Parse calls the text an incomplete document.
+func incomplete(s string) bool {
+	_, _, err := safeParse(s)
+	return err != nil && strings.Contains(err.Error(), "incomplete JSON")
+}
+
+var bareDotRx = regexp.MustCompile(`[0-9]\.([^0-9]|$)`)
+
+// truncLitRx matches a truncated literal followed by a comma (bug 18); the text is only used
+// when encoding/json rejects it, so a match inside a string cannot be the reason.
+var truncLitRx = regexp.MustCompile(`(^|[^A-Za-z])(n|nu|nul|t|tr|tru|f|fa|fal|fals),`)
+
+// missingValueRx matches an object member whose value is missing before the closing brace,
+// which Parse and Validate accept and drop (bug 19).
+var missingValueRx = regexp.MustCompile(`:[ \t\r\n]*}`)
+
+// memberTruncLitRx matches an object member whose value is a truncated literal followed at once
+// by a comma: with a member after it, Parse, Parser.Parse and Unmarshal panic with "assignment
+// to entry in nil map" (bug 20); under HEGEL_NO_KNOWN=1 the text is skipped before any parser
+// sees it. The gate matches inside string literals too, as zeroExpRx does.
+var memberTruncLitRx = regexp.MustCompile(`:[ \t\r\n]*(n|nu|nul|t|tr|tru|f|fa|fal|fals),`)
+
+// zeroExpRx matches a number whose integer part is a bare 0 followed at once by an exponent
+// (0e5, -0E+1): valid JSON that Parse, Validate and sen.Parse reject as an invalid number
+// (bug 23; 0.0e5 and 10e5 parse).
+var zeroExpRx = regexp.MustCompile(`(^|[^0-9.])-?0[eE]`)
+
+// safeGet is x.Get with a recover, for the recorded panic.
+func safeGet(x jp.Expr, data any) (results []any, panicked any) {
+	defer func() { panicked = recover() }()
+	return x.Get(data), nil
+}
+
+// keysSorted reports whether every object in the JSON text s lists its keys in ascending order.
+func keysSorted(s string) bool {
+	dec := json.NewDecoder(strings.NewReader(s))
+	type frame struct {
+		obj     bool
+		last    string
+		expects bool // next token in an object is a key
+	}
+	var stack []frame
+	for {
+		tok, err := dec.Token()
+		if err != nil {
+			return true
+		}
+		switch t := tok.(type) {
+		case json.Delim:
+			switch t {
+			case '{':
+				stack = append(stack, frame{obj: true, expects: true})
+			case '[':
+				stack = append(stack, frame{})
+			case '}', ']':
+				stack = stack[:len(stack)-1]
+				if len(stack) > 0 && stack[len(stack)-1].obj {
+					stack[len(stack)-1].expects = true
+				}
+			}
+			continue
+		}
+		if len(stack) == 0 {
+			continue
+		}
+		top := &stack[len(stack)-1]
+		if top.obj {
+			if top.expects {
+				k, _ := tok.(string)
+				if k < top.last {
+					return false
+				}
+				top.last = k
+				top.expects = false
+			} else {
+				top.expects = true
+			}
+		}
+	}
+}
+
+func inMulti(v any, list []any) bool {
+	c := canon(v)
+	for _, e := range list {
+		if canon(e) == c {
+			return true
+		}
+	}
+	return false
+}
+
+func canonList(list []any) string {
+	parts := make([]string, len(list))
+	for i, e := range list {
+		parts[i] = canon(e)
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+func sameMultiLoose(a, b []any) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	as := make([]string, len(a))
+	bs := make([]string, len(b))
+	for i := range a {
+		as[i] = canonLoose(a[i])
+		bs[i] = canonLoose(b[i])
+	}
+	sortStrings(as)
+	sortStrings(bs)
+	for i := range as {
+		if as[i] != bs[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- parsing
+
+// textCase: a value and the spelling of its JSON text.
+type textCase struct {
+	v    any
+	tape tape
+}
+
+func (c textCase) GoString() string {
+	r := render(c.v, c.tape)
+	return fmt.Sprintf("value %s as text %q", canon(c.v), r.text)
+}
+
+// limitIntValues is an integer at the int64 limits (the shape of ojg/1) at the top or in a
+// host; parseValues (the values of the parse and write properties) draws it two times in five
+// by default, so that the first hundred cases of a run meet the shape several times (the tree
+// alone meets it in one case in fourteen, in runs of a few), and never under HEGEL_NO_KNOWN=1.
+var (
+	limitIntValues = hegel.Composite(func(tc hegel.TestCase) any {
+		data, _ := hegel.Draw(tc, hosts).place(hegel.Draw(tc, hegel.SampledFrom(intLimits)))
+		return data
+	})
+	parseValues = shaped(weighted(choice[any]{3, valueAt(3)}, choice[any]{2, limitIntValues}), valueAt(3))
+	jsonTexts   = hegel.Composite(func(tc hegel.TestCase) textCase {
+		return textCase{v: hegel.Draw(tc, parseValues), tape: hegel.Draw(tc, tapes)}
+	})
+)
+
+// checkParse: the text parses to exactly v through every parsing entry point (Unmarshal into
+// an interface follows encoding/json and gives float64 for every number). The int64-limit
+// integers (ojg/1) and a surrogate pair escape (ojg/13) are the recorded shapes named on a
+// failure, beside the caller's.
+func checkParse(ht *hegel.T, col *collector, v any, r rendered, extra ...string) {
+	text := r.text
+	if !json.Valid([]byte(text)) {
+		col.failClass(ht, "EmitterInvalid", "model emitted invalid JSON %q", text)
+		return
+	}
+	sh := shapes(append([]string{known("ojg/1", hasLimitInt(v)), known("ojg/13", r.pairs)}, extra...)...)
+	want := canon(v)
+	got, err := oj.ParseString(text)
+	if err != nil {
+		col.mismatch(ht, sh, "ParseErr", "ParseString(%q) error %v", text, err)
+	} else if canon(got) != want {
+		col.mismatch(ht, sh, "ParseValue", "ParseString(%q) = %s, want %s", text, canon(got), want)
+	}
+	if err := oj.ValidateString(text); err != nil {
+		col.mismatch(ht, sh, "ValidateErr", "ValidateString(%q) error %v", text, err)
+	}
+	var p oj.Parser
+	got2, err := p.Parse([]byte(text))
+	if err != nil {
+		col.mismatch(ht, sh, "ParserErr", "Parser.Parse(%q) error %v", text, err)
+	} else if canon(got2) != want {
+		col.mismatch(ht, sh, "ParserValue", "Parser.Parse(%q) = %s, want %s", text, canon(got2), want)
+	}
+	got3, err := oj.Load(strings.NewReader(text))
+	if err != nil {
+		col.mismatch(ht, sh, "LoadErr", "Load(%q) error %v", text, err)
+	} else if canon(got3) != want {
+		col.mismatch(ht, sh, "LoadValue", "Load(%q) = %s, want %s", text, canon(got3), want)
+	}
+	var u any
+	if err := oj.Unmarshal([]byte(text), &u); err != nil {
+		col.mismatch(ht, sh, "UnmarshalErr", "Unmarshal(%q) error %v", text, err)
+	} else if canon(u) != canon(floatify(v)) {
+		col.mismatch(ht, sh, "UnmarshalValue", "Unmarshal(%q) = %s, want %s", text, canon(u), canon(floatify(v)))
+	}
+	got4, err := sen.Parse([]byte(text))
+	if err != nil {
+		col.mismatch(ht, sh, "SENParseErr", "sen.Parse(%q) error %v", text, err)
+	} else if canon(got4) != want {
+		col.mismatch(ht, sh, "SENParseValue", "sen.Parse(%q) = %s, want %s", text, canon(got4), want)
+	}
+}
+
+// TestHegelParse: JSON text written by the model with random whitespace, escapes and number
+// spellings parses to exactly the value it was written from, through every parsing entry point
+// (Unmarshal into an interface follows encoding/json and gives float64 for every number).
+// Integers at the int64 limits (ojg/1) and surrogate pair escapes (ojg/13) are drawn by
+// default; HEGEL_NO_KNOWN=1 draws past them.
+func TestHegelParse(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, jsonTexts)
+		col.count("cases")
+		checkParse(ht, col, c.v, render(c.v, c.tape))
+	})
+}
+
+// --------------------------------------------------------------------------- writing
+
+// writeCase: a value, the indent of the indented form and whether the sorted form is indented.
+type writeCase struct {
+	v            any
+	indent       int
+	sortedIndent bool
+}
+
+func (c writeCase) GoString() string {
+	return fmt.Sprintf("value %s, indent %d, sorted indent %v", canon(c.v), c.indent, c.sortedIndent)
+}
+
+var writeCases = hegel.Composite(func(tc hegel.TestCase) writeCase {
+	return writeCase{v: hegel.Draw(tc, parseValues), indent: hegel.Draw(tc, hegel.Integers(1, 4)), sortedIndent: hegel.Draw(tc, chance(50))}
+})
+
+// TestHegelWrite: the JSON written by oj (plain, indented, sorted, Marshal, Write) is valid,
+// decodes with encoding/json to the value written (ints and integral floats alike, as JSON
+// has no distinction), keeps sorted keys when asked, and parses back with oj itself (not for
+// an integer at the int64 limits, ojg/1).
+func TestHegelWrite(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, writeCases)
+		col.count("cases")
+		v := c.v
+		want := canonLoose(v)
+		check := func(what, s string) {
+			if !json.Valid([]byte(s)) {
+				col.failClass(ht, what+"Invalid", "%s of %s = %q is not valid JSON", what, canon(v), s)
+				return
+			}
+			dec, err := stdDecode(s)
+			if err != nil {
+				col.failClass(ht, what+"Decode", "%s of %s = %q: encoding/json %v", what, canon(v), s, err)
+				return
+			}
+			if canonLoose(dec) != want {
+				col.failClass(ht, what+"Value", "%s of %s = %q decodes to %s", what, canon(v), s, canonLoose(dec))
+			}
+		}
+		s := oj.JSON(v)
+		check("JSON", s)
+		sh := shapes(known("ojg/1", hasLimitInt(v)))
+		if back, err := oj.ParseString(s); err != nil {
+			col.mismatch(ht, sh, "RoundTripErr", "ParseString(JSON(%s) = %q) error %v", canon(v), s, err)
+		} else if canonLoose(back) != want {
+			col.mismatch(ht, sh, "RoundTrip", "ParseString(JSON(%s) = %q) = %s", canon(v), s, canonLoose(back))
+		}
+		check("Indent", oj.JSON(v, c.indent))
+		opts := ojg.DefaultOptions
+		opts.Sort = true
+		if c.sortedIndent {
+			opts.Indent = 2
+		}
+		sorted := oj.JSON(v, &opts)
+		check("Sorted", sorted)
+		if !keysSorted(sorted) {
+			col.failClass(ht, "SortedOrder", "JSON(%s, Sort) = %q has unsorted keys", canon(v), sorted)
+		}
+		b, err := oj.Marshal(v)
+		if err != nil {
+			col.failClass(ht, "MarshalErr", "Marshal(%s) error %v", canon(v), err)
+		} else {
+			check("Marshal", string(b))
+		}
+		var buf bytes.Buffer
+		if err := oj.Write(&buf, v); err != nil {
+			col.failClass(ht, "WriteErr", "Write(%s) error %v", canon(v), err)
+		} else {
+			check("Write", buf.String())
+		}
+		if !json.Valid([]byte(s)) {
+			return
+		}
+		if err := oj.ValidateString(s); err != nil {
+			col.failClass(ht, "ValidateOwn", "ValidateString(JSON(%s) = %q) error %v", canon(v), s, err)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- invalid texts
+
+// invalidCase: a value, the spelling of its text and the mutations applied to it.
+type invalidCase struct {
+	v    any
+	tape tape
+	muts []mutation
+}
+
+func (c invalidCase) text() string { return mutate(render(c.v, c.tape).text, c.muts) }
+
+func (c invalidCase) GoString() string {
+	return fmt.Sprintf("text %q mutated by %#v to %q", render(c.v, c.tape).text, c.muts, c.text())
+}
+
+var invalidCases = hegel.Composite(func(tc hegel.TestCase) invalidCase {
+	return invalidCase{v: hegel.Draw(tc, valueAt(2)), tape: hegel.Draw(tc, tapes), muts: hegel.Draw(tc, mutationLists)}
+})
+
+// judgeText: oj.Parse accepts m exactly when it is a single valid document (or nothing but
+// whitespace) and oj.Validate exactly when it is a valid document stream, as encoding/json
+// sees them, and Parse does not panic. The recorded shapes named on a disagreement are a bare
+// decimal point (ojg/9), a literal cut before a comma (ojg/18), a member without a value before
+// a closing brace (ojg/19), a truncated literal member before a comma under Parse (ojg/20, the
+// panic), an unclosed container under Validate (ojg/2) and a bare zero before an exponent
+// (ojg/23), beside the caller's; under HEGEL_NO_KNOWN=1 the verdict a shape would falsify is
+// excused (a byte edit reaches the shapes often enough that an Assume would reject too much),
+// except that the text Parse would panic on is skipped before any parser sees it.
+func judgeText(ht *hegel.T, col *collector, m string, extra ...string) {
+	memberTrunc := memberTruncLitRx.MatchString(m)
+	if Known.truncatedMemberPanics && memberTrunc {
+		col.count("assumed ojg/20")
+		ht.Assume(false)
+	}
+	stdSingle := json.Valid([]byte(m)) || strings.Trim(m, " \t\r\n") == "" // JSON whitespace only
+	stdStream, separated, rest := stdStreamValid(m)
+	vErr := oj.ValidateString(m)
+	_, pPanic, pErr := safeParse(m)
+	if pPanic != nil {
+		col.mismatch(ht, shapes(append([]string{known("ojg/20", memberTrunc)}, extra...)...), "ParsePanic", "%q: Parse panics: %v", m, pPanic)
+		return
+	}
+	bareDot, truncLit := bareDotRx.MatchString(m), truncLitRx.MatchString(m)
+	missingValue, zeroExp := missingValueRx.MatchString(m), zeroExpRx.MatchString(m)
+	if (pErr == nil) != stdSingle {
+		switch {
+		case pErr != nil && col.excused("ojg/23", zeroExp):
+		case pErr != nil:
+			col.mismatch(ht, shapes(append([]string{known("ojg/23", zeroExp)}, extra...)...), "ParseStrict", "%q: Parse rejects (%v), encoding/json accepts", m, pErr)
+		case col.excused("ojg/9", bareDot) || col.excused("ojg/18", truncLit) || col.excused("ojg/19", missingValue):
+		default:
+			sh := shapes(append([]string{known("ojg/9", bareDot), known("ojg/18", truncLit), known("ojg/19", missingValue)}, extra...)...)
+			col.mismatch(ht, sh, "ParseLenient", "%q: Parse accepts, encoding/json rejects", m)
+		}
+	}
+	if !separated {
+		col.count("unseparated stream")
+		return
+	}
+	if (vErr == nil) != stdStream {
+		unclosed := incomplete(m) || incomplete(rest)
+		switch {
+		case vErr != nil && col.excused("ojg/23", zeroExp):
+		case vErr != nil:
+			col.mismatch(ht, shapes(append([]string{known("ojg/23", zeroExp)}, extra...)...), "ValidateStrict", "%q: Validate rejects (%v), encoding/json accepts the stream", m, vErr)
+		case col.excused("ojg/2", unclosed) || col.excused("ojg/18", truncLit) || col.excused("ojg/19", missingValue):
+		default:
+			sh := shapes(append([]string{known("ojg/2", unclosed), known("ojg/18", truncLit), known("ojg/19", missingValue)}, extra...)...)
+			col.mismatch(ht, sh, "ValidateLenient", "%q: Validate accepts, encoding/json rejects the stream (Parse: %v)", m, pErr)
+		}
+	}
+}
+
+// TestHegelInvalid: on a randomly mutated JSON text, oj.Parse accepts exactly the single valid
+// documents (or nothing but whitespace) without panicking and oj.Validate exactly the valid
+// document streams, as encoding/json sees them. The mutations include a bare decimal point
+// (ojg/9), a literal cut before a comma (ojg/18, and in an object member ojg/20) and an
+// unclosed container (ojg/2) by default, and the byte edits reach a member without a value
+// (ojg/19) and a zero before an exponent (ojg/23); HEGEL_NO_KNOWN=1 draws byte edits only.
+func TestHegelInvalid(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, invalidCases)
+		col.count("cases")
+		judgeText(ht, col, c.text())
+	})
+}
+
+// --------------------------------------------------------------------------- JSONPath
+
+// pathCase: data, a path over it, the form the path is written in, and the max of the
+// Locate check.
+type pathCase struct {
+	data    any
+	fs      []frag
+	bracket bool
+	max     int
+}
+
+func (c pathCase) text() string { return pathText(c.fs, c.bracket) }
+
+func (c pathCase) GoString() string {
+	return fmt.Sprintf("%s on %s (Locate max %d)", c.text(), canon(c.data), c.max)
+}
+
+// pathCasesOver is a path case over data drawn from the given generator; under
+// HEGEL_NO_KNOWN=1 a filter matching several elements (ojg/17) is narrowed to one match.
+func pathCasesOver(data hegel.Generator[any]) hegel.Generator[pathCase] {
+	return hegel.FlatMap(data, func(d any) hegel.Generator[pathCase] {
+		paths := pathsFor(keysOf(d))
+		return hegel.Composite(func(tc hegel.TestCase) pathCase {
+			fs := hegel.Draw(tc, paths)
+			if noKnown {
+				fs = pastFilterSeveral(d, fs)
+			}
+			return pathCase{data: d, fs: fs, bracket: hegel.Draw(tc, chance(30)), max: hegel.Draw(tc, hegel.Integers(1, 3))}
+		})
+	})
+}
+
+var pathCases = pathCasesOver(containersAt(3))
+
+// parsePath parses the case's path text, or fails the case.
+func parsePath(ht *hegel.T, col *collector, c pathCase) (jp.Expr, bool) {
+	x, err := jp.ParseString(c.text())
+	if err != nil {
+		col.failClass(ht, "PathParse", "ParseString(%q) error %v", c.text(), err)
+		return nil, false
+	}
+	return x, true
+}
+
+// checkGet: Get matches the brute-force evaluation (a panic names ojg/11 on a negative-step
+// slice; a filter comparing a float64 member with "!=" to anything but an integer names
+// ojg/21); First, FirstFound and Has agree; the results are returned.
+func checkGet(ht *hegel.T, col *collector, c pathCase, x jp.Expr, extra ...string) ([]any, bool) {
+	text, data := c.text(), c.data
+	want := evalPath(data, c.fs)
+	got, panicked := safeGet(x, data)
+	if panicked != nil {
+		col.mismatch(ht, shapes(append([]string{known("ojg/11", hasNegStepSlice(c.fs))}, extra...)...), "GetPanic", "%s on %s: Get panics: %v", text, canon(data), panicked)
+		return nil, false
+	}
+	if !sameMulti(got, want) {
+		col.mismatch(ht, shapes(append([]string{known("ojg/21", hasFloatNeq(data, c.fs))}, extra...)...), "Get", "%s on %s: Get = %s, want %s", text, canon(data), canonList(got), canonList(want))
+	}
+	first, ok := x.FirstFound(data)
+	if ok != (len(want) > 0) {
+		col.failClass(ht, "FirstFound", "%s on %s: FirstFound ok %v, want %v", text, canon(data), ok, len(want) > 0)
+	} else if ok && !inMulti(first, want) {
+		col.failClass(ht, "FirstValue", "%s on %s: First = %s, not among %s", text, canon(data), canon(first), canonList(want))
+	}
+	if len(want) > 0 && !inMulti(x.First(data), want) {
+		col.failClass(ht, "First", "%s on %s: First = %s, not among %s", text, canon(data), canon(x.First(data)), canonList(want))
+	}
+	if x.Has(data) != (len(want) > 0) {
+		col.failClass(ht, "Has", "%s on %s: Has %v, want %v", text, canon(data), x.Has(data), len(want) > 0)
+	}
+	return want, true
+}
+
+// checkLocate: Locate returns one normalized path per result, each of which PathMatch accepts
+// and Get resolves to the result.
+func checkLocate(ht *hegel.T, col *collector, c pathCase, x jp.Expr, want []any) {
+	text, data := c.text(), c.data
+	locs := x.Locate(data, 0)
+	if len(locs) != len(want) {
+		col.failClass(ht, "LocateCount", "%s on %s: Locate = %v (%d), want %d", text, canon(data), locs, len(locs), len(want))
+		return
+	}
+	var vals []any
+	for _, loc := range locs {
+		r := loc.Get(data)
+		if len(r) != 1 {
+			col.failClass(ht, "LocateGet", "%s on %s: located %s gets %s", text, canon(data), loc, canonList(r))
+			continue
+		}
+		vals = append(vals, r[0])
+		if !hasNegIndex(c.fs) && !jp.PathMatch(x, loc) {
+			col.failClass(ht, "PathMatch", "%s on %s: PathMatch rejects located %s", text, canon(data), loc)
+		}
+		if !loc.Normal() {
+			col.failClass(ht, "LocateNormal", "%s on %s: located %s is not normal", text, canon(data), loc)
+		}
+	}
+	if len(vals) == len(want) && !sameMulti(vals, want) {
+		col.failClass(ht, "LocateValues", "%s on %s: located values %s, want %s", text, canon(data), canonList(vals), canonList(want))
+	}
+}
+
+// checkLocateMax: Locate with a max below the result count returns max paths; a slice
+// fragment is the shape of ojg/15.
+func checkLocateMax(ht *hegel.T, col *collector, c pathCase, x jp.Expr, want []any, extra ...string) {
+	if len(want) <= c.max {
+		return
+	}
+	if l := x.Locate(c.data, c.max); len(l) != c.max {
+		col.mismatch(ht, shapes(append([]string{known("ojg/15", hasKind(c.fs, "slice"))}, extra...)...), "LocateMax", "%s on %s: Locate(max %d) = %d paths", c.text(), canon(c.data), c.max, len(l))
+	}
+}
+
+// checkString: String() parses back to a stable expression selecting the same results; a
+// descent before a bracket fragment (ojg/7) and a union key with a quote or backslash
+// (ojg/14) are the recorded shapes.
+func checkString(ht *hegel.T, col *collector, c pathCase, x jp.Expr, want []any, extra ...string) {
+	text, data := c.text(), c.data
+	sh := shapes(append([]string{known("ojg/7", descBracket(c.fs, c.bracket)), known("ojg/14", unionQuote(c.fs))}, extra...)...)
+	s := x.String()
+	if y, err := jp.ParseString(s); err != nil {
+		col.mismatch(ht, sh, "StringParse", "%s: String() = %q does not parse: %v", text, s, err)
+	} else if y.String() != s {
+		col.mismatch(ht, sh, "StringStable", "%s: String() = %q reparses as %q", text, s, y.String())
+	} else if !sameMulti(y.Get(data), want) {
+		col.mismatch(ht, sh, "StringGet", "%s: String() = %q gets %s on %s, want %s", text, s, canonList(y.Get(data)), canon(data), canonList(want))
+	}
+}
+
+// checkBracketString: BracketString() parses back to an expression selecting the same
+// results; a descent (ojg/8) and a union key with a quote or backslash (ojg/14) are the
+// recorded shapes.
+func checkBracketString(ht *hegel.T, col *collector, c pathCase, x jp.Expr, want []any, extra ...string) {
+	text, data := c.text(), c.data
+	sh := shapes(append([]string{known("ojg/8", hasDesc(c.fs)), known("ojg/14", unionQuote(c.fs))}, extra...)...)
+	bs := x.BracketString()
+	if y, err := jp.ParseString(bs); err != nil {
+		col.mismatch(ht, sh, "BracketParse", "%s: BracketString() = %q does not parse: %v", text, bs, err)
+	} else if !sameMulti(y.Get(data), want) {
+		col.mismatch(ht, sh, "BracketGet", "%s: BracketString() = %q gets %s on %s, want %s", text, bs, canonList(y.Get(data)), canon(data), canonList(want))
+	}
+}
+
+// checkMatch: the streaming oj.Match on the JSON of the data finds what PathMatch allows. A
+// descent (ojg/16), a filter matching several elements (ojg/17) and an integer at the int64
+// limits in the data (ojg/1) are the recorded shapes.
+func checkMatch(ht *hegel.T, col *collector, c pathCase, x jp.Expr, extra ...string) {
+	text, data := c.text(), c.data
+	loose := evalPathLoose(data, c.fs)
+	sh := shapes(append([]string{known("ojg/16", hasDesc(c.fs)), known("ojg/17", filterSeveral(data, c.fs)), known("ojg/1", hasLimitInt(data))}, extra...)...)
+	var mgot []any
+	if err := oj.MatchString(oj.JSON(data), func(_ jp.Expr, v any) { mgot = append(mgot, v) }, x); err != nil {
+		col.mismatch(ht, sh, "MatchErr", "MatchString(%s) with %s: %v", canon(data), text, err)
+	} else if !sameMultiLoose(mgot, loose) {
+		col.mismatch(ht, sh, "Match", "MatchString(%s) with %s found %s, want %s", canon(data), text, canonList(mgot), canonList(loose))
+	}
+}
+
+// TestHegelPath: Get on random data and a random path matches the brute-force evaluation;
+// First/FirstFound/Has agree; Locate returns one normalized path per result and PathMatch
+// accepts each; the String and BracketString forms parse back to an equivalent expression;
+// Normal is right; Walk visits every node; the streaming oj.Match finds what PathMatch allows.
+// Negative-step slices over empty arrays (ojg/11), slices under Locate's max (ojg/15), union
+// keys with quotes (ojg/14), descents before brackets (ojg/7), descents under BracketString
+// (ojg/8) and under Match (ojg/16), filters matching several elements under Match (ojg/17)
+// and filters comparing a float member with "!=" to a string, boolean, null or float (ojg/21)
+// are drawn by default; HEGEL_NO_KNOWN=1 draws union keys without quotes and leaves out the
+// one check a drawn shape would meet.
+func TestHegelPath(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pathCases)
+		col.count("cases")
+		x, ok := parsePath(ht, col, c)
+		if !ok {
+			return
+		}
+		want, ok := checkGet(ht, col, c, x)
+		if !ok {
+			return
+		}
+		checkLocate(ht, col, c, x, want)
+		if !col.excused("ojg/15", hasKind(c.fs, "slice") && len(want) > c.max) {
+			checkLocateMax(ht, col, c, x, want)
+		}
+		if !col.excused("ojg/7", descBracket(c.fs, c.bracket)) && !col.excused("ojg/14", unionQuote(c.fs)) {
+			checkString(ht, col, c, x, want)
+		}
+		if !col.excused("ojg/8", hasDesc(c.fs)) && !col.excused("ojg/14", unionQuote(c.fs)) {
+			checkBracketString(ht, col, c, x, want)
+		}
+		if x.Normal() != isNormal(c.fs) {
+			col.failClass(ht, "Normal", "%s: Normal %v, want %v", c.text(), x.Normal(), isNormal(c.fs))
+		}
+		if !col.excused("ojg/16", hasDesc(c.fs)) && !col.excused("ojg/17", filterSeveral(c.data, c.fs)) && !col.excused("ojg/1", hasLimitInt(c.data)) {
+			checkMatch(ht, col, c, x)
+		}
+		data := c.data
+		all, leaves := 0, 0
+		jp.Walk(data, func(_ jp.Expr, _ any) { all++ })
+		jp.Walk(data, func(_ jp.Expr, _ any) { leaves++ }, true)
+		if all != countNodes(data, false) {
+			col.failClass(ht, "WalkAll", "Walk(%s) visited %d nodes, want %d", canon(data), all, countNodes(data, false))
+		}
+		if leaves != countNodes(data, true) {
+			col.failClass(ht, "WalkLeaves", "Walk(%s, leaves) visited %d, want %d", canon(data), leaves, countNodes(data, true))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- edits
+
+// editCase: data, the container in it the edit addresses (an index into its container
+// locations, taken modulo their count), the last fragment selecting the container's children,
+// the kind of edit and the value Set puts in.
+type editCase struct {
+	data any
+	loc  int
+	last frag
+	kind editKind
+	val  any
+}
+
+func (c editCase) path() []step {
+	locs := containerLocs(c.data)
+	return locs[c.loc%len(locs)]
+}
+
+func (c editCase) frags() []frag { return append(stepsFrags(c.path()), c.last) }
+
+func (c editCase) text() string { return pathText(c.frags(), false) }
+
+func (c editCase) GoString() string {
+	return fmt.Sprintf("%s %s on %s (value %s)", editNames[c.kind], c.text(), canon(c.data), canon(c.val))
+}
+
+var editKinds = pick(editSet, editDel, editRemove)
+
+// fitIndex is the index for an edit of an array of n elements: the drawn one by default (an
+// index outside the array is the shape of ojg/3 and ojg/4); under HEGEL_NO_KNOWN=1 one
+// inside the array (a wildcard over an empty one).
+func fitIndex(f frag, n int) frag {
+	if !noKnown || f.kind != "nth" {
+		return f
+	}
+	if n == 0 {
+		return frag{kind: "wild"}
+	}
+	i := f.n % n
+	if i < 0 {
+		i += n
+	}
+	if f.n < 0 {
+		i -= n
+	}
+	return frag{kind: "nth", n: i}
+}
+
+// editFragsFor is the last fragment of an edit of a container: an index, wildcard or union
+// for an array, a child, wildcard or union for an object.
+func editFragsFor(c any) hegel.Generator[frag] {
+	if arr, isArr := c.([]any); isArr {
+		return weighted(choice[frag]{2, hegel.Map(nthFrags, func(f frag) frag { return fitIndex(f, len(arr)) })}, choice[frag]{1, wildFrag}, choice[frag]{1, unionFragsFor(nil)})
+	}
+	keys := sortedKeys(c.(map[string]any))
+	return weighted(choice[frag]{2, childFragsFor(keys)}, choice[frag]{1, wildFrag}, choice[frag]{1, unionFragsFor(keys)})
+}
+
+// editCasesOver is an edit case over data drawn from the given generator.
+func editCasesOver(data hegel.Generator[any]) hegel.Generator[editCase] {
+	return hegel.FlatMap(data, func(d any) hegel.Generator[editCase] {
+		locs := containerLocs(d)
+		return hegel.FlatMap(hegel.Integers(0, len(locs)-1), func(li int) hegel.Generator[editCase] {
+			last := editFragsFor(getAt(d, locs[li]))
+			return hegel.Composite(func(tc hegel.TestCase) editCase {
+				return editCase{data: d, loc: li, last: hegel.Draw(tc, last), kind: hegel.Draw(tc, editKinds), val: hegel.Draw(tc, valueAt(1))}
+			})
+		})
+	})
+}
+
+var editCases = editCasesOver(containersAt(3))
+
+// checkEdit: Set, Del or Remove through the path leaves the data as the model edits it. An
+// index outside the array under Set (ojg/3) and Del (ojg/4) and a union with a negative index
+// under Remove (ojg/10) are the recorded shapes.
+func checkEdit(ht *hegel.T, col *collector, c editCase, extra ...string) {
+	name, text, orig := editNames[c.kind], c.text(), c.data
+	x, err := jp.ParseString(text)
+	if err != nil {
+		col.failClass(ht, "EditPathParse", "ParseString(%q) error %v", text, err)
+		return
+	}
+	p := c.path()
+	outOfRange := false
+	if arr, isArr := getAt(orig, p).([]any); isArr && c.last.kind == "nth" { // a union ignores its out-of-range members
+		outOfRange = c.last.n < -len(arr) || c.last.n >= len(arr)
+	}
+	sh := shapes(append([]string{
+		known("ojg/3", c.kind == editSet && outOfRange),
+		known("ojg/4", c.kind == editDel && outOfRange),
+		known("ojg/10", c.kind == editRemove && c.last.kind == "union" && unionHasNeg(c.last)),
+	}, extra...)...)
+	data := deepCopy(orig)
+	model := deepCopy(orig)
+	model = setAt(model, p, applyEdit(getAt(model, p), c.last, c.kind, c.val))
+	switch c.kind {
+	case editSet:
+		err = x.Set(data, c.val)
+	case editDel:
+		err = x.Del(data)
+	case editRemove:
+		data, err = x.Remove(data)
+	}
+	if err != nil {
+		col.mismatch(ht, sh, name+"Err", "%s %s (value %s) on %s: %v", name, text, canon(c.val), canon(orig), err)
+		return
+	}
+	if !sameValue(data, model) {
+		col.mismatch(ht, sh, name, "%s %s (value %s) on %s = %s, want %s", name, text, canon(c.val), canon(orig), canon(data), canon(model))
+	}
+}
+
+// TestHegelPathEdit: Set, Del and Remove through a path ending in a child, index, wildcard or
+// union of an existing container leave the data as the model edits it (a missing key is added
+// by Set and ignored by Del and Remove; Set at or past the end of an array adds the element;
+// an index outside the array is otherwise ignored; a union resolves its negative indices).
+// Indices outside the array (ojg/3, ojg/4) and negative union indices under Remove (ojg/10)
+// are drawn by default; HEGEL_NO_KNOWN=1 draws indices inside the array and models Remove's
+// union as the library does.
+func TestHegelPathEdit(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, editCases)
+		col.count("cases")
+		checkEdit(ht, col, c)
+	})
+}
+
+// --------------------------------------------------------------------------- SEN and alt
+
+// senCase: a value and the indent of the sorted form.
+type senCase struct {
+	v      any
+	indent int
+}
+
+func (c senCase) GoString() string { return fmt.Sprintf("value %s, indent %d", canon(c.v), c.indent) }
+
+// senValues: values with strings starting with '-' (ojg/5), the words null, true and false
+// (ojg/6) and root strings starting with a byte order mark (ojg/22) among them by default;
+// under HEGEL_NO_KNOWN=1 those strings get a letter before them.
+var (
+	// senShapeValues is a string the SEN writer leaves bare (a dash and atoms, ojg/5; a literal
+	// word, ojg/6) or an integer at the int64 limits (ojg/1), at the top or in a host; drawn two
+	// times in five by default so that the first hundred cases of a run meet the shapes.
+	senShapeValues = hegel.Composite(func(tc hegel.TestCase) any {
+		data, _ := hegel.Draw(tc, hosts).place(hegel.Draw(tc, weighted(
+			choice[any]{1, asAny(hegel.SampledFrom(intLimits))},
+			choice[any]{1, asAny(hegel.Map(joined(many(strAtoms, 0, 2)), func(s string) string { return "-" + s }))},
+			choice[any]{1, asAny(pick("null", "true", "false"))},
+		)))
+		return data
+	})
+	senValues = shaped(weighted(choice[any]{3, valueAt(3)}, choice[any]{2, senShapeValues}), hegel.Map(valueAt(3), unbare))
+	senCases  = hegel.Composite(func(tc hegel.TestCase) senCase {
+		return senCase{v: hegel.Draw(tc, senValues), indent: hegel.Draw(tc, hegel.Integers(0, 3))}
+	})
+)
+
+// checkSEN: SEN written by sen (plain, sorted/indented, Write, Bytes) parses back to the
+// value; SEN parses the JSON of the same value. Strings starting with '-' (ojg/5), the
+// literal words (ojg/6), the int64-limit integers (ojg/1) and a root string starting with a
+// byte order mark (ojg/22) are the recorded shapes.
+func checkSEN(ht *hegel.T, col *collector, c senCase, extra ...string) {
+	v := c.v
+	sh := shapes(append([]string{known("ojg/1", hasLimitInt(v)), known("ojg/5", senDash(v)), known("ojg/6", senLiteral(v)), known("ojg/22", senBOM(v))}, extra...)...)
+	want := canonLoose(v)
+	s := sen.String(v)
+	if back, err := sen.Parse([]byte(s)); err != nil {
+		col.mismatch(ht, sh, "SENParseErr", "sen.Parse(sen.String(%s) = %q) error %v", canon(v), s, err)
+	} else if canonLoose(back) != want {
+		col.mismatch(ht, sh, "SENRoundTrip", "sen.Parse(sen.String(%s) = %q) = %s", canon(v), s, canonLoose(back))
+	}
+	if back, err := sen.Parse(sen.Bytes(v)); err != nil {
+		col.mismatch(ht, sh, "SENBytesErr", "sen.Parse(sen.Bytes(%s) = %q) error %v", canon(v), sen.Bytes(v), err)
+	} else if canonLoose(back) != want {
+		col.mismatch(ht, sh, "SENBytes", "sen.Parse(sen.Bytes(%s) = %q) = %s", canon(v), sen.Bytes(v), canonLoose(back))
+	}
+	opts := ojg.DefaultOptions
+	opts.Sort = true
+	opts.Indent = c.indent
+	s2 := sen.String(v, &opts)
+	if back, err := sen.Parse([]byte(s2)); err != nil {
+		col.mismatch(ht, sh, "SENOptsErr", "sen.Parse(sen.String(%s, sort/indent) = %q) error %v", canon(v), s2, err)
+	} else if canonLoose(back) != want {
+		col.mismatch(ht, sh, "SENOpts", "sen.Parse(sen.String(%s, sort/indent) = %q) = %s", canon(v), s2, canonLoose(back))
+	}
+	var buf bytes.Buffer
+	if err := sen.Write(&buf, v); err != nil {
+		col.mismatch(ht, sh, "SENWriteErr", "sen.Write(%s) error %v", canon(v), err)
+	} else if back, err := sen.Parse(buf.Bytes()); err != nil {
+		col.mismatch(ht, sh, "SENWriteParse", "sen.Parse(sen.Write(%s) = %q) error %v", canon(v), buf.String(), err)
+	} else if canonLoose(back) != want {
+		col.mismatch(ht, sh, "SENWrite", "sen.Parse(sen.Write(%s) = %q) = %s", canon(v), buf.String(), canonLoose(back))
+	}
+	j := oj.JSON(v)
+	if back, err := sen.Parse([]byte(j)); err != nil {
+		col.mismatch(ht, sh, "SENofJSONErr", "sen.Parse(%q) error %v", j, err)
+	} else if canonLoose(back) != want {
+		col.mismatch(ht, sh, "SENofJSON", "sen.Parse(%q) = %s, want %s", j, canonLoose(back), want)
+	}
+}
+
+// TestHegelSEN: SEN written by sen (plain, sorted/indented, Write, Bytes) parses back to the
+// value; SEN parses the JSON of the same value. Strings starting with '-' (ojg/5), the words
+// null/true/false (ojg/6), integers at the int64 limits (ojg/1) and root strings starting with
+// a byte order mark (ojg/22) are drawn by default; HEGEL_NO_KNOWN=1 draws past them.
+func TestHegelSEN(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, senCases)
+		col.count("cases")
+		checkSEN(ht, col, c)
+	})
+}
+
+// other is the second value of an alt case: the same as the first, the same with one
+// location replaced, or a fresh value.
+type other struct {
+	kind  string
+	at    int
+	val   any
+	fresh any
+}
+
+func (o other) of(v any) any {
+	switch o.kind {
+	case "same":
+		return deepCopy(v)
+	case "fresh":
+		return o.fresh
+	}
+	w := deepCopy(v)
+	if locs := allLocs(w, nil); len(locs) > 0 {
+		w = setAt(w, locs[o.at%len(locs)], o.val)
+	}
+	return w
+}
+
+// altCase: a value, a second value related to it, the location of the Dup-aliasing probe and
+// the coins of the key subset Match is tried on.
+type altCase struct {
+	v      any
+	w      other
+	probe  int
+	subset []bool
+}
+
+func (c altCase) GoString() string {
+	return fmt.Sprintf("%s against %s (%s)", canon(c.v), canon(c.w.of(c.v)), c.w.kind)
+}
+
+var (
+	others = weighted(
+		choice[other]{1, hegel.Just(other{kind: "same"})},
+		choice[other]{1, hegel.Composite(func(tc hegel.TestCase) other {
+			return other{kind: "edited", at: hegel.Draw(tc, positions), val: hegel.Draw(tc, valueAt(1))}
+		})},
+		choice[other]{2, hegel.Map(valueAt(3), func(v any) other { return other{kind: "fresh", fresh: v} })},
+	)
+	altCases = hegel.Composite(func(tc hegel.TestCase) altCase {
+		return altCase{v: hegel.Draw(tc, valueAt(3)), w: hegel.Draw(tc, others), probe: hegel.Draw(tc, positions), subset: hegel.Draw(tc, tapeOf(chance(60), 8))}
+	})
+)
+
+// TestHegelAlt: Dup/Decompose and Generify+Simplify reproduce the value (without nil members
+// under alt's default OmitNil, exactly with OmitNil off); Dup is independent of the original;
+// Diff and Compare report a difference exactly when the values differ (nil members count as
+// absent, as in Match); Match accepts the value itself and any subset of its keys; Checksum
+// agrees on equal values.
+func TestHegelAlt(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, altCases)
+		col.count("cases")
+		v := c.v
+		w := c.w.of(v)
+		keep := ojg.Options{}
+		if n := alt.Generify(v); n == nil && v != nil {
+			col.failClass(ht, "GenerifyNil", "Generify(%s) = nil", canon(v))
+		} else if n != nil && !sameValue(n.Simplify(), stripNil(v)) {
+			col.failClass(ht, "Generify", "Generify(%s).Simplify() = %s, want %s", canon(v), canon(n.Simplify()), canon(stripNil(v)))
+		}
+		if n := alt.Generify(v, &keep); n != nil && !sameValue(n.Simplify(), v) {
+			col.failClass(ht, "GenerifyKeepNil", "Generify(%s, OmitNil off).Simplify() = %s", canon(v), canon(n.Simplify()))
+		}
+		before := canon(v)
+		if d := alt.Dup(v); !sameValue(d, stripNil(v)) {
+			col.failClass(ht, "Dup", "Dup(%s) = %s, want %s", before, canon(d), canon(stripNil(v)))
+		}
+		d := alt.Dup(v, &keep)
+		if !sameValue(d, v) {
+			col.failClass(ht, "DupKeepNil", "Dup(%s, OmitNil off) = %s", before, canon(d))
+		}
+		if a := alt.Alter(deepCopy(v), &keep); !sameValue(a, v) {
+			col.failClass(ht, "Alter", "Alter(%s, OmitNil off) = %s", before, canon(a))
+		}
+		if locs := allLocs(d, nil); len(locs) > 0 {
+			setAt(d, locs[c.probe%len(locs)], "changed")
+			if canon(v) != before {
+				col.failClass(ht, "DupAliased", "changing Dup(%s) changed the original to %s", before, canon(v))
+			}
+		}
+		equal := sameValue(stripNil(v), stripNil(w))
+		diffs := alt.Diff(v, w)
+		if (len(diffs) == 0) != equal {
+			col.failClass(ht, "Diff", "Diff(%s, %s) = %v, equal %v", canon(v), canon(w), diffs, equal)
+		}
+		if cmp := alt.Compare(v, w); (cmp == nil) != equal {
+			col.failClass(ht, "Compare", "Compare(%s, %s) = %v, equal %v", canon(v), canon(w), cmp, equal)
+		}
+		if sameValue(v, w) && alt.Checksum(v) != alt.Checksum(w) {
+			col.failClass(ht, "Checksum", "Checksum(%s) differs between equal values", canon(v))
+		}
+		if !alt.Match(v, v) {
+			col.failClass(ht, "MatchSelf", "Match(%s, itself) false", canon(v))
+		}
+		if m, ok := v.(map[string]any); ok && len(m) > 0 {
+			fp := map[string]any{}
+			for i, k := range sortedKeys(m) {
+				if at(c.subset, i) {
+					fp[k] = deepCopy(m[k])
+				}
+			}
+			if !alt.Match(fp, v) {
+				col.failClass(ht, "MatchSubset", "Match(%s, %s) false", canon(fp), canon(v))
+			}
+		}
+		if equal && !alt.Match(v, w) {
+			col.failClass(ht, "MatchEqual", "Match(%s, %s) false for equal values", canon(v), canon(w))
+		}
+	})
+}
