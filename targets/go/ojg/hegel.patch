+package hegel
+
+// The model: ojg's "simple types" (nil, bool, int64, float64, string, []any, map[string]any),
+// a canonical string form to compare them, a JSON text renderer whose spelling (whitespace,
+// escapes, number forms) is a drawn tape so that the expected parse is known by construction,
+// mutations of a text drawn as records, and a brute-force JSONPath evaluator (RFC 9535
+// semantics on the simple types) with set/delete/remove.
+//
+// Every generator is a package-level value (or a function of the drawn data returning one);
+// the plain alternative comes first in every choice, so a minimal case is nil, "", 0 or "a".
+
+import (
+	"fmt"
+	"math"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode/utf16"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- values
+
+// Keys and strings are joined atom lists, the plain atoms first; the exotic atoms (quotes, a
+// backslash, non-ASCII, control characters, a dash, the literal words) are the shapes several
+// recorded bugs live in.
+var (
+	plainKeys = pick("a", "b", "c", "x", "id")
+	keyAtoms  = pick("a", "b", "c", "x", "id", "", " ", "\"", "'", "é", "日", ".", "0", "-1", "$", "*", "\\")
+	objKeys   = weighted(choice[string]{7, plainKeys}, choice[string]{3, joined(many(keyAtoms, 1, 2))})
+
+	plainStrings = pick("", "a", "hello", "with space", "1", "x y")
+	strAtoms     = pick("a", "b", "hello", " ", "_", "-", ".", "\"", "\\", "/", "\n", "\t", "\r", "\b", "\f", "<&>",
+		"\u00e9", "\u00fc", "{", "}", ":", ",", "[x]", "$.a", "\U0001F600", "\U0001F4A9", "\U00010000", "\x01", "\x1f", "\x7f", "\ufeff", "\u2028", "\u2029",
+		"1", "null", "true", "false")
+	strValues = weighted(choice[string]{6, plainStrings}, choice[string]{4, joined(many(strAtoms, 1, 4))})
+)
+
+var simpleKeyRx = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+func simpleKey(k string) bool { return simpleKeyRx.MatchString(k) }
+
+// Integers: small ones most of the time, the edge list otherwise. The int64-limit integers
+// (9223372036854775800 to MaxInt64 and MinInt64) are the shape of ojg/1 and are drawn by
+// default; under HEGEL_NO_KNOWN=1 the edge list stops short of them.
+var (
+	intEdges  = []int64{7, 42, -100, 1000000, 999999999999, 1 << 53, -(1 << 53), 922337203685477580, 1 << 62, math.MinInt64 + 1}
+	intLimits = []int64{math.MaxInt64, math.MinInt64, math.MaxInt64 - 1, 9223372036854775800}
+	intValues = weighted(choice[int64]{6, hegel.Integers[int64](-20, 20)}, choice[int64]{4, shaped(
+		weighted(choice[int64]{2, hegel.SampledFrom(intEdges)}, choice[int64]{3, hegel.SampledFrom(intLimits)}),
+		hegel.SampledFrom(intEdges))})
+	floatTexts = []string{"0.5", "1.5", "-2.25", "1000.0", "3.14159", "1e-07", "123456789.123", "1e+21", "2.5e-300", "0.1",
+		"0.2", "0.30000000000000004", "1.7976931348623157e+308", "5e-324", "-0.001", "100.25", "1e15", "12345678.9", "0.000001",
+		"9007199254740993.0", "4.5", "-7.75", "1e100", "123.456e-5"}
+	floatValues = hegel.Map(hegel.SampledFrom(floatTexts), func(s string) float64 { f, _ := strconv.ParseFloat(s, 64); return f })
+	boolValues  = chance(50)
+)
+
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(v T) any { return v })
+}
+
+// nonNilSlice and nonNilMap: Lists and Maps yield nil for zero elements; the model's empty
+// containers are non-nil (oj writes a nil slice as null).
+func nonNilSlice(xs []any) []any {
+	if xs == nil {
+		return []any{}
+	}
+	return xs
+}
+
+func nonNilMap(m map[string]any) map[string]any {
+	if m == nil {
+		return map[string]any{}
+	}
+	return m
+}
+
+// arraysOf is an array of 0 to max elements of elem; objectsOf an object of 0 to max members
+// with distinct keys.
+func arraysOf(elem hegel.Generator[any], max int) hegel.Generator[any] {
+	return hegel.Map(counted(elem, 0, max), func(xs []any) any { return nonNilSlice(xs) })
+}
+
+func objectsOf(elem hegel.Generator[any], max int) hegel.Generator[any] {
+	return hegel.Map(hegel.FlatMap(hegel.Integers(0, max), func(k int) hegel.Generator[map[string]any] {
+		return hegel.Maps(objKeys, elem).MinSize(k).MaxSize(k)
+	}), func(m map[string]any) any { return nonNilMap(m) })
+}
+
+// valueLevels is the value tree as a tower indexed by depth: level 0 holds scalars (nil
+// first), level d adds arrays and objects of level d-1 (a self-referencing package-level
+// generator would be an init cycle).
+var valueLevels = func() []hegel.Generator[any] {
+	scalars := []choice[any]{
+		{8, hegel.Just[any](nil)},
+		{10, asAny(boolValues)},
+		{20, asAny(intValues)},
+		{14, asAny(floatValues)},
+		{20, asAny(strValues)},
+	}
+	levels := []hegel.Generator[any]{weighted(scalars...)}
+	for d := 1; d <= 3; d++ {
+		below := levels[d-1]
+		levels = append(levels, weighted(append(append([]choice[any]{}, scalars...),
+			choice[any]{14, arraysOf(below, 4)},
+			choice[any]{14, objectsOf(below, 4)})...))
+	}
+	return levels
+}()
+
+// valueAt is a simple value with containers nested at most depth deep.
+func valueAt(depth int) hegel.Generator[any] { return valueLevels[depth] }
+
+// containersAt is an array or object of 0 to 5 values nested at most depth deep (the data of
+// the JSONPath properties).
+func containersAt(depth int) hegel.Generator[any] {
+	return hegel.OneOf(arraysOf(valueAt(depth), 5), objectsOf(valueAt(depth), 5))
+}
+
+// --------------------------------------------------------------------------- canonical form
+
+// canon renders a simple value with its types (i for int64, f for float64, N for json.Number).
+func canon(v any) string {
+	var sb strings.Builder
+	canonTo(&sb, v, false)
+	return sb.String()
+}
+
+// canonLoose renders int64 and integral float64 alike (the JSON text does not tell them apart).
+func canonLoose(v any) string {
+	var sb strings.Builder
+	canonTo(&sb, v, true)
+	return sb.String()
+}
+
+func canonTo(sb *strings.Builder, v any, loose bool) {
+	switch t := v.(type) {
+	case nil:
+		sb.WriteString("null")
+	case bool:
+		fmt.Fprintf(sb, "%t", t)
+	case int64:
+		if loose && -(1<<53) <= t && t <= 1<<53 {
+			fmt.Fprintf(sb, "n%s", strconv.FormatFloat(float64(t), 'g', -1, 64))
+		} else {
+			fmt.Fprintf(sb, "i%d", t)
+		}
+	case int:
+		canonTo(sb, int64(t), loose)
+	case float64:
+		if loose && t == math.Trunc(t) && math.Abs(t) <= 1<<53 {
+			fmt.Fprintf(sb, "n%s", strconv.FormatFloat(t, 'g', -1, 64))
+		} else {
+			fmt.Fprintf(sb, "f%s", strconv.FormatFloat(t, 'g', -1, 64))
+		}
+	case string:
+		sb.WriteString(strconv.Quote(t))
+	case []any:
+		sb.WriteByte('[')
+		for i, e := range t {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			canonTo(sb, e, loose)
+		}
+		sb.WriteByte(']')
+	case map[string]any:
+		sb.WriteByte('{')
+		for i, k := range sortedKeys(t) {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			sb.WriteString(strconv.Quote(k))
+			sb.WriteByte(':')
+			canonTo(sb, t[k], loose)
+		}
+		sb.WriteByte('}')
+	default:
+		if s, ok := v.(fmt.Stringer); ok {
+			fmt.Fprintf(sb, "?%T:%s", v, s.String())
+		} else {
+			fmt.Fprintf(sb, "?%T:%v", v, v)
+		}
+	}
+}
+
+func sortedKeys(m map[string]any) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func sameValue(a, b any) bool { return canon(a) == canon(b) }
+
+func sortStrings(s []string) { sort.Strings(s) }
+
+// sameMulti compares two result lists as multisets of canonical forms.
+func sameMulti(a, b []any) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	as := make([]string, len(a))
+	bs := make([]string, len(b))
+	for i := range a {
+		as[i] = canon(a[i])
+		bs[i] = canon(b[i])
+	}
+	sort.Strings(as)
+	sort.Strings(bs)
+	for i := range as {
+		if as[i] != bs[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func deepCopy(v any) any {
+	switch t := v.(type) {
+	case []any:
+		a := make([]any, len(t))
+		for i, e := range t {
+			a[i] = deepCopy(e)
+		}
+		return a
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			m[k] = deepCopy(e)
+		}
+		return m
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- JSON text
+
+// tape is the spelling of a JSON text: the whitespace put at each gap, the escape choice for
+// each string character and the spelling of each float, each read in order and modulo the
+// tape's length. The empty tape is the tight, raw, %g rendering.
+type tape struct {
+	ws     []string
+	esc    []int // 0..99
+	floats []int // 0..3
+}
+
+var (
+	wsSet = []string{" ", "\n", "\t", "\r\n", "  ", "\r"}
+	gaps  = weighted(choice[string]{7, hegel.Just("")}, choice[string]{3, hegel.SampledFrom(wsSet)})
+	tapes = hegel.Composite(func(tc hegel.TestCase) tape {
+		return tape{
+			ws:     hegel.Draw(tc, tapeOf(gaps, 16)),
+			esc:    hegel.Draw(tc, tapeOf(hegel.Integers(0, 99), 16)),
+			floats: hegel.Draw(tc, tapeOf(hegel.Integers(0, 3), 6)),
+		}
+	})
+)
+
+// rendered is the JSON text of a value and whether a surrogate pair escape was written (the
+// shape of ojg/13).
+type rendered struct {
+	text  string
+	pairs bool
+}
+
+type emitter struct {
+	sb         strings.Builder
+	t          tape
+	wi, ei, fi int
+	pairs      bool
+}
+
+// render writes v as JSON text spelled by the tape; the text parses back to exactly v (ints
+// stay ints, floats stay floats). Object members are written in key order.
+func render(v any, t tape) rendered {
+	e := &emitter{t: t}
+	e.value(v)
+	return rendered{e.sb.String(), e.pairs}
+}
+
+func (e *emitter) space() {
+	e.sb.WriteString(at(e.t.ws, e.wi))
+	e.wi++
+}
+
+func (e *emitter) value(v any) {
+	e.space()
+	switch t := v.(type) {
+	case nil:
+		e.sb.WriteString("null")
+	case bool:
+		fmt.Fprintf(&e.sb, "%t", t)
+	case int64:
+		e.sb.WriteString(strconv.FormatInt(t, 10))
+	case float64:
+		e.sb.WriteString(floatText(t, at(e.t.floats, e.fi)))
+		e.fi++
+	case string:
+		e.str(t)
+	case []any:
+		e.sb.WriteByte('[')
+		for i, x := range t {
+			if i > 0 {
+				e.sb.WriteByte(',')
+			}
+			e.value(x)
+		}
+		e.space()
+		e.sb.WriteByte(']')
+	case map[string]any:
+		e.sb.WriteByte('{')
+		for i, k := range sortedKeys(t) {
+			if i > 0 {
+				e.sb.WriteByte(',')
+			}
+			e.space()
+			e.str(k)
+			e.space()
+			e.sb.WriteByte(':')
+			e.value(t[k])
+		}
+		e.space()
+		e.sb.WriteByte('}')
+	default:
+		panic(fmt.Sprintf("render: unexpected %T", v))
+	}
+	e.space()
+}
+
+// floatText spells f (0: %g, 1: %e, 2: %E, 3: %f) so that the literal has a '.' or an exponent
+// and stays within ojg's int64-accumulator limits (fewer than 18 fraction digits, exponent
+// below 1023).
+func floatText(f float64, spelling int) string {
+	var s string
+	switch spelling {
+	case 1:
+		s = strconv.FormatFloat(f, 'e', -1, 64)
+	case 2:
+		s = strconv.FormatFloat(f, 'E', -1, 64)
+	case 3:
+		s = strconv.FormatFloat(f, 'f', -1, 64)
+		if dot := strings.IndexByte(s, '.'); (dot >= 0 && len(s)-dot-1 > 17) || (dot < 0 && len(s) > 18) || (dot > 18) {
+			s = strconv.FormatFloat(f, 'g', -1, 64)
+		}
+	default:
+		s = strconv.FormatFloat(f, 'g', -1, 64)
+	}
+	if !strings.ContainsAny(s, ".eE") {
+		s += ".0"
+	}
+	return s
+}
+
+var shortEscapes = map[rune]string{'\n': `\n`, '\t': `\t`, '\r': `\r`, '\b': `\b`, '\f': `\f`}
+
+// str writes a string literal; each character's spelling is decided by the next escape tape
+// value x (0 is the plainest spelling).
+func (e *emitter) str(s string) {
+	e.sb.WriteByte('"')
+	for _, r := range s {
+		x := at(e.t.esc, e.ei)
+		e.ei++
+		switch {
+		case r == '"':
+			e.sb.WriteString(`\"`)
+		case r == '\\':
+			e.sb.WriteString(`\\`)
+		case r < 0x20:
+			if short := shortEscapes[r]; short != "" && x < 60 {
+				e.sb.WriteString(short)
+			} else {
+				fmt.Fprintf(&e.sb, `\u%04x`, r)
+			}
+		case r == '/' && x >= 50:
+			e.sb.WriteString(`\/`)
+		case r < 0x80:
+			if x >= 90 {
+				fmt.Fprintf(&e.sb, `\u%04X`, r)
+			} else {
+				e.sb.WriteRune(r)
+			}
+		case r > 0xFFFF:
+			// A surrogate pair escape is the shape of ojg/13; the emitter avoids it while the
+			// switch is on.
+			if x >= 40 && !Known.noSurrogatePairs {
+				hi, lo := utf16.EncodeRune(r)
+				fmt.Fprintf(&e.sb, `\u%04x\u%04X`, hi, lo)
+				e.pairs = true
+			} else {
+				e.sb.WriteRune(r)
+			}
+		case x >= 70:
+			fmt.Fprintf(&e.sb, `\u%04x`, r)
+		default:
+			e.sb.WriteRune(r)
+		}
+	}
+	e.sb.WriteByte('"')
+}
+
+// --------------------------------------------------------------------------- mutations
+
+// mutation is one edit of a JSON text: a kind, a position taken modulo the live length, and a
+// byte for the kinds that put one in. The last three kinds make the shapes of recorded bugs
+// (a bare decimal point, a literal cut before a comma, an unclosed container) and are drawn by
+// default; under HEGEL_NO_KNOWN=1 only the byte edits are.
+type mutation struct {
+	kind string
+	at   int
+	c    byte
+}
+
+var (
+	mutBytes  = []byte("{}[]:,\"\\ 0123456789.eE+-tfnul/xabTFN\t\n\f\x00\x7f'")
+	positions = hegel.Integers(0, 99)
+	// mutationsOf is a mutation of one of the kinds, with its position and byte.
+	mutationsOf = func(kinds ...string) hegel.Generator[mutation] {
+		return hegel.Composite(func(tc hegel.TestCase) mutation {
+			return mutation{kind: hegel.Draw(tc, hegel.SampledFrom(kinds)), at: hegel.Draw(tc, positions), c: hegel.Draw(tc, hegel.SampledFrom(mutBytes))}
+		})
+	}
+	byteMutations  = mutationsOf("delete", "insert", "replace", "truncate", "append", "duplicate")
+	shapeMutations = mutationsOf("bareDot", "cutLiteral", "unclose")
+	mutations      = shaped(
+		weighted(choice[mutation]{1, byteMutations}, choice[mutation]{1, shapeMutations}),
+		byteMutations,
+	)
+	// mutationLists: one mutation, sometimes two.
+	mutationLists = weighted(choice[[]mutation]{7, many(mutations, 1, 1)}, choice[[]mutation]{3, many(mutations, 2, 2)})
+)
+
+func (m mutation) GoString() string {
+	switch m.kind {
+	case "insert", "replace", "fraction":
+		return fmt.Sprintf("%s %q at %d", m.kind, m.c, m.at)
+	case "append":
+		return fmt.Sprintf("append %q", m.c)
+	}
+	return fmt.Sprintf("%s at %d", m.kind, m.at)
+}
+
+// apply is the text after the mutation; a mutation that does not fit (a delete of nothing, a
+// cut of a literal the text has not got) is a no-op.
+func (m mutation) apply(b []byte) []byte {
+	n := len(b)
+	switch m.kind {
+	case "delete":
+		if n == 0 {
+			return b
+		}
+		i := m.at % n
+		return append(b[:i:i], b[i+1:]...)
+	case "insert":
+		i := m.at % (n + 1)
+		return append(b[:i:i], append([]byte{m.c}, b[i:]...)...)
+	case "replace":
+		if n == 0 {
+			return []byte{m.c}
+		}
+		b[m.at%n] = m.c
+		return b
+	case "truncate":
+		if n == 0 {
+			return b
+		}
+		return b[:m.at%n]
+	case "append":
+		return append(b, m.c)
+	case "duplicate":
+		if n == 0 {
+			return b
+		}
+		i := m.at % n
+		return append(b[:i+1:i+1], b[i:]...)
+	case "bareDot", "fraction":
+		// a '.' after the at-th integer literal's last digit (bareDot), or '.' and the byte
+		// (fraction: a digit, the neighbouring region of the bare dot)
+		var ends []int
+		for i := 0; i < n; i++ {
+			if isDigit(b[i]) && (i+1 == n || !isDigit(b[i+1])) {
+				ends = append(ends, i+1)
+			}
+		}
+		if len(ends) == 0 {
+			return b
+		}
+		i := ends[m.at%len(ends)]
+		ins := []byte{'.'}
+		if m.kind == "fraction" {
+			ins = append(ins, m.c)
+		}
+		return append(b[:i:i], append(ins, b[i:]...)...)
+	case "cutLiteral":
+		// the at-th literal word followed by a comma loses its last one to three letters
+		var cuts [][2]int
+		for _, w := range []string{"null", "true", "false"} {
+			for i := 0; i+len(w) < n; i++ {
+				if string(b[i:i+len(w)]) == w && b[i+len(w)] == ',' {
+					cuts = append(cuts, [2]int{i + len(w) - 1 - int(m.c)%3, i + len(w)})
+				}
+			}
+		}
+		if len(cuts) == 0 {
+			return b
+		}
+		c := cuts[m.at%len(cuts)]
+		return append(b[:c[0]:c[0]], b[c[1]:]...)
+	case "unclose":
+		// the at-th closing bracket or brace is dropped
+		var closers []int
+		for i := 0; i < n; i++ {
+			if b[i] == ']' || b[i] == '}' {
+				closers = append(closers, i)
+			}
+		}
+		if len(closers) == 0 {
+			return b
+		}
+		i := closers[m.at%len(closers)]
+		return append(b[:i:i], b[i+1:]...)
+	}
+	panic("mutation " + m.kind)
+}
+
+func isDigit(c byte) bool { return '0' <= c && c <= '9' }
+
+// mutate applies the mutations to s in turn.
+func mutate(s string, ms []mutation) string {
+	b := []byte(s)
+	for _, m := range ms {
+		b = m.apply(b)
+	}
+	return string(b)
+}
+
+// --------------------------------------------------------------------------- JSONPath
+
+type frag struct {
+	kind  string // child nth wild desc slice union filter
+	key   string
+	n     int
+	sl    [3]int
+	set   [3]bool
+	union []any // string or int
+	fkey  string
+	fop   string // "" (exists) == != < > <= >=
+	fval  any
+}
+
+// keysIn collects the object keys used anywhere in v.
+func keysIn(v any, acc map[string]bool) {
+	switch t := v.(type) {
+	case []any:
+		for _, e := range t {
+			keysIn(e, acc)
+		}
+	case map[string]any:
+		for k, e := range t {
+			acc[k] = true
+			keysIn(e, acc)
+		}
+	}
+}
+
+// keysOf is the sorted list of the object keys used anywhere in v.
+func keysOf(v any) []string {
+	acc := map[string]bool{}
+	keysIn(v, acc)
+	keys := make([]string, 0, len(acc))
+	for k := range acc {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// pathKeysFor is a key for a path over data with the given keys: one of them three times in
+// four, any key otherwise.
+func pathKeysFor(keys []string) hegel.Generator[string] {
+	if len(keys) == 0 {
+		return objKeys
+	}
+	return weighted(choice[string]{3, hegel.SampledFrom(keys)}, choice[string]{1, objKeys})
+}
+
+// unionKeysFor is a key of a union member: a path key; under HEGEL_NO_KNOWN=1 one without a
+// quote or backslash (the shape of ojg/14).
+func unionKeysFor(keys []string) hegel.Generator[string] {
+	g := pathKeysFor(keys)
+	return shaped(g, hegel.Map(g, func(k string) string { return strings.NewReplacer("'", "", `\`, "").Replace(k) }))
+}
+
+var filterOps = []string{"", "==", "!=", "<", ">", "<=", ">="}
+
+// A slice bound: unset, or a value.
+type bound struct {
+	set bool
+	v   int
+}
+
+var (
+	sliceBounds = weighted(choice[bound]{45, hegel.Just(bound{})}, choice[bound]{55, hegel.Map(hegel.Integers(-4, 5), func(v int) bound { return bound{true, v} })})
+	sliceFrags  = hegel.Composite(func(tc hegel.TestCase) frag {
+		f := frag{kind: "slice"}
+		for i := 0; i < 3; i++ {
+			b := hegel.Draw(tc, sliceBounds)
+			f.set[i], f.sl[i] = b.set, b.v
+		}
+		if f.set[2] && f.sl[2] == 0 {
+			f.sl[2] = 1
+		}
+		return f
+	})
+	nthFrags    = hegel.Map(hegel.Integers(-3, 4), func(n int) frag { return frag{kind: "nth", n: n} })
+	wildFrag    = hegel.Just(frag{kind: "wild"})
+	descFrag    = hegel.Just(frag{kind: "desc"})
+	filterVals  = hegel.OneOf(asAny(hegel.Map(hegel.Integers(-3, 10), func(n int) int64 { return int64(n) })), asAny(pick(0.5, 1.5, 2.0, -2.25, 1000.0)), asAny(pick("a", "hello", "", "x y", "1")), asAny(chance(50)))
+	unionCounts = hegel.Integers(2, 3) // one member would read back as a plain child or index
+)
+
+func childFragsFor(keys []string) hegel.Generator[frag] {
+	return hegel.Map(pathKeysFor(keys), func(k string) frag { return frag{kind: "child", key: k} })
+}
+
+// unionFragsFor is a union of two or three distinct members, keys or indices.
+func unionFragsFor(keys []string) hegel.Generator[frag] {
+	items := weighted(choice[any]{1, asAny(unionKeysFor(keys))}, choice[any]{1, asAny(hegel.Integers(-2, 4))})
+	return hegel.Filter(hegel.Map(hegel.FlatMap(unionCounts, func(k int) hegel.Generator[[]any] { return many(items, k, k) }), func(xs []any) frag {
+		f := frag{kind: "union"}
+		seen := map[string]bool{}
+		for _, it := range xs {
+			s := fmt.Sprintf("%T%v", it, it)
+			if !seen[s] {
+				seen[s] = true
+				f.union = append(f.union, it)
+			}
+		}
+		return f
+	}), func(f frag) bool { return len(f.union) >= 2 })
+}
+
+func filterFragsFor(keys []string) hegel.Generator[frag] {
+	return hegel.Composite(func(tc hegel.TestCase) frag {
+		f := frag{kind: "filter", fkey: hegel.Draw(tc, pathKeysFor(keys)), fop: hegel.Draw(tc, hegel.SampledFrom(filterOps))}
+		if f.fop != "" {
+			f.fval = hegel.Draw(tc, filterVals)
+		}
+		return f
+	})
+}
+
+// fragsFor is a path fragment over data with the given keys, the plain child first. A descent
+// is the shape of ojg/7, ojg/8 and ojg/16 and is one fragment in nine by default; under
+// HEGEL_NO_KNOWN=1 it is one in 129, so that a few percent of the paths hold one.
+func fragsFor(keys []string) hegel.Generator[frag] {
+	return weighted(
+		choice[frag]{shaped(2, 32), childFragsFor(keys)},
+		choice[frag]{shaped(2, 32), nthFrags},
+		choice[frag]{shaped(1, 16), wildFrag},
+		choice[frag]{shaped(1, 16), unionFragsFor(keys)},
+		choice[frag]{shaped(1, 16), sliceFrags},
+		choice[frag]{shaped(1, 16), filterFragsFor(keys)},
+		choice[frag]{1, descFrag},
+	)
+}
+
+// filterSeveral reports whether a filter in fs matches more than one element where it stands
+// (the shape of ojg/17).
+func filterSeveral(data any, fs []frag) bool {
+	for i, f := range fs {
+		if f.kind == "filter" && len(evalPathLoose(data, fs[:i+1])) > 1 {
+			return true
+		}
+	}
+	return false
+}
+
+var plainFvalRx = regexp.MustCompile(`^[A-Za-z0-9 _]*$`)
+
+// pastFilterSeveral is fs with every filter matching several elements where it stands
+// narrowed to one match: an equality with the first match's value when that is an integer,
+// a plain string or a boolean it matches alone, else the first index (the region past ojg/17,
+// drawn under HEGEL_NO_KNOWN=1).
+func pastFilterSeveral(data any, fs []frag) []frag {
+	out := append([]frag{}, fs...)
+	for i, f := range out {
+		if f.kind != "filter" {
+			continue
+		}
+		got := evalPathLoose(data, out[:i+1])
+		if len(got) <= 1 {
+			continue
+		}
+		if m, ok := got[0].(map[string]any); ok {
+			switch v := m[f.fkey].(type) {
+			case int64, bool:
+				out[i] = frag{kind: "filter", fkey: f.fkey, fop: "==", fval: v}
+			case string:
+				if plainFvalRx.MatchString(v) {
+					out[i] = frag{kind: "filter", fkey: f.fkey, fop: "==", fval: v}
+				}
+			}
+			if len(evalPathLoose(data, out[:i+1])) == 1 {
+				continue
+			}
+		}
+		out[i] = frag{kind: "nth", n: 0}
+	}
+	return out
+}
+
+// pathsFor is a path of one to four fragments over data with the given keys; a descent is
+// never followed by another and always by some fragment (a wildcard when it would end the
+// path).
+func pathsFor(keys []string) hegel.Generator[[]frag] {
+	return hegel.Map(many(fragsFor(keys), 1, 4), func(fs []frag) []frag {
+		var out []frag
+		for _, f := range fs {
+			if f.kind == "desc" && len(out) > 0 && out[len(out)-1].kind == "desc" {
+				continue
+			}
+			out = append(out, f)
+		}
+		if out[len(out)-1].kind == "desc" {
+			out = append(out, frag{kind: "wild"})
+		}
+		return out
+	})
+}
+
+func escKey(k string) string {
+	return strings.NewReplacer(`\`, `\\`, `'`, `\'`).Replace(k)
+}
+
+func fvalText(v any) string {
+	switch t := v.(type) {
+	case int64:
+		return strconv.FormatInt(t, 10)
+	case float64:
+		s := strconv.FormatFloat(t, 'g', -1, 64)
+		if !strings.ContainsAny(s, ".eE") {
+			s += ".0"
+		}
+		return s
+	case string:
+		return "'" + t + "'"
+	case bool:
+		return fmt.Sprintf("%t", t)
+	}
+	return "null"
+}
+
+// pathText renders the fragments in dot form (bracket=false) or bracket form.
+func pathText(fs []frag, bracket bool) string {
+	var sb strings.Builder
+	sb.WriteByte('$')
+	afterDesc := false
+	for _, f := range fs {
+		switch f.kind {
+		case "desc":
+			sb.WriteString("..")
+			afterDesc = true
+			continue
+		case "child":
+			if simpleKey(f.key) && !bracket {
+				if !afterDesc {
+					sb.WriteByte('.')
+				}
+				sb.WriteString(f.key)
+			} else {
+				sb.WriteString("['" + escKey(f.key) + "']")
+			}
+		case "nth":
+			fmt.Fprintf(&sb, "[%d]", f.n)
+		case "wild":
+			if bracket {
+				sb.WriteString("[*]")
+			} else {
+				if !afterDesc {
+					sb.WriteByte('.')
+				}
+				sb.WriteByte('*')
+			}
+		case "slice":
+			sb.WriteByte('[')
+			if f.set[0] {
+				sb.WriteString(strconv.Itoa(f.sl[0]))
+			}
+			sb.WriteByte(':')
+			if f.set[1] {
+				sb.WriteString(strconv.Itoa(f.sl[1]))
+			}
+			if f.set[2] {
+				sb.WriteByte(':')
+				sb.WriteString(strconv.Itoa(f.sl[2]))
+			}
+			sb.WriteByte(']')
+		case "union":
+			sb.WriteByte('[')
+			for i, it := range f.union {
+				if i > 0 {
+					sb.WriteByte(',')
+				}
+				switch t := it.(type) {
+				case string:
+					sb.WriteString("'" + escKey(t) + "'")
+				case int:
+					sb.WriteString(strconv.Itoa(t))
+				}
+			}
+			sb.WriteByte(']')
+		case "filter":
+			sb.WriteString("[?(@")
+			if simpleKey(f.fkey) {
+				sb.WriteString("." + f.fkey)
+			} else {
+				sb.WriteString("['" + escKey(f.fkey) + "']")
+			}
+			if f.fop != "" {
+				sb.WriteString(" " + f.fop + " " + fvalText(f.fval))
+			}
+			sb.WriteString(")]")
+		}
+		afterDesc = false
+	}
+	return sb.String()
+}
+
+func descendants(v any) (out []any) {
+	switch t := v.(type) {
+	case []any:
+		for _, e := range t {
+			out = append(out, e)
+			out = append(out, descendants(e)...)
+		}
+	case map[string]any:
+		for _, e := range t {
+			out = append(out, e)
+			out = append(out, descendants(e)...)
+		}
+	}
+	return
+}
+
+// pySlice returns the indices selected by [start:end:step] with Python semantics (RFC 9535)
+// on n elements. While the switch of ojg/12 is on (HEGEL_NO_KNOWN=1) it reproduces the
+// library's clamp of negative-step bounds instead.
+func pySlice(n int, f frag) (idx []int) {
+	step := 1
+	if f.set[2] {
+		step = f.sl[2]
+	}
+	if step == 0 {
+		return nil
+	}
+	clamp := func(i, lo, hi int) int {
+		if i < lo {
+			return lo
+		}
+		if i > hi {
+			return hi
+		}
+		return i
+	}
+	var start, end int
+	if step > 0 {
+		start, end = 0, n
+		if f.set[0] {
+			start = f.sl[0]
+			if start < 0 {
+				start += n
+			}
+			start = clamp(start, 0, n)
+		}
+		if f.set[1] {
+			end = f.sl[1]
+			if end < 0 {
+				end += n
+			}
+			end = clamp(end, 0, n)
+		}
+		for i := start; i < end; i += step {
+			idx = append(idx, i)
+		}
+	} else {
+		if n == 0 {
+			return nil
+		}
+		start, end = n-1, -1
+		if f.set[0] {
+			start = f.sl[0]
+			if start < 0 {
+				start += n
+			}
+			lo := -1
+			if Known.sliceNegClamp {
+				lo = 0 // bug 12: a start before the array lands on its first element
+			}
+			start = clamp(start, lo, n-1)
+		}
+		if f.set[1] {
+			end = f.sl[1]
+			if end < 0 {
+				end += n
+			}
+			if Known.sliceNegClamp && end >= n {
+				end = n - 2 // bug 12: an end beyond the array becomes its last element, inclusive
+			} else {
+				end = clamp(end, -1, n-1)
+			}
+		}
+		for i := start; i > end; i += step {
+			idx = append(idx, i)
+		}
+	}
+	return
+}
+
+func toFloat(v any) (float64, bool) {
+	switch t := v.(type) {
+	case int64:
+		return float64(t), true
+	case float64:
+		return t, true
+	}
+	return 0, false
+}
+
+func compareVals(a any, op string, b any) bool {
+	if af, ok := toFloat(a); ok {
+		if bf, ok := toFloat(b); ok {
+			switch op {
+			case "==":
+				return af == bf
+			case "!=":
+				return af != bf
+			case "<":
+				return af < bf
+			case ">":
+				return af > bf
+			case "<=":
+				return af <= bf
+			case ">=":
+				return af >= bf
+			}
+		}
+	}
+	if as, ok := a.(string); ok {
+		if bs, ok := b.(string); ok {
+			switch op {
+			case "==":
+				return as == bs
+			case "!=":
+				return as != bs
+			case "<":
+				return as < bs
+			case ">":
+				return as > bs
+			case "<=":
+				return as <= bs
+			case ">=":
+				return as >= bs
+			}
+		}
+	}
+	if ab, ok := a.(bool); ok {
+		if bb, ok := b.(bool); ok {
+			switch op {
+			case "==":
+				return ab == bb
+			case "!=":
+				return ab != bb
+			}
+			return false
+		}
+	}
+	return op == "!="
+}
+
+func filterMatch(v any, f frag) bool {
+	m, ok := v.(map[string]any)
+	if !ok {
+		return f.fop == "!=" // @.key on a non-object is Nothing, which differs from everything
+	}
+	x, has := m[f.fkey]
+	if f.fop == "" {
+		return has
+	}
+	if !has {
+		return f.fop == "!="
+	}
+	return compareVals(x, f.fop, f.fval)
+}
+
+func children(v any) []any {
+	switch t := v.(type) {
+	case []any:
+		return t
+	case map[string]any:
+		out := make([]any, 0, len(t))
+		for _, e := range t {
+			out = append(out, e)
+		}
+		return out
+	}
+	return nil
+}
+
+func applyFrag(v any, f frag) (out []any) {
+	switch f.kind {
+	case "child":
+		if m, ok := v.(map[string]any); ok {
+			if x, ok := m[f.key]; ok {
+				out = append(out, x)
+			}
+		}
+	case "nth":
+		if a, ok := v.([]any); ok {
+			i := f.n
+			if i < 0 {
+				i += len(a)
+			}
+			if 0 <= i && i < len(a) {
+				out = append(out, a[i])
+			}
+		}
+	case "wild":
+		out = append(out, children(v)...)
+	case "slice":
+		if a, ok := v.([]any); ok {
+			for _, i := range pySlice(len(a), f) {
+				out = append(out, a[i])
+			}
+		}
+	case "union":
+		for _, it := range f.union {
+			switch t := it.(type) {
+			case string:
+				out = append(out, applyFrag(v, frag{kind: "child", key: t})...)
+			case int:
+				out = append(out, applyFrag(v, frag{kind: "nth", n: t})...)
+			}
+		}
+	case "filter":
+		for _, c := range children(v) {
+			if filterMatch(c, f) {
+				out = append(out, c)
+			}
+		}
+	}
+	return
+}
+
+// applyFragLoose is applyFrag with the semantics of the streaming matcher (jp.PathMatch on
+// the path plus the filter evaluated on the streamed element): a slice matches every index
+// and a negative index (never produced by a normalized path) nothing.
+func applyFragLoose(v any, f frag) []any {
+	switch f.kind {
+	case "slice":
+		if a, ok := v.([]any); ok {
+			return a
+		}
+		return nil
+	case "nth":
+		if f.n < 0 {
+			return nil
+		}
+	case "union":
+		g := frag{kind: "union"}
+		for _, it := range f.union {
+			if i, ok := it.(int); ok && i < 0 {
+				continue
+			}
+			g.union = append(g.union, it)
+		}
+		return applyFrag(v, g)
+	}
+	return applyFrag(v, f)
+}
+
+// evalPath is the brute-force JSONPath evaluation of fs on root.
+func evalPath(root any, fs []frag) []any { return evalWith(root, fs, applyFrag) }
+
+// evalPathLoose evaluates fs as a streaming matcher built on PathMatch would.
+func evalPathLoose(root any, fs []frag) []any { return evalWith(root, fs, applyFragLoose) }
+
+func evalWith(root any, fs []frag, apply func(any, frag) []any) []any {
+	cur := []any{root}
+	for i := 0; i < len(fs); i++ {
+		f := fs[i]
+		var next []any
+		if f.kind == "desc" {
+			i++
+			g := fs[i]
+			for _, c := range cur {
+				for _, n := range append([]any{c}, descendants(c)...) {
+					next = append(next, apply(n, g)...)
+				}
+			}
+		} else {
+			for _, c := range cur {
+				next = append(next, apply(c, f)...)
+			}
+		}
+		cur = next
+	}
+	return cur
+}
+
+// hasNegIndex reports whether fs uses a negative index anywhere (nth, union or slice).
+func hasNegIndex(fs []frag) bool {
+	for _, f := range fs {
+		switch f.kind {
+		case "nth":
+			if f.n < 0 {
+				return true
+			}
+		case "union":
+			if unionHasNeg(f) {
+				return true
+			}
+		case "slice":
+			for i := 0; i < 3; i++ {
+				if f.set[i] && f.sl[i] < 0 {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// unionHasNeg reports whether a union has a negative index among its members.
+func unionHasNeg(f frag) bool {
+	for _, it := range f.union {
+		if i, ok := it.(int); ok && i < 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// hasNegStepSlice reports whether fs has a slice with a negative step.
+func hasNegStepSlice(fs []frag) bool {
+	for _, f := range fs {
+		if f.kind == "slice" && f.set[2] && f.sl[2] < 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func hasDesc(fs []frag) bool { return hasKind(fs, "desc") }
+
+// descBracket reports whether a descent is followed by a fragment that String() renders in
+// bracket form (index, slice, union, filter, a child key that is not a plain identifier, or a
+// wildcard that was parsed from its bracket form).
+func descBracket(fs []frag, bracket bool) bool {
+	for i, f := range fs {
+		if f.kind != "desc" || i+1 >= len(fs) {
+			continue
+		}
+		switch g := fs[i+1]; g.kind {
+		case "nth", "slice", "union", "filter":
+			return true
+		case "child":
+			if !simpleKey(g.key) {
+				return true
+			}
+		case "wild":
+			if bracket {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// unionQuote reports whether a union in fs has a key containing a single quote or a backslash.
+func unionQuote(fs []frag) bool {
+	for _, f := range fs {
+		if f.kind != "union" {
+			continue
+		}
+		for _, it := range f.union {
+			if k, ok := it.(string); ok && strings.ContainsAny(k, "'\\") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasFloatNeq reports whether fs has a filter comparing its key with "!=" to anything but an
+// integer while an object anywhere in data holds a float64 under that key (the shape of
+// ojg/21).
+func hasFloatNeq(data any, fs []frag) bool {
+	for _, f := range fs {
+		if f.kind != "filter" || f.fop != "!=" {
+			continue
+		}
+		if _, isInt := f.fval.(int64); isInt {
+			continue
+		}
+		if anyMember(data, func(k string, v any) bool { _, isFloat := v.(float64); return k == f.fkey && isFloat }) {
+			return true
+		}
+	}
+	return false
+}
+
+// anyMember reports whether an object anywhere in v has a member satisfying pred.
+func anyMember(v any, pred func(k string, v any) bool) bool {
+	switch t := v.(type) {
+	case []any:
+		for _, e := range t {
+			if anyMember(e, pred) {
+				return true
+			}
+		}
+	case map[string]any:
+		for k, e := range t {
+			if pred(k, e) || anyMember(e, pred) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func hasKind(fs []frag, kind string) bool {
+	for _, f := range fs {
+		if f.kind == kind {
+			return true
+		}
+	}
+	return false
+}
+
+// stripNil deep-copies v dropping object members whose value is nil (alt's default OmitNil).
+func stripNil(v any) any {
+	switch t := v.(type) {
+	case []any:
+		a := make([]any, len(t))
+		for i, e := range t {
+			a[i] = stripNil(e)
+		}
+		return a
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			if e == nil {
+				continue
+			}
+			m[k] = stripNil(e)
+		}
+		return m
+	}
+	return v
+}
+
+// floatify deep-copies v turning every int64 into a float64 (Unmarshal into an interface).
+func floatify(v any) any {
+	switch t := v.(type) {
+	case int64:
+		return float64(t)
+	case []any:
+		a := make([]any, len(t))
+		for i, e := range t {
+			a[i] = floatify(e)
+		}
+		return a
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			m[k] = floatify(e)
+		}
+		return m
+	}
+	return v
+}
+
+// anyString reports whether a string value, or a key when keys is set, anywhere in v
+// satisfies pred.
+func anyString(v any, keys bool, pred func(string) bool) bool {
+	switch t := v.(type) {
+	case string:
+		return pred(t)
+	case []any:
+		for _, e := range t {
+			if anyString(e, keys, pred) {
+				return true
+			}
+		}
+	case map[string]any:
+		for k, e := range t {
+			if (keys && pred(k)) || anyString(e, keys, pred) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasLimitInt reports whether v holds an integer in the range ojg parses as json.Number
+// although it fits int64 (bug 1).
+func hasLimitInt(v any) bool {
+	switch t := v.(type) {
+	case int64:
+		return isLimitInt(t)
+	case []any:
+		for _, e := range t {
+			if hasLimitInt(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range t {
+			if hasLimitInt(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func isLimitInt(i int64) bool { return i >= 9223372036854775800 || i == math.MinInt64 }
+
+// senDash and senLiteral report whether v holds a string (value or key) that the SEN writer
+// leaves bare although it does not read back as that string: one starting with '-' (bug 5),
+// one of the words null, true and false (bug 6).
+func senDash(v any) bool {
+	return anyString(v, true, func(s string) bool { return strings.HasPrefix(s, "-") })
+}
+
+func senLiteral(v any) bool {
+	return anyString(v, true, func(s string) bool { return s == "null" || s == "true" || s == "false" })
+}
+
+const byteOrderMark = string(rune(0xFEFF))
+
+// senBOM reports whether v is a string starting with a byte order mark and going on after it:
+// the SEN writer leaves it bare and the SEN parser skips the mark at the start of a document,
+// so at the root it reads back without the mark, or as the number or literal it goes on with
+// (bug 22). The mark alone, and the same string inside a container, survive.
+func senBOM(v any) bool {
+	s, ok := v.(string)
+	return ok && strings.HasPrefix(s, byteOrderMark) && s != byteOrderMark
+}
+
+// unbare deep-copies v putting an "x" before every string (value or key) the SEN writer would
+// leave bare (the shapes of bugs 5 and 6) and before a root string starting with a byte order
+// mark (bug 22); the SEN property draws past the shapes with it under HEGEL_NO_KNOWN=1.
+func unbare(v any) any {
+	if senBOM(v) {
+		return "x" + v.(string)
+	}
+	return unbareIn(v)
+}
+
+func unbareIn(v any) any {
+	fix := func(s string) string {
+		if strings.HasPrefix(s, "-") || s == "null" || s == "true" || s == "false" {
+			return "x" + s
+		}
+		return s
+	}
+	switch t := v.(type) {
+	case string:
+		return fix(t)
+	case []any:
+		a := make([]any, len(t))
+		for i, e := range t {
+			a[i] = unbareIn(e)
+		}
+		return a
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			m[fix(k)] = unbareIn(e)
+		}
+		return m
+	}
+	return v
+}
+
+func isNormal(fs []frag) bool {
+	for _, f := range fs {
+		if f.kind != "child" && f.kind != "nth" {
+			return false
+		}
+	}
+	return true
+}
+
+// countNodes counts the values in v: all of them, or only the leaves (non-container values;
+// an empty container is not a leaf).
+func countNodes(v any, leavesOnly bool) int {
+	n := 0
+	switch t := v.(type) {
+	case []any:
+		for _, e := range t {
+			n += countNodes(e, leavesOnly)
+		}
+	case map[string]any:
+		for _, e := range t {
+			n += countNodes(e, leavesOnly)
+		}
+	default:
+		return 1
+	}
+	if !leavesOnly {
+		n++
+	}
+	return n
+}
+
+// --------------------------------------------------------------------------- locations and edits
+
+type step struct {
+	key   string
+	idx   int
+	isKey bool
+}
+
+// allLocs lists the paths to every value below root (root itself excluded).
+func allLocs(v any, prefix []step) (out [][]step) {
+	switch t := v.(type) {
+	case []any:
+		for i, e := range t {
+			p := append(append([]step{}, prefix...), step{idx: i})
+			out = append(out, p)
+			out = append(out, allLocs(e, p)...)
+		}
+	case map[string]any:
+		for _, k := range sortedKeys(t) {
+			p := append(append([]step{}, prefix...), step{key: k, isKey: true})
+			out = append(out, p)
+			out = append(out, allLocs(t[k], p)...)
+		}
+	}
+	return
+}
+
+// containerLocs lists the paths (root included, as the empty path) to every container.
+func containerLocs(v any) (out [][]step) {
+	out = append(out, []step{})
+	for _, p := range allLocs(v, nil) {
+		switch getAt(v, p).(type) {
+		case []any, map[string]any:
+			out = append(out, p)
+		}
+	}
+	return
+}
+
+// arrayLocs lists the paths (root included) to every array.
+func arrayLocs(v any) (out [][]step) {
+	for _, p := range containerLocs(v) {
+		if _, ok := getAt(v, p).([]any); ok {
+			out = append(out, p)
+		}
+	}
+	return
+}
+
+func getAt(v any, p []step) any {
+	for _, s := range p {
+		if s.isKey {
+			v = v.(map[string]any)[s.key]
+		} else {
+			v = v.([]any)[s.idx]
+		}
+	}
+	return v
+}
+
+func stepsText(p []step) string {
+	var sb strings.Builder
+	sb.WriteByte('$')
+	for _, s := range p {
+		if s.isKey {
+			if simpleKey(s.key) {
+				sb.WriteString("." + s.key)
+			} else {
+				sb.WriteString("['" + escKey(s.key) + "']")
+			}
+		} else {
+			fmt.Fprintf(&sb, "[%d]", s.idx)
+		}
+	}
+	return sb.String()
+}
+
+func stepsFrags(p []step) (fs []frag) {
+	for _, s := range p {
+		if s.isKey {
+			fs = append(fs, frag{kind: "child", key: s.key})
+		} else {
+			fs = append(fs, frag{kind: "nth", n: s.idx})
+		}
+	}
+	return
+}
+
+// editKind is the model's edit on the children of a container selected by the last fragment.
+type editKind int
+
+const (
+	editSet editKind = iota
+	editDel
+	editRemove
+)
+
+var editNames = map[editKind]string{editSet: "Set", editDel: "Del", editRemove: "Remove"}
+
+// applyEdit edits, in place, the children of the container c selected by the last fragment f.
+// Set on a missing object key adds it; Set on an index at or past the end of an array adds the
+// element (padding with nils, as documented); an index before the start selects nothing. Del
+// leaves a nil in arrays; Remove shortens them. The (possibly new) container is returned.
+func applyEdit(c any, f frag, kind editKind, val any) any {
+	switch t := c.(type) {
+	case map[string]any:
+		var keys []string
+		switch f.kind {
+		case "child":
+			keys = []string{f.key}
+		case "wild":
+			for k := range t {
+				keys = append(keys, k)
+			}
+		case "union":
+			for _, it := range f.union {
+				if k, ok := it.(string); ok {
+					keys = append(keys, k)
+				}
+			}
+		}
+		for _, k := range keys {
+			_, has := t[k]
+			switch kind {
+			case editSet:
+				t[k] = deepCopy(val)
+			default:
+				if has {
+					delete(t, k)
+				}
+			}
+		}
+		return t
+	case []any:
+		var idxs []int
+		add := func(i int) {
+			if i < 0 {
+				i += len(t)
+			}
+			if 0 <= i && i < len(t) {
+				idxs = append(idxs, i)
+			}
+		}
+		switch f.kind {
+		case "nth":
+			if kind == editSet && f.n >= len(t) {
+				for len(t) <= f.n {
+					t = append(t, nil)
+				}
+			}
+			add(f.n)
+		case "wild":
+			for i := range t {
+				idxs = append(idxs, i)
+			}
+		case "union":
+			for _, it := range f.union {
+				if i, ok := it.(int); ok {
+					if i < 0 && kind == editRemove && Known.removeUnionSkipsNegative {
+						continue // bug 10: Remove ignores the negative members of a union
+					}
+					add(i)
+				}
+			}
+		}
+		drop := map[int]bool{}
+		for _, i := range idxs {
+			switch kind {
+			case editSet:
+				t[i] = deepCopy(val)
+			case editDel:
+				t[i] = nil
+			case editRemove:
+				drop[i] = true
+			}
+		}
+		if len(drop) > 0 {
+			ns := make([]any, 0, len(t))
+			for i, e := range t {
+				if !drop[i] {
+					ns = append(ns, e)
+				}
+			}
+			return ns
+		}
+		return t
+	}
+	return c
+}
+
+// setAt replaces the value at path p in root (root itself when p is empty) and returns root.
+func setAt(root any, p []step, v any) any {
+	if len(p) == 0 {
+		return v
+	}
+	parent := getAt(root, p[:len(p)-1])
+	last := p[len(p)-1]
+	if last.isKey {
+		parent.(map[string]any)[last.key] = v
+	} else {
+		parent.([]any)[last.idx] = v
+	}
+	return root
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
