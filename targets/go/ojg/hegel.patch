+package hegel
+
+// The model: ojg's "simple types" (nil, bool, int64, float64, string, []any, map[string]any),
+// a canonical string form to compare them, a JSON text emitter with random whitespace and
+// escapes whose expected parse is known by construction, a text mutator, and a brute-force
+// JSONPath evaluator (RFC 9535 semantics on the simple types) with set/delete/remove.
+
+import (
+	"fmt"
+	"math"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode/utf16"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- values
+
+var keySet = []string{"a", "b", "c", "x", "id", "", "a b", "k\"q", "k'q", "é", "日", "a.b", "0", "-1", "$", "*", "back\\slash"}
+
+func genKey(tc hegel.TestCase) string {
+	if chance(tc, 70) {
+		return pick(tc, keySet[:5])
+	}
+	return pick(tc, keySet)
+}
+
+var simpleKeyRx = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+func simpleKey(k string) bool { return simpleKeyRx.MatchString(k) }
+
+var strSet = []string{"", "a", "hello", "with space", "tab\tnl\n", "quote\"back\\", "slash/", "<&>", "éü",
+	"  ", "emoji \U0001F600", "ctrl\x01\x1f", "\x7f", "\ufeff", "1", "true", "null", "-", "$.a", "a,b", "[x]"}
+
+const strAlphabet = "ab _-.\"\\/\né{}:"
+
+func genString(tc hegel.TestCase) string {
+	if chance(tc, 70) {
+		return pick(tc, strSet)
+	}
+	n := drawInt(tc, 0, 5)
+	rs := []rune(strAlphabet)
+	var sb strings.Builder
+	for i := 0; i < n; i++ {
+		sb.WriteRune(pick(tc, rs))
+	}
+	return sb.String()
+}
+
+var intSet = []int64{0, 1, -1, 7, 42, -100, 1000000, 999999999999, math.MaxInt64, math.MinInt64, math.MaxInt64 - 1,
+	math.MinInt64 + 1, 1 << 53, -(1 << 53), 922337203685477580, 9223372036854775800, 1 << 62}
+
+func genInt(tc hegel.TestCase) int64 {
+	if chance(tc, 60) {
+		return int64(drawInt(tc, -20, 20))
+	}
+	return pick(tc, intSet)
+}
+
+var floatTexts = []string{"0.5", "1.5", "-2.25", "1000.0", "3.14159", "1e-07", "123456789.123", "1e+21", "2.5e-300", "0.1",
+	"0.2", "0.30000000000000004", "1.7976931348623157e+308", "5e-324", "-0.001", "100.25", "1e15", "12345678.9", "0.000001",
+	"9007199254740993.0", "4.5", "-7.75", "1e100", "123.456e-5"}
+
+func genFloat(tc hegel.TestCase) float64 {
+	f, _ := strconv.ParseFloat(pick(tc, floatTexts), 64)
+	return f
+}
+
+// genValue draws a simple value; containers only while depth > 0.
+func genValue(tc hegel.TestCase, depth int) any {
+	r := drawInt(tc, 1, 100)
+	switch {
+	case r <= 8:
+		return nil
+	case r <= 18:
+		return chance(tc, 50)
+	case r <= 38:
+		return genInt(tc)
+	case r <= 52:
+		return genFloat(tc)
+	case r <= 72 || depth <= 0:
+		return genString(tc)
+	case r <= 86:
+		return genArray(tc, depth-1, drawInt(tc, 0, 4))
+	default:
+		return genObject(tc, depth-1, drawInt(tc, 0, 4))
+	}
+}
+
+func genArray(tc hegel.TestCase, depth, n int) []any {
+	a := make([]any, 0, n)
+	for i := 0; i < n; i++ {
+		a = append(a, genValue(tc, depth))
+	}
+	return a
+}
+
+func genObject(tc hegel.TestCase, depth, n int) map[string]any {
+	m := map[string]any{}
+	for i := 0; i < n; i++ {
+		m[genKey(tc)] = genValue(tc, depth)
+	}
+	return m
+}
+
+// genContainer draws an array or object (for the JSONPath properties).
+func genContainer(tc hegel.TestCase, depth int) any {
+	if chance(tc, 50) {
+		return genArray(tc, depth, drawInt(tc, 0, 5))
+	}
+	return genObject(tc, depth, drawInt(tc, 0, 5))
+}
+
+// --------------------------------------------------------------------------- canonical form
+
+// canon renders a simple value with its types (i for int64, f for float64, N for json.Number).
+func canon(v any) string {
+	var sb strings.Builder
+	canonTo(&sb, v, false)
+	return sb.String()
+}
+
+// canonLoose renders int64 and integral float64 alike (the JSON text does not tell them apart).
+func canonLoose(v any) string {
+	var sb strings.Builder
+	canonTo(&sb, v, true)
+	return sb.String()
+}
+
+func canonTo(sb *strings.Builder, v any, loose bool) {
+	switch t := v.(type) {
+	case nil:
+		sb.WriteString("null")
+	case bool:
+		fmt.Fprintf(sb, "%t", t)
+	case int64:
+		if loose && -(1<<53) <= t && t <= 1<<53 {
+			fmt.Fprintf(sb, "n%s", strconv.FormatFloat(float64(t), 'g', -1, 64))
+		} else {
+			fmt.Fprintf(sb, "i%d", t)
+		}
+	case int:
+		canonTo(sb, int64(t), loose)
+	case float64:
+		if loose && t == math.Trunc(t) && math.Abs(t) <= 1<<53 {
+			fmt.Fprintf(sb, "n%s", strconv.FormatFloat(t, 'g', -1, 64))
+		} else {
+			fmt.Fprintf(sb, "f%s", strconv.FormatFloat(t, 'g', -1, 64))
+		}
+	case string:
+		sb.WriteString(strconv.Quote(t))
+	case []any:
+		sb.WriteByte('[')
+		for i, e := range t {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			canonTo(sb, e, loose)
+		}
+		sb.WriteByte(']')
+	case map[string]any:
+		keys := make([]string, 0, len(t))
+		for k := range t {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		sb.WriteByte('{')
+		for i, k := range keys {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			sb.WriteString(strconv.Quote(k))
+			sb.WriteByte(':')
+			canonTo(sb, t[k], loose)
+		}
+		sb.WriteByte('}')
+	default:
+		if s, ok := v.(fmt.Stringer); ok {
+			fmt.Fprintf(sb, "?%T:%s", v, s.String())
+		} else {
+			fmt.Fprintf(sb, "?%T:%v", v, v)
+		}
+	}
+}
+
+func sameValue(a, b any) bool { return canon(a) == canon(b) }
+
+func sortStrings(s []string) { sort.Strings(s) }
+
+// sameMulti compares two result lists as multisets of canonical forms.
+func sameMulti(a, b []any) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	as := make([]string, len(a))
+	bs := make([]string, len(b))
+	for i := range a {
+		as[i] = canon(a[i])
+		bs[i] = canon(b[i])
+	}
+	sort.Strings(as)
+	sort.Strings(bs)
+	for i := range as {
+		if as[i] != bs[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func deepCopy(v any) any {
+	switch t := v.(type) {
+	case []any:
+		a := make([]any, len(t))
+		for i, e := range t {
+			a[i] = deepCopy(e)
+		}
+		return a
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			m[k] = deepCopy(e)
+		}
+		return m
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- JSON text
+
+type emitter struct {
+	tc  hegel.TestCase
+	sb  strings.Builder
+	ws  bool
+	esc bool
+}
+
+// emitJSON writes v as JSON text with random whitespace, escapes and number spellings; the
+// text parses back to exactly v (ints stay ints, floats stay floats).
+func emitJSON(tc hegel.TestCase, v any) string {
+	e := &emitter{tc: tc, ws: chance(tc, 50), esc: chance(tc, 50)}
+	e.value(v)
+	return e.sb.String()
+}
+
+var wsSet = []string{" ", "\n", "\t", "\r\n", "  ", "\r"}
+
+func (e *emitter) space() {
+	if e.ws && chance(e.tc, 30) {
+		e.sb.WriteString(pick(e.tc, wsSet))
+	}
+}
+
+func (e *emitter) value(v any) {
+	e.space()
+	switch t := v.(type) {
+	case nil:
+		e.sb.WriteString("null")
+	case bool:
+		fmt.Fprintf(&e.sb, "%t", t)
+	case int64:
+		e.sb.WriteString(strconv.FormatInt(t, 10))
+	case float64:
+		e.sb.WriteString(e.floatText(t))
+	case string:
+		e.str(t)
+	case []any:
+		e.sb.WriteByte('[')
+		for i, x := range t {
+			if i > 0 {
+				e.sb.WriteByte(',')
+			}
+			e.value(x)
+		}
+		e.space()
+		e.sb.WriteByte(']')
+	case map[string]any:
+		e.sb.WriteByte('{')
+		i := 0
+		for k, x := range t {
+			if i > 0 {
+				e.sb.WriteByte(',')
+			}
+			i++
+			e.space()
+			e.str(k)
+			e.space()
+			e.sb.WriteByte(':')
+			e.value(x)
+		}
+		e.space()
+		e.sb.WriteByte('}')
+	default:
+		panic(fmt.Sprintf("emit: unexpected %T", v))
+	}
+	e.space()
+}
+
+// floatText spells f so that the literal has a '.' or an exponent and stays within ojg's
+// int64-accumulator limits (fewer than 18 fraction digits, exponent below 1023).
+func (e *emitter) floatText(f float64) string {
+	var s string
+	switch drawInt(e.tc, 0, 3) {
+	case 0:
+		s = strconv.FormatFloat(f, 'g', -1, 64)
+	case 1:
+		s = strconv.FormatFloat(f, 'e', -1, 64)
+	case 2:
+		s = strconv.FormatFloat(f, 'E', -1, 64)
+	default:
+		s = strconv.FormatFloat(f, 'f', -1, 64)
+		if dot := strings.IndexByte(s, '.'); (dot >= 0 && len(s)-dot-1 > 17) || (dot < 0 && len(s) > 18) || (dot > 18) {
+			s = strconv.FormatFloat(f, 'g', -1, 64)
+		}
+	}
+	if !strings.ContainsAny(s, ".eE") {
+		s += ".0"
+	}
+	return s
+}
+
+func (e *emitter) str(s string) {
+	e.sb.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"':
+			e.sb.WriteString(`\"`)
+		case r == '\\':
+			e.sb.WriteString(`\\`)
+		case r < 0x20:
+			short := map[rune]string{'\n': `\n`, '\t': `\t`, '\r': `\r`, '\b': `\b`, '\f': `\f`}[r]
+			if short != "" && chance(e.tc, 60) {
+				e.sb.WriteString(short)
+			} else {
+				fmt.Fprintf(&e.sb, `\u%04x`, r)
+			}
+		case r == '/' && e.esc && chance(e.tc, 50):
+			e.sb.WriteString(`\/`)
+		case r < 0x80:
+			if e.esc && chance(e.tc, 10) {
+				fmt.Fprintf(&e.sb, `\u%04X`, r)
+			} else {
+				e.sb.WriteRune(r)
+			}
+		case r > 0xFFFF && e.esc && !Known.noSurrogatePairs && chance(e.tc, 60):
+			hi, lo := utf16.EncodeRune(r)
+			fmt.Fprintf(&e.sb, `\u%04x\u%04X`, hi, lo)
+		case r <= 0xFFFF && e.esc && chance(e.tc, 30):
+			fmt.Fprintf(&e.sb, `\u%04x`, r)
+		default:
+			e.sb.WriteRune(r)
+		}
+	}
+	e.sb.WriteByte('"')
+}
+
+var mutBytes = []byte("{}[]:,\"\\ 0123456789.eE+-tfnul/xabTFN\t\n\f\x00\x7f'")
+
+// mutate applies one random edit to s.
+func mutate(tc hegel.TestCase, s string) string {
+	b := []byte(s)
+	if len(b) == 0 {
+		return string(pick(tc, mutBytes))
+	}
+	i := drawInt(tc, 0, len(b)-1)
+	c := pick(tc, mutBytes)
+	switch drawInt(tc, 0, 5) {
+	case 0:
+		b = append(b[:i:i], b[i+1:]...)
+	case 1:
+		b = append(b[:i:i], append([]byte{c}, b[i:]...)...)
+	case 2:
+		b[i] = c
+	case 3:
+		b = b[:i]
+	case 4:
+		b = append(b, c)
+	default:
+		b = append(b[:i+1:i+1], b[i:]...)
+	}
+	return string(b)
+}
+
+// --------------------------------------------------------------------------- JSONPath
+
+type frag struct {
+	kind  string // child nth wild desc slice union filter
+	key   string
+	n     int
+	sl    [3]int
+	set   [3]bool
+	union []any // string or int
+	fkey  string
+	fop   string // "" (exists) == != < > <= >=
+	fval  any
+}
+
+// keysIn collects the object keys used anywhere in v.
+func keysIn(v any, acc map[string]bool) {
+	switch t := v.(type) {
+	case []any:
+		for _, e := range t {
+			keysIn(e, acc)
+		}
+	case map[string]any:
+		for k, e := range t {
+			acc[k] = true
+			keysIn(e, acc)
+		}
+	}
+}
+
+func genPathKey(tc hegel.TestCase, keys []string) string {
+	if len(keys) > 0 && chance(tc, 75) {
+		return pick(tc, keys)
+	}
+	return genKey(tc)
+}
+
+var filterOps = []string{"", "==", "!=", "<", ">", "<=", ">="}
+
+func genFrag(tc hegel.TestCase, keys []string, edit bool) frag {
+	kinds := []string{"child", "child", "nth", "nth", "wild", "union"}
+	if !edit {
+		kinds = append(kinds, "slice", "filter", "desc")
+	}
+	f := frag{kind: pick(tc, kinds)}
+	switch f.kind {
+	case "child":
+		f.key = genPathKey(tc, keys)
+	case "nth":
+		f.n = drawInt(tc, -3, 4)
+	case "slice":
+		for i := 0; i < 3; i++ {
+			if chance(tc, 55) {
+				f.set[i] = true
+				f.sl[i] = drawInt(tc, -4, 5)
+			}
+		}
+		if f.set[2] && f.sl[2] == 0 {
+			f.sl[2] = 1
+		}
+	case "union":
+		n := drawInt(tc, 2, 3) // one member would read back as a plain child or index
+		seen := map[string]bool{}
+		for len(f.union) < n {
+			var it any
+			if chance(tc, 50) {
+				it = genPathKey(tc, keys)
+			} else {
+				it = drawInt(tc, -2, 4)
+			}
+			s := fmt.Sprintf("%T%v", it, it)
+			if !seen[s] {
+				seen[s] = true
+				f.union = append(f.union, it)
+			}
+		}
+	case "filter":
+		f.fkey = genPathKey(tc, keys)
+		f.fop = pick(tc, filterOps)
+		if f.fop != "" {
+			switch drawInt(tc, 0, 3) {
+			case 0:
+				f.fval = int64(drawInt(tc, -3, 10))
+			case 1:
+				f.fval = pick(tc, []float64{0.5, 1.5, 2, -2.25, 1000})
+			case 2:
+				f.fval = pick(tc, []string{"a", "hello", "", "x y", "1"})
+			default:
+				f.fval = chance(tc, 50)
+			}
+		}
+	}
+	return f
+}
+
+// genPath draws 1..4 fragments; a descent is always followed by another fragment.
+func genPath(tc hegel.TestCase, data any) []frag {
+	acc := map[string]bool{}
+	keysIn(data, acc)
+	keys := make([]string, 0, len(acc))
+	for k := range acc {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	n := drawInt(tc, 1, 4)
+	var fs []frag
+	for len(fs) < n {
+		f := genFrag(tc, keys, false)
+		if f.kind == "desc" {
+			if len(fs) > 0 && fs[len(fs)-1].kind == "desc" {
+				continue
+			}
+			fs = append(fs, f)
+			continue
+		}
+		fs = append(fs, f)
+	}
+	if fs[len(fs)-1].kind == "desc" {
+		fs = append(fs, frag{kind: "wild"})
+	}
+	return fs
+}
+
+func escKey(k string) string {
+	return strings.NewReplacer(`\`, `\\`, `'`, `\'`).Replace(k)
+}
+
+func fvalText(v any) string {
+	switch t := v.(type) {
+	case int64:
+		return strconv.FormatInt(t, 10)
+	case float64:
+		s := strconv.FormatFloat(t, 'g', -1, 64)
+		if !strings.ContainsAny(s, ".eE") {
+			s += ".0"
+		}
+		return s
+	case string:
+		return "'" + t + "'"
+	case bool:
+		return fmt.Sprintf("%t", t)
+	}
+	return "null"
+}
+
+// pathText renders the fragments in dot form (bracket=false) or bracket form.
+func pathText(fs []frag, bracket bool) string {
+	var sb strings.Builder
+	sb.WriteByte('$')
+	afterDesc := false
+	for _, f := range fs {
+		switch f.kind {
+		case "desc":
+			sb.WriteString("..")
+			afterDesc = true
+			continue
+		case "child":
+			if simpleKey(f.key) && !bracket {
+				if !afterDesc {
+					sb.WriteByte('.')
+				}
+				sb.WriteString(f.key)
+			} else {
+				sb.WriteString("['" + escKey(f.key) + "']")
+			}
+		case "nth":
+			fmt.Fprintf(&sb, "[%d]", f.n)
+		case "wild":
+			if bracket {
+				sb.WriteString("[*]")
+			} else {
+				if !afterDesc {
+					sb.WriteByte('.')
+				}
+				sb.WriteByte('*')
+			}
+		case "slice":
+			sb.WriteByte('[')
+			if f.set[0] {
+				sb.WriteString(strconv.Itoa(f.sl[0]))
+			}
+			sb.WriteByte(':')
+			if f.set[1] {
+				sb.WriteString(strconv.Itoa(f.sl[1]))
+			}
+			if f.set[2] {
+				sb.WriteByte(':')
+				sb.WriteString(strconv.Itoa(f.sl[2]))
+			}
+			sb.WriteByte(']')
+		case "union":
+			sb.WriteByte('[')
+			for i, it := range f.union {
+				if i > 0 {
+					sb.WriteByte(',')
+				}
+				switch t := it.(type) {
+				case string:
+					sb.WriteString("'" + escKey(t) + "'")
+				case int:
+					sb.WriteString(strconv.Itoa(t))
+				}
+			}
+			sb.WriteByte(']')
+		case "filter":
+			sb.WriteString("[?(@")
+			if simpleKey(f.fkey) {
+				sb.WriteString("." + f.fkey)
+			} else {
+				sb.WriteString("['" + escKey(f.fkey) + "']")
+			}
+			if f.fop != "" {
+				sb.WriteString(" " + f.fop + " " + fvalText(f.fval))
+			}
+			sb.WriteString(")]")
+		}
+		afterDesc = false
+	}
+	return sb.String()
+}
+
+func descendants(v any) (out []any) {
+	switch t := v.(type) {
+	case []any:
+		for _, e := range t {
+			out = append(out, e)
+			out = append(out, descendants(e)...)
+		}
+	case map[string]any:
+		for _, e := range t {
+			out = append(out, e)
+			out = append(out, descendants(e)...)
+		}
+	}
+	return
+}
+
+// pySlice returns the indices selected by [start:end:step] with Python semantics on n elements.
+func pySlice(n int, f frag) (idx []int) {
+	step := 1
+	if f.set[2] {
+		step = f.sl[2]
+	}
+	if step == 0 {
+		return nil
+	}
+	clamp := func(i, lo, hi int) int {
+		if i < lo {
+			return lo
+		}
+		if i > hi {
+			return hi
+		}
+		return i
+	}
+	var start, end int
+	if step > 0 {
+		start, end = 0, n
+		if f.set[0] {
+			start = f.sl[0]
+			if start < 0 {
+				start += n
+			}
+			start = clamp(start, 0, n)
+		}
+		if f.set[1] {
+			end = f.sl[1]
+			if end < 0 {
+				end += n
+			}
+			end = clamp(end, 0, n)
+		}
+		for i := start; i < end; i += step {
+			idx = append(idx, i)
+		}
+	} else {
+		if n == 0 {
+			return nil
+		}
+		start, end = n-1, -1
+		if f.set[0] {
+			start = f.sl[0]
+			if start < 0 {
+				start += n
+			}
+			lo := -1
+			if Known.sliceNegClamp {
+				lo = 0 // bug 12: a start before the array lands on its first element
+			}
+			start = clamp(start, lo, n-1)
+		}
+		if f.set[1] {
+			end = f.sl[1]
+			if end < 0 {
+				end += n
+			}
+			if Known.sliceNegClamp && end >= n {
+				end = n - 2 // bug 12: an end beyond the array becomes its last element, inclusive
+			} else {
+				end = clamp(end, -1, n-1)
+			}
+		}
+		for i := start; i > end; i += step {
+			idx = append(idx, i)
+		}
+	}
+	return
+}
+
+func toFloat(v any) (float64, bool) {
+	switch t := v.(type) {
+	case int64:
+		return float64(t), true
+	case float64:
+		return t, true
+	}
+	return 0, false
+}
+
+func compareVals(a any, op string, b any) bool {
+	if af, ok := toFloat(a); ok {
+		if bf, ok := toFloat(b); ok {
+			switch op {
+			case "==":
+				return af == bf
+			case "!=":
+				return af != bf
+			case "<":
+				return af < bf
+			case ">":
+				return af > bf
+			case "<=":
+				return af <= bf
+			case ">=":
+				return af >= bf
+			}
+		}
+	}
+	if as, ok := a.(string); ok {
+		if bs, ok := b.(string); ok {
+			switch op {
+			case "==":
+				return as == bs
+			case "!=":
+				return as != bs
+			case "<":
+				return as < bs
+			case ">":
+				return as > bs
+			case "<=":
+				return as <= bs
+			case ">=":
+				return as >= bs
+			}
+		}
+	}
+	if ab, ok := a.(bool); ok {
+		if bb, ok := b.(bool); ok {
+			switch op {
+			case "==":
+				return ab == bb
+			case "!=":
+				return ab != bb
+			}
+			return false
+		}
+	}
+	return op == "!="
+}
+
+func filterMatch(v any, f frag) bool {
+	m, ok := v.(map[string]any)
+	if !ok {
+		return f.fop == "!=" // @.key on a non-object is Nothing, which differs from everything
+	}
+	x, has := m[f.fkey]
+	if f.fop == "" {
+		return has
+	}
+	if !has {
+		return f.fop == "!="
+	}
+	return compareVals(x, f.fop, f.fval)
+}
+
+func children(v any) []any {
+	switch t := v.(type) {
+	case []any:
+		return t
+	case map[string]any:
+		out := make([]any, 0, len(t))
+		for _, e := range t {
+			out = append(out, e)
+		}
+		return out
+	}
+	return nil
+}
+
+func applyFrag(v any, f frag) (out []any) {
+	switch f.kind {
+	case "child":
+		if m, ok := v.(map[string]any); ok {
+			if x, ok := m[f.key]; ok {
+				out = append(out, x)
+			}
+		}
+	case "nth":
+		if a, ok := v.([]any); ok {
+			i := f.n
+			if i < 0 {
+				i += len(a)
+			}
+			if 0 <= i && i < len(a) {
+				out = append(out, a[i])
+			}
+		}
+	case "wild":
+		out = append(out, children(v)...)
+	case "slice":
+		if a, ok := v.([]any); ok {
+			for _, i := range pySlice(len(a), f) {
+				out = append(out, a[i])
+			}
+		}
+	case "union":
+		for _, it := range f.union {
+			switch t := it.(type) {
+			case string:
+				out = append(out, applyFrag(v, frag{kind: "child", key: t})...)
+			case int:
+				out = append(out, applyFrag(v, frag{kind: "nth", n: t})...)
+			}
+		}
+	case "filter":
+		for _, c := range children(v) {
+			if filterMatch(c, f) {
+				out = append(out, c)
+			}
+		}
+	}
+	return
+}
+
+// applyFragLoose is applyFrag with the semantics of the streaming matcher (jp.PathMatch on
+// the path plus the filter evaluated on the streamed element): a slice matches every index
+// and a negative index (never produced by a normalized path) nothing.
+func applyFragLoose(v any, f frag) []any {
+	switch f.kind {
+	case "slice":
+		if a, ok := v.([]any); ok {
+			return a
+		}
+		return nil
+	case "nth":
+		if f.n < 0 {
+			return nil
+		}
+	case "union":
+		g := frag{kind: "union"}
+		for _, it := range f.union {
+			if i, ok := it.(int); ok && i < 0 {
+				continue
+			}
+			g.union = append(g.union, it)
+		}
+		return applyFrag(v, g)
+	}
+	return applyFrag(v, f)
+}
+
+// evalPath is the brute-force JSONPath evaluation of fs on root.
+func evalPath(root any, fs []frag) []any { return evalWith(root, fs, applyFrag) }
+
+// evalPathLoose evaluates fs as a streaming matcher built on PathMatch would.
+func evalPathLoose(root any, fs []frag) []any { return evalWith(root, fs, applyFragLoose) }
+
+func evalWith(root any, fs []frag, apply func(any, frag) []any) []any {
+	cur := []any{root}
+	for i := 0; i < len(fs); i++ {
+		f := fs[i]
+		var next []any
+		if f.kind == "desc" {
+			i++
+			g := fs[i]
+			for _, c := range cur {
+				for _, n := range append([]any{c}, descendants(c)...) {
+					next = append(next, apply(n, g)...)
+				}
+			}
+		} else {
+			for _, c := range cur {
+				next = append(next, apply(c, f)...)
+			}
+		}
+		cur = next
+	}
+	return cur
+}
+
+// hasNegIndex reports whether fs uses a negative index anywhere (nth, union or slice).
+func hasNegIndex(fs []frag) bool {
+	for _, f := range fs {
+		switch f.kind {
+		case "nth":
+			if f.n < 0 {
+				return true
+			}
+		case "union":
+			for _, it := range f.union {
+				if i, ok := it.(int); ok && i < 0 {
+					return true
+				}
+			}
+		case "slice":
+			for i := 0; i < 3; i++ {
+				if f.set[i] && f.sl[i] < 0 {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// hasNegStepSlice reports whether fs has a slice with a negative step.
+func hasNegStepSlice(fs []frag) bool {
+	for _, f := range fs {
+		if f.kind == "slice" && f.set[2] && f.sl[2] < 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func hasDesc(fs []frag) bool {
+	for _, f := range fs {
+		if f.kind == "desc" {
+			return true
+		}
+	}
+	return false
+}
+
+// descBracket reports whether a descent is followed by a fragment that String() renders in
+// bracket form (index, slice, union, filter, a child key that is not a plain identifier, or a
+// wildcard that was parsed from its bracket form).
+func descBracket(fs []frag, bracket bool) bool {
+	for i, f := range fs {
+		if f.kind != "desc" || i+1 >= len(fs) {
+			continue
+		}
+		switch g := fs[i+1]; g.kind {
+		case "nth", "slice", "union", "filter":
+			return true
+		case "child":
+			if !simpleKey(g.key) {
+				return true
+			}
+		case "wild":
+			if bracket {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// unionQuote reports whether a union in fs has a key containing a single quote or a backslash.
+func unionQuote(fs []frag) bool {
+	for _, f := range fs {
+		if f.kind != "union" {
+			continue
+		}
+		for _, it := range f.union {
+			if k, ok := it.(string); ok && strings.ContainsAny(k, "'\\") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func hasKind(fs []frag, kind string) bool {
+	for _, f := range fs {
+		if f.kind == kind {
+			return true
+		}
+	}
+	return false
+}
+
+// stripNil deep-copies v dropping object members whose value is nil (alt's default OmitNil).
+func stripNil(v any) any {
+	switch t := v.(type) {
+	case []any:
+		a := make([]any, len(t))
+		for i, e := range t {
+			a[i] = stripNil(e)
+		}
+		return a
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			if e == nil {
+				continue
+			}
+			m[k] = stripNil(e)
+		}
+		return m
+	}
+	return v
+}
+
+// floatify deep-copies v turning every int64 into a float64 (Unmarshal into an interface).
+func floatify(v any) any {
+	switch t := v.(type) {
+	case int64:
+		return float64(t)
+	case []any:
+		a := make([]any, len(t))
+		for i, e := range t {
+			a[i] = floatify(e)
+		}
+		return a
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, e := range t {
+			m[k] = floatify(e)
+		}
+		return m
+	}
+	return v
+}
+
+// hasLimitInt reports whether v holds an integer in the range ojg parses as json.Number
+// although it fits int64 (bug 1).
+func hasLimitInt(v any) bool {
+	switch t := v.(type) {
+	case int64:
+		return t >= 9223372036854775800 || t == math.MinInt64
+	case []any:
+		for _, e := range t {
+			if hasLimitInt(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for _, e := range t {
+			if hasLimitInt(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// senBare reports whether v holds a string (value or key) that the SEN writer leaves bare
+// although it does not read back as that string (bugs 5 and 6).
+func senBare(v any) bool {
+	bare := func(s string) bool {
+		return strings.HasPrefix(s, "-") || s == "null" || s == "true" || s == "false"
+	}
+	switch t := v.(type) {
+	case string:
+		return bare(t)
+	case []any:
+		for _, e := range t {
+			if senBare(e) {
+				return true
+			}
+		}
+	case map[string]any:
+		for k, e := range t {
+			if bare(k) || senBare(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func isNormal(fs []frag) bool {
+	for _, f := range fs {
+		if f.kind != "child" && f.kind != "nth" {
+			return false
+		}
+	}
+	return true
+}
+
+// countNodes counts the values in v: all of them, or only the leaves (non-container values;
+// an empty container is not a leaf).
+func countNodes(v any, leavesOnly bool) int {
+	n := 0
+	switch t := v.(type) {
+	case []any:
+		for _, e := range t {
+			n += countNodes(e, leavesOnly)
+		}
+	case map[string]any:
+		for _, e := range t {
+			n += countNodes(e, leavesOnly)
+		}
+	default:
+		return 1
+	}
+	if !leavesOnly {
+		n++
+	}
+	return n
+}
+
+// --------------------------------------------------------------------------- locations and edits
+
+type step struct {
+	key   string
+	idx   int
+	isKey bool
+}
+
+// allLocs lists the paths to every value below root (root itself excluded).
+func allLocs(v any, prefix []step) (out [][]step) {
+	switch t := v.(type) {
+	case []any:
+		for i, e := range t {
+			p := append(append([]step{}, prefix...), step{idx: i})
+			out = append(out, p)
+			out = append(out, allLocs(e, p)...)
+		}
+	case map[string]any:
+		keys := make([]string, 0, len(t))
+		for k := range t {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			p := append(append([]step{}, prefix...), step{key: k, isKey: true})
+			out = append(out, p)
+			out = append(out, allLocs(t[k], p)...)
+		}
+	}
+	return
+}
+
+// containerLocs lists the paths (root included, as the empty path) to every container.
+func containerLocs(v any) (out [][]step) {
+	out = append(out, []step{})
+	for _, p := range allLocs(v, nil) {
+		switch getAt(v, p).(type) {
+		case []any, map[string]any:
+			out = append(out, p)
+		}
+	}
+	return
+}
+
+func getAt(v any, p []step) any {
+	for _, s := range p {
+		if s.isKey {
+			v = v.(map[string]any)[s.key]
+		} else {
+			v = v.([]any)[s.idx]
+		}
+	}
+	return v
+}
+
+func stepsText(p []step) string {
+	var sb strings.Builder
+	sb.WriteByte('$')
+	for _, s := range p {
+		if s.isKey {
+			if simpleKey(s.key) {
+				sb.WriteString("." + s.key)
+			} else {
+				sb.WriteString("['" + escKey(s.key) + "']")
+			}
+		} else {
+			fmt.Fprintf(&sb, "[%d]", s.idx)
+		}
+	}
+	return sb.String()
+}
+
+func stepsFrags(p []step) (fs []frag) {
+	for _, s := range p {
+		if s.isKey {
+			fs = append(fs, frag{kind: "child", key: s.key})
+		} else {
+			fs = append(fs, frag{kind: "nth", n: s.idx})
+		}
+	}
+	return
+}
+
+// editKind is the model's edit on the children of a container selected by the last fragment.
+type editKind int
+
+const (
+	editSet editKind = iota
+	editDel
+	editRemove
+)
+
+// applyEdit edits, in place, the children of the container c selected by the last fragment f.
+// Set on a missing object key adds it. Del leaves a nil in arrays; Remove shortens them.
+// The (possibly new) container is returned.
+func applyEdit(c any, f frag, kind editKind, val any) any {
+	switch t := c.(type) {
+	case map[string]any:
+		var keys []string
+		switch f.kind {
+		case "child":
+			keys = []string{f.key}
+		case "wild":
+			for k := range t {
+				keys = append(keys, k)
+			}
+		case "union":
+			for _, it := range f.union {
+				if k, ok := it.(string); ok {
+					keys = append(keys, k)
+				}
+			}
+		}
+		for _, k := range keys {
+			_, has := t[k]
+			switch kind {
+			case editSet:
+				t[k] = deepCopy(val)
+			default:
+				if has {
+					delete(t, k)
+				}
+			}
+		}
+		return t
+	case []any:
+		var idxs []int
+		add := func(i int) {
+			if i < 0 {
+				i += len(t)
+			}
+			if 0 <= i && i < len(t) {
+				idxs = append(idxs, i)
+			}
+		}
+		switch f.kind {
+		case "nth":
+			add(f.n)
+		case "wild":
+			for i := range t {
+				idxs = append(idxs, i)
+			}
+		case "union":
+			for _, it := range f.union {
+				if i, ok := it.(int); ok {
+					add(i)
+				}
+			}
+		}
+		drop := map[int]bool{}
+		for _, i := range idxs {
+			switch kind {
+			case editSet:
+				t[i] = deepCopy(val)
+			case editDel:
+				t[i] = nil
+			case editRemove:
+				drop[i] = true
+			}
+		}
+		if len(drop) > 0 {
+			ns := make([]any, 0, len(t))
+			for i, e := range t {
+				if !drop[i] {
+					ns = append(ns, e)
+				}
+			}
+			return ns
+		}
+		return t
+	}
+	return c
+}
+
+// setAt replaces the value at path p in root (root itself when p is empty) and returns root.
+func setAt(root any, p []step, v any) any {
+	if len(p) == 0 {
+		return v
+	}
+	parent := getAt(root, p[:len(p)-1])
+	last := p[len(p)-1]
+	if last.isKey {
+		parent.(map[string]any)[last.key] = v
+	} else {
+		parent.([]any)[last.idx] = v
+	}
+	return root
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..ea81495
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,246 @@
+package hegel
+
+// Pins: one deterministic test per recorded bug, asserting the documented behaviour. Each
+// fails while the bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/ohler55/ojg/jp"
+	"github.com/ohler55/ojg/oj"
+	"github.com/ohler55/ojg/sen"
+)
+
+// ojg/1: integer literals within int64 parse as int64.
+func TestHegelPinIntLimits(t *testing.T) {
+	for _, s := range []string{"9223372036854775807", "9223372036854775800", "-9223372036854775808"} {
+		v, err := oj.ParseString(s)
+		if err != nil {
+			t.Fatalf("ParseString(%s): %v", s, err)
+		}
+		if _, ok := v.(int64); !ok {
+			t.Errorf("ParseString(%s) = %T %v, want int64", s, v, v)
+		}
+	}
+}
+
+// ojg/2: Validate rejects documents with unclosed arrays or objects.
+func TestHegelPinValidateTruncated(t *testing.T) {
+	for _, s := range []string{"[", "[1,2", `{"a":1`, `["a"`, "[[", "{} ["} {
+		if err := oj.ValidateString(s); err == nil {
+			t.Errorf("ValidateString(%q) accepted a truncated document", s)
+		}
+	}
+}
+
+// ojg/3: Set on the index just past the end of an array adds the element, as documented.
+func TestHegelPinSetAppend(t *testing.T) {
+	a := []any{int64(1)}
+	if err := jp.MustParseString("$[1]").Set(a, int64(2)); err != nil {
+		t.Fatalf("Set $[1] on [1]: %v", err)
+	}
+	m := map[string]any{"a": []any{int64(1)}}
+	if err := jp.MustParseString("$.a[1]").Set(m, int64(2)); err != nil {
+		t.Fatalf("Set $.a[1] on {a:[1]}: %v", err)
+	}
+	if got := canon(m); got != `{"a":[i1,i2]}` {
+		t.Errorf("Set $.a[1] on {a:[1]} = %s", got)
+	}
+}
+
+// ojg/4: Del of an index outside the array is a no-op, like Remove and like a missing key.
+func TestHegelPinDelOutOfRange(t *testing.T) {
+	a := []any{int64(1)}
+	if err := jp.MustParseString("$[5]").Del(a); err != nil {
+		t.Errorf("Del $[5] on [1]: %v", err)
+	}
+	if err := jp.MustParseString("$[-5]").DelOne(a); err != nil {
+		t.Errorf("DelOne $[-5] on [1]: %v", err)
+	}
+	if got := canon(a); got != "[i1]" {
+		t.Errorf("array changed to %s", got)
+	}
+}
+
+// ojg/5: a string starting with '-' survives a SEN round trip.
+func TestHegelPinSENDash(t *testing.T) {
+	for _, s := range []string{"-", "-a", "-1", "--"} {
+		out := sen.String(s)
+		v, err := sen.Parse([]byte(out))
+		if err != nil {
+			t.Errorf("sen.Parse(sen.String(%q) = %q): %v", s, out, err)
+		} else if v != s {
+			t.Errorf("sen.Parse(sen.String(%q) = %q) = %#v", s, out, v)
+		}
+	}
+}
+
+// ojg/6: the strings "null", "true" and "false" survive a SEN round trip.
+func TestHegelPinSENLiteral(t *testing.T) {
+	for _, s := range []string{"null", "true", "false"} {
+		out := sen.String(s)
+		v, err := sen.Parse([]byte(out))
+		if err != nil {
+			t.Errorf("sen.Parse(sen.String(%q) = %q): %v", s, out, err)
+		} else if v != s {
+			t.Errorf("sen.Parse(sen.String(%q) = %q) = %#v", s, out, v)
+		}
+	}
+}
+
+// ojg/7: String() of a descent followed by a bracket fragment parses back.
+func TestHegelPinDescentString(t *testing.T) {
+	for _, s := range []string{"$..[0]", "$..[1:2]", "$..['a b']", "$..[?(@.a)]", "$..[0,1]"} {
+		x := jp.MustParseString(s)
+		if _, err := jp.ParseString(x.String()); err != nil {
+			t.Errorf("ParseString(%s).String() = %q does not parse: %v", s, x.String(), err)
+		}
+	}
+}
+
+// ojg/8: BracketString() of an expression with a descent parses back.
+func TestHegelPinDescentBracket(t *testing.T) {
+	for _, s := range []string{"$..a", "$..*", "$[0]..b"} {
+		x := jp.MustParseString(s)
+		if _, err := jp.ParseString(x.BracketString()); err != nil {
+			t.Errorf("ParseString(%s).BracketString() = %q does not parse: %v", s, x.BracketString(), err)
+		}
+	}
+}
+
+// ojg/9: a number with a decimal point but no fraction digits is rejected, as by Validate.
+func TestHegelPinParseBareDot(t *testing.T) {
+	for _, s := range []string{"1.", "[1.]", "1.e5", `{"a":2.}`} {
+		if v, err := oj.ParseString(s); err == nil {
+			t.Errorf("ParseString(%q) = %v, want an error", s, v)
+		}
+	}
+}
+
+// ojg/10: Remove with a union resolves negative indices like Del and Set do.
+func TestHegelPinRemoveUnionNegative(t *testing.T) {
+	r, err := jp.MustParseString("$[0,-1]").Remove([]any{"a", "b", "c"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := canon(r); got != `["b"]` {
+		t.Errorf("Remove $[0,-1] on [a,b,c] = %s, want [b]", got)
+	}
+}
+
+// ojg/11: a negative-step slice on an empty array selects nothing and does not panic.
+func TestHegelPinSliceEmpty(t *testing.T) {
+	for _, s := range []string{"$[:0:-1]", "$[-1::-1]", "$[1:0:-1]", "$[:5:-1]"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("%s on []: panic %v", s, r)
+				}
+			}()
+			if got := jp.MustParseString(s).Get([]any{}); len(got) != 0 {
+				t.Errorf("%s on [] = %v", s, got)
+			}
+		}()
+	}
+}
+
+// ojg/12: negative-step slices with bounds outside the array select nothing (RFC 9535).
+func TestHegelPinSliceNegClamp(t *testing.T) {
+	a := []any{"a", "b", "c"}
+	for _, s := range []string{"$[:5:-1]", "$[-5::-1]", "$[3:1:-1]"} {
+		want := ""
+		if s == "$[3:1:-1]" {
+			want = `["c"]`
+		}
+		got := canonList(jp.MustParseString(s).Get(a))
+		if want == "" && got != "[]" || want != "" && got != "["+strings.Trim(want, "[]")+"]" {
+			t.Errorf("%s on [a,b,c] = %s", s, got)
+		}
+	}
+}
+
+// ojg/13: a UTF-16 surrogate pair escape decodes to the character it encodes (RFC 8259, 7).
+func TestHegelPinSurrogatePair(t *testing.T) {
+	bs := string(rune(92))
+	for _, esc := range []string{"ud83d" + bs + "ude00", "uD83D" + bs + "uDE00"} {
+		v, err := oj.ParseString("\"" + bs + esc + "\"")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if v != "\U0001F600" {
+			t.Errorf("ParseString(%q) = %q, want %q", bs+esc, v, "\U0001F600")
+		}
+	}
+}
+
+// ojg/14: String() of a union with a quote or backslash in a key escapes it and parses back
+// to the same selection.
+func TestHegelPinUnionQuote(t *testing.T) {
+	bs := string(rune(92))
+	data := map[string]any{"k'q": int64(1), "back" + bs + "slash": int64(2), "backslash": int64(3), "kq": int64(4)}
+	for _, src := range []string{"$[0,'k" + bs + "'q']", "$[0,'back" + bs + bs + "slash']"} {
+		x := jp.MustParseString(src)
+		for _, s := range []string{x.String(), x.BracketString()} {
+			y, err := jp.ParseString(s)
+			if err != nil {
+				t.Errorf("%s: %q does not parse: %v", src, s, err)
+			} else if !sameMulti(y.Get(data), x.Get(data)) {
+				t.Errorf("%s: %q selects %s, want %s", src, s, canonList(y.Get(data)), canonList(x.Get(data)))
+			}
+		}
+	}
+}
+
+// ojg/15: Locate returns at most max paths for a slice too.
+func TestHegelPinLocateMaxSlice(t *testing.T) {
+	a := []any{"a", "b", "c"}
+	for _, s := range []string{"$[::-1]", "$[1:3]", "$[:]"} {
+		if l := jp.MustParseString(s).Locate(a, 1); len(l) != 1 {
+			t.Errorf("%s: Locate(max 1) = %v", s, l)
+		}
+	}
+}
+
+// ojg/16: Match with a descent visits every descendant, like Get, including the contents of
+// an element that matched.
+func TestHegelPinMatchDescentWildcard(t *testing.T) {
+	for _, tc := range []struct {
+		data string
+		path string
+		want int
+	}{{`["a",["d","e"],{"a":"f"}]`, "$..*", 6}, {`[0,[0,1]]`, "$..[1]", 2}, {`{"a":{"b":1}}`, "$..*", 2}} {
+		var found []any
+		if err := oj.MatchString(tc.data, func(_ jp.Expr, v any) { found = append(found, v) }, jp.MustParseString(tc.path)); err != nil {
+			t.Fatal(err)
+		}
+		if len(found) != tc.want {
+			t.Errorf("Match %s on %s found %d values %s, want %d", tc.path, tc.data, len(found), canonList(found), tc.want)
+		}
+	}
+}
+
+// ojg/17: Match with a filter calls back once per matching element, with its own path.
+func TestHegelPinMatchFilterAll(t *testing.T) {
+	data := []any{"a", "b", "c"}
+	var found []any
+	var paths []string
+	if err := oj.MatchString(oj.JSON(data), func(p jp.Expr, v any) { found = append(found, v); paths = append(paths, p.String()) }, jp.MustParseString("$[?(@ != 1)]")); err != nil {
+		t.Fatal(err)
+	}
+	if canonList(found) != `["a" "b" "c"]` || strings.Join(paths, " ") != "$[0] $[1] $[2]" {
+		t.Errorf("Match found %s at %v", canonList(found), paths)
+	}
+}
+
+// ojg/18: a truncated literal followed by a comma is a parse error, not a dropped value.
+func TestHegelPinTruncatedLiteral(t *testing.T) {
+	for _, s := range []string{"[nul,1]", "[n,1]", "[tru,2]", "[fals,3]", "nul,1"} {
+		if v, err := oj.ParseString(s); err == nil {
+			t.Errorf("ParseString(%q) = %s, want an error", s, canon(v))
+		}
+		if err := oj.ValidateString(s); err == nil {
+			t.Errorf("ValidateString(%q) accepted", s)
+		}
+	}
+}
