+// TestHegelPathEdit: Set, Del and Remove through a path ending in a child, index, wildcard or
+// union of an existing container leave the data as the model edits it (a missing key is added
+// by Set and ignored by Del and Remove; an index outside the array is ignored).
+func TestHegelPathEdit(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		orig := genContainer(ht, 3)
+		p := pick(ht, containerLocs(orig))
+		c := getAt(orig, p)
+		var keys []string
+		if m, ok := c.(map[string]any); ok {
+			for k := range m {
+				keys = append(keys, k)
+			}
+			sortStrings(keys)
+		}
+		last := genFrag(ht, keys, true)
+		arr, isArr := c.([]any)
+		if isArr && last.kind == "child" {
+			last = frag{kind: "nth", n: drawInt(ht, -3, 4)}
+		} else if !isArr && last.kind == "nth" {
+			last = frag{kind: "child", key: genPathKey(ht, keys)}
+		}
+		outOfRange := false
+		if isArr {
+			check := func(i int) {
+				if i < -len(arr) || i >= len(arr) {
+					outOfRange = true
+				}
+			}
+			if last.kind == "nth" { // a union ignores its out-of-range members
+				check(last.n)
+			}
+		}
+		fs := append(stepsFrags(p), last)
+		text := pathText(fs, false)
+		x, err := jp.ParseString(text)
+		if err != nil {
+			col.failClass(ht, "EditPathParse", "ParseString(%q) error %v", text, err)
+			return
+		}
+		kind := pick(ht, []editKind{editSet, editDel, editRemove})
+		names := map[editKind]string{editSet: "Set", editDel: "Del", editRemove: "Remove"}
+		val := genValue(ht, 1)
+		data := deepCopy(orig)
+		model := deepCopy(orig)
+		mlast := last
+		if kind == editRemove && last.kind == "union" && Known.removeUnionSkipsNegative {
+			mlast = frag{kind: "union"}
+			for _, it := range last.union {
+				if i, ok := it.(int); ok && i < 0 {
+					col.count("known remove union negative")
+					continue
+				}
+				mlast.union = append(mlast.union, it)
+			}
+		}
+		model = setAt(model, p, applyEdit(getAt(model, p), mlast, kind, val))
+		switch kind {
+		case editSet:
+			err = x.Set(data, val)
+		case editDel:
+			err = x.Del(data)
+		case editRemove:
+			data, err = x.Remove(data)
+		}
+		if outOfRange && ((kind == editSet && Known.setBeyondEndFails) || (kind == editDel && Known.delOutOfRangeFails)) {
+			if err == nil {
+				col.failClass(ht, names[kind]+"OutOfRangeOK", "%s %s on %s succeeded (the known bug expects an error)", names[kind], text, canon(orig))
+			}
+			col.count("known out of range " + names[kind])
+			return
+		}
+		if err != nil {
+			col.failClass(ht, names[kind]+"Err", "%s %s (value %s) on %s: %v", names[kind], text, canon(val), canon(orig), err)
+			return
+		}
+		if !sameValue(data, model) {
+			col.failClass(ht, names[kind], "%s %s (value %s) on %s = %s, want %s", names[kind], text, canon(val), canon(orig), canon(data), canon(model))
+		}
+	})
+}
