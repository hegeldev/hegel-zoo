+var emptySliceCases = hegel.Composite(func(tc hegel.TestCase) emptySliceCase {
+	return emptySliceCase{h: hegel.Draw(tc, hosts), start: hegel.Draw(tc, sliceBounds), end: hegel.Draw(tc, sliceBounds), mag: hegel.Draw(tc, hegel.Integers(1, 3))}
+})
+
+func (c emptySliceCase) path() pathCase {
+	data, p := c.h.place([]any{})
+	return pathCase{data: data, fs: append(stepsFrags(p), sliceFragOf(c.start, c.end, shaped(-c.mag, c.mag))), max: 1}
+}
+
+func (c emptySliceCase) GoString() string { return c.path().GoString() }
+
+// TestHegelNegativeStepSliceOnEmptyArray: a slice with a negative step selects nothing from an
+// empty array; Get panics with an index out of range (ojg/11).
+func TestHegelNegativeStepSliceOnEmptyArray(t *testing.T) {
