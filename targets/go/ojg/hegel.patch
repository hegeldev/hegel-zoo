+// filterMatchCase: an array of two to five objects, each holding the key "a" with a value the
+// filter on "a" accepts (under HEGEL_NO_KNOWN=1 only the first does: the others lack the key
+// under an existence filter and hold the compared value under "!="), in a host.
+type filterMatchCase struct {
+	vals []any
+	op   string
+	h    host
+}
+
+// filterMatchVal is the value the "!=" filter compares with: an integer no scalar equals (a
+// string beside a float member would be ojg/21's shape).
+const filterMatchVal = int64(99999)
+
+var filterMatchCases = hegel.Composite(func(tc hegel.TestCase) filterMatchCase {
+	return filterMatchCase{
+		vals: hegel.Draw(tc, counted(scalars, 2, 5)),
+		op:   hegel.Draw(tc, pick("", "!=")),
+		h:    hegel.Draw(tc, hosts),
+	}
+})
