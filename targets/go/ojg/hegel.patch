+// int64) under a key, in a host, and a filter comparing that key with "!=" to a string, a
+// boolean, null or a float.
+type floatNeqCase struct {
+	vals []any
+	key  string
+	fval any
+	h    host
+}
+
+var (
+	neqMembers    = shaped(asAny(floatValues), asAny(intValues))
+	neqOperands   = hegel.OneOf(asAny(pick("zzz", "a", "", "x y", "1")), asAny(chance(50)), hegel.Just[any](nil), asAny(floatValues))
+	floatNeqCases = hegel.Composite(func(tc hegel.TestCase) floatNeqCase {
+		return floatNeqCase{
+			vals: hegel.Draw(tc, counted(neqMembers, 1, 4)),
+			key:  hegel.Draw(tc, objKeys),
+			fval: hegel.Draw(tc, neqOperands),
+			h:    hegel.Draw(tc, hosts),
+		}
+	})
+)
+
+func (c floatNeqCase) path() pathCase {
+	elems := make([]any, len(c.vals))
+	for i, v := range c.vals {
+		elems[i] = map[string]any{c.key: v}
+	}
+	data, p := c.h.place(elems)
+	return pathCase{data: data, fs: append(stepsFrags(p), frag{kind: "filter", fkey: c.key, fop: "!=", fval: c.fval}), max: 1}
+}
+
+func (c floatNeqCase) GoString() string { return c.path().GoString() }
+
+// TestHegelFilterNotEqualSelectsFloatMembers: a filter comparing a float member with "!=" to a
+// string, a boolean, null or a different float selects the element, as it does for an integer
+// member; it selects nothing (ojg/21).
+func TestHegelFilterNotEqualSelectsFloatMembers(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, floatNeqCases).path()
+		if x, ok := parsePath(ht, col, c); ok {
+			checkGet(ht, col, c, x, narrow("ojg/21"))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- ojg/22
+
+// bomStringCase: a string starting with a byte order mark followed by random atoms, as the root
+// value (the shape) or, under HEGEL_NO_KNOWN=1, inside an array or object, where the mark is
+// not at the start of the document.
+type bomStringCase struct {
+	tail   []string
+	h      host
+	indent int
+}
+
+var bomStringCases = hegel.Composite(func(tc hegel.TestCase) bomStringCase {
+	return bomStringCase{tail: hegel.Draw(tc, counted(strAtoms, 1, 3)), h: hegel.Draw(tc, hosts), indent: hegel.Draw(tc, hegel.Integers(0, 3))}
+})
+
+func (c bomStringCase) sen() senCase {
+	h := c.h
+	h.wrap = shaped(0, 1+h.wrap%2)
+	data, _ := h.place(byteOrderMark + strings.Join(c.tail, ""))
+	return senCase{v: shaped(data, unbare(data)), indent: c.indent}
+}
+
+func (c bomStringCase) GoString() string { return c.sen().GoString() }
+
+// TestHegelSENQuotesBOMStrings: a string starting with a byte order mark survives a SEN round
+// trip (the parser skips the mark at the start of a document, so the writer must quote it); it
+// is written bare and reads back without the mark, or as the number or literal after it
+// (ojg/22).
+func TestHegelSENQuotesBOMStrings(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bomStringCases)
+		checkSEN(ht, col, c.sen(), narrow("ojg/22"))
+	})
+}
+
+// --------------------------------------------------------------------------- ojg/23
+
+// zeroExpCase: a number whose integer part is a bare 0 (under HEGEL_NO_KNOWN=1 one with a
+// fraction or a non-zero integer part), optionally negative, followed at once by an exponent
+// spelled with e or E, an optional sign and one to three digits, in a host.
+type zeroExpCase struct {
+	neg      bool
+	mantissa string
+	letter   string
+	sign     string
+	digits   string
+	h        host
+}
+
+var (
+	zeroMantissas = shaped(hegel.Just("0"), pick("0.0", "1", "10", "0.5"))
+	zeroExpCases  = hegel.Composite(func(tc hegel.TestCase) zeroExpCase {
+		return zeroExpCase{
+			neg:      hegel.Draw(tc, chance(50)),
+			mantissa: hegel.Draw(tc, zeroMantissas),
+			letter:   hegel.Draw(tc, pick("e", "E")),
+			sign:     hegel.Draw(tc, pick("", "+", "-")),
+			digits:   hegel.Draw(tc, hegel.Text().Alphabet("0123456789").MinSize(1).MaxSize(3)),
+			h:        hegel.Draw(tc, hosts),
+		}
+	})
+)
+
+func (c zeroExpCase) text() string {
+	n := c.mantissa + c.letter + c.sign + c.digits
+	if c.neg {
+		n = "-" + n
+	}
+	return c.h.wrapText(n)
+}
+
+func (c zeroExpCase) GoString() string { return fmt.Sprintf("%q", c.text()) }
+
+// TestHegelZeroMantissaExponentsParse: a number with a zero integer part followed by an
+// exponent (0e5, -0E+1) is accepted by Parse, Validate and sen.Parse as by encoding/json (RFC
+// 8259: an int may be 0 and the exponent may follow it at once); all three reject it as an
+// invalid number (ojg/23).
+func TestHegelZeroMantissaExponentsParse(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, zeroExpCases).text()
+		judgeText(ht, col, text, narrow("ojg/23"))
+		if _, err := sen.Parse([]byte(text)); err != nil {
+			col.mismatch(ht, shapes(narrow("ojg/23")), "SENParseStrict", "sen.Parse(%q) error %v, valid JSON", text, err)
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..f3d47db
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,295 @@
+package hegel
+
+// Hegel property tests for ohler55/ojg, written for the Hegel zoo. See
+// targets/go/ojg/README.md.
+//
+// Oracle: encoding/json for text validity and decoded values (with ojg's int64/float64 number
+// convention applied), a brute-force JSONPath evaluator over the simple Go types, and round
+// trips through the library's own writers (JSON and SEN) and converters.
+//
+// Generators (hegel_model_test.go) are package-level values built from the binding's
+// combinators; each property draws one case record and renders it with pure functions. The
+// shapes of the recorded bugs (bugs.toml) are drawn by default at modest rates, so the wide
+// property that meets one fails naming the bug and is the expected failure mapped to it, with
+// the pin (hegel_pins_test.go) as the regression example; hegel_shapes_test.go has one narrow
+// property per bug over its shape region. HEGEL_NO_KNOWN=1 (noKnown, below, read once)
+// switches the known shapes off: the generators draw past them and a disagreement on one that
+// is still drawn is counted and assumed away.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the model or the oracle on a case whose recorded shapes
+// are named (none for a plain failure): each shape is counted; by default the case fails naming
+// the bugs; under HEGEL_NO_KNOWN=1 it is assumed away instead.
+func (c *collector) mismatch(ht *hegel.T, shapes []string, class string, format string, args ...any) {
+	if len(shapes) > 0 {
+		for _, s := range shapes {
+			c.count("shape " + s)
+		}
+		if noKnown {
+			c.count("assumed " + strings.Join(shapes, "+"))
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// excused reports whether one check of a case is left out under HEGEL_NO_KNOWN=1 because the
+// case has the shape of the recorded bug the check would meet (counted); the rest of the case
+// still runs. By default every check runs and its failure names the bug through mismatch.
+func (c *collector) excused(id string, has bool) bool {
+	if has && noKnown {
+		c.count("excused " + id)
+		return true
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// every switch below is off, the generators draw the shapes of the bugs and the model says what
+// the documentation says, so the properties fail on the bugs naming them; under HEGEL_NO_KNOWN=1
+// the switches are on, the generators draw past the shapes, the model reproduces what it can
+// (the slice clamp of ojg/12, the union of ojg/10) and what is still met is excused or assumed.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml), one switch each, all equal to noKnown.
+var Known = struct {
+	intLimitAsNumber         bool // 1: 9223372036854775800..807 and -9223372036854775808 parse as json.Number
+	validateAcceptsTruncated bool // 2: Validate accepts unclosed arrays and objects
+	setBeyondEndFails        bool // 3: Set on an index at/after the end of an existing array errors
+	delOutOfRangeFails       bool // 4: Del/DelOne error on an out-of-range index (Remove/Modify ignore it)
+	senWritesDashBare        bool // 5: SEN writer leaves strings starting with '-' unquoted
+	senWritesLiteralBare     bool // 6: SEN writer leaves the strings null/true/false unquoted
+	descentStringUnparsable  bool // 7: String() of a descent followed by a bracket fragment does not parse
+	descentBracketUnparsable bool // 8: BracketString() of a descent ("[..]") does not parse
+	parseAcceptsBareDot      bool // 9: Parse accepts a number with a decimal point and no fraction digits (1.)
+	removeUnionSkipsNegative bool // 10: Remove with a union of indices ignores the negative ones
+	sliceEmptyPanics         bool // 11: Get with a negative-step slice panics on an empty array
+	sliceNegClamp            bool // 12: negative-step slices clamp out-of-range bounds onto the array
+	noSurrogatePairs         bool // 13: Parse does not combine UTF-16 surrogate pair escapes
+	unionQuoteUnescaped      bool // 14: String()/BracketString() leave a quote or backslash in a union key unescaped
+	locateMaxIgnoredForSlice bool // 15: Locate ignores max for slice fragments
+	matchDescentShallow      bool // 16: Match with a descent misses matches inside nested arrays
+	matchFilterOnce          bool // 17: Match with a filter matching several elements calls back once
+	truncatedLiteralComma    bool // 18: a truncated null/true/false followed by a comma is accepted and dropped
+	memberWithoutValue       bool // 19: an object member with no value before the closing brace is accepted and dropped
+	truncatedMemberPanics    bool // 20: a truncated literal member followed by a comma and another member panics in Parse
+	filterFloatNeqOtherType  bool // 21: a filter != on a float64 member is false against a string, boolean, null or another float
+	senWritesBOMBare         bool // 22: SEN writer leaves a root string starting with a byte order mark bare, which the parser skips
+	zeroExponentRejected     bool // 23: a bare 0 followed at once by an exponent (0e5) is rejected as an invalid number
+}{noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown}
+
+// known is the bug's id when the case has its shape, else nothing.
+func known(id string, has bool) string {
+	if has {
+		return id
+	}
+	return ""
+}
+
+// narrow is the id of the bug a narrow property (hegel_shapes_test.go) is about while the known
+// shapes are on, and nothing under HEGEL_NO_KNOWN=1, when the property draws the neighbouring
+// region and a disagreement there is a plain failure.
+func narrow(id string) string { return known(id, !noKnown) }
+
+// shapes is the list of the recorded shapes a case has (the ids that are set, each once).
+func shapes(ids ...string) []string {
+	var out []string
+	for _, id := range ids {
+		if id != "" && !slices.Contains(out, id) {
+			out = append(out, id)
+		}
+	}
+	return out
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- generator idioms
+// (hegel-go has no weighted choice, biased coin, optional with a probability or tuple
+// combinator; these are the zoo's spellings)
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// pick is one of a small table (the first is the shrink target).
+func pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// counted is a list of lo to hi elements whose count is drawn first (Lists with a MaxSize
+// alone almost never draws the empty list).
+func counted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hegel.Integers(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// tapeOf is a tape of up to hi values of g, read by a renderer in order and modulo its length;
+// the empty tape comes first, so the plainest rendering is the shrink target.
+func tapeOf[T any](g hegel.Generator[T], hi int) hegel.Generator[[]T] {
+	return weighted(choice[[]T]{1, hegel.Just[[]T](nil)}, choice[[]T]{1, many(g, 1, hi)})
+}
+
+// joined is the texts of a list generator concatenated.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
+
+// at is the element of xs at position i taken modulo the length (the modulo-live-size idiom);
+// an empty tape reads as the zero value.
+func at[T any](xs []T, i int) T {
+	var zero T
+	if len(xs) == 0 {
+		return zero
+	}
+	return xs[i%len(xs)]
+}
