+
+// removeUnionCase: an array of two to four values in a host and a union of two or three
+// distinct indices of it, at least one negative (under HEGEL_NO_KNOWN=1 none), for Remove.
+type removeUnionCase struct {
+	elems   []any
+	h       host
+	a, b, c int
+	third   bool
+}
+
+var removeUnionCases = hegel.Composite(func(tc hegel.TestCase) removeUnionCase {
+	return removeUnionCase{
+		elems: hegel.Draw(tc, counted(scalars, 2, 4)),
+		h:     hegel.Draw(tc, hosts),
+		a:     hegel.Draw(tc, hegel.Integers(0, 9)),
+		b:     hegel.Draw(tc, hegel.Integers(0, 9)),
+		c:     hegel.Draw(tc, hegel.Integers(0, 9)),
+		third: hegel.Draw(tc, chance(30)),
+	}
+})
+
+// union is the members: -(1+a) and b inside the array (and -(1+c) when distinct) by default; a,
+// b (made distinct) and c under HEGEL_NO_KNOWN=1.
+func (c removeUnionCase) union() []any {
+	n := len(c.elems)
+	a, b, d := c.a%n, c.b%n, c.c%n
+	if noKnown {
+		if a == b {
+			b = (b + 1) % n
+		}
+		out := []any{a, b}
+		if c.third && d != a && d != b {
+			out = append(out, d)
+		}
+		return out
+	}
+	out := []any{-(1 + a), b}
+	if c.third && d != a {
+		out = append(out, -(1 + d))
+	}
+	return out
+}
+
+func (c removeUnionCase) edit() editCase {
+	data, p := c.h.place(c.elems)
+	return editCase{data: data, loc: locIndex(data, p), last: frag{kind: "union", union: c.union()}, kind: editRemove}
+}
+
+func (c removeUnionCase) GoString() string { return c.edit().GoString() }
