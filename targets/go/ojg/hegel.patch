+// --------------------------------------------------------------------------- SEN and alt
+
+// TestHegelSEN: SEN written by sen (plain, sorted/indented, Write, Bytes) parses back to the
+// value; SEN parses the JSON of the same value.
+func TestHegelSEN(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 3)
+		if (Known.senWritesDashBare || Known.senWritesLiteralBare) && senBare(v) {
+			col.count("known bare string")
+			return
+		}
+		if Known.intLimitAsNumber && hasLimitInt(v) {
+			col.count("known int limit")
+			return
+		}
+		want := canonLoose(v)
+		s := sen.String(v)
+		if back, err := sen.Parse([]byte(s)); err != nil {
+			col.failClass(ht, "SENParseErr", "sen.Parse(sen.String(%s) = %q) error %v", canon(v), s, err)
+		} else if canonLoose(back) != want {
+			col.failClass(ht, "SENRoundTrip", "sen.Parse(sen.String(%s) = %q) = %s", canon(v), s, canonLoose(back))
+		}
+		if back, err := sen.Parse(sen.Bytes(v)); err != nil {
+			col.failClass(ht, "SENBytesErr", "sen.Parse(sen.Bytes(%s) = %q) error %v", canon(v), sen.Bytes(v), err)
+		} else if canonLoose(back) != want {
+			col.failClass(ht, "SENBytes", "sen.Parse(sen.Bytes(%s) = %q) = %s", canon(v), sen.Bytes(v), canonLoose(back))
+		}
+		opts := ojg.DefaultOptions
+		opts.Sort = true
+		opts.Indent = drawInt(ht, 0, 3)
+		s2 := sen.String(v, &opts)
+		if back, err := sen.Parse([]byte(s2)); err != nil {
+			col.failClass(ht, "SENOptsErr", "sen.Parse(sen.String(%s, sort/indent) = %q) error %v", canon(v), s2, err)
+		} else if canonLoose(back) != want {
+			col.failClass(ht, "SENOpts", "sen.Parse(sen.String(%s, sort/indent) = %q) = %s", canon(v), s2, canonLoose(back))
+		}
+		var buf bytes.Buffer
+		if err := sen.Write(&buf, v); err != nil {
+			col.failClass(ht, "SENWriteErr", "sen.Write(%s) error %v", canon(v), err)
+		} else if back, err := sen.Parse(buf.Bytes()); err != nil {
+			col.failClass(ht, "SENWriteParse", "sen.Parse(sen.Write(%s) = %q) error %v", canon(v), buf.String(), err)
+		} else if canonLoose(back) != want {
+			col.failClass(ht, "SENWrite", "sen.Parse(sen.Write(%s) = %q) = %s", canon(v), buf.String(), canonLoose(back))
+		}
+		j := oj.JSON(v)
+		if back, err := sen.Parse([]byte(j)); err != nil {
+			col.failClass(ht, "SENofJSONErr", "sen.Parse(%q) error %v", j, err)
+		} else if canonLoose(back) != want {
+			col.failClass(ht, "SENofJSON", "sen.Parse(%q) = %s, want %s", j, canonLoose(back), want)
+		}
+	})
+}
+
+// TestHegelAlt: Dup/Decompose and Generify+Simplify reproduce the value (without nil members
+// under alt's default OmitNil, exactly with OmitNil off); Dup is independent of the original;
+// Diff and Compare report a difference exactly when the values differ (nil members count as
+// absent, as in Match); Match accepts the value itself and any subset of its keys; Checksum
+// agrees on equal values.
+func TestHegelAlt(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		v := genValue(ht, 3)
+		var w any
+		if chance(ht, 50) {
+			w = deepCopy(v)
+			if chance(ht, 50) {
+				locs := allLocs(w, nil)
+				if len(locs) > 0 {
+					w = setAt(w, pick(ht, locs), genValue(ht, 1))
+				}
+			}
+		} else {
+			w = genValue(ht, 3)
+		}
+		keep := ojg.Options{}
+		if n := alt.Generify(v); n == nil && v != nil {
+			col.failClass(ht, "GenerifyNil", "Generify(%s) = nil", canon(v))
+		} else if n != nil && !sameValue(n.Simplify(), stripNil(v)) {
+			col.failClass(ht, "Generify", "Generify(%s).Simplify() = %s, want %s", canon(v), canon(n.Simplify()), canon(stripNil(v)))
+		}
+		if n := alt.Generify(v, &keep); n != nil && !sameValue(n.Simplify(), v) {
+			col.failClass(ht, "GenerifyKeepNil", "Generify(%s, OmitNil off).Simplify() = %s", canon(v), canon(n.Simplify()))
+		}
+		before := canon(v)
+		if d := alt.Dup(v); !sameValue(d, stripNil(v)) {
+			col.failClass(ht, "Dup", "Dup(%s) = %s, want %s", before, canon(d), canon(stripNil(v)))
+		}
+		d := alt.Dup(v, &keep)
+		if !sameValue(d, v) {
+			col.failClass(ht, "DupKeepNil", "Dup(%s, OmitNil off) = %s", before, canon(d))
+		}
+		if a := alt.Alter(deepCopy(v), &keep); !sameValue(a, v) {
+			col.failClass(ht, "Alter", "Alter(%s, OmitNil off) = %s", before, canon(a))
+		}
+		locs := allLocs(d, nil)
+		if len(locs) > 0 {
+			setAt(d, pick(ht, locs), "changed")
+			if canon(v) != before {
+				col.failClass(ht, "DupAliased", "changing Dup(%s) changed the original to %s", before, canon(v))
+			}
+		}
+		equal := sameValue(stripNil(v), stripNil(w))
+		diffs := alt.Diff(v, w)
+		if (len(diffs) == 0) != equal {
+			col.failClass(ht, "Diff", "Diff(%s, %s) = %v, equal %v", canon(v), canon(w), diffs, equal)
+		}
+		if cmp := alt.Compare(v, w); (cmp == nil) != equal {
+			col.failClass(ht, "Compare", "Compare(%s, %s) = %v, equal %v", canon(v), canon(w), cmp, equal)
+		}
+		if sameValue(v, w) && alt.Checksum(v) != alt.Checksum(w) {
+			col.failClass(ht, "Checksum", "Checksum(%s) differs between equal values", canon(v))
+		}
+		if !alt.Match(v, v) {
+			col.failClass(ht, "MatchSelf", "Match(%s, itself) false", canon(v))
+		}
+		if m, ok := v.(map[string]any); ok && len(m) > 0 {
+			fp := map[string]any{}
+			for k, e := range m {
+				if chance(ht, 60) {
+					fp[k] = deepCopy(e)
+				}
+			}
+			if !alt.Match(fp, v) {
+				col.failClass(ht, "MatchSubset", "Match(%s, %s) false", canon(fp), canon(v))
+			}
+		}
+		if equal && !alt.Match(v, w) {
+			col.failClass(ht, "MatchEqual", "Match(%s, %s) false for equal values", canon(v), canon(w))
+		}
+	})
+}
