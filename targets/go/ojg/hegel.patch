+package hegel
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the checks of the wide property that found it (hegel_props_test.go),
+// so that each bug is found every run (the wide properties reach the shapes at their natural
+// rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch
+// instead (integers a little further from the limits, an extra closing bracket, an index inside
+// the array, a dash after a letter, a near miss of a literal word, a descent before a dot-form
+// fragment, no descent, a fraction digit, non-negative union indices, a positive step, slice
+// bounds inside the array, a raw astral character, a union key without a quote, a wildcard, a
+// filter matching one element, a truncated literal before the closing bracket, a member without
+// a value before a comma, a truncated literal member before the closing brace, integer members
+// under the filter, a byte-order-mark string inside a container, a fraction or a non-zero digit
+// before the exponent) and passes.
+
+import (
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+
+	"github.com/ohler55/ojg/sen"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- shared pieces
+
+var (
+	scalars = valueAt(0)
+	items   = counted(scalars, 1, 4)
+)
+
+// host places a value: alone, under a key of an object, or at the end of an array after a few
+// values, so that the path to it differs.
+type host struct {
+	wrap   int
+	key    string
+	before []any
+}
+
+var hosts = hegel.Composite(func(tc hegel.TestCase) host {
+	return host{wrap: hegel.Draw(tc, hegel.Integers(0, 2)), key: hegel.Draw(tc, objKeys), before: hegel.Draw(tc, counted(scalars, 0, 2))}
+})
+
+// place puts v in the host and returns the data and the path to v.
+func (h host) place(v any) (any, []step) {
+	switch h.wrap {
+	case 1:
+		return map[string]any{h.key: v}, []step{{key: h.key, isKey: true}}
+	case 2:
+		a := append(append([]any{}, h.before...), v)
+		return a, []step{{idx: len(a) - 1}}
+	}
+	return v, nil
+}
+
+// wrapText puts the JSON text of a value in the host as place would: alone, as the value of
+// the key, or at the end of an array after the values before it.
+func (h host) wrapText(inner string) string {
+	switch h.wrap {
+	case 1:
+		return "{" + render(h.key, tape{}).text + ":" + inner + "}"
+	case 2:
+		parts := make([]string, 0, len(h.before)+1)
+		for _, v := range h.before {
+			parts = append(parts, render(v, tape{}).text)
+		}
+		return "[" + strings.Join(append(parts, inner), ",") + "]"
+	}
+	return inner
+}
+
+// locIndex is the index of the path p among the container locations of data.
+func locIndex(data any, p []step) int {
+	want := stepsText(p)
+	for i, l := range containerLocs(data) {
+		if stepsText(l) == want {
+			return i
+		}
+	}
+	panic("locIndex: no container at " + want)
+}
+
+// markedKeys is an object key holding one of the marks between key atoms without a single
+// quote or a backslash: oddKeys one that is not a plain identifier, quoteKeys one with a single
+// quote or a backslash (the shape of ojg/14), plainOdd one with a space, dot, dash or dollar.
+func markedKeys(marks hegel.Generator[string]) hegel.Generator[string] {
+	around := joined(many(pick("a", "b", "c", "x", "id", "", " ", "\"", "\u00e9", "\u65e5", ".", "0", "-1", "$", "*"), 0, 1))
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, around) + hegel.Draw(tc, marks) + hegel.Draw(tc, around)
+	})
+}
+
+var (
+	oddKeys   = markedKeys(pick(" ", ".", "'", "-", "$", "*", "\\", "\""))
+	quoteKeys = markedKeys(pick("'", "\\"))
+	plainOdd  = markedKeys(pick(" ", ".", "-", "$"))
+)
+
+// plainFragsFor is a path fragment over data with the given keys that is not a descent.
+func plainFragsFor(keys []string) hegel.Generator[frag] {
+	return weighted(
+		choice[frag]{2, childFragsFor(keys)},
+		choice[frag]{2, nthFrags},
+		choice[frag]{1, wildFrag},
+		choice[frag]{1, unionFragsFor(keys)},
+		choice[frag]{1, sliceFrags},
+		choice[frag]{1, filterFragsFor(keys)},
+	)
+}
+
+// prefixFragsFor is zero to two plain child or index fragments.
+func prefixFragsFor(keys []string) hegel.Generator[[]frag] {
+	return counted(hegel.OneOf(childFragsFor(keys), nthFrags), 0, 2)
+}
+
+// --------------------------------------------------------------------------- ojg/1
+
+// limitIntCase: an integer in the band 9223372036854775800..MaxInt64, or MinInt64 (the shape),
+// or under HEGEL_NO_KNOWN=1 one a little below the band or a little above MinInt64, hosted and
+// spelled by a tape.
+type limitIntCase struct {
+	neg  bool
+	k    int
+	h    host
+	tape tape
+}
+
+var limitIntCases = hegel.Composite(func(tc hegel.TestCase) limitIntCase {
+	return limitIntCase{neg: hegel.Draw(tc, chance(50)), k: hegel.Draw(tc, hegel.Integers(0, 7)), h: hegel.Draw(tc, hosts), tape: hegel.Draw(tc, tapes)}
+})
+
+func (c limitIntCase) n() int64 {
+	if c.neg {
+		return shaped(int64(math.MinInt64), math.MinInt64+1+int64(c.k))
+	}
+	return shaped(math.MaxInt64-int64(c.k), math.MaxInt64-8-int64(c.k))
+}
+
+func (c limitIntCase) data() any { v, _ := c.h.place(c.n()); return v }
+
+func (c limitIntCase) GoString() string {
+	return fmt.Sprintf("%d in %s as %q", c.n(), canon(c.data()), render(c.data(), c.tape).text)
+}
+
+// TestHegelIntegersNearInt64LimitsParse: an integer within a few of the int64 limits parses as
+// int64 through every parsing entry point; 9223372036854775800..9223372036854775807 and
+// -9223372036854775808 come back as json.Number (ojg/1).
+func TestHegelIntegersNearInt64LimitsParse(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, limitIntCases)
+		checkParse(ht, col, c.data(), render(c.data(), c.tape), narrow("ojg/1"))
+	})
+}
+
+// --------------------------------------------------------------------------- ojg/2
+
+// unclosedCase: a container tree spelled by a tape with its at-th closing bracket dropped (the
+// shape) or, under HEGEL_NO_KNOWN=1, an extra closing bracket inserted at the at-th byte.
+type unclosedCase struct {
+	v      any
+	tape   tape
+	at     int
+	closer byte
+}
+
+var unclosedCases = hegel.Composite(func(tc hegel.TestCase) unclosedCase {
+	return unclosedCase{v: hegel.Draw(tc, containersAt(2)), tape: hegel.Draw(tc, tapes), at: hegel.Draw(tc, positions), closer: hegel.Draw(tc, pick[byte](']', '}'))}
+})
+
+func (c unclosedCase) text() string {
+	m := shaped(mutation{kind: "unclose", at: c.at}, mutation{kind: "insert", at: c.at, c: c.closer})
+	return mutate(render(c.v, c.tape).text, []mutation{m})
+}
+
+func (c unclosedCase) GoString() string { return fmt.Sprintf("%q", c.text()) }
+
+// TestHegelValidateRejectsUnclosedContainers: a text with an unclosed array or object is
+// rejected by Validate as by Parse and encoding/json; Validate accepts it (ojg/2).
+func TestHegelValidateRejectsUnclosedContainers(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, unclosedCases)
+		judgeText(ht, col, c.text(), narrow("ojg/2"))
+	})
+}
+
+// --------------------------------------------------------------------------- ojg/3, ojg/4
+
+// indexEditCase: an array of one to four values in a host, an index outside it (at or after
+// the end; for Del also before the start) or, under HEGEL_NO_KNOWN=1, inside it, and the value
+// Set puts in.
+type indexEditCase struct {
+	elems  []any
+	h      host
+	k      int
+	before bool
+	val    any
+}
+
+var indexEditCases = hegel.Composite(func(tc hegel.TestCase) indexEditCase {
+	return indexEditCase{elems: hegel.Draw(tc, items), h: hegel.Draw(tc, hosts), k: hegel.Draw(tc, hegel.Integers(0, 3)), before: hegel.Draw(tc, chance(50)), val: hegel.Draw(tc, scalars)}
+})
+
+// index is the drawn index: past the end, or before the start when the edit allows it.
+func (c indexEditCase) index(del bool) int {
+	n := len(c.elems)
+	outside := n + c.k
+	if del && c.before {
+		outside = -(n + 1 + c.k)
+	}
+	return shaped(outside, c.k%n)
+}
+
+func (c indexEditCase) edit(kind editKind) editCase {
+	data, p := c.h.place(c.elems)
+	return editCase{data: data, loc: locIndex(data, p), last: frag{kind: "nth", n: c.index(kind == editDel)}, kind: kind, val: c.val}
+}
+
+func (c indexEditCase) GoString() string {
+	data, p := c.h.place(c.elems)
+	return fmt.Sprintf("%s on %s: index %d for Set, %d for Del, value %s", stepsText(p), canon(data), c.index(false), c.index(true), canon(c.val))
+}
+
+// TestHegelSetAtOrAfterArrayEndAppends: Set through an index at or after the end of an existing
+// array adds the element (padding with nulls), as documented; it fails with "out of bounds"
+// (ojg/3).
+func TestHegelSetAtOrAfterArrayEndAppends(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, indexEditCases)
+		checkEdit(ht, col, c.edit(editSet), narrow("ojg/3"))
+	})
+}
+
+// TestHegelDelOutOfRangeIsNoOp: Del through an index outside an existing array changes nothing
+// and returns no error, like Remove and like a missing key; it fails with "out of bounds"
+// (ojg/4).
+func TestHegelDelOutOfRangeIsNoOp(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, indexEditCases)
+		checkEdit(ht, col, c.edit(editDel), narrow("ojg/4"))
+	})
+}
+
+// --------------------------------------------------------------------------- ojg/5, ojg/6
+
+// bareStringCase: a string the SEN writer leaves bare - one starting with a dash followed by
+// random atoms (ojg/5), or one of the words null, true and false (ojg/6) - as a value or as a
+// key, in a host; under HEGEL_NO_KNOWN=1 the dash follows a letter and the word is a near miss.
+type bareStringCase struct {
+	word   string
+	near   string
+	tail   []string
+	asKey  bool
+	val    any
+	h      host
+	indent int
+}
+
+var bareStringCases = hegel.Composite(func(tc hegel.TestCase) bareStringCase {
+	return bareStringCase{
+		word:   hegel.Draw(tc, pick("null", "true", "false")),
+		near:   hegel.Draw(tc, pick("nul", "Null", "NULL", "nulls", "True", "TRUE", "trueish", "fals", "False", "falsey")),
+		tail:   hegel.Draw(tc, counted(strAtoms, 0, 3)),
+		asKey:  hegel.Draw(tc, chance(30)),
+		val:    hegel.Draw(tc, scalars),
+		h:      hegel.Draw(tc, hosts),
+		indent: hegel.Draw(tc, hegel.Integers(0, 3)),
+	}
+})
+
+func (c bareStringCase) dashed() string { return shaped("-", "x-") + strings.Join(c.tail, "") }
+
+func (c bareStringCase) literal() string { return shaped(c.word, c.near) }
+
+// sen is the SEN case holding s as a value or as a key; under HEGEL_NO_KNOWN=1 the other
+// strings of the host and the value are kept off the bare shapes too.
+func (c bareStringCase) sen(s string) senCase {
+	var v any = s
+	if c.asKey {
+		v = map[string]any{s: c.val}
+	}
+	data, _ := c.h.place(v)
+	return senCase{v: shaped(data, unbare(data)), indent: c.indent}
+}
+
+func (c bareStringCase) GoString() string {
+	return fmt.Sprintf("dashed %s, literal %s", canon(c.sen(c.dashed()).v), canon(c.sen(c.literal()).v))
+}
+
+// TestHegelSENQuotesDashStrings: a string starting with '-' survives a SEN round trip (the
+// grammar allows '-' only inside a token, so the writer must quote it); it is written bare and
+// reads back as a number or not at all (ojg/5).
+func TestHegelSENQuotesDashStrings(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bareStringCases)
+		checkSEN(ht, col, c.sen(c.dashed()), narrow("ojg/5"))
+	})
+}
+
+// TestHegelSENQuotesLiteralWords: the strings "null", "true" and "false" survive a SEN round
+// trip; they are written bare and read back as the literals (ojg/6).
+func TestHegelSENQuotesLiteralWords(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bareStringCases)
+		checkSEN(ht, col, c.sen(c.literal()), narrow("ojg/6"))
+	})
+}
+
+// --------------------------------------------------------------------------- ojg/7
+
+// descentBracketCase: data, a prefix of plain fragments, a descent and the fragment after it:
+// one String() writes in bracket form (an index, slice, union, filter or a key that is not an
+// identifier) or, under HEGEL_NO_KNOWN=1, one it writes in dot form (an identifier key or a
+// wildcard).
+type descentBracketCase struct {
+	data   any
+	prefix []frag
+	after  frag
+	plain  frag
+}
+
+var descentBracketCases = hegel.FlatMap(containersAt(3), func(d any) hegel.Generator[descentBracketCase] {
+	keys := keysOf(d)
+	after := weighted(
+		choice[frag]{2, nthFrags},
+		choice[frag]{1, sliceFrags},
+		choice[frag]{1, unionFragsFor(keys)},
+		choice[frag]{1, filterFragsFor(keys)},
+		choice[frag]{1, hegel.Map(oddKeys, func(k string) frag { return frag{kind: "child", key: k} })},
+	)
+	plain := hegel.OneOf(hegel.Map(pathKeysFor(keys), func(k string) frag {
+		if !simpleKey(k) {
+			k = "a"
+		}
+		return frag{kind: "child", key: k}
+	}), wildFrag)
+	return hegel.Composite(func(tc hegel.TestCase) descentBracketCase {
+		return descentBracketCase{data: d, prefix: hegel.Draw(tc, prefixFragsFor(keys)), after: hegel.Draw(tc, after), plain: hegel.Draw(tc, plain)}
+	})
+})
+
+func (c descentBracketCase) path() pathCase {
+	fs := append(append([]frag{}, c.prefix...), frag{kind: "desc"}, shaped(c.after, c.plain))
+	return pathCase{data: c.data, fs: fs, max: 1}
+}
+
+func (c descentBracketCase) GoString() string { return c.path().GoString() }
+
+// TestHegelDescentBeforeBracketFragmentStringParses: String() of a path with a descent followed
+// by a fragment written in bracket form parses back to an expression selecting the same values;
+// it writes "$.[0]", which the parser rejects (ojg/7).
+func TestHegelDescentBeforeBracketFragmentStringParses(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, descentBracketCases).path()
+		x, ok := parsePath(ht, col, c)
+		if !ok {
+			return
+		}
+		want, ok := checkGet(ht, col, c, x)
+		if !ok {
+			return
+		}
+		checkString(ht, col, c, x, want, narrow("ojg/7"))
+	})
+}
+
+// --------------------------------------------------------------------------- ojg/8
+
+// descentCase: data, a prefix of plain fragments, a descent (under HEGEL_NO_KNOWN=1 a wildcard)
+// and any plain fragment after it.
+type descentCase struct {
+	data   any
+	prefix []frag
+	after  frag
+}
+
+var descentCases = hegel.FlatMap(containersAt(3), func(d any) hegel.Generator[descentCase] {
+	keys := keysOf(d)
+	return hegel.Composite(func(tc hegel.TestCase) descentCase {
+		return descentCase{data: d, prefix: hegel.Draw(tc, prefixFragsFor(keys)), after: hegel.Draw(tc, plainFragsFor(keys))}
+	})
+})
+
+func (c descentCase) path() pathCase {
+	fs := append(append([]frag{}, c.prefix...), shaped(frag{kind: "desc"}, frag{kind: "wild"}), c.after)
+	return pathCase{data: c.data, fs: fs, max: 1}
+}
+
+func (c descentCase) GoString() string { return c.path().GoString() }
+
+// TestHegelDescentBracketStringParses: BracketString() of a path with a descent parses back to
+// an expression selecting the same values; it writes "[..]", which the parser rejects (ojg/8).
+func TestHegelDescentBracketStringParses(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, descentCases).path()
+		x, ok := parsePath(ht, col, c)
+		if !ok {
+			return
+		}
+		want, ok := checkGet(ht, col, c, x)
+		if !ok {
+			return
+		}
+		checkBracketString(ht, col, c, x, want, narrow("ojg/8"))
+	})
+}
+
+// --------------------------------------------------------------------------- ojg/9
+
+// bareDotCase: an integer in a host, spelled by a tape, with a '.' put after the at-th integer
+// literal of the text (the shape) or, under HEGEL_NO_KNOWN=1, a '.' and a digit.
+type bareDotCase struct {
+	n     int64
+	h     host
+	tape  tape
+	at    int
+	digit byte
+}
+
+var bareDotCases = hegel.Composite(func(tc hegel.TestCase) bareDotCase {
+	return bareDotCase{
+		n:     hegel.Draw(tc, weighted(choice[int64]{6, hegel.Integers[int64](-20, 20)}, choice[int64]{4, hegel.SampledFrom(intEdges)})),
+		h:     hegel.Draw(tc, hosts),
+		tape:  hegel.Draw(tc, tapes),
+		at:    hegel.Draw(tc, positions),
+		digit: hegel.Draw(tc, hegel.SampledFrom([]byte("0123456789"))),
+	}
+})
+
+func (c bareDotCase) text() string {
+	data, _ := c.h.place(c.n)
+	m := shaped(mutation{kind: "bareDot", at: c.at}, mutation{kind: "fraction", at: c.at, c: c.digit})
