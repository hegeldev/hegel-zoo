+		}
+	})
+}
+
+// negSliceCase: an array of one to four values in a host and a negative-step slice over it whose
+// end is at or past the array or whose start is before it (the shape) or, under
+// HEGEL_NO_KNOWN=1, whose bounds lie inside the array.
+type negSliceCase struct {
+	elems  []any
+	h      host
+	mag    int
+	endOut bool
+	k      int
+	b1, b2 bound
+}
+
+var negSliceCases = hegel.Composite(func(tc hegel.TestCase) negSliceCase {
+	return negSliceCase{
+		elems:  hegel.Draw(tc, items),
+		h:      hegel.Draw(tc, hosts),
+		mag:    hegel.Draw(tc, hegel.Integers(1, 3)),
+		endOut: hegel.Draw(tc, chance(50)),
+		k:      hegel.Draw(tc, hegel.Integers(0, 3)),
+		b1:     hegel.Draw(tc, sliceBounds),
+		b2:     hegel.Draw(tc, sliceBounds),
+	}
+})
+
+// inside is the bound brought into -n..n-1 (unset stays unset).
+func inside(b bound, n int) bound {
+	if !b.set {
+		return b
+	}
+	return bound{true, ((b.v%(2*n))+2*n)%(2*n) - n}
+}
+
+func (c negSliceCase) bounds() (start, end bound) {
+	n := len(c.elems)
+	start, end = inside(c.b1, n), inside(c.b2, n)
+	if noKnown {
+		return
+	}
+	if c.endOut {
+		return start, bound{true, n + c.k}
+	}
+	return bound{true, -(n + 1 + c.k)}, end
+}
+
+func (c negSliceCase) path() pathCase {
+	data, p := c.h.place(c.elems)
+	start, end := c.bounds()
+	return pathCase{data: data, fs: append(stepsFrags(p), sliceFragOf(start, end, -c.mag)), max: 1}
+}
+
+func (c negSliceCase) GoString() string { return c.path().GoString() }
