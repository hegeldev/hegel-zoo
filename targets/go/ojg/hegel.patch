+// sliceFragOf is the slice fragment [start:end:step] of the bounds.
+func sliceFragOf(start, end bound, step int) frag {
+	return frag{kind: "slice", sl: [3]int{start.v, end.v, step}, set: [3]bool{start.set, end.set, true}}
+}
+
+// emptySliceCase: an empty array in a host and a slice over it with random bounds and a
+// negative step (under HEGEL_NO_KNOWN=1 a positive one).
+type emptySliceCase struct {
