diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..28e661d
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,182 @@
+package iradix_test
+
+// One plain test per recorded bug (see bugs.toml). Each asserts the
+// documented behaviour and fails while the bug is open; target.toml lists
+// them as expected failures.
+
+import (
+	"fmt"
+	"testing"
+
+	iradix "github.com/hashicorp/go-immutable-radix/v2"
+)
+
+func pinTree() *iradix.Tree[int] {
+	r := iradix.New[int]()
+	for i, k := range []string{"a", "ab", "abc", "b"} {
+		r, _, _ = r.Insert([]byte(k), i)
+	}
+	return r
+}
+
+func drain(it *iradix.Iterator[int]) (out []string) {
+	for k, _, ok := it.Next(); ok; k, _, ok = it.Next() {
+		out = append(out, string(k))
+	}
+	return out
+}
+
+func drainBack(ri *iradix.ReverseIterator[int]) (out []string) {
+	for k, _, ok := ri.Previous(); ok; k, _, ok = ri.Previous() {
+		out = append(out, string(k))
+	}
+	return out
+}
+
+func attempt(t *testing.T, what string, f func() (got, want []string)) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("%s: panic: %v", what, r)
+		}
+	}()
+	got, want := f()
+	if fmt.Sprint(got) != fmt.Sprint(want) {
+		t.Errorf("%s: gives %q, want %q", what, got, want)
+	}
+}
+
+// iradix/1: every seek positions the iterator from the node it was created
+// at, so a second seek must work like the first. Instead a seek after a
+// lower-bound seek, or after a prefix seek that found nothing, dereferences
+// a nil node, and a lower-bound seek after a prefix seek that found a node
+// runs from that node, comparing the key against a partial prefix.
+func TestHegelPinIteratorsCanSeekAgain(t *testing.T) {
+	r := pinTree()
+	attempt(t, "SeekPrefix(zz) then SeekPrefix(a)", func() ([]string, []string) {
+		it := r.Root().Iterator()
+		it.SeekPrefix([]byte("zz"))
+		it.SeekPrefix([]byte("a"))
+		return drain(it), []string{"a", "ab", "abc"}
+	})
+	attempt(t, "SeekLowerBound(a) then SeekLowerBound(b)", func() ([]string, []string) {
+		it := r.Root().Iterator()
+		it.SeekLowerBound([]byte("a"))
+		it.SeekLowerBound([]byte("b"))
+		return drain(it), []string{"b"}
+	})
+	attempt(t, "SeekPrefix(ab) then SeekLowerBound(abc)", func() ([]string, []string) {
+		it := r.Root().Iterator()
+		it.SeekPrefix([]byte("ab"))
+		it.SeekLowerBound([]byte("abc"))
+		return drain(it), []string{"abc", "b"}
+	})
+	attempt(t, "SeekPrefix(a) then SeekLowerBound(b)", func() ([]string, []string) {
+		it := r.Root().Iterator()
+		it.SeekPrefix([]byte("a"))
+		it.SeekLowerBound([]byte("b"))
+		return drain(it), []string{"b"}
+	})
+	attempt(t, "SeekReverseLowerBound(a) then SeekPrefix(\"\")", func() ([]string, []string) {
+		ri := r.Root().ReverseIterator()
+		ri.SeekReverseLowerBound([]byte("a"))
+		ri.SeekPrefix(nil)
+		return drainBack(ri), []string{"b", "abc", "ab", "a"}
+	})
+	attempt(t, "SeekReverseLowerBound(b) twice", func() ([]string, []string) {
+		ri := r.Root().ReverseIterator()
+		ri.SeekReverseLowerBound([]byte("b"))
+		ri.SeekReverseLowerBound([]byte("a"))
+		return drainBack(ri), []string{"a"}
+	})
+}
+
+// iradix/2: the tree is immutable and nothing says a key may not be reused,
+// yet Insert stores the caller's slice as the leaf's key and as node
+// prefixes, so writing to the slice afterwards rewrites the tree.
+func TestHegelPinInsertCopiesTheKey(t *testing.T) {
+	r := iradix.New[int]()
+	k := []byte("hello")
+	r, _, _ = r.Insert(k, 1)
+	k[0] = 'j'
+	if v, ok := r.Get([]byte("hello")); !ok || v != 1 {
+		t.Errorf("Get(hello) = (%d, %v) after the inserted slice was overwritten, want (1, true)", v, ok)
+	}
+	if _, ok := r.Get([]byte("jello")); ok {
+		t.Errorf("Get(jello) found the entry after the inserted slice was overwritten")
+	}
+	if mk, _, _ := r.Root().Minimum(); string(mk) != "hello" {
+		t.Errorf("Minimum key = %q after the inserted slice was overwritten, want hello", mk)
+	}
+	// A transaction's Insert keeps the slice too.
+	txn := iradix.New[int]().Txn()
+	k2 := []byte("foo/bar")
+	txn.Insert(k2, 1)
+	txn.Insert([]byte("foo/baz"), 2)
+	copy(k2, "xxx/yyy")
+	r2 := txn.Commit()
+	if v, ok := r2.Get([]byte("foo/bar")); !ok || v != 1 {
+		t.Errorf("Get(foo/bar) = (%d, %v) after the inserted slice was overwritten in a transaction, want (1, true)", v, ok)
+	}
+}
+
+// iradix/3: WalkBackwards is documented to walk the tree in reverse order,
+// as ReverseIterator does; but it visits a node's own leaf before its
+// children, so a key comes out before the longer keys it is a prefix of.
+func TestHegelPinWalkBackwardsIsDescending(t *testing.T) {
+	r := pinTree()
+	var got []string
+	r.Root().WalkBackwards(func(k []byte, v int) bool {
+		got = append(got, string(k))
+		return false
+	})
+	want := []string{"b", "abc", "ab", "a"}
+	if fmt.Sprint(got) != fmt.Sprint(want) {
+		t.Errorf("WalkBackwards visits %q, want %q (ReverseIterator gives %q)", got, want, drainBack(r.Root().ReverseIterator()))
+	}
+}
+
+// iradix/4: DeletePrefix on a node the transaction has already copied
+// (so writeNode hands back the same node) clears its leaf and edges and
+// only then counts the leaves beneath and tracks their channels: the
+// tree's Len keeps the deleted keys and watchers under the prefix are
+// never notified.
+func TestHegelPinDeletePrefixCountsWhatItDeletes(t *testing.T) {
+	txn := iradix.New[int]().Txn()
+	txn.Insert([]byte("a"), 1)
+	txn.Insert([]byte("b"), 2)
+	if !txn.DeletePrefix(nil) {
+		t.Fatal("DeletePrefix(nil) reported no match")
+	}
+	r := txn.Commit()
+	if got := drain(r.Root().Iterator()); len(got) != 0 {
+		t.Fatalf("keys left after DeletePrefix(nil): %q", got)
+	}
+	if r.Len() != 0 {
+		t.Errorf("Len = %d after inserting a, b and DeletePrefix(nil) in one transaction, want 0", r.Len())
+	}
+
+	r = iradix.New[int]()
+	r, _, _ = r.Insert([]byte("a/1"), 1)
+	r, _, _ = r.Insert([]byte("a/2"), 2)
+	watch, _, ok := r.Root().GetWatch([]byte("a/1"))
+	if !ok {
+		t.Fatal("a/1 not found")
+	}
+	txn = r.Txn()
+	txn.TrackMutate(true)
+	txn.Insert([]byte("a/3"), 3)
+	txn.DeletePrefix([]byte("a/"))
+	r2 := txn.Commit()
+	if _, ok := r2.Get([]byte("a/1")); ok {
+		t.Fatal("a/1 still present")
+	}
+	if r2.Len() != 0 {
+		t.Errorf("Len = %d after Insert(a/3) and DeletePrefix(a/) in one transaction, want 0", r2.Len())
+	}
+	select {
+	case <-watch:
+	default:
+		t.Errorf("the watch on a/1 was not notified though the key was deleted")
+	}
+}
