new file mode 100644
index 0000000..9a998f1
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,980 @@
+package iradix_test
+
+// Hegel property tests for github.com/hashicorp/go-immutable-radix/v2: the
+// tree and its transactions against a Go map model (sorted on demand), the
+// iterators, walks and seeks against orderings computed from the model, the
+// immutability of committed trees (read concurrently, under the race
+// detector), transaction clones, and the mutation-tracking channels.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	iradix "github.com/hashicorp/go-immutable-radix/v2"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness
+
+var collecting = os.Getenv("IRADIX_COLLECT") != ""
+
+var (
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	lastNote      string
+)
+
+type collected struct{}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		lastNote = ""
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("panic in the code under test: %v\n  case: %s", r, lastNote))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) {
+	s := fmt.Sprintf(format, args...)
+	lastNote += "\n  " + s
+	ht.Logf("%s", s)
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, msg+"\n  case: "+lastNote)
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// Known bugs (see bugs.toml); each switch makes the properties avoid one.
+var Known = struct {
+	singleSeek             bool // iradix/1: a second seek on an iterator panics (nil node after a lower-bound seek or a missed prefix seek) or seeks relative to the node a prefix seek left it at
+	keyAliased             bool // iradix/2: Insert keeps the caller's key slice as the leaf key and as node prefixes
+	walkBackwardsPreorder  bool // iradix/3: WalkBackwards visits a node's leaf before its children, so a key comes before the longer keys it is a prefix of
+	deletePrefixCountsLate bool // iradix/4: DeletePrefix on a node the transaction already wrote clears it before counting its leaves and tracking their channels
+}{singleSeek: true, keyAliased: true, walkBackwardsPreorder: true, deletePrefixCountsLate: true}
+
+// hasNested reports whether some key is a proper prefix of another
+// (Known.walkBackwardsPreorder's shape).
+func hasNested(m model) bool {
+	ks := m.keys()
+	for i := 1; i < len(ks); i++ {
+		if strings.HasPrefix(ks[i], ks[i-1]) {
+			return true
+		}
+	}
+	return false
+}
+
+// written records the keys and prefixes a transaction has written so far.
+// The nodes the transaction copied lie on the paths to those keys, plus the
+// nodes a delete merged into a sibling branch (which share at least the
+// first byte with the deleted key) and the branch a split moved aside (which
+// shares at least the first byte with the inserted key); a DeletePrefix whose
+// prefix reaches one of them is Known.deletePrefixCountsLate's shape. Every
+// write copies the root, where the empty prefix ends.
+type written []string
+
+func (w written) hits(p string) bool {
+	if len(w) > 0 && p == "" {
+		return true
+	}
+	for _, k := range w {
+		if k != "" && k[0] == p[0] {
+			return true
+		}
+	}
+	return false
+}
+
+// genTxnOp is genOp for an operation inside a transaction: while the gate
+// is on, a DeletePrefix that would land on a written node becomes an insert.
+func genTxnOp(tc hegel.TestCase, m model, w *written) op {
+	o := genOp(tc, m)
+	if o.kind == "deletePrefix" && Known.deletePrefixCountsLate && w.hits(o.key) {
+		o = op{"insert", keyFrom(tc, m), n(tc, 0, 99)}
+	}
+	*w = append(*w, o.key)
+	return o
+}
+
+// ---------------------------------------------------------------------------
+// The model: a map, sorted on demand
+
+type model map[string]int
+
+func (m model) clone() model {
+	c := model{}
+	for k, v := range m {
+		c[k] = v
+	}
+	return c
+}
+
+func (m model) keys() []string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+func (m model) withPrefix(p string) []string {
+	var out []string
+	for _, k := range m.keys() {
+		if strings.HasPrefix(k, p) {
+			out = append(out, k)
+		}
+	}
+	return out
+}
+
+// lower is every key >= k, ascending.
+func (m model) lower(k string) []string {
+	var out []string
+	for _, x := range m.keys() {
+		if x >= k {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// revLower is every key <= k, descending.
+func (m model) revLower(k string) []string {
+	var out []string
+	ks := m.keys()
+	for i := len(ks) - 1; i >= 0; i-- {
+		if ks[i] <= k {
+			out = append(out, ks[i])
+		}
+	}
+	return out
+}
+
+// path is every key that is a prefix of p, shortest first (WalkPath's order).
+func (m model) path(p string) []string {
+	var out []string
+	for _, k := range m.keys() {
+		if strings.HasPrefix(p, k) {
+			out = append(out, k)
+		}
+	}
+	return out
+}
+
+func (m model) longest(k string) (string, bool) {
+	ps := m.path(k)
+	if len(ps) == 0 {
+		return "", false
+	}
+	return ps[len(ps)-1], true
+}
+
+func reversed(xs []string) []string {
+	out := make([]string, len(xs))
+	for i, x := range xs {
+		out[len(xs)-1-i] = x
+	}
+	return out
+}
+
+type kv struct {
+	k string
+	v int
+}
+
+func (m model) pairs(keys []string) []kv {
+	out := []kv{}
+	for _, k := range keys {
+		out = append(out, kv{k, m[k]})
+	}
+	return out
+}
+
+func fwd(it *iradix.Iterator[int]) []kv {
+	out := []kv{}
+	for k, v, ok := it.Next(); ok; k, v, ok = it.Next() {
+		out = append(out, kv{string(k), v})
+	}
+	return out
+}
+
+func rev(ri *iradix.ReverseIterator[int]) []kv {
+	out := []kv{}
+	for k, v, ok := ri.Previous(); ok; k, v, ok = ri.Previous() {
+		out = append(out, kv{string(k), v})
+	}
+	return out
+}
+
+func walked(walk func(iradix.WalkFn[int])) []kv {
+	out := []kv{}
+	walk(func(k []byte, v int) bool {
+		out = append(out, kv{string(k), v})
+		return false
+	})
+	return out
+}
+
+func same(a, b []kv) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// key copies s into a fresh slice: the tree keeps the slice it is given
+// (Known.keyAliased), and the model's strings must stay independent of it.
+func key(s string) []byte { return []byte(s) }
+
+// ---------------------------------------------------------------------------
+// Generators
+
+func genKey(tc hegel.TestCase) string {
+	l := n(tc, 0, 5)
+	b := make([]byte, 0, l)
+	for i := 0; i < l; i++ {
+		if chance(tc, 8) {
+			b = append(b, pick(tc, byte(0), byte(0xff), byte('z')))
+		} else {
+			b = append(b, pick(tc, byte('a'), byte('b'), byte('/')))
+		}
+	}
+	return string(b)
+}
+
+// keyFrom is an existing key half the time (when there is one), else random.
+func keyFrom(tc hegel.TestCase, m model) string {
+	if len(m) > 0 && chance(tc, 50) {
+		return pick(tc, m.keys()...)
+	}
+	return genKey(tc)
+}
+
+// prefixFrom is a prefix of an existing key half the time, else random.
+func prefixFrom(tc hegel.TestCase, m model) string {
+	if len(m) > 0 && chance(tc, 50) {
+		k := pick(tc, m.keys()...)
+		return k[:n(tc, 0, len(k))]
+	}
+	return genKey(tc)
+}
+
+type op struct {
+	kind string // insert, delete, deletePrefix
+	key  string
+	val  int
+}
+
+func (o op) String() string { return fmt.Sprintf("%s(%q, %d)", o.kind, o.key, o.val) }
+
+func genOp(tc hegel.TestCase, m model) op {
+	switch n(tc, 1, 10) {
+	case 1, 2, 3, 4, 5:
+		return op{"insert", keyFrom(tc, m), n(tc, 0, 99)}
+	case 6, 7, 8:
+		return op{"delete", keyFrom(tc, m), 0}
+	default:
+		return op{"deletePrefix", prefixFrom(tc, m), 0}
+	}
+}
+
+// deletePrefixResult is what DeletePrefix reports: true when the prefix
+// reached a node, which every deleted key implies, and which the root
+// always does for the empty prefix (even in an empty tree).
+func deletePrefixResult(prefix string, deleted int) bool {
+	return deleted > 0 || prefix == ""
+}
+
+// applyModel applies o to m and returns the results the tree must report.
+func applyModel(m model, o op) (old int, ok bool) {
+	switch o.kind {
+	case "insert":
+		old, ok = m[o.key]
+		m[o.key] = o.val
+		return old, ok
+	case "delete":
+		old, ok = m[o.key]
+		delete(m, o.key)
+		return old, ok
+	default:
+		deleted := 0
+		for _, k := range m.withPrefix(o.key) {
+			delete(m, k)
+			deleted++
+		}
+		return deleted, deletePrefixResult(o.key, deleted)
+	}
+}
+
+// applyTxn applies o through the transaction and checks its results.
+func applyTxn(ht *hegel.T, txn *iradix.Txn[int], m model, o op) {
+	wantOld, wantOk := applyModel(m, o)
+	switch o.kind {
+	case "insert":
+		old, ok := txn.Insert(key(o.key), o.val)
+		if ok != wantOk || (ok && old != wantOld) {
+			fail(ht, "Txn.Insert(%q) = (%d, %v), want (%d, %v)", o.key, old, ok, wantOld, wantOk)
+		}
+	case "delete":
+		old, ok := txn.Delete(key(o.key))
+		if ok != wantOk || (ok && old != wantOld) {
+			fail(ht, "Txn.Delete(%q) = (%d, %v), want (%d, %v)", o.key, old, ok, wantOld, wantOk)
+		}
+	default:
+		ok := txn.DeletePrefix(key(o.key))
+		if ok != wantOk {
+			fail(ht, "Txn.DeletePrefix(%q) = %v, want %v (%d keys deleted)", o.key, ok, wantOk, wantOld)
+		}
+	}
+}
+
+// applyTree applies o through the tree's one-shot methods.
+func applyTree(ht *hegel.T, tr *iradix.Tree[int], m model, o op) *iradix.Tree[int] {
+	wantOld, wantOk := applyModel(m, o)
+	switch o.kind {
+	case "insert":
+		nt, old, ok := tr.Insert(key(o.key), o.val)
+		if ok != wantOk || (ok && old != wantOld) {
+			fail(ht, "Tree.Insert(%q) = (%d, %v), want (%d, %v)", o.key, old, ok, wantOld, wantOk)
+		}
+		return nt
+	case "delete":
+		nt, old, ok := tr.Delete(key(o.key))
+		if ok != wantOk || (ok && old != wantOld) {
+			fail(ht, "Tree.Delete(%q) = (%d, %v), want (%d, %v)", o.key, old, ok, wantOld, wantOk)
+		}
+		return nt
+	default:
+		nt, ok := tr.DeletePrefix(key(o.key))
+		if ok != wantOk {
+			fail(ht, "Tree.DeletePrefix(%q) = %v, want %v (%d keys deleted)", o.key, ok, wantOk, wantOld)
+		}
+		return nt
+	}
+}
+
+// build makes a tree and its model from a few random operations.
+func build(ht *hegel.T, tc hegel.TestCase) (*iradix.Tree[int], model) {
+	tr := iradix.New[int]()
+	m := model{}
+	txn := tr.Txn()
+	var w written
+	for i, c := 0, n(tc, 0, 12); i < c; i++ {
+		o := genTxnOp(tc, m, &w)
+		note(ht, "build %v", o)
+		applyTxn(ht, txn, m, o)
+	}
+	return txn.Commit(), m
+}
+
+// ---------------------------------------------------------------------------
+// Checking a tree against its model
+
+// checkNode compares every read operation on the node with the model.
+func checkNode(ht *hegel.T, tc hegel.TestCase, root *iradix.Node[int], m model, what string) {
+	keys := m.keys()
+	all := m.pairs(keys)
+	for _, k := range keys {
+		v, ok := root.Get(key(k))
+		if !ok || v != m[k] {
+			fail(ht, "%s: Get(%q) = (%d, %v), want (%d, true)", what, k, v, ok, m[k])
+		}
+		_, v, ok = root.GetWatch(key(k))
+		if !ok || v != m[k] {
+			fail(ht, "%s: GetWatch(%q) = (%d, %v), want (%d, true)", what, k, v, ok, m[k])
+		}
+	}
+	if got := fwd(root.Iterator()); !same(got, all) {
+		fail(ht, "%s: Iterator gives %v, want %v", what, got, all)
+	}
+	if got := walked(root.Walk); !same(got, all) {
+		fail(ht, "%s: Walk gives %v, want %v", what, got, all)
+	}
+	back := m.pairs(reversed(keys))
+	if got := rev(root.ReverseIterator()); !same(got, back) {
+		fail(ht, "%s: ReverseIterator gives %v, want %v", what, got, back)
+	}
+	if !(Known.walkBackwardsPreorder && hasNested(m)) {
+		if got := walked(root.WalkBackwards); !same(got, back) {
+			fail(ht, "%s: WalkBackwards gives %v, want %v", what, got, back)
+		}
+	}
+	mk, mv, mok := root.Minimum()
+	xk, xv, xok := root.Maximum()
+	if len(keys) == 0 {
+		if mok || xok {
+			fail(ht, "%s: Minimum/Maximum of an empty tree found (%q, %q)", what, mk, xk)
+		}
+	} else {
+		if !mok || string(mk) != keys[0] || mv != m[keys[0]] {
+			fail(ht, "%s: Minimum = (%q, %d, %v), want (%q, %d)", what, mk, mv, mok, keys[0], m[keys[0]])
+		}
+		last := keys[len(keys)-1]
+		if !xok || string(xk) != last || xv != m[last] {
+			fail(ht, "%s: Maximum = (%q, %d, %v), want (%q, %d)", what, xk, xv, xok, last, m[last])
+		}
+	}
+	for i, c := 0, n(tc, 1, 3); i < c; i++ {
+		k := keyFrom(tc, m)
+		note(ht, "%s: probe %q", what, k)
+		v, ok := root.Get(key(k))
+		wv, wok := m[k]
+		if ok != wok || (ok && v != wv) {
+			fail(ht, "%s: Get(%q) = (%d, %v), want (%d, %v)", what, k, v, ok, wv, wok)
+		}
+		lk, lv, lok := root.LongestPrefix(key(k))
+		wl, wlok := m.longest(k)
+		if lok != wlok || (lok && (string(lk) != wl || lv != m[wl])) {
+			fail(ht, "%s: LongestPrefix(%q) = (%q, %d, %v), want (%q, %v)", what, k, lk, lv, lok, wl, wlok)
+		}
+		path := m.pairs(m.path(k))
+		if got := walked(func(fn iradix.WalkFn[int]) { root.WalkPath(key(k), fn) }); !same(got, path) {
+			fail(ht, "%s: WalkPath(%q) gives %v, want %v", what, k, got, path)
+		}
+		pi := root.PathIterator(key(k))
+		got := []kv{}
+		for pk, pv, ok := pi.Next(); ok; pk, pv, ok = pi.Next() {
+			got = append(got, kv{string(pk), pv})
+		}
+		if !same(got, path) {
+			fail(ht, "%s: PathIterator(%q) gives %v, want %v", what, k, got, path)
+		}
+		it := root.Iterator()
+		it.SeekLowerBound(key(k))
+		if got, want := fwd(it), m.pairs(m.lower(k)); !same(got, want) {
+			fail(ht, "%s: SeekLowerBound(%q) then Next gives %v, want %v", what, k, got, want)
+		}
+		ri := root.ReverseIterator()
+		ri.SeekReverseLowerBound(key(k))
+		if got, want := rev(ri), m.pairs(m.revLower(k)); !same(got, want) {
+			fail(ht, "%s: SeekReverseLowerBound(%q) then Previous gives %v, want %v", what, k, got, want)
+		}
+		p := prefixFrom(tc, m)
+		note(ht, "%s: prefix probe %q", what, p)
+		under := m.pairs(m.withPrefix(p))
+		if got := walked(func(fn iradix.WalkFn[int]) { root.WalkPrefix(key(p), fn) }); !same(got, under) {
+			fail(ht, "%s: WalkPrefix(%q) gives %v, want %v", what, p, got, under)
+		}
+		it = root.Iterator()
+		it.SeekPrefix(key(p))
+		if got := fwd(it); !same(got, under) {
+			fail(ht, "%s: SeekPrefix(%q) then Next gives %v, want %v", what, p, got, under)
+		}
+		ri = root.ReverseIterator()
+		ri.SeekPrefix(key(p))
+		if got, want := rev(ri), m.pairs(reversed(m.withPrefix(p))); !same(got, want) {
+			fail(ht, "%s: ReverseIterator.SeekPrefix(%q) then Previous gives %v, want %v", what, p, got, want)
+		}
+	}
+}
+
+func checkTree(ht *hegel.T, tc hegel.TestCase, tr *iradix.Tree[int], m model, what string) {
+	if tr.Len() != len(m) {
+		fail(ht, "%s: Len = %d, want %d", what, tr.Len(), len(m))
+	}
+	for _, k := range m.keys() {
+		v, ok := tr.Get(key(k))
+		if !ok || v != m[k] {
+			fail(ht, "%s: Tree.Get(%q) = (%d, %v), want (%d, true)", what, k, v, ok, m[k])
+		}
+	}
+	checkNode(ht, tc, tr.Root(), m, what)
+}
+
+// ---------------------------------------------------------------------------
+// Properties
+
+// The tree, through one-shot operations and transactions, is a map: every
+// return value and every read (Get, Len, Minimum/Maximum, the iterators,
+// walks, prefix, path and lower-bound seeks) agrees with the model.
+func TestHegelTreeAgreesWithModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		tr := iradix.New[int]()
+		m := model{}
+		for step, steps := 0, n(tc, 1, 10); step < steps; step++ {
+			if chance(tc, 40) {
+				o := genOp(tc, m)
+				note(ht, "step %d: tree %v", step, o)
+				tr = applyTree(ht, tr, m, o)
+			} else {
+				txn := tr.Txn()
+				before := m.clone()
+				var w written
+				for i, c := 0, n(tc, 1, 8); i < c; i++ {
+					o := genTxnOp(tc, m, &w)
+					note(ht, "step %d: txn %v", step, o)
+					applyTxn(ht, txn, m, o)
+					if chance(tc, 30) {
+						k := keyFrom(tc, m)
+						v, ok := txn.Get(key(k))
+						wv, wok := m[k]
+						if ok != wok || (ok && v != wv) {
+							fail(ht, "mid-transaction Txn.Get(%q) = (%d, %v), want (%d, %v)", k, v, ok, wv, wok)
+						}
+					}
+				}
+				if chance(tc, 30) {
+					checkNode(ht, tc, txn.Root(), m, "Txn.Root before commit")
+				}
+				// The tree the transaction started from is untouched.
+				if tr.Len() != len(before) {
+					fail(ht, "the source tree's Len changed to %d during a transaction, want %d", tr.Len(), len(before))
+				}
+				if chance(tc, 50) {
+					tr = txn.Commit()
+				} else {
+					tr = txn.CommitOnly()
+				}
+			}
+			checkTree(ht, tc, tr, m, fmt.Sprintf("after step %d", step))
+		}
+	})
+}
+
+// A committed tree never changes: every earlier version still reads as its
+// model did, even while later transactions run and while another goroutine
+// reads it (the race detector is on).
+func TestHegelCommittedTreesAreImmutable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		type version struct {
+			tr *iradix.Tree[int]
+			m  model
+		}
+		tr, m := build(ht, tc)
+		history := []version{{tr, m.clone()}}
+		for step, steps := 0, n(tc, 1, 6); step < steps; step++ {
+			old := history[n(tc, 0, len(history)-1)]
+			// A reader on an older version while the transaction runs.
+			var wg sync.WaitGroup
+			wg.Add(1)
+			var readerErr string
+			go func() {
+				defer wg.Done()
+				for round := 0; round < 3; round++ {
+					if old.tr.Len() != len(old.m) {
+						readerErr = fmt.Sprintf("concurrent reader: Len = %d, want %d", old.tr.Len(), len(old.m))
+						return
+					}
+					got := fwd(old.tr.Root().Iterator())
+					if !same(got, old.m.pairs(old.m.keys())) {
+						readerErr = fmt.Sprintf("concurrent reader: Iterator gives %v, want %v", got, old.m.pairs(old.m.keys()))
+						return
+					}
+					for _, k := range old.m.keys() {
+						if v, ok := old.tr.Get(key(k)); !ok || v != old.m[k] {
+							readerErr = fmt.Sprintf("concurrent reader: Get(%q) = (%d, %v), want (%d, true)", k, v, ok, old.m[k])
+							return
+						}
+					}
+				}
+			}()
+			txn := tr.Txn()
+			var w written
+			for i, c := 0, n(tc, 1, 10); i < c; i++ {
+				o := genTxnOp(tc, m, &w)
+				note(ht, "step %d: txn %v", step, o)
+				applyTxn(ht, txn, m, o)
+			}
+			tr = txn.Commit()
+			wg.Wait()
+			if readerErr != "" {
+				fail(ht, "%s", readerErr)
+			}
+			history = append(history, version{tr, m.clone()})
+		}
+		for i, v := range history {
+			checkTree(ht, tc, v.tr, v.m, fmt.Sprintf("version %d", i))
+		}
+	})
+}
+
+// A cloned transaction carries the original's uncommitted writes, and from
+// then on the two are independent: each commits to its own model, the
+// source tree is untouched, and a clone of a clone behaves alike.
+func TestHegelTxnClonesAreIndependent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		tr, m0 := build(ht, tc)
+		type branch struct {
+			txn *iradix.Txn[int]
+			m   model
+			w   written
+		}
+		root := branch{tr.Txn(), m0.clone(), nil}
+		for i, c := 0, n(tc, 0, 6); i < c; i++ {
+			o := genTxnOp(tc, root.m, &root.w)
+			note(ht, "before clone: %v", o)
+			applyTxn(ht, root.txn, root.m, o)
+		}
+		// Clone resets the source's cache of written nodes as well as the clone's.
+		root.w = nil
+		branches := []branch{root, {root.txn.Clone(), root.m.clone(), nil}}
+		for i, c := 0, n(tc, 0, 12); i < c; i++ {
+			b := n(tc, 0, len(branches)-1)
+			if len(branches) < 4 && chance(tc, 15) {
+				note(ht, "clone branch %d", b)
+				branches[b].w = nil
+				branches = append(branches, branch{branches[b].txn.Clone(), branches[b].m.clone(), nil})
+				continue
+			}
+			o := genTxnOp(tc, branches[b].m, &branches[b].w)
+			note(ht, "branch %d: %v", b, o)
+			applyTxn(ht, branches[b].txn, branches[b].m, o)
+			if chance(tc, 20) {
+				checkNode(ht, tc, branches[b].txn.Root(), branches[b].m, fmt.Sprintf("branch %d before commit", b))
+			}
+		}
+		trees := make([]*iradix.Tree[int], len(branches))
+		for i, b := range branches {
+			trees[i] = b.txn.Commit()
+		}
+		for i, b := range branches {
+			checkTree(ht, tc, trees[i], b.m, fmt.Sprintf("branch %d", i))
+		}
+		checkTree(ht, tc, tr, m0, "the source tree")
+	})
+}
+
+// Mutation tracking: a watch taken on the old tree (GetWatch on a key,
+// SeekPrefixWatch on a prefix) is closed by Commit, or by Notify after
+// CommitOnly, whenever the answer to that lookup changed; a leaf's own
+// channel stays open when no operation touched its key; the new tree's
+// channels are all open; Notify is idempotent. A tenth of the cases push
+// the transaction past the tracking limit (8192 channels) into the slow
+// tree-comparison path.
+func TestHegelWatchesFireOnChange(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		tr, m := build(ht, tc)
+		before := m.clone()
+		type keyWatch struct {
+			k  string
+			ch <-chan struct{}
+		}
+		type prefixWatch struct {
+			p       string
+			ch, rch <-chan struct{}
+		}
+		var kws []keyWatch
+		for i, c := 0, n(tc, 1, 4); i < c; i++ {
+			k := keyFrom(tc, m)
+			ch, _, _ := tr.Root().GetWatch(key(k))
+			if ch == nil {
+				fail(ht, "GetWatch(%q) returned a nil channel", k)
+			}
+			kws = append(kws, keyWatch{k, ch})
+		}
+		var pws []prefixWatch
+		for i, c := 0, n(tc, 1, 3); i < c; i++ {
+			p := prefixFrom(tc, m)
+			it := tr.Root().Iterator()
+			ch := it.SeekPrefixWatch(key(p))
+			ri := tr.Root().ReverseIterator()
+			rch := ri.SeekPrefixWatch(key(p))
+			if ch == nil || rch == nil {
+				fail(ht, "SeekPrefixWatch(%q) returned a nil channel", p)
+			}
+			pws = append(pws, prefixWatch{p, ch, rch})
+		}
+		txn := tr.Txn()
+		txn.TrackMutate(true)
+		touched := map[string]bool{}
+		var w written
+		huge := chance(tc, 10)
+		if huge {
+			note(ht, "huge transaction")
+			for i := 0; i < 8300; i++ {
+				k := fmt.Sprintf("zz/%05d", i)
+				applyTxn(ht, txn, m, op{"insert", k, i})
+				touched[k] = true
+			}
+			w = append(w, "zz/")
+		}
+		for i, c := 0, n(tc, 1, 8); i < c; i++ {
+			o := genTxnOp(tc, m, &w)
+			note(ht, "txn %v", o)
+			switch o.kind {
+			case "insert", "delete":
+				touched[o.key] = true
+			default:
+				for k := range before {
+					if strings.HasPrefix(k, o.key) {
+						touched[k] = true
+					}
+				}
+			}
+			applyTxn(ht, txn, m, o)
+		}
+		var nt *iradix.Tree[int]
+		switch n(tc, 1, 3) {
+		case 1:
+			nt = txn.Commit()
+		case 2:
+			nt = txn.CommitOnly()
+			txn.Notify()
+		default:
+			nt = txn.CommitOnly()
+			txn.Notify()
+			txn.Notify()
+		}
+		closed := func(ch <-chan struct{}) bool {
+			select {
+			case <-ch:
+				return true
+			default:
+				return false
+			}
+		}
+		for _, w := range kws {
+			ov, ook := before[w.k]
+			nv, nok := m[w.k]
+			if (ook != nok || ov != nv) && !closed(w.ch) {
+				fail(ht, "GetWatch(%q) was not notified: the key went from (%d, %v) to (%d, %v)", w.k, ov, ook, nv, nok)
+			}
+			if ook && nok && !touched[w.k] && closed(w.ch) {
+				fail(ht, "GetWatch(%q) was notified though no operation touched the key (its leaf's channel should be left alone)", w.k)
+			}
+		}
+		for _, w := range pws {
+			ob, nb := before.pairs(before.withPrefix(w.p)), m.pairs(m.withPrefix(w.p))
+			if !same(ob, nb) {
+				if !closed(w.ch) {
+					fail(ht, "Iterator.SeekPrefixWatch(%q) was not notified: the keys under it went from %v to %v", w.p, ob, nb)
+				}
+				if !closed(w.rch) {
+					fail(ht, "ReverseIterator.SeekPrefixWatch(%q) was not notified: the keys under it went from %v to %v", w.p, ob, nb)
+				}
+			}
+		}
+		if huge {
+			// Keep the check of the new tree cheap.
+			if nt.Len() != len(m) {
+				fail(ht, "Len = %d after the huge transaction, want %d", nt.Len(), len(m))
+			}
+		} else {
+			checkTree(ht, tc, nt, m, "after the tracked commit")
+		}
+		for _, k := range m.keys() {
+			if len(k) > 0 && k[0] == 'z' && huge {
+				continue
+			}
+			ch, _, ok := nt.Root().GetWatch(key(k))
+			if !ok {
+				fail(ht, "GetWatch(%q) on the new tree found nothing", k)
+			}
+			if closed(ch) {
+				fail(ht, "GetWatch(%q) on the new tree returned a channel that is already closed", k)
+			}
+		}
+		rootCh, _, _ := nt.Root().GetWatch(nil)
+		if closed(rootCh) {
+			fail(ht, "the new tree's root channel is already closed")
+		}
+	})
+}
+
+// An iterator follows its seek: after SeekPrefix or SeekLowerBound (a fresh
+// iterator per seek while Known.singleSeek), Next yields exactly the model's
+// keys in order, and keeps returning false once they are exhausted; the
+// reverse iterator likewise with SeekPrefix, SeekReverseLowerBound and
+// Previous. Without the gate the same iterator is re-seeked.
+func TestHegelIteratorsFollowTheirSeeks(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		tr, m := build(ht, tc)
+		root := tr.Root()
+		it := root.Iterator()
+		ri := root.ReverseIterator()
+		var want []kv
+		var rwant []kv
+		want, rwant = m.pairs(m.keys()), m.pairs(reversed(m.keys()))
+		for step, steps := 0, n(tc, 1, 8); step < steps; step++ {
+			switch n(tc, 1, 6) {
+			case 1:
+				p := prefixFrom(tc, m)
+				note(ht, "SeekPrefix(%q)", p)
+				if Known.singleSeek {
+					it = root.Iterator()
+				}
+				it.SeekPrefix(key(p))
+				want = m.pairs(m.withPrefix(p))
+			case 2:
+				k := keyFrom(tc, m)
+				note(ht, "SeekLowerBound(%q)", k)
+				if Known.singleSeek {
+					it = root.Iterator()
+				}
+				it.SeekLowerBound(key(k))
+				want = m.pairs(m.lower(k))
+			case 3:
+				p := prefixFrom(tc, m)
+				note(ht, "reverse SeekPrefix(%q)", p)
+				if Known.singleSeek {
+					ri = root.ReverseIterator()
+				}
+				ri.SeekPrefix(key(p))
+				rwant = m.pairs(reversed(m.withPrefix(p)))
+			case 4:
+				k := keyFrom(tc, m)
+				note(ht, "SeekReverseLowerBound(%q)", k)
+				if Known.singleSeek {
+					ri = root.ReverseIterator()
+				}
+				ri.SeekReverseLowerBound(key(k))
+				rwant = m.pairs(m.revLower(k))
+			case 5:
+				c := n(tc, 0, len(want)+2)
+				note(ht, "Next x%d", c)
+				for i := 0; i < c; i++ {
+					k, v, ok := it.Next()
+					if len(want) == 0 {
+						if ok {
+							fail(ht, "Next after exhaustion = (%q, %d, true), want false", k, v)
+						}
+						continue
+					}
+					if !ok || string(k) != want[0].k || v != want[0].v {
+						fail(ht, "Next = (%q, %d, %v), want %v", k, v, ok, want[0])
+					}
+					want = want[1:]
+				}
+			default:
+				c := n(tc, 0, len(rwant)+2)
+				note(ht, "Previous x%d", c)
+				for i := 0; i < c; i++ {
+					k, v, ok := ri.Previous()
+					if len(rwant) == 0 {
+						if ok {
+							fail(ht, "Previous after exhaustion = (%q, %d, true), want false", k, v)
+						}
+						continue
+					}
+					if !ok || string(k) != rwant[0].k || v != rwant[0].v {
+						fail(ht, "Previous = (%q, %d, %v), want %v", k, v, ok, rwant[0])
+					}
+					rwant = rwant[1:]
+				}
+			}
+		}
+	})
+}
+
+// A walk stops as soon as its function returns true, having visited exactly
+// the first entries of the corresponding full order.
+func TestHegelWalksStopWhenAsked(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		tr, m := build(ht, tc)
+		root := tr.Root()
+		k := keyFrom(tc, m)
+		p := prefixFrom(tc, m)
+		walks := []struct {
+			name string
+			walk func(iradix.WalkFn[int])
+			full []kv
+		}{
+			{"Walk", root.Walk, m.pairs(m.keys())},
+			{"WalkBackwards", root.WalkBackwards, m.pairs(reversed(m.keys()))},
+			{fmt.Sprintf("WalkPrefix(%q)", p), func(fn iradix.WalkFn[int]) { root.WalkPrefix(key(p), fn) }, m.pairs(m.withPrefix(p))},
+			{fmt.Sprintf("WalkPath(%q)", k), func(fn iradix.WalkFn[int]) { root.WalkPath(key(k), fn) }, m.pairs(m.path(k))},
+		}
+		for _, w := range walks {
+			if w.name == "WalkBackwards" && Known.walkBackwardsPreorder && hasNested(m) {
+				continue
+			}
+			stop := n(tc, 1, len(w.full)+1)
+			note(ht, "%s, stop after %d of %d", w.name, stop, len(w.full))
+			got := []kv{}
+			w.walk(func(k []byte, v int) bool {
+				got = append(got, kv{string(k), v})
+				return len(got) == stop
+			})
+			want := w.full
+			if stop < len(want) {
+				want = want[:stop]
+			}
+			if !same(got, want) {
+				fail(ht, "%s stopping after %d visited %v, want %v", w.name, stop, got, want)
+			}
+		}
+	})
+}
