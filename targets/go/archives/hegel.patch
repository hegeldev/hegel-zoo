+// =========================================================================== the round trip and ArchiveFS
+
+// The narrow properties of the round-trip and ArchiveFS families (part 3): the shape of each
+// bug forced by construction (an injected entry, a flag), the regions past the earlier ids
+// left out of the judgement by pastSwitches where the surroundings carry them (a raw archive
+// with an implicit directory is the shape of 4, 5 and 7 together), the classifier as the
+// filter (regionOf) where the surroundings can take the shape away.
+
+// --------------------------------------------------------------------------- archives/1
+
+// hasKind reports whether the tree has an entry of the kind.
+func hasKind(tree []fileEntry, kind byte) bool {
+	for _, e := range tree {
+		if e.Kind == kind {
+			return true
+		}
+	}
+	return false
+}
+
+// xzZipCases: a zip written with ZipMethodXz (Deflate, Bzip2 or Zstd past the shape, a third
+// each) without SelectiveCompression over a tree of one to ten entries with at least one file
+// (an entry the method writes through the compressor), ClearAttributes at 30. Judged past
+// archives/8 (TestFS's lines on any non-empty archive); 9 needs an empty zip, 10 a compression
+// format.
+var xzZipCases = hegel.FlatMap(treesBetween(1, 10), func(tree []fileEntry) hegel.Generator[roundTripCase] {
+	withFile := hegel.Just(tree)
+	if !hasKind(tree, 'f') {
+		withFile = hegel.FlatMap(entryName, func(name string) hegel.Generator[[]fileEntry] {
+			return hegel.Map(aFile(freshName(tree, "", name, "")), func(f fileEntry) []fileEntry { return withEntry(tree, f) })
+		})
+	}
+	method := hzShaped(hegel.Just(uint16(archives.ZipMethodXz)), halvesOver([]int{1, 1, 1}, zip.Deflate, uint16(archives.ZipMethodBzip2), uint16(archives.ZipMethodZstd)))
+	return hegel.FlatMap(withFile, func(tree []fileEntry) hegel.Generator[roundTripCase] {
+		return hegel.FlatMap(method, func(m uint16) hegel.Generator[roundTripCase] {
+			return hegel.Map(dieCoin(30), func(clear bool) roundTripCase {
+				return roundTripCase{Tree: tree, Arch: archFormat{Kind: "zip", ZipMethod: m}, Clear: clear}
+			})
+		})
+	})
+})
+
+// TestHegelXzZipsExtract: a zip written with ZipMethodXz gives its entries back to Extract,
+// to ArchiveFS and to Python's zipfile as every other method does; archives/1 writes the xz
+// stream header before each entry's local header (the compressor emits it at construction,
+// before archive/zip writes the header at the recorded offset), and no reader can open the
+// entries.
+func TestHegelXzZipsExtract(t *testing.T) {
+	judgedWithCount(t, 100, xzZipAttempts, xzZipCases, roundTripJudgeOver([]int{kDirFileReadDirRest}, nil))
+}
+
+// xzZipAttempts caps the shrink of TestHegelXzZipsExtract at that many failing attempts:
+// every case runs Python's zipfile in a child process, and every case fails.
+const xzZipAttempts = 60
+
+// --------------------------------------------------------------------------- the raw archives
+
+// The views of archiveFSExpected the narrow properties are judged by: past the ids the
+// surroundings carry.
+var (
+	archiveFSPast78   = pastSwitches(archiveFSExpected, []int{kStatImplicitDirName, kDirFileReadDirRest})
+	archiveFSPast4678 = pastSwitches(archiveFSExpected, []int{kOpenImplicitDirFile, kStatPrefixMissing, kStatImplicitDirName, kDirFileReadDirRest})
+	archiveFSPast4578 = pastSwitches(archiveFSExpected, []int{kOpenImplicitDirFile, kOpenDirFreshEntries, kStatImplicitDirName, kDirFileReadDirRest})
+	archiveFSPast4568 = pastSwitches(archiveFSExpected, []int{kOpenImplicitDirFile, kOpenDirFreshEntries, kStatPrefixMissing, kDirFileReadDirRest})
+	archiveFSPast4567 = pastSwitches(archiveFSSansTestFS, []int{kOpenImplicitDirFile, kOpenDirFreshEntries, kStatPrefixMissing, kStatImplicitDirName})
+)
+
+// rawFile is a file entry at the path with drawn content; rawDir a directory entry with a
+// trailing slash.
+func rawFile(p string) hegel.Generator[rawEntry] {
+	return hegel.Map(fileData, func(data []byte) rawEntry { return rawEntry{Name: p, Kind: 'f', Data: data, Mode: 0o644} })
+}
+
+func rawDir(p string) rawEntry { return rawEntry{Name: p + "/", Kind: 'd', Mode: 0o755} }
+
+// twoNames is two names of the raw pool, the second not the first.
+var twoNames = hegel.FlatMap(evenHalves(rawNames...), func(a string) hegel.Generator[[]string] {
+	return hegel.Map(evenHalves(rawNames...), func(b string) []string {
+		if b == a {
+			b += ".x"
+		}
+		return []string{a, b}
+	})
+})
+
+// strictRaw is the population of a narrow property's past region: every parent explicit and
+// before its contents, no "./" prefix, no prefix probe, paging only - nothing of 4, 5, 6, 7
+// or 8 but the injected entries' own shape.
+func strictRaw(inject []rawEntry, zip hegel.Generator[bool]) rawParams {
+	return rawParams{Zip: zip, ExplicitAll: true, InOrder: true, Prefixes: hegel.Just(false), Rest: hegel.Just(false), Inject: inject}
+}
+
+// --------------------------------------------------------------------------- archives/4
+
+// lateDirCases: a file under a directory with no entry of its own (the parents left
+// implicit, the order drawn: an implicit or a late directory), the rest of the wide
+// population around it; past the shape the directory's entry first and the strict
+// population. The classifier confirms the shape (an implicit directory is Opened fresh in
+// every case; 4 is the family's first id). Judged past 7 (every nested entry names the root
+// after indexing, and the surroundings' implicit directories) and 8 (TestFS's lines on any
+// non-empty archive).
+var lateDirCases = regionOf("archives/4", archiveFSPast78, hegel.FlatMap(twoNames, func(n []string) hegel.Generator[archiveFSCase] {
+	return hegel.FlatMap(rawFile(n[0]+"/"+n[1]), func(f rawEntry) hegel.Generator[archiveFSCase] {
+		p := rawParams{Zip: dieCoin(40), ExplicitNone: true, DotSlashW: 15, Prefixes: hegel.Just(false), Rest: hegel.Just(false), Inject: []rawEntry{f}}
+		if hzNoKnown {
+			p = strictRaw([]rawEntry{rawDir(n[0]), f}, dieCoin(40))
+		}
+		return rawCasesWith(p)
+	})
+}))
+
+// TestHegelFreshOpenOfLateDirectoriesIsADirectory: ArchiveFS.Open of a directory before the
+// index is built is a directory file whether or not the archive has an entry for it and
+// wherever that entry is; archives/4 returns the first descendant it meets, opened as the
+// directory, when the directory's entry is missing or comes after a descendant. Judged past
+// archives/7 and 8.
+func TestHegelFreshOpenOfLateDirectoriesIsADirectory(t *testing.T) {
+	judged(t, lateDirCases, archiveFSJudgeOver(archiveFSPast78, nil, false))
+}
+
+// --------------------------------------------------------------------------- archives/5
+
+// wrongChildCases: an explicit directory first, then a file in a subdirectory of it: the
+// subdirectory with no entry of its own (half), or with an entry and the file spelt with a
+// "./" prefix (the skip list holds the raw names: the file's raw name is not under the
+// subdirectory's); the entries ordered parents first (a late parent is 4's shape, left out
+// of the judgement but taking the parent's listing with it), the parents left implicit; past
+// the shape the subdirectory's entry in place, the file spelt clean, and the strict
+// population. Judged past 4, 6, 7 and 8 (the implicit directories of the surroundings, the
+// probes, TestFS).
+var wrongChildCases = regionOf("archives/5", archiveFSPast4678, hegel.FlatMap(twoNames, func(n []string) hegel.Generator[archiveFSCase] {
+	return hegel.FlatMap(evenHalves(rawNames...), func(leaf string) hegel.Generator[archiveFSCase] {
+		return hegel.FlatMap(dieCoin(50), func(dotSlash bool) hegel.Generator[archiveFSCase] {
+			child := n[0] + "/" + n[1] + "/" + leaf
+			inject := []rawEntry{rawDir(n[0])}
+			if dotSlash {
+				child = "./" + child
+				inject = append(inject, rawDir(n[0]+"/"+n[1]))
+			}
+			return hegel.FlatMap(rawFile(child), func(f rawEntry) hegel.Generator[archiveFSCase] {
+				p := rawParams{Zip: dieCoin(40), ExplicitNone: true, InOrder: true, DotSlashW: 15, Prefixes: hegel.Just(false), Rest: hegel.Just(false), Inject: append(inject, f)}
+				if hzNoKnown {
+					f.Name = n[0] + "/" + n[1] + "/" + leaf
+					p = strictRaw([]rawEntry{rawDir(n[0]), rawDir(n[0] + "/" + n[1]), f}, dieCoin(40))
+				}
+				return rawCasesWith(p)
+			})
+		})
+	})
+}))
+
+// TestHegelFreshOpenListsOnlyChildren: a directory file opened before the index is built
+// lists the directory's own children, a subdirectory once by name whether or not the archive
+// has an entry for it, and the entries spelt "./" by their cleaned names; archives/5 lists
+// the files of an implicit or late subdirectory, and the "./"-spelt files of a subdirectory
+// whose entry is spelt clean (or the other way round), as the directory's own children (the
+// skip list of Extract compares raw names).
+func TestHegelFreshOpenListsOnlyChildren(t *testing.T) {
+	judged(t, wrongChildCases, archiveFSJudgeOver(archiveFSPast4678, nil, false))
+}
+
+// --------------------------------------------------------------------------- archives/6
+
+// prefixProbeCases: the wide population with a file of a name of two characters or more
+// (its base name shortened by one is a string prefix of the entry's clean name, which the
+// probe asks Stat for) and the prefix probes on (off past the shape). Judged past 4, 5, 7
+// and 8.
+var prefixProbeCases = regionOf("archives/6", archiveFSPast4578, hegel.FlatMap(evenHalves("c.txt", "d.zip", "e.tar", "h i", "j.jpg", "l.bak"), func(name string) hegel.Generator[archiveFSCase] {
+	return hegel.FlatMap(rawFile(name), func(f rawEntry) hegel.Generator[archiveFSCase] {
+		return rawCasesWith(rawParams{Zip: dieCoin(40), DotSlashW: 15, Prefixes: hegel.Just(hzShaped(true, false)), Rest: hegel.Just(false), Inject: []rawEntry{f}})
+	})
+}))
+
+// TestHegelFreshStatOfPrefixesIsNotExist: ArchiveFS.Stat of a name the archive does not hold
+// is fs.ErrNotExist before the index is built as after it; archives/6 answers an implicit
+// directory for a name that is a string prefix of some entry's clean name ("a/b" for
+// "a/bc.txt", "e.ta" for "e.tar"), the path-separator guard of Open's handler missing.
+func TestHegelFreshStatOfPrefixesIsNotExist(t *testing.T) {
+	judged(t, prefixProbeCases, archiveFSJudgeOver(archiveFSPast4578, nil, false))
+}
+
+// --------------------------------------------------------------------------- archives/7
+
+// implicitNameCases: a file two directories down with no entry for either (the parents left
+// implicit; the order drawn), the wide population around it: Stat fresh of the lower
+// directory names it by its path, Stat indexed of the upper by the lower's name. Past the
+// shape a flat archive (the file at the root, the strict population kept at the root): the
+// index names the root after the first nested entry, so the region past 7 has no nested
+// entry at all. Judged past 4, 5, 6 and 8.
+var implicitNameCases = regionOf("archives/7", archiveFSPast4568, hegel.FlatMap(twoNames, func(n []string) hegel.Generator[archiveFSCase] {
+	return hegel.FlatMap(evenHalves(rawNames...), func(leaf string) hegel.Generator[archiveFSCase] {
+		return hegel.FlatMap(rawFile(n[0]+"/"+n[1]+"/"+leaf), func(f rawEntry) hegel.Generator[archiveFSCase] {
+			p := rawParams{Zip: dieCoin(40), ExplicitNone: true, DotSlashW: 15, Prefixes: hegel.Just(false), Rest: hegel.Just(false), Inject: []rawEntry{f}}
+			if hzNoKnown {
+				f.Name = leaf
+				p = strictRaw([]rawEntry{f}, dieCoin(40))
+				p.Flat = true
+			}
+			return rawCasesWith(p)
+		})
+	})
+}))
+
+// TestHegelImplicitDirectoriesHaveBaseNames: Stat of a directory the archive has no entry for
+// gives a FileInfo named by the directory's base name, before and after the index is built,
+// and the root directory file is named "." whenever it is opened; archives/7 names the
+// implicit directory by its full path before (the handler's fallback) and, after, by the
+// name of the next path segment of the first entry two levels below it (the index loop
+// stores implicitDirInfo{base} under the parent's path), or by its full path when none - and
+// the root, once indexed, by the first segment of the first nested entry.
+func TestHegelImplicitDirectoriesHaveBaseNames(t *testing.T) {
+	judged(t, implicitNameCases, archiveFSJudgeOver(archiveFSPast4568, nil, false))
+}
+
+// --------------------------------------------------------------------------- archives/8
+
+// dirRestCases: the wide population with an entry (the root directory file has a child) and
+// the directory files read as ReadDir(1) then ReadDir(-1) (paged one by one to the end past
+// the shape). Judged past 4, 5, 6 and 7 on the model without the TestFS check (its lines are
+// the same bug).
+var dirRestCases = regionOf("archives/8", archiveFSPast4567, hegel.FlatMap(evenHalves(rawNames...), func(name string) hegel.Generator[archiveFSCase] {
+	return hegel.FlatMap(rawFile(name), func(f rawEntry) hegel.Generator[archiveFSCase] {
+		return rawCasesWith(rawParams{Zip: dieCoin(40), DotSlashW: 15, Prefixes: hegel.Just(false), Rest: hegel.Just(hzShaped(true, false)), Inject: []rawEntry{f}})
+	})
+}))
+
+// TestHegelDirectoryFilesReadTheRest: a directory file's ReadDir(n <= 0) after ReadDir(1)
+// returns the children not yet read; archives/8 returns them all again.
+func TestHegelDirectoryFilesReadTheRest(t *testing.T) {
+	judged(t, dirRestCases, archiveFSJudgeOver(archiveFSPast4567, nil, true))
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..cda2737
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,227 @@
+package hegel
+
+// Hegel property tests for mholt/archives, written for the Hegel zoo. See
+// targets/go/archives/README.md. They live in a package of their own (hegel/) and drive the
+// public API: FilesFromFS/FilesFromDisk, the Archive/Extract/Insert methods of Tar and Zip
+// (alone and under every compression format), Identify, ArchiveFS, FileSystem and DeepFS.
+//
+// Oracles: the generated tree itself (what went into an archive must come out of it, by
+// name, kind, content, link target and mode), the io/fs contract (testing/fstest.TestFS and a
+// model of the tree as a file system), the package's documentation of the name mapping and of
+// Identify, and Python's tarfile/zipfile as an independent reader of the archives written.
+//
+// Two harnesses coexist while the rewrite to the combinator style proceeds in parts. The
+// new one (hegel_zoo_idioms_test.go, hegel_zoo_judge_test.go) carries TestHegelFilesFrom
+// (hegel_zoo_files_test.go), TestHegelDeepFS (hegel_zoo_deep_test.go), TestHegelIdentify
+// (hegel_zoo_identify_test.go), TestHegelCompression (hegel_zoo_compression_test.go) and the
+// narrow properties of their recorded bugs (hegel_zoo_shapes_test.go): cases are records
+// drawn from package-level generators, a pure model states the documented values with the
+// replicas of the recorded bugs threaded on a switch set (`known`, all off by default), and
+// a judge names the shape of a failing case; HEGEL_NO_KNOWN=1 switches the shapes off. This
+// file and hegel_zoo_gen_test.go, hegel_zoo_props_test.go are the OLD harness (its names
+// carry the hzOld prefix where the new one took the name) for the properties not yet
+// rewritten (Insert, part 4's) and the pins: the switches in HZKnown are
+// gates, all on by default, read by those.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOldOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzOldProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOldOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzOldProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOldOpts()...)
+}
+
+func hzOldDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzOldChance(tc hegel.TestCase, pct int) bool { return hzOldDrawInt(tc, 1, 100) <= pct }
+
+func hzOldPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzOldCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzOldCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzOldNewCollector(t *testing.T) *hzOldCollector {
+	c := &hzOldCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzOldCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		for k, v := range hzAvoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, v))
+		}
+		hzAvoided = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzOldCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzOldCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzOldCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// hzEntryNames is the names of directory entries, in order (the pins read it).
+func hzEntryNames(ents []fs.DirEntry) []string {
+	var ns []string
+	for _, e := range ents {
+		ns = append(ns, e.Name())
+	}
+	return ns
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. While a switch is on
+// the generators keep away from the behaviour (and count the avoidance); the pins assert the
+// documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	zipXzHeaderOffset          bool // Zip{Compression: ZipMethodXz} writes the xz stream header before each entry's local header, and no reader can open the entries
+	lz4CompressionLevel        bool // (read by nothing since part 3) Lz4{CompressionLevel: n} with n in 1..9 fails to open a writer: the level is passed as the library's bit-flag constant
+	zipEmptyStreamMatch        bool // (read by nothing since part 3) an empty zip (PK\x05\x06) is not matched by stream: Zip.Match reads the stream once per candidate header instead of comparing the same bytes
+	dirFileReadDirRest         bool // (read by nothing since part 3) the directory files of ArchiveFS return all their entries from ReadDir(n <= 0), not the remaining ones
+	openImplicitDirFile        bool // (read by nothing since part 3) ArchiveFS.Open of an implicit directory before the index is built returns its first descendant file opened as the directory
+	openDirFreshEntries        bool // (read by nothing since part 3) ArchiveFS.Open of a directory before the index is built lists as its children the files of subdirectories that have no entry or whose entry comes after them, and files whose names start with ./
+	statImplicitDirName        bool // (read by nothing since part 3) ArchiveFS.Stat of an implicit directory returns its full path as Name() before the index is built, and a child's name after
+	statPrefixMissing          bool // (read by nothing since part 3) ArchiveFS.Stat of a missing name that is a prefix of an entry's name returns an implicit directory before the index is built
+	tarInsertBlockAligned      bool // Tar.Insert after an archive whose last entry's size is a multiple of 512 (an empty file, a directory, a link, an empty archive) leaves a zero block before the new entries, and the archive no longer reads past it
+	zipInsertDirStops          bool // Zip.Insert returns after a directory entry, and the files after it are not inserted
+	zipInsertStores            bool // Zip.Insert without SelectiveCompression stores the files, whatever Compression says
+	zipInsertCustomMethod      bool // Zip.Insert with SelectiveCompression and Compression Bzip2, Zstd or Xz fails: the updater does not know the methods the package registers
+	zipInsertSymlink           bool // Zip.Insert opens a symbolic link's target and stores its content as the link's, instead of the target path Archive stores; a dangling link fails the insertion
+	fsRootDotLeadingSlash      bool // (read by nothing since part 1) FilesFromFS/FilesFromDisk with the in-archive root "." give names with a leading slash
+	fsTrailingSlashKey         bool // (read by nothing since part 1) FilesFromFS with a key ending in a slash fails (fs paths cannot end in a slash), though documented as enumerating the directory's contents
+	fsFollowSymlinkRelative    bool // (read by nothing since part 1) FilesFromFS with FollowSymlinks resolves a relative link target from the root of the fs.FS, not from the link's directory as FilesFromDisk does
+	identifyNondeterministic   bool // (read by nothing since part 2) Identify iterates the formats in map order: when the file name and the stream point at different formats, the answer varies from call to call
+	pathContainsArchiveCase    bool // (read by nothing since part 1) PathContainsArchive compares the extensions case-sensitively while PathIsArchive and SplitPath lower-case the path
+	brotliMatchTruncated       bool // (read by nothing since part 2) Brotli.Match rejects a stream longer than 1 KiB whose first kibibyte does not decode to its end: the decoder's truncation error counts as no match, and Identify finds no format
+	deepFSDirNamedArchive      bool // (read by nothing since part 1) a directory named like an archive (dir.zip) is treated by DeepFS as an archive, and the archives inside it are listed as plain files, not walked
+	lzipEmptyStream            bool // (read by nothing since part 2) Lzip's writer closed without a Write produces a stream without the LZIP header, which Lzip's reader rejects
+	fsTrailingKeyValue         bool // (read by nothing since part 1) FilesFromDisk with a key ending in a separator and a non-empty value adds the directory itself, and drops the first path element of the value
+	splitPathFirstSegment      bool // (read by nothing since part 1) DeepFS.SplitPath skips the first character of the path, so a first segment that is only an archive extension (.zip) is not split
+	identifyLzipTruncatedPanic bool // (read by nothing since part 2) Identify panics (slice bounds) on a truncated lzip stream: the lzip reader used to look inside it for an archive panics on short input
+	fsFollowDirLink            bool // (read by nothing since part 1) FilesFromFS with FollowSymlinks fails on a link to a directory: the directory is looked up by its own path inside fs.Sub of itself
+	followAncestorLinkHang     bool // (read by nothing since part 1) FilesFromDisk and FilesFromFS with FollowSymlinks recurse without end on a link to an ancestor directory (ln -s . self): the link is found again inside the directory it points at
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
