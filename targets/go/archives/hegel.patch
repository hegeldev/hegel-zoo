+// relativeLinkCases: FollowSymlinks on, a link in a directory whose relative target names a
+// file beside it ("t"), a file at the root ("t" where only the root has it) or a file at the
+// root through "../t"; past the shape, the link at the root. Values without ".", keys
+// without a trailing slash (14, 15 and 16 would be named first); the tree's other links
+// removed (a dangling one earlier in the walk ends both sides alike, a link to a directory is
+// archives/18: the strict pool). The target's name is fresh (it must not replace an entry).
+var relativeLinkCases = regionOf("archives/17", filesExpectedAt, hegel.FlatMap(hegel.FlatMap(fileTrees, aDirIn), func(tree []fileEntry) hegel.Generator[filesCase] {
+	tree = withoutLinks(tree, true)
+	return hegel.FlatMap(evenHalves(dirsOf(tree)...), func(d string) hegel.Generator[filesCase] {
+		return hegel.FlatMap(entryName, func(linkName string) hegel.Generator[filesCase] {
+			return hegel.FlatMap(entryName, func(target string) hegel.Generator[filesCase] {
+				target = freshName(tree, d, target, linkName)
+				// where the file is and what the link says
+				kinds := halvesOver([]int{1, 1, 1}, "beside", "root", "root via ..")
+				return hegel.FlatMap(kinds, func(kind string) hegel.Generator[filesCase] {
+					filePath, link := d+"/"+target, target
+					switch kind {
+					case "root":
+						filePath = target
+					case "root via ..":
+						filePath, link = target, "../"+target
+					}
+					linkPath := hzShaped(d+"/"+linkName, linkName)
+					if linkPath == linkName {
+						filePath, link = target, target // past the shape: a root link to a root file
+						if entryAt(tree, linkName) != nil {
+							linkPath += ".l" // not in place of an entry (the key's directory)
+						}
+					}
+					return hegel.FlatMap(aFile(filePath), func(f fileEntry) hegel.Generator[filesCase] {
+						t := withEntry(withEntry(tree, f), fileEntry{Path: linkPath, Kind: 'l', Link: link, Mode: 0o777, Fallback: "nowhere"})
+						return hegel.FlatMap(evenHalves(".", d), func(key string) hegel.Generator[filesCase] {
+							return caseOf(t, key, plainValues, hegel.Just(true))
+						})
+					})
+				})
+			})
+		})
+	})
