+// --------------------------------------------------------------------------- Insert
+
+// TestHegelInsert: files inserted into an existing Tar or Zip archive come out of Extract after
+// the archive's own entries (Zip: replacing entries of the same name), and the archive stays
+// readable.
+func TestHegelInsert(t *testing.T) {
+	c := hzOldNewCollector(t)
+	hzOldProperty(t, func(ht *hegel.T) {
+		base := hzGenTree(ht, 6)
+		extra := hzGenTree(ht, 4)
+		baseFiles, err := archives.FilesFromFS(hzCtx, hzMapFS(base), nil, nil)
+		if err != nil {
+			ht.Fatalf("FilesFromFS: %v", err)
+		}
+		extraFiles, err := archives.FilesFromFS(hzCtx, hzMapFS(extra), nil, nil)
+		if err != nil {
+			ht.Fatalf("FilesFromFS: %v", err)
+		}
+		archival := hzArchival(ht)
+		c.count(hzFormatName(archival))
+		_, isZip := archival.(archives.Zip)
+		if !isZip && HZKnown.tarInsertBlockAligned {
+			aligned := len(baseFiles) == 0
+			if n := len(baseFiles); n > 0 {
+				last := baseFiles[n-1]
+				aligned = !last.Mode().IsRegular() || last.Size()%512 == 0
+			}
+			if aligned {
+				hzAvoid("tarInsertBlockAligned")
+				return
+			}
+		}
+		if isZip && HZKnown.zipInsertDirStops {
+			for _, e := range extraFiles {
+				if e.IsDir() {
+					hzAvoid("zipInsertDirStops")
+					return
+				}
+			}
+		}
+		if zf, ok := archival.(archives.Zip); ok && zf.Compression != zip.Store && zf.Compression != zip.Deflate && zf.SelectiveCompression && HZKnown.zipInsertCustomMethod {
+			hzAvoid("zipInsertCustomMethod")
+			return
+		}
+		if isZip && HZKnown.zipInsertSymlink {
+			for _, e := range extraFiles {
+				if e.Mode()&fs.ModeSymlink != 0 {
+					hzAvoid("zipInsertSymlink")
+					return
+				}
+			}
+		}
+		var buf bytes.Buffer
+		if err := archival.Archive(hzCtx, &buf, baseFiles); err != nil {
+			if strings.Contains(err.Error(), "USTAR cannot encode") {
+				c.count("archive: USTAR cannot encode a name (by design)")
+				return
+			}
+			c.failClass(ht, "archive error", "%s Archive: %v", hzFormatName(archival), err)
+			return
+		}
+		rw := &hzBuffer{buf: append([]byte(nil), buf.Bytes()...)}
+		if err := archival.(archives.Inserter).Insert(hzCtx, rw, extraFiles); err != nil {
+			if strings.Contains(err.Error(), "USTAR cannot encode") {
+				c.count("insert: USTAR cannot encode a name (by design)")
+				return
+			}
+			kind := "tar"
+			if isZip {
+				kind = "zip"
+			}
+			c.failClass(ht, "insert error "+kind, "%s Insert: %v\nbase:\n%sextra:\n%s", hzFormatName(archival), err, hzTreeString(base), hzTreeString(extra))
+			return
+		}
+		got, err := hzExtractAll(archival, rw.buf)
+		if err != nil {
+			c.failClass(ht, "extract error", "%s Extract after Insert: %v (%d entries read)\nbase:\n%sextra:\n%s", hzFormatName(archival), err, len(got), hzTreeString(base), hzTreeString(extra))
+			return
+		}
+		// the model: base entries (Zip: minus those replaced), then the extra ones
+		var want []archives.FileInfo
+		for _, b := range baseFiles {
+			replaced := false
+			if isZip {
+				for _, e := range extraFiles {
+					if hzZipName(e) == hzZipName(b) {
+						replaced = true
+					}
+				}
+			}
+			if !replaced {
+				want = append(want, b)
+			}
+		}
+		want = append(want, extraFiles...)
+		if len(got) != len(want) {
+			c.failClass(ht, "entry count", "%s: %d entries expected after Insert, %d read\nwant %v\ngot %v", hzFormatName(archival), len(want), len(got), hzFileNames(want), hzGotNames(got))
+			return
+		}
+		for i, in := range want {
+			out := got[i]
+			where := fmt.Sprintf("%s entry %d (%q) after Insert", hzFormatName(archival), i, in.NameInArchive)
+			if strings.TrimSuffix(out.name, "/") != in.NameInArchive {
+				c.failClass(ht, "name", "%s: name %q", where, out.name)
+				continue
+			}
+			if out.isDir != in.IsDir() {
+				c.failClass(ht, "kind", "%s: IsDir %v", where, out.isDir)
+				continue
+			}
+			if inLink := in.Mode()&fs.ModeSymlink != 0; inLink || out.isLink {
+				if out.isLink != inLink || out.link != in.LinkTarget {
+					c.failClass(ht, "link", "%s: symlink %v -> %q in, %v -> %q out", where, inLink, in.LinkTarget, out.isLink, out.link)
+				}
+			}
+			if !in.IsDir() && in.Mode()&fs.ModeSymlink == 0 {
+				r, _ := in.Open()
+				content, _ := io.ReadAll(r)
+				r.Close()
+				if !bytes.Equal(out.data, content) {
+					c.failClass(ht, "content", "%s: %d bytes in, %d out", where, len(content), len(out.data))
+				}
+			}
+			if h, ok := out.header.(kzip.FileHeader); ok {
+				zf := archival.(archives.Zip)
+				wantMethod := zf.Compression
+				if in.IsDir() || (zf.SelectiveCompression && hzCompressedExt(in.NameInArchive)) {
+					wantMethod = zip.Store
+				}
+				inserted := i >= len(want)-len(extraFiles)
+				if inserted && !zf.SelectiveCompression && h.Method == zip.Store && wantMethod != zip.Store && HZKnown.zipInsertStores {
+					hzAvoid("zipInsertStores")
+				} else if h.Method != wantMethod {
+					c.failClass(ht, fmt.Sprintf("zip method inserted=%v", inserted), "%s: method %d wanted, %d written", where, wantMethod, h.Method)
+				}
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_shapes_test.go b/hegel/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..99e23bc
--- /dev/null
+++ b/hegel/hegel_zoo_shapes_test.go
@@ -0,0 +1,404 @@
+package hegel
+
+// The narrow properties: one per recorded bug of the FilesFrom and DeepFS families, each a
+// generator over the bug's shape region with random surroundings (the ingredient forced; the
+// shapes of the earlier ids it would otherwise be named by excluded: the strict pools), judged
+// by the family's expected function and judge; each fails every run by default with the shape
+// of its bug, and under HEGEL_NO_KNOWN=1 draws the neighbouring region (hzShaped) and passes.
+
+import (
+	"io/fs"
+	"strings"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the tree builders
+
+// withEntry is the tree with e added (an entry at the same path replaced in place, and the
+// entries below it dropped when the replacement is not a directory), settled.
+func withEntry(tree []fileEntry, e fileEntry) []fileEntry {
+	out := make([]fileEntry, 0, len(tree)+1)
+	replaced := false
+	for _, x := range tree {
+		switch {
+		case x.Path == e.Path:
+			out = append(out, e)
+			replaced = true
+		case e.Kind != 'd' && strings.HasPrefix(x.Path, e.Path+"/"):
+			continue
+		default:
+			out = append(out, x)
+		}
+	}
+	if !replaced {
+		out = append(out, e)
+	}
+	return settle(out)
+}
+
+// withoutLinks is the tree without its links below the root (the shapes of archives/17 and
+// 27 live there) or, when all, without any link.
+func withoutLinks(tree []fileEntry, all bool) []fileEntry {
+	var out []fileEntry
+	for _, e := range tree {
+		if e.Kind == 'l' && (all || strings.Contains(e.Path, "/")) {
+			continue
+		}
+		out = append(out, e)
+	}
+	return out
+}
+
+// dirsWithChildren is the directories of the tree that hold an entry.
+func dirsWithChildren(tree []fileEntry) []string {
+	var out []string
+	for _, d := range dirsOf(tree) {
+		for _, e := range tree {
+			if strings.HasPrefix(e.Path, d+"/") {
+				out = append(out, d)
+				break
+			}
+		}
+	}
+	return out
+}
+
+// aDir is a directory entry at p with a drawn mode and time; aFile a file entry at p with
+// drawn content, mode and time.
+func aDir(p string) hegel.Generator[fileEntry] {
+	return hegel.FlatMap(dirMode, func(m fs.FileMode) hegel.Generator[fileEntry] {
+		return hegel.Map(entryTime, func(mt time.Time) fileEntry { return fileEntry{Path: p, Kind: 'd', Mode: m, Mtime: mt} })
+	})
+}
+
+func aFile(p string) hegel.Generator[fileEntry] {
+	return hegel.FlatMap(fileData, func(data []byte) hegel.Generator[fileEntry] {
+		return hegel.FlatMap(fileMode, func(m fs.FileMode) hegel.Generator[fileEntry] {
+			return hegel.Map(entryTime, func(mt time.Time) fileEntry { return fileEntry{Path: p, Kind: 'f', Data: data, Mode: m, Mtime: mt} })
+		})
+	})
+}
+
+// aDirIn is the tree with a directory in it: one of its own when it has one, else a new one
+// at the root (a drawn name).
+func aDirIn(tree []fileEntry) hegel.Generator[[]fileEntry] {
+	if len(dirsOf(tree)) > 0 {
+		return hegel.Just(tree)
+	}
+	return hegel.FlatMap(entryName, func(name string) hegel.Generator[[]fileEntry] {
+		return hegel.Map(aDir(name), func(d fileEntry) []fileEntry { return withEntry(tree, d) })
+	})
+}
+
+// freshName is name, or name with ".t" when the tree has an entry of that name at the root
+// or in dir (the target of a link must not replace one).
+func freshName(tree []fileEntry, dir, name, other string) string {
+	if name == other || entryAt(tree, name) != nil || entryAt(tree, dir+"/"+name) != nil {
+		return name + ".t"
+	}
+	return name
+}
+
+// plainValues is the values without "." (the shape of archives/14 with a key that has no
+// trailing slash).
+var plainValues = halvesOver([]int{2, 1, 1, 1, 1}, "", "x", "x/", "x/y", "x/y/")
+
+// caseOf is the case: the value and FollowSymlinks drawn by the generators given, ClearAttributes at 30.
+func caseOf(tree []fileEntry, key string, value hegel.Generator[string], follow hegel.Generator[bool]) hegel.Generator[filesCase] {
+	return hegel.FlatMap(value, func(v string) hegel.Generator[filesCase] {
+		return hegel.FlatMap(follow, func(f bool) hegel.Generator[filesCase] {
+			return hegel.Map(dieCoin(30), func(clear bool) filesCase { return buildFilesCase(tree, key, v, f, clear) })
+		})
+	})
+}
+
+// --------------------------------------------------------------------------- archives/14
+
+// dotValueCases: a key without a trailing slash (the root, or a directory holding an entry)
+// with the value "." (the shape; "" past it), a tree with at least one entry.
+var dotValueCases = regionOf("archives/14", filesExpectedAt, hegel.FlatMap(fileTrees, func(tree []fileEntry) hegel.Generator[filesCase] {
+	filled := hegel.Just(tree)
+	if len(tree) == 0 {
+		filled = hegel.Map(entryAmong(nil), func(e fileEntry) []fileEntry { return settle([]fileEntry{e}) })
+	}
+	return hegel.FlatMap(filled, func(tree []fileEntry) hegel.Generator[filesCase] {
+		keys := append([]string{"."}, dirsWithChildren(tree)...)
+		return hegel.FlatMap(evenHalves(keys...), func(key string) hegel.Generator[filesCase] {
+			return caseOf(tree, key, hegel.Just(hzShaped(".", "")), dieCoin(30))
+		})
+	})
+}))
+
+// TestHegelDotValuesGiveRelativeNames: with the value "." (the root of the archive) on a key
+// without a trailing slash, the entries below the key are named by their path below it;
+// archives/14 gives them a leading slash.
+func TestHegelDotValuesGiveRelativeNames(t *testing.T) {
+	judged(t, dotValueCases, filesJudgeWith(filesRoot(t), filesExpectedAt, nil))
+}
+
+// --------------------------------------------------------------------------- archives/15
+
+// trailingKeyCases: a directory key with a trailing slash (without one past the shape), a
+// value without "." (archives/14 would be named first).
+var trailingKeyCases = regionOf("archives/15", filesExpectedAt, hegel.FlatMap(hegel.FlatMap(fileTrees, aDirIn), func(tree []fileEntry) hegel.Generator[filesCase] {
+	return hegel.FlatMap(evenHalves(dirsOf(tree)...), func(d string) hegel.Generator[filesCase] {
+		return caseOf(tree, d+hzShaped("/", ""), plainValues, dieCoin(30))
+	})
+}))
+
+// TestHegelTrailingSlashKeysEnumerateOnFS: FilesFromFS on a key ending in a slash enumerates
+// the directory's contents as documented; archives/15 fails to open the key.
+func TestHegelTrailingSlashKeysEnumerateOnFS(t *testing.T) {
+	judged(t, trailingKeyCases, filesJudgeWith(filesRoot(t), filesExpectedAt, nil))
+}
+
+// --------------------------------------------------------------------------- archives/16
+
+// pastTrailingSlash is the model without the checks archives/15 changes on its own (the fs
+// side of a trailing key): the disk side's view.
+var pastTrailingSlash = pastSwitches(filesExpectedAt, []int{kFsTrailingSlashKey})
+
+// trailingValueCases: a directory key with a trailing slash and a non-empty value (the value
+// "" past the shape).
+var trailingValueCases = regionOf("archives/16", pastTrailingSlash, hegel.FlatMap(hegel.FlatMap(fileTrees, aDirIn), func(tree []fileEntry) hegel.Generator[filesCase] {
+	return hegel.FlatMap(evenHalves(dirsOf(tree)...), func(d string) hegel.Generator[filesCase] {
+		return caseOf(tree, d+"/", hzShaped(halvesOver([]int{1, 1, 1, 1}, "x", "x/", "x/y", "x/y/"), hegel.Just("")), dieCoin(30))
+	})
+}))
+
+// TestHegelTrailingSlashKeysKeepTheValue: FilesFromDisk on a key ending in a separator puts
+// the directory's contents under the value, without the directory itself; archives/16 drops
+// the value's first element and adds the directory. The fs side is left out of the judgement
+// (archives/15 would be named first).
+func TestHegelTrailingSlashKeysKeepTheValue(t *testing.T) {
+	judged(t, trailingValueCases, filesJudgeWith(filesRoot(t), pastTrailingSlash, nil))
+}
+
+// --------------------------------------------------------------------------- archives/17
+
+// relativeLinkCases: FollowSymlinks on, a link in a directory whose relative target names a
+// file beside it ("t"), a file at the root ("t" where only the root has it) or a file at the
+// root through "../t"; past the shape, the link at the root. Values without ".", keys
+// without a trailing slash (14, 15 and 16 would be named first); the tree's other links
+// removed (a dangling one earlier in the walk ends both sides alike, a link to a directory is
+// archives/18: the strict pool). The target's name is fresh (it must not replace an entry).
+var relativeLinkCases = regionOf("archives/17", filesExpectedAt, hegel.FlatMap(hegel.FlatMap(fileTrees, aDirIn), func(tree []fileEntry) hegel.Generator[filesCase] {
+	tree = withoutLinks(tree, true)
+	return hegel.FlatMap(evenHalves(dirsOf(tree)...), func(d string) hegel.Generator[filesCase] {
+		return hegel.FlatMap(entryName, func(linkName string) hegel.Generator[filesCase] {
+			return hegel.FlatMap(entryName, func(target string) hegel.Generator[filesCase] {
+				target = freshName(tree, d, target, linkName)
+				// where the file is and what the link says
+				kinds := halvesOver([]int{1, 1, 1}, "beside", "root", "root via ..")
+				return hegel.FlatMap(kinds, func(kind string) hegel.Generator[filesCase] {
+					filePath, link := d+"/"+target, target
+					switch kind {
+					case "root":
+						filePath = target
+					case "root via ..":
+						filePath, link = target, "../"+target
+					}
+					linkPath := hzShaped(d+"/"+linkName, linkName)
+					if linkPath == linkName {
+						filePath, link = target, target // past the shape: a root link to a root file
+						if entryAt(tree, linkName) != nil {
+							linkPath += ".l" // not in place of an entry (the key's directory)
+						}
+					}
+					return hegel.FlatMap(aFile(filePath), func(f fileEntry) hegel.Generator[filesCase] {
+						t := withEntry(withEntry(tree, f), fileEntry{Path: linkPath, Kind: 'l', Link: link, Mode: 0o777, Fallback: "nowhere"})
+						return hegel.FlatMap(evenHalves(".", d), func(key string) hegel.Generator[filesCase] {
+							return caseOf(t, key, plainValues, hegel.Just(true))
+						})
+					})
+				})
+			})
+		})
+	})
+}))
+
+// TestHegelRelativeLinksResolveFromTheirDirectory: with FollowSymlinks, a link's relative
+// target is resolved from the link's directory, as the file system does; archives/17 resolves
+// it from the root of the fs.FS.
+func TestHegelRelativeLinksResolveFromTheirDirectory(t *testing.T) {
+	judged(t, relativeLinkCases, filesJudgeWith(filesRoot(t), filesExpectedAt, nil))
+}
+
+// --------------------------------------------------------------------------- archives/18
+
+// dirLinkCases: FollowSymlinks on, a link at the root to a directory of the root (past the
+// shape, to a file); the key the root; the tree without any other link (a relative link
+// below the root is archives/17, named first; the root's own links to directories would be
+// the shape too, and a link to a link blurs it). The target is a fresh name (a directory
+// with the tree's entries under it when the name was a directory already).
+var dirLinkCases = regionOf("archives/18", filesExpectedAt, hegel.FlatMap(fileTrees, func(tree []fileEntry) hegel.Generator[filesCase] {
+	tree = withoutLinks(tree, true)
+	return hegel.FlatMap(entryName, func(linkName string) hegel.Generator[filesCase] {
+		return hegel.FlatMap(entryName, func(target string) hegel.Generator[filesCase] {
+			if target == linkName || (entryAt(tree, target) != nil && entryAt(tree, target).Kind != 'd') {
+				target += ".t"
+			}
+			targetEntry := aDir(target)
+			if hzShaped(false, true) {
+				targetEntry = aFile(target)
+			}
+			return hegel.FlatMap(targetEntry, func(te fileEntry) hegel.Generator[filesCase] {
+				t := withEntry(withEntry(tree, te), fileEntry{Path: linkName, Kind: 'l', Link: target, Mode: 0o777, Fallback: "nowhere"})
+				return caseOf(t, ".", plainValues, hegel.Just(true))
+			})
+		})
+	})
+}))
+
+// TestHegelDirectoryLinksAreFollowedOnFS: with FollowSymlinks, FilesFromFS gathers a link to a
+// directory as that directory and its contents under the link's name; archives/18 looks the
+// directory up inside fs.Sub of itself and fails.
+func TestHegelDirectoryLinksAreFollowedOnFS(t *testing.T) {
+	judged(t, dirLinkCases, filesJudgeWith(filesRoot(t), filesExpectedAt, nil))
+}
+
+// --------------------------------------------------------------------------- archives/27
+
+// pastFollowOnFS is the model without the checks archives/17 and 18 change on their own: the
+// fs side's resolution and expansion of a followed link. On the fs side every link to an
+// ancestor is also the shape of 18 (its directory looked up inside fs.Sub of itself, by the
+// documented resolution of "."), so the wide property names 18 (or 17) for such a case; the
+// narrow property of 27 is judged on what is left: whether each side returns, and the disk
+// side.
+var pastFollowOnFS = pastSwitches(filesExpectedAt, []int{kFsFollowSymlinkRelative, kFsFollowDirLink})
+
+// ancestorLinkCases: FollowSymlinks on, a link in a directory to "." - its own directory,
+// an ancestor of itself (past the shape, to a file beside it); the key the root or that
+// directory; the tree without any other link (a loop through a link to a link is the same
+// shape, a link to a directory is 18). Only the "." target is the region: ".." and a path to
+// an ancestor are archives/17 on the fs side (the target as written is invalid or resolved
+// from the root) and named first even past the fs checks of 17 (the disk side differs too).
+var ancestorLinkCases = regionOf("archives/27", pastFollowOnFS, hegel.FlatMap(hegel.FlatMap(fileTrees, aDirIn), func(tree []fileEntry) hegel.Generator[filesCase] {
+	tree = withoutLinks(tree, true)
+	return hegel.FlatMap(evenHalves(dirsOf(tree)...), func(d string) hegel.Generator[filesCase] {
+		return hegel.FlatMap(entryName, func(linkName string) hegel.Generator[filesCase] {
+			return hegel.FlatMap(entryName, func(sibling string) hegel.Generator[filesCase] {
+				sibling = freshName(tree, d, sibling, linkName)
+				link := fileEntry{Path: d + "/" + linkName, Kind: 'l', Link: hzShaped(".", sibling), Mode: 0o777, Fallback: "nowhere"}
+				filled := hegel.Just(tree)
+				if hzNoKnown {
+					filled = hegel.Map(aFile(d+"/"+sibling), func(f fileEntry) []fileEntry { return withEntry(tree, f) })
+				}
+				return hegel.FlatMap(filled, func(tree []fileEntry) hegel.Generator[filesCase] {
+					return hegel.FlatMap(evenHalves(".", d), func(key string) hegel.Generator[filesCase] {
+						return caseOf(withEntry(tree, link), key, plainValues, hegel.Just(true))
+					})
+				})
+			})
+		})
+	})
+}))
+
+// ancestorLinkCount is the case count of TestHegelAncestorLinksReturn: every case calls the
+// library in two child processes (one per side) that die of their capped stack within
+// milliseconds, but each is a test binary started afresh (about 90 ms), so the property runs
+// a fifth of the default count (HEGEL_TEST_CASES scales it) and its shrink is capped at
+// ancestorLinkAttempts failing attempts (two children each).
+const (
+	ancestorLinkCount    = 20
+	ancestorLinkAttempts = 40
+)
+
+// TestHegelAncestorLinksReturn: with FollowSymlinks, a call that meets a link to an ancestor
+// directory returns (what it returns is left open); archives/27 recurses without end on
+// both sides.
+func TestHegelAncestorLinksReturn(t *testing.T) {
+	judgedWithCount(t, ancestorLinkCount, ancestorLinkAttempts, ancestorLinkCases, filesJudgeWith(filesRoot(t), pastFollowOnFS, nil))
+}
+
+// --------------------------------------------------------------------------- archives/21
+
+// upperExtPaths is a made-up path with an upper-cased archive extension (lower-cased past
+// the shape).
+var upperExtPaths = hegel.FlatMap(evenHalves(hzArchiveExts...), func(ext string) hegel.Generator[string] {
+	return hegel.FlatMap(evenHalves("a", "x/a", "A", "/x/a", "a b"), func(stem string) hegel.Generator[string] {
+		return hegel.Map(evenHalves("", "/x", "/x/y", "/"), func(rest string) string {
+			if hzShaped(true, false) {
+				ext = strings.ToUpper(ext)
+			}
+			return stem + ext + rest
+		})
+	})
+})
+
+// upperExtCases: a DeepFS case whose made-up path has an upper-cased archive extension.
+var upperExtCases = regionOf("archives/21", deepExpected, deepCasesWith(treesOf(6), upperExtPaths, false))
+
+// TestHegelPathContainsArchiveIgnoresCase: PathContainsArchive, documented as the same lexical
+// test as PathIsArchive and SplitPath, finds an archive extension whatever its case;
+// archives/21 compares case-sensitively.
+func TestHegelPathContainsArchiveIgnoresCase(t *testing.T) {
+	judged(t, upperExtCases, deepJudgeWith(filesRoot(t)))
+}
+
+// --------------------------------------------------------------------------- archives/22
+
+// extAlonePaths is a made-up path whose first segment is exactly an archive extension (past
+// the shape, a name with the extension), lower case (archives/21 would be named first). The
+// path does not end in a slash: SplitPath's scan and the documented split agree on ".zip/"
+// (an empty inner path either way).
+var extAlonePaths = hegel.FlatMap(evenHalves(hzArchiveExts...), func(ext string) hegel.Generator[string] {
+	return hegel.Map(evenHalves("", "/a", "/a/b"), func(rest string) string {
+		return hzShaped("", "x") + ext + rest
+	})
+})
+
+// extAloneCases: a DeepFS case of the strict pool (no upper-cased form) whose made-up path
+// begins with an extension alone.
+var extAloneCases = regionOf("archives/22", deepExpected, deepCasesWith(treesOf(6), extAlonePaths, true))
+
+// TestHegelSplitPathSplitsTheFirstSegment: SplitPath splits at the first segment that is an
+// archive, even one that is only the extension; archives/22 starts its scan at the second
+// character and misses it.
+func TestHegelSplitPathSplitsTheFirstSegment(t *testing.T) {
+	judged(t, extAloneCases, deepJudgeWith(filesRoot(t)))
+}
+
+// --------------------------------------------------------------------------- archives/23
+
+// madeUpLower is the made-up paths without the shapes of 21 and 22.
+var madeUpLower = halvesOver([]int{1, 1, 1, 1, 1, 1, 1}, "a.zip/b.tar/c", "a.tar.gz", "a.tgz/", "/a/b.tar.zst/c/d", "x.zip /y", "a.tar.gzip", "a/.tar/b")
+
+// archiveNamedDirCases: a DeepFS case of the strict pool with a directory named like an
+// archive (named plainly past the shape) holding an archive, at the root or in a directory.
+var archiveNamedDirCases = regionOf("archives/23", deepExpected, hegel.FlatMap(treesOf(6), func(tree []fileEntry) hegel.Generator[deepCase] {
+	parent := hegel.Just("")
+	if ds := dirsOf(tree); len(ds) > 0 {
+		parent = dieChoice(hzW(50, hegel.Just("")), hzW(50, evenHalves(ds...)))
+	}
+	return hegel.FlatMap(parent, func(par string) hegel.Generator[deepCase] {
+		return hegel.FlatMap(evenHalves("d", "a b", "x.y"), func(stem string) hegel.Generator[deepCase] {
+			return hegel.FlatMap(evenHalves(hzArchiveExts...), func(ext string) hegel.Generator[deepCase] {
+				dirPath := stem + hzShaped(ext, "")
+				if par != "" {
+					dirPath = par + "/" + dirPath
+				}
+				return hegel.FlatMap(aDir(dirPath), func(de fileEntry) hegel.Generator[deepCase] {
+					t := withEntry(tree, de)
+					return hegel.FlatMap(archiveAt(hegel.Just(dirPath)), func(inside deepArchive) hegel.Generator[deepCase] {
+						return hegel.FlatMap(countedHalves(archiveAmong(dirsOf(t)), 0, 3), func(archs []deepArchive) hegel.Generator[deepCase] {
+							return hegel.Map(madeUpLower, func(mu string) deepCase {
+								return buildDeepCase(t, append([]deepArchive{inside}, archs...), mu, true)
+							})
+						})
+					})
+				})
+			})
+		})
+	})
+}))
+
+// TestHegelDirectoriesNamedLikeArchivesAreWalked: DeepFS walks a real directory named like an
+// archive as a directory, the archives in it as directories of their entries; archives/23
+// reads it through a DirFS that lists those archives as plain files.
+func TestHegelDirectoriesNamedLikeArchivesAreWalked(t *testing.T) {
+	judged(t, archiveNamedDirCases, deepJudgeWith(filesRoot(t)))
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
