+
+// archives/23
+func TestHegelPinDeepFSDirNamedArchive(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "d.zip"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	data := hzPinArchive(t, archives.Tar{}, hzPinFiles(t, map[string]string{"f.txt": "f"}))
+	if err := os.WriteFile(filepath.Join(dir, "d.zip", "inner.tar"), data, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	var visited []string
+	fs.WalkDir(&archives.DeepFS{Root: dir}, ".", func(p string, d fs.DirEntry, err error) error {
+		visited = append(visited, p)
+		return err
+	})
+	if fmt.Sprint(visited) != "[. d.zip d.zip/inner.tar d.zip/inner.tar/f.txt]" {
+		t.Fatalf("DeepFS walk: %v, want the archive inside the directory d.zip walked", visited)
+	}
+}
+
+// archives/24
+func TestHegelPinLzipEmptyStream(t *testing.T) {
+	var buf bytes.Buffer
+	w, err := archives.Lzip{}.OpenWriter(&buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.Close()
+	r, err := archives.Lzip{}.OpenReader(bytes.NewReader(buf.Bytes()))
+	if err == nil {
+		_, err = io.ReadAll(r)
+	}
+	if err != nil {
+		t.Fatalf("the %d-byte stream Lzip writes for no input does not read back: %v", buf.Len(), err)
+	}
+}
+
+// archives/25
+func TestHegelPinBrotliMatchTruncated(t *testing.T) {
+	data := make([]byte, 4000)
+	rand.New(rand.NewSource(1)).Read(data)
+	var buf bytes.Buffer
+	w, _ := archives.Brotli{}.OpenWriter(&buf)
+	w.Write(data)
+	w.Close()
+	mr, err := archives.Brotli{}.Match(context.Background(), "", bytes.NewReader(buf.Bytes()))
+	if err != nil || !mr.ByStream {
+		t.Fatalf("Brotli.Match on a %d-byte brotli stream of random data: %v, %v", buf.Len(), mr, err)
+	}
+}
+
+// archives/26
+func TestHegelPinIdentifyTgzByName(t *testing.T) {
+	f, _, err := archives.Identify(context.Background(), "x.tgz", nil)
+	if err != nil {
+		t.Fatalf("Identify(\"x.tgz\", nil): %v, while PathIsArchive(\"x.tgz\") is %v", err, archives.PathIsArchive("x.tgz"))
+	}
+	if f.Extension() != ".tar.gz" {
+		t.Fatalf("Identify(\"x.tgz\", nil): %s", f.Extension())
+	}
+}
+
+// archives/27
+func TestHegelPinFollowAncestorLinkHang(t *testing.T) {
+	if os.Getenv("HZ_ARCHIVES_CHILD") == "1" {
+		// the child: a directory holding a file and a link to the directory itself
+		dir := t.TempDir()
+		if err := os.MkdirAll(filepath.Join(dir, "d"), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "d", "f.txt"), []byte("f"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Symlink(".", filepath.Join(dir, "d", "self")); err != nil {
+			t.Fatal(err)
+		}
+		files, err := archives.FilesFromDisk(context.Background(), &archives.FromDiskOptions{FollowSymlinks: true}, map[string]string{dir: ""})
+		fmt.Printf("RETURNED %d files, err %v\n", len(files), err)
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run", "^TestHegelPinFollowAncestorLinkHang$", "-test.timeout", "8s")
+	cmd.Env = append(os.Environ(), "HZ_ARCHIVES_CHILD=1")
+	out, err := cmd.CombinedOutput()
+	if !bytes.Contains(out, []byte("RETURNED")) {
+		t.Fatalf("FilesFromDisk with FollowSymlinks on d/self -> . did not return within 8s (%v): it recurses into the link's own directory without end", err)
+	}
+}
+
+// archives/28
+func TestHegelPinIdentifyLzipHeaderSeekability(t *testing.T) {
+	data := []byte("LZIP") // an lzip stream cut inside its six-byte header
+	kind := func(r io.Reader) string {
+		_, _, err := archives.Identify(context.Background(), "", r)
+		if err == nil {
+			return "no error"
+		}
+		s := err.Error()
+		if i := strings.Index(s, ": "); strings.HasPrefix(s, "matching ") && i > 0 {
+			s = s[i+2:] // the archival name before it varies by map order (archives/19)
+		}
+		return s
+	}
+	seekable := kind(bytes.NewReader(data))
+	buffered := kind(struct{ io.Reader }{bytes.NewReader(data)})
+	if seekable != buffered {
+		t.Fatalf("Identify(\"\", \"LZIP\") fails with %q on a seekable stream and with %q on a buffered one", seekable, buffered)
+	}
+}
diff --git a/hegel/hegel_zoo_props_test.go b/hegel/hegel_zoo_props_test.go
new file mode 100644
index 0000000..b336320
--- /dev/null
+++ b/hegel/hegel_zoo_props_test.go
@@ -0,0 +1,189 @@
+package hegel
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"io/fs"
+	"strings"
+	"testing"
+
+	kzip "github.com/klauspost/compress/zip"
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+var hzCtx = context.Background()
+
+func hzTreeString(t *hzTree) string {
+	var b strings.Builder
+	for _, e := range t.entries {
+		fmt.Fprintf(&b, "%c %q mode %o", e.kind, e.path, e.mode)
+		if e.kind == 'f' {
+			fmt.Fprintf(&b, " (%d bytes)", len(e.data))
+		}
+		if e.kind == 'l' {
+			fmt.Fprintf(&b, " -> %q", e.link)
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+func hzFileNames(fs []archives.FileInfo) []string {
+	var ns []string
+	for _, f := range fs {
+		ns = append(ns, f.NameInArchive)
+	}
+	return ns
+}
+
+// hzZipName is the name Zip writes for a FileInfo.
+func hzZipName(f archives.FileInfo) string {
+	if f.IsDir() {
+		return f.NameInArchive + "/"
+	}
+	return f.NameInArchive
+}
+
+// --------------------------------------------------------------------------- Insert
+
+// TestHegelInsert: files inserted into an existing Tar or Zip archive come out of Extract after
+// the archive's own entries (Zip: replacing entries of the same name), and the archive stays
+// readable.
+func TestHegelInsert(t *testing.T) {
+	c := hzOldNewCollector(t)
+	hzOldProperty(t, func(ht *hegel.T) {
+		base := hzGenTree(ht, 6)
+		extra := hzGenTree(ht, 4)
+		baseFiles, err := archives.FilesFromFS(hzCtx, hzMapFS(base), nil, nil)
+		if err != nil {
+			ht.Fatalf("FilesFromFS: %v", err)
+		}
+		extraFiles, err := archives.FilesFromFS(hzCtx, hzMapFS(extra), nil, nil)
+		if err != nil {
+			ht.Fatalf("FilesFromFS: %v", err)
+		}
+		archival := hzArchival(ht)
+		c.count(hzFormatName(archival))
+		_, isZip := archival.(archives.Zip)
+		if !isZip && HZKnown.tarInsertBlockAligned {
+			aligned := len(baseFiles) == 0
+			if n := len(baseFiles); n > 0 {
+				last := baseFiles[n-1]
+				aligned = !last.Mode().IsRegular() || last.Size()%512 == 0
+			}
+			if aligned {
+				hzAvoid("tarInsertBlockAligned")
+				return
+			}
+		}
+		if isZip && HZKnown.zipInsertDirStops {
+			for _, e := range extraFiles {
+				if e.IsDir() {
+					hzAvoid("zipInsertDirStops")
+					return
+				}
+			}
+		}
+		if zf, ok := archival.(archives.Zip); ok && zf.Compression != zip.Store && zf.Compression != zip.Deflate && zf.SelectiveCompression && HZKnown.zipInsertCustomMethod {
+			hzAvoid("zipInsertCustomMethod")
+			return
+		}
+		if isZip && HZKnown.zipInsertSymlink {
+			for _, e := range extraFiles {
+				if e.Mode()&fs.ModeSymlink != 0 {
+					hzAvoid("zipInsertSymlink")
+					return
+				}
+			}
+		}
+		var buf bytes.Buffer
+		if err := archival.Archive(hzCtx, &buf, baseFiles); err != nil {
+			if strings.Contains(err.Error(), "USTAR cannot encode") {
+				c.count("archive: USTAR cannot encode a name (by design)")
+				return
+			}
+			c.failClass(ht, "archive error", "%s Archive: %v", hzFormatName(archival), err)
+			return
+		}
+		rw := &hzBuffer{buf: append([]byte(nil), buf.Bytes()...)}
+		if err := archival.(archives.Inserter).Insert(hzCtx, rw, extraFiles); err != nil {
+			if strings.Contains(err.Error(), "USTAR cannot encode") {
+				c.count("insert: USTAR cannot encode a name (by design)")
+				return
+			}
+			kind := "tar"
+			if isZip {
+				kind = "zip"
+			}
+			c.failClass(ht, "insert error "+kind, "%s Insert: %v\nbase:\n%sextra:\n%s", hzFormatName(archival), err, hzTreeString(base), hzTreeString(extra))
+			return
+		}
+		got, err := hzExtractAll(archival, rw.buf)
+		if err != nil {
+			c.failClass(ht, "extract error", "%s Extract after Insert: %v (%d entries read)\nbase:\n%sextra:\n%s", hzFormatName(archival), err, len(got), hzTreeString(base), hzTreeString(extra))
+			return
+		}
+		// the model: base entries (Zip: minus those replaced), then the extra ones
+		var want []archives.FileInfo
+		for _, b := range baseFiles {
+			replaced := false
+			if isZip {
+				for _, e := range extraFiles {
+					if hzZipName(e) == hzZipName(b) {
+						replaced = true
+					}
+				}
+			}
+			if !replaced {
+				want = append(want, b)
+			}
+		}
+		want = append(want, extraFiles...)
+		if len(got) != len(want) {
+			c.failClass(ht, "entry count", "%s: %d entries expected after Insert, %d read\nwant %v\ngot %v", hzFormatName(archival), len(want), len(got), hzFileNames(want), hzGotNames(got))
+			return
+		}
+		for i, in := range want {
+			out := got[i]
+			where := fmt.Sprintf("%s entry %d (%q) after Insert", hzFormatName(archival), i, in.NameInArchive)
+			if strings.TrimSuffix(out.name, "/") != in.NameInArchive {
+				c.failClass(ht, "name", "%s: name %q", where, out.name)
+				continue
+			}
+			if out.isDir != in.IsDir() {
+				c.failClass(ht, "kind", "%s: IsDir %v", where, out.isDir)
+				continue
+			}
+			if inLink := in.Mode()&fs.ModeSymlink != 0; inLink || out.isLink {
+				if out.isLink != inLink || out.link != in.LinkTarget {
+					c.failClass(ht, "link", "%s: symlink %v -> %q in, %v -> %q out", where, inLink, in.LinkTarget, out.isLink, out.link)
+				}
+			}
+			if !in.IsDir() && in.Mode()&fs.ModeSymlink == 0 {
+				r, _ := in.Open()
+				content, _ := io.ReadAll(r)
+				r.Close()
+				if !bytes.Equal(out.data, content) {
+					c.failClass(ht, "content", "%s: %d bytes in, %d out", where, len(content), len(out.data))
+				}
+			}
+			if h, ok := out.header.(kzip.FileHeader); ok {
+				zf := archival.(archives.Zip)
+				wantMethod := zf.Compression
+				if in.IsDir() || (zf.SelectiveCompression && hzCompressedExt(in.NameInArchive)) {
+					wantMethod = zip.Store
+				}
+				inserted := i >= len(want)-len(extraFiles)
+				if inserted && !zf.SelectiveCompression && h.Method == zip.Store && wantMethod != zip.Store && HZKnown.zipInsertStores {
+					hzAvoid("zipInsertStores")
+				} else if h.Method != wantMethod {
+					c.failClass(ht, fmt.Sprintf("zip method inserted=%v", inserted), "%s: method %d wanted, %d written", where, wantMethod, h.Method)
+				}
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_roundtrip_test.go b/hegel/hegel_zoo_roundtrip_test.go
