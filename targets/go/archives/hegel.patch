+// archives/19
+func TestHegelPinIdentifyNondeterministic(t *testing.T) {
+	data := hzPinArchive(t, archives.Zip{}, hzPinFiles(t, map[string]string{"a.txt": "a"}))
+	// four hundred calls: the name's format wins about nine times in ten, so forty calls agree
+	// by chance about once in seventy runs
+	var first string
+	for i := 0; i < 400; i++ {
+		f, _, err := archives.Identify(context.Background(), "x.tar", bytes.NewReader(data))
+		r := fmt.Sprintf("err %v", err)
+		if err == nil {
+			r = f.Extension()
+		}
+		if i == 0 {
+			first = r
+		} else if r != first {
+			t.Fatalf("Identify(\"x.tar\", zip stream) gave %s, then %s", first, r)
+		}
+	}
+}
