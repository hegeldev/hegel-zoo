+// hzPinFS builds a MapFS: a key ending in "/" is a directory, a value starting with "-> " a
+// symbolic link to the rest, anything else a file with that content.
+func hzPinFS(m map[string]string) fstest.MapFS {
+	mfs := fstest.MapFS{}
+	for k, v := range m {
+		switch {
+		case len(k) > 0 && k[len(k)-1] == '/':
+			mfs[k[:len(k)-1]] = &fstest.MapFile{Mode: fs.ModeDir | 0o755}
+		case len(v) >= 3 && v[:3] == "-> ":
+			mfs[k] = &fstest.MapFile{Data: []byte(v[3:]), Mode: fs.ModeSymlink | 0o777}
+		default:
+			mfs[k] = &fstest.MapFile{Data: []byte(v), Mode: 0o644}
+		}
+	}
+	return mfs
+}
+
+func hzPinFiles(t *testing.T, m map[string]string) []archives.FileInfo {
+	t.Helper()
+	files, err := archives.FilesFromFS(context.Background(), hzPinFS(m), nil, nil)
+	if err != nil {
+		t.Fatalf("FilesFromFS: %v", err)
+	}
+	return files
+}
+
+func hzPinArchive(t *testing.T, f archives.Archiver, files []archives.FileInfo) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := f.Archive(context.Background(), &buf, files); err != nil {
+		t.Fatalf("Archive: %v", err)
+	}
+	return buf.Bytes()
+}
+
+// hzPinTar writes a tar by hand: "d/" a directory, "l:name:target" a link, "name=content" a file.
+func hzPinTar(entries ...string) []byte {
+	var buf bytes.Buffer
+	tw := tar.NewWriter(&buf)
+	for _, e := range entries {
+		h := &tar.Header{Mode: 0o644}
+		switch {
+		case e[len(e)-1] == '/':
+			h.Name, h.Typeflag, h.Mode = e, tar.TypeDir, 0o755
+		default:
+			i := bytes.IndexByte([]byte(e), '=')
+			h.Name, h.Typeflag, h.Size = e[:i], tar.TypeReg, int64(len(e)-i-1)
+			tw.WriteHeader(h)
+			tw.Write([]byte(e[i+1:]))
+			continue
+		}
+		tw.WriteHeader(h)
+	}
+	tw.Close()
+	return buf.Bytes()
+}
