index 0000000..51d7b4f
--- /dev/null
+++ b/hegel/hegel_zoo_roundtrip_test.go
@@ -0,0 +1,787 @@
+package hegel
+
+// The round-trip property: the case record (a tree, an archival format - part 2's archFormat
+// with the zip pool of the old hzArchival, the Xz method included -, a compression format for
+// a tar - part 2's compFormat with the Lz4 levels -, ClearAttributes), its generators, the
+// documented model with the replicas of the recorded bugs threaded on the switch set
+// (roundTripExpected, over part 2's Identify replica), the TestFS and Python helpers, and the
+// wide property.
+//
+// The model: a tree gathered with FilesFromFS (the whole tree, fs.WalkDir's order, the paths
+// as names) and written by Tar or Zip (Tar under a compression format too) comes back from
+// Extract entry for entry: the name (a zip directory's with a trailing slash, zip.go :150-152;
+// a tar's as given, tar.go :129), the kind, the link target, the content and size, the
+// permission bits, the time unless cleared, the tar header's format and owner as the options
+// say (tar.go :134-155; archive/tar's rules: a USTAR header for what USTAR can encode, PAX
+// records for the rest, GNU as asked), the zip method (Store for directories and, under
+// SelectiveCompression, for names with a compressed extension, zip.go :149-164). The
+// archiving itself is a check: archive/tar's "USTAR cannot encode" of a non-ASCII or
+// over-long name under the USTAR format is its documented limit (the model states it), and
+// Lz4's "invalid compression level" is archives/10. Identify names the format from the
+// bytes, named or not, seekable or not, and returns them whole (part 2's rules: an empty
+// tar is 1024 zero bytes, nothing to match - the README's "Not judged", open -; under a
+// compression it is the compression alone); fstest.TestFS accepts the archive as an
+// ArchiveFS; Python's tarfile and zipfile read the same entries. The checks: "gathered",
+// "archived" ("ok" or the error kind), "extracted" ("ok" or the error kind), "entries" (the
+// count), "entry <i>" (the entry's values), "identify <name> seekable=<b>" (the answer: the
+// extension, "NoMatch", "error: <kind>"), "identify returned" ("whole"), "testfs" (the
+// classes of TestFS's lines, "none"), "python" (the count, "python failed", or open where
+// python3 or a reader is missing) and "python <i>" (the entry as Python lists it).
+
+import (
+	"archive/tar"
+	"archive/zip"
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os/exec"
+	"path"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"testing/fstest"
+
+	kzip "github.com/klauspost/compress/zip"
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the records
+
+// roundTripCase is one case: the tree, the archival format, the compression of a tar (Kind
+// "" for none), ClearAttributes.
+type roundTripCase struct {
+	Tree  []fileEntry
+	Arch  archFormat
+	Comp  compFormat
+	Clear bool
+	notes []string // what the library left (the explanation of a failure)
+}
+
+func (c roundTripCase) GoString() string {
+	s := fmt.Sprintf("roundTripCase{%v", c.Arch)
+	if c.Comp.Kind != "" {
+		s += fmt.Sprintf(" under %v", c.Comp)
+	}
+	s += fmt.Sprintf(", ClearAttributes %v}\n%s", c.Clear, treeString(c.Tree))
+	for _, n := range c.notes {
+		s += "  " + n + "\n"
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- the generators
+
+// roundTripZipFormats: the method store 1, deflate 2, bzip2 1, zstd 1, xz 1 of six (the old
+// hzArchival's die; at the weights below the halving bits realised 17/28/19/18/18 at seed 7
+// and 20/31/16/22/11 at seed 8 over 3000 cases - the fair bits move five points between
+// seeds), xz at weight zero under HEGEL_NO_KNOWN=1 (the shape of archives/1),
+// SelectiveCompression at 30 (realised 32 and 30).
+var roundTripZipFormats = hegel.FlatMap(halvesOver([]int{4, 8, 4, 4, hzUnless(hzNoKnown, 4)}, zip.Store, zip.Deflate, uint16(archives.ZipMethodBzip2), uint16(archives.ZipMethodZstd), uint16(archives.ZipMethodXz)), func(m uint16) hegel.Generator[archFormat] {
+	return hegel.Map(dieCoin(30), func(sel bool) archFormat { return archFormat{Kind: "zip", ZipMethod: m, Selective: sel} })
+})
+
+// roundTripCases: a tar (part 2's tarFormats) or a zip half each (realised 52/48 and 52/48
+// at 3000 cases, seeds 7 and 8), a tree of up to ten entries (zip: of one to ten under
+// HEGEL_NO_KNOWN=1, the empty zip being the shape of archives/9; realised 7 percent empty,
+// 8 to 12 each from one to nine, 4 at ten), a tar under a compression format half the time
+// (realised 49 and 50 of the tars; part 2's compFormats: the Lz4 levels 1..9 are the shape
+// of archives/10, at weight zero under HEGEL_NO_KNOWN=1), ClearAttributes at 30 (realised
+// 30 and 29).
+var roundTripCases = hegel.FlatMap(halvesGens([]int{1, 1}, tarFormats, roundTripZipFormats), func(a archFormat) hegel.Generator[roundTripCase] {
+	trees := treesOf(10)
+	if hzNoKnown && a.Kind == "zip" {
+		trees = treesBetween(1, 10)
+	}
+	return hegel.FlatMap(trees, func(tree []fileEntry) hegel.Generator[roundTripCase] {
+		comp := hegel.Just(compFormat{})
+		if a.Kind == "tar" {
+			comp = dieMaybe(50, compFormats)
+		}
+		return hegel.FlatMap(comp, func(cf compFormat) hegel.Generator[roundTripCase] {
+			return hegel.Map(dieCoin(30), func(clear bool) roundTripCase {
+				return roundTripCase{Tree: tree, Arch: a, Comp: cf, Clear: clear}
+			})
+		})
+	})
+})
+
+// --------------------------------------------------------------------------- the entries
+
+// archiveEntries is the tree as FilesFromFS gathers it over the whole tree: every entry in
+// fs.WalkDir's order (lexical within a directory, a directory's contents right after it),
+// named by its path (part 1's model, the root itself not among them).
+func archiveEntries(tree []fileEntry) []fileEntry {
+	out := append([]fileEntry(nil), tree...)
+	sort.SliceStable(out, func(i, j int) bool { return walkKey(out[i].Path) < walkKey(out[j].Path) })
+	return out
+}
+
+// archiveName is the entry's name in the archive: a zip directory's ends in a slash.
+func archiveName(e fileEntry, a archFormat) string {
+	if a.Kind == "zip" && e.Kind == 'd' {
+		return e.Path + "/"
+	}
+	return e.Path
+}
+
+// zipMethodOf is the method Zip writes an entry with (zip.go :149-164): Store for a
+// directory, and under SelectiveCompression for a name whose lower-cased extension is in
+// compressedFormats (hzCompressedExt), else the format's.
+func zipMethodOf(e fileEntry, a archFormat) uint16 {
+	if e.Kind == 'd' || (a.Selective && hzCompressedExt(e.Path)) {
+		return zip.Store
+	}
+	return a.ZipMethod
+}
+
+// splitUSTAROK transcribes archive/tar's splitUSTARPath (writer.go :454-473): whether a name
+// over 100 bytes splits at a slash into a prefix of at most 155 and a suffix of at most 100.
+func splitUSTAROK(name string) bool {
+	const nameSize, prefixSize = 100, 155
+	length := len(name)
+	if length <= nameSize || !isASCIIName(name) {
+		return false
+	} else if length > prefixSize+1 {
+		length = prefixSize + 1
+	} else if name[length-1] == '/' {
+		length--
+	}
+	i := strings.LastIndex(name[:length], "/")
+	nlen := len(name) - i - 1
+	plen := i
+	return !(i <= 0 || nlen > nameSize || nlen == 0 || plen > prefixSize)
+}
+
+// ustarOK is whether USTAR can encode the entry (archive/tar common.go, allowedFormats: an
+// ASCII name of at most 100 bytes or one that splits, an ASCII link target of at most 100
+// bytes; the owner names of the pools are ASCII and under 32).
+func ustarOK(e fileEntry) bool {
+	nameOK := isASCIIName(e.Path) && (len(e.Path) <= 100 || splitUSTAROK(e.Path))
+	linkOK := isASCIIName(e.Link) && len(e.Link) <= 100
+	return nameOK && linkOK
+}
+
+// tarFormatOf is the format archive/tar reads back for the entry under the asked format
+// (common.go allowedFormats: a wanted PAX "implies USTAR", so the writer's switch in
+// writer.go WriteHeader takes USTAR whenever the entry allows it - an ASCII name of at most
+// 100 bytes or one that splits, an ASCII link target of at most 100 bytes - and PAX, with
+// its records, otherwise; the unknown format likewise, GNU always GNU; a PAX header without
+// records is a USTAR block, the README's "Not judged").
+func tarFormatOf(e fileEntry, a archFormat) string {
+	switch a.TarFormat {
+	case 1:
+		return "USTAR"
+	case 3:
+		return "GNU"
+	}
+	if ustarOK(e) {
+		return "USTAR"
+	}
+	return "PAX"
+}
+
+// entryValueOf spells an extracted entry as the checks compare it.
+func entryValueOf(e fileEntry, c roundTripCase) string {
+	s := fmt.Sprintf("%c name=%s", e.Kind, archiveName(e, c.Arch))
+	switch e.Kind {
+	case 'f':
+		s += fmt.Sprintf(" size=%d sha=%s", len(e.Data), sha8(e.Data))
+	case 'l':
+		s += fmt.Sprintf(" -> %q", e.Link)
+	}
+	s += fmt.Sprintf(" mode=%o %s", e.Mode.Perm(), roundTripTime(e.Mtime.Unix(), c.Clear))
+	if c.Arch.Kind == "tar" {
+		a := c.Arch
+		s += fmt.Sprintf(" format=%s owner=%d/%d/%q/%q", tarFormatOf(e, a), a.Uid, a.Gid, a.Uname, a.Gname)
+	} else {
+		s += fmt.Sprintf(" method=%d", zipMethodOf(e, c.Arch))
+	}
+	return s
+}
+
+func roundTripTime(unix int64, clear bool) string {
+	if clear {
+		return "mtime=-"
+	}
+	return "mtime=" + strconv.FormatInt(unix, 10)
+}
+
+// --------------------------------------------------------------------------- the model
+
+// roundTripBuilt is what the property built before the judgement: the gathered files, the
+// archive's bytes, the errors.
+type roundTripBuilt struct {
+	Files    []archives.FileInfo
+	Data     []byte
+	FilesErr error
+	ArchErr  error
+}
+
+// unreadableXz is the index of the first entry an archive written with ZipMethodXz cannot
+// give back (-1 for none): under kZipXzHeaderOffset (archives/1) every entry written through
+// the xz compressor - a file or a link not stored - has its local header offset pointing at
+// the 24-byte xz stream header the compressor emits at construction (zip.go :35-37 registers
+// ulikunitz/xz's NewWriter, archive/zip records the offset before the compressor is made),
+// and archive/zip's open of it fails with "not a valid zip file": a file when it is opened,
+// a link when Extract reads its target (zip.go :230-233).
+func unreadableXz(entries []fileEntry, c roundTripCase, k known) int {
+	if !k[kZipXzHeaderOffset] || c.Arch.Kind != "zip" {
+		return -1
+	}
+	for i, e := range entries {
+		if e.Kind != 'd' && zipMethodOf(e, c.Arch) == archives.ZipMethodXz {
+			return i
+		}
+	}
+	return -1
+}
+
+// identifyNames are the names Identify is asked under: none, the extension in lower and upper
+// case, a name without one.
+func identifyNames(c roundTripCase) []string {
+	ext := roundTripExt(c)
+	return []string{"", "x" + ext, "X" + strings.ToUpper(ext), "noext"}
+}
+
+func roundTripExt(c roundTripCase) string {
+	if c.Arch.Kind == "zip" {
+		return ".zip"
+	}
+	if c.Comp.Kind == "" {
+		return ".tar"
+	}
+	return ".tar" + c.Comp.Ext()
+}
+
+// identifyCheck is the check name of one call.
+func identifyCheck(name string, seekable bool) string {
+	if name == "" {
+		name = "(unnamed)"
+	}
+	return fmt.Sprintf("identify %s seekable=%v", name, seekable)
+}
+
+// roundTripStream is the idStream of the archive's bytes for the Identify replica: a zip or
+// a plain tar as they are (the archival formats match them by stream, tarByStream and
+// zipByStream), a compressed tar as its compression's own stream of a tar (an empty one
+// "emptytar").
+func roundTripStream(c roundTripCase, data []byte) idStream {
+	st := idStream{Bytes: data, InnerKind: "none"}
+	if c.Comp.Kind != "" {
+		st.Own, st.InnerKind = c.Comp.Kind, "tar"
+		if len(c.Tree) == 0 {
+			st.InnerKind = "emptytar"
+		}
+	}
+	return st
+}
+
+// identifyAnswers is the documented answer set of Identify for the stream under a name (part
+// 2's rule, identifyExpected): the name's answers, the stream's (identifyOutcomes, computed
+// once per model evaluation and passed in: it opens every third-party decoder on the bytes,
+// and the xz decoder allocates its dictionary - eight megabytes - before it rejects a
+// stream, faster than the collector frees them when a classification evaluates the model
+// once per switch), and the name's archive under the stream's compression; "error: <kind>"
+// for a decoder's error.
+func identifyAnswers(name string, stream idResult, k known) []string {
+	var answers []string
+	_, nameArchs := nameParts(identifyBase(name), k)
+	if name != "" {
+		for _, a := range nameAnswers(name, k) {
+			if a != "NoMatch" {
+				answers = append(answers, a)
+			}
+		}
+	}
+	for _, a := range stream.Answers {
+		switch {
+		case a == "NoMatch":
+		case a == "error":
+			for _, e := range stream.Errs {
+				answers = append(answers, "error: "+e)
+			}
+		default:
+			answers = append(answers, a)
+		}
+		if containsString(compKinds, strings.TrimPrefix(a, ".")) {
+			for _, arch := range nameArchs {
+				answers = append(answers, "."+arch+a)
+			}
+		}
+	}
+	if len(answers) == 0 {
+		answers = []string{"NoMatch"}
+	}
+	return uniqueStrings(answers)
+}
+
+// roundTripTestFS is the classes of TestFS's lines over the archive as an ArchiveFS: none
+// documented; under kDirFileReadDirRest (archives/8) "ReadDir at EOF" for every directory
+// with a child, so for any non-empty tree (TestFS returns from a directory there, so nothing
+// of a directory's later checks runs); under kZipXzHeaderOffset (archives/1) "open" for every
+// unreadable file (its Open fails in checkStat and checkFile), and when a link is unreadable
+// the root's Open (ReadDir's index reads link targets) fails: "open" and every expected name
+// "expected not found".
+func roundTripTestFS(entries []fileEntry, c roundTripCase, k known) string {
+	var classes []string
+	bad := unreadableXz(entries, c, k)
+	if bad >= 0 {
+		for _, e := range entries[bad:] {
+			if e.Kind == 'l' && zipMethodOf(e, c.Arch) == archives.ZipMethodXz {
+				return classesValue([]string{"open", "expected not found"})
+			}
+		}
+		classes = append(classes, "open")
+	}
+	if k[kDirFileReadDirRest] && len(entries) > 0 {
+		classes = append(classes, "ReadDir at EOF")
+	}
+	return classesValue(classes)
+}
+
+// pythonReader is the Python module that reads the archive: tarfile for a tar, plain or
+// under gz, bz2 or xz; zipfile for a zip (it lists every method and reads Store, Deflate and
+// Bzip2); "" for the rest.
+func pythonReader(c roundTripCase) string {
+	if c.Arch.Kind == "zip" {
+		return "zipfile"
+	}
+	switch c.Comp.Kind {
+	case "", "gz", "bz2", "xz":
+		return "tarfile"
+	}
+	return ""
+}
+
+// pythonReads is whether Python's zipfile decompresses the method.
+func pythonReads(method uint16) bool {
+	return method == zip.Store || method == zip.Deflate || method == archives.ZipMethodBzip2
+}
+
+// pythonEntryOf spells an entry as the Python script lists it: the name, kind, size, link
+// target and content hash (where it can read them), mode, and whether the local header is at
+// the recorded offset ("bad" under archives/1 for an entry written through the xz
+// compressor).
+func pythonEntryOf(e fileEntry, c roundTripCase, k known) string {
+	header := "ok"
+	readable := true
+	size := int64(0)
+	if c.Arch.Kind == "zip" {
+		m := zipMethodOf(e, c.Arch)
+		if k[kZipXzHeaderOffset] && e.Kind != 'd' && m == archives.ZipMethodXz {
+			header = "bad"
+		}
+		readable = header == "ok" && pythonReads(m)
+		if e.Kind == 'l' {
+			size = int64(len(e.Link))
+		}
+	}
+	if e.Kind == 'f' {
+		size = int64(len(e.Data))
+	}
+	link, sha := "-", "-"
+	if readable && e.Kind == 'l' {
+		link = e.Link
+	}
+	if readable && e.Kind == 'f' {
+		sha = hzSha(e.Data)
+	}
+	return fmt.Sprintf("name=%s kind=%c size=%d link=%s sha=%s mode=%o header=%s", archiveName(e, c.Arch), e.Kind, size, link, sha, e.Mode.Perm(), header)
+}
+
+// roundTripExpected states every value the property checks for the case under the switch
+// set, given the archive the property built.
+func roundTripExpected(c roundTripCase, k known, built roundTripBuilt) checks {
+	out := checks{}
+	out.set("gathered", "ok")
+	entries := archiveEntries(c.Tree)
+	// archives/10: the Lz4 writer of the construction fails to open (lz4.go :43-48)
+	if k[kLz4CompressionLevel] && c.Comp.Kind == "lz4" && c.Comp.Level != 0 {
+		out.set("archived", "error: invalid compression level")
+		return out
+	}
+	if c.Arch.Kind == "tar" && c.Arch.TarFormat == 1 {
+		for _, e := range entries {
+			if !ustarOK(e) {
+				out.set("archived", "error: USTAR cannot encode")
+				return out
+			}
+		}
+	}
+	out.set("archived", "ok")
+	bad := unreadableXz(entries, c, k)
+	if bad >= 0 {
+		out.set("extracted", "error: not a valid zip file")
+		out.set("entries", bad)
+	} else {
+		out.set("extracted", "ok")
+		out.set("entries", len(entries))
+	}
+	for i, e := range entries {
+		name := "entry " + strconv.Itoa(i)
+		if bad >= 0 && i >= bad {
+			out.unspecified(name)
+			continue
+		}
+		out.set(name, entryValueOf(e, c))
+	}
+	st := roundTripStream(c, built.Data)
+	open := c.Arch.Kind == "tar" && c.Comp.Kind == "" && len(c.Tree) == 0
+	var stream *idResult
+	for _, name := range identifyNames(c) {
+		for _, seekable := range []bool{true, false} {
+			check := identifyCheck(name, seekable)
+			switch {
+			case bad == 0:
+				// archives/1: the bytes begin with the xz stream header of the first entry,
+				// not a zip's local header; what Identify makes of them is not stated
+				out.unspecified(check)
+			case open && (name == "" || name == "noext"):
+				out.unspecified(check)
+			default:
+				if stream == nil {
+					r := identifyOutcomes("", st, k)
+					stream = &r
+				}
+				out[check] = hzSet(identifyAnswers(name, *stream, k)...)
+			}
+		}
+	}
+	out.set("identify returned", "whole")
+	out.set("testfs", roundTripTestFS(entries, c, k))
+	if hzPython() == "" || pythonReader(c) == "" {
+		out.unspecified("python")
+		return out
+	}
+	out.set("python", fmt.Sprintf("%d entries", len(entries)))
+	for i, e := range entries {
+		out.set("python "+strconv.Itoa(i), pythonEntryOf(e, c, k))
+	}
+	return out
+}
+
+func init() {
+	for i, name := range []string{"gathered", "archived", "extracted", "entries", "entry", "identify", "python"} {
+		checkRank[name] = 400 + i
+	}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// roundTripBuild gathers the tree with FilesFromFS and writes the archive (a CompressedArchive
+// under a compression).
+func roundTripBuild(c roundTripCase) roundTripBuilt {
+	ctx := context.Background()
+	files, err := archives.FilesFromFS(ctx, treeMapFS(c.Tree), &archives.FromFSOptions{ClearAttributes: c.Clear}, nil)
+	if err != nil {
+		return roundTripBuilt{FilesErr: err}
+	}
+	var buf bytes.Buffer
+	if err := roundTripFormat(c).(archives.Archiver).Archive(ctx, &buf, files); err != nil {
+		return roundTripBuilt{Files: files, ArchErr: err}
+	}
+	return roundTripBuilt{Files: files, Data: buf.Bytes()}
+}
+
+// roundTripFormat is the archives.Format of the case.
+func roundTripFormat(c roundTripCase) archives.Format {
+	if c.Comp.Kind == "" {
+		return c.Arch.Format()
+	}
+	t := c.Arch.Format().(archives.Tar)
+	return archives.CompressedArchive{Archival: t, Extraction: t, Compression: c.Comp.Format()}
+}
+
+// archiveErrKind is the kind of an archiver's or extractor's error: the texts the model
+// states, else the text.
+func archiveErrKind(err error) string {
+	s := err.Error()
+	for _, key := range []string{"invalid compression level", "USTAR cannot encode", "not a valid zip file"} {
+		if strings.Contains(s, key) {
+			return key
+		}
+	}
+	return s
+}
+
+// gotValue spells an extracted entry as entryValueOf does.
+func gotValue(g hzGot, c roundTripCase) string {
+	kind := byte('f')
+	switch {
+	case g.isDir:
+		kind = 'd'
+	case g.isLink:
+		kind = 'l'
+	}
+	s := fmt.Sprintf("%c name=%s", kind, g.name)
+	switch kind {
+	case 'f':
+		s += fmt.Sprintf(" size=%d sha=%s", g.size, sha8(g.data))
+	case 'l':
+		s += fmt.Sprintf(" -> %q", g.link)
+	}
+	s += fmt.Sprintf(" mode=%o %s", g.mode.Perm(), roundTripTime(g.mtime.Unix(), c.Clear))
+	switch h := g.header.(type) {
+	case *tar.Header:
+		s += fmt.Sprintf(" format=%s owner=%d/%d/%q/%q", h.Format, h.Uid, h.Gid, h.Uname, h.Gname)
+	case kzip.FileHeader:
+		s += fmt.Sprintf(" method=%d", h.Method)
+	default:
+		s += fmt.Sprintf(" header=%T", g.header)
+	}
+	return s
+}
+
+// roundTripActual asks the library the questions roundTripExpected answered.
+func roundTripActual(c *roundTripCase, built roundTripBuilt) checks {
+	out := checks{}
+	if built.FilesErr != nil {
+		out.set("gathered", "error: "+built.FilesErr.Error())
+		return out
+	}
+	out.set("gathered", "ok")
+	if built.ArchErr != nil {
+		out.set("archived", "error: "+archiveErrKind(built.ArchErr))
+		c.notes = append(c.notes, "Archive: "+built.ArchErr.Error())
+		return out
+	}
+	out.set("archived", "ok")
+	data := built.Data
+	format := roundTripFormat(*c)
+	got, err := hzExtractAll(format.(archives.Extractor), data)
+	if err != nil {
+		out.set("extracted", "error: "+archiveErrKind(err))
+		c.notes = append(c.notes, "Extract: "+err.Error())
+	} else {
+		out.set("extracted", "ok")
+	}
+	out.set("entries", len(got))
+	for i, g := range got {
+		out.set("entry "+strconv.Itoa(i), gotValue(g, *c))
+	}
+	ctx := context.Background()
+	var returned []string
+	for _, name := range identifyNames(*c) {
+		for _, seekable := range []bool{true, false} {
+			var r io.Reader = bytes.NewReader(data)
+			if !seekable {
+				r = struct{ io.Reader }{bytes.NewReader(data)}
+			}
+			var f archives.Format
+			var rest io.Reader
+			var ierr error
+			check := identifyCheck(name, seekable)
+			if p := hzCall(func() { f, rest, ierr = archives.Identify(ctx, name, r) }); p != nil {
+				out.set(check, "panic")
+				returned = append(returned, "panic")
+				c.notes = append(c.notes, fmt.Sprintf("Identify(%q, seekable %v) panicked: %v", name, seekable, p))
+				continue
+			}
+			switch {
+			case errors.Is(ierr, archives.NoMatch):
+				out.set(check, "NoMatch")
+			case ierr != nil:
+				out.set(check, "error: "+errKindOfText(stripMatching(ierr.Error())))
+				c.notes = append(c.notes, fmt.Sprintf("Identify(%q, seekable %v): %v", name, seekable, ierr))
+			default:
+				out.set(check, f.Extension())
+			}
+			back, rerr := io.ReadAll(rest)
+			switch {
+			case rerr != nil:
+				returned = append(returned, "read error: "+rerr.Error())
+			case !bytes.Equal(back, data):
+				returned = append(returned, fmt.Sprintf("%d bytes back", len(back)))
+			default:
+				returned = append(returned, "whole")
+			}
+		}
+	}
+	out["identify returned"] = hzSet(returned...)
+	afs := &archives.ArchiveFS{Stream: io.NewSectionReader(bytes.NewReader(data), 0, int64(len(data))), Format: format.(archives.Extractor)}
+	var expect []string
+	for _, e := range archiveEntries(c.Tree) {
+		expect = append(expect, e.Path)
+	}
+	terr := fstest.TestFS(afs, expect...)
+	out.set("testfs", classesValue(testFSClasses(terr)))
+	if terr != nil {
+		c.notes = append(c.notes, "TestFS: "+hzTrim(strings.ReplaceAll(terr.Error(), "\n", "\n  "), 1500))
+	}
+	if py := pythonReader(*c); py != "" && hzPython() != "" {
+		pythonChecks(c, py, data, out)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- python
+
+var (
+	hzPythonOnce sync.Once
+	hzPythonPath string
+)
+
+// hzPython is the python3 on the PATH, "" for none (looked up once).
+func hzPython() string {
+	hzPythonOnce.Do(func() {
+		if p, err := exec.LookPath("python3"); err == nil {
+			hzPythonPath = p
+		}
+	})
+	return hzPythonPath
+}
+
+// hzPyScript lists an archive with tarfile or zipfile: per member the name, kind, size, link
+// target, content hash, mode, and for a zip whether the local header is at the recorded
+// offset (the target and the hash only for the methods zipfile reads: Store, Deflate, Bzip2).
+const hzPyScript = `
+import sys, io, json, tarfile, zipfile, hashlib
+data = sys.stdin.buffer.read()
+out = []
+if sys.argv[1] == "tarfile":
+    with tarfile.open(fileobj=io.BytesIO(data), mode="r:*") as tf:
+        for m in tf:
+            kind = "d" if m.isdir() else "l" if m.issym() else "f" if m.isfile() else "?"
+            h = "-"
+            if kind == "f":
+                h = hashlib.sha256(tf.extractfile(m).read()).hexdigest()
+            link = m.linkname if kind == "l" else "-"
+            out.append({"name": m.name, "kind": kind, "size": m.size, "link": link, "sha": h, "mode": m.mode & 0o777, "header": "ok"})
+else:
+    with zipfile.ZipFile(io.BytesIO(data)) as zf:
+        for m in zf.infolist():
+            mode = (m.external_attr >> 16) & 0o170000
+            kind = "d" if m.is_dir() else "l" if mode == 0o120000 else "f"
+            header = "ok" if data[m.header_offset:m.header_offset+4] == b"PK\x03\x04" else "bad"
+            readable = header == "ok" and m.compress_type in (0, 8, 12)
+            h = "-"
+            link = "-"
+            if readable and kind == "f":
+                h = hashlib.sha256(zf.read(m)).hexdigest()
+            if readable and kind == "l":
+                link = zf.read(m).decode("utf-8", "replace")
+            out.append({"name": m.filename, "kind": kind, "size": m.file_size, "link": link, "sha": h, "mode": (m.external_attr >> 16) & 0o777, "header": header})
+json.dump(out, sys.stdout)
+`
+
+type hzPyEntry struct {
+	Name   string `json:"name"`
+	Kind   string `json:"kind"`
+	Size   int64  `json:"size"`
+	Link   string `json:"link"`
+	Sha    string `json:"sha"`
+	Mode   int    `json:"mode"`
+	Header string `json:"header"`
+}
+
+// pythonChecks runs the script and spells its listing as pythonEntryOf does.
+func pythonChecks(c *roundTripCase, module string, data []byte, out checks) {
+	cmd := exec.Command(hzPython(), "-c", hzPyScript, module)
+	cmd.Stdin = bytes.NewReader(data)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	raw, err := cmd.Output()
+	if err != nil {
+		out.set("python", "python failed")
+		c.notes = append(c.notes, fmt.Sprintf("python %s: %v: %s", module, err, hzTrim(lastLine(stderr.String()), 300)))
+		return
+	}
+	var got []hzPyEntry
+	if err := json.Unmarshal(raw, &got); err != nil {
+		out.set("python", "python output unreadable")
+		c.notes = append(c.notes, fmt.Sprintf("python output: %v: %s", err, hzTrim(string(raw), 300)))
+		return
+	}
+	out.set("python", fmt.Sprintf("%d entries", len(got)))
+	for i, g := range got {
+		out.set("python "+strconv.Itoa(i), fmt.Sprintf("name=%s kind=%s size=%d link=%s sha=%s mode=%o header=%s", g.Name, g.Kind, g.Size, g.Link, g.Sha, g.Mode, g.Header))
+	}
+}
+
+func lastLine(s string) string {
+	lines := strings.Split(strings.TrimSpace(s), "\n")
+	return lines[len(lines)-1]
+}
+
+func hzSha(b []byte) string {
+	s := sha256.Sum256(b)
+	return hex.EncodeToString(s[:])
+}
+
+// hzTrim cuts a text to n bytes with an ellipsis.
+func hzTrim(s string, n int) string {
+	if len(s) > n {
+		return s[:n] + "..."
+	}
+	return s
+}
+
+// hzCompressedExt mirrors zip.go's compressedFormats set (:388-425).
+func hzCompressedExt(name string) bool {
+	switch strings.ToLower(path.Ext(name)) {
+	case ".7z", ".avi", ".br", ".bz2", ".cab", ".docx", ".gif", ".gz", ".jar", ".jpeg", ".jpg", ".lz", ".lz4", ".lzma",
+		".m4v", ".mov", ".mp3", ".mp4", ".mpeg", ".mpg", ".png", ".pptx", ".rar", ".sz", ".tbz2", ".tgz", ".tsz", ".txz",
+		".xlsx", ".xz", ".zip", ".zipx":
+		return true
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- the property
+
+// roundTripJudgeOver is the judge of the family: the archive built with the library's
+// writers (the case's construction: its failure is the check "archived"), then the judgement
+// over roundTripExpected and roundTripActual. The checks the switches past change on their
+// own are left out (the narrow property of archives/1 is judged past 8: TestFS's lines on
+// any non-empty archive); under HEGEL_NO_KNOWN=1 the checks the switches drops change on
+// their own are dropped from a case rather than the case skipped (judgeByDropping: the wide
+// property drops 8's).
+func roundTripJudgeOver(past, drops []int) func(j *hzCaseJudge, c roundTripCase) {
+	return func(j *hzCaseJudge, c roundTripCase) {
+		hzTally("archival " + c.Arch.Kind)
+		if c.Arch.Kind == "zip" {
+			hzTally("zip method " + strconv.Itoa(int(c.Arch.ZipMethod)))
+		}
+		if c.Comp.Kind != "" {
+			hzTally("compression " + c.Comp.Kind)
+		}
+		hzTally("entries " + strconv.Itoa(len(c.Tree)))
+		built := roundTripBuild(c)
+		expected := func(c roundTripCase, k known) checks { return roundTripExpected(c, k, built) }
+		if len(past) > 0 {
+			expected = pastSwitches(expected, past)
+		}
+		actual := func(c *roundTripCase) checks { return roundTripActual(c, built) }
+		if len(drops) > 0 {
+			judgeByDropping(j, &c, expected, actual, drops)
+			return
+		}
+		judgeBy(j, &c, expected, actual)
+	}
+}
+
+// roundTripDrops are the switches whose checks the wide property drops under HEGEL_NO_KNOWN=1
+// rather than skipping the case: archives/8 marks TestFS's report on every non-empty archive.
+var roundTripDrops = []int{kDirFileReadDirRest}
+
+// TestHegelArchiveRoundTrip: a tree gathered with FilesFromFS, archived with Tar or Zip (Tar
+// also under every compression format), comes back from Extract entry for entry: names,
+// kinds, contents, link targets, permissions, times and the header fields the options set;
+// Identify names the format from the bytes and returns them unread; the archive is a file
+// system (ArchiveFS) that testing/fstest accepts; Python's tarfile and zipfile read the same
+// entries. The shapes of the recorded bugs (the Xz method, an Lz4 level, an empty zip,
+// ReadDir(-1) at the end of a directory) are drawn at their natural rates and fail naming the
+// first in id order; under HEGEL_NO_KNOWN=1 the Xz method, the Lz4 levels and the empty zip
+// are not drawn, the TestFS check is dropped from a case that still has 8's shape, and a case
+// the classifier still names is skipped by the judge.
+func TestHegelArchiveRoundTrip(t *testing.T) {
+	judged(t, roundTripCases, roundTripJudgeOver(nil, roundTripDrops))
+}
