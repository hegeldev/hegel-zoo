+// archives/9
+func TestHegelPinZipEmptyStreamMatch(t *testing.T) {
+	data := hzPinArchive(t, archives.Zip{}, nil)
+	f, _, err := archives.Identify(context.Background(), "", bytes.NewReader(data))
+	if err != nil {
+		t.Fatalf("Identify on an empty zip (% x): %v", data, err)
+	}
+	if f.Extension() != ".zip" {
+		t.Fatalf("Identify on an empty zip: %s", f.Extension())
+	}
+}
