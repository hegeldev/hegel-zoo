+
+// --------------------------------------------------------------------------- the tree builders
+
+// withEntry is the tree with e added (an entry at the same path replaced in place, and the
+// entries below it dropped when the replacement is not a directory), settled.
+func withEntry(tree []fileEntry, e fileEntry) []fileEntry {
+	out := make([]fileEntry, 0, len(tree)+1)
+	replaced := false
+	for _, x := range tree {
+		switch {
+		case x.Path == e.Path:
+			out = append(out, e)
+			replaced = true
+		case e.Kind != 'd' && strings.HasPrefix(x.Path, e.Path+"/"):
+			continue
+		default:
+			out = append(out, x)
+		}
+	}
+	if !replaced {
+		out = append(out, e)
+	}
+	return settle(out)
+}
+
+// withoutLinks is the tree without its links below the root (the shapes of archives/17 and
+// 27 live there) or, when all, without any link.
+func withoutLinks(tree []fileEntry, all bool) []fileEntry {
+	var out []fileEntry
+	for _, e := range tree {
+		if e.Kind == 'l' && (all || strings.Contains(e.Path, "/")) {
+			continue
+		}
+		out = append(out, e)
+	}
+	return out
+}
+
+// dirsWithChildren is the directories of the tree that hold an entry.
+func dirsWithChildren(tree []fileEntry) []string {
+	var out []string
+	for _, d := range dirsOf(tree) {
+		for _, e := range tree {
+			if strings.HasPrefix(e.Path, d+"/") {
+				out = append(out, d)
+				break
+			}
+		}
+	}
+	return out
+}
+
+// aDir is a directory entry at p with a drawn mode and time; aFile a file entry at p with
+// drawn content, mode and time.
+func aDir(p string) hegel.Generator[fileEntry] {
+	return hegel.FlatMap(dirMode, func(m fs.FileMode) hegel.Generator[fileEntry] {
+		return hegel.Map(entryTime, func(mt time.Time) fileEntry { return fileEntry{Path: p, Kind: 'd', Mode: m, Mtime: mt} })
+	})
+}
+
+func aFile(p string) hegel.Generator[fileEntry] {
+	return hegel.FlatMap(fileData, func(data []byte) hegel.Generator[fileEntry] {
+		return hegel.FlatMap(fileMode, func(m fs.FileMode) hegel.Generator[fileEntry] {
+			return hegel.Map(entryTime, func(mt time.Time) fileEntry { return fileEntry{Path: p, Kind: 'f', Data: data, Mode: m, Mtime: mt} })
+		})
+	})
+}
+
+// aDirIn is the tree with a directory in it: one of its own when it has one, else a new one
+// at the root (a drawn name).
+func aDirIn(tree []fileEntry) hegel.Generator[[]fileEntry] {
+	if len(dirsOf(tree)) > 0 {
+		return hegel.Just(tree)
+	}
+	return hegel.FlatMap(entryName, func(name string) hegel.Generator[[]fileEntry] {
+		return hegel.Map(aDir(name), func(d fileEntry) []fileEntry { return withEntry(tree, d) })
+	})
+}
+
+// freshName is name, or name with ".t" when the tree has an entry of that name at the root
+// or in dir (the target of a link must not replace one).
+func freshName(tree []fileEntry, dir, name, other string) string {
+	if name == other || entryAt(tree, name) != nil || entryAt(tree, dir+"/"+name) != nil {
+		return name + ".t"
+	}
+	return name
+}
+
+// plainValues is the values without "." (the shape of archives/14 with a key that has no
+// trailing slash).
+var plainValues = halvesOver([]int{2, 1, 1, 1, 1}, "", "x", "x/", "x/y", "x/y/")
+
+// caseOf is the case: the value and FollowSymlinks drawn by the generators given, ClearAttributes at 30.
+func caseOf(tree []fileEntry, key string, value hegel.Generator[string], follow hegel.Generator[bool]) hegel.Generator[filesCase] {
+	return hegel.FlatMap(value, func(v string) hegel.Generator[filesCase] {
+		return hegel.FlatMap(follow, func(f bool) hegel.Generator[filesCase] {
+			return hegel.Map(dieCoin(30), func(clear bool) filesCase { return buildFilesCase(tree, key, v, f, clear) })
+		})
+	})
+}
