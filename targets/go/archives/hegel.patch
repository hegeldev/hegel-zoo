+// =========================================================================== Identify and Compression
+
+// The narrow properties of the Identify and Compression families: the shape of each bug is
+// certain by construction (the ingredient forced, the pools strict), so none runs the
+// classifier as a filter; the collector's "known archives/N" count against the case count
+// says so (and "none" under HEGEL_NO_KNOWN=1). The surroundings are the wide properties'
+// generators.
+
+// --------------------------------------------------------------------------- archives/9
+
+// plainNames is a name that says nothing about the format (the misnamed shapes of
+// archives/19 and 26 out of the pool): none, a neutral spelling, or an extension no format
+// knows (x.tbz2).
+var plainNames = evenHalves("", "x.txt", "noext", "x.bak", "dir/x.dat", "x.bin", "x.tbz2")
+
+// emptyZipCases: a zip of no entries (one to four past the shape) by every zip method and
+// SelectiveCompression, under a plain name. The other ids of the family (10, 19, 20, 24, 25,
+// 26) need a compression or a misleading name and are out of the pool.
+var emptyZipCases = hegel.FlatMap(zipFormats, func(a archFormat) hegel.Generator[identifyCase] {
+	trees := hzShaped(hegel.Just([]fileEntry(nil)), treesBetween(1, 4))
+	return hegel.FlatMap(trees, func(tree []fileEntry) hegel.Generator[identifyCase] {
+		return hegel.Map(plainNames, func(name string) identifyCase {
+			return identifyCase{Content: buildArchiveContent(a, tree, compFormat{}), Name: name}
+		})
+	})
+})
