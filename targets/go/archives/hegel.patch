+++ b/hegel/hegel_zoo_files_test.go
@@ -0,0 +1,1056 @@
+package hegel
+
+// The FilesFromFS / FilesFromDisk property: the case records (a tree of files, directories
+// and links, the one entry of the filenames map, the options), their generators, the
+// documented model of what the two functions gather with the replicas of the recorded bugs
+// threaded on the switch set (filesExpected), the child process a case whose expansion never
+// ends is judged in, and the wide property.
+//
+// The model: the doc comment of FilesFromDisk (archives.go :52-72; FilesFromFS :165-184 says
+// the same) gives the rules of the filenames map - a key names a file or a directory, which
+// is walked and added "rooted at the named directory"; a key ending in a separator
+// "enumerates contents only, without adding the folder itself"; an empty value is "the base
+// name of the file (sans path) in the root of the archive", "." (nameOnDiskToNameInArchive
+// :292-298) the root of the archive without the base name, and a value ending in a slash
+// "the base name of the file in that folder". FollowSymlinks (:343-346): "the link will not
+// be added as a link, but what the link points to will be added as a file": a link to a file
+// is gathered as that file under the link's name, a link to a directory as that directory
+// and everything in it under the link's name, followed again inside, and a link that points
+// at nothing is an error. ClearAttributes (:348-350): "Name, size, type, and permissions
+// will still be preserved", the time and Sys are not. A link whose expansion leads back to
+// an ancestor directory has no end: the documented outcome of the call is that it returns
+// (the "returns" check); what it returns is not documented (the "error", "names" and "entry"
+// checks are the open marker). The checks per side ("fs" then "disk"): "<side> returns"
+// ("returned" or "hang"), "<side> error" (the kind: "none"; "dangling" for the text
+// "statting dereferenced symlink", the one text both sides give for a followed link whose
+// target cannot be stat'ed; "symlink directory" for "getting files from symlink directory";
+// "loop" and "depth" for followSymlink's own; "open" for an fs.ErrNotExist of the walk's
+// root; else the text), and, when no error is stated, "<side> names" (the sorted names in
+// the archive) and "<side> entry <name>" (the kind, the link target, the size and content
+// hash, the permission bits, the time or "cleared"; the root directory itself, whose
+// attributes are the temporary directory's, is open).
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"testing/fstest"
+	"time"
+
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the records
+
+// fileEntry is one entry of a tree: a slash-separated clean relative path (parents come
+// before children in the list), the kind ('d', 'f', 'l'), the content of a file, the target
+// of a link as written, the permission bits and the time. Fallback is the name a link is
+// redirected to under /nowhere/ when its target would be itself or another link (settle).
+// The fields are exported for the child process, which takes the case as JSON.
+type fileEntry struct {
+	Path     string
+	Kind     byte
+	Data     []byte
+	Link     string
+	Mode     fs.FileMode
+	Mtime    time.Time
+	Fallback string
+}
+
+// filesCase is one case: the tree, the one entry of the filenames map (the key a tree path
+// or "." for the root, with a trailing slash for a directory's contents; the value as
+// documented) and the two options.
+type filesCase struct {
+	Tree   []fileEntry
+	Key    string
+	Value  string
+	Follow bool
+	Clear  bool
+}
+
+func treeString(tree []fileEntry) string {
+	if len(tree) == 0 {
+		return "  (empty)\n"
+	}
+	var b strings.Builder
+	for _, e := range tree {
+		fmt.Fprintf(&b, "  %c %q mode %o", e.Kind, e.Path, e.Mode)
+		if e.Kind == 'f' {
+			fmt.Fprintf(&b, " (%d bytes)", len(e.Data))
+		}
+		if e.Kind == 'l' {
+			fmt.Fprintf(&b, " -> %q", e.Link)
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+func (c filesCase) GoString() string {
+	return fmt.Sprintf("filesCase{%q: %q, FollowSymlinks %v, ClearAttributes %v}\n%s", c.Key, c.Value, c.Follow, c.Clear, treeString(c.Tree))
+}
+
+// --------------------------------------------------------------------------- the pools
+
+// treeNames is the name pool (the old hzNames, byte for byte).
+var treeNames = []string{
+	"a", "b", "c.txt", "d.zip", "e.tar", "f.tar.gz", "g.tgz", "h i", "j.jpg", "K", "l.bak",
+	"m.tar.txt", "n.gz", "o..p", "q-r", "s_t", "u.PNG", "v.7z", "w.zst", "x", "y.json", "z.tar.zst",
+	"caf\u00e9", "0", "1.2.3", "long-name-with-many-characters-in-it-for-headers.txt",
+}
+
+var fileSizes = []int{0, 1, 7, 100, 511, 512, 513, 1023, 1024, 1025, 1500, 4096}
+
+// fileData is the content of a file: a size from the table 60 percent of the time (realised
+// 60), else 0..3000; compressible text, one byte repeated, or random bytes a third each
+// (realised 33/33/34).
+var fileData = hegel.FlatMap(dieChoice(hzW(60, evenHalves(fileSizes...)), hzW(40, rangeHalves(0, 3000))), func(n int) hegel.Generator[[]byte] {
+	return halvesGens([]int{1, 1, 1},
+		hegel.Just(bytes.Repeat([]byte("the quick brown fox "), n/20+1)[:n]),
+		hegel.Map(rangeHalves(0, 255), func(b int) []byte { return bytes.Repeat([]byte{byte(b)}, n) }),
+		hegel.Binary(n, n))
+})
+
+// entryTime is a time in 1981..2099, whole seconds: inside every format's range (zip's MS-DOS
+// time starts in 1980); the engine's integer draw favours the small values, so most times
+// are in the eighties, as the old draw gave them.
+var entryTime = hegel.Map(hegel.Integers(350000000, 4100000000), func(s int) time.Time { return time.Unix(int64(s), 0).UTC() })
+
+var entryName = evenHalves(treeNames...)
+
+var dirMode = hegel.Map(rangeHalves(0, 0o77), func(m int) fs.FileMode { return fs.FileMode(0o700 | m) })
+
+var fileMode = hegel.Map(rangeHalves(0, 0o177), func(m int) fs.FileMode { return fs.FileMode(0o600 | m) })
+
+// --------------------------------------------------------------------------- the tree
+
+func dirsOf(tree []fileEntry) []string {
+	var ds []string
+	for _, e := range tree {
+		if e.Kind == 'd' {
+			ds = append(ds, e.Path)
+		}
+	}
+	return ds
+}
+
+func pathsOf(tree []fileEntry) []string {
+	var ps []string
+	for _, e := range tree {
+		ps = append(ps, e.Path)
+	}
+	return ps
+}
+
+func entryAt(tree []fileEntry, p string) *fileEntry {
+	for i := range tree {
+		if tree[i].Path == p {
+			return &tree[i]
+		}
+	}
+	return nil
+}
+
+// linkTargetAmong is the target of a link at p (under parent) given the entries drawn so
+// far: a sibling name, the path of an earlier entry ("x" when there is none), "../name", "."
+// in a subdirectory (a name at the root), or "/nowhere/name", at a fifth each (realised
+// 21/19/20/20/20).
+func linkTargetAmong(prefix []fileEntry, parent string) hegel.Generator[string] {
+	earlier := hegel.Just("x")
+	if len(prefix) > 0 {
+		earlier = evenHalves(pathsOf(prefix)...)
+	}
+	own := hegel.Just(".")
+	if parent == "" {
+		own = entryName
+	}
+	return halvesGens([]int{1, 1, 1, 1, 1},
+		entryName,
+		earlier,
+		hegel.Map(entryName, func(n string) string { return "../" + n }),
+		own,
+		hegel.Map(entryName, func(n string) string { return "/nowhere/" + n }))
+}
+
+// entryAmong is one entry drawn after the entries of prefix: under a directory drawn so far
+// 60 percent of the time when there is one (realised 60), a name of the pool, and a
+// directory a quarter of the time (mode 0700 | 0..077), a file 60 (mode 0600 | 0..0177), a
+// link 15 (realised 25/60/15), each with a time.
+func entryAmong(prefix []fileEntry) hegel.Generator[fileEntry] {
+	parent := hegel.Just("")
+	if ds := dirsOf(prefix); len(ds) > 0 {
+		parent = dieChoice(hzW(40, hegel.Just("")), hzW(60, evenHalves(ds...)))
+	}
+	return hegel.FlatMap(parent, func(par string) hegel.Generator[fileEntry] {
+		return hegel.FlatMap(entryName, func(name string) hegel.Generator[fileEntry] {
+			p := name
+			if par != "" {
+				p = par + "/" + name
+			}
+			return hegel.FlatMap(entryTime, func(mt time.Time) hegel.Generator[fileEntry] {
+				dir := hegel.Map(dirMode, func(m fs.FileMode) fileEntry { return fileEntry{Path: p, Kind: 'd', Mode: m, Mtime: mt} })
+				file := hegel.FlatMap(fileData, func(data []byte) hegel.Generator[fileEntry] {
+					return hegel.Map(fileMode, func(m fs.FileMode) fileEntry { return fileEntry{Path: p, Kind: 'f', Data: data, Mode: m, Mtime: mt} })
+				})
+				link := hegel.FlatMap(linkTargetAmong(prefix, par), func(target string) hegel.Generator[fileEntry] {
+					return hegel.Map(entryName, func(fallback string) fileEntry {
+						return fileEntry{Path: p, Kind: 'l', Link: target, Mode: 0o777, Mtime: mt, Fallback: fallback}
+					})
+				})
+				return halvesGens([]int{25, 60, 15}, dir, file, link)
+			})
+		})
+	})
+}
+
+// treeFrom draws left more entries after prefix, one after the other (each entry's parent
+// and link target depend on the ones before it); an entry whose path is already there is
+// dropped. The result is settled.
+func treeFrom(prefix []fileEntry, left int) hegel.Generator[[]fileEntry] {
+	if left == 0 {
+		return hegel.Just(prefix)
+	}
+	return hegel.FlatMap(entryAmong(prefix), func(e fileEntry) hegel.Generator[[]fileEntry] {
+		next := prefix
+		if entryAt(prefix, e.Path) == nil {
+			next = append(append([]fileEntry(nil), prefix...), e)
+		}
+		return treeFrom(next, left-1)
+	})
+}
+
+// resolveLink resolves a link target the way a file system does: relative to the link's
+// directory, staying inside the tree. It returns the tree path ("." for the root), or ""
+// when the target leaves the tree or is absolute.
+func resolveLink(linkPath, target string) string {
+	if strings.HasPrefix(target, "/") {
+		return ""
+	}
+	p := path.Join(path.Dir(linkPath), target)
+	if p == ".." || strings.HasPrefix(p, "../") {
+		return ""
+	}
+	return p
+}
+
+// settle redirects every link whose target resolves to itself or to another link to
+// /nowhere/<its fallback name> (a loop of links would not resolve, and fstest.MapFS follows
+// chains without end); the kinds are read from the tree as drawn, so the order of the links
+// does not matter. A pure function of the drawn tree, run once by the builder.
+func settle(tree []fileEntry) []fileEntry {
+	out := append([]fileEntry(nil), tree...)
+	for i := range out {
+		e := &out[i]
+		if e.Kind != 'l' {
+			continue
+		}
+		if r := resolveLink(e.Path, e.Link); r != "" {
+			if r == e.Path {
+				e.Link = "/nowhere/" + e.Fallback
+			} else if t := entryAt(tree, r); t != nil && t.Kind == 'l' {
+				e.Link = "/nowhere/" + e.Fallback
+			}
+		}
+	}
+	return out
+}
+
+// treesOf is a tree of up to n entries, the count drawn evenly (realised 11 each for n 8).
+func treesOf(n int) hegel.Generator[[]fileEntry] {
+	return hegel.Map(hegel.FlatMap(rangeHalves(0, n), func(k int) hegel.Generator[[]fileEntry] { return treeFrom(nil, k) }), settle)
+}
+
+var fileTrees = treesOf(8)
+
+// --------------------------------------------------------------------------- the mapping
+
+// mapValues is the value of the map entry: "" twice, ".", "x", "x/", "x/y", "x/y/" (realised
+// 29/14/14/14/14/14).
+var mapValues = halvesOver([]int{2, 1, 1, 1, 1, 1}, "", ".", "x", "x/", "x/y", "x/y/")
+
+// buildFilesCase settles the two documented-unspecified combinations of the mapping: a file
+// key with the value "." (a file with an empty name in the archive) takes "", and a key with
+// a trailing slash with a slash-ended value (the contents of a folder into a folder named
+// for it) takes "x".
+func buildFilesCase(tree []fileEntry, key, value string, follow, clear bool) filesCase {
+	trailing := strings.HasSuffix(key, "/")
+	isDir := key == "." || trailing || entryAt(tree, key).Kind == 'd'
+	if !isDir && value == "." {
+		value = ""
+	}
+	if trailing && strings.HasSuffix(value, "/") {
+		value = "x"
+	}
+	return filesCase{Tree: tree, Key: key, Value: value, Follow: follow, Clear: clear}
+}
+
+// filesCasesOf is a case over the trees: the key the root "." a quarter of the time or when
+// the tree has no file or directory (realised 25 of the keys drawn, 37 of all cases), else a
+// file or directory of the tree; a directory key with a trailing slash 30 percent of the
+// time (realised 30); a value of mapValues; FollowSymlinks 30 (realised 30), ClearAttributes
+// 30 (realised 30).
+func filesCasesOf(trees hegel.Generator[[]fileEntry]) hegel.Generator[filesCase] {
+	return hegel.FlatMap(trees, func(tree []fileEntry) hegel.Generator[filesCase] {
+		var cands []string
+		for _, e := range tree {
+			if e.Kind != 'l' {
+				cands = append(cands, e.Path)
+			}
+		}
+		key := hegel.Just(".")
+		if len(cands) > 0 {
+			key = dieChoice(hzW(25, hegel.Just(".")), hzW(75, evenHalves(cands...)))
+		}
+		return hegel.FlatMap(key, func(k string) hegel.Generator[filesCase] {
+			trailing := hegel.Just(false)
+			if k != "." && entryAt(tree, k).Kind == 'd' {
+				trailing = dieCoin(27)
+			}
+			return hegel.FlatMap(trailing, func(tr bool) hegel.Generator[filesCase] {
+				if tr {
+					k += "/"
+				}
+				return hegel.FlatMap(mapValues, func(v string) hegel.Generator[filesCase] {
+					return hegel.FlatMap(dieCoin(30), func(follow bool) hegel.Generator[filesCase] {
+						return hegel.Map(dieCoin(30), func(clear bool) filesCase { return buildFilesCase(tree, k, v, follow, clear) })
+					})
+				})
+			})
+		})
+	})
+}
+
+var filesCases = filesCasesOf(fileTrees)
+
+// --------------------------------------------------------------------------- writing a tree
+
+// treeMapFS writes the tree to a fstest.MapFS.
+func treeMapFS(tree []fileEntry) fstest.MapFS {
+	m := fstest.MapFS{}
+	for _, e := range tree {
+		switch e.Kind {
+		case 'd':
+			m[e.Path] = &fstest.MapFile{Mode: fs.ModeDir | e.Mode, ModTime: e.Mtime}
+		case 'f':
+			m[e.Path] = &fstest.MapFile{Data: e.Data, Mode: e.Mode, ModTime: e.Mtime}
+		case 'l':
+			m[e.Path] = &fstest.MapFile{Data: []byte(e.Link), Mode: fs.ModeSymlink | e.Mode, ModTime: e.Mtime}
+		}
+	}
+	return m
+}
+
+// treeToDisk writes the tree under dir (which must exist and be empty); the directories'
+// permissions and times are set last, deepest first, after their contents.
+func treeToDisk(tree []fileEntry, dir string) error {
+	var dirs []fileEntry
+	for _, e := range tree {
+		p := filepath.Join(dir, filepath.FromSlash(e.Path))
+		switch e.Kind {
+		case 'd':
+			if err := os.Mkdir(p, 0o700); err != nil {
+				return err
+			}
+			dirs = append(dirs, e)
+		case 'f':
+			if err := os.WriteFile(p, e.Data, e.Mode); err != nil {
+				return err
+			}
+			if err := os.Chmod(p, e.Mode); err != nil {
+				return err
+			}
+			if err := os.Chtimes(p, e.Mtime, e.Mtime); err != nil {
+				return err
+			}
+		case 'l':
+			if err := os.Symlink(e.Link, p); err != nil {
+				return err
+			}
+		}
+	}
+	for i := len(dirs) - 1; i >= 0; i-- {
+		p := filepath.Join(dir, filepath.FromSlash(dirs[i].Path))
+		if err := os.Chtimes(p, dirs[i].Mtime, dirs[i].Mtime); err != nil {
+			return err
+		}
+		if err := os.Chmod(p, dirs[i].Mode); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// restoreDisk makes every directory under dir writable again so it can be removed.
+func restoreDisk(dir string) {
+	filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {
+		if err == nil && d.IsDir() {
+			os.Chmod(p, 0o700)
+		}
+		return nil
+	})
+}
+
+// treeRoot is the base name of the directory a tree is written to on disk: the names the
+// disk side gives a root key are built on it (filesExpected takes it as rootBase), so it is
+// the same in every case and in the child process.
+const treeRoot = "tree"
+
+// --------------------------------------------------------------------------- the model
+
+// found is one gathered entry as the model states it: the name in the archive and the
+// attributes the library reports (Root: the root directory itself, whose attributes are the
+// temporary directory's and are not stated).
+type found struct {
+	Name  string
+	Kind  byte
+	Link  string
+	Data  []byte
+	Mode  fs.FileMode
+	Mtime time.Time
+	Root  bool
+}
+
+// entryValue spells the attributes of a gathered entry as the checks compare them.
+func entryValue(f found, clear bool) string {
+	if f.Root {
+		return hzUnspecified
+	}
+	switch f.Kind {
+	case 'l':
+		return "link -> " + f.Link
+	case 'd':
+		return "dir mode=" + strconv.FormatInt(int64(f.Mode), 8) + " " + timeValue(f.Mtime, clear)
+	}
+	sum := sha256.Sum256(f.Data)
+	return fmt.Sprintf("file size=%d read=%d sha=%s mode=%o %s", len(f.Data), len(f.Data), hex.EncodeToString(sum[:4]), f.Mode, timeValue(f.Mtime, clear))
+}
+
+func timeValue(t time.Time, clear bool) string {
+	if clear {
+		return "cleared"
+	}
+	return "mtime=" + strconv.FormatInt(t.Unix(), 10)
+}
+
+// walkKey is the sort key of fs.WalkDir's order (lexical within each directory, a
+// directory's contents right after it): the path with the separator below every other byte.
+func walkKey(p string) string { return strings.ReplaceAll(p, "/", "\x00") }
+
+// trimTopDir and topDir are archives.go :312-329, transcribed.
+func trimTopDir(dir string) string {
+	return strings.TrimPrefix(dir, topDir(dir)+"/")
+}
+
+func topDir(dir string) string {
+	var start int
+	if len(dir) > 0 && dir[0] == '/' {
+		start = 1
+	}
+	if pos := strings.Index(dir[start:], "/"); pos >= 0 {
+		return dir[:pos+start]
+	}
+	return dir
+}
+
+// nameInArchive is nameOnDiskToNameInArchive (archives.go :277-306), transcribed, with the
+// two documented rules in place of the library's where a switch is off: a key with a
+// trailing separator enumerates contents only (the value is the folder of the contents;
+// under kFsTrailingKeyValue the library's :286 trims the value's first element, archives/16),
+// and the name of an entry is its path below the key (the library's :304 keeps the separator
+// after a key without a trailing one, which :305 joins onto an empty root as a leading
+// slash under kFsRootDotLeadingSlash, archives/14).
+func nameInArchive(nameOnDisk, rootOnDisk, rootInArchive string, k known) string {
+	if strings.HasSuffix(rootOnDisk, "/") {
+		if k[kFsTrailingKeyValue] {
+			rootInArchive = trimTopDir(rootInArchive) // :286
+		}
+	} else if rootInArchive == "" {
+		rootInArchive = path.Base(rootOnDisk) // :290
+	}
+	if rootInArchive == "." {
+		rootInArchive = "" // :297
+	}
+	if strings.HasSuffix(rootInArchive, "/") {
+		rootInArchive += path.Base(rootOnDisk) // :302
+	}
+	truncPath := strings.TrimPrefix(nameOnDisk, rootOnDisk) // :304
+	if !k[kFsRootDotLeadingSlash] {
+		truncPath = strings.TrimPrefix(truncPath, "/")
+	}
+	return path.Join(rootInArchive, truncPath) // :305
+}
+
+// errKindOf is the kind of an error of the two functions (the texts of archives.go :492,
+// :531, :501, :540, :505, :544, :125, :232 and the walk's own fs.ErrNotExist).
+func errKindOf(err error) string {
+	if err == nil {
+		return "none"
+	}
+	s := err.Error()
+	switch {
+	case strings.Contains(s, "statting dereferenced symlink"):
+		return "dangling"
+	case strings.Contains(s, "symlink loop"):
+		return "loop"
+	case strings.Contains(s, "maximum symlink depth"):
+		return "depth"
+	case strings.Contains(s, "getting files from symlink directory"):
+		return "symlink directory"
+	case errors.Is(err, fs.ErrNotExist) || strings.Contains(s, "file does not exist") || strings.Contains(s, "no such file"):
+		return "open"
+	}
+	return "other: " + s
+}
+
+// gather walks one side of a case under the switch set: the documented rules with the
+// replicas where a switch is on. The fs side's paths are relative to a root prefix (the
+// subtree a nested walk is rooted at under kFsFollowDirLink); the disk side's root is the
+// directory treeRoot. The walk order is fs.WalkDir's; the first error ends the walk; an
+// expansion deeper than the tree's size is a loop (the documented expansion has no end).
+type gather struct {
+	c        filesCase
+	k        known
+	side     string
+	rootBase string
+	out      []found
+	err      string
+	loop     bool
+}
+
+// onDisk is the name on disk of a tree path (the disk side's absolute names stand in by
+// rootBase, the base of the directory the tree is written to; the fs side's names are the
+// paths themselves relative to the prefix).
+func (g *gather) onDisk(prefix, p string) string {
+	if g.side == "disk" {
+		if p == "." {
+			return g.rootBase
+		}
+		return g.rootBase + "/" + p
+	}
+	if prefix != "" && p == strings.TrimSuffix(prefix, "/") {
+		return "."
+	}
+	return strings.TrimPrefix(p, prefix)
+}
+
+// resolveFS is the fs side's resolution of a link's target: as the file system resolves it,
+// relative to the link's directory (resolveLink), or, under kFsFollowSymlinkRelative for a
+// link below the root of the walked file system, the target as written looked up from that
+// root (followSymlinkFS, archives.go :525-529: fs.Lstat(fsys, linkPath) on the target of
+// fs.ReadLink; fstest.MapFS refuses a path fs.ValidPath refuses, so "../x" and "/nowhere/x"
+// are not found, "." is the root). The result is a tree path, "." for the root of the walked
+// file system (the tree's, or the subtree's at prefix), or "".
+func (g *gather) resolveFS(prefix, linkPath, target string) string {
+	rel := strings.TrimPrefix(linkPath, prefix)
+	if g.k[kFsFollowSymlinkRelative] && strings.Contains(rel, "/") {
+		if !fs.ValidPath(target) {
+			return ""
+		}
+		if target == "." {
+			return "."
+		}
+		return prefix + target
+	}
+	r := resolveLink(rel, target)
+	if r == "" || r == "." {
+		return r
+	}
+	return prefix + r
+}
+
+// follow is followSymlink / followSymlinkFS (archives.go :476-511, :517-550): the chain of
+// links from linkPath to a file or directory, with the loop and depth checks; it returns the
+// tree path of the target ("." for the root) and its entry (nil for the root), or sets the
+// error kind.
+func (g *gather) follow(prefix, linkPath string) (string, *fileEntry, bool) {
+	visited := map[string]bool{linkPath: true}
+	cur := linkPath
+	for {
+		e := entryAt(g.c.Tree, cur)
+		var next string
+		if g.side == "disk" {
+			next = resolveLink(cur, e.Link)
+		} else {
+			next = g.resolveFS(prefix, cur, e.Link)
+		}
+		if next == "" {
+			g.err = "dangling"
+			return "", nil, false
+		}
+		if next == "." {
+			return next, nil, true // the root of the walked file system
+		}
+		te := entryAt(g.c.Tree, next)
+		if te == nil {
+			g.err = "dangling"
+			return "", nil, false
+		}
+		if te.Kind != 'l' {
+			return next, te, true
+		}
+		if visited[next] {
+			g.err = "loop"
+			return "", nil, false
+		}
+		if len(visited) >= 40 {
+			g.err = "depth"
+			return "", nil, false
+		}
+		visited[next] = true
+		cur = next
+	}
+}
+
+// walk is one call of FilesFromDisk/FilesFromFS with the one map entry {key: value}: prefix
+// is the root of the walked file system as a tree path prefix ("" for the whole tree, "d/"
+// for fs.Sub(fsys, "d")), key the walked root relative to it ("." for the root itself, with
+// a trailing slash for contents only), value the name in the archive. depth counts the
+// nested calls a followed directory link makes.
+func (g *gather) walk(prefix, key, value string, depth int) {
+	if g.err != "" || g.loop {
+		return
+	}
+	if depth > len(g.c.Tree)+1 {
+		g.loop = true
+		return
+	}
+	trailing := strings.HasSuffix(key, "/")
+	bare := strings.TrimSuffix(key, "/")
+	if g.side == "fs" && trailing && g.k[kFsTrailingSlashKey] {
+		g.err = "open" // archives/15: fs.WalkDir's fs.Stat of "dir/" fails
+		return
+	}
+	root := bare
+	if prefix != "" {
+		if bare == "." {
+			root = strings.TrimSuffix(prefix, "/")
+		} else {
+			root = prefix + bare
+		}
+	}
+	// the walked entries in fs.WalkDir's order: the root, then everything below it
+	var paths []string
+	if root == "." || root == "" {
+		paths = append(paths, ".")
+		for _, e := range g.c.Tree {
+			paths = append(paths, e.Path)
+		}
+	} else {
+		re := entryAt(g.c.Tree, root)
+		if re == nil {
+			g.err = "open"
+			return
+		}
+		paths = append(paths, root)
+		if re.Kind == 'd' {
+			for _, e := range g.c.Tree {
+				if strings.HasPrefix(e.Path, root+"/") {
+					paths = append(paths, e.Path)
+				}
+			}
+		}
+	}
+	sort.Slice(paths, func(i, j int) bool { return walkKey(paths[i]) < walkKey(paths[j]) })
+	rootOnDisk := g.onDisk(prefix, root)
+	if trailing {
+		rootOnDisk += "/"
+	}
+	for _, p := range paths {
+		isRoot := p == root || (p == "." && (root == "." || root == ""))
+		nameOnDisk := g.onDisk(prefix, p)
+		if isRoot && trailing {
+			nameOnDisk = rootOnDisk // the walk reports its root as given, slash and all
+		}
+		name := nameInArchive(nameOnDisk, rootOnDisk, value, g.k)
+		var e *fileEntry
+		if p != "." {
+			e = entryAt(g.c.Tree, p)
+		}
+		isDir := e == nil || e.Kind == 'd'
+		if isDir && isRoot {
+			// archives.go :98: the root folder is skipped when its name is empty; the
+			// documentation skips it for every key with a trailing separator
+			if name == "" || (trailing && !g.k[kFsTrailingKeyValue]) {
+				continue
+			}
+		}
+		if e == nil {
+			g.out = append(g.out, found{Name: name, Kind: 'd', Root: true})
+			continue
+		}
+		if e.Kind == 'l' && g.c.Follow {
+			target, te, ok := g.follow(prefix, p)
+			if !ok {
+				return
+			}
+			if te != nil && te.Kind == 'f' {
+				g.out = append(g.out, found{Name: name, Kind: 'f', Data: te.Data, Mode: te.Mode, Mtime: te.Mtime})
+				continue
+			}
+			// a directory: FilesFromDisk(ctx, options, {target: name}) at :123, the
+			// directory and its contents under the link's name, its links followed in turn
+			if g.side == "disk" {
+				g.walk("", target, name, depth+1)
+				if g.err != "" {
+					g.err = "symlink directory"
+				}
+				continue
+			}
+			inner := strings.TrimPrefix(target, prefix) // the target relative to the walked fs
+			if target == "." {
+				inner = "."
+			}
+			if !g.k[kFsFollowDirLink] || inner == "." {
+				// the documented walk of the directory under the link's name (and the
+				// library's own when the target is the root: fs.Sub(fsys, ".") is fsys)
+				g.walk(prefix, inner, name, depth+1)
+				if g.err != "" {
+					g.err = "symlink directory"
+				}
+				continue
+			}
+			// archives/18, :226-233: fs.Sub(fsys, target), then the walk of target inside
+			// it, which is target/target of the tree
+			sub := target + "/"
+			if ie := entryAt(g.c.Tree, sub+inner); ie == nil {
+				g.err = "symlink directory"
+				return
+			} else if ie.Kind == 'l' {
+				hzTally("fs walk rooted at a link (outside the model)")
+				g.loop = true // outside the model: judged in a child, "returns" open
+				return
+			}
+			g.walk(sub, inner, name, depth+1)
+			if g.err != "" {
+				g.err = "symlink directory"
+			}
+			continue
+		}
+		switch e.Kind {
+		case 'd':
+			g.out = append(g.out, found{Name: name, Kind: 'd', Mode: e.Mode, Mtime: e.Mtime})
+		case 'f':
+			g.out = append(g.out, found{Name: name, Kind: 'f', Data: e.Data, Mode: e.Mode, Mtime: e.Mtime})
+		case 'l':
+			g.out = append(g.out, found{Name: name, Kind: 'l', Link: e.Link})
+		}
+	}
+}
+
+// sideExpected is the checks of one side: "returns", "error", and when the side returns
+// without an error, "names" and one "entry" per name; a looping expansion leaves the error,
+// the names and the entries open and, under kFollowAncestorLinkHang, the call hangs.
+func sideExpected(c filesCase, k known, side, rootBase string, out checks) {
+	g := &gather{c: c, k: k, side: side, rootBase: rootBase}
+	g.walk("", c.Key, c.Value, 0)
+	if g.loop {
+		if k[kFollowAncestorLinkHang] {
+			out.set(side+" returns", "hang")
+		} else {
+			out.set(side+" returns", "returned")
+		}
+		out.unspecified(side + " error")
+		out.unspecified(side + " names")
+		return
+	}
+	out.set(side+" returns", "returned")
+	if g.err != "" {
+		out.set(side+" error", g.err)
+		return
+	}
+	out.set(side+" error", "none")
+	var names []string
+	for _, f := range g.out {
+		names = append(names, f.Name)
+		if f.Root {
+			out.unspecified(side + " entry " + f.Name)
+		} else {
+			out.set(side+" entry "+f.Name, entryValue(f, c.Clear))
+		}
+	}
+	sort.Strings(names)
+	out.set(side+" names", strings.Join(names, "\n"))
+}
+
+// filesExpected states every value the property checks, for the fs side then the disk side
+// (rootBase is the base name of the directory the tree is written to on disk, which the
+// disk side's names of a root key are built on: the property supplies it).
+func filesExpected(c filesCase, k known, rootBase string) checks {
+	out := checks{}
+	sideExpected(c, k, "fs", rootBase, out)
+	sideExpected(c, k, "disk", rootBase, out)
+	return out
+}
+
+// filesModel is filesExpected for the trees written under a directory named rootBase.
+func filesModel(rootBase string) func(filesCase, known) checks {
+	return func(c filesCase, k known) checks { return filesExpected(c, k, rootBase) }
+}
+
+// filesExpectedAt is filesExpected with treeRoot, the base every tree is written under.
+func filesExpectedAt(c filesCase, k known) checks { return filesExpected(c, k, treeRoot) }
+
+// loopsOn reports whether the side's call never returns by the replica (the "returns" check
+// under every switch, the library as recorded, or under the hang switch alone, the
+// documented expansion without end): such a side is called in a child process.
+func loopsOn(c filesCase, side string) bool {
+	hang := hzValue("hang")
+	return filesExpectedAt(c, hzKnownAll)[side+" returns"] == hang ||
+		filesExpectedAt(c, hzKnownOnly(kFollowAncestorLinkHang))[side+" returns"] == hang
+}
+
+// inProcessWait is the context deadline of a call made in process: a call the replica did
+// not see looping is stopped by the library's own ctx.Err() checks (archives.go :84, :199)
+// and fails the case as "hang (stopped in process)" rather than exhausting the memory.
+const inProcessWait = time.Second
+
+func init() {
+	for i, name := range []string{"fs returns", "fs error", "fs names", "fs entry", "disk returns", "disk error", "disk names", "disk entry"} {
+		checkRank[name] = i
+	}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// sideActual asks one side the questions sideExpected answered: the tree is written at dir
+// on disk and as mfs; ctx is the call's (the in-process deadline, or none in the child).
+func sideActual(ctx context.Context, c filesCase, side, dir string, mfs fstest.MapFS) checks {
+	out := checks{}
+	var files []archives.FileInfo
+	var err error
+	if side == "fs" {
+		files, err = archives.FilesFromFS(ctx, mfs, &archives.FromFSOptions{FollowSymlinks: c.Follow, ClearAttributes: c.Clear}, map[string]string{c.Key: c.Value})
+	} else {
+		key := dir
+		if bare := strings.TrimSuffix(c.Key, "/"); bare != "." {
+			key = filepath.Join(dir, filepath.FromSlash(bare))
+		}
+		if strings.HasSuffix(c.Key, "/") {
+			key += string(filepath.Separator)
+		}
+		files, err = archives.FilesFromDisk(ctx, &archives.FromDiskOptions{FollowSymlinks: c.Follow, ClearAttributes: c.Clear}, map[string]string{key: c.Value})
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		out.set(side+" returns", "hang (stopped in process)")
+		return out
+	}
+	out.set(side+" returns", "returned")
+	out.set(side+" error", errKindOf(err))
+	if err != nil {
+		return out
+	}
+	var names []string
+	for _, f := range files {
+		names = append(names, f.NameInArchive)
+		out.set(side+" entry "+f.NameInArchive, fileInfoValue(f, c.Clear))
+	}
+	sort.Strings(names)
+	out.set(side+" names", strings.Join(names, "\n"))
+	return out
+}
+
+// fileInfoValue spells a gathered FileInfo as entryValue spells the model's.
+func fileInfoValue(f archives.FileInfo, clear bool) string {
+	mt := "mtime=" + strconv.FormatInt(f.ModTime().Unix(), 10)
+	if clear {
+		if f.ModTime().IsZero() && f.Sys() == nil {
+			mt = "cleared"
+		} else {
+			mt = fmt.Sprintf("not cleared: mtime=%d sys=%v", f.ModTime().Unix(), f.Sys() != nil)
+		}
+	}
+	switch {
+	case f.Mode()&fs.ModeSymlink != 0:
+		return "link -> " + f.LinkTarget
+	case f.IsDir():
+		return "dir mode=" + strconv.FormatInt(int64(f.Mode().Perm()), 8) + " " + mt
+	}
+	r, err := f.Open()
+	if err != nil {
+		return "file open error: " + err.Error()
+	}
+	b, rerr := io.ReadAll(r)
+	r.Close()
+	if rerr != nil {
+		return "file read error: " + rerr.Error()
+	}
+	sum := sha256.Sum256(b)
+	return fmt.Sprintf("file size=%d read=%d sha=%s mode=%o %s", f.Size(), len(b), hex.EncodeToString(sum[:4]), f.Mode().Perm(), mt)
+}
+
+// --------------------------------------------------------------------------- the child process
+
+// childRequest is what the child process reads from its stdin: the case and the side.
+type childRequest struct {
+	Case filesCase
+	Side string
+}
+
+// childWait is how long the parent waits for a child: a looping call overflows the child's
+// capped stack in well under a second (filesChild caps it at 1 MB), the deadline is the
+// backstop.
+const childWait = 4 * time.Second
+
+// sideInChild asks one side in a child process: the test binary re-executed on this test
+// alone with HZ_ARCHIVES_CHILD=files and the request as JSON on its stdin; the child writes
+// the tree to a directory of its own, calls the library and prints "RETURNED <json of the
+// checks>". A child that prints nothing within childWait (killed by the deadline, or dead of
+// its stack) is the value "hang".
+func sideInChild(c filesCase, side string) checks {
+	req, err := json.Marshal(childRequest{Case: c, Side: side})
+	if err != nil {
+		panic(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), childWait)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run", "^TestHegelFilesFrom$", "-test.timeout", "8s", "-test.count=1")
+	cmd.Env = append(os.Environ(), "HZ_ARCHIVES_CHILD=files")
+	cmd.Stdin = bytes.NewReader(req)
+	start := time.Now()
+	out, _ := cmd.CombinedOutput()
+	hzTally("child " + side)
+	hzTally(fmt.Sprintf("child ms %d", time.Since(start).Milliseconds()/100*100))
+	for _, line := range strings.Split(string(out), "\n") {
+		if rest, ok := strings.CutPrefix(line, "RETURNED "); ok {
+			got := checks{}
+			if err := json.Unmarshal([]byte(rest), &got); err != nil {
+				panic(fmt.Sprintf("child output: %v: %s", err, rest))
+			}
+			return got
+		}
+	}
+	return checks{side + " returns": hzValue("hang")}
+}
+
+// filesChild is the child's half.
+func filesChild() {
+	debug.SetMaxStack(1 << 20) // the recursion without end dies of its stack within milliseconds
+	var req childRequest
+	if err := json.NewDecoder(os.Stdin).Decode(&req); err != nil {
+		fmt.Printf("RETURNED %s\n", `{"child": "bad request"}`)
+		return
+	}
+	tmp, err := os.MkdirTemp("", "hz-archives-child-")
+	if err != nil {
+		panic(err)
+	}
+	defer func() { restoreDisk(tmp); os.RemoveAll(tmp) }()
+	dir := filepath.Join(tmp, treeRoot)
+	if err := os.Mkdir(dir, 0o700); err != nil {
+		panic(err)
+	}
+	if err := treeToDisk(req.Case.Tree, dir); err != nil {
+		panic(err)
+	}
+	got := sideActual(context.Background(), req.Case, req.Side, dir, treeMapFS(req.Case.Tree))
+	text, err := json.Marshal(got)
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("RETURNED %s\n", text)
+}
+
+// --------------------------------------------------------------------------- the property
+
+// filesActual asks both sides: in process, or, for a side whose call never returns by the
+// replica, in a child process. The tree is written under dir (base treeRoot).
+func filesActual(c filesCase, dir string) checks {
+	got := checks{}
+	mfs := treeMapFS(c.Tree)
+	for _, side := range []string{"fs", "disk"} {
+		var part checks
+		if loopsOn(c, side) {
+			hzTally("loop case side " + side)
+			part = sideInChild(c, side)
+		} else {
+			ctx, cancel := context.WithTimeout(context.Background(), inProcessWait)
+			part = sideActual(ctx, c, side, dir, mfs)
+			cancel()
+		}
+		for k, v := range part {
+			got[k] = v
+		}
+	}
+	return got
+}
+
+// filesJudge is the judge of the family: the tree written under a fresh directory of root
+// (named treeRoot), then judgeBy over filesExpectedAt and filesActual; drops lists the
+// switches whose checks are dropped under HEGEL_NO_KNOWN=1 (judgeByDropping) - nil for
+// judgeBy. The narrow properties share it, with their own model where an earlier bug would
+// be named first (pastSwitches).
+func filesJudgeWith(root string, expected func(filesCase, known) checks, drops []int) func(j *hzCaseJudge, c filesCase) {
+	n := 0
+	return func(j *hzCaseJudge, c filesCase) {
+		n++
+		dir := filepath.Join(root, "c"+strconv.Itoa(n), treeRoot)
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			panic(err)
+		}
+		defer func() { restoreDisk(filepath.Dir(dir)); os.RemoveAll(filepath.Dir(dir)) }()
+		if err := treeToDisk(c.Tree, dir); err != nil {
+			panic(fmt.Sprintf("writing the tree: %v", err))
+		}
+		actual := func(c *filesCase) checks { return filesActual(*c, dir) }
+		if drops == nil {
+			judgeBy(j, &c, expected, actual)
+		} else {
+			judgeByDropping(j, &c, expected, actual, drops)
+		}
+	}
+}
+
+// filesRoot is a temporary root for the trees of one property.
+func filesRoot(t *testing.T) string {
+	t.Helper()
+	root, err := os.MkdirTemp("", "hz-archives-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { restoreDisk(root); os.RemoveAll(root) })
+	return root
+}
+
+// filesDrops are the switches whose checks the wide property drops under HEGEL_NO_KNOWN=1
+// rather than skipping the case: archives/15 covers the fs side of every key with a trailing
+// slash, and the disk side of such a key with the value "" is the documented case that must
+// stay.
+var filesDrops = []int{kFsTrailingSlashKey}
+
+// wideFilesCases is the cases of the wide property: under HEGEL_NO_KNOWN=1 the cases that
+// have a shape past the dropped checks (the value "." with a key without a trailing slash,
+// archives/14; a trailing key with a non-empty value, 16; a relative link in a subdirectory
+// or a link to a directory followed on the fs side, 17 and 18; an expansion without end,
+// 27) are filtered out by the classifier (withoutShapes, counted "filtered archives/N"); the
+// fs side's checks of a trailing key are dropped (filesDrops).
+var wideFilesCases = withoutShapes(pastSwitches(filesExpectedAt, filesDrops), filesCases)
+
+// TestHegelFilesFrom: FilesFromFS on the tree as a fstest.MapFS and FilesFromDisk on the same
+// tree written to disk gather the entries the documentation describes for the filenames map:
+// the names in the archive, the kinds, the link targets, contents, permissions and times,
+// with and without ClearAttributes; with FollowSymlinks the links to files become the files
+// and the links to directories those directories, and a call whose expansion has no end
+// still returns (such a side is called in a child process).
+func TestHegelFilesFrom(t *testing.T) {
+	if os.Getenv("HZ_ARCHIVES_CHILD") == "files" {
+		filesChild()
+		return
+	}
+	judged(t, wideFilesCases, filesJudgeWith(filesRoot(t), filesExpectedAt, filesDrops))
+}
diff --git a/hegel/hegel_zoo_gen_test.go b/hegel/hegel_zoo_gen_test.go
new file mode 100644
index 0000000..95feb60
--- /dev/null
+++ b/hegel/hegel_zoo_gen_test.go
@@ -0,0 +1,428 @@
+package hegel
+
+// Generators of the old harness, kept for TestHegelInsert (part 4's): a tree of files,
+// directories and symbolic links, written to a fstest.MapFS or to a directory on disk; the
+// archival format; the extraction helper; and a read-write-seekable byte buffer for Insert.
+
+import (
+	"archive/tar"
+	"archive/zip"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+	"testing/fstest"
+	"time"
+
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- trees
+
+type hzEntry struct {
+	path  string      // slash-separated, clean, relative
+	kind  byte        // 'f' file, 'd' directory, 'l' symbolic link
+	data  []byte      // file content
+	link  string      // link target, as written
+	mode  fs.FileMode // permission bits
+	mtime time.Time
+}
+
+type hzTree struct {
+	entries []hzEntry // parents before children
+	byPath  map[string]int
+}
+
+func (t *hzTree) add(e hzEntry) {
+	if t.byPath == nil {
+		t.byPath = map[string]int{}
+	}
+	t.byPath[e.path] = len(t.entries)
+	t.entries = append(t.entries, e)
+}
+
+func (t *hzTree) get(p string) *hzEntry {
+	if i, ok := t.byPath[p]; ok {
+		return &t.entries[i]
+	}
+	return nil
+}
+
+func (t *hzTree) dirs() []string {
+	var ds []string
+	for _, e := range t.entries {
+		if e.kind == 'd' {
+			ds = append(ds, e.path)
+		}
+	}
+	return ds
+}
+
+var hzNames = []string{
+	"a", "b", "c.txt", "d.zip", "e.tar", "f.tar.gz", "g.tgz", "h i", "j.jpg", "K", "l.bak",
+	"m.tar.txt", "n.gz", "o..p", "q-r", "s_t", "u.PNG", "v.7z", "w.zst", "x", "y.json", "z.tar.zst",
+	"caf\u00e9", "0", "1.2.3", "long-name-with-many-characters-in-it-for-headers.txt",
+}
+
+var hzSizes = []int{0, 1, 7, 100, 511, 512, 513, 1023, 1024, 1025, 1500, 4096}
+
+func hzData(tc hegel.TestCase) []byte {
+	var n int
+	if hzOldChance(tc, 60) {
+		n = hzOldPick(tc, hzSizes)
+	} else {
+		n = hzOldDrawInt(tc, 0, 3000)
+	}
+	switch hzOldDrawInt(tc, 0, 2) {
+	case 0: // compressible text
+		return bytes.Repeat([]byte("the quick brown fox "), n/20+1)[:n]
+	case 1: // one byte
+		return bytes.Repeat([]byte{byte(hzOldDrawInt(tc, 0, 255))}, n)
+	default: // random
+		return hegel.Draw(tc, hegel.Binary(n, n))
+	}
+}
+
+func hzTime(tc hegel.TestCase) time.Time {
+	// 1981..2099, whole seconds: inside every format's range (zip's MS-DOS time starts in 1980)
+	return time.Unix(int64(hzOldDrawInt(tc, 350000000, 4100000000)), 0).UTC()
+}
+
+// hzGenTree draws a tree of up to n entries. Directories are explicit and come before their
+// contents; symbolic links point at a sibling, a parent's child, an absolute path or nothing.
+func hzGenTree(tc hegel.TestCase, n int) *hzTree {
+	t := &hzTree{}
+	count := hzOldDrawInt(tc, 0, n)
+	for i := 0; i < count; i++ {
+		parent := ""
+		if ds := t.dirs(); len(ds) > 0 && hzOldChance(tc, 60) {
+			parent = hzOldPick(tc, ds)
+		}
+		name := hzOldPick(tc, hzNames)
+		p := name
+		if parent != "" {
+			p = parent + "/" + name
+		}
+		if t.get(p) != nil {
+			continue
+		}
+		e := hzEntry{path: p, mtime: hzTime(tc)}
+		switch r := hzOldDrawInt(tc, 1, 100); {
+		case r <= 25:
+			e.kind = 'd'
+			e.mode = fs.FileMode(0o700 | hzOldDrawInt(tc, 0, 0o77))
+		case r <= 85:
+			e.kind = 'f'
+			e.data = hzData(tc)
+			e.mode = fs.FileMode(0o600 | hzOldDrawInt(tc, 0, 0o177))
+		default:
+			e.kind = 'l'
+			e.mode = 0o777
+			switch hzOldDrawInt(tc, 0, 4) {
+			case 0: // a sibling (may not exist yet, or ever)
+				e.link = hzOldPick(tc, hzNames)
+			case 1: // a path from the root, as a relative target
+				if len(t.entries) > 0 {
+					e.link = hzOldPick(tc, t.entries).path
+				} else {
+					e.link = "x"
+				}
+			case 2:
+				e.link = "../" + hzOldPick(tc, hzNames)
+			case 3: // the link's own directory (ln -s . self), in a subdirectory
+				if parent != "" {
+					e.link = "."
+				} else {
+					e.link = hzOldPick(tc, hzNames)
+				}
+			default:
+				e.link = "/nowhere/" + hzOldPick(tc, hzNames)
+			}
+			// no link to a link (a loop would not resolve; fstest.MapFS recurses without end)
+			if r := hzResolve(p, e.link); r != "" {
+				if r == p {
+					e.link = "/nowhere/" + hzOldPick(tc, hzNames)
+				} else if target := t.get(r); target != nil && target.kind == 'l' {
+					e.link = "/nowhere/" + hzOldPick(tc, hzNames)
+				}
+			}
+		}
+		t.add(e)
+	}
+	// a link created before its target may point at a later link: redirect it (a chain of links
+	// leads FollowSymlinks around the ancestor-loop model, and fstest.MapFS around cycles)
+	for i := range t.entries {
+		e := &t.entries[i]
+		if e.kind != 'l' {
+			continue
+		}
+		if r := hzResolve(e.path, e.link); r != "" {
+			if target := t.get(r); target != nil && target.kind == 'l' {
+				e.link = "/nowhere/" + hzOldPick(tc, hzNames)
+			}
+		}
+	}
+	return t
+}
+
+// hzResolve resolves a link target the way a file system does: relative to the link's
+// directory, staying inside the tree. It returns the tree path, or "" when the target leaves
+// the tree or is absolute.
+func hzResolve(linkPath, target string) string {
+	if strings.HasPrefix(target, "/") {
+		return ""
+	}
+	p := path.Join(path.Dir(linkPath), target)
+	if p == ".." || strings.HasPrefix(p, "../") {
+		return ""
+	}
+	return p
+}
+
+type (
+	fstestMapFS   = fstest.MapFS
+	fstestMapFile = fstest.MapFile
+)
+
+// hzMapFS writes the tree to a fstest.MapFS.
+func hzMapFS(t *hzTree) fstestMapFS {
+	m := fstestMapFS{}
+	for _, e := range t.entries {
+		switch e.kind {
+		case 'd':
+			m[e.path] = &fstestMapFile{Mode: fs.ModeDir | e.mode, ModTime: e.mtime}
+		case 'f':
+			m[e.path] = &fstestMapFile{Data: e.data, Mode: e.mode, ModTime: e.mtime}
+		case 'l':
+			m[e.path] = &fstestMapFile{Data: []byte(e.link), Mode: fs.ModeSymlink | e.mode, ModTime: e.mtime}
+		}
+	}
+	return m
+}
+
+// hzWriteDisk writes the tree under dir (which must exist and be empty).
+func hzWriteDisk(t *hzTree, dir string) error {
+	var dirs []hzEntry
+	for _, e := range t.entries {
+		p := filepath.Join(dir, filepath.FromSlash(e.path))
+		switch e.kind {
+		case 'd':
+			if err := os.Mkdir(p, 0o700); err != nil {
+				return err
+			}
+			dirs = append(dirs, e)
+		case 'f':
+			if err := os.WriteFile(p, e.data, e.mode); err != nil {
+				return err
+			}
+			if err := os.Chmod(p, e.mode); err != nil {
+				return err
+			}
+			if err := os.Chtimes(p, e.mtime, e.mtime); err != nil {
+				return err
+			}
+		case 'l':
+			if err := os.Symlink(e.link, p); err != nil {
+				return err
+			}
+		}
+	}
+	// directories last, deepest first: chmod and chtimes after their contents are written
+	for i := len(dirs) - 1; i >= 0; i-- {
+		p := filepath.Join(dir, filepath.FromSlash(dirs[i].path))
+		if err := os.Chtimes(p, dirs[i].mtime, dirs[i].mtime); err != nil {
+			return err
+		}
+		if err := os.Chmod(p, dirs[i].mode); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// hzRestoreDisk makes every directory under dir writable again so it can be removed.
+func hzRestoreDisk(dir string) {
+	filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {
+		if err == nil && d.IsDir() {
+			os.Chmod(p, 0o700)
+		}
+		return nil
+	})
+}
+
+// --------------------------------------------------------------------------- formats
+
+// hzArchival draws a Tar or a Zip with random options.
+func hzArchival(tc hegel.TestCase) archives.Archival {
+	if hzOldChance(tc, 50) {
+		t := archives.Tar{}
+		switch hzOldDrawInt(tc, 0, 3) {
+		case 1:
+			t.Format = tar.FormatUSTAR
+		case 2:
+			t.Format = tar.FormatPAX
+		case 3:
+			t.Format = tar.FormatGNU
+		}
+		if hzOldChance(tc, 20) {
+			t.NumericUIDGID = true
+		}
+		if hzOldChance(tc, 20) {
+			t.Uid = hzOldDrawInt(tc, 1, 70000)
+			t.Gid = hzOldDrawInt(tc, 1, 70000)
+		}
+		if hzOldChance(tc, 20) {
+			t.Uname = hzOldPick(tc, []string{"root", "user", "a name with spaces"})
+			t.Gname = hzOldPick(tc, []string{"root", "staff"})
+		}
+		return t
+	}
+	z := archives.Zip{}
+	switch hzOldDrawInt(tc, 0, 5) {
+	case 0:
+		z.Compression = zip.Store
+	case 1, 2:
+		z.Compression = zip.Deflate
+	case 3:
+		z.Compression = archives.ZipMethodBzip2
+	case 4:
+		z.Compression = archives.ZipMethodZstd
+	case 5:
+		z.Compression = archives.ZipMethodXz
+		if HZKnown.zipXzHeaderOffset {
+			hzAvoid("zipXzHeaderOffset")
+			z.Compression = zip.Deflate
+		}
+	}
+	if hzOldChance(tc, 30) {
+		z.SelectiveCompression = true
+	}
+	return z
+}
+
+func hzFormatName(f archives.Format) string {
+	switch v := f.(type) {
+	case archives.Tar:
+		return fmt.Sprintf("Tar{%v}", v.Format)
+	case archives.Zip:
+		return fmt.Sprintf("Zip{method %d, selective %v}", v.Compression, v.SelectiveCompression)
+	case archives.CompressedArchive:
+		return hzFormatName(v.Archival) + "+" + hzFormatName(v.Compression)
+	case archives.Gz:
+		return fmt.Sprintf("Gz{%d, mt %v}", v.CompressionLevel, v.Multithreaded)
+	case archives.Bz2:
+		return fmt.Sprintf("Bz2{%d}", v.CompressionLevel)
+	case archives.Lz4:
+		return fmt.Sprintf("Lz4{%d}", v.CompressionLevel)
+	case archives.Brotli:
+		return fmt.Sprintf("Brotli{%d}", v.Quality)
+	case archives.Zlib:
+		return fmt.Sprintf("Zlib{%d}", v.CompressionLevel)
+	}
+	return fmt.Sprintf("%T", f)
+}
+
+// --------------------------------------------------------------------------- extraction
+
+type hzGot struct {
+	name   string
+	isDir  bool
+	isLink bool
+	mode   fs.FileMode
+	size   int64
+	data   []byte
+	link   string
+	mtime  time.Time
+	header any
+}
+
+// hzExtractAll walks the archive and reads every regular file inside the handler.
+func hzExtractAll(f archives.Extractor, data []byte) ([]hzGot, error) {
+	var got []hzGot
+	err := f.Extract(context.Background(), bytes.NewReader(data), func(ctx context.Context, fi archives.FileInfo) error {
+		g := hzGot{name: fi.NameInArchive, isDir: fi.IsDir(), isLink: fi.Mode()&fs.ModeSymlink != 0,
+			mode: fi.Mode(), size: fi.Size(), link: fi.LinkTarget, mtime: fi.ModTime(), header: fi.Header}
+		if !g.isDir && !g.isLink {
+			r, err := fi.Open()
+			if err != nil {
+				return fmt.Errorf("open %s: %w", fi.NameInArchive, err)
+			}
+			b, err := io.ReadAll(r)
+			r.Close()
+			if err != nil {
+				return fmt.Errorf("read %s: %w", fi.NameInArchive, err)
+			}
+			g.data = b
+		}
+		got = append(got, g)
+		return nil
+	})
+	return got, err
+}
+
+func hzGotNames(gs []hzGot) []string {
+	var ns []string
+	for _, g := range gs {
+		ns = append(ns, g.name)
+	}
+	return ns
+}
+
+// --------------------------------------------------------------------------- a byte buffer
+
+// hzBuffer is an in-memory io.ReadWriteSeeker + io.ReaderAt, like a file.
+type hzBuffer struct {
+	buf []byte
+	pos int64
+}
+
+func (p *hzBuffer) Read(b []byte) (int, error) {
+	if p.pos >= int64(len(p.buf)) {
+		return 0, io.EOF
+	}
+	n := copy(b, p.buf[p.pos:])
+	p.pos += int64(n)
+	return n, nil
+}
+
+func (p *hzBuffer) Write(b []byte) (int, error) {
+	end := p.pos + int64(len(b))
+	if end > int64(len(p.buf)) {
+		p.buf = append(p.buf, make([]byte, end-int64(len(p.buf)))...)
+	}
+	copy(p.buf[p.pos:], b)
+	p.pos = end
+	return len(b), nil
+}
+
+func (p *hzBuffer) Seek(off int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+		p.pos = off
+	case io.SeekCurrent:
+		p.pos += off
+	case io.SeekEnd:
+		p.pos = int64(len(p.buf)) + off
+	}
+	if p.pos < 0 {
+		return 0, fmt.Errorf("negative seek")
+	}
+	return p.pos, nil
+}
+
+func (p *hzBuffer) ReadAt(b []byte, off int64) (int, error) {
+	if off >= int64(len(p.buf)) {
+		return 0, io.EOF
+	}
+	n := copy(b, p.buf[off:])
+	if n < len(b) {
+		return n, io.EOF
+	}
+	return n, nil
+}
diff --git a/hegel/hegel_zoo_identify_test.go b/hegel/hegel_zoo_identify_test.go
new file mode 100644
index 0000000..d39ffb6
--- /dev/null
+++ b/hegel/hegel_zoo_identify_test.go
@@ -0,0 +1,738 @@
+package hegel
+
+// The Identify property: the case records (a content - random bytes, an empty stream, an
+// archive of a tree, a compressed stream, a truncated one - and a file name), their
+// generators, the documented model with the replicas of the recorded bugs threaded on the
+// switch set (identifyExpected, over the Identify replica of hegel_zoo_compression_test.go),
+// and the wide property.
+//
+// The model: Identify's doc comment (formats.go :24-39) says it "returns the one that
+// matches the given filename and/or stream", a compressed file, an archive or a compressed
+// archive; NoMatch when none matches; with a nil stream it matches on the name alone and
+// returns a nil reader; with a stream it returns the stream at its original position. By
+// name the formats match as the extension rules of their Match methods say (nameParts), and
+// a name ending in ".tgz" is a tar.gz archive (archiveExtensions, fs.go :940-952). By stream
+// a format matches its own writer's output: an archive its archiver's, a compression its
+// writer's (a complete one; a truncated stream is matched by what the decoders make of it,
+// decodeStep), and an empty stream matches nothing. When the name and the stream point at
+// different formats the comment leaves the choice open: the answer is one of the name's, the
+// stream's or the name's archive under the stream's compression, and the same on every call.
+// The answers left open ("?" today): random bytes, an empty tar (1024 zero bytes, nothing
+// to match: the README's "Not judged"; under a compression the compression alone), and the
+// Sz and MinLZ streams of an empty input (no stream header). The checks: "name format" (the
+// extension or "NoMatch", for a name), "name reader" ("nil"), "built" ("ok" or the error
+// kind of the archiver or writer that makes the stream), and over six calls with the stream
+// (seekable and not, three each) "stream answer" (the set of answers: an extension,
+// "NoMatch", "error", "panic"), "stream error" (the set of error kinds, "none"), "stream
+// consistent" ("same": every call gives the same answer, error kind and archival name in
+// the error's "matching <name>: " prefix; the replicas state "varies by name only" (the
+// answer and kind agree, the name does not: archives/19), "differs by seekability" (the
+// seekable calls agree among themselves and the buffered ones among themselves, in answer
+// and kind, and the two differ: archives/28); "varies" otherwise), "stream returned"
+// ("whole").
+
+import (
+	"archive/tar"
+	"archive/zip"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the records
+
+// archFormat is a Tar or a Zip with its options (the old hzArchival's population): Format
+// 0..3 (unknown, USTAR, PAX, GNU), NumericUIDGID, Uid/Gid, Uname/Gname; the zip method and
+// SelectiveCompression. ZipMethodXz is not in the pool: a zip written with it cannot be read
+// (archives/1, part 3's), and the archive is the case's construction, not its subject.
+type archFormat struct {
+	Kind          string
+	TarFormat     int
+	NumericUIDGID bool
+	Uid, Gid      int
+	Uname, Gname  string
+	ZipMethod     uint16
+	Selective     bool
+}
+
+// Format is the archives.Archival value.
+func (a archFormat) Format() archives.Archival {
+	if a.Kind == "zip" {
+		return archives.Zip{Compression: a.ZipMethod, SelectiveCompression: a.Selective}
+	}
+	t := archives.Tar{NumericUIDGID: a.NumericUIDGID, Uid: a.Uid, Gid: a.Gid, Uname: a.Uname, Gname: a.Gname}
+	switch a.TarFormat {
+	case 1:
+		t.Format = tar.FormatUSTAR
+	case 2:
+		t.Format = tar.FormatPAX
+	case 3:
+		t.Format = tar.FormatGNU
+	}
+	return t
+}
+
+func (a archFormat) String() string {
+	if a.Kind == "zip" {
+		return fmt.Sprintf("Zip{method %d, selective %v}", a.ZipMethod, a.Selective)
+	}
+	s := fmt.Sprintf("Tar{%v", []string{"unknown", "USTAR", "PAX", "GNU"}[a.TarFormat])
+	if a.NumericUIDGID {
+		s += ", numeric"
+	}
+	if a.Uid != 0 {
+		s += fmt.Sprintf(", uid %d gid %d", a.Uid, a.Gid)
+	}
+	if a.Uname != "" {
+		s += fmt.Sprintf(", %q:%q", a.Uname, a.Gname)
+	}
+	return s + "}"
+}
+
+// identifyContent is the content of a case: Kind "random" (Random, 0..64 bytes), "empty",
+// "archive" (Tree written by Arch, under Comp when Comp.Kind is set), "stream" (Payload
+// written by Comp), "truncated" (the same, cut to Cut bytes).
+type identifyContent struct {
+	Kind    string
+	Random  []byte
+	Tree    []fileEntry
+	Arch    archFormat
+	Comp    compFormat
+	Payload []byte
+	Cut     int
+}
+
+func (ct identifyContent) String() string {
+	switch ct.Kind {
+	case "random":
+		return fmt.Sprintf("random %d bytes % x", len(ct.Random), headOf(ct.Random, 12))
+	case "empty":
+		return "an empty stream"
+	case "archive":
+		s := fmt.Sprintf("%v of %d entries", ct.Arch, len(ct.Tree))
+		if ct.Comp.Kind != "" {
+			s += fmt.Sprintf(" under %v", ct.Comp)
+		}
+		return s + "\n" + strings.TrimRight(treeString(ct.Tree), "\n")
+	case "stream":
+		return fmt.Sprintf("%v stream of %d bytes (%s)", ct.Comp, len(ct.Payload), payloadKind(ct.Payload))
+	}
+	return fmt.Sprintf("%v stream of %d bytes (%s) cut to %d", ct.Comp, len(ct.Payload), payloadKind(ct.Payload), ct.Cut)
+}
+
+// identifyCase is one case: the content and the file name given to Identify.
+type identifyCase struct {
+	Content identifyContent
+	Name    string
+	notes   []string // what the library left (the explanation of a failure)
+}
+
+func (c identifyCase) GoString() string {
+	s := fmt.Sprintf("identifyCase{name %q, %v}", c.Name, c.Content)
+	for _, n := range c.notes {
+		s += "\n  " + n
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- the generators
+
+// tarFormats: the format 0..3 evenly (at one weight each the fair bits realised 26/18/30/27
+// over two seeds, the builder's USTAR-to-PAX rule taking two points of USTAR; at the
+// weights 5/7/4/4 realised 25/25/26/24), NumericUIDGID at 20 (realised 19), Uid and Gid
+// 1..70000 at 20 (realised 21; hegel.Integers, a leaf, as entryTime: a halving tree over
+// seventy thousand values would be built on every draw), Uname and Gname at 20 (realised 19).
+var (
+	tarIDs   = dieMaybe(20, hzTuple(hegel.Integers(1, 70000), hegel.Integers(1, 70000)))
+	tarNames = dieMaybe(20, hzTuple(evenHalves("root", "user", "a name with spaces"), evenHalves("root", "staff")))
+)
+
+var tarFormats = hegel.FlatMap(halvesOver([]int{5, 7, 4, 4}, 0, 1, 2, 3), func(tf int) hegel.Generator[archFormat] {
+	return hegel.FlatMap(dieCoin(20), func(numeric bool) hegel.Generator[archFormat] {
+		return hegel.FlatMap(tarIDs, func(ids []int) hegel.Generator[archFormat] {
+			return hegel.Map(tarNames, func(names []string) archFormat {
+				a := archFormat{Kind: "tar", TarFormat: tf, NumericUIDGID: numeric}
+				if ids != nil {
+					a.Uid, a.Gid = ids[0], ids[1]
+				}
+				if names != nil {
+					a.Uname, a.Gname = names[0], names[1]
+				}
+				return a
+			})
+		})
+	})
+})
+
+// zipFormats: the method store 1, deflate 2, bzip2 1, zstd 1 of five (at those weights the
+// halving bits realised 25/36/26/13 over two seeds; at the weights 4/8/4/6 below realised
+// 20/39/20/21; the old pool's sixth share, xz, left out), SelectiveCompression at 30
+// (realised 24; the bits of the ninth draw lean towards false).
+var zipFormats = hegel.FlatMap(halvesOver([]int{4, 8, 4, 6}, zip.Store, zip.Deflate, uint16(archives.ZipMethodBzip2), uint16(archives.ZipMethodZstd)), func(m uint16) hegel.Generator[archFormat] {
+	return hegel.Map(dieCoin(30), func(sel bool) archFormat { return archFormat{Kind: "zip", ZipMethod: m, Selective: sel} })
+})
+
+// archFormats: a tar or a zip, half each (realised 50/50).
+var archFormats = halvesGens([]int{1, 1}, tarFormats, zipFormats)
+
+// treesBetween is a tree of lo to hi entries (treesOf with a floor).
+func treesBetween(lo, hi int) hegel.Generator[[]fileEntry] {
+	return hegel.Map(hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]fileEntry] { return treeFrom(nil, n) }), settle)
+}
+
+// isASCIIName reports whether a name is ASCII (USTAR cannot encode another).
+func isASCIIName(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= utf8.RuneSelf {
+			return false
+		}
+	}
+	return true
+}
+
+// buildArchiveContent is the archive content of a tree: a USTAR tar of a tree with a
+// non-ASCII name or link target takes PAX (archive/tar's "USTAR cannot encode" is the
+// README's "Not judged"; the builder's rule, not a filter).
+func buildArchiveContent(a archFormat, tree []fileEntry, comp compFormat) identifyContent {
+	if a.Kind == "tar" && a.TarFormat == 1 {
+		for _, e := range tree {
+			if !isASCIIName(e.Path) || !isASCIIName(e.Link) {
+				a.TarFormat = 2
+			}
+		}
+	}
+	return identifyContent{Kind: "archive", Tree: tree, Arch: a, Comp: comp}
+}
+
+// The contents: random bytes 0..64 (hegel.Binary), an empty stream, an archive of a tree of
+// up to four entries (zip: under HEGEL_NO_KNOWN=1 of one to four, the empty zip being the
+// shape of archives/9) by a tar or a zip, a tar under a compression half the time (realised
+// 50), a compressed stream of a payload, a truncated one cut to 0..12 bytes (an lzip stream
+// to 0 under HEGEL_NO_KNOWN=1: the cuts 6..12 panic, archives/20, and 1..5 are the header
+// read two ways, archives/28).
+var (
+	randomContent = hegel.Map(hegel.Binary(0, 64), func(b []byte) identifyContent { return identifyContent{Kind: "random", Random: b} })
+	emptyContent  = hegel.Just(identifyContent{Kind: "empty"})
+
+	archiveContent = hegel.FlatMap(archFormats, func(a archFormat) hegel.Generator[identifyContent] {
+		trees := treesOf(4)
+		if hzNoKnown && a.Kind == "zip" {
+			trees = treesBetween(1, 4)
+		}
+		return hegel.FlatMap(trees, func(tree []fileEntry) hegel.Generator[identifyContent] {
+			comp := hegel.Just(compFormat{})
+			if a.Kind == "tar" {
+				comp = dieMaybe(50, compFormats)
+			}
+			return hegel.Map(comp, func(cf compFormat) identifyContent { return buildArchiveContent(a, tree, cf) })
+		})
+	})
+
+	streamContent = hegel.FlatMap(compFormats, func(f compFormat) hegel.Generator[identifyContent] {
+		return hegel.Map(payloadFor(f.Kind), func(p []byte) identifyContent { return identifyContent{Kind: "stream", Comp: f, Payload: p} })
+	})
+
+	truncatedContent = hegel.FlatMap(compFormats, func(f compFormat) hegel.Generator[identifyContent] {
+		return hegel.FlatMap(payloadFor(f.Kind), func(p []byte) hegel.Generator[identifyContent] {
+			cut := rangeHalves(0, 12)
+			if hzNoKnown && f.Kind == "lz" {
+				// the cuts 6..12 are archives/20, 1..5 archives/28: the empty stream alone
+				cut = hegel.Just(0)
+			}
+			return hegel.Map(cut, func(n int) identifyContent { return identifyContent{Kind: "truncated", Comp: f, Payload: p, Cut: n} })
+		})
+	})
+
+	// identifyContents: the kinds at today's shares, the archive two of six; at the weights
+	// 1/1/2/1/1 the fair bits of the first cut realised 30 for the first two kinds and the
+	// archive 37 (two seeds), so the first two are weighted up: random 11, empty 11,
+	// archive 18, stream 10, truncated 10 (realised over two runs of 3000: 18/15/32/17/18).
+	identifyContents = halvesGens([]int{11, 11, 18, 10, 10}, randomContent, emptyContent, archiveContent, streamContent, truncatedContent)
+)
+
+// The name pools (the old property's, byte for byte): the neutral or misleading names, the
+// archive extensions, the odd spellings and the compression extensions.
+var (
+	neutralNames    = []string{"x.txt", "noext", "x.bak", "dir/x.dat", "x.tgz", "x.tbz2", "x.TAR.GZ", ".tar", "x.tar.txt", "x.tar.gz.bak"}
+	archiveNames    = []string{".zip", ".tar", ".7z", ".rar", ".tar.gz", ".tar.zst", ".zip.gz"}
+	oddNames        = []string{"X.ZIP", "x.Tar", "a/b/x.tar.bz2", "x.s2", "x.tar.s2"}
+	compressionExts = []string{".gz", ".bz2", ".xz", ".zst", ".lz4", ".br", ".sz", ".s2", ".lz", ".zz", ".mz"}
+)
+
+// contentExt is the extension the content's stream is documented to identify as, "" where
+// the answer is open or the stream is truncated (the name "x.bin" then, as today).
+func contentExt(ct identifyContent) string {
+	switch ct.Kind {
+	case "archive":
+		if ct.Arch.Kind == "zip" {
+			return ".zip"
+		}
+		if len(ct.Tree) == 0 {
+			if ct.Comp.Kind != "" {
+				return ct.Comp.Ext()
+			}
+			return ""
+		}
+		if ct.Comp.Kind != "" {
+			return ".tar" + ct.Comp.Ext()
+		}
+		return ".tar"
+	case "stream":
+		if (ct.Comp.Kind == "sz" || ct.Comp.Kind == "mz") && len(ct.Payload) == 0 {
+			return ""
+		}
+		return ct.Comp.Ext()
+	}
+	return ""
+}
+
+// nameKind classes a name for the tallies: "none", "own" (the content's extension or
+// x.bin), "neutral", "compression", "archive", "odd".
+func nameKind(c identifyCase) string {
+	switch {
+	case c.Name == "":
+		return "none"
+	case c.Name == "x.bin" || c.Name == "x"+contentExt(c.Content):
+		return "own"
+	case containsString(neutralNames, c.Name):
+		return "neutral"
+	case containsString(oddNames, c.Name):
+		return "odd"
+	case strings.HasPrefix(c.Name, "x") && containsString(archiveNames, c.Name[1:]):
+		return "archive"
+	}
+	return "compression"
+}
+
+// namesFor is the name of a case with the content: none, "x" with the content's extension
+// (or x.bin), a neutral or misleading name, "x" with a compression extension, "x" with an
+// archive extension, an odd spelling, a sixth each (realised 17 each). Under
+// HEGEL_NO_KNOWN=1 the names that contradict the content are at weight zero (the shape of
+// archives/19: the compression, archive and odd kinds, and the neutral pool's x.tgz
+// (archives/26 too), x.TAR.GZ, .tar, x.tar.txt and x.tar.gz.bak).
+func namesFor(ct identifyContent) hegel.Generator[string] {
+	own := "x.bin"
+	if ext := contentExt(ct); ext != "" {
+		own = "x" + ext
+	}
+	w := hzUnless(hzNoKnown, 1)
+	neutral := halvesOver([]int{1, 1, 1, 1, w, 1, w, w, w, w}, neutralNames...)
+	return halvesGens([]int{1, 1, 1, w, w, w},
+		hegel.Just(""),
+		hegel.Just(own),
+		neutral,
+		hegel.Map(evenHalves(compressionExts...), func(e string) string { return "x" + e }),
+		hegel.Map(evenHalves(archiveNames...), func(e string) string { return "x" + e }),
+		evenHalves(oddNames...))
+}
+
+// identifyCases is the cases of the wide property.
+var identifyCases = hegel.FlatMap(identifyContents, func(ct identifyContent) hegel.Generator[identifyCase] {
+	return hegel.Map(namesFor(ct), func(name string) identifyCase { return identifyCase{Content: ct, Name: name} })
+})
+
+// --------------------------------------------------------------------------- the model
+
+// identifyBuilt is the stream the property built before the judgement: the bytes, the
+// length before a truncation, and the archiver's or writer's error.
+type identifyBuilt struct {
+	Data []byte
+	Full int
+	Err  error
+}
+
+// streamOfIdentify is the idStream of a case's content.
+func streamOfIdentify(c identifyCase, built identifyBuilt) idStream {
+	ct := c.Content
+	st := idStream{Bytes: built.Data, InnerKind: "none"}
+	switch ct.Kind {
+	case "archive":
+		if ct.Comp.Kind != "" {
+			st.Own, st.InnerKind = ct.Comp.Kind, "tar"
+			if len(ct.Tree) == 0 {
+				st.InnerKind = "emptytar"
+			}
+		}
+	case "stream", "truncated":
+		if ct.Kind == "stream" || ct.Cut >= built.Full {
+			st.Own, st.Inner, st.InnerKind = ct.Comp.Kind, ct.Payload, "payload"
+			switch ct.Comp.Kind {
+			case "sz", "mz", "lz":
+				st.Headerless = len(ct.Payload) == 0
+			}
+		}
+	}
+	return st
+}
+
+// nameAnswers is the documented answer of Identify by name alone: the compressed archive,
+// the archive or the compression the name's parts say, "NoMatch" for none.
+func nameAnswers(name string, k known) []string {
+	comp, archs := nameParts(identifyBase(name), k)
+	if comp == "" && len(archs) == 0 {
+		return []string{"NoMatch"}
+	}
+	if len(archs) == 0 {
+		return []string{"." + comp}
+	}
+	var out []string
+	for _, a := range archs {
+		if comp != "" {
+			out = append(out, "."+a+"."+comp)
+		} else {
+			out = append(out, "."+a)
+		}
+	}
+	return out
+}
+
+// identifyExpected states every value the property checks for the case under the switch
+// set, given the stream the property built.
+func identifyExpected(c identifyCase, k known, built identifyBuilt) checks {
+	out := checks{}
+	ct := c.Content
+	if c.Name != "" {
+		out["name format"] = hzSet(nameAnswers(c.Name, k)...)
+		out.set("name reader", "nil")
+	}
+	// archives/10: the Lz4 writer of the construction fails to open (lz4.go :43-48)
+	if k[kLz4CompressionLevel] && ct.Comp.Kind == "lz4" && ct.Comp.Level != 0 {
+		out.set("built", "error: invalid compression level")
+		return out
+	}
+	out.set("built", "ok")
+	st := streamOfIdentify(c, built)
+	open := ct.Kind == "random" ||
+		(ct.Kind == "archive" && ct.Arch.Kind == "tar" && ct.Comp.Kind == "" && len(ct.Tree) == 0) ||
+		(st.Headerless && st.Own != "lz")
+	stream := identifyOutcomes("", st, k)
+	res := identifyOutcomes(c.Name, st, k)
+	var answers, errs []string
+	if !open {
+		// the documented answers: the name's, the stream's, and the name's archive under
+		// the stream's compression
+		_, nameArchs := nameParts(identifyBase(c.Name), k)
+		if c.Name != "" {
+			for _, a := range nameAnswers(c.Name, k) {
+				if a != "NoMatch" {
+					answers = append(answers, a)
+				}
+			}
+		}
+		for _, a := range stream.Answers {
+			if a != "NoMatch" {
+				answers = append(answers, a)
+			}
+			if containsString(compKinds, strings.TrimPrefix(a, ".")) {
+				for _, arch := range nameArchs {
+					answers = append(answers, "."+arch+a)
+				}
+			}
+		}
+		if len(answers) == 0 {
+			answers = []string{"NoMatch"}
+		}
+		answers = uniqueStrings(answers)
+		errs = stream.Errs
+	}
+	consistent := "same"
+	// archives/19: Identify ranges over the formats map (formats.go :53, :73), so where
+	// several formats match the first in iteration order answers, and the order changes
+	// from call to call; an error from the archival loop (:82) names the archival format
+	// first in that order, so the name in the message varies where the answer does not
+	// (a decoder's failure known to the replica, not the "?" of a decoder the library
+	// panics in, archives/20)
+	if k[kIdentifyNondeterministic] {
+		oneOfThem := !res.Varies && len(res.Answers) == 1 && (open || containsString(answers, res.Answers[0]))
+		if !oneOfThem {
+			open = false
+			answers, errs = res.Answers, res.Errs
+		}
+		switch {
+		case res.Varies:
+			consistent = hzUnspecified
+		case containsString(res.Answers, "error") && !containsString(res.Errs, "?"):
+			consistent = "varies by name only"
+		}
+	}
+	// archives/28: lzip-go reads the header with one Read (reader.go :31); a seekable stream
+	// is read directly and the decoder judges the partial header, while the buffered
+	// rewindReader (formats.go :353-393) returns the replayed bytes together with io.EOF,
+	// which the decoder reports as is: the seekable trio of calls fails with the decoder's
+	// kind, the buffered trio with "eof" (where the answer also varies by map order, the
+	// error set alone says so: archives/19 is named first). On a five-byte stream
+	// Lzip.Match's own four-byte read leaves a byte, and whether the replayed bytes come
+	// with io.EOF depends on which matcher read last (map order): the buffered trio is
+	// "eof" or the decoder's kind, call by call.
+	consistents := []string{consistent}
+	if consistent == "varies by name only" {
+		// six calls can draw the same name (one in a thousand at four names, more where
+		// the map's buckets skew the order)
+		consistents = append(consistents, "same")
+	}
+	if k[kIdentifyLzipHeaderSeekability] && res.LzipShort {
+		if !open {
+			errs = append(errs, "eof")
+		}
+		if !res.Varies {
+			consistents = []string{"differs by seekability"}
+			if len(st.Bytes) == 5 {
+				consistents = append(consistents, "varies")
+			}
+		}
+	}
+	if open {
+		out.unspecified("stream answer")
+		out.unspecified("stream error")
+	} else {
+		out["stream answer"] = hzSet(answers...)
+		for _, a := range answers {
+			if a != "error" {
+				errs = append(errs, "none")
+				break
+			}
+		}
+		if containsString(errs, "?") {
+			out.unspecified("stream error")
+		} else {
+			out["stream error"] = hzSet(errs...)
+		}
+	}
+	out["stream consistent"] = hzSet(consistents...)
+	if consistent == hzUnspecified {
+		out.unspecified("stream consistent")
+	}
+	if containsString(answers, "panic") {
+		out.unspecified("stream returned")
+	} else {
+		out.set("stream returned", "whole")
+	}
+	return out
+}
+
+func init() {
+	for i, name := range []string{"name format", "name reader", "built", "stream answer", "stream error", "stream consistent", "stream returned"} {
+		checkRank[name] = 200 + i
+	}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// identifyBuild makes the stream of the case with the library's writers: FilesFromFS and
+// Archive for an archive (a CompressedArchive under a compression), OpenWriter, Write and
+// Close for a compressed stream (no Write for an empty payload, as io.Copy makes none for an
+// empty source), then the cut for a truncated one.
+func identifyBuild(c identifyCase) identifyBuilt {
+	ct := c.Content
+	ctx := context.Background()
+	var buf bytes.Buffer
+	switch ct.Kind {
+	case "random":
+		return identifyBuilt{Data: ct.Random, Full: len(ct.Random)}
+	case "empty":
+		return identifyBuilt{Data: []byte{}}
+	case "archive":
+		files, err := archives.FilesFromFS(ctx, treeMapFS(ct.Tree), nil, nil)
+		if err != nil {
+			return identifyBuilt{Err: err}
+		}
+		var format archives.Archiver = ct.Arch.Format().(archives.Archiver)
+		if ct.Comp.Kind != "" {
+			t := ct.Arch.Format().(archives.Tar)
+			format = archives.CompressedArchive{Archival: t, Extraction: t, Compression: ct.Comp.Format()}
+		}
+		if err := format.Archive(ctx, &buf, files); err != nil {
+			return identifyBuilt{Err: err}
+		}
+		return identifyBuilt{Data: buf.Bytes(), Full: buf.Len()}
+	}
+	w, err := ct.Comp.Format().OpenWriter(&buf)
+	if err != nil {
+		return identifyBuilt{Err: err}
+	}
+	if len(ct.Payload) > 0 {
+		if _, err := w.Write(ct.Payload); err != nil {
+			return identifyBuilt{Err: err}
+		}
+	}
+	if err := w.Close(); err != nil {
+		return identifyBuilt{Err: err}
+	}
+	data := buf.Bytes()
+	full := len(data)
+	if ct.Kind == "truncated" && ct.Cut < len(data) {
+		data = data[:ct.Cut]
+	}
+	return identifyBuilt{Data: data, Full: full}
+}
+
+// identifyActual asks the library the questions identifyExpected answered: the name alone,
+// then rounds calls each with a seekable and a non-seekable reader.
+func identifyActual(c *identifyCase, built identifyBuilt, rounds int) checks {
+	out := checks{}
+	ctx := context.Background()
+	if c.Name != "" {
+		f, r, err := archives.Identify(ctx, c.Name, nil)
+		switch {
+		case errors.Is(err, archives.NoMatch):
+			out.set("name format", "NoMatch")
+		case err != nil:
+			out.set("name format", "error")
+			c.notes = append(c.notes, "Identify by name: "+err.Error())
+		default:
+			out.set("name format", f.Extension())
+		}
+		if r == nil {
+			out.set("name reader", "nil")
+		} else {
+			out.set("name reader", fmt.Sprintf("%T", r))
+		}
+	}
+	if built.Err != nil {
+		out.set("built", "error: "+errKind(built.Err))
+		return out
+	}
+	out.set("built", "ok")
+	data := built.Data
+	c.notes = append(c.notes, fmt.Sprintf("stream of %d bytes: % x", len(data), headOf(data, 16)))
+	type outcome struct {
+		answer, err, name string
+		seekable          bool
+	}
+	var outcomes []outcome
+	var answers, errs, returned []string
+	for i := 0; i < rounds; i++ {
+		for _, seekable := range []bool{true, false} {
+			var r io.Reader = bytes.NewReader(data)
+			if !seekable {
+				r = struct{ io.Reader }{bytes.NewReader(data)}
+			}
+			var f archives.Format
+			var rest io.Reader
+			var err error
+			if p := hzCall(func() { f, rest, err = archives.Identify(ctx, c.Name, r) }); p != nil {
+				outcomes = append(outcomes, outcome{answer: "panic", seekable: seekable})
+				answers = append(answers, "panic")
+				returned = append(returned, "panic")
+				c.notes = append(c.notes, fmt.Sprintf("Identify(%q, seekable %v) panicked: %v", c.Name, seekable, p))
+				continue
+			}
+			o := outcome{seekable: seekable}
+			switch {
+			case errors.Is(err, archives.NoMatch):
+				o.answer = "NoMatch"
+			case err != nil:
+				o.answer, o.err, o.name = "error", errKindOfText(stripMatching(err.Error())), matchingName(err.Error())
+				errs = append(errs, o.err)
+				c.notes = append(c.notes, fmt.Sprintf("Identify(%q, seekable %v): %v", c.Name, seekable, err))
+			default:
+				o.answer = f.Extension()
+			}
+			outcomes = append(outcomes, o)
+			answers = append(answers, o.answer)
+			switch {
+			case rest == nil:
+				returned = append(returned, "nil reader")
+			default:
+				back, rerr := io.ReadAll(rest)
+				switch {
+				case rerr != nil:
+					returned = append(returned, "read error: "+rerr.Error())
+				case !bytes.Equal(back, data):
+					returned = append(returned, fmt.Sprintf("%d bytes back", len(back)))
+				default:
+					returned = append(returned, "whole")
+				}
+			}
+		}
+	}
+	out["stream answer"] = hzSet(answers...)
+	if len(errs) == 0 {
+		errs = []string{"none"}
+	}
+	out["stream error"] = hzSet(errs...)
+	// the consistency of the calls: the (answer, kind) pairs of the seekable calls and of
+	// the buffered ones, and the archival names the errors carry
+	pairs := map[bool]map[string]bool{true: {}, false: {}}
+	names := map[string]bool{}
+	for _, o := range outcomes {
+		pairs[o.seekable][o.answer+"|"+o.err] = true
+		if o.name != "" {
+			names[o.name] = true
+		}
+	}
+	consistent := "varies"
+	if len(pairs[true]) == 1 && len(pairs[false]) == 1 {
+		consistent = "differs by seekability"
+		for p := range pairs[true] {
+			if pairs[false][p] {
+				consistent = "same"
+				if len(names) > 1 {
+					consistent = "varies by name only"
+				}
+			}
+		}
+	}
+	out.set("stream consistent", consistent)
+	out["stream returned"] = hzSet(returned...)
+	return out
+}
+
+// --------------------------------------------------------------------------- the property
+
+// identifyJudgeOver is the judge of the family: the stream built with the library's writers
+// (the case's construction: its failure is the check "built"), then the judgement over
+// identifyExpected and identifyActual with rounds calls of each kind. The checks the
+// switches past change on their own are left out of the model (the narrow property of
+// archives/28 is judged past 19, which every such stream also has); under HEGEL_NO_KNOWN=1
+// the checks the switches drops change on their own are dropped from a case rather than the
+// case skipped (judgeByDropping: the wide property drops 19's, since the archival name in
+// an error varies for any stream a decoder rejects, a truncated one included).
+func identifyJudgeOver(rounds int, past, drops []int) func(j *hzCaseJudge, c identifyCase) {
+	return func(j *hzCaseJudge, c identifyCase) {
+		hzTally("content " + c.Content.Kind)
+		hzTally("name " + nameKind(c))
+		if c.Content.Comp.Kind != "" {
+			hzTally("compression " + c.Content.Comp.Kind)
+		}
+		built := identifyBuild(c)
+		expected := func(c identifyCase, k known) checks { return identifyExpected(c, k, built) }
+		if len(past) > 0 {
+			expected = pastSwitches(expected, past)
+		}
+		actual := func(c *identifyCase) checks { return identifyActual(c, built, rounds) }
+		if len(drops) > 0 {
+			judgeByDropping(j, &c, expected, actual, drops)
+			return
+		}
+		judgeBy(j, &c, expected, actual)
+	}
+}
+
+// identifyJudgeWith is identifyJudgeOver with nothing past or dropped: the narrow
+// properties of archives/9, 19, 20 and 26 (19 with six rounds, twelve calls).
+func identifyJudgeWith(rounds int) func(j *hzCaseJudge, c identifyCase) {
+	return identifyJudgeOver(rounds, nil, nil)
+}
+
+// TestHegelIdentify: Identify names a format from the bytes alone (an archive, a compressed
+// stream, a compressed archive), from a file name alone by the documented extension rules,
+// and returns the stream unread whatever it decides; the same input gives the same answer on
+// every call; nothing panics on arbitrary or truncated bytes. The shapes of the recorded bugs
+// (an empty zip, an Lz4 level, a name that contradicts the stream or an error whose archival
+// name varies, a truncated lzip stream, an empty Lzip input, a long brotli stream, a .tgz
+// name, an lzip header cut short) are drawn at their natural rates and fail naming the bug;
+// under HEGEL_NO_KNOWN=1 they are not drawn, the checks of archives/19 are dropped from a
+// case that still has its shape (an error's archival name), and a case the classifier still
+// names is skipped by the judge.
+func TestHegelIdentify(t *testing.T) {
+	judged(t, identifyCases, identifyJudgeOver(3, nil, []int{kIdentifyNondeterministic}))
+}
diff --git a/hegel/hegel_zoo_idioms_test.go b/hegel/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..0e7ac8a
--- /dev/null
+++ b/hegel/hegel_zoo_idioms_test.go
@@ -0,0 +1,619 @@
+package hegel
+
+// The generator idioms the properties share, copied from the excelize/graphql-go/cobra/
+// cascadia/carbon/orb/chi/go-debian/gin/cellbuf/kong/roaring/mergo/gotext/go-envconfig/
+// gronx/gval harness (hegel_zoo_idioms_test.go there) with the hz prefix: hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator. Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on it,
+// except the shape of a recorded bug a wide property must reach every run, which goes first
+// at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a
+// weighted choice drawn alone comes out exact (the engine enumerates a small die), but inside
+// a case with other draws the engine favours the small values of any bounded draw at every
+// scale (go/chi and go/go-debian measured it: Integers(0, 99) lands in 0..9 about 29 percent
+// of the time, coins realise about 0.83 of nominal), so the rates are what the probe and the
+// collector (HEGEL_COLLECT=1) measure; hzFair, fairOver, fairInts, evenOver and fairTree
+// (from go/chi) re-roll the favourite face, the die* family (from go/go-debian) draws from
+// fair bits, the halving helpers at the end (from go/gin and go/kong: evenHalves,
+// rangeHalves, countedHalves, halvesOver, halvesGens, evenGens) halve a range by fair bits,
+// and the figure beside every weight in the generator files is the measured one.
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	from   hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, from: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](parts ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(parts))
+		for i, g := range parts {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](parts ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range parts {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].from
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].from
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var subtrees []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			subtrees = append(subtrees, hegel.Just(vs[i]))
+		} else {
+			subtrees = append(subtrees, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(subtrees)), func(i int) hegel.Generator[T] { return subtrees[i] })
+	}
+	choices := make([]hzChoice[T], len(subtrees))
+	for i, g := range subtrees {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// --------------------------------------------------------------------------- added for
+// go/gin: evenHalves is a table at one weight each drawn by halving: a fair-bit choice
+// between the two halves at their sizes (dieChoice), and each half again, down to one value;
+// the first value is the shrink target. dieTree's three-way splits (hzDie(3)) realised their
+// last face at 12 to 27 instead of 33 in gin's harness, so even tables are halved instead.
+// rangeHalves is the integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
+
+// --------------------------------------------------------------------------- added for
+// go/kong (halvesOver, halvesGens) and go/mergo (evenGens): weighted and even choices over
+// generators drawn by halving.
+
+// halvesOver is a table at the weights (the first value the shrink target) drawn by halving
+// like evenHalves (the go/kong helper): the entries are cut where the cumulative weight is
+// nearest half, a fair-bit choice between the two parts at their summed weights (dieChoice),
+// and each part again, down to one value. Every split is two-way; an entry of weight zero is
+// never drawn.
+func halvesOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	gens := make([]hegel.Generator[T], len(values))
+	for i, v := range values {
+		gens[i] = hegel.Just(v)
+	}
+	return halvesGens(weights, gens...)
+}
+
+// halvesGens is halvesOver over generators: the alternatives of a weighted choice at their
+// weights, drawn by halving (the first the shrink target).
+func halvesGens[T any](weights []int, gens ...hegel.Generator[T]) hegel.Generator[T] {
+	if len(weights) != len(gens) {
+		panic("halvesGens: weights and generators differ in length")
+	}
+	var ws []int
+	var gs []hegel.Generator[T]
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			gs = append(gs, gens[i])
+		}
+	}
+	if len(gs) == 0 {
+		panic("halvesGens: every alternative has weight 0")
+	}
+	if len(gs) == 1 {
+		return gs[0]
+	}
+	total := 0
+	for _, w := range ws {
+		total += w
+	}
+	cut, acc, best := 1, 0, -1
+	for i := 1; i < len(gs); i++ {
+		acc += ws[i-1]
+		d := 2*acc - total
+		if d < 0 {
+			d = -d
+		}
+		if best < 0 || d < best {
+			cut, best = i, d
+		}
+	}
+	left := 0
+	for _, w := range ws[:cut] {
+		left += w
+	}
+	return dieChoice(hzW(left, halvesGens(ws[:cut], gs[:cut]...)), hzW(total-left, halvesGens(ws[cut:], gs[cut:]...)))
+}
+
+// evenGens is halvesGens at one weight each.
+func evenGens[T any](gens ...hegel.Generator[T]) hegel.Generator[T] {
+	ws := make([]int, len(gens))
+	for i := range ws {
+		ws[i] = 1
+	}
+	return halvesGens(ws, gens...)
+}
diff --git a/hegel/hegel_zoo_judge_test.go b/hegel/hegel_zoo_judge_test.go
new file mode 100644
index 0000000..53e21fe
--- /dev/null
+++ b/hegel/hegel_zoo_judge_test.go
@@ -0,0 +1,1086 @@
+package hegel
+
+// The harness of the rewritten properties (the go/excelize ... go/gronx/go/gval judge): hzOpts
+// and hzProperty, the collector with the shrink budget, the known value with one switch per
+// recorded bug, the case judge, the judged runner, the checks and the classifier. The old
+// harness of hegel_zoo_test.go (HZKnown, hzAvoid, hzOld*) stays beside it for the five
+// properties the later parts rewrite.
+//
+// The model of a family is a pure function expected(c, k) checks of a case record and a
+// switch set: with every switch off (hzKnownNone) it states the documented behaviour, which the
+// properties judge the library against; with a switch on it reproduces that bug as a replica
+// of the library's rule, transcribed from archives.go and fs.go at the lines named beside the
+// switch. The classifier shapeBy runs the model per switch BEFORE the library is called and
+// names the recorded bug whose shape the case has; a mismatch then fails "(the shape of
+// archives/N)". Under HEGEL_NO_KNOWN=1 the shapes are not drawn (a weight of zero), filtered
+// out by the classifier (withoutShapes, hzOnly) or their checks dropped (judgeByDropping),
+// and the narrow properties draw the region past the shape (hzShaped, regionOf). A check the
+// documentation leaves open is the marker "unspecified": the judge does not compare it
+// (counted "unspecified check"), the classifier compares it like any other value.
+// HEGEL_COLLECT=1 (or ZOO_COLLECT=1) makes the properties record their mismatches instead of
+// failing and print the counts ("COLLECT TestHegel...: N mismatches; ...", "MISMATCH ...").
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hzOpts passes HEGEL_TEST_CASES, HEGEL_SEED and HEGEL_VERBOSE through to the engine, which
+// reads no environment variable itself (the seed is for the rate measurements of the probe
+// and the collector), and asks for one failure per run for the shrink budget.
+func hzOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	if hzShrinkBudget > 0 {
+		// The shrink budget: one failure per run (the engine otherwise generates on while
+		// the cases fail, ten times the count on a property that always fails, and its
+		// re-run of the failures before shrinking would meet a rejected attempt and end the
+		// run as "flaky" with nothing printed).
+		opts = append(opts, hegel.WithReportMultipleFailures(false))
+	}
+	return opts
+}
+
+// hzCases is the case count of a run: HEGEL_TEST_CASES, else the engine's default of 100.
+func hzCases() int {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return v
+		}
+	}
+	return 100
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through; extra options come after hzOpts (a property's own
+// case count).
+func hzProperty(t *testing.T, fn func(ht *hegel.T), extra ...hegel.Option) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, append(hzOpts(), extra...)...)
+}
+
+var hzCollecting = os.Getenv("HEGEL_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+	fails  int    // failing judgements so far (the shrink budget)
+	budget int    // the failing judgements allowed, set at the first failure
+	cap    int    // a property's own cap on the budget (0 for none)
+	armed  bool   // past the budget: reject the next attempt before it draws
+	cycles int    // the attempts so rejected
+	first  string // the first failure's message (printed when the engine's replay passes)
+	passed bool   // the last judgement passed (the engine's replay of a failure, when last)
+}
+
+// hzShrinkBudget bounds the shrinking of a failure: the engine (hegel-go v0.6.33 over
+// libhegel) keeps every attempt of a shrink in memory and has no budget for it (go/mergo
+// measured 1.6 GB and 65 s for a shrink of a case of 3000 draws in a module of its own, more
+// inside a test binary). A case here is some hundreds of draws (the probe counts them) and
+// the model is cheap, but a loop case of the FilesFrom property costs a child process, so the
+// budget is kept from the gotext ... gronx harness as it is: after a budget of failing
+// judgements the next attempt is rejected before its first draw (Assume: counted "budget
+// skipped"), which ends the shrink: the engine ends a shrink at an attempt rejected before it
+// drew, then replays the last failing attempt exactly for its report ("budget replayed",
+// printed as usual). Were the engine to shrink on past the undrawn rejection, the drawn
+// attempt that fails arms the next undrawn rejection, and after hzShrinkCycles such cycles
+// every attempt is rejected undrawn and the run ends without a message ("budget exhausted").
+// The budget is hzShrinkBudget bytes of the first failure's message: the attempts allowed
+// are the bytes over the message's length, between 100 and 3000. HEGEL_SHRINK_BUDGET sets
+// the bytes, 0 for no budget. Collect mode records every failure and never shrinks.
+var hzShrinkBudget = func() int {
+	if s := os.Getenv("HEGEL_SHRINK_BUDGET"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v >= 0 {
+			return v
+		}
+	}
+	return 400000
+}()
+
+// hzShrinkCycles bounds the alternation past the budget.
+const hzShrinkCycles = 100
+
+// hzShrinkAttempts is the failing judgements the budget allows for a first failure of n
+// bytes.
+func hzShrinkAttempts(n int) int {
+	if n < 1 {
+		n = 1
+	}
+	b := hzShrinkBudget / n
+	if b < 100 {
+		return 100
+	}
+	if b > 3000 {
+		return 3000
+	}
+	return b
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			// The engine reports a failure by replaying it last; when the library's
+			// answer varies from call to call (archives/19) the replay can pass, and the
+			// run is then failed without a word: the first failure's message stands in.
+			if t.Failed() && c.fails > 0 && c.passed {
+				t.Logf("the failure did not reproduce on the engine's replay (the library's answer varies from call to call); the first failure was: %s", c.first)
+			}
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// observe records a message of a class that is not a failure (a replica disagreement):
+// counted, and its first two messages kept.
+func (c *hzCollector) observe(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept; otherwise it is fatal, within the shrink budget.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	c.mu.Lock()
+	c.passed = false
+	if c.fails == 0 {
+		c.first = msg
+	}
+	if c.fails == 0 && hzShrinkBudget > 0 {
+		c.budget = hzShrinkAttempts(len(msg))
+		if c.cap > 0 && c.budget > c.cap {
+			c.budget = c.cap
+		}
+	}
+	if c.budget > 0 && c.fails >= c.budget {
+		// past the budget: the attempt that drew is the engine's replay of the last failure
+		// (the undrawn rejection before it ended the shrink) and prints as usual; were it a
+		// shrink attempt instead, the next attempt is rejected before drawing again
+		c.armed = true
+		c.counts["budget replayed"]++
+		c.mu.Unlock()
+		ht.Fatalf("%s", msg)
+	}
+	c.fails++
+	if c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+	ht.Fatalf("%s", msg)
+}
+
+// skip is whether the attempt is to be rejected before it draws (the budget spent and the
+// previous attempt drawn); past hzShrinkCycles, always.
+func (c *hzCollector) skip() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.budget == 0 || c.fails < c.budget {
+		return false
+	}
+	if c.cycles >= hzShrinkCycles {
+		c.counts["budget exhausted"]++
+		return true
+	}
+	if !c.armed {
+		return false
+	}
+	c.armed = false
+	c.cycles++
+	c.counts["budget skipped"]++
+	return true
+}
+
+// rearm: an attempt past the budget that drew and did not fail arms the next.
+func (c *hzCollector) rearm() {
+	c.mu.Lock()
+	if c.budget > 0 && c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml), indexed by the constants below (the index of a switch
+// is the bug's id minus one: hzKnownID(i) = "archives/<i+1>"). The expected functions of the
+// rewritten properties (filesExpected in hegel_zoo_files_test.go, deepExpected in
+// hegel_zoo_deep_test.go) are pure functions of (case, known): with every switch off
+// (hzKnownNone) they state the documented behaviour and are what the properties judge the
+// library against; with a switch on they reproduce that bug as a replica of the library's
+// rule, transcribed from archives.go and fs.go at the lines named beside the switch. Part 1
+// of the rewrite reads the nine switches of FilesFromFS/FilesFromDisk and DeepFS; the parts
+// after it read the others (until then those are declared and read by nothing).
+type known [28]bool
+
+const (
+	// archives/1: Zip archives written with ZipMethodXz cannot be read: the xz stream
+	// header precedes each local file header
+	kZipXzHeaderOffset = iota
+	// archives/2: Tar.Insert after an archive whose last entry is a directory, a link or a
+	// 512-multiple file leaves a zero block, and the archive no longer reads past it
+	kTarInsertBlockAligned
+	// archives/3: Zip.Insert returns after a directory entry, and the files after it are
+	// silently not inserted
+	kZipInsertDirStops
+	// archives/4: ArchiveFS.Open of a directory before the index is built returns a
+	// descendant file opened as the directory
+	kOpenImplicitDirFile
+	// archives/5: ArchiveFS.Open of a directory before the index is built lists the files
+	// of later or implicit subdirectories, and of ./ names, as its own
+	kOpenDirFreshEntries
+	// archives/6: ArchiveFS.Stat of a missing name that is a prefix of an entry name
+	// returns an implicit directory
+	kStatPrefixMissing
+	// archives/7: ArchiveFS.Stat of an implicit directory returns its full path as Name()
+	// before indexing, and a child's name after
+	kStatImplicitDirName
+	// archives/8: the directory files of ArchiveFS return all their entries from
+	// ReadDir(n <= 0), not the remaining ones
+	kDirFileReadDirRest
+	// archives/9: an empty zip is not identified by its stream: Zip.Match reads new bytes
+	// for each candidate header
+	kZipEmptyStreamMatch
+	// archives/10: Lz4 rejects every CompressionLevel but 0: the value is passed as the lz4
+	// library's bit-flag constant
+	kLz4CompressionLevel
+	// archives/11: Zip.Insert without SelectiveCompression stores the files, whatever
+	// Compression says
+	kZipInsertStores
+	// archives/12: Zip.Insert with SelectiveCompression and a Bzip2, Zstd or Xz method
+	// fails: the updater does not know the registered methods
+	kZipInsertCustomMethod
+	// archives/13: Zip.Insert stores a symbolic link as a prefix of its target's content,
+	// or fails when the target is missing
+	kZipInsertSymlink
+	// archives/14: FilesFromDisk and FilesFromFS with the in-archive root . give names with
+	// a leading slash (nameOnDiskToNameInArchive, archives.go :277-306: the value "." sets
+	// rootInArchive "" at :292-298 and :304-305 join it with strings.TrimPrefix(nameOnDisk,
+	// rootOnDisk), which keeps the separator for a key without a trailing one)
+	kFsRootDotLeadingSlash
+	// archives/15: FilesFromFS fails on a key ending in a slash, documented as enumerating
+	// the directory's contents (the key is passed as is to fs.WalkDir at archives.go :197,
+	// and fs.ValidPath refuses a trailing slash: "open dir/: file does not exist")
+	kFsTrailingSlashKey
+	// archives/16: FilesFromDisk with a key ending in a separator and a value with a
+	// directory adds the directory itself and drops the value's first element
+	// (nameOnDiskToNameInArchive, archives.go :283-286: rootInArchive = trimTopDir
+	// (rootInArchive), trimTopDir :312-314 and topDir :320-329; the root folder is skipped
+	// at :98 only when its name comes out empty)
+	kFsTrailingKeyValue
+	// archives/17: FilesFromFS with FollowSymlinks resolves a relative link target from the
+	// root of the fs.FS, not from the link's directory (followSymlinkFS, archives.go
+	// :517-550, passes the target of fs.ReadLink at :525 straight to fs.Lstat at :529;
+	// followSymlink on disk joins it with filepath.Dir(filename) at :487-489)
+	kFsFollowSymlinkRelative
+	// archives/18: FilesFromFS with FollowSymlinks fails on a link to a directory: the
+	// directory is looked up inside fs.Sub of itself (archives.go :225-237: subFsys :=
+	// fs.Sub(fsys, filename) at :226, then FilesFromFS(ctx, subFsys, options, {filename:
+	// nameInArchive}) at :230, "getting files from symlink directory ... dereferenced to
+	// ...: open d: file does not exist" at :232)
+	kFsFollowDirLink
+	// archives/19: Identify gives a different answer from call to call when the file name
+	// and the stream point at different formats
+	kIdentifyNondeterministic
+	// archives/20: Identify panics on a truncated lzip stream
+	kIdentifyLzipTruncatedPanic
+	// archives/21: PathContainsArchive compares extensions case-sensitively while
+	// PathIsArchive and SplitPath lower-case the path (fs.go :975-983: strings.Contains
+	// (path+"/", ext+"/") on the path as given; PathIsArchive :957-968 lower-cases)
+	kPathContainsArchiveCase
+	// archives/22: DeepFS.SplitPath skips the first character of the path, so a first
+	// segment that is only an archive extension is not split (fs.go :869-918: the scan
+	// starts at index 1, :880-884)
+	kSplitPathFirstSegment
+	// archives/23: DeepFS treats a directory named like an archive as an archive, and the
+	// archives inside it are listed as plain files (fs.go :811-834: ReadDir splits the path
+	// at the archive-named directory and reads it through getInnerFsys :839-856, which
+	// calls FileSystem :47-117, which returns a DirFS for a real directory at :69-71; DirFS
+	// .ReadDir :223-228 does not wrap archive-named entries in alwaysDirEntry as
+	// DeepFS.ReadDir does at :828-832)
+	kDeepFSDirNamedArchive
+	// archives/24: Lzip's writer closed without a Write produces a stream its reader
+	// rejects
+	kLzipEmptyStream
+	// archives/25: Brotli.Match rejects streams longer than 1 KiB whose first kibibyte does
+	// not decode to its end, so Identify finds no format for them
+	kBrotliMatchTruncated
+	// archives/26: Identify by name does not know .tgz, which PathIsArchive and DeepFS
+	// treat as an archive
+	kIdentifyTgzByName
+	// archives/27: FilesFromDisk and FilesFromFS with FollowSymlinks never return on a
+	// symbolic link to an ancestor directory (archives.go :122-130 and :225-237: a followed
+	// link to a directory calls FilesFromDisk/FilesFromFS again on the directory, whose walk
+	// meets the link again; nothing records the directories being followed)
+	kFollowAncestorLinkHang
+	// archives/28: Identify reports a truncated lzip header as EOF on a buffered stream and
+	// as a decoder error on a seekable one
+	kIdentifyLzipHeaderSeekability
+	hzKnownCount
+)
+
+// hzKnownRead are the switches the models read, in bug order: the classifier sweeps these.
+// Every switch is listed; a model that does not read a switch is unchanged by it.
+var hzKnownRead = func() []int {
+	out := make([]int, hzKnownCount)
+	for i := range out {
+		out[i] = i
+	}
+	return out
+}()
+
+// hzKnownID is the bug id of a switch ("archives/N"); hzKnownIndex the switch of a bug id
+// (-1 for none or the hole).
+func hzKnownID(i int) string { return "archives/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "archives/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for _, i := range hzKnownRead {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape archives/N"
+// per case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape via hole", the latter two with the id), the cases skipped for them under
+// HEGEL_NO_KNOWN=1 ("known archives/N"), the cases whose checks were dropped ("dropped
+// archives/N") and the checks ("dropped check <name>"), the draws the filters rejected
+// ("filtered <name>"), the replica's agreement with the library on the shaped cases ("replica
+// agreement", "replica disagreement"), the checks the model leaves unspecified ("unspecified
+// check <name>"), the properties' own tallies of what their cases reached (the rates of the
+// report), and the cases assumed away for an unrecorded candidate bug
+// ("candidate/go/archives-N"); printed and reset by the collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize ... go/gval judge, with the collector's
+// mismatch classes): it names the recorded bug whose shape the case has, so that a mismatch
+// or a library panic fails "(the shape of archives/N)", and under HEGEL_NO_KNOWN=1 skips the
+// case instead (counted as known) or drops the checks the shape covers (Dropped). The wide
+// and the narrow properties share their judge functions and so this. The classifier that
+// names the shape is computed from the case record alone (the model run with several sets of
+// switches).
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the regions past the shapes
+// are drawn, or the shaped cases filtered out), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped archives/N") and the case goes on
+// (judgeByDropping).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow). The properties call the library through hzCall, which
+// turns its panic into the check value "panic" judged like any other value; this is the net
+// under everything else.
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case. The properties run one
+// after the other (each writes its trees under its own temporary directory).
+// judgedWithCount is judged at the case count n, scaled as HEGEL_TEST_CASES scales the
+// default of 100, and with the shrink budget capped at attempts failing judgements (a
+// property whose cases are dear: the child processes).
+func judgedWithCount[T any](t *testing.T, n, attempts int, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	count := n * hzCases() / 100
+	if count < 1 {
+		count = 1
+	}
+	judgedWith(t, cases, fn, attempts, hegel.WithTestCases(count))
+}
+
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	judgedWith(t, cases, fn, 0)
+}
+
+func judgedWith[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T), attempts int, extra ...hegel.Option) {
+	t.Helper()
+	col := hzNewCollector(t)
+	col.cap = attempts
+	hzProperty(t, func(ht *hegel.T) {
+		if col.skip() {
+			ht.Assume(false)
+		}
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+		col.rearm()
+		col.mu.Lock()
+		col.passed = true
+		col.mu.Unlock()
+	}, extra...)
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (the go/carbon ... go/gval form: every value here is text; a model states a set
+// of acceptable values per check and the library's value agrees by membership).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole map for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two. Every value is a set of strings spelled
+// `{"a" | "b"}` (hzSet: the members quoted, sorted, unique); the library's is a set of one
+// (hzValue). A model value of "unspecified" (hzUnspecified) is a check the documentation
+// leaves open: the judge does not compare it. The checks of this target are named in the
+// model files.
+type checks map[string]string
+
+// hzUnspecified is the model's marker for a value the documentation leaves open.
+const hzUnspecified = "unspecified"
+
+// hzSet spells a set of acceptable values; hzValue a set of one.
+func hzSet(vals ...string) string {
+	sort.Strings(vals)
+	var parts []string
+	for i, v := range vals {
+		if i > 0 && v == vals[i-1] {
+			continue
+		}
+		parts = append(parts, strconv.Quote(v))
+	}
+	return "{" + strings.Join(parts, " | ") + "}"
+}
+
+func hzValue(v any) string { return hzSet(fmt.Sprint(v)) }
+
+// hzMembers reads a set back (a value that is not a set is a set of itself).
+func hzMembers(s string) []string {
+	if !strings.HasPrefix(s, "{") || !strings.HasSuffix(s, "}") {
+		return []string{s}
+	}
+	rest := s[1 : len(s)-1]
+	var out []string
+	for rest != "" {
+		q, err := strconv.QuotedPrefix(rest)
+		if err != nil {
+			return []string{s}
+		}
+		v, _ := strconv.Unquote(q)
+		out = append(out, v)
+		rest = strings.TrimPrefix(rest[len(q):], " | ")
+	}
+	return out
+}
+
+func (c checks) set(name string, v any) { c[name] = hzValue(v) }
+
+// unspecified marks the check as left open by the documentation.
+func (c checks) unspecified(name string) { c[name] = hzUnspecified }
+
+// isUnspecified reports whether a model value is the open marker.
+func isUnspecified(v string) bool { return v == hzUnspecified }
+
+// checkRank is the order the checks of a case are reported in when it fails (and the first
+// differing one classes the failure): the model files fill it; the rest by name.
+var checkRank = map[string]int{}
+
+// rankOf is the rank of a check name: the rank of its longest registered prefix, else 1000.
+func rankOf(name string) int {
+	best, found := 1000, false
+	bestLen := -1
+	for prefix, r := range checkRank {
+		if strings.HasPrefix(name, prefix) && len(prefix) > bestLen {
+			best, found, bestLen = r, true, len(prefix)
+		}
+	}
+	if !found {
+		return 1000
+	}
+	return best
+}
+
+func checkLess(a, b string) bool {
+	ar, br := rankOf(a), rankOf(b)
+	if ar != br {
+		return ar < br
+	}
+	return a < b
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two model statements agree: the same checks, each value equal
+// (the classifier's comparison; the sets are spelled canonically, the open marker compared
+// like any value).
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeValue reports whether the library's value of a check agrees with a model's: every
+// member of the library's set is a member of the model's; an open model value agrees with
+// anything.
+func agreeValue(name, got, want string) bool {
+	if got == want || isUnspecified(want) {
+		return true
+	}
+	ws := hzMembers(want)
+	for _, g := range hzMembers(got) {
+		found := false
+		for _, w := range ws {
+			if g == w {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeChecks reports whether the library's values agree with a model's: no check the model
+// does not state, every stated check answered by agreeValue - except an open one, which the
+// library may leave unanswered (a call that never returned answers nothing else).
+func agreeChecks(got, want checks) bool {
+	for k := range got {
+		if _, ok := want[k]; !ok {
+			return false
+		}
+	}
+	for k, v := range want {
+		if isUnspecified(v) {
+			continue
+		}
+		if g, ok := got[k]; !ok || !agreeValue(k, g, v) {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order; the long values are cut, the explanation of a case shows the difference.
+func diffChecks(a, b checks) string {
+	var parts []string
+	cut := func(s string) string {
+		if len(s) > 400 {
+			return s[:400] + "..."
+		}
+		return s
+	}
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || !agreeValue(k, a[k], w) {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, cut(a[k])))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, cut(a[k]), cut(w)))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok && !isUnspecified(b[k]) {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, cut(b[k])))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("archives/?", a defect of the model).
+// The order matters where two shapes meet: sufficiency in bug order names the lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "archives/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule; in collect mode
+// also every switch that alone moves the model ("sufficient archives/N": the overlaps).
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+		if rule != "sufficiency" {
+			hzTally("shape via " + rule + " " + shape)
+		}
+		if hzCollecting {
+			none := expected(c, hzKnownNone)
+			var ids []string
+			for _, i := range hzKnownRead {
+				if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+					hzTally("sufficient " + hzKnownID(i))
+					ids = append(ids, hzKnownID(i))
+				}
+			}
+			if len(ids) > 1 {
+				hzTally("sufficient together " + strings.Join(ids, "+"))
+			}
+		}
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// classOf is the collector class of a check name: its first word.
+func classOf(name string) string {
+	if i := strings.IndexByte(name, ' '); i > 0 {
+		return name[:i]
+	}
+	return name
+}
+
+// explainer is a case record that explains a failure in its own terms; the verdict appends
+// it.
+type explainer interface {
+	explain(got, want checks) string
+}
+
+// countUnspecified tallies the checks the model leaves open in want.
+func countUnspecified(want checks) {
+	for k, v := range want {
+		if isUnspecified(v) {
+			hzTally("unspecified check " + classOf(k))
+		}
+	}
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	countUnspecified(want)
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agreeChecks(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.observe("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if agreeChecks(got, want) {
+		if shape != "" {
+			// named by the classifier but passing: the replica's values differ from the
+			// documented ones on checks where the library's one value is in both, or where
+			// the documented value is open
+			hzTally("shaped pass")
+			j.col.observe("shaped pass", "%s against %s for\n%#v", diffChecks(expected(c, hzKnownAll), want), shape, c)
+		}
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, want[k]) {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	more := ""
+	if e, ok := any(c).(explainer); ok {
+		more = e.explain(got, want)
+	}
+	j.Fail(classOf(class), "%s for\n%#v%s", diffChecks(got, want), c, more)
+}
+
+// memoized is expected remembering its statements by switch set for one case (the
+// classifier and the verdict ask for the documented and the full replica statements more
+// than once; a known value is a comparable array).
+func memoized[T any](expected func(T, known) checks) func(T, known) checks {
+	memo := map[known]checks{}
+	return func(c T, k known) checks {
+		if out, ok := memo[k]; ok {
+			return out
+		}
+		out := expected(c, k)
+		memo[k] = out
+		return out
+	}
+}
+
+// judgeBy is the judge of a family: the shape first, from the case alone (the classifier
+// runs the model per switch BEFORE the library is called: under HEGEL_NO_KNOWN=1 a shaped
+// case the generators let through is skipped without a library call), then the library. The
+// models here are cheap, so the classifier runs on every case. The case is passed by
+// pointer: actual may record on it what the library left (the explanation of a failure).
+func judgeBy[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks) {
+	expected = memoized(expected)
+	want := expected(*c, hzKnownNone)
+	shape := classify(*c, expected)
+	j.Shape(shape)
+	got := actual(c)
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// droppedChecks is the set of checks the switches ids change on their own: the checks on
+// which expected(c, only id) differs from expected(c, none), by name, with the first id that
+// changes it.
+func droppedChecks[T any](c T, expected func(T, known) checks, ids []int) map[string]int {
+	none := expected(c, hzKnownNone)
+	out := map[string]int{}
+	for _, i := range ids {
+		only := expected(c, hzKnownOnly(i))
+		for name, v := range none {
+			if w, ok := only[name]; !ok || w != v {
+				if _, done := out[name]; !done {
+					out[name] = i
+				}
+			}
+		}
+		for name := range only {
+			if _, ok := none[name]; !ok {
+				if _, done := out[name]; !done {
+					out[name] = i
+				}
+			}
+		}
+	}
+	return out
+}
+
+// pastSwitches is the model over the checks the switches ids do not change on their own (the
+// restricted check set): a wide property's view under HEGEL_NO_KNOWN=1 where a shape's checks
+// are dropped rather than the case skipped, and a narrow property's view where another bug's
+// checks are left out so that the property is judged on its own bug.
+func pastSwitches[T any](expected func(T, known) checks, ids []int) func(T, known) checks {
+	return func(c T, k known) checks {
+		drop := droppedChecks(c, expected, ids)
+		out := checks{}
+		for name, v := range expected(c, k) {
+			if _, gone := drop[name]; !gone {
+				out[name] = v
+			}
+		}
+		return out
+	}
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb ... go/gronx form): by default the shape is named and every
+// check judged; under HEGEL_NO_KNOWN=1 the checks the switches drops change on their own
+// (droppedChecks) are dropped from the case (hzCaseJudge.Dropped, counted "dropped
+// archives/N" per switch and "dropped check <name>"), the rest classified again and judged,
+// the case not skipped unless a shape remains.
+func judgeByDropping[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks, drops []int) {
+	expected = memoized(expected)
+	want := expected(*c, hzKnownNone)
+	if hzNoKnown {
+		drop := droppedChecks(*c, expected, drops)
+		if len(drop) > 0 {
+			seen := map[int]bool{}
+			for name, i := range drop {
+				if !seen[i] {
+					seen[i] = true
+					j.Dropped(hzKnownID(i))
+				}
+				hzTally("dropped check " + classOf(name))
+				delete(want, name)
+			}
+			hzTally("dropped case")
+		}
+		past := memoized(pastSwitches(expected, drops))
+		shape := classify(*c, past)
+		j.Shape(shape)
+		got := actual(c)
+		verdict(j, *c, got, want, shape, past)
+		return
+	}
+	shape := classify(*c, expected)
+	j.Shape(shape)
+	got := actual(c)
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few model runs. The
+// rejections are also counted by the shape the case had ("filtered <id> as <shape>", "as
+// none" for no shape), which says what the surroundings bring in.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool {
+		got := shapeID(c, expected)
+		if got == want {
+			return true
+		}
+		if got == "" {
+			got = "none"
+		}
+		hzTally("filtered " + id + " as " + got)
+		return false
+	})
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered archives/N" by the shape it had), g itself otherwise: a
+// wide property's filter, after the shapes a weight of zero has switched off.
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCall runs a library call and returns what it panicked with (nil when it returned): the
+// properties turn it into the check value "panic".
+func hzCall(f func()) (panicked any) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	f()
+	return nil
+}
