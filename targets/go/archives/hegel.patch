+	data := hzPinArchive(t, archives.Tar{}, hzPinFiles(t, map[string]string{"a.txt": ""}))
+	rw := &hzBuffer{buf: append([]byte(nil), data...)}
+	if err := (archives.Tar{}).Insert(context.Background(), rw, hzPinFiles(t, map[string]string{"b.txt": "x"})); err != nil {
+		t.Fatalf("Insert: %v", err)
+	}
+	got, err := hzExtractAll(archives.Tar{}, rw.buf)
+	if err != nil {
+		t.Fatalf("after inserting into a tar whose last entry is an empty file, Extract: %v (entries read: %v)", err, hzGotNames(got))
+	}
