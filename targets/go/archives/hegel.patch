+// TestHegelMisnamedStreamsIdentifyAlike: Identify gives the same answer on every call for a
+// stream whose name points at another format (twelve calls, seekable and not); archives/19
+// takes the first match in the formats map's iteration order, and the answer changes from
+// call to call (or, where the misleading format's reader rejects the stream, is that
+// reader's error rather than any documented answer).
+func TestHegelMisnamedStreamsIdentifyAlike(t *testing.T) {
+	judged(t, misnamedCases, identifyJudgeWith(6))
+}
