+package hegel
+
+// The Compression property: the format record every compression format of the package is
+// drawn as (shared with the Identify property), the case record (the format, the input, the
+// writes it is split into), the replicas of the formats' stream matching (the magic numbers,
+// the zlib header table, the brotli heuristic) and of the third-party decoders the package
+// opens, the documented model with the replicas of the recorded bugs threaded on the switch
+// set (compressionExpected), and the wide property.
+//
+// The model: a Compression's OpenWriter opens a writer for every option the format
+// documents (Gz, Bz2 and Zlib take a CompressionLevel 0..9, Lz4 "the compression level",
+// Brotli a Quality 0..11), the writes and the Close succeed, and the stream written is the
+// format's own: Match reports it by stream (and not by name when no name is given), by name
+// when the name has the format's extension (upper-cased; a nil stream), no other format's
+// Match reports it by stream, Identify names the format, OpenReader decodes it back to the
+// input, and the reference command-line tool decodes it to the input; a gzip stream of two
+// members reads whole, and as its first member under DisableMultistream. Sz and MinLZ write
+// no stream header for an empty input (the README's "Not judged"): their stream match, the
+// Identify answer and the brotli heuristic on the stream are open. The checks: "writer
+// opens" ("ok" or the error kind), "write", "close", "match stream" ("stream": by stream
+// only), "match name" ("name"), "other <ext>" for the nine other compression formats and the
+// archival ones (zip, tar, 7z, rar) ("no"), "identify" (the extension), "reader" ("ok" or
+// the error kind), "tool" ("ok", "tool error", "tool content"; open where the tool is not
+// installed or the format has none), and for Gz "gz members whole" and "gz members first".
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"compress/zlib"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/andybalholm/brotli"
+	"github.com/dsnet/compress/bzip2"
+	"github.com/klauspost/compress/s2"
+	"github.com/klauspost/compress/zstd"
+	"github.com/mholt/archives"
+	fastxz "github.com/mikelolasagasti/xz"
+	"github.com/minio/minlz"
+	"github.com/pierrec/lz4/v4"
+	lzipgo "github.com/sorairolake/lzip-go"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the format record
+
+// compFormat is a compression format of the package with its options: Kind the extension
+// without the dot ("gz", "bz2", "xz", "zst", "lz4", "br", "sz", "lz", "zz", "mz"), Level the
+// CompressionLevel of Gz, Bz2, Lz4 and Zlib (0..9) or the Quality of Brotli (0..11), Multi
+// Gz's Multithreaded.
+type compFormat struct {
+	Kind  string
+	Level int
+	Multi bool
+}
+
+// compKinds is every compression format, in the package's order of registration files.
+var compKinds = []string{"gz", "bz2", "xz", "zst", "lz4", "br", "sz", "lz", "zz", "mz"}
+
+// archKinds is every archival or extraction format Identify tries (zip.go, tar.go, 7z.go,
+// rar.go).
+var archKinds = []string{"zip", "tar", "7z", "rar"}
+
+func (f compFormat) Ext() string { return "." + f.Kind }
+
+// Format is the archives.Compression value of the record.
+func (f compFormat) Format() archives.Compression {
+	switch f.Kind {
+	case "gz":
+		return archives.Gz{CompressionLevel: f.Level, Multithreaded: f.Multi}
+	case "bz2":
+		return archives.Bz2{CompressionLevel: f.Level}
+	case "xz":
+		return archives.Xz{}
+	case "zst":
+		return archives.Zstd{}
+	case "lz4":
+		return archives.Lz4{CompressionLevel: f.Level}
+	case "br":
+		return archives.Brotli{Quality: f.Level}
+	case "sz":
+		return archives.Sz{}
+	case "lz":
+		return archives.Lzip{}
+	case "zz":
+		return archives.Zlib{CompressionLevel: f.Level}
+	case "mz":
+		return archives.MinLZ{}
+	}
+	panic("compFormat: no kind " + f.Kind)
+}
+
+func (f compFormat) String() string {
+	switch f.Kind {
+	case "gz":
+		return fmt.Sprintf("Gz{%d, mt %v}", f.Level, f.Multi)
+	case "bz2":
+		return fmt.Sprintf("Bz2{%d}", f.Level)
+	case "lz4":
+		return fmt.Sprintf("Lz4{%d}", f.Level)
+	case "br":
+		return fmt.Sprintf("Brotli{%d}", f.Level)
+	case "zz":
+		return fmt.Sprintf("Zlib{%d}", f.Level)
+	case "xz":
+		return "Xz{}"
+	case "zst":
+		return "Zstd{}"
+	case "sz":
+		return "Sz{}"
+	case "lz":
+		return "Lzip{}"
+	case "mz":
+		return "MinLZ{}"
+	}
+	return f.Kind
+}
+
+// compFormatsOf is a format: a kind at a tenth each (at one weight each the halving bits
+// realised gz 11 and zst 8 in both properties over two seeds, the others 9 to 11; at the
+// weights below, over four runs of 3000, 9.4 to 10.6 each), Gz's level 0..9 evenly
+// (realised 10 each) and Multithreaded at 30 (realised 31), Bz2's and Zlib's level 0..9,
+// Lz4's level 0 a tenth of the time and 1..9 otherwise when lz4Levels (the shape of
+// archives/10; level 0 alone otherwise), Brotli's quality 0..11 (realised 8 each).
+func compFormatsOf(lz4Levels bool) hegel.Generator[compFormat] {
+	kinds := halvesOver([]int{10, 10, 10, 11, 10, 10, 10, 10, 10, 10}, compKinds...)
+	return hegel.FlatMap(kinds, func(kind string) hegel.Generator[compFormat] {
+		level := hegel.Just(0)
+		switch kind {
+		case "gz", "bz2", "zz":
+			level = rangeHalves(0, 9)
+		case "lz4":
+			level = dieChoice(hzW(1, hegel.Just(0)), hzW(hzUnless(!lz4Levels, 9), rangeHalves(1, 9)))
+		case "br":
+			level = rangeHalves(0, 11)
+		}
+		multi := hegel.Just(false)
+		if kind == "gz" {
+			multi = dieCoin(30)
+		}
+		return hegel.FlatMap(level, func(l int) hegel.Generator[compFormat] {
+			return hegel.Map(multi, func(m bool) compFormat { return compFormat{Kind: kind, Level: l, Multi: m} })
+		})
+	})
+}
+
+// compFormats is the formats of the wide properties: the Lz4 levels 1..9 at weight zero
+// under HEGEL_NO_KNOWN=1.
+var compFormats = compFormatsOf(!hzNoKnown)
+
+// textOf is n bytes of compressible text (fileData's).
+func textOf(n int) []byte { return bytes.Repeat([]byte("the quick brown fox "), n/20+1)[:n] }
+
+// payloadOf is the input of a compression format: fileData's population (a size from the
+// table 60 percent of the time, else 0..3000; compressible text, one byte repeated or random
+// bytes a third each - realised 60; 33/33/34); without the empty input when noEmpty, and
+// without random bytes over 1000 when shortRandom (the stream of random bytes then stays
+// under a kibibyte).
+func payloadOf(noEmpty, shortRandom bool) hegel.Generator[[]byte] {
+	size := payloadSizes
+	if noEmpty {
+		size = payloadSizesNoEmpty
+	}
+	return hegel.FlatMap(size, func(n int) hegel.Generator[[]byte] {
+		random := hzUnless(shortRandom && n > 1000, 1)
+		return halvesGens([]int{1, 1, random},
+			hegel.Just(textOf(n)),
+			hegel.Map(rangeHalves(0, 255), func(b int) []byte { return bytes.Repeat([]byte{byte(b)}, n) }),
+			hegel.Binary(n, n))
+	})
+}
+
+// payloadSizes is the size of an input, with and without 0 (the halving tree over 0..3000 is
+// built once, as fileData's: payloadOf is called inside generators' closures).
+var (
+	payloadSizes        = dieChoice(hzW(60, evenHalves(fileSizes...)), hzW(40, rangeHalves(0, 3000)))
+	payloadSizesNoEmpty = dieChoice(hzW(60, evenHalves(fileSizes[1:]...)), hzW(40, rangeHalves(1, 3000)))
+)
+
+// payloadFor is the input of the format kind in the wide properties: under HEGEL_NO_KNOWN=1
+// Lzip gets no empty input (the shape of archives/24) and Brotli no random bytes over 1000
+// (the shape of archives/25 is a brotli stream over 1 KiB whose first kibibyte does not
+// decode, which random bytes make and text never does).
+func payloadFor(kind string) hegel.Generator[[]byte] {
+	return payloadOf(hzNoKnown && kind == "lz", hzNoKnown && kind == "br")
+}
+
+// payloadKind describes an input for the case's GoString.
+func payloadKind(data []byte) string {
+	if len(data) == 0 {
+		return "empty"
+	}
+	if bytes.Equal(data, textOf(len(data))) {
+		return "text"
+	}
+	if bytes.Count(data, data[:1]) == len(data) {
+		return fmt.Sprintf("byte %#x repeated", data[0])
+	}
+	return "random"
+}
+
+// --------------------------------------------------------------------------- the case record
+
+// compressionCase is one case: the format, the input and the lengths of the writes the input
+// is split into (a partition of the input; none for an empty input, which closes the writer
+// without a Write, as io.Copy does for an empty source).
+type compressionCase struct {
+	Format compFormat
+	Data   []byte
+	Pieces []int
+	notes  []string // what the library left (the explanation of a failure)
+}
+
+func (c compressionCase) GoString() string {
+	s := fmt.Sprintf("compressionCase{%v, %d bytes (%s), written in %d pieces %v}", c.Format, len(c.Data), payloadKind(c.Data), len(c.Pieces), c.Pieces)
+	for _, n := range c.notes {
+		s += "\n  " + n
+	}
+	return s
+}
+
+// pieceLengths is the table a write's length is drawn from; the builder cuts the last piece
+// to the input and adds the remainder, so the realised pieces are a partition of the input.
+var pieceLengths = []int{1, 2, 3, 7, 16, 100, 511, 512, 513, 1024, 2000, 4096}
+
+// piecesDrawn: 0 to 7 lengths of the table, the count drawn evenly (realised 12 each).
+var piecesDrawn = countedHalves(evenHalves(pieceLengths...), 0, 7)
+
+// buildCompressionCase normalises the drawn lengths into a partition of the input: a length
+// beyond the remaining input is cut to it, the lengths after the input is spent are dropped,
+// and the remainder, if any, is a last piece.
+func buildCompressionCase(f compFormat, data []byte, lengths []int) compressionCase {
+	var pieces []int
+	rest := len(data)
+	for _, n := range lengths {
+		if rest == 0 {
+			break
+		}
+		if n > rest {
+			n = rest
+		}
+		pieces = append(pieces, n)
+		rest -= n
+	}
+	if rest > 0 {
+		pieces = append(pieces, rest)
+	}
+	return compressionCase{Format: f, Data: data, Pieces: pieces}
+}
+
+// compressionCases is the cases of the wide property.
+var compressionCases = hegel.FlatMap(compFormats, func(f compFormat) hegel.Generator[compressionCase] {
+	return hegel.FlatMap(payloadFor(f.Kind), func(data []byte) hegel.Generator[compressionCase] {
+		return hegel.Map(piecesDrawn, func(lengths []int) compressionCase { return buildCompressionCase(f, data, lengths) })
+	})
+})
+
+// --------------------------------------------------------------------------- the matching replicas
+
+// The stream matching of every format, transcribed: a fixed magic number compared with the
+// same number of bytes read from the start (gz.go :46-49 two bytes 1f 8b, bz2.go :34-37
+// "BZh", xz.go :33-36 six bytes, zstd.go :35-38 four, lz4.go :34-37 four, sz.go :61-64 ten,
+// lzip.go :32-36 "LZIP", minlz.go :35-38 nine, 7z.go :46-49 six; a shorter stream does not
+// match), the two-byte zlib header table (zlib.go :33-39, :50-73), rar's two magics as
+// prefixes (rar.go :68-78), zip's two headers (zip.go :94-103: the documented rule is either
+// header at the start; under kZipEmptyStreamMatch the second header is read after the first
+// four bytes, archives/9), tar's archive/tar header read (tar.go :66-70) and brotli's
+// decoding heuristic (brotli.go :41-128, brotliMatches).
+var compMagics = map[string][]byte{
+	"gz":  {0x1f, 0x8b},
+	"bz2": []byte("BZh"),
+	"xz":  {0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00},
+	"zst": {0x28, 0xb5, 0x2f, 0xfd},
+	"lz4": {0x04, 0x22, 0x4d, 0x18},
+	"sz":  {0xff, 0x06, 0x00, 0x00, 0x73, 0x4e, 0x61, 0x50, 0x70, 0x59},
+	"lz":  []byte("LZIP"),
+	"mz":  []byte("\xff\x06\x00\x00MinLz"),
+	"7z":  []byte("7z\xBC\xAF\x27\x1C"),
+}
+
+var zlibHeaders = map[uint16]bool{
+	0x081D: true, 0x085B: true, 0x0899: true, 0x08D7: true,
+	0x1819: true, 0x1857: true, 0x1895: true, 0x18D3: true,
+	0x2815: true, 0x2853: true, 0x2891: true, 0x28CF: true,
+	0x3811: true, 0x384F: true, 0x388D: true, 0x38CB: true,
+	0x480D: true, 0x484B: true, 0x4889: true, 0x48C7: true,
+	0x5809: true, 0x5847: true, 0x5885: true, 0x58C3: true,
+	0x6805: true, 0x6843: true, 0x6881: true, 0x68DE: true,
+	0x7801: true, 0x785E: true, 0x789C: true, 0x78DA: true,
+}
+
+var (
+	rarHeaderV1 = []byte("Rar!\x1a\x07\x00")
+	rarHeaderV5 = []byte("Rar!\x1a\x07\x01\x00")
+	zipHeader   = []byte("PK\x03\x04")
+	zipEmpty    = []byte("PK\x05\x06")
+)
+
+// hasMagic reports whether s starts with the whole magic.
+func hasMagic(s, magic []byte) bool {
+	return len(s) >= len(magic) && bytes.Equal(s[:len(magic)], magic)
+}
+
+// tarByStream is Tar.Match's stream rule: archive/tar reads a first header from the bytes.
+func tarByStream(s []byte) bool {
+	_, err := tar.NewReader(bytes.NewReader(s)).Next()
+	return err == nil
+}
+
+// zipByStream is Zip.Match's stream rule: either header at the start, or, under
+// kZipEmptyStreamMatch, the entry header at the start or the end record after it (zip.go
+// :94-103: readAtMost(stream, 4) once per header, the second read continuing the stream).
+func zipByStream(s []byte, k known) bool {
+	if hasMagic(s, zipHeader) {
+		return true
+	}
+	if k[kZipEmptyStreamMatch] {
+		return len(s) >= 8 && bytes.Equal(s[4:8], zipEmpty)
+	}
+	return hasMagic(s, zipEmpty)
+}
+
+// streamMatches is the stream rule of the format kind (a compression or an archival one) on
+// the bytes: Match(ctx, "", stream).ByStream as transcribed above.
+func streamMatches(kind string, s []byte, k known) bool {
+	switch kind {
+	case "zz":
+		return len(s) >= 2 && zlibHeaders[uint16(s[0])<<8|uint16(s[1])]
+	case "br":
+		return brotliMatches(s, k)
+	case "zip":
+		return zipByStream(s, k)
+	case "tar":
+		return tarByStream(s)
+	case "rar":
+		return hasMagic(s, rarHeaderV1) || hasMagic(s, rarHeaderV5)
+	}
+	return hasMagic(s, compMagics[kind])
+}
+
+// isASCII is brotli.go :139-162.
+func isASCII(data []byte) bool {
+	if len(data) == 0 {
+		return false
+	}
+	for _, b := range data {
+		if !(b >= 9 && b <= 13) && !(b >= 32 && b <= 126) {
+			return false
+		}
+	}
+	return true
+}
+
+// brotliMatches is isValidBrotliStream (brotli.go :41-128), transcribed with the same
+// decoder (github.com/andybalholm/brotli, the one Brotli.OpenReader opens at :169): the
+// first kibibyte at most is decoded up to a kibibyte of output, any decoder error but io.EOF
+// is no match (archives/25 for a stream over 1 KiB cut mid-block), then the input the decoder
+// consumed must match no other format (:82-91), and the stream is brotli when the output is
+// larger than the input (:93-97), ASCII or valid UTF-8 (:99-103), or starts with 0x1b, 0x0b
+// or 0x8b (:109-119).
+func brotliMatches(s []byte, k known) bool {
+	limited := s
+	if len(limited) > 1024 {
+		limited = limited[:1024]
+	}
+	input := &bytes.Buffer{}
+	r := brotli.NewReader(io.TeeReader(bytes.NewReader(limited), input))
+	output := &bytes.Buffer{}
+	buf := make([]byte, len(limited))
+	totalRead := 0
+	for totalRead < 1024 {
+		n, err := r.Read(buf)
+		if err != nil && err != io.EOF {
+			return false
+		}
+		if n == 0 {
+			break
+		}
+		output.Write(buf[:n])
+		totalRead += n
+		if err == io.EOF {
+			break
+		}
+	}
+	inputBytes := input.Bytes()
+	for _, kind := range append(append([]string(nil), archKinds...), compKinds...) {
+		if kind != "br" && streamMatches(kind, inputBytes, k) {
+			return false
+		}
+	}
+	if float64(totalRead)/float64(len(inputBytes)) > 1.0 {
+		return true
+	}
+	if isASCII(output.Bytes()) || utf8.Valid(output.Bytes()) {
+		return true
+	}
+	if len(inputBytes) >= 4 && (inputBytes[0] == 0x1b || inputBytes[0] == 0x0b || inputBytes[0] == 0x8b) {
+		return true
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- the decoders
+
+// decodeOutcome is what the archival matchers see when Identify wraps a stream in a
+// compression's OpenReader (formats.go :126-132): the decoder failed to open ("open": the
+// error is returned as Identify's), its first read failed before the bytes the matcher
+// wanted ("read" with the error and the count read: zip reads four bytes, 7z six, rar eight;
+// a read error of io.EOF or io.ErrUnexpectedEOF is not one, readAtMost :166-170), or the
+// bytes read ("ok"; tar's own reader swallows every error, tar.go :67-69). The lzip reader
+// panics on a short stream ("panic", archives/20).
+type decodeOutcome struct {
+	Kind string
+	Text string
+	N    int
+}
+
+// lzipPanics is the rule of archives/20, measured standalone on every cut of an lzip stream
+// (hz_dump_test.go, part 2): sorairolake/lzip-go v0.3.8's NewReader (reader.go :27) reads the
+// six-byte header and then slices the rest of the member by its twenty-byte trailer, so a
+// stream of six to twenty-one bytes with the "LZIP" magic panics with "slice bounds out of
+// range"; four bytes is "unsupported version number", five "dictionary size is too small",
+// twenty-two and more an lzip error.
+func lzipPanics(s []byte) bool { return hasMagic(s, compMagics["lz"]) && len(s) >= 6 && len(s) <= 21 }
+
+// decodeStep opens the third-party decoder the format's OpenReader opens (gz.go :83
+// compress/gzip for the registered Gz{}, bz2.go :50 dsnet/compress/bzip2, xz.go :47
+// mikelolasagasti/xz, zstd.go :49 klauspost/compress/zstd, lz4.go :56 pierrec/lz4, brotli.go
+// :169 andybalholm/brotli, sz.go :117 klauspost/compress/s2, lzip.go :46 sorairolake/lzip-go,
+// zlib.go :71 compress/zlib, minlz.go :49 minio/minlz; the zero values Identify decodes
+// through) on the bytes and reads eight bytes, the most an archival matcher reads.
+func decodeStep(kind string, s []byte) decodeOutcome {
+	var r io.Reader
+	var err error
+	br := bytes.NewReader(s)
+	switch kind {
+	case "gz":
+		r, err = gzip.NewReader(br)
+	case "bz2":
+		r, err = bzip2.NewReader(br, nil)
+	case "xz":
+		r, err = fastxz.NewReader(br, 0)
+	case "zst":
+		var zr *zstd.Decoder
+		zr, err = zstd.NewReader(br)
+		if err == nil {
+			defer zr.Close()
+			r = zr
+		}
+	case "lz4":
+		r = lz4.NewReader(br)
+	case "br":
+		r = brotli.NewReader(br)
+	case "sz":
+		r = s2.NewReader(br)
+	case "lz":
+		if lzipPanics(s) {
+			return decodeOutcome{Kind: "panic"}
+		}
+		var lr *lzipgo.Reader
+		if p := hzCall(func() { lr, err = lzipgo.NewReader(br) }); p != nil {
+			hzTally("lzip panic outside the rule")
+			return decodeOutcome{Kind: "panic"}
+		}
+		if err == nil {
+			r = lr
+		}
+	case "zz":
+		r, err = zlib.NewReader(br)
+	case "mz":
+		r = minlz.NewReader(br)
+	default:
+		panic("decodeStep: no kind " + kind)
+	}
+	if err != nil {
+		return decodeOutcome{Kind: "open", Text: errKindOfText(err.Error())}
+	}
+	buf := make([]byte, 8)
+	n, rerr := io.ReadFull(r, buf)
+	if rerr == nil || errors.Is(rerr, io.EOF) || errors.Is(rerr, io.ErrUnexpectedEOF) {
+		return decodeOutcome{Kind: "ok", N: n}
+	}
+	return decodeOutcome{Kind: "read", Text: errKindOfText(rerr.Error()), N: n}
+}
+
+// errKindOfText is the kind of a decoder's error the checks compare: "eof" for an end of
+// input (io.EOF, io.ErrUnexpectedEOF), "header" for a magic number or header the decoder
+// rejects (every decoder's wording), "corrupt" for corrupt or truncated data, "brotli" for
+// the brotli decoder's codes, else the text. The texts are the third-party decoders' and
+// vary with how much of a short stream a decoder's first read got (lzipShortStream).
+func errKindOfText(s string) string {
+	switch {
+	case strings.Contains(s, "EOF"):
+		return "eof"
+	case strings.Contains(s, "magic"), strings.Contains(s, "invalid header"), strings.Contains(s, "not recognized"),
+		strings.Contains(s, "unsupported version"), strings.Contains(s, "dictionary size"), strings.Contains(s, "invalid stream"):
+		return "header"
+	case strings.Contains(s, "corrupt"), strings.Contains(s, "truncated"):
+		return "corrupt"
+	case strings.HasPrefix(s, "brotli: "):
+		return "brotli"
+	}
+	return s
+}
+
+// lzipShortStream is the error kind lzip-go's NewReader gives Identify on a stream shorter
+// than its six-byte header: it reads the header with one Read (reader.go :31) and, given
+// the bytes with no error, judges them ("header": "invalid magic number" under four bytes,
+// "unsupported version number" at four, "dictionary size is too small" at five); an empty
+// stream is "eof". A buffered stream (the rewindReader, formats.go :353-393) returns the
+// replayed bytes together with io.EOF, which the single Read reports as is: that is
+// archives/28, the replica in identifyExpected (kIdentifyLzipHeaderSeekability), which
+// identifyOutcomes flags with LzipShort.
+func lzipShortStream(n int) string {
+	if n == 0 {
+		return "eof"
+	}
+	return "header"
+}
+
+// --------------------------------------------------------------------------- the Identify replica
+
+// idStream describes a stream for the Identify replica: the bytes; Own, the compression
+// kind the bytes are a complete stream of ("" for an archive, random bytes, an empty stream
+// or a truncated one, whose bytes are matched as they are); the decoded content under Own
+// (Inner, the payload bytes, with InnerKind "payload"; "tar" for a tar archive with an entry;
+// "emptytar" for one without; "none"); Headerless for the empty Sz, MinLZ and Lzip streams
+// the writers give no header (archives/24 for Lzip).
+type idStream struct {
+	Bytes      []byte
+	Own        string
+	Inner      []byte
+	InnerKind  string
+	Headerless bool
+}
+
+// ownStreamMatches is the documented stream match of a writer's own complete stream (by
+// construction) with the replicas: the headerless Sz and MinLZ streams match nothing (open
+// elsewhere), the headerless Lzip stream does not match under kLzipEmptyStream (lzip.go
+// :32-36 wants "LZIP"), and a brotli stream over 1 KiB is matched by the heuristic under
+// kBrotliMatchTruncated.
+func ownStreamMatches(st idStream, k known) bool {
+	switch st.Own {
+	case "sz", "mz":
+		if st.Headerless {
+			return false
+		}
+	case "lz":
+		if st.Headerless {
+			return !k[kLzipEmptyStream]
+		}
+	case "br":
+		if k[kBrotliMatchTruncated] && len(st.Bytes) > 1024 {
+			return brotliMatches(st.Bytes, k)
+		}
+	}
+	return true
+}
+
+// ownDecodeStep is the decoding of a writer's own complete stream: the decoder reads it
+// (by construction), except the headerless Lzip stream under kLzipEmptyStream and the
+// headerless Sz and MinLZ streams, which the decoders are run on.
+func ownDecodeStep(st idStream, k known) decodeOutcome {
+	if st.Headerless && (st.Own != "lz" || k[kLzipEmptyStream]) {
+		return decodeStep(st.Own, st.Bytes)
+	}
+	return decodeOutcome{Kind: "ok"}
+}
+
+// idOutcome is one answer of Identify: Answer the format's extension, "NoMatch", "error" or
+// "panic"; Err the error's text without its "matching <format>: " prefix ("?" when the
+// decoder's text is not known: the panicking lengths of archives/20 under the documented
+// model); Group the iteration orders that give it (two outcomes of one group are one answer
+// whose value is not known, not two).
+type idOutcome struct {
+	Answer string
+	Err    string
+	Group  int
+}
+
+// idResult is the set of answers of Identify over every iteration order of the formats map.
+type idResult struct {
+	Answers   []string
+	Errs      []string
+	Varies    bool // the answer depends on the formats map's iteration order (archives/19)
+	LzipShort bool // the lzip decoder read a stream of one to five bytes (archives/28)
+}
+
+// nameParts is the name rules of the formats (Match on the lower-cased base name): the
+// compression by the last extension (gz.go :41, bz2.go :29, xz.go :28, zstd.go :30, lz4.go
+// :29, brotli.go :30, sz.go :55-57 with ".s2", lzip.go :27, zlib.go :28, minlz.go :30), zip,
+// 7z and rar by the last extension (zip.go :89, 7z.go :41, rar.go :63), tar by a "tar"
+// component among the dot-separated parts after the first (tar.go :56-63). The documented
+// rule adds archiveExtensions' ".tgz" (fs.go :940-952: a name ending in ".tgz" is a tar.gz
+// archive to PathIsArchive and DeepFS), which no format's Match knows under
+// kIdentifyTgzByName (archives/26).
+func nameParts(base string, k known) (comp string, archs []string) {
+	lower := strings.ToLower(base)
+	ext := ""
+	if i := strings.LastIndexByte(lower, '.'); i >= 0 {
+		ext = lower[i:]
+	}
+	for _, kind := range compKinds {
+		if ext == "."+kind || (kind == "sz" && ext == ".s2") {
+			comp = kind
+		}
+	}
+	switch ext {
+	case ".zip", ".7z", ".rar":
+		archs = append(archs, ext[1:])
+	}
+	parts := strings.Split(lower, ".")
+	for _, p := range parts[1:] {
+		if p == "tar" {
+			archs = append(archs, "tar")
+			break
+		}
+	}
+	if !k[kIdentifyTgzByName] && strings.HasSuffix(lower, ".tgz") {
+		comp, archs = "gz", []string{"tar"}
+	}
+	return comp, archs
+}
+
+// identifyBase is Identify's name (formats.go :45, identifyOne :117-119): the base of the
+// slash-converted name, "" for ".".
+func identifyBase(name string) string {
+	base := path.Base(filepath.ToSlash(name))
+	if base == "." {
+		return ""
+	}
+	return base
+}
+
+// identifyOutcomes transcribes Identify (formats.go :40-111) over every iteration order of
+// the formats map: the first compression format matched by name or stream (:53-70; every
+// candidate comes first in some order), then, with the stream wrapped in that format's
+// decoder (identifyOne :126-132; a decoder that fails to open is Identify's error, :127-130),
+// the first archival format matched by name or stream or whose read of the decoded stream
+// fails (:73-90, zip.go :95-98, 7z.go :46-49, rar.go :68-71; tar.go :66-70 swallows); the
+// answer is the compressed archive, the archive, the compression, or NoMatch (:93-111).
+func identifyOutcomes(name string, st idStream, k known) idResult {
+	base := identifyBase(name)
+	nameComp, nameArchs := nameParts(base, k)
+	byName := func(kind string) bool {
+		for _, a := range nameArchs {
+			if a == kind {
+				return true
+			}
+		}
+		return false
+	}
+	var comps []string
+	for _, kind := range compKinds {
+		matched := kind == nameComp
+		if kind == st.Own {
+			matched = matched || ownStreamMatches(st, k)
+		} else {
+			matched = matched || streamMatches(kind, st.Bytes, k)
+		}
+		if matched {
+			comps = append(comps, kind)
+		}
+	}
+	var outcomes []idOutcome
+	lzipShort := false
+	// every outcome is its own group (an iteration order of its own), except the two
+	// answers of a decoder that is not run (shared < 0 allocates, else shared is used)
+	group := 0
+	groupOf := func(shared int) int {
+		if shared >= 0 {
+			return shared
+		}
+		group++
+		return group
+	}
+	// archival is the archival loop given the chosen compression (or none) and what its
+	// decoder gave: the decoded bytes (nil when a foreign decoder gave garbage) and the
+	// read outcome.
+	archival := func(comp string, decoded []byte, innerTar bool, step decodeOutcome, shared int) {
+		suffix := ""
+		if comp != "" {
+			suffix = "." + comp
+		}
+		var any bool
+		for _, kind := range archKinds {
+			want := map[string]int{"zip": 4, "7z": 6, "rar": 8}[kind]
+			if kind != "tar" && step.Kind == "read" && step.N < want {
+				outcomes = append(outcomes, idOutcome{Answer: "error", Err: step.Text, Group: groupOf(shared)})
+				any = true
+				continue
+			}
+			matched := byName(kind)
+			switch kind {
+			case "tar":
+				matched = matched || innerTar || (decoded != nil && tarByStream(decoded))
+			default:
+				matched = matched || (decoded != nil && streamMatches(kind, decoded, k))
+			}
+			if matched {
+				outcomes = append(outcomes, idOutcome{Answer: "." + kind + suffix, Group: groupOf(shared)})
+				any = true
+			}
+		}
+		if !any {
+			if comp == "" {
+				outcomes = append(outcomes, idOutcome{Answer: "NoMatch", Group: groupOf(shared)})
+			} else {
+				outcomes = append(outcomes, idOutcome{Answer: suffix, Group: groupOf(shared)})
+			}
+		}
+	}
+	if len(comps) == 0 {
+		archival("", st.Bytes, false, decodeOutcome{Kind: "ok"}, -1)
+	}
+	for _, comp := range comps {
+		var step decodeOutcome
+		decoded, innerTar := []byte(nil), false
+		if comp == st.Own {
+			step = ownDecodeStep(st, k)
+			if step.Kind == "ok" {
+				switch st.InnerKind {
+				case "payload":
+					decoded = st.Inner
+				case "tar":
+					innerTar = true
+				}
+			}
+		} else if comp == "lz" && len(st.Bytes) < 6 {
+			outcomes = append(outcomes, idOutcome{Answer: "error", Err: lzipShortStream(len(st.Bytes)), Group: groupOf(-1)})
+			lzipShort = len(st.Bytes) > 0
+			continue
+		} else {
+			step = decodeStep(comp, st.Bytes)
+		}
+		switch step.Kind {
+		case "open":
+			outcomes = append(outcomes, idOutcome{Answer: "error", Err: step.Text, Group: groupOf(-1)})
+		case "panic":
+			if k[kIdentifyLzipTruncatedPanic] {
+				outcomes = append(outcomes, idOutcome{Answer: "panic", Group: groupOf(-1)})
+			} else {
+				// the documented answer where the library panics: the decoder reads
+				// (the archival formats match by name) or fails to open (an error
+				// whose text is not known); one answer, which of the two is open
+				shared := groupOf(-1)
+				archival(comp, nil, false, decodeOutcome{Kind: "ok"}, shared)
+				outcomes = append(outcomes, idOutcome{Answer: "error", Err: "?", Group: shared})
+			}
+		default:
+			archival(comp, decoded, innerTar, step, -1)
+		}
+	}
+	res := idResult{LzipShort: lzipShort}
+	seen := map[string]bool{}
+	groups := map[int]bool{}
+	var answers, errs []string
+	for _, o := range outcomes {
+		key := o.Answer + "|" + o.Err
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		groups[o.Group] = true
+		answers = append(answers, o.Answer)
+		if o.Answer == "error" {
+			errs = append(errs, o.Err)
+		}
+	}
+	res.Answers = uniqueStrings(answers)
+	res.Errs = uniqueStrings(errs)
+	res.Varies = len(groups) > 1
+	return res
+}
+
+func uniqueStrings(xs []string) []string {
+	var out []string
+	seen := map[string]bool{}
+	for _, x := range xs {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func containsString(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+// matchingPrefix is the "matching <format>: " Identify puts before an error (formats.go
+// :61, :82).
+var matchingPrefix = regexp.MustCompile(`^matching [^:]+: `)
+
+func stripMatching(s string) string { return matchingPrefix.ReplaceAllString(s, "") }
+
+// matchingName is the archival format named in that prefix ("" without one).
+func matchingName(s string) string {
+	return strings.TrimSuffix(strings.TrimPrefix(matchingPrefix.FindString(s), "matching "), ": ")
+}
+
+// --------------------------------------------------------------------------- the model
+
+// compressionBuilt is what the property built before the judgement: the writer's errors and
+// the stream, and for Gz the two-member stream.
+type compressionBuilt struct {
+	OpenErr, WriteErr, CloseErr error
+	Stream                      []byte
+	Two                         []byte
+	TwoErr                      error
+}
+
+// hzTools is the reference command-line decompressor of a format, when installed (read once).
+var hzTools = func() map[string][]string {
+	out := map[string][]string{}
+	for kind, cmd := range map[string][]string{
+		"gz": {"gzip", "-dc"}, "bz2": {"bzip2", "-dc"}, "xz": {"xz", "-dc"}, "zst": {"zstd", "-dc"},
+		"lz4": {"lz4", "-dc"}, "br": {"brotli", "-dc"}, "lz": {"lzip", "-dc"},
+	} {
+		if _, err := exec.LookPath(cmd[0]); err == nil {
+			out[kind] = cmd
+		}
+	}
+	return out
+}()
+
+// errKind is the kind of a writer's or reader's error: the text the recorded bugs are keyed
+// on, else the text.
+func errKind(err error) string {
+	s := err.Error()
+	for _, key := range []string{"invalid compression level", "invalid magic number"} {
+		if strings.Contains(s, key) {
+			return key
+		}
+	}
+	return s
+}
+
+// streamOfCompression is the idStream of a compression case's stream.
+func streamOfCompression(c compressionCase, stream []byte) idStream {
+	st := idStream{Bytes: stream, Own: c.Format.Kind, Inner: c.Data, InnerKind: "payload"}
+	switch c.Format.Kind {
+	case "sz", "mz", "lz":
+		st.Headerless = len(c.Data) == 0
+	}
+	return st
+}
+
+// compressionExpected states every value the property checks for the case under the switch
+// set, given the stream the writer produced (the property builds it before the judgement:
+// the brotli heuristic of archives/25 is a function of the bytes, which differ with the
+// writes' split).
+func compressionExpected(c compressionCase, k known, built compressionBuilt) checks {
+	out := checks{}
+	f := c.Format
+	// archives/10: Lz4.OpenWriter (lz4.go :43-48) passes the level as pierrec/lz4's
+	// bit-flag constant, which rejects 1..9
+	if k[kLz4CompressionLevel] && f.Kind == "lz4" && f.Level != 0 {
+		out.set("writer opens", "error: invalid compression level")
+		return out
+	}
+	out.set("writer opens", "ok")
+	out.set("write", "ok")
+	out.set("close", "ok")
+	st := streamOfCompression(c, built.Stream)
+	headerless := st.Headerless && f.Kind != "lz"
+	switch {
+	case headerless:
+		out.unspecified("match stream")
+	case ownStreamMatches(st, k):
+		out.set("match stream", "stream")
+	default:
+		out.set("match stream", "none")
+	}
+	out.set("match name", "name")
+	for _, kind := range append(append([]string(nil), compKinds...), archKinds...) {
+		if kind == f.Kind {
+			continue
+		}
+		switch {
+		case kind == "br" && (headerless || (f.Kind == "lz" && st.Headerless && k[kLzipEmptyStream])):
+			// the heuristic on a stream without a header: open for Sz and MinLZ (not
+			// judged), the heuristic's own verdict on the headerless lzip stream
+			if headerless {
+				out.unspecified("other " + kind)
+			} else if brotliMatches(built.Stream, k) {
+				out.set("other "+kind, "yes")
+			} else {
+				out.set("other "+kind, "no")
+			}
+		default:
+			out.set("other "+kind, "no")
+		}
+	}
+	if headerless {
+		out.unspecified("identify")
+	} else {
+		res := identifyOutcomes("", st, k)
+		out["identify"] = hzSet(res.Answers...)
+	}
+	// archives/24: the lzip-go writer writes the header on the first Write (lzip.go :41),
+	// so a writer closed without one gives a stream its reader rejects
+	if f.Kind == "lz" && st.Headerless && k[kLzipEmptyStream] {
+		out.set("reader", "open error: invalid magic number")
+	} else {
+		out.set("reader", "ok")
+	}
+	if _, ok := hzTools[f.Kind]; !ok {
+		out.unspecified("tool")
+	} else if f.Kind == "lz" && st.Headerless && k[kLzipEmptyStream] {
+		out.set("tool", "tool error")
+	} else {
+		out.set("tool", "ok")
+	}
+	if f.Kind == "gz" {
+		out.set("gz members whole", "ok")
+		out.set("gz members first", "ok")
+	}
+	return out
+}
+
+func init() {
+	for i, name := range []string{"writer opens", "write", "close", "match stream", "match name", "other", "identify", "reader", "tool", "gz members"} {
+		checkRank[name] = 100 + i
+	}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// compressionBuild runs the writer: OpenWriter, the writes in the case's pieces, Close; and
+// for Gz the two-member stream (the input, then "second member").
+func compressionBuild(c compressionCase) compressionBuilt {
+	var b compressionBuilt
+	var buf bytes.Buffer
+	w, err := c.Format.Format().OpenWriter(&buf)
+	if err != nil {
+		b.OpenErr = err
+		return b
+	}
+	rest := c.Data
+	for _, n := range c.Pieces {
+		if _, err := w.Write(rest[:n]); err != nil {
+			b.WriteErr = err
+			break
+		}
+		rest = rest[n:]
+	}
+	b.CloseErr = w.Close()
+	b.Stream = buf.Bytes()
+	if c.Format.Kind == "gz" {
+		var two bytes.Buffer
+		for _, member := range [][]byte{c.Data, []byte("second member")} {
+			w, err := c.Format.Format().OpenWriter(&two)
+			if err != nil {
+				b.TwoErr = err
+				break
+			}
+			if _, err := w.Write(member); err != nil {
+				b.TwoErr = err
+				break
+			}
+			if err := w.Close(); err != nil {
+				b.TwoErr = err
+				break
+			}
+		}
+		b.Two = two.Bytes()
+	}
+	return b
+}
+
+func matchValue(mr archives.MatchResult, err error) string {
+	switch {
+	case err != nil:
+		return "error: " + err.Error()
+	case mr.ByName && mr.ByStream:
+		return "both"
+	case mr.ByName:
+		return "name"
+	case mr.ByStream:
+		return "stream"
+	}
+	return "none"
+}
+
+// formatOfKind is the registered zero value of a format kind.
+func formatOfKind(kind string) archives.Format {
+	switch kind {
+	case "zip":
+		return archives.Zip{}
+	case "tar":
+		return archives.Tar{}
+	case "7z":
+		return archives.SevenZip{}
+	case "rar":
+		return archives.Rar{}
+	}
+	return compFormat{Kind: kind}.Format()
+}
+
+// readBack decodes the stream through the reader and compares it with data.
+func readBack(r io.Reader, data []byte) string {
+	back, err := io.ReadAll(r)
+	if err != nil {
+		return "read error: " + err.Error()
+	}
+	if !bytes.Equal(back, data) {
+		return fmt.Sprintf("content differs: %d bytes back, %d in", len(back), len(data))
+	}
+	return "ok"
+}
+
+// compressionActual asks the library the questions compressionExpected answered.
+func compressionActual(c *compressionCase, built compressionBuilt) checks {
+	out := checks{}
+	if built.OpenErr != nil {
+		out.set("writer opens", "error: "+errKind(built.OpenErr))
+		return out
+	}
+	out.set("writer opens", "ok")
+	if built.WriteErr != nil {
+		out.set("write", "error: "+built.WriteErr.Error())
+	} else {
+		out.set("write", "ok")
+	}
+	if built.CloseErr != nil {
+		out.set("close", "error: "+built.CloseErr.Error())
+	} else {
+		out.set("close", "ok")
+	}
+	ctx := context.Background()
+	format := c.Format.Format()
+	stream := built.Stream
+	c.notes = append(c.notes, fmt.Sprintf("stream of %d bytes: % x", len(stream), headOf(stream, 16)))
+	out.set("match stream", matchValue(format.Match(ctx, "", bytes.NewReader(stream))))
+	out.set("match name", matchValue(format.Match(ctx, "x"+strings.ToUpper(c.Format.Ext()), nil)))
+	for _, kind := range append(append([]string(nil), compKinds...), archKinds...) {
+		if kind == c.Format.Kind {
+			continue
+		}
+		mr, err := formatOfKind(kind).Match(ctx, "", bytes.NewReader(stream))
+		switch {
+		case err != nil:
+			out.set("other "+kind, "error: "+err.Error())
+		case mr.ByStream:
+			out.set("other "+kind, "yes")
+		default:
+			out.set("other "+kind, "no")
+		}
+	}
+	var f archives.Format
+	var err error
+	if p := hzCall(func() { f, _, err = archives.Identify(ctx, "", bytes.NewReader(stream)) }); p != nil {
+		out.set("identify", "panic")
+		c.notes = append(c.notes, fmt.Sprintf("Identify panicked: %v", p))
+	} else {
+		switch {
+		case errors.Is(err, archives.NoMatch):
+			out.set("identify", "NoMatch")
+		case err != nil:
+			out.set("identify", "error")
+			c.notes = append(c.notes, "Identify: "+err.Error())
+		default:
+			out.set("identify", f.Extension())
+		}
+	}
+	r, err := format.OpenReader(bytes.NewReader(stream))
+	if err != nil {
+		out.set("reader", "open error: "+errKind(err))
+	} else {
+		out.set("reader", readBack(r, c.Data))
+		r.Close()
+	}
+	if cmd, ok := hzTools[c.Format.Kind]; ok {
+		ec := exec.Command(cmd[0], cmd[1:]...)
+		ec.Stdin = bytes.NewReader(stream)
+		var stderr bytes.Buffer
+		ec.Stderr = &stderr
+		ref, err := ec.Output()
+		switch {
+		case err != nil:
+			out.set("tool", "tool error")
+			c.notes = append(c.notes, fmt.Sprintf("%s: %v: %s", strings.Join(cmd, " "), err, strings.TrimSpace(string(headOf([]byte(stderr.String()), 300)))))
+		case !bytes.Equal(ref, c.Data):
+			out.set("tool", "tool content")
+			c.notes = append(c.notes, fmt.Sprintf("%s gives %d bytes, %d in", strings.Join(cmd, " "), len(ref), len(c.Data)))
+		default:
+			out.set("tool", "ok")
+		}
+	}
+	if c.Format.Kind == "gz" {
+		if built.TwoErr != nil {
+			out.set("gz members whole", "members not written: "+built.TwoErr.Error())
+			out.set("gz members first", "members not written: "+built.TwoErr.Error())
+			return out
+		}
+		for _, name := range []string{"gz members whole", "gz members first"} {
+			g := format.(archives.Gz)
+			want := append(append([]byte(nil), c.Data...), []byte("second member")...)
+			if name == "gz members first" {
+				g.DisableMultistream = true
+				want = c.Data
+			}
+			r, err := g.OpenReader(bytes.NewReader(built.Two))
+			if err != nil {
+				out.set(name, "open error: "+err.Error())
+				continue
+			}
+			out.set(name, readBack(r, want))
+			r.Close()
+		}
+	}
+	return out
+}
+
+func headOf[T ~[]byte](b T, n int) T {
+	if len(b) > n {
+		return b[:n]
+	}
+	return b
+}
+
+// --------------------------------------------------------------------------- the property
+
+// compressionJudge builds the stream (the writer is the case's construction and the subject
+// at once: its errors are the first checks) and judges the case by compressionExpected over
+// it; the narrow properties of archives/10, 24 and 25 share it.
+func compressionJudge(j *hzCaseJudge, c compressionCase) {
+	hzTally("format " + c.Format.Kind)
+	hzTally("input " + payloadKind(c.Data))
+	built := compressionBuild(c)
+	expected := func(c compressionCase, k known) checks { return compressionExpected(c, k, built) }
+	actual := func(c *compressionCase) checks { return compressionActual(c, built) }
+	judgeBy(j, &c, expected, actual)
+}
+
+// TestHegelCompression: every compression format's writer produces a stream its own reader
+// decodes to the input, its Match recognises by content (and by name), no other format's
+// Match claims, Identify names, and the reference command-line tool decodes; a gzip stream of
+// several members reads whole unless DisableMultistream is set. The shapes of the recorded
+// bugs (an Lz4 level, an empty Lzip input, a long brotli stream of random bytes) are drawn at
+// their natural rates and fail naming the bug; under HEGEL_NO_KNOWN=1 they are not drawn, and
+// a case the classifier still names is skipped by the judge.
+func TestHegelCompression(t *testing.T) {
+	judged(t, compressionCases, compressionJudge)
+}
diff --git a/hegel/hegel_zoo_deep_test.go b/hegel/hegel_zoo_deep_test.go
new file mode 100644
index 0000000..3bade0b
--- /dev/null
+++ b/hegel/hegel_zoo_deep_test.go
@@ -0,0 +1,551 @@
+package hegel
+
+// The DeepFS property: the case records (a disk tree, the archives written into it with their
+// inner trees, a made-up lexical path), their generators, the documented model of the walk,
+// the reads and stats and the two lexical functions with the replicas of the recorded bugs
+// threaded on the switch set (deepExpected), and the wide property.
+//
+// The model: DeepFS's doc comment (fs.go :735-764): "a file system that treats archives as
+// directories", "the archive file is treated as a directory and its contents are listed as if
+// they were in a subdirectory", by file extension alone, archives within archives not
+// supported; its ReadDir (:806-810) marks "any entries that appear by their file extension to
+// be archive files" as directories so that fs.WalkDir walks into them. So the walk over
+// DeepFS{Root} visits every entry of the disk tree (a link is a link: not followed, not a
+// directory) and every archive as a directory holding its entries, and every file, on disk or
+// inside an archive, opens and stats as itself. SplitPath (:858-868): "the split point is the
+// first extension of an archive filetype like .zip or .tar.gz that occurs in the path", the
+// real path cleaned, the inner path "." for "precisely an archive file"; PathIsArchive (:954)
+// and PathContainsArchive (:970-974) are "solely by lexical analysis", the one for whether
+// the path ends with an archive, the other for whether it "traverses into" one: a segment
+// that PathIsArchive accepts (lower-cased, as PathIsArchive does; a trailing space trimmed,
+// as SplitPath does). The checks: "walk" (the sorted paths the walk visits, each with its
+// IsDir, or the walk's error), "read <p>" (the size and content hash of a file, or the error
+// kind), "stat <p>" (the size of a file, or the error kind), "split <path>" (the real and
+// inner paths) and "contains <path>" (true or false) per lexical path.
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the records
+
+// deepArchive is one archive written into the tree: its path on disk (slash-separated,
+// relative to the root), the extension it was drawn with (lower case; Path's name may be
+// upper-cased) and the inner tree it holds (never empty: the builder puts the file "only" in
+// an empty one, since an empty tar is not identified as one).
+type deepArchive struct {
+	Path  string
+	Ext   string
+	Inner []fileEntry
+}
+
+// deepCase is one case: the disk tree (files and links named like archives renamed with a
+// "_" suffix by the builder, directories named like archives kept - the shape of
+// archives/23 - unless HEGEL_NO_KNOWN=1 renames them too), the archives, and the made-up
+// lexical path; the lexical paths of the case are lexicalPaths(c). Lower is the strict pool
+// of the narrow properties of archives/22 and 23: the archive names lower-cased and no
+// upper-cased lexical form, so that archives/21 is not named first.
+type deepCase struct {
+	Tree     []fileEntry
+	Archives []deepArchive
+	MadeUp   string
+	Lower    bool
+}
+
+func (c deepCase) GoString() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "deepCase{made-up path %q, lower %v}\n%s", c.MadeUp, c.Lower, treeString(c.Tree))
+	for _, a := range c.Archives {
+		fmt.Fprintf(&b, "  archive %q (%s):\n", a.Path, a.Ext)
+		for _, line := range strings.Split(strings.TrimRight(treeString(a.Inner), "\n"), "\n") {
+			b.WriteString("  " + line + "\n")
+		}
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- the generators
+
+// hzArchiveExts is every archive extension DeepFS recognises that the package writes (its
+// archiveExtensions, fs.go :940-952, less ".tar.s2", which no format of the package writes).
+var hzArchiveExts = []string{".zip", ".tar", ".tgz", ".tar.gz", ".tar.bz2", ".tar.zst", ".tar.lz4", ".tar.xz", ".tar.sz", ".tar.lz"}
+
+// hzFormatForExt is the format that writes an archive with that extension.
+func hzFormatForExt(ext string) archives.Format {
+	switch ext {
+	case ".zip":
+		return archives.Zip{}
+	case ".tar":
+		return archives.Tar{}
+	}
+	var comp archives.Compression
+	switch ext {
+	case ".tgz", ".tar.gz":
+		comp = archives.Gz{}
+	case ".tar.bz2":
+		comp = archives.Bz2{}
+	case ".tar.zst":
+		comp = archives.Zstd{}
+	case ".tar.lz4":
+		comp = archives.Lz4{}
+	case ".tar.xz":
+		comp = archives.Xz{}
+	case ".tar.sz":
+		comp = archives.Sz{}
+	case ".tar.lz":
+		comp = archives.Lzip{}
+	}
+	return archives.CompressedArchive{Archival: archives.Tar{}, Extraction: archives.Tar{}, Compression: comp}
+}
+
+// madeUpPaths is the made-up lexical path: one of nine evenly (realised 10-12 each); at
+// weight zero under HEGEL_NO_KNOWN=1 "a.ZIP/x" (an upper-cased extension, the shape of
+// archives/21) and ".zip" (a first segment that is an extension alone, the shape of
+// archives/22).
+var madeUpPaths = halvesOver([]int{1, hzUnless(hzNoKnown, 1), 1, 1, 1, 1, 1, hzUnless(hzNoKnown, 1), 1},
+	"a.zip/b.tar/c", "a.ZIP/x", "a.tar.gz", "a.tgz/", "/a/b.tar.zst/c/d", "x.zip /y", "a.tar.gzip", ".zip", "a/.tar/b")
+
+// archiveAmong is one archive among the directories of the tree: in the root or, when there
+// is a directory, in one at 50 (realised 50), a name of arc/ARC/a b/x.y with an extension of
+// hzArchiveExts, upper-cased at 20 (realised 20; weight zero under HEGEL_NO_KNOWN=1, where an
+// upper-cased extension is the shape of archives/21 on every lexical path through it), and
+// an inner tree of up to 5 entries. Path is the archive's path before the builder's renames
+// (the directory as drawn).
+func archiveAmong(dirs []string) hegel.Generator[deepArchive] {
+	dir := hegel.Just("")
+	if len(dirs) > 0 {
+		dir = dieChoice(hzW(50, hegel.Just("")), hzW(50, evenHalves(dirs...)))
+	}
+	return archiveAt(dir)
+}
+
+// archiveAt is an archive in the directory drawn by dir.
+func archiveAt(dir hegel.Generator[string]) hegel.Generator[deepArchive] {
+	return hegel.FlatMap(dir, func(d string) hegel.Generator[deepArchive] {
+		return hegel.FlatMap(evenHalves("arc", "ARC", "a b", "x.y"), func(stem string) hegel.Generator[deepArchive] {
+			return hegel.FlatMap(evenHalves(hzArchiveExts...), func(ext string) hegel.Generator[deepArchive] {
+				return hegel.FlatMap(dieCoin(hzUnless(hzNoKnown, 20)), func(upper bool) hegel.Generator[deepArchive] {
+					name := stem + ext
+					if upper {
+						name = strings.ToUpper(name)
+					}
+					p := name
+					if d != "" {
+						p = d + "/" + name
+					}
+					return hegel.Map(treesOf(5), func(inner []fileEntry) deepArchive { return deepArchive{Path: p, Ext: ext, Inner: inner} })
+				})
+			})
+		})
+	})
+}
+
+// buildDeepCase renames the tree's files and links named like archives (DeepFS treats them
+// as archives by its documentation: not judged) and, under HEGEL_NO_KNOWN=1, its directories
+// named like archives (the shape of archives/23, otherwise kept), composing along the path;
+// makes every directory writable (DeepFS opens them); moves the archives into the renamed
+// directories, dropping one whose path is taken (lower-casing their names for the strict
+// pool); and fills an empty inner tree.
+func buildDeepCase(tree []fileEntry, archs []deepArchive, madeUp string, lower bool) deepCase {
+	renamed := map[string]string{}
+	out := make([]fileEntry, 0, len(tree))
+	for _, e := range tree {
+		p := path.Base(e.Path)
+		if parent := path.Dir(e.Path); parent != "." {
+			p = renamed[parent] + "/" + p
+		}
+		if archives.PathIsArchive(p) && (e.Kind != 'd' || hzNoKnown) {
+			p += "_"
+		}
+		renamed[e.Path] = p
+		e.Path = p
+		if e.Kind == 'd' {
+			e.Mode |= 0o700
+		}
+		out = append(out, e)
+	}
+	taken := map[string]bool{}
+	for _, e := range out {
+		taken[e.Path] = true
+	}
+	var as []deepArchive
+	for _, a := range archs {
+		p := path.Base(a.Path)
+		if lower {
+			p = strings.ToLower(p)
+		}
+		if parent := path.Dir(a.Path); parent != "." {
+			p = renamed[parent] + "/" + p
+		}
+		if taken[p] {
+			continue
+		}
+		taken[p] = true
+		a.Path = p
+		if len(a.Inner) == 0 {
+			a.Inner = []fileEntry{{Path: "only", Kind: 'f', Data: []byte("x"), Mode: 0o644}}
+		}
+		as = append(as, a)
+	}
+	return deepCase{Tree: out, Archives: as, MadeUp: madeUp, Lower: lower}
+}
+
+// deepCasesWith is a case over the trees: up to 3 archives, the count drawn evenly (realised
+// 25 each), and a made-up path of madeUp; lower for the strict pool.
+func deepCasesWith(trees hegel.Generator[[]fileEntry], madeUp hegel.Generator[string], lower bool) hegel.Generator[deepCase] {
+	return hegel.FlatMap(trees, func(tree []fileEntry) hegel.Generator[deepCase] {
+		return hegel.FlatMap(countedHalves(archiveAmong(dirsOf(tree)), 0, 3), func(archs []deepArchive) hegel.Generator[deepCase] {
+			return hegel.Map(madeUp, func(m string) deepCase { return buildDeepCase(tree, archs, m, lower) })
+		})
+	})
+}
+
+var deepCases = deepCasesWith(treesOf(6), madeUpPaths, false)
+
+// --------------------------------------------------------------------------- the model
+
+// modelPaths is every path the walk visits, with its kind: the tree's entries, the archives
+// (as directories) and their inner entries.
+func modelPaths(c deepCase) map[string]byte {
+	m := map[string]byte{}
+	for _, e := range c.Tree {
+		m[e.Path] = e.Kind
+	}
+	for _, a := range c.Archives {
+		m[a.Path] = 'd'
+		for _, e := range a.Inner {
+			m[a.Path+"/"+e.Path] = e.Kind
+		}
+	}
+	return m
+}
+
+// lexicalPaths is the lexical paths of a case: every model path with its "/"-prefixed,
+// "/"-suffixed and (not under HEGEL_NO_KNOWN=1 or in the strict pool, since an upper-cased
+// archive extension is the shape of archives/21) upper-cased forms, and the made-up path.
+func lexicalPaths(c deepCase) []string {
+	var ps []string
+	for p := range modelPaths(c) {
+		ps = append(ps, p, "/"+p, p+"/")
+		if !hzNoKnown && !c.Lower {
+			ps = append(ps, strings.ToUpper(p))
+		}
+	}
+	ps = append(ps, c.MadeUp)
+	sort.Strings(ps)
+	return ps
+}
+
+// inArchiveNamedDir reports whether a directory above p is named like an archive (the
+// region of archives/23).
+func inArchiveNamedDir(c deepCase, p string) bool {
+	for dir := path.Dir(p); dir != "."; dir = path.Dir(dir) {
+		if e := entryAt(c.Tree, dir); e != nil && e.Kind == 'd' && archives.PathIsArchive(dir) {
+			return true
+		}
+	}
+	return false
+}
+
+// splitDocumented is SplitPath as documented: the first segment that is an archive (lower-
+// cased, a trailing space trimmed) ends the real path; the inner path is the rest, "." for a
+// path that is precisely an archive.
+func splitDocumented(p string) (string, string) {
+	segs := strings.Split(p, "/")
+	for i, s := range segs {
+		if archives.PathIsArchive(strings.TrimRight(strings.ToLower(s), " ")) {
+			real := filepath.Clean(filepath.FromSlash(strings.Join(segs[:i+1], "/")))
+			inner := strings.Join(segs[i+1:], "/")
+			if inner == "" && i == len(segs)-1 {
+				inner = "."
+			}
+			return real, inner
+		}
+	}
+	return filepath.Clean(filepath.FromSlash(p)), ""
+}
+
+// splitScanned is SplitPath's own scan, fs.go :869-918 transcribed (archives/22): the scan
+// starts at index 1, so the first character of a relative path's first segment is never
+// examined.
+func splitScanned(p string) (realPath, innerPath string) {
+	if len(p) < 2 {
+		return p, ""
+	}
+	start, end := 1, strings.Index(p[1:], "/")+1
+	if end-start < 0 {
+		end = len(p)
+	}
+	for {
+		part := strings.TrimRight(strings.ToLower(p[start:end]), " ")
+		if archives.PathIsArchive(part) {
+			realPath = filepath.Clean(filepath.FromSlash(p[:end]))
+			if end < len(p) {
+				innerPath = p[end+1:]
+			} else {
+				innerPath = "."
+			}
+			return
+		}
+		start = end + 1
+		if start > len(p) {
+			break
+		}
+		end = strings.Index(p[start:], "/") + start
+		if end-start < 0 {
+			end = len(p)
+		}
+	}
+	return filepath.Clean(filepath.FromSlash(p)), ""
+}
+
+// containsDocumented is PathContainsArchive as documented: a segment of the path is an
+// archive by PathIsArchive.
+func containsDocumented(p string) bool {
+	for _, s := range strings.Split(p, "/") {
+		if archives.PathIsArchive(s) {
+			return true
+		}
+	}
+	return false
+}
+
+// containsAsWritten is PathContainsArchive's own test, fs.go :975-983 transcribed
+// (archives/21): the extensions against the path as given, case-sensitively.
+func containsAsWritten(p string) bool {
+	all := append(append([]string(nil), hzArchiveExts...), ".tar.s2")
+	for _, ext := range all {
+		if strings.Contains(p+"/", ext+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+func fileValue(data []byte) string {
+	sum := sha256.Sum256(data)
+	return fmt.Sprintf("size=%d sha=%s", len(data), hex.EncodeToString(sum[:4]))
+}
+
+// deepExpected states every value the property checks.
+func deepExpected(c deepCase, k known) checks {
+	out := checks{}
+	paths := modelPaths(c)
+	// archives/23: an archive below a directory named like one is read through a DirFS
+	// (getInnerFsys, fs.go :839-856, FileSystem :47-71), whose ReadDir (:223-228) does not
+	// mark it as a directory (DeepFS.ReadDir :828-832 does): the walk takes it for a file,
+	// its entries are absent, and a path into it opens through the DirFS as a path through
+	// a file (ENOTDIR)
+	flat := map[string]bool{}
+	if k[kDeepFSDirNamedArchive] {
+		for _, a := range c.Archives {
+			if inArchiveNamedDir(c, a.Path) {
+				flat[a.Path] = true
+			}
+		}
+	}
+	var lines []string
+	for p, kind := range paths {
+		under := ""
+		for f := range flat {
+			if strings.HasPrefix(p, f+"/") {
+				under = f
+			}
+		}
+		if under != "" {
+			continue
+		}
+		isDir := kind == 'd'
+		if flat[p] {
+			isDir = false
+		}
+		lines = append(lines, fmt.Sprintf("%v %s", isDir, p))
+	}
+	sort.Strings(lines)
+	out.set("walk", strings.Join(lines, "\n"))
+	for _, e := range c.Tree {
+		if e.Kind == 'f' {
+			out.set("read "+e.Path, fileValue(e.Data))
+			out.set("stat "+e.Path, "file size="+strconv.Itoa(len(e.Data)))
+		}
+	}
+	for _, a := range c.Archives {
+		for _, e := range a.Inner {
+			if e.Kind != 'f' {
+				continue
+			}
+			p := a.Path + "/" + e.Path
+			if flat[a.Path] {
+				out.set("read "+p, "error: notdir")
+				out.set("stat "+p, "error: notdir")
+				continue
+			}
+			out.set("read "+p, fileValue(e.Data))
+			out.set("stat "+p, "file size="+strconv.Itoa(len(e.Data)))
+		}
+	}
+	for _, p := range lexicalPaths(c) {
+		real, inner := splitDocumented(p)
+		if k[kSplitPathFirstSegment] {
+			real, inner = splitScanned(p)
+		}
+		out.set("split "+p, fmt.Sprintf("%q %q", real, inner))
+		contains := containsDocumented(p)
+		if k[kPathContainsArchiveCase] {
+			contains = containsAsWritten(p)
+		}
+		out.set("contains "+p, contains)
+	}
+	return out
+}
+
+func init() {
+	for i, name := range []string{"walk", "read", "stat", "split", "contains"} {
+		checkRank[name] = 10 + i
+	}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// deepErrKind is the kind of an error of DeepFS: "notexist", "notdir", "invalid", else the
+// text.
+func deepErrKind(err error) string {
+	switch {
+	case errors.Is(err, fs.ErrNotExist):
+		return "notexist"
+	case errors.Is(err, syscall.ENOTDIR):
+		return "notdir"
+	case errors.Is(err, fs.ErrInvalid):
+		return "invalid"
+	}
+	return err.Error()
+}
+
+// writeArchives writes the case's archives under dir: the bytes are the package's own
+// Archive of FilesFromFS over the inner tree (the archive writer, not the subject).
+func writeArchives(c deepCase, dir string) error {
+	for _, a := range c.Archives {
+		files, err := archives.FilesFromFS(context.Background(), treeMapFS(a.Inner), nil, nil)
+		if err != nil {
+			return fmt.Errorf("FilesFromFS of the inner tree of %s: %w", a.Path, err)
+		}
+		var buf bytes.Buffer
+		if err := hzFormatForExt(a.Ext).(archives.Archiver).Archive(context.Background(), &buf, files); err != nil {
+			return fmt.Errorf("Archive of %s: %w", a.Path, err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, filepath.FromSlash(a.Path)), buf.Bytes(), 0o644); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// deepActual asks DeepFS{Root: dir} the questions deepExpected answered.
+func deepActual(c deepCase, dir string) checks {
+	out := checks{}
+	dfs := &archives.DeepFS{Root: dir}
+	var lines []string
+	err := fs.WalkDir(dfs, ".", func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return fmt.Errorf("at %q: %w", p, err)
+		}
+		if p != "." {
+			lines = append(lines, fmt.Sprintf("%v %s", d.IsDir(), p))
+		}
+		return nil
+	})
+	if err != nil {
+		out.set("walk", "error: "+err.Error())
+	} else {
+		sort.Strings(lines)
+		out.set("walk", strings.Join(lines, "\n"))
+	}
+	ask := func(p string) {
+		if data, err := fs.ReadFile(dfs, p); err != nil {
+			out.set("read "+p, "error: "+deepErrKind(err))
+		} else {
+			out.set("read "+p, fileValue(data))
+		}
+		if info, err := fs.Stat(dfs, p); err != nil {
+			out.set("stat "+p, "error: "+deepErrKind(err))
+		} else if info.IsDir() {
+			out.set("stat "+p, "dir")
+		} else {
+			out.set("stat "+p, "file size="+strconv.FormatInt(info.Size(), 10))
+		}
+	}
+	for _, e := range c.Tree {
+		if e.Kind == 'f' {
+			ask(e.Path)
+		}
+	}
+	for _, a := range c.Archives {
+		for _, e := range a.Inner {
+			if e.Kind == 'f' {
+				ask(a.Path + "/" + e.Path)
+			}
+		}
+	}
+	for _, p := range lexicalPaths(c) {
+		real, inner := dfs.SplitPath(p)
+		out.set("split "+p, fmt.Sprintf("%q %q", real, inner))
+		out.set("contains "+p, archives.PathContainsArchive(p))
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the property
+
+// deepJudgeWith is the judge of the family: the tree and the archives written under a fresh
+// directory of root, then judgeBy over deepExpected and deepActual. The narrow properties
+// share it.
+func deepJudgeWith(root string) func(j *hzCaseJudge, c deepCase) {
+	n := 0
+	return func(j *hzCaseJudge, c deepCase) {
+		n++
+		dir := filepath.Join(root, "t"+strconv.Itoa(n))
+		if err := os.Mkdir(dir, 0o700); err != nil {
+			panic(err)
+		}
+		defer func() { restoreDisk(dir); os.RemoveAll(dir) }()
+		if err := treeToDisk(c.Tree, dir); err != nil {
+			panic(fmt.Sprintf("writing the tree: %v", err))
+		}
+		if err := writeArchives(c, dir); err != nil {
+			j.Fail("writer", "%v for\n%#v", err, c)
+			return
+		}
+		judgeBy(j, &c, deepExpected, func(c *deepCase) checks { return deepActual(*c, dir) })
+	}
+}
+
+// wideDeepCases is the cases of the wide property: under HEGEL_NO_KNOWN=1 the three shapes
+// are off by weight (the upper-cased forms and names, the ".zip" made-up path) and by the
+// builder's renaming; withoutShapes is the backstop (counted "filtered archives/N").
+var wideDeepCases = withoutShapes(deepExpected, deepCases)
+
+// TestHegelDeepFS: a directory on disk holding files, directories, links and archives written
+// by the package (every archive extension DeepFS recognises) walks, through DeepFS, as the
+// disk tree with every archive replaced by a directory of its entries; the files inside read
+// and stat as their contents. SplitPath splits at the first archive extension;
+// PathContainsArchive agrees with PathIsArchive on the path's segments.
+func TestHegelDeepFS(t *testing.T) {
+	judged(t, wideDeepCases, deepJudgeWith(filesRoot(t)))
+}
diff --git a/hegel/hegel_zoo_files_test.go b/hegel/hegel_zoo_files_test.go
new file mode 100644
index 0000000..e8b2985
--- /dev/null
+++ b/hegel/hegel_zoo_files_test.go
@@ -0,0 +1,1056 @@
+package hegel
+
+// The FilesFromFS / FilesFromDisk property: the case records (a tree of files, directories
+// and links, the one entry of the filenames map, the options), their generators, the
+// documented model of what the two functions gather with the replicas of the recorded bugs
+// threaded on the switch set (filesExpected), the child process a case whose expansion never
+// ends is judged in, and the wide property.
+//
+// The model: the doc comment of FilesFromDisk (archives.go :52-72; FilesFromFS :165-184 says
+// the same) gives the rules of the filenames map - a key names a file or a directory, which
+// is walked and added "rooted at the named directory"; a key ending in a separator
+// "enumerates contents only, without adding the folder itself"; an empty value is "the base
+// name of the file (sans path) in the root of the archive", "." (nameOnDiskToNameInArchive
+// :292-298) the root of the archive without the base name, and a value ending in a slash
+// "the base name of the file in that folder". FollowSymlinks (:343-346): "the link will not
+// be added as a link, but what the link points to will be added as a file": a link to a file
+// is gathered as that file under the link's name, a link to a directory as that directory
+// and everything in it under the link's name, followed again inside, and a link that points
+// at nothing is an error. ClearAttributes (:348-350): "Name, size, type, and permissions
+// will still be preserved", the time and Sys are not. A link whose expansion leads back to
+// an ancestor directory has no end: the documented outcome of the call is that it returns
+// (the "returns" check); what it returns is not documented (the "error", "names" and "entry"
+// checks are the open marker). The checks per side ("fs" then "disk"): "<side> returns"
+// ("returned" or "hang"), "<side> error" (the kind: "none"; "dangling" for the text
+// "statting dereferenced symlink", the one text both sides give for a followed link whose
+// target cannot be stat'ed; "symlink directory" for "getting files from symlink directory";
+// "loop" and "depth" for followSymlink's own; "open" for an fs.ErrNotExist of the walk's
+// root; else the text), and, when no error is stated, "<side> names" (the sorted names in
+// the archive) and "<side> entry <name>" (the kind, the link target, the size and content
+// hash, the permission bits, the time or "cleared"; the root directory itself, whose
+// attributes are the temporary directory's, is open).
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"testing/fstest"
+	"time"
+
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the records
+
+// fileEntry is one entry of a tree: a slash-separated clean relative path (parents come
+// before children in the list), the kind ('d', 'f', 'l'), the content of a file, the target
+// of a link as written, the permission bits and the time. Fallback is the name a link is
+// redirected to under /nowhere/ when its target would be itself or another link (settle).
+// The fields are exported for the child process, which takes the case as JSON.
+type fileEntry struct {
+	Path     string
+	Kind     byte
+	Data     []byte
+	Link     string
+	Mode     fs.FileMode
+	Mtime    time.Time
+	Fallback string
+}
+
+// filesCase is one case: the tree, the one entry of the filenames map (the key a tree path
+// or "." for the root, with a trailing slash for a directory's contents; the value as
+// documented) and the two options.
+type filesCase struct {
+	Tree   []fileEntry
+	Key    string
+	Value  string
+	Follow bool
+	Clear  bool
+}
+
+func treeString(tree []fileEntry) string {
+	if len(tree) == 0 {
+		return "  (empty)\n"
+	}
+	var b strings.Builder
+	for _, e := range tree {
+		fmt.Fprintf(&b, "  %c %q mode %o", e.Kind, e.Path, e.Mode)
+		if e.Kind == 'f' {
+			fmt.Fprintf(&b, " (%d bytes)", len(e.Data))
+		}
+		if e.Kind == 'l' {
+			fmt.Fprintf(&b, " -> %q", e.Link)
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+func (c filesCase) GoString() string {
+	return fmt.Sprintf("filesCase{%q: %q, FollowSymlinks %v, ClearAttributes %v}\n%s", c.Key, c.Value, c.Follow, c.Clear, treeString(c.Tree))
+}
+
+// --------------------------------------------------------------------------- the pools
+
+// treeNames is the name pool (the old hzNames, byte for byte).
+var treeNames = []string{
+	"a", "b", "c.txt", "d.zip", "e.tar", "f.tar.gz", "g.tgz", "h i", "j.jpg", "K", "l.bak",
+	"m.tar.txt", "n.gz", "o..p", "q-r", "s_t", "u.PNG", "v.7z", "w.zst", "x", "y.json", "z.tar.zst",
+	"caf\u00e9", "0", "1.2.3", "long-name-with-many-characters-in-it-for-headers.txt",
+}
+
+var fileSizes = []int{0, 1, 7, 100, 511, 512, 513, 1023, 1024, 1025, 1500, 4096}
+
+// fileData is the content of a file: a size from the table 60 percent of the time (realised
+// 60), else 0..3000; compressible text, one byte repeated, or random bytes a third each
+// (realised 33/33/34).
+var fileData = hegel.FlatMap(dieChoice(hzW(60, evenHalves(fileSizes...)), hzW(40, rangeHalves(0, 3000))), func(n int) hegel.Generator[[]byte] {
+	return halvesGens([]int{1, 1, 1},
+		hegel.Just(bytes.Repeat([]byte("the quick brown fox "), n/20+1)[:n]),
+		hegel.Map(rangeHalves(0, 255), func(b int) []byte { return bytes.Repeat([]byte{byte(b)}, n) }),
+		hegel.Binary(n, n))
+})
+
+// entryTime is a time in 1981..2099, whole seconds: inside every format's range (zip's MS-DOS
+// time starts in 1980); the engine's integer draw favours the small values, so most times
+// are in the eighties, as the old draw gave them.
+var entryTime = hegel.Map(hegel.Integers(350000000, 4100000000), func(s int) time.Time { return time.Unix(int64(s), 0).UTC() })
+
+var entryName = evenHalves(treeNames...)
+
+var dirMode = hegel.Map(rangeHalves(0, 0o77), func(m int) fs.FileMode { return fs.FileMode(0o700 | m) })
+
+var fileMode = hegel.Map(rangeHalves(0, 0o177), func(m int) fs.FileMode { return fs.FileMode(0o600 | m) })
+
+// --------------------------------------------------------------------------- the tree
+
+func dirsOf(tree []fileEntry) []string {
+	var ds []string
+	for _, e := range tree {
+		if e.Kind == 'd' {
+			ds = append(ds, e.Path)
+		}
+	}
+	return ds
+}
+
+func pathsOf(tree []fileEntry) []string {
+	var ps []string
+	for _, e := range tree {
+		ps = append(ps, e.Path)
+	}
+	return ps
+}
+
+func entryAt(tree []fileEntry, p string) *fileEntry {
+	for i := range tree {
+		if tree[i].Path == p {
+			return &tree[i]
+		}
+	}
+	return nil
+}
+
+// linkTargetAmong is the target of a link at p (under parent) given the entries drawn so
+// far: a sibling name, the path of an earlier entry ("x" when there is none), "../name", "."
+// in a subdirectory (a name at the root), or "/nowhere/name", at a fifth each (realised
+// 21/19/20/20/20).
+func linkTargetAmong(prefix []fileEntry, parent string) hegel.Generator[string] {
+	earlier := hegel.Just("x")
+	if len(prefix) > 0 {
+		earlier = evenHalves(pathsOf(prefix)...)
+	}
+	own := hegel.Just(".")
+	if parent == "" {
+		own = entryName
+	}
+	return halvesGens([]int{1, 1, 1, 1, 1},
+		entryName,
+		earlier,
+		hegel.Map(entryName, func(n string) string { return "../" + n }),
+		own,
+		hegel.Map(entryName, func(n string) string { return "/nowhere/" + n }))
+}
+
+// entryAmong is one entry drawn after the entries of prefix: under a directory drawn so far
+// 60 percent of the time when there is one (realised 60), a name of the pool, and a
+// directory a quarter of the time (mode 0700 | 0..077), a file 60 (mode 0600 | 0..0177), a
+// link 15 (realised 25/60/15), each with a time.
+func entryAmong(prefix []fileEntry) hegel.Generator[fileEntry] {
+	parent := hegel.Just("")
+	if ds := dirsOf(prefix); len(ds) > 0 {
+		parent = dieChoice(hzW(40, hegel.Just("")), hzW(60, evenHalves(ds...)))
+	}
+	return hegel.FlatMap(parent, func(par string) hegel.Generator[fileEntry] {
+		return hegel.FlatMap(entryName, func(name string) hegel.Generator[fileEntry] {
+			p := name
+			if par != "" {
+				p = par + "/" + name
+			}
+			return hegel.FlatMap(entryTime, func(mt time.Time) hegel.Generator[fileEntry] {
+				dir := hegel.Map(dirMode, func(m fs.FileMode) fileEntry { return fileEntry{Path: p, Kind: 'd', Mode: m, Mtime: mt} })
+				file := hegel.FlatMap(fileData, func(data []byte) hegel.Generator[fileEntry] {
+					return hegel.Map(fileMode, func(m fs.FileMode) fileEntry { return fileEntry{Path: p, Kind: 'f', Data: data, Mode: m, Mtime: mt} })
+				})
+				link := hegel.FlatMap(linkTargetAmong(prefix, par), func(target string) hegel.Generator[fileEntry] {
+					return hegel.Map(entryName, func(fallback string) fileEntry {
+						return fileEntry{Path: p, Kind: 'l', Link: target, Mode: 0o777, Mtime: mt, Fallback: fallback}
+					})
+				})
+				return halvesGens([]int{25, 60, 15}, dir, file, link)
+			})
+		})
+	})
+}
+
+// treeFrom draws left more entries after prefix, one after the other (each entry's parent
+// and link target depend on the ones before it); an entry whose path is already there is
+// dropped. The result is settled.
+func treeFrom(prefix []fileEntry, left int) hegel.Generator[[]fileEntry] {
+	if left == 0 {
+		return hegel.Just(prefix)
+	}
+	return hegel.FlatMap(entryAmong(prefix), func(e fileEntry) hegel.Generator[[]fileEntry] {
+		next := prefix
+		if entryAt(prefix, e.Path) == nil {
+			next = append(append([]fileEntry(nil), prefix...), e)
+		}
+		return treeFrom(next, left-1)
+	})
+}
+
+// resolveLink resolves a link target the way a file system does: relative to the link's
+// directory, staying inside the tree. It returns the tree path ("." for the root), or ""
+// when the target leaves the tree or is absolute.
+func resolveLink(linkPath, target string) string {
+	if strings.HasPrefix(target, "/") {
+		return ""
+	}
+	p := path.Join(path.Dir(linkPath), target)
+	if p == ".." || strings.HasPrefix(p, "../") {
+		return ""
+	}
+	return p
+}
+
+// settle redirects every link whose target resolves to itself or to another link to
+// /nowhere/<its fallback name> (a loop of links would not resolve, and fstest.MapFS follows
+// chains without end); the kinds are read from the tree as drawn, so the order of the links
+// does not matter. A pure function of the drawn tree, run once by the builder.
+func settle(tree []fileEntry) []fileEntry {
+	out := append([]fileEntry(nil), tree...)
+	for i := range out {
+		e := &out[i]
+		if e.Kind != 'l' {
+			continue
+		}
+		if r := resolveLink(e.Path, e.Link); r != "" {
+			if r == e.Path {
+				e.Link = "/nowhere/" + e.Fallback
+			} else if t := entryAt(tree, r); t != nil && t.Kind == 'l' {
+				e.Link = "/nowhere/" + e.Fallback
+			}
+		}
+	}
+	return out
+}
+
+// treesOf is a tree of up to n entries, the count drawn evenly (realised 11 each for n 8).
+func treesOf(n int) hegel.Generator[[]fileEntry] {
+	return hegel.Map(hegel.FlatMap(rangeHalves(0, n), func(k int) hegel.Generator[[]fileEntry] { return treeFrom(nil, k) }), settle)
+}
+
+var fileTrees = treesOf(8)
+
+// --------------------------------------------------------------------------- the mapping
+
+// mapValues is the value of the map entry: "" twice, ".", "x", "x/", "x/y", "x/y/" (realised
+// 29/14/14/14/14/14).
+var mapValues = halvesOver([]int{2, 1, 1, 1, 1, 1}, "", ".", "x", "x/", "x/y", "x/y/")
+
+// buildFilesCase settles the two documented-unspecified combinations of the mapping: a file
+// key with the value "." (a file with an empty name in the archive) takes "", and a key with
+// a trailing slash with a slash-ended value (the contents of a folder into a folder named
+// for it) takes "x".
+func buildFilesCase(tree []fileEntry, key, value string, follow, clear bool) filesCase {
+	trailing := strings.HasSuffix(key, "/")
+	isDir := key == "." || trailing || entryAt(tree, key).Kind == 'd'
+	if !isDir && value == "." {
+		value = ""
+	}
+	if trailing && strings.HasSuffix(value, "/") {
+		value = "x"
+	}
+	return filesCase{Tree: tree, Key: key, Value: value, Follow: follow, Clear: clear}
+}
+
+// filesCasesOf is a case over the trees: the key the root "." a quarter of the time or when
+// the tree has no file or directory (realised 25 of the keys drawn, 37 of all cases), else a
+// file or directory of the tree; a directory key with a trailing slash 30 percent of the
+// time (realised 30); a value of mapValues; FollowSymlinks 30 (realised 30), ClearAttributes
+// 30 (realised 30).
+func filesCasesOf(trees hegel.Generator[[]fileEntry]) hegel.Generator[filesCase] {
+	return hegel.FlatMap(trees, func(tree []fileEntry) hegel.Generator[filesCase] {
+		var cands []string
+		for _, e := range tree {
+			if e.Kind != 'l' {
+				cands = append(cands, e.Path)
+			}
+		}
+		key := hegel.Just(".")
+		if len(cands) > 0 {
+			key = dieChoice(hzW(25, hegel.Just(".")), hzW(75, evenHalves(cands...)))
+		}
+		return hegel.FlatMap(key, func(k string) hegel.Generator[filesCase] {
+			trailing := hegel.Just(false)
+			if k != "." && entryAt(tree, k).Kind == 'd' {
+				trailing = dieCoin(27)
+			}
+			return hegel.FlatMap(trailing, func(tr bool) hegel.Generator[filesCase] {
+				if tr {
+					k += "/"
+				}
+				return hegel.FlatMap(mapValues, func(v string) hegel.Generator[filesCase] {
+					return hegel.FlatMap(dieCoin(30), func(follow bool) hegel.Generator[filesCase] {
+						return hegel.Map(dieCoin(30), func(clear bool) filesCase { return buildFilesCase(tree, k, v, follow, clear) })
+					})
+				})
+			})
+		})
+	})
+}
+
+var filesCases = filesCasesOf(fileTrees)
+
+// --------------------------------------------------------------------------- writing a tree
+
+// treeMapFS writes the tree to a fstest.MapFS.
+func treeMapFS(tree []fileEntry) fstest.MapFS {
+	m := fstest.MapFS{}
+	for _, e := range tree {
+		switch e.Kind {
+		case 'd':
+			m[e.Path] = &fstest.MapFile{Mode: fs.ModeDir | e.Mode, ModTime: e.Mtime}
+		case 'f':
+			m[e.Path] = &fstest.MapFile{Data: e.Data, Mode: e.Mode, ModTime: e.Mtime}
+		case 'l':
+			m[e.Path] = &fstest.MapFile{Data: []byte(e.Link), Mode: fs.ModeSymlink | e.Mode, ModTime: e.Mtime}
+		}
+	}
+	return m
+}
+
+// treeToDisk writes the tree under dir (which must exist and be empty); the directories'
+// permissions and times are set last, deepest first, after their contents.
+func treeToDisk(tree []fileEntry, dir string) error {
+	var dirs []fileEntry
+	for _, e := range tree {
+		p := filepath.Join(dir, filepath.FromSlash(e.Path))
+		switch e.Kind {
+		case 'd':
+			if err := os.Mkdir(p, 0o700); err != nil {
+				return err
+			}
+			dirs = append(dirs, e)
+		case 'f':
+			if err := os.WriteFile(p, e.Data, e.Mode); err != nil {
+				return err
+			}
+			if err := os.Chmod(p, e.Mode); err != nil {
+				return err
+			}
+			if err := os.Chtimes(p, e.Mtime, e.Mtime); err != nil {
+				return err
+			}
+		case 'l':
+			if err := os.Symlink(e.Link, p); err != nil {
+				return err
+			}
+		}
+	}
+	for i := len(dirs) - 1; i >= 0; i-- {
+		p := filepath.Join(dir, filepath.FromSlash(dirs[i].Path))
+		if err := os.Chtimes(p, dirs[i].Mtime, dirs[i].Mtime); err != nil {
+			return err
+		}
+		if err := os.Chmod(p, dirs[i].Mode); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// restoreDisk makes every directory under dir writable again so it can be removed.
+func restoreDisk(dir string) {
+	filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {
+		if err == nil && d.IsDir() {
+			os.Chmod(p, 0o700)
+		}
+		return nil
+	})
+}
+
+// treeRoot is the base name of the directory a tree is written to on disk: the names the
+// disk side gives a root key are built on it (filesExpected takes it as rootBase), so it is
+// the same in every case and in the child process.
+const treeRoot = "tree"
+
+// --------------------------------------------------------------------------- the model
+
+// found is one gathered entry as the model states it: the name in the archive and the
+// attributes the library reports (Root: the root directory itself, whose attributes are the
+// temporary directory's and are not stated).
+type found struct {
+	Name  string
+	Kind  byte
+	Link  string
+	Data  []byte
+	Mode  fs.FileMode
+	Mtime time.Time
+	Root  bool
+}
+
+// entryValue spells the attributes of a gathered entry as the checks compare them.
+func entryValue(f found, clear bool) string {
+	if f.Root {
+		return hzUnspecified
+	}
+	switch f.Kind {
+	case 'l':
+		return "link -> " + f.Link
+	case 'd':
+		return "dir mode=" + strconv.FormatInt(int64(f.Mode), 8) + " " + timeValue(f.Mtime, clear)
+	}
+	sum := sha256.Sum256(f.Data)
+	return fmt.Sprintf("file size=%d read=%d sha=%s mode=%o %s", len(f.Data), len(f.Data), hex.EncodeToString(sum[:4]), f.Mode, timeValue(f.Mtime, clear))
+}
+
+func timeValue(t time.Time, clear bool) string {
+	if clear {
+		return "cleared"
+	}
+	return "mtime=" + strconv.FormatInt(t.Unix(), 10)
+}
+
+// walkKey is the sort key of fs.WalkDir's order (lexical within each directory, a
+// directory's contents right after it): the path with the separator below every other byte.
+func walkKey(p string) string { return strings.ReplaceAll(p, "/", "\x00") }
+
+// trimTopDir and topDir are archives.go :312-329, transcribed.
+func trimTopDir(dir string) string {
+	return strings.TrimPrefix(dir, topDir(dir)+"/")
+}
+
+func topDir(dir string) string {
+	var start int
+	if len(dir) > 0 && dir[0] == '/' {
+		start = 1
+	}
+	if pos := strings.Index(dir[start:], "/"); pos >= 0 {
+		return dir[:pos+start]
+	}
+	return dir
+}
+
+// nameInArchive is nameOnDiskToNameInArchive (archives.go :277-306), transcribed, with the
+// two documented rules in place of the library's where a switch is off: a key with a
+// trailing separator enumerates contents only (the value is the folder of the contents;
+// under kFsTrailingKeyValue the library's :286 trims the value's first element, archives/16),
+// and the name of an entry is its path below the key (the library's :304 keeps the separator
+// after a key without a trailing one, which :305 joins onto an empty root as a leading
+// slash under kFsRootDotLeadingSlash, archives/14).
+func nameInArchive(nameOnDisk, rootOnDisk, rootInArchive string, k known) string {
+	if strings.HasSuffix(rootOnDisk, "/") {
+		if k[kFsTrailingKeyValue] {
+			rootInArchive = trimTopDir(rootInArchive) // :286
+		}
+	} else if rootInArchive == "" {
+		rootInArchive = path.Base(rootOnDisk) // :290
+	}
+	if rootInArchive == "." {
+		rootInArchive = "" // :297
+	}
+	if strings.HasSuffix(rootInArchive, "/") {
+		rootInArchive += path.Base(rootOnDisk) // :302
+	}
+	truncPath := strings.TrimPrefix(nameOnDisk, rootOnDisk) // :304
+	if !k[kFsRootDotLeadingSlash] {
+		truncPath = strings.TrimPrefix(truncPath, "/")
+	}
+	return path.Join(rootInArchive, truncPath) // :305
+}
+
+// errKindOf is the kind of an error of the two functions (the texts of archives.go :492,
+// :531, :501, :540, :505, :544, :125, :232 and the walk's own fs.ErrNotExist).
+func errKindOf(err error) string {
+	if err == nil {
+		return "none"
+	}
+	s := err.Error()
+	switch {
+	case strings.Contains(s, "statting dereferenced symlink"):
+		return "dangling"
+	case strings.Contains(s, "symlink loop"):
+		return "loop"
+	case strings.Contains(s, "maximum symlink depth"):
+		return "depth"
+	case strings.Contains(s, "getting files from symlink directory"):
+		return "symlink directory"
+	case errors.Is(err, fs.ErrNotExist) || strings.Contains(s, "file does not exist") || strings.Contains(s, "no such file"):
+		return "open"
+	}
+	return "other: " + s
+}
+
+// gather walks one side of a case under the switch set: the documented rules with the
+// replicas where a switch is on. The fs side's paths are relative to a root prefix (the
+// subtree a nested walk is rooted at under kFsFollowDirLink); the disk side's root is the
+// directory treeRoot. The walk order is fs.WalkDir's; the first error ends the walk; an
+// expansion deeper than the tree's size is a loop (the documented expansion has no end).
+type gather struct {
+	c        filesCase
+	k        known
+	side     string
+	rootBase string
+	out      []found
+	err      string
+	loop     bool
+}
+
+// onDisk is the name on disk of a tree path (the disk side's absolute names stand in by
+// rootBase, the base of the directory the tree is written to; the fs side's names are the
+// paths themselves relative to the prefix).
+func (g *gather) onDisk(prefix, p string) string {
+	if g.side == "disk" {
+		if p == "." {
+			return g.rootBase
+		}
+		return g.rootBase + "/" + p
+	}
+	if prefix != "" && p == strings.TrimSuffix(prefix, "/") {
+		return "."
+	}
+	return strings.TrimPrefix(p, prefix)
+}
+
+// resolveFS is the fs side's resolution of a link's target: as the file system resolves it,
+// relative to the link's directory (resolveLink), or, under kFsFollowSymlinkRelative for a
+// link below the root of the walked file system, the target as written looked up from that
+// root (followSymlinkFS, archives.go :525-529: fs.Lstat(fsys, linkPath) on the target of
+// fs.ReadLink; fstest.MapFS refuses a path fs.ValidPath refuses, so "../x" and "/nowhere/x"
+// are not found, "." is the root). The result is a tree path, "." for the root of the walked
+// file system (the tree's, or the subtree's at prefix), or "".
+func (g *gather) resolveFS(prefix, linkPath, target string) string {
+	rel := strings.TrimPrefix(linkPath, prefix)
+	if g.k[kFsFollowSymlinkRelative] && strings.Contains(rel, "/") {
+		if !fs.ValidPath(target) {
+			return ""
+		}
+		if target == "." {
+			return "."
+		}
+		return prefix + target
+	}
+	r := resolveLink(rel, target)
+	if r == "" || r == "." {
+		return r
+	}
+	return prefix + r
+}
+
+// follow is followSymlink / followSymlinkFS (archives.go :476-511, :517-550): the chain of
+// links from linkPath to a file or directory, with the loop and depth checks; it returns the
+// tree path of the target ("." for the root) and its entry (nil for the root), or sets the
+// error kind.
+func (g *gather) follow(prefix, linkPath string) (string, *fileEntry, bool) {
+	visited := map[string]bool{linkPath: true}
+	cur := linkPath
+	for {
+		e := entryAt(g.c.Tree, cur)
+		var next string
+		if g.side == "disk" {
+			next = resolveLink(cur, e.Link)
+		} else {
+			next = g.resolveFS(prefix, cur, e.Link)
+		}
+		if next == "" {
+			g.err = "dangling"
+			return "", nil, false
+		}
+		if next == "." {
+			return next, nil, true // the root of the walked file system
+		}
+		te := entryAt(g.c.Tree, next)
+		if te == nil {
+			g.err = "dangling"
+			return "", nil, false
+		}
+		if te.Kind != 'l' {
+			return next, te, true
+		}
+		if visited[next] {
+			g.err = "loop"
+			return "", nil, false
+		}
+		if len(visited) >= 40 {
+			g.err = "depth"
+			return "", nil, false
+		}
+		visited[next] = true
+		cur = next
+	}
+}
+
+// walk is one call of FilesFromDisk/FilesFromFS with the one map entry {key: value}: prefix
+// is the root of the walked file system as a tree path prefix ("" for the whole tree, "d/"
+// for fs.Sub(fsys, "d")), key the walked root relative to it ("." for the root itself, with
+// a trailing slash for contents only), value the name in the archive. depth counts the
+// nested calls a followed directory link makes.
+func (g *gather) walk(prefix, key, value string, depth int) {
+	if g.err != "" || g.loop {
+		return
+	}
+	if depth > len(g.c.Tree)+1 {
+		g.loop = true
+		return
+	}
+	trailing := strings.HasSuffix(key, "/")
+	bare := strings.TrimSuffix(key, "/")
+	if g.side == "fs" && trailing && g.k[kFsTrailingSlashKey] {
+		g.err = "open" // archives/15: fs.WalkDir's fs.Stat of "dir/" fails
+		return
+	}
+	root := bare
+	if prefix != "" {
+		if bare == "." {
+			root = strings.TrimSuffix(prefix, "/")
+		} else {
+			root = prefix + bare
+		}
+	}
+	// the walked entries in fs.WalkDir's order: the root, then everything below it
+	var paths []string
+	if root == "." || root == "" {
+		paths = append(paths, ".")
+		for _, e := range g.c.Tree {
+			paths = append(paths, e.Path)
+		}
+	} else {
+		re := entryAt(g.c.Tree, root)
+		if re == nil {
+			g.err = "open"
+			return
+		}
+		paths = append(paths, root)
+		if re.Kind == 'd' {
+			for _, e := range g.c.Tree {
+				if strings.HasPrefix(e.Path, root+"/") {
+					paths = append(paths, e.Path)
+				}
+			}
+		}
+	}
+	sort.Slice(paths, func(i, j int) bool { return walkKey(paths[i]) < walkKey(paths[j]) })
+	rootOnDisk := g.onDisk(prefix, root)
+	if trailing {
+		rootOnDisk += "/"
+	}
+	for _, p := range paths {
+		isRoot := p == root || (p == "." && (root == "." || root == ""))
+		nameOnDisk := g.onDisk(prefix, p)
+		if isRoot && trailing {
+			nameOnDisk = rootOnDisk // the walk reports its root as given, slash and all
+		}
+		name := nameInArchive(nameOnDisk, rootOnDisk, value, g.k)
+		var e *fileEntry
+		if p != "." {
+			e = entryAt(g.c.Tree, p)
+		}
+		isDir := e == nil || e.Kind == 'd'
+		if isDir && isRoot {
+			// archives.go :98: the root folder is skipped when its name is empty; the
+			// documentation skips it for every key with a trailing separator
+			if name == "" || (trailing && !g.k[kFsTrailingKeyValue]) {
+				continue
+			}
+		}
+		if e == nil {
+			g.out = append(g.out, found{Name: name, Kind: 'd', Root: true})
+			continue
+		}
+		if e.Kind == 'l' && g.c.Follow {
+			target, te, ok := g.follow(prefix, p)
+			if !ok {
+				return
+			}
+			if te != nil && te.Kind == 'f' {
+				g.out = append(g.out, found{Name: name, Kind: 'f', Data: te.Data, Mode: te.Mode, Mtime: te.Mtime})
+				continue
+			}
+			// a directory: FilesFromDisk(ctx, options, {target: name}) at :123, the
+			// directory and its contents under the link's name, its links followed in turn
+			if g.side == "disk" {
+				g.walk("", target, name, depth+1)
+				if g.err != "" {
+					g.err = "symlink directory"
+				}
+				continue
+			}
+			inner := strings.TrimPrefix(target, prefix) // the target relative to the walked fs
+			if target == "." {
+				inner = "."
+			}
+			if !g.k[kFsFollowDirLink] || inner == "." {
+				// the documented walk of the directory under the link's name (and the
+				// library's own when the target is the root: fs.Sub(fsys, ".") is fsys)
+				g.walk(prefix, inner, name, depth+1)
+				if g.err != "" {
+					g.err = "symlink directory"
+				}
+				continue
+			}
+			// archives/18, :226-233: fs.Sub(fsys, target), then the walk of target inside
+			// it, which is target/target of the tree
+			sub := target + "/"
+			if ie := entryAt(g.c.Tree, sub+inner); ie == nil {
+				g.err = "symlink directory"
+				return
+			} else if ie.Kind == 'l' {
+				hzTally("fs walk rooted at a link (outside the model)")
+				g.loop = true // outside the model: judged in a child, "returns" open
+				return
+			}
+			g.walk(sub, inner, name, depth+1)
+			if g.err != "" {
+				g.err = "symlink directory"
+			}
+			continue
+		}
+		switch e.Kind {
+		case 'd':
+			g.out = append(g.out, found{Name: name, Kind: 'd', Mode: e.Mode, Mtime: e.Mtime})
+		case 'f':
+			g.out = append(g.out, found{Name: name, Kind: 'f', Data: e.Data, Mode: e.Mode, Mtime: e.Mtime})
+		case 'l':
+			g.out = append(g.out, found{Name: name, Kind: 'l', Link: e.Link})
+		}
+	}
+}
+
+// sideExpected is the checks of one side: "returns", "error", and when the side returns
+// without an error, "names" and one "entry" per name; a looping expansion leaves the error,
+// the names and the entries open and, under kFollowAncestorLinkHang, the call hangs.
+func sideExpected(c filesCase, k known, side, rootBase string, out checks) {
+	g := &gather{c: c, k: k, side: side, rootBase: rootBase}
+	g.walk("", c.Key, c.Value, 0)
+	if g.loop {
+		if k[kFollowAncestorLinkHang] {
+			out.set(side+" returns", "hang")
+		} else {
+			out.set(side+" returns", "returned")
+		}
+		out.unspecified(side + " error")
+		out.unspecified(side + " names")
+		return
+	}
+	out.set(side+" returns", "returned")
+	if g.err != "" {
+		out.set(side+" error", g.err)
+		return
+	}
+	out.set(side+" error", "none")
+	var names []string
+	for _, f := range g.out {
+		names = append(names, f.Name)
+		if f.Root {
+			out.unspecified(side + " entry " + f.Name)
+		} else {
+			out.set(side+" entry "+f.Name, entryValue(f, c.Clear))
+		}
+	}
+	sort.Strings(names)
+	out.set(side+" names", strings.Join(names, "\n"))
+}
+
+// filesExpected states every value the property checks, for the fs side then the disk side
+// (rootBase is the base name of the directory the tree is written to on disk, which the
+// disk side's names of a root key are built on: the property supplies it).
+func filesExpected(c filesCase, k known, rootBase string) checks {
+	out := checks{}
+	sideExpected(c, k, "fs", rootBase, out)
+	sideExpected(c, k, "disk", rootBase, out)
+	return out
+}
+
+// filesModel is filesExpected for the trees written under a directory named rootBase.
+func filesModel(rootBase string) func(filesCase, known) checks {
+	return func(c filesCase, k known) checks { return filesExpected(c, k, rootBase) }
+}
+
+// filesExpectedAt is filesExpected with treeRoot, the base every tree is written under.
+func filesExpectedAt(c filesCase, k known) checks { return filesExpected(c, k, treeRoot) }
+
+// loopsOn reports whether the side's call never returns by the replica (the "returns" check
+// under every switch, the library as recorded, or under the hang switch alone, the
+// documented expansion without end): such a side is called in a child process.
+func loopsOn(c filesCase, side string) bool {
+	hang := hzValue("hang")
+	return filesExpectedAt(c, hzKnownAll)[side+" returns"] == hang ||
+		filesExpectedAt(c, hzKnownOnly(kFollowAncestorLinkHang))[side+" returns"] == hang
+}
+
+// inProcessWait is the context deadline of a call made in process: a call the replica did
+// not see looping is stopped by the library's own ctx.Err() checks (archives.go :84, :199)
+// and fails the case as "hang (stopped in process)" rather than exhausting the memory.
+const inProcessWait = time.Second
+
+func init() {
+	for i, name := range []string{"fs returns", "fs error", "fs names", "fs entry", "disk returns", "disk error", "disk names", "disk entry"} {
+		checkRank[name] = i
+	}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// sideActual asks one side the questions sideExpected answered: the tree is written at dir
+// on disk and as mfs; ctx is the call's (the in-process deadline, or none in the child).
+func sideActual(ctx context.Context, c filesCase, side, dir string, mfs fstest.MapFS) checks {
+	out := checks{}
+	var files []archives.FileInfo
+	var err error
+	if side == "fs" {
+		files, err = archives.FilesFromFS(ctx, mfs, &archives.FromFSOptions{FollowSymlinks: c.Follow, ClearAttributes: c.Clear}, map[string]string{c.Key: c.Value})
+	} else {
+		key := dir
+		if bare := strings.TrimSuffix(c.Key, "/"); bare != "." {
+			key = filepath.Join(dir, filepath.FromSlash(bare))
+		}
+		if strings.HasSuffix(c.Key, "/") {
+			key += string(filepath.Separator)
+		}
+		files, err = archives.FilesFromDisk(ctx, &archives.FromDiskOptions{FollowSymlinks: c.Follow, ClearAttributes: c.Clear}, map[string]string{key: c.Value})
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		out.set(side+" returns", "hang (stopped in process)")
+		return out
+	}
+	out.set(side+" returns", "returned")
+	out.set(side+" error", errKindOf(err))
+	if err != nil {
+		return out
+	}
+	var names []string
+	for _, f := range files {
+		names = append(names, f.NameInArchive)
+		out.set(side+" entry "+f.NameInArchive, fileInfoValue(f, c.Clear))
+	}
+	sort.Strings(names)
+	out.set(side+" names", strings.Join(names, "\n"))
+	return out
+}
+
+// fileInfoValue spells a gathered FileInfo as entryValue spells the model's.
+func fileInfoValue(f archives.FileInfo, clear bool) string {
+	mt := "mtime=" + strconv.FormatInt(f.ModTime().Unix(), 10)
+	if clear {
+		if f.ModTime().IsZero() && f.Sys() == nil {
+			mt = "cleared"
+		} else {
+			mt = fmt.Sprintf("not cleared: mtime=%d sys=%v", f.ModTime().Unix(), f.Sys() != nil)
+		}
+	}
+	switch {
+	case f.Mode()&fs.ModeSymlink != 0:
+		return "link -> " + f.LinkTarget
+	case f.IsDir():
+		return "dir mode=" + strconv.FormatInt(int64(f.Mode().Perm()), 8) + " " + mt
+	}
+	r, err := f.Open()
+	if err != nil {
+		return "file open error: " + err.Error()
+	}
+	b, rerr := io.ReadAll(r)
+	r.Close()
+	if rerr != nil {
+		return "file read error: " + rerr.Error()
+	}
+	sum := sha256.Sum256(b)
+	return fmt.Sprintf("file size=%d read=%d sha=%s mode=%o %s", f.Size(), len(b), hex.EncodeToString(sum[:4]), f.Mode().Perm(), mt)
+}
+
+// --------------------------------------------------------------------------- the child process
+
+// childRequest is what the child process reads from its stdin: the case and the side.
+type childRequest struct {
+	Case filesCase
+	Side string
+}
+
+// childWait is how long the parent waits for a child: a looping call overflows the child's
+// capped stack in well under a second (filesChild caps it at 1 MB), the deadline is the
+// backstop.
+const childWait = 4 * time.Second
+
+// sideInChild asks one side in a child process: the test binary re-executed on this test
+// alone with HZ_ARCHIVES_CHILD=files and the request as JSON on its stdin; the child writes
+// the tree to a directory of its own, calls the library and prints "RETURNED <json of the
+// checks>". A child that prints nothing within childWait (killed by the deadline, or dead of
+// its stack) is the value "hang".
+func sideInChild(c filesCase, side string) checks {
+	req, err := json.Marshal(childRequest{Case: c, Side: side})
+	if err != nil {
+		panic(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), childWait)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run", "^TestHegelFilesFrom$", "-test.timeout", "8s", "-test.count=1")
+	cmd.Env = append(os.Environ(), "HZ_ARCHIVES_CHILD=files")
+	cmd.Stdin = bytes.NewReader(req)
+	start := time.Now()
+	out, _ := cmd.CombinedOutput()
+	hzTally("child " + side)
+	hzTally(fmt.Sprintf("child ms %d", time.Since(start).Milliseconds()/100*100))
+	for _, line := range strings.Split(string(out), "\n") {
+		if rest, ok := strings.CutPrefix(line, "RETURNED "); ok {
+			got := checks{}
+			if err := json.Unmarshal([]byte(rest), &got); err != nil {
+				panic(fmt.Sprintf("child output: %v: %s", err, rest))
+			}
+			return got
+		}
+	}
+	return checks{side + " returns": hzValue("hang")}
+}
+
+// filesChild is the child's half.
+func filesChild() {
+	debug.SetMaxStack(1 << 20) // the recursion without end dies of its stack within milliseconds
+	var req childRequest
+	if err := json.NewDecoder(os.Stdin).Decode(&req); err != nil {
+		fmt.Printf("RETURNED %s\n", `{"child": "bad request"}`)
+		return
+	}
+	tmp, err := os.MkdirTemp("", "hz-archives-child-")
+	if err != nil {
+		panic(err)
+	}
+	defer func() { restoreDisk(tmp); os.RemoveAll(tmp) }()
+	dir := filepath.Join(tmp, treeRoot)
+	if err := os.Mkdir(dir, 0o700); err != nil {
+		panic(err)
+	}
+	if err := treeToDisk(req.Case.Tree, dir); err != nil {
+		panic(err)
+	}
+	got := sideActual(context.Background(), req.Case, req.Side, dir, treeMapFS(req.Case.Tree))
+	text, err := json.Marshal(got)
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("RETURNED %s\n", text)
+}
+
+// --------------------------------------------------------------------------- the property
+
+// filesActual asks both sides: in process, or, for a side whose call never returns by the
+// replica, in a child process. The tree is written under dir (base treeRoot).
+func filesActual(c filesCase, dir string) checks {
+	got := checks{}
+	mfs := treeMapFS(c.Tree)
+	for _, side := range []string{"fs", "disk"} {
+		var part checks
+		if loopsOn(c, side) {
+			hzTally("loop case side " + side)
+			part = sideInChild(c, side)
+		} else {
+			ctx, cancel := context.WithTimeout(context.Background(), inProcessWait)
+			part = sideActual(ctx, c, side, dir, mfs)
+			cancel()
+		}
+		for k, v := range part {
+			got[k] = v
+		}
+	}
+	return got
+}
+
+// filesJudge is the judge of the family: the tree written under a fresh directory of root
+// (named treeRoot), then judgeBy over filesExpectedAt and filesActual; drops lists the
+// switches whose checks are dropped under HEGEL_NO_KNOWN=1 (judgeByDropping) - nil for
+// judgeBy. The narrow properties share it, with their own model where an earlier bug would
+// be named first (pastSwitches).
+func filesJudgeWith(root string, expected func(filesCase, known) checks, drops []int) func(j *hzCaseJudge, c filesCase) {
+	n := 0
+	return func(j *hzCaseJudge, c filesCase) {
+		n++
+		dir := filepath.Join(root, "c"+strconv.Itoa(n), treeRoot)
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			panic(err)
+		}
+		defer func() { restoreDisk(filepath.Dir(dir)); os.RemoveAll(filepath.Dir(dir)) }()
+		if err := treeToDisk(c.Tree, dir); err != nil {
+			panic(fmt.Sprintf("writing the tree: %v", err))
+		}
+		actual := func(c *filesCase) checks { return filesActual(*c, dir) }
+		if drops == nil {
+			judgeBy(j, &c, expected, actual)
+		} else {
+			judgeByDropping(j, &c, expected, actual, drops)
+		}
+	}
+}
+
+// filesRoot is a temporary root for the trees of one property.
+func filesRoot(t *testing.T) string {
+	t.Helper()
+	root, err := os.MkdirTemp("", "hz-archives-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { restoreDisk(root); os.RemoveAll(root) })
+	return root
+}
+
+// filesDrops are the switches whose checks the wide property drops under HEGEL_NO_KNOWN=1
+// rather than skipping the case: archives/15 covers the fs side of every key with a trailing
+// slash, and the disk side of such a key with the value "" is the documented case that must
+// stay.
+var filesDrops = []int{kFsTrailingSlashKey}
+
+// wideFilesCases is the cases of the wide property: under HEGEL_NO_KNOWN=1 the cases that
+// have a shape past the dropped checks (the value "." with a key without a trailing slash,
+// archives/14; a trailing key with a non-empty value, 16; a relative link in a subdirectory
+// or a link to a directory followed on the fs side, 17 and 18; an expansion without end,
+// 27) are filtered out by the classifier (withoutShapes, counted "filtered archives/N"); the
+// fs side's checks of a trailing key are dropped (filesDrops).
+var wideFilesCases = withoutShapes(pastSwitches(filesExpectedAt, filesDrops), filesCases)
+
+// TestHegelFilesFrom: FilesFromFS on the tree as a fstest.MapFS and FilesFromDisk on the same
+// tree written to disk gather the entries the documentation describes for the filenames map:
+// the names in the archive, the kinds, the link targets, contents, permissions and times,
+// with and without ClearAttributes; with FollowSymlinks the links to files become the files
+// and the links to directories those directories, and a call whose expansion has no end
+// still returns (such a side is called in a child process).
+func TestHegelFilesFrom(t *testing.T) {
+	if os.Getenv("HZ_ARCHIVES_CHILD") == "files" {
+		filesChild()
+		return
+	}
+	judged(t, wideFilesCases, filesJudgeWith(filesRoot(t), filesExpectedAt, filesDrops))
+}
diff --git a/hegel/hegel_zoo_gen_test.go b/hegel/hegel_zoo_gen_test.go
new file mode 100644
index 0000000..bd326ed
--- /dev/null
+++ b/hegel/hegel_zoo_gen_test.go
@@ -0,0 +1,665 @@
+package hegel
+
+// Generators: a tree of files, directories and symbolic links, written to a fstest.MapFS or
+// to a directory on disk; archives written by hand with archive/tar and archive/zip (the
+// shapes real archives have and FilesFromFS never produces: implicit directories, entries out
+// of order, "./" prefixes, a "." entry); and a read-write-seekable byte buffer for Insert.
+
+import (
+	"archive/tar"
+	"archive/zip"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing/fstest"
+	"time"
+
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- trees
+
+type hzEntry struct {
+	path  string      // slash-separated, clean, relative
+	kind  byte        // 'f' file, 'd' directory, 'l' symbolic link
+	data  []byte      // file content
+	link  string      // link target, as written
+	mode  fs.FileMode // permission bits
+	mtime time.Time
+}
+
+type hzTree struct {
+	entries []hzEntry // parents before children
+	byPath  map[string]int
+}
+
+func (t *hzTree) add(e hzEntry) {
+	if t.byPath == nil {
+		t.byPath = map[string]int{}
+	}
+	t.byPath[e.path] = len(t.entries)
+	t.entries = append(t.entries, e)
+}
+
+func (t *hzTree) get(p string) *hzEntry {
+	if i, ok := t.byPath[p]; ok {
+		return &t.entries[i]
+	}
+	return nil
+}
+
+func (t *hzTree) dirs() []string {
+	var ds []string
+	for _, e := range t.entries {
+		if e.kind == 'd' {
+			ds = append(ds, e.path)
+		}
+	}
+	return ds
+}
+
+var hzNames = []string{
+	"a", "b", "c.txt", "d.zip", "e.tar", "f.tar.gz", "g.tgz", "h i", "j.jpg", "K", "l.bak",
+	"m.tar.txt", "n.gz", "o..p", "q-r", "s_t", "u.PNG", "v.7z", "w.zst", "x", "y.json", "z.tar.zst",
+	"café", "0", "1.2.3", "long-name-with-many-characters-in-it-for-headers.txt",
+}
+
+var hzSizes = []int{0, 1, 7, 100, 511, 512, 513, 1023, 1024, 1025, 1500, 4096}
+
+func hzData(tc hegel.TestCase) []byte {
+	var n int
+	if hzOldChance(tc, 60) {
+		n = hzOldPick(tc, hzSizes)
+	} else {
+		n = hzOldDrawInt(tc, 0, 3000)
+	}
+	switch hzOldDrawInt(tc, 0, 2) {
+	case 0: // compressible text
+		return bytes.Repeat([]byte("the quick brown fox "), n/20+1)[:n]
+	case 1: // one byte
+		return bytes.Repeat([]byte{byte(hzOldDrawInt(tc, 0, 255))}, n)
+	default: // random
+		return hegel.Draw(tc, hegel.Binary(n, n))
+	}
+}
+
+func hzTime(tc hegel.TestCase) time.Time {
+	// 1981..2099, whole seconds: inside every format's range (zip's MS-DOS time starts in 1980)
+	return time.Unix(int64(hzOldDrawInt(tc, 350000000, 4100000000)), 0).UTC()
+}
+
+// hzGenTree draws a tree of up to n entries. Directories are explicit and come before their
+// contents; symbolic links point at a sibling, a parent's child, an absolute path or nothing.
+func hzGenTree(tc hegel.TestCase, n int) *hzTree {
+	t := &hzTree{}
+	count := hzOldDrawInt(tc, 0, n)
+	for i := 0; i < count; i++ {
+		parent := ""
+		if ds := t.dirs(); len(ds) > 0 && hzOldChance(tc, 60) {
+			parent = hzOldPick(tc, ds)
+		}
+		name := hzOldPick(tc, hzNames)
+		p := name
+		if parent != "" {
+			p = parent + "/" + name
+		}
+		if t.get(p) != nil {
+			continue
+		}
+		e := hzEntry{path: p, mtime: hzTime(tc)}
+		switch r := hzOldDrawInt(tc, 1, 100); {
+		case r <= 25:
+			e.kind = 'd'
+			e.mode = fs.FileMode(0o700 | hzOldDrawInt(tc, 0, 0o77))
+		case r <= 85:
+			e.kind = 'f'
+			e.data = hzData(tc)
+			e.mode = fs.FileMode(0o600 | hzOldDrawInt(tc, 0, 0o177))
+		default:
+			e.kind = 'l'
+			e.mode = 0o777
+			switch hzOldDrawInt(tc, 0, 4) {
+			case 0: // a sibling (may not exist yet, or ever)
+				e.link = hzOldPick(tc, hzNames)
+			case 1: // a path from the root, as a relative target
+				if len(t.entries) > 0 {
+					e.link = hzOldPick(tc, t.entries).path
+				} else {
+					e.link = "x"
+				}
+			case 2:
+				e.link = "../" + hzOldPick(tc, hzNames)
+			case 3: // the link's own directory (ln -s . self), in a subdirectory
+				if parent != "" {
+					e.link = "."
+				} else {
+					e.link = hzOldPick(tc, hzNames)
+				}
+			default:
+				e.link = "/nowhere/" + hzOldPick(tc, hzNames)
+			}
+			// no link to a link (a loop would not resolve; fstest.MapFS recurses without end)
+			if r := hzResolve(p, e.link); r != "" {
+				if r == p {
+					e.link = "/nowhere/" + hzOldPick(tc, hzNames)
+				} else if target := t.get(r); target != nil && target.kind == 'l' {
+					e.link = "/nowhere/" + hzOldPick(tc, hzNames)
+				}
+			}
+		}
+		t.add(e)
+	}
+	// a link created before its target may point at a later link: redirect it (a chain of links
+	// leads FollowSymlinks around the ancestor-loop model, and fstest.MapFS around cycles)
+	for i := range t.entries {
+		e := &t.entries[i]
+		if e.kind != 'l' {
+			continue
+		}
+		if r := hzResolve(e.path, e.link); r != "" {
+			if target := t.get(r); target != nil && target.kind == 'l' {
+				e.link = "/nowhere/" + hzOldPick(tc, hzNames)
+			}
+		}
+	}
+	return t
+}
+
+// hzResolve resolves a link target the way a file system does: relative to the link's
+// directory, staying inside the tree. It returns the tree path, or "" when the target leaves
+// the tree or is absolute.
+func hzResolve(linkPath, target string) string {
+	if strings.HasPrefix(target, "/") {
+		return ""
+	}
+	p := path.Join(path.Dir(linkPath), target)
+	if p == ".." || strings.HasPrefix(p, "../") {
+		return ""
+	}
+	return p
+}
+
+type (
+	fstestMapFS   = fstest.MapFS
+	fstestMapFile = fstest.MapFile
+)
+
+// hzMapFS writes the tree to a fstest.MapFS.
+func hzMapFS(t *hzTree) fstestMapFS {
+	m := fstestMapFS{}
+	for _, e := range t.entries {
+		switch e.kind {
+		case 'd':
+			m[e.path] = &fstestMapFile{Mode: fs.ModeDir | e.mode, ModTime: e.mtime}
+		case 'f':
+			m[e.path] = &fstestMapFile{Data: e.data, Mode: e.mode, ModTime: e.mtime}
+		case 'l':
+			m[e.path] = &fstestMapFile{Data: []byte(e.link), Mode: fs.ModeSymlink | e.mode, ModTime: e.mtime}
+		}
+	}
+	return m
+}
+
+// hzWriteDisk writes the tree under dir (which must exist and be empty).
+func hzWriteDisk(t *hzTree, dir string) error {
+	var dirs []hzEntry
+	for _, e := range t.entries {
+		p := filepath.Join(dir, filepath.FromSlash(e.path))
+		switch e.kind {
+		case 'd':
+			if err := os.Mkdir(p, 0o700); err != nil {
+				return err
+			}
+			dirs = append(dirs, e)
+		case 'f':
+			if err := os.WriteFile(p, e.data, e.mode); err != nil {
+				return err
+			}
+			if err := os.Chmod(p, e.mode); err != nil {
+				return err
+			}
+			if err := os.Chtimes(p, e.mtime, e.mtime); err != nil {
+				return err
+			}
+		case 'l':
+			if err := os.Symlink(e.link, p); err != nil {
+				return err
+			}
+		}
+	}
+	// directories last, deepest first: chmod and chtimes after their contents are written
+	for i := len(dirs) - 1; i >= 0; i-- {
+		p := filepath.Join(dir, filepath.FromSlash(dirs[i].path))
+		if err := os.Chtimes(p, dirs[i].mtime, dirs[i].mtime); err != nil {
+			return err
+		}
+		if err := os.Chmod(p, dirs[i].mode); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// hzRestoreDisk makes every directory under dir writable again so it can be removed.
+func hzRestoreDisk(dir string) {
+	filepath.WalkDir(dir, func(p string, d fs.DirEntry, err error) error {
+		if err == nil && d.IsDir() {
+			os.Chmod(p, 0o700)
+		}
+		return nil
+	})
+}
+
+// --------------------------------------------------------------------------- formats
+
+// hzArchival draws a Tar or a Zip with random options.
+func hzArchival(tc hegel.TestCase) archives.Archival {
+	if hzOldChance(tc, 50) {
+		t := archives.Tar{}
+		switch hzOldDrawInt(tc, 0, 3) {
+		case 1:
+			t.Format = tar.FormatUSTAR
+		case 2:
+			t.Format = tar.FormatPAX
+		case 3:
+			t.Format = tar.FormatGNU
+		}
+		if hzOldChance(tc, 20) {
+			t.NumericUIDGID = true
+		}
+		if hzOldChance(tc, 20) {
+			t.Uid = hzOldDrawInt(tc, 1, 70000)
+			t.Gid = hzOldDrawInt(tc, 1, 70000)
+		}
+		if hzOldChance(tc, 20) {
+			t.Uname = hzOldPick(tc, []string{"root", "user", "a name with spaces"})
+			t.Gname = hzOldPick(tc, []string{"root", "staff"})
+		}
+		return t
+	}
+	z := archives.Zip{}
+	switch hzOldDrawInt(tc, 0, 5) {
+	case 0:
+		z.Compression = zip.Store
+	case 1, 2:
+		z.Compression = zip.Deflate
+	case 3:
+		z.Compression = archives.ZipMethodBzip2
+	case 4:
+		z.Compression = archives.ZipMethodZstd
+	case 5:
+		z.Compression = archives.ZipMethodXz
+		if HZKnown.zipXzHeaderOffset {
+			hzAvoid("zipXzHeaderOffset")
+			z.Compression = zip.Deflate
+		}
+	}
+	if hzOldChance(tc, 30) {
+		z.SelectiveCompression = true
+	}
+	return z
+}
+
+// hzCompression draws a compression format with random options.
+func hzCompression(tc hegel.TestCase) archives.Compression {
+	switch hzOldDrawInt(tc, 0, 9) {
+	case 0:
+		return archives.Gz{CompressionLevel: hzOldDrawInt(tc, 0, 9), Multithreaded: hzOldChance(tc, 30)}
+	case 1:
+		return archives.Bz2{CompressionLevel: hzOldDrawInt(tc, 0, 9)}
+	case 2:
+		return archives.Xz{}
+	case 3:
+		return archives.Zstd{}
+	case 4:
+		level := hzOldDrawInt(tc, 0, 9)
+		if level != 0 && HZKnown.lz4CompressionLevel {
+			hzAvoid("lz4CompressionLevel")
+			level = 0
+		}
+		return archives.Lz4{CompressionLevel: level}
+	case 5:
+		return archives.Brotli{Quality: hzOldDrawInt(tc, 0, 11)}
+	case 6:
+		return archives.Sz{}
+	case 7:
+		return archives.Lzip{}
+	case 8:
+		return archives.Zlib{CompressionLevel: hzOldDrawInt(tc, 0, 9)}
+	default:
+		return archives.MinLZ{}
+	}
+}
+
+func hzFormatName(f archives.Format) string {
+	switch v := f.(type) {
+	case archives.Tar:
+		return fmt.Sprintf("Tar{%v}", v.Format)
+	case archives.Zip:
+		return fmt.Sprintf("Zip{method %d, selective %v}", v.Compression, v.SelectiveCompression)
+	case archives.CompressedArchive:
+		return hzFormatName(v.Archival) + "+" + hzFormatName(v.Compression)
+	case archives.Gz:
+		return fmt.Sprintf("Gz{%d, mt %v}", v.CompressionLevel, v.Multithreaded)
+	case archives.Bz2:
+		return fmt.Sprintf("Bz2{%d}", v.CompressionLevel)
+	case archives.Lz4:
+		return fmt.Sprintf("Lz4{%d}", v.CompressionLevel)
+	case archives.Brotli:
+		return fmt.Sprintf("Brotli{%d}", v.Quality)
+	case archives.Zlib:
+		return fmt.Sprintf("Zlib{%d}", v.CompressionLevel)
+	}
+	return fmt.Sprintf("%T", f)
+}
+
+// --------------------------------------------------------------------------- extraction
+
+type hzGot struct {
+	name   string
+	isDir  bool
+	isLink bool
+	mode   fs.FileMode
+	size   int64
+	data   []byte
+	link   string
+	mtime  time.Time
+	header any
+}
+
+// hzExtractAll walks the archive and reads every regular file inside the handler.
+func hzExtractAll(f archives.Extractor, data []byte) ([]hzGot, error) {
+	var got []hzGot
+	err := f.Extract(context.Background(), bytes.NewReader(data), func(ctx context.Context, fi archives.FileInfo) error {
+		g := hzGot{name: fi.NameInArchive, isDir: fi.IsDir(), isLink: fi.Mode()&fs.ModeSymlink != 0,
+			mode: fi.Mode(), size: fi.Size(), link: fi.LinkTarget, mtime: fi.ModTime(), header: fi.Header}
+		if !g.isDir && !g.isLink {
+			r, err := fi.Open()
+			if err != nil {
+				return fmt.Errorf("open %s: %w", fi.NameInArchive, err)
+			}
+			b, err := io.ReadAll(r)
+			r.Close()
+			if err != nil {
+				return fmt.Errorf("read %s: %w", fi.NameInArchive, err)
+			}
+			g.data = b
+		}
+		got = append(got, g)
+		return nil
+	})
+	return got, err
+}
+
+func hzGotNames(gs []hzGot) []string {
+	var ns []string
+	for _, g := range gs {
+		ns = append(ns, g.name)
+	}
+	return ns
+}
+
+// --------------------------------------------------------------------------- a byte buffer
+
+// hzBuffer is an in-memory io.ReadWriteSeeker + io.ReaderAt, like a file.
+type hzBuffer struct {
+	buf []byte
+	pos int64
+}
+
+func (p *hzBuffer) Read(b []byte) (int, error) {
+	if p.pos >= int64(len(p.buf)) {
+		return 0, io.EOF
+	}
+	n := copy(b, p.buf[p.pos:])
+	p.pos += int64(n)
+	return n, nil
+}
+
+func (p *hzBuffer) Write(b []byte) (int, error) {
+	end := p.pos + int64(len(b))
+	if end > int64(len(p.buf)) {
+		p.buf = append(p.buf, make([]byte, end-int64(len(p.buf)))...)
+	}
+	copy(p.buf[p.pos:], b)
+	p.pos = end
+	return len(b), nil
+}
+
+func (p *hzBuffer) Seek(off int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+		p.pos = off
+	case io.SeekCurrent:
+		p.pos += off
+	case io.SeekEnd:
+		p.pos = int64(len(p.buf)) + off
+	}
+	if p.pos < 0 {
+		return 0, fmt.Errorf("negative seek")
+	}
+	return p.pos, nil
+}
+
+func (p *hzBuffer) ReadAt(b []byte, off int64) (int, error) {
+	if off >= int64(len(p.buf)) {
+		return 0, io.EOF
+	}
+	n := copy(b, p.buf[off:])
+	if n < len(b) {
+		return n, io.EOF
+	}
+	return n, nil
+}
+
+// --------------------------------------------------------------------------- foreign archives
+
+// hzRawEntry is an entry of an archive written by hand.
+type hzRawEntry struct {
+	name string // as written into the header ("a/", "./a/b", ".")
+	kind byte   // 'f', 'd', 'l'
+	data []byte
+	link string
+	mode fs.FileMode
+}
+
+// hzRawArchive is a hand-written archive and the model of what a file system over it holds.
+type hzRawArchive struct {
+	entries []hzRawEntry
+	files   map[string][]byte // clean path -> content (links: the target as content for zip; empty for tar)
+	links   map[string]string // clean path -> target
+	dirs    map[string]bool   // clean path -> explicit?
+}
+
+func hzClean(name string) string {
+	c := path.Clean(name)
+	return c
+}
+
+// hzGenRawArchive draws entries with the shapes of real archives and builds the model.
+func hzGenRawArchive(tc hegel.TestCase, zipOK bool) *hzRawArchive {
+	a := &hzRawArchive{files: map[string][]byte{}, links: map[string]string{}, dirs: map[string]bool{}}
+	n := hzOldDrawInt(tc, 0, 8)
+	var paths []string
+	for i := 0; i < n; i++ {
+		depth := hzOldDrawInt(tc, 1, 3)
+		var parts []string
+		for j := 0; j < depth; j++ {
+			parts = append(parts, hzOldPick(tc, hzNames[:12]))
+		}
+		p := strings.Join(parts, "/")
+		if hzOldChance(tc, 15) && len(paths) > 0 {
+			// a child of an earlier path
+			p = hzOldPick(tc, paths) + "/" + hzOldPick(tc, hzNames[:12])
+		}
+		// no path may be both a file and a directory, and no duplicates
+		clash := false
+		for q := range a.files {
+			if q == p || strings.HasPrefix(q, p+"/") || strings.HasPrefix(p, q+"/") {
+				clash = true
+			}
+		}
+		if _, isDir := a.dirs[p]; isDir {
+			clash = true
+		}
+		if clash {
+			continue
+		}
+		e := hzRawEntry{mode: 0o644}
+		switch r := hzOldDrawInt(tc, 1, 100); {
+		case r <= 30:
+			e.kind = 'd'
+			e.mode = 0o755
+			a.dirs[p] = true
+		case r <= 90 || zipOK:
+			e.kind = 'f'
+			e.data = hzData(tc)
+			a.files[p] = e.data
+		default:
+			e.kind = 'l'
+			e.link = hzOldPick(tc, hzNames[:12])
+			e.mode = 0o777
+			a.links[p] = e.link
+			a.files[p] = nil
+		}
+		paths = append(paths, p)
+		// implicit parents
+		for d := path.Dir(p); d != "."; d = path.Dir(d) {
+			if _, ok := a.dirs[d]; !ok {
+				a.dirs[d] = false
+			}
+		}
+		e.name = p
+		if e.kind == 'd' && (zipOK || hzOldChance(tc, 60)) {
+			e.name += "/"
+		}
+		if hzOldChance(tc, 15) {
+			e.name = "./" + e.name
+		}
+		a.entries = append(a.entries, e)
+	}
+	// explicit parents become explicit directory entries when drawn so
+	if hzOldChance(tc, 50) {
+		for d, explicit := range a.dirs {
+			if !explicit && hzOldChance(tc, 50) {
+				a.dirs[d] = true
+				a.entries = append(a.entries, hzRawEntry{name: d + "/", kind: 'd', mode: 0o755})
+			}
+		}
+	}
+	// order: as drawn (parents first mostly), or shuffled
+	if hzOldChance(tc, 50) {
+		for i := len(a.entries) - 1; i > 0; i-- {
+			j := hzOldDrawInt(tc, 0, i)
+			a.entries[i], a.entries[j] = a.entries[j], a.entries[i]
+		}
+	}
+	if !zipOK && hzOldChance(tc, 20) {
+		// a "." directory entry, as tar makes of the current directory
+		a.entries = append([]hzRawEntry{{name: hzOldPick(tc, []string{".", "./"}), kind: 'd', mode: 0o755}}, a.entries...)
+	}
+	return a
+}
+
+// hzModelPaths returns every path of the model (files, links, directories), sorted.
+func (a *hzRawArchive) modelPaths() []string {
+	var ps []string
+	for p := range a.files {
+		ps = append(ps, p)
+	}
+	for d := range a.dirs {
+		ps = append(ps, d)
+	}
+	sort.Strings(ps)
+	return ps
+}
+
+// children lists the model's immediate children of dir (or of the root when dir is ".").
+func (a *hzRawArchive) children(dir string) []string {
+	var cs []string
+	for _, p := range a.modelPaths() {
+		if path.Dir(p) == dir {
+			cs = append(cs, path.Base(p))
+		}
+	}
+	sort.Strings(cs)
+	return cs
+}
+
+func (a *hzRawArchive) writeTar(format tar.Format) []byte {
+	var buf bytes.Buffer
+	tw := tar.NewWriter(&buf)
+	for _, e := range a.entries {
+		h := &tar.Header{Name: e.name, Mode: int64(e.mode), Format: format, ModTime: time.Unix(1000000000, 0)}
+		switch e.kind {
+		case 'd':
+			h.Typeflag = tar.TypeDir
+		case 'f':
+			h.Typeflag = tar.TypeReg
+			h.Size = int64(len(e.data))
+		case 'l':
+			h.Typeflag = tar.TypeSymlink
+			h.Linkname = e.link
+		}
+		if err := tw.WriteHeader(h); err != nil {
+			panic(err)
+		}
+		if e.kind == 'f' {
+			tw.Write(e.data)
+		}
+	}
+	tw.Close()
+	return buf.Bytes()
+}
+
+func (a *hzRawArchive) writeZip() []byte {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range a.entries {
+		h := &zip.FileHeader{Name: e.name, Method: zip.Deflate, Modified: time.Unix(1000000000, 0)}
+		switch e.kind {
+		case 'd':
+			h.SetMode(fs.ModeDir | e.mode)
+			h.Method = zip.Store
+		case 'f':
+			h.SetMode(e.mode)
+		case 'l':
+			h.SetMode(fs.ModeSymlink | e.mode)
+		}
+		w, err := zw.CreateHeader(h)
+		if err != nil {
+			panic(err)
+		}
+		switch e.kind {
+		case 'f':
+			w.Write(e.data)
+		case 'l':
+			w.Write([]byte(e.link))
+		}
+	}
+	zw.Close()
+	return buf.Bytes()
+}
+
+func (a *hzRawArchive) String() string {
+	var b strings.Builder
+	for _, e := range a.entries {
+		fmt.Fprintf(&b, "%c %q", e.kind, e.name)
+		if e.kind == 'f' {
+			fmt.Fprintf(&b, " (%d bytes)", len(e.data))
+		}
+		if e.kind == 'l' {
+			fmt.Fprintf(&b, " -> %q", e.link)
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
