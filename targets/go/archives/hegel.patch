+package hegel
+
+// The ArchiveFS property: the raw-archive record (an archive written by hand with archive/tar
+// or archive/zip: implicit directories, entries out of order, "./" prefixes, a "." entry,
+// directory names with and without a trailing slash), its pure builder and writers, the model
+// of the file system ArchiveFS presents over it before and after its index is built, with
+// the replicas of the recorded bugs threaded on the switch set (archiveFSExpected), a
+// transcription of testing/fstest's TestFS over that model, and the wide property.
+//
+// The model: ArchiveFS's doc comment (fs.go :280-327) says it presents the archive as a
+// file system "that can be used to open and read the files" through fs.FS, fs.ReadDirFS,
+// fs.StatFS and fs.SubFS; the paths it holds are the entries' names cleaned of "./" and of
+// a trailing slash (fs.go :439, :565, :634) and every directory above them, which exist
+// whether or not the archive has an entry for them (an implicit directory: a FileInfo of
+// the directory's base name, mode ModeDir, size 0, zero time, fs.go :1137-1157). Open of a
+// path is the file or the directory of that name: a file reads its content, a directory is
+// a fs.ReadDirFile whose Stat is the directory's info and whose ReadDir lists its children
+// (the entries of its own name, by base name, and nothing deeper) in directory order, with
+// ReadDir(n > 0) paging and ReadDir(n <= 0) returning the children not yet read; the same
+// before and after the index (which ReadDir on the pointer builds, fs.go :598-722). Stat of
+// a path is that info, Stat of a missing name is fs.ErrNotExist (and so is Open), ReadDir
+// of a directory lists its children sorted, fs.WalkDir visits every path once with its
+// kind, Sub roots a subtree, and fstest.TestFS accepts the file system. The checks: "walk"
+// (the paths with their kinds), per path "stat fresh" and "stat indexed" (the info), per
+// missing name the same and "open fresh"/"open indexed" ("not exist"), per file "read
+// fresh"/"read indexed" (the content's hash), per directory "open fresh"/"open indexed" (the
+// info and the sorted children), "readdir" (fs.ReadDir on the pointer), "rest fresh"/"rest
+// indexed" (ReadDir(1) then ReadDir(-1), or ReadDir(1) to the end), "sub" (the walk of
+// Sub of the drawn directory), "testfs" (the classes of the lines of TestFS's report, "none").
+
+import (
+	"archive/tar"
+	"archive/zip"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"path"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"testing/fstest"
+	"time"
+
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the records
+
+// rawEntry is one entry of an archive written by hand: the name as written into the header
+// ("a/", "./a/b", "."), the kind, the content of a file, the target of a link, the
+// permission bits. Every entry is written with the time rawTime.
+type rawEntry struct {
+	Name string
+	Kind byte
+	Data []byte
+	Link string
+	Mode fs.FileMode
+}
+
+func (e rawEntry) clean() string { return path.Clean(e.Name) }
+
+var rawTime = time.Unix(1000000000, 0)
+
+// archiveFSCase is one case: the entries in archive order, the container (a zip, or a tar of
+// TarFormat 1..3: USTAR, PAX, GNU), the directory Sub is tried on ("" for none), whether the
+// missing names that are string prefixes of a base name are probed (Prefixes), and whether
+// the directory files are read as ReadDir(1) then ReadDir(-1) (Rest) or paged to the end.
+type archiveFSCase struct {
+	Entries   []rawEntry
+	Zip       bool
+	TarFormat int
+	SubDir    string
+	Prefixes  bool
+	Rest      bool
+}
+
+func (c archiveFSCase) GoString() string {
+	container := "zip"
+	if !c.Zip {
+		container = "tar " + []string{"", "USTAR", "PAX", "GNU"}[c.TarFormat]
+	}
+	s := fmt.Sprintf("archiveFSCase{%s, sub %q, prefixes %v, rest %v}\n", container, c.SubDir, c.Prefixes, c.Rest)
+	if len(c.Entries) == 0 {
+		return s + "  (no entries)\n"
+	}
+	for _, e := range c.Entries {
+		s += fmt.Sprintf("  %c %q", e.Kind, e.Name)
+		if e.Kind == 'f' {
+			s += fmt.Sprintf(" (%d bytes)", len(e.Data))
+		}
+		if e.Kind == 'l' {
+			s += fmt.Sprintf(" -> %q", e.Link)
+		}
+		s += "\n"
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- the generators
+
+// rawNames is the name pool of the raw archives (the old hzNames[:12]).
+var rawNames = treeNames[:12]
+
+// rawSpec is one entry as drawn, before the clash rule places it: a path of one to three
+// names, or (Child) a child of an earlier path (the one at ChildAt modulo their number), the
+// kind, the content or the link target, and the spelling of the name (a trailing slash on a
+// directory, a "./" prefix).
+type rawSpec struct {
+	Parts    []string
+	Child    bool
+	ChildAt  int
+	Kind     byte
+	Data     []byte
+	Link     string
+	Slash    bool
+	DotSlash bool
+}
+
+// rawSpecs: the depth 1..3 evenly, a child of an earlier path at 15, a directory 30, a file
+// 60, a link 10 for a tar (a zip holds no link: 30/70), the content of fileData, a
+// directory's trailing slash at 60 (always in a zip), the "./" prefix at dotSlashW (15 in
+// the wide property). Measured over the entries of 3000 cases, parents and all (the probe
+// sees the placed case, not the spec): depth 1/2/3 at 41/35/24 and 4+ at 1 (the children of
+// deep paths), kinds d/f/l at 52/45/3 (the explicit parents are directories), "./" on 11,
+// a tar directory's slash on 82 (the parents always carry one). A flat population (depth 1,
+// no child) is the region past archives/7, whose index names the root after the first
+// nested entry.
+func rawSpecs(zip bool, dotSlashW int, flat bool) hegel.Generator[rawSpec] {
+	kinds := halvesOver([]int{30, 60, 10}, byte('d'), byte('f'), byte('l'))
+	if zip {
+		kinds = halvesOver([]int{30, 70}, byte('d'), byte('f'))
+	}
+	slash := hegel.Just(true)
+	if !zip {
+		slash = dieCoin(60)
+	}
+	depth, childW := 3, 15
+	if flat {
+		depth, childW = 1, 0
+	}
+	return hegel.FlatMap(countedHalves(evenHalves(rawNames...), 1, depth), func(parts []string) hegel.Generator[rawSpec] {
+		return hegel.FlatMap(dieCoin(childW), func(child bool) hegel.Generator[rawSpec] {
+			at := hegel.Just(0)
+			if child {
+				at = rangeHalves(0, 7)
+			}
+			return hegel.FlatMap(at, func(childAt int) hegel.Generator[rawSpec] {
+				return hegel.FlatMap(kinds, func(kind byte) hegel.Generator[rawSpec] {
+					data := hegel.Just([]byte(nil))
+					if kind == 'f' {
+						data = fileData
+					}
+					link := hegel.Just("")
+					if kind == 'l' {
+						link = evenHalves(rawNames...)
+					}
+					return hegel.FlatMap(data, func(d []byte) hegel.Generator[rawSpec] {
+						return hegel.FlatMap(link, func(l string) hegel.Generator[rawSpec] {
+							return hegel.FlatMap(slash, func(sl bool) hegel.Generator[rawSpec] {
+								return hegel.Map(dieCoin(dotSlashW), func(ds bool) rawSpec {
+									return rawSpec{Parts: parts, Child: child, ChildAt: childAt, Kind: kind, Data: d, Link: l, Slash: sl && kind == 'd', DotSlash: ds}
+								})
+							})
+						})
+					})
+				})
+			})
+		})
+	})
+}
+
+// placed is the entries placed by the clash rule and the implicit parents they leave, sorted.
+type placed struct {
+	Entries  []rawEntry
+	Implicit []string
+}
+
+// placeSpecs places the injected entries (the shape of a narrow property) then the drawn
+// specs: a path already a file, a directory, or above or below a file is dropped (no path is
+// both a file and a directory; no duplicates); the parents without an entry of their own
+// are the implicit directories.
+func placeSpecs(inject []rawEntry, specs []rawSpec, zip bool) placed {
+	files := map[string]bool{}
+	dirs := map[string]bool{}
+	var paths []string
+	var out []rawEntry
+	place := func(e rawEntry) {
+		p := e.clean()
+		for q := range files {
+			if q == p || strings.HasPrefix(q, p+"/") || strings.HasPrefix(p, q+"/") {
+				return
+			}
+		}
+		if dirs[p] {
+			return
+		}
+		if e.Kind != 'd' {
+			for q := range dirs {
+				if strings.HasPrefix(q, p+"/") {
+					return
+				}
+			}
+		}
+		if e.Kind == 'd' {
+			dirs[p] = true
+		} else {
+			files[p] = true
+		}
+		paths = append(paths, p)
+		out = append(out, e)
+	}
+	for _, e := range inject {
+		place(e)
+	}
+	for _, s := range specs {
+		p := strings.Join(s.Parts, "/")
+		if s.Child && len(paths) > 0 {
+			p = paths[s.ChildAt%len(paths)] + "/" + s.Parts[0]
+		}
+		e := rawEntry{Name: p, Kind: s.Kind, Data: s.Data, Link: s.Link, Mode: 0o644}
+		switch s.Kind {
+		case 'd':
+			e.Mode = 0o755
+			if s.Slash || zip {
+				e.Name += "/"
+			}
+		case 'l':
+			e.Mode = 0o777
+		}
+		if s.DotSlash {
+			e.Name = "./" + e.Name
+		}
+		place(e)
+	}
+	implicit := map[string]bool{}
+	for _, p := range paths {
+		for d := path.Dir(p); d != "."; d = path.Dir(d) {
+			if !dirs[d] {
+				implicit[d] = true
+			}
+		}
+	}
+	var imp []string
+	for d := range implicit {
+		imp = append(imp, d)
+	}
+	sort.Strings(imp)
+	return placed{Entries: out, Implicit: imp}
+}
+
+// rawParams shapes the population: the container, whether every implicit parent gets an
+// entry (ExplicitAll) and the entries are ordered parents first (InOrder) - the regions past
+// the shapes of archives/4, 5 and 7 -, whether the drawn entries stay at the root (Flat: the
+// region past 7's naming of the root), the weight of the "./" prefix, the probes, and the
+// entries injected first (a narrow property's shape).
+type rawParams struct {
+	Zip          hegel.Generator[bool]
+	ExplicitAll  bool
+	ExplicitNone bool
+	InOrder      bool
+	Flat         bool
+	DotSlashW    int
+	Prefixes     hegel.Generator[bool]
+	Rest         hegel.Generator[bool]
+	Inject       []rawEntry
+}
+
+// wideRawParams is the wide property's population: a zip at 40 (realised 40 and 40 at 3000
+// cases, seeds 7 and 8), the explicit parents drawn (none, all, or each at 50: 40/30/30),
+// the order drawn (as placed, parents first, or shuffled: 35/30/35), "./" at 15, the prefix
+// probes at 40 (realised 39 and 42; never under HEGEL_NO_KNOWN=1: the probes are the shape
+// of archives/6) and ReadDir(1) then ReadDir(-1) at 50 (realised 52 and 49; paging only
+// under HEGEL_NO_KNOWN=1: the shape of archives/8).
+var wideRawParams = rawParams{
+	Zip:       dieCoin(40),
+	DotSlashW: 15,
+	Prefixes:  dieCoin(hzUnless(hzNoKnown, 40)),
+	Rest:      dieCoin(hzUnless(hzNoKnown, 50)),
+}
+
+// rawCasesWith is the cases of a population: 0..8 specs (the cases realise 0 to 19 entries
+// with the parents, 8 percent empty, 9 to 12 each from one to five, thinning past), the
+// explicit parents (none at 40, all at 30, each at 50 at 30 - all when ExplicitAll, none
+// when ExplicitNone; of the cases with a parent, realised all implicit 34 and 38, all
+// explicit 36 and 35, mixed 30 and 27 at seeds 7 and 8), the order (as placed - the parents
+// added last - at 35, parents first at 30, a stable sort by a key drawn per entry - the
+// shuffle as a drawn permutation - at 35; parents first when InOrder; realised: every
+// explicit parent before its contents in 41 and 39 of the cases with one), a "." or "./"
+// entry first at 10 each for a tar (realised 9/9 and 12/8 of the tars), the container's
+// format (a tar's 1..3 evenly, realised 33/35/31 and 31/31/38), the directory for Sub (one of
+// the sorted directories by a drawn index; 85 of the cases have one), the probes.
+func rawCasesWith(p rawParams) hegel.Generator[archiveFSCase] {
+	return hegel.FlatMap(p.Zip, func(zip bool) hegel.Generator[archiveFSCase] {
+		format := hegel.Just(0)
+		if !zip {
+			format = halvesOver([]int{1, 1, 1}, 1, 2, 3)
+		}
+		return hegel.FlatMap(format, func(tf int) hegel.Generator[archiveFSCase] {
+			return hegel.FlatMap(countedHalves(rawSpecs(zip, p.DotSlashW, p.Flat), 0, 8), func(specs []rawSpec) hegel.Generator[archiveFSCase] {
+				pl := placeSpecs(p.Inject, specs, zip)
+				explicit := hegel.Just(repeatBool(len(pl.Implicit), p.ExplicitAll))
+				if !p.ExplicitAll && !p.ExplicitNone {
+					explicit = hegel.FlatMap(halvesOver([]int{40, 30, 30}, 0, 1, 2), func(mode int) hegel.Generator[[]bool] {
+						switch mode {
+						case 0:
+							return hegel.Just(repeatBool(len(pl.Implicit), false))
+						case 1:
+							return hegel.Just(repeatBool(len(pl.Implicit), true))
+						}
+						return hzTuple(repeatGen(len(pl.Implicit), dieCoin(50))...)
+					})
+				}
+				return hegel.FlatMap(explicit, func(coins []bool) hegel.Generator[archiveFSCase] {
+					entries := withExplicitParents(pl, coins, zip)
+					order := hegel.Just(1)
+					if !p.InOrder {
+						order = halvesOver([]int{35, 30, 35}, 0, 1, 2)
+					}
+					return hegel.FlatMap(order, func(mode int) hegel.Generator[archiveFSCase] {
+						keys := hegel.Just([]int(nil))
+						if mode == 2 {
+							keys = hzTuple(repeatGen(len(entries), hegel.Integers(0, 1<<20))...)
+						}
+						return hegel.FlatMap(keys, func(keys []int) hegel.Generator[archiveFSCase] {
+							entries := orderEntries(entries, keys, mode == 1)
+							dot := hegel.Just(0)
+							if !zip {
+								dot = halvesOver([]int{80, 10, 10}, 0, 1, 2)
+							}
+							return hegel.FlatMap(dot, func(dot int) hegel.Generator[archiveFSCase] {
+								entries := withDotEntry(entries, dot)
+								return hegel.FlatMap(rangeHalves(0, 7), func(subAt int) hegel.Generator[archiveFSCase] {
+									return hegel.FlatMap(p.Prefixes, func(prefixes bool) hegel.Generator[archiveFSCase] {
+										return hegel.Map(p.Rest, func(rest bool) archiveFSCase {
+											return buildArchiveFSCase(entries, zip, tf, subAt, prefixes, rest)
+										})
+									})
+								})
+							})
+						})
+					})
+				})
+			})
+		})
+	})
+}
+
+func repeatBool(n int, v bool) []bool {
+	out := make([]bool, n)
+	for i := range out {
+		out[i] = v
+	}
+	return out
+}
+
+func repeatGen[T any](n int, g hegel.Generator[T]) []hegel.Generator[T] {
+	out := make([]hegel.Generator[T], n)
+	for i := range out {
+		out[i] = g
+	}
+	return out
+}
+
+// withExplicitParents appends an entry "d/" for every implicit directory whose coin is true
+// (in sorted order: the old generator iterated a map).
+func withExplicitParents(pl placed, coins []bool, zip bool) []rawEntry {
+	out := append([]rawEntry(nil), pl.Entries...)
+	for i, d := range pl.Implicit {
+		if coins[i] {
+			out = append(out, rawEntry{Name: d + "/", Kind: 'd', Mode: 0o755})
+		}
+	}
+	return out
+}
+
+// orderEntries is the entries stably sorted by the drawn keys (nil: as placed), or parents
+// first (fs.WalkDir's order of the clean paths) when inOrder.
+func orderEntries(entries []rawEntry, keys []int, inOrder bool) []rawEntry {
+	out := append([]rawEntry(nil), entries...)
+	switch {
+	case inOrder:
+		sort.SliceStable(out, func(i, j int) bool { return walkKey(out[i].clean()) < walkKey(out[j].clean()) })
+	case keys != nil:
+		idx := make([]int, len(out))
+		for i := range idx {
+			idx[i] = i
+		}
+		sort.SliceStable(idx, func(i, j int) bool { return keys[idx[i]] < keys[idx[j]] })
+		sorted := make([]rawEntry, len(out))
+		for i, j := range idx {
+			sorted[i] = out[j]
+		}
+		out = sorted
+	}
+	return out
+}
+
+// withDotEntry is the entries with a "." (1) or "./" (2) directory entry first, as tar makes
+// of the current directory.
+func withDotEntry(entries []rawEntry, dot int) []rawEntry {
+	if dot == 0 {
+		return entries
+	}
+	name := []string{"", ".", "./"}[dot]
+	return append([]rawEntry{{Name: name, Kind: 'd', Mode: 0o755}}, entries...)
+}
+
+// buildArchiveFSCase is the case: the directory for Sub is the sorted directories' subAt-th
+// modulo their number ("" without one).
+func buildArchiveFSCase(entries []rawEntry, zip bool, tf, subAt int, prefixes, rest bool) archiveFSCase {
+	c := archiveFSCase{Entries: entries, Zip: zip, TarFormat: tf, Prefixes: prefixes, Rest: rest}
+	if ds := rawDirs(entries); len(ds) > 0 {
+		c.SubDir = ds[subAt%len(ds)]
+	}
+	return c
+}
+
+// archiveFSCases is the cases of the wide property.
+var archiveFSCases = rawCasesWith(wideRawParams)
+
+// --------------------------------------------------------------------------- the paths
+
+// rawPaths is every path the file system holds (the entries' clean names but ".", and the
+// directories above them), sorted; rawDirs the directories among them (explicit or
+// implicit), sorted.
+func rawPaths(entries []rawEntry) []string {
+	seen := map[string]bool{}
+	for _, e := range entries {
+		p := e.clean()
+		if p == "." {
+			continue
+		}
+		seen[p] = true
+		for d := path.Dir(p); d != "."; d = path.Dir(d) {
+			seen[d] = true
+		}
+	}
+	var out []string
+	for p := range seen {
+		out = append(out, p)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func rawDirs(entries []rawEntry) []string {
+	kinds := rawKinds(entries)
+	var out []string
+	for _, p := range rawPaths(entries) {
+		if kinds[p] == 'd' {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+// rawKinds is the kind of every path: the entry's, 'd' for an implicit directory.
+func rawKinds(entries []rawEntry) map[string]byte {
+	out := map[string]byte{}
+	for _, p := range rawPaths(entries) {
+		out[p] = 'd'
+	}
+	for _, e := range entries {
+		if p := e.clean(); p != "." {
+			out[p] = e.Kind
+		}
+	}
+	return out
+}
+
+// entryAtPath is the entry of a path (nil for an implicit directory).
+func entryAtPath(entries []rawEntry, p string) *rawEntry {
+	for i := range entries {
+		if entries[i].clean() == p {
+			return &entries[i]
+		}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- the model
+
+// nodeInfo is a FileInfo as the checks spell it (testing/fstest's formatInfo: name, IsDir,
+// mode, size, time): a real entry's (archive/tar's headerFileInfo, archive/zip's: the base
+// name, the mode with its type bits, the size - a zip link's is its target's length -, the
+// time rawTime) or an implicit directory's (fs.go :1151-1157: ModeDir, 0, the zero time).
+type nodeInfo struct {
+	Name  string
+	Kind  byte
+	Mode  fs.FileMode
+	Size  int64
+	Mtime string
+}
+
+func (n nodeInfo) IsDir() bool { return n.Kind == 'd' }
+
+func (n nodeInfo) String() string {
+	return fmt.Sprintf("%s IsDir=%v Mode=%v Size=%d ModTime=%s", n.Name, n.IsDir(), n.Mode, n.Size, n.Mtime)
+}
+
+// entryString is fstest's formatEntry / formatInfoEntry.
+func (n nodeInfo) entryString() string {
+	return fmt.Sprintf("%s IsDir=%v Type=%v", n.Name, n.IsDir(), n.Mode.Type())
+}
+
+func infoOfEntry(e rawEntry, zip bool) nodeInfo {
+	n := nodeInfo{Name: path.Base(e.clean()), Kind: e.Kind, Mode: e.Mode, Mtime: strconv.FormatInt(rawTime.Unix(), 10)}
+	switch e.Kind {
+	case 'd':
+		n.Mode |= fs.ModeDir
+	case 'l':
+		n.Mode |= fs.ModeSymlink
+		if zip {
+			n.Size = int64(len(e.Link))
+		}
+	case 'f':
+		n.Size = int64(len(e.Data))
+	}
+	return n
+}
+
+func implicitInfo(name string) nodeInfo {
+	return nodeInfo{Name: name, Kind: 'd', Mode: fs.ModeDir, Mtime: "zero"}
+}
+
+// infoOf is the library's FileInfo spelled as nodeInfo (the actual side).
+func infoOf(fi fs.FileInfo) nodeInfo {
+	n := nodeInfo{Name: fi.Name(), Kind: 'f', Mode: fi.Mode(), Size: fi.Size(), Mtime: "zero"}
+	switch {
+	case fi.IsDir():
+		n.Kind = 'd'
+	case fi.Mode()&fs.ModeSymlink != 0:
+		n.Kind = 'l'
+	}
+	if !fi.ModTime().IsZero() {
+		n.Mtime = strconv.FormatInt(fi.ModTime().Unix(), 10)
+	}
+	return n
+}
+
+// fsIndex is the index ReadDir builds (fs.go :615-703): contents by clean path, the children
+// of every directory sorted by name.
+type fsIndex struct {
+	contents map[string]nodeInfo
+	dirs     map[string][]nodeInfo
+}
+
+// fsModel is the file system over the entries under the switch set: Prefix as Sub sets it,
+// and the index once ReadDir on the pointer built it (nil before).
+type fsModel struct {
+	entries []rawEntry
+	zip     bool
+	k       known
+	prefix  string
+	index   *fsIndex
+}
+
+func newFSModel(c archiveFSCase, k known) *fsModel {
+	return &fsModel{entries: c.Entries, zip: c.Zip, k: k}
+}
+
+// openResult is what Open gives: a file (not a fs.ReadDirFile; its info), or a directory
+// file with its info and children.
+type openResult struct {
+	File    bool
+	Info    nodeInfo
+	Entries []nodeInfo
+}
+
+var errNotExist = errors.New("not exist")
+
+// included is fileIsIncluded (archives.go :399-415) over a non-nil skip list: the name is in
+// the list, or under one of its entries without a trailing slash.
+func included(skip []string, name string) bool {
+	for _, s := range skip {
+		if name == s || strings.HasPrefix(name, strings.TrimSuffix(s, "/")+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+// buildIndex transcribes ReadDir's handler (fs.go :628-703): every entry's clean name but
+// "." into contents and its parent's sorted children (a real entry replacing an implicit one
+// of the name), then up the path: each directory above gets the next segment as an implicit
+// child when it has none of the name, and - the archives/7 replica, :697-699 - contents of
+// that directory is set, when absent, to an implicit directory NAMED FOR THE SEGMENT BELOW
+// IT (the documented name is the directory's own base name).
+func (m *fsModel) buildIndex() *fsIndex {
+	ix := &fsIndex{contents: map[string]nodeInfo{}, dirs: map[string][]nodeInfo{}}
+	for _, e := range m.entries {
+		name := e.clean()
+		if name == "." {
+			continue
+		}
+		info := infoOfEntry(e, m.zip)
+		ix.contents[name] = info
+		ix.dirs[path.Dir(name)] = insertSorted(ix.dirs[path.Dir(name)], info, true)
+		start := strings.TrimPrefix(path.Dir(name), "/")
+		for dir, base := path.Dir(start), path.Base(start); base != "."; dir, base = path.Dir(dir), path.Base(dir) {
+			ix.dirs[dir] = insertSorted(ix.dirs[dir], implicitInfo(base), false)
+			if _, ok := ix.contents[dir]; !ok {
+				own := base
+				if !m.k[kStatImplicitDirName] {
+					own = path.Base(dir)
+				}
+				ix.contents[dir] = implicitInfo(own)
+			}
+		}
+	}
+	return ix
+}
+
+// insertSorted is the sorted insert of fs.go :656-663 and :684-689: by name; an entry of the
+// name is replaced when replace, else left.
+func insertSorted(list []nodeInfo, e nodeInfo, replace bool) []nodeInfo {
+	i := sort.Search(len(list), func(i int) bool { return list[i].Name >= e.Name })
+	if i < len(list) && list[i].Name == e.Name {
+		if replace {
+			list[i] = e
+		}
+		return list
+	}
+	list = append(list, nodeInfo{})
+	copy(list[i+1:], list[i:])
+	list[i] = e
+	return list
+}
+
+// readDir is ReadDir on the pointer (fs.go :598-722): the index is built once (an index with
+// no directory is built again on every call, :611, to the same end) and the directory's
+// sorted children returned (nil for a missing name or a file).
+func (m *fsModel) readDir(name string) []nodeInfo {
+	name = path.Join(m.prefix, name)
+	if m.index == nil || len(m.index.dirs) == 0 {
+		m.index = m.buildIndex()
+	}
+	return m.index.dirs[name]
+}
+
+// rootInfo is the root's info: Open(".") gives dirFileInfo{implicitDirInfo{"."}} (fs.go
+// :392-394, :408-411), Stat(".") implicitDirInfo{"."} (:529): the same values.
+var rootInfo = implicitInfo(".")
+
+// open transcribes Open (fs.go :338-512): the index first when built (:348-361: a directory
+// with children, an implicit one named for its path - the archives/7 replica -, a missing
+// name; a file or a childless directory falls through); "." before the index is the root
+// listed through an index built on a copy (:384-412); else the handler's walk of the
+// archive (:433-490) with Extract's skip list (tar.go :266, :295; zip.go :225, :253).
+func (m *fsModel) open(name string) (openResult, error) {
+	name = path.Join(m.prefix, name)
+	if m.index != nil {
+		if info, found := m.index.contents[name]; found {
+			if info.IsDir() {
+				if entries, ok := m.index.dirs[name]; ok {
+					return openResult{Info: info, Entries: entries}, nil
+				}
+			}
+		} else {
+			if entries, found := m.index.dirs[name]; found {
+				own := name
+				if !m.k[kStatImplicitDirName] {
+					own = path.Base(name)
+				}
+				return openResult{Info: implicitInfo(own), Entries: entries}, nil
+			}
+			return openResult{}, errNotExist
+		}
+	}
+	if name == "." {
+		copy := *m
+		copy.prefix = ""
+		return openResult{Info: rootInfo, Entries: copy.readDir(".")}, nil
+	}
+	return m.walkOpen(name)
+}
+
+// walkOpen is the handler's walk. The documented directory is set up before the walk when
+// the file system holds it (its entry's info, or the implicit one): under kOpenImplicitDirFile
+// (archives/4, :451-489) it is set up only by its own entry, so a descendant met first is
+// opened and returned as the directory. Its children: under kOpenDirFreshEntries
+// (archives/5) every entry under it is listed by base name as the walk meets it, a
+// subdirectory's entry stopping its descendants through the skip list of RAW names
+// (archives.go :410 against the raw name of :295/:253), so the files of an implicit or late
+// subdirectory and of a "./"-spelt one are its own children; documented, the children are
+// the entries of its own, an implicit subdirectory listed once at its first descendant.
+func (m *fsModel) walkOpen(name string) (openResult, error) {
+	k := m.k
+	kinds := rawKinds(m.entries)
+	var df *openResult
+	if !k[kOpenImplicitDirFile] && kinds[name] == 'd' {
+		info := implicitInfo(path.Base(name))
+		if e := entryAtPath(m.entries, name); e != nil {
+			info = infoOfEntry(*e, m.zip)
+		}
+		df = &openResult{Info: info}
+	}
+	var skip []string
+	listed := map[string]int{}
+	for _, e := range m.entries {
+		if included(skip, e.Name) {
+			continue
+		}
+		clean := e.clean()
+		if !strings.HasPrefix(clean+"/", name+"/") {
+			continue
+		}
+		if clean == name && e.Kind == 'd' {
+			if df == nil || k[kOpenImplicitDirFile] {
+				df = &openResult{Info: infoOfEntry(e, m.zip)}
+			} else {
+				df.Info = infoOfEntry(e, m.zip)
+			}
+			continue
+		}
+		if df != nil {
+			info := infoOfEntry(e, m.zip)
+			if k[kOpenDirFreshEntries] {
+				df.Entries = append(df.Entries, info)
+				if e.Kind == 'd' {
+					skip = append(skip, e.Name)
+				}
+				continue
+			}
+			rel := clean[len(name)+1:]
+			first, _, deeper := strings.Cut(rel, "/")
+			if i, ok := listed[first]; ok {
+				if !deeper {
+					df.Entries[i] = info
+				}
+				continue
+			}
+			listed[first] = len(df.Entries)
+			if deeper {
+				info = implicitInfo(first)
+			}
+			df.Entries = append(df.Entries, info)
+			continue
+		}
+		return openResult{File: true, Info: infoOfEntry(e, m.zip)}, nil
+	}
+	if df == nil {
+		return openResult{}, errNotExist
+	}
+	return *df, nil
+}
+
+// stat transcribes Stat (fs.go :516-594): "." is the root before anything (:521-531); the
+// index when built (:537-547: contents, else an implicit directory named for its path - the
+// archives/7 replica -, else not found); else the walk: the first entry of the clean name
+// (:565-569), else - the fallback of :572-574 - an implicit directory when some entry's
+// clean name has the name as a prefix: under kStatPrefixMissing a STRING prefix (archives/6),
+// documented a path prefix (the name followed by a slash, the guard Open's handler has at
+// :451); named for the full path under kStatImplicitDirName (archives/7), its base name
+// documented.
+func (m *fsModel) stat(name string) (nodeInfo, error) {
+	if name == "." {
+		return rootInfo, nil
+	}
+	name = path.Join(m.prefix, name)
+	if m.index != nil {
+		if info, ok := m.index.contents[name]; ok {
+			return info, nil
+		}
+		if _, ok := m.index.dirs[name]; ok {
+			return m.implicitNamed(name), nil
+		}
+		return nodeInfo{}, errNotExist
+	}
+	fallback := false
+	for _, e := range m.entries {
+		clean := e.clean()
+		if clean == name {
+			return infoOfEntry(e, m.zip), nil
+		}
+		if m.k[kStatPrefixMissing] {
+			fallback = fallback || strings.HasPrefix(clean, name)
+		} else {
+			fallback = fallback || strings.HasPrefix(clean, name+"/")
+		}
+	}
+	if fallback {
+		return m.implicitNamed(name), nil
+	}
+	return nodeInfo{}, errNotExist
+}
+
+func (m *fsModel) implicitNamed(name string) nodeInfo {
+	if m.k[kStatImplicitDirName] {
+		return implicitInfo(name)
+	}
+	return implicitInfo(path.Base(name))
+}
+
+// sub is Sub (fs.go :725-744): Stat of the directory, then a copy rooted at it (the index
+// shared).
+func (m *fsModel) sub(dir string) (*fsModel, error) {
+	info, err := m.stat(dir)
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() {
+		return nil, errors.New("not a directory")
+	}
+	copy := *m
+	copy.prefix = path.Join(m.prefix, dir)
+	return &copy, nil
+}
+
+// walk is fs.WalkDir from "." (ReadDir on the pointer per directory): the paths with their
+// kinds, sorted.
+func (m *fsModel) walk() []string {
+	var out []string
+	var rec func(dir string)
+	rec = func(dir string) {
+		for _, e := range m.readDir(dir) {
+			p := path.Join(dir, e.Name)
+			out = append(out, kindLetter(e)+" "+p)
+			if e.IsDir() {
+				rec(p)
+			}
+		}
+	}
+	rec(".")
+	sort.Strings(out)
+	return out
+}
+
+func kindLetter(n nodeInfo) string {
+	switch {
+	case n.IsDir():
+		return "d"
+	case n.Mode&fs.ModeSymlink != 0:
+		return "l"
+	}
+	return "f"
+}
+
+// dirHandle is a directory file's paging (dirFile.ReadDir, fs.go :1067-1085): n > 0 reads
+// the next n (io.EOF at the end); n <= 0 under kDirFileReadDirRest returns every child and
+// moves nothing (archives/8, :1068-1070), documented the children not yet read.
+type dirHandle struct {
+	entries []nodeInfo
+	read    int
+	k       known
+}
+
+func (h *dirHandle) readDir(n int) ([]nodeInfo, bool) {
+	if n <= 0 {
+		if h.k[kDirFileReadDirRest] {
+			return h.entries, false
+		}
+		rest := h.entries[h.read:]
+		h.read = len(h.entries)
+		return rest, false
+	}
+	if h.read >= len(h.entries) {
+		return nil, true
+	}
+	if h.read+n > len(h.entries) {
+		n = len(h.entries) - h.read
+	}
+	out := h.entries[h.read : h.read+n]
+	h.read += n
+	return out, false
+}
+
+// --------------------------------------------------------------------------- the values
+
+// listingValue spells a directory's children: the names sorted, a slash after a directory's,
+// duplicates kept.
+func listingValue(entries []nodeInfo) string {
+	var names []string
+	for _, e := range entries {
+		n := e.Name
+		if e.IsDir() {
+			n += "/"
+		}
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	return "[" + strings.Join(names, " ") + "]"
+}
+
+// openValue spells an Open result: "file <info>" for a file (not a fs.ReadDirFile), "dir
+// <info> <children>" for a directory file, "not exist".
+func openValue(r openResult, err error) string {
+	if err != nil {
+		return err.Error()
+	}
+	if r.File {
+		return "file " + r.Info.String()
+	}
+	return "dir " + r.Info.String() + " " + listingValue(r.Entries)
+}
+
+func statValue(n nodeInfo, err error) string {
+	if err != nil {
+		return err.Error()
+	}
+	return n.String()
+}
+
+// restValue spells the reads of a directory file: with rest, ReadDir(1) then ReadDir(-1)
+// ("1 then N: <all names sorted>"); else ReadDir(1) to io.EOF and once more ("N pages then
+// EOF: ..."). The names are sorted (a directory file's order is not stated), so the value
+// says how many came each time and whether any came twice.
+func restValue(r openResult, err error, rest bool, k known) string {
+	if err != nil {
+		return err.Error()
+	}
+	if r.File {
+		return "not a directory file"
+	}
+	h := &dirHandle{entries: r.Entries, k: k}
+	if rest {
+		first, _ := h.readDir(1)
+		more, _ := h.readDir(-1)
+		return fmt.Sprintf("%d then %d: %s", len(first), len(more), listingValue(append(append([]nodeInfo(nil), first...), more...)))
+	}
+	var all []nodeInfo
+	pages := 0
+	for pages <= len(r.Entries) {
+		frag, eof := h.readDir(1)
+		if eof {
+			break
+		}
+		all = append(all, frag...)
+		pages++
+	}
+	_, eof := h.readDir(1)
+	end := "EOF"
+	if !eof {
+		end = "more"
+	}
+	return fmt.Sprintf("%d pages then %s: %s", pages, end, listingValue(all))
+}
+
+func sha8(b []byte) string {
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:4])
+}
+
+// missingNames are the names probed as missing for a path: its base name shortened by a
+// character (when Prefixes: the shape of archives/6, a string prefix of the entry's name),
+// a child of a file, and the name with "zz" appended - each when the file system does not
+// hold it.
+func missingNames(entries []rawEntry, p string, prefixes bool) []string {
+	kinds := rawKinds(entries)
+	var out []string
+	if b := path.Base(p); len(b) > 1 && prefixes {
+		out = append(out, path.Join(path.Dir(p), b[:len(b)-1]))
+	}
+	if kinds[p] != 'd' {
+		out = append(out, p+"/zz")
+	}
+	out = append(out, p+"zz")
+	var kept []string
+	for _, n := range out {
+		if _, held := kinds[n]; !held {
+			kept = append(kept, n)
+		}
+	}
+	return kept
+}
+
+// archiveFSExpected states every value the property checks for the case under the switch
+// set.
+func archiveFSExpected(c archiveFSCase, k known) checks {
+	out := checks{}
+	fresh := func() *fsModel { return newFSModel(c, k) }
+	indexed := newFSModel(c, k)
+	out.set("walk", strings.Join(indexed.walk(), ", "))
+	kinds := rawKinds(c.Entries)
+	for _, p := range rawPaths(c.Entries) {
+		out.set("stat fresh "+p, statValue(fresh().stat(p)))
+		out.set("stat indexed "+p, statValue(indexed.stat(p)))
+		for _, n := range missingNames(c.Entries, p, c.Prefixes) {
+			out.set("stat fresh "+n, statValue(fresh().stat(n)))
+			out.set("stat indexed "+n, statValue(indexed.stat(n)))
+			out.set("open fresh "+n, openValue(fresh().open(n)))
+			out.set("open indexed "+n, openValue(indexed.open(n)))
+		}
+		if kinds[p] == 'f' {
+			data := entryAtPath(c.Entries, p).Data
+			out.set("read fresh "+p, sha8(data))
+			out.set("read indexed "+p, sha8(data))
+		}
+	}
+	for _, d := range append([]string{"."}, rawDirs(c.Entries)...) {
+		out.set("open fresh "+d, openValue(fresh().open(d)))
+		out.set("open indexed "+d, openValue(indexed.open(d)))
+		out.set("readdir "+d, listingValue(indexed.readDir(d)))
+		r, err := fresh().open(d)
+		out.set("rest fresh "+d, restValue(r, err, c.Rest, k))
+		r, err = indexed.open(d)
+		out.set("rest indexed "+d, restValue(r, err, c.Rest, k))
+	}
+	if c.SubDir != "" {
+		sub, err := fresh().sub(c.SubDir)
+		if err != nil {
+			out.set("sub "+c.SubDir, err.Error())
+		} else {
+			out.set("sub "+c.SubDir, strings.Join(sub.walk(), ", "))
+		}
+	}
+	out.set("testfs", classesValue(testFSClassesOf(fresh(), rawPaths(c.Entries))))
+	return out
+}
+
+func init() {
+	for i, name := range []string{"walk", "stat", "open", "read", "readdir", "rest", "sub", "testfs"} {
+		checkRank[name] = 300 + i
+	}
+}
+
+// --------------------------------------------------------------------------- TestFS transcribed
+
+// testFSClassesOf transcribes testing/fstest's TestFS (testfs.go, Go 1.27) over the model:
+// the classes of the lines its report would carry. TestFS checks the root directory deep
+// first (checkDir: Open, ReadDir(-1), per child checkStat - Open, Stat, the entry against
+// the opened file's Stat and the entry's Info, fs.Stat and fsys.Stat against it - then the
+// child as a directory or a file; then ReadDir(-1) and ReadDir(1) at the end, a second and
+// a third Open, fsys.ReadDir - which builds the index -, fs.ReadDir and Glob), then the
+// expected names against those found, then the same over fs.Sub of the first directory
+// among the expected names. The classes: "open" (Open failed), "open dir not ReadDirFile",
+// "entry mismatch", "stat", "ReadDir at EOF", "ReadDir(1) at EOF", "dir list diff",
+// "readdir", "expected not found", "unexpected files", "file read", "glob", "close", "bad
+// path", "other"; those of the Sub test prefixed "sub ".
+func testFSClassesOf(m *fsModel, expected []string) []string {
+	t := &fsTester{m: m}
+	t.testFS(expected)
+	classes := t.classes
+	if len(classes) == 0 {
+		for _, name := range expected {
+			if i := strings.Index(name, "/"); i >= 0 {
+				dir, dirSlash := name[:i], name[:i+1]
+				var subExpected []string
+				for _, n := range expected {
+					if strings.HasPrefix(n, dirSlash) {
+						subExpected = append(subExpected, n[len(dirSlash):])
+					}
+				}
+				sub, err := m.sub(dir)
+				if err != nil {
+					classes = append(classes, "sub "+subErrClass(err.Error()))
+					break
+				}
+				st := &fsTester{m: sub, prefix: "sub "}
+				st.testFS(subExpected)
+				classes = append(classes, st.classes...)
+				break
+			}
+		}
+	}
+	return uniqueStrings(classes)
+}
+
+func subErrClass(s string) string {
+	if strings.Contains(s, "not a directory") {
+		return "not a directory"
+	}
+	return "stat error"
+}
+
+// classesValue spells a set of classes ("none" for the empty set).
+func classesValue(classes []string) string {
+	if len(classes) == 0 {
+		return "none"
+	}
+	return strings.Join(uniqueStrings(classes), ", ")
+}
+
+type fsTester struct {
+	m       *fsModel
+	prefix  string
+	classes []string
+	dirs    []string
+	files   []string
+}
+
+func (t *fsTester) add(class string) { t.classes = append(t.classes, t.prefix+class) }
+
+func (t *fsTester) testFS(expected []string) {
+	t.checkDir(".")
+	found := map[string]bool{}
+	for _, d := range t.dirs {
+		found[d] = true
+	}
+	for _, f := range t.files {
+		found[f] = true
+	}
+	delete(found, ".")
+	if len(expected) == 0 && len(found) > 0 {
+		t.add("unexpected files")
+	}
+	for _, name := range expected {
+		if !found[name] {
+			t.add("expected not found")
+		}
+	}
+}
+
+func (t *fsTester) openDir(dir string) *dirHandle {
+	r, err := t.m.open(dir)
+	if err != nil {
+		t.add("open")
+		return nil
+	}
+	if r.File {
+		t.add("open dir not ReadDirFile")
+		return nil
+	}
+	return &dirHandle{entries: r.Entries, k: t.m.k}
+}
+
+func (t *fsTester) checkDir(dir string) {
+	t.dirs = append(t.dirs, dir)
+	d := t.openDir(dir)
+	if d == nil {
+		return
+	}
+	list, _ := d.readDir(-1)
+	prefix := ""
+	if dir != "." {
+		prefix = dir + "/"
+	}
+	for _, info := range list {
+		p := prefix + info.Name
+		t.checkStat(p, info)
+		switch info.Mode.Type() {
+		case fs.ModeDir:
+			t.checkDir(p)
+		case fs.ModeSymlink:
+			t.files = append(t.files, p)
+		default:
+			t.checkFile(p)
+		}
+	}
+	if list2, _ := d.readDir(-1); len(list2) > 0 {
+		t.add("ReadDir at EOF")
+		return
+	}
+	if list2, eof := d.readDir(1); len(list2) > 0 || !eof {
+		t.add("ReadDir(1) at EOF")
+		return
+	}
+	if d = t.openDir(dir); d == nil {
+		return
+	}
+	list2, _ := d.readDir(-1)
+	t.checkDirList(list, list2)
+	if d = t.openDir(dir); d == nil {
+		return
+	}
+	list2 = nil
+	for {
+		n := 1
+		if len(list2) > 0 {
+			n = 2
+		}
+		frag, eof := d.readDir(n)
+		list2 = append(list2, frag...)
+		if eof {
+			break
+		}
+		if len(frag) == 0 {
+			t.add("readdir")
+			return
+		}
+	}
+	t.checkDirList(list, list2)
+	list2 = t.m.readDir(dir)
+	t.checkDirList(list, list2)
+	for i := 0; i+1 < len(list2); i++ {
+		if list2[i].Name >= list2[i+1].Name {
+			t.add("readdir")
+		}
+	}
+	list2 = t.m.readDir(dir)
+	t.checkDirList(list, list2)
+	// fs.Glob over the index finds the names it lists: no lines
+}
+
+// checkDirList is fstest's: the lists compared by name (a map of the first: duplicate names
+// collapse), then IsDir and Type.
+func (t *fsTester) checkDirList(list1, list2 []nodeInfo) {
+	old := map[string]*nodeInfo{}
+	for i := range list1 {
+		old[list1[i].Name] = &list1[i]
+	}
+	diffs := 0
+	for _, e2 := range list2 {
+		e1 := old[e2.Name]
+		if e1 == nil {
+			diffs++
+			continue
+		}
+		if e1.entryString() != e2.entryString() {
+			diffs++
+		}
+		delete(old, e2.Name)
+	}
+	diffs += len(old)
+	if diffs > 0 {
+		t.add("dir list diff")
+	}
+}
+
+func (t *fsTester) checkStat(p string, entry nodeInfo) {
+	r, err := t.m.open(p)
+	if err != nil {
+		t.add("open")
+		return
+	}
+	info := r.Info
+	symlink := entry.Mode&fs.ModeSymlink != 0
+	if entry.entryString() != info.entryString() && !symlink {
+		t.add("entry mismatch")
+	}
+	// the entry's Info is the entry itself (fs.FileInfoToDirEntry, implicitDirEntry.Info)
+	if !symlink && entry.String() != info.String() {
+		t.add("entry mismatch")
+	}
+	info2, err := t.m.stat(p)
+	if err != nil {
+		t.add("stat")
+		return
+	}
+	if info2.String() != info.String() {
+		t.add("stat")
+	}
+}
+
+func (t *fsTester) checkFile(p string) {
+	t.files = append(t.files, p)
+	r, err := t.m.open(p)
+	if err != nil {
+		t.add("open")
+		return
+	}
+	if !r.File {
+		// a name listed as a file that opens as a directory (archives/5 lists a
+		// subdirectory's file beside the subdirectory, under the same name): ReadAll of
+		// the directory file is "Open+ReadAll: cannot read a directory file"
+		t.add("file read")
+		return
+	}
+	// ReadAll, fs.ReadFile, a second Open and iotest.TestReader: no lines
+}
+
+// testFSClasses classes the lines of a TestFS report (the library side): the main report's
+// lines, and the Sub test's with the prefix "sub ".
+func testFSClasses(err error) []string {
+	if err == nil {
+		return nil
+	}
+	var out []string
+	prefix := ""
+	text := err.Error()
+	if rest, ok := strings.CutPrefix(text, "testing fs.Sub(fsys, "); ok {
+		prefix = "sub "
+		if i := strings.Index(rest, "): "); i >= 0 {
+			text = rest[i+3:]
+		}
+		if !strings.HasPrefix(text, "TestFS found errors:") {
+			return []string{"sub " + subErrClass(text)}
+		}
+	}
+	for _, line := range strings.Split(text, "\n") {
+		if line == "" || line == "TestFS found errors:" || line[0] == ' ' || line[0] == '\t' {
+			continue
+		}
+		out = append(out, prefix+testFSLineClass(line))
+	}
+	return uniqueStrings(out)
+}
+
+func testFSLineClass(line string) string {
+	switch {
+	case strings.HasPrefix(line, "expected but not found"):
+		return "expected not found"
+	case strings.HasPrefix(line, "expected empty file system"):
+		return "unexpected files"
+	case strings.Contains(line, "Open returned File type"):
+		return "open dir not ReadDirFile"
+	case strings.Contains(line, "ReadDir(-1) at EOF"):
+		return "ReadDir at EOF"
+	case strings.Contains(line, "ReadDir(1) at EOF"):
+		return "ReadDir(1) at EOF"
+	case strings.Contains(line, "mismatch"):
+		return "entry mismatch"
+	case strings.Contains(line, "entry.Info:"):
+		return "entry info"
+	case strings.Contains(line, "fs.Stat"), strings.Contains(line, "fsys.Stat"), strings.Contains(line, ": Stat:"):
+		return "stat"
+	case strings.Contains(line, "Open+ReadAll"), strings.Contains(line, "ReadFile"), strings.Contains(line, "second Open:"),
+		strings.Contains(line, "failed TestReader"), strings.Contains(line, "different data"):
+		return "file read"
+	case strings.Contains(line, ": Open:"):
+		return "open"
+	case strings.Contains(line, ": diff "):
+		return "dir list diff"
+	case strings.Contains(line, "ReadDir"):
+		return "readdir"
+	case strings.Contains(line, "Glob"):
+		return "glob"
+	case strings.Contains(line, "Close"):
+		return "close"
+	case strings.Contains(line, "succeeded, want error"):
+		return "bad path"
+	}
+	return "other: " + hzTrim(line, 60)
+}
+
+// --------------------------------------------------------------------------- the library
+
+// writeRawTar and writeRawZip write the entries by hand with archive/tar (the format given)
+// and archive/zip (Deflate; directories stored; a link's target as its content, mode
+// ModeSymlink), every entry at rawTime.
+func writeRawTar(entries []rawEntry, format tar.Format) []byte {
+	var buf bytes.Buffer
+	tw := tar.NewWriter(&buf)
+	for _, e := range entries {
+		h := &tar.Header{Name: e.Name, Mode: int64(e.Mode), Format: format, ModTime: rawTime}
+		switch e.Kind {
+		case 'd':
+			h.Typeflag = tar.TypeDir
+		case 'f':
+			h.Typeflag = tar.TypeReg
+			h.Size = int64(len(e.Data))
+		case 'l':
+			h.Typeflag = tar.TypeSymlink
+			h.Linkname = e.Link
+		}
+		if err := tw.WriteHeader(h); err != nil {
+			panic(err)
+		}
+		if e.Kind == 'f' {
+			tw.Write(e.Data)
+		}
+	}
+	tw.Close()
+	return buf.Bytes()
+}
+
+func writeRawZip(entries []rawEntry) []byte {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for _, e := range entries {
+		h := &zip.FileHeader{Name: e.Name, Method: zip.Deflate, Modified: rawTime}
+		switch e.Kind {
+		case 'd':
+			h.SetMode(fs.ModeDir | e.Mode)
+			h.Method = zip.Store
+		case 'f':
+			h.SetMode(e.Mode)
+		case 'l':
+			h.SetMode(fs.ModeSymlink | e.Mode)
+		}
+		w, err := zw.CreateHeader(h)
+		if err != nil {
+			panic(err)
+		}
+		switch e.Kind {
+		case 'f':
+			w.Write(e.Data)
+		case 'l':
+			w.Write([]byte(e.Link))
+		}
+	}
+	zw.Close()
+	return buf.Bytes()
+}
+
+// archiveFSBuild writes the case's archive.
+func archiveFSBuild(c archiveFSCase) []byte {
+	if c.Zip {
+		return writeRawZip(c.Entries)
+	}
+	return writeRawTar(c.Entries, []tar.Format{0, tar.FormatUSTAR, tar.FormatPAX, tar.FormatGNU}[c.TarFormat])
+}
+
+// archiveFSOf is an ArchiveFS over the bytes, fresh.
+func archiveFSOf(c archiveFSCase, data []byte) *archives.ArchiveFS {
+	var format archives.Extractor = archives.Tar{}
+	if c.Zip {
+		format = archives.Zip{}
+	}
+	return &archives.ArchiveFS{Stream: io.NewSectionReader(bytes.NewReader(data), 0, int64(len(data))), Format: format}
+}
+
+func errValue(err error) string {
+	if errors.Is(err, fs.ErrNotExist) {
+		return "not exist"
+	}
+	return "error: " + err.Error()
+}
+
+// libOpen spells the library's Open as openValue does (a directory file read whole).
+func libOpen(fsys fs.FS, name string) string {
+	f, err := fsys.Open(name)
+	if err != nil {
+		return errValue(err)
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return "error: Stat: " + err.Error()
+	}
+	rdf, ok := f.(fs.ReadDirFile)
+	if !ok {
+		return "file " + infoOf(info).String()
+	}
+	ents, err := rdf.ReadDir(-1)
+	if err != nil {
+		return "error: ReadDir: " + err.Error()
+	}
+	return "dir " + infoOf(info).String() + " " + listingValue(entriesOf(ents))
+}
+
+func entriesOf(ents []fs.DirEntry) []nodeInfo {
+	var out []nodeInfo
+	for _, e := range ents {
+		n := nodeInfo{Name: e.Name(), Kind: 'f', Mode: e.Type()}
+		switch {
+		case e.IsDir():
+			n.Kind = 'd'
+		case e.Type()&fs.ModeSymlink != 0:
+			n.Kind = 'l'
+		}
+		out = append(out, n)
+	}
+	return out
+}
+
+func libStat(fsys fs.StatFS, name string) string {
+	info, err := fsys.Stat(name)
+	if err != nil {
+		return errValue(err)
+	}
+	return infoOf(info).String()
+}
+
+func libRead(fsys fs.FS, name string) string {
+	data, err := fs.ReadFile(fsys, name)
+	if err != nil {
+		return errValue(err)
+	}
+	return sha8(data)
+}
+
+func libRest(fsys fs.FS, name string, rest bool) string {
+	f, err := fsys.Open(name)
+	if err != nil {
+		return errValue(err)
+	}
+	defer f.Close()
+	rdf, ok := f.(fs.ReadDirFile)
+	if !ok {
+		return "not a directory file"
+	}
+	if rest {
+		first, err1 := rdf.ReadDir(1)
+		more, err2 := rdf.ReadDir(-1)
+		if err1 != nil && err1 != io.EOF {
+			return "error: " + err1.Error()
+		}
+		if err2 != nil {
+			return "error: " + err2.Error()
+		}
+		return fmt.Sprintf("%d then %d: %s", len(first), len(more), listingValue(entriesOf(append(append([]fs.DirEntry(nil), first...), more...))))
+	}
+	var all []fs.DirEntry
+	pages := 0
+	for pages <= 10000 {
+		frag, err := rdf.ReadDir(1)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return "error: " + err.Error()
+		}
+		if len(frag) == 0 {
+			return "error: no entries and no EOF"
+		}
+		all = append(all, frag...)
+		pages++
+	}
+	end := "more"
+	if _, err := rdf.ReadDir(1); err == io.EOF {
+		end = "EOF"
+	}
+	return fmt.Sprintf("%d pages then %s: %s", pages, end, listingValue(entriesOf(all)))
+}
+
+func libWalk(fsys fs.FS) string {
+	var out []string
+	err := fs.WalkDir(fsys, ".", func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return fmt.Errorf("at %q: %w", p, err)
+		}
+		if p != "." {
+			out = append(out, kindLetter(entriesOf([]fs.DirEntry{d})[0])+" "+p)
+		}
+		return nil
+	})
+	if err != nil {
+		return "error: " + err.Error()
+	}
+	sort.Strings(out)
+	return strings.Join(out, ", ")
+}
+
+// archiveFSActual asks the library the questions archiveFSExpected answered: every fresh
+// call on a new ArchiveFS over the bytes, the indexed ones on one whose ReadDir(".") was
+// called first.
+func archiveFSActual(c archiveFSCase, data []byte, withTestFS bool) checks {
+	out := checks{}
+	fresh := func() *archives.ArchiveFS { return archiveFSOf(c, data) }
+	indexed := archiveFSOf(c, data)
+	out.set("walk", libWalk(indexed))
+	indexed.ReadDir(".")
+	kinds := rawKinds(c.Entries)
+	for _, p := range rawPaths(c.Entries) {
+		out.set("stat fresh "+p, libStat(fresh(), p))
+		out.set("stat indexed "+p, libStat(indexed, p))
+		for _, n := range missingNames(c.Entries, p, c.Prefixes) {
+			out.set("stat fresh "+n, libStat(fresh(), n))
+			out.set("stat indexed "+n, libStat(indexed, n))
+			out.set("open fresh "+n, libOpen(fresh(), n))
+			out.set("open indexed "+n, libOpen(indexed, n))
+		}
+		if kinds[p] == 'f' {
+			out.set("read fresh "+p, libRead(fresh(), p))
+			out.set("read indexed "+p, libRead(indexed, p))
+		}
+	}
+	for _, d := range append([]string{"."}, rawDirs(c.Entries)...) {
+		out.set("open fresh "+d, libOpen(fresh(), d))
+		out.set("open indexed "+d, libOpen(indexed, d))
+		ents, err := indexed.ReadDir(d)
+		if err != nil {
+			out.set("readdir "+d, "error: "+err.Error())
+		} else {
+			out.set("readdir "+d, listingValue(entriesOf(ents)))
+		}
+		out.set("rest fresh "+d, libRest(fresh(), d, c.Rest))
+		out.set("rest indexed "+d, libRest(indexed, d, c.Rest))
+	}
+	if c.SubDir != "" {
+		sub, err := fresh().Sub(c.SubDir)
+		if err != nil {
+			out.set("sub "+c.SubDir, "error: "+err.Error())
+		} else {
+			out.set("sub "+c.SubDir, libWalk(sub))
+		}
+	}
+	if withTestFS {
+		out.set("testfs", classesValue(testFSClasses(fstest.TestFS(fresh(), rawPaths(c.Entries)...))))
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the property
+
+// archiveFSSansTestFS is the model without the TestFS check (the narrow property of
+// archives/8 is judged on the directory files' reads alone: TestFS's lines on any non-empty
+// archive are the same bug, and under HEGEL_NO_KNOWN=1 they would be the shape of every
+// case).
+func archiveFSSansTestFS(c archiveFSCase, k known) checks {
+	out := archiveFSExpected(c, k)
+	delete(out, "testfs")
+	return out
+}
+
+// archiveFSJudgeOver is the judge of the family: the archive written by hand (the case's
+// construction), then the judgement over the model given (archiveFSExpected, or a narrow
+// property's view of it: past the earlier ids by pastSwitches, or without the TestFS check -
+// sansTestFS, which the library's values leave out too) and archiveFSActual; under
+// HEGEL_NO_KNOWN=1 the checks the switches drops change on their own are dropped from a case
+// rather than the case skipped (judgeByDropping).
+func archiveFSJudgeOver(expected func(archiveFSCase, known) checks, drops []int, sansTestFS bool) func(j *hzCaseJudge, c archiveFSCase) {
+	return func(j *hzCaseJudge, c archiveFSCase) {
+		if c.Zip {
+			hzTally("container zip")
+		} else {
+			hzTally("container tar")
+		}
+		hzTally("entries " + strconv.Itoa(len(c.Entries)))
+		if len(rawDirs(c.Entries)) > len(explicitDirs(c.Entries)) {
+			hzTally("implicit directory")
+		}
+		data := archiveFSBuild(c)
+		actual := func(c *archiveFSCase) checks {
+			out := archiveFSActual(*c, data, !sansTestFS)
+			return out
+		}
+		if len(drops) > 0 {
+			judgeByDropping(j, &c, expected, actual, drops)
+			return
+		}
+		judgeBy(j, &c, expected, actual)
+	}
+}
+
+func explicitDirs(entries []rawEntry) []string {
+	var out []string
+	for _, e := range entries {
+		if e.Kind == 'd' && e.clean() != "." {
+			out = append(out, e.clean())
+		}
+	}
+	return out
+}
+
+// archiveFSDrops are the switches whose checks the wide property drops under HEGEL_NO_KNOWN=1
+// rather than skipping the case: the fresh-mode checks of archives/4, 5, 6 and 7 (the
+// implicit parents, shuffles and "./" prefixes are the population: most cases carry one),
+// and the ReadDir(-1) reads and TestFS lines of archives/8 (every non-empty archive).
+var archiveFSDrops = []int{kOpenImplicitDirFile, kOpenDirFreshEntries, kStatPrefixMissing, kStatImplicitDirName, kDirFileReadDirRest}
+
+// TestHegelArchiveFS: an archive written by hand (implicit directories, entries out of
+// order, "./" prefixes, a "." entry, directories with and without a trailing slash) read
+// through ArchiveFS is the file system of the paths it holds: fs.WalkDir visits every path
+// once with its kind, Stat and Open give the same answers before and after the index is
+// built, a directory file lists its children and pages them, ReadDir lists them sorted,
+// missing names are fs.ErrNotExist, Sub roots a subtree, and testing/fstest accepts it. The
+// shapes of the recorded bugs (a directory opened before its entry, the children of an
+// implicit subdirectory or of "./" names listed by a fresh Open, a missing name that is a
+// string prefix of an entry's, an implicit directory's Name(), ReadDir(-1) after ReadDir(1))
+// are drawn at their natural rates and fail naming the first in id order; under
+// HEGEL_NO_KNOWN=1 the prefix probes and the ReadDir(-1) reads are not drawn, the checks
+// those shapes change are dropped from a case that has them, and a case the classifier
+// still names is skipped by the judge.
+func TestHegelArchiveFS(t *testing.T) {
+	judged(t, archiveFSCases, archiveFSJudgeOver(archiveFSExpected, archiveFSDrops, false))
+}
diff --git a/hegel/hegel_zoo_compression_test.go b/hegel/hegel_zoo_compression_test.go
new file mode 100644
index 0000000..a458a0e
--- /dev/null
+++ b/hegel/hegel_zoo_compression_test.go
@@ -0,0 +1,1164 @@
+package hegel
+
+// The Compression property: the format record every compression format of the package is
+// drawn as (shared with the Identify property), the case record (the format, the input, the
+// writes it is split into), the replicas of the formats' stream matching (the magic numbers,
+// the zlib header table, the brotli heuristic) and of the third-party decoders the package
+// opens, the documented model with the replicas of the recorded bugs threaded on the switch
+// set (compressionExpected), and the wide property.
+//
+// The model: a Compression's OpenWriter opens a writer for every option the format
+// documents (Gz, Bz2 and Zlib take a CompressionLevel 0..9, Lz4 "the compression level",
+// Brotli a Quality 0..11), the writes and the Close succeed, and the stream written is the
+// format's own: Match reports it by stream (and not by name when no name is given), by name
+// when the name has the format's extension (upper-cased; a nil stream), no other format's
+// Match reports it by stream, Identify names the format, OpenReader decodes it back to the
+// input, and the reference command-line tool decodes it to the input; a gzip stream of two
+// members reads whole, and as its first member under DisableMultistream. Sz and MinLZ write
+// no stream header for an empty input (the README's "Not judged"): their stream match, the
+// Identify answer and the brotli heuristic on the stream are open. The checks: "writer
+// opens" ("ok" or the error kind), "write", "close", "match stream" ("stream": by stream
+// only), "match name" ("name"), "other <ext>" for the nine other compression formats and the
+// archival ones (zip, tar, 7z, rar) ("no"), "identify" (the extension), "reader" ("ok" or
+// the error kind), "tool" ("ok", "tool error", "tool content"; open where the tool is not
+// installed or the format has none), and for Gz "gz members whole" and "gz members first".
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"compress/zlib"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/andybalholm/brotli"
+	"github.com/dsnet/compress/bzip2"
+	"github.com/klauspost/compress/s2"
+	"github.com/klauspost/compress/zstd"
+	"github.com/mholt/archives"
+	fastxz "github.com/mikelolasagasti/xz"
+	"github.com/minio/minlz"
+	"github.com/pierrec/lz4/v4"
+	lzipgo "github.com/sorairolake/lzip-go"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the format record
+
+// compFormat is a compression format of the package with its options: Kind the extension
+// without the dot ("gz", "bz2", "xz", "zst", "lz4", "br", "sz", "lz", "zz", "mz"), Level the
+// CompressionLevel of Gz, Bz2, Lz4 and Zlib (0..9) or the Quality of Brotli (0..11), Multi
+// Gz's Multithreaded.
+type compFormat struct {
+	Kind  string
+	Level int
+	Multi bool
+}
+
+// compKinds is every compression format, in the package's order of registration files.
+var compKinds = []string{"gz", "bz2", "xz", "zst", "lz4", "br", "sz", "lz", "zz", "mz"}
+
+// archKinds is every archival or extraction format Identify tries (zip.go, tar.go, 7z.go,
+// rar.go).
+var archKinds = []string{"zip", "tar", "7z", "rar"}
+
+func (f compFormat) Ext() string { return "." + f.Kind }
+
+// Format is the archives.Compression value of the record.
+func (f compFormat) Format() archives.Compression {
+	switch f.Kind {
+	case "gz":
+		return archives.Gz{CompressionLevel: f.Level, Multithreaded: f.Multi}
+	case "bz2":
+		return archives.Bz2{CompressionLevel: f.Level}
+	case "xz":
+		return archives.Xz{}
+	case "zst":
+		return archives.Zstd{}
+	case "lz4":
+		return archives.Lz4{CompressionLevel: f.Level}
+	case "br":
+		return archives.Brotli{Quality: f.Level}
+	case "sz":
+		return archives.Sz{}
+	case "lz":
+		return archives.Lzip{}
+	case "zz":
+		return archives.Zlib{CompressionLevel: f.Level}
+	case "mz":
+		return archives.MinLZ{}
+	}
+	panic("compFormat: no kind " + f.Kind)
+}
+
+func (f compFormat) String() string {
+	switch f.Kind {
+	case "gz":
+		return fmt.Sprintf("Gz{%d, mt %v}", f.Level, f.Multi)
+	case "bz2":
+		return fmt.Sprintf("Bz2{%d}", f.Level)
+	case "lz4":
+		return fmt.Sprintf("Lz4{%d}", f.Level)
+	case "br":
+		return fmt.Sprintf("Brotli{%d}", f.Level)
+	case "zz":
+		return fmt.Sprintf("Zlib{%d}", f.Level)
+	case "xz":
+		return "Xz{}"
+	case "zst":
+		return "Zstd{}"
+	case "sz":
+		return "Sz{}"
+	case "lz":
+		return "Lzip{}"
+	case "mz":
+		return "MinLZ{}"
+	}
+	return f.Kind
+}
+
+// compFormatsOf is a format: a kind at a tenth each (at one weight each the halving bits
+// realised gz 11 and zst 8 in both properties over two seeds, the others 9 to 11; at the
+// weights below, over four runs of 3000, 9.4 to 10.6 each), Gz's level 0..9 evenly
+// (realised 10 each) and Multithreaded at 30 (realised 31), Bz2's and Zlib's level 0..9,
+// Lz4's level 0 a tenth of the time and 1..9 otherwise when lz4Levels (the shape of
+// archives/10; level 0 alone otherwise), Brotli's quality 0..11 (realised 8 each).
+func compFormatsOf(lz4Levels bool) hegel.Generator[compFormat] {
+	kinds := halvesOver([]int{10, 10, 10, 11, 10, 10, 10, 10, 10, 10}, compKinds...)
+	return hegel.FlatMap(kinds, func(kind string) hegel.Generator[compFormat] {
+		level := hegel.Just(0)
+		switch kind {
+		case "gz", "bz2", "zz":
+			level = rangeHalves(0, 9)
+		case "lz4":
+			level = dieChoice(hzW(1, hegel.Just(0)), hzW(hzUnless(!lz4Levels, 9), rangeHalves(1, 9)))
+		case "br":
+			level = rangeHalves(0, 11)
+		}
+		multi := hegel.Just(false)
+		if kind == "gz" {
+			multi = dieCoin(30)
+		}
+		return hegel.FlatMap(level, func(l int) hegel.Generator[compFormat] {
+			return hegel.Map(multi, func(m bool) compFormat { return compFormat{Kind: kind, Level: l, Multi: m} })
+		})
+	})
+}
+
+// compFormats is the formats of the wide properties: the Lz4 levels 1..9 at weight zero
+// under HEGEL_NO_KNOWN=1.
+var compFormats = compFormatsOf(!hzNoKnown)
+
+// textOf is n bytes of compressible text (fileData's).
+func textOf(n int) []byte { return bytes.Repeat([]byte("the quick brown fox "), n/20+1)[:n] }
+
+// payloadOf is the input of a compression format: fileData's population (a size from the
+// table 60 percent of the time, else 0..3000; compressible text, one byte repeated or random
+// bytes a third each - realised 60; 33/33/34); without the empty input when noEmpty, and
+// without random bytes over 1000 when shortRandom (the stream of random bytes then stays
+// under a kibibyte).
+func payloadOf(noEmpty, shortRandom bool) hegel.Generator[[]byte] {
+	size := payloadSizes
+	if noEmpty {
+		size = payloadSizesNoEmpty
+	}
+	return hegel.FlatMap(size, func(n int) hegel.Generator[[]byte] {
+		random := hzUnless(shortRandom && n > 1000, 1)
+		return halvesGens([]int{1, 1, random},
+			hegel.Just(textOf(n)),
+			hegel.Map(rangeHalves(0, 255), func(b int) []byte { return bytes.Repeat([]byte{byte(b)}, n) }),
+			hegel.Binary(n, n))
+	})
+}
+
+// payloadSizes is the size of an input, with and without 0 (the halving tree over 0..3000 is
+// built once, as fileData's: payloadOf is called inside generators' closures).
+var (
+	payloadSizes        = dieChoice(hzW(60, evenHalves(fileSizes...)), hzW(40, rangeHalves(0, 3000)))
+	payloadSizesNoEmpty = dieChoice(hzW(60, evenHalves(fileSizes[1:]...)), hzW(40, rangeHalves(1, 3000)))
+)
+
+// payloadFor is the input of the format kind in the wide properties: under HEGEL_NO_KNOWN=1
+// Lzip gets no empty input (the shape of archives/24) and Brotli no random bytes over 1000
+// (the shape of archives/25 is a brotli stream over 1 KiB whose first kibibyte does not
+// decode, which random bytes make and text never does).
+func payloadFor(kind string) hegel.Generator[[]byte] {
+	return payloadOf(hzNoKnown && kind == "lz", hzNoKnown && kind == "br")
+}
+
+// payloadKind describes an input for the case's GoString.
+func payloadKind(data []byte) string {
+	if len(data) == 0 {
+		return "empty"
+	}
+	if bytes.Equal(data, textOf(len(data))) {
+		return "text"
+	}
+	if bytes.Count(data, data[:1]) == len(data) {
+		return fmt.Sprintf("byte %#x repeated", data[0])
+	}
+	return "random"
+}
+
+// --------------------------------------------------------------------------- the case record
+
+// compressionCase is one case: the format, the input and the lengths of the writes the input
+// is split into (a partition of the input; none for an empty input, which closes the writer
+// without a Write, as io.Copy does for an empty source).
+type compressionCase struct {
+	Format compFormat
+	Data   []byte
+	Pieces []int
+	notes  []string // what the library left (the explanation of a failure)
+}
+
+func (c compressionCase) GoString() string {
+	s := fmt.Sprintf("compressionCase{%v, %d bytes (%s), written in %d pieces %v}", c.Format, len(c.Data), payloadKind(c.Data), len(c.Pieces), c.Pieces)
+	for _, n := range c.notes {
+		s += "\n  " + n
+	}
+	return s
+}
+
+// pieceLengths is the table a write's length is drawn from; the builder cuts the last piece
+// to the input and adds the remainder, so the realised pieces are a partition of the input.
+var pieceLengths = []int{1, 2, 3, 7, 16, 100, 511, 512, 513, 1024, 2000, 4096}
+
+// piecesDrawn: 0 to 7 lengths of the table, the count drawn evenly (realised 12 each).
+var piecesDrawn = countedHalves(evenHalves(pieceLengths...), 0, 7)
+
+// buildCompressionCase normalises the drawn lengths into a partition of the input: a length
+// beyond the remaining input is cut to it, the lengths after the input is spent are dropped,
+// and the remainder, if any, is a last piece.
+func buildCompressionCase(f compFormat, data []byte, lengths []int) compressionCase {
+	var pieces []int
+	rest := len(data)
+	for _, n := range lengths {
+		if rest == 0 {
+			break
+		}
+		if n > rest {
+			n = rest
+		}
+		pieces = append(pieces, n)
+		rest -= n
+	}
+	if rest > 0 {
+		pieces = append(pieces, rest)
+	}
+	return compressionCase{Format: f, Data: data, Pieces: pieces}
+}
+
+// compressionCases is the cases of the wide property.
+var compressionCases = hegel.FlatMap(compFormats, func(f compFormat) hegel.Generator[compressionCase] {
+	return hegel.FlatMap(payloadFor(f.Kind), func(data []byte) hegel.Generator[compressionCase] {
+		return hegel.Map(piecesDrawn, func(lengths []int) compressionCase { return buildCompressionCase(f, data, lengths) })
+	})
+})
+
+// --------------------------------------------------------------------------- the matching replicas
+
+// The stream matching of every format, transcribed: a fixed magic number compared with the
+// same number of bytes read from the start (gz.go :46-49 two bytes 1f 8b, bz2.go :34-37
+// "BZh", xz.go :33-36 six bytes, zstd.go :35-38 four, lz4.go :34-37 four, sz.go :61-64 ten,
+// lzip.go :32-36 "LZIP", minlz.go :35-38 nine, 7z.go :46-49 six; a shorter stream does not
+// match), the two-byte zlib header table (zlib.go :33-39, :50-73), rar's two magics as
+// prefixes (rar.go :68-78), zip's two headers (zip.go :94-103: the documented rule is either
+// header at the start; under kZipEmptyStreamMatch the second header is read after the first
+// four bytes, archives/9), tar's archive/tar header read (tar.go :66-70) and brotli's
+// decoding heuristic (brotli.go :41-128, brotliMatches).
+var compMagics = map[string][]byte{
+	"gz":  {0x1f, 0x8b},
+	"bz2": []byte("BZh"),
+	"xz":  {0xfd, 0x37, 0x7a, 0x58, 0x5a, 0x00},
+	"zst": {0x28, 0xb5, 0x2f, 0xfd},
+	"lz4": {0x04, 0x22, 0x4d, 0x18},
+	"sz":  {0xff, 0x06, 0x00, 0x00, 0x73, 0x4e, 0x61, 0x50, 0x70, 0x59},
+	"lz":  []byte("LZIP"),
+	"mz":  []byte("\xff\x06\x00\x00MinLz"),
+	"7z":  []byte("7z\xBC\xAF\x27\x1C"),
+}
+
+var zlibHeaders = map[uint16]bool{
+	0x081D: true, 0x085B: true, 0x0899: true, 0x08D7: true,
+	0x1819: true, 0x1857: true, 0x1895: true, 0x18D3: true,
+	0x2815: true, 0x2853: true, 0x2891: true, 0x28CF: true,
+	0x3811: true, 0x384F: true, 0x388D: true, 0x38CB: true,
+	0x480D: true, 0x484B: true, 0x4889: true, 0x48C7: true,
+	0x5809: true, 0x5847: true, 0x5885: true, 0x58C3: true,
+	0x6805: true, 0x6843: true, 0x6881: true, 0x68DE: true,
+	0x7801: true, 0x785E: true, 0x789C: true, 0x78DA: true,
+}
+
+var (
+	rarHeaderV1 = []byte("Rar!\x1a\x07\x00")
+	rarHeaderV5 = []byte("Rar!\x1a\x07\x01\x00")
+	zipHeader   = []byte("PK\x03\x04")
+	zipEmpty    = []byte("PK\x05\x06")
+)
+
+// hasMagic reports whether s starts with the whole magic.
+func hasMagic(s, magic []byte) bool {
+	return len(s) >= len(magic) && bytes.Equal(s[:len(magic)], magic)
+}
+
+// tarByStream is Tar.Match's stream rule: archive/tar reads a first header from the bytes.
+func tarByStream(s []byte) bool {
+	_, err := tar.NewReader(bytes.NewReader(s)).Next()
+	return err == nil
+}
+
+// zipByStream is Zip.Match's stream rule: either header at the start, or, under
+// kZipEmptyStreamMatch, the entry header at the start or the end record after it (zip.go
+// :94-103: readAtMost(stream, 4) once per header, the second read continuing the stream).
+func zipByStream(s []byte, k known) bool {
+	if hasMagic(s, zipHeader) {
+		return true
+	}
+	if k[kZipEmptyStreamMatch] {
+		return len(s) >= 8 && bytes.Equal(s[4:8], zipEmpty)
+	}
+	return hasMagic(s, zipEmpty)
+}
+
+// streamMatches is the stream rule of the format kind (a compression or an archival one) on
+// the bytes: Match(ctx, "", stream).ByStream as transcribed above.
+func streamMatches(kind string, s []byte, k known) bool {
+	switch kind {
+	case "zz":
+		return len(s) >= 2 && zlibHeaders[uint16(s[0])<<8|uint16(s[1])]
+	case "br":
+		return brotliMatches(s, k)
+	case "zip":
+		return zipByStream(s, k)
+	case "tar":
+		return tarByStream(s)
+	case "rar":
+		return hasMagic(s, rarHeaderV1) || hasMagic(s, rarHeaderV5)
+	}
+	return hasMagic(s, compMagics[kind])
+}
+
+// isASCII is brotli.go :139-162.
+func isASCII(data []byte) bool {
+	if len(data) == 0 {
+		return false
+	}
+	for _, b := range data {
+		if !(b >= 9 && b <= 13) && !(b >= 32 && b <= 126) {
+			return false
+		}
+	}
+	return true
+}
+
+// brotliMatches is isValidBrotliStream (brotli.go :41-128), transcribed with the same
+// decoder (github.com/andybalholm/brotli, the one Brotli.OpenReader opens at :169): the
+// first kibibyte at most is decoded up to a kibibyte of output, any decoder error but io.EOF
+// is no match (archives/25 for a stream over 1 KiB cut mid-block), then the input the decoder
+// consumed must match no other format (:82-91), and the stream is brotli when the output is
+// larger than the input (:93-97), ASCII or valid UTF-8 (:99-103), or starts with 0x1b, 0x0b
+// or 0x8b (:109-119).
+func brotliMatches(s []byte, k known) bool {
+	limited := s
+	if len(limited) > 1024 {
+		limited = limited[:1024]
+	}
+	input := &bytes.Buffer{}
+	r := brotli.NewReader(io.TeeReader(bytes.NewReader(limited), input))
+	output := &bytes.Buffer{}
+	buf := make([]byte, len(limited))
+	totalRead := 0
+	for totalRead < 1024 {
+		n, err := r.Read(buf)
+		if err != nil && err != io.EOF {
+			return false
+		}
+		if n == 0 {
+			break
+		}
+		output.Write(buf[:n])
+		totalRead += n
+		if err == io.EOF {
+			break
+		}
+	}
+	inputBytes := input.Bytes()
+	for _, kind := range append(append([]string(nil), archKinds...), compKinds...) {
+		if kind != "br" && streamMatches(kind, inputBytes, k) {
+			return false
+		}
+	}
+	if float64(totalRead)/float64(len(inputBytes)) > 1.0 {
+		return true
+	}
+	if isASCII(output.Bytes()) || utf8.Valid(output.Bytes()) {
+		return true
+	}
+	if len(inputBytes) >= 4 && (inputBytes[0] == 0x1b || inputBytes[0] == 0x0b || inputBytes[0] == 0x8b) {
+		return true
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- the decoders
+
+// decodeOutcome is what the archival matchers see when Identify wraps a stream in a
+// compression's OpenReader (formats.go :126-132): the decoder failed to open ("open": the
+// error is returned as Identify's), its first read failed before the bytes the matcher
+// wanted ("read" with the error and the count read: zip reads four bytes, 7z six, rar eight;
+// a read error of io.EOF or io.ErrUnexpectedEOF is not one, readAtMost :166-170), or the
+// bytes read ("ok"; tar's own reader swallows every error, tar.go :67-69). The lzip reader
+// panics on a short stream ("panic", archives/20).
+type decodeOutcome struct {
+	Kind string
+	Text string
+	N    int
+}
+
+// lzipPanics is the rule of archives/20, measured standalone on every cut of an lzip stream
+// (hz_dump_test.go, part 2): sorairolake/lzip-go v0.3.8's NewReader (reader.go :27) reads the
+// six-byte header and then slices the rest of the member by its twenty-byte trailer, so a
+// stream of six to twenty-one bytes with the "LZIP" magic panics with "slice bounds out of
+// range"; four bytes is "unsupported version number", five "dictionary size is too small",
+// twenty-two and more an lzip error.
+func lzipPanics(s []byte) bool { return hasMagic(s, compMagics["lz"]) && len(s) >= 6 && len(s) <= 21 }
+
+// decodeStep opens the third-party decoder the format's OpenReader opens (gz.go :83
+// compress/gzip for the registered Gz{}, bz2.go :50 dsnet/compress/bzip2, xz.go :47
+// mikelolasagasti/xz, zstd.go :49 klauspost/compress/zstd, lz4.go :56 pierrec/lz4, brotli.go
+// :169 andybalholm/brotli, sz.go :117 klauspost/compress/s2, lzip.go :46 sorairolake/lzip-go,
+// zlib.go :71 compress/zlib, minlz.go :49 minio/minlz; the zero values Identify decodes
+// through) on the bytes and reads eight bytes, the most an archival matcher reads.
+func decodeStep(kind string, s []byte) decodeOutcome {
+	var r io.Reader
+	var err error
+	br := bytes.NewReader(s)
+	switch kind {
+	case "gz":
+		r, err = gzip.NewReader(br)
+	case "bz2":
+		r, err = bzip2.NewReader(br, nil)
+	case "xz":
+		r, err = fastxz.NewReader(br, 0)
+	case "zst":
+		var zr *zstd.Decoder
+		zr, err = zstd.NewReader(br)
+		if err == nil {
+			defer zr.Close()
+			r = zr
+		}
+	case "lz4":
+		r = lz4.NewReader(br)
+	case "br":
+		r = brotli.NewReader(br)
+	case "sz":
+		r = s2.NewReader(br)
+	case "lz":
+		if lzipPanics(s) {
+			return decodeOutcome{Kind: "panic"}
+		}
+		var lr *lzipgo.Reader
+		if p := hzCall(func() { lr, err = lzipgo.NewReader(br) }); p != nil {
+			hzTally("lzip panic outside the rule")
+			return decodeOutcome{Kind: "panic"}
+		}
+		if err == nil {
+			r = lr
+		}
+	case "zz":
+		r, err = zlib.NewReader(br)
+	case "mz":
+		r = minlz.NewReader(br)
+	default:
+		panic("decodeStep: no kind " + kind)
+	}
+	if err != nil {
+		return decodeOutcome{Kind: "open", Text: errKindOfText(err.Error())}
+	}
+	buf := make([]byte, 8)
+	n, rerr := io.ReadFull(r, buf)
+	if rerr == nil || errors.Is(rerr, io.EOF) || errors.Is(rerr, io.ErrUnexpectedEOF) {
+		return decodeOutcome{Kind: "ok", N: n}
+	}
+	return decodeOutcome{Kind: "read", Text: errKindOfText(rerr.Error()), N: n}
+}
+
+// errKindOfText is the kind of a decoder's error the checks compare: "eof" for an end of
+// input (io.EOF, io.ErrUnexpectedEOF), "header" for a magic number or header the decoder
+// rejects (every decoder's wording), "corrupt" for corrupt or truncated data, "brotli" for
+// the brotli decoder's codes, else the text. The texts are the third-party decoders' and
+// vary with how much of a short stream a decoder's first read got (lzipShortStream).
+func errKindOfText(s string) string {
+	switch {
+	case strings.Contains(s, "EOF"):
+		return "eof"
+	case strings.Contains(s, "magic"), strings.Contains(s, "invalid header"), strings.Contains(s, "not recognized"),
+		strings.Contains(s, "unsupported version"), strings.Contains(s, "dictionary size"), strings.Contains(s, "invalid stream"):
+		return "header"
+	case strings.Contains(s, "corrupt"), strings.Contains(s, "truncated"):
+		return "corrupt"
+	case strings.HasPrefix(s, "brotli: "):
+		return "brotli"
+	}
+	return s
+}
+
+// lzipShortStream is the error kind lzip-go's NewReader gives Identify on a stream shorter
+// than its six-byte header: it reads the header with one Read (reader.go :31) and, given
+// the bytes with no error, judges them ("header": "invalid magic number" under four bytes,
+// "unsupported version number" at four, "dictionary size is too small" at five); an empty
+// stream is "eof". A buffered stream (the rewindReader, formats.go :353-393) returns the
+// replayed bytes together with io.EOF, which the single Read reports as is: that is
+// archives/28, the replica in identifyExpected (kIdentifyLzipHeaderSeekability), which
+// identifyOutcomes flags with LzipShort.
+func lzipShortStream(n int) string {
+	if n == 0 {
+		return "eof"
+	}
+	return "header"
+}
+
+// --------------------------------------------------------------------------- the Identify replica
+
+// idStream describes a stream for the Identify replica: the bytes; Own, the compression
+// kind the bytes are a complete stream of ("" for an archive, random bytes, an empty stream
+// or a truncated one, whose bytes are matched as they are); the decoded content under Own
+// (Inner, the payload bytes, with InnerKind "payload"; "tar" for a tar archive with an entry;
+// "emptytar" for one without; "none"); Headerless for the empty Sz, MinLZ and Lzip streams
+// the writers give no header (archives/24 for Lzip).
+type idStream struct {
+	Bytes      []byte
+	Own        string
+	Inner      []byte
+	InnerKind  string
+	Headerless bool
+}
+
+// ownStreamMatches is the documented stream match of a writer's own complete stream (by
+// construction) with the replicas: the headerless Sz and MinLZ streams match nothing (open
+// elsewhere), the headerless Lzip stream does not match under kLzipEmptyStream (lzip.go
+// :32-36 wants "LZIP"), and a brotli stream over 1 KiB is matched by the heuristic under
+// kBrotliMatchTruncated.
+func ownStreamMatches(st idStream, k known) bool {
+	switch st.Own {
+	case "sz", "mz":
+		if st.Headerless {
+			return false
+		}
+	case "lz":
+		if st.Headerless {
+			return !k[kLzipEmptyStream]
+		}
+	case "br":
+		if k[kBrotliMatchTruncated] && len(st.Bytes) > 1024 {
+			return brotliMatches(st.Bytes, k)
+		}
+	}
+	return true
+}
+
+// ownDecodeStep is the decoding of a writer's own complete stream: the decoder reads it
+// (by construction), except the headerless Lzip stream under kLzipEmptyStream and the
+// headerless Sz and MinLZ streams, which the decoders are run on.
+func ownDecodeStep(st idStream, k known) decodeOutcome {
+	if st.Headerless && (st.Own != "lz" || k[kLzipEmptyStream]) {
+		return decodeStep(st.Own, st.Bytes)
+	}
+	return decodeOutcome{Kind: "ok"}
+}
+
+// idOutcome is one answer of Identify: Answer the format's extension, "NoMatch", "error" or
+// "panic"; Err the error's text without its "matching <format>: " prefix ("?" when the
+// decoder's text is not known: the panicking lengths of archives/20 under the documented
+// model); Group the iteration orders that give it (two outcomes of one group are one answer
+// whose value is not known, not two).
+type idOutcome struct {
+	Answer string
+	Err    string
+	Group  int
+}
+
+// idResult is the set of answers of Identify over every iteration order of the formats map.
+type idResult struct {
+	Answers   []string
+	Errs      []string
+	Varies    bool // the answer depends on the formats map's iteration order (archives/19)
+	LzipShort bool // the lzip decoder read a stream of one to five bytes (archives/28)
+}
+
+// nameParts is the name rules of the formats (Match on the lower-cased base name): the
+// compression by the last extension (gz.go :41, bz2.go :29, xz.go :28, zstd.go :30, lz4.go
+// :29, brotli.go :30, sz.go :55-57 with ".s2", lzip.go :27, zlib.go :28, minlz.go :30), zip,
+// 7z and rar by the last extension (zip.go :89, 7z.go :41, rar.go :63), tar by a "tar"
+// component among the dot-separated parts after the first (tar.go :56-63). The documented
+// rule adds archiveExtensions' ".tgz" (fs.go :940-952: a name ending in ".tgz" is a tar.gz
+// archive to PathIsArchive and DeepFS), which no format's Match knows under
+// kIdentifyTgzByName (archives/26).
+func nameParts(base string, k known) (comp string, archs []string) {
+	lower := strings.ToLower(base)
+	ext := ""
+	if i := strings.LastIndexByte(lower, '.'); i >= 0 {
+		ext = lower[i:]
+	}
+	for _, kind := range compKinds {
+		if ext == "."+kind || (kind == "sz" && ext == ".s2") {
+			comp = kind
+		}
+	}
+	switch ext {
+	case ".zip", ".7z", ".rar":
+		archs = append(archs, ext[1:])
+	}
+	parts := strings.Split(lower, ".")
+	for _, p := range parts[1:] {
+		if p == "tar" {
+			archs = append(archs, "tar")
+			break
+		}
+	}
+	if !k[kIdentifyTgzByName] && strings.HasSuffix(lower, ".tgz") {
+		comp, archs = "gz", []string{"tar"}
+	}
+	return comp, archs
+}
+
+// identifyBase is Identify's name (formats.go :45, identifyOne :117-119): the base of the
+// slash-converted name, "" for ".".
+func identifyBase(name string) string {
+	base := path.Base(filepath.ToSlash(name))
+	if base == "." {
+		return ""
+	}
+	return base
+}
+
+// identifyOutcomes transcribes Identify (formats.go :40-111) over every iteration order of
+// the formats map: the first compression format matched by name or stream (:53-70; every
+// candidate comes first in some order), then, with the stream wrapped in that format's
+// decoder (identifyOne :126-132; a decoder that fails to open is Identify's error, :127-130),
+// the first archival format matched by name or stream or whose read of the decoded stream
+// fails (:73-90, zip.go :95-98, 7z.go :46-49, rar.go :68-71; tar.go :66-70 swallows); the
+// answer is the compressed archive, the archive, the compression, or NoMatch (:93-111).
+func identifyOutcomes(name string, st idStream, k known) idResult {
+	base := identifyBase(name)
+	nameComp, nameArchs := nameParts(base, k)
+	byName := func(kind string) bool {
+		for _, a := range nameArchs {
+			if a == kind {
+				return true
+			}
+		}
+		return false
+	}
+	var comps []string
+	for _, kind := range compKinds {
+		matched := kind == nameComp
+		if kind == st.Own {
+			matched = matched || ownStreamMatches(st, k)
+		} else {
+			matched = matched || streamMatches(kind, st.Bytes, k)
+		}
+		if matched {
+			comps = append(comps, kind)
+		}
+	}
+	var outcomes []idOutcome
+	lzipShort := false
+	// every outcome is its own group (an iteration order of its own), except the two
+	// answers of a decoder that is not run (shared < 0 allocates, else shared is used)
+	group := 0
+	groupOf := func(shared int) int {
+		if shared >= 0 {
+			return shared
+		}
+		group++
+		return group
+	}
+	// archival is the archival loop given the chosen compression (or none) and what its
+	// decoder gave: the decoded bytes (nil when a foreign decoder gave garbage) and the
+	// read outcome.
+	archival := func(comp string, decoded []byte, innerTar bool, step decodeOutcome, shared int) {
+		suffix := ""
+		if comp != "" {
+			suffix = "." + comp
+		}
+		var any bool
+		for _, kind := range archKinds {
+			want := map[string]int{"zip": 4, "7z": 6, "rar": 8}[kind]
+			if kind != "tar" && step.Kind == "read" && step.N < want {
+				outcomes = append(outcomes, idOutcome{Answer: "error", Err: step.Text, Group: groupOf(shared)})
+				any = true
+				continue
+			}
+			matched := byName(kind)
+			switch kind {
+			case "tar":
+				matched = matched || innerTar || (decoded != nil && tarByStream(decoded))
+			default:
+				matched = matched || (decoded != nil && streamMatches(kind, decoded, k))
+			}
+			if matched {
+				outcomes = append(outcomes, idOutcome{Answer: "." + kind + suffix, Group: groupOf(shared)})
+				any = true
+			}
+		}
+		if !any {
+			if comp == "" {
+				outcomes = append(outcomes, idOutcome{Answer: "NoMatch", Group: groupOf(shared)})
+			} else {
+				outcomes = append(outcomes, idOutcome{Answer: suffix, Group: groupOf(shared)})
+			}
+		}
+	}
+	if len(comps) == 0 {
+		archival("", st.Bytes, false, decodeOutcome{Kind: "ok"}, -1)
+	}
+	for _, comp := range comps {
+		var step decodeOutcome
+		decoded, innerTar := []byte(nil), false
+		if comp == st.Own {
+			step = ownDecodeStep(st, k)
+			if step.Kind == "ok" {
+				switch st.InnerKind {
+				case "payload":
+					decoded = st.Inner
+				case "tar":
+					innerTar = true
+				}
+			}
+		} else if comp == "lz" && len(st.Bytes) < 6 {
+			outcomes = append(outcomes, idOutcome{Answer: "error", Err: lzipShortStream(len(st.Bytes)), Group: groupOf(-1)})
+			lzipShort = len(st.Bytes) > 0
+			continue
+		} else {
+			step = decodeStep(comp, st.Bytes)
+		}
+		switch step.Kind {
+		case "open":
+			outcomes = append(outcomes, idOutcome{Answer: "error", Err: step.Text, Group: groupOf(-1)})
+		case "panic":
+			if k[kIdentifyLzipTruncatedPanic] {
+				outcomes = append(outcomes, idOutcome{Answer: "panic", Group: groupOf(-1)})
+			} else {
+				// the documented answer where the library panics: the decoder reads
+				// (the archival formats match by name) or fails to open (an error
+				// whose text is not known); one answer, which of the two is open
+				shared := groupOf(-1)
+				archival(comp, nil, false, decodeOutcome{Kind: "ok"}, shared)
+				outcomes = append(outcomes, idOutcome{Answer: "error", Err: "?", Group: shared})
+			}
+		default:
+			archival(comp, decoded, innerTar, step, -1)
+		}
+	}
+	res := idResult{LzipShort: lzipShort}
+	seen := map[string]bool{}
+	groups := map[int]bool{}
+	var answers, errs []string
+	for _, o := range outcomes {
+		key := o.Answer + "|" + o.Err
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		groups[o.Group] = true
+		answers = append(answers, o.Answer)
+		if o.Answer == "error" {
+			errs = append(errs, o.Err)
+		}
+	}
+	res.Answers = uniqueStrings(answers)
+	res.Errs = uniqueStrings(errs)
+	res.Varies = len(groups) > 1
+	return res
+}
+
+func uniqueStrings(xs []string) []string {
+	var out []string
+	seen := map[string]bool{}
+	for _, x := range xs {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func containsString(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+// matchingPrefix is the "matching <format>: " Identify puts before an error (formats.go
+// :61, :82).
+var matchingPrefix = regexp.MustCompile(`^matching [^:]+: `)
+
+func stripMatching(s string) string { return matchingPrefix.ReplaceAllString(s, "") }
+
+// matchingName is the archival format named in that prefix ("" without one).
+func matchingName(s string) string {
+	return strings.TrimSuffix(strings.TrimPrefix(matchingPrefix.FindString(s), "matching "), ": ")
+}
+
+// --------------------------------------------------------------------------- the model
+
+// compressionBuilt is what the property built before the judgement: the writer's errors and
+// the stream, and for Gz the two-member stream.
+type compressionBuilt struct {
+	OpenErr, WriteErr, CloseErr error
+	Stream                      []byte
+	Two                         []byte
+	TwoErr                      error
+}
+
+// hzTools is the reference command-line decompressor of a format, when installed (read once).
+var hzTools = func() map[string][]string {
+	out := map[string][]string{}
+	for kind, cmd := range map[string][]string{
+		"gz": {"gzip", "-dc"}, "bz2": {"bzip2", "-dc"}, "xz": {"xz", "-dc"}, "zst": {"zstd", "-dc"},
+		"lz4": {"lz4", "-dc"}, "br": {"brotli", "-dc"}, "lz": {"lzip", "-dc"},
+	} {
+		if _, err := exec.LookPath(cmd[0]); err == nil {
+			out[kind] = cmd
+		}
+	}
+	return out
+}()
+
+// errKind is the kind of a writer's or reader's error: the text the recorded bugs are keyed
+// on, else the text.
+func errKind(err error) string {
+	s := err.Error()
+	for _, key := range []string{"invalid compression level", "invalid magic number"} {
+		if strings.Contains(s, key) {
+			return key
+		}
+	}
+	return s
+}
+
+// streamOfCompression is the idStream of a compression case's stream.
+func streamOfCompression(c compressionCase, stream []byte) idStream {
+	st := idStream{Bytes: stream, Own: c.Format.Kind, Inner: c.Data, InnerKind: "payload"}
+	switch c.Format.Kind {
+	case "sz", "mz", "lz":
+		st.Headerless = len(c.Data) == 0
+	}
+	return st
+}
+
+// compressionExpected states every value the property checks for the case under the switch
+// set, given the stream the writer produced (the property builds it before the judgement:
+// the brotli heuristic of archives/25 is a function of the bytes, which differ with the
+// writes' split).
+func compressionExpected(c compressionCase, k known, built compressionBuilt) checks {
+	out := checks{}
+	f := c.Format
+	// archives/10: Lz4.OpenWriter (lz4.go :43-48) passes the level as pierrec/lz4's
+	// bit-flag constant, which rejects 1..9
+	if k[kLz4CompressionLevel] && f.Kind == "lz4" && f.Level != 0 {
+		out.set("writer opens", "error: invalid compression level")
+		return out
+	}
+	out.set("writer opens", "ok")
+	out.set("write", "ok")
+	out.set("close", "ok")
+	st := streamOfCompression(c, built.Stream)
+	headerless := st.Headerless && f.Kind != "lz"
+	switch {
+	case headerless:
+		out.unspecified("match stream")
+	case ownStreamMatches(st, k):
+		out.set("match stream", "stream")
+	default:
+		out.set("match stream", "none")
+	}
+	out.set("match name", "name")
+	for _, kind := range append(append([]string(nil), compKinds...), archKinds...) {
+		if kind == f.Kind {
+			continue
+		}
+		switch {
+		case kind == "br" && (headerless || (f.Kind == "lz" && st.Headerless && k[kLzipEmptyStream])):
+			// the heuristic on a stream without a header: open for Sz and MinLZ (not
+			// judged), the heuristic's own verdict on the headerless lzip stream
+			if headerless {
+				out.unspecified("other " + kind)
+			} else if brotliMatches(built.Stream, k) {
+				out.set("other "+kind, "yes")
+			} else {
+				out.set("other "+kind, "no")
+			}
+		default:
+			out.set("other "+kind, "no")
+		}
+	}
+	if headerless {
+		out.unspecified("identify")
+	} else {
+		res := identifyOutcomes("", st, k)
+		out["identify"] = hzSet(res.Answers...)
+	}
+	// archives/24: the lzip-go writer writes the header on the first Write (lzip.go :41),
+	// so a writer closed without one gives a stream its reader rejects
+	if f.Kind == "lz" && st.Headerless && k[kLzipEmptyStream] {
+		out.set("reader", "open error: invalid magic number")
+	} else {
+		out.set("reader", "ok")
+	}
+	if _, ok := hzTools[f.Kind]; !ok {
+		out.unspecified("tool")
+	} else if f.Kind == "lz" && st.Headerless && k[kLzipEmptyStream] {
+		out.set("tool", "tool error")
+	} else {
+		out.set("tool", "ok")
+	}
+	if f.Kind == "gz" {
+		out.set("gz members whole", "ok")
+		out.set("gz members first", "ok")
+	}
+	return out
+}
+
+func init() {
+	for i, name := range []string{"writer opens", "write", "close", "match stream", "match name", "other", "identify", "reader", "tool", "gz members"} {
+		checkRank[name] = 100 + i
+	}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// compressionBuild runs the writer: OpenWriter, the writes in the case's pieces, Close; and
+// for Gz the two-member stream (the input, then "second member").
+func compressionBuild(c compressionCase) compressionBuilt {
+	var b compressionBuilt
+	var buf bytes.Buffer
+	w, err := c.Format.Format().OpenWriter(&buf)
+	if err != nil {
+		b.OpenErr = err
+		return b
+	}
+	rest := c.Data
+	for _, n := range c.Pieces {
+		if _, err := w.Write(rest[:n]); err != nil {
+			b.WriteErr = err
+			break
+		}
+		rest = rest[n:]
+	}
+	b.CloseErr = w.Close()
+	b.Stream = buf.Bytes()
+	if c.Format.Kind == "gz" {
+		var two bytes.Buffer
+		for _, member := range [][]byte{c.Data, []byte("second member")} {
+			w, err := c.Format.Format().OpenWriter(&two)
+			if err != nil {
+				b.TwoErr = err
+				break
+			}
+			if _, err := w.Write(member); err != nil {
+				b.TwoErr = err
+				break
+			}
+			if err := w.Close(); err != nil {
+				b.TwoErr = err
+				break
+			}
+		}
+		b.Two = two.Bytes()
+	}
+	return b
+}
+
+func matchValue(mr archives.MatchResult, err error) string {
+	switch {
+	case err != nil:
+		return "error: " + err.Error()
+	case mr.ByName && mr.ByStream:
+		return "both"
+	case mr.ByName:
+		return "name"
+	case mr.ByStream:
+		return "stream"
+	}
+	return "none"
+}
+
+// formatOfKind is the registered zero value of a format kind.
+func formatOfKind(kind string) archives.Format {
+	switch kind {
+	case "zip":
+		return archives.Zip{}
+	case "tar":
+		return archives.Tar{}
+	case "7z":
+		return archives.SevenZip{}
+	case "rar":
+		return archives.Rar{}
+	}
+	return compFormat{Kind: kind}.Format()
+}
+
+// readBack decodes the stream through the reader and compares it with data.
+func readBack(r io.Reader, data []byte) string {
+	back, err := io.ReadAll(r)
+	if err != nil {
+		return "read error: " + err.Error()
+	}
+	if !bytes.Equal(back, data) {
+		return fmt.Sprintf("content differs: %d bytes back, %d in", len(back), len(data))
+	}
+	return "ok"
+}
+
+// compressionActual asks the library the questions compressionExpected answered.
+func compressionActual(c *compressionCase, built compressionBuilt) checks {
+	out := checks{}
+	if built.OpenErr != nil {
+		out.set("writer opens", "error: "+errKind(built.OpenErr))
+		return out
+	}
+	out.set("writer opens", "ok")
+	if built.WriteErr != nil {
+		out.set("write", "error: "+built.WriteErr.Error())
+	} else {
+		out.set("write", "ok")
+	}
+	if built.CloseErr != nil {
+		out.set("close", "error: "+built.CloseErr.Error())
+	} else {
+		out.set("close", "ok")
+	}
+	ctx := context.Background()
+	format := c.Format.Format()
+	stream := built.Stream
+	c.notes = append(c.notes, fmt.Sprintf("stream of %d bytes: % x", len(stream), headOf(stream, 16)))
+	out.set("match stream", matchValue(format.Match(ctx, "", bytes.NewReader(stream))))
+	out.set("match name", matchValue(format.Match(ctx, "x"+strings.ToUpper(c.Format.Ext()), nil)))
+	for _, kind := range append(append([]string(nil), compKinds...), archKinds...) {
+		if kind == c.Format.Kind {
+			continue
+		}
+		mr, err := formatOfKind(kind).Match(ctx, "", bytes.NewReader(stream))
+		switch {
+		case err != nil:
+			out.set("other "+kind, "error: "+err.Error())
+		case mr.ByStream:
+			out.set("other "+kind, "yes")
+		default:
+			out.set("other "+kind, "no")
+		}
+	}
+	var f archives.Format
+	var err error
+	if p := hzCall(func() { f, _, err = archives.Identify(ctx, "", bytes.NewReader(stream)) }); p != nil {
+		out.set("identify", "panic")
+		c.notes = append(c.notes, fmt.Sprintf("Identify panicked: %v", p))
+	} else {
+		switch {
+		case errors.Is(err, archives.NoMatch):
+			out.set("identify", "NoMatch")
+		case err != nil:
+			out.set("identify", "error")
+			c.notes = append(c.notes, "Identify: "+err.Error())
+		default:
+			out.set("identify", f.Extension())
+		}
+	}
+	r, err := format.OpenReader(bytes.NewReader(stream))
+	if err != nil {
+		out.set("reader", "open error: "+errKind(err))
+	} else {
+		out.set("reader", readBack(r, c.Data))
+		r.Close()
+	}
+	if cmd, ok := hzTools[c.Format.Kind]; ok {
+		ec := exec.Command(cmd[0], cmd[1:]...)
+		ec.Stdin = bytes.NewReader(stream)
+		var stderr bytes.Buffer
+		ec.Stderr = &stderr
+		ref, err := ec.Output()
+		switch {
+		case err != nil:
+			out.set("tool", "tool error")
+			c.notes = append(c.notes, fmt.Sprintf("%s: %v: %s", strings.Join(cmd, " "), err, strings.TrimSpace(string(headOf([]byte(stderr.String()), 300)))))
+		case !bytes.Equal(ref, c.Data):
+			out.set("tool", "tool content")
+			c.notes = append(c.notes, fmt.Sprintf("%s gives %d bytes, %d in", strings.Join(cmd, " "), len(ref), len(c.Data)))
+		default:
+			out.set("tool", "ok")
+		}
+	}
+	if c.Format.Kind == "gz" {
+		if built.TwoErr != nil {
+			out.set("gz members whole", "members not written: "+built.TwoErr.Error())
+			out.set("gz members first", "members not written: "+built.TwoErr.Error())
+			return out
+		}
+		for _, name := range []string{"gz members whole", "gz members first"} {
+			g := format.(archives.Gz)
+			want := append(append([]byte(nil), c.Data...), []byte("second member")...)
+			if name == "gz members first" {
+				g.DisableMultistream = true
+				want = c.Data
+			}
+			r, err := g.OpenReader(bytes.NewReader(built.Two))
+			if err != nil {
+				out.set(name, "open error: "+err.Error())
+				continue
+			}
+			out.set(name, readBack(r, want))
+			r.Close()
+		}
+	}
+	return out
+}
+
+func headOf[T ~[]byte](b T, n int) T {
+	if len(b) > n {
+		return b[:n]
+	}
+	return b
+}
+
+// --------------------------------------------------------------------------- the property
+
+// compressionJudge builds the stream (the writer is the case's construction and the subject
+// at once: its errors are the first checks) and judges the case by compressionExpected over
+// it; the narrow properties of archives/10, 24 and 25 share it.
+func compressionJudge(j *hzCaseJudge, c compressionCase) {
+	hzTally("format " + c.Format.Kind)
+	hzTally("input " + payloadKind(c.Data))
+	built := compressionBuild(c)
+	expected := func(c compressionCase, k known) checks { return compressionExpected(c, k, built) }
+	actual := func(c *compressionCase) checks { return compressionActual(c, built) }
+	judgeBy(j, &c, expected, actual)
+}
+
+// TestHegelCompression: every compression format's writer produces a stream its own reader
+// decodes to the input, its Match recognises by content (and by name), no other format's
+// Match claims, Identify names, and the reference command-line tool decodes; a gzip stream of
+// several members reads whole unless DisableMultistream is set. The shapes of the recorded
+// bugs (an Lz4 level, an empty Lzip input, a long brotli stream of random bytes) are drawn at
+// their natural rates and fail naming the bug; under HEGEL_NO_KNOWN=1 they are not drawn, and
+// a case the classifier still names is skipped by the judge.
+func TestHegelCompression(t *testing.T) {
+	judged(t, compressionCases, compressionJudge)
+}
diff --git a/hegel/hegel_zoo_deep_test.go b/hegel/hegel_zoo_deep_test.go
new file mode 100644
index 0000000..3bade0b
--- /dev/null
+++ b/hegel/hegel_zoo_deep_test.go
@@ -0,0 +1,551 @@
+package hegel
+
+// The DeepFS property: the case records (a disk tree, the archives written into it with their
+// inner trees, a made-up lexical path), their generators, the documented model of the walk,
+// the reads and stats and the two lexical functions with the replicas of the recorded bugs
+// threaded on the switch set (deepExpected), and the wide property.
+//
+// The model: DeepFS's doc comment (fs.go :735-764): "a file system that treats archives as
+// directories", "the archive file is treated as a directory and its contents are listed as if
+// they were in a subdirectory", by file extension alone, archives within archives not
+// supported; its ReadDir (:806-810) marks "any entries that appear by their file extension to
+// be archive files" as directories so that fs.WalkDir walks into them. So the walk over
+// DeepFS{Root} visits every entry of the disk tree (a link is a link: not followed, not a
+// directory) and every archive as a directory holding its entries, and every file, on disk or
+// inside an archive, opens and stats as itself. SplitPath (:858-868): "the split point is the
+// first extension of an archive filetype like .zip or .tar.gz that occurs in the path", the
+// real path cleaned, the inner path "." for "precisely an archive file"; PathIsArchive (:954)
+// and PathContainsArchive (:970-974) are "solely by lexical analysis", the one for whether
+// the path ends with an archive, the other for whether it "traverses into" one: a segment
+// that PathIsArchive accepts (lower-cased, as PathIsArchive does; a trailing space trimmed,
+// as SplitPath does). The checks: "walk" (the sorted paths the walk visits, each with its
+// IsDir, or the walk's error), "read <p>" (the size and content hash of a file, or the error
+// kind), "stat <p>" (the size of a file, or the error kind), "split <path>" (the real and
+// inner paths) and "contains <path>" (true or false) per lexical path.
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+
+	"github.com/mholt/archives"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the records
+
+// deepArchive is one archive written into the tree: its path on disk (slash-separated,
+// relative to the root), the extension it was drawn with (lower case; Path's name may be
+// upper-cased) and the inner tree it holds (never empty: the builder puts the file "only" in
+// an empty one, since an empty tar is not identified as one).
+type deepArchive struct {
+	Path  string
+	Ext   string
+	Inner []fileEntry
+}
+
+// deepCase is one case: the disk tree (files and links named like archives renamed with a
+// "_" suffix by the builder, directories named like archives kept - the shape of
+// archives/23 - unless HEGEL_NO_KNOWN=1 renames them too), the archives, and the made-up
+// lexical path; the lexical paths of the case are lexicalPaths(c). Lower is the strict pool
+// of the narrow properties of archives/22 and 23: the archive names lower-cased and no
+// upper-cased lexical form, so that archives/21 is not named first.
+type deepCase struct {
+	Tree     []fileEntry
+	Archives []deepArchive
+	MadeUp   string
+	Lower    bool
+}
+
+func (c deepCase) GoString() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "deepCase{made-up path %q, lower %v}\n%s", c.MadeUp, c.Lower, treeString(c.Tree))
+	for _, a := range c.Archives {
+		fmt.Fprintf(&b, "  archive %q (%s):\n", a.Path, a.Ext)
+		for _, line := range strings.Split(strings.TrimRight(treeString(a.Inner), "\n"), "\n") {
+			b.WriteString("  " + line + "\n")
+		}
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- the generators
+
+// hzArchiveExts is every archive extension DeepFS recognises that the package writes (its
+// archiveExtensions, fs.go :940-952, less ".tar.s2", which no format of the package writes).
+var hzArchiveExts = []string{".zip", ".tar", ".tgz", ".tar.gz", ".tar.bz2", ".tar.zst", ".tar.lz4", ".tar.xz", ".tar.sz", ".tar.lz"}
+
+// hzFormatForExt is the format that writes an archive with that extension.
+func hzFormatForExt(ext string) archives.Format {
+	switch ext {
+	case ".zip":
+		return archives.Zip{}
+	case ".tar":
+		return archives.Tar{}
+	}
+	var comp archives.Compression
+	switch ext {
+	case ".tgz", ".tar.gz":
+		comp = archives.Gz{}
+	case ".tar.bz2":
+		comp = archives.Bz2{}
+	case ".tar.zst":
+		comp = archives.Zstd{}
+	case ".tar.lz4":
+		comp = archives.Lz4{}
+	case ".tar.xz":
+		comp = archives.Xz{}
+	case ".tar.sz":
+		comp = archives.Sz{}
+	case ".tar.lz":
+		comp = archives.Lzip{}
+	}
+	return archives.CompressedArchive{Archival: archives.Tar{}, Extraction: archives.Tar{}, Compression: comp}
+}
+
+// madeUpPaths is the made-up lexical path: one of nine evenly (realised 10-12 each); at
+// weight zero under HEGEL_NO_KNOWN=1 "a.ZIP/x" (an upper-cased extension, the shape of
+// archives/21) and ".zip" (a first segment that is an extension alone, the shape of
+// archives/22).
+var madeUpPaths = halvesOver([]int{1, hzUnless(hzNoKnown, 1), 1, 1, 1, 1, 1, hzUnless(hzNoKnown, 1), 1},
+	"a.zip/b.tar/c", "a.ZIP/x", "a.tar.gz", "a.tgz/", "/a/b.tar.zst/c/d", "x.zip /y", "a.tar.gzip", ".zip", "a/.tar/b")
+
+// archiveAmong is one archive among the directories of the tree: in the root or, when there
+// is a directory, in one at 50 (realised 50), a name of arc/ARC/a b/x.y with an extension of
+// hzArchiveExts, upper-cased at 20 (realised 20; weight zero under HEGEL_NO_KNOWN=1, where an
+// upper-cased extension is the shape of archives/21 on every lexical path through it), and
+// an inner tree of up to 5 entries. Path is the archive's path before the builder's renames
+// (the directory as drawn).
+func archiveAmong(dirs []string) hegel.Generator[deepArchive] {
+	dir := hegel.Just("")
+	if len(dirs) > 0 {
+		dir = dieChoice(hzW(50, hegel.Just("")), hzW(50, evenHalves(dirs...)))
+	}
+	return archiveAt(dir)
+}
+
+// archiveAt is an archive in the directory drawn by dir.
+func archiveAt(dir hegel.Generator[string]) hegel.Generator[deepArchive] {
+	return hegel.FlatMap(dir, func(d string) hegel.Generator[deepArchive] {
+		return hegel.FlatMap(evenHalves("arc", "ARC", "a b", "x.y"), func(stem string) hegel.Generator[deepArchive] {
+			return hegel.FlatMap(evenHalves(hzArchiveExts...), func(ext string) hegel.Generator[deepArchive] {
+				return hegel.FlatMap(dieCoin(hzUnless(hzNoKnown, 20)), func(upper bool) hegel.Generator[deepArchive] {
+					name := stem + ext
+					if upper {
+						name = strings.ToUpper(name)
+					}
+					p := name
+					if d != "" {
+						p = d + "/" + name
+					}
+					return hegel.Map(treesOf(5), func(inner []fileEntry) deepArchive { return deepArchive{Path: p, Ext: ext, Inner: inner} })
+				})
+			})
+		})
+	})
+}
+
+// buildDeepCase renames the tree's files and links named like archives (DeepFS treats them
+// as archives by its documentation: not judged) and, under HEGEL_NO_KNOWN=1, its directories
+// named like archives (the shape of archives/23, otherwise kept), composing along the path;
+// makes every directory writable (DeepFS opens them); moves the archives into the renamed
+// directories, dropping one whose path is taken (lower-casing their names for the strict
+// pool); and fills an empty inner tree.
+func buildDeepCase(tree []fileEntry, archs []deepArchive, madeUp string, lower bool) deepCase {
+	renamed := map[string]string{}
+	out := make([]fileEntry, 0, len(tree))
+	for _, e := range tree {
+		p := path.Base(e.Path)
+		if parent := path.Dir(e.Path); parent != "." {
+			p = renamed[parent] + "/" + p
+		}
+		if archives.PathIsArchive(p) && (e.Kind != 'd' || hzNoKnown) {
+			p += "_"
+		}
+		renamed[e.Path] = p
+		e.Path = p
+		if e.Kind == 'd' {
+			e.Mode |= 0o700
+		}
+		out = append(out, e)
+	}
+	taken := map[string]bool{}
+	for _, e := range out {
+		taken[e.Path] = true
+	}
+	var as []deepArchive
+	for _, a := range archs {
+		p := path.Base(a.Path)
+		if lower {
+			p = strings.ToLower(p)
+		}
+		if parent := path.Dir(a.Path); parent != "." {
+			p = renamed[parent] + "/" + p
+		}
+		if taken[p] {
+			continue
+		}
+		taken[p] = true
+		a.Path = p
+		if len(a.Inner) == 0 {
+			a.Inner = []fileEntry{{Path: "only", Kind: 'f', Data: []byte("x"), Mode: 0o644}}
+		}
+		as = append(as, a)
+	}
+	return deepCase{Tree: out, Archives: as, MadeUp: madeUp, Lower: lower}
+}
+
+// deepCasesWith is a case over the trees: up to 3 archives, the count drawn evenly (realised
+// 25 each), and a made-up path of madeUp; lower for the strict pool.
+func deepCasesWith(trees hegel.Generator[[]fileEntry], madeUp hegel.Generator[string], lower bool) hegel.Generator[deepCase] {
+	return hegel.FlatMap(trees, func(tree []fileEntry) hegel.Generator[deepCase] {
+		return hegel.FlatMap(countedHalves(archiveAmong(dirsOf(tree)), 0, 3), func(archs []deepArchive) hegel.Generator[deepCase] {
+			return hegel.Map(madeUp, func(m string) deepCase { return buildDeepCase(tree, archs, m, lower) })
+		})
+	})
+}
+
+var deepCases = deepCasesWith(treesOf(6), madeUpPaths, false)
+
+// --------------------------------------------------------------------------- the model
+
+// modelPaths is every path the walk visits, with its kind: the tree's entries, the archives
+// (as directories) and their inner entries.
+func modelPaths(c deepCase) map[string]byte {
+	m := map[string]byte{}
+	for _, e := range c.Tree {
+		m[e.Path] = e.Kind
+	}
+	for _, a := range c.Archives {
+		m[a.Path] = 'd'
+		for _, e := range a.Inner {
+			m[a.Path+"/"+e.Path] = e.Kind
+		}
+	}
+	return m
+}
+
+// lexicalPaths is the lexical paths of a case: every model path with its "/"-prefixed,
+// "/"-suffixed and (not under HEGEL_NO_KNOWN=1 or in the strict pool, since an upper-cased
+// archive extension is the shape of archives/21) upper-cased forms, and the made-up path.
+func lexicalPaths(c deepCase) []string {
+	var ps []string
+	for p := range modelPaths(c) {
+		ps = append(ps, p, "/"+p, p+"/")
+		if !hzNoKnown && !c.Lower {
+			ps = append(ps, strings.ToUpper(p))
+		}
+	}
+	ps = append(ps, c.MadeUp)
+	sort.Strings(ps)
+	return ps
+}
+
+// inArchiveNamedDir reports whether a directory above p is named like an archive (the
+// region of archives/23).
+func inArchiveNamedDir(c deepCase, p string) bool {
+	for dir := path.Dir(p); dir != "."; dir = path.Dir(dir) {
+		if e := entryAt(c.Tree, dir); e != nil && e.Kind == 'd' && archives.PathIsArchive(dir) {
+			return true
+		}
+	}
+	return false
+}
+
+// splitDocumented is SplitPath as documented: the first segment that is an archive (lower-
+// cased, a trailing space trimmed) ends the real path; the inner path is the rest, "." for a
+// path that is precisely an archive.
+func splitDocumented(p string) (string, string) {
+	segs := strings.Split(p, "/")
+	for i, s := range segs {
+		if archives.PathIsArchive(strings.TrimRight(strings.ToLower(s), " ")) {
+			real := filepath.Clean(filepath.FromSlash(strings.Join(segs[:i+1], "/")))
+			inner := strings.Join(segs[i+1:], "/")
+			if inner == "" && i == len(segs)-1 {
+				inner = "."
+			}
+			return real, inner
+		}
+	}
+	return filepath.Clean(filepath.FromSlash(p)), ""
+}
+
+// splitScanned is SplitPath's own scan, fs.go :869-918 transcribed (archives/22): the scan
+// starts at index 1, so the first character of a relative path's first segment is never
+// examined.
+func splitScanned(p string) (realPath, innerPath string) {
+	if len(p) < 2 {
+		return p, ""
+	}
+	start, end := 1, strings.Index(p[1:], "/")+1
+	if end-start < 0 {
+		end = len(p)
+	}
+	for {
+		part := strings.TrimRight(strings.ToLower(p[start:end]), " ")
+		if archives.PathIsArchive(part) {
+			realPath = filepath.Clean(filepath.FromSlash(p[:end]))
+			if end < len(p) {
+				innerPath = p[end+1:]
+			} else {
+				innerPath = "."
+			}
+			return
+		}
+		start = end + 1
+		if start > len(p) {
+			break
+		}
+		end = strings.Index(p[start:], "/") + start
+		if end-start < 0 {
+			end = len(p)
+		}
+	}
+	return filepath.Clean(filepath.FromSlash(p)), ""
+}
+
+// containsDocumented is PathContainsArchive as documented: a segment of the path is an
+// archive by PathIsArchive.
+func containsDocumented(p string) bool {
+	for _, s := range strings.Split(p, "/") {
+		if archives.PathIsArchive(s) {
+			return true
+		}
+	}
+	return false
+}
+
+// containsAsWritten is PathContainsArchive's own test, fs.go :975-983 transcribed
+// (archives/21): the extensions against the path as given, case-sensitively.
+func containsAsWritten(p string) bool {
+	all := append(append([]string(nil), hzArchiveExts...), ".tar.s2")
+	for _, ext := range all {
+		if strings.Contains(p+"/", ext+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+func fileValue(data []byte) string {
+	sum := sha256.Sum256(data)
+	return fmt.Sprintf("size=%d sha=%s", len(data), hex.EncodeToString(sum[:4]))
+}
+
+// deepExpected states every value the property checks.
+func deepExpected(c deepCase, k known) checks {
+	out := checks{}
+	paths := modelPaths(c)
+	// archives/23: an archive below a directory named like one is read through a DirFS
+	// (getInnerFsys, fs.go :839-856, FileSystem :47-71), whose ReadDir (:223-228) does not
+	// mark it as a directory (DeepFS.ReadDir :828-832 does): the walk takes it for a file,
+	// its entries are absent, and a path into it opens through the DirFS as a path through
+	// a file (ENOTDIR)
+	flat := map[string]bool{}
+	if k[kDeepFSDirNamedArchive] {
+		for _, a := range c.Archives {
+			if inArchiveNamedDir(c, a.Path) {
+				flat[a.Path] = true
+			}
+		}
+	}
+	var lines []string
+	for p, kind := range paths {
+		under := ""
+		for f := range flat {
+			if strings.HasPrefix(p, f+"/") {
+				under = f
+			}
+		}
+		if under != "" {
+			continue
+		}
+		isDir := kind == 'd'
+		if flat[p] {
+			isDir = false
+		}
+		lines = append(lines, fmt.Sprintf("%v %s", isDir, p))
+	}
+	sort.Strings(lines)
+	out.set("walk", strings.Join(lines, "\n"))
+	for _, e := range c.Tree {
+		if e.Kind == 'f' {
+			out.set("read "+e.Path, fileValue(e.Data))
+			out.set("stat "+e.Path, "file size="+strconv.Itoa(len(e.Data)))
+		}
+	}
+	for _, a := range c.Archives {
+		for _, e := range a.Inner {
+			if e.Kind != 'f' {
+				continue
+			}
+			p := a.Path + "/" + e.Path
+			if flat[a.Path] {
+				out.set("read "+p, "error: notdir")
+				out.set("stat "+p, "error: notdir")
+				continue
+			}
+			out.set("read "+p, fileValue(e.Data))
+			out.set("stat "+p, "file size="+strconv.Itoa(len(e.Data)))
+		}
+	}
+	for _, p := range lexicalPaths(c) {
+		real, inner := splitDocumented(p)
+		if k[kSplitPathFirstSegment] {
+			real, inner = splitScanned(p)
+		}
+		out.set("split "+p, fmt.Sprintf("%q %q", real, inner))
+		contains := containsDocumented(p)
+		if k[kPathContainsArchiveCase] {
+			contains = containsAsWritten(p)
+		}
+		out.set("contains "+p, contains)
+	}
+	return out
+}
+
+func init() {
+	for i, name := range []string{"walk", "read", "stat", "split", "contains"} {
+		checkRank[name] = 10 + i
+	}
+}
+
+// --------------------------------------------------------------------------- the library
+
+// deepErrKind is the kind of an error of DeepFS: "notexist", "notdir", "invalid", else the
+// text.
+func deepErrKind(err error) string {
+	switch {
+	case errors.Is(err, fs.ErrNotExist):
+		return "notexist"
+	case errors.Is(err, syscall.ENOTDIR):
+		return "notdir"
+	case errors.Is(err, fs.ErrInvalid):
+		return "invalid"
+	}
+	return err.Error()
+}
+
+// writeArchives writes the case's archives under dir: the bytes are the package's own
+// Archive of FilesFromFS over the inner tree (the archive writer, not the subject).
+func writeArchives(c deepCase, dir string) error {
+	for _, a := range c.Archives {
+		files, err := archives.FilesFromFS(context.Background(), treeMapFS(a.Inner), nil, nil)
+		if err != nil {
+			return fmt.Errorf("FilesFromFS of the inner tree of %s: %w", a.Path, err)
+		}
+		var buf bytes.Buffer
+		if err := hzFormatForExt(a.Ext).(archives.Archiver).Archive(context.Background(), &buf, files); err != nil {
+			return fmt.Errorf("Archive of %s: %w", a.Path, err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, filepath.FromSlash(a.Path)), buf.Bytes(), 0o644); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// deepActual asks DeepFS{Root: dir} the questions deepExpected answered.
+func deepActual(c deepCase, dir string) checks {
+	out := checks{}
+	dfs := &archives.DeepFS{Root: dir}
+	var lines []string
+	err := fs.WalkDir(dfs, ".", func(p string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return fmt.Errorf("at %q: %w", p, err)
+		}
+		if p != "." {
+			lines = append(lines, fmt.Sprintf("%v %s", d.IsDir(), p))
+		}
+		return nil
+	})
+	if err != nil {
+		out.set("walk", "error: "+err.Error())
+	} else {
+		sort.Strings(lines)
+		out.set("walk", strings.Join(lines, "\n"))
+	}
+	ask := func(p string) {
+		if data, err := fs.ReadFile(dfs, p); err != nil {
+			out.set("read "+p, "error: "+deepErrKind(err))
+		} else {
+			out.set("read "+p, fileValue(data))
+		}
+		if info, err := fs.Stat(dfs, p); err != nil {
+			out.set("stat "+p, "error: "+deepErrKind(err))
+		} else if info.IsDir() {
+			out.set("stat "+p, "dir")
+		} else {
+			out.set("stat "+p, "file size="+strconv.FormatInt(info.Size(), 10))
+		}
+	}
+	for _, e := range c.Tree {
+		if e.Kind == 'f' {
+			ask(e.Path)
+		}
+	}
+	for _, a := range c.Archives {
+		for _, e := range a.Inner {
+			if e.Kind == 'f' {
+				ask(a.Path + "/" + e.Path)
+			}
+		}
+	}
+	for _, p := range lexicalPaths(c) {
+		real, inner := dfs.SplitPath(p)
+		out.set("split "+p, fmt.Sprintf("%q %q", real, inner))
+		out.set("contains "+p, archives.PathContainsArchive(p))
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- the property
+
+// deepJudgeWith is the judge of the family: the tree and the archives written under a fresh
+// directory of root, then judgeBy over deepExpected and deepActual. The narrow properties
+// share it.
+func deepJudgeWith(root string) func(j *hzCaseJudge, c deepCase) {
+	n := 0
+	return func(j *hzCaseJudge, c deepCase) {
+		n++
+		dir := filepath.Join(root, "t"+strconv.Itoa(n))
+		if err := os.Mkdir(dir, 0o700); err != nil {
+			panic(err)
+		}
+		defer func() { restoreDisk(dir); os.RemoveAll(dir) }()
+		if err := treeToDisk(c.Tree, dir); err != nil {
+			panic(fmt.Sprintf("writing the tree: %v", err))
+		}
+		if err := writeArchives(c, dir); err != nil {
+			j.Fail("writer", "%v for\n%#v", err, c)
+			return
+		}
+		judgeBy(j, &c, deepExpected, func(c *deepCase) checks { return deepActual(*c, dir) })
+	}
+}
+
+// wideDeepCases is the cases of the wide property: under HEGEL_NO_KNOWN=1 the three shapes
+// are off by weight (the upper-cased forms and names, the ".zip" made-up path) and by the
+// builder's renaming; withoutShapes is the backstop (counted "filtered archives/N").
+var wideDeepCases = withoutShapes(deepExpected, deepCases)
+
+// TestHegelDeepFS: a directory on disk holding files, directories, links and archives written
+// by the package (every archive extension DeepFS recognises) walks, through DeepFS, as the
+// disk tree with every archive replaced by a directory of its entries; the files inside read
+// and stat as their contents. SplitPath splits at the first archive extension;
+// PathContainsArchive agrees with PathIsArchive on the path's segments.
+func TestHegelDeepFS(t *testing.T) {
+	judged(t, wideDeepCases, deepJudgeWith(filesRoot(t)))
+}
diff --git a/hegel/hegel_zoo_files_test.go b/hegel/hegel_zoo_files_test.go
new file mode 100644
index 0000000..e8b2985
