+// --------------------------------------------------------------------------- archives/27
+
+// pastFollowOnFS is the model without the checks archives/17 and 18 change on their own: the
+// fs side's resolution and expansion of a followed link. On the fs side every link to an
+// ancestor is also the shape of 18 (its directory looked up inside fs.Sub of itself, by the
+// documented resolution of "."), so the wide property names 18 (or 17) for such a case; the
+// narrow property of 27 is judged on what is left: whether each side returns, and the disk
+// side.
+var pastFollowOnFS = pastSwitches(filesExpectedAt, []int{kFsFollowSymlinkRelative, kFsFollowDirLink})
+
+// ancestorLinkCases: FollowSymlinks on, a link in a directory to "." - its own directory,
+// an ancestor of itself (past the shape, to a file beside it); the key the root or that
+// directory; the tree without any other link (a loop through a link to a link is the same
+// shape, a link to a directory is 18). Only the "." target is the region: ".." and a path to
+// an ancestor are archives/17 on the fs side (the target as written is invalid or resolved
+// from the root) and named first even past the fs checks of 17 (the disk side differs too).
+var ancestorLinkCases = regionOf("archives/27", pastFollowOnFS, hegel.FlatMap(hegel.FlatMap(fileTrees, aDirIn), func(tree []fileEntry) hegel.Generator[filesCase] {
+	tree = withoutLinks(tree, true)
+	return hegel.FlatMap(evenHalves(dirsOf(tree)...), func(d string) hegel.Generator[filesCase] {
+		return hegel.FlatMap(entryName, func(linkName string) hegel.Generator[filesCase] {
+			return hegel.FlatMap(entryName, func(sibling string) hegel.Generator[filesCase] {
+				sibling = freshName(tree, d, sibling, linkName)
+				link := fileEntry{Path: d + "/" + linkName, Kind: 'l', Link: hzShaped(".", sibling), Mode: 0o777, Fallback: "nowhere"}
+				filled := hegel.Just(tree)
+				if hzNoKnown {
+					filled = hegel.Map(aFile(d+"/"+sibling), func(f fileEntry) []fileEntry { return withEntry(tree, f) })
+				}
+				return hegel.FlatMap(filled, func(tree []fileEntry) hegel.Generator[filesCase] {
+					return hegel.FlatMap(evenHalves(".", d), func(key string) hegel.Generator[filesCase] {
+						return caseOf(withEntry(tree, link), key, plainValues, hegel.Just(true))
+					})
+				})
+			})
+		})
+	})
+}))
