+// --------------------------------------------------------------------------- archives/20
+
+// truncatedLzipCases: an Lzip stream of a non-empty input (24 out of the pool) cut to 6..12
+// bytes, under a plain name six times in seven or its own (x.lz). Past the shape the cut is
+// 0..3 under a plain name: a cut of 4 or 5 bytes carries the magic and the reader's first
+// read fails with one of two errors by the stream's seekability (archives/28, named 19
+// first by the archival name in the error), and so does a shorter cut named x.lz.
+var truncatedLzipCases = hegel.FlatMap(payloadOf(true, false), func(p []byte) hegel.Generator[identifyCase] {
+	return hegel.FlatMap(hzShaped(rangeHalves(6, 12), rangeHalves(0, 3)), func(cut int) hegel.Generator[identifyCase] {
+		ct := identifyContent{Kind: "truncated", Comp: compFormat{Kind: "lz"}, Payload: p, Cut: cut}
+		return hegel.Map(halvesGens([]int{6, hzUnless(hzNoKnown, 1)}, plainNames, hegel.Just("x.lz")), func(name string) identifyCase {
+			return identifyCase{Content: ct, Name: name}
+		})
+	})
+})
+
+// TestHegelTruncatedLzipStreamsDoNotPanic: Identify on an lzip stream cut short returns an
+// answer or an error and the stream whole; archives/20 panics (slice bounds) in the lzip
+// reader it opens to look for an archive inside.
+func TestHegelTruncatedLzipStreamsDoNotPanic(t *testing.T) {
+	judged(t, truncatedLzipCases, identifyJudgeWith(3))
+}
+
+// --------------------------------------------------------------------------- archives/24
+
+// emptyLzipCases: Lzip with an empty input (one byte past the shape), the writes drawn as in
+// the wide property (none for the empty input). Nothing earlier reaches Lzip's writer.
+var emptyLzipCases = hegel.FlatMap(hegel.Just(hzShaped([]byte(nil), []byte("x"))), func(data []byte) hegel.Generator[compressionCase] {
+	return hegel.Map(piecesDrawn, func(lengths []int) compressionCase {
+		return buildCompressionCase(compFormat{Kind: "lz"}, data, lengths)
+	})
+})
+
+// TestHegelEmptyLzipStreamsRead: Lzip's writer closed without a Write (io.Copy of an empty
+// source) gives a stream Lzip's reader, Match and the lzip tool accept, as every other
+// format's does; archives/24 writes the header on the first Write only.
+func TestHegelEmptyLzipStreamsRead(t *testing.T) {
+	judged(t, emptyLzipCases, compressionJudge)
+}
+
+// --------------------------------------------------------------------------- archives/25
+
+// incompressible is the bytes XOR a fixed keystream (splitmix64 from a constant seed: a pure
+// map of the drawn bytes, nothing shared): hegel.Binary's bytes compress a little, enough
+// for the first kibibyte of a brotli stream of them to decode to its end one time in four,
+// which is the region past archives/25; the keystream leaves nothing to compress. The
+// shrunk bytes (zeros) map to the keystream itself.
+func incompressible(b []byte) []byte {
+	out := make([]byte, len(b))
+	var x, word uint64
+	for i := range b {
+		if i%8 == 0 {
+			x += 0x9e3779b97f4a7c15
+			z := x
+			z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
+			z = (z ^ (z >> 27)) * 0x94d049bb133111eb
+			word = z ^ (z >> 31)
+		}
+		out[i] = b[i] ^ byte(word>>(8*(i%8)))
+	}
+	return out
+}
+
+// longBrotliCases: Brotli at every quality over 1025..4096 incompressible bytes (text of the
+// length past the shape: it compresses under a kibibyte), the writes drawn as in the wide
+// property. The shape needs the first kibibyte of the stream not to decode to its end, which
+// is a function of the bytes written: the cases are not filtered, and the collector's "known
+// archives/25" count is the hit rate. Nothing earlier reaches Brotli (10 is Lz4's). The
+// length is a hegel.Integers leaf (a halving tree over three thousand values, built once,
+// would serve as well; the leaf shrinks towards 1025 alike).
+var longBrotliLengths = hegel.Integers(1025, 4096)
+
+var longBrotliCases = hegel.FlatMap(rangeHalves(0, 11), func(q int) hegel.Generator[compressionCase] {
+	f := compFormat{Kind: "br", Level: q}
+	return hegel.FlatMap(longBrotliLengths, func(n int) hegel.Generator[compressionCase] {
+		data := hzShaped[hegel.Generator[[]byte]](hegel.Map(hegel.Binary(n, n), incompressible), hegel.Just(textOf(n)))
+		return hegel.FlatMap(data, func(data []byte) hegel.Generator[compressionCase] {
+			return hegel.Map(piecesDrawn, func(lengths []int) compressionCase { return buildCompressionCase(f, data, lengths) })
+		})
+	})
+})
+
+// TestHegelLongBrotliStreamsAreMatched: a brotli stream written by Brotli's writer is
+// matched by Brotli.Match and named by Identify whatever its length; archives/25 decodes
+// the first kibibyte only and counts the truncation error as no match.
+func TestHegelLongBrotliStreamsAreMatched(t *testing.T) {
+	judged(t, longBrotliCases, compressionJudge)
+}
+
+// --------------------------------------------------------------------------- archives/26
+
+// tgzNames is a name spelt .tgz (the .tar.gz spelling past the shape), in any case and
+// directory, "x.tar.tgz" included (documented as .tar.gz; the library answers .tar).
+var tgzNames = hzShaped(evenHalves("x.tgz", "X.TGZ", "dir/x.tgz", "x.tar.tgz", "x.Tgz"), evenHalves("x.tar.gz", "X.TAR.GZ", "dir/x.tar.gz", "x.Tar.Gz"))
+
+// tgzCases: a tar of a tree of up to four entries under Gz (every level, Multithreaded at
+// 30) with a .tgz name: the stream agrees with the name (19 out of the pool); 9 and 10 need a
+// zip or Lz4.
+var tgzCases = hegel.FlatMap(tarFormats, func(a archFormat) hegel.Generator[identifyCase] {
+	return hegel.FlatMap(treesOf(4), func(tree []fileEntry) hegel.Generator[identifyCase] {
+		gz := hegel.FlatMap(rangeHalves(0, 9), func(l int) hegel.Generator[compFormat] {
+			return hegel.Map(dieCoin(30), func(m bool) compFormat { return compFormat{Kind: "gz", Level: l, Multi: m} })
+		})
+		return hegel.FlatMap(gz, func(f compFormat) hegel.Generator[identifyCase] {
+			return hegel.Map(tgzNames, func(name string) identifyCase {
+				return identifyCase{Content: buildArchiveContent(a, tree, f), Name: name}
+			})
+		})
+	})
+})
+
+// TestHegelTgzNamesIdentify: Identify by name knows the .tgz spelling archiveExtensions
+// lists (PathIsArchive and DeepFS treat such files as archives) as a tar.gz; archives/26
+// returns NoMatch for the name alone.
+func TestHegelTgzNamesIdentify(t *testing.T) {
+	judged(t, tgzCases, identifyJudgeWith(3))
+}
+
+// --------------------------------------------------------------------------- archives/28
+
+// truncatedLzipHeaderCases: an lzip stream cut to 4 or 5 bytes (the magic, matched by
+// stream) under a plain name six times in seven or its own (x.lz). The other instance of the
+// mechanism, x.lz over 1..3 bytes (matched by name alone), is not in the pool: the documented
+// answer there is the name's (the bytes match nothing), the decoder's error is archives/19's
+// in every check, and judged past 19 nothing of it is left. Past the shape, the cuts 0..3
+// under a plain name (NoMatch). Judged past archives/19, which every such stream also has
+// (the archival name in the error varies) and would be named first; 20 needs six bytes, 24
+// a whole stream, 9, 10, 25 and 26 other formats.
+var truncatedLzipHeaderCases = hegel.FlatMap(payloadOf(true, false), func(p []byte) hegel.Generator[identifyCase] {
+	return hegel.FlatMap(hzShaped(rangeHalves(4, 5), rangeHalves(0, 3)), func(cut int) hegel.Generator[identifyCase] {
+		ct := identifyContent{Kind: "truncated", Comp: compFormat{Kind: "lz"}, Payload: p, Cut: cut}
+		return hegel.Map(halvesGens([]int{6, hzUnless(hzNoKnown, 1)}, plainNames, hegel.Just("x.lz")), func(name string) identifyCase {
+			return identifyCase{Content: ct, Name: name}
+		})
+	})
+})
+
+// TestHegelTruncatedLzipHeadersErrAlike: Identify on an lzip stream cut inside its header
+// fails with the same error whether the stream is an io.Seeker or not; archives/28 reports
+// the decoder's verdict on a seekable stream and EOF on a buffered one (the rewindReader
+// returns the replayed bytes together with io.EOF, and lzip-go's single header read reports
+// it as is). The archival name in the error, which varies by map order, is archives/19's and
+// left out of the judgement.
+func TestHegelTruncatedLzipHeadersErrAlike(t *testing.T) {
+	judged(t, truncatedLzipHeaderCases, identifyJudgeOver(3, []int{kIdentifyNondeterministic}, nil))
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..6bef58f
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,217 @@
+package hegel
+
+// Hegel property tests for mholt/archives, written for the Hegel zoo. See
+// targets/go/archives/README.md. They live in a package of their own (hegel/) and drive the
+// public API: FilesFromFS/FilesFromDisk, the Archive/Extract/Insert methods of Tar and Zip
+// (alone and under every compression format), Identify, ArchiveFS, FileSystem and DeepFS.
+//
+// Oracles: the generated tree itself (what went into an archive must come out of it, by
+// name, kind, content, link target and mode), the io/fs contract (testing/fstest.TestFS and a
+// model of the tree as a file system), the package's documentation of the name mapping and of
+// Identify, and Python's tarfile/zipfile as an independent reader of the archives written.
+//
+// Two harnesses coexist while the rewrite to the combinator style proceeds in parts. The
+// new one (hegel_zoo_idioms_test.go, hegel_zoo_judge_test.go) carries TestHegelFilesFrom
+// (hegel_zoo_files_test.go), TestHegelDeepFS (hegel_zoo_deep_test.go), TestHegelIdentify
+// (hegel_zoo_identify_test.go), TestHegelCompression (hegel_zoo_compression_test.go) and the
+// narrow properties of their recorded bugs (hegel_zoo_shapes_test.go): cases are records
+// drawn from package-level generators, a pure model states the documented values with the
+// replicas of the recorded bugs threaded on a switch set (`known`, all off by default), and
+// a judge names the shape of a failing case; HEGEL_NO_KNOWN=1 switches the shapes off. This
+// file and hegel_zoo_gen_test.go, hegel_zoo_props_test.go are the OLD harness (its names
+// carry the hzOld prefix where the new one took the name) for the properties not yet
+// rewritten (ArchiveRoundTrip, ArchiveFS, Insert) and the pins: the switches in HZKnown are
+// gates, all on by default, read by those.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOldOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzOldProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOldOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzOldProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOldOpts()...)
+}
+
+func hzOldDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzOldChance(tc hegel.TestCase, pct int) bool { return hzOldDrawInt(tc, 1, 100) <= pct }
+
+func hzOldPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzOldCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzOldCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzOldNewCollector(t *testing.T) *hzOldCollector {
+	c := &hzOldCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzOldCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		for k, v := range hzAvoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, v))
+		}
+		hzAvoided = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzOldCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzOldCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzOldCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. While a switch is on
+// the generators keep away from the behaviour (and count the avoidance); the pins assert the
+// documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	zipXzHeaderOffset          bool // Zip{Compression: ZipMethodXz} writes the xz stream header before each entry's local header, and no reader can open the entries
+	lz4CompressionLevel        bool // Lz4{CompressionLevel: n} with n in 1..9 fails to open a writer: the level is passed as the library's bit-flag constant
+	zipEmptyStreamMatch        bool // an empty zip (PK\x05\x06) is not matched by stream: Zip.Match reads the stream once per candidate header instead of comparing the same bytes
+	dirFileReadDirRest         bool // the directory files of ArchiveFS return all their entries from ReadDir(n <= 0), not the remaining ones
+	openImplicitDirFile        bool // ArchiveFS.Open of an implicit directory before the index is built returns its first descendant file opened as the directory
+	openDirFreshEntries        bool // ArchiveFS.Open of a directory before the index is built lists as its children the files of subdirectories that have no entry or whose entry comes after them, and files whose names start with ./
+	statImplicitDirName        bool // ArchiveFS.Stat of an implicit directory returns its full path as Name() before the index is built, and a child's name after
+	statPrefixMissing          bool // ArchiveFS.Stat of a missing name that is a prefix of an entry's name returns an implicit directory before the index is built
+	tarInsertBlockAligned      bool // Tar.Insert after an archive whose last entry's size is a multiple of 512 (an empty file, a directory, a link, an empty archive) leaves a zero block before the new entries, and the archive no longer reads past it
+	zipInsertDirStops          bool // Zip.Insert returns after a directory entry, and the files after it are not inserted
+	zipInsertStores            bool // Zip.Insert without SelectiveCompression stores the files, whatever Compression says
+	zipInsertCustomMethod      bool // Zip.Insert with SelectiveCompression and Compression Bzip2, Zstd or Xz fails: the updater does not know the methods the package registers
+	zipInsertSymlink           bool // Zip.Insert opens a symbolic link's target and stores its content as the link's, instead of the target path Archive stores; a dangling link fails the insertion
+	fsRootDotLeadingSlash      bool // (read by nothing since part 1) FilesFromFS/FilesFromDisk with the in-archive root "." give names with a leading slash
+	fsTrailingSlashKey         bool // (read by nothing since part 1) FilesFromFS with a key ending in a slash fails (fs paths cannot end in a slash), though documented as enumerating the directory's contents
+	fsFollowSymlinkRelative    bool // (read by nothing since part 1) FilesFromFS with FollowSymlinks resolves a relative link target from the root of the fs.FS, not from the link's directory as FilesFromDisk does
+	identifyNondeterministic   bool // (read by nothing since part 2) Identify iterates the formats in map order: when the file name and the stream point at different formats, the answer varies from call to call
+	pathContainsArchiveCase    bool // (read by nothing since part 1) PathContainsArchive compares the extensions case-sensitively while PathIsArchive and SplitPath lower-case the path
+	brotliMatchTruncated       bool // (read by nothing since part 2) Brotli.Match rejects a stream longer than 1 KiB whose first kibibyte does not decode to its end: the decoder's truncation error counts as no match, and Identify finds no format
+	deepFSDirNamedArchive      bool // (read by nothing since part 1) a directory named like an archive (dir.zip) is treated by DeepFS as an archive, and the archives inside it are listed as plain files, not walked
+	lzipEmptyStream            bool // (read by nothing since part 2) Lzip's writer closed without a Write produces a stream without the LZIP header, which Lzip's reader rejects
+	fsTrailingKeyValue         bool // (read by nothing since part 1) FilesFromDisk with a key ending in a separator and a non-empty value adds the directory itself, and drops the first path element of the value
+	splitPathFirstSegment      bool // (read by nothing since part 1) DeepFS.SplitPath skips the first character of the path, so a first segment that is only an archive extension (.zip) is not split
+	identifyLzipTruncatedPanic bool // (read by nothing since part 2) Identify panics (slice bounds) on a truncated lzip stream: the lzip reader used to look inside it for an archive panics on short input
+	fsFollowDirLink            bool // (read by nothing since part 1) FilesFromFS with FollowSymlinks fails on a link to a directory: the directory is looked up by its own path inside fs.Sub of itself
+	followAncestorLinkHang     bool // (read by nothing since part 1) FilesFromDisk and FilesFromFS with FollowSymlinks recurse without end on a link to an ancestor directory (ln -s . self): the link is found again inside the directory it points at
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
