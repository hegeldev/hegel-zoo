+
+// --------------------------------------------------------------------------- FilesFromFS / FilesFromDisk
+
+// hzMapping is one key/value of the filenames map, in fs terms (key relative to the tree's
+// root, "." for the root itself).
+type hzMapping struct {
+	key   string // a tree path or ".", possibly with a trailing slash
+	value string
+}
+
+// hzExpectNames applies the documented rules of FilesFromDisk/FilesFromFS to the tree: the
+// names in the archive of every entry the mapping gathers (the key's file, or the key's
+// directory and everything under it), by tree path.
+func hzExpectNames(tree *hzTree, m hzMapping, rootBase string) map[string]string {
+	out := map[string]string{}
+	trailing := strings.HasSuffix(m.key, "/")
+	k := strings.TrimSuffix(m.key, "/")
+	base := path.Base(k)
+	if k == "." {
+		base = rootBase
+	}
+	root := m.value
+	switch {
+	case trailing:
+		// "map keys that end in a separator will enumerate contents only, without adding the
+		// folder itself to the archive"
+		if root == "." {
+			root = ""
+		}
+	case root == "":
+		// "map values that are empty string are interpreted as the base name of the file (sans
+		// path) in the root of the archive"
+		root = base
+	case root == ".":
+		root = ""
+	case strings.HasSuffix(root, "/"):
+		// "map values that end in a slash will use the base name of the file in that folder"
+		root += base
+	}
+	if k == "." && !trailing && root != "" {
+		out["."] = path.Clean(root) // the root directory itself, under the name given
+	}
+	for _, e := range tree.entries {
+		var rel string
+		switch {
+		case k == ".":
+			rel = e.path
+		case e.path == k:
+			rel = ""
+		case strings.HasPrefix(e.path, k+"/"):
+			rel = e.path[len(k)+1:]
+		default:
+			continue
+		}
+		if rel == "" && (trailing || root == "") {
+			continue // the directory itself is not added
+		}
+		out[e.path] = path.Join(root, rel)
+	}
+	return out
+}
+
+// TestHegelFilesFrom: FilesFromFS on the tree as a fstest.MapFS and FilesFromDisk on the same
+// tree written to disk gather the entries the documentation describes for the filenames map:
+// the names in the archive, the kinds, the link targets, contents, permissions and times,
+// with and without ClearAttributes; with FollowSymlinks the links to files become the files.
+func TestHegelFilesFrom(t *testing.T) {
+	c := hzNewCollector(t)
+	tmp, err := os.MkdirTemp("", "hz-archives-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { hzRestoreDisk(tmp); os.RemoveAll(tmp) })
+	n := 0
+	hzProperty(t, func(ht *hegel.T) {
+		tree := hzGenTree(ht, 8)
+		n++
+		dir := filepath.Join(tmp, fmt.Sprintf("t%d", n))
+		if err := os.Mkdir(dir, 0o700); err != nil {
+			ht.Fatalf("mkdir: %v", err)
+		}
+		defer func() { hzRestoreDisk(dir); os.RemoveAll(dir) }()
+		if err := hzWriteDisk(tree, dir); err != nil {
+			ht.Fatalf("writing the tree: %v", err)
+		}
+		mfs := hzMapFS(tree)
+
+		// the mapping: one key, a directory or a file of the tree or the root
+		var m hzMapping
+		var candidates []string
+		for _, e := range tree.entries {
+			if e.kind != 'l' {
+				candidates = append(candidates, e.path)
+			}
+		}
+		if len(candidates) == 0 || hzChance(ht, 25) {
+			m.key = "."
+		} else {
+			m.key = hzPick(ht, candidates)
+		}
+		isDirKey := m.key == "." || tree.get(m.key).kind == 'd'
+		if isDirKey && m.key != "." && hzChance(ht, 30) {
+			m.key += "/"
+		}
+		m.value = hzPick(ht, []string{"", "", ".", "x", "x/", "x/y", "x/y/"})
+		if !isDirKey && m.value == "." {
+			m.value = "" // a file with an empty name in the archive is unspecified
+		}
+		if strings.HasSuffix(m.key, "/") && strings.HasSuffix(m.value, "/") {
+			m.value = "x" // contents only, into a folder named for the directory: unspecified
+		}
+		follow := hzChance(ht, 30)
+		clear := hzChance(ht, 30)
+		c.count(fmt.Sprintf("key %s value %q follow=%v", hzKeyKind(m.key), m.value, follow))
+
+		wantFS := hzExpectNames(tree, m, "")
+		wantDisk := hzExpectNames(tree, m, filepath.Base(dir))
+		want := wantFS
+		// with FollowSymlinks, the links: to a regular file, the file under the link's name; to
+		// a directory, that directory and its contents under the link's name; otherwise an error
+		wantErr := false
+		if follow {
+			loop := false
+			for p := range want {
+				e := tree.get(p)
+				if e == nil || e.kind != 'l' {
+					continue
+				}
+				target := hzResolve(p, e.link)
+				te := (*hzEntry)(nil)
+				if target != "" {
+					te = tree.get(target)
+				}
+				if te == nil {
+					wantErr = true // and go on: a loop elsewhere must still be seen
+					continue
+				}
+				if te.kind == 'd' {
+					switch hzExpandDirLink(tree, target, p, wantFS, wantDisk, 0) {
+					case hzExpandDangling:
+						wantErr = true
+					case hzExpandLoop:
+						loop = true
+					}
+				}
+			}
+			if loop && HZKnown.followAncestorLinkHang {
+				hzAvoid("followAncestorLinkHang")
+				return
+			}
+			if loop {
+				// the switch is off: the call does not return; report it after three seconds
+				// (once per run: the runaway recursion keeps its goroutine)
+				hzHangMu.Lock()
+				seen := hzHangSeen
+				hzHangSeen = true
+				hzHangMu.Unlock()
+				if seen {
+					c.count("follow: loop skipped")
+					return
+				}
+				done := make(chan error, 1)
+				go func() {
+					_, err := archives.FilesFromDisk(hzCtx, &archives.FromDiskOptions{FollowSymlinks: follow}, map[string]string{dir: ""})
+					done <- err
+				}()
+				select {
+				case <-done:
+					c.count("follow: loop returned")
+				case <-time.After(3 * time.Second):
+					c.failClass(ht, "hang", "disk key %q follow=true: FilesFromDisk did not return within 3s on a link to an ancestor directory\n%s", dir, hzTreeString(tree))
+				}
+				return
+			}
+		}
+
+		for _, side := range []string{"fs", "disk"} {
+			var files []archives.FileInfo
+			var err error
+			want := wantFS
+			if side == "disk" {
+				want = wantDisk
+			}
+			if strings.HasSuffix(m.key, "/") && m.value != "" && HZKnown.fsTrailingKeyValue {
+				hzAvoid("fsTrailingKeyValue")
+				continue
+			}
+			if !strings.HasSuffix(m.key, "/") && m.value == "." && HZKnown.fsRootDotLeadingSlash {
+				hzAvoid("fsRootDotLeadingSlash")
+				continue
+			}
+			if side == "fs" {
+				if strings.HasSuffix(m.key, "/") && HZKnown.fsTrailingSlashKey {
+					hzAvoid("fsTrailingSlashKey")
+					continue
+				}
+				if follow && HZKnown.fsFollowSymlinkRelative && hzHasRelativeLinkInSubdir(tree, want) {
+					hzAvoid("fsFollowSymlinkRelative")
+					continue
+				}
+				if follow && HZKnown.fsFollowDirLink && hzHasDirLink(tree, want) {
+					hzAvoid("fsFollowDirLink")
+					continue
+				}
+				files, err = archives.FilesFromFS(hzCtx, mfs, &archives.FromFSOptions{FollowSymlinks: follow, ClearAttributes: clear}, map[string]string{m.key: m.value})
+			} else {
+				key := filepath.Join(dir, filepath.FromSlash(strings.TrimSuffix(m.key, "/")))
+				if strings.HasSuffix(m.key, "/") {
+					key += string(filepath.Separator)
+				}
+				files, err = archives.FilesFromDisk(hzCtx, &archives.FromDiskOptions{FollowSymlinks: follow, ClearAttributes: clear}, map[string]string{key: m.value})
+			}
+			where := fmt.Sprintf("%s key %q value %q follow=%v clear=%v", side, m.key, m.value, follow, clear)
+			if wantErr {
+				if err == nil {
+					c.failClass(ht, "follow no error", "%s: a dangling link followed, no error; names %v\n%s", where, hzFileNames(files), hzTreeString(tree))
+				} else {
+					c.count("follow: dangling link error")
+				}
+				continue
+			}
+			if err != nil {
+				c.failClass(ht, "error "+side, "%s: %v\n%s", where, err, hzTreeString(tree))
+				continue
+			}
+			// names: the gathered set equals the model's
+			got := map[string]archives.FileInfo{}
+			var gotNames []string
+			for _, f := range files {
+				got[f.NameInArchive] = f
+				gotNames = append(gotNames, f.NameInArchive)
+			}
+			var wantNames []string
+			byName := map[string]string{} // archive name -> tree path
+			for p, name := range want {
+				wantNames = append(wantNames, name)
+				byName[name] = p
+			}
+			sort.Strings(gotNames)
+			sort.Strings(wantNames)
+			if strings.Join(gotNames, "\n") != strings.Join(wantNames, "\n") {
+				c.failClass(ht, "names "+side, "%s:\n got  %q\n want %q\n%s", where, gotNames, wantNames, hzTreeString(tree))
+				continue
+			}
+			for name, f := range got {
+				p := byName[name]
+				e := tree.get(p)
+				if e == nil {
+					// the root itself, or a path under a followed directory link
+					continue
+				}
+				kind := e.kind
+				var content []byte
+				link := e.link
+				if kind == 'l' && follow {
+					te := tree.get(hzResolve(p, e.link))
+					kind = te.kind
+					content = te.data
+					link = ""
+				}
+				if kind == 'f' {
+					content = tree.get(p).data
+					if e.kind == 'l' {
+						content = tree.get(hzResolve(p, e.link)).data
+					}
+				}
+				w := fmt.Sprintf("%s entry %q (%s)", where, name, p)
+				switch {
+				case kind == 'd' && !f.IsDir():
+					c.failClass(ht, "kind "+side, "%s: a directory, gathered as %v", w, f.Mode())
+				case kind == 'f' && (f.IsDir() || f.Mode()&fs.ModeSymlink != 0):
+					c.failClass(ht, "kind "+side, "%s: a file, gathered as %v", w, f.Mode())
+				case kind == 'l' && f.Mode()&fs.ModeSymlink == 0:
+					c.failClass(ht, "kind "+side, "%s: a link, gathered as %v", w, f.Mode())
+				}
+				if f.LinkTarget != link {
+					c.failClass(ht, "link "+side, "%s: LinkTarget %q, want %q", w, f.LinkTarget, link)
+				}
+				if kind == 'f' {
+					r, err := f.Open()
+					if err != nil {
+						c.failClass(ht, "open "+side, "%s: Open: %v", w, err)
+					} else {
+						b, _ := io.ReadAll(r)
+						r.Close()
+						if !bytes.Equal(b, content) {
+							c.failClass(ht, "content "+side, "%s: %d bytes, want %d", w, len(b), len(content))
+						}
+					}
+					if f.Size() != int64(len(content)) {
+						c.failClass(ht, "size "+side, "%s: Size %d, want %d", w, f.Size(), len(content))
+					}
+				}
+				if kind != 'l' {
+					me := e
+					if e.kind == 'l' {
+						me = tree.get(hzResolve(p, e.link))
+					}
+					if f.Mode().Perm() != me.mode {
+						c.failClass(ht, "mode "+side, "%s: mode %v, want %v", w, f.Mode().Perm(), me.mode)
+					}
+					if clear {
+						if !f.ModTime().IsZero() || f.Sys() != nil {
+							c.failClass(ht, "clear "+side, "%s: ClearAttributes left ModTime %v Sys %v", w, f.ModTime(), f.Sys())
+						}
+					} else if !f.ModTime().Equal(me.mtime) {
+						c.failClass(ht, "mtime "+side, "%s: ModTime %v, want %v", w, f.ModTime(), me.mtime)
+					}
+				}
+			}
+		}
+	})
+}
+
+func hzKeyKind(key string) string {
+	switch {
+	case key == ".":
+		return "root"
+	case strings.HasSuffix(key, "/"):
+		return "dir/"
+	default:
+		return "path"
+	}
+}
+
+const (
+	hzExpandOK       = iota
+	hzExpandDangling // a link inside the followed directory has no target
+	hzExpandLoop     // a link inside leads back to an ancestor directory (the expansion has no end)
+)
+
+// hzHangSeen: a hang has been reported in this run (the property reports it once).
+var (
+	hzHangMu   sync.Mutex
+	hzHangSeen bool
+)
+
+// hzExpandDirLink adds, under the link p (a directory link with target), the followed contents
+// of the target: every entry below it under the link's name, and links to directories inside
+// expanded in turn. A tree of n entries has no legitimate nesting deeper than n.
+func hzExpandDirLink(tree *hzTree, target, p string, wantFS, wantDisk map[string]string, depth int) int {
+	if depth > len(tree.entries) {
+		return hzExpandLoop
+	}
+	result := hzExpandOK
+	for _, sub := range tree.entries {
+		if !strings.HasPrefix(sub.path, target+"/") {
+			continue
+		}
+		rest := sub.path[len(target)+1:]
+		wantFS[p+"/"+rest] = wantFS[p] + "/" + rest
+		wantDisk[p+"/"+rest] = wantDisk[p] + "/" + rest
+		if sub.kind != 'l' {
+			continue
+		}
+		t2 := hzResolve(sub.path, sub.link)
+		te := (*hzEntry)(nil)
+		if t2 != "" {
+			te = tree.get(t2)
+		}
+		if te == nil {
+			if result == hzExpandOK {
+				result = hzExpandDangling
+			}
+			continue
+		}
+		if te.kind == 'd' {
+			if r := hzExpandDirLink(tree, t2, p+"/"+rest, wantFS, wantDisk, depth+1); r == hzExpandLoop {
+				return hzExpandLoop
+			} else if r == hzExpandDangling && result == hzExpandOK {
+				result = hzExpandDangling
+			}
+		}
+	}
+	return result
+}
+
+// hzHasDirLink reports whether a gathered link points at a directory of the tree.
+func hzHasDirLink(tree *hzTree, want map[string]string) bool {
+	for p := range want {
+		e := tree.get(p)
+		if e == nil || e.kind != 'l' {
+			continue
+		}
+		if te := tree.get(hzResolve(p, e.link)); te != nil && te.kind == 'd' {
+			return true
+		}
+	}
+	return false
+}
+
+// hzHasRelativeLinkInSubdir reports whether a gathered link, in a subdirectory, has a relative
+// target (the shape FilesFromFS resolves from the root instead of the link's directory).
+func hzHasRelativeLinkInSubdir(tree *hzTree, want map[string]string) bool {
+	for p := range want {
+		e := tree.get(p)
+		if e != nil && e.kind == 'l' && !strings.HasPrefix(e.link, "/") && strings.Contains(p, "/") {
+			return true
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- Identify
+
+var hzCompressionExts = []string{".gz", ".bz2", ".xz", ".zst", ".lz4", ".br", ".sz", ".s2", ".lz", ".zz", ".mz"}
+
+// hzIdentifyByName is the documented/implemented matching by file name: compression by the
+// last extension, Zip/7z/Rar by the last extension, Tar by any ".tar" component.
+func hzIdentifyByName(name string) string {
+	name = strings.ToLower(path.Base(filepath.ToSlash(name)))
+	comp := ""
+	for _, ext := range hzCompressionExts {
+		if path.Ext(name) == ext {
+			comp = ext
+			if ext == ".s2" {
+				comp = ".sz"
+			}
+		}
+	}
+	arch := ""
+	switch {
+	case path.Ext(name) == ".zip":
+		arch = ".zip"
+	case path.Ext(name) == ".7z":
+		arch = ".7z"
+	case path.Ext(name) == ".rar":
+		arch = ".rar"
+	default:
+		parts := strings.Split(name, ".")
+		for _, p := range parts[1:] {
+			if p == "tar" {
+				arch = ".tar"
+			}
+		}
+	}
+	if arch == "" && comp == "" {
+		return ""
+	}
+	return arch + comp
+}
+
+// TestHegelIdentify: Identify names a format from the bytes alone (an archive, a compressed
+// stream, a compressed archive), from a file name alone by the documented extension rules,
+// and returns the stream unread whatever it decides; the same input always gives the same
+// answer; nothing panics on arbitrary bytes.
+func TestHegelIdentify(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		// the content
+		var data []byte
+		var wantExt string // by stream
+		switch hzDrawInt(ht, 0, 5) {
+		case 0:
+			data = hegel.Draw(ht, hegel.Binary(0, 64))
+			wantExt = "?"
+		case 1:
+			data = nil
+			wantExt = ""
+		case 2, 3:
+			tree := hzGenTree(ht, 4)
+			files := hzMust(archives.FilesFromFS(hzCtx, hzMapFS(tree), nil, nil))
+			archival := hzArchival(ht)
+			var format archives.Format = archival
+			if _, isTar := archival.(archives.Tar); isTar && hzChance(ht, 50) {
+				comp := hzCompression(ht)
+				format = archives.CompressedArchive{Archival: archival, Extraction: archival, Compression: comp}
+			}
+			var buf bytes.Buffer
+			if err := format.(archives.Archiver).Archive(hzCtx, &buf, files); err != nil {
+				return
+			}
+			data = buf.Bytes()
+			wantExt = format.Extension()
+			if len(files) == 0 {
+				wantExt = "?" // an empty tar has nothing to match; an empty zip is recorded
+			}
+		case 4:
+			comp := hzCompression(ht)
+			var buf bytes.Buffer
+			w := hzMust(comp.OpenWriter(&buf))
+			payload := hzData(ht)
+			w.Write(payload)
+			w.Close()
+			data = buf.Bytes()
+			wantExt = comp.Extension()
+			switch comp.(type) {
+			case archives.Sz, archives.MinLZ:
+				if len(payload) == 0 {
+					wantExt = "?" // no stream header for an empty input
+				}
+			case archives.Brotli:
+				if len(data) > 1024 && HZKnown.brotliMatchTruncated {
+					hzAvoid("brotliMatchTruncated")
+					wantExt = "?"
+				}
+			}
+		default:
+			// a truncated compressed stream
+			comp := hzCompression(ht)
+			var buf bytes.Buffer
+			w := hzMust(comp.OpenWriter(&buf))
+			w.Write(hzData(ht))
+			w.Close()
+			data = buf.Bytes()
+			if n := hzDrawInt(ht, 0, 12); n < len(data) {
+				data = data[:n]
+			}
+			if _, isLzip := comp.(archives.Lzip); isLzip && len(data) >= 6 && HZKnown.identifyLzipTruncatedPanic {
+				hzAvoid("identifyLzipTruncatedPanic")
+				data = data[:4]
+			}
+			wantExt = "?"
+		}
+		// the name
+		var name string
+		switch hzDrawInt(ht, 0, 5) {
+		case 0:
+			name = ""
+		case 1:
+			name = "x" + wantExt
+			if wantExt == "?" || wantExt == "" {
+				name = "x.bin"
+			}
+		case 2:
+			name = hzPick(ht, []string{"x.txt", "noext", "x.bak", "dir/x.dat", "x.tgz", "x.tbz2", "x.TAR.GZ", ".tar", "x.tar.txt", "x.tar.gz.bak"})
+		case 3:
+			name = "x" + hzPick(ht, hzCompressionExts)
+		case 4:
+			name = "x" + hzPick(ht, []string{".zip", ".tar", ".7z", ".rar", ".tar.gz", ".tar.zst", ".zip.gz"})
+		default:
+			name = hzPick(ht, []string{"X.ZIP", "x.Tar", "a/b/x.tar.bz2", "x.s2", "x.tar.s2"})
+		}
+		byName := hzIdentifyByName(name)
+		c.count("content " + wantExt)
+
+		// by name alone
+		if name != "" {
+			f, r, err := archives.Identify(hzCtx, name, nil)
+			switch {
+			case err == archives.NoMatch:
+				if byName != "" {
+					c.failClass(ht, "name only nomatch", "Identify(%q, nil): NoMatch, the extension rules give %s", name, byName)
+				}
+			case err != nil:
+				c.failClass(ht, "name only error", "Identify(%q, nil): %v", name, err)
+			case f.Extension() != byName:
+				c.failClass(ht, "name only format", "Identify(%q, nil): %s, the extension rules give %s", name, f.Extension(), byName)
+			}
+			if r != nil {
+				c.failClass(ht, "name only reader", "Identify(%q, nil): a non-nil reader %T", name, r)
+			}
+		}
+
+		// with the stream, seekable and not, several times
+		type outcome struct {
+			ext string
+			err string
+		}
+		var outcomes []outcome
+		for i := 0; i < 3; i++ {
+			for _, seekable := range []bool{true, false} {
+				var r io.Reader = bytes.NewReader(data)
+				if !seekable {
+					r = struct{ io.Reader }{bytes.NewReader(data)}
+				}
+				var f archives.Format
+				var rest io.Reader
+				var err error
+				if p := hzCatch(func() { f, rest, err = archives.Identify(hzCtx, name, r) }); p != nil {
+					c.failClass(ht, "panic", "Identify(%q) on %d bytes % x: panic %v", name, len(data), hzHead(data, 16), p)
+					return
+				}
+				o := outcome{}
+				if err != nil {
+					o.err = err.Error()
+				} else {
+					o.ext = f.Extension()
+				}
+				outcomes = append(outcomes, o)
+				if rest == nil {
+					c.failClass(ht, "nil reader", "Identify(%q, seekable=%v) on %d bytes: nil reader returned (err %v)", name, seekable, len(data), err)
+					continue
+				}
+				back, rerr := io.ReadAll(rest)
+				if rerr != nil || !bytes.Equal(back, data) {
+					c.failClass(ht, "stream", "Identify(%q, seekable=%v) on %d bytes (%s, err %v): the returned reader gives %d bytes, err %v", name, seekable, len(data), o.ext, err, len(back), rerr)
+				}
+			}
+		}
+		first := outcomes[0]
+		for _, o := range outcomes[1:] {
+			if o != first {
+				if HZKnown.identifyNondeterministic && (byName != "" || wantExt == "?") {
+					hzAvoid("identifyNondeterministic")
+					return
+				}
+				c.failClass(ht, "nondeterministic", "Identify(%q) on %d bytes (% x) gave %+v and %+v", name, len(data), hzHead(data, 12), first, o)
+				return
+			}
+		}
+		// the expected answer when the stream is known and the name does not contradict it
+		if wantExt != "?" {
+			contradicts := byName != "" && byName != wantExt
+			if contradicts {
+				c.count("name contradicts stream: " + first.ext + " / " + hzHead2(first.err))
+				return
+			}
+			switch {
+			case wantExt == "":
+				if first.err == "" || first.err != archives.NoMatch.Error() {
+					c.failClass(ht, "empty", "Identify(%q) on an empty stream: %+v", name, first)
+				}
+			case first.err != "":
+				c.failClass(ht, "error", "Identify(%q) on a %s stream of %d bytes: %s", name, wantExt, len(data), first.err)
+			case first.ext != wantExt:
+				c.failClass(ht, "format", "Identify(%q) on a %s stream of %d bytes: %s", name, wantExt, len(data), first.ext)
+			}
+		}
+	})
+}
+
+func hzHead(b []byte, n int) []byte {
+	if len(b) > n {
+		return b[:n]
+	}
+	return b
+}
+
+func hzHead2(s string) string {
+	if i := strings.Index(s, ":"); i > 0 {
+		return s[:i]
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- DeepFS
+
+var hzArchiveExts = []string{".zip", ".tar", ".tgz", ".tar.gz", ".tar.bz2", ".tar.zst", ".tar.lz4", ".tar.xz", ".tar.sz", ".tar.lz"}
+
+// hzFormatForExt is the format that writes an archive with that extension.
+func hzFormatForExt(ext string) archives.Format {
+	switch ext {
+	case ".zip":
+		return archives.Zip{}
+	case ".tar":
+		return archives.Tar{}
+	}
+	var comp archives.Compression
+	switch ext {
+	case ".tgz", ".tar.gz":
+		comp = archives.Gz{}
+	case ".tar.bz2":
+		comp = archives.Bz2{}
+	case ".tar.zst":
+		comp = archives.Zstd{}
+	case ".tar.lz4":
+		comp = archives.Lz4{}
+	case ".tar.xz":
+		comp = archives.Xz{}
+	case ".tar.sz":
+		comp = archives.Sz{}
+	case ".tar.lz":
+		comp = archives.Lzip{}
+	}
+	return archives.CompressedArchive{Archival: archives.Tar{}, Extraction: archives.Tar{}, Compression: comp}
+}
+
+// hzSplitPathModel: the first path segment (case-insensitively, trailing spaces trimmed) that
+// ends with an archive extension splits the path.
+func hzSplitPathModel(p string) (string, string) {
+	segs := strings.Split(p, "/")
+	for i, s := range segs {
+		if archives.PathIsArchive(strings.TrimRight(strings.ToLower(s), " ")) {
+			real := filepath.Clean(filepath.FromSlash(strings.Join(segs[:i+1], "/")))
+			inner := strings.Join(segs[i+1:], "/")
+			if inner == "" && i == len(segs)-1 {
+				inner = "." // "precisely an archive file": the root of the archive
+			}
+			return real, inner
+		}
+	}
+	return filepath.Clean(filepath.FromSlash(p)), ""
+}
+
+// TestHegelDeepFS: a directory on disk holding files, directories, links and archives written
+// by the package (every archive extension DeepFS recognises) walks, through DeepFS, as the
+// disk tree with every archive replaced by a directory of its entries; the files inside read
+// as their contents. SplitPath splits at the first archive extension; PathContainsArchive
+// agrees with PathIsArchive on the path's segments.
+func TestHegelDeepFS(t *testing.T) {
+	c := hzNewCollector(t)
+	tmp, err := os.MkdirTemp("", "hz-archives-deep-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { hzRestoreDisk(tmp); os.RemoveAll(tmp) })
+	n := 0
+	hzProperty(t, func(ht *hegel.T) {
+		tree := hzGenTree(ht, 6)
+		n++
+		dir := filepath.Join(tmp, fmt.Sprintf("t%d", n))
+		if err := os.Mkdir(dir, 0o700); err != nil {
+			ht.Fatalf("mkdir: %v", err)
+		}
+		defer func() { hzRestoreDisk(dir); os.RemoveAll(dir) }()
+		// directories writable: DeepFS opens them. Files and links named like archives are
+		// archives to DeepFS by its documentation, so they are renamed; directories named like
+		// archives stay unless the recorded bug is avoided.
+		renames := map[string]string{}
+		for i := range tree.entries {
+			e := &tree.entries[i]
+			if e.kind == 'd' {
+				e.mode |= 0o700
+			}
+			for old, nw := range renames {
+				if strings.HasPrefix(e.path, old+"/") {
+					e.path = nw + e.path[len(old):]
+				}
+			}
+			if archives.PathIsArchive(e.path) && (e.kind != 'd' || HZKnown.deepFSDirNamedArchive) {
+				if e.kind == 'd' {
+					hzAvoid("deepFSDirNamedArchive")
+				}
+				renames[e.path] = e.path + "_"
+				e.path += "_"
+			}
+		}
+		tree.byPath = nil
+		for i, e := range tree.entries {
+			if tree.byPath == nil {
+				tree.byPath = map[string]int{}
+			}
+			tree.byPath[e.path] = i
+		}
+		if err := hzWriteDisk(tree, dir); err != nil {
+			ht.Fatalf("writing the tree: %v", err)
+		}
+		// the model of the walk: path -> isDir
+		model := map[string]bool{}
+		content := map[string][]byte{}
+		for _, e := range tree.entries {
+			model[e.path] = e.kind == 'd'
+			if e.kind == 'f' {
+				content[e.path] = e.data
+			}
+		}
+		// archives, in the root or in a directory
+		na := hzDrawInt(ht, 0, 3)
+		for i := 0; i < na; i++ {
+			ext := hzPick(ht, hzArchiveExts)
+			parent := ""
+			if ds := tree.dirs(); len(ds) > 0 && hzChance(ht, 50) {
+				parent = hzPick(ht, ds)
+			}
+			name := hzPick(ht, []string{"arc", "ARC", "a b", "x.y"}) + ext
+			if hzChance(ht, 20) {
+				name = strings.ToUpper(name)
+			}
+			p := name
+			if parent != "" {
+				p = parent + "/" + name
+			}
+			if _, exists := model[p]; exists {
+				continue
+			}
+			inner := hzGenTree(ht, 5)
+			if len(inner.entries) == 0 {
+				// an empty tar is not identified as one, and an empty archive would then list itself
+				inner.add(hzEntry{path: "only", kind: 'f', data: []byte("x"), mode: 0o644, mtime: hzTime(ht)})
+			}
+			files := hzMust(archives.FilesFromFS(hzCtx, hzMapFS(inner), nil, nil))
+			format := hzFormatForExt(strings.ToLower(ext))
+			var buf bytes.Buffer
+			if err := format.(archives.Archiver).Archive(hzCtx, &buf, files); err != nil {
+				ht.Fatalf("archive: %v", err)
+			}
+			if err := os.WriteFile(filepath.Join(dir, filepath.FromSlash(p)), buf.Bytes(), 0o644); err != nil {
+				ht.Fatalf("write archive: %v", err)
+			}
+			model[p] = true
+			for _, e := range inner.entries {
+				model[p+"/"+e.path] = e.kind == 'd'
+				if e.kind == 'f' {
+					content[p+"/"+e.path] = e.data
+				}
+			}
+			c.count("archive " + strings.ToLower(ext))
+		}
+
+		dfs := &archives.DeepFS{Root: dir}
+		visited := map[string]bool{}
+		err := fs.WalkDir(dfs, ".", func(p string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return fmt.Errorf("at %q: %w", p, err)
+			}
+			if p != "." {
+				visited[p] = d.IsDir()
+			}
+			return nil
+		})
+		if err != nil {
+			c.failClass(ht, "walk error", "DeepFS WalkDir: %v\n%s", err, hzModelString(model))
+			return
+		}
+		if fmt.Sprint(hzSortedKeys(visited)) != fmt.Sprint(hzSortedKeys(model)) {
+			c.failClass(ht, "walk paths", "DeepFS WalkDir visited %q\nmodel %q", hzSortedKeys(visited), hzSortedKeys(model))
+			return
+		}
+		for p, isDir := range model {
+			if visited[p] != isDir {
+				c.failClass(ht, "walk kind", "DeepFS WalkDir: %q IsDir %v, model %v", p, visited[p], isDir)
+			}
+		}
+		for p, want := range content {
+			got, err := fs.ReadFile(dfs, p)
+			if err != nil {
+				c.failClass(ht, "readfile error", "DeepFS ReadFile(%q): %v", p, err)
+			} else if !bytes.Equal(got, want) {
+				c.failClass(ht, "readfile content", "DeepFS ReadFile(%q): %d bytes, want %d", p, len(got), len(want))
+			}
+			info, err := fs.Stat(dfs, p)
+			if err != nil {
+				c.failClass(ht, "stat error", "DeepFS Stat(%q): %v", p, err)
+			} else if info.IsDir() || info.Size() != int64(len(want)) {
+				c.failClass(ht, "stat", "DeepFS Stat(%q): dir %v size %d, want a file of %d", p, info.IsDir(), info.Size(), len(want))
+			}
+		}
+
+		// the lexical functions on the model's paths and on made-up ones
+		var paths []string
+		for p := range model {
+			paths = append(paths, p, "/"+p, p+"/", strings.ToUpper(p))
+		}
+		paths = append(paths, hzPick(ht, []string{"a.zip/b.tar/c", "a.ZIP/x", "a.tar.gz", "a.tgz/", "/a/b.tar.zst/c/d", "x.zip /y", "a.tar.gzip", ".zip", "a/.tar/b"}))
+		for _, p := range paths {
+			real, inner := dfs.SplitPath(p)
+			wantReal, wantInner := hzSplitPathModel(p)
+			if first := strings.Split(p, "/")[0]; archives.PathIsArchive(first) && !archives.PathIsArchive(first[1:]) && HZKnown.splitPathFirstSegment {
+				hzAvoid("splitPathFirstSegment")
+			} else if real != wantReal || inner != wantInner {
+				c.failClass(ht, "splitpath", "SplitPath(%q) = %q, %q; model %q, %q", p, real, inner, wantReal, wantInner)
+			}
+			any := false
+			for _, s := range strings.Split(p, "/") {
+				if archives.PathIsArchive(s) {
+					any = true
+				}
+			}
+			if archives.PathContainsArchive(p) != any {
+				if HZKnown.pathContainsArchiveCase && strings.ToLower(p) != p {
+					hzAvoid("pathContainsArchiveCase")
+				} else {
+					c.failClass(ht, "contains", "PathContainsArchive(%q) = %v, but a segment is an archive: %v", p, !any, any)
+				}
+			}
+		}
+	})
+}
+
+func hzSortedKeys(m map[string]bool) []string {
+	var ks []string
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+func hzModelString(m map[string]bool) string {
+	var b strings.Builder
+	for _, k := range hzSortedKeys(m) {
+		fmt.Fprintf(&b, "%v %q\n", m[k], k)
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- compression
+
+// hzDecompressCommand is the command-line decompressor for a format, when installed.
+func hzDecompressCommand(f archives.Compression) []string {
+	var cmd []string
+	switch f.(type) {
+	case archives.Gz:
+		cmd = []string{"gzip", "-dc"}
+	case archives.Bz2:
+		cmd = []string{"bzip2", "-dc"}
+	case archives.Xz:
+		cmd = []string{"xz", "-dc"}
+	case archives.Zstd:
+		cmd = []string{"zstd", "-dc"}
+	case archives.Lz4:
+		cmd = []string{"lz4", "-dc"}
+	case archives.Brotli:
+		cmd = []string{"brotli", "-dc"}
+	case archives.Lzip:
+		cmd = []string{"lzip", "-dc"}
+	default:
+		return nil
+	}
+	if _, err := exec.LookPath(cmd[0]); err != nil {
+		return nil
+	}
+	return cmd
+}
+
+// TestHegelCompression: every compression format's writer produces a stream its own reader
+// decodes to the input, its Match recognises by content (and by name), Identify names, and
+// the reference command-line tool decodes; a gzip stream of several members reads whole
+// unless DisableMultistream is set.
+func TestHegelCompression(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		comp := hzCompression(ht)
+		c.count(hzFormatName(comp))
+		data := hzData(ht)
+		if _, isLzip := comp.(archives.Lzip); isLzip && len(data) == 0 && HZKnown.lzipEmptyStream {
+			hzAvoid("lzipEmptyStream")
+			data = []byte("x")
+		}
+		var buf bytes.Buffer
+		w, err := comp.OpenWriter(&buf)
+		if err != nil {
+			c.failClass(ht, "open writer", "%s OpenWriter: %v", hzFormatName(comp), err)
+			return
+		}
+		// written in pieces
+		for rest := data; len(rest) > 0; {
+			n := hzDrawInt(ht, 1, len(rest))
+			if _, err := w.Write(rest[:n]); err != nil {
+				c.failClass(ht, "write", "%s Write: %v", hzFormatName(comp), err)
+				return
+			}
+			rest = rest[n:]
+		}
+		if err := w.Close(); err != nil {
+			c.failClass(ht, "close", "%s Close: %v", hzFormatName(comp), err)
+			return
+		}
+		out := buf.Bytes()
+
+		// match by stream, and by name (the Sz and MinLZ writers give an empty input no stream
+		// header, so there is nothing to match)
+		headerless := false
+		switch comp.(type) {
+		case archives.Sz, archives.MinLZ:
+			headerless = len(data) == 0
+		case archives.Brotli:
+			if len(out) > 1024 && HZKnown.brotliMatchTruncated {
+				hzAvoid("brotliMatchTruncated")
+				headerless = true
+			}
+		}
+		mr, err := comp.Match(hzCtx, "", bytes.NewReader(out))
+		if headerless {
+			c.count("empty input or long brotli: no stream match expected")
+		} else if err != nil || !mr.ByStream || mr.ByName {
+			c.failClass(ht, "match stream", "%s Match(\"\", stream) = %v, %v on % x", hzFormatName(comp), mr, err, hzHead(out, 12))
+		}
+		mr, err = comp.Match(hzCtx, "x"+strings.ToUpper(comp.Extension()), nil)
+		if err != nil || !mr.ByName || mr.ByStream {
+			c.failClass(ht, "match name", "%s Match(%q, nil) = %v, %v", hzFormatName(comp), "x"+strings.ToUpper(comp.Extension()), mr, err)
+		}
+		// no other compression format matches the stream by content
+		for _, other := range []archives.Compression{archives.Gz{}, archives.Bz2{}, archives.Xz{}, archives.Zstd{}, archives.Lz4{}, archives.Brotli{}, archives.Sz{}, archives.Lzip{}, archives.Zlib{}, archives.MinLZ{}} {
+			if other.Extension() == comp.Extension() {
+				continue
+			}
+			mr, err := other.Match(hzCtx, "", bytes.NewReader(out))
+			if err == nil && mr.ByStream {
+				c.failClass(ht, "match other "+other.Extension(), "%s stream (% x) matched by %s", hzFormatName(comp), hzHead(out, 12), other.Extension())
+			}
+		}
+		// Identify
+		f, _, err := archives.Identify(hzCtx, "", bytes.NewReader(out))
+		if headerless {
+			// nothing to identify
+		} else if err != nil {
+			c.failClass(ht, "identify error", "%s stream of %d bytes: Identify: %v", hzFormatName(comp), len(out), err)
+		} else if f.Extension() != comp.Extension() {
+			c.failClass(ht, "identify format", "%s stream of %d bytes: Identify: %s", hzFormatName(comp), len(out), f.Extension())
+		}
+		// the reader
+		r, err := comp.OpenReader(bytes.NewReader(out))
+		if err != nil {
+			c.failClass(ht, "open reader", "%s OpenReader: %v", hzFormatName(comp), err)
+			return
+		}
+		back, err := io.ReadAll(r)
+		r.Close()
+		if err != nil {
+			c.failClass(ht, "read", "%s read: %v (%d of %d bytes)", hzFormatName(comp), err, len(back), len(data))
+		} else if !bytes.Equal(back, data) {
+			c.failClass(ht, "content", "%s: %d bytes back, %d in", hzFormatName(comp), len(back), len(data))
+		}
+		// the reference tool
+		if cmd := hzDecompressCommand(comp); cmd != nil {
+			ec := exec.Command(cmd[0], cmd[1:]...)
+			ec.Stdin = bytes.NewReader(out)
+			var stderr bytes.Buffer
+			ec.Stderr = &stderr
+			ref, err := ec.Output()
+			if err != nil {
+				c.failClass(ht, "tool error", "%s: %s: %v: %s", hzFormatName(comp), strings.Join(cmd, " "), err, hzTrim(stderr.String(), 300))
+			} else if !bytes.Equal(ref, data) {
+				c.failClass(ht, "tool content", "%s: %s gives %d bytes, %d in", hzFormatName(comp), strings.Join(cmd, " "), len(ref), len(data))
+			} else {
+				c.count("tool agreed")
+			}
+		}
+		// gzip members
+		if gz, ok := comp.(archives.Gz); ok {
+			var two bytes.Buffer
+			w1 := hzMust(gz.OpenWriter(&two))
+			w1.Write(data)
+			w1.Close()
+			w2 := hzMust(gz.OpenWriter(&two))
+			w2.Write([]byte("second member"))
+			w2.Close()
+			for _, disable := range []bool{false, true} {
+				g := gz
+				g.DisableMultistream = disable
+				r, err := g.OpenReader(bytes.NewReader(two.Bytes()))
+				if err != nil {
+					c.failClass(ht, "gz members open", "%s DisableMultistream=%v OpenReader: %v", hzFormatName(gz), disable, err)
+					continue
+				}
+				back, err := io.ReadAll(r)
+				r.Close()
+				want := append(append([]byte(nil), data...), []byte("second member")...)
+				if disable {
+					want = data
+				}
+				if err != nil || !bytes.Equal(back, want) {
+					c.failClass(ht, "gz members", "%s DisableMultistream=%v: %d bytes back (err %v), %d wanted", hzFormatName(gz), disable, len(back), err, len(want))
+				}
+			}
+		}
+	})
+}
