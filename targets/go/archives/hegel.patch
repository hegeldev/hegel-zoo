+// lz4LevelCases: Lz4 with CompressionLevel 1..9 (0 past the shape), the wide property's inputs
+// and writes. Nothing earlier in the family reaches Lz4 (9 is a zip's).
+var lz4LevelCases = hegel.FlatMap(hzShaped(rangeHalves(1, 9), hegel.Just(0)), func(level int) hegel.Generator[compressionCase] {
+	f := compFormat{Kind: "lz4", Level: level}
+	return hegel.FlatMap(payloadOf(false, false), func(data []byte) hegel.Generator[compressionCase] {
+		return hegel.Map(piecesDrawn, func(lengths []int) compressionCase { return buildCompressionCase(f, data, lengths) })
+	})
+})
