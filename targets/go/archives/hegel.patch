+package hegel
+
+// The narrow properties: one per recorded bug of the FilesFrom, DeepFS, Identify and
+// Compression families, each a generator over the bug's shape region with random
+// surroundings (the ingredient forced; the shapes of the earlier ids it would otherwise be
+// named by excluded: the strict pools), judged by the family's expected function and judge;
+// each fails every run by default with the shape of its bug, and under HEGEL_NO_KNOWN=1
+// draws the neighbouring region (hzShaped) and passes.
+
+import (
+	"archive/zip"
+	"io/fs"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/mholt/archives"
