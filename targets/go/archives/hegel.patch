+package hegel
+
+// One pin per recorded bug (bugs.toml). Each asserts the documented behaviour and fails while
+// the bug exists (target.toml lists them as expected failures).
+
+import (
+	"archive/tar"
+	"archive/zip"
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"io/fs"
+	"math/rand"
