+	data := hzPinArchive(t, z, hzPinFiles(t, map[string]string{"a.txt": "a"}))
+	rw := &hzBuffer{buf: append([]byte(nil), data...)}
+	body := bytes.Repeat([]byte("compressible text "), 100)
+	if err := z.Insert(context.Background(), rw, hzPinFiles(t, map[string]string{"b.txt": string(body)})); err != nil {
+		t.Fatalf("Insert: %v", err)
+	}
+	got, err := hzExtractAll(z, rw.buf)
+	if err != nil {
+		t.Fatalf("Extract: %v", err)
+	}
+	h := got[1].header.(kzip.FileHeader)
+	if h.Method != zip.Deflate {
+		t.Fatalf("the inserted file has method %d, Compression asked for %d", h.Method, zip.Deflate)
+	}
+}
+
+// archives/12
+func TestHegelPinZipInsertCustomMethod(t *testing.T) {
