+// archives/13
+func TestHegelPinZipInsertSymlink(t *testing.T) {
+	data := hzPinArchive(t, archives.Zip{}, hzPinFiles(t, map[string]string{"a.txt": "a"}))
+	rw := &hzBuffer{buf: append([]byte(nil), data...)}
+	files := hzPinFiles(t, map[string]string{"t.txt": "target content", "l": "-> t.txt"})
+	var link []archives.FileInfo
+	for _, f := range files {
+		if f.NameInArchive == "l" {
+			link = append(link, f)
+		}
+	}
+	if err := (archives.Zip{}).Insert(context.Background(), rw, link); err != nil {
+		t.Fatalf("Insert of a link: %v", err)
+	}
+	got, err := hzExtractAll(archives.Zip{}, rw.buf)
+	if err != nil {
+		t.Fatalf("Extract: %v", err)
+	}
+	if got[1].link != "t.txt" {
+		t.Fatalf("the inserted link l points at %q, want t.txt", got[1].link)
+	}
+}
+
+// archives/14
+func TestHegelPinFsRootDotLeadingSlash(t *testing.T) {
