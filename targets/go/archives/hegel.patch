+// --------------------------------------------------------------------------- archives/19
+
+// misnamedContents is a content with a definite format: a compressed stream of a non-empty
+// input (24 out of the pool) with random bytes under a kibibyte (25 out), a tar or a zip of
+// one to four entries (9 out), a tar under a compression; Lz4 at level 0 (10 out); nothing
+// truncated (20 out).
+var misnamedContents = halvesGens([]int{1, 1, 1, 1},
+	hegel.FlatMap(compFormatsOf(false), func(f compFormat) hegel.Generator[identifyContent] {
+		return hegel.Map(payloadOf(true, true), func(p []byte) identifyContent { return identifyContent{Kind: "stream", Comp: f, Payload: p} })
+	}),
+	hegel.FlatMap(tarFormats, func(a archFormat) hegel.Generator[identifyContent] {
+		return hegel.Map(treesBetween(1, 4), func(tree []fileEntry) identifyContent { return buildArchiveContent(a, tree, compFormat{}) })
+	}),
+	hegel.FlatMap(zipFormats, func(a archFormat) hegel.Generator[identifyContent] {
+		return hegel.Map(treesBetween(1, 4), func(tree []fileEntry) identifyContent { return buildArchiveContent(a, tree, compFormat{}) })
+	}),
+	hegel.FlatMap(tarFormats, func(a archFormat) hegel.Generator[identifyContent] {
+		return hegel.FlatMap(treesBetween(1, 4), func(tree []fileEntry) hegel.Generator[identifyContent] {
+			return hegel.Map(compFormatsOf(false), func(f compFormat) identifyContent { return buildArchiveContent(a, tree, f) })
+		})
+	}))
+
+// misnamedNames is a name that contradicts the content: "x" or "x.tar" with another
+// compression's extension (Brotli's left out: it has no magic, and a stream wrongly named
+// .br is matched by its heuristic as often as not), or another archive's extension for an
+// archive; past the shape, the content's own name.
+func misnamedNames(ct identifyContent) hegel.Generator[string] {
+	if hzNoKnown {
+		return hegel.Just("x" + contentExt(ct))
+	}
+	var names []string
+	for _, kind := range compKinds {
+		if kind == ct.Comp.Kind || kind == "br" {
+			continue
+		}
+		ext := compFormat{Kind: kind}.Ext()
+		names = append(names, "x"+ext, "x.tar"+ext)
+	}
+	switch {
+	case ct.Kind == "archive" && ct.Arch.Kind == "zip":
+		names = append(names, "x.tar", "x.7z", "x.rar")
+	case ct.Kind == "archive":
+		names = append(names, "x.zip", "x.7z", "x.rar")
+	}
+	return evenHalves(names...)
+}
+
+// misnamedCases: a content of misnamedContents under a name that contradicts it.
+var misnamedCases = hegel.FlatMap(misnamedContents, func(ct identifyContent) hegel.Generator[identifyCase] {
+	return hegel.Map(misnamedNames(ct), func(name string) identifyCase { return identifyCase{Content: ct, Name: name} })
+})
