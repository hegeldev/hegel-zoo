+)
+
+var hzCtx = context.Background()
+
+// --------------------------------------------------------------------------- round trip
+
+// TestHegelArchiveRoundTrip: a tree gathered with FilesFromFS, archived with Tar or Zip (Tar
+// also under every compression format), comes back from Extract entry for entry: names, kinds,
+// contents, link targets, permissions, times and the header fields the options set. Identify
+// names the format from the bytes, and returns them unread; the archive is a file system
+// (ArchiveFS) that testing/fstest accepts; Python's tarfile/zipfile read the same entries.
+func TestHegelArchiveRoundTrip(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		tree := hzGenTree(ht, 10)
+		mfs := hzMapFS(tree)
+		opts := &archives.FromFSOptions{ClearAttributes: hzChance(ht, 30)}
+		files, err := archives.FilesFromFS(hzCtx, mfs, opts, nil)
+		if err != nil {
+			c.failClass(ht, "FilesFromFS error", "FilesFromFS: %v\n%s", err, hzTreeString(tree))
+			return
+		}
+		archival := hzArchival(ht)
+		var format archives.Format = archival
+		var comp archives.Compression
+		if _, isTar := archival.(archives.Tar); isTar && hzChance(ht, 50) {
+			comp = hzCompression(ht)
+			format = archives.CompressedArchive{Archival: archival, Extraction: archival, Compression: comp}
+		}
+		c.count("format " + hzFormatName(format))
+
+		var buf bytes.Buffer
+		if err := format.(archives.Archiver).Archive(hzCtx, &buf, files); err != nil {
+			if strings.Contains(err.Error(), "USTAR cannot encode") {
+				c.count("archive: USTAR cannot encode a name (by design)")
+				return
+			}
+			c.failClass(ht, "archive error", "%s Archive: %v\n%s", hzFormatName(format), err, hzTreeString(tree))
+			return
+		}
+		data := buf.Bytes()
+
+		got, err := hzExtractAll(format.(archives.Extractor), data)
+		if err != nil {
+			c.failClass(ht, "extract error", "%s Extract: %v\n%s", hzFormatName(format), err, hzTreeString(tree))
+			return
+		}
+		if len(got) != len(files) {
+			c.failClass(ht, "entry count", "%s: %d entries in, %d out\nin: %v\nout: %v", hzFormatName(format), len(files), len(got), hzFileNames(files), hzGotNames(got))
+			return
+		}
+		_, isZip := archival.(archives.Zip)
+		for i, in := range files {
+			out := got[i]
+			where := fmt.Sprintf("%s entry %d (%q)", hzFormatName(format), i, in.NameInArchive)
+			wantName := in.NameInArchive
+			if isZip && in.IsDir() {
+				wantName += "/"
+			}
+			if out.name != wantName {
+				c.failClass(ht, "name", "%s: name %q out", where, out.name)
+				continue
+			}
+			if out.isDir != in.IsDir() {
+				c.failClass(ht, "kind dir", "%s: IsDir %v in, %v out", where, in.IsDir(), out.isDir)
+				continue
+			}
+			inLink := in.Mode()&fs.ModeSymlink != 0
+			if out.isLink != inLink {
+				c.failClass(ht, "kind link", "%s: symlink %v in, %v out (mode %v)", where, inLink, out.isLink, out.mode)
+				continue
+			}
+			if inLink && out.link != in.LinkTarget {
+				c.failClass(ht, "link target", "%s: link target %q in, %q out", where, in.LinkTarget, out.link)
+			}
+			if !in.IsDir() && !inLink {
+				want, _ := fs.ReadFile(mfs, in.NameInArchive)
+				if !bytes.Equal(out.data, want) {
+					c.failClass(ht, "content", "%s: %d bytes in, %d out (equal prefix %d)", where, len(want), len(out.data), hzCommonPrefix(want, out.data))
+				}
+				if out.size != int64(len(want)) {
+					c.failClass(ht, "size", "%s: size %d in, %d out", where, len(want), out.size)
+				}
+			}
+			if out.mode.Perm() != in.Mode().Perm() {
+				c.failClass(ht, "mode", "%s: mode %v in, %v out", where, in.Mode(), out.mode)
+			}
+			if !opts.ClearAttributes && !inLink && !out.mtime.Equal(in.ModTime()) {
+				c.failClass(ht, "mtime", "%s: mtime %v in, %v out", where, in.ModTime(), out.mtime)
+			}
+			switch h := out.header.(type) {
+			case *tar.Header:
+				tf := archival.(archives.Tar)
+				// a PAX header without extended records is a USTAR block: archive/tar reads it back as USTAR
+				if tf.Format != 0 && h.Format != tf.Format && !(tf.Format == tar.FormatPAX && h.Format == tar.FormatUSTAR) {
+					c.failClass(ht, "tar format", "%s: format %v asked, %v written", where, tf.Format, h.Format)
+				}
+				if h.Uid != tf.Uid || h.Gid != tf.Gid || h.Uname != tf.Uname || h.Gname != tf.Gname {
+					c.failClass(ht, "tar owner", "%s: owner %d/%d %q/%q asked, %d/%d %q/%q written", where, tf.Uid, tf.Gid, tf.Uname, tf.Gname, h.Uid, h.Gid, h.Uname, h.Gname)
+				}
+			case kzip.FileHeader:
+				zf := archival.(archives.Zip)
+				want := zf.Compression
+				if in.IsDir() {
+					want = zip.Store
+				} else if zf.SelectiveCompression && hzCompressedExt(in.NameInArchive) {
+					want = zip.Store
+				}
+				if h.Method != want {
+					c.failClass(ht, "zip method", "%s: method %d wanted, %d written", where, want, h.Method)
+				}
+			default:
+				c.failClass(ht, "header type", "%s: header %T", where, out.header)
+			}
+		}
+
+		// Identify from the bytes, named and unnamed, seekable and not
+		for _, name := range []string{"", "x" + format.Extension(), "X" + strings.ToUpper(format.Extension()), "noext"} {
+			for _, seekable := range []bool{true, false} {
+				var r io.Reader = bytes.NewReader(data)
+				if !seekable {
+					r = struct{ io.Reader }{bytes.NewReader(data)}
+				}
+				f, rest, err := archives.Identify(hzCtx, name, r)
+				where := fmt.Sprintf("%s Identify(%q, seekable=%v) on %d bytes", hzFormatName(format), name, seekable, len(data))
+				named := name == "x"+format.Extension() || name == "X"+strings.ToUpper(format.Extension())
+				if err != nil {
+					if len(files) == 0 && !isZip && !named {
+						// an empty tar is 1024 zero bytes: nothing for a stream match to see
+						c.count("identify: empty tar unnamed NoMatch")
+						continue
+					}
+					if len(files) == 0 && isZip && !named && HZKnown.zipEmptyStreamMatch {
+						hzAvoid("zipEmptyStreamMatch")
+						continue
+					}
+					c.failClass(ht, "identify error", "%s: %v", where, err)
+					continue
+				}
+				if f.Extension() != format.Extension() {
+					if len(files) == 0 && comp != nil && f.Extension() == comp.Extension() && !named {
+						c.count("identify: empty tar under compression is the compression only")
+						continue
+					}
+					c.failClass(ht, "identify format", "%s: got %s", where, hzFormatName(f))
+					continue
+				}
+				back, err := io.ReadAll(rest)
+				if err != nil || !bytes.Equal(back, data) {
+					c.failClass(ht, "identify stream", "%s: the returned reader gives %d bytes (equal prefix %d), err %v", where, len(back), hzCommonPrefix(back, data), err)
+				}
+			}
+		}
+
+		// the archive as a file system
+		var expect []string
+		for _, in := range files {
+			expect = append(expect, in.NameInArchive)
+		}
+		afs := &archives.ArchiveFS{Stream: io.NewSectionReader(bytes.NewReader(data), 0, int64(len(data))), Format: format.(archives.Extractor)}
+		if err := fstest.TestFS(afs, expect...); err != nil {
+			if rest := hzTestFSUnknown(err); rest != "" {
+				for _, cls := range hzTestFSClasses(err) {
+					c.count("TestFS " + cls)
+				}
+				c.failClass(ht, "TestFS", "%s: TestFS on the archive:\n%v\n%s", hzFormatName(format), hzTrim(rest, 2500), hzTreeString(tree))
+			}
+		}
+
+		// Python reads the archive
+		if py := hzPythonReader(format); py != "" && hzPython() != "" {
+			if msg := hzPythonCheck(py, data, files, isZip); msg != "" {
+				c.failClass(ht, "python", "%s: %s\n%s", hzFormatName(format), msg, hzTreeString(tree))
+			} else {
+				c.count("python agreed")
+			}
+		}
+	})
+}
+
+func hzTreeString(t *hzTree) string {
+	var b strings.Builder
+	for _, e := range t.entries {
+		fmt.Fprintf(&b, "%c %q mode %o", e.kind, e.path, e.mode)
+		if e.kind == 'f' {
+			fmt.Fprintf(&b, " (%d bytes)", len(e.data))
+		}
+		if e.kind == 'l' {
+			fmt.Fprintf(&b, " -> %q", e.link)
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+func hzFileNames(fs []archives.FileInfo) []string {
+	var ns []string
+	for _, f := range fs {
+		ns = append(ns, f.NameInArchive)
+	}
+	return ns
+}
+
+func hzCommonPrefix(a, b []byte) int {
+	i := 0
+	for i < len(a) && i < len(b) && a[i] == b[i] {
+		i++
+	}
+	return i
+}
+
+func hzTrim(s string, n int) string {
+	if len(s) > n {
+		return s[:n] + "..."
+	}
+	return s
+}
+
+// hzCompressedExt mirrors zip.go's compressedFormats set for the names the generator uses.
+func hzCompressedExt(name string) bool {
+	switch strings.ToLower(path.Ext(name)) {
+	case ".7z", ".avi", ".br", ".bz2", ".cab", ".docx", ".gif", ".gz", ".jar", ".jpeg", ".jpg", ".lz", ".lz4", ".lzma",
+		".m4v", ".mov", ".mp3", ".mp4", ".mpeg", ".mpg", ".png", ".pptx", ".rar", ".sz", ".tbz2", ".tgz", ".tsz", ".txz",
+		".xlsx", ".xz", ".zip", ".zipx":
+		return true
+	}
+	return false
+}
+
+// hzTestFSUnknown drops the lines of a TestFS report that the recorded bugs explain (while
+// their switches are on) and returns the rest, "" when nothing is left.
+func hzTestFSUnknown(err error) string {
+	var rest []string
+	for _, line := range strings.Split(err.Error(), "\n") {
+		l := strings.TrimSpace(line)
+		switch {
+		case l == "" || l == "TestFS found errors:":
+			continue
+		case strings.Contains(l, "ReadDir(-1) at EOF") && HZKnown.dirFileReadDirRest:
+			hzAvoid("dirFileReadDirRest")
+			continue
+		}
+		rest = append(rest, line)
+	}
+	return strings.Join(rest, "\n")
+}
+
+// hzTestFSClasses names the kinds of error in a TestFS report.
+func hzTestFSClasses(err error) []string {
+	seen := map[string]bool{}
+	var out []string
+	for _, line := range strings.Split(err.Error(), "\n") {
+		line = strings.TrimSpace(line)
+		var cls string
+		switch {
+		case strings.Contains(line, "not a fs.ReadDirFile"):
+			cls = "open dir not ReadDirFile"
+		case strings.Contains(line, "expected but not found"):
+			cls = "expected not found"
+		case strings.HasSuffix(line, "mismatch:"):
+			cls = "entry mismatch"
+		case strings.Contains(line, "ReadDir(-1) at EOF"):
+			cls = "ReadDir at EOF"
+		case strings.Contains(line, "Stat"):
+			cls = "stat"
+		case strings.Contains(line, "ReadDir"):
+			cls = "readdir"
+		case strings.Contains(line, "Open"):
+			cls = "open"
+		default:
+			continue
+		}
+		if !seen[cls] {
+			seen[cls] = true
+			out = append(out, cls)
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- python
+
+var (
+	hzPythonOnce sync.Once
+	hzPythonPath string
+)
+
+func hzPython() string {
+	hzPythonOnce.Do(func() {
+		p, err := exec.LookPath("python3")
+		if err == nil {
+			hzPythonPath = p
+		}
+	})
+	return hzPythonPath
+}
+
+// hzPythonReader returns the Python module able to read the format, or "".
+func hzPythonReader(f archives.Format) string {
+	switch f.(type) {
+	case archives.Zip:
+		if f.(archives.Zip).Compression == archives.ZipMethodZstd || f.(archives.Zip).Compression == archives.ZipMethodXz {
+			return ""
+		}
+		return "zipfile"
+	case archives.Tar:
+		return "tarfile"
+	case archives.CompressedArchive:
+		switch f.(archives.CompressedArchive).Compression.(type) {
+		case archives.Gz, archives.Bz2, archives.Xz:
+			return "tarfile"
+		}
+	}
+	return ""
+}
+
+const hzPyScript = `
+import sys, io, json, tarfile, zipfile, hashlib
+data = sys.stdin.buffer.read()
+out = []
+if sys.argv[1] == "tarfile":
+    with tarfile.open(fileobj=io.BytesIO(data), mode="r:*") as tf:
+        for m in tf:
+            kind = "d" if m.isdir() else "l" if m.issym() else "f" if m.isfile() else "?"
+            h = ""
+            if kind == "f":
+                h = hashlib.sha256(tf.extractfile(m).read()).hexdigest()
+            out.append({"name": m.name, "kind": kind, "size": m.size, "link": m.linkname, "sha": h, "mode": m.mode & 0o777})
+else:
+    with zipfile.ZipFile(io.BytesIO(data)) as zf:
+        for m in zf.infolist():
+            mode = (m.external_attr >> 16) & 0o170000
+            kind = "d" if m.is_dir() else "l" if mode == 0o120000 else "f"
+            h = ""
+            if kind == "f":
+                h = hashlib.sha256(zf.read(m)).hexdigest()
+            link = zf.read(m).decode("utf-8", "replace") if kind == "l" else ""
+            out.append({"name": m.filename, "kind": kind, "size": m.file_size, "link": link, "sha": h, "mode": (m.external_attr >> 16) & 0o777})
+json.dump(out, sys.stdout)
+`
+
+type hzPyEntry struct {
+	Name string `json:"name"`
+	Kind string `json:"kind"`
+	Size int64  `json:"size"`
+	Link string `json:"link"`
+	Sha  string `json:"sha"`
+	Mode int    `json:"mode"`
+}
+
+func hzPythonCheck(module string, data []byte, files []archives.FileInfo, isZip bool) string {
+	cmd := exec.Command(hzPython(), "-c", hzPyScript, module)
+	cmd.Stdin = bytes.NewReader(data)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if err != nil {
+		return fmt.Sprintf("python %s failed: %v\n%s", module, err, hzTrim(stderr.String(), 1500))
+	}
+	var got []hzPyEntry
+	if err := json.Unmarshal(out, &got); err != nil {
+		return fmt.Sprintf("python output: %v: %s", err, hzTrim(string(out), 500))
+	}
+	if len(got) != len(files) {
+		return fmt.Sprintf("python sees %d entries, %d archived: %v vs %v", len(got), len(files), hzPyNames(got), hzFileNames(files))
+	}
+	for i, in := range files {
+		g := got[i]
+		wantName := in.NameInArchive
+		if isZip && in.IsDir() {
+			wantName += "/"
+		}
+		if g.Name != wantName {
+			return fmt.Sprintf("python entry %d: name %q (archived %q)", i, g.Name, wantName)
+		}
+		kind := "f"
+		if in.IsDir() {
+			kind = "d"
+		} else if in.Mode()&fs.ModeSymlink != 0 {
+			kind = "l"
+		}
+		if g.Kind != kind {
+			return fmt.Sprintf("python entry %d (%q): kind %s (archived %s)", i, g.Name, g.Kind, kind)
+		}
+		if kind == "l" && g.Link != in.LinkTarget {
+			return fmt.Sprintf("python entry %d (%q): link %q (archived %q)", i, g.Name, g.Link, in.LinkTarget)
+		}
+		if kind == "f" {
+			if g.Size != in.Size() {
+				return fmt.Sprintf("python entry %d (%q): size %d (archived %d)", i, g.Name, g.Size, in.Size())
+			}
+			r, err := in.Open()
+			if err != nil {
+				return fmt.Sprintf("open %q: %v", in.NameInArchive, err)
+			}
+			b, _ := io.ReadAll(r)
+			r.Close()
+			if g.Sha != hzSha(b) {
+				return fmt.Sprintf("python entry %d (%q): content differs", i, g.Name)
+			}
+		}
+		if fs.FileMode(g.Mode) != in.Mode().Perm() {
+			return fmt.Sprintf("python entry %d (%q): mode %o (archived %o)", i, g.Name, g.Mode, in.Mode().Perm())
+		}
+	}
+	return ""
+}
+
+func hzSha(b []byte) string {
+	s := sha256.Sum256(b)
+	return hex.EncodeToString(s[:])
+}
+
+func hzPyNames(es []hzPyEntry) []string {
+	var ns []string
+	for _, e := range es {
+		ns = append(ns, e.Name)
+	}
+	return ns
+}
+
+// --------------------------------------------------------------------------- ArchiveFS
+
+// TestHegelArchiveFS: an archive written by hand (implicit directories, entries out of order,
+// "./" prefixes, a "." entry, directories with and without a trailing slash) read through
+// ArchiveFS behaves as the file system of the paths it holds: fs.WalkDir visits every path
+// once with the right kind, Stat and Open work before and after the index is built, ReadDir
+// lists the children sorted, missing names are ErrNotExist, Sub roots a subtree, and
+// testing/fstest accepts it.
+func TestHegelArchiveFS(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		useZip := hzChance(ht, 40)
+		a := hzGenRawArchive(ht, useZip)
+		var data []byte
+		var format archives.Extractor
+		if useZip {
+			data = a.writeZip()
+			format = archives.Zip{}
+			c.count("zip")
+		} else {
+			data = a.writeTar(hzPick(ht, []tar.Format{tar.FormatUSTAR, tar.FormatPAX, tar.FormatGNU}))
+			format = archives.Tar{}
+			c.count("tar")
+		}
+		fresh := func() *archives.ArchiveFS {
+			return &archives.ArchiveFS{Stream: io.NewSectionReader(bytes.NewReader(data), 0, int64(len(data))), Format: format}
+		}
+		desc := func() string { return fmt.Sprintf("%T archive:\n%s", format, a.String()) }
+
+		// the walk (through ReadDir, which indexes)
+		indexed := fresh()
+		var visited []string
+		kinds := map[string]bool{}
+		err := fs.WalkDir(indexed, ".", func(p string, d fs.DirEntry, err error) error {
+			if err != nil {
+				return fmt.Errorf("at %q: %w", p, err)
+			}
+			if p != "." {
+				visited = append(visited, p)
+				kinds[p] = d.IsDir()
+			}
+			return nil
+		})
+		if err != nil {
+			c.failClass(ht, "walk error", "WalkDir: %v\n%s", err, desc())
+			return
+		}
+		sort.Strings(visited)
+		want := a.modelPaths()
+		if strings.Join(visited, "\n") != strings.Join(want, "\n") {
+			c.failClass(ht, "walk paths", "WalkDir visited %q\nmodel %q\n%s", visited, want, desc())
+			return
+		}
+		for _, p := range want {
+			_, isDir := a.dirs[p]
+			if kinds[p] != isDir {
+				c.failClass(ht, "walk kind", "WalkDir: %q IsDir %v, model %v\n%s", p, kinds[p], isDir, desc())
+			}
+		}
+
+		// Stat, before and after indexing
+		for _, p := range want {
+			explicit, isDir := a.dirs[p]
+			for _, mode := range []string{"fresh", "indexed"} {
+				fsys := indexed
+				if mode == "fresh" {
+					fsys = fresh()
+				}
+				info, err := fsys.Stat(p)
+				if err != nil {
+					c.failClass(ht, "stat error", "%s Stat(%q): %v\n%s", mode, p, err, desc())
+					continue
+				}
+				if info.IsDir() != isDir {
+					c.failClass(ht, "stat kind", "%s Stat(%q): IsDir %v, model %v\n%s", mode, p, info.IsDir(), isDir, desc())
+				}
+				if isDir && !explicit && HZKnown.statImplicitDirName {
+					hzAvoid("statImplicitDirName")
+				} else if info.Name() != path.Base(p) {
+					c.failClass(ht, "stat name", "%s Stat(%q): Name() %q\n%s", mode, p, info.Name(), desc())
+				}
+			}
+		}
+		// Stat of names that do not exist: a prefix of a name, a child of a file, a sibling
+		for _, p := range want {
+			var missing []string
+			if b := path.Base(p); len(b) > 1 {
+				missing = append(missing, path.Join(path.Dir(p), b[:len(b)-1]))
+			}
+			if _, isDir := a.dirs[p]; !isDir {
+				missing = append(missing, p+"/zz")
+			}
+			missing = append(missing, p+"zz")
+			for _, m := range missing {
+				if hzModelHas(a, m) {
+					continue
+				}
+				for _, mode := range []string{"fresh", "indexed"} {
+					fsys := indexed
+					if mode == "fresh" {
+						fsys = fresh()
+					}
+					info, err := fsys.Stat(m)
+					if err == nil && mode == "fresh" && a.hasEntryPrefix(m) && HZKnown.statPrefixMissing {
+						hzAvoid("statPrefixMissing")
+					} else if err == nil {
+						c.failClass(ht, "stat missing", "%s Stat(%q) of a missing name: %q dir=%v\n%s", mode, m, info.Name(), info.IsDir(), desc())
+					}
+					if _, err := fsys.Open(m); err == nil {
+						c.failClass(ht, "open missing", "%s Open(%q) of a missing name succeeds\n%s", mode, m, desc())
+					}
+				}
+			}
+		}
+
+		// Open + read files, fresh and indexed; Open + ReadDir directories
+		for _, p := range want {
+			if content, isFile := a.files[p]; isFile {
+				if _, isLink := a.links[p]; isLink {
+					continue
+				}
+				for _, mode := range []string{"fresh", "indexed"} {
+					fsys := indexed
+					if mode == "fresh" {
+						fsys = fresh()
+					}
+					got, err := fs.ReadFile(fsys, p)
+					if err != nil {
+						c.failClass(ht, "readfile error", "%s ReadFile(%q): %v\n%s", mode, p, err, desc())
+					} else if !bytes.Equal(got, content) {
+						c.failClass(ht, "readfile content", "%s ReadFile(%q): %d bytes, model %d\n%s", mode, p, len(got), len(content), desc())
+					}
+				}
+				continue
+			}
+			for _, mode := range []string{"fresh", "indexed"} {
+				fsys := indexed
+				if mode == "fresh" {
+					fsys = fresh()
+					if a.descendantBeforeDir(p) && HZKnown.openImplicitDirFile {
+						hzAvoid("openImplicitDirFile")
+						continue
+					}
+					if a.hasImplicitSubdir(p) && HZKnown.openDirFreshEntries {
+						hzAvoid("openDirFreshEntries")
+						continue
+					}
+				}
+				f, err := fsys.Open(p)
+				if err != nil {
+					c.failClass(ht, "open dir error", "%s Open(%q): %v\n%s", mode, p, err, desc())
+					continue
+				}
+				rdf, ok := f.(fs.ReadDirFile)
+				if !ok {
+					f.Close()
+					c.failClass(ht, "open dir type", "%s Open(%q) of a directory: %T, not a ReadDirFile\n%s", mode, p, f, desc())
+					continue
+				}
+				ents, err := rdf.ReadDir(-1)
+				f.Close()
+				if err != nil {
+					c.failClass(ht, "open dir readdir error", "%s Open(%q).ReadDir(-1): %v\n%s", mode, p, err, desc())
+					continue
+				}
+				got := hzEntryNames(ents)
+				sort.Strings(got) // a ReadDirFile lists in directory order, which need not be sorted
+				if strings.Join(got, "\n") != strings.Join(a.children(p), "\n") {
+					c.failClass(ht, "open dir entries", "%s Open(%q).ReadDir(-1): %q, model %q\n%s", mode, p, got, a.children(p), desc())
+				}
+			}
+			ents, err := fs.ReadDir(indexed, p)
+			if err != nil {
+				c.failClass(ht, "readdir error", "ReadDir(%q): %v\n%s", p, err, desc())
+			} else if got := hzEntryNames(ents); strings.Join(got, "\n") != strings.Join(a.children(p), "\n") {
+				c.failClass(ht, "readdir entries", "ReadDir(%q): %q, model %q\n%s", p, got, a.children(p), desc())
+			}
+		}
+		if got := hzEntryNames(hzMust(fs.ReadDir(indexed, "."))); strings.Join(got, "\n") != strings.Join(a.children("."), "\n") {
+			c.failClass(ht, "readdir root", "ReadDir(\".\"): %q, model %q\n%s", got, a.children("."), desc())
+		}
+
+		// Sub
+		if len(a.dirs) > 0 {
+			ds := make([]string, 0, len(a.dirs))
+			for d := range a.dirs {
+				ds = append(ds, d)
+			}
+			sort.Strings(ds)
+			d := hzPick(ht, ds)
+			sub, err := fresh().Sub(d)
+			if err != nil {
+				c.failClass(ht, "sub error", "Sub(%q): %v\n%s", d, err, desc())
+			} else {
+				var got []string
+				err := fs.WalkDir(sub, ".", func(p string, de fs.DirEntry, err error) error {
+					if err != nil {
+						return err
+					}
+					if p != "." {
+						got = append(got, p)
+					}
+					return nil
+				})
+				var wantSub []string
+				for _, p := range want {
+					if strings.HasPrefix(p, d+"/") {
+						wantSub = append(wantSub, p[len(d)+1:])
+					}
+				}
+				sort.Strings(got)
+				if err != nil {
+					c.failClass(ht, "sub walk error", "Sub(%q) WalkDir: %v\n%s", d, err, desc())
+				} else if strings.Join(got, "\n") != strings.Join(wantSub, "\n") {
+					c.failClass(ht, "sub walk", "Sub(%q) WalkDir: %q, model %q\n%s", d, got, wantSub, desc())
+				}
+			}
+		}
+
+		// testing/fstest (its Open of directories before the index is built meets the recorded bugs)
+		files := a.modelPaths()
+		skipTestFS := false
+		for d := range a.dirs {
+			if (a.descendantBeforeDir(d) && HZKnown.openImplicitDirFile) || (a.hasImplicitSubdir(d) && HZKnown.openDirFreshEntries) {
+				skipTestFS = true
+			}
+		}
+		if skipTestFS {
+			hzAvoid("openImplicitDirFile")
+		} else if err := fstest.TestFS(fresh(), files...); err != nil {
+			if rest := hzTestFSUnknown(err); rest != "" {
+				for _, cls := range hzTestFSClasses(err) {
+					c.count("TestFS " + cls)
+				}
+				c.failClass(ht, "TestFS", "TestFS:\n%v\n%s", hzTrim(rest, 2500), desc())
+			}
+		}
+	})
+}
+
+// hasEntryPrefix reports whether some entry's clean name starts with the string s.
+func (a *hzRawArchive) hasEntryPrefix(s string) bool {
+	for _, e := range a.entries {
+		if strings.HasPrefix(path.Clean(e.name), s) {
+			return true
+		}
+	}
+	return false
+}
+
+// descendantBeforeDir reports whether dir has no entry of its own, or some entry under it
+// comes before its own entry.
+func (a *hzRawArchive) descendantBeforeDir(dir string) bool {
+	own := -1
+	first := -1
+	for i, e := range a.entries {
+		n := path.Clean(e.name)
+		if n == dir {
+			own = i
+		} else if strings.HasPrefix(n, dir+"/") && first < 0 {
+			first = i
+		}
+	}
+	return own < 0 || (first >= 0 && first < own)
+}
+
+// hasImplicitSubdir reports whether some directory under dir has no entry of its own, or an
+// entry after one of its descendants, or whether an entry under dir is written with a "./"
+// prefix: the shapes on which Open before the index lists descendants as children.
+func (a *hzRawArchive) hasImplicitSubdir(dir string) bool {
+	for d := range a.dirs {
+		if strings.HasPrefix(d, dir+"/") && a.descendantBeforeDir(d) {
+			return true
+		}
+	}
+	for _, e := range a.entries {
+		if strings.HasPrefix(e.name, "./") && strings.HasPrefix(path.Clean(e.name), dir+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+// hzZipName is the name Zip writes for a FileInfo.
+func hzZipName(f archives.FileInfo) string {
+	if f.IsDir() {
+		return f.NameInArchive + "/"
+	}
+	return f.NameInArchive
+}
+
+func hzModelHas(a *hzRawArchive, p string) bool {
+	if _, ok := a.files[p]; ok {
+		return true
+	}
+	_, ok := a.dirs[p]
+	return ok
+}
+
+func hzEntryNames(ents []fs.DirEntry) []string {
+	var ns []string
+	for _, e := range ents {
+		ns = append(ns, e.Name())
+	}
+	return ns
+}
+
+func hzMust[T any](v T, err error) T {
+	if err != nil {
+		panic(err)
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- Insert
+
+// TestHegelInsert: files inserted into an existing Tar or Zip archive come out of Extract after
+// the archive's own entries (Zip: replacing entries of the same name), and the archive stays
+// readable.
+func TestHegelInsert(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		base := hzGenTree(ht, 6)
+		extra := hzGenTree(ht, 4)
+		baseFiles, err := archives.FilesFromFS(hzCtx, hzMapFS(base), nil, nil)
+		if err != nil {
+			ht.Fatalf("FilesFromFS: %v", err)
+		}
+		extraFiles, err := archives.FilesFromFS(hzCtx, hzMapFS(extra), nil, nil)
+		if err != nil {
+			ht.Fatalf("FilesFromFS: %v", err)
+		}
+		archival := hzArchival(ht)
+		c.count(hzFormatName(archival))
+		_, isZip := archival.(archives.Zip)
+		if !isZip && HZKnown.tarInsertBlockAligned {
+			aligned := len(baseFiles) == 0
+			if n := len(baseFiles); n > 0 {
+				last := baseFiles[n-1]
+				aligned = !last.Mode().IsRegular() || last.Size()%512 == 0
+			}
+			if aligned {
+				hzAvoid("tarInsertBlockAligned")
+				return
+			}
+		}
+		if isZip && HZKnown.zipInsertDirStops {
+			for _, e := range extraFiles {
+				if e.IsDir() {
+					hzAvoid("zipInsertDirStops")
+					return
+				}
+			}
+		}
+		if zf, ok := archival.(archives.Zip); ok && zf.Compression != zip.Store && zf.Compression != zip.Deflate && zf.SelectiveCompression && HZKnown.zipInsertCustomMethod {
+			hzAvoid("zipInsertCustomMethod")
+			return
+		}
+		if isZip && HZKnown.zipInsertSymlink {
+			for _, e := range extraFiles {
+				if e.Mode()&fs.ModeSymlink != 0 {
+					hzAvoid("zipInsertSymlink")
+					return
+				}
+			}
+		}
+		var buf bytes.Buffer
+		if err := archival.Archive(hzCtx, &buf, baseFiles); err != nil {
+			if strings.Contains(err.Error(), "USTAR cannot encode") {
+				c.count("archive: USTAR cannot encode a name (by design)")
+				return
+			}
+			c.failClass(ht, "archive error", "%s Archive: %v", hzFormatName(archival), err)
+			return
+		}
+		rw := &hzBuffer{buf: append([]byte(nil), buf.Bytes()...)}
+		if err := archival.(archives.Inserter).Insert(hzCtx, rw, extraFiles); err != nil {
+			if strings.Contains(err.Error(), "USTAR cannot encode") {
+				c.count("insert: USTAR cannot encode a name (by design)")
+				return
+			}
+			kind := "tar"
+			if isZip {
+				kind = "zip"
+			}
+			c.failClass(ht, "insert error "+kind, "%s Insert: %v\nbase:\n%sextra:\n%s", hzFormatName(archival), err, hzTreeString(base), hzTreeString(extra))
+			return
+		}
+		got, err := hzExtractAll(archival, rw.buf)
+		if err != nil {
+			c.failClass(ht, "extract error", "%s Extract after Insert: %v (%d entries read)\nbase:\n%sextra:\n%s", hzFormatName(archival), err, len(got), hzTreeString(base), hzTreeString(extra))
+			return
+		}
+		// the model: base entries (Zip: minus those replaced), then the extra ones
+		var want []archives.FileInfo
+		for _, b := range baseFiles {
+			replaced := false
+			if isZip {
+				for _, e := range extraFiles {
+					if hzZipName(e) == hzZipName(b) {
+						replaced = true
+					}
+				}
+			}
+			if !replaced {
+				want = append(want, b)
+			}
+		}
+		want = append(want, extraFiles...)
+		if len(got) != len(want) {
+			c.failClass(ht, "entry count", "%s: %d entries expected after Insert, %d read\nwant %v\ngot %v", hzFormatName(archival), len(want), len(got), hzFileNames(want), hzGotNames(got))
+			return
+		}
+		for i, in := range want {
+			out := got[i]
+			where := fmt.Sprintf("%s entry %d (%q) after Insert", hzFormatName(archival), i, in.NameInArchive)
+			if strings.TrimSuffix(out.name, "/") != in.NameInArchive {
+				c.failClass(ht, "name", "%s: name %q", where, out.name)
+				continue
+			}
+			if out.isDir != in.IsDir() {
+				c.failClass(ht, "kind", "%s: IsDir %v", where, out.isDir)
+				continue
+			}
+			if inLink := in.Mode()&fs.ModeSymlink != 0; inLink || out.isLink {
+				if out.isLink != inLink || out.link != in.LinkTarget {
+					c.failClass(ht, "link", "%s: symlink %v -> %q in, %v -> %q out", where, inLink, in.LinkTarget, out.isLink, out.link)
+				}
+			}
+			if !in.IsDir() && in.Mode()&fs.ModeSymlink == 0 {
+				r, _ := in.Open()
+				content, _ := io.ReadAll(r)
+				r.Close()
+				if !bytes.Equal(out.data, content) {
+					c.failClass(ht, "content", "%s: %d bytes in, %d out", where, len(content), len(out.data))
+				}
+			}
+			if h, ok := out.header.(kzip.FileHeader); ok {
+				zf := archival.(archives.Zip)
+				wantMethod := zf.Compression
+				if in.IsDir() || (zf.SelectiveCompression && hzCompressedExt(in.NameInArchive)) {
+					wantMethod = zip.Store
+				}
+				inserted := i >= len(want)-len(extraFiles)
+				if inserted && !zf.SelectiveCompression && h.Method == zip.Store && wantMethod != zip.Store && HZKnown.zipInsertStores {
+					hzAvoid("zipInsertStores")
+				} else if h.Method != wantMethod {
+					c.failClass(ht, fmt.Sprintf("zip method inserted=%v", inserted), "%s: method %d wanted, %d written", where, wantMethod, h.Method)
+				}
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..5eaf4e6
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,204 @@
+package hegel
+
+// Hegel property tests for mholt/archives, written for the Hegel zoo. See
+// targets/go/archives/README.md. They live in a package of their own (hegel/) and drive the
+// public API: FilesFromFS/FilesFromDisk, the Archive/Extract/Insert methods of Tar and Zip
+// (alone and under every compression format), Identify, ArchiveFS, FileSystem and DeepFS.
+//
+// Oracles: the generated tree itself (what went into an archive must come out of it, by
+// name, kind, content, link target and mode), the io/fs contract (testing/fstest.TestFS and a
+// model of the tree as a file system), the package's documentation of the name mapping and of
+// Identify, and Python's tarfile/zipfile as an independent reader of the archives written.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		for k, v := range hzAvoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, v))
+		}
+		hzAvoided = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. While a switch is on
+// the generators keep away from the behaviour (and count the avoidance); the pins assert the
+// documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	zipXzHeaderOffset          bool // Zip{Compression: ZipMethodXz} writes the xz stream header before each entry's local header, and no reader can open the entries
+	lz4CompressionLevel        bool // Lz4{CompressionLevel: n} with n in 1..9 fails to open a writer: the level is passed as the library's bit-flag constant
+	zipEmptyStreamMatch        bool // an empty zip (PK\x05\x06) is not matched by stream: Zip.Match reads the stream once per candidate header instead of comparing the same bytes
+	dirFileReadDirRest         bool // the directory files of ArchiveFS return all their entries from ReadDir(n <= 0), not the remaining ones
+	openImplicitDirFile        bool // ArchiveFS.Open of an implicit directory before the index is built returns its first descendant file opened as the directory
+	openDirFreshEntries        bool // ArchiveFS.Open of a directory before the index is built lists as its children the files of subdirectories that have no entry or whose entry comes after them, and files whose names start with ./
+	statImplicitDirName        bool // ArchiveFS.Stat of an implicit directory returns its full path as Name() before the index is built, and a child's name after
+	statPrefixMissing          bool // ArchiveFS.Stat of a missing name that is a prefix of an entry's name returns an implicit directory before the index is built
+	tarInsertBlockAligned      bool // Tar.Insert after an archive whose last entry's size is a multiple of 512 (an empty file, a directory, a link, an empty archive) leaves a zero block before the new entries, and the archive no longer reads past it
+	zipInsertDirStops          bool // Zip.Insert returns after a directory entry, and the files after it are not inserted
+	zipInsertStores            bool // Zip.Insert without SelectiveCompression stores the files, whatever Compression says
+	zipInsertCustomMethod      bool // Zip.Insert with SelectiveCompression and Compression Bzip2, Zstd or Xz fails: the updater does not know the methods the package registers
+	zipInsertSymlink           bool // Zip.Insert opens a symbolic link's target and stores its content as the link's, instead of the target path Archive stores; a dangling link fails the insertion
+	fsRootDotLeadingSlash      bool // FilesFromFS/FilesFromDisk with the in-archive root "." give names with a leading slash
+	fsTrailingSlashKey         bool // FilesFromFS with a key ending in a slash fails (fs paths cannot end in a slash), though documented as enumerating the directory's contents
+	fsFollowSymlinkRelative    bool // FilesFromFS with FollowSymlinks resolves a relative link target from the root of the fs.FS, not from the link's directory as FilesFromDisk does
+	identifyNondeterministic   bool // Identify iterates the formats in map order: when the file name and the stream point at different formats, the answer varies from call to call
+	pathContainsArchiveCase    bool // PathContainsArchive compares the extensions case-sensitively while PathIsArchive and SplitPath lower-case the path
+	brotliMatchTruncated       bool // Brotli.Match rejects a stream longer than 1 KiB whose first kibibyte does not decode to its end: the decoder's truncation error counts as no match, and Identify finds no format
+	deepFSDirNamedArchive      bool // a directory named like an archive (dir.zip) is treated by DeepFS as an archive, and the archives inside it are listed as plain files, not walked
+	lzipEmptyStream            bool // Lzip's writer closed without a Write produces a stream without the LZIP header, which Lzip's reader rejects
+	fsTrailingKeyValue         bool // FilesFromDisk with a key ending in a separator and a non-empty value adds the directory itself, and drops the first path element of the value
+	splitPathFirstSegment      bool // DeepFS.SplitPath skips the first character of the path, so a first segment that is only an archive extension (.zip) is not split
+	identifyLzipTruncatedPanic bool // Identify panics (slice bounds) on a truncated lzip stream: the lzip reader used to look inside it for an archive panics on short input
+	fsFollowDirLink            bool // FilesFromFS with FollowSymlinks fails on a link to a directory: the directory is looked up by its own path inside fs.Sub of itself
+	followAncestorLinkHang     bool // FilesFromDisk and FilesFromFS with FollowSymlinks recurse without end on a link to an ancestor directory (ln -s . self): the link is found again inside the directory it points at
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
