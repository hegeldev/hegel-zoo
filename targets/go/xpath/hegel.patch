diff --git a/hegel_doc_test.go b/hegel_doc_test.go
new file mode 100644
index 0000000..cf0274f
--- /dev/null
+++ b/hegel_doc_test.go
@@ -0,0 +1,355 @@
+package xpath_test
+
+// Generated XML documents (elements, attributes, text and comments, no
+// namespaces), their serialisation for lxml, and a NodeNavigator over them
+// with the XPath data model's string-values.
+
+import (
+	"strings"
+
+	"github.com/antchfx/xpath"
+	"hegel.dev/go/hegel"
+)
+
+type xattr struct {
+	name, value string
+	id          int
+}
+
+type xnode struct {
+	kind   xpath.NodeType // RootNode, ElementNode, TextNode, CommentNode
+	name   string
+	attrs  []xattr
+	data   string
+	parent *xnode
+	kids   []*xnode
+	idx    int // position among the parent's kids
+	id     int // document-order number (the root node is 0)
+}
+
+var (
+	elemNames = []string{"a", "b", "c", "d", "item", "x-y", "A", "b", "a", "a"}
+	attrNames = []string{"id", "n", "k", "v", "class"}
+	// attrValues and textPool hold strings that convert to numbers in
+	// different ways (blanks, signs, decimals; exponents are left out: libxml2
+	// accepts them where XPath 1.0 does not, and parses large ones inexactly),
+	// and non-ASCII text.
+	attrValues = []string{"1", "2", "10", "abc", " a b ", "", "1.5", "-3", "true", "0", "x", "y", "a&b", "q\"q", "it's", "<t>", "日本", "é", " 7 ", ".5", "5.", "-.5", "1 2"}
+	textPool   = []string{"t", "u", "abc", "1", "2", "10", "-3", "1.5", "0", " ", "  ", "\n", "a b", " x ", "日本語", "é", "a&b", "<", "true", "false", "NaN", "-0", "007", "1 2", "3.0", "0x10", "x2"}
+	// goFloatPool holds strings Go's strconv accepts as numbers and XPath does
+	// not (bug: numberGoSyntax).
+	goFloatPool = []string{"Infinity", "+5", "inf", "1_000", "0x1p-2", "-Infinity"}
+	comments    = []string{"c", " note ", "", "1", "x y"}
+)
+
+func genXDoc(tc hegel.TestCase) *xnode {
+	root := &xnode{kind: xpath.RootNode}
+	top := genXElement(tc, n(tc, 0, 3))
+	root.kids = []*xnode{top}
+	top.parent = root
+	number(root)
+	return root
+}
+
+func genXElement(tc hegel.TestCase, depth int) *xnode {
+	e := &xnode{kind: xpath.ElementNode, name: pick(tc, elemNames...)}
+	k := n(tc, 0, 3)
+	seen := map[string]bool{}
+	for i := 0; i < k; i++ {
+		name := pick(tc, attrNames...)
+		if seen[name] {
+			continue
+		}
+		seen[name] = true
+		e.attrs = append(e.attrs, xattr{name: name, value: pick(tc, attrValues...)})
+	}
+	kids := n(tc, 0, 4)
+	if depth == 0 && kids > 2 {
+		kids = 2
+	}
+	for i := 0; i < kids; i++ {
+		var c *xnode
+		switch r := n(tc, 1, 100); {
+		case r <= 45 && depth > 0:
+			c = genXElement(tc, depth-1)
+		case r <= 50 && depth > 0:
+			c = &xnode{kind: xpath.CommentNode, data: pick(tc, comments...)}
+		case r <= 60:
+			c = &xnode{kind: xpath.CommentNode, data: pick(tc, comments...)}
+		default:
+			c = &xnode{kind: xpath.TextNode, data: pick(tc, textPool...)}
+			if !Known.numberGoSyntax && chance(tc, 15) {
+				c.data = pick(tc, goFloatPool...)
+			}
+			if len(e.kids) > 0 && e.kids[len(e.kids)-1].kind == xpath.TextNode {
+				// adjacent text nodes merge in every parser
+				e.kids[len(e.kids)-1].data += c.data
+				continue
+			}
+		}
+		c.parent = e
+		e.kids = append(e.kids, c)
+	}
+	for i, c := range e.kids {
+		c.idx = i
+	}
+	return e
+}
+
+// number assigns document-order ids: element, its attributes, its children.
+func number(root *xnode) {
+	next := 0
+	var walk func(*xnode)
+	walk = func(x *xnode) {
+		x.id = next
+		next++
+		for i := range x.attrs {
+			x.attrs[i].id = next
+			next++
+		}
+		for _, c := range x.kids {
+			walk(c)
+		}
+	}
+	walk(root)
+}
+
+func escapeText(s string) string {
+	s = strings.ReplaceAll(s, "&", "&amp;")
+	s = strings.ReplaceAll(s, "<", "&lt;")
+	s = strings.ReplaceAll(s, ">", "&gt;")
+	return s
+}
+
+func escapeAttr(s string) string {
+	return strings.ReplaceAll(escapeText(s), `"`, "&quot;")
+}
+
+// xml serialises the document.
+func (x *xnode) xml() string {
+	var b strings.Builder
+	var write func(*xnode)
+	write = func(x *xnode) {
+		switch x.kind {
+		case xpath.RootNode:
+			for _, c := range x.kids {
+				write(c)
+			}
+		case xpath.TextNode:
+			b.WriteString(escapeText(x.data))
+		case xpath.CommentNode:
+			b.WriteString("<!--" + x.data + "-->")
+		case xpath.ElementNode:
+			b.WriteString("<" + x.name)
+			for _, a := range x.attrs {
+				b.WriteString(" " + a.name + `="` + escapeAttr(a.value) + `"`)
+			}
+			if len(x.kids) == 0 {
+				b.WriteString("/>")
+				return
+			}
+			b.WriteString(">")
+			for _, c := range x.kids {
+				write(c)
+			}
+			b.WriteString("</" + x.name + ">")
+		}
+	}
+	write(x)
+	return b.String()
+}
+
+// outline lists the nodes in document order the way the oracle does, to
+// check that both sides see the same tree.
+func (x *xnode) outline() []string {
+	var out []string
+	var walk func(*xnode)
+	walk = func(x *xnode) {
+		switch x.kind {
+		case xpath.ElementNode:
+			out = append(out, "e:"+x.name)
+			for _, a := range x.attrs {
+				out = append(out, "a:"+a.name+"="+a.value)
+			}
+		case xpath.TextNode:
+			out = append(out, "t:"+x.data)
+		case xpath.CommentNode:
+			out = append(out, "c:"+x.data)
+		}
+		for _, c := range x.kids {
+			walk(c)
+		}
+	}
+	walk(x)
+	return out
+}
+
+// stringValue is the XPath string-value of a node.
+func (x *xnode) stringValue() string {
+	switch x.kind {
+	case xpath.TextNode, xpath.CommentNode:
+		return x.data
+	}
+	var b strings.Builder
+	var walk func(*xnode)
+	walk = func(x *xnode) {
+		if x.kind == xpath.TextNode {
+			b.WriteString(x.data)
+		}
+		for _, c := range x.kids {
+			walk(c)
+		}
+	}
+	walk(x)
+	return b.String()
+}
+
+// allNodes lists every node (attributes included) by id.
+func allNodes(root *xnode) map[int]string {
+	out := map[int]string{}
+	var walk func(*xnode)
+	walk = func(x *xnode) {
+		switch x.kind {
+		case xpath.RootNode:
+			out[x.id] = "/"
+		case xpath.ElementNode:
+			out[x.id] = "<" + x.name + ">"
+		case xpath.TextNode:
+			out[x.id] = "text(" + x.data + ")"
+		case xpath.CommentNode:
+			out[x.id] = "comment(" + x.data + ")"
+		}
+		for _, a := range x.attrs {
+			out[a.id] = "@" + a.name
+		}
+		for _, c := range x.kids {
+			walk(c)
+		}
+	}
+	walk(root)
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// The navigator.
+
+type xnav struct {
+	curr, root *xnode
+	attr       int
+}
+
+func newNav(root *xnode, at *xnode) *xnav { return &xnav{curr: at, root: root, attr: -1} }
+
+func (v *xnav) NodeType() xpath.NodeType {
+	if v.attr != -1 {
+		return xpath.AttributeNode
+	}
+	return v.curr.kind
+}
+
+func (v *xnav) LocalName() string {
+	if v.attr != -1 {
+		return v.curr.attrs[v.attr].name
+	}
+	if v.curr.kind == xpath.ElementNode {
+		return v.curr.name
+	}
+	return ""
+}
+
+func (v *xnav) Prefix() string { return "" }
+
+func (v *xnav) Value() string {
+	if v.attr != -1 {
+		return v.curr.attrs[v.attr].value
+	}
+	return v.curr.stringValue()
+}
+
+func (v *xnav) Copy() xpath.NodeNavigator {
+	c := *v
+	return &c
+}
+
+func (v *xnav) MoveToRoot() {
+	v.curr = v.root
+	v.attr = -1
+}
+
+func (v *xnav) MoveToParent() bool {
+	if v.attr != -1 {
+		v.attr = -1
+		return true
+	}
+	if v.curr.parent == nil {
+		return false
+	}
+	v.curr = v.curr.parent
+	return true
+}
+
+func (v *xnav) MoveToNextAttribute() bool {
+	if v.curr.kind != xpath.ElementNode || v.attr+1 >= len(v.curr.attrs) {
+		return false
+	}
+	v.attr++
+	return true
+}
+
+func (v *xnav) MoveToChild() bool {
+	if v.attr != -1 || len(v.curr.kids) == 0 {
+		return false
+	}
+	v.curr = v.curr.kids[0]
+	return true
+}
+
+func (v *xnav) MoveToFirst() bool {
+	if v.attr != -1 || v.curr.parent == nil || v.curr.idx == 0 {
+		return false
+	}
+	v.curr = v.curr.parent.kids[0]
+	return true
+}
+
+func (v *xnav) MoveToNext() bool {
+	if v.attr != -1 || v.curr.parent == nil || v.curr.idx+1 >= len(v.curr.parent.kids) {
+		return false
+	}
+	v.curr = v.curr.parent.kids[v.curr.idx+1]
+	return true
+}
+
+func (v *xnav) MoveToPrevious() bool {
+	if v.attr != -1 || v.curr.parent == nil || v.curr.idx == 0 {
+		return false
+	}
+	v.curr = v.curr.parent.kids[v.curr.idx-1]
+	return true
+}
+
+func (v *xnav) MoveTo(other xpath.NodeNavigator) bool {
+	o, ok := other.(*xnav)
+	if !ok || o.root != v.root {
+		return false
+	}
+	v.curr, v.attr = o.curr, o.attr
+	return true
+}
+
+// id is the document-order number of the navigator's node.
+func (v *xnav) id() int {
+	if v.attr != -1 {
+		return v.curr.attrs[v.attr].id
+	}
+	return v.curr.id
+}
+
+// collect drains an iterator into node ids.
+func collect(it *xpath.NodeIterator) []int {
+	var ids []int
+	for it.MoveNext() {
+		ids = append(ids, it.Current().(*xnav).id())
+	}
+	return ids
+}
diff --git a/hegel_gen_test.go b/hegel_gen_test.go
new file mode 100644
index 0000000..cb58bfc
--- /dev/null
+++ b/hegel_gen_test.go
@@ -0,0 +1,705 @@
+package xpath_test
+
+// A typed generator of XPath 1.0 expressions in the subset both antchfx/xpath
+// and libxml2 implement: location paths on every axis but namespace, node
+// tests, predicates, filter expressions, unions, the core function library,
+// arithmetic, comparisons and boolean operators. Number-to-string
+// conversions are confined to integer values (libxml2 prints other numbers
+// with 15 significant digits, XPath 1.0 asks for the shortest round trip).
+
+import (
+	"fmt"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+type kind int
+
+const (
+	kNodes kind = iota
+	kNumber
+	kString
+	kBool
+)
+
+func (k kind) String() string {
+	return [...]string{"node-set", "number", "string", "boolean"}[k]
+}
+
+type egen struct {
+	tc      hegel.TestCase
+	ext     bool // the library's extensions (lower-case, ends-with, ...)
+	pred    int  // predicate nesting: position() and last() need a context
+	noPos   int  // inside a filter predicate while positions are miscounted
+	noIdx   int  // inside a filter's operand while positional steps come out of order
+	noPred  int  // where step predicates are not allowed (bugs: contextDrift, descendantOrder)
+	onePred int  // where a step takes at most one predicate (bug: descendantOrder)
+	attrCtx int  // inside a predicate whose context node may be an attribute (bug: attributeThenAttribute)
+}
+
+// isAttrStep reports whether a step is on the attribute axis.
+func isAttrStep(s string) bool {
+	return strings.HasPrefix(s, "@") || strings.HasPrefix(s, "attribute::")
+}
+
+// noAttr replaces an attribute step where the context node may be an
+// attribute, since an attribute step from an attribute is not empty.
+func (g *egen) noAttr(s string) string {
+	if g.attrCtx > 0 && Known.attributeThenAttribute && isAttrStep(s) {
+		return pick(g.tc, testNames...)
+	}
+	return s
+}
+
+// positional reports whether position() and last() may be used here.
+func (g *egen) positional() bool {
+	return g.pred > 0 && g.noPos == 0 && g.noIdx == 0
+}
+
+var (
+	testNames   = []string{"a", "b", "c", "d", "item", "x-y", "A", "zz", "id", "n", "k"}
+	axes        = []string{"child", "descendant", "descendant-or-self", "parent", "ancestor", "ancestor-or-self", "following", "following-sibling", "preceding", "preceding-sibling", "self", "attribute"}
+	forwardAxes = []string{"child", "descendant", "descendant-or-self", "parent", "following", "following-sibling", "self", "attribute"}
+	strLits     = []string{"", "a", "b", "abc", "1", "2", "10", "1.5", " a b ", "日本", "é", "t", "x", "true", "NaN", "-3", "0", "ab", "  ", "a&b"}
+	numLits     = []string{"0", "1", "2", "3", "10", "0.5", "2.5", "-1", "7"}
+	intLits     = []string{"0", "1", "2", "3", "10", "-1", "7"}
+	cmpOps      = []string{"=", "!=", "<", "<=", ">", ">="}
+	arithOps    = []string{"+", "-", "*", "div", "mod"}
+	intArith    = []string{"+", "-", "*", "mod"}
+	quoteChars  = []string{`"`, "'"}
+)
+
+// op renders an operator with optional whitespace; word operators get a
+// space on both sides while the trailing-tokens bug is open (3 div-1 is 3).
+func (g *egen) op(o string) string {
+	if o == "div" || o == "mod" {
+		if Known.trailingTokensIgnored {
+			return " " + o + " "
+		}
+		return g.sp() + o + g.sp()
+	}
+	return g.sp() + o + g.sp()
+}
+
+func (g *egen) sp() string {
+	if chance(g.tc, 30) {
+		return pick(g.tc, " ", "  ", "\n", "\t")
+	}
+	return ""
+}
+
+// any draws an expression of a random kind.
+func (g *egen) any(d int) (string, kind) {
+	switch k := kind(n(g.tc, 0, 3)); k {
+	case kNodes:
+		return g.nodes(d), k
+	case kNumber:
+		return g.number(d), k
+	case kString:
+		return g.str(d), k
+	default:
+		return g.boolean(d), k
+	}
+}
+
+func (g *egen) lit(s string) string {
+	q := pick(g.tc, quoteChars...)
+	if strings.Contains(s, q) {
+		q = `"`
+		if q == "\"" && strings.Contains(s, q) {
+			q = "'"
+		}
+	}
+	return q + s + q
+}
+
+// ---------------------------------------------------------------------------
+// Node-sets.
+
+func (g *egen) nodes(d int) string {
+	switch r := n(g.tc, 1, 100); {
+	case r <= 60 || d > 2:
+		return g.path(d)
+	case r <= 80:
+		if Known.descendantOrder {
+			g.noIdx++
+		}
+		in := g.nodes(d + 1)
+		if Known.unionOrder && strings.Contains(in, "|") {
+			in = g.path(d + 1)
+		}
+		if Known.descendantOrder {
+			g.noIdx--
+		}
+		inner := "(" + g.sp() + in + g.sp() + ")"
+		g.noPos++
+		attrs := strings.Contains(in, "@") || strings.Contains(in, "attribute::")
+		if attrs {
+			g.attrCtx++
+		}
+		p := g.predicates(d + 1)
+		if attrs {
+			g.attrCtx--
+		}
+		g.noPos--
+		if Known.filterTwoPredicates && strings.Count(p, "[") > 1 && strings.HasPrefix(p, "[") {
+			p = "[" + g.sp() + g.predicate(d+1) + g.sp() + "]"
+		}
+		return inner + p
+	case r <= 95:
+		return g.nodes(d+1) + g.sp() + "|" + g.sp() + g.nodes(d+1)
+	default:
+		if g.ext {
+			return "reverse(" + g.nodes(d+1) + ")"
+		}
+		return g.path(d)
+	}
+}
+
+func (g *egen) path(d int) string {
+	var b strings.Builder
+	switch n(g.tc, 1, 4) {
+	case 1:
+		b.WriteString("/")
+	case 2:
+		b.WriteString("//")
+	}
+	k := n(g.tc, 1, 3)
+	leadingDesc := b.String() == "//"
+	if leadingDesc && Known.descendantOrder {
+		if g.noIdx > 0 {
+			// //x[p] and //x/y come out of document order
+			k = 1
+			g.noPred++
+			defer func() { g.noPred-- }()
+		}
+		// the second predicate of //x[p][q] counts positions over that order
+		g.onePred++
+		defer func() { g.onePred-- }()
+	}
+	for i := 0; i < k; i++ {
+		if i == 0 && leadingDesc && Known.duplicateNodes {
+			st := g.childStep(d)
+			b.WriteString(st)
+			if strings.HasPrefix(st, "@") || strings.HasPrefix(st, "attribute::") {
+				break
+			}
+			continue
+		}
+		if i > 0 {
+			if Known.duplicateNodes {
+				// steps after the first only on forward single-valued axes,
+				// so no node is reached from two context nodes
+				b.WriteString("/")
+				st := g.simpleStep(d)
+				b.WriteString(st)
+				if strings.HasPrefix(st, "@") || strings.HasPrefix(st, "attribute::") {
+					break
+				}
+				continue
+			}
+			b.WriteString(pick(g.tc, "/", "/", "//"))
+		}
+		st := g.step(d)
+		b.WriteString(st)
+		if Known.attributeThenAttribute && (strings.HasPrefix(st, "@") || strings.HasPrefix(st, "attribute::")) {
+			break
+		}
+		if Known.descendantOrSelfTest && strings.HasPrefix(st, "descendant-or-self::") && !strings.HasPrefix(st, "descendant-or-self::node()") {
+			break
+		}
+		if Known.descendantOrder && g.noIdx > 0 && multiLevelAxis(st) {
+			// a further step after these axes comes out grouped by context node
+			break
+		}
+	}
+	s := b.String()
+	if s == "/" || s == "//" {
+		s += "*"
+	}
+	return s
+}
+
+func (g *egen) step(d int) string {
+	var s string
+	switch r := n(g.tc, 1, 100); {
+	case r <= 8:
+		return "."
+	case r <= 14:
+		return ".."
+	case r <= 40:
+		s = pick(g.tc, testNames...)
+	case r <= 50:
+		s = "*"
+	case r <= 60:
+		s = "@" + pick(g.tc, testNames...)
+	case r <= 65:
+		s = "@*"
+	case r <= 72:
+		s = pick(g.tc, "node()", "text()", "comment()")
+	default:
+		ax := axes
+		if Known.reverseAxisFilter && g.noIdx > 0 {
+			// a filter keeps a reverse axis in axis order
+			ax = forwardAxes
+		}
+		s = pick(g.tc, ax...) + "::" + g.nodeTest()
+	}
+	s = g.noAttr(s)
+	return s + g.stepPredicates(s, d)
+}
+
+// childStep draws a step on the child or attribute axis.
+func (g *egen) childStep(d int) string {
+	var s string
+	switch r := n(g.tc, 1, 100); {
+	case r <= 45:
+		s = pick(g.tc, testNames...)
+	case r <= 55:
+		s = "*"
+	case r <= 65:
+		s = "@" + pick(g.tc, testNames...)
+	case r <= 70:
+		s = "@*"
+	case r <= 85:
+		s = pick(g.tc, "node()", "text()", "comment()")
+	default:
+		s = pick(g.tc, "child", "attribute") + "::" + g.nodeTest()
+	}
+	s = g.noAttr(s)
+	return s + g.stepPredicates(s, d)
+}
+
+// multiLevelAxis reports whether a step's axis reaches nodes at several
+// depths (so a following step needs a document-order merge).
+func multiLevelAxis(step string) bool {
+	for _, ax := range []string{"descendant::", "descendant-or-self::", "following::", "preceding::", "ancestor::", "ancestor-or-self::"} {
+		if strings.HasPrefix(step, ax) {
+			return true
+		}
+	}
+	return false
+}
+
+// isChildStep reports whether a step is on the child axis.
+func isChildStep(step string) bool {
+	if strings.HasPrefix(step, "@") || step == "." || step == ".." {
+		return false
+	}
+	if i := strings.Index(step, "::"); i >= 0 {
+		return step[:i] == "child"
+	}
+	return true
+}
+
+// simpleStep draws a step on the child, attribute or self axis.
+func (g *egen) simpleStep(d int) string {
+	var s string
+	switch r := n(g.tc, 1, 100); {
+	case r <= 10:
+		return "."
+	case r <= 45:
+		s = pick(g.tc, testNames...)
+	case r <= 55:
+		s = "*"
+	case r <= 65:
+		s = "@" + pick(g.tc, testNames...)
+	case r <= 70:
+		s = "@*"
+	case r <= 80:
+		s = pick(g.tc, "node()", "text()", "comment()")
+	default:
+		s = pick(g.tc, "child", "self", "attribute") + "::" + g.nodeTest()
+	}
+	s = g.noAttr(s)
+	return s + g.stepPredicates(s, d)
+}
+
+// stepPredicates draws the predicates of a step; none on the attribute
+// axis while its positions are miscounted.
+func (g *egen) stepPredicates(step string, d int) string {
+	if Known.attributePositions && (strings.HasPrefix(step, "@") || strings.HasPrefix(step, "attribute::")) {
+		return ""
+	}
+	if Known.axisPositions && !isChildStep(step) {
+		g.noPos++
+		defer func() { g.noPos-- }()
+	}
+	if Known.secondPredicateLast && !isChildStep(step) {
+		// the second predicate of a non-child step miscounts positions
+		g.onePred++
+		defer func() { g.onePred-- }()
+	}
+	return g.predicates(d)
+}
+
+func (g *egen) nodeTest() string {
+	switch n(g.tc, 1, 5) {
+	case 1:
+		return "*"
+	case 2:
+		return pick(g.tc, "node()", "text()", "comment()")
+	default:
+		return pick(g.tc, testNames...)
+	}
+}
+
+func (g *egen) predicates(d int) string {
+	if g.noPred > 0 {
+		return ""
+	}
+	if Known.contextDrift {
+		// a predicate inside a predicate is an operand evaluated after a step
+		g.noPred++
+		defer func() { g.noPred-- }()
+	}
+	if d > 2 {
+		if chance(g.tc, 40) && g.noIdx == 0 {
+			return "[" + pick(g.tc, intLits...) + "]"
+		}
+		return ""
+	}
+	var b strings.Builder
+	k := n(g.tc, 0, 2)
+	if k == 2 && (chance(g.tc, 50) || g.onePred > 0) {
+		k = 1
+	}
+	g.pred++
+	saved := g.onePred
+	g.onePred = 0
+	for i := 0; i < k; i++ {
+		if i == 1 && Known.secondPredicateLast {
+			// last() is empty in a second predicate
+			g.noPos++
+		}
+		b.WriteString("[" + g.sp() + g.predicate(d+1) + g.sp() + "]")
+		if i == 1 && Known.secondPredicateLast {
+			g.noPos--
+		}
+	}
+	g.onePred = saved
+	g.pred--
+	return b.String()
+}
+
+func (g *egen) predicate(d int) string {
+	switch r := n(g.tc, 1, 100); {
+	case r <= 20 && g.noIdx == 0:
+		return pick(g.tc, intLits...)
+	case r <= 20:
+		return g.boolean(d)
+	case r <= 30 && g.positional():
+		return "last()"
+	case r <= 45 && g.positional():
+		if Known.positionAfterPath {
+			// a path evaluated before position() loses its context
+			return "position()" + g.sp() + pick(g.tc, cmpOps...) + g.sp() + pick(g.tc, intLits...)
+		}
+		return "position()" + g.sp() + pick(g.tc, cmpOps...) + g.sp() + g.integer(d)
+	case r <= 60:
+		return g.nodes(d)
+	case r <= 85:
+		return g.boolean(d)
+	default:
+		s, k := g.any(d)
+		if k == kNumber && Known.fractionalPosition {
+			return g.integer(d)
+		}
+		return s
+	}
+}
+
+// firstNodes draws a node-set whose first node in document order matters
+// (name(), string(), number()): a path rather than a union while unions keep
+// operand order.
+func (g *egen) firstNodes(d int) string {
+	if Known.reverseAxisFilter {
+		// a reverse axis keeps axis order, so its first node is the nearest
+		g.noIdx++
+		defer func() { g.noIdx-- }()
+	}
+	s := g.nodes(d)
+	if Known.unionOrder && strings.Contains(s, "|") {
+		return g.path(d)
+	}
+	return s
+}
+
+// anyFirst is anyOf with the same care for node-sets.
+func (g *egen) anyFirst(d int) string {
+	if Known.reverseAxisFilter {
+		g.noIdx++
+		defer func() { g.noIdx-- }()
+	}
+	s, k := g.any(d)
+	if k == kNodes && Known.unionOrder && strings.Contains(s, "|") {
+		return g.path(d)
+	}
+	return s
+}
+
+// ---------------------------------------------------------------------------
+// Numbers.
+
+func (g *egen) number(d int) string {
+	if Known.contextDrift {
+		// no step predicates in function arguments and operands
+		g.noPred++
+		defer func() { g.noPred-- }()
+	}
+	if d > 3 {
+		return pick(g.tc, numLits...)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 20:
+		return pick(g.tc, numLits...)
+	case r <= 50:
+		return g.integer(d)
+	case r <= 60:
+		return "number(" + g.anyFirst(d+1) + ")"
+	case r <= 68:
+		if Known.sumSkipsNonNumbers {
+			return "count(" + g.nodes(d+1) + ")"
+		}
+		return "sum(" + g.nodes(d+1) + ")"
+	case r <= 90:
+		return g.number(d+1) + g.op(pick(g.tc, arithOps...)) + g.number(d+1)
+	case r <= 95:
+		return "-" + g.sp() + g.number(d+1)
+	default:
+		return "(" + g.number(d+1) + ")"
+	}
+}
+
+// integer draws a number expression whose value is an integer (or NaN).
+func (g *egen) integer(d int) string {
+	if Known.contextDrift {
+		// no step predicates in function arguments and operands
+		g.noPred++
+		defer func() { g.noPred-- }()
+	}
+	if d > 3 {
+		return pick(g.tc, intLits...)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 25:
+		return pick(g.tc, intLits...)
+	case r <= 40:
+		return "count(" + g.nodes(d+1) + ")"
+	case r <= 50:
+		if chance(g.tc, 30) && !Known.stringLengthNeedsArg {
+			return "string-length()"
+		}
+		return "string-length(" + g.str(d+1) + ")"
+	case r <= 58 && g.positional() && !Known.positionAfterPath:
+		return "position()"
+	case r <= 64 && g.positional() && !Known.positionAfterPath:
+		return "last()"
+	case r <= 80:
+		return pick(g.tc, "floor", "ceiling", "round") + "(" + g.number(d+1) + ")"
+	case r <= 95:
+		return g.integer(d+1) + g.op(pick(g.tc, intArith...)) + g.integer(d+1)
+	default:
+		return "-" + g.integer(d+1)
+	}
+}
+
+// notNaN draws a number expression that cannot be NaN while the substring
+// and boolean() bugs are open (no division, mod, number() or sum()).
+func (g *egen) notNaN(d int) string {
+	if Known.contextDrift {
+		// no step predicates in function arguments and operands
+		g.noPred++
+		defer func() { g.noPred-- }()
+	}
+	if !Known.substringNaNPanics && !Known.booleanNaN {
+		return g.number(d)
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 40:
+		return pick(g.tc, numLits...)
+	case r <= 55:
+		return "count(" + g.nodes(d+1) + ")"
+	case r <= 70:
+		return "string-length(" + g.str(d+1) + ")"
+	case r <= 80 && g.positional() && !Known.positionAfterPath:
+		return pick(g.tc, "position()", "last()")
+	case r <= 90:
+		return pick(g.tc, "floor", "ceiling", "round") + "(" + pick(g.tc, numLits...) + ")"
+	default:
+		return pick(g.tc, numLits...) + g.op(pick(g.tc, "+", "-", "*")) + pick(g.tc, numLits...)
+	}
+}
+
+// intNotNaN draws an integer-valued expression that cannot be NaN.
+func (g *egen) intNotNaN(d int) string {
+	if Known.contextDrift {
+		g.noPred++
+		defer func() { g.noPred-- }()
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 45:
+		return pick(g.tc, intLits...)
+	case r <= 65:
+		return "count(" + g.nodes(d+1) + ")"
+	case r <= 80:
+		return "string-length(" + g.str(d+1) + ")"
+	case r <= 90 && g.positional() && !Known.positionAfterPath:
+		return pick(g.tc, "position()", "last()")
+	default:
+		return pick(g.tc, intLits...) + g.op(pick(g.tc, "+", "-", "*")) + pick(g.tc, intLits...)
+	}
+}
+
+// anyOf draws an expression of any kind for a converting function.
+func (g *egen) anyOf(d int) string {
+	s, _ := g.any(d)
+	return s
+}
+
+// ---------------------------------------------------------------------------
+// Strings.
+
+func (g *egen) str(d int) string {
+	if Known.contextDrift {
+		// no step predicates in function arguments and operands
+		g.noPred++
+		defer func() { g.noPred-- }()
+	}
+	if d > 3 {
+		return g.lit(pick(g.tc, strLits...))
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 22:
+		return g.lit(pick(g.tc, strLits...))
+	case r <= 32:
+		switch n(g.tc, 1, 4) {
+		case 1:
+			return "string(" + g.integer(d+1) + ")"
+		case 2:
+			return "string(" + g.firstNodes(d+1) + ")"
+		case 3:
+			return "string(" + g.boolean(d+1) + ")"
+		default:
+			return "string(" + g.str(d+1) + ")"
+		}
+	case r <= 40:
+		k := n(g.tc, 2, 3)
+		parts := make([]string, k)
+		for i := range parts {
+			parts[i] = g.str(d + 1)
+		}
+		return "concat(" + strings.Join(parts, ","+g.sp()) + ")"
+	case r <= 50:
+		arg := g.notNaN
+		if Known.substringRounding {
+			arg = g.intNotNaN
+		}
+		if chance(g.tc, 50) {
+			return "substring(" + g.str(d+1) + "," + arg(d+1) + ")"
+		}
+		return "substring(" + g.str(d+1) + "," + arg(d+1) + "," + arg(d+1) + ")"
+	case r <= 58:
+		f := pick(g.tc, "substring-before", "substring-after")
+		second := g.str(d + 1)
+		if f == "substring-after" && Known.substringAfterEmpty {
+			second = g.lit(pick(g.tc, strLits[1:]...))
+		}
+		return f + "(" + g.str(d+1) + "," + second + ")"
+	case r <= 66:
+		if chance(g.tc, 30) {
+			return "normalize-space()"
+		}
+		return "normalize-space(" + g.str(d+1) + ")"
+	case r <= 74:
+		return "translate(" + g.str(d+1) + "," + g.str(d+1) + "," + g.str(d+1) + ")"
+	case r <= 86:
+		f := pick(g.tc, "name", "local-name", "namespace-uri")
+		if chance(g.tc, 30) {
+			return f + "()"
+		}
+		return f + "(" + g.firstNodes(d+1) + ")"
+	case r <= 90:
+		return "string()"
+	default:
+		if g.ext {
+			switch n(g.tc, 1, 3) {
+			case 1:
+				return "lower-case(" + g.str(d+1) + ")"
+			case 2:
+				return "replace(" + g.str(d+1) + "," + g.lit(pick(g.tc, "a", "b", "1", " ", "é")) + "," + g.str(d+1) + ")"
+			default:
+				return "string-join(" + g.nodes(d+1) + "," + g.str(d+1) + ")"
+			}
+		}
+		return g.lit(pick(g.tc, strLits...))
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Booleans.
+
+func (g *egen) boolean(d int) string {
+	if Known.contextDrift {
+		// no step predicates in function arguments and operands
+		g.noPred++
+		defer func() { g.noPred-- }()
+	}
+	if d > 3 {
+		return pick(g.tc, "true()", "false()")
+	}
+	switch r := n(g.tc, 1, 100); {
+	case r <= 8:
+		return pick(g.tc, "true()", "false()")
+	case r <= 18:
+		return "not(" + g.boolean(d+1) + ")"
+	case r <= 26:
+		s, k := g.any(d + 1)
+		if Known.booleanNaN && k == kNumber {
+			s = g.notNaN(d + 1)
+		}
+		return "boolean(" + s + ")"
+	case r <= 60:
+		l, lk := g.any(d + 1)
+		r2, rk := g.any(d + 1)
+		if Known.booleanComparisonPanics && (lk == kBool || rk == kBool) {
+			return "not(" + g.boolean(d+1) + ")"
+		}
+		return l + g.sp() + pick(g.tc, cmpOps...) + g.sp() + r2
+	case r <= 72:
+		return g.boolean(d+1) + " " + pick(g.tc, "and", "or") + " " + g.boolean(d+1)
+	case r <= 84:
+		return pick(g.tc, "contains", "starts-with") + "(" + g.str(d+1) + "," + g.str(d+1) + ")"
+	case r <= 92:
+		return "(" + g.boolean(d+1) + ")"
+	default:
+		if g.ext {
+			if chance(g.tc, 50) {
+				return "ends-with(" + g.str(d+1) + "," + g.str(d+1) + ")"
+			}
+			return "matches(" + g.str(d+1) + "," + g.lit(pick(g.tc, "^a", "b$", "a.c", "[ab]+", "^$", "\\d", "(?i)abc", "x|y")) + ")"
+		}
+		return "not(" + g.boolean(d+1) + ")"
+	}
+}
+
+// genExpr draws an expression and its kind.
+func genExpr(tc hegel.TestCase, ext bool) (string, kind) {
+	g := &egen{tc: tc, ext: ext}
+	return g.any(0)
+}
+
+// shape gives a mismatch a coarse class for triage: the functions, axes and
+// operators the expression uses.
+func shape(expr string) string {
+	var kinds []string
+	for _, p := range []string{"ancestor", "descendant", "following", "preceding", "parent", "self", "attribute::", "@", "node()", "text()", "comment()", "..", "//", "|", "last()", "position()", "count(", "sum(", "string-length(", "normalize-space(", "translate(", "substring(", "substring-before(", "substring-after(", "concat(", "name(", "local-name(", "namespace-uri(", "number(", "string(", "boolean(", "not(", "contains(", "starts-with(", "floor(", "ceiling(", "round(", "div", "mod", " and ", " or ", "!=", "<=", ">=", "<", ">", "="} {
+		if strings.Contains(expr, p) {
+			kinds = append(kinds, p)
+		}
+	}
+	return strings.Join(kinds, " ")
+}
+
+var _ = fmt.Sprintf
diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..ee29836
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,172 @@
+package xpath_test
+
+// lxml as a child process: one JSON request per line (an XML document and
+// expressions), one JSON reply per line (the document outline and, per
+// expression, the typed result or an error). The context node is the
+// document element on both sides.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os/exec"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const pyScript = `
+import sys, json, math
+from lxml import etree
+sys.stdout.write(json.dumps({'version': '.'.join(map(str, etree.LXML_VERSION)) + ' libxml2 ' + '.'.join(map(str, etree.LIBXML_VERSION))}) + '\n')
+sys.stdout.flush()
+
+def outline(root):
+    # Document order: element, its attributes, its children; ids from 1
+    # (0 is the document node, which libxml2 never returns).
+    ids = {}
+    lines = []
+    counter = [1]
+    def take(key, line):
+        ids[key] = counter[0]
+        counter[0] += 1
+        lines.append(line)
+    def walk(el):
+        if isinstance(el.tag, str):
+            take(('e', el), 'e:' + el.tag)
+            for k, v in el.attrib.items():
+                take(('a', el, k), 'a:' + k + '=' + v)
+            if el.text is not None:
+                take(('t', el), 't:' + el.text)
+        else:
+            take(('e', el), 'c:' + (el.text or ''))
+        for ch in el:
+            walk(ch)
+            if ch.tail is not None:
+                take(('l', ch), 't:' + ch.tail)
+    walk(root)
+    return ids, lines
+
+def ident(ids, x):
+    if isinstance(x, str):
+        p = x.getparent()
+        if x.is_attribute:
+            return ids[('a', p, x.attrname)]
+        if x.is_tail:
+            return ids[('l', p)]
+        if x.is_text:
+            return ids[('t', p)]
+        return -1
+    return ids[('e', x)]
+
+for line in sys.stdin:
+    req = json.loads(line)
+    root = etree.fromstring(req['xml'].encode('utf-8'))
+    ids, lines = outline(root)
+    out = {'outline': lines, 'results': []}
+    for e in req['exprs']:
+        try:
+            r = root.xpath(e)
+            if isinstance(r, list):
+                out['results'].append({'t': 'nodes', 'v': [ident(ids, x) for x in r]})
+            elif isinstance(r, bool):
+                out['results'].append({'t': 'bool', 'v': r})
+            elif isinstance(r, float):
+                out['results'].append({'t': 'num', 'v': repr(r)})
+            else:
+                out['results'].append({'t': 'str', 'v': str(r)})
+        except Exception as ex:
+            out['results'].append({'t': 'error', 'v': type(ex).__name__ + ': ' + str(ex).splitlines()[0] if str(ex) else type(ex).__name__})
+    sys.stdout.write(json.dumps(out) + '\n')
+    sys.stdout.flush()
+`
+
+type oracleReq struct {
+	XML   string   `json:"xml"`
+	Exprs []string `json:"exprs"`
+}
+
+type oracleResult struct {
+	T string          `json:"t"`
+	V json.RawMessage `json:"v"`
+}
+
+type oracleResp struct {
+	Outline []string       `json:"outline"`
+	Results []oracleResult `json:"results"`
+}
+
+var (
+	oracleOnce    sync.Once
+	oracleMu      sync.Mutex
+	oracleIn      io.WriteCloser
+	oracleOut     *bufio.Scanner
+	oracleErr     error
+	oracleVersion string
+)
+
+func startOracle() {
+	cmd := exec.Command("python3", "-c", pyScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		oracleErr = fmt.Errorf("starting python3: %v", err)
+		return
+	}
+	oracleIn = stdin
+	oracleOut = bufio.NewScanner(stdout)
+	oracleOut.Buffer(make([]byte, 1<<20), 64<<20)
+	if !oracleOut.Scan() {
+		_ = cmd.Wait()
+		oracleErr = fmt.Errorf("lxml oracle did not start (python3 with lxml needed): %s", stderr.String())
+		return
+	}
+	var v struct {
+		Version string `json:"version"`
+	}
+	if err := json.Unmarshal(oracleOut.Bytes(), &v); err != nil {
+		oracleErr = err
+		return
+	}
+	oracleVersion = v.Version
+}
+
+func oracle(t testing.TB, xml string, exprs []string) oracleResp {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("oracle: %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	req, _ := json.Marshal(oracleReq{XML: xml, Exprs: exprs})
+	if _, err := oracleIn.Write(append(req, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	if !oracleOut.Scan() {
+		t.Fatalf("oracle died: %v", oracleOut.Err())
+	}
+	var resp oracleResp
+	if err := json.Unmarshal(oracleOut.Bytes(), &resp); err != nil {
+		t.Fatalf("oracle reply: %v: %s", err, oracleOut.Bytes())
+	}
+	return resp
+}
+
+func TestHegelOracleVersion(t *testing.T) {
+	oracle(t, "<a/>", []string{"/a"})
+	t.Logf("lxml %s", oracleVersion)
+	if !strings.HasPrefix(oracleVersion, "6.") && !strings.HasPrefix(oracleVersion, "5.") {
+		t.Fatalf("lxml 5 or 6 expected, got %s", oracleVersion)
+	}
+}
