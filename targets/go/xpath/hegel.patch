+package xpath_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/antchfx/xpath"
+	"hegel.dev/go/hegel"
+)
+
+// result is a typed XPath value in a comparable form.
+type result struct {
+	k   kind
+	ids []int // node-set, in the order returned
+	num float64
+	str string
+	b   bool
+	err string
+}
+
+func (r result) String() string {
+	switch {
+	case r.err != "":
+		return "error: " + r.err
+	case r.k == kNodes:
+		return fmt.Sprintf("node-set %v", r.ids)
+	case r.k == kNumber:
+		return fmt.Sprintf("number %v", r.num)
+	case r.k == kString:
+		return fmt.Sprintf("string %q", r.str)
+	default:
+		return fmt.Sprintf("boolean %v", r.b)
+	}
+}
+
+// goEval evaluates an expression in the library with the document element
+// as the context node; root nodes are dropped from node-sets, as lxml never
+// returns the document node.
+func goEval(root *xnode, expr string) result {
+	e, err := xpath.Compile(expr)
+	if err != nil {
+		return result{err: err.Error()}
+	}
+	v := e.Evaluate(newNav(root, root.kids[0]))
+	switch v := v.(type) {
+	case *xpath.NodeIterator:
+		ids := []int{}
+		for _, id := range collect(v) {
+			if id != 0 {
+				ids = append(ids, id)
+			}
+		}
+		return result{k: kNodes, ids: ids}
+	case float64:
+		return result{k: kNumber, num: v}
+	case string:
+		return result{k: kString, str: v}
+	case bool:
+		return result{k: kBool, b: v}
+	default:
+		return result{err: fmt.Sprintf("unexpected result type %T", v)}
+	}
+}
+
+func pyResult(r oracleResult) result {
+	switch r.T {
+	case "nodes":
+		var ids []int
+		_ = json.Unmarshal(r.V, &ids)
+		if ids == nil {
+			ids = []int{}
+		}
+		return result{k: kNodes, ids: ids}
+	case "num":
+		var s string
+		_ = json.Unmarshal(r.V, &s)
+		f, err := strconv.ParseFloat(s, 64)
+		if err != nil {
+			return result{err: "number " + s}
+		}
+		return result{k: kNumber, num: f}
+	case "str":
+		var s string
+		_ = json.Unmarshal(r.V, &s)
+		return result{k: kString, str: s}
+	case "bool":
+		var b bool
+		_ = json.Unmarshal(r.V, &b)
+		return result{k: kBool, b: b}
+	default:
+		var s string
+		_ = json.Unmarshal(r.V, &s)
+		return result{err: s}
+	}
+}
+
+// dedup removes repeated ids, keeping the first occurrence.
+func dedup(ids []int) []int {
+	seen := map[int]bool{}
+	out := []int{}
+	for _, x := range ids {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+func sortedUnique(ids []int) []int {
+	seen := map[int]bool{}
+	var out []int
+	for _, x := range ids {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	sort.Ints(out)
+	if out == nil {
+		out = []int{}
+	}
+	return out
+}
+
+func equalInts(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func sameNumber(a, b float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	return a == b
+}
+
+// sameValue compares two results; node-sets as sets.
+func sameValue(a, b result) bool {
+	if a.err != "" || b.err != "" || a.k != b.k {
+		return false
+	}
+	switch a.k {
+	case kNodes:
+		return equalInts(sortedUnique(a.ids), sortedUnique(b.ids))
+	case kNumber:
+		return sameNumber(a.num, b.num)
+	case kString:
+		return a.str == b.str
+	default:
+		return a.b == b.b
+	}
+}
+
+func describe(root *xnode, expr string) string {
+	return fmt.Sprintf("expression %s\ndocument %s", expr, root.xml())
+}
+
+// TestHegelEvaluateAgreesWithLxml: expressions of the shared XPath 1.0
+// subset evaluate to the same typed value in the library and in libxml2;
+// node-sets come back in document order without duplicates.
+func TestHegelEvaluateAgreesWithLxml(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		root := genXDoc(ht)
+		src := root.xml()
+		k := n(ht, 1, 6)
+		var exprs []string
+		for i := 0; i < k; i++ {
+			e, _ := genExpr(ht, false)
+			exprs = append(exprs, e)
+		}
+		resp := oracle(ht, src, exprs)
+		if want := root.outline(); strings.Join(resp.Outline, "\n") != strings.Join(want, "\n") {
+			fail(ht, "XML parsers disagree\ngo %q\npython %q\n%s", want, resp.Outline, src)
+		}
+		for i, expr := range exprs {
+			want := pyResult(resp.Results[i])
+			got := goEval(root, expr)
+			if want.err != "" {
+				fail(ht, "lxml rejects the expression: %s\n%s", want.err, describe(root, expr))
+			}
+			if got.err != "" {
+				fail(ht, "the library rejects the expression: %s\n%s", got.err, describe(root, expr))
+			}
+			if !sameValue(got, want) {
+				fail(ht, "results differ: %s\nlibrary %v\nlxml    %v\n%s", shape(expr), got, want, describe(root, expr))
+			}
+			if got.k == kNodes && !Known.duplicateNodes && !equalInts(got.ids, dedup(got.ids)) {
+				fail(ht, "node-set with duplicates: %s\nlibrary %v\n%s", shape(expr), got.ids, describe(root, expr))
+			}
+		}
+	})
+}
+
+// TestHegelSelectAgreesWithEvaluate: the node-set APIs agree - Expr.Select,
+// the deprecated Select, MustCompile, Evaluate - and iterating an iterator
+// twice or from a copy gives the same nodes.
+func TestHegelSelectAgreesWithEvaluate(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		root := genXDoc(ht)
+		g := &egen{tc: ht, ext: true}
+		expr := g.nodes(0)
+		e, err := xpath.Compile(expr)
+		if err != nil {
+			fail(ht, "the library rejects the expression: %v\n%s", err, describe(root, expr))
+		}
+		if e.String() != expr {
+			fail(ht, "String() is %q\n%s", e.String(), describe(root, expr))
+		}
+		ctx := func() *xnav { return newNav(root, root.kids[0]) }
+		want := collect(e.Select(ctx()))
+		if got := collect(e.Select(ctx())); !equalInts(got, want) {
+			fail(ht, "a second Select differs\nfirst  %v\nsecond %v\n%s", want, got, describe(root, expr))
+		}
+		if got := collect(xpath.Select(ctx(), expr)); !equalInts(got, want) {
+			fail(ht, "xpath.Select differs from Expr.Select\nSelect      %v\nExpr.Select %v\n%s", got, want, describe(root, expr))
+		}
+		if got := collect(xpath.MustCompile(expr).Select(ctx())); !equalInts(got, want) {
+			fail(ht, "MustCompile differs from Compile\nMustCompile %v\nCompile     %v\n%s", got, want, describe(root, expr))
+		}
+		v := e.Evaluate(ctx())
+		it, ok := v.(*xpath.NodeIterator)
+		if !ok {
+			fail(ht, "Evaluate of a path returns %T\n%s", v, describe(root, expr))
+		}
+		if got := collect(it); !equalInts(got, want) {
+			fail(ht, "Evaluate differs from Select\nEvaluate %v\nSelect   %v\n%s", got, want, describe(root, expr))
+		}
+		// Compile again: the compiled-expression cache must not change results.
+		e2, _ := xpath.Compile(expr)
+		if got := collect(e2.Select(ctx())); !equalInts(got, want) {
+			fail(ht, "a recompiled expression differs\nfirst  %v\nsecond %v\n%s", want, got, describe(root, expr))
+		}
+		// count() agrees with the number of distinct nodes selected.
+		c, err := xpath.Compile("count(" + expr + ")")
+		if err != nil {
+			fail(ht, "count(%s) does not compile: %v", expr, err)
+		}
+		if cnt, _ := c.Evaluate(ctx()).(float64); int(cnt) != len(sortedUnique(want)) {
+			fail(ht, "count() is %v for %d distinct nodes\nSelect %v\n%s", cnt, len(sortedUnique(want)), want, describe(root, expr))
+		}
+	})
+}
+
+// TestHegelPositionalPredicates: (expr)[i] is the i-th node of expr in
+// document order, [last()] the last, and [position() > i] the tail.
+func TestHegelPositionalPredicates(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		root := genXDoc(ht)
+		g := &egen{tc: ht, ext: false}
+		if Known.descendantOrder {
+			g.noIdx++ // the expression is filtered by position below
+		}
+		expr := g.nodes(1)
+		if Known.unionOrder && strings.Contains(expr, "|") {
+			expr = g.path(1)
+		}
+		e, err := xpath.Compile(expr)
+		if err != nil {
+			fail(ht, "the library rejects the expression: %v\n%s", err, describe(root, expr))
+		}
+		ctx := func() *xnav { return newNav(root, root.kids[0]) }
+		all := sortedUnique(collect(e.Select(ctx())))
+		i := n(ht, 1, 4)
+		sel := func(s string) []int {
+			x, err := xpath.Compile(s)
+			if err != nil {
+				fail(ht, "%s does not compile: %v", s, err)
+			}
+			return collect(x.Select(ctx()))
+		}
+		var want []int
+		if i <= len(all) {
+			want = []int{all[i-1]}
+		} else {
+			want = []int{}
+		}
+		if got := sel(fmt.Sprintf("(%s)[%d]", expr, i)); !equalInts(got, want) {
+			fail(ht, "(expr)[%d] is %v, want %v\nall %v\n%s", i, got, want, all, describe(root, expr))
+		}
+		if Known.filterPositionMiscounts {
+			return
+		}
+		want = []int{}
+		if len(all) > 0 {
+			want = []int{all[len(all)-1]}
+		}
+		if got := sel(fmt.Sprintf("(%s)[last()]", expr)); !equalInts(got, want) {
+			fail(ht, "(expr)[last()] is %v, want %v\nall %v\n%s", got, want, all, describe(root, expr))
+		}
+		want = []int{}
+		if i < len(all) {
+			want = all[i:]
+		}
+		if got := sel(fmt.Sprintf("(%s)[position() > %d]", expr, i)); !equalInts(got, want) {
+			fail(ht, "(expr)[position() > %d] is %v, want %v\nall %v\n%s", i, got, want, all, describe(root, expr))
+		}
+		if got := sel(fmt.Sprintf("(%s)[position() <= %d]", expr, i)); i <= len(all) && !equalInts(got, all[:i]) || i > len(all) && !equalInts(got, all) {
+			fail(ht, "(expr)[position() <= %d] is %v\nall %v\n%s", i, got, all, describe(root, expr))
+		}
+	})
+}
