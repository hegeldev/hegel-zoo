new file mode 100644
index 0000000..f2ba6f6
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,158 @@
+package xpath_test
+
+// Hegel properties for github.com/antchfx/xpath: XPath 1.0 expressions over
+// generated XML documents against lxml (libxml2's XPath engine, as a child
+// process), plus library-internal identities (Select against Evaluate, the
+// deprecated and Must variants, positional predicates, the node navigator
+// contract) and a Go model of the library's XPath 2.0 extension functions.
+//
+// Needs python3 with the `lxml` package on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 400 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	booleanComparisonPanics bool // comparing a boolean with a number, string or node-set panics; boolean = boolean is always false
+	trailingTokensIgnored   bool // Compile accepts an expression followed by unparsed tokens (3 div-1 is 3)
+	sumSkipsNonNumbers      bool // sum() counts a node whose value is not a number as 0 instead of NaN
+	substringNaNPanics      bool // substring(s, NaN) panics with a slice bounds error
+	stringLengthNeedsArg    bool // string-length() without an argument is rejected
+	duplicateNodes          bool // node-sets from parent/ancestor steps after // hold the same node several times
+	filterPositionMiscounts bool // position() and last() in a predicate on a parenthesised expression are miscounted
+	attributePositions      bool // positional predicates on the attribute axis see every attribute at position 1
+	attributeThenAttribute  bool // an attribute step from an attribute node selects the element's other attributes
+	substringAfterEmpty     bool // substring-after(s, empty string) is empty instead of s
+	filterTwoPredicates     bool // (x)[p][q] followed by ) or an operator is an invalid token or ends the parse
+	axisPositions           bool // last() is empty and position() counts document order on axes other than child
+	unionOrder              bool // a | b keeps operand order, so (b | a)[1] and name(b | a) are not the first node in document order
+	numberGoSyntax          bool // number() accepts Go float syntax: Infinity, inf, +5, 1_000, hex floats
+	descendantOrder         bool // a // path with a predicate or a further step yields nodes out of document order (grouped by parent), so (expr)[m] picks the wrong node
+	fractionalPosition      bool // a non-integer number predicate is truncated to a position: x[2.5] is x[2]
+	secondPredicateLast     bool // the second predicate of a step miscounts: *[1][last()] selects nothing, descendant::*[p][2] several nodes
+	substringRounding       bool // substring() rounds its arguments half away from zero: substring(s, -0.5, 2) drops the first character
+	reverseAxisFilter       bool // a filter over a reverse axis keeps the axis order: (ancestor::*)[1] is the nearest ancestor
+	positionAfterPath       bool // position() and last() evaluated after a path in the same predicate lose the context: e[count(A) + last() = 3] selects nothing
+	contextDrift            bool // a step predicate evaluated in a function argument or comparison operand moves the context node for the operands after it
+	booleanNaN              bool // boolean(NaN) is true
+	descendantOrSelfTest    bool // descendant-or-self::x/y ignores the node test x: it is descendant::y
+}{
+	contextDrift:            true,
+	booleanNaN:              true,
+	descendantOrSelfTest:    true,
+	fractionalPosition:      true,
+	secondPredicateLast:     true,
+	substringRounding:       true,
+	reverseAxisFilter:       true,
+	positionAfterPath:       true,
+	numberGoSyntax:          true,
+	descendantOrder:         true,
+	filterTwoPredicates:     true,
+	axisPositions:           true,
+	unionOrder:              true,
+	filterPositionMiscounts: true,
+	attributePositions:      true,
+	attributeThenAttribute:  true,
+	substringAfterEmpty:     true,
+	sumSkipsNonNumbers:      true,
+	substringNaNPanics:      true,
+	stringLengthNeedsArg:    true,
+	duplicateNodes:          true,
+	booleanComparisonPanics: true,
+	trailingTokensIgnored:   true,
+}
