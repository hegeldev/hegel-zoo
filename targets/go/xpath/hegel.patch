@@ -0,0 +1,356 @@
+package xpath_test
+
+// Pins: one plain test per bug in bugs.toml, failing while the bug exists
+// (listed under [expected_failures] in target.toml). Each asserts the
+// behaviour XPath 1.0 and libxml2 agree on.
+
+import (
+	"fmt"
+	"math"
+	"strings"
+	"testing"
+
+	"github.com/antchfx/xpath"
+)
+
+// pinDoc builds <r k="1" n="2"><e>abc</e><e>1</e><A><d><b/></d><b/></A>xyz</r>
+// with document-order ids: r=1 @k=2 @n=3 e=4 abc=5 e=6 1=7 A=8 d=9 b=10 b=11 xyz=12.
+func pinDoc() *xnode {
+	el := func(name string, attrs []xattr, kids ...*xnode) *xnode {
+		e := &xnode{kind: xpath.ElementNode, name: name, attrs: attrs}
+		for i, k := range kids {
+			k.parent = e
+			k.idx = i
+		}
+		e.kids = kids
+		return e
+	}
+	tx := func(s string) *xnode { return &xnode{kind: xpath.TextNode, data: s} }
+	top := el("r", []xattr{{name: "k", value: "1"}, {name: "n", value: "2"}},
+		el("e", nil, tx("abc")),
+		el("e", nil, tx("1")),
+		el("A", nil, el("d", nil, el("b", nil)), el("b", nil)),
+		tx("xyz"))
+	root := &xnode{kind: xpath.RootNode, kids: []*xnode{top}}
+	top.parent = root
+	number(root)
+	return root
+}
+
+// findNode returns the node with the given document-order id.
+func findNode(x *xnode, id int) *xnode {
+	if x.id == id {
+		return x
+	}
+	for _, c := range x.kids {
+		if f := findNode(c, id); f != nil {
+			return f
+		}
+	}
+	return nil
+}
+
+// pinEval evaluates expr with ctx as the context node; a panic is an error.
+func pinEval(root, ctx *xnode, expr string) (r result) {
+	defer func() {
+		if p := recover(); p != nil {
+			r = result{err: fmt.Sprintf("panic: %v", p)}
+		}
+	}()
+	e, err := xpath.Compile(expr)
+	if err != nil {
+		return result{err: err.Error()}
+	}
+	switch v := e.Evaluate(newNav(root, ctx)).(type) {
+	case *xpath.NodeIterator:
+		return result{k: kNodes, ids: collect(v)}
+	case float64:
+		return result{k: kNumber, num: v}
+	case string:
+		return result{k: kString, str: v}
+	case bool:
+		return result{k: kBool, b: v}
+	default:
+		return result{err: fmt.Sprintf("unexpected result type %T", v)}
+	}
+}
+
+func pinNodes(t *testing.T, expr string, want ...int) {
+	t.Helper()
+	root := pinDoc()
+	got := pinEval(root, root.kids[0], expr)
+	if got.err != "" {
+		t.Errorf("%s: %s", expr, got.err)
+		return
+	}
+	if got.k != kNodes {
+		t.Errorf("%s: %v, want a node-set", expr, got)
+		return
+	}
+	if want == nil {
+		want = []int{}
+	}
+	if !equalInts(got.ids, want) {
+		t.Errorf("%s: nodes %v, want %v", expr, got.ids, want)
+	}
+}
+
+func pinValue(t *testing.T, expr string, want result) {
+	t.Helper()
+	root := pinDoc()
+	got := pinEval(root, root.kids[0], expr)
+	if got.err != "" {
+		t.Errorf("%s: %s", expr, got.err)
+		return
+	}
+	if !sameValue(got, want) {
+		t.Errorf("%s: %v, want %v", expr, got, want)
+	}
+}
+
+func num(f float64) result  { return result{k: kNumber, num: f} }
+func str(s string) result   { return result{k: kString, str: s} }
+func boolean(b bool) result { return result{k: kBool, b: b} }
+func pinNoCompile(t *testing.T, expr string) {
+	t.Helper()
+	if _, err := xpath.Compile(expr); err == nil {
+		t.Errorf("Compile(%q) succeeds, want a syntax error", expr)
+	}
+}
