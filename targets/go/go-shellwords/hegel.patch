+// Hegel property tests for github.com/mattn/go-shellwords, with bash as the oracle.
+//
+// The oracle is `bash -c` evaluating the line as the body of an array assignment,
+// `a=( <line> )`, with globbing (`set -f`) and brace expansion (`set +B`) turned off, and
+// printing the elements NUL-separated behind an explicit element count. The generators stay
+// inside the grammar the two share (see the README for the documented differences that are
+// kept out of them: `\t`/`\n` escapes, backslashes inside double quotes, `\r` as whitespace,
+// line continuations, special parameters, tilde expansion, nested substitutions).
+package shellwords_test
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	. "github.com/mattn/go-shellwords"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---- the oracle ----------------------------------------------------------------------------
+
+// bashWords splits line into words the way bash does inside `a=( line )`, with globbing and
+// brace expansion disabled and the given `NAME=value` variables (and nothing else besides PATH)
+// in the environment. A non-zero exit status is returned as an error.
+func bashWords(line string, env []string) ([]string, error) {
+	script := "set -f\nset +B\na=(" + line + "\n)\nprintf '%s\\n' \"${#a[@]}\"\nif ((${#a[@]})); then printf '%s\\0' \"${a[@]}\"; fi\n"
+	cmd := exec.Command("bash", "-c", script)
+	cmd.Env = append([]string{"PATH=" + os.Getenv("PATH")}, env...)
+	var out, stderr bytes.Buffer
+	cmd.Stdout = &out
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("bash: %v: %s", err, strings.TrimSpace(stderr.String()))
+	}
+	head, rest, ok := bytes.Cut(out.Bytes(), []byte{'\n'})
+	if !ok {
+		return nil, fmt.Errorf("bash: no output")
+	}
+	count, err := strconv.Atoi(string(head))
+	if err != nil {
+		return nil, fmt.Errorf("bash: bad count %q", head)
+	}
+	words := []string{}
+	if count > 0 {
+		parts := bytes.Split(rest, []byte{0})
+		if len(parts) != count+1 || len(parts[count]) != 0 {
+			return nil, fmt.Errorf("bash: %d words announced, output %q", count, rest)
+		}
+		for _, p := range parts[:count] {
+			words = append(words, string(p))
+		}
+	}
+	return words, nil
+}
+
+func sameWords(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// ---- generators ----------------------------------------------------------------------------
+
+// Characters that are ordinary word characters for both parsers when unquoted (no `#` — it
+// starts a comment in bash at the start of a word; no `~`/`[` — tilde expansion and array
+// subscripts inside `a=( … )`; no quotes, backslash, `$`, backtick, parentheses, metacharacters).
+var bareRunes = []rune("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_./:=@%^+,{}*?!]éüßÆ日本語🍺")
+
+// Characters whose backslash escape is the character itself in both parsers (not `t`, `n`, a
+// newline or `\r`).
+var escapableRunes = []rune("\\\"'$` ;&|<>()#{}*?~[]abcxyzXYZ0123456789-_.é日\t")
+
+var escapableRunesNoBackslash = []rune("\"'$` ;&|<>()#{}*?~[]abcxyzXYZ0123456789-_.é日\t")
+
+// Everything but a single quote and NUL may appear inside single quotes.
+var quotableRunes = []rune("abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#$`\\\"()<>|&; \t\n\réüßÆ日本語🍺")
+
+// Characters that need no escape inside double quotes for either parser.
+var doubleQuotableRunes = []rune("abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#'()<>|&; \t\n\réüßÆ日本語🍺")
+
+var separators = []string{" ", "\t", "\n", "  ", " \t", "\n ", "\t\t"}
+
+// The variables every ParseEnv case knows about (HZ_U is never set).
+var envNames = []string{"HZ_A", "HZ_B", "HZ_C"}
+
+// Values contain nothing the re-parse of an unquoted expansion would treat as syntax (quotes,
+// backslashes, metacharacters, parentheses) — that re-parse is go-shellwords/2.
+var envValues = []string{"", "x", "bar", "a b", "  lead  trail ", "tab\tsep", "multi\nline", "é日", "-flag", "a=b", "x*y", "#c", "{a,b}", "$HZ_B", "`x`", "~", "1 2  3", "  "}
+
+func genEnv(tc hegel.TestCase) map[string]string {
+	m := map[string]string{}
+	for _, name := range envNames {
+		m[name] = pick(tc, envValues)
+	}
+	return m
+}
+
+func envList(m map[string]string) []string {
+	out := []string{}
+	for _, name := range envNames {
+		out = append(out, name+"="+m[name])
+	}
+	return out
+}
+
+// Commands whose output is a single word without whitespace, `$`, quotes or backslashes.
+var commands = []string{"printf %s x", "printf abc", "echo hi", "printf 'a-b'", "true", "printf '%s\\n' q", "printf 'é'", "echo", "printf ')'", "printf '*'", "printf '{a,b}'", "printf '#c'"}
+
+func genRunes(tc hegel.TestCase, pool []rune, lo, hi int) string {
+	var sb strings.Builder
+	for i, k := 0, n(tc, lo, hi); i < k; i++ {
+		sb.WriteRune(pick(tc, pool))
+	}
+	return sb.String()
+}
+
+// Comment text: anything but a newline (and no backslash, so that the text cannot end in a
+// line continuation).
+var commentRunes = []rune("abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#$`\"'()<>|&; \t\réüß日🍺")
+
+// Quoted text that survives go-shellwords' re-parse of an expanded word unchanged (no blanks,
+// quotes, backslashes, `$`, metacharacters or parentheses).
+var reparseSafeRunes = []rune("abcxyzXYZ0123456789-_./:=@%^+,{}[]*?!~#éü日🍺")
+
+// Escapes that survive the re-parse: the escaped character is an ordinary one (not a
+// backtick: the re-parse tracks backtick pairs even with ParseBacktick off).
+var reparseSafeEscapes = []rune("#{}*?~[]abcxyzXYZ0123456789-_.é日$")
+
+type flags struct {
+	env, backtick, comment bool
+}
+
+// endsWithBlank reports whether s ends in an unescaped blank, tab or newline.
+func endsWithBlank(s string) bool {
+	if s == "" || !strings.ContainsAny(s[len(s)-1:], " \t\n") {
+		return false
+	}
+	backslashes := 0
+	for i := len(s) - 2; i >= 0 && s[i] == '\\'; i-- {
+		backslashes++
+	}
+	return backslashes%2 == 0
+}
+
+// The kinds of word pieces. `denv` is a double-quoted expansion, `eenv` an escaped `\$NAME`.
+type segKind string
+
+func genSingle(tc hegel.TestCase, pool []rune, lo int) string {
+	return "'" + genRunes(tc, pool, lo, 8) + "'"
+}
+
+func genDouble(tc hegel.TestCase, pool []rune, escapes []rune, lo int) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for i, k := 0, n(tc, lo, 8); i < k; i++ {
+		if len(escapes) > 0 && chance(tc, 20) {
+			sb.WriteByte('\\')
+			sb.WriteRune(pick(tc, escapes))
+		} else {
+			sb.WriteRune(pick(tc, pool))
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+func genSubstitution(tc hegel.TestCase, env bool) string {
+	cmd := pick(tc, commands)
+	if env && strings.Contains(cmd, ")") {
+		cmd = "printf abc" // the output would be re-parsed (go-shellwords/2)
+	}
+	if strings.Contains(cmd, ")") || chance(tc, 50) {
+		return "`" + cmd + "`" // `$(printf ')')` is a documented limitation
+	}
+	return "$(" + cmd + ")"
+}
+
+func genName(tc hegel.TestCase) string { return pick(tc, append(envNames, "HZ_U")) }
+
+// genWord builds one word out of 1–3 pieces, staying clear of the shapes pinned as
+// go-shellwords/1 and /2 when ParseEnv is on: an expanded word is re-parsed as a whole when its
+// last piece is unquoted (so quoted blanks earlier in it would split) and not at all when the
+// last piece is quoted (so an unquoted expansion earlier in it would not split); and
+// brace-less `$NAME` must end the word or a following quoted piece is read as part of the name.
+func genWord(tc hegel.TestCase, f flags) string {
+	k := n(tc, 1, 3)
+	var sb strings.Builder
+	switch {
+	case !f.env:
+		// A word mixing a substitution with empty quotes (`""$(true)`) is an unrecorded
+		// difference (bash keeps the empty word), so quoted pieces are non-empty when the word
+		// has a substitution; and no escaped backslash then, since `\\$(cmd)` is
+		// go-shellwords/6.
+		withSub := f.backtick && chance(tc, 35)
+		lo, escapes, dqEscapes := 0, escapableRunes, []rune{'"', '\\', '$', '`'}
+		if withSub {
+			lo, escapes, dqEscapes = 1, escapableRunesNoBackslash, []rune{'"', '$', '`'}
+		}
+		for i := 0; i < k; i++ {
+			kinds := []segKind{"bare", "bare", "escape", "single", "double"}
+			if withSub {
+				kinds = append(kinds, "sub", "sub")
+			}
+			switch pick(tc, kinds) {
+			case "bare":
+				sb.WriteString(genRunes(tc, bareRunes, 1, 6))
+			case "escape":
+				sb.WriteString("\\" + string(pick(tc, escapes)))
+			case "single":
+				sb.WriteString(genSingle(tc, quotableRunes, lo))
+			case "double":
+				sb.WriteString(genDouble(tc, doubleQuotableRunes, dqEscapes, lo))
+			default:
+				sb.WriteString(genSubstitution(tc, false))
+			}
+		}
+	case chance(tc, 50):
+		// Shape A: every piece is re-parse safe; expansions are unquoted (and split like bash).
+		// Quoted pieces are non-empty and never last: `''$EMPTY` loses the empty word and
+		// `''$X` with a value starting in a blank loses the empty field (go-shellwords/2), and
+		// a quoted last piece would stop the re-parse of the whole word (shape B).
+		for i := 0; i < k; i++ {
+			last := i == k-1
+			kinds := []segKind{"bare", "bare", "escape", "env", "env", "eenv"}
+			if !last {
+				kinds = append(kinds, "single", "double")
+			}
+			if f.backtick {
+				kinds = append(kinds, "sub")
+			}
+			switch pick(tc, kinds) {
+			case "bare":
+				sb.WriteString(genRunes(tc, bareRunes, 1, 6))
+			case "escape":
+				sb.WriteString("\\" + string(pick(tc, reparseSafeEscapes)))
+			case "single":
+				sb.WriteString(genSingle(tc, reparseSafeRunes, 1))
+			case "double":
+				sb.WriteString(genDouble(tc, reparseSafeRunes, []rune{'$'}, 1))
+			case "env":
+				if last && chance(tc, 50) {
+					sb.WriteString("$" + genName(tc))
+				} else {
+					sb.WriteString("${" + genName(tc) + "}")
+				}
+			case "eenv":
+				sb.WriteString("\\$" + genName(tc))
+			default:
+				sb.WriteString(genSubstitution(tc, true))
+			}
+		}
+	default:
+		// Shape B: the word ends in a quoted piece, so it is never re-parsed; earlier pieces
+		// may be anything but an unquoted expansion (its blanks would not split).
+		for i := 0; i < k-1; i++ {
+			kinds := []segKind{"bare", "bare", "escape", "single", "double", "denv", "eenv"}
+			if f.backtick {
+				kinds = append(kinds, "sub")
+			}
+			switch pick(tc, kinds) {
+			case "bare":
+				sb.WriteString(genRunes(tc, bareRunes, 1, 6))
+			case "escape":
+				sb.WriteString("\\" + string(pick(tc, reparseSafeEscapes)))
+			case "single":
+				sb.WriteString(genSingle(tc, envQuotableRunes, 0))
+			case "double":
+				sb.WriteString(genDouble(tc, doubleQuotableRunes, []rune{'"', '$', '`'}, 0))
+			case "denv":
+				sb.WriteString("\"${" + genName(tc) + "}\"")
+			case "eenv":
+				sb.WriteString("\\$" + genName(tc))
+			default:
+				sb.WriteString(genSubstitution(tc, true))
+			}
+		}
+		switch pick(tc, []segKind{"single", "double", "denv", "denv", "dplain", "deenv"}) {
+		case "single":
+			sb.WriteString(genSingle(tc, envQuotableRunes, 0))
+		case "double":
+			sb.WriteString(genDouble(tc, doubleQuotableRunes, []rune{'"', '$', '`'}, 0))
+		case "denv":
+			sb.WriteString("\"${" + genName(tc) + "}\"")
+		case "dplain":
+			sb.WriteString("\"$" + genName(tc) + "\"")
+		default:
+			sb.WriteString("\"\\$" + genName(tc) + "\"")
+		}
+	}
+	w := sb.String()
+	if strings.HasPrefix(w, "#") && !f.comment {
+		w = "x" + w
+	}
+	return w
+}
+
+// Single-quoted text under ParseEnv: no `$` (expanded even here, go-shellwords/1) and no
+// backslash (dropped, same bug).
+var envQuotableRunes = []rune("abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#`\"()<>|&; \t\n\réüßÆ日本語🍺")
+
+// genLine builds a line of words separated by blanks, with comments when f.comment is set.
+func genLine(tc hegel.TestCase, f flags) string {
+	var sb strings.Builder
+	if chance(tc, 30) {
+		sb.WriteString(pick(tc, separators))
+	}
+	for i, k := 0, n(tc, 0, 6); i < k; i++ {
+		if i > 0 {
+			sb.WriteString(pick(tc, separators))
+		}
+		if f.comment && chance(tc, 15) {
+			sb.WriteString("#" + genRunes(tc, commentRunes, 0, 8) + "\n")
+			continue
+		}
+		sb.WriteString(genWord(tc, f))
+	}
+	if chance(tc, 30) {
+		sb.WriteString(pick(tc, separators))
+	}
+	if f.comment && chance(tc, 30) {
+		// Always separated: a `#` glued to an escaped blank (`\ #`) is not a comment.
+		sb.WriteString(pick(tc, []string{" ", "\t", "\n"}))
+		sb.WriteString("#" + genRunes(tc, commentRunes, 0, 8))
+	}
+	return sb.String()
+}
+
+func genFlags(tc hegel.TestCase) flags {
+	return flags{env: chance(tc, 50), backtick: chance(tc, 40), comment: chance(tc, 40)}
+}
+
+func newParser(f flags, env map[string]string) *Parser {
+	p := NewParser()
+	p.ParseEnv = f.env
+	p.ParseBacktick = f.backtick
+	p.ParseComment = f.comment
+	if env != nil {
+		p.Getenv = func(k string) string { return env[k] }
+	}
+	return p
+}
+
+// ---- properties ----------------------------------------------------------------------------
+
+// TestHegelParseAgreesWithBash: on the shared grammar — bare words, escapes, single and
+// double quotes, blanks and newlines, comments (ParseComment), `$NAME`/`${NAME}` expansions
+// inside and outside double quotes (ParseEnv), backtick and `$(…)` substitutions (ParseBacktick)
+// — Parse returns exactly the words bash produces, with Position -1.
+func TestHegelParseAgreesWithBash(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := genFlags(ht)
+		env := genEnv(ht)
+		line := genLine(ht, f)
+		note(ht, "flags %+v env %q line %q", f, envList(env), line)
+		want, err := bashWords(line, envList(env))
+		if err != nil {
+			ht.Fatalf("oracle rejected %q: %v", line, err)
+		}
+		p := newParser(f, env)
+		got, err := p.Parse(line)
+		if err != nil {
+			ht.Fatalf("Parse(%q) = %v, bash gives %q", line, err, want)
+		}
+		if !sameWords(got, want) {
+			ht.Fatalf("Parse(%q) = %q, bash gives %q", line, got, want)
+		}
+		if p.Position != -1 {
+			ht.Fatalf("Parse(%q) left Position = %d without a metacharacter", line, p.Position)
+		}
+		if f.env {
+			// ParseWithEnvs on the same line: the words are the same, split at the first
+			// non-assignment.
+			envs, args, err := p.ParseWithEnvs(line)
+			if err != nil {
+				ht.Fatalf("ParseWithEnvs(%q) = %v", line, err)
+			}
+			if !sameWords(append(append([]string{}, envs...), args...), want) {
+				ht.Fatalf("ParseWithEnvs(%q) = %q + %q, Parse gives %q", line, envs, args, want)
+			}
+		}
+	})
+}
+
+// TestHegelQuotedWordsRoundTrip: any words (any runes but NUL) survive single quoting, and
+// words without characters special inside double quotes survive double quoting with `"`, `\`,
+// `$` and backtick escaped, for Parse and bash alike.
+func TestHegelQuotedWordsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 5)
+		want := []string{}
+		var sb strings.Builder
+		for i := 0; i < k; i++ {
+			if i > 0 {
+				sb.WriteString(pick(ht, separators))
+			}
+			if chance(ht, 50) {
+				w := genRunes(ht, quotableRunes, 0, 10)
+				want = append(want, w)
+				sb.WriteString("'" + w + "'")
+			} else {
+				w := genRunes(ht, append(doubleQuotableRunes, '"', '\\', '$', '`'), 0, 10)
+				want = append(want, w)
+				sb.WriteByte('"')
+				for _, r := range w {
+					if r == '"' || r == '\\' || r == '$' || r == '`' {
+						sb.WriteByte('\\')
+					}
+					sb.WriteRune(r)
+				}
+				sb.WriteByte('"')
+			}
+		}
+		line := sb.String()
+		note(ht, "line %q", line)
+		got, err := Parse(line)
+		if err != nil {
+			ht.Fatalf("Parse(%q) = %v, want %q", line, err, want)
+		}
+		if !sameWords(got, want) {
+			ht.Fatalf("Parse(%q) = %q, want %q", line, got, want)
+		}
+		bw, err := bashWords(line, nil)
+		if err != nil {
+			ht.Fatalf("oracle rejected %q: %v", line, err)
+		}
+		if !sameWords(bw, want) {
+			ht.Fatalf("bash disagrees with the round trip on %q: %q", line, bw)
+		}
+	})
+}
+
+var metachars = []string{";", "&", "|", "<", ">", ";;", "&&", "||", "<<", ">>", ">&", "|&"}
+
+// TestHegelPositionMarksTheFirstMetacharacter: an unquoted, unescaped `;`, `&`, `|`, `<` or `>`
+// stops the parse; the words before it are those of the prefix alone and Position is the rune
+// index of the metacharacter (of the digits when a bare fd number precedes `>`), whatever
+// follows it — even unparseable text.
+func TestHegelPositionMarksTheFirstMetacharacter(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := flags{comment: chance(ht, 30)}
+		prefix := genLine(ht, f)
+		meta := pick(ht, metachars)
+		digits := ""
+		if strings.HasPrefix(meta, ">") && chance(ht, 40) {
+			digits = genRunes(ht, []rune("0123456789"), 1, 3)
+			if prefix != "" && !endsWithBlank(prefix) {
+				prefix += " "
+			}
+		} else if prefix != "" && !endsWithBlank(prefix) {
+			// The last word must not end in a bare digit run (that is the fd form), nor in
+			// an open comment (the metacharacter would be commented out).
+			prefix += "x"
+		}
+		if f.comment && strings.Contains(prefix, "#") {
+			// A comment that runs to the end of the prefix would swallow the metacharacter.
+			if i := strings.LastIndex(prefix, "#"); !strings.Contains(prefix[i:], "\n") {
+				prefix += "\n"
+			}
+		}
+		tail := genRunes(ht, append(quotableRunes, '\'', '$', '(', ')', ';', '|', '&', '<', '>', '`'), 0, 10)
+		line := prefix + digits + meta + tail
+		note(ht, "prefix %q digits %q meta %q tail %q", prefix, digits, meta, tail)
+		p := newParser(f, nil)
+		want, err := p.Parse(prefix)
+		if err != nil {
+			ht.Fatalf("Parse(prefix %q) = %v", prefix, err)
+		}
+		p = newParser(f, nil)
+		got, err := p.Parse(line)
+		if err != nil {
+			ht.Fatalf("Parse(%q) = %v, want %q", line, err, want)
+		}
+		if !sameWords(got, want) {
+			ht.Fatalf("Parse(%q) = %q, want %q (the prefix alone)", line, got, want)
+		}
+		if wantPos := utf8.RuneCountInString(prefix); p.Position != wantPos {
+			ht.Fatalf("Parse(%q) set Position = %d, want %d", line, p.Position, wantPos)
+		}
+		if p.Position >= 0 {
+			rest := string([]rune(line)[p.Position:])
+			if !strings.HasPrefix(rest, digits+meta) {
+				ht.Fatalf("Parse(%q): line[Position:] = %q does not start with %q", line, rest, digits+meta)
+			}
+		}
+	})
+}
+
+func isEnvModel(arg string) bool {
+	name, _, ok := strings.Cut(arg, "=")
+	if !ok || name == "" {
+		return false
+	}
+	for i, c := range []byte(name) {
+		if c == '_' || ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z') || (i > 0 && '0' <= c && c <= '9') {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+// TestHegelParseWithEnvsSplitsLeadingAssignments: ParseWithEnvs returns Parse's words, the
+// leading run of `NAME=value` words (NAME an ASCII identifier) as envs and the rest as args,
+// both non-nil.
+func TestHegelParseWithEnvsSplitsLeadingAssignments(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 6)
+		var sb strings.Builder
+		for i := 0; i < k; i++ {
+			if i > 0 {
+				sb.WriteString(pick(ht, separators))
+			}
+			switch pick(ht, []string{"assign", "assign", "notassign", "word", "quoted"}) {
+			case "assign":
+				sb.WriteString(genRunes(ht, []rune("abcXYZ_"), 1, 3) + genRunes(ht, []rune("abc09_"), 0, 3) + "=" + genRunes(ht, bareRunes, 0, 4))
+			case "notassign":
+				sb.WriteString(pick(ht, []string{"=x", "1a=b", "a-b=c", "é=1", "a.b=c", "a", "==", "$a=b"}))
+			case "quoted":
+				sb.WriteString("'" + pick(ht, []string{"a=b", "x", "1=2", "a b=c", "", "=", "A_1=z z"}) + "'")
+			default:
+				sb.WriteString(genWord(ht, flags{}))
+			}
+		}
+		line := sb.String()
+		note(ht, "line %q", line)
+		all, err := Parse(line)
+		if err != nil {
+			ht.Fatalf("Parse(%q) = %v", line, err)
+		}
+		envs, args, err := ParseWithEnvs(line)
+		if err != nil {
+			ht.Fatalf("ParseWithEnvs(%q) = %v", line, err)
+		}
+		if envs == nil || args == nil {
+			ht.Fatalf("ParseWithEnvs(%q) returned a nil slice: %#v %#v", line, envs, args)
+		}
+		split := 0
+		for split < len(all) && isEnvModel(all[split]) {
+			split++
+		}
+		if !sameWords(envs, all[:split]) || !sameWords(args, all[split:]) {
+			ht.Fatalf("ParseWithEnvs(%q) = %q + %q, want %q + %q", line, envs, args, all[:split], all[split:])
+		}
+	})
+}
+
+// Runes that may be excluded: whitespace, metacharacters, quotes, comment and grouping
+// characters. (Not backslash, `$`, digits or `t`/`n`: those are interpreted before the
+// exclusion check or looked at inside a buffer, and the model below would not hold.)
+var excludableRunes = []rune(" \t\n;&|<>'\"#()`")
+
+// TestHegelExcludedSeparatorsAreOrdinaryCharacters: with SetExcludeSeparators(S), Parse treats
+// every rune of S as a plain word character: the result (words, error, Position) equals
+// parsing the line with each excluded rune replaced by a fresh private-use rune and mapping
+// the placeholders back. ExcludedSeparators returns S.
+func TestHegelExcludedSeparatorsAreOrdinaryCharacters(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		set := []rune{}
+		for i := 0; i < k; i++ {
+			r := pick(ht, excludableRunes)
+			if !strings.ContainsRune(string(set), r) {
+				set = append(set, r)
+			}
+		}
+		line := genRunes(ht, append(quotableRunes, '\'', '$', '(', ')', '`'), 0, 14)
+		note(ht, "excluded %q line %q", string(set), line)
+		forward := map[rune]rune{}
+		backward := map[rune]rune{}
+		for i, r := range set {
+			ph := rune(0xE000 + i)
+			forward[r] = ph
+			backward[ph] = r
+		}
+		model := strings.Map(func(r rune) rune {
+			if ph, ok := forward[r]; ok {
+				return ph
+			}
+			return r
+		}, line)
+		unmap := func(s string) string {
+			return strings.Map(func(r rune) rune {
+				if o, ok := backward[r]; ok {
+					return o
+				}
+				return r
+			}, s)
+		}
+		p := NewParser()
+		p.SetExcludeSeparators(set...)
+		if got := p.ExcludedSeparators(); string(got) != string(set) {
+			ht.Fatalf("ExcludedSeparators() = %q after SetExcludeSeparators(%q)", string(got), string(set))
+		}
+		got, gotErr := p.Parse(line)
+		q := NewParser()
+		want, wantErr := q.Parse(model)
+		for i := range want {
+			want[i] = unmap(want[i])
+		}
+		if (gotErr == nil) != (wantErr == nil) || (gotErr != nil && gotErr.Error() != wantErr.Error()) {
+			ht.Fatalf("Parse(%q) excluding %q: err %v, model err %v", line, string(set), gotErr, wantErr)
+		}
+		if gotErr == nil && !sameWords(got, want) {
+			ht.Fatalf("Parse(%q) excluding %q = %q, model gives %q", line, string(set), got, want)
+		}
+		if gotErr == nil && p.Position != q.Position {
+			ht.Fatalf("Parse(%q) excluding %q: Position %d, model %d", line, string(set), p.Position, q.Position)
+		}
+	})
+}
