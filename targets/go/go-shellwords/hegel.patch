+// Hegel property tests for github.com/mattn/go-shellwords, with bash as the oracle.
+//
+// The oracle is `bash -c` evaluating the line as the body of an array assignment,
+// `a=( <line> )`, with globbing (`set -f`) and brace expansion (`set +B`) turned off, and
+// printing the elements NUL-separated behind an explicit element count. The generators stay
+// inside the grammar the two share (see the README for the documented differences that are
+// kept out of them: `\t`/`\n` escapes, backslashes inside double quotes, `\r` as whitespace,
+// line continuations, special parameters, tilde expansion, nested substitutions).
+package shellwords_test
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	. "github.com/mattn/go-shellwords"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ---- generator helpers ---------------------------------------------------------------------
+
+// weighted chooses among generators in proportion to integer weights with one draw; it
+// shrinks towards the first choice, so the simplest comes first.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// optional generates a draw from g pct percent of the time, else ""; it shrinks to "".
+func optional(pct int, g hegel.Generator[string]) hegel.Generator[string] {
+	return weighted(choice[string]{100 - pct, hegel.Just("")}, choice[string]{pct, g})
+}
+
+// text generates strings of lo-hi characters drawn from pool.
+func text(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+func prefixed(prefix string, g hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Map(g, func(s string) string { return prefix + s })
+}
+
+// seq generates the concatenation of one draw from each generator.
+func seq(gs ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gs {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// many generates lo-hi draws from g, concatenated.
+func many(g hegel.Generator[string], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(hegel.Lists(g).MinSize(lo).MaxSize(hi), func(parts []string) string { return strings.Join(parts, "") })
+}
+
+// sepItem is an item together with the separator drawn in front of it (the first item's
+// separator is not used).
+type sepItem[T any] struct {
+	sep  string
+	item T
+}
+
+// separated generates up to n items, each with its own separator.
+func separated[T any](item hegel.Generator[T], n int) hegel.Generator[[]sepItem[T]] {
+	pair := hegel.Composite(func(tc hegel.TestCase) sepItem[T] {
+		return sepItem[T]{hegel.Draw(tc, separator), hegel.Draw(tc, item)}
+	})
+	return hegel.Lists(pair).MaxSize(n)
+}
+
+// sepJoined generates up to n items joined by separators.
+func sepJoined(item hegel.Generator[string], n int) hegel.Generator[string] {
+	return hegel.Map(separated(item, n), func(ps []sepItem[string]) string {
+		var sb strings.Builder
+		for i, p := range ps {
+			if i > 0 {
+				sb.WriteString(p.sep)
+			}
+			sb.WriteString(p.item)
+		}
+		return sb.String()
+	})
+}
+
+// ---- the oracle ----------------------------------------------------------------------------
+
+// bashWords splits line into words the way bash does inside `a=( line )`, with globbing and
+// brace expansion disabled and the given `NAME=value` variables (and nothing else besides PATH)
+// in the environment. A non-zero exit status is returned as an error.
+func bashWords(line string, env []string) ([]string, error) {
+	script := "set -f\nset +B\na=(" + line + "\n)\nprintf '%s\\n' \"${#a[@]}\"\nif ((${#a[@]})); then printf '%s\\0' \"${a[@]}\"; fi\n"
+	cmd := exec.Command("bash", "-c", script)
+	cmd.Env = append([]string{"PATH=" + os.Getenv("PATH")}, env...)
+	var out, stderr bytes.Buffer
+	cmd.Stdout = &out
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("bash: %v: %s", err, strings.TrimSpace(stderr.String()))
+	}
+	head, rest, ok := bytes.Cut(out.Bytes(), []byte{'\n'})
+	if !ok {
+		return nil, fmt.Errorf("bash: no output")
+	}
+	count, err := strconv.Atoi(string(head))
+	if err != nil {
+		return nil, fmt.Errorf("bash: bad count %q", head)
+	}
+	words := []string{}
+	if count > 0 {
+		parts := bytes.Split(rest, []byte{0})
+		if len(parts) != count+1 || len(parts[count]) != 0 {
+			return nil, fmt.Errorf("bash: %d words announced, output %q", count, rest)
+		}
+		for _, p := range parts[:count] {
+			words = append(words, string(p))
+		}
+	}
+	return words, nil
+}
+
+func sameWords(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// ---- generators ----------------------------------------------------------------------------
+
+const (
+	// Characters that are ordinary word characters for both parsers when unquoted (no `#` — it
+	// starts a comment in bash at the start of a word; no `~`/`[` — tilde expansion and array
+	// subscripts inside `a=( … )`; no quotes, backslash, `$`, backtick, parentheses,
+	// metacharacters).
+	bareRunes = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_./:=@%^+,{}*?!]éüßÆ日本語🍺"
+
+	// Characters whose backslash escape is the character itself in both parsers (not `t`, `n`,
+	// a newline or `\r`).
+	escapableRunes            = "\\\"'$` ;&|<>()#{}*?~[]abcxyzXYZ0123456789-_.é日\t"
+	escapableRunesNoBackslash = "\"'$` ;&|<>()#{}*?~[]abcxyzXYZ0123456789-_.é日\t"
+
+	// Everything but a single quote and NUL may appear inside single quotes.
+	quotableRunes = "abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#$`\\\"()<>|&; \t\n\réüßÆ日本語🍺"
+
+	// Characters that need no escape inside double quotes for either parser.
+	doubleQuotableRunes = "abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#'()<>|&; \t\n\réüßÆ日本語🍺"
+
+	// Comment text: anything but a newline (and no backslash, so that the text cannot end in a
+	// line continuation).
+	commentRunes = "abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#$`\"'()<>|&; \t\réüß日🍺"
+
+	// Quoted text that survives go-shellwords' re-parse of an expanded word unchanged (no
+	// blanks, quotes, backslashes, `$`, metacharacters or parentheses).
+	reparseSafeRunes = "abcxyzXYZ0123456789-_./:=@%^+,{}[]*?!~#éü日🍺"
+
+	// Escapes that survive the re-parse: the escaped character is an ordinary one (not a
+	// backtick: the re-parse tracks backtick pairs even with ParseBacktick off).
+	reparseSafeEscapes = "#{}*?~[]abcxyzXYZ0123456789-_.é日$"
+
+	// Single-quoted text under ParseEnv: no `$` (expanded even here, go-shellwords/1) and no
+	// backslash (dropped, same bug).
+	envQuotableRunes = "abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#`\"()<>|&; \t\n\réüßÆ日本語🍺"
+)
+
+var separator = hegel.SampledFrom([]string{" ", "\t", "\n", "  ", " \t", "\n ", "\t\t"})
+
+// The variables every ParseEnv case knows about (HZ_U is never set).
+var envNames = []string{"HZ_A", "HZ_B", "HZ_C"}
+
+// Values contain nothing the re-parse of an unquoted expansion would treat as syntax (quotes,
+// backslashes, metacharacters, parentheses) — that re-parse is go-shellwords/2.
+var envValues = []string{"", "x", "bar", "a b", "  lead  trail ", "tab\tsep", "multi\nline", "é日", "-flag", "a=b", "x*y", "#c", "{a,b}", "$HZ_B", "`x`", "~", "1 2  3", "  "}
+
+// environment gives every name in envNames a value.
+var environment = hegel.Map(hegel.Lists(hegel.SampledFrom(envValues)).MinSize(len(envNames)).MaxSize(len(envNames)), func(vs []string) map[string]string {
+	m := map[string]string{}
+	for i, name := range envNames {
+		m[name] = vs[i]
+	}
+	return m
+})
+
+func envList(m map[string]string) []string {
+	out := []string{}
+	for _, name := range envNames {
+		out = append(out, name+"="+m[name])
+	}
+	return out
+}
+
+// varName is a name to expand: one of the set variables or the unset HZ_U.
+var varName = hegel.SampledFrom([]string{"HZ_A", "HZ_B", "HZ_C", "HZ_U"})
+
+// Commands whose output is a single word without whitespace, `$`, quotes or backslashes.
+var commands = []string{"printf %s x", "printf abc", "echo hi", "printf 'a-b'", "true", "printf '%s\\n' q", "printf 'é'", "echo", "printf ')'", "printf '*'", "printf '{a,b}'", "printf '#c'"}
+
+type flags struct {
+	env, backtick, comment bool
+}
+
+var parserFlags = hegel.Composite(func(tc hegel.TestCase) flags {
+	return flags{env: hegel.Draw(tc, chance(50)), backtick: hegel.Draw(tc, chance(40)), comment: hegel.Draw(tc, chance(40))}
+})
+
+// endsWithBlank reports whether s ends in an unescaped blank, tab or newline.
+func endsWithBlank(s string) bool {
+	if s == "" || !strings.ContainsAny(s[len(s)-1:], " \t\n") {
+		return false
+	}
+	backslashes := 0
+	for i := len(s) - 2; i >= 0 && s[i] == '\\'; i-- {
+		backslashes++
+	}
+	return backslashes%2 == 0
+}
+
+// single generates a single-quoted piece of lo-8 characters from pool.
+func single(pool string, lo int) hegel.Generator[string] {
+	return hegel.Map(text(pool, lo, 8), func(s string) string { return "'" + s + "'" })
+}
+
+// double generates a double-quoted piece of lo-8 items, each a character from pool or (one in
+// five) a backslash escape of a character from escapes.
+func double(pool, escapes string, lo int) hegel.Generator[string] {
+	item := weighted(choice[string]{80, text(pool, 1, 1)}, choice[string]{20, prefixed(`\`, text(escapes, 1, 1))})
+	return hegel.Map(hegel.Lists(item).MinSize(lo).MaxSize(8), func(parts []string) string { return `"` + strings.Join(parts, "") + `"` })
+}
+
+// substitution generates `$(cmd)` or a backticked cmd. `$(printf ')')` is a documented
+// limitation, so a command with a parenthesis is always backticked; under ParseEnv its output
+// would be re-parsed (go-shellwords/2), so it is replaced.
+func substitution(env bool) hegel.Generator[string] {
+	return hegel.FlatMap(hegel.SampledFrom(commands), func(cmd string) hegel.Generator[string] {
+		if env && strings.Contains(cmd, ")") {
+			cmd = "printf abc"
+		}
+		backticked := hegel.Just("`" + cmd + "`")
+		if strings.Contains(cmd, ")") {
+			return backticked
+		}
+		return hegel.OneOf(hegel.Just("$("+cmd+")"), backticked)
+	})
+}
+
+var (
+	bare        = text(bareRunes, 1, 6)
+	safeEscape  = prefixed(`\`, text(reparseSafeEscapes, 1, 1))
+	bracedName  = hegel.Map(varName, func(n string) string { return "${" + n + "}" })
+	plainName   = prefixed("$", varName)
+	escapedName = prefixed(`\$`, varName)
+	quotedName  = hegel.Map(varName, func(n string) string { return `"${` + n + `}"` })
+)
+
+// plainWord generates a word of 1-3 pieces for a parser without ParseEnv. A word mixing a
+// substitution with empty quotes (`""$(true)`) is an unrecorded difference (bash keeps the
+// empty word), so quoted pieces are non-empty when the word has a substitution; and no escaped
+// backslash then, since `\\$(cmd)` is go-shellwords/6.
+func plainWord(withSub bool) hegel.Generator[string] {
+	lo, escapes, dqEscapes := 0, escapableRunes, "\"\\$`"
+	if withSub {
+		lo, escapes, dqEscapes = 1, escapableRunesNoBackslash, "\"$`"
+	}
+	choices := []choice[string]{
+		{2, bare},
+		{1, prefixed(`\`, text(escapes, 1, 1))},
+		{1, single(quotableRunes, lo)},
+		{1, double(doubleQuotableRunes, dqEscapes, lo)},
+	}
+	if withSub {
+		choices = append(choices, choice[string]{2, substitution(false)})
+	}
+	return many(weighted(choices...), 1, 3)
+}
+
+// The two shapes of a word under ParseEnv stay clear of go-shellwords/1 and /2: an expanded
+// word is re-parsed as a whole when its last piece is unquoted (so quoted blanks earlier in it
+// would split) and not at all when the last piece is quoted (so an unquoted expansion earlier
+// in it would not split); and brace-less `$NAME` must end the word or a following quoted piece
+// is read as part of the name.
+
+// envWordA: every piece is re-parse safe; expansions are unquoted (and split like bash). Quoted
+// pieces are non-empty and never last: `”$EMPTY` loses the empty word and `”$X` with a value
+// starting in a blank loses the empty field (go-shellwords/2), and a quoted last piece would
+// stop the re-parse of the whole word (envWordB).
+func envWordA(backtick bool) hegel.Generator[string] {
+	inner := []choice[string]{
+		{2, bare},
+		{1, safeEscape},
+		{2, bracedName},
+		{1, escapedName},
+		{1, single(reparseSafeRunes, 1)},
+		{1, double(reparseSafeRunes, "$", 1)},
+	}
+	last := []choice[string]{
+		{2, bare},
+		{1, safeEscape},
+		{2, hegel.OneOf(bracedName, plainName)},
+		{1, escapedName},
+	}
+	if backtick {
+		inner = append(inner, choice[string]{1, substitution(true)})
+		last = append(last, choice[string]{1, substitution(true)})
+	}
+	return seq(many(weighted(inner...), 0, 2), weighted(last...))
+}
+
+// envWordB: the word ends in a quoted piece, so it is never re-parsed; earlier pieces may be
+// anything but an unquoted expansion (its blanks would not split).
+func envWordB(backtick bool) hegel.Generator[string] {
+	singleQuoted := single(envQuotableRunes, 0)
+	doubleQuoted := double(doubleQuotableRunes, "\"$`", 0)
+	inner := []choice[string]{
+		{2, bare},
+		{1, safeEscape},
+		{1, singleQuoted},
+		{1, doubleQuoted},
+		{1, quotedName},
+		{1, escapedName},
+	}
+	if backtick {
+		inner = append(inner, choice[string]{1, substitution(true)})
+	}
+	last := weighted(
+		choice[string]{1, singleQuoted},
+		choice[string]{1, doubleQuoted},
+		choice[string]{2, quotedName},
+		choice[string]{1, hegel.Map(varName, func(n string) string { return `"$` + n + `"` })},
+		choice[string]{1, hegel.Map(varName, func(n string) string { return `"\$` + n + `"` })},
+	)
+	return seq(many(weighted(inner...), 0, 2), last)
+}
+
+// words generates one word for a parser with flags f; without ParseComment a word never starts
+// in `#`.
+func words(f flags) hegel.Generator[string] {
+	var w hegel.Generator[string]
+	switch {
+	case f.env:
+		w = hegel.OneOf(envWordA(f.backtick), envWordB(f.backtick))
+	case f.backtick:
+		w = weighted(choice[string]{65, plainWord(false)}, choice[string]{35, plainWord(true)})
+	default:
+		w = plainWord(false)
+	}
+	if f.comment {
+		return w
+	}
+	return hegel.Map(w, func(w string) string {
+		if strings.HasPrefix(w, "#") {
+			return "x" + w
+		}
+		return w
+	})
+}
+
+var commentText = text(commentRunes, 0, 8)
+
+// lines generates a line of up to 6 words separated by blanks, with comments when f.comment is
+// set.
+func lines(f flags) hegel.Generator[string] {
+	item := words(f)
+	trailer := hegel.Just("")
+	if f.comment {
+		item = weighted(
+			choice[string]{85, words(f)},
+			choice[string]{15, hegel.Map(commentText, func(c string) string { return "#" + c + "\n" })})
+		// Always separated: a `#` glued to an escaped blank (`\ #`) is not a comment.
+		trailer = optional(30, seq(hegel.SampledFrom([]string{" ", "\t", "\n"}), prefixed("#", commentText)))
+	}
+	return seq(optional(30, separator), sepJoined(item, 6), optional(30, separator), trailer)
+}
+
+func newParser(f flags, env map[string]string) *Parser {
+	p := NewParser()
+	p.ParseEnv = f.env
+	p.ParseBacktick = f.backtick
+	p.ParseComment = f.comment
+	if env != nil {
+		p.Getenv = func(k string) string { return env[k] }
+	}
+	return p
+}
+
+// ---- properties ----------------------------------------------------------------------------
+
+// TestHegelParseAgreesWithBash: on the shared grammar — bare words, escapes, single and
+// double quotes, blanks and newlines, comments (ParseComment), `$NAME`/`${NAME}` expansions
+// inside and outside double quotes (ParseEnv), backtick and `$(…)` substitutions (ParseBacktick)
+// — Parse returns exactly the words bash produces, with Position -1.
+func TestHegelParseAgreesWithBash(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := hegel.Draw(ht, parserFlags)
+		env := hegel.Draw(ht, environment)
+		line := hegel.Draw(ht, lines(f))
+		want, err := bashWords(line, envList(env))
+		if err != nil {
+			ht.Fatalf("oracle rejected %q: %v", line, err)
+		}
+		p := newParser(f, env)
+		got, err := p.Parse(line)
+		if err != nil {
+			ht.Fatalf("Parse(%q) = %v, bash gives %q", line, err, want)
+		}
+		if !sameWords(got, want) {
+			ht.Fatalf("Parse(%q) = %q, bash gives %q", line, got, want)
+		}
+		if p.Position != -1 {
+			ht.Fatalf("Parse(%q) left Position = %d without a metacharacter", line, p.Position)
+		}
+		if f.env {
+			// ParseWithEnvs on the same line: the words are the same, split at the first
+			// non-assignment.
+			envs, args, err := p.ParseWithEnvs(line)
+			if err != nil {
+				ht.Fatalf("ParseWithEnvs(%q) = %v", line, err)
+			}
+			if !sameWords(append(append([]string{}, envs...), args...), want) {
+				ht.Fatalf("ParseWithEnvs(%q) = %q + %q, Parse gives %q", line, envs, args, want)
+			}
+		}
+	})
+}
+
+// quotedWord is a word and its quoted spelling.
+type quotedWord struct {
+	quoted, want string
+}
+
+// roundTrip is a line of quoted words and the words it should parse to.
+type roundTrip struct {
+	line string
+	want []string
+}
+
+var (
+	singleQuotedWord = hegel.Map(text(quotableRunes, 0, 10), func(w string) quotedWord { return quotedWord{"'" + w + "'", w} })
+	doubleQuotedWord = hegel.Map(text(doubleQuotableRunes+"\"\\$`", 0, 10), func(w string) quotedWord {
+		var sb strings.Builder
+		sb.WriteByte('"')
+		for _, r := range w {
+			if r == '"' || r == '\\' || r == '$' || r == '`' {
+				sb.WriteByte('\\')
+			}
+			sb.WriteRune(r)
+		}
+		sb.WriteByte('"')
+		return quotedWord{sb.String(), w}
+	})
+	quotedLine = hegel.Map(separated(hegel.OneOf(singleQuotedWord, doubleQuotedWord), 5), func(ps []sepItem[quotedWord]) roundTrip {
+		rt := roundTrip{want: []string{}}
+		var sb strings.Builder
+		for i, p := range ps {
+			if i > 0 {
+				sb.WriteString(p.sep)
+			}
+			sb.WriteString(p.item.quoted)
+			rt.want = append(rt.want, p.item.want)
+		}
+		rt.line = sb.String()
+		return rt
+	})
+)
+
+// TestHegelQuotedWordsRoundTrip: any words (any runes but NUL) survive single quoting, and
+// words without characters special inside double quotes survive double quoting with `"`, `\`,
+// `$` and backtick escaped, for Parse and bash alike.
+func TestHegelQuotedWordsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		rt := hegel.Draw(ht, quotedLine)
+		line, want := rt.line, rt.want
+		got, err := Parse(line)
+		if err != nil {
+			ht.Fatalf("Parse(%q) = %v, want %q", line, err, want)
+		}
+		if !sameWords(got, want) {
+			ht.Fatalf("Parse(%q) = %q, want %q", line, got, want)
+		}
+		bw, err := bashWords(line, nil)
+		if err != nil {
+			ht.Fatalf("oracle rejected %q: %v", line, err)
+		}
+		if !sameWords(bw, want) {
+			ht.Fatalf("bash disagrees with the round trip on %q: %q", line, bw)
+		}
+	})
+}
+
+var metachars = []string{";", "&", "|", "<", ">", ";;", "&&", "||", "<<", ">>", ">&", "|&"}
+
+// metaLine is a parseable prefix followed by a metacharacter (behind a bare fd number for
+// `>`) and an arbitrary tail.
+type metaLine struct {
+	f                          flags
+	prefix, digits, meta, tail string
+}
+
+func (m metaLine) line() string { return m.prefix + m.digits + m.meta + m.tail }
+
+// metaLines: the prefix is fixed up so that the metacharacter is really the first one: the
+// last word must not end in a bare digit run (that is the fd form) nor in an open comment
+// (the metacharacter would be commented out).
+var metaLines = hegel.Composite(func(tc hegel.TestCase) metaLine {
+	m := metaLine{f: flags{comment: hegel.Draw(tc, chance(30))}}
+	m.prefix = hegel.Draw(tc, lines(m.f))
+	m.meta = hegel.Draw(tc, hegel.SampledFrom(metachars))
+	if strings.HasPrefix(m.meta, ">") && hegel.Draw(tc, chance(40)) {
+		m.digits = hegel.Draw(tc, text("0123456789", 1, 3))
+		if m.prefix != "" && !endsWithBlank(m.prefix) {
+			m.prefix += " "
+		}
+	} else if m.prefix != "" && !endsWithBlank(m.prefix) {
+		m.prefix += "x"
+	}
+	if m.f.comment && strings.Contains(m.prefix, "#") {
+		// A comment that runs to the end of the prefix would swallow the metacharacter.
+		if i := strings.LastIndex(m.prefix, "#"); !strings.Contains(m.prefix[i:], "\n") {
+			m.prefix += "\n"
+		}
+	}
+	m.tail = hegel.Draw(tc, text(quotableRunes+"'$();|&<>`", 0, 10))
+	return m
+})
+
+// TestHegelPositionMarksTheFirstMetacharacter: an unquoted, unescaped `;`, `&`, `|`, `<` or `>`
+// stops the parse; the words before it are those of the prefix alone and Position is the rune
+// index of the metacharacter (of the digits when a bare fd number precedes `>`), whatever
+// follows it — even unparseable text.
+func TestHegelPositionMarksTheFirstMetacharacter(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, metaLines)
+		prefix, line := m.prefix, m.line()
+		p := newParser(m.f, nil)
+		want, err := p.Parse(prefix)
+		if err != nil {
+			ht.Fatalf("Parse(prefix %q) = %v", prefix, err)
+		}
+		p = newParser(m.f, nil)
+		got, err := p.Parse(line)
+		if err != nil {
+			ht.Fatalf("Parse(%q) = %v, want %q", line, err, want)
+		}
+		if !sameWords(got, want) {
+			ht.Fatalf("Parse(%q) = %q, want %q (the prefix alone)", line, got, want)
+		}
+		if wantPos := utf8.RuneCountInString(prefix); p.Position != wantPos {
+			ht.Fatalf("Parse(%q) set Position = %d, want %d", line, p.Position, wantPos)
+		}
+		if p.Position >= 0 {
+			rest := string([]rune(line)[p.Position:])
+			if !strings.HasPrefix(rest, m.digits+m.meta) {
+				ht.Fatalf("Parse(%q): line[Position:] = %q does not start with %q", line, rest, m.digits+m.meta)
+			}
+		}
+	})
+}
+
+func isEnvModel(arg string) bool {
+	name, _, ok := strings.Cut(arg, "=")
+	if !ok || name == "" {
+		return false
+	}
+	for i, c := range []byte(name) {
+		if c == '_' || ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z') || (i > 0 && '0' <= c && c <= '9') {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+// envLines: up to 6 words, mostly `NAME=value` assignments, with near misses (a bad name, no
+// name, no `=`), quoted assignments (never envs) and plain words.
+var envLines = sepJoined(weighted(
+	choice[string]{2, seq(text("abcXYZ_", 1, 3), text("abc09_", 0, 3), hegel.Just("="), text(bareRunes, 0, 4))},
+	choice[string]{1, hegel.SampledFrom([]string{"=x", "1a=b", "a-b=c", "é=1", "a.b=c", "a", "==", "$a=b"})},
+	choice[string]{1, words(flags{})},
+	choice[string]{1, hegel.Map(hegel.SampledFrom([]string{"a=b", "x", "1=2", "a b=c", "", "=", "A_1=z z"}), func(s string) string { return "'" + s + "'" })},
+), 6)
+
+// TestHegelParseWithEnvsSplitsLeadingAssignments: ParseWithEnvs returns Parse's words, the
+// leading run of `NAME=value` words (NAME an ASCII identifier) as envs and the rest as args,
+// both non-nil.
+func TestHegelParseWithEnvsSplitsLeadingAssignments(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		line := hegel.Draw(ht, envLines)
+		all, err := Parse(line)
+		if err != nil {
+			ht.Fatalf("Parse(%q) = %v", line, err)
+		}
+		envs, args, err := ParseWithEnvs(line)
+		if err != nil {
+			ht.Fatalf("ParseWithEnvs(%q) = %v", line, err)
+		}
+		if envs == nil || args == nil {
+			ht.Fatalf("ParseWithEnvs(%q) returned a nil slice: %#v %#v", line, envs, args)
+		}
+		split := 0
+		for split < len(all) && isEnvModel(all[split]) {
+			split++
+		}
+		if !sameWords(envs, all[:split]) || !sameWords(args, all[split:]) {
+			ht.Fatalf("ParseWithEnvs(%q) = %q + %q, want %q + %q", line, envs, args, all[:split], all[split:])
+		}
+	})
+}
+
+// Runes that may be excluded: whitespace, metacharacters, quotes, comment and grouping
+// characters. (Not backslash, `$`, digits or `t`/`n`: those are interpreted before the
+// exclusion check or looked at inside a buffer, and the model below would not hold.)
+var excludableRunes = []rune(" \t\n;&|<>'\"#()`")
+
+// excludedSets: 1-4 distinct excludable runes, in the order drawn.
+var excludedSets = hegel.Map(hegel.Lists(hegel.SampledFrom(excludableRunes)).MinSize(1).MaxSize(4), func(rs []rune) []rune {
+	set := []rune{}
+	for _, r := range rs {
+		if !strings.ContainsRune(string(set), r) {
+			set = append(set, r)
+		}
+	}
+	return set
+})
+
+var excludedLines = text(quotableRunes+"'$()`", 0, 14)
+
+// TestHegelExcludedSeparatorsAreOrdinaryCharacters: with SetExcludeSeparators(S), Parse treats
+// every rune of S as a plain word character: the result (words, error, Position) equals
+// parsing the line with each excluded rune replaced by a fresh private-use rune and mapping
+// the placeholders back. ExcludedSeparators returns S.
+func TestHegelExcludedSeparatorsAreOrdinaryCharacters(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		set := hegel.Draw(ht, excludedSets)
+		line := hegel.Draw(ht, excludedLines)
+		forward := map[rune]rune{}
+		backward := map[rune]rune{}
+		for i, r := range set {
+			ph := rune(0xE000 + i)
+			forward[r] = ph
+			backward[ph] = r
+		}
+		model := strings.Map(func(r rune) rune {
+			if ph, ok := forward[r]; ok {
+				return ph
+			}
+			return r
+		}, line)
+		unmap := func(s string) string {
+			return strings.Map(func(r rune) rune {
+				if o, ok := backward[r]; ok {
+					return o
+				}
+				return r
+			}, s)
+		}
+		p := NewParser()
+		p.SetExcludeSeparators(set...)
+		if got := p.ExcludedSeparators(); string(got) != string(set) {
+			ht.Fatalf("ExcludedSeparators() = %q after SetExcludeSeparators(%q)", string(got), string(set))
+		}
+		got, gotErr := p.Parse(line)
+		q := NewParser()
+		want, wantErr := q.Parse(model)
+		for i := range want {
+			want[i] = unmap(want[i])
+		}
+		if (gotErr == nil) != (wantErr == nil) || (gotErr != nil && gotErr.Error() != wantErr.Error()) {
+			ht.Fatalf("Parse(%q) excluding %q: err %v, model err %v", line, string(set), gotErr, wantErr)
+		}
+		if gotErr == nil && !sameWords(got, want) {
+			ht.Fatalf("Parse(%q) excluding %q = %q, model gives %q", line, string(set), got, want)
+		}
+		if gotErr == nil && p.Position != q.Position {
+			ht.Fatalf("Parse(%q) excluding %q: Position %d, model %d", line, string(set), p.Position, q.Position)
+		}
+	})
+}
+
+// ---- pinned bugs ---------------------------------------------------------------------------
+
+type pinCase struct {
+	line string
+	want []string
+}
+
+func runPin(ht *hegel.T, p *Parser, env map[string]string, c pinCase) {
+	if env != nil {
+		p.Getenv = func(k string) string { return env[k] }
+	}
+	got, err := p.Parse(c.line)
+	if err != nil {
+		ht.Fatalf("Parse(%q) = %v, want %q", c.line, err, c.want)
+	}
+	if !sameWords(got, c.want) {
+		ht.Fatalf("Parse(%q) = %q, want %q", c.line, got, c.want)
+	}
+}
+
+// go-shellwords/1: ParseEnv expands after quote removal, so `'$HZ_A'` is expanded, `$HZ_A"x"`
+// looks up HZ_Ax, backslashes inside single quotes are dropped and `a\\b` becomes `ab`.
+func TestHegelParseEnvRespectsQuoting(t *testing.T) {
+	env := map[string]string{"HZ_A": "bar"}
+	cases := []pinCase{
+		{`'$HZ_A'`, []string{"$HZ_A"}},
+		{`$HZ_A"x"`, []string{"barx"}},
+		{`"$HZ_A"x`, []string{"barx"}},
+		{`'a\b'`, []string{`a\b`}},
+		{`a\\b`, []string{`a\b`}},
+		{`"a\\b"`, []string{`a\b`}},
+	}
+	property(t, func(ht *hegel.T) {
+		p := NewParser()
+		p.ParseEnv = true
+		runPin(ht, p, env, hegel.Draw(ht, hegel.SampledFrom(cases)))
+	})
+}
+
+// go-shellwords/2: with ParseEnv every word ending in an unquoted piece is re-parsed as a
+// command line after expansion, so a metacharacter in a value (or an escaped one in the word)
+// ends the command line silently, a parenthesis in a value or an escaped backtick is an error,
+// quoted blanks split and `”$EMPTY` loses its word.
+func TestHegelParseEnvValuesAreNotReparsed(t *testing.T) {
+	env := map[string]string{"HZ_A": "a;b", "HZ_B": "x|y", "HZ_C": "a(b", "HZ_S": "a b"}
+	cases := []pinCase{
+		{`$HZ_A`, []string{"a;b"}},
+		{`x$HZ_B z`, []string{"xx|y", "z"}},
+		{`$HZ_C`, []string{"a(b"}},
+		{`a\;b`, []string{"a;b"}},
+		{`2\>x`, []string{"2>x"}},
+		{"\\`", []string{"`"}},
+		{`'a b'x`, []string{"a bx"}},
+		{`${HZ_S}"x"`, []string{"a", "bx"}},
+		{`""$HZ_U`, []string{""}},
+	}
+	property(t, func(ht *hegel.T) {
+		p := NewParser()
+		p.ParseEnv = true
+		runPin(ht, p, env, hegel.Draw(ht, hegel.SampledFrom(cases)))
+	})
+}
+
+// go-shellwords/3: with ParseBacktick a substitution inside double quotes is left as text.
+func TestHegelParseBacktickExpandsInsideDoubleQuotes(t *testing.T) {
+	cases := []pinCase{
+		{`"$(printf x)"`, []string{"x"}},
+		{"\"`printf x`\"", []string{"x"}},
+		{`a"$(printf 'y z')"b`, []string{"ay zb"}},
+	}
+	property(t, func(ht *hegel.T) {
+		p := NewParser()
+		p.ParseBacktick = true
+		runPin(ht, p, nil, hegel.Draw(ht, hegel.SampledFrom(cases)))
+	})
+}
+
+// go-shellwords/4: the output of an unquoted substitution is one word however much
+// whitespace it contains.
+func TestHegelParseBacktickSplitsCommandOutput(t *testing.T) {
+	cases := []pinCase{
+		{"a`printf '%s ' b c`d", []string{"ab", "c", "d"}},
+		{"$(printf 'x  y')", []string{"x", "y"}},
+		{"`printf 'p\\nq'`", []string{"p", "q"}},
+	}
+	property(t, func(ht *hegel.T) {
+		p := NewParser()
+		p.ParseBacktick = true
+		runPin(ht, p, nil, hegel.Draw(ht, hegel.SampledFrom(cases)))
+	})
+}
+
+// go-shellwords/6: with ParseBacktick, `\\$(cmd)` is "invalid command line string": the check
+// for an escaped `$` before `(` looks at the buffer, where the escaped backslash has become a
+// plain one.
+func TestHegelEscapedBackslashBeforeSubstitution(t *testing.T) {
+	cases := []pinCase{
+		{`\\$(printf x)`, []string{`\x`}},
+		{`a\\$(printf %s y)b`, []string{`a\yb`}},
+		{`"\\"$(printf x)`, []string{`\x`}},
+	}
+	property(t, func(ht *hegel.T) {
+		p := NewParser()
+		p.ParseBacktick = true
+		runPin(ht, p, nil, hegel.Draw(ht, hegel.SampledFrom(cases)))
+	})
+}
+
+// go-shellwords/5: variable names may contain any Unicode letter or digit, so `$é` and
+// `$日本` (literal text to a shell) are looked up and disappear.
+func TestHegelVariableNamesFollowTheShell(t *testing.T) {
+	cases := []pinCase{
+		{`$é`, []string{"$é"}},
+		{`a$日本`, []string{"a$日本"}},
+		{`"$é"`, []string{"$é"}},
+	}
+	property(t, func(ht *hegel.T) {
+		p := NewParser()
+		p.ParseEnv = true
+		runPin(ht, p, map[string]string{}, hegel.Draw(ht, hegel.SampledFrom(cases)))
+	})
+}
