+			wantI := orb.Bound{Min: orb.Point{math.Max(a.Min[0], c.Min[0]), math.Max(a.Min[1], c.Min[1])}, Max: orb.Point{math.Min(a.Max[0], c.Max[0]), math.Min(a.Max[1], c.Max[1])}}
+			if !ib.Equal(wantI) {
