diff --git a/hegel/hegel_bounds_shapes_test.go b/hegel/hegel_bounds_shapes_test.go
new file mode 100644
index 0000000..6bd98f4
--- /dev/null
+++ b/hegel/hegel_bounds_shapes_test.go
@@ -0,0 +1,185 @@
+package hegel
+
+// The narrow properties of the bounds: one per recorded bug, drawing the shape of the bug as
+// its generator (hzShaped: the region past the shape under HEGEL_NO_KNOWN=1) and judged by
+// judgeBounds, so that each fails every run naming its bug by default and passes under
+// HEGEL_NO_KNOWN=1.
+
+import (
+	"testing"
+
+	"github.com/paulmach/orb"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- orb/3
+
+// The leak of orb/3 is visible only beyond the unit square: emptyBound {1 1}-{-1 -1} never
+// contains a point, and Extend keeps the 1 or the -1 as a corner when every coordinate it is
+// extended by lies beyond it on that side (a point within the square gives the right box, so
+// does a bound that straddles it). The shape of the record is therefore narrower than its
+// note says: the parts after the empty one, the other bound and the point are translated
+// beyond the square on one side.
+
+// sides: the four translations of 22 (the coordinates lie in [-20, 20], so every translated
+// coordinate is beyond 1 or beyond -1 on that side).
+var sides = weightedOver([]int{10, 10, 10, 10}, orb.Point{22, 0}, orb.Point{-22, 0}, orb.Point{0, 22}, orb.Point{0, -22})
+
+// translated moves every coordinate of the geometry by d.
+func translated(g orb.Geometry, d orb.Point) orb.Geometry {
+	move := func(ps []orb.Point) []orb.Point {
+		out := make([]orb.Point, len(ps))
+		for i, p := range ps {
+			out[i] = orb.Point{p[0] + d[0], p[1] + d[1]}
+		}
+		return out
+	}
+	switch g := g.(type) {
+	case orb.Point:
+		return orb.Point{g[0] + d[0], g[1] + d[1]}
+	case orb.MultiPoint:
+		return orb.MultiPoint(move(g))
+	case orb.LineString:
+		return orb.LineString(move(g))
+	case orb.Ring:
+		return orb.Ring(move(g))
+	case orb.MultiLineString:
+		out := make(orb.MultiLineString, len(g))
+		for i, ls := range g {
+			out[i] = orb.LineString(move(ls))
+		}
+		return out
+	case orb.Polygon:
+		out := make(orb.Polygon, len(g))
+		for i, r := range g {
+			out[i] = orb.Ring(move(r))
+		}
+		return out
+	case orb.MultiPolygon:
+		out := make(orb.MultiPolygon, len(g))
+		for i, p := range g {
+			out[i] = translated(p, d).(orb.Polygon)
+		}
+		return out
+	case orb.Collection:
+		out := make(orb.Collection, len(g))
+		for i, m := range g {
+			out[i] = translated(m, d)
+		}
+		return out
+	case orb.Bound:
+		return orb.Bound{Min: orb.Point{g.Min[0] + d[0], g.Min[1] + d[1]}, Max: orb.Point{g.Max[0] + d[0], g.Max[1] + d[1]}}
+	}
+	panic("translated")
+}
+
+// emptyFirstParts: a multi-geometry or collection whose first part is empty and whose later
+// parts (one or more) lie beyond the unit square on one side: a collection with an empty
+// member first, a multi line string with an empty line first.
+var emptyFirstParts = hegel.FlatMap(sides, func(d orb.Point) hegel.Generator[orb.Geometry] {
+	return hzWeighted(
+		hzW(10, hegel.Map(hzSeq(
+			hzOne(emptyMembers),
+			hzCounted(plainGeometries.members, 1, 3),
+		), func(ms []orb.Geometry) orb.Geometry { return translated(orb.Collection(ms), d) })),
+		hzW(10, hegel.Map(hzSeq(
+			hzOne(hegel.Just(orb.LineString{})),
+			hzCounted(plainGeometries.nonEmptyLines, 1, 3),
+		), func(ls []orb.LineString) orb.Geometry { return translated(orb.MultiLineString(ls), d) })),
+	)
+})
+
+// beyondBounds: a bound beyond the unit square on one side; beyondPoints: a point beyond it.
+var (
+	beyondBounds = hegel.FlatMap(sides, func(d orb.Point) hegel.Generator[orb.Bound] {
+		return hegel.Map(bounds, func(b orb.Bound) orb.Bound { return translated(b, d).(orb.Bound) })
+	})
+	beyondPoints = hegel.FlatMap(sides, func(d orb.Point) hegel.Generator[orb.Point] {
+		return hegel.Map(points, func(p orb.Point) orb.Point { return translated(p, d).(orb.Point) })
+	})
+)
+
+// orb3Cases: the shape in Bound() (the geometry with an empty first part, a plain receiver),
+// or in Union and Extend (a plain geometry, the empty receiver with a bound and a point beyond
+// the square).
+var orb3Cases = hzWeighted(
+	hzW(10, hegel.Composite(func(tc hegel.TestCase) boundsCase {
+		a := hegel.Draw(tc, bounds)
+		return boundsCase{
+			g: hegel.Draw(tc, emptyFirstParts),
+			a: a,
+			c: hegel.Draw(tc, bounds),
+			p: hegel.Draw(tc, pointsAbout(a)),
+			d: float64(hegel.Draw(tc, hzInts(-300, 300))) / 100,
+		}
+	})),
+	hzW(10, hegel.Composite(func(tc hegel.TestCase) boundsCase {
+		return boundsCase{
+			g: hegel.Draw(tc, plainGeometries.any),
+			a: emptyBound,
+			c: hegel.Draw(tc, beyondBounds),
+			p: hegel.Draw(tc, beyondPoints),
+			d: float64(hegel.Draw(tc, hzInts(-300, 300))) / 100,
+		}
+	})),
+)
+
+// plainBoundsCases: the region past orb/3 and orb/4: a plain geometry, a receiver of positive
+// area.
+var plainBoundsCases = hegel.Composite(func(tc hegel.TestCase) boundsCase {
+	a := positiveArea(hegel.Draw(tc, bounds))
+	return boundsCase{
+		g: hegel.Draw(tc, plainGeometries.any),
+		a: a,
+		c: hegel.Draw(tc, bounds),
+		p: hegel.Draw(tc, pointsAbout(a)),
+		d: float64(hegel.Draw(tc, hzInts(-300, 300))) / 100,
+	}
+})
+
+// TestHegelBoundOfAnEmptyFirstPart (orb/3): Bound() of a multi-geometry or collection whose
+// first part is empty is the box of the later parts' coordinates; the empty bound's Union
+// with a bound is that bound and its Extend by a point is the box of the point. The shapes
+// lie beyond the unit square (the file comment). Under HEGEL_NO_KNOWN=1 the plain geometries
+// and receivers are drawn (a pad that makes the receiver's area zero, the shape of orb/4, is
+// filtered out).
+func TestHegelBoundOfAnEmptyFirstPart(t *testing.T) {
+	judged(t, withoutShapes(boundsExpected, hzShaped(orb3Cases, plainBoundsCases)), judgeBounds)
+}
+
+// --------------------------------------------------------------------------- orb/4
+
+// zeroAreaBounds: a bound of zero width, zero height or both (a point).
+var zeroAreaBounds = hegel.Composite(func(tc hegel.TestCase) orb.Bound {
+	a, b := hegel.Draw(tc, points), hegel.Draw(tc, points)
+	zero := hegel.Draw(tc, zeroExtents)
+	if zero[0] {
+		b[0] = a[0]
+	}
+	if zero[1] {
+		b[1] = a[1]
+	}
+	return boundOfTwo(a, b)
+})
+
+// zeroExtents: which extents are zero: the width, the height, or both.
+var zeroExtents = hegel.Map(weightedOver([]int{10, 10, 10}, 0, 1, 2), func(k int) [2]bool { return [2]bool{k != 1, k != 0} })
+
+// orb4Cases: a zero-area receiver, a plain geometry.
+var orb4Cases = hegel.Composite(func(tc hegel.TestCase) boundsCase {
+	a := hegel.Draw(tc, zeroAreaBounds)
+	return boundsCase{
+		g: hegel.Draw(tc, plainGeometries.any),
+		a: a,
+		c: hegel.Draw(tc, bounds),
+		p: hegel.Draw(tc, pointsAbout(a)),
+		d: float64(hegel.Draw(tc, hzInts(-300, 300))) / 100,
+	}
+})
+
+// TestHegelZeroAreaBoundIsEmpty (orb/4): a bound of zero area is empty, as IsEmpty's comment
+// promises (its other methods are as documented). Under HEGEL_NO_KNOWN=1 the receivers have
+// positive area.
+func TestHegelZeroAreaBoundIsEmpty(t *testing.T) {
+	judged(t, withoutShapes(boundsExpected, hzShaped(orb4Cases, plainBoundsCases)), judgeBounds)
+}
diff --git a/hegel/hegel_bounds_test.go b/hegel/hegel_bounds_test.go
new file mode 100644
index 0000000..38a4239
--- /dev/null
+++ b/hegel/hegel_bounds_test.go
@@ -0,0 +1,333 @@
+package hegel
+
+// Bounds: Bound() of every geometry, the Bound methods and clip.Bound, as a model
+// boundsExpected(c, k) of the drawn record (hegel_geometries_test.go's boundsCase) and the
+// switch set: with every switch off the documented values (Bound() is the box of the
+// coordinates, the empty bound for a geometry without any; the methods as their doc comments
+// say, IsEmpty true for a bound of zero area as its comment promises; clip.Bound as recorded:
+// the intersection, an empty argument ignored); under kUnionOfEmptyBound a replica of each
+// type's Bound with Union and Extend transcribed from bound.go (orb/3); under
+// kIsEmptyZeroArea IsEmpty as bound.go computes it, Min > Max only (orb/4).
+//
+// On the empty receiver (the drawn alternative of the record, orb's unexported emptyBound
+// {1 1}-{-1 -1}) the model states only Union(c) = c, Extend(p) = {p p} and IsEmpty = true,
+// and clip.Bound's recorded rule: the other methods of an empty bound (Contains, Intersects,
+// Pad, Center, the sides, ToRing, Equal) are unspecified by the package and are not checked.
+// The empty receiver is where orb/3's Union and Extend are checked: a non-empty receiver's
+// checks do not ask empty.Union(a) (the old gated check), which would name orb/3 on nearly
+// every case.
+
+import (
+	"fmt"
+	"math"
+	"testing"
+
+	"github.com/paulmach/orb"
+	"github.com/paulmach/orb/clip"
+)
+
+// collectionStartsEmpty reports whether some multi-geometry or collection in the geometry has
+// a coordinate-less part before a part with coordinates (the case where Bound() unions onto
+// an empty bound; the narrow property's region).
+func collectionStartsEmpty(g orb.Geometry) bool {
+	var parts []orb.Geometry
+	switch g := g.(type) {
+	case orb.Collection:
+		parts = g
+	case orb.MultiLineString:
+		for _, ls := range g {
+			parts = append(parts, ls)
+		}
+	case orb.Polygon:
+		for _, r := range g {
+			parts = append(parts, r)
+		}
+	case orb.MultiPolygon:
+		for _, p := range g {
+			parts = append(parts, p)
+		}
+	default:
+		return false
+	}
+	seenEmpty := false
+	for _, m := range parts {
+		if collectionStartsEmpty(m) {
+			return true
+		}
+		if len(coords(m)) == 0 {
+			seenEmpty = true
+		} else if seenEmpty {
+			return true
+		}
+	}
+	return false
+}
+
+// printBound prints a bound, "empty" for one with Min > Max (the form of every bound value
+// the model states; the library's emptyBound prints "empty").
+func printBound(b orb.Bound) string {
+	if b.Min[0] > b.Max[0] || b.Min[1] > b.Max[1] {
+		return "empty"
+	}
+	return showBound(b)
+}
+
+// isEmptyBound reports Min > Max (the receiver alternative of the record).
+func isEmptyBound(b orb.Bound) bool { return b.Min[0] > b.Max[0] || b.Min[1] > b.Max[1] }
+
+// --------------------------------------------------------------------------- the replica of
+// bound.go and the Bound methods (orb/3)
+
+// libContains is bound.go's Contains: the point within the box, the boundary included.
+func libContains(b orb.Bound, p orb.Point) bool {
+	if p[1] < b.Min[1] || b.Max[1] < p[1] {
+		return false
+	}
+	if p[0] < b.Min[0] || b.Max[0] < p[0] {
+		return false
+	}
+	return true
+}
+
+// libExtend is bound.go's Extend: the bound itself when it contains the point, else the
+// coordinate-wise min of Min and max of Max with the point (on the empty bound {1 1}-{-1 -1}
+// Contains is never true and the min and max keep the 1 and -1: the leak of orb/3).
+func libExtend(b orb.Bound, p orb.Point) orb.Bound {
+	if libContains(b, p) {
+		return b
+	}
+	return orb.Bound{
+		Min: orb.Point{math.Min(b.Min[0], p[0]), math.Min(b.Min[1], p[1])},
+		Max: orb.Point{math.Max(b.Max[0], p[0]), math.Max(b.Max[1], p[1])},
+	}
+}
+
+// libIsEmpty is bound.go's IsEmpty: Min > Max in either coordinate (a zero-area bound is not
+// empty to it, orb/4).
+func libIsEmpty(b orb.Bound) bool { return b.Min[0] > b.Max[0] || b.Min[1] > b.Max[1] }
+
+// libUnion is bound.go's Union: the receiver when the other is empty (by IsEmpty), else the
+// receiver extended by the other's four corners.
+func libUnion(b, other orb.Bound) orb.Bound {
+	if libIsEmpty(other) {
+		return b
+	}
+	b = libExtend(b, other.Min)
+	b = libExtend(b, other.Max)
+	b = libExtend(b, other.LeftTop())
+	b = libExtend(b, other.RightBottom())
+	return b
+}
+
+// libBound is each type's Bound as the library computes it: point.go {p p}; multi_point.go
+// the empty bound for no points, else Extend from {mp[0] mp[0]}; a line string and a ring
+// as a multi point; polygon.go the empty bound or the first ring's (the holes ignored);
+// multi_line_string.go and multi_polygon.go the empty bound or the first part's unioned with
+// the rest; geometry.go's Collection the empty bound, or the first non-nil member's unioned
+// with the rest; bound.go itself.
+func libBound(g orb.Geometry) orb.Bound {
+	switch g := g.(type) {
+	case orb.Point:
+		return orb.Bound{Min: g, Max: g}
+	case orb.MultiPoint:
+		if len(g) == 0 {
+			return emptyBound
+		}
+		b := orb.Bound{Min: g[0], Max: g[0]}
+		for _, p := range g {
+			b = libExtend(b, p)
+		}
+		return b
+	case orb.LineString:
+		return libBound(orb.MultiPoint(g))
+	case orb.Ring:
+		return libBound(orb.MultiPoint(g))
+	case orb.Polygon:
+		if len(g) == 0 {
+			return emptyBound
+		}
+		return libBound(g[0])
+	case orb.MultiLineString:
+		if len(g) == 0 {
+			return emptyBound
+		}
+		b := libBound(g[0])
+		for i := 1; i < len(g); i++ {
+			b = libUnion(b, libBound(g[i]))
+		}
+		return b
+	case orb.MultiPolygon:
+		if len(g) == 0 {
+			return emptyBound
+		}
+		b := libBound(g[0])
+		for i := 1; i < len(g); i++ {
+			b = libUnion(b, libBound(g[i]))
+		}
+		return b
+	case orb.Collection:
+		if len(g) == 0 {
+			return emptyBound
+		}
+		b := libBound(g[0]) // no member is nil here
+		for i := 1; i < len(g); i++ {
+			b = libUnion(b, libBound(g[i]))
+		}
+		return b
+	case orb.Bound:
+		return g
+	}
+	panic(fmt.Sprintf("libBound: %T", g))
+}
+
+// --------------------------------------------------------------------------- the model
+
+// boxOf is the documented Bound(): the box of the coordinates, the empty bound for none.
+func boxOf(g orb.Geometry) orb.Bound {
+	if b, ok := g.(orb.Bound); ok {
+		return b
+	}
+	if b, ok := boundOf(coords(g)); ok {
+		return b
+	}
+	return emptyBound
+}
+
+// boundsExpected states every value the bounds property checks (see the file comment).
+func boundsExpected(c boundsCase, k known) checks {
+	out := checks{}
+	g, a, cc, p, d := c.g, c.a, c.c, c.p, c.d
+	if k[kUnionOfEmptyBound] {
+		out["bound"] = printBound(libBound(g))
+	} else {
+		out["bound"] = printBound(boxOf(g))
+	}
+	if _, isBound := g.(orb.Bound); !isBound && len(coords(g)) > 0 && !hasEmptyPart(g) {
+		out["shapely-bounds"] = showBound(boxOf(g))
+	}
+	isEmpty := func(b orb.Bound) bool {
+		if k[kIsEmptyZeroArea] {
+			return libIsEmpty(b)
+		}
+		return isEmptyBound(b) || b.Min[0] == b.Max[0] || b.Min[1] == b.Max[1]
+	}
+	if isEmptyBound(a) {
+		// the empty receiver: Union(c) = c, Extend(p) = {p p}, IsEmpty; clip.Bound as recorded
+		// (an empty bound is ignored: the other bound comes back, both empty the argument)
+		if k[kUnionOfEmptyBound] {
+			out["union"] = printBound(libUnion(a, cc))
+			out["extend"] = printBound(libExtend(a, p))
+		} else {
+			out["union"] = printBound(cc)
+			out["extend"] = printBound(orb.Bound{Min: p, Max: p})
+		}
+		out["union-rev"] = printBound(cc)
+		out["isempty"] = "true"
+		out["clip-bound"] = printBound(cc)
+		out["clip-bound-empty"] = "empty | empty"
+		return out
+	}
+	inA := a.Min[0] <= p[0] && p[0] <= a.Max[0] && a.Min[1] <= p[1] && p[1] <= a.Max[1]
+	out.set("contains", inA)
+	out["extend"] = printBound(boundOfPoints(a.Min, a.Max, p))
+	u := boundOfPoints(a.Min, a.Max, cc.Min, cc.Max)
+	out["union"] = printBound(u)
+	out["union-rev"] = printBound(u)
+	out["union-empty-arg"] = printBound(a)
+	inter := !(a.Max[0] < cc.Min[0] || a.Min[0] > cc.Max[0] || a.Max[1] < cc.Min[1] || a.Min[1] > cc.Max[1])
+	out.set("intersects", inter)
+	pad := orb.Bound{Min: orb.Point{a.Min[0] - d, a.Min[1] - d}, Max: orb.Point{a.Max[0] + d, a.Max[1] + d}}
+	out["pad"] = fmt.Sprintf("%v", pad)
+	out["center"] = showPoint(orb.Point{(a.Min[0] + a.Max[0]) / 2, (a.Min[1] + a.Max[1]) / 2})
+	out["sides"] = fmt.Sprintf("%g %g %g %g %v %v", a.Max[1], a.Min[1], a.Min[0], a.Max[0], orb.Point{a.Min[0], a.Max[1]}, orb.Point{a.Max[0], a.Min[1]})
+	out.set("isempty", isEmpty(a))
+	out.set("pad-isempty", isEmpty(pad))
+	out.set("iszero", a == orb.Bound{})
+	out["toring"] = show(orb.Ring{a.Min, {a.Max[0], a.Min[1]}, a.Max, {a.Min[0], a.Max[1]}, a.Min})
+	out["type"] = "Polygon 2"
+	out["equal"] = fmt.Sprintf("true %v", a == cc)
+	if inter {
+		out["clip-bound"] = printBound(orb.Bound{
+			Min: orb.Point{math.Max(a.Min[0], cc.Min[0]), math.Max(a.Min[1], cc.Min[1])},
+			Max: orb.Point{math.Min(a.Max[0], cc.Max[0]), math.Min(a.Max[1], cc.Max[1])},
+		})
+	} else {
+		out["clip-bound"] = "empty"
+	}
+	out["clip-bound-empty"] = printBound(a) + " | " + printBound(a)
+	return out
+}
+
+// boundOfPoints is the box of the points (at least one).
+func boundOfPoints(ps ...orb.Point) orb.Bound {
+	b, _ := boundOf(ps)
+	return b
+}
+
+// boundsActual asks the library the same questions.
+func boundsActual(c boundsCase) checks {
+	out := checks{}
+	g, a, cc, p, d := c.g, c.a, c.c, c.p, c.d
+	out["bound"] = printBound(g.Bound())
+	if _, isBound := g.(orb.Bound); !isBound && len(coords(g)) > 0 && !hasEmptyPart(g) {
+		u := shapelyUnary(g)
+		if !u.Ok || u.Bounds == nil {
+			out["shapely-bounds"] = "unavailable: " + u.Error + " " + u.Message
+		} else {
+			out["shapely-bounds"] = showBound(orb.Bound{Min: orb.Point{u.Bounds[0], u.Bounds[1]}, Max: orb.Point{u.Bounds[2], u.Bounds[3]}})
+		}
+	}
+	empty := emptyBound
+	if isEmptyBound(a) {
+		out["union"] = printBound(a.Union(cc))
+		out["extend"] = printBound(a.Extend(p))
+		out["union-rev"] = printBound(cc.Union(a))
+		out.set("isempty", a.IsEmpty())
+		out["clip-bound"] = printBound(clip.Bound(a, cc))
+		out["clip-bound-empty"] = printBound(clip.Bound(a, empty)) + " | " + printBound(clip.Bound(empty, a))
+		return out
+	}
+	out.set("contains", a.Contains(p))
+	out["extend"] = printBound(a.Extend(p))
+	out["union"] = printBound(a.Union(cc))
+	out["union-rev"] = printBound(cc.Union(a))
+	out["union-empty-arg"] = printBound(a.Union(empty))
+	out.set("intersects", a.Intersects(cc) && cc.Intersects(a))
+	if a.Intersects(cc) != cc.Intersects(a) {
+		out["intersects"] = fmt.Sprintf("%v and %v reversed", a.Intersects(cc), cc.Intersects(a))
+	}
+	pad := a.Pad(d)
+	out["pad"] = fmt.Sprintf("%v", pad)
+	out["center"] = showPoint(a.Center())
+	out["sides"] = fmt.Sprintf("%g %g %g %g %v %v", a.Top(), a.Bottom(), a.Left(), a.Right(), a.LeftTop(), a.RightBottom())
+	out.set("isempty", a.IsEmpty())
+	out.set("pad-isempty", pad.IsEmpty())
+	out.set("iszero", a.IsZero())
+	out["toring"] = show(a.ToRing())
+	if !same(a.ToPolygon(), orb.Polygon{a.ToRing()}) {
+		out["toring"] = show(a.ToRing()) + " (ToPolygon differs: " + show(a.ToPolygon()) + ")"
+	}
+	out["type"] = fmt.Sprintf("%s %d", a.GeoJSONType(), a.Dimensions())
+	out["equal"] = fmt.Sprintf("%v %v", a.Equal(a), a.Equal(cc))
+	out["clip-bound"] = printBound(clip.Bound(a, cc))
+	out["clip-bound-empty"] = printBound(clip.Bound(a, empty)) + " | " + printBound(clip.Bound(empty, a))
+	return out
+}
+
+// judgeBounds is the judge of the family: the shape first, then the library.
+func judgeBounds(j *hzCaseJudge, c boundsCase) {
+	if isEmptyBound(c.a) {
+		hzTally("drawn empty receiver")
+	}
+	judgeBy(j, c, boundsExpected, boundsActual)
+}
+
+// TestHegelBounds: Bound() is the box of the coordinates (shapely agrees), the empty bound for
+// a geometry without coordinates; the Bound methods against their doc comments (an empty
+// receiver: Union, Extend and IsEmpty only); clip.Bound as recorded. The shapes of orb/3 (a
+// multi-part whose first part is empty; the empty receiver with a point or bound beyond the
+// unit square) and orb/4 (a zero-area receiver, or a pad that makes the area zero) are drawn
+// at their natural rates; the engine's first case has the zero-area receiver {0 0}-{0 0}.
+func TestHegelBounds(t *testing.T) {
+	judged(t, withoutShapes(boundsExpected, boundsCases), judgeBounds)
+}
diff --git a/hegel/hegel_codec_shapes_test.go b/hegel/hegel_codec_shapes_test.go
new file mode 100644
index 0000000..cdd270b
--- /dev/null
+++ b/hegel/hegel_codec_shapes_test.go
@@ -0,0 +1,173 @@
+package hegel
+
+// The narrow properties of the codecs: one per recorded bug of WKT and GeoJSON, drawing the
+// shape of the bug as its generator (hzShaped: the region past the shape under
+// HEGEL_NO_KNOWN=1) and judged by the family's judge, so that each fails every run naming its
+// bug by default and passes under HEGEL_NO_KNOWN=1. The surroundings of a shape are the plain
+// population (hegel_geometries_test.go), so that the classifier names the bug of the property
+// and not a neighbour: a collection is named orb/1 before anything else, and a text with
+// coordinates read through the double-space variant orb/2 before orb/8.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/paulmach/orb"
+	"hegel.dev/go/hegel"
+)
+
+// wktVariantsBut is the variant list without the named ones.
+func wktVariantsBut(names ...string) []wktVariant {
+	var out []wktVariant
+	for _, v := range wktVariants {
+		skip := false
+		for _, n := range names {
+			skip = skip || v.name == n
+		}
+		if !skip {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- orb/1
+
+// emptyMembers: an empty member of a collection, of each type that writes EMPTY.
+var emptyMembers = weightedOver[orb.Geometry]([]int{10, 10, 10, 10, 10},
+	orb.LineString{}, orb.MultiPoint{}, orb.Polygon{}, orb.MultiLineString{}, orb.Collection{})
+
+// collectionIngredients: what makes a collection the shape of orb/1 beyond being one: a plain
+// member (the collection is plain and fails only through the spaced variants and shapely's
+// text), a nested collection, an empty member.
+var collectionIngredients = hzWeighted(
+	hzW(10, plainGeometries.members),
+	hzW(10, asGeometry(plainGeometries.collections[0])),
+	hzW(10, emptyMembers),
+)
+
+// orb1Collections: a collection of 0..2 plain members, the ingredient, 0..2 plain members.
+var orb1Collections = hegel.Map(hzSeq(
+	hzCounted(plainGeometries.members, 0, 2),
+	hzOne(collectionIngredients),
+	hzCounted(plainGeometries.members, 0, 2),
+), func(ms []orb.Geometry) orb.Geometry { return orb.Collection(ms) })
+
+// TestHegelWKTCollectionsReadBackWithSpaces (orb/1): a collection's WKT reads back through
+// the whitespace variants of the grammar (a space after the commas, before the parentheses)
+// and from shapely's text, and a collection with a nested or an empty member reads back from
+// orb's own text; no proper prefix parses. The double-space variant is left to orb/2's
+// property. Under HEGEL_NO_KNOWN=1 the plain collections are drawn and the judge drops the
+// variant, shapely-text and prefix checks of each (counted "dropped orb/1").
+func TestHegelWKTCollectionsReadBackWithSpaces(t *testing.T) {
+	judged(t, hzShaped(
+		wktCasesOf(orb1Collections, wktVariantsBut("double-space")),
+		wktCasesOf(asGeometry(plainGeometries.collections[0]), wktVariantsBut("double-space")),
+	), judgeWKT)
+}
+
+// --------------------------------------------------------------------------- orb/2
+
+// whitespaceRuns: the variants of orb/2: two spaces for each one, a tab for each one.
+var whitespaceRuns = []wktVariant{
+	wktVariants[5], // double-space
+	{"tabs", func(s string) string { return strings.ReplaceAll(s, " ", "\t") }},
+}
+
+// plainNonCollections: the plain population without collections (which orb/1 names first):
+// the six simple kinds (their empty forms included), rings and bounds.
+var plainNonCollections = hzWeighted(
+	hzW(76, plainGeometries.geometries[0]),
+	hzW(12, asGeometry(plainGeometries.rings)),
+	hzW(12, asGeometry(bounds)),
+)
+
+// TestHegelWKTAllowsRunsOfWhitespace (orb/2): a text with two spaces or a tab between the
+// coordinates of a point, or between the keyword and EMPTY, reads back (the grammar allows
+// any whitespace between tokens). Under HEGEL_NO_KNOWN=1 the same geometries are read through
+// the variants with single spaces.
+func TestHegelWKTAllowsRunsOfWhitespace(t *testing.T) {
+	judged(t, hzShaped(
+		wktCasesOf(plainNonCollections, whitespaceRuns),
+		wktCasesOf(plainNonCollections, wktVariantsBut("double-space")),
+	), judgeWKT)
+}
+
+// --------------------------------------------------------------------------- orb/8
+
+// emptyParts: a geometry with an empty ring or an empty member line string, which the grammar
+// writes EMPTY: an empty ring, a polygon of an empty ring, a multi line string with an empty
+// member among 0..2 non-empty ones on each side.
+var emptyParts = hzWeighted(
+	hzW(10, hegel.Just[orb.Geometry](orb.Ring{})),
+	hzW(10, hegel.Just[orb.Geometry](orb.Polygon{orb.Ring{}})),
+	hzW(10, hegel.Map(hzSeq(
+		hzCounted(plainGeometries.nonEmptyLines, 0, 2),
+		hzOne(hegel.Just(orb.LineString{})),
+		hzCounted(plainGeometries.nonEmptyLines, 0, 2),
+	), func(ls []orb.LineString) orb.Geometry { return orb.MultiLineString(ls) })),
+)
+
+// plainParts: the region past: non-empty rings and multi line strings of non-empty members.
+var plainParts = hzWeighted(
+	hzW(10, asGeometry(plainGeometries.rings)),
+	hzW(10, asGeometry(plainGeometries.multiLineStrings)),
+)
+
+// TestHegelEmptyPartsAreWrittenEmpty (orb/8): an empty ring or an empty member line string is
+// written EMPTY, which orb's reader and shapely read back; the typed function agrees. The
+// double-space variant is left to orb/2's property.
+func TestHegelEmptyPartsAreWrittenEmpty(t *testing.T) {
+	judged(t, hzShaped(
+		wktCasesOf(emptyParts, wktVariantsBut("double-space")),
+		wktCasesOf(plainParts, wktVariantsBut("double-space")),
+	), judgeWKT)
+}
+
+// --------------------------------------------------------------------------- orb/9
+
+// emptyCollections: an empty collection alone, or held by a collection of plain members
+// (first, among, last), or held two deep.
+var emptyCollections = hzWeighted(
+	hzW(10, hegel.Just[orb.Geometry](orb.Collection{})),
+	hzW(10, hegel.Map(hzSeq(
+		hzCounted(plainGeometries.members, 0, 2),
+		hzOne(hegel.Just[orb.Geometry](orb.Collection{})),
+		hzCounted(plainGeometries.members, 0, 2),
+	), func(ms []orb.Geometry) orb.Geometry { return orb.Collection(ms) })),
+	hzW(10, hegel.Map(hzSeq(
+		hzCounted(plainGeometries.members, 0, 1),
+		hzOne(hegel.Just[orb.Geometry](orb.Collection{orb.Point{1, 2}, orb.Collection{}})),
+	), func(ms []orb.Geometry) orb.Geometry { return orb.Collection(ms) })),
+)
+
+// ownDocs: the geometry's own document only.
+var ownDocs = hegel.Just(docChoice{kind: "own"})
+
+// TestHegelEmptyCollectionIsAGeometryObject (orb/9): an empty collection is written as a
+// GeometryCollection with no geometries (never null), alone or as a member, and the document
+// reads back without a panic; a feature of it carries it. Under HEGEL_NO_KNOWN=1 the plain
+// collections are drawn.
+func TestHegelEmptyCollectionIsAGeometryObject(t *testing.T) {
+	judged(t, withoutShapes(geoJSONExpected, hzShaped(
+		geoJSONCasesOf(emptyCollections, ownDocs, plainGeometries.geometries[1]),
+		geoJSONCasesOf(asGeometry(plainGeometries.collections[0]), ownDocs, plainGeometries.geometries[1]),
+	)), judgeGeoJSON)
+}
+
+// --------------------------------------------------------------------------- orb/10
+
+// withCoordinates: the plain geometries that have a position to truncate (the empty forms,
+// with nothing to truncate, are filtered out: a few percent).
+var withCoordinates = hzOnly(true, "no coordinates", plainGeometries.any, func(g orb.Geometry) bool { return len(coords(g)) > 0 })
+
+// TestHegelShortPositionsAreRejected (orb/10): a document with a position of fewer than two
+// numbers (one of the geometry's own truncated, or a fixed text) is rejected by
+// UnmarshalGeometry and by json.Unmarshal into a Geometry. Under HEGEL_NO_KNOWN=1 the own
+// documents are read.
+func TestHegelShortPositionsAreRejected(t *testing.T) {
+	judged(t, withoutShapes(geoJSONExpected, hzShaped(
+		geoJSONCasesOf(withCoordinates, shortDocChoices, plainGeometries.geometries[1]),
+		geoJSONCasesOf(withCoordinates, ownDocs, plainGeometries.geometries[1]),
+	)), judgeGeoJSON)
+}
diff --git a/hegel/hegel_codec_test.go b/hegel/hegel_codec_test.go
new file mode 100644
index 0000000..e25fb99
--- /dev/null
+++ b/hegel/hegel_codec_test.go
@@ -0,0 +1,1630 @@
+package hegel
+
+// The codecs: WKT, WKB/EWKB and GeoJSON, as round trips and against shapely. The WKT and
+// GeoJSON properties draw their cases as records (hegel_geometries_test.go), state every
+// value they check with a model expected(c, k) of the case and the switch set (the documented
+// behaviour with every switch off: the WKT grammar, the GeoJSON object of RFC 7946, a position
+// of two numbers; with a switch on, a replica of the library's rule transcribed from its
+// code), name the shape of the recorded bug a case has by running the model per switch
+// (shapeBy, hegel_test.go) before the library is called, and judge the library against the
+// documented values. The WKB property has no recorded bug and no model: a round trip with
+// the judge.
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/paulmach/orb"
+	"github.com/paulmach/orb/encoding/ewkb"
+	"github.com/paulmach/orb/encoding/wkb"
+	"github.com/paulmach/orb/encoding/wkt"
+	"github.com/paulmach/orb/geojson"
+)
+
+// wktType is the WKT keyword of a geometry.
+func wktType(g orb.Geometry) string {
+	switch g.(type) {
+	case orb.Point:
+		return "POINT"
+	case orb.MultiPoint:
+		return "MULTIPOINT"
+	case orb.LineString:
+		return "LINESTRING"
+	case orb.MultiLineString:
+		return "MULTILINESTRING"
+	case orb.Polygon, orb.Ring, orb.Bound:
+		return "POLYGON"
+	case orb.MultiPolygon:
+		return "MULTIPOLYGON"
+	case orb.Collection:
+		return "GEOMETRYCOLLECTION"
+	}
+	panic(fmt.Sprintf("wktType %T", g))
+}
+
+// asGeoJSONType is the geometry as its GeoJSON type: a Ring becomes a Polygon and a Bound its
+// polygon (what the codecs write).
+func asGeoJSONType(g orb.Geometry) orb.Geometry {
+	switch g := g.(type) {
+	case orb.Ring:
+		return orb.Polygon{g}
+	case orb.Bound:
+		return g.ToPolygon()
+	}
+	return g
+}
+
+// hasEmptyMember reports whether a collection has an empty member (of any type) directly or
+// in a nested collection.
+func hasEmptyMember(g orb.Geometry) bool {
+	c, ok := g.(orb.Collection)
+	if !ok {
+		return false
+	}
+	for _, m := range c {
+		if len(coords(m)) == 0 {
+			return true
+		}
+		if hasEmptyMember(m) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasEmptyInnerPart reports whether the geometry has an empty part that WKT would write as an
+// EMPTY member: an empty Ring (alone or in a polygon) or an empty line string in a
+// MultiLineString, at any depth.
+func hasEmptyInnerPart(g orb.Geometry) bool {
+	switch g := g.(type) {
+	case orb.Ring:
+		return len(g) == 0
+	case orb.MultiLineString:
+		for _, ls := range g {
+			if len(ls) == 0 {
+				return true
+			}
+		}
+	case orb.Polygon:
+		for _, r := range g {
+			if len(r) == 0 {
+				return true
+			}
+		}
+	case orb.MultiPolygon:
+		for _, p := range g {
+			if hasEmptyInnerPart(p) {
+				return true
+			}
+		}
+	case orb.Collection:
+		for _, m := range g {
+			if hasEmptyInnerPart(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasEmptyCollection reports whether the geometry is, or holds at any depth, an empty
+// Collection.
+func hasEmptyCollection(g orb.Geometry) bool {
+	c, ok := g.(orb.Collection)
+	if !ok {
+		return false
+	}
+	if len(c) == 0 {
+		return true
+	}
+	for _, m := range c {
+		if hasEmptyCollection(m) {
+			return true
+		}
+	}
+	return false
+}
+
+func hasNestedCollection(g orb.Geometry) bool {
+	c, ok := g.(orb.Collection)
+	if !ok {
+		return false
+	}
+	for _, m := range c {
+		if _, ok := m.(orb.Collection); ok {
+			return true
+		}
+	}
+	return false
+}
+
+// spaceAfterCommas rewrites the WKT with ", " between members (the GEOS/PostGIS text form).
+func spaceAfterCommas(s string) string { return strings.ReplaceAll(s, ",", ", ") }
+
+var parenRe = regexp.MustCompile(`([A-Z])\(`)
+
+// spaceBeforeParens writes "POINT (1 2)" instead of "POINT(1 2)" (the GEOS form).
+func spaceBeforeParens(s string) string { return parenRe.ReplaceAllString(s, "$1 (") }
+
+// wktVariant is a whitespace or case variant of a WKT text the grammar reads as the same
+// geometry.
+type wktVariant struct {
+	name  string
+	apply func(string) string
+}
+
+// wktVariants are the variants of orb's own text the WKT property reads, in a fixed order (a
+// map iterated differently per replay).
+var wktVariants = []wktVariant{
+	{"leading/trailing", func(s string) string { return "  " + s + " \n" }},
+	{"space-parens", spaceBeforeParens},
+	{"space-commas", spaceAfterCommas},
+	{"tab-commas", func(s string) string { return strings.ReplaceAll(s, ",", ",\t") }},
+	{"lower", strings.ToLower},
+	{"double-space", func(s string) string { return strings.ReplaceAll(s, " ", "  ") }},
+}
+
+// --------------------------------------------------------------------------- the WKT writer
+
+// wktOf is a pure writer of what wkt.Marshal writes (encoding/wkt/wkt.go: %g coordinates, no
+// spaces but the one between coordinates, EMPTY for an empty top-level geometry), byte for
+// byte: an empty ring or an empty member line string is written "()" under kEmptyPartWKT
+// (wkt.go's writeLineString, orb/8) and EMPTY without it (the grammar's form).
+func wktOf(g orb.Geometry, k known) string {
+	var b strings.Builder
+	writeWKT(&b, g, k)
+	return b.String()
+}
+
+func writeWKT(b *strings.Builder, geom orb.Geometry, k known) {
+	switch g := geom.(type) {
+	case orb.Point:
+		fmt.Fprintf(b, "POINT(%g %g)", g[0], g[1])
+	case orb.MultiPoint:
+		if len(g) == 0 {
+			b.WriteString("MULTIPOINT EMPTY")
+			return
+		}
+		b.WriteString("MULTIPOINT(")
+		for i, p := range g {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			fmt.Fprintf(b, "(%g %g)", p[0], p[1])
+		}
+		b.WriteByte(')')
+	case orb.LineString:
+		if len(g) == 0 {
+			b.WriteString("LINESTRING EMPTY")
+			return
+		}
+		b.WriteString("LINESTRING")
+		writeWKTPart(b, g, k)
+	case orb.MultiLineString:
+		if len(g) == 0 {
+			b.WriteString("MULTILINESTRING EMPTY")
+			return
+		}
+		b.WriteString("MULTILINESTRING(")
+		for i, ls := range g {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			writeWKTPart(b, ls, k)
+		}
+		b.WriteByte(')')
+	case orb.Ring:
+		writeWKT(b, orb.Polygon{g}, k)
+	case orb.Polygon:
+		if len(g) == 0 {
+			b.WriteString("POLYGON EMPTY")
+			return
+		}
+		b.WriteString("POLYGON(")
+		writeWKTRings(b, g, k)
+		b.WriteByte(')')
+	case orb.MultiPolygon:
+		if len(g) == 0 {
+			b.WriteString("MULTIPOLYGON EMPTY")
+			return
+		}
+		b.WriteString("MULTIPOLYGON(")
+		for i, p := range g {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			if len(p) == 0 && !k[kEmptyPartWKT] { // not drawn: an empty polygon member
+				b.WriteString("EMPTY")
+				continue
+			}
+			b.WriteByte('(')
+			writeWKTRings(b, p, k)
+			b.WriteByte(')')
+		}
+		b.WriteByte(')')
+	case orb.Collection:
+		if len(g) == 0 {
+			b.WriteString("GEOMETRYCOLLECTION EMPTY")
+			return
+		}
+		b.WriteString("GEOMETRYCOLLECTION(")
+		for i, m := range g {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			writeWKT(b, m, k)
+		}
+		b.WriteByte(')')
+	case orb.Bound:
+		writeWKT(b, g.ToPolygon(), k)
+	default:
+		panic(fmt.Sprintf("wktOf: %T", geom))
+	}
+}
+
+func writeWKTRings(b *strings.Builder, p orb.Polygon, k known) {
+	for i, r := range p {
+		if i != 0 {
+			b.WriteByte(',')
+		}
+		writeWKTPart(b, r, k)
+	}
+}
+
+// writeWKTPart is wkt.go's writeLineString: "(x y,x y)", and "()" for no points (orb/8),
+// which the grammar spells EMPTY.
+func writeWKTPart(b *strings.Builder, ps []orb.Point, k known) {
+	if len(ps) == 0 && !k[kEmptyPartWKT] {
+		b.WriteString("EMPTY")
+		return
+	}
+	b.WriteByte('(')
+	for i, p := range ps {
+		if i != 0 {
+			b.WriteByte(',')
+		}
+		fmt.Fprintf(b, "%g %g", p[0], p[1])
+	}
+	b.WriteByte(')')
+}
+
+// --------------------------------------------------------------------------- the WKT reader
+
+// readWKT is the model of wkt.Unmarshal: the geometry a text denotes, or an error. It is one
+// parser with the library's structure (encoding/wkt/unmarshal.go: the trimmed text, the
+// keyword by the upper-cased prefix, the EMPTY form, the brackets, the comma splitter) and
+// three switched rules: under kWktCollectionMembers the members of a collection are cut by a
+// transcription of splitGeometryCollection (orb/1; the grammar's rule splits at the commas
+// outside parentheses and reads an EMPTY member); under kWktWhitespace a point is cut at its
+// first single space and the EMPTY forms are matched against the exact text (parsePoint and
+// the EqualFold tests of unmarshal.go, orb/2; the grammar's rule takes any whitespace); under
+// kEmptyPartWKT the parts of a polygon, multi line string or multi polygon are split by the
+// library's regexps and must be bracketed (orb/8; the grammar's rule reads an EMPTY part).
+// With every switch off it is the grammar's reader on the texts the properties read. A text
+// the library reads differently from this replica under every switch is a replica defect
+// (the collector counts "replica disagreement").
+func readWKT(s string, k known) (orb.Geometry, bool) {
+	s = wktTrim(s)
+	prefix := wktUpperPrefix(s)
+	switch {
+	case strings.HasPrefix(prefix, "POINT"):
+		return readWKTPoint(s, k)
+	case strings.HasPrefix(prefix, "LINESTRING"):
+		return readWKTLineString(s, k)
+	case strings.HasPrefix(prefix, "POLYGON"):
+		return readWKTPolygon(s, k)
+	case strings.HasPrefix(prefix, "MULTIPOINT"):
+		return readWKTMultiPoint(s, k)
+	case strings.HasPrefix(prefix, "MULTILINESTRING"):
+		return readWKTMultiLineString(s, k)
+	case strings.HasPrefix(prefix, "MULTIPOLYGON"):
+		return readWKTMultiPolygon(s, k)
+	case strings.HasPrefix(prefix, "GEOMETRYCOLLECTION"):
+		return readWKTCollection(s, k)
+	}
+	return nil, false
+}
+
+// readOutcome prints what readWKT gives: the geometry, or "error".
+func readOutcome(s string, k known) string {
+	g, ok := readWKT(s, k)
+	if !ok {
+		return "error"
+	}
+	return show(g)
+}
+
+// wktTrim is unmarshal.go's trimSpace: spaces, tabs and newlines trimmed at both ends (a
+// one-character text becomes empty, as there).
+func wktTrim(s string) string {
+	if len(s) == 0 {
+		return s
+	}
+	var start, end int
+	for start = 0; start < len(s); start++ {
+		if v := s[start]; v != ' ' && v != '\t' && v != '\n' {
+			break
+		}
+	}
+	for end = len(s) - 1; end >= 0; end-- {
+		if v := s[end]; v != ' ' && v != '\t' && v != '\n' {
+			break
+		}
+	}
+	if start >= end {
+		return ""
+	}
+	return s[start : end+1]
+}
+
+// wktUpperPrefix is unmarshal.go's upperPrefix: the first 20 bytes, ASCII upper-cased.
+func wktUpperPrefix(s string) string {
+	b := []byte(s)
+	if len(b) > 20 {
+		b = b[:20]
+	}
+	for i, c := range b {
+		if 'a' <= c && c <= 'z' {
+			b[i] = c - ('a' - 'A')
+		}
+	}
+	return string(b)
+}
+
+// wktTrimBrackets is unmarshal.go's trimSpaceBrackets: the trimmed text without its one
+// enclosing pair of parentheses (an empty text stays empty).
+func wktTrimBrackets(s string) (string, bool) {
+	s = wktTrim(s)
+	if len(s) == 0 {
+		return s, true
+	}
+	if s[0] == '(' {
+		s = s[1:]
+	} else {
+		return "", false
+	}
+	if s[len(s)-1] == ')' {
+		s = s[:len(s)-1]
+	} else {
+		return "", false
+	}
+	return wktTrim(s), true
+}
+
+// wktIsEmptyForm reports whether the text is "<TYPE> EMPTY": against the exact text under
+// kWktWhitespace (unmarshal.go's strings.EqualFold(s, "MULTIPOINT EMPTY") and the five like
+// it), else as two tokens separated by any whitespace.
+func wktIsEmptyForm(s, typ string, k known) bool {
+	if k[kWktWhitespace] {
+		return strings.EqualFold(s, typ+" EMPTY")
+	}
+	f := strings.Fields(s)
+	return len(f) == 2 && strings.EqualFold(f[0], typ) && strings.EqualFold(f[1], "EMPTY")
+}
+
+// wktParsePoint is unmarshal.go's parsePoint: under kWktWhitespace the text is cut at its
+// first single space (cut(s, " ")) and the two sides parsed as floats, so " 2" of "1  2" and
+// "1\t2" fail; else the two whitespace-separated fields.
+func wktParsePoint(s string, k known) (orb.Point, bool) {
+	var one, two string
+	if k[kWktWhitespace] {
+		i := strings.Index(s, " ")
+		if i < 0 {
+			return orb.Point{}, false
+		}
+		one, two = s[:i], s[i+1:]
+	} else {
+		f := strings.Fields(s)
+		if len(f) != 2 {
+			return orb.Point{}, false
+		}
+		one, two = f[0], f[1]
+	}
+	x, err := strconv.ParseFloat(one, 64)
+	if err != nil {
+		return orb.Point{}, false
+	}
+	y, err := strconv.ParseFloat(two, 64)
+	if err != nil {
+		return orb.Point{}, false
+	}
+	return orb.Point{x, y}, true
+}
+
+// wktSplitOnComma is unmarshal.go's splitOnComma: the pieces between commas, the spaces,
+// tabs and newlines around each comma dropped.
+func wktSplitOnComma(s string) []string {
+	var out []string
+	var at, start int
+	var sawSpace, sawComma bool
+	for i := 0; i < len(s); i++ {
+		if s[i] == ',' {
+			if !sawSpace {
+				sawSpace = true
+				start = i
+			}
+			sawComma = true
+			continue
+		}
+		if v := s[i]; v == ' ' || v == '\t' || v == '\n' {
+			if !sawSpace {
+				sawSpace = true
+				start = i
+			}
+			continue
+		}
+		if sawComma {
+			out = append(out, s[at:start])
+			at = i
+		}
+		sawSpace = false
+		sawComma = false
+	}
+	return append(out, s[at:])
+}
+
+// wktPoints reads "x y,x y" (the inside of a part's parentheses).
+func wktPoints(s string, k known) ([]orb.Point, bool) {
+	pieces := wktSplitOnComma(s)
+	ps := make([]orb.Point, 0, len(pieces))
+	for _, p := range pieces {
+		tp, ok := wktParsePoint(p, k)
+		if !ok {
+			return nil, false
+		}
+		ps = append(ps, tp)
+	}
+	return ps, true
+}
+
+var (
+	wktDoubleParen = regexp.MustCompile(`\)[\s|\t]*\)([\s|\t]*,[\s|\t]*)\([\s|\t]*\(`)
+	wktSingleParen = regexp.MustCompile(`\)([\s|\t]*,[\s|\t]*)\(`)
+)
+
+// wktSplitByRegexp is unmarshal.go's splitByRegexpYield: the pieces around the matches of
+// the separator's group.
+func wktSplitByRegexp(s string, re *regexp.Regexp) []string {
+	var out []string
+	start := 0
+	for _, m := range re.FindAllStringSubmatchIndex(s, -1) {
+		out = append(out, s[start:m[2]])
+		start = m[3]
+	}
+	return append(out, s[start:])
+}
+
+// wktSplitParts is the grammar's splitter of the parts of a multi geometry: the pieces at
+// the commas outside parentheses.
+func wktSplitParts(s string) []string {
+	var out []string
+	depth, start := 0, 0
+	for i := 0; i < len(s); i++ {
+		switch s[i] {
+		case '(':
+			depth++
+		case ')':
+			depth--
+		case ',':
+			if depth == 0 {
+				out = append(out, s[start:i])
+				start = i + 1
+			}
+		}
+	}
+	return append(out, s[start:])
+}
+
+// wktParts reads the parts of a polygon (its rings) or of a multi line string (its lines)
+// from the inside of its parentheses: under kEmptyPartWKT by the library's regexp split, each
+// part bracketed (so an EMPTY part is an error, orb/8); else at the commas outside
+// parentheses, an EMPTY part an empty one.
+func wktParts(s string, k known) ([][]orb.Point, bool) {
+	var pieces []string
+	if k[kEmptyPartWKT] {
+		pieces = wktSplitByRegexp(s, wktSingleParen)
+	} else {
+		pieces = wktSplitParts(s)
+	}
+	parts := make([][]orb.Point, 0, len(pieces))
+	for _, piece := range pieces {
+		if !k[kEmptyPartWKT] && strings.EqualFold(wktTrim(piece), "EMPTY") {
+			parts = append(parts, []orb.Point{})
+			continue
+		}
+		inner, ok := wktTrimBrackets(piece)
+		if !ok {
+			return nil, false
+		}
+		ps, ok := wktPoints(inner, k)
+		if !ok {
+			return nil, false
+		}
+		parts = append(parts, ps)
+	}
+	return parts, true
+}
+
+func readWKTPoint(s string, k known) (orb.Geometry, bool) {
+	inner, ok := wktTrimBrackets(s[5:])
+	if !ok {
+		return nil, false
+	}
+	p, ok := wktParsePoint(inner, k)
+	if !ok {
+		return nil, false
+	}
+	return p, true
+}
+
+func readWKTMultiPoint(s string, k known) (orb.Geometry, bool) {
+	if wktIsEmptyForm(s, "MULTIPOINT", k) {
+		return orb.MultiPoint{}, true
+	}
+	inner, ok := wktTrimBrackets(s[10:])
+	if !ok {
+		return nil, false
+	}
+	pieces := wktSplitOnComma(inner)
+	mp := make(orb.MultiPoint, 0, len(pieces))
+	for _, p := range pieces {
+		p, ok := wktTrimBrackets(p)
+		if !ok {
+			return nil, false
+		}
+		tp, ok := wktParsePoint(p, k)
+		if !ok {
+			return nil, false
+		}
+		mp = append(mp, tp)
+	}
+	return mp, true
+}
+
+func readWKTLineString(s string, k known) (orb.Geometry, bool) {
+	if wktIsEmptyForm(s, "LINESTRING", k) {
+		return orb.LineString{}, true
+	}
+	inner, ok := wktTrimBrackets(s[10:])
+	if !ok {
+		return nil, false
+	}
+	ps, ok := wktPoints(inner, k)
+	if !ok {
+		return nil, false
+	}
+	return orb.LineString(ps), true
+}
+
+func readWKTMultiLineString(s string, k known) (orb.Geometry, bool) {
+	if wktIsEmptyForm(s, "MULTILINESTRING", k) {
+		return orb.MultiLineString{}, true
+	}
+	inner, ok := wktTrimBrackets(s[15:])
+	if !ok {
+		return nil, false
+	}
+	parts, ok := wktParts(inner, k)
+	if !ok {
+		return nil, false
+	}
+	mls := make(orb.MultiLineString, 0, len(parts))
+	for _, ps := range parts {
+		mls = append(mls, orb.LineString(ps))
+	}
+	return mls, true
+}
+
+func wktPolygonOf(parts [][]orb.Point) orb.Polygon {
+	poly := make(orb.Polygon, 0, len(parts))
+	for _, ps := range parts {
+		poly = append(poly, orb.Ring(ps))
+	}
+	return poly
+}
+
+func readWKTPolygon(s string, k known) (orb.Geometry, bool) {
+	if wktIsEmptyForm(s, "POLYGON", k) {
+		return orb.Polygon{}, true
+	}
+	inner, ok := wktTrimBrackets(s[7:])
+	if !ok {
+		return nil, false
+	}
+	parts, ok := wktParts(inner, k)
+	if !ok {
+		return nil, false
+	}
+	return wktPolygonOf(parts), true
+}
+
+func readWKTMultiPolygon(s string, k known) (orb.Geometry, bool) {
+	if wktIsEmptyForm(s, "MULTIPOLYGON", k) {
+		return orb.MultiPolygon{}, true
+	}
+	inner, ok := wktTrimBrackets(s[12:])
+	if !ok {
+		return nil, false
+	}
+	var pieces []string
+	if k[kEmptyPartWKT] {
+		pieces = wktSplitByRegexp(inner, wktDoubleParen)
+	} else {
+		pieces = wktSplitParts(inner)
+	}
+	mp := make(orb.MultiPolygon, 0, len(pieces))
+	for _, piece := range pieces {
+		if !k[kEmptyPartWKT] && strings.EqualFold(wktTrim(piece), "EMPTY") {
+			mp = append(mp, orb.Polygon{})
+			continue
+		}
+		pinner, ok := wktTrimBrackets(piece)
+		if !ok {
+			return nil, false
+		}
+		parts, ok := wktParts(pinner, k)
+		if !ok {
+			return nil, false
+		}
+		mp = append(mp, wktPolygonOf(parts))
+	}
+	return mp, true
+}
+
+// wktSplitCollection is a transcription of unmarshal.go's splitGeometryCollection, the
+// members of "GEOMETRYCOLLECTION<s>" (orb/1): characters are stacked until the stack holds a
+// "("; from then on a letter (A..Y, a..y) ends the previous member at the stack less its last
+// character and starts a new one, and the last character of the text ends the stack as a
+// member without it.
+func wktSplitCollection(s string) []string {
+	r := make([]string, 0)
+	stack := make([]rune, 0)
+	l := len(s)
+	for i, v := range s {
+		if !strings.Contains(string(stack), "(") {
+			stack = append(stack, v)
+			continue
+		}
+		if ('A' <= v && v < 'Z') || ('a' <= v && v < 'z') {
+			t := string(stack)
+			r = append(r, t[:len(t)-1])
+			stack = make([]rune, 0)
+			stack = append(stack, v)
+			continue
+		}
+		if i == l-1 {
+			r = append(r, string(stack))
+			continue
+		}
+		stack = append(stack, v)
+	}
+	return r
+}
+
+func readWKTCollection(s string, k known) (orb.Geometry, bool) {
+	if wktIsEmptyForm(s, "GEOMETRYCOLLECTION", k) {
+		return orb.Collection{}, true
+	}
+	if k[kWktCollectionMembers] {
+		// unmarshal.go's unmarshalCollection: the bare keyword is an error, the members are
+		// cut by splitGeometryCollection, no members is the empty collection, an empty piece
+		// is skipped, and each piece is read as a geometry
+		if len(s) == 18 {
+			return nil, false
+		}
+		pieces := wktSplitCollection(s[18:])
+		if len(pieces) == 0 {
+			return orb.Collection{}, true
+		}
+		c := make(orb.Collection, 0, len(pieces))
+		for _, g := range pieces {
+			if len(g) == 0 {
+				continue
+			}
+			tg, ok := readWKT(g, k)
+			if !ok {
+				return nil, false
+			}
+			c = append(c, tg)
+		}
+		return c, true
+	}
+	inner, ok := wktTrimBrackets(s[18:])
+	if !ok || inner == "" {
+		return nil, false
+	}
+	pieces := wktSplitParts(inner)
+	c := make(orb.Collection, 0, len(pieces))
+	for _, g := range pieces {
+		tg, ok := readWKT(g, k)
+		if !ok {
+			return nil, false
+		}
+		c = append(c, tg)
+	}
+	return c, true
+}
+
+// --------------------------------------------------------------------------- GEOS's view
+
+// geosView is the geometry shapely (GEOS) holds after reading a text or document of the
+// geometry: GEOS has no polygon with an empty outer ring, so a polygon whose first ring is
+// empty is POLYGON EMPTY to it (the empty member line string of a multi line string stays).
+// The model of the "shapely reads it as" checks.
+func geosView(g orb.Geometry) orb.Geometry {
+	switch g := g.(type) {
+	case orb.Polygon:
+		if len(g) > 0 && len(g[0]) == 0 {
+			return orb.Polygon{}
+		}
+	case orb.MultiPolygon:
+		out := make(orb.MultiPolygon, len(g))
+		for i, p := range g {
+			out[i] = geosView(p).(orb.Polygon)
+		}
+		return out
+	case orb.Collection:
+		out := make(orb.Collection, len(g))
+		for i, m := range g {
+			out[i] = geosView(m)
+		}
+		return out
+	}
+	return g
+}
+
+// geosWKT is the text shapely writes for a geometry (to_wkt with trim and no rounding: a
+// space before every parenthesis, ", " between members, EMPTY for an empty geometry or
+// part), the text the WKT property has the library read.
+func geosWKT(g orb.Geometry) string {
+	pts := func(ps []orb.Point) string {
+		if len(ps) == 0 {
+			return "EMPTY"
+		}
+		parts := make([]string, len(ps))
+		for i, p := range ps {
+			parts[i] = showNum(p[0]) + " " + showNum(p[1])
+		}
+		return "(" + strings.Join(parts, ", ") + ")"
+	}
+	rings := func(p orb.Polygon) string {
+		if len(p) == 0 {
+			return "EMPTY"
+		}
+		parts := make([]string, len(p))
+		for i, r := range p {
+			parts[i] = pts(r)
+		}
+		return "(" + strings.Join(parts, ", ") + ")"
+	}
+	switch g := g.(type) {
+	case orb.Point:
+		return "POINT (" + showNum(g[0]) + " " + showNum(g[1]) + ")"
+	case orb.MultiPoint:
+		if len(g) == 0 {
+			return "MULTIPOINT EMPTY"
+		}
+		parts := make([]string, len(g))
+		for i, p := range g {
+			parts[i] = "(" + showNum(p[0]) + " " + showNum(p[1]) + ")"
+		}
+		return "MULTIPOINT (" + strings.Join(parts, ", ") + ")"
+	case orb.LineString:
+		if len(g) == 0 {
+			return "LINESTRING EMPTY"
+		}
+		return "LINESTRING " + pts(g)
+	case orb.MultiLineString:
+		if len(g) == 0 {
+			return "MULTILINESTRING EMPTY"
+		}
+		parts := make([]string, len(g))
+		for i, ls := range g {
+			parts[i] = pts(ls)
+		}
+		return "MULTILINESTRING (" + strings.Join(parts, ", ") + ")"
+	case orb.Polygon:
+		if len(g) == 0 {
+			return "POLYGON EMPTY"
+		}
+		return "POLYGON " + rings(g)
+	case orb.MultiPolygon:
+		if len(g) == 0 {
+			return "MULTIPOLYGON EMPTY"
+		}
+		parts := make([]string, len(g))
+		for i, p := range g {
+			parts[i] = rings(p)
+		}
+		return "MULTIPOLYGON (" + strings.Join(parts, ", ") + ")"
+	case orb.Collection:
+		if len(g) == 0 {
+			return "GEOMETRYCOLLECTION EMPTY"
+		}
+		parts := make([]string, len(g))
+		for i, m := range g {
+			parts[i] = geosWKT(m)
+		}
+		return "GEOMETRYCOLLECTION (" + strings.Join(parts, ", ") + ")"
+	}
+	panic(fmt.Sprintf("geosWKT: %T", g))
+}
+
+// --------------------------------------------------------------------------- the WKT property
+
+// wktOutcome prints what a library reader gave: the geometry, or "error".
+func wktOutcome(g orb.Geometry, err error) string {
+	if err != nil {
+		return "error"
+	}
+	return show(g)
+}
+
+// wktCut is the prefix cut of a text of length n: the case's cut, 1 + (cut-1) mod (n-1)
+// (the case draws it over the text's length; the modulo guards a text of another length).
+func wktCut(cut, n int) int {
+	if n < 2 {
+		return 0
+	}
+	return 1 + (cut-1)%(n-1)
+}
+
+// wktExpected: the text of the geometry (wktOf), what orb's reader makes of it and of each
+// variant (readWKT), the typed function of its type (the same reader) and the others
+// (ErrIncorrectGeometry), what shapely reads from the text (geosView, or an error on a "()"
+// text under kEmptyPartWKT), the text shapely writes (geosWKT) and what orb's reader makes of
+// it, and the proper prefix at the cut (an error: no proper prefix of a WKT text is complete;
+// under kWktCollectionMembers whatever the replica reads from it, since the splitter drops
+// the last character and ignores a trailing keyword).
+func wktExpected(c wktCase, k known) checks {
+	want := asGeoJSONType(c.g)
+	out := checks{}
+	s := wktOf(c.g, k)
+	out["text"] = s
+	out["own"] = readOutcome(s, k)
+	out["typed"] = out["own"]
+	out["typed-others"] = "ErrIncorrectGeometry"
+	if k[kEmptyPartWKT] && strings.Contains(s, "()") {
+		out["shapely-own"] = "error"
+	} else {
+		view := geosView(want)
+		out["shapely-own"] = show(view)
+		gt := geosWKT(view)
+		out["geos-text"] = gt
+		out["geos"] = readOutcome(gt, k)
+	}
+	for _, v := range c.variants {
+		out["variant "+v.name] = readOutcome(v.apply(s), k)
+	}
+	if cut := wktCut(c.cut, len(s)); c.cut > 0 && cut > 0 {
+		out["prefix"] = "error"
+		if k[kWktCollectionMembers] {
+			if _, ok := readWKT(s[:cut], k); ok {
+				out["prefix"] = "ok"
+			}
+		}
+	}
+	return out
+}
+
+// wktActual asks the library the same questions.
+func wktActual(c wktCase) checks {
+	g := c.g
+	out := checks{}
+	s := wkt.MarshalString(g)
+	out["text"] = s
+	if m := wkt.Marshal(g); !bytes.Equal(m, []byte(s)) {
+		out["text"] = s + " (Marshal writes " + string(m) + ")"
+	}
+	out["own"] = wktOutcome(wkt.Unmarshal(s))
+
+	typed := map[string]func(string) (orb.Geometry, error){
+		"POINT":              func(s string) (orb.Geometry, error) { return wkt.UnmarshalPoint(s) },
+		"MULTIPOINT":         func(s string) (orb.Geometry, error) { return wkt.UnmarshalMultiPoint(s) },
+		"LINESTRING":         func(s string) (orb.Geometry, error) { return wkt.UnmarshalLineString(s) },
+		"MULTILINESTRING":    func(s string) (orb.Geometry, error) { return wkt.UnmarshalMultiLineString(s) },
+		"POLYGON":            func(s string) (orb.Geometry, error) { return wkt.UnmarshalPolygon(s) },
+		"MULTIPOLYGON":       func(s string) (orb.Geometry, error) { return wkt.UnmarshalMultiPolygon(s) },
+		"GEOMETRYCOLLECTION": func(s string) (orb.Geometry, error) { return wkt.UnmarshalCollection(s) },
+	}
+	others := "ErrIncorrectGeometry"
+	for _, name := range []string{"POINT", "MULTIPOINT", "LINESTRING", "MULTILINESTRING", "POLYGON", "MULTIPOLYGON", "GEOMETRYCOLLECTION"} {
+		got, err := typed[name](s)
+		if name == wktType(g) {
+			out["typed"] = wktOutcome(got, err)
+		} else if !errors.Is(err, wkt.ErrIncorrectGeometry) {
+			others = fmt.Sprintf("Unmarshal%s = %s, %v", name, show(got), err)
+		}
+	}
+	out["typed-others"] = others
+
+	r := shapelyWKT(s)
+	if !r.Ok {
+		out["shapely-own"] = "error"
+	} else {
+		out["shapely-own"] = show(fromHexWKB(r.WKB))
+		out["geos-text"] = r.WKT
+		out["geos"] = wktOutcome(wkt.Unmarshal(r.WKT))
+	}
+	for _, v := range c.variants {
+		out["variant "+v.name] = wktOutcome(wkt.Unmarshal(v.apply(s)))
+	}
+	if cut := wktCut(c.cut, len(s)); c.cut > 0 && cut > 0 {
+		out["prefix"] = "error"
+		if _, err := wkt.Unmarshal(s[:cut]); err == nil {
+			out["prefix"] = "ok"
+		}
+	}
+	return out
+}
+
+// wktDroppable: the checks a shape may cover without the case being skipped under
+// HEGEL_NO_KNOWN=1: the whitespace variants, shapely's text and the prefix, which orb/1 fails
+// on every collection and orb/2 on every text with coordinates (the own text, the typed
+// functions and shapely's reading of the own text must still hold there).
+func wktDroppable(name string) bool {
+	return strings.HasPrefix(name, "variant ") || name == "geos" || name == "prefix"
+}
+
+// judgeWKT: the shape first (by default named, every check made; under HEGEL_NO_KNOWN=1 the
+// checks the shape covers are dropped when they are all droppable, else the case is
+// skipped), then the library against the documented values.
+func judgeWKT(j *hzCaseJudge, c wktCase) {
+	shape := classify(c, wktExpected)
+	want := wktExpected(c, hzKnownNone)
+	if shape != "" && hzNoKnown {
+		all := wktExpected(c, hzKnownAll)
+		var differing []string
+		droppable := true
+		for _, name := range sortedKeys(want) {
+			if v, ok := all[name]; !ok || v != want[name] {
+				differing = append(differing, name)
+				droppable = droppable && wktDroppable(name)
+			}
+		}
+		for name := range all {
+			if _, ok := want[name]; !ok {
+				droppable = droppable && wktDroppable(name)
+			}
+		}
+		if droppable && j.Dropped(shape) {
+			for _, name := range differing {
+				delete(want, name)
+			}
+		} else {
+			j.Shape(shape)
+		}
+	} else {
+		j.Shape(shape)
+	}
+	verdict(j, c, wktActual(c), want, shape, wktExpected)
+}
+
+// TestHegelWKT: Marshal writes the WKT of the grammar (EMPTY for an empty part), which shapely
+// reads as the same geometry; Unmarshal reads orb's text, shapely's text and the whitespace
+// variants the WKT grammar allows back to the geometry; the typed Unmarshal functions accept
+// their type and reject the others with ErrIncorrectGeometry; a proper prefix of a text is
+// rejected. The shapes of orb/1 (a collection: its variants and shapely's text; a nested or
+// an empty member: its own text; some prefixes), orb/2 (the double-space variant) and orb/8
+// (an empty ring or member line string) are drawn at their natural rates.
+func TestHegelWKT(t *testing.T) {
+	judged(t, wktCases, judgeWKT)
+}
