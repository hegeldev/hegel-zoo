+// collectionStartsEmpty reports whether some multi-geometry or collection in the geometry has
+// a coordinate-less part before a part with coordinates (the case where Bound() unions onto
+// an empty bound).
+func collectionStartsEmpty(g orb.Geometry) bool {
+	var parts []orb.Geometry
+	switch g := g.(type) {
+	case orb.Collection:
+		parts = g
+	case orb.MultiLineString:
+		for _, ls := range g {
+			parts = append(parts, ls)
+		}
+	case orb.Polygon:
+		for _, r := range g {
+			parts = append(parts, r)
+		}
+	case orb.MultiPolygon:
+		for _, p := range g {
+			parts = append(parts, p)
+		}
+	default:
+		return false
+	}
+	seenEmpty := false
+	for _, m := range parts {
+		if collectionStartsEmpty(m) {
+			return true
+		}
+		if len(coords(m)) == 0 {
+			seenEmpty = true
+		} else if seenEmpty {
+			return true
+		}
+	}
+	return false
+}
