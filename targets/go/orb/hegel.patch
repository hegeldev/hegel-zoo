+// TestHegelBounds: Bound() is the box of the coordinates (shapely agrees), the empty bound for
+// a geometry without coordinates; the Bound methods against their doc comments; clip.Bound.
+func TestHegelBounds(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		g := genAnyGeometry(ht)
+		b := g.Bound()
+		if bb, ok := g.(orb.Bound); ok {
+			if !b.Equal(bb) {
+				col.fail(ht, "Bound.Bound() = %v", b)
+			}
+		} else if want, ok := boundOf(coords(g)); ok {
+			if !b.Equal(want) {
+				if !(Known.unionOfEmptyBound && collectionStartsEmpty(g)) {
+					col.failClass(ht, "bound", "%v.Bound() = %v, want %v", g, b, want)
+				}
+			}
+			u := shapelyUnary(g)
+			if u.Ok && u.Bounds != nil {
+				sb := orb.Bound{Min: orb.Point{u.Bounds[0], u.Bounds[1]}, Max: orb.Point{u.Bounds[2], u.Bounds[3]}}
+				if !sb.Equal(want) {
+					col.failClass(ht, "shapely-bounds", "shapely bounds of %v = %v, model %v", g, sb, want)
+				}
+			}
+		} else if !b.IsEmpty() {
+			col.failClass(ht, "empty-bound", "%v (no coordinates).Bound() = %v, not empty", g, b)
+		}
+
+		// the methods
+		a := genBound(ht)
+		c := genBound(ht)
+		p := genPoint(ht)
+		if chance(ht, 30) { // on the boundary
+			p = pick(ht, []orb.Point{a.Min, a.Max, a.LeftTop(), a.RightBottom(), {a.Min[0], (a.Min[1] + a.Max[1]) / 2}})
+		}
+		inA := a.Min[0] <= p[0] && p[0] <= a.Max[0] && a.Min[1] <= p[1] && p[1] <= a.Max[1]
+		if a.Contains(p) != inA {
+			col.failClass(ht, "contains", "%v.Contains(%v) = %v", a, p, !inA)
+		}
+		e := a.Extend(p)
+		wantE := orb.Bound{Min: orb.Point{math.Min(a.Min[0], p[0]), math.Min(a.Min[1], p[1])}, Max: orb.Point{math.Max(a.Max[0], p[0]), math.Max(a.Max[1], p[1])}}
+		if !e.Equal(wantE) {
+			col.failClass(ht, "extend", "%v.Extend(%v) = %v, want %v", a, p, e, wantE)
+		}
+		u := a.Union(c)
+		wantU := orb.Bound{Min: orb.Point{math.Min(a.Min[0], c.Min[0]), math.Min(a.Min[1], c.Min[1])}, Max: orb.Point{math.Max(a.Max[0], c.Max[0]), math.Max(a.Max[1], c.Max[1])}}
+		if !u.Equal(wantU) || !c.Union(a).Equal(wantU) {
+			col.failClass(ht, "union", "%v.Union(%v) = %v, want %v", a, c, u, wantU)
+		}
+		empty := orb.Bound{Min: orb.Point{1, 1}, Max: orb.Point{-1, -1}}
+		if !a.Union(empty).Equal(a) {
+			col.failClass(ht, "union-empty-arg", "%v.Union(empty) = %v", a, a.Union(empty))
+		}
+		if !Known.unionOfEmptyBound && !empty.Union(a).Equal(a) {
+			col.failClass(ht, "union-empty-receiver", "empty.Union(%v) = %v", a, empty.Union(a))
+		}
+		inter := !(a.Max[0] < c.Min[0] || a.Min[0] > c.Max[0] || a.Max[1] < c.Min[1] || a.Min[1] > c.Max[1])
+		if a.Intersects(c) != inter || c.Intersects(a) != inter {
+			col.failClass(ht, "intersects", "%v.Intersects(%v) = %v, want %v", a, c, a.Intersects(c), inter)
+		}
+		d := float64(drawInt(ht, -300, 300)) / 100
+		pad := a.Pad(d)
+		if pad.Min[0] != a.Min[0]-d || pad.Min[1] != a.Min[1]-d || pad.Max[0] != a.Max[0]+d || pad.Max[1] != a.Max[1]+d {
+			col.failClass(ht, "pad", "%v.Pad(%v) = %v", a, d, pad)
+		}
+		center := a.Center()
+		if center[0] != (a.Min[0]+a.Max[0])/2 || center[1] != (a.Min[1]+a.Max[1])/2 {
+			col.failClass(ht, "center", "%v.Center() = %v", a, center)
+		}
+		if a.Top() != a.Max[1] || a.Bottom() != a.Min[1] || a.Left() != a.Min[0] || a.Right() != a.Max[0] ||
+			a.LeftTop() != (orb.Point{a.Min[0], a.Max[1]}) || a.RightBottom() != (orb.Point{a.Max[0], a.Min[1]}) {
+			col.failClass(ht, "sides", "sides of %v: %v %v %v %v", a, a.Top(), a.Bottom(), a.Left(), a.Right())
+		}
+		zeroArea := a.Min[0] == a.Max[0] || a.Min[1] == a.Max[1]
+		wantEmpty := false
+		if !Known.isEmptyZeroArea {
+			wantEmpty = zeroArea
+		}
+		if a.IsEmpty() != wantEmpty {
+			col.failClass(ht, "isempty", "%v.IsEmpty() = %v (zero area %v)", a, a.IsEmpty(), zeroArea)
+		}
+		if !pad.IsEmpty() && (pad.Min[0] > pad.Max[0] || pad.Min[1] > pad.Max[1]) {
+			col.failClass(ht, "isempty-negative", "%v.IsEmpty() = false with Min > Max", pad)
+		}
+		if a.IsZero() != (a == orb.Bound{}) {
+			col.failClass(ht, "iszero", "%v.IsZero() = %v", a, a.IsZero())
+		}
+		ring := a.ToRing()
+		wantRing := orb.Ring{a.Min, {a.Max[0], a.Min[1]}, a.Max, {a.Min[0], a.Max[1]}, a.Min}
+		if !same(ring, wantRing) || !same(a.ToPolygon(), orb.Polygon{wantRing}) {
+			col.failClass(ht, "toring", "%v.ToRing() = %v", a, ring)
+		}
+		if a.GeoJSONType() != "Polygon" || a.Dimensions() != 2 {
+			col.failClass(ht, "type", "%v: %s %d", a, a.GeoJSONType(), a.Dimensions())
+		}
+		if !a.Equal(a) || a.Equal(c) != (a == c) {
+			col.failClass(ht, "equal", "%v.Equal(%v) = %v", a, c, a.Equal(c))
+		}
