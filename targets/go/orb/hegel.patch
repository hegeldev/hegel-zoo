+// orb/1: collection members separated by ", ", nested collections, EMPTY members, a space
+// before the collection's parenthesis.
+func TestHegelPinWKTCollectionMembers(t *testing.T) {
+	cases := map[string]orb.Geometry{
+		"GEOMETRYCOLLECTION(POINT(1 2), LINESTRING(3 4,5 6))":           orb.Collection{orb.Point{1, 2}, orb.LineString{{3, 4}, {5, 6}}},
+		"GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (3 4, 5 6))":       orb.Collection{orb.Point{1, 2}, orb.LineString{{3, 4}, {5, 6}}},
+		"GEOMETRYCOLLECTION (POINT (1 2))":                              orb.Collection{orb.Point{1, 2}},
+		"GEOMETRYCOLLECTION(POINT(1 2),GEOMETRYCOLLECTION(POINT(3 4)))": orb.Collection{orb.Point{1, 2}, orb.Collection{orb.Point{3, 4}}},
+		"GEOMETRYCOLLECTION(MULTIPOINT EMPTY,POINT(1 2))":               orb.Collection{orb.MultiPoint{}, orb.Point{1, 2}},
+		"GEOMETRYCOLLECTION(POINT(1 2),MULTIPOINT EMPTY)":               orb.Collection{orb.Point{1, 2}, orb.MultiPoint{}},
+		"GEOMETRYCOLLECTION(LINESTRING EMPTY)":                          orb.Collection{orb.LineString{}},
+	}
+	for s, want := range cases {
+		got, err := wkt.Unmarshal(s)
+		if err != nil {
+			t.Errorf("Unmarshal(%q) = %v", s, err)
+		} else if !same(got, want) {
+			t.Errorf("Unmarshal(%q) = %v, want %v", s, got, want)
+		}
+	}
+	// and a prefix must not parse
+	if g, err := wkt.Unmarshal("GEOMETRYCOLLECTION(GEOMETRYCOLLECTION EMPTY,"); err == nil {
+		t.Errorf("Unmarshal of a truncated collection = %v", g)
+	}
+}
+
+// orb/2: whitespace between tokens is free in WKT.
+func TestHegelPinWKTWhitespace(t *testing.T) {
+	cases := map[string]orb.Geometry{
+		"POINT(1  2)":                 orb.Point{1, 2},
+		"POINT( 1 2 )":                orb.Point{1, 2},
+		"LINESTRING(1 2,3  4)":        orb.LineString{{1, 2}, {3, 4}},
+		"MULTIPOINT  EMPTY":           orb.MultiPoint{},
+		"MULTIPOINT((1 2),(3\t4))":    orb.MultiPoint{{1, 2}, {3, 4}},
+		"POLYGON((0 0,1 0,1  1,0 0))": orb.Polygon{{{0, 0}, {1, 0}, {1, 1}, {0, 0}}},
+	}
+	for s, want := range cases {
+		got, err := wkt.Unmarshal(s)
+		if err != nil {
+			t.Errorf("Unmarshal(%q) = %v", s, err)
+		} else if !same(got, want) {
+			t.Errorf("Unmarshal(%q) = %v, want %v", s, got, want)
+		}
+	}
+}
