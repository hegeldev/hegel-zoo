+	for _, p := range []orb.Point{{2, 3}, {3, 2}, {4, 4}, {2, 2}} {
+		if !planar.PolygonContains(poly, p) {
+			t.Errorf("PolygonContains(polygon with hole, %v on the hole boundary) = false", p)
