+package hegel
+
+// Hegel property tests for paulmach/orb, written for the Hegel zoo. See targets/go/orb/README.md.
+//
+// Oracles: shapely 2.1.2 (GEOS 3.13.1) through a Python child process for the codecs (WKT,
+// WKB, GeoJSON), the planar measures (area, length, centroid, distance, point in polygon),
+// Douglas-Peucker simplification and clipping; models written from the doc comments for the
+// rest (bounds, map tiles, the quadtree, resampling, radial simplification, the geo formulas,
+// rounding, cloning and equality).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// wkt.Unmarshal fails on a GEOMETRYCOLLECTION whose members are separated by ", " (a space
+	// after the comma), on a nested collection, and on an EMPTY member before another member;
+	// an EMPTY member after another member is dropped silently. The splitter for collection
+	// members looks for the first letter after a ")" and takes what came before it, minus one
+	// character, as the previous member.
+	wktCollectionMembers bool
+	// wkt.Unmarshal rejects two consecutive spaces between the coordinates of a point
+	// ("POINT(1  2)") or before EMPTY ("MULTIPOINT  EMPTY"), though WKT separates tokens by
+	// any whitespace.
+	wktWhitespace bool
+	// Bound.Extend and Bound.Union on an empty bound (Min > Max, as an empty geometry's Bound()
+	// returns) mix the empty bound's coordinates into the result, so the Bound() of a
+	// Collection, MultiLineString, Polygon or MultiPolygon whose first part is empty is wrong:
+	// Collection{MultiPoint{}, Point{5, 5}}.Bound() is [1 1]-[5 5].
+	unionOfEmptyBound bool
+	// Bound.IsEmpty is documented to be true for a bound of zero area; it is true only when
+	// Min > Max, so a point's bound is not empty.
+	isEmptyZeroArea bool
+	// maptile.At and Fraction do not clamp the longitude: At(Point{180, 0}, z) is X = 2^z, an
+	// invalid tile, though At is documented to create a valid tile for the zoom (and
