+// orb/3: Union/Extend on an empty bound, and the Bound() of geometries whose first part is
+// empty.
+func TestHegelPinUnionOfEmptyBound(t *testing.T) {
+	empty := orb.MultiPoint{}.Bound()
+	if !empty.IsEmpty() {
+		t.Fatalf("MultiPoint{}.Bound() = %v, not empty", empty)
+	}
+	a := orb.Bound{Min: orb.Point{5, 5}, Max: orb.Point{6, 6}}
+	if got := empty.Union(a); !got.Equal(a) {
+		t.Errorf("empty.Union(%v) = %v", a, got)
+	}
+	if got := empty.Extend(orb.Point{5, 5}); !got.Equal(orb.Bound{Min: orb.Point{5, 5}, Max: orb.Point{5, 5}}) {
+		t.Errorf("empty.Extend(5 5) = %v", got)
+	}
+	want := orb.Bound{Min: orb.Point{5, 5}, Max: orb.Point{5, 5}}
+	if got := (orb.Collection{orb.MultiPoint{}, orb.Point{5, 5}}).Bound(); !got.Equal(want) {
+		t.Errorf("Collection{MultiPoint{}, Point{5 5}}.Bound() = %v, want %v", got, want)
+	}
+	if got := (orb.Collection{orb.LineString{}, orb.Point{-3, -3}}).Bound(); !got.Equal(orb.Bound{Min: orb.Point{-3, -3}, Max: orb.Point{-3, -3}}) {
+		t.Errorf("Collection{LineString{}, Point{-3 -3}}.Bound() = %v", got)
+	}
+	mls := orb.MultiLineString{{}, {{-10, -1}, {1, -2}}}
+	if got := mls.Bound(); !got.Equal(orb.Bound{Min: orb.Point{-10, -2}, Max: orb.Point{1, -1}}) {
+		t.Errorf("%v.Bound() = %v", mls, got)
+	}
+	mp := orb.MultiPolygon{{}, {{{5, 5}, {6, 5}, {6, 6}, {5, 5}}}}
+	if got := mp.Bound(); !got.Equal(orb.Bound{Min: orb.Point{5, 5}, Max: orb.Point{6, 6}}) {
+		t.Errorf("%v.Bound() = %v", mp, got)
+	}
+}
