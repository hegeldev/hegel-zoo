+// orb/5: At creates a valid tile for every longitude in [-180, 180].
+func TestHegelPinTileAtLongitude180(t *testing.T) {
+	for _, z := range []maptile.Zoom{0, 1, 5, 20} {
+		tile := maptile.At(orb.Point{180, 0}, z)
+		if !tile.Valid() {
+			t.Errorf("At(180 0, %d) = %v is not valid", z, tile)
+		}
+		if z > 8 {
+			continue // tilecover.Bound allocates a set of every tile in the box
+		}
+		set := tilecover.Bound(orb.Bound{Min: orb.Point{170, -10}, Max: orb.Point{180, 10}}, z)
+		for tt := range set {
+			if !tt.Valid() {
+				t.Errorf("tilecover.Bound up to longitude 180 at zoom %d has the invalid tile %v", z, tt)
+				break
+			}
+		}
+	}
+}
