+// orb/6: a point on a hole's boundary is on the polygon's boundary, so "in".
+func TestHegelPinHoleBoundaryContained(t *testing.T) {
+	poly := orb.Polygon{
+		{{0, 0}, {10, 0}, {10, 10}, {0, 10}, {0, 0}},
+		{{2, 2}, {4, 2}, {4, 4}, {2, 4}, {2, 2}},
