+// shoelace is twice the signed area of a ring (positive counter-clockwise), exact for small
+// two-decimal coordinates up to floating error.
+func shoelace(r orb.Ring) float64 {
+	s := 0.0
+	n := len(r)
+	if n == 0 {
+		return 0
+	}
+	for i := 0; i < n; i++ {
+		a, b := r[i], r[(i+1)%n]
+		s += a[0]*b[1] - b[0]*a[1]
+	}
+	return s
+}
+
+// modelLength is the sum of the segment lengths of every line in the geometry.
+func modelLength(g orb.Geometry) float64 {
+	switch g := g.(type) {
+	case orb.Point, orb.MultiPoint:
+		return 0
+	case orb.LineString:
+		s := 0.0
+		for i := 1; i < len(g); i++ {
+			s += pointDistance(g[i-1], g[i])
+		}
+		return s
+	case orb.Ring:
+		return modelLength(orb.LineString(g))
+	case orb.MultiLineString:
+		s := 0.0
+		for _, ls := range g {
+			s += modelLength(ls)
+		}
+		return s
+	case orb.Polygon:
+		s := 0.0
+		for _, r := range g {
+			s += modelLength(r)
+		}
+		return s
+	case orb.MultiPolygon:
+		s := 0.0
+		for _, p := range g {
+			s += modelLength(p)
+		}
+		return s
+	case orb.Collection:
+		s := 0.0
+		for _, m := range g {
+			s += modelLength(m)
+		}
+		return s
+	case orb.Bound:
+		return modelLength(g.ToRing())
+	}
+	panic("modelLength")
+}
+
+// modelDistanceFrom is planar.DistanceFrom's contract: the distance to the boundary of a
+// polygon, to the geometry otherwise, the minimum over a collection's members (recursively);
+// shapely computes the leaves.
+func modelDistanceFrom(g orb.Geometry, p orb.Point) float64 {
+	switch gg := g.(type) {
+	case orb.Collection:
+		d := math.Inf(1)
+		for _, m := range gg {
+			d = math.Min(d, modelDistanceFrom(m, p))
+		}
+		return d
+	case orb.Bound:
+		return modelDistanceFrom(gg.ToPolygon(), p)
+	case orb.Ring:
+		return modelDistanceFrom(orb.LineString(gg), p)
+	}
+	if len(coords(g)) == 0 {
+		return math.Inf(1)
+	}
+	r := shapelyPoint(g, p)
+	if !r.Ok {
+		panic(fmt.Sprintf("shapely PT on %v: %s %s", g, r.Error, r.Message))
+	}
+	return num(r.BDist)
+}
+
+// pointOnRing draws a vertex of a ring, or (midpoints, for axis-parallel rings whose midpoints
+// are exactly on the edge) an edge midpoint.
+func pointOnRing(tc hegel.TestCase, r orb.Ring, midpoints bool) orb.Point {
+	i := drawInt(tc, 0, len(r)-2)
+	if !midpoints || chance(tc, 50) {
+		return r[i]
+	}
+	return orb.Point{(r[i][0] + r[i+1][0]) / 2, (r[i][1] + r[i+1][1]) / 2}
+}
+
+// onRing reports whether p is a vertex or an edge midpoint of the ring (what pointOnRing draws).
+func onRing(p orb.Point, r orb.Ring) bool {
+	for i := 0; i < len(r)-1; i++ {
+		if p == r[i] || p == (orb.Point{(r[i][0] + r[i+1][0]) / 2, (r[i][1] + r[i+1][1]) / 2}) {
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelPlanar: area, length, centroid and distance against shapely (and exact models),
+// point-in-ring/polygon against shapely's covers, orientation against the shoelace sign.
+func TestHegelPlanar(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		g := genAnyGeometry(ht)
+		u := shapelyUnary(asGeoJSONType(g))
+		if !u.Ok {
+			col.fail(ht, "shapely on %v: %s %s", g, u.Error, u.Message)
+			return
+		}
+
+		// area and length
+		area := planar.Area(g)
+		wantArea := num(u.Area)
+		if r, ok := g.(orb.Ring); ok {
+			// a ring's area is signed
+			if (shoelace(r) < 0) != (area < 0) && area != 0 {
+				col.failClass(ht, "ring-area-sign", "Area(%v) = %v, shoelace %v", r, area, shoelace(r))
+			}
+			area = math.Abs(area)
+		}
+		if !closeNum(area, wantArea, 1e-9, 1e-9) {
+			col.failClass(ht, "area", "Area(%v) = %v, shapely %v", g, area, wantArea)
+		}
+		length := planar.Length(g)
+		if !closeNum(length, num(u.Length), 1e-9, 1e-9) || !closeNum(length, modelLength(g), 1e-9, 1e-9) {
+			col.failClass(ht, "length", "Length(%v) = %v, shapely %v, model %v", g, length, num(u.Length), modelLength(g))
+		}
+
+		// centroid (of the highest-dimension members, as GEOS)
+		cen, area2 := planar.CentroidArea(g)
+		if _, ok := g.(orb.Ring); !ok && area2 != planar.Area(g) {
+			col.failClass(ht, "centroid-area", "CentroidArea(%v) area %v, Area %v", g, area2, planar.Area(g))
+		}
+		if u.Centroid != nil {
+			want := orb.Point{u.Centroid[0], u.Centroid[1]}
+			degenerateRing := false
+			switch gg := g.(type) {
+			case orb.Ring:
+				degenerateRing = shoelace(gg) == 0
+			case orb.Bound:
+				degenerateRing = gg.Min[0] == gg.Max[0] || gg.Min[1] == gg.Max[1]
+			}
+			if Known.degenerateRingCentroid && degenerateRing {
+				want = coords(g)[0] // the first point (a Bound: its Min)
+			}
+			if _, isCol := g.(orb.Collection); isCol && Known.collectionCentroidByArea && planar.Area(g) == 0 {
+				want = orb.Point{} // the origin: weights are areas
+			}
+			if !closePoints(cen, want, 1e-7) {
+				col.failClass(ht, "centroid", "CentroidArea(%#v) centroid %v, shapely %v", g, cen, want)
+			}
+		}
+
+		// distances
+		p := genPoint(ht)
+		q := genPoint(ht)
+		if d := planar.Distance(p, q); !closeNum(d, math.Hypot(p[0]-q[0], p[1]-q[1]), 0, 1e-14) || planar.DistanceSquared(p, q) != (p[0]-q[0])*(p[0]-q[0])+(p[1]-q[1])*(p[1]-q[1]) {
+			col.failClass(ht, "distance", "Distance(%v, %v) = %v", p, q, d)
+		}
+		if len(coords(g)) > 0 {
+			if chance(ht, 30) {
+				cs := coords(g)
+				p = cs[drawInt(ht, 0, len(cs)-1)]
+			}
+			r := shapelyPoint(asGeoJSONType(g), p)
+			if r.Ok {
+				d := planar.DistanceFrom(g, p)
+				want := modelDistanceFrom(g, p)
+				if !closeNum(d, want, 1e-9, 1e-9) {
+					col.failClass(ht, "distance-from", "DistanceFrom(%v, %v) = %v, shapely %v", g, p, d, want)
+				}
+				d2, idx := planar.DistanceFromWithIndex(g, p)
+				if d2 != d {
+					col.failClass(ht, "distance-from-index", "DistanceFromWithIndex(%v, %v) = %v, DistanceFrom %v", g, p, d2, d)
+				}
+				switch gg := g.(type) {
+				case orb.MultiPoint:
+					if idx < 0 || idx >= len(gg) || !closeNum(pointDistance(gg[idx], p), d, 0, 1e-14) {
+						col.failClass(ht, "index", "DistanceFromWithIndex(%v, %v) index %d", g, p, idx)
+					}
+				case orb.MultiLineString, orb.MultiPolygon, orb.Collection:
+					n := 0
+					switch gg := gg.(type) {
+					case orb.MultiLineString:
+						n = len(gg)
+					case orb.MultiPolygon:
+						n = len(gg)
+					case orb.Collection:
+						n = len(gg)
+					}
+					if idx < 0 || idx >= n {
+						col.failClass(ht, "index", "DistanceFromWithIndex(%v, %v) index %d of %d", g, p, idx, n)
+					}
+				}
+			}
+		}
+		// segment distance against the projection model
+		a, b := genPoint(ht), genPoint(ht)
+		if a != b {
+			vx, vy := b[0]-a[0], b[1]-a[1]
+			tt := ((p[0]-a[0])*vx + (p[1]-a[1])*vy) / (vx*vx + vy*vy)
+			tt = math.Max(0, math.Min(1, tt))
+			cp := orb.Point{a[0] + tt*vx, a[1] + tt*vy}
+			want := pointDistance(cp, p)
+			if d := planar.DistanceFromSegment(a, b, p); !closeNum(d, want, 1e-9, 1e-9) {
+				col.failClass(ht, "segment", "DistanceFromSegment(%v, %v, %v) = %v, want %v", a, b, p, d, want)
+			}
+		}
+
+		// point in ring / polygon
+		var poly orb.Polygon
+		switch gg := g.(type) {
+		case orb.Polygon:
+			poly = gg
+		case orb.Ring:
+			if len(gg) > 0 {
+				poly = orb.Polygon{gg}
+			}
+		case orb.Bound:
+			poly = gg.ToPolygon()
+		}
+		if len(poly) > 0 {
+			pt := genPoint(ht)
+			switch drawInt(ht, 0, 3) {
+			case 0:
+				pt = pointOnRing(ht, poly[0], false)
+			case 1:
+				if len(poly) > 1 {
+					pt = pointOnRing(ht, poly[drawInt(ht, 1, len(poly)-1)], true)
+				}
+			case 2:
+				pt = poly[0].Bound().Center()
+			}
+			r := shapelyPoint(poly, pt)
+			if r.Ok {
+				want := r.Covers
+				onHole := false
+				for _, h := range poly[1:] {
+					if onRing(pt, h) {
+						onHole = true
+					}
+				}
+				if Known.holeBoundaryNotContained && onHole && !onRing(pt, poly[0]) {
+					want = false
+				}
+				if got := planar.PolygonContains(poly, pt); got != want {
+					col.failClass(ht, "polygon-contains", "PolygonContains(%v, %v) = %v, shapely covers %v", poly, pt, got, r.Covers)
+				}
+				if got := planar.MultiPolygonContains(orb.MultiPolygon{poly}, pt); got != want {
+					col.failClass(ht, "multipolygon-contains", "MultiPolygonContains({%v}, %v) = %v, want %v", poly, pt, got, want)
+				}
+			}
+			ri := drawInt(ht, 0, len(poly)-1)
+			rr := shapelyPoint(orb.Polygon{poly[ri]}, pt)
+			if rr.Ok {
+				if got := planar.RingContains(poly[ri], pt); got != rr.Covers {
+					col.failClass(ht, "ring-contains", "RingContains(%v, %v) = %v, shapely covers %v", poly[ri], pt, got, rr.Covers)
+				}
+			}
+			// orientation
+			for _, r := range poly {
+				s := shoelace(r)
+				want := orb.CCW
+				if s < 0 {
+					want = orb.CW
+				}
+				if s != 0 && r.Orientation() != want {
+					col.failClass(ht, "orientation", "%v.Orientation() = %v, shoelace %v", r, r.Orientation(), s)
+				}
+				rc := r.Clone()
+				rc.Reverse()
+				if s != 0 && rc.Orientation() != -want {
+					col.failClass(ht, "orientation-reverse", "reversed %v.Orientation() = %v", r, rc.Orientation())
+				}
+				if !r.Closed() {
+					col.failClass(ht, "closed", "%v.Closed() = false", r)
+				}
+			}
+		}
+		col.count(g.GeoJSONType())
+	})
+}
+
+// TestHegelRoundCloneEqual: Round rounds every coordinate to the factor (default 1e6) and is
+// idempotent; Clone shares nothing with the original; Equal is structural.
+func TestHegelRoundCloneEqual(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		g := genAnyGeometry(ht)
+		// perturb a copy to get non-rounded coordinates
+		h := orb.Clone(g)
+		if !orb.Equal(g, h) || !same(g, h) {
+			col.failClass(ht, "clone-equal", "Clone(%v) = %v", g, h)
+		}
+		cs := coords(h)
+		if len(cs) > 0 && h.GeoJSONType() != "Point" {
+			if _, isB := h.(orb.Bound); !isB {
+				// mutate the clone's first coordinate in place
+				mutateFirst(h, 1e-3)
+				if same(g, h) || orb.Equal(g, h) {
+					col.failClass(ht, "clone-shared", "mutating the clone of %v changed the original", g)
+				}
+				if same(g, orb.Clone(g)) == false {
+					col.failClass(ht, "clone-after", "Clone(%v) differs after the first clone was mutated", g)
+				}
+			}
+		}
+		factor := pick(ht, []int{1, 10, 100, 1000, 1000000})
+		var rounded orb.Geometry
+		if factor == 1000000 && chance(ht, 50) {
+			rounded = orb.Round(orb.Clone(g))
+		} else {
+			rounded = orb.Round(orb.Clone(g), factor)
+		}
+		rc := coords(rounded)
+		oc := coords(g)
+		if len(rc) != len(oc) || rounded.GeoJSONType() != g.GeoJSONType() {
+			col.failClass(ht, "round-shape", "Round(%v, %d) = %v", g, factor, rounded)
+		} else {
+			f := float64(factor)
+			for i := range rc {
+				want := orb.Point{math.Round(oc[i][0]*f) / f, math.Round(oc[i][1]*f) / f}
+				if rc[i] != want {
+					col.failClass(ht, "round", "Round(%v, %d) coordinate %d = %v, want %v", g, factor, i, rc[i], want)
+					break
+				}
+			}
+		}
+		if again := orb.Round(orb.Clone(rounded), factor); !same(again, rounded) {
+			col.failClass(ht, "round-idempotent", "Round twice of %v with %d: %v then %v", g, factor, rounded, again)
+		}
+		// types and dimensions
+		wantDim := map[string]int{"Point": 0, "MultiPoint": 0, "LineString": 1, "MultiLineString": 1, "Polygon": 2, "MultiPolygon": 2}
+		if d, ok := wantDim[g.GeoJSONType()]; ok && g.Dimensions() != d {
+			col.failClass(ht, "dimensions", "%v.Dimensions() = %d", g, g.Dimensions())
+		}
+		if c, ok := g.(orb.Collection); ok {
+			max := -1 // the empty collection: no dimension
+			for _, m := range c {
+				if m.Dimensions() > max {
+					max = m.Dimensions()
+				}
+			}
+			if c.Dimensions() != max {
+				col.failClass(ht, "dimensions", "%v.Dimensions() = %d, want %d", g, c.Dimensions(), max)
+			}
+		}
+		if _, ok := g.(orb.Ring); ok && (g.GeoJSONType() != "Polygon" || g.Dimensions() != 2) {
+			col.failClass(ht, "ring-type", "Ring type %s dim %d", g.GeoJSONType(), g.Dimensions())
+		}
+		// Equal against a different geometry of the same type
+		h2 := genAnyGeometry(ht)
+		if orb.Equal(g, h2) != same(g, h2) {
+			col.failClass(ht, "equal", "Equal(%v, %v) = %v, structural %v", g, h2, orb.Equal(g, h2), same(g, h2))
+		}
+		// LineString.Reverse twice is the identity, once reverses
+		if ls, ok := g.(orb.LineString); ok && len(ls) > 0 {
+			r := ls.Clone()
+			r.Reverse()
+			for i := range ls {
+				if r[i] != ls[len(ls)-1-i] {
+					col.failClass(ht, "reverse", "%v reversed is %v", ls, r)
+					break
+				}
+			}
+			r.Reverse()
+			if !same(r, ls) {
+				col.failClass(ht, "reverse-twice", "%v reversed twice is %v", ls, r)
+			}
+		}
+		col.count("ok")
+	})
+}
+
+// mutateFirst adds d to the first coordinate found in the geometry (in place).
+func mutateFirst(g orb.Geometry, d float64) {
+	switch g := g.(type) {
+	case orb.MultiPoint:
+		if len(g) > 0 {
+			g[0][0] += d
+		}
+	case orb.LineString:
+		if len(g) > 0 {
+			g[0][0] += d
+		}
+	case orb.Ring:
+		if len(g) > 0 {
+			g[0][0] += d
+		}
+	case orb.MultiLineString:
+		for _, ls := range g {
+			if len(ls) > 0 {
+				ls[0][0] += d
+				return
+			}
+		}
+	case orb.Polygon:
+		for _, r := range g {
+			if len(r) > 0 {
+				r[0][0] += d
+				return
+			}
+		}
+	case orb.MultiPolygon:
+		for _, p := range g {
+			if len(coords(p)) > 0 {
+				mutateFirst(p, d)
+				return
+			}
+		}
+	case orb.Collection:
+		for i, m := range g {
+			if len(coords(m)) > 0 {
+				if p, ok := m.(orb.Point); ok {
+					p[0] += d
+					g[i] = p
+					return
+				}
+				mutateFirst(m, d)
+				return
+			}
+		}
+	}
+}
