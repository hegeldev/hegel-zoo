+		ls:        hegel.Draw(tc, linesOf(simplifyLineCounts)),
+		threshold: float64(hegel.Draw(tc, hzInts(0, 600))) / 100,
+		keep:      hegel.Draw(tc, keeps),
+		r:         hegel.Draw(tc, starRings),
+		g:         hegel.Draw(tc, anyGeometries),
+		s:         hegel.Draw(tc, weightedOver([]int{3, 7, 9}, 0, 1, 2)), // 33 each nominal: 3/7/9 realise 34/34/32 (4/7/7 realised 37/34/29)
