+// --------------------------------------------------------------------------- the WKB property
+
+// TestHegelWKB: Marshal in either byte order decodes back (Unmarshal, the stream Decoder, the
+// hex form); shapely reads the bytes as the same geometry and writes the same little-endian
+// bytes; EWKB carries the SRID; a proper prefix is rejected without a panic. No recorded bug
+// lives here; the one case assumed away is Polygon{Ring{}} (a bare empty ring), modelled as
+// recorded: its WKB is a ring of zero points, which shapely reads as POLYGON EMPTY.
+func TestHegelWKB(t *testing.T) {
+	judged(t, wkbCases, func(j *hzCaseJudge, c wkbCase) {
+		g := c.g
+		if r, ok := g.(orb.Ring); ok && len(r) == 0 {
+			hzTally("assumed Polygon{Ring{}}")
+			j.ht.Assume(false)
+		}
+		want := asGeoJSONType(g)
+		order := c.order
+		data, err := wkb.Marshal(g, order)
+		if err != nil {
+			j.Fail("marshal", "Marshal(%s) = %v", show(g), err)
+			return
+		}
+		if !bytes.Equal(wkb.MustMarshal(g, order), data) {
+			j.Fail("must-marshal", "MustMarshal differs from Marshal for %s", show(g))
+		}
+		h, _ := wkb.MarshalToHex(g, order)
+		if h != hex.EncodeToString(data) || wkb.MustMarshalToHex(g, order) != h {
+			j.Fail("hex", "MarshalToHex(%s) = %q, bytes %x", show(g), h, data)
+		}
+		back, err := wkb.Unmarshal(data)
+		if err != nil {
+			j.Fail("own-unmarshal-error", "Unmarshal(Marshal(%s)) = %v", show(g), err)
+		} else if !same(back, want) {
+			j.Fail("own-unmarshal-differs", "Unmarshal(Marshal(%s)) = %s", show(g), show(back))
+		}
+
+		r := shapelyWKB(hex.EncodeToString(data))
+		if !r.Ok {
+			j.Fail("shapely-rejects", "shapely rejects orb's WKB of %s: %s %s", show(g), r.Error, r.Message)
+		} else {
+			if !same(fromHexWKB(r.WKB), want) {
+				j.Fail("shapely-differs", "shapely reads orb's WKB of %s as %s", show(g), r.WKT)
+			}
+			le := wkb.MustMarshal(g, binary.LittleEndian)
+			if r.WKB != hex.EncodeToString(le) {
+				j.Fail("bytes-differ", "orb's little-endian WKB of %s is %x, shapely writes %s", show(g), le, r.WKB)
+			}
+		}
+
+		// the stream: two geometries with a chosen byte order
+		g2 := c.g2
+		var buf bytes.Buffer
+		enc := wkb.NewEncoder(&buf).SetByteOrder(order)
+		if err := enc.Encode(g); err != nil {
+			j.Fail("encode", "Encode(%s) = %v", show(g), err)
+		}
+		if err := enc.Encode(g2); err != nil {
+			j.Fail("encode", "Encode(%s) = %v", show(g2), err)
+		}
+		dec := wkb.NewDecoder(bytes.NewReader(buf.Bytes()))
+		d1, err1 := dec.Decode()
+		d2, err2 := dec.Decode()
+		if err1 != nil || err2 != nil || !same(d1, want) || !same(d2, g2) {
+			j.Fail("stream", "stream of %s, %s decodes to %s (%v), %s (%v)", show(g), show(g2), show(d1), err1, show(d2), err2)
+		}
+		if _, err := dec.Decode(); err == nil {
+			j.Fail("stream-eof", "a third Decode on a two-geometry stream succeeded")
+		}
+
+		// EWKB with an SRID
+		srid := c.srid
+		edata, err := ewkb.Marshal(g, srid, order)
+		if err != nil {
+			j.Fail("ewkb-marshal", "ewkb.Marshal(%s, %d) = %v", show(g), srid, err)
+			return
+		}
+		eg, gotSRID, err := ewkb.Unmarshal(edata)
+		if err != nil || gotSRID != srid || !same(eg, want) {
+			j.Fail("ewkb", "ewkb.Unmarshal(Marshal(%s, %d)) = %s, %d, %v", show(g), srid, show(eg), gotSRID, err)
+		}
+		if srid == 0 && !bytes.Equal(edata, data) {
+			j.Fail("ewkb-srid0", "ewkb.Marshal with SRID 0 is not the WKB: %x vs %x", edata, data)
+		}
+		if srid != 0 {
+			// the plain WKB decoder must not read an EWKB with an SRID as if it were plain
+			if pg, err := wkb.Unmarshal(edata); err == nil && !same(pg, want) {
+				j.Fail("wkb-reads-ewkb-wrong", "wkb.Unmarshal of EWKB (srid %d) of %s = %s", srid, show(g), show(pg))
+			}
+		}
+
+		// prefixes: never a panic, never a success
+		if len(data) > 1 {
+			cut := wktCut(c.cut, len(data))
+			if pg, err := wkb.Unmarshal(data[:cut]); err == nil {
+				j.Fail("prefix-accepted", "Unmarshal of the first %d of %d bytes of %s succeeded: %s", cut, len(data), show(g), show(pg))
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- the GeoJSON writer
+
+// jsonNum is encoding/json's float64 encoding: the shortest 'f' form (the 'e' form is for
+// magnitudes below 1e-6 or from 1e21, which the coordinates never reach).
+func jsonNum(f float64) string { return strconv.FormatFloat(f, 'f', -1, 64) }
+
+// truncation cuts one position of a document to keep numbers (the shape of orb/10).
+type truncation struct {
+	index, keep int
+}
+
+// geoJSONOf is a pure writer of what json.Marshal(geojson.NewGeometry(g)) writes
+// (geojson/geometry.go: NewGeometry converts a ring or bound to a polygon, MarshalJSON writes
+// {"type":...,"coordinates":...} for the simple types and
+// {"type":"GeometryCollection","geometries":[...]} for a collection), byte for byte: an empty
+// collection, at the top or as a member, is written null under kEmptyCollectionGeoJSON
+// (MarshalJSON with neither coordinates nor geometries, orb/9) and the object with no
+// geometries without it (the GeoJSON form). With a truncation, the position at its index
+// (modulo the count, in coordinate order) is cut to its first keep numbers.
+func geoJSONOf(g orb.Geometry, k known, trunc *truncation) string {
+	var b strings.Builder
+	n := len(coords(asGeoJSONType(g)))
+	pos := 0
+	var cut *truncation
+	if trunc != nil && n > 0 {
+		cut = &truncation{index: trunc.index % n, keep: trunc.keep}
+	}
+	writeGeoJSON(&b, asGeoJSONType(g), k, cut, &pos)
+	return b.String()
+}
+
+func writeGeoJSON(b *strings.Builder, g orb.Geometry, k known, cut *truncation, pos *int) {
+	point := func(p orb.Point) {
+		if cut != nil && *pos == cut.index {
+			b.WriteByte('[')
+			if cut.keep > 0 {
+				b.WriteString(jsonNum(p[0]))
+			}
+			b.WriteByte(']')
+		} else {
+			b.WriteString("[" + jsonNum(p[0]) + "," + jsonNum(p[1]) + "]")
+		}
+		*pos++
+	}
+	pts := func(ps []orb.Point) {
+		b.WriteByte('[')
+		for i, p := range ps {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			point(p)
+		}
+		b.WriteByte(']')
+	}
+	rings := func(p orb.Polygon) {
+		b.WriteByte('[')
+		for i, r := range p {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			pts(r)
+		}
+		b.WriteByte(']')
+	}
+	switch g := g.(type) {
+	case orb.Point:
+		b.WriteString(`{"type":"Point","coordinates":`)
+		point(g)
+		b.WriteByte('}')
+	case orb.MultiPoint:
+		b.WriteString(`{"type":"MultiPoint","coordinates":`)
+		pts(g)
+		b.WriteByte('}')
+	case orb.LineString:
+		b.WriteString(`{"type":"LineString","coordinates":`)
+		pts(g)
+		b.WriteByte('}')
+	case orb.MultiLineString:
+		b.WriteString(`{"type":"MultiLineString","coordinates":[`)
+		for i, ls := range g {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			pts(ls)
+		}
+		b.WriteString("]}")
+	case orb.Polygon:
+		b.WriteString(`{"type":"Polygon","coordinates":`)
+		rings(g)
+		b.WriteByte('}')
+	case orb.MultiPolygon:
+		b.WriteString(`{"type":"MultiPolygon","coordinates":[`)
+		for i, p := range g {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			rings(p)
+		}
+		b.WriteString("]}")
+	case orb.Collection:
+		if len(g) == 0 && k[kEmptyCollectionGeoJSON] {
+			b.WriteString("null")
+			return
+		}
+		b.WriteString(`{"type":"GeometryCollection","geometries":[`)
+		for i, m := range g {
+			if i != 0 {
+				b.WriteByte(',')
+			}
+			writeGeoJSON(b, asGeoJSONType(m), k, cut, pos)
+		}
+		b.WriteString("]}")
+	default:
+		panic(fmt.Sprintf("geoJSONOf: %T", g))
+	}
+}
+
+// withPosition is the geometry with its i-th coordinate (in coordinate order) replaced.
+func withPosition(g orb.Geometry, i int, p orb.Point) orb.Geometry {
+	pos := 0
+	var walk func(g orb.Geometry) orb.Geometry
+	line := func(ps []orb.Point) []orb.Point {
+		out := make([]orb.Point, len(ps))
+		for j, q := range ps {
+			if pos == i {
+				q = p
+			}
+			pos++
+			out[j] = q
+		}
+		return out
+	}
+	walk = func(g orb.Geometry) orb.Geometry {
+		switch g := g.(type) {
+		case orb.Point:
+			return orb.Point(line([]orb.Point{g})[0])
+		case orb.MultiPoint:
+			return orb.MultiPoint(line(g))
+		case orb.LineString:
+			return orb.LineString(line(g))
+		case orb.Ring:
+			return orb.Ring(line(g))
+		case orb.MultiLineString:
+			out := make(orb.MultiLineString, len(g))
+			for j, ls := range g {
+				out[j] = orb.LineString(line(ls))
+			}
+			return out
+		case orb.Polygon:
+			out := make(orb.Polygon, len(g))
+			for j, r := range g {
+				out[j] = orb.Ring(line(r))
+			}
+			return out
+		case orb.MultiPolygon:
+			out := make(orb.MultiPolygon, len(g))
+			for j, p := range g {
+				out[j] = walk(p).(orb.Polygon)
+			}
+			return out
+		case orb.Collection:
+			out := make(orb.Collection, len(g))
+			for j, m := range g {
+				out[j] = walk(m)
+			}
+			return out
+		}
+		panic(fmt.Sprintf("withPosition: %T", g))
+	}
+	return walk(g)
+}
+
+// --------------------------------------------------------------------------- the GeoJSON property
+
+// readGeoJSON prints what a reader of a document gave: "panic", "error" or the geometry.
+func readGeoJSON(read func() (orb.Geometry, error)) (out string) {
+	defer func() {
+		if r := recover(); r != nil {
+			out = "panic"
+		}
+	}()
+	g, err := read()
+	if err != nil {
+		return "error"
+	}
+	return show(g)
+}
+
+// fixedGeometries are what the fixed short-position documents are read as under
+// kShortPositionAccepted: encoding/json fills a [2]float64 from a shorter array and zeroes
+// the rest (orb.Point has no UnmarshalJSON of its own).
+var fixedGeometries = []orb.Geometry{orb.Point{0, 0}, orb.Point{1, 0}, orb.LineString{{1, 2}, {3, 0}}}
+
+// docText is the document the case reads back: the geometry's own, its own with a position
+// truncated, or a fixed text (shortDocs).
+func docText(c geoJSONCase, k known) string {
+	switch c.doc.kind {
+	case "truncated":
+		return geoJSONOf(c.g, k, &truncation{index: c.doc.pos, keep: c.doc.keep})
+	case "fixed":
+		return shortDocs[c.doc.fixed]
+	}
+	return geoJSONOf(c.g, k, nil)
+}
+
+// geoJSONExpected: the type and the document (geoJSONOf), the outcome of reading the drawn
+// document back (the geometry; under kEmptyCollectionGeoJSON an error for a top-level null
+// and a panic for a document with a null member; a short position an error, or under
+// kShortPositionAccepted the geometry with the missing coordinates zero), shapely's reading
+// of the document and orb's reading of shapely's (for a geometry without empty parts, as
+// today), the helper types' document and readings, the feature (its geometry: absent for a
+// top-level empty collection under kEmptyCollectionGeoJSON, a panic for a held one;
+// properties, id, bbox and type), the feature collection with the second geometry, and the
+// bound as a BBox.
+func geoJSONExpected(c geoJSONCase, k known) checks {
+	want := asGeoJSONType(c.g)
+	out := checks{}
+	out["type"] = want.GeoJSONType()
+	out["doc"] = geoJSONOf(c.g, k, nil)
+	empty, nested := hasEmptyCollection(want) && len(coords(want)) == 0 && isEmptyCollection(want), false
+	if hasEmptyCollection(want) && !isEmptyCollection(want) {
+		nested = true
+	}
+	// the document read back
+	read := show(want)
+	switch {
+	case c.doc.kind == "fixed":
+		read = "error"
+		if k[kShortPositionAccepted] {
+			read = show(fixedGeometries[c.doc.fixed])
+		}
+	case k[kEmptyCollectionGeoJSON] && nested:
+		read = "panic"
+	case k[kEmptyCollectionGeoJSON] && empty:
+		read = "error"
+	case c.doc.kind == "truncated" && len(coords(want)) > 0:
+		read = "error"
+		if k[kShortPositionAccepted] {
+			i := c.doc.pos % len(coords(want))
+			p := orb.Point{}
+			if c.doc.keep > 0 {
+				p[0] = coords(want)[i][0]
+			}
+			read = show(withPosition(want, i, p))
+		}
+	}
+	out["own"] = read
+	out["json-unmarshal"] = read
+	if !hasEmptyPart(want) {
+		out["shapely"] = show(want)
+		out["geos-doc"] = show(want)
+	}
+	switch want.(type) {
+	case orb.Point, orb.MultiPoint, orb.LineString, orb.MultiLineString, orb.Polygon, orb.MultiPolygon:
+		out["helper-doc"] = out["doc"]
+		switch want.(type) {
+		case orb.Point, orb.Polygon, orb.MultiLineString:
+			out["helper-read"] = show(want)
+		}
+		if _, isPoint := want.(orb.Point); !isPoint {
+			out["helper-wrong"] = "error"
+		}
+	}
+	// the feature and the feature collection
+	feature := show(want)
+	switch {
+	case k[kEmptyCollectionGeoJSON] && nested:
+		feature = "panic"
+	case k[kEmptyCollectionGeoJSON] && empty:
+		feature = "<nil>"
+	}
+	out["feature"] = feature
+	if feature != "panic" {
+		out["feature-properties"] = fmt.Sprintf("name=%q n=%v", c.name, float64(c.n))
+		out["feature-id"] = fmt.Sprint(c.id)
+		out["feature-bbox"] = map[bool]string{false: "absent", true: "ok"}[c.bbox]
+		out["feature-type"] = "Feature"
+	}
+	second := show(c.g2)
+	switch {
+	case k[kEmptyCollectionGeoJSON] && hasEmptyCollection(c.g2) && !isEmptyCollection(c.g2):
+		second = "panic"
+	case k[kEmptyCollectionGeoJSON] && isEmptyCollection(c.g2):
+		second = "<nil>"
+	}
+	if feature == "panic" || second == "panic" {
+		out["fc"] = "panic"
+	} else {
+		out["fc"] = feature + " | " + second
+	}
+	out["bbox"] = "ok"
+	return out
+}
+
+// isEmptyCollection reports whether g is Collection{} itself.
+func isEmptyCollection(g orb.Geometry) bool {
+	c, ok := g.(orb.Collection)
+	return ok && len(c) == 0
+}
+
+// geoJSONActual asks the library the same questions.
+func geoJSONActual(c geoJSONCase) checks {
+	g := c.g
+	want := asGeoJSONType(g)
+	out := checks{}
+	jg := geojson.NewGeometry(g)
+	out["type"] = jg.Type
+	data, err := json.Marshal(jg)
+	if err != nil {
+		out["doc"] = "error: " + err.Error()
+		return out
+	}
+	out["doc"] = string(data)
+	if data2, err := jg.MarshalJSON(); err != nil || !bytes.Equal(data, data2) {
+		out["doc"] = string(data) + " (MarshalJSON writes " + string(data2) + ")"
+	}
+	doc := data
+	if c.doc.kind != "own" {
+		doc = []byte(docText(c, hzKnownAll))
+	}
+	out["own"] = readGeoJSON(func() (orb.Geometry, error) {
+		back, err := geojson.UnmarshalGeometry(doc)
+		if err != nil {
+			return nil, err
+		}
+		return back.Geometry(), nil
+	})
+	out["json-unmarshal"] = readGeoJSON(func() (orb.Geometry, error) {
+		var jg2 geojson.Geometry
+		if err := json.Unmarshal(doc, &jg2); err != nil {
+			return nil, err
+		}
+		return jg2.Geometry(), nil
+	})
+
+	// shapely reads the document as the same geometry, and orb reads shapely's document
+	if !hasEmptyPart(want) { // GEOS's GeoJSON reader turns empty parts into empty collections
+		r := shapelyGeoJSON(string(data))
+		if !r.Ok {
+			out["shapely"] = "error: " + r.Error + " " + r.Message
+		} else {
+			out["shapely"] = show(fromHexWKB(r.WKB))
+		}
+		gj := shapelyToGeoJSON(want)
+		if gj.Ok {
+			out["geos-doc"] = readGeoJSON(func() (orb.Geometry, error) {
+				back, err := geojson.UnmarshalGeometry([]byte(gj.GeoJSON))
+				if err != nil {
+					return nil, err
+				}
+				return back.Geometry(), nil
+			})
+		}
+	}
+
+	// the helper types write the same document as the Geometry wrapper and read it back
+	var helperDoc []byte
+	switch w := want.(type) {
+	case orb.Point:
+		helperDoc, err = json.Marshal(geojson.Point(w))
+	case orb.MultiPoint:
+		helperDoc, err = json.Marshal(geojson.MultiPoint(w))
+	case orb.LineString:
+		helperDoc, err = json.Marshal(geojson.LineString(w))
+	case orb.MultiLineString:
+		helperDoc, err = json.Marshal(geojson.MultiLineString(w))
+	case orb.Polygon:
+		helperDoc, err = json.Marshal(geojson.Polygon(w))
+	case orb.MultiPolygon:
+		helperDoc, err = json.Marshal(geojson.MultiPolygon(w))
+	}
+	if helperDoc != nil {
+		out["helper-doc"] = string(helperDoc)
+		if err != nil {
+			out["helper-doc"] = "error: " + err.Error()
+		}
+		// (the document decoded first, then the geometry: Go evaluates a return list left to
+		// right)
+		switch want.(type) {
+		case orb.Point:
+			var p geojson.Point
+			out["helper-read"] = readGeoJSON(func() (orb.Geometry, error) {
+				if err := json.Unmarshal(data, &p); err != nil {
+					return nil, err
+				}
+				return p.Geometry(), nil
+			})
+		case orb.Polygon:
+			var p geojson.Polygon
+			out["helper-read"] = readGeoJSON(func() (orb.Geometry, error) {
+				if err := json.Unmarshal(data, &p); err != nil {
+					return nil, err
+				}
+				return p.Geometry(), nil
+			})
+		case orb.MultiLineString:
+			var p geojson.MultiLineString
+			out["helper-read"] = readGeoJSON(func() (orb.Geometry, error) {
+				if err := json.Unmarshal(data, &p); err != nil {
+					return nil, err
+				}
+				return p.Geometry(), nil
+			})
+		}
+		if _, isPoint := want.(orb.Point); !isPoint {
+			var p geojson.Point
+			out["helper-wrong"] = readGeoJSON(func() (orb.Geometry, error) {
+				if err := json.Unmarshal(data, &p); err != nil {
+					return nil, err
+				}
+				return p.Geometry(), nil
+			})
+		}
+	}
+
+	// a feature: geometry, properties, id and bbox survive
+	f := geojson.NewFeature(g)
+	f.Properties["name"] = c.name
+	f.Properties["n"] = float64(c.n)
+	if c.id != nil {
+		f.ID = c.id
+	}
+	if c.bbox {
+		f.BBox = geojson.NewBBox(g.Bound())
+	}
+	fdata, err := json.Marshal(f)
+	if err != nil {
+		out["feature"] = "error: " + err.Error()
+		return out
+	}
+	var fb *geojson.Feature
+	out["feature"] = readGeoJSON(func() (orb.Geometry, error) {
+		var err error
+		fb, err = geojson.UnmarshalFeature(fdata)
+		if err != nil {
+			return nil, err
+		}
+		return fb.Geometry, nil
+	})
+	if fb != nil {
+		out["feature-properties"] = fmt.Sprintf("name=%v n=%v", quoted(fb.Properties["name"]), fb.Properties["n"])
+		out["feature-id"] = fmt.Sprint(fb.ID)
+		switch {
+		case (f.BBox == nil) != (fb.BBox == nil):
+			out["feature-bbox"] = fmt.Sprintf("%v read back as %v", f.BBox, fb.BBox)
+		case f.BBox == nil:
+			out["feature-bbox"] = "absent"
+		case fb.BBox.Bound().Equal(f.BBox.Bound()):
+			out["feature-bbox"] = "ok"
+		default:
+			out["feature-bbox"] = fmt.Sprintf("%v read back as %v", f.BBox, fb.BBox)
+		}
+		out["feature-type"] = fb.Type
+	}
+	fc := geojson.NewFeatureCollection()
+	fc.Append(f)
+	fc.Append(geojson.NewFeature(c.g2))
+	fcdata, err := json.Marshal(fc)
+	if err != nil {
+		out["fc"] = "error: " + err.Error()
+		return out
+	}
+	out["fc"] = readGeoJSON(func() (orb.Geometry, error) {
+		fcb, err := geojson.UnmarshalFeatureCollection(fcdata)
+		if err != nil {
+			return nil, err
+		}
+		if len(fcb.Features) != 2 {
+			return nil, fmt.Errorf("%d features", len(fcb.Features))
+		}
+		return nil, nil
+	})
+	if out["fc"] == "<nil>" {
+		fcb, _ := geojson.UnmarshalFeatureCollection(fcdata)
+		out["fc"] = show(fcb.Features[0].Geometry) + " | " + show(fcb.Features[1].Geometry)
+	}
+
+	// BBox <-> Bound
+	bb := geojson.NewBBox(c.b)
+	out["bbox"] = "ok"
+	if !bb.Valid() || !bb.Bound().Equal(c.b) {
+		out["bbox"] = fmt.Sprintf("NewBBox = %v, Bound() = %v", bb, bb.Bound())
+	}
+	return out
+}
+
+// quoted prints a property value as the model does (a string quoted).
+func quoted(v any) string {
+	if s, ok := v.(string); ok {
+		return strconv.Quote(s)
+	}
+	return fmt.Sprint(v)
+}
+
+// judgeGeoJSON is the judge of the family: the shape first, then the library.
+func judgeGeoJSON(j *hzCaseJudge, c geoJSONCase) {
+	hzTally("drawn doc " + c.doc.kind)
+	judgeBy(j, c, geoJSONExpected, geoJSONActual)
+}
+
+// TestHegelGeoJSON: geojson.NewGeometry marshals to the GeoJSON document (an empty collection
+// a GeometryCollection with no geometries), which shapely reads as the same geometry and
+// which unmarshals back; a document with a position of fewer than two numbers is rejected;
+// the typed helper types agree; features and feature collections keep their geometry,
+// properties, id and bbox; BBox and Bound convert both ways. The shapes of orb/9 (an empty
+// collection, alone or held) and orb/10 (a short position, a drawn alternative of the
+// document read back) are drawn at their natural rates.
+func TestHegelGeoJSON(t *testing.T) {
+	judged(t, withoutShapes(geoJSONExpected, geoJSONCases), judgeGeoJSON)
+}
diff --git a/hegel/hegel_gen_test.go b/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..6820bb0
--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,422 @@
+package hegel
+
+// Generators of orb geometries and helpers shared by the properties.
+
+import (
+	"fmt"
+	"math"
+	"sort"
+
+	"github.com/paulmach/orb"
+	"hegel.dev/go/hegel"
+)
+
+// coord draws a coordinate with two decimals in [-20, 20] (exact in %g and in JSON).
+func coord(tc hegel.TestCase) float64 { return float64(drawInt(tc, -2000, 2000)) / 100 }
+
+func genPoint(tc hegel.TestCase) orb.Point { return orb.Point{coord(tc), coord(tc)} }
+
+// genMultiPoint draws 0..5 points (duplicates allowed).
+func genMultiPoint(tc hegel.TestCase) orb.MultiPoint {
+	n := drawInt(tc, 0, 5)
+	mp := make(orb.MultiPoint, 0, n)
+	for i := 0; i < n; i++ {
+		mp = append(mp, genPoint(tc))
+	}
+	return mp
+}
+
+// genLineString draws an empty line string or one with 2..6 points; consecutive points differ.
+func genLineString(tc hegel.TestCase) orb.LineString {
+	if chance(tc, 10) {
+		return orb.LineString{}
+	}
+	return genLongLineString(tc, 6)
+}
+
+// genLongLineString draws a line of 2..max points, consecutive points distinct (a repeat is
+// nudged by 0.01 rather than redrawn: hegel's minimal test case repeats every draw).
+func genLongLineString(tc hegel.TestCase, max int) orb.LineString {
+	n := drawInt(tc, 2, max)
+	ls := make(orb.LineString, 0, n)
+	for len(ls) < n {
+		p := genPoint(tc)
+		if len(ls) > 0 && ls[len(ls)-1] == p {
+			p[0] = round2(p[0] + 0.01)
+		}
+		ls = append(ls, p)
+	}
+	return ls
+}
+
+func genMultiLineString(tc hegel.TestCase) orb.MultiLineString {
+	n := drawInt(tc, 0, 3)
+	mls := make(orb.MultiLineString, 0, n)
+	for i := 0; i < n; i++ {
+		mls = append(mls, genLineString(tc))
+	}
+	return mls
+}
+
+// genStarRing draws a closed, simple ring around a centre: vertices at increasing angles with
+// gaps of 30..90 degrees (so 4..12 of them) and radii in [rmin, rmax], rounded to two
+// decimals; the orientation is either. With gaps of at most 90 degrees and radii of at least
+// rmin, every edge stays at least rmin*cos(45deg) from the centre: with rmin = 3 the disc of
+// radius 1.2 around the centre is inside the ring.
+func genStarRing(tc hegel.TestCase, cx, cy, rmin, rmax float64) orb.Ring {
+	start := drawInt(tc, 0, 35) * 10
+	var angles []int
+	cur := 0
+	for cur < 270 {
+		g := drawInt(tc, 3, 9) * 10
+		if cur+g > 330 {
+			g = 330 - cur
+		}
+		angles = append(angles, (start+cur)%360)
+		cur += g
+	}
+	angles = append(angles, (start+cur)%360)
+	sort.Ints(angles)
+	n := len(angles)
+	r := make(orb.Ring, 0, n+1)
+	for _, a := range angles {
+		rad := rmin + float64(drawInt(tc, 0, 100))/100*(rmax-rmin)
+		th := float64(a) * math.Pi / 180
+		r = append(r, orb.Point{round2(cx + rad*math.Cos(th)), round2(cy + rad*math.Sin(th))})
+	}
+	r = append(r, r[0])
+	if chance(tc, 50) {
+		r.Reverse()
+	}
+	return r
+}
+
+func round2(f float64) float64 { return math.Round(f*100) / 100 }
+
+// genRing draws a star ring around a random centre (or, rarely, an empty ring).
+func genRing(tc hegel.TestCase) orb.Ring {
+	if chance(tc, 5) {
+		return orb.Ring{}
+	}
+	return genStarRing(tc, float64(drawInt(tc, -15, 15)), float64(drawInt(tc, -15, 15)), 3, 5)
+}
+
+// holeSquares are hole rings that fit inside the disc of radius 1.2 around the centre and
+// are disjoint from each other.
+var holeSquares = [][4]float64{{0.1, 0.1, 0.7, 0.7}, {-0.7, -0.7, -0.1, -0.1}, {0.1, -0.7, 0.7, -0.1}, {-0.7, 0.1, -0.1, 0.7}}
+
+func squareRing(cx, cy float64, sq [4]float64, cw bool) orb.Ring {
+	x0, y0, x1, y1 := round2(cx+sq[0]), round2(cy+sq[1]), round2(cx+sq[2]), round2(cy+sq[3])
+	r := orb.Ring{{x0, y0}, {x1, y0}, {x1, y1}, {x0, y1}, {x0, y0}}
+	if cw {
+		r.Reverse()
+	}
+	return r
+}
+
+// genPolygonAt draws a valid polygon around (cx, cy): a star outer ring and 0..2 square holes.
+func genPolygonAt(tc hegel.TestCase, cx, cy float64) orb.Polygon {
+	p := orb.Polygon{genStarRing(tc, cx, cy, 3, 5)}
+	nh := drawInt(tc, 0, 2)
+	for i := 0; i < nh; i++ {
+		p = append(p, squareRing(cx, cy, holeSquares[i], chance(tc, 50)))
+	}
+	return p
+}
+
+// genPolygon draws an empty polygon (rarely) or a valid one around a random centre.
+func genPolygon(tc hegel.TestCase) orb.Polygon {
+	if chance(tc, 5) {
+		return orb.Polygon{}
+	}
+	return genPolygonAt(tc, float64(drawInt(tc, -15, 15)), float64(drawInt(tc, -15, 15)))
+}
+
+// genMultiPolygon draws 0..3 disjoint polygons (centres 12 apart, radii at most 5).
+func genMultiPolygon(tc hegel.TestCase) orb.MultiPolygon {
+	n := drawInt(tc, 0, 3)
+	mp := make(orb.MultiPolygon, 0, n)
+	for i := 0; i < n; i++ {
+		mp = append(mp, genPolygonAt(tc, float64(-12+12*i), float64(drawInt(tc, -1, 1)*12)))
+	}
+	return mp
+}
+
+// genCollection draws 0..4 members; nested collections down to depth 2.
+func genCollection(tc hegel.TestCase, depth int) orb.Collection {
+	n := drawInt(tc, 0, 4)
+	c := make(orb.Collection, 0, n)
+	for i := 0; i < n; i++ {
+		c = append(c, genGeometry(tc, depth))
+	}
+	return c
+}
+
+// geoKinds are the GeoJSON geometry types (what the codecs round-trip as themselves).
+var geoKinds = []string{"Point", "MultiPoint", "LineString", "MultiLineString", "Polygon", "MultiPolygon", "GeometryCollection"}
+
+// genGeometry draws one of the seven GeoJSON geometry types (collections only while depth > 0).
+func genGeometry(tc hegel.TestCase, depth int) orb.Geometry {
+	kinds := geoKinds
+	if depth <= 0 {
+		kinds = geoKinds[:6]
+	}
+	switch pick(tc, kinds) {
+	case "Point":
+		return genPoint(tc)
+	case "MultiPoint":
+		return genMultiPoint(tc)
+	case "LineString":
+		return genLineString(tc)
+	case "MultiLineString":
+		return genMultiLineString(tc)
+	case "Polygon":
+		return genPolygon(tc)
+	case "MultiPolygon":
+		return genMultiPolygon(tc)
+	default:
+		return genCollection(tc, depth-1)
+	}
+}
+
+// genAnyGeometry adds Ring and Bound, the two orb types without a GeoJSON type of their own.
+func genAnyGeometry(tc hegel.TestCase) orb.Geometry {
+	switch drawInt(tc, 0, 9) {
+	case 0:
+		return genRing(tc)
+	case 1:
+		return genBound(tc)
+	default:
+		return genGeometry(tc, 2)
+	}
+}
+
+// genBound draws a non-empty bound (Min <= Max), sometimes degenerate.
+func genBound(tc hegel.TestCase) orb.Bound {
+	a, b := genPoint(tc), genPoint(tc)
+	if chance(tc, 10) {
+		b[0] = a[0]
+	}
+	if chance(tc, 10) {
+		b[1] = a[1]
+	}
+	return orb.Bound{Min: orb.Point{math.Min(a[0], b[0]), math.Min(a[1], b[1])}, Max: orb.Point{math.Max(a[0], b[0]), math.Max(a[1], b[1])}}
+}
+
+// --------------------------------------------------------------------------- helpers
+
+// coords lists every coordinate of a geometry, in order.
+func coords(g orb.Geometry) []orb.Point {
+	switch g := g.(type) {
+	case nil:
+		return nil
+	case orb.Point:
+		return []orb.Point{g}
+	case orb.MultiPoint:
+		return []orb.Point(g)
+	case orb.LineString:
+		return []orb.Point(g)
+	case orb.Ring:
+		return []orb.Point(g)
+	case orb.MultiLineString:
+		var out []orb.Point
+		for _, ls := range g {
+			out = append(out, ls...)
+		}
+		return out
+	case orb.Polygon:
+		var out []orb.Point
+		for _, r := range g {
+			out = append(out, r...)
+		}
+		return out
+	case orb.MultiPolygon:
+		var out []orb.Point
+		for _, p := range g {
+			out = append(out, coords(p)...)
+		}
+		return out
+	case orb.Collection:
+		var out []orb.Point
+		for _, m := range g {
+			out = append(out, coords(m)...)
+		}
+		return out
+	case orb.Bound:
+		return []orb.Point{g.Min, g.Max}
+	}
+	panic(fmt.Sprintf("coords: %T", g))
+}
+
+// modelBound is the bounding box of the coordinates, or the empty bound (Min > Max) when there
+// are none; a Bound's own bound is itself.
+func modelBound(g orb.Point) orb.Bound { return orb.Bound{Min: g, Max: g} }
+
+func boundOf(ps []orb.Point) (orb.Bound, bool) {
+	if len(ps) == 0 {
+		return orb.Bound{}, false
+	}
+	b := orb.Bound{Min: ps[0], Max: ps[0]}
+	for _, p := range ps[1:] {
+		b.Min[0] = math.Min(b.Min[0], p[0])
+		b.Min[1] = math.Min(b.Min[1], p[1])
+		b.Max[0] = math.Max(b.Max[0], p[0])
+		b.Max[1] = math.Max(b.Max[1], p[1])
+	}
+	return b, true
+}
+
+// hasEmptyPart reports whether the geometry or a part of it has no coordinates (empty
+// multi-geometries, collections, line strings, polygons).
+func hasEmptyPart(g orb.Geometry) bool {
+	switch g := g.(type) {
+	case orb.Point:
+		return false
+	case orb.MultiPoint:
+		return len(g) == 0
+	case orb.LineString:
+		return len(g) == 0
+	case orb.Ring:
+		return len(g) == 0
+	case orb.MultiLineString:
+		if len(g) == 0 {
+			return true
+		}
+		for _, ls := range g {
+			if len(ls) == 0 {
+				return true
+			}
+		}
+	case orb.Polygon:
+		if len(g) == 0 {
+			return true
+		}
+		for _, r := range g {
+			if len(r) == 0 {
+				return true
+			}
+		}
+	case orb.MultiPolygon:
+		if len(g) == 0 {
+			return true
+		}
+		for _, p := range g {
+			if hasEmptyPart(p) {
+				return true
+			}
+		}
+	case orb.Collection:
+		if len(g) == 0 {
+			return true
+		}
+		for _, m := range g {
+			if hasEmptyPart(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// closePoints compares two points within tol.
+func closePoints(a, b orb.Point, tol float64) bool {
+	return math.Abs(a[0]-b[0]) <= tol && math.Abs(a[1]-b[1]) <= tol
+}
+
+// closeNum compares two numbers within an absolute and a relative tolerance.
+func closeNum(a, b, abs, rel float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	d := math.Abs(a - b)
+	return d <= abs || d <= rel*math.Max(math.Abs(a), math.Abs(b))
+}
+
+// closeGeom compares two geometries structurally (same type, same shape, coordinates within
+// tol).
+func closeGeom(a, b orb.Geometry, tol float64) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	switch a := a.(type) {
+	case orb.Point:
+		b, ok := b.(orb.Point)
+		return ok && closePoints(a, b, tol)
+	case orb.MultiPoint:
+		b, ok := b.(orb.MultiPoint)
+		return ok && closeLine(orb.LineString(a), orb.LineString(b), tol)
+	case orb.LineString:
+		b, ok := b.(orb.LineString)
+		return ok && closeLine(a, b, tol)
+	case orb.Ring:
+		b, ok := b.(orb.Ring)
+		return ok && closeLine(orb.LineString(a), orb.LineString(b), tol)
+	case orb.MultiLineString:
+		b, ok := b.(orb.MultiLineString)
+		if !ok || len(a) != len(b) {
+			return false
+		}
+		for i := range a {
+			if !closeLine(a[i], b[i], tol) {
+				return false
+			}
+		}
+		return true
+	case orb.Polygon:
+		b, ok := b.(orb.Polygon)
+		if !ok || len(a) != len(b) {
+			return false
+		}
+		for i := range a {
+			if !closeLine(orb.LineString(a[i]), orb.LineString(b[i]), tol) {
+				return false
+			}
+		}
+		return true
+	case orb.MultiPolygon:
+		b, ok := b.(orb.MultiPolygon)
+		if !ok || len(a) != len(b) {
+			return false
+		}
+		for i := range a {
+			if !closeGeom(a[i], b[i], tol) {
+				return false
+			}
+		}
+		return true
+	case orb.Collection:
+		b, ok := b.(orb.Collection)
+		if !ok || len(a) != len(b) {
+			return false
+		}
+		for i := range a {
+			if !closeGeom(a[i], b[i], tol) {
+				return false
+			}
+		}
+		return true
+	case orb.Bound:
+		b, ok := b.(orb.Bound)
+		return ok && closePoints(a.Min, b.Min, tol) && closePoints(a.Max, b.Max, tol)
+	}
+	panic(fmt.Sprintf("closeGeom: %T", a))
+}
+
+func closeLine(a, b orb.LineString, tol float64) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !closePoints(a[i], b[i], tol) {
+			return false
+		}
+	}
+	return true
+}
+
+// same is structural equality with empty and nil slices alike (orb.Equal distinguishes a nil
+// Collection member from an empty one only through its slices' lengths, so it serves).
+func same(a, b orb.Geometry) bool { return closeGeom(a, b, 0) }
+
+// pointDistance is the planar distance.
+func pointDistance(a, b orb.Point) float64 { return math.Hypot(a[0]-b[0], a[1]-b[1]) }
diff --git a/hegel/hegel_geo_test.go b/hegel/hegel_geo_test.go
new file mode 100644
index 0000000..aaf3e16
--- /dev/null
+++ b/hegel/hegel_geo_test.go
@@ -0,0 +1,724 @@
+package hegel
+
+// Map tiles, the quadtree, the geo formulas and the projections, against models written from
+// the doc comments.
+
+import (
+	"math"
+	"sort"
+	"testing"
+
+	"github.com/paulmach/orb"
+	"github.com/paulmach/orb/geo"
+	"github.com/paulmach/orb/maptile"
+	"github.com/paulmach/orb/maptile/tilecover"
+	"github.com/paulmach/orb/planar"
+	"github.com/paulmach/orb/project"
+	"github.com/paulmach/orb/quadtree"
+	"hegel.dev/go/hegel"
+)
+
+// genLonLat draws a longitude/latitude with four decimals; sometimes an edge value.
+func genLonLat(tc hegel.TestCase) orb.Point {
+	if chance(tc, 10) {
+		return orb.Point{pick(tc, []float64{-180, 180, 0, 179.9999, -179.9999}), pick(tc, []float64{-90, 90, -85.0511, 85.0511, 0, -85.05, 85.06})}
+	}
+	return orb.Point{float64(drawInt(tc, -1800000, 1800000)) / 10000, float64(drawInt(tc, -850000, 850000)) / 10000}
+}
+
+// modelFraction is the web-mercator tile fraction of the doc comment: x from the longitude,
+// y from the Mercator latitude, clamped at the 85.0511 degree limits.
+func modelFraction(ll orb.Point, z maptile.Zoom) orb.Point {
+	n := math.Exp2(float64(z))
+	x := (ll[0]/360 + 0.5) * n
+	var y float64
+	switch {
+	case ll[1] < -85.0511:
+		y = n - 1
+	case ll[1] > 85.0511:
+		y = 0
+	default:
+		lat := ll[1] * math.Pi / 180
+		y = (0.5 - math.Log(math.Tan(math.Pi/4+lat/2))/(2*math.Pi)) * n
+	}
+	return orb.Point{x, y}
+}
+
+// modelQuadkey interleaves the x and y bits.
+func modelQuadkey(t maptile.Tile) uint64 {
+	var k uint64
+	for i := uint(0); i < uint(t.Z); i++ {
+		k |= uint64((t.X>>i)&1) << (2 * i)
+		k |= uint64((t.Y>>i)&1) << (2*i + 1)
+	}
+	return k
+}
+
+func toZoom(t maptile.Tile, z maptile.Zoom) maptile.Tile {
+	if z > t.Z {
+		return maptile.Tile{X: t.X << (z - t.Z), Y: t.Y << (z - t.Z), Z: z}
+	}
+	return maptile.Tile{X: t.X >> (t.Z - z), Y: t.Y >> (t.Z - z), Z: z}
+}
+
+// TestHegelMaptile: Fraction and At against the Mercator model, the tile's Bound and Center,
+// quadkeys, parents, children, siblings, containment, shared parents, ranges, and tilecover of
+// points and bounds.
+func TestHegelMaptile(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		z := maptile.Zoom(drawInt(ht, 0, 20))
+		ll := genLonLat(ht)
+		n := math.Exp2(float64(z))
+
+		f := maptile.Fraction(ll, z)
+		want := modelFraction(ll, z)
+		if !closeNum(f[0], want[0], 1e-9*n, 1e-12) || !closeNum(f[1], want[1], 1e-9*n, 1e-12) {
+			col.failClass(ht, "fraction", "Fraction(%v, %d) = %v, model %v", ll, z, f, want)
+		}
+		tile := maptile.At(ll, z)
+		if tile.Z != z || tile.X != uint32(f[0]) || tile.Y != uint32(f[1]) {
+			col.failClass(ht, "at", "At(%v, %d) = %v, fraction %v", ll, z, tile, f)
+		}
+		wantValid := true
+		if Known.tileAtLongitude180 && ll[0] >= 180 {
+			wantValid = false
+		}
+		if tile.Valid() != wantValid {
+			col.failClass(ht, "at-valid", "At(%v, %d) = %v, Valid() = %v", ll, z, tile, tile.Valid())
+		}
+		if !tile.Valid() {
+			col.count("invalid-tile")
+			return
+		}
+
+		// bound and center
+		b := tile.Bound()
+		c := tile.Center()
+		if !closePoints(c, b.Center(), 0) {
+			col.failClass(ht, "center", "%v.Center() = %v, Bound().Center() = %v", tile, c, b.Center())
+		}
+		if maptile.At(c, z) != tile {
+			col.failClass(ht, "center-tile", "At(%v.Center() = %v) = %v", tile, c, maptile.At(c, z))
+		}
+		wantMinLon := float64(tile.X)/n*360 - 180
+		wantMaxLon := float64(tile.X+1)/n*360 - 180
+		if !closeNum(b.Min[0], wantMinLon, 1e-9, 0) || !closeNum(b.Max[0], wantMaxLon, 1e-9, 0) {
+			col.failClass(ht, "bound-lon", "%v.Bound() = %v, longitudes %v..%v", tile, b, wantMinLon, wantMaxLon)
+		}
+		// the latitudes: the fraction of the bound's corners is the tile's edges
+		if fy := maptile.Fraction(orb.Point{c[0], b.Max[1]}, z); !closeNum(fy[1], float64(tile.Y), 1e-6, 0) {
+			col.failClass(ht, "bound-lat", "%v.Bound() top latitude %v has fraction %v", tile, b.Max[1], fy[1])
+		}
+		if fy := maptile.Fraction(orb.Point{c[0], b.Min[1]}, z); b.Min[1] >= -85.0511 && !closeNum(fy[1], float64(tile.Y+1), 1e-6, 0) {
+			col.failClass(ht, "bound-lat", "%v.Bound() bottom latitude %v has fraction %v", tile, b.Min[1], fy[1])
+		}
+		if !b.Contains(ll) && ll[1] >= -85.0511 && ll[1] <= 85.0511 {
+			// a point maps to a tile whose bound holds it (up to the float error at the edge)
+			if !b.Pad(1e-9).Contains(ll) {
+				col.failClass(ht, "bound-contains", "At(%v) = %v whose Bound %v does not contain the point", ll, tile, b)
+			}
+		}
+		bb := tile.Bound(1)
+		if !closeNum(bb.Max[0]-bb.Min[0], 3*(b.Max[0]-b.Min[0]), 1e-9, 1e-9) || !(bb.Min[1] <= b.Min[1] && bb.Max[1] >= b.Max[1]) {
+			col.failClass(ht, "bound-buffer", "%v.Bound(1) = %v, Bound() = %v", tile, bb, b)
+		}
+
+		// quadkey
+		k := tile.Quadkey()
+		if k != modelQuadkey(tile) {
+			col.failClass(ht, "quadkey", "%v.Quadkey() = %d, model %d", tile, k, modelQuadkey(tile))
+		}
+		if back := maptile.FromQuadkey(k, z); back != tile {
+			col.failClass(ht, "fromquadkey", "FromQuadkey(%d, %d) = %v, want %v", k, z, back, tile)
+		}
+
+		// family
+		parent := tile.Parent()
+		if z == 0 {
+			if parent != tile {
+				col.failClass(ht, "parent-root", "%v.Parent() = %v", tile, parent)
+			}
+		} else if parent != (maptile.Tile{X: tile.X >> 1, Y: tile.Y >> 1, Z: z - 1}) || !parent.Contains(tile) {
+			col.failClass(ht, "parent", "%v.Parent() = %v", tile, parent)
+		}
+		children := tile.Children()
+		if len(children) != 4 {
+			col.failClass(ht, "children", "%v.Children() = %v", tile, children)
+		}
+		seen := map[maptile.Tile]bool{}
+		for _, ch := range children {
+			seen[ch] = true
+			if ch.Parent() != tile || !tile.Contains(ch) || ch.Z != z+1 || ch.Contains(tile) {
+				col.failClass(ht, "child", "%v.Children() has %v (parent %v)", tile, ch, ch.Parent())
+			}
+		}
+		if len(seen) != 4 {
+			col.failClass(ht, "children-distinct", "%v.Children() = %v", tile, children)
+		}
+		sib := tile.Siblings()
+		found := false
+		for _, s := range sib {
+			if s == tile {
+				found = true
+			}
+			if s.Parent() != parent {
+				col.failClass(ht, "siblings", "%v.Siblings() = %v", tile, sib)
+			}
+		}
+		if !found && z > 0 {
+			col.failClass(ht, "siblings-self", "%v.Siblings() = %v does not include the tile", tile, sib)
+		}
+		if !tile.Contains(tile) {
+			col.failClass(ht, "contains-self", "%v.Contains(itself) = false", tile)
+		}
+		if z > 0 && tile.Contains(parent) {
+			col.failClass(ht, "contains-parent", "%v.Contains(parent %v) = true", tile, parent)
+		}
+		// a descendant a few levels down
+		dz := maptile.Zoom(drawInt(ht, 0, 5))
+		if z+dz <= 30 {
+			desc := maptile.Tile{X: tile.X<<dz + uint32(drawInt(ht, 0, int(math.Exp2(float64(dz)))-1)), Y: tile.Y<<dz + uint32(drawInt(ht, 0, int(math.Exp2(float64(dz)))-1)), Z: z + dz}
+			if !tile.Contains(desc) {
+				col.failClass(ht, "contains-desc", "%v.Contains(%v) = false", tile, desc)
+			}
+			if sp := tile.SharedParent(desc); sp != tile {
+				col.failClass(ht, "shared-parent-desc", "%v.SharedParent(%v) = %v", tile, desc, sp)
+			}
+			minT, maxT := tile.Range(z + dz)
+			if minT != (maptile.Tile{X: tile.X << dz, Y: tile.Y << dz, Z: z + dz}) || maxT != (maptile.Tile{X: ((tile.X + 1) << dz) - 1, Y: ((tile.Y + 1) << dz) - 1, Z: z + dz}) {
+				col.failClass(ht, "range", "%v.Range(%d) = %v, %v", tile, z+dz, minT, maxT)
+			}
+			if dz <= 3 {
+				all := maptile.ChildrenInZoomRange(tile, z, z+dz)
+				wantN := 0
+				for d := 0; d <= int(dz); d++ {
+					wantN += 1 << (2 * d)
+				}
+				if len(all) != wantN {
+					col.failClass(ht, "children-range", "ChildrenInZoomRange(%v, %d, %d) has %d tiles, want %d", tile, z, z+dz, len(all), wantN)
+				}
+				for _, ch := range all {
+					if !tile.Contains(ch) {
+						col.failClass(ht, "children-range-contains", "ChildrenInZoomRange(%v, %d, %d) has %v", tile, z, z+dz, ch)
+						break
+					}
+				}
+			}
+		}
+		// shared parent with another tile at the same zoom: the deepest common ancestor
+		other := maptile.At(genLonLat(ht), z)
+		if other.Valid() {
+			sp := tile.SharedParent(other)
+			a, b2 := tile, other
+			for a != b2 {
+				a, b2 = a.Parent(), b2.Parent()
+			}
+			if sp != a {
+				col.failClass(ht, "shared-parent", "%v.SharedParent(%v) = %v, want %v", tile, other, sp, a)
+			}
+			lower := maptile.Zoom(drawInt(ht, 0, int(z)))
+			if minT, maxT := tile.Range(lower); minT != toZoom(tile, lower) || maxT != minT {
+				col.failClass(ht, "range-lower", "%v.Range(%d) = %v, %v", tile, lower, minT, maxT)
+			}
+		}
+
+		// tilecover
+		if s := tilecover.Point(ll, z); len(s) != 1 || !s[tile] {
+			col.failClass(ht, "cover-point", "tilecover.Point(%v, %d) = %v", ll, z, s)
+		}
+		mp := orb.MultiPoint{ll, genLonLat(ht), genLonLat(ht)}
+		wantSet := maptile.Set{}
+		for _, p := range mp {
+			wantSet[maptile.At(p, z)] = true
+		}
+		got := tilecover.MultiPoint(mp, z)
+		if len(got) != len(wantSet) {
+			col.failClass(ht, "cover-multipoint", "tilecover.MultiPoint(%v, %d) = %v, want %v", mp, z, got, wantSet)
+		} else {
+			for k := range wantSet {
+				if !got[k] {
+					col.failClass(ht, "cover-multipoint", "tilecover.MultiPoint(%v, %d) = %v, want %v", mp, z, got, wantSet)
+					break
+				}
+			}
+		}
+		// a bound within one tile covers that tile alone; a bound is covered by the tiles
+		// between its corners' tiles
+		inner := orb.Bound{Min: orb.Point{b.Min[0] + (b.Max[0]-b.Min[0])/4, b.Min[1] + (b.Max[1]-b.Min[1])/4}, Max: orb.Point{b.Max[0] - (b.Max[0]-b.Min[0])/4, b.Max[1] - (b.Max[1]-b.Min[1])/4}}
+		if s := tilecover.Bound(inner, z); len(s) != 1 || !s[tile] {
+			col.failClass(ht, "cover-inner", "tilecover.Bound(%v within %v, %d) = %v", inner, tile, z, s)
+		}
+		if z <= 12 {
+			p2 := genLonLat(ht)
+			bnd := orb.MultiPoint{ll, p2}.Bound()
+			lo, hi := maptile.At(bnd.Min, z), maptile.At(bnd.Max, z)
+			wantCount := (int(hi.X) - int(lo.X) + 1) * (int(lo.Y) - int(hi.Y) + 1)
+			if wantCount > 0 && wantCount <= 4096 {
+				s := tilecover.Bound(bnd, z)
+				if len(s) != wantCount {
+					col.failClass(ht, "cover-bound", "tilecover.Bound(%v, %d) has %d tiles, want %d", bnd, z, len(s), wantCount)
+				}
+				for tt := range s {
+					if !tt.Valid() {
+						if !(Known.tileAtLongitude180 && bnd.Max[0] >= 180) {
+							col.failClass(ht, "cover-invalid", "tilecover.Bound(%v, %d) has the invalid tile %v", bnd, z, tt)
+						}
+						break
+					}
+					if !tt.Bound().Pad(1e-9).Intersects(bnd) && bnd.Min[1] >= -85.0511 && bnd.Max[1] <= 85.0511 {
+						col.failClass(ht, "cover-disjoint", "tilecover.Bound(%v, %d) has %v, whose bound %v is disjoint", bnd, z, tt, tt.Bound())
+						break
+					}
+				}
+				tiles := maptile.Tiles{tile, other}
+				if fc := tiles.ToFeatureCollection(); len(fc.Features) != 2 || !same(fc.Features[0].Geometry, tile.Bound().ToPolygon()) {
+					col.failClass(ht, "feature-collection", "Tiles.ToFeatureCollection: %v", fc.Features)
+				}
+			}
+		}
+		col.count("ok")
+	})
+}
+
+// ptr wraps a point with an id so duplicates at one point stay distinct.
+type ptr struct {
+	p  orb.Point
+	id int
+}
+
+func (p *ptr) Point() orb.Point { return p.p }
+
+// TestHegelQuadtree: Find, KNearest (with a filter and a maximum distance), InBound and Remove
+// against brute force over the same points.
+func TestHegelQuadtree(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		size := float64(pick(ht, []int{10, 100}))
+		bound := orb.Bound{Min: orb.Point{0, 0}, Max: orb.Point{size, size}}
+		qt := quadtree.New(bound)
+		if !qt.Bound().Equal(bound) {
+			col.fail(ht, "Bound() = %v", qt.Bound())
+		}
+		n := drawInt(ht, 0, 30)
+		var pts []*ptr
+		for i := 0; i < n; i++ {
+			p := &ptr{p: orb.Point{float64(drawInt(ht, 0, int(size))), float64(drawInt(ht, 0, int(size)))}, id: i}
+			if chance(ht, 30) { // fractional
+				p.p[0] += float64(drawInt(ht, 0, 99)) / 100
+				p.p[1] += float64(drawInt(ht, 0, 99)) / 100
+				if p.p[0] > size {
+					p.p[0] = size
+				}
+				if p.p[1] > size {
+					p.p[1] = size
+				}
+			}
+			if err := qt.Add(p); err != nil {
+				col.fail(ht, "Add(%v) = %v", p.p, err)
+				return
+			}
+			pts = append(pts, p)
+		}
+		outside := &ptr{p: orb.Point{size + 1, size / 2}, id: -1}
+		if err := qt.Add(outside); err != quadtree.ErrPointOutsideOfBounds {
+			col.failClass(ht, "outside", "Add of %v outside %v = %v", outside.p, bound, err)
+		}
+		if err := qt.Add(nil); err != nil {
+			col.failClass(ht, "nil", "Add(nil) = %v", err)
+		}
+
+		q := orb.Point{float64(drawInt(ht, -5, int(size)+5)), float64(drawInt(ht, -5, int(size)+5))}
+		if chance(ht, 30) && n > 0 {
+			q = pts[drawInt(ht, 0, n-1)].p
+		}
+		dists := make([]float64, len(pts))
+		for i, p := range pts {
+			dists[i] = pointDistance(p.p, q)
+		}
+		sorted := append([]float64(nil), dists...)
+		sort.Float64s(sorted)
+
+		// Find
+		f := qt.Find(q)
+		if n == 0 {
+			if f != nil {
+				col.failClass(ht, "find-empty", "Find on an empty tree = %v", f)
+			}
+		} else if f == nil {
+			col.failClass(ht, "find-nil", "Find(%v) = nil with %d points", q, n)
+		} else if d := pointDistance(f.Point(), q); !closeNum(d, sorted[0], 0, 1e-12) {
+			col.failClass(ht, "find", "Find(%v) = %v at %v, nearest is at %v", q, f.Point(), d, sorted[0])
+		}
+
+		// KNearest
+		k := drawInt(ht, 0, 8)
+		if Known.kNearestZeroPanics && k == 0 && n > 0 {
+			k = 1
+		}
+		var res []orb.Pointer
+		if chance(ht, 50) {
+			res = qt.KNearest(nil, q, k)
+		} else {
+			res = qt.KNearest(make([]orb.Pointer, 0, 2), q, k)
+		}
+		wantK := k
+		if wantK > n {
+			wantK = n
+		}
+		if len(res) != wantK {
+			col.failClass(ht, "knearest-count", "KNearest(%v, %d) has %d results of %d points", q, k, len(res), n)
+		} else {
+			for i, r := range res {
+				d := pointDistance(r.Point(), q)
+				if !closeNum(d, sorted[i], 0, 1e-12) {
+					col.failClass(ht, "knearest-order", "KNearest(%v, %d) result %d at %v, want %v (all %v)", q, k, i, d, sorted[i], sorted[:wantK])
+					break
+				}
+			}
+		}
+		// with a maximum distance
+		maxD := float64(drawInt(ht, 0, int(size)))
+		resM := qt.KNearest(nil, q, k, maxD)
+		within := 0
+		for _, d := range sorted {
+			if d <= maxD {
+				within++
+			}
+		}
+		strictly := 0
+		for _, d := range sorted {
+			if d < maxD {
+				strictly++
+			}
+		}
+		wantM := within
+		if wantM > k {
+			wantM = k
+		}
+		wantMs := strictly
+		if wantMs > k {
+			wantMs = k
+		}
+		if len(resM) != wantM && len(resM) != wantMs {
+			col.failClass(ht, "knearest-max", "KNearest(%v, %d, max %v) has %d results, want %d (or %d strictly)", q, k, maxD, len(resM), wantM, wantMs)
+		}
+		for _, r := range resM {
+			if pointDistance(r.Point(), q) > maxD+1e-12 {
+				col.failClass(ht, "knearest-max-far", "KNearest(%v, %d, max %v) has %v at %v", q, k, maxD, r.Point(), pointDistance(r.Point(), q))
+				break
+			}
+		}
+		// with a filter: even ids only
+		even := func(p orb.Pointer) bool { return p.(*ptr).id%2 == 0 }
+		var evenD []float64
+		for _, p := range pts {
+			if even(p) {
+				evenD = append(evenD, pointDistance(p.p, q))
+			}
+		}
+		sort.Float64s(evenD)
+		resF := qt.KNearestMatching(nil, q, k, even)
+		wantF := k
+		if wantF > len(evenD) {
+			wantF = len(evenD)
+		}
+		if len(resF) != wantF {
+			col.failClass(ht, "knearest-filter-count", "KNearestMatching(%v, %d, even) has %d results, want %d", q, k, len(resF), wantF)
+		} else {
+			for i, r := range resF {
+				if !even(r) || !closeNum(pointDistance(r.Point(), q), evenD[i], 0, 1e-12) {
+					col.failClass(ht, "knearest-filter", "KNearestMatching(%v, %d, even) result %d is %v (id %d)", q, k, i, r.Point(), r.(*ptr).id)
+					break
+				}
+			}
+		}
+		if m := qt.Matching(q, even); (m == nil) != (len(evenD) == 0) || (m != nil && !closeNum(pointDistance(m.Point(), q), evenD[0], 0, 1e-12)) {
+			col.failClass(ht, "matching", "Matching(%v, even) = %v", q, m)
+		}
+
+		// InBound
+		qb := orb.MultiPoint{{float64(drawInt(ht, 0, int(size))), float64(drawInt(ht, 0, int(size)))}, {float64(drawInt(ht, 0, int(size))), float64(drawInt(ht, 0, int(size)))}}.Bound()
+		inb := qt.InBound(nil, qb)
+		wantIn := 0
+		for _, p := range pts {
+			if qb.Contains(p.p) {
+				wantIn++
+			}
+		}
+		if len(inb) != wantIn {
+			col.failClass(ht, "inbound-count", "InBound(%v) has %d results, want %d", qb, len(inb), wantIn)
+		}
+		for _, r := range inb {
+			if !qb.Contains(r.Point()) {
+				col.failClass(ht, "inbound-outside", "InBound(%v) has %v", qb, r.Point())
+				break
+			}
+		}
+		inbF := qt.InBoundMatching(nil, qb, even)
+		wantInF := 0
+		for _, p := range pts {
+			if qb.Contains(p.p) && even(p) {
+				wantInF++
+			}
+		}
+		if len(inbF) != wantInF {
+			col.failClass(ht, "inbound-filter", "InBoundMatching(%v, even) has %d results, want %d", qb, len(inbF), wantInF)
+		}
+
+		// Remove: one element at the point (by id through the filter, or the first by point)
+		if n > 0 {
+			victim := pts[drawInt(ht, 0, n-1)]
+			byID := func(p orb.Pointer) bool { return p.(*ptr).id == victim.id }
+			if !qt.Remove(victim, byID) {
+				col.failClass(ht, "remove", "Remove(%v id %d) = false", victim.p, victim.id)
+			}
+			if qt.Remove(victim, byID) {
+				col.failClass(ht, "remove-twice", "Remove(%v id %d) succeeded twice", victim.p, victim.id)
+			}
+			all := qt.InBound(nil, bound)
+			if len(all) != n-1 {
+				col.failClass(ht, "remove-count", "after Remove, InBound(all) has %d, want %d", len(all), n-1)
+			}
+			for _, r := range all {
+				if r.(*ptr).id == victim.id {
+					col.failClass(ht, "remove-still", "after Remove, %v id %d is still in the tree", victim.p, victim.id)
+				}
+			}
+			// the nearest to the victim's point among the rest
+			rest := make([]float64, 0, n-1)
+			for _, p := range pts {
+				if p.id != victim.id {
+					rest = append(rest, pointDistance(p.p, victim.p))
+				}
+			}
+			sort.Float64s(rest)
+			f := qt.Find(victim.p)
+			if len(rest) == 0 {
+				if f != nil {
+					col.failClass(ht, "find-after-remove", "Find after removing the only point = %v", f)
+				}
+			} else if f == nil || !closeNum(pointDistance(f.Point(), victim.p), rest[0], 0, 1e-12) {
+				col.failClass(ht, "find-after-remove", "Find(%v) after Remove = %v, nearest at %v", victim.p, f, rest[0])
+			}
+			// remove by point (nil filter) an absent point
+			absent := &ptr{p: orb.Point{size / 3, size / 7}, id: -2}
+			present := false
+			for _, p := range pts {
+				if p.id != victim.id && p.p == absent.p {
+					present = true
+				}
+			}
+			if qt.Remove(absent, nil) != present {
+				col.failClass(ht, "remove-absent", "Remove(%v, nil) = %v, present %v", absent.p, !present, present)
+			}
+		}
+		col.count("ok")
+	})
+}
+
+const earthR = 6378137.0
+
+func haversine(a, b orb.Point) float64 {
+	la1, la2 := a[1]*math.Pi/180, b[1]*math.Pi/180
+	dlat := la2 - la1
+	dlon := (b[0] - a[0]) * math.Pi / 180
+	h := math.Sin(dlat/2)*math.Sin(dlat/2) + math.Cos(la1)*math.Cos(la2)*math.Sin(dlon/2)*math.Sin(dlon/2)
+	return 2 * earthR * math.Atan2(math.Sqrt(h), math.Sqrt(1-h))
+}
+
+// genNearby draws a point within about 0.5 degrees of p.
+func genNearby(tc hegel.TestCase, p orb.Point) orb.Point {
+	return orb.Point{p[0] + float64(drawInt(tc, -5000, 5000))/10000, p[1] + float64(drawInt(tc, -5000, 5000))/10000}
+}
+
+// TestHegelGeo: the geo package against the haversine model and geometric contracts (bearing
+// and distance round trip, midpoints, bounds around points, padding, heights and widths, the
+// area of small polygons, points along lines).
+func TestHegelGeo(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := orb.Point{float64(drawInt(ht, -1600000, 1600000)) / 10000, float64(drawInt(ht, -700000, 700000)) / 10000}
+		q := genNearby(ht, p)
+		hd := geo.DistanceHaversine(p, q)
+		if !closeNum(hd, haversine(p, q), 1e-6, 1e-9) {
+			col.failClass(ht, "haversine", "DistanceHaversine(%v, %v) = %v, model %v", p, q, hd, haversine(p, q))
+		}
+		d := geo.Distance(p, q)
+		if !closeNum(d, hd, 0.5, 1e-4) { // the equirectangular approximation, nearby points
+			col.failClass(ht, "distance", "Distance(%v, %v) = %v, haversine %v", p, q, d, hd)
+		}
+		if geo.Distance(p, p) != 0 || geo.DistanceHaversine(p, p) != 0 {
+			col.failClass(ht, "distance-self", "Distance(%v, itself) = %v / %v", p, geo.Distance(p, p), geo.DistanceHaversine(p, p))
+		}
+		// bearing and distance round trip
+		br := geo.Bearing(p, q)
+		if br < -180 || br > 180 {
+			col.failClass(ht, "bearing-range", "Bearing(%v, %v) = %v", p, q, br)
+		}
+		if p != q {
+			r := geo.PointAtBearingAndDistance(p, br, hd)
+			if !closePoints(r, q, 1e-6) {
+				col.failClass(ht, "bearing-roundtrip", "PointAtBearingAndDistance(%v, Bearing %v, %v) = %v, want %v", p, br, hd, r, q)
+			}
+		}
+		// midpoint
+		m := geo.Midpoint(p, q)
+		d1, d2 := geo.DistanceHaversine(p, m), geo.DistanceHaversine(m, q)
+		if !closeNum(d1, d2, 1e-6, 1e-9) || !closeNum(d1+d2, hd, 1e-6, 1e-9) {
+			col.failClass(ht, "midpoint", "Midpoint(%v, %v) = %v: %v + %v vs %v", p, q, m, d1, d2, hd)
+		}
+		// length
+		ls := orb.LineString{p, q, genNearby(ht, q)}
+		wantL := geo.Distance(ls[0], ls[1]) + geo.Distance(ls[1], ls[2])
+		wantH := haversine(ls[0], ls[1]) + haversine(ls[1], ls[2])
+		if !closeNum(geo.Length(ls), wantL, 1e-6, 1e-12) || !closeNum(geo.LengthHaversine(ls), wantH, 1e-6, 1e-9) {
+			col.failClass(ht, "length", "Length(%v) = %v / %v, want %v / %v", ls, geo.Length(ls), geo.LengthHaversine(ls), wantL, wantH)
+		}
+		// bound around a point: the cardinal points just inside the distance are inside,
+		// just outside are outside
+		dist := float64(drawInt(ht, 1, 100000))
+		if math.Abs(p[1]) <= 60 && math.Abs(p[0]) <= 150 {
+			nb := geo.NewBoundAroundPoint(p, dist)
+			for _, bearing := range []float64{0, 90, 180, 270, float64(drawInt(ht, 0, 359))} {
+				in := geo.PointAtBearingAndDistance(p, bearing, dist*0.99)
+				if !nb.Contains(in) {
+					col.failClass(ht, "bound-around-in", "NewBoundAroundPoint(%v, %v) = %v misses %v (bearing %v at 0.99 d)", p, dist, nb, in, bearing)
+					break
+				}
+				if bearing == float64(int(bearing)) && int(bearing)%90 == 0 {
+					out := geo.PointAtBearingAndDistance(p, bearing, dist*1.01)
+					if nb.Contains(out) {
+						col.failClass(ht, "bound-around-out", "NewBoundAroundPoint(%v, %v) = %v contains %v (bearing %v at 1.01 d)", p, dist, nb, out, bearing)
+						break
+					}
+				}
+			}
+			if !closeNum(geo.BoundHeight(nb), 2*dist, 1, 5e-3) { // BoundHeight's 111131.75 m/deg vs the sphere's 111319.49
+				col.failClass(ht, "bound-around-height", "NewBoundAroundPoint(%v, %v) = %v has height %v", p, dist, nb, geo.BoundHeight(nb))
+			}
+		}
+		// pad, height, width
+		b := orb.MultiPoint{p, q}.Bound()
+		if h := geo.BoundHeight(b); h != 111131.75*(b.Max[1]-b.Min[1]) {
+			col.failClass(ht, "height", "BoundHeight(%v) = %v", b, h)
+		}
+		cy := (b.Min[1] + b.Max[1]) / 2
+		if w := geo.BoundWidth(b); w != geo.Distance(orb.Point{b.Min[0], cy}, orb.Point{b.Max[0], cy}) {
+			col.failClass(ht, "width", "BoundWidth(%v) = %v", b, w)
+		}
+		if math.Abs(p[1]) <= 60 && math.Abs(p[0]) <= 150 {
+			pb := geo.BoundPad(b, dist)
+			if !pb.Contains(b.Min) || !pb.Contains(b.Max) || !closeNum(geo.BoundHeight(pb), geo.BoundHeight(b)+2*dist, 1e-3, 1e-9) {
+				col.failClass(ht, "pad", "BoundPad(%v, %v) = %v (heights %v, %v)", b, dist, pb, geo.BoundHeight(b), geo.BoundHeight(pb))
+			}
+			if geo.BoundWidth(pb) < geo.BoundWidth(b)+2*dist*0.99 {
+				col.failClass(ht, "pad-width", "BoundPad(%v, %v) = %v widened by %v", b, dist, pb, geo.BoundWidth(pb)-geo.BoundWidth(b))
+			}
+		}
+		// area of a small polygon: the planar area scaled to metres at the centre latitude
+		if math.Abs(p[1]) <= 60 {
+			ring := genStarRing(ht, 0, 0, 3, 5)
+			scale := 0.01 // degrees per unit: rings of at most 0.1 degrees across
+			for i := range ring {
+				ring[i] = orb.Point{p[0] + ring[i][0]*scale, p[1] + ring[i][1]*scale}
+			}
+			planarDeg := planar.Area(ring) // signed
+			k := earthR * math.Pi / 180
+			wantArea := planarDeg * k * k * math.Cos(p[1]*math.Pi/180)
+			got := geo.SignedArea(ring)
+			if !closeNum(got, wantArea, 0, 2e-3) {
+				col.failClass(ht, "signed-area", "SignedArea(%v) = %v, scaled planar %v", ring, got, wantArea)
+			}
+			if geo.Area(ring) != math.Abs(got) || !closeNum(geo.Area(orb.Polygon{ring}), math.Abs(got), 1e-6, 1e-12) {
+				col.failClass(ht, "area", "Area(%v) = %v, SignedArea %v", ring, geo.Area(ring), got)
+			}
+			if (ring.Orientation() == orb.CCW) != (got > 0) {
+				col.failClass(ht, "area-sign", "SignedArea(%v) = %v, orientation %v", ring, got, ring.Orientation())
+			}
+		}
+		// point at a distance along a line
+		total := geo.LengthHaversine(ls)
+		frac := float64(drawInt(ht, -10, 110)) / 100
+		along := frac * total
+		pt, bearing := geo.PointAtDistanceAlongLine(ls, along)
+		switch {
+		case along < 0:
+			if pt != ls[0] {
+				col.failClass(ht, "along-negative", "PointAtDistanceAlongLine(%v, %v) = %v", ls, along, pt)
+			}
+		case along >= total-1e-6:
+			// at the end within the rounding of the summed segment distances
+			if !closePoints(pt, ls[2], 1e-9) {
+				col.failClass(ht, "along-past", "PointAtDistanceAlongLine(%v, %v) = %v, want the end", ls, along, pt)
+			}
+		default:
+			// on the path: within a metre of a segment, and the travelled distance matches
+			travelled := math.Inf(1)
+			for i := 0; i+1 < len(ls); i++ {
+				a, b := ls[i], ls[i+1]
+				// geodesic-ish check: the point is where the bearing walk lands, so measure
+				// with the same tools
+				if closeNum(geo.DistanceHaversine(a, pt)+geo.DistanceHaversine(pt, b), geo.DistanceHaversine(a, b), 1, 1e-6) {
+					tv := geo.DistanceHaversine(a, pt)
+					for j := 0; j < i; j++ {
+						tv += geo.DistanceHaversine(ls[j], ls[j+1])
+					}
+					if math.Abs(tv-along) < math.Abs(travelled-along) {
+						travelled = tv
+					}
+				}
+			}
+			if !closeNum(travelled, along, 1, 1e-6) {
+				col.failClass(ht, "along", "PointAtDistanceAlongLine(%v, %v) = %v (bearing %v): travelled %v", ls, along, pt, bearing, travelled)
+			}
+		}
+		col.count("ok")
+	})
+}
+
+// TestHegelProject: Mercator forward and back, WGS84 the inverse pair, the scale factor, and
+// the geometry helpers applied point-wise.
+func TestHegelProject(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		p := orb.Point{float64(drawInt(ht, -1800000, 1800000)) / 10000, float64(drawInt(ht, -850000, 850000)) / 10000}
+		m := project.WGS84.ToMercator(p)
+		back := project.Mercator.ToWGS84(m)
+		if !closePoints(back, p, 1e-9) {
+			col.failClass(ht, "mercator-roundtrip", "Mercator.ToWGS84(WGS84.ToMercator(%v) = %v) = %v", p, m, back)
+		}
+		// the model: x = R * lon (rad), y = R * ln(tan(pi/4 + lat/2))
+		wantX := earthR * p[0] * math.Pi / 180
+		wantY := earthR * math.Log(math.Tan(math.Pi/4+p[1]*math.Pi/360))
+		if !closeNum(m[0], wantX, 1e-6, 1e-12) || !closeNum(m[1], wantY, 1e-6, 1e-12) {
+			col.failClass(ht, "mercator", "Mercator.ToPlanar(%v) = %v, model %v %v", p, m, wantX, wantY)
+		}
+		if s := project.MercatorScaleFactor(p); !closeNum(s, 1/math.Cos(p[1]*math.Pi/180), 1e-9, 1e-12) {
+			col.failClass(ht, "scale", "MercatorScaleFactor(%v) = %v, want %v", p, s, 1/math.Cos(p[1]*math.Pi/180))
+		}
+		// the helpers apply the projection to every coordinate, in order
+		g := genAnyGeometry(ht)
+		shift := func(q orb.Point) orb.Point { return orb.Point{q[0] + 1, q[1] - 2} }
+		before := coords(g)
+		res := project.Geometry(orb.Clone(g), shift)
+		after := coords(res)
+		if res.GeoJSONType() != g.GeoJSONType() || len(after) != len(before) {
+			col.failClass(ht, "helper-shape", "project.Geometry(%v) = %v", g, res)
+		} else {
+			for i := range before {
+				if after[i] != shift(before[i]) {
+					col.failClass(ht, "helper", "project.Geometry(%v) coordinate %d = %v, want %v", g, i, after[i], shift(before[i]))
+					break
+				}
+			}
+		}
+		if bd, ok := g.(orb.Bound); ok {
+			pb := project.Bound(bd, shift)
+			if pb.Min != shift(bd.Min) || pb.Max != shift(bd.Max) {
+				col.failClass(ht, "helper-bound", "project.Bound(%v) = %v", bd, pb)
+			}
+		}
+		col.count("ok")
+	})
+}
diff --git a/hegel/hegel_geometries_test.go b/hegel/hegel_geometries_test.go
new file mode 100644
index 0000000..6e701c3
--- /dev/null
+++ b/hegel/hegel_geometries_test.go
@@ -0,0 +1,589 @@
+package hegel
+
+// The records the codec and bounds properties draw and the package-level generators they are
+// drawn from: coordinates, points, the eight orb types, geometries of the seven GeoJSON kinds
+// (collections nested to depth 2), anything (ring and bound added), bounds; then the case
+// records wktCase, wkbCase, geoJSONCase and boundsCase with their generators. The population
+// is the one the old per-call generators of hegel_gen_test.go draw (the part 2 properties
+// still use those): coordinates with two decimals in [-20, 20], multi points of 0..5 points,
+// line strings empty 10% else 2..6 points with consecutive points distinct (a repeat nudged
+// by 0.01), star rings around a centre with 30..90 degree gaps, rings empty 5%, polygons
+// empty 5% with 0..2 square holes, multi polygons of 0..3 disjoint polygons, collections of
+// 0..4 members, the seven kinds uniform, any geometry ring 10 / bound 10 / geometry 80, bounds
+// degenerate 10 + 10.
+//
+// The weights are nominal and the figure beside each is what the probe measured over 3000
+// cases of the case generators with a fixed seed (the engine favours the first alternative
+// of a weighted choice drawn inside a larger case, the small values of a range, and index 1
+// of a SampledFrom table): "N nominal: weight w realises r" records the tuning.
+//
+// Two populations are built from the same pieces: the shaped one, which draws the shapes of
+// the recorded bugs at their natural rates (an empty ring, an empty line string inside a
+// multi line string, a collection with a nested or an empty member, an empty collection, a
+// multi-part whose first part is empty), and the plain one, the region past those shapes
+// (rings never empty, the members of a multi line string never empty, collections of 1..4
+// members that are neither empty nor collections), which the wide properties draw under
+// HEGEL_NO_KNOWN=1 (hzShaped) and the narrow properties draw as the surroundings of a shape.
+
+import (
+	"encoding/binary"
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/paulmach/orb"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- printing
+
+// show prints a geometry with its type ("Collection{Point{1 2}, MultiPoint{}}"): the form of
+// every geometry value the models state and the records print (fmt's %v loses the type).
+func show(g orb.Geometry) string {
+	switch g := g.(type) {
+	case nil:
+		return "<nil>"
+	case orb.Point:
+		return "Point" + showPoint(g)
+	case orb.MultiPoint:
+		return "MultiPoint" + showPoints(g)
+	case orb.LineString:
+		return "LineString" + showPoints(g)
+	case orb.Ring:
+		return "Ring" + showPoints(g)
+	case orb.MultiLineString:
+		parts := make([]string, len(g))
+		for i, ls := range g {
+			parts[i] = showPoints(ls)
+		}
+		return "MultiLineString{" + strings.Join(parts, " ") + "}"
+	case orb.Polygon:
+		parts := make([]string, len(g))
+		for i, r := range g {
+			parts[i] = showPoints(r)
+		}
+		return "Polygon{" + strings.Join(parts, " ") + "}"
+	case orb.MultiPolygon:
+		parts := make([]string, len(g))
+		for i, p := range g {
+			parts[i] = show(p)
+		}
+		return "MultiPolygon{" + strings.Join(parts, ", ") + "}"
+	case orb.Collection:
+		parts := make([]string, len(g))
+		for i, m := range g {
+			parts[i] = show(m)
+		}
+		return "Collection{" + strings.Join(parts, ", ") + "}"
+	case orb.Bound:
+		return "Bound" + showBound(g)
+	}
+	panic(fmt.Sprintf("show: %T", g))
+}
+
+func showNum(f float64) string { return strconv.FormatFloat(f, 'g', -1, 64) }
+
+func showPoint(p orb.Point) string { return "{" + showNum(p[0]) + " " + showNum(p[1]) + "}" }
+
+func showPoints(ps []orb.Point) string {
+	parts := make([]string, len(ps))
+	for i, p := range ps {
+		parts[i] = showPoint(p)
+	}
+	return "{" + strings.Join(parts, " ") + "}"
+}
+
+// showBound prints a bound as "{minx miny}-{maxx maxy}" (the form of the bug notes).
+func showBound(b orb.Bound) string { return showPoint(b.Min) + "-" + showPoint(b.Max) }
+
+// --------------------------------------------------------------------------- pieces
+
+// coordinates: a coordinate with two decimals in [-20, 20] (exact in %g and in JSON).
+var coordinates = hegel.Map(hzInts(-2000, 2000), func(k int) float64 { return float64(k) / 100 })
+
+// points: a point of two coordinates.
+var points = hegel.Map(hzTuple(coordinates, coordinates), func(v []float64) orb.Point { return orb.Point{v[0], v[1]} })
+
+// listed: k values of g with k drawn from count first (Lists alone skews short and yields nil
+// for no elements; the codecs tell nil from empty, so the list is never nil).
+func listed[T any](count hegel.Generator[int], g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.FlatMap(count, func(k int) hegel.Generator[[]T] {
+		return hegel.Map(hegel.Lists(g).MinSize(k).MaxSize(k), func(xs []T) []T {
+			if xs == nil {
+				return []T{}
+			}
+			return xs
+		})
+	})
+}
+
+// asGeometry widens a typed generator to orb.Geometry.
+func asGeometry[T orb.Geometry](g hegel.Generator[T]) hegel.Generator[orb.Geometry] {
+	return hegel.Map(g, func(v T) orb.Geometry { return v })
+}
+
+// nudged makes consecutive points distinct: a repeat is moved by 0.01 rather than redrawn
+// (hegel's minimal test case repeats every draw).
+func nudged(ps []orb.Point) []orb.Point {
+	out := make([]orb.Point, 0, len(ps))
+	for _, p := range ps {
+		if len(out) > 0 && out[len(out)-1] == p {
+			p[0] = round2(p[0] + 0.01)
+		}
+		out = append(out, p)
+	}
+	return out
+}
+
+// multiPointsOf: a multi point of count points.
+func multiPointsOf(count hegel.Generator[int]) hegel.Generator[orb.MultiPoint] {
+	return hegel.Map(listed(count, points), func(ps []orb.Point) orb.MultiPoint { return orb.MultiPoint(ps) })
+}
+
+// linesOf: a line string of count points, consecutive points distinct.
+func linesOf(count hegel.Generator[int]) hegel.Generator[orb.LineString] {
+	return hegel.Map(listed(count, points), func(ps []orb.Point) orb.LineString { return orb.LineString(nudged(ps)) })
+}
+
+// starRingsAt: a closed, simple ring around (cx, cy): vertices at increasing angles with gaps
+// of 30..90 degrees (so 4..12 of them) and radii in [rmin, rmax], rounded to two decimals;
+// the orientation is either. With gaps of at most 90 degrees and radii of at least rmin,
+// every edge stays at least rmin*cos(45deg) from the centre: with rmin = 3 the disc of radius
+// 1.2 around the centre is inside the ring. A Composite: the number of gap draws depends on
+// the gaps drawn.
+func starRingsAt(cx, cy, rmin, rmax float64) hegel.Generator[orb.Ring] {
+	return hegel.Composite(func(tc hegel.TestCase) orb.Ring {
+		start := hegel.Draw(tc, hzInts(0, 35)) * 10
+		var angles []int
+		cur := 0
+		for cur < 270 {
+			g := hegel.Draw(tc, hzInts(3, 9)) * 10
+			if cur+g > 330 {
+				g = 330 - cur
+			}
+			angles = append(angles, (start+cur)%360)
+			cur += g
+		}
+		angles = append(angles, (start+cur)%360)
+		sort.Ints(angles)
+		r := make(orb.Ring, 0, len(angles)+1)
+		for _, a := range angles {
+			rad := rmin + float64(hegel.Draw(tc, hzInts(0, 100)))/100*(rmax-rmin)
+			th := float64(a) * math.Pi / 180
+			x, y := round2(cx+rad*math.Cos(th)), round2(cy+rad*math.Sin(th))
+			if x == 0 { // never a negative zero: the codecs write it "-0" and shapely reads it back 0
+				x = 0
+			}
+			if y == 0 {
+				y = 0
+			}
+			r = append(r, orb.Point{x, y})
+		}
+		r = append(r, r[0])
+		if hegel.Draw(tc, hzCoin(50)) {
+			r.Reverse()
+		}
+		return r
+	})
+}
+
+// centres: a ring or polygon centre, integer coordinates in [-15, 15].
+var centres = hzTuple(hzInts(-15, 15), hzInts(-15, 15))
+
+// starRings: a star ring around a drawn centre with radii 3..5.
+var starRings = hegel.FlatMap(centres, func(c []int) hegel.Generator[orb.Ring] {
+	return starRingsAt(float64(c[0]), float64(c[1]), 3, 5)
+})
+
+// holeCounts: 0..2 holes, evenly (33 nominal each: weights 6/8/10 realise 35/38/27; 10 each
+// realised 54/17/28).
+var holeCounts = evenInts(0, 6, 8, 10)
+
+// polygonsAt: a valid polygon around (cx, cy): a star outer ring and 0..2 square holes, each
+// clockwise half the time.
+func polygonsAt(cx, cy float64) hegel.Generator[orb.Polygon] {
+	return hegel.Composite(func(tc hegel.TestCase) orb.Polygon {
+		p := orb.Polygon{hegel.Draw(tc, starRingsAt(cx, cy, 3, 5))}
+		nh := hegel.Draw(tc, holeCounts)
+		for i := 0; i < nh; i++ {
+			p = append(p, squareRing(cx, cy, holeSquares[i], hegel.Draw(tc, hzCoin(50))))
+		}
+		return p
+	})
+}
+
+// validPolygons: a polygon around a drawn centre.
+var validPolygons = hegel.FlatMap(centres, func(c []int) hegel.Generator[orb.Polygon] {
+	return polygonsAt(float64(c[0]), float64(c[1]))
+})
+
+// multiPolygonsOf: count disjoint polygons (centres 12 apart, radii at most 5).
+func multiPolygonsOf(count hegel.Generator[int]) hegel.Generator[orb.MultiPolygon] {
+	return hegel.FlatMap(count, func(n int) hegel.Generator[orb.MultiPolygon] {
+		return hegel.Composite(func(tc hegel.TestCase) orb.MultiPolygon {
+			mp := make(orb.MultiPolygon, 0, n)
+			for i := 0; i < n; i++ {
+				y := float64(hegel.Draw(tc, hzInts(-1, 1)) * 12)
+				mp = append(mp, hegel.Draw(tc, polygonsAt(float64(-12+12*i), y)))
+			}
+			return mp
+		})
+	})
+}
+
+// --------------------------------------------------------------------------- the two populations
+
+// geometryFamily is one population of geometries: the shaped one (the natural rates of the
+// recorded bugs' shapes) or the plain one (the region past them).
+type geometryFamily struct {
+	multiPoints      hegel.Generator[orb.MultiPoint]
+	lineStrings      hegel.Generator[orb.LineString]
+	multiLineStrings hegel.Generator[orb.MultiLineString]
+	rings            hegel.Generator[orb.Ring]
+	polygons         hegel.Generator[orb.Polygon]
+	multiPolygons    hegel.Generator[orb.MultiPolygon]
+	geometries       [3]hegel.Generator[orb.Geometry] // by depth: the seven GeoJSON kinds, collections only while depth > 0
+	collections      [3]hegel.Generator[orb.Collection]
+	members          hegel.Generator[orb.Geometry] // a member of a collection at depth 0
+	nonEmptyLines    hegel.Generator[orb.LineString]
+	any              hegel.Generator[orb.Geometry] // ring, bound or geometry
+}
+
+// The counts: uniform ranges (evenInts, tuned). The realised figures are the probe's over
+// 3000 wktCases (seed 77); the same generator drawn inside another record moves by a few
+// points (the engine's bias depends on the draws around it: the multi line string counts
+// came out 15/33/40/19 in the WKT record and 38/36/25/23 in the GeoJSON one with the same
+// weights), so the tuning is to the WKT record and the others are within about three points.
+var (
+	multiPointCounts   = evenInts(0, 7, 8, 12, 10, 10, 11) // 0..5 at 16.7 nominal: 7/8/12/10/10/11 realise 22/18/17/13/13/16
+	lineCounts         = evenInts(2, 7, 10, 9, 14, 12)     // 2..6 at 20 nominal: 7/10/9/14/12 realise 21/25/18/17/18
+	multiLineCounts    = evenInts(0, 10, 10, 10, 10)       // 0..3 at 25 nominal: 10 each realise 15/33/40/19 (26/26/24/28 before the kind weights moved)
+	multiPolygonCounts = evenInts(0, 8, 11, 13, 9)         // 0..3 at 25 nominal: 8/11/13/9 realise 22/20/30/27
+	memberCounts       = evenInts(0, 8, 9, 14, 10, 12)     // 0..4 at 20 nominal: 8/9/14/10/12 realise 19/17/25/20/19
+	plainMemberCounts  = evenInts(1, 10, 10, 10, 10)       // 1..4 (the plain population: no empty collection)
+	kindWeights        = []int{6, 10, 10, 10, 12, 10, 9}   // the seven kinds at 14.3 nominal (11.4 of any geometry), Point first: 6/10/10/10/12/10/9 realise 9/12.6/10.8/10.7/12.7/8.4/13.8 of any geometry (Point 17.7 at 10)
+)
+
+// newGeometryFamily builds a population; plain is the region past the shapes.
+func newGeometryFamily(plain bool) *geometryFamily {
+	f := &geometryFamily{}
+	f.multiPoints = multiPointsOf(multiPointCounts)
+	nonEmptyLines := linesOf(lineCounts)
+	f.nonEmptyLines = nonEmptyLines
+	f.lineStrings = hzWeighted(
+		hzW(8, hegel.Just(orb.LineString{})), // 10 nominal: weight 8 realises 11 of the line strings
+		hzW(90, nonEmptyLines),
+	)
+	// an empty member of a multi line string is the shape of orb/8 (and, first, of orb/3):
+	// never in the plain population
+	memberLines := hzWeighted(
+		hzW(hzUnless(plain, 2), hegel.Just(orb.LineString{})), // 10 nominal: weight 2 realises 12 of the members (10 realised 32, 5 realised 18: the first alternative inside a list)
+		hzW(90, nonEmptyLines),
+	)
+	f.multiLineStrings = hegel.Map(listed(multiLineCounts, memberLines), func(ls []orb.LineString) orb.MultiLineString { return orb.MultiLineString(ls) })
+	// an empty ring is the shape of orb/8 ("POLYGON(())"): never in the plain population
+	f.rings = hzWeighted(
+		hzW(hzUnless(plain, 8), hegel.Just(orb.Ring{})), // 5 nominal: weight 8 realises 5.7 of the rings (5 realised 2.3)
+		hzW(95, starRings),
+	)
+	f.polygons = hzWeighted(
+		hzW(6, hegel.Just(orb.Polygon{})), // 5 nominal: weight 6 realises 7 of the polygons
+		hzW(95, validPolygons),
+	)
+	f.multiPolygons = multiPolygonsOf(multiPolygonCounts)
+
+	// the six simple kinds, Point first (the shrink target and the engine's first case)
+	simple := func(w []int) []hzChoice[orb.Geometry] {
+		return []hzChoice[orb.Geometry]{
+			hzW(w[0], asGeometry(points)),
+			hzW(w[1], asGeometry(f.multiPoints)),
+			hzW(w[2], asGeometry(f.lineStrings)),
+			hzW(w[3], asGeometry(f.multiLineStrings)),
+			hzW(w[4], asGeometry(f.polygons)),
+			hzW(w[5], asGeometry(f.multiPolygons)),
+		}
+	}
+	f.geometries[0] = hzWeighted(simple(kindWeights)...)
+	if plain {
+		// the plain members: non-empty, never a collection (a nested or an empty member is
+		// the shape of orb/1, an empty collection that of orb/9)
+		plainMembers := hzWeighted(
+			hzW(kindWeights[0], asGeometry(points)),
+			hzW(kindWeights[1], asGeometry(multiPointsOf(evenInts(1, 10, 10, 10, 10, 10)))),
+			hzW(kindWeights[2], asGeometry(nonEmptyLines)),
+			hzW(kindWeights[3], asGeometry(hegel.Map(listed(evenInts(1, 10, 10, 10), nonEmptyLines), func(ls []orb.LineString) orb.MultiLineString { return orb.MultiLineString(ls) }))),
+			hzW(kindWeights[4], asGeometry(validPolygons)),
+			hzW(kindWeights[5], asGeometry(multiPolygonsOf(evenInts(1, 10, 10, 10)))),
+		)
+		f.members = plainMembers
+		for d := range f.collections {
+			f.collections[d] = hegel.Map(listed(plainMemberCounts, plainMembers), func(ms []orb.Geometry) orb.Collection { return orb.Collection(ms) })
+		}
+	} else {
+		f.members = f.geometries[0]
+		f.collections[0] = hegel.Map(listed(memberCounts, f.geometries[0]), func(ms []orb.Geometry) orb.Collection { return orb.Collection(ms) })
+	}
+	for d := 1; d < len(f.geometries); d++ {
+		f.geometries[d] = hzWeighted(append(simple(kindWeights), hzW(kindWeights[6], asGeometry(f.collections[d-1])))...)
+		if !plain {
+			f.collections[d] = hegel.Map(listed(memberCounts, f.geometries[d]), func(ms []orb.Geometry) orb.Collection { return orb.Collection(ms) })
+		}
+	}
+	f.any = hzWeighted(
+		hzW(76, f.geometries[2]), // 80 nominal: 76/12/12 realise 78/11/11 (80/10/10 realised 85/7/8)
+		hzW(12, asGeometry(f.rings)),
+		hzW(12, asGeometry(bounds)),
+	)
+	return f
+}
+
+var (
+	shapedGeometries = newGeometryFamily(false)
+	plainGeometries  = newGeometryFamily(true)
+)
+
+// The generators the properties draw: the shaped population by default, the plain one under
+// HEGEL_NO_KNOWN=1.
+var (
+	multiPoints      = hzShaped(shapedGeometries.multiPoints, plainGeometries.multiPoints)
+	lineStrings      = hzShaped(shapedGeometries.lineStrings, plainGeometries.lineStrings)
+	multiLineStrings = hzShaped(shapedGeometries.multiLineStrings, plainGeometries.multiLineStrings)
+	rings            = hzShaped(shapedGeometries.rings, plainGeometries.rings)
+	polygons         = hzShaped(shapedGeometries.polygons, plainGeometries.polygons)
+	multiPolygons    = hzShaped(shapedGeometries.multiPolygons, plainGeometries.multiPolygons)
+	anyGeometries    = hzShaped(shapedGeometries.any, plainGeometries.any)
+)
+
+// geometries: one of the seven GeoJSON kinds, collections nested to the depth.
+func geometries(depth int) hegel.Generator[orb.Geometry] {
+	return hzShaped(shapedGeometries.geometries[depth], plainGeometries.geometries[depth])
+}
+
+// --------------------------------------------------------------------------- bounds
+
+// boundOfTwo is the bound with the two points as opposite corners.
+func boundOfTwo(a, b orb.Point) orb.Bound {
+	return orb.Bound{Min: orb.Point{math.Min(a[0], b[0]), math.Min(a[1], b[1])}, Max: orb.Point{math.Max(a[0], b[0]), math.Max(a[1], b[1])}}
+}
+
+// bounds: a non-empty bound (Min <= Max) of two points, degenerate in x 10% of the time and
+// in y 10% of the time (the second point's coordinate copied from the first).
+var bounds = hegel.Composite(func(tc hegel.TestCase) orb.Bound {
+	a, b := hegel.Draw(tc, points), hegel.Draw(tc, points)
+	if hegel.Draw(tc, hzCoin(10)) { // 10 nominal: realises 8.6 (zero width) of the receivers of the bounds record
+		b[0] = a[0]
+	}
+	if hegel.Draw(tc, hzCoin(10)) { // 10 nominal: realises 9.5 (zero height)
+		b[1] = a[1]
+	}
+	return boundOfTwo(a, b)
+})
+
+// emptyBound is the bound of an empty geometry (orb's unexported emptyBound).
+var emptyBound = orb.Bound{Min: orb.Point{1, 1}, Max: orb.Point{-1, -1}}
+
+// positiveArea makes a bound non-degenerate (a zero extent widened by 0.01): the region past
+// the shape of orb/4.
+func positiveArea(b orb.Bound) orb.Bound {
+	if b.Min[0] == b.Max[0] {
+		b.Max[0] = round2(b.Max[0] + 0.01)
+	}
+	if b.Min[1] == b.Max[1] {
+		b.Max[1] = round2(b.Max[1] + 0.01)
+	}
+	return b
+}
+
+// --------------------------------------------------------------------------- the case records
+
+// wktCase is a geometry read and written as WKT: its own text (and the typed functions on
+// it), shapely's text, the whitespace variants, and the proper prefix of its text cut at cut
+// (1..len-1; 0 for no prefix check).
+type wktCase struct {
+	g        orb.Geometry
+	cut      int
+	variants []wktVariant
+}
+
+func (c wktCase) GoString() string {
+	names := make([]string, len(c.variants))
+	for i, v := range c.variants {
+		names[i] = v.name
+	}
+	return fmt.Sprintf("%s cut=%d variants=%s", show(c.g), c.cut, strings.Join(names, ","))
+}
+
+// wktCasesOf: the geometries as WKT cases with the variants, the cut drawn over the text (the
+// replica's text is the library's).
+func wktCasesOf(gs hegel.Generator[orb.Geometry], variants []wktVariant) hegel.Generator[wktCase] {
+	return hegel.FlatMap(gs, func(g orb.Geometry) hegel.Generator[wktCase] {
+		n := len(wktOf(g, hzKnownAll))
+		return hegel.Map(hzInts(1, n-1), func(cut int) wktCase { return wktCase{g: g, cut: cut, variants: variants} })
+	})
+}
+
+// wktCases: any geometry with every variant.
+var wktCases = wktCasesOf(anyGeometries, wktVariants)
+
+// wkbCase is a geometry written as WKB in a byte order and read back, streamed with a second
+// geometry, written as EWKB with an SRID, and cut at a proper prefix (cut taken modulo the
+// length: 1 + (cut-1) mod (len-1)).
+type wkbCase struct {
+	g     orb.Geometry
+	order binary.ByteOrder
+	g2    orb.Geometry
+	srid  int
+	cut   int
+}
+
+func (c wkbCase) GoString() string {
+	return fmt.Sprintf("%s %v with %s srid=%d cut=%d", show(c.g), c.order, show(c.g2), c.srid, c.cut)
+}
+
+// byteOrders and srids: the tables (weightedOver: SampledFrom favours index 1).
+var (
+	byteOrders = weightedOver[binary.ByteOrder]([]int{7, 10}, binary.LittleEndian, binary.BigEndian) // 50 each nominal: 7/10 realise 55/45
+	srids      = weightedOver([]int{2, 10, 12, 11}, 0, 4326, 3857, 1)                                // 25 each nominal: 2/10/12/11 realise 27/30/23/20 (SampledFrom realised 16/52/14/18)
+)
+
+// wkbCases: any geometry, little-endian first, a second geometry nested to depth 1, one of the
+// SRIDs, a cut.
+var wkbCases = hegel.Composite(func(tc hegel.TestCase) wkbCase {
+	return wkbCase{
+		g:     hegel.Draw(tc, anyGeometries),
+		order: hegel.Draw(tc, byteOrders),
+		g2:    hegel.Draw(tc, geometries(1)),
+		srid:  hegel.Draw(tc, srids),
+		cut:   hegel.Draw(tc, hzInts(1, 2000)),
+	}
+})
+
+// docChoice is the GeoJSON document the geometry property reads back: the geometry's own
+// (own), its own with one position (pos, modulo the count) cut to keep numbers (truncated),
+// or one of the fixed short-position texts (fixed; shortDocs[fixed]).
+type docChoice struct {
+	kind      string
+	pos, keep int
+	fixed     int
+}
+
+func (d docChoice) String() string {
+	switch d.kind {
+	case "truncated":
+		return fmt.Sprintf("truncated(position %d to %d numbers)", d.pos, d.keep)
+	case "fixed":
+		return "fixed " + shortDocs[d.fixed]
+	}
+	return "own"
+}
+
+// shortDocs are the fixed short-position documents of the old check (byte for byte).
+var shortDocs = []string{
+	`{"type":"Point","coordinates":[]}`,
+	`{"type":"Point","coordinates":[1]}`,
+	`{"type":"LineString","coordinates":[[1,2],[3]]}`,
+}
+
+// docChoices: the own document, or (10 nominal, the shape of orb/10, never under
+// HEGEL_NO_KNOWN=1) a short-position document: a truncated position of the geometry's own, or
+// a fixed text.
+var docChoices = hzWeighted(
+	hzW(90, hegel.Just(docChoice{kind: "own"})),
+	hzW(hzUnless(hzNoKnown, 13), shortDocChoices), // 10 nominal: weight 13 realises 11.7 (6.9 truncated, 4.8 fixed)
+)
+
+var shortDocChoices = hzWeighted(
+	hzW(10, hegel.Map(hzTuple(hzInts(0, 99), hzInts(0, 1)), func(v []int) docChoice { return docChoice{kind: "truncated", pos: v[0], keep: v[1]} })),
+	hzW(10, hegel.Map(hzInts(0, len(shortDocs)-1), func(i int) docChoice { return docChoice{kind: "fixed", fixed: i} })),
+)
+
+// geoJSONCase is a geometry written as a GeoJSON geometry document and read back (as the
+// drawn document), by shapely, by the helper types, as a feature with properties name and n,
+// an id and a bbox, in a feature collection with a second geometry; and a bound as a BBox.
+type geoJSONCase struct {
+	g    orb.Geometry
+	doc  docChoice
+	name string
+	n    int
+	id   any
+	bbox bool
+	g2   orb.Geometry
+	b    orb.Bound
+}
+
+func (c geoJSONCase) GoString() string {
+	return fmt.Sprintf("%s doc=%v feature{name=%q n=%d id=%v bbox=%v} with %s bbox of %s", show(c.g), c.doc, c.name, c.n, c.id, c.bbox, show(c.g2), showBound(c.b))
+}
+
+// featureIDs: no id, or one of the three.
+var featureIDs = hzWeighted(
+	hzW(40, hegel.Just[any](nil)), // 50 nominal: 40/60 realise 56/44 (16/14.5/13 over the three)
+	hzW(60, weightedOver[any]([]int{10, 10, 10}, "id-1", float64(7), "x")),
+)
+
+// featureNames: the property names, plain first.
+var featureNames = weightedOver([]int{5, 9, 11, 12}, "a", "b c", "", "\"q\"") // 25 each nominal: 5/9/11/12 realise 27/24/25/25 (10 each realised 39/24/19/18)
+
+// geoJSONCasesOf: the geometries as GeoJSON cases with the documents read back and the second
+// feature's geometries.
+func geoJSONCasesOf(gs hegel.Generator[orb.Geometry], docs hegel.Generator[docChoice], seconds hegel.Generator[orb.Geometry]) hegel.Generator[geoJSONCase] {
+	return hegel.Composite(func(tc hegel.TestCase) geoJSONCase {
+		return geoJSONCase{
+			g:    hegel.Draw(tc, gs),
+			doc:  hegel.Draw(tc, docs),
+			name: hegel.Draw(tc, featureNames),
+			n:    hegel.Draw(tc, hzInts(-5, 5)),
+			id:   hegel.Draw(tc, featureIDs),
+			bbox: hegel.Draw(tc, hzCoin(68)), // 50 nominal: 68 realises 55 (50 realised 40)
+			g2:   hegel.Draw(tc, seconds),
+			b:    hegel.Draw(tc, bounds),
+		}
+	})
+}
+
+// geoJSONCases: any geometry, the documents at their rates, a second geometry nested to
+// depth 1.
+var geoJSONCases = geoJSONCasesOf(anyGeometries, docChoices, geometries(1))
+
+// boundsCase is a geometry whose Bound() is checked, a receiver bound a (sometimes the empty
+// bound) whose methods are checked with another bound c, a point p (sometimes on a's
+// boundary) and a pad amount d.
+type boundsCase struct {
+	g    orb.Geometry
+	a, c orb.Bound
+	p    orb.Point
+	d    float64
+}
+
+func (c boundsCase) GoString() string {
+	return fmt.Sprintf("%s a=%s c=%s p=%s d=%g", show(c.g), showBound(c.a), showBound(c.c), showPoint(c.p), c.d)
+}
+
+// receivers: a bound, or (5 nominal, the shape of orb/3 for Union and Extend, never under
+// HEGEL_NO_KNOWN=1) the empty bound; under HEGEL_NO_KNOWN=1 the bound has positive area (a
+// zero-area bound is the shape of orb/4).
+var receivers = hzShaped(hzWeighted(
+	hzW(95, bounds),
+	hzW(hzUnless(hzNoKnown, 6), hegel.Just(emptyBound)), // 5 nominal: weight 6 realises 5.2
+), hegel.Map(bounds, positiveArea))
+
+// pointsAbout: a point, or (30 nominal) one on the boundary of a.
+func pointsAbout(a orb.Bound) hegel.Generator[orb.Point] {
+	return hzWeighted(
+		hzW(60, points),
+		hzW(40, weightedOver([]int{2, 8, 11, 10, 14}, a.Min, a.Max, a.LeftTop(), a.RightBottom(), orb.Point{a.Min[0], (a.Min[1] + a.Max[1]) / 2})), // 30 nominal: 60/40 realise 69/31, the picks 8.6/6.9/4.8/4.2/6.8 (6 each nominal; 70/30 with 10 each realised 79/21 with the first pick 9.3)
+	)
+}
+
+var boundsCases = hegel.Composite(func(tc hegel.TestCase) boundsCase {
+	a := hegel.Draw(tc, receivers)
+	return boundsCase{
+		g: hegel.Draw(tc, anyGeometries),
+		a: a,
+		c: hegel.Draw(tc, bounds),
+		p: hegel.Draw(tc, pointsAbout(a)),
+		d: float64(hegel.Draw(tc, hzInts(-300, 300))) / 100,
+	}
+})
diff --git a/hegel/hegel_idioms_test.go b/hegel/hegel_idioms_test.go
new file mode 100644
index 0000000..1b0d228
--- /dev/null
+++ b/hegel/hegel_idioms_test.go
@@ -0,0 +1,185 @@
+package hegel
+
+// The generator idioms the properties share, copied from the go/excelize, go/graphql-go,
+// go/cobra, go/cascadia and go/carbon harness (hegel_idioms_test.go there; go/bubbles'
+// internal/zootest/gen.go before it) with the hz prefix: hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator. Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on it,
+// except the shape of a recorded bug a wide property must reach every run, which goes first
+// at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a
+// weighted choice drawn alone comes out exact (the engine enumerates a small die), but inside
+// a case with other draws the engine favours the first alternative (excelize measured the
+// first of a 2:18:10 choice drawn 40% of the time when another draw precedes or follows it,
+// 7% alone), so the rates are what the collector (HEGEL_COLLECT=1) measures; weightedOver and
+// evenInts are the tuned forms of a table and a range (hegel_geometries_test.go explains the
+// tuning).
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
diff --git a/hegel/hegel_ops_test.go b/hegel/hegel_ops_test.go
new file mode 100644
index 0000000..431c368
--- /dev/null
+++ b/hegel/hegel_ops_test.go
@@ -0,0 +1,463 @@
+package hegel
+
+// Clipping, simplification and resampling.
+
+import (
+	"math"
+	"testing"
+
+	"github.com/paulmach/orb"
+	"github.com/paulmach/orb/clip"
+	"github.com/paulmach/orb/planar"
+	"github.com/paulmach/orb/resample"
+	"github.com/paulmach/orb/simplify"
+	"hegel.dev/go/hegel"
+)
+
+// withinBound reports whether every coordinate lies in the (closed) bound, within tol.
+func withinBound(g orb.Geometry, b orb.Bound, tol float64) bool {
+	for _, p := range coords(g) {
+		if p[0] < b.Min[0]-tol || p[0] > b.Max[0]+tol || p[1] < b.Min[1]-tol || p[1] > b.Max[1]+tol {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelClip: clip.MultiPoint keeps the points the bound contains; clipped lines and rings
+// lie in the bound, on the original, and measure (length, area) what shapely's intersection
+// with the box measures; clip.Geometry dispatches and unwraps single results.
+func TestHegelClip(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		b := genBound(ht)
+		if b.Min[0] == b.Max[0] {
+			b.Max[0] = round2(b.Max[0] + 1)
+		}
+		if b.Min[1] == b.Max[1] {
+			b.Max[1] = round2(b.Max[1] + 1)
+		}
+		if chance(ht, 30) { // a bound around the origin where the polygons are
+			b = orb.Bound{Min: orb.Point{-3, -3}, Max: orb.Point{float64(drawInt(ht, 0, 8)), float64(drawInt(ht, 0, 8))}}
+		}
+		g := genGeometry(ht, 2)
+		if chance(ht, 25) {
+			g = genLongLineString(ht, 8)
+		}
+		if p, ok := g.(orb.Polygon); ok && len(p) > 0 && chance(ht, 50) {
+			g = genPolygonAt(ht, 0, 0) // where the near-origin bounds cut it
+		}
+		orig := orb.Clone(g)
+		tol := 1e-9
+
+		switch gg := g.(type) {
+		case orb.MultiPoint:
+			res := clip.MultiPoint(b, gg)
+			var want orb.MultiPoint
+			for _, p := range gg {
+				if b.Contains(p) {
+					want = append(want, p)
+				}
+			}
+			if !same(res, want) && !(len(res) == 0 && len(want) == 0) {
+				col.failClass(ht, "multipoint", "clip.MultiPoint(%v, %v) = %v, want %v", b, gg, res, want)
+			}
+		case orb.LineString:
+			res := clip.LineString(b, gg.Clone())
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "line-outside", "clip.LineString(%v, %v) = %v has points outside", b, gg, res)
+			}
+			for _, p := range coords(res) {
+				if planar.DistanceFrom(gg, p) > 1e-7 {
+					col.failClass(ht, "line-off", "clip.LineString(%v, %v) = %v has a point off the line", b, gg, res)
+					break
+				}
+			}
+			for _, ls := range res {
+				if len(ls) < 2 {
+					col.failClass(ht, "line-short", "clip.LineString(%v, %v) = %v has a line of %d points", b, gg, res, len(ls))
+				}
+			}
+			if len(gg) > 0 {
+				r := shapelyClip(gg, b)
+				if r.Ok {
+					if !closeNum(planar.Length(res), num(r.Length), 1e-7, 1e-9) {
+						col.failClass(ht, "line-length", "clip.LineString(%v, %v) = %v, length %v, shapely %v", b, gg, res, planar.Length(res), num(r.Length))
+					}
+				}
+			}
+			// the Geometry dispatcher unwraps a single line
+			gres := clip.Geometry(b, gg.Clone())
+			switch len(res) {
+			case 0:
+				if gres != nil {
+					col.failClass(ht, "geometry-nil", "clip.Geometry(%v, %v) = %v, LineString gave nothing", b, gg, gres)
+				}
+			case 1:
+				if !same(gres, res[0]) {
+					col.failClass(ht, "geometry-unwrap", "clip.Geometry(%v, %v) = %v, want %v", b, gg, gres, res[0])
+				}
+			default:
+				if !same(gres, res) {
+					col.failClass(ht, "geometry-mls", "clip.Geometry(%v, %v) = %v, want %v", b, gg, gres, res)
+				}
+			}
+		case orb.MultiLineString:
+			res := clip.MultiLineString(b, gg.Clone())
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "mls-outside", "clip.MultiLineString(%v, %v) = %v has points outside", b, gg, res)
+			}
+			total := 0.0
+			for _, ls := range gg {
+				if len(ls) > 0 {
+					r := shapelyClip(ls, b)
+					if r.Ok {
+						total += num(r.Length)
+					}
+				}
+			}
+			if !closeNum(planar.Length(res), total, 1e-7, 1e-9) {
+				col.failClass(ht, "mls-length", "clip.MultiLineString(%v, %v) = %v, length %v, shapely %v", b, gg, res, planar.Length(res), total)
+			}
+		case orb.Polygon:
+			if len(gg) == 0 {
+				if res := clip.Polygon(b, gg); res != nil {
+					col.failClass(ht, "empty-polygon", "clip.Polygon(%v, empty) = %v", b, res)
+				}
+				break
+			}
+			res := clip.Polygon(b, gg.Clone())
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "polygon-outside", "clip.Polygon(%v, %v) = %v has points outside", b, gg, res)
+			}
+			r := shapelyClip(gg, b)
+			if r.Ok {
+				area := 0.0
+				if res != nil {
+					area = planar.Area(res)
+				}
+				if !closeNum(area, num(r.Area), 1e-7, 1e-9) {
+					col.failClass(ht, "polygon-area", "clip.Polygon(%v, %v) = %v, area %v, shapely %v", b, gg, res, area, num(r.Area))
+				}
+				if res != nil && len(res[0]) > 0 && res[0][0] != res[0][len(res[0])-1] {
+					col.failClass(ht, "polygon-open", "clip.Polygon(%v, %v) = %v: outer ring not closed", b, gg, res)
+				}
+			}
+			// the ring alone
+			rr := clip.Ring(b, gg[0].Clone())
+			r0 := shapelyClip(orb.Polygon{gg[0]}, b)
+			if r0.Ok {
+				area := 0.0
+				if rr != nil {
+					area = math.Abs(planar.Area(rr))
+				}
+				if !closeNum(area, num(r0.Area), 1e-7, 1e-9) {
+					col.failClass(ht, "ring-area", "clip.Ring(%v, %v) = %v, area %v, shapely %v", b, gg[0], rr, area, num(r0.Area))
+				}
+				if rr != nil && area > 1e-9 && rr.Orientation() != gg[0].Orientation() {
+					col.failClass(ht, "ring-orientation", "clip.Ring(%v, %v) = %v changed the orientation", b, gg[0], rr)
+				}
+			}
+		case orb.MultiPolygon:
+			res := clip.MultiPolygon(b, gg.Clone())
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "mp-outside", "clip.MultiPolygon(%v, %v) = %v has points outside", b, gg, res)
+			}
+			total := 0.0
+			for _, p := range gg {
+				r := shapelyClip(p, b)
+				if r.Ok {
+					total += num(r.Area)
+				}
+			}
+			area := 0.0
+			if res != nil {
+				area = planar.Area(res)
+			}
+			if !closeNum(area, total, 1e-7, 1e-9) {
+				col.failClass(ht, "mp-area", "clip.MultiPolygon(%v, %v) = %v, area %v, shapely %v", b, gg, res, area, total)
+			}
+		case orb.Collection:
+			res := clip.Collection(b, orb.Clone(gg).(orb.Collection))
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "collection-outside", "clip.Collection(%v, %v) = %v has points outside", b, gg, res)
+			}
+			if len(res) > len(gg) {
+				col.failClass(ht, "collection-count", "clip.Collection(%v, %v) = %v has more members", b, gg, res)
+			}
+		case orb.Point:
+			gres := clip.Geometry(b, gg)
+			if b.Contains(gg) != (gres != nil) || (gres != nil && !same(gres, gg)) {
+				col.failClass(ht, "point", "clip.Geometry(%v, %v) = %v", b, gg, gres)
+			}
+		}
+		// clip.Geometry: nil when the bounds do not meet, within the bound otherwise
+		gres := clip.Geometry(b, orb.Clone(g))
+		if !b.Intersects(g.Bound()) && gres != nil {
+			col.failClass(ht, "geometry-disjoint", "clip.Geometry(%v, %v) = %v though the bounds are disjoint", b, g, gres)
+		}
+		if gres != nil && !withinBound(gres, b, tol) {
+			col.failClass(ht, "geometry-outside", "clip.Geometry(%v, %v) = %v has points outside", b, g, gres)
+		}
+		_ = orig
+		col.count(g.GeoJSONType())
+	})
+}
+
+// subsequence reports whether sub is an in-order subsequence of ls.
+func subsequence(sub, ls orb.LineString) bool {
+	j := 0
+	for _, p := range sub {
+		for j < len(ls) && ls[j] != p {
+			j++
+		}
+		if j == len(ls) {
+			return false
+		}
+		j++
+	}
+	return true
+}
+
+// modelRadial is the radial simplification: keep a point when it is further than the
+// threshold from the last kept point; the last point is always kept.
+func modelRadial(ls orb.LineString, threshold float64) orb.LineString {
+	if len(ls) <= 2 {
+		return ls
+	}
+	out := orb.LineString{ls[0]}
+	current := 0
+	for i := 1; i < len(ls); i++ {
+		if pointDistance(ls[current], ls[i]) > threshold {
+			current = i
+			out = append(out, ls[i])
+		}
+	}
+	if current != len(ls)-1 {
+		out = append(out, ls[len(ls)-1])
+	}
+	return out
+}
+
+// TestHegelSimplify: Douglas-Peucker against shapely's; Radial against its model; Visvalingam's
+// point-count contracts; every simplifier keeps an in-order subsequence with the end points,
+// removed points within the threshold of the result (Douglas-Peucker), and the type rules of
+// Simplify.
+func TestHegelSimplify(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ls := genLongLineString(ht, 12)
+		threshold := float64(drawInt(ht, 0, 600)) / 100
+
+		// Douglas-Peucker
+		dp := simplify.DouglasPeucker(threshold).LineString(ls.Clone())
+		if !subsequence(dp, ls) || len(dp) < 2 || dp[0] != ls[0] || dp[len(dp)-1] != ls[len(ls)-1] {
+			col.failClass(ht, "dp-shape", "DouglasPeucker(%v) of %v = %v", threshold, ls, dp)
+		} else {
+			for _, p := range ls {
+				if planar.DistanceFrom(dp, p) > threshold+1e-9 {
+					col.failClass(ht, "dp-distance", "DouglasPeucker(%v) of %v = %v leaves %v at %v", threshold, ls, dp, p, planar.DistanceFrom(dp, p))
+					break
+				}
+			}
+			// a point within 1e-6 of the threshold from a chord decides differently in
+			// squared (orb) and plain (GEOS) distance: not compared
+			tie := false
+			for a := 0; a < len(ls); a++ {
+				for b := a + 2; b < len(ls); b++ {
+					for i := a + 1; i < b; i++ {
+						if math.Abs(planar.DistanceFromSegment(ls[a], ls[b], ls[i])-threshold) < 1e-6 {
+							tie = true
+						}
+					}
+				}
+			}
+			r := shapelySimplify(ls, threshold)
+			if r.Ok && !tie {
+				want := fromHexWKB(r.WKB)
+				if !same(dp, want) {
+					col.failClass(ht, "dp-shapely", "DouglasPeucker(%v) of %v = %v, shapely %v", threshold, ls, dp, want)
+				}
+			}
+		}
+
+		// Radial
+		rad := simplify.Radial(planar.Distance, threshold).LineString(ls.Clone())
+		if !same(rad, modelRadial(ls, threshold)) {
+			col.failClass(ht, "radial", "Radial(%v) of %v = %v, model %v", threshold, ls, rad, modelRadial(ls, threshold))
+		}
+
+		// Visvalingam
+		vt := simplify.VisvalingamThreshold(threshold).LineString(ls.Clone())
+		if !subsequence(vt, ls) || len(vt) < 2 || vt[0] != ls[0] || vt[len(vt)-1] != ls[len(ls)-1] {
+			col.failClass(ht, "vis-threshold", "VisvalingamThreshold(%v) of %v = %v", threshold, ls, vt)
+		}
+		keep := drawInt(ht, 0, 12)
+		if !(Known.visvalingamKeepOnePanics && keep == 1 && len(ls) > 2) {
+			vk := simplify.VisvalingamKeep(keep).LineString(ls.Clone())
+			wantN := keep
+			if keep < 2 {
+				wantN = 2 // the ends always stay
+			}
+			if wantN > len(ls) {
+				wantN = len(ls)
+			}
+			if len(vk) != wantN || !subsequence(vk, ls) {
+				col.failClass(ht, "vis-keep", "VisvalingamKeep(%d) of %v (%d points) = %v (%d points), want %d", keep, ls, len(ls), vk, len(vk), wantN)
+			}
+		}
+
+		// rings and polygons: the ring stays closed and a subsequence; holes reduced to nothing
+		// disappear; the type rules of Simplify
+		g := genAnyGeometry(ht)
+		s := pick(ht, []orb.Simplifier{simplify.DouglasPeucker(threshold), simplify.Radial(planar.Distance, threshold), simplify.VisvalingamThreshold(threshold)})
+		res := s.Simplify(orb.Clone(g))
+		switch gg := g.(type) {
+		case orb.Point, orb.Bound:
+			if !same(res, gg) {
+				col.failClass(ht, "simplify-point", "Simplify(%v) = %v", g, res)
+			}
+		case orb.MultiPoint:
+			if !same(res, gg) && !(len(gg) == 0 && res == nil) {
+				col.failClass(ht, "simplify-multipoint", "Simplify(%v) = %v", g, res)
+			}
+		case orb.LineString:
+			if len(gg) == 0 {
+				if res != nil {
+					col.failClass(ht, "simplify-empty", "Simplify(%v) = %v", g, res)
+				}
+			} else if r, ok := res.(orb.LineString); !ok || !subsequence(r, gg) || r[0] != gg[0] || r[len(r)-1] != gg[len(gg)-1] {
+				col.failClass(ht, "simplify-line", "Simplify(%v) = %v", g, res)
+			}
+		case orb.Ring:
+			if len(gg) == 0 {
+				if res != nil {
+					col.failClass(ht, "simplify-empty", "Simplify(%v) = %v", g, res)
+				}
+			} else if r, ok := res.(orb.Ring); !ok || !subsequence(orb.LineString(r), orb.LineString(gg)) || r[0] != gg[0] || r[len(r)-1] != gg[len(gg)-1] {
+				col.failClass(ht, "simplify-ring", "Simplify(%v) = %v", g, res)
+			}
+		case orb.Polygon:
+			if len(gg) == 0 {
+				if res != nil {
+					col.failClass(ht, "simplify-empty", "Simplify(%v) = %v", g, res)
+				}
+			} else if r, ok := res.(orb.Polygon); !ok || len(r) == 0 || len(r) > len(gg) || !subsequence(orb.LineString(r[0]), orb.LineString(gg[0])) {
+				col.failClass(ht, "simplify-polygon", "Simplify(%v) = %v", g, res)
+			} else {
+				for _, h := range r[1:] {
+					if len(h) <= 2 {
+						col.failClass(ht, "simplify-hole", "Simplify(%v) = %v keeps a hole of %d points", g, res, len(h))
+					}
+				}
+			}
+		}
+		col.count("ok")
+	})
+}
+
+// arcPos is the distance along ls of a point on it (the first segment within tol), or -1.
+func arcPos(ls orb.LineString, p orb.Point, tol float64) float64 {
+	pos := 0.0
+	for i := 0; i+1 < len(ls); i++ {
+		if planar.DistanceFromSegment(ls[i], ls[i+1], p) <= tol {
+			return pos + pointDistance(ls[i], p)
+		}
+		pos += pointDistance(ls[i], ls[i+1])
+	}
+	return -1
+}
+
+// TestHegelResample: Resample gives the asked number of points, the ends unchanged, evenly
+// spaced along the path; ToInterval spaces about the interval; edge cases per the doc comments.
+func TestHegelResample(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ls := genLongLineString(ht, 6)
+		if chance(ht, 10) {
+			ls = orb.LineString{}
+		} else if chance(ht, 10) {
+			p := genPoint(ht)
+			ls = orb.LineString{p}
+			for i := drawInt(ht, 0, 3); i > 0; i-- {
+				ls = append(ls, p)
+			}
+		}
+		n := drawInt(ht, -1, 12)
+		res := resample.Resample(ls.Clone(), planar.Distance, n)
+		total := planar.Length(ls)
+		switch {
+		case n <= 0:
+			if res != nil {
+				col.failClass(ht, "nonpositive", "Resample(%v, %d) = %v", ls, n, res)
+			}
+		case len(ls) <= 1:
+			if !same(res, ls) && !(len(ls) == 0 && len(res) == 0) {
+				col.failClass(ht, "short", "Resample(%v, %d) = %v", ls, n, res)
+			}
+		case total == 0: // all points equal: padded or truncated to n copies
+			if len(res) != n {
+				col.failClass(ht, "equal-points", "Resample(%v, %d) = %v", ls, n, res)
+			}
+			for _, p := range res {
+				if p != ls[0] {
+					col.failClass(ht, "equal-points", "Resample(%v, %d) = %v", ls, n, res)
+					break
+				}
+			}
+		default:
+			if len(res) != n {
+				col.failClass(ht, "count", "Resample(%v, %d) = %v (%d points)", ls, n, res, len(res))
+			} else if res[0] != ls[0] || (n > 1 && res[n-1] != ls[len(ls)-1]) {
+				col.failClass(ht, "ends", "Resample(%v, %d) = %v", ls, n, res)
+			} else if n > 1 {
+				step := total / float64(n-1)
+				for i, p := range res {
+					pos := arcPos(ls, p, 1e-7)
+					if pos < 0 || !closeNum(pos, float64(i)*step, 1e-6, 1e-9) {
+						// a point on a self-crossing gets the first crossing's position: accept
+						// when the distance from the path is fine and the neighbours are spaced
+						if planar.DistanceFrom(ls, p) > 1e-7 {
+							col.failClass(ht, "spacing", "Resample(%v, %d) = %v: point %d at %v off the path", ls, n, res, i, p)
+							break
+						}
+					}
+				}
+				for i := 1; i < n; i++ {
+					if d := pointDistance(res[i-1], res[i]); d > step+1e-7 {
+						col.failClass(ht, "chord", "Resample(%v, %d) = %v: chord %d is %v > step %v", ls, n, res, i, d, step)
+						break
+					}
+				}
+			}
+		}
+
+		// ToInterval
+		dist := float64(drawInt(ht, -1, 50)) / 10
+		if len(ls) == 0 && Known.toIntervalEmptyPanics && dist > 0 {
+			return
+		}
+		ti := resample.ToInterval(ls.Clone(), planar.Distance, dist)
+		switch {
+		case dist <= 0:
+			if ti != nil {
+				col.failClass(ht, "interval-nonpositive", "ToInterval(%v, %v) = %v", ls, dist, ti)
+			}
+		case len(ls) <= 1:
+			if !same(ti, ls) && !(len(ls) == 0 && len(ti) == 0) {
+				col.failClass(ht, "interval-short", "ToInterval(%v, %v) = %v", ls, dist, ti)
+			}
+		default:
+			wantN := int(total/dist) + 1
+			if len(ti) != wantN {
+				col.failClass(ht, "interval-count", "ToInterval(%v, %v) = %v (%d points), want %d (length %v)", ls, dist, ti, len(ti), wantN, total)
+			} else if wantN > 1 && total > 0 {
+				// the spacing is total/(wantN-1), "about the given distance" (up to 2x it)
+				if ti[0] != ls[0] || ti[wantN-1] != ls[len(ls)-1] {
+					col.failClass(ht, "interval-ends", "ToInterval(%v, %v) = %v", ls, dist, ti)
+				}
+			}
+		}
+		col.count("ok")
+	})
+}
