+		if !planar.MultiPolygonContains(orb.MultiPolygon{poly}, p) {
+			t.Errorf("MultiPolygonContains(polygon with hole, %v on the hole boundary) = false", p)
+		}
+	}
+	if !planar.PolygonContains(poly, orb.Point{0, 3}) || planar.PolygonContains(poly, orb.Point{3, 3}) {
+		t.Errorf("the outer boundary or the hole interior misbehave")
