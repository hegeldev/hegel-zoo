+// orb/4: IsEmpty is documented true for a zero-area bound.
+func TestHegelPinIsEmptyZeroArea(t *testing.T) {
+	for _, b := range []orb.Bound{
+		{Min: orb.Point{1, 1}, Max: orb.Point{1, 1}},
+		{Min: orb.Point{1, 1}, Max: orb.Point{1, 5}},
+		{Min: orb.Point{1, 1}, Max: orb.Point{5, 1}},
+	} {
+		if !b.IsEmpty() {
+			t.Errorf("%v.IsEmpty() = false though its area is zero", b)
+		}
+	}
+	if b := (orb.Bound{Min: orb.Point{1, 1}, Max: orb.Point{0, 0}}); !b.IsEmpty() {
+		t.Errorf("%v.IsEmpty() = false", b)
+	}
+}
