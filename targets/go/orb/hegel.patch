+// withinBound reports whether every coordinate lies in the (closed) bound, within tol.
+func withinBound(g orb.Geometry, b orb.Bound, tol float64) bool {
+	for _, p := range coords(g) {
+		if p[0] < b.Min[0]-tol || p[0] > b.Max[0]+tol || p[1] < b.Min[1]-tol || p[1] > b.Max[1]+tol {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelClip: clip.MultiPoint keeps the points the bound contains; clipped lines and rings
+// lie in the bound, on the original, and measure (length, area) what shapely's intersection
+// with the box measures; clip.Geometry dispatches and unwraps single results.
+func TestHegelClip(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		b := genBound(ht)
+		if b.Min[0] == b.Max[0] {
+			b.Max[0] = round2(b.Max[0] + 1)
+		}
+		if b.Min[1] == b.Max[1] {
+			b.Max[1] = round2(b.Max[1] + 1)
+		}
+		if chance(ht, 30) { // a bound around the origin where the polygons are
+			b = orb.Bound{Min: orb.Point{-3, -3}, Max: orb.Point{float64(drawInt(ht, 0, 8)), float64(drawInt(ht, 0, 8))}}
+		}
+		g := genGeometry(ht, 2)
+		if chance(ht, 25) {
+			g = genLongLineString(ht, 8)
+		}
+		if p, ok := g.(orb.Polygon); ok && len(p) > 0 && chance(ht, 50) {
+			g = genPolygonAt(ht, 0, 0) // where the near-origin bounds cut it
+		}
+		orig := orb.Clone(g)
+		tol := 1e-9
+
+		switch gg := g.(type) {
+		case orb.MultiPoint:
+			res := clip.MultiPoint(b, gg)
+			var want orb.MultiPoint
+			for _, p := range gg {
+				if b.Contains(p) {
+					want = append(want, p)
+				}
+			}
+			if !same(res, want) && !(len(res) == 0 && len(want) == 0) {
+				col.failClass(ht, "multipoint", "clip.MultiPoint(%v, %v) = %v, want %v", b, gg, res, want)
+			}
+		case orb.LineString:
+			res := clip.LineString(b, gg.Clone())
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "line-outside", "clip.LineString(%v, %v) = %v has points outside", b, gg, res)
+			}
+			for _, p := range coords(res) {
+				if planar.DistanceFrom(gg, p) > 1e-7 {
+					col.failClass(ht, "line-off", "clip.LineString(%v, %v) = %v has a point off the line", b, gg, res)
+					break
+				}
+			}
+			for _, ls := range res {
+				if len(ls) < 2 {
+					col.failClass(ht, "line-short", "clip.LineString(%v, %v) = %v has a line of %d points", b, gg, res, len(ls))
+				}
+			}
+			if len(gg) > 0 {
+				r := shapelyClip(gg, b)
+				if r.Ok {
+					if !closeNum(planar.Length(res), num(r.Length), 1e-7, 1e-9) {
+						col.failClass(ht, "line-length", "clip.LineString(%v, %v) = %v, length %v, shapely %v", b, gg, res, planar.Length(res), num(r.Length))
+					}
+				}
+			}
+			// the Geometry dispatcher unwraps a single line
+			gres := clip.Geometry(b, gg.Clone())
+			switch len(res) {
+			case 0:
+				if gres != nil {
+					col.failClass(ht, "geometry-nil", "clip.Geometry(%v, %v) = %v, LineString gave nothing", b, gg, gres)
+				}
+			case 1:
+				if !same(gres, res[0]) {
+					col.failClass(ht, "geometry-unwrap", "clip.Geometry(%v, %v) = %v, want %v", b, gg, gres, res[0])
+				}
+			default:
+				if !same(gres, res) {
+					col.failClass(ht, "geometry-mls", "clip.Geometry(%v, %v) = %v, want %v", b, gg, gres, res)
+				}
+			}
+		case orb.MultiLineString:
+			res := clip.MultiLineString(b, gg.Clone())
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "mls-outside", "clip.MultiLineString(%v, %v) = %v has points outside", b, gg, res)
+			}
+			total := 0.0
+			for _, ls := range gg {
+				if len(ls) > 0 {
+					r := shapelyClip(ls, b)
+					if r.Ok {
+						total += num(r.Length)
+					}
+				}
+			}
+			if !closeNum(planar.Length(res), total, 1e-7, 1e-9) {
+				col.failClass(ht, "mls-length", "clip.MultiLineString(%v, %v) = %v, length %v, shapely %v", b, gg, res, planar.Length(res), total)
+			}
+		case orb.Polygon:
+			if len(gg) == 0 {
+				if res := clip.Polygon(b, gg); res != nil {
+					col.failClass(ht, "empty-polygon", "clip.Polygon(%v, empty) = %v", b, res)
+				}
+				break
+			}
+			res := clip.Polygon(b, gg.Clone())
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "polygon-outside", "clip.Polygon(%v, %v) = %v has points outside", b, gg, res)
+			}
+			r := shapelyClip(gg, b)
+			if r.Ok {
+				area := 0.0
+				if res != nil {
+					area = planar.Area(res)
+				}
+				if !closeNum(area, num(r.Area), 1e-7, 1e-9) {
+					col.failClass(ht, "polygon-area", "clip.Polygon(%v, %v) = %v, area %v, shapely %v", b, gg, res, area, num(r.Area))
+				}
+				if res != nil && len(res[0]) > 0 && res[0][0] != res[0][len(res[0])-1] {
+					col.failClass(ht, "polygon-open", "clip.Polygon(%v, %v) = %v: outer ring not closed", b, gg, res)
+				}
+			}
+			// the ring alone
+			rr := clip.Ring(b, gg[0].Clone())
+			r0 := shapelyClip(orb.Polygon{gg[0]}, b)
+			if r0.Ok {
+				area := 0.0
+				if rr != nil {
+					area = math.Abs(planar.Area(rr))
+				}
+				if !closeNum(area, num(r0.Area), 1e-7, 1e-9) {
+					col.failClass(ht, "ring-area", "clip.Ring(%v, %v) = %v, area %v, shapely %v", b, gg[0], rr, area, num(r0.Area))
+				}
+				if rr != nil && area > 1e-9 && rr.Orientation() != gg[0].Orientation() {
+					col.failClass(ht, "ring-orientation", "clip.Ring(%v, %v) = %v changed the orientation", b, gg[0], rr)
+				}
+			}
+		case orb.MultiPolygon:
+			res := clip.MultiPolygon(b, gg.Clone())
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "mp-outside", "clip.MultiPolygon(%v, %v) = %v has points outside", b, gg, res)
+			}
+			total := 0.0
+			for _, p := range gg {
+				r := shapelyClip(p, b)
+				if r.Ok {
+					total += num(r.Area)
+				}
+			}
+			area := 0.0
+			if res != nil {
+				area = planar.Area(res)
+			}
+			if !closeNum(area, total, 1e-7, 1e-9) {
+				col.failClass(ht, "mp-area", "clip.MultiPolygon(%v, %v) = %v, area %v, shapely %v", b, gg, res, area, total)
+			}
+		case orb.Collection:
+			res := clip.Collection(b, orb.Clone(gg).(orb.Collection))
+			if !withinBound(res, b, tol) {
+				col.failClass(ht, "collection-outside", "clip.Collection(%v, %v) = %v has points outside", b, gg, res)
+			}
+			if len(res) > len(gg) {
+				col.failClass(ht, "collection-count", "clip.Collection(%v, %v) = %v has more members", b, gg, res)
+			}
+		case orb.Point:
+			gres := clip.Geometry(b, gg)
+			if b.Contains(gg) != (gres != nil) || (gres != nil && !same(gres, gg)) {
+				col.failClass(ht, "point", "clip.Geometry(%v, %v) = %v", b, gg, gres)
+			}
+		}
+		// clip.Geometry: nil when the bounds do not meet, within the bound otherwise
+		gres := clip.Geometry(b, orb.Clone(g))
+		if !b.Intersects(g.Bound()) && gres != nil {
+			col.failClass(ht, "geometry-disjoint", "clip.Geometry(%v, %v) = %v though the bounds are disjoint", b, g, gres)
+		}
+		if gres != nil && !withinBound(gres, b, tol) {
+			col.failClass(ht, "geometry-outside", "clip.Geometry(%v, %v) = %v has points outside", b, g, gres)
+		}
+		_ = orig
+		col.count(g.GeoJSONType())
+	})
+}
+
+// subsequence reports whether sub is an in-order subsequence of ls.
+func subsequence(sub, ls orb.LineString) bool {
+	j := 0
+	for _, p := range sub {
+		for j < len(ls) && ls[j] != p {
+			j++
+		}
+		if j == len(ls) {
+			return false
+		}
+		j++
+	}
+	return true
+}
+
+// modelRadial is the radial simplification: keep a point when it is further than the
+// threshold from the last kept point; the last point is always kept.
+func modelRadial(ls orb.LineString, threshold float64) orb.LineString {
+	if len(ls) <= 2 {
+		return ls
+	}
+	out := orb.LineString{ls[0]}
+	current := 0
+	for i := 1; i < len(ls); i++ {
+		if pointDistance(ls[current], ls[i]) > threshold {
+			current = i
+			out = append(out, ls[i])
+		}
+	}
+	if current != len(ls)-1 {
+		out = append(out, ls[len(ls)-1])
+	}
+	return out
+}
+
+// TestHegelSimplify: Douglas-Peucker against shapely's; Radial against its model; Visvalingam's
+// point-count contracts; every simplifier keeps an in-order subsequence with the end points,
+// removed points within the threshold of the result (Douglas-Peucker), and the type rules of
+// Simplify.
+func TestHegelSimplify(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ls := genLongLineString(ht, 12)
+		threshold := float64(drawInt(ht, 0, 600)) / 100
+
+		// Douglas-Peucker
+		dp := simplify.DouglasPeucker(threshold).LineString(ls.Clone())
+		if !subsequence(dp, ls) || len(dp) < 2 || dp[0] != ls[0] || dp[len(dp)-1] != ls[len(ls)-1] {
+			col.failClass(ht, "dp-shape", "DouglasPeucker(%v) of %v = %v", threshold, ls, dp)
+		} else {
+			for _, p := range ls {
+				if planar.DistanceFrom(dp, p) > threshold+1e-9 {
+					col.failClass(ht, "dp-distance", "DouglasPeucker(%v) of %v = %v leaves %v at %v", threshold, ls, dp, p, planar.DistanceFrom(dp, p))
+					break
+				}
+			}
+			// a point within 1e-6 of the threshold from a chord decides differently in
+			// squared (orb) and plain (GEOS) distance: not compared
+			tie := false
+			for a := 0; a < len(ls); a++ {
+				for b := a + 2; b < len(ls); b++ {
+					for i := a + 1; i < b; i++ {
+						if math.Abs(planar.DistanceFromSegment(ls[a], ls[b], ls[i])-threshold) < 1e-6 {
+							tie = true
+						}
+					}
+				}
+			}
+			r := shapelySimplify(ls, threshold)
+			if r.Ok && !tie {
+				want := fromHexWKB(r.WKB)
+				if !same(dp, want) {
+					col.failClass(ht, "dp-shapely", "DouglasPeucker(%v) of %v = %v, shapely %v", threshold, ls, dp, want)
+				}
+			}
+		}
+
+		// Radial
+		rad := simplify.Radial(planar.Distance, threshold).LineString(ls.Clone())
+		if !same(rad, modelRadial(ls, threshold)) {
+			col.failClass(ht, "radial", "Radial(%v) of %v = %v, model %v", threshold, ls, rad, modelRadial(ls, threshold))
+		}
+
+		// Visvalingam
+		vt := simplify.VisvalingamThreshold(threshold).LineString(ls.Clone())
+		if !subsequence(vt, ls) || len(vt) < 2 || vt[0] != ls[0] || vt[len(vt)-1] != ls[len(ls)-1] {
+			col.failClass(ht, "vis-threshold", "VisvalingamThreshold(%v) of %v = %v", threshold, ls, vt)
+		}
+		keep := drawInt(ht, 0, 12)
+		if !(Known.visvalingamKeepOnePanics && keep == 1 && len(ls) > 2) {
+			vk := simplify.VisvalingamKeep(keep).LineString(ls.Clone())
+			wantN := keep
+			if keep < 2 {
+				wantN = 2 // the ends always stay
+			}
+			if wantN > len(ls) {
+				wantN = len(ls)
+			}
+			if len(vk) != wantN || !subsequence(vk, ls) {
+				col.failClass(ht, "vis-keep", "VisvalingamKeep(%d) of %v (%d points) = %v (%d points), want %d", keep, ls, len(ls), vk, len(vk), wantN)
+			}
+		}
+
+		// rings and polygons: the ring stays closed and a subsequence; holes reduced to nothing
+		// disappear; the type rules of Simplify
+		g := genAnyGeometry(ht)
+		s := pick(ht, []orb.Simplifier{simplify.DouglasPeucker(threshold), simplify.Radial(planar.Distance, threshold), simplify.VisvalingamThreshold(threshold)})
+		res := s.Simplify(orb.Clone(g))
+		switch gg := g.(type) {
+		case orb.Point, orb.Bound:
+			if !same(res, gg) {
+				col.failClass(ht, "simplify-point", "Simplify(%v) = %v", g, res)
+			}
+		case orb.MultiPoint:
+			if !same(res, gg) && !(len(gg) == 0 && res == nil) {
+				col.failClass(ht, "simplify-multipoint", "Simplify(%v) = %v", g, res)
+			}
+		case orb.LineString:
+			if len(gg) == 0 {
+				if res != nil {
+					col.failClass(ht, "simplify-empty", "Simplify(%v) = %v", g, res)
+				}
+			} else if r, ok := res.(orb.LineString); !ok || !subsequence(r, gg) || r[0] != gg[0] || r[len(r)-1] != gg[len(gg)-1] {
+				col.failClass(ht, "simplify-line", "Simplify(%v) = %v", g, res)
+			}
+		case orb.Ring:
+			if len(gg) == 0 {
+				if res != nil {
+					col.failClass(ht, "simplify-empty", "Simplify(%v) = %v", g, res)
+				}
+			} else if r, ok := res.(orb.Ring); !ok || !subsequence(orb.LineString(r), orb.LineString(gg)) || r[0] != gg[0] || r[len(r)-1] != gg[len(gg)-1] {
+				col.failClass(ht, "simplify-ring", "Simplify(%v) = %v", g, res)
+			}
+		case orb.Polygon:
+			if len(gg) == 0 {
+				if res != nil {
+					col.failClass(ht, "simplify-empty", "Simplify(%v) = %v", g, res)
+				}
+			} else if r, ok := res.(orb.Polygon); !ok || len(r) == 0 || len(r) > len(gg) || !subsequence(orb.LineString(r[0]), orb.LineString(gg[0])) {
+				col.failClass(ht, "simplify-polygon", "Simplify(%v) = %v", g, res)
+			} else {
+				for _, h := range r[1:] {
+					if len(h) <= 2 {
+						col.failClass(ht, "simplify-hole", "Simplify(%v) = %v keeps a hole of %d points", g, res, len(h))
+					}
+				}
+			}
+		}
+		col.count("ok")
+	})
+}
+
+// arcPos is the distance along ls of a point on it (the first segment within tol), or -1.
+func arcPos(ls orb.LineString, p orb.Point, tol float64) float64 {
+	pos := 0.0
+	for i := 0; i+1 < len(ls); i++ {
+		if planar.DistanceFromSegment(ls[i], ls[i+1], p) <= tol {
+			return pos + pointDistance(ls[i], p)
+		}
+		pos += pointDistance(ls[i], ls[i+1])
+	}
+	return -1
+}
+
+// TestHegelResample: Resample gives the asked number of points, the ends unchanged, evenly
+// spaced along the path; ToInterval spaces about the interval; edge cases per the doc comments.
+func TestHegelResample(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ls := genLongLineString(ht, 6)
+		if chance(ht, 10) {
+			ls = orb.LineString{}
+		} else if chance(ht, 10) {
+			p := genPoint(ht)
+			ls = orb.LineString{p}
+			for i := drawInt(ht, 0, 3); i > 0; i-- {
+				ls = append(ls, p)
+			}
+		}
+		n := drawInt(ht, -1, 12)
+		res := resample.Resample(ls.Clone(), planar.Distance, n)
+		total := planar.Length(ls)
+		switch {
+		case n <= 0:
+			if res != nil {
+				col.failClass(ht, "nonpositive", "Resample(%v, %d) = %v", ls, n, res)
+			}
+		case len(ls) <= 1:
+			if !same(res, ls) && !(len(ls) == 0 && len(res) == 0) {
+				col.failClass(ht, "short", "Resample(%v, %d) = %v", ls, n, res)
+			}
+		case total == 0: // all points equal: padded or truncated to n copies
+			if len(res) != n {
+				col.failClass(ht, "equal-points", "Resample(%v, %d) = %v", ls, n, res)
+			}
+			for _, p := range res {
+				if p != ls[0] {
+					col.failClass(ht, "equal-points", "Resample(%v, %d) = %v", ls, n, res)
+					break
+				}
+			}
+		default:
+			if len(res) != n {
+				col.failClass(ht, "count", "Resample(%v, %d) = %v (%d points)", ls, n, res, len(res))
+			} else if res[0] != ls[0] || (n > 1 && res[n-1] != ls[len(ls)-1]) {
+				col.failClass(ht, "ends", "Resample(%v, %d) = %v", ls, n, res)
+			} else if n > 1 {
+				step := total / float64(n-1)
+				for i, p := range res {
+					pos := arcPos(ls, p, 1e-7)
+					if pos < 0 || !closeNum(pos, float64(i)*step, 1e-6, 1e-9) {
+						// a point on a self-crossing gets the first crossing's position: accept
+						// when the distance from the path is fine and the neighbours are spaced
+						if planar.DistanceFrom(ls, p) > 1e-7 {
+							col.failClass(ht, "spacing", "Resample(%v, %d) = %v: point %d at %v off the path", ls, n, res, i, p)
+							break
+						}
+					}
+				}
+				for i := 1; i < n; i++ {
+					if d := pointDistance(res[i-1], res[i]); d > step+1e-7 {
+						col.failClass(ht, "chord", "Resample(%v, %d) = %v: chord %d is %v > step %v", ls, n, res, i, d, step)
+						break
+					}
+				}
+			}
+		}
+
+		// ToInterval
+		dist := float64(drawInt(ht, -1, 50)) / 10
+		if len(ls) == 0 && Known.toIntervalEmptyPanics && dist > 0 {
+			return
+		}
+		ti := resample.ToInterval(ls.Clone(), planar.Distance, dist)
+		switch {
+		case dist <= 0:
+			if ti != nil {
+				col.failClass(ht, "interval-nonpositive", "ToInterval(%v, %v) = %v", ls, dist, ti)
+			}
+		case len(ls) <= 1:
+			if !same(ti, ls) && !(len(ls) == 0 && len(ti) == 0) {
+				col.failClass(ht, "interval-short", "ToInterval(%v, %v) = %v", ls, dist, ti)
+			}
+		default:
+			wantN := int(total/dist) + 1
+			if len(ti) != wantN {
+				col.failClass(ht, "interval-count", "ToInterval(%v, %v) = %v (%d points), want %d (length %v)", ls, dist, ti, len(ti), wantN, total)
+			} else if wantN > 1 && total > 0 {
+				// the spacing is total/(wantN-1), "about the given distance" (up to 2x it)
+				if ti[0] != ls[0] || ti[wantN-1] != ls[len(ls)-1] {
+					col.failClass(ht, "interval-ends", "ToInterval(%v, %v) = %v", ls, dist, ti)
+				}
+			}
+		}
+		col.count("ok")
+	})
+}
diff --git a/hegel/hegel_oracle_test.go b/hegel/hegel_oracle_test.go
new file mode 100644
index 0000000..87fb1de
--- /dev/null
+++ b/hegel/hegel_oracle_test.go
@@ -0,0 +1,336 @@
+package hegel
+
+// The shapely oracle: a Python child process answering one JSON line per request. Requests are
+// "CMD hexarg hexarg ..." (arguments hex-encoded so that spaces and newlines are safe).
+// Geometries travel as ISO WKB, 2D, little-endian.
+
+import (
+	"bufio"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"strconv"
+	"sync"
+
+	"github.com/paulmach/orb"
+	"github.com/paulmach/orb/encoding/wkb"
+)
+
+const pythonScript = `
+import sys, json, math, faulthandler
+faulthandler.enable()
+import shapely
+from shapely.geometry import box as _box
+
+def hx(s):
+    return bytes.fromhex(s).decode()
+
+def wkb(g):
+    return shapely.to_wkb(g, byte_order=1, output_dimension=2, flavor="iso").hex()
+
+def wkt(g):
+    return shapely.to_wkt(g, rounding_precision=-1, trim=True)
+
+def fromwkb(h):
+    return shapely.from_wkb(bytes.fromhex(h))
+
+def num(x):
+    x = float(x)
+    if math.isnan(x):
+        return "NaN"
+    if math.isinf(x):
+        return "Inf" if x > 0 else "-Inf"
+    return x
+
+def bounds(g):
+    b = shapely.bounds(g).tolist()
+    return None if any(math.isnan(x) for x in b) else b
+
+def handle(cmd, a):
+    if cmd == "WKT":  # parse WKT
+        g = shapely.from_wkt(a[0])
+        return {"wkb": wkb(g), "wkt": wkt(g), "type": shapely.get_type_id(g).item()}
+    if cmd == "WKB":  # parse WKB
+        g = fromwkb(a[0])
+        return {"wkb": wkb(g), "wkt": wkt(g), "type": shapely.get_type_id(g).item()}
+    if cmd == "GJ":  # parse GeoJSON
+        g = shapely.from_geojson(a[0])
+        return {"wkb": wkb(g), "wkt": wkt(g), "type": shapely.get_type_id(g).item()}
+    if cmd == "TOGJ":  # GeoJSON text of a geometry
+        return {"geojson": shapely.to_geojson(fromwkb(a[0]))}
+    if cmd == "U":  # unary measures
+        g = fromwkb(a[0])
+        c = shapely.centroid(g)
+        return {"area": num(shapely.area(g)), "length": num(shapely.length(g)), "bounds": bounds(g),
+                "empty": bool(shapely.is_empty(g)), "valid": bool(shapely.is_valid(g)),
+                "centroid": None if shapely.is_empty(c) else [c.x, c.y]}
+    if cmd == "PT":  # a geometry against a point
+        g, p = fromwkb(a[0]), fromwkb(a[1])
+        b = shapely.boundary(g) if shapely.get_type_id(g) in (3, 6) else g
+        return {"covers": bool(shapely.covers(g, p)), "contains": bool(shapely.contains(g, p)),
+                "distance": num(shapely.distance(g, p)), "touches": bool(shapely.touches(g, p)),
+                "bdist": num(shapely.distance(b, p))}
+    if cmd == "S":  # Douglas-Peucker without topology preservation
+        return {"wkb": wkb(shapely.simplify(fromwkb(a[0]), float(a[1]), preserve_topology=False))}
+    if cmd == "CLIP":  # intersection with a box
+        g = fromwkb(a[0])
+        b = _box(float(a[1]), float(a[2]), float(a[3]), float(a[4]))
+        r = shapely.intersection(g, b)
+        return {"wkb": wkb(r), "area": num(shapely.area(r)), "length": num(shapely.length(r)),
+                "intersects": bool(shapely.intersects(g, b))}
+    if cmd == "EQ":  # do two geometries agree
+        g, h = fromwkb(a[0]), fromwkb(a[1])
+        tol = float(a[2])
+        r = {"exact": bool(shapely.equals_exact(shapely.normalize(g), shapely.normalize(h), tol)),
+             "both_empty": bool(shapely.is_empty(g) and shapely.is_empty(h))}
+        try:
+            r["topo"] = bool(shapely.equals(g, h))
+        except Exception as e:
+            r["topo_error"] = str(e)[:200]
+        try:
+            d = shapely.symmetric_difference(g, h)
+            r["symdiff_area"] = num(shapely.area(d))
+            r["symdiff_length"] = num(shapely.length(d))
+        except Exception as e:
+            r["symdiff_error"] = str(e)[:200]
+        return r
+    return {"ok": False, "error": "unknown command " + cmd}
+
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [hx(p) for p in parts[1:]]
+    try:
+        reply = handle(cmd, args)
+        reply.setdefault("ok", True)
+    except Exception as e:
+        reply = {"ok": False, "error": type(e).__name__, "message": str(e)[:300]}
+    print(json.dumps(reply), flush=True)
+`
+
+type pyChild struct {
+	mu    sync.Mutex
+	cmd   *exec.Cmd
+	stdin *bufio.Writer
+	out   *bufio.Reader
+}
+
+var (
+	pyOnce sync.Once
+	py     *pyChild
+)
+
+func oracle() *pyChild {
+	pyOnce.Do(func() {
+		python := "python3"
+		if p := os.Getenv("HEGEL_PYTHON"); p != "" {
+			python = p
+		}
+		cmd := exec.Command(python, "-u", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			panic(err)
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			panic(err)
+		}
+		if err := cmd.Start(); err != nil {
+			panic(fmt.Sprintf("python3 with shapely is needed as the oracle: %v", err))
+		}
+		py = &pyChild{cmd: cmd, stdin: bufio.NewWriter(in), out: bufio.NewReader(out)}
+	})
+	return py
+}
+
+// reply is the common part of every oracle answer.
+type reply struct {
+	Ok      bool   `json:"ok"`
+	Error   string `json:"error"`
+	Message string `json:"message"`
+}
+
+// geomReply carries one geometry (or the error computing it).
+type geomReply struct {
+	reply
+	WKB  string `json:"wkb"`
+	WKT  string `json:"wkt"`
+	Type int    `json:"type"`
+}
+
+type geojsonReply struct {
+	reply
+	GeoJSON string `json:"geojson"`
+}
+
+type unaryReply struct {
+	reply
+	Area     json.RawMessage `json:"area"`
+	Length   json.RawMessage `json:"length"`
+	Bounds   []float64       `json:"bounds"`
+	Empty    bool            `json:"empty"`
+	Valid    bool            `json:"valid"`
+	Centroid []float64       `json:"centroid"`
+}
+
+type pointReply struct {
+	reply
+	Covers   bool            `json:"covers"`
+	Contains bool            `json:"contains"`
+	Touches  bool            `json:"touches"`
+	Distance json.RawMessage `json:"distance"`
+	BDist    json.RawMessage `json:"bdist"` // distance to the boundary for polygons, to the geometry otherwise
+}
+
+type clipReply struct {
+	reply
+	WKB        string          `json:"wkb"`
+	Area       json.RawMessage `json:"area"`
+	Length     json.RawMessage `json:"length"`
+	Intersects bool            `json:"intersects"`
+}
+
+type eqReply struct {
+	reply
+	Exact         bool            `json:"exact"`
+	BothEmpty     bool            `json:"both_empty"`
+	Topo          *bool           `json:"topo"`
+	TopoError     string          `json:"topo_error"`
+	SymdiffArea   json.RawMessage `json:"symdiff_area"`
+	SymdiffLength json.RawMessage `json:"symdiff_length"`
+	SymdiffError  string          `json:"symdiff_error"`
+}
+
+func ask(v interface{}, cmd string, args ...string) {
+	p := oracle()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	line := cmd
+	for _, a := range args {
+		line += " " + hex.EncodeToString([]byte(a))
+	}
+	p.stdin.WriteString(line + "\n")
+	if err := p.stdin.Flush(); err != nil {
+		py, pyOnce = nil, sync.Once{}
+		panic(fmt.Sprintf("shapely oracle gone (%v) at %s %s", err, cmd, summarize(args)))
+	}
+	raw, err := p.out.ReadBytes('\n')
+	if err != nil {
+		py, pyOnce = nil, sync.Once{}
+		panic(fmt.Sprintf("shapely oracle died on %s %s", cmd, summarize(args)))
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		panic(fmt.Sprintf("shapely oracle reply %q: %v", raw, err))
+	}
+}
+
+func summarize(args []string) string {
+	s := ""
+	for _, a := range args {
+		if len(a) > 400 {
+			a = a[:400] + "..."
+		}
+		s += " " + a
+	}
+	return s
+}
+
+// num decodes a JSON number the oracle sent, "NaN"/"Inf"/"-Inf" included.
+func num(raw json.RawMessage) float64 {
+	var f float64
+	if json.Unmarshal(raw, &f) == nil {
+		return f
+	}
+	var s string
+	if json.Unmarshal(raw, &s) == nil {
+		switch s {
+		case "NaN":
+			return math.NaN()
+		case "Inf":
+			return math.Inf(1)
+		case "-Inf":
+			return math.Inf(-1)
+		}
+	}
+	panic(fmt.Sprintf("oracle number %q", raw))
+}
+
+// hexWKB is the geometry as hex ISO WKB, little-endian, the form the oracle takes.
+func hexWKB(g orb.Geometry) string {
+	return hex.EncodeToString(wkb.MustMarshal(g, binary.LittleEndian))
+}
+
+// fromHexWKB decodes the oracle's geometry with orb's decoder (checked on its own by the WKB
+// property).
+func fromHexWKB(h string) orb.Geometry {
+	b, err := hex.DecodeString(h)
+	if err != nil {
+		panic(err)
+	}
+	g, err := wkb.Unmarshal(b)
+	if err != nil {
+		panic(fmt.Sprintf("oracle WKB %s: %v", h, err))
+	}
+	return g
+}
+
+func ftoa(f float64) string { return strconv.FormatFloat(f, 'g', -1, 64) }
+
+// shapelyGeom asks the oracle to parse a WKT text.
+func shapelyWKT(s string) geomReply {
+	var r geomReply
+	ask(&r, "WKT", s)
+	return r
+}
+
+func shapelyWKB(h string) geomReply {
+	var r geomReply
+	ask(&r, "WKB", h)
+	return r
+}
+
+func shapelyGeoJSON(s string) geomReply {
+	var r geomReply
+	ask(&r, "GJ", s)
+	return r
+}
+
+func shapelyToGeoJSON(g orb.Geometry) geojsonReply {
+	var r geojsonReply
+	ask(&r, "TOGJ", hexWKB(g))
+	return r
+}
+
+func shapelyUnary(g orb.Geometry) unaryReply {
+	var r unaryReply
+	ask(&r, "U", hexWKB(g))
+	return r
+}
+
+func shapelyPoint(g orb.Geometry, p orb.Point) pointReply {
+	var r pointReply
+	ask(&r, "PT", hexWKB(g), hexWKB(p))
+	return r
+}
+
+func shapelySimplify(g orb.Geometry, tol float64) geomReply {
+	var r geomReply
+	ask(&r, "S", hexWKB(g), ftoa(tol))
+	return r
+}
+
+func shapelyClip(g orb.Geometry, b orb.Bound) clipReply {
+	var r clipReply
+	ask(&r, "CLIP", hexWKB(g), ftoa(b.Min[0]), ftoa(b.Min[1]), ftoa(b.Max[0]), ftoa(b.Max[1]))
+	return r
+}
+
+func shapelyEqual(g, h orb.Geometry, tol float64) eqReply {
+	var r eqReply
+	ask(&r, "EQ", hexWKB(g), hexWKB(h), ftoa(tol))
+	return r
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..3dcea58
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,304 @@
+package hegel
+
+// Pins: one directed test per recorded bug, asserting the documented behaviour. They fail
+// while the bug exists (target.toml lists them as expected failures).
+
+import (
+	"encoding/json"
+	"math"
+	"strings"
+	"testing"
+
+	"github.com/paulmach/orb"
+	"github.com/paulmach/orb/encoding/wkt"
+	"github.com/paulmach/orb/geojson"
+	"github.com/paulmach/orb/maptile"
+	"github.com/paulmach/orb/maptile/tilecover"
+	"github.com/paulmach/orb/planar"
+	"github.com/paulmach/orb/quadtree"
+	"github.com/paulmach/orb/resample"
+	"github.com/paulmach/orb/simplify"
+)
+
+// orb/1: collection members separated by ", ", nested collections, EMPTY members, a space
+// before the collection's parenthesis.
+func TestHegelPinWKTCollectionMembers(t *testing.T) {
+	cases := map[string]orb.Geometry{
+		"GEOMETRYCOLLECTION(POINT(1 2), LINESTRING(3 4,5 6))":           orb.Collection{orb.Point{1, 2}, orb.LineString{{3, 4}, {5, 6}}},
+		"GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (3 4, 5 6))":       orb.Collection{orb.Point{1, 2}, orb.LineString{{3, 4}, {5, 6}}},
+		"GEOMETRYCOLLECTION (POINT (1 2))":                              orb.Collection{orb.Point{1, 2}},
+		"GEOMETRYCOLLECTION(POINT(1 2),GEOMETRYCOLLECTION(POINT(3 4)))": orb.Collection{orb.Point{1, 2}, orb.Collection{orb.Point{3, 4}}},
+		"GEOMETRYCOLLECTION(MULTIPOINT EMPTY,POINT(1 2))":               orb.Collection{orb.MultiPoint{}, orb.Point{1, 2}},
+		"GEOMETRYCOLLECTION(POINT(1 2),MULTIPOINT EMPTY)":               orb.Collection{orb.Point{1, 2}, orb.MultiPoint{}},
+		"GEOMETRYCOLLECTION(LINESTRING EMPTY)":                          orb.Collection{orb.LineString{}},
+	}
+	for s, want := range cases {
+		got, err := wkt.Unmarshal(s)
+		if err != nil {
+			t.Errorf("Unmarshal(%q) = %v", s, err)
+		} else if !same(got, want) {
+			t.Errorf("Unmarshal(%q) = %v, want %v", s, got, want)
+		}
+	}
+	// and a prefix must not parse
+	if g, err := wkt.Unmarshal("GEOMETRYCOLLECTION(GEOMETRYCOLLECTION EMPTY,"); err == nil {
+		t.Errorf("Unmarshal of a truncated collection = %v", g)
+	}
