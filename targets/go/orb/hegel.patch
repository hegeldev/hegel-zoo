+		"one point":     {orb.Collection{orb.Point{3, 4}}, orb.Point{3, 4}},
+		"two points":    {orb.Collection{orb.Point{2, 2}, orb.Point{4, 4}}, orb.Point{3, 3}},
+		"a line":        {orb.Collection{orb.LineString{{0, 0}, {10, 0}}}, orb.Point{5, 0}},
+		"empty polygon": {orb.Collection{orb.Polygon{}, orb.Point{3, 4}}, orb.Point{3, 4}},
+	}
+	for name, tc := range cases {
+		c, _ := planar.CentroidArea(tc.g)
+		if !closePoints(c, tc.want, 1e-9) {
+			t.Errorf("%s: CentroidArea(%v) = %v, want %v", name, tc.g, c, tc.want)
+		}
+	}
+}
+
+// orb/13: VisvalingamKeep(1) keeps the two ends of a line (it cannot keep fewer).
+func TestHegelPinVisvalingamKeepOne(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("VisvalingamKeep(1) panicked: %v", r)
+		}
+	}()
+	ls := orb.LineString{{0, 0}, {1, 1}, {2, 0}}
+	got := simplify.VisvalingamKeep(1).LineString(ls.Clone())
+	if len(got) != 2 || got[0] != ls[0] || got[1] != ls[2] {
+		t.Errorf("VisvalingamKeep(1) of %v = %v", ls, got)
+	}
+	r := orb.Ring{{0, 0}, {1, 1}, {2, 0}, {1, -1}, {0, 0}}
+	if got := simplify.VisvalingamKeep(1).Ring(r.Clone()); len(got) < 2 {
+		t.Errorf("VisvalingamKeep(1) of ring %v = %v", r, got)
+	}
+}
+
+// orb/14: KNearest with k = 0 returns nothing.
+func TestHegelPinKNearestZero(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("KNearest(k = 0) panicked: %v", r)
+		}
+	}()
+	qt := quadtree.New(orb.Bound{Min: orb.Point{0, 0}, Max: orb.Point{10, 10}})
+	if err := qt.Add(orb.Point{1, 1}); err != nil {
+		t.Fatal(err)
+	}
+	if err := qt.Add(orb.Point{2, 2}); err != nil {
+		t.Fatal(err)
+	}
+	if got := qt.KNearest(nil, orb.Point{1, 1}, 0); len(got) != 0 {
+		t.Errorf("KNearest(k = 0) = %v", got)
+	}
+	if got := qt.KNearest(nil, orb.Point{1, 1}, 0, math.Inf(1)); len(got) != 0 {
+		t.Errorf("KNearest(k = 0, max distance) = %v", got)
+	}
+}
diff --git a/hegel/hegel_planar_test.go b/hegel/hegel_planar_test.go
new file mode 100644
index 0000000..50a74b2
--- /dev/null
+++ b/hegel/hegel_planar_test.go
@@ -0,0 +1,444 @@
+package hegel
+
+// Bounds, the planar package, orientation, rounding, cloning and equality.
+
+import (
+	"fmt"
+	"math"
+	"testing"
+
+	"github.com/paulmach/orb"
+	"github.com/paulmach/orb/planar"
+	"hegel.dev/go/hegel"
+)
+
+// shoelace is twice the signed area of a ring (positive counter-clockwise), exact for small
+// two-decimal coordinates up to floating error.
+func shoelace(r orb.Ring) float64 {
+	s := 0.0
+	n := len(r)
+	if n == 0 {
+		return 0
+	}
+	for i := 0; i < n; i++ {
+		a, b := r[i], r[(i+1)%n]
+		s += a[0]*b[1] - b[0]*a[1]
+	}
+	return s
+}
+
+// modelLength is the sum of the segment lengths of every line in the geometry.
+func modelLength(g orb.Geometry) float64 {
+	switch g := g.(type) {
+	case orb.Point, orb.MultiPoint:
+		return 0
+	case orb.LineString:
+		s := 0.0
+		for i := 1; i < len(g); i++ {
+			s += pointDistance(g[i-1], g[i])
+		}
+		return s
+	case orb.Ring:
+		return modelLength(orb.LineString(g))
+	case orb.MultiLineString:
+		s := 0.0
+		for _, ls := range g {
+			s += modelLength(ls)
+		}
+		return s
+	case orb.Polygon:
+		s := 0.0
+		for _, r := range g {
+			s += modelLength(r)
+		}
+		return s
+	case orb.MultiPolygon:
+		s := 0.0
+		for _, p := range g {
+			s += modelLength(p)
+		}
+		return s
+	case orb.Collection:
+		s := 0.0
+		for _, m := range g {
+			s += modelLength(m)
+		}
+		return s
+	case orb.Bound:
+		return modelLength(g.ToRing())
+	}
+	panic("modelLength")
+}
+
+// modelDistanceFrom is planar.DistanceFrom's contract: the distance to the boundary of a
+// polygon, to the geometry otherwise, the minimum over a collection's members (recursively);
+// shapely computes the leaves.
+func modelDistanceFrom(g orb.Geometry, p orb.Point) float64 {
+	switch gg := g.(type) {
+	case orb.Collection:
+		d := math.Inf(1)
+		for _, m := range gg {
+			d = math.Min(d, modelDistanceFrom(m, p))
+		}
+		return d
+	case orb.Bound:
+		return modelDistanceFrom(gg.ToPolygon(), p)
+	case orb.Ring:
+		return modelDistanceFrom(orb.LineString(gg), p)
+	}
+	if len(coords(g)) == 0 {
+		return math.Inf(1)
+	}
+	r := shapelyPoint(g, p)
+	if !r.Ok {
+		panic(fmt.Sprintf("shapely PT on %v: %s %s", g, r.Error, r.Message))
+	}
+	return num(r.BDist)
+}
+
+// pointOnRing draws a vertex of a ring, or (midpoints, for axis-parallel rings whose midpoints
+// are exactly on the edge) an edge midpoint.
+func pointOnRing(tc hegel.TestCase, r orb.Ring, midpoints bool) orb.Point {
+	i := drawInt(tc, 0, len(r)-2)
+	if !midpoints || chance(tc, 50) {
+		return r[i]
+	}
+	return orb.Point{(r[i][0] + r[i+1][0]) / 2, (r[i][1] + r[i+1][1]) / 2}
+}
+
+// onRing reports whether p is a vertex or an edge midpoint of the ring (what pointOnRing draws).
+func onRing(p orb.Point, r orb.Ring) bool {
+	for i := 0; i < len(r)-1; i++ {
+		if p == r[i] || p == (orb.Point{(r[i][0] + r[i+1][0]) / 2, (r[i][1] + r[i+1][1]) / 2}) {
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelPlanar: area, length, centroid and distance against shapely (and exact models),
+// point-in-ring/polygon against shapely's covers, orientation against the shoelace sign.
+func TestHegelPlanar(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		g := genAnyGeometry(ht)
+		u := shapelyUnary(asGeoJSONType(g))
+		if !u.Ok {
+			col.fail(ht, "shapely on %v: %s %s", g, u.Error, u.Message)
+			return
+		}
+
+		// area and length
+		area := planar.Area(g)
+		wantArea := num(u.Area)
+		if r, ok := g.(orb.Ring); ok {
+			// a ring's area is signed
+			if (shoelace(r) < 0) != (area < 0) && area != 0 {
+				col.failClass(ht, "ring-area-sign", "Area(%v) = %v, shoelace %v", r, area, shoelace(r))
+			}
+			area = math.Abs(area)
+		}
+		if !closeNum(area, wantArea, 1e-9, 1e-9) {
+			col.failClass(ht, "area", "Area(%v) = %v, shapely %v", g, area, wantArea)
+		}
+		length := planar.Length(g)
+		if !closeNum(length, num(u.Length), 1e-9, 1e-9) || !closeNum(length, modelLength(g), 1e-9, 1e-9) {
+			col.failClass(ht, "length", "Length(%v) = %v, shapely %v, model %v", g, length, num(u.Length), modelLength(g))
+		}
+
+		// centroid (of the highest-dimension members, as GEOS)
+		cen, area2 := planar.CentroidArea(g)
+		if _, ok := g.(orb.Ring); !ok && area2 != planar.Area(g) {
+			col.failClass(ht, "centroid-area", "CentroidArea(%v) area %v, Area %v", g, area2, planar.Area(g))
+		}
+		if u.Centroid != nil {
+			want := orb.Point{u.Centroid[0], u.Centroid[1]}
+			degenerateRing := false
+			switch gg := g.(type) {
+			case orb.Ring:
+				degenerateRing = shoelace(gg) == 0
+			case orb.Bound:
+				degenerateRing = gg.Min[0] == gg.Max[0] || gg.Min[1] == gg.Max[1]
+			}
+			if Known.degenerateRingCentroid && degenerateRing {
+				want = coords(g)[0] // the first point (a Bound: its Min)
+			}
+			if _, isCol := g.(orb.Collection); isCol && Known.collectionCentroidByArea && planar.Area(g) == 0 {
+				want = orb.Point{} // the origin: weights are areas
+			}
+			if !closePoints(cen, want, 1e-7) {
+				col.failClass(ht, "centroid", "CentroidArea(%#v) centroid %v, shapely %v", g, cen, want)
+			}
+		}
+
+		// distances
+		p := genPoint(ht)
+		q := genPoint(ht)
+		if d := planar.Distance(p, q); !closeNum(d, math.Hypot(p[0]-q[0], p[1]-q[1]), 0, 1e-14) || planar.DistanceSquared(p, q) != (p[0]-q[0])*(p[0]-q[0])+(p[1]-q[1])*(p[1]-q[1]) {
+			col.failClass(ht, "distance", "Distance(%v, %v) = %v", p, q, d)
+		}
+		if len(coords(g)) > 0 {
+			if chance(ht, 30) {
+				cs := coords(g)
+				p = cs[drawInt(ht, 0, len(cs)-1)]
+			}
+			r := shapelyPoint(asGeoJSONType(g), p)
+			if r.Ok {
+				d := planar.DistanceFrom(g, p)
+				want := modelDistanceFrom(g, p)
+				if !closeNum(d, want, 1e-9, 1e-9) {
+					col.failClass(ht, "distance-from", "DistanceFrom(%v, %v) = %v, shapely %v", g, p, d, want)
+				}
+				d2, idx := planar.DistanceFromWithIndex(g, p)
+				if d2 != d {
+					col.failClass(ht, "distance-from-index", "DistanceFromWithIndex(%v, %v) = %v, DistanceFrom %v", g, p, d2, d)
+				}
+				switch gg := g.(type) {
+				case orb.MultiPoint:
+					if idx < 0 || idx >= len(gg) || !closeNum(pointDistance(gg[idx], p), d, 0, 1e-14) {
+						col.failClass(ht, "index", "DistanceFromWithIndex(%v, %v) index %d", g, p, idx)
+					}
+				case orb.MultiLineString, orb.MultiPolygon, orb.Collection:
+					n := 0
+					switch gg := gg.(type) {
+					case orb.MultiLineString:
+						n = len(gg)
+					case orb.MultiPolygon:
+						n = len(gg)
+					case orb.Collection:
+						n = len(gg)
+					}
+					if idx < 0 || idx >= n {
+						col.failClass(ht, "index", "DistanceFromWithIndex(%v, %v) index %d of %d", g, p, idx, n)
+					}
+				}
+			}
+		}
+		// segment distance against the projection model
+		a, b := genPoint(ht), genPoint(ht)
+		if a != b {
+			vx, vy := b[0]-a[0], b[1]-a[1]
+			tt := ((p[0]-a[0])*vx + (p[1]-a[1])*vy) / (vx*vx + vy*vy)
+			tt = math.Max(0, math.Min(1, tt))
+			cp := orb.Point{a[0] + tt*vx, a[1] + tt*vy}
+			want := pointDistance(cp, p)
+			if d := planar.DistanceFromSegment(a, b, p); !closeNum(d, want, 1e-9, 1e-9) {
+				col.failClass(ht, "segment", "DistanceFromSegment(%v, %v, %v) = %v, want %v", a, b, p, d, want)
+			}
+		}
+
+		// point in ring / polygon
+		var poly orb.Polygon
+		switch gg := g.(type) {
+		case orb.Polygon:
+			poly = gg
+		case orb.Ring:
+			if len(gg) > 0 {
+				poly = orb.Polygon{gg}
+			}
+		case orb.Bound:
+			poly = gg.ToPolygon()
+		}
+		if len(poly) > 0 {
+			pt := genPoint(ht)
+			switch drawInt(ht, 0, 3) {
+			case 0:
+				pt = pointOnRing(ht, poly[0], false)
+			case 1:
+				if len(poly) > 1 {
+					pt = pointOnRing(ht, poly[drawInt(ht, 1, len(poly)-1)], true)
+				}
+			case 2:
+				pt = poly[0].Bound().Center()
+			}
+			r := shapelyPoint(poly, pt)
+			if r.Ok {
+				want := r.Covers
+				onHole := false
+				for _, h := range poly[1:] {
+					if onRing(pt, h) {
+						onHole = true
+					}
+				}
+				if Known.holeBoundaryNotContained && onHole && !onRing(pt, poly[0]) {
+					want = false
+				}
+				if got := planar.PolygonContains(poly, pt); got != want {
+					col.failClass(ht, "polygon-contains", "PolygonContains(%v, %v) = %v, shapely covers %v", poly, pt, got, r.Covers)
+				}
+				if got := planar.MultiPolygonContains(orb.MultiPolygon{poly}, pt); got != want {
+					col.failClass(ht, "multipolygon-contains", "MultiPolygonContains({%v}, %v) = %v, want %v", poly, pt, got, want)
+				}
+			}
+			ri := drawInt(ht, 0, len(poly)-1)
+			rr := shapelyPoint(orb.Polygon{poly[ri]}, pt)
+			if rr.Ok {
+				if got := planar.RingContains(poly[ri], pt); got != rr.Covers {
+					col.failClass(ht, "ring-contains", "RingContains(%v, %v) = %v, shapely covers %v", poly[ri], pt, got, rr.Covers)
+				}
+			}
+			// orientation
+			for _, r := range poly {
+				s := shoelace(r)
+				want := orb.CCW
+				if s < 0 {
+					want = orb.CW
+				}
+				if s != 0 && r.Orientation() != want {
+					col.failClass(ht, "orientation", "%v.Orientation() = %v, shoelace %v", r, r.Orientation(), s)
+				}
+				rc := r.Clone()
+				rc.Reverse()
+				if s != 0 && rc.Orientation() != -want {
+					col.failClass(ht, "orientation-reverse", "reversed %v.Orientation() = %v", r, rc.Orientation())
+				}
+				if !r.Closed() {
+					col.failClass(ht, "closed", "%v.Closed() = false", r)
+				}
+			}
+		}
+		col.count(g.GeoJSONType())
+	})
+}
+
+// TestHegelRoundCloneEqual: Round rounds every coordinate to the factor (default 1e6) and is
+// idempotent; Clone shares nothing with the original; Equal is structural.
+func TestHegelRoundCloneEqual(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		g := genAnyGeometry(ht)
+		// perturb a copy to get non-rounded coordinates
+		h := orb.Clone(g)
+		if !orb.Equal(g, h) || !same(g, h) {
+			col.failClass(ht, "clone-equal", "Clone(%v) = %v", g, h)
+		}
+		cs := coords(h)
+		if len(cs) > 0 && h.GeoJSONType() != "Point" {
+			if _, isB := h.(orb.Bound); !isB {
+				// mutate the clone's first coordinate in place
+				mutateFirst(h, 1e-3)
+				if same(g, h) || orb.Equal(g, h) {
+					col.failClass(ht, "clone-shared", "mutating the clone of %v changed the original", g)
+				}
+				if same(g, orb.Clone(g)) == false {
+					col.failClass(ht, "clone-after", "Clone(%v) differs after the first clone was mutated", g)
+				}
+			}
+		}
+		factor := pick(ht, []int{1, 10, 100, 1000, 1000000})
+		var rounded orb.Geometry
+		if factor == 1000000 && chance(ht, 50) {
+			rounded = orb.Round(orb.Clone(g))
+		} else {
+			rounded = orb.Round(orb.Clone(g), factor)
+		}
+		rc := coords(rounded)
+		oc := coords(g)
+		if len(rc) != len(oc) || rounded.GeoJSONType() != g.GeoJSONType() {
+			col.failClass(ht, "round-shape", "Round(%v, %d) = %v", g, factor, rounded)
+		} else {
+			f := float64(factor)
+			for i := range rc {
+				want := orb.Point{math.Round(oc[i][0]*f) / f, math.Round(oc[i][1]*f) / f}
+				if rc[i] != want {
+					col.failClass(ht, "round", "Round(%v, %d) coordinate %d = %v, want %v", g, factor, i, rc[i], want)
+					break
+				}
+			}
+		}
+		if again := orb.Round(orb.Clone(rounded), factor); !same(again, rounded) {
+			col.failClass(ht, "round-idempotent", "Round twice of %v with %d: %v then %v", g, factor, rounded, again)
+		}
+		// types and dimensions
+		wantDim := map[string]int{"Point": 0, "MultiPoint": 0, "LineString": 1, "MultiLineString": 1, "Polygon": 2, "MultiPolygon": 2}
+		if d, ok := wantDim[g.GeoJSONType()]; ok && g.Dimensions() != d {
+			col.failClass(ht, "dimensions", "%v.Dimensions() = %d", g, g.Dimensions())
+		}
+		if c, ok := g.(orb.Collection); ok {
+			max := -1 // the empty collection: no dimension
+			for _, m := range c {
+				if m.Dimensions() > max {
+					max = m.Dimensions()
+				}
+			}
+			if c.Dimensions() != max {
+				col.failClass(ht, "dimensions", "%v.Dimensions() = %d, want %d", g, c.Dimensions(), max)
+			}
+		}
+		if _, ok := g.(orb.Ring); ok && (g.GeoJSONType() != "Polygon" || g.Dimensions() != 2) {
+			col.failClass(ht, "ring-type", "Ring type %s dim %d", g.GeoJSONType(), g.Dimensions())
+		}
+		// Equal against a different geometry of the same type
+		h2 := genAnyGeometry(ht)
+		if orb.Equal(g, h2) != same(g, h2) {
+			col.failClass(ht, "equal", "Equal(%v, %v) = %v, structural %v", g, h2, orb.Equal(g, h2), same(g, h2))
+		}
+		// LineString.Reverse twice is the identity, once reverses
+		if ls, ok := g.(orb.LineString); ok && len(ls) > 0 {
+			r := ls.Clone()
+			r.Reverse()
+			for i := range ls {
+				if r[i] != ls[len(ls)-1-i] {
+					col.failClass(ht, "reverse", "%v reversed is %v", ls, r)
+					break
+				}
+			}
+			r.Reverse()
+			if !same(r, ls) {
+				col.failClass(ht, "reverse-twice", "%v reversed twice is %v", ls, r)
+			}
+		}
+		col.count("ok")
+	})
+}
+
+// mutateFirst adds d to the first coordinate found in the geometry (in place).
+func mutateFirst(g orb.Geometry, d float64) {
+	switch g := g.(type) {
+	case orb.MultiPoint:
+		if len(g) > 0 {
+			g[0][0] += d
+		}
+	case orb.LineString:
+		if len(g) > 0 {
+			g[0][0] += d
+		}
+	case orb.Ring:
+		if len(g) > 0 {
+			g[0][0] += d
+		}
+	case orb.MultiLineString:
+		for _, ls := range g {
+			if len(ls) > 0 {
+				ls[0][0] += d
+				return
+			}
+		}
+	case orb.Polygon:
+		for _, r := range g {
+			if len(r) > 0 {
+				r[0][0] += d
+				return
+			}
+		}
+	case orb.MultiPolygon:
+		for _, p := range g {
+			if len(coords(p)) > 0 {
+				mutateFirst(p, d)
+				return
+			}
+		}
+	case orb.Collection:
+		for i, m := range g {
+			if len(coords(m)) > 0 {
+				if p, ok := m.(orb.Point); ok {
+					p[0] += d
+					g[i] = p
+					return
+				}
+				mutateFirst(m, d)
+				return
+			}
+		}
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..3dae899
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,698 @@
+package hegel
+
+// Hegel property tests for paulmach/orb, written for the Hegel zoo. See targets/go/orb/README.md.
+//
+// Oracles: shapely 2.1.2 (GEOS 3.13.1) through a Python child process for the codecs (WKT,
+// WKB, GeoJSON), the planar measures (area, length, centroid, distance, point in polygon),
+// Douglas-Peucker simplification and clipping; models written from the doc comments for the
+// rest (bounds, map tiles, the quadtree, resampling, radial simplification, the geo formulas,
+// rounding, cloning and equality).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+//
+// The codec properties (hegel_codec_test.go) and the bounds property (hegel_bounds_test.go)
+// draw their cases as records from package-level generators (hegel_geometries_test.go),
+// judge the library against models that state the documented behaviour (every switch of the
+// known value below off) and name the shape of the recorded bug a case has before the
+// library is called (the harness in the second half of this file); their narrow companions
+// (hegel_codec_shapes_test.go, hegel_bounds_shapes_test.go) draw each shape on purpose. The
+// planar, clip, simplify, resample, maptile, quadtree, geo, project and round/clone/equal
+// properties still use the old generators (hegel_gen_test.go) and the old Known gates; part 2
+// of the rewrite replaces them.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hegelOpts passes HEGEL_TEST_CASES and HEGEL_SEED through to the engine, which reads no
+// environment variable itself (the seed is for the rate measurements of the collector).
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	return opts
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+//
+// part 2 replaces this: the property still follows the recorded bugs. The planar, clip,
+// simplify, resample, maptile, quadtree, geo, project and round/clone/equal properties read
+// these switches (all on) as today; the codec and bounds properties use the known value below
+// (every switch off by default) instead.
+var Known = struct {
+	// wkt.Unmarshal fails on a GEOMETRYCOLLECTION whose members are separated by ", " (a space
+	// after the comma), on a nested collection, and on an EMPTY member before another member;
+	// an EMPTY member after another member is dropped silently. The splitter for collection
+	// members looks for the first letter after a ")" and takes what came before it, minus one
+	// character, as the previous member.
+	wktCollectionMembers bool
+	// wkt.Unmarshal rejects two consecutive spaces between the coordinates of a point
+	// ("POINT(1  2)") or before EMPTY ("MULTIPOINT  EMPTY"), though WKT separates tokens by
+	// any whitespace.
+	wktWhitespace bool
+	// Bound.Extend and Bound.Union on an empty bound (Min > Max, as an empty geometry's Bound()
+	// returns) mix the empty bound's coordinates into the result, so the Bound() of a
+	// Collection, MultiLineString, Polygon or MultiPolygon whose first part is empty is wrong:
+	// Collection{MultiPoint{}, Point{5, 5}}.Bound() is [1 1]-[5 5].
+	unionOfEmptyBound bool
+	// Bound.IsEmpty is documented to be true for a bound of zero area; it is true only when
+	// Min > Max, so a point's bound is not empty.
+	isEmptyZeroArea bool
+	// maptile.At and Fraction do not clamp the longitude: At(Point{180, 0}, z) is X = 2^z, an
+	// invalid tile, though At is documented to create a valid tile for the zoom (and
+	// tilecover.Bound of a bound reaching longitude 180 lists those tiles).
+	tileAtLongitude180 bool
+	// planar.PolygonContains (and MultiPolygonContains) returns false for a point on the
+	// boundary of a hole, though "points on the boundary are considered in".
+	holeBoundaryNotContained bool
+	// resample.ToInterval panics (makeslice: len out of range) on an empty line string, where
+	// Resample returns it.
+	toIntervalEmptyPanics bool
+	// wkt.Marshal writes "()" for an empty part (an empty Ring: "POLYGON(())"; an empty
+	// LineString in a MultiLineString: "MULTILINESTRING((),(0 0,1 1))"), which is not WKT (the
+	// grammar has EMPTY there) and which no parser, orb's own included, reads.
+	emptyPartWKT bool
+	// geojson.NewGeometry of an empty Collection marshals to the JSON null (not a GeoJSON
+	// geometry object; UnmarshalGeometry rejects it), inside a collection's "geometries" too;
+	// and UnmarshalGeometry of a collection with a null member panics (nil pointer).
+	emptyCollectionGeoJSON bool
+	// a GeoJSON position with fewer than two numbers ([], [1]) is accepted as a point with
+	// zero coordinates instead of being rejected.
+	shortPositionAccepted bool
+	// planar.CentroidArea of a zero-area Ring (or of a degenerate Bound) returns the ring's
+	// first point, while the same ring inside a Polygon gets the centroid of its boundary line
+	// (as GEOS computes it).
+	degenerateRingCentroid bool
+	// planar.CentroidArea of a Collection weights its members by area only, so a collection
+	// of points or lines, or one whose only polygons are empty, has the origin as its
+	// centroid.
+	collectionCentroidByArea bool
+	// simplify.VisvalingamKeep(1) panics (nil pointer) on any line string or ring of three or
+	// more points: the loop pops an end point (area +Inf, not above the +Inf threshold) once
+	// only the two ends are left, and the end has no neighbour to relink.
+	visvalingamKeepOnePanics bool
+	// quadtree.KNearest (KNearestMatching) with k = 0 panics (index out of range) on a tree
+	// holding a point: the visitor pops the one heap element and reads the top of the empty
+	// heap.
+	kNearestZeroPanics bool
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// --------------------------------------------------------------------------- the harness of
+// the rewritten properties (the go/excelize, go/graphql-go, go/cobra, go/cascadia and
+// go/carbon judge; hegel_idioms_test.go has the generator idioms). hzProperty is property
+// with the wrapped hegel control-flow error let through; HEGEL_COLLECT=1 (or ZOO_COLLECT=1)
+// makes the properties record their mismatches instead of failing and print the counts. The
+// model of each family takes the set of recorded bugs it follows as a value (known); the
+// properties judge the library against the documented behaviour (hzKnownNone), name the
+// shape of the recorded bug a case has before the library is called (hzCaseJudge.Shape, from
+// the classifier shapeBy) and skip or drop the shapes under HEGEL_NO_KNOWN=1 (hzNoKnown).
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var hzCollecting = os.Getenv("HEGEL_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// note records a message of a class that is not a failure (a replica disagreement): counted,
+// and its first two messages kept.
+func (c *hzCollector) note(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the constants below in
+// bug order (the id of a switch is "orb/<index+1>"). The model of each property is a pure
+// function of (case, known): with every switch off (hzKnownNone) it states the documented
+// behaviour (the doc comments, the WKT grammar, RFC 7946, the box of the coordinates), which
+// is what the properties judge the library against; with a switch on it reproduces that bug
+// as a replica of the library's rule, transcribed from its code. The classifier of each
+// property runs the model with several sets to name the shape of a case before the library is
+// called; the pins assert the documented behaviour and fail while the bug exists. The codec
+// models follow 1, 2, 8, 9 and 10, the bounds model 3 and 4; the switches of 5, 6, 7 and
+// 11-14 act in no model yet (part 2: the part 2 properties follow the old Known struct).
+type known [14]bool
+
+const (
+	// orb/1: wkt.Unmarshal fails on a GEOMETRYCOLLECTION whose members are separated by ", "
+	// (a space after the comma), on a nested collection, and on an EMPTY member before
+	// another member; an EMPTY member after another member is dropped silently. The splitter
+	// for collection members looks for the first letter after a "(" and takes what came
+	// before it, minus one character, as the previous member.
+	kWktCollectionMembers = iota
+	// orb/2: wkt.Unmarshal rejects two consecutive spaces between the coordinates of a point
+	// ("POINT(1  2)") or before EMPTY ("MULTIPOINT  EMPTY"), though WKT separates tokens by
+	// any whitespace.
+	kWktWhitespace
+	// orb/3: Bound.Extend and Bound.Union on an empty bound (Min > Max, as an empty geometry's
+	// Bound() returns) mix the empty bound's coordinates into the result, so the Bound() of a
+	// Collection, MultiLineString, Polygon or MultiPolygon whose first part is empty is wrong:
+	// Collection{MultiPoint{}, Point{5, 5}}.Bound() is [1 1]-[5 5].
+	kUnionOfEmptyBound
+	// orb/4: Bound.IsEmpty is documented to be true for a bound of zero area; it is true only
+	// when Min > Max, so a point's bound is not empty.
+	kIsEmptyZeroArea
+	// orb/5: maptile.At and Fraction do not clamp the longitude: At(Point{180, 0}, z) is
+	// X = 2^z, an invalid tile, though At is documented to create a valid tile for the zoom
+	// (and tilecover.Bound of a bound reaching longitude 180 lists those tiles).
+	kTileAtLongitude180
+	// orb/6: planar.PolygonContains (and MultiPolygonContains) returns false for a point on
+	// the boundary of a hole, though "points on the boundary are considered in".
+	kHoleBoundaryNotContained
+	// orb/7: resample.ToInterval panics (makeslice: len out of range) on an empty line string,
+	// where Resample returns it.
+	kToIntervalEmptyPanics
+	// orb/8: wkt.Marshal writes "()" for an empty part (an empty Ring: "POLYGON(())"; an
+	// empty LineString in a MultiLineString: "MULTILINESTRING((),(0 0,1 1))"), which is not
+	// WKT (the grammar has EMPTY there) and which no parser, orb's own included, reads.
+	kEmptyPartWKT
+	// orb/9: geojson.NewGeometry of an empty Collection marshals to the JSON null (not a
+	// GeoJSON geometry object; UnmarshalGeometry rejects it), inside a collection's
+	// "geometries" too; and UnmarshalGeometry of a collection with a null member panics (nil
+	// pointer).
+	kEmptyCollectionGeoJSON
+	// orb/10: a GeoJSON position with fewer than two numbers ([], [1]) is accepted as a point
+	// with zero coordinates instead of being rejected.
+	kShortPositionAccepted
+	// orb/11: planar.CentroidArea of a zero-area Ring (or of a degenerate Bound) returns the
+	// ring's first point, while the same ring inside a Polygon gets the centroid of its
+	// boundary line (as GEOS computes it).
+	kDegenerateRingCentroid
+	// orb/12: planar.CentroidArea of a Collection weights its members by area only, so a
+	// collection of points or lines, or one whose only polygons are empty, has the origin as
+	// its centroid.
+	kCollectionCentroidByArea
+	// orb/13: simplify.VisvalingamKeep(1) panics (nil pointer) on any line string or ring of
+	// three or more points: the loop pops an end point (area +Inf, not above the +Inf
+	// threshold) once only the two ends are left, and the end has no neighbour to relink.
+	kVisvalingamKeepOnePanics
+	// orb/14: quadtree.KNearest (KNearestMatching) with k = 0 panics (index out of range) on a
+	// tree holding a point: the visitor pops the one heap element and reads the top of the
+	// empty heap.
+	kKNearestZeroPanics
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("orb/N"); hzKnownIndex the switch of a bug id (-1 for
+// none or the hole).
+func hzKnownID(i int) string { return "orb/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "orb/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape orb/N" per
+// case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape hole"), the cases skipped for them under HEGEL_NO_KNOWN=1 ("known
+// orb/N"), the checks dropped for them under HEGEL_NO_KNOWN=1 ("dropped orb/N"), the draws
+// hzOnly rejected ("filtered <name>"), the alternatives the generators drew ("drawn <name>",
+// for the realised rates), the replica's agreement with the library on the shaped cases
+// ("replica agreement", "replica disagreement"), the cases assumed away for a modelled-as-
+// recorded decision ("assumed <what>") and the cases skipped for an unrecorded candidate bug
+// ("candidate/go/orb-N"); printed and reset by the collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go, go/cobra,
+// go/cascadia and go/carbon judge, with the collector's mismatch classes): it names the
+// recorded bug whose shape the case has, so that a mismatch or a library panic fails "(the
+// shape of orb/N)", and under HEGEL_NO_KNOWN=1 skips the case instead (counted as known). The
+// wide and the narrow properties of a family share their judge function and so this. The
+// classifier that names the shape is computed from the case alone (the model run with several
+// sets of switches), before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are alternatives
+// of weight zero or filtered relations), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case (the
+// whitespace variants and shapely's text of a collection, whose other checks still hold): by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped orb/N") and the case goes on.
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (shared by every family; the go/carbon form).
+
+// checks is the set of values a model states or the library gives, by check name.
+type checks map[string]string
+
+func (c checks) set(name string, v any) { c[name] = fmt.Sprint(v) }
+
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// diffChecks lists the checks on which a and b differ.
+func diffChecks(a, b checks) string {
+	var parts []string
+	for _, k := range sortedKeys(a) {
+		if a[k] != b[k] {
+			parts = append(parts, fmt.Sprintf("%s: %s vs %s", k, a[k], b[k]))
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s: (none) vs %s", k, b[k]))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("orb/?", a defect of the model). The
+// order matters where two shapes meet (a collection with an empty ring member meets orb/1 and
+// orb/8): sufficiency in bug order names the lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "orb/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule.
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+	}
+	return shape
+}
+
+// verdict judges the library's values against the documented ones (the first difference
+// fails, naming the shape) after counting, on a shaped case, whether the replica (every
+// switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); sameChecks(got, replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.note("replica disagreement", "%#v: %s", c, diffChecks(got, replica))
+		}
+	}
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok {
+			j.Fail(k, "%s was not checked for %#v", k, c)
+		} else if g != want[k] {
+			j.Fail(k, "%s = %s, want %s for %#v", k, g, want[k], c)
+		}
+	}
+}
+
+// judgeBy is the judge of a family: the shape first, then the library.
+func judgeBy[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(c, expected)
+	j.Shape(shape)
+	want := expected(c, hzKnownNone)
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool { return shapeID(c, expected) == want })
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered orb/N" by the shape it had), g itself otherwise: the
+// safety net behind the generators' own exclusions, for a shape that is a relation of the
+// drawn values (a pad that makes a bound's area zero).
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
