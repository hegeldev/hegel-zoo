+func TestHegelCronKeepsItsEntriesWhileStopped(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		zone := pick(ht, zoneNames)
+		loc := loadZone(zone)
+		withSeconds := chance(ht, 50)
+		opts := []cron.Option{cron.WithLocation(loc)}
+		lay := layouts[0]
+		if withSeconds {
+			opts = append(opts, cron.WithSeconds())
+			lay = layouts[1]
+		}
+		c := cron.New(opts...)
+		if c.Location() != loc {
+			ht.Fatalf("Location() = %v, want %v", c.Location(), zone)
+		}
+		type modelEntry struct {
+			id   cron.EntryID
+			spec string
+		}
+		var model []modelEntry
+		var nextID cron.EntryID
+		for step, steps := 0, n(ht, 0, 8); step < steps; step++ {
+			switch n(ht, 0, 4) {
+			case 0, 1:
+				sc := genSpec(ht, lay)
+				id, err := c.AddFunc(sc.text, func() {})
+				if err != nil {
+					ht.Fatalf("AddFunc(%q): %v", sc.text, err)
+				}
+				nextID++
+				if id != nextID {
+					ht.Fatalf("AddFunc(%q) = id %d, want %d", sc.text, id, nextID)
+				}
+				model = append(model, modelEntry{id, sc.text})
+			case 2:
+				bad, why := genBadSpec(ht, lay)
+				if id, err := c.AddFunc(bad, func() {}); err == nil || id != 0 {
+					ht.Fatalf("AddFunc(%q) = %d, %v; the spec has a %s", bad, id, err, why)
+				}
+			case 3:
+				d := time.Duration(n(ht, 1, 3600)) * time.Second
+				id := c.Schedule(cron.Every(d), cron.FuncJob(func() {}))
+				nextID++
+				if id != nextID {
+					ht.Fatalf("Schedule = id %d, want %d", id, nextID)
+				}
+				model = append(model, modelEntry{id, "@every " + d.String()})
+			default:
+				var id cron.EntryID
+				if len(model) > 0 && chance(ht, 70) {
+					id = model[n(ht, 0, len(model)-1)].id
+				} else {
+					id = cron.EntryID(n(ht, 0, 12))
+				}
+				c.Remove(id)
+				var kept []modelEntry
+				for _, e := range model {
+					if e.id != id {
+						kept = append(kept, e)
+					}
+				}
+				model = kept
+			}
+		}
+		entries := c.Entries()
+		note(ht, "%d entries, model %v", len(entries), model)
+		if len(entries) != len(model) {
+			ht.Fatalf("Entries() has %d entries, want %d (%v)", len(entries), len(model), model)
+		}
+		for i, e := range entries {
+			if e.ID != model[i].id || !e.Valid() {
+				ht.Fatalf("Entries()[%d].ID = %d, want %d", i, e.ID, model[i].id)
+			}
+			if !e.Next.IsZero() || !e.Prev.IsZero() {
+				ht.Fatalf("entry %d has Next %v / Prev %v before Start", e.ID, e.Next, e.Prev)
+			}
+			if e.Job == nil || e.WrappedJob == nil || e.Schedule == nil {
+				ht.Fatalf("entry %d is missing its job or schedule: %+v", e.ID, e)
+			}
+			if got := c.Entry(e.ID); got.ID != e.ID {
+				ht.Fatalf("Entry(%d) = %+v", e.ID, got)
+			}
+		}
+		for id := cron.EntryID(0); id <= nextID+1; id++ {
+			present := false
+			for _, e := range model {
+				present = present || e.id == id
+			}
+			if got := c.Entry(id); got.Valid() != present {
+				ht.Fatalf("Entry(%d).Valid() = %v, want %v", id, got.Valid(), present)
+			}
+		}
+	})
+}
