+// ---- Every ---------------------------------------------------------------------------------
+
+func TestHegelEveryRoundsToWholeSeconds(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var d time.Duration
+		switch n(ht, 0, 2) {
+		case 0:
+			d = time.Duration(wide(ht, -2e9, 5e9))
+		case 1:
+			d = time.Duration(wide(ht, 0, 400*24)) * time.Hour
+		default:
+			d = time.Duration(wide(ht, 0, 1e12))
+		}
+		want := d
+		if want < time.Second {
+			want = time.Second
+		}
+		want -= want % time.Second
+		e := cron.Every(d)
+		note(ht, "Every(%v).Delay = %v", d, e.Delay)
+		if e.Delay != want {
+			ht.Fatalf("Every(%v).Delay = %v, want %v", d, e.Delay, want)
+		}
+		from := time.Unix(wide(ht, 0, 4e9), wide(ht, 0, 999999999)).In(loadZone(pick(ht, zoneNames)))
+		got := e.Next(from)
+		if wantNext := from.Truncate(time.Second).Add(want); !got.Equal(wantNext) || got.Nanosecond() != 0 {
+			ht.Fatalf("Every(%v).Next(%v) = %v, want %v", d, from, got, wantNext)
+		}
+		if text := d.String(); d > 0 {
+			sched, err := cron.ParseStandard("@every " + text)
+			if err != nil || sched != e {
+				ht.Fatalf("ParseStandard(%q) = %#v, %v; want %#v", "@every "+text, sched, err, e)
+			}
+		}
+	})
+}
