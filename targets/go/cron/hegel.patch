+// TestHegelChainWrapsInOrder: NewChain(m1, m2, m3).Then(job) runs m1 outermost, and Recover
+// swallows a panic and logs it.
+func TestHegelChainWrapsInOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var trace []string
+		count := n(ht, 0, 4)
+		var wrappers []cron.JobWrapper
+		for i := 0; i < count; i++ {
+			i := i
+			wrappers = append(wrappers, func(j cron.Job) cron.Job {
+				return cron.FuncJob(func() {
+					trace = append(trace, fmt.Sprintf("enter %d", i))
+					j.Run()
+					trace = append(trace, fmt.Sprintf("exit %d", i))
+				})
+			})
+		}
+		panics := chance(ht, 30)
+		logger := &recordingLogger{}
+		if panics {
+			wrappers = append([]cron.JobWrapper{cron.Recover(logger)}, wrappers...)
+		}
+		job := cron.NewChain(wrappers...).Then(cron.FuncJob(func() {
+			trace = append(trace, "job")
+			if panics {
+				panic("boom")
+			}
+		}))
+		job.Run()
+		var want []string
+		for i := 0; i < count; i++ {
+			want = append(want, fmt.Sprintf("enter %d", i))
+		}
+		want = append(want, "job")
+		if !panics {
+			for i := count - 1; i >= 0; i-- {
+				want = append(want, fmt.Sprintf("exit %d", i))
+			}
+		}
+		note(ht, "trace %v", trace)
+		if !reflect.DeepEqual(trace, want) {
+			ht.Fatalf("trace %v, want %v", trace, want)
+		}
+		if panics && (len(logger.lines) != 1 || !strings.HasPrefix(logger.lines[0], "error panic: boom")) {
+			ht.Fatalf("Recover logged %v", logger.lines)
+		}
+	})
+}
