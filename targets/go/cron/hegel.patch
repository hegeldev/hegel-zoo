+// Hegel property tests for github.com/robfig/cron/v3: the spec parser against a bit-set model of
+// the documented grammar (all field layouts, TZ prefixes, descriptors), SpecSchedule.Next against
+// an independent calendar model that enumerates wall-clock times in the schedule's zone (so DST
+// gaps and repeats are handled by definition), Every/ConstantDelaySchedule, and the entry
+// bookkeeping of a Cron that is not running.
+//
+// Every property draws one case record from generators that are package-level values (the spec
+// grammar is built once per parser layout, so the layout decides which alternatives exist) and
+// renders it with pure functions; the records carry a GoString for the draw report.
+package cron_test
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/robfig/cron/v3"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied.
+var positions = hegel.Integers(0, 99)
+
+// ---- the grammar model ---------------------------------------------------------------------
+
+const starBit = 1 << 63
+
+// fieldKind describes one of the six positions: its bounds and names (value = min + index).
+type fieldKind struct {
+	label    string
+	min, max int
+	names    []string
+	allowQ   bool
+}
+
+var (
+	kindSecond = fieldKind{"second", 0, 59, nil, false}
+	kindMinute = fieldKind{"minute", 0, 59, nil, false}
+	kindHour   = fieldKind{"hour", 0, 23, nil, false}
+	kindDom    = fieldKind{"dom", 1, 31, nil, true}
+	kindMonth  = fieldKind{"month", 1, 12, []string{"jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"}, false}
+	kindDow    = fieldKind{"dow", 0, 6, []string{"sun", "mon", "tue", "wed", "thu", "fri", "sat"}, true}
+	fieldKinds = []fieldKind{kindSecond, kindMinute, kindHour, kindDom, kindMonth, kindDow}
+)
+
+// rangeBits sets the bits lo, lo+step, ... up to hi.
+func rangeBits(lo, hi, step int) uint64 {
+	var bits uint64
+	for i := lo; i <= hi; i += step {
+		bits |= 1 << uint(i)
+	}
+	return bits
+}
+
+func allBits(k fieldKind) uint64 { return rangeBits(k.min, k.max, 1) | starBit }
+
+// defaultBits is what the parser fills in for a field the layout does not include.
+func defaultBits(i int) uint64 {
+	if i < 3 {
+		return 1 // "0"
+	}
+	return allBits(fieldKinds[i]) // "*"
+}
+
+// spelling is how a field value is written: the number, the number padded to two digits, or
+// (months and weekdays) its name with the letters of caseMask in upper case.
+type spelling struct {
+	kind     spellKind
+	caseMask int
+}
+
+type spellKind int
+
+const (
+	spellNumber spellKind = iota
+	spellPadded
+	spellName
+)
+
+func (s spelling) render(k fieldKind, v int) string {
+	switch s.kind {
+	case spellPadded:
+		return fmt.Sprintf("%02d", v)
+	case spellName:
+		b := []byte(k.names[v-k.min])
+		for i := range b {
+			if s.caseMask&(1<<i) != 0 {
+				b[i] -= 'a' - 'A'
+			}
+		}
+		return string(b)
+	}
+	return strconv.Itoa(v)
+}
+
+// spellings of the kind: the plain number, padded once in ten; with names, a name (in any
+// case) half of the time.
+func spellings(k fieldKind) hegel.Generator[spelling] {
+	number := hegel.Just(spelling{kind: spellNumber})
+	padded := hegel.Just(spelling{kind: spellPadded})
+	if k.names == nil {
+		return weighted(choice[spelling]{90, number}, choice[spelling]{10, padded})
+	}
+	named := hegel.Map(hegel.Integers(0, 7), func(m int) spelling { return spelling{spellName, m} })
+	return weighted(choice[spelling]{45, number}, choice[spelling]{5, padded}, choice[spelling]{50, named})
+}
+
+// item is one comma-separated item of a field:
+//
+//   - | ? | N | N-M | */S | N/S | N-M/S
+type item struct {
+	kind             itemKind
+	q                bool // the star written as "?" (dom and dow only)
+	lo, hi           int  // the value, or the ends of the range
+	loSpell, hiSpell spelling
+	step             int // 0 for none
+}
+
+type itemKind int
+
+const (
+	itemStar itemKind = iota
+	itemValue
+	itemRange
+)
+
+func (it item) render(k fieldKind) string {
+	var b strings.Builder
+	switch it.kind {
+	case itemStar:
+		if it.q {
+			b.WriteString("?")
+		} else {
+			b.WriteString("*")
+		}
+	case itemValue:
+		b.WriteString(it.loSpell.render(k, it.lo))
+	default:
+		b.WriteString(it.loSpell.render(k, it.lo) + "-" + it.hiSpell.render(k, it.hi))
+	}
+	if it.step > 0 {
+		b.WriteString("/" + strconv.Itoa(it.step))
+	}
+	return b.String()
+}
+
+// bits is the item's bit set: the star bit is set for "*" and "?" with no step or "/1" (the
+// library's rule), and cleared by a larger step.
+func (it item) bits(k fieldKind) uint64 {
+	step := max(it.step, 1)
+	switch it.kind {
+	case itemStar:
+		bits := rangeBits(k.min, k.max, step)
+		if step == 1 {
+			bits |= starBit
+		}
+		return bits
+	case itemValue:
+		if it.step > 0 {
+			return rangeBits(it.lo, k.max, step)
+		}
+		return 1 << uint(it.lo)
+	default:
+		return rangeBits(it.lo, it.hi, step)
+	}
+}
+
+// items of the kind: a star ("?" three times in ten where allowed), a value or a range, each
+// with a step (up to two beyond the range's width) seven times in twenty.
+func items(k fieldKind) hegel.Generator[item] {
+	vals := hegel.Integers(k.min, k.max)
+	spells := spellings(k)
+	steps := maybe(35, hegel.Integers(1, k.max-k.min+3))
+	var qs hegel.Generator[bool] = hegel.Just(false)
+	if k.allowQ {
+		qs = chance(30)
+	}
+	stars := hegel.Composite(func(tc hegel.TestCase) item {
+		return item{kind: itemStar, q: hegel.Draw(tc, qs), step: hegel.Draw(tc, steps)}
+	})
+	values := hegel.Composite(func(tc hegel.TestCase) item {
+		return item{kind: itemValue, lo: hegel.Draw(tc, vals), loSpell: hegel.Draw(tc, spells), step: hegel.Draw(tc, steps)}
+	})
+	ranges := hegel.Composite(func(tc hegel.TestCase) item {
+		a, b := hegel.Draw(tc, vals), hegel.Draw(tc, vals)
+		return item{kind: itemRange, lo: min(a, b), hi: max(a, b), loSpell: hegel.Draw(tc, spells), hiSpell: hegel.Draw(tc, spells), step: hegel.Draw(tc, steps)}
+	})
+	return hegel.OneOf(stars, values, ranges)
+}
+
+// field is a whole field: its kind (an index into fieldKinds) and one to three items.
+type field struct {
+	kind  int
+	items []item
+}
+
+func (f field) text() string {
+	parts := make([]string, len(f.items))
+	for i, it := range f.items {
+		parts[i] = it.render(fieldKinds[f.kind])
+	}
+	return strings.Join(parts, ",")
+}
+
+func (f field) bits() uint64 {
+	var bits uint64
+	for _, it := range f.items {
+		bits |= it.bits(fieldKinds[f.kind])
+	}
+	return bits
+}
+
+// fieldsOf is a field of each kind.
+var fieldsOf = func() (out [6]hegel.Generator[field]) {
+	for i, k := range fieldKinds {
+		out[i] = hegel.Map(many(items(k), 1, 3), func(is []item) field { return field{kind: i, items: is} })
+	}
+	return out
+}()
+
+// layout is a parser configuration: which fields it reads, which one is optional.
+type layout struct {
+	name        string
+	parser      cron.Parser
+	fields      []int // indices into fieldKinds, in order
+	optional    int   // index of the optional field, or -1
+	descriptors bool
+}
+
+var layouts = []layout{
+	{"standard", cron.NewParser(cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow | cron.Descriptor), []int{1, 2, 3, 4, 5}, -1, true},
+	{"seconds", cron.NewParser(cron.Second | cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow | cron.Descriptor), []int{0, 1, 2, 3, 4, 5}, -1, true},
+	{"secondOptional", cron.NewParser(cron.SecondOptional | cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow | cron.Descriptor), []int{0, 1, 2, 3, 4, 5}, 0, true},
+	{"dowOptional", cron.NewParser(cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.DowOptional), []int{1, 2, 3, 4, 5}, 5, false},
+	{"dateOnly", cron.NewParser(cron.Dom | cron.Month | cron.Dow), []int{3, 4, 5}, -1, false},
+	{"hourMinute", cron.NewParser(cron.Minute | cron.Hour), []int{1, 2}, -1, false},
+	{"descriptorsOnly", cron.NewParser(cron.Descriptor), nil, -1, true},
+}
+
+// present lists the fields of a spec of the layout, the optional one left out when omit is set.
+func (l layout) present(omit bool) []int {
+	var out []int
+	for _, i := range l.fields {
+		if !(omit && i == l.optional) {
+			out = append(out, i)
+		}
+	}
+	return out
+}
+
+// layoutIndex is an index into layouts (the standard parser first).
+var layoutIndex = hegel.SampledFrom([]int{0, 1, 2, 3, 4, 5, 6})
+
+// perLayout builds a generator for each layout, once.
+func perLayout[T any](build func(li int) hegel.Generator[T]) []hegel.Generator[T] {
+	out := make([]hegel.Generator[T], len(layouts))
+	for li := range layouts {
+		out[li] = build(li)
+	}
+	return out
+}
+
+// zoneNames are the IANA zones used for TZ prefixes and schedules.  None of them has a
+// transition at midnight (see the README: cron/2).
+var zoneNames = []string{"UTC", "Asia/Tokyo", "Asia/Kolkata", "America/New_York", "America/Los_Angeles", "Europe/London", "Europe/Berlin", "Australia/Sydney", "Australia/Lord_Howe", "Pacific/Chatham"}
+
+var zones = hegel.SampledFrom(zoneNames)
+
+func loadZone(name string) *time.Location {
+	loc, err := time.LoadLocation(name)
+	if err != nil {
+		panic(err)
+	}
+	return loc
+}
+
+// tzPrefix is a "TZ=" or "CRON_TZ=" prefix and its zone; the zero value is no prefix. It is
+// always followed by a single space: the prefix is cut at the first ' ' only (cron/5).
+type tzPrefix struct{ form, zone string }
+
+func (p tzPrefix) text() string {
+	if p.zone == "" {
+		return ""
+	}
+	return p.form + p.zone + " "
+}
+
+// prefixes: a prefix seven times in twenty.
+var prefixes = maybe(35, hegel.Composite(func(tc hegel.TestCase) tzPrefix {
+	return tzPrefix{form: hegel.Draw(tc, hegel.SampledFrom([]string{"TZ=", "CRON_TZ="})), zone: hegel.Draw(tc, zones)}
+}))
+
+// body is the fields of a spec of a layout, in order, the optional one left out when omit is set.
+type body struct {
+	omit   bool
+	fields []field
+}
+
+func (b body) texts() []string {
+	out := make([]string, len(b.fields))
+	for i, f := range b.fields {
+		out[i] = f.text()
+	}
+	return out
+}
+
+// bits is what the parser should make of the fields: the layout's defaults for the missing ones.
+func (b body) bits() [6]uint64 {
+	var out [6]uint64
+	for i := range out {
+		out[i] = defaultBits(i)
+	}
+	for _, f := range b.fields {
+		out[f.kind] = f.bits()
+	}
+	return out
+}
+
+func bodiesOf(li int) hegel.Generator[body] {
+	lay := layouts[li]
+	var omits hegel.Generator[bool] = hegel.Just(false)
+	if lay.optional >= 0 {
+		omits = chance(50)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) body {
+		b := body{omit: hegel.Draw(tc, omits)}
+		for _, k := range lay.present(b.omit) {
+			b.fields = append(b.fields, hegel.Draw(tc, fieldsOf[k]))
+		}
+		return b
+	})
+}
+
+// bodies is the fields of a spec of each layout.
+var bodies = perLayout(bodiesOf)
+
+var (
+	// gaps: a blank between fields other than the single space; blankTapes: the blanks of a
+	// spec's gaps in order, recycled modulo their number (an empty tape: single spaces).
+	gaps       = hegel.SampledFrom([]string{"  ", "\t", " \t "})
+	blankTapes = many(gaps, 0, 5)
+	// optGaps: a leading or trailing blank three times in twenty.
+	optGaps         = maybe(15, hegel.SampledFrom([]string{" ", "  ", "\t", " \t "}))
+	descriptorNames = hegel.SampledFrom([]string{"@yearly", "@annually", "@monthly", "@weekly", "@daily", "@midnight", "@hourly"})
+	everyTexts      = hegel.SampledFrom([]string{"1h30m", "90s", "2h", "1.5h", "500ms", "0s", "1h0m0s", "3600s", "1m1ms", "-1h", "2h45m30.5s"})
+)
+
+// spec is a valid spec of a layout: a prefix ("" for none) and either the fields with their
+// blanks, a named descriptor or an "@every" duration.
+type spec struct {
+	lay         int
+	prefix      tzPrefix
+	kind        specKind
+	name        string // specNamed
+	every       string // specEvery: the duration text
+	body        body   // specFields
+	blanks      []string
+	lead, trail string // a blank before the first field (only without a prefix) and after the last
+}
+
+type specKind int
+
+const (
+	specFields specKind = iota
+	specNamed
+	specEvery
+)
+
+func (s spec) text() string {
+	p := s.prefix.text()
+	switch s.kind {
+	case specNamed:
+		return p + s.name
+	case specEvery:
+		return p + "@every " + s.every
+	}
+	var b strings.Builder
+	b.WriteString(p)
+	if p == "" {
+		b.WriteString(s.lead)
+	}
+	for i, f := range s.body.texts() {
+		if i > 0 {
+			if len(s.blanks) == 0 {
+				b.WriteString(" ")
+			} else {
+				b.WriteString(s.blanks[(i-1)%len(s.blanks)])
+			}
+		}
+		b.WriteString(f)
+	}
+	b.WriteString(s.trail)
+	return b.String()
+}
+
+// bits is the model's answer for a fields or a named spec.
+func (s spec) bits() [6]uint64 {
+	if s.kind == specNamed {
+		return descriptorBits(s.name)
+	}
+	return s.body.bits()
+}
+
+func (s spec) GoString() string {
+	return fmt.Sprintf("%s parser, spec %q", layouts[s.lay].name, s.text())
+}
+
+// descriptorBits is the documented equivalent of a named descriptor.
+func descriptorBits(name string) [6]uint64 {
+	bits := [6]uint64{1, 1, 1, 1 << 1, 1 << 1, allBits(kindDow)}
+	switch name {
+	case "@monthly":
+		bits[4] = allBits(kindMonth)
+	case "@weekly":
+		bits[3], bits[4], bits[5] = allBits(kindDom), allBits(kindMonth), 1
+	case "@daily", "@midnight":
+		bits[3], bits[4] = allBits(kindDom), allBits(kindMonth)
+	case "@hourly":
+		bits[2], bits[3], bits[4] = allBits(kindHour), allBits(kindDom), allBits(kindMonth)
+	}
+	return bits
+}
+
+// everyDelay is the delay "@every d" documents: d truncated to the second, at least one second.
+func everyDelay(text string) time.Duration {
+	d, _ := time.ParseDuration(text)
+	if d < time.Second {
+		d = time.Second
+	}
+	return d - d%time.Second
+}
+
+func fieldSpecsOf(li int) hegel.Generator[spec] {
+	return hegel.Composite(func(tc hegel.TestCase) spec {
+		return spec{
+			lay:    li,
+			kind:   specFields,
+			prefix: hegel.Draw(tc, prefixes),
+			body:   hegel.Draw(tc, bodies[li]),
+			blanks: hegel.Draw(tc, blankTapes),
+			lead:   hegel.Draw(tc, optGaps),
+			trail:  hegel.Draw(tc, optGaps),
+		}
+	})
+}
+
+func namedSpecsOf(li int) hegel.Generator[spec] {
+	return hegel.Composite(func(tc hegel.TestCase) spec {
+		return spec{lay: li, kind: specNamed, prefix: hegel.Draw(tc, prefixes), name: hegel.Draw(tc, descriptorNames)}
+	})
+}
+
+func everySpecsOf(li int) hegel.Generator[spec] {
+	return hegel.Composite(func(tc hegel.TestCase) spec {
+		return spec{lay: li, kind: specEvery, prefix: hegel.Draw(tc, prefixes), every: hegel.Draw(tc, everyTexts)}
+	})
+}
+
+// fieldSpecs is a fields spec of each layout; specs a spec of each layout: the fields four
+// times in five, else a descriptor (named three times in five, "@every" twice), where the
+// layout accepts them; only descriptors for the descriptors-only parser.
+var (
+	fieldSpecs = perLayout(fieldSpecsOf)
+	specs      = perLayout(func(li int) hegel.Generator[spec] {
+		lay := layouts[li]
+		named, every := namedSpecsOf(li), everySpecsOf(li)
+		switch {
+		case lay.fields == nil:
+			return weighted(choice[spec]{3, named}, choice[spec]{2, every})
+		case !lay.descriptors:
+			return fieldSpecs[li]
+		}
+		return weighted(choice[spec]{80, fieldSpecs[li]}, choice[spec]{12, named}, choice[spec]{8, every})
+	})
+	specCases = hegel.FlatMap(layoutIndex, func(li int) hegel.Generator[spec] { return specs[li] })
+)
+
+func bitsString(b uint64) string {
+	var xs []string
+	for i := 0; i < 63; i++ {
+		if b&(1<<uint(i)) != 0 {
+			xs = append(xs, strconv.Itoa(i))
+		}
+	}
+	s := strings.Join(xs, ",")
+	if b&starBit != 0 {
+		s += "+*"
+	}
+	return "{" + s + "}"
+}
+
+func TestHegelParserBuildsTheDocumentedBitSets(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, specCases)
+		lay, text := layouts[c.lay], c.text()
+		sched, err := lay.parser.Parse(text)
+		if err != nil {
+			ht.Fatalf("Parse(%q) with the %s parser: %v", text, lay.name, err)
+		}
+		if c.kind == specEvery {
+			want := everyDelay(c.every)
+			cd, ok := sched.(cron.ConstantDelaySchedule)
+			if !ok || cd.Delay != want {
+				ht.Fatalf("Parse(%q) = %#v, want a ConstantDelaySchedule with delay %v", text, sched, want)
+			}
+			return
+		}
+		ss, ok := sched.(*cron.SpecSchedule)
+		if !ok {
+			ht.Fatalf("Parse(%q) = %#v, want a *SpecSchedule", text, sched)
+		}
+		got, want := [6]uint64{ss.Second, ss.Minute, ss.Hour, ss.Dom, ss.Month, ss.Dow}, c.bits()
+		for i := range got {
+			if got[i] != want[i] {
+				ht.Fatalf("Parse(%q): %s field is %s, want %s", text, fieldKinds[i].label, bitsString(got[i]), bitsString(want[i]))
+			}
+		}
+		if zone := c.prefix.zone; zone == "" {
+			if ss.Location != time.Local {
+				ht.Fatalf("Parse(%q): location %v, want time.Local", text, ss.Location)
+			}
+		} else if ss.Location == nil || ss.Location.String() != zone {
+			ht.Fatalf("Parse(%q): location %v, want %s", text, ss.Location, zone)
+		}
+	})
+}
+
+// ---- invalid specs -------------------------------------------------------------------------
+
+// corruption is what makes a spec invalid: one edit of a valid fields spec (the first ten
+// kinds), or a bad descriptor spec on its own (the last four). at is the field it touches,
+// modulo the number of fields; x and y are numbers its kind reads; text the replacement of the
+// kinds with a table.
+type corruption struct {
+	kind badKind
+	at   int
+	x, y int
+	text string
+}
+
+type badKind int
+
+const (
+	badTooMany badKind = iota
+	badTooFew
+	badAboveMax
+	badBelowMin
+	badReversed
+	badZeroStep
+	badTooManyMarks
+	badNotANumber
+	badUnknownZone
+	badDescriptor
+	badUnknownDescriptor
+	badEmpty
+	badDescriptorZone
+	badDuration
+)
+
+// atText is a corruption of the kind at a field position with one of the texts.
+func atText(kind badKind, texts ...string) hegel.Generator[corruption] {
+	ts := hegel.SampledFrom(texts)
+	return hegel.Composite(func(tc hegel.TestCase) corruption {
+		return corruption{kind: kind, at: hegel.Draw(tc, positions), text: hegel.Draw(tc, ts)}
+	})
+}
+
+// withText is a corruption of the kind with one of the texts.
+func withText(kind badKind, texts ...string) hegel.Generator[corruption] {
+	return hegel.Map(hegel.SampledFrom(texts), func(t string) corruption { return corruption{kind: kind, text: t} })
+}
+
+// corruptionsOf is an edit of a fields spec of the layout: a field too many or too few, a
+// value above the maximum or below the minimum, a reversed range, a zero step, too many
+// hyphens or slashes, a non-number, an unknown zone, or a descriptor the parser rejects (an
+// unknown one, or any one where descriptors are off).
+func corruptionsOf(li int) hegel.Generator[corruption] {
+	descriptors := withText(badDescriptor, "@hourly", "@daily", "@every 1h")
+	if layouts[li].descriptors {
+		descriptors = withText(badDescriptor, "@Hourly", "@yearlyy", "@every", "@every1h")
+	}
+	return hegel.OneOf(
+		hegel.Just(corruption{kind: badTooMany}),
+		hegel.Just(corruption{kind: badTooFew}),
+		hegel.Composite(func(tc hegel.TestCase) corruption {
+			return corruption{kind: badAboveMax, at: hegel.Draw(tc, positions), x: hegel.Draw(tc, hegel.Integers(1, 40))}
+		}),
+		hegel.Map(positions, func(at int) corruption { return corruption{kind: badBelowMin, at: at} }),
+		hegel.Composite(func(tc hegel.TestCase) corruption {
+			return corruption{kind: badReversed, at: hegel.Draw(tc, positions), x: hegel.Draw(tc, positions), y: hegel.Draw(tc, positions)}
+		}),
+		atText(badZeroStep, "*", "1", "1-2"),
+		atText(badTooManyMarks, "1-2-3", "1/2/3", "*/1/1", "1-2-3/2"),
+		atText(badNotANumber, "sunday", "january", "foo", "MONDAY", "jan1", "x", "1x", "1.5", "1e1", "0x1", "\u0661", "1-x", "x/2", "*/x", "*/", "/2", "-1-2"),
+		withText(badUnknownZone, "Mars/Olympus", "Nowhere", "UTC+1", "utc"),
+		descriptors,
+	)
+}
+
+// descriptorCorruptions: a bad descriptor spec on its own: empty, an unknown descriptor, an
+// unknown zone before "@hourly", or a bad "@every" duration.
+var descriptorCorruptions = hegel.OneOf(
+	hegel.Just(corruption{kind: badEmpty}),
+	withText(badUnknownDescriptor, "@Hourly", "@yearlyy", "@weekly ", "@Every 1h", "@every", "@every1h", "@every  1h", "@every 1x", "@every 1", "@"),
+	withText(badDescriptorZone, "Mars/Olympus", "Nowhere", "UTC+1"),
+	withText(badDuration, "", "h", "1.5", "1h30", "1 h", "--1h"),
+)
+
+// badSpec is a spec the parser must reject: a valid fields spec of the layout and its
+// corruption (the fields are unused by the descriptor kinds).
+type badSpec struct {
+	lay  int
+	good spec
+	c    corruption
+}
+
+// render is the invalid text and why it is invalid. The fields are joined by single spaces
+// after the prefix.
+func (b badSpec) render() (text, why string) {
+	lay, c := layouts[b.lay], b.c
+	switch c.kind {
+	case badEmpty:
+		return "", "empty spec"
+	case badUnknownDescriptor:
+		return c.text, "unknown descriptor"
+	case badDescriptorZone:
+		return "TZ=" + c.text + " @hourly", "unknown zone"
+	case badDuration:
+		return "@every " + c.text, "bad duration"
+	}
+	fields := b.good.body.texts()
+	rebuild := func(fs []string) string { return b.good.prefix.text() + strings.Join(fs, " ") }
+	p := c.at % len(fields)
+	k := fieldKinds[lay.present(b.good.body.omit)[p]]
+	switch c.kind {
+	case badTooMany:
+		extra := []string{"1"}
+		if lay.optional >= 0 && len(fields) < len(lay.fields) {
+			extra = []string{"1", "1"}
+		}
+		return rebuild(append(fields, extra...)), "too many fields"
+	case badTooFew:
+		// One field fewer than a spec with its optional field present is still valid, so two
+		// go; never all of them: a prefix alone is cron/1's panic, not a rejection.
+		drop := 1
+		if lay.optional >= 0 && len(fields) == len(lay.fields) {
+			drop = 2
+		}
+		return rebuild(fields[:len(fields)-drop]), "too few fields"
+	case badAboveMax:
+		fields[p] = strconv.Itoa(k.max + c.x)
+		return rebuild(fields), "value above the maximum"
+	case badBelowMin:
+		if k.min == 0 {
+			fields[p] = "-1"
+			return rebuild(fields), "negative value"
+		}
+		fields[p] = "0"
+		return rebuild(fields), "value below the minimum"
+	case badReversed:
+		hi := k.min + 1 + c.x%(k.max-k.min)
+		lo := k.min + c.y%(hi-k.min)
+		fields[p] = strconv.Itoa(hi) + "-" + strconv.Itoa(lo)
+		return rebuild(fields), "reversed range"
+	case badZeroStep:
+		fields[p] = c.text + "/0"
+		return rebuild(fields), "zero step"
+	case badTooManyMarks:
+		fields[p] = c.text
+		return rebuild(fields), "too many hyphens or slashes"
+	case badNotANumber:
+		fields[p] = c.text
+		return rebuild(fields), "not a number or name"
+	case badUnknownZone:
+		return "TZ=" + c.text + " " + strings.Join(fields, " "), "unknown zone"
+	}
+	if lay.descriptors {
+		return rebuild([]string{c.text}), "unknown descriptor"
+	}
+	return rebuild([]string{c.text}), "descriptor without the Descriptor option"
+}
+
+func (b badSpec) GoString() string {
+	text, why := b.render()
+	return fmt.Sprintf("%s parser, spec %q (%s)", layouts[b.lay].name, text, why)
+}
+
+// badSpecs is an invalid spec of each layout: a corrupted fields spec, or (where the parser
+// accepts descriptors) a bad descriptor spec three times in twenty; only the latter for the
+// descriptors-only parser.
+var (
+	badSpecs = perLayout(func(li int) hegel.Generator[badSpec] {
+		lay := layouts[li]
+		corrupted := hegel.Composite(func(tc hegel.TestCase) badSpec {
+			return badSpec{lay: li, good: hegel.Draw(tc, fieldSpecs[li]), c: hegel.Draw(tc, corruptionsOf(li))}
+		})
+		descriptors := hegel.Map(descriptorCorruptions, func(c corruption) badSpec { return badSpec{lay: li, c: c} })
+		switch {
+		case lay.fields == nil:
+			return descriptors
+		case !lay.descriptors:
+			return corrupted
+		}
+		return weighted(choice[badSpec]{85, corrupted}, choice[badSpec]{15, descriptors})
+	})
+	badCases = hegel.FlatMap(layoutIndex, func(li int) hegel.Generator[badSpec] { return badSpecs[li] })
+)
+
+func TestHegelParserRejectsInvalidSpecs(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, badCases)
+		lay := layouts[c.lay]
+		text, why := c.render()
+		sched, err := lay.parser.Parse(text)
+		if err == nil {
+			ht.Fatalf("Parse(%q) with the %s parser = %#v, but the spec has a %s", text, lay.name, sched, why)
+		}
+		if sched != nil {
+			ht.Fatalf("Parse(%q) returned both a schedule %#v and an error %v", text, sched, err)
+		}
+	})
+}
+
+// ---- the calendar model --------------------------------------------------------------------
+
+// setValues lists the values whose bits are set in [lo, hi].
+func setValues(bits uint64, lo, hi int) []int {
+	var xs []int
+	for i := lo; i <= hi; i++ {
+		if bits&(1<<uint(i)) != 0 {
+			xs = append(xs, i)
+		}
+	}
+	return xs
+}
+
+// wallInstants lists, in order, the instants whose wall clock in loc reads exactly
+// y-m-d h:mi:00 — none when a DST gap swallowed it, two when a fall-back repeated it.
+func wallInstants(y int, m time.Month, d, h, mi int, loc *time.Location) []time.Time {
+	base := time.Date(y, m, d, h, mi, 0, 0, loc)
+	var out []time.Time
+	for k := -6; k <= 6; k++ {
+		u := base.Add(time.Duration(k) * 30 * time.Minute)
+		uy, um, ud := u.Date()
+		if uy == y && um == m && ud == d && u.Hour() == h && u.Minute() == mi && u.Second() == 0 {
+			dup := false
+			for _, o := range out {
+				if o.Equal(u) {
+					dup = true
+				}
+			}
+			if !dup {
+				out = append(out, u)
+			}
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Before(out[j]) })
+	return out
+}
+
+// dayMatches is the documented day rule: with a '*' (or '?') in either day field both must
+// match, otherwise either may.
+func dayMatches(s *cron.SpecSchedule, y int, m time.Month, d int) bool {
+	wd := time.Date(y, m, d, 0, 0, 0, 0, time.UTC).Weekday()
+	domOK := s.Dom&(1<<uint(d)) != 0
+	dowOK := s.Dow&(1<<uint(wd)) != 0
+	if s.Dom&starBit != 0 || s.Dow&starBit != 0 {
+		return domOK && dowOK
+	}
+	return domOK || dowOK
+}
+
+// modelNext is the reference for SpecSchedule.Next: the earliest instant after t whose wall
+// clock in the schedule's zone matches every field, or the zero time when none falls within
+// five years of t.  It walks the calendar day by day; on the first day every matching wall
+// clock is tried (a repeated hour puts later instants at earlier wall clocks), afterwards the
+// first existing wall clock in field order is the answer.
+func modelNext(s *cron.SpecSchedule, t time.Time) time.Time {
+	loc := s.Location
+	if loc == time.Local {
+		// documented: a schedule without a zone is read in the zone of the time given
+		loc = t.Location()
+	}
+	start := t.In(loc).Add(time.Second - time.Duration(t.Nanosecond()))
+	yearLimit := start.Year() + 5
+	hours := setValues(s.Hour, 0, 23)
+	minutes := setValues(s.Minute, 0, 59)
+	seconds := setValues(s.Second, 0, 59)
+	y, m, d := start.Date()
+	for first := true; ; first = false {
+		if y > yearLimit {
+			return time.Time{}
+		}
+		if s.Month&(1<<uint(m)) != 0 && dayMatches(s, y, m, d) {
+			var best time.Time
+			for _, h := range hours {
+				for _, mi := range minutes {
+					for _, b := range wallInstants(y, m, d, h, mi, loc) {
+						for _, sec := range seconds {
+							u := b.Add(time.Duration(sec) * time.Second)
+							if first && u.Before(start) {
+								continue
+							}
+							if best.IsZero() || u.Before(best) {
+								best = u
+							}
+							break
+						}
+					}
+					if !first && !best.IsZero() {
+						return best.In(t.Location())
+					}
+				}
+			}
+			if !best.IsZero() {
+				return best.In(t.Location())
+			}
+		}
+		y, m, d = time.Date(y, m, d+1, 0, 0, 0, 0, time.UTC).Date()
+	}
+}
+
+// effectiveZone is the zone Next reads the schedule in: its own, or the zone of the time given
+// for a schedule without one (time.Local).
+func effectiveZone(s *cron.SpecSchedule, t time.Time) *time.Location {
+	if s.Location == time.Local {
+		return t.Location()
+	}
+	return s.Location
+}
+
+// oddShifts lists the instants in (from, to] at which loc's UTC offset changes from or to
+// other than a whole number of hours: Australia/Lord_Howe's 30-minute DST shift, and
+// Pacific/Chatham's (+12:45/+13:45) transitions at 02:45 and 03:45 on the wall clock.
+func oddShifts(from, to time.Time, loc *time.Location) []time.Time {
+	var shifts []time.Time
+	_, off := from.In(loc).Zone()
+	for lo := from; lo.Before(to); {
+		hi := lo.Add(24 * time.Hour)
+		if hi.After(to) {
+			hi = to
+		}
+		if _, o := hi.In(loc).Zone(); o != off {
+			if off%3600 != 0 || o%3600 != 0 {
+				// bisect to the first second with the new offset
+				a, b := lo, hi
+				for b.Sub(a) > time.Second {
+					mid := a.Add(b.Sub(a) / 2)
+					if _, m := mid.In(loc).Zone(); m == off {
+						a = mid
+					} else {
+						b = mid
+					}
+				}
+				shifts = append(shifts, b)
+			}
+			off = o
+		}
+		lo = hi
+	}
+	return shifts
+}
+
+// candidateOddShift reports whether Next's walk from `from` to the model's answer `want` can
+// cross a DST transition that is not aligned to whole hours with its hour loop.
+//
+// cron/6: SpecSchedule.Next steps whole hours from midnight
+// (spec.go, the Hour loop) as if every wall-clock hour began on one of its steps. After
+// Australia/Lord_Howe's 30-minute shift it sits at :30 past every hour: a job at a fixed
+// minute below 30 in a later hour of the day is skipped for the whole day ("0 0 12 * * *"
+// from 2005-03-26 12:00 in Lord Howe is next run on 03-28 12:00, not 03-27; "0 0 3 * * *"
+// from 2018-10-06 12:00 on 10-08, not 10-07) and a job at every minute is 30 minutes late
+// ("0 * 3 * * *" gives 2018-10-07 03:30 +1100, not 03:00). In Pacific/Chatham the clocks
+// jump 02:45 -> 03:45, so the step from 02:00 lands on 04:00 and the quarter of hour 3 that
+// exists is never seen ("0 * 3 * * 0" from 2006-09-24 03:59 gives 2006-10-08 03:00, not
+// 2006-10-01 03:45; "0 50 3 * * *" from 2006-09-30 gives 10-02 03:50, not 10-01); and when
+// the minute loop steps across the 03:45 -> 02:45 fall-back its Minute() is 45, so no WRAP
+// re-checks the hour and "0 50 3 * * *" from 2007-03-17 gives 2007-03-18 02:50 +1245 - an
+// hour early, and not in hour 3 at all (and in Lord Howe "0 30 1 * * *" from 2018-10-07
+// 01:40 gives 02:30 +1100, hour 2). Every case needs a loop of the walk to step across the
+// transition, which it does when one lies in (from, want] on a day the schedule's month and
+// day rule admit (the month and day loops jump over the others aligned). The property skips
+// those cases: 6 in 20000 measured (an interval-only condition would skip 6%).
+func candidateOddShift(s *cron.SpecSchedule, from, want time.Time, loc *time.Location) bool {
+	for _, shift := range oddShifts(from, want, loc) {
+		y, m, d := shift.Add(-time.Second).In(loc).Date() // the day of the last wall clock before the shift
+		if s.Month&(1<<uint(m)) != 0 && dayMatches(s, y, m, d) {
+			return true
+		}
+	}
+	return false
+}
+
+// bitsOf is a field's bit set drawn directly: star, a value, one to four values, a range, a
+// stride.
+func bitsOf(k fieldKind) hegel.Generator[uint64] {
+	vals := hegel.Integers(k.min, k.max)
+	return hegel.OneOf(
+		hegel.Just(allBits(k)),
+		hegel.Map(vals, func(v int) uint64 { return 1 << uint(v) }),
+		hegel.Map(many(vals, 1, 4), func(vs []int) uint64 {
+			var bits uint64
+			for _, v := range vs {
+				bits |= 1 << uint(v)
+			}
+			return bits
+		}),
+		hegel.Map(many(vals, 2, 2), func(vs []int) uint64 { return rangeBits(min(vs[0], vs[1]), max(vs[0], vs[1]), 1) }),
+		hegel.Map(hegel.Integers(2, k.max-k.min+1), func(step int) uint64 { return rangeBits(k.min, k.max, step) }),
+	)
+}
+
+// schedule is a SpecSchedule of the case's zone: built directly from six bit sets (read in
+// time.Local, the zone of the time given, once in five), or parsed by the seconds parser from
+// the fields of a spec with a CRON_TZ prefix (none once in five).
+type schedule struct {
+	kind   schedKind
+	bits   [6]uint64 // schedBits
+	local  bool      // schedBits: Location is time.Local
+	body   body      // schedText
+	noZone bool      // schedText: no CRON_TZ prefix
+}
+
+type schedKind int
+
+const (
+	schedBits schedKind = iota
+	schedText
+)
+
+func (s schedule) text(zone string) string {
+	fields := strings.Join(s.body.texts(), " ")
+	if s.noZone {
+		return fields
+	}
+	return "CRON_TZ=" + zone + " " + fields
+}
+
+func (s schedule) build(zone string) (*cron.SpecSchedule, error) {
+	if s.kind == schedBits {
+		ss := &cron.SpecSchedule{Second: s.bits[0], Minute: s.bits[1], Hour: s.bits[2], Dom: s.bits[3], Month: s.bits[4], Dow: s.bits[5], Location: loadZone(zone)}
+		if s.local {
+			ss.Location = time.Local
+		}
+		return ss, nil
+	}
+	sched, err := layouts[1].parser.Parse(s.text(zone))
+	if err != nil {
+		return nil, err
+	}
+	return sched.(*cron.SpecSchedule), nil
+}
+
+func (s schedule) describe(zone string) string {
+	if s.kind == schedText {
+		return fmt.Sprintf("%q", s.text(zone))
+	}
+	where := zone
+	if s.local {
+		where = "Local"
+	}
+	return fmt.Sprintf("bits s%s m%s h%s dom%s mon%s dow%s in %s", bitsString(s.bits[0]), bitsString(s.bits[1]), bitsString(s.bits[2]), bitsString(s.bits[3]), bitsString(s.bits[4]), bitsString(s.bits[5]), where)
+}
+
+var (
+	// seconds: the second field of a direct schedule is "0" three times in five.
+	seconds         = weighted(choice[uint64]{60, hegel.Just(uint64(1))}, choice[uint64]{40, bitsOf(kindSecond)})
+	directSchedules = hegel.Composite(func(tc hegel.TestCase) schedule {
+		return schedule{
+			kind:  schedBits,
+			bits:  [6]uint64{hegel.Draw(tc, seconds), hegel.Draw(tc, bitsOf(kindMinute)), hegel.Draw(tc, bitsOf(kindHour)), hegel.Draw(tc, bitsOf(kindDom)), hegel.Draw(tc, bitsOf(kindMonth)), hegel.Draw(tc, bitsOf(kindDow))},
+			local: hegel.Draw(tc, chance(20)),
+		}
+	})
+	textSchedules = hegel.Composite(func(tc hegel.TestCase) schedule {
+		return schedule{kind: schedText, body: hegel.Draw(tc, bodies[1]), noZone: hegel.Draw(tc, chance(20))}
+	})
+	schedules = hegel.OneOf(directSchedules, textSchedules)
+)
+
+// timeSpec is the instant Next is asked from: a Unix time between 1995 and 2036, or (twice
+// in five) a wall clock in the small hours of a DST month of the schedule's zone, shifted by
+// up to three days half of the time; with nanoseconds twice in five; expressed in another
+// zone twice in five ("" for the schedule's).
+type timeSpec struct {
+	kind                             timeKind
+	unix                             int64 // timeAny
+	year, day, hour, min, sec, shift int   // timeNearDST
+	month                            time.Month
+	nanos                            int64
+	in                               string
+}
+
+type timeKind int
+
+const (
+	timeAny timeKind = iota
+	timeNearDST
+)
+
+func (ts timeSpec) at(zone string) time.Time {
+	unix := ts.unix
+	if ts.kind == timeNearDST {
+		unix = time.Date(ts.year, ts.month, ts.day, ts.hour, ts.min, ts.sec, 0, loadZone(zone)).Unix() + int64(ts.shift)*86400
+	}
+	in := ts.in
+	if in == "" {
+		in = zone
+	}
+	return time.Unix(unix, ts.nanos).In(loadZone(in))
+}
+
+var (
+	anyTimes = hegel.Map(hegel.Integers[int64](788918400, 2082758400), func(u int64) timeSpec { return timeSpec{kind: timeAny, unix: u} })
+	dstTimes = hegel.Composite(func(tc hegel.TestCase) timeSpec {
+		return timeSpec{
+			kind:  timeNearDST,
+			year:  hegel.Draw(tc, hegel.Integers(1995, 2035)),
+			month: hegel.Draw(tc, hegel.SampledFrom([]time.Month{3, 4, 9, 10, 11, 1, 12, 2})),
+			day:   hegel.Draw(tc, hegel.Integers(1, 31)),
+			hour:  hegel.Draw(tc, hegel.Integers(0, 4)),
+			min:   hegel.Draw(tc, hegel.Integers(0, 59)),
+			sec:   hegel.Draw(tc, hegel.Integers(0, 59)),
+			shift: hegel.Draw(tc, maybe(50, hegel.Integers(-3, 3))),
+		}
+	})
+	instants  = weighted(choice[timeSpec]{60, anyTimes}, choice[timeSpec]{40, dstTimes})
+	nanos     = hegel.Integers[int64](0, 999999999)
+	timeSpecs = hegel.Composite(func(tc hegel.TestCase) timeSpec {
+		ts := hegel.Draw(tc, instants)
+		ts.nanos = hegel.Draw(tc, maybe(40, nanos))
+		ts.in = hegel.Draw(tc, maybe(40, zones))
+		return ts
+	})
+)
+
+// nextCase: the zone, a schedule in it and the instant to ask from.
+type nextCase struct {
+	zone  string
+	sched schedule
+	from  timeSpec
+}
+
+func (c nextCase) GoString() string {
+	return fmt.Sprintf("%s in %s; from %v", c.sched.describe(c.zone), c.zone, c.from.at(c.zone))
+}
+
+var nextCases = hegel.Composite(func(tc hegel.TestCase) nextCase {
+	return nextCase{zone: hegel.Draw(tc, zones), sched: hegel.Draw(tc, schedules), from: hegel.Draw(tc, timeSpecs)}
+})
+
+func TestHegelNextFollowsTheCalendarModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nextCases)
+		s, err := c.sched.build(c.zone)
+		if err != nil {
+			ht.Fatalf("generator: %v", err)
+		}
+		describe, from := c.sched.describe(c.zone), c.from.at(c.zone)
+		loc := effectiveZone(s, from)
+		want := modelNext(s, from)
+		// cron/6: an hour-unaligned DST transition between the start and the answer.
+		ht.Assume(want.IsZero() || !candidateOddShift(s, from, want, loc))
+		got := s.Next(from)
+		note(ht, "Next(%v) = %v (model %v)", from, got, want)
+		if want.IsZero() {
+			if !got.IsZero() {
+				ht.Fatalf("Next(%v) of %s = %v, but nothing matches within five years", from, describe, got)
+			}
+			return
+		}
+		if !got.Equal(want) {
+			ht.Fatalf("Next(%v) of %s in %s = %v, want %v", from, describe, c.zone, got, want)
+		}
+		if got.Location() != from.Location() {
+			ht.Fatalf("Next(%v) came back in %v, want the argument's zone %v", from, got.Location(), from.Location())
+		}
+		// and once more from the result: strictly later, still matching
+		w := modelNext(s, got)
+		ht.Assume(w.IsZero() || !candidateOddShift(s, got, w, loc)) // cron/6 again
+		again := s.Next(got)
+		if !again.IsZero() && !again.After(got) {
+			ht.Fatalf("Next(Next(t)) = %v is not after Next(t) = %v", again, got)
+		}
+		if !again.Equal(w) {
+			ht.Fatalf("Next(%v) of %s = %v, want %v", got, describe, again, w)
+		}
+	})
+}
+
+// ---- Every ---------------------------------------------------------------------------------
+
+// everyCase: the duration (around a few seconds, whole hours up to 400 days, or up to about
+// 17 minutes in nanoseconds), and the instant Next is asked from with its zone.
+type everyCase struct {
+	d           time.Duration
+	unix, nanos int64
+	zone        string
+}
+
+func (c everyCase) from() time.Time { return time.Unix(c.unix, c.nanos).In(loadZone(c.zone)) }
+
+func (c everyCase) GoString() string { return fmt.Sprintf("Every(%v) from %v", c.d, c.from()) }
+
+var (
+	durations = hegel.OneOf(
+		hegel.Map(hegel.Integers[int64](-2e9, 5e9), func(n int64) time.Duration { return time.Duration(n) }),
+		hegel.Map(hegel.Integers[int64](0, 400*24), func(h int64) time.Duration { return time.Duration(h) * time.Hour }),
+		hegel.Map(hegel.Integers[int64](0, 1e12), func(n int64) time.Duration { return time.Duration(n) }),
+	)
+	everyCases = hegel.Composite(func(tc hegel.TestCase) everyCase {
+		return everyCase{d: hegel.Draw(tc, durations), unix: hegel.Draw(tc, hegel.Integers[int64](0, 4e9)), nanos: hegel.Draw(tc, nanos), zone: hegel.Draw(tc, zones)}
+	})
+)
+
+func TestHegelEveryRoundsToWholeSeconds(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, everyCases)
+		d := c.d
+		want := d
+		if want < time.Second {
+			want = time.Second
+		}
+		want -= want % time.Second
+		e := cron.Every(d)
+		note(ht, "Every(%v).Delay = %v", d, e.Delay)
+		if e.Delay != want {
+			ht.Fatalf("Every(%v).Delay = %v, want %v", d, e.Delay, want)
+		}
+		from := c.from()
+		got := e.Next(from)
+		if wantNext := from.Truncate(time.Second).Add(want); !got.Equal(wantNext) || got.Nanosecond() != 0 {
+			ht.Fatalf("Every(%v).Next(%v) = %v, want %v", d, from, got, wantNext)
+		}
+		if text := d.String(); d > 0 {
+			sched, err := cron.ParseStandard("@every " + text)
+			if err != nil || sched != e {
+				ht.Fatalf("ParseStandard(%q) = %#v, %v; want %#v", "@every "+text, sched, err, e)
+			}
+		}
+	})
+}
+
+// ---- a Cron that is not running ------------------------------------------------------------
+
+type recordingLogger struct{ lines []string }
+
+func (l *recordingLogger) Info(msg string, kv ...interface{}) {
+	l.lines = append(l.lines, "info "+msg)
+}
+
+func (l *recordingLogger) Error(err error, msg string, kv ...interface{}) {
+	l.lines = append(l.lines, "error "+msg+": "+err.Error())
+}
+
+// cronOp is one step on a stopped Cron: AddFunc of a valid spec, AddFunc of an invalid one,
+// Schedule of an Every, or Remove of an entry of the model (at modulo their number; the raw
+// id at modulo 13 when known is off or the model is empty).
+type cronOp struct {
+	kind  opKind
+	spec  spec    // opAdd
+	bad   badSpec // opAddBad
+	secs  int     // opSchedule
+	known bool    // opRemove
+	at    int     // opRemove
+}
+
+type opKind int
+
+const (
+	opAdd opKind = iota
+	opAddBad
+	opSchedule
+	opRemove
+)
+
+func (o cronOp) String() string {
+	switch o.kind {
+	case opAdd:
+		return fmt.Sprintf("add %q", o.spec.text())
+	case opAddBad:
+		text, why := o.bad.render()
+		return fmt.Sprintf("add bad %q (%s)", text, why)
+	case opSchedule:
+		return fmt.Sprintf("schedule @every %ds", o.secs)
+	}
+	if o.known {
+		return fmt.Sprintf("remove entry #%d", o.at)
+	}
+	return fmt.Sprintf("remove id %d", o.at%13)
+}
+
+// opsOf is an op for the layout (standard or seconds): an add twice in five, a bad add,
+// a schedule and a remove once each.
+func opsOf(li int) hegel.Generator[cronOp] {
+	return weighted(
+		choice[cronOp]{2, hegel.Map(specs[li], func(s spec) cronOp { return cronOp{kind: opAdd, spec: s} })},
+		choice[cronOp]{1, hegel.Map(badSpecs[li], func(b badSpec) cronOp { return cronOp{kind: opAddBad, bad: b} })},
+		choice[cronOp]{1, hegel.Map(hegel.Integers(1, 3600), func(s int) cronOp { return cronOp{kind: opSchedule, secs: s} })},
+		choice[cronOp]{1, hegel.Composite(func(tc hegel.TestCase) cronOp {
+			return cronOp{kind: opRemove, known: hegel.Draw(tc, chance(70)), at: hegel.Draw(tc, positions)}
+		})},
+	)
+}
+
+// cronCase: the Cron's zone, whether it has seconds, and up to eight ops.
+type cronCase struct {
+	zone        string
+	withSeconds bool
+	ops         []cronOp
+}
+
+func (c cronCase) GoString() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "Cron in %s, seconds %v", c.zone, c.withSeconds)
+	for _, o := range c.ops {
+		b.WriteString("; " + o.String())
+	}
+	return b.String()
+}
+
+var (
+	opLists   = [2]hegel.Generator[[]cronOp]{many(opsOf(0), 0, 8), many(opsOf(1), 0, 8)}
+	cronCases = hegel.FlatMap(hegel.Booleans(), func(withSeconds bool) hegel.Generator[cronCase] {
+		li := 0
+		if withSeconds {
+			li = 1
+		}
+		return hegel.Composite(func(tc hegel.TestCase) cronCase {
+			return cronCase{zone: hegel.Draw(tc, zones), withSeconds: withSeconds, ops: hegel.Draw(tc, opLists[li])}
+		})
+	})
+)
+
+func TestHegelCronKeepsItsEntriesWhileStopped(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cronCases)
+		loc := loadZone(c.zone)
+		opts := []cron.Option{cron.WithLocation(loc)}
+		if c.withSeconds {
+			opts = append(opts, cron.WithSeconds())
+		}
+		cr := cron.New(opts...)
+		if cr.Location() != loc {
+			ht.Fatalf("Location() = %v, want %v", cr.Location(), c.zone)
+		}
+		type modelEntry struct {
+			id   cron.EntryID
+			spec string
+		}
+		var model []modelEntry
+		var nextID cron.EntryID
+		for _, op := range c.ops {
+			switch op.kind {
+			case opAdd:
+				text := op.spec.text()
+				id, err := cr.AddFunc(text, func() {})
+				if err != nil {
+					ht.Fatalf("AddFunc(%q): %v", text, err)
+				}
+				nextID++
+				if id != nextID {
+					ht.Fatalf("AddFunc(%q) = id %d, want %d", text, id, nextID)
+				}
+				model = append(model, modelEntry{id, text})
+			case opAddBad:
+				bad, why := op.bad.render()
+				if id, err := cr.AddFunc(bad, func() {}); err == nil || id != 0 {
+					ht.Fatalf("AddFunc(%q) = %d, %v; the spec has a %s", bad, id, err, why)
+				}
+			case opSchedule:
+				d := time.Duration(op.secs) * time.Second
+				id := cr.Schedule(cron.Every(d), cron.FuncJob(func() {}))
+				nextID++
+				if id != nextID {
+					ht.Fatalf("Schedule = id %d, want %d", id, nextID)
+				}
+				model = append(model, modelEntry{id, "@every " + d.String()})
+			default:
+				id := cron.EntryID(op.at % 13)
+				if op.known && len(model) > 0 {
+					id = model[op.at%len(model)].id
+				}
+				cr.Remove(id)
+				var kept []modelEntry
+				for _, e := range model {
+					if e.id != id {
+						kept = append(kept, e)
+					}
+				}
+				model = kept
+			}
+		}
+		entries := cr.Entries()
+		note(ht, "%d entries, model %v", len(entries), model)
+		if len(entries) != len(model) {
+			ht.Fatalf("Entries() has %d entries, want %d (%v)", len(entries), len(model), model)
+		}
+		for i, e := range entries {
+			if e.ID != model[i].id || !e.Valid() {
+				ht.Fatalf("Entries()[%d].ID = %d, want %d", i, e.ID, model[i].id)
+			}
+			if !e.Next.IsZero() || !e.Prev.IsZero() {
+				ht.Fatalf("entry %d has Next %v / Prev %v before Start", e.ID, e.Next, e.Prev)
+			}
+			if e.Job == nil || e.WrappedJob == nil || e.Schedule == nil {
+				ht.Fatalf("entry %d is missing its job or schedule: %+v", e.ID, e)
+			}
+			if got := cr.Entry(e.ID); got.ID != e.ID {
+				ht.Fatalf("Entry(%d) = %+v", e.ID, got)
+			}
+		}
+		for id := cron.EntryID(0); id <= nextID+1; id++ {
+			present := false
+			for _, e := range model {
+				present = present || e.id == id
+			}
+			if got := cr.Entry(id); got.Valid() != present {
+				ht.Fatalf("Entry(%d).Valid() = %v, want %v", id, got.Valid(), present)
+			}
+		}
+	})
+}
+
+// chainCase: the number of tracing wrappers and whether the job panics (under Recover).
+type chainCase struct {
+	count  int
+	panics bool
+}
+
+var chainCases = hegel.Composite(func(tc hegel.TestCase) chainCase {
+	return chainCase{count: hegel.Draw(tc, hegel.Integers(0, 4)), panics: hegel.Draw(tc, chance(30))}
+})
+
+// TestHegelChainWrapsInOrder: NewChain(m1, m2, m3).Then(job) runs m1 outermost, and Recover
+// swallows a panic and logs it.
+func TestHegelChainWrapsInOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, chainCases)
+		var trace []string
+		count, panics := c.count, c.panics
+		var wrappers []cron.JobWrapper
+		for i := 0; i < count; i++ {
+			i := i
+			wrappers = append(wrappers, func(j cron.Job) cron.Job {
+				return cron.FuncJob(func() {
+					trace = append(trace, fmt.Sprintf("enter %d", i))
+					j.Run()
+					trace = append(trace, fmt.Sprintf("exit %d", i))
+				})
+			})
+		}
+		logger := &recordingLogger{}
+		if panics {
+			wrappers = append([]cron.JobWrapper{cron.Recover(logger)}, wrappers...)
+		}
+		job := cron.NewChain(wrappers...).Then(cron.FuncJob(func() {
+			trace = append(trace, "job")
+			if panics {
+				panic("boom")
+			}
+		}))
+		job.Run()
+		var want []string
+		for i := 0; i < count; i++ {
+			want = append(want, fmt.Sprintf("enter %d", i))
+		}
+		want = append(want, "job")
+		if !panics {
+			for i := count - 1; i >= 0; i-- {
+				want = append(want, fmt.Sprintf("exit %d", i))
+			}
+		}
+		note(ht, "trace %v", trace)
+		if !reflect.DeepEqual(trace, want) {
+			ht.Fatalf("trace %v, want %v", trace, want)
+		}
+		if panics && (len(logger.lines) != 1 || !strings.HasPrefix(logger.lines[0], "error panic: boom")) {
+			ht.Fatalf("Recover logged %v", logger.lines)
+		}
+	})
+}
