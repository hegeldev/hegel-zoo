+// ---- pins ----------------------------------------------------------------------------------
+
+// cron/1: a spec that is only a time-zone prefix ("TZ=UTC", "CRON_TZ=Asia/Tokyo") makes
+// Parse slice with the index of a space that is not there and panic.
+func TestHegelPinBareTimeZonePrefixIsAnError(t *testing.T) {
+	for _, spec := range []string{"TZ=UTC", "CRON_TZ=Asia/Tokyo", "TZ=", "CRON_TZ=Nowhere"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("ParseStandard(%q) panicked: %v", spec, r)
+				}
+			}()
+			if sched, err := cron.ParseStandard(spec); err == nil {
+				t.Errorf("ParseStandard(%q) = %#v, want an error", spec, sched)
+			}
+		}()
+	}
+}
+
+// cron/5: the zone prefix is cut at the first space, so "TZ=UTC<tab>0 0 * * *" fails with
+// "provided bad location UTC\t0", although every other field separator may be any blank.
+func TestHegelPinTimeZonePrefixEndsAtAnyBlank(t *testing.T) {
+	for _, spec := range []string{"TZ=UTC\t0 0 * * *", "CRON_TZ=Asia/Tokyo\t@hourly", "TZ=UTC\t \t0 0 * * *"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("ParseStandard(%q) panicked: %v", spec, r)
+				}
+			}()
+			sched, err := cron.ParseStandard(spec)
+			if err != nil {
+				t.Errorf("ParseStandard(%q): %v", spec, err)
+				return
+			}
+			if ss, ok := sched.(*cron.SpecSchedule); ok && ss.Location.String() != strings.Split(strings.SplitN(spec, "=", 2)[1], "\t")[0] {
+				t.Errorf("ParseStandard(%q) chose location %v", spec, ss.Location)
+			}
+		}()
+	}
+}
+
+// cron/2: when the schedule's day begins with a DST gap (midnight does not exist: Asia/Beirut,
+// America/Havana, America/Santiago, America/Asuncion, historically America/Sao_Paulo), Next
+// steps onto the day, lands at 01:00, "corrects" back to 23:00 of the day before, and then
+// skips the whole day: the 03:00 run on 31 March 2024 in Beirut is reported for 31 May.
+func TestHegelPinNextDoesNotSkipDaysWhoseMidnightDoesNotExist(t *testing.T) {
+	p := cron.NewParser(cron.Second | cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow)
+	cases := []struct{ zone, spec, from, want string }{
+		{"Asia/Beirut", "0 0 3 31 * *", "2024-03-30T22:00:00", "2024-03-31T03:00:00+03:00"},
+		{"Asia/Beirut", "0 0 * 31 3 *", "2024-03-30T22:00:00", "2024-03-31T01:00:00+03:00"},
+		{"Asia/Beirut", "0 30 12 * * 0", "2024-03-25T00:00:00", "2024-03-31T12:30:00+03:00"},
+		{"America/Havana", "0 0 12 10 3 *", "2024-03-09T20:00:00", "2024-03-10T12:00:00-04:00"},
+		{"America/Santiago", "0 0 9 * 9 *", "2024-09-07T12:00:00", "2024-09-08T09:00:00-03:00"},
+	}
+	for _, c := range cases {
+		loc := loadZone(c.zone)
+		sched, err := p.Parse(c.spec)
+		if err != nil {
+			t.Fatal(err)
+		}
+		from, err := time.ParseInLocation("2006-01-02T15:04:05", c.from, loc)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want, err := time.Parse(time.RFC3339, c.want)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := sched.Next(from)
+		if model := modelNext(sched.(*cron.SpecSchedule), from); !model.Equal(want) {
+			t.Fatalf("the model disagrees with the pin for %s %q: %v", c.zone, c.spec, model)
+		}
+		if !got.Equal(want) {
+			t.Errorf("%s: Next(%v) of %q = %v, want %v", c.zone, from, c.spec, got, want.In(loc))
+		}
+	}
+}
+
+// cron/6: the hour and minute loops of Next step whole hours and minutes and re-check the
+// higher fields only on a wrap to :00, as if every wall-clock hour began on one of the steps.
+// Across a DST shift that is not a whole hour (Australia/Lord_Howe, 30 minutes; Pacific/Chatham,
+// 02:45 -> 03:45) the walk sits at :30 or :45 past every hour: a job at a fixed minute below
+// the shift is lost for the whole day, a job at every minute runs late, and a step across the
+// fall-back lands in the wrong hour altogether ("0 50 3 * * *" from 2007-03-17 in Chatham runs
+// at 02:50).
+func TestHegelPinNextHandlesHalfHourAndQuarterHourShifts(t *testing.T) {
+	p := cron.NewParser(cron.Second | cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow)
+	cases := []struct{ zone, spec, from, want string }{
+		{"Australia/Lord_Howe", "0 0 12 * * *", "2005-03-26T12:00:00", "2005-03-27T12:00:00+10:30"},
+		{"Australia/Lord_Howe", "0 0 3 * * *", "2018-10-06T12:00:00", "2018-10-07T03:00:00+11:00"},
+		{"Australia/Lord_Howe", "0 * 3 * * *", "2018-10-06T12:00:00", "2018-10-07T03:00:00+11:00"},
+		{"Australia/Lord_Howe", "0 30 1 * * *", "2018-10-07T01:40:00", "2018-10-08T01:30:00+11:00"},
+		{"Pacific/Chatham", "0 * 3 * * 0", "2006-09-24T03:59:00", "2006-10-01T03:45:00+13:45"},
+		{"Pacific/Chatham", "0 50 3 * * *", "2007-03-17T12:00:00", "2007-03-18T03:50:00+12:45"},
+	}
+	for _, c := range cases {
+		loc := loadZone(c.zone)
+		sched, err := p.Parse(c.spec)
+		if err != nil {
+			t.Fatal(err)
+		}
+		from, err := time.ParseInLocation("2006-01-02T15:04:05", c.from, loc)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want, err := time.Parse(time.RFC3339, c.want)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := sched.Next(from)
+		if model := modelNext(sched.(*cron.SpecSchedule), from); !model.Equal(want) {
+			t.Fatalf("the model disagrees with the pin for %s %q: %v", c.zone, c.spec, model)
+		}
+		if !got.Equal(want) {
+			t.Errorf("%s: Next(%v) of %q = %v, want %v", c.zone, from, c.spec, got, want.In(loc))
+		}
+	}
+}
+
+// cron/3: "*-5" and "?-5/2" parse as "*" and "*/2": whatever follows a star in a range is
+// ignored.
+func TestHegelPinStarWithARangeIsRejected(t *testing.T) {
+	for _, spec := range []string{"*-5 * * * *", "?-5/2 * * * *", "0 0 *-x * *", "0 0 * * ?-"} {
+		if sched, err := cron.ParseStandard(spec); err == nil {
+			ss := sched.(*cron.SpecSchedule)
+			t.Errorf("ParseStandard(%q) accepted the spec as minute %s dom %s dow %s", spec, bitsString(ss.Minute), bitsString(ss.Dom), bitsString(ss.Dow))
+		}
+	}
+}
+
+// cron/4: a field made only of commas (",", ",,") parses to an empty set with a nil error,
+// and the resulting schedule never fires (Next returns the zero time forever).
+func TestHegelPinEmptyFieldIsRejected(t *testing.T) {
+	for _, spec := range []string{", * * * *", "0 ,, * * *", "0 0 * , *"} {
+		sched, err := cron.ParseStandard(spec)
+		if err == nil {
+			next := sched.Next(time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC))
+			t.Errorf("ParseStandard(%q) = %#v, nil; Next from 2024 is %v", spec, sched, next)
+		}
+	}
+}
