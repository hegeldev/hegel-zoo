+package hegel
+
+// The four wide properties: each draws a case record (hegel_zoo_cases_test.go), runs the
+// classifier on it (the model per switch, hegel_zoo_model_test.go) to name the recorded bug
+// whose shape the case has, then asks the library the questions the model answered, under
+// hzCall (a panic is the check value "panic"), and judges the answers against the documented
+// ones, failing "(the shape of gval/N)" on a named case. A case whose documented value Go
+// leaves implementation-defined (a float to integer conversion out of range: "unspecified"
+// in any run of the classifier's sweep) is filtered out by name (unspecifiedConversion,
+// counted). Under HEGEL_NO_KNOWN=1 the shapes are off: the base-prefixed spellings (gval/6)
+// and the negation of a decimal value (gval/1) at weight zero in the generators, the rest
+// filtered out on the classifier (withoutShapes: gval/2, 3, 4, 5 and 7 in the three Full
+// properties, gval/5 and 8 in the decimal one).
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math/big"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/PaesslerAG/gval"
+	"hegel.dev/go/hegel"
+)
+
+// langErrOutcome spells an error of Language.Evaluate or NewEvaluable: "error: parse" for
+// NewEvaluable's ("parsing error: ...", language.go :74-77), else the evaluation error's
+// own message with Evaluate's wrapper removed ("can not evaluate ...: %w", :93-96).
+func langErrOutcome(err error) string {
+	if strings.HasPrefix(err.Error(), "parsing error") {
+		return parseError
+	}
+	if inner := errors.Unwrap(err); inner != nil {
+		return "error: " + inner.Error()
+	}
+	return "error: " + err.Error()
+}
+
+// evalErrOutcome spells an error of an Evaluable call (the evaluation error as it is).
+func evalErrOutcome(err error) string { return "error: " + err.Error() }
+
+// libEvaluate is Evaluate's outcome in the language: the value (canon), the error, or
+// "panic".
+func libEvaluate(l gval.Language, text string, p map[string]any) string {
+	var v any
+	var err error
+	if r := hzCall(func() { v, err = l.Evaluate(text, p) }); r != nil {
+		return "panic"
+	}
+	if err != nil {
+		return langErrOutcome(err)
+	}
+	return canon(v)
+}
+
+// libEval is an Evaluable's outcome against p.
+func libEval(ev gval.Evaluable, p map[string]any) string {
+	var v any
+	var err error
+	if r := hzCall(func() { v, err = ev(context.Background(), p) }); r != nil {
+		return "panic"
+	}
+	if err != nil {
+		return evalErrOutcome(err)
+	}
+	return canon(v)
+}
+
+// The library's answers to each family's questions (the wide and the narrow properties
+// share them).
+
+func evaluateActual(c *evaluateCase) checks {
+	got := checks{}
+	got.set("minimal", libEvaluate(gval.Full(), c.minimal, params()))
+	got.set("full", libEvaluate(gval.Full(), c.full, params()))
+	return got
+}
+
+func reuseActual(c *reuseCase) checks {
+	got := checks{}
+	ev, err := gval.Full().NewEvaluable(c.text)
+	if err != nil {
+		got.set("parse", langErrOutcome(err))
+		return got
+	}
+	got.set("parse", "ok")
+	got.set("const", ev.IsConst())
+	for i, p := range reuseParams() {
+		got.set("eval "+strconv.Itoa(i), libEval(ev, p))
+	}
+	return got
+}
+
+func conversionsActual(c *conversionsCase) checks {
+	got := checks{}
+	ev, err := gval.Full().NewEvaluable(c.text)
+	if err != nil {
+		got.set("parse", langErrOutcome(err))
+		return got
+	}
+	got.set("parse", "ok")
+	ctx := context.Background()
+	if b, err := ev.EvalBool(ctx, params()); err != nil {
+		got.set("bool", evalErrOutcome(err))
+	} else {
+		got.set("bool", strconv.FormatBool(b))
+	}
+	if f, err := ev.EvalFloat64(ctx, params()); err != nil {
+		got.set("float", evalErrOutcome(err))
+	} else {
+		got.set("float", canon(f))
+	}
+	if i, err := ev.EvalInt(ctx, params()); err != nil {
+		got.set("int", evalErrOutcome(err))
+	} else {
+		got.set("int", strconv.Itoa(i))
+	}
+	if s, err := ev.EvalString(ctx, params()); err != nil {
+		got.set("string", evalErrOutcome(err))
+	} else {
+		got.set("string", s)
+	}
+	return got
+}
+
+// decimalActual: the library's %v of a decimal.Decimal is reparsed as an exact rational
+// (RatString: the comparison with the model's rational is exact), a bool spelled, an
+// error or a panic as in the other properties.
+func decimalActual(c *decimalCase) checks {
+	got := checks{}
+	var v any
+	var err error
+	if r := hzCall(func() { v, err = gval.DecimalArithmetic().Evaluate(c.text, map[string]any{"x": 3.0}) }); r != nil {
+		got.set("value", "panic")
+		return got
+	}
+	if err != nil {
+		got.set("value", langErrOutcome(err))
+		return got
+	}
+	if b, ok := v.(bool); ok {
+		got.set("value", strconv.FormatBool(b))
+		return got
+	}
+	s := fmt.Sprintf("%v", v)
+	if r, ok := new(big.Rat).SetString(s); ok {
+		got.set("value", r.RatString())
+	} else {
+		got.set("value", fmt.Sprintf("unparsable %q (%T)", s, v))
+	}
+	return got
+}
+
+// specified reports whether the model states a value for every check of the case in every
+// run of the classifier's sweep (none, all, each switch alone and each switched off): a
+// case with an "unspecified" value anywhere is out (unspecifiedConversion).
+func specified[T any](c T, expected func(T, known) checks) bool {
+	sets := []known{hzKnownNone, hzKnownAll}
+	for _, i := range hzKnownRead {
+		sets = append(sets, hzKnownOnly(i), hzKnownAllBut(i))
+	}
+	for _, k := range sets {
+		for _, v := range expected(c, k) {
+			if strings.Contains(v, "unspecified") {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// specifiedCases is the cases with a documented value for every check (the filter
+// unspecifiedConversion, counted).
+func specifiedCases[T any](expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	return hzOnly(true, "unspecifiedConversion", cases, func(c T) bool { return specified(c, expected) })
+}
+
+// wideCases is the cases of a wide property: the unspecified ones filtered out by name,
+// then, under HEGEL_NO_KNOWN=1, the shaped ones.
+func wideCases[T any](expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	return withoutShapes(expected, specifiedCases(expected, cases))
+}
+
+// TestHegelEvaluate: the minimal (by Go's table) and the fully parenthesized rendering of a
+// tree evaluate in gval.Full to the model's value, or fail with the model's error.
+func TestHegelEvaluate(t *testing.T) {
+	judged(t, wideCases(evaluateExpected, evaluateCases), func(j *hzCaseJudge, c evaluateCase) {
+		judgeBy(j, &c, evaluateExpected, evaluateActual)
+	})
+}
+
+// TestHegelReuse: an Evaluable built once gives the model's answers for two parameter sets
+// (params, params2, params again), and IsConst is true exactly for constant expressions.
+func TestHegelReuse(t *testing.T) {
+	judged(t, wideCases(reuseExpected, reuseCases), func(j *hzCaseJudge, c reuseCase) {
+		judgeBy(j, &c, reuseExpected, reuseActual)
+	})
+}
+
+// TestHegelConversions: EvalBool, EvalFloat64, EvalInt and EvalString apply the documented
+// conversions to the expression's value, or return its evaluation error.
+func TestHegelConversions(t *testing.T) {
+	judged(t, wideCases(conversionsExpected, conversionsCases), func(j *hzCaseJudge, c conversionsCase) {
+		judgeBy(j, &c, conversionsExpected, conversionsActual)
+	})
+}
+
+// TestHegelDecimal: DecimalArithmetic computes + - * % and integer powers exactly, divides
+// to 16 places, compares exactly, and a zero divisor is an error, not a panic.
+func TestHegelDecimal(t *testing.T) {
+	judged(t, wideCases(decimalExpected, decimalCases), func(j *hzCaseJudge, c decimalCase) {
+		judgeBy(j, &c, decimalExpected, decimalActual)
+	})
+}
diff --git a/hegel/hegel_zoo_shapes_test.go b/hegel/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..7e3ac27
--- /dev/null
+++ b/hegel/hegel_zoo_shapes_test.go
@@ -0,0 +1,413 @@
+package hegel
+
+// The eight narrow properties, one per recorded bug: each draws the region of its bug's
+// shape by construction (and under HEGEL_NO_KNOWN=1 the neighbouring region past it,
+// hzShaped), keeps the cases the classifier names as that bug (regionOf: by default the
+// shape, under HEGEL_NO_KNOWN=1 the cases with no shape), and judges them with the family's
+// expected function and the library's answers (hegel_zoo_props_test.go: the evaluate family
+// for the six bugs of gval.Full, the decimal family for the two of DecimalArithmetic). Each
+// fails every run by default naming its bug and passes under HEGEL_NO_KNOWN=1. Where an
+// earlier bug in bug order would be named first, the construction keeps that bug's shape
+// out: the numbers are spelled plainly (gval/6), a constant subexpression never errors
+// (gval/5) unless it is the shape, and the decimal trees hold no other negation (gval/1).
+
+import (
+	"strconv"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the pieces
+
+// lit is a literal spelled plainly (a number by the shortest form).
+func lit(v any) *node {
+	switch t := v.(type) {
+	case float64:
+		return numNode(t, strconv.FormatFloat(t, 'g', -1, 64))
+	case string:
+		return strNode(t, false)
+	case bool:
+		return boolNode(t)
+	}
+	panic("lit of an unexpected type")
+}
+
+func litF(f float64) *node { return lit(f) }
+
+func litS(s string) *node { return lit(s) }
+
+func vr(name string, keys ...key) *node { return &node{kind: "var", name: name, keys: keys} }
+
+func dot(name string) key { return key{dot: true, name: name} }
+
+func at(n *node) key { return key{expr: n} }
+
+func infix(op string, a, b *node) *node { return &node{kind: "infix", op: op, a: a, b: b} }
+
+func prefix(op string, a *node) *node { return &node{kind: "prefix", op: op, a: a} }
+
+func ternary(a, b, c *node) *node { return &node{kind: "ternary", a: a, b: b, c: c} }
+
+// plainNums is a number of the pool below 1e21 spelled plainly.
+var plainNums = hegel.Map(evenHalves(0.0, 1, 2, 3, 7, 10, 0.5, 2.5, 1000, 9, 0.1), litF)
+
+// bareVar is a scalar parameter by name.
+var bareVar = hegel.Map(evenHalves("x", "y", "z", "s", "t", "u", "b", "f", "n"), func(name string) *node { return vr(name) })
+
+// strictLeaf is a leaf that evaluates without error and is spelled plainly: a number two
+// times in six, a string, a bool, or a scalar parameter two times in six.
+var strictLeaf = halvesGens([]int{2, 1, 1, 2}, plainNums, strLit, boolLit, bareVar)
+
+// --------------------------------------------------------------------------- the decimal
+// pieces
+
+func dlit(s string) *dnode { return &dnode{lit: s} }
+
+func dinfix(op string, a, b *dnode) *dnode { return &dnode{op: op, a: a, b: b} }
+
+var dx = &dnode{v: true}
+
+var decLitLeaf = hegel.Map(evenHalves(decLits...), dlit)
+
+// decSafeGen[d] is a decimal tree of depth d of + - * over literals and x (no negation: a
+// negation of anything but x is gval/1's shape; no divisor: a constant zero divisor is
+// gval/5's), built bottom-up.
+var decSafeGen [3]hegel.Generator[*dnode]
+
+func decSafeAt(d int) hegel.Generator[*dnode] {
+	if d == 0 {
+		return dieChoice(hzW(80, decLitLeaf), hzW(20, hegel.Just(dx)))
+	}
+	return hegel.FlatMap(evenHalves("+", "-", "*"), func(op string) hegel.Generator[*dnode] {
+		return hegel.FlatMap(decSafeGen[d-1], func(a *dnode) hegel.Generator[*dnode] {
+			return hegel.Map(decSafeGen[d-1], func(b *dnode) *dnode { return dinfix(op, a, b) })
+		})
+	})
+}
+
+func init() {
+	for d := range decSafeGen {
+		decSafeGen[d] = decSafeAt(d)
+	}
+}
+
+// decSafeTree is a safe decimal tree of depth 0..2.
+var decSafeTree = hegel.FlatMap(rangeHalves(0, 2), func(d int) hegel.Generator[*dnode] { return decSafeGen[d] })
+
+// --------------------------------------------------------------------------- gval/1
+
+// negatedDecimals is the negation of a literal or of a safe tree of depth 1..2 (the shape:
+// the operand is a decimal.Decimal, which the prefix - does not convert); under
+// HEGEL_NO_KNOWN=1 the negation of x (the float parameter, the one operand it converts). The
+// negation stands alone half the time, else as an operand of + - * with a safe tree.
+var negatedDecimals = hegel.FlatMap(hzShaped(halvesGens([]int{1, 1}, decLitLeaf, hegel.FlatMap(rangeHalves(1, 2), func(d int) hegel.Generator[*dnode] { return decSafeGen[d] })), hegel.Just(dx)),
+	func(a *dnode) hegel.Generator[*dnode] {
+		neg := &dnode{neg: a}
+		beside := hegel.FlatMap(evenHalves("+", "-", "*"), func(op string) hegel.Generator[*dnode] {
+			return hegel.FlatMap(decSafeTree, func(other *dnode) hegel.Generator[*dnode] {
+				return hegel.Map(dieCoin(50), func(left bool) *dnode {
+					if left {
+						return dinfix(op, neg, other)
+					}
+					return dinfix(op, other, neg)
+				})
+			})
+		})
+		return dieChoice(hzW(50, hegel.Just(neg)), hzW(50, beside))
+	})
+
+// TestHegelNegatedDecimalsEvaluate: in DecimalArithmetic the prefix - negates a decimal value
+// as it negates the float parameter (gval/1).
+func TestHegelNegatedDecimalsEvaluate(t *testing.T) {
+	judged(t, regionOf("gval/1", decimalExpected, decimalCasesOf(negatedDecimals)), func(j *hzCaseJudge, c decimalCase) {
+		judgeBy(j, &c, decimalExpected, decimalActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gval/2
+
+// zeroLefts is a left operand of ?? that is the zero value of its type but neither nil nor
+// false (the shape: ?? passes it over): 0 by its three spellings, the empty string, the
+// parameters z (0) and m.e (""), x - 3 and 0 * x. nonZeroLefts is one that is neither (the
+// region past: ?? keeps it as documented).
+var zeroLefts = halvesGens([]int{3, 2, 1, 1, 1, 1},
+	hegel.Map(evenHalves("0", "0.0", "0."), func(spell string) *node { return numNode(0, spell) }),
+	hegel.Map(dieCoin(20), func(raw bool) *node { return strNode("", raw) }),
+	hegel.Just(vr("z")),
+	hegel.Just(vr("m", dot("e"))),
+	hegel.Just(infix("-", vr("x"), lit(3.0))),
+	hegel.Just(infix("*", lit(0.0), vr("x"))))
+
+var nonZeroLefts = halvesGens([]int{2, 2, 1, 2},
+	hegel.Map(evenHalves(1.0, 2.5, 1000), litF),
+	hegel.Map(evenHalves("a", "abc", "0"), litS),
+	hegel.Just(lit(true)),
+	hegel.Map(evenHalves("x", "y", "s", "t", "u", "b"), func(name string) *node { return vr(name) }))
+
+// coalescedZeroes is left ?? right with a safe right operand; alone 70 percent of the time,
+// else as the one element of an array.
+var coalescedZeroes = hegel.FlatMap(hzShaped(zeroLefts, nonZeroLefts), func(left *node) hegel.Generator[*node] {
+	return hegel.FlatMap(strictLeaf, func(right *node) hegel.Generator[*node] {
+		n := infix("??", left, right)
+		return dieChoice(hzW(70, hegel.Just(n)), hzW(30, hegel.Just(&node{kind: "array", elts: []*node{n}})))
+	})
+})
+
+// TestHegelCoalescingKeepsZeroValues: a ?? b is a whenever a is neither nil nor false, also
+// for 0 and "" (gval/2).
+func TestHegelCoalescingKeepsZeroValues(t *testing.T) {
+	judged(t, regionOf("gval/2", evaluateExpected, evaluateCasesOf(coalescedZeroes)), func(j *hzCaseJudge, c evaluateCase) {
+		judgeBy(j, &c, evaluateExpected, evaluateActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gval/3
+
+// oddConditions is a ternary condition whose zero-value test differs from its conversion
+// to bool (the shape): a string that is no bool ("abc", "", "x y": an error as documented,
+// a branch taken by the zero test), "false" and "0" (false as documented, the then branch by
+// the zero test), the parameters s, m.e, arr and m. boolConditions is one the two agree on
+// (the region past): a bool, a number, "1", "true", the parameters x, z, b, f, u, n.
+var oddConditions = halvesGens([]int{5, 4},
+	hegel.Map(evenHalves("abc", "", "x y", "false", "0"), litS),
+	halvesGens([]int{1, 1, 1, 1}, hegel.Just(vr("s")), hegel.Just(vr("m", dot("e"))), hegel.Just(vr("arr")), hegel.Just(vr("m"))))
+
+var boolConditions = halvesGens([]int{2, 3, 2, 3},
+	boolLit,
+	hegel.Map(evenHalves(0.0, 1, 2.5), litF),
+	hegel.Map(evenHalves("1", "true"), litS),
+	hegel.Map(evenHalves("x", "z", "b", "f", "u", "n"), func(name string) *node { return vr(name) }))
+
+// oddTernaries is cond ? a : b with safe branches.
+var oddTernaries = hegel.FlatMap(hzShaped(oddConditions, boolConditions), func(cond *node) hegel.Generator[*node] {
+	return hegel.FlatMap(strictLeaf, func(a *node) hegel.Generator[*node] {
+		return hegel.Map(strictLeaf, func(b *node) *node { return ternary(cond, a, b) })
+	})
+})
+
+// TestHegelTernaryConditionsConvertToBool: c ? a : b converts c to a bool as the bool
+// operators do, an error when it does not convert (gval/3).
+func TestHegelTernaryConditionsConvertToBool(t *testing.T) {
+	judged(t, regionOf("gval/3", evaluateExpected, evaluateCasesOf(oddTernaries)), func(j *hzCaseJudge, c evaluateCase) {
+		judgeBy(j, &c, evaluateExpected, evaluateActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gval/4
+
+// badKeys is a key no element of a three-element array has (the shape): an index that is
+// a string, a number out of range, negative or not integral, the parameter s ("abc") or x
+// (3); or a dot key one time in eight. goodKeys is an index in range of a two-element array
+// (the region past): 0 or 1 as a number or as a numeric string.
+var badKeys = halvesGens([]int{3, 3, 1, 1},
+	hegel.Map(evenHalves("k", "s", "a", "b", "q"), func(s string) key { return at(lit(s)) }),
+	hegel.Map(evenHalves(lit(3.0), lit(7.0), lit(10.0), lit(2.5), lit(0.5), lit(1000.0), prefix("-", lit(1.0))), at),
+	hegel.Map(evenHalves("s", "x"), func(name string) key { return at(vr(name)) }),
+	hegel.Map(evenHalves("x", "k"), dot))
+
+var goodKeys = halvesGens([]int{2, 1},
+	hegel.Map(evenHalves(0.0, 1), func(f float64) key { return at(lit(f)) }),
+	hegel.Map(evenHalves("0", "1"), func(s string) key { return at(lit(s)) }))
+
+// indexedArrays is arr[i] or m2.a.b[i], followed half the time by one more key ([0], [1]
+// or .k: with the array kept in place of the error the path goes on from it).
+var indexedArrays = hegel.FlatMap(hzShaped(badKeys, goodKeys), func(index key) hegel.Generator[*node] {
+	return hegel.FlatMap(dieEven(0, 1), func(root int) hegel.Generator[*node] {
+		return hegel.Map(dieCounted(halvesGens([]int{1, 1, 1}, hegel.Just(at(lit(0.0))), hegel.Just(at(lit(1.0))), hegel.Just(dot("k"))), 0, 1, 1), func(more []key) *node {
+			if root == 0 {
+				return vr("arr", append([]key{index}, more...)...)
+			}
+			return vr("m2", append([]key{dot("a"), dot("b"), index}, more...)...)
+		})
+	})
+})
+
+// TestHegelBadArrayIndicesAreErrors: a key no element of an array has is the "unknown
+// parameter" error, as it is on a map (gval/4).
+func TestHegelBadArrayIndicesAreErrors(t *testing.T) {
+	judged(t, regionOf("gval/4", evaluateExpected, evaluateCasesOf(indexedArrays)), func(j *hzCaseJudge, c evaluateCase) {
+		judgeBy(j, &c, evaluateExpected, evaluateActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gval/5
+
+// erringConstants is a constant subexpression that errors when evaluated (the shape: the
+// parser folds it and reports a parsing error wherever it stands): an arithmetic on a
+// string or a bool (not + : true + 1 is the text "true1"), in on a number, a regex that
+// does not compile, a negated string or bool. fineConstants is one that evaluates (the
+// region past).
+var erringConstants = evenHalves(
+	infix("-", lit(1.0), lit("a")),
+	infix("*", lit("a"), lit(2.0)),
+	infix("-", lit(true), lit(1.0)),
+	infix("in", lit(1.0), lit(2.0)),
+	infix("=~", lit("a"), lit("[")),
+	prefix("-", lit("a")),
+	prefix("-", lit(true)),
+	prefix("!", lit("abc")))
+
+var fineConstants = evenHalves(
+	infix("+", lit(1.0), lit(2.0)),
+	infix("+", lit("a"), lit("b")),
+	infix("&&", lit(true), lit(false)),
+	infix("in", lit(3.0), &node{kind: "array", elts: []*node{lit(3.0)}}),
+	infix("=~", lit("a"), lit("^a")),
+	prefix("-", lit(1.0)),
+	prefix("!", lit(false)))
+
+// deadBranches is the constant in a branch the evaluation never reaches: the right of &&
+// under false (the literal or the parameter f), the right of || under true (true or b), a
+// branch of a ternary the condition skips, the right of ?? under a kept value.
+var deadBranches = hegel.FlatMap(hzShaped(erringConstants, fineConstants), func(e *node) hegel.Generator[*node] {
+	return hegel.FlatMap(strictLeaf, func(v *node) hegel.Generator[*node] {
+		return halvesGens([]int{2, 2, 1, 1, 1},
+			hegel.Map(evenHalves(lit(false), vr("f")), func(c *node) *node { return infix("&&", c, e) }),
+			hegel.Map(evenHalves(lit(true), vr("b")), func(c *node) *node { return infix("||", c, e) }),
+			hegel.Map(evenHalves(lit(true), vr("b")), func(c *node) *node { return ternary(c, v, e) }),
+			hegel.Map(evenHalves(lit(false), vr("f")), func(c *node) *node { return ternary(c, e, v) }),
+			hegel.Map(evenHalves(lit(1.0), lit("a"), vr("x")), func(c *node) *node { return infix("??", c, e) }))
+	})
+})
+
+// TestHegelDeadBranchesDoNotFailParsing: an expression parses whatever a branch the
+// evaluation never reaches would do (gval/5).
+func TestHegelDeadBranchesDoNotFailParsing(t *testing.T) {
+	judged(t, regionOf("gval/5", evaluateExpected, evaluateCasesOf(deadBranches)), func(j *hzCaseJudge, c evaluateCase) {
+		judgeBy(j, &c, evaluateExpected, evaluateActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gval/6
+
+// basePrefixedLits is an integer of the pool spelled with a base prefix (the shape: hex,
+// upper-case hex, binary, 0o octal, and the legacy octal of a value of 8 or more, which
+// gval reads as decimal); under HEGEL_NO_KNOWN=1 spelled plainly or by the two forms both
+// read alike (a hex float with a zero exponent, an underscore).
+var basePrefixedLits = hegel.FlatMap(evenHalves(0.0, 1, 2, 3, 7, 9, 10, 1000), func(f float64) hegel.Generator[*node] {
+	shapes, alike := basePrefixed(int64(f))
+	if f < 8 {
+		shapes = shapes[:len(shapes)-1] // the legacy octal of a digit is the digit
+	}
+	plain := strconv.FormatFloat(f, 'g', -1, 64)
+	return hegel.Map(hzShaped(evenHalves(shapes...), evenHalves(append([]string{plain}, alike...)...)), func(spell string) *node { return numNode(f, spell) })
+})
+
+// basePrefixedExprs is such a literal alone, or in a small context: L + 1, x * L, [L], L ==
+// its value, -L.
+var basePrefixedExprs = hegel.FlatMap(basePrefixedLits, func(l *node) hegel.Generator[*node] {
+	return halvesGens([]int{3, 1, 1, 1, 1, 1},
+		hegel.Just(l),
+		hegel.Just(infix("+", l, lit(1.0))),
+		hegel.Just(infix("*", vr("x"), l)),
+		hegel.Just(&node{kind: "array", elts: []*node{l}}),
+		hegel.Just(infix("==", l, lit(l.val))),
+		hegel.Just(prefix("-", l)))
+})
+
+// TestHegelBasePrefixedIntegersParse: an integer literal spelled as Go spells it (0x, 0b,
+// 0o, a leading 0) is read with its value (gval/6).
+func TestHegelBasePrefixedIntegersParse(t *testing.T) {
+	judged(t, regionOf("gval/6", evaluateExpected, evaluateCasesOf(basePrefixedExprs)), func(j *hzCaseJudge, c evaluateCase) {
+		judgeBy(j, &c, evaluateExpected, evaluateActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gval/7
+
+var chainOps = []string{"+", "-", "*", "/", "%", "<<", ">>", "&", "|", "^"}
+
+// chainTree is a o1 b o2 c as Go reads it: (a o1 b) o2 c when o1 binds at least as tightly
+// as o2 (equal precedences associate to the left), a o1 (b o2 c) otherwise; its minimal
+// rendering by Go's table is the chain unparenthesized.
+func chainTree(o1, o2 string, a, b, c *node) *node {
+	if goTable[o1] >= goTable[o2] {
+		return infix(o2, infix(o1, a, b), c)
+	}
+	return infix(o1, a, infix(o2, b, c))
+}
+
+// opPairs is the pairs of chain operators gval groups otherwise than Go (the shape: << >>
+// and & below + - instead of beside * /, | and ^ below + - instead of beside them), and
+// the pairs it groups alike (the region past), by the two tables.
+func opPairs(differ bool) [][2]string {
+	var out [][2]string
+	for _, o1 := range chainOps {
+		for _, o2 := range chainOps {
+			if (goTable[o1] >= goTable[o2]) != (gvalTable[o1] >= gvalTable[o2]) == differ {
+				out = append(out, [2]string{o1, o2})
+			}
+		}
+	}
+	return out
+}
+
+// chainLeaves is a small integer or x; a shift's right operand is 1, 2 or 3 (a larger count
+// shifts these values to zero under both groupings). Where the two groupings still coincide
+// in value (7 & 7 >> 1, say) regionOf filters the case out.
+var chainLeaves = halvesGens([]int{3, 1}, hegel.Map(evenHalves(2.0, 3, 5, 6, 7, 9, 10, 13), litF), hegel.Just(vr("x")))
+
+var shiftCounts = hegel.Map(evenHalves(1.0, 2, 3), litF)
+
+func chainLeafAfter(op string) hegel.Generator[*node] {
+	if op == "<<" || op == ">>" {
+		return shiftCounts
+	}
+	return chainLeaves
+}
+
+// goChains is a three-leaf chain over a pair of operators the two tables order
+// differently (under HEGEL_NO_KNOWN=1 alike).
+var goChains = hegel.FlatMap(evenHalves(hzShaped(opPairs(true), opPairs(false))...), func(ops [2]string) hegel.Generator[*node] {
+	return hegel.FlatMap(chainLeaves, func(a *node) hegel.Generator[*node] {
+		return hegel.FlatMap(chainLeafAfter(ops[0]), func(b *node) hegel.Generator[*node] {
+			return hegel.Map(chainLeafAfter(ops[1]), func(c *node) *node { return chainTree(ops[0], ops[1], a, b, c) })
+		})
+	})
+})
+
+// TestHegelGoPrecedenceIsRespected: an unparenthesized chain of arithmetic and bit
+// operators evaluates as Go groups it (gval/7). A chain gval groups into a shift by a
+// negative count (9 >> x - 7, say) has no documented value (the float to uint64
+// conversion): filtered out as in the wide properties (specifiedCases).
+func TestHegelGoPrecedenceIsRespected(t *testing.T) {
+	judged(t, regionOf("gval/7", evaluateExpected, specifiedCases(evaluateExpected, evaluateCasesOf(goChains))), func(j *hzCaseJudge, c evaluateCase) {
+		judgeBy(j, &c, evaluateExpected, evaluateActual)
+	})
+}
+
+// --------------------------------------------------------------------------- gval/8
+
+// zeroDivisors is a divisor that is zero at run time and not constant (the shape: a
+// constant zero divisor is folded by the parser, gval/5's shape); nonZeroDivisors one that
+// is not (the region past). x is 3.
+var zeroDivisors = evenHalves(
+	dinfix("-", dx, dlit("3")),
+	dinfix("-", dlit("3"), dx),
+	dinfix("*", dx, dlit("0")),
+	dinfix("*", dlit("0"), dx),
+	dinfix("%", dx, dlit("3")),
+	dinfix("%", dx, dlit("1")))
+
+var nonZeroDivisors = evenHalves(
+	dx,
+	dinfix("-", dx, dlit("2")),
+	dinfix("+", dx, dlit("1")),
+	dinfix("*", dx, dlit("2")),
+	dinfix("%", dx, dlit("2")))
+
+// runtimeDivisions is a safe tree divided (/ or %) by such a divisor.
+var runtimeDivisions = hegel.FlatMap(evenHalves("/", "%"), func(op string) hegel.Generator[*dnode] {
+	return hegel.FlatMap(decSafeTree, func(a *dnode) hegel.Generator[*dnode] {
+		return hegel.Map(hzShaped(zeroDivisors, nonZeroDivisors), func(b *dnode) *dnode { return dinfix(op, a, b) })
+	})
+})
+
+// TestHegelZeroDivisorsAreErrors: in DecimalArithmetic a division or modulo by zero is an
+// evaluation error, not a panic (gval/8).
+func TestHegelZeroDivisorsAreErrors(t *testing.T) {
+	judged(t, regionOf("gval/8", decimalExpected, decimalCasesOf(runtimeDivisions)), func(j *hzCaseJudge, c decimalCase) {
+		judgeBy(j, &c, decimalExpected, decimalActual)
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..f10d453
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,957 @@
+package hegel
+
+// Hegel property tests for PaesslerAG/gval, written for the Hegel zoo.
+// See targets/go/gval/README.md.
+//
+// Oracle: a random expression tree over the grammar of gval.Full, rendered to text by a pure
+// renderer (with minimal parentheses by Go's table of precedences, which the README promises,
+// or with every operand parenthesized, and a drawn spacing) and evaluated by a model of the
+// documented semantics: Go float64 arithmetic, the operator resolution order read off
+// operator.go (strict number, bool and text operands first, then the same with the documented
+// conversions, then the arbitrary fallback), short circuits, the variable selector on maps and
+// arrays, JSON literals, regex matching, the ternary and the coalescing forms; and for the
+// decimal language exact rationals with shopspring/decimal's 16-place division.
+//
+// The files: hegel_zoo_idioms_test.go has the generator idioms (the weighted choices, the
+// fair-bit dice, the halving helpers); this file the harness (hzOpts, hzProperty, the
+// collector, the known value, the judge, the classifier); hegel_zoo_model_test.go the
+// expression model and the renderer as pure functions, the decimal model, the replicas of
+// gval's rules with the switch set threaded, and the four expected functions;
+// hegel_zoo_cases_test.go the case records, their generators and the pools;
+// hegel_zoo_props_test.go the four wide properties; hegel_zoo_shapes_test.go one narrow
+// property per switched bug; hegel_pins_test.go the pins.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES, HEGEL_SEED
+// and HEGEL_VERBOSE are passed through hzOpts; a panic in the code under test is turned into
+// the check value "panic" by hzCall in the property (judged like any other value) and, as the
+// net under everything else, into a failure naming the shape by the judge's Recover.
+// HEGEL_COLLECT=1 (or ZOO_COLLECT=1) makes the properties record their mismatches instead of
+// failing and print the counts. The model states the documented behaviour (every switch of
+// the known value below off) and the properties judge the library against it; the shape of a
+// recorded bug is named by the classifier shapeBy, which runs the model per switch on the case
+// record before the library is called, fails by default "(the shape of gval/N)", and under
+// HEGEL_NO_KNOWN=1 the shapes are not drawn (a weight of zero: the base-prefixed spellings of
+// gval/6, the negation of a decimal value of gval/1) or filtered out (hzOnly on the
+// classifier: the zero-valued ?? operands, the non-bool ternary conditions, the bad array
+// indices, the folding errors, the chains the two precedence tables order differently, the
+// zero divisors), and in the narrow properties the region past the shape is drawn (hzShaped,
+// regionOf), so that a run looks past the known bugs.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hzOpts passes HEGEL_TEST_CASES, HEGEL_SEED and HEGEL_VERBOSE through to the engine, which
+// reads no environment variable itself (the seed is for the rate measurements of the probe
+// and the collector), and asks for one failure per run for the shrink budget.
+func hzOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	if hzShrinkBudget > 0 {
+		// The shrink budget: one failure per run (the engine otherwise generates on while
+		// the cases fail, ten times the count on a property that always fails, and its
+		// re-run of the failures before shrinking would meet a rejected attempt and end the
+		// run as "flaky" with nothing printed).
+		opts = append(opts, hegel.WithReportMultipleFailures(false))
+	}
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize ... go/gronx judge).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("HEGEL_COLLECT") != "" || os.Getenv("ZOO_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+	fails  int  // failing judgements so far (the shrink budget)
+	budget int  // the failing judgements allowed, set at the first failure
+	armed  bool // past the budget: reject the next attempt before it draws
+	cycles int  // the attempts so rejected
+}
+
+// hzShrinkBudget bounds the shrinking of a failure: the engine (hegel-go v0.6.33 over
+// libhegel) keeps every attempt of a shrink in memory and has no budget for it (go/mergo
+// measured 1.6 GB and 65 s for a shrink of a case of 3000 draws in a module of its own, more
+// inside a test binary). A case here is some hundreds of draws (the probe counts them) and
+// the model and the library are cheap, so the budget is rarely reached; it is kept from the
+// gotext ... gronx harness as it is: after a budget of failing judgements the next attempt
+// is rejected before its first draw (Assume: counted "budget skipped"), which ends the
+// shrink: the engine ends a shrink at an attempt rejected before it drew, then replays the
+// last failing attempt exactly for its report ("budget replayed", printed as usual). Were
+// the engine to shrink on past the undrawn rejection, the drawn attempt that fails arms the
+// next undrawn rejection, and after hzShrinkCycles such cycles every attempt is rejected
+// undrawn and the run ends without a message ("budget exhausted"). The budget is
+// hzShrinkBudget bytes of the first failure's message: the attempts allowed are the bytes
+// over the message's length, between 100 and 3000. HEGEL_SHRINK_BUDGET sets the bytes, 0
+// for no budget. Collect mode records every failure and never shrinks.
+var hzShrinkBudget = func() int {
+	if s := os.Getenv("HEGEL_SHRINK_BUDGET"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v >= 0 {
+			return v
+		}
+	}
+	return 400000
+}()
+
+// hzShrinkCycles bounds the alternation past the budget.
+const hzShrinkCycles = 100
+
+// hzShrinkAttempts is the failing judgements the budget allows for a first failure of n
+// bytes.
+func hzShrinkAttempts(n int) int {
+	if n < 1 {
+		n = 1
+	}
+	b := hzShrinkBudget / n
+	if b < 100 {
+		return 100
+	}
+	if b > 3000 {
+		return 3000
+	}
+	return b
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// observe records a message of a class that is not a failure (a replica disagreement):
+// counted, and its first two messages kept.
+func (c *hzCollector) observe(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept; otherwise it is fatal, within the shrink budget.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	c.mu.Lock()
+	if c.fails == 0 && hzShrinkBudget > 0 {
+		c.budget = hzShrinkAttempts(len(msg))
+	}
+	if c.budget > 0 && c.fails >= c.budget {
+		// past the budget: the attempt that drew is the engine's replay of the last failure
+		// (the undrawn rejection before it ended the shrink) and prints as usual; were it a
+		// shrink attempt instead, the next attempt is rejected before drawing again
+		c.armed = true
+		c.counts["budget replayed"]++
+		c.mu.Unlock()
+		ht.Fatalf("%s", msg)
+	}
+	c.fails++
+	if c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+	ht.Fatalf("%s", msg)
+}
+
+// skip is whether the attempt is to be rejected before it draws (the budget spent and the
+// previous attempt drawn); past hzShrinkCycles, always.
+func (c *hzCollector) skip() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.budget == 0 || c.fails < c.budget {
+		return false
+	}
+	if c.cycles >= hzShrinkCycles {
+		c.counts["budget exhausted"]++
+		return true
+	}
+	if !c.armed {
+		return false
+	}
+	c.armed = false
+	c.cycles++
+	c.counts["budget skipped"]++
+	return true
+}
+
+// rearm: an attempt past the budget that drew and did not fail arms the next.
+func (c *hzCollector) rearm() {
+	c.mu.Lock()
+	if c.budget > 0 && c.fails >= c.budget {
+		c.armed = true
+	}
+	c.mu.Unlock()
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml), indexed by the constants below (the index of a switch
+// is the bug's id minus one: hzKnownID(i) = "gval/<i+1>"). The four expected functions of
+// hegel_zoo_model_test.go are pure functions of (case, known): with every switch off
+// (hzKnownNone) they state the documented behaviour and are what the properties judge the
+// library against; with a switch on they reproduce that bug as a replica of the library's
+// rule, transcribed from gval.go, parse.go, evaluable.go and operator.go (and shopspring/
+// decimal's decimal.go) at the lines named beside the switch. The classifier runs the model
+// with several sets to name the shape of a case before the library is called; the pins
+// assert the documented behaviour and fail while the bug exists.
+type known [8]bool
+
+const (
+	// gval/1: DecimalArithmetic cannot negate a decimal (the decimal language's prefix "-",
+	// gval.go :216-222, converts its operand with convertToFloat, operator.go :201-228,
+	// which knows floats, integers and numeric strings but not decimal.Decimal, so every
+	// operand that is a decimal value - a literal, parse.go :104-110, or the result of any
+	// decimal operator - is "unexpected v(decimal.Decimal) expected number"; the bare float
+	// parameter x converts)
+	kDecimalNegateFails = 0
+	// gval/2: a ?? b returns b for 0, the empty string and empty values (gval.go :125-134:
+	// the short circuit keeps a when a != nil && !reflect.ValueOf(a).IsZero(), the operator
+	// returns b when a == nil || IsZero; the documentation says only nil and false give b)
+	kCoalesceZeroValues = 1
+	// gval/3: the ternary condition is tested for the zero value, not converted to bool
+	// (parseIf, parse.go :277: x == nil || reflect.ValueOf(x).IsZero() selects the else
+	// branch; convertToBool, operator.go :144-180, is what the documentation promises)
+	kTernaryZeroNotBool = 2
+	// gval/4: an out-of-range or non-integer index on an array returns the array itself
+	// (variable, evaluable.go :141-145: the []interface{} case assigns and continues only
+	// on an integer index in range, otherwise falls out of the switch with v2 unchanged,
+	// where the default case, :146-151, reports "unknown parameter")
+	kArrayBadIndexReturnsArray = 3
+	// gval/5: constant folding evaluates constant subexpressions at parse time, so a
+	// short-circuited or unreached branch fails the whole expression (stageStack.push,
+	// operator.go :21-40, evaluates an infix whose operands are both Const when it reduces
+	// it and returns the error; PrefixOperator, language.go :201-207, the same for a prefix
+	// of a Const; regEx and notRegEx, evaluable.go :304-366, compile a Const pattern when
+	// the operator is built; an error there is NewEvaluable's, language.go :74-77)
+	kConstantFoldingParseErrors = 4
+	// gval/6: integer literals with a base prefix are rejected (parseNumber, parse.go
+	// :96-102, hands the scanner's Int token to strconv.ParseFloat, which reads hex only with
+	// a p exponent and nothing of 0b, 0o or a legacy 0 octal, read as decimal)
+	kBasePrefixedIntsRejected = 5
+	// gval/7: the precedence of shifts and the bit operators is not Go's (gval.go
+	// :304-333: ^ & | 60, << >> 90, + - 120, * / % 150; Go has << >> & with * / and | ^
+	// with + -, the README promising "the normal Go-standard order")
+	kPrecedenceNotGo = 6
+	// gval/8: DecimalArithmetic division by zero panics (gval.go :201-202 call Div and Mod;
+	// shopspring/decimal v1.3.1's QuoRem, decimal.go :561-565, panics "decimal division by
+	// 0" on a zero divisor, Div :551 and Mod :630 go through it; nothing recovers, at parse
+	// time in a fold as at run time)
+	kDecimalDivideByZeroPanics = 7
+	hzKnownCount               = 8
+)
+
+// hzKnownRead are the switches the model reads, in bug order: the classifier sweeps these.
+var hzKnownRead = []int{kDecimalNegateFails, kCoalesceZeroValues, kTernaryZeroNotBool, kArrayBadIndexReturnsArray,
+	kConstantFoldingParseErrors, kBasePrefixedIntsRejected, kPrecedenceNotGo, kDecimalDivideByZeroPanics}
+
+// hzKnownID is the bug id of a switch ("gval/N"); hzKnownIndex the switch of a bug id (-1
+// for none or the hole).
+func hzKnownID(i int) string { return "gval/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "gval/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for _, i := range hzKnownRead {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape gval/N"
+// per case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape via hole", the latter two with the id), the cases skipped for them under
+// HEGEL_NO_KNOWN=1 ("known gval/N"), the cases whose checks were dropped ("dropped gval/N")
+// and the checks ("dropped check <name>"), the draws the filters rejected ("filtered
+// <name>"), the replica's agreement with the library on the shaped cases ("replica
+// agreement", "replica disagreement"), the properties' own tallies of what their cases
+// reached (the rates of the report), and the cases assumed away for an unrecorded candidate
+// bug ("candidate/go/gval-N"); printed and reset by the collector, under hzStatsMu.
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize ... go/gronx judge, with the
+// collector's mismatch classes): it names the recorded bug whose shape the case has, so that
+// a mismatch or a library panic fails "(the shape of gval/N)", and under HEGEL_NO_KNOWN=1
+// skips the case instead (counted as known) or drops the checks the shape covers (Dropped).
+// The wide and the narrow properties share their judge functions and so this. The classifier
+// that names the shape is computed from the case record alone (the model run with several
+// sets of switches).
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the regions past the shapes
+// are drawn, or the shaped cases filtered out), and the collector measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped gval/N") and the case goes on
+// (judgeByDropping).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow). The properties call the library through hzCall, which
+// turns its panic into the check value "panic" judged like any other value; this is the net
+// under everything else.
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		if col.skip() {
+			ht.Assume(false)
+		}
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+		col.rearm()
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (the go/carbon ... go/gronx form: every value here is text; a model states a
+// set of acceptable values per check and the library's value agrees by membership).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole map for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two. Every value is a set of strings spelled
+// `{"a" | "b"}` (hzSet: the members quoted, sorted, unique); the library's is a set of one
+// (hzValue). The checks of this target are named in the model file; every model here states
+// one value per check.
+type checks map[string]string
+
+// hzSet spells a set of acceptable values; hzValue a set of one.
+func hzSet(vals ...string) string {
+	sort.Strings(vals)
+	var parts []string
+	for i, v := range vals {
+		if i > 0 && v == vals[i-1] {
+			continue
+		}
+		parts = append(parts, strconv.Quote(v))
+	}
+	return "{" + strings.Join(parts, " | ") + "}"
+}
+
+func hzValue(v any) string { return hzSet(fmt.Sprint(v)) }
+
+// hzMembers reads a set back (a value that is not a set is a set of itself).
+func hzMembers(s string) []string {
+	if !strings.HasPrefix(s, "{") || !strings.HasSuffix(s, "}") {
+		return []string{s}
+	}
+	rest := s[1 : len(s)-1]
+	var out []string
+	for rest != "" {
+		q, err := strconv.QuotedPrefix(rest)
+		if err != nil {
+			return []string{s}
+		}
+		v, _ := strconv.Unquote(q)
+		out = append(out, v)
+		rest = strings.TrimPrefix(rest[len(q):], " | ")
+	}
+	return out
+}
+
+func (c checks) set(name string, v any) { c[name] = hzValue(v) }
+
+// checkRank is the order the checks of a case are reported in when it fails (and the first
+// differing one classes the failure): the model file fills it; the rest by name.
+var checkRank = map[string]int{}
+
+func checkLess(a, b string) bool {
+	ar, aok := checkRank[a]
+	br, bok := checkRank[b]
+	if !aok {
+		ar = 1000
+	}
+	if !bok {
+		br = 1000
+	}
+	if ar != br {
+		return ar < br
+	}
+	return a < b
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two model statements agree: the same checks, each value equal
+// (the classifier's comparison; the sets are spelled canonically).
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeValue reports whether the library's value of a check agrees with a model's: every
+// member of the library's set is a member of the model's.
+func agreeValue(name, got, want string) bool {
+	if got == want {
+		return true
+	}
+	ws := hzMembers(want)
+	for _, g := range hzMembers(got) {
+		found := false
+		for _, w := range ws {
+			if g == w {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+// agreeChecks reports whether the library's values agree with a model's: the same checks,
+// each by agreeValue.
+func agreeChecks(got, want checks) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for k, v := range want {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, v) {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order; the long values are cut, the explanation of a case shows the difference.
+func diffChecks(a, b checks) string {
+	var parts []string
+	cut := func(s string) string {
+		if len(s) > 300 {
+			return s[:300] + "..."
+		}
+		return s
+	}
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || !agreeValue(k, a[k], w) {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, cut(a[k])))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, cut(a[k]), cut(w)))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, cut(b[k])))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("gval/?", a defect of the model). The
+// order matters where two shapes meet (a zero-valued ?? whose right side holds a folding
+// error is gval/2's shape and gval/5's: 2 is named; a constant zero divisor in the decimal
+// language is a folding error and a panic: 5 is named): sufficiency in bug order names the
+// lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for _, i := range hzKnownRead {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "gval/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule; in collect mode
+// also every switch that alone moves the model ("sufficient gval/N": the overlaps).
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+		if rule != "sufficiency" {
+			hzTally("shape via " + rule + " " + shape)
+		}
+		if hzCollecting {
+			none := expected(c, hzKnownNone)
+			var ids []string
+			for _, i := range hzKnownRead {
+				if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+					hzTally("sufficient " + hzKnownID(i))
+					ids = append(ids, hzKnownID(i))
+				}
+			}
+			if len(ids) > 1 {
+				hzTally("sufficient together " + strings.Join(ids, "+"))
+			}
+		}
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// classOf is the collector class of a check name: the name without its index ("eval 1" is
+// "eval").
+func classOf(name string) string {
+	if i := strings.IndexByte(name, ' '); i > 0 {
+		if _, err := strconv.Atoi(name[i+1:]); err == nil {
+			return name[:i]
+		}
+	}
+	return name
+}
+
+// explainer is a case record that explains a failure in its own terms; the verdict appends
+// it.
+type explainer interface {
+	explain(got, want checks) string
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agreeChecks(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.observe("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if agreeChecks(got, want) {
+		if shape != "" {
+			// named by the classifier but passing: the replica's sets differ from the
+			// documented ones on checks where the library's one value is in both
+			hzTally("shaped pass")
+			j.col.observe("shaped pass", "%s against %s for\n%#v", diffChecks(expected(c, hzKnownAll), want), shape, c)
+		}
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || !agreeValue(k, g, want[k]) {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	more := ""
+	if e, ok := any(c).(explainer); ok {
+		more = e.explain(got, want)
+	}
+	j.Fail(classOf(class), "%s for\n%#v%s", diffChecks(got, want), c, more)
+}
+
+// memoized is expected remembering its statements by switch set for one case (the
+// classifier and the verdict ask for the documented and the full replica statements more
+// than once; a known value is a comparable array).
+func memoized[T any](expected func(T, known) checks) func(T, known) checks {
+	memo := map[known]checks{}
+	return func(c T, k known) checks {
+		if out, ok := memo[k]; ok {
+			return out
+		}
+		out := expected(c, k)
+		memo[k] = out
+		return out
+	}
+}
+
+// judgeBy is the judge of a family: the shape first, from the case alone (the classifier
+// runs the model per switch BEFORE the library is called: under HEGEL_NO_KNOWN=1 a shaped
+// case the generators let through is skipped without a library call), then the library. The
+// models here are cheap (an expression tree of a few nodes), so the classifier runs on every
+// case. The case is passed by pointer: actual may record on it what the library left (the
+// explanation of a failure).
+func judgeBy[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks) {
+	expected = memoized(expected)
+	want := expected(*c, hzKnownNone)
+	shape := classify(*c, expected)
+	j.Shape(shape)
+	got := actual(c)
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// droppedChecks is the set of checks the switches ids change on their own: the checks on
+// which expected(c, only id) differs from expected(c, none), by name, with the first id that
+// changes it.
+func droppedChecks[T any](c T, expected func(T, known) checks, ids []int) map[string]int {
+	none := expected(c, hzKnownNone)
+	out := map[string]int{}
+	for _, i := range ids {
+		only := expected(c, hzKnownOnly(i))
+		for name, v := range none {
+			if w, ok := only[name]; !ok || w != v {
+				if _, done := out[name]; !done {
+					out[name] = i
+				}
+			}
+		}
+		for name := range only {
+			if _, ok := none[name]; !ok {
+				if _, done := out[name]; !done {
+					out[name] = i
+				}
+			}
+		}
+	}
+	return out
+}
+
+// pastSwitches is the model over the checks the switches ids do not change on their own (the
+// restricted check set): a wide property's view under HEGEL_NO_KNOWN=1 where a shape's checks
+// are dropped rather than the case skipped, and a narrow property's view where another bug's
+// checks are left out so that the property is judged on its own bug.
+func pastSwitches[T any](expected func(T, known) checks, ids []int) func(T, known) checks {
+	return func(c T, k known) checks {
+		drop := droppedChecks(c, expected, ids)
+		out := checks{}
+		for name, v := range expected(c, k) {
+			if _, gone := drop[name]; !gone {
+				out[name] = v
+			}
+		}
+		return out
+	}
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi, go/go-debian, go/roaring, go/gotext, go/go-envconfig,
+// go/gronx form): by default the shape is named and every check judged; under HEGEL_NO_KNOWN=1
+// the checks the switches drops change on their own (droppedChecks) are dropped from the case
+// (hzCaseJudge.Dropped, counted "dropped gval/N" per switch and "dropped check <name>"), the
+// rest classified again and judged, the case not skipped unless a shape remains. (Kept with
+// the harness; no property of this target drops: every shape here is a small share of its
+// property's cases and is filtered out instead.)
+func judgeByDropping[T any](j *hzCaseJudge, c *T, expected func(T, known) checks, actual func(*T) checks, drops []int) {
+	expected = memoized(expected)
+	want := expected(*c, hzKnownNone)
+	if hzNoKnown {
+		drop := droppedChecks(*c, expected, drops)
+		if len(drop) > 0 {
+			seen := map[int]bool{}
+			for name, i := range drop {
+				if !seen[i] {
+					seen[i] = true
+					j.Dropped(hzKnownID(i))
+				}
+				hzTally("dropped check " + classOf(name))
+				delete(want, name)
+			}
+			hzTally("dropped case")
+		}
+		past := memoized(pastSwitches(expected, drops))
+		shape := classify(*c, past)
+		j.Shape(shape)
+		got := actual(c)
+		verdict(j, *c, got, want, shape, past)
+		return
+	}
+	shape := classify(*c, expected)
+	j.Shape(shape)
+	got := actual(c)
+	verdict(j, *c, got, want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few model runs. The
+// rejections are also counted by the shape the case had ("filtered <id> as <shape>", "as
+// none" for no shape), which says what the surroundings bring in.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool {
+		got := shapeID(c, expected)
+		if got == want {
+			return true
+		}
+		if got == "" {
+			got = "none"
+		}
+		hzTally("filtered " + id + " as " + got)
+		return false
+	})
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered gval/N" by the shape it had), g itself otherwise: a
+// wide property's filter, after the shapes a weight of zero has switched off.
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCall runs a library call and returns what it panicked with (nil when it returned): the
+// properties turn it into the check value "panic".
+func hzCall(f func()) (panicked any) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	f()
+	return nil
+}
