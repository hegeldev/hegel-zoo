index 0000000..c1882c7
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,900 @@
+package hegel
+
+// The model: random expression trees over gval.Full's grammar, rendered to text with minimal
+// or full parenthesization and random spacing, and evaluated by a model of the documented
+// semantics: Go float64 arithmetic, the operator resolution order (strict operand types before
+// conversions: number, bool, text, then the arbitrary fallback), short circuits, the variable
+// selector on maps and arrays, JSON literals, regex matching and the ternary/coalescing forms.
+
+import (
+	"fmt"
+	"math"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- trees
+
+type node struct {
+	kind string // lit var prefix infix ternary array object
+	val  any    // lit: float64 (>= 0), string, bool
+	name string // var: root identifier
+	keys []key  // var: path after the root
+	op   string
+	a, b *node // prefix: a; infix: a, b; ternary: cond=a, then=b, else=c (c nil: no else)
+	c    *node
+	elts []*node // array elements / object values
+	oks  []*node // object keys
+}
+
+type key struct {
+	dot  bool   // .ident
+	name string // dot key
+	expr *node  // [expr]
+}
+
+var precedence = map[string]int{
+	"??": 0, "||": 20, "&&": 21,
+	"==": 40, "!=": 40, ">": 40, ">=": 40, "<": 40, "<=": 40, "=~": 40, "!~": 40, "in": 40,
+	"^": 60, "&": 60, "|": 60, "<<": 90, ">>": 90, "+": 120, "-": 120, "*": 150, "/": 150, "%": 150, "**": 200,
+}
+
+var infixOps = []string{"+", "-", "*", "/", "%", "**", "==", "!=", ">", ">=", "<", "<=", "&&", "||", "??", "in", "=~", "!~", "^", "&", "|", "<<", ">>"}
+
+var numSet = []float64{0, 1, 2, 3, 7, 10, 0.5, 2.5, 1000, 9, 1e21, 0.1}
+
+var strSet = []string{"", "a", "abc", "b", "1", "3", "10", "9", "true", "false", "TRUE", "0", "1.0", "x y", "☺"}
+
+var regexSet = []string{"a", "^a", "b$", "^$", `\d`, ".*", "1", "^3$", "[", "(", "c"}
+
+// params is the parameter map the expressions run against.
+func params() map[string]any {
+	return map[string]any{
+		"x": 3.0, "y": 0.5, "z": 0.0, "s": "abc", "t": "3", "u": "true", "b": true, "f": false, "n": nil,
+		"arr": []any{1.0, "a", true}, "m": map[string]any{"k": 1.0, "s": "x", "e": ""},
+		"m2": map[string]any{"a": map[string]any{"b": []any{2.0, 4.0}}},
+	}
+}
+
+// params2 has the same shape with other values (for the reuse property).
+func params2() map[string]any {
+	return map[string]any{
+		"x": 0.0, "y": 2.0, "z": 5.0, "s": "b", "t": "10", "u": "false", "b": false, "f": true, "n": 7.0,
+		"arr": []any{"z", 0.0}, "m": map[string]any{"k": "1", "s": 2.0, "e": nil},
+		"m2": map[string]any{"a": map[string]any{"b": []any{}}},
+	}
+}
+
+var varNames = []string{"x", "y", "z", "s", "t", "u", "b", "f", "n", "arr", "m", "m2", "q"}
+
+var dotKeys = []string{"k", "s", "e", "a", "b", "q", "x"}
+
+func genLit(tc hegel.TestCase) *node {
+	switch drawInt(tc, 0, 3) {
+	case 0, 1:
+		return &node{kind: "lit", val: pick(tc, numSet)}
+	case 2:
+		return &node{kind: "lit", val: pick(tc, strSet)}
+	default:
+		return &node{kind: "lit", val: chance(tc, 50)}
+	}
+}
+
+var numVars = []string{"x", "y", "z", "t"}
+
+// genNumeric draws a leaf that converts to a number (a number, a numeric string or variable).
+func genNumeric(tc hegel.TestCase) *node {
+	switch drawInt(tc, 0, 3) {
+	case 0, 1:
+		return &node{kind: "lit", val: pick(tc, numSet)}
+	case 2:
+		return &node{kind: "lit", val: pick(tc, []string{"1", "3", "10", "0", "1.0", "9"})}
+	default:
+		return &node{kind: "var", name: pick(tc, numVars)}
+	}
+}
+
+func genVar(tc hegel.TestCase, depth int) *node {
+	n := &node{kind: "var", name: pick(tc, varNames)}
+	if n.name != "m" && n.name != "m2" && n.name != "arr" && chance(tc, 80) {
+		return n // paths below scalars are errors; keep them rare
+	}
+	for i := drawInt(tc, 0, 2); i > 0; i-- {
+		if chance(tc, 50) {
+			n.keys = append(n.keys, key{dot: true, name: pick(tc, dotKeys)})
+		} else {
+			var k *node
+			switch drawInt(tc, 0, 3) {
+			case 0:
+				k = &node{kind: "lit", val: float64(drawInt(tc, 0, 3))}
+			case 1:
+				k = &node{kind: "lit", val: pick(tc, []string{"k", "s", "a", "b", "0", "1", "q"})}
+			default:
+				if depth > 0 {
+					k = genExpr(tc, depth-1, false)
+				} else {
+					k = &node{kind: "lit", val: 1.0}
+				}
+			}
+			n.keys = append(n.keys, key{expr: k})
+		}
+	}
+	return n
+}
+
+// genExpr draws an expression; elseless ternaries only when top is set.
+func genExpr(tc hegel.TestCase, depth int, top bool) *node {
+	if depth <= 0 || chance(tc, 20) {
+		if chance(tc, 60) {
+			return genLit(tc)
+		}
+		return genVar(tc, 0)
+	}
+	r := drawInt(tc, 1, 100)
+	switch {
+	case r <= 50:
+		op := pick(tc, infixOps)
+		n := &node{kind: "infix", op: op, a: genExpr(tc, depth-1, false), b: genOperand(tc, depth-1)}
+		if numeric := precedence[op] >= 60; numeric && chance(tc, 60) {
+			// arithmetic and bitwise operators mostly on numeric-looking operands
+			if chance(tc, 50) {
+				n.a = genNumeric(tc)
+			}
+			if chance(tc, 50) {
+				n.b = genNumeric(tc)
+			}
+		}
+		return n
+	case r <= 62:
+		return &node{kind: "prefix", op: pick(tc, []string{"-", "!", "~"}), a: genExpr(tc, depth-1, false)}
+	case r <= 72:
+		n := &node{kind: "ternary", a: genExpr(tc, depth-1, false), b: genExpr(tc, depth-1, false)}
+		if !top || chance(tc, 80) {
+			n.c = genExpr(tc, depth-1, false)
+		}
+		return n
+	case r <= 80:
+		n := &node{kind: "array"}
+		for i := drawInt(tc, 0, 3); i > 0; i-- {
+			n.elts = append(n.elts, genExpr(tc, depth-1, false))
+		}
+		return n
+	case r <= 86:
+		n := &node{kind: "object"}
+		for i := drawInt(tc, 0, 3); i > 0; i-- {
+			var k *node
+			if chance(tc, 70) {
+				k = &node{kind: "lit", val: pick(tc, []string{"a", "b", "k", ""})}
+			} else {
+				k = genExpr(tc, depth-1, false)
+			}
+			n.oks = append(n.oks, k)
+			n.elts = append(n.elts, genExpr(tc, depth-1, false))
+		}
+		return n
+	default:
+		return genVar(tc, depth-1)
+	}
+}
+
+// genOperand favours regex literals on the right of =~ and arrays on the right of in.
+func genOperand(tc hegel.TestCase, depth int) *node {
+	if chance(tc, 25) {
+		return &node{kind: "lit", val: pick(tc, regexSet)}
+	}
+	if chance(tc, 20) {
+		n := &node{kind: "array"}
+		for i := drawInt(tc, 0, 3); i > 0; i-- {
+			n.elts = append(n.elts, genLit(tc))
+		}
+		return n
+	}
+	return genExpr(tc, depth, false)
+}
+
+// --------------------------------------------------------------------------- rendering
+
+type renderer struct {
+	tc    hegel.TestCase
+	full  bool // parenthesize every operand
+	space bool
+	sb    strings.Builder
+}
+
+func render(tc hegel.TestCase, n *node, full bool) string {
+	r := &renderer{tc: tc, full: full, space: chance(tc, 70)}
+	r.expr(n)
+	return r.sb.String()
+}
+
+func (r *renderer) sp() {
+	if r.space {
+		switch drawInt(r.tc, 0, 4) {
+		case 0:
+			r.sb.WriteString("  ")
+		case 1:
+			r.sb.WriteString("\t")
+		case 2:
+			r.sb.WriteString("\n")
+		default:
+			r.sb.WriteString(" ")
+		}
+	}
+}
+
+func fmtNum(tc hegel.TestCase, f float64) string {
+	s := strconv.FormatFloat(f, 'g', -1, 64)
+	if f == math.Trunc(f) && f < 1e15 && chance(tc, 20) {
+		return s + ".0"
+	}
+	if f == math.Trunc(f) && f < 1e15 && f >= 1 && chance(tc, 10) {
+		return s + "."
+	}
+	if strings.HasPrefix(s, "0.") && chance(tc, 30) {
+		return s[1:]
+	}
+	return s
+}
+
+func (r *renderer) lit(v any) {
+	switch t := v.(type) {
+	case float64:
+		r.sb.WriteString(fmtNum(r.tc, t))
+	case string:
+		if !strings.ContainsAny(t, "`") && chance(r.tc, 20) {
+			r.sb.WriteString("`" + t + "`")
+		} else {
+			r.sb.WriteString(strconv.Quote(t))
+		}
+	case bool:
+		fmt.Fprintf(&r.sb, "%t", t)
+	}
+}
+
+func (r *renderer) paren(n *node) {
+	r.sb.WriteByte('(')
+	r.sp()
+	r.expr(n)
+	r.sp()
+	r.sb.WriteByte(')')
+}
+
+// primary renders n as an operand of a prefix operator: literals, variables, JSON literals and
+// other prefixes stand alone, everything else needs parentheses.
+func (r *renderer) primary(n *node) {
+	switch n.kind {
+	case "lit", "var", "array", "object", "prefix":
+		if r.full && n.kind != "lit" && n.kind != "var" {
+			r.paren(n)
+		} else {
+			r.expr(n)
+		}
+	default:
+		r.paren(n)
+	}
+}
+
+// operand renders a child of an infix of precedence p; right operands need parentheses at
+// equal precedence (left associativity), ternaries always.
+func (r *renderer) operand(n *node, p int, right bool) {
+	need := false
+	switch n.kind {
+	case "infix":
+		q := precedence[n.op]
+		need = q < p || (right && q == p)
+	case "ternary":
+		need = true
+	}
+	if r.full && n.kind != "lit" && n.kind != "var" && n.kind != "array" && n.kind != "object" {
+		need = true
+	}
+	if need {
+		r.paren(n)
+	} else {
+		r.expr(n)
+	}
+}
+
+func (r *renderer) expr(n *node) {
+	switch n.kind {
+	case "lit":
+		r.lit(n.val)
+	case "var":
+		r.sb.WriteString(n.name)
+		for _, k := range n.keys {
+			if k.dot {
+				r.sb.WriteString("." + k.name)
+			} else {
+				r.sb.WriteByte('[')
+				r.sp()
+				r.expr(k.expr)
+				r.sp()
+				r.sb.WriteByte(']')
+			}
+		}
+	case "prefix":
+		r.sb.WriteString(n.op)
+		if n.op == "-" && n.a.kind == "prefix" && n.a.op == "-" {
+			r.sb.WriteByte(' ') // "--" would still parse, but keep the two tokens apart
+		}
+		r.primary(n.a)
+	case "infix":
+		p := precedence[n.op]
+		r.operand(n.a, p, false)
+		if n.op == "in" {
+			r.sb.WriteString(" in ")
+		} else {
+			r.sp()
+			r.sb.WriteString(n.op)
+			r.sp()
+		}
+		r.operand(n.b, p, true)
+	case "ternary":
+		if n.a.kind == "ternary" || r.full {
+			r.paren(n.a)
+		} else {
+			r.expr(n.a)
+		}
+		r.sp()
+		r.sb.WriteByte('?')
+		r.sp()
+		if r.full {
+			r.paren(n.b)
+		} else {
+			r.expr(n.b)
+		}
+		if n.c != nil {
+			r.sp()
+			r.sb.WriteByte(':')
+			r.sp()
+			if r.full {
+				r.paren(n.c)
+			} else {
+				r.expr(n.c)
+			}
+		}
+	case "array":
+		r.sb.WriteByte('[')
+		for i, e := range n.elts {
+			if i > 0 {
+				r.sb.WriteByte(',')
+				r.sp()
+			}
+			r.expr(e)
+		}
+		r.sb.WriteByte(']')
+	case "object":
+		r.sb.WriteByte('{')
+		for i, e := range n.elts {
+			if i > 0 {
+				r.sb.WriteByte(',')
+				r.sp()
+			}
+			r.expr(n.oks[i])
+			r.sp()
+			r.sb.WriteByte(':')
+			r.sp()
+			r.expr(e)
+		}
+		r.sb.WriteByte('}')
+	}
+}
+
+// --------------------------------------------------------------------------- evaluation model
+
+type evalErr struct{ msg string }
+
+func (e *evalErr) Error() string { return e.msg }
+
+// unspecified marks a case whose outcome Go leaves implementation-defined (float to integer
+// conversions out of range) or that the model does not predict.
+type unspecified struct{ why string }
+
+func (u *unspecified) Error() string { return "unspecified: " + u.why }
+
+func fail(format string, args ...any) error { return &evalErr{fmt.Sprintf(format, args...)} }
+
+func toFloat(v any) (float64, bool) {
+	switch t := v.(type) {
+	case float64:
+		return t, true
+	case string:
+		f, err := strconv.ParseFloat(t, 64)
+		return f, err == nil
+	}
+	return 0, false
+}
+
+func toBool(v any) (bool, bool) {
+	switch t := v.(type) {
+	case bool:
+		return t, true
+	case nil:
+		return false, true
+	case string:
+		switch t {
+		case "false", "FALSE":
+			return false, true
+		case "true", "TRUE":
+			return true, true
+		}
+	}
+	if f, ok := toFloat(v); ok {
+		return f != 0, true
+	}
+	return false, false
+}
+
+func evalString(v any) string {
+	if s, ok := v.(string); ok {
+		return s
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+func isZero(v any) bool {
+	return v == nil || reflect.ValueOf(v).IsZero()
+}
+
+// toInt64 converts as Go's int64(f) does where that is defined.
+func toInt64(f float64) (int64, error) {
+	if math.IsNaN(f) || math.IsInf(f, 0) || f >= 9223372036854775808.0 || f < -9223372036854775808.0 {
+		return 0, &unspecified{"float to int64 out of range"}
+	}
+	return int64(f), nil
+}
+
+func toUint64(f float64) (uint64, error) {
+	if math.IsNaN(f) || math.IsInf(f, 0) || f < 0 || f >= 18446744073709551616.0 {
+		return 0, &unspecified{"float to uint64 out of range"}
+	}
+	return uint64(f), nil
+}
+
+// numberOp is the float64 operation of op, if any.
+func numberOp(op string, a, b float64) (any, bool, error) {
+	switch op {
+	case "+":
+		return a + b, true, nil
+	case "-":
+		return a - b, true, nil
+	case "*":
+		return a * b, true, nil
+	case "/":
+		return a / b, true, nil
+	case "%":
+		return math.Mod(a, b), true, nil
+	case "**":
+		return math.Pow(a, b), true, nil
+	case ">":
+		return a > b, true, nil
+	case ">=":
+		return a >= b, true, nil
+	case "<":
+		return a < b, true, nil
+	case "<=":
+		return a <= b, true, nil
+	case "==":
+		return a == b, true, nil
+	case "!=":
+		return a != b, true, nil
+	case "^", "&", "|":
+		x, err := toInt64(a)
+		if err != nil {
+			return nil, true, err
+		}
+		y, err := toInt64(b)
+		if err != nil {
+			return nil, true, err
+		}
+		switch op {
+		case "^":
+			return float64(x ^ y), true, nil
+		case "&":
+			return float64(x & y), true, nil
+		default:
+			return float64(x | y), true, nil
+		}
+	case "<<", ">>":
+		x, err := toInt64(a)
+		if err != nil {
+			return nil, true, err
+		}
+		y, err := toUint64(b)
+		if err != nil {
+			return nil, true, err
+		}
+		if op == "<<" {
+			return float64(x << y), true, nil
+		}
+		return float64(x >> y), true, nil
+	}
+	return nil, false, nil
+}
+
+func textOp(op string, a, b string) (any, bool) {
+	switch op {
+	case "+":
+		return a + b, true
+	case "<":
+		return a < b, true
+	case "<=":
+		return a <= b, true
+	case ">":
+		return a > b, true
+	case ">=":
+		return a >= b, true
+	}
+	return nil, false
+}
+
+func boolOp(op string, a, b bool) (any, bool) {
+	switch op {
+	case "&&":
+		return a && b, true
+	case "||":
+		return a || b, true
+	case "==":
+		return a == b, true
+	case "!=":
+		return a != b, true
+	}
+	return nil, false
+}
+
+// applyInfix resolves op on evaluated operands in gval's order: strict number, strict bool,
+// strict text, then the same with conversions (text only when there is no arbitrary
+// fallback), then the arbitrary fallback, else an error.
+func applyInfix(op string, a, b any) (any, error) {
+	_, hasNum, _ := numberOp(op, 0, 0)
+	_, hasText := textOp(op, "", "")
+	_, hasBool := boolOp(op, false, false)
+	arbitrary := op == "==" || op == "!=" || op == "in" || op == "??"
+	if hasNum {
+		if x, ok := a.(float64); ok {
+			if y, ok := b.(float64); ok {
+				v, _, err := numberOp(op, x, y)
+				return v, err
+			}
+		}
+	}
+	if hasBool {
+		if x, ok := a.(bool); ok {
+			if y, ok := b.(bool); ok {
+				v, _ := boolOp(op, x, y)
+				return v, nil
+			}
+		}
+	}
+	if hasText {
+		if x, ok := a.(string); ok {
+			if y, ok := b.(string); ok {
+				v, _ := textOp(op, x, y)
+				return v, nil
+			}
+		}
+	}
+	if hasNum {
+		if x, ok := toFloat(a); ok {
+			if y, ok := toFloat(b); ok {
+				v, _, err := numberOp(op, x, y)
+				return v, err
+			}
+		}
+	}
+	if hasBool {
+		if x, ok := toBool(a); ok {
+			if y, ok := toBool(b); ok {
+				v, _ := boolOp(op, x, y)
+				return v, nil
+			}
+		}
+	}
+	if hasText && !arbitrary && a != nil && b != nil {
+		v, _ := textOp(op, evalString(a), evalString(b))
+		return v, nil
+	}
+	switch op {
+	case "==":
+		return reflect.DeepEqual(a, b), nil
+	case "!=":
+		return !reflect.DeepEqual(a, b), nil
+	case "in":
+		col, ok := b.([]any)
+		if !ok {
+			return nil, fail("expected type []interface{} for in operator but got %T", b)
+		}
+		for _, e := range col {
+			if reflect.DeepEqual(a, e) {
+				return true, nil
+			}
+		}
+		return false, nil
+	case "??":
+		if coalesce(a) {
+			return a, nil
+		}
+		return b, nil
+	}
+	return nil, fail("invalid operation (%T) %s (%T)", a, op, b)
+}
+
+// isConst reports whether gval folds n at parse time (literals, prefixes of constants,
+// infixes of constants; JSON literals, variables and ternaries are not constants).
+func isConst(n *node) bool {
+	switch n.kind {
+	case "lit":
+		return true
+	case "prefix":
+		return isConst(n.a)
+	case "infix":
+		return isConst(n.a) && isConst(n.b)
+	}
+	return false
+}
+
+type model struct {
+	p map[string]any
+}
+
+func (m *model) eval(n *node) (any, error) { return m.evalNode(n) }
+
+// coalesce reports whether a ?? b yields a: documented for a not nil and not false, in the
+// library for a not the zero value of its type (bug 2).
+func coalesce(a any) bool {
+	if Known.coalesceZeroValues {
+		return !isZero(a)
+	}
+	return a != nil && a != false
+}
+
+// truthy is the ternary's test of its condition: documented as the bool conversion, in the
+// library the zero-value test (bug 3).
+func truthy(c any) (bool, error) {
+	if Known.ternaryZeroNotBool {
+		return !isZero(c), nil
+	}
+	b, ok := toBool(c)
+	if !ok {
+		return false, fail("unexpected %T expected bool", c)
+	}
+	return b, nil
+}
+
+func (m *model) evalNode(n *node) (any, error) {
+	switch n.kind {
+	case "lit":
+		return n.val, nil
+	case "var":
+		return m.selectVar(n)
+	case "prefix":
+		a, err := m.eval(n.a)
+		if err != nil {
+			return nil, err
+		}
+		switch n.op {
+		case "-":
+			f, ok := toFloat(a)
+			if !ok {
+				return nil, fail("unexpected %v(%T) expected number", a, a)
+			}
+			return -f, nil
+		case "!":
+			b, ok := toBool(a)
+			if !ok {
+				return nil, fail("unexpected %T expected bool", a)
+			}
+			return !b, nil
+		default:
+			f, ok := toFloat(a)
+			if !ok {
+				return nil, fail("unexpected %T expected number", a)
+			}
+			i, err := toInt64(f)
+			if err != nil {
+				return nil, err
+			}
+			return float64(^i), nil
+		}
+	case "infix":
+		a, err := m.eval(n.a)
+		if err != nil {
+			return nil, err
+		}
+		switch n.op {
+		case "&&":
+			if a == false {
+				return false, nil
+			}
+		case "||":
+			if a == true {
+				return true, nil
+			}
+		case "??":
+			if coalesce(a) {
+				return a, nil
+			}
+		}
+		if n.op == "=~" || n.op == "!~" {
+			return m.regex(n.op, a, n.b)
+		}
+		b, err := m.eval(n.b)
+		if err != nil {
+			return nil, err
+		}
+		return applyInfix(n.op, a, b)
+	case "ternary":
+		c, err := m.eval(n.a)
+		if err != nil {
+			return nil, err
+		}
+		tr, err := truthy(c)
+		if err != nil {
+			return nil, err
+		}
+		if !tr {
+			if n.c == nil {
+				return nil, nil
+			}
+			return m.eval(n.c)
+		}
+		return m.eval(n.b)
+	case "array":
+		out := make([]any, len(n.elts))
+		for i, e := range n.elts {
+			v, err := m.eval(e)
+			if err != nil {
+				return nil, err
+			}
+			out[i] = v
+		}
+		return out, nil
+	case "object":
+		out := map[string]any{}
+		for i, e := range n.elts {
+			v, err := m.eval(e)
+			if err != nil {
+				return nil, err
+			}
+			k, err := m.eval(n.oks[i])
+			if err != nil {
+				return nil, err
+			}
+			out[evalString(k)] = v
+		}
+		return out, nil
+	}
+	panic("unknown node " + n.kind)
+}
+
+func (m *model) regex(op string, a any, bn *node) (any, error) {
+	b, err := m.eval(bn)
+	if err != nil {
+		return nil, err
+	}
+	re, err := regexp.Compile(evalString(b))
+	if err != nil {
+		return nil, fail("error parsing regexp: %v", err)
+	}
+	matched := re.MatchString(evalString(a))
+	if op == "!~" {
+		return !matched, nil
+	}
+	return matched, nil
+}
+
+// selectVar follows a path: maps by key, arrays by a non-negative in-range integer index,
+// anything else is an error.
+func (m *model) selectVar(n *node) (any, error) {
+	var cur any = m.p
+	keys := []string{n.name}
+	for _, k := range n.keys {
+		if k.dot {
+			keys = append(keys, k.name)
+			continue
+		}
+		v, err := m.eval(k.expr)
+		if err != nil {
+			return nil, err
+		}
+		keys = append(keys, evalString(v))
+	}
+	for _, k := range keys {
+		switch o := cur.(type) {
+		case map[string]any:
+			cur = o[k]
+		case []any:
+			i, err := strconv.Atoi(k)
+			if err == nil && i >= 0 && i < len(o) {
+				cur = o[i]
+			} else if Known.arrayBadIndexReturnsArray {
+				// bug: the array itself is returned and the path continues from it
+			} else {
+				return nil, fail("unknown parameter '%s' on %T", k, o)
+			}
+		default:
+			return nil, fail("unknown parameter '%s' on %T", k, o)
+		}
+	}
+	return cur, nil
+}
+
+// --------------------------------------------------------------------------- comparison
+
+// canon renders a value with type tags; NaN and map order are canonical.
+func canon(v any) string {
+	var sb strings.Builder
+	canonTo(&sb, v)
+	return sb.String()
+}
+
+func canonTo(sb *strings.Builder, v any) {
+	switch t := v.(type) {
+	case nil:
+		sb.WriteString("nil")
+	case bool:
+		fmt.Fprintf(sb, "%t", t)
+	case float64:
+		fmt.Fprintf(sb, "f%s", strconv.FormatFloat(t, 'g', -1, 64))
+	case string:
+		sb.WriteString(strconv.Quote(t))
+	case []any:
+		sb.WriteByte('[')
+		for i, e := range t {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			canonTo(sb, e)
+		}
+		sb.WriteByte(']')
+	case map[string]any:
+		keys := make([]string, 0, len(t))
+		for k := range t {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		sb.WriteByte('{')
+		for i, k := range keys {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			sb.WriteString(strconv.Quote(k))
+			sb.WriteByte(':')
+			canonTo(sb, t[k])
+		}
+		sb.WriteByte('}')
+	default:
+		fmt.Fprintf(sb, "?%T:%v", v, v)
+	}
+}
+
+// hasVar reports whether n reads a variable.
+func hasVar(n *node) bool {
+	if n == nil {
+		return false
+	}
+	if n.kind == "var" {
+		return true
+	}
+	for _, c := range []*node{n.a, n.b, n.c} {
+		if hasVar(c) {
+			return true
+		}
+	}
+	for _, c := range n.elts {
+		if hasVar(c) {
+			return true
+		}
+	}
+	for _, c := range n.oks {
+		if hasVar(c) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..0035b55
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,108 @@
+package hegel
+
+// Pins: one deterministic test per recorded bug, asserting the documented behaviour. Each
+// fails while the bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"testing"
+
+	"github.com/PaesslerAG/gval"
+)
+
+// gval/1: DecimalArithmetic documents negative(-); a negated decimal literal evaluates.
+func TestHegelPinDecimalNegate(t *testing.T) {
+	for _, e := range []string{"-1", "1 - -1", "-(1 + 1)", "-1.5 * 2"} {
+		if v, err := gval.DecimalArithmetic().Evaluate(e, nil); err != nil {
+			t.Errorf("%s: %v", e, err)
+		} else if s := evalString(v); s != map[string]string{"-1": "-1", "1 - -1": "2", "-(1 + 1)": "-2", "-1.5 * 2": "-3"}[e] {
+			t.Errorf("%s = %s", e, s)
+		}
+	}
+}
+
+// gval/2: a ?? b returns a unless a is nil or false, so 0 and "" are kept.
+func TestHegelPinCoalesceZero(t *testing.T) {
+	for e, want := range map[string]any{`0 ?? 5`: 0.0, `"" ?? "x"`: "", `z ?? 5`: 0.0, `false ?? 1`: 1.0, `n ?? 1`: 1.0} {
+		v, err := gval.Evaluate(e, map[string]any{"z": 0.0, "n": nil})
+		if err != nil || canon(v) != canon(want) {
+			t.Errorf("%s = %v, %v; want %v", e, v, err, want)
+		}
+	}
+}
+
+// gval/3: the ternary condition is converted to bool like the logical operators, so the
+// strings "false" and "0" select the else branch.
+func TestHegelPinTernaryBool(t *testing.T) {
+	for _, e := range []string{`"false" ? 1 : 2`, `"0" ? 1 : 2`, `"FALSE" ? 1 : 2`, `s ? 1 : 2`} {
+		v, err := gval.Evaluate(e, map[string]any{"s": "false"})
+		if err != nil || canon(v) != canon(2.0) {
+			t.Errorf("%s = %v, %v; want 2", e, v, err)
+		}
+	}
+}
+
+// gval/4: an out-of-range or non-integer index on an array is an error, like an unknown
+// field on any other type; it does not return the array.
+func TestHegelPinArrayIndex(t *testing.T) {
+	p := map[string]any{"arr": []any{1.0, "a"}}
+	for _, e := range []string{"arr[2]", "arr[-1]", "arr[1.5]", `arr["x"]`, "arr.x", "arr[5].k"} {
+		if v, err := gval.Evaluate(e, p); err == nil {
+			t.Errorf("%s = %v, want an error", e, v)
+		}
+	}
+}
+
+// gval/5: a constant subexpression that would fail is only evaluated when reached, as it is
+// when the operands are variables.
+func TestHegelPinConstantFolding(t *testing.T) {
+	p := map[string]any{"t": true, "s": "a"}
+	for _, e := range []string{`true || "a" - 1`, `false && "a" - 1`, `true ? 1 : "a" - 1`, `1 ?? "a" - 1`} {
+		want, err := gval.Evaluate(map[string]string{
+			`true || "a" - 1`: "t || s - 1", `false && "a" - 1`: "!t && s - 1", `true ? 1 : "a" - 1`: "t ? 1 : s - 1", `1 ?? "a" - 1`: "1 ?? s - 1",
+		}[e], p)
+		if err != nil {
+			t.Fatalf("variable form of %s: %v", e, err)
+		}
+		v, err := gval.Evaluate(e, p)
+		if err != nil || canon(v) != canon(want) {
+			t.Errorf("%s = %v, %v; the variable form gives %v", e, v, err, want)
+		}
+	}
+}
+
+// gval/6: integer literals with a base prefix parse as in Go.
+func TestHegelPinBasePrefix(t *testing.T) {
+	for e, want := range map[string]float64{"0x10": 16, "0b101": 5, "0o17": 15, "0X1F": 31} {
+		v, err := gval.Evaluate(e, nil)
+		if err != nil || canon(v) != canon(want) {
+			t.Errorf("%s = %v, %v; want %v", e, v, err, want)
+		}
+	}
+}
+
+// gval/7: the Go-standard order of operators: shifts bind like * and /, and & tighter than
+// | and ^.
+func TestHegelPinGoPrecedence(t *testing.T) {
+	for e, want := range map[string]float64{"1 << 1 + 1": 3, "6 & 3 + 1": 3, "8 >> 1 * 2": 8, "1 | 2 ^ 3 & 4": 3, "5 ^ 4 & 6": 1} {
+		v, err := gval.Evaluate(e, nil)
+		if err != nil || canon(v) != canon(want) {
+			t.Errorf("%s = %v, %v; want %v (Go)", e, v, err, want)
+		}
+	}
+}
+
+// gval/8: DecimalArithmetic division by zero is an error, not a panic.
+func TestHegelPinDecimalDivideByZero(t *testing.T) {
+	for _, e := range []string{"1 / 0", "1 % 0", "x / (1 - 1)"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("%s panics: %v", e, r)
+				}
+			}()
+			if v, err := gval.DecimalArithmetic().Evaluate(e, map[string]any{"x": 3.0}); err == nil {
+				t.Errorf("%s = %v, want an error", e, v)
+			}
+		}()
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..a06ccaf
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,493 @@
+package hegel
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"math/big"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/PaesslerAG/gval"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- helpers
+
+// safeEvaluate runs l.Evaluate recovering a panic in the library.
+func safeEvaluate(l gval.Language, text string, p any) (v any, err error, panicked any) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	v, err = l.Evaluate(text, p)
+	return
+}
+
+// foldErrors reports whether gval's constant folding at parse time hits an error somewhere in
+// n: every constant subexpression is evaluated when it is parsed, whether or not a short
+// circuit above it would skip it at run time.
+func foldErrors(n *node) bool {
+	if n == nil {
+		return false
+	}
+	for _, c := range []*node{n.a, n.b, n.c} {
+		if foldErrors(c) {
+			return true
+		}
+	}
+	for _, c := range append(append([]*node{}, n.elts...), n.oks...) {
+		if foldErrors(c) {
+			return true
+		}
+	}
+	for _, k := range n.keys {
+		if foldErrors(k.expr) {
+			return true
+		}
+	}
+	if isConst(n) && n.kind != "lit" {
+		md := &model{p: map[string]any{}}
+		if _, err := md.evalNode(n); err != nil {
+			if _, ok := err.(*evalErr); ok {
+				return true
+			}
+		}
+	}
+	if n.kind == "infix" && (n.op == "=~" || n.op == "!~") && isConst(n.b) {
+		// a constant pattern is compiled when parsed
+		md := &model{p: map[string]any{}}
+		if v, err := md.evalNode(n.b); err == nil {
+			if _, err := regexp.Compile(evalString(v)); err != nil {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// outcome classifies a model result: value, error, or unspecified.
+func outcome(v any, err error) string {
+	switch err.(type) {
+	case nil:
+		return canon(v)
+	case *unspecified:
+		return "unspecified"
+	}
+	return "error: " + err.Error()
+}
+
+// --------------------------------------------------------------------------- Full
+
+// TestHegelEvaluate: a random expression, rendered with minimal and with full parenthesization
+// and random spacing, evaluates in gval.Full to the model's value, or fails exactly when the
+// model fails.
+func TestHegelEvaluate(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tree := genExpr(ht, drawInt(ht, 1, 4), true)
+		md := &model{p: params()}
+		want, werr := md.eval(tree)
+		if _, ok := werr.(*unspecified); ok {
+			col.count("unspecified")
+			return
+		}
+		fold := foldErrors(tree)
+		for _, full := range []bool{false, true} {
+			text := render(ht, tree, full)
+			got, gerr, panicked := safeEvaluate(gval.Full(), text, params())
+			if panicked != nil {
+				col.failClass(ht, "Panic", "%q panics: %v", text, panicked)
+				return
+			}
+			if fold && Known.constantFoldingParseErrors {
+				if gerr == nil {
+					col.failClass(ht, "FoldNoError", "%q: a constant subexpression errors but Evaluate = %s (model %s)", text, canon(got), outcome(want, werr))
+				}
+				col.count("known fold error")
+				return
+			}
+			switch {
+			case werr != nil && gerr == nil:
+				col.failClass(ht, "ModelErrGvalOK", "%q = %s, model expects an error: %v", text, canon(got), werr)
+			case werr == nil && gerr != nil:
+				col.failClass(ht, "GvalErr", "%q: %v, model %s", text, gerr, canon(want))
+			case werr == nil && canon(got) != canon(want):
+				col.failClass(ht, "Value", "%q = %s, want %s", text, canon(got), canon(want))
+			}
+		}
+	})
+}
+
+// TestHegelReuse: an Evaluable built once gives the model's answers for two parameter sets,
+// and IsConst is true exactly for constant expressions.
+func TestHegelReuse(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tree := genExpr(ht, drawInt(ht, 1, 3), true)
+		text := render(ht, tree, chance(ht, 30))
+		if foldErrors(tree) {
+			col.count("known fold error")
+			return
+		}
+		ev, err := gval.Full().NewEvaluable(text)
+		if err != nil {
+			col.failClass(ht, "Parse", "NewEvaluable(%q): %v", text, err)
+			return
+		}
+		if ev.IsConst() != isConst(tree) {
+			col.failClass(ht, "IsConst", "%q: IsConst %v, want %v", text, ev.IsConst(), isConst(tree))
+		}
+		for i, p := range []map[string]any{params(), params2(), params()} {
+			md := &model{p: p}
+			want, werr := md.eval(tree)
+			if _, ok := werr.(*unspecified); ok {
+				col.count("unspecified")
+				continue
+			}
+			got, gerr := ev(context.Background(), p)
+			switch {
+			case werr != nil && gerr == nil:
+				col.failClass(ht, "ModelErrGvalOK", "%q with params %d = %s, model expects an error: %v", text, i, canon(got), werr)
+			case werr == nil && gerr != nil:
+				col.failClass(ht, "GvalErr", "%q with params %d: %v, model %s", text, i, gerr, canon(want))
+			case werr == nil && canon(got) != canon(want):
+				col.failClass(ht, "Value", "%q with params %d = %s, want %s", text, i, canon(got), canon(want))
+			}
+		}
+	})
+}
+
+// TestHegelConversions: EvalBool, EvalFloat64, EvalInt and EvalString apply the documented
+// conversions to the expression's value.
+func TestHegelConversions(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tree := genExpr(ht, drawInt(ht, 1, 3), true)
+		text := render(ht, tree, false)
+		if foldErrors(tree) {
+			col.count("known fold error")
+			return
+		}
+		md := &model{p: params()}
+		want, werr := md.eval(tree)
+		if werr != nil {
+			col.count("model error")
+			return
+		}
+		ev, err := gval.Full().NewEvaluable(text)
+		if err != nil {
+			col.failClass(ht, "Parse", "NewEvaluable(%q): %v", text, err)
+			return
+		}
+		ctx := context.Background()
+		p := params()
+		b, ok := toBool(want)
+		gb, gerr := ev.EvalBool(ctx, p)
+		if ok != (gerr == nil) || (ok && b != gb) {
+			col.failClass(ht, "EvalBool", "%q (= %s): EvalBool = %v, %v; want %v, ok %v", text, canon(want), gb, gerr, b, ok)
+		}
+		f, ok := toFloat(want)
+		gf, gerr := ev.EvalFloat64(ctx, p)
+		if ok != (gerr == nil) || (ok && canon(f) != canon(gf)) {
+			col.failClass(ht, "EvalFloat64", "%q (= %s): EvalFloat64 = %v, %v; want %v, ok %v", text, canon(want), gf, gerr, f, ok)
+		}
+		if ok {
+			if _, err := toInt64(f); err == nil && math.Abs(f) < 1<<31 {
+				if gi, gerr := ev.EvalInt(ctx, p); gerr != nil || gi != int(f) {
+					col.failClass(ht, "EvalInt", "%q (= %s): EvalInt = %v, %v; want %d", text, canon(want), gi, gerr, int(f))
+				}
+			}
+		} else if _, gerr := ev.EvalInt(ctx, p); gerr == nil {
+			col.failClass(ht, "EvalIntOK", "%q (= %s): EvalInt succeeds", text, canon(want))
+		}
+		if gs, gerr := ev.EvalString(ctx, p); gerr != nil || gs != evalString(want) {
+			col.failClass(ht, "EvalString", "%q (= %s): EvalString = %q, %v; want %q", text, canon(want), gs, gerr, evalString(want))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- DecimalArithmetic
+
+var decLits = []string{"0", "1", "2", "3", "7", "10", "0.1", "0.2", "0.3", "1.5", "2.5", "0.5", "100", "1e21", "0.001"}
+
+// dnode is an expression of the decimal language: a literal (text), the float variable x, a
+// negation, or an infix.
+type dnode struct {
+	lit  string
+	v    bool
+	neg  *dnode
+	op   string
+	a, b *dnode
+}
+
+var decOps = []string{"+", "-", "*", "%", "**", "/", "<", "<=", ">", ">=", "==", "!="}
+
+func genDec(tc hegel.TestCase, depth int) *dnode {
+	if depth <= 0 || chance(tc, 25) {
+		if chance(tc, 20) {
+			return &dnode{v: true}
+		}
+		return &dnode{lit: pick(tc, decLits)}
+	}
+	if chance(tc, 15) {
+		return &dnode{neg: genDec(tc, depth-1)}
+	}
+	op := pick(tc, decOps)
+	n := &dnode{op: op, a: genDec(tc, depth-1), b: genDec(tc, depth-1)}
+	if op == "**" {
+		n.b = &dnode{lit: pick(tc, []string{"0", "1", "2", "3"})}
+	}
+	return n
+}
+
+func (n *dnode) render(sb *strings.Builder, parent int, right bool) {
+	switch {
+	case n.v:
+		sb.WriteString("x")
+	case n.lit != "":
+		sb.WriteString(n.lit)
+	case n.neg != nil:
+		sb.WriteString("-")
+		if n.neg.op != "" {
+			sb.WriteByte('(')
+			n.neg.render(sb, 0, false)
+			sb.WriteByte(')')
+		} else {
+			n.neg.render(sb, 0, false)
+		}
+	default:
+		p := precedence[n.op]
+		need := p < parent || (right && p == parent)
+		if need {
+			sb.WriteByte('(')
+		}
+		n.a.render(sb, p, false)
+		sb.WriteString(" " + n.op + " ")
+		n.b.render(sb, p, true)
+		if need {
+			sb.WriteByte(')')
+		}
+	}
+}
+
+type decVal struct {
+	r     *big.Rat
+	b     bool
+	isB   bool
+	isVar bool // a bare float variable (negation of it works)
+}
+
+// evalDec is the exact model of DecimalArithmetic: rationals, truncating modulo, integer
+// powers; division is left to the library's precision and not modelled (nil result).
+func evalDec(n *dnode) (decVal, error) {
+	switch {
+	case n.v:
+		return decVal{r: big.NewRat(3, 1), isVar: true}, nil
+	case n.lit != "":
+		r, ok := new(big.Rat).SetString(n.lit)
+		if !ok {
+			return decVal{}, fail("bad literal %s", n.lit)
+		}
+		return decVal{r: r}, nil
+	case n.neg != nil:
+		a, err := evalDec(n.neg)
+		if err != nil {
+			return decVal{}, err
+		}
+		if a.isB {
+			return decVal{}, fail("unexpected bool expected number")
+		}
+		if !a.isVar && Known.decimalNegateFails {
+			return decVal{}, fail("unexpected decimal expected number")
+		}
+		if a.r == nil {
+			return decVal{}, &unspecified{"division"}
+		}
+		return decVal{r: new(big.Rat).Neg(a.r)}, nil
+	}
+	a, err := evalDec(n.a)
+	if err != nil {
+		return decVal{}, err
+	}
+	b, err := evalDec(n.b)
+	if err != nil {
+		return decVal{}, err
+	}
+	if a.isB || b.isB {
+		if n.op == "==" || n.op == "!=" {
+			if a.isB && b.isB {
+				return decVal{b: (a.b == b.b) == (n.op == "=="), isB: true}, nil
+			}
+			return decVal{b: n.op == "!=", isB: true}, nil
+		}
+		return decVal{}, fail("invalid operation on bool")
+	}
+	if a.r == nil || b.r == nil {
+		return decVal{}, &unspecified{"division"}
+	}
+	switch n.op {
+	case "+":
+		return decVal{r: new(big.Rat).Add(a.r, b.r)}, nil
+	case "-":
+		return decVal{r: new(big.Rat).Sub(a.r, b.r)}, nil
+	case "*":
+		return decVal{r: new(big.Rat).Mul(a.r, b.r)}, nil
+	case "/":
+		if b.r.Sign() == 0 {
+			return decVal{}, fail("division by zero")
+		}
+		return decVal{}, &unspecified{"division"}
+	case "%":
+		if b.r.Sign() == 0 {
+			return decVal{}, fail("division by zero")
+		}
+		q := new(big.Rat).Quo(a.r, b.r)
+		t := new(big.Int).Quo(q.Num(), q.Denom()) // truncates toward zero
+		return decVal{r: new(big.Rat).Sub(a.r, new(big.Rat).Mul(b.r, new(big.Rat).SetInt(t)))}, nil
+	case "**":
+		e := int(b.r.Num().Int64())
+		r := big.NewRat(1, 1)
+		for i := 0; i < e; i++ {
+			r.Mul(r, a.r)
+		}
+		return decVal{r: r}, nil
+	}
+	c := a.r.Cmp(b.r)
+	var res bool
+	switch n.op {
+	case "<":
+		res = c < 0
+	case "<=":
+		res = c <= 0
+	case ">":
+		res = c > 0
+	case ">=":
+		res = c >= 0
+	case "==":
+		res = c == 0
+	case "!=":
+		res = c != 0
+	}
+	return decVal{b: res, isB: true}, nil
+}
+
+// exactRat computes n as an exact rational (division included, comparisons as 0/1), or nil
+// where the model has no value; for the zero-divisor check only.
+func exactRat(n *dnode) *big.Rat {
+	switch {
+	case n.v:
+		return big.NewRat(3, 1)
+	case n.lit != "":
+		r, _ := new(big.Rat).SetString(n.lit)
+		return r
+	case n.neg != nil:
+		if r := exactRat(n.neg); r != nil {
+			return new(big.Rat).Neg(r)
+		}
+		return nil
+	}
+	a, b := exactRat(n.a), exactRat(n.b)
+	if a == nil || b == nil {
+		return nil
+	}
+	switch n.op {
+	case "+":
+		return new(big.Rat).Add(a, b)
+	case "-":
+		return new(big.Rat).Sub(a, b)
+	case "*":
+		return new(big.Rat).Mul(a, b)
+	case "/":
+		if b.Sign() == 0 {
+			return nil
+		}
+		return new(big.Rat).Quo(a, b)
+	case "%":
+		if b.Sign() == 0 {
+			return nil
+		}
+		q := new(big.Rat).Quo(a, b)
+		t := new(big.Int).Quo(q.Num(), q.Denom())
+		return new(big.Rat).Sub(a, new(big.Rat).Mul(b, new(big.Rat).SetInt(t)))
+	case "**":
+		r := big.NewRat(1, 1)
+		for i := int64(0); i < b.Num().Int64(); i++ {
+			r.Mul(r, a)
+		}
+		return r
+	}
+	return nil // comparisons: not a number
+}
+
+// divisorZero reports whether n divides (/ or %) by a value that is exactly zero.
+func divisorZero(n *dnode) bool {
+	if n == nil {
+		return false
+	}
+	if n.neg != nil {
+		return divisorZero(n.neg)
+	}
+	if n.op == "/" || n.op == "%" {
+		if b := exactRat(n.b); b != nil && b.Sign() == 0 {
+			return true
+		}
+	}
+	return divisorZero(n.a) || divisorZero(n.b)
+}
+
+// TestHegelDecimal: DecimalArithmetic computes exactly (rationals) for + - * % and integer
+// powers, compares exactly, and division by zero is an error, not a panic.
+func TestHegelDecimal(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tree := genDec(ht, drawInt(ht, 1, 4))
+		var sb strings.Builder
+		tree.render(&sb, 0, false)
+		text := sb.String()
+		want, werr := evalDec(tree)
+		if _, ok := werr.(*unspecified); ok {
+			col.count("unspecified (division)")
+			return
+		}
+		got, gerr, panicked := safeEvaluate(gval.DecimalArithmetic(), text, map[string]any{"x": 3.0})
+		if panicked != nil {
+			if Known.decimalDivideByZeroPanics && divisorZero(tree) {
+				col.count("known division panic")
+				return
+			}
+			col.failClass(ht, "Panic", "%q panics: %v", text, panicked)
+			return
+		}
+		if werr != nil {
+			if gerr == nil {
+				col.failClass(ht, "ModelErrGvalOK", "%q = %v, model expects an error: %v", text, got, werr)
+			}
+			return
+		}
+		if gerr != nil {
+			col.failClass(ht, "GvalErr", "%q: %v, model %s", text, gerr, decString(want))
+			return
+		}
+		if want.isB {
+			if gb, ok := got.(bool); !ok || gb != want.b {
+				col.failClass(ht, "Bool", "%q = %v (%T), want %v", text, got, got, want.b)
+			}
+			return
+		}
+		s := fmt.Sprintf("%v", got)
+		gr, ok := new(big.Rat).SetString(s)
+		if !ok || gr.Cmp(want.r) != 0 {
+			col.failClass(ht, "Value", "%q = %v (%T), want %s", text, got, got, want.r.FloatString(6))
+		}
+	})
+}
+
+func decString(v decVal) string {
+	if v.isB {
+		return fmt.Sprintf("%v", v.b)
+	}
+	return v.r.RatString()
+}
