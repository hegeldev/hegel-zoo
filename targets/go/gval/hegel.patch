diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..0035b55
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,108 @@
+package hegel
+
+// Pins: one deterministic test per recorded bug, asserting the documented behaviour. Each
+// fails while the bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"testing"
+
+	"github.com/PaesslerAG/gval"
+)
+
+// gval/1: DecimalArithmetic documents negative(-); a negated decimal literal evaluates.
+func TestHegelPinDecimalNegate(t *testing.T) {
+	for _, e := range []string{"-1", "1 - -1", "-(1 + 1)", "-1.5 * 2"} {
+		if v, err := gval.DecimalArithmetic().Evaluate(e, nil); err != nil {
+			t.Errorf("%s: %v", e, err)
+		} else if s := evalString(v); s != map[string]string{"-1": "-1", "1 - -1": "2", "-(1 + 1)": "-2", "-1.5 * 2": "-3"}[e] {
+			t.Errorf("%s = %s", e, s)
+		}
+	}
+}
+
+// gval/2: a ?? b returns a unless a is nil or false, so 0 and "" are kept.
+func TestHegelPinCoalesceZero(t *testing.T) {
+	for e, want := range map[string]any{`0 ?? 5`: 0.0, `"" ?? "x"`: "", `z ?? 5`: 0.0, `false ?? 1`: 1.0, `n ?? 1`: 1.0} {
+		v, err := gval.Evaluate(e, map[string]any{"z": 0.0, "n": nil})
+		if err != nil || canon(v) != canon(want) {
+			t.Errorf("%s = %v, %v; want %v", e, v, err, want)
+		}
+	}
+}
+
+// gval/3: the ternary condition is converted to bool like the logical operators, so the
+// strings "false" and "0" select the else branch.
+func TestHegelPinTernaryBool(t *testing.T) {
+	for _, e := range []string{`"false" ? 1 : 2`, `"0" ? 1 : 2`, `"FALSE" ? 1 : 2`, `s ? 1 : 2`} {
+		v, err := gval.Evaluate(e, map[string]any{"s": "false"})
+		if err != nil || canon(v) != canon(2.0) {
+			t.Errorf("%s = %v, %v; want 2", e, v, err)
+		}
+	}
+}
+
+// gval/4: an out-of-range or non-integer index on an array is an error, like an unknown
+// field on any other type; it does not return the array.
+func TestHegelPinArrayIndex(t *testing.T) {
+	p := map[string]any{"arr": []any{1.0, "a"}}
+	for _, e := range []string{"arr[2]", "arr[-1]", "arr[1.5]", `arr["x"]`, "arr.x", "arr[5].k"} {
+		if v, err := gval.Evaluate(e, p); err == nil {
+			t.Errorf("%s = %v, want an error", e, v)
+		}
+	}
+}
+
+// gval/5: a constant subexpression that would fail is only evaluated when reached, as it is
+// when the operands are variables.
+func TestHegelPinConstantFolding(t *testing.T) {
+	p := map[string]any{"t": true, "s": "a"}
+	for _, e := range []string{`true || "a" - 1`, `false && "a" - 1`, `true ? 1 : "a" - 1`, `1 ?? "a" - 1`} {
+		want, err := gval.Evaluate(map[string]string{
+			`true || "a" - 1`: "t || s - 1", `false && "a" - 1`: "!t && s - 1", `true ? 1 : "a" - 1`: "t ? 1 : s - 1", `1 ?? "a" - 1`: "1 ?? s - 1",
+		}[e], p)
+		if err != nil {
+			t.Fatalf("variable form of %s: %v", e, err)
+		}
+		v, err := gval.Evaluate(e, p)
+		if err != nil || canon(v) != canon(want) {
+			t.Errorf("%s = %v, %v; the variable form gives %v", e, v, err, want)
+		}
+	}
+}
+
+// gval/6: integer literals with a base prefix parse as in Go.
+func TestHegelPinBasePrefix(t *testing.T) {
+	for e, want := range map[string]float64{"0x10": 16, "0b101": 5, "0o17": 15, "0X1F": 31} {
+		v, err := gval.Evaluate(e, nil)
+		if err != nil || canon(v) != canon(want) {
+			t.Errorf("%s = %v, %v; want %v", e, v, err, want)
+		}
+	}
+}
+
+// gval/7: the Go-standard order of operators: shifts bind like * and /, and & tighter than
+// | and ^.
+func TestHegelPinGoPrecedence(t *testing.T) {
+	for e, want := range map[string]float64{"1 << 1 + 1": 3, "6 & 3 + 1": 3, "8 >> 1 * 2": 8, "1 | 2 ^ 3 & 4": 3, "5 ^ 4 & 6": 1} {
+		v, err := gval.Evaluate(e, nil)
+		if err != nil || canon(v) != canon(want) {
+			t.Errorf("%s = %v, %v; want %v (Go)", e, v, err, want)
+		}
+	}
+}
+
+// gval/8: DecimalArithmetic division by zero is an error, not a panic.
+func TestHegelPinDecimalDivideByZero(t *testing.T) {
+	for _, e := range []string{"1 / 0", "1 % 0", "x / (1 - 1)"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("%s panics: %v", e, r)
+				}
+			}()
+			if v, err := gval.DecimalArithmetic().Evaluate(e, map[string]any{"x": 3.0}); err == nil {
+				t.Errorf("%s = %v, want an error", e, v)
+			}
+		}()
+	}
+}
diff --git a/hegel/hegel_zoo_cases_test.go b/hegel/hegel_zoo_cases_test.go
new file mode 100644
index 0000000..c34449b
--- /dev/null
+++ b/hegel/hegel_zoo_cases_test.go
@@ -0,0 +1,484 @@
+package hegel
+
+// The case records of the four properties, their pools and their generators.
+//
+// Every property draws a record of plain values (the tree with every leaf's value and
+// spelling, the spacing of each rendering, the reuse property's full coin) and builds its
+// texts from it by the pure renderer with no further draw and no library call. The
+// generators are package-level values from the idioms (hzChance, the die* and halving
+// helpers), every choice at the share the old generator gave it (its chance(pct) and its
+// switch arms), with the realised figure beside the weight (the probe of the rewrite: 3000
+// cases per property, the mean of HEGEL_SEED=7 and 8; the engine's 1-bit choices realise up
+// to five points off their nominal share depending on the draws around them and the seed, so
+// a figure within that is left as it is); the simplest alternative comes first (the shrink
+// target). The draws per case (the idioms' integer draws, counted by the probe): Evaluate
+// mean 737, at most 1931; Reuse 433 and 1278; Conversions 431 and 1130; Decimal 90 and 436.
+// The population is the old generator's (the same strings, the same chances and
+// counts) plus the additions of the standard: the base-prefixed spellings of an integral
+// literal (gval/6), the minimal rendering by Go's table (gval/7: what the README promises;
+// the old renderer used gval's own table), and the folding errors (gval/5) and zero
+// divisors (gval/8) now judged where the old properties skipped them.
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- pools
+
+var numSet = []float64{0, 1, 2, 3, 7, 10, 0.5, 2.5, 1000, 9, 1e21, 0.1}
+
+var strSet = []string{"", "a", "abc", "b", "1", "3", "10", "9", "true", "false", "TRUE", "0", "1.0", "x y", "\u263a"}
+
+var regexSet = []string{"a", "^a", "b$", "^$", `\d`, ".*", "1", "^3$", "[", "(", "c"}
+
+var numStrSet = []string{"1", "3", "10", "0", "1.0", "9"}
+
+var varNames = []string{"x", "y", "z", "s", "t", "u", "b", "f", "n", "arr", "m", "m2", "q"}
+
+var numVars = []string{"x", "y", "z", "t"}
+
+var dotKeys = []string{"k", "s", "e", "a", "b", "q", "x"}
+
+var indexStrSet = []string{"k", "s", "a", "b", "0", "1", "q"}
+
+var objKeySet = []string{"a", "b", "k", ""}
+
+var decLits = []string{"0", "1", "2", "3", "7", "10", "0.1", "0.2", "0.3", "1.5", "2.5", "0.5", "100", "1e21", "0.001"}
+
+// --------------------------------------------------------------------------- leaves
+
+func numNode(f float64, spell string) *node { return &node{kind: "lit", val: f, spell: spell} }
+
+func strNode(s string, raw bool) *node {
+	if raw {
+		return &node{kind: "lit", val: s, spell: "`" + s + "`"}
+	}
+	return &node{kind: "lit", val: s, spell: strconv.Quote(s)}
+}
+
+func boolNode(b bool) *node { return &node{kind: "lit", val: b, spell: strconv.FormatBool(b)} }
+
+// basePrefixed is the spellings of the integer v that Go reads as v and gval does not
+// (gval/6): hex, upper-case hex, binary, octal with 0o, and the legacy octal with a leading
+// 0 (read as decimal by gval: a shape only for v of 8 and more); and the two spellings both
+// read alike, a hex float with a zero exponent and a decimal with an underscore (v of 10 and
+// more: after the first digit).
+func basePrefixed(v int64) (shapes, alike []string) {
+	shapes = []string{
+		"0x" + strconv.FormatInt(v, 16),
+		"0X" + strings.ToUpper(strconv.FormatInt(v, 16)),
+		"0b" + strconv.FormatInt(v, 2),
+		"0o" + strconv.FormatInt(v, 8),
+		"0" + strconv.FormatInt(v, 8),
+	}
+	alike = []string{"0x" + strconv.FormatInt(v, 16) + "p0"}
+	if v >= 10 {
+		d := strconv.FormatInt(v, 10)
+		alike = append(alike, d[:1]+"_"+d[1:])
+	}
+	return shapes, alike
+}
+
+// spellingOf is the spelling of the number f: the old fmtNum's forms at its chances (the
+// shortest form; for an integral value under 1e15 a ".0" suffix 20 percent of the time,
+// else for one at or above 1 a trailing "." 10 percent of the remaining; for a value under
+// 1 a stripped leading zero 30 percent), and for an integral value in 0..1000 the
+// base-prefixed forms (basePrefixed) at a small weight: the five shapes of gval/6 at 1 each
+// of 125 (zero under HEGEL_NO_KNOWN=1) and the two alike forms at 1 each. Realised over the
+// integral literals of a run (zero included): plain 71, ".0" 18, "." 7, the shapes 3, the
+// alike forms 1 (the shapes move between 3 and 5 with the seed); over the fractions: the
+// stripped form 30.
+func spellingOf(f float64) hegel.Generator[string] {
+	s := strconv.FormatFloat(f, 'g', -1, 64)
+	integral := f == math.Trunc(f) && f < 1e15
+	var weights []int
+	var forms []string
+	add := func(w int, form string) {
+		weights = append(weights, w)
+		forms = append(forms, form)
+	}
+	switch {
+	case integral && f >= 1:
+		// plain 70, ".0" 20, "." 10 (8 realised 5, 10 realises 7 of the 9.4 nominal)
+		add(70, s)
+		add(20, s+".0")
+		add(10, s+".")
+	case integral:
+		// zero: plain 80, ".0" 20
+		add(80, s)
+		add(20, s+".0")
+	case strings.HasPrefix(s, "0."):
+		// plain 70, the leading zero stripped 30
+		add(70, s)
+		add(30, s[1:])
+	default:
+		return hegel.Just(s)
+	}
+	if integral && f >= 0 && f <= 1000 {
+		// the weights above are of 100; the base-prefixed forms are 7 more of 125 with the
+		// plain forms scaled by 1.18: the shapes 4 percent of such literals, the alike
+		// forms 1.6
+		for i := range weights {
+			weights[i] = weights[i] * 118 / 100
+		}
+		shapes, alike := basePrefixed(int64(f))
+		for _, form := range shapes {
+			add(hzUnless(hzNoKnown, 1), form)
+		}
+		for _, form := range alike {
+			add(1, form)
+		}
+	}
+	return halvesOver(weights, forms...)
+}
+
+// numLit is a number of the pool with its spelling.
+var numLit = hegel.FlatMap(evenHalves(numSet...), func(f float64) hegel.Generator[*node] {
+	return hegel.Map(spellingOf(f), func(spell string) *node { return numNode(f, spell) })
+})
+
+// strLitFrom is a string of the pool: quoted, or in backticks 20 percent of the time when
+// it holds none (realised 19 to 22).
+func strLitFrom(pool []string) hegel.Generator[*node] {
+	return hegel.FlatMap(evenHalves(pool...), func(s string) hegel.Generator[*node] {
+		if strings.Contains(s, "`") {
+			return hegel.Just(strNode(s, false))
+		}
+		return hegel.Map(dieCoin(20), func(raw bool) *node { return strNode(s, raw) })
+	})
+}
+
+var strLit = strLitFrom(strSet)
+
+var boolLit = hegel.Map(dieEven(false, true), boolNode)
+
+// litGen is a literal: a number half the time, a string a quarter, a bool a quarter (the old
+// genLit's four arms; not measurable apart: the regex, key and numeric pools add literals of
+// their own, and the leaf kinds over a run come out number 46, string 39, bool 15).
+var litGen = halvesGens([]int{2, 1, 1}, numLit, strLit, boolLit)
+
+// numericGen is a leaf that converts to a number: a number half the time, a numeric string a
+// quarter, a numeric variable a quarter (the old genNumeric).
+var numericGen = halvesGens([]int{2, 1, 1}, numLit, strLitFrom(numStrSet),
+	hegel.Map(evenHalves(numVars...), func(name string) *node { return &node{kind: "var", name: name} }))
+
+var regexLit = strLitFrom(regexSet)
+
+// --------------------------------------------------------------------------- trees
+
+const maxDepth = 4
+
+// The generators by depth, built bottom-up (every alternative of a choice is built eagerly):
+// exprGen[d][0] an expression of depth d below the top, exprGen[d][1] at the top (where a
+// ternary may lack its else), operandGen[d] the right operand of an infix (regex literals and
+// arrays of literals favoured), varGen[d] a variable with a path whose index expressions have
+// depth d-1.
+var (
+	exprGen    [maxDepth + 1][2]hegel.Generator[*node]
+	operandGen [maxDepth + 1]hegel.Generator[*node]
+	varGen     [maxDepth + 1]hegel.Generator[*node]
+)
+
+// keyAt is one key of a path: a dot key half the time (realised 50), else an index: a small
+// integer literal a quarter, a string literal a quarter, an expression of depth d-1 half (the
+// literal 1 at depth 0; over the keys of a run: a number 32, a string 14, another expression
+// 4, the expression arm's leaves counted with the literals).
+func keyAt(d int) hegel.Generator[key] {
+	index := hegel.Just(numNode(1, "1"))
+	if d > 0 {
+		index = exprGen[d-1][0]
+	}
+	indexKey := halvesGens([]int{1, 1, 2},
+		hegel.FlatMap(evenHalves(0.0, 1.0, 2.0, 3.0), func(f float64) hegel.Generator[*node] {
+			return hegel.Map(spellingOf(f), func(spell string) *node { return numNode(f, spell) })
+		}),
+		strLitFrom(indexStrSet),
+		index)
+	return halvesGens([]int{1, 1},
+		hegel.Map(evenHalves(dotKeys...), func(name string) key { return key{dot: true, name: name} }),
+		hegel.Map(indexKey, func(n *node) key { return key{expr: n} }))
+}
+
+// varAt is a variable: a name of the pool; a scalar name (not m, m2, arr) is bare 80 percent
+// of the time (paths below scalars are errors: kept rare), else zero to two keys (bare
+// variables 74 nominal over all names, realised 78; one key 11, two keys 10).
+func varAt(d int) hegel.Generator[*node] {
+	keys := dieCounted(keyAt(d), 0, 1, 1, 1)
+	withKeys := func(name string) hegel.Generator[*node] {
+		return hegel.Map(keys, func(ks []key) *node { return &node{kind: "var", name: name, keys: ks} })
+	}
+	return hegel.FlatMap(evenHalves(varNames...), func(name string) hegel.Generator[*node] {
+		if name == "m" || name == "m2" || name == "arr" {
+			return withKeys(name)
+		}
+		return dieChoice(hzW(80, hegel.Just(&node{kind: "var", name: name})), hzW(20, withKeys(name)))
+	})
+}
+
+// leafGen is a leaf: a literal 60 percent of the time, else a bare-or-pathed variable whose
+// index expressions are literals.
+var leafGen hegel.Generator[*node]
+
+// infixAt is an infix of depth d: the operator from the pool; its operands an expression
+// and an operand of depth d-1, or, for the arithmetic and bit operators 60 percent of the
+// time, each of them retargeted half the time to a numeric leaf (the old genExpr's
+// retargeting, decided before the operands are built).
+func infixAt(d int) hegel.Generator[*node] {
+	return hegel.FlatMap(evenHalves(infixOps...), func(op string) hegel.Generator[*node] {
+		plain := hegel.FlatMap(exprGen[d-1][0], func(a *node) hegel.Generator[*node] {
+			return hegel.Map(operandGen[d-1], func(b *node) *node { return &node{kind: "infix", op: op, a: a, b: b} })
+		})
+		if gvalTable[op] < 60 {
+			return plain
+		}
+		retargeted := hegel.FlatMap(dieCoin(50), func(numA bool) hegel.Generator[*node] {
+			return hegel.FlatMap(dieCoin(50), func(numB bool) hegel.Generator[*node] {
+				ga, gb := exprGen[d-1][0], operandGen[d-1]
+				if numA {
+					ga = numericGen
+				}
+				if numB {
+					gb = numericGen
+				}
+				return hegel.FlatMap(ga, func(a *node) hegel.Generator[*node] {
+					return hegel.Map(gb, func(b *node) *node { return &node{kind: "infix", op: op, a: a, b: b} })
+				})
+			})
+		})
+		return dieChoice(hzW(40, plain), hzW(60, retargeted))
+	})
+}
+
+func prefixAt(d int) hegel.Generator[*node] {
+	return hegel.FlatMap(evenHalves("-", "!", "~"), func(op string) hegel.Generator[*node] {
+		return hegel.Map(exprGen[d-1][0], func(a *node) *node { return &node{kind: "prefix", op: op, a: a} })
+	})
+}
+
+// ternaryAt is a ternary of depth d; at the top the else is absent 20 percent of the time
+// (an elseless ternary parses only at the end of the expression; realised 17 to 21).
+func ternaryAt(d int, top bool) hegel.Generator[*node] {
+	elseGen := hegel.Map(exprGen[d-1][0], func(c *node) *node { return c })
+	if top {
+		elseGen = dieChoice(hzW(20, hegel.Just[*node](nil)), hzW(80, exprGen[d-1][0]))
+	}
+	return hegel.FlatMap(exprGen[d-1][0], func(a *node) hegel.Generator[*node] {
+		return hegel.FlatMap(exprGen[d-1][0], func(b *node) hegel.Generator[*node] {
+			return hegel.Map(elseGen, func(c *node) *node { return &node{kind: "ternary", a: a, b: b, c: c} })
+		})
+	})
+}
+
+// arrayOf is zero to three elements evenly (realised 26, 27, 24, 23).
+func arrayOf(elt hegel.Generator[*node]) hegel.Generator[*node] {
+	return hegel.Map(dieCounted(elt, 0, 1, 1, 1, 1), func(elts []*node) *node { return &node{kind: "array", elts: elts} })
+}
+
+// objectAt is an object of zero to three pairs (realised 20, 26, 23, 30: the halving
+// helper's last branch runs a few points high), the key a string literal of the pool 70
+// percent of the time, else an expression (keys that are literals realised 82: the
+// expression arm's leaves are literals too).
+func objectAt(d int) hegel.Generator[*node] {
+	pair := hegel.FlatMap(dieChoice(hzW(70, strLitFrom(objKeySet)), hzW(30, exprGen[d-1][0])), func(k *node) hegel.Generator[[]*node] {
+		return hegel.Map(exprGen[d-1][0], func(v *node) []*node { return []*node{k, v} })
+	})
+	return hegel.Map(dieCounted(pair, 0, 1, 1, 1, 1), func(pairs [][]*node) *node {
+		n := &node{kind: "object"}
+		for _, p := range pairs {
+			n.oks = append(n.oks, p[0])
+			n.elts = append(n.elts, p[1])
+		}
+		return n
+	})
+}
+
+// exprAt is an expression of depth d: at depth 0, or 20 percent of the time, a leaf; else
+// an infix 50, a prefix 12, a ternary 10, an array 8, an object 6, a variable with a path
+// 14 (the old genExpr's arms). Realised at the top of a run's trees: a leaf or a variable
+// 31 (20 and the variable arm's bare draws), an infix 40, a prefix 9, a ternary 8, an array
+// 6.5, an object 4.6; the trees' depths (an index expression adds one) 0: 30, 1: 27, 2: 20,
+// 3: 11, 4: 9, 5: 4.
+func exprAt(d int, top bool) hegel.Generator[*node] {
+	if d == 0 {
+		return leafGen
+	}
+	inner := halvesGens([]int{50, 12, 10, 8, 6, 14},
+		infixAt(d), prefixAt(d), ternaryAt(d, top), arrayOf(exprGen[d-1][0]), objectAt(d), varGen[d-1])
+	return dieChoice(hzW(20, leafGen), hzW(80, inner))
+}
+
+// operandAt is the right operand of an infix: a regex literal a quarter of the time, an
+// array of literals 15 percent (a fifth of the rest), else an expression of the depth.
+func operandAt(d int) hegel.Generator[*node] {
+	return halvesGens([]int{25, 15, 60}, regexLit, arrayOf(litGen), exprGen[d][0])
+}
+
+func init() {
+	varGen[0] = varAt(0)
+	leafGen = dieChoice(hzW(60, litGen), hzW(40, varGen[0]))
+	for d := 0; d <= maxDepth; d++ {
+		if d > 0 {
+			varGen[d] = varAt(d)
+		}
+		exprGen[d][0] = exprAt(d, false)
+		exprGen[d][1] = exprAt(d, true)
+		operandGen[d] = operandAt(d)
+	}
+}
+
+// treeOfDepth is a tree of a depth in lo..hi, evenly, at the top.
+func treeOfDepth(lo, hi int) hegel.Generator[*node] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(d int) hegel.Generator[*node] { return exprGen[d][1] })
+}
+
+// --------------------------------------------------------------------------- spacing
+
+// gapKinds is one gap's blank: a space 40 percent of the time, two spaces, a tab or a
+// newline 20 each (the old sp's five-way draw; realised 40, 20, 20, 20).
+var gapKinds = halvesOver([]int{40, 20, 20, 20}, 3, 0, 1, 2)
+
+// spacingGen is the spacing of one rendering: blanks at the gaps 70 percent of the time (the
+// old space coin: dieCoin(70) realised 74 to 78 here, dieCoin(63) realises 67 to 72, mean
+// 70), as a list of 64 gap kinds the renderer cycles through; none otherwise.
+var spacingGen = hegel.FlatMap(dieCoin(63), func(space bool) hegel.Generator[spacing] {
+	if !space {
+		return hegel.Just(spacing{})
+	}
+	return hegel.Map(hzCounted(gapKinds, 64, 64), func(gaps []int) spacing { return spacing{space: true, gaps: gaps} })
+})
+
+// --------------------------------------------------------------------------- the records
+
+// evaluateCase: a tree of depth 1..4 and its two renderings, the minimal one by Go's table
+// and the fully parenthesized one, each with its own spacing; evaluated against params.
+type evaluateCase struct {
+	tree          *node
+	spMin, spFull spacing
+	minimal, full string
+}
+
+// evaluateCasesOf is the evaluate records of the trees (the narrow properties draw their own
+// trees).
+func evaluateCasesOf(trees hegel.Generator[*node]) hegel.Generator[evaluateCase] {
+	return hegel.FlatMap(trees, func(tree *node) hegel.Generator[evaluateCase] {
+		return hegel.FlatMap(spacingGen, func(spMin spacing) hegel.Generator[evaluateCase] {
+			return hegel.Map(spacingGen, func(spFull spacing) evaluateCase {
+				return evaluateCase{tree: tree, spMin: spMin, spFull: spFull,
+					minimal: render(tree, goTable, false, spMin), full: render(tree, goTable, true, spFull)}
+			})
+		})
+	})
+}
+
+var evaluateCases = evaluateCasesOf(treeOfDepth(1, 4))
+
+func (c evaluateCase) GoString() string {
+	return fmt.Sprintf("evaluateCase{minimal: %q, full: %q, against params}", c.minimal, c.full)
+}
+
+// reuseCase: a tree of depth 1..3 rendered once, fully parenthesized 30 percent of the time
+// (realised 28; else minimally by Go's table), evaluated against params, params2 and params
+// again.
+type reuseCase struct {
+	tree *node
+	full bool
+	sp   spacing
+	text string
+}
+
+var reuseCases = hegel.FlatMap(treeOfDepth(1, 3), func(tree *node) hegel.Generator[reuseCase] {
+	return hegel.FlatMap(dieCoin(30), func(full bool) hegel.Generator[reuseCase] {
+		return hegel.Map(spacingGen, func(sp spacing) reuseCase {
+			return reuseCase{tree: tree, full: full, sp: sp, text: render(tree, goTable, full, sp)}
+		})
+	})
+})
+
+func (c reuseCase) GoString() string {
+	form := "minimal"
+	if c.full {
+		form = "full"
+	}
+	return fmt.Sprintf("reuseCase{%q (%s), against params, params2, params}", c.text, form)
+}
+
+// conversionsCase: a tree of depth 1..3 rendered minimally by Go's table, evaluated against
+// params by EvalBool, EvalFloat64, EvalInt and EvalString.
+type conversionsCase struct {
+	tree *node
+	sp   spacing
+	text string
+}
+
+var conversionsCases = hegel.FlatMap(treeOfDepth(1, 3), func(tree *node) hegel.Generator[conversionsCase] {
+	return hegel.Map(spacingGen, func(sp spacing) conversionsCase {
+		return conversionsCase{tree: tree, sp: sp, text: render(tree, goTable, false, sp)}
+	})
+})
+
+func (c conversionsCase) GoString() string {
+	return fmt.Sprintf("conversionsCase{%q, against params}", c.text)
+}
+
+// --------------------------------------------------------------------------- the decimal
+// trees
+
+// decExponent is the exponent of ** : a literal 0..3 (realised 27, 25, 25, 23).
+var decExponent = hegel.Map(evenHalves("0", "1", "2", "3"), func(s string) *dnode { return &dnode{lit: s} })
+
+var decVar = hegel.Just(&dnode{v: true})
+
+// decLeaf is a literal of the pool 80 percent of the time (realised 82), else the variable x.
+var decLeaf = dieChoice(hzW(80, hegel.Map(evenHalves(decLits...), func(s string) *dnode { return &dnode{lit: s} })), hzW(20, decVar))
+
+var decGen [maxDepth + 1]hegel.Generator[*dnode]
+
+// decAt is a decimal tree of depth d: at depth 0, or a quarter of the time, a leaf (25
+// nominal: the weight 25 realised 22, 28 realises 24), else a negation 15 percent of the
+// time (of a tree of depth d-1; under HEGEL_NO_KNOWN=1 of the variable only, the one operand
+// the library negates: gval/1's shape at weight zero; realised 12 of all trees against 11
+// nominal), else an infix of the pool with operands of depth d-1 (the exponent of ** a
+// literal 0..3; realised 64). The trees' depths of a run: 0: 24, 1: 24, 2: 20, 3: 16, 4: 16.
+func decAt(d int) hegel.Generator[*dnode] {
+	if d == 0 {
+		return decLeaf
+	}
+	infix := hegel.FlatMap(evenHalves(decOps...), func(op string) hegel.Generator[*dnode] {
+		right := decGen[d-1]
+		if op == "**" {
+			right = decExponent
+		}
+		return hegel.FlatMap(decGen[d-1], func(a *dnode) hegel.Generator[*dnode] {
+			return hegel.Map(right, func(b *dnode) *dnode { return &dnode{op: op, a: a, b: b} })
+		})
+	})
+	neg := hegel.Map(hzShaped[hegel.Generator[*dnode]](decGen[d-1], decVar), func(a *dnode) *dnode { return &dnode{neg: a} })
+	return dieChoice(hzW(28, decLeaf), hzW(72, dieChoice(hzW(85, infix), hzW(15, neg))))
+}
+
+func init() {
+	for d := 0; d <= maxDepth; d++ {
+		decGen[d] = decAt(d)
+	}
+}
+
+// decimalCase: a decimal tree of depth 1..4 and its text, evaluated with x = 3.0.
+type decimalCase struct {
+	tree *dnode
+	text string
+}
+
+func decimalCasesOf(trees hegel.Generator[*dnode]) hegel.Generator[decimalCase] {
+	return hegel.Map(trees, func(tree *dnode) decimalCase { return decimalCase{tree: tree, text: decRender(tree)} })
+}
+
+var decimalCases = decimalCasesOf(hegel.FlatMap(rangeHalves(1, 4), func(d int) hegel.Generator[*dnode] { return decGen[d] }))
+
+func (c decimalCase) GoString() string {
+	return fmt.Sprintf("decimalCase{%q, x = 3.0}", c.text)
+}
diff --git a/hegel/hegel_zoo_idioms_test.go b/hegel/hegel_zoo_idioms_test.go
new file mode 100644
index 0000000..3bf1029
--- /dev/null
+++ b/hegel/hegel_zoo_idioms_test.go
@@ -0,0 +1,619 @@
+package hegel
+
+// The generator idioms the properties share, copied from the excelize/graphql-go/cobra/
+// cascadia/carbon/orb/chi/go-debian/gin/cellbuf/kong/roaring/mergo/gotext/go-envconfig/gronx
+// harness (hegel_zoo_idioms_test.go there) with the hz prefix: hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator. Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on it,
+// except the shape of a recorded bug a wide property must reach every run, which goes first
+// at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a
+// weighted choice drawn alone comes out exact (the engine enumerates a small die), but inside
+// a case with other draws the engine favours the small values of any bounded draw at every
+// scale (go/chi and go/go-debian measured it: Integers(0, 99) lands in 0..9 about 29 percent
+// of the time, coins realise about 0.83 of nominal), so the rates are what the probe and the
+// collector (HEGEL_COLLECT=1) measure; hzFair, fairOver, fairInts, evenOver and fairTree
+// (from go/chi) re-roll the favourite face, the die* family (from go/go-debian) draws from
+// fair bits, the halving helpers at the end (from go/gin and go/kong: evenHalves,
+// rangeHalves, countedHalves, halvesOver, halvesGens, evenGens) halve a range by fair bits,
+// and the figure beside every weight in the generator files is the measured one.
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	from   hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, from: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](parts ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(parts))
+		for i, g := range parts {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](parts ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range parts {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.from
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].from
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].from
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var subtrees []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			subtrees = append(subtrees, hegel.Just(vs[i]))
+		} else {
+			subtrees = append(subtrees, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(subtrees)), func(i int) hegel.Generator[T] { return subtrees[i] })
+	}
+	choices := make([]hzChoice[T], len(subtrees))
+	for i, g := range subtrees {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// --------------------------------------------------------------------------- added for
+// go/gin: evenHalves is a table at one weight each drawn by halving: a fair-bit choice
+// between the two halves at their sizes (dieChoice), and each half again, down to one value;
+// the first value is the shrink target. dieTree's three-way splits (hzDie(3)) realised their
+// last face at 12 to 27 instead of 33 in gin's harness, so even tables are halved instead.
+// rangeHalves is the integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
+
+// --------------------------------------------------------------------------- added for
+// go/kong (halvesOver, halvesGens) and go/mergo (evenGens): weighted and even choices over
+// generators drawn by halving.
+
+// halvesOver is a table at the weights (the first value the shrink target) drawn by halving
+// like evenHalves (the go/kong helper): the entries are cut where the cumulative weight is
+// nearest half, a fair-bit choice between the two parts at their summed weights (dieChoice),
+// and each part again, down to one value. Every split is two-way; an entry of weight zero is
+// never drawn.
+func halvesOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	gens := make([]hegel.Generator[T], len(values))
+	for i, v := range values {
+		gens[i] = hegel.Just(v)
+	}
+	return halvesGens(weights, gens...)
+}
+
+// halvesGens is halvesOver over generators: the alternatives of a weighted choice at their
+// weights, drawn by halving (the first the shrink target).
+func halvesGens[T any](weights []int, gens ...hegel.Generator[T]) hegel.Generator[T] {
+	if len(weights) != len(gens) {
+		panic("halvesGens: weights and generators differ in length")
+	}
+	var ws []int
+	var gs []hegel.Generator[T]
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			gs = append(gs, gens[i])
+		}
+	}
+	if len(gs) == 0 {
+		panic("halvesGens: every alternative has weight 0")
+	}
+	if len(gs) == 1 {
+		return gs[0]
+	}
+	total := 0
+	for _, w := range ws {
+		total += w
+	}
+	cut, acc, best := 1, 0, -1
+	for i := 1; i < len(gs); i++ {
+		acc += ws[i-1]
+		d := 2*acc - total
+		if d < 0 {
+			d = -d
+		}
+		if best < 0 || d < best {
+			cut, best = i, d
+		}
+	}
+	left := 0
+	for _, w := range ws[:cut] {
+		left += w
+	}
+	return dieChoice(hzW(left, halvesGens(ws[:cut], gs[:cut]...)), hzW(total-left, halvesGens(ws[cut:], gs[cut:]...)))
+}
+
+// evenGens is halvesGens at one weight each.
+func evenGens[T any](gens ...hegel.Generator[T]) hegel.Generator[T] {
+	ws := make([]int, len(gens))
+	for i := range ws {
+		ws[i] = 1
+	}
+	return halvesGens(ws, gens...)
+}
diff --git a/hegel/hegel_zoo_model_test.go b/hegel/hegel_zoo_model_test.go
new file mode 100644
index 0000000..c398b6c
--- /dev/null
+++ b/hegel/hegel_zoo_model_test.go
@@ -0,0 +1,1460 @@
+package hegel
+
+// The model of gval's documented behaviour and the replicas of its recorded bugs.
+//
+// The expression tree (node) is rendered to text by a pure renderer (render: the writer's
+// table of precedences, minimal or full parenthesization, a spacing record) and evaluated by
+// a model of the documented semantics of gval.Full (the model type): Go float64 arithmetic,
+// the operator resolution order of operator.go's initiate (strict number, bool and text
+// operands, then the same with the documented conversions, then the arbitrary fallback),
+// short circuits, the variable selector on maps and arrays, JSON literals, regex matching,
+// the ternary and ??. The decimal language (dnode, dmodel) is modelled with exact rationals:
+// + - * % and integer powers exact, / rounded to 16 places half away from zero as
+// shopspring/decimal v1.3.1's Div does (decimal.go :551-628), ** truncating its exponent as
+// Pow does (:636-650), comparisons exact.
+//
+// The switches (known, hegel_zoo_test.go) are threaded through the models: with every switch
+// off they state the documented behaviour; with a switch on they reproduce the library's
+// rule at the lines cited beside each read (kDecimalNegateFails in dmodel.eval,
+// kCoalesceZeroValues in coalesce, kTernaryZeroNotBool in truthy, kArrayBadIndexReturnsArray
+// in selectVar, kConstantFoldingParseErrors and kBasePrefixedIntsRejected in parsePhase,
+// kPrecedenceNotGo in reread, kDecimalDivideByZeroPanics in dmodel.divide). The four
+// expected functions at the end are pure functions of a case and the switch set returning
+// every value the property checks; the classifier in hegel_zoo_test.go runs them per switch
+// before the library is called.
+//
+// The check values are the outcome strings: a value with type tags (canon: "f3", `"abc"`,
+// "true", "nil", "[f1,"a"]", `{"k":f1}`), "error: parse" for an error of NewEvaluable (its
+// message carries the position and the text and is not the model's to predict: compared by
+// kind), "error: <message>" for an evaluation error, whose message the model predicts
+// exactly (every message of the documented model is the library's text at the cited line,
+// and the replicas' too: "invalid operation (T) op (T)", "unexpected v(T) expected number",
+// "unexpected T expected bool", "unexpected T expected number", "unknown parameter 'k' on
+// T", "expected type []interface{} for in operator but got T", regexp's own, "expected bool
+// but got v (T)", "expected number but got v (T)"; the library's is read with its wrapper
+// removed), "panic" for a panic, and "unspecified" where Go leaves the value
+// implementation-defined (a float to integer conversion out of range: filtered out of the
+// properties by name, never judged).
+
+import (
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// --------------------------------------------------------------------------- trees
+
+// node is an expression of gval.Full's grammar. A literal carries its value and its
+// spelling (the text the renderer writes: a number's form, a string's quotes).
+type node struct {
+	kind  string // lit var prefix infix ternary array object
+	val   any    // lit: float64 (>= 0), string, bool
+	spell string // lit: the text as written
+	name  string // var: root identifier
+	keys  []key  // var: path after the root
+	op    string
+	a, b  *node // prefix: a; infix: a, b; ternary: cond=a, then=b, else=c (c nil: no else)
+	c     *node
+	elts  []*node // array elements / object values
+	oks   []*node // object keys
+}
+
+type key struct {
+	dot  bool   // .ident
+	name string // dot key
+	expr *node  // [expr]
+}
+
+// gvalTable is gval's table of precedences (gval.go :304-333), the reader's table of the
+// library and the writer's table of the fully parenthesized rendering; goTable is Go's
+// order, which the README promises ("The normal Go-standard order of operators is
+// respected"): << >> and & with * / %, | and ^ with + -, the rest as gval has it (?? at the
+// bottom, then || and &&, the comparisons, ** at the top). The minimal rendering of every
+// property is written by goTable.
+var gvalTable = map[string]int{
+	"??": 0, "||": 20, "&&": 21,
+	"==": 40, "!=": 40, ">": 40, ">=": 40, "<": 40, "<=": 40, "=~": 40, "!~": 40, "in": 40,
+	"^": 60, "&": 60, "|": 60, "<<": 90, ">>": 90, "+": 120, "-": 120, "*": 150, "/": 150, "%": 150, "**": 200,
+}
+
+var goTable = map[string]int{
+	"??": 0, "||": 20, "&&": 21,
+	"==": 40, "!=": 40, ">": 40, ">=": 40, "<": 40, "<=": 40, "=~": 40, "!~": 40, "in": 40,
+	"|": 120, "^": 120, "+": 120, "-": 120, "*": 150, "/": 150, "%": 150, "<<": 150, ">>": 150, "&": 150, "**": 200,
+}
+
+var infixOps = []string{"+", "-", "*", "/", "%", "**", "==", "!=", ">", ">=", "<", "<=", "&&", "||", "??", "in", "=~", "!~", "^", "&", "|", "<<", ">>"}
+
+// params is the parameter map the expressions run against; params2 has the same shape with
+// other values (the reuse property). Both are built fresh per call (the library may keep
+// what it is given).
+func params() map[string]any {
+	return map[string]any{
+		"x": 3.0, "y": 0.5, "z": 0.0, "s": "abc", "t": "3", "u": "true", "b": true, "f": false, "n": nil,
+		"arr": []any{1.0, "a", true}, "m": map[string]any{"k": 1.0, "s": "x", "e": ""},
+		"m2": map[string]any{"a": map[string]any{"b": []any{2.0, 4.0}}},
+	}
+}
+
+func params2() map[string]any {
+	return map[string]any{
+		"x": 0.0, "y": 2.0, "z": 5.0, "s": "b", "t": "10", "u": "false", "b": false, "f": true, "n": 7.0,
+		"arr": []any{"z", 0.0}, "m": map[string]any{"k": "1", "s": 2.0, "e": nil},
+		"m2": map[string]any{"a": map[string]any{"b": []any{}}},
+	}
+}
+
+// reuseParams is the parameter sets the reuse property evaluates against, in order.
+func reuseParams() []map[string]any { return []map[string]any{params(), params2(), params()} }
+
+// --------------------------------------------------------------------------- rendering
+
+// spacing is the drawn spacing of one rendering: whether blanks are written at all (the old
+// space coin, 70 percent), and the kinds of the blanks the renderer writes at its gaps,
+// cycled through in rendering order (64 of them, drawn as a counted list: two spaces, a tab,
+// a newline or a space); no blanks when space is false.
+type spacing struct {
+	space bool
+	gaps  []int
+}
+
+var gapTexts = []string{"  ", "\t", "\n", " "}
+
+type renderer struct {
+	table map[string]int
+	full  bool // parenthesize every operand
+	sp    spacing
+	at    int // the next gap
+	sb    strings.Builder
+}
+
+// render is the text of n: with minimal parentheses by the table (left associativity, a
+// prefix binding to the next primary, the ternary and ?? at the bottom) or with every
+// operand parenthesized (full), with the spacing's blanks at the gaps.
+func render(n *node, table map[string]int, full bool, sp spacing) string {
+	r := &renderer{table: table, full: full, sp: sp}
+	r.expr(n)
+	return r.sb.String()
+}
+
+func (r *renderer) gap() {
+	if r.sp.space && len(r.sp.gaps) > 0 {
+		r.sb.WriteString(gapTexts[r.sp.gaps[r.at%len(r.sp.gaps)]])
+		r.at++
+	}
+}
+
+func (r *renderer) paren(n *node) {
+	r.sb.WriteByte('(')
+	r.gap()
+	r.expr(n)
+	r.gap()
+	r.sb.WriteByte(')')
+}
+
+// primary renders n as an operand of a prefix operator: literals, variables, JSON literals and
+// other prefixes stand alone, everything else needs parentheses.
+func (r *renderer) primary(n *node) {
+	switch n.kind {
+	case "lit", "var", "array", "object", "prefix":
+		if r.full && n.kind != "lit" && n.kind != "var" {
+			r.paren(n)
+		} else {
+			r.expr(n)
+		}
+	default:
+		r.paren(n)
+	}
+}
+
+// operandNeedsParens is the minimal rendering's decision for a child of an infix of
+// precedence p: an infix child of lower precedence, a right child of equal precedence (left
+// associativity) and a ternary need parentheses.
+func operandNeedsParens(n *node, p int, right bool, table map[string]int) bool {
+	switch n.kind {
+	case "infix":
+		q := table[n.op]
+		return q < p || (right && q == p)
+	case "ternary":
+		return true
+	}
+	return false
+}
+
+func (r *renderer) operand(n *node, p int, right bool) {
+	need := operandNeedsParens(n, p, right, r.table)
+	if r.full && n.kind != "lit" && n.kind != "var" && n.kind != "array" && n.kind != "object" {
+		need = true
+	}
+	if need {
+		r.paren(n)
+	} else {
+		r.expr(n)
+	}
+}
+
+func (r *renderer) expr(n *node) {
+	switch n.kind {
+	case "lit":
+		r.sb.WriteString(n.spell)
+	case "var":
+		r.sb.WriteString(n.name)
+		for _, k := range n.keys {
+			if k.dot {
+				r.sb.WriteString("." + k.name)
+			} else {
+				r.sb.WriteByte('[')
+				r.gap()
+				r.expr(k.expr)
+				r.gap()
+				r.sb.WriteByte(']')
+			}
+		}
+	case "prefix":
+		r.sb.WriteString(n.op)
+		if n.op == "-" && n.a.kind == "prefix" && n.a.op == "-" {
+			r.sb.WriteByte(' ') // "--" would still parse, but keep the two tokens apart
+		}
+		r.primary(n.a)
+	case "infix":
+		p := r.table[n.op]
+		r.operand(n.a, p, false)
+		if n.op == "in" {
+			r.sb.WriteString(" in ")
+		} else {
+			r.gap()
+			r.sb.WriteString(n.op)
+			r.gap()
+		}
+		r.operand(n.b, p, true)
+	case "ternary":
+		if n.a.kind == "ternary" || r.full {
+			r.paren(n.a)
+		} else {
+			r.expr(n.a)
+		}
+		r.gap()
+		r.sb.WriteByte('?')
+		r.gap()
+		if r.full {
+			r.paren(n.b)
+		} else {
+			r.expr(n.b)
+		}
+		if n.c != nil {
+			r.gap()
+			r.sb.WriteByte(':')
+			r.gap()
+			if r.full {
+				r.paren(n.c)
+			} else {
+				r.expr(n.c)
+			}
+		}
+	case "array":
+		r.sb.WriteByte('[')
+		for i, e := range n.elts {
+			if i > 0 {
+				r.sb.WriteByte(',')
+				r.gap()
+			}
+			r.expr(e)
+		}
+		r.sb.WriteByte(']')
+	case "object":
+		r.sb.WriteByte('{')
+		for i, e := range n.elts {
+			if i > 0 {
+				r.sb.WriteByte(',')
+				r.gap()
+			}
+			r.expr(n.oks[i])
+			r.gap()
+			r.sb.WriteByte(':')
+			r.gap()
+			r.expr(e)
+		}
+		r.sb.WriteByte('}')
+	}
+}
+
+// reread is the tree a reader with the table reader reads from the minimal rendering of n
+// by the writer's table (the replica of gval/7: the text is written by Go's table and read
+// by gval's, gval.go :304-333 against the README's promise). The renderer writes
+// parentheses where the writer's table needs them (operandNeedsParens), so every maximal
+// chain of unparenthesized infixes is flattened into its operands and operators in textual
+// order and rebuilt by the reader's table with left associativity (stageStack.push,
+// operator.go :21-40, reduces while the stacked operator's precedence is at least the new
+// one's); the operands, and every other expression context (a parenthesized subtree, a
+// prefix's operand, the parts of a ternary, the elements of an array or object, an index),
+// are re-read the same way. With writer == reader the tree comes back unchanged.
+func reread(n *node, writer, reader map[string]int) *node {
+	switch n.kind {
+	case "lit":
+		return n
+	case "var":
+		out := &node{kind: "var", name: n.name}
+		for _, k := range n.keys {
+			if k.dot {
+				out.keys = append(out.keys, k)
+			} else {
+				out.keys = append(out.keys, key{expr: reread(k.expr, writer, reader)})
+			}
+		}
+		return out
+	case "prefix":
+		return &node{kind: "prefix", op: n.op, a: reread(n.a, writer, reader)}
+	case "ternary":
+		out := &node{kind: "ternary", a: reread(n.a, writer, reader), b: reread(n.b, writer, reader)}
+		if n.c != nil {
+			out.c = reread(n.c, writer, reader)
+		}
+		return out
+	case "array", "object":
+		out := &node{kind: n.kind}
+		for _, e := range n.elts {
+			out.elts = append(out.elts, reread(e, writer, reader))
+		}
+		for _, k := range n.oks {
+			out.oks = append(out.oks, reread(k, writer, reader))
+		}
+		return out
+	}
+	var operands []*node
+	var ops []string
+	flattenChain(n, writer, reader, &operands, &ops)
+	return rebuildChain(operands, ops, reader)
+}
+
+// flattenChain collects the operands and operators of the chain rooted at the infix n as
+// the minimal rendering by the writer's table writes them.
+func flattenChain(n *node, writer, reader map[string]int, operands *[]*node, ops *[]string) {
+	p := writer[n.op]
+	if n.a.kind == "infix" && !operandNeedsParens(n.a, p, false, writer) {
+		flattenChain(n.a, writer, reader, operands, ops)
+	} else {
+		*operands = append(*operands, reread(n.a, writer, reader))
+	}
+	*ops = append(*ops, n.op)
+	if n.b.kind == "infix" && !operandNeedsParens(n.b, p, true, writer) {
+		flattenChain(n.b, writer, reader, operands, ops)
+	} else {
+		*operands = append(*operands, reread(n.b, writer, reader))
+	}
+}
+
+// rebuildChain is the tree a reader builds from the chain by its table: an operator is
+// reduced when the next one's precedence is not higher (left associativity).
+func rebuildChain(operands []*node, ops []string, reader map[string]int) *node {
+	vals := []*node{operands[0]}
+	var stack []string
+	reduce := func() {
+		op := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		b, a := vals[len(vals)-1], vals[len(vals)-2]
+		vals = vals[:len(vals)-2]
+		vals = append(vals, &node{kind: "infix", op: op, a: a, b: b})
+	}
+	for i, op := range ops {
+		for len(stack) > 0 && reader[stack[len(stack)-1]] >= reader[op] {
+			reduce()
+		}
+		stack = append(stack, op)
+		vals = append(vals, operands[i+1])
+	}
+	for len(stack) > 0 {
+		reduce()
+	}
+	return vals[0]
+}
+
+// --------------------------------------------------------------------------- evaluation model
+
+// evalErr is an evaluation error with the library's message; unspecified marks a case whose
+// outcome Go leaves implementation-defined (float to integer conversions out of range); a
+// panicErr is the decimal language's panic (gval/8).
+type evalErr struct{ msg string }
+
+func (e *evalErr) Error() string { return e.msg }
+
+type unspecified struct{ why string }
+
+func (u *unspecified) Error() string { return "unspecified: " + u.why }
+
+type panicErr struct{}
+
+func (*panicErr) Error() string { return "panic" }
+
+func fail(format string, args ...any) error { return &evalErr{fmt.Sprintf(format, args...)} }
+
+// toFloat is convertToFloat (operator.go :201-228) on the values of this model: floats and
+// numeric strings.
+func toFloat(v any) (float64, bool) {
+	switch t := v.(type) {
+	case float64:
+		return t, true
+	case string:
+		f, err := strconv.ParseFloat(t, 64)
+		return f, err == nil
+	}
+	return 0, false
+}
+
+// toBool is convertToBool (operator.go :144-180): bools, nil as false, the strings
+// "false"/"FALSE"/"true"/"TRUE", then any number (zero false).
+func toBool(v any) (bool, bool) {
+	switch t := v.(type) {
+	case bool:
+		return t, true
+	case nil:
+		return false, true
+	case string:
+		switch t {
+		case "false", "FALSE":
+			return false, true
+		case "true", "TRUE":
+			return true, true
+		}
+	}
+	if f, ok := toFloat(v); ok {
+		return f != 0, true
+	}
+	return false, false
+}
+
+// evalString is Evaluable.EvalString's conversion (evaluable.go :64-73): a string as it is,
+// anything else by fmt's %v.
+func evalString(v any) string {
+	if s, ok := v.(string); ok {
+		return s
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+// isZero is reflect.Value.IsZero with nil (gval.go :127, :130; parse.go :277).
+func isZero(v any) bool {
+	return v == nil || reflect.ValueOf(v).IsZero()
+}
+
+// toInt64 converts as Go's int64(f) does where that is defined.
+func toInt64(f float64) (int64, error) {
+	if math.IsNaN(f) || math.IsInf(f, 0) || f >= 9223372036854775808.0 || f < -9223372036854775808.0 {
+		return 0, &unspecified{"float to int64 out of range"}
+	}
+	return int64(f), nil
+}
+
+func toUint64(f float64) (uint64, error) {
+	if math.IsNaN(f) || math.IsInf(f, 0) || f < 0 || f >= 18446744073709551616.0 {
+		return 0, &unspecified{"float to uint64 out of range"}
+	}
+	return uint64(f), nil
+}
+
+// numberOp is the float64 operation of op, if any (gval.go :179-192, :226-230).
+func numberOp(op string, a, b float64) (any, bool, error) {
+	switch op {
+	case "+":
+		return a + b, true, nil
+	case "-":
+		return a - b, true, nil
+	case "*":
+		return a * b, true, nil
+	case "/":
+		return a / b, true, nil
+	case "%":
+		return math.Mod(a, b), true, nil
+	case "**":
+		return math.Pow(a, b), true, nil
+	case ">":
+		return a > b, true, nil
+	case ">=":
+		return a >= b, true, nil
+	case "<":
+		return a < b, true, nil
+	case "<=":
+		return a <= b, true, nil
+	case "==":
+		return a == b, true, nil
+	case "!=":
+		return a != b, true, nil
+	case "^", "&", "|":
+		x, err := toInt64(a)
+		if err != nil {
+			return nil, true, err
+		}
+		y, err := toInt64(b)
+		if err != nil {
+			return nil, true, err
+		}
+		switch op {
+		case "^":
+			return float64(x ^ y), true, nil
+		case "&":
+			return float64(x & y), true, nil
+		default:
+			return float64(x | y), true, nil
+		}
+	case "<<", ">>":
+		x, err := toInt64(a)
+		if err != nil {
+			return nil, true, err
+		}
+		y, err := toUint64(b)
+		if err != nil {
+			return nil, true, err
+		}
+		if op == "<<" {
+			return float64(x << y), true, nil
+		}
+		return float64(x >> y), true, nil
+	}
+	return nil, false, nil
+}
+
+// textOp is the text operation of op, if any (gval.go :242-247).
+func textOp(op string, a, b string) (any, bool) {
+	switch op {
+	case "+":
+		return a + b, true
+	case "<":
+		return a < b, true
+	case "<=":
+		return a <= b, true
+	case ">":
+		return a > b, true
+	case ">=":
+		return a >= b, true
+	}
+	return nil, false
+}
+
+// boolOp is the bool operation of op, if any (gval.go :263-269).
+func boolOp(op string, a, b bool) (any, bool) {
+	switch op {
+	case "&&":
+		return a && b, true
+	case "||":
+		return a || b, true
+	case "==":
+		return a == b, true
+	case "!=":
+		return a != b, true
+	}
+	return nil, false
+}
+
+// applyInfix resolves op on evaluated operands in the order operator.go's initiate (:68-88)
+// builds: strict number, strict bool, strict text, then the same with conversions (text only
+// when there is no arbitrary fallback, and only on two non-nil values, :126-134), then the
+// arbitrary fallback (reflect.DeepEqual for == and !=, gval.go :300-301; inArray, parse.go
+// :243-254; the ?? operator, gval.go :129-134), else "invalid operation" (:69-71).
+func (m *model) applyInfix(op string, a, b any) (any, error) {
+	_, hasNum, _ := numberOp(op, 0, 0)
+	_, hasText := textOp(op, "", "")
+	_, hasBool := boolOp(op, false, false)
+	arbitrary := op == "==" || op == "!=" || op == "in" || op == "??"
+	if hasNum {
+		if x, ok := a.(float64); ok {
+			if y, ok := b.(float64); ok {
+				v, _, err := numberOp(op, x, y)
+				return v, err
+			}
+		}
+	}
+	if hasBool {
+		if x, ok := a.(bool); ok {
+			if y, ok := b.(bool); ok {
+				v, _ := boolOp(op, x, y)
+				return v, nil
+			}
+		}
+	}
+	if hasText {
+		if x, ok := a.(string); ok {
+			if y, ok := b.(string); ok {
+				v, _ := textOp(op, x, y)
+				return v, nil
+			}
+		}
+	}
+	if hasNum {
+		if x, ok := toFloat(a); ok {
+			if y, ok := toFloat(b); ok {
+				v, _, err := numberOp(op, x, y)
+				return v, err
+			}
+		}
+	}
+	if hasBool {
+		if x, ok := toBool(a); ok {
+			if y, ok := toBool(b); ok {
+				v, _ := boolOp(op, x, y)
+				return v, nil
+			}
+		}
+	}
+	if hasText && !arbitrary && a != nil && b != nil {
+		v, _ := textOp(op, evalString(a), evalString(b))
+		return v, nil
+	}
+	switch op {
+	case "==":
+		return reflect.DeepEqual(a, b), nil
+	case "!=":
+		return !reflect.DeepEqual(a, b), nil
+	case "in":
+		col, ok := b.([]any)
+		if !ok {
+			return nil, fail("expected type []interface{} for in operator but got %T", b)
+		}
+		for _, e := range col {
+			if reflect.DeepEqual(a, e) {
+				return true, nil
+			}
+		}
+		return false, nil
+	case "??":
+		if m.coalesce(a) {
+			return a, nil
+		}
+		return b, nil
+	}
+	return nil, fail("invalid operation (%T) %s (%T)", a, op, b)
+}
+
+// isConst reports whether the parser folds n into a Const (literals; prefixes and infixes of
+// constants, language.go :201-207 and operator.go :28-35; JSON literals, variables and
+// ternaries are closures and never constants, parse.go :284-356 and :272): Evaluable.IsConst.
+func isConst(n *node) bool {
+	switch n.kind {
+	case "lit":
+		return true
+	case "prefix":
+		return isConst(n.a)
+	case "infix":
+		return isConst(n.a) && isConst(n.b)
+	}
+	return false
+}
+
+// model evaluates a tree against a parameter map under the switch set k.
+type model struct {
+	p map[string]any
+	k known
+}
+
+func (m *model) eval(n *node) (any, error) { return m.evalNode(n) }
+
+// coalesce reports whether a ?? b yields a: documented for a not nil and not false (gval.go
+// :36); under kCoalesceZeroValues for a not the zero value of its type (gval.go :125-134:
+// reflect.Value.IsZero, so 0, "" and false give b and a non-nil empty array is kept).
+func (m *model) coalesce(a any) bool {
+	if m.k[kCoalesceZeroValues] {
+		return !isZero(a)
+	}
+	return a != nil && a != false
+}
+
+// truthy is the ternary's test of its condition: documented as the bool conversion (gval.go
+// :48, with the conversions of :93-94), an error when the condition does not convert; under
+// kTernaryZeroNotBool the zero-value test (parseIf, parse.go :277: nil or IsZero selects
+// the else branch, so "false" and "abc" select the then branch and "" the else branch).
+func (m *model) truthy(c any) (bool, error) {
+	if m.k[kTernaryZeroNotBool] {
+		return !isZero(c), nil
+	}
+	b, ok := toBool(c)
+	if !ok {
+		return false, fail("unexpected %T expected bool", c)
+	}
+	return b, nil
+}
+
+// litValue is the value of a literal: as drawn, or, for a number under
+// kBasePrefixedIntsRejected, what strconv.ParseFloat reads from its spelling (parseNumber,
+// parse.go :96-102: a legacy octal "017" is 17; a spelling it refuses is parsePhase's parse
+// error and is read as drawn here).
+func (m *model) litValue(n *node) any {
+	if f, ok := n.val.(float64); ok && m.k[kBasePrefixedIntsRejected] {
+		if v, err := strconv.ParseFloat(n.spell, 64); err == nil {
+			return v
+		}
+		return f
+	}
+	return n.val
+}
+
+func (m *model) evalNode(n *node) (any, error) {
+	switch n.kind {
+	case "lit":
+		return m.litValue(n), nil
+	case "var":
+		return m.selectVar(n)
+	case "prefix":
+		a, err := m.eval(n.a)
+		if err != nil {
+			return nil, err
+		}
+		switch n.op {
+		case "-":
+			// gval.go :285-291
+			f, ok := toFloat(a)
+			if !ok {
+				return nil, fail("unexpected %v(%T) expected number", a, a)
+			}
+			return -f, nil
+		case "!":
+			// gval.go :255-261
+			b, ok := toBool(a)
+			if !ok {
+				return nil, fail("unexpected %T expected bool", a)
+			}
+			return !b, nil
+		default:
+			// gval.go :232-238
+			f, ok := toFloat(a)
+			if !ok {
+				return nil, fail("unexpected %T expected number", a)
+			}
+			i, err := toInt64(f)
+			if err != nil {
+				return nil, err
+			}
+			return float64(^i), nil
+		}
+	case "infix":
+		a, err := m.eval(n.a)
+		if err != nil {
+			return nil, err
+		}
+		switch n.op {
+		case "&&":
+			// gval.go :263
+			if a == false {
+				return false, nil
+			}
+		case "||":
+			// gval.go :265
+			if a == true {
+				return true, nil
+			}
+		case "??":
+			// gval.go :125-128
+			if m.coalesce(a) {
+				return a, nil
+			}
+		}
+		if n.op == "=~" || n.op == "!~" {
+			return m.regex(n.op, a, n.b)
+		}
+		b, err := m.eval(n.b)
+		if err != nil {
+			return nil, err
+		}
+		return m.applyInfix(n.op, a, b)
+	case "ternary":
+		c, err := m.eval(n.a)
+		if err != nil {
+			return nil, err
+		}
+		tr, err := m.truthy(c)
+		if err != nil {
+			return nil, err
+		}
+		if !tr {
+			if n.c == nil {
+				return nil, nil
+			}
+			return m.eval(n.c)
+		}
+		return m.eval(n.b)
+	case "array":
+		out := make([]any, len(n.elts))
+		for i, e := range n.elts {
+			v, err := m.eval(e)
+			if err != nil {
+				return nil, err
+			}
+			out[i] = v
+		}
+		return out, nil
+	case "object":
+		// parse.go :339-352: the value before the key
+		out := map[string]any{}
+		for i, e := range n.elts {
+			v, err := m.eval(e)
+			if err != nil {
+				return nil, err
+			}
+			k, err := m.eval(n.oks[i])
+			if err != nil {
+				return nil, err
+			}
+			out[evalString(k)] = v
+		}
+		return out, nil
+	}
+	panic("unknown node " + n.kind)
+}
+
+// regex is =~ and !~ (regEx and notRegEx, evaluable.go :304-366): the left value's text
+// matched against the pattern's text, the pattern's compile error as it is.
+func (m *model) regex(op string, a any, bn *node) (any, error) {
+	b, err := m.eval(bn)
+	if err != nil {
+		return nil, err
+	}
+	re, err := regexp.Compile(evalString(b))
+	if err != nil {
+		return nil, &evalErr{err.Error()}
+	}
+	matched := re.MatchString(evalString(a))
+	if op == "!~" {
+		return !matched, nil
+	}
+	return matched, nil
+}
+
+// selectVar follows a path as variable (evaluable.go :120-156) does: each key's text
+// (EvalString) is evaluated just before it is applied; a map by key (a missing key gives
+// nil), an array by a non-negative in-range integer index, anything else "unknown parameter"
+// (:150, the reflectSelect of :158-206 finding nothing on these values); under
+// kArrayBadIndexReturnsArray a bad index on an array leaves the value unchanged and the path
+// goes on from the array (:141-145 fall out of the switch).
+func (m *model) selectVar(n *node) (any, error) {
+	var cur any = m.p
+	for i := 0; i <= len(n.keys); i++ {
+		var k string
+		if i == 0 {
+			k = n.name
+		} else if n.keys[i-1].dot {
+			k = n.keys[i-1].name
+		} else {
+			v, err := m.eval(n.keys[i-1].expr)
+			if err != nil {
+				return nil, err
+			}
+			k = evalString(v)
+		}
+		switch o := cur.(type) {
+		case map[string]any:
+			cur = o[k]
+		case []any:
+			idx, err := strconv.Atoi(k)
+			if err == nil && idx >= 0 && idx < len(o) {
+				cur = o[idx]
+			} else if m.k[kArrayBadIndexReturnsArray] {
+				// the array itself stays and the path continues from it
+			} else {
+				return nil, fail("unknown parameter '%s' on %T", k, o)
+			}
+		default:
+			return nil, fail("unknown parameter '%s' on %T", k, o)
+		}
+	}
+	return cur, nil
+}
+
+// --------------------------------------------------------------------------- parse phase
+
+// badSpelling reports whether a number of the tree is spelled in a way strconv.ParseFloat
+// refuses (a base prefix without a p exponent: the shape of gval/6, parseNumber, parse.go
+// :96-102).
+func badSpelling(n *node) bool {
+	if n == nil {
+		return false
+	}
+	if n.kind == "lit" {
+		if _, ok := n.val.(float64); ok {
+			_, err := strconv.ParseFloat(n.spell, 64)
+			return err != nil
+		}
+		return false
+	}
+	for _, c := range []*node{n.a, n.b, n.c} {
+		if badSpelling(c) {
+			return true
+		}
+	}
+	for _, c := range append(append([]*node{}, n.elts...), n.oks...) {
+		if badSpelling(c) {
+			return true
+		}
+	}
+	for _, k := range n.keys {
+		if badSpelling(k.expr) {
+			return true
+		}
+	}
+	return false
+}
+
+// foldPhase is the parser's constant folding on n under k: every constant subexpression
+// (isConst) is evaluated when it is reduced (stageStack.push, operator.go :28-35;
+// PrefixOperator, language.go :201-207), whether or not a short circuit or a branch above it
+// would skip it at run time, and a constant regex pattern is compiled when its operator is
+// built (regEx, evaluable.go :319-326). The replica of gval/5: "error: parse" when a fold
+// errors, "unspecified" when a folded value is one Go leaves implementation-defined (the
+// case is then outside the model under this switch whatever the run-time walk would reach:
+// the filter unspecifiedConversion takes it), "" when the folds are clean.
+func foldPhase(n *node, k known) string {
+	if n == nil {
+		return ""
+	}
+	for _, c := range []*node{n.a, n.b, n.c} {
+		if r := foldPhase(c, k); r != "" {
+			return r
+		}
+	}
+	for _, c := range append(append([]*node{}, n.elts...), n.oks...) {
+		if r := foldPhase(c, k); r != "" {
+			return r
+		}
+	}
+	for _, key := range n.keys {
+		if r := foldPhase(key.expr, k); r != "" {
+			return r
+		}
+	}
+	md := &model{p: map[string]any{}, k: k}
+	if isConst(n) && n.kind != "lit" {
+		if _, err := md.evalNode(n); err != nil {
+			switch err.(type) {
+			case *evalErr:
+				return parseError
+			case *unspecified:
+				return "unspecified"
+			}
+		}
+	}
+	if n.kind == "infix" && (n.op == "=~" || n.op == "!~") && isConst(n.b) {
+		v, err := md.evalNode(n.b)
+		if _, ok := err.(*unspecified); ok {
+			return "unspecified"
+		}
+		if err == nil {
+			if _, err := regexp.Compile(evalString(v)); err != nil {
+				return parseError
+			}
+		}
+	}
+	return ""
+}
+
+const parseError = "error: parse"
+
+// parsePhase is NewEvaluable's verdict on the tree under k: "error: parse" when a number's
+// spelling is refused (kBasePrefixedIntsRejected) or a constant subexpression errors when
+// folded (kConstantFoldingParseErrors; "unspecified" when a folded value is outside the
+// model), "" when the tree parses. The documented model
+// parses every tree (the dead branch is never reached, the spelling read as Go reads it).
+func parsePhase(n *node, k known) string {
+	if k[kBasePrefixedIntsRejected] && badSpelling(n) {
+		return parseError
+	}
+	if k[kConstantFoldingParseErrors] {
+		return foldPhase(n, k)
+	}
+	return ""
+}
+
+// outcome spells a model result: the value (canon), "unspecified", "panic" or "error: <msg>".
+func outcome(v any, err error) string {
+	switch err.(type) {
+	case nil:
+		return canon(v)
+	case *unspecified:
+		return "unspecified"
+	case *panicErr:
+		return "panic"
+	}
+	return "error: " + err.Error()
+}
+
+// runOutcome is the outcome of evaluating a parsed tree against p under k.
+func runOutcome(n *node, p map[string]any, k known) string {
+	return outcome((&model{p: p, k: k}).eval(n))
+}
+
+// outcomeOf is Evaluate's outcome: the parse phase, then the run.
+func outcomeOf(n *node, p map[string]any, k known) string {
+	if pe := parsePhase(n, k); pe != "" {
+		return pe
+	}
+	return runOutcome(n, p, k)
+}
+
+// --------------------------------------------------------------------------- comparison
+
+// canon renders a value with type tags; NaN and map order are canonical.
+func canon(v any) string {
+	var sb strings.Builder
+	canonTo(&sb, v)
+	return sb.String()
+}
+
+func canonTo(sb *strings.Builder, v any) {
+	switch t := v.(type) {
+	case nil:
+		sb.WriteString("nil")
+	case bool:
+		fmt.Fprintf(sb, "%t", t)
+	case float64:
+		fmt.Fprintf(sb, "f%s", strconv.FormatFloat(t, 'g', -1, 64))
+	case string:
+		sb.WriteString(strconv.Quote(t))
+	case []any:
+		sb.WriteByte('[')
+		for i, e := range t {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			canonTo(sb, e)
+		}
+		sb.WriteByte(']')
+	case map[string]any:
+		keys := make([]string, 0, len(t))
+		for k := range t {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		sb.WriteByte('{')
+		for i, k := range keys {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			sb.WriteString(strconv.Quote(k))
+			sb.WriteByte(':')
+			canonTo(sb, t[k])
+		}
+		sb.WriteByte('}')
+	default:
+		fmt.Fprintf(sb, "?%T:%v", v, v)
+	}
+}
+
+// --------------------------------------------------------------------------- the decimal
+// language
+
+// dnode is an expression of the decimal language: a literal (text), the float variable x, a
+// negation, or an infix.
+type dnode struct {
+	lit  string
+	v    bool
+	neg  *dnode
+	op   string
+	a, b *dnode
+}
+
+var decOps = []string{"+", "-", "*", "%", "**", "/", "<", "<=", ">", ">=", "==", "!="}
+
+// decRender is the text of a decimal tree: minimal parentheses by gval's table, single
+// spaces around the operators, a negation's infix operand parenthesized (the old property's
+// rendering, byte for byte).
+func decRender(n *dnode) string {
+	var sb strings.Builder
+	decRenderTo(&sb, n, 0, false)
+	return sb.String()
+}
+
+func decRenderTo(sb *strings.Builder, n *dnode, parent int, right bool) {
+	switch {
+	case n.v:
+		sb.WriteString("x")
+	case n.lit != "":
+		sb.WriteString(n.lit)
+	case n.neg != nil:
+		sb.WriteString("-")
+		if n.neg.op != "" {
+			sb.WriteByte('(')
+			decRenderTo(sb, n.neg, 0, false)
+			sb.WriteByte(')')
+		} else {
+			decRenderTo(sb, n.neg, 0, false)
+		}
+	default:
+		p := gvalTable[n.op]
+		need := p < parent || (right && p == parent)
+		if need {
+			sb.WriteByte('(')
+		}
+		decRenderTo(sb, n.a, p, false)
+		sb.WriteString(" " + n.op + " ")
+		decRenderTo(sb, n.b, p, true)
+		if need {
+			sb.WriteByte(')')
+		}
+	}
+}
+
+// isConstD reports whether the parser folds the decimal tree (no variable in it).
+func isConstD(n *dnode) bool {
+	switch {
+	case n.v:
+		return false
+	case n.lit != "":
+		return true
+	case n.neg != nil:
+		return isConstD(n.neg)
+	}
+	return isConstD(n.a) && isConstD(n.b)
+}
+
+// dval is a value of the decimal language: a decimal.Decimal (dDec, the rational r), the
+// bare float parameter x (dFloat: a float64 to the library, which every decimal operator
+// converts, operator.go :251-281, and the only value the prefix - converts), or a bool.
+type dval struct {
+	kind int
+	r    *big.Rat
+	b    bool
+}
+
+const (
+	dDec = iota
+	dFloat
+	dBool
+)
+
+func (v dval) typeName() string {
+	switch v.kind {
+	case dFloat:
+		return "float64"
+	case dBool:
+		return "bool"
+	}
+	return "decimal.Decimal"
+}
+
+// decText is the text decimal.Decimal.String writes for the exact value r (decimal.go
+// :1024-1026, :1463-1500: the digits with the trailing zeros trimmed, no exponent); every
+// value of the model is a terminating decimal.
+func decText(r *big.Rat) string {
+	if r.IsInt() {
+		return r.Num().String()
+	}
+	ten := big.NewRat(10, 1)
+	scaled := new(big.Rat).Set(r)
+	for n := 1; n <= 200; n++ {
+		scaled.Mul(scaled, ten)
+		if scaled.IsInt() {
+			return r.FloatString(n)
+		}
+	}
+	return r.FloatString(16)
+}
+
+var pow16 = new(big.Int).Exp(big.NewInt(10), big.NewInt(16), nil)
+
+// divRound16 is Div (decimal.go :551-553): DivRound to DivisionPrecision = 16 places
+// (:605-628), half away from zero (:45). The divisor is not zero.
+func divRound16(a, b *big.Rat) *big.Rat {
+	q := new(big.Rat).Quo(a, b)
+	scaled := new(big.Rat).Mul(q, new(big.Rat).SetInt(pow16))
+	// round half away from zero: trunc(|x| + 1/2) with the sign
+	num := new(big.Int).Abs(scaled.Num())
+	num.Mul(num, big.NewInt(2))
+	num.Add(num, scaled.Denom())
+	num.Quo(num, new(big.Int).Mul(scaled.Denom(), big.NewInt(2)))
+	if scaled.Sign() < 0 {
+		num.Neg(num)
+	}
+	return new(big.Rat).SetFrac(num, pow16)
+}
+
+// truncRat is the integer part of r toward zero (Decimal.IntPart, decimal.go :963).
+func truncRat(r *big.Rat) *big.Int { return new(big.Int).Quo(r.Num(), r.Denom()) }
+
+// dmodel evaluates a decimal tree under the switch set k.
+type dmodel struct{ k known }
+
+// divide is a / b or a % b: a zero divisor panics under kDecimalDivideByZeroPanics (QuoRem,
+// decimal.go :564-566, through Div :551 and Mod :630) and is the documented error
+// otherwise; / rounds to 16 places (divRound16), % is the exact truncating modulo (a - b *
+// trunc(a / b)).
+func (m *dmodel) divide(op string, a, b *big.Rat) (*big.Rat, error) {
+	if b.Sign() == 0 {
+		if m.k[kDecimalDivideByZeroPanics] {
+			return nil, &panicErr{}
+		}
+		return nil, fail("division by zero")
+	}
+	if op == "/" {
+		return divRound16(a, b), nil
+	}
+	t := truncRat(new(big.Rat).Quo(a, b))
+	return new(big.Rat).Sub(a, new(big.Rat).Mul(b, new(big.Rat).SetInt(t))), nil
+}
+
+// power is Pow (decimal.go :636-650) with exact rationals: the exponent's integer part
+// decides (0 gives 1; the recursion on the exponent halved by Div; an even integer part
+// squares, a positive odd one squares and multiplies by d, a negative odd one squares and
+// divides by d), so an exponent in 0..3 is the exact integer power and a fraction is
+// truncated.
+func (m *dmodel) power(d, e *big.Rat) (*big.Rat, error) {
+	ip := truncRat(e)
+	if ip.Sign() == 0 {
+		return big.NewRat(1, 1), nil
+	}
+	temp, err := m.power(d, divRound16(e, big.NewRat(2, 1)))
+	if err != nil {
+		return nil, err
+	}
+	sq := new(big.Rat).Mul(temp, temp)
+	if new(big.Int).Rem(ip, big.NewInt(2)).Sign() == 0 {
+		return sq, nil
+	}
+	if ip.Sign() > 0 {
+		return sq.Mul(sq, d), nil
+	}
+	return m.divide("/", sq, d)
+}
+
+func (m *dmodel) eval(n *dnode) (dval, error) {
+	switch {
+	case n.v:
+		return dval{kind: dFloat, r: big.NewRat(3, 1)}, nil
+	case n.lit != "":
+		r, ok := new(big.Rat).SetString(n.lit)
+		if !ok {
+			return dval{}, fail("bad literal %s", n.lit)
+		}
+		return dval{kind: dDec, r: r}, nil
+	case n.neg != nil:
+		a, err := m.eval(n.neg)
+		if err != nil {
+			return dval{}, err
+		}
+		// gval.go :216-222: the operand through convertToFloat (operator.go :201-228),
+		// which converts the float parameter and nothing else of this language's values:
+		// a bool fails always; a decimal value fails under kDecimalNegateFails and is
+		// negated as documented ("negative(-)", gval.go :63) otherwise
+		if a.kind == dBool {
+			return dval{}, fail("unexpected %v(%T) expected number", a.b, a.b)
+		}
+		if a.kind == dDec && m.k[kDecimalNegateFails] {
+			return dval{}, fail("unexpected %s(decimal.Decimal) expected number", decText(a.r))
+		}
+		return dval{kind: dDec, r: new(big.Rat).Neg(a.r)}, nil
+	}
+	a, err := m.eval(n.a)
+	if err != nil {
+		return dval{}, err
+	}
+	b, err := m.eval(n.b)
+	if err != nil {
+		return dval{}, err
+	}
+	// operator.go :282-303 then the fallbacks: a bool converts to no decimal, so == and !=
+	// fall to reflect.DeepEqual (gval.go :300-301) and every other operator to "invalid
+	// operation"
+	if a.kind == dBool || b.kind == dBool {
+		switch n.op {
+		case "==", "!=":
+			eq := a.kind == dBool && b.kind == dBool && a.b == b.b
+			return dval{kind: dBool, b: eq == (n.op == "==")}, nil
+		}
+		return dval{}, fail("invalid operation (%s) %s (%s)", a.typeName(), n.op, b.typeName())
+	}
+	switch n.op {
+	case "+":
+		return dval{kind: dDec, r: new(big.Rat).Add(a.r, b.r)}, nil
+	case "-":
+		return dval{kind: dDec, r: new(big.Rat).Sub(a.r, b.r)}, nil
+	case "*":
+		return dval{kind: dDec, r: new(big.Rat).Mul(a.r, b.r)}, nil
+	case "/", "%":
+		r, err := m.divide(n.op, a.r, b.r)
+		if err != nil {
+			return dval{}, err
+		}
+		return dval{kind: dDec, r: r}, nil
+	case "**":
+		r, err := m.power(a.r, b.r)
+		if err != nil {
+			return dval{}, err
+		}
+		return dval{kind: dDec, r: r}, nil
+	}
+	c := a.r.Cmp(b.r)
+	var res bool
+	switch n.op {
+	case "<":
+		res = c < 0
+	case "<=":
+		res = c <= 0
+	case ">":
+		res = c > 0
+	case ">=":
+		res = c >= 0
+	case "==":
+		res = c == 0
+	case "!=":
+		res = c != 0
+	}
+	return dval{kind: dBool, b: res}, nil
+}
+
+// decOutcome spells a decimal result: the exact rational (RatString, which the library's
+// %v is reparsed into), "true"/"false", "panic" or "error: <msg>".
+func decOutcome(v dval, err error) string {
+	switch err.(type) {
+	case nil:
+		if v.kind == dBool {
+			return strconv.FormatBool(v.b)
+		}
+		return v.r.RatString()
+	case *panicErr:
+		return "panic"
+	}
+	return "error: " + err.Error()
+}
+
+// decFoldOutcome is the parse phase of the decimal language under kConstantFoldingParseErrors:
+// the constant subtrees are evaluated in post-order (the order the parser reduces them in:
+// a node when both operands are complete, the left before the right, a prefix right after
+// its operand) and the first error ("error: parse") or panic ("panic") is the verdict, ""
+// when every fold succeeds.
+func (m *dmodel) decFoldOutcome(n *dnode) string {
+	switch {
+	case n.v, n.lit != "":
+		return ""
+	case n.neg != nil:
+		if r := m.decFoldOutcome(n.neg); r != "" {
+			return r
+		}
+	default:
+		if r := m.decFoldOutcome(n.a); r != "" {
+			return r
+		}
+		if r := m.decFoldOutcome(n.b); r != "" {
+			return r
+		}
+	}
+	if !isConstD(n) {
+		return ""
+	}
+	if _, err := m.eval(n); err != nil {
+		if _, ok := err.(*panicErr); ok {
+			return "panic"
+		}
+		return parseError
+	}
+	return ""
+}
+
+// decimalOutcome is Evaluate's outcome in the decimal language under k: the parse phase
+// (the folds), then the run.
+func decimalOutcome(n *dnode, k known) string {
+	m := &dmodel{k: k}
+	if k[kConstantFoldingParseErrors] {
+		if r := m.decFoldOutcome(n); r != "" {
+			return r
+		}
+	}
+	return decOutcome(m.eval(n))
+}
+
+// --------------------------------------------------------------------------- the expected
+// functions
+
+func init() {
+	for i, name := range []string{"minimal", "full", "parse", "const", "eval 0", "eval 1", "eval 2", "bool", "float", "int", "string", "value"} {
+		checkRank[name] = i
+	}
+}
+
+// evaluateExpected: "minimal" and "full", Evaluate's outcomes on the two renderings of the
+// tree. The switches: gval/2, 3, 4 in the model's run, gval/5 and 6 in the parse phase,
+// gval/7 the minimal rendering (written by Go's table) re-read by gval's table (reread).
+func evaluateExpected(c evaluateCase, k known) checks {
+	out := checks{}
+	tree := c.tree
+	if k[kPrecedenceNotGo] {
+		tree = reread(c.tree, goTable, gvalTable)
+	}
+	out.set("minimal", outcomeOf(tree, params(), k))
+	out.set("full", outcomeOf(c.tree, params(), k))
+	return out
+}
+
+// reuseExpected: "parse" NewEvaluable's verdict ("ok" or "error: parse", and then nothing
+// else), "const" IsConst, and "eval 0", "eval 1", "eval 2" the Evaluable's outcomes against
+// params, params2 and params again. The switches as for evaluateExpected (gval/7 only on a
+// minimal rendering).
+func reuseExpected(c reuseCase, k known) checks {
+	out := checks{}
+	tree := c.tree
+	if k[kPrecedenceNotGo] && !c.full {
+		tree = reread(c.tree, goTable, gvalTable)
+	}
+	if pe := parsePhase(tree, k); pe != "" {
+		out.set("parse", pe)
+		return out
+	}
+	out.set("parse", "ok")
+	out.set("const", isConst(tree))
+	for i, p := range reuseParams() {
+		out.set("eval "+strconv.Itoa(i), runOutcome(tree, p, k))
+	}
+	return out
+}
+
+// conversionsExpected: "parse" as for reuseExpected, then "bool", "float", "int" and
+// "string", the outcomes of EvalBool, EvalFloat64, EvalInt and EvalString against params:
+// the evaluation's error for all four when the tree errors, else the documented conversion
+// of the value (convertToBool and convertToFloat with their errors, evaluable.go :21-73;
+// int(f) where Go defines it, "unspecified" otherwise; %v).
+func conversionsExpected(c conversionsCase, k known) checks {
+	out := checks{}
+	tree := c.tree
+	if k[kPrecedenceNotGo] {
+		tree = reread(c.tree, goTable, gvalTable)
+	}
+	if pe := parsePhase(tree, k); pe != "" {
+		out.set("parse", pe)
+		return out
+	}
+	out.set("parse", "ok")
+	v, err := (&model{p: params(), k: k}).eval(tree)
+	if err != nil {
+		o := outcome(v, err)
+		for _, name := range []string{"bool", "float", "int", "string"} {
+			out.set(name, o)
+		}
+		return out
+	}
+	if b, ok := toBool(v); ok {
+		out.set("bool", strconv.FormatBool(b))
+	} else {
+		out.set("bool", "error: "+fmt.Sprintf("expected bool but got %v (%T)", v, v))
+	}
+	if f, ok := toFloat(v); ok {
+		out.set("float", canon(f))
+		if i, err := toInt64(f); err == nil {
+			out.set("int", strconv.FormatInt(int64(int(i)), 10))
+		} else {
+			out.set("int", "unspecified")
+		}
+	} else {
+		msg := "error: " + fmt.Sprintf("expected number but got %v (%T)", v, v)
+		out.set("float", msg)
+		out.set("int", msg)
+	}
+	out.set("string", evalString(v))
+	return out
+}
+
+// decimalExpected: "value", Evaluate's outcome in the decimal language (decimalOutcome).
+// The switches: gval/1 in the negation, gval/5 in the parse phase (a constant subtree that
+// errors, which here is a bool in arithmetic or a zero divisor), gval/8 in the division.
+func decimalExpected(c decimalCase, k known) checks {
+	out := checks{}
+	out.set("value", decimalOutcome(c.tree, k))
+	return out
+}
