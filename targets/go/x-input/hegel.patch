+var terminfoTerms = func() []string {
+	var out []string
+	for _, term := range []string{"xterm", "xterm-256color", "screen", "screen-256color", "tmux", "tmux-256color", "linux", "vt100", "vt220", "rxvt", "rxvt-unicode", "rxvt-unicode-256color", "putty", "konsole", "alacritty", "kitty", "foot", "wezterm", "st-256color", "dumb"} {
+		if ti, err := terminfo.Load(term); err == nil && ti != nil {
