+// csiParams renders CSI param ; param ; ... final.
+func csiParams(p pair[[]int, byte]) string {
+	parts := make([]string, len(p.a))
+	for i, v := range p.a {
+		parts[i] = strconv.Itoa(v)
+	}
+	return "\x1b[" + strings.Join(parts, ";") + string(p.b)
+}
