+// (the region under HEGEL_NO_KNOWN=1) both agree on escape.
+func TestHegelCtrlOpenBracketFlagAppliesToALoneEscape(t *testing.T) {
+	flags := hegel.Map(modifiers(without(flagBits, FlagCtrlOpenBracket), 3), func(f int) int { return f | shaped(FlagCtrlOpenBracket, 0) })
+	cases := pairs(flags, hegel.SampledFrom([]string{"\x1b", "\x1b\x1b"}))
+	shape := shaped("x-input/9", "")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		key := buildKeysTable(c.a, "dumb")[c.b]
+		p := Parser{flags: c.a}
+		got := parseAll(&p, []byte(c.b))
+		if want := []Event{KeyPressEvent(key)}; !reflect.DeepEqual(got, want) {
+			mismatch(ht, shape, "flags %#b: %q is %s in the table but the parser gives\n    %s", c.a, c.b, eventString(KeyPressEvent(key)), eventsString(got))
+		}
+		count("ok")
+	})
+}
+
+// TestHegelTerminfoKeysParseLikeTheTable (x-input/10): a terminfo key sequence read together
+// with the bytes of another key is that key followed by the other, as it is when read on its
+// own (whole-buffer table lookup). The pool is the terminfo sequences the parser reads as
+// another key; under HEGEL_NO_KNOWN=1 the other terminfo sequences.
+func TestHegelTerminfoKeysParseLikeTheTable(t *testing.T) {
+	if len(keyedTerms) == 0 {
+		t.Skip("no terminfo database")
+	}
+	property(t, func(ht *hegel.T) {
+		e := hegel.Draw(ht, terminfoEntries)
+		ht.Assume(e.seq != "")
+		want := []Event{KeyPressEvent(e.key)}
+		if got := readAll(ht, e.seq, e.term, e.flags); !reflect.DeepEqual(got, want) {
+			mismatch(ht, e.shape, "term %s flags %#b: Reader on %q alone gives\n    %s\n  want\n    %s", e.term, e.flags, e.seq, eventsString(got), eventsString(want))
+		}
+		// The companion is a focus report: ESC ends any sequence, where a letter could be
+		// absorbed as its final byte (CSI 2 $ a).
+		want = append(tableWant(e), FocusEvent{})
+		if got := readAll(ht, e.seq+"\x1b[I", e.term, e.flags); !reflect.DeepEqual(got, want) {
+			mismatch(ht, e.shape, "term %s flags %#b: Reader on %q gives\n    %s\n  want\n    %s", e.term, e.flags, e.seq+"\x1b[I", eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// x-input/1: with "report alternate keys", the base-layout key (third sub-parameter) is stored
+// and then falls through into the shifted-key case, overwriting ShiftedCode with the base key;
+// the text derived for shift is then the base key.
+func TestHegelPinKittyBaseKeyOverwritesShiftedKey(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	_, ev := p.parseSequence([]byte("\x1b[97:65:113;2u")) // shift+a on AZERTY: a, shifted A, base q
+	k, _ := ev.(KeyPressEvent)
+	if k.ShiftedCode != 'A' || k.Text != "A" || k.BaseCode != 'q' {
+		t.Errorf("CSI 97:65:113;2u = %s; want shifted 'A', base 'q', text \"A\"", eventString(ev))
+	}
+}
+
+// x-input/2: the Kitty event type on CSI number ; modifiers : event ~ keys is only honoured
+// when the number is 1 (parseKittyKeyboardExt checks params[0] == 1), so releases and repeats
+// of Insert, Delete, PgUp, PgDn and F5–F20 arrive as presses.
+func TestHegelPinTildeKeysIgnoreEventTypes(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	_, ev := p.parseSequence([]byte("\x1b[5;1:3~"))
+	if _, ok := ev.(KeyReleaseEvent); !ok {
+		t.Errorf("CSI 5;1:3~ (pgup release) = %s; want a KeyReleaseEvent", eventString(ev))
+	}
+	_, ev = p.parseSequence([]byte("\x1b[3;1:2~"))
+	if k, ok := ev.(KeyPressEvent); !ok || !k.IsRepeat {
+		t.Errorf("CSI 3;1:2~ (delete repeat) = %s; want IsRepeat", eventString(ev))
+	}
+}
+
+// x-input/3: a num-lock modifier removes the key's text, while caps lock keeps it.
+func TestHegelPinNumLockRemovesKeyText(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	_, ev := p.parseSequence([]byte("\x1b[97;129u"))
+	if k, _ := ev.(KeyPressEvent); k.Text != "a" {
+		t.Errorf("CSI 97;129u (a with num lock) = %s; want text \"a\"", eventString(ev))
+	}
+}
+
+// x-input/4: the URxvt CSI n $ path rewrites '$' to '~' in the caller's buffer.
+func TestHegelPinURxvtDollarMutatesTheInput(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	buf := []byte("\x1b[2$")
+	p.parseSequence(buf)
+	if string(buf) != "\x1b[2$" {
+		t.Errorf("parseSequence changed its input to %q", buf)
+	}
+}
+
+// x-input/5: an invalid UTF-8 byte is reported as UnknownEvent(string(rune(b))), i.e. the
+// UTF-8 encoding of U+00FE for the byte 0xfe, not the byte itself.
+func TestHegelPinUnknownEventEncodesTheByteAsARune(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	_, ev := p.parseSequence([]byte{0xfe})
+	if u, _ := ev.(UnknownEvent); string(u) != "\xfe" {
+		t.Errorf("parseSequence(0xfe) = %q; want the byte \"\\xfe\"", string(u))
+	}
+}
+
+// x-input/6: the ASCII shortcut in parseUtf8 returns one byte before grapheme clustering, so
+// a cluster that starts with an ASCII byte (e + combining acute, keycap emoji) is split into
+// separate key presses, unlike clusters that start with a non-ASCII rune.
+func TestHegelPinASCIILedGraphemeClustersSplit(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	for _, c := range asciiClusters[:3] {
+		w, ev := p.parseSequence([]byte(c))
+		if w != len(c) {
+			t.Errorf("parseSequence(%q) consumed %d of %d bytes: %s", c, w, len(c), eventString(ev))
+		}
+	}
+}
+
+// x-input/7: ESC followed by an introducer byte takes a shortcut with its own shape: alt+[ has
+// no Code and keeps Text "[" (so String() is "[", like typing "["), alt+O is Code 'O' without
+// shift, alt+P and alt+X lack ShiftedCode — all other alt+letters are Code lower + shift.
+func TestHegelPinAltIntroducerKeysAreInconsistent(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	_, ev := p.parseSequence([]byte("\x1b["))
+	if k, _ := ev.(KeyPressEvent); k.Code != '[' || k.Text != "" || k.Mod != ModAlt {
+		t.Errorf("ESC [ = %s; want Code '[', no text, alt (as ESC a gives Code 'a', no text, alt)", eventString(ev))
+	}
+	_, ev = p.parseSequence([]byte("\x1bO"))
+	_, want := p.parseSequence([]byte("\x1bQ"))
+	wk := want.(KeyPressEvent)
+	wk.Code, wk.ShiftedCode = 'o', 'O'
+	if !reflect.DeepEqual(ev, wk) {
+		t.Errorf("ESC O = %s; want %s (the shape ESC Q has)", eventString(ev), eventString(wk))
+	}
+}
+
+// x-input/8: a CSI sequence with more than 32 parameters stops scanning at the 32nd; the
+// rest of the sequence is not consumed and its bytes come back as key presses.
+func TestHegelPinCSIWithManyParametersLeaksItsTail(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	seq := "\x1b[" + strings.Repeat("1;", 33) + "1A"
+	w, ev := p.parseSequence([]byte(seq))
+	if w != len(seq) {
+		t.Errorf("parseSequence consumed %d of %d bytes (%s); the tail %q becomes key presses", w, len(seq), eventString(ev), seq[w:])
+	}
+}
+
+// x-input/9: FlagCtrlOpenBracket is honoured by parseControl and by the key table, but a lone
+// ESC (and ESC ESC) short-circuits in parseSequence before parseControl runs.
+func TestHegelPinCtrlOpenBracketFlagIgnoredForLoneEscape(t *testing.T) {
+	defer guard(t)
+	p := Parser{flags: FlagCtrlOpenBracket}
+	_, ev := p.parseSequence([]byte("\x1b"))
+	want := KeyPressEvent{Code: '[', Mod: ModCtrl}
+	if !reflect.DeepEqual(ev, want) {
+		t.Errorf("with FlagCtrlOpenBracket, ESC = %s; want %s (what buildKeysTable says)", eventString(ev), eventString(want))
+	}
+}
+
+// x-input/10: with FlagTerminfo the key table holds the terminal's terminfo keys, but the
+// Reader consults the table only for a whole read (or an UnknownEvent); a terminfo sequence
+// the parser also recognises is read by the parser when it arrives with other bytes. screen's
+// kbs (DEL) with FlagBackspace: table backspace, parser delete; vt220's kbs (BS): table
+// backspace, parser ctrl+h; tmux's kf48 with FlagFKeys: table f48, parser ctrl+shift+f12.
+func TestHegelPinTerminfoKeysOnlyHonouredAlone(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		term  string
+		flags int
+		seq   string
+	}{
+		{"screen", FlagTerminfo | FlagBackspace, "\x7f"},
+		{"vt220", FlagTerminfo, "\b"},
+		{"tmux", FlagTerminfo | FlagFKeys, "\x1b[24;6~"},
+	}
+	for _, c := range cases {
+		if ti, err := terminfo.Load(c.term); err != nil || ti == nil {
+			t.Errorf("terminfo entry for %s not available: cannot reproduce here", c.term)
+			continue
+		}
+		table := buildKeysTable(c.flags, c.term)
+		key, ok := table[c.seq]
+		if !ok {
+			t.Errorf("%s: %q not in the table", c.term, c.seq)
+			continue
+		}
+		p := Parser{flags: c.flags}
+		_, ev := p.parseSequence([]byte(c.seq))
+		if !reflect.DeepEqual(ev, KeyPressEvent(key)) {
+			t.Errorf("%s: %q is %s in the table but %s from the parser", c.term, c.seq, eventString(KeyPressEvent(key)), eventString(ev))
+		}
+	}
+}
+
+// TestHegelExamples: fixed examples from the protocols.
+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	var p Parser
+	cases := []struct {
+		seq  string
+		want Event
+	}{
+		{"\x1b[97;5u", KeyPressEvent{Code: 'a', Mod: ModCtrl}},
+		{"\x1b[97:65;2u", KeyPressEvent{Code: 'a', ShiftedCode: 'A', Text: "A", Mod: ModShift}},
+		{"\x1b[1;5:3D", KeyReleaseEvent{Code: KeyLeft, Mod: ModCtrl}},
+		{"\x1b[<64;10;20M", MouseWheelEvent{X: 9, Y: 19, Button: MouseWheelUp}},
+		{"\x1b[<3;10;20m", MouseReleaseEvent{X: 9, Y: 19}},
+		{"\x1b[?2026;2$y", ModeReportEvent{Mode: ansi.DECMode(2026), Value: 2}},
+		{"\x1b]52;c;aGVsbG8=\x1b\\", ClipboardEvent{Content: "hello", Selection: 'c'}},
+		{"\x1bP1+r5463=31\x1b\\", CapabilityEvent("Tc=1")},
+		{"\x1bOP", KeyPressEvent{Code: KeyF1}},
+		{"\x1b[15;2~", KeyPressEvent{Code: KeyF5, Mod: ModShift}},
+	}
+	for _, c := range cases {
+		w, ev := p.parseSequence([]byte(c.seq))
+		if w != len(c.seq) || !reflect.DeepEqual(normalize(ev), c.want) {
+			t.Errorf("parseSequence(%q) = %d, %s; want %d, %s", c.seq, w, eventString(ev), len(c.seq), eventString(c.want))
+		}
+	}
+}
