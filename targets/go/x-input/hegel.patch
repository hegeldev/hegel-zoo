+		w, ev := p.parseSequence([]byte(seq))
+		if w != len(seq) {
+			mismatch(ht, shape, "parseSequence(%q) consumed %d of %d bytes (%s); the tail %q becomes key presses", seq, w, len(seq), eventString(ev), seq[w:])
+		}
