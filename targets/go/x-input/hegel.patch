+// ---------------------------------------------------------------- properties
+
+var dumbTable = buildKeysTable(0, "dumb")
+
+// pinnedKind reports the generator kinds that stand for pinned bugs or are not usable inside
+// a stream (bracketed paste markers).
+func pinnedKind(kind string) bool {
+	switch kind {
+	case "kitty-numlock-text", "kitty-shifted-and-base", "csi-tilde-event", "urxvt-dollar", "paste-start", "paste-end":
+		return true
+	}
+	return false
+}
+
+// parseAll runs the parser over the whole buffer, as the Reader does, flattening MultiEvents.
+func parseAll(p *Parser, buf []byte) []Event {
+	var events []Event
+	for len(buf) > 0 {
+		w, ev := p.parseSequence(buf)
+		if w == 0 {
+			w = 1
+		}
+		if ev != nil {
+			events = append(events, ev)
+		}
+		buf = buf[w:]
+	}
+	return flatten(events)
+}
+
+func checkDecode(ht *hegel.T, e encoded) {
+	note(ht, "%s %q", e.kind, e.seq)
+	var p Parser
+	buf := []byte(e.seq)
+	orig := append([]byte(nil), buf...)
+	w, ev := p.parseSequence(buf)
+	if e.kind != "urxvt-dollar" && !bytes.Equal(buf, orig) {
+		fail(ht, "%s: parseSequence modified its input: %q -> %q", e.kind, orig, buf)
+	}
+	if w != len(buf) {
+		fail(ht, "%s: parseSequence(%q) consumed %d of %d bytes (event %s)", e.kind, e.seq, w, len(buf), eventString(ev))
+	}
+	got := flatten([]Event{ev})
+	want := flatten(e.want)
+	switch e.kind {
+	case "kitty-numlock-text", "kitty-shifted-and-base", "csi-tilde-event":
+		// Pinned shapes: num lock removing the text, the base key overwriting the shifted key,
+		// event types ignored for CSI ~ keys.
+		count(e.kind + "-skipped")
+		return
+	}
+	if !reflect.DeepEqual(got, want) {
+		fail(ht, "%s: parseSequence(%q):\n  got\n    %s\n  want\n    %s", e.kind, e.seq, eventsString(got), eventsString(want))
+	}
+	for _, ev := range got {
+		if k, ok := ev.(KeyPressEvent); ok && k.String() == "" {
+			fail(ht, "%s: %s has an empty String()", e.kind, eventString(k))
+		}
+	}
+	count(e.kind)
+}
+
+// TestHegelSequencesDecodeToTheirEvents: every encoded event decodes to itself, consuming exactly
+// its bytes and leaving them untouched.
+func TestHegelSequencesDecodeToTheirEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkDecode(ht, genEvent(ht, true))
+	})
+}
+
+// TestHegelStreamsSplitIntoTheirEvents: a stream of encoded events, back to back in one read,
+// splits into exactly those events (through parseSequence and through the Reader).
+func TestHegelStreamsSplitIntoTheirEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 6)
+		var seq strings.Builder
+		var want []Event
+		kinds := make([]string, 0, k)
+		for i := range k {
+			e := genEvent(ht, i == k-1)
+			if pinnedKind(e.kind) {
+				e = encoded{"focus", "\x1b[I", []Event{FocusEvent{}}}
+			}
+			seq.WriteString(e.seq)
+			want = append(want, e.want...)
+			kinds = append(kinds, e.kind)
+		}
+		note(ht, "stream %v %q", kinds, seq.String())
+		want = flatten(want)
+		var p Parser
+		got := parseAll(&p, []byte(seq.String()))
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "stream %q:\n  got\n    %s\n  want\n    %s", seq.String(), eventsString(got), eventsString(want))
+		}
+		if _, inTable := dumbTable[seq.String()]; inTable && len(want) > 1 {
+			// CSI 1;mod R alone: the Reader's whole-buffer table lookup gives the modified F3
+			// only, the parser both F3 and the cursor report (the documented ambiguity).
+			count("reader-f3-skipped")
+		} else if seq.Len() < 250 {
+			rd, err := NewReader(strings.NewReader(seq.String()), "dumb", 0)
+			if err != nil {
+				fail(ht, "NewReader: %v", err)
+			}
+			evs, err := rd.ReadEvents()
+			if err != nil {
+				fail(ht, "ReadEvents: %v", err)
+			}
+			got := flatten(evs)
+			if !reflect.DeepEqual(got, want) {
+				fail(ht, "Reader on %q:\n  got\n    %s\n  want\n    %s", seq.String(), eventsString(got), eventsString(want))
+			}
+		}
+		count("ok")
+	})
+}
