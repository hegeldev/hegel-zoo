+// TestHegelReaderPastesRoundTrip: bracketed paste through the Reader yields the pasted text.
+func TestHegelReaderPastesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var sb strings.Builder
+		for range n(ht, 0, 40) {
+			sb.WriteString(pick(ht, []string{"a", "Z", " ", "\n", "\t", "\x03", "é", "世", "😃", "\x1b[A", "\x1b", "[", "2", "0", "1", "~"}))
+		}
+		text := sb.String()
+		if strings.Contains(text, "\x1b[201~") {
+			count("contains-terminator")
+			return
+		}
+		before := genEvent(ht, false)
+		if pinnedKind(before.kind) {
+			before = encoded{"focus", "\x1b[I", []Event{FocusEvent{}}}
+		}
+		after := pick(ht, []encoded{{"text", "o", []Event{keyPress('o', "o", 0)}}, {"blur", "\x1b[O", []Event{BlurEvent{}}}, {"none", "", nil}})
+		input := before.seq + "\x1b[200~" + text + "\x1b[201~" + after.seq
+		if len(input) >= 250 {
+			count("too-long")
+			return
+		}
+		note(ht, "paste %q in %q", text, input)
+		rd, err := NewReader(strings.NewReader(input), "dumb", 0)
+		if err != nil {
+			fail(ht, "NewReader: %v", err)
+		}
+		evs, err := rd.ReadEvents()
+		if err != nil {
+			fail(ht, "ReadEvents: %v", err)
+		}
+		got := flatten(evs)
+		want := flatten(before.want)
+		want = append(want, PasteStartEvent{}, PasteEvent(text), PasteEndEvent{})
+		want = append(want, flatten(after.want)...)
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "Reader on %q:\n  got\n    %s\n  want\n    %s", input, eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
