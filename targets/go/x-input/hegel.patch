+// TestHegelKeyTableAgreesWithTheParser: the Reader looks a whole read up in buildKeysTable
+// first and falls back to the parser otherwise; the two must agree, or the same bytes mean
+// different keys depending on how they arrive.
+func TestHegelKeyTableAgreesWithTheParser(t *testing.T) {
+	if len(terminfoTerms) == 0 {
+		t.Skip("no terminfo database")
+	}
+	property(t, func(ht *hegel.T) {
+		e := hegel.Draw(ht, tableEntries)
+		p := Parser{flags: e.flags}
+		got := readerParse(&p, tableOf(e.tableSetup).table, []byte(e.seq))
+		if want := tableWant(e); !reflect.DeepEqual(got, want) {
+			mismatch(ht, e.shape, "term %s flags %#b: %q is %s in the table but the parser gives\n    %s", e.term, e.flags, e.seq, eventString(KeyPressEvent(e.key)), eventsString(got))
+		}
+		count("ok")
+	})
+}
