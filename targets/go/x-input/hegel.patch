+// TestHegelKeyTableAgreesWithTheParser: the Reader looks a whole read up in buildKeysTable
+// first and falls back to the parser otherwise; the two must agree, or the same bytes mean
+// different keys depending on how they arrive.
+func TestHegelKeyTableAgreesWithTheParser(t *testing.T) {
+	if len(terminfoTerms) == 0 {
+		t.Skip("no terminfo database")
+	}
+	type entry struct {
+		flags int
+		term  string
+	}
+	tables := map[entry][]string{}
+	tableOf := map[entry]map[string]Key{}
+	terminfoOf := map[entry]map[string]Key{}
+	property(t, func(ht *hegel.T) {
+		flags := 0
+		for _, f := range []int{FlagCtrlAt, FlagCtrlI, FlagCtrlM, FlagCtrlOpenBracket, FlagBackspace, FlagFind, FlagSelect, FlagFKeys} {
+			if chance(ht, 25) {
+				flags |= f
+			}
+		}
+		term := pick(ht, terminfoTerms)
+		if chance(ht, 70) {
+			flags |= FlagTerminfo
+		}
+		e := entry{flags, term}
+		if _, ok := tables[e]; !ok {
+			tbl := buildKeysTable(flags, term)
+			keys := make([]string, 0, len(tbl))
+			for k := range tbl {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			tables[e] = keys
+			tableOf[e] = tbl
+			terminfoOf[e] = buildTerminfoKeys(flags, term)
+		}
+		seq := pick(ht, tables[e])
+		key := tableOf[e][seq]
+		if flags&FlagTerminfo != 0 {
+			if _, fromTerminfo := terminfoOf[e][seq]; fromTerminfo {
+				count("terminfo-key-skipped") // x-input/10
+				return
+			}
+		}
+		if flags&FlagCtrlOpenBracket != 0 && strings.Trim(seq, "\x1b") == "" {
+			count("ctrl-open-bracket-skipped") // x-input/9
+			return
+		}
+		note(ht, "term %s flags %#b seq %q table %s", term, flags, seq, eventString(KeyPressEvent(key)))
+		p := Parser{flags: flags}
+		got := parseAll(&p, []byte(seq))
+		want := []Event{KeyPressEvent(key)}
+		if strings.HasPrefix(seq, "\x1b[1;") && strings.HasSuffix(seq, "R") {
+			want = append(want, CursorPositionEvent{Y: 0, X: int(key.Mod)})
+		}
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "term %s flags %#b: %q is %s in the table but the parser gives\n    %s", term, flags, seq, eventString(KeyPressEvent(key)), eventsString(got))
+		}
+		count("ok")
+	})
+}
