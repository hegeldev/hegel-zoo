+// TestHegelGraphemesAreOneKey: a grapheme cluster is one key press with its text, whatever
+// its first byte.
+func TestHegelGraphemesAreOneKey(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var c string
+		if chance(ht, 50) {
+			c = pick(ht, clusters)
+		} else {
+			c = pick(ht, asciiClusters)
+			count("ascii-led-skipped") // x-input pin
+			return
+		}
+		var p Parser
+		w, ev := p.parseSequence([]byte(c))
+		if w != len(c) {
+			fail(ht, "%q: consumed %d of %d bytes (%s)", c, w, len(c), eventString(ev))
+		}
+		k, ok := ev.(KeyPressEvent)
+		if !ok || k.Text != c || k.Code != KeyExtended {
+			fail(ht, "%q: %s", c, eventString(ev))
+		}
+		if g, _, _, _ := uniseg.FirstGraphemeClusterInString(c, -1); g != c {
+			fail(ht, "generator: %q is not one cluster", c)
+		}
+		count("ok")
+	})
+}
