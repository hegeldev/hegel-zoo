+package input
+
+// Hegel property tests for charmbracelet/x/input (hegel-zoo target go/x-input).
+//
+// The parser turns terminal input bytes into events. The oracles are the protocols the bytes
+// come from: x/ansi's own encoders (mouse, cursor/mode reports, window ops, clipboard) and
+// hand-written encoders for the Kitty keyboard protocol, xterm's modifyOtherKeys and
+// PC-style function keys, SS3 keypad keys, URxvt keys, OSC colour replies, XTGETTCAP and
+// XTVERSION replies, bracketed paste and plain text. Every generator yields the bytes and
+// the events they mean; the parser must return exactly those events, consume exactly those
+// bytes, leave the buffer untouched, and split a stream of them back into the same list.
+//
+// The generators draw the shapes of the recorded bugs too (bugs.toml); an encoded value
+// carries the bug whose shape it has and a mismatch names it. Under HEGEL_NO_KNOWN=1 the
+// shapes are left out of the pools and every property must pass. Each recorded bug also has
+// a property of its own, named after what it tests, and a pin with a fixed example.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"image/color"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/rivo/uniseg"
+	"github.com/xo/terminfo"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("XINPUT_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// noKnown is read once: under HEGEL_NO_KNOWN=1 the pools leave out the shapes of the
+// recorded bugs and take the neighbouring region instead.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// mismatch fails the case, naming the recorded bug whose shape the input has (if any).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("panic in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+// guard marks a pin: it must fail (the bug is open) and it must not panic the suite.
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Errorf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- combinators
+
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time and shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func (p pair[A, B]) GoString() string { return fmt.Sprintf("(%#v, %#v)", p.a, p.b) }
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// bitsOf ORs a drawn list of bit values: a modifier or flag set.
+func bitsOf(bits []int) int {
+	m := 0
+	for _, b := range bits {
+		m |= b
+	}
+	return m
+}
+
+// modifiers is a set drawn as a list of up to k of the given bit values, ORed.
+func modifiers(bits []int, k int) hegel.Generator[int] {
+	return hegel.Map(many(hegel.SampledFrom(bits), 0, k), bitsOf)
+}
+
+// without is xs minus the given elements.
+func without[T comparable](xs []T, drop ...T) []T {
+	var out []T
+	for _, x := range xs {
+		if !slicesContains(drop, x) {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+func slicesContains[T comparable](xs []T, x T) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+func concat[T any](xss ...[]T) []T {
+	var out []T
+	for _, xs := range xss {
+		out = append(out, xs...)
+	}
+	return out
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) string {
+	if has {
+		return id
+	}
+	return ""
+}
+
+// ---------------------------------------------------------------- events
+
+// normalize makes events comparable with reflect.DeepEqual: colours become color.RGBA.
+func normalize(ev Event) Event {
+	toRGBA := func(c color.Color) color.Color {
+		if c == nil {
+			return nil
+		}
+		r, g, b, a := c.RGBA()
+		return color.RGBA{uint8(r >> 8), uint8(g >> 8), uint8(b >> 8), uint8(a >> 8)}
+	}
+	switch e := ev.(type) {
+	case ForegroundColorEvent:
+		return ForegroundColorEvent{toRGBA(e.Color)}
+	case BackgroundColorEvent:
+		return BackgroundColorEvent{toRGBA(e.Color)}
+	case CursorColorEvent:
+		return CursorColorEvent{toRGBA(e.Color)}
+	case MultiEvent:
+		out := make(MultiEvent, len(e))
+		for i, x := range e {
+			out[i] = normalize(x)
+		}
+		return out
+	}
+	return ev
+}
+
+func flatten(evs []Event) []Event {
+	var out []Event
+	for _, ev := range evs {
+		if m, ok := ev.(MultiEvent); ok {
+			out = append(out, flatten([]Event(m))...)
+		} else {
+			out = append(out, normalize(ev))
+		}
+	}
+	return out
+}
+
+func eventString(ev Event) string {
+	switch e := ev.(type) {
+	case KeyPressEvent:
+		return fmt.Sprintf("KeyPress{Code:%#x(%q) Text:%q Mod:%#b Shifted:%#x Base:%#x Repeat:%v}", e.Code, keyName(e.Code), e.Text, e.Mod, e.ShiftedCode, e.BaseCode, e.IsRepeat)
+	case KeyReleaseEvent:
+		return fmt.Sprintf("KeyRelease{Code:%#x(%q) Text:%q Mod:%#b Shifted:%#x Base:%#x Repeat:%v}", e.Code, keyName(e.Code), e.Text, e.Mod, e.ShiftedCode, e.BaseCode, e.IsRepeat)
+	}
+	return fmt.Sprintf("%T%+v", ev, ev)
+}
+
+func keyName(code rune) string {
+	if s, ok := keyTypeString[code]; ok {
+		return s
+	}
+	if code == KeyExtended {
+		return "extended"
+	}
+	return string(code)
+}
+
+func eventsString(evs []Event) string {
+	parts := make([]string, len(evs))
+	for i, ev := range evs {
+		parts[i] = eventString(ev)
+	}
+	return strings.Join(parts, "\n    ")
+}
+
+// ---------------------------------------------------------------- encoded events
+
+// encoded is a byte sequence, the events it stands for, and the recorded bug whose shape it
+// has ("" for none).
+type encoded struct {
+	kind  string
+	seq   string
+	want  []Event
+	shape string
+}
+
+func (e encoded) GoString() string {
+	s := fmt.Sprintf("%s %q -> %s", e.kind, e.seq, strings.Join(strings.Split(eventsString(e.want), "\n    "), ", "))
+	if e.shape != "" {
+		s += " [" + e.shape + "]"
+	}
+	return s
+}
+
+func keyPress(code rune, text string, mod KeyMod) KeyPressEvent {
+	return KeyPressEvent{Code: code, Text: text, Mod: mod}
+}
+
+func one(kind, seq string, ev Event) encoded { return encoded{kind, seq, []Event{ev}, ""} }
+
+// ---------------------------------------------------------------- text keys
+
+var (
+	// Graphemes that are single runes and never combine with what follows.
+	singleRunes = []rune{'a', 'b', 'q', 'z', 'A', 'Q', 'Z', '0', '9', '!', '/', '?', '~', '#', '{', '}', '`', 'é', 'ñ', 'Ω', 'я', '世', '☃', '😃', 'Ａ'}
+	// Multi-rune grapheme clusters that start with a non-ASCII rune.
+	clusters = []string{"ก\u0e49", "👍🏽", "👨\u200d👩\u200d👧", "🇩🇪", "é\u0301"}
+	// Multi-rune clusters that start with an ASCII byte (x-input/6: split by the ASCII shortcut).
+	asciiClusters = []string{"e\u0301", "n\u0303", "1\ufe0f\u20e3", "a\u200d"}
+	// The bytes that introduce a sequence after ESC: alt+[ alt+O alt+P alt+X take shortcuts
+	// of their own (x-input/7); alt+] alt+_ alt+^ come out like every other alt+key.
+	oddIntroducers  = []rune{'[', 'O', 'P', 'X'}
+	tameIntroducers = []rune{']', '_', '^'}
+	// C0 bytes and DEL.
+	controlBytes = concat(rangeBytes(0, 31), []byte{ansi.DEL})
+	// Bytes that cannot start a UTF-8 sequence (x-input/5: reported as the rune of the byte).
+	invalidBytes = []byte{0xa0, 0xbf, 0xc0, 0xc1, 0xf5, 0xf8, 0xfe, 0xff}
+	// C1 bytes that are not sequence introducers: ctrl+alt+(byte - 0x40).
+	c1Bytes = without(rangeBytes(0x80, 0x9f), ansi.SS3, ansi.DCS, ansi.SOS, ansi.CSI, ansi.OSC, ansi.PM, ansi.APC)
+)
+
+func rangeBytes(lo, hi byte) []byte {
+	out := make([]byte, 0, int(hi-lo)+1)
+	for b := lo; ; b++ {
+		out = append(out, b)
+		if b == hi {
+			return out
+		}
+	}
+}
+
+// runeKey is a printable rune typed on its own: an upper-case ASCII letter is the lower-case
+// key with shift.
+func runeKey(r rune) encoded {
+	k := keyPress(r, string(r), 0)
+	if r < utf8.RuneSelf && unicode.IsUpper(r) {
+		k = KeyPressEvent{Code: unicode.ToLower(r), ShiftedCode: r, Text: string(r), Mod: ModShift}
+	}
+	return one("text", string(r), k)
+}
+
+// clusterKey is a multi-rune grapheme cluster: one KeyExtended press with the cluster as text.
+func clusterKey(c string) encoded {
+	e := one("cluster", c, keyPress(KeyExtended, c, 0))
+	e.shape = shapeIf(c[0] < utf8.RuneSelf, "x-input/6")
+	return e
+}
+
+// controlKey is the VT100 meaning of a C0 byte with no flags set.
+func controlKey(b byte) KeyPressEvent {
+	switch b {
+	case ansi.NUL:
+		return keyPress(KeySpace, "", ModCtrl)
+	case ansi.BS:
+		return keyPress('h', "", ModCtrl)
+	case ansi.HT:
+		return keyPress(KeyTab, "", 0)
+	case ansi.CR:
+		return keyPress(KeyEnter, "", 0)
+	case ansi.ESC:
+		return keyPress(KeyEscape, "", 0)
+	case ansi.DEL:
+		return keyPress(KeyBackspace, "", 0)
+	}
+	if b <= ansi.SUB {
+		return keyPress(rune(b+0x60), "", ModCtrl)
+	}
+	return keyPress(rune(b+0x40), "", ModCtrl) // FS GS RS US → ctrl+\ ] ^ _
+}
+
+func controlByte(b byte) encoded { return one("control", string([]byte{b}), controlKey(b)) }
+
+// rawByte is a byte outside UTF-8 text: a C1 control is ctrl+alt+(byte - 0x40); anything
+// else is unknown input and must come back as the byte itself.
+func rawByte(b byte) encoded {
+	if b >= 0x80 && b <= 0x9f {
+		return one("c1", string([]byte{b}), keyPress(rune(b)-0x40, "", ModCtrl|ModAlt))
+	}
+	e := one("invalid-byte", string([]byte{b}), UnknownEvent(string([]byte{b})))
+	e.shape = "x-input/5"
+	return e
+}
+
+// altKey prefixes a key with ESC: the same key with alt and no text.
+func altKey(inner encoded) encoded {
+	k := inner.want[0].(KeyPressEvent)
+	k.Mod |= ModAlt
+	k.Text = ""
+	first, _ := utf8.DecodeRuneInString(inner.seq)
+	shape := inner.shape
+	if slicesContains(oddIntroducers, first) {
+		shape = "x-input/7"
+	}
+	return encoded{"alt+" + inner.kind, "\x1b" + inner.seq, []Event{k}, shape}
+}
+
+var (
+	runeKeys    = hegel.Map(hegel.SampledFrom(singleRunes), runeKey)
+	altRuneKeys = hegel.Map(hegel.SampledFrom(concat(singleRunes, tameIntroducers, shaped(oddIntroducers, nil))), runeKey)
+	clusterKeys = hegel.Map(hegel.SampledFrom(shaped(concat(clusters, asciiClusters), clusters)), clusterKey)
+	spaceKeys   = hegel.Just(one("space", " ", keyPress(KeySpace, " ", 0)))
+	// A lone ESC is only unambiguous as the last event of a stream: tame controls leave it out.
+	controlKeys  = hegel.Map(hegel.SampledFrom(controlBytes), controlByte)
+	tameControls = hegel.Map(hegel.SampledFrom(without(controlBytes, ansi.ESC)), controlByte)
+	rawBytes     = hegel.Map(hegel.SampledFrom(shaped(concat(invalidBytes, c1Bytes), c1Bytes)), rawByte)
+)
+
+// textKeysOf draws a printable grapheme, a control byte or a raw byte with its key event
+// (flags 0); controls is the pool of control bytes.
+func textKeysOf(controls hegel.Generator[encoded]) hegel.Generator[encoded] {
+	return weighted(
+		choice[encoded]{5, runeKeys},
+		choice[encoded]{1, clusterKeys},
+		choice[encoded]{1, spaceKeys},
+		choice[encoded]{3, controls},
+		choice[encoded]{1, rawBytes},
+	)
+}
+
+// altKeysOf draws ESC + a text key: alt + the key. runes is the pool of printable keys: ESC +
+// an introducer byte is only unambiguous when nothing follows (ESC ] a is an OSC string), so
+// inside a stream the pool is runeKeys and at its end altRuneKeys.
+func altKeysOf(runes, controls hegel.Generator[encoded]) hegel.Generator[encoded] {
+	return hegel.Map(weighted(
+		choice[encoded]{5, runes},
+		choice[encoded]{1, clusterKeys},
+		choice[encoded]{1, spaceKeys},
+		choice[encoded]{3, controls},
+	), altKey)
+}
+
+// ---------------------------------------------------------------- function keys
+
+var (
+	csiFuncKeys = map[byte]rune{'A': KeyUp, 'B': KeyDown, 'C': KeyRight, 'D': KeyLeft, 'E': KeyBegin, 'F': KeyEnd, 'H': KeyHome, 'P': KeyF1, 'Q': KeyF2, 'R': KeyF3, 'S': KeyF4}
+	ss3Keys     = map[byte]rune{'A': KeyUp, 'B': KeyDown, 'C': KeyRight, 'D': KeyLeft, 'E': KeyBegin, 'F': KeyEnd, 'H': KeyHome, 'P': KeyF1, 'Q': KeyF2, 'R': KeyF3, 'S': KeyF4,
+		'M': KeyKpEnter, 'X': KeyKpEqual, 'j': KeyKpMultiply, 'k': KeyKpPlus, 'l': KeyKpComma, 'm': KeyKpMinus, 'n': KeyKpDecimal, 'o': KeyKpDivide,
+		'p': KeyKp0, 'q': KeyKp1, 'r': KeyKp2, 's': KeyKp3, 't': KeyKp4, 'u': KeyKp5, 'v': KeyKp6, 'w': KeyKp7, 'x': KeyKp8, 'y': KeyKp9}
+	tildeKeys = map[int]rune{1: KeyHome, 2: KeyInsert, 3: KeyDelete, 4: KeyEnd, 5: KeyPgUp, 6: KeyPgDown, 7: KeyHome, 8: KeyEnd,
+		11: KeyF1, 12: KeyF2, 13: KeyF3, 14: KeyF4, 15: KeyF5, 17: KeyF6, 18: KeyF7, 19: KeyF8, 20: KeyF9, 21: KeyF10,
+		23: KeyF11, 24: KeyF12, 25: KeyF13, 26: KeyF14, 28: KeyF15, 29: KeyF16, 31: KeyF17, 32: KeyF18, 33: KeyF19, 34: KeyF20}
+)
+
+func sortedKeys[K int | byte, V any](m map[K]V) []K {
+	ks := make([]K, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Slice(ks, func(i, j int) bool { return ks[i] < ks[j] })
+	return ks
+}
+
+// xterm modifier values are 1 + a bit set: shift 1, alt 2, ctrl 4, meta 8 (the KeyMod bits).
+var xtermMods = modifiers([]int{int(ModShift), int(ModAlt), int(ModCtrl), int(ModMeta)}, 3)
+
+// Kitty event types: 0 none, 1 press (written ":1"), 2 repeat, 3 release.
+var eventTypes = hegel.Integers(0, 3)
+
+// eventSuffix renders a Kitty event-type sub-parameter and applies it to the key.
+func eventSuffix(ev int, k KeyPressEvent) (string, Event) {
+	switch ev {
+	case 0:
+		return "", k
+	case 2:
+		k.IsRepeat = true
+		return ":2", k
+	case 3:
+		return ":3", KeyReleaseEvent(k)
+	}
+	return ":1", k
+}
+
+// funcSpec is a PC-style function key: CSI F, CSI 1 F or CSI 1;mod[:event] F.
+type funcSpec struct {
+	f    byte
+	form int // 0 bare, 1 "CSI 1 F", 2 with modifier
+	mod  int
+	ev   int
+}
+
+func csiFuncKey(s funcSpec) encoded {
+	k := keyPress(csiFuncKeys[s.f], "", 0)
+	switch {
+	case s.form == 0 || (s.form == 1 && s.f == 'R'):
+		return one("csi-func", "\x1b["+string(s.f), k)
+	case s.form == 1:
+		return one("csi-func", "\x1b[1"+string(s.f), k)
+	}
+	k.Mod = KeyMod(s.mod)
+	suffix, ev := eventSuffix(s.ev, k)
+	if s.f == 'R' {
+		// CSI 1;mod R is also a cursor position report on row 1; the parser reports both, by
+		// design. Kitty-style event types on F3 use CSI 13;mod:ev ~ instead.
+		return encoded{"csi-func-mod", "\x1b[1;" + strconv.Itoa(s.mod+1) + "R", []Event{k, CursorPositionEvent{Y: 0, X: s.mod}}, ""}
+	}
+	return one("csi-func-mod", "\x1b[1;"+strconv.Itoa(s.mod+1)+suffix+string(s.f), ev)
+}
+
+var csiFuncs = hegel.Map(hegel.Composite(func(tc hegel.TestCase) funcSpec {
+	return funcSpec{
+		f:    hegel.Draw(tc, hegel.SampledFrom(sortedKeys(csiFuncKeys))),
+		form: hegel.Draw(tc, hegel.Integers(0, 2)),
+		mod:  hegel.Draw(tc, xtermMods),
+		ev:   hegel.Draw(tc, eventTypes),
+	}
+}), csiFuncKey)
+
+// tildeSpec is CSI id ~ or CSI id;mod[:event] ~. The event type is only honoured for id 1
+// (x-input/2), so for the other ids the shape region is an event type of 2 or 3.
+type tildeSpec struct {
+	id       int
+	modified bool
+	mod      int
+	ev       int
+}
+
+func csiTildeKey(s tildeSpec) encoded {
+	k := keyPress(tildeKeys[s.id], "", 0)
+	if !s.modified {
+		return one("csi-tilde", "\x1b["+strconv.Itoa(s.id)+"~", k)
+	}
+	k.Mod = KeyMod(s.mod)
+	suffix, ev := eventSuffix(s.ev, k)
+	e := one("csi-tilde-mod", "\x1b["+strconv.Itoa(s.id)+";"+strconv.Itoa(s.mod+1)+suffix+"~", ev)
+	e.shape = shapeIf(s.ev >= 2 && s.id != 1, "x-input/2")
+	return e
+}
+
+// eventTypesFor is the event types drawn for a CSI ~ key: all of them, or under
+// HEGEL_NO_KNOWN=1 only none/press for the ids the parser ignores them on.
+func eventTypesFor(id int) hegel.Generator[int] {
+	if id == 1 {
+		return eventTypes
+	}
+	return shaped(eventTypes, hegel.Integers(0, 1))
+}
+
+func tildeSpecs(ids []int, evs func(int) hegel.Generator[int], modified hegel.Generator[bool]) hegel.Generator[tildeSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) tildeSpec {
+		id := hegel.Draw(tc, hegel.SampledFrom(ids))
+		return tildeSpec{
+			id:       id,
+			modified: hegel.Draw(tc, modified),
+			mod:      hegel.Draw(tc, xtermMods),
+			ev:       hegel.Draw(tc, evs(id)),
+		}
+	})
+}
+
+var csiTildes = hegel.Map(tildeSpecs(sortedKeys(tildeKeys), eventTypesFor, chance(70)), csiTildeKey)
+
+// ss3Key is SS3 F or SS3 mod F (mod 0 = none).
+func ss3Key(p pair[byte, int]) encoded {
+	k := keyPress(ss3Keys[p.a], "", KeyMod(p.b))
+	if p.b == 0 {
+		return one("ss3", "\x1bO"+string(p.a), k)
+	}
+	return one("ss3-mod", "\x1bO"+strconv.Itoa(p.b+1)+string(p.a), k)
+}
+
+var ss3s = hegel.Map(pairs(hegel.SampledFrom(sortedKeys(ss3Keys)), maybe(60, xtermMods)), ss3Key)
+
+// URxvt modified function keys: CSI id ^ (ctrl), CSI id @ (ctrl+shift), CSI id $ (shift). The
+// parser rewrites '$' to '~' in the caller's buffer (x-input/4). '$' is a CSI intermediate
+// byte, so CSI id $ is only unambiguous when nothing follows: inside a stream the forms are
+// the tame ones.
+var (
+	urxvtMods      = map[byte]KeyMod{'^': ModCtrl, '@': ModCtrl | ModShift, '$': ModShift}
+	urxvtForms     = shaped([]byte{'^', '@', '$'}, []byte{'^', '@'})
+	tameUrxvtForms = []byte{'^', '@'}
+)
+
+func urxvtKey(p pair[int, byte]) encoded {
+	e := one("urxvt", "\x1b["+strconv.Itoa(p.a)+string(p.b), keyPress(tildeKeys[p.a], "", urxvtMods[p.b]))
+	e.shape = shapeIf(p.b == '$', "x-input/4")
+	return e
+}
+
+func urxvtsOf(forms []byte) hegel.Generator[encoded] {
+	return hegel.Map(pairs(hegel.SampledFrom(sortedKeys(tildeKeys)), hegel.SampledFrom(forms)), urxvtKey)
+}
+
+var (
+	urxvts     = urxvtsOf(urxvtForms)
+	tameUrxvts = urxvtsOf(tameUrxvtForms)
+)
+
+func functionKeysOf(urxvt hegel.Generator[encoded]) hegel.Generator[encoded] {
+	return weighted(
+		choice[encoded]{2, csiFuncs},
+		choice[encoded]{2, csiTildes},
+		choice[encoded]{1, ss3s},
+		choice[encoded]{1, urxvt},
+	)
+}
+
+// ---------------------------------------------------------------- kitty keyboard
+
+// Kitty functional key codes (a sample) and the C0 specials the protocol keeps.
+var (
+	kittyFunctional = []int{57344, 57345, 57346, 57347, 57348, 57349, 57350, 57353, 57358, 57361, 57364, 57375, 57398, 57399, 57408, 57414, 57427, 57428, 57440, 57441, 57452, 57454}
+	kittyC0         = []int{9, 13, 27, 127}
+	kittyTextRunes  = []rune{'a', 'b', 'z', 'q', '1', '9', ';', '/', '[', '=', 'é', 'ø', 'я', '世', '☃'}
+	kittyShiftAlts  = []rune{'!', '@', '?', ':', '{', '+'}
+	kittyBases      = []rune{'a', 'q', 'z', '1', ';'}
+	kittyTextTails  = []string{"b", "̀", "☃"}
+	// Kitty modifier bits: shift 1, alt 2, ctrl 4, super 8, hyper 16, meta 32, caps 64, num 128.
+	kittyBits = []int{kittyShift, kittyAlt, kittyCtrl, kittySuper, kittyHyper, kittyMeta, kittyCapsLock, kittyNumLock}
+)
+
+// kittyText is the text a program should derive for a text-producing key without an
+// explicit text field: nothing under alt/ctrl/super/hyper/meta, the shifted key under shift
+// or caps lock, the key itself otherwise. Lock modifiers alone do not remove the text.
+func kittyText(code, shifted rune, mod KeyMod) string {
+	if !unicode.IsPrint(code) {
+		return ""
+	}
+	if mod&^(ModShift|ModCapsLock|ModNumLock) != 0 {
+		return ""
+	}
+	if mod&(ModShift|ModCapsLock) == 0 {
+		return string(code)
+	}
+	if shifted != 0 {
+		return string(shifted)
+	}
+	return string(unicode.ToUpper(code))
+}
+
+// kittySpec is a Kitty keyboard protocol key: CSI code[:shifted[:base]] ; mods[:event] ; text u.
+type kittySpec struct {
+	code       rune
+	functional bool             // code is a functional key or C0 special (no alternates, no text)
+	alternates pair[rune, rune] // shifted key (0 = none) and base-layout key (0 = none)
+	bits       int              // Kitty modifier bits
+	ev         int              // event type, 0 = none
+	modsOne    bool             // write the default modifier value 1 before an event type
+	text       string           // explicit text field, "" = none
+}
+
+func kittyKey(s kittySpec) encoded {
+	key := KeyPressEvent{Code: s.code}
+	if s.functional {
+		key = KeyPressEvent(kittyKeyMap[int(s.code)])
+	}
+	codes := strconv.Itoa(int(s.code))
+	shifted, base := s.alternates.a, s.alternates.b
+	if shifted != 0 {
+		codes += ":" + strconv.Itoa(int(shifted))
+		key.ShiftedCode = shifted
+		if base != 0 {
+			codes += ":" + strconv.Itoa(int(base))
+			key.BaseCode = base
+		}
+	}
+	key.Mod = fromKittyMod(s.bits)
+	mods := ""
+	if s.bits != 0 {
+		mods = strconv.Itoa(s.bits + 1)
+	} else if s.ev != 0 && s.modsOne {
+		mods = "1"
+	}
+	suffix, ev := eventSuffix(s.ev, key)
+	seq := "\x1b[" + codes
+	if mods != "" || suffix != "" || s.text != "" {
+		seq += ";" + mods + suffix
+	}
+	text := s.text
+	if s.text != "" {
+		var parts []string
+		for _, r := range s.text {
+			parts = append(parts, strconv.Itoa(int(r)))
+		}
+		seq += ";" + strings.Join(parts, ":")
+	} else if !s.functional {
+		text = kittyText(s.code, shifted, key.Mod)
+	}
+	seq += "u"
+	switch e := ev.(type) {
+	case KeyPressEvent:
+		e.Text = text
+		ev = e
+	case KeyReleaseEvent:
+		e.Text = text
+		ev = e
+	}
+	e := one("kitty", seq, ev)
+	// The base key overwrites the shifted key (x-input/1); num lock removes the derived
+	// text (x-input/3).
+	e.shape = shapeIf(base != 0, "x-input/1")
+	if e.shape == "" && s.text == "" && !s.functional && key.Mod&ModNumLock != 0 && text != "" {
+		e.shape = "x-input/3"
+	}
+	return e
+}
+
+// shiftedOf is the shifted key of a text key: its upper case, or a punctuation alternative
+// when it has none.
+func shiftedOf(code, alt rune) rune {
+	if s := unicode.ToUpper(code); s != code {
+		return s
+	}
+	return alt
+}
+
+// kittyTextSpecs draws a text-producing Kitty key from the given alternate-key, modifier
+// and explicit-text generators.
+func kittyTextSpecs(alternates hegel.Generator[pair[rune, rune]], bits hegel.Generator[int], text func(rune) hegel.Generator[string]) hegel.Generator[kittySpec] {
+	return hegel.Composite(func(tc hegel.TestCase) kittySpec {
+		code := hegel.Draw(tc, hegel.SampledFrom(kittyTextRunes))
+		alt := hegel.Draw(tc, alternates)
+		if alt.a != 0 {
+			alt.a = shiftedOf(code, alt.a)
+		}
+		return kittySpec{
+			code:       code,
+			alternates: alt,
+			bits:       hegel.Draw(tc, bits),
+			ev:         hegel.Draw(tc, eventTypes),
+			modsOne:    hegel.Draw(tc, chance(70)),
+			text:       hegel.Draw(tc, text(code)),
+		}
+	})
+}
+
+// explicitText is the key's own text, sometimes with a second rune, or none.
+func explicitText(code rune) hegel.Generator[string] {
+	return maybe(30, hegel.Map(maybe(30, hegel.SampledFrom(kittyTextTails)), func(tail string) string { return string(code) + tail }))
+}
+
+func noText(rune) hegel.Generator[string] { return hegel.Just("") }
+
+var (
+	// Alternate keys: none, a shifted key, or a shifted key and a base key (x-input/1).
+	kittyAlternates = maybe(40, pairs(hegel.SampledFrom(kittyShiftAlts), maybe(50, shaped(hegel.SampledFrom(kittyBases), hegel.Just(rune(0))))))
+	// Text keys draw every modifier bit; under HEGEL_NO_KNOWN=1 num lock is left out of them
+	// (x-input/3).
+	kittyTextBits       = modifiers(shaped(kittyBits, without(kittyBits, kittyNumLock)), 3)
+	kittyFunctionalBits = modifiers(kittyBits, 3)
+
+	kittyTextKeys = hegel.Map(kittyTextSpecs(kittyAlternates, kittyTextBits, explicitText), kittyKey)
+
+	kittyFunctionalKeys = hegel.Map(hegel.Composite(func(tc hegel.TestCase) kittySpec {
+		return kittySpec{
+			code:       rune(hegel.Draw(tc, weighted(choice[int]{1, hegel.SampledFrom(kittyC0)}, choice[int]{3, hegel.SampledFrom(kittyFunctional)}))),
+			functional: true,
+			bits:       hegel.Draw(tc, kittyFunctionalBits),
+			ev:         hegel.Draw(tc, eventTypes),
+			modsOne:    hegel.Draw(tc, chance(70)),
+		}
+	}), kittyKey)
+
+	kittyKeys = weighted(choice[encoded]{2, kittyTextKeys}, choice[encoded]{1, kittyFunctionalKeys})
+)
+
+// ---------------------------------------------------------------- modifyOtherKeys
+
+var (
+	mokSpecials = map[int]rune{8: KeyBackspace, 9: KeyTab, 13: KeyEnter, 27: KeyEscape, 127: KeyBackspace}
+	mokRunes    = []rune{'a', 'A', 'z', '1', ' ', ';', '/', 'é', '世', '☃', '😃'}
+	mokCodes    = weighted(
+		choice[int]{4, hegel.Map(hegel.SampledFrom(mokRunes), func(r rune) int { return int(r) })},
+		choice[int]{1, hegel.SampledFrom(sortedKeys(mokSpecials))},
+	)
+)
+
+// mokKey encodes xterm's CSI 27 ; mod ; code ~.
+func mokKey(p pair[int, int]) encoded {
+	mod, code := KeyMod(p.a), p.b
+	k := KeyPressEvent{Code: rune(code), Mod: mod}
+	if special, ok := mokSpecials[code]; ok {
+		k.Code = special
+	} else if mod <= ModShift {
+		k.Text = string(rune(code))
+	}
+	return one("modify-other-keys", "\x1b[27;"+strconv.Itoa(p.a+1)+";"+strconv.Itoa(code)+"~", k)
+}
+
+var mokKeys = hegel.Map(pairs(xtermMods, mokCodes), mokKey)
+
+// ---------------------------------------------------------------- mouse
+
+type mouseSpec struct {
+	btn              MouseButton
+	motion           bool
+	shift, alt, ctrl bool
+	sgr              bool
+	release          bool
+	x, y             int
+}
+
+var mouseButtons = []MouseButton{MouseNone, MouseLeft, MouseMiddle, MouseRight, MouseWheelUp, MouseWheelDown, MouseWheelLeft, MouseWheelRight, MouseBackward, MouseForward, MouseButton10, MouseButton11}
+
+// mouseEvent encodes a mouse event with x/ansi's encoders, in SGR or X10 form.
+func mouseEvent(s mouseSpec) encoded {
+	var mod KeyMod
+	if s.shift {
+		mod |= ModShift
+	}
+	if s.alt {
+		mod |= ModAlt
+	}
+	if s.ctrl {
+		mod |= ModCtrl
+	}
+	b := ansi.EncodeMouseButton(s.btn, s.motion, s.shift, s.alt, s.ctrl)
+	wheel := s.btn >= MouseWheelUp && s.btn <= MouseWheelRight
+	x, y := s.x, s.y
+	if !s.sgr {
+		x, y = x%223, y%223 // X10 coordinates are one byte
+	}
+	release := s.sgr && s.release && s.btn != MouseNone && !wheel && !s.motion
+	m := Mouse{X: x, Y: y, Button: s.btn, Mod: mod}
+	var ev Event
+	switch {
+	case wheel:
+		ev = MouseWheelEvent(m)
+	case s.motion:
+		ev = MouseMotionEvent(m)
+	case release || s.btn == MouseNone:
+		ev = MouseReleaseEvent(m)
+	default:
+		ev = MouseClickEvent(m)
+	}
+	if s.sgr {
+		return one("mouse-sgr", ansi.MouseSgr(b, x, y, release || (s.btn == MouseNone && !s.motion)), ev)
+	}
+	return one("mouse-x10", "\x1b[M"+string([]byte{b + 32, byte(x + 33), byte(y + 33)}), ev)
+}
+
+var mice = hegel.Map(hegel.Composite(func(tc hegel.TestCase) mouseSpec {
+	return mouseSpec{
+		btn:     hegel.Draw(tc, hegel.SampledFrom(mouseButtons)),
+		motion:  hegel.Draw(tc, chance(30)),
+		shift:   hegel.Draw(tc, chance(30)),
+		alt:     hegel.Draw(tc, chance(30)),
+		ctrl:    hegel.Draw(tc, chance(30)),
+		sgr:     hegel.Draw(tc, chance(60)),
+		release: hegel.Draw(tc, chance(40)),
+		x:       hegel.Draw(tc, hegel.Integers(0, 5000)),
+		y:       hegel.Draw(tc, hegel.Integers(0, 5000)),
+	}
+}), mouseEvent)
+
+// ---------------------------------------------------------------- reports
+
+var (
+	terminators = hegel.SampledFrom([]string{"\x1b\\", "\a"})
+	channels    = hegel.Integers(0, 255)
+)
+
+// cursorReport is CSI line ; col R (a modified F3 too when the line is 1 and the column is a
+// modifier value: the parser reports both, by design) or DECXCPR CSI ? line ; col R.
+func cursorReport(p pair[pair[int, int], bool]) encoded {
+	line, col := p.a.a, p.a.b
+	cpr := CursorPositionEvent{X: col - 1, Y: line - 1}
+	if p.b {
+		return one("decxcpr", "\x1b[?"+strconv.Itoa(line)+";"+strconv.Itoa(col)+"R", cpr)
+	}
+	if line == 1 && col-1 <= int(ModMeta|ModShift|ModAlt|ModCtrl) {
+		return encoded{"cpr-f3", ansi.CursorPositionReport(line, col), []Event{KeyPressEvent{Code: KeyF3, Mod: KeyMod(col - 1)}, cpr}, ""}
+	}
+	return one("cpr", ansi.CursorPositionReport(line, col), cpr)
+}
+
+func modeReport(p pair[pair[bool, int], int]) encoded {
+	var mode ansi.Mode = ansi.ANSIMode(p.a.b%200 + 1)
+	if p.a.a {
+		mode = ansi.DECMode(p.a.b + 1)
+	}
+	v := ansi.ModeSetting(p.b)
+	return one("decrpm", ansi.ReportMode(mode, v), ModeReportEvent{Mode: mode, Value: v})
+}
+
+func deviceAttributes(attrs []int) encoded {
+	return one("da1", ansi.PrimaryDeviceAttributes(attrs...), PrimaryDeviceAttributesEvent(attrs))
+}
+
+func windowOp(p pair[int, []int]) encoded {
+	return one("winop", ansi.WindowOp(p.a, p.b...), WindowOpEvent{Op: p.a, Args: p.b})
+}
+
+func kittyFlags(f int) encoded {
+	return one("kitty-flags", "\x1b[?"+strconv.Itoa(f)+"u", KittyEnhancementsEvent(f))
+}
+
+func mokState(v int) encoded {
+	return one("mok-state", "\x1b[>4;"+strconv.Itoa(v)+"m", ModifyOtherKeysEvent(v))
+}
+
+// colourSpec is an OSC 10/11/12 colour reply: 8-bit channels, or 16-bit X11 channels of
+// which the reply keeps the high byte (a zero high byte keeps "00xx" whole in XParseColor).
+type colourSpec struct {
+	osc        int
+	r, g, b    int
+	lo         []int // low bytes of 16-bit channels; nil for 8-bit channels
+	terminator string
+}
+
+func colourReport(s colourSpec) encoded {
+	spec := fmt.Sprintf("rgb:%02x/%02x/%02x", s.r, s.g, s.b)
+	if s.lo != nil {
+		low := func(hi, lo int) int {
+			if hi == 0 {
+				return 0
+			}
+			return lo
+		}
+		spec = fmt.Sprintf("rgb:%02x%02x/%02x%02x/%02x%02x", s.r, low(s.r, s.lo[0]), s.g, low(s.g, s.lo[1]), s.b, low(s.b, s.lo[2]))
+	}
+	c := color.RGBA{uint8(s.r), uint8(s.g), uint8(s.b), 0xff}
+	seq := "\x1b]" + strconv.Itoa(s.osc) + ";" + spec + s.terminator
+	switch s.osc {
+	case 10:
+		return one("osc-fg", seq, ForegroundColorEvent{c})
+	case 11:
+		return one("osc-bg", seq, BackgroundColorEvent{c})
+	}
+	return one("osc-cursor", seq, CursorColorEvent{c})
+}
+
+func clipboard(p pair[byte, []byte]) encoded {
+	return one("osc52", ansi.SetClipboard(p.a, string(p.b)), ClipboardEvent{Content: string(p.b), Selection: p.a})
+}
+
+func capabilities(caps []pair[string, string]) encoded {
+	var enc, want []string
+	for _, c := range caps {
+		enc = append(enc, hex.EncodeToString([]byte(c.a))+"="+hex.EncodeToString([]byte(c.b)))
+		want = append(want, c.a+"="+c.b)
+	}
+	return one("xtgettcap", "\x1bP1+r"+strings.Join(enc, ";")+"\x1b\\", CapabilityEvent(strings.Join(want, ";")))
+}
+
+func version(v string) encoded {
+	return one("xtversion", "\x1bP>|"+v+"\x1b\\", TerminalVersionEvent(v))
+}
+
+var (
+	cursorReports = hegel.Map(pairs(pairs(hegel.Integers(1, 500), hegel.Integers(1, 500)), chance(30)), cursorReport)
+	modeReports   = hegel.Map(pairs(pairs(chance(60), hegel.Integers(0, 2999)), hegel.Integers(0, 4)), modeReport)
+	da1s          = hegel.Map(many(hegel.Integers(1, 99), 1, 6), deviceAttributes)
+	winops        = hegel.Map(pairs(hegel.Integers(1, 30), many(hegel.Integers(0, 4000), 0, 3)), windowOp)
+	focusBlur     = hegel.SampledFrom([]encoded{one("focus", "\x1b[I", FocusEvent{}), one("blur", "\x1b[O", BlurEvent{})})
+	kittyFlagss   = hegel.Map(hegel.Integers(0, 31), kittyFlags)
+	mokStates     = hegel.Map(hegel.Integers(0, 2), mokState)
+	colours       = hegel.Map(hegel.Composite(func(tc hegel.TestCase) colourSpec {
+		return colourSpec{
+			osc:        hegel.Draw(tc, hegel.Integers(10, 12)),
+			r:          hegel.Draw(tc, channels),
+			g:          hegel.Draw(tc, channels),
+			b:          hegel.Draw(tc, channels),
+			lo:         hegel.Draw(tc, maybe(60, hegel.Lists(channels).MinSize(3).MaxSize(3))),
+			terminator: hegel.Draw(tc, terminators),
+		}
+	}), colourReport)
+	clipboards   = hegel.Map(pairs(hegel.SampledFrom([]byte{'c', 'p', 's', '0', '7'}), hegel.Binary(0, 12)), clipboard)
+	capReplies   = hegel.Map(many(pairs(hegel.SampledFrom([]string{"Tc", "RGB", "colors", "kbs", "smulx", "Su"}), hegel.SampledFrom([]string{"1", "256", "\x7f", "\x1b[4:%p1%dm", "x"})), 1, 3), capabilities)
+	versions     = hegel.Map(hegel.SampledFrom([]string{"XTerm(388)", "kitty(0.36.4)", "WezTerm 20240203-110809-5046fc22", "foot(1.18.1)", "1.2.3"}), version)
+	pasteMarkers = hegel.SampledFrom([]encoded{one("paste-start", "\x1b[200~", PasteStartEvent{}), one("paste-end", "\x1b[201~", PasteEndEvent{})})
+)
+
+// reportsOf draws one of the terminal's replies: CPR/DECXCPR, DECRPM, DA1, XTWINOPS,
+// focus/blur, Kitty flags, modifyOtherKeys state, OSC colours, OSC 52, XTGETTCAP,
+// XTVERSION and, when asked, bracketed paste markers (which change how a stream is read).
+func reportsOf(withPaste bool) hegel.Generator[encoded] {
+	choices := []choice[encoded]{
+		{2, focusBlur},
+		{2, cursorReports},
+		{2, modeReports},
+		{2, da1s},
+		{2, winops},
+		{1, kittyFlagss},
+		{1, mokStates},
+		{4, colours},
+		{2, clipboards},
+		{2, capReplies},
+		{2, versions},
+	}
+	if withPaste {
+		choices = append(choices, choice[encoded]{2, pasteMarkers})
+	}
+	return weighted(choices...)
+}
+
+// ---------------------------------------------------------------- event mixes
+
+// pools are the sub-generators that differ between an event that ends the input and one
+// that more bytes follow: a lone ESC, ESC + an introducer byte and CSI id $ are only
+// unambiguous at the end.
+type pools struct {
+	controls, altRunes, urxvt hegel.Generator[encoded]
+}
+
+var (
+	lastPools  = pools{controlKeys, altRuneKeys, urxvts}
+	innerPools = pools{tameControls, runeKeys, tameUrxvts}
+)
+
+// eventsOf draws any event.
+func eventsOf(p pools, withPaste bool) hegel.Generator[encoded] {
+	return weighted(
+		choice[encoded]{2, textKeysOf(p.controls)},
+		choice[encoded]{1, altKeysOf(p.altRunes, p.controls)},
+		choice[encoded]{2, functionKeysOf(p.urxvt)},
+		choice[encoded]{2, kittyKeys},
+		choice[encoded]{1, mokKeys},
+		choice[encoded]{1, mice},
+		choice[encoded]{1, reportsOf(withPaste)},
+	)
+}
+
+var (
+	// Any event on its own.
+	decodeEvents = eventsOf(lastPools, true)
+	// Events that more bytes follow (no paste markers either, which change how a stream is
+	// read) and events that end a stream.
+	streamEvents = eventsOf(innerPools, false)
+	lastEvents   = eventsOf(lastPools, false)
+	streams      = pairs(many(streamEvents, 0, 5), lastEvents)
+)
+
+// ---------------------------------------------------------------- key tables
+
+var dumbTable = buildKeysTable(0, "dumb")
+
+var flagBits = []int{FlagCtrlAt, FlagCtrlI, FlagCtrlM, FlagCtrlOpenBracket, FlagBackspace, FlagFind, FlagSelect, FlagFKeys}
+
+var terminfoTerms = func() []string {
+	var out []string
+	for _, term := range []string{"xterm", "xterm-256color", "screen", "screen-256color", "tmux", "tmux-256color", "linux", "vt100", "vt220", "rxvt", "rxvt-unicode", "rxvt-unicode-256color", "putty", "konsole", "alacritty", "kitty", "foot", "wezterm", "st-256color", "dumb"} {
+		if ti, err := terminfo.Load(term); err == nil && ti != nil {
+			out = append(out, term)
+		}
+	}
+	return out
+}()
+
+// tableSetup is a Reader configuration: parser flags and $TERM.
+type tableSetup struct {
+	flags int
+	term  string
+}
+
+func (s tableSetup) GoString() string { return fmt.Sprintf("term %s flags %#b", s.term, s.flags) }
+
+// tableEntry is one sequence of a setup's key table with the key it stands for, and the
+// recorded bug whose shape it has: a lone ESC under FlagCtrlOpenBracket (x-input/9) or a
+// sequence that came from terminfo (x-input/10).
+type tableEntry struct {
+	tableSetup
+	seq   string
+	key   Key
+	shape string
+}
+
+func (e tableEntry) GoString() string {
+	s := fmt.Sprintf("%#v: %q is %s", e.tableSetup, e.seq, eventString(KeyPressEvent(e.key)))
+	if e.shape != "" {
+		s += " [" + e.shape + "]"
+	}
+	return s
+}
+
+type tableInfo struct {
+	table    map[string]Key
+	terminfo map[string]Key
+	entries  []tableEntry // the property's pool (without the shapes under HEGEL_NO_KNOWN=1)
+	fromTi   []tableEntry // terminfo entries the parser reads otherwise than the table says (or, under HEGEL_NO_KNOWN=1, the rest)
+}
+
+var (
+	tablesMu sync.Mutex
+	tables   = map[tableSetup]*tableInfo{}
+)
+
+func tableOf(s tableSetup) *tableInfo {
+	tablesMu.Lock()
+	defer tablesMu.Unlock()
+	if info, ok := tables[s]; ok {
+		return info
+	}
+	info := &tableInfo{table: buildKeysTable(s.flags, s.term), terminfo: map[string]Key{}}
+	if s.flags&FlagTerminfo != 0 {
+		info.terminfo = buildTerminfoKeys(s.flags, s.term)
+	}
+	seqs := make([]string, 0, len(info.table))
+	for seq := range info.table {
+		seqs = append(seqs, seq)
+	}
+	sort.Strings(seqs)
+	for _, seq := range seqs {
+		_, fromTi := info.terminfo[seq]
+		shape := ""
+		switch {
+		case s.flags&FlagCtrlOpenBracket != 0 && strings.Trim(seq, "\x1b") == "":
+			shape = "x-input/9"
+		case fromTi:
+			shape = "x-input/10"
+		}
+		if shape == "" || !noKnown {
+			info.entries = append(info.entries, tableEntry{s, seq, info.table[seq], shape})
+		}
+	}
+	seqs = seqs[:0]
+	for seq := range info.terminfo {
+		seqs = append(seqs, seq)
+	}
+	sort.Strings(seqs)
+	for _, seq := range seqs {
+		e := tableEntry{s, seq, info.terminfo[seq], ""}
+		p := Parser{flags: s.flags}
+		otherKey := !reflect.DeepEqual(readerParse(&p, info.table, []byte(seq)), tableWant(e))
+		if otherKey != noKnown {
+			e.shape = shapeIf(otherKey, "x-input/10")
+			info.fromTi = append(info.fromTi, e)
+		}
+	}
+	return info
+}
+
+// tableWant is what the parser should give for a table entry: its key, and for CSI 1;mod R
+// the cursor position report it also is (the parser reports both, by design).
+func tableWant(e tableEntry) []Event {
+	want := []Event{KeyPressEvent(e.key)}
+	if strings.HasPrefix(e.seq, "\x1b[1;") && strings.HasSuffix(e.seq, "R") {
+		want = append(want, CursorPositionEvent{Y: 0, X: int(e.key.Mod)})
+	}
+	return want
+}
+
+var tableSetups = hegel.Composite(func(tc hegel.TestCase) tableSetup {
+	return tableSetup{
+		flags: hegel.Draw(tc, modifiers(flagBits, 4)) | hegel.Draw(tc, maybe(70, hegel.Just(FlagTerminfo))),
+		term:  hegel.Draw(tc, hegel.SampledFrom(terminfoTerms)),
+	}
+})
+
+var tableEntries = hegel.FlatMap(tableSetups, func(s tableSetup) hegel.Generator[tableEntry] {
+	return hegel.SampledFrom(tableOf(s).entries)
+})
+
+// keyedTerms are the terms whose terminfo entry has key sequences (dumb has none).
+var keyedTerms = func() []string {
+	var out []string
+	for _, term := range terminfoTerms {
+		if len(buildTerminfoKeys(FlagTerminfo, term)) > 0 {
+			out = append(out, term)
+		}
+	}
+	return out
+}()
+
+// terminfoSetups: the terminfo sequences the parser reads as another key mostly need
+// FlagBackspace or FlagFKeys (DEL, F13-F63), so those are on in the shape region.
+var terminfoSetups = hegel.Composite(func(tc hegel.TestCase) tableSetup {
+	return tableSetup{
+		flags: FlagTerminfo | shaped(FlagBackspace|FlagFKeys, 0) | hegel.Draw(tc, modifiers(flagBits, 4)),
+		term:  hegel.Draw(tc, hegel.SampledFrom(keyedTerms)),
+	}
+})
+
+// terminfoEntries draws a terminfo key of a setup; the zero entry stands for a setup without
+// any in the pool (the property assumes it away).
+var terminfoEntries = hegel.FlatMap(terminfoSetups, func(s tableSetup) hegel.Generator[tableEntry] {
+	pool := tableOf(s).fromTi
+	if len(pool) == 0 {
+		return hegel.Just(tableEntry{})
+	}
+	return hegel.SampledFrom(pool)
+})
+
+// ---------------------------------------------------------------- checks
+
+// parseAll runs the parser over the whole buffer, as the Reader does, flattening MultiEvents.
+func parseAll(p *Parser, buf []byte) []Event {
+	return readerParse(p, nil, buf)
+}
+
+// readerParse is the Reader's loop: the parser over the buffer, an unknown sequence looked
+// up in the key table.
+func readerParse(p *Parser, table map[string]Key, buf []byte) []Event {
+	var events []Event
+	for len(buf) > 0 {
+		w, ev := p.parseSequence(buf)
+		if w == 0 {
+			w = 1
+		}
+		if _, unknown := ev.(UnknownEvent); unknown {
+			if k, ok := table[string(buf[:w])]; ok {
+				ev = KeyPressEvent(k)
+			}
+		}
+		if ev != nil {
+			events = append(events, ev)
+		}
+		buf = buf[w:]
+	}
+	return flatten(events)
+}
+
+// readAll reads one buffer through a Reader.
+func readAll(ht *hegel.T, input, term string, flags int) []Event {
+	rd, err := NewReader(strings.NewReader(input), term, flags)
+	if err != nil {
+		fail(ht, "NewReader: %v", err)
+	}
+	evs, err := rd.ReadEvents()
+	if err != nil {
+		fail(ht, "ReadEvents: %v", err)
+	}
+	return flatten(evs)
+}
+
+// checkDecode: the sequence decodes to its events, consuming exactly its bytes and leaving
+// them untouched, and every key press has a name.
+func checkDecode(ht *hegel.T, e encoded) {
+	var p Parser
+	buf := []byte(e.seq)
+	orig := append([]byte(nil), buf...)
+	w, ev := p.parseSequence(buf)
+	if !bytes.Equal(buf, orig) {
+		mismatch(ht, e.shape, "%s: parseSequence modified its input: %q -> %q", e.kind, orig, buf)
+	}
+	if w != len(buf) {
+		mismatch(ht, e.shape, "%s: parseSequence(%q) consumed %d of %d bytes (event %s)", e.kind, e.seq, w, len(buf), eventString(ev))
+	}
+	got := flatten([]Event{ev})
+	want := flatten(e.want)
+	if !reflect.DeepEqual(got, want) {
+		mismatch(ht, e.shape, "%s: parseSequence(%q):\n  got\n    %s\n  want\n    %s", e.kind, e.seq, eventsString(got), eventsString(want))
+	}
+	for _, ev := range got {
+		if k, ok := ev.(KeyPressEvent); ok && k.String() == "" {
+			mismatch(ht, e.shape, "%s: %s has an empty String()", e.kind, eventString(k))
+		}
+	}
+	count(e.kind)
+}
+
+// ---------------------------------------------------------------- properties
+
+// TestHegelSequencesDecodeToTheirEvents: every encoded event decodes to itself, consuming exactly
+// its bytes and leaving them untouched.
+func TestHegelSequencesDecodeToTheirEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkDecode(ht, hegel.Draw(ht, decodeEvents))
+	})
+}
+
+// TestHegelStreamsSplitIntoTheirEvents: a stream of encoded events, back to back in one read,
+// splits into exactly those events (through parseSequence and through the Reader).
+func TestHegelStreamsSplitIntoTheirEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, streams)
+		events := append(s.a, s.b)
+		var seq strings.Builder
+		var want []Event
+		shape := ""
+		for _, e := range events {
+			seq.WriteString(e.seq)
+			want = append(want, e.want...)
+			if shape == "" {
+				shape = e.shape
+			}
+		}
+		want = flatten(want)
+		var p Parser
+		got := parseAll(&p, []byte(seq.String()))
+		if !reflect.DeepEqual(got, want) {
+			mismatch(ht, shape, "stream %q:\n  got\n    %s\n  want\n    %s", seq.String(), eventsString(got), eventsString(want))
+		}
+		if _, inTable := dumbTable[seq.String()]; inTable && len(want) > 1 {
+			// CSI 1;mod R alone: the Reader's whole-buffer table lookup gives the modified F3
+			// only, the parser both F3 and the cursor report (the documented ambiguity).
+			count("reader-f3-ambiguity")
+			return
+		}
+		ht.Assume(seq.Len() < 250) // the Reader reads 256 bytes at a time
+		if got := readAll(ht, seq.String(), "dumb", 0); !reflect.DeepEqual(got, want) {
+			mismatch(ht, shape, "Reader on %q:\n  got\n    %s\n  want\n    %s", seq.String(), eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
