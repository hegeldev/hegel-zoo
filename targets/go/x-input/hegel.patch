+var agreeRunes = []rune{'a', 'z', 'A', '1', ';', '/', '[', ' ', 'é', 'ø', '世', '☃', '😃'}
+
+// TestHegelKittyAndModifyOtherKeysAgree: the same key reported through CSI u and through
+// xterm's CSI 27;mod;code~ is the same event (for shift/alt/ctrl, which both protocols share).
+func TestHegelKittyAndModifyOtherKeysAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pairs(hegel.SampledFrom(agreeRunes), hegel.Integers(0, 7)))
+		r, m := c.a, c.b
+		kitty := fmt.Sprintf("\x1b[%d;%du", r, m+1)
+		mok := fmt.Sprintf("\x1b[27;%d;%d~", m+1, r)
+		var p Parser
+		_, ke := p.parseSequence([]byte(kitty))
+		_, me := p.parseSequence([]byte(mok))
+		kk, ok1 := ke.(KeyPressEvent)
+		mk, ok2 := me.(KeyPressEvent)
+		if !ok1 || !ok2 {
+			fail(ht, "%q / %q: not key presses: %s / %s", kitty, mok, eventString(ke), eventString(me))
+		}
+		if kk.Code != mk.Code || kk.Mod != mk.Mod {
+			fail(ht, "%q / %q: code/mod differ: kitty %s, modifyOtherKeys %s", kitty, mok, eventString(kk), eventString(mk))
+		}
+		if m&1 == 0 && kk.Text != mk.Text {
+			fail(ht, "%q / %q: text differs: kitty %s, modifyOtherKeys %s", kitty, mok, eventString(kk), eventString(mk))
+		}
+		count("ok")
+	})
+}
