+package input
+
+// Hegel property tests for charmbracelet/x/input (hegel-zoo target go/x-input).
+//
+// The parser turns terminal input bytes into events. The oracles are the protocols the bytes
+// come from: x/ansi's own encoders (mouse, cursor/mode reports, window ops, clipboard) and
+// hand-written encoders for the Kitty keyboard protocol, xterm's modifyOtherKeys and
+// PC-style function keys, SS3 keypad keys, URxvt keys, OSC colour replies, XTGETTCAP and
+// XTVERSION replies, bracketed paste and plain text. Every generator returns the bytes and
+// the events they mean; the parser must return exactly those events, consume exactly those
+// bytes, leave the buffer untouched, and split a stream of them back into the same list.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"image/color"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/rivo/uniseg"
+	"github.com/xo/terminfo"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("XINPUT_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("panic in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// guard marks a pin: it must fail (the bug is open) and it must not panic the suite.
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Errorf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- events
+
+// normalize makes events comparable with reflect.DeepEqual: colours become color.RGBA.
+func normalize(ev Event) Event {
+	toRGBA := func(c color.Color) color.Color {
+		if c == nil {
+			return nil
+		}
+		r, g, b, a := c.RGBA()
+		return color.RGBA{uint8(r >> 8), uint8(g >> 8), uint8(b >> 8), uint8(a >> 8)}
+	}
+	switch e := ev.(type) {
+	case ForegroundColorEvent:
+		return ForegroundColorEvent{toRGBA(e.Color)}
+	case BackgroundColorEvent:
+		return BackgroundColorEvent{toRGBA(e.Color)}
+	case CursorColorEvent:
+		return CursorColorEvent{toRGBA(e.Color)}
+	case MultiEvent:
+		out := make(MultiEvent, len(e))
+		for i, x := range e {
+			out[i] = normalize(x)
+		}
+		return out
+	}
+	return ev
+}
+
+func flatten(evs []Event) []Event {
+	var out []Event
+	for _, ev := range evs {
+		if m, ok := ev.(MultiEvent); ok {
+			out = append(out, flatten([]Event(m))...)
+		} else {
+			out = append(out, normalize(ev))
+		}
+	}
+	return out
+}
+
+func eventString(ev Event) string {
+	switch e := ev.(type) {
+	case KeyPressEvent:
+		return fmt.Sprintf("KeyPress{Code:%#x(%q) Text:%q Mod:%#b Shifted:%#x Base:%#x Repeat:%v}", e.Code, keyName(e.Code), e.Text, e.Mod, e.ShiftedCode, e.BaseCode, e.IsRepeat)
+	case KeyReleaseEvent:
+		return fmt.Sprintf("KeyRelease{Code:%#x(%q) Text:%q Mod:%#b Shifted:%#x Base:%#x Repeat:%v}", e.Code, keyName(e.Code), e.Text, e.Mod, e.ShiftedCode, e.BaseCode, e.IsRepeat)
+	}
+	return fmt.Sprintf("%T%+v", ev, ev)
+}
+
+func keyName(code rune) string {
+	if s, ok := keyTypeString[code]; ok {
+		return s
+	}
+	if code == KeyExtended {
+		return "extended"
+	}
+	return string(code)
+}
+
+func eventsString(evs []Event) string {
+	parts := make([]string, len(evs))
+	for i, ev := range evs {
+		parts[i] = eventString(ev)
+	}
+	return strings.Join(parts, "\n    ")
+}
+
+// ---------------------------------------------------------------- generators
+
+// encoded is a byte sequence and the events it stands for.
+type encoded struct {
+	kind string
+	seq  string
+	want []Event
+}
+
+var (
+	// Graphemes that are single runes and never combine with what follows.
+	singleRunes = []rune{'a', 'b', 'q', 'z', 'A', 'Q', 'Z', '0', '9', '!', '/', '?', '~', '#', '{', '}', '`', 'é', 'ñ', 'Ω', 'я', '世', '☃', '😃', 'Ａ'}
+	// Multi-rune grapheme clusters that start with a non-ASCII rune.
+	clusters = []string{"ก\u0e49", "👍🏽", "👨\u200d👩\u200d👧", "🇩🇪", "é\u0301"}
+	// Multi-rune clusters that start with an ASCII byte (x-input/…: split by the ASCII shortcut).
+	asciiClusters = []string{"e\u0301", "n\u0303", "1\ufe0f\u20e3", "a\u200d"}
+)
+
+func keyPress(code rune, text string, mod KeyMod) KeyPressEvent {
+	return KeyPressEvent{Code: code, Text: text, Mod: mod}
+}
+
+// genText draws a printable grapheme or a C0 control byte and its key event (flags 0).
+func genText(tc hegel.TestCase, allowEscape bool) encoded {
+	switch n(tc, 0, 9) {
+	case 0, 1, 2, 3, 4:
+		r := pick(tc, singleRunes)
+		k := keyPress(r, string(r), 0)
+		if r < utf8.RuneSelf && unicode.IsUpper(r) {
+			k = KeyPressEvent{Code: unicode.ToLower(r), ShiftedCode: r, Text: string(r), Mod: ModShift}
+		}
+		return encoded{"text", string(r), []Event{k}}
+	case 5:
+		c := pick(tc, clusters)
+		return encoded{"cluster", c, []Event{keyPress(KeyExtended, c, 0)}}
+	case 6:
+		return encoded{"space", " ", []Event{keyPress(KeySpace, " ", 0)}}
+	default:
+		b := byte(n(tc, 0, 31))
+		if chance(tc, 10) {
+			b = ansi.DEL
+		}
+		if b == ansi.ESC && !allowEscape {
+			b = ansi.SOH
+		}
+		return encoded{"control", string([]byte{b}), []Event{controlKey(b)}}
+	}
+}
+
+// controlKey is the VT100 meaning of a C0 byte with no flags set.
+func controlKey(b byte) KeyPressEvent {
+	switch b {
+	case ansi.NUL:
+		return keyPress(KeySpace, "", ModCtrl)
+	case ansi.BS:
+		return keyPress('h', "", ModCtrl)
+	case ansi.HT:
+		return keyPress(KeyTab, "", 0)
+	case ansi.CR:
+		return keyPress(KeyEnter, "", 0)
+	case ansi.ESC:
+		return keyPress(KeyEscape, "", 0)
+	case ansi.DEL:
+		return keyPress(KeyBackspace, "", 0)
+	}
+	if b <= ansi.SUB {
+		return keyPress(rune(b+0x60), "", ModCtrl)
+	}
+	return keyPress(rune(b+0x40), "", ModCtrl) // FS GS RS US → ctrl+\ ] ^ _
+}
+
+// genAlt prefixes a key with ESC: the same key with alt and no text.
+func genAlt(tc hegel.TestCase, allowEscape bool) encoded {
+	inner := genText(tc, allowEscape) // ESC ESC followed by more bytes is ambiguous: alt+esc or ESC + alt+key
+	k := inner.want[0].(KeyPressEvent)
+	k.Mod |= ModAlt
+	k.Text = ""
+	first, _ := utf8.DecodeRuneInString(inner.seq)
+	if strings.ContainsRune("[O]P_^X", first) {
+		// The introducer bytes take shortcuts of their own (x-input pin).
+		count("alt-introducer-skipped")
+		return genText(tc, false)
+	}
+	return encoded{"alt+" + inner.kind, "\x1b" + inner.seq, []Event{k}}
+}
+
+var (
+	csiFuncKeys = map[byte]rune{'A': KeyUp, 'B': KeyDown, 'C': KeyRight, 'D': KeyLeft, 'E': KeyBegin, 'F': KeyEnd, 'H': KeyHome, 'P': KeyF1, 'Q': KeyF2, 'R': KeyF3, 'S': KeyF4}
+	ss3Keys     = map[byte]rune{'A': KeyUp, 'B': KeyDown, 'C': KeyRight, 'D': KeyLeft, 'E': KeyBegin, 'F': KeyEnd, 'H': KeyHome, 'P': KeyF1, 'Q': KeyF2, 'R': KeyF3, 'S': KeyF4,
+		'M': KeyKpEnter, 'X': KeyKpEqual, 'j': KeyKpMultiply, 'k': KeyKpPlus, 'l': KeyKpComma, 'm': KeyKpMinus, 'n': KeyKpDecimal, 'o': KeyKpDivide,
+		'p': KeyKp0, 'q': KeyKp1, 'r': KeyKp2, 's': KeyKp3, 't': KeyKp4, 'u': KeyKp5, 'v': KeyKp6, 'w': KeyKp7, 'x': KeyKp8, 'y': KeyKp9}
+	tildeKeys = map[int]rune{1: KeyHome, 2: KeyInsert, 3: KeyDelete, 4: KeyEnd, 5: KeyPgUp, 6: KeyPgDown, 7: KeyHome, 8: KeyEnd,
+		11: KeyF1, 12: KeyF2, 13: KeyF3, 14: KeyF4, 15: KeyF5, 17: KeyF6, 18: KeyF7, 19: KeyF8, 20: KeyF9, 21: KeyF10,
+		23: KeyF11, 24: KeyF12, 25: KeyF13, 26: KeyF14, 28: KeyF15, 29: KeyF16, 31: KeyF17, 32: KeyF18, 33: KeyF19, 34: KeyF20}
+)
+
+func sortedKeys[K int | byte, V any](m map[K]V) []K {
+	ks := make([]K, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Slice(ks, func(i, j int) bool { return ks[i] < ks[j] })
+	return ks
+}
+
+// xtermMod draws a PC-style modifier value (1 = none) and its KeyMod.
+func xtermMod(tc hegel.TestCase) (int, KeyMod) {
+	m := n(tc, 0, 15) // shift 1, alt 2, ctrl 4, meta 8
+	return m + 1, KeyMod(m)
+}
+
+// eventSuffix draws a Kitty event-type sub-parameter and applies it to the key.
+func eventSuffix(tc hegel.TestCase, k KeyPressEvent) (string, Event) {
+	switch n(tc, 0, 3) {
+	case 0:
+		return "", k
+	case 1:
+		return ":1", k
+	case 2:
+		k.IsRepeat = true
+		return ":2", k
+	default:
+		return ":3", KeyReleaseEvent(k)
+	}
+}
+
+// genFunctionKey encodes a PC-style function key: CSI 1;mod[:event] F, CSI n;mod[:event] ~,
+// SS3 mod F, or the URxvt forms CSI n ^ / CSI n @ / CSI n $.
+func genFunctionKey(tc hegel.TestCase) encoded {
+	switch n(tc, 0, 5) {
+	case 0, 1:
+		f := pick(tc, sortedKeys(csiFuncKeys))
+		k := keyPress(csiFuncKeys[f], "", 0)
+		switch n(tc, 0, 3) {
+		case 0:
+			return encoded{"csi-func", "\x1b[" + string(f), []Event{k}}
+		case 1:
+			if f == 'R' {
+				return encoded{"csi-func", "\x1b[" + string(f), []Event{k}}
+			}
+			return encoded{"csi-func", "\x1b[1" + string(f), []Event{k}}
+		default:
+			m, mod := xtermMod(tc)
+			k.Mod = mod
+			suffix, ev := eventSuffix(tc, k)
+			if f == 'R' {
+				// CSI 1;mod R is also a cursor position report on row 1; the parser reports
+				// both, by design. Kitty-style event types on F3 use CSI 13;mod:ev ~ instead.
+				return encoded{"csi-func-mod", "\x1b[1;" + strconv.Itoa(m) + "R", []Event{k, CursorPositionEvent{Y: 0, X: m - 1}}}
+			}
+			return encoded{"csi-func-mod", "\x1b[1;" + strconv.Itoa(m) + suffix + string(f), []Event{ev}}
+		}
+	case 2, 3:
+		id := pick(tc, sortedKeys(tildeKeys))
+		k := keyPress(tildeKeys[id], "", 0)
+		if chance(tc, 30) {
+			return encoded{"csi-tilde", "\x1b[" + strconv.Itoa(id) + "~", []Event{k}}
+		}
+		m, mod := xtermMod(tc)
+		k.Mod = mod
+		suffix, ev := eventSuffix(tc, k)
+		kind := "csi-tilde-mod"
+		if suffix != "" && suffix != ":1" && id != 1 {
+			kind = "csi-tilde-event" // x-input pin: the event type is ignored for these keys
+		}
+		return encoded{kind, "\x1b[" + strconv.Itoa(id) + ";" + strconv.Itoa(m) + suffix + "~", []Event{ev}}
+	case 4:
+		f := pick(tc, sortedKeys(ss3Keys))
+		k := keyPress(ss3Keys[f], "", 0)
+		if chance(tc, 40) {
+			return encoded{"ss3", "\x1bO" + string(f), []Event{k}}
+		}
+		m, mod := xtermMod(tc)
+		k.Mod = mod
+		return encoded{"ss3-mod", "\x1bO" + strconv.Itoa(m) + string(f), []Event{k}}
+	default:
+		id := pick(tc, sortedKeys(tildeKeys))
+		k := keyPress(tildeKeys[id], "", 0)
+		switch n(tc, 0, 2) {
+		case 0:
+			k.Mod = ModCtrl
+			return encoded{"urxvt", "\x1b[" + strconv.Itoa(id) + "^", []Event{k}}
+		case 1:
+			k.Mod = ModCtrl | ModShift
+			return encoded{"urxvt", "\x1b[" + strconv.Itoa(id) + "@", []Event{k}}
+		default:
+			k.Mod = ModShift
+			return encoded{"urxvt-dollar", "\x1b[" + strconv.Itoa(id) + "$", []Event{k}}
+		}
+	}
+}
+
+// Kitty functional key codes (a sample) and the C0 specials the protocol keeps.
+var kittyFunctional = []int{57344, 57345, 57346, 57347, 57348, 57349, 57350, 57353, 57358, 57361, 57364, 57375, 57398, 57399, 57408, 57414, 57427, 57428, 57440, 57441, 57452, 57454}
+
+// kittyModBits draws a Kitty modifier bit set (0 = none).
+func kittyModBits(tc hegel.TestCase, locks bool) int {
+	m := 0
+	for bit := 1; bit <= 32; bit <<= 1 {
+		if chance(tc, 20) {
+			m |= bit
+		}
+	}
+	if locks {
+		if chance(tc, 30) {
+			m |= 64 // caps lock
+		}
+		if chance(tc, 30) {
+			m |= 128 // num lock
+		}
+	}
+	return m
+}
+
+// kittyText is the text a program should derive for a text-producing key without an
+// explicit text field: nothing under alt/ctrl/super/hyper/meta, the shifted key under shift
+// or caps lock, the key itself otherwise. Lock modifiers alone do not remove the text.
+func kittyText(code, shifted rune, mod KeyMod) string {
+	if !unicode.IsPrint(code) {
+		return ""
+	}
+	if mod&^(ModShift|ModCapsLock|ModNumLock) != 0 {
+		return ""
+	}
+	if mod&(ModShift|ModCapsLock) == 0 {
+		return string(code)
+	}
+	if shifted != 0 {
+		return string(shifted)
+	}
+	return string(unicode.ToUpper(code))
+}
+
+// genKittyKey encodes a Kitty keyboard protocol key: CSI code[:shifted[:base]] ; mod[:event] ; text u.
+func genKittyKey(tc hegel.TestCase) encoded {
+	var code rune
+	var key KeyPressEvent
+	functional := false
+	switch n(tc, 0, 5) {
+	case 0:
+		c := pick(tc, kittyFunctional)
+		code = rune(c)
+		key = KeyPressEvent(kittyKeyMap[c])
+		functional = true
+	case 1:
+		c := pick(tc, []int{9, 13, 27, 127})
+		code = rune(c)
+		key = KeyPressEvent(kittyKeyMap[c])
+		functional = true
+	default:
+		code = pick(tc, []rune{'a', 'b', 'z', 'q', '1', '9', ';', '/', '[', '=', 'é', 'ø', 'я', '世', '☃'})
+		key = KeyPressEvent{Code: code}
+	}
+	codes := strconv.Itoa(int(code))
+	var shifted, base rune
+	if !functional && chance(tc, 40) {
+		shifted = unicode.ToUpper(code)
+		if shifted == code {
+			shifted = pick(tc, []rune{'!', '@', '?', ':', '{', '+'})
+		}
+		codes += ":" + strconv.Itoa(int(shifted))
+		key.ShiftedCode = shifted
+		if chance(tc, 50) {
+			base = pick(tc, []rune{'a', 'q', 'z', '1', ';'})
+			codes += ":" + strconv.Itoa(int(base))
+			key.BaseCode = base
+		}
+	}
+	bits := kittyModBits(tc, chance(tc, 50))
+	key.Mod = fromKittyMod(bits)
+	mods := ""
+	if bits != 0 {
+		mods = strconv.Itoa(bits + 1)
+	}
+	suffix, ev := eventSuffix(tc, key)
+	if suffix != "" && mods == "" && chance(tc, 70) {
+		mods = "1"
+	}
+	seq := "\x1b[" + codes
+	text := ""
+	explicit := false
+	if !functional && chance(tc, 30) {
+		explicit = true
+		text = string(code)
+		if chance(tc, 30) {
+			text += pick(tc, []string{"b", "̀", "☃"})
+		}
+	}
+	if mods != "" || suffix != "" || explicit {
+		seq += ";" + mods + suffix
+	}
+	if explicit {
+		parts := make([]string, 0, 2)
+		for _, r := range text {
+			parts = append(parts, strconv.Itoa(int(r)))
+		}
+		seq += ";" + strings.Join(parts, ":")
+	} else if !functional {
+		text = kittyText(code, shifted, key.Mod)
+	}
+	seq += "u"
+	kind := "kitty"
+	if !explicit && !functional && key.Mod&ModNumLock != 0 && text != "" {
+		kind = "kitty-numlock-text"
+	}
+	if base != 0 {
+		kind = "kitty-shifted-and-base"
+	}
+	switch e := ev.(type) {
+	case KeyPressEvent:
+		e.Text = text
+		ev = e
+	case KeyReleaseEvent:
+		e.Text = text
+		ev = e
+	}
+	return encoded{kind, seq, []Event{ev}}
+}
+
+// genModifyOtherKeys encodes xterm's CSI 27 ; mod ; code ~.
+func genModifyOtherKeys(tc hegel.TestCase) encoded {
+	m, mod := xtermMod(tc)
+	var k KeyPressEvent
+	var code int
+	if chance(tc, 20) {
+		code = pick(tc, []int{8, 9, 13, 27, 127})
+		k = KeyPressEvent{Code: map[int]rune{8: KeyBackspace, 9: KeyTab, 13: KeyEnter, 27: KeyEscape, 127: KeyBackspace}[code], Mod: mod}
+	} else {
+		r := pick(tc, []rune{'a', 'A', 'z', '1', ' ', ';', '/', 'é', '世', '☃', '😃'})
+		code = int(r)
+		k = KeyPressEvent{Code: r, Mod: mod}
+		if mod <= ModShift {
+			k.Text = string(r)
+		}
+	}
+	return encoded{"modify-other-keys", "\x1b[27;" + strconv.Itoa(m) + ";" + strconv.Itoa(code) + "~", []Event{k}}
+}
+
+// genMouse encodes a mouse event with x/ansi's encoders, in SGR or X10 form.
+func genMouse(tc hegel.TestCase) encoded {
+	buttons := []MouseButton{MouseNone, MouseLeft, MouseMiddle, MouseRight, MouseWheelUp, MouseWheelDown, MouseWheelLeft, MouseWheelRight, MouseBackward, MouseForward, MouseButton10, MouseButton11}
+	btn := pick(tc, buttons)
+	motion := chance(tc, 30)
+	shift, alt, ctrl := chance(tc, 30), chance(tc, 30), chance(tc, 30)
+	var mod KeyMod
+	if shift {
+		mod |= ModShift
+	}
+	if alt {
+		mod |= ModAlt
+	}
+	if ctrl {
+		mod |= ModCtrl
+	}
+	b := ansi.EncodeMouseButton(btn, motion, shift, alt, ctrl)
+	wheel := btn >= MouseWheelUp && btn <= MouseWheelRight
+	if chance(tc, 60) {
+		x, y := n(tc, 0, 5000), n(tc, 0, 5000)
+		release := btn != MouseNone && !wheel && !motion && chance(tc, 40)
+		m := Mouse{X: x, Y: y, Button: btn, Mod: mod}
+		var ev Event
+		switch {
+		case wheel:
+			ev = MouseWheelEvent(m)
+		case motion:
+			ev = MouseMotionEvent(m)
+		case release || btn == MouseNone:
+			ev = MouseReleaseEvent(m)
+		default:
+			ev = MouseClickEvent(m)
+		}
+		seq := ansi.MouseSgr(b, x, y, release || (btn == MouseNone && !motion))
+		return encoded{"mouse-sgr", seq, []Event{ev}}
+	}
+	x, y := n(tc, 0, 222), n(tc, 0, 222)
+	m := Mouse{X: x, Y: y, Button: btn, Mod: mod}
+	var ev Event
+	switch {
+	case wheel:
+		ev = MouseWheelEvent(m)
+	case motion:
+		ev = MouseMotionEvent(m)
+	case btn == MouseNone:
+		ev = MouseReleaseEvent(m)
+	default:
+		ev = MouseClickEvent(m)
+	}
+	return encoded{"mouse-x10", "\x1b[M" + string([]byte{b + 32, byte(x + 33), byte(y + 33)}), []Event{ev}}
+}
+
+// genReport encodes one of the terminal's replies: CPR/DECXCPR, DECRPM, DA1, XTWINOPS,
+// focus/blur, Kitty flags, modifyOtherKeys state, OSC colours, OSC 52, XTGETTCAP, XTVERSION.
+func genReport(tc hegel.TestCase) encoded {
+	st := pick(tc, []string{"\x1b\\", "\a"})
+	switch n(tc, 0, 11) {
+	case 0:
+		line, col := n(tc, 1, 500), n(tc, 1, 500)
+		cpr := CursorPositionEvent{X: col - 1, Y: line - 1}
+		if chance(tc, 30) {
+			return encoded{"decxcpr", "\x1b[?" + strconv.Itoa(line) + ";" + strconv.Itoa(col) + "R", []Event{cpr}}
+		}
+		if line == 1 && col-1 <= int(ModMeta|ModShift|ModAlt|ModCtrl) {
+			// Ambiguous with a modified F3; the parser reports both, by design.
+			return encoded{"cpr-f3", ansi.CursorPositionReport(line, col), []Event{KeyPressEvent{Code: KeyF3, Mod: KeyMod(col - 1)}, cpr}}
+		}
+		return encoded{"cpr", ansi.CursorPositionReport(line, col), []Event{cpr}}
+	case 1:
+		v := ansi.ModeSetting(n(tc, 0, 4))
+		var mode ansi.Mode = ansi.ANSIMode(n(tc, 1, 200))
+		if chance(tc, 60) {
+			mode = ansi.DECMode(n(tc, 1, 3000))
+		}
+		return encoded{"decrpm", ansi.ReportMode(mode, v), []Event{ModeReportEvent{Mode: mode, Value: v}}}
+	case 2:
+		k := n(tc, 1, 6)
+		attrs := make([]int, k)
+		for i := range attrs {
+			attrs[i] = n(tc, 1, 99)
+		}
+		return encoded{"da1", ansi.PrimaryDeviceAttributes(attrs...), []Event{PrimaryDeviceAttributesEvent(attrs)}}
+	case 3:
+		op := n(tc, 1, 30)
+		var args []int
+		for range n(tc, 0, 3) {
+			args = append(args, n(tc, 0, 4000))
+		}
+		return encoded{"winop", ansi.WindowOp(op, args...), []Event{WindowOpEvent{Op: op, Args: args}}}
+	case 4:
+		if chance(tc, 50) {
+			return encoded{"focus", "\x1b[I", []Event{FocusEvent{}}}
+		}
+		return encoded{"blur", "\x1b[O", []Event{BlurEvent{}}}
+	case 5:
+		if chance(tc, 50) {
+			f := n(tc, 0, 31)
+			return encoded{"kitty-flags", "\x1b[?" + strconv.Itoa(f) + "u", []Event{KittyEnhancementsEvent(f)}}
+		}
+		v := n(tc, 0, 2)
+		return encoded{"mok-state", "\x1b[>4;" + strconv.Itoa(v) + "m", []Event{ModifyOtherKeysEvent(v)}}
+	case 6, 7:
+		r, g, b := n(tc, 0, 255), n(tc, 0, 255), n(tc, 0, 255)
+		var spec string
+		if chance(tc, 60) {
+			// 16-bit X11 channels; the reply keeps the high byte.
+			lo := func(hi int) int {
+				if hi == 0 {
+					return 0 // x/ansi's XParseColor keeps "00xx" whole
+				}
+				return n(tc, 0, 255)
+			}
+			spec = fmt.Sprintf("rgb:%02x%02x/%02x%02x/%02x%02x", r, lo(r), g, lo(g), b, lo(b))
+		} else {
+			spec = fmt.Sprintf("rgb:%02x/%02x/%02x", r, g, b)
+		}
+		c := color.RGBA{uint8(r), uint8(g), uint8(b), 0xff}
+		switch n(tc, 10, 12) {
+		case 10:
+			return encoded{"osc-fg", "\x1b]10;" + spec + st, []Event{ForegroundColorEvent{c}}}
+		case 11:
+			return encoded{"osc-bg", "\x1b]11;" + spec + st, []Event{BackgroundColorEvent{c}}}
+		default:
+			return encoded{"osc-cursor", "\x1b]12;" + spec + st, []Event{CursorColorEvent{c}}}
+		}
+	case 8:
+		sel := pick(tc, []byte{'c', 'p', 's', '0', '7'})
+		data := make([]byte, n(tc, 0, 12))
+		for i := range data {
+			data[i] = byte(n(tc, 0, 255))
+		}
+		return encoded{"osc52", ansi.SetClipboard(sel, string(data)), []Event{ClipboardEvent{Content: string(data), Selection: sel}}}
+	case 9:
+		k := n(tc, 1, 3)
+		var enc, want []string
+		for range k {
+			name := pick(tc, []string{"Tc", "RGB", "colors", "kbs", "smulx", "Su"})
+			value := pick(tc, []string{"1", "256", "\x7f", "\x1b[4:%p1%dm", "x"})
+			enc = append(enc, hex.EncodeToString([]byte(name))+"="+hex.EncodeToString([]byte(value)))
+			want = append(want, name+"="+value)
+		}
+		return encoded{"xtgettcap", "\x1bP1+r" + strings.Join(enc, ";") + "\x1b\\", []Event{CapabilityEvent(strings.Join(want, ";"))}}
+	case 10:
+		v := pick(tc, []string{"XTerm(388)", "kitty(0.36.4)", "WezTerm 20240203-110809-5046fc22", "foot(1.18.1)", "1.2.3"})
+		return encoded{"xtversion", "\x1bP>|" + v + "\x1b\\", []Event{TerminalVersionEvent(v)}}
+	default:
+		if chance(tc, 50) {
+			return encoded{"paste-start", "\x1b[200~", []Event{PasteStartEvent{}}}
+		}
+		return encoded{"paste-end", "\x1b[201~", []Event{PasteEndEvent{}}}
+	}
+}
+
+// genEvent draws any encoded event. allowEscape admits a lone ESC (only safe as the last
+// event of a stream).
+func genEvent(tc hegel.TestCase, allowEscape bool) encoded {
+	switch n(tc, 0, 9) {
+	case 0, 1:
+		return genText(tc, allowEscape)
+	case 2:
+		return genAlt(tc, allowEscape)
+	case 3, 4:
+		return genFunctionKey(tc)
+	case 5, 6:
+		return genKittyKey(tc)
+	case 7:
+		return genModifyOtherKeys(tc)
+	case 8:
+		return genMouse(tc)
+	default:
+		return genReport(tc)
+	}
+}
