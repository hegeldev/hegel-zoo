diff --git a/hegel/hegel_jwe_test.go b/hegel/hegel_jwe_test.go
new file mode 100644
index 0000000..df6d536
--- /dev/null
+++ b/hegel/hegel_jwe_test.go
@@ -0,0 +1,373 @@
+package hegel
+
+// jwe against joserfc: what one encrypts the other decrypts, with the same plaintext and headers.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/lestrrat-go/jwx/v4/jwa"
+	"github.com/lestrrat-go/jwx/v4/jwe"
+	"hegel.dev/go/hegel"
+)
+
+var encs = []string{"A128CBC-HS256", "A192CBC-HS384", "A256CBC-HS512", "A128GCM", "A192GCM", "A256GCM"}
+
+func keyEncAlg(name string) jwa.KeyEncryptionAlgorithm {
+	a, ok := jwa.LookupKeyEncryptionAlgorithm(name)
+	if !ok {
+		panic("unknown key encryption algorithm " + name)
+	}
+	return a
+}
+
+func contentEnc(name string) jwa.ContentEncryptionAlgorithm {
+	a, ok := jwa.LookupContentEncryptionAlgorithm(name)
+	if !ok {
+		panic("unknown content encryption algorithm " + name)
+	}
+	return a
+}
+
+// recipientSpec is one generated recipient: a key and a key-management algorithm.
+type recipientSpec struct {
+	key keyInfo
+	alg string
+}
+
+// singleOnly: algorithms that allow one recipient only (the CEK is the key or derived from it).
+func singleOnly(alg string) bool {
+	return alg == "dir" || alg == "ECDH-ES"
+}
+
+// genRecipient picks a key and an algorithm; enc is the content encryption the message uses
+// (for "dir" the key must be of the CEK's length, so the key decides enc).
+func genRecipient(tc hegel.TestCase, enc *string, allowSingle bool) recipientSpec {
+	for {
+		k := pick(tc, encryptionKeys()...)
+		var algs []string
+		algs = append(algs, k.encAlgs...)
+		if k.dirEnc != "" && allowSingle && (*enc == "" || *enc == k.dirEnc) {
+			algs = append(algs, "dir")
+		}
+		if len(algs) == 0 {
+			continue
+		}
+		alg := pick(tc, algs...)
+		if singleOnly(alg) && !allowSingle {
+			continue
+		}
+		if alg == "dir" {
+			*enc = k.dirEnc
+		}
+		return recipientSpec{key: k, alg: alg}
+	}
+}
+
+// algAdded: header members a key-management algorithm adds to the header it is given (joserfc
+// puts them in the protected header of a compact serialization).
+var algAdded = map[string]bool{"iv": true, "tag": true, "epk": true, "p2s": true, "p2c": true}
+
+func isASCII(b []byte) bool {
+	for _, c := range b {
+		if c >= 0x80 {
+			return false
+		}
+	}
+	return true
+}
+
+// headerDiff reports why got is not want plus algorithm-added members, or "".
+func headerDiff(got, want map[string]interface{}) string {
+	for k, v := range want {
+		if string(mustJSON(got[k])) != string(mustJSON(v)) {
+			return fmt.Sprintf("member %s is %s, want %s", k, mustJSON(got[k]), mustJSON(v))
+		}
+	}
+	for k := range got {
+		if _, ok := want[k]; !ok && !algAdded[k] {
+			return fmt.Sprintf("unexpected member %s", k)
+		}
+	}
+	return ""
+}
+
+func jweHeaders(h headerSpec) jwe.Headers {
+	hdr := jwe.NewHeaders()
+	for k, v := range h {
+		if err := hdr.Set(k, v); err != nil {
+			panic(fmt.Sprintf("header %s=%v: %v", k, v, err))
+		}
+	}
+	return hdr
+}
+
+// TestHegelEncryptDecryptedByJoserfc: a compact JWE made by jwe.Encrypt (every key-management
+// algorithm × content encryption, optional DEF compression, protected headers with typ, cty and
+// a custom member, plaintext of any bytes) is decrypted by joserfc with the private key to the
+// same plaintext, and joserfc reads the protected header jwx wrote.
+func TestHegelEncryptDecryptedByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		enc := ""
+		rcpt := genRecipient(tc, &enc, true)
+		if enc == "" {
+			enc = pick(tc, encs...)
+		}
+		plaintext := genPayload(tc)
+		h := genHeaders(tc)
+		zip := chance(tc, 25)
+		opts := []jwe.EncryptOption{jwe.WithKey(keyEncAlg(rcpt.alg), rcpt.key.public), jwe.WithContentEncryption(contentEnc(enc)), jwe.WithProtectedHeaders(jweHeaders(h))}
+		if zip {
+			opts = append(opts, jwe.WithCompress(jwa.Deflate()))
+		}
+		encrypted, err := jwe.Encrypt(plaintext, opts...)
+		if err != nil {
+			fail(ht, "Encrypt %s/%s with %s: %v", rcpt.alg, enc, rcpt.key.name, err)
+		}
+		var r struct {
+			reply
+			Plaintext string
+			Protected map[string]interface{}
+		}
+		ask(&r, "ED", encrypted, rcpt.key.privJSON, mustJSON([]string{rcpt.alg, enc}))
+		if !r.Ok {
+			fail(ht, "joserfc cannot decrypt jwx's %s/%s (zip=%v) %s: %s %s", rcpt.alg, enc, zip, encrypted, r.Error, r.Message)
+		}
+		if r.Plaintext != base64.RawURLEncoding.EncodeToString(plaintext) {
+			fail(ht, "%s/%s: joserfc decrypts to %q, encrypted %q", rcpt.alg, enc, r.Plaintext, plaintext)
+		}
+		want := compactHeader(string(encrypted))
+		if string(mustJSON(want)) != string(mustJSON(r.Protected)) {
+			fail(ht, "%s/%s: header written %s, joserfc reads %s", rcpt.alg, enc, mustJSON(want), mustJSON(r.Protected))
+		}
+		if want["alg"] != rcpt.alg || want["enc"] != enc || (zip && want["zip"] != "DEF") {
+			fail(ht, "%s/%s zip=%v: jwx wrote header %s", rcpt.alg, enc, zip, mustJSON(want))
+		}
+		for key, v := range h {
+			if string(mustJSON(want[key])) != string(mustJSON(v)) {
+				fail(ht, "%s/%s: header %s written as %s, set %s", rcpt.alg, enc, key, mustJSON(want[key]), mustJSON(v))
+			}
+		}
+		count(rcpt.alg + " " + enc)
+	})
+}
+
+// TestHegelEncryptJSONDecryptedByJoserfc: a JSON-serialized JWE (jwe.WithJSON) for one to three
+// recipients, each with its own key-management algorithm and per-recipient headers, is decrypted
+// by joserfc with the set of private keys to the same plaintext, with the same protected header
+// and per-recipient headers; one recipient gives the flattened form.
+func TestHegelEncryptJSONDecryptedByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		enc := ""
+		nrcpt := pick(tc, 1, 1, 2, 3)
+		var rcpts []recipientSpec
+		seen := map[string]bool{}
+		for i := 0; i < nrcpt; i++ {
+			rc := genRecipient(tc, &enc, nrcpt == 1)
+			if seen[rc.key.name] {
+				continue
+			}
+			seen[rc.key.name] = true
+			rcpts = append(rcpts, rc)
+		}
+		if enc == "" {
+			enc = pick(tc, encs...)
+		}
+		plaintext := genPayload(tc)
+		h := genHeaders(tc)
+		if !isASCII(mustJSON(h)) {
+			// joserfc re-encodes the protected header of a JSON serialization before checking the
+			// tag (json.dumps with \u escapes), so a producer's raw UTF-8 header never verifies
+			count("joserfc re-encodes non-ASCII protected headers")
+			return
+		}
+		if id := knownEncryptJSON(rcpts, enc, plaintext); id != "" {
+			count("known " + id)
+			return
+		}
+		opts := []jwe.EncryptOption{jwe.WithJSON(), jwe.WithContentEncryption(contentEnc(enc)), jwe.WithProtectedHeaders(jweHeaders(h))}
+		var keySet []json.RawMessage
+		var algs []string
+		algs = append(algs, enc)
+		for _, rc := range rcpts {
+			ph := jwe.NewHeaders()
+			ph.Set(jwe.KeyIDKey, rc.key.name)
+			opts = append(opts, jwe.WithKey(keyEncAlg(rc.alg), rc.key.public, jwe.WithPerRecipientHeaders(ph)))
+			keySet = append(keySet, rc.key.privJSON)
+			algs = append(algs, rc.alg)
+		}
+		encrypted, err := jwe.Encrypt(plaintext, opts...)
+		if err != nil {
+			fail(ht, "Encrypt JSON %v/%s: %v", algs, enc, err)
+		}
+		var r struct {
+			reply
+			Plaintext   string
+			Protected   map[string]interface{}
+			Unprotected map[string]interface{}
+			Recipients  []map[string]interface{}
+		}
+		ask(&r, "DJ", encrypted, mustJSON(keySet), mustJSON(algs))
+		if !r.Ok {
+			fail(ht, "joserfc cannot decrypt jwx's JSON JWE %v: %s %s\n%s", algs, r.Error, r.Message, encrypted)
+		}
+		if r.Plaintext != base64.RawURLEncoding.EncodeToString(plaintext) {
+			fail(ht, "JSON %v: joserfc decrypts to %q, encrypted %q", algs, r.Plaintext, plaintext)
+		}
+		if len(r.Recipients) != len(rcpts) {
+			fail(ht, "JSON %v: joserfc sees %d recipients, want %d\n%s", algs, len(r.Recipients), len(rcpts), encrypted)
+		}
+		var obj map[string]json.RawMessage
+		json.Unmarshal(encrypted, &obj)
+		_, general := obj["recipients"]
+		if flattened := !general; flattened != (len(rcpts) == 1) {
+			fail(ht, "JSON with %d recipients: flattened=%v\n%s", len(rcpts), flattened, encrypted)
+		}
+		msg, err := jwe.Parse(encrypted)
+		if err != nil {
+			fail(ht, "jwe.Parse of its own output: %v\n%s", err, encrypted)
+		} else {
+			pb, _ := json.Marshal(msg.ProtectedHeaders())
+			if canon(pb) != string(mustJSON(r.Protected)) {
+				fail(ht, "JSON %v: jwx protected %s, joserfc %s", algs, canon(pb), mustJSON(r.Protected))
+			}
+			if id := knownRecipientHeaders(rcpts); id != "" {
+				count("known " + id)
+			} else {
+				for i, rc := range msg.Recipients() {
+					hb, _ := json.Marshal(rc.Headers())
+					if i >= len(r.Recipients) {
+						break
+					}
+					want := r.Recipients[i]
+					if want == nil {
+						want = map[string]interface{}{} // no per-recipient header: jwx says {}, joserfc None
+					}
+					if canon(hb) != string(mustJSON(want)) {
+						fail(ht, "JSON recipient %d: jwx header %s, joserfc %s", i, canon(hb), mustJSON(want))
+					}
+				}
+			}
+		}
+		count(fmt.Sprintf("%d recipients", len(rcpts)))
+	})
+}
+
+// TestHegelJoserfcEncryptDecryptedByJwx: a compact or JSON JWE made by joserfc (any algorithms,
+// compression, AAD and unprotected headers in the JSON form) is decrypted by jwe.Decrypt with
+// one recipient's private key to the plaintext, and jwe.Parse reads the same protected header.
+func TestHegelJoserfcEncryptDecryptedByJwx(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		enc := ""
+		useJSON := chance(tc, 40)
+		nrcpt := 1
+		if useJSON {
+			nrcpt = pick(tc, 1, 1, 2, 3)
+		}
+		var rcpts []recipientSpec
+		seen := map[string]bool{}
+		for i := 0; i < nrcpt; i++ {
+			rc := genRecipient(tc, &enc, nrcpt == 1)
+			if seen[rc.key.name] {
+				continue
+			}
+			seen[rc.key.name] = true
+			rcpts = append(rcpts, rc)
+		}
+		if enc == "" {
+			enc = pick(tc, encs...)
+		}
+		plaintext := genPayload(tc)
+		protected := map[string]interface{}{"enc": enc}
+		for k, v := range genHeaders(tc) {
+			protected[k] = v
+		}
+		if chance(tc, 25) {
+			protected["zip"] = "DEF"
+		}
+		if id := knownDecrypt(enc, plaintext, useJSON); id != "" {
+			count("known " + id)
+			return
+		}
+		var token []byte
+		var aad []byte
+		if useJSON {
+			type rec struct {
+				Header map[string]interface{} `json:"header"`
+				Key    json.RawMessage        `json:"key"`
+			}
+			var recs []rec
+			for _, rc := range rcpts {
+				recs = append(recs, rec{Header: map[string]interface{}{"alg": rc.alg, "kid": rc.key.name}, Key: rc.key.pubJSON})
+			}
+			if len(rcpts) == 1 && chance(tc, 40) {
+				protected["alg"] = rcpts[0].alg
+				recs[0].Header = map[string]interface{}{"kid": rcpts[0].key.name}
+			}
+			if chance(tc, 40) {
+				aad = pick(tc, []byte("extra"), []byte(""), randBytes(n(tc, 1, 40)), []byte("日本"))
+			}
+			flattened := "0"
+			if len(rcpts) == 1 && chance(tc, 60) {
+				flattened = "1"
+			}
+			unprot := []byte("")
+			if chance(tc, 30) {
+				unprot = mustJSON(map[string]interface{}{"x-unprotected": "u"})
+			}
+			var r struct {
+				reply
+				JSON json.RawMessage `json:"json"`
+			}
+			ask(&r, "EJ", mustJSON(protected), plaintext, mustJSON(recs), aad, s(flattened), unprot)
+			if !r.Ok {
+				count("joserfc cannot encrypt: " + r.Error)
+				return
+			}
+			token = r.JSON
+		} else {
+			protected["alg"] = rcpts[0].alg
+			if chance(tc, 50) {
+				protected["kid"] = rcpts[0].key.name
+			}
+			var r struct {
+				reply
+				Compact string
+			}
+			ask(&r, "EE", mustJSON(protected), plaintext, rcpts[0].key.pubJSON)
+			if !r.Ok {
+				count("joserfc cannot encrypt: " + r.Error)
+				return
+			}
+			token = []byte(r.Compact)
+		}
+		rc := rcpts[n(tc, 0, len(rcpts)-1)]
+		got, err := jwe.Decrypt(token, jwe.WithKey(keyEncAlg(rc.alg), rc.key.private))
+		if err != nil {
+			fail(ht, "Decrypt of joserfc's %s/%s (json=%v, aad=%q) with %s: %v\n%s", rc.alg, enc, useJSON, aad, rc.key.name, err, token)
+		}
+		if string(got) != string(plaintext) {
+			fail(ht, "%s/%s: Decrypt gives %q, joserfc encrypted %q", rc.alg, enc, got, plaintext)
+		}
+		msg, err := jwe.Parse(token)
+		if err != nil {
+			fail(ht, "Parse of joserfc's %s: %v", token, err)
+		} else {
+			pb, _ := json.Marshal(msg.ProtectedHeaders())
+			var got map[string]interface{}
+			json.Unmarshal(pb, &got)
+			if why := headerDiff(got, protected); why != "" {
+				fail(ht, "%s/%s: jwx reads protected header %s, joserfc wrote %s: %s", rc.alg, enc, canon(pb), mustJSON(protected), why)
+			}
+			if len(msg.Recipients()) != len(rcpts) {
+				fail(ht, "Parse sees %d recipients, want %d in %s", len(msg.Recipients()), len(rcpts), token)
+			}
+		}
+		count(fmt.Sprintf("%s %s json=%v", rc.alg, enc, useJSON))
+	})
+}
diff --git a/hegel/hegel_jwk_test.go b/hegel/hegel_jwk_test.go
new file mode 100644
index 0000000..43100b0
--- /dev/null
+++ b/hegel/hegel_jwk_test.go
@@ -0,0 +1,173 @@
+package hegel
+
+// jwk against joserfc: thumbprints, and key JSON read each way.
+
+import (
+	"crypto"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/lestrrat-go/jwx/v4/jwk"
+	"hegel.dev/go/hegel"
+)
+
+var hashes = map[string]crypto.Hash{"sha256": crypto.SHA256, "sha384": crypto.SHA384, "sha512": crypto.SHA512}
+
+// TestHegelThumbprintMatchesJoserfc: Key.Thumbprint (RFC 7638) of every key type, public or
+// private, with SHA-256/384/512, is joserfc's thumbprint of the same key.
+func TestHegelThumbprintMatchesJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, keys()...)
+		hname := pick(tc, "sha256", "sha384", "sha512")
+		key, raw := k.public, k.pubJSON
+		if chance(tc, 40) {
+			key, raw = k.private, k.privJSON
+		}
+		tp, err := key.Thumbprint(hashes[hname])
+		if err != nil {
+			fail(ht, "%s.Thumbprint(%s): %v", k.name, hname, err)
+		}
+		got := base64.RawURLEncoding.EncodeToString(tp)
+		var r struct {
+			reply
+			Thumbprint string
+		}
+		ask(&r, "T", raw, s(hname))
+		if !r.Ok {
+			fail(ht, "joserfc cannot read %s: %s %s", raw, r.Error, r.Message)
+		}
+		if got != r.Thumbprint {
+			fail(ht, "%s thumbprint %s: jwx %s, joserfc %s", k.name, hname, got, r.Thumbprint)
+		}
+		count(k.kty)
+	})
+}
+
+// TestHegelKeyJSONReadByJoserfc: the JSON jwx writes for a key (public or private, with kid, alg
+// and use set or not) is read by joserfc as the same key: the same members, the same
+// public/private nature, and the public part jwx computes is the public part joserfc computes.
+func TestHegelKeyJSONReadByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, keys()...)
+		var key jwk.Key
+		private := chance(tc, 50)
+		if private {
+			key, _ = k.private.Clone()
+		} else {
+			key, _ = k.public.Clone()
+		}
+		if chance(tc, 30) {
+			key.Remove(jwk.KeyIDKey)
+		}
+		if chance(tc, 30) && len(k.sigAlgs) > 0 {
+			key.Set(jwk.AlgorithmKey, pick(tc, k.sigAlgs...))
+		}
+		if chance(tc, 30) {
+			key.Set(jwk.KeyUsageKey, pick(tc, "sig", "enc"))
+		}
+		raw, err := json.Marshal(key)
+		if err != nil {
+			fail(ht, "marshal %s: %v", k.name, err)
+		}
+		var r struct {
+			reply
+			Dict    json.RawMessage
+			Public  json.RawMessage
+			Private bool
+			Kty     string
+		}
+		ask(&r, "K", raw)
+		if !r.Ok {
+			fail(ht, "joserfc rejects jwx's %s JSON %s: %s %s", k.name, raw, r.Error, r.Message)
+		}
+		if canon(raw) != canon(r.Dict) {
+			fail(ht, "%s: jwx wrote %s, joserfc reads %s", k.name, canon(raw), canon(r.Dict))
+		}
+		isPriv, _ := jwk.IsPrivateKey(key)
+		if k.kty == "oct" {
+			isPriv = true // joserfc counts a symmetric key as private
+		}
+		if isPriv != r.Private {
+			fail(ht, "%s: jwx IsPrivateKey %v, joserfc is_private %v for %s", k.name, isPriv, r.Private, raw)
+		}
+		if k.kty != "oct" {
+			pub, err := jwk.PublicKeyOf(key)
+			if err != nil {
+				fail(ht, "PublicKeyOf(%s): %v", k.name, err)
+			}
+			pubRaw, _ := json.Marshal(pub)
+			if canon(pubRaw) != canon(r.Public) {
+				fail(ht, "%s: jwx PublicKeyOf %s, joserfc public part %s", k.name, canon(pubRaw), canon(r.Public))
+			}
+		}
+		count(fmt.Sprintf("%s private=%v", k.kty, private))
+	})
+}
+
+var genShapes = []struct{ kty, crv string }{
+	{"oct", "128"}, {"oct", "256"}, {"oct", "512"}, {"oct", "8"},
+	{"RSA", "2048"},
+	{"EC", "P-256"}, {"EC", "P-384"}, {"EC", "P-521"},
+	{"OKP", "Ed25519"}, {"OKP", "X25519"},
+}
+
+// TestHegelJoserfcKeyReadByJwx: a key joserfc generates and writes (private and public JSON,
+// with or without kid) is read by jwk.ParseKey and written back as the same JSON;
+// PublicKeyOf gives joserfc's public JSON; a set of such keys parses with jwk.Parse.
+func TestHegelJoserfcKeyReadByJwx(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		sh := pick(tc, genShapes...)
+		if sh.kty == "RSA" && !chance(tc, 25) {
+			sh = pick(tc, genShapes[:4]...) // RSA generation is slow
+		}
+		kid := pick(tc, "", "k1", "a-b.c")
+		var r struct {
+			reply
+			Private json.RawMessage
+			Public  json.RawMessage
+		}
+		ask(&r, "G", s(sh.kty), s(sh.crv), s(kid))
+		if !r.Ok {
+			count("joserfc cannot generate")
+			return
+		}
+		for _, side := range []struct {
+			name string
+			raw  json.RawMessage
+		}{{"private", r.Private}, {"public", r.Public}} {
+			if sh.kty == "oct" && side.name == "public" {
+				continue // a symmetric key has no public JSON
+			}
+			key, err := jwk.ParseKey(side.raw)
+			if err != nil {
+				fail(ht, "ParseKey(%s %s %s): %v", sh.kty, sh.crv, side.raw, err)
+			}
+			back, _ := json.Marshal(key)
+			if canon(back) != canon(side.raw) {
+				fail(ht, "%s %s %s: joserfc wrote %s, jwx writes back %s", sh.kty, sh.crv, side.name, canon(side.raw), canon(back))
+			}
+			if side.name == "private" && sh.kty != "oct" {
+				pub, err := jwk.PublicKeyOf(key)
+				if err != nil {
+					fail(ht, "PublicKeyOf: %v", err)
+				}
+				pubRaw, _ := json.Marshal(pub)
+				if canon(pubRaw) != canon(r.Public) {
+					fail(ht, "%s %s: jwx PublicKeyOf %s, joserfc public %s", sh.kty, sh.crv, canon(pubRaw), canon(r.Public))
+				}
+			}
+		}
+		set, err := jwk.Parse([]byte(fmt.Sprintf(`{"keys":[%s,%s]}`, r.Private, keys()[0].pubJSON)))
+		if err != nil {
+			fail(ht, "jwk.Parse of a set with %s: %v", r.Private, err)
+		} else if set.Len() != 2 {
+			fail(ht, "set of 2 keys has %d", set.Len())
+		}
+		count(sh.kty + " " + sh.crv)
+	})
+}
diff --git a/hegel/hegel_jws_test.go b/hegel/hegel_jws_test.go
new file mode 100644
index 0000000..fe71960
--- /dev/null
+++ b/hegel/hegel_jws_test.go
@@ -0,0 +1,270 @@
+package hegel
+
+// jws against joserfc: what one signs the other verifies, with the same payload and headers.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/lestrrat-go/jwx/v4/jwa"
+	"github.com/lestrrat-go/jwx/v4/jws"
+	"hegel.dev/go/hegel"
+)
+
+var payloads = [][]byte{{}, []byte("hi"), []byte(`{"a":1}`), []byte("a.b.c"), {0, 1, 2, 255, 254}, []byte("é ü 日本"), []byte(strings.Repeat("x", 300)), []byte("\n"), []byte(" "), []byte("===")}
+
+func genPayload(tc hegel.TestCase) []byte {
+	if chance(tc, 30) {
+		return randBytes(n(tc, 0, 64))
+	}
+	return pick(tc, payloads...)
+}
+
+// headerSpec: the extra protected header members generated for a signature or encryption.
+type headerSpec map[string]interface{}
+
+func genHeaders(tc hegel.TestCase) headerSpec {
+	h := headerSpec{}
+	if chance(tc, 40) {
+		h["typ"] = pick(tc, "JWT", "JOSE", "application/example", "jose+json")
+	}
+	if chance(tc, 25) {
+		h["cty"] = pick(tc, "JWT", "text/plain", "example")
+	}
+	if chance(tc, 30) {
+		h["x-custom"] = pick(tc, []interface{}{"v", float64(3), true, nil, []interface{}{"a", float64(1)}, map[string]interface{}{"k": "v"}, "é"}...)
+	}
+	return h
+}
+
+func sigAlg(name string) jwa.SignatureAlgorithm {
+	a, ok := jwa.LookupSignatureAlgorithm(name)
+	if !ok {
+		panic("unknown signature algorithm " + name)
+	}
+	return a
+}
+
+func jwsHeaders(kid string, alg string, h headerSpec) jws.Headers {
+	hdr := jws.NewHeaders()
+	for k, v := range h {
+		if err := hdr.Set(k, v); err != nil {
+			panic(fmt.Sprintf("header %s=%v: %v", k, v, err))
+		}
+	}
+	return hdr
+}
+
+// compactHeader decodes the protected header of a compact serialization.
+func compactHeader(compact string) map[string]interface{} {
+	part := strings.SplitN(compact, ".", 2)[0]
+	raw, err := base64.RawURLEncoding.DecodeString(part)
+	if err != nil {
+		return map[string]interface{}{"INVALID": part}
+	}
+	var m map[string]interface{}
+	if err := json.Unmarshal(raw, &m); err != nil {
+		return map[string]interface{}{"INVALID": string(raw)}
+	}
+	return m
+}
+
+// TestHegelSignVerifiedByJoserfc: a compact JWS signed by jws.Sign (any algorithm the key
+// supports, a payload of any bytes, protected headers with typ, cty and a custom member) is
+// verified by joserfc with the given public key and yields the same payload; the protected
+// header joserfc reports is the one jwx wrote (alg, kid, and the extra members).
+func TestHegelSignVerifiedByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, signingKeys()...)
+		alg := pick(tc, k.sigAlgs...)
+		payload := genPayload(tc)
+		h := genHeaders(tc)
+		signed, err := jws.Sign(payload, jws.WithKey(sigAlg(alg), k.private, jws.WithProtectedHeaders(jwsHeaders(k.name, alg, h))))
+		if err != nil {
+			fail(ht, "Sign %s %s: %v", k.name, alg, err)
+		}
+		var r struct {
+			reply
+			Payload   string
+			Protected map[string]interface{}
+		}
+		ask(&r, "SV", signed, k.pubJSON, s(alg))
+		if !r.Ok {
+			fail(ht, "joserfc rejects jwx's %s signature %s: %s %s", alg, signed, r.Error, r.Message)
+		}
+		if r.Payload != base64.RawURLEncoding.EncodeToString(payload) {
+			fail(ht, "%s: joserfc reads payload %q, signed %q", alg, r.Payload, payload)
+		}
+		want := compactHeader(string(signed))
+		if string(mustJSON(want)) != string(mustJSON(r.Protected)) {
+			fail(ht, "%s: header written %s, joserfc reads %s", alg, mustJSON(want), mustJSON(r.Protected))
+		}
+		if want["alg"] != alg || want["kid"] != k.name {
+			fail(ht, "%s: jwx wrote header %s, want alg %s kid %s", alg, mustJSON(want), alg, k.name)
+		}
+		for key, v := range h {
+			if string(mustJSON(want[key])) != string(mustJSON(v)) {
+				fail(ht, "%s: header %s written as %s, set %s", alg, key, mustJSON(want[key]), mustJSON(v))
+			}
+		}
+		count(alg)
+	})
+}
+
+// TestHegelSignJSONVerifiedByJoserfc: a JSON-serialized JWS with one to three signatures
+// (jws.WithJSON, keys with kids) is verified by joserfc with the set of public keys, with the
+// same payload and the same protected header per signature; one key gives the flattened form.
+func TestHegelSignJSONVerifiedByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		payload := genPayload(tc)
+		nsig := pick(tc, 1, 1, 2, 3)
+		opts := []jws.SignOption{jws.WithJSON()}
+		var ks []keyInfo
+		var algs []string
+		var keySet []json.RawMessage
+		seen := map[string]bool{}
+		for i := 0; i < nsig; i++ {
+			k := pick(tc, signingKeys()...)
+			if seen[k.name] {
+				continue
+			}
+			seen[k.name] = true
+			alg := pick(tc, k.sigAlgs...)
+			ks = append(ks, k)
+			algs = append(algs, alg)
+			keySet = append(keySet, k.pubJSON)
+			opts = append(opts, jws.WithKey(sigAlg(alg), k.private, jws.WithProtectedHeaders(jwsHeaders(k.name, alg, genHeaders(tc)))))
+		}
+		signed, err := jws.Sign(payload, opts...)
+		if err != nil {
+			fail(ht, "Sign JSON %v: %v", algs, err)
+		}
+		var r struct {
+			reply
+			Payload   string
+			Flattened bool
+			Members   []struct {
+				Protected map[string]interface{}
+				Header    map[string]interface{}
+			}
+		}
+		ask(&r, "VJ", signed, mustJSON(keySet), mustJSON(algs))
+		if !r.Ok {
+			fail(ht, "joserfc rejects jwx's JSON JWS %s (algs %v): %s %s", signed, algs, r.Error, r.Message)
+		}
+		if r.Payload != base64.RawURLEncoding.EncodeToString(payload) {
+			fail(ht, "JSON %v: joserfc reads payload %q, signed %q", algs, r.Payload, payload)
+		}
+		if len(r.Members) != len(ks) {
+			fail(ht, "JSON %v: joserfc sees %d signatures, want %d in %s", algs, len(r.Members), len(ks), signed)
+		}
+		if r.Flattened != (len(ks) == 1) {
+			fail(ht, "JSON with %d keys: flattened=%v in %s", len(ks), r.Flattened, signed)
+		}
+		msg, err := jws.Parse(signed)
+		if err != nil {
+			fail(ht, "jws.Parse of its own output %s: %v", signed, err)
+		}
+		for i, sig := range msg.Signatures() {
+			pb, _ := json.Marshal(sig.ProtectedHeaders())
+			if i < len(r.Members) && canon(pb) != string(mustJSON(r.Members[i].Protected)) {
+				fail(ht, "JSON signature %d: jwx protected %s, joserfc %s", i, canon(pb), mustJSON(r.Members[i].Protected))
+			}
+		}
+		count(fmt.Sprintf("%d signatures", len(ks)))
+	})
+}
+
+// TestHegelJoserfcSignVerifiedByJwx: a compact or JSON JWS signed by joserfc is verified by
+// jws.Verify with the public key and yields the payload; jws.Parse reports the same protected
+// header; a corrupted signature is refused by both.
+func TestHegelJoserfcSignVerifiedByJwx(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, signingKeys()...)
+		alg := pick(tc, k.sigAlgs...)
+		payload := genPayload(tc)
+		protected := map[string]interface{}{"alg": alg}
+		if chance(tc, 60) {
+			protected["kid"] = k.name
+		}
+		for key, v := range genHeaders(tc) {
+			protected[key] = v
+		}
+		useJSON := chance(tc, 30)
+		var token []byte
+		if useJSON {
+			member := map[string]interface{}{"protected": protected}
+			if chance(tc, 50) {
+				member["header"] = map[string]interface{}{"kid": k.name}
+				delete(protected, "kid")
+			}
+			var r struct {
+				reply
+				JSON json.RawMessage `json:"json"`
+			}
+			ask(&r, "SJ", mustJSON(member), payload, mustJSON([]json.RawMessage{k.privJSON}), mustJSON([]string{alg}))
+			if !r.Ok {
+				count("joserfc cannot sign: " + r.Error)
+				return
+			}
+			token = r.JSON
+		} else {
+			var r struct {
+				reply
+				Compact string
+			}
+			ask(&r, "SS", mustJSON(protected), payload, k.privJSON)
+			if !r.Ok {
+				count("joserfc cannot sign: " + r.Error)
+				return
+			}
+			token = []byte(r.Compact)
+		}
+		got, err := jws.Verify(token, jws.WithKey(sigAlg(alg), k.public))
+		if err != nil {
+			fail(ht, "Verify of joserfc's %s %s: %v", alg, token, err)
+		}
+		if string(got) != string(payload) {
+			fail(ht, "%s: Verify gives payload %q, joserfc signed %q", alg, got, payload)
+		}
+		msg, err := jws.Parse(token)
+		if err != nil {
+			fail(ht, "Parse of joserfc's %s: %v", token, err)
+		}
+		if len(msg.Signatures()) != 1 {
+			fail(ht, "Parse sees %d signatures in %s", len(msg.Signatures()), token)
+		} else {
+			pb, _ := json.Marshal(msg.Signatures()[0].ProtectedHeaders())
+			if canon(pb) != string(mustJSON(protected)) {
+				fail(ht, "%s: jwx reads protected header %s, joserfc wrote %s", alg, canon(pb), mustJSON(protected))
+			}
+		}
+		// corrupt the signature: both must refuse
+		if !useJSON && chance(tc, 50) {
+			parts := strings.Split(string(token), ".")
+			sig, _ := base64.RawURLEncoding.DecodeString(parts[2])
+			if len(sig) > 0 {
+				sig[n(tc, 0, len(sig)-1)] ^= 1 << uint(n(tc, 0, 7))
+				parts[2] = base64.RawURLEncoding.EncodeToString(sig)
+				bad := strings.Join(parts, ".")
+				if _, err := jws.Verify([]byte(bad), jws.WithKey(sigAlg(alg), k.public)); err == nil {
+					fail(ht, "%s: Verify accepts a corrupted signature %s", alg, bad)
+				}
+				var r struct{ reply }
+				ask(&r, "SV", []byte(bad), k.pubJSON, s(alg))
+				if r.Ok {
+					fail(ht, "%s: joserfc accepts a corrupted signature %s", alg, bad)
+				}
+				count("corrupted refused")
+				return
+			}
+		}
+		count(alg)
+	})
+}
diff --git a/hegel/hegel_jwt_test.go b/hegel/hegel_jwt_test.go
new file mode 100644
index 0000000..3b303ae
--- /dev/null
+++ b/hegel/hegel_jwt_test.go
@@ -0,0 +1,213 @@
+package hegel
+
+// jwt against joserfc: tokens read each way, and claims validation (exp, nbf, iat with leeway).
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/lestrrat-go/jwx/v4/jwt"
+	"hegel.dev/go/hegel"
+)
+
+const fixedNow = 1_800_000_000
+
+// claimsSpec is a generated claims set as JSON-compatible values.
+type claimsSpec map[string]interface{}
+
+func genClaims(tc hegel.TestCase) claimsSpec {
+	c := claimsSpec{}
+	if chance(tc, 60) {
+		c["iss"] = pick(tc, "issuer", "https://example.com/", "")
+	}
+	if chance(tc, 60) {
+		c["sub"] = pick(tc, "subject", "1234567890", "é")
+	}
+	if chance(tc, 60) {
+		switch pick(tc, 0, 1, 2, 3) {
+		case 0:
+			c["aud"] = "audience"
+		case 1:
+			c["aud"] = []interface{}{"a", "b"}
+		case 2:
+			c["aud"] = []interface{}{"single"}
+		case 3:
+			c["aud"] = []interface{}{}
+		}
+	}
+	for _, name := range []string{"exp", "nbf", "iat"} {
+		if chance(tc, 50) {
+			c[name] = float64(fixedNow + n(tc, -120, 120))
+		}
+	}
+	if chance(tc, 40) {
+		c["jti"] = pick(tc, "id-1", "0", "")
+	}
+	if chance(tc, 50) {
+		c["custom"] = pick(tc, []interface{}{"v", float64(42), float64(1.5), true, nil, []interface{}{"a", float64(1)}, map[string]interface{}{"k": "v", "n": float64(2)}, "", "日本"}...)
+	}
+	return c
+}
+
+// normClaims writes a single-string aud as a one-element array: RFC 7519 allows either form, and
+// jwx always writes the array (jwt.Settings(jwt.WithFlattenAudience(true)) would change that).
+func normClaims(m map[string]interface{}) []byte {
+	out := map[string]interface{}{}
+	for k, v := range m {
+		if k == "aud" {
+			if str, ok := v.(string); ok {
+				v = []interface{}{str}
+			}
+		}
+		out[k] = v
+	}
+	return mustJSON(out)
+}
+
+// TestHegelTokenSignedReadByJoserfc: a token built with jwt.New/Set (standard claims of every
+// kind and a custom one) and signed by jwt.Sign is decoded by joserfc with the public key to the
+// same claims, with a JWT header (alg, typ).
+func TestHegelTokenSignedReadByJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, signingKeys()...)
+		alg := pick(tc, k.sigAlgs...)
+		claims := genClaims(tc)
+		tok := jwt.New()
+		for name, v := range claims {
+			var val interface{} = v
+			switch name {
+			case "exp", "nbf", "iat":
+				val = time.Unix(int64(v.(float64)), 0)
+			}
+			if err := tok.Set(name, val); err != nil {
+				fail(ht, "Set %s=%v: %v", name, v, err)
+			}
+		}
+		signed, err := jwt.Sign(tok, jwt.WithKey(sigAlg(alg), k.private))
+		if err != nil {
+			fail(ht, "jwt.Sign %s: %v", alg, err)
+		}
+		var r struct {
+			reply
+			Header map[string]interface{}
+			Claims map[string]interface{}
+		}
+		ask(&r, "JD", signed, k.pubJSON, s(alg))
+		if !r.Ok {
+			fail(ht, "joserfc rejects jwx's token %s: %s %s", signed, r.Error, r.Message)
+		}
+		if string(normClaims(r.Claims)) != string(normClaims(claims)) {
+			fail(ht, "%s: joserfc reads claims %s, set %s\n%s", alg, mustJSON(r.Claims), mustJSON(claims), signed)
+		}
+		if r.Header["alg"] != alg || r.Header["typ"] != "JWT" {
+			fail(ht, "%s: header %s", alg, mustJSON(r.Header))
+		}
+		count(alg)
+	})
+}
+
+// TestHegelJoserfcTokenReadByJwx: a token encoded by joserfc is parsed and verified by jwt.Parse
+// with the public key, and its claims (as JSON) are the ones encoded; jwt.Sign of the parsed
+// token, decoded by joserfc again, gives the same claims.
+func TestHegelJoserfcTokenReadByJwx(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		k := pick(tc, signingKeys()...)
+		alg := pick(tc, k.sigAlgs...)
+		claims := genClaims(tc)
+		header := map[string]interface{}{"alg": alg}
+		if chance(tc, 50) {
+			header["kid"] = k.name
+		}
+		if chance(tc, 50) {
+			header["typ"] = pick(tc, "JWT", "at+jwt")
+		}
+		var r struct {
+			reply
+			Token string
+		}
+		ask(&r, "JE", mustJSON(header), mustJSON(claims), k.privJSON)
+		if !r.Ok {
+			count("joserfc cannot encode: " + r.Error)
+			return
+		}
+		tok, err := jwt.Parse([]byte(r.Token), jwt.WithKey(sigAlg(alg), k.public), jwt.WithValidate(false))
+		if err != nil {
+			fail(ht, "jwt.Parse of joserfc's %s token %s (claims %s): %v", alg, r.Token, mustJSON(claims), err)
+		}
+		got, err := json.Marshal(tok)
+		if err != nil {
+			fail(ht, "marshal token: %v", err)
+		}
+		var gotMap map[string]interface{}
+		json.Unmarshal(got, &gotMap)
+		if string(normClaims(gotMap)) != string(normClaims(claims)) {
+			fail(ht, "%s: jwx reads claims %s, joserfc encoded %s", alg, canon(got), mustJSON(claims))
+		}
+		signed, err := jwt.Sign(tok, jwt.WithKey(sigAlg(alg), k.private))
+		if err != nil {
+			fail(ht, "re-sign: %v", err)
+		}
+		var d struct {
+			reply
+			Claims map[string]interface{}
+		}
+		ask(&d, "JD", signed, k.pubJSON, s(alg))
+		if !d.Ok {
+			fail(ht, "joserfc rejects the re-signed token %s: %s %s", signed, d.Error, d.Message)
+		} else if string(normClaims(d.Claims)) != string(normClaims(claims)) {
+			fail(ht, "%s: after Parse and Sign the claims are %s, were %s", alg, mustJSON(d.Claims), mustJSON(claims))
+		}
+		count(alg)
+	})
+}
+
+// TestHegelValidateMatchesJoserfc: jwt.Validate with a fixed clock and an acceptable skew accepts
+// a token exactly when joserfc's JWTClaimsRegistry with the same now and leeway does (exp, nbf,
+// iat around now), except at the exact boundary (now == exp + leeway), where RFC 7519 makes the
+// token expired and joserfc still accepts it.
+func TestHegelValidateMatchesJoserfc(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		claims := claimsSpec{}
+		for _, name := range []string{"exp", "nbf", "iat"} {
+			if chance(tc, 70) {
+				claims[name] = float64(fixedNow + pick(tc, n(tc, -100, 100), n(tc, -5, 5), 0, -1, 1))
+			}
+		}
+		leeway := pick(tc, 0, 0, 1, 5, 30, 100)
+		if exp, ok := claims["exp"]; ok && int(exp.(float64))+leeway == fixedNow {
+			count("boundary")
+			return
+		}
+		tok := jwt.New()
+		for name, v := range claims {
+			tok.Set(name, time.Unix(int64(v.(float64)), 0))
+		}
+		clock := jwt.ClockFunc(func() time.Time { return time.Unix(fixedNow, 0) })
+		err := jwt.Validate(tok, jwt.WithClock(clock), jwt.WithAcceptableSkew(time.Duration(leeway)*time.Second))
+		var r struct {
+			reply
+			Valid   bool
+			Error   string
+			Message string
+		}
+		ask(&r, "JV", mustJSON(claims), s(fmt.Sprint(fixedNow)), s(fmt.Sprint(leeway)))
+		if !r.Ok {
+			fail(ht, "joserfc validate failed to run: %s %s", r.Error, r.Message)
+		}
+		switch {
+		case err == nil && !r.Valid:
+			fail(ht, "claims %s, leeway %d: jwx valid, joserfc %s (%s)", mustJSON(claims), leeway, r.Error, r.Message)
+		case err != nil && r.Valid:
+			fail(ht, "claims %s, leeway %d: jwx %v, joserfc valid", mustJSON(claims), leeway, err)
+		case err == nil:
+			count("valid")
+		default:
+			count("invalid")
+		}
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..ff4edd7
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,98 @@
+package hegel
+
+// One deterministic reproducer per recorded bug (bugs.toml). Each fails while the bug is open.
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/lestrrat-go/jwx/v4/jwa"
+	"github.com/lestrrat-go/jwx/v4/jwe"
+	"github.com/lestrrat-go/jwx/v4/jwk"
+)
+
+func pinKey(t *testing.T) jwk.Key {
+	key, err := jwk.Import[jwk.Key](make([]byte, 16))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return key
+}
+
+// jwx/1: the JSON serialization of a JWE whose ciphertext is empty (an empty plaintext under an
+// AEAD content encryption) has no "ciphertext" member; RFC 7516 section 7.2 says it MUST be
+// present, and jwx's own Parse refuses the result.
+func TestHegelPinJSONEmptyCiphertextOmitted(t *testing.T) {
+	key := pinKey(t)
+	out, err := jwe.Encrypt([]byte{}, jwe.WithJSON(), jwe.WithContentEncryption(jwa.A128GCM()), jwe.WithKey(jwa.A128KW(), key))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var obj map[string]json.RawMessage
+	if err := json.Unmarshal(out, &obj); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := obj["ciphertext"]; !ok {
+		t.Errorf("JSON serialization of an empty plaintext has no ciphertext member: %s", out)
+	}
+	if _, err := jwe.Decrypt(out, jwe.WithKey(jwa.A128KW(), key)); err != nil {
+		t.Errorf("Decrypt of jwx's own JSON serialization of an empty plaintext: %v", err)
+	}
+}
+
+// jwx/2: jwe.Parse refuses a JSON serialization with "ciphertext": "", the encoding of an empty
+// ciphertext; the compact form with an empty ciphertext segment is accepted.
+func TestHegelPinJSONEmptyCiphertextRejected(t *testing.T) {
+	key := pinKey(t)
+	compact, err := jwe.Encrypt([]byte{}, jwe.WithContentEncryption(jwa.A128GCM()), jwe.WithKey(jwa.A128KW(), key))
+	if err != nil {
+		t.Fatal(err)
+	}
+	parts := strings.Split(string(compact), ".")
+	if parts[3] != "" {
+		t.Fatalf("expected an empty ciphertext segment in %s", compact)
+	}
+	if _, err := jwe.Decrypt(compact, jwe.WithKey(jwa.A128KW(), key)); err != nil {
+		t.Fatalf("compact form with an empty ciphertext: %v", err)
+	}
+	flat, _ := json.Marshal(map[string]string{"protected": parts[0], "encrypted_key": parts[1], "iv": parts[2], "ciphertext": "", "tag": parts[4]})
+	if _, err := jwe.Parse(flat); err != nil {
+		t.Errorf("Parse of the same JWE in flattened JSON form with ciphertext \"\": %v", err)
+	}
+	if pt, err := jwe.Decrypt(flat, jwe.WithKey(jwa.A128KW(), key)); err != nil || len(pt) != 0 {
+		t.Errorf("Decrypt of the flattened form: %q, %v", pt, err)
+	}
+}
+
+// jwx/3: for a flattened JSON serialization with no "encrypted_key" member (dir, ECDH-ES),
+// Parse reports the protected header's members (minus enc) as the recipient's per-recipient
+// header; with an encrypted_key the same protected header gives an empty recipient header.
+func TestHegelPinFlattenedRecipientHeaders(t *testing.T) {
+	key := pinKey(t)
+	ph := jwe.NewHeaders()
+	ph.Set(jwe.TypeKey, "JOSE")
+	kw, err := jwe.Encrypt([]byte("hi"), jwe.WithJSON(), jwe.WithContentEncryption(jwa.A128GCM()), jwe.WithProtectedHeaders(ph), jwe.WithKey(jwa.A128KW(), key))
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir, err := jwe.Encrypt([]byte("hi"), jwe.WithJSON(), jwe.WithContentEncryption(jwa.A128GCM()), jwe.WithProtectedHeaders(ph), jwe.WithKey(jwa.DIRECT(), key))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var heads []string
+	for _, in := range [][]byte{kw, dir} {
+		msg, err := jwe.Parse(in)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(msg.Recipients()) != 1 {
+			t.Fatalf("%d recipients in %s", len(msg.Recipients()), in)
+		}
+		b, _ := json.Marshal(msg.Recipients()[0].Headers())
+		heads = append(heads, string(b))
+	}
+	if heads[0] != heads[1] {
+		t.Errorf("recipient header of the A128KW flattened form is %s, of the dir form %s: the per-recipient header is absent in both\n%s\n%s", heads[0], heads[1], kw, dir)
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..0538819
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,133 @@
+package hegel
+
+// Hegel property tests for fasthttp: generated HTTP requests, responses, URIs,
+// query strings and cookies, parsed by fasthttp and by the standard library
+// (net/http, net/url), must agree; what fasthttp writes, net/http must read as written.
+//
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
diff --git a/hegel/keys.go b/hegel/keys.go
new file mode 100644
index 0000000..b18d9b5
--- /dev/null
+++ b/hegel/keys.go
@@ -0,0 +1,162 @@
+package hegel
+
+// A fixed pool of keys of every supported type, made once per process: RSA generation is slow,
+// and the properties are about the algorithms and serialisations, not about key material.
+
+import (
+	"crypto/ecdh"
+	"crypto/ecdsa"
+	"crypto/ed25519"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"fmt"
+	"sync"
+
+	"github.com/lestrrat-go/jwx/v4/jwk"
+)
+
+type keyInfo struct {
+	name     string
+	kty      string
+	sigAlgs  []string // JWS algorithms the key can sign with
+	encAlgs  []string // JWE key-management algorithms the key can be used for
+	dirEnc   string   // for "dir": the content encryption whose CEK length the key has
+	private  jwk.Key
+	public   jwk.Key // for symmetric keys, the same as private
+	privJSON []byte
+	pubJSON  []byte
+}
+
+var (
+	keyPoolOnce sync.Once
+	keyPool     []keyInfo
+	keyByName   map[string]*keyInfo
+)
+
+func mustImport(raw interface{}, kid string) jwk.Key {
+	k, err := jwk.Import[jwk.Key](raw)
+	if err != nil {
+		panic(fmt.Sprintf("jwk.Import(%T): %v", raw, err))
+	}
+	if err := k.Set(jwk.KeyIDKey, kid); err != nil {
+		panic(err)
+	}
+	return k
+}
+
+func addKey(name, kty string, raw interface{}, sig, enc []string, dirEnc string) {
+	priv := mustImport(raw, name)
+	pub := priv
+	if kty != "oct" {
+		p, err := jwk.PublicKeyOf(priv)
+		if err != nil {
+			panic(err)
+		}
+		pub = p
+	}
+	privJSON, err := json.Marshal(priv)
+	if err != nil {
+		panic(err)
+	}
+	pubJSON, err := json.Marshal(pub)
+	if err != nil {
+		panic(err)
+	}
+	keyPool = append(keyPool, keyInfo{name: name, kty: kty, sigAlgs: sig, encAlgs: enc, dirEnc: dirEnc,
+		private: priv, public: pub, privJSON: privJSON, pubJSON: pubJSON})
+}
+
+func randBytes(n int) []byte {
+	b := make([]byte, n)
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+	return b
+}
+
+func keys() []keyInfo {
+	keyPoolOnce.Do(func() {
+		hs := []string{"HS256", "HS384", "HS512"}
+		addKey("oct16", "oct", randBytes(16), nil, []string{"A128KW", "A128GCMKW"}, "A128GCM")
+		addKey("oct24", "oct", randBytes(24), nil, []string{"A192KW", "A192GCMKW"}, "A192GCM")
+		addKey("oct32", "oct", randBytes(32), hs, []string{"A256KW", "A256GCMKW"}, "A256GCM")
+		addKey("oct32b", "oct", randBytes(32), hs, []string{"A256KW", "A256GCMKW"}, "A128CBC-HS256")
+		addKey("oct48", "oct", randBytes(48), hs, nil, "A192CBC-HS384")
+		addKey("oct64", "oct", randBytes(64), hs, nil, "A256CBC-HS512")
+		addKey("password", "oct", []byte("correct horse battery staple"), nil, []string{"PBES2-HS256+A128KW", "PBES2-HS384+A192KW", "PBES2-HS512+A256KW"}, "")
+		rs := []string{"RS256", "RS384", "RS512", "PS256", "PS384", "PS512"}
+		rsaAlgs := []string{"RSA1_5", "RSA-OAEP", "RSA-OAEP-256"}
+		for i := 0; i < 2; i++ {
+			k, err := rsa.GenerateKey(rand.Reader, 2048)
+			if err != nil {
+				panic(err)
+			}
+			addKey(fmt.Sprintf("rsa%d", i), "RSA", k, rs, rsaAlgs, "")
+		}
+		ecdhAlgs := []string{"ECDH-ES", "ECDH-ES+A128KW", "ECDH-ES+A192KW", "ECDH-ES+A256KW"}
+		for _, c := range []struct {
+			name  string
+			curve elliptic.Curve
+			alg   string
+		}{{"p256", elliptic.P256(), "ES256"}, {"p384", elliptic.P384(), "ES384"}, {"p521", elliptic.P521(), "ES512"}} {
+			k, err := ecdsa.GenerateKey(c.curve, rand.Reader)
+			if err != nil {
+				panic(err)
+			}
+			addKey(c.name, "EC", k, []string{c.alg}, ecdhAlgs, "")
+		}
+		_, ed, err := ed25519.GenerateKey(rand.Reader)
+		if err != nil {
+			panic(err)
+		}
+		addKey("ed25519", "OKP", ed, []string{"EdDSA", "Ed25519"}, nil, "")
+		x, err := ecdh.X25519().GenerateKey(rand.Reader)
+		if err != nil {
+			panic(err)
+		}
+		addKey("x25519", "OKP", x, nil, ecdhAlgs, "")
+		keyByName = map[string]*keyInfo{}
+		for i := range keyPool {
+			keyByName[keyPool[i].name] = &keyPool[i]
+		}
+	})
+	return keyPool
+}
+
+// signingKeys are the keys with at least one JWS algorithm.
+func signingKeys() []keyInfo {
+	var out []keyInfo
+	for _, k := range keys() {
+		if len(k.sigAlgs) > 0 {
+			out = append(out, k)
+		}
+	}
+	return out
+}
+
+// encryptionKeys are the keys with at least one JWE key-management algorithm (dir included).
+func encryptionKeys() []keyInfo {
+	var out []keyInfo
+	for _, k := range keys() {
+		if len(k.encAlgs) > 0 || k.dirEnc != "" {
+			out = append(out, k)
+		}
+	}
+	return out
+}
+
+// jsonWithKid returns the key's JSON with the given kid (or without one when kid is "").
+func jsonWithKid(raw []byte, kid string) []byte {
+	var m map[string]interface{}
+	if err := json.Unmarshal(raw, &m); err != nil {
+		panic(err)
+	}
+	if kid == "" {
+		delete(m, "kid")
+	} else {
+		m["kid"] = kid
+	}
+	return mustJSON(m)
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..037a8b0
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,51 @@
+package hegel
+
+// Gates for the recorded bugs (bugs.toml), by generated shape. HEGEL_NO_KNOWN=1 lifts them.
+
+import (
+	"os"
+	"strings"
+)
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// emptyCiphertext: an empty plaintext under an AEAD content encryption gives an empty ciphertext
+// (the CBC-HMAC encryptions pad, so theirs is never empty).
+func emptyCiphertext(enc string, plaintext []byte) bool {
+	return len(plaintext) == 0 && strings.HasSuffix(enc, "GCM")
+}
+
+// knownEncryptJSON: jwx/1, the JSON serialization jwx writes for an empty ciphertext has no
+// ciphertext member, so nobody (jwx included) can read it.
+func knownEncryptJSON(rcpts []recipientSpec, enc string, plaintext []byte) string {
+	if noKnown {
+		return ""
+	}
+	if emptyCiphertext(enc, plaintext) {
+		return "jwx/1"
+	}
+	return ""
+}
+
+// knownDecrypt: jwx/2, jwe.Parse refuses "ciphertext": "" in a JSON serialization.
+func knownDecrypt(enc string, plaintext []byte, useJSON bool) string {
+	if noKnown {
+		return ""
+	}
+	if useJSON && emptyCiphertext(enc, plaintext) {
+		return "jwx/2"
+	}
+	return ""
+}
+
+// knownRecipientHeaders: jwx/3, the recipient header Parse reports for a flattened JSON
+// serialization without an encrypted_key mirrors the protected header.
+func knownRecipientHeaders(rcpts []recipientSpec) string {
+	if noKnown {
+		return ""
+	}
+	if len(rcpts) == 1 && singleOnly(rcpts[0].alg) {
+		return "jwx/3"
+	}
+	return ""
+}
diff --git a/hegel/oracle.go b/hegel/oracle.go
new file mode 100644
index 0000000..fefd072
--- /dev/null
+++ b/hegel/oracle.go
@@ -0,0 +1,214 @@
+package hegel
+
+// The oracle: joserfc (Python, the JOSE implementation by the author of Authlib, on top of
+// pyca/cryptography), driven as one persistent child: a command and hex-encoded arguments per
+// line in, one JSON object per line out. Every reply has "ok"; a failure carries "error" (the
+// exception class) and "message".
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+)
+
+const pythonScript = `
+import sys, json, base64, warnings
+warnings.simplefilter("ignore")
+from joserfc import jwk, jws, jwe, jwt
+from joserfc.jwk import KeySet
+from joserfc.registry import HeaderParameter
+import joserfc._rfc7518.jwe_algs as _algs
+
+# joserfc caps the PBES2 iteration count at 300000 as a denial-of-service guard; jwx uses the
+# OWASP figure 600000. The cap is not a correctness point, so the oracle lifts it.
+_algs.PBES2HSAlgKeyEncryption.more_header_registry["p2c"] = HeaderParameter("PBES2 Count", "int", True)
+
+# The registries used to read what jwx wrote: joserfc refuses header members it does not know
+# unless told otherwise (RFC 7515 lets a producer add private members).
+def jws_reg(algs):
+    return jws.JWSRegistry(algorithms=algs, strict_check_header=False)
+
+def jwe_reg(algs):
+    return jwe.JWERegistry(algorithms=algs, strict_check_header=False)
+
+def hx(s):
+    return bytes.fromhex(s)
+
+def b64u(b):
+    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()
+
+def key_of(j):
+    return jwk.import_key(json.loads(j))
+
+def keyset_of(j):
+    return KeySet([jwk.import_key(k) for k in json.loads(j)])
+
+def members(ms):
+    return [{"protected": m.protected, "header": m.header} for m in ms]
+
+def handle(cmd, a):
+    if cmd == "T":  # thumbprint: key json, hash
+        k = key_of(a[0].decode())
+        pub = jwk.import_key(k.as_dict(private=False))
+        fields = [f for f in pub.value_registry if pub.value_registry[f].required] + ["kty"]
+        return {"thumbprint": jwk.thumbprint({f: pub.dict_value[f] for f in fields}, a[1].decode())}
+    if cmd == "K":  # import a key: its dict, private?, key type
+        k = key_of(a[0].decode())
+        return {"dict": k.as_dict(private=k.is_private), "public": k.as_dict(private=False), "private": k.is_private, "kty": k.key_type}
+    if cmd == "G":  # generate: kty, crv or size, kid
+        kty, crv = a[0].decode(), a[1].decode()
+        params = {"kid": a[2].decode()} if len(a) > 2 and a[2] else None
+        k = jwk.generate_key(kty, int(crv) if crv.isdigit() else crv, parameters=params)
+        return {"private": k.as_dict(private=True), "public": k.as_dict(private=False)}
+    if cmd == "SS":  # sign compact: protected json, payload, key json
+        return {"compact": jws.serialize_compact(json.loads(a[0]), a[1], key_of(a[2].decode()), registry=jws_reg([json.loads(a[0])["alg"]]))}
+    if cmd == "SV":  # verify compact: compact, key json, alg, [detached payload]
+        payload = a[3] if len(a) > 3 else None
+        o = jws.deserialize_compact(a[0], key_of(a[1].decode()), registry=jws_reg([a[2].decode()]), payload=payload)
+        return {"payload": b64u(o.payload), "protected": o.protected}
+    if cmd == "SJ":  # sign json: members json (dict or list), payload, keyset json, algs json
+        ms = json.loads(a[0])
+        keys = keyset_of(a[2].decode())
+        out = jws.serialize_json(ms, a[1], keys if isinstance(ms, list) or len(keys.keys) > 1 else keys.keys[0], registry=jws_reg(json.loads(a[3])))
+        return {"json": out}
+    if cmd == "VJ":  # verify json: json, keyset json, algs json
+        keys = keyset_of(a[1].decode())
+        o = jws.deserialize_json(json.loads(a[0]), keys if len(keys.keys) > 1 else keys.keys[0], registry=jws_reg(json.loads(a[2])))
+        return {"payload": b64u(o.payload), "members": members(o.members), "flattened": o.flattened}
+    if cmd == "EE":  # encrypt compact: protected json, plaintext, key json
+        p = json.loads(a[0])
+        return {"compact": jwe.encrypt_compact(p, a[1], key_of(a[2].decode()), registry=jwe_reg([p["alg"], p["enc"], "DEF"]))}
+    if cmd == "ED":  # decrypt compact: compact, key json, algs json
+        o = jwe.decrypt_compact(a[0], key_of(a[1].decode()), registry=jwe_reg(json.loads(a[2]) + ["DEF"]))
+        return {"plaintext": b64u(o.plaintext), "protected": o.protected}
+    if cmd == "EJ":  # encrypt json: protected json, plaintext, recipients json [{header, key}], aad (hex, may be empty), flattened flag, unprotected json
+        p = json.loads(a[0])
+        rec = json.loads(a[2])
+        aad = a[3] if a[3] else None
+        unprot = json.loads(a[5]) if len(a) > 5 and a[5] else None
+        cls = jwe.FlattenedJSONEncryption if a[4] == b"1" else jwe.GeneralJSONEncryption
+        obj = cls(p, a[1], unprotected=unprot, aad=aad)
+        algs = set([p.get("enc")] + ([p["alg"]] if "alg" in p else []))
+        for r in rec:
+            obj.add_recipient(r["header"], jwk.import_key(r["key"]))
+            if r["header"] and "alg" in r["header"]:
+                algs.add(r["header"]["alg"])
+        return {"json": jwe.encrypt_json(obj, None, registry=jwe_reg(list(algs) + ["DEF"]))}
+    if cmd == "DJ":  # decrypt json: json, keyset json, algs json
+        keys = keyset_of(a[1].decode())
+        o = jwe.decrypt_json(json.loads(a[0]), keys if len(keys.keys) > 1 else keys.keys[0], registry=jwe_reg(json.loads(a[2]) + ["DEF"]))
+        return {"plaintext": b64u(o.plaintext), "aad": b64u(o.aad) if o.aad else "", "protected": o.protected,
+                "unprotected": o.unprotected, "recipients": [r.header for r in o.recipients]}
+    if cmd == "JE":  # jwt encode: header json, claims json, key json
+        h = json.loads(a[0])
+        return {"token": jwt.encode(h, json.loads(a[1]), key_of(a[2].decode()), algorithms=[h["alg"]])}
+    if cmd == "JD":  # jwt decode: token, key json, alg
+        t = jwt.decode(a[0], key_of(a[1].decode()), algorithms=[a[2].decode()])
+        return {"header": t.header, "claims": t.claims}
+    if cmd == "JV":  # validate claims: claims json, now, leeway
+        reg = jwt.JWTClaimsRegistry(now=int(a[1]), leeway=int(a[2]))
+        try:
+            reg.validate(json.loads(a[0]))
+            return {"valid": True}
+        except Exception as e:
+            return {"valid": False, "error": type(e).__name__, "message": str(e)}
+    return {"error": "unknown command " + cmd}
+
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [hx(p) for p in parts[1:]]
+    try:
+        reply = handle(cmd, args)
+        reply.setdefault("ok", True)
+    except Exception as e:
+        reply = {"ok": False, "error": type(e).__name__, "message": str(e)}
+    print(json.dumps(reply), flush=True)
+`
+
+type pyChild struct {
+	mu    sync.Mutex
+	cmd   *exec.Cmd
+	stdin *bufio.Writer
+	out   *bufio.Reader
+}
+
+var (
+	pyOnce sync.Once
+	py     *pyChild
+)
+
+func oracle() *pyChild {
+	pyOnce.Do(func() {
+		python := "python3"
+		if p := os.Getenv("HEGEL_PYTHON"); p != "" {
+			python = p
+		}
+		cmd := exec.Command(python, "-u", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			panic(err)
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			panic(err)
+		}
+		if err := cmd.Start(); err != nil {
+			panic(fmt.Sprintf("python3 with joserfc is needed as the oracle: %v", err))
+		}
+		py = &pyChild{cmd: cmd, stdin: bufio.NewWriter(in), out: bufio.NewReader(out)}
+	})
+	return py
+}
+
+// reply is the common part of every oracle answer.
+type reply struct {
+	Ok      bool   `json:"ok"`
+	Error   string `json:"error"`
+	Message string `json:"message"`
+}
+
+// ask sends one request and decodes the JSON answer into v (which embeds reply).
+func ask(v interface{}, cmd string, args ...[]byte) {
+	p := oracle()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	line := cmd
+	for _, a := range args {
+		line += " " + hex.EncodeToString(a)
+	}
+	p.stdin.WriteString(line + "\n")
+	if err := p.stdin.Flush(); err != nil {
+		panic(fmt.Sprintf("joserfc oracle: %v", err))
+	}
+	raw, err := p.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("joserfc oracle exited: %v", err))
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		panic(fmt.Sprintf("joserfc oracle reply %q: %v", raw, err))
+	}
+}
+
+func s(x string) []byte { return []byte(x) }
+
+func mustJSON(v interface{}) []byte {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return b
+}
+
+// canon re-encodes JSON with sorted keys so the two sides compare as text.
+func canon(raw []byte) string {
+	var v interface{}
+	if err := json.Unmarshal(raw, &v); err != nil {
+		return "INVALID JSON: " + string(raw)
+	}
+	return string(mustJSON(v))
+}
