+// TestHegelPrefixPatternsMatchPathPrefixes: MatchPrefixPatterns(globs, target)
+// is true exactly when some path prefix of target matches one of the
+// comma-separated glob patterns (path.Match), ignoring empty patterns and
+// trailing slashes.
+func TestHegelPrefixPatternsMatchPathPrefixes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		elems := []string{"example.com", "corp.example", "x", "y", "v2", "a-b", "*", "?", "[ab]", "a*", "*.com", "", "[a-c]", "**"}
+		var globs []string
+		for i, k := 0, n(tc, 0, 3); i < k; i++ {
+			var g []string
+			for j, l := 0, n(tc, 0, 3); j < l; j++ {
+				g = append(g, pick(tc, elems...))
+			}
+			glob := strings.Join(g, "/")
+			if chance(tc, 20) {
+				glob += "/"
+			}
+			globs = append(globs, glob)
+		}
+		globList := strings.Join(globs, ",")
+		var te []string
+		for i, k := 0, n(tc, 1, 4); i < k; i++ {
+			te = append(te, pick(tc, "example.com", "corp.example", "x", "y", "v2", "a-b", "ab", "a", "b", "zz.com"))
+		}
+		target := strings.Join(te, "/")
+		note(ht, "globs=%q target=%q", globList, target)
+		want := false
+		for _, glob := range strings.Split(globList, ",") {
+			glob = strings.TrimSuffix(glob, "/")
+			if glob == "" {
+				continue
+			}
+			for i := 0; i <= len(target); i++ {
+				if i < len(target) && target[i] != '/' {
+					continue
+				}
+				if ok, err := pathMatch(glob, target[:i]); err == nil && ok {
+					want = true
+				}
+			}
+		}
+		if got := module.MatchPrefixPatterns(globList, target); got != want {
+			fail(ht, "MatchPrefixPatterns(%q, %q) = %v, want %v", globList, target, got, want)
+		}
+		if want {
+			count(ht, "match")
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..10c7847
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,141 @@
+package hegel
+
+// Hegel properties for golang.org/x/mod: semver and module against their
+// documented grammars and orders, modfile against parse/format round trips
+// and its editing API, sumdb/tlog against the Merkle tree definitions,
+// sumdb/note against its signature format, and zip against Create/Unzip
+// round trips and CheckFiles. No external tools.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing (shared with the other Go targets of the zoo).
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the gated shapes of each property so a run shows how often
+// the Known gates fire (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("PANIC in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	if lo > hi {
+		panic(fmt.Sprintf("n(%d, %d): empty range", lo, hi))
+	}
+	return hegel.Draw(tc, hegel.Integers(lo, hi))
+}
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// show renders a string with every non-ASCII or control rune escaped, so a
+// failure message can be read and replayed.
+func show(s string) string { return strconv.QuoteToASCII(s) }
diff --git a/hegel/hegel_tlog_test.go b/hegel/hegel_tlog_test.go
new file mode 100644
index 0000000..3598f44
--- /dev/null
+++ b/hegel/hegel_tlog_test.go
@@ -0,0 +1,693 @@
+package hegel
+
+// sumdb/tlog against RFC 6962's Merkle tree definitions and its own storage
+// and tile layout; sumdb/note against its signed-note format.
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	sdbnote "golang.org/x/mod/sumdb/note"
+	"golang.org/x/mod/sumdb/tlog"
+	"hegel.dev/go/hegel"
+)
+
+// memLog is an append-only log with the hash storage tlog expects.
+type memLog struct {
+	records [][]byte
+	hashes  []tlog.Hash
+}
+
+func (l *memLog) ReadHashes(indexes []int64) ([]tlog.Hash, error) {
+	out := make([]tlog.Hash, len(indexes))
+	for i, x := range indexes {
+		if x < 0 || x >= int64(len(l.hashes)) {
+			return nil, fmt.Errorf("memLog: index %d out of range (have %d hashes)", x, len(l.hashes))
+		}
+		out[i] = l.hashes[x]
+	}
+	return out, nil
+}
+
+func (l *memLog) append(ht *hegel.T, data []byte) bool {
+	n := int64(len(l.records))
+	hs, err := tlog.StoredHashes(n, data, l)
+	if err != nil {
+		fail(ht, "StoredHashes(%d): %v", n, err)
+		return false
+	}
+	l.records = append(l.records, data)
+	l.hashes = append(l.hashes, hs...)
+	return true
+}
+
+func genRecord(tc hegel.TestCase) []byte {
+	switch n(tc, 0, 4) {
+	case 0:
+		return nil
+	case 1:
+		return []byte(fmt.Sprintf("example.com/m v1.%d.0 h1:%032x\n", n(tc, 0, 99), n(tc, 0, 1<<30)))
+	default:
+		b := make([]byte, n(tc, 0, 40))
+		for i := range b {
+			b[i] = byte(n(tc, 0, 255))
+		}
+		return b
+	}
+}
+
+// modelTreeHash is RFC 6962 section 2.1: MTH({}) = SHA-256(), MTH of one
+// leaf = SHA-256(0x00 || d), MTH(D[n]) = SHA-256(0x01 || MTH(D[0:k]) ||
+// MTH(D[k:n])) with k the largest power of two smaller than n.
+func modelTreeHash(records [][]byte) [32]byte {
+	switch len(records) {
+	case 0:
+		return sha256.Sum256(nil)
+	case 1:
+		return sha256.Sum256(append([]byte{0}, records[0]...))
+	}
+	k := 1
+	for k*2 < len(records) {
+		k *= 2
+	}
+	l, r := modelTreeHash(records[:k]), modelTreeHash(records[k:])
+	return sha256.Sum256(append(append([]byte{1}, l[:]...), r[:]...))
+}
+
+// TestHegelTlogTreeHashIsTheRFC6962Tree: TreeHash over stored hashes is the
+// RFC 6962 Merkle tree hash of the records, RecordHash and NodeHash are the
+// leaf and node hashes, StoredHashCount counts the stored hashes and
+// StoredHashIndex/SplitStoredHashIndex are inverses.
+func TestHegelTlogTreeHashIsTheRFC6962Tree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		l := &memLog{}
+		total := n(tc, 0, 70)
+		if chance(tc, 10) {
+			total = n(tc, 0, 600)
+		}
+		for i := 0; i < total; i++ {
+			if !l.append(ht, genRecord(tc)) {
+				return
+			}
+			if got, want := int64(len(l.hashes)), tlog.StoredHashCount(int64(i+1)); got != want {
+				fail(ht, "after %d records %d hashes are stored, StoredHashCount says %d", i+1, got, want)
+				return
+			}
+		}
+		count(ht, fmt.Sprintf("size %d-%d", total/16*16, total/16*16+15))
+		th, err := tlog.TreeHash(int64(total), l)
+		if err != nil {
+			fail(ht, "TreeHash(%d): %v", total, err)
+			return
+		}
+		if want := modelTreeHash(l.records); th != tlog.Hash(want) {
+			fail(ht, "TreeHash(%d) = %v, RFC 6962 gives %x", total, th, want)
+		}
+		if total > 0 {
+			i := n(tc, 0, total-1)
+			if got, want := tlog.RecordHash(l.records[i]), sha256.Sum256(append([]byte{0}, l.records[i]...)); got != tlog.Hash(want) {
+				fail(ht, "RecordHash = %v, SHA-256(0x00||data) = %x", got, want)
+			}
+			if got, want := l.hashes[tlog.StoredHashIndex(0, int64(i))], tlog.RecordHash(l.records[i]); got != want {
+				fail(ht, "stored level-0 hash %d = %v, RecordHash = %v", i, got, want)
+			}
+		}
+		if total >= 2 {
+			a, b := tlog.RecordHash(l.records[0]), tlog.RecordHash(l.records[1])
+			if got, want := tlog.NodeHash(a, b), sha256.Sum256(append(append([]byte{1}, a[:]...), b[:]...)); got != tlog.Hash(want) {
+				fail(ht, "NodeHash = %v, SHA-256(0x01||l||r) = %x", got, want)
+			}
+			if got := l.hashes[tlog.StoredHashIndex(1, 0)]; got != tlog.NodeHash(a, b) {
+				fail(ht, "stored level-1 hash 0 = %v, NodeHash of the first two records = %v", got, tlog.NodeHash(a, b))
+			}
+		}
+		// Storage indexes: a bijection between (level, n) and the dense order.
+		level, idx := n(tc, 0, 20), int64(n(tc, 0, 1<<20))
+		si := tlog.StoredHashIndex(level, idx)
+		if gl, gn := tlog.SplitStoredHashIndex(si); gl != level || gn != idx {
+			fail(ht, "SplitStoredHashIndex(StoredHashIndex(%d, %d) = %d) = %d, %d", level, idx, si, gl, gn)
+		}
+		if level == 0 && idx < int64(total) {
+			// Level 0's n'th hash is written right after level 1's ... (dense): index < count.
+			if si >= tlog.StoredHashCount(idx+1) {
+				fail(ht, "StoredHashIndex(0, %d) = %d >= StoredHashCount(%d) = %d", idx, si, idx+1, tlog.StoredHashCount(idx+1))
+			}
+		}
+		// Every stored index below the count splits into a node present in the tree.
+		if total > 0 {
+			x := int64(n(tc, 0, int(tlog.StoredHashCount(int64(total)))-1))
+			lv, k := tlog.SplitStoredHashIndex(x)
+			if (k+1)<<uint(lv) > int64(total) {
+				fail(ht, "stored index %d is (level %d, n %d), which needs %d records, have %d", x, lv, k, (k+1)<<uint(lv), total)
+			}
+		}
+	})
+}
+
+// TestHegelTlogProofsVerifyAndTamperingFails: for a log of t records,
+// ProveRecord(t, n) passes CheckRecord with the tree hash and the record's
+// hash and fails with any other record, index or tree hash; ProveTree(t, n)
+// passes CheckTree with the two tree hashes and fails with a different
+// earlier hash; the same holds when the hashes come through TileHashReader.
+func TestHegelTlogProofsVerifyAndTamperingFails(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		l := &memLog{}
+		total := n(tc, 1, 80)
+		if chance(tc, 10) {
+			total = n(tc, 1, 700)
+		}
+		for i := 0; i < total; i++ {
+			if !l.append(ht, genRecord(tc)) {
+				return
+			}
+		}
+		T := int64(total)
+		th, err := tlog.TreeHash(T, l)
+		if err != nil {
+			fail(ht, "TreeHash(%d): %v", T, err)
+			return
+		}
+		// Record proof.
+		i := int64(n(tc, 0, total-1))
+		p, err := tlog.ProveRecord(T, i, l)
+		if err != nil {
+			fail(ht, "ProveRecord(%d, %d): %v", T, i, err)
+			return
+		}
+		h := tlog.RecordHash(l.records[i])
+		if err := tlog.CheckRecord(p, T, th, i, h); err != nil {
+			fail(ht, "CheckRecord(ProveRecord(%d, %d)): %v", T, i, err)
+		}
+		if want := 0; T > 1 {
+			// A proof has one hash per level: ceil(log2 T) at most, and at least 1.
+			want = 1
+			if len(p) < want || len(p) > 64 {
+				fail(ht, "ProveRecord(%d, %d) has %d hashes", T, i, len(p))
+			}
+		}
+		// Tampering: another record's hash, another index, another tree hash, a changed proof.
+		bad := h
+		bad[n(tc, 0, 31)] ^= byte(n(tc, 1, 255))
+		if err := tlog.CheckRecord(p, T, th, i, bad); err == nil {
+			fail(ht, "CheckRecord accepted a changed record hash (t=%d n=%d)", T, i)
+		}
+		if T > 1 {
+			j := int64(n(tc, 0, total-1))
+			if j != i && !bytes.Equal(l.records[j], l.records[i]) { // equal records share a hash, and the proof
+				if err := tlog.CheckRecord(p, T, th, j, h); err == nil {
+					fail(ht, "CheckRecord accepted record %d's proof for index %d (t=%d)", i, j, T)
+				}
+				count(ht, "other index rejected")
+			}
+		}
+		badTH := th
+		badTH[n(tc, 0, 31)] ^= byte(n(tc, 1, 255))
+		if err := tlog.CheckRecord(p, T, badTH, i, h); err == nil {
+			fail(ht, "CheckRecord accepted a changed tree hash (t=%d n=%d)", T, i)
+		}
+		if len(p) > 0 {
+			q := append(tlog.RecordProof(nil), p...)
+			q[n(tc, 0, len(q)-1)][n(tc, 0, 31)] ^= byte(n(tc, 1, 255))
+			if err := tlog.CheckRecord(q, T, th, i, h); err == nil {
+				fail(ht, "CheckRecord accepted a changed proof (t=%d n=%d)", T, i)
+			}
+			if err := tlog.CheckRecord(q[:len(q)-1], T, th, i, h); err == nil {
+				fail(ht, "CheckRecord accepted a truncated proof (t=%d n=%d)", T, i)
+			}
+		}
+		if err := tlog.CheckRecord(p, T, th, T, h); err == nil {
+			fail(ht, "CheckRecord accepted n = t")
+		}
+		// Tree (consistency) proof.
+		m := int64(n(tc, 1, total))
+		hm, err := tlog.TreeHash(m, l)
+		if err != nil {
+			fail(ht, "TreeHash(%d): %v", m, err)
+			return
+		}
+		tp, err := tlog.ProveTree(T, m, l)
+		if err != nil {
+			fail(ht, "ProveTree(%d, %d): %v", T, m, err)
+			return
+		}
+		if err := tlog.CheckTree(tp, T, th, m, hm); err != nil {
+			fail(ht, "CheckTree(ProveTree(%d, %d)): %v", T, m, err)
+		}
+		if m == T {
+			count(ht, "tree proof of itself")
+			if len(tp) != 0 {
+				count(ht, "nonempty proof for n = t")
+			}
+		}
+		badHM := hm
+		badHM[n(tc, 0, 31)] ^= byte(n(tc, 1, 255))
+		if err := tlog.CheckTree(tp, T, th, m, badHM); err == nil {
+			fail(ht, "CheckTree accepted a changed earlier tree hash (t=%d n=%d)", T, m)
+		}
+		if err := tlog.CheckTree(tp, T, badTH, m, hm); err == nil {
+			fail(ht, "CheckTree accepted a changed tree hash (t=%d n=%d)", T, m)
+		}
+		if m < T {
+			// The proof for a different earlier size does not verify (unless the hashes coincide).
+			m2 := int64(n(tc, 1, total))
+			if m2 != m {
+				hm2, _ := tlog.TreeHash(m2, l)
+				if err := tlog.CheckTree(tp, T, th, m2, hm2); err == nil {
+					fail(ht, "CheckTree accepted the proof for size %d as one for size %d (t=%d)", m, m2, T)
+				}
+			}
+		}
+		// The same through tiles.
+		hgt := n(tc, 1, 4)
+		tree := tlog.Tree{N: T, Hash: th}
+		tr := tlog.TileHashReader(tree, &memTiles{h: hgt, l: l})
+		th2, err := tlog.TreeHash(T, tr)
+		if err != nil || th2 != th {
+			fail(ht, "TreeHash through tiles of height %d = %v, %v; direct %v", hgt, th2, err, th)
+		}
+		p2, err := tlog.ProveRecord(T, i, tr)
+		if err != nil {
+			fail(ht, "ProveRecord(%d, %d) through tiles of height %d: %v", T, i, hgt, err)
+		} else if fmt.Sprint(p2) != fmt.Sprint(p) {
+			fail(ht, "ProveRecord through tiles differs from the direct proof (t=%d n=%d h=%d)", T, i, hgt)
+		}
+		tp2, err := tlog.ProveTree(T, m, tr)
+		if err != nil {
+			fail(ht, "ProveTree(%d, %d) through tiles of height %d: %v", T, m, hgt, err)
+		} else if fmt.Sprint(tp2) != fmt.Sprint(tp) {
+			fail(ht, "ProveTree through tiles differs from the direct proof (t=%d n=%d h=%d)", T, m, hgt)
+		}
+		// A tile reader serving a wrong hash is caught by TileHashReader.
+		evil := &memTiles{h: hgt, l: l, corrupt: true}
+		tr2 := tlog.TileHashReader(tree, evil)
+		if _, err := tlog.ProveRecord(T, i, tr2); err == nil && evil.corrupted {
+			fail(ht, "TileHashReader accepted a corrupted tile (t=%d n=%d h=%d)", T, i, hgt)
+		}
+		if evil.corrupted {
+			count(ht, "corrupt tile rejected")
+		}
+	})
+}
+
+// memTiles serves tiles from a memLog.
+type memTiles struct {
+	h         int
+	l         *memLog
+	corrupt   bool
+	corrupted bool
+	saved     int
+}
+
+func (m *memTiles) Height() int { return m.h }
+func (m *memTiles) ReadTiles(tiles []tlog.Tile) ([][]byte, error) {
+	out := make([][]byte, len(tiles))
+	for i, t := range tiles {
+		d, err := tlog.ReadTileData(t, m.l)
+		if err != nil {
+			return nil, err
+		}
+		if m.corrupt && len(d) > 0 && !m.corrupted {
+			d = append([]byte(nil), d...)
+			d[len(d)/2] ^= 0x55
+			m.corrupted = true
+		}
+		out[i] = d
+	}
+	return out, nil
+}
+func (m *memTiles) SaveTiles(tiles []tlog.Tile, data [][]byte) { m.saved += len(tiles) }
+
+// TestHegelTlogTilesRoundTrip: TileForIndex gives the least tile holding a
+// stored hash, HashFromTile reads it back from ReadTileData, Tile.Path and
+// ParseTilePath are inverses, and NewTiles(h, 0, n) covers every stored
+// hash of a tree of size n; NewTiles(h, n, n) is empty.
+func TestHegelTlogTilesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		h := n(tc, 1, 5)
+		l := &memLog{}
+		total := n(tc, 1, 120)
+		for i := 0; i < total; i++ {
+			if !l.append(ht, genRecord(tc)) {
+				return
+			}
+		}
+		cnt := tlog.StoredHashCount(int64(total))
+		idx := int64(n(tc, 0, int(cnt)-1))
+		tile := tlog.TileForIndex(h, idx)
+		note(ht, "h=%d total=%d idx=%d tile=%+v", h, total, idx, tile)
+		if tile.H != h || tile.W < 1 || tile.W > 1<<uint(h) || tile.L < 0 || tile.N < 0 {
+			fail(ht, "TileForIndex(%d, %d) = %+v out of range", h, idx, tile)
+			return
+		}
+		lv, _ := tlog.SplitStoredHashIndex(idx)
+		// The tile at level L = lv/h, N = k >> (h*(L+1)-lv)... simpler: the
+		// tile's leaves are at tree level h*L and the index lies in its subtree.
+		if lv/h != tile.L {
+			fail(ht, "TileForIndex(%d, %d) = %+v, but the hash is at tree level %d (tile level %d)", h, idx, tile, lv, lv/h)
+		}
+		if tile.W%2 != 0 && tile.W != 1 {
+			count(ht, "odd width")
+		}
+		data, err := tlog.ReadTileData(tile, l)
+		if err != nil {
+			fail(ht, "ReadTileData(%+v): %v", tile, err)
+			return
+		}
+		if len(data) != tile.W*tlog.HashSize {
+			fail(ht, "ReadTileData(%+v) has %d bytes, want W*HashSize = %d", tile, len(data), tile.W*tlog.HashSize)
+		}
+		got, err := tlog.HashFromTile(tile, data, idx)
+		if err != nil || got != l.hashes[idx] {
+			fail(ht, "HashFromTile(%+v, idx %d) = %v, %v; stored %v", tile, idx, got, err, l.hashes[idx])
+		}
+		// Path round trip, including partial tiles and the data level.
+		for _, tt := range []tlog.Tile{tile, {H: h, L: -1, N: tile.N, W: tile.W}, {H: h, L: n(tc, 0, 63), N: int64(n(tc, 0, 1<<40)), W: n(tc, 1, 1<<uint(h))}} {
+			path := tt.Path()
+			back, err := tlog.ParseTilePath(path)
+			if err != nil || back != tt {
+				fail(ht, "ParseTilePath(%+v.Path() = %q) = %+v, %v", tt, path, back, err)
+			}
+			if !strings.HasPrefix(path, "tile/"+strconv.Itoa(h)+"/") {
+				fail(ht, "%+v.Path() = %q", tt, path)
+			}
+			if tt.L == -1 && !strings.HasPrefix(path, "tile/"+strconv.Itoa(h)+"/data/") {
+				fail(ht, "data tile %+v.Path() = %q, want tile/%d/data/...", tt, path, h)
+			}
+			if tt.W < 1<<uint(h) && !strings.Contains(path, ".p/"+strconv.Itoa(tt.W)) {
+				fail(ht, "partial tile %+v.Path() = %q lacks .p/W", tt, path)
+			}
+			if tt.W == 1<<uint(h) && strings.Contains(path, ".p/") {
+				fail(ht, "complete tile %+v.Path() = %q has .p/", tt, path)
+			}
+		}
+		// NewTiles from zero covers the storage; from the same size is empty.
+		tiles := tlog.NewTiles(h, 0, int64(total))
+		if len(tlog.NewTiles(h, int64(total), int64(total))) != 0 {
+			fail(ht, "NewTiles(%d, %d, %d) is not empty", h, total, total)
+		}
+		covered := func(want tlog.Tile) bool {
+			for _, tt := range tiles {
+				if tt.H == want.H && tt.L == want.L && tt.N == want.N && tt.W >= want.W {
+					return true
+				}
+			}
+			return false
+		}
+		for x := int64(0); x < cnt; x++ {
+			if !covered(tlog.TileForIndex(h, x)) {
+				fail(ht, "NewTiles(%d, 0, %d) = %v does not cover stored hash %d (tile %+v)", h, total, tiles, x, tlog.TileForIndex(h, x))
+				break
+			}
+		}
+		// Incremental publishing: tiles from old to total, plus tiles up to old, cover the storage too.
+		old := int64(n(tc, 0, total))
+		inc := append(tlog.NewTiles(h, 0, old), tlog.NewTiles(h, old, int64(total))...)
+		tiles = inc
+		for x := int64(0); x < cnt; x++ {
+			if !covered(tlog.TileForIndex(h, x)) {
+				fail(ht, "NewTiles(%d, 0, %d) + NewTiles(%d, %d, %d) does not cover stored hash %d", h, old, h, old, total, x)
+				break
+			}
+		}
+		if old > 0 && old < int64(total) {
+			count(ht, "incremental")
+		}
+	})
+}
