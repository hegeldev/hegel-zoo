+package hegel
+
+// modfile: the editing API against a model of the file's content, and
+// Parse/Format as a round trip with Format a fixed point.
+
+import (
+	"bytes"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+
+	"golang.org/x/mod/modfile"
+	"golang.org/x/mod/module"
+	"hegel.dev/go/hegel"
+)
+
+// summary lists a File's content as sorted lines, one per directive.
+func summary(f *modfile.File) string {
+	var lines []string
+	if f.Module != nil {
+		lines = append(lines, "module "+f.Module.Mod.Path)
+		if f.Module.Deprecated != "" {
+			lines = append(lines, "deprecated "+f.Module.Deprecated)
+		}
+	}
+	if f.Go != nil {
+		lines = append(lines, "go "+f.Go.Version)
+	}
+	if f.Toolchain != nil {
+		lines = append(lines, "toolchain "+f.Toolchain.Name)
+	}
+	for _, g := range f.Godebug {
+		lines = append(lines, "godebug "+g.Key+"="+g.Value)
+	}
+	for _, r := range f.Require {
+		lines = append(lines, fmt.Sprintf("require %s %s indirect=%v", r.Mod.Path, r.Mod.Version, r.Indirect))
+	}
+	for _, x := range f.Exclude {
+		lines = append(lines, "exclude "+x.Mod.Path+" "+x.Mod.Version)
+	}
+	for _, r := range f.Replace {
+		lines = append(lines, fmt.Sprintf("replace %s %s => %s %s", r.Old.Path, r.Old.Version, r.New.Path, r.New.Version))
+	}
+	for _, r := range f.Retract {
+		lines = append(lines, fmt.Sprintf("retract [%s, %s] %q", r.Low, r.High, r.Rationale))
+	}
+	for _, t := range f.Tool {
+		lines = append(lines, "tool "+t.Path)
+	}
+	for _, i := range f.Ignore {
+		lines = append(lines, "ignore "+i.Path)
+	}
+	sort.Strings(lines)
+	return strings.Join(lines, "\n")
+}
+
+// replEntry is one replace line: what f.Replace says its Old is, what the
+// text says, and the target. They differ only in the buggy view (mod/10).
+type replEntry struct{ structOld, textOld, new module.Version }
+
+// applyAddReplace is AddReplace's semantics: the first existing replacement
+// of old (of that version, or of any version for a version-less old) is
+// rewritten to the new line, the other matching ones are deleted, and a
+// line is added when none matched. In the correct view the rewritten
+// entry's Old follows the line; the buggy one keeps its version.
+func applyAddReplace(list []replEntry, old, ov string, nw module.Version, correct bool) []replEntry {
+	var out []replEntry
+	need := true
+	for _, e := range list {
+		if e.structOld.Path == old && (ov == "" || e.structOld.Version == ov) {
+			if need {
+				need = false
+				e.new = nw
+				e.textOld = module.Version{Path: old, Version: ov}
+				if correct {
+					e.structOld = e.textOld
+				}
+				out = append(out, e)
+			}
+			continue
+		}
+		out = append(out, e)
+	}
+	if need {
+		o := module.Version{Path: old, Version: ov}
+		out = append(out, replEntry{o, o, nw})
+	}
+	return out
+}
+
+func applyDropReplace(list []replEntry, old, ov string) []replEntry {
+	var out []replEntry
+	for _, e := range list {
+		if e.structOld != (module.Version{Path: old, Version: ov}) {
+			out = append(out, e)
+		}
+	}
+	return out
+}
+
+// modelFile is the content a sequence of edits should leave behind.
+type modelFile struct {
+	added     []modfile.Retract // retracts added through AddRetract (Known bug mod/3)
+	module    string
+	goVersion string
+	toolchain string
+	godebug   map[string]string
+	require   []*modfile.Require // duplicates allowed
+	exclude   map[module.Version]bool
+	repl      []replEntry // correct view
+	replBuggy []replEntry // f.Replace with stale versions (Known bug mod/10)
+	retract   []modfile.Retract
+	tool      map[string]bool
+	ignore    map[string]bool
+}
+
+// summaryWith renders the model: retractMode 0 is the correct content, 1
+// the struct with no AddRetract'ed retract, 2 the file with every added one
+// (mod/3); buggyReplace uses the stale replace list, text its line view.
+func (m *modelFile) summaryWith(retractMode int, buggyReplace, text bool) string {
+	f := &modfile.File{Module: &modfile.Module{Mod: module.Version{Path: m.module}}}
+	list := m.repl
+	if buggyReplace {
+		list = m.replBuggy
+	}
+	for _, e := range list {
+		o := e.structOld
+		if text {
+			o = e.textOld
+		}
+		f.Replace = append(f.Replace, &modfile.Replace{Old: o, New: e.new})
+	}
+	retract := m.retract
+	switch retractMode {
+	case 1:
+		retract = nil
+	case 2:
+		retract = m.added
+	}
+	for _, r := range retract {
+		r := r
+		f.Retract = append(f.Retract, &r)
+	}
+	if m.goVersion != "" {
+		f.Go = &modfile.Go{Version: m.goVersion}
+	}
+	if m.toolchain != "" {
+		f.Toolchain = &modfile.Toolchain{Name: m.toolchain}
+	}
+	for k, v := range m.godebug {
+		f.Godebug = append(f.Godebug, &modfile.Godebug{Key: k, Value: v})
+	}
+	for _, r := range m.require {
+		f.Require = append(f.Require, &modfile.Require{Mod: r.Mod, Indirect: r.Indirect})
+	}
+	for x := range m.exclude {
+		f.Exclude = append(f.Exclude, &modfile.Exclude{Mod: x})
+	}
+	for t := range m.tool {
+		f.Tool = append(f.Tool, &modfile.Tool{Path: t})
+	}
+	for i := range m.ignore {
+		f.Ignore = append(f.Ignore, &modfile.Ignore{Path: i})
+	}
+	return summary(f)
+}
+
+// ---------------------------------------------------------------------------
+// Modules
+
+type verKind int
+
+const (
+	release verKind = iota
+	pseudo
+	prerelease
+)
+
+// moduleSpec: a module path and a version whose majors agree: one of six
+// bases, a major 0 to 3 (a /vN suffix from 2 on, or +incompatible one time
+// in five), and a release five times in seven, else a pseudo-version or a
+// prerelease.
+type moduleSpec struct {
+	base         string
+	major        int
+	incompatible bool
+	kind         verKind
+	minor, patch int
+	pre          string
+}
+
+func (m moduleSpec) path() string {
+	if m.major >= 2 && !m.incompatible {
+		return fmt.Sprintf("%s/v%d", m.base, m.major)
+	}
+	return m.base
+}
+
+func (m moduleSpec) version() string {
+	if m.major >= 2 && m.incompatible {
+		return fmt.Sprintf("v%d.%d.%d+incompatible", m.major, m.minor, m.patch)
+	}
+	switch m.kind {
+	case pseudo:
+		return fmt.Sprintf("v%d.0.0-2020010%d000000-abcdef12345%d", m.major, m.minor, m.patch)
+	case prerelease:
+		return fmt.Sprintf("v%d.%d.%d-%s", m.major, m.minor, m.patch, m.pre)
+	}
+	return fmt.Sprintf("v%d.%d.%d", m.major, m.minor, m.patch)
+}
+
+func (m moduleSpec) mod() module.Version { return module.Version{Path: m.path(), Version: m.version()} }
+
+func (m moduleSpec) String() string { return m.path() + " " + m.version() }
+
+var modules = hegel.Composite(func(tc hegel.TestCase) moduleSpec {
+	return moduleSpec{
+		base:         hegel.Draw(tc, hegel.SampledFrom([]string{"example.com/a", "example.com/b", "golang.org/x/text", "rsc.io/quote", "example.com/Upper", "example.com/c"})),
+		major:        hegel.Draw(tc, hegel.Integers(0, 3)),
+		incompatible: hegel.Draw(tc, chance(20)),
+		kind:         hegel.Draw(tc, hegel.SampledFrom([]verKind{release, release, release, release, release, pseudo, prerelease})),
+		minor:        hegel.Draw(tc, hegel.Integers(0, 9)),
+		patch:        hegel.Draw(tc, hegel.Integers(0, 9)),
+		pre:          hegel.Draw(tc, hegel.SampledFrom([]string{"rc1", "alpha", "pre.1", "0.20200101000000-abcdef123456"})),
+	}
+})
+
+var (
+	moduleVersions = hegel.Map(modules, moduleSpec.version)
+	importPaths    = hegel.SampledFrom([]string{"example.com/a/cmd/x", "golang.org/x/tools/cmd/stringer", "example.com/b/v2/tool", "rsc.io/quote", "example.com/c"})
+	// rationales: empty 40% of the time, else one to four words.
+	rationales = maybe(60, joined(many(hegel.SampledFrom([]string{"security", "issue", "broken", "build", "accidental", "tag", "see", "https://example.com/issue/1", "v1.0.0", "bad"}), 1, 4), " "))
+)
+
+// ---------------------------------------------------------------------------
+// Edits
+
+// edit is one step of an editing script. A step that names an entry of the
+// live model does so by an index taken modulo the entries' number when it
+// is applied (ref), so every drawn step fits the state and the shrinker can
+// delete steps freely.
+type edit interface{ String() string }
+
+// ref: the at-th live entry (modulo their number), or a fresh module when
+// fresh (30%) or the model has no entry.
+type ref struct {
+	at    int
+	fresh bool
+	mod   moduleSpec
+}
+
+// index is the live entry to use among n, if any.
+func (r ref) index(n int) (int, bool) {
+	if r.fresh || n == 0 {
+		return 0, false
+	}
+	return r.at % n, true
+}
+
+func (r ref) String() string {
+	if r.fresh {
+		return r.mod.String()
+	}
+	return fmt.Sprintf("#%d", r.at)
+}
+
+var refs = hegel.Composite(func(tc hegel.TestCase) ref {
+	return ref{at: hegel.Draw(tc, hegel.Integers(0, 99)), fresh: hegel.Draw(tc, chance(30)), mod: hegel.Draw(tc, modules)}
+})
+
+type (
+	addRequire    struct{ mod moduleSpec }
+	addNewRequire struct {
+		mod      moduleSpec
+		indirect bool
+	}
+	dropRequire struct{ ref ref }
+	requirement struct {
+		mod      moduleSpec
+		indirect bool
+	}
+	setRequire struct{ reqs []requirement } // a repeated path keeps its first entry
+	addExclude struct {
+		mod  moduleSpec
+		trim bool // the version without ".0" and "+incompatible": may be non-canonical
+	}
+	dropExclude struct{ ref ref }
+	addReplace  struct {
+		old        moduleSpec
+		reuse      bool // old's path is that of the at-th replacement when there is one
+		at         int
+		anyVersion bool // old without a version
+		new        module.Version
+	}
+	dropReplace struct {
+		ref        ref
+		anyVersion bool // a fresh old without a version
+	}
+	addRetract struct {
+		low       moduleSpec
+		high      *moduleSpec // nil: a single version
+		rationale string
+	}
+	dropRetract struct{ at int } // a no-op without retracts
+	addTool     struct{ path string }
+	dropTool    struct{ path string }
+	addIgnore   struct{ path string }
+	dropIgnore  struct{ path string }
+	addGodebug  struct{ key, value string }
+	dropGodebug struct{ key string }
+	addGoStmt   struct {
+		version string
+		drop    bool // dropped again right after
+	}
+	addToolchainStmt struct {
+		name string
+		drop bool
+	}
+	sortBlocks struct{}
+	cleanup    struct{}
+)
+
+func (e addRequire) String() string { return fmt.Sprintf("AddRequire(%v)", e.mod) }
+func (e addNewRequire) String() string {
+	return fmt.Sprintf("AddNewRequire(%v, %v)", e.mod, e.indirect)
+}
+func (e dropRequire) String() string { return fmt.Sprintf("DropRequire(%v)", e.ref) }
+func (e setRequire) String() string  { return fmt.Sprintf("SetRequire(%v)", e.reqs) }
+func (e requirement) String() string { return fmt.Sprintf("%v indirect=%v", e.mod, e.indirect) }
+func (e addExclude) String() string  { return fmt.Sprintf("AddExclude(%v, trim=%v)", e.mod, e.trim) }
+func (e dropExclude) String() string { return fmt.Sprintf("DropExclude(%v)", e.ref) }
+func (e addReplace) String() string {
+	return fmt.Sprintf("AddReplace(%v, reuse=%v at=%d, anyVersion=%v => %v)", e.old, e.reuse, e.at, e.anyVersion, e.new)
+}
+func (e dropReplace) String() string {
+	return fmt.Sprintf("DropReplace(%v, anyVersion=%v)", e.ref, e.anyVersion)
+}
+func (e addRetract) String() string {
+	if e.high == nil {
+		return fmt.Sprintf("AddRetract(%s, %q)", e.low.version(), e.rationale)
+	}
+	return fmt.Sprintf("AddRetract([%s, %s], %q)", e.low.version(), e.high.version(), e.rationale)
+}
+func (e dropRetract) String() string { return fmt.Sprintf("DropRetract(#%d)", e.at) }
+func (e addTool) String() string     { return "AddTool(" + e.path + ")" }
+func (e dropTool) String() string    { return "DropTool(" + e.path + ")" }
+func (e addIgnore) String() string   { return "AddIgnore(" + e.path + ")" }
+func (e dropIgnore) String() string  { return "DropIgnore(" + e.path + ")" }
+func (e addGodebug) String() string  { return "AddGodebug(" + e.key + "=" + e.value + ")" }
+func (e dropGodebug) String() string { return "DropGodebug(" + e.key + ")" }
+func (e addGoStmt) String() string   { return fmt.Sprintf("AddGoStmt(%s, drop=%v)", e.version, e.drop) }
+func (e addToolchainStmt) String() string {
+	return fmt.Sprintf("AddToolchainStmt(%s, drop=%v)", e.name, e.drop)
+}
+func (sortBlocks) String() string { return "SortBlocks" }
+func (cleanup) String() string    { return "Cleanup" }
+
+var (
+	requirements = hegel.Composite(func(tc hegel.TestCase) requirement {
+		return requirement{mod: hegel.Draw(tc, modules), indirect: hegel.Draw(tc, chance(40))}
+	})
+	// replaceNews: the new side of a replace: a local directory, or a module.
+	replaceNews = hegel.OneOf(
+		hegel.Map(hegel.SampledFrom([]string{"../other", "./local", "/abs/path", "../a b"}), func(p string) module.Version { return module.Version{Path: p} }),
+		hegel.Map(modules, moduleSpec.mod),
+	)
+	godebugKeys = hegel.SampledFrom([]string{"panicnil", "http2client", "gotypesalias"})
+	ignorePaths = hegel.SampledFrom([]string{"./testdata", "./gen", "./a/b", "vendor"})
+)
+
+// edits: the steps of a script, weighted as the old script's die: the
+// adds of requires, excludes, replaces and retracts twice, the rest once,
+// SortBlocks, Cleanup and SetRequire half each (SetRequire after a drop
+// ends the script, Known bug mod/4); an ignore path that needs quoting
+// (Known bug mod/8) is one AddIgnore in twenty.
+var edits = weighted(
+	choice[edit]{4, hegel.Map(modules, func(m moduleSpec) edit { return addRequire{m} })},
+	choice[edit]{2, hegel.Composite(func(tc hegel.TestCase) edit {
+		return addNewRequire{mod: hegel.Draw(tc, modules), indirect: hegel.Draw(tc, chance(50))}
+	})},
+	choice[edit]{2, hegel.Map(refs, func(r ref) edit { return dropRequire{r} })},
+	choice[edit]{1, hegel.Map(many(requirements, 0, 4), func(rs []requirement) edit { return setRequire{rs} })},
+	choice[edit]{4, hegel.Composite(func(tc hegel.TestCase) edit {
+		return addExclude{mod: hegel.Draw(tc, modules), trim: hegel.Draw(tc, chance(10))}
+	})},
+	choice[edit]{2, hegel.Map(refs, func(r ref) edit { return dropExclude{r} })},
+	choice[edit]{4, hegel.Composite(func(tc hegel.TestCase) edit {
+		return addReplace{
+			old:        hegel.Draw(tc, modules),
+			reuse:      hegel.Draw(tc, chance(40)),
+			at:         hegel.Draw(tc, hegel.Integers(0, 99)),
+			anyVersion: hegel.Draw(tc, chance(30)),
+			new:        hegel.Draw(tc, replaceNews),
+		}
+	})},
+	choice[edit]{2, hegel.Composite(func(tc hegel.TestCase) edit {
+		return dropReplace{ref: hegel.Draw(tc, refs), anyVersion: hegel.Draw(tc, chance(30))}
+	})},
+	choice[edit]{4, hegel.Composite(func(tc hegel.TestCase) edit {
+		return addRetract{low: hegel.Draw(tc, modules), high: hegel.Draw(tc, optional(40, modules)), rationale: hegel.Draw(tc, rationales)}
+	})},
+	choice[edit]{2, hegel.Map(hegel.Integers(0, 99), func(at int) edit { return dropRetract{at} })},
+	choice[edit]{2, hegel.Map(importPaths, func(p string) edit { return addTool{p} })},
+	choice[edit]{2, hegel.Map(importPaths, func(p string) edit { return dropTool{p} })},
+	choice[edit]{2, hegel.Map(weighted(choice[string]{19, ignorePaths}, choice[string]{1, lit("./x y")}), func(p string) edit { return addIgnore{p} })},
+	choice[edit]{2, hegel.Map(ignorePaths, func(p string) edit { return dropIgnore{p} })},
+	choice[edit]{2, hegel.Map(pairs(godebugKeys, hegel.SampledFrom([]string{"0", "1", "off"})), func(p pair[string, string]) edit { return addGodebug{p.a, p.b} })},
+	choice[edit]{2, hegel.Map(godebugKeys, func(k string) edit { return dropGodebug{k} })},
+	choice[edit]{2, hegel.Map(pairs(hegel.SampledFrom([]string{"1.21", "1.22.0", "1.23rc1", "1.9", "1.0", "2.1.3"}), chance(20)), func(p pair[string, bool]) edit { return addGoStmt{p.a, p.b} })},
+	choice[edit]{2, hegel.Map(pairs(hegel.SampledFrom([]string{"go1.21.0", "go1.22rc1", "default", "go1.99"}), chance(20)), func(p pair[string, bool]) edit { return addToolchainStmt{p.a, p.b} })},
+	choice[edit]{1, hegel.Just[edit](sortBlocks{})},
+	choice[edit]{1, hegel.Just[edit](cleanup{})},
+)
+
+// editCase: the module path of the initial go.mod and one to fourteen edits.
+type editCase struct {
+	modPath string
+	edits   []edit
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c editCase) GoString() string {
+	lines := []string{"module " + c.modPath}
+	for _, e := range c.edits {
+		lines = append(lines, e.String())
+	}
+	return strings.Join(lines, "\n")
+}
+
+var editCases = hegel.Composite(func(tc hegel.TestCase) editCase {
+	return editCase{
+		modPath: hegel.Draw(tc, hegel.SampledFrom([]string{"example.com/m", "example.com/m/v2", "m.example"})),
+		edits:   hegel.Draw(tc, many(edits, 1, 14)),
+	}
+})
+
+// TestHegelModfileEditsMatchTheModel: a sequence of Add*/Drop*/Set* edits,
+// then Cleanup, leaves the File - and the file Format writes and Parse reads
+// back - with exactly the content the documented semantics of the edits
+// give; Format is a fixed point and SortBlocks keeps the content.
+func TestHegelModfileEditsMatchTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, editCases)
+		modPath := c.modPath
+		f, err := modfile.Parse("go.mod", []byte("module "+modPath+"\n"), nil)
+		if err != nil {
+			ht.Fatalf("Parse(module %s): %v", modPath, err)
+		}
+		m := &modelFile{module: modPath, godebug: map[string]string{}, exclude: map[module.Version]bool{},
+			tool: map[string]bool{}, ignore: map[string]bool{}}
+		var ops []string
+		dirty := false          // a require was cleared (DropRequire, duplicates) and Cleanup not yet called
+		unquotedIgnore := false // an ignore path that needs quoting was added (Known bug mod/8)
+		droppedIgnore := false  // an ignore was dropped (Known bug mod/9)
+		droppedTool := false    // a tool was dropped (Known bug mod/9)
+		for _, e := range c.edits {
+			switch e := e.(type) {
+			case addRequire:
+				p, v := e.mod.path(), e.mod.version()
+				ops = append(ops, fmt.Sprintf("AddRequire(%s, %s)", p, v))
+				if err := f.AddRequire(p, v); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				found := false
+				var keep []*modfile.Require
+				for _, r := range m.require {
+					if r.Mod.Path != p {
+						keep = append(keep, r)
+					} else if !found {
+						found = true
+						keep = append(keep, &modfile.Require{Mod: module.Version{Path: p, Version: v}, Indirect: r.Indirect})
+					} else {
+						dirty = true
+					}
+				}
+				if !found {
+					keep = append(keep, &modfile.Require{Mod: module.Version{Path: p, Version: v}})
+				}
+				m.require = keep
+			case addNewRequire:
+				p, v := e.mod.path(), e.mod.version()
+				ops = append(ops, fmt.Sprintf("AddNewRequire(%s, %s, %v)", p, v, e.indirect))
+				f.AddNewRequire(p, v, e.indirect)
+				m.require = append(m.require, &modfile.Require{Mod: module.Version{Path: p, Version: v}, Indirect: e.indirect})
+			case dropRequire:
+				p := e.ref.mod.path()
+				if i, ok := e.ref.index(len(m.require)); ok {
+					p = m.require[i].Mod.Path
+				}
+				ops = append(ops, fmt.Sprintf("DropRequire(%s)", p))
+				if err := f.DropRequire(p); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				var keep []*modfile.Require
+				for _, r := range m.require {
+					if r.Mod.Path != p {
+						keep = append(keep, r)
+					} else {
+						dirty = true
+					}
+				}
+				m.require = keep
+			case setRequire:
+				var req []*modfile.Require
+				seen := map[string]bool{}
+				for _, r := range e.reqs {
+					p := r.mod.path()
+					if seen[p] {
+						continue
+					}
+					seen[p] = true
+					req = append(req, &modfile.Require{Mod: r.mod.mod(), Indirect: r.indirect})
+				}
+				ops = append(ops, fmt.Sprintf("SetRequire(%d)", len(req)))
+				panicked := func() (r any) {
+					defer func() { r = recover() }()
+					f.SetRequire(req)
+					return nil
+				}()
+				if panicked != nil {
+					// Known bug mod/4: SetRequire dereferences the nil Syntax of a
+					// require cleared by an earlier DropRequire/SetRequire.
+					if Known.SetRequireAfterDrop && dirty {
+						count(ht, "mod/4 SetRequire panics after a drop")
+						return
+					}
+					ht.Fatalf("%s after %v panicked: %v", ops[len(ops)-1], ops[:len(ops)-1], panicked)
+				}
+				for _, r := range m.require {
+					if _, ok := seen[r.Mod.Path]; !ok {
+						dirty = true // removed by SetRequire
+					}
+				}
+				m.require = nil
+				for _, r := range req {
+					m.require = append(m.require, &modfile.Require{Mod: r.Mod, Indirect: r.Indirect})
+				}
+			case addExclude:
+				p, v := e.mod.path(), e.mod.version()
+				if e.trim {
+					v = strings.TrimSuffix(strings.TrimSuffix(v, ".0"), "+incompatible") // may be non-canonical
+				}
+				ops = append(ops, fmt.Sprintf("AddExclude(%s, %s)", p, v))
+				err := f.AddExclude(p, v)
+				if module.CanonicalVersion(v) != v || module.Check(p, v) != nil {
+					if err == nil {
+						ht.Fatalf("%s accepted a non-canonical or mismatched version", ops[len(ops)-1])
+					}
+					count(ht, "exclude rejected")
+					continue
+				}
+				if err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.exclude[module.Version{Path: p, Version: v}] = true
+			case dropExclude:
+				x := e.ref.mod.mod()
+				if i, ok := e.ref.index(len(m.exclude)); ok {
+					var xs []module.Version
+					for x := range m.exclude {
+						xs = append(xs, x)
+					}
+					sort.Slice(xs, func(i, j int) bool { return xs[i].String() < xs[j].String() })
+					x = xs[i]
+				}
+				ops = append(ops, fmt.Sprintf("DropExclude(%s, %s)", x.Path, x.Version))
+				if err := f.DropExclude(x.Path, x.Version); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				delete(m.exclude, x)
+			case addReplace:
+				op, ov := e.old.path(), e.old.version()
+				if e.reuse && len(m.repl) > 0 {
+					op = m.repl[e.at%len(m.repl)].textOld.Path // another replacement of a replaced path
+					if module.Check(op, ov) != nil {
+						ov = "" // the drawn version is of another major
+					}
+				}
+				if e.anyVersion {
+					ov = ""
+				}
+				np, nv := e.new.Path, e.new.Version
+				ops = append(ops, fmt.Sprintf("AddReplace(%s, %s, %s, %s)", op, ov, np, nv))
+				if err := f.AddReplace(op, ov, np, nv); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.repl = applyAddReplace(m.repl, op, ov, module.Version{Path: np, Version: nv}, true)
+				m.replBuggy = applyAddReplace(m.replBuggy, op, ov, module.Version{Path: np, Version: nv}, false)
+			case dropReplace:
+				o := e.ref.mod.mod()
+				if e.anyVersion {
+					o.Version = ""
+				}
+				if i, ok := e.ref.index(len(m.repl)); ok {
+					o = m.repl[i].textOld
+				}
+				ops = append(ops, fmt.Sprintf("DropReplace(%s, %s)", o.Path, o.Version))
+				if err := f.DropReplace(o.Path, o.Version); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.repl = applyDropReplace(m.repl, o.Path, o.Version)
+				m.replBuggy = applyDropReplace(m.replBuggy, o.Path, o.Version)
+			case addRetract:
+				lo := e.low.version()
+				hi := lo
+				if e.high != nil {
+					hi = e.high.version()
+				}
+				rationale := e.rationale
+				vi := modfile.VersionInterval{Low: lo, High: hi}
+				ops = append(ops, fmt.Sprintf("AddRetract(%v, %q)", vi, rationale))
+				err := f.AddRetract(vi, rationale)
+				// The versions must be canonical and of the module's own major.
+				_, modMajor, _ := module.SplitPathVersion(modPath)
+				bad := false
+				for _, v := range []string{lo, hi} {
+					if module.CanonicalVersion(v) != v || module.CheckPathMajor(v, modMajor) != nil {
+						bad = true
+					}
+				}
+				if bad {
+					if err == nil {
+						ht.Fatalf("%s accepted a version of another major or a non-canonical one", ops[len(ops)-1])
+					}
+					count(ht, "retract rejected")
+					continue
+				}
+				if err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.retract = append(m.retract, modfile.Retract{VersionInterval: vi, Rationale: rationale})
+				m.added = append(m.added, modfile.Retract{VersionInterval: vi, Rationale: rationale})
+			case dropRetract:
+				if len(m.retract) == 0 {
+					continue
+				}
+				vi := m.retract[e.at%len(m.retract)].VersionInterval
+				ops = append(ops, fmt.Sprintf("DropRetract(%v)", vi))
+				if err := f.DropRetract(vi); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				var keep []modfile.Retract
+				for _, r := range m.retract {
+					if r.VersionInterval != vi {
+						keep = append(keep, r)
+					}
+				}
+				m.retract = keep
+			case addTool:
+				ops = append(ops, "AddTool("+e.path+")")
+				if err := f.AddTool(e.path); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.tool[e.path] = true
+			case dropTool:
+				ops = append(ops, "DropTool("+e.path+")")
+				if err := f.DropTool(e.path); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				if m.tool[e.path] {
+					droppedTool = true
+				}
+				delete(m.tool, e.path)
+			case addIgnore:
+				ops = append(ops, "AddIgnore("+e.path+")")
+				if err := f.AddIgnore(e.path); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.ignore[e.path] = true
+				if modfile.MustQuote(e.path) {
+					unquotedIgnore = true
+				}
+			case dropIgnore:
+				ops = append(ops, "DropIgnore("+e.path+")")
+				if err := f.DropIgnore(e.path); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				if m.ignore[e.path] {
+					droppedIgnore = true
+				}
+				delete(m.ignore, e.path)
+			case addGodebug:
+				ops = append(ops, "AddGodebug("+e.key+"="+e.value+")")
+				if err := f.AddGodebug(e.key, e.value); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.godebug[e.key] = e.value
+			case dropGodebug:
+				ops = append(ops, "DropGodebug("+e.key+")")
+				if err := f.DropGodebug(e.key); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				delete(m.godebug, e.key)
+			case addGoStmt:
+				ops = append(ops, "AddGoStmt("+e.version+")")
+				if err := f.AddGoStmt(e.version); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.goVersion = e.version
+				if e.drop {
+					ops = append(ops, "DropGoStmt")
+					f.DropGoStmt()
+					m.goVersion = ""
+				}
+			case addToolchainStmt:
+				ops = append(ops, "AddToolchainStmt("+e.name+")")
+				if err := f.AddToolchainStmt(e.name); err != nil {
+					ht.Fatalf("%s: %v", ops[len(ops)-1], err)
+				}
+				m.toolchain = e.name
+				if e.drop {
+					ops = append(ops, "DropToolchainStmt")
+					f.DropToolchainStmt()
+					m.toolchain = ""
+				}
+			case sortBlocks:
+				ops = append(ops, "SortBlocks")
+				f.SortBlocks()
+			case cleanup:
+				ops = append(ops, "Cleanup")
+				f.Cleanup()
+				dirty = false
+			}
+		}
+		note(ht, "ops=%v", ops)
+		f.Cleanup()
+		want := m.summaryWith(0, false, false)
+		got := summary(f)
+		if Known.CleanupKeepsIgnores && (droppedIgnore || droppedTool) {
+			// Known bug mod/9: Cleanup does not drop cleared tool and ignore
+			// entries, which stay in f.Tool/f.Ignore with an empty path.
+			stripped := strings.ReplaceAll(strings.ReplaceAll("\n"+got, "\nignore \n", "\n"), "\ntool \n", "\n")
+			stripped = strings.ReplaceAll(strings.ReplaceAll(stripped, "\nignore \n", "\n"), "\ntool \n", "\n")
+			stripped = strings.TrimSuffix(strings.TrimSuffix(strings.TrimSuffix(stripped, "\nignore "), "\ntool "), "\nignore ")
+			stripped = strings.TrimPrefix(stripped, "\n")
+			if stripped != got {
+				count(ht, "mod/9 Cleanup keeps dropped tools and ignores")
+				got = stripped
+			}
+		}
+		if got != want {
+			switch {
+			case Known.AddRetractNotRecorded && len(m.added) > 0 && got == m.summaryWith(1, false, false):
+				count(ht, "mod/3 AddRetract not in f.Retract")
+			case Known.ReplaceWildcardKeepsVersion && got == m.summaryWith(0, true, false):
+				count(ht, "mod/10 stale replace version in f.Replace")
+			case Known.AddRetractNotRecorded && Known.ReplaceWildcardKeepsVersion && len(m.added) > 0 && got == m.summaryWith(1, true, false):
+				count(ht, "mod/3 AddRetract not in f.Retract")
+				count(ht, "mod/10 stale replace version in f.Replace")
+			default:
+				ht.Fatalf("after %v and Cleanup the File has\n%s\nthe edits' semantics give\n%s", ops, got, want)
+			}
+		}
+		data, err := f.Format()
+		if err != nil {
+			ht.Fatalf("Format after %v: %v", ops, err)
+		}
+		note(ht, "go.mod:\n%s", data)
+		f2, err := modfile.Parse("go.mod", data, nil)
+		if err != nil {
+			if Known.AddIgnoreUnquoted && unquotedIgnore && strings.Contains(err.Error(), "ignore directive expects exactly one argument") {
+				// Known bug mod/8: AddIgnore writes the path without quoting it.
+				count(ht, "mod/8 unquoted ignore path")
+				return
+			}
+			ht.Fatalf("Parse(Format) after %v: %v\n%s", ops, err, data)
+		}
+		if got := summary(f2); got != want {
+			// The file keeps every retract AddRetract wrote (mod/3), and its
+			// replace lines follow the stale struct's drops (mod/10).
+			switch {
+			case Known.AddRetractNotRecorded && len(m.added) > 0 && got == m.summaryWith(2, false, true):
+				count(ht, "mod/3 dropped retract stays in the file")
+				want = got
+			case Known.ReplaceWildcardKeepsVersion && got == m.summaryWith(0, true, true):
+				count(ht, "mod/10 replace lines follow the stale struct")
+				want = got
+			case Known.AddRetractNotRecorded && Known.ReplaceWildcardKeepsVersion && len(m.added) > 0 && got == m.summaryWith(2, true, true):
+				count(ht, "mod/3 dropped retract stays in the file")
+				count(ht, "mod/10 replace lines follow the stale struct")
+				want = got
+			default:
+				ht.Fatalf("Parse(Format) after %v reads\n%s\nwant\n%s\n--- go.mod:\n%s", ops, got, want, data)
+			}
+		}
+		data2, _ := f2.Format()
+		if !bytes.Equal(data2, data) {
+			ht.Fatalf("Format(Parse(Format)) differs after %v:\n%s\n--- vs ---\n%s", ops, data2, data)
+		}
+		f2.SortBlocks()
+		data3, _ := f2.Format()
+		f3, err := modfile.Parse("go.mod", data3, nil)
+		if err != nil {
+			ht.Fatalf("Parse after SortBlocks: %v\n%s", err, data3)
+		}
+		if got := summary(f3); got != want {
+			ht.Fatalf("SortBlocks changed the content after %v:\n%s\nwant\n%s", ops, got, want)
+		}
+		if len(m.require) > 1 {
+			count(ht, "several requires")
+		}
+		if len(m.retract) > 0 {
+			count(ht, "retract")
+		}
+		if len(m.repl) > 0 {
+			count(ht, "replace")
+		}
+		if len(m.repl) != len(m.replBuggy) {
+			count(ht, "mod/10 shape")
+		}
+		if bytes.Contains(data, []byte("(")) {
+			count(ht, "block")
+		}
+		if bytes.Contains(data, []byte(`"`)) {
+			count(ht, "quoted")
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Text round trips
+
+// noise: the formatting freedom around one directive line or block item: a
+// blank line before it (15%), a comment line before it (10%), the whitespace
+// after the verb, a trailing comment (25%), the line ending, and the
+// indentation inside a block.
+type noise struct {
+	blank, pre               bool
+	ws, comment, eol, indent string
+}
+
+var (
+	wss      = hegel.SampledFrom([]string{" ", " ", "\t", "  ", " \t "})
+	comments = maybe(25, cat(wss, lit("//"), hegel.SampledFrom([]string{" a comment", "", " TODO", " indirect?", "x"})))
+	noises   = hegel.Composite(func(tc hegel.TestCase) noise {
+		return noise{
+			blank:   hegel.Draw(tc, chance(15)),
+			pre:     hegel.Draw(tc, chance(10)),
+			ws:      hegel.Draw(tc, wss),
+			comment: hegel.Draw(tc, comments),
+			eol:     hegel.Draw(tc, hegel.SampledFrom([]string{"\n", "\n", "\r\n"})),
+			indent:  hegel.Draw(tc, hegel.SampledFrom([]string{"\t", "  ", ""})),
+		}
+	})
+)
+
+// line writes s as a directive line of its own, with the noise around it.
+func (n noise) line(sb *strings.Builder, s string) {
+	if n.blank {
+		sb.WriteString("\n")
+	}
+	if n.pre {
+		sb.WriteString("// leading comment\n")
+	}
+	sb.WriteString(s + n.comment + n.eol)
+}
+
+// item: a directive's arguments with their noise.
+type item struct {
+	text string
+	n    noise
+}
+
+func items(texts hegel.Generator[string]) hegel.Generator[item] {
+	return hegel.Map(pairs(texts, noises), func(p pair[string, noise]) item { return item{p.a, p.b} })
+}
+
+// block: the items of one verb; a single item is written as a line of its
+// own 60% of the time and any number 20% (the die), else as a
+// parenthesised block with its own header noise.
+type block struct {
+	verb  string
+	die   int
+	head  noise
+	items []item
+}
+
+func blocks(verb string, texts hegel.Generator[string], most int) hegel.Generator[block] {
+	its := many(items(texts), 0, most)
+	return hegel.Composite(func(tc hegel.TestCase) block {
+		return block{verb: verb, die: hegel.Draw(tc, hegel.Integers(0, 99)), head: hegel.Draw(tc, noises), items: hegel.Draw(tc, its)}
+	})
+}
+
+func (b block) write(sb *strings.Builder) {
+	if len(b.items) == 0 {
+		return
+	}
+	if len(b.items) == 1 && b.die >= 40 || b.die >= 80 {
+		for _, it := range b.items {
+			it.n.line(sb, b.verb+it.n.ws+it.text)
+		}
+		return
+	}
+	sb.WriteString(b.verb + b.head.ws + "(" + b.head.comment + "\n")
+	for _, it := range b.items {
+		if it.n.blank {
+			sb.WriteString("\n")
+		}
+		if it.n.pre {
+			sb.WriteString("\t// about the next line\n")
+		}
+		sb.WriteString(it.n.indent + it.text + it.n.comment + "\n")
+	}
+	sb.WriteString(")\n")
+}
+
+// quotable is s, or s in double quotes.
+func quotable(s string) hegel.Generator[string] { return hegel.SampledFrom([]string{s, `"` + s + `"`}) }
+
+var (
+	requireTexts = hegel.FlatMap(modules, func(m moduleSpec) hegel.Generator[string] {
+		return cat(quotable(m.path()), wss, lit(m.version()), maybe(30, cat(wss, lit("// indirect"))))
+	})
+	excludeTexts = hegel.FlatMap(modules, func(m moduleSpec) hegel.Generator[string] {
+		return cat(lit(m.path()), wss, lit(m.version()))
+	})
+	// replaceNewTexts: the new side of a replace line: a module and its
+	// version, or a directory 40% of the time.
+	replaceNewTexts = weighted(
+		choice[string]{6, excludeTexts},
+		choice[string]{4, hegel.SampledFrom([]string{"../other", "./local", `"../a b"`, "/abs"})},
+	)
+	replaceTexts = hegel.FlatMap(modules, func(m moduleSpec) hegel.Generator[string] {
+		return cat(lit(m.path()), maybe(60, cat(wss, lit(m.version()))), wss, lit("=>"), wss, replaceNewTexts)
+	})
+	// retractTexts: a version, or an interval 40% of the time, with the
+	// rationale as a comment when there is one.
+	retractTexts = hegel.FlatMap(modules, func(m moduleSpec) hegel.Generator[string] {
+		lo := m.version()
+		return cat(
+			weighted(choice[string]{6, lit(lo)}, choice[string]{4, cat(lit("["+lo+","), wss, moduleVersions, lit("]"))}),
+			hegel.Map(rationales, func(r string) string {
+				if r == "" {
+					return ""
+				}
+				return " // " + r
+			}),
+		)
+	})
+	ignoreTexts    = hegel.SampledFrom([]string{"./testdata", "./gen", "vendor", `"./x y"`})
+	godebugTexts   = cat(hegel.SampledFrom([]string{"panicnil", "http2client"}), lit("="), hegel.SampledFrom([]string{"0", "1"}))
+	moduleItems    = items(hegel.FlatMap(hegel.SampledFrom([]string{"example.com/m", "example.com/m/v2", "m.example", "gopkg.in/m.v3"}), quotable))
+	goItems        = items(hegel.SampledFrom([]string{"1.21", "1.22.0", "1.23rc1", "1.12"}))
+	toolchainItems = items(hegel.SampledFrom([]string{"go1.21.0", "default", "go1.22rc1"}))
+	requireBlocks  = blocks("require", requireTexts, 4)
+	excludeBlocks  = blocks("exclude", excludeTexts, 2)
+	replaceBlocks  = blocks("replace", replaceTexts, 2)
+	retractBlocks  = blocks("retract", retractTexts, 2)
+	toolBlocks     = blocks("tool", importPaths, 2)
+	ignoreBlocks   = blocks("ignore", ignoreTexts, 2)
+	godebugBlocks  = blocks("godebug", godebugTexts, 2)
+)
+
+// goMod: a go.mod as drawn: a deprecation comment 15% of the time, the
+// module line (its path quoted half of the time), a go line 80%, a
+// toolchain line 30%, and the blocks of the other directives.
+type goMod struct {
+	deprecated bool
+	module     item
+	goLine     *item
+	toolchain  *item
+	blocks     []block
+}
+
+func (g goMod) render() string {
+	var sb strings.Builder
+	if g.deprecated {
+		sb.WriteString("// Deprecated: use example.com/n instead\n")
+	}
+	g.module.n.line(&sb, "module"+g.module.n.ws+g.module.text)
+	if g.goLine != nil {
+		g.goLine.n.line(&sb, "go"+g.goLine.n.ws+g.goLine.text)
+	}
+	if g.toolchain != nil {
+		g.toolchain.n.line(&sb, "toolchain"+g.toolchain.n.ws+g.toolchain.text)
+	}
+	for _, b := range g.blocks {
+		b.write(&sb)
+	}
+	return sb.String()
+}
+
+// goModTexts: go.mod texts with formatting noise.
+var goModTexts = hegel.Map(hegel.Composite(func(tc hegel.TestCase) goMod {
+	return goMod{
+		deprecated: hegel.Draw(tc, chance(15)),
+		module:     hegel.Draw(tc, moduleItems),
+		goLine:     hegel.Draw(tc, optional(80, goItems)),
+		toolchain:  hegel.Draw(tc, optional(30, toolchainItems)),
+		blocks: []block{
+			hegel.Draw(tc, requireBlocks),
+			hegel.Draw(tc, excludeBlocks),
+			hegel.Draw(tc, replaceBlocks),
+			hegel.Draw(tc, retractBlocks),
+			hegel.Draw(tc, toolBlocks),
+			hegel.Draw(tc, ignoreBlocks),
+			hegel.Draw(tc, godebugBlocks),
+		},
+	}
+}), goMod.render)
+
+// TestHegelModfileParseFormatRoundTrips: a go.mod written with formatting
+// noise parses; Format of the result parses to the same content and is a
+// fixed point of Parse+Format; ParseLax reads the same content; ModulePath
+// finds the module path; an unknown directive fails Parse but not ParseLax.
+func TestHegelModfileParseFormatRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		text := hegel.Draw(ht, goModTexts)
+		f, err := modfile.Parse("go.mod", []byte(text), nil)
+		if err != nil {
+			ht.Fatalf("Parse: %v\n%s", err, text)
+		}
+		want := summary(f)
+		data, _ := f.Format()
+		f2, err := modfile.Parse("go.mod", data, nil)
+		if err != nil {
+			ht.Fatalf("Parse(Format): %v\n--- original:\n%s\n--- formatted:\n%s", err, text, data)
+		}
+		if got := summary(f2); got != want {
+			ht.Fatalf("Parse(Format) reads\n%s\nwant\n%s\n--- original:\n%s\n--- formatted:\n%s", got, want, text, data)
+		}
+		data2, _ := f2.Format()
+		if !bytes.Equal(data2, data) {
+			ht.Fatalf("Format is not a fixed point:\n%s\n--- second:\n%s", data, data2)
+		}
+		lax, err := modfile.ParseLax("go.mod", []byte(text), nil)
+		if err != nil {
+			ht.Fatalf("ParseLax: %v\n%s", err, text)
+		}
+		// ParseLax keeps module, go, require, retract and ignore (the statements
+		// that matter for a dependency; toolchain, godebug, exclude, replace and
+		// tool are the main module's business); compare those.
+		strip := func(f *modfile.File) string {
+			g := *f
+			g.Exclude, g.Replace, g.Tool, g.Godebug, g.Toolchain = nil, nil, nil, nil, nil
+			return summary(&g)
+		}
+		if got, w := strip(lax), strip(f); got != w {
+			ht.Fatalf("ParseLax reads\n%s\nParse reads\n%s\n%s", got, w, text)
+		}
+		if got := modfile.ModulePath([]byte(text)); got != f.Module.Mod.Path {
+			ht.Fatalf("ModulePath = %q, Parse says %q\n%s", got, f.Module.Mod.Path, text)
+		}
+		unknown := text + "\nfrobnicate x y\n"
+		if _, err := modfile.Parse("go.mod", []byte(unknown), nil); err == nil {
+			ht.Fatalf("Parse accepted an unknown directive\n%s", unknown)
+		}
+		if _, err := modfile.ParseLax("go.mod", []byte(unknown), nil); err != nil {
+			ht.Fatalf("ParseLax rejected an unknown directive: %v\n%s", err, unknown)
+		}
+		if f.Module.Deprecated != "" {
+			count(ht, "deprecated")
+		}
+		if len(f.Retract) > 0 {
+			count(ht, "retract")
+		}
+		if len(f.Replace) > 0 {
+			count(ht, "replace")
+		}
+		if strings.Contains(text, "(") {
+			count(ht, "block")
+		}
+		if strings.Contains(text, "\r\n") {
+			count(ht, "crlf")
+		}
+	})
+}
+
+// mustQuoteModel: the lexer's single-token condition. A space, quote or
+// backquote, a bracket or comma in a longer token, a non-printable rune,
+// the empty string, or a comment opener needs quoting.
+func mustQuoteModel(s string) bool {
+	if s == "" || strings.Contains(s, "//") || strings.Contains(s, "/*") {
+		return true
+	}
+	for _, r := range s {
+		switch {
+		case strings.ContainsRune(" \"'`", r):
+			return true
+		case strings.ContainsRune("()[]{},", r) && len(s) > 1:
+			return true
+		case !unicode.IsPrint(r):
+			return true
+		}
+	}
+	return false
+}
+
+// quoteWords: up to eight pieces of token characters, whitespace, quotes,
+// brackets and the arrow.
+var quoteWords = joined(many(hegel.SampledFrom([]string{"a", "b", "/", "/", "*", ".", "-", "_", "~", "1", "x", "\u00e9", " ", "\t", `"`, `\`, "'", "(", ")", "=>", "[", ","}), 0, 8), "")
+
+// TestHegelModfileQuotingRoundTrips: AutoQuote(s) is s unless MustQuote(s),
+// and a directive written with AutoQuote parses back to s; MustQuote is
+// exactly the documented condition (empty, or containing // or /*).
+func TestHegelModfileQuotingRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, quoteWords)
+		q := modfile.AutoQuote(s)
+		if must := mustQuoteModel(s); modfile.MustQuote(s) != must {
+			ht.Fatalf("MustQuote(%s) = %v, want %v", show(s), !must, must)
+		}
+		if !modfile.MustQuote(s) && q != s {
+			ht.Fatalf("AutoQuote(%s) = %s though MustQuote is false", show(s), show(q))
+		}
+		if modfile.MustQuote(s) {
+			count(ht, "quoted")
+		}
+		// The quoted form always carries s through a directive; AutoQuote's
+		// form does when it is a single token. A word holding "=>" or a lone
+		// bracket or comma is not one, though MustQuote is false for it
+		// (convention), so only its quoted form is parsed.
+		unquotable := strings.ContainsAny(s, " \t\"'`\\()[],") || s == "" || strings.Contains(s, "=>")
+		for _, tok := range []string{q, strconv.Quote(s)} {
+			if tok == s && unquotable {
+				count(ht, "unquotable word")
+				continue
+			}
+			text := "module m\nignore " + tok + "\n"
+			f, err := modfile.Parse("go.mod", []byte(text), nil)
+			if err != nil {
+				ht.Fatalf("Parse(ignore %s): %v", show(tok), err)
+			}
+			if len(f.Ignore) != 1 || f.Ignore[0].Path != s {
+				ht.Fatalf("Parse(ignore %s) read %v, want %s", show(tok), f.Ignore, show(s))
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..97b7b01
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,186 @@
+package hegel
+
+// One plain test per recorded bug (bugs.toml), asserting the correct
+// behaviour so that it fails while the bug exists; listed as expected
+// failures in target.toml.
+
+import (
+	"crypto/rand"
+	"strings"
+	"testing"
+
+	"golang.org/x/mod/modfile"
+	"golang.org/x/mod/module"
+	sdbnote "golang.org/x/mod/sumdb/note"
+	"golang.org/x/mod/sumdb/tlog"
+)
+
+// mod/1
+func TestHegelPinImportPathRejectsTwoDotsInARow(t *testing.T) {
+	for _, p := range []string{"example.com/a..b", "example.com/x/..y"} {
+		if err := module.CheckImportPath(p); err == nil {
+			t.Errorf("CheckImportPath(%q) = nil; the doc says an element must not contain two dots in a row", p)
+		}
+		if err := module.CheckPath(p); err == nil {
+			t.Errorf("CheckPath(%q) = nil", p)
+		}
+	}
+}
+
+// mod/2
+func TestHegelPinEscapeVersionOfAValidFileName(t *testing.T) {
+	v := "v1.0.0-café"
+	if err := module.CheckFilePath(v); err != nil {
+		t.Fatalf("CheckFilePath(%q) = %v: the premise of this pin", v, err)
+	}
+	esc, err := module.EscapeVersion(v)
+	if err != nil {
+		t.Fatalf("EscapeVersion(%q) = %v for a valid file name without exclamation marks", v, err)
+	}
+	if back, err := module.UnescapeVersion(esc); err != nil || back != v {
+		t.Errorf("UnescapeVersion(%q) = %q, %v; want %q", esc, back, err, v)
+	}
+}
+
+// mod/3
+func TestHegelPinAddRetractRecordsTheRetract(t *testing.T) {
+	f, err := modfile.Parse("go.mod", []byte("module example.com/m\n"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	vi := modfile.VersionInterval{Low: "v1.0.0", High: "v1.0.0"}
+	if err := f.AddRetract(vi, "bad"); err != nil {
+		t.Fatal(err)
+	}
+	if len(f.Retract) != 1 {
+		t.Errorf("after AddRetract f.Retract has %d entries, want 1", len(f.Retract))
+	}
+	if err := f.DropRetract(vi); err != nil {
+		t.Fatal(err)
+	}
+	f.Cleanup()
+	data, _ := f.Format()
+	if strings.Contains(string(data), "retract") {
+		t.Errorf("after AddRetract, DropRetract and Cleanup the file still has the retract:\n%s", data)
+	}
+}
+
+// mod/4
+func TestHegelPinSetRequireAfterDropRequire(t *testing.T) {
+	f, err := modfile.Parse("go.mod", []byte("module example.com/m\n\nrequire example.com/a v1.0.0\n"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.DropRequire("example.com/a"); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("SetRequire after DropRequire (no Cleanup in between) panicked: %v", r)
+		}
+	}()
+	f.SetRequire([]*modfile.Require{{Mod: module.Version{Path: "example.com/b", Version: "v1.0.0"}}})
+	f.Cleanup()
+	if len(f.Require) != 1 || f.Require[0].Mod.Path != "example.com/b" {
+		t.Errorf("after SetRequire the requirements are %v, want example.com/b only", f.Require)
+	}
+}
+
+// mod/5
+func TestHegelPinGenerateKeyRejectsInvalidNames(t *testing.T) {
+	for _, name := range []string{"", "a b", "a+b"} {
+		skey, vkey, err := sdbnote.GenerateKey(rand.Reader, name)
+		if err == nil {
+			t.Errorf("GenerateKey(%q) = %q, %q, nil; the doc says a name is non-empty and has no spaces or plus signs", name, skey, vkey)
+		}
+	}
+}
+
+// mod/6
+func TestHegelPinSignRejectsControlCharactersAndBadUTF8(t *testing.T) {
+	skey, _, err := sdbnote.GenerateKey(rand.Reader, "srv")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := sdbnote.NewSigner(skey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, text := range []string{"a\tb\n", "\r\n", "\xff\n"} {
+		msg, err := sdbnote.Sign(&sdbnote.Note{Text: text}, s)
+		if err == nil {
+			t.Errorf("Sign(%q) = %q, nil; the doc says notes have no control characters below U+0020 but newline and are valid UTF-8 (Open calls this message malformed)", text, msg)
+		}
+	}
+}
+
+// mod/7
+func TestHegelPinFormatRecordRejectsALeadingBlankLine(t *testing.T) {
+	for _, text := range []string{"\n", "\nexample.com/m v1.0.0 h1:x\n"} {
+		if msg, err := tlog.FormatRecord(1, []byte(text)); err == nil {
+			t.Errorf("FormatRecord(1, %q) = %q, nil; the doc says record text must not contain any blank lines", text, msg)
+		}
+	}
+}
+
+// mod/8
+func TestHegelPinAddIgnoreQuotesThePath(t *testing.T) {
+	f, err := modfile.Parse("go.mod", []byte("module example.com/m\n"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.AddIgnore("./x y"); err != nil {
+		t.Fatal(err)
+	}
+	data, _ := f.Format()
+	g, err := modfile.Parse("go.mod", data, nil)
+	if err != nil {
+		t.Fatalf("Parse(Format) after AddIgnore(./x y): %v\n%s", err, data)
+	}
+	if len(g.Ignore) != 1 || g.Ignore[0].Path != "./x y" {
+		t.Errorf("after AddIgnore(./x y) the file reads back %v", g.Ignore)
+	}
+}
+
+// mod/9
+func TestHegelPinCleanupDropsToolsAndIgnores(t *testing.T) {
+	f, err := modfile.Parse("go.mod", []byte("module example.com/m\n\ntool example.com/t\n\nignore ./x\n"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.DropTool("example.com/t"); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.DropIgnore("./x"); err != nil {
+		t.Fatal(err)
+	}
+	f.Cleanup()
+	if len(f.Tool) != 0 || len(f.Ignore) != 0 {
+		t.Errorf("after DropTool, DropIgnore and Cleanup: %d tools, %d ignores, want none", len(f.Tool), len(f.Ignore))
+	}
+}
+
+// mod/10
+func TestHegelPinWildcardReplaceUpdatesTheOldVersion(t *testing.T) {
+	f, err := modfile.Parse("go.mod", []byte("module example.com/m\n"), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.AddReplace("example.com/c", "v0.3.1", "/abs/path", ""); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.AddReplace("example.com/c", "", "example.com/b", "v1.1.0"); err != nil {
+		t.Fatal(err)
+	}
+	if len(f.Replace) != 1 || f.Replace[0].Old.Version != "" {
+		t.Errorf("after a version-less AddReplace over a versioned one f.Replace is %v, want one entry with Old.Version empty as the line says", f.Replace)
+	}
+	if err := f.DropReplace("example.com/c", ""); err != nil {
+		t.Fatal(err)
+	}
+	f.Cleanup()
+	data, _ := f.Format()
+	if strings.Contains(string(data), "replace") {
+		t.Errorf("DropReplace(example.com/c, \"\") left the replace line:\n%s", data)
+	}
+}
diff --git a/hegel/hegel_semver_test.go b/hegel/hegel_semver_test.go
new file mode 100644
index 0000000..3d95045
--- /dev/null
+++ b/hegel/hegel_semver_test.go
@@ -0,0 +1,1192 @@
+package hegel
+
+// semver and module against the grammars and orders their documentation
+// states: the version grammar and Semantic Versioning 2.0.0 precedence, the
+// path rules of CheckPath/CheckImportPath/CheckFilePath, the escaping round
+// trips, pseudo-versions and Sort.
+
+import (
+	"fmt"
+	"path"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"golang.org/x/mod/module"
+	"golang.org/x/mod/semver"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Version generator and model
+
+const identChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-"
+
+var digits = dec(hegel.Integers(0, 9))
+
+// numbers: a decimal number, small four times in five, else with a leading
+// zero (invalid) or very large.
+var numbers = weighted(
+	choice[string]{8, dec(hegel.Integers(0, 20))},
+	choice[string]{1, cat(lit("0"), digits)},
+	choice[string]{1, dec(hegel.Integers(0, 99999999999))},
+)
+
+// idents: a prerelease or build identifier: one to four identifier
+// characters two times in three, else empty (invalid), a number, a numeric
+// one with a leading zero and a letter, or a word.
+var idents = weighted(
+	choice[string]{8, alphabet(identChars, 1, 4)},
+	choice[string]{1, hegel.Just("")},
+	choice[string]{1, numbers},
+	choice[string]{1, cat(lit("0"), digits, hegel.SampledFrom([]string{"a", "-", "A"}))},
+	choice[string]{1, hegel.SampledFrom([]string{"alpha", "beta", "rc", "pre", "SNAPSHOT", "x", "-", "0-0"})},
+)
+
+// identLists: one to three identifiers joined with dots.
+var identLists = joined(many(idents, 1, 3), ".")
+
+// damage: one byte of a version replaced: where (modulo its length) and by
+// what.
+type damage struct {
+	at int
+	ch string
+}
+
+var damages = hegel.Composite(func(tc hegel.TestCase) damage {
+	return damage{
+		at: hegel.Draw(tc, hegel.Integers(0, 99)),
+		ch: hegel.Draw(tc, hegel.SampledFrom([]string{".", "-", "+", " ", "_", "/", "v", "\x00", "\u00e9", "9"})),
+	}
+})
+
+// versionSpec: a version as drawn: its prefix ("v" mostly), one to three
+// numbers (three in 72% of cases, as prerelease and build need them), a
+// prerelease 40% of the time, a build 25%, and a damaged byte 8%.
+type versionSpec struct {
+	prefix string
+	nums   []string
+	pre    string // with the dash, or ""
+	build  string // with the plus, or ""
+	dmg    *damage
+}
+
+func (v versionSpec) render() string {
+	s := v.prefix + strings.Join(v.nums, ".") + v.pre + v.build
+	if v.dmg != nil {
+		i := v.dmg.at % len(s)
+		s = s[:i] + v.dmg.ch + s[i+1:]
+	}
+	return s
+}
+
+var (
+	prefixes    = hegel.SampledFrom([]string{"v", "v", "v", "v", "v", "v", "v", "", "V", "vv", " v"})
+	numberLists = weighted(choice[[]string]{15, fixed(numbers, 1)}, choice[[]string]{13, fixed(numbers, 2)}, choice[[]string]{72, fixed(numbers, 3)})
+	prereleases = maybe(40, cat(lit("-"), identLists))
+	builds      = maybe(25, cat(lit("+"), identLists))
+	damaged     = optional(8, damages)
+)
+
+// versions: mostly valid versions and near misses.
+var versions = hegel.Map(hegel.Composite(func(tc hegel.TestCase) versionSpec {
+	return versionSpec{
+		prefix: hegel.Draw(tc, prefixes),
+		nums:   hegel.Draw(tc, numberLists),
+		pre:    hegel.Draw(tc, prereleases),
+		build:  hegel.Draw(tc, builds),
+		dmg:    hegel.Draw(tc, damaged),
+	}
+}), versionSpec.render)
+
+type modelVersion struct {
+	major, minor, patch string   // decimal strings
+	pre                 []string // prerelease identifiers (without the dash)
+	build               string   // with the +, or ""
+	short               string   // ".0.0", ".0" or ""
+}
+
+func isDigits(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// modelNumber: decimal integer without extra leading zeros.
+func modelNumber(s string) bool { return isDigits(s) && (s == "0" || s[0] != '0') }
+
+func modelIdent(s string, prerelease bool) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if !strings.ContainsRune(identChars, rune(s[i])) {
+			return false
+		}
+	}
+	if prerelease && isDigits(s) && s != "0" && s[0] == '0' {
+		return false // all-numeric prerelease identifiers must not have leading zeros
+	}
+	return true
+}
+
+// modelParse implements the grammar in the package doc:
+// vMAJOR[.MINOR[.PATCH[-PRERELEASE][+BUILD]]].
+func modelParse(v string) (m modelVersion, ok bool) {
+	if !strings.HasPrefix(v, "v") {
+		return m, false
+	}
+	rest := v[1:]
+	if i := strings.IndexAny(rest, "-+"); i >= 0 {
+		rest, v = rest[:i], rest[i:]
+	} else {
+		v = ""
+	}
+	nums := strings.Split(rest, ".")
+	if len(nums) > 3 {
+		return m, false
+	}
+	for _, x := range nums {
+		if !modelNumber(x) {
+			return m, false
+		}
+	}
+	m.major = nums[0]
+	m.minor, m.patch = "0", "0"
+	switch len(nums) {
+	case 1:
+		m.short = ".0.0"
+	case 2:
+		m.minor = nums[1]
+		m.short = ".0"
+	case 3:
+		m.minor, m.patch = nums[1], nums[2]
+	}
+	if m.short != "" && v != "" {
+		return m, false // prerelease and build need MAJOR.MINOR.PATCH
+	}
+	if strings.HasPrefix(v, "-") {
+		pre := v[1:]
+		if i := strings.Index(pre, "+"); i >= 0 {
+			pre, v = pre[:i], pre[i:]
+		} else {
+			v = ""
+		}
+		m.pre = strings.Split(pre, ".")
+		for _, id := range m.pre {
+			if !modelIdent(id, true) {
+				return m, false
+			}
+		}
+	}
+	if strings.HasPrefix(v, "+") {
+		for _, id := range strings.Split(v[1:], ".") {
+			if !modelIdent(id, false) {
+				return m, false
+			}
+		}
+		m.build = v
+		v = ""
+	}
+	return m, v == ""
+}
+
+func (m modelVersion) canonical() string {
+	s := "v" + m.major + "." + m.minor + "." + m.patch
+	if len(m.pre) > 0 {
+		s += "-" + strings.Join(m.pre, ".")
+	}
+	return s
+}
+
+func cmpInt(a, b string) int {
+	if len(a) != len(b) {
+		if len(a) < len(b) {
+			return -1
+		}
+		return 1
+	}
+	return strings.Compare(a, b)
+}
+
+// modelCompare is Semantic Versioning 2.0.0 precedence (section 11).
+func modelCompare(a, b modelVersion) int {
+	if c := cmpInt(a.major, b.major); c != 0 {
+		return c
+	}
+	if c := cmpInt(a.minor, b.minor); c != 0 {
+		return c
+	}
+	if c := cmpInt(a.patch, b.patch); c != 0 {
+		return c
+	}
+	switch {
+	case len(a.pre) == 0 && len(b.pre) == 0:
+		return 0
+	case len(a.pre) == 0:
+		return 1
+	case len(b.pre) == 0:
+		return -1
+	}
+	for i := 0; i < len(a.pre) && i < len(b.pre); i++ {
+		x, y := a.pre[i], b.pre[i]
+		nx, ny := isDigits(x), isDigits(y)
+		switch {
+		case nx && ny:
+			if c := cmpInt(x, y); c != 0 {
+				return c
+			}
+		case nx:
+			return -1
+		case ny:
+			return 1
+		default:
+			if c := strings.Compare(x, y); c != 0 {
+				return c
+			}
+		}
+	}
+	switch {
+	case len(a.pre) < len(b.pre):
+		return -1
+	case len(a.pre) > len(b.pre):
+		return 1
+	}
+	return 0
+}
+
+// TestHegelSemverFollowsItsGrammar: IsValid accepts exactly the documented
+// grammar, and Canonical/Major/MajorMinor/Prerelease/Build return the parts
+// the grammar names (all empty for an invalid version).
+func TestHegelSemverFollowsItsGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := hegel.Draw(ht, versions)
+		m, ok := modelParse(v)
+		if got := semver.IsValid(v); got != ok {
+			ht.Fatalf("IsValid(%s) = %v, the grammar says %v", show(v), got, ok)
+		}
+		canon, major, mm, pre, build := semver.Canonical(v), semver.Major(v), semver.MajorMinor(v), semver.Prerelease(v), semver.Build(v)
+		if !ok {
+			count(ht, "invalid")
+			if canon != "" || major != "" || mm != "" || pre != "" || build != "" {
+				ht.Fatalf("invalid %s: Canonical=%q Major=%q MajorMinor=%q Prerelease=%q Build=%q, want all empty", show(v), canon, major, mm, pre, build)
+			}
+			return
+		}
+		count(ht, "valid")
+		if m.short != "" {
+			count(ht, "shorthand")
+		}
+		if len(m.pre) > 0 {
+			count(ht, "prerelease")
+		}
+		if m.build != "" {
+			count(ht, "build")
+		}
+		if want := m.canonical(); canon != want {
+			ht.Fatalf("Canonical(%s) = %q, want %q", show(v), canon, want)
+		}
+		if want := "v" + m.major; major != want {
+			ht.Fatalf("Major(%s) = %q, want %q", show(v), major, want)
+		}
+		if want := "v" + m.major + "." + m.minor; mm != want {
+			ht.Fatalf("MajorMinor(%s) = %q, want %q", show(v), mm, want)
+		}
+		wantPre := ""
+		if len(m.pre) > 0 {
+			wantPre = "-" + strings.Join(m.pre, ".")
+		}
+		if pre != wantPre {
+			ht.Fatalf("Prerelease(%s) = %q, want %q", show(v), pre, wantPre)
+		}
+		if build != m.build {
+			ht.Fatalf("Build(%s) = %q, want %q", show(v), build, m.build)
+		}
+		// Canonical is a fixed point and compares equal to v.
+		if c2 := semver.Canonical(canon); c2 != canon {
+			ht.Fatalf("Canonical(Canonical(%s)) = %q, Canonical = %q", show(v), c2, canon)
+		}
+		if c := semver.Compare(v, canon); c != 0 {
+			ht.Fatalf("Compare(%s, Canonical=%q) = %d, want 0", show(v), canon, c)
+		}
+		// The full form MAJOR.MINOR.PATCH-PRE+BUILD is major+"."+minor+"."+patch+pre+build.
+		full := "v" + m.major + "." + m.minor + "." + m.patch + wantPre + m.build
+		if !semver.IsValid(full) || semver.Compare(v, full) != 0 {
+			ht.Fatalf("%s expands to %q, which is valid=%v and compares %d", show(v), full, semver.IsValid(full), semver.Compare(v, full))
+		}
+	})
+}
+
+// relative: a close relative of the previous version of a list: the
+// previous version without its prerelease and build (its canonical form
+// half of the time), with a prerelease half of the time and a build 30%.
+type relative struct {
+	canon      bool
+	pre, build string
+}
+
+func (r relative) of(prev string) string {
+	base := strings.TrimSuffix(strings.TrimSuffix(prev, semver.Build(prev)), semver.Prerelease(prev))
+	if r.canon {
+		base = semver.Canonical(prev)
+	}
+	return base + r.pre + r.build
+}
+
+var relatives = hegel.Composite(func(tc hegel.TestCase) relative {
+	return relative{
+		canon: hegel.Draw(tc, chance(50)),
+		pre:   hegel.Draw(tc, maybe(50, cat(lit("-"), identLists))),
+		build: hegel.Draw(tc, maybe(30, cat(lit("+"), identLists))),
+	}
+})
+
+// verEntry: an entry of a version list: a fresh version, or (30%) a
+// relative of the entry before it (of v0.0.0 for the first).
+type verEntry struct {
+	v   string
+	rel *relative
+}
+
+var verEntries = weighted(
+	choice[verEntry]{7, hegel.Map(versions, func(v string) verEntry { return verEntry{v: v} })},
+	choice[verEntry]{3, hegel.Map(relatives, func(r relative) verEntry { return verEntry{rel: &r} })},
+)
+
+func renderVersions(es []verEntry) []string {
+	vs := make([]string, len(es))
+	for i, e := range es {
+		vs[i] = e.v
+		if e.rel != nil {
+			prev := "v0.0.0"
+			if i > 0 {
+				prev = vs[i-1]
+			}
+			vs[i] = e.rel.of(prev)
+		}
+	}
+	return vs
+}
+
+// versionLists: two to six versions, some close relatives of their
+// predecessor.
+var versionLists = hegel.Map(many(verEntries, 2, 6), renderVersions)
+
+// TestHegelSemverCompareIsTheSpecPrecedence: Compare agrees with Semantic
+// Versioning 2.0.0 precedence with invalid versions below every valid one
+// and equal to each other; it is antisymmetric, transitive, zero exactly
+// when the canonical forms agree; Sort orders by Compare then by string, Max
+// returns the canonical greater version.
+func TestHegelSemverCompareIsTheSpecPrecedence(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		vs := hegel.Draw(ht, versionLists)
+		k := len(vs)
+		models := make([]modelVersion, k)
+		valid := make([]bool, k)
+		for i, v := range vs {
+			models[i], valid[i] = modelParse(v)
+			if semver.IsValid(v) != valid[i] {
+				ht.Fatalf("IsValid(%s) = %v, grammar says %v", show(v), !valid[i], valid[i])
+			}
+		}
+		want := func(i, j int) int {
+			switch {
+			case !valid[i] && !valid[j]:
+				return 0
+			case !valid[i]:
+				return -1
+			case !valid[j]:
+				return 1
+			}
+			return modelCompare(models[i], models[j])
+		}
+		for i := 0; i < k; i++ {
+			for j := 0; j < k; j++ {
+				got := semver.Compare(vs[i], vs[j])
+				if w := want(i, j); got != w {
+					ht.Fatalf("Compare(%s, %s) = %d, precedence says %d", show(vs[i]), show(vs[j]), got, w)
+				}
+				if back := semver.Compare(vs[j], vs[i]); back != -got {
+					ht.Fatalf("Compare(%s, %s) = %d but Compare(%s, %s) = %d", show(vs[i]), show(vs[j]), got, show(vs[j]), show(vs[i]), back)
+				}
+				if valid[i] && valid[j] {
+					eq := semver.Canonical(vs[i]) == semver.Canonical(vs[j])
+					if (got == 0) != eq {
+						ht.Fatalf("Compare(%s, %s) = %d, canonical forms %q and %q", show(vs[i]), show(vs[j]), got, semver.Canonical(vs[i]), semver.Canonical(vs[j]))
+					}
+					if got == 0 {
+						count(ht, "equal pair")
+					}
+				}
+				if !valid[i] || !valid[j] {
+					count(ht, "invalid in pair")
+				}
+			}
+		}
+		// Transitivity over all triples.
+		for i := 0; i < k; i++ {
+			for j := 0; j < k; j++ {
+				for l := 0; l < k; l++ {
+					if semver.Compare(vs[i], vs[j]) <= 0 && semver.Compare(vs[j], vs[l]) <= 0 && semver.Compare(vs[i], vs[l]) > 0 {
+						ht.Fatalf("Compare not transitive: %s <= %s <= %s but %s > %s", show(vs[i]), show(vs[j]), show(vs[l]), show(vs[i]), show(vs[l]))
+					}
+				}
+			}
+		}
+		// Sort: a permutation ordered by Compare, ties by string order.
+		sorted := append([]string(nil), vs...)
+		semver.Sort(sorted)
+		if !samePermutation(sorted, vs) {
+			ht.Fatalf("Sort(%q) = %q is not a permutation", vs, sorted)
+		}
+		for i := 1; i < k; i++ {
+			c := semver.Compare(sorted[i-1], sorted[i])
+			if c > 0 || c == 0 && strings.Compare(sorted[i-1], sorted[i]) > 0 {
+				ht.Fatalf("Sort(%q) = %q: %s before %s (Compare %d)", vs, sorted, show(sorted[i-1]), show(sorted[i]), c)
+			}
+		}
+		byv := append(semver.ByVersion(nil), vs...)
+		sort.Sort(byv)
+		if fmt.Sprint([]string(byv)) != fmt.Sprint(sorted) {
+			ht.Fatalf("sort.Sort(ByVersion(%q)) = %q, Sort = %q", vs, []string(byv), sorted)
+		}
+		// Max: the canonical form of the greater (or of either when equal).
+		a, b := vs[0], vs[1]
+		mx := semver.Max(a, b)
+		ca, cb := semver.Canonical(a), semver.Canonical(b)
+		switch c := semver.Compare(a, b); {
+		case c < 0 && mx != cb, c > 0 && mx != ca, c == 0 && mx != ca && mx != cb:
+			ht.Fatalf("Max(%s, %s) = %q, Compare %d, canonical %q %q", show(a), show(b), mx, c, ca, cb)
+		}
+	})
+}
+
+func samePermutation(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	x, y := append([]string(nil), a...), append([]string(nil), b...)
+	sort.Strings(x)
+	sort.Strings(y)
+	for i := range x {
+		if x[i] != y[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// Module paths
+
+var windowsNames = []string{"CON", "PRN", "AUX", "NUL",
+	"COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9",
+	"LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9"}
+
+// windowsElems: a Windows reserved name, lower-cased half of the time,
+// with a suffix half of the time.
+var windowsElems = cat(
+	hegel.Map(pairs(hegel.SampledFrom(windowsNames), chance(50)), func(p pair[string, bool]) string {
+		if p.b {
+			return strings.ToLower(p.a)
+		}
+		return p.a
+	}),
+	maybe(50, hegel.SampledFrom([]string{".go", ".txt", "x", "1"})),
+)
+
+// elems: a path element: one to six plain characters half of the time,
+// else one of the named shapes (empty, dots, version-like, a Windows
+// name, a short-name tilde, punctuation, non-ASCII, dashes and case).
+var elems = weighted(
+	choice[string]{7, alphabet("abcdefghijklmnopqrstuvwxyzABC0123456789-._~", 1, 6)},
+	choice[string]{1, hegel.Just("")},
+	choice[string]{1, hegel.SampledFrom([]string{".", "..", "...", ".git", "a.", "a..b", ".a.b"})},
+	choice[string]{1, hegel.SampledFrom([]string{"v2", "v1", "v0", "v10", "v01", "v2.1", "v", "v-1", "v2x"})},
+	choice[string]{1, windowsElems},
+	choice[string]{1, hegel.SampledFrom([]string{"x~1", "foo~123", "~1", "a~", "a~b", "x~1y", "a~1.txt"})},
+	choice[string]{1, hegel.SampledFrom([]string{"a+b", "a b", "a!b", "a#b", "a@b", "a{b}", "a[b]", "a$b", "a%b", "a&b", "a(b)", "a,b", "a=b", "a^b", "a'b", "a*b", "a<b", "a:b", "a\\b", "a\"b", "a|b", "a?b", "a`b"})},
+	choice[string]{1, hegel.SampledFrom([]string{"caf\u00e9", "\u00e9", "\u4e2d\u6587", "a\u0301", "\u2603", "\u0661", "\xff", "a\xffb", "\u00a0"})},
+	choice[string]{1, hegel.SampledFrom([]string{"-a", "a-", "_a", "a_", "A", "Ab", "aB", "9", "0a"})},
+)
+
+// firstElems: a host-like first element (lower-case letters, digits and
+// dashes with a top-level domain) three times in four, else a named host
+// shape or any element.
+var firstElems = weighted(
+	choice[string]{6, cat(alphabet("abcdefghijklmnopqrstuvwxyz0123456789-", 1, 5), hegel.SampledFrom([]string{".com", ".io", ".org", ".dev", "", ".x"}))},
+	choice[string]{1, elems},
+	choice[string]{1, hegel.SampledFrom([]string{"gopkg.in", "github.com", "Example.com", "example", "-example.com", "example.com.", ".example.com", "ex_ample.com", "1.2", "a.b.c"})},
+)
+
+// majors: a major version suffix element.
+var majors = hegel.OneOf(
+	hegel.SampledFrom([]string{"v2", "v3", "v10", "v1", "v0", "v02", "v2.0"}),
+	cat(lit("v"), dec(hegel.Integers(0, 99999))),
+)
+
+// pathSpec: a path as drawn: a first element, up to three more, a major
+// suffix 30% of the time and a slash damage 10% (a leading, a trailing or a
+// doubled slash).
+type pathSpec struct {
+	first string
+	rest  []string
+	major string
+	slash string
+}
+
+func (p pathSpec) render() string {
+	elems := append([]string{p.first}, p.rest...)
+	if p.major != "" {
+		elems = append(elems, p.major)
+	}
+	s := strings.Join(elems, "/")
+	switch p.slash {
+	case "leading":
+		s = "/" + s
+	case "trailing":
+		s += "/"
+	case "double":
+		s = strings.Replace(s, "/", "//", 1)
+	}
+	return s
+}
+
+var builtPaths = hegel.Map(hegel.Composite(func(tc hegel.TestCase) pathSpec {
+	return pathSpec{
+		first: hegel.Draw(tc, firstElems),
+		rest:  hegel.Draw(tc, many(elems, 0, 3)),
+		major: hegel.Draw(tc, maybe(30, majors)),
+		slash: hegel.Draw(tc, maybe(10, hegel.SampledFrom([]string{"leading", "trailing", "double"}))),
+	}
+}), pathSpec.render)
+
+// paths: a built path, or one time in ten a gopkg.in shape.
+var paths = weighted(
+	choice[string]{9, builtPaths},
+	choice[string]{1, hegel.SampledFrom([]string{"gopkg.in/yaml.v2", "gopkg.in/yaml.v3-unstable", "gopkg.in/yaml.v0", "gopkg.in/yaml.v01", "gopkg.in/yaml", "gopkg.in/a/b.v2", "gopkg.in/yaml.v2.1", "gopkg.in/yaml.v", "gopkg.in/x.v10", "gopkg.in/.v2"})},
+)
+
+// Documented element rules shared by import, module and file paths. The
+// doc's "two dots in a row" rule is left to the caller (Known bug mod/1);
+// the short-name rule applies to the prefix before the first dot, as a
+// Windows short name is LONGFI~1.TXT (the doc says "suffix of the element";
+// convention). File paths skip the short-name rule (the code says so;
+// convention).
+func modelElemOK(elem string, okRune func(rune) bool, importRules bool) bool {
+	if elem == "" || strings.HasSuffix(elem, ".") || strings.Trim(elem, ".") == "" {
+		return false
+	}
+	for _, r := range elem {
+		if !okRune(r) {
+			return false
+		}
+	}
+	short := elem
+	if i := strings.Index(short, "."); i >= 0 {
+		short = short[:i]
+	}
+	for _, w := range windowsNames {
+		if strings.EqualFold(w, short) {
+			return false
+		}
+	}
+	if importRules {
+		if i := strings.LastIndexByte(short, '~'); i >= 0 && i < len(short)-1 && isDigits(short[i+1:]) {
+			return false
+		}
+	}
+	return true
+}
+
+// importRuneOK: the doc lists - . _ and ~; the code also admits '+' (for
+// binary names like c++, its comment says; convention).
+func importRuneOK(r rune) bool {
+	return r < 128 && (unicode.IsLetter(r) || unicode.IsDigit(r) || strings.ContainsRune("-._~+", r))
+}
+
+func fileRuneOK(r rune) bool {
+	return unicode.IsLetter(r) || r >= '0' && r <= '9' || r == ' ' || r < 128 && strings.ContainsRune("!#$%&()+,-.=@[]^_{}~", r)
+}
+
+// modelPathOK: no leading or trailing slash, no empty element. A leading
+// dash is rejected for import and module paths (documented for module
+// paths only; convention).
+func modelPathOK(path string, okRune func(rune) bool, importRules bool) bool {
+	if path == "" || strings.HasPrefix(path, "/") || strings.HasSuffix(path, "/") || !utf8Valid(path) {
+		return false
+	}
+	if importRules && strings.HasPrefix(path, "-") {
+		return false
+	}
+	for _, e := range strings.Split(path, "/") {
+		if !modelElemOK(e, okRune, importRules) {
+			return false
+		}
+	}
+	return true
+}
+
+func utf8Valid(s string) bool { return utf8.ValidString(s) }
+
+func pathMatch(pattern, name string) (bool, error) { return path.Match(pattern, name) }
+
+// modelSplit is SplitPathVersion's documentation: prefix + pathMajor == path,
+// pathMajor is "" or "/vN" with N >= 2 (no leading zero, no dots); gopkg.in
+// paths end in ".vN" for any N, optionally "-unstable".
+func modelSplit(path string) (prefix, pathMajor string, ok bool) {
+	if strings.HasPrefix(path, "gopkg.in/") {
+		p := strings.TrimSuffix(path, "-unstable")
+		i := strings.LastIndex(p, ".v")
+		if i < 0 {
+			return path, "", false
+		}
+		num := p[i+2:]
+		if !isDigits(num) || (num[0] == '0' && num != "0") {
+			return path, "", false
+		}
+		return p[:i], path[i:], true
+	}
+	i := strings.LastIndex(path, "/")
+	last := path[i+1:]
+	if i < 0 || !strings.HasPrefix(last, "v") {
+		return path, "", true
+	}
+	num := last[1:]
+	if !isDigits(num) && !isDigitsOrDots(num) {
+		return path, "", true // not numeric-looking: an ordinary element
+	}
+	if !isDigits(num) || num[0] == '0' || num == "1" {
+		return path, "", false
+	}
+	return path[:i], path[i:], true
+}
+
+func isDigitsOrDots(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if (s[i] < '0' || s[i] > '9') && s[i] != '.' {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelModulePathsFollowTheDocumentedRules: CheckImportPath, CheckPath
+// and CheckFilePath accept exactly the paths their documentation describes,
+// SplitPathVersion splits as documented, and EscapePath round-trips every
+// valid module path through a lowercase, exclamation-mark escaped form.
+func TestHegelModulePathsFollowTheDocumentedRules(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		path := hegel.Draw(ht, paths)
+
+		doubleDot := strings.Contains(path, "..")
+		importOK := modelPathOK(path, importRuneOK, true)
+		if err := module.CheckImportPath(path); (err == nil) != importOK {
+			if importOK {
+				ht.Fatalf("CheckImportPath(%s) = %v, the documented rules accept it", show(path), err)
+			} else {
+				ht.Fatalf("CheckImportPath(%s) = nil, the documented rules reject it", show(path))
+			}
+		} else if err == nil && doubleDot {
+			// The doc: "nor contain two dots in a row".
+			if !Known.DoubleDotAccepted {
+				ht.Fatalf("CheckImportPath(%s) = nil, the doc forbids two dots in a row", show(path))
+			}
+			count(ht, "mod/1 double dot accepted")
+		}
+		if importOK {
+			count(ht, "import path")
+		}
+
+		fileOK := modelPathOK(path, fileRuneOK, false)
+		if err := module.CheckFilePath(path); (err == nil) != fileOK {
+			if fileOK {
+				ht.Fatalf("CheckFilePath(%s) = %v, the documented rules accept it", show(path), err)
+			} else {
+				ht.Fatalf("CheckFilePath(%s) = nil, the documented rules reject it", show(path))
+			}
+		} else if err == nil && doubleDot {
+			if !Known.DoubleDotAccepted {
+				ht.Fatalf("CheckFilePath(%s) = nil, the doc forbids two dots in a row", show(path))
+			}
+			count(ht, "mod/1 double dot accepted (file)")
+		}
+		if fileOK {
+			count(ht, "file path")
+		}
+
+		// Module paths: import path rules without '+', no element starting with a
+		// dot, a lower-case LDH first element with a dot and no leading dash, and a
+		// well-formed major version suffix.
+		modOK := modelPathOK(path, func(r rune) bool { return importRuneOK(r) && r != '+' }, true)
+		if modOK {
+			first := path
+			if i := strings.Index(path, "/"); i >= 0 {
+				first = path[:i]
+			}
+			for _, r := range first {
+				if !(r == '-' || r == '.' || r >= '0' && r <= '9' || r >= 'a' && r <= 'z') {
+					modOK = false
+				}
+			}
+			if !strings.Contains(first, ".") || strings.HasPrefix(first, "-") {
+				modOK = false
+			}
+			for _, e := range strings.Split(path, "/") {
+				if strings.HasPrefix(e, ".") {
+					modOK = false
+				}
+			}
+			if _, _, ok := modelSplit(path); !ok {
+				modOK = false
+			}
+		}
+		err := module.CheckPath(path)
+		if (err == nil) != modOK {
+			if modOK {
+				ht.Fatalf("CheckPath(%s) = %v, the documented rules accept it", show(path), err)
+			} else {
+				ht.Fatalf("CheckPath(%s) = nil, the documented rules reject it", show(path))
+			}
+		} else if err == nil && doubleDot {
+			if !Known.DoubleDotAccepted {
+				ht.Fatalf("CheckPath(%s) = nil, the doc forbids two dots in a row", show(path))
+			}
+			count(ht, "mod/1 double dot accepted (module)")
+		}
+		prefix, major, ok := module.SplitPathVersion(path)
+		if wp, wm, wok := modelSplit(path); ok != wok || ok && (prefix != wp || major != wm) {
+			ht.Fatalf("SplitPathVersion(%s) = %q, %q, %v; documented %q, %q, %v", show(path), prefix, major, ok, wp, wm, wok)
+		}
+		if ok && prefix+major != path {
+			ht.Fatalf("SplitPathVersion(%s) = %q + %q != path", show(path), prefix, major)
+		}
+		if major != "" {
+			count(ht, "path major")
+		}
+		if err != nil {
+			return
+		}
+		count(ht, "module path")
+		esc, err := module.EscapePath(path)
+		if err != nil {
+			ht.Fatalf("EscapePath(%s) = %v for a valid module path", show(path), err)
+		}
+		if strings.ToLower(esc) != esc {
+			ht.Fatalf("EscapePath(%s) = %q has upper-case letters", show(path), esc)
+		}
+		if want := escapeModel(path); esc != want {
+			ht.Fatalf("EscapePath(%s) = %q, want %q", show(path), esc, want)
+		}
+		if esc != path {
+			count(ht, "escaped")
+		}
+		back, err := module.UnescapePath(esc)
+		if err != nil || back != path {
+			ht.Fatalf("UnescapePath(EscapePath(%s) = %q) = %q, %v", show(path), esc, back, err)
+		}
+		// The escaped form is a valid path too (nothing but lower-case letters and !).
+		if _, err := module.UnescapePath(path); err == nil && esc != path {
+			// path had upper case letters, so as an escaped path it is invalid.
+			ht.Fatalf("UnescapePath(%s) accepted a path with upper-case letters", show(path))
+		}
+	})
+}
+
+func escapeModel(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if r >= 'A' && r <= 'Z' {
+			b.WriteByte('!')
+			b.WriteRune(r + 'a' - 'A')
+		} else {
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// pathVersion: a path and a version; one time in five the version's build
+// is replaced by +incompatible.
+type pathVersion struct {
+	path, version string
+}
+
+var pathVersions = hegel.Composite(func(tc hegel.TestCase) pathVersion {
+	c := pathVersion{path: hegel.Draw(tc, paths), version: hegel.Draw(tc, versions)}
+	if hegel.Draw(tc, chance(20)) {
+		c.version = strings.TrimSuffix(c.version, semver.Build(c.version)) + "+incompatible"
+	}
+	return c
+})
+
+// TestHegelModuleVersionsMatchTheirPaths: Check(path, version) is nil exactly
+// when the path is valid, the version valid and the majors agree
+// (MatchPathMajor); CanonicalVersion keeps only +incompatible; EscapeVersion
+// round-trips versions; module.Sort orders by path, then semver, then file
+// suffix; pseudo-versions built by PseudoVersion give back their parts and
+// sort between the base and the next version.
+func TestHegelModuleVersionsMatchTheirPaths(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pathVersions)
+		path, v := c.path, c.version
+		_, major, splitOK := module.SplitPathVersion(path)
+		pathOK := module.CheckPath(path) == nil
+		valid := semver.IsValid(v)
+		// MatchPathMajor per its doc: v0/v1 (or +incompatible) for no suffix,
+		// otherwise the major must equal N of /vN or .vN; gopkg.in's .v1 also
+		// admits v0.0.0- pseudo-versions.
+		var wantMatch bool
+		if splitOK && valid {
+			m := semver.Major(v)
+			pm := strings.TrimSuffix(major, "-unstable")
+			switch {
+			case pm == "":
+				wantMatch = m == "v0" || m == "v1" || semver.Build(v) == "+incompatible"
+			case pm == ".v1" && strings.HasPrefix(v, "v0.0.0-"):
+				wantMatch = true
+			default:
+				wantMatch = m == pm[1:]
+			}
+			if got := module.MatchPathMajor(v, major); got != wantMatch {
+				ht.Fatalf("MatchPathMajor(%s, %q) = %v, want %v", show(v), major, got, wantMatch)
+			}
+			if (module.CheckPathMajor(v, major) == nil) != module.MatchPathMajor(v, major) {
+				ht.Fatalf("CheckPathMajor and MatchPathMajor disagree on %s, %q", show(v), major)
+			}
+		}
+		err := module.Check(path, v)
+		if want := pathOK && valid && wantMatch; (err == nil) != want {
+			ht.Fatalf("Check(%s, %s) = %v; path ok %v, version valid %v, major matches %v", show(path), show(v), err, pathOK, valid, wantMatch)
+		}
+		if err == nil {
+			count(ht, "Check ok")
+			if major != "" {
+				count(ht, "Check ok with path major")
+			}
+		}
+		// CanonicalVersion.
+		cv := module.CanonicalVersion(v)
+		want := semver.Canonical(v)
+		if valid && semver.Build(v) == "+incompatible" {
+			want += "+incompatible"
+			count(ht, "incompatible")
+		}
+		if cv != want {
+			ht.Fatalf("CanonicalVersion(%s) = %q, want %q", show(v), cv, want)
+		}
+		// EscapeVersion: valid file names (one element) without '!'.
+		esc, err := module.EscapeVersion(v)
+		fileName := module.CheckFilePath(v) == nil && !strings.ContainsAny(v, "!/")
+		if (err == nil) != fileName {
+			nonASCII := false
+			for _, r := range v {
+				if r >= 128 {
+					nonASCII = true
+				}
+			}
+			if fileName && nonASCII && Known.EscapeVersionUnicode {
+				count(ht, "mod/2 EscapeVersion internal error on a letter")
+			} else {
+				ht.Fatalf("EscapeVersion(%s) = %q, %v while CheckFilePath = %v", show(v), esc, err, module.CheckFilePath(v))
+			}
+		}
+		if err == nil {
+			if esc != escapeModel(v) {
+				ht.Fatalf("EscapeVersion(%s) = %q, want %q", show(v), esc, escapeModel(v))
+			}
+			if back, err := module.UnescapeVersion(esc); err != nil || back != v {
+				ht.Fatalf("UnescapeVersion(%q) = %q, %v, want %s", esc, back, err, show(v))
+			}
+		}
+		// Version.String.
+		mv := module.Version{Path: path, Version: v}
+		if s := mv.String(); v == "" && s != path || v != "" && s != path+"@"+v {
+			ht.Fatalf("Version{%s, %s}.String() = %q", show(path), show(v), s)
+		}
+	})
+}
+
+// sortEntries: a module.Version of one of three paths with a version that
+// carries a file suffix 30% of the time.
+var sortEntries = hegel.Composite(func(tc hegel.TestCase) module.Version {
+	return module.Version{
+		Path:    hegel.Draw(tc, hegel.SampledFrom([]string{"a.example/x", "b.example/y", "b.example/y/v2"})),
+		Version: hegel.Draw(tc, cat(versions, maybe(30, hegel.SampledFrom([]string{"/go.mod", "/", "/a", "/b"})))),
+	}
+})
+
+// TestHegelModuleSortOrdersByPathThenVersion: module.Sort sorts by path,
+// then semver precedence of the version before any "/", then the suffix.
+func TestHegelModuleSortOrdersByPathThenVersion(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		list := hegel.Draw(ht, many(sortEntries, 1, 7))
+		k := len(list)
+		for _, mv := range list {
+			if !semver.IsValid(mv.Version) {
+				count(ht, "invalid version")
+			}
+		}
+		sorted := append([]module.Version(nil), list...)
+		module.Sort(sorted)
+		if !samePermutationV(sorted, list) {
+			ht.Fatalf("Sort(%v) = %v is not a permutation", list, sorted)
+		}
+		// The doc: by Path, then the semver before any "/", then the suffix.
+		// Two invalid versions compare equal, so the suffix only decides when
+		// the version strings agree (as the code does; convention).
+		less := func(a, b module.Version) int {
+			if a.Path != b.Path {
+				return strings.Compare(a.Path, b.Path)
+			}
+			va, fa, _ := strings.Cut(a.Version, "/")
+			vb, fb, _ := strings.Cut(b.Version, "/")
+			if va != vb {
+				return semver.Compare(va, vb)
+			}
+			return strings.Compare(fa, fb)
+		}
+		for i := 1; i < k; i++ {
+			if less(sorted[i-1], sorted[i]) > 0 {
+				ht.Fatalf("Sort(%v) = %v: %v before %v", list, sorted, sorted[i-1], sorted[i])
+			}
+		}
+		if k > 1 && semver.Compare(list[0].Version, list[1].Version) == 0 && list[0].Path == list[1].Path {
+			count(ht, "tie")
+		}
+	})
+}
+
+func samePermutationV(a, b []module.Version) bool {
+	x := make([]string, len(a))
+	y := make([]string, len(b))
+	for i := range a {
+		x[i] = a[i].String()
+	}
+	for i := range b {
+		y[i] = b[i].String()
+	}
+	return samePermutation(x, y)
+}
+
+// olderSpec: the tagged version a pseudo-version follows: MAJOR.minor.patch,
+// with a prerelease 40% of the time and +incompatible 30% (majors >= 2).
+type olderSpec struct {
+	minor        int
+	patch        string
+	pre          string
+	incompatible bool
+}
+
+var olderSpecs = hegel.Composite(func(tc hegel.TestCase) olderSpec {
+	return olderSpec{
+		minor:        hegel.Draw(tc, hegel.Integers(0, 30)),
+		patch:        hegel.Draw(tc, hegel.OneOf(hegel.SampledFrom([]string{"0", "9", "99", "3"}), dec(hegel.Integers(0, 1000)))),
+		pre:          hegel.Draw(tc, maybe(40, hegel.SampledFrom([]string{"pre", "rc1", "alpha.1", "0.beta", "a-b"}))),
+		incompatible: hegel.Draw(tc, chance(30)),
+	}
+})
+
+// pseudoSpec: the inputs of PseudoVersion: the major, the older version
+// (70% of the time), the time (in a fixed zone 20% of the time), one to
+// twelve hex digits of revision, and how much later the second time is.
+type pseudoSpec struct {
+	major   int
+	older   *olderSpec
+	unix    int64
+	zone    *int
+	rev     string
+	laterBy int
+}
+
+// olderVersion is the older version's text ("" for none).
+func (p pseudoSpec) olderVersion() string {
+	if p.older == nil {
+		return ""
+	}
+	s := fmt.Sprintf("v%d.%d.%s", p.major, p.older.minor, p.older.patch)
+	if p.older.pre != "" {
+		s += "-" + p.older.pre
+	}
+	if p.major >= 2 && p.older.incompatible {
+		s += "+incompatible"
+	}
+	return s
+}
+
+// form is the pseudo-version's form in the module doc: (1) no base, (2) a
+// release base, (3) a release base with +incompatible, (4) a prerelease
+// base, (5) a prerelease base with +incompatible.
+func (p pseudoSpec) form() string {
+	switch {
+	case p.older == nil:
+		return "1"
+	case p.older.pre != "":
+		if strings.HasSuffix(p.olderVersion(), "+incompatible") {
+			return "5"
+		}
+		return "4"
+	default:
+		if strings.HasSuffix(p.olderVersion(), "+incompatible") {
+			return "3"
+		}
+		return "2"
+	}
+}
+
+func (p pseudoSpec) time() time.Time {
+	tm := time.Unix(p.unix, 0).UTC()
+	if p.zone != nil {
+		tm = tm.In(time.FixedZone("x", 3600**p.zone))
+	}
+	return tm
+}
+
+func (p pseudoSpec) GoString() string {
+	return fmt.Sprintf("major=v%d older=%s t=%v rev=%s laterBy=%ds", p.major, p.olderVersion(), p.time(), p.rev, p.laterBy)
+}
+
+var pseudoSpecs = hegel.Composite(func(tc hegel.TestCase) pseudoSpec {
+	return pseudoSpec{
+		major:   hegel.Draw(tc, hegel.Integers(0, 12)),
+		older:   hegel.Draw(tc, optional(70, olderSpecs)),
+		unix:    hegel.Draw(tc, hegel.Integers(int64(0), 4102444800)),
+		zone:    hegel.Draw(tc, optional(20, hegel.Integers(-11, 12))),
+		rev:     hegel.Draw(tc, alphabet("0123456789abcdef", 1, 12)),
+		laterBy: hegel.Draw(tc, hegel.Integers(1, 1000000)),
+	}
+})
+
+// TestHegelPseudoVersionsRoundTrip: PseudoVersion(major, older, t, rev) is a
+// pseudo-version whose Time, Rev and Base are the inputs, that Check passes
+// with the major's path, and that sorts after older and before the next
+// possible tagged version; IsZeroPseudoVersion recognises ZeroPseudoVersion.
+func TestHegelPseudoVersionsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pseudoSpecs)
+		major := "v" + strconv.Itoa(c.major)
+		older, tm, rev := c.olderVersion(), c.time(), c.rev
+		pv := module.PseudoVersion(major, older, tm, rev)
+		count(ht, "form "+c.form())
+		if !module.IsPseudoVersion(pv) || !semver.IsValid(pv) {
+			ht.Fatalf("PseudoVersion(%s, %s, %v, %s) = %q: IsPseudoVersion %v, IsValid %v", major, older, tm, rev, pv, module.IsPseudoVersion(pv), semver.IsValid(pv))
+		}
+		if semver.Major(pv) != major {
+			ht.Fatalf("PseudoVersion(%s, %s, ...) = %q has major %q", major, older, pv, semver.Major(pv))
+		}
+		if got, err := module.PseudoVersionTime(pv); err != nil || !got.Equal(tm.Truncate(time.Second)) {
+			ht.Fatalf("PseudoVersionTime(%q) = %v, %v; want %v", pv, got, err, tm.UTC())
+		}
+		if got, err := module.PseudoVersionRev(pv); err != nil || got != rev {
+			ht.Fatalf("PseudoVersionRev(%q) = %q, %v; want %q", pv, got, err, rev)
+		}
+		wantBase := ""
+		if older != "" {
+			wantBase = module.CanonicalVersion(older)
+		}
+		if got, err := module.PseudoVersionBase(pv); err != nil || got != wantBase {
+			ht.Fatalf("PseudoVersionBase(%q) = %q, %v; want %q", pv, got, err, wantBase)
+		}
+		// Ordering: after older, before the next tagged version it precedes.
+		if older != "" {
+			if c := semver.Compare(pv, older); c <= 0 {
+				ht.Fatalf("PseudoVersion %q does not sort after its base %q (Compare %d)", pv, older, c)
+			}
+			if semver.Prerelease(older) == "" {
+				// Form 2/3: a prerelease of vX.Y.(Z+1) below any explicit prerelease.
+				next := strings.TrimSuffix(strings.TrimSuffix(semver.Canonical(pv), semver.Prerelease(pv)), "+incompatible")
+				for _, pre := range []string{"", "-rc1", "-1", "-alpha", "-0-1"} {
+					if c := semver.Compare(pv, next+pre); c >= 0 {
+						ht.Fatalf("PseudoVersion %q does not sort before %q (Compare %d)", pv, next+pre, c)
+					}
+				}
+			} else {
+				// Form 4/5: a slightly later prerelease of the same version.
+				base := semver.Canonical(older)
+				if c := semver.Compare(pv, strings.TrimSuffix(base, semver.Prerelease(base))); c >= 0 {
+					ht.Fatalf("PseudoVersion %q does not sort before the release %q", pv, strings.TrimSuffix(base, semver.Prerelease(base)))
+				}
+			}
+		} else {
+			// Form 1: below any tagged version of that major, including vX.0.0.
+			if c := semver.Compare(pv, major+".0.0"); c >= 0 {
+				ht.Fatalf("PseudoVersion %q does not sort below %s.0.0 (Compare %d)", pv, major, c)
+			}
+		}
+		// A later time sorts later for the same base.
+		later := module.PseudoVersion(major, older, tm.Add(time.Duration(c.laterBy)*time.Second), rev)
+		if later != pv && semver.Compare(pv, later) >= 0 {
+			ht.Fatalf("PseudoVersion at a later time %q does not sort after %q", later, pv)
+		}
+		// The version fits a path with the matching major.
+		path := "example.com/m"
+		if c.major >= 2 {
+			path += "/" + major
+		}
+		if strings.HasSuffix(pv, "+incompatible") {
+			path = "example.com/m"
+		}
+		if err := module.Check(path, pv); err != nil {
+			ht.Fatalf("Check(%q, %q) = %v", path, pv, err)
+		}
+		zero := module.ZeroPseudoVersion(major)
+		if !module.IsZeroPseudoVersion(zero) || module.IsZeroPseudoVersion(pv) && rev != "000000000000" {
+			ht.Fatalf("IsZeroPseudoVersion(%q) = %v, IsZeroPseudoVersion(%q) = %v", zero, module.IsZeroPseudoVersion(zero), pv, module.IsZeroPseudoVersion(pv))
+		}
+	})
+}
+
+// globLists: up to three comma-separated glob patterns of up to three
+// elements each, with a trailing slash 20% of the time; targets: one to
+// four elements.
+var (
+	globElems = hegel.SampledFrom([]string{"example.com", "corp.example", "x", "y", "v2", "a-b", "*", "?", "[ab]", "a*", "*.com", "", "[a-c]", "**"})
+	globs     = cat(joined(many(globElems, 0, 3), "/"), maybe(20, lit("/")))
+	globLists = joined(many(globs, 0, 3), ",")
+	targets   = joined(many(hegel.SampledFrom([]string{"example.com", "corp.example", "x", "y", "v2", "a-b", "ab", "a", "b", "zz.com"}), 1, 4), "/")
+)
+
+// TestHegelPrefixPatternsMatchPathPrefixes: MatchPrefixPatterns(globs, target)
+// is true exactly when some path prefix of target matches one of the
+// comma-separated glob patterns (path.Match), ignoring empty patterns and
+// trailing slashes.
+func TestHegelPrefixPatternsMatchPathPrefixes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pairs(globLists, targets))
+		globList, target := c.a, c.b
+		want := false
+		for _, glob := range strings.Split(globList, ",") {
+			glob = strings.TrimSuffix(glob, "/")
+			if glob == "" {
+				continue
+			}
+			for i := 0; i <= len(target); i++ {
+				if i < len(target) && target[i] != '/' {
+					continue
+				}
+				if ok, err := pathMatch(glob, target[:i]); err == nil && ok {
+					want = true
+				}
+			}
+		}
+		if got := module.MatchPrefixPatterns(globList, target); got != want {
+			ht.Fatalf("MatchPrefixPatterns(%q, %q) = %v, want %v", globList, target, got, want)
+		}
+		if want {
+			count(ht, "match")
+		}
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..ef79fa1
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,199 @@
+package hegel
+
+// Hegel properties for golang.org/x/mod: semver and module against their
+// documented grammars and orders, modfile against parse/format round trips
+// and its editing API, sumdb/tlog against the Merkle tree definitions,
+// sumdb/note against its signature format, and zip against Create/Unzip
+// round trips and CheckFiles. No external tools.
+//
+// Every property draws one case record built from the binding's
+// combinators (Composite for records, Lists for collections, OneOf and the
+// local weighted for choices) and renders it with pure functions; an
+// editing script is a list of edit records whose positions are taken
+// modulo the live state when applied.
+//
+// Conventions: hegel-go reads no environment variable itself, so
+// HEGEL_TEST_CASES (and HEGEL_VERBOSE) are passed through hegelOpts; a panic
+// in the code under test is turned into a failure of the current test case
+// by property().
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the gated shapes of each property so a run shows how often
+// the Known gates fire (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// show renders a string with every non-ASCII or control rune escaped, so a
+// failure message can be read and replayed.
+func show(s string) string { return strconv.QuoteToASCII(s) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// fixed is a list of exactly k elements.
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] { return many(g, k, k) }
+
+// cat draws one string from each generator and joins them: the pieces of a
+// token.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// joined is the strings of g glued with sep.
+func joined(g hegel.Generator[[]string], sep string) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, sep) })
+}
+
+// dec is the decimal text of an integer generator.
+func dec(g hegel.Generator[int]) hegel.Generator[string] {
+	return hegel.Map(g, func(x int) string { return strconv.Itoa(x) })
+}
+
+// alphabet is a string of lo to hi runes from pool.
+func alphabet(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
