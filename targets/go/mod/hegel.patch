+package hegel
+
+// zip: CheckFiles, Create, CheckZip and Unzip on generated file sets.
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/mod/module"
+	"golang.org/x/mod/zip"
+	"hegel.dev/go/hegel"
+)
+
+type memFile struct {
+	name string
+	data []byte
+	mode os.FileMode
+}
+
+func (f memFile) Path() string                 { return f.name }
+func (f memFile) Lstat() (os.FileInfo, error)  { return memInfo{f}, nil }
+func (f memFile) Open() (io.ReadCloser, error) { return io.NopCloser(bytes.NewReader(f.data)), nil }
+
+type memInfo struct{ f memFile }
+
+func (i memInfo) Name() string       { return path.Base(i.f.name) }
+func (i memInfo) Size() int64        { return int64(len(i.f.data)) }
+func (i memInfo) Mode() os.FileMode  { return i.f.mode }
+func (i memInfo) ModTime() time.Time { return time.Time{} }
+func (i memInfo) IsDir() bool        { return i.f.mode.IsDir() }
+func (i memInfo) Sys() any           { return nil }
+
+func genFileName(tc hegel.TestCase) string {
+	dirs := []string{"", "", "pkg/", "cmd/tool/", "internal/x/", "vendor/", "vendor/example.com/dep/", "sub/", "sub/deep/", "testdata/", ".git/", "Pkg/", "a b/", "é/"}
+	names := []string{"main.go", "x.go", "go.mod", "go.sum", "LICENSE", "README.md", "doc.txt", "GO.MOD", "Main.go", "x_test.go", "modules.txt", "a.b.c", "file with space", "中.go", "-x", ".hidden", "con.txt", "x:y", "a*b", ".hg_archival.txt", "é.go"}
+	return pick(tc, dirs...) + pick(tc, names...)
+}
+
+// TestHegelZipCreateThenUnzipRoundTrip: CheckFiles puts every file in exactly
+// one of Valid, Omitted and Invalid, its Err is nil exactly when nothing is
+// invalid, Create succeeds exactly then and writes exactly the Valid files
+// (CheckZip agrees), Unzip extracts them with their content under
+// into the target directory, and Create rejects a bad module version.
+func TestHegelZipCreateThenUnzipRoundTrip(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-zip-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		mpath, mver := genModule(tc)
+		if chance(tc, 8) {
+			mver = pick(tc, "v1.0", "1.0.0", "v1.0.0-", "latest", "")
+		}
+		m := module.Version{Path: mpath, Version: mver}
+		var files []zip.File
+		seen := map[string]bool{}
+		for i, k := 0, n(tc, 0, 8); i < k; i++ {
+			name := genFileName(tc)
+			if seen[name] {
+				continue
+			}
+			seen[name] = true
+			data := []byte(strings.Repeat(pick(tc, "package p\n", "x", "\x00\xff", ""), n(tc, 0, 40)))
+			if strings.HasSuffix(name, "go.mod") && chance(tc, 70) {
+				data = []byte("module " + mpath + "\n\ngo 1.21\n")
+			}
+			mode := os.FileMode(0644)
+			switch n(tc, 0, 30) {
+			case 0:
+				mode = os.ModeSymlink | 0777
+			case 1:
+				mode = os.ModeDir | 0755
+			}
+			files = append(files, memFile{name: name, data: data, mode: mode})
+		}
+		note(ht, "m=%v files=%v", m, files)
+		cf, err := zip.CheckFiles(files)
+		// Every file in exactly one list.
+		where := map[string]int{}
+		for _, v := range cf.Valid {
+			where[v]++
+		}
+		for _, o := range cf.Omitted {
+			where[o.Path]++
+		}
+		for _, x := range cf.Invalid {
+			where[x.Path]++
+		}
+		for _, f := range files {
+			if where[f.Path()] != 1 {
+				fail(ht, "CheckFiles lists %q %d times (valid %v, omitted %v, invalid %v)", f.Path(), where[f.Path()], cf.Valid, cf.Omitted, cf.Invalid)
+				return
+			}
+		}
+		if len(where) != len(files) {
+			fail(ht, "CheckFiles lists %d names for %d files", len(where), len(files))
+		}
+		wantErr := len(cf.Invalid) > 0 || cf.SizeError != nil
+		if (err != nil) != wantErr || (cf.Err() != nil) != wantErr {
+			fail(ht, "CheckFiles error %v, Err() %v with %d invalid files", err, cf.Err(), len(cf.Invalid))
+		}
+		// Documented rules on the valid list.
+		for _, v := range cf.Valid {
+			if module.CheckFilePath(v) != nil {
+				fail(ht, "CheckFiles accepted %q, an invalid file path", v)
+			}
+			if strings.EqualFold(path.Base(v), "go.mod") && v != "go.mod" {
+				fail(ht, "CheckFiles accepted %q: go.mod files belong in the root only, named go.mod", v)
+			}
+		}
+		for i, a := range cf.Valid {
+			for _, b := range cf.Valid[i+1:] {
+				if strings.EqualFold(a, b) {
+					fail(ht, "CheckFiles accepted both %q and %q, equal under case folding", a, b)
+				}
+			}
+		}
+		for _, f := range files {
+			p := f.Path()
+			isOmitted := false
+			for _, o := range cf.Omitted {
+				isOmitted = isOmitted || o.Path == p
+			}
+			isInvalid := false
+			for _, x := range cf.Invalid {
+				isInvalid = isInvalid || x.Path == p
+			}
+			info, _ := f.Lstat()
+			switch {
+			case !info.Mode().IsRegular() && !isOmitted && !isInvalid:
+				fail(ht, "CheckFiles did not omit the irregular file %q (%v)", p, info.Mode())
+			case module.CheckFilePath(p) != nil && !isInvalid && !isOmitted:
+				fail(ht, "CheckFiles did not reject %q, an invalid file path", p)
+			}
+			if strings.HasPrefix(p, "vendor/") && isOmitted {
+				count(ht, "vendored omitted")
+			}
+			if strings.HasPrefix(p, "sub/") && seen["sub/go.mod"] && info.Mode().IsRegular() && p != "sub/go.mod" && !isOmitted {
+				fail(ht, "CheckFiles kept %q, which is in the submodule sub/ (sub/go.mod is present)", p)
+			}
+		}
+		if len(cf.Omitted) > 0 {
+			count(ht, "omitted")
+		}
+		if len(cf.Invalid) > 0 {
+			count(ht, "invalid")
+		}
+		// Create.
+		var buf bytes.Buffer
+		cerr := zip.Create(&buf, m, files)
+		versionOK := module.Check(mpath, mver) == nil && module.CanonicalVersion(mver) == mver
+		if !versionOK {
+			if cerr == nil {
+				fail(ht, "Create(%v) accepted a non-canonical or mismatched version", m)
+			}
+			count(ht, "bad version rejected")
+			return
+		}
+		if (cerr == nil) != !wantErr {
+			fail(ht, "Create(%v) = %v while CheckFiles = %v", m, cerr, err)
+			return
+		}
+		if cerr != nil {
+			return
+		}
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			fail(ht, "MkdirTemp: %v", err)
+			return
+		}
+		defer os.RemoveAll(dir)
+		zipPath := filepath.Join(dir, "m.zip")
+		if err := os.WriteFile(zipPath, buf.Bytes(), 0644); err != nil {
+			fail(ht, "WriteFile: %v", err)
+			return
+		}
+		cz, err := zip.CheckZip(m, zipPath)
+		if err != nil || cz.Err() != nil {
+			fail(ht, "CheckZip(Create(%v)) = %v / %v", m, err, cz.Err())
+			return
+		}
+		wantValid := append([]string(nil), cf.Valid...)
+		sort.Strings(wantValid)
+		// CheckZip lists the paths as they are in the zip: <module>@<version>/...
+		var gotValid []string
+		for _, v := range cz.Valid {
+			rel, ok := strings.CutPrefix(v, mpath+"@"+mver+"/")
+			if !ok {
+				fail(ht, "CheckZip lists %q without the %s@%s/ prefix", v, mpath, mver)
+			}
+			gotValid = append(gotValid, rel)
+		}
+		sort.Strings(gotValid)
+		if fmt.Sprint(gotValid) != fmt.Sprint(wantValid) {
+			fail(ht, "CheckZip valid files %v, CheckFiles valid files %v", gotValid, wantValid)
+		}
+		if len(cz.Omitted)+len(cz.Invalid) != 0 {
+			fail(ht, "CheckZip of a Create'd zip omits %v and rejects %v", cz.Omitted, cz.Invalid)
+		}
+		out := filepath.Join(dir, "out")
+		if err := zip.Unzip(out, m, zipPath); err != nil {
+			fail(ht, "Unzip(Create(%v)): %v", m, err)
+			return
+		}
+		// Unzip writes the files straight into dir (the go command's cache
+		// directory is named after the module and version already).
+		prefix := out
+		var extracted []string
+		filepath.Walk(out, func(p string, info os.FileInfo, err error) error {
+			if err == nil && info.Mode().IsRegular() {
+				rel, _ := filepath.Rel(prefix, p)
+				extracted = append(extracted, filepath.ToSlash(rel))
+			}
+			return nil
+		})
+		sort.Strings(extracted)
+		if fmt.Sprint(extracted) != fmt.Sprint(wantValid) {
+			fail(ht, "Unzip extracted %v under %s, want %v", extracted, prefix, wantValid)
+			return
+		}
+		for _, f := range files {
+			mf := f.(memFile)
+			for _, v := range cf.Valid {
+				if v == mf.name {
+					got, err := os.ReadFile(filepath.Join(prefix, filepath.FromSlash(v)))
+					if err != nil || !bytes.Equal(got, mf.data) {
+						fail(ht, "Unzip wrote %q with %d bytes (%v), want %d bytes", v, len(got), err, len(mf.data))
+					}
+				}
+			}
+		}
+		if len(wantValid) > 0 {
+			count(ht, "files extracted")
+		}
+		// Unzip into a non-empty directory fails.
+		if err := zip.Unzip(out, m, zipPath); err == nil && len(wantValid) > 0 {
+			fail(ht, "Unzip into the non-empty directory %s succeeded", out)
+		}
+		// A different version in Unzip fails: the paths in the zip carry the version.
+		other := module.Version{Path: mpath, Version: strings.TrimSuffix(mver, "+incompatible") + "-other"}
+		if module.CanonicalVersion(other.Version) == other.Version && len(wantValid) > 0 {
+			if err := zip.Unzip(filepath.Join(dir, "out2"), other, zipPath); err == nil {
+				fail(ht, "Unzip as %v of a zip for %v succeeded", other, m)
+			}
+		}
+	})
+}
