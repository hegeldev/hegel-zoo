+// zip: CheckFiles, Create, CheckZip and Unzip on generated file sets.
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/mod/module"
+	"golang.org/x/mod/zip"
+	"hegel.dev/go/hegel"
+)
+
+type memFile struct {
+	name string
+	data []byte
+	mode os.FileMode
+}
+
+func (f memFile) Path() string                 { return f.name }
+func (f memFile) Lstat() (os.FileInfo, error)  { return memInfo{f}, nil }
+func (f memFile) Open() (io.ReadCloser, error) { return io.NopCloser(bytes.NewReader(f.data)), nil }
+
+type memInfo struct{ f memFile }
+
+func (i memInfo) Name() string       { return path.Base(i.f.name) }
+func (i memInfo) Size() int64        { return int64(len(i.f.data)) }
+func (i memInfo) Mode() os.FileMode  { return i.f.mode }
+func (i memInfo) ModTime() time.Time { return time.Time{} }
+func (i memInfo) IsDir() bool        { return i.f.mode.IsDir() }
+func (i memInfo) Sys() any           { return nil }
+
+// fileSpec: a file of the module as drawn: its name (a directory and a base
+// name), its content (a piece repeated up to forty times, or for a go.mod
+// the module's own go.mod text 70% of the time) and its mode (a symlink or
+// a directory one time in 31 each).
+type fileSpec struct {
+	name  string
+	fill  string
+	times int
+	goMod bool
+	mode  os.FileMode
+}
+
+func (f fileSpec) file(modPath string) memFile {
+	data := []byte(strings.Repeat(f.fill, f.times))
+	if strings.HasSuffix(f.name, "go.mod") && f.goMod {
+		data = []byte("module " + modPath + "\n\ngo 1.21\n")
+	}
+	return memFile{name: f.name, data: data, mode: f.mode}
+}
+
+func (f fileSpec) String() string {
+	return fmt.Sprintf("%s (%d bytes, %v)", f.name, len(f.file("m").data), f.mode)
+}
+
+var (
+	fileNames = cat(
+		hegel.SampledFrom([]string{"", "", "pkg/", "cmd/tool/", "internal/x/", "vendor/", "vendor/example.com/dep/", "sub/", "sub/deep/", "testdata/", ".git/", "Pkg/", "a b/", "\u00e9/"}),
+		hegel.SampledFrom([]string{"main.go", "x.go", "go.mod", "go.sum", "LICENSE", "README.md", "doc.txt", "GO.MOD", "Main.go", "x_test.go", "modules.txt", "a.b.c", "file with space", "\u4e2d.go", "-x", ".hidden", "con.txt", "x:y", "a*b", ".hg_archival.txt", "\u00e9.go"}),
+	)
+	fileModes = weighted(
+		choice[os.FileMode]{29, hegel.Just(os.FileMode(0644))},
+		choice[os.FileMode]{1, hegel.Just(os.ModeSymlink | 0777)},
+		choice[os.FileMode]{1, hegel.Just(os.ModeDir | 0755)},
+	)
+	fileSpecs = hegel.Composite(func(tc hegel.TestCase) fileSpec {
+		return fileSpec{
+			name:  hegel.Draw(tc, fileNames),
+			fill:  hegel.Draw(tc, hegel.SampledFrom([]string{"package p\n", "x", "\x00\xff", ""})),
+			times: hegel.Draw(tc, hegel.Integers(0, 40)),
+			goMod: hegel.Draw(tc, chance(70)),
+			mode:  hegel.Draw(tc, fileModes),
+		}
+	})
+	// fileLists: up to eight files of distinct names (the first of a name is
+	// kept).
+	fileLists = hegel.Map(many(fileSpecs, 0, 8), func(fs []fileSpec) []fileSpec {
+		seen := map[string]bool{}
+		var out []fileSpec
+		for _, f := range fs {
+			if !seen[f.name] {
+				seen[f.name] = true
+				out = append(out, f)
+			}
+		}
+		return out
+	})
+)
+
+// zipCase: the module, a version Create must reject 3% of the time instead
+// of the module's own, and the files.
+type zipCase struct {
+	mod        moduleSpec
+	badVersion *string
+	files      []fileSpec
+}
+
+func (c zipCase) version() string {
+	if c.badVersion != nil {
+		return *c.badVersion
+	}
+	return c.mod.version()
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c zipCase) GoString() string {
+	return fmt.Sprintf("m=%s@%s files=%v", c.mod.path(), c.version(), c.files)
+}
+
+var zipCases = hegel.Composite(func(tc hegel.TestCase) zipCase {
+	return zipCase{
+		mod:        hegel.Draw(tc, modules),
+		badVersion: hegel.Draw(tc, optional(3, hegel.SampledFrom([]string{"v1.0", "1.0.0", "v1.0.0-", "latest", ""}))),
+		files:      hegel.Draw(tc, fileLists),
+	}
+})
+
+// TestHegelZipCreateThenUnzipRoundTrip: CheckFiles puts every file in exactly
+// one of Valid, Omitted and Invalid, its Err is nil exactly when nothing is
+// invalid, Create succeeds exactly then and writes exactly the Valid files
+// (CheckZip agrees), Unzip extracts them with their content under
+// into the target directory, and Create rejects a bad module version.
+func TestHegelZipCreateThenUnzipRoundTrip(t *testing.T) {
+	root, err := os.MkdirTemp("", "hegel-zip-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(root)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zipCases)
+		mpath, mver := c.mod.path(), c.version()
+		m := module.Version{Path: mpath, Version: mver}
+		var files []zip.File
+		subModule := false // a regular sub/go.mod makes sub/ a submodule (an irregular one is omitted first)
+		for _, fs := range c.files {
+			if fs.name == "sub/go.mod" && fs.mode.IsRegular() {
+				subModule = true
+			}
+			files = append(files, fs.file(mpath))
+		}
+		cf, err := zip.CheckFiles(files)
+		// Every file in exactly one list.
+		where := map[string]int{}
+		for _, v := range cf.Valid {
+			where[v]++
+		}
+		for _, o := range cf.Omitted {
+			where[o.Path]++
+		}
+		for _, x := range cf.Invalid {
+			where[x.Path]++
+		}
+		for _, f := range files {
+			if where[f.Path()] != 1 {
+				ht.Fatalf("CheckFiles lists %q %d times (valid %v, omitted %v, invalid %v)", f.Path(), where[f.Path()], cf.Valid, cf.Omitted, cf.Invalid)
+			}
+		}
+		if len(where) != len(files) {
+			ht.Fatalf("CheckFiles lists %d names for %d files", len(where), len(files))
+		}
+		wantErr := len(cf.Invalid) > 0 || cf.SizeError != nil
+		if (err != nil) != wantErr || (cf.Err() != nil) != wantErr {
+			ht.Fatalf("CheckFiles error %v, Err() %v with %d invalid files", err, cf.Err(), len(cf.Invalid))
+		}
+		// Documented rules on the valid list.
+		for _, v := range cf.Valid {
+			if module.CheckFilePath(v) != nil {
+				ht.Fatalf("CheckFiles accepted %q, an invalid file path", v)
+			}
+			if strings.EqualFold(path.Base(v), "go.mod") && v != "go.mod" {
+				ht.Fatalf("CheckFiles accepted %q: go.mod files belong in the root only, named go.mod", v)
+			}
+		}
+		for i, a := range cf.Valid {
+			for _, b := range cf.Valid[i+1:] {
+				if strings.EqualFold(a, b) {
+					ht.Fatalf("CheckFiles accepted both %q and %q, equal under case folding", a, b)
+				}
+			}
+		}
+		for _, f := range files {
+			p := f.Path()
+			isOmitted := false
+			for _, o := range cf.Omitted {
+				isOmitted = isOmitted || o.Path == p
+			}
+			isInvalid := false
+			for _, x := range cf.Invalid {
+				isInvalid = isInvalid || x.Path == p
+			}
+			info, _ := f.Lstat()
+			switch {
+			case !info.Mode().IsRegular() && !isOmitted && !isInvalid:
+				ht.Fatalf("CheckFiles did not omit the irregular file %q (%v)", p, info.Mode())
+			case module.CheckFilePath(p) != nil && !isInvalid && !isOmitted:
+				ht.Fatalf("CheckFiles did not reject %q, an invalid file path", p)
+			}
+			if strings.HasPrefix(p, "vendor/") && isOmitted {
+				count(ht, "vendored omitted")
+			}
+			if strings.HasPrefix(p, "sub/") && subModule && info.Mode().IsRegular() && p != "sub/go.mod" && !isOmitted {
+				ht.Fatalf("CheckFiles kept %q, which is in the submodule sub/ (sub/go.mod is present)", p)
+			}
+		}
+		if len(cf.Omitted) > 0 {
+			count(ht, "omitted")
+		}
+		if len(cf.Invalid) > 0 {
+			count(ht, "invalid")
+		}
+		// Create.
+		var buf bytes.Buffer
+		cerr := zip.Create(&buf, m, files)
+		versionOK := module.Check(mpath, mver) == nil && module.CanonicalVersion(mver) == mver
+		if !versionOK {
+			if cerr == nil {
+				ht.Fatalf("Create(%v) accepted a non-canonical or mismatched version", m)
+			}
+			count(ht, "bad version rejected")
+			return
+		}
+		if (cerr == nil) != !wantErr {
+			ht.Fatalf("Create(%v) = %v while CheckFiles = %v", m, cerr, err)
+		}
+		if cerr != nil {
+			return
+		}
+		dir, err := os.MkdirTemp(root, "case-")
+		if err != nil {
+			ht.Fatalf("MkdirTemp: %v", err)
+		}
+		defer os.RemoveAll(dir)
+		zipPath := filepath.Join(dir, "m.zip")
+		if err := os.WriteFile(zipPath, buf.Bytes(), 0644); err != nil {
+			ht.Fatalf("WriteFile: %v", err)
+		}
+		cz, err := zip.CheckZip(m, zipPath)
+		if err != nil || cz.Err() != nil {
+			ht.Fatalf("CheckZip(Create(%v)) = %v / %v", m, err, cz.Err())
+		}
+		wantValid := append([]string(nil), cf.Valid...)
+		sort.Strings(wantValid)
+		// CheckZip lists the paths as they are in the zip: <module>@<version>/...
+		var gotValid []string
+		for _, v := range cz.Valid {
+			rel, ok := strings.CutPrefix(v, mpath+"@"+mver+"/")
+			if !ok {
+				ht.Fatalf("CheckZip lists %q without the %s@%s/ prefix", v, mpath, mver)
+			}
+			gotValid = append(gotValid, rel)
+		}
+		sort.Strings(gotValid)
+		if fmt.Sprint(gotValid) != fmt.Sprint(wantValid) {
+			ht.Fatalf("CheckZip valid files %v, CheckFiles valid files %v", gotValid, wantValid)
+		}
+		if len(cz.Omitted)+len(cz.Invalid) != 0 {
+			ht.Fatalf("CheckZip of a Create'd zip omits %v and rejects %v", cz.Omitted, cz.Invalid)
+		}
+		out := filepath.Join(dir, "out")
+		if err := zip.Unzip(out, m, zipPath); err != nil {
+			ht.Fatalf("Unzip(Create(%v)): %v", m, err)
+		}
+		// Unzip writes the files straight into dir (the go command's cache
+		// directory is named after the module and version already).
+		prefix := out
+		var extracted []string
+		filepath.Walk(out, func(p string, info os.FileInfo, err error) error {
+			if err == nil && info.Mode().IsRegular() {
+				rel, _ := filepath.Rel(prefix, p)
+				extracted = append(extracted, filepath.ToSlash(rel))
+			}
+			return nil
+		})
+		sort.Strings(extracted)
+		if fmt.Sprint(extracted) != fmt.Sprint(wantValid) {
+			ht.Fatalf("Unzip extracted %v under %s, want %v", extracted, prefix, wantValid)
+		}
+		for _, f := range files {
+			mf := f.(memFile)
+			for _, v := range cf.Valid {
+				if v == mf.name {
+					got, err := os.ReadFile(filepath.Join(prefix, filepath.FromSlash(v)))
+					if err != nil || !bytes.Equal(got, mf.data) {
+						ht.Fatalf("Unzip wrote %q with %d bytes (%v), want %d bytes", v, len(got), err, len(mf.data))
+					}
+				}
+			}
+		}
+		if len(wantValid) > 0 {
+			count(ht, "files extracted")
+		}
+		// Unzip into a non-empty directory fails.
+		if err := zip.Unzip(out, m, zipPath); err == nil && len(wantValid) > 0 {
+			ht.Fatalf("Unzip into the non-empty directory %s succeeded", out)
+		}
+		// A different version in Unzip fails: the paths in the zip carry the version.
+		other := module.Version{Path: mpath, Version: strings.TrimSuffix(mver, "+incompatible") + "-other"}
+		if module.CanonicalVersion(other.Version) == other.Version && len(wantValid) > 0 {
+			if err := zip.Unzip(filepath.Join(dir, "out2"), other, zipPath); err == nil {
+				ht.Fatalf("Unzip as %v of a zip for %v succeeded", other, m)
+			}
+		}
+	})
+}
