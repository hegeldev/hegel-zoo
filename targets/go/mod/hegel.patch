new file mode 100644
index 0000000..8cdc38a
--- /dev/null
+++ b/hegel/hegel_tlog_test.go
@@ -0,0 +1,924 @@
+package hegel
+
+// sumdb/tlog against RFC 6962's Merkle tree definitions and its own storage
+// and tile layout; sumdb/note against its signed-note format.
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	sdbnote "golang.org/x/mod/sumdb/note"
+	"golang.org/x/mod/sumdb/tlog"
+	"hegel.dev/go/hegel"
+)
+
+// memLog is an append-only log with the hash storage tlog expects.
+type memLog struct {
+	records [][]byte
+	hashes  []tlog.Hash
+}
+
+func (l *memLog) ReadHashes(indexes []int64) ([]tlog.Hash, error) {
+	out := make([]tlog.Hash, len(indexes))
+	for i, x := range indexes {
+		if x < 0 || x >= int64(len(l.hashes)) {
+			return nil, fmt.Errorf("memLog: index %d out of range (have %d hashes)", x, len(l.hashes))
+		}
+		out[i] = l.hashes[x]
+	}
+	return out, nil
+}
+
+func (l *memLog) append(ht *hegel.T, data []byte) {
+	n := int64(len(l.records))
+	hs, err := tlog.StoredHashes(n, data, l)
+	if err != nil {
+		ht.Fatalf("StoredHashes(%d): %v", n, err)
+	}
+	l.records = append(l.records, data)
+	l.hashes = append(l.hashes, hs...)
+}
+
+// records: a record's data: up to forty arbitrary bytes three times in
+// five, none, or a go.sum-like line.
+var records = weighted(
+	choice[[]byte]{3, hegel.Binary(0, 40)},
+	choice[[]byte]{1, hegel.Just([]byte(nil))},
+	choice[[]byte]{1, hegel.Map(pairs(hegel.Integers(0, 99), hegel.Integers(0, 1<<30)), func(p pair[int, int]) []byte {
+		return []byte(fmt.Sprintf("example.com/m v1.%d.0 h1:%032x\n", p.a, p.b))
+	})},
+)
+
+// recordLists: lo to hi records, or one time in ten lo to rare.
+func recordLists(lo, hi, rare int) hegel.Generator[[][]byte] {
+	sizes := weighted(choice[int]{9, hegel.Integers(lo, hi)}, choice[int]{1, hegel.Integers(lo, rare)})
+	return hegel.FlatMap(sizes, func(n int) hegel.Generator[[][]byte] { return fixed(records, n) })
+}
+
+// modelTreeHash is RFC 6962 section 2.1: MTH({}) = SHA-256(), MTH of one
+// leaf = SHA-256(0x00 || d), MTH(D[n]) = SHA-256(0x01 || MTH(D[0:k]) ||
+// MTH(D[k:n])) with k the largest power of two smaller than n.
+func modelTreeHash(records [][]byte) [32]byte {
+	switch len(records) {
+	case 0:
+		return sha256.Sum256(nil)
+	case 1:
+		return sha256.Sum256(append([]byte{0}, records[0]...))
+	}
+	k := 1
+	for k*2 < len(records) {
+		k *= 2
+	}
+	l, r := modelTreeHash(records[:k]), modelTreeHash(records[k:])
+	return sha256.Sum256(append(append([]byte{1}, l[:]...), r[:]...))
+}
+
+// treeCase: the records of a log (up to 70, or one time in ten up to 600),
+// a record and a stored hash to look at (indices modulo the counts), and a
+// storage position (level, n) to split.
+type treeCase struct {
+	records    [][]byte
+	at, stored int
+	level      int
+	idx        int64
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c treeCase) GoString() string {
+	return fmt.Sprintf("%d records %q, at %d, stored %d, level %d, idx %d", len(c.records), c.records, c.at, c.stored, c.level, c.idx)
+}
+
+var treeRecords = recordLists(0, 70, 600)
+
+var treeCases = hegel.Composite(func(tc hegel.TestCase) treeCase {
+	return treeCase{
+		records: hegel.Draw(tc, treeRecords),
+		at:      hegel.Draw(tc, hegel.Integers(0, 999)),
+		stored:  hegel.Draw(tc, hegel.Integers(0, 9999)),
+		level:   hegel.Draw(tc, hegel.Integers(0, 20)),
+		idx:     hegel.Draw(tc, hegel.Integers(int64(0), 1<<20)),
+	}
+})
+
+// TestHegelTlogTreeHashIsTheRFC6962Tree: TreeHash over stored hashes is the
+// RFC 6962 Merkle tree hash of the records, RecordHash and NodeHash are the
+// leaf and node hashes, StoredHashCount counts the stored hashes and
+// StoredHashIndex/SplitStoredHashIndex are inverses.
+func TestHegelTlogTreeHashIsTheRFC6962Tree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, treeCases)
+		l := &memLog{}
+		total := len(c.records)
+		for i, r := range c.records {
+			l.append(ht, r)
+			if got, want := int64(len(l.hashes)), tlog.StoredHashCount(int64(i+1)); got != want {
+				ht.Fatalf("after %d records %d hashes are stored, StoredHashCount says %d", i+1, got, want)
+			}
+		}
+		count(ht, fmt.Sprintf("size %d-%d", total/16*16, total/16*16+15))
+		th, err := tlog.TreeHash(int64(total), l)
+		if err != nil {
+			ht.Fatalf("TreeHash(%d): %v", total, err)
+		}
+		if want := modelTreeHash(l.records); th != tlog.Hash(want) {
+			ht.Fatalf("TreeHash(%d) = %v, RFC 6962 gives %x", total, th, want)
+		}
+		if total > 0 {
+			i := c.at % total
+			if got, want := tlog.RecordHash(l.records[i]), sha256.Sum256(append([]byte{0}, l.records[i]...)); got != tlog.Hash(want) {
+				ht.Fatalf("RecordHash = %v, SHA-256(0x00||data) = %x", got, want)
+			}
+			if got, want := l.hashes[tlog.StoredHashIndex(0, int64(i))], tlog.RecordHash(l.records[i]); got != want {
+				ht.Fatalf("stored level-0 hash %d = %v, RecordHash = %v", i, got, want)
+			}
+		}
+		if total >= 2 {
+			a, b := tlog.RecordHash(l.records[0]), tlog.RecordHash(l.records[1])
+			if got, want := tlog.NodeHash(a, b), sha256.Sum256(append(append([]byte{1}, a[:]...), b[:]...)); got != tlog.Hash(want) {
+				ht.Fatalf("NodeHash = %v, SHA-256(0x01||l||r) = %x", got, want)
+			}
+			if got := l.hashes[tlog.StoredHashIndex(1, 0)]; got != tlog.NodeHash(a, b) {
+				ht.Fatalf("stored level-1 hash 0 = %v, NodeHash of the first two records = %v", got, tlog.NodeHash(a, b))
+			}
+		}
+		// Storage indexes: a bijection between (level, n) and the dense order.
+		level, idx := c.level, c.idx
+		si := tlog.StoredHashIndex(level, idx)
+		if gl, gn := tlog.SplitStoredHashIndex(si); gl != level || gn != idx {
+			ht.Fatalf("SplitStoredHashIndex(StoredHashIndex(%d, %d) = %d) = %d, %d", level, idx, si, gl, gn)
+		}
+		if level == 0 && idx < int64(total) {
+			// Level 0's n'th hash is written right after level 1's ... (dense): index < count.
+			if si >= tlog.StoredHashCount(idx+1) {
+				ht.Fatalf("StoredHashIndex(0, %d) = %d >= StoredHashCount(%d) = %d", idx, si, idx+1, tlog.StoredHashCount(idx+1))
+			}
+		}
+		// Every stored index below the count splits into a node present in the tree.
+		if total > 0 {
+			x := int64(c.stored % int(tlog.StoredHashCount(int64(total))))
+			lv, k := tlog.SplitStoredHashIndex(x)
+			if (k+1)<<uint(lv) > int64(total) {
+				ht.Fatalf("stored index %d is (level %d, n %d), which needs %d records, have %d", x, lv, k, (k+1)<<uint(lv), total)
+			}
+		}
+	})
+}
+
+// flip: a tampering of a hash: which byte and what to xor into it.
+type flip struct {
+	at int
+	x  byte
+}
+
+var flips = hegel.Composite(func(tc hegel.TestCase) flip {
+	return flip{at: hegel.Draw(tc, hegel.Integers(0, 31)), x: byte(hegel.Draw(tc, hegel.Integers(1, 255)))}
+})
+
+// proofCase: the records of a log (1 to 80, or one time in ten up to 700),
+// two records and two earlier sizes to prove (modulo the size), the
+// tamperings of the record hash, the tree hash, one proof hash (proofAt,
+// modulo the proof's length) and the earlier tree hash, and a tile height.
+type proofCase struct {
+	records                   [][]byte
+	at, other                 int
+	size, size2               int
+	rec, tree, proof, earlier flip
+	proofAt                   int
+	height                    int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c proofCase) GoString() string {
+	return fmt.Sprintf("%d records %q, at %d, other %d, size %d, size2 %d, flips %v %v %v %v at %d, height %d",
+		len(c.records), c.records, c.at, c.other, c.size, c.size2, c.rec, c.tree, c.proof, c.earlier, c.proofAt, c.height)
+}
+
+var proofRecords = recordLists(1, 80, 700)
+
+var proofCases = hegel.Composite(func(tc hegel.TestCase) proofCase {
+	return proofCase{
+		records: hegel.Draw(tc, proofRecords),
+		at:      hegel.Draw(tc, hegel.Integers(0, 999)),
+		other:   hegel.Draw(tc, hegel.Integers(0, 999)),
+		size:    hegel.Draw(tc, hegel.Integers(0, 999)),
+		size2:   hegel.Draw(tc, hegel.Integers(0, 999)),
+		rec:     hegel.Draw(tc, flips),
+		tree:    hegel.Draw(tc, flips),
+		proof:   hegel.Draw(tc, flips),
+		earlier: hegel.Draw(tc, flips),
+		proofAt: hegel.Draw(tc, hegel.Integers(0, 63)),
+		height:  hegel.Draw(tc, hegel.Integers(1, 4)),
+	}
+})
+
+// TestHegelTlogProofsVerifyAndTamperingFails: for a log of t records,
+// ProveRecord(t, n) passes CheckRecord with the tree hash and the record's
+// hash and fails with any other record, index or tree hash; ProveTree(t, n)
+// passes CheckTree with the two tree hashes and fails with a different
+// earlier hash; the same holds when the hashes come through TileHashReader.
+func TestHegelTlogProofsVerifyAndTamperingFails(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, proofCases)
+		l := &memLog{}
+		total := len(c.records)
+		for _, r := range c.records {
+			l.append(ht, r)
+		}
+		T := int64(total)
+		th, err := tlog.TreeHash(T, l)
+		if err != nil {
+			ht.Fatalf("TreeHash(%d): %v", T, err)
+		}
+		// Record proof.
+		i := int64(c.at % total)
+		p, err := tlog.ProveRecord(T, i, l)
+		if err != nil {
+			ht.Fatalf("ProveRecord(%d, %d): %v", T, i, err)
+		}
+		h := tlog.RecordHash(l.records[i])
+		if err := tlog.CheckRecord(p, T, th, i, h); err != nil {
+			ht.Fatalf("CheckRecord(ProveRecord(%d, %d)): %v", T, i, err)
+		}
+		if want := 0; T > 1 {
+			// A proof has one hash per level: ceil(log2 T) at most, and at least 1.
+			want = 1
+			if len(p) < want || len(p) > 64 {
+				ht.Fatalf("ProveRecord(%d, %d) has %d hashes", T, i, len(p))
+			}
+		}
+		// Tampering: another record's hash, another index, another tree hash, a changed proof.
+		bad := h
+		bad[c.rec.at] ^= c.rec.x
+		if err := tlog.CheckRecord(p, T, th, i, bad); err == nil {
+			ht.Fatalf("CheckRecord accepted a changed record hash (t=%d n=%d)", T, i)
+		}
+		if T > 1 {
+			j := int64(c.other % total)
+			if j != i && !bytes.Equal(l.records[j], l.records[i]) { // equal records share a hash, and the proof
+				if err := tlog.CheckRecord(p, T, th, j, h); err == nil {
+					ht.Fatalf("CheckRecord accepted record %d's proof for index %d (t=%d)", i, j, T)
+				}
+				count(ht, "other index rejected")
+			}
+		}
+		badTH := th
+		badTH[c.tree.at] ^= c.tree.x
+		if err := tlog.CheckRecord(p, T, badTH, i, h); err == nil {
+			ht.Fatalf("CheckRecord accepted a changed tree hash (t=%d n=%d)", T, i)
+		}
+		if len(p) > 0 {
+			q := append(tlog.RecordProof(nil), p...)
+			q[c.proofAt%len(q)][c.proof.at] ^= c.proof.x
+			if err := tlog.CheckRecord(q, T, th, i, h); err == nil {
+				ht.Fatalf("CheckRecord accepted a changed proof (t=%d n=%d)", T, i)
+			}
+			if err := tlog.CheckRecord(q[:len(q)-1], T, th, i, h); err == nil {
+				ht.Fatalf("CheckRecord accepted a truncated proof (t=%d n=%d)", T, i)
+			}
+		}
+		if err := tlog.CheckRecord(p, T, th, T, h); err == nil {
+			ht.Fatalf("CheckRecord accepted n = t")
+		}
+		// Tree (consistency) proof.
+		m := int64(1 + c.size%total)
+		hm, err := tlog.TreeHash(m, l)
+		if err != nil {
+			ht.Fatalf("TreeHash(%d): %v", m, err)
+		}
+		tp, err := tlog.ProveTree(T, m, l)
+		if err != nil {
+			ht.Fatalf("ProveTree(%d, %d): %v", T, m, err)
+		}
+		if err := tlog.CheckTree(tp, T, th, m, hm); err != nil {
+			ht.Fatalf("CheckTree(ProveTree(%d, %d)): %v", T, m, err)
+		}
+		if m == T {
+			count(ht, "tree proof of itself")
+			if len(tp) != 0 {
+				count(ht, "nonempty proof for n = t")
+			}
+		}
+		badHM := hm
+		badHM[c.earlier.at] ^= c.earlier.x
+		if err := tlog.CheckTree(tp, T, th, m, badHM); err == nil {
+			ht.Fatalf("CheckTree accepted a changed earlier tree hash (t=%d n=%d)", T, m)
+		}
+		if err := tlog.CheckTree(tp, T, badTH, m, hm); err == nil {
+			ht.Fatalf("CheckTree accepted a changed tree hash (t=%d n=%d)", T, m)
+		}
+		if m < T {
+			// The proof for a different earlier size does not verify, unless
+			// repeated records make it the very proof of that size (a log
+			// ending in equal records: sizes 5 and 7 of 8 share their proofs).
+			m2 := int64(1 + c.size2%total)
+			tp2, _ := tlog.ProveTree(T, m2, l)
+			if m2 != m && fmt.Sprint(tp2) != fmt.Sprint(tp) {
+				hm2, _ := tlog.TreeHash(m2, l)
+				if err := tlog.CheckTree(tp, T, th, m2, hm2); err == nil {
+					ht.Fatalf("CheckTree accepted the proof for size %d as one for size %d (t=%d)", m, m2, T)
+				}
+			}
+		}
+		// The same through tiles.
+		hgt := c.height
+		tree := tlog.Tree{N: T, Hash: th}
+		tr := tlog.TileHashReader(tree, &memTiles{h: hgt, l: l})
+		th2, err := tlog.TreeHash(T, tr)
+		if err != nil || th2 != th {
+			ht.Fatalf("TreeHash through tiles of height %d = %v, %v; direct %v", hgt, th2, err, th)
+		}
+		p2, err := tlog.ProveRecord(T, i, tr)
+		if err != nil {
+			ht.Fatalf("ProveRecord(%d, %d) through tiles of height %d: %v", T, i, hgt, err)
+		} else if fmt.Sprint(p2) != fmt.Sprint(p) {
+			ht.Fatalf("ProveRecord through tiles differs from the direct proof (t=%d n=%d h=%d)", T, i, hgt)
+		}
+		tp2, err := tlog.ProveTree(T, m, tr)
+		if err != nil {
+			ht.Fatalf("ProveTree(%d, %d) through tiles of height %d: %v", T, m, hgt, err)
+		} else if fmt.Sprint(tp2) != fmt.Sprint(tp) {
+			ht.Fatalf("ProveTree through tiles differs from the direct proof (t=%d n=%d h=%d)", T, m, hgt)
+		}
+		// A tile reader serving a wrong hash is caught by TileHashReader.
+		evil := &memTiles{h: hgt, l: l, corrupt: true}
+		tr2 := tlog.TileHashReader(tree, evil)
+		if _, err := tlog.ProveRecord(T, i, tr2); err == nil && evil.corrupted {
+			ht.Fatalf("TileHashReader accepted a corrupted tile (t=%d n=%d h=%d)", T, i, hgt)
+		}
+		if evil.corrupted {
+			count(ht, "corrupt tile rejected")
+		}
+	})
+}
+
+// memTiles serves tiles from a memLog.
+type memTiles struct {
+	h         int
+	l         *memLog
+	corrupt   bool
+	corrupted bool
+	saved     int
+}
+
+func (m *memTiles) Height() int { return m.h }
+func (m *memTiles) ReadTiles(tiles []tlog.Tile) ([][]byte, error) {
+	out := make([][]byte, len(tiles))
+	for i, t := range tiles {
+		d, err := tlog.ReadTileData(t, m.l)
+		if err != nil {
+			return nil, err
+		}
+		if m.corrupt && len(d) > 0 && !m.corrupted {
+			d = append([]byte(nil), d...)
+			d[len(d)/2] ^= 0x55
+			m.corrupted = true
+		}
+		out[i] = d
+	}
+	return out, nil
+}
+func (m *memTiles) SaveTiles(tiles []tlog.Tile, data [][]byte) { m.saved += len(tiles) }
+
+// tileCase: a tile height, the records of a log (1 to 120), a stored hash
+// to locate (modulo the count), an arbitrary tile (level, n, width modulo
+// 2^height) for the path round trip, and an earlier size (modulo the
+// count of records plus one) for incremental publishing.
+type tileCase struct {
+	height  int
+	records [][]byte
+	idx     int
+	level   int
+	n       int64
+	width   int
+	old     int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c tileCase) GoString() string {
+	return fmt.Sprintf("height %d, %d records %q, idx %d, level %d, n %d, width %d, old %d", c.height, len(c.records), c.records, c.idx, c.level, c.n, c.width, c.old)
+}
+
+var tileCases = hegel.Composite(func(tc hegel.TestCase) tileCase {
+	return tileCase{
+		height:  hegel.Draw(tc, hegel.Integers(1, 5)),
+		records: hegel.Draw(tc, many(records, 1, 120)),
+		idx:     hegel.Draw(tc, hegel.Integers(0, 9999)),
+		level:   hegel.Draw(tc, hegel.Integers(0, 63)),
+		n:       hegel.Draw(tc, hegel.Integers(int64(0), 1<<40)),
+		width:   hegel.Draw(tc, hegel.Integers(0, 31)),
+		old:     hegel.Draw(tc, hegel.Integers(0, 999)),
+	}
+})
+
+// TestHegelTlogTilesRoundTrip: TileForIndex gives the least tile holding a
+// stored hash, HashFromTile reads it back from ReadTileData, Tile.Path and
+// ParseTilePath are inverses, and NewTiles(h, 0, n) covers every stored
+// hash of a tree of size n; NewTiles(h, n, n) is empty.
+func TestHegelTlogTilesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, tileCases)
+		h := c.height
+		l := &memLog{}
+		total := len(c.records)
+		for _, r := range c.records {
+			l.append(ht, r)
+		}
+		cnt := tlog.StoredHashCount(int64(total))
+		idx := int64(c.idx % int(cnt))
+		tile := tlog.TileForIndex(h, idx)
+		note(ht, "tile=%+v", tile)
+		if tile.H != h || tile.W < 1 || tile.W > 1<<uint(h) || tile.L < 0 || tile.N < 0 {
+			ht.Fatalf("TileForIndex(%d, %d) = %+v out of range", h, idx, tile)
+		}
+		lv, _ := tlog.SplitStoredHashIndex(idx)
+		// The tile at level L = lv/h, N = k >> (h*(L+1)-lv)... simpler: the
+		// tile's leaves are at tree level h*L and the index lies in its subtree.
+		if lv/h != tile.L {
+			ht.Fatalf("TileForIndex(%d, %d) = %+v, but the hash is at tree level %d (tile level %d)", h, idx, tile, lv, lv/h)
+		}
+		if tile.W%2 != 0 && tile.W != 1 {
+			count(ht, "odd width")
+		}
+		data, err := tlog.ReadTileData(tile, l)
+		if err != nil {
+			ht.Fatalf("ReadTileData(%+v): %v", tile, err)
+		}
+		if len(data) != tile.W*tlog.HashSize {
+			ht.Fatalf("ReadTileData(%+v) has %d bytes, want W*HashSize = %d", tile, len(data), tile.W*tlog.HashSize)
+		}
+		got, err := tlog.HashFromTile(tile, data, idx)
+		if err != nil || got != l.hashes[idx] {
+			ht.Fatalf("HashFromTile(%+v, idx %d) = %v, %v; stored %v", tile, idx, got, err, l.hashes[idx])
+		}
+		// Path round trip, including partial tiles and the data level.
+		for _, tt := range []tlog.Tile{tile, {H: h, L: -1, N: tile.N, W: tile.W}, {H: h, L: c.level, N: c.n, W: 1 + c.width%(1<<uint(h))}} {
+			path := tt.Path()
+			back, err := tlog.ParseTilePath(path)
+			if err != nil || back != tt {
+				ht.Fatalf("ParseTilePath(%+v.Path() = %q) = %+v, %v", tt, path, back, err)
+			}
+			if !strings.HasPrefix(path, "tile/"+strconv.Itoa(h)+"/") {
+				ht.Fatalf("%+v.Path() = %q", tt, path)
+			}
+			if tt.L == -1 && !strings.HasPrefix(path, "tile/"+strconv.Itoa(h)+"/data/") {
+				ht.Fatalf("data tile %+v.Path() = %q, want tile/%d/data/...", tt, path, h)
+			}
+			if tt.W < 1<<uint(h) && !strings.Contains(path, ".p/"+strconv.Itoa(tt.W)) {
+				ht.Fatalf("partial tile %+v.Path() = %q lacks .p/W", tt, path)
+			}
+			if tt.W == 1<<uint(h) && strings.Contains(path, ".p/") {
+				ht.Fatalf("complete tile %+v.Path() = %q has .p/", tt, path)
+			}
+		}
+		// NewTiles from zero covers the storage; from the same size is empty.
+		tiles := tlog.NewTiles(h, 0, int64(total))
+		if len(tlog.NewTiles(h, int64(total), int64(total))) != 0 {
+			ht.Fatalf("NewTiles(%d, %d, %d) is not empty", h, total, total)
+		}
+		covered := func(want tlog.Tile) bool {
+			for _, tt := range tiles {
+				if tt.H == want.H && tt.L == want.L && tt.N == want.N && tt.W >= want.W {
+					return true
+				}
+			}
+			return false
+		}
+		for x := int64(0); x < cnt; x++ {
+			if !covered(tlog.TileForIndex(h, x)) {
+				ht.Fatalf("NewTiles(%d, 0, %d) = %v does not cover stored hash %d (tile %+v)", h, total, tiles, x, tlog.TileForIndex(h, x))
+			}
+		}
+		// Incremental publishing: tiles from old to total, plus tiles up to old, cover the storage too.
+		old := int64(c.old % (total + 1))
+		inc := append(tlog.NewTiles(h, 0, old), tlog.NewTiles(h, old, int64(total))...)
+		tiles = inc
+		for x := int64(0); x < cnt; x++ {
+			if !covered(tlog.TileForIndex(h, x)) {
+				ht.Fatalf("NewTiles(%d, 0, %d) + NewTiles(%d, %d, %d) does not cover stored hash %d", h, old, h, old, total, x)
+			}
+		}
+		if old > 0 && old < int64(total) {
+			count(ht, "incremental")
+		}
+	})
+}
+
+// recordText: a record's text as drawn: one to four non-empty lines (of one
+// to three pieces, a control character or an invalid byte among them one
+// time in forty), or no line at all; an empty line inserted after one of
+// them 6% of the time (a blank line inside, or a trailing one), an empty
+// first line 3% (Known bug mod/7), and the final newline dropped 5%.
+type recordText struct {
+	lines     []string
+	blankAt   *int
+	leading   bool
+	noNewline bool
+}
+
+func (r recordText) render() string {
+	lines := slices.Clone(r.lines)
+	if r.blankAt != nil && len(lines) > 0 {
+		lines = slices.Insert(lines, 1+*r.blankAt%len(lines), "")
+	}
+	if r.leading {
+		lines = slices.Insert(lines, 0, "")
+	}
+	s := strings.Join(lines, "\n")
+	if len(lines) > 0 && !r.noNewline {
+		s += "\n"
+	}
+	return s
+}
+
+var (
+	linePieces = weighted(
+		choice[string]{39, hegel.SampledFrom([]string{"example.com/m", " ", "v1.0.0", "h1:abc=", "\u00e9", "\u4e2d", "x"})},
+		choice[string]{1, hegel.SampledFrom([]string{"\t", "\r", "\xff"})},
+	)
+	recordLines = joined(many(linePieces, 1, 3), "")
+	// recordLineLists: no line at all (an empty text) one time in 25.
+	recordLineLists = weighted(
+		choice[[]string]{1, hegel.Just([]string(nil))},
+		choice[[]string]{24, many(recordLines, 1, 4)},
+	)
+	recordTexts = hegel.Map(hegel.Composite(func(tc hegel.TestCase) recordText {
+		return recordText{
+			lines:     hegel.Draw(tc, recordLineLists),
+			blankAt:   hegel.Draw(tc, optional(6, hegel.Integers(0, 9))),
+			leading:   hegel.Draw(tc, chance(3)),
+			noNewline: hegel.Draw(tc, chance(5)),
+		}
+	}), recordText.render)
+)
+
+// noteFormatCase: a tree hash and size, a record id and text, and what
+// follows the record in the input.
+type noteFormatCase struct {
+	hash tlog.Hash
+	n    int64
+	id   int64
+	text string
+	rest string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c noteFormatCase) GoString() string {
+	return fmt.Sprintf("hash %v, n %d, id %d, text %s, rest %q", c.hash, c.n, c.id, show(c.text), c.rest)
+}
+
+var noteFormatCases = hegel.Composite(func(tc hegel.TestCase) noteFormatCase {
+	var h tlog.Hash
+	copy(h[:], hegel.Draw(tc, hegel.Binary(32, 32)))
+	return noteFormatCase{
+		hash: h,
+		n:    hegel.Draw(tc, hegel.Integers(int64(0), 1<<50)),
+		id:   hegel.Draw(tc, hegel.Integers(int64(0), 1<<40)),
+		text: hegel.Draw(tc, recordTexts),
+		rest: hegel.Draw(tc, hegel.SampledFrom([]string{"", "7\nnext record\n\n", "garbage"})),
+	}
+})
+
+// TestHegelTlogNoteFormatsRoundTrip: FormatTree/ParseTree, FormatRecord/
+// ParseRecord (with the rest of the input returned) and the Hash text and
+// JSON encodings are inverses; FormatRecord rejects the record texts its
+// documentation excludes.
+func TestHegelTlogNoteFormatsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, noteFormatCases)
+		h := c.hash
+		tree := tlog.Tree{N: c.n, Hash: h}
+		text := tlog.FormatTree(tree)
+		if !bytes.HasPrefix(text, []byte("go.sum database tree\n")) || bytes.Count(text, []byte("\n")) != 3 {
+			ht.Fatalf("FormatTree = %q", text)
+		}
+		back, err := tlog.ParseTree(text)
+		if err != nil || back != tree {
+			ht.Fatalf("ParseTree(FormatTree(%+v) = %q) = %+v, %v", tree, text, back, err)
+		}
+		// Extra lines are ignored for forwards compatibility.
+		if back, err := tlog.ParseTree(append(append([]byte(nil), text...), "extra line\n"...)); err != nil || back != tree {
+			ht.Fatalf("ParseTree with an extra line = %+v, %v", back, err)
+		}
+		// Hash encodings.
+		s := h.String()
+		if ph, err := tlog.ParseHash(s); err != nil || ph != h {
+			ht.Fatalf("ParseHash(%q) = %v, %v; want %v", s, ph, err, h)
+		}
+		js, err := json.Marshal(h)
+		var jh tlog.Hash
+		if err != nil || json.Unmarshal(js, &jh) != nil || jh != h {
+			ht.Fatalf("Hash JSON round trip: %s -> %v (%v)", js, jh, err)
+		}
+		if bad := s[:len(s)-1] + "!"; func() bool { _, err := tlog.ParseHash(bad); return err == nil }() {
+			ht.Fatalf("ParseHash(%q) accepted a malformed hash", bad)
+		}
+		// Records.
+		id, rt := c.id, c.text
+		valid := utf8.ValidString(rt) && strings.HasSuffix(rt, "\n") && !strings.Contains(rt, "\n\n") && !strings.HasPrefix(rt, "\n")
+		for _, r := range rt {
+			if r < 0x20 && r != '\n' {
+				valid = false
+			}
+		}
+		if strings.Contains(rt, "\x7f") {
+			count(ht, "DEL in text") // not below U+0020: allowed by the doc
+		}
+		msg, err := tlog.FormatRecord(id, []byte(rt))
+		if (err == nil) != valid {
+			if err == nil && strings.HasPrefix(rt, "\n") && Known.RecordLeadingBlank {
+				// Known bug mod/7: a text starting with a blank line is accepted.
+				count(ht, "mod/7 leading blank line accepted")
+				return
+			}
+			ht.Fatalf("FormatRecord(%d, %s) = %v; the doc says valid=%v", id, show(rt), err, valid)
+		}
+		if !valid {
+			count(ht, "invalid record text")
+			return
+		}
+		if rt == "" {
+			count(ht, "empty record")
+		}
+		if !bytes.HasPrefix(msg, []byte(strconv.FormatInt(id, 10)+"\n")) || !bytes.HasSuffix(msg, []byte("\n\n")) {
+			ht.Fatalf("FormatRecord(%d, %s) = %q", id, show(rt), msg)
+		}
+		rest := []byte(c.rest)
+		gid, gtext, grest, err := tlog.ParseRecord(append(append([]byte(nil), msg...), rest...))
+		if err != nil || gid != id || string(gtext) != rt || !bytes.Equal(grest, rest) {
+			ht.Fatalf("ParseRecord(FormatRecord(%d, %s)+%q) = %d, %s, %q, %v", id, show(rt), rest, gid, show(string(gtext)), grest, err)
+		}
+	})
+}
+
+// Names: non-empty, UTF-8, no Unicode spaces nor '+'. The bad pieces are a
+// space, a plus, a no-break space, an em space, a newline and an invalid
+// byte.
+var (
+	namePieces    = hegel.SampledFrom([]string{"sum.golang.org", "example", "/", "-", "x", "\u00e9", "\u4e2d", "0"})
+	badNamePieces = hegel.SampledFrom([]string{" ", "+", "\u00a0", "\u2003", "\n", "\xff"})
+	// validNames: one to three name pieces.
+	validNames = joined(many(namePieces, 1, 3), "")
+	// invalidNames: empty, or a bad piece among up to two name pieces.
+	invalidNames = weighted(
+		choice[string]{1, hegel.Just("")},
+		choice[string]{3, cat(joined(many(namePieces, 0, 1), ""), badNamePieces, joined(many(namePieces, 0, 1), ""))},
+	)
+	textPieces    = hegel.SampledFrom([]string{"go.sum database tree", "\n", "\n", "123", " ", "\u00e9", "\u4e2d", "\u2014 fake sig\n", "x"})
+	badTextPieces = hegel.SampledFrom([]string{"\t", "\r", "\xff"})
+)
+
+// badPiece: an invalid piece of a note's text and where it goes among the
+// pieces (modulo their number plus one).
+type badPiece struct {
+	piece string
+	at    int
+}
+
+// textSpec: a note's text as drawn: up to five pieces, a control character
+// or an invalid byte among them 3% of the time (Known bug mod/6), and the
+// final newline not added 10% of the time.
+type textSpec struct {
+	pieces    []string
+	bad       *badPiece
+	noNewline bool
+}
+
+func (t textSpec) render() string {
+	pieces := slices.Clone(t.pieces)
+	if t.bad != nil {
+		pieces = slices.Insert(pieces, t.bad.at%(len(pieces)+1), t.bad.piece)
+	}
+	s := strings.Join(pieces, "")
+	if !t.noNewline && !strings.HasSuffix(s, "\n") {
+		s += "\n"
+	}
+	return s
+}
+
+var noteTexts = hegel.Map(hegel.Composite(func(tc hegel.TestCase) textSpec {
+	return textSpec{
+		pieces: hegel.Draw(tc, many(textPieces, 0, 5)),
+		bad: hegel.Draw(tc, optional(3, hegel.Composite(func(tc hegel.TestCase) badPiece {
+			return badPiece{piece: hegel.Draw(tc, badTextPieces), at: hegel.Draw(tc, hegel.Integers(0, 9))}
+		}))),
+		noNewline: hegel.Draw(tc, chance(10)),
+	}
+}), textSpec.render)
+
+// noteCase: one to three signer names, a name GenerateKey must reject 10%
+// of the time (Known bug mod/5), the text, and the tamperings: a byte of
+// the text (textAt, modulo its length less one) replaced by textCh, and a
+// byte of the last signature (sigBack from the end) replaced by sigCh.
+type noteCase struct {
+	names   []string
+	badName *string
+	text    string
+	textAt  int
+	textCh  byte
+	sigBack int
+	sigCh   byte
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c noteCase) GoString() string {
+	bad := "none"
+	if c.badName != nil {
+		bad = show(*c.badName)
+	}
+	names := make([]string, len(c.names))
+	for i, n := range c.names {
+		names[i] = show(n)
+	}
+	return fmt.Sprintf("names %s, bad name %s, text %s, text tamper %d/%c, signature tamper %d/%c", strings.Join(names, " "), bad, show(c.text), c.textAt, c.textCh, c.sigBack, c.sigCh)
+}
+
+var noteCases = hegel.Composite(func(tc hegel.TestCase) noteCase {
+	return noteCase{
+		names:   hegel.Draw(tc, many(validNames, 1, 3)),
+		badName: hegel.Draw(tc, optional(10, invalidNames)),
+		text:    hegel.Draw(tc, noteTexts),
+		textAt:  hegel.Draw(tc, hegel.Integers(0, 999)),
+		textCh:  hegel.Draw(tc, hegel.SampledFrom([]byte("z0-"))),
+		sigBack: hegel.Draw(tc, hegel.Integers(0, 10)),
+		sigCh:   hegel.Draw(tc, hegel.SampledFrom([]byte("Az0+/"))),
+	}
+})
+
+func nameOK(s string) bool {
+	if s == "" || !utf8.ValidString(s) {
+		return false
+	}
+	for _, r := range s {
+		if unicode.IsSpace(r) || r == '+' {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelNoteSignThenOpen: a note signed by generated keys opens with those
+// verifiers and yields the text and the signer names; a missing verifier
+// leaves an unverified signature (or fails the note when none is known);
+// changing the text or a signature fails; GenerateKey and Sign reject the
+// names and texts the package doc excludes.
+func TestHegelNoteSignThenOpen(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, noteCases)
+		allNames := c.names
+		if c.badName != nil {
+			allNames = append(slices.Clone(allNames), *c.badName)
+		}
+		var signers []sdbnote.Signer
+		var verifiers []sdbnote.Verifier
+		var names []string
+		for _, name := range allNames {
+			skey, vkey, err := sdbnote.GenerateKey(rand.Reader, name)
+			if (err == nil) != nameOK(name) {
+				if err == nil && Known.GenerateKeyAnyName {
+					// Known bug mod/5: GenerateKey does not check the name; the keys
+					// it returns are then rejected by NewSigner and NewVerifier.
+					count(ht, "mod/5 GenerateKey with an invalid name")
+					if _, err := sdbnote.NewSigner(skey); err == nil {
+						ht.Fatalf("NewSigner accepted the key %q for the invalid name %s", skey, show(name))
+					}
+					if _, err := sdbnote.NewVerifier(vkey); err == nil && !strings.Contains(name, "+") {
+						ht.Fatalf("NewVerifier accepted the key %q for the invalid name %s", vkey, show(name))
+					}
+					continue
+				}
+				ht.Fatalf("GenerateKey(%s) = %v; the doc says the name is valid=%v", show(name), err, nameOK(name))
+			}
+			if err != nil {
+				count(ht, "bad name rejected")
+				continue
+			}
+			s, err := sdbnote.NewSigner(skey)
+			if err != nil {
+				ht.Fatalf("NewSigner(%q): %v", skey, err)
+			}
+			v, err := sdbnote.NewVerifier(vkey)
+			if err != nil {
+				ht.Fatalf("NewVerifier(%q): %v", vkey, err)
+			}
+			if s.Name() != name || v.Name() != name || s.KeyHash() != v.KeyHash() {
+				ht.Fatalf("GenerateKey(%s): signer %q/%08x, verifier %q/%08x", show(name), s.Name(), s.KeyHash(), v.Name(), v.KeyHash())
+			}
+			if !strings.HasPrefix(skey, "PRIVATE+KEY+"+name+"+") || !strings.HasPrefix(vkey, name+"+") {
+				ht.Fatalf("GenerateKey(%s) = %q, %q: not <name>+<hash>+<key> forms", show(name), skey, vkey)
+			}
+			signers = append(signers, s)
+			verifiers = append(verifiers, v)
+			names = append(names, name)
+		}
+		k := len(signers)
+		// Text: UTF-8, no control characters but newline, ending in newline.
+		text := c.text
+		textOK := text != "" && utf8.ValidString(text) && strings.HasSuffix(text, "\n")
+		for _, r := range text {
+			if r < 0x20 && r != '\n' {
+				textOK = false
+			}
+		}
+		msg, err := sdbnote.Sign(&sdbnote.Note{Text: text}, signers...)
+		if (err == nil) != textOK {
+			if err == nil && Known.SignControlChars {
+				// Known bug mod/6: Sign accepts control characters and invalid
+				// UTF-8 in the text and produces a message Open calls malformed.
+				count(ht, "mod/6 Sign of an invalid text")
+				if _, err := sdbnote.Open(msg, sdbnote.VerifierList(verifiers...)); err == nil {
+					ht.Fatalf("Open accepted the signed invalid text %s", show(text))
+				}
+				return
+			}
+			ht.Fatalf("Sign(%s) = %v; the doc says the text is valid=%v", show(text), err, textOK)
+		}
+		if !textOK {
+			count(ht, "bad text rejected")
+			return
+		}
+		if strings.Contains(text, "\n\n") {
+			count(ht, "blank line in text")
+		}
+		if !bytes.HasPrefix(msg, []byte(text+"\n")) {
+			ht.Fatalf("Sign(%s) = %q does not start with the text and a blank line", show(text), msg)
+		}
+		if bytes.Count(msg[len(text)+1:], []byte("\n")) != k || !bytes.HasPrefix(msg[len(text)+1:], []byte("\u2014 ")) {
+			ht.Fatalf("Sign(%s) = %q: want %d signature lines starting with an em dash", show(text), msg, k)
+		}
+		opened, err := sdbnote.Open(msg, sdbnote.VerifierList(verifiers...))
+		if err != nil {
+			ht.Fatalf("Open(Sign(%s)): %v\n%s", show(text), err, msg)
+		}
+		if opened.Text != text || len(opened.Sigs) != k || len(opened.UnverifiedSigs) != 0 {
+			ht.Fatalf("Open: text %s, %d sigs, %d unverified; want %s, %d, 0", show(opened.Text), len(opened.Sigs), len(opened.UnverifiedSigs), show(text), k)
+		}
+		for i, sig := range opened.Sigs {
+			if sig.Name != names[i] || sig.Hash != verifiers[i].KeyHash() {
+				ht.Fatalf("Open: signature %d is %q/%08x, want %q/%08x", i, sig.Name, sig.Hash, names[i], verifiers[i].KeyHash())
+			}
+		}
+		// A verifier missing: unverified when others verify, an error when none does.
+		if k > 1 {
+			opened, err := sdbnote.Open(msg, sdbnote.VerifierList(verifiers[1:]...))
+			if err != nil || len(opened.Sigs) != k-1 || len(opened.UnverifiedSigs) != 1 || opened.UnverifiedSigs[0].Name != names[0] {
+				ht.Fatalf("Open without the first verifier: %v, %d sigs, %d unverified", err, len(opened.Sigs), len(opened.UnverifiedSigs))
+			}
+		}
+		if _, err := sdbnote.Open(msg, sdbnote.VerifierList()); err == nil {
+			ht.Fatalf("Open with no verifiers succeeded")
+		} else if _, ok := err.(*sdbnote.UnverifiedNoteError); !ok {
+			ht.Fatalf("Open with no verifiers: %T %v, want UnverifiedNoteError", err, err)
+		}
+		// Tampering with the text or a signature.
+		if len(text) > 1 {
+			bad := append([]byte(nil), msg...)
+			i := c.textAt % (len(text) - 1)
+			bad[i] = c.textCh
+			if !bytes.Equal(bad, msg) {
+				if _, err := sdbnote.Open(bad, sdbnote.VerifierList(verifiers...)); err == nil {
+					ht.Fatalf("Open accepted a changed text\n%s", bad)
+				} else if _, ok := err.(*sdbnote.InvalidSignatureError); !ok && utf8.Valid(bad) {
+					count(ht, "changed text: "+fmt.Sprintf("%T", err))
+				}
+			}
+		}
+		{
+			bad := append([]byte(nil), msg...)
+			i := len(bad) - 2 - c.sigBack // inside the last signature's base64
+			if bad[i] != '\n' && bad[i] != ' ' {
+				bad[i] = c.sigCh
+				// The last base64 character carries two padding bits that
+				// decoding ignores, so a change there may leave the signature
+				// bytes as they were.
+				sameBytes := func(a, b []byte) bool {
+					fa, fb := bytes.Fields(a), bytes.Fields(b)
+					da, erra := base64.StdEncoding.DecodeString(string(fa[len(fa)-1]))
+					db, errb := base64.StdEncoding.DecodeString(string(fb[len(fb)-1]))
+					return erra == nil && errb == nil && bytes.Equal(da, db)
+				}
+				if sameBytes(bad, msg) {
+					count(ht, "signature change invisible to base64")
+				} else if !bytes.Equal(bad, msg) {
+					if _, err := sdbnote.Open(bad, sdbnote.VerifierList(verifiers...)); err == nil {
+						ht.Fatalf("Open accepted a changed signature\n%s", bad)
+					}
+				}
+			}
+		}
+		// Sign of an opened note reproduces the message (signatures are deterministic in Ed25519).
+		msg2, err := sdbnote.Sign(&sdbnote.Note{Text: text}, signers...)
+		if err != nil || !bytes.Equal(msg2, msg) {
+			ht.Fatalf("Sign twice differs (%v):\n%s\n%s", err, msg, msg2)
+		}
+	})
+}
