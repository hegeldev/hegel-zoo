+func pickRequirePath(tc hegel.TestCase, m *modelFile) string {
+	if len(m.require) > 0 && chance(tc, 70) {
+		return m.require[n(tc, 0, len(m.require)-1)].Mod.Path
+	}
+	p, _ := genModule(tc)
+	return p
+}
+
+func pickExclude(tc hegel.TestCase, m *modelFile) module.Version {
+	if len(m.exclude) > 0 && chance(tc, 70) {
+		var xs []module.Version
+		for x := range m.exclude {
+			xs = append(xs, x)
+		}
+		sort.Slice(xs, func(i, j int) bool { return xs[i].String() < xs[j].String() })
+		return xs[n(tc, 0, len(xs)-1)]
+	}
+	p, v := genModule(tc)
+	return module.Version{Path: p, Version: v}
+}
+
+func pickReplace(tc hegel.TestCase, m *modelFile) module.Version {
+	if len(m.repl) > 0 && chance(tc, 70) {
+		e := m.repl[n(tc, 0, len(m.repl)-1)]
+		return e.textOld
+	}
+	p, v := genModule(tc)
+	if chance(tc, 30) {
+		v = ""
+	}
+	return module.Version{Path: p, Version: v}
+}
+
+// ---------------------------------------------------------------------------
+// Text round trips
+
+func ws(tc hegel.TestCase) string { return pick(tc, " ", " ", "\t", "  ", " \t ") }
+
+func optComment(tc hegel.TestCase) string {
+	if chance(tc, 25) {
+		return ws(tc) + "//" + pick(tc, " a comment", "", " TODO", " indirect?", "x")
+	}
+	return ""
+}
+
+// genGoMod writes a go.mod text with formatting noise and returns it.
+func genGoMod(tc hegel.TestCase) string {
+	var b strings.Builder
+	line := func(s string) {
+		if chance(tc, 15) {
+			b.WriteString("\n")
+		}
+		if chance(tc, 10) {
+			b.WriteString("// leading comment\n")
+		}
+		b.WriteString(s)
+		b.WriteString(optComment(tc))
+		b.WriteString(pick(tc, "\n", "\n", "\r\n"))
+	}
+	block := func(verb string, items []string) {
+		if len(items) == 0 {
+			return
+		}
+		if len(items) == 1 && chance(tc, 60) || chance(tc, 20) {
+			for _, it := range items {
+				line(verb + ws(tc) + it)
+			}
+			return
+		}
+		b.WriteString(verb + ws(tc) + "(" + optComment(tc) + "\n")
+		for _, it := range items {
+			if chance(tc, 10) {
+				b.WriteString("\n")
+			}
+			if chance(tc, 10) {
+				b.WriteString("\t// about the next line\n")
+			}
+			b.WriteString(pick(tc, "\t", "  ", "") + it + optComment(tc) + "\n")
+		}
+		b.WriteString(")\n")
+	}
+	modPath := pick(tc, "example.com/m", "example.com/m/v2", "m.example", "gopkg.in/m.v3")
+	if chance(tc, 15) {
+		b.WriteString("// Deprecated: use example.com/n instead\n")
+	}
+	line("module" + ws(tc) + pick(tc, modPath, `"`+modPath+`"`))
+	if chance(tc, 80) {
+		line("go" + ws(tc) + pick(tc, "1.21", "1.22.0", "1.23rc1", "1.12"))
+	}
+	if chance(tc, 30) {
+		line("toolchain" + ws(tc) + pick(tc, "go1.21.0", "default", "go1.22rc1"))
+	}
+	var items []string
+	for i, k := 0, n(tc, 0, 4); i < k; i++ {
+		p, v := genModule(tc)
+		it := pick(tc, p, `"`+p+`"`) + ws(tc) + v
+		if chance(tc, 30) {
+			it += ws(tc) + "// indirect"
+		}
+		items = append(items, it)
+	}
+	block("require", items)
+	items = nil
+	for i, k := 0, n(tc, 0, 2); i < k; i++ {
+		p, v := genModule(tc)
+		items = append(items, p+ws(tc)+v)
+	}
+	block("exclude", items)
+	items = nil
+	for i, k := 0, n(tc, 0, 2); i < k; i++ {
+		p, v := genModule(tc)
+		old := p
+		if chance(tc, 60) {
+			old += ws(tc) + v
+		}
+		np, nv := genModule(tc)
+		nw := np + ws(tc) + nv
+		if chance(tc, 40) {
+			nw = pick(tc, "../other", "./local", `"../a b"`, "/abs")
+		}
+		items = append(items, old+ws(tc)+"=>"+ws(tc)+nw)
+	}
+	block("replace", items)
+	items = nil
+	for i, k := 0, n(tc, 0, 2); i < k; i++ {
+		_, lo := genModule(tc)
+		it := lo
+		if chance(tc, 40) {
+			_, hi := genModule(tc)
+			it = "[" + lo + "," + ws(tc) + hi + "]"
+		}
+		if r := genRationale(tc); r != "" {
+			it += " // " + r
+		}
+		items = append(items, it)
+	}
+	block("retract", items)
+	items = nil
+	for i, k := 0, n(tc, 0, 2); i < k; i++ {
+		items = append(items, genImportPath(tc))
+	}
+	block("tool", items)
+	items = nil
+	for i, k := 0, n(tc, 0, 2); i < k; i++ {
+		items = append(items, pick(tc, "./testdata", "./gen", "vendor", `"./x y"`))
+	}
+	block("ignore", items)
+	items = nil
+	for i, k := 0, n(tc, 0, 2); i < k; i++ {
+		items = append(items, pick(tc, "panicnil", "http2client")+"="+pick(tc, "0", "1"))
+	}
+	block("godebug", items)
+	return b.String()
+}
+
+// TestHegelModfileParseFormatRoundTrips: a go.mod written with formatting
+// noise parses; Format of the result parses to the same content and is a
+// fixed point of Parse+Format; ParseLax reads the same content; ModulePath
+// finds the module path; an unknown directive fails Parse but not ParseLax.
+func TestHegelModfileParseFormatRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		text := genGoMod(tc)
+		note(ht, "go.mod:\n%s", text)
+		f, err := modfile.Parse("go.mod", []byte(text), nil)
+		if err != nil {
+			fail(ht, "Parse: %v\n%s", err, text)
+			return
+		}
+		want := summary(f)
+		data, _ := f.Format()
+		f2, err := modfile.Parse("go.mod", data, nil)
+		if err != nil {
+			fail(ht, "Parse(Format): %v\n--- original:\n%s\n--- formatted:\n%s", err, text, data)
+			return
+		}
+		if got := summary(f2); got != want {
+			fail(ht, "Parse(Format) reads\n%s\nwant\n%s\n--- original:\n%s\n--- formatted:\n%s", got, want, text, data)
+			return
+		}
+		data2, _ := f2.Format()
+		if !bytes.Equal(data2, data) {
+			fail(ht, "Format is not a fixed point:\n%s\n--- second:\n%s", data, data2)
+		}
+		lax, err := modfile.ParseLax("go.mod", []byte(text), nil)
+		if err != nil {
+			fail(ht, "ParseLax: %v\n%s", err, text)
+			return
+		}
+		// ParseLax keeps module, go, require, retract and ignore (the statements
+		// that matter for a dependency; toolchain, godebug, exclude, replace and
+		// tool are the main module's business); compare those.
+		strip := func(f *modfile.File) string {
+			g := *f
+			g.Exclude, g.Replace, g.Tool, g.Godebug, g.Toolchain = nil, nil, nil, nil, nil
+			return summary(&g)
+		}
+		if got, w := strip(lax), strip(f); got != w {
+			fail(ht, "ParseLax reads\n%s\nParse reads\n%s\n%s", got, w, text)
+		}
+		if got := modfile.ModulePath([]byte(text)); got != f.Module.Mod.Path {
+			fail(ht, "ModulePath = %q, Parse says %q\n%s", got, f.Module.Mod.Path, text)
+		}
+		unknown := text + "\nfrobnicate x y\n"
+		if _, err := modfile.Parse("go.mod", []byte(unknown), nil); err == nil {
+			fail(ht, "Parse accepted an unknown directive\n%s", unknown)
+		}
+		if _, err := modfile.ParseLax("go.mod", []byte(unknown), nil); err != nil {
+			fail(ht, "ParseLax rejected an unknown directive: %v\n%s", err, unknown)
+		}
+		if f.Module.Deprecated != "" {
+			count(ht, "deprecated")
+		}
+		if len(f.Retract) > 0 {
+			count(ht, "retract")
+		}
+		if len(f.Replace) > 0 {
+			count(ht, "replace")
+		}
+		if strings.Contains(text, "(") {
+			count(ht, "block")
+		}
+		if strings.Contains(text, "\r\n") {
+			count(ht, "crlf")
+		}
+	})
+}
+
+// mustQuoteModel: the lexer's single-token condition. A space, quote or
+// backquote, a bracket or comma in a longer token, a non-printable rune,
+// the empty string, or a comment opener needs quoting.
+func mustQuoteModel(s string) bool {
+	if s == "" || strings.Contains(s, "//") || strings.Contains(s, "/*") {
+		return true
+	}
+	for _, r := range s {
+		switch {
+		case strings.ContainsRune(" \"'`", r):
+			return true
+		case strings.ContainsRune("()[]{},", r) && len(s) > 1:
+			return true
+		case !unicode.IsPrint(r):
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelModfileQuotingRoundTrips: AutoQuote(s) is s unless MustQuote(s),
+// and a directive written with AutoQuote parses back to s; MustQuote is
+// exactly the documented condition (empty, or containing // or /*).
+func TestHegelModfileQuotingRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		var b strings.Builder
+		for i, k := 0, n(tc, 0, 8); i < k; i++ {
+			b.WriteString(pick(tc, "a", "b", "/", "/", "*", ".", "-", "_", "~", "1", "x", "é", " ", "\t", `"`, `\`, "'", "(", ")", "=>", "[", ","))
+		}
+		s := b.String()
+		note(ht, "s=%s", show(s))
+		q := modfile.AutoQuote(s)
+		if must := mustQuoteModel(s); modfile.MustQuote(s) != must {
+			fail(ht, "MustQuote(%s) = %v, want %v", show(s), !must, must)
+		}
+		if !modfile.MustQuote(s) && q != s {
+			fail(ht, "AutoQuote(%s) = %s though MustQuote is false", show(s), show(q))
+		}
+		if modfile.MustQuote(s) {
+			count(ht, "quoted")
+		}
+		// A token that is a plain word or a quoted string reads back as s.
+		text := "module m\nignore " + q + "\n"
+		f, err := modfile.Parse("go.mod", []byte(text), nil)
+		if strings.ContainsAny(s, " \t\"'`\\()[],") || s == "" || strings.Contains(s, "=>") {
+			// Not a single unquoted token: only the quoted form can carry it.
+			if q == s {
+				count(ht, "unquotable word")
+				return
+			}
+		}
+		if err != nil {
+			if q == s {
+				count(ht, "rejected word")
+				return
+			}
+			fail(ht, "Parse(ignore %s): %v", show(q), err)
+			return
+		}
+		if len(f.Ignore) != 1 || f.Ignore[0].Path != s {
+			fail(ht, "Parse(ignore %s) read %v, want %s", show(q), f.Ignore, show(s))
+		}
+	})
+}
