+package hegel
+
+// Known lists the recorded bugs (bugs.toml) the properties gate on: a
+// property counts a shape as `mod/N` only when the mismatch actually occurs,
+// and never works around a bug otherwise.
+var Known = struct {
+	// 1: CheckImportPath (and CheckPath, CheckFilePath) accept a path element
+	// containing two dots in a row, which the documentation forbids.
+	DoubleDotAccepted bool
+	// 2: EscapeVersion fails with "internal error: inconsistency in
+	// EscapePath" on a version containing a non-ASCII letter, which is a
+	// valid file name.
+	EscapeVersionUnicode bool
+	// 3: modfile.File.AddRetract adds the retract line to the syntax tree but
+	// not to f.Retract, so DropRetract cannot remove it and the File's
+	// Retract list disagrees with the text it formats.
+	AddRetractNotRecorded bool
+	// 4: modfile.File.SetRequire (and SetRequireSeparateIndirect) dereference
+	// the nil Syntax of a require cleared by an earlier DropRequire or
+	// SetRequire when Cleanup was not called in between: a nil pointer panic.
+	SetRequireAfterDrop bool
+	// 5: note.GenerateKey does not check the name (empty, spaces, '+'), and
+	// the keys it returns are rejected by NewSigner and NewVerifier.
+	GenerateKeyAnyName bool
+	// 6: note.Sign accepts a text with control characters or invalid UTF-8
+	// and produces a message that Open rejects as malformed.
+	SignControlChars bool
+	// 7: tlog.FormatRecord accepts a record text that starts with a blank
+	// line, which its documentation forbids.
+	RecordLeadingBlank bool
+	// 8: modfile.File.AddIgnore writes the path without AutoQuote, so a
+	// directory path with a space gives a go.mod that does not parse.
+	AddIgnoreUnquoted bool
+	// 9: modfile.File.Cleanup does not remove the tool and ignore entries
+	// cleared by DropTool and DropIgnore, which stay in f.Tool and f.Ignore
+	// with an empty path.
+	CleanupKeepsIgnores bool
+	// 10: AddReplace(old, "", new) over a versioned replace of old rewrites
+	// the line to the version-less form but keeps the version in
+	// f.Replace's Old, so DropReplace(old, "") cannot remove it.
+	ReplaceWildcardKeepsVersion bool
+}{
+	DoubleDotAccepted:           true,
+	EscapeVersionUnicode:        true,
+	AddRetractNotRecorded:       true,
+	SetRequireAfterDrop:         true,
+	GenerateKeyAnyName:          true,
+	SignControlChars:            true,
+	RecordLeadingBlank:          true,
+	AddIgnoreUnquoted:           true,
+	CleanupKeepsIgnores:         true,
+	ReplaceWildcardKeepsVersion: true,
+}
