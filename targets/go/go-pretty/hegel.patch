diff --git a/hegel/hegel_list_test.go b/hegel/hegel_list_test.go
new file mode 100644
index 0000000..0efa1f1
--- /dev/null
+++ b/hegel/hegel_list_test.go
@@ -0,0 +1,173 @@
+package hegel
+
+// The list package: Render, RenderMarkdown and RenderHTML against the items and their levels.
+
+import (
+	"fmt"
+	"html"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/jedib0t/go-pretty/v6/list"
+	"hegel.dev/go/hegel"
+)
+
+type listItem struct {
+	level int
+	text  string
+}
+
+var listWords = []string{"Game Of Thrones", "Winter", "Is", "Coming", "a", "b&c", "<x>", "two\nlines", "q\"uote", "tab\tbed", "日本"}
+
+// listOp is what happens to the writer before an item is appended.
+type listOp int
+
+const (
+	opNone listOp = iota
+	opIndent
+	opUnIndent
+	opUnIndentAll
+)
+
+var listOpNames = []string{"", "Indent", "UnIndent", "UnIndentAll"}
+
+// listStep: an indentation call (or none) and the item appended after it.
+type listStep struct {
+	op   listOp
+	item any
+}
+
+// listCase: the steps of a list, in order.
+type listCase struct{ steps []listStep }
+
+func (c listCase) GoString() string {
+	var parts []string
+	for _, s := range c.steps {
+		if s.op == opNone {
+			parts = append(parts, fmt.Sprintf("%#v", s.item))
+		} else {
+			parts = append(parts, fmt.Sprintf("%s; %#v", listOpNames[s.op], s.item))
+		}
+	}
+	return "[" + strings.Join(parts, " | ") + "]"
+}
+
+var (
+	// listOps: no call most of the time, Indent and UnIndent as often as each other,
+	// UnIndentAll rarely (a table with repetitions; the first entry is the shrink target).
+	listOps   = hegel.SampledFrom([]listOp{opNone, opNone, opNone, opNone, opIndent, opIndent, opIndent, opUnIndent, opUnIndent, opUnIndent, opUnIndentAll})
+	listItems = weighted(
+		choice[any]{80, asAny(hegel.SampledFrom(listWords))},
+		choice[any]{20, asAny(hegel.Integers(-50, 500))},
+	)
+	listSteps = hegel.Map(pairs(listOps, listItems), func(p pair[listOp, any]) listStep { return listStep{p.a, p.b} })
+	listCases = hegel.Map(many(listSteps, 1, 8), func(ss []listStep) listCase { return listCase{ss} })
+)
+
+// build: the writer after the steps, and the items with the documented levels: Indent shifts
+// only once past the previous item's level, never before the first.
+func (c listCase) build() (list.Writer, []listItem) {
+	lw := list.NewWriter()
+	var items []listItem
+	level := 0
+	for _, s := range c.steps {
+		switch s.op {
+		case opIndent:
+			lw.Indent()
+			if len(items) > 0 && level <= items[len(items)-1].level {
+				level++
+			}
+		case opUnIndent:
+			lw.UnIndent()
+			if level > 0 {
+				level--
+			}
+		case opUnIndentAll:
+			lw.UnIndentAll()
+			level = 0
+		}
+		lw.AppendItem(s.item)
+		items = append(items, listItem{level, strings.ReplaceAll(fmt.Sprint(s.item), "\t", "    ")})
+	}
+	return lw, items
+}
+
+func TestHegelList(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		lw, items := hegel.Draw(ht, listCases).build()
+		if lw.Length() != len(items) {
+			fail(ht, "Length() = %d, want %d", lw.Length(), len(items))
+			return
+		}
+		// Render: two spaces per level, "* " before the first line of an item, two more spaces
+		// before its other lines
+		var want []string
+		for _, it := range items {
+			for j, l := range strings.Split(it.text, "\n") {
+				if j == 0 {
+					want = append(want, strings.Repeat("  ", it.level)+"* "+l)
+				} else {
+					want = append(want, strings.Repeat("  ", it.level+1)+l)
+				}
+			}
+		}
+		if got := lw.Render(); got != strings.Join(want, "\n") {
+			fail(ht, "Render() =\n%s\nwant\n%s\nitems %+v", got, strings.Join(want, "\n"), items)
+			return
+		}
+		// Markdown: a two-space prefix, newlines as <br/>
+		want = want[:0]
+		for _, it := range items {
+			want = append(want, "  "+strings.Repeat("  ", it.level)+"* "+strings.ReplaceAll(it.text, "\n", "<br/>"))
+		}
+		if got := lw.RenderMarkdown(); got != strings.Join(want, "\n") {
+			fail(ht, "RenderMarkdown() =\n%s\nwant\n%s\nitems %+v", got, strings.Join(want, "\n"), items)
+			return
+		}
+		// HTML: nested <ul> per level, one <li> per item, in order
+		got := lw.RenderHTML()
+		var parsed []listItem
+		depth := 0
+		ok := true
+		for _, tok := range strings.Split(got, "\n") {
+			tok = strings.TrimSpace(tok)
+			switch {
+			case strings.HasPrefix(tok, "<ul class=\""):
+				depth++
+				wantClass := "go-pretty-table"
+				if depth > 1 {
+					wantClass += "-" + strconv.Itoa(depth-1)
+				}
+				if tok != "<ul class=\""+wantClass+"\">" {
+					ok = false
+				}
+			case tok == "</ul>":
+				depth--
+			case strings.HasPrefix(tok, "<li>") && strings.HasSuffix(tok, "</li>"):
+				inner := strings.TrimSuffix(strings.TrimPrefix(tok, "<li>"), "</li>")
+				parsed = append(parsed, listItem{depth - 1, html.UnescapeString(strings.ReplaceAll(inner, "<br/>", "\n"))})
+			case tok == "":
+			default:
+				ok = false
+			}
+		}
+		if depth != 0 {
+			ok = false
+		}
+		if ok && len(parsed) == len(items) {
+			for i := range items {
+				if parsed[i] != items[i] {
+					ok = false
+				}
+			}
+		} else {
+			ok = false
+		}
+		if !ok {
+			fail(ht, "RenderHTML() =\n%s\nparsed %+v\nitems %+v", got, parsed, items)
+			return
+		}
+		count(ht, fmt.Sprintf("items=%d", len(items)))
+	})
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..18b5a13
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,604 @@
+package hegel
+
+// The model: a scanner for escape sequences, the visible text and its width, an SGR state, and
+// the generators of strings holding sequences.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+const esc = "\x1b"
+
+// tok is a scanned piece of a string: an escape sequence (esc != "") or a rune.
+type tok struct {
+	esc string
+	r   rune
+}
+
+// scan splits s into escape sequences and runes. ECMA-48: a CSI sequence is ESC [ followed by
+// parameter and intermediate bytes (0x20-0x3F) and a final byte (0x40-0x7E); an OSC sequence is
+// ESC ] up to BEL or ESC \. Any other ESC starts a two-character sequence. An unterminated
+// sequence runs to the end of the string.
+func scan(s string) []tok {
+	var out []tok
+	rs := []rune(s)
+	for i := 0; i < len(rs); i++ {
+		if rs[i] != 27 {
+			out = append(out, tok{r: rs[i]})
+			continue
+		}
+		j := i + 1
+		if j >= len(rs) {
+			out = append(out, tok{esc: string(rs[i:])})
+			break
+		}
+		switch rs[j] {
+		case '[':
+			j++
+			for j < len(rs) && rs[j] >= 0x20 && rs[j] <= 0x3F {
+				j++
+			}
+			if j < len(rs) && rs[j] >= 0x40 && rs[j] <= 0x7E {
+				j++
+			} else {
+				j = len(rs)
+			}
+		case ']':
+			j++
+			for j < len(rs) {
+				if rs[j] == 7 {
+					j++
+					break
+				}
+				if rs[j] == 27 && j+1 < len(rs) && rs[j+1] == '\\' {
+					j += 2
+					break
+				}
+				j++
+			}
+		default:
+			j++
+		}
+		out = append(out, tok{esc: string(rs[i:j])})
+		i = j - 1
+	}
+	return out
+}
+
+func visible(s string) string {
+	var b strings.Builder
+	for _, t := range scan(s) {
+		if t.esc == "" {
+			b.WriteRune(t.r)
+		}
+	}
+	return b.String()
+}
+
+func escapes(s string) []string {
+	var out []string
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			out = append(out, t.esc)
+		}
+	}
+	return out
+}
+
+// widthOf is the display width of the visible text, text.RuneWidth per rune (the package's own
+// definition of a rune's width; the model does not test it).
+func widthOf(s string) int {
+	w := 0
+	for _, r := range visible(s) {
+		w += text.RuneWidth(r)
+	}
+	return w
+}
+
+func widthOfPlain(s string) int {
+	w := 0
+	for _, r := range s {
+		w += text.RuneWidth(r)
+	}
+	return w
+}
+
+// --------------------------------------------------------------------------- SGR state
+
+// sgr is the documented meaning of the SGR sequences: a foreground colour, a background colour
+// and the attributes 1-9, each set by its code, cleared by 22-29 or by 0.
+type sgr struct {
+	fg, bg string
+	attrs  [10]bool
+}
+
+func (st *sgr) apply(seq string) {
+	if !strings.HasPrefix(seq, esc+"[") || !strings.HasSuffix(seq, "m") {
+		return
+	}
+	body := seq[2 : len(seq)-1]
+	parts := strings.Split(body, ";")
+	codes := make([]int, 0, len(parts))
+	for _, p := range parts {
+		if p == "" {
+			codes = append(codes, 0)
+			continue
+		}
+		n, err := strconv.Atoi(p)
+		if err != nil {
+			return // not an SGR sequence the model knows
+		}
+		codes = append(codes, n)
+	}
+	for i := 0; i < len(codes); i++ {
+		c := codes[i]
+		switch {
+		case c == 0:
+			*st = sgr{}
+		case c >= 1 && c <= 9:
+			st.attrs[c] = true
+		case c == 22:
+			st.attrs[1], st.attrs[2] = false, false
+		case c == 23:
+			st.attrs[3] = false
+		case c == 24:
+			st.attrs[4] = false
+		case c == 25:
+			st.attrs[5], st.attrs[6] = false, false
+		case c == 27:
+			st.attrs[7] = false
+		case c == 28:
+			st.attrs[8] = false
+		case c == 29:
+			st.attrs[9] = false
+		case (c >= 30 && c <= 37) || (c >= 90 && c <= 97):
+			st.fg = strconv.Itoa(c)
+		case c == 39:
+			st.fg = ""
+		case (c >= 40 && c <= 47) || (c >= 100 && c <= 107):
+			st.bg = strconv.Itoa(c)
+		case c == 49:
+			st.bg = ""
+		case c == 38 || c == 48:
+			var v string
+			if i+2 < len(codes) && codes[i+1] == 5 {
+				v = fmt.Sprintf("%d;5;%d", c, codes[i+2])
+				i += 2
+			} else if i+4 < len(codes) && codes[i+1] == 2 {
+				v = fmt.Sprintf("%d;2;%d;%d;%d", c, codes[i+2], codes[i+3], codes[i+4])
+				i += 4
+			} else {
+				return
+			}
+			if c == 38 {
+				st.fg = v
+			} else {
+				st.bg = v
+			}
+		}
+	}
+}
+
+func (st sgr) String() string {
+	var parts []string
+	for i := 1; i <= 9; i++ {
+		if st.attrs[i] {
+			parts = append(parts, strconv.Itoa(i))
+		}
+	}
+	if st.fg != "" {
+		parts = append(parts, "fg="+st.fg)
+	}
+	if st.bg != "" {
+		parts = append(parts, "bg="+st.bg)
+	}
+	if len(parts) == 0 {
+		return "{}"
+	}
+	return "{" + strings.Join(parts, " ") + "}"
+}
+
+// stateAfter is the SGR state at the end of s.
+func stateAfter(s string) sgr {
+	var st sgr
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			st.apply(t.esc)
+		}
+	}
+	return st
+}
+
+// visibleStates lists the visible runes of s with the SGR state in force at each.
+type runeState struct {
+	r  rune
+	st sgr
+}
+
+func visibleStates(s string) []runeState {
+	var st sgr
+	var out []runeState
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			st.apply(t.esc)
+		} else {
+			out = append(out, runeState{t.r, st})
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- words
+
+var (
+	wideRunes   = []rune{'生', '命', '世', '界', 'ツ'}
+	accentRunes = []rune{'é', 'ß', 'ǆ', 'Ω', '😀'}
+	punctRunes  = []rune{'0', '7', '-', '.', '_', '!', '/'}
+	// wordRunes: a visible rune: a letter seven times in ten, else a wide rune, a precomposed
+	// accent, digraph, Greek letter or emoji, or a digit or punctuation mark.
+	wordRunes = weighted(
+		choice[rune]{7, hegel.Integers[rune]('a', 'z')},
+		choice[rune]{1, hegel.SampledFrom(wideRunes)},
+		choice[rune]{1, hegel.SampledFrom(accentRunes)},
+		choice[rune]{1, hegel.SampledFrom(punctRunes)},
+	)
+	// words: 1-6 visible runes without whitespace.
+	words = runeStrings(wordRunes, 1, 6)
+)
+
+// --------------------------------------------------------------------------- SGR sequences
+
+var fgCodes = []int{30, 31, 32, 33, 34, 35, 36, 37, 90, 91, 92, 93, 94, 95, 96, 97}
+var bgCodes = []int{40, 41, 42, 43, 44, 45, 46, 47, 100, 101, 102, 103, 104, 105, 106, 107}
+var offCodes = []int{22, 23, 24, 25, 27, 29, 39, 49}
+
+// sgrKind is what a code of a drawn sequence means.
+type sgrKind int
+
+const (
+	sgrReset sgrKind = iota // 0 (spelled 4 where resets are excluded)
+	sgrAttr                 // 1-9
+	sgrOff                  // 22-29, 39, 49
+	sgrFg                   // 30-37, 90-97
+	sgrBg                   // 40-47, 100-107
+	sgrExt                  // 38;5;n or 48;5;n, or 38;2;r;g;b or 48;2;r;g;b
+)
+
+// sgrIntent: one code of a sequence, spelled against the state in force by spellSGR (under
+// Known.colorsSorted a colour into a taken slot becomes the slot's clearing code; under
+// Known.codesOutOfOrder a 256 colour stands alone in its sequence).
+type sgrIntent struct {
+	kind sgrKind
+	n    int   // the attribute, off code or colour code, or the 256-colour index
+	bg   bool  // ext: the background (48) rather than the foreground (38)
+	rgb  []int // ext: the 24-bit components (nil: a 256 colour)
+}
+
+// sgrSeq is one drawn SGR sequence of one or two codes.
+type sgrSeq []sgrIntent
+
+func (it sgrIntent) String() string {
+	switch it.kind {
+	case sgrReset:
+		return "reset"
+	case sgrAttr:
+		return "attr " + strconv.Itoa(it.n)
+	case sgrOff:
+		return "off " + strconv.Itoa(it.n)
+	case sgrFg, sgrBg:
+		return "colour " + strconv.Itoa(it.n)
+	}
+	base := 38
+	if it.bg {
+		base = 48
+	}
+	if it.rgb != nil {
+		return fmt.Sprintf("%d;2;%d;%d;%d", base, it.rgb[0], it.rgb[1], it.rgb[2])
+	}
+	return fmt.Sprintf("%d;5;%d", base, it.n)
+}
+
+func (s sgrSeq) String() string {
+	var parts []string
+	for _, it := range s {
+		parts = append(parts, it.String())
+	}
+	return "[" + strings.Join(parts, "; ") + "]"
+}
+
+var (
+	// offIntents: a clearing code; 28 (conceal off) three times in ten while go-pretty/11's
+	// switch is off.
+	offIntents = func() hegel.Generator[sgrIntent] {
+		base := hegel.Map(hegel.SampledFrom(offCodes), func(c int) sgrIntent { return sgrIntent{kind: sgrOff, n: c} })
+		if Known.concealOff {
+			return base
+		}
+		return weighted(choice[sgrIntent]{70, base}, choice[sgrIntent]{30, hegel.Just(sgrIntent{kind: sgrOff, n: 28})})
+	}()
+	ext256 = hegel.Map(pairs(chance(50), hegel.Integers(0, 255)), func(p pair[bool, int]) sgrIntent {
+		return sgrIntent{kind: sgrExt, bg: p.a, n: p.b}
+	})
+	extRGB = hegel.Map(pairs(chance(50), many(hegel.Integers(0, 255), 3, 3)), func(p pair[bool, []int]) sgrIntent {
+		return sgrIntent{kind: sgrExt, bg: p.a, rgb: p.b}
+	})
+	// extIntents: a 256 colour; a 24-bit colour as often while go-pretty/9's switch is off.
+	extIntents = func() hegel.Generator[sgrIntent] {
+		if Known.truecolor {
+			return ext256
+		}
+		return hegel.OneOf(ext256, extRGB)
+	}()
+	// sgrIntents: a reset once in ten, an attribute three times, a clearing code once, a
+	// foreground colour three times, a background colour once, an extended colour once.
+	sgrIntents = weighted(
+		choice[sgrIntent]{1, hegel.Just(sgrIntent{kind: sgrReset})},
+		choice[sgrIntent]{3, hegel.Map(hegel.Integers(1, 9), func(n int) sgrIntent { return sgrIntent{kind: sgrAttr, n: n} })},
+		choice[sgrIntent]{1, offIntents},
+		choice[sgrIntent]{3, hegel.Map(hegel.SampledFrom(fgCodes), func(c int) sgrIntent { return sgrIntent{kind: sgrFg, n: c} })},
+		choice[sgrIntent]{1, hegel.Map(hegel.SampledFrom(bgCodes), func(c int) sgrIntent { return sgrIntent{kind: sgrBg, n: c} })},
+		choice[sgrIntent]{1, extIntents},
+	)
+	// sgrSeqs: a sequence of one or two codes.
+	sgrSeqs = hegel.Map(many(sgrIntents, 1, 2), func(its []sgrIntent) sgrSeq { return its })
+)
+
+// sgrOpts: noReset excludes code 0; fullState spells the sequence as a reset followed by the
+// whole resulting state (so that the sequence alone denotes the state).
+type sgrOpts struct {
+	noReset   bool
+	fullState bool
+}
+
+// spellSGR spells seq as an SGR sequence applicable in state st (which it updates). Under
+// Known.colorsSorted a colour is set only when its slot is empty (the slot's clearing code
+// otherwise); under Known.codesOutOfOrder a 256-colour code stands alone in its sequence (the
+// codes before it form a sequence of their own), and cannot share the full-state spelling's
+// reset, so it is spelled as a plain foreground colour there.
+func spellSGR(seq sgrSeq, st *sgr, o sgrOpts) string {
+	var codes []string
+	for _, it := range seq {
+		if it.kind == sgrExt && o.fullState && Known.codesOutOfOrder {
+			it = sgrIntent{kind: sgrFg, n: at(fgCodes, it.n)}
+		}
+		var nc []string // the codes of this intent
+		alone := false
+		switch it.kind {
+		case sgrReset:
+			if o.noReset {
+				nc = append(nc, "4")
+			} else {
+				nc = append(nc, "0")
+			}
+		case sgrAttr, sgrOff:
+			nc = append(nc, strconv.Itoa(it.n))
+		case sgrFg:
+			if Known.colorsSorted && st.fg != "" {
+				nc = append(nc, "39")
+			} else {
+				nc = append(nc, strconv.Itoa(it.n))
+			}
+		case sgrBg:
+			if Known.colorsSorted && st.bg != "" {
+				nc = append(nc, "49")
+			} else {
+				nc = append(nc, strconv.Itoa(it.n))
+			}
+		case sgrExt:
+			base, slot := 38, st.fg
+			if it.bg {
+				base, slot = 48, st.bg
+			}
+			switch {
+			case Known.colorsSorted && slot != "":
+				nc = append(nc, strconv.Itoa(base+1))
+			case it.rgb != nil:
+				nc = append(nc, fmt.Sprintf("%d;2;%d;%d;%d", base, it.rgb[0], it.rgb[1], it.rgb[2]))
+			default:
+				nc = append(nc, fmt.Sprintf("%d;5;%d", base, it.n))
+				alone = Known.codesOutOfOrder
+			}
+		}
+		// apply the codes now, so that the next intent sees the colour slots as they are
+		st.apply(esc + "[" + strings.Join(nc, ";") + "m")
+		if alone {
+			if len(codes) > 0 {
+				return esc + "[" + strings.Join(codes, ";") + "m" + esc + "[" + strings.Join(nc, ";") + "m"
+			}
+			codes = nc
+			break
+		}
+		codes = append(codes, nc...)
+	}
+	if o.fullState {
+		if *st == (sgr{}) && o.noReset {
+			st.attrs[4] = true
+		}
+		return stateSequence(*st)
+	}
+	return esc + "[" + strings.Join(codes, ";") + "m"
+}
+
+// stateSequence spells a state as one sequence: a reset followed by its codes.
+func stateSequence(st sgr) string {
+	codes := []string{"0"}
+	for i := 1; i <= 9; i++ {
+		if st.attrs[i] {
+			codes = append(codes, strconv.Itoa(i))
+		}
+	}
+	if st.fg != "" {
+		codes = append(codes, st.fg)
+	}
+	if st.bg != "" {
+		codes = append(codes, st.bg)
+	}
+	return esc + "[" + strings.Join(codes, ";") + "m"
+}
+
+// --------------------------------------------------------------------------- other sequences
+
+var hyperlinkURLs = []string{"https://go.dev/Docs", "http://x.y/mm", "https://example.com/Path?q=1", "file:///tmp/m"}
+
+var (
+	// hyperlinks: an OSC 8 hyperlink around a word, ST or BEL terminated.
+	hyperlinks = hegel.Composite(func(tc hegel.TestCase) string {
+		url := hegel.Draw(tc, hegel.SampledFrom(hyperlinkURLs))
+		label := hegel.Draw(tc, words)
+		if hegel.Draw(tc, chance(50)) {
+			return esc + "]8;;" + url + "\a" + label + esc + "]8;;\a"
+		}
+		return text.Hyperlink(url, label)
+	})
+	// titleSeqs: an OSC 0 (window title) sequence, ST terminated while go-pretty/2's switch is
+	// on, BEL terminated otherwise.
+	titleSeqs = hegel.Map(words, func(w string) string {
+		if Known.oscBelOnly8 {
+			return esc + "]0;" + w + esc + "\\"
+		}
+		return esc + "]0;" + w + "\a"
+	})
+	// cursorSeqs: a CSI cursor or erase sequence, and the package's own Cursor sequences.
+	cursorSeqs = hegel.Map(pairs(hegel.Integers(1, 9), hegel.SampledFrom([]rune{'A', 'B', 'C', 'D', 'K', 'J', 'H'})), func(p pair[int, rune]) string {
+		return esc + "[" + strconv.Itoa(p.a) + string(p.b)
+	})
+	packageCursorSeqs = hegel.OneOf(
+		hegel.Just(text.EraseLine.Sprint()),
+		hegel.Map(hegel.Integers(1, 5), text.CursorUp.Sprintn),
+		hegel.Just(text.CursorLeft.Sprintn(2)),
+	)
+	// otherSeqs: a non-SGR sequence: an OSC title or a hyperlink, and a cursor or erase
+	// sequence while go-pretty/1's switch is off.
+	otherSeqs = func() hegel.Generator[string] {
+		gens := []hegel.Generator[string]{titleSeqs, hyperlinks}
+		if !Known.csiOnlyM {
+			gens = append([]hegel.Generator[string]{cursorSeqs, packageCursorSeqs}, gens...)
+		}
+		return hegel.OneOf(gens...)
+	}()
+)
+
+// --------------------------------------------------------------------------- texts
+
+// innerSeq: a sequence inside a word, after 1 + pos modulo the word's length runes.
+type innerSeq struct {
+	pos int
+	seq sgrSeq
+}
+
+var innerSeqs = hegel.Map(pairs(positions, sgrSeqs), func(p pair[int, sgrSeq]) innerSeq { return innerSeq{p.a, p.b} })
+
+// splice puts the spelling of in.seq inside word, after 1 + in.pos modulo its length runes.
+func splice(word string, in innerSeq, st *sgr, o sgrOpts) string {
+	rs := []rune(word)
+	k := 1 + in.pos%len(rs)
+	return string(rs[:k]) + spellSGR(in.seq, st, o) + string(rs[k:])
+}
+
+// piece: a word with what surrounds it: the separator before it, a sequence before it, a
+// non-SGR sequence before it, and a sequence inside it.
+type piece struct {
+	sep   string
+	sgr   sgrSeq // nil: none
+	other string // "": none
+	word  string
+	inner *innerSeq
+}
+
+// textSpec: the pieces of a text; the first piece's separator is written only when lead is
+// set; trailing spaces and a final reset.
+type textSpec struct {
+	lead   bool
+	pieces []piece
+	trail  string
+	reset  bool
+}
+
+// render is the text, with every sequence spelled against the state in force.
+func (t textSpec) render() string {
+	var b strings.Builder
+	var st sgr
+	for i, p := range t.pieces {
+		if i > 0 || t.lead {
+			b.WriteString(p.sep)
+		}
+		if p.sgr != nil {
+			b.WriteString(spellSGR(p.sgr, &st, sgrOpts{}))
+		}
+		b.WriteString(p.other)
+		w := p.word
+		if p.inner != nil {
+			w = splice(w, *p.inner, &st, sgrOpts{})
+		}
+		b.WriteString(w)
+	}
+	b.WriteString(t.trail)
+	if t.reset {
+		b.WriteString(esc + "[0m")
+	}
+	return b.String()
+}
+
+// textOpts steers texts.
+type textOpts struct {
+	newlines  bool // \n and \r\n
+	tabs      bool
+	sequences bool // SGR sequences
+	other     bool // cursor/erase/OSC sequences and hyperlinks (subject to the switches)
+	spaces    bool // runs of spaces, leading and trailing
+}
+
+func spaceRun(n int) string { return strings.Repeat(" ", n) }
+
+// texts: up to six words joined by separators (a space; runs of spaces, a tab and line
+// breaks as the options allow), with sequences between and inside them, a sequence before a
+// word two times in five, a non-SGR sequence before it three times in twenty, a sequence
+// inside it one time in five, a final reset two times in five.
+func texts(o textOpts) hegel.Generator[string] {
+	seps := []choice[string]{{50, hegel.Just(" ")}}
+	if o.spaces {
+		seps = append(seps, choice[string]{25, hegel.Map(hegel.Integers(1, 3), spaceRun)})
+	}
+	if o.tabs {
+		seps = append(seps, choice[string]{10, hegel.Just("\t")})
+	}
+	if o.newlines {
+		seps = append(seps, choice[string]{20, hegel.SampledFrom([]string{"\n", "\n", "\r\n", "\n\n"})})
+	}
+	sep := weighted(seps...)
+	sgrs, inner, reset := hegel.Just[sgrSeq](nil), hegel.Just[*innerSeq](nil), hegel.Just(false)
+	if o.sequences {
+		sgrs, inner, reset = maybe(40, sgrSeqs), optional(20, innerSeqs), chance(40)
+	}
+	other := hegel.Just("")
+	if o.other {
+		other = maybe(15, otherSeqs)
+	}
+	lead, trail := hegel.Just(false), hegel.Just("")
+	if o.spaces {
+		lead, trail = chance(20), maybe(20, hegel.Map(hegel.Integers(1, 2), spaceRun))
+	}
+	pieces := hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{
+			sep:   hegel.Draw(tc, sep),
+			sgr:   hegel.Draw(tc, sgrs),
+			other: hegel.Draw(tc, other),
+			word:  hegel.Draw(tc, words),
+			inner: hegel.Draw(tc, inner),
+		}
+	})
+	specs := hegel.Composite(func(tc hegel.TestCase) textSpec {
+		return textSpec{
+			lead:   hegel.Draw(tc, lead),
+			pieces: hegel.Draw(tc, many(pieces, 0, 6)),
+			trail:  hegel.Draw(tc, trail),
+			reset:  hegel.Draw(tc, reset),
+		}
+	})
+	return hegel.Map(specs, textSpec.render)
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..49efd4e
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,313 @@
+package hegel
+
+// Pins: the documented behaviour behind each recorded bug. They fail while the bug exists and
+// are listed as expected failures in target.toml.
+
+import (
+	"math"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+)
+
+// go-pretty/1: a CSI sequence ends at its final byte, so cursor and erase sequences (the
+// package's own Cursor type) are invisible and take no width.
+func TestHegelPinCursorSequences(t *testing.T) {
+	if got := text.StripEscape(esc + "[2Khello"); got != "hello" {
+		t.Errorf("StripEscape(ESC[2K hello) = %q, want hello", got)
+	}
+	if got := text.StringWidthWithoutEscSequences(text.CursorUp.Sprintn(3) + "abc"); got != 3 {
+		t.Errorf("StringWidthWithoutEscSequences(CursorUp.Sprintn(3) + abc) = %d, want 3", got)
+	}
+	if got := text.LongestLineLen(text.EraseLine.Sprint() + "abc\ndef"); got != 3 {
+		t.Errorf("LongestLineLen(EraseLine + abc, def) = %d, want 3", got)
+	}
+}
+
+// go-pretty/2: an OSC sequence ends at BEL whatever its command.
+func TestHegelPinOSCBell(t *testing.T) {
+	if got := text.StripEscape(esc + "]0;title\x07text"); got != "text" {
+		t.Errorf("StripEscape(ESC]0;title BEL text) = %q, want text", got)
+	}
+	if got := text.StringWidthWithoutEscSequences(esc + "]0;title\x07text"); got != 4 {
+		t.Errorf("StringWidthWithoutEscSequences(ESC]0;title BEL text) = %d, want 4", got)
+	}
+}
+
+// go-pretty/3: Format.Apply leaves escape sequences intact, a hyperlink's URL included.
+func TestHegelPinFormatHyperlink(t *testing.T) {
+	url := "https://Example.com/Path"
+	if got, want := text.FormatUpper.Apply(text.Hyperlink(url, "some text")), text.Hyperlink(url, "SOME TEXT"); got != want {
+		t.Errorf("FormatUpper.Apply(hyperlink) = %q, want %q", got, want)
+	}
+	if got, want := text.FormatLower.Apply(text.Hyperlink(url, "Some Text")), text.Hyperlink(url, "some text"); got != want {
+		t.Errorf("FormatLower.Apply(hyperlink) = %q, want %q", got, want)
+	}
+	if got, want := text.FormatTitle.Apply(text.Hyperlink(url, "some text")), text.Hyperlink(url, "Some Text"); got != want {
+		t.Errorf("FormatTitle.Apply(hyperlink) = %q, want %q", got, want)
+	}
+}
+
+// go-pretty/4: Escape with an empty sequence returns the string as it is.
+func TestHegelPinEscapeEmpty(t *testing.T) {
+	for _, s := range []string{esc + "[94mGhost" + esc + "[0mLady", "a" + esc + "[0mb", "Ghost"} {
+		if got := text.Escape(s, ""); got != s {
+			t.Errorf("Escape(%q, \"\") = %q, want the input", s, got)
+		}
+	}
+}
+
+func statesOf(s string) map[rune]sgr {
+	m := map[rune]sgr{}
+	for _, rs := range visibleStates(s) {
+		m[rs.r] = rs.st
+	}
+	return m
+}
+
+// go-pretty/5: text after a reset stays plain on the following wrapped lines.
+func TestHegelPinWrapReset(t *testing.T) {
+	for _, f := range []func(string, int) string{text.WrapHard, text.WrapSoft, text.WrapText} {
+		out := f(esc+"[1mbold "+esc+"[0mplain plain plain", 6)
+		for _, rs := range visibleStates(out) {
+			if rs.r == 'p' && rs.st != (sgr{}) {
+				t.Errorf("wrapped %q: 'p' in state %s, want plain", out, rs.st)
+				break
+			}
+		}
+	}
+}
+
+// go-pretty/6: a word broken across lines keeps every attribute in force, not only the last
+// sequence found in the word.
+func TestHegelPinWrapWordState(t *testing.T) {
+	var want sgr
+	want.apply(esc + "[1m")
+	want.apply(esc + "[31m")
+	for _, f := range []func(string, int) string{text.WrapHard, text.WrapSoft, text.WrapText} {
+		out := f(esc+"[1mBold "+esc+"[31mBoldRedLongWord", 6)
+		for _, rs := range visibleStates(out) {
+			if (rs.r == 'W' || rs.r == 'g') && rs.st != want {
+				t.Errorf("wrapped %q: %q in state %s, want %s", out, rs.r, rs.st, want)
+				break
+			}
+		}
+	}
+}
+
+// go-pretty/7: wrapping text with a hyperlink does not conceal the following lines.
+func TestHegelPinWrapHyperlinkConceal(t *testing.T) {
+	out := text.WrapHard(text.Hyperlink("http://x.y/", "label")+" more text here", 6)
+	for _, rs := range visibleStates(out) {
+		if rs.st != (sgr{}) {
+			t.Errorf("WrapHard(hyperlink + text, 6) = %q: %q in state %s, want plain", out, rs.r, rs.st)
+			break
+		}
+	}
+}
+
+// go-pretty/8: a hyperlink word is wrapped like any other: no line exceeds the width.
+func TestHegelPinWrapHyperlinkWidth(t *testing.T) {
+	out := text.WrapHard(text.Hyperlink("http://x.y/mm", "label")+" more", 4)
+	for _, line := range strings.Split(out, "\n") {
+		if w := widthOf(line); w > 4 {
+			t.Errorf("WrapHard(hyperlink + more, 4) = %q: line %q has width %d", out, line, w)
+		}
+	}
+}
+
+// go-pretty/9: a 24-bit colour (38;2;r;g;b) is one colour, not five attributes.
+func TestHegelPinTruecolor(t *testing.T) {
+	esp := text.EscSeqParser{}
+	esp.ParseString(esc + "[38;2;10;20;30mx")
+	if got, want := stateAfter(esp.Sequence()), stateAfter(esc+"[38;2;10;20;30m"); got != want {
+		t.Errorf("Sequence() after 38;2;10;20;30 = %q (state %s), want state %s", esp.Sequence(), got, want)
+	}
+	for _, c := range esp.Codes() {
+		if c == 2 || c == 10 || c == 20 || c == 30 {
+			t.Errorf("Codes() after 38;2;10;20;30 = %v holds the colour components as codes", esp.Codes())
+			break
+		}
+	}
+}
+
+// go-pretty/10: the last colour set is the colour restored.
+func TestHegelPinColorOrder(t *testing.T) {
+	for _, tc := range []struct{ seqs, want string }{
+		{esc + "[91m" + esc + "[31m", esc + "[31m"},
+		{esc + "[32m" + esc + "[31m", esc + "[31m"},
+		{esc + "[38;5;100m" + esc + "[33m", esc + "[33m"},
+		{esc + "[104m" + esc + "[44m", esc + "[44m"},
+	} {
+		esp := text.EscSeqParser{}
+		esp.ParseString(tc.seqs)
+		if got, want := stateAfter(esp.Sequence()), stateAfter(tc.want); got != want {
+			t.Errorf("Sequence() after %q = %q (state %s), want state %s", tc.seqs, esp.Sequence(), got, want)
+		}
+	}
+}
+
+// go-pretty/11: code 28 turns conceal off.
+func TestHegelPinConcealOff(t *testing.T) {
+	esp := text.EscSeqParser{}
+	esp.ParseString(esc + "[8mhidden" + esc + "[28mshown")
+	if esp.IsOpen() || esp.Sequence() != "" {
+		t.Errorf("after 8 then 28: IsOpen %v, Sequence %q, want closed", esp.IsOpen(), esp.Sequence())
+	}
+}
+
+// go-pretty/12: a negative number is formatted by the format, sign included.
+func TestHegelPinNumberFormat(t *testing.T) {
+	text.EnableColors()
+	red := text.Colors{text.FgHiRed}
+	if got, want := text.NewNumberTransformer("%5d")(-42), red.Sprint("  -42"); got != want {
+		t.Errorf("NewNumberTransformer(%%5d)(-42) = %q, want %q", got, want)
+	}
+	if got, want := text.NewNumberTransformer("%d")(int64(math.MinInt64)), red.Sprint("-9223372036854775808"); got != want {
+		t.Errorf("NewNumberTransformer(%%d)(MinInt64) = %q, want %q", got, want)
+	}
+	if got, want := text.NewNumberTransformer("%+d")(-4), red.Sprint("-4"); got != want {
+		t.Errorf("NewNumberTransformer(%%+d)(-4) = %q, want %q", got, want)
+	}
+}
+
+// go-pretty/13: a time at or before the Unix epoch is formatted like any other.
+func TestHegelPinTimeEpoch(t *testing.T) {
+	tt := text.NewTimeTransformer(time.RFC3339, time.UTC)
+	if got := tt(time.Date(1960, 1, 1, 0, 0, 0, 0, time.UTC)); got != "1960-01-01T00:00:00Z" {
+		t.Errorf("NewTimeTransformer(1960-01-01) = %q", got)
+	}
+	if got := tt(time.Unix(0, 0)); got != "1970-01-01T00:00:00Z" {
+		t.Errorf("NewTimeTransformer(epoch) = %q", got)
+	}
+}
+
+// go-pretty/14: an int unix time is formatted like an int64 one.
+func TestHegelPinUnixTimeInt(t *testing.T) {
+	ut := text.NewUnixTimeTransformer(time.RFC3339, time.UTC)
+	want := ut(int64(1700000000))
+	if got := ut(int(1700000000)); got != want {
+		t.Errorf("NewUnixTimeTransformer(int 1700000000) = %q, want %q", got, want)
+	}
+	if got := ut(uint32(1700000000)); got != want {
+		t.Errorf("NewUnixTimeTransformer(uint32 1700000000) = %q, want %q", got, want)
+	}
+}
+
+// go-pretty/15: AlignAuto judges the text, not its escape sequences.
+func TestHegelPinAutoAlignColored(t *testing.T) {
+	got := text.AlignAuto.Apply(esc+"[31m12"+esc+"[0m", 6)
+	if visible(got) != "    12" {
+		t.Errorf("AlignAuto.Apply(coloured 12, 6) = %q (visible %q), want right-aligned", got, visible(got))
+	}
+}
+
+// go-pretty/16: FormatTitle title-cases (a digraph's titlecase form).
+func TestHegelPinTitleCase(t *testing.T) {
+	if got := text.FormatTitle.Apply("ǆa ǉa"); got != "ǅa ǈa" {
+		t.Errorf("FormatTitle.Apply(ǆa ǉa) = %q, want ǅa ǈa", got)
+	}
+}
+
+// go-pretty/17: RepeatAndTrim gives maxRunes runes of the repeated string.
+func TestHegelPinRepeatAndTrim(t *testing.T) {
+	if got := text.RepeatAndTrim("生", 3); got != "生生生" {
+		t.Errorf("RepeatAndTrim(生, 3) = %q, want 3 runes", got)
+	}
+	if got := text.RepeatAndTrim(esc+"[31ma"+esc+"[0m", 3); visible(got) != "aaa" {
+		t.Errorf("RepeatAndTrim(coloured a, 3) = %q, want 3 visible runes", got)
+	}
+}
+
+// go-pretty/18: Snip returns the fixed length its documentation describes.
+func TestHegelPinSnip(t *testing.T) {
+	if got := text.Snip("Ghost", 7, "~"); got != "Ghost  " {
+		t.Errorf("Snip(Ghost, 7, ~) = %q, want %q (the documented example)", got, "Ghost  ")
+	}
+	if got := text.Snip("Ghost", 2, "..."); widthOf(got) > 2 {
+		t.Errorf("Snip(Ghost, 2, ...) = %q has width %d, want at most 2", got, widthOf(got))
+	}
+}
+
+// go-pretty/19: after a carriage return, escape sequences take no columns when overwriting.
+func TestHegelPinCRLFEscape(t *testing.T) {
+	if got, want := text.ProcessCRLF("abc\r"+esc+"[31mX"), esc+"[31mXbc"; got != want {
+		t.Errorf("ProcessCRLF(abc CR ESC[31m X) = %q, want %q", got, want)
+	}
+}
+
+// go-pretty/20: the escape state carries over a paragraph break (WrapHard, WrapSoft) and a
+// line break (WrapText).
+func TestHegelPinWrapParagraphState(t *testing.T) {
+	var bold sgr
+	bold.apply(esc + "[1m")
+	check := func(name, out string) {
+		for _, rs := range visibleStates(out) {
+			if rs.r == 'x' && rs.st != bold {
+				t.Errorf("%s = %q: 'x' in state %s, want %s", name, out, rs.st, bold)
+				return
+			}
+		}
+	}
+	check("WrapHard(bold text, paragraph, next xx)", text.WrapHard(esc+"[1mbold text\n\nnext xx", 6))
+	check("WrapSoft(bold text, paragraph, next xx)", text.WrapSoft(esc+"[1mbold text\n\nnext xx", 6))
+	check("WrapText(bold text, line, next xx)", text.WrapText(esc+"[1mbold text\nnext xx", 6))
+}
+
+// go-pretty/21: no wrapped line is wider than the width when a wide rune would straddle it.
+func TestHegelPinWrapWideRune(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		fn   func(string, int) string
+		s    string
+		n    int
+	}{
+		{"WrapHard", text.WrapHard, "eas命 x", 4},
+		{"WrapSoft", text.WrapSoft, "t sidツ😀", 4},
+		{"WrapText", text.WrapText, "abc世 x", 4},
+	} {
+		out := tc.fn(tc.s, tc.n)
+		for _, line := range strings.Split(out, "\n") {
+			if w := widthOf(line); w > tc.n {
+				t.Errorf("%s(%q, %d) = %q: line %q has width %d", tc.name, tc.s, tc.n, out, line, w)
+			}
+		}
+	}
+}
+
+// go-pretty/22: AlignJustify.Apply does not panic on a blank text and a negative length.
+func TestHegelPinJustifyNegative(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("AlignJustify.Apply(\"  \", -1) panicked: %v", r)
+		}
+	}()
+	if got := text.AlignJustify.Apply("  ", -1); got != "" {
+		t.Errorf("AlignJustify.Apply(\"  \", -1) = %q, want \"\"", got)
+	}
+}
+
+// go-pretty/23: the codes of one sequence apply in order: a reset before a 256 colour leaves
+// the colour set, a 49 before a 256 background leaves the background set.
+func TestHegelPinCodeOrder(t *testing.T) {
+	for _, seq := range []string{esc + "[0;38;5;31m", esc + "[49;48;5;130m", esc + "[0;1;48;5;20m"} {
+		esp := text.EscSeqParser{}
+		esp.ParseString(seq + "x")
+		if got, want := stateAfter(esp.Sequence()), stateAfter(seq); got != want {
+			t.Errorf("Sequence() after %q = %q (state %s), want state %s", seq, esp.Sequence(), got, want)
+		}
+	}
+}
+
+// go-pretty/24: Escape terminates its output even when the input holds the sequence itself.
+func TestHegelPinEscapePair(t *testing.T) {
+	red := esc + "[31m"
+	for _, s := range []string{"a" + red + esc + "[0mb", "ab" + red, "a" + red + "b" + esc + "[0m"} {
+		got := text.Escape(s, red)
+		if visible(got) != visible(s) || stateAfter(got) != (sgr{}) {
+			t.Errorf("Escape(%q, red) = %q: visible %q, ends in state %s", s, got, visible(got), stateAfter(got))
+		}
+	}
+}
