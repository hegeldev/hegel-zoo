+package hegel
+
+// Properties of the string utilities: widths, StripEscape, Trim/Snip/Pad/RepeatAndTrim, Widen,
+// InsertEveryN, ProcessCRLF, Align, VAlign, Format, Escape and the escape sequence parser.
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"golang.org/x/text/width"
+	"hegel.dev/go/hegel"
+	"testing"
+)
+
+// fullTexts: texts with every feature: line breaks, tabs, sequences of every kind, space runs.
+var fullTexts = texts(textOpts{newlines: true, tabs: true, sequences: true, other: true, spaces: true})
+
+// --------------------------------------------------------------------------- widths and trims
+
+// modelTrim: the visible runes that fit in maxLen columns, every escape sequence kept.
+func modelTrim(s string, maxLen int) string {
+	if maxLen <= 0 {
+		return ""
+	}
+	var b strings.Builder
+	w, full := 0, false
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if full {
+			continue
+		}
+		rw := text.RuneWidth(t.r)
+		if w+rw <= maxLen {
+			w += rw
+			b.WriteRune(t.r)
+		} else {
+			full = true
+		}
+	}
+	return b.String()
+}
+
+// modelSnip: the documented "fixed length": trimmed to length minus the indicator when wider,
+// otherwise (the doc's example) padded to the length. Under Known.snipNoPad the package's
+// formula: no padding, and the indicator appended whatever its width.
+func modelSnip(s string, length int, ind string) string {
+	if length <= 0 {
+		return s
+	}
+	ws := widthOf(s)
+	if Known.snipNoPad {
+		if ws > length {
+			return modelTrim(s, length-widthOf(ind)) + ind
+		}
+		return s
+	}
+	if ws > length {
+		if widthOf(ind) >= length {
+			return modelTrim(ind, length)
+		}
+		return modelTrim(s, length-widthOf(ind)) + ind
+	}
+	return s + strings.Repeat(" ", length-ws)
+}
+
+// modelRepeatAndTrim: the documented result has maxRunes runes; under Known.repeatTrimWidth the
+// package's formula (repeat by rune count, trim by display width).
+func modelRepeatAndTrim(s string, maxRunes int) string {
+	if s == "" || maxRunes <= 0 {
+		return ""
+	}
+	rc := utf8.RuneCountInString(s)
+	if Known.repeatTrimWidth {
+		if maxRunes == rc {
+			return s
+		}
+		return modelTrim(strings.Repeat(s, maxRunes/rc+1), maxRunes)
+	}
+	rep := strings.Repeat(s, maxRunes/rc+1)
+	var b strings.Builder
+	n := 0
+	for _, t := range scan(rep) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if n == maxRunes {
+			break
+		}
+		b.WriteRune(t.r)
+		n++
+	}
+	return b.String()
+}
+
+// width1 maps every rune that is not one column wide to an x (the shape RepeatAndTrim is
+// checked on while go-pretty/17 is open).
+func width1(s string) string {
+	return strings.Map(func(r rune) rune {
+		if text.RuneWidth(r) != 1 {
+			return 'x'
+		}
+		return r
+	}, s)
+}
+
+var (
+	padRunes   = hegel.SampledFrom([]rune{' ', '.', '-'})
+	indicators = []string{"~", "...", "…", "", esc + "[31m~" + esc + "[0m", "……"}
+	// repeatTexts: the string RepeatAndTrim repeats: with sequences, or of width-1 runes only
+	// while go-pretty/17's switch is on.
+	repeatTexts = func() hegel.Generator[string] {
+		if Known.repeatTrimWidth {
+			return hegel.Map(texts(textOpts{}), width1)
+		}
+		return texts(textOpts{sequences: true})
+	}()
+)
+
+// widthCase: the text and the length of Trim, Pad and Snip, Pad's character, Snip's indicator,
+// and the string and count of RepeatAndTrim.
+type widthCase struct {
+	s   string
+	n   int
+	pc  rune
+	ind string
+	rs  string
+	m   int
+}
+
+func (c widthCase) GoString() string {
+	return fmt.Sprintf("%q, n=%d, pad %q, indicator %q; RepeatAndTrim(%q, %d)", c.s, c.n, c.pc, c.ind, c.rs, c.m)
+}
+
+// indicatorsFor: the indicators for a Snip of length n: all of them, or, while go-pretty/12's
+// switch is on (an indicator at least as wide as the length is not snipped as documented),
+// "~" and those narrower than n.
+func indicatorsFor(n int) []string {
+	if !Known.snipNoPad {
+		return indicators
+	}
+	out := []string{"~"}
+	for _, ind := range indicators {
+		if ind != "~" && widthOf(ind) < n {
+			out = append(out, ind)
+		}
+	}
+	return out
+}
+
+var widthCases = hegel.Composite(func(tc hegel.TestCase) widthCase {
+	c := widthCase{s: hegel.Draw(tc, fullTexts), n: hegel.Draw(tc, hegel.Integers(-1, 12)), pc: hegel.Draw(tc, padRunes)}
+	c.ind = hegel.Draw(tc, hegel.SampledFrom(indicatorsFor(c.n)))
+	c.rs = hegel.Draw(tc, repeatTexts)
+	c.m = hegel.Draw(tc, hegel.Integers(-1, 12))
+	return c
+})
+
+func TestHegelWidth(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, widthCases)
+		s, n := c.s, c.n
+		vis := visible(s)
+		if got := text.StripEscape(s); got != vis {
+			fail(ht, "StripEscape(%q) = %q, want %q", s, got, vis)
+			return
+		}
+		w := widthOfPlain(vis)
+		if got := text.StringWidthWithoutEscSequences(s); got != w {
+			fail(ht, "StringWidthWithoutEscSequences(%q) = %d, want %d", s, got, w)
+			return
+		}
+		if got := text.RuneCount(s); got != w {
+			fail(ht, "RuneCount(%q) = %d, want %d", s, got, w)
+			return
+		}
+		longest := 0
+		for _, line := range strings.Split(vis, "\n") {
+			if lw := widthOfPlain(line); lw > longest {
+				longest = lw
+			}
+		}
+		if got := text.LongestLineLen(s); got != longest {
+			fail(ht, "LongestLineLen(%q) = %d, want %d", s, got, longest)
+			return
+		}
+		if got, want := text.Trim(s, n), modelTrim(s, n); got != want {
+			fail(ht, "Trim(%q, %d) = %q, want %q", s, n, got, want)
+			return
+		}
+		pc := c.pc
+		want := s
+		if w < n {
+			want = s + strings.Repeat(string(pc), n-w)
+		}
+		if got := text.Pad(s, n, pc); got != want {
+			fail(ht, "Pad(%q, %d, %q) = %q, want %q", s, n, pc, got, want)
+			return
+		}
+		ind := c.ind
+		if got, want := text.Snip(s, n, ind), modelSnip(s, n, ind); got != want {
+			fail(ht, "Snip(%q, %d, %q) = %q, want %q", s, n, ind, got, want)
+			return
+		}
+		// Widen: every visible rune widened, sequences untouched
+		var wb strings.Builder
+		for _, tk := range scan(s) {
+			if tk.esc != "" {
+				wb.WriteString(tk.esc)
+			} else {
+				wb.WriteString(width.Widen.String(string(tk.r)))
+			}
+		}
+		if got := text.Widen(s); got != wb.String() {
+			fail(ht, "Widen(%q) = %q, want %q", s, got, wb.String())
+			return
+		}
+		// RepeatAndTrim on a short string
+		rs, m := c.rs, c.m
+		if got, want := text.RepeatAndTrim(rs, m), modelRepeatAndTrim(rs, m); got != want {
+			fail(ht, "RepeatAndTrim(%q, %d) = %q, want %q", rs, m, got, want)
+			return
+		}
+		switch {
+		case len(escapes(s)) > 0:
+			count(ht, "with sequences")
+		default:
+			count(ht, "plain")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- InsertEveryN, ProcessCRLF
+
+// modelInsertEveryN: the rune before every visible rune that would start beyond the N-th column
+// of its line; the count restarts at \r and \n; sequences pass through.
+func modelInsertEveryN(s string, r rune, n int) string {
+	if n <= 0 {
+		return s
+	}
+	var b strings.Builder
+	lineLen := 0
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if t.r == '\n' || t.r == '\r' {
+			lineLen = 0
+		} else if w := text.RuneWidth(t.r); w > 0 {
+			if lineLen >= n {
+				b.WriteRune(r)
+				lineLen = 0
+			}
+			lineLen += w
+		}
+		b.WriteRune(t.r)
+	}
+	return b.String()
+}
+
+// modelProcessCRLF: \r\n is \n; a lone \r moves the cursor to the start of the line and the
+// following runes overwrite. Under Known.crlfEscapeColumns the runes of escape sequences take
+// columns too (the package's rune loop); otherwise sequences pass through without a column.
+func modelProcessCRLF(s string) string {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	lines := strings.Split(s, "\n")
+	for li, line := range lines {
+		if !strings.Contains(line, "\r") {
+			continue
+		}
+		if Known.crlfEscapeColumns {
+			rs := []rune(line)
+			var out []rune
+			idx := 0
+			for _, r := range rs {
+				if r == '\r' {
+					idx = 0
+					continue
+				}
+				if idx < len(out) {
+					out[idx] = r
+				} else {
+					out = append(out, r)
+				}
+				idx++
+			}
+			lines[li] = string(out)
+			continue
+		}
+		// columns hold visible runes; sequences are emitted where they occur
+		var cols []string // each column: a visible rune, possibly preceded by sequences
+		idx := 0
+		pending := ""
+		for _, t := range scan(line) {
+			if t.esc != "" {
+				pending += t.esc
+				continue
+			}
+			if t.r == '\r' {
+				idx = 0
+				continue
+			}
+			cell := pending + string(t.r)
+			pending = ""
+			if idx < len(cols) {
+				cols[idx] = cell
+			} else {
+				cols = append(cols, cell)
+			}
+			idx++
+		}
+		lines[li] = strings.Join(cols, "") + pending
+	}
+	return strings.Join(lines, "\n")
+}
+
+// withCRs inserts a carriage return at each position (modulo the length plus one), in turn.
+func withCRs(s string, ps []int) string {
+	rs := []rune(s)
+	for _, p := range ps {
+		p %= len(rs) + 1
+		rs = append(rs[:p], append([]rune{'\r'}, rs[p:]...)...)
+	}
+	return string(rs)
+}
+
+var (
+	// crTexts: a text with line breaks and spaces, with sequences half of the time, and one
+	// or two carriage returns inserted seven times in ten.
+	crBases = hegel.OneOf(texts(textOpts{newlines: true, spaces: true}), texts(textOpts{newlines: true, sequences: true, spaces: true}))
+	crTexts = hegel.Map(pairs(crBases, maybe(70, many(positions, 1, 2))), func(p pair[string, []int]) string { return withCRs(p.a, p.b) })
+)
+
+// insertCase: the text, count and rune of InsertEveryN, and the text of ProcessCRLF.
+type insertCase struct {
+	s  string
+	n  int
+	r  rune
+	cr string
+}
+
+func (c insertCase) GoString() string {
+	return fmt.Sprintf("InsertEveryN(%q, %q, %d); ProcessCRLF(%q)", c.s, c.r, c.n, c.cr)
+}
+
+var insertCases = hegel.Composite(func(tc hegel.TestCase) insertCase {
+	return insertCase{
+		s:  hegel.Draw(tc, fullTexts),
+		n:  hegel.Draw(tc, hegel.Integers(-1, 5)),
+		r:  hegel.Draw(tc, hegel.SampledFrom([]rune{'-', '|', '\n', '生'})),
+		cr: hegel.Draw(tc, crTexts),
+	}
+})
+
+func TestHegelInsert(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, insertCases)
+		s, n, r := c.s, c.n, c.r
+		if got, want := text.InsertEveryN(s, r, n), modelInsertEveryN(s, r, n); got != want {
+			fail(ht, "InsertEveryN(%q, %q, %d) = %q, want %q", s, r, n, got, want)
+			return
+		}
+		// ProcessCRLF on a string with carriage returns
+		cr := c.cr
+		if got, want := text.ProcessCRLF(cr), modelProcessCRLF(cr); got != want {
+			fail(ht, "ProcessCRLF(%q) = %q, want %q", cr, got, want)
+			return
+		}
+		count(ht, fmt.Sprintf("n=%d", n))
+	})
+}
+
+// --------------------------------------------------------------------------- Align, VAlign
+
+func isNumberText(s string) bool {
+	_, err := strconv.ParseFloat(s, 64)
+	return err == nil
+}
+
+// modelAlign: the visible text of Align.Apply. Spaces are trimmed on the padded side when the
+// raw string has a space at that end (a sequence there prevents the trim, as in the package);
+// Justify splits the raw text on spaces, so a sequence standing alone is a word. Returns the
+// visible result and whether the sequences are expected to survive.
+func modelAlign(a text.Align, s string, n int) (string, bool) {
+	vis := visible(s)
+	eff := a
+	if a == text.AlignAuto {
+		src := vis
+		if Known.autoAlignRaw {
+			src = s
+		}
+		if isNumberText(src) {
+			eff = text.AlignRight
+		} else {
+			eff = text.AlignLeft
+		}
+	}
+	trimLeft, trimRight := false, false
+	switch eff {
+	case text.AlignDefault, text.AlignLeft:
+		trimRight = strings.HasSuffix(s, " ")
+	case text.AlignRight:
+		trimLeft = strings.HasPrefix(s, " ")
+	default:
+		if strings.HasPrefix(s, " ") || strings.HasSuffix(s, " ") {
+			trimLeft, trimRight = true, true
+		}
+	}
+	raw := s
+	if trimLeft {
+		raw = strings.TrimLeft(raw, " ")
+	}
+	if trimRight {
+		raw = strings.TrimRight(raw, " ")
+	}
+	trimmed := visible(raw)
+	w := widthOfPlain(trimmed)
+	pad := n - w
+	if pad < 0 {
+		pad = 0
+	}
+	switch eff {
+	case text.AlignDefault, text.AlignLeft:
+		return trimmed + strings.Repeat(" ", pad), true
+	case text.AlignRight:
+		return strings.Repeat(" ", pad) + trimmed, true
+	case text.AlignCenter:
+		return strings.Repeat(" ", pad-pad/2) + trimmed + strings.Repeat(" ", pad/2), true
+	}
+	// justify: the raw words
+	words := []string{}
+	for _, wd := range strings.Split(raw, " ") {
+		if wd != "" {
+			words = append(words, wd)
+		}
+	}
+	if len(words) == 0 {
+		return strings.Repeat(" ", n), false
+	}
+	needed := n - w + strings.Count(raw, " ")
+	if needed < 0 {
+		return trimmed, true
+	}
+	between := 0
+	if len(words) > 1 {
+		between = needed / (len(words) - 1)
+	}
+	var b strings.Builder
+	for i, wd := range words {
+		if i > 0 {
+			if i == len(words)-1 {
+				b.WriteString(strings.Repeat(" ", needed))
+				needed = 0
+			} else {
+				b.WriteString(strings.Repeat(" ", between))
+				needed -= between
+			}
+		}
+		b.WriteString(wd)
+		if i == len(words)-1 && needed > 0 {
+			b.WriteString(strings.Repeat(" ", needed))
+		}
+	}
+	return visible(b.String()), true
+}
+
+func modelVAlign(va text.VAlign, lines []string, maxLines int) []string {
+	if len(lines) == maxLines {
+		return lines
+	}
+	if len(lines) > maxLines {
+		maxLines = len(lines)
+	}
+	if maxLines < 1 {
+		return lines
+	}
+	insert := 0
+	switch va {
+	case text.VAlignMiddle:
+		insert = (maxLines - len(lines)) / 2
+	case text.VAlignBottom:
+		insert = maxLines - len(lines)
+	}
+	out := make([]string, maxLines)
+	for i, l := range lines {
+		out[i+insert] = l
+	}
+	return out
+}
+
+var (
+	aligns     = []text.Align{text.AlignDefault, text.AlignLeft, text.AlignCenter, text.AlignJustify, text.AlignRight, text.AlignAuto}
+	alignNames = []string{"Default", "Left", "Center", "Justify", "Right", "Auto"}
+	valigns    = hegel.SampledFrom([]text.VAlign{text.VAlignDefault, text.VAlignTop, text.VAlignMiddle, text.VAlignBottom})
+	// numberTexts: number-like texts for AlignAuto, coloured three times in ten.
+	numberTexts = hegel.Map(pairs(hegel.SampledFrom([]string{"12", "-3.5", "1e3", "Inf", "0x1p-2", "12a", " 7", "7 ", "1_000"}), chance(30)), func(p pair[string, bool]) string {
+		if p.b {
+			return esc + "[31m" + p.a + esc + "[0m"
+		}
+		return p.a
+	})
+	// alignTexts: a text with sequences and spaces three times in four, a number-like text
+	// otherwise.
+	alignTexts = weighted(
+		choice[string]{75, texts(textOpts{sequences: true, spaces: true})},
+		choice[string]{25, numberTexts},
+	)
+)
+
+// alignCase: the text, alignment (by index) and length of Align.Apply (the length is not
+// negative for Justify while go-pretty/22 is open), and the lines, line count and vertical
+// alignment of VAlign.Apply.
+type alignCase struct {
+	s        string
+	a        int
+	n        int
+	lines    []string
+	maxLines int
+	va       text.VAlign
+}
+
+func (c alignCase) GoString() string {
+	return fmt.Sprintf("Align%s.Apply(%q, %d); VAlign(%d).Apply(%q, %d)", alignNames[c.a], c.s, c.n, c.va, c.lines, c.maxLines)
+}
+
+var alignCases = hegel.Composite(func(tc hegel.TestCase) alignCase {
+	c := alignCase{s: hegel.Draw(tc, alignTexts), a: hegel.Draw(tc, hegel.Integers(0, len(aligns)-1))}
+	lo := -1
+	if aligns[c.a] == text.AlignJustify && Known.justifyNegativePanic {
+		lo = 0
+	}
+	c.n = hegel.Draw(tc, hegel.Integers(lo, 14))
+	c.lines = nonNil(hegel.Draw(tc, many(words, 0, 4)))
+	c.maxLines = hegel.Draw(tc, hegel.Integers(-1, 6))
+	c.va = hegel.Draw(tc, valigns)
+	return c
+})
+
+func TestHegelAlign(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, alignCases)
+		s, n, i := c.s, c.n, c.a
+		a := aligns[i]
+		got := a.Apply(s, n)
+		wantVis, keep := modelAlign(a, s, n)
+		if visible(got) != wantVis {
+			fail(ht, "Align%s.Apply(%q, %d) = %q (visible %q), want visible %q", alignNames[i], s, n, got, visible(got), wantVis)
+			return
+		}
+		if keep && !reflect.DeepEqual(escapes(got), escapes(s)) {
+			fail(ht, "Align%s.Apply(%q, %d) = %q: sequences %q, want %q", alignNames[i], s, n, got, escapes(got), escapes(s))
+			return
+		}
+		// VAlign
+		lines, maxLines, va := c.lines, c.maxLines, c.va
+		want := modelVAlign(va, lines, maxLines)
+		vg := va.Apply(append([]string{}, lines...), maxLines)
+		if !reflect.DeepEqual(vg, want) {
+			fail(ht, "VAlign(%d).Apply(%q, %d) = %q, want %q", va, lines, maxLines, vg, want)
+			return
+		}
+		if len(lines) > 0 {
+			vs := va.ApplyStr(strings.Join(lines, "\n"), maxLines)
+			if !reflect.DeepEqual(vs, want) {
+				fail(ht, "VAlign(%d).ApplyStr(%q, %d) = %q, want %q", va, strings.Join(lines, "\n"), maxLines, vs, want)
+				return
+			}
+		}
+		count(ht, alignNames[i])
+	})
+}
+
+// --------------------------------------------------------------------------- Format
+
+// isSeparator: strings.Title's rule (the package copies it).
+func isSeparator(r rune) bool {
+	if r <= 0x7F {
+		switch {
+		case '0' <= r && r <= '9', 'a' <= r && r <= 'z', 'A' <= r && r <= 'Z', r == '_':
+			return false
+		}
+		return true
+	}
+	if unicode.IsLetter(r) || unicode.IsDigit(r) {
+		return false
+	}
+	return unicode.IsSpace(r)
+}
+
+// modelFormat: the visible runes converted, every escape sequence untouched.
+func modelFormat(f text.Format, s string) string {
+	var b strings.Builder
+	prev := ' '
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		r := t.r
+		switch f {
+		case text.FormatLower:
+			r = unicode.ToLower(r)
+		case text.FormatUpper:
+			r = unicode.ToUpper(r)
+		case text.FormatTitle:
+			if isSeparator(prev) {
+				if Known.titleUpper {
+					r = unicode.ToUpper(r)
+				} else {
+					r = unicode.ToTitle(r)
+				}
+			}
+			prev = t.r
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// upperVisible upper-cases the visible runes, sequences untouched.
+func upperVisible(s string) string {
+	var ub strings.Builder
+	for _, tk := range scan(s) {
+		if tk.esc != "" {
+			ub.WriteString(tk.esc)
+		} else {
+			ub.WriteRune(unicode.ToUpper(tk.r))
+		}
+	}
+	return ub.String()
+}
+
+var (
+	// formatTexts: a text with line breaks, sequences (non-SGR ones too while go-pretty/3's
+	// switch is off) and spaces; upper-cased three times in ten.
+	formatBases = texts(textOpts{newlines: true, sequences: true, other: !Known.formatCSIOnly, spaces: true})
+	formatTexts = weighted(
+		choice[string]{70, formatBases},
+		choice[string]{30, hegel.Map(formatBases, upperVisible)},
+	)
+	formats = hegel.SampledFrom([]text.Format{text.FormatDefault, text.FormatLower, text.FormatTitle, text.FormatUpper})
+)
+
+// formatCase: the text and the format.
+type formatCase struct {
+	s string
+	f text.Format
+}
+
+func (c formatCase) GoString() string { return fmt.Sprintf("Format(%d).Apply(%q)", c.f, c.s) }
+
+var formatCases = hegel.Map(pairs(formatTexts, formats), func(p pair[string, text.Format]) formatCase { return formatCase{p.a, p.b} })
+
+func TestHegelFormat(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, formatCases)
+		s, f := c.s, c.f
+		if got, want := f.Apply(s), modelFormat(f, s); got != want {
+			fail(ht, "Format(%d).Apply(%q) = %q, want %q", f, s, got, want)
+			return
+		}
+		count(ht, fmt.Sprintf("format %d", f))
+	})
+}
+
+// --------------------------------------------------------------------------- Escape, parser
+
+// modelEscapeStates: the SGR state at each visible rune of Escape(s, seq): seq applies from the
+// start (unless s starts with a CSI sequence) and again after every reset "\x1b[0m".
+func modelEscapeStates(s, seq string) []sgr {
+	var q sgr
+	q.apply(seq)
+	st := q
+	if strings.HasPrefix(s, esc+"[") {
+		st = sgr{}
+	}
+	var out []sgr
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			if t.esc == esc+"[0m" {
+				st = q
+			} else {
+				st.apply(t.esc)
+			}
+			continue
+		}
+		out = append(out, st)
+	}
+	return out
+}
+
+// plainResets spells every reset sequence as the exact sequence the package recognises
+// ("\x1b[0;..." becomes "\x1b[0m").
+func plainResets(s string) string {
+	var rb strings.Builder
+	for _, tk := range scan(s) {
+		if tk.esc != "" && strings.HasPrefix(tk.esc, esc+"[0;") {
+			rb.WriteString(esc + "[0m")
+		} else if tk.esc != "" {
+			rb.WriteString(tk.esc)
+		} else {
+			rb.WriteRune(tk.r)
+		}
+	}
+	return rb.String()
+}
+
+var (
+	escapeTexts = hegel.Map(texts(textOpts{sequences: true, spaces: true}), plainResets)
+	attrColors  = hegel.SampledFrom([]text.Color{text.Bold, text.Underline, text.Italic})
+	fgColors    = hegel.OneOf(hegel.SampledFrom([]text.Color{text.FgRed, text.FgHiBlue}), hegel.Map(hegel.Integers(0, 255), text.Fg256Color))
+	bgColors    = hegel.SampledFrom([]text.Color{text.BgGreen, text.Bg256Color(200)})
+)
+
+// escapeCase: the text, the colours of the sequence (an attribute two times in five, a
+// foreground three times in five, a background three times in ten: at most one colour per
+// slot, which Known.colorsSorted needs), and whether the sequence itself follows the text
+// (three times in ten), with a reset after it or not.
+type escapeCase struct {
+	base         string
+	attr, fg, bg *text.Color
+	tail         *bool
+}
+
+// colors is the sequence's colours in the order the old test built them.
+func (c escapeCase) colors() text.Colors {
+	var colors text.Colors
+	for _, p := range []*text.Color{c.attr, c.fg, c.bg} {
+		if p != nil {
+			colors = append(colors, *p)
+		}
+	}
+	return colors
+}
+
+// input is the string Escape is given: the text, then the sequence itself (with a reset
+// after it when tail is set) when its colours go into empty slots or Known.colorsSorted is
+// off; under Known.escapeStripsPair the sequence directly before a reset, or at the very
+// end, gets an x after it.
+func (c escapeCase) input() string {
+	s := c.base
+	seq := c.colors().EscapeSeq()
+	if c.tail != nil && seq != "" {
+		var q sgr
+		q.apply(seq)
+		if st := stateAfter(s); !Known.colorsSorted || ((q.fg == "" || st.fg == "") && (q.bg == "" || st.bg == "")) {
+			s += seq
+			if *c.tail {
+				s += esc + "[0m"
+			}
+		}
+	}
+	if Known.escapeStripsPair && seq != "" {
+		s = strings.ReplaceAll(s, seq+esc+"[0m", seq+"x"+esc+"[0m")
+		if strings.HasSuffix(s, seq) {
+			s += "x"
+		}
+	}
+	return s
+}
+
+func (c escapeCase) GoString() string {
+	tail := "no tail"
+	if c.tail != nil {
+		tail = "the sequence at the end"
+		if *c.tail {
+			tail += " with a reset"
+		}
+	}
+	return fmt.Sprintf("Escape(%q, %v (%q)); %s", c.input(), c.colors(), c.colors().EscapeSeq(), tail)
+}
+
+var escapeCases = hegel.Composite(func(tc hegel.TestCase) escapeCase {
+	c := escapeCase{
+		base: hegel.Draw(tc, escapeTexts),
+		attr: hegel.Draw(tc, optional(40, attrColors)),
+		bg:   hegel.Draw(tc, optional(30, bgColors)),
+	}
+	fgs := optional(60, fgColors)
+	if Known.escapeEmptySeq && c.attr == nil && c.bg == nil {
+		fgs = hegel.Map(fgColors, ptrTo[text.Color]) // some colour: an empty sequence strips the resets (go-pretty/4)
+	}
+	c.fg = hegel.Draw(tc, fgs)
+	c.tail = hegel.Draw(tc, optional(30, hegel.Booleans()))
+	return c
+})
+
+func TestHegelEscape(t *testing.T) {
+	text.EnableColors()
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, escapeCases)
+		colors := c.colors()
+		seq := colors.EscapeSeq()
+		s := c.input()
+		got := text.Escape(s, seq)
+		if visible(got) != visible(s) {
+			fail(ht, "Escape(%q, %q) = %q: visible %q, want %q", s, seq, got, visible(got), visible(s))
+			return
+		}
+		want := modelEscapeStates(s, seq)
+		gs := visibleStates(got)
+		for i := range want {
+			if gs[i].st != want[i] {
+				fail(ht, "Escape(%q, %q) = %q: rune %d %q in state %s, want %s", s, seq, got, i, gs[i].r, gs[i].st, want[i])
+				return
+			}
+		}
+		if got != "" && stateAfter(got) != (sgr{}) {
+			fail(ht, "Escape(%q, %q) = %q ends in state %s", s, seq, got, stateAfter(got))
+			return
+		}
+		// Colors.Sprint is Escape of the printed value
+		if sp := colors.Sprint(s); sp != text.Escape(s, seq) && !(seq == "" && sp == s) {
+			fail(ht, "Colors(%v).Sprint(%q) = %q, want %q", colors, s, sp, text.Escape(s, seq))
+			return
+		}
+		// the parser's restored sequence denotes the state at the end of s
+		esp := text.EscSeqParser{}
+		esp.ParseString(s)
+		restored := esp.Sequence()
+		wantSt := stateAfter(s)
+		if gotSt := stateAfter(restored); gotSt != wantSt {
+			fail(ht, "EscSeqParser.ParseString(%q).Sequence() = %q (state %s), want state %s", s, restored, gotSt, wantSt)
+			return
+		}
+		if esp.IsOpen() != (wantSt != sgr{}) {
+			fail(ht, "EscSeqParser after %q: IsOpen %v, state %s", s, esp.IsOpen(), wantSt)
+			return
+		}
+		count(ht, fmt.Sprintf("colors=%d", len(colors)))
+	})
+}
diff --git a/hegel/hegel_table_model_test.go b/hegel/hegel_table_model_test.go
new file mode 100644
index 0000000..ce0f3c1
--- /dev/null
+++ b/hegel/hegel_table_model_test.go
@@ -0,0 +1,1097 @@
+package hegel
+
+// The table package: a model of the rows as documented (stringified, filtered, hidden columns
+// removed) and the exact CSV, TSV, Markdown and HTML renderings built on it.
+
+import (
+	"fmt"
+	"html"
+	"math"
+	"regexp"
+	"strconv"
+	"strings"
+	"unicode"
+
+	"github.com/jedib0t/go-pretty/v6/table"
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- cells
+
+var wordCells = []string{"a", "bb", "ccc", "Arya", "Stark", "x", "Y", "zz", "Jon Snow", "foo bar", "  lead", "trail  ", "0x10", "1e3", "NaN", "Inf", "A", "arya", "1000", ""}
+
+var specialCells = []string{
+	"a|b", "|", "q\"uote", "com,ma", "l1\nl2", "\n", "back\\slash", "esc\\|pipe", "a\\*b", "\\",
+	"'apos", "<tag>", "amp&", "-neg", "=formula", "+plus", "@at", "tab\there", "    four",
+	"日本語", "\U0001F600", "é", "  ", "a  b",
+}
+
+type cellOpts struct {
+	plain            bool // ASCII words without edge spaces
+	noNewline        bool
+	noPipe           bool
+	noBackslashPunct bool // no backslash followed by ASCII punctuation
+	noAngle          bool
+}
+
+func cellAllowed(s string, o cellOpts) bool {
+	if o.noNewline && strings.Contains(s, "\n") {
+		return false
+	}
+	if o.noPipe && strings.Contains(s, "|") {
+		return false
+	}
+	if o.noAngle && strings.Contains(s, "<") {
+		return false
+	}
+	if o.noBackslashPunct {
+		rs := []rune(s)
+		for i := 0; i+1 < len(rs); i++ {
+			if rs[i] == '\\' && rs[i+1] < 128 && unicode.IsPunct(rs[i+1]) || rs[i] == '\\' && rs[i+1] < 128 && unicode.IsSymbol(rs[i+1]) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// specialsAllowed: the special cells the options allow (computed once per option set, so no
+// retry loop is needed).
+func specialsAllowed(o cellOpts) []string {
+	var out []string
+	for _, s := range specialCells {
+		if cellAllowed(s, o) {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+var (
+	int8Cells  = asAny(hegel.Map(hegel.Integers(-128, 127), func(n int) int8 { return int8(n) }))
+	uintCells  = asAny(hegel.Map(hegel.Integers(0, 500), func(n int) uint { return uint(n) }))
+	int64Cells = asAny(hegel.Map(hegel.Integers(-100000, 100000), func(n int) int64 { return int64(n) }))
+	f64Cells   = asAny(hegel.Map(hegel.Integers(-4000, 4000), func(n int) float64 { return float64(n) / 8 }))
+	f32Cells   = asAny(hegel.Map(hegel.Integers(-100, 100), func(n int) float32 { return float32(n) / 4 }))
+	// plainCells: ASCII words without edge spaces (the header's cells).
+	plainCells = asAny(hegel.SampledFrom(wordCells[:8]))
+)
+
+// cells: a raw cell value of any of the kinds the package stringifies: a word two times in
+// eleven, an int two times, a float64, a float32, a special string three times, a bool, and a
+// narrow integer or nil.
+func cells(o cellOpts) hegel.Generator[any] {
+	if o.plain {
+		return plainCells
+	}
+	return weighted(
+		choice[any]{2, asAny(hegel.SampledFrom(wordCells))},
+		choice[any]{2, asAny(hegel.Integers(-999, 9999))},
+		choice[any]{1, f64Cells},
+		choice[any]{1, f32Cells},
+		choice[any]{3, asAny(hegel.SampledFrom(specialsAllowed(o)))},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{1, hegel.OneOf(int8Cells, uintCells, int64Cells, hegel.Just[any](nil))},
+	)
+}
+
+// rowLists: minRows to maxRows rows of lo to hi cells each (an empty row non-nil, as appended).
+func rowLists(cell hegel.Generator[any], lo, hi, minRows, maxRows int) hegel.Generator[[][]any] {
+	return many(hegel.Map(many(cell, lo, hi), nonNil[any]), minRows, maxRows)
+}
+
+// cellStr: the documented string of a cell (convertValueToString, tabs expanded).
+func cellStr(v any) string {
+	var s string
+	switch x := v.(type) {
+	case string:
+		s = x
+	case int:
+		s = strconv.Itoa(x)
+	case int8:
+		s = strconv.FormatInt(int64(x), 10)
+	case int64:
+		s = strconv.FormatInt(x, 10)
+	case uint:
+		s = strconv.FormatUint(uint64(x), 10)
+	case float32:
+		s = strconv.FormatFloat(float64(x), 'g', -1, 32)
+	case float64:
+		s = strconv.FormatFloat(x, 'g', -1, 64)
+	case bool:
+		if x {
+			s = "true"
+		} else {
+			s = "false"
+		}
+	default:
+		s = fmt.Sprint(v)
+	}
+	return strings.ReplaceAll(s, "\t", "    ")
+}
+
+func isNumberCell(v any) bool {
+	switch v.(type) {
+	case int, int8, int16, int32, int64, uint, uint8, uint16, uint32, uint64, float32, float64:
+		return true
+	}
+	return false
+}
+
+// autoIndexID: the spreadsheet-style column name (A..Z, AA..).
+func autoIndexID(c int) string {
+	out := string(rune('A' + c%26))
+	if c/26 > 0 {
+		return autoIndexID(c/26-1) + out
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- specs
+
+type tableSpec struct {
+	title, caption       string
+	header, body, footer [][]any
+	autoIndex            bool
+	configs              []table.ColumnConfig
+	filters              []table.FilterBy
+	sorts                []table.SortBy
+	suppressEmpty        bool
+	fieldProtection      bool
+	padContent           bool
+	separateRows         bool
+	sizeWidthMax         int
+	sizeWidthMin         int
+	mergeRow             int // index of the body row carrying RowConfig{AutoMerge}, -1 for none
+	ncols                int // the columns the rows were drawn for
+}
+
+// GoString is the draw report's spelling of the spec.
+func (s *tableSpec) GoString() string { return s.String() }
+
+// String: the spec, for failure messages.
+func (s *tableSpec) String() string {
+	var cfgs []string
+	for _, c := range s.configs {
+		cfgs = append(cfgs, fmt.Sprintf("{Name:%q Number:%d Hidden:%v T:%v TH:%v TF:%v WidthMax:%d}", c.Name, c.Number, c.Hidden, c.Transformer != nil, c.TransformerHeader != nil, c.TransformerFooter != nil, c.WidthMax))
+	}
+	return fmt.Sprintf("title=%q caption=%q header=%q body=%q footer=%q autoIndex=%v configs=%v filters=%+v sorts=%+v suppress=%v protect=%v pad=%v sepRows=%v widthMax=%d widthMin=%d mergeRow=%d",
+		s.title, s.caption, s.header, s.body, s.footer, s.autoIndex, cfgs, s.filters, s.sorts, s.suppressEmpty, s.fieldProtection, s.padContent, s.separateRows, s.sizeWidthMax, s.sizeWidthMin, s.mergeRow)
+}
+
+// colRef: how a column is named: by the header (the nameIdx-th cell of the first header row,
+// modulo its length, or a name no column has), or by number (numIdx modulo ncols+1, plus one:
+// one past the last column sometimes). By number when there is no header row.
+type colRef struct {
+	byName, noSuch  bool
+	nameIdx, numIdx int
+}
+
+// resolve: the Name (and no Number) or the Number (and no Name) of the reference.
+func (r colRef) resolve(header [][]any, ncols int) (name string, number int) {
+	if r.byName && len(header) > 0 && len(header[0]) > 0 {
+		if r.noSuch {
+			return "no-such-column", 0
+		}
+		return fmt.Sprint(at(header[0], r.nameIdx)), 0
+	}
+	return "", 1 + r.numIdx%(ncols+1)
+}
+
+// colRefs: by name namePct percent of the time, and then a name no column has noSuchPct
+// percent of the time.
+func colRefs(namePct, noSuchPct int) hegel.Generator[colRef] {
+	return hegel.Composite(func(tc hegel.TestCase) colRef {
+		return colRef{
+			byName:  hegel.Draw(tc, chance(namePct)),
+			noSuch:  hegel.Draw(tc, chance(noSuchPct)),
+			nameIdx: hegel.Draw(tc, positions),
+			numIdx:  hegel.Draw(tc, positions),
+		}
+	})
+}
+
+// configSpec: a column config by number or by header name (some unresolvable), of one kind:
+// hidden, a transformer, a header transformer or a footer transformer.
+type configSpec struct {
+	col  colRef
+	kind int
+}
+
+var configSpecs = hegel.Map(pairs(colRefs(50, 15), hegel.Integers(0, 3)), func(p pair[colRef, int]) configSpec { return configSpec{p.a, p.b} })
+
+// configsOf resolves the specs against the header.
+func configsOf(specs []configSpec, header [][]any, ncols int) []table.ColumnConfig {
+	var cfgs []table.ColumnConfig
+	for _, c := range specs {
+		var cfg table.ColumnConfig
+		cfg.Name, cfg.Number = c.col.resolve(header, ncols)
+		switch c.kind {
+		case 0:
+			cfg.Hidden = true
+		case 1:
+			cfg.Transformer = func(v any) string { return "T:" + cellStr(v) }
+		case 2:
+			cfg.TransformerHeader = func(v any) string { return "H:" + cellStr(v) }
+		case 3:
+			cfg.TransformerFooter = func(v any) string { return "F:" + cellStr(v) }
+		}
+		cfgs = append(cfgs, cfg)
+	}
+	return cfgs
+}
+
+func (s *tableSpec) hasHeaderTransformer() bool {
+	for _, c := range s.configs {
+		if c.TransformerHeader != nil {
+			return true
+		}
+	}
+	return false
+}
+
+// build: the table as the spec describes.
+func (s *tableSpec) build() table.Writer {
+	tw := table.NewWriter()
+	if s.title != "" {
+		tw.SetTitle("%s", s.title)
+	}
+	if s.caption != "" {
+		tw.SetCaption("%s", s.caption)
+	}
+	for _, r := range s.header {
+		tw.AppendHeader(table.Row(r))
+	}
+	for i, r := range s.body {
+		if i == s.mergeRow {
+			tw.AppendRow(table.Row(r), table.RowConfig{AutoMerge: true})
+		} else {
+			tw.AppendRow(table.Row(r))
+		}
+	}
+	for _, r := range s.footer {
+		tw.AppendFooter(table.Row(r))
+	}
+	tw.SetAutoIndex(s.autoIndex)
+	if len(s.configs) > 0 {
+		tw.SetColumnConfigs(s.configs)
+	}
+	if len(s.filters) > 0 {
+		tw.FilterBy(s.filters)
+	}
+	if len(s.sorts) > 0 {
+		tw.SortBy(s.sorts)
+	}
+	if s.suppressEmpty {
+		tw.SuppressEmptyColumns()
+	}
+	tw.Style().CSV.FieldProtection = s.fieldProtection
+	tw.Style().Markdown.PadContent = s.padContent
+	tw.Style().Options.SeparateRows = s.separateRows
+	tw.Style().Size.WidthMax = s.sizeWidthMax
+	tw.Style().Size.WidthMin = s.sizeWidthMin
+	return tw
+}
+
+// --------------------------------------------------------------------------- the row model
+
+type tableModel struct {
+	header, body, footer [][]string
+	numCols              int
+	numeric              []bool // column holds numbers in every body row that has it
+	configs              map[int]table.ColumnConfig
+	bodyRaw              [][]any // the filtered raw body rows, in order
+	// before hidden columns are removed (sorting sees these)
+	headerFull, bodyFull [][]string
+	numColsFull          int
+}
+
+func rawNumCols(rows ...[][]any) int {
+	n := 0
+	for _, rs := range rows {
+		for _, r := range rs {
+			if len(r) > n {
+				n = len(r)
+			}
+		}
+	}
+	return n
+}
+
+// resolveColumn: Number when valid, else Name in the first header row (raw strings), else 0.
+func resolveColumn(number int, name string, numCols int, header [][]any) int {
+	if number > 0 && number <= numCols {
+		return number
+	}
+	if name != "" && len(header) > 0 {
+		for i, c := range header[0] {
+			if fmt.Sprint(c) == name {
+				return i + 1
+			}
+		}
+	}
+	return 0
+}
+
+// modelTable: the rows the package renders, given the body order (nil: as appended).
+func modelTable(s *tableSpec, order []int) *tableModel {
+	m := &tableModel{}
+	// filters, on the raw rows
+	nraw := rawNumCols(s.header, s.body, s.footer)
+	var filters []table.FilterBy
+	for _, f := range s.filters {
+		if n := resolveColumn(f.Number, f.Name, nraw, s.header); n > 0 {
+			f.Number = n
+			filters = append(filters, f)
+		}
+	}
+	for _, r := range s.body {
+		keep := true
+		for _, f := range filters {
+			if !matchFilter(r, f) {
+				keep = false
+				break
+			}
+		}
+		if keep {
+			m.bodyRaw = append(m.bodyRaw, r)
+		}
+	}
+	if order != nil {
+		re := make([][]any, len(order))
+		for i, o := range order {
+			re[i] = m.bodyRaw[o]
+		}
+		m.bodyRaw = re
+	}
+	// column configs: by number, or by name in any header row
+	m.configs = map[int]table.ColumnConfig{}
+	for _, cfg := range s.configs {
+		n := cfg.Number
+		if n == 0 {
+			for _, hr := range s.header {
+				for i, c := range hr {
+					if fmt.Sprint(c) == cfg.Name {
+						n = i + 1
+						break
+					}
+				}
+				if n > 0 {
+					break
+				}
+			}
+		}
+		if n > 0 {
+			cfg.Number = n
+			m.configs[n-1] = cfg
+		}
+	}
+	// stringify
+	str := func(rows [][]any, kind int) [][]string {
+		out := make([][]string, len(rows))
+		for i, r := range rows {
+			sr := make([]string, len(r))
+			for j, v := range r {
+				var tr text.Transformer
+				if cfg, ok := m.configs[j]; ok {
+					switch kind {
+					case 0:
+						tr = cfg.TransformerHeader
+					case 1:
+						tr = cfg.Transformer
+					default:
+						tr = cfg.TransformerFooter
+					}
+				}
+				if tr != nil {
+					sr[j] = strings.ReplaceAll(tr(v), "\t", "    ")
+				} else {
+					sr[j] = cellStr(v)
+				}
+			}
+			out[i] = sr
+		}
+		return out
+	}
+	m.header = str(s.header, 0)
+	m.body = str(m.bodyRaw, 1)
+	m.footer = str(s.footer, 2)
+	m.numCols = 0
+	for _, rs := range [][][]string{m.header, m.body, m.footer} {
+		for _, r := range rs {
+			if len(r) > m.numCols {
+				m.numCols = len(r)
+			}
+		}
+	}
+	// numeric columns: every body row holding the column holds a number
+	m.numeric = make([]bool, m.numCols)
+	for c := range m.numeric {
+		m.numeric[c] = true
+		for _, r := range m.bodyRaw {
+			if c < len(r) && !isNumberCell(r[c]) {
+				m.numeric[c] = false
+				break
+			}
+		}
+	}
+	// suppressed columns: empty (or unprintable) in every body row
+	if s.suppressEmpty {
+		for c := 0; c < m.numCols; c++ {
+			empty := true
+			for _, r := range m.body {
+				if c < len(r) && r[c] != "" && Known.suppressFirstCell {
+					// the first non-empty cell decides alone
+					empty = strings.IndexFunc(r[c], unicode.IsPrint) < 0
+					break
+				}
+				if c < len(r) && strings.IndexFunc(r[c], unicode.IsPrint) >= 0 {
+					empty = false
+					break
+				}
+			}
+			if empty {
+				cfg := m.configs[c]
+				cfg.Hidden = true
+				m.configs[c] = cfg
+			}
+		}
+	}
+	m.headerFull, m.bodyFull, m.numColsFull = m.header, m.body, m.numCols
+	// hidden columns
+	hidden := false
+	for _, cfg := range m.configs {
+		if cfg.Hidden {
+			hidden = true
+		}
+	}
+	if hidden {
+		newIdx := map[int]int{}
+		hide := func(rows [][]string) [][]string {
+			out := make([][]string, len(rows))
+			for i, r := range rows {
+				var nr []string
+				for j, c := range r {
+					if !m.configs[j].Hidden {
+						nr = append(nr, c)
+						newIdx[j] = len(nr) - 1
+					}
+				}
+				out[i] = nr
+			}
+			return out
+		}
+		m.header, m.body, m.footer = hide(m.header), hide(m.body), hide(m.footer)
+		n := 0
+		for _, rs := range [][][]string{m.header, m.body, m.footer} {
+			for _, r := range rs {
+				if len(r) > n {
+					n = len(r)
+				}
+			}
+		}
+		numeric := make([]bool, n)
+		configs := map[int]table.ColumnConfig{}
+		for old, nw := range newIdx {
+			if old < len(m.numeric) {
+				numeric[nw] = m.numeric[old]
+			}
+			if cfg, ok := m.configs[old]; ok {
+				configs[nw] = cfg
+			}
+		}
+		m.numCols, m.numeric, m.configs = n, numeric, configs
+	}
+	return m
+}
+
+func (m *tableModel) cell(row []string, c int) string {
+	if c < len(row) {
+		return row[c]
+	}
+	return ""
+}
+
+// --------------------------------------------------------------------------- filters
+
+func filterValueStr(v any) string { return fmt.Sprint(v) }
+
+// matchFilter: the documented filter on a raw row.
+func matchFilter(row []any, f table.FilterBy) bool {
+	c := f.Number - 1
+	if c >= len(row) {
+		if Known.filterShortRow {
+			return false
+		}
+		return matchOperator("", f)
+	}
+	return matchOperator(fmt.Sprint(row[c]), f)
+}
+
+func matchOperator(cell string, f table.FilterBy) bool {
+	fs := filterValueStr(f.Value)
+	fold := func(s string) string {
+		if f.IgnoreCase {
+			return strings.ToLower(s)
+		}
+		return s
+	}
+	equal := func() bool {
+		if !Known.filterEqualString {
+			a, errA := strconv.ParseFloat(cell, 64)
+			b, errB := strconv.ParseFloat(fs, 64)
+			if errA == nil && errB == nil {
+				return a == b
+			}
+		}
+		if f.IgnoreCase {
+			return strings.EqualFold(cell, fs)
+		}
+		return cell == fs
+	}
+	numeric := func(cmp func(a, b float64) bool) bool {
+		a, errA := strconv.ParseFloat(cell, 64)
+		b, errB := strconv.ParseFloat(fs, 64)
+		if errA != nil || errB != nil {
+			return false
+		}
+		return cmp(a, b)
+	}
+	regex := func() bool {
+		pat := fs
+		if f.IgnoreCase {
+			pat = "(?i)" + pat
+		}
+		re, err := regexp.Compile(pat)
+		if err != nil {
+			return equal()
+		}
+		return re.MatchString(cell)
+	}
+	switch f.Operator {
+	case table.Equal:
+		return equal()
+	case table.NotEqual:
+		return !equal()
+	case table.GreaterThan:
+		return numeric(func(a, b float64) bool { return a > b })
+	case table.GreaterThanOrEqual:
+		return numeric(func(a, b float64) bool { return a >= b })
+	case table.LessThan:
+		return numeric(func(a, b float64) bool { return a < b })
+	case table.LessThanOrEqual:
+		return numeric(func(a, b float64) bool { return a <= b })
+	case table.Contains:
+		return strings.Contains(fold(cell), fold(fs))
+	case table.NotContains:
+		return !strings.Contains(fold(cell), fold(fs))
+	case table.StartsWith:
+		return strings.HasPrefix(fold(cell), fold(fs))
+	case table.EndsWith:
+		return strings.HasSuffix(fold(cell), fold(fs))
+	case table.RegexMatch:
+		return regex()
+	case table.RegexNotMatch:
+		return !regex()
+	}
+	return false
+}
+
+var filterRegexes = []string{"^a", "[0-9]+$", "x|y", "^-", "(?i)ARYA", "^$", "\\d\\.\\d", "["}
+
+// filterSpec: a filter by number or header name, of any operator and value kind.
+type filterSpec struct {
+	col        colRef
+	op         table.FilterOperator
+	ignoreCase bool
+	value      any
+}
+
+var (
+	// filterValues: the value of a non-regex filter: an int, a float, an int as text, one of a
+	// few edge strings, or a word cell.
+	filterValues = hegel.OneOf(
+		asAny(hegel.Integers(-10, 10)),
+		asAny(hegel.Map(hegel.Integers(-20, 20), func(n int) float64 { return float64(n) / 4 })),
+		asAny(hegel.Map(hegel.Integers(-10, 10), strconv.Itoa)),
+		asAny(hegel.SampledFrom([]string{"a", "Arya", "x", "", "5.0", "1e3", "NaN", "|", "\n"})),
+		asAny(hegel.SampledFrom(wordCells)),
+	)
+	filterOps = hegel.Map(hegel.Integers(0, 11), func(n int) table.FilterOperator { return table.FilterOperator(n) })
+	// filterSpecs: the value depends on the operator (a pattern for the regex operators).
+	filterSpecs = hegel.Composite(func(tc hegel.TestCase) filterSpec {
+		f := filterSpec{col: hegel.Draw(tc, colRefs(40, 10)), op: hegel.Draw(tc, filterOps), ignoreCase: hegel.Draw(tc, chance(30))}
+		switch f.op {
+		case table.RegexMatch, table.RegexNotMatch:
+			f.value = hegel.Draw(tc, hegel.SampledFrom(filterRegexes))
+		default:
+			f.value = hegel.Draw(tc, filterValues)
+		}
+		return f
+	})
+)
+
+// filtersOf resolves the specs against the header.
+func filtersOf(specs []filterSpec, header [][]any, ncols int) []table.FilterBy {
+	var fs []table.FilterBy
+	for _, sp := range specs {
+		f := table.FilterBy{Operator: sp.op, IgnoreCase: sp.ignoreCase, Value: sp.value}
+		f.Name, f.Number = sp.col.resolve(header, ncols)
+		fs = append(fs, f)
+	}
+	return fs
+}
+
+// --------------------------------------------------------------------------- sorting
+
+// sortKeyCmp: the documented order of two cell strings under a SortBy: -1, 0 (equal or
+// incomparable), 1.
+func sortKeyCmp(a, b string, sb table.SortBy) int {
+	asc := true
+	switch sb.Mode {
+	case table.Dsc, table.DscAlphaNumeric, table.DscNumeric, table.DscNumericAlpha:
+		asc = false
+	}
+	dir := func(c int) int {
+		if asc {
+			return c
+		}
+		return -c
+	}
+	alpha := func() int {
+		x, y := a, b
+		if sb.IgnoreCase {
+			x, y = strings.ToLower(a), strings.ToLower(b)
+		}
+		return dir(strings.Compare(x, y))
+	}
+	if sb.Mode == table.Asc || sb.Mode == table.Dsc {
+		return alpha() // plain string order: a "NaN" is a word like any other
+	}
+	fa, errA := strconv.ParseFloat(a, 64)
+	fb, errB := strconv.ParseFloat(b, 64)
+	if errA == nil && math.IsNaN(fa) || errB == nil && math.IsNaN(fb) {
+		return 0 // incomparable
+	}
+	num := func() int {
+		switch {
+		case fa < fb:
+			return dir(-1)
+		case fa > fb:
+			return dir(1)
+		}
+		return 0
+	}
+	switch sb.Mode {
+	case table.AscNumeric, table.DscNumeric:
+		if errA != nil || errB != nil {
+			return 0 // incomparable
+		}
+		return num()
+	case table.AscAlphaNumeric, table.DscAlphaNumeric:
+		// alphabetic values before numeric ones
+		if errA != nil && errB != nil {
+			return alpha()
+		}
+		if errA != nil {
+			return -1
+		}
+		if errB != nil {
+			return 1
+		}
+		return num()
+	default: // AscNumericAlpha, DscNumericAlpha: numeric values before alphabetic ones
+		if errA != nil && errB != nil {
+			return alpha()
+		}
+		if errA != nil {
+			return 1
+		}
+		if errB != nil {
+			return -1
+		}
+		return num()
+	}
+}
+
+// resolveSorts: the keys the package applies (by number, or by name in the first header row),
+// duplicates on a column discarded as documented.
+func resolveSorts(s *tableSpec, m *tableModel) []table.SortBy {
+	var out []table.SortBy
+	seen := map[int]bool{}
+	for _, sb := range s.sorts {
+		n := 0
+		if sb.Number > 0 && sb.Number <= m.numColsFull {
+			n = sb.Number
+		} else if sb.Name != "" && len(s.header) > 0 {
+			for i, c := range s.header[0] {
+				if fmt.Sprint(c) == sb.Name {
+					n = i + 1
+					break
+				}
+			}
+		}
+		if n == 0 || seen[n] && !Known.sortDuplicateKeys {
+			continue
+		}
+		seen[n] = true
+		sb.Number = n
+		out = append(out, sb)
+	}
+	return out
+}
+
+// rowsCmp: the documented order of two stringified rows under the keys.
+func rowsCmp(a, b []string, keys []table.SortBy) int {
+	for _, k := range keys {
+		var x, y string
+		if k.Number-1 < len(a) {
+			x = a[k.Number-1]
+		}
+		if k.Number-1 < len(b) {
+			y = b[k.Number-1]
+		}
+		if x == y {
+			continue
+		}
+		if c := sortKeyCmp(x, y, k); c != 0 {
+			return c
+		}
+		if k.Mode != table.Asc && k.Mode != table.Dsc {
+			// incomparable (a non-number under a numeric sort, NaN): the remaining keys are
+			// not consulted
+			return 0
+		}
+	}
+	return 0
+}
+
+// sortSpec: a sort key by number or header name, of any mode.
+type sortSpec struct {
+	col        colRef
+	mode       table.SortMode
+	ignoreCase bool
+}
+
+var sortSpecs = hegel.Composite(func(tc hegel.TestCase) sortSpec {
+	return sortSpec{
+		col:        hegel.Draw(tc, colRefs(40, 0)),
+		mode:       hegel.Draw(tc, hegel.Map(hegel.Integers(0, 7), func(n int) table.SortMode { return table.SortMode(n) })),
+		ignoreCase: hegel.Draw(tc, chance(30)),
+	}
+})
+
+// sortsOf resolves the specs against the spec's header: by number rather than by name while
+// go-pretty/31's switch is on and a header transformer is set; a second key on the column of
+// the first is dropped while go-pretty/30's switch is on.
+func sortsOf(specs []sortSpec, s *tableSpec) []table.SortBy {
+	var out []table.SortBy
+	for _, sp := range specs {
+		sb := table.SortBy{Mode: sp.mode, IgnoreCase: sp.ignoreCase}
+		col := sp.col
+		if Known.sortNameTransformed && s.hasHeaderTransformer() {
+			col.byName = false
+		}
+		sb.Name, sb.Number = col.resolve(s.header, s.ncols)
+		out = append(out, sb)
+	}
+	if Known.sortDuplicateKeys && len(out) == 2 {
+		if out[0].Number == out[1].Number && (out[0].Number > 0 || out[0].Name == out[1].Name) {
+			out = out[:1]
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- CSV / TSV
+
+func csvProtect(s string, on bool) string {
+	if !on || s == "" {
+		return s
+	}
+	switch s[0] {
+	case '=', '+', '-', '@', '\t', '\r':
+		return "'" + s
+	}
+	return s
+}
+
+// csvKept: whether the record of a row is written at all: under Known.csvLoneEmptyField a
+// row of one empty field is written as an empty line, which readers skip.
+func (m *tableModel) csvKept(s *tableSpec, r []string) bool {
+	return !(Known.csvLoneEmptyField && !s.autoIndex && m.numCols == 1 && m.cell(r, 0) == "")
+}
+
+// csvRecords: the documented records of RenderCSV (protect: FieldProtection) and RenderTSV.
+func (m *tableModel) csvRecords(s *tableSpec, protect bool) [][]string {
+	if m.numCols == 0 {
+		return nil
+	}
+	var recs [][]string
+	row := func(r []string, idx string) {
+		if !m.csvKept(s, r) {
+			return
+		}
+		var rec []string
+		if s.autoIndex {
+			rec = append(rec, idx)
+		}
+		for c := 0; c < m.numCols; c++ {
+			rec = append(rec, csvProtect(m.cell(r, c), protect))
+		}
+		recs = append(recs, rec)
+	}
+	if s.autoIndex && len(m.header) == 0 {
+		ids := make([]string, m.numCols)
+		for c := range ids {
+			ids[c] = autoIndexID(c)
+		}
+		row(ids, "")
+	}
+	for _, r := range m.header {
+		row(r, "")
+	}
+	for i, r := range m.body {
+		row(r, strconv.Itoa(i+1))
+	}
+	for _, r := range m.footer {
+		row(r, "")
+	}
+	return recs
+}
+
+// --------------------------------------------------------------------------- Markdown
+
+func mdEscape(s string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(s, "|", "\\|"), "\n", "<br/>")
+}
+
+// markdown: the documented RenderMarkdown output.
+func (m *tableModel) markdown(s *tableSpec) string {
+	if m.numCols == 0 {
+		return ""
+	}
+	widths := make([]int, m.numCols)
+	for _, rs := range [][][]string{m.header, m.body, m.footer} {
+		for _, r := range rs {
+			for c, v := range r {
+				w := text.StringWidthWithoutEscSequences(mdEscape(v)) // the content as written
+				if Known.markdownPadRaw {
+					w = text.LongestLineLen(v)
+				}
+				if w > widths[c] {
+					widths[c] = w
+				}
+			}
+		}
+	}
+	idxW := len(strconv.Itoa(len(m.body)))
+	const (
+		kindHeader = iota
+		kindAutoIndexRow
+		kindBody
+		kindFooter
+		kindSeparator
+	)
+	align := func(c, kind int) text.Align {
+		if m.numeric[c] {
+			return text.AlignRight
+		}
+		if kind == kindAutoIndexRow {
+			return text.AlignCenter
+		}
+		return text.AlignDefault
+	}
+	var lines []string
+	if s.title != "" {
+		lines = append(lines, "# "+s.title)
+	}
+	row := func(r []string, kind int, idx string) {
+		var b strings.Builder
+		b.WriteString("|")
+		for c := 0; c < m.numCols; c++ {
+			if c == 0 && s.autoIndex {
+				switch {
+				case kind == kindSeparator && s.padContent:
+					b.WriteString(" " + strings.Repeat("-", idxW) + ":")
+				case kind == kindSeparator:
+					b.WriteString(" ---:")
+				case kind == kindBody && s.padContent:
+					b.WriteString(" " + fmt.Sprintf("%*s", idxW, idx) + " ")
+				case kind == kindBody:
+					b.WriteString(" " + idx + " ")
+				case s.padContent:
+					b.WriteString(" " + strings.Repeat(" ", idxW) + " ")
+				default:
+					b.WriteString(" ")
+				}
+				b.WriteString("|")
+			}
+			if kind == kindSeparator {
+				if s.padContent {
+					b.WriteString(align(c, kind).MarkdownProperty(widths[c]))
+				} else {
+					b.WriteString(align(c, kind).MarkdownProperty())
+				}
+			} else {
+				cell := mdEscape(m.cell(r, c))
+				if s.padContent {
+					cell = align(c, kind).Apply(cell, widths[c])
+				}
+				b.WriteString(" " + cell + " ")
+			}
+			b.WriteString("|")
+		}
+		lines = append(lines, b.String())
+	}
+	if len(m.header) > 0 {
+		for _, r := range m.header {
+			row(r, kindHeader, "")
+		}
+		row(nil, kindSeparator, "")
+	} else if s.autoIndex {
+		ids := make([]string, m.numCols)
+		for c := range ids {
+			ids[c] = autoIndexID(c)
+		}
+		row(ids, kindAutoIndexRow, "")
+		row(nil, kindSeparator, "")
+	}
+	for i, r := range m.body {
+		row(r, kindBody, strconv.Itoa(i+1))
+	}
+	for _, r := range m.footer {
+		row(r, kindFooter, "")
+	}
+	if s.caption != "" {
+		lines = append(lines, "_"+s.caption+"_")
+	}
+	return strings.Join(lines, "\n")
+}
+
+// gfmCells: the cells a GFM table parser reads from a row line: pipes split, "\|" is a
+// pipe, backslash-escaped ASCII punctuation is that punctuation, cells are trimmed.
+func gfmCells(line string) []string {
+	line = strings.TrimSpace(line)
+	line = strings.TrimPrefix(line, "|")
+	line = strings.TrimSuffix(line, "|")
+	var cells []string
+	var cur strings.Builder
+	rs := []rune(line)
+	for i := 0; i < len(rs); i++ {
+		if rs[i] == '\\' && i+1 < len(rs) && rs[i+1] == '|' {
+			cur.WriteString("\\|")
+			i++
+			continue
+		}
+		if rs[i] == '|' {
+			cells = append(cells, cur.String())
+			cur.Reset()
+			continue
+		}
+		cur.WriteRune(rs[i])
+	}
+	cells = append(cells, cur.String())
+	for i, c := range cells {
+		c = strings.ReplaceAll(c, "\\|", "|")
+		var b strings.Builder
+		cr := []rune(c)
+		for j := 0; j < len(cr); j++ {
+			if cr[j] == '\\' && j+1 < len(cr) && cr[j+1] < 128 && (unicode.IsPunct(cr[j+1]) || unicode.IsSymbol(cr[j+1])) {
+				b.WriteRune(cr[j+1])
+				j++
+				continue
+			}
+			b.WriteRune(cr[j])
+		}
+		cells[i] = strings.TrimSpace(strings.ReplaceAll(b.String(), "<br/>", "\n"))
+	}
+	return cells
+}
+
+// --------------------------------------------------------------------------- HTML
+
+func htmlCell(s string) string {
+	if s == "" {
+		return "&nbsp;"
+	}
+	return strings.ReplaceAll(html.EscapeString(s), "\n", "<br/>")
+}
+
+// htmlOut: the documented RenderHTML output.
+func (m *tableModel) htmlOut(s *tableSpec) string {
+	if m.numCols == 0 {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString("<table class=\"go-pretty-table\">\n")
+	if s.title != "" {
+		b.WriteString("  <caption class=\"title\">" + html.EscapeString(s.title) + "</caption>\n")
+	}
+	const (
+		kindHeader = iota
+		kindAutoIndexRow
+		kindBody
+		kindFooter
+	)
+	rows := func(rs [][]string, kind int) {
+		tag, groupTag := "td", "tbody"
+		switch kind {
+		case kindHeader, kindAutoIndexRow:
+			tag, groupTag = "th", "thead"
+		case kindFooter:
+			groupTag = "tfoot"
+		}
+		open := false
+		for i, r := range rs {
+			if len(r) == 0 && Known.emptyRow {
+				continue
+			}
+			if !open {
+				b.WriteString("  <" + groupTag + ">\n")
+				open = true
+			}
+			b.WriteString("  <tr>\n")
+			for c := 0; c < m.numCols; c++ {
+				if c == 0 && s.autoIndex {
+					switch kind {
+					case kindHeader, kindAutoIndexRow:
+						b.WriteString("    <th>&nbsp;</th>\n")
+					case kindFooter:
+						b.WriteString("    <td>&nbsp;</td>\n")
+					default:
+						b.WriteString("    <td align=\"right\">" + strconv.Itoa(i+1) + "</td>\n")
+					}
+				}
+				attr := ""
+				if m.numeric[c] {
+					attr = " align=\"right\""
+				} else if kind == kindAutoIndexRow {
+					attr = " align=\"center\""
+				}
+				b.WriteString("    <" + tag + attr + ">" + htmlCell(m.cell(r, c)) + "</" + tag + ">\n")
+			}
+			b.WriteString("  </tr>\n")
+		}
+		if open {
+			b.WriteString("  </" + groupTag + ">\n")
+		}
+	}
+	if len(m.header) > 0 {
+		rows(m.header, kindHeader)
+	} else if s.autoIndex {
+		ids := make([]string, m.numCols)
+		for c := range ids {
+			ids[c] = autoIndexID(c)
+		}
+		rows([][]string{ids}, kindAutoIndexRow)
+	}
+	rows(m.body, kindBody)
+	rows(m.footer, kindFooter)
+	if s.caption != "" {
+		b.WriteString("  <caption class=\"caption\" style=\"caption-side: bottom;\">" + html.EscapeString(s.caption) + "</caption>\n")
+	}
+	b.WriteString("</table>")
+	return b.String()
+}
