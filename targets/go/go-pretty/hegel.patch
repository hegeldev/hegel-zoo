+}
+
+func TestHegelPinPagerStale(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a"})
+	for i := 1; i <= 5; i++ {
+		tw.AppendRow(table.Row{i})
+	}
+	p := tw.Pager(table.PageSize(2))
+	p.GoTo(3)
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Pager(PageSize(3)) after a pager at page 3: %v", r)
+		}
+	}()
+	p2 := tw.Pager(table.PageSize(3))
+	if p2.Location() != 1 {
+		t.Fatalf("Pager(PageSize(3)).Location() = %d, want 1", p2.Location())
+	}
+	p2.Render()
+}
+
+func TestHegelPinSuppressFirstCell(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b"})
+	tw.AppendRow(table.Row{1, "\n"})
+	tw.AppendRow(table.Row{2, "content"})
+	tw.SuppressEmptyColumns()
+	if out := tw.Render(); !strings.Contains(out, "content") {
+		t.Fatalf("Render() with SuppressEmptyColumns =\n%s\nhides column b, which has content", out)
+	}
+}
+
+func TestHegelPinTitleWidthMax(t *testing.T) {
+	tw := table.NewWriter()
+	tw.SetTitle("Title")
