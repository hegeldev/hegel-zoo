+// TestHegelTableRender: the boxed rendering: every line the same width (or within
+// Size.WidthMax), the line layout, the cells' text, the auto-index numbers, the header case,
+// a row's AutoMerge.
+func TestHegelTableRender(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s, ncols := genTableSpec(ht, cellOpts{noAngle: true}, true)
+		s.separateRows = chance(ht, 30)
+		if chance(ht, 30) {
+			s.title = pick(ht, []string{"Title", "A rather long title for a small table", "t"})
+		}
+		if chance(ht, 20) {
+			s.caption = "caption"
+		}
+		// coloured and wide cells; a column width limit on plain cells only
+		widthCfg := chance(ht, 30)
+		for i, r := range s.body {
+			for j := range r {
+				if str, ok := r[j].(string); ok && !widthCfg && chance(ht, 15) {
+					s.body[i][j] = text.Colors{text.FgRed, text.Bold}.Sprint(str)
+				}
+			}
+		}
+		if widthCfg {
+			for i, r := range s.body {
+				for j := range r {
+					if str, ok := r[j].(string); ok {
+						s.body[i][j] = strings.Map(func(r rune) rune {
+							if r > 127 {
+								return 'w'
+							}
+							return r
+						}, str)
+					}
+				}
+			}
+			s.configs = append(s.configs, table.ColumnConfig{Number: drawInt(ht, 1, ncols), WidthMax: drawInt(ht, 3, 8)})
+		}
+		if chance(ht, 25) && !(Known.widthMinCapped && widthCfg) {
+			s.sizeWidthMin = drawInt(ht, 5, 60)
+		}
+		if len(s.body) > 0 && chance(ht, 30) && !(Known.rowConfigPosition && len(s.filters) > 0) {
+			s.mergeRow = drawInt(ht, 0, len(s.body)-1)
+			tok := mergeToken
+			if !Known.mergePanic && chance(ht, 50) {
+				tok = strings.Repeat(mergeToken, drawInt(ht, 2, 9))
+			}
+			row := make([]any, ncols)
+			for j := range row {
+				row[j] = tok
+			}
+			s.body[s.mergeRow] = row
+		}
+		m := specModel(s)
+		if s.mergeRow >= 0 && (m.numCols < 2 || len(m.configs) > 0) {
+			s.mergeRow = -1 // a merge needs two visible columns; keep configs out of it
+			m = specModel(s)
+		}
+		if Known.footerOnlyBorder && len(m.header) == 0 && len(m.body) == 0 && len(m.footer) > 0 && !s.autoIndex {
+			s.header = [][]any{{"h"}} // a table of footer rows alone gets an empty top border
+			m = specModel(s)
+		}
+		if s.autoIndex && len(m.header) == 0 && Known.autoIndexHeaderWidth {
+			// the generated header row is not counted in the widths: no column may be narrower
+			for _, w := range modelRender(s, m).colWidths {
+				if w == 0 {
+					s.autoIndex = false
+					m = specModel(s)
+					break
+				}
+			}
+		}
+		tw := s.build()
+		out := tw.Render()
+		if m.numCols == 0 {
+			if out != "" {
+				c.failClass(ht, "empty", "Render() = %q for a table without columns", out)
+			}
+			return
+		}
+		rm := modelRender(s, m)
+		lines := strings.Split(out, "\n")
+		if len(lines) != rm.total {
+			c.failClass(ht, "lines", "Render() =\n%s\n%d lines, want %d (title %d, head %d, rows %v, footer %d)\nspec %v", out, len(lines), rm.total, rm.titleLines, rm.headLines, rm.rowLines, len(m.footer), s)
+			return
+		}
+		body := lines
+		if s.caption != "" {
+			body = lines[:len(lines)-1]
+		}
+		for i, l := range body {
+			if w := text.StringWidthWithoutEscSequences(l); w != rm.width {
+				c.failClass(ht, "width", "Render() =\n%s\nline %d %q has width %d, want %d\nspec %v", out, i, l, w, rm.width, s)
+				return
+			}
+		}
+		// the cells' text
+		for _, r := range m.header {
+			for ci, v := range r {
+				if mx := m.configs[ci].WidthMax; mx > 0 {
+					v = text.WrapText(v, mx)
+				}
+				for _, l := range strings.Split(strings.ToUpper(v), "\n") {
+					if l = strings.TrimSpace(l); !strings.Contains(out, l) {
+						c.failClass(ht, "header text", "Render() =\n%s\nlacks header cell line %q upper-cased", out, l)
+						return
+					}
+				}
+			}
+		}
+		for _, r := range m.body {
+			for ci, v := range r {
+				if mx := m.configs[ci].WidthMax; mx > 0 {
+					v = text.WrapText(v, mx)
+				}
+				for _, l := range strings.Split(v, "\n") {
+					if l = strings.TrimSpace(l); !strings.Contains(out, l) {
+						c.failClass(ht, "body text", "Render() =\n%s\nlacks body cell line %q", out, l)
+						return
+					}
+				}
+			}
+		}
+		// auto-index numbers on the first line of each body row
+		if s.autoIndex {
+			li := rm.bodyStart
+			w := len(strconv.Itoa(len(m.body)))
+			for i, n := range rm.rowLines {
+				want := "| " + text.AlignRight.Apply(strconv.Itoa(i+1), w) + " |"
+				if !strings.HasPrefix(lines[li], want) {
+					c.failClass(ht, "auto-index", "Render() =\n%s\nline %d %q does not start with %q", out, li, lines[li], want)
+					return
+				}
+				li += n
+				if s.separateRows {
+					li++
+				}
+			}
+		}
+		// the merged row shows its token once
+		if s.mergeRow >= 0 {
+			tok := s.body[s.mergeRow][0].(string)
+			pos := -1
+			for i, r := range m.body {
+				if len(r) > 0 && r[0] == tok {
+					pos = i
+				}
+			}
+			if pos >= 0 {
+				li := rm.bodyStart
+				for i := 0; i < pos; i++ {
+					li += rm.rowLines[i]
+					if s.separateRows {
+						li++
+					}
+				}
+				if n := strings.Count(lines[li], tok); n != 1 {
+					c.failClass(ht, "AutoMerge", "Render() =\n%s\nline %d %q shows %q %d times, want once (merged row)", out, li, lines[li], tok, n)
+					return
+				}
+			}
+		}
+		// Size.WidthMax: every line within it, at least as many lines
+		if wm := drawInt(ht, 0, rm.width+4); wm > 0 && (Known.widthMaxTiny && wm < 3 || s.title != "" && wm < 12 || Known.titleWidthMin && wm < s.sizeWidthMin) {
+			wm = 0
+		} else if wm > 0 {
+			tw.Style().Size.WidthMax = wm
+			out2 := tw.Render()
+			lines2 := strings.Split(out2, "\n")
+			if len(lines2) < len(lines) {
+				c.failClass(ht, "WidthMax lines", "Render() with WidthMax %d =\n%s\n%d lines, want at least %d", wm, out2, len(lines2), len(lines))
+				return
+			}
+			for i, l := range lines2 {
+				if s.caption != "" && i == len(lines2)-1 {
+					break
+				}
+				if w := text.StringWidthWithoutEscSequences(l); w > wm {
+					c.failClass(ht, "WidthMax width", "Render() with WidthMax %d =\n%s\nline %d %q has width %d", wm, out2, i, l, w)
+					return
+				}
+			}
+		}
+		c.count(fmt.Sprintf("cols=%d rows=%d", m.numCols, len(m.body)))
+	})
+}
