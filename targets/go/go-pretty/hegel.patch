+package hegel
+
+// Pins for the table package's bugs (25-45): each asserts the documented behaviour and fails
+// while the bug exists.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/jedib0t/go-pretty/v6/table"
+	"github.com/jedib0t/go-pretty/v6/text"
+)
+
+func lineWidths(s string) []int {
+	var ws []int
+	for _, l := range strings.Split(s, "\n") {
+		ws = append(ws, text.StringWidthWithoutEscSequences(l))
+	}
+	return ws
+}
+
+func TestHegelPinEmptyRowFields(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b"})
+	tw.AppendRow(table.Row{1, 2})
+	tw.AppendRow(table.Row{})
+	tw.AppendRow(table.Row{3, 4})
+	out := tw.RenderCSV()
+	recs, err := parseCSV(out, ',')
+	if err != nil || len(recs) != 4 {
+		t.Fatalf("RenderCSV() = %q: %d records (%v), want 4", out, len(recs), err)
+	}
+	for _, r := range recs {
+		if len(r) != 2 {
+			t.Fatalf("RenderCSV() = %q: record %q has %d fields, want 2", out, r, len(r))
+		}
+	}
+}
+
+func TestHegelPinEmptyRowDropped(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b"})
+	tw.AppendRow(table.Row{1, 2})
+	tw.AppendRow(table.Row{})
+	tw.AppendRow(table.Row{3, 4})
+	if out := tw.Render(); strings.Count(out, "\n") != 6 {
+		t.Fatalf("Render() =\n%s\n%d lines, want 7 (three body rows, as RenderMarkdown and RenderCSV render)", out, strings.Count(out, "\n")+1)
+	}
+}
+
+func TestHegelPinMarkdownPad(t *testing.T) {
+	tw := table.NewWriter()
+	tw.Style().Markdown.PadContent = true
+	tw.AppendHeader(table.Row{"col", "x"})
+	tw.AppendRow(table.Row{"a|b", 1})
+	tw.AppendRow(table.Row{"l1\nl2", 22})
+	tw.AppendRow(table.Row{"plain", 4})
+	out := tw.RenderMarkdown()
+	ws := lineWidths(out)
+	for _, w := range ws {
+		if w != ws[0] {
+			t.Fatalf("RenderMarkdown() with PadContent =\n%s\nline widths %v, want all equal", out, ws)
+		}
+	}
+}
+
+func TestHegelPinMarkdownBackslash(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendRow(table.Row{"a\\|b"})
+	out := tw.RenderMarkdown()
+	if cells := gfmCells(out); len(cells) != 1 || cells[0] != "a\\|b" {
+		t.Fatalf("RenderMarkdown() = %q: a GFM parser reads cells %q, want [%q]", out, cells, "a\\|b")
+	}
+}
+
+func TestHegelPinNumericSortNonNumeric(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"n"})
+	for _, v := range []string{"3", "x", "1", "2", "y", "0"} {
+		tw.AppendRow(table.Row{v})
+	}
+	tw.SortBy([]table.SortBy{{Number: 1, Mode: table.AscNumeric}})
+	out := tw.RenderCSV()
+	var nums []string
+	for _, l := range strings.Split(out, "\n")[1:] {
+		if l != "x" && l != "y" {
+			nums = append(nums, l)
+		}
+	}
+	if got := strings.Join(nums, " "); got != "0 1 2 3" {
+		t.Fatalf("RenderCSV() = %q: numeric cells in order %q, want %q", out, got, "0 1 2 3")
+	}
+}
+
+func TestHegelPinSortDuplicateKeys(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"n"})
+	for _, v := range []string{"a", "A", "b", "B"} {
+		tw.AppendRow(table.Row{v})
+	}
+	tw.SortBy([]table.SortBy{{Number: 1, Mode: table.Asc, IgnoreCase: true}})
+	one := tw.RenderCSV()
+	tw.SortBy([]table.SortBy{{Number: 1, Mode: table.Asc, IgnoreCase: true}, {Number: 1, Mode: table.Dsc}})
+	if two := tw.RenderCSV(); two != one {
+		t.Fatalf("with a duplicate instruction on the column RenderCSV() = %q, want %q (the duplicate discarded)", two, one)
+	}
+}
+
+func TestHegelPinSortByNameTransformed(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"num", "name"})
+	tw.AppendRow(table.Row{2, "b"})
+	tw.AppendRow(table.Row{1, "a"})
+	tw.SetColumnConfigs([]table.ColumnConfig{{Name: "num", TransformerHeader: func(v interface{}) string { return "Number" }}})
+	tw.SortBy([]table.SortBy{{Name: "num", Mode: table.AscNumeric}})
+	if out := tw.RenderCSV(); out != "Number,name\n1,a\n2,b" {
+		t.Fatalf("RenderCSV() sorted by the header name = %q, want %q", out, "Number,name\n1,a\n2,b")
+	}
+}
+
+func TestHegelPinFilterEqualNumeric(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"v"})
+	tw.AppendRow(table.Row{5})
+	tw.AppendRow(table.Row{"5.0"})
+	tw.AppendRow(table.Row{5.0})
+	tw.FilterBy([]table.FilterBy{{Number: 1, Operator: table.Equal, Value: "5.0"}})
+	if out := tw.RenderCSV(); strings.Count(out, "\n") != 3 {
+		t.Fatalf("RenderCSV() with Equal 5.0 = %q, want the rows 5, 5.0 and 5.0 kept (a numeric comparison)", out)
+	}
+}
+
+func TestHegelPinFilterShortRow(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b"})
+	tw.AppendRow(table.Row{1, "x"})
+	tw.AppendRow(table.Row{2})
+	tw.FilterBy([]table.FilterBy{{Number: 2, Operator: table.NotEqual, Value: "x"}})
+	if out := tw.RenderCSV(); out != "a,b\n2," {
+		t.Fatalf("RenderCSV() with NotEqual x on column 2 = %q, want %q (the row lacking the column kept)", out, "a,b\n2,")
+	}
+}
+
+func TestHegelPinLengthFiltered(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendRow(table.Row{1})
+	tw.AppendRow(table.Row{2})
+	tw.FilterBy([]table.FilterBy{{Number: 1, Operator: table.Equal, Value: 1}})
+	if got := tw.Length(); got != 1 {
+		t.Fatalf("Length() = %d with a filter keeping one row, want 1", got)
+	}
+}
+
+func TestHegelPinRowConfigFollowsRow(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b", "c"})
+	tw.AppendRow(table.Row{"z", "z", 3})
+	tw.AppendRow(table.Row{"m", "m", 1}, table.RowConfig{AutoMerge: true})
+	tw.AppendRow(table.Row{"q", "q", 2})
+	tw.SortBy([]table.SortBy{{Number: 3, Mode: table.AscNumeric}})
+	out := tw.Render()
+	for _, l := range strings.Split(out, "\n") {
+		if strings.Contains(l, "m") && strings.Count(l, "m") != 1 {
+			t.Fatalf("Render() sorted =\n%s\nthe row with AutoMerge is not merged", out)
+		}
+		if strings.Contains(l, "q") && strings.Count(l, "q") != 2 {
+			t.Fatalf("Render() sorted =\n%s\na row without AutoMerge is merged", out)
+		}
+	}
+}
+
+func TestHegelPinWidthMinCapped(t *testing.T) {
+	tw := table.NewWriter()
+	tw.SetTitle("title")
+	tw.AppendHeader(table.Row{"a"})
+	tw.AppendRow(table.Row{"xyz"})
+	tw.SetColumnConfigs([]table.ColumnConfig{{Number: 1, WidthMax: 3}})
+	tw.Style().Size.WidthMin = 20
+	out := tw.Render()
+	ws := lineWidths(out)
+	for _, w := range ws {
+		if w != ws[0] {
+			t.Fatalf("Render() =\n%s\nline widths %v, want all equal", out, ws)
+		}
+	}
+}
+
+func TestHegelPinWidthMaxTiny(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a"})
+	tw.AppendRow(table.Row{"xyz"})
+	full := tw.Render()
+	tw.Style().Size.WidthMax = 2
+	if out := tw.Render(); strings.Count(out, "\n") != strings.Count(full, "\n") {
+		t.Fatalf("Render() with WidthMax 2 = %q, want %d truncated lines", out, strings.Count(full, "\n")+1)
+	}
+}
+
+func TestHegelPinImportGridEmptyRow(t *testing.T) {
+	tg, ta := table.NewWriter(), table.NewWriter()
+	tg.ImportGrid([][]int{{1, 2}, {}, {3}})
+	ta.AppendRow(table.Row{1, 2})
+	ta.AppendRow(table.Row{})
+	ta.AppendRow(table.Row{3})
+	if got, want := tg.RenderCSV(), ta.RenderCSV(); got != want {
+		t.Fatalf("ImportGrid of a grid with an empty row renders %q, want %q", got, want)
