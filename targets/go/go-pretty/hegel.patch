+package hegel
+
+// Pins for the table package's bugs (25-45): each asserts the documented behaviour and fails
+// while the bug exists.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/jedib0t/go-pretty/v6/table"
+	"github.com/jedib0t/go-pretty/v6/text"
+)
+
+func lineWidths(s string) []int {
+	var ws []int
+	for _, l := range strings.Split(s, "\n") {
+		ws = append(ws, text.StringWidthWithoutEscSequences(l))
+	}
+	return ws
+}
+
+func TestHegelPinEmptyRowFields(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b"})
+	tw.AppendRow(table.Row{1, 2})
+	tw.AppendRow(table.Row{})
+	tw.AppendRow(table.Row{3, 4})
+	out := tw.RenderCSV()
+	recs, err := parseCSV(out, ',')
+	if err != nil || len(recs) != 4 {
+		t.Fatalf("RenderCSV() = %q: %d records (%v), want 4", out, len(recs), err)
+	}
+	for _, r := range recs {
+		if len(r) != 2 {
+			t.Fatalf("RenderCSV() = %q: record %q has %d fields, want 2", out, r, len(r))
+		}
+	}
+}
+
+func TestHegelPinEmptyRowDropped(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b"})
+	tw.AppendRow(table.Row{1, 2})
+	tw.AppendRow(table.Row{})
+	tw.AppendRow(table.Row{3, 4})
+	if out := tw.Render(); strings.Count(out, "\n") != 6 {
+		t.Fatalf("Render() =\n%s\n%d lines, want 7 (three body rows, as RenderMarkdown and RenderCSV render)", out, strings.Count(out, "\n")+1)
+	}
+}
+
+func TestHegelPinMarkdownPad(t *testing.T) {
+	tw := table.NewWriter()
+	tw.Style().Markdown.PadContent = true
+	tw.AppendHeader(table.Row{"col", "x"})
+	tw.AppendRow(table.Row{"a|b", 1})
+	tw.AppendRow(table.Row{"l1\nl2", 22})
+	tw.AppendRow(table.Row{"plain", 4})
+	out := tw.RenderMarkdown()
+	ws := lineWidths(out)
+	for _, w := range ws {
+		if w != ws[0] {
+			t.Fatalf("RenderMarkdown() with PadContent =\n%s\nline widths %v, want all equal", out, ws)
+		}
+	}
+}
+
+func TestHegelPinMarkdownBackslash(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendRow(table.Row{"a\\|b"})
+	out := tw.RenderMarkdown()
+	if cells := gfmCells(out); len(cells) != 1 || cells[0] != "a\\|b" {
+		t.Fatalf("RenderMarkdown() = %q: a GFM parser reads cells %q, want [%q]", out, cells, "a\\|b")
+	}
+}
+
+func TestHegelPinNumericSortNonNumeric(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"n"})
+	for _, v := range []string{"3", "x", "1", "2", "y", "0"} {
+		tw.AppendRow(table.Row{v})
+	}
+	tw.SortBy([]table.SortBy{{Number: 1, Mode: table.AscNumeric}})
+	out := tw.RenderCSV()
+	var nums []string
+	for _, l := range strings.Split(out, "\n")[1:] {
+		if l != "x" && l != "y" {
+			nums = append(nums, l)
+		}
+	}
+	if got := strings.Join(nums, " "); got != "0 1 2 3" {
+		t.Fatalf("RenderCSV() = %q: numeric cells in order %q, want %q", out, got, "0 1 2 3")
+	}
+}
+
+func TestHegelPinSortDuplicateKeys(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"n"})
+	for _, v := range []string{"a", "A", "b", "B"} {
+		tw.AppendRow(table.Row{v})
+	}
+	tw.SortBy([]table.SortBy{{Number: 1, Mode: table.Asc, IgnoreCase: true}})
+	one := tw.RenderCSV()
+	tw.SortBy([]table.SortBy{{Number: 1, Mode: table.Asc, IgnoreCase: true}, {Number: 1, Mode: table.Dsc}})
+	if two := tw.RenderCSV(); two != one {
+		t.Fatalf("with a duplicate instruction on the column RenderCSV() = %q, want %q (the duplicate discarded)", two, one)
+	}
+}
+
+func TestHegelPinSortByNameTransformed(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"num", "name"})
+	tw.AppendRow(table.Row{2, "b"})
+	tw.AppendRow(table.Row{1, "a"})
+	tw.SetColumnConfigs([]table.ColumnConfig{{Name: "num", TransformerHeader: func(v interface{}) string { return "Number" }}})
+	tw.SortBy([]table.SortBy{{Name: "num", Mode: table.AscNumeric}})
+	if out := tw.RenderCSV(); out != "Number,name\n1,a\n2,b" {
+		t.Fatalf("RenderCSV() sorted by the header name = %q, want %q", out, "Number,name\n1,a\n2,b")
+	}
+}
+
+func TestHegelPinFilterEqualNumeric(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"v"})
+	tw.AppendRow(table.Row{5})
+	tw.AppendRow(table.Row{"5.0"})
+	tw.AppendRow(table.Row{5.0})
+	tw.FilterBy([]table.FilterBy{{Number: 1, Operator: table.Equal, Value: "5.0"}})
+	if out := tw.RenderCSV(); strings.Count(out, "\n") != 3 {
+		t.Fatalf("RenderCSV() with Equal 5.0 = %q, want the rows 5, 5.0 and 5.0 kept (a numeric comparison)", out)
+	}
+}
+
+func TestHegelPinFilterShortRow(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b"})
+	tw.AppendRow(table.Row{1, "x"})
+	tw.AppendRow(table.Row{2})
+	tw.FilterBy([]table.FilterBy{{Number: 2, Operator: table.NotEqual, Value: "x"}})
+	if out := tw.RenderCSV(); out != "a,b\n2," {
+		t.Fatalf("RenderCSV() with NotEqual x on column 2 = %q, want %q (the row lacking the column kept)", out, "a,b\n2,")
+	}
+}
+
+func TestHegelPinLengthFiltered(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendRow(table.Row{1})
+	tw.AppendRow(table.Row{2})
+	tw.FilterBy([]table.FilterBy{{Number: 1, Operator: table.Equal, Value: 1}})
+	if got := tw.Length(); got != 1 {
+		t.Fatalf("Length() = %d with a filter keeping one row, want 1", got)
+	}
+}
+
+func TestHegelPinRowConfigFollowsRow(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b", "c"})
+	tw.AppendRow(table.Row{"z", "z", 3})
+	tw.AppendRow(table.Row{"m", "m", 1}, table.RowConfig{AutoMerge: true})
+	tw.AppendRow(table.Row{"q", "q", 2})
+	tw.SortBy([]table.SortBy{{Number: 3, Mode: table.AscNumeric}})
+	out := tw.Render()
+	for _, l := range strings.Split(out, "\n") {
+		if strings.Contains(l, "m") && strings.Count(l, "m") != 1 {
+			t.Fatalf("Render() sorted =\n%s\nthe row with AutoMerge is not merged", out)
+		}
+		if strings.Contains(l, "q") && strings.Count(l, "q") != 2 {
+			t.Fatalf("Render() sorted =\n%s\na row without AutoMerge is merged", out)
+		}
+	}
+}
+
+func TestHegelPinWidthMinCapped(t *testing.T) {
+	tw := table.NewWriter()
+	tw.SetTitle("title")
+	tw.AppendHeader(table.Row{"a"})
+	tw.AppendRow(table.Row{"xyz"})
+	tw.SetColumnConfigs([]table.ColumnConfig{{Number: 1, WidthMax: 3}})
+	tw.Style().Size.WidthMin = 20
+	out := tw.Render()
+	ws := lineWidths(out)
+	for _, w := range ws {
+		if w != ws[0] {
+			t.Fatalf("Render() =\n%s\nline widths %v, want all equal", out, ws)
+		}
+	}
+}
+
+func TestHegelPinWidthMaxTiny(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a"})
+	tw.AppendRow(table.Row{"xyz"})
+	full := tw.Render()
+	tw.Style().Size.WidthMax = 2
+	if out := tw.Render(); strings.Count(out, "\n") != strings.Count(full, "\n") {
+		t.Fatalf("Render() with WidthMax 2 = %q, want %d truncated lines", out, strings.Count(full, "\n")+1)
+	}
+}
+
+func TestHegelPinImportGridEmptyRow(t *testing.T) {
+	tg, ta := table.NewWriter(), table.NewWriter()
+	tg.ImportGrid([][]int{{1, 2}, {}, {3}})
+	ta.AppendRow(table.Row{1, 2})
+	ta.AppendRow(table.Row{})
+	ta.AppendRow(table.Row{3})
+	if got, want := tg.RenderCSV(), ta.RenderCSV(); got != want {
+		t.Fatalf("ImportGrid of a grid with an empty row renders %q, want %q", got, want)
+	}
+}
+
+func TestHegelPinPagerStale(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a"})
+	for i := 1; i <= 5; i++ {
+		tw.AppendRow(table.Row{i})
+	}
+	p := tw.Pager(table.PageSize(2))
+	p.GoTo(3)
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Pager(PageSize(3)) after a pager at page 3: %v", r)
+		}
+	}()
+	p2 := tw.Pager(table.PageSize(3))
+	if p2.Location() != 1 {
+		t.Fatalf("Pager(PageSize(3)).Location() = %d, want 1", p2.Location())
+	}
+	p2.Render()
+}
+
+func TestHegelPinSuppressFirstCell(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"a", "b"})
+	tw.AppendRow(table.Row{1, "\n"})
+	tw.AppendRow(table.Row{2, "content"})
+	tw.SuppressEmptyColumns()
+	if out := tw.Render(); !strings.Contains(out, "content") {
+		t.Fatalf("Render() with SuppressEmptyColumns =\n%s\nhides column b, which has content", out)
+	}
+}
+
+func TestHegelPinTitleWidthMax(t *testing.T) {
+	tw := table.NewWriter()
+	tw.SetTitle("Title")
+	tw.AppendHeader(table.Row{"a"})
+	tw.AppendRow(table.Row{"xyz"})
+	tw.Style().Size.WidthMin = 30
+	tw.Style().Size.WidthMax = 12
+	out := tw.Render()
+	for i, w := range lineWidths(out) {
+		if w > 12 {
+			t.Fatalf("Render() with WidthMax 12 =\n%s\nline %d has width %d", out, i, w)
+		}
+	}
+}
+
+func TestHegelPinMergePanic(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Render() with a merged cell wider than its columns: %v", r)
+		}
+	}()
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"abc", "def"})
+	tw.AppendRow(table.Row{"12345678", "12345678"}, table.RowConfig{AutoMerge: true})
+	if out := tw.Render(); !strings.Contains(out, "12345678") {
+		t.Fatalf("Render() =\n%s\nlacks the merged cell", out)
+	}
+}
+
+func TestHegelPinAutoIndexHeaderWidth(t *testing.T) {
+	tw := table.NewWriter()
+	tw.SetAutoIndex(true)
+	tw.AppendRow(table.Row{"x", ""})
+	out := tw.Render()
+	ws := lineWidths(out)
+	for _, w := range ws {
+		if w != ws[0] {
+			t.Fatalf("Render() with auto-index =\n%s\nline widths %v, want all equal", out, ws)
+		}
+	}
+}
+
+func TestHegelPinFooterOnlyBorder(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendFooter(table.Row{"total", 10})
+	out := tw.Render()
+	ws := lineWidths(out)
+	if ws[0] != ws[len(ws)-1] {
+		t.Fatalf("Render() of a footer-only table =\n%s\ntop border width %d, bottom %d", out, ws[0], ws[len(ws)-1])
+	}
+}
+
+func TestHegelPinCSVLoneEmptyField(t *testing.T) {
+	tw := table.NewWriter()
+	tw.AppendRow(table.Row{"x"})
+	tw.AppendRow(table.Row{""})
+	out := tw.RenderCSV()
+	if recs, err := parseCSV(out, ','); err != nil || len(recs) != 2 {
+		t.Fatalf("RenderCSV() = %q: %d records read back (%v), want 2", out, len(recs), err)
+	}
+}
diff --git a/hegel/hegel_table_test.go b/hegel/hegel_table_test.go
new file mode 100644
index 0000000..e0966d2
--- /dev/null
+++ b/hegel/hegel_table_test.go
@@ -0,0 +1,753 @@
+package hegel
+
+// The table package: CSV/TSV records, Markdown, HTML, the boxed rendering, the pager.
+
+import (
+	"encoding/csv"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/jedib0t/go-pretty/v6/table"
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+func parseCSV(s string, comma rune) ([][]string, error) {
+	r := csv.NewReader(strings.NewReader(s))
+	r.Comma = comma
+	r.FieldsPerRecord = -1
+	recs, err := r.ReadAll()
+	if len(recs) == 0 {
+		recs = nil
+	}
+	return recs, err
+}
+
+// genTableSpec: a table of 1-4 columns with header, body and footer rows.
+func genTableSpec(tc hegel.TestCase, o cellOpts, allowEmpty bool) (*tableSpec, int) {
+	ncols := drawInt(tc, 1, 4)
+	s := &tableSpec{mergeRow: -1}
+	s.header = genRows(tc, drawInt(tc, 0, 2), ncols, cellOpts{plain: true}, false)
+	s.body = genRows(tc, drawInt(tc, 0, 6), ncols, o, allowEmpty)
+	s.footer = genRows(tc, drawInt(tc, 0, 1), ncols, o, allowEmpty)
+	s.autoIndex = chance(tc, 30)
+	if chance(tc, 40) {
+		s.configs = genConfigs(tc, s, ncols)
+	}
+	s.suppressEmpty = chance(tc, 25)
+	if chance(tc, 40) {
+		s.filters = genFilters(tc, s, ncols)
+	}
+	return s, ncols
+}
+
+// rowsEmptyAfterHide: whether some row loses all its cells to hidden columns.
+func rowsEmptyAfterHide(m *tableModel) bool {
+	for _, rs := range [][][]string{m.header, m.body, m.footer} {
+		for _, r := range rs {
+			if len(r) == 0 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// specModel: the model of a spec; while empty rows are mis-rendered, hidden and suppressed
+// columns are kept from emptying a row.
+func specModel(s *tableSpec) *tableModel {
+	m := modelTable(s, nil)
+	if Known.emptyRow && rowsEmptyAfterHide(m) {
+		s.configs, s.suppressEmpty = nil, false
+		m = modelTable(s, nil)
+	}
+	return m
+}
+
+// TestHegelTableCSV: RenderCSV and RenderTSV records against the row model, with filters,
+// sorting, hidden and suppressed columns, transformers, auto-index and field protection;
+// Length(); ImportGrid.
+func TestHegelTableCSV(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s, ncols := genTableSpec(ht, cellOpts{}, true)
+		s.fieldProtection = chance(ht, 30)
+		if chance(ht, 50) {
+			s.sorts = genSorts(ht, s, ncols)
+		}
+		if Known.suppressFirstCell && len(s.sorts) > 0 {
+			s.suppressEmpty = false // the suppression depends on the sorted order
+		}
+		m := specModel(s)
+		keys := resolveSorts(s, m)
+		if Known.numericSortAbandoned {
+			// a numeric sort with a non-numeric cell, or any sort meeting NaN, abandons the
+			// order: keep such keys off
+			for _, k := range keys {
+				for _, r := range m.bodyFull {
+					f, err := strconv.ParseFloat(m.cell(r, k.Number-1), 64)
+					numericMode := k.Mode != table.Asc && k.Mode != table.Dsc
+					if numericMode && (err == nil && math.IsNaN(f) || err != nil && (k.Mode == table.AscNumeric || k.Mode == table.DscNumeric)) {
+						s.sorts = nil
+						keys = nil
+						break
+					}
+				}
+			}
+		}
+		tw := s.build()
+		wantLen := len(m.body)
+		if Known.lengthStale {
+			wantLen = len(s.body)
+		}
+		if got := tw.Length(); got != wantLen {
+			c.failClass(ht, "Length", "Length() = %d before rendering, want %d (filters %d)", got, wantLen, len(s.filters))
+			return
+		}
+		out := tw.RenderCSV()
+		recs, err := parseCSV(out, ',')
+		if err != nil {
+			c.failClass(ht, "CSV parse", "RenderCSV() = %q: %v", out, err)
+			return
+		}
+		want := m.csvRecords(s, s.fieldProtection)
+		nHead := len(want) - len(m.body) - len(m.footer)
+		if len(recs) != len(want) {
+			c.failClass(ht, "CSV records", "RenderCSV() = %q: %d records, want %d", out, len(recs), len(want))
+			return
+		}
+		if !reflect.DeepEqual(recs[:nHead], want[:nHead]) || !reflect.DeepEqual(recs[nHead+len(m.body):], want[nHead+len(m.body):]) {
+			c.failClass(ht, "CSV header/footer", "RenderCSV() = %q\nrecords %q\nwant %q", out, recs, want)
+			return
+		}
+		gotBody := recs[nHead : nHead+len(m.body)]
+		wantBody := want[nHead : nHead+len(m.body)]
+		var order []int
+		if len(keys) == 0 {
+			if !reflect.DeepEqual(gotBody, wantBody) {
+				c.failClass(ht, "CSV body", "RenderCSV() = %q\nbody %q\nwant %q", out, gotBody, wantBody)
+				return
+			}
+			order = make([]int, len(m.body))
+			for i := range order {
+				order[i] = i
+			}
+		} else {
+			// a permutation of the rows, in an order the keys allow
+			order = matchRows(gotBody, wantBody, s.autoIndex)
+			if order == nil {
+				c.failClass(ht, "CSV sorted body", "RenderCSV() = %q\nbody %q is not a permutation of %q", out, gotBody, wantBody)
+				return
+			}
+			for i := 1; i < len(order); i++ {
+				if rowsCmp(m.bodyFull[order[i-1]], m.bodyFull[order[i]], keys) > 0 {
+					c.failClass(ht, "CSV sort order", "RenderCSV() = %q\nrows %q and %q are out of order under %+v", out, m.bodyFull[order[i-1]], m.bodyFull[order[i]], keys)
+					return
+				}
+			}
+			if k := keys[0]; k.Mode == table.AscNumeric || k.Mode == table.DscNumeric {
+				// the numeric cells of the first key appear in order
+				var prev *float64
+				for _, o := range order {
+					f, err := strconv.ParseFloat(m.cell(m.bodyFull[o], k.Number-1), 64)
+					if err != nil {
+						continue
+					}
+					if prev != nil && (k.Mode == table.AscNumeric && f < *prev || k.Mode == table.DscNumeric && f > *prev) {
+						c.failClass(ht, "CSV numeric order", "RenderCSV() = %q: numeric cells %v then %v out of order under %+v", out, *prev, f, k)
+						return
+					}
+					prev = &f
+				}
+			}
+		}
+		if got := tw.Length(); got != len(m.body) {
+			c.failClass(ht, "Length after", "Length() = %d after rendering, want %d", got, len(m.body))
+			return
+		}
+		// TSV: the same records
+		outT := tw.RenderTSV()
+		recsT, err := parseCSV(outT, '\t')
+		if err != nil {
+			c.failClass(ht, "TSV parse", "RenderTSV() = %q: %v", outT, err)
+			return
+		}
+		wantT := m.csvRecords(s, false)
+		if len(recsT) != len(wantT) {
+			c.failClass(ht, "TSV records", "RenderTSV() = %q: %d records, want %d", outT, len(recsT), len(wantT))
+			return
+		}
+		for i, rec := range recsT {
+			want := wantT[i]
+			if i >= nHead && i < nHead+len(m.body) {
+				want = append([]string{}, wantT[nHead+order[i-nHead]]...)
+				if s.autoIndex {
+					want[0] = strconv.Itoa(i - nHead + 1)
+				}
+			}
+			if !reflect.DeepEqual(rec, want) {
+				c.failClass(ht, "TSV body", "RenderTSV() = %q\nrecord %d = %q, want %q", outT, i, rec, want)
+				return
+			}
+		}
+		// ImportGrid: rows as appended
+		if chance(ht, 30) {
+			grid := make([][]any, drawInt(ht, 0, 4))
+			for i := range grid {
+				lo := 1
+				if !Known.importGridEmptyRow {
+					lo = 0
+				}
+				grid[i] = make([]any, drawInt(ht, lo, 3))
+				for j := range grid[i] {
+					grid[i][j] = genCell(ht, cellOpts{})
+				}
+			}
+			tg, ta := table.NewWriter(), table.NewWriter()
+			added := tg.ImportGrid(grid)
+			for _, r := range grid {
+				ta.AppendRow(table.Row(r))
+			}
+			if added != (len(grid) > 0) || tg.RenderCSV() != ta.RenderCSV() || tg.Length() != len(grid) {
+				c.failClass(ht, "ImportGrid", "ImportGrid(%v) = %v, RenderCSV() = %q, want %q (Length %d, want %d)", grid, added, tg.RenderCSV(), ta.RenderCSV(), tg.Length(), len(grid))
+				return
+			}
+		}
+		c.count(fmt.Sprintf("cols=%d sort=%v filter=%v", m.numCols, len(keys) > 0, len(s.filters) > 0))
+	})
+}
+
+// matchRows: for each output record the index of a matching expected record (auto-index
+// numbers excepted), or nil when the records are not a permutation.
+func matchRows(got, want [][]string, autoIndex bool) []int {
+	used := make([]bool, len(want))
+	order := make([]int, len(got))
+	strip := func(r []string) []string {
+		if autoIndex && len(r) > 0 {
+			return r[1:]
+		}
+		return r
+	}
+	for i, g := range got {
+		if autoIndex && (len(g) == 0 || g[0] != strconv.Itoa(i+1)) {
+			return nil
+		}
+		found := -1
+		for j, w := range want {
+			if !used[j] && reflect.DeepEqual(strip(g), strip(w)) {
+				found = j
+				break
+			}
+		}
+		if found < 0 {
+			return nil
+		}
+		used[found] = true
+		order[i] = found
+	}
+	return order
+}
