index 0000000..49efd4e
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,313 @@
+package hegel
+
+// Pins: the documented behaviour behind each recorded bug. They fail while the bug exists and
+// are listed as expected failures in target.toml.
+
+import (
+	"math"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+)
+
+// go-pretty/1: a CSI sequence ends at its final byte, so cursor and erase sequences (the
+// package's own Cursor type) are invisible and take no width.
+func TestHegelPinCursorSequences(t *testing.T) {
+	if got := text.StripEscape(esc + "[2Khello"); got != "hello" {
+		t.Errorf("StripEscape(ESC[2K hello) = %q, want hello", got)
+	}
+	if got := text.StringWidthWithoutEscSequences(text.CursorUp.Sprintn(3) + "abc"); got != 3 {
+		t.Errorf("StringWidthWithoutEscSequences(CursorUp.Sprintn(3) + abc) = %d, want 3", got)
+	}
+	if got := text.LongestLineLen(text.EraseLine.Sprint() + "abc\ndef"); got != 3 {
+		t.Errorf("LongestLineLen(EraseLine + abc, def) = %d, want 3", got)
+	}
+}
+
+// go-pretty/2: an OSC sequence ends at BEL whatever its command.
+func TestHegelPinOSCBell(t *testing.T) {
+	if got := text.StripEscape(esc + "]0;title\x07text"); got != "text" {
+		t.Errorf("StripEscape(ESC]0;title BEL text) = %q, want text", got)
+	}
+	if got := text.StringWidthWithoutEscSequences(esc + "]0;title\x07text"); got != 4 {
+		t.Errorf("StringWidthWithoutEscSequences(ESC]0;title BEL text) = %d, want 4", got)
+	}
+}
+
+// go-pretty/3: Format.Apply leaves escape sequences intact, a hyperlink's URL included.
+func TestHegelPinFormatHyperlink(t *testing.T) {
+	url := "https://Example.com/Path"
+	if got, want := text.FormatUpper.Apply(text.Hyperlink(url, "some text")), text.Hyperlink(url, "SOME TEXT"); got != want {
+		t.Errorf("FormatUpper.Apply(hyperlink) = %q, want %q", got, want)
+	}
+	if got, want := text.FormatLower.Apply(text.Hyperlink(url, "Some Text")), text.Hyperlink(url, "some text"); got != want {
+		t.Errorf("FormatLower.Apply(hyperlink) = %q, want %q", got, want)
+	}
+	if got, want := text.FormatTitle.Apply(text.Hyperlink(url, "some text")), text.Hyperlink(url, "Some Text"); got != want {
+		t.Errorf("FormatTitle.Apply(hyperlink) = %q, want %q", got, want)
+	}
+}
+
+// go-pretty/4: Escape with an empty sequence returns the string as it is.
+func TestHegelPinEscapeEmpty(t *testing.T) {
+	for _, s := range []string{esc + "[94mGhost" + esc + "[0mLady", "a" + esc + "[0mb", "Ghost"} {
+		if got := text.Escape(s, ""); got != s {
+			t.Errorf("Escape(%q, \"\") = %q, want the input", s, got)
+		}
+	}
+}
+
+func statesOf(s string) map[rune]sgr {
+	m := map[rune]sgr{}
+	for _, rs := range visibleStates(s) {
+		m[rs.r] = rs.st
+	}
+	return m
+}
+
+// go-pretty/5: text after a reset stays plain on the following wrapped lines.
+func TestHegelPinWrapReset(t *testing.T) {
+	for _, f := range []func(string, int) string{text.WrapHard, text.WrapSoft, text.WrapText} {
+		out := f(esc+"[1mbold "+esc+"[0mplain plain plain", 6)
+		for _, rs := range visibleStates(out) {
+			if rs.r == 'p' && rs.st != (sgr{}) {
+				t.Errorf("wrapped %q: 'p' in state %s, want plain", out, rs.st)
+				break
+			}
+		}
+	}
+}
+
+// go-pretty/6: a word broken across lines keeps every attribute in force, not only the last
+// sequence found in the word.
+func TestHegelPinWrapWordState(t *testing.T) {
+	var want sgr
+	want.apply(esc + "[1m")
+	want.apply(esc + "[31m")
+	for _, f := range []func(string, int) string{text.WrapHard, text.WrapSoft, text.WrapText} {
+		out := f(esc+"[1mBold "+esc+"[31mBoldRedLongWord", 6)
+		for _, rs := range visibleStates(out) {
+			if (rs.r == 'W' || rs.r == 'g') && rs.st != want {
+				t.Errorf("wrapped %q: %q in state %s, want %s", out, rs.r, rs.st, want)
+				break
+			}
+		}
+	}
+}
+
+// go-pretty/7: wrapping text with a hyperlink does not conceal the following lines.
+func TestHegelPinWrapHyperlinkConceal(t *testing.T) {
+	out := text.WrapHard(text.Hyperlink("http://x.y/", "label")+" more text here", 6)
+	for _, rs := range visibleStates(out) {
+		if rs.st != (sgr{}) {
+			t.Errorf("WrapHard(hyperlink + text, 6) = %q: %q in state %s, want plain", out, rs.r, rs.st)
+			break
+		}
+	}
+}
+
+// go-pretty/8: a hyperlink word is wrapped like any other: no line exceeds the width.
+func TestHegelPinWrapHyperlinkWidth(t *testing.T) {
+	out := text.WrapHard(text.Hyperlink("http://x.y/mm", "label")+" more", 4)
+	for _, line := range strings.Split(out, "\n") {
+		if w := widthOf(line); w > 4 {
+			t.Errorf("WrapHard(hyperlink + more, 4) = %q: line %q has width %d", out, line, w)
+		}
+	}
+}
+
+// go-pretty/9: a 24-bit colour (38;2;r;g;b) is one colour, not five attributes.
+func TestHegelPinTruecolor(t *testing.T) {
+	esp := text.EscSeqParser{}
+	esp.ParseString(esc + "[38;2;10;20;30mx")
+	if got, want := stateAfter(esp.Sequence()), stateAfter(esc+"[38;2;10;20;30m"); got != want {
+		t.Errorf("Sequence() after 38;2;10;20;30 = %q (state %s), want state %s", esp.Sequence(), got, want)
+	}
+	for _, c := range esp.Codes() {
+		if c == 2 || c == 10 || c == 20 || c == 30 {
+			t.Errorf("Codes() after 38;2;10;20;30 = %v holds the colour components as codes", esp.Codes())
+			break
+		}
+	}
+}
+
+// go-pretty/10: the last colour set is the colour restored.
+func TestHegelPinColorOrder(t *testing.T) {
+	for _, tc := range []struct{ seqs, want string }{
+		{esc + "[91m" + esc + "[31m", esc + "[31m"},
+		{esc + "[32m" + esc + "[31m", esc + "[31m"},
+		{esc + "[38;5;100m" + esc + "[33m", esc + "[33m"},
+		{esc + "[104m" + esc + "[44m", esc + "[44m"},
+	} {
+		esp := text.EscSeqParser{}
+		esp.ParseString(tc.seqs)
+		if got, want := stateAfter(esp.Sequence()), stateAfter(tc.want); got != want {
+			t.Errorf("Sequence() after %q = %q (state %s), want state %s", tc.seqs, esp.Sequence(), got, want)
+		}
+	}
+}
+
+// go-pretty/11: code 28 turns conceal off.
+func TestHegelPinConcealOff(t *testing.T) {
+	esp := text.EscSeqParser{}
+	esp.ParseString(esc + "[8mhidden" + esc + "[28mshown")
+	if esp.IsOpen() || esp.Sequence() != "" {
+		t.Errorf("after 8 then 28: IsOpen %v, Sequence %q, want closed", esp.IsOpen(), esp.Sequence())
+	}
+}
+
+// go-pretty/12: a negative number is formatted by the format, sign included.
+func TestHegelPinNumberFormat(t *testing.T) {
+	text.EnableColors()
+	red := text.Colors{text.FgHiRed}
+	if got, want := text.NewNumberTransformer("%5d")(-42), red.Sprint("  -42"); got != want {
+		t.Errorf("NewNumberTransformer(%%5d)(-42) = %q, want %q", got, want)
+	}
+	if got, want := text.NewNumberTransformer("%d")(int64(math.MinInt64)), red.Sprint("-9223372036854775808"); got != want {
+		t.Errorf("NewNumberTransformer(%%d)(MinInt64) = %q, want %q", got, want)
+	}
+	if got, want := text.NewNumberTransformer("%+d")(-4), red.Sprint("-4"); got != want {
+		t.Errorf("NewNumberTransformer(%%+d)(-4) = %q, want %q", got, want)
+	}
+}
+
+// go-pretty/13: a time at or before the Unix epoch is formatted like any other.
+func TestHegelPinTimeEpoch(t *testing.T) {
+	tt := text.NewTimeTransformer(time.RFC3339, time.UTC)
+	if got := tt(time.Date(1960, 1, 1, 0, 0, 0, 0, time.UTC)); got != "1960-01-01T00:00:00Z" {
+		t.Errorf("NewTimeTransformer(1960-01-01) = %q", got)
+	}
+	if got := tt(time.Unix(0, 0)); got != "1970-01-01T00:00:00Z" {
+		t.Errorf("NewTimeTransformer(epoch) = %q", got)
+	}
+}
+
+// go-pretty/14: an int unix time is formatted like an int64 one.
+func TestHegelPinUnixTimeInt(t *testing.T) {
+	ut := text.NewUnixTimeTransformer(time.RFC3339, time.UTC)
+	want := ut(int64(1700000000))
+	if got := ut(int(1700000000)); got != want {
+		t.Errorf("NewUnixTimeTransformer(int 1700000000) = %q, want %q", got, want)
+	}
+	if got := ut(uint32(1700000000)); got != want {
+		t.Errorf("NewUnixTimeTransformer(uint32 1700000000) = %q, want %q", got, want)
+	}
+}
+
+// go-pretty/15: AlignAuto judges the text, not its escape sequences.
+func TestHegelPinAutoAlignColored(t *testing.T) {
+	got := text.AlignAuto.Apply(esc+"[31m12"+esc+"[0m", 6)
+	if visible(got) != "    12" {
+		t.Errorf("AlignAuto.Apply(coloured 12, 6) = %q (visible %q), want right-aligned", got, visible(got))
+	}
+}
+
+// go-pretty/16: FormatTitle title-cases (a digraph's titlecase form).
+func TestHegelPinTitleCase(t *testing.T) {
+	if got := text.FormatTitle.Apply("ǆa ǉa"); got != "ǅa ǈa" {
+		t.Errorf("FormatTitle.Apply(ǆa ǉa) = %q, want ǅa ǈa", got)
+	}
+}
+
+// go-pretty/17: RepeatAndTrim gives maxRunes runes of the repeated string.
+func TestHegelPinRepeatAndTrim(t *testing.T) {
+	if got := text.RepeatAndTrim("生", 3); got != "生生生" {
+		t.Errorf("RepeatAndTrim(生, 3) = %q, want 3 runes", got)
+	}
+	if got := text.RepeatAndTrim(esc+"[31ma"+esc+"[0m", 3); visible(got) != "aaa" {
+		t.Errorf("RepeatAndTrim(coloured a, 3) = %q, want 3 visible runes", got)
+	}
+}
+
+// go-pretty/18: Snip returns the fixed length its documentation describes.
+func TestHegelPinSnip(t *testing.T) {
+	if got := text.Snip("Ghost", 7, "~"); got != "Ghost  " {
+		t.Errorf("Snip(Ghost, 7, ~) = %q, want %q (the documented example)", got, "Ghost  ")
+	}
+	if got := text.Snip("Ghost", 2, "..."); widthOf(got) > 2 {
+		t.Errorf("Snip(Ghost, 2, ...) = %q has width %d, want at most 2", got, widthOf(got))
+	}
+}
+
+// go-pretty/19: after a carriage return, escape sequences take no columns when overwriting.
+func TestHegelPinCRLFEscape(t *testing.T) {
+	if got, want := text.ProcessCRLF("abc\r"+esc+"[31mX"), esc+"[31mXbc"; got != want {
+		t.Errorf("ProcessCRLF(abc CR ESC[31m X) = %q, want %q", got, want)
+	}
+}
+
+// go-pretty/20: the escape state carries over a paragraph break (WrapHard, WrapSoft) and a
+// line break (WrapText).
+func TestHegelPinWrapParagraphState(t *testing.T) {
+	var bold sgr
+	bold.apply(esc + "[1m")
+	check := func(name, out string) {
+		for _, rs := range visibleStates(out) {
+			if rs.r == 'x' && rs.st != bold {
+				t.Errorf("%s = %q: 'x' in state %s, want %s", name, out, rs.st, bold)
+				return
+			}
+		}
+	}
+	check("WrapHard(bold text, paragraph, next xx)", text.WrapHard(esc+"[1mbold text\n\nnext xx", 6))
+	check("WrapSoft(bold text, paragraph, next xx)", text.WrapSoft(esc+"[1mbold text\n\nnext xx", 6))
+	check("WrapText(bold text, line, next xx)", text.WrapText(esc+"[1mbold text\nnext xx", 6))
+}
+
+// go-pretty/21: no wrapped line is wider than the width when a wide rune would straddle it.
+func TestHegelPinWrapWideRune(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		fn   func(string, int) string
+		s    string
+		n    int
+	}{
+		{"WrapHard", text.WrapHard, "eas命 x", 4},
+		{"WrapSoft", text.WrapSoft, "t sidツ😀", 4},
+		{"WrapText", text.WrapText, "abc世 x", 4},
+	} {
+		out := tc.fn(tc.s, tc.n)
+		for _, line := range strings.Split(out, "\n") {
+			if w := widthOf(line); w > tc.n {
+				t.Errorf("%s(%q, %d) = %q: line %q has width %d", tc.name, tc.s, tc.n, out, line, w)
+			}
+		}
+	}
+}
+
+// go-pretty/22: AlignJustify.Apply does not panic on a blank text and a negative length.
+func TestHegelPinJustifyNegative(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Errorf("AlignJustify.Apply(\"  \", -1) panicked: %v", r)
+		}
+	}()
+	if got := text.AlignJustify.Apply("  ", -1); got != "" {
+		t.Errorf("AlignJustify.Apply(\"  \", -1) = %q, want \"\"", got)
+	}
+}
+
+// go-pretty/23: the codes of one sequence apply in order: a reset before a 256 colour leaves
+// the colour set, a 49 before a 256 background leaves the background set.
+func TestHegelPinCodeOrder(t *testing.T) {
+	for _, seq := range []string{esc + "[0;38;5;31m", esc + "[49;48;5;130m", esc + "[0;1;48;5;20m"} {
+		esp := text.EscSeqParser{}
+		esp.ParseString(seq + "x")
+		if got, want := stateAfter(esp.Sequence()), stateAfter(seq); got != want {
+			t.Errorf("Sequence() after %q = %q (state %s), want state %s", seq, esp.Sequence(), got, want)
+		}
+	}
+}
+
+// go-pretty/24: Escape terminates its output even when the input holds the sequence itself.
+func TestHegelPinEscapePair(t *testing.T) {
+	red := esc + "[31m"
+	for _, s := range []string{"a" + red + esc + "[0mb", "ab" + red, "a" + red + "b" + esc + "[0m"} {
+		got := text.Escape(s, red)
+		if visible(got) != visible(s) || stateAfter(got) != (sgr{}) {
+			t.Errorf("Escape(%q, red) = %q: visible %q, ends in state %s", s, got, visible(got), stateAfter(got))
+		}
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..fe83f5f
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,654 @@
+package hegel
+
+// Properties of the string utilities: widths, StripEscape, Trim/Snip/Pad/RepeatAndTrim, Widen,
+// InsertEveryN, ProcessCRLF, Align, VAlign, Format, Escape and the escape sequence parser.
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"golang.org/x/text/width"
+	"hegel.dev/go/hegel"
+	"testing"
+)
+
+// --------------------------------------------------------------------------- widths and trims
+
+// modelTrim: the visible runes that fit in maxLen columns, every escape sequence kept.
+func modelTrim(s string, maxLen int) string {
+	if maxLen <= 0 {
+		return ""
+	}
+	var b strings.Builder
+	w, full := 0, false
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if full {
+			continue
+		}
+		rw := text.RuneWidth(t.r)
+		if w+rw <= maxLen {
+			w += rw
+			b.WriteRune(t.r)
+		} else {
+			full = true
+		}
+	}
+	return b.String()
+}
+
+// modelSnip: the documented "fixed length": trimmed to length minus the indicator when wider,
+// otherwise (the doc's example) padded to the length. Under Known.snipNoPad the package's
+// formula: no padding, and the indicator appended whatever its width.
+func modelSnip(s string, length int, ind string) string {
+	if length <= 0 {
+		return s
+	}
+	ws := widthOf(s)
+	if Known.snipNoPad {
+		if ws > length {
+			return modelTrim(s, length-widthOf(ind)) + ind
+		}
+		return s
+	}
+	if ws > length {
+		if widthOf(ind) >= length {
+			return modelTrim(ind, length)
+		}
+		return modelTrim(s, length-widthOf(ind)) + ind
+	}
+	return s + strings.Repeat(" ", length-ws)
+}
+
+// modelRepeatAndTrim: the documented result has maxRunes runes; under Known.repeatTrimWidth the
+// package's formula (repeat by rune count, trim by display width).
+func modelRepeatAndTrim(s string, maxRunes int) string {
+	if s == "" || maxRunes <= 0 {
+		return ""
+	}
+	rc := utf8.RuneCountInString(s)
+	if Known.repeatTrimWidth {
+		if maxRunes == rc {
+			return s
+		}
+		return modelTrim(strings.Repeat(s, maxRunes/rc+1), maxRunes)
+	}
+	rep := strings.Repeat(s, maxRunes/rc+1)
+	var b strings.Builder
+	n := 0
+	for _, t := range scan(rep) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if n == maxRunes {
+			break
+		}
+		b.WriteRune(t.r)
+		n++
+	}
+	return b.String()
+}
+
+func TestHegelWidth(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := genText(ht, textOpts{newlines: true, tabs: true, sequences: true, other: true, spaces: true})
+		vis := visible(s)
+		if got := text.StripEscape(s); got != vis {
+			c.failClass(ht, "StripEscape", "StripEscape(%q) = %q, want %q", s, got, vis)
+			return
+		}
+		w := widthOfPlain(vis)
+		if got := text.StringWidthWithoutEscSequences(s); got != w {
+			c.failClass(ht, "StringWidth", "StringWidthWithoutEscSequences(%q) = %d, want %d", s, got, w)
+			return
+		}
+		if got := text.RuneCount(s); got != w {
+			c.failClass(ht, "RuneCount", "RuneCount(%q) = %d, want %d", s, got, w)
+			return
+		}
+		longest := 0
+		for _, line := range strings.Split(vis, "\n") {
+			if lw := widthOfPlain(line); lw > longest {
+				longest = lw
+			}
+		}
+		if got := text.LongestLineLen(s); got != longest {
+			c.failClass(ht, "LongestLineLen", "LongestLineLen(%q) = %d, want %d", s, got, longest)
+			return
+		}
+		n := drawInt(ht, -1, 12)
+		if got, want := text.Trim(s, n), modelTrim(s, n); got != want {
+			c.failClass(ht, "Trim", "Trim(%q, %d) = %q, want %q", s, n, got, want)
+			return
+		}
+		pc := pick(ht, []rune{' ', '.', '-'})
+		want := s
+		if w < n {
+			want = s + strings.Repeat(string(pc), n-w)
+		}
+		if got := text.Pad(s, n, pc); got != want {
+			c.failClass(ht, "Pad", "Pad(%q, %d, %q) = %q, want %q", s, n, pc, got, want)
+			return
+		}
+		ind := pick(ht, []string{"~", "...", "…", "", esc + "[31m~" + esc + "[0m", "……"})
+		if Known.snipNoPad && widthOf(ind) >= n {
+			ind = "~"
+		}
+		if got, want := text.Snip(s, n, ind), modelSnip(s, n, ind); got != want {
+			c.failClass(ht, "Snip", "Snip(%q, %d, %q) = %q, want %q", s, n, ind, got, want)
+			return
+		}
+		// Widen: every visible rune widened, sequences untouched
+		var wb strings.Builder
+		for _, tk := range scan(s) {
+			if tk.esc != "" {
+				wb.WriteString(tk.esc)
+			} else {
+				wb.WriteString(width.Widen.String(string(tk.r)))
+			}
+		}
+		if got := text.Widen(s); got != wb.String() {
+			c.failClass(ht, "Widen", "Widen(%q) = %q, want %q", s, got, wb.String())
+			return
+		}
+		// RepeatAndTrim on a short string
+		rs := genText(ht, textOpts{sequences: !Known.repeatTrimWidth})
+		if Known.repeatTrimWidth {
+			rs = strings.Map(func(r rune) rune {
+				if text.RuneWidth(r) != 1 {
+					return 'x'
+				}
+				return r
+			}, rs)
+		}
+		m := drawInt(ht, -1, 12)
+		if got, want := text.RepeatAndTrim(rs, m), modelRepeatAndTrim(rs, m); got != want {
+			c.failClass(ht, "RepeatAndTrim", "RepeatAndTrim(%q, %d) = %q, want %q", rs, m, got, want)
+			return
+		}
+		switch {
+		case len(escapes(s)) > 0:
+			c.count("with sequences")
+		default:
+			c.count("plain")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- InsertEveryN, ProcessCRLF
+
+// modelInsertEveryN: the rune before every visible rune that would start beyond the N-th column
+// of its line; the count restarts at \r and \n; sequences pass through.
+func modelInsertEveryN(s string, r rune, n int) string {
+	if n <= 0 {
+		return s
+	}
+	var b strings.Builder
+	lineLen := 0
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if t.r == '\n' || t.r == '\r' {
+			lineLen = 0
+		} else if w := text.RuneWidth(t.r); w > 0 {
+			if lineLen >= n {
+				b.WriteRune(r)
+				lineLen = 0
+			}
+			lineLen += w
+		}
+		b.WriteRune(t.r)
+	}
+	return b.String()
+}
+
+// modelProcessCRLF: \r\n is \n; a lone \r moves the cursor to the start of the line and the
+// following runes overwrite. Under Known.crlfEscapeColumns the runes of escape sequences take
+// columns too (the package's rune loop); otherwise sequences pass through without a column.
+func modelProcessCRLF(s string) string {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	lines := strings.Split(s, "\n")
+	for li, line := range lines {
+		if !strings.Contains(line, "\r") {
+			continue
+		}
+		if Known.crlfEscapeColumns {
+			rs := []rune(line)
+			var out []rune
+			idx := 0
+			for _, r := range rs {
+				if r == '\r' {
+					idx = 0
+					continue
+				}
+				if idx < len(out) {
+					out[idx] = r
+				} else {
+					out = append(out, r)
+				}
+				idx++
+			}
+			lines[li] = string(out)
+			continue
+		}
+		// columns hold visible runes; sequences are emitted where they occur
+		var cols []string // each column: a visible rune, possibly preceded by sequences
+		idx := 0
+		pending := ""
+		for _, t := range scan(line) {
+			if t.esc != "" {
+				pending += t.esc
+				continue
+			}
+			if t.r == '\r' {
+				idx = 0
+				continue
+			}
+			cell := pending + string(t.r)
+			pending = ""
+			if idx < len(cols) {
+				cols[idx] = cell
+			} else {
+				cols = append(cols, cell)
+			}
+			idx++
+		}
+		lines[li] = strings.Join(cols, "") + pending
+	}
+	return strings.Join(lines, "\n")
+}
+
+func TestHegelInsert(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := genText(ht, textOpts{newlines: true, tabs: true, sequences: true, other: true, spaces: true})
+		n := drawInt(ht, -1, 5)
+		r := pick(ht, []rune{'-', '|', '\n', '生'})
+		if got, want := text.InsertEveryN(s, r, n), modelInsertEveryN(s, r, n); got != want {
+			c.failClass(ht, "InsertEveryN", "InsertEveryN(%q, %q, %d) = %q, want %q", s, r, n, got, want)
+			return
+		}
+		// ProcessCRLF on a string with carriage returns
+		cr := genText(ht, textOpts{newlines: true, sequences: chance(ht, 50), spaces: true})
+		if chance(ht, 70) {
+			rs := []rune(cr)
+			for k := drawInt(ht, 1, 2); k > 0; k-- {
+				at := drawInt(ht, 0, len(rs))
+				rs = append(rs[:at], append([]rune{'\r'}, rs[at:]...)...)
+			}
+			cr = string(rs)
+		}
+		if got, want := text.ProcessCRLF(cr), modelProcessCRLF(cr); got != want {
+			c.failClass(ht, "ProcessCRLF", "ProcessCRLF(%q) = %q, want %q", cr, got, want)
+			return
+		}
+		c.count(fmt.Sprintf("n=%d", n))
+	})
+}
+
+// --------------------------------------------------------------------------- Align, VAlign
+
+func isNumberText(s string) bool {
+	_, err := strconv.ParseFloat(s, 64)
+	return err == nil
+}
+
+// modelAlign: the visible text of Align.Apply. Spaces are trimmed on the padded side when the
+// raw string has a space at that end (a sequence there prevents the trim, as in the package);
+// Justify splits the raw text on spaces, so a sequence standing alone is a word. Returns the
+// visible result and whether the sequences are expected to survive.
+func modelAlign(a text.Align, s string, n int) (string, bool) {
+	vis := visible(s)
+	eff := a
+	if a == text.AlignAuto {
+		src := vis
+		if Known.autoAlignRaw {
+			src = s
+		}
+		if isNumberText(src) {
+			eff = text.AlignRight
+		} else {
+			eff = text.AlignLeft
+		}
+	}
+	trimLeft, trimRight := false, false
+	switch eff {
+	case text.AlignDefault, text.AlignLeft:
+		trimRight = strings.HasSuffix(s, " ")
+	case text.AlignRight:
+		trimLeft = strings.HasPrefix(s, " ")
+	default:
+		if strings.HasPrefix(s, " ") || strings.HasSuffix(s, " ") {
+			trimLeft, trimRight = true, true
+		}
+	}
+	raw := s
+	if trimLeft {
+		raw = strings.TrimLeft(raw, " ")
+	}
+	if trimRight {
+		raw = strings.TrimRight(raw, " ")
+	}
+	trimmed := visible(raw)
+	w := widthOfPlain(trimmed)
+	pad := n - w
+	if pad < 0 {
+		pad = 0
+	}
+	switch eff {
+	case text.AlignDefault, text.AlignLeft:
+		return trimmed + strings.Repeat(" ", pad), true
+	case text.AlignRight:
+		return strings.Repeat(" ", pad) + trimmed, true
+	case text.AlignCenter:
+		return strings.Repeat(" ", pad-pad/2) + trimmed + strings.Repeat(" ", pad/2), true
+	}
+	// justify: the raw words
+	words := []string{}
+	for _, wd := range strings.Split(raw, " ") {
+		if wd != "" {
+			words = append(words, wd)
+		}
+	}
+	if len(words) == 0 {
+		return strings.Repeat(" ", n), false
+	}
+	needed := n - w + strings.Count(raw, " ")
+	if needed < 0 {
+		return trimmed, true
+	}
+	between := 0
+	if len(words) > 1 {
+		between = needed / (len(words) - 1)
+	}
+	var b strings.Builder
+	for i, wd := range words {
+		if i > 0 {
+			if i == len(words)-1 {
+				b.WriteString(strings.Repeat(" ", needed))
+				needed = 0
+			} else {
+				b.WriteString(strings.Repeat(" ", between))
+				needed -= between
+			}
+		}
+		b.WriteString(wd)
+		if i == len(words)-1 && needed > 0 {
+			b.WriteString(strings.Repeat(" ", needed))
+		}
+	}
+	return visible(b.String()), true
+}
+
+func TestHegelAlign(t *testing.T) {
+	c := newCollector(t)
+	aligns := []text.Align{text.AlignDefault, text.AlignLeft, text.AlignCenter, text.AlignJustify, text.AlignRight, text.AlignAuto}
+	names := []string{"Default", "Left", "Center", "Justify", "Right", "Auto"}
+	property(t, func(ht *hegel.T) {
+		var s string
+		if chance(ht, 25) {
+			// number-like texts for AlignAuto
+			s = pick(ht, []string{"12", "-3.5", "1e3", "Inf", "0x1p-2", "12a", " 7", "7 ", "1_000"})
+			if chance(ht, 30) {
+				s = esc + "[31m" + s + esc + "[0m"
+			}
+		} else {
+			s = genText(ht, textOpts{sequences: true, spaces: true})
+		}
+		n := drawInt(ht, -1, 14)
+		i := drawInt(ht, 0, len(aligns)-1)
+		a := aligns[i]
+		if a == text.AlignJustify && n < 0 && Known.justifyNegativePanic {
+			n = 0
+		}
+		got := a.Apply(s, n)
+		wantVis, keep := modelAlign(a, s, n)
+		if visible(got) != wantVis {
+			c.failClass(ht, names[i], "Align%s.Apply(%q, %d) = %q (visible %q), want visible %q", names[i], s, n, got, visible(got), wantVis)
+			return
+		}
+		if keep && !reflect.DeepEqual(escapes(got), escapes(s)) {
+			c.failClass(ht, names[i]+" sequences", "Align%s.Apply(%q, %d) = %q: sequences %q, want %q", names[i], s, n, got, escapes(got), escapes(s))
+			return
+		}
+		// VAlign
+		lines := make([]string, drawInt(ht, 0, 4))
+		for k := range lines {
+			lines[k] = genWord(ht)
+		}
+		maxLines := drawInt(ht, -1, 6)
+		va := pick(ht, []text.VAlign{text.VAlignDefault, text.VAlignTop, text.VAlignMiddle, text.VAlignBottom})
+		want := modelVAlign(va, lines, maxLines)
+		vg := va.Apply(append([]string{}, lines...), maxLines)
+		if !reflect.DeepEqual(vg, want) {
+			c.failClass(ht, "VAlign", "VAlign(%d).Apply(%q, %d) = %q, want %q", va, lines, maxLines, vg, want)
+			return
+		}
+		if len(lines) > 0 {
+			vs := va.ApplyStr(strings.Join(lines, "\n"), maxLines)
+			if !reflect.DeepEqual(vs, want) {
+				c.failClass(ht, "VAlignStr", "VAlign(%d).ApplyStr(%q, %d) = %q, want %q", va, strings.Join(lines, "\n"), maxLines, vs, want)
+				return
+			}
+		}
+		c.count(names[i])
+	})
+}
+
+func modelVAlign(va text.VAlign, lines []string, maxLines int) []string {
+	if len(lines) == maxLines {
+		return lines
+	}
+	if len(lines) > maxLines {
+		maxLines = len(lines)
+	}
+	if maxLines < 1 {
+		return lines
+	}
+	insert := 0
+	switch va {
+	case text.VAlignMiddle:
+		insert = (maxLines - len(lines)) / 2
+	case text.VAlignBottom:
+		insert = maxLines - len(lines)
+	}
+	out := make([]string, maxLines)
+	for i, l := range lines {
+		out[i+insert] = l
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- Format
+
+// isSeparator: strings.Title's rule (the package copies it).
+func isSeparator(r rune) bool {
+	if r <= 0x7F {
+		switch {
+		case '0' <= r && r <= '9', 'a' <= r && r <= 'z', 'A' <= r && r <= 'Z', r == '_':
+			return false
+		}
+		return true
+	}
+	if unicode.IsLetter(r) || unicode.IsDigit(r) {
+		return false
+	}
+	return unicode.IsSpace(r)
+}
+
+// modelFormat: the visible runes converted, every escape sequence untouched.
+func modelFormat(f text.Format, s string) string {
+	var b strings.Builder
+	prev := ' '
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		r := t.r
+		switch f {
+		case text.FormatLower:
+			r = unicode.ToLower(r)
+		case text.FormatUpper:
+			r = unicode.ToUpper(r)
+		case text.FormatTitle:
+			if isSeparator(prev) {
+				if Known.titleUpper {
+					r = unicode.ToUpper(r)
+				} else {
+					r = unicode.ToTitle(r)
+				}
+			}
+			prev = t.r
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+func TestHegelFormat(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := genText(ht, textOpts{newlines: true, sequences: true, other: !Known.formatCSIOnly, spaces: true})
+		if chance(ht, 30) {
+			var ub strings.Builder
+			for _, tk := range scan(s) {
+				if tk.esc != "" {
+					ub.WriteString(tk.esc)
+				} else {
+					ub.WriteRune(unicode.ToUpper(tk.r))
+				}
+			}
+			s = ub.String()
+		}
+		f := pick(ht, []text.Format{text.FormatDefault, text.FormatLower, text.FormatTitle, text.FormatUpper})
+		if got, want := f.Apply(s), modelFormat(f, s); got != want {
+			c.failClass(ht, fmt.Sprintf("Format %d", f), "Format(%d).Apply(%q) = %q, want %q", f, s, got, want)
+			return
+		}
+		c.count(fmt.Sprintf("format %d", f))
+	})
+}
+
+// --------------------------------------------------------------------------- Escape, parser
+
+// modelEscapeStates: the SGR state at each visible rune of Escape(s, seq): seq applies from the
+// start (unless s starts with a CSI sequence) and again after every reset "\x1b[0m".
+func modelEscapeStates(s, seq string) []sgr {
+	var q sgr
+	q.apply(seq)
+	st := q
+	if strings.HasPrefix(s, esc+"[") {
+		st = sgr{}
+	}
+	var out []sgr
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			if t.esc == esc+"[0m" {
+				st = q
+			} else {
+				st.apply(t.esc)
+			}
+			continue
+		}
+		out = append(out, st)
+	}
+	return out
+}
+
+func TestHegelEscape(t *testing.T) {
+	c := newCollector(t)
+	text.EnableColors()
+	property(t, func(ht *hegel.T) {
+		s := genText(ht, textOpts{sequences: true, spaces: true})
+		// resets as the exact sequence the package recognises
+		var rb strings.Builder
+		for _, tk := range scan(s) {
+			if tk.esc != "" && strings.HasPrefix(tk.esc, esc+"[0;") {
+				rb.WriteString(esc + "[0m")
+			} else if tk.esc != "" {
+				rb.WriteString(tk.esc)
+			} else {
+				rb.WriteRune(tk.r)
+			}
+		}
+		s = rb.String()
+		// at most one foreground and one background colour (Known.colorsSorted)
+		var colors text.Colors
+		if chance(ht, 40) {
+			colors = append(colors, pick(ht, []text.Color{text.Bold, text.Underline, text.Italic}))
+		}
+		if chance(ht, 60) {
+			colors = append(colors, pick(ht, []text.Color{text.FgRed, text.FgHiBlue, text.Fg256Color(drawInt(ht, 0, 255))}))
+		}
+		if chance(ht, 30) {
+			colors = append(colors, pick(ht, []text.Color{text.BgGreen, text.Bg256Color(200)}))
+		}
+		if Known.escapeEmptySeq && len(colors) == 0 {
+			colors = text.Colors{text.FgRed}
+		}
+		seq := colors.EscapeSeq()
+		if seq != "" && chance(ht, 30) {
+			// the sequence itself inside the input (a colour only into an empty slot under Known.colorsSorted)
+			var q sgr
+			q.apply(seq)
+			if st := stateAfter(s); !Known.colorsSorted || ((q.fg == "" || st.fg == "") && (q.bg == "" || st.bg == "")) {
+				s += seq + pick(ht, []string{"", esc + "[0m"})
+			}
+		}
+		if Known.escapeStripsPair && seq != "" {
+			s = strings.ReplaceAll(s, seq+esc+"[0m", seq+"x"+esc+"[0m")
+			if strings.HasSuffix(s, seq) {
+				s += "x"
+			}
+		}
+		got := text.Escape(s, seq)
+		if visible(got) != visible(s) {
+			c.failClass(ht, "Escape visible", "Escape(%q, %q) = %q: visible %q, want %q", s, seq, got, visible(got), visible(s))
+			return
+		}
+		want := modelEscapeStates(s, seq)
+		gs := visibleStates(got)
+		for i := range want {
+			if gs[i].st != want[i] {
+				c.failClass(ht, "Escape state", "Escape(%q, %q) = %q: rune %d %q in state %s, want %s", s, seq, got, i, gs[i].r, gs[i].st, want[i])
+				return
+			}
+		}
+		if got != "" && stateAfter(got) != (sgr{}) {
+			c.failClass(ht, "Escape end", "Escape(%q, %q) = %q ends in state %s", s, seq, got, stateAfter(got))
+			return
+		}
+		// Colors.Sprint is Escape of the printed value
+		if sp := colors.Sprint(s); sp != text.Escape(s, seq) && !(seq == "" && sp == s) {
+			c.failClass(ht, "Sprint", "Colors(%v).Sprint(%q) = %q, want %q", colors, s, sp, text.Escape(s, seq))
+			return
+		}
+		// the parser's restored sequence denotes the state at the end of s
+		esp := text.EscSeqParser{}
+		esp.ParseString(s)
+		restored := esp.Sequence()
+		wantSt := stateAfter(s)
+		if gotSt := stateAfter(restored); gotSt != wantSt {
+			c.failClass(ht, "Sequence", "EscSeqParser.ParseString(%q).Sequence() = %q (state %s), want state %s", s, restored, gotSt, wantSt)
+			return
+		}
+		if esp.IsOpen() != (wantSt != sgr{}) {
+			c.failClass(ht, "IsOpen", "EscSeqParser after %q: IsOpen %v, state %s", s, esp.IsOpen(), wantSt)
+			return
+		}
+		c.count(fmt.Sprintf("colors=%d", len(colors)))
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..c66f88e
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,175 @@
+package hegel
+
+// Hegel property tests for jedib0t/go-pretty's text package, written for the Hegel zoo. See
+// targets/go/go-pretty/README.md.
+//
+// Oracle: a model of the documented behaviour of the text utilities over strings holding ANSI
+// escape sequences: a scanner for CSI and OSC sequences (ECMA-48: a CSI ends at its final byte,
+// an OSC at BEL or ESC \), the visible text and its display width (text.RuneWidth per rune),
+// an SGR state (foreground, background, attributes) tracked through the sequences, and the
+// documented rules of Trim/Snip/Pad/RepeatAndTrim, InsertEveryN, ProcessCRLF, Align, VAlign,
+// Format, Escape, the wrap functions (line widths, words, escape state per visible rune) and
+// the transformers.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	csiOnlyM             bool // 1: a CSI sequence is terminated only by m; cursor and erase sequences swallow the text after them
+	oscBelOnly8          bool // 2: an OSC sequence terminated by BEL is recognised only for OSC 8
+	formatCSIOnly        bool // 3: Format.Apply ends every sequence at m, so hyperlinks are case-changed
+	escapeEmptySeq       bool // 4: Escape(str, "") removes every reset sequence from str
+	wrapStaleReset       bool // 5: a word whose sequences empty the state (a reset) leaves the earlier sequence to be re-opened on later lines
+	wrapWordSequenceRaw  bool // 6: a hard-wrapped word restarts its lines with the raw sequence found in the word, not the state
+	wrapHyperlink        bool // 7, 8: an OSC 8 hyperlink is parsed as SGR codes (conceal) and its word is not wrapped
+	truecolor            bool // 9: 38;2;r;g;b is parsed as five attribute codes
+	colorsSorted         bool // 10: Sequence() emits colours in numeric order, not the last set
+	concealOff           bool // 11: code 28 (conceal off) is not applied
+	numberNegFormat      bool // 12: negatives are formatted as "-" + format of -val (widths, MinInt64)
+	timeEpochEmpty       bool // 13: times at or before the Unix epoch render as ""
+	unixInt64Only        bool // 14: NewUnixTimeTransformer formats only int64 and string values
+	autoAlignRaw         bool // 15: AlignAuto parses the number from the raw text, escape sequences included
+	titleUpper           bool // 16: FormatTitle upper-cases instead of title-casing
+	repeatTrimWidth      bool // 17: RepeatAndTrim counts runes to repeat but trims by display width
+	snipNoPad            bool // 18: Snip does not pad and exceeds the length with a wide indicator
+	crlfEscapeColumns    bool // 19: ProcessCRLF overwrites columns with the runes of escape sequences
+	wrapBoundaryState    bool // 20: the escape state is dropped at a paragraph break (WrapHard/WrapSoft) and a line break (WrapText)
+	wrapWideOverflow     bool // 21: a wide rune straddling the width is appended, making the line one column too wide
+	justifyNegativePanic bool // 22: AlignJustify.Apply panics on a blank text and a negative length
+	codesOutOfOrder      bool // 23: the parser applies 256-colour codes before the other codes of the same sequence
+	escapeStripsPair     bool // 24: Escape removes the input's own seq+reset pair, leaving the output open
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
diff --git a/hegel/hegel_transform_test.go b/hegel/hegel_transform_test.go
new file mode 100644
index 0000000..c613796
--- /dev/null
+++ b/hegel/hegel_transform_test.go
@@ -0,0 +1,230 @@
+package hegel
+
+// The transformers: numbers (format and sign colours), times and unix times.
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+var safeIntFormats = []string{"%d", "%v", "%x"}
+var safeFloatFormats = []string{"%v", "%.2f", "%g"}
+var wideIntFormats = []string{"%5d", "%05d", "%+d", "%-6d|", "%8v"}
+var wideFloatFormats = []string{"%8.2f", "%+.1f", "%-9.3f|"}
+
+// genNumber: a value of every numeric kind (as any) with its sign and its float64/int64 image.
+func genNumber(tc hegel.TestCase) (v any, sign int, isFloat bool) {
+	switch drawInt(tc, 0, 5) {
+	case 0:
+		n := drawInt(tc, -300, 300)
+		switch drawInt(tc, 0, 4) {
+		case 0:
+			return int8(n / 3), sgn(n / 3), false
+		case 1:
+			return int16(n), sgn(n), false
+		case 2:
+			return int32(n), sgn(n), false
+		case 3:
+			return int64(n), sgn(n), false
+		}
+		return n, sgn(n), false
+	case 1:
+		if !Known.numberNegFormat && chance(tc, 30) {
+			return int64(math.MinInt64), -1, false
+		}
+		n := drawInt(tc, 0, 300)
+		switch drawInt(tc, 0, 4) {
+		case 0:
+			return uint8(n % 256), sgn(n % 256), false
+		case 1:
+			return uint16(n), sgn(n), false
+		case 2:
+			return uint32(n), sgn(n), false
+		case 3:
+			return uint64(n), sgn(n), false
+		}
+		return uint(n), sgn(n), false
+	case 2:
+		f := float64(drawInt(tc, -3000, 3000)) / 8
+		if chance(tc, 30) {
+			return float32(f), sgnF(f), true
+		}
+		return f, sgnF(f), true
+	case 3:
+		f := pick(tc, []float64{0, math.Copysign(0, -1), 0.001, -0.001, 1e21, -1e-7})
+		return f, sgnF(f), true
+	default:
+		n := drawInt(tc, -100, 100)
+		return n, sgn(n), false
+	}
+}
+
+func sgn(n int) int {
+	switch {
+	case n < 0:
+		return -1
+	case n > 0:
+		return 1
+	}
+	return 0
+}
+
+func sgnF(f float64) int {
+	switch {
+	case f < 0:
+		return -1
+	case f > 0:
+		return 1
+	}
+	return 0
+}
+
+// normalized: the value as the package converts it (int64, uint64 or float64).
+func normalized(v any) any {
+	switch x := v.(type) {
+	case int:
+		return int64(x)
+	case int8:
+		return int64(x)
+	case int16:
+		return int64(x)
+	case int32:
+		return int64(x)
+	case uint:
+		return uint64(x)
+	case uint8:
+		return uint64(x)
+	case uint16:
+		return uint64(x)
+	case uint32:
+		return uint64(x)
+	case float32:
+		return float64(x)
+	}
+	return v
+}
+
+func TestHegelTransform(t *testing.T) {
+	c := newCollector(t)
+	text.EnableColors()
+	property(t, func(ht *hegel.T) {
+		v, sign, isFloat := genNumber(ht)
+		var format string
+		switch {
+		case isFloat && Known.numberNegFormat:
+			format = pick(ht, safeFloatFormats)
+		case isFloat:
+			format = pick(ht, append(append([]string{}, safeFloatFormats...), wideFloatFormats...))
+		case Known.numberNegFormat:
+			format = pick(ht, safeIntFormats)
+		default:
+			format = pick(ht, append(append([]string{}, safeIntFormats...), wideIntFormats...))
+		}
+		nv := normalized(v)
+		_, isZeroFloat := nv.(float64)
+		if isZeroFloat && sign == 0 && math.Signbit(nv.(float64)) {
+			// the package prints -0 as the zero value formatted: keep the model on it
+		}
+		plain := fmt.Sprintf(format, nv)
+		var want string
+		switch sign {
+		case -1:
+			want = text.Colors{text.FgHiRed}.Sprint(plain)
+		case 1:
+			want = text.Colors{text.FgHiGreen}.Sprint(plain)
+		default:
+			want = plain
+		}
+		if got := text.NewNumberTransformer(format)(v); got != want {
+			c.failClass(ht, "Number", "NewNumberTransformer(%q)(%T %v) = %q, want %q", format, v, v, got, want)
+			return
+		}
+		if got := text.NewNumberTransformer(format)("x" + plain); got != "x"+plain {
+			c.failClass(ht, "Number string", "NewNumberTransformer(%q)(%q) = %q", format, "x"+plain, got)
+			return
+		}
+		// times
+		layout := pick(ht, []string{time.RFC3339, "2006-01-02", time.Kitchen, time.RFC1123})
+		var loc *time.Location
+		switch drawInt(ht, 0, 2) {
+		case 0:
+			loc = time.UTC
+		case 1:
+			loc = time.FixedZone("X", 5*3600+1800)
+		}
+		lo := int64(-2000000000)
+		if Known.timeEpochEmpty {
+			lo = 1
+		}
+		secs := lo + int64(drawInt(ht, 0, int(4000000000-lo)))
+		tm := time.Unix(secs, int64(drawInt(ht, 0, 999))*1000000).UTC()
+		wantT := tm
+		if loc != nil {
+			wantT = tm.In(loc)
+		}
+		tt := text.NewTimeTransformer(layout, loc)
+		if got := tt(tm); got != wantT.Format(layout) {
+			c.failClass(ht, "Time", "NewTimeTransformer(%q, %v)(%v) = %q, want %q", layout, loc, tm, got, wantT.Format(layout))
+			return
+		}
+		// a string in an RFC3339 form is parsed and reformatted
+		strLayout := pick(ht, []string{time.RFC3339, time.RFC3339Nano, "2006-01-02T15:04:05.000Z07:00"})
+		tstr := tm.Format(strLayout)
+		parsed, _ := time.Parse(strLayout, tstr)
+		wantP := parsed
+		if loc != nil {
+			wantP = parsed.In(loc)
+		}
+		if got := tt(tstr); got != wantP.Format(layout) {
+			c.failClass(ht, "Time string", "NewTimeTransformer(%q, %v)(%q) = %q, want %q", layout, loc, tstr, got, wantP.Format(layout))
+			return
+		}
+		if got := tt(12345); got != "12345" {
+			c.failClass(ht, "Time other", "NewTimeTransformer(%q, %v)(12345) = %q", layout, loc, got)
+			return
+		}
+		// unix times in seconds, milliseconds, microseconds or nanoseconds
+		unit := pick(ht, []int64{1, 1000, 1000000, 1000000000})
+		usecs := secs * unit
+		// the documented unit detection: ten seconds' worth in each unit
+		dec := usecs
+		switch {
+		case dec >= 10*1000000000*1000000:
+			dec /= 1000000000
+		case dec >= 10*1000000000*1000:
+			dec /= 1000000
+		case dec >= 10*1000000000:
+			dec /= 1000
+		}
+		var uval any = usecs
+		wantU := time.Unix(dec, 0)
+		if loc != nil {
+			wantU = wantU.In(loc)
+		}
+		wantUS := wantU.Format(layout)
+		switch drawInt(ht, 0, 2) {
+		case 1:
+			uval = strconv.FormatInt(usecs, 10)
+		case 2:
+			if Known.unixInt64Only {
+				uval = usecs
+			} else {
+				uval = int(usecs)
+			}
+		}
+		if dec <= 0 && Known.timeEpochEmpty {
+			wantUS = ""
+		}
+		if got := text.NewUnixTimeTransformer(layout, loc)(uval); got != wantUS {
+			c.failClass(ht, "UnixTime", "NewUnixTimeTransformer(%q, %v)(%T %v) = %q, want %q", layout, loc, uval, uval, got, wantUS)
+			return
+		}
+		c.count(fmt.Sprintf("sign=%d float=%v", sign, isFloat))
+	})
+}
diff --git a/hegel/hegel_wrap_test.go b/hegel/hegel_wrap_test.go
new file mode 100644
index 0000000..ca39e06
--- /dev/null
+++ b/hegel/hegel_wrap_test.go
@@ -0,0 +1,156 @@
+package hegel
+
+// WrapHard, WrapSoft and WrapText: line widths, the visible content, and the escape state of
+// every visible rune.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+// genWrapText: paragraphs of lines of words, each word possibly opening an SGR sequence. Under
+// the switches: no reset but at the end, every sequence spelling the whole state, no sequence
+// inside a word, no hyperlink word, and line breaks only while no state is open.
+func genWrapText(tc hegel.TestCase) string {
+	var b strings.Builder
+	var st sgr
+	np := drawInt(tc, 1, 2)
+	for p := 0; p < np; p++ {
+		if p > 0 {
+			if Known.wrapBoundaryState && st != (sgr{}) {
+				b.WriteString("  ")
+			} else {
+				b.WriteString("\n\n")
+			}
+		}
+		nl := drawInt(tc, 1, 2)
+		for l := 0; l < nl; l++ {
+			if l > 0 {
+				if Known.wrapBoundaryState && st != (sgr{}) {
+					b.WriteString(" ")
+				} else {
+					b.WriteString("\n")
+				}
+			}
+			nw := drawInt(tc, 0, 6)
+			for w := 0; w < nw; w++ {
+				if w > 0 {
+					b.WriteString(pick(tc, []string{" ", " ", "  ", "\t"}))
+				}
+				if chance(tc, 35) {
+					b.WriteString(genSGROpt(tc, &st, sgrOpts{noReset: Known.wrapStaleReset, fullState: Known.wrapWordSequenceRaw}))
+				}
+				word := genWord(tc)
+				switch {
+				case !Known.wrapHyperlink && chance(tc, 15):
+					word = genHyperlink(tc)
+				case !Known.wrapWordSequenceRaw && chance(tc, 20):
+					rs := []rune(word)
+					k := drawInt(tc, 1, len(rs))
+					word = string(rs[:k]) + genSGROpt(tc, &st, sgrOpts{noReset: Known.wrapStaleReset}) + string(rs[k:])
+				}
+				b.WriteString(word)
+				if !Known.wrapStaleReset && chance(tc, 20) {
+					b.WriteString(esc + "[0m")
+					st = sgr{}
+				}
+			}
+		}
+	}
+	if chance(tc, 40) {
+		b.WriteString(esc + "[0m")
+	}
+	return b.String()
+}
+
+// nonSpaceStates: the visible non-whitespace runes with their SGR state.
+func nonSpaceStates(s string) []runeState {
+	var out []runeState
+	for _, rs := range visibleStates(s) {
+		if !unicode.IsSpace(rs.r) {
+			out = append(out, rs)
+		}
+	}
+	return out
+}
+
+func TestHegelWrap(t *testing.T) {
+	c := newCollector(t)
+	type wrapFn struct {
+		name string
+		fn   func(string, int) string
+	}
+	fns := []wrapFn{{"WrapHard", text.WrapHard}, {"WrapSoft", text.WrapSoft}, {"WrapText", text.WrapText}}
+	property(t, func(ht *hegel.T) {
+		s := genWrapText(ht)
+		n := drawInt(ht, 1, 12)
+		f := pick(ht, fns)
+		out := f.fn(s, n)
+		expanded := strings.ReplaceAll(s, "\t", "    ")
+		wrapped := widthOf(expanded) > n
+		// widths: every line fits, unless it is a single rune wider than the width
+		for _, line := range strings.Split(out, "\n") {
+			if w := widthOf(line); w > n {
+				vis := strings.TrimRight(visible(line), " ")
+				rs := []rune(vis)
+				if len(rs) == 1 && text.RuneWidth(rs[0]) > n {
+					continue
+				}
+				if Known.wrapWideOverflow && widthOfPlain(vis) == n+1 && len(rs) > 0 && text.RuneWidth(rs[len(rs)-1]) == 2 {
+					continue // the package appends a wide rune that straddles the width
+				}
+				c.failClass(ht, f.name+" width", "%s(%q, %d) = %q: line %q has width %d", f.name, s, n, out, line, w)
+				return
+			}
+		}
+		// content: the visible non-whitespace runes, in order, with their escape state
+		in, got := nonSpaceStates(expanded), nonSpaceStates(out)
+		if len(in) != len(got) {
+			c.failClass(ht, f.name+" content", "%s(%q, %d) = %q: %d visible runes, want %d", f.name, s, n, out, len(got), len(in))
+			return
+		}
+		for i := range in {
+			if in[i].r != got[i].r {
+				c.failClass(ht, f.name+" content", "%s(%q, %d) = %q: rune %d is %q, want %q", f.name, s, n, out, i, got[i].r, in[i].r)
+				return
+			}
+			if in[i].st != got[i].st {
+				c.failClass(ht, f.name+" state", "%s(%q, %d) = %q: rune %d %q in state %s, want %s", f.name, s, n, out, i, got[i].r, got[i].st, in[i].st)
+				return
+			}
+		}
+		// a wrapped output does not leave a state open
+		if wrapped && stateAfter(out) != (sgr{}) {
+			c.failClass(ht, f.name+" end", "%s(%q, %d) = %q ends in state %s", f.name, s, n, out, stateAfter(out))
+			return
+		}
+		// WrapSoft keeps words that fit whole
+		if f.name == "WrapSoft" {
+			words := strings.Fields(visible(strings.ReplaceAll(s, "\t", " ")))
+			fits := true
+			for _, w := range words {
+				if widthOfPlain(w) > n {
+					fits = false
+				}
+			}
+			if fits {
+				gw := strings.Fields(visible(out))
+				if strings.Join(gw, "\x00") != strings.Join(words, "\x00") {
+					c.failClass(ht, "WrapSoft words", "WrapSoft(%q, %d) = %q: words %q, want %q", s, n, out, gw, words)
+					return
+				}
+			}
+		}
+		// a string that fits is returned as it is (tabs expanded)
+		if !wrapped && out != expanded {
+			c.failClass(ht, f.name+" fits", "%s(%q, %d) = %q, want the input", f.name, s, n, out)
+			return
+		}
+		c.count(fmt.Sprintf("%s lines=%d", f.name, strings.Count(out, "\n")+1))
+	})
+}
