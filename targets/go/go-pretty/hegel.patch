+// --------------------------------------------------------------------------- Render
+
+// mergeToken: the cell of the row carrying RowConfig{AutoMerge}; one column wide, so that the
+// merged cell always fits its columns (a wider one may make Render panic).
+const mergeToken = "~"
+
+// renderModel: the line layout of Render() for a spec: line counts per block and the width.
+type renderModel struct {
+	colWidths  []int
+	width      int
+	titleLines int
+	headLines  int // header block incl. its bottom separator
+	bodyStart  int // index of the first body line
+	rowLines   []int
+	total      int
+}
+
+func modelRender(s *tableSpec, m *tableModel) renderModel {
+	var rm renderModel
+	widths := make([]int, m.numCols)
+	for _, rs := range [][][]string{m.header, m.body, m.footer} {
+		for _, r := range rs {
+			if s.mergeRow >= 0 && len(r) > 0 && r[0] == mergeToken {
+				continue // the merged cell spans its columns
+			}
+			for c, v := range r {
+				w := text.LongestLineLen(v)
+				if mx := m.configs[c].WidthMax; mx > 0 && w > mx {
+					w = mx
+				}
+				if w > widths[c] {
+					widths[c] = w
+				}
+			}
+		}
+	}
+	for c := range widths {
+		if mn := m.configs[c].WidthMin; widths[c] < mn {
+			widths[c] = mn
+		}
+	}
+	width := func() int {
+		w := 2 // borders
+		if s.autoIndex {
+			w += len(strconv.Itoa(len(m.body))) + 2 + 1
+		}
+		w += m.numCols - 1
+		for _, cw := range widths {
+			w += cw + 2
+		}
+		return w
+	}
+	// Size.WidthMin: columns grow round-robin until the width is met
+	if pad := s.sizeWidthMin - width(); pad > 0 {
+		for pad > 0 {
+			n := 0
+			for c := 0; c < m.numCols && pad > 0; c++ {
+				if mx := m.configs[c].WidthMax; mx == 0 || widths[c] < mx {
+					widths[c]++
+					n++
+					pad--
+				}
+			}
+			if n == 0 {
+				break
+			}
+		}
+	}
+	rm.width = width()
+	rm.colWidths = widths
+	lines := func(r []string) int {
+		if len(r) == 0 {
+			return 1
+		}
+		n := 1
+		for c, v := range r {
+			if mx := m.configs[c].WidthMax; mx > 0 {
+				v = text.WrapText(v, mx)
+			}
+			if k := strings.Count(v, "\n") + 1; k > n {
+				n = k
+			}
+		}
+		return n
+	}
+	sum := func(rs [][]string) int {
+		n := 0
+		for _, r := range rs {
+			n += lines(r)
+		}
+		if s.separateRows && len(rs) > 1 {
+			n += len(rs) - 1
+		}
+		return n
+	}
+	if s.title != "" {
+		rm.titleLines = 1 + strings.Count(text.WrapText(s.title, rm.width-4), "\n") + 1
+	}
+	if len(m.header) > 0 {
+		rm.headLines = sum(m.header) + 1
+	} else if s.autoIndex {
+		rm.headLines = 2
+	}
+	rm.bodyStart = rm.titleLines + 1 + rm.headLines
+	for _, r := range m.body {
+		rm.rowLines = append(rm.rowLines, lines(r))
+	}
+	rm.total = rm.bodyStart + sum(m.body)
+	if len(m.footer) > 0 {
+		if len(m.body) > 0 {
+			rm.total++
+		}
+		rm.total += sum(m.footer)
+	}
+	rm.total++ // bottom border
+	if s.caption != "" {
+		rm.total++
+	}
+	return rm
+}
+
+// widthLimit: a ColumnConfig.WidthMax of 3-8 on the column at col (modulo the columns).
+type widthLimit struct {
+	col, max int
+}
+
+// mergeSpec: the body row (modulo the rows) carrying RowConfig{AutoMerge}, filled with a
+// token of width columns (one while go-pretty/42's switch is on).
+type mergeSpec struct {
+	row, width int
+}
+
+var (
+	renderSpecs = tableSpecs(cellOpts{noAngle: true}, true)
+	widthLimits = hegel.Map(pairs(positions, hegel.Integers(3, 8)), func(p pair[int, int]) widthLimit { return widthLimit{p.a, p.b} })
+	mergeWidths = func() hegel.Generator[int] {
+		if Known.mergePanic {
+			return hegel.Just(1)
+		}
+		return weighted(choice[int]{50, hegel.Just(1)}, choice[int]{50, hegel.Integers(2, 9)})
+	}()
+	mergeSpecs = hegel.Map(pairs(positions, mergeWidths), func(p pair[int, int]) mergeSpec { return mergeSpec{p.a, p.b} })
+	titles     = hegel.SampledFrom([]string{"Title", "A rather long title for a small table", "t"})
+)
+
+// asciiCell maps the non-ASCII runes of a string cell to w (a cell under a width limit).
+func asciiCell(v any) any {
+	str, ok := v.(string)
+	if !ok {
+		return v
+	}
+	return strings.Map(func(r rune) rune {
+		if r > 127 {
+			return 'w'
+		}
+		return r
+	}, str)
+}
+
+// renderCase: the table with SeparateRows three times in ten, a title three times in ten, a
+// caption one time in five; three times in ten a column width limit (on ASCII cells), else
+// up to three string cells (by position among them) coloured; Size.WidthMin one time in four
+// (not with a width limit while go-pretty/36's switch is on); a merged row three times in
+// ten (not with filters while go-pretty/35's is on); and the position of Size.WidthMax among
+// the widths it is checked at (from 3 while go-pretty/37's switch is on, 12 with a title, the
+// WidthMin while go-pretty/41's is on; up to the table's width plus four).
+type renderCase struct {
+	spec *tableSpec
+	wm   int
+}
+
+func (c renderCase) GoString() string { return fmt.Sprintf("%s\nWidthMax position %d", c.spec, c.wm) }
+
+var renderCases = hegel.Composite(func(tc hegel.TestCase) renderCase {
+	s := hegel.Draw(tc, renderSpecs)
+	s.separateRows = hegel.Draw(tc, chance(30))
+	s.title = hegel.Draw(tc, maybe(30, titles))
+	s.caption = hegel.Draw(tc, maybe(20, hegel.Just("caption")))
+	limit := hegel.Draw(tc, optional(30, widthLimits))
+	if limit != nil {
+		for _, r := range s.body {
+			for j := range r {
+				r[j] = asciiCell(r[j])
+			}
+		}
+		s.configs = append(s.configs, table.ColumnConfig{Number: 1 + limit.col%s.ncols, WidthMax: limit.max})
+	} else {
+		var strCells []*any
+		for _, r := range s.body {
+			for j := range r {
+				if _, ok := r[j].(string); ok {
+					strCells = append(strCells, &r[j])
+				}
+			}
+		}
+		if len(strCells) > 0 {
+			for _, p := range hegel.Draw(tc, many(positions, 0, 3)) {
+				cell := at(strCells, p)
+				*cell = text.Colors{text.FgRed, text.Bold}.Sprint(strings.TrimPrefix((*cell).(string), esc))
+			}
+		}
+	}
+	if !(Known.widthMinCapped && limit != nil) {
+		s.sizeWidthMin = hegel.Draw(tc, maybe(25, hegel.Integers(5, 60)))
+	}
+	// a merge needs two columns and no column config (a width limit is one)
+	if len(s.body) > 0 && s.ncols >= 2 && len(s.configs) == 0 && !(Known.rowConfigPosition && len(s.filters) > 0) {
+		if mg := hegel.Draw(tc, optional(30, mergeSpecs)); mg != nil {
+			s.mergeRow = mg.row % len(s.body)
+			row := make([]any, s.ncols)
+			for j := range row {
+				row[j] = strings.Repeat(mergeToken, mg.width)
+			}
+			s.body[s.mergeRow] = row
+		}
+	}
+	return renderCase{spec: s, wm: hegel.Draw(tc, positions)}
+})
+
+// TestHegelTableRender: the boxed rendering: every line the same width (or within
+// Size.WidthMax), the line layout, the cells' text, the auto-index numbers, the header case,
+// a row's AutoMerge.
+func TestHegelTableRender(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, renderCases)
+		s := c.spec
+		m := specModel(s)
+		if s.mergeRow >= 0 && (m.numCols < 2 || len(m.configs) > 0) {
+			s.mergeRow = -1 // a merge needs two visible columns; keep configs out of it
+			m = specModel(s)
+		}
+		if s.autoIndex && len(m.header) == 0 && Known.autoIndexHeaderWidth {
+			// the generated header row is not counted in the widths: no column may be narrower
+			for _, w := range modelRender(s, m).colWidths {
+				if w == 0 {
+					s.autoIndex = false
+					m = specModel(s)
+					break
+				}
+			}
+		}
+		// (after the auto-index is settled: without it a footer-only table is one)
+		if Known.footerOnlyBorder && len(m.header) == 0 && len(m.body) == 0 && len(m.footer) > 0 && !s.autoIndex {
+			s.header = [][]any{{"h"}} // a table of footer rows alone gets an empty top border
+			m = specModel(s)
+		}
+		tw := s.build()
+		out := tw.Render()
+		if m.numCols == 0 {
+			if out != "" {
+				fail(ht, "Render() = %q for a table without columns", out)
+			}
+			return
+		}
+		rm := modelRender(s, m)
+		lines := strings.Split(out, "\n")
+		if len(lines) != rm.total {
+			fail(ht, "Render() =\n%s\n%d lines, want %d (title %d, head %d, rows %v, footer %d)\nspec %v", out, len(lines), rm.total, rm.titleLines, rm.headLines, rm.rowLines, len(m.footer), s)
+			return
+		}
+		body := lines
+		if s.caption != "" {
+			body = lines[:len(lines)-1]
+		}
+		for i, l := range body {
+			if w := text.StringWidthWithoutEscSequences(l); w != rm.width {
+				fail(ht, "Render() =\n%s\nline %d %q has width %d, want %d\nspec %v", out, i, l, w, rm.width, s)
+				return
+			}
+		}
+		// the cells' text
+		for _, r := range m.header {
+			for ci, v := range r {
+				if mx := m.configs[ci].WidthMax; mx > 0 {
+					v = text.WrapText(v, mx)
+				}
+				for _, l := range strings.Split(strings.ToUpper(v), "\n") {
+					if l = strings.TrimSpace(l); !strings.Contains(out, l) {
+						fail(ht, "Render() =\n%s\nlacks header cell line %q upper-cased", out, l)
+						return
+					}
+				}
+			}
+		}
+		for _, r := range m.body {
+			for ci, v := range r {
+				if mx := m.configs[ci].WidthMax; mx > 0 {
+					v = text.WrapText(v, mx)
+				}
+				for _, l := range strings.Split(v, "\n") {
+					if l = strings.TrimSpace(l); !strings.Contains(out, l) {
+						fail(ht, "Render() =\n%s\nlacks body cell line %q", out, l)
+						return
+					}
+				}
+			}
+		}
+		// auto-index numbers on the first line of each body row
+		if s.autoIndex {
+			li := rm.bodyStart
+			w := len(strconv.Itoa(len(m.body)))
+			for i, n := range rm.rowLines {
+				want := "| " + text.AlignRight.Apply(strconv.Itoa(i+1), w) + " |"
+				if !strings.HasPrefix(lines[li], want) {
+					fail(ht, "Render() =\n%s\nline %d %q does not start with %q", out, li, lines[li], want)
+					return
+				}
+				li += n
+				if s.separateRows {
+					li++
+				}
+			}
+		}
+		// the merged row shows its token once
+		if s.mergeRow >= 0 {
+			tok := s.body[s.mergeRow][0].(string)
+			pos := -1
+			for i, r := range m.body {
+				if len(r) > 0 && r[0] == tok {
+					pos = i
+				}
+			}
+			if pos >= 0 {
+				li := rm.bodyStart
+				for i := 0; i < pos; i++ {
+					li += rm.rowLines[i]
+					if s.separateRows {
+						li++
+					}
+				}
+				if n := strings.Count(lines[li], tok); n != 1 {
+					fail(ht, "Render() =\n%s\nline %d %q shows %q %d times, want once (merged row)", out, li, lines[li], tok, n)
+					return
+				}
+			}
+		}
+		// Size.WidthMax: every line within it, at least as many lines
+		lo := 1
+		if Known.widthMaxTiny {
+			lo = 3
+		}
+		if s.title != "" && lo < 12 {
+			lo = 12
+		}
+		if Known.titleWidthMin && lo < s.sizeWidthMin {
+			lo = s.sizeWidthMin
+		}
+		if span := rm.width + 5 - lo; span > 0 {
+			wm := lo + c.wm%span
+			tw.Style().Size.WidthMax = wm
+			out2 := tw.Render()
+			lines2 := strings.Split(out2, "\n")
+			if len(lines2) < len(lines) {
+				fail(ht, "Render() with WidthMax %d =\n%s\n%d lines, want at least %d", wm, out2, len(lines2), len(lines))
+				return
+			}
+			for i, l := range lines2 {
+				if s.caption != "" && i == len(lines2)-1 {
+					break
+				}
+				if w := text.StringWidthWithoutEscSequences(l); w > wm {
+					fail(ht, "Render() with WidthMax %d =\n%s\nline %d %q has width %d", wm, out2, i, l, w)
+					return
+				}
+			}
+		}
+		count(ht, fmt.Sprintf("cols=%d rows=%d", m.numCols, len(m.body)))
+	})
+}
+
+// --------------------------------------------------------------------------- Pager
+
+// pagerCase: a table of 1-3 columns of plain cells with 1-2 header rows, 0-7 body rows and
+// 0-1 footer rows; the page size, set on the table or given to Pager (half of the time each);
+// the page GoTo is asked for (by position, taken to -1 .. pages+2); and the size of a second
+// pager on the same table.
+type pagerCase struct {
+	spec   *tableSpec
+	size   int
+	viaSet bool
+	goTo   int
+	size2  int
+}
+
+func (c pagerCase) GoString() string {
+	how := "Pager(PageSize(%d))"
+	if c.viaSet {
+		how = "SetPageSize(%d); Pager()"
+	}
+	return fmt.Sprintf("%s\n"+how+", GoTo position %d, second pager of %d", c.spec, c.size, c.goTo, c.size2)
+}
+
+var pagerCases = hegel.Composite(func(tc hegel.TestCase) pagerCase {
+	ncols := hegel.Draw(tc, hegel.Integers(1, 3))
+	s := &tableSpec{mergeRow: -1, ncols: ncols}
+	s.header = hegel.Draw(tc, rowLists(plainCells, 1, ncols, 1, 2))
+	s.body = hegel.Draw(tc, rowLists(plainCells, 1, ncols, 0, 7))
+	s.footer = hegel.Draw(tc, rowLists(plainCells, 1, ncols, 0, 1))
+	return pagerCase{
+		spec:   s,
+		size:   hegel.Draw(tc, hegel.Integers(1, 4)),
+		viaSet: hegel.Draw(tc, chance(50)),
+		goTo:   hegel.Draw(tc, positions),
+		size2:  hegel.Draw(tc, hegel.Integers(1, 8)),
+	}
+})
+
+// TestHegelTablePager: the pages of Pager(): their number, their lines, the navigation, and
+// the whole rendering re-joined.
+func TestHegelTablePager(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pagerCases)
+		s, size := c.spec, c.size
+		tw := s.build()
+		var p table.Pager
+		if c.viaSet {
+			tw.SetPageSize(size)
+			p = tw.Pager()
+		} else {
+			p = tw.Pager(table.PageSize(size))
+		}
+		n := len(s.body)
+		wantPages := (n + size - 1) / size
+		if wantPages == 0 {
+			wantPages = 1
+		}
+		if p.Location() != 1 {
+			fail(ht, "Pager().Location() = %d, want 1", p.Location())
+			return
+		}
+		var pages []string
+		for {
+			pages = append(pages, p.Render())
+			loc := p.Location()
+			if p.Next(); p.Location() == loc {
+				break
+			}
+		}
+		if len(pages) != wantPages {
+			fail(ht, "%d pages for %d rows of page size %d, want %d:\n%s", len(pages), n, size, wantPages, strings.Join(pages, "\n=====\n"))
+			return
+		}
+		full := tw.Render()
+		if joined := strings.Join(pages, tw.Style().Box.PageSeparator); joined != full {
+			fail(ht, "pages joined:\n%s\nRender():\n%s", joined, full)
+			return
+		}
+		overhead := 1 + len(s.header) + 1 + 1 + len(s.footer)
+		if len(s.footer) > 0 && n > 0 {
+			overhead++ // the footer's separator
+		}
+		for i, pg := range pages {
+			rows := size
+			if i == len(pages)-1 {
+				rows = n - size*i
+			}
+			want := overhead + rows
+			if i > 0 {
+				want++ // the page separator's leading newline
+			}
+			if got := strings.Count(pg, "\n") + 1; got != want {
+				fail(ht, "page %d has %d lines, want %d:\n%s", i+1, got, want, pg)
+				return
+			}
+		}
+		// navigation
+		k := -1 + c.goTo%(wantPages+4)
+		wantK := k
+		if wantK < 1 {
+			wantK = 1
+		}
+		if wantK > wantPages {
+			wantK = wantPages
+		}
+		if got := p.GoTo(k); got != pages[wantK-1] || p.Location() != wantK {
+			fail(ht, "GoTo(%d) of %d pages = page %d %q, want page %d", k, wantPages, p.Location(), got, wantK)
+			return
+		}
+		if got := p.Prev(); wantK > 1 && (got != pages[wantK-2] || p.Location() != wantK-1) || wantK == 1 && p.Location() != 1 {
+			fail(ht, "Prev() from page %d = page %d", wantK, p.Location())
+			return
+		}
+		// a second pager on the same table starts at its first page
+		if !Known.pagerStale || wantPages == 1 {
+			size2 := c.size2
+			func() {
+				defer func() {
+					if r := recover(); r != nil {
+						fail(ht, "Pager(PageSize(%d)) after a pager of size %d at page %d: %v", size2, size, p.Location(), r)
+					}
+				}()
+				p2 := tw.Pager(table.PageSize(size2))
+				if p2.Location() != 1 {
+					fail(ht, "Pager(PageSize(%d)).Location() = %d after a pager of size %d, want 1", size2, p2.Location(), size)
+					return
+				}
+				p2.Render()
+			}()
+		}
+		count(ht, fmt.Sprintf("pages=%d", wantPages))
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..6459cef
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,263 @@
+package hegel
+
+// Hegel property tests for jedib0t/go-pretty's text, table and list packages, written for the
+// Hegel zoo. See targets/go/go-pretty/README.md.
+//
+// Oracle: a model of the documented behaviour of the text utilities over strings holding ANSI
+// escape sequences: a scanner for CSI and OSC sequences (ECMA-48: a CSI ends at its final byte,
+// an OSC at BEL or ESC \), the visible text and its display width (text.RuneWidth per rune),
+// an SGR state (foreground, background, attributes) tracked through the sequences, and the
+// documented rules of Trim/Snip/Pad/RepeatAndTrim, InsertEveryN, ProcessCRLF, Align, VAlign,
+// Format, Escape, the wrap functions (line widths, words, escape state per visible rune) and
+// the transformers. For the table package a row model and exact renderings built on it.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). Every property draws one case record (with a GoString for the draw
+// report) from generators that are package-level values; the case is rendered by pure functions.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+var (
+	countsMu sync.Mutex
+	counts   = map[string]int{}
+)
+
+// count tallies the shapes of each property so a run shows how often the Known gates fire and
+// which shapes were reached (printed with -v as COUNTS).
+func count(_ *hegel.T, label string) {
+	countsMu.Lock()
+	counts[label]++
+	countsMu.Unlock()
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	defer func() {
+		countsMu.Lock()
+		defer countsMu.Unlock()
+		if len(counts) > 0 {
+			t.Logf("COUNTS %s: %v", t.Name(), counts)
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// fail is the properties' spelling of a failed check.
+func fail(ht *hegel.T, format string, args ...any) { ht.Fatalf(format, args...) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time. WeightedBooleans shrinks toward
+// false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// asAny is g as a generator of any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// runeStrings is a string of lo to hi runes of g (a weighted pool; for a plain alphabet use
+// hegel.Text().Alphabet, which is a set).
+func runeStrings(g hegel.Generator[rune], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(many(g, lo, hi), func(rs []rune) string { return string(rs) })
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// nonNil makes an empty slice a non-nil one (Lists yields nil for zero elements).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+// at is xs[i mod len(xs)]: a drawn position applied to live data.
+func at[T any](xs []T, i int) T { return xs[i%len(xs)] }
+
+// --------------------------------------------------------------------------- known bugs
+
+// switches are the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch
+// is on; the pins assert the documented behaviour and fail while the bug exists.
+type switches struct {
+	csiOnlyM             bool // 1: a CSI sequence is terminated only by m; cursor and erase sequences swallow the text after them
+	oscBelOnly8          bool // 2: an OSC sequence terminated by BEL is recognised only for OSC 8
+	formatCSIOnly        bool // 3: Format.Apply ends every sequence at m, so hyperlinks are case-changed
+	escapeEmptySeq       bool // 4: Escape(str, "") removes every reset sequence from str
+	wrapStaleReset       bool // 5: a word whose sequences empty the state (a reset) leaves the earlier sequence to be re-opened on later lines
+	wrapWordSequenceRaw  bool // 6: a hard-wrapped word restarts its lines with the raw sequence found in the word, not the state
+	wrapHyperlink        bool // 7, 8: an OSC 8 hyperlink is parsed as SGR codes (conceal) and its word is not wrapped
+	truecolor            bool // 9: 38;2;r;g;b is parsed as five attribute codes
+	colorsSorted         bool // 10: Sequence() emits colours in numeric order, not the last set
+	concealOff           bool // 11: code 28 (conceal off) is not applied
+	numberNegFormat      bool // 12: negatives are formatted as "-" + format of -val (widths, MinInt64)
+	timeEpochEmpty       bool // 13: times at or before the Unix epoch render as ""
+	unixInt64Only        bool // 14: NewUnixTimeTransformer formats only int64 and string values
+	autoAlignRaw         bool // 15: AlignAuto parses the number from the raw text, escape sequences included
+	titleUpper           bool // 16: FormatTitle upper-cases instead of title-casing
+	repeatTrimWidth      bool // 17: RepeatAndTrim counts runes to repeat but trims by display width
+	snipNoPad            bool // 18: Snip does not pad and exceeds the length with a wide indicator
+	crlfEscapeColumns    bool // 19: ProcessCRLF overwrites columns with the runes of escape sequences
+	wrapBoundaryState    bool // 20: the escape state is dropped at a paragraph break (WrapHard/WrapSoft) and a line break (WrapText)
+	wrapWideOverflow     bool // 21: a wide rune straddling the width is appended, making the line one column too wide
+	justifyNegativePanic bool // 22: AlignJustify.Apply panics on a blank text and a negative length
+	codesOutOfOrder      bool // 23: the parser applies 256-colour codes before the other codes of the same sequence
+	escapeStripsPair     bool // 24: Escape removes the input's own seq+reset pair, leaving the output open
+	// table
+	emptyRow             bool // 25, 26: an empty row gets one field too many in CSV/TSV, and is dropped by Render and RenderHTML
+	markdownPadRaw       bool // 27: PadContent pads by the raw width, before | and newlines are escaped
+	markdownBackslash    bool // 28: backslashes are not escaped, so a GFM parser consumes them before punctuation
+	numericSortAbandoned bool // 29: a numeric sort with a non-numeric cell leaves the numeric cells unordered
+	sortDuplicateKeys    bool // 30: duplicate sort instructions on a column are applied, not discarded
+	sortNameTransformed  bool // 31: SortBy.Name is matched against the header after its transformer
+	filterEqualString    bool // 32: Equal/NotEqual compare strings, not numbers
+	filterShortRow       bool // 33: a filter on a column the row lacks excludes the row for every operator
+	lengthStale          bool // 34: Length() counts the filter of the previous render
+	rowConfigPosition    bool // 35: RowConfig follows the row's position after sorting and filtering
+	widthMinCapped       bool // 36: Size.WidthMin sizes the title even when capped columns cannot fill it
+	widthMaxTiny         bool // 37: Size.WidthMax not above the UnfinishedRow width renders nothing
+	importGridEmptyRow   bool // 38: ImportGrid turns an empty inner row into a one-cell row "[]"
+	pagerStale           bool // 39: Pager() keeps the previous pager's page; Next/Render panic past the new page count
+	suppressFirstCell    bool // 40: SuppressEmptyColumns decides on the first non-empty cell alone: unprintable there hides the column
+	titleWidthMin        bool // 41: the title is sized by Size.WidthMin even beyond Size.WidthMax
+	mergePanic           bool // 42: Render panics (divide by zero) re-balancing a merged cell wider than its columns
+	autoIndexHeaderWidth bool // 43: the auto-index header row (A, B, ..) is not counted in the column widths
+	footerOnlyBorder     bool // 44: a table of footer rows alone gets an empty top border
+	csvLoneEmptyField    bool // 45: a row of one empty cell is written as an empty line, which CSV readers skip
+}
+
+// Known is every switch on (the bugs are open). It is a package variable built by a function,
+// so that the package-level generators that read it are initialised after it (Go orders the
+// initialisation of package variables by dependency).
+var Known = loadKnown()
+
+// loadKnown turns every switch on, then off those named in ZOO_KNOWN_OFF=name,name (to check
+// that the model then disagrees with the package on them; never set in the zoo's runs).
+func loadKnown() switches {
+	var k switches
+	v := reflect.ValueOf(&k).Elem()
+	for i := 0; i < v.NumField(); i++ {
+		reflect.NewAt(v.Field(i).Type(), unsafe.Pointer(v.Field(i).UnsafeAddr())).Elem().SetBool(true)
+	}
+	if off := os.Getenv("ZOO_KNOWN_OFF"); off != "" {
+		for _, name := range strings.Split(off, ",") {
+			f := v.FieldByName(name)
+			if !f.IsValid() {
+				panic("ZOO_KNOWN_OFF: no switch " + name)
+			}
+			reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+		}
+	}
+	return k
+}
diff --git a/hegel/hegel_transform_test.go b/hegel/hegel_transform_test.go
new file mode 100644
index 0000000..4667d84
--- /dev/null
+++ b/hegel/hegel_transform_test.go
@@ -0,0 +1,273 @@
+package hegel
+
+// The transformers: numbers (format and sign colours), times and unix times.
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+var safeIntFormats = []string{"%d", "%v", "%x"}
+var safeFloatFormats = []string{"%v", "%.2f", "%g"}
+var wideIntFormats = []string{"%5d", "%05d", "%+d", "%-6d|", "%8v"}
+var wideFloatFormats = []string{"%8.2f", "%+.1f", "%-9.3f|"}
+
+// --------------------------------------------------------------------------- numbers
+
+var (
+	small300 = hegel.Integers(-300, 300)
+	pos300   = hegel.Integers(0, 300)
+	// signedWidths: a small magnitude in every signed width.
+	signedWidths = hegel.OneOf(
+		asAny(small300),
+		asAny(hegel.Map(small300, func(n int) int8 { return int8(n / 3) })),
+		asAny(hegel.Map(small300, func(n int) int16 { return int16(n) })),
+		asAny(hegel.Map(small300, func(n int) int32 { return int32(n) })),
+		asAny(hegel.Map(small300, func(n int) int64 { return int64(n) })),
+	)
+	unsignedWidths = hegel.OneOf(
+		asAny(hegel.Map(pos300, func(n int) uint { return uint(n) })),
+		asAny(hegel.Map(pos300, func(n int) uint8 { return uint8(n % 256) })),
+		asAny(hegel.Map(pos300, func(n int) uint16 { return uint16(n) })),
+		asAny(hegel.Map(pos300, func(n int) uint32 { return uint32(n) })),
+		asAny(hegel.Map(pos300, func(n int) uint64 { return uint64(n) })),
+	)
+	// unsignedNumbers: the unsigned widths, and MinInt64 three times in ten while the sign
+	// bug's switch is off (go-pretty/12: -MinInt64 overflows).
+	unsignedNumbers = func() hegel.Generator[any] {
+		if Known.numberNegFormat {
+			return unsignedWidths
+		}
+		return weighted(choice[any]{70, unsignedWidths}, choice[any]{30, hegel.Just[any](int64(math.MinInt64))})
+	}()
+	eighths = hegel.Map(hegel.Integers(-3000, 3000), func(n int) float64 { return float64(n) / 8 })
+	floats  = weighted(
+		choice[any]{70, asAny(eighths)},
+		choice[any]{30, asAny(hegel.Map(eighths, func(f float64) float32 { return float32(f) }))},
+	)
+	edgeFloats = hegel.SampledFrom([]float64{0, math.Copysign(0, -1), 0.001, -0.001, 1e21, -1e-7})
+	// numbers: a value of every numeric kind (as any): a small int twice in six, a signed
+	// width, an unsigned width, a float, an edge float.
+	numbers = weighted(
+		choice[any]{2, asAny(hegel.Integers(-100, 100))},
+		choice[any]{1, signedWidths},
+		choice[any]{1, unsignedNumbers},
+		choice[any]{1, floats},
+		choice[any]{1, asAny(edgeFloats)},
+	)
+)
+
+// normalized: the value as the package converts it (int64, uint64 or float64).
+func normalized(v any) any {
+	switch x := v.(type) {
+	case int:
+		return int64(x)
+	case int8:
+		return int64(x)
+	case int16:
+		return int64(x)
+	case int32:
+		return int64(x)
+	case uint:
+		return uint64(x)
+	case uint8:
+		return uint64(x)
+	case uint16:
+		return uint64(x)
+	case uint32:
+		return uint64(x)
+	case float32:
+		return float64(x)
+	}
+	return v
+}
+
+// signOf: -1, 0 or 1 for the normalized value.
+func signOf(nv any) int {
+	switch x := nv.(type) {
+	case int64:
+		switch {
+		case x < 0:
+			return -1
+		case x > 0:
+			return 1
+		}
+	case uint64:
+		if x > 0 {
+			return 1
+		}
+	case float64:
+		switch {
+		case x < 0:
+			return -1
+		case x > 0:
+			return 1
+		}
+	}
+	return 0
+}
+
+// formatsFor: the formats a number may be printed with: the width-free ones, and the ones
+// with widths and flags while the sign bug's switch is off (go-pretty/12).
+func formatsFor(v any) []string {
+	_, isFloat := normalized(v).(float64)
+	safe, wide := safeIntFormats, wideIntFormats
+	if isFloat {
+		safe, wide = safeFloatFormats, wideFloatFormats
+	}
+	if Known.numberNegFormat {
+		return safe
+	}
+	return append(append([]string{}, safe...), wide...)
+}
+
+// --------------------------------------------------------------------------- times
+
+var (
+	layouts    = hegel.SampledFrom([]string{time.RFC3339, "2006-01-02", time.Kitchen, time.RFC1123})
+	locations  = hegel.SampledFrom([]*time.Location{time.UTC, time.FixedZone("X", 5*3600+1800), nil})
+	strLayouts = hegel.SampledFrom([]string{time.RFC3339, time.RFC3339Nano, "2006-01-02T15:04:05.000Z07:00"})
+	units      = hegel.SampledFrom([]int64{1, 1000, 1000000, 1000000000})
+	// seconds: a Unix second count; after the epoch while go-pretty/13 is open.
+	seconds = func() hegel.Generator[int64] {
+		if Known.timeEpochEmpty {
+			return hegel.Integers[int64](1, 4000000000)
+		}
+		return hegel.Integers[int64](-2000000000, 4000000000)
+	}()
+	// unixKinds: the Go type a unix time is given as; an int only while go-pretty/14 is closed.
+	unixKinds = func() hegel.Generator[string] {
+		kinds := []string{"int64", "string"}
+		if !Known.unixInt64Only {
+			kinds = append(kinds, "int")
+		}
+		return hegel.SampledFrom(kinds)
+	}()
+)
+
+// transformCase: a number and its format; a time (seconds and milliseconds), the layout and
+// location of the time transformers, the layout of the string form given to the time
+// transformer; the unit and Go type of the unix time.
+type transformCase struct {
+	v         any
+	format    string
+	layout    string
+	loc       *time.Location
+	secs, ms  int64
+	strLayout string
+	unit      int64
+	unixKind  string
+}
+
+func (c transformCase) GoString() string {
+	return fmt.Sprintf("%T %v with %q; time %d.%03d layout %q in %v (string form %q); unix x%d as %s", c.v, c.v, c.format, c.secs, c.ms, c.layout, c.loc, c.strLayout, c.unit, c.unixKind)
+}
+
+var transformCases = hegel.Composite(func(tc hegel.TestCase) transformCase {
+	v := hegel.Draw(tc, numbers)
+	return transformCase{
+		v:         v,
+		format:    hegel.Draw(tc, hegel.SampledFrom(formatsFor(v))),
+		layout:    hegel.Draw(tc, layouts),
+		loc:       hegel.Draw(tc, locations),
+		secs:      hegel.Draw(tc, seconds),
+		ms:        hegel.Draw(tc, hegel.Integers[int64](0, 999)),
+		strLayout: hegel.Draw(tc, strLayouts),
+		unit:      hegel.Draw(tc, units),
+		unixKind:  hegel.Draw(tc, unixKinds),
+	}
+})
+
+func TestHegelTransform(t *testing.T) {
+	text.EnableColors()
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, transformCases)
+		v, format := c.v, c.format
+		nv := normalized(v)
+		sign := signOf(nv)
+		plain := fmt.Sprintf(format, nv)
+		var want string
+		switch sign {
+		case -1:
+			want = text.Colors{text.FgHiRed}.Sprint(plain)
+		case 1:
+			want = text.Colors{text.FgHiGreen}.Sprint(plain)
+		default:
+			want = plain
+		}
+		if got := text.NewNumberTransformer(format)(v); got != want {
+			fail(ht, "NewNumberTransformer(%q)(%T %v) = %q, want %q", format, v, v, got, want)
+			return
+		}
+		if got := text.NewNumberTransformer(format)("x" + plain); got != "x"+plain {
+			fail(ht, "NewNumberTransformer(%q)(%q) = %q", format, "x"+plain, got)
+			return
+		}
+		// times
+		layout, loc := c.layout, c.loc
+		tm := time.Unix(c.secs, c.ms*1000000).UTC()
+		wantT := tm
+		if loc != nil {
+			wantT = tm.In(loc)
+		}
+		tt := text.NewTimeTransformer(layout, loc)
+		if got := tt(tm); got != wantT.Format(layout) {
+			fail(ht, "NewTimeTransformer(%q, %v)(%v) = %q, want %q", layout, loc, tm, got, wantT.Format(layout))
+			return
+		}
+		// a string in an RFC3339 form is parsed and reformatted
+		tstr := tm.Format(c.strLayout)
+		parsed, _ := time.Parse(c.strLayout, tstr)
+		wantP := parsed
+		if loc != nil {
+			wantP = parsed.In(loc)
+		}
+		if got := tt(tstr); got != wantP.Format(layout) {
+			fail(ht, "NewTimeTransformer(%q, %v)(%q) = %q, want %q", layout, loc, tstr, got, wantP.Format(layout))
+			return
+		}
+		if got := tt(12345); got != "12345" {
+			fail(ht, "NewTimeTransformer(%q, %v)(12345) = %q", layout, loc, got)
+			return
+		}
+		// unix times in seconds, milliseconds, microseconds or nanoseconds
+		usecs := c.secs * c.unit
+		// the documented unit detection: ten seconds' worth in each unit
+		dec := usecs
+		switch {
+		case dec >= 10*1000000000*1000000:
+			dec /= 1000000000
+		case dec >= 10*1000000000*1000:
+			dec /= 1000000
+		case dec >= 10*1000000000:
+			dec /= 1000
+		}
+		var uval any = usecs
+		switch c.unixKind {
+		case "string":
+			uval = strconv.FormatInt(usecs, 10)
+		case "int":
+			uval = int(usecs)
+		}
+		wantU := time.Unix(dec, 0)
+		if loc != nil {
+			wantU = wantU.In(loc)
+		}
+		wantUS := wantU.Format(layout)
+		if dec <= 0 && Known.timeEpochEmpty {
+			wantUS = ""
+		}
+		if got := text.NewUnixTimeTransformer(layout, loc)(uval); got != wantUS {
+			fail(ht, "NewUnixTimeTransformer(%q, %v)(%T %v) = %q, want %q", layout, loc, uval, uval, got, wantUS)
+			return
+		}
+		_, isFloat := nv.(float64)
+		count(ht, fmt.Sprintf("sign=%d float=%v", sign, isFloat))
+	})
+}
diff --git a/hegel/hegel_wrap_test.go b/hegel/hegel_wrap_test.go
new file mode 100644
index 0000000..0e6aca0
--- /dev/null
+++ b/hegel/hegel_wrap_test.go
@@ -0,0 +1,233 @@
+package hegel
+
+// WrapHard, WrapSoft and WrapText: line widths, the visible content, and the escape state of
+// every visible rune.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+// wrapWord: the separator before the word, a sequence before it, the word (a hyperlink when
+// link is set, else the plain word, with a sequence inside it when inner is set), and a reset
+// after it.
+type wrapWord struct {
+	sep   string
+	sgr   sgrSeq
+	word  string
+	link  string
+	inner *innerSeq
+	reset bool
+}
+
+// wrapSpec: paragraphs of lines of words, and a final reset.
+type wrapSpec struct {
+	paras [][][]wrapWord
+	reset bool
+}
+
+// render is the text: paragraphs joined by a blank line and lines by a line break (by spaces
+// while a state is open under Known.wrapBoundaryState), the sequences spelled against the
+// state in force (without resets under Known.wrapStaleReset; as the whole state under
+// Known.wrapWordSequenceRaw).
+func (w wrapSpec) render() string {
+	var b strings.Builder
+	var st sgr
+	open := func() bool { return Known.wrapBoundaryState && st != (sgr{}) }
+	for p, para := range w.paras {
+		if p > 0 {
+			if open() {
+				b.WriteString("  ")
+			} else {
+				b.WriteString("\n\n")
+			}
+		}
+		for l, line := range para {
+			if l > 0 {
+				if open() {
+					b.WriteString(" ")
+				} else {
+					b.WriteString("\n")
+				}
+			}
+			for i, wd := range line {
+				if i > 0 {
+					b.WriteString(wd.sep)
+				}
+				if wd.sgr != nil {
+					b.WriteString(spellSGR(wd.sgr, &st, sgrOpts{noReset: Known.wrapStaleReset, fullState: Known.wrapWordSequenceRaw}))
+				}
+				word := wd.word
+				switch {
+				case wd.link != "":
+					word = wd.link
+				case wd.inner != nil:
+					word = splice(word, *wd.inner, &st, sgrOpts{noReset: Known.wrapStaleReset})
+				}
+				b.WriteString(word)
+				if wd.reset {
+					b.WriteString(esc + "[0m")
+					st = sgr{}
+				}
+			}
+		}
+	}
+	if w.reset {
+		b.WriteString(esc + "[0m")
+	}
+	return b.String()
+}
+
+var (
+	wrapSeps = hegel.SampledFrom([]string{" ", " ", "  ", "\t"})
+	// wrapLinks: a hyperlink as the word three times in twenty while go-pretty/7-8's switch is
+	// off; wrapInners: a sequence inside the word one time in five while go-pretty/6's is off;
+	// wrapResets: a reset after the word one time in five while go-pretty/5's is off.
+	wrapLinks = func() hegel.Generator[string] {
+		if Known.wrapHyperlink {
+			return hegel.Just("")
+		}
+		return maybe(15, hyperlinks)
+	}()
+	wrapInners = func() hegel.Generator[*innerSeq] {
+		if Known.wrapWordSequenceRaw {
+			return hegel.Just[*innerSeq](nil)
+		}
+		return optional(20, innerSeqs)
+	}()
+	wrapResets = func() hegel.Generator[bool] {
+		if Known.wrapStaleReset {
+			return hegel.Just(false)
+		}
+		return chance(20)
+	}()
+	// wrapWords: a word with a sequence before it seven times in twenty.
+	wrapWords = hegel.Composite(func(tc hegel.TestCase) wrapWord {
+		return wrapWord{
+			sep:   hegel.Draw(tc, wrapSeps),
+			sgr:   hegel.Draw(tc, maybe(35, sgrSeqs)),
+			word:  hegel.Draw(tc, words),
+			link:  hegel.Draw(tc, wrapLinks),
+			inner: hegel.Draw(tc, wrapInners),
+			reset: hegel.Draw(tc, wrapResets),
+		}
+	})
+	// wrapTexts: one or two paragraphs of one or two lines of up to six words, with a final
+	// reset two times in five.
+	wrapSpecs = hegel.Composite(func(tc hegel.TestCase) wrapSpec {
+		return wrapSpec{
+			paras: hegel.Draw(tc, many(many(many(wrapWords, 0, 6), 1, 2), 1, 2)),
+			reset: hegel.Draw(tc, chance(40)),
+		}
+	})
+	wrapTexts = hegel.Map(wrapSpecs, wrapSpec.render)
+)
+
+// nonSpaceStates: the visible non-whitespace runes with their SGR state.
+func nonSpaceStates(s string) []runeState {
+	var out []runeState
+	for _, rs := range visibleStates(s) {
+		if !unicode.IsSpace(rs.r) {
+			out = append(out, rs)
+		}
+	}
+	return out
+}
+
+type wrapFn struct {
+	name string
+	fn   func(string, int) string
+}
+
+var wrapFns = []wrapFn{{"WrapHard", text.WrapHard}, {"WrapSoft", text.WrapSoft}, {"WrapText", text.WrapText}}
+
+// wrapCase: the text, the width, and the wrap function (by index).
+type wrapCase struct {
+	s  string
+	n  int
+	fn int
+}
+
+func (c wrapCase) GoString() string { return fmt.Sprintf("%s(%q, %d)", wrapFns[c.fn].name, c.s, c.n) }
+
+var wrapCases = hegel.Composite(func(tc hegel.TestCase) wrapCase {
+	return wrapCase{
+		s:  hegel.Draw(tc, wrapTexts),
+		n:  hegel.Draw(tc, hegel.Integers(1, 12)),
+		fn: hegel.Draw(tc, hegel.Integers(0, len(wrapFns)-1)),
+	}
+})
+
+func TestHegelWrap(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wrapCases)
+		s, n, f := c.s, c.n, wrapFns[c.fn]
+		out := f.fn(s, n)
+		expanded := strings.ReplaceAll(s, "\t", "    ")
+		wrapped := widthOf(expanded) > n
+		// widths: every line fits, unless it is a single rune wider than the width
+		for _, line := range strings.Split(out, "\n") {
+			if w := widthOf(line); w > n {
+				vis := strings.TrimRight(visible(line), " ")
+				rs := []rune(vis)
+				if len(rs) == 1 && text.RuneWidth(rs[0]) > n {
+					continue
+				}
+				if Known.wrapWideOverflow && widthOfPlain(vis) == n+1 && len(rs) > 0 && text.RuneWidth(rs[len(rs)-1]) == 2 {
+					continue // the package appends a wide rune that straddles the width
+				}
+				fail(ht, "%s(%q, %d) = %q: line %q has width %d", f.name, s, n, out, line, w)
+				return
+			}
+		}
+		// content: the visible non-whitespace runes, in order, with their escape state
+		in, got := nonSpaceStates(expanded), nonSpaceStates(out)
+		if len(in) != len(got) {
+			fail(ht, "%s(%q, %d) = %q: %d visible runes, want %d", f.name, s, n, out, len(got), len(in))
+			return
+		}
+		for i := range in {
+			if in[i].r != got[i].r {
+				fail(ht, "%s(%q, %d) = %q: rune %d is %q, want %q", f.name, s, n, out, i, got[i].r, in[i].r)
+				return
+			}
+			if in[i].st != got[i].st {
+				fail(ht, "%s(%q, %d) = %q: rune %d %q in state %s, want %s", f.name, s, n, out, i, got[i].r, got[i].st, in[i].st)
+				return
+			}
+		}
+		// a wrapped output does not leave a state open
+		if wrapped && stateAfter(out) != (sgr{}) {
+			fail(ht, "%s(%q, %d) = %q ends in state %s", f.name, s, n, out, stateAfter(out))
+			return
+		}
+		// WrapSoft keeps words that fit whole
+		if f.name == "WrapSoft" {
+			words := strings.Fields(visible(strings.ReplaceAll(s, "\t", " ")))
+			fits := true
+			for _, w := range words {
+				if widthOfPlain(w) > n {
+					fits = false
+				}
+			}
+			if fits {
+				gw := strings.Fields(visible(out))
+				if strings.Join(gw, "\x00") != strings.Join(words, "\x00") {
+					fail(ht, "WrapSoft(%q, %d) = %q: words %q, want %q", s, n, out, gw, words)
+					return
+				}
+			}
+		}
+		// a string that fits is returned as it is (tabs expanded)
+		if !wrapped && out != expanded {
+			fail(ht, "%s(%q, %d) = %q, want the input", f.name, s, n, out)
+			return
+		}
+		count(ht, fmt.Sprintf("%s lines=%d", f.name, strings.Count(out, "\n")+1))
+	})
+}
