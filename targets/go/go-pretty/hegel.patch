+			t.Fatalf("Render() with WidthMax 12 =\n%s\nline %d has width %d", out, i, w)
+		}
+	}
+}
+
+func TestHegelPinMergePanic(t *testing.T) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Render() with a merged cell wider than its columns: %v", r)
+		}
+	}()
+	tw := table.NewWriter()
+	tw.AppendHeader(table.Row{"abc", "def"})
+	tw.AppendRow(table.Row{"12345678", "12345678"}, table.RowConfig{AutoMerge: true})
+	if out := tw.Render(); !strings.Contains(out, "12345678") {
+		t.Fatalf("Render() =\n%s\nlacks the merged cell", out)
+	}
+}
+
+func TestHegelPinAutoIndexHeaderWidth(t *testing.T) {
