+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..fe83f5f
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,654 @@
+package hegel
+
+// Properties of the string utilities: widths, StripEscape, Trim/Snip/Pad/RepeatAndTrim, Widen,
+// InsertEveryN, ProcessCRLF, Align, VAlign, Format, Escape and the escape sequence parser.
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"golang.org/x/text/width"
+	"hegel.dev/go/hegel"
+	"testing"
+)
+
+// --------------------------------------------------------------------------- widths and trims
+
+// modelTrim: the visible runes that fit in maxLen columns, every escape sequence kept.
+func modelTrim(s string, maxLen int) string {
+	if maxLen <= 0 {
+		return ""
+	}
+	var b strings.Builder
+	w, full := 0, false
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if full {
+			continue
+		}
+		rw := text.RuneWidth(t.r)
+		if w+rw <= maxLen {
+			w += rw
+			b.WriteRune(t.r)
+		} else {
+			full = true
+		}
+	}
+	return b.String()
+}
+
+// modelSnip: the documented "fixed length": trimmed to length minus the indicator when wider,
+// otherwise (the doc's example) padded to the length. Under Known.snipNoPad the package's
+// formula: no padding, and the indicator appended whatever its width.
+func modelSnip(s string, length int, ind string) string {
+	if length <= 0 {
+		return s
+	}
+	ws := widthOf(s)
+	if Known.snipNoPad {
+		if ws > length {
+			return modelTrim(s, length-widthOf(ind)) + ind
+		}
+		return s
+	}
+	if ws > length {
+		if widthOf(ind) >= length {
+			return modelTrim(ind, length)
+		}
+		return modelTrim(s, length-widthOf(ind)) + ind
+	}
+	return s + strings.Repeat(" ", length-ws)
+}
+
+// modelRepeatAndTrim: the documented result has maxRunes runes; under Known.repeatTrimWidth the
+// package's formula (repeat by rune count, trim by display width).
+func modelRepeatAndTrim(s string, maxRunes int) string {
+	if s == "" || maxRunes <= 0 {
+		return ""
+	}
+	rc := utf8.RuneCountInString(s)
+	if Known.repeatTrimWidth {
+		if maxRunes == rc {
+			return s
+		}
+		return modelTrim(strings.Repeat(s, maxRunes/rc+1), maxRunes)
+	}
+	rep := strings.Repeat(s, maxRunes/rc+1)
+	var b strings.Builder
+	n := 0
+	for _, t := range scan(rep) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if n == maxRunes {
+			break
+		}
+		b.WriteRune(t.r)
+		n++
+	}
+	return b.String()
+}
+
+func TestHegelWidth(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := genText(ht, textOpts{newlines: true, tabs: true, sequences: true, other: true, spaces: true})
+		vis := visible(s)
+		if got := text.StripEscape(s); got != vis {
+			c.failClass(ht, "StripEscape", "StripEscape(%q) = %q, want %q", s, got, vis)
+			return
+		}
+		w := widthOfPlain(vis)
+		if got := text.StringWidthWithoutEscSequences(s); got != w {
+			c.failClass(ht, "StringWidth", "StringWidthWithoutEscSequences(%q) = %d, want %d", s, got, w)
+			return
+		}
+		if got := text.RuneCount(s); got != w {
+			c.failClass(ht, "RuneCount", "RuneCount(%q) = %d, want %d", s, got, w)
+			return
+		}
+		longest := 0
+		for _, line := range strings.Split(vis, "\n") {
+			if lw := widthOfPlain(line); lw > longest {
+				longest = lw
+			}
+		}
+		if got := text.LongestLineLen(s); got != longest {
+			c.failClass(ht, "LongestLineLen", "LongestLineLen(%q) = %d, want %d", s, got, longest)
+			return
+		}
+		n := drawInt(ht, -1, 12)
+		if got, want := text.Trim(s, n), modelTrim(s, n); got != want {
+			c.failClass(ht, "Trim", "Trim(%q, %d) = %q, want %q", s, n, got, want)
+			return
+		}
+		pc := pick(ht, []rune{' ', '.', '-'})
+		want := s
+		if w < n {
+			want = s + strings.Repeat(string(pc), n-w)
+		}
+		if got := text.Pad(s, n, pc); got != want {
+			c.failClass(ht, "Pad", "Pad(%q, %d, %q) = %q, want %q", s, n, pc, got, want)
+			return
+		}
+		ind := pick(ht, []string{"~", "...", "…", "", esc + "[31m~" + esc + "[0m", "……"})
+		if Known.snipNoPad && widthOf(ind) >= n {
+			ind = "~"
+		}
+		if got, want := text.Snip(s, n, ind), modelSnip(s, n, ind); got != want {
+			c.failClass(ht, "Snip", "Snip(%q, %d, %q) = %q, want %q", s, n, ind, got, want)
+			return
+		}
+		// Widen: every visible rune widened, sequences untouched
+		var wb strings.Builder
+		for _, tk := range scan(s) {
+			if tk.esc != "" {
+				wb.WriteString(tk.esc)
+			} else {
+				wb.WriteString(width.Widen.String(string(tk.r)))
+			}
+		}
+		if got := text.Widen(s); got != wb.String() {
+			c.failClass(ht, "Widen", "Widen(%q) = %q, want %q", s, got, wb.String())
+			return
+		}
+		// RepeatAndTrim on a short string
+		rs := genText(ht, textOpts{sequences: !Known.repeatTrimWidth})
+		if Known.repeatTrimWidth {
+			rs = strings.Map(func(r rune) rune {
+				if text.RuneWidth(r) != 1 {
+					return 'x'
+				}
+				return r
+			}, rs)
+		}
+		m := drawInt(ht, -1, 12)
+		if got, want := text.RepeatAndTrim(rs, m), modelRepeatAndTrim(rs, m); got != want {
+			c.failClass(ht, "RepeatAndTrim", "RepeatAndTrim(%q, %d) = %q, want %q", rs, m, got, want)
+			return
+		}
+		switch {
+		case len(escapes(s)) > 0:
+			c.count("with sequences")
+		default:
+			c.count("plain")
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- InsertEveryN, ProcessCRLF
+
+// modelInsertEveryN: the rune before every visible rune that would start beyond the N-th column
+// of its line; the count restarts at \r and \n; sequences pass through.
+func modelInsertEveryN(s string, r rune, n int) string {
+	if n <= 0 {
+		return s
+	}
+	var b strings.Builder
+	lineLen := 0
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		if t.r == '\n' || t.r == '\r' {
+			lineLen = 0
+		} else if w := text.RuneWidth(t.r); w > 0 {
+			if lineLen >= n {
+				b.WriteRune(r)
+				lineLen = 0
+			}
+			lineLen += w
+		}
+		b.WriteRune(t.r)
+	}
+	return b.String()
+}
+
+// modelProcessCRLF: \r\n is \n; a lone \r moves the cursor to the start of the line and the
+// following runes overwrite. Under Known.crlfEscapeColumns the runes of escape sequences take
+// columns too (the package's rune loop); otherwise sequences pass through without a column.
+func modelProcessCRLF(s string) string {
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	lines := strings.Split(s, "\n")
+	for li, line := range lines {
+		if !strings.Contains(line, "\r") {
+			continue
+		}
+		if Known.crlfEscapeColumns {
+			rs := []rune(line)
+			var out []rune
+			idx := 0
+			for _, r := range rs {
+				if r == '\r' {
+					idx = 0
+					continue
+				}
+				if idx < len(out) {
+					out[idx] = r
+				} else {
+					out = append(out, r)
+				}
+				idx++
+			}
+			lines[li] = string(out)
+			continue
+		}
+		// columns hold visible runes; sequences are emitted where they occur
+		var cols []string // each column: a visible rune, possibly preceded by sequences
+		idx := 0
+		pending := ""
+		for _, t := range scan(line) {
+			if t.esc != "" {
+				pending += t.esc
+				continue
+			}
+			if t.r == '\r' {
+				idx = 0
+				continue
+			}
+			cell := pending + string(t.r)
+			pending = ""
+			if idx < len(cols) {
+				cols[idx] = cell
+			} else {
+				cols = append(cols, cell)
+			}
+			idx++
+		}
+		lines[li] = strings.Join(cols, "") + pending
+	}
+	return strings.Join(lines, "\n")
+}
+
+func TestHegelInsert(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := genText(ht, textOpts{newlines: true, tabs: true, sequences: true, other: true, spaces: true})
+		n := drawInt(ht, -1, 5)
+		r := pick(ht, []rune{'-', '|', '\n', '生'})
+		if got, want := text.InsertEveryN(s, r, n), modelInsertEveryN(s, r, n); got != want {
+			c.failClass(ht, "InsertEveryN", "InsertEveryN(%q, %q, %d) = %q, want %q", s, r, n, got, want)
+			return
+		}
+		// ProcessCRLF on a string with carriage returns
+		cr := genText(ht, textOpts{newlines: true, sequences: chance(ht, 50), spaces: true})
+		if chance(ht, 70) {
+			rs := []rune(cr)
+			for k := drawInt(ht, 1, 2); k > 0; k-- {
+				at := drawInt(ht, 0, len(rs))
+				rs = append(rs[:at], append([]rune{'\r'}, rs[at:]...)...)
+			}
+			cr = string(rs)
+		}
+		if got, want := text.ProcessCRLF(cr), modelProcessCRLF(cr); got != want {
+			c.failClass(ht, "ProcessCRLF", "ProcessCRLF(%q) = %q, want %q", cr, got, want)
+			return
+		}
+		c.count(fmt.Sprintf("n=%d", n))
+	})
+}
+
+// --------------------------------------------------------------------------- Align, VAlign
+
+func isNumberText(s string) bool {
+	_, err := strconv.ParseFloat(s, 64)
+	return err == nil
+}
+
+// modelAlign: the visible text of Align.Apply. Spaces are trimmed on the padded side when the
+// raw string has a space at that end (a sequence there prevents the trim, as in the package);
+// Justify splits the raw text on spaces, so a sequence standing alone is a word. Returns the
+// visible result and whether the sequences are expected to survive.
+func modelAlign(a text.Align, s string, n int) (string, bool) {
+	vis := visible(s)
+	eff := a
+	if a == text.AlignAuto {
+		src := vis
+		if Known.autoAlignRaw {
+			src = s
+		}
+		if isNumberText(src) {
+			eff = text.AlignRight
+		} else {
+			eff = text.AlignLeft
+		}
+	}
+	trimLeft, trimRight := false, false
+	switch eff {
+	case text.AlignDefault, text.AlignLeft:
+		trimRight = strings.HasSuffix(s, " ")
+	case text.AlignRight:
+		trimLeft = strings.HasPrefix(s, " ")
+	default:
+		if strings.HasPrefix(s, " ") || strings.HasSuffix(s, " ") {
+			trimLeft, trimRight = true, true
+		}
+	}
+	raw := s
+	if trimLeft {
+		raw = strings.TrimLeft(raw, " ")
+	}
+	if trimRight {
+		raw = strings.TrimRight(raw, " ")
+	}
+	trimmed := visible(raw)
+	w := widthOfPlain(trimmed)
+	pad := n - w
+	if pad < 0 {
+		pad = 0
+	}
+	switch eff {
+	case text.AlignDefault, text.AlignLeft:
+		return trimmed + strings.Repeat(" ", pad), true
+	case text.AlignRight:
+		return strings.Repeat(" ", pad) + trimmed, true
+	case text.AlignCenter:
+		return strings.Repeat(" ", pad-pad/2) + trimmed + strings.Repeat(" ", pad/2), true
+	}
+	// justify: the raw words
+	words := []string{}
+	for _, wd := range strings.Split(raw, " ") {
+		if wd != "" {
+			words = append(words, wd)
+		}
+	}
+	if len(words) == 0 {
+		return strings.Repeat(" ", n), false
+	}
+	needed := n - w + strings.Count(raw, " ")
+	if needed < 0 {
+		return trimmed, true
+	}
+	between := 0
+	if len(words) > 1 {
+		between = needed / (len(words) - 1)
+	}
+	var b strings.Builder
+	for i, wd := range words {
+		if i > 0 {
+			if i == len(words)-1 {
+				b.WriteString(strings.Repeat(" ", needed))
+				needed = 0
+			} else {
+				b.WriteString(strings.Repeat(" ", between))
+				needed -= between
+			}
+		}
+		b.WriteString(wd)
+		if i == len(words)-1 && needed > 0 {
+			b.WriteString(strings.Repeat(" ", needed))
+		}
+	}
+	return visible(b.String()), true
+}
+
+func TestHegelAlign(t *testing.T) {
+	c := newCollector(t)
+	aligns := []text.Align{text.AlignDefault, text.AlignLeft, text.AlignCenter, text.AlignJustify, text.AlignRight, text.AlignAuto}
+	names := []string{"Default", "Left", "Center", "Justify", "Right", "Auto"}
+	property(t, func(ht *hegel.T) {
+		var s string
+		if chance(ht, 25) {
+			// number-like texts for AlignAuto
+			s = pick(ht, []string{"12", "-3.5", "1e3", "Inf", "0x1p-2", "12a", " 7", "7 ", "1_000"})
+			if chance(ht, 30) {
+				s = esc + "[31m" + s + esc + "[0m"
+			}
+		} else {
+			s = genText(ht, textOpts{sequences: true, spaces: true})
+		}
+		n := drawInt(ht, -1, 14)
+		i := drawInt(ht, 0, len(aligns)-1)
+		a := aligns[i]
+		if a == text.AlignJustify && n < 0 && Known.justifyNegativePanic {
+			n = 0
+		}
+		got := a.Apply(s, n)
+		wantVis, keep := modelAlign(a, s, n)
+		if visible(got) != wantVis {
+			c.failClass(ht, names[i], "Align%s.Apply(%q, %d) = %q (visible %q), want visible %q", names[i], s, n, got, visible(got), wantVis)
+			return
+		}
+		if keep && !reflect.DeepEqual(escapes(got), escapes(s)) {
+			c.failClass(ht, names[i]+" sequences", "Align%s.Apply(%q, %d) = %q: sequences %q, want %q", names[i], s, n, got, escapes(got), escapes(s))
+			return
+		}
+		// VAlign
+		lines := make([]string, drawInt(ht, 0, 4))
+		for k := range lines {
+			lines[k] = genWord(ht)
+		}
+		maxLines := drawInt(ht, -1, 6)
+		va := pick(ht, []text.VAlign{text.VAlignDefault, text.VAlignTop, text.VAlignMiddle, text.VAlignBottom})
+		want := modelVAlign(va, lines, maxLines)
+		vg := va.Apply(append([]string{}, lines...), maxLines)
+		if !reflect.DeepEqual(vg, want) {
+			c.failClass(ht, "VAlign", "VAlign(%d).Apply(%q, %d) = %q, want %q", va, lines, maxLines, vg, want)
+			return
+		}
+		if len(lines) > 0 {
+			vs := va.ApplyStr(strings.Join(lines, "\n"), maxLines)
+			if !reflect.DeepEqual(vs, want) {
+				c.failClass(ht, "VAlignStr", "VAlign(%d).ApplyStr(%q, %d) = %q, want %q", va, strings.Join(lines, "\n"), maxLines, vs, want)
+				return
+			}
+		}
+		c.count(names[i])
+	})
+}
+
+func modelVAlign(va text.VAlign, lines []string, maxLines int) []string {
+	if len(lines) == maxLines {
+		return lines
+	}
+	if len(lines) > maxLines {
+		maxLines = len(lines)
+	}
+	if maxLines < 1 {
+		return lines
+	}
+	insert := 0
+	switch va {
+	case text.VAlignMiddle:
+		insert = (maxLines - len(lines)) / 2
+	case text.VAlignBottom:
+		insert = maxLines - len(lines)
+	}
+	out := make([]string, maxLines)
+	for i, l := range lines {
+		out[i+insert] = l
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- Format
+
+// isSeparator: strings.Title's rule (the package copies it).
+func isSeparator(r rune) bool {
+	if r <= 0x7F {
+		switch {
+		case '0' <= r && r <= '9', 'a' <= r && r <= 'z', 'A' <= r && r <= 'Z', r == '_':
+			return false
+		}
+		return true
+	}
+	if unicode.IsLetter(r) || unicode.IsDigit(r) {
+		return false
+	}
+	return unicode.IsSpace(r)
+}
+
+// modelFormat: the visible runes converted, every escape sequence untouched.
+func modelFormat(f text.Format, s string) string {
+	var b strings.Builder
+	prev := ' '
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			b.WriteString(t.esc)
+			continue
+		}
+		r := t.r
+		switch f {
+		case text.FormatLower:
+			r = unicode.ToLower(r)
+		case text.FormatUpper:
+			r = unicode.ToUpper(r)
+		case text.FormatTitle:
+			if isSeparator(prev) {
+				if Known.titleUpper {
+					r = unicode.ToUpper(r)
+				} else {
+					r = unicode.ToTitle(r)
+				}
+			}
+			prev = t.r
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+func TestHegelFormat(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		s := genText(ht, textOpts{newlines: true, sequences: true, other: !Known.formatCSIOnly, spaces: true})
+		if chance(ht, 30) {
+			var ub strings.Builder
+			for _, tk := range scan(s) {
+				if tk.esc != "" {
+					ub.WriteString(tk.esc)
+				} else {
+					ub.WriteRune(unicode.ToUpper(tk.r))
+				}
+			}
+			s = ub.String()
+		}
+		f := pick(ht, []text.Format{text.FormatDefault, text.FormatLower, text.FormatTitle, text.FormatUpper})
+		if got, want := f.Apply(s), modelFormat(f, s); got != want {
+			c.failClass(ht, fmt.Sprintf("Format %d", f), "Format(%d).Apply(%q) = %q, want %q", f, s, got, want)
+			return
+		}
+		c.count(fmt.Sprintf("format %d", f))
+	})
+}
+
+// --------------------------------------------------------------------------- Escape, parser
+
+// modelEscapeStates: the SGR state at each visible rune of Escape(s, seq): seq applies from the
+// start (unless s starts with a CSI sequence) and again after every reset "\x1b[0m".
+func modelEscapeStates(s, seq string) []sgr {
+	var q sgr
+	q.apply(seq)
+	st := q
+	if strings.HasPrefix(s, esc+"[") {
+		st = sgr{}
+	}
+	var out []sgr
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			if t.esc == esc+"[0m" {
+				st = q
+			} else {
+				st.apply(t.esc)
+			}
+			continue
+		}
+		out = append(out, st)
+	}
+	return out
+}
+
+func TestHegelEscape(t *testing.T) {
+	c := newCollector(t)
+	text.EnableColors()
+	property(t, func(ht *hegel.T) {
+		s := genText(ht, textOpts{sequences: true, spaces: true})
+		// resets as the exact sequence the package recognises
+		var rb strings.Builder
+		for _, tk := range scan(s) {
+			if tk.esc != "" && strings.HasPrefix(tk.esc, esc+"[0;") {
+				rb.WriteString(esc + "[0m")
+			} else if tk.esc != "" {
+				rb.WriteString(tk.esc)
+			} else {
+				rb.WriteRune(tk.r)
+			}
+		}
+		s = rb.String()
+		// at most one foreground and one background colour (Known.colorsSorted)
+		var colors text.Colors
+		if chance(ht, 40) {
+			colors = append(colors, pick(ht, []text.Color{text.Bold, text.Underline, text.Italic}))
+		}
+		if chance(ht, 60) {
+			colors = append(colors, pick(ht, []text.Color{text.FgRed, text.FgHiBlue, text.Fg256Color(drawInt(ht, 0, 255))}))
+		}
+		if chance(ht, 30) {
+			colors = append(colors, pick(ht, []text.Color{text.BgGreen, text.Bg256Color(200)}))
+		}
+		if Known.escapeEmptySeq && len(colors) == 0 {
+			colors = text.Colors{text.FgRed}
+		}
+		seq := colors.EscapeSeq()
+		if seq != "" && chance(ht, 30) {
+			// the sequence itself inside the input (a colour only into an empty slot under Known.colorsSorted)
+			var q sgr
+			q.apply(seq)
+			if st := stateAfter(s); !Known.colorsSorted || ((q.fg == "" || st.fg == "") && (q.bg == "" || st.bg == "")) {
+				s += seq + pick(ht, []string{"", esc + "[0m"})
+			}
+		}
+		if Known.escapeStripsPair && seq != "" {
+			s = strings.ReplaceAll(s, seq+esc+"[0m", seq+"x"+esc+"[0m")
+			if strings.HasSuffix(s, seq) {
+				s += "x"
+			}
+		}
+		got := text.Escape(s, seq)
+		if visible(got) != visible(s) {
+			c.failClass(ht, "Escape visible", "Escape(%q, %q) = %q: visible %q, want %q", s, seq, got, visible(got), visible(s))
+			return
+		}
+		want := modelEscapeStates(s, seq)
+		gs := visibleStates(got)
+		for i := range want {
+			if gs[i].st != want[i] {
+				c.failClass(ht, "Escape state", "Escape(%q, %q) = %q: rune %d %q in state %s, want %s", s, seq, got, i, gs[i].r, gs[i].st, want[i])
+				return
+			}
+		}
+		if got != "" && stateAfter(got) != (sgr{}) {
+			c.failClass(ht, "Escape end", "Escape(%q, %q) = %q ends in state %s", s, seq, got, stateAfter(got))
+			return
+		}
+		// Colors.Sprint is Escape of the printed value
+		if sp := colors.Sprint(s); sp != text.Escape(s, seq) && !(seq == "" && sp == s) {
+			c.failClass(ht, "Sprint", "Colors(%v).Sprint(%q) = %q, want %q", colors, s, sp, text.Escape(s, seq))
+			return
+		}
+		// the parser's restored sequence denotes the state at the end of s
+		esp := text.EscSeqParser{}
+		esp.ParseString(s)
+		restored := esp.Sequence()
+		wantSt := stateAfter(s)
+		if gotSt := stateAfter(restored); gotSt != wantSt {
+			c.failClass(ht, "Sequence", "EscSeqParser.ParseString(%q).Sequence() = %q (state %s), want state %s", s, restored, gotSt, wantSt)
+			return
+		}
+		if esp.IsOpen() != (wantSt != sgr{}) {
+			c.failClass(ht, "IsOpen", "EscSeqParser after %q: IsOpen %v, state %s", s, esp.IsOpen(), wantSt)
+			return
+		}
+		c.count(fmt.Sprintf("colors=%d", len(colors)))
+	})
+}
