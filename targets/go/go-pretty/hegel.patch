index 0000000..689a08b
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,449 @@
+package hegel
+
+// The model: a scanner for escape sequences, the visible text and its width, an SGR state, and
+// the generators of strings holding sequences.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+const esc = "\x1b"
+
+// tok is a scanned piece of a string: an escape sequence (esc != "") or a rune.
+type tok struct {
+	esc string
+	r   rune
+}
+
+// scan splits s into escape sequences and runes. ECMA-48: a CSI sequence is ESC [ followed by
+// parameter and intermediate bytes (0x20-0x3F) and a final byte (0x40-0x7E); an OSC sequence is
+// ESC ] up to BEL or ESC \. Any other ESC starts a two-character sequence. An unterminated
+// sequence runs to the end of the string.
+func scan(s string) []tok {
+	var out []tok
+	rs := []rune(s)
+	for i := 0; i < len(rs); i++ {
+		if rs[i] != 27 {
+			out = append(out, tok{r: rs[i]})
+			continue
+		}
+		j := i + 1
+		if j >= len(rs) {
+			out = append(out, tok{esc: string(rs[i:])})
+			break
+		}
+		switch rs[j] {
+		case '[':
+			j++
+			for j < len(rs) && rs[j] >= 0x20 && rs[j] <= 0x3F {
+				j++
+			}
+			if j < len(rs) && rs[j] >= 0x40 && rs[j] <= 0x7E {
+				j++
+			} else {
+				j = len(rs)
+			}
+		case ']':
+			j++
+			for j < len(rs) {
+				if rs[j] == 7 {
+					j++
+					break
+				}
+				if rs[j] == 27 && j+1 < len(rs) && rs[j+1] == '\\' {
+					j += 2
+					break
+				}
+				j++
+			}
+		default:
+			j++
+		}
+		out = append(out, tok{esc: string(rs[i:j])})
+		i = j - 1
+	}
+	return out
+}
+
+func visible(s string) string {
+	var b strings.Builder
+	for _, t := range scan(s) {
+		if t.esc == "" {
+			b.WriteRune(t.r)
+		}
+	}
+	return b.String()
+}
+
+func escapes(s string) []string {
+	var out []string
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			out = append(out, t.esc)
+		}
+	}
+	return out
+}
+
+// widthOf is the display width of the visible text, text.RuneWidth per rune (the package's own
+// definition of a rune's width; the model does not test it).
+func widthOf(s string) int {
+	w := 0
+	for _, r := range visible(s) {
+		w += text.RuneWidth(r)
+	}
+	return w
+}
+
+func widthOfPlain(s string) int {
+	w := 0
+	for _, r := range s {
+		w += text.RuneWidth(r)
+	}
+	return w
+}
+
+// --------------------------------------------------------------------------- SGR state
+
+// sgr is the documented meaning of the SGR sequences: a foreground colour, a background colour
+// and the attributes 1-9, each set by its code, cleared by 22-29 or by 0.
+type sgr struct {
+	fg, bg string
+	attrs  [10]bool
+}
+
+func (st *sgr) apply(seq string) {
+	if !strings.HasPrefix(seq, esc+"[") || !strings.HasSuffix(seq, "m") {
+		return
+	}
+	body := seq[2 : len(seq)-1]
+	parts := strings.Split(body, ";")
+	codes := make([]int, 0, len(parts))
+	for _, p := range parts {
+		if p == "" {
+			codes = append(codes, 0)
+			continue
+		}
+		n, err := strconv.Atoi(p)
+		if err != nil {
+			return // not an SGR sequence the model knows
+		}
+		codes = append(codes, n)
+	}
+	for i := 0; i < len(codes); i++ {
+		c := codes[i]
+		switch {
+		case c == 0:
+			*st = sgr{}
+		case c >= 1 && c <= 9:
+			st.attrs[c] = true
+		case c == 22:
+			st.attrs[1], st.attrs[2] = false, false
+		case c == 23:
+			st.attrs[3] = false
+		case c == 24:
+			st.attrs[4] = false
+		case c == 25:
+			st.attrs[5], st.attrs[6] = false, false
+		case c == 27:
+			st.attrs[7] = false
+		case c == 28:
+			st.attrs[8] = false
+		case c == 29:
+			st.attrs[9] = false
+		case (c >= 30 && c <= 37) || (c >= 90 && c <= 97):
+			st.fg = strconv.Itoa(c)
+		case c == 39:
+			st.fg = ""
+		case (c >= 40 && c <= 47) || (c >= 100 && c <= 107):
+			st.bg = strconv.Itoa(c)
+		case c == 49:
+			st.bg = ""
+		case c == 38 || c == 48:
+			var v string
+			if i+2 < len(codes) && codes[i+1] == 5 {
+				v = fmt.Sprintf("%d;5;%d", c, codes[i+2])
+				i += 2
+			} else if i+4 < len(codes) && codes[i+1] == 2 {
+				v = fmt.Sprintf("%d;2;%d;%d;%d", c, codes[i+2], codes[i+3], codes[i+4])
+				i += 4
+			} else {
+				return
+			}
+			if c == 38 {
+				st.fg = v
+			} else {
+				st.bg = v
+			}
+		}
+	}
+}
+
+func (st sgr) String() string {
+	var parts []string
+	for i := 1; i <= 9; i++ {
+		if st.attrs[i] {
+			parts = append(parts, strconv.Itoa(i))
+		}
+	}
+	if st.fg != "" {
+		parts = append(parts, "fg="+st.fg)
+	}
+	if st.bg != "" {
+		parts = append(parts, "bg="+st.bg)
+	}
+	if len(parts) == 0 {
+		return "{}"
+	}
+	return "{" + strings.Join(parts, " ") + "}"
+}
+
+// stateAfter is the SGR state at the end of s.
+func stateAfter(s string) sgr {
+	var st sgr
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			st.apply(t.esc)
+		}
+	}
+	return st
+}
+
+// visibleStates lists the visible runes of s with the SGR state in force at each.
+type runeState struct {
+	r  rune
+	st sgr
+}
+
+func visibleStates(s string) []runeState {
+	var st sgr
+	var out []runeState
+	for _, t := range scan(s) {
+		if t.esc != "" {
+			st.apply(t.esc)
+		} else {
+			out = append(out, runeState{t.r, st})
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- generators
+
+var wideRunes = []rune{'生', '命', '世', '界', 'ツ'}
+
+// genRune: a visible rune; wide runes, a precomposed accent, an emoji and a combining mark among
+// ASCII letters and digits.
+func genRune(tc hegel.TestCase) rune {
+	switch drawInt(tc, 0, 9) {
+	case 0:
+		return pick(tc, wideRunes)
+	case 1:
+		return pick(tc, []rune{'é', 'ß', 'ǆ', 'Ω', '😀'})
+	case 2:
+		return pick(tc, []rune{'0', '7', '-', '.', '_', '!', '/'})
+	default:
+		return rune('a' + drawInt(tc, 0, 25))
+	}
+}
+
+// genWord: 1-6 visible runes without whitespace.
+func genWord(tc hegel.TestCase) string {
+	n := drawInt(tc, 1, 6)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		b.WriteRune(genRune(tc))
+	}
+	return b.String()
+}
+
+var fgCodes = []int{30, 31, 32, 33, 34, 35, 36, 37, 90, 91, 92, 93, 94, 95, 96, 97}
+var bgCodes = []int{40, 41, 42, 43, 44, 45, 46, 47, 100, 101, 102, 103, 104, 105, 106, 107}
+
+// genSGR: an SGR sequence applicable in state st (which it updates). Under Known.colorsSorted
+// a colour is set only when its slot is empty; truecolor and code 28 only when their switches
+// are off; under Known.codesOutOfOrder a 256-colour code stands alone in its sequence.
+func genSGR(tc hegel.TestCase, st *sgr) string { return genSGROpt(tc, st, sgrOpts{}) }
+
+// sgrOpts: noReset excludes code 0; fullState spells the sequence as a reset followed by the
+// whole resulting state (so that the sequence alone denotes the state).
+type sgrOpts struct {
+	noReset   bool
+	fullState bool
+}
+
+func genSGROpt(tc hegel.TestCase, st *sgr, o sgrOpts) string {
+	var codes []string
+	for n := drawInt(tc, 1, 2); n > 0; n-- {
+		var nc []string // the codes of this round
+		alone := false
+		k := drawInt(tc, 0, 9)
+		if k == 8 && o.fullState && Known.codesOutOfOrder {
+			k = 4 // a 256 colour cannot share a sequence with the reset of the full-state spelling
+		}
+		switch k {
+		case 0:
+			if o.noReset {
+				nc = append(nc, "4")
+				break
+			}
+			nc = append(nc, "0")
+		case 1, 2:
+			nc = append(nc, strconv.Itoa(drawInt(tc, 1, 9)))
+		case 3:
+			c := pick(tc, []int{22, 23, 24, 25, 27, 29, 39, 49})
+			if !Known.concealOff && chance(tc, 30) {
+				c = 28
+			}
+			nc = append(nc, strconv.Itoa(c))
+		case 4, 5, 6:
+			if Known.colorsSorted && st.fg != "" {
+				nc = append(nc, "39")
+			} else {
+				nc = append(nc, strconv.Itoa(pick(tc, fgCodes)))
+			}
+		case 7:
+			if Known.colorsSorted && st.bg != "" {
+				nc = append(nc, "49")
+			} else {
+				nc = append(nc, strconv.Itoa(pick(tc, bgCodes)))
+			}
+		case 8:
+			base := pick(tc, []int{38, 48})
+			if Known.colorsSorted && ((base == 38 && st.fg != "") || (base == 48 && st.bg != "")) {
+				nc = append(nc, strconv.Itoa(base+1))
+			} else if !Known.truecolor && chance(tc, 50) {
+				nc = append(nc, fmt.Sprintf("%d;2;%d;%d;%d", base, drawInt(tc, 0, 255), drawInt(tc, 0, 255), drawInt(tc, 0, 255)))
+			} else {
+				nc = append(nc, fmt.Sprintf("%d;5;%d", base, drawInt(tc, 0, 255)))
+				alone = Known.codesOutOfOrder
+			}
+		default:
+			nc = append(nc, "1")
+		}
+		// apply the codes now, so that the next round sees the colour slots as they are
+		st.apply(esc + "[" + strings.Join(nc, ";") + "m")
+		if alone {
+			// the 256 colour stands alone: the codes so far form a sequence of their own
+			if len(codes) > 0 {
+				return esc + "[" + strings.Join(codes, ";") + "m" + esc + "[" + strings.Join(nc, ";") + "m"
+			}
+			codes = nc
+			break
+		}
+		codes = append(codes, nc...)
+	}
+	if o.fullState {
+		if *st == (sgr{}) && o.noReset {
+			st.attrs[4] = true
+		}
+		return stateSequence(*st)
+	}
+	return esc + "[" + strings.Join(codes, ";") + "m"
+}
+
+// stateSequence spells a state as one sequence: a reset followed by its codes.
+func stateSequence(st sgr) string {
+	codes := []string{"0"}
+	for i := 1; i <= 9; i++ {
+		if st.attrs[i] {
+			codes = append(codes, strconv.Itoa(i))
+		}
+	}
+	if st.fg != "" {
+		codes = append(codes, st.fg)
+	}
+	if st.bg != "" {
+		codes = append(codes, st.bg)
+	}
+	return esc + "[" + strings.Join(codes, ";") + "m"
+}
+
+// genOtherSeq: a non-SGR sequence (cursor movement, erase, OSC title) when the switches allow.
+func genOtherSeq(tc hegel.TestCase) string {
+	switch drawInt(tc, 0, 3) {
+	case 0:
+		if Known.csiOnlyM {
+			return ""
+		}
+		return esc + "[" + strconv.Itoa(drawInt(tc, 1, 9)) + string(pick(tc, []rune{'A', 'B', 'C', 'D', 'K', 'J', 'H'}))
+	case 1:
+		if Known.csiOnlyM {
+			return ""
+		}
+		return pick(tc, []string{text.EraseLine.Sprint(), text.CursorUp.Sprintn(drawInt(tc, 1, 5)), text.CursorLeft.Sprintn(2)})
+	case 2:
+		if Known.oscBelOnly8 {
+			return esc + "]0;" + genWord(tc) + esc + "\\"
+		}
+		return esc + "]0;" + genWord(tc) + "\a"
+	default:
+		return genHyperlink(tc)
+	}
+}
+
+// genHyperlink: an OSC 8 hyperlink around a word, ST or BEL terminated.
+func genHyperlink(tc hegel.TestCase) string {
+	url := pick(tc, []string{"https://go.dev/Docs", "http://x.y/mm", "https://example.com/Path?q=1", "file:///tmp/m"})
+	label := genWord(tc)
+	if chance(tc, 50) {
+		return text.Hyperlink(url, label)
+	}
+	return esc + "]8;;" + url + "\a" + label + esc + "]8;;\a"
+}
+
+// textOpts steers genText.
+type textOpts struct {
+	newlines  bool // \n and \r\n
+	tabs      bool
+	sequences bool // SGR sequences
+	other     bool // cursor/erase/OSC sequences and hyperlinks (subject to the switches)
+	spaces    bool // runs of spaces, leading and trailing
+}
+
+// genText: words joined by separators, with escape sequences between and inside them.
+func genText(tc hegel.TestCase, o textOpts) string {
+	var b strings.Builder
+	var st sgr
+	n := drawInt(tc, 0, 6)
+	for i := 0; i < n; i++ {
+		if i > 0 || (o.spaces && chance(tc, 20)) {
+			switch {
+			case o.newlines && chance(tc, 20):
+				b.WriteString(pick(tc, []string{"\n", "\n", "\r\n", "\n\n"}))
+			case o.tabs && chance(tc, 10):
+				b.WriteString("\t")
+			case o.spaces && chance(tc, 30):
+				b.WriteString(strings.Repeat(" ", drawInt(tc, 1, 3)))
+			default:
+				b.WriteString(" ")
+			}
+		}
+		if o.sequences && chance(tc, 40) {
+			b.WriteString(genSGR(tc, &st))
+		}
+		if o.other && chance(tc, 15) {
+			b.WriteString(genOtherSeq(tc))
+		}
+		w := genWord(tc)
+		if o.sequences && chance(tc, 20) {
+			// a sequence inside the word
+			rs := []rune(w)
+			k := drawInt(tc, 1, len(rs))
+			w = string(rs[:k]) + genSGR(tc, &st) + string(rs[k:])
+		}
+		b.WriteString(w)
+	}
+	if o.spaces && chance(tc, 20) {
+		b.WriteString(strings.Repeat(" ", drawInt(tc, 1, 2)))
+	}
+	if o.sequences && chance(tc, 40) {
+		b.WriteString(esc + "[0m")
+	}
+	return b.String()
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
