diff --git a/hegel/hegel_table_test.go b/hegel/hegel_table_test.go
new file mode 100644
index 0000000..b9938bf
--- /dev/null
+++ b/hegel/hegel_table_test.go
@@ -0,0 +1,908 @@
+package hegel
+
+// The table package: CSV/TSV records, Markdown, HTML, the boxed rendering, the pager.
+
+import (
+	"encoding/csv"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/jedib0t/go-pretty/v6/table"
+	"github.com/jedib0t/go-pretty/v6/text"
+	"hegel.dev/go/hegel"
+)
+
+func parseCSV(s string, comma rune) ([][]string, error) {
+	r := csv.NewReader(strings.NewReader(s))
+	r.Comma = comma
+	r.FieldsPerRecord = -1
+	recs, err := r.ReadAll()
+	if len(recs) == 0 {
+		recs = nil
+	}
+	return recs, err
+}
+
+// tableSpecs: a table of 1-4 columns with 0-2 header rows of plain cells, 0-6 body rows and
+// 0-1 footer rows of cells as the options say (empty rows too when allowed and go-pretty/25-26's
+// switch is off), auto-index three times in ten, 0-2 column configs two times in five,
+// SuppressEmptyColumns one time in four, 1-2 filters two times in five.
+func tableSpecs(o cellOpts, allowEmpty bool) hegel.Generator[*tableSpec] {
+	lo := 1
+	if allowEmpty && !Known.emptyRow {
+		lo = 0
+	}
+	cell := cells(o)
+	return hegel.Composite(func(tc hegel.TestCase) *tableSpec {
+		ncols := hegel.Draw(tc, hegel.Integers(1, 4))
+		s := &tableSpec{mergeRow: -1, ncols: ncols}
+		s.header = hegel.Draw(tc, rowLists(plainCells, 1, ncols, 0, 2))
+		s.body = hegel.Draw(tc, rowLists(cell, lo, ncols, 0, 6))
+		s.footer = hegel.Draw(tc, rowLists(cell, lo, ncols, 0, 1))
+		s.autoIndex = hegel.Draw(tc, chance(30))
+		s.configs = configsOf(hegel.Draw(tc, maybe(40, many(configSpecs, 0, 2))), s.header, ncols)
+		s.suppressEmpty = hegel.Draw(tc, chance(25))
+		s.filters = filtersOf(hegel.Draw(tc, maybe(40, many(filterSpecs, 1, 2))), s.header, ncols)
+		return s
+	})
+}
+
+// rowsEmptyAfterHide: whether some row loses all its cells to hidden columns.
+func rowsEmptyAfterHide(m *tableModel) bool {
+	for _, rs := range [][][]string{m.header, m.body, m.footer} {
+		for _, r := range rs {
+			if len(r) == 0 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// specModel: the model of a spec; while empty rows are mis-rendered, hidden and suppressed
+// columns are kept from emptying a row.
+func specModel(s *tableSpec) *tableModel {
+	m := modelTable(s, nil)
+	if Known.emptyRow && rowsEmptyAfterHide(m) {
+		s.configs, s.suppressEmpty = nil, false
+		m = modelTable(s, nil)
+	}
+	return m
+}
+
+// --------------------------------------------------------------------------- CSV / TSV
+
+// csvCase: the table (with field protection three times in ten and 1-2 sort keys half of
+// the time), and the grid ImportGrid is checked on (three times in ten): 0-4 rows of up to
+// three cells (empty inner rows too while go-pretty/38's switch is off).
+type csvCase struct {
+	spec *tableSpec
+	grid *[][]any
+}
+
+func (c csvCase) GoString() string {
+	if c.grid == nil {
+		return c.spec.String()
+	}
+	return fmt.Sprintf("%s\nImportGrid(%v)", c.spec, *c.grid)
+}
+
+var (
+	csvSpecs = tableSpecs(cellOpts{}, true)
+	grids    = func() hegel.Generator[[][]any] {
+		lo := 0
+		if Known.importGridEmptyRow {
+			lo = 1
+		}
+		return rowLists(cells(cellOpts{}), lo, 3, 0, 4)
+	}()
+	csvCases = hegel.Composite(func(tc hegel.TestCase) csvCase {
+		s := hegel.Draw(tc, csvSpecs)
+		s.fieldProtection = hegel.Draw(tc, chance(30))
+		s.sorts = sortsOf(hegel.Draw(tc, maybe(50, many(sortSpecs, 1, 2))), s)
+		if Known.suppressFirstCell && len(s.sorts) > 0 {
+			s.suppressEmpty = false // the suppression depends on the sorted order
+		}
+		return csvCase{spec: s, grid: hegel.Draw(tc, optional(30, grids))}
+	})
+)
+
+// TestHegelTableCSV: RenderCSV and RenderTSV records against the row model, with filters,
+// sorting, hidden and suppressed columns, transformers, auto-index and field protection;
+// Length(); ImportGrid.
+func TestHegelTableCSV(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, csvCases)
+		s := c.spec
+		m := specModel(s)
+		keys := resolveSorts(s, m)
+		if Known.numericSortAbandoned {
+			// a numeric sort with a non-numeric cell, or any sort meeting NaN, abandons the
+			// order: keep such keys off
+			for _, k := range keys {
+				for _, r := range m.bodyFull {
+					f, err := strconv.ParseFloat(m.cell(r, k.Number-1), 64)
+					numericMode := k.Mode != table.Asc && k.Mode != table.Dsc
+					if numericMode && (err == nil && math.IsNaN(f) || err != nil && (k.Mode == table.AscNumeric || k.Mode == table.DscNumeric)) {
+						s.sorts = nil
+						keys = nil
+						break
+					}
+				}
+			}
+		}
+		tw := s.build()
+		wantLen := len(m.body)
+		if Known.lengthStale {
+			wantLen = len(s.body)
+		}
+		if got := tw.Length(); got != wantLen {
+			fail(ht, "Length() = %d before rendering, want %d (filters %d)", got, wantLen, len(s.filters))
+			return
+		}
+		out := tw.RenderCSV()
+		recs, err := parseCSV(out, ',')
+		if err != nil {
+			fail(ht, "RenderCSV() = %q: %v", out, err)
+			return
+		}
+		want := m.csvRecords(s, s.fieldProtection)
+		// the body rows (by index) and footer rows whose record is written (go-pretty/45)
+		var bodyIdx []int
+		for i, r := range m.body {
+			if m.csvKept(s, r) {
+				bodyIdx = append(bodyIdx, i)
+			}
+		}
+		nFoot := 0
+		for _, r := range m.footer {
+			if m.csvKept(s, r) {
+				nFoot++
+			}
+		}
+		nHead := len(want) - len(bodyIdx) - nFoot
+		if len(recs) != len(want) {
+			fail(ht, "RenderCSV() = %q: %d records, want %d", out, len(recs), len(want))
+			return
+		}
+		if !reflect.DeepEqual(recs[:nHead], want[:nHead]) || !reflect.DeepEqual(recs[nHead+len(bodyIdx):], want[nHead+len(bodyIdx):]) {
+			fail(ht, "RenderCSV() = %q\nrecords %q\nwant %q", out, recs, want)
+			return
+		}
+		gotBody := recs[nHead : nHead+len(bodyIdx)]
+		wantBody := want[nHead : nHead+len(bodyIdx)]
+		var order []int // for each output body record, its index in wantBody
+		if len(keys) == 0 {
+			if !reflect.DeepEqual(gotBody, wantBody) {
+				fail(ht, "RenderCSV() = %q\nbody %q\nwant %q", out, gotBody, wantBody)
+				return
+			}
+			order = make([]int, len(bodyIdx))
+			for i := range order {
+				order[i] = i
+			}
+		} else {
+			// a permutation of the rows, in an order the keys allow
+			order = matchRows(gotBody, wantBody, s.autoIndex, func(i, j int) bool {
+				return rowsCmp(m.bodyFull[bodyIdx[i]], m.bodyFull[bodyIdx[j]], keys) < 0
+			})
+			if order == nil {
+				fail(ht, "RenderCSV() = %q\nbody %q is not a permutation of %q", out, gotBody, wantBody)
+				return
+			}
+			for i := 1; i < len(order); i++ {
+				prev, cur := m.bodyFull[bodyIdx[order[i-1]]], m.bodyFull[bodyIdx[order[i]]]
+				if rowsCmp(prev, cur, keys) > 0 {
+					fail(ht, "RenderCSV() = %q\nrows %q and %q are out of order under %+v", out, prev, cur, keys)
+					return
+				}
+			}
+			if k := keys[0]; k.Mode == table.AscNumeric || k.Mode == table.DscNumeric {
+				// the numeric cells of the first key appear in order
+				var prev *float64
+				for _, o := range order {
+					f, err := strconv.ParseFloat(m.cell(m.bodyFull[bodyIdx[o]], k.Number-1), 64)
+					if err != nil {
+						continue
+					}
+					if prev != nil && (k.Mode == table.AscNumeric && f < *prev || k.Mode == table.DscNumeric && f > *prev) {
+						fail(ht, "RenderCSV() = %q: numeric cells %v then %v out of order under %+v", out, *prev, f, k)
+						return
+					}
+					prev = &f
+				}
+			}
+		}
+		if got := tw.Length(); got != len(m.body) {
+			fail(ht, "Length() = %d after rendering, want %d", got, len(m.body))
+			return
+		}
+		// TSV: the same records
+		outT := tw.RenderTSV()
+		recsT, err := parseCSV(outT, '\t')
+		if err != nil {
+			fail(ht, "RenderTSV() = %q: %v", outT, err)
+			return
+		}
+		wantT := m.csvRecords(s, false)
+		if len(recsT) != len(wantT) {
+			fail(ht, "RenderTSV() = %q: %d records, want %d", outT, len(recsT), len(wantT))
+			return
+		}
+		for i, rec := range recsT {
+			want := wantT[i]
+			if i >= nHead && i < nHead+len(bodyIdx) {
+				want = append([]string{}, wantT[nHead+order[i-nHead]]...)
+				if s.autoIndex {
+					want[0] = strconv.Itoa(i - nHead + 1)
+				}
+			}
+			if !reflect.DeepEqual(rec, want) {
+				fail(ht, "RenderTSV() = %q\nrecord %d = %q, want %q", outT, i, rec, want)
+				return
+			}
+		}
+		// ImportGrid: rows as appended
+		if c.grid != nil {
+			grid := *c.grid
+			tg, ta := table.NewWriter(), table.NewWriter()
+			added := tg.ImportGrid(grid)
+			for _, r := range grid {
+				ta.AppendRow(table.Row(r))
+			}
+			if added != (len(grid) > 0) || tg.RenderCSV() != ta.RenderCSV() || tg.Length() != len(grid) {
+				fail(ht, "ImportGrid(%v) = %v, RenderCSV() = %q, want %q (Length %d, want %d)", grid, added, tg.RenderCSV(), ta.RenderCSV(), tg.Length(), len(grid))
+				return
+			}
+		}
+		count(ht, fmt.Sprintf("cols=%d sort=%v filter=%v", m.numCols, len(keys) > 0, len(s.filters) > 0))
+	})
+}
+
+// matchRows: for each output record the index of a matching expected record (auto-index
+// numbers excepted), or nil when the records are not a permutation. Expected records that
+// read the same (rows differing only in hidden columns) are taken in the sort order less
+// gives, so that a sorted output matches a sorted assignment.
+func matchRows(got, want [][]string, autoIndex bool, less func(i, j int) bool) []int {
+	used := make([]bool, len(want))
+	order := make([]int, len(got))
+	strip := func(r []string) []string {
+		if autoIndex && len(r) > 0 {
+			return r[1:]
+		}
+		return r
+	}
+	for i, g := range got {
+		if autoIndex && (len(g) == 0 || g[0] != strconv.Itoa(i+1)) {
+			return nil
+		}
+		found := -1
+		for j, w := range want {
+			if !used[j] && reflect.DeepEqual(strip(g), strip(w)) && (found < 0 || less(j, found)) {
+				found = j
+			}
+		}
+		if found < 0 {
+			return nil
+		}
+		used[found] = true
+		order[i] = found
+	}
+	return order
+}
