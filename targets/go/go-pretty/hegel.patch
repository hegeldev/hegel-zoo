+// mergeToken: the cell of the row carrying RowConfig{AutoMerge}; one column wide, so that the
+// merged cell always fits its columns (a wider one may make Render panic).
+const mergeToken = "~"
+
+// renderModel: the line layout of Render() for a spec: line counts per block and the width.
+type renderModel struct {
+	colWidths  []int
+	width      int
+	titleLines int
+	headLines  int // header block incl. its bottom separator
+	bodyStart  int // index of the first body line
+	rowLines   []int
+	total      int
+}
+
+func modelRender(s *tableSpec, m *tableModel) renderModel {
+	var rm renderModel
+	widths := make([]int, m.numCols)
+	for _, rs := range [][][]string{m.header, m.body, m.footer} {
+		for _, r := range rs {
+			if s.mergeRow >= 0 && len(r) > 0 && r[0] == mergeToken {
+				continue // the merged cell spans its columns
+			}
+			for c, v := range r {
+				w := text.LongestLineLen(v)
+				if mx := m.configs[c].WidthMax; mx > 0 && w > mx {
+					w = mx
+				}
+				if w > widths[c] {
+					widths[c] = w
+				}
+			}
+		}
+	}
+	for c := range widths {
+		if mn := m.configs[c].WidthMin; widths[c] < mn {
+			widths[c] = mn
+		}
+	}
+	width := func() int {
+		w := 2 // borders
+		if s.autoIndex {
+			w += len(strconv.Itoa(len(m.body))) + 2 + 1
+		}
+		w += m.numCols - 1
+		for _, cw := range widths {
+			w += cw + 2
+		}
+		return w
+	}
+	// Size.WidthMin: columns grow round-robin until the width is met
+	if pad := s.sizeWidthMin - width(); pad > 0 {
+		for pad > 0 {
+			n := 0
+			for c := 0; c < m.numCols && pad > 0; c++ {
+				if mx := m.configs[c].WidthMax; mx == 0 || widths[c] < mx {
+					widths[c]++
+					n++
+					pad--
+				}
+			}
+			if n == 0 {
+				break
+			}
+		}
+	}
+	rm.width = width()
+	rm.colWidths = widths
+	lines := func(r []string) int {
+		if len(r) == 0 {
+			return 1
+		}
+		n := 1
+		for c, v := range r {
+			if mx := m.configs[c].WidthMax; mx > 0 {
+				v = text.WrapText(v, mx)
+			}
+			if k := strings.Count(v, "\n") + 1; k > n {
+				n = k
+			}
+		}
+		return n
+	}
+	sum := func(rs [][]string) int {
+		n := 0
+		for _, r := range rs {
+			n += lines(r)
+		}
+		if s.separateRows && len(rs) > 1 {
+			n += len(rs) - 1
+		}
+		return n
+	}
+	if s.title != "" {
+		rm.titleLines = 1 + strings.Count(text.WrapText(s.title, rm.width-4), "\n") + 1
+	}
+	if len(m.header) > 0 {
+		rm.headLines = sum(m.header) + 1
+	} else if s.autoIndex {
+		rm.headLines = 2
+	}
+	rm.bodyStart = rm.titleLines + 1 + rm.headLines
+	for _, r := range m.body {
+		rm.rowLines = append(rm.rowLines, lines(r))
+	}
+	rm.total = rm.bodyStart + sum(m.body)
+	if len(m.footer) > 0 {
+		if len(m.body) > 0 {
+			rm.total++
+		}
+		rm.total += sum(m.footer)
+	}
+	rm.total++ // bottom border
+	if s.caption != "" {
+		rm.total++
+	}
+	return rm
+}
