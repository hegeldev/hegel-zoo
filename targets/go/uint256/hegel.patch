+}
+
+// jsonForms: how the number reaches UnmarshalJSON through encoding/json, in a document with an
+// Int field and a *Int field: as a quoted string, as a bare number, or as null (the no-op of
+// the package's convention and of big.Int; the shape of uint256/2, left out under
+// HEGEL_NO_KNOWN=1).
+var jsonForms = shaped(hegel.SampledFrom([]string{"quoted", "bare", "null"}), hegel.SampledFrom([]string{"quoted", "bare"}))
+
+// parserCase: a number string and the JSON form it takes in a document.
+type parserCase struct {
+	num  numberText
+	form string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c parserCase) GoString() string { return fmt.Sprintf("%#v as JSON %s", c.num, c.form) }
+
+var parserCases = hegel.Composite(func(tc hegel.TestCase) parserCase {
+	return parserCase{num: hegel.Draw(tc, numberTexts), form: hegel.Draw(tc, jsonForms)}
+})
+
+// jsonValueText is the JSON value a number string takes in the form: json.Marshal's quoting,
+// the string itself, or null.
+func jsonValueText(s, form string) string {
+	switch form {
+	case "quoted":
+		q, _ := json.Marshal(s)
+		return string(q)
+	case "bare":
+		return s
+	}
+	return "null"
+}
+
+// TestHegelParsersAgreeWithBigInt: SetFromDecimal, SetFromHex, UnmarshalText, UnmarshalJSON,
+// Scan and the From*/MustFrom* constructors accept exactly the documented grammar (decimal digits
+// with an optional '+' and any leading zeros; 0x-prefixed hex without leading zeros) for values
+// up to 2^256-1, reject everything else, and read the same value as math/big; a JSON document
+// with the number quoted, bare or null in an Int field decodes as the grammar says, null being
+// a no-op as for big.Int (uint256/2).
+func TestHegelParsersAgreeWithBigInt(t *testing.T) {
+	decRe := regexp.MustCompile(`^\+?[0-9]+$`)
+	hexRe := regexp.MustCompile(`^0[xX](0|[1-9a-fA-F][0-9a-fA-F]*)$`)
+	// decimalValue is the model of the decimal grammar: the value, or nil for a rejected string.
+	decimalValue := func(s string) *big.Int {
+		if !decRe.MatchString(s) {
+			return nil
+		}
+		b, _ := new(big.Int).SetString(strings.TrimPrefix(s, "+"), 10)
+		if b.Cmp(max256) > 0 {
+			return nil
+		}
+		return b
+	}
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, parserCases)
+		s := c.num.String()
+
+		// the model
+		wantDec := decimalValue(s)
+		var wantHex *big.Int
+		if hexRe.MatchString(s) && len(s) <= 66 {
+			b, _ := new(big.Int).SetString(s[2:], 16)
+			wantHex = b
+		}
+		checkParse := func(name string, z *Int, err error, want *big.Int) {
+			if want == nil {
+				if err == nil {
+					ht.Fatalf("%s(%q) accepted, giving %s", name, s, z.Hex())
+				}
+				return
+			}
+			if err != nil {
+				ht.Fatalf("%s(%q) rejected: %v (want %s)", name, s, err, want.Text(16))
+			}
+			if bigOf(z).Cmp(want) != 0 {
+				ht.Fatalf("%s(%q) = %s want %s", name, s, z.Hex(), want.Text(16))
+			}
+		}
+		var z Int
+		z.SetAllOne()
+		checkParse("SetFromDecimal", &z, z.SetFromDecimal(s), wantDec)
+		z.SetAllOne()
+		checkParse("SetFromHex", &z, z.SetFromHex(s), wantHex)
+		fd, err := FromDecimal(s)
+		if fd == nil {
+			fd = new(Int)
+		}
+		checkParse("FromDecimal", fd, err, wantDec)
+		fh, err := FromHex(s)
+		if fh == nil {
+			fh = new(Int)
+		}
+		checkParse("FromHex", fh, err, wantHex)
+		if (wantDec == nil) != panics(func() { MustFromDecimal(s) }) {
+			ht.Fatalf("MustFromDecimal(%q): panic mismatch", s)
+		}
+		if (wantHex == nil) != panics(func() { MustFromHex(s) }) {
+			ht.Fatalf("MustFromHex(%q): panic mismatch", s)
+		}
+		// UnmarshalText takes both grammars, choosing by the prefix
+		wantText := wantDec
+		if len(s) >= 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {
+			wantText = wantHex
+		}
+		z.SetAllOne()
+		checkParse("UnmarshalText", &z, z.UnmarshalText([]byte(s)), wantText)
+		z.SetAllOne()
+		checkParse("UnmarshalJSON(quoted)", &z, z.UnmarshalJSON([]byte(`"`+s+`"`)), wantText)
+		if !strings.Contains(s, `"`) {
+			z.SetAllOne()
+			checkParse("UnmarshalJSON(bare)", &z, z.UnmarshalJSON([]byte(s)), wantDec)
+		}
+		// Scan: decimal, or decimal 'e' exponent; the empty string is zero by design
+		if !strings.Contains(s, "e") && s != "" {
+			z.SetAllOne()
+			checkParse("Scan", &z, z.Scan(s), wantDec)
+		}
+		// through encoding/json, into an Int field and a *Int field: the quoted string reads
+		// as UnmarshalText does, a bare number as a decimal when the document is JSON at all,
+		// and null leaves the Int alone and sets the *Int to nil (what big.Int does)
+		var out struct {
+			A Int
+			B *Int
+		}
+		out.A.SetAllOne()
+		doc := `{"A":` + jsonValueText(s, c.form) + `,"B":` + jsonValueText(s, c.form) + `}`
+		err = json.Unmarshal([]byte(doc), &out)
+		if c.form == "null" {
+			allOnes := new(Int).SetAllOne()
+			if err != nil || !out.A.Eq(allOnes) || out.B != nil {
+				mismatch(ht, known("uint256/2"), "json.Unmarshal(%s): %v, A = %s, B = %v; null is a no-op for an Int field and nil for a *Int", doc, err, out.A.Hex(), out.B)
+			}
+			return
+		}
+		want := wantText
+		if c.form == "bare" {
+			// encoding/json hands UnmarshalJSON the value token: the number without the
+			// JSON whitespace around it
+			want = decimalValue(strings.Trim(s, " \t\r\n"))
+		}
+		if !json.Valid([]byte(doc)) {
+			want = nil
+		}
+		if (err == nil) != (want != nil) {
+			ht.Fatalf("json.Unmarshal(%s): %v, the grammar says %v", doc, err, want)
+		}
+		if want != nil && (bigOf(&out.A).Cmp(want) != 0 || out.B == nil || bigOf(out.B).Cmp(want) != 0) {
+			ht.Fatalf("json.Unmarshal(%s): A = %s, B = %v, want %s", doc, out.A.Hex(), out.B, want.Text(16))
+		}
+	})
+}
