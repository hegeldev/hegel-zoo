+// TestHegelPaddedBytesKeepsTheValue: uint256/5. PaddedBytes is documented as returning a
+// 0-padded slice "at least n bytes" long; when n is shorter than the value it truncates the
+// high bytes instead (NewInt(0x1234).PaddedBytes(1) is [0x34]).
+func TestHegelPaddedBytesKeepsTheValue(t *testing.T) {
+	for _, c := range []struct {
+		x    *Int
+		n    int
+		want []byte
+	}{
+		{NewInt(0x1234), 1, []byte{0x12, 0x34}},
+		{NewInt(0x1234), 0, []byte{0x12, 0x34}},
+		{new(Int).SetAllOne(), 20, bytes.Repeat([]byte{0xff}, 32)},
+		{NewInt(1), 20, append(make([]byte, 19), 1)},
+	} {
+		if got := c.x.PaddedBytes(c.n); !bytes.Equal(got, c.want) {
+			t.Errorf("%s.PaddedBytes(%d) = %x want %x", c.x.Hex(), c.n, got, c.want)
+		}
+	}
+}
