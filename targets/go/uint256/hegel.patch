+// TestHegelUnaryOperationsAndComparisonsMatchBigInt: Not, Neg, Abs, Sign, Sqrt, Log10, BitLen,
+// ByteLen, Byte, ReverseBytes, the uint64 views and every comparison agree with math/big.
+// Float64 is left out (uint256/1: it truncates instead of rounding to nearest).
+func TestHegelUnaryOperationsAndComparisonsMatchBigInt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x, y := genInt(ht), genInt(ht)
+		note(ht, "x=%s y=%s", x.Hex(), y.Hex())
+		bx, by := bigOf(x), bigOf(y)
+		check := func(name string, have *Int, want *big.Int) {
+			if bigOf(have).Cmp(want) != 0 {
+				ht.Fatalf("%s: have %s want %s", name, have.Hex(), want.Text(16))
+			}
+		}
+		check("Not", new(Int).Not(x), new(big.Int).Xor(bx, max256))
+		check("Neg", new(Int).Neg(x), u256(new(big.Int).Neg(bx)))
+		check("Abs", new(Int).Abs(x), u256(new(big.Int).Abs(s256(bx))))
+		check("Sqrt", new(Int).Sqrt(x), new(big.Int).Sqrt(bx))
+		check("ISqrt", x.Clone().ISqrt(), new(big.Int).Sqrt(bx))
+		xc := x.Clone()
+		check("Not z==x", xc.Not(xc), new(big.Int).Xor(bx, max256))
+		xc = x.Clone()
+		check("Neg z==x", xc.Neg(xc), u256(new(big.Int).Neg(bx)))
+		xc = x.Clone()
+		check("Sqrt z==x", xc.Sqrt(xc), new(big.Int).Sqrt(bx))
+		if s := x.Sign(); s != s256(bx).Sign() {
+			ht.Fatalf("Sign: have %d want %d", s, s256(bx).Sign())
+		}
+		if l := x.Log10(); l != bigLog10(bx) {
+			ht.Fatalf("Log10: have %d want %d", l, bigLog10(bx))
+		}
+		if l := x.BitLen(); l != bx.BitLen() {
+			ht.Fatalf("BitLen: have %d want %d", l, bx.BitLen())
+		}
+		if l := x.ByteLen(); l != (bx.BitLen()+7)/8 {
+			ht.Fatalf("ByteLen: have %d want %d", l, (bx.BitLen()+7)/8)
+		}
+		if x.IsZero() != (bx.Sign() == 0) {
+			ht.Fatalf("IsZero")
+		}
+		if x.IsUint64() != bx.IsUint64() {
+			ht.Fatalf("IsUint64: have %v", x.IsUint64())
+		}
+		low := new(big.Int).And(bx, new(big.Int).SetUint64(math.MaxUint64)).Uint64()
+		if u, of := x.Uint64WithOverflow(); u != low || of != !bx.IsUint64() {
+			ht.Fatalf("Uint64WithOverflow: have %d,%v want %d,%v", u, of, low, !bx.IsUint64())
+		}
+		if x.Uint64() != low {
+			ht.Fatalf("Uint64")
+		}
+		if c := x.Clone(); c == x || !c.Eq(x) {
+			ht.Fatalf("Clone")
+		}
+		// Byte(n): the n-th byte of the 32-byte big-endian form, 0 beyond it
+		var idx *Int
+		switch n(ht, 0, 3) {
+		case 0:
+			idx = NewInt(uint64(n(ht, 0, 31)))
+		case 1:
+			idx = NewInt(uint64(n(ht, 32, 1000)))
+		case 2:
+			idx = genInt(ht)
+		default:
+			idx = NewInt(uint64(n(ht, 0, 40)))
+		}
+		b32 := padded(bx, 32)
+		wantByte := new(big.Int)
+		if bigOf(idx).Cmp(big.NewInt(32)) < 0 {
+			wantByte.SetUint64(uint64(b32[idx.Uint64()]))
+		}
+		check(fmt.Sprintf("Byte(%s)", idx.Hex()), x.Clone().Byte(idx), wantByte)
+		rev := slices.Clone(b32)
+		slices.Reverse(rev)
+		check("ReverseBytes", new(Int).ReverseBytes(x), new(big.Int).SetBytes(rev))
+		xc = x.Clone()
+		check("ReverseBytes z==x", xc.ReverseBytes(xc), new(big.Int).SetBytes(rev))
+		if r := new(Int).ReverseBytes(new(Int).ReverseBytes(x)); !r.Eq(x) {
+			ht.Fatalf("ReverseBytes twice: %s", r.Hex())
+		}
+
+		// comparisons
+		cmp := bx.Cmp(by)
+		if x.Cmp(y) != cmp || x.Eq(y) != (cmp == 0) || x.Lt(y) != (cmp < 0) || x.Gt(y) != (cmp > 0) {
+			ht.Fatalf("Cmp/Eq/Lt/Gt: %d %v %v %v want %d", x.Cmp(y), x.Eq(y), x.Lt(y), x.Gt(y), cmp)
+		}
+		scmp := s256(bx).Cmp(s256(by))
+		if x.Slt(y) != (scmp < 0) || x.Sgt(y) != (scmp > 0) {
+			ht.Fatalf("Slt/Sgt: %v %v want %d", x.Slt(y), x.Sgt(y), scmp)
+		}
+		w := genWord(ht)
+		bw := new(big.Int).SetUint64(w)
+		if x.CmpUint64(w) != bx.Cmp(bw) || x.LtUint64(w) != (bx.Cmp(bw) < 0) || x.GtUint64(w) != (bx.Cmp(bw) > 0) {
+			ht.Fatalf("CmpUint64(%d): %d %v %v want %d", w, x.CmpUint64(w), x.LtUint64(w), x.GtUint64(w), bx.Cmp(bw))
+		}
+		gb := genBig(ht)
+		if c := x.CmpBig(gb); c != bx.Cmp(gb) {
+			ht.Fatalf("CmpBig(%s): have %d want %d", gb, c, bx.Cmp(gb))
+		}
+		if x.Cmp(x) != 0 || !x.Eq(x.Clone()) || x.Lt(x) || x.Gt(x) || x.Slt(x) || x.Sgt(x) {
+			ht.Fatalf("reflexivity")
+		}
+	})
+}
