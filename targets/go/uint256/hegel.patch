+// TestHegelEncodingsRoundTripAndMatchBigInt: byte, hex, decimal, fmt, text, JSON, SSZ, RLP and
+// database encodings agree with math/big's view of the value and read back to it.
+func TestHegelEncodingsRoundTripAndMatchBigInt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x := genInt(ht)
+		note(ht, "x=%s", x.Hex())
+		bx := bigOf(x)
+
+		// bytes
+		if b := x.Bytes(); !bytes.Equal(b, bx.Bytes()) {
+			ht.Fatalf("Bytes: %x want %x", b, bx.Bytes())
+		}
+		b32 := x.Bytes32()
+		if !bytes.Equal(b32[:], padded(bx, 32)) {
+			ht.Fatalf("Bytes32: %x", b32)
+		}
+		b20 := x.Bytes20()
+		if !bytes.Equal(b20[:], padded(bx, 32)[12:]) {
+			ht.Fatalf("Bytes20: %x", b20)
+		}
+		var a32 [32]byte
+		x.WriteToArray32(&a32)
+		if a32 != b32 {
+			ht.Fatalf("WriteToArray32")
+		}
+		var a20 [20]byte
+		x.WriteToArray20(&a20)
+		if a20 != b20 {
+			ht.Fatalf("WriteToArray20")
+		}
+		k := pick(ht, []int{0, 1, 7, 8, 9, 15, 16, 17, 20, 23, 24, 25, 31, 32, 33, 40, n(ht, 0, 48)})
+		dest := bytes.Repeat([]byte{0xee}, k)
+		x.WriteToSlice(dest)
+		wantSlice := bytes.Repeat([]byte{0xee}, k)
+		if k >= 32 {
+			copy(wantSlice, b32[:])
+		} else {
+			copy(wantSlice, b32[32-k:])
+		}
+		if !bytes.Equal(dest, wantSlice) {
+			ht.Fatalf("WriteToSlice(%d): %x want %x", k, dest, wantSlice)
+		}
+		if k >= 32 {
+			dest2 := bytes.Repeat([]byte{0xee}, k)
+			x.PutUint256(dest2)
+			if !bytes.Equal(dest2, wantSlice) {
+				ht.Fatalf("PutUint256(%d): %x", k, dest2)
+			}
+		}
+		// PaddedBytes with room for the value (n below the byte length is uint256/5)
+		pn := n(ht, x.ByteLen(), 40)
+		if p := x.PaddedBytes(pn); !bytes.Equal(p, padded(bx, pn)) {
+			ht.Fatalf("PaddedBytes(%d): %x want %x", pn, p, padded(bx, pn))
+		}
+		// SetBytes on any length, SetBytesN on exact lengths
+		buf := genBytes(ht, n(ht, 0, 40))
+		if chance(ht, 50) {
+			buf = padded(bx, n(ht, 0, 40))
+			if len(buf) < bx.BitLen()/8 {
+				buf = bx.Bytes()
+			}
+		}
+		wantSet := new(big.Int).SetBytes(buf)
+		if len(buf) > 32 {
+			wantSet.SetBytes(buf[len(buf)-32:])
+		}
+		if r := new(Int).SetBytes(buf); bigOf(r).Cmp(wantSet) != 0 {
+			ht.Fatalf("SetBytes(%x) = %s want %s", buf, r.Hex(), wantSet.Text(16))
+		}
+		if len(buf) >= 1 && len(buf) <= 32 {
+			if r := setBytesN(len(buf), buf); bigOf(r).Cmp(new(big.Int).SetBytes(buf)) != 0 {
+				ht.Fatalf("SetBytes%d(%x) = %s", len(buf), buf, r.Hex())
+			}
+		}
+		if len(buf) > 32 {
+			for _, l := range []int{8, 16, 24, 32} {
+				if r := setBytesN(l, buf); bigOf(r).Cmp(new(big.Int).SetBytes(buf[:l])) != 0 {
+					ht.Fatalf("SetBytes%d on a longer slice = %s", l, r.Hex())
+				}
+			}
+		}
+		if r := new(Int).SetBytes(x.Bytes()); !r.Eq(x) {
+			ht.Fatalf("SetBytes(Bytes()) round trip")
+		}
+
+		// strings
+		if h := x.Hex(); h != fmt.Sprintf("%#x", bx) {
+			ht.Fatalf("Hex: %s want %#x", h, bx)
+		}
+		if d := x.Dec(); d != bx.Text(10) || x.String() != d {
+			ht.Fatalf("Dec: %s want %s", d, bx.Text(10))
+		}
+		sep := pick(ht, []byte{',', '.', '_', ' ', '\''})
+		if p := x.PrettyDec(sep); p != prettyDec(bx, sep) {
+			ht.Fatalf("PrettyDec(%q): %s want %s", sep, p, prettyDec(bx, sep))
+		}
+		if !x.Eq(MustFromHex(x.Hex())) || !x.Eq(MustFromDecimal(x.Dec())) {
+			ht.Fatalf("Hex/Dec round trip")
+		}
+		// fmt: the Formatter agrees with big.Int's for every verb, flag, width and precision
+		format := genFormat(ht)
+		if have, want := fmt.Sprintf(format, x), fmt.Sprintf(format, bx); have != want {
+			ht.Fatalf("Sprintf(%q): %q want %q", format, have, want)
+		}
+		// (a plain Int value is a [4]uint64 to fmt — Format has a pointer receiver)
+
+		// text, JSON, SQL
+		if txt, err := x.MarshalText(); err != nil || string(txt) != bx.Text(10) {
+			ht.Fatalf("MarshalText: %q %v", txt, err)
+		}
+		var back Int
+		if err := back.UnmarshalText([]byte(bx.Text(10))); err != nil || !back.Eq(x) {
+			ht.Fatalf("UnmarshalText(decimal): %v", err)
+		}
+		if err := back.UnmarshalText([]byte(x.Hex())); err != nil || !back.Eq(x) {
+			ht.Fatalf("UnmarshalText(hex): %v", err)
+		}
+		if err := back.UnmarshalText([]byte("0X" + strings.ToUpper(x.Hex()[2:]))); err != nil || !back.Eq(x) {
+			ht.Fatalf("UnmarshalText(upper hex): %v", err)
+		}
+		js, err := json.Marshal(x)
+		if err != nil || string(js) != `"`+bx.Text(10)+`"` {
+			ht.Fatalf("MarshalJSON: %s %v", js, err)
+		}
+		var jback Int
+		if err := json.Unmarshal(js, &jback); err != nil || !jback.Eq(x) {
+			ht.Fatalf("UnmarshalJSON(quoted decimal): %v", err)
+		}
+		if err := json.Unmarshal([]byte(`"`+x.Hex()+`"`), &jback); err != nil || !jback.Eq(x) {
+			ht.Fatalf("UnmarshalJSON(quoted hex): %v", err)
+		}
+		if err := json.Unmarshal([]byte(bx.Text(10)), &jback); err != nil || !jback.Eq(x) {
+			ht.Fatalf("UnmarshalJSON(bare number): %v", err)
+		}
+		type wrapper struct {
+			A Int
+			B *Int
+			C []Int
+		}
+		// (addressable, so the pointer-receiver MarshalJSON applies to the value field, as with big.Int)
+		wj, err := json.Marshal(&wrapper{A: *x, B: x, C: []Int{*x, {}}})
+		if err != nil {
+			ht.Fatalf("json.Marshal(wrapper): %v", err)
+		}
+		var wback wrapper
+		if err := json.Unmarshal(wj, &wback); err != nil || !wback.A.Eq(x) || !wback.B.Eq(x) || len(wback.C) != 2 || !wback.C[0].Eq(x) || !wback.C[1].IsZero() {
+			ht.Fatalf("json wrapper round trip: %s %v %+v", wj, err, wback)
+		}
+		v, err := x.Value()
+		if err != nil || v != bx.Text(10) {
+			ht.Fatalf("Value: %v %v", v, err)
+		}
+		var sc Int
+		if err := sc.Scan(v); err != nil || !sc.Eq(x) {
+			ht.Fatalf("Scan(Value()): %v", err)
+		}
+		if err := sc.Scan([]byte(bx.Text(10))); err != nil || !sc.Eq(x) {
+			ht.Fatalf("Scan([]byte): %v", err)
+		}
+		// scientific notation as postgres may print it: mantissa e exponent
+		if e := n(ht, 0, 77); true {
+			mant := bx.Text(10)
+			scaled := new(big.Int).Mul(bx, new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(e)), nil))
+			err := sc.Scan(mant + "e" + strconv.Itoa(e))
+			if scaled.Cmp(max256) > 0 {
+				if err == nil {
+					ht.Fatalf("Scan(%se%d) accepted an out-of-range value: %s", mant, e, sc.Hex())
+				}
+			} else if err != nil || bigOf(&sc).Cmp(scaled) != 0 {
+				ht.Fatalf("Scan(%se%d): %s %v want %s", mant, e, sc.Hex(), err, scaled.Text(10))
+			}
+		}
+		if err := sc.Scan(nil); err != nil || !sc.IsZero() {
+			ht.Fatalf("Scan(nil): %v %s", err, sc.Hex())
+		}
+
+		// SSZ and the hash tree root: 32 little-endian bytes
+		le := make([]byte, 32)
+		binary.LittleEndian.PutUint64(le[0:8], x[0])
+		binary.LittleEndian.PutUint64(le[8:16], x[1])
+		binary.LittleEndian.PutUint64(le[16:24], x[2])
+		binary.LittleEndian.PutUint64(le[24:32], x[3])
+		if ssz, err := x.MarshalSSZ(); err != nil || !bytes.Equal(ssz, le) || x.SizeSSZ() != 32 {
+			ht.Fatalf("MarshalSSZ: %x %v", ssz, err)
+		}
+		if root, err := x.HashTreeRoot(); err != nil || !bytes.Equal(root[:], le) {
+			ht.Fatalf("HashTreeRoot: %x %v", root, err)
+		}
+		prefix := genBytes(ht, n(ht, 0, 5))
+		if app, err := x.MarshalSSZAppend(slices.Clone(prefix)); err != nil || !bytes.Equal(app, append(slices.Clone(prefix), le...)) {
+			ht.Fatalf("MarshalSSZAppend: %x %v", app, err)
+		}
+		into := make([]byte, 32+len(prefix))
+		if rest, err := x.MarshalSSZInto(into); err != nil || !bytes.Equal(into[:32], le) || len(rest) != len(prefix) {
+			ht.Fatalf("MarshalSSZInto: %x %v", into, err)
+		}
+		if _, err := x.MarshalSSZInto(make([]byte, n(ht, 0, 31))); err == nil {
+			ht.Fatalf("MarshalSSZInto accepted a short buffer")
+		}
+		var sback Int
+		if err := sback.UnmarshalSSZ(le); err != nil || !sback.Eq(x) {
+			ht.Fatalf("UnmarshalSSZ: %v", err)
+		}
+		if err := sback.UnmarshalSSZ(le[:n(ht, 0, 31)]); err == nil {
+			ht.Fatalf("UnmarshalSSZ accepted a short buffer")
+		}
+		// RLP
+		var rlp bytes.Buffer
+		if err := x.EncodeRLP(&rlp); err != nil || !bytes.Equal(rlp.Bytes(), rlpOf(bx)) {
+			ht.Fatalf("EncodeRLP: %x want %x", rlp.Bytes(), rlpOf(bx))
+		}
+
+		// big.Int conversions
+		if b := x.ToBig(); b.Cmp(bx) != 0 {
+			ht.Fatalf("ToBig")
+		}
+		var into2 *big.Int
+		x.IntoBig(&into2)
+		if into2.Cmp(bx) != 0 {
+			ht.Fatalf("IntoBig(nil)")
+		}
+		reuse := new(big.Int).Set(genBig(ht))
+		x.IntoBig(&reuse)
+		if reuse.Cmp(bx) != 0 {
+			ht.Fatalf("IntoBig(reused): %s", reuse)
+		}
+		gb := genBig(ht)
+		wantFrom := u256(gb)
+		wantOverflow := new(big.Int).Abs(gb).BitLen() > 256
+		if r, of := FromBig(gb); bigOf(r).Cmp(wantFrom) != 0 || of != wantOverflow {
+			ht.Fatalf("FromBig(%s): %s,%v want %s,%v", gb, r.Hex(), of, wantFrom.Text(16), wantOverflow)
+		}
+		var sfb Int
+		if of := sfb.SetFromBig(gb); bigOf(&sfb).Cmp(wantFrom) != 0 || of != wantOverflow {
+			ht.Fatalf("SetFromBig(%s): %s,%v", gb, sfb.Hex(), of)
+		}
+		if r := MustFromBig(bx); !r.Eq(x) {
+			ht.Fatalf("MustFromBig")
+		}
+		if wantOverflow {
+			if !panics(func() { MustFromBig(gb) }) {
+				ht.Fatalf("MustFromBig(%s) did not panic", gb)
+			}
+		}
+	})
+}
+
+func setBytesN(l int, in []byte) *Int {
+	z := new(Int)
+	switch l {
+	case 1:
+		return z.SetBytes1(in)
+	case 2:
+		return z.SetBytes2(in)
+	case 3:
+		return z.SetBytes3(in)
+	case 4:
+		return z.SetBytes4(in)
+	case 5:
+		return z.SetBytes5(in)
+	case 6:
+		return z.SetBytes6(in)
+	case 7:
+		return z.SetBytes7(in)
+	case 8:
+		return z.SetBytes8(in)
+	case 9:
+		return z.SetBytes9(in)
+	case 10:
+		return z.SetBytes10(in)
+	case 11:
+		return z.SetBytes11(in)
+	case 12:
+		return z.SetBytes12(in)
+	case 13:
+		return z.SetBytes13(in)
+	case 14:
+		return z.SetBytes14(in)
+	case 15:
+		return z.SetBytes15(in)
+	case 16:
