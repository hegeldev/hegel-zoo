+func genNumberString(tc hegel.TestCase) string {
+	digits := func(alphabet string, k int) string {
+		var sb strings.Builder
+		for i := 0; i < k; i++ {
+			sb.WriteByte(alphabet[n(tc, 0, len(alphabet)-1)])
+		}
+		return sb.String()
+	}
+	var s string
+	switch n(tc, 0, 9) {
+	case 0:
+		s = bigOf(genInt(tc)).Text(10)
+	case 1:
+		s = "0x" + bigOf(genInt(tc)).Text(16)
+	case 2:
+		s = digits("0123456789", n(tc, 0, 82))
+	case 3:
+		s = "0x" + digits("0123456789abcdefABCDEF", n(tc, 0, 68))
+	case 4:
+		// around the 2^256 boundary
+		d := new(big.Int).Add(max256, big.NewInt(int64(n(tc, -3, 3))))
+		if chance(tc, 50) {
+			s = d.Text(10)
+		} else {
+			s = "0x" + d.Text(16)
+		}
+	case 5:
+		s = strings.Repeat("0", n(tc, 0, 3)) + bigOf(genInt(tc)).Text(10)
+	case 6:
+		s = "0X" + strings.ToUpper(bigOf(genInt(tc)).Text(16))
+	case 7:
+		s = digits("0123456789abcdefxX+-_ .eE", n(tc, 0, 12))
+	case 8:
+		s = pick(tc, []string{"", "+", "-", "0x", "0X", "x", "-0", "+0", "-1", "0x-1", "-0x1", "0x_1", "1_000", "١", "0b1", "0o7", "1.0", "1e3", " 1", "1 ", "0x 1", "0xx1", "00x1", "+0x1", "0x+1", "٠"})
+	default:
+		s = bigOf(genInt(tc)).Text(10)
+	}
+	if chance(tc, 15) {
+		s = "+" + s
+	}
+	if chance(tc, 10) && len(s) > 0 {
+		// corrupt one byte
+		i := n(tc, 0, len(s)-1)
+		s = s[:i] + pick(tc, []string{"g", "z", "-", "+", " ", ".", "_", "x", "0", "9", "\x00", "é"}) + s[i+1:]
+	}
+	return s
+}
