+func genFormat(tc hegel.TestCase) string {
+	var sb strings.Builder
+	sb.WriteByte('%')
+	for _, f := range []string{"+", "-", " ", "#", "0"} {
+		if chance(tc, 25) {
+			sb.WriteString(f)
+		}
+	}
+	if chance(tc, 50) {
+		sb.WriteString(strconv.Itoa(n(tc, 0, 90)))
+	}
+	if chance(tc, 30) {
+		sb.WriteByte('.')
+		sb.WriteString(strconv.Itoa(n(tc, 0, 80)))
+	}
+	sb.WriteString(pick(tc, []string{"d", "x", "X", "b", "o", "O", "v", "s", "d", "x"}))
+	return sb.String()
+}
