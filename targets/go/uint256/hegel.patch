+// ---- pinned bugs ---------------------------------------------------------------------------
+
+// TestHegelFloat64IsTheNearestFloat: uint256/1. Float64 is documented as "the float64 value
+// nearest to x" but truncates the mantissa: 2^65-1 gives 2^65-2^13 (9007199254740991p+12)
+// where the nearest float64 is 2^65, and 2^256-1 gives 2^256-2^204 instead of 2^256.
+func TestHegelFloat64IsTheNearestFloat(t *testing.T) {
+	for _, hex := range []string{"0x1ffffffffffffffff", "0x10000000000000fff", "0x10000000000000800", "0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff", "0x1fffffffffffff8000000000000000000000"} {
+		x := MustFromHex(hex)
+		want, _ := new(big.Float).SetInt(x.ToBig()).Float64()
+		if have := x.Float64(); have != want {
+			t.Errorf("%s.Float64() = %b (%g), nearest is %b (%g)", hex, have, have, want, want)
+		}
+	}
+}
+
+// TestHegelUnmarshalJSONAcceptsNull: uint256/2. encoding/json passes the literal null to
+// UnmarshalJSON, and Unmarshalers (big.Int among them) treat it as a no-op; uint256 returns
+// strconv.ParseUint: parsing "null": invalid syntax, so any document with a null in an Int
+// field fails to decode.
+func TestHegelUnmarshalJSONAcceptsNull(t *testing.T) {
+	var s struct {
+		A Int
+		B *Int
+	}
+	if err := json.Unmarshal([]byte(`{"A":null,"B":null}`), &s); err != nil {
+		t.Errorf("json.Unmarshal with null fields: %v", err)
+	}
+	var bs struct{ A big.Int }
+	if err := json.Unmarshal([]byte(`{"A":null}`), &bs); err != nil {
+		t.Errorf("big.Int rejects null too: %v", err)
+	}
+	z := NewInt(7)
+	if err := z.UnmarshalJSON([]byte("null")); err != nil || !z.Eq(NewInt(7)) {
+		t.Errorf("UnmarshalJSON(null): err=%v z=%s (want a no-op)", err, z.Hex())
+	}
+}
+
+// TestHegelNilReceiversDoNotPanic: uint256/3. Format, ToBig, IntoBig and EncodeRLP handle a nil
+// *Int (printing <nil>, returning nil, encoding 0x80), and big.Int's String/MarshalText return
+// "<nil>" and MarshalJSON "null"; String, Dec, Hex, MarshalText, MarshalJSON and Value on a nil
+// *Int dereference it and panic.
+func TestHegelNilReceiversDoNotPanic(t *testing.T) {
+	var z *Int
+	var bz *big.Int
+	if got := fmt.Sprintf("%v %d %x", z, z, z); got != "<nil> <nil> <nil>" {
+		t.Errorf("Format on nil: %q", got)
+	}
+	for name, f := range map[string]func() string{
+		"String":      func() string { return z.String() },
+		"Dec":         func() string { return z.Dec() },
+		"Hex":         func() string { return z.Hex() },
+		"MarshalText": func() string { b, _ := z.MarshalText(); return string(b) },
+		"MarshalJSON": func() string { b, _ := z.MarshalJSON(); return string(b) },
+		"Value":       func() string { v, _ := z.Value(); return fmt.Sprint(v) },
+	} {
+		var got string
+		if panics(func() { got = f() }) {
+			t.Errorf("(*Int)(nil).%s panics", name)
+		} else {
+			t.Logf("(*Int)(nil).%s = %q", name, got)
+		}
+	}
+	if s := bz.String(); s != "<nil>" {
+		t.Errorf("big.Int String on nil: %q", s)
+	}
+	if b, err := bz.MarshalJSON(); err != nil || string(b) != "null" {
+		t.Errorf("big.Int MarshalJSON on nil: %q %v", b, err)
+	}
+}
+
+// TestHegelMulDivOverflowRemHandlesAliasing: uint256/4. The remainder argument is cleared
+// before the division reads the divisor, so MulDivOverflowRem(x, y, d, d) divides by zero and
+// panics with an index out of range; and when the remainder aliases the receiver, the quotient
+// overwrites it, so z.MulDivOverflowRem(x, y, d, z) returns the quotient twice. DivMod
+// un-aliases z == m; the other operand aliases (z == x, m == x) work.
+func TestHegelMulDivOverflowRemHandlesAliasing(t *testing.T) {
+	x, y, d := NewInt(7), NewInt(9), NewInt(5)
+	if panics(func() { new(Int).MulDivOverflowRem(x, y, d, d) }) {
+		t.Errorf("MulDivOverflowRem(7, 9, 5, m == d) panics")
+	} else if !d.Eq(NewInt(3)) {
+		t.Errorf("MulDivOverflowRem(7, 9, 5, m == d): remainder %s want 3", d.Hex())
+	}
+	z := new(Int)
+	q, m, _ := z.MulDivOverflowRem(NewInt(7), NewInt(9), NewInt(5), z)
+	if !q.Eq(NewInt(12)) || !m.Eq(NewInt(3)) {
+		t.Errorf("z.MulDivOverflowRem(7, 9, 5, z) = %s, %s want 12, 3", q.Hex(), m.Hex())
+	}
+}
+
+// TestHegelPaddedBytesKeepsTheValue: uint256/5. PaddedBytes is documented as returning a
+// 0-padded slice "at least n bytes" long; when n is shorter than the value it truncates the
+// high bytes instead (NewInt(0x1234).PaddedBytes(1) is [0x34]).
+func TestHegelPaddedBytesKeepsTheValue(t *testing.T) {
+	for _, c := range []struct {
+		x    *Int
+		n    int
+		want []byte
+	}{
+		{NewInt(0x1234), 1, []byte{0x12, 0x34}},
+		{NewInt(0x1234), 0, []byte{0x12, 0x34}},
+		{new(Int).SetAllOne(), 20, bytes.Repeat([]byte{0xff}, 32)},
+		{NewInt(1), 20, append(make([]byte, 19), 1)},
+	} {
+		if got := c.x.PaddedBytes(c.n); !bytes.Equal(got, c.want) {
+			t.Errorf("%s.PaddedBytes(%d) = %x want %x", c.x.Hex(), c.n, got, c.want)
+		}
+	}
+}
