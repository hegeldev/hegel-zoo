diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..f59e7bb
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,366 @@
+package uint256_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the same oracle as the wide property that found the bug
+// (math/big, encoding/json's handling of big.Int), so that each bug has a property that finds
+// it every run; the wide properties in hegel_test.go reach the shapes at their natural rate.
+// Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch instead
+// (values float64 holds exactly, documents without null, non-nil receivers, the other
+// aliasing forms, n at or above the byte length) and passes.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"strings"
+	"testing"
+
+	. "github.com/holiman/uint256"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- uint256/1
+
+// wideInts: a value of 65 to 256 bits: a 53-bit head, the bit below it (which decides the
+// rounding; off first), and a random tail below that, so that Float64 has to round; exactInts
+// (hegel_test.go) is the region beside it.
+var wideInts = hegel.Composite(func(tc hegel.TestCase) *Int {
+	bits := hegel.Draw(tc, hegel.Integers(65, 256))
+	head := NewInt(hegel.Draw(tc, hegel.Integers[uint64](1<<52, 1<<53-1)))
+	half := hegel.Draw(tc, hegel.Booleans())
+	tail := hegel.Draw(tc, fromBytes)
+	below := uint(bits - 53)
+	tail.And(tail, new(Int).SubUint64(new(Int).Lsh(NewInt(1), below-1), 1))
+	if half {
+		tail.Or(tail, new(Int).Lsh(NewInt(1), below-1))
+	}
+	return head.Lsh(head, below).Or(head, tail)
+})
+
+// TestHegelFloat64RoundsToNearest: Float64 of a value wider than a float64's mantissa is the
+// nearest float64, as big.Float rounds it; the library truncates the mantissa (uint256/1).
+func TestHegelFloat64RoundsToNearest(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x := hegel.Draw(ht, shaped(wideInts, exactInts))
+		if have, want := x.Float64(), nearestFloat64(x.ToBig()); have != want {
+			mismatch(ht, known("uint256/1"), "Float64(%s) = %b (%g), nearest is %b (%g)", x.Hex(), have, have, want, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uint256/2
+
+// jsonValue is the value of an Int field in a JSON document: a bare number, a quoted decimal,
+// a quoted hex, or null.
+type jsonValue struct {
+	kind string
+	x    *Int
+}
+
+func (v jsonValue) text() string {
+	switch v.kind {
+	case "number":
+		return v.x.Dec()
+	case "decimal":
+		return `"` + v.x.Dec() + `"`
+	case "hex":
+		return `"` + v.x.Hex() + `"`
+	}
+	return "null"
+}
+
+func (v jsonValue) isNull() bool { return v.kind == "null" }
+
+// jsonValuesOf draws a value of one of the kinds.
+func jsonValuesOf(kinds []string) hegel.Generator[jsonValue] {
+	return hegel.Composite(func(tc hegel.TestCase) jsonValue {
+		return jsonValue{kind: hegel.Draw(tc, hegel.SampledFrom(kinds)), x: hegel.Draw(tc, ints)}
+	})
+}
+
+var (
+	valueKinds    = []string{"number", "decimal", "hex", "null"}
+	nonNullKinds  = valueKinds[:3]
+	intValues     = shaped(jsonValuesOf(valueKinds), jsonValuesOf(nonNullKinds))
+	pointerValues = jsonValuesOf(valueKinds)
+	// nullSlots: which Int slot of the document (A, B, then the elements of L) is made null:
+	// one of them by default (the shape of uint256/2), none under HEGEL_NO_KNOWN=1.
+	nullSlots = shaped(hegel.Integers(0, 7), hegel.Just(-1))
+)
+
+// jsonDoc is a document for a struct with two Int fields, a *Int field and a []Int field.
+type jsonDoc struct {
+	a, b   jsonValue
+	p      jsonValue
+	l      []jsonValue
+	nullAt int
+}
+
+// slots are the Int values with the forced null applied.
+func (d jsonDoc) slots() (a, b jsonValue, l []jsonValue) {
+	a, b, l = d.a, d.b, append([]jsonValue{}, d.l...)
+	if d.nullAt >= 0 {
+		null := jsonValue{kind: "null"}
+		switch i := d.nullAt % (2 + len(l)); i {
+		case 0:
+			a = null
+		case 1:
+			b = null
+		default:
+			l[i-2] = null
+		}
+	}
+	return a, b, l
+}
+
+func (d jsonDoc) text() string {
+	a, b, l := d.slots()
+	items := make([]string, len(l))
+	for i, v := range l {
+		items[i] = v.text()
+	}
+	return fmt.Sprintf(`{"A":%s,"B":%s,"P":%s,"L":[%s]}`, a.text(), b.text(), d.p.text(), strings.Join(items, ","))
+}
+
+// quoted reports whether the document holds a quoted value (which big.Int does not read).
+func (d jsonDoc) quoted() bool {
+	a, b, l := d.slots()
+	for _, v := range append([]jsonValue{a, b, d.p}, l...) {
+		if v.kind == "decimal" || v.kind == "hex" {
+			return true
+		}
+	}
+	return false
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (d jsonDoc) GoString() string { return d.text() }
+
+var jsonDocs = hegel.Composite(func(tc hegel.TestCase) jsonDoc {
+	return jsonDoc{
+		a:      hegel.Draw(tc, intValues),
+		b:      hegel.Draw(tc, intValues),
+		p:      hegel.Draw(tc, pointerValues),
+		l:      hegel.Draw(tc, hegel.Lists(intValues).MaxSize(3)),
+		nullAt: hegel.Draw(tc, nullSlots),
+	}
+})
+
+// TestHegelJSONNullInIntFieldsIsANoOp: a document with null in an Int field beside numbers
+// and quoted strings decodes: the null leaves the Int as it was (a fresh element of a slice
+// stays zero), a null *Int is nil, and the other fields read their values; big.Int reads the
+// same document (without quoted values) the same way. UnmarshalJSON rejects the null
+// (uint256/2).
+func TestHegelJSONNullInIntFieldsIsANoOp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, jsonDocs)
+		doc := d.text()
+		a, b, l := d.slots()
+		var out struct {
+			A, B Int
+			P    *Int
+			L    []Int
+		}
+		allOnes := new(Int).SetAllOne()
+		out.A.SetAllOne()
+		out.B.SetAllOne()
+		if err := json.Unmarshal([]byte(doc), &out); err != nil {
+			mismatch(ht, known("uint256/2"), "json.Unmarshal(%s): %v", doc, err)
+		}
+		wantOf := func(v jsonValue, unchanged *Int) *Int {
+			if v.isNull() {
+				return unchanged
+			}
+			return v.x
+		}
+		if !out.A.Eq(wantOf(a, allOnes)) || !out.B.Eq(wantOf(b, allOnes)) {
+			ht.Fatalf("json.Unmarshal(%s): A = %s, B = %s; want %s, %s", doc, out.A.Hex(), out.B.Hex(), wantOf(a, allOnes).Hex(), wantOf(b, allOnes).Hex())
+		}
+		if d.p.isNull() != (out.P == nil) || (out.P != nil && !out.P.Eq(d.p.x)) {
+			ht.Fatalf("json.Unmarshal(%s): P = %v; want %s", doc, out.P, d.p.text())
+		}
+		if len(out.L) != len(l) {
+			ht.Fatalf("json.Unmarshal(%s): L has %d elements, want %d", doc, len(out.L), len(l))
+		}
+		for i, v := range l {
+			if !out.L[i].Eq(wantOf(v, new(Int))) {
+				ht.Fatalf("json.Unmarshal(%s): L[%d] = %s; want %s", doc, i, out.L[i].Hex(), wantOf(v, new(Int)).Hex())
+			}
+		}
+		if !d.quoted() {
+			var twin struct {
+				A, B big.Int
+				P    *big.Int
+				L    []big.Int
+			}
+			if err := json.Unmarshal([]byte(doc), &twin); err != nil {
+				ht.Fatalf("big.Int reads %s: %v", doc, err)
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uint256/3
+
+// nilCase: a slice of values with one of them nil by default (the shape of uint256/3; none
+// under HEGEL_NO_KNOWN=1), and the encoder to call on each.
+type nilCase struct {
+	items   []*Int
+	nilAt   int
+	encoder string
+}
+
+// receivers are the items with the nil applied.
+func (c nilCase) receivers() []*Int {
+	items := append([]*Int{}, c.items...)
+	if c.nilAt >= 0 {
+		items[c.nilAt%len(items)] = nil
+	}
+	return items
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nilCase) GoString() string {
+	var hexes []string
+	for _, z := range c.receivers() {
+		if z == nil {
+			hexes = append(hexes, "nil")
+		} else {
+			hexes = append(hexes, z.Hex())
+		}
+	}
+	return fmt.Sprintf("%s on [%s]", c.encoder, strings.Join(hexes, " "))
+}
+
+var (
+	encoderNames = func() []string {
+		names := make([]string, len(encoders))
+		for i, e := range encoders {
+			names[i] = e.name
+		}
+		return names
+	}()
+	nilSlots = shaped(hegel.Integers(0, 7), hegel.Just(-1))
+	nilCases = hegel.Composite(func(tc hegel.TestCase) nilCase {
+		return nilCase{
+			items:   hegel.Draw(tc, hegel.Lists(ints).MinSize(1).MaxSize(4)),
+			nilAt:   hegel.Draw(tc, nilSlots),
+			encoder: hegel.Draw(tc, hegel.SampledFrom(encoderNames)),
+		}
+	})
+)
+
+func encoderNamed(name string) encoder {
+	for _, e := range encoders {
+		if e.name == name {
+			return e
+		}
+	}
+	panic("no encoder " + name)
+}
+
+// TestHegelEncodersAcceptANilReceiver: every encoder, called on each element of a slice of
+// *Int, gives big.Int's text for a value and does not panic on a nil element, as Format,
+// ToBig and EncodeRLP (and big.Int's String, MarshalText and MarshalJSON) do not; String,
+// Dec, Hex, MarshalText, MarshalJSON and Value dereference the nil (uint256/3).
+func TestHegelEncodersAcceptANilReceiver(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nilCases)
+		e := encoderNamed(c.encoder)
+		for i, z := range c.receivers() {
+			text, err, panicked := e.callOn(z)
+			if panicked != nil {
+				mismatch(ht, shapeIf(z == nil, "uint256/3"), "item %d: %s on %v panics: %v", i, e.name, z, panicked)
+			}
+			if err != nil {
+				ht.Fatalf("item %d: %s on %v: %v", i, e.name, z, err)
+			}
+			if z != nil && text != e.want(z.ToBig()) {
+				ht.Fatalf("item %d: %s(%s) = %q, want %q", i, e.name, z.Hex(), text, e.want(z.ToBig()))
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uint256/4
+
+// remCase: the operands of MulDivOverflowRem and its aliasing form: the remainder aliasing the
+// divisor or the result by default (the shape of uint256/4), one of the other forms under
+// HEGEL_NO_KNOWN=1.
+type remCase struct {
+	x, y, d *Int
+	alias   string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c remCase) GoString() string {
+	return fmt.Sprintf("MulDivOverflowRem(%s, %s, %s) %s", c.x.Hex(), c.y.Hex(), c.d.Hex(), c.alias)
+}
+
+var (
+	knownRemAliases = shaped(hegel.SampledFrom(remAliasForms[6:]), hegel.SampledFrom(remAliasForms[:6]))
+	remCases        = hegel.Composite(func(tc hegel.TestCase) remCase {
+		return remCase{
+			x:     hegel.Draw(tc, ints),
+			y:     hegel.Draw(tc, ints),
+			d:     hegel.Draw(tc, ints),
+			alias: hegel.Draw(tc, knownRemAliases),
+		}
+	})
+)
+
+// TestHegelMulDivOverflowRemAliasesTheRemainderWithAnyOperand: z.MulDivOverflowRem(x, y, d, m)
+// with m aliasing d or z gives the quotient and remainder of x*y by d, as big.Int's DivMod does
+// and as the other aliasing forms do; m == d panics and m == z returns the quotient twice
+// (uint256/4).
+func TestHegelMulDivOverflowRemAliasesTheRemainderWithAnyOperand(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, remCases)
+		bx, by, bd := c.x.ToBig(), c.y.ToBig(), c.d.ToBig()
+		wantQ, wantR := new(big.Int), new(big.Int)
+		wantOverflow := false
+		if bd.Sign() != 0 {
+			wantQ.DivMod(new(big.Int).Mul(bx, by), bd, wantR)
+			wantOverflow = wantQ.Cmp(two256) >= 0
+			wantQ = u256(wantQ)
+		}
+		q, r, of, panicked := mulDivRem(c.x, c.y, c.d, c.alias)
+		if panicked != nil {
+			mismatch(ht, remAliasShape(c.alias), "MulDivOverflowRem %s panics: %v", c.alias, panicked)
+		}
+		if bigOf(q).Cmp(wantQ) != 0 || bigOf(r).Cmp(wantR) != 0 || of != wantOverflow {
+			mismatch(ht, remAliasShape(c.alias), "MulDivOverflowRem %s: have %s,%s,%v want %s,%s,%v", c.alias, q.Hex(), r.Hex(), of, wantQ.Text(16), wantR.Text(16), wantOverflow)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uint256/5
+
+// padCase: a non-zero value and the n of PaddedBytes: below the byte length by default (the
+// shape of uint256/5), at or above it under HEGEL_NO_KNOWN=1.
+type padCase struct {
+	x *Int
+	n int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c padCase) GoString() string { return fmt.Sprintf("%s.PaddedBytes(%d)", c.x.Hex(), c.n) }
+
+var padCases = hegel.FlatMap(hegel.Filter(ints, func(x *Int) bool { return !x.IsZero() }), func(x *Int) hegel.Generator[padCase] {
+	below := hegel.Integers(0, x.ByteLen()-1)
+	atLeast := hegel.Map(hegel.Integers(0, 8), func(d int) int { return x.ByteLen() + d })
+	return hegel.Map(shaped(below, atLeast), func(n int) padCase { return padCase{x: x, n: n} })
+})
+
+// TestHegelPaddedBytesNeverTruncates: PaddedBytes(n) is the value's bytes padded with zeros to
+// at least n, so for n below the byte length it is the bytes themselves; the library returns
+// the low n bytes (uint256/5).
+func TestHegelPaddedBytesNeverTruncates(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, padCases)
+		want := padded(c.x.ToBig(), c.n)
+		if got := c.x.PaddedBytes(c.n); string(got) != string(want) {
+			mismatch(ht, known("uint256/5"), "%s.PaddedBytes(%d) = %x, want %x", c.x.Hex(), c.n, got, want)
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..637c75c
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1730 @@
+// Hegel property tests for github.com/holiman/uint256, with math/big as the oracle.
+//
+// Every property draws one case record built from the binding's combinators
+// (the operands, which operation, which aliasing form, the encoding lengths,
+// a fmt spec, a number string) and pure functions render the record into the
+// values the library and the oracle see. The shapes of the recorded bugs
+// (bugs.toml) are drawn by default, so the properties that meet them fail,
+// naming the shape, and are the expected failures mapped to the bugs
+// (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over its
+// shape region alone, and the pins at the end of this file are the regression
+// examples. HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below)
+// for a run that looks past the bugs.
+package uint256_test
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"regexp"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+
+	. "github.com/holiman/uint256"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ---- known bugs ----------------------------------------------------------------------------
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// generators draw the bugs' shapes and the properties that meet them fail, naming the shape
+// (mismatch); under HEGEL_NO_KNOWN=1 the switches of Known are on: the shapes are left out of
+// the generators (shaped) and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the input shapes of the recorded bugs; on means the shape is left out, which is
+// so only under HEGEL_NO_KNOWN=1. The pins at the end of this file assert the correct
+// behaviour and fail while a bug is open, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	float64Truncates    bool // uint256/1: Float64 truncates the mantissa instead of rounding to nearest
+	jsonNullRejected    bool // uint256/2: UnmarshalJSON rejects the null encoding/json hands to Unmarshalers
+	nilReceiverPanics   bool // uint256/3: String, Dec, Hex, MarshalText, MarshalJSON and Value panic on a nil *Int
+	remainderAliasing   bool // uint256/4: MulDivOverflowRem with m == d panics, with m == z loses the remainder
+	paddedBytesTruncate bool // uint256/5: PaddedBytes drops the high bytes when n is below the byte length
+}{
+	float64Truncates:    noKnown,
+	jsonNullRejected:    noKnown,
+	nilReceiverPanics:   noKnown,
+	remainderAliasing:   noKnown,
+	paddedBytesTruncate: noKnown,
+}
+
+// gates are the switches of Known by bug id.
+var gates = map[string]bool{
+	"uint256/1": Known.float64Truncates,
+	"uint256/2": Known.jsonNullRejected,
+	"uint256/3": Known.nilReceiverPanics,
+	"uint256/4": Known.remainderAliasing,
+	"uint256/5": Known.paddedBytesTruncate,
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the shape of the recorded
+// bugs named (none for a plain failure): the failure names the shape, and while every gate of
+// the shape is on (HEGEL_NO_KNOWN=1) a disagreement on it is skipped instead (never seen then,
+// since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape []string, format string, args ...any) {
+	if len(shape) > 0 {
+		gated := true
+		for _, id := range shape {
+			gated = gated && gates[id]
+		}
+		ht.Assume(!gated)
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	ht.Fatalf(format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise,
+// which is what it shrinks to.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return weighted(choice[*T]{100 - pct, hegel.Just[*T](nil)}, choice[*T]{pct, hegel.Map(g, ptrTo[T])})
+}
+
+// ---- reference arithmetic ------------------------------------------------------------------
+
+var (
+	two256  = new(big.Int).Lsh(big.NewInt(1), 256)
+	two255  = new(big.Int).Lsh(big.NewInt(1), 255)
+	max256  = new(big.Int).Sub(two256, big.NewInt(1))
+	bigZero = new(big.Int)
+)
+
+// u256 reduces b modulo 2^256 (two's complement for negative values).
+func u256(b *big.Int) *big.Int {
+	r := new(big.Int).Mod(b, two256)
+	return r
+}
+
+// s256 interprets b (0 <= b < 2^256) as a two's complement signed number.
+func s256(b *big.Int) *big.Int {
+	if b.Cmp(two255) >= 0 {
+		return new(big.Int).Sub(b, two256)
+	}
+	return new(big.Int).Set(b)
+}
+
+func bigOf(z *Int) *big.Int { return z.ToBig() }
+
+// fromBigExact converts a value known to be in range.
+func fromBigExact(b *big.Int) *Int {
+	z, overflow := FromBig(b)
+	if overflow || b.Sign() < 0 {
+		panic(fmt.Sprintf("fromBigExact: %s out of range", b))
+	}
+	return z
+}
+
+func bigSDiv(x, y *big.Int) *big.Int {
+	if y.Sign() == 0 {
+		return new(big.Int)
+	}
+	sx, sy := s256(x), s256(y)
+	return u256(new(big.Int).Quo(sx, sy)) // Quo truncates toward zero, as the EVM does
+}
+
+func bigSMod(x, y *big.Int) *big.Int {
+	if y.Sign() == 0 {
+		return new(big.Int)
+	}
+	sx, sy := s256(x), s256(y)
+	return u256(new(big.Int).Rem(sx, sy)) // Rem takes the sign of the dividend
+}
+
+func bigExtendSign(x, byteNum *big.Int) *big.Int {
+	if byteNum.Cmp(big.NewInt(30)) > 0 {
+		return new(big.Int).Set(x)
+	}
+	bit := uint(byteNum.Uint64()*8 + 7)
+	mask := new(big.Int).Lsh(big.NewInt(1), bit)
+	mask.Sub(mask, big.NewInt(1))
+	if x.Bit(int(bit)) == 1 {
+		return u256(new(big.Int).Or(x, new(big.Int).Sub(two256, new(big.Int).Add(mask, big.NewInt(1)))))
+	}
+	return new(big.Int).And(x, mask)
+}
+
+func bigLog10(b *big.Int) uint {
+	if b.Sign() == 0 {
+		return 0
+	}
+	return uint(len(b.Text(10)) - 1)
+}
+
+func prettyDec(b *big.Int, sep byte) string {
+	s := b.Text(10)
+	var out []byte
+	for i := 0; i < len(s); i++ {
+		if i > 0 && (len(s)-i)%3 == 0 {
+			out = append(out, sep)
+		}
+		out = append(out, s[i])
+	}
+	return string(out)
+}
+
+func rlpOf(b *big.Int) []byte {
+	if b.Sign() == 0 {
+		return []byte{0x80}
+	}
+	bs := b.Bytes()
+	if len(bs) == 1 && bs[0] < 0x80 {
+		return bs
+	}
+	return append([]byte{0x80 + byte(len(bs))}, bs...)
+}
+
+func padded(b *big.Int, n int) []byte {
+	bs := b.Bytes()
+	if len(bs) >= n {
+		return bs
+	}
+	return append(make([]byte, n-len(bs)), bs...)
+}
+
+// nearestFloat64 is the float64 nearest to b, as big.Float rounds it.
+func nearestFloat64(b *big.Int) float64 {
+	f, _ := new(big.Float).SetInt(b).Float64()
+	return f
+}
+
+func panics(f func()) (p bool) {
+	defer func() {
+		if recover() != nil {
+			p = true
+		}
+	}()
+	f()
+	return false
+}
+
+// ---- generators ----------------------------------------------------------------------------
+
+// words: a 64-bit word: 0, small, a power of two, one below a power of two, all ones, or any
+// word (the full-range draw is magnitude-biased toward small values, hence the explicit shapes).
+var (
+	pow2Words  = hegel.Map(hegel.Integers(0, 63), func(k int) uint64 { return 1 << uint(k) })
+	belowPow2s = hegel.Map(hegel.Integers(0, 63), func(k int) uint64 { return (1 << uint(k)) - 1 })
+	anyWords   = hegel.Integers[uint64](0, math.MaxUint64)
+	words      = hegel.OneOf(
+		hegel.Just[uint64](0),
+		hegel.Integers[uint64](1, 1000),
+		pow2Words,
+		belowPow2s,
+		hegel.Just[uint64](math.MaxUint64),
+		anyWords,
+	)
+	nonZeroWords = hegel.OneOf(hegel.Integers[uint64](1, 1000), pow2Words, hegel.Just[uint64](math.MaxUint64), hegel.Integers[uint64](1, math.MaxUint64))
+)
+
+// pow2Shape is 2^k + delta (modulo 2^256): a power of two or one of its neighbours.
+type pow2Shape struct{ k, delta int }
+
+func (s pow2Shape) value() *Int {
+	z := new(Int).Lsh(NewInt(1), uint(s.k))
+	if s.delta < 0 {
+		return z.SubUint64(z, uint64(-s.delta))
+	}
+	return z.AddUint64(z, uint64(s.delta))
+}
+
+// ints: a 256-bit value with the shapes that matter: zero and one first, then small, one word,
+// four words, a power of two and its neighbours, just below 2^256, the two's complement
+// negative of a small number, around 2^255, a big-endian byte string of any length, a single
+// non-zero word, and a value with its top word non-zero (the fast paths of AddMod/MulMod).
+var (
+	zeroOnes  = hegel.Map(hegel.Integers[uint64](0, 2), NewInt)
+	smallInts = hegel.Map(hegel.Integers[uint64](0, 100000), NewInt)
+	oneWords  = hegel.Map(words, NewInt)
+	fourWords = hegel.Composite(func(tc hegel.TestCase) *Int {
+		return &Int{hegel.Draw(tc, words), hegel.Draw(tc, words), hegel.Draw(tc, words), hegel.Draw(tc, words)}
+	})
+	pow2Nears = hegel.Composite(func(tc hegel.TestCase) *Int {
+		return pow2Shape{k: hegel.Draw(tc, hegel.Integers(0, 255)), delta: hegel.Draw(tc, hegel.Integers(-3, 3))}.value()
+	})
+	nearTops  = hegel.Map(hegel.Integers[uint64](0, 1000), func(d uint64) *Int { return new(Int).SubUint64(new(Int).SetAllOne(), d) })
+	negatives = hegel.Map(hegel.Integers[uint64](1, 100000), func(d uint64) *Int { return new(Int).Neg(NewInt(d)) })
+	near255s  = hegel.Map(hegel.Integers(-3, 3), func(d int) *Int { return pow2Shape{k: 255, delta: d}.value() })
+	fromBytes = hegel.Map(hegel.Binary(0, 32), func(b []byte) *Int { return new(Int).SetBytes(b) })
+	oneOfFour = hegel.Composite(func(tc hegel.TestCase) *Int {
+		z := new(Int)
+		z[hegel.Draw(tc, hegel.Integers(0, 3))] = hegel.Draw(tc, words)
+		return z
+	})
+	topWords = hegel.Composite(func(tc hegel.TestCase) *Int {
+		return &Int{hegel.Draw(tc, words), hegel.Draw(tc, words), hegel.Draw(tc, words), hegel.Draw(tc, nonZeroWords)}
+	})
+	ints = weighted(
+		choice[*Int]{8, zeroOnes},
+		choice[*Int]{8, smallInts},
+		choice[*Int]{8, oneWords},
+		choice[*Int]{16, fourWords},
+		choice[*Int]{10, pow2Nears},
+		choice[*Int]{8, nearTops},
+		choice[*Int]{8, negatives},
+		choice[*Int]{8, near255s},
+		choice[*Int]{10, fromBytes},
+		choice[*Int]{8, oneOfFour},
+		choice[*Int]{8, topWords},
+	)
+)
+
+// bigs: a big.Int that may be negative or wider than 256 bits: a value of ints, its negative,
+// the value plus a few bits above 256, or the negative of the value plus 2^256.
+var bigs = weighted(
+	choice[*big.Int]{40, hegel.Map(ints, (*Int).ToBig)},
+	choice[*big.Int]{20, hegel.Map(ints, func(x *Int) *big.Int { return new(big.Int).Neg(x.ToBig()) })},
+	choice[*big.Int]{20, hegel.Composite(func(tc hegel.TestCase) *big.Int {
+		b := hegel.Draw(tc, ints).ToBig()
+		high := big.NewInt(int64(hegel.Draw(tc, hegel.Integers(1, 1000))))
+		return b.Add(b, high.Lsh(high, uint(hegel.Draw(tc, hegel.Integers(256, 400)))))
+	})},
+	choice[*big.Int]{20, hegel.Map(ints, func(x *Int) *big.Int { b := x.ToBig(); return b.Neg(b.Add(b, two256)) })},
+)
+
+// shifts: a shift amount: within a word's worth of the value, a boundary (word and value
+// widths and their neighbours, past 256), or anywhere up to 300.
+var shifts = weighted(
+	choice[uint]{50, hegel.Integers[uint](0, 255)},
+	choice[uint]{25, hegel.SampledFrom([]uint{0, 1, 63, 64, 65, 127, 128, 129, 191, 192, 193, 254, 255, 256, 257, 511, 512})},
+	choice[uint]{25, hegel.Integers[uint](0, 300)},
+)
+
+// format is a fmt directive: flags, an optional width and precision, and a verb.
+type format struct {
+	flags     string
+	width     *int
+	precision *int
+	verb      string
+}
+
+func (f format) String() string {
+	var sb strings.Builder
+	sb.WriteByte('%')
+	sb.WriteString(f.flags)
+	if f.width != nil {
+		sb.WriteString(strconv.Itoa(*f.width))
+	}
+	if f.precision != nil {
+		sb.WriteByte('.')
+		sb.WriteString(strconv.Itoa(*f.precision))
+	}
+	sb.WriteString(f.verb)
+	return sb.String()
+}
+
+var (
+	// flagSets: a set of the fmt flags, in a drawn order, none most often.
+	flagSets = hegel.Map(hegel.Lists(hegel.SampledFrom([]string{"+", "-", " ", "#", "0"})).MaxSize(5), func(fs []string) string {
+		var out []string
+		for _, f := range fs {
+			if !slices.Contains(out, f) {
+				out = append(out, f)
+			}
+		}
+		return strings.Join(out, "")
+	})
+	verbs   = hegel.SampledFrom([]string{"d", "x", "X", "b", "o", "O", "v", "s", "d", "x"})
+	formats = hegel.Composite(func(tc hegel.TestCase) format {
+		return format{
+			flags:     hegel.Draw(tc, flagSets),
+			width:     hegel.Draw(tc, optional(50, hegel.Integers(0, 90))),
+			precision: hegel.Draw(tc, optional(30, hegel.Integers(0, 80))),
+			verb:      hegel.Draw(tc, verbs),
+		}
+	})
+)
+
+// corruption replaces the byte at position at (modulo the length) with the text with.
+type corruption struct {
+	at   int
+	with string
+}
+
+// numberText is a number string as the parsers see it: a sign, a base prefix, leading zeros,
+// the digits (or something else where the digits go), and an optional corruption.
+type numberText struct {
+	sign    string // "" or "+"
+	base    string // "", "0x" or "0X"
+	zeros   int
+	digits  string
+	corrupt *corruption
+}
+
+func (t numberText) String() string {
+	s := t.sign + t.base + strings.Repeat("0", t.zeros) + t.digits
+	if t.corrupt != nil && len(s) > 0 {
+		i := t.corrupt.at % len(s)
+		s = s[:i] + t.corrupt.with + s[i+1:]
+	}
+	return s
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (t numberText) GoString() string {
+	c := "none"
+	if t.corrupt != nil {
+		c = fmt.Sprintf("%q at %d", t.corrupt.with, t.corrupt.at)
+	}
+	return fmt.Sprintf("%q (sign %q base %q zeros %d digits %q corruption %s)", t.String(), t.sign, t.base, t.zeros, t.digits, c)
+}
+
+var (
+	// oddStrings: strings that are nearly numbers.
+	oddStrings = []string{"", "+", "-", "0x", "0X", "x", "-0", "+0", "-1", "0x-1", "-0x1", "0x_1", "1_000", "\xd9\xa1", "0b1", "0o7", "1.0", "1e3", " 1", "1 ", "0x 1", "0xx1", "00x1", "+0x1", "0x+1", "\xd9\xa0"}
+	// boundaryValues: the values around 2^256.
+	boundaryValues = hegel.Map(hegel.Integers(-3, 3), func(d int) *big.Int { return new(big.Int).Add(max256, big.NewInt(int64(d))) })
+	inBase         = func(base int) func(*big.Int) string { return func(b *big.Int) string { return b.Text(base) } }
+	// decimalDigits: the digits of a value, random decimal digits, a value around 2^256,
+	// junk from the characters a number string can hold, or one of the odd strings.
+	decimalDigits = weighted(
+		choice[string]{40, hegel.Map(hegel.Map(ints, (*Int).ToBig), inBase(10))},
+		choice[string]{15, hegel.Text().Alphabet("0123456789").MaxSize(82)},
+		choice[string]{10, hegel.Map(boundaryValues, inBase(10))},
+		choice[string]{15, hegel.Text().Alphabet("0123456789abcdefxX+-_ .eE").MaxSize(12)},
+		choice[string]{20, hegel.SampledFrom(oddStrings)},
+	)
+	// hexDigits: the digits of a value, random hex digits of either case, a value around 2^256.
+	hexDigits = weighted(
+		choice[string]{50, hegel.Map(hegel.Map(ints, (*Int).ToBig), inBase(16))},
+		choice[string]{25, hegel.Text().Alphabet("0123456789abcdefABCDEF").MaxSize(68)},
+		choice[string]{25, hegel.Map(boundaryValues, inBase(16))},
+	)
+	digitsFor = map[string]hegel.Generator[string]{
+		"":   decimalDigits,
+		"0x": hexDigits,
+		"0X": hegel.Map(hexDigits, strings.ToUpper),
+	}
+	corruptions = hegel.Composite(func(tc hegel.TestCase) corruption {
+		return corruption{
+			at:   hegel.Draw(tc, hegel.Integers(0, 99)),
+			with: hegel.Draw(tc, hegel.SampledFrom([]string{"g", "z", "-", "+", " ", ".", "_", "x", "0", "9", "\x00", "\xc3\xa9"})),
+		}
+	})
+	numberTexts = hegel.Composite(func(tc hegel.TestCase) numberText {
+		base := hegel.Draw(tc, hegel.SampledFrom([]string{"", "0x", "0X"}))
+		return numberText{
+			sign:    hegel.Draw(tc, hegel.SampledFrom([]string{"", "", "", "", "", "+"})),
+			base:    base,
+			zeros:   hegel.Draw(tc, weighted(choice[int]{80, hegel.Just(0)}, choice[int]{20, hegel.Integers(1, 3)})),
+			digits:  hegel.Draw(tc, digitsFor[base]),
+			corrupt: hegel.Draw(tc, optional(10, corruptions)),
+		}
+	})
+)
+
+// ---- properties ----------------------------------------------------------------------------
+
+type binOp struct {
+	name string
+	op   func(z, x, y *Int) *Int
+	ref  func(x, y *big.Int) *big.Int
+}
+
+var binOps = []binOp{
+	{"Add", (*Int).Add, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Add(x, y)) }},
+	{"Sub", (*Int).Sub, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Sub(x, y)) }},
+	{"Mul", (*Int).Mul, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Mul(x, y)) }},
+	{"Div", (*Int).Div, func(x, y *big.Int) *big.Int {
+		if y.Sign() == 0 {
+			return new(big.Int)
+		}
+		return new(big.Int).Div(x, y)
+	}},
+	{"Mod", (*Int).Mod, func(x, y *big.Int) *big.Int {
+		if y.Sign() == 0 {
+			return new(big.Int)
+		}
+		return new(big.Int).Mod(x, y)
+	}},
+	{"SDiv", (*Int).SDiv, bigSDiv},
+	{"SMod", (*Int).SMod, bigSMod},
+	{"And", (*Int).And, func(x, y *big.Int) *big.Int { return new(big.Int).And(x, y) }},
+	{"Or", (*Int).Or, func(x, y *big.Int) *big.Int { return new(big.Int).Or(x, y) }},
+	{"Xor", (*Int).Xor, func(x, y *big.Int) *big.Int { return new(big.Int).Xor(x, y) }},
+	{"Exp", (*Int).Exp, func(x, y *big.Int) *big.Int { return new(big.Int).Exp(x, y, two256) }},
+	{"ExtendSign", (*Int).ExtendSign, bigExtendSign},
+	{"DivMod.q", func(z, x, y *Int) *Int { var m Int; q, _ := z.DivMod(x, y, &m); return q },
+		func(x, y *big.Int) *big.Int {
+			if y.Sign() == 0 {
+				return new(big.Int)
+			}
+			return new(big.Int).Div(x, y)
+		}},
+	{"DivMod.m", func(z, x, y *Int) *Int { _, m := new(Int).DivMod(x, y, z); return m },
+		func(x, y *big.Int) *big.Int {
+			if y.Sign() == 0 {
+				return new(big.Int)
+			}
+			return new(big.Int).Mod(x, y)
+		}},
+	{"IAdd", func(z, x, y *Int) *Int { return z.Set(x.Clone().IAdd(y)) }, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Add(x, y)) }},
+	{"ISub", func(z, x, y *Int) *Int { return z.Set(x.Clone().ISub(y)) }, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Sub(x, y)) }},
+	{"IMul", func(z, x, y *Int) *Int { return z.Set(x.Clone().IMul(y)) }, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Mul(x, y)) }},
+	{"IDiv", func(z, x, y *Int) *Int { return z.Set(x.Clone().IDiv(y)) }, func(x, y *big.Int) *big.Int {
+		if y.Sign() == 0 {
+			return new(big.Int)
+		}
+		return new(big.Int).Div(x, y)
+	}},
+	{"IMod", func(z, x, y *Int) *Int { return z.Set(x.Clone().IMod(y)) }, func(x, y *big.Int) *big.Int {
+		if y.Sign() == 0 {
+			return new(big.Int)
+		}
+		return new(big.Int).Mod(x, y)
+	}},
+	{"ISDiv", func(z, x, y *Int) *Int { return z.Set(x.Clone().ISDiv(y)) }, bigSDiv},
+	{"ISMod", func(z, x, y *Int) *Int { return z.Set(x.Clone().ISMod(y)) }, bigSMod},
+	{"IExp", func(z, x, y *Int) *Int { return z.Set(x.Clone().IExp(y)) }, func(x, y *big.Int) *big.Int { return new(big.Int).Exp(x, y, two256) }},
+}
+
+var binOpNames = func() []string {
+	names := make([]string, len(binOps))
+	for i, op := range binOps {
+		names[i] = op.name
+	}
+	return names
+}()
+
+func binOpNamed(name string) binOp {
+	for _, op := range binOps {
+		if op.name == name {
+			return op
+		}
+	}
+	panic("no binary operation " + name)
+}
+
+// binCase: two operands, the operation, a word for the uint64 conveniences and a shift amount.
+type binCase struct {
+	x, y  *Int
+	op    string
+	w     uint64
+	shift uint
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c binCase) GoString() string {
+	return fmt.Sprintf("%s(%s, %s) w=%d shift=%d", c.op, c.x.Hex(), c.y.Hex(), c.w, c.shift)
+}
+
+var binCases = hegel.Composite(func(tc hegel.TestCase) binCase {
+	return binCase{
+		x:     hegel.Draw(tc, ints),
+		y:     hegel.Draw(tc, ints),
+		op:    hegel.Draw(tc, hegel.SampledFrom(binOpNames)),
+		w:     hegel.Draw(tc, words),
+		shift: hegel.Draw(tc, shifts),
+	}
+})
+
+// TestHegelBinaryOperationsMatchBigInt: every two-operand operation agrees with math/big (with
+// the documented "division by zero gives zero" rule), leaves its operands alone, and works when
+// the result aliases either operand; the overflow flags agree with the exact result.
+func TestHegelBinaryOperationsMatchBigInt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, binCases)
+		x, y, op := c.x, c.y, binOpNamed(c.op)
+		bx, by := bigOf(x), bigOf(y)
+		want := op.ref(bx, by)
+		xc, yc := x.Clone(), y.Clone()
+		have := op.op(new(Int), xc, yc)
+		if bigOf(have).Cmp(want) != 0 {
+			ht.Fatalf("%s: have %s want %s", op.name, have.Hex(), want.Text(16))
+		}
+		if !xc.Eq(x) || !yc.Eq(y) {
+			ht.Fatalf("%s modified its operands: %s %s", op.name, xc.Hex(), yc.Hex())
+		}
+		if r := op.op(xc, xc, y.Clone()); r != xc || bigOf(r).Cmp(want) != 0 {
+			ht.Fatalf("%s with z aliasing x: have %s want %s", op.name, r.Hex(), want.Text(16))
+		}
+		if r := op.op(yc, x.Clone(), yc); r != yc || bigOf(r).Cmp(want) != 0 {
+			ht.Fatalf("%s with z aliasing y: have %s want %s", op.name, r.Hex(), want.Text(16))
+		}
+		if xc2 := x.Clone(); true {
+			if r := op.op(xc2, xc2, xc2); r != xc2 || bigOf(r).Cmp(op.ref(bx, bx)) != 0 {
+				ht.Fatalf("%s(x, x) with z aliasing both: have %s want %s", op.name, r.Hex(), op.ref(bx, bx).Text(16))
+			}
+		}
+
+		// overflow-reporting variants and the uint64 conveniences
+		sum := new(big.Int).Add(bx, by)
+		if r, of := new(Int).AddOverflow(x, y); bigOf(r).Cmp(u256(sum)) != 0 || of != (sum.Cmp(two256) >= 0) {
+			ht.Fatalf("AddOverflow: have %s,%v want %s,%v", r.Hex(), of, u256(sum).Text(16), sum.Cmp(two256) >= 0)
+		}
+		diff := new(big.Int).Sub(bx, by)
+		if r, of := new(Int).SubOverflow(x, y); bigOf(r).Cmp(u256(diff)) != 0 || of != (diff.Sign() < 0) {
+			ht.Fatalf("SubOverflow: have %s,%v want %s,%v", r.Hex(), of, u256(diff).Text(16), diff.Sign() < 0)
+		}
+		prod := new(big.Int).Mul(bx, by)
+		if r, of := new(Int).MulOverflow(x, y); bigOf(r).Cmp(u256(prod)) != 0 || of != (prod.Cmp(two256) >= 0) {
+			ht.Fatalf("MulOverflow: have %s,%v want %s,%v", r.Hex(), of, u256(prod).Text(16), prod.Cmp(two256) >= 0)
+		}
+		w := c.w
+		bw := new(big.Int).SetUint64(w)
+		if r := new(Int).AddUint64(x, w); bigOf(r).Cmp(u256(new(big.Int).Add(bx, bw))) != 0 {
+			ht.Fatalf("AddUint64(%s, %d) = %s", x.Hex(), w, r.Hex())
+		}
+		if r := x.Clone().IAddUint64(w); bigOf(r).Cmp(u256(new(big.Int).Add(bx, bw))) != 0 {
+			ht.Fatalf("IAddUint64(%s, %d) = %s", x.Hex(), w, r.Hex())
+		}
+		if r := new(Int).SubUint64(x, w); bigOf(r).Cmp(u256(new(big.Int).Sub(bx, bw))) != 0 {
+			ht.Fatalf("SubUint64(%s, %d) = %s", x.Hex(), w, r.Hex())
+		}
+		if r := x.Clone().ISubUint64(w); bigOf(r).Cmp(u256(new(big.Int).Sub(bx, bw))) != 0 {
+			ht.Fatalf("ISubUint64(%s, %d) = %s", x.Hex(), w, r.Hex())
+		}
+
+		// shifts
+		s := c.shift
+		if r := new(Int).Lsh(x, s); bigOf(r).Cmp(u256(new(big.Int).Lsh(bx, s))) != 0 {
+			ht.Fatalf("Lsh(%s, %d) = %s", x.Hex(), s, r.Hex())
+		}
+		if r := x.Clone().ILsh(s); bigOf(r).Cmp(u256(new(big.Int).Lsh(bx, s))) != 0 {
+			ht.Fatalf("ILsh(%s, %d) = %s", x.Hex(), s, r.Hex())
+		}
+		if r := new(Int).Rsh(x, s); bigOf(r).Cmp(new(big.Int).Rsh(bx, s)) != 0 {
+			ht.Fatalf("Rsh(%s, %d) = %s", x.Hex(), s, r.Hex())
+		}
+		if r := x.Clone().IRsh(s); bigOf(r).Cmp(new(big.Int).Rsh(bx, s)) != 0 {
+			ht.Fatalf("IRsh(%s, %d) = %s", x.Hex(), s, r.Hex())
+		}
+		srsh := u256(new(big.Int).Rsh(s256(bx), s)) // big.Rsh rounds toward -inf, as an arithmetic shift does
+		if r := new(Int).SRsh(x, s); bigOf(r).Cmp(srsh) != 0 {
+			ht.Fatalf("SRsh(%s, %d) = %s want %s", x.Hex(), s, r.Hex(), srsh.Text(16))
+		}
+		if r := x.Clone().ISRsh(s); bigOf(r).Cmp(srsh) != 0 {
+			ht.Fatalf("ISRsh(%s, %d) = %s want %s", x.Hex(), s, r.Hex(), srsh.Text(16))
+		}
+	})
+}
+
+// remAliases: the aliasing forms of z.MulDivOverflowRem(x, y, d, m): the remainder aliasing
+// the divisor or the result is the shape of uint256/4, and it comes first at a quarter so that
+// the modular property, mapped plain to the bug, reaches it every run (STYLE.md rule 3's
+// exception: at the tail of one SampledFrom over all eight forms the engine's draw missed it in
+// one run of forty at a hundred cases); then none, the result aliasing an operand and the
+// remainder aliasing another operand; the shape is left out under HEGEL_NO_KNOWN=1.
+var (
+	remAliasForms = []string{"none", "z==x", "z==y", "z==d", "m==x", "m==y", "m==d", "m==z"}
+	remAliases    = shaped(
+		weighted(choice[string]{2, hegel.SampledFrom(remAliasForms[6:])}, choice[string]{6, hegel.SampledFrom(remAliasForms[:6])}),
+		hegel.SampledFrom(remAliasForms[:6]))
+)
+
+// remAliasShape names uint256/4 for the two forms it mishandles.
+func remAliasShape(alias string) []string {
+	return shapeIf(alias == "m==d" || alias == "m==z", "uint256/4")
+}
+
+// mulDivRem runs z.MulDivOverflowRem(x, y, d, m) on clones of the operands with the pointers
+// aliased as the form says, and recovers a panic.
+func mulDivRem(x, y, d *Int, alias string) (q, r *Int, of bool, panicked any) {
+	z, m := new(Int), new(Int)
+	x, y, d = x.Clone(), y.Clone(), d.Clone()
+	switch alias {
+	case "z==x":
+		z = x
+	case "z==y":
+		z = y
+	case "z==d":
+		z = d
+	case "m==x":
+		m = x
+	case "m==y":
+		m = y
+	case "m==d":
+		m = d
+	case "m==z":
+		m = z
+	}
+	defer func() { panicked = recover() }()
+	q, r, of = z.MulDivOverflowRem(x, y, d, m)
+	return
+}
+
+// modCase: three operands, whether the first two are reduced modulo the third (the fast path
+// of AddMod), and the aliasing form of MulDivOverflowRem.
+type modCase struct {
+	x, y, m *Int
+	reduced bool
+	alias   string
+}
+
+// operands renders the case: clones of x and y, reduced modulo m when the case says so.
+func (c modCase) operands() (x, y, m *Int) {
+	x, y, m = c.x.Clone(), c.y.Clone(), c.m.Clone()
+	if c.reduced && !m.IsZero() {
+		x.Mod(x, m)
+		y.Mod(y, m)
+	}
+	if c.alias == "m==d" || c.alias == "m==z" {
+		// the shape of uint256/4 shows only when x*y and the divisor are not zero (m == d
+		// then divides by the cleared divisor, m == z returns the quotient twice; a zero
+		// product or divisor gives zeros either way), so a zero operand is bumped to one
+		for _, v := range []*Int{x, y, m} {
+			if v.IsZero() {
+				v.SetUint64(1)
+			}
+		}
+	}
+	return x, y, m
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c modCase) GoString() string {
+	x, y, m := c.operands()
+	return fmt.Sprintf("x=%s y=%s m=%s (reduced %v) MulDivOverflowRem %s", x.Hex(), y.Hex(), m.Hex(), c.reduced, c.alias)
+}
+
+var modCases = hegel.Composite(func(tc hegel.TestCase) modCase {
+	return modCase{
+		x:       hegel.Draw(tc, ints),
+		y:       hegel.Draw(tc, ints),
+		m:       hegel.Draw(tc, ints),
+		reduced: hegel.Draw(tc, chance(30)),
+		alias:   hegel.Draw(tc, remAliases),
+	}
+})
+
+// TestHegelModularOperationsMatchBigInt: AddMod, MulMod (with and without a precomputed
+// reciprocal), MulDivOverflow and MulDivOverflowRem agree with exact arithmetic, including the
+// aliasing forms (the result aliasing an operand, DivMod's z == m, and MulDivOverflowRem's
+// remainder aliasing any of the operands or the result). The remainder aliasing the divisor
+// panics and aliasing the result loses the remainder (uint256/4).
+func TestHegelModularOperationsMatchBigInt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, modCases)
+		x, y, m := c.operands()
+		bx, by, bm := bigOf(x), bigOf(y), bigOf(m)
+		var wantAdd, wantMul *big.Int
+		if bm.Sign() == 0 {
+			wantAdd, wantMul = new(big.Int), new(big.Int)
+		} else {
+			wantAdd = new(big.Int).Mod(new(big.Int).Add(bx, by), bm)
+			wantMul = new(big.Int).Mod(new(big.Int).Mul(bx, by), bm)
+		}
+		check := func(name string, have *Int, want *big.Int) {
+			if bigOf(have).Cmp(want) != 0 {
+				ht.Fatalf("%s: have %s want %s", name, have.Hex(), want.Text(16))
+			}
+		}
+		xc, yc, mc := x.Clone(), y.Clone(), m.Clone()
+		check("AddMod", new(Int).AddMod(xc, yc, mc), wantAdd)
+		check("MulMod", new(Int).MulMod(xc, yc, mc), wantMul)
+		if !xc.Eq(x) || !yc.Eq(y) || !mc.Eq(m) {
+			ht.Fatalf("operands modified")
+		}
+		check("AddMod z==x", xc.AddMod(xc, y, m), wantAdd)
+		check("AddMod z==y", yc.AddMod(x, yc, m), wantAdd)
+		check("AddMod z==m", mc.AddMod(x, y, mc), wantAdd)
+		xc, yc, mc = x.Clone(), y.Clone(), m.Clone()
+		check("MulMod z==x", xc.MulMod(xc, y, m), wantMul)
+		check("MulMod z==y", yc.MulMod(x, yc, m), wantMul)
+		check("MulMod z==m", mc.MulMod(x, y, mc), wantMul)
+		check("IAddMod", x.Clone().IAddMod(y, m), wantAdd)
+		check("IMulMod", x.Clone().IMulMod(y, m), wantMul)
+		mu := Reciprocal(m)
+		check("MulModWithReciprocal", new(Int).MulModWithReciprocal(x, y, m, &mu), wantMul)
+		check("IMulModWithReciprocal", x.Clone().IMulModWithReciprocal(y, m, &mu), wantMul)
+		if m[3] != 0 {
+			// the same modulus through both routes must agree word for word
+			if r1, r2 := new(Int).MulMod(x, y, m), new(Int).MulModWithReciprocal(x, y, m, &mu); !r1.Eq(r2) {
+				ht.Fatalf("MulMod %s vs MulModWithReciprocal %s", r1.Hex(), r2.Hex())
+			}
+		}
+
+		// (x*y)/m with full precision
+		var wantQ, wantR *big.Int
+		wantOverflow := false
+		if bm.Sign() == 0 {
+			wantQ, wantR = new(big.Int), new(big.Int)
+		} else {
+			wantQ, wantR = new(big.Int).DivMod(new(big.Int).Mul(bx, by), bm, new(big.Int))
+			wantOverflow = wantQ.Cmp(two256) >= 0
+			wantQ = u256(wantQ)
+		}
+		if q, of := new(Int).MulDivOverflow(x, y, m); bigOf(q).Cmp(wantQ) != 0 || of != wantOverflow {
+			ht.Fatalf("MulDivOverflow: have %s,%v want %s,%v", q.Hex(), of, wantQ.Text(16), wantOverflow)
+		}
+		xc = x.Clone()
+		if q, of := xc.MulDivOverflow(xc, y, m); q != xc || bigOf(q).Cmp(wantQ) != 0 || of != wantOverflow {
+			ht.Fatalf("MulDivOverflow z==x: have %s,%v", q.Hex(), of)
+		}
+		mc = m.Clone()
+		if q, of := mc.MulDivOverflow(x, y, mc); q != mc || bigOf(q).Cmp(wantQ) != 0 || of != wantOverflow {
+			ht.Fatalf("MulDivOverflow z==d: have %s,%v", q.Hex(), of)
+		}
+		var rem Int
+		if q, r, of := new(Int).MulDivOverflowRem(x, y, m, &rem); r != &rem || bigOf(q).Cmp(wantQ) != 0 || bigOf(r).Cmp(wantR) != 0 || of != wantOverflow {
+			ht.Fatalf("MulDivOverflowRem: have %s,%s,%v want %s,%s,%v", q.Hex(), r.Hex(), of, wantQ.Text(16), wantR.Text(16), wantOverflow)
+		}
+		// the result aliasing x, the remainder aliasing x, and the drawn aliasing form
+		xc, yc = x.Clone(), y.Clone()
+		if q, r, _ := xc.MulDivOverflowRem(xc, yc, m, &rem); bigOf(q).Cmp(wantQ) != 0 || bigOf(r).Cmp(wantR) != 0 {
+			ht.Fatalf("MulDivOverflowRem z==x: have %s,%s", q.Hex(), r.Hex())
+		}
+		xc, yc = x.Clone(), y.Clone()
+		if q, r, _ := new(Int).MulDivOverflowRem(xc, yc, m, xc); bigOf(q).Cmp(wantQ) != 0 || bigOf(r).Cmp(wantR) != 0 {
+			ht.Fatalf("MulDivOverflowRem m==x: have %s,%s", q.Hex(), r.Hex())
+		}
+		if q, r, of, panicked := mulDivRem(x, y, m, c.alias); panicked != nil {
+			mismatch(ht, remAliasShape(c.alias), "MulDivOverflowRem %s panics: %v", c.alias, panicked)
+		} else if bigOf(q).Cmp(wantQ) != 0 || bigOf(r).Cmp(wantR) != 0 || of != wantOverflow {
+			mismatch(ht, remAliasShape(c.alias), "MulDivOverflowRem %s: have %s,%s,%v want %s,%s,%v", c.alias, q.Hex(), r.Hex(), of, wantQ.Text(16), wantR.Text(16), wantOverflow)
+		}
+
+		// DivMod with z aliasing m, and both results aliasing operands
+		var wantDq, wantDr *big.Int
+		if by.Sign() == 0 {
+			wantDq, wantDr = new(big.Int), new(big.Int)
+		} else {
+			wantDq, wantDr = new(big.Int).DivMod(bx, by, new(big.Int))
+		}
+		xc = x.Clone()
+		if q, r := xc.DivMod(x, y, xc); bigOf(q).Cmp(wantDq) != 0 || bigOf(r).Cmp(wantDr) != 0 {
+			ht.Fatalf("DivMod z==m: have %s,%s want %s,%s", q.Hex(), r.Hex(), wantDq.Text(16), wantDr.Text(16))
+		}
+		xc, yc = x.Clone(), y.Clone()
+		if q, r := xc.DivMod(xc, yc, yc); bigOf(q).Cmp(wantDq) != 0 || bigOf(r).Cmp(wantDr) != 0 {
+			ht.Fatalf("DivMod z==x,m==y: have %s,%s want %s,%s", q.Hex(), r.Hex(), wantDq.Text(16), wantDr.Text(16))
+		}
+		xc, yc = x.Clone(), y.Clone()
+		if q, r := yc.DivMod(xc, yc, xc); bigOf(q).Cmp(wantDq) != 0 || bigOf(r).Cmp(wantDr) != 0 {
+			ht.Fatalf("DivMod z==y,m==x: have %s,%s want %s,%s", q.Hex(), r.Hex(), wantDq.Text(16), wantDr.Text(16))
+		}
+	})
+}
+
+// exactInts: values with at most 53 significant bits, which float64 holds exactly: the region
+// beside uint256/1's, drawn for the Float64 operand under HEGEL_NO_KNOWN=1.
+var exactInts = hegel.Composite(func(tc hegel.TestCase) *Int {
+	mantissa := NewInt(hegel.Draw(tc, hegel.Integers[uint64](0, 1<<53-1)))
+	return mantissa.Lsh(mantissa, uint(hegel.Draw(tc, hegel.Integers(0, 203))))
+})
+
+// byteIndices: the n of Byte(n): within the 32 bytes first, then beyond them, around the edge,
+// or any value.
+var byteIndices = weighted(
+	choice[*Int]{40, hegel.Map(hegel.Integers[uint64](0, 31), NewInt)},
+	choice[*Int]{20, hegel.Map(hegel.Integers[uint64](32, 1000), NewInt)},
+	choice[*Int]{20, hegel.Map(hegel.Integers[uint64](0, 40), NewInt)},
+	choice[*Int]{20, ints},
+)
+
+// unaryCase: the operand, a second one for the comparisons, the operand of Float64 (any value
+// by default; one float64 holds exactly under HEGEL_NO_KNOWN=1), a byte index, a word and a
+// big.Int for the comparisons with those.
+type unaryCase struct {
+	x, y *Int
+	f    *Int
+	idx  *Int
+	w    uint64
+	b    *big.Int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c unaryCase) GoString() string {
+	return fmt.Sprintf("x=%s y=%s f=%s Byte(%s) w=%d big=%s", c.x.Hex(), c.y.Hex(), c.f.Hex(), c.idx.Hex(), c.w, c.b)
+}
+
+var unaryCases = hegel.Composite(func(tc hegel.TestCase) unaryCase {
+	return unaryCase{
+		x:   hegel.Draw(tc, ints),
+		y:   hegel.Draw(tc, ints),
+		f:   hegel.Draw(tc, shaped(ints, exactInts)),
+		idx: hegel.Draw(tc, byteIndices),
+		w:   hegel.Draw(tc, words),
+		b:   hegel.Draw(tc, bigs),
+	}
+})
+
+// TestHegelUnaryOperationsAndComparisonsMatchBigInt: Not, Neg, Abs, Sign, Sqrt, Log10, BitLen,
+// ByteLen, Byte, ReverseBytes, Float64, the uint64 views and every comparison agree with
+// math/big. Float64 truncates the mantissa of a value above 2^64 instead of rounding to the
+// nearest float64 (uint256/1).
+func TestHegelUnaryOperationsAndComparisonsMatchBigInt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, unaryCases)
+		x, y := c.x, c.y
+		bx, by := bigOf(x), bigOf(y)
+		check := func(name string, have *Int, want *big.Int) {
+			if bigOf(have).Cmp(want) != 0 {
+				ht.Fatalf("%s: have %s want %s", name, have.Hex(), want.Text(16))
+			}
+		}
+		check("Not", new(Int).Not(x), new(big.Int).Xor(bx, max256))
+		check("Neg", new(Int).Neg(x), u256(new(big.Int).Neg(bx)))
+		check("Abs", new(Int).Abs(x), u256(new(big.Int).Abs(s256(bx))))
+		check("Sqrt", new(Int).Sqrt(x), new(big.Int).Sqrt(bx))
+		check("ISqrt", x.Clone().ISqrt(), new(big.Int).Sqrt(bx))
+		xc := x.Clone()
+		check("Not z==x", xc.Not(xc), new(big.Int).Xor(bx, max256))
+		xc = x.Clone()
+		check("Neg z==x", xc.Neg(xc), u256(new(big.Int).Neg(bx)))
+		xc = x.Clone()
+		check("Sqrt z==x", xc.Sqrt(xc), new(big.Int).Sqrt(bx))
+		if s := x.Sign(); s != s256(bx).Sign() {
+			ht.Fatalf("Sign: have %d want %d", s, s256(bx).Sign())
+		}
+		if l := x.Log10(); l != bigLog10(bx) {
+			ht.Fatalf("Log10: have %d want %d", l, bigLog10(bx))
+		}
+		if l := x.BitLen(); l != bx.BitLen() {
+			ht.Fatalf("BitLen: have %d want %d", l, bx.BitLen())
+		}
+		if l := x.ByteLen(); l != (bx.BitLen()+7)/8 {
+			ht.Fatalf("ByteLen: have %d want %d", l, (bx.BitLen()+7)/8)
+		}
+		if x.IsZero() != (bx.Sign() == 0) {
+			ht.Fatalf("IsZero")
+		}
+		if x.IsUint64() != bx.IsUint64() {
+			ht.Fatalf("IsUint64: have %v", x.IsUint64())
+		}
+		low := new(big.Int).And(bx, new(big.Int).SetUint64(math.MaxUint64)).Uint64()
+		if u, of := x.Uint64WithOverflow(); u != low || of != !bx.IsUint64() {
+			ht.Fatalf("Uint64WithOverflow: have %d,%v want %d,%v", u, of, low, !bx.IsUint64())
+		}
+		if x.Uint64() != low {
+			ht.Fatalf("Uint64")
+		}
+		if c := x.Clone(); c == x || !c.Eq(x) {
+			ht.Fatalf("Clone")
+		}
+		// Float64: the nearest float64, as big.Float rounds it
+		bf := bigOf(c.f)
+		if have, want := c.f.Float64(), nearestFloat64(bf); have != want {
+			mismatch(ht, shapeIf(!c.f.IsUint64(), "uint256/1"), "Float64(%s) = %b (%g), nearest is %b (%g)", c.f.Hex(), have, have, want, want)
+		}
+		// Byte(n): the n-th byte of the 32-byte big-endian form, 0 beyond it
+		idx := c.idx
+		b32 := padded(bx, 32)
+		wantByte := new(big.Int)
+		if bigOf(idx).Cmp(big.NewInt(32)) < 0 {
+			wantByte.SetUint64(uint64(b32[idx.Uint64()]))
+		}
+		check(fmt.Sprintf("Byte(%s)", idx.Hex()), x.Clone().Byte(idx), wantByte)
+		rev := slices.Clone(b32)
+		slices.Reverse(rev)
+		check("ReverseBytes", new(Int).ReverseBytes(x), new(big.Int).SetBytes(rev))
+		xc = x.Clone()
+		check("ReverseBytes z==x", xc.ReverseBytes(xc), new(big.Int).SetBytes(rev))
+		if r := new(Int).ReverseBytes(new(Int).ReverseBytes(x)); !r.Eq(x) {
+			ht.Fatalf("ReverseBytes twice: %s", r.Hex())
+		}
+
+		// comparisons
+		cmp := bx.Cmp(by)
+		if x.Cmp(y) != cmp || x.Eq(y) != (cmp == 0) || x.Lt(y) != (cmp < 0) || x.Gt(y) != (cmp > 0) {
+			ht.Fatalf("Cmp/Eq/Lt/Gt: %d %v %v %v want %d", x.Cmp(y), x.Eq(y), x.Lt(y), x.Gt(y), cmp)
+		}
+		scmp := s256(bx).Cmp(s256(by))
+		if x.Slt(y) != (scmp < 0) || x.Sgt(y) != (scmp > 0) {
+			ht.Fatalf("Slt/Sgt: %v %v want %d", x.Slt(y), x.Sgt(y), scmp)
+		}
+		w := c.w
+		bw := new(big.Int).SetUint64(w)
+		if x.CmpUint64(w) != bx.Cmp(bw) || x.LtUint64(w) != (bx.Cmp(bw) < 0) || x.GtUint64(w) != (bx.Cmp(bw) > 0) {
+			ht.Fatalf("CmpUint64(%d): %d %v %v want %d", w, x.CmpUint64(w), x.LtUint64(w), x.GtUint64(w), bx.Cmp(bw))
+		}
+		gb := c.b
+		if c := x.CmpBig(gb); c != bx.Cmp(gb) {
+			ht.Fatalf("CmpBig(%s): have %d want %d", gb, c, bx.Cmp(gb))
+		}
+		if x.Cmp(x) != 0 || !x.Eq(x.Clone()) || x.Lt(x) || x.Gt(x) || x.Slt(x) || x.Sgt(x) {
+			ht.Fatalf("reflexivity")
+		}
+	})
+}
+
+// encoder is one of the encoders of a *Int, with the text it must give for a value.
+type encoder struct {
+	name string
+	call func(*Int) (string, error)
+	want func(*big.Int) string
+}
+
+var (
+	decimalOf = func(b *big.Int) string { return b.Text(10) }
+	encoders  = []encoder{
+		{"String", func(z *Int) (string, error) { return z.String(), nil }, decimalOf},
+		{"Dec", func(z *Int) (string, error) { return z.Dec(), nil }, decimalOf},
+		{"Hex", func(z *Int) (string, error) { return z.Hex(), nil }, func(b *big.Int) string { return fmt.Sprintf("%#x", b) }},
+		{"MarshalText", func(z *Int) (string, error) { b, err := z.MarshalText(); return string(b), err }, decimalOf},
+		{"MarshalJSON", func(z *Int) (string, error) { b, err := z.MarshalJSON(); return string(b), err }, func(b *big.Int) string { return `"` + b.Text(10) + `"` }},
+		{"Value", func(z *Int) (string, error) { v, err := z.Value(); return fmt.Sprint(v), err }, decimalOf},
+		{"Format", func(z *Int) (string, error) { return fmt.Sprintf("%d", z), nil }, decimalOf},
+		{"ToBig", func(z *Int) (string, error) { return z.ToBig().String(), nil }, decimalOf},
+		{"EncodeRLP", func(z *Int) (string, error) {
+			var w bytes.Buffer
+			err := z.EncodeRLP(&w)
+			return fmt.Sprintf("%x", w.Bytes()), err
+		}, func(b *big.Int) string { return fmt.Sprintf("%x", rlpOf(b)) }},
+	}
+	// nilPanickers: the encoders that dereference a nil receiver (uint256/3); the last three
+	// of encoders handle it.
+	nilPanickers = encoders[:6]
+)
+
+// callOn calls the encoder on z and reports a panic.
+func (e encoder) callOn(z *Int) (text string, err error, panicked any) {
+	defer func() { panicked = recover() }()
+	text, err = e.call(z)
+	return
+}
+
+// paddedLengths: the n of PaddedBytes for a value of byteLen bytes: at or above the byte
+// length first, or below it (the shape of uint256/5, left out under HEGEL_NO_KNOWN=1).
+func paddedLengths(byteLen int) hegel.Generator[int] {
+	atLeast := hegel.Map(hegel.Integers(0, 8), func(d int) int { return byteLen + d })
+	if byteLen == 0 {
+		return atLeast
+	}
+	return shaped(weighted(choice[int]{85, atLeast}, choice[int]{15, hegel.Integers(0, byteLen-1)}), atLeast)
+}
+
+// bufSpec is the input of SetBytes: random bytes, or the value padded to a length.
+type bufSpec struct {
+	raw    []byte
+	padTo  int
+	padded bool
+}
+
+func (b bufSpec) bytesOf(bx *big.Int) []byte {
+	if b.padded {
+		return padded(bx, b.padTo)
+	}
+	return b.raw
+}
+
+var bufSpecs = hegel.OneOf(
+	hegel.Map(hegel.Binary(0, 40), func(raw []byte) bufSpec { return bufSpec{raw: raw} }),
+	hegel.Map(hegel.Integers(0, 40), func(n int) bufSpec { return bufSpec{padTo: n, padded: true} }),
+)
+
+// encCase: the value and the lengths, separators, format and companions of its encodings; the
+// string and JSON encoders are called on a nil *Int instead of the value when nilRecv is set
+// (the shape of uint256/3, never under HEGEL_NO_KNOWN=1).
+type encCase struct {
+	x        *Int
+	nilRecv  bool
+	sliceLen int
+	padTo    int
+	buf      bufSpec
+	sep      byte
+	format   format
+	exp      int
+	prefix   []byte
+	shortIn  int
+	shortOut int
+	reuse    *big.Int
+	from     *big.Int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c encCase) GoString() string {
+	recv := "x"
+	if c.nilRecv {
+		recv = "nil"
+	}
+	return fmt.Sprintf("x=%s receiver %s WriteToSlice(%d) PaddedBytes(%d) SetBytes(%x) sep %q %s e%d prefix %x short %d/%d reuse %s from %s",
+		c.x.Hex(), recv, c.sliceLen, c.padTo, c.buf.bytesOf(c.x.ToBig()), c.sep, c.format, c.exp, c.prefix, c.shortIn, c.shortOut, c.reuse, c.from)
+}
+
+var (
+	sliceLengths = hegel.OneOf(hegel.SampledFrom([]int{0, 1, 7, 8, 9, 15, 16, 17, 20, 23, 24, 25, 31, 32, 33, 40}), hegel.Integers(0, 48))
+	separators   = hegel.SampledFrom([]byte{',', '.', '_', ' ', '\''})
+	nilReceivers = shaped(chance(10), hegel.Just(false))
+	encCases     = hegel.Composite(func(tc hegel.TestCase) encCase {
+		x := hegel.Draw(tc, ints)
+		return encCase{
+			x:        x,
+			nilRecv:  hegel.Draw(tc, nilReceivers),
+			sliceLen: hegel.Draw(tc, sliceLengths),
+			padTo:    hegel.Draw(tc, paddedLengths(x.ByteLen())),
+			buf:      hegel.Draw(tc, bufSpecs),
+			sep:      hegel.Draw(tc, separators),
+			format:   hegel.Draw(tc, formats),
+			exp:      hegel.Draw(tc, hegel.Integers(0, 77)),
+			prefix:   hegel.Draw(tc, hegel.Binary(0, 5)),
+			shortIn:  hegel.Draw(tc, hegel.Integers(0, 31)),
+			shortOut: hegel.Draw(tc, hegel.Integers(0, 31)),
+			reuse:    hegel.Draw(tc, bigs),
+			from:     hegel.Draw(tc, bigs),
+		}
+	})
+)
+
+// TestHegelEncodingsRoundTripAndMatchBigInt: byte, hex, decimal, fmt, text, JSON, SSZ, RLP and
+// database encodings agree with math/big's view of the value and read back to it; the string
+// and JSON encoders do not panic on a nil *Int, as Format, ToBig, EncodeRLP and big.Int's do
+// not (uint256/3); PaddedBytes pads to at least n bytes and keeps the value (uint256/5).
+func TestHegelEncodingsRoundTripAndMatchBigInt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, encCases)
+		x := c.x
+		bx := bigOf(x)
+
+		// bytes
+		if b := x.Bytes(); !bytes.Equal(b, bx.Bytes()) {
+			ht.Fatalf("Bytes: %x want %x", b, bx.Bytes())
+		}
+		b32 := x.Bytes32()
+		if !bytes.Equal(b32[:], padded(bx, 32)) {
+			ht.Fatalf("Bytes32: %x", b32)
+		}
+		b20 := x.Bytes20()
+		if !bytes.Equal(b20[:], padded(bx, 32)[12:]) {
+			ht.Fatalf("Bytes20: %x", b20)
+		}
+		var a32 [32]byte
+		x.WriteToArray32(&a32)
+		if a32 != b32 {
+			ht.Fatalf("WriteToArray32")
+		}
+		var a20 [20]byte
+		x.WriteToArray20(&a20)
+		if a20 != b20 {
+			ht.Fatalf("WriteToArray20")
+		}
+		k := c.sliceLen
+		dest := bytes.Repeat([]byte{0xee}, k)
+		x.WriteToSlice(dest)
+		wantSlice := bytes.Repeat([]byte{0xee}, k)
+		if k >= 32 {
+			copy(wantSlice, b32[:])
+		} else {
+			copy(wantSlice, b32[32-k:])
+		}
+		if !bytes.Equal(dest, wantSlice) {
+			ht.Fatalf("WriteToSlice(%d): %x want %x", k, dest, wantSlice)
+		}
+		if k >= 32 {
+			dest2 := bytes.Repeat([]byte{0xee}, k)
+			x.PutUint256(dest2)
+			if !bytes.Equal(dest2, wantSlice) {
+				ht.Fatalf("PutUint256(%d): %x", k, dest2)
+			}
+		}
+		// PaddedBytes: at least n bytes, the value kept (n below the byte length is uint256/5)
+		pn := c.padTo
+		if p := x.PaddedBytes(pn); !bytes.Equal(p, padded(bx, pn)) {
+			mismatch(ht, shapeIf(pn < x.ByteLen(), "uint256/5"), "PaddedBytes(%d): %x want %x", pn, p, padded(bx, pn))
+		}
+		// SetBytes on any length, SetBytesN on exact lengths
+		buf := c.buf.bytesOf(bx)
+		wantSet := new(big.Int).SetBytes(buf)
+		if len(buf) > 32 {
+			wantSet.SetBytes(buf[len(buf)-32:])
+		}
+		if r := new(Int).SetBytes(buf); bigOf(r).Cmp(wantSet) != 0 {
+			ht.Fatalf("SetBytes(%x) = %s want %s", buf, r.Hex(), wantSet.Text(16))
+		}
+		if len(buf) >= 1 && len(buf) <= 32 {
+			if r := setBytesN(len(buf), buf); bigOf(r).Cmp(new(big.Int).SetBytes(buf)) != 0 {
+				ht.Fatalf("SetBytes%d(%x) = %s", len(buf), buf, r.Hex())
+			}
+		}
+		if len(buf) > 32 {
+			for _, l := range []int{8, 16, 24, 32} {
+				if r := setBytesN(l, buf); bigOf(r).Cmp(new(big.Int).SetBytes(buf[:l])) != 0 {
+					ht.Fatalf("SetBytes%d on a longer slice = %s", l, r.Hex())
+				}
+			}
+		}
+		if r := new(Int).SetBytes(x.Bytes()); !r.Eq(x) {
+			ht.Fatalf("SetBytes(Bytes()) round trip")
+		}
+
+		// strings
+		if h := x.Hex(); h != fmt.Sprintf("%#x", bx) {
+			ht.Fatalf("Hex: %s want %#x", h, bx)
+		}
+		if d := x.Dec(); d != bx.Text(10) || x.String() != d {
+			ht.Fatalf("Dec: %s want %s", d, bx.Text(10))
+		}
+		sep := c.sep
+		if p := x.PrettyDec(sep); p != prettyDec(bx, sep) {
+			ht.Fatalf("PrettyDec(%q): %s want %s", sep, p, prettyDec(bx, sep))
+		}
+		if !x.Eq(MustFromHex(x.Hex())) || !x.Eq(MustFromDecimal(x.Dec())) {
+			ht.Fatalf("Hex/Dec round trip")
+		}
+		// fmt: the Formatter agrees with big.Int's for every verb, flag, width and precision
+		format := c.format.String()
+		if have, want := fmt.Sprintf(format, x), fmt.Sprintf(format, bx); have != want {
+			ht.Fatalf("Sprintf(%q): %q want %q", format, have, want)
+		}
+		// (a plain Int value is a [4]uint64 to fmt - Format has a pointer receiver)
+
+		// the string and JSON encoders on a nil receiver: no panic, as Format, ToBig and
+		// EncodeRLP (and big.Int's String, MarshalText and MarshalJSON) manage
+		if c.nilRecv {
+			for _, e := range nilPanickers {
+				if _, _, panicked := e.callOn(nil); panicked != nil {
+					mismatch(ht, known("uint256/3"), "(*Int)(nil).%s panics: %v", e.name, panicked)
+				}
+			}
+		}
+
+		// text, JSON, SQL
+		if txt, err := x.MarshalText(); err != nil || string(txt) != bx.Text(10) {
+			ht.Fatalf("MarshalText: %q %v", txt, err)
+		}
+		var back Int
+		if err := back.UnmarshalText([]byte(bx.Text(10))); err != nil || !back.Eq(x) {
+			ht.Fatalf("UnmarshalText(decimal): %v", err)
+		}
+		if err := back.UnmarshalText([]byte(x.Hex())); err != nil || !back.Eq(x) {
+			ht.Fatalf("UnmarshalText(hex): %v", err)
+		}
+		if err := back.UnmarshalText([]byte("0X" + strings.ToUpper(x.Hex()[2:]))); err != nil || !back.Eq(x) {
+			ht.Fatalf("UnmarshalText(upper hex): %v", err)
+		}
+		js, err := json.Marshal(x)
+		if err != nil || string(js) != `"`+bx.Text(10)+`"` {
+			ht.Fatalf("MarshalJSON: %s %v", js, err)
+		}
+		var jback Int
+		if err := json.Unmarshal(js, &jback); err != nil || !jback.Eq(x) {
+			ht.Fatalf("UnmarshalJSON(quoted decimal): %v", err)
+		}
+		if err := json.Unmarshal([]byte(`"`+x.Hex()+`"`), &jback); err != nil || !jback.Eq(x) {
+			ht.Fatalf("UnmarshalJSON(quoted hex): %v", err)
+		}
+		if err := json.Unmarshal([]byte(bx.Text(10)), &jback); err != nil || !jback.Eq(x) {
+			ht.Fatalf("UnmarshalJSON(bare number): %v", err)
+		}
+		type wrapper struct {
+			A Int
+			B *Int
+			C []Int
+		}
+		// (addressable, so the pointer-receiver MarshalJSON applies to the value field, as with big.Int)
+		wj, err := json.Marshal(&wrapper{A: *x, B: x, C: []Int{*x, {}}})
+		if err != nil {
+			ht.Fatalf("json.Marshal(wrapper): %v", err)
+		}
+		var wback wrapper
+		if err := json.Unmarshal(wj, &wback); err != nil || !wback.A.Eq(x) || !wback.B.Eq(x) || len(wback.C) != 2 || !wback.C[0].Eq(x) || !wback.C[1].IsZero() {
+			ht.Fatalf("json wrapper round trip: %s %v %+v", wj, err, wback)
+		}
+		v, err := x.Value()
+		if err != nil || v != bx.Text(10) {
+			ht.Fatalf("Value: %v %v", v, err)
+		}
+		var sc Int
+		if err := sc.Scan(v); err != nil || !sc.Eq(x) {
+			ht.Fatalf("Scan(Value()): %v", err)
+		}
+		if err := sc.Scan([]byte(bx.Text(10))); err != nil || !sc.Eq(x) {
+			ht.Fatalf("Scan([]byte): %v", err)
+		}
+		// scientific notation as postgres may print it: mantissa e exponent
+		if e := c.exp; true {
+			mant := bx.Text(10)
+			scaled := new(big.Int).Mul(bx, new(big.Int).Exp(big.NewInt(10), big.NewInt(int64(e)), nil))
+			err := sc.Scan(mant + "e" + strconv.Itoa(e))
+			if scaled.Cmp(max256) > 0 {
+				if err == nil {
+					ht.Fatalf("Scan(%se%d) accepted an out-of-range value: %s", mant, e, sc.Hex())
+				}
+			} else if err != nil || bigOf(&sc).Cmp(scaled) != 0 {
+				ht.Fatalf("Scan(%se%d): %s %v want %s", mant, e, sc.Hex(), err, scaled.Text(10))
+			}
+		}
+		if err := sc.Scan(nil); err != nil || !sc.IsZero() {
+			ht.Fatalf("Scan(nil): %v %s", err, sc.Hex())
+		}
+
+		// SSZ and the hash tree root: 32 little-endian bytes
+		le := make([]byte, 32)
+		binary.LittleEndian.PutUint64(le[0:8], x[0])
+		binary.LittleEndian.PutUint64(le[8:16], x[1])
+		binary.LittleEndian.PutUint64(le[16:24], x[2])
+		binary.LittleEndian.PutUint64(le[24:32], x[3])
+		if ssz, err := x.MarshalSSZ(); err != nil || !bytes.Equal(ssz, le) || x.SizeSSZ() != 32 {
+			ht.Fatalf("MarshalSSZ: %x %v", ssz, err)
+		}
+		if root, err := x.HashTreeRoot(); err != nil || !bytes.Equal(root[:], le) {
+			ht.Fatalf("HashTreeRoot: %x %v", root, err)
+		}
+		prefix := c.prefix
+		if app, err := x.MarshalSSZAppend(slices.Clone(prefix)); err != nil || !bytes.Equal(app, append(slices.Clone(prefix), le...)) {
+			ht.Fatalf("MarshalSSZAppend: %x %v", app, err)
+		}
+		into := make([]byte, 32+len(prefix))
+		if rest, err := x.MarshalSSZInto(into); err != nil || !bytes.Equal(into[:32], le) || len(rest) != len(prefix) {
+			ht.Fatalf("MarshalSSZInto: %x %v", into, err)
+		}
+		if _, err := x.MarshalSSZInto(make([]byte, c.shortIn)); err == nil {
+			ht.Fatalf("MarshalSSZInto accepted a short buffer")
+		}
+		var sback Int
+		if err := sback.UnmarshalSSZ(le); err != nil || !sback.Eq(x) {
+			ht.Fatalf("UnmarshalSSZ: %v", err)
+		}
+		if err := sback.UnmarshalSSZ(le[:c.shortOut]); err == nil {
+			ht.Fatalf("UnmarshalSSZ accepted a short buffer")
+		}
+		// RLP
+		var rlp bytes.Buffer
+		if err := x.EncodeRLP(&rlp); err != nil || !bytes.Equal(rlp.Bytes(), rlpOf(bx)) {
+			ht.Fatalf("EncodeRLP: %x want %x", rlp.Bytes(), rlpOf(bx))
+		}
+
+		// big.Int conversions
+		if b := x.ToBig(); b.Cmp(bx) != 0 {
+			ht.Fatalf("ToBig")
+		}
+		var into2 *big.Int
+		x.IntoBig(&into2)
+		if into2.Cmp(bx) != 0 {
+			ht.Fatalf("IntoBig(nil)")
+		}
+		reuse := new(big.Int).Set(c.reuse)
+		x.IntoBig(&reuse)
+		if reuse.Cmp(bx) != 0 {
+			ht.Fatalf("IntoBig(reused): %s", reuse)
+		}
+		gb := c.from
+		wantFrom := u256(gb)
+		wantOverflow := new(big.Int).Abs(gb).BitLen() > 256
+		if r, of := FromBig(gb); bigOf(r).Cmp(wantFrom) != 0 || of != wantOverflow {
+			ht.Fatalf("FromBig(%s): %s,%v want %s,%v", gb, r.Hex(), of, wantFrom.Text(16), wantOverflow)
+		}
+		var sfb Int
+		if of := sfb.SetFromBig(gb); bigOf(&sfb).Cmp(wantFrom) != 0 || of != wantOverflow {
+			ht.Fatalf("SetFromBig(%s): %s,%v", gb, sfb.Hex(), of)
+		}
+		if r := MustFromBig(bx); !r.Eq(x) {
+			ht.Fatalf("MustFromBig")
+		}
+		if wantOverflow {
+			if !panics(func() { MustFromBig(gb) }) {
+				ht.Fatalf("MustFromBig(%s) did not panic", gb)
+			}
+		}
+	})
+}
+
+func setBytesN(l int, in []byte) *Int {
+	z := new(Int)
+	switch l {
+	case 1:
+		return z.SetBytes1(in)
+	case 2:
+		return z.SetBytes2(in)
+	case 3:
+		return z.SetBytes3(in)
