+// Hegel property tests for github.com/holiman/uint256, with math/big as the oracle.
+package uint256_test
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"reflect"
+	"regexp"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+
+	. "github.com/holiman/uint256"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---- reference arithmetic ------------------------------------------------------------------
+
+var (
+	two256  = new(big.Int).Lsh(big.NewInt(1), 256)
+	two255  = new(big.Int).Lsh(big.NewInt(1), 255)
+	max256  = new(big.Int).Sub(two256, big.NewInt(1))
+	bigZero = new(big.Int)
+)
+
+// u256 reduces b modulo 2^256 (two's complement for negative values).
+func u256(b *big.Int) *big.Int {
+	r := new(big.Int).Mod(b, two256)
+	return r
+}
+
+// s256 interprets b (0 <= b < 2^256) as a two's complement signed number.
+func s256(b *big.Int) *big.Int {
+	if b.Cmp(two255) >= 0 {
+		return new(big.Int).Sub(b, two256)
+	}
+	return new(big.Int).Set(b)
+}
+
+func bigOf(z *Int) *big.Int { return z.ToBig() }
+
+// fromBigExact converts a value known to be in range.
+func fromBigExact(b *big.Int) *Int {
+	z, overflow := FromBig(b)
+	if overflow || b.Sign() < 0 {
+		panic(fmt.Sprintf("fromBigExact: %s out of range", b))
+	}
+	return z
+}
+
+func bigSDiv(x, y *big.Int) *big.Int {
+	if y.Sign() == 0 {
+		return new(big.Int)
+	}
+	sx, sy := s256(x), s256(y)
+	return u256(new(big.Int).Quo(sx, sy)) // Quo truncates toward zero, as the EVM does
+}
+
+func bigSMod(x, y *big.Int) *big.Int {
+	if y.Sign() == 0 {
+		return new(big.Int)
+	}
+	sx, sy := s256(x), s256(y)
+	return u256(new(big.Int).Rem(sx, sy)) // Rem takes the sign of the dividend
+}
+
+func bigExtendSign(x, byteNum *big.Int) *big.Int {
+	if byteNum.Cmp(big.NewInt(30)) > 0 {
+		return new(big.Int).Set(x)
+	}
+	bit := uint(byteNum.Uint64()*8 + 7)
+	mask := new(big.Int).Lsh(big.NewInt(1), bit)
+	mask.Sub(mask, big.NewInt(1))
+	if x.Bit(int(bit)) == 1 {
+		return u256(new(big.Int).Or(x, new(big.Int).Sub(two256, new(big.Int).Add(mask, big.NewInt(1)))))
+	}
+	return new(big.Int).And(x, mask)
+}
+
+func bigLog10(b *big.Int) uint {
+	if b.Sign() == 0 {
+		return 0
+	}
+	return uint(len(b.Text(10)) - 1)
+}
+
+func prettyDec(b *big.Int, sep byte) string {
+	s := b.Text(10)
+	var out []byte
+	for i := 0; i < len(s); i++ {
+		if i > 0 && (len(s)-i)%3 == 0 {
+			out = append(out, sep)
+		}
+		out = append(out, s[i])
+	}
+	return string(out)
+}
+
+func rlpOf(b *big.Int) []byte {
+	if b.Sign() == 0 {
+		return []byte{0x80}
+	}
+	bs := b.Bytes()
+	if len(bs) == 1 && bs[0] < 0x80 {
+		return bs
+	}
+	return append([]byte{0x80 + byte(len(bs))}, bs...)
+}
+
+func padded(b *big.Int, n int) []byte {
+	bs := b.Bytes()
+	if len(bs) >= n {
+		return bs
+	}
+	return append(make([]byte, n-len(bs)), bs...)
+}
+
+// ---- generators ----------------------------------------------------------------------------
+
+func genWord(tc hegel.TestCase) uint64 {
+	switch n(tc, 0, 5) {
+	case 0:
+		return 0
+	case 1:
+		return math.MaxUint64
+	case 2:
+		return uint64(n(tc, 0, 1000))
+	case 3:
+		return 1 << uint(n(tc, 0, 63))
+	case 4:
+		return (1 << uint(n(tc, 0, 63))) - 1
+	default:
+		return uint64(n(tc, 0, math.MaxInt64))<<1 | uint64(n(tc, 0, 1))
+	}
+}
+
+// genInt draws a 256-bit value with the shapes that matter: zero, one, small, one-word, all four
+// words, powers of two and their neighbours, values just below 2^256, two's complement
+// negatives of small numbers, values around 2^255, and big-endian byte strings of any length.
+func genInt(tc hegel.TestCase) *Int {
+	switch n(tc, 0, 11) {
+	case 0:
+		return NewInt(uint64(n(tc, 0, 2)))
+	case 1:
+		return NewInt(uint64(n(tc, 0, 100000)))
+	case 2:
+		return NewInt(genWord(tc))
+	case 3, 4:
+		return &Int{genWord(tc), genWord(tc), genWord(tc), genWord(tc)}
+	case 5:
+		z := new(Int).Lsh(NewInt(1), uint(n(tc, 0, 255)))
+		switch n(tc, 0, 2) {
+		case 0:
+			return z
+		case 1:
+			return z.SubUint64(z, uint64(n(tc, 1, 3)))
+		default:
+			return z.AddUint64(z, uint64(n(tc, 1, 3)))
+		}
+	case 6:
+		return new(Int).SubUint64(new(Int).SetAllOne(), uint64(n(tc, 0, 1000)))
+	case 7:
+		return new(Int).Neg(NewInt(uint64(n(tc, 1, 100000))))
+	case 8:
+		z := new(Int).Lsh(NewInt(1), 255)
+		if chance(tc, 50) {
+			return z.SubUint64(z, uint64(n(tc, 0, 3)))
+		}
+		return z.AddUint64(z, uint64(n(tc, 0, 3)))
+	case 9:
+		return new(Int).SetBytes(genBytes(tc, n(tc, 0, 32)))
+	case 10:
+		// one word set, the others zero
+		z := new(Int)
+		z[n(tc, 0, 3)] = genWord(tc)
+		return z
+	default:
+		// a value with its top word non-zero (the fast paths of AddMod/MulMod)
+		z := &Int{genWord(tc), genWord(tc), genWord(tc), genWord(tc)}
+		if z[3] == 0 {
+			z[3] = uint64(n(tc, 1, 1000))
+		}
+		return z
+	}
+}
+
+func genBytes(tc hegel.TestCase, k int) []byte {
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = byte(n(tc, 0, 255))
+	}
+	return b
+}
+
+// genBig draws a big.Int that may be negative or wider than 256 bits.
+func genBig(tc hegel.TestCase) *big.Int {
+	b := bigOf(genInt(tc))
+	switch n(tc, 0, 4) {
+	case 0:
+		b.Neg(b)
+	case 1:
+		b.Add(b, new(big.Int).Lsh(big.NewInt(int64(n(tc, 1, 1000))), uint(n(tc, 256, 400))))
+	case 2:
+		b.Neg(b.Add(b, two256))
+	}
+	return b
+}
+
+func shiftAmount(tc hegel.TestCase) uint {
+	switch n(tc, 0, 3) {
+	case 0:
+		return uint(n(tc, 0, 300))
+	case 1:
+		return uint(pick(tc, []int{0, 1, 63, 64, 65, 127, 128, 129, 191, 192, 193, 254, 255, 256, 257, 511, 512}))
+	default:
+		return uint(n(tc, 0, 255))
+	}
+}
+
+// ---- properties ----------------------------------------------------------------------------
+
+type binOp struct {
+	name string
+	op   func(z, x, y *Int) *Int
+	ref  func(x, y *big.Int) *big.Int
+}
+
+var binOps = []binOp{
+	{"Add", (*Int).Add, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Add(x, y)) }},
+	{"Sub", (*Int).Sub, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Sub(x, y)) }},
+	{"Mul", (*Int).Mul, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Mul(x, y)) }},
+	{"Div", (*Int).Div, func(x, y *big.Int) *big.Int {
+		if y.Sign() == 0 {
+			return new(big.Int)
+		}
+		return new(big.Int).Div(x, y)
+	}},
+	{"Mod", (*Int).Mod, func(x, y *big.Int) *big.Int {
+		if y.Sign() == 0 {
+			return new(big.Int)
+		}
+		return new(big.Int).Mod(x, y)
+	}},
+	{"SDiv", (*Int).SDiv, bigSDiv},
+	{"SMod", (*Int).SMod, bigSMod},
+	{"And", (*Int).And, func(x, y *big.Int) *big.Int { return new(big.Int).And(x, y) }},
+	{"Or", (*Int).Or, func(x, y *big.Int) *big.Int { return new(big.Int).Or(x, y) }},
+	{"Xor", (*Int).Xor, func(x, y *big.Int) *big.Int { return new(big.Int).Xor(x, y) }},
+	{"Exp", (*Int).Exp, func(x, y *big.Int) *big.Int { return new(big.Int).Exp(x, y, two256) }},
+	{"ExtendSign", (*Int).ExtendSign, bigExtendSign},
+	{"DivMod.q", func(z, x, y *Int) *Int { var m Int; q, _ := z.DivMod(x, y, &m); return q },
+		func(x, y *big.Int) *big.Int {
+			if y.Sign() == 0 {
+				return new(big.Int)
+			}
+			return new(big.Int).Div(x, y)
+		}},
+	{"DivMod.m", func(z, x, y *Int) *Int { _, m := new(Int).DivMod(x, y, z); return m },
+		func(x, y *big.Int) *big.Int {
+			if y.Sign() == 0 {
+				return new(big.Int)
+			}
+			return new(big.Int).Mod(x, y)
+		}},
+	{"IAdd", func(z, x, y *Int) *Int { return z.Set(x.Clone().IAdd(y)) }, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Add(x, y)) }},
+	{"ISub", func(z, x, y *Int) *Int { return z.Set(x.Clone().ISub(y)) }, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Sub(x, y)) }},
+	{"IMul", func(z, x, y *Int) *Int { return z.Set(x.Clone().IMul(y)) }, func(x, y *big.Int) *big.Int { return u256(new(big.Int).Mul(x, y)) }},
+	{"IDiv", func(z, x, y *Int) *Int { return z.Set(x.Clone().IDiv(y)) }, func(x, y *big.Int) *big.Int {
+		if y.Sign() == 0 {
+			return new(big.Int)
+		}
+		return new(big.Int).Div(x, y)
+	}},
+	{"IMod", func(z, x, y *Int) *Int { return z.Set(x.Clone().IMod(y)) }, func(x, y *big.Int) *big.Int {
+		if y.Sign() == 0 {
+			return new(big.Int)
+		}
+		return new(big.Int).Mod(x, y)
+	}},
+	{"ISDiv", func(z, x, y *Int) *Int { return z.Set(x.Clone().ISDiv(y)) }, bigSDiv},
+	{"ISMod", func(z, x, y *Int) *Int { return z.Set(x.Clone().ISMod(y)) }, bigSMod},
+	{"IExp", func(z, x, y *Int) *Int { return z.Set(x.Clone().IExp(y)) }, func(x, y *big.Int) *big.Int { return new(big.Int).Exp(x, y, two256) }},
+}
+
+// TestHegelBinaryOperationsMatchBigInt: every two-operand operation agrees with math/big (with
+// the documented "division by zero gives zero" rule), leaves its operands alone, and works when
+// the result aliases either operand; the overflow flags agree with the exact result.
+func TestHegelBinaryOperationsMatchBigInt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x, y := genInt(ht), genInt(ht)
+		op := pick(ht, binOps)
+		note(ht, "%s(%s, %s)", op.name, x.Hex(), y.Hex())
+		bx, by := bigOf(x), bigOf(y)
+		want := op.ref(bx, by)
+		xc, yc := x.Clone(), y.Clone()
+		have := op.op(new(Int), xc, yc)
+		if bigOf(have).Cmp(want) != 0 {
+			ht.Fatalf("%s: have %s want %s", op.name, have.Hex(), want.Text(16))
+		}
+		if !xc.Eq(x) || !yc.Eq(y) {
+			ht.Fatalf("%s modified its operands: %s %s", op.name, xc.Hex(), yc.Hex())
+		}
+		if r := op.op(xc, xc, y.Clone()); r != xc || bigOf(r).Cmp(want) != 0 {
+			ht.Fatalf("%s with z aliasing x: have %s want %s", op.name, r.Hex(), want.Text(16))
+		}
+		if r := op.op(yc, x.Clone(), yc); r != yc || bigOf(r).Cmp(want) != 0 {
+			ht.Fatalf("%s with z aliasing y: have %s want %s", op.name, r.Hex(), want.Text(16))
+		}
+		if xc2 := x.Clone(); true {
+			if r := op.op(xc2, xc2, xc2); r != xc2 || bigOf(r).Cmp(op.ref(bx, bx)) != 0 {
+				ht.Fatalf("%s(x, x) with z aliasing both: have %s want %s", op.name, r.Hex(), op.ref(bx, bx).Text(16))
+			}
+		}
+
+		// overflow-reporting variants and the uint64 conveniences
+		sum := new(big.Int).Add(bx, by)
+		if r, of := new(Int).AddOverflow(x, y); bigOf(r).Cmp(u256(sum)) != 0 || of != (sum.Cmp(two256) >= 0) {
+			ht.Fatalf("AddOverflow: have %s,%v want %s,%v", r.Hex(), of, u256(sum).Text(16), sum.Cmp(two256) >= 0)
+		}
+		diff := new(big.Int).Sub(bx, by)
+		if r, of := new(Int).SubOverflow(x, y); bigOf(r).Cmp(u256(diff)) != 0 || of != (diff.Sign() < 0) {
+			ht.Fatalf("SubOverflow: have %s,%v want %s,%v", r.Hex(), of, u256(diff).Text(16), diff.Sign() < 0)
+		}
+		prod := new(big.Int).Mul(bx, by)
+		if r, of := new(Int).MulOverflow(x, y); bigOf(r).Cmp(u256(prod)) != 0 || of != (prod.Cmp(two256) >= 0) {
+			ht.Fatalf("MulOverflow: have %s,%v want %s,%v", r.Hex(), of, u256(prod).Text(16), prod.Cmp(two256) >= 0)
+		}
+		w := genWord(ht)
+		bw := new(big.Int).SetUint64(w)
+		if r := new(Int).AddUint64(x, w); bigOf(r).Cmp(u256(new(big.Int).Add(bx, bw))) != 0 {
+			ht.Fatalf("AddUint64(%s, %d) = %s", x.Hex(), w, r.Hex())
+		}
+		if r := x.Clone().IAddUint64(w); bigOf(r).Cmp(u256(new(big.Int).Add(bx, bw))) != 0 {
+			ht.Fatalf("IAddUint64(%s, %d) = %s", x.Hex(), w, r.Hex())
+		}
+		if r := new(Int).SubUint64(x, w); bigOf(r).Cmp(u256(new(big.Int).Sub(bx, bw))) != 0 {
+			ht.Fatalf("SubUint64(%s, %d) = %s", x.Hex(), w, r.Hex())
+		}
+		if r := x.Clone().ISubUint64(w); bigOf(r).Cmp(u256(new(big.Int).Sub(bx, bw))) != 0 {
+			ht.Fatalf("ISubUint64(%s, %d) = %s", x.Hex(), w, r.Hex())
+		}
+
+		// shifts
+		s := shiftAmount(ht)
+		if r := new(Int).Lsh(x, s); bigOf(r).Cmp(u256(new(big.Int).Lsh(bx, s))) != 0 {
+			ht.Fatalf("Lsh(%s, %d) = %s", x.Hex(), s, r.Hex())
+		}
+		if r := x.Clone().ILsh(s); bigOf(r).Cmp(u256(new(big.Int).Lsh(bx, s))) != 0 {
+			ht.Fatalf("ILsh(%s, %d) = %s", x.Hex(), s, r.Hex())
+		}
+		if r := new(Int).Rsh(x, s); bigOf(r).Cmp(new(big.Int).Rsh(bx, s)) != 0 {
+			ht.Fatalf("Rsh(%s, %d) = %s", x.Hex(), s, r.Hex())
+		}
+		if r := x.Clone().IRsh(s); bigOf(r).Cmp(new(big.Int).Rsh(bx, s)) != 0 {
+			ht.Fatalf("IRsh(%s, %d) = %s", x.Hex(), s, r.Hex())
+		}
+		srsh := u256(new(big.Int).Rsh(s256(bx), s)) // big.Rsh rounds toward -inf, as an arithmetic shift does
+		if r := new(Int).SRsh(x, s); bigOf(r).Cmp(srsh) != 0 {
+			ht.Fatalf("SRsh(%s, %d) = %s want %s", x.Hex(), s, r.Hex(), srsh.Text(16))
+		}
+		if r := x.Clone().ISRsh(s); bigOf(r).Cmp(srsh) != 0 {
+			ht.Fatalf("ISRsh(%s, %d) = %s want %s", x.Hex(), s, r.Hex(), srsh.Text(16))
+		}
+	})
+}
+
+// TestHegelModularOperationsMatchBigInt: AddMod, MulMod (with and without a precomputed
+// reciprocal), MulDivOverflow and MulDivOverflowRem agree with exact arithmetic, including the
+// aliasing forms the library supports (the result aliasing an operand, DivMod's z == m).
+func TestHegelModularOperationsMatchBigInt(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x, y, m := genInt(ht), genInt(ht), genInt(ht)
+		if chance(ht, 30) {
+			// operands already reduced, the fast path of AddMod
+			if !m.IsZero() {
+				x.Mod(x, m)
+				y.Mod(y, m)
+			}
+		}
+		note(ht, "x=%s y=%s m=%s", x.Hex(), y.Hex(), m.Hex())
+		bx, by, bm := bigOf(x), bigOf(y), bigOf(m)
+		var wantAdd, wantMul *big.Int
+		if bm.Sign() == 0 {
+			wantAdd, wantMul = new(big.Int), new(big.Int)
+		} else {
+			wantAdd = new(big.Int).Mod(new(big.Int).Add(bx, by), bm)
+			wantMul = new(big.Int).Mod(new(big.Int).Mul(bx, by), bm)
+		}
+		check := func(name string, have *Int, want *big.Int) {
+			if bigOf(have).Cmp(want) != 0 {
+				ht.Fatalf("%s: have %s want %s", name, have.Hex(), want.Text(16))
+			}
+		}
+		xc, yc, mc := x.Clone(), y.Clone(), m.Clone()
+		check("AddMod", new(Int).AddMod(xc, yc, mc), wantAdd)
+		check("MulMod", new(Int).MulMod(xc, yc, mc), wantMul)
+		if !xc.Eq(x) || !yc.Eq(y) || !mc.Eq(m) {
+			ht.Fatalf("operands modified")
+		}
+		check("AddMod z==x", xc.AddMod(xc, y, m), wantAdd)
+		check("AddMod z==y", yc.AddMod(x, yc, m), wantAdd)
+		check("AddMod z==m", mc.AddMod(x, y, mc), wantAdd)
+		xc, yc, mc = x.Clone(), y.Clone(), m.Clone()
+		check("MulMod z==x", xc.MulMod(xc, y, m), wantMul)
+		check("MulMod z==y", yc.MulMod(x, yc, m), wantMul)
+		check("MulMod z==m", mc.MulMod(x, y, mc), wantMul)
+		check("IAddMod", x.Clone().IAddMod(y, m), wantAdd)
+		check("IMulMod", x.Clone().IMulMod(y, m), wantMul)
+		mu := Reciprocal(m)
+		check("MulModWithReciprocal", new(Int).MulModWithReciprocal(x, y, m, &mu), wantMul)
+		check("IMulModWithReciprocal", x.Clone().IMulModWithReciprocal(y, m, &mu), wantMul)
+		if m[3] != 0 {
+			// the same modulus through both routes must agree word for word
+			if r1, r2 := new(Int).MulMod(x, y, m), new(Int).MulModWithReciprocal(x, y, m, &mu); !r1.Eq(r2) {
+				ht.Fatalf("MulMod %s vs MulModWithReciprocal %s", r1.Hex(), r2.Hex())
+			}
+		}
+
+		// (x*y)/m with full precision
+		var wantQ, wantR *big.Int
+		wantOverflow := false
+		if bm.Sign() == 0 {
+			wantQ, wantR = new(big.Int), new(big.Int)
+		} else {
+			wantQ, wantR = new(big.Int).DivMod(new(big.Int).Mul(bx, by), bm, new(big.Int))
+			wantOverflow = wantQ.Cmp(two256) >= 0
+			wantQ = u256(wantQ)
+		}
+		if q, of := new(Int).MulDivOverflow(x, y, m); bigOf(q).Cmp(wantQ) != 0 || of != wantOverflow {
+			ht.Fatalf("MulDivOverflow: have %s,%v want %s,%v", q.Hex(), of, wantQ.Text(16), wantOverflow)
+		}
+		xc = x.Clone()
+		if q, of := xc.MulDivOverflow(xc, y, m); q != xc || bigOf(q).Cmp(wantQ) != 0 || of != wantOverflow {
+			ht.Fatalf("MulDivOverflow z==x: have %s,%v", q.Hex(), of)
+		}
+		mc = m.Clone()
+		if q, of := mc.MulDivOverflow(x, y, mc); q != mc || bigOf(q).Cmp(wantQ) != 0 || of != wantOverflow {
+			ht.Fatalf("MulDivOverflow z==d: have %s,%v", q.Hex(), of)
+		}
+		var rem Int
+		if q, r, of := new(Int).MulDivOverflowRem(x, y, m, &rem); r != &rem || bigOf(q).Cmp(wantQ) != 0 || bigOf(r).Cmp(wantR) != 0 || of != wantOverflow {
+			ht.Fatalf("MulDivOverflowRem: have %s,%s,%v want %s,%s,%v", q.Hex(), r.Hex(), of, wantQ.Text(16), wantR.Text(16), wantOverflow)
+		}
+		// the result aliasing x or y (the remainder aliasing d or z is uint256/4)
+		xc, yc = x.Clone(), y.Clone()
+		if q, r, _ := xc.MulDivOverflowRem(xc, yc, m, &rem); bigOf(q).Cmp(wantQ) != 0 || bigOf(r).Cmp(wantR) != 0 {
+			ht.Fatalf("MulDivOverflowRem z==x: have %s,%s", q.Hex(), r.Hex())
+		}
+		xc, yc = x.Clone(), y.Clone()
+		if q, r, _ := new(Int).MulDivOverflowRem(xc, yc, m, xc); bigOf(q).Cmp(wantQ) != 0 || bigOf(r).Cmp(wantR) != 0 {
+			ht.Fatalf("MulDivOverflowRem m==x: have %s,%s", q.Hex(), r.Hex())
+		}
+
+		// DivMod with z aliasing m, and both results aliasing operands
+		var wantDq, wantDr *big.Int
+		if by.Sign() == 0 {
+			wantDq, wantDr = new(big.Int), new(big.Int)
+		} else {
+			wantDq, wantDr = new(big.Int).DivMod(bx, by, new(big.Int))
+		}
+		xc = x.Clone()
+		if q, r := xc.DivMod(x, y, xc); bigOf(q).Cmp(wantDq) != 0 || bigOf(r).Cmp(wantDr) != 0 {
+			ht.Fatalf("DivMod z==m: have %s,%s want %s,%s", q.Hex(), r.Hex(), wantDq.Text(16), wantDr.Text(16))
+		}
+		xc, yc = x.Clone(), y.Clone()
+		if q, r := xc.DivMod(xc, yc, yc); bigOf(q).Cmp(wantDq) != 0 || bigOf(r).Cmp(wantDr) != 0 {
+			ht.Fatalf("DivMod z==x,m==y: have %s,%s want %s,%s", q.Hex(), r.Hex(), wantDq.Text(16), wantDr.Text(16))
+		}
+		xc, yc = x.Clone(), y.Clone()
+		if q, r := yc.DivMod(xc, yc, xc); bigOf(q).Cmp(wantDq) != 0 || bigOf(r).Cmp(wantDr) != 0 {
+			ht.Fatalf("DivMod z==y,m==x: have %s,%s want %s,%s", q.Hex(), r.Hex(), wantDq.Text(16), wantDr.Text(16))
+		}
+	})
+}
