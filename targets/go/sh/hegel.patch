+// sh/8: a `[[ ]]` test after a heredoc on the same line makes the printer
+// write the delimiter before the body.
+func TestHegelPinHeredocBodiesPrecedeTheirDelimiter(t *testing.T) {
+	for _, src := range []string{"cat <<EOF && [[ a ]]\nbody\nEOF\n", "cat <<EOF | [[ -n $x ]]\nbody\nEOF\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out := defaultPrint(f)
+		if _, err := syntax.NewParser().Parse(strings.NewReader(out), ""); err != nil {
+			t.Errorf("print of %q is %q, which does not parse: %v", src, out, err)
+		}
+	}
+}
