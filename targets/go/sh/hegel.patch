+// sh/13: a case item with neither a body nor a `;;` has no End position.
+func TestHegelPinEmptyCaseItemsHaveAnEnd(t *testing.T) {
+	for _, src := range []string{"case aa in\n(a)\nesac\n", "case aa in a) esac\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		ci := f.Stmts[0].Cmd.(*syntax.CaseClause).Items[0]
+		if !ci.End().IsValid() {
+			t.Errorf("Parse(%q): the case item at %s has an invalid End", src, ci.Pos())
+			continue
+		}
+		if want := strings.Index(src, ")") + 1; int(ci.End().Offset()) != want {
+			t.Errorf("Parse(%q): the case item ends at offset %d, want %d (after the `)`)", src, ci.End().Offset(), want)
+		}
+	}
+}
