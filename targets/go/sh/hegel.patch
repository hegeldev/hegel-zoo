+// sh/8: a `[[ ]]` after a heredoc on the same line (after `&&`, `||` or a
+// pipe) prints the delimiter before the body.
+func TestHegelHeredocBodiesBeforeDoubleBracketsFormat(t *testing.T) {
+	progs := around(bashOnly, false, func(tc hegel.TestCase, g *grammar) []line {
+		first := withHeredoc(tc, g)
+		test := rawCmd{hegel.Draw(tc, g.tests)}
+		return []line{{list: joinedBy(hegel.Draw(tc, pick(" && ", " || ", " | ", " |& ")), pipeOf(first), pipeOf(test)), term: hegel.Draw(tc, maybe(20, lit(";")))}}
+	})
+	cases := fmtCasesOf(progs, optionsWith(func(o *printOpts) { o.singleLine = false }))
+	shapeProperty(t, "sh/8", func(ht *hegel.T) { checkFormatting(ht, hegel.Draw(ht, cases)) })
+}
+
+// sh/9: a process substitution glued to a substitution or to another
+// process substitution is printed as a word of its own, and `x[1]=<(a)`
+// as `x[1]= <(a)`.
+func TestHegelGluedProcessSubstitutionsPrintAsOneWord(t *testing.T) {
+	progs := around(bashOnly, false, func(tc hegel.TestCase, g *grammar) []line {
+		procSubsts := hegel.Composite(func(tc hegel.TestCase) string {
+			return hegel.Draw(tc, pick("<(", ">(")) + text(hegel.Draw(tc, g.inlineLists)) + ")"
+		})
+		if hegel.Draw(tc, chance(70)) {
+			first := hegel.Draw(tc, weighted(
+				choice[string]{weight: 2, gen: procSubsts},
+				choice[string]{weight: 2, gen: g.cmdSubsts},
