+// sh/14: `function f ( ... )`, a function whose body is a subshell, is
+// rejected as an unfinished `function f()`; bash defines and runs it.
+func TestHegelPinFunctionWithSubshellBody(t *testing.T) {
+	for _, src := range []string{"function f ( a; )\n", "function f (a)\n"} {
+		f, err := syntax.NewParser(syntax.Variant(syntax.LangBash)).Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Errorf("Parse(%q): %v (bash accepts it)", src, err)
