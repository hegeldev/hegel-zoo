+var quoteRunes = []rune{'a', 'b', 'Z', '0', ' ', '\t', '\n', '\'', '"', '$', '`', '\\', '*', '?', '[', ']', '~', '#', '!', '{', '}', '(', ')', ';', '&', '|', '<', '>', '=', ',', ':', '-', '@', '%', '^', 'é', '○', '€', '\u00a0', '\u200b', '\U0001F600', '\x01', '\x7f', '\x0b', '\x1b', '\r', '\x00'}
+
+func genQuoteInput(tc hegel.TestCase) string {
+	var sb strings.Builder
+	for i, k := 0, n(tc, 0, 8); i < k; i++ {
+		if chance(tc, 5) {
+			sb.WriteByte(byte(n(tc, 0x80, 0xff))) // invalid UTF-8
+			continue
+		}
+		sb.WriteRune(pick(tc, quoteRunes...))
+	}
+	return sb.String()
+}
