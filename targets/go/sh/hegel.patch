+// sh/2: `time ! cmd` and `! ! cmd` are rejected although bash accepts both.
+func TestHegelPinNegationWhereBashAllowsIt(t *testing.T) {
+	for _, src := range []string{"time ! true\n", "! ! true\n", "! time ! true\n"} {
+		f, err := syntax.NewParser(syntax.Variant(syntax.LangBash)).Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Errorf("Parse(%q) in bash mode: %v (bash runs it)", src, err)
+			continue
+		}
+		out := defaultPrint(f)
+		if _, err := syntax.NewParser(syntax.Variant(syntax.LangBash)).Parse(strings.NewReader(out), ""); err != nil {
+			t.Errorf("Parse(%q) printed as %q does not parse back: %v", src, out, err)
+		}
+	}
+}
