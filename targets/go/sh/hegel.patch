+// sh/5: a heredoc's body is printed inside a command substitution, subshell,
+// process substitution or backquotes that follow it on the same line, where
+// neither this parser nor bash finds it.
+func TestHegelPinHeredocBodiesStayOutsideSubstitutions(t *testing.T) {
+	for _, src := range []string{"cat <<EOF && echo $(a; b)\nbody\nEOF\n", "cat <<EOF && (a; b)\nbody\nEOF\n", "cat <<EOF | echo <(a; b)\nbody\nEOF\n", "cat <<EOF && echo `a; b`\nbody\nEOF\n"} {
+		for _, mode := range []struct {
+			name string
+			opts []syntax.PrinterOption
+		}{{"default", nil}, {"minify", []syntax.PrinterOption{syntax.Minify(true)}}} {
+			f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+			if err != nil {
+				t.Fatalf("Parse(%q): %v", src, err)
+			}
+			out, err := printNode(syntax.NewPrinter(mode.opts...), f)
+			if err != nil {
+				t.Fatalf("Print: %v", err)
+			}
+			f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+			if err != nil {
+				t.Errorf("%s print of %q is %q, which does not parse: %v", mode.name, src, out, err)
+				continue
+			}
+			if shape(f) != shape(f2) {
+				t.Errorf("%s print of %q is %q, a different program", mode.name, src, out)
+			}
+		}
+	}
+}
