+package syntax_test
+
+// One plain test per recorded bug (bugs.toml). Each asserts the correct
+// behaviour and fails while the bug is open; target.toml lists them as
+// expected failures.
+
+import (
+	"strings"
+	"testing"
+
+	"mvdan.cc/sh/v3/syntax"
+)
+
+// sh/1: a comment right after a `let` clause is a parse error, and so are
+// `|&` (`let x=1 |& cat`) and a `|` glued to `[` or `{` (`let x=1 |[ a ]`,
+// which is how Minify prints `let x=1 | [ a ]`); `let x=1 | cat` parses.
+func TestHegelPinLetAcceptsATrailingComment(t *testing.T) {
+	for _, src := range []string{"let x=1 | [ a = a ]\n", "let x=1 | { a; }\n", "let x=1 && [[ a ]]\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.Minify(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		if ok, _ := shellAccepts(syntax.LangBash, out); !ok {
+			t.Fatalf("bash rejects %q", out)
+		}
+		if _, err := syntax.NewParser().Parse(strings.NewReader(out), ""); err != nil {
+			t.Errorf("minified %q is %q, which does not parse: %v (bash accepts it)", src, out, err)
+		}
+	}
+	for _, src := range []string{"let x=1 |& cat\n", "let \"x = 1\" |& cat\n"} {
+		if ok, _ := shellAccepts(syntax.LangBash, src); !ok {
+			t.Fatalf("bash rejects %q", src)
+		}
+		if _, err := syntax.NewParser().Parse(strings.NewReader(src), ""); err != nil {
+			t.Errorf("Parse(%q): %v (bash accepts it)", src, err)
+		}
+	}
+	for _, src := range []string{"let x=1 # c\n", "let x=1 y=2 # c\n", "let \"x = 1\" #\n", "let x=1 #c"} {
+		f, err := syntax.NewParser(syntax.KeepComments(true)).Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Errorf("Parse(%q): %v (bash accepts it)", src, err)
+			continue
+		}
+		if len(f.Stmts) != 1 {
+			t.Errorf("Parse(%q): %d statements", src, len(f.Stmts))
+			continue
+		}
+		if _, ok := f.Stmts[0].Cmd.(*syntax.LetClause); !ok {
+			t.Errorf("Parse(%q): command is a %T, not a LetClause", src, f.Stmts[0].Cmd)
+		}
+		if len(f.Stmts[0].Comments) != 1 {
+			t.Errorf("Parse(%q): %d comments on the statement, want 1", src, len(f.Stmts[0].Comments))
+		}
+	}
+}
