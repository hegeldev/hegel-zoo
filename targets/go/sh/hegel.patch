+// sh/16: Simplify rewrites `"\`"` inside a double-quoted `${x:-...}` as `'`'`;
+// within double quotes the single quotes are literal, so the expansion
+// changes (bash: "no closing backquote"; `"\$"` becomes the three characters '$').
+func TestHegelPinSimplifyKeepsQuotesInsideQuotedExpansions(t *testing.T) {
+	for _, src := range []string{"echo \"a${x:-\"\\`\"}b\"\n", "echo \"${x:-\"\\$\"}\"\n", "echo \"${x#\"\\`\"}\"\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		syntax.Simplify(f)
+		out := defaultPrint(f)
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out, err)
+		}
+		inDq := 0
+		syntax.Walk(f2, func(node syntax.Node) bool {
+			switch node.(type) {
+			case *syntax.DblQuoted:
+				inDq++
+			case *syntax.SglQuoted:
+				if inDq > 0 {
+					t.Errorf("Simplify turned %q into %q: single quotes inside double quotes are literal", src, out)
+				}
+			}
+			return true
+		})
+	}
+}
