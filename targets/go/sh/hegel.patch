+// sh/12: `${x/}` is printed as `${x//}`, a different expansion (replace all)
+// that grows another slash on every pass.
+func TestHegelPinEmptyReplacementPrintsAsItself(t *testing.T) {
+	src := "echo ${x/}\n"
+	f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", src, err)
+	}
+	out := defaultPrint(f)
+	f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", out, err)
+	}
+	if shape(f) != shape(f2) {
+		t.Errorf("%q prints as %q, a different expansion", src, out)
+	}
+	if out2 := defaultPrint(f2); out2 != out {
+		t.Errorf("printing is not idempotent: %q -> %q -> %q", src, out, out2)
+	}
+}
