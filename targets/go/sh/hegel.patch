+			t.Errorf("Parse(%q): command is a %T", src, f.Stmts[0].Cmd)
+			continue
+		}
+		if _, ok := fd.Body.Cmd.(*syntax.Subshell); !ok {
+			t.Errorf("Parse(%q): the body is a %T, not a subshell", src, fd.Body.Cmd)
+		}
+	}
