+// sh/6: a comment ending in a backslash is continued onto the next line, which
+// then joins the command; bash and dash end every comment at the newline.
+func TestHegelPinCommentsEndAtTheNewline(t *testing.T) {
+	src := "echo a # b\\\necho c\n"
+	f, err := syntax.NewParser(syntax.KeepComments(true)).Parse(strings.NewReader(src), "")
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", src, err)
+	}
+	if len(f.Stmts) != 2 {
+		t.Fatalf("Parse(%q): %d statements, want 2 (echo a; echo c); printed as %q", src, len(f.Stmts), defaultPrint(f))
+	}
+	if call, ok := f.Stmts[0].Cmd.(*syntax.CallExpr); !ok || len(call.Args) != 2 {
+		t.Errorf("Parse(%q): the first statement is %s, want `echo a`", src, defaultPrint(f.Stmts[0]))
+	}
+	if len(f.Stmts[0].Comments) != 1 || f.Stmts[0].Comments[0].Text != " b\\" {
+		t.Errorf("Parse(%q): first statement's comments are %q, want [\" b\\\\\"]", src, f.Stmts[0].Comments)
+	}
+	// Without comments kept, the two statements must still be separate.
+	f, err = syntax.NewParser().Parse(strings.NewReader(src), "")
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", src, err)
+	}
+	if len(f.Stmts) != 2 {
+		t.Errorf("Parse(%q) without KeepComments: %d statements, want 2", src, len(f.Stmts))
+	}
+}
