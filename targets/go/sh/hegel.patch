+		op := hegel.Draw(tc, pick(" | ", " && ", " || ", "; ", " & "))
+		if strings.TrimSpace(op) == ";" || strings.TrimSpace(op) == "&" {
+			return []line{{list: appendList(stmt(first), op, andOrOf(pipeOf(second)))}}
+		}
+		return []line{{list: joinedBy(op, pipeOf(first), pipeOf(second))}}
+	})
+	cases := fmtCasesOf(progs, printOptions)
+	shapeProperty(t, "sh/27", func(ht *hegel.T) { checkFormatting(ht, hegel.Draw(ht, cases)) })
+}
+
+// sh/28: InteractiveSeq yields the statements before a heredoc twice when a
+// line of the heredoc's body (or its delimiter) starts at the parser's
+// 1024-byte read boundary.
+func TestHegelInteractiveSeqYieldsStatementsBeforeBoundaryHeredocsOnce(t *testing.T) {
+	cases := hegel.Composite(func(tc hegel.TestCase) streamCase {
+		bash := hegel.Draw(tc, anyDialect)
+		g := grammarOf(bash, false, true)
+		g.budget(10)
+		prefix := slices.DeleteFunc(surroundings(hegel.Draw(tc, many(g.lines, 0, 2))), func(l line) bool {
+			return heredocOp(textNoBodies(l)) >= 0 // a heredoc of the prefix would be the one at the boundary
+		})
+		g.budget(10)
+		// The heredoc line: two or more statements, the last with the heredoc.
+		list := stmt(hegel.Draw(tc, g.inlineSimples))
+		for range hegel.Draw(tc, hegel.Integers(1, 2)) {
+			list = appendList(list, hegel.Draw(tc, pick("; ", ";", " & ")), andOrOf(pipeOf(hegel.Draw(tc, g.inlineSimples))))
+		}
+		hd := hegel.Draw(tc, g.heredocs)
+		hl := line{list: list, hdoc: &hd, term: hegel.Draw(tc, maybe(20, lit(";")))}
+		// The comment line before it pads the program so that the chosen
+		// line of the body starts at a multiple of 1024.
+		bodyLines := strings.SplitAfter(hd.body, "\n")
+		bodyLines = bodyLines[:len(bodyLines)-1]
+		j := hegel.Draw(tc, positions) % len(bodyLines)
+		before := len(program{prefix}.String()) + len(textNoBodies(hl))
+		for _, l := range bodyLines[:j] {
+			before += len(l)
+		}
+		pad := 1024 - before
+		for pad < 2 {
+			pad += 1024
+		}
+		hl.lead = "#" + strings.Repeat("-", pad-2)
+		return streamCase{kind: interactiveSeq, bash: bash, prog: program{append(prefix, hl)}}
+	})
+	shapeProperty(t, "sh/28", func(ht *hegel.T) { checkStreams(ht, hegel.Draw(ht, cases)) })
+}
