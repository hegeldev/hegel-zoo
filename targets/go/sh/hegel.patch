+// sh/3: KeepPadding is not idempotent: a negated statement that starts with
+// a redirect gains spaces on every pass, and with space indentation a
+// multi-line subshell gets trailing spaces after its `(` on the second pass.
+// Also: with KeepPadding, a negated statement that starts with a redirect
+// gains padding on every pass.
+func TestHegelPinKeepPaddingIsIdempotent(t *testing.T) {
+	for _, c := range []struct {
+		src    string
+		indent uint
+	}{{"! >aa foo\n", 0}, {"! >aa [ a = a ]\n", 0}, {"! 2>x foo bar\n", 0}, {"&>aa echo\n", 1}, {"a\n>x b\n", 2}, {"! (\ntrue\n)\n", 4}, {"(\ntrue\n)\n", 3}, {"(\ntrue\n) >>b | c\n", 2}} {
+		src := c.src
+		p := syntax.NewPrinter(syntax.KeepPadding(true), syntax.Indent(c.indent))
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		first, err := printNode(p, f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		f2, err := syntax.NewParser().Parse(strings.NewReader(first), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", first, err)
+		}
+		second, err := printNode(p, f2)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		if first != second {
+			t.Errorf("KeepPadding is not idempotent on %q:\n first: %q\nsecond: %q", src, first, second)
+		}
+	}
+}
