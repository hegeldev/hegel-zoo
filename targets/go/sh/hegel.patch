+// sh/10: in `coproc cmd args`, the command's statement starts at its second
+// word, after the first was tried as the coprocess name; an assignment in
+// that position is an argument, so `coproc x=a x=b cmd` prints as
+// `coproc x=b x=a cmd` and `coproc &>f x=a cmd` (printed `coproc x=a &>f cmd`)
+// reads back as a different program.
+func TestHegelPinCoprocStatementsStartAtTheirCommand(t *testing.T) {
+	for _, src := range []string{"coproc &>aa x=a echo a\n", "coproc x=a x=b echo a\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out := defaultPrint(f)
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out, err)
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("%q prints as %q, a different program", src, out)
+		}
+	}
+	for _, src := range []string{"coproc echo a a", "coproc cat file"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		cc, ok := f.Stmts[0].Cmd.(*syntax.CoprocClause)
+		if !ok {
+			t.Fatalf("Parse(%q): command is a %T", src, f.Stmts[0].Cmd)
+		}
+		if cc.Name != nil {
+			t.Errorf("Parse(%q): coprocess name %s; a simple command has none", src, defaultPrint(cc.Name))
+		}
+		if span := src[cc.Stmt.Pos().Offset():cc.Stmt.End().Offset()]; span != defaultPrint(cc.Stmt) {
+			t.Errorf("Parse(%q): the coprocess statement %q spans %q (Pos %s)", src, defaultPrint(cc.Stmt), span, cc.Stmt.Pos())
+		}
+	}
+}
