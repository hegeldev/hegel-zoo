+package syntax_test
+
+// Hegel properties for mvdan.cc/sh/v3/syntax (the Hegel zoo). Oracles: the
+// parser and the printer against each other (a formatted program must parse
+// back to the same tree, format idempotently and stay valid shell), bash and
+// dash (`-n` on every printed program, `printf %s` on Quote's output), the
+// source text (node positions), and the package against itself (the streaming
+// parsers, typedjson, Simplify).
+//
+// A program is drawn as a small tree (lines of and-or lists of pipelines of
+// commands, whose words, expansions and redirects are strings built from
+// pools) from a grammar of shell constructs built once per dialect, and
+// rendered by a pure writer that puts every heredoc body after the next
+// newline token, where the shells read it; so every generated program is
+// valid for the dialect it is parsed in. The shapes of the recorded bugs
+// (bugs.toml) are drawn at their natural rate, so the properties that meet
+// them fail, and are the expected failures mapped to the bugs (STYLE.md rule
+// 11); HEGEL_NO_KNOWN=1 switches the shapes off (noKnown, below) for a run
+// that looks past the bugs.
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+	"mvdan.cc/sh/v3/expand"
+	"mvdan.cc/sh/v3/syntax"
+	"mvdan.cc/sh/v3/syntax/typedjson"
+)
+
+// ---------------------------------------------------------------------------
+// Harness plumbing (shared with the other Go targets of the zoo).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("SH_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// property runs fn as a Hegel property with the harness options (and any
+// more the caller passes: the narrow properties of hegel_shapes_test.go stop
+// at their first failure).
+func property(t *testing.T, fn func(ht *hegel.T), opts ...hegel.Option) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow (E_STOP_TEST on an overrun)
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, append(hegelOpts(), opts...)...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail; under HEGEL_NO_KNOWN=1 the gates of Known are on and
+// the shapes are left out of the generators and the printer options (shaped,
+// and the fix-ups the grammar applies only then).
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); a switch is
+// on only under HEGEL_NO_KNOWN=1, when the shape is left out. The pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	letComment         bool // sh/1: after a `let` clause a comment, `|&`, `|[` or `|{` is a parse error (Minify prints the last two)
+	timeBang           bool // sh/2: `time ! cmd` (and `! ! cmd`) are rejected although bash accepts them
+	keepPaddingBang    bool // sh/3: KeepPadding is not idempotent: a statement starting with a redirect grows spaces, a multi-line subshell gets trailing spaces after `(` with space indentation
+	negatedPipeline    bool // sh/4: the first statement of a negated pipeline starts at the `!`
+	hdocBeforeSubst    bool // sh/5: a heredoc body is printed inside a `$( )`, `( )`, `<( )` or backquotes that follow it on the line
+	commentBackslash   bool // sh/6: a comment ending in a backslash swallows the next line into the command
+	hdocComment        bool // sh/7: a comment after a heredoc redirect at the end of a pipeline or and-or list is dropped or moved
+	hdocBeforeTest     bool // sh/8: a `[[ ]]` after a heredoc on the same line prints the delimiter before the body
+	procSubstGlued     bool // sh/9: a process substitution glued to other word parts is printed as a word of its own
+	coprocStmtPos      bool // sh/10: `coproc` mishandles its first word: the statement starts after it, and an assignment there becomes an argument
+	minifyEmptyItem    bool // sh/11: Minify prints the `;;` of an empty last case item as `;`, which does not parse
+	emptyReplPrints    bool // sh/12: `${x/}` prints as `${x//}`, which means something else and grows a slash per pass
+	emptyCaseItemEnd   bool // sh/13: a case item with no body and no terminator has an invalid End
+	functionSubshell   bool // sh/14: `function f ( ... )` (a subshell body) is rejected although bash accepts it
+	dollarBackquote    bool // sh/15: backquotes right after a literal `$` print as `$$(...)`, the PID
+	quotesInQuotedExp  bool // sh/16: Simplify single-quotes a literal inside a double-quoted `${x:-"..."}`, where the quotes are literal
+	thenAfterRedirect  bool // sh/17: `done <redirect>; then` after a body ending in `&` loses its `;`
+	singleLineEsac     bool // sh/18: SingleLine puts nothing between `esac` (of a case with items) and the next statement
+	singleLineBgClose  bool // sh/19: SingleLine puts nothing between a `done`/`fi`/`}` closing a body that ends in `&` and the next statement
+	arithGluedSign     bool // sh/20: `$((+ ++x))` prints as `$((+++x))`, which the parser rejects (bash accepts both)
+	singleLineComment  bool // sh/21: SingleLine moves the comment after a multi-line compound command to its own line, after a dangling `;`
+	esacRedirectClose  bool // sh/22: the separator after a case statement is dropped: before `}`/`done`/`fi` after `esac <redirect>`, before `then`/`do` when the condition holds a case in a substitution
+	redirReturn        bool // sh/23: `>$(a; return) c` formats to a multi-line substitution keeping `a; return` on one line, then splits it
+	recoverArithAssign bool // sh/24: RecoverErrors panics on an assignment whose arithmetic expansion has a bad operator (`x=$((a b`)
+	minifyPipeRedirect bool // sh/25: Minify prints `a | &>f b` as `a|&>f b`, which is `a |& >f b`
+	substSubshell      bool // sh/26: `$( (a; b) )` prints with `) )`, then with `))`
+	hdocAfterParen     bool // sh/27: a heredoc body right after a `(` that opens a subshell is "unclosed here-document"
+	hdocReadBoundary   bool // sh/28: InteractiveSeq yields the statements before a heredoc twice when it sits at the 1024-byte read boundary
+}{
+	letComment: noKnown, timeBang: noKnown, keepPaddingBang: noKnown, negatedPipeline: noKnown,
+	hdocAfterParen: noKnown, hdocReadBoundary: noKnown,
+	hdocBeforeSubst: noKnown, commentBackslash: noKnown, hdocComment: noKnown, hdocBeforeTest: noKnown,
+	procSubstGlued: noKnown, coprocStmtPos: noKnown, minifyEmptyItem: noKnown, emptyReplPrints: noKnown,
+	emptyCaseItemEnd: noKnown, functionSubshell: noKnown, dollarBackquote: noKnown, quotesInQuotedExp: noKnown,
+	thenAfterRedirect: noKnown, singleLineEsac: noKnown, singleLineBgClose: noKnown, arithGluedSign: noKnown,
+	singleLineComment: noKnown, esacRedirectClose: noKnown, redirReturn: noKnown, recoverArithAssign: noKnown,
+	minifyPipeRedirect: noKnown, substSubshell: noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// bgBeforeClose matches a body whose last statement ends in `&` before its closing word.
+var bgBeforeClose = regexp.MustCompile(`&\s*\n\s*(done|fi|esac|\}|\))`)
+
+// closeFdGlued matches `>&-` or `<&-` glued to more characters (`>&-=`), which
+// bash rejects and this parser reads as a redirect to the word `-=`; not recorded.
+var closeFdGlued = regexp.MustCompile(`[<>]&-[^\s;&|)]`)
+
+// closeComment matches a comment right after the closing word of a compound
+// command that spans lines.
+var closeComment = regexp.MustCompile(`(^|\n)\s*(\}|fi|done|esac|\))\s*#`)
+
+// redirReturn matches a redirect whose target holds a substitution with a
+// statement list ending in `return`, `exit`, `break`, `continue` or `shift`.
+var redirReturn = regexp.MustCompile("[<>]&?[^\\s;|&()<>`]*(\\$\\(|`)[^)`]*;\\s*(return|exit|break|continue|shift)\\b")
+
+// openParenLine matches a parenthesis that ends its line: a multi-line
+// subshell or substitution.
+var openParenLine = regexp.MustCompile(`\(\s*(#[^\n]*)?\n`)
+
+// arithAssign matches an assignment whose value holds an arithmetic expansion.
+var arithAssign = regexp.MustCompile(`(^|[\s;|&({])\w+(\[[^]]*\])?\+?=[^\s]*\$(\(\(|\[)`)
+
+// pipeRedirect matches a `|` followed by a command starting with `&>`.
+var pipeRedirect = regexp.MustCompile(`\|\s*&>`)
+
+// negation matches a `!` that negates a command.
+var negation = regexp.MustCompile(`(^|[\s;|&({])!\s`)
+
+// assignWord matches an assignment word (the printer moves a coproc's leading
+// redirects after the assignments, which puts one first).
+var assignWord = regexp.MustCompile(`^\w+(\[[^]]*\])?\+?=`)
+
+// closeRedirect matches a line starting with a compound command's closing
+// word followed by a redirect.
+var closeRedirect = regexp.MustCompile(`^\s*(done|fi|esac|\)|\})\s+(\{\w+\}|\d*|&)[<>]`)
+
+// bgCloseRedirected reports whether a condition ends in a compound command
+// whose body's last line ends in `&` and which has a redirect after its
+// closing word: `done <redirect>; then` then loses its `;` (sh/17).
+func bgCloseRedirected(cond string) bool {
+	lines := strings.Split(strings.TrimRight(cond, "\n"), "\n")
+	n := len(lines)
+	return n >= 2 && closeRedirect.MatchString(lines[n-1]) && strings.HasSuffix(strings.TrimSpace(lines[n-2]), "&")
+}
+
+// emptyLastItem matches a case item without a body ending the case clause.
+var emptyLastItem = regexp.MustCompile(`\)\s*;[;&]+\s*esac`)
+
+// emptyRepl matches a `${x/}` expansion: a single slash and nothing after it.
+var emptyRepl = regexp.MustCompile(`\$\{[^{}/]*[^/]/\}`)
+
+// hdocPrinterShape reports whether a line of source has a shape the printer
+// mangles: after a heredoc redirect a substitution, subshell, process
+// substitution or backquotes that the printer breaks across lines (sh/5) or
+// a `[[` (sh/8). It reports false while the switches are off.
+func hdocPrinterShape(line string) bool {
+	i := heredocOp(line)
+	if i < 0 {
+		return false
+	}
+	rest := line[i+2:]
+	return (Known.hdocBeforeSubst && hdocSwallowed(rest)) || (Known.hdocBeforeTest && strings.Contains(rest, "[["))
+}
+
+// heredocOp finds the first heredoc operator on a line, `<<` or `<<-`: not
+// the here-string `<<<`, nor a shift `<<` or `<<=` inside `(( ))`. It
+// returns -1 when there is none.
+func heredocOp(line string) int {
+	depth := 0 // parentheses open inside an arithmetic `((`
+	for i := 0; i < len(line); i++ {
+		switch line[i] {
+		case '(':
+			if depth > 0 {
+				depth++
+			} else if i+1 < len(line) && line[i+1] == '(' {
+				depth = 2
+				i++
+			}
+		case ')':
+			if depth > 0 {
+				depth--
+			}
+		case '<':
+			if depth > 0 || !strings.HasPrefix(line[i:], "<<") {
+				continue
+			}
+			if strings.HasPrefix(line[i:], "<<<") || strings.HasPrefix(line[i:], "<<=") {
+				i += 2
+				continue
+			}
+			return i
+		}
+	}
+	return -1
+}
+
+// compoundStart matches the start of a compound command inside a
+// substitution, which the printer puts on lines of its own.
+var compoundStart = regexp.MustCompile(`(^|[\s;|&(])(if|while|until|for|case|\{)\s`)
+
+// hdocSwallowed reports whether rest, the text after a heredoc redirect on
+// its line, holds a `$( )`, `( )`, `<( )`, `>( )` or backquoted command that
+// the printer breaks across lines (several statements, a compound command,
+// a newline), where it would then print the heredoc body (sh/5). Arithmetic
+// `(( ))`, arrays `x=( )` and other parentheses inside words do not count;
+// an unclosed opener does.
+func hdocSwallowed(rest string) bool {
+	for i := 0; i < len(rest); i++ {
+		var content string
+		switch c := rest[i]; {
+		case c == '`':
+			j := strings.IndexByte(rest[i+1:], '`')
+			if j < 0 {
+				return true
+			}
+			content = rest[i+1 : i+1+j]
+			i += 1 + j
+		case c == '(':
+			prev := byte(' ')
+			if i > 0 {
+				prev = rest[i-1]
+			}
+			if prev == '(' || (i+1 < len(rest) && rest[i+1] == '(') {
+				continue // (( ))
+			}
+			if prev != '$' && prev != '<' && prev != '>' && !strings.ContainsRune(" \t|&;!(", rune(prev)) {
+				continue // a parenthesis inside a word: x=( ), ${x/(/a}
+			}
+			depth, j := 0, i
+			for ; j < len(rest); j++ {
+				if rest[j] == '(' {
+					depth++
+				} else if rest[j] == ')' {
+					if depth--; depth == 0 {
+						break
+					}
+				}
+			}
+			if j == len(rest) {
+				return true
+			}
+			content = rest[i+1 : j]
+			i = j
+		default:
+			continue
+		}
+		if strings.ContainsAny(content, ";\n") || compoundStart.MatchString(content) {
+			return true
+		}
+	}
+	return false
+}
+
+// caseInSubst matches a case clause inside a substitution, subshell or
+// backquotes on a line (the shape of sh/22 in a condition).
+var caseInSubst = regexp.MustCompile("[(`][^\n]*\\bcase ")
+
+// trailingComment matches a comment after a word.
+var trailingComment = regexp.MustCompile(`\s#`)
+
+// leadingRedirect matches a redirect operator that opens a statement after
+// `!`, a pipe, `&&`, `||`, `;`, an opening bracket or a keyword.
+var leadingRedirect = regexp.MustCompile(`(^|\n|[!|&;({]|\b(then|do|else|while|until|if|elif|time|-p))\s*(\{\w+\}|\d*)[<>&]`)
+
+// ---------------------------------------------------------------------------
+// The shells as oracles.
+
+var shellPath = map[syntax.LangVariant]string{}
+
+func init() {
+	if p, err := exec.LookPath("bash"); err == nil {
+		shellPath[syntax.LangBash] = p
+	}
+	if p, err := exec.LookPath("dash"); err == nil {
+		shellPath[syntax.LangPOSIX] = p
+	}
+}
+
+// shellAccepts runs the dialect's shell with -n on src (a syntax check, nothing
+// runs). Without the shell it reports true and an empty message.
+func shellAccepts(lang syntax.LangVariant, src string) (bool, string) {
+	sh, found := shellPath[lang]
+	if !found {
+		return true, ""
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, sh, "-n")
+	cmd.Stdin = strings.NewReader(src)
+	cmd.Dir = os.TempDir()
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	return err == nil, strings.TrimSpace(stderr.String())
+}
+
+// shellPrintf runs `printf %s <quoted>` in the dialect's shell and returns
+// what it printed. The caller has checked that quoted is a single literal word.
+func shellPrintf(lang syntax.LangVariant, quoted string) (string, bool) {
+	sh, found := shellPath[lang]
+	if !found {
+		return "", false
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, sh, "-c", "printf %s "+quoted)
+	cmd.Dir = os.TempDir()
+	out, err := cmd.Output()
+	if err != nil {
+		return "error: " + err.Error(), true
+	}
+	return string(out), true
+}
+
+// ---------------------------------------------------------------------------
+// Helpers around the package.
+
+func parse(lang syntax.LangVariant, src string, keepComments bool) (*syntax.File, error) {
+	return syntax.NewParser(syntax.Variant(lang), syntax.KeepComments(keepComments)).Parse(strings.NewReader(src), "")
+}
+
+func printNode(p *syntax.Printer, node syntax.Node) (string, error) {
+	var buf bytes.Buffer
+	err := p.Print(&buf, node)
+	return buf.String(), err
+}
+
+func defaultPrint(node syntax.Node) string {
+	s, err := printNode(syntax.NewPrinter(), node)
+	if err != nil {
+		return "print error: " + err.Error()
+	}
+	return s
+}
+
+// shape is the typed JSON of a node with every position removed: two nodes
+// with the same shape are the same tree up to where it was in the source.
+func shape(node syntax.Node) string { return shapeMode(node, false) }
+
+// shapeMinified also ignores what Minify is documented to shorten: `${x}`
+// becomes `$x` (ParamExp.Short), and the last case item's `;&` or `;;&`, which
+// has nothing left to fall through to, becomes `;;` or nothing.
+func shapeMinified(node syntax.Node) string { return shapeMode(node, true) }
+
+func shapeMode(node syntax.Node, minified bool) string {
+	var buf bytes.Buffer
+	if err := typedjson.Encode(&buf, node); err != nil {
+		return "encode error: " + err.Error()
+	}
+	var v any
+	if err := json.Unmarshal(buf.Bytes(), &v); err != nil {
+		return "decode error: " + err.Error()
+	}
+	out, err := json.Marshal(stripPos(v, minified))
+	if err != nil {
+		return "marshal error: " + err.Error()
+	}
+	return string(out)
+}
+
+func isPos(m map[string]any) bool {
+	if len(m) != 3 {
+		return false
+	}
+	_, a := m["Offset"]
+	_, b := m["Line"]
+	_, c := m["Col"]
+	return a && b && c
+}
+
+// Two normalisations the formatter makes and the tree comparison must not
+// see: trailing whitespace of a comment is dropped, and the tabs before a
+// `<<-` heredoc's delimiter, which the parser keeps at the end of the body,
+// are dropped with the body's re-indentation.
+func normalise(x map[string]any) {
+	delete(x, "Backquotes") // the printer writes every command substitution as $( )
+	if text, ok := x["Text"].(string); ok && len(x) <= 2 {
+		if text = strings.TrimRight(text, " \t"); text == "" {
+			delete(x, "Text") // typedjson omits empty strings
+		} else {
+			x["Text"] = text
+		}
+	}
+	if op, _ := x["Op"].(string); op == "<<-" {
+		if hdoc, ok := x["Hdoc"].(map[string]any); ok {
+			parts, _ := hdoc["Parts"].([]any)
+			for i, part := range parts {
+				lit, ok := part.(map[string]any)
+				if !ok || lit["Type"] != "Lit" {
+					continue
+				}
+				val, _ := lit["Value"].(string)
+				val = strings.ReplaceAll(val, "\n\t", "\n")
+				for strings.Contains(val, "\n\t") {
+					val = strings.ReplaceAll(val, "\n\t", "\n")
+				}
+				if i == 0 {
+					val = strings.TrimLeft(val, "\t")
+				}
+				if i == len(parts)-1 {
+					val = strings.TrimRight(val, "\t")
+				}
+				lit["Value"] = val
+			}
+			kept := parts[:0:0]
+			for _, part := range parts {
+				if lit, ok := part.(map[string]any); ok && lit["Type"] == "Lit" && lit["Value"] == "" {
+					continue
+				}
+				kept = append(kept, part)
+			}
+			if len(kept) == 0 {
+				delete(x, "Hdoc")
+			} else {
+				hdoc["Parts"] = kept
+			}
+		}
+	}
+}
+
+func stripPos(v any, minified bool) any {
+	switch x := v.(type) {
+	case map[string]any:
+		for k, val := range x {
+			if m, ok := val.(map[string]any); ok && isPos(m) {
+				delete(x, k)
+				continue
+			}
+			x[k] = stripPos(val, minified)
+		}
+		normalise(x)
+		if minified {
+			delete(x, "Short")
+			if items, ok := x["Items"].([]any); ok && x["Type"] == "CaseClause" && len(items) > 0 {
+				if last, ok := items[len(items)-1].(map[string]any); ok {
+					last["Op"] = ";;"
+				}
+			}
+		}
+		return x
+	case []any:
+		for i := range x {
+			x[i] = stripPos(x[i], minified)
+		}
+		return x
+	}
+	return v
+}
+
+// firstDiff describes where two strings first differ.
+func firstDiff(a, b string) string {
+	i := 0
+	for i < len(a) && i < len(b) && a[i] == b[i] {
+		i++
+	}
+	lo := max(0, i-60)
+	return fmt.Sprintf("at byte %d:\n  a: %q\n  b: %q", i, a[lo:min(len(a), i+60)], b[lo:min(len(b), i+60)])
+}
+
+// lineCol computes the 1-based line and byte column of offset off in src.
+func lineCol(src string, off int) (int, int) {
+	before := src[:off]
+	return 1 + strings.Count(before, "\n"), off - strings.LastIndex(before, "\n")
+}
+
+func langName(lang syntax.LangVariant) string {
+	if lang == syntax.LangBash {
+		return "bash"
+	}
+	return "posix"
+}
+
+func langOf(bash bool) syntax.LangVariant {
+	if bash {
+		return syntax.LangBash
+	}
+	return syntax.LangPOSIX
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms. The engine rejects a case whose generator spans nest a
+// hundred deep (every Composite, Map, FlatMap, Filter and Lists is a span),
+// so the recursive grammar below keeps its layers few: chains are one
+// Composite each, and a forward reference is read when drawn (later, or a
+// variable read inside a Composite body) rather than wrapped in a Composite
+// of its own.
+
+// choice is one alternative of a weighted choice: a generator, or (late) a
+// reference to one assigned later, the forward reference of a recursive
+// grammar.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+	late   *hegel.Generator[T]
+}
+
+func later[T any](weight int, g *hegel.Generator[T]) choice[T] {
+	return choice[T]{weight: weight, late: g}
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	return weightedOr(nil, choices...)
+}
+
+// weightedOr is weighted with a guard read when drawn: when guard returns a
+// generator, that is drawn instead of the choice (the fallback of a
+// recursive grammar past its depth, in the choice's own span).
+func weightedOr[T any](guard func() hegel.Generator[T], choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		if guard != nil {
+			if g := guard(); g != nil {
+				return g
+			}
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				if c.late != nil {
+					return *c.late
+				}
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{weight: 100 - pct, gen: hegel.Just(zero)}, choice[T]{weight: pct, gen: g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// cat draws one string from each generator and joins them: the pieces of a
+// token.
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+// wrap puts a prefix and a suffix around what g generates.
+func wrap(prefix string, g hegel.Generator[string], suffix string) hegel.Generator[string] {
+	return hegel.Map(g, func(s string) string { return prefix + s + suffix })
+}
+
+// joined is a list of lo to hi strings joined by sep.
+func joined(g hegel.Generator[string], lo, hi int, sep string) hegel.Generator[string] {
+	return hegel.Map(many(g, lo, hi), func(xs []string) string { return strings.Join(xs, sep) })
+}
+
+// positions: an index into live data of unknown size, taken modulo the
+// size when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// ---------------------------------------------------------------------------
+// The program tree: what a case draws. Rendering is a pure function of the
+// tree. The writer keeps the heredoc bodies of the current line and writes
+// them after the next newline token, which is where bash, dash and the
+// parser read them (also inside a compound command that follows the redirect
+// on the line); a newline inside quotes is not a token and flushes nothing.
+
+type writer struct {
+	sb       strings.Builder
+	pending  []string
+	last     byte // the last byte written
+	noBodies bool // drop the bodies (the text of a line without its heredocs)
+
+	// Two placements of a body that the shells accept but not everyone
+	// else, reported for the line filter: right after a `(` that opens a
+	// subshell (the parser says "unclosed here-document", sh/27) and
+	// between a `for` head and its `do` (dash rejects it).
+	bodyAfterParen, bodyAfterForHead bool
+}
+
+func (w *writer) str(s string) {
+	w.sb.WriteString(s)
+	if s != "" {
+		w.last = s[len(s)-1]
+	}
+}
+
+func (w *writer) nl() {
+	if len(w.pending) > 0 && w.last == '(' {
+		w.bodyAfterParen = true
+	}
+	w.sb.WriteByte('\n')
+	w.last = '\n'
+	if !w.noBodies {
+		for _, b := range w.pending {
+			w.sb.WriteString(b)
+		}
+	}
+	w.pending = nil
+}
+
+func (w *writer) hdoc(body string) { w.pending = append(w.pending, body) }
+
+// node is anything the writer renders; cmd is a command of any kind.
+type node interface{ render(w *writer) }
+
+type cmd = node
+
+// text renders a node on its own (an inline node, or a line with its bodies).
+func text(n node) string {
+	w := &writer{}
+	n.render(w)
+	return w.sb.String()
+}
+
+// textNoBodies renders a node without its heredoc bodies: the text the
+// printer sees on the line.
+func textNoBodies(n node) string {
+	w := &writer{noBodies: true}
+	n.render(w)
+	return w.sb.String()
+}
+
+// chain is a head and then operators with their operands: the and-or list,
+// the pipeline, a line's statements.
+type link[T node] struct {
+	op string
+	x  T
+}
+
+type chain[T node] struct {
+	head T
+	tail []link[T]
+}
+
+func (c chain[T]) render(w *writer) {
+	c.head.render(w)
+	for _, l := range c.tail {
+		w.str(l.op)
+		l.x.render(w)
+	}
+}
+
+// program: one to five lines.
+type program struct{ lines []line }
+
+func (p program) String() string {
+	w := &writer{}
+	for _, l := range p.lines {
+		l.render(w)
+	}
+	return w.sb.String()
+}
+
+// line: an optional comment line and blank line before it, and-or lists
+// separated by `; `, ` & ` or `;`, a heredoc redirect on the last command
+// (under HEGEL_NO_KNOWN=1 the only place for one on a line, see linesRaw),
+// an optional terminator, an optional trailing comment, the newline, and
+// then the bodies of its heredocs.
+type line struct {
+	blank   bool
+	lead    string // a comment line before ("" for none)
+	list    chain[andOr]
+	hdoc    *redirect
+	term    string // "", ";" or " &"
+	comment string // a trailing comment ("" for none)
+}
+
+func (l line) render(w *writer) {
+	if l.lead != "" {
+		w.str(l.lead)
+		w.nl()
+	}
+	if l.blank {
+		w.nl()
+	}
+	l.list.render(w)
+	if l.hdoc != nil {
+		w.str(" " + l.hdoc.text)
+		w.hdoc(l.hdoc.body)
+	}
+	w.str(l.term)
+	if l.comment != "" {
+		w.str(" " + l.comment)
+	}
+	w.nl()
+}
+
+// andOr: pipelines joined by ` && ` and ` || `.
+type andOr = chain[pipeline]
+
+// pipeline: commands joined by ` | ` (bash: also ` |& `), negated or not.
+type pipeline struct {
+	neg  bool
+	cmds chain[cmd]
+}
+
+func (p pipeline) render(w *writer) {
+	if p.neg {
+		w.str("! ")
+	}
+	p.cmds.render(w)
+}
+
+// word: one or two parts glued together; the kinds the known-bug fix-ups
+// look at are told by the part's first characters.
+type word = []string
+
+func wordText(w word) string { return strings.Join(w, "") }
+
+func isProcSubst(part string) bool {
+	return strings.HasPrefix(part, "<(") || strings.HasPrefix(part, ">(")
+}
+
+func isBackquoted(part string) bool { return strings.HasPrefix(part, "`") }
+
+// redirect: the operator with its target; a heredoc also carries its body.
+type redirect struct {
+	text string
+	body string
+}
+
+func renderRedirs(w *writer, rs []redirect) {
+	for _, r := range rs {
+		w.str(" " + r.text)
+		if r.body != "" {
+			w.hdoc(r.body)
+		}
+	}
+}
+
+// placed: a redirect and its position among the words of a simple command
+// (modulo their number, plus one).
+type placed struct {
+	r  redirect
+	at int
+}
+
+// simpleCmd: assignments, the command with its arguments (nil for an
+// assignment alone), redirects among the words and a heredoc at the end.
+type simpleCmd struct {
+	assigns []string
+	call    []word
+	redirs  []placed
+	hdoc    *redirect
+}
+
+func (s simpleCmd) render(w *writer) {
+	toks := append([]string{}, s.assigns...)
+	for _, wd := range s.call {
+		toks = append(toks, wordText(wd))
+	}
+	for _, p := range s.redirs {
+		at := len(toks) // bash: `x=a >f y=(a)` is a syntax error, so an assignment-only command keeps its redirects last
+		if s.call != nil {
+			at = p.at % (len(toks) + 1)
+		}
+		toks = slices.Insert(toks, at, p.r.text)
+	}
+	if s.hdoc != nil {
+		toks = append(toks, s.hdoc.text)
+	}
+	w.str(strings.Join(toks, " "))
+	if s.hdoc != nil {
+		w.hdoc(s.hdoc.body)
+	}
+}
+
+// body: what stands between a compound command's opening and closing
+// words: a list on the same line (` a; b; `) or lines of its own.
+type body struct {
+	inl   *chain[andOr]
+	lines []line
+}
+
+func (b body) render(w *writer) {
+	if b.inl != nil {
+		w.str(" ")
+		b.inl.render(w)
+		w.str("; ")
+		return
+	}
+	w.nl()
+	for _, l := range b.lines {
+		l.render(w)
+	}
+}
+
+// cond: the condition of if/while/until, ended by `; ` or a newline.
+type cond struct {
+	list chain[andOr]
+	nl   bool
+}
+
+func (c cond) render(w *writer) {
+	c.list.render(w)
+	if c.nl {
+		w.nl()
+	} else {
+		w.str("; ")
+	}
+}
+
+type blockCmd struct {
+	open, close string
+	body        body
+	redirs      []redirect
+}
+
+func (b blockCmd) render(w *writer) {
+	w.str(b.open)
+	b.body.render(w)
+	w.str(b.close)
+	renderRedirs(w, b.redirs)
+}
+
+type arm struct {
+	c cond
+	b body
+}
+
+type ifCmd struct {
+	arms   []arm // the if and then the elifs
+	els    *body
+	redirs []redirect
+}
+
+func (c ifCmd) render(w *writer) {
+	for i, a := range c.arms {
+		if i == 0 {
+			w.str("if ")
+		} else {
+			w.str("elif ")
+		}
+		a.c.render(w)
+		w.str("then")
+		a.b.render(w)
+	}
+	if c.els != nil {
+		w.str("else")
+		c.els.render(w)
+	}
+	w.str("fi")
+	renderRedirs(w, c.redirs)
+}
+
+type loopCmd struct {
+	kw     string // while or until
+	c      cond
+	b      body
+	redirs []redirect
+}
+
+func (l loopCmd) render(w *writer) {
+	w.str(l.kw + " ")
+	l.c.render(w)
+	w.str("do")
+	l.b.render(w)
+	w.str("done")
+	renderRedirs(w, l.redirs)
+}
+
+type forCmd struct {
+	head   string // `for x in a b`, `for x`, `for ((...))`
+	nl     bool   // a newline instead of `; ` before do
+	b      body
+	redirs []redirect
+}
+
+func (f forCmd) render(w *writer) {
+	w.str(f.head)
+	if f.nl {
+		if len(w.pending) > 0 {
+			w.bodyAfterForHead = true
+		}
+		w.nl()
+	} else {
+		w.str("; ")
+	}
+	w.str("do")
+	f.b.render(w)
+	w.str("done")
+	renderRedirs(w, f.redirs)
+}
+
+type caseItem struct {
+	pats  string // `a|b`
+	paren bool   // `(a|b)`
+	term  string // `;;`, `;&`, `;;&`
+	b     body   // lines (possibly none) or an inline list
+}
+
+type caseCmd struct {
+	word   string
+	multi  bool
+	items  []caseItem
+	open   bool // the last item has no terminator
+	redirs []redirect
+}
+
+func (c caseCmd) render(w *writer) {
+	w.str("case " + c.word + " in")
+	if c.multi {
+		w.nl()
+	} else {
+		w.str(" ")
+	}
+	for i, it := range c.items {
+		last := i == len(c.items)-1
+		if it.paren {
+			w.str("(")
+		}
+		w.str(it.pats + ")")
+		if c.multi {
+			w.nl()
+			for _, l := range it.b.lines {
+				l.render(w)
+			}
+			if !(last && c.open) {
+				w.str(it.term)
+				w.nl()
+			}
+			continue
+		}
+		w.str(" ")
+		it.b.inl.render(w)
+		if last && c.open {
+			w.str("; ")
+		} else {
+			w.str(" " + it.term + " ")
+		}
+	}
+	w.str("esac")
+	renderRedirs(w, c.redirs)
+}
+
+// funcCmd: `name() body`, or in bash `function name body` and
+// `function name() body`.
+type funcCmd struct {
+	name string
+	kind int // 0: name() body; 1: function name body; 2: function name() body
+	b    blockCmd
+}
+
+func (f funcCmd) render(w *writer) {
+	switch f.kind {
+	case 1:
+		w.str("function " + f.name + " ")
+	case 2:
+		w.str("function " + f.name + "() ")
+	default:
+		w.str(f.name + "() ")
+	}
+	f.b.render(w)
+}
+
+// rawCmd: a command rendered when drawn (`[[ ]]`, `(( ))`, declare, let, a
+// fixed command after `time`): text without heredocs or newlines.
+type rawCmd struct{ text string }
+
+func (r rawCmd) render(w *writer) { w.str(r.text) }
+
+// timeCmd: `time [-p] pipeline`.
+type timeCmd struct {
+	flag string
+	p    pipeline
+}
+
+func (t timeCmd) render(w *writer) {
+	w.str("time " + t.flag)
+	t.p.render(w)
+}
+
+// coprocCmd: `coproc cmd` or `coproc NAME { ... }`.
+type coprocCmd struct {
+	name  string
+	inner cmd
+}
+
+func (c coprocCmd) render(w *writer) {
+	w.str("coproc ")
+	if c.name != "" {
+		w.str(c.name + " ")
+	}
+	c.inner.render(w)
+}
+
+// trueCmd and trueList are what a budget-spent command and a fixed-up
+// condition become.
+var (
+	trueCmd  cmd = simpleCmd{call: []word{{"true"}}}
+	trueList     = chain[andOr]{head: andOr{head: pipeline{cmds: chain[cmd]{head: trueCmd}}}}
+)
+
+// isLet reports whether a command is a `let` clause.
+func isLet(c cmd) bool {
+	r, ok := c.(rawCmd)
+	return ok && strings.HasPrefix(r.text, "let ")
+}
+
+// lastCmd is the last command of a list.
+func lastCmd(l chain[andOr]) cmd {
+	ao := l.head
+	if n := len(l.tail); n > 0 {
+		ao = l.tail[n-1].x
+	}
+	p := ao.head
+	if n := len(ao.tail); n > 0 {
+		p = ao.tail[n-1].x
+	}
+	c := p.cmds.head
+	if n := len(p.cmds.tail); n > 0 {
+		c = p.cmds.tail[n-1].x
+	}
+	return c
+}
+
+// takesRedirects reports whether a redirect may follow the command: bash
+// rejects one after `[[ ]]` and `(( ))`.
+func takesRedirects(c cmd) bool {
+	r, ok := c.(rawCmd)
+	return !ok || !(strings.HasPrefix(r.text, "[[") || strings.HasPrefix(r.text, "(("))
+}
+
+// ---------------------------------------------------------------------------
+// Pools.
+
+var (
+	varNames     = pick("x", "y", "_z", "ab1", "v2")
+	litPool      = []string{"a", "b", "foo", "x1", "-n", "--", "1", "0", "./f", "/tmp/x", "a=b", "*.sh", `a\ b`, `\$x`, "a,b", "~/x", "%", "a:b", "[x]", "a{b,c}", "{1..3}", "-", "+"}
+	lits         = pick(litPool...)
+	sqPool       = []string{"", "a b", "$x", `it"s`, "a\nb", "*", `\`, "#"}
+	dqPool       = []string{"a", "b c", "x-y", `\"`, `\\`, `\$`, "\\`", "!", "#", "'", "~", "$", "*", "a\nb", " "}
+	innerPool    = []string{"a", "*", "?.sh", "[ab]*", `\*`, "$y", "a b", ""}
+	testWordPool = []string{"a", "b", "1", "0", "a*", "x-y", "$x", "./f", "n"}
+	cmdNames     = []string{"echo", "cat", "foo", "printf", ":", "true", "test", "cmd_x", "./run", "$x", `"$y"`, "exit", "return", "break"}
+	keywords     = []string{"if", "done", "in", "esac", "fi", "then", "function", "select"}
+	hdocLines    = []string{"body", "$x", "  a b", "\ttab", "'q'", "$(cmd)", "", `\$x`, "a `b`", "${x:-y}", "$((1+2))", `"dq"`}
+	hdocDelims   = []string{"EOF", "'EOF'", `"EOF"`, `E\OF`, "eof", "END_OF_TEXT"}
+	patterns     = pick("a", "*", "?x", "[ab]", "a*", `"q"`, "'s p'", "$x", "*.sh", "[!a-z]", `\*`, "${y}", "a$(b)")
+	commentTexts = []string{"c", "note", "TODO x", "a b", "$x 'q'", "#!"}
+	numPool      = pick("0", "1", "42", "0x1f", "010", "7")
+	arithBinOps  = []string{"+", "-", "*", "/", "%", "<<", ">>", "&", "|", "^", "&&", "||", "==", "!=", "<", ">", "<=", ">="}
+	arithAsgOps  = pick("=", "+=", "-=", "*=", "/=", "%=", "<<=", ">>=", "&=", "|=", "^=")
+	posixRedirs  = pick(">", ">>", "<", "2>", ">&2", "2>&1", ">|", "<>", "<&-", ">&-", "1>&2", "<&0")
+	bashRedirs   = pick("&>", "&>>", "<<<", "{fd}>", "{fd}<", "{fd}>&-", "2>&1", ">&2")
+	hdocReplacer = strings.NewReplacer("'", "", `"`, "", `\`, "")
+)
+
+// comments: `#` alone or `# ` and a text; a text ending in a backslash is the
+// shape of sh/6, left out under HEGEL_NO_KNOWN=1.
+var comments = weighted(
+	choice[string]{weight: 15, gen: lit("#")},
+	choice[string]{weight: 85, gen: wrap("# ", pick(shaped(append(slices.Clone(commentTexts), `a\`), commentTexts)...), "")},
+)
+
+// hasFdTarget reports whether a redirect operator names its target itself.
+func hasFdTarget(op string) bool {
+	return strings.HasSuffix(op, "&2") || strings.HasSuffix(op, "&1") || strings.HasSuffix(op, "&0") || strings.HasSuffix(op, "&-")
+}
+
+// ---------------------------------------------------------------------------
+// The grammar: generator values built once per dialect. The counters in the
+// closure track the live nesting (hegel-go's ExampleComposite_recursive),
+// restored by defer so an aborted draw cannot leave them stale: depth counts
+// the compound bodies and substitutions (simple commands only from three
+// deep, literal word parts from five), budget the commands of one program
+// (forty, then `true`).
+
+// The nesting caps: compound commands (and substitutions) while the depth
+// is below maxCompoundDepth, word parts other than literals while it is
+// below maxPartDepth. Together with the spans per level they keep a case
+// under the engine's nesting cap.
+var (
+	maxCompoundDepth = 3
+	maxPartDepth     = 4
+)
+
+type grammar struct {
+	bash     bool
+	lang     syntax.LangVariant
+	programs hegel.Generator[program]
+	words    hegel.Generator[string] // one word, for WordsSeq
+	ariths   hegel.Generator[string] // one arithmetic expression, for Arithmetic
+
+	// The pieces the narrow properties of hegel_shapes_test.go build the
+	// shapes of the recorded bugs from; budget sets the command budget of
+	// what is drawn next (the entry points above set their own) and lineOK
+	// is the line filter of programs.
+	budget        func(n int)
+	lineOK        func(line) bool
+	lines         hegel.Generator[line]         // a line of a program, filtered
+	lineLists     hegel.Generator[chain[andOr]] // the statements of a line
+	andOrs        hegel.Generator[andOr]        // an and-or list of a line: heredocs, bodies spanning lines
+	inlineLists   hegel.Generator[chain[andOr]] // a one-line list: no heredocs, no comments
+	inlineAndOrs  hegel.Generator[andOr]
+	inlineConds   hegel.Generator[cond]
+	inlineBodies  hegel.Generator[body]
+	inlineCmds    hegel.Generator[cmd] // a command of a one-line list
+	inlineSimples hegel.Generator[cmd] // a simple command without a heredoc
+	multiCmds     hegel.Generator[cmd] // a command on a line of its own
+	simples       hegel.Generator[cmd] // a simple command, sometimes with a heredoc
+	bodies        hegel.Generator[body]
+	multiBodies   hegel.Generator[body] // lines only
+	conds         hegel.Generator[cond]
+	wordTexts     hegel.Generator[string]
+	dqs           hegel.Generator[string]
+	cmdSubsts     hegel.Generator[string]
+	backquoted    hegel.Generator[string]
+	paramExps     hegel.Generator[string]
+	arithExps     hegel.Generator[string]
+	leaves        hegel.Generator[string]   // an arithmetic leaf
+	redirects     hegel.Generator[redirect] // no heredocs
+	heredocs      hegel.Generator[redirect]
+	trailing      hegel.Generator[[]redirect] // after a compound command, no heredocs
+	assigns       hegel.Generator[string]
+	calls         hegel.Generator[[]word]
+	inlineItems   hegel.Generator[caseItem]
+	multiItems    hegel.Generator[caseItem]
+	patLists      hegel.Generator[string]
+	caseTerms     hegel.Generator[string]
+	funcNames     hegel.Generator[string]
+	forHeads      hegel.Generator[string]
+	lets          hegel.Generator[string] // bash: a `let` clause
+	tests         hegel.Generator[string] // bash: a `[[ ]]` test
+}
+
+// ctx is the context a command is drawn in: on a line of its own (multi),
+// where bodies may span lines and heredocs and comments occur, or inline
+// (inside a substitution or a one-line body), where they do not. head and
+// tail are assigned after the commands are built and read when drawn.
+type ctx struct {
+	body     hegel.Generator[body]
+	cond     hegel.Generator[cond]
+	trailing hegel.Generator[[]redirect] // after a compound command
+	hdocOpt  hegel.Generator[*redirect]  // at the end of a simple command
+	multi    hegel.Generator[bool]       // a case clause spanning lines
+	head     hegel.Generator[cmd]        // the first command of a pipeline
+	tail     hegel.Generator[cmd]        // a command after `|`
+}
+
+func newGrammar(bash, noDqInExp, oneLine bool) *grammar {
+	g := &grammar{bash: bash, lang: langOf(bash)}
+	depth, budget := 0, 0
+	// The quoted texts; oneLine (the narrow properties, whose shapes are
+	// lines the printer keeps as lines) leaves out the ones holding a
+	// newline (and substitutions hold one and-or list, see substList, of
+	// literal words: the engine runs a failing property for a fixed time,
+	// so the words' nesting would only cost the shrinker draws).
+	sqTexts, dqTexts := sqPool, dqPool
+	partCap := maxPartDepth
+	if oneLine {
+		partCap = 1
+	}
+	if oneLine {
+		hasNewline := func(s string) bool { return strings.Contains(s, "\n") }
+		sqTexts = slices.DeleteFunc(slices.Clone(sqPool), hasNewline)
+		dqTexts = slices.DeleteFunc(slices.Clone(dqPool), hasNewline)
+	}
+	// Forward references of the grammar's cycles, read when drawn.
+	var (
+		inlineList        hegel.Generator[chain[andOr]]
+		substList         hegel.Generator[chain[andOr]] // the list inside `$( )` and `<( )`
+		inlineSimple      hegel.Generator[cmd]
+		lines             hegel.Generator[line]
+		dqs, cmdSubsts    hegel.Generator[string]
+		paramOut, paramIn hegel.Generator[string]
+	)
+
+	// ---- words -----------------------------------------------------------
+
+	// innerWords: the word inside a parameter expansion; inside double quotes
+	// (inDq) it has no double-quoted alternative under the sh/16 switch.
+	innerWords := func(param *hegel.Generator[string], inDq bool) hegel.Generator[string] {
+		alts := []choice[string]{
+			{weight: 1, gen: lits},
+			{weight: 1, gen: pick(innerPool...)},
+			later(1, param),
+			later(1, &cmdSubsts),
+		}
+		if !(noDqInExp && inDq) {
+			alts = append(alts, later(1, &dqs))
+		}
+		return weighted(alts...)
+	}
+	paramOut = g.params(innerWords(&paramOut, false))
+	paramIn = g.params(innerWords(&paramIn, true))
+
+	ariths := g.arithmetic()
+	arithExps := wrap("$((", ariths, "))")
+
+	// dqs: a double-quoted word of up to three pieces; under the sh/15 switch
+	// a backquoted substitution after a piece ending in `$` becomes `a`.
+	dqPieces := weighted(
+		choice[string]{weight: 40, gen: pick(dqTexts...)},
+		later(30, &paramIn),
+		later(20, &cmdSubsts),
+		choice[string]{weight: 10, gen: arithExps},
+	)
+	dqs = hegel.Composite(func(tc hegel.TestCase) string {
+		ps := hegel.Draw(tc, many(dqPieces, 0, 3))
+		for i := 1; i < len(ps) && Known.dollarBackquote; i++ {
+			if strings.HasSuffix(ps[i-1], "$") && isBackquoted(ps[i]) {
+				ps[i] = "a"
+			}
+		}
+		return `"` + strings.Join(ps, "") + `"`
+	})
+
+	// cmdSubsts: `$( )` around an inline list (padded with spaces when the
+	// list starts with a subshell, or `$((` would be arithmetic), backquotes
+	// around a simple command (whose backslashes and backquotes would be
+	// interpreted again, so such a command is `echo a`), or in bash `$(<f)`.
+	dollarSubsts := hegel.Composite(func(tc hegel.TestCase) string {
+		s := text(hegel.Draw(tc, substList))
+		if Known.substSubshell {
+			// sh/26: `$( (a; b) )` and `$(a | (b; c))` close differently on
+			// every pass; a `;`-separated list is printed on its own lines.
+			if strings.HasPrefix(s, "(") || strings.HasPrefix(s, "! (") {
+				s = "true; " + s
+			}
+			if strings.HasSuffix(s, ")") {
+				s += "; true"
+			}
+		}
+		if strings.HasPrefix(s, "(") {
+			s = " " + s + " "
+		}
+		return "$(" + s + ")"
+	})
+	backquoted := hegel.Composite(func(tc hegel.TestCase) string {
+		inner := text(hegel.Draw(tc, inlineSimple))
+		if strings.ContainsAny(inner, "\\`") {
+			inner = "echo a"
+		}
+		return "`" + inner + "`"
+	})
+	substChoices := []choice[string]{{weight: 67, gen: dollarSubsts}, {weight: 25, gen: backquoted}}
+	if bash {
+		substChoices = append(substChoices, choice[string]{weight: 8, gen: wrap("$(<", pick("file", "$f", "./x"), ")")})
+	}
+	cmdSubsts = weighted(substChoices...)
+
+	// parts: a literal most of the time, then quotes, expansions, a
+	// substitution, arithmetic; in bash also `$'..'`, `$".."` and a process
+	// substitution. Five levels deep only literals.
+	partChoices := []choice[string]{
+		{weight: 35, gen: lits},
+		{weight: 10, gen: wrap("'", pick(sqTexts...), "'")},
+		{weight: 15, gen: dqs},
+		{weight: 18, gen: paramOut},
+		{weight: 10, gen: cmdSubsts},
+		{weight: 6, gen: arithExps},
+	}
+	if bash {
+		procSubsts := hegel.Composite(func(tc hegel.TestCase) string {
+			return hegel.Draw(tc, pick("<(", ">(")) + text(hegel.Draw(tc, substList)) + ")"
+		})
+		partChoices = append(partChoices, choice[string]{weight: 6, gen: weighted(
+			choice[string]{weight: 1, gen: wrap("$'", pick(`a\tb`, `\n`, `it\'s`, `\x41`, `\u00e9`, `\\`, "a b", ""), "'")},
+			choice[string]{weight: 1, gen: wrap(`$"`, pick("hello", "a $x", ""), `"`)},
+			choice[string]{weight: 2, gen: procSubsts},
+		)})
+	} else {
+		partChoices = append(partChoices, choice[string]{weight: 6, gen: lits})
+	}
+	parts := weightedOr(func() hegel.Generator[string] {
+		if depth >= partCap {
+			return lits
+		}
+		return nil
+	}, partChoices...)
+
+	// words: one part, or two glued together. Under the sh/9 switch a
+	// process substitution glued to another part becomes `a`, under sh/15 a
+	// backquoted substitution after a part ending in `$` too.
+	wordsRaw := many(parts, 1, 2)
+	words := shaped(wordsRaw, hegel.Map(wordsRaw, func(w word) word {
+		for i := range w {
+			if len(w) > 1 && isProcSubst(w[i]) {
+				w[i] = "a"
+			}
+			if i > 0 && isBackquoted(w[i]) && strings.HasSuffix(w[i-1], "$") {
+				w[i] = "a"
+			}
+		}
+		return w
+	}))
+	wordTexts := hegel.Map(words, wordText)
+	wordLists := func(lo, hi int) hegel.Generator[string] { return joined(wordTexts, lo, hi, " ") }
+
+	// ---- redirects -------------------------------------------------------
+
+	redirOps := posixRedirs
+	if bash {
+		redirOps = weighted(choice[string]{weight: 75, gen: posixRedirs}, choice[string]{weight: 25, gen: bashRedirs})
+	}
+	redirects := hegel.Composite(func(tc hegel.TestCase) redirect {
+		op := hegel.Draw(tc, redirOps)
+		if hasFdTarget(op) {
+			return redirect{text: op}
+		}
+		w := hegel.Draw(tc, wordTexts)
+		if op == "&>>" && assignWord.MatchString(w) {
+			// bash 5.2 rejects `>a &>>x=b echo` (a leading redirect, then
+			// `&>>` with an assignment-like target; `&>` and `&>>xb` are
+			// fine); the parser accepts it. Not a bug of the parser.
+			op = "&>"
+		}
+		sep := " "
+		if !strings.HasPrefix(w, "<") && !strings.HasPrefix(w, ">") && !strings.HasPrefix(w, "(") {
+			sep = hegel.Draw(tc, pick("", " "))
+		}
+		return redirect{text: op + sep + w}
+	})
+	hdocLine := pairs(chance(40), pick(hdocLines...)) // a tab before the line (for <<-), the line
+	heredocs := hegel.Composite(func(tc hegel.TestCase) redirect {
+		op := hegel.Draw(tc, pick("<<", "<<-"))
+		delim := hegel.Draw(tc, pick(hdocDelims...))
+		ls := hegel.Draw(tc, many(hdocLine, 0, 3))
+		tabEnd := hegel.Draw(tc, chance(30))
+		sep := hegel.Draw(tc, pick("", " "))
+		var body strings.Builder
+		for _, l := range ls {
+			if op == "<<-" && l.a {
+				body.WriteString("\t")
+			}
+			body.WriteString(l.b + "\n")
+		}
+		if op == "<<-" && tabEnd {
+			body.WriteString("\t")
+		}
+		body.WriteString(hdocReplacer.Replace(delim) + "\n")
+		return redirect{text: op + sep + delim, body: body.String()}
+	})
+	placedRedirs := hegel.Composite(func(tc hegel.TestCase) placed {
+		return placed{hegel.Draw(tc, redirects), hegel.Draw(tc, positions)}
+	})
+	plainTrailing := many(redirects, 0, 2)
+	hdocTrailing := hegel.Composite(func(tc hegel.TestCase) []redirect {
+		rs := hegel.Draw(tc, plainTrailing)
+		if h := hegel.Draw(tc, optional(12, heredocs)); h != nil {
+			rs = append(rs, *h)
+		}
+		return rs
+	})
+	// Heredocs occur in the multi context: at the end of a simple command
+	// and after a compound command, anywhere on the line. Under the switches
+	// of sh/5, sh/7 and sh/8 they occur only on the last command of a line
+	// (lineHdocs, drawn by linesRaw), where nothing can follow them.
+	noHdoc := hegel.Just[*redirect](nil)
+	simpleHdocs, lineHdocs := optional(12, heredocs), noHdoc
+	if Known.hdocBeforeSubst || Known.hdocComment || Known.hdocBeforeTest {
+		simpleHdocs, lineHdocs = noHdoc, optional(20, heredocs)
+		hdocTrailing = plainTrailing
+	}
+
+	// ---- assignments and simple commands ---------------------------------
+
+	// values: the value of an assignment; under the sh/9 switch a process
+	// substitution at its start becomes `a`.
+	values := shaped(wordTexts, hegel.Map(words, func(w word) string {
+		if isProcSubst(w[0]) {
+			w[0] = "a"
+		}
+		return wordText(w)
+	}))
+	assignsOf := func(arrays bool) hegel.Generator[string] {
+		alts := []choice[string]{
+			{weight: 15, gen: cat(varNames, lit("="))},
+			{weight: 85, gen: cat(varNames, lit("="), values)},
+		}
+		if bash {
+			alts[0].weight, alts[1].weight = 15*85/100, 85*85/100
+			alts = append(alts, choice[string]{weight: 15, gen: cat(varNames, lit("+="), values)})
+			if arrays {
+				for i := range alts {
+					alts[i].weight = alts[i].weight * 65 / 100
+				}
+				alts = append(alts,
+					choice[string]{weight: 15, gen: cat(varNames, lit("["), pick("1", "$i", "i+1", "a", "0"), lit("]="), values)},
+					choice[string]{weight: 15, gen: cat(varNames, lit("=("), hegel.Map(wordLists(0, 3), func(s string) string {
+						if strings.HasPrefix(s, "[") || strings.Contains(s, " [") {
+							return "a b" // `x=([x])` is rejected deliberately (`[x]` must be followed by `=`)
+						}
+						return s
+					}), lit(")"))},
+					choice[string]{weight: 5, gen: cat(varNames, lit("=([a]=1 [b]="), wordTexts, lit(")"))},
+				)
+			}
+		}
+		return weighted(alts...)
+	}
+	assignsPlain, assignsArrays := assignsOf(false), assignsOf(true)
+
+	// calls: a command name and up to three arguments (one time in twenty a
+	// keyword used as a word), or a `[ ]` test.
+	plainCalls := hegel.Composite(func(tc hegel.TestCase) []word {
+		call := []word{{hegel.Draw(tc, pick(cmdNames...))}}
+		call = append(call, hegel.Draw(tc, many(words, 0, 3))...)
+		if kw := hegel.Draw(tc, maybe(5, pick(keywords...))); kw != "" {
+			call = append(call, word{kw})
+		}
+		return call
+	})
+	bracketCalls := hegel.Composite(func(tc hegel.TestCase) []word {
+		return []word{{"["}, hegel.Draw(tc, words), {hegel.Draw(tc, pick("=", "!=", "-eq", "-lt"))}, hegel.Draw(tc, words), {"]"}}
+	})
+	calls := weighted(choice[[]word]{weight: 92, gen: plainCalls}, choice[[]word]{weight: 8, gen: bracketCalls})
+
+	// simples: a named command (85%) with up to two plain assignments before
+	// it, or assignments alone (arrays allowed); up to two redirects among
+	// the words, and in the multi context a heredoc at the end.
+	simples := func(hdocOpt hegel.Generator[*redirect]) hegel.Generator[cmd] {
+		return hegel.Composite(func(tc hegel.TestCase) cmd {
+			named := hegel.Draw(tc, chance(85))
+			assigns := assignsArrays
+			if named {
+				assigns = assignsPlain
+			}
+			s := simpleCmd{assigns: hegel.Draw(tc, many(assigns, 0, 2))}
+			if named || len(s.assigns) == 0 {
+				s.call = hegel.Draw(tc, calls)
+			}
+			s.redirs = hegel.Draw(tc, many(placedRedirs, 0, 2))
+			s.hdoc = hegel.Draw(tc, hdocOpt)
+			return s
+		})
+	}
+	inlineSimple = simples(noHdoc)
+	multiSimple := simples(simpleHdocs)
+
+	// ---- statements ------------------------------------------------------
+
+	pipeOps := lit(" | ")
+	if bash {
+		pipeOps = weighted(choice[string]{weight: 80, gen: lit(" | ")}, choice[string]{weight: 20, gen: lit(" |& ")})
+	}
+	// pipelines: a head and up to two more commands after pipes; negated one
+	// time in ten (negs). Under the sh/1 switch a `|&` after a let clause is
+	// a `|`.
+	pipelines := func(c *ctx, negs hegel.Generator[bool]) hegel.Generator[pipeline] {
+		return hegel.Composite(func(tc hegel.TestCase) pipeline {
+			p := pipeline{neg: hegel.Draw(tc, negs), cmds: chain[cmd]{head: hegel.Draw(tc, c.head)}}
+			prev := p.cmds.head
+			for _, op := range hegel.Draw(tc, many(pipeOps, 0, 2)) {
+				if Known.letComment && op == " |& " && isLet(prev) {
+					op = " | "
+				}
+				prev = hegel.Draw(tc, c.tail)
+				p.cmds.tail = append(p.cmds.tail, link[cmd]{op, prev})
+			}
+			return p
+		})
+	}
+	// andOrs: pipelines joined by && and ||, up to three.
+	andOrs := func(p hegel.Generator[pipeline]) hegel.Generator[andOr] {
+		return hegel.Composite(func(tc hegel.TestCase) andOr {
+			a := andOr{head: hegel.Draw(tc, p)}
+			for _, op := range hegel.Draw(tc, many(pick(" && ", " || "), 0, 2)) {
+				a.tail = append(a.tail, link[pipeline]{op, hegel.Draw(tc, p)})
+			}
+			return a
+		})
+	}
+	// lists: and-or lists joined by the separators, up to three; nest counts
+	// the list as a nesting level (a substitution or an inline body).
+	lists := func(ao hegel.Generator[andOr], seps hegel.Generator[string], nest bool) hegel.Generator[chain[andOr]] {
+		return hegel.Composite(func(tc hegel.TestCase) chain[andOr] {
+			if nest {
+				depth++
+				defer func() { depth-- }()
+			}
+			l := chain[andOr]{head: hegel.Draw(tc, ao)}
+			for _, op := range hegel.Draw(tc, many(seps, 0, 2)) {
+				x := hegel.Draw(tc, ao)
+				if op == ";" && strings.HasPrefix(text(x), "&") {
+					op = "; " // `;&>a` would be the case terminator `;&`
+				}
+				l.tail = append(l.tail, link[andOr]{op, x})
+			}
+			return l
+		})
+	}
+	// conds: under the sh/22 switch a condition holding a case clause in a
+	// substitution is `true`; under the sh/17 switch so is one ending in a
+	// redirected compound command whose body ends in `&`.
+	conds := func(list hegel.Generator[chain[andOr]], nls hegel.Generator[bool]) hegel.Generator[cond] {
+		return hegel.Composite(func(tc hegel.TestCase) cond {
+			c := cond{list: hegel.Draw(tc, list), nl: hegel.Draw(tc, nls)}
+			t := text(c.list)
+			if Known.esacRedirectClose && caseInSubst.MatchString(t) {
+				c.list = trueList
+			}
+			if Known.thenAfterRedirect && bgCloseRedirected(t) {
+				c.list = trueList
+			}
+			return c
+		})
+	}
+
+	inline := &ctx{trailing: plainTrailing, hdocOpt: noHdoc, multi: hegel.Just(false)}
+	multi := &ctx{trailing: hdocTrailing, hdocOpt: simpleHdocs, multi: chance(70)}
+
+	inlineAndOrs := andOrs(pipelines(inline, chance(10)))
+	inlineList = lists(inlineAndOrs, lit("; "), true)
+	// The list inside a substitution: an inline list; under oneLine one
+	// and-or list of simple commands, which the printer keeps on the line.
+	substList = inlineList
+	if oneLine {
+		flat := &ctx{head: inlineSimple, tail: inlineSimple}
+		flatAndOrs := andOrs(pipelines(flat, chance(10)))
+		substList = hegel.Composite(func(tc hegel.TestCase) chain[andOr] {
+			depth++
+			defer func() { depth-- }()
+			return chain[andOr]{head: hegel.Draw(tc, flatAndOrs)}
+		})
+	}
+	inlineBodies := hegel.Map(inlineList, func(c chain[andOr]) body { return body{inl: &c} })
+	inline.body = inlineBodies
+	inline.cond = conds(inlineList, hegel.Just(false))
+
+	multiAndOrs := andOrs(pipelines(multi, chance(10)))
+	// multiLinesOf: one to three lines (none too, when the item may be
+	// empty) of a body of its own, one nesting level down.
+	multiLinesOf := func(emptyPct int) hegel.Generator[body] {
+		return hegel.Composite(func(tc hegel.TestCase) body {
+			depth++
+			defer func() { depth-- }()
+			return body{lines: hegel.Draw(tc, maybe(100-emptyPct, many(lines, 1, 3)))}
+		})
+	}
+	multiBodies := multiLinesOf(0)
+	multi.body = weighted(choice[body]{weight: 30, gen: inlineBodies}, choice[body]{weight: 70, gen: multiBodies})
+	multi.cond = conds(hegel.Map(multiAndOrs, func(a andOr) chain[andOr] { return chain[andOr]{head: a} }), chance(30))
+
+	// ---- commands ---------------------------------------------------------
+
+	blocks := func(c *ctx, open, close string) hegel.Generator[cmd] {
+		return hegel.Composite(func(tc hegel.TestCase) cmd {
+			return blockCmd{open: open, close: close, body: hegel.Draw(tc, c.body), redirs: hegel.Draw(tc, c.trailing)}
+		})
+	}
+	ifs := func(c *ctx) hegel.Generator[cmd] {
+		arms := hegel.Composite(func(tc hegel.TestCase) arm { return arm{hegel.Draw(tc, c.cond), hegel.Draw(tc, c.body)} })
+		return hegel.Composite(func(tc hegel.TestCase) cmd {
+			return ifCmd{arms: hegel.Draw(tc, many(arms, 1, 3)), els: hegel.Draw(tc, optional(40, c.body)), redirs: hegel.Draw(tc, c.trailing)}
+		})
+	}
+	loops := func(c *ctx) hegel.Generator[cmd] {
+		return hegel.Composite(func(tc hegel.TestCase) cmd {
+			return loopCmd{kw: hegel.Draw(tc, pick("while", "until")), c: hegel.Draw(tc, c.cond), b: hegel.Draw(tc, c.body), redirs: hegel.Draw(tc, c.trailing)}
+		})
+	}
+	forHeads := []choice[string]{
+		{weight: 15, gen: cat(lit("for "), varNames)},
+		{weight: 15, gen: cat(lit("for "), varNames, lit(" in"))},
+		{weight: 50, gen: cat(lit("for "), varNames, lit(" in "), wordLists(1, 3))},
+	}
+	if bash {
+		forHeads = append(forHeads, choice[string]{weight: 20, gen: cat(lit("for (("), maybe(50, g.arithAssigns(ariths)), lit("; "), maybe(50, ariths), lit("; "), maybe(50, ariths), lit("))"))})
+	}
+	forHead := weighted(forHeads...)
+	fors := func(c *ctx, nls hegel.Generator[bool]) hegel.Generator[cmd] {
+		return hegel.Composite(func(tc hegel.TestCase) cmd {
+			return forCmd{head: hegel.Draw(tc, forHead), nl: hegel.Draw(tc, nls), b: hegel.Draw(tc, c.body), redirs: hegel.Draw(tc, c.trailing)}
+		})
+	}
+	caseTerms := lit(";;")
+	if bash {
+		caseTerms = weighted(choice[string]{weight: 70, gen: lit(";;")}, choice[string]{weight: 30, gen: pick(";&", ";;&")})
+	}
+	patLists := hegel.Composite(func(tc hegel.TestCase) string {
+		s := hegel.Draw(tc, patterns)
+		for _, bar := range hegel.Draw(tc, many(pick("|", " | "), 0, 2)) {
+			s += bar + hegel.Draw(tc, patterns)
+		}
+		return s
+	})
+	caseItems := func(bodies hegel.Generator[body]) hegel.Generator[caseItem] {
+		return hegel.Composite(func(tc hegel.TestCase) caseItem {
+			return caseItem{pats: hegel.Draw(tc, patLists), paren: hegel.Draw(tc, chance(20)), term: hegel.Draw(tc, caseTerms), b: hegel.Draw(tc, bodies)}
+		})
+	}
+	inlineItems := caseItems(inlineBodies)
+	multiItems := caseItems(multiLinesOf(20))
+	cases := func(c *ctx) hegel.Generator[cmd] {
+		// sh/22: under the switch a case clause carries no redirects.
+		redirs := shaped(c.trailing, hegel.Just[[]redirect](nil))
+		return hegel.Composite(func(tc hegel.TestCase) cmd {
+			multi := hegel.Draw(tc, c.multi)
+			items := inlineItems
+			if multi {
+				items = multiItems
+			}
+			return caseCmd{word: hegel.Draw(tc, wordTexts), multi: multi, items: hegel.Draw(tc, many(items, 0, 3)), open: hegel.Draw(tc, chance(30)), redirs: hegel.Draw(tc, redirs)}
+		})
+	}
+	funcNames := pick("f", "g1", "_h", "my_func")
+	if bash {
+		funcNames = weighted(choice[string]{weight: 90, gen: funcNames}, choice[string]{weight: 10, gen: lit("foo-bar")})
+	}
+	funcKinds := hegel.Just(0)
+	if bash {
+		funcKinds = weighted(choice[int]{weight: 60, gen: hegel.Just(0)}, choice[int]{weight: 20, gen: hegel.Just(1)}, choice[int]{weight: 20, gen: hegel.Just(2)})
+	}
+	funcs := func(c *ctx) hegel.Generator[cmd] {
+		return hegel.Composite(func(tc hegel.TestCase) cmd {
+			f := funcCmd{name: hegel.Draw(tc, funcNames), kind: hegel.Draw(tc, funcKinds), b: blockCmd{open: "{", close: "}"}}
+			if hegel.Draw(tc, chance(20)) {
+				f.b.open, f.b.close = "(", ")"
+			}
+			if Known.functionSubshell && f.kind == 1 && f.b.open == "(" {
+				f.kind = 2 // sh/14: `function f ( ... )` is rejected
+			}
+			f.b.body = hegel.Draw(tc, c.body)
+			return f
+		})
+	}
+
+	// bash-only commands
+	testCmds := wrap("[[ ", g.testExprs(dqs, paramOut, cmdSubsts), " ]]")
+	arithCmds := wrap("((", ariths, "))")
+	declCmds := g.declClauses(wordTexts, dqs, assignsArrays)
+	letCmds := cat(lit("let "), joined(weighted(
+		choice[string]{weight: 1, gen: pick(`"x = 1"`, "x=1", "y++", "x+=2", "'a & b'")},
+		choice[string]{weight: 1, gen: wrap(`"z = `, g.arithLeaves(), `"`)},
+	), 1, 3, " "))
+	raw := func(g hegel.Generator[string]) hegel.Generator[cmd] {
+		return hegel.Map(g, func(s string) cmd { return rawCmd{s} })
+	}
+	timeFlags := maybe(50, lit("-p "))
+	// timeCmds: `time` before a pipeline (whose commands are not negated
+	// under the sh/2 switch); after a pipe bash reads `time` as a plain word,
+	// so there it takes a fixed command (`a | time (b)` is a syntax error).
+	timeCmds := func(c *ctx, afterPipe bool) hegel.Generator[cmd] {
+		if afterPipe {
+			return raw(cat(lit("time "), timeFlags, pick("true", "echo a", "cat file")))
+		}
+		inner := pipelines(c, shaped(chance(10), hegel.Just(false)))
+		return hegel.Composite(func(tc hegel.TestCase) cmd {
+			return timeCmd{flag: hegel.Draw(tc, timeFlags), p: hegel.Draw(tc, inner)}
+		})
+	}
+	// coprocs: `coproc cmd` (under the sh/10 switch `echo a` when the command
+	// has an assignment word) or `coproc NAME { ... }`.
+	coprocs := func(c *ctx, simple hegel.Generator[cmd]) hegel.Generator[cmd] {
+		named := hegel.Composite(func(tc hegel.TestCase) cmd {
+			return coprocCmd{name: hegel.Draw(tc, pick("co", "NAME")), inner: hegel.Draw(tc, blocks(c, "{", "}"))}
+		})
+		plain := hegel.Map(simple, func(inner cmd) cmd {
+			if Known.coprocStmtPos {
+				s := inner.(simpleCmd)
+				fixed := len(s.assigns) > 0
+				for _, w := range s.call {
+					fixed = fixed || assignWord.MatchString(wordText(w))
+				}
+				if fixed {
+					return coprocCmd{inner: simpleCmd{call: []word{{"echo"}, {"a"}}}}
+				}
+			}
+			return coprocCmd{inner: inner}
+		})
+		return weighted(choice[cmd]{weight: 50, gen: plain}, choice[cmd]{weight: 50, gen: named})
+	}
+
+	// commands: a simple command more than half of the time, then the
+	// compounds, then bash's own; `true` once the budget is spent, a simple
+	// command from three levels deep.
+	commands := func(c *ctx, simple hegel.Generator[cmd], nls hegel.Generator[bool], afterPipe bool) hegel.Generator[cmd] {
+		choices := []choice[cmd]{
+			{weight: 122, gen: simple},
+			{weight: 12, gen: blocks(c, "(", ")")},
+			{weight: 12, gen: blocks(c, "{", "}")},
+			{weight: 14, gen: ifs(c)},
+			{weight: 10, gen: loops(c)},
+			{weight: 10, gen: fors(c, nls)},
+			{weight: 10, gen: cases(c)},
+			{weight: 10, gen: funcs(c)},
+		}
+		if bash {
+			choices = append(choices, choice[cmd]{weight: 22, gen: weighted(
+				choice[cmd]{weight: 1, gen: raw(testCmds)},
+				choice[cmd]{weight: 1, gen: raw(arithCmds)},
+				choice[cmd]{weight: 1, gen: raw(declCmds)},
+				choice[cmd]{weight: 1, gen: timeCmds(c, afterPipe)},
+				choice[cmd]{weight: 1, gen: coprocs(c, simple)},
+				choice[cmd]{weight: 1, gen: raw(letCmds)},
+			)})
+		} else {
+			choices = append(choices, choice[cmd]{weight: 22, gen: simple})
+		}
+		trueCmds := hegel.Just(trueCmd)
+		return weightedOr(func() hegel.Generator[cmd] {
+			budget--
+			switch {
+			case budget <= 0:
+				return trueCmds
+			case depth >= maxCompoundDepth:
+				return simple
+			}
+			return nil
+		}, choices...)
+	}
+	inline.head = commands(inline, inlineSimple, hegel.Just(false), false)
+	inline.tail = commands(inline, inlineSimple, hegel.Just(false), true)
+	multi.head = commands(multi, multiSimple, chance(30), false)
+	multi.tail = commands(multi, multiSimple, chance(30), true)
+
+	// ---- lines and programs ------------------------------------------------
+
+	lineLists := lists(multiAndOrs, pick("; ", " & ", ";"), false)
+	// Under the switches: no trailing comment after a let clause (sh/1) or
+	// on a heredoc line with `|`, `&` or `;` (sh/7); and (the filter) no
+	// line whose text has a shape the printer mangles (sh/5, sh/8, sh/17,
+	// sh/23, sh/26).
+	linesRaw := hegel.Composite(func(tc hegel.TestCase) line {
+		l := line{
+			blank:   hegel.Draw(tc, chance(10)),
+			lead:    hegel.Draw(tc, maybe(5, comments)),
+			list:    hegel.Draw(tc, lineLists),
+			hdoc:    hegel.Draw(tc, lineHdocs),
+			term:    hegel.Draw(tc, maybe(20, pick(";", " &"))),
+			comment: hegel.Draw(tc, maybe(6, comments)),
+		}
+		if !takesRedirects(lastCmd(l.list)) {
+			l.hdoc = nil
+		}
+		if t := textNoBodies(l); (Known.letComment && strings.Contains(t, "let ")) || (Known.hdocComment && heredocOp(t) >= 0 && strings.ContainsAny(t, "|&;")) {
+			l.comment = ""
+		}
+		return l
+	})
+	// The line filter. Always: in POSIX mode no heredoc body between a
+	// `for` head and its `do` (dash rejects it, bash and the parser accept
+	// it). Under the switches: no heredoc body right after a `(` that opens
+	// a subshell on the line, which bash and dash accept and the parser
+	// rejects (sh/27, see writer), and no line with a shape the printer
+	// mangles (sh/5, sh/8, sh/23).
+	lineOK := func(l line) bool {
+		w := &writer{noBodies: true}
+		l.render(w)
+		if Known.hdocAfterParen && w.bodyAfterParen {
+			return false
+		}
+		if !bash && w.bodyAfterForHead {
+			return false
+		}
+		for _, t := range strings.Split(w.sb.String(), "\n") {
+			if hdocPrinterShape(t) {
+				return false
+			}
+			if Known.redirReturn && redirReturn.MatchString(t) {
+				return false
+			}
+		}
+		return true
+	}
+	lines = hegel.Filter(linesRaw, lineOK)
+
+	// The entry points reset the budget.
+	g.programs = hegel.Composite(func(tc hegel.TestCase) program {
+		budget = 40
+		return program{hegel.Draw(tc, many(lines, 1, 5))}
+	})
+	g.words = hegel.Composite(func(tc hegel.TestCase) string {
+		budget = 40
+		return hegel.Draw(tc, wordTexts)
+	})
+	g.ariths = hegel.Composite(func(tc hegel.TestCase) string {
+		budget = 40
+		return hegel.Draw(tc, ariths)
+	})
+
+	// The pieces for the narrow properties.
+	g.budget = func(n int) { budget = n }
+	g.lineOK = lineOK
+	g.lines, g.lineLists, g.andOrs = lines, lineLists, multiAndOrs
+	g.inlineLists, g.inlineAndOrs, g.inlineConds, g.inlineBodies = inlineList, inlineAndOrs, inline.cond, inlineBodies
+	g.inlineCmds, g.inlineSimples, g.multiCmds, g.simples = inline.head, inlineSimple, multi.head, multiSimple
+	g.bodies, g.multiBodies, g.conds = multi.body, multiBodies, multi.cond
+	g.wordTexts, g.dqs, g.cmdSubsts, g.backquoted, g.paramExps = wordTexts, dqs, cmdSubsts, backquoted, paramOut
+	g.arithExps, g.leaves = arithExps, g.arithLeaves()
+	g.redirects, g.heredocs, g.trailing = redirects, heredocs, plainTrailing
+	g.assigns, g.calls = assignsPlain, calls
+	g.inlineItems, g.multiItems, g.patLists, g.caseTerms = inlineItems, multiItems, patLists, caseTerms
+	g.funcNames, g.forHeads, g.lets, g.tests = funcNames, forHead, letCmds, testCmds
+	return g
+}
+
+// params: a parameter expansion, its inner word from inner.
+func (g *grammar) params(inner hegel.Generator[string]) hegel.Generator[string] {
+	alts := []choice[string]{
+		{weight: 20, gen: cat(lit("$"), weighted(choice[string]{weight: 1, gen: varNames}, choice[string]{weight: 1, gen: pick("1", "@", "*", "#", "?", "$", "!", "-", "0")}))},
+		{weight: 10, gen: cat(lit("${"), weighted(choice[string]{weight: 1, gen: varNames}, choice[string]{weight: 1, gen: pick("11", "@", "#", "*")}), lit("}"))},
+		{weight: 15, gen: cat(lit("${"), varNames, pick(":-", "-", ":=", "=", ":+", "+", ":?", "?"), inner, lit("}"))},
+		{weight: 5, gen: cat(lit("${#"), pick("x", "@", "*"), lit("}"))},
+		{weight: 10, gen: cat(lit("${"), varNames, pick("#", "##", "%", "%%"), inner, lit("}"))},
+	}
+	if !g.bash {
+		return weighted(append(alts, choice[string]{weight: 40, gen: cat(lit("${"), varNames, lit("}"))})...)
+	}
+	// sh/12: under the switch the pattern of `${x/pat}` is never empty.
+	nonEmpty := shaped(inner, hegel.Map(inner, func(s string) string {
+		if s == "" {
+			return "a"
+		}
+		return s
+	}))
+	own := []hegel.Generator[string]{
+		cat(lit("${"), varNames, pick("/", "//", "/#", "/%"), inner, lit("/"), inner, lit("}")),
+		cat(lit("${"), varNames, lit("/"), nonEmpty, lit("}")),
+		cat(lit("${"), varNames, lit(":"), pick("1", "$i", "-1", " -1", "i+1"), lit("}")),
+		cat(lit("${"), varNames, lit(":"), pick("1", "$i", "0"), lit(":"), pick("2", "$n", "-1"), lit("}")),
+		cat(lit("${"), varNames, lit("["), pick("1", "@", "*", "$i", "i+1", "a"), lit("]}")),
+		cat(lit("${#"), varNames, lit("["), pick("@", "*", "1"), lit("]}")),
+		cat(lit("${!"), varNames, pick("", "[@]", "*", "@"), lit("}")),
+		cat(lit("${"), varNames, pick("^", "^^", ",", ",,"), lit("}")),
+		cat(lit("${"), varNames, lit("@"), pick("Q", "U", "a", "A", "E", "P", "L", "K", "k"), lit("}")),
+		cat(lit("${"), varNames, lit("[@]:"), pick("1", "$i"), pick("", ":2"), lit("}")),
+		cat(lit("${"), varNames, lit("["), pick("1", "$i"), lit("]"), pick(":-", "-", ":+"), inner, lit("}")),
+		cat(lit("${"), varNames, pick("^", ","), pick("a", "[ab]", "*"), lit("}")),
+	}
+	return weighted(append(alts, choice[string]{weight: 40, gen: hegel.OneOf(own...)})...)
+}
+
+// arithLeaves: a number, a variable, `$x`, `${x}`, or a dialect's own leaf.
+func (g *grammar) arithLeaves() hegel.Generator[string] {
+	own := pick("$1", "$#", "3")
+	if g.bash {
+		own = weighted(
+			choice[string]{weight: 4, gen: pick("2#101", "$1", "$#", "$(echo 1)")},
+			choice[string]{weight: 2, gen: cat(varNames, pick("[1]", "[$i]"))},
+		)
+	}
+	return weighted(
+		choice[string]{weight: 40, gen: numPool},
+		choice[string]{weight: 30, gen: varNames},
+		choice[string]{weight: 15, gen: wrap("$", varNames, "")},
+		choice[string]{weight: 7, gen: wrap("${", varNames, "}")},
+		choice[string]{weight: 8, gen: own},
+	)
+}
+
+// arithAssigns: `x OP expr`.
+func (g *grammar) arithAssigns(sub hegel.Generator[string]) hegel.Generator[string] {
+	return cat(varNames, lit(" "), arithAsgOps, lit(" "), sub)
+}
+
+// arithmetic: an expression two levels deep (a leaf from there, or a third
+// of the time before): binary, parenthesised, unary, increments (bash), a
+// ternary, a comma expression (bash) and, at the top, an assignment. Under
+// the sh/20 switch an operand starting with its unary operator's sign is
+// parenthesised.
+func (g *grammar) arithmetic() hegel.Generator[string] {
+	var expr hegel.Generator[string] // the forward reference, read when drawn
+	depth := 0
+	leaves := g.arithLeaves()
+	ops := arithBinOps
+	if g.bash {
+		ops = append(slices.Clone(ops), "**")
+	}
+	binOps := pick(ops...)
+	binary := hegel.Composite(func(tc hegel.TestCase) string {
+		x, op, y := hegel.Draw(tc, expr), hegel.Draw(tc, binOps), hegel.Draw(tc, expr)
+		if Known.arithGluedSign && (op == "-" || op == "+") && strings.HasPrefix(y, op) {
+			y = "(" + y + ")" // Minify would print `a + +b` as `a++b`
+		}
+		return x + " " + op + " " + y
+	})
+	parens := hegel.Composite(func(tc hegel.TestCase) string { return "(" + hegel.Draw(tc, expr) + ")" })
+	unary := hegel.Composite(func(tc hegel.TestCase) string {
+		op, x := hegel.Draw(tc, pick("-", "+", "!", "~")), hegel.Draw(tc, expr)
+		if Known.arithGluedSign && (op == "-" || op == "+") && strings.HasPrefix(x, op) {
+			return op + "(" + x + ")" // `+ ++x` would print as `+++x`
+		}
+		return op + x
+	})
+	ternary := hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, expr) + " ? " + hegel.Draw(tc, expr) + " : " + hegel.Draw(tc, expr)
+	})
+	assign := hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, varNames) + " " + hegel.Draw(tc, arithAsgOps) + " " + hegel.Draw(tc, expr)
+	})
+	inc, comma := leaves, leaves
+	if g.bash {
+		inc = weighted(choice[string]{weight: 1, gen: cat(pick("++", "--"), varNames)}, choice[string]{weight: 1, gen: cat(varNames, pick("++", "--"))})
+		comma = hegel.Composite(func(tc hegel.TestCase) string { return hegel.Draw(tc, expr) + ", " + hegel.Draw(tc, expr) })
+	}
+	branches := []choice[string]{
+		{weight: 3, gen: binary},
+		{weight: 1, gen: parens},
+		{weight: 1, gen: unary},
+		{weight: 2, gen: inc},
+		{weight: 1, gen: ternary},
+		{weight: 1, gen: comma},
+	}
+	inner := weighted(append(slices.Clone(branches), choice[string]{weight: 1, gen: leaves})...)
+	top := weighted(append(slices.Clone(branches), choice[string]{weight: 1, gen: assign})...)
+	expr = hegel.Composite(func(tc hegel.TestCase) string {
+		if depth >= 2 || hegel.Draw(tc, chance(35)) {
+			return hegel.Draw(tc, leaves)
+		}
+		branch := inner
+		if depth == 0 {
+			branch = top
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branch)
+	})
+	return expr
+}
+
+// testExprs: the expression of `[[ ]]`, two levels deep: a leaf (a unary
+// test, a regex match or a binary test of two words) from there or half of
+// the time before, else a negation, parentheses or a conjunction.
+func (g *grammar) testExprs(dqs, params, cmdSubsts hegel.Generator[string]) hegel.Generator[string] {
+	var expr hegel.Generator[string] // the forward reference, read when drawn
+	depth := 0
+	testWords := weighted(
+		choice[string]{weight: 2, gen: pick(testWordPool...)},
+		choice[string]{weight: 1, gen: dqs},
+		choice[string]{weight: 1, gen: params},
+		choice[string]{weight: 1, gen: cmdSubsts},
+	)
+	leaves := weighted(
+		choice[string]{weight: 50, gen: cat(pick("-n", "-z", "-f", "-d", "-e", "-v", "-r", "-x", "-s"), lit(" "), testWords)},
+		choice[string]{weight: 25, gen: cat(testWords, lit(" "), pick("==", "!=", "=", "<", ">", "-eq", "-ne", "-lt", "-gt", "-le", "-ge", "-nt", "-ot", "-ef"), lit(" "), testWords)},
+		choice[string]{weight: 25, gen: cat(testWords, lit(" =~ "), pick("^a.*b$", "[0-9]+", `"$re"`, `a\ b`, "x?", "^[[:alpha:]]"))},
+	)
+	junctions := pick(" && ", " || ")
+	branches := weighted(
+		choice[string]{weight: 1, gen: hegel.Composite(func(tc hegel.TestCase) string { return "! " + hegel.Draw(tc, expr) })},
+		choice[string]{weight: 1, gen: hegel.Composite(func(tc hegel.TestCase) string { return "( " + hegel.Draw(tc, expr) + " )" })},
+		choice[string]{weight: 2, gen: hegel.Composite(func(tc hegel.TestCase) string {
+			return hegel.Draw(tc, expr) + hegel.Draw(tc, junctions) + hegel.Draw(tc, expr)
+		})},
+	)
+	expr = hegel.Composite(func(tc hegel.TestCase) string {
+		if depth >= 2 || hegel.Draw(tc, chance(50)) {
+			return hegel.Draw(tc, leaves)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branches)
+	})
+	return expr
+}
+
+// declClauses: declare/local/export/readonly/typeset with flags (for the
+// first three) and one to three names, quoted words or assignments.
+func (g *grammar) declClauses(wordTexts, dqs, assigns hegel.Generator[string]) hegel.Generator[string] {
+	flags := joined(wrap(" ", pick("-a", "-A", "-i", "-r", "-x", "-n", "-g", "-p", "-l", "-u"), ""), 0, 2, "")
+	items := func(assign hegel.Generator[string]) hegel.Generator[string] {
+		return joined(wrap(" ", weighted(choice[string]{weight: 1, gen: varNames}, choice[string]{weight: 1, gen: dqs}, choice[string]{weight: 2, gen: assign}), ""), 1, 3, "")
+	}
+	plainItems, exportItems := items(assigns), items(cat(varNames, lit("="), wordTexts))
+	return weighted(
+		choice[string]{weight: 3, gen: cat(pick("declare", "local", "typeset"), flags, plainItems)},
+		choice[string]{weight: 1, gen: cat(lit("export"), exportItems)},
+		choice[string]{weight: 1, gen: cat(lit("readonly"), plainItems)},
+	)
+}
+
+// grammars: one per dialect, per the Simplify property's sh/16 switch and
+// per oneLine (the narrow properties).
+var grammars = map[[3]bool]*grammar{}
+
+func grammarOf(bash, noDqInExp, oneLine bool) *grammar {
+	k := [3]bool{bash, noDqInExp, oneLine}
+	if g, ok := grammars[k]; ok {
+		return g
+	}
+	g := newGrammar(bash, noDqInExp, oneLine)
+	grammars[k] = g
+	return g
+}
+
+// progCase: a dialect (bash three times in four) and a program in it.
+type progCase struct {
+	bash bool
+	prog program
+}
+
+func (c progCase) lang() syntax.LangVariant { return langOf(c.bash) }
+
+func (c progCase) src() string { return c.prog.String() }
+
+func (c progCase) GoString() string {
+	return fmt.Sprintf("%s source:\n%s", langName(c.lang()), c.src())
+}
+
+// progCases: a program from the dialect's grammar (noDqInExp for Simplify).
+func progCases(noDqInExp bool) hegel.Generator[progCase] {
+	return hegel.Composite(func(tc hegel.TestCase) progCase {
+		bash := hegel.Draw(tc, chance(75))
+		return progCase{bash: bash, prog: hegel.Draw(tc, grammarOf(bash, noDqInExp, false).programs)}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Printer options.
+
+type printOpts struct {
+	indent                                                       int
+	binaryNextLine, switchCaseIndent, spaceRedirects             bool
+	keepPadding, minify, singleLine, funcNextLine, blockNextLine bool
+}
+
+// printOptions: each option on a quarter of the time (KeepPadding a tenth),
+// SingleLine only without Minify, FunctionNextLine or BlockNextLine a
+// quarter of the time each.
+var printOptions = hegel.Composite(func(tc hegel.TestCase) printOpts {
+	o := printOpts{
+		indent:           hegel.Draw(tc, hegel.Integers(0, 4)),
+		binaryNextLine:   hegel.Draw(tc, chance(25)),
+		switchCaseIndent: hegel.Draw(tc, chance(25)),
+		spaceRedirects:   hegel.Draw(tc, chance(25)),
+		keepPadding:      hegel.Draw(tc, chance(10)),
+		minify:           hegel.Draw(tc, chance(25)),
+	}
+	if !o.minify {
+		o.singleLine = hegel.Draw(tc, chance(25))
+	}
+	switch hegel.Draw(tc, hegel.Integers(0, 3)) {
+	case 1:
+		o.funcNextLine = true
+	case 2:
+		o.blockNextLine = true
+	}
+	return o
+})
+
+func (o printOpts) printer() *syntax.Printer {
+	return syntax.NewPrinter(
+		syntax.Indent(uint(o.indent)),
+		syntax.BinaryNextLine(o.binaryNextLine),
+		syntax.SwitchCaseIndent(o.switchCaseIndent),
+		syntax.SpaceRedirects(o.spaceRedirects),
+		syntax.KeepPadding(o.keepPadding),
+		syntax.Minify(o.minify),
+		syntax.SingleLine(o.singleLine),
+		syntax.FunctionNextLine(o.funcNextLine),
+		syntax.BlockNextLine(o.blockNextLine),
+	)
+}
+
+func (o printOpts) String() string {
+	var parts []string
+	parts = append(parts, fmt.Sprintf("Indent(%d)", o.indent))
+	for _, f := range []struct {
+		on   bool
+		name string
+	}{
+		{o.binaryNextLine, "BinaryNextLine"}, {o.switchCaseIndent, "SwitchCaseIndent"},
+		{o.spaceRedirects, "SpaceRedirects"}, {o.keepPadding, "KeepPadding"},
+		{o.minify, "Minify"}, {o.singleLine, "SingleLine"},
+		{o.funcNextLine, "FunctionNextLine"}, {o.blockNextLine, "BlockNextLine"},
+	} {
+		if f.on {
+			parts = append(parts, f.name)
+		}
+	}
+	return strings.Join(parts, " ")
+}
+
+// mustParse parses a generated program, telling a parser bug (the shell
+// accepts the program) from a generator bug (the shell rejects it too).
+func mustParse(ht *hegel.T, lang syntax.LangVariant, src string, keepComments bool) *syntax.File {
+	f, err := parse(lang, src, keepComments)
+	if err != nil {
+		ok, msg := shellAccepts(lang, src)
+		if ok {
+			fail(ht, "%s parser rejects a program %s accepts: %v\nsource:\n%s", langName(lang), langName(lang), err, src)
+		}
+		fail(ht, "GENERATOR: %s rejects the generated program: %s\nparser: %v\nsource:\n%s", langName(lang), msg, err, src)
+	}
+	if ok, msg := shellAccepts(lang, src); !ok {
+		fail(ht, "GENERATOR: %s rejects the generated program, which the parser accepts: %s\nsource:\n%s", langName(lang), msg, src)
+	}
+	return f
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// fmtCase: a program, the printer options, and whether the tree also goes
+// through typedjson (30%).
+type fmtCase struct {
+	progCase
+	opts printOpts
+	json bool
+}
+
+func (c fmtCase) GoString() string {
+	return fmt.Sprintf("%s\nprinter: %s\ntypedjson: %v", c.progCase.GoString(), c.opts, c.json)
+}
+
+var fmtCases = hegel.Composite(func(tc hegel.TestCase) fmtCase {
+	return fmtCase{progCase: hegel.Draw(tc, progCases(false)), opts: hegel.Draw(tc, printOptions), json: hegel.Draw(tc, chance(30))}
+})
+
+// A printed program parses back to the same tree, prints the same way again,
+// and is accepted by the dialect's shell, under every printer option.
+func TestHegelFormattingPreservesTheProgram(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkFormatting(ht, hegel.Draw(ht, fmtCases))
+	})
+}
+
+// checkFormatting is the formatting property's check of one case, shared
+// with the narrow properties of hegel_shapes_test.go.
+func checkFormatting(ht *hegel.T, c fmtCase) {
+	lang, src, opts := c.lang(), c.src(), c.opts
+	f := mustParse(ht, lang, src, true)
+	// The printer options under the switches: the shapes of the printer
+	// bugs are left out by turning the option off for the program.
+	if Known.keepPaddingBang && opts.keepPadding && (leadingRedirect.MatchString(src) || negation.MatchString(src) || (opts.indent > 0 && openParenLine.MatchString(src))) {
+		opts.keepPadding = false
+	}
+	if Known.minifyEmptyItem && opts.minify && emptyLastItem.MatchString(src) {
+		opts.minify = false
+	}
+	if Known.minifyPipeRedirect && opts.minify && pipeRedirect.MatchString(src) {
+		opts.minify = false
+	}
+	if Known.letComment && opts.minify && strings.Contains(src, "let ") {
+		opts.minify = false // `let x=1|[ a ]` does not parse
+	}
+	if Known.singleLineEsac && opts.singleLine && strings.Contains(src, "esac") {
+		opts.singleLine = false
+	}
+	if Known.singleLineBgClose && opts.singleLine && bgBeforeClose.MatchString(src) {
+		opts.singleLine = false
+	}
+	if Known.singleLineComment && opts.singleLine && closeComment.MatchString(src) {
+		opts.singleLine = false
+	}
+	if (opts.singleLine || opts.minify) && hdocPrinterShape(src) {
+		// sh/5, sh/8: joining lines moves a heredoc body into whatever the
+		// printer breaks across lines after it.
+		opts.singleLine, opts.minify = false, false
+	}
+	if opts != c.opts {
+		note(ht, "printer under HEGEL_NO_KNOWN=1: %s", opts)
+	}
+	out, err := printNode(opts.printer(), f)
+	if err != nil {
+		fail(ht, "Print(%s) failed: %v\nsource:\n%s", opts, err, src)
+	}
+	note(ht, "printed:\n%s", out)
+	base := f
+	if opts.minify {
+		// Minify drops the comments; compare against the comment-free tree.
+		base, _ = parse(lang, src, false)
+	}
+	f2, err := parse(lang, out, true)
+	if err != nil {
+		fail(ht, "the printed program (%s) does not parse: %v\nsource:\n%s\nprinted:\n%s", opts, err, src, out)
+	}
+	cmp := shape
+	if opts.minify {
+		cmp = shapeMinified
+	}
+	if a, b := cmp(base), cmp(f2); a != b {
+		fail(ht, "the printed program (%s) parses to a different tree\nsource:\n%s\nprinted:\n%s\ndefault print of the source:\n%s\ndefault print of the printed:\n%s\nshape diff %s",
+			opts, src, out, defaultPrint(base), defaultPrint(f2), firstDiff(a, b))
+	}
+	out2, err := printNode(opts.printer(), f2)
+	if err != nil {
+		fail(ht, "Print(%s) of the reparsed program failed: %v", opts, err)
+	}
+	if out2 != out {
+		fail(ht, "formatting (%s) is not idempotent\nsource:\n%s\nfirst:\n%s\nsecond:\n%s\ndiff %s", opts, src, out, out2, firstDiff(out, out2))
+	}
+	if ok, msg := shellAccepts(lang, out); !ok {
+		fail(ht, "%s rejects the printed program (%s): %s\nsource:\n%s\nprinted:\n%s", langName(lang), opts, msg, src, out)
+	}
+	if c.json {
+		var buf bytes.Buffer
+		if err := typedjson.Encode(&buf, f); err != nil {
+			fail(ht, "typedjson.Encode: %v", err)
+		}
+		dec, err := typedjson.Decode(bytes.NewReader(buf.Bytes()))
+		if err != nil {
+			fail(ht, "typedjson.Decode of Encode's output: %v\njson:\n%s", err, buf.String())
+		}
+		var buf2 bytes.Buffer
+		if err := typedjson.Encode(&buf2, dec); err != nil {
+			fail(ht, "typedjson.Encode of the decoded tree: %v", err)
+		}
+		if buf.String() != buf2.String() {
+			fail(ht, "typedjson round trip changed the tree\nsource:\n%s\ndiff %s", src, firstDiff(buf.String(), buf2.String()))
+		}
+		if dp := defaultPrint(dec); dp != defaultPrint(f) {
+			fail(ht, "the decoded tree prints differently\nsource:\n%s\ndecoded:\n%s", src, dp)
+		}
+	}
+}
+
+// simplifyCases: programs whose expansions inside double quotes hold no
+// double-quoted words under the sh/16 switch.
+var simplifyCases = progCases(Known.quotesInQuotedExp)
+
+// Simplify keeps the program valid, is idempotent, and reports whether it
+// changed anything.
+func TestHegelSimplifyIsStable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkSimplify(ht, hegel.Draw(ht, simplifyCases))
+	})
+}
+
+// checkSimplify is the Simplify property's check of one case, shared with
+// the narrow properties of hegel_shapes_test.go.
+func checkSimplify(ht *hegel.T, c progCase) {
+	lang, src := c.lang(), c.src()
+	f := mustParse(ht, lang, src, true)
+	before := shape(f)
+	changed := syntax.Simplify(f)
+	after := shape(f)
+	if changed != (before != after) {
+		fail(ht, "Simplify reported %v but the tree %s\nsource:\n%s\nsimplified:\n%s", changed, map[bool]string{true: "changed", false: "did not change"}[before != after], src, defaultPrint(f))
+	}
+	out := defaultPrint(f)
+	note(ht, "simplified (changed=%v):\n%s", changed, out)
+	f2, err := parse(lang, out, true)
+	if err != nil {
+		fail(ht, "the simplified program does not parse: %v\nsource:\n%s\nsimplified:\n%s", err, src, out)
+	}
+	if a, b := shape(f), shape(f2); a != b {
+		fail(ht, "the simplified program prints to a different tree\nsource:\n%s\nsimplified:\n%s\nreprinted:\n%s\nshape diff %s", src, out, defaultPrint(f2), firstDiff(a, b))
+	}
+	if syntax.Simplify(f2) {
+		fail(ht, "Simplify is not idempotent\nsource:\n%s\nonce:\n%s\ntwice:\n%s", src, out, defaultPrint(f2))
+	}
+	if ok, msg := shellAccepts(lang, out); !ok {
+		fail(ht, "%s rejects the simplified program: %s\nsource:\n%s\nsimplified:\n%s", langName(lang), msg, src, out)
+	}
+}
+
+// quoteRunes: what Quote has to deal with: letters, every shell
+// metacharacter, whitespace, non-ASCII, controls and a NUL.
+var quoteRunes = []rune{'a', 'b', 'Z', '0', ' ', '\t', '\n', '\'', '"', '$', '`', '\\', '*', '?', '[', ']', '~', '#', '!', '{', '}', '(', ')', ';', '&', '|', '<', '>', '=', ',', ':', '-', '@', '%', '^', '\u00e9', '\u25cb', '\u20ac', '\u00a0', '\u200b', '\U0001F600', '\x01', '\x7f', '\x0b', '\x1b', '\r', '\x00'}
+
+// quoteCase: a string of up to eight pieces (a rune of the pool, one time in
+// twenty a byte that is not valid UTF-8), the dialect (POSIX 35%), and
+// whether the shell's printf is asked too (half of the time).
+type quoteCase struct {
+	s     string
+	posix bool
+	shell bool
+}
+
+func (c quoteCase) lang() syntax.LangVariant { return langOf(!c.posix) }
+
+func (c quoteCase) GoString() string {
+	return fmt.Sprintf("%s Quote(%q) shell=%v", langName(c.lang()), c.s, c.shell)
+}
+
+var quoteCases = hegel.Composite(func(tc hegel.TestCase) quoteCase {
+	pieces := weighted(
+		choice[string]{weight: 95, gen: hegel.Map(hegel.SampledFrom(quoteRunes), func(r rune) string { return string(r) })},
+		choice[string]{weight: 5, gen: hegel.Map(hegel.Integers(0x80, 0xff), func(b int) string { return string([]byte{byte(b)}) })},
+	)
+	return quoteCase{s: hegel.Draw(tc, joined(pieces, 0, 8, "")), posix: hegel.Draw(tc, chance(35)), shell: hegel.Draw(tc, chance(50))}
+})
+
+// Quote's output is a single literal word that expands, in the package and
+// in the shell, to the original string; it fails only for what the dialect
+// cannot express.
+func TestHegelQuoteRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, quoteCases)
+		s, lang := c.s, c.lang()
+		quoted, err := syntax.Quote(s, lang)
+		if err != nil {
+			var qe *syntax.QuoteError
+			if !errors.As(err, &qe) {
+				fail(ht, "Quote(%q, %s) error is a %T, not *QuoteError: %v", s, langName(lang), err, err)
+			}
+			if qe.ByteOffset < 0 || qe.ByteOffset >= len(s) {
+				fail(ht, "Quote(%q, %s) error offset %d outside the string: %v", s, langName(lang), qe.ByteOffset, err)
+			}
+			hasNul := strings.ContainsRune(s, 0)
+			if lang == syntax.LangBash && !hasNul {
+				fail(ht, "Quote(%q, bash) failed without a NUL byte: %v", s, err)
+			}
+			if lang == syntax.LangPOSIX && !hasNul && !hasUnprintable(s) {
+				fail(ht, "Quote(%q, posix) failed on a printable string: %v", s, err)
+			}
+			return
+		}
+		if strings.ContainsRune(s, 0) {
+			fail(ht, "Quote(%q, %s) = %s: a NUL byte cannot be quoted", s, langName(lang), quoted)
+		}
+		note(ht, "quoted: %s", quoted)
+		f, err := parse(lang, quoted, false)
+		if err != nil {
+			fail(ht, "Quote(%q, %s) = %s does not parse: %v", s, langName(lang), quoted, err)
+		}
+		if len(f.Stmts) != 1 {
+			fail(ht, "Quote(%q, %s) = %s parses as %d statements", s, langName(lang), quoted, len(f.Stmts))
+		}
+		call, ok := f.Stmts[0].Cmd.(*syntax.CallExpr)
+		if !ok || len(call.Args) != 1 || len(call.Assigns) != 0 || len(f.Stmts[0].Redirs) != 0 {
+			fail(ht, "Quote(%q, %s) = %s does not parse as one word: %s", s, langName(lang), quoted, shape(f))
+		}
+		syntax.Walk(call.Args[0], func(node syntax.Node) bool {
+			switch node.(type) {
+			case nil, *syntax.Word, *syntax.Lit, *syntax.SglQuoted, *syntax.DblQuoted:
+			default:
+				fail(ht, "Quote(%q, %s) = %s contains a %T", s, langName(lang), quoted, node)
+			}
+			return true
+		})
+		cfg := &expand.Config{Env: expand.FuncEnviron(func(string) string { return "" })}
+		got, err := expand.Literal(cfg, call.Args[0])
+		if err != nil {
+			fail(ht, "expand.Literal(Quote(%q, %s) = %s): %v", s, langName(lang), quoted, err)
+		}
+		if got != s {
+			fail(ht, "expand.Literal(Quote(%q, %s) = %s) = %q", s, langName(lang), quoted, got)
+		}
+		if c.shell {
+			if out, ran := shellPrintf(lang, quoted); ran && out != s {
+				fail(ht, "%s printf %%s of Quote(%q) = %s gives %q", langName(lang), s, quoted, out)
+			}
+		}
+	})
+}
+
+func hasUnprintable(s string) bool {
+	for i := 0; i < len(s); {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		if r == utf8.RuneError || !unicode.IsPrint(r) {
+			return true
+		}
+		i += size
+	}
+	return false
+}
+
+// hasHeredoc reports whether a node contains a heredoc redirect (whose body
+// lies outside the node's span).
+func hasHeredoc(node syntax.Node) bool {
+	found := false
+	syntax.Walk(node, func(n syntax.Node) bool {
+		if r, ok := n.(*syntax.Redirect); ok && (r.Op == syntax.Hdoc || r.Op == syntax.DashHdoc) {
+			found = true
+		}
+		return !found
+	})
+	return found
+}
+
+var positionCases = progCases(false)
+
+// Every node's positions point into the source, agree with its line and
+// column, and a statement's or argument's span parses alone to the same node.
+func TestHegelPositionsMatchTheSource(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkPositions(ht, hegel.Draw(ht, positionCases))
+	})
+}
+
+// checkPositions is the positions property's check of one case, shared with
+// the narrow properties of hegel_shapes_test.go.
+func checkPositions(ht *hegel.T, c progCase) {
+	lang, src := c.lang(), c.src()
+	f := mustParse(ht, lang, src, false)
+	coprocStmts := map[*syntax.Stmt]bool{}
+	if Known.coprocStmtPos {
+		syntax.Walk(f, func(node syntax.Node) bool {
+			if cc, ok := node.(*syntax.CoprocClause); ok {
+				coprocStmts[cc.Stmt] = true
+			}
+			return true
+		})
+	}
+	spans := 0
+	syntax.Walk(f, func(node syntax.Node) bool {
+		if node == nil {
+			return true
+		}
+		if _, isFile := node.(*syntax.File); isFile {
+			return true
+		}
+		pos, end := node.Pos(), node.End()
+		if ci, ok := node.(*syntax.CaseItem); ok && Known.emptyCaseItemEnd && len(ci.Stmts) == 0 && !ci.OpPos.IsValid() {
+			return true
+		}
+		if !pos.IsValid() {
+			if _, isComment := node.(*syntax.Comment); !isComment {
+				fail(ht, "%T has an invalid Pos\nsource:\n%s", node, src)
+			}
+			return true
+		}
+		po, eo := int(pos.Offset()), int(end.Offset())
+		if po > len(src) || eo > len(src) || eo < po {
+			fail(ht, "%T spans [%d, %d) in a %d-byte source\nsource:\n%s", node, po, eo, len(src), src)
+		}
+		if l, c := lineCol(src, po); int(pos.Line()) != l || int(pos.Col()) != c {
+			fail(ht, "%T Pos %s: offset %d is line %d col %d\nsource:\n%s", node, pos, po, l, c, src)
+		}
+		if l, c := lineCol(src, eo); end.IsValid() && (int(end.Line()) != l || int(end.Col()) != c) {
+			// End does not cross into the next line when the character is a newline.
+			if !(eo < len(src) && src[eo] == '\n' && int(end.Line()) == l && int(end.Col()) == c) {
+				if !(eo > 0 && src[eo-1] == '\n' && int(end.Line()) == l-1) {
+					fail(ht, "%T End %s: offset %d is line %d col %d\nsource:\n%s", node, end, eo, l, c, src)
+				}
+			}
+		}
+		span := src[po:eo]
+		switch x := node.(type) {
+		case *syntax.Stmt:
+			if hasHeredoc(x) || spans > 20 {
+				return true
+			}
+			// A heredoc earlier on the statement's line puts its body
+			// inside the span of a statement spanning lines.
+			if lineStart := strings.LastIndex(src[:po], "\n") + 1; heredocOp(src[lineStart:po]) >= 0 {
+				return true
+			}
+			if Known.negatedPipeline && !x.Negated && strings.HasPrefix(span, "!") {
+				return true
+			}
+			if coprocStmts[x] {
+				return true
+			}
+			spans++
+			sf, err := parse(lang, span, false)
+			if err != nil {
+				fail(ht, "the statement's span %q does not parse alone: %v\nsource:\n%s", span, err, src)
+			}
+			if len(sf.Stmts) != 1 {
+				fail(ht, "the statement's span %q parses as %d statements\nsource:\n%s", span, len(sf.Stmts), src)
+			}
+			if a, b := shape(x), shape(sf.Stmts[0]); a != b {
+				fail(ht, "the statement's span %q parses to a different statement\nstatement: %s\nspan: %s\nsource:\n%s\ndiff %s", span, defaultPrint(x), defaultPrint(sf.Stmts[0]), src, firstDiff(a, b))
+			}
+		case *syntax.CallExpr:
+			for _, w := range x.Args {
+				if spans > 40 {
+					break
+				}
+				spans++
+				checkWordSpan(ht, lang, src, w)
+			}
+		case *syntax.WordIter:
+			for _, w := range x.Items {
+				spans++
+				checkWordSpan(ht, lang, src, w)
+			}
+		}
+		return true
+	})
+}
+
+func checkWordSpan(ht *hegel.T, lang syntax.LangVariant, src string, w *syntax.Word) {
+	span := src[w.Pos().Offset():w.End().Offset()]
+	var words []*syntax.Word
+	for word, err := range syntax.NewParser(syntax.Variant(lang)).WordsSeq(strings.NewReader(span)) {
+		if err != nil {
+			fail(ht, "the word's span %q does not parse as words: %v\nsource:\n%s", span, err, src)
+		}
+		words = append(words, word)
+	}
+	if len(words) != 1 {
+		fail(ht, "the word's span %q parses as %d words\nsource:\n%s", span, len(words), src)
+	}
+	if a, b := shape(w), shape(words[0]); a != b {
+		fail(ht, "the word's span %q parses to a different word\nword: %s\nspan: %s\nsource:\n%s\ndiff %s", span, defaultPrint(w), defaultPrint(words[0]), src, firstDiff(a, b))
+	}
+}
+
+// streamCase: which streaming parser is compared with Parse and its input:
+// a program (StmtsSeq, InteractiveSeq), one to four words and their
+// separator (WordsSeq), or an arithmetic expression (Arithmetic).
+type streamKind int
+
+const (
+	stmtsSeq streamKind = iota
+	interactiveSeq
+	wordsSeq
+	arithmetic
+)
+
+var streamKindNames = []string{"StmtsSeq", "InteractiveSeq", "WordsSeq", "Arithmetic"}
+
+type streamCase struct {
+	kind  streamKind
+	bash  bool
+	prog  program
+	words []string
+	sep   string
+	expr  string
+}
+
+func (c streamCase) lang() syntax.LangVariant { return langOf(c.bash) }
+
+func (c streamCase) line() string { return strings.Join(c.words, c.sep) }
+
+func (c streamCase) GoString() string {
+	switch c.kind {
+	case wordsSeq:
+		return fmt.Sprintf("%s WordsSeq line: %s", langName(c.lang()), c.line())
+	case arithmetic:
+		return fmt.Sprintf("%s Arithmetic: %s", langName(c.lang()), c.expr)
+	}
+	return fmt.Sprintf("%s %s source:\n%s", langName(c.lang()), streamKindNames[c.kind], c.prog.String())
+}
+
+func programStreams(kind streamKind) hegel.Generator[streamCase] {
+	return hegel.Map(progCases(false), func(c progCase) streamCase { return streamCase{kind: kind, bash: c.bash, prog: c.prog} })
+}
+
+// streamCases: a program for the statement parsers four times in five (a
+// program is the richer input), else a word list or an arithmetic
+// expression.
+var streamCases = weighted(
+	choice[streamCase]{weight: 40, gen: programStreams(stmtsSeq)},
+	choice[streamCase]{weight: 40, gen: programStreams(interactiveSeq)},
+	choice[streamCase]{weight: 10, gen: hegel.Composite(func(tc hegel.TestCase) streamCase {
+		bash := hegel.Draw(tc, chance(75))
+		return streamCase{kind: wordsSeq, bash: bash, words: hegel.Draw(tc, many(grammarOf(bash, false, false).words, 1, 4)), sep: hegel.Draw(tc, pick(" ", "  ", "\t"))}
+	})},
+	choice[streamCase]{weight: 10, gen: hegel.Composite(func(tc hegel.TestCase) streamCase {
+		bash := hegel.Draw(tc, chance(75))
+		return streamCase{kind: arithmetic, bash: bash, expr: hegel.Draw(tc, grammarOf(bash, false, false).ariths)}
+	})},
+)
+
+// The streaming and partial parsers agree with Parse.
+func TestHegelStreamingParsersAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkStreams(ht, hegel.Draw(ht, streamCases))
+	})
+}
+
+// checkStreams is the streaming property's check of one case, shared with
+// the narrow properties of hegel_shapes_test.go.
+func checkStreams(ht *hegel.T, c streamCase) {
+	lang := c.lang()
+	switch c.kind {
+	case stmtsSeq:
+		src := c.prog.String()
+		f := mustParse(ht, lang, src, false)
+		var got []*syntax.Stmt
+		for s, err := range syntax.NewParser(syntax.Variant(lang)).StmtsSeq(strings.NewReader(src)) {
+			if err != nil {
+				fail(ht, "StmtsSeq failed where Parse succeeded: %v\nsource:\n%s", err, src)
+			}
+			got = append(got, s)
+		}
+		compareStmts(ht, "StmtsSeq", src, f.Stmts, got)
+	case interactiveSeq:
+		src := c.prog.String()
+		f := mustParse(ht, lang, src, false)
+		// sh/28: InteractiveSeq yields the statements before a heredoc
+		// redirect twice when the heredoc sits at the parser's 1024-byte
+		// read boundary (`strings.Repeat("#", 1009) + "\na;b;c <<EOF\nx\nEOF\n"`:
+		// Parse 3 statements, InteractiveSeq 5); drawn by default.
+		ht.Assume(!(Known.hdocReadBoundary && hdocNearReadBoundary(src)))
+		var got []*syntax.Stmt
+		for stmts, err := range syntax.NewParser(syntax.Variant(lang)).InteractiveSeq(strings.NewReader(src)) {
+			if err != nil {
+				fail(ht, "InteractiveSeq failed where Parse succeeded: %v\nsource:\n%s", err, src)
+			}
+			got = append(got, stmts...)
+		}
+		compareStmts(ht, "InteractiveSeq", src, f.Stmts, got)
+	case wordsSeq:
+		line := c.line()
+		f := mustParse(ht, lang, "x "+line, false)
+		call, ok := f.Stmts[0].Cmd.(*syntax.CallExpr)
+		if !ok || len(f.Stmts) != 1 {
+			fail(ht, "GENERATOR: %q is not a single simple command", "x "+line)
+		}
+		var got []*syntax.Word
+		for w, err := range syntax.NewParser(syntax.Variant(lang)).WordsSeq(strings.NewReader(line)) {
+			if err != nil {
+				fail(ht, "WordsSeq(%q) failed where Parse succeeded: %v", line, err)
+			}
+			got = append(got, w)
+		}
+		want := call.Args[1:]
+		if len(got) != len(want) {
+			fail(ht, "WordsSeq(%q) gives %d words, the command has %d arguments", line, len(got), len(want))
+		}
+		for i := range got {
+			if a, b := shape(want[i]), shape(got[i]); a != b {
+				fail(ht, "WordsSeq(%q) word %d differs: %s vs %s\ndiff %s", line, i, defaultPrint(want[i]), defaultPrint(got[i]), firstDiff(a, b))
+			}
+		}
+	default:
+		e := c.expr
+		f := mustParse(ht, lang, "echo $(("+e+"))", false)
+		call := f.Stmts[0].Cmd.(*syntax.CallExpr)
+		ae, ok := call.Args[1].Parts[0].(*syntax.ArithmExp)
+		if !ok || len(call.Args) != 2 || len(call.Args[1].Parts) != 1 {
+			fail(ht, "GENERATOR: $((%s)) is not one arithmetic expansion", e)
+		}
+		got, err := syntax.NewParser(syntax.Variant(lang)).Arithmetic(strings.NewReader(e))
+		if err != nil {
+			fail(ht, "Arithmetic(%q) failed where Parse succeeded: %v", e, err)
+		}
+		if a, b := shape(ae.X), shape(got); a != b {
+			fail(ht, "Arithmetic(%q) differs from the expansion's expression\ndiff %s", e, firstDiff(a, b))
+		}
+	}
+}
+
+// hdocNearReadBoundary reports whether a heredoc redirect of src lies in
+// the 128 bytes before a multiple of 1024, where its body crosses the
+// parser's read boundary (sh/28).
+func hdocNearReadBoundary(src string) bool {
+	off := 0
+	for _, l := range strings.Split(src, "\n") {
+		if i := heredocOp(l); i >= 0 && (off+i)%1024 >= 1024-128 {
+			return true
+		}
+		off += len(l) + 1
+	}
+	return false
+}
+
+func compareStmts(ht *hegel.T, what, src string, want, got []*syntax.Stmt) {
+	if len(want) != len(got) {
+		fail(ht, "%s yields %d statements, Parse %d\nsource:\n%s", what, len(got), len(want), src)
+	}
+	for i := range want {
+		if a, b := shape(want[i]), shape(got[i]); a != b {
+			fail(ht, "%s statement %d differs from Parse's\nParse: %s\n%s: %s\nsource:\n%s\ndiff %s", what, i, defaultPrint(want[i]), what, defaultPrint(got[i]), src, firstDiff(a, b))
+		}
+	}
+}
+
+var mutationBytes = []byte("(){}[]$\"'`;|&<>#!\n \\=")
+
+// mutation: an edit of one byte of a program at a position (modulo its live
+// length): truncate there, insert a byte, delete the byte, replace it.
+type mutation struct {
+	kind int
+	at   int
+	b    byte
+}
+
+func (m mutation) apply(src string) string {
+	if src == "" {
+		return string(m.b)
+	}
+	at := m.at % len(src)
+	switch m.kind {
+	case 0:
+		return src[:at]
+	case 1:
+		return src[:at] + string(m.b) + src[at:]
+	case 2:
+		return src[:at] + src[at+1:]
+	default:
+		return src[:at] + string(m.b) + src[at+1:]
+	}
+}
+
+// mutationsIn: one or two mutations (a second one 30% of the time), their
+// positions drawn over the program's length.
+func mutationsIn(size int) hegel.Generator[[]mutation] {
+	one := hegel.Composite(func(tc hegel.TestCase) mutation {
+		return mutation{kind: hegel.Draw(tc, hegel.Integers(0, 3)), at: hegel.Draw(tc, hegel.Integers(0, max(size-1, 0))), b: hegel.Draw(tc, hegel.SampledFrom(mutationBytes))}
+	})
+	return weighted(choice[[]mutation]{weight: 70, gen: many(one, 1, 1)}, choice[[]mutation]{weight: 30, gen: many(one, 2, 2)})
+}
+
+// brokenCase: a program and its mutations, whether comments are kept, and
+// the RecoverErrors count (0 for none; 1 to 5 in 30% of cases).
+type brokenCase struct {
+	progCase
+	muts    []mutation
+	keep    bool
+	recover int
+}
+
+func (c brokenCase) src() string {
+	s := c.prog.String()
+	for _, m := range c.muts {
+		s = m.apply(s)
+	}
+	return s
+}
+
+func (c brokenCase) GoString() string {
+	return fmt.Sprintf("%s keepComments=%v recover=%d source:\n%q", langName(c.lang()), c.keep, c.recover, c.src())
+}
+
+var brokenCases = hegel.FlatMap(progCases(false), func(pc progCase) hegel.Generator[brokenCase] {
+	muts := mutationsIn(len(pc.src()))
+	return hegel.Composite(func(tc hegel.TestCase) brokenCase {
+		return brokenCase{progCase: pc, muts: hegel.Draw(tc, muts), keep: hegel.Draw(tc, chance(50)), recover: hegel.Draw(tc, maybe(30, hegel.Integers(1, 5)))}
+	})
+})
+
+// Broken input never panics; what parses prints and parses back the same;
+// what fails gives a positioned parse error; RecoverErrors recovers.
+func TestHegelBrokenInputsNeverPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkBroken(ht, hegel.Draw(ht, brokenCases))
+	})
+}
+
+// checkBroken is the broken-input property's check of one case, shared with
+// the narrow properties of hegel_shapes_test.go.
+func checkBroken(ht *hegel.T, c brokenCase) {
+	lang, src, keep, recoverN := c.lang(), c.src(), c.keep, c.recover
+	if Known.recoverArithAssign && arithAssign.MatchString(src) {
+		recoverN = 0 // sh/24: RecoverErrors panics on `x=$((a b`
+	}
+	opts := []syntax.ParserOption{syntax.Variant(lang), syntax.KeepComments(keep)}
+	if recoverN > 0 {
+		opts = append(opts, syntax.RecoverErrors(recoverN))
+	}
+	p := syntax.NewParser(opts...)
+	f, err := p.Parse(strings.NewReader(src), "")
+	if err != nil {
+		var pe syntax.ParseError
+		var le syntax.LangError
+		switch {
+		case errors.As(err, &pe):
+			if int(pe.Pos.Offset()) > len(src) {
+				fail(ht, "ParseError at %s beyond the %d-byte input: %v\nsource:\n%q", pe.Pos, len(src), err, src)
+			}
+		case errors.As(err, &le):
+		default:
+			fail(ht, "Parse error is a %T, not ParseError or LangError: %v\nsource:\n%q", err, err, src)
+		}
+		return
+	}
+	if f == nil {
+		fail(ht, "Parse returned no error and no file\nsource:\n%q", src)
+	}
+	out, perr := printNode(syntax.NewPrinter(), f)
+	if perr != nil {
+		fail(ht, "Print of an accepted program failed: %v\nsource:\n%q", perr, src)
+	}
+	note(ht, "printed:\n%q", out)
+	// The round trip is skipped by name under HEGEL_NO_KNOWN=1 where a
+	// printer bug decides it (the checks above have run): a line with a
+	// heredoc redirect followed by a substitution, subshell, backquote,
+	// `[[` (sh/5, sh/8) or a comment (sh/7).
+	for _, l := range strings.Split(src, "\n") {
+		if i := heredocOp(l); i >= 0 && (hdocPrinterShape(l) || (Known.hdocComment && trailingComment.MatchString(l[i:]))) {
+			return
+		}
+	}
+	if Known.emptyReplPrints && emptyRepl.MatchString(src) {
+		return // sh/12
+	}
+	if Known.dollarBackquote && strings.Contains(src, "$`") {
+		return // sh/15
+	}
+	// A backslash at EOF is a literal `\` for the parser and printed as
+	// `\\` (upstream #1354); bash drops it.
+	ht.Assume(!strings.HasSuffix(src, "\\"))
+	if recoverN > 0 && hasRecovered(f) {
+		// Recovered trees stand in for missing tokens; they need not print back.
+		return
+	}
+	f2, err := parse(lang, out, keep)
+	if err != nil {
+		fail(ht, "the printed program does not parse: %v\nsource:\n%q\nprinted:\n%q", err, src, out)
+	}
+	if a, b := shape(f), shape(f2); a != b {
+		fail(ht, "the printed program parses to a different tree\nsource:\n%q\nprinted:\n%q\nreprinted:\n%q\ndiff %s", src, out, defaultPrint(f2), firstDiff(a, b))
+	}
+	if lang == syntax.LangBash && len(src)%2 == 0 && !closeFdGlued.MatchString(src) {
+		if ok, msg := shellAccepts(lang, out); !ok {
+			fail(ht, "the parser accepts a program bash rejects: %s\nsource:\n%q\nprinted:\n%s", msg, src, out)
+		}
+	}
+}
+
+func hasRecovered(f *syntax.File) bool {
+	found := false
+	syntax.Walk(f, func(node syntax.Node) bool {
+		if node != nil && (node.Pos().IsRecovered() || node.End().IsRecovered()) {
+			found = true
+		}
+		return !found
+	})
+	return found
+}
