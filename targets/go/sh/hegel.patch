+// sh/4: in a negated pipeline, the first command's statement starts at the
+// `!`, which belongs to the pipeline's statement, not to the command.
+func TestHegelPinNegatedPipelineStatementsStartAtTheirCommand(t *testing.T) {
+	for _, src := range []string{"! a | b", "! a | b | c", "! { a; } | b"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		outer := f.Stmts[0]
+		if !outer.Negated {
+			t.Fatalf("Parse(%q): the pipeline statement is not negated", src)
+		}
+		bc, ok := outer.Cmd.(*syntax.BinaryCmd)
+		if !ok {
+			t.Fatalf("Parse(%q): command is a %T", src, outer.Cmd)
+		}
+		// Descend to the leftmost statement of the pipeline.
+		x := bc.X
+		for {
+			inner, ok := x.Cmd.(*syntax.BinaryCmd)
+			if !ok {
+				break
+			}
+			x = inner.X
+		}
+		if x.Negated {
+			t.Errorf("Parse(%q): the first command's statement is negated too", src)
+		}
+		if span := src[x.Pos().Offset():x.End().Offset()]; strings.HasPrefix(span, "!") {
+			t.Errorf("Parse(%q): the first command's statement spans %q (Pos %s); it should start at its command", src, span, x.Pos())
+		}
+	}
+}
