+// sh/17: when a compound command's body ends in `&` and its closing keyword
+// carries a redirect, the `;` (or newline) before the following `then`/`do`
+// is dropped: `if { true & } <x1; then true; fi` prints as
+// `if { true & } <x1 then true; fi`, which bash rejects and the parser reads
+// back with `then` as a word.
+func TestHegelPinThenKeepsItsSeparator(t *testing.T) {
+	for _, src := range []string{
+		"if { true & } <x1; then true; fi\n",
+		"if while b; do true & done <x1; then true; fi\n",
+		"while while b\ndo\ntrue &\ndone <x1; do\ntrue\ndone\n",
+		"(\n! if a |& while $(! $(! `echo a` true) true)b true\ndo\n! true &\ndone <<< a,b; then\ntrue\nfi &\n) >> bb <<- 'EOF' &\nEOF\n",
+	} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out := defaultPrint(f)
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Errorf("%q prints as %q, which does not parse: %v", src, out, err)
+			continue
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("%q prints as %q, a different program", src, out)
+		}
+		if ok, msg := shellAccepts(syntax.LangBash, out); !ok {
+			t.Errorf("%q prints as %q, which bash rejects: %s", src, out, msg)
+		}
+	}
+}
+
+// sh/18: with SingleLine, nothing separates a case statement with items from
+// the statement after it: `case a in a) b ;; esac; c` prints as
+// `case a in a) b ;; esac c`.
+func TestHegelPinSingleLineSeparatesStatementsAfterCase(t *testing.T) {
+	for _, src := range []string{
+		"case a in a) b ;; esac; c\n",
+		"case a in\na) b ;;\nesac\nc\n",
+		"x=$(case a in a) b ;; esac; c)\n",
+		"if case a in a) b ;; esac; then c; fi\n",
+		"case a in b) c ;; esac <<EOF\nbody\nEOF\ntrue\n",
+	} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.SingleLine(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Errorf("SingleLine print of %q is %q, which does not parse: %v", src, out, err)
+			continue
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("SingleLine print of %q is %q, a different program", src, out)
+		}
+		if ok, msg := shellAccepts(syntax.LangBash, out); !ok {
+			t.Errorf("SingleLine print of %q is %q, which bash rejects: %s", src, out, msg)
+		}
+	}
+}
+
+// sh/19: with SingleLine, a loop or conditional whose body ends in `&` is
+// followed by the next statement with no separator after `done`/`fi`.
+func TestHegelPinSingleLineSeparatesAfterBackgroundBodies(t *testing.T) {
+	for _, src := range []string{"while a; do\nb\n! c &\ndone; d | e\n", "while a; do b & done; c\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.SingleLine(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		if _, err := syntax.NewParser().Parse(strings.NewReader(out), ""); err != nil {
+			t.Errorf("SingleLine print of %q is %q, which does not parse: %v", src, out, err)
+		}
+	}
+}
+
+// sh/20: a unary sign followed by an increment of the same sign is printed
+// glued, `$((+ ++x))` as `$((+++x))`, which the parser then rejects; bash
+// evaluates `+++x`, `1+++x`, `++ +x` and `+++1` (as 2, 3, 1 and 1 with x=1).
+func TestHegelPinArithmeticSignsStayApart(t *testing.T) {
+	for _, src := range []string{"echo $((+ ++x))\n", "echo $((- --x))\n", "echo $((+ +x))\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out := defaultPrint(f)
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Errorf("%q prints as %q, which does not parse: %v", src, out, err)
+			continue
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("%q prints as %q, a different program", src, out)
+		}
+	}
+	for _, src := range []string{"echo $((+++x))\n", "echo $((1+++x))\n", "echo $((++ +x))\n", "echo $((+++1))\n"} {
+		if ok, _ := shellAccepts(syntax.LangBash, src); !ok {
+			t.Fatalf("bash rejects %q", src)
+		}
+		if _, err := syntax.NewParser().Parse(strings.NewReader(src), ""); err != nil {
+			t.Errorf("Parse(%q): %v; bash accepts it", src, err)
+		}
+	}
+}
+
+// sh/21: with SingleLine, the comment after the closing word of a compound
+// command that spans lines is moved to a line of its own, after a dangling
+// `;`: `f() {\ntrue\n} # c\ntrue` prints as `f() { true; };\n# c\ntrue`, where
+// the comment now belongs to the next statement (`f() { true; } # c` and
+// `f() {\ntrue\n} >x # c` keep it).
+func TestHegelPinSingleLineKeepsTrailingComments(t *testing.T) {
+	for _, src := range []string{"f() {\ntrue\n} # c\ntrue\n", "if a; then\nb\nfi # c\ntrue\n", "(\ntrue\n) # c\n"} {
+		f, err := syntax.NewParser(syntax.KeepComments(true)).Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.SingleLine(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		f2, err := syntax.NewParser(syntax.KeepComments(true)).Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out, err)
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("SingleLine print of %q is %q, whose comments belong to other statements", src, out)
+		}
+	}
+}
+
+// sh/22: the separator after a case statement is dropped: when a case with a
+// redirect ends a one-line body, `{ case a in a) b ;; esac >x; }` prints as
+// `{ case a in a) b ;; esac >x }` and `while a; do case a in a) b ;; esac >x;
+// done` as `... esac >x done`; when a condition holds a case inside a
+// substitution, `if $(case a in a) esac); then ]; fi` prints as
+// `if $(case a in a) ;; esac) then ]; fi`. bash rejects them all (the parser
+// reads them back).
+func TestHegelPinCaseRedirectsKeepTheirSeparator(t *testing.T) {
+	for _, src := range []string{
+		"{ case a in a) b ;; esac >x; }\n",
+		"f() { case a in a) b ;; esac 2>&1; }\n",
+		"while a; do case a in a) b ;; esac >x; done\n",
+		"if a; then case a in a) b ;; esac >x; fi\n",
+		"if $(case a in a) esac); then ]; fi\n",
+		"while x=$(case $a in b) c ;; esac) y; do d; done\n",
+	} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out := defaultPrint(f)
+		if ok, msg := shellAccepts(syntax.LangBash, out); !ok {
+			t.Errorf("%q prints as %q, which bash rejects: %s", src, out, msg)
+		}
+		if ok, msg := shellAccepts(syntax.LangPOSIX, out); !ok {
+			t.Errorf("%q prints as %q, which dash rejects: %s", src, out, msg)
+		}
+	}
+}
+
+// sh/23: formatting is not idempotent when a redirect before the command
+// name has a substitution ending in `; return` (or exit, break, continue,
+// shift) as its target: `>$(a; return) c` prints as `>$(\n\ta; return\n) c`,
+// which prints as `>$(\n\ta\n\treturn\n) c`; `c >$(a; return)` is stable.
+func TestHegelPinLeadingRedirectsFormatIdempotently(t *testing.T) {
+	for _, src := range []string{">$(a; return) c\n", "2>\"$(a; exit 1)\" c d\n", "{ (>`a; break` c); }\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out1 := defaultPrint(f)
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out1), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out1, err)
+		}
+		if out2 := defaultPrint(f2); out2 != out1 {
+			t.Errorf("%q prints as %q, which prints as %q", src, out1, out2)
+		}
+	}
+}
+
+// sh/24: with RecoverErrors, an assignment whose value is an arithmetic
+// expansion with an invalid operator makes the parser panic in getAssign
+// (`x=$((a b` and `x=$((a b))`: slice bounds out of range; `x+=$((a b`: index
+// out of range). `$((a b` alone recovers, and without RecoverErrors every
+// shape is a plain parse error.
+func TestHegelPinRecoveringParserSurvivesArithmeticAssignments(t *testing.T) {
+	for _, c := range []struct {
+		src  string
+		lang syntax.LangVariant
+	}{{"x=$((a b", syntax.LangBash}, {"x=$((a b))\n", syntax.LangPOSIX}, {"x+=$((a b", syntax.LangBash}, {"x=$[a b", syntax.LangBash}, {"x=a$((a b\n", syntax.LangMirBSDKorn}} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("Parse(%q, %s, RecoverErrors(1)) panics: %v", c.src, langName(c.lang), r)
+				}
+			}()
+			_, err := syntax.NewParser(syntax.Variant(c.lang), syntax.RecoverErrors(1)).Parse(strings.NewReader(c.src), "")
+			if err != nil && !strings.Contains(err.Error(), "arithmetic") {
+				t.Logf("Parse(%q): %v", c.src, err)
+			}
+		}()
+	}
+}
+
+// sh/25: Minify prints `a | &>f b` as `a|&>f b`, which reads back as
+// `a |& >f b`: the pipe now carries stderr too. Also with `&>>`.
+func TestHegelPinMinifyKeepsPipesApartFromRedirects(t *testing.T) {
+	for _, src := range []string{"a | &>f b\n", "a | &>>f b\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.Minify(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out, err)
+		}
+		if shapeMinified(f) != shapeMinified(f2) {
+			t.Errorf("minified %q is %q, which is the program %q", src, out, defaultPrint(f2))
+		}
+	}
+}
+
+// sh/26: a command substitution holding a multi-statement subshell prints
+// with a space before its closing parenthesis, `$( (\n\ta\n\tb\n) )`, and
+// that prints without it, `$( (\n\ta\n\tb\n))`; with Minify, `$( (a\nb) )`
+// then `$( (a\nb))`.
+func TestHegelPinSubstitutionsCloseTheSameWayTwice(t *testing.T) {
+	for _, src := range []string{"echo $( (a; b) )\n", "x=$(! (a; b))\n"} {
+		for _, p := range []*syntax.Printer{syntax.NewPrinter(), syntax.NewPrinter(syntax.Minify(true))} {
+			f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+			if err != nil {
+				t.Fatalf("Parse(%q): %v", src, err)
+			}
+			out1, err := printNode(p, f)
+			if err != nil {
+				t.Fatalf("Print: %v", err)
+			}
+			f2, err := syntax.NewParser().Parse(strings.NewReader(out1), "")
+			if err != nil {
+				t.Fatalf("Parse(%q): %v", out1, err)
+			}
+			if out2, _ := printNode(p, f2); out2 != out1 {
+				t.Errorf("%q prints as %q, which prints as %q", src, out1, out2)
+			}
+		}
+	}
+}
diff --git a/syntax/hegel_test.go b/syntax/hegel_test.go
new file mode 100644
index 00000000..2c1f593b
--- /dev/null
+++ b/syntax/hegel_test.go
@@ -0,0 +1,1856 @@
+package syntax_test
+
+// Hegel properties for mvdan.cc/sh/v3/syntax (the Hegel zoo). Oracles: the
+// parser and the printer against each other (a formatted program must parse
+// back to the same tree, format idempotently and stay valid shell), bash and
+// dash (`-n` on every printed program, `printf %s` on Quote's output), the
+// source text (node positions), and the package against itself (the streaming
+// parsers, typedjson, Simplify). Programs are generated from a grammar of
+// shell constructs so that they are valid for the dialect they are parsed in.
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+	"mvdan.cc/sh/v3/expand"
+	"mvdan.cc/sh/v3/syntax"
+	"mvdan.cc/sh/v3/syntax/typedjson"
+)
+
+// ---------------------------------------------------------------------------
+// Harness plumbing (shared with the other Go targets of the zoo).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("SH_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow (E_STOP_TEST on an overrun)
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	letComment         bool // sh/1: after a `let` clause a comment, `|&`, `|[` or `|{` is a parse error (Minify prints the last two)
+	timeBang           bool // sh/2: `time ! cmd` (and `! ! cmd`) are rejected although bash accepts them
+	keepPaddingBang    bool // sh/3: KeepPadding is not idempotent: a statement starting with a redirect grows spaces, a multi-line subshell gets trailing spaces after `(` with space indentation
+	negatedPipeline    bool // sh/4: the first statement of a negated pipeline starts at the `!`
+	hdocBeforeSubst    bool // sh/5: a heredoc body is printed inside a `$( )`, `( )`, `<( )` or backquotes that follow it on the line
+	commentBackslash   bool // sh/6: a comment ending in a backslash swallows the next line into the command
+	hdocComment        bool // sh/7: a comment after a heredoc redirect at the end of a pipeline or and-or list is dropped or moved
+	hdocBeforeTest     bool // sh/8: a `[[ ]]` after a heredoc on the same line prints the delimiter before the body
+	procSubstGlued     bool // sh/9: a process substitution glued to other word parts is printed as a word of its own
+	coprocStmtPos      bool // sh/10: `coproc` mishandles its first word: the statement starts after it, and an assignment there becomes an argument
+	minifyEmptyItem    bool // sh/11: Minify prints the `;;` of an empty last case item as `;`, which does not parse
+	emptyReplPrints    bool // sh/12: `${x/}` prints as `${x//}`, which means something else and grows a slash per pass
+	emptyCaseItemEnd   bool // sh/13: a case item with no body and no terminator has an invalid End
+	functionSubshell   bool // sh/14: `function f ( ... )` (a subshell body) is rejected although bash accepts it
+	dollarBackquote    bool // sh/15: backquotes right after a literal `$` print as `$$(...)`, the PID
+	singleLineBgClose  bool // sh/19: SingleLine puts nothing between a `done`/`fi`/`}` closing a body that ends in `&` and the next statement
+	singleLineEsac     bool // sh/18: SingleLine puts nothing between `esac` (of a case with items) and the next statement
+	thenAfterRedirect  bool // sh/17: inside a compound with a pending heredoc, `done <redirect>; then` loses its `;`
+	arithGluedSign     bool // sh/20: `$((+ ++x))` prints as `$((+++x))`, which the parser rejects (bash accepts both)
+	singleLineComment  bool // sh/21: SingleLine moves the comment after a multi-line compound command to its own line, after a dangling `;`
+	esacRedirectClose  bool // sh/22: the separator after a case statement is dropped: before `}`/`done`/`fi` after `esac <redirect>`, before `then`/`do` when the condition holds a case in a substitution
+	redirReturn        bool // sh/23: `>$(a; return) c` formats to a multi-line substitution keeping `a; return` on one line, then splits it
+	recoverArithAssign bool // sh/24: RecoverErrors panics on an assignment whose arithmetic expansion has a bad operator (`x=$((a b`)
+	minifyPipeRedirect bool // sh/25: Minify prints `a | &>f b` as `a|&>f b`, which is `a |& >f b`
+	substSubshell      bool // sh/26: `$( (a; b) )` prints with `) )`, then with `))`
+	quotesInQuotedExp  bool // sh/16: Simplify single-quotes a literal inside a double-quoted `${x:-"..."}`, where the quotes are literal
+}{letComment: true, timeBang: true, keepPaddingBang: true, negatedPipeline: true, hdocBeforeSubst: true, commentBackslash: true, hdocComment: true, hdocBeforeTest: true, procSubstGlued: true, coprocStmtPos: true, minifyEmptyItem: true, emptyReplPrints: true, emptyCaseItemEnd: true, functionSubshell: true, dollarBackquote: true, quotesInQuotedExp: true, thenAfterRedirect: true, singleLineEsac: true, singleLineBgClose: true, arithGluedSign: true, singleLineComment: true, esacRedirectClose: true, redirReturn: true, recoverArithAssign: true, minifyPipeRedirect: true, substSubshell: true}
+
+// bgBeforeClose matches a body whose last statement ends in `&` before its closing word.
+var bgBeforeClose = regexp.MustCompile(`&\s*\n\s*(done|fi|esac|\}|\))`)
+
+// closeFdGlued matches `>&-` or `<&-` glued to more characters (`>&-=`), which
+// bash rejects and this parser reads as a redirect to the word `-=`; not recorded.
+var closeFdGlued = regexp.MustCompile(`[<>]&-[^\s;&|)]`)
+
+// closeComment matches a comment right after the closing word of a compound
+// command that spans lines.
+var closeComment = regexp.MustCompile(`(^|\n)\s*(\}|fi|done|esac|\))\s*#`)
+
+// redirReturn matches a redirect whose target is a substitution with a
+// statement list ending in `return`, `exit`, `break`, `continue` or `shift`.
+var redirReturn = regexp.MustCompile("[<>]&?\"?(\\$\\(|`)[^)`]*;\\s*(return|exit|break|continue|shift)\\b")
+
+// openParenLine matches a parenthesis that ends its line: a multi-line
+// subshell or substitution.
+var openParenLine = regexp.MustCompile(`\(\s*(#[^\n]*)?\n`)
+
+// arithAssign matches an assignment whose value holds an arithmetic expansion.
+var arithAssign = regexp.MustCompile(`(^|[\s;|&({])\w+(\[[^]]*\])?\+?=[^\s]*\$(\(\(|\[)`)
+
+// pipeRedirect matches a `|` followed by a command starting with `&>`.
+var pipeRedirect = regexp.MustCompile(`\|\s*&>`)
+
+// substSubshell matches a command substitution that starts with a subshell.
+var substSubshell = regexp.MustCompile(`\$\(\s*(!\s*)?\(`)
+
+// negation matches a `!` that negates a command.
+var negation = regexp.MustCompile(`(^|[\s;|&({])!\s`)
+
+// coprocAssign matches a coproc whose command has an assignment word (the
+// printer moves leading redirects after the assignments, which puts one first).
+var coprocAssign = regexp.MustCompile(`(^|\s)\w+(\[[^]]*\])?\+?=`)
+
+// doneRedirectThen matches `done <redirect>; then` (or `; do`).
+var doneRedirectThen = regexp.MustCompile(`(done|fi|esac|\)|\})\s+[^;\n]*[<>][^;\n]*;\s*(then|do)\b`)
+
+// emptyLastItem matches a case item without a body ending the case clause.
+var emptyLastItem = regexp.MustCompile(`\)\s*;[;&]+\s*esac`)
+
+// emptyRepl matches a `${x/}` expansion: a single slash and nothing after it.
+var emptyRepl = regexp.MustCompile(`\$\{[^{}/]*[^/]/\}`)
+
+// hdocPrinterShape reports whether a line of source has a shape the printer
+// mangles: with a heredoc (sh/5, sh/8), a command substitution, subshell,
+// process substitution, backquotes or `[[` after the first `<<`; or (sh/17)
+// a `done <redirect>; then`.
+func hdocPrinterShape(line string) bool {
+	if Known.thenAfterRedirect && doneRedirectThen.MatchString(line) {
+		return true // sh/17 needs no heredoc
+	}
+	i := strings.Index(line, "<<")
+	if i < 0 {
+		return false
+	}
+	rest := line[i+2:]
+	return (Known.hdocBeforeSubst && strings.ContainsAny(rest, "(`")) || (Known.hdocBeforeTest && strings.Contains(rest, "[["))
+}
+
+// leadingRedirect matches a redirect operator that opens a statement after
+// `!`, a pipe, `&&`, `||`, `;`, an opening bracket or a keyword.
+var leadingRedirect = regexp.MustCompile(`(^|\n|[!|&;({]|\b(then|do|else|while|until|if|elif|time|-p))\s*(\{\w+\}|\d*)[<>&]`)
+
+// ---------------------------------------------------------------------------
+// The shells as oracles.
+
+var shellPath = map[syntax.LangVariant]string{}
+
+func init() {
+	if p, err := exec.LookPath("bash"); err == nil {
+		shellPath[syntax.LangBash] = p
+	}
+	if p, err := exec.LookPath("dash"); err == nil {
+		shellPath[syntax.LangPOSIX] = p
+	}
+}
+
+// shellAccepts runs the dialect's shell with -n on src (a syntax check, nothing
+// runs). Without the shell it reports true and an empty message.
+func shellAccepts(lang syntax.LangVariant, src string) (bool, string) {
+	sh, found := shellPath[lang]
+	if !found {
+		return true, ""
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, sh, "-n")
+	cmd.Stdin = strings.NewReader(src)
+	cmd.Dir = os.TempDir()
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	return err == nil, strings.TrimSpace(stderr.String())
+}
+
+// shellPrintf runs `printf %s <quoted>` in the dialect's shell and returns
+// what it printed. The caller has checked that quoted is a single literal word.
+func shellPrintf(lang syntax.LangVariant, quoted string) (string, bool) {
+	sh, found := shellPath[lang]
+	if !found {
+		return "", false
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, sh, "-c", "printf %s "+quoted)
+	cmd.Dir = os.TempDir()
+	out, err := cmd.Output()
+	if err != nil {
+		return "error: " + err.Error(), true
+	}
+	return string(out), true
+}
+
+// ---------------------------------------------------------------------------
+// Helpers around the package.
+
+func parse(lang syntax.LangVariant, src string, keepComments bool) (*syntax.File, error) {
+	return syntax.NewParser(syntax.Variant(lang), syntax.KeepComments(keepComments)).Parse(strings.NewReader(src), "")
+}
+
+func printNode(p *syntax.Printer, node syntax.Node) (string, error) {
+	var buf bytes.Buffer
+	err := p.Print(&buf, node)
+	return buf.String(), err
+}
+
+func defaultPrint(node syntax.Node) string {
+	s, err := printNode(syntax.NewPrinter(), node)
+	if err != nil {
+		return "print error: " + err.Error()
+	}
+	return s
+}
+
+// shape is the typed JSON of a node with every position removed: two nodes
+// with the same shape are the same tree up to where it was in the source.
+func shape(node syntax.Node) string { return shapeMode(node, false) }
+
+// shapeMinified also ignores what Minify is documented to shorten: `${x}`
+// becomes `$x` (ParamExp.Short), and the last case item's `;&` or `;;&`, which
+// has nothing left to fall through to, becomes `;;` or nothing.
+func shapeMinified(node syntax.Node) string { return shapeMode(node, true) }
+
+func shapeMode(node syntax.Node, minified bool) string {
+	var buf bytes.Buffer
+	if err := typedjson.Encode(&buf, node); err != nil {
+		return "encode error: " + err.Error()
+	}
+	var v any
+	if err := json.Unmarshal(buf.Bytes(), &v); err != nil {
+		return "decode error: " + err.Error()
+	}
+	out, err := json.Marshal(stripPos(v, minified))
+	if err != nil {
+		return "marshal error: " + err.Error()
+	}
+	return string(out)
+}
+
+func isPos(m map[string]any) bool {
+	if len(m) != 3 {
+		return false
+	}
+	_, a := m["Offset"]
+	_, b := m["Line"]
+	_, c := m["Col"]
+	return a && b && c
+}
+
+// Two normalisations the formatter makes and the tree comparison must not
+// see: trailing whitespace of a comment is dropped, and the tabs before a
+// `<<-` heredoc's delimiter, which the parser keeps at the end of the body,
+// are dropped with the body's re-indentation.
+func normalise(x map[string]any) {
+	delete(x, "Backquotes") // the printer writes every command substitution as $( )
+	if text, ok := x["Text"].(string); ok && len(x) <= 2 {
+		if text = strings.TrimRight(text, " \t"); text == "" {
+			delete(x, "Text") // typedjson omits empty strings
+		} else {
+			x["Text"] = text
+		}
+	}
+	if op, _ := x["Op"].(string); op == "<<-" {
+		if hdoc, ok := x["Hdoc"].(map[string]any); ok {
+			parts, _ := hdoc["Parts"].([]any)
+			for i, part := range parts {
+				lit, ok := part.(map[string]any)
+				if !ok || lit["Type"] != "Lit" {
+					continue
+				}
+				val, _ := lit["Value"].(string)
+				val = strings.ReplaceAll(val, "\n\t", "\n")
+				for strings.Contains(val, "\n\t") {
+					val = strings.ReplaceAll(val, "\n\t", "\n")
+				}
+				if i == 0 {
+					val = strings.TrimLeft(val, "\t")
+				}
+				if i == len(parts)-1 {
+					val = strings.TrimRight(val, "\t")
+				}
+				lit["Value"] = val
+			}
+			kept := parts[:0:0]
+			for _, part := range parts {
+				if lit, ok := part.(map[string]any); ok && lit["Type"] == "Lit" && lit["Value"] == "" {
+					continue
+				}
+				kept = append(kept, part)
+			}
+			if len(kept) == 0 {
+				delete(x, "Hdoc")
+			} else {
+				hdoc["Parts"] = kept
+			}
+		}
+	}
+}
+
+func stripPos(v any, minified bool) any {
+	switch x := v.(type) {
+	case map[string]any:
+		for k, val := range x {
+			if m, ok := val.(map[string]any); ok && isPos(m) {
+				delete(x, k)
+				continue
+			}
+			x[k] = stripPos(val, minified)
+		}
+		normalise(x)
+		if minified {
+			delete(x, "Short")
+			if items, ok := x["Items"].([]any); ok && x["Type"] == "CaseClause" && len(items) > 0 {
+				if last, ok := items[len(items)-1].(map[string]any); ok {
+					last["Op"] = ";;"
+				}
+			}
+		}
+		return x
+	case []any:
+		for i := range x {
+			x[i] = stripPos(x[i], minified)
+		}
+		return x
+	}
+	return v
+}
+
+// firstDiff describes where two strings first differ.
+func firstDiff(a, b string) string {
+	i := 0
+	for i < len(a) && i < len(b) && a[i] == b[i] {
+		i++
+	}
+	lo := max(0, i-60)
+	return fmt.Sprintf("at byte %d:\n  a: %q\n  b: %q", i, a[lo:min(len(a), i+60)], b[lo:min(len(b), i+60)])
+}
+
+// lineCol computes the 1-based line and byte column of offset off in src.
+func lineCol(src string, off int) (int, int) {
+	before := src[:off]
+	return 1 + strings.Count(before, "\n"), off - strings.LastIndex(before, "\n")
+}
+
+func langName(lang syntax.LangVariant) string {
+	if lang == syntax.LangBash {
+		return "bash"
+	}
+	return "posix"
+}
+
+// ---------------------------------------------------------------------------
+// A generator of shell programs.
+
+type gen struct {
+	tc        hegel.TestCase
+	bash      bool     // bash dialect; otherwise POSIX sh (checked by dash)
+	comments  bool     // whether to sprinkle comments
+	depth     int      // nesting of compound commands
+	inline    int      // >0: the text must stay on one line: no heredocs, no comments
+	noBq      int      // >0: inside backquotes, no nested backquotes
+	hdocs     []string // heredoc bodies pending for the current line
+	budget    int      // commands left to generate; minimal forms once spent
+	noBang    int      // >0: no `!` at the start of a pipeline (inside `time`)
+	afterPipe bool     // the command follows a `|`: bash reads `time` there as a plain word
+	sawLet    bool     // the current line generated a `let` clause
+	inDq      int      // >0: inside double quotes
+	noDqInExp bool     // sh/16: no double-quoted words inside expansions within double quotes
+}
+
+func newGen(tc hegel.TestCase, bash bool) *gen {
+	return &gen{tc: tc, bash: bash, comments: chance(tc, 30), budget: 40}
+}
+
+func (g *gen) lang() syntax.LangVariant {
+	if g.bash {
+		return syntax.LangBash
+	}
+	return syntax.LangPOSIX
+}
+
+func (g *gen) c(pct int) bool        { return chance(g.tc, pct) }
+func (g *gen) i(lo, hi int) int      { return n(g.tc, lo, hi) }
+func (g *gen) s(xs ...string) string { return pick(g.tc, xs...) }
+func (g *gen) varName() string       { return g.s("x", "y", "_z", "ab1", "v2") }
+func (g *gen) comment() string {
+	if g.c(15) {
+		return "#"
+	}
+	texts := []string{"c", "note", "TODO x", "a b", "$x 'q'", "#!"}
+	if !Known.commentBackslash {
+		texts = append(texts, `a\`)
+	}
+	return "# " + g.s(texts...)
+}
+func (g *gen) sep(inline, multi string) string {
+	if g.inline > 0 {
+		return inline
+	}
+	return multi
+}
+
+// program is one to five lines of statements.
+func (g *gen) program() string {
+	var sb strings.Builder
+	for i, k := 0, g.i(1, 5); i < k; i++ {
+		if g.comments && g.c(15) {
+			sb.WriteString(g.comment() + "\n")
+		}
+		if g.c(10) {
+			sb.WriteString("\n")
+		}
+		sb.WriteString(g.line())
+	}
+	return sb.String()
+}
+
+// line is one or more and-or lists separated by ; or &, an optional trailing
+// comment, the newline, and then the bodies of the heredocs the line opened.
+// Lines with a heredoc followed by a construct the printer mangles (sh/5,
+// sh/8) are generated again, a few times, before falling back to `true`.
+func (g *gen) line() string {
+	saved := g.hdocs
+	for try := 0; try < 4; try++ {
+		g.hdocs = nil
+		g.sawLet = false
+		var sb strings.Builder
+		sb.WriteString(g.andOr())
+		for i := 0; i < 2 && g.c(25); i++ {
+			sb.WriteString(g.s("; ", " & ", ";"))
+			sb.WriteString(g.andOr())
+		}
+		if g.c(20) {
+			sb.WriteString(g.s(";", " &"))
+		}
+		text := sb.String()
+		if hdocPrinterShape(text) || (Known.redirReturn && redirReturn.MatchString(text)) || (Known.substSubshell && substSubshell.MatchString(text)) {
+			continue
+		}
+		if i := strings.Index(text, "<<"); len(g.hdocs) > 0 && i >= 0 && strings.Contains(text[i:], "\n") {
+			continue // the bodies would have to follow the first newline, inside the compound
+		}
+		// sh/7: no comment after a heredoc unless the line is one simple command.
+		if g.comments && g.c(20) && !(Known.letComment && g.sawLet) &&
+			!(Known.hdocComment && len(g.hdocs) > 0 && strings.ContainsAny(text, "|&;")) {
+			sb.WriteString(" " + g.comment())
+		}
+		sb.WriteString("\n")
+		for _, h := range g.hdocs {
+			sb.WriteString(h)
+		}
+		g.hdocs = saved
+		return sb.String()
+	}
+	g.hdocs = saved
+	return "true\n"
+}
+
+// stmts is the body of a compound command: one to three lines.
+func (g *gen) stmts() string {
+	g.depth++
+	defer func() { g.depth-- }()
+	var sb strings.Builder
+	for i, k := 0, g.i(1, 3); i < k; i++ {
+		sb.WriteString(g.line())
+	}
+	return sb.String()
+}
+
+// inlineList is "a; b" on one line, without heredocs or comments.
+func (g *gen) inlineList() string {
+	g.inline++
+	g.depth++
+	defer func() { g.inline--; g.depth-- }()
+	parts := []string{g.andOr()}
+	for i := 0; i < 2 && g.c(25); i++ {
+		parts = append(parts, g.andOr())
+	}
+	return strings.Join(parts, "; ")
+}
+
+func (g *gen) andOr() string {
+	var sb strings.Builder
+	sb.WriteString(g.pipeline())
+	for i := 0; i < 2 && g.c(25); i++ {
+		sb.WriteString(g.s(" && ", " || "))
+		sb.WriteString(g.pipeline())
+	}
+	return sb.String()
+}
+
+func (g *gen) pipeline() string {
+	var sb strings.Builder
+	if g.c(10) && !(Known.timeBang && g.noBang > 0) {
+		sb.WriteString("! ")
+	}
+	last := g.command()
+	sb.WriteString(last)
+	for i := 0; i < 2 && g.c(20); i++ {
+		op := " | "
+		if g.bash && g.c(20) && !(Known.letComment && strings.HasPrefix(last, "let ")) {
+			op = " |& "
+		}
+		sb.WriteString(op)
+		g.afterPipe = true
+		last = g.command()
+		sb.WriteString(last)
+	}
+	return sb.String()
+}
+
+func (g *gen) command() string {
+	afterPipe := g.afterPipe
+	g.afterPipe = false
+	g.budget--
+	if g.budget <= 0 {
+		return "true"
+	}
+	if g.depth >= 3 || g.c(55) {
+		return g.simple()
+	}
+	r := g.i(1, 100)
+	switch {
+	case r <= 12:
+		return g.block("(", ")") + g.trailingRedirs()
+	case r <= 24:
+		return g.block("{", "}") + g.trailingRedirs()
+	case r <= 38:
+		return g.ifClause() + g.trailingRedirs()
+	case r <= 48:
+		return g.loop() + g.trailingRedirs()
+	case r <= 58:
+		return g.forClause() + g.trailingRedirs()
+	case r <= 68:
+		if Known.esacRedirectClose {
+			return g.caseClause()
+		}
+		return g.caseClause() + g.trailingRedirs()
+	case r <= 78:
+		return g.funcDecl()
+	}
+	if !g.bash {
+		return g.simple()
+	}
+	switch g.i(1, 6) {
+	case 1:
+		return "[[ " + g.testExpr(0) + " ]]"
+	case 2:
+		return "((" + g.arith(0) + "))"
+	case 3:
+		return g.declClause()
+	case 4:
+		g.noBang++
+		var s string
+		if afterPipe {
+			s = "time " + g.s("", "-p ") + g.s("true", "echo a", "cat file") // bash: `a | time (b)` and `a | time x=()` are syntax errors
+		} else {
+			s = "time " + g.s("", "-p ") + g.pipeline()
+		}
+		g.noBang--
+		return s
+	case 5:
+		if g.c(50) {
+			cmd := g.simple()
+			if Known.coprocStmtPos && coprocAssign.MatchString(cmd) {
+				cmd = "echo a"
+			}
+			return "coproc " + cmd
+		}
+		return "coproc " + g.s("co", "NAME") + " " + g.block("{", "}")
+	default:
+		k := g.i(1, 3)
+		parts := make([]string, k)
+		for i := range parts {
+			parts[i] = g.s(`"x = 1"`, "x=1", "y++", "x+=2", "'a & b'", `"z = `+g.arithLeaf()+`"`)
+		}
+		g.sawLet = true
+		return "let " + strings.Join(parts, " ")
+	}
+}
+
+func (g *gen) trailingRedirs() string {
+	var sb strings.Builder
+	for i, k := 0, g.i(0, 2); i < k; i++ {
+		sb.WriteString(" " + g.redirect())
+	}
+	return g.appendHeredoc(sb.String())
+}
+
+// appendHeredoc sometimes adds a heredoc redirect (bodies go after the line).
+func (g *gen) appendHeredoc(s string) string {
+	if g.inline == 0 && len(g.hdocs) < 4 && g.c(12) { // bash allows 16 heredocs per line
+		s += " " + g.heredoc()
+	}
+	return s
+}
+
+// block is a compound body between open and close: multi-line with its own
+// lines, or "open a; b; close" on one line.
+func (g *gen) block(open, close string) string {
+	if g.inline > 0 || g.c(30) {
+		return open + " " + g.inlineList() + "; " + close
+	}
+	return open + "\n" + g.stmts() + close
+}
+
+// inlineCond is a one-line condition of if/while.
+func (g *gen) inlineCond() string {
+	s := g.inlineList()
+	if Known.esacRedirectClose && strings.Contains(s, "esac") {
+		return "true" // sh/22: a case inside the condition's substitution eats the `;` before then/do
+	}
+	return s
+}
+
+// condLine is the condition of if/while: an and-or list followed by "; " or
+// by a newline (and the heredocs it opened).
+func (g *gen) condLine() string {
+	saved := g.hdocs
+	g.hdocs = nil
+	s := g.andOr()
+	if i := strings.Index(s, "<<"); hdocPrinterShape(s) || (Known.redirReturn && redirReturn.MatchString(s)) || (Known.substSubshell && substSubshell.MatchString(s)) || (Known.esacRedirectClose && strings.Contains(s, "esac")) || (len(g.hdocs) > 0 && i >= 0 && strings.Contains(s[i:], "\n")) {
+		g.hdocs = nil
+		s = "true"
+	}
+	if len(g.hdocs) > 0 || g.c(30) {
+		s += "\n" + strings.Join(g.hdocs, "")
+	} else {
+		s += "; "
+	}
+	g.hdocs = saved
+	return s
+}
+
+func (g *gen) ifClause() string {
+	if g.inline > 0 || g.c(30) {
+		s := "if " + g.inlineCond() + "; then " + g.inlineList() + "; "
+		if g.c(30) {
+			s += "elif " + g.inlineCond() + "; then " + g.inlineList() + "; "
+		}
+		if g.c(40) {
+			s += "else " + g.inlineList() + "; "
+		}
+		return s + "fi"
+	}
+	s := "if " + g.condLine() + "then\n" + g.stmts()
+	for i := 0; i < 2 && g.c(25); i++ {
+		s += "elif " + g.condLine() + "then\n" + g.stmts()
+	}
+	if g.c(40) {
+		s += "else\n" + g.stmts()
+	}
+	return s + "fi"
+}
+
+func (g *gen) loop() string {
+	kw := g.s("while", "until")
+	if g.inline > 0 || g.c(30) {
+		return kw + " " + g.inlineCond() + "; do " + g.inlineList() + "; done"
+	}
+	return kw + " " + g.condLine() + "do\n" + g.stmts() + "done"
+}
+
+func (g *gen) forClause() string {
+	head := "for " + g.varName()
+	switch r := g.i(1, 100); {
+	case g.bash && r <= 20:
+		head = "for ((" + g.s("", g.arithAssign(1)) + "; " + g.s("", g.arith(1)) + "; " + g.s("", g.arith(1)) + "))"
+	case r <= 70:
+		head += " in " + g.wordList(1, 3)
+	case r <= 85:
+		head += " in"
+	}
+	sep := "; "
+	if g.inline == 0 && g.c(30) {
+		sep = "\n"
+	}
+	return head + sep + g.block("do", "done")
+}
+
+func (g *gen) pattern() string {
+	return g.s("a", "*", "?x", "[ab]", "a*", `"q"`, "'s p'", "$x", "*.sh", "[!a-z]", `\*`, "${y}", "a$(b)")
+}
+
+func (g *gen) caseClause() string {
+	multi := g.inline == 0 && g.c(70)
+	s := "case " + g.word() + " in"
+	if multi {
+		s += "\n"
+	} else {
+		s += " "
+	}
+	k := g.i(0, 3)
+	for i := 0; i < k; i++ {
+		pat := g.pattern()
+		for j := 0; j < 2 && g.c(30); j++ {
+			pat += g.s("|", " | ") + g.pattern()
+		}
+		if g.c(20) {
+			pat = "(" + pat
+		}
+		term := ";;"
+		if g.bash && g.c(30) {
+			term = g.s(";&", ";;&")
+		}
+		last := i == k-1
+		if multi {
+			body := ""
+			if g.c(80) {
+				body = g.stmts()
+			}
+			if last && g.c(30) {
+				s += pat + ")\n" + body
+			} else {
+				s += pat + ")\n" + body + term + "\n"
+			}
+		} else {
+			if last && g.c(30) {
+				s += pat + ") " + g.inlineList() + "; "
+			} else {
+				s += pat + ") " + g.inlineList() + " " + term + " "
+			}
+		}
+	}
+	return s + "esac"
+}
+
+func (g *gen) funcDecl() string {
+	name := g.s("f", "g1", "_h", "my_func")
+	if g.bash && g.c(10) {
+		name = "foo-bar"
+	}
+	var body string
+	if g.c(80) {
+		body = g.block("{", "}")
+	} else {
+		body = g.block("(", ")")
+	}
+	if g.bash && g.c(40) {
+		if g.c(50) && !(Known.functionSubshell && strings.HasPrefix(body, "(")) {
+			return "function " + name + " " + body
+		}
+		return "function " + name + "() " + body
+	}
+	return name + "() " + body
+}
+
+func (g *gen) testWord() string {
+	switch g.i(1, 5) {
+	case 1:
+		return g.dq()
+	case 2:
+		return g.param()
+	case 3:
+		return g.cmdSubst()
+	default:
+		return g.s("a", "b", "1", "0", "a*", "x-y", "$x", "./f", "n")
+	}
+}
+
+func (g *gen) testExpr(d int) string {
+	if d >= 2 || g.c(50) {
+		if g.c(50) {
+			return g.s("-n", "-z", "-f", "-d", "-e", "-v", "-r", "-x", "-s") + " " + g.testWord()
+		}
+		if g.c(25) {
+			return g.testWord() + " =~ " + g.s("^a.*b$", "[0-9]+", `"$re"`, `a\ b`, "x?", "^[[:alpha:]]")
+		}
+		return g.testWord() + " " + g.s("==", "!=", "=", "<", ">", "-eq", "-ne", "-lt", "-gt", "-le", "-ge", "-nt", "-ot", "-ef") + " " + g.testWord()
+	}
+	switch g.i(1, 4) {
+	case 1:
+		return "! " + g.testExpr(d+1)
+	case 2:
+		return "( " + g.testExpr(d+1) + " )"
+	default:
+		return g.testExpr(d+1) + g.s(" && ", " || ") + g.testExpr(d+1)
+	}
+}
+
+func (g *gen) declClause() string {
+	kw := g.s("declare", "local", "export", "readonly", "typeset")
+	s := kw
+	if kw == "declare" || kw == "typeset" || kw == "local" {
+		for i, k := 0, g.i(0, 2); i < k; i++ {
+			s += " " + g.s("-a", "-A", "-i", "-r", "-x", "-n", "-g", "-p", "-l", "-u")
+		}
+	}
+	for i, k := 0, g.i(1, 3); i < k; i++ {
+		switch g.i(1, 4) {
+		case 1:
+			s += " " + g.varName()
+		case 2:
+			s += " " + g.dq()
+		default:
+			if kw == "export" {
+				s += " " + g.varName() + "=" + g.word()
+			} else {
+				s += " " + g.assign(true)
+			}
+		}
+	}
+	return s
+}
+
+// simple is a simple command: assignments, a name and arguments, redirects.
+func (g *gen) simple() string {
+	var toks []string
+	named := g.c(85)
+	for i, k := 0, g.i(0, 2); i < k; i++ {
+		toks = append(toks, g.assign(!named))
+	}
+	if named || len(toks) == 0 {
+		if g.c(8) {
+			toks = append(toks, "[", g.word(), g.s("=", "!=", "-eq", "-lt"), g.word(), "]")
+		} else {
+			toks = append(toks, g.s("echo", "cat", "foo", "printf", ":", "true", "test", "cmd_x", "./run", "$x", `"$y"`, "exit", "return", "break"))
+			for i, k := 0, g.i(0, 3); i < k; i++ {
+				toks = append(toks, g.word())
+			}
+			if g.c(5) {
+				toks = append(toks, g.s("if", "done", "in", "esac", "fi", "then", "function", "select"))
+			}
+		}
+	}
+	for i, k := 0, g.i(0, 2); i < k; i++ {
+		at := g.i(0, len(toks))
+		if !named {
+			at = len(toks) // bash: `x=a >f y=(a)` is a syntax error
+		}
+		toks = append(toks[:at], append([]string{g.redirect()}, toks[at:]...)...)
+	}
+	return g.appendHeredoc(strings.Join(toks, " "))
+}
+
+// assign is name=value; arrays and appends only in bash, arrays only when the
+// assignment stands alone (arrays: true).
+func (g *gen) assign(arrays bool) string {
+	name := g.varName()
+	value := func() string {
+		w := g.word()
+		if Known.procSubstGlued && (strings.HasPrefix(w, "<(") || strings.HasPrefix(w, ">(")) {
+			w = g.lit()
+		}
+		return w
+	}
+	if g.bash {
+		r := g.i(1, 100)
+		switch {
+		case r <= 15:
+			return name + "+=" + value()
+		case arrays && r <= 30:
+			return name + "[" + g.s("1", "$i", "i+1", "a", "0") + "]=" + value()
+		case arrays && r <= 45:
+			list := g.wordList(0, 3)
+			if strings.HasPrefix(list, "[") || strings.Contains(list, " [") {
+				list = "a b" // `x=([x])` is rejected deliberately (`[x]` must be followed by `=`)
+			}
+			return name + "=(" + list + ")"
+		case arrays && r <= 50:
+			return name + "=([a]=1 [b]=" + g.word() + ")"
+		}
+	}
+	if g.c(15) {
+		return name + "="
+	}
+	return name + "=" + value()
+}
+
+func (g *gen) wordList(lo, hi int) string {
+	k := g.i(lo, hi)
+	ws := make([]string, k)
+	for i := range ws {
+		ws[i] = g.word()
+	}
+	return strings.Join(ws, " ")
+}
+
+// redirect is a redirection other than a heredoc.
+func (g *gen) redirect() string {
+	var op string
+	if g.bash && g.c(25) {
+		op = g.s("&>", "&>>", "<<<", "{fd}>", "{fd}<", "{fd}>&-", "2>&1", ">&2")
+	} else {
+		op = g.s(">", ">>", "<", "2>", ">&2", "2>&1", ">|", "<>", "<&-", ">&-", "1>&2", "<&0")
+	}
+	if strings.HasSuffix(op, "&2") || strings.HasSuffix(op, "&1") || strings.HasSuffix(op, "&0") || strings.HasSuffix(op, "&-") {
+		return op
+	}
+	w := g.word()
+	if strings.HasPrefix(w, "<") || strings.HasPrefix(w, ">") || strings.HasPrefix(w, "(") {
+		return op + " " + w
+	}
+	return op + g.s("", " ") + w
+}
+
+// heredoc returns the redirect word and queues its body for the line.
+func (g *gen) heredoc() string {
+	op := g.s("<<", "<<-")
+	delim := g.s("EOF", "'EOF'", `"EOF"`, `E\OF`, "eof", "END_OF_TEXT")
+	raw := strings.NewReplacer("'", "", `"`, "", `\`, "").Replace(delim)
+	var body strings.Builder
+	for i, k := 0, g.i(0, 3); i < k; i++ {
+		l := g.s("body", "$x", "  a b", "\ttab", "'q'", "$(cmd)", "", `\$x`, "a `b`", "${x:-y}", "$((1+2))", `"dq"`)
+		if op == "<<-" && g.c(40) {
+			l = "\t" + l
+		}
+		body.WriteString(l + "\n")
+	}
+	if op == "<<-" && g.c(30) {
+		body.WriteString("\t")
+	}
+	body.WriteString(raw + "\n")
+	g.hdocs = append(g.hdocs, body.String())
+	return op + g.s("", " ") + delim
+}
+
+// word is one or two parts.
+func (g *gen) word() string {
+	k := 1
+	if g.c(25) {
+		k = 2
+	}
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		p := g.part()
+		if Known.procSubstGlued && k > 1 && (strings.HasPrefix(p, "<(") || strings.HasPrefix(p, ">(")) {
+			p = g.lit()
+		}
+		if Known.dollarBackquote && strings.HasSuffix(sb.String(), "$") && strings.HasPrefix(p, "`") {
+			p = g.lit()
+		}
+		sb.WriteString(p)
+	}
+	return sb.String()
+}
+
+func (g *gen) lit() string {
+	return g.s("a", "b", "foo", "x1", "-n", "--", "1", "0", "./f", "/tmp/x", "a=b", "*.sh", `a\ b`, `\$x`, "a,b", "~/x", "%", "a:b", "[x]", "a{b,c}", "{1..3}", "-", "+")
+}
+
+func (g *gen) part() string {
+	if g.budget <= 0 {
+		return g.lit()
+	}
+	r := g.i(1, 100)
+	switch {
+	case r <= 35:
+		return g.lit()
+	case r <= 45:
+		return "'" + g.s("", "a b", "$x", `it"s`, "a\nb", "*", `\`, "#") + "'"
+	case r <= 60:
+		return g.dq()
+	case r <= 78:
+		return g.param()
+	case r <= 88:
+		return g.cmdSubst()
+	case r <= 94:
+		return "$((" + g.arith(0) + "))"
+	}
+	if !g.bash {
+		return g.lit()
+	}
+	switch g.i(1, 4) {
+	case 1:
+		return "$'" + g.s(`a\tb`, `\n`, `it\'s`, `\x41`, `\u00e9`, `\\`, "a b", "") + "'"
+	case 2:
+		return `$"` + g.s("hello", "a $x", "") + `"`
+	default:
+		return g.s("<(", ">(") + g.inlineList() + ")"
+	}
+}
+
+func (g *gen) dq() string {
+	g.inDq++
+	defer func() { g.inDq-- }()
+	var sb strings.Builder
+	sb.WriteString(`"`)
+	for i, k := 0, g.i(0, 3); i < k; i++ {
+		r := g.i(1, 100)
+		var p string
+		switch {
+		case r <= 40:
+			p = g.s("a", "b c", "x-y", `\"`, `\\`, `\$`, "\\`", "!", "#", "'", "~", "$", "*", "a\nb", " ")
+		case r <= 70:
+			p = g.param()
+		case r <= 90:
+			p = g.cmdSubst()
+		default:
+			p = "$((" + g.arith(0) + "))"
+		}
+		if Known.dollarBackquote && strings.HasSuffix(sb.String(), "$") && strings.HasPrefix(p, "`") {
+			p = "a"
+		}
+		sb.WriteString(p)
+	}
+	sb.WriteString(`"`)
+	return sb.String()
+}
+
+func (g *gen) innerWord() string {
+	switch g.i(1, 5) {
+	case 1:
+		if g.noDqInExp && g.inDq > 0 {
+			return g.lit()
+		}
+		return g.dq()
+	case 2:
+		return g.param()
+	case 3:
+		return g.cmdSubst()
+	case 4:
+		return g.s("a", "*", "?.sh", "[ab]*", `\*`, "$y", "a b", "")
+	default:
+		return g.lit()
+	}
+}
+
+func (g *gen) param() string {
+	v := g.varName()
+	r := g.i(1, 100)
+	switch {
+	case r <= 20:
+		return "$" + g.s(v, "1", "@", "*", "#", "?", "$", "!", "-", "0")
+	case r <= 30:
+		return "${" + g.s(v, "11", "@", "#", "*") + "}"
+	case r <= 45:
+		return "${" + v + g.s(":-", "-", ":=", "=", ":+", "+", ":?", "?") + g.innerWord() + "}"
+	case r <= 50:
+		return "${#" + g.s(v, "@", "*") + "}"
+	case r <= 60:
+		return "${" + v + g.s("#", "##", "%", "%%") + g.innerWord() + "}"
+	}
+	if !g.bash {
+		return "${" + v + "}"
+	}
+	switch g.i(1, 12) {
+	case 1:
+		return "${" + v + g.s("/", "//", "/#", "/%") + g.innerWord() + "/" + g.innerWord() + "}"
+	case 2:
+		inner := g.innerWord()
+		if Known.emptyReplPrints && inner == "" {
+			inner = "a"
+		}
+		return "${" + v + "/" + inner + "}"
+	case 3:
+		return "${" + v + ":" + g.s("1", "$i", "-1", " -1", "i+1") + "}"
+	case 4:
+		return "${" + v + ":" + g.s("1", "$i", "0") + ":" + g.s("2", "$n", "-1") + "}"
+	case 5:
+		return "${" + v + "[" + g.s("1", "@", "*", "$i", "i+1", "a") + "]}"
+	case 6:
+		return "${#" + v + "[" + g.s("@", "*", "1") + "]}"
+	case 7:
+		return "${!" + g.s(v, v+"[@]", v+"*", v+"@") + "}"
+	case 8:
+		return "${" + v + g.s("^", "^^", ",", ",,") + "}"
+	case 9:
+		return "${" + v + "@" + g.s("Q", "U", "a", "A", "E", "P", "L", "K", "k") + "}"
+	case 10:
+		return "${" + v + "[@]:" + g.s("1", "$i") + g.s("", ":2") + "}"
+	case 11:
+		return "${" + v + "[" + g.s("1", "$i") + "]" + g.s(":-", "-", ":+") + g.innerWord() + "}"
+	default:
+		return "${" + v + g.s("^", ",") + g.s("a", "[ab]", "*") + "}"
+	}
+}
+
+func (g *gen) cmdSubst() string {
+	if g.noBq == 0 && g.c(25) {
+		g.noBq++
+		g.inline++
+		inner := g.simple()
+		if strings.ContainsAny(inner, "\\`") {
+			inner = "echo a" // backslashes are interpreted again inside backquotes
+		}
+		s := "`" + inner + "`"
+		g.inline--
+		g.noBq--
+		return s
+	}
+	if g.bash && g.c(8) {
+		return "$(<" + g.s("file", "$f", "./x") + ")"
+	}
+	inner := g.inlineList()
+	if strings.HasPrefix(inner, "(") {
+		inner = " " + inner + " "
+	}
+	return "$(" + inner + ")"
+}
+
+func (g *gen) arithLeaf() string {
+	r := g.i(1, 100)
+	switch {
+	case r <= 40:
+		return g.s("0", "1", "42", "0x1f", "010", "7")
+	case r <= 70:
+		return g.varName()
+	case r <= 85:
+		return "$" + g.varName()
+	case r <= 92:
+		return "${" + g.varName() + "}"
+	}
+	if !g.bash {
+		return g.s("$1", "$#", "3")
+	}
+	return g.s("2#101", g.varName()+"[1]", g.varName()+"[$i]", "$1", "$#", "$(echo 1)")
+}
+
+func (g *gen) arithAssign(d int) string {
+	return g.varName() + " " + g.s("=", "+=", "-=", "*=", "/=", "%=", "<<=", ">>=", "&=", "|=", "^=") + " " + g.arith(d+1)
+}
+
+func (g *gen) arith(d int) string {
+	if d >= 2 || g.c(35) {
+		return g.arithLeaf()
+	}
+	switch g.i(1, 10) {
+	case 1:
+		op := g.s("-", "+", "!", "~")
+		x := g.arith(d + 1)
+		if Known.arithGluedSign && (op == "-" || op == "+") && strings.HasPrefix(x, op) {
+			x = "(" + x + ")" // `+ ++x` would print as `+++x`
+		}
+		return op + x
+	case 2:
+		if g.bash {
+			return g.s("++", "--") + g.varName()
+		}
+		return g.arithLeaf()
+	case 3:
+		if g.bash {
+			return g.varName() + g.s("++", "--")
+		}
+		return g.arithLeaf()
+	case 4:
+		return "(" + g.arith(d+1) + ")"
+	case 5:
+		return g.arith(d+1) + " ? " + g.arith(d+1) + " : " + g.arith(d+1)
+	case 6:
+		if d == 0 {
+			return g.arithAssign(d)
+		}
+		return g.arithLeaf()
+	case 7:
+		if g.bash {
+			return g.arith(d+1) + ", " + g.arith(d+1)
+		}
+		return g.arithLeaf()
+	default:
+		ops := []string{"+", "-", "*", "/", "%", "<<", ">>", "&", "|", "^", "&&", "||", "==", "!=", "<", ">", "<=", ">="}
+		if g.bash {
+			ops = append(ops, "**")
+		}
+		return g.arith(d+1) + " " + g.s(ops...) + " " + g.arith(d+1)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Printer options.
+
+type printOpts struct {
+	indent                                                       int
+	binaryNextLine, switchCaseIndent, spaceRedirects             bool
+	keepPadding, minify, singleLine, funcNextLine, blockNextLine bool
+}
+
+func genPrintOpts(tc hegel.TestCase) printOpts {
+	o := printOpts{
+		indent:           n(tc, 0, 4),
+		binaryNextLine:   chance(tc, 25),
+		switchCaseIndent: chance(tc, 25),
+		spaceRedirects:   chance(tc, 25),
+		keepPadding:      chance(tc, 10),
+		minify:           chance(tc, 25),
+	}
+	if !o.minify {
+		o.singleLine = chance(tc, 25)
+	}
+	switch n(tc, 1, 4) {
+	case 1:
+		o.funcNextLine = true
+	case 2:
+		o.blockNextLine = true
+	}
+	return o
+}
+
+func (o printOpts) printer() *syntax.Printer {
+	return syntax.NewPrinter(
+		syntax.Indent(uint(o.indent)),
+		syntax.BinaryNextLine(o.binaryNextLine),
+		syntax.SwitchCaseIndent(o.switchCaseIndent),
+		syntax.SpaceRedirects(o.spaceRedirects),
+		syntax.KeepPadding(o.keepPadding),
+		syntax.Minify(o.minify),
+		syntax.SingleLine(o.singleLine),
+		syntax.FunctionNextLine(o.funcNextLine),
+		syntax.BlockNextLine(o.blockNextLine),
+	)
+}
+
+func (o printOpts) String() string {
+	var parts []string
+	parts = append(parts, fmt.Sprintf("Indent(%d)", o.indent))
+	for _, f := range []struct {
+		on   bool
+		name string
+	}{
+		{o.binaryNextLine, "BinaryNextLine"}, {o.switchCaseIndent, "SwitchCaseIndent"},
+		{o.spaceRedirects, "SpaceRedirects"}, {o.keepPadding, "KeepPadding"},
+		{o.minify, "Minify"}, {o.singleLine, "SingleLine"},
+		{o.funcNextLine, "FunctionNextLine"}, {o.blockNextLine, "BlockNextLine"},
+	} {
+		if f.on {
+			parts = append(parts, f.name)
+		}
+	}
+	return strings.Join(parts, " ")
+}
+
+// mustParse parses a generated program, telling a parser bug (the shell
+// accepts the program) from a generator bug (the shell rejects it too).
+func mustParse(ht *hegel.T, lang syntax.LangVariant, src string, keepComments bool) *syntax.File {
+	f, err := parse(lang, src, keepComments)
+	if err != nil {
+		ok, msg := shellAccepts(lang, src)
+		if ok {
+			fail(ht, "%s parser rejects a program %s accepts: %v\nsource:\n%s", langName(lang), langName(lang), err, src)
+		}
+		fail(ht, "GENERATOR: %s rejects the generated program: %s\nparser: %v\nsource:\n%s", langName(lang), msg, err, src)
+	}
+	if ok, msg := shellAccepts(lang, src); !ok {
+		fail(ht, "GENERATOR: %s rejects the generated program, which the parser accepts: %s\nsource:\n%s", langName(lang), msg, src)
+	}
+	return f
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// A printed program parses back to the same tree, prints the same way again,
+// and is accepted by the dialect's shell, under every printer option.
+func TestHegelFormattingPreservesTheProgram(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		g := newGen(tc, chance(tc, 75))
+		lang := g.lang()
+		src := g.program()
+		note(ht, "%s source:\n%s", langName(lang), src)
+		f := mustParse(ht, lang, src, true)
+		opts := genPrintOpts(tc)
+		if Known.keepPaddingBang && opts.keepPadding && (leadingRedirect.MatchString(src) || negation.MatchString(src) || (opts.indent > 0 && openParenLine.MatchString(src))) {
+			opts.keepPadding = false
+		}
+		if Known.minifyEmptyItem && opts.minify && emptyLastItem.MatchString(src) {
+			opts.minify = false
+		}
+		if Known.minifyPipeRedirect && opts.minify && pipeRedirect.MatchString(src) {
+			opts.minify = false
+		}
+		if Known.letComment && opts.minify && strings.Contains(src, "let ") {
+			opts.minify = false // `let x=1|[ a ]` does not parse
+		}
+		if Known.singleLineEsac && opts.singleLine && strings.Contains(src, "esac") {
+			opts.singleLine = false
+		}
+		if Known.singleLineBgClose && opts.singleLine && bgBeforeClose.MatchString(src) {
+			opts.singleLine = false
+		}
+		if Known.singleLineComment && opts.singleLine && closeComment.MatchString(src) {
+			opts.singleLine = false
+		}
+		if (opts.singleLine || opts.minify) && hdocPrinterShape(src) {
+			// sh/5, sh/8: joining lines moves a heredoc body into whatever the
+			// printer breaks across lines after it.
+			opts.singleLine, opts.minify = false, false
+		}
+		note(ht, "printer: %s", opts)
+		out, err := printNode(opts.printer(), f)
+		if err != nil {
+			fail(ht, "Print(%s) failed: %v\nsource:\n%s", opts, err, src)
+		}
+		note(ht, "printed:\n%s", out)
+		base := f
+		if opts.minify {
+			// Minify drops the comments; compare against the comment-free tree.
+			base, _ = parse(lang, src, false)
+		}
+		f2, err := parse(lang, out, true)
+		if err != nil {
+			fail(ht, "the printed program (%s) does not parse: %v\nsource:\n%s\nprinted:\n%s", opts, err, src, out)
+		}
+		cmp := shape
+		if opts.minify {
+			cmp = shapeMinified
+		}
+		if a, b := cmp(base), cmp(f2); a != b {
+			fail(ht, "the printed program (%s) parses to a different tree\nsource:\n%s\nprinted:\n%s\ndefault print of the source:\n%s\ndefault print of the printed:\n%s\nshape diff %s",
+				opts, src, out, defaultPrint(base), defaultPrint(f2), firstDiff(a, b))
+		}
+		out2, err := printNode(opts.printer(), f2)
+		if err != nil {
+			fail(ht, "Print(%s) of the reparsed program failed: %v", opts, err)
+		}
+		if out2 != out {
+			fail(ht, "formatting (%s) is not idempotent\nsource:\n%s\nfirst:\n%s\nsecond:\n%s\ndiff %s", opts, src, out, out2, firstDiff(out, out2))
+		}
+		if ok, msg := shellAccepts(lang, out); !ok {
+			fail(ht, "%s rejects the printed program (%s): %s\nsource:\n%s\nprinted:\n%s", langName(lang), opts, msg, src, out)
+		}
+		if chance(tc, 30) {
+			var buf bytes.Buffer
+			if err := typedjson.Encode(&buf, f); err != nil {
+				fail(ht, "typedjson.Encode: %v", err)
+			}
+			dec, err := typedjson.Decode(bytes.NewReader(buf.Bytes()))
+			if err != nil {
+				fail(ht, "typedjson.Decode of Encode's output: %v\njson:\n%s", err, buf.String())
+			}
+			var buf2 bytes.Buffer
+			if err := typedjson.Encode(&buf2, dec); err != nil {
+				fail(ht, "typedjson.Encode of the decoded tree: %v", err)
+			}
+			if buf.String() != buf2.String() {
+				fail(ht, "typedjson round trip changed the tree\nsource:\n%s\ndiff %s", src, firstDiff(buf.String(), buf2.String()))
+			}
+			if dp := defaultPrint(dec); dp != defaultPrint(f) {
+				fail(ht, "the decoded tree prints differently\nsource:\n%s\ndecoded:\n%s", src, dp)
+			}
+		}
+	})
+}
