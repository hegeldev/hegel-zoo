+// sh/17: when a compound command's body ends in `&` and its closing keyword
+// carries a redirect, the `;` (or newline) before the following `then`/`do`
+// is dropped: `if { true & } <x1; then true; fi` prints as
+// `if { true & } <x1 then true; fi`, which bash rejects and the parser reads
+// back with `then` as a word.
+func TestHegelPinThenKeepsItsSeparator(t *testing.T) {
+	for _, src := range []string{
+		"if { true & } <x1; then true; fi\n",
+		"if while b; do true & done <x1; then true; fi\n",
+		"while while b\ndo\ntrue &\ndone <x1; do\ntrue\ndone\n",
+		"(\n! if a |& while $(! $(! `echo a` true) true)b true\ndo\n! true &\ndone <<< a,b; then\ntrue\nfi &\n) >> bb <<- 'EOF' &\nEOF\n",
+	} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out := defaultPrint(f)
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Errorf("%q prints as %q, which does not parse: %v", src, out, err)
+			continue
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("%q prints as %q, a different program", src, out)
+		}
+		if ok, msg := shellAccepts(syntax.LangBash, out); !ok {
+			t.Errorf("%q prints as %q, which bash rejects: %s", src, out, msg)
+		}
+	}
+}
+
+// sh/18: with SingleLine, nothing separates a case statement with items from
+// the statement after it: `case a in a) b ;; esac; c` prints as
+// `case a in a) b ;; esac c`.
+func TestHegelPinSingleLineSeparatesStatementsAfterCase(t *testing.T) {
+	for _, src := range []string{
+		"case a in a) b ;; esac; c\n",
+		"case a in\na) b ;;\nesac\nc\n",
+		"x=$(case a in a) b ;; esac; c)\n",
+		"if case a in a) b ;; esac; then c; fi\n",
+		"case a in b) c ;; esac <<EOF\nbody\nEOF\ntrue\n",
+	} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.SingleLine(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Errorf("SingleLine print of %q is %q, which does not parse: %v", src, out, err)
+			continue
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("SingleLine print of %q is %q, a different program", src, out)
+		}
+		if ok, msg := shellAccepts(syntax.LangBash, out); !ok {
+			t.Errorf("SingleLine print of %q is %q, which bash rejects: %s", src, out, msg)
+		}
+	}
+}
+
+// sh/19: with SingleLine, a loop or conditional whose body ends in `&` is
+// followed by the next statement with no separator after `done`/`fi`.
+func TestHegelPinSingleLineSeparatesAfterBackgroundBodies(t *testing.T) {
+	for _, src := range []string{"while a; do\nb\n! c &\ndone; d | e\n", "while a; do b & done; c\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.SingleLine(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		if _, err := syntax.NewParser().Parse(strings.NewReader(out), ""); err != nil {
+			t.Errorf("SingleLine print of %q is %q, which does not parse: %v", src, out, err)
+		}
+	}
+}
+
+// sh/20: a unary sign followed by an increment of the same sign is printed
+// glued, `$((+ ++x))` as `$((+++x))`, which the parser then rejects; bash
+// evaluates `+++x`, `1+++x`, `++ +x` and `+++1` (as 2, 3, 1 and 1 with x=1).
+func TestHegelPinArithmeticSignsStayApart(t *testing.T) {
+	for _, src := range []string{"echo $((+ ++x))\n", "echo $((- --x))\n", "echo $((+ +x))\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out := defaultPrint(f)
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Errorf("%q prints as %q, which does not parse: %v", src, out, err)
+			continue
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("%q prints as %q, a different program", src, out)
+		}
+	}
+	for _, src := range []string{"echo $((+++x))\n", "echo $((1+++x))\n", "echo $((++ +x))\n", "echo $((+++1))\n"} {
+		if ok, _ := shellAccepts(syntax.LangBash, src); !ok {
+			t.Fatalf("bash rejects %q", src)
+		}
+		if _, err := syntax.NewParser().Parse(strings.NewReader(src), ""); err != nil {
+			t.Errorf("Parse(%q): %v; bash accepts it", src, err)
+		}
+	}
+}
+
+// sh/21: with SingleLine, the comment after the closing word of a compound
+// command that spans lines is moved to a line of its own, after a dangling
+// `;`: `f() {\ntrue\n} # c\ntrue` prints as `f() { true; };\n# c\ntrue`, where
+// the comment now belongs to the next statement (`f() { true; } # c` and
+// `f() {\ntrue\n} >x # c` keep it).
+func TestHegelPinSingleLineKeepsTrailingComments(t *testing.T) {
+	for _, src := range []string{"f() {\ntrue\n} # c\ntrue\n", "if a; then\nb\nfi # c\ntrue\n", "(\ntrue\n) # c\n"} {
+		f, err := syntax.NewParser(syntax.KeepComments(true)).Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.SingleLine(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		f2, err := syntax.NewParser(syntax.KeepComments(true)).Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out, err)
+		}
+		if shape(f) != shape(f2) {
+			t.Errorf("SingleLine print of %q is %q, whose comments belong to other statements", src, out)
+		}
+	}
+}
+
+// sh/22: the separator after a case statement is dropped: when a case with a
+// redirect ends a one-line body, `{ case a in a) b ;; esac >x; }` prints as
+// `{ case a in a) b ;; esac >x }` and `while a; do case a in a) b ;; esac >x;
+// done` as `... esac >x done`; when a condition holds a case inside a
+// substitution, `if $(case a in a) esac); then ]; fi` prints as
+// `if $(case a in a) ;; esac) then ]; fi`. bash rejects them all (the parser
+// reads them back).
+func TestHegelPinCaseRedirectsKeepTheirSeparator(t *testing.T) {
+	for _, src := range []string{
+		"{ case a in a) b ;; esac >x; }\n",
+		"f() { case a in a) b ;; esac 2>&1; }\n",
+		"while a; do case a in a) b ;; esac >x; done\n",
+		"if a; then case a in a) b ;; esac >x; fi\n",
+		"if $(case a in a) esac); then ]; fi\n",
+		"while x=$(case $a in b) c ;; esac) y; do d; done\n",
+	} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out := defaultPrint(f)
+		if ok, msg := shellAccepts(syntax.LangBash, out); !ok {
+			t.Errorf("%q prints as %q, which bash rejects: %s", src, out, msg)
+		}
+		if ok, msg := shellAccepts(syntax.LangPOSIX, out); !ok {
+			t.Errorf("%q prints as %q, which dash rejects: %s", src, out, msg)
+		}
+	}
+}
+
+// sh/23: formatting is not idempotent when a redirect before the command
+// name has a substitution ending in `; return` (or exit, break, continue,
+// shift) as its target: `>$(a; return) c` prints as `>$(\n\ta; return\n) c`,
+// which prints as `>$(\n\ta\n\treturn\n) c`; `c >$(a; return)` is stable.
+func TestHegelPinLeadingRedirectsFormatIdempotently(t *testing.T) {
+	for _, src := range []string{">$(a; return) c\n", "2>\"$(a; exit 1)\" c d\n", "{ (>`a; break` c); }\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out1 := defaultPrint(f)
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out1), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out1, err)
+		}
+		if out2 := defaultPrint(f2); out2 != out1 {
+			t.Errorf("%q prints as %q, which prints as %q", src, out1, out2)
+		}
+	}
+}
+
+// sh/24: with RecoverErrors, an assignment whose value is an arithmetic
+// expansion with an invalid operator makes the parser panic in getAssign
+// (`x=$((a b` and `x=$((a b))`: slice bounds out of range; `x+=$((a b`: index
+// out of range). `$((a b` alone recovers, and without RecoverErrors every
+// shape is a plain parse error.
+func TestHegelPinRecoveringParserSurvivesArithmeticAssignments(t *testing.T) {
+	for _, c := range []struct {
+		src  string
+		lang syntax.LangVariant
+	}{{"x=$((a b", syntax.LangBash}, {"x=$((a b))\n", syntax.LangPOSIX}, {"x+=$((a b", syntax.LangBash}, {"x=$[a b", syntax.LangBash}, {"x=a$((a b\n", syntax.LangMirBSDKorn}} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("Parse(%q, %s, RecoverErrors(1)) panics: %v", c.src, langName(c.lang), r)
+				}
+			}()
+			_, err := syntax.NewParser(syntax.Variant(c.lang), syntax.RecoverErrors(1)).Parse(strings.NewReader(c.src), "")
+			if err != nil && !strings.Contains(err.Error(), "arithmetic") {
+				t.Logf("Parse(%q): %v", c.src, err)
+			}
+		}()
+	}
+}
+
+// sh/25: Minify prints `a | &>f b` as `a|&>f b`, which reads back as
+// `a |& >f b`: the pipe now carries stderr too. Also with `&>>`.
+func TestHegelPinMinifyKeepsPipesApartFromRedirects(t *testing.T) {
+	for _, src := range []string{"a | &>f b\n", "a | &>>f b\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		out, err := printNode(syntax.NewPrinter(syntax.Minify(true)), f)
+		if err != nil {
+			t.Fatalf("Print: %v", err)
+		}
+		f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out, err)
+		}
+		if shapeMinified(f) != shapeMinified(f2) {
+			t.Errorf("minified %q is %q, which is the program %q", src, out, defaultPrint(f2))
+		}
+	}
+}
+
+// sh/26: a command substitution holding a multi-statement subshell prints
+// with a space before its closing parenthesis, `$( (\n\ta\n\tb\n) )`, and
+// that prints without it, `$( (\n\ta\n\tb\n))`; with Minify, `$( (a\nb) )`
+// then `$( (a\nb))`.
+func TestHegelPinSubstitutionsCloseTheSameWayTwice(t *testing.T) {
+	for _, src := range []string{"echo $( (a; b) )\n", "x=$(! (a; b))\n"} {
+		for _, p := range []*syntax.Printer{syntax.NewPrinter(), syntax.NewPrinter(syntax.Minify(true))} {
+			f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+			if err != nil {
+				t.Fatalf("Parse(%q): %v", src, err)
+			}
+			out1, err := printNode(p, f)
+			if err != nil {
+				t.Fatalf("Print: %v", err)
+			}
+			f2, err := syntax.NewParser().Parse(strings.NewReader(out1), "")
+			if err != nil {
+				t.Fatalf("Parse(%q): %v", out1, err)
+			}
+			if out2, _ := printNode(p, f2); out2 != out1 {
+				t.Errorf("%q prints as %q, which prints as %q", src, out1, out2)
+			}
+		}
+	}
+}
+
+// sh/27: a heredoc body placed right after the `(` that opens a subshell
+// (or a `$(`, or a function's subshell body) is "unclosed here-document";
+// bash and dash accept it, and the same body after `{`, `then` or `do`
+// parses.
+func TestHegelPinHeredocBodyAfterASubshellOpens(t *testing.T) {
+	for _, src := range []string{"echo <<EOF | (\nEOF\necho\n)\n", "echo <<EOF | $(\nEOF\necho\n)\n", "echo <<EOF | f() (\nEOF\necho\n)\n"} {
+		if _, err := syntax.NewParser().Parse(strings.NewReader(src), ""); err != nil {
+			t.Errorf("Parse(%q): %v (bash -n and dash -n accept it, and the body after `{` parses)", src, err)
+		}
+	}
+}
+
+// sh/28: InteractiveSeq yields the statements before a heredoc redirect
+// twice when the heredoc sits at the parser's 1024-byte read boundary.
+func TestHegelPinInteractiveSeqYieldsEachStatementOnce(t *testing.T) {
+	src := strings.Repeat("#", 1009) + "\na;b;c <<EOF\nx\nEOF\n"
+	f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+	if err != nil {
+		t.Fatalf("Parse: %v", err)
+	}
+	var got []string
+	for stmts, err := range syntax.NewParser().InteractiveSeq(strings.NewReader(src)) {
+		if err != nil {
+			t.Fatalf("InteractiveSeq: %v", err)
+		}
+		for _, s := range stmts {
+			got = append(got, s.Pos().String())
+		}
+	}
+	if len(got) != len(f.Stmts) {
+		t.Errorf("InteractiveSeq yields %d statements at %v, Parse %d (the heredoc sits at the 1024-byte read boundary)", len(got), got, len(f.Stmts))
+	}
+}
diff --git a/syntax/hegel_shapes_test.go b/syntax/hegel_shapes_test.go
new file mode 100644
index 0000000..cca6b0b
--- /dev/null
+++ b/syntax/hegel_shapes_test.go
@@ -0,0 +1,1133 @@
+package syntax_test
+
+// The narrow properties (STYLE.md rule 11, DESIGN.md decision 3): one per
+// recorded bug of bugs.toml. Each draws the bug's shape region with random
+// contents: a small program in which the bug's construct stands, built from
+// the pieces of the grammar of hegel_test.go (its commands, lists, words,
+// redirects and heredocs), among random surrounding lines, with random
+// printer options where the bug depends on them; and each is checked by the
+// same helper as the wide property that meets the bug (checkFormatting,
+// checkSimplify, checkPositions, checkStreams, checkBroken). Every case is
+// the bug, so each property fails on its first case until the bug is fixed
+// and shrinks to the bug's minimal shape; they are the expected failures
+// mapped to the bugs in target.toml. Under HEGEL_NO_KNOWN=1 the region is
+// the bug and nothing is left to test, so they are skipped.
+
+import (
+	"slices"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// shapeProperty runs a narrow property, skipped under HEGEL_NO_KNOWN=1. The
+// region is one bug's, so the engine stops at the first failure and shrinks
+// it, instead of spending its budget looking for distinct failures.
+func shapeProperty(t *testing.T, bug string, fn func(ht *hegel.T)) {
+	t.Helper()
+	if noKnown {
+		t.Skipf("%s: the shape region is the recorded bug, left out under HEGEL_NO_KNOWN=1", bug)
+	}
+	property(t, fn, hegel.WithReportMultipleFailures(false))
+}
+
+// The dialects a shape is drawn in: bash only, POSIX only (dash is the
+// oracle that rejects the output), or bash three times in four.
+var (
+	bashOnly   = hegel.Just(true)
+	posixOnly  = hegel.Just(false)
+	anyDialect = chance(75)
+)
+
+// plainComments: a trailing comment that does not end in a backslash (that
+// is the shape of sh/6).
+var plainComments = weighted(
+	choice[string]{weight: 15, gen: lit("#")},
+	choice[string]{weight: 85, gen: wrap("# ", pick(commentTexts...), "")},
+)
+
+// ---------------------------------------------------------------------------
+// Tree builders around the program tree of hegel_test.go.
+
+func pipeOf(cs ...cmd) pipeline {
+	p := pipeline{cmds: chain[cmd]{head: cs[0]}}
+	for _, c := range cs[1:] {
+		p.cmds.tail = append(p.cmds.tail, link[cmd]{" | ", c})
+	}
+	return p
+}
+
+func andOrOf(p pipeline) andOr { return andOr{head: p} }
+
+func listOf(a andOr) chain[andOr] { return chain[andOr]{head: a} }
+
+// stmt is a list of the one command.
+func stmt(c cmd) chain[andOr] { return listOf(andOrOf(pipeOf(c))) }
+
+func lineOf(c cmd) line { return line{list: stmt(c)} }
+
+// appendList adds an and-or list to a list after a separator.
+func appendList(l chain[andOr], sep string, a andOr) chain[andOr] {
+	l.tail = append(slices.Clone(l.tail), link[andOr]{sep, a})
+	return l
+}
+
+// pipeOps: the pipe operators of the dialect.
+func pipeOps(bash bool) hegel.Generator[string] {
+	if bash {
+		return pick(" | ", " |& ")
+	}
+	return lit(" | ")
+}
+
+// namedSimple draws a simple command that names a command, so that words
+// and redirects can go among its words.
+func namedSimple(tc hegel.TestCase, g *grammar) simpleCmd {
+	s := hegel.Draw(tc, g.inlineSimples).(simpleCmd)
+	if s.call == nil {
+		s.call = hegel.Draw(tc, g.calls)
+	}
+	return s
+}
+
+// withArg puts a word among the arguments of a simple command.
+func withArg(tc hegel.TestCase, s simpleCmd, w word) simpleCmd {
+	at := 1 + hegel.Draw(tc, positions)%len(s.call)
+	s.call = slices.Insert(slices.Clone(s.call), at, w)
+	return s
+}
+
+// leading puts a redirect first among the words of a simple command: its
+// assignments, which would come before it, are dropped, and its other
+// redirects go after the command name.
+func leading(s simpleCmd, r redirect) simpleCmd {
+	s.assigns = nil
+	rest := slices.Clone(s.redirs)
+	for i := range rest {
+		rest[i].at = 1 + rest[i].at%len(s.call)
+	}
+	s.redirs = append([]placed{{r, 0}}, rest...)
+	return s
+}
+
+// plainRedirects: a redirect with a POSIX operator (bash's `&>`, `<<<` and
+// `{fd}>` print differently) and a literal target.
+var plainRedirects = hegel.Composite(func(tc hegel.TestCase) redirect {
+	op := hegel.Draw(tc, posixRedirs)
+	if hasFdTarget(op) {
+		return redirect{text: op}
+	}
+	return redirect{text: op + hegel.Draw(tc, pick("", " ")) + hegel.Draw(tc, lits)}
+})
+
+// afterName puts the redirects of a simple command after its command name.
+func afterName(s simpleCmd) simpleCmd {
+	s.redirs = slices.Clone(s.redirs)
+	for i := range s.redirs {
+		s.redirs[i].at = 1 + s.redirs[i].at%len(s.call)
+	}
+	return s
+}
+
+// literalName gives a simple command a literal command name.
+func literalName(s simpleCmd) simpleCmd {
+	if name := wordText(s.call[0]); strings.HasPrefix(name, "$") || strings.HasPrefix(name, `"`) {
+		s.call = slices.Clone(s.call)
+		s.call[0] = word{"echo"}
+	}
+	return s
+}
+
+// unassigned drops the assignments of a simple command.
+func unassigned(s simpleCmd) simpleCmd {
+	s.assigns = nil
+	return s
+}
+
+// twoOrMore draws a one-line list of at least two statements.
+func twoOrMore(tc hegel.TestCase, g *grammar) chain[andOr] {
+	l := hegel.Draw(tc, g.inlineLists)
+	if len(l.tail) == 0 {
+		l = appendList(l, "; ", hegel.Draw(tc, g.inlineAndOrs))
+	}
+	return l
+}
+
+// withHeredoc draws a simple command with a heredoc at its end.
+func withHeredoc(tc hegel.TestCase, g *grammar) simpleCmd {
+	s := namedSimple(tc, g)
+	s.hdoc = ptrTo(hegel.Draw(tc, g.heredocs))
+	return s
+}
+
+// joinedBy joins two pipelines with a pipe or an and-or operator.
+func joinedBy(op string, a, b pipeline) chain[andOr] {
+	if strings.TrimSpace(op) == "|" || strings.TrimSpace(op) == "|&" {
+		a.cmds.tail = append(slices.Clone(a.cmds.tail), link[cmd]{op, b.cmds.head})
+		a.cmds.tail = append(a.cmds.tail, b.cmds.tail...)
+		return listOf(andOrOf(a))
+	}
+	return listOf(andOr{head: a, tail: []link[pipeline]{{op, b}}})
+}
+
+// Nodes the grammar has no need for.
+
+// negated: `! ` before a pipeline (the doubly negated pipeline of sh/2).
+type negated struct{ p pipeline }
+
+func (n negated) render(w *writer) {
+	w.str("! ")
+	n.p.render(w)
+}
+
+// compound: a compound command from its opening text (through the keyword
+// before the body), a body node, its closing word and redirects.
+type compound struct {
+	open   string
+	body   node
+	close  string
+	redirs []redirect
+}
+
+func (c compound) render(w *writer) {
+	w.str(c.open)
+	c.body.render(w)
+	w.str(c.close)
+	renderRedirs(w, c.redirs)
+}
+
+// bgBody: a body whose last statement ends in ` &`: a one-line list
+// (` a; b & `) or lines of which the last ends in ` &`.
+type bgBody struct {
+	inl   *chain[andOr]
+	lines []line
+}
+
+func (b bgBody) render(w *writer) {
+	if b.inl != nil {
+		w.str(" ")
+		b.inl.render(w)
+		w.str(" & ")
+		return
+	}
+	w.nl()
+	for _, l := range b.lines {
+		l.render(w)
+	}
+}
+
+// substLines: a command whose word holds a `$( )` whose list starts on the
+// next line (a heredoc body pending on the line lands after the `$(`).
+type substLines struct {
+	prefix string
+	lines  []line
+}
+
+func (s substLines) render(w *writer) {
+	w.str(s.prefix + "$(")
+	w.nl()
+	for _, l := range s.lines {
+		l.render(w)
+	}
+	w.str(")")
+}
+
+// emptyCase: `case w in [(]p) ;; esac`, one item without a body (sh/11).
+type emptyCase struct {
+	word, pats string
+	paren      bool
+	term       string
+	redirs     []redirect
+}
+
+func (c emptyCase) render(w *writer) {
+	w.str("case " + c.word + " in ")
+	if c.paren {
+		w.str("(")
+	}
+	w.str(c.pats + ") " + c.term + " esac")
+	renderRedirs(w, c.redirs)
+}
+
+// openCase: a case clause whose last item has no body and no terminator
+// (`case a in x) b ;; a) esac`, sh/13), after items with bodies.
+type openCase struct {
+	word   string
+	multi  bool
+	items  []caseItem
+	pats   string
+	paren  bool
+	redirs []redirect
+}
+
+func (c openCase) render(w *writer) {
+	w.str("case " + c.word + " in")
+	if c.multi {
+		w.nl()
+	} else {
+		w.str(" ")
+	}
+	for _, it := range c.items {
+		if it.paren {
+			w.str("(")
+		}
+		w.str(it.pats + ")")
+		if c.multi {
+			w.nl()
+			for _, l := range it.b.lines {
+				l.render(w)
+			}
+			w.str(it.term)
+			w.nl()
+			continue
+		}
+		w.str(" ")
+		it.b.inl.render(w)
+		w.str(" " + it.term + " ")
+	}
+	if c.paren {
+		w.str("(")
+	}
+	w.str(c.pats + ")")
+	if c.multi {
+		w.nl()
+	} else {
+		w.str(" ")
+	}
+	w.str("esac")
+	renderRedirs(w, c.redirs)
+}
+
+// opening: the opening text and closing word of a compound command whose
+// body is a list: `{ }`, `( )`, `f() { }`, `if a; then fi`, `if a; then b;
+// else fi`, `while a; do done`, `for x in a; do done`, `case a in a) ;; esac`.
+type opening struct{ open, close string }
+
+func openings(g *grammar, subshells, cases bool) hegel.Generator[opening] {
+	condText := hegel.Map(g.inlineConds, func(c cond) string { return text(c) })
+	alts := []choice[opening]{
+		{weight: 3, gen: hegel.Just(opening{"{", "}"})},
+		{weight: 2, gen: hegel.Map(g.funcNames, func(n string) opening { return opening{n + "() {", "}"} })},
+		{weight: 3, gen: hegel.Map(condText, func(c string) opening { return opening{"if " + c + "then", "fi"} })},
+		{weight: 2, gen: hegel.Composite(func(tc hegel.TestCase) opening {
+			return opening{"if " + hegel.Draw(tc, condText) + "then" + text(hegel.Draw(tc, g.inlineBodies)) + "else", "fi"}
+		})},
+		{weight: 3, gen: hegel.Composite(func(tc hegel.TestCase) opening {
+			return opening{hegel.Draw(tc, pick("while ", "until ")) + hegel.Draw(tc, condText) + "do", "done"}
+		})},
+		{weight: 2, gen: hegel.Map(g.forHeads, func(h string) opening { return opening{h + "; do", "done"} })},
+	}
+	if subshells {
+		alts = append(alts, choice[opening]{weight: 3, gen: hegel.Just(opening{"(", ")"})})
+	}
+	if cases {
+		alts = append(alts, choice[opening]{weight: 2, gen: hegel.Composite(func(tc hegel.TestCase) opening {
+			return opening{"case " + hegel.Draw(tc, g.wordTexts) + " in " + hegel.Draw(tc, g.patLists) + ")", hegel.Draw(tc, g.caseTerms) + " esac"}
+		})})
+	}
+	return weighted(alts...)
+}
+
+// flatLists: a one-line list of one or two and-or lists of simple commands
+// (one or two each, piped or joined by `&&`/`||`): a body the printer keeps
+// on its line, where the separator bugs after a closing word show.
+func flatLists(g *grammar) hegel.Generator[chain[andOr]] {
+	andOrs := hegel.Composite(func(tc hegel.TestCase) andOr {
+		a := andOrOf(pipeOf(hegel.Draw(tc, g.inlineSimples)))
+		if hegel.Draw(tc, chance(30)) {
+			a = andOr{head: a.head, tail: []link[pipeline]{{hegel.Draw(tc, pick(" && ", " || ")), pipeOf(hegel.Draw(tc, g.inlineSimples))}}}
+		} else if hegel.Draw(tc, chance(30)) {
+			a.head.cmds.tail = []link[cmd]{{hegel.Draw(tc, pipeOps(g.bash)), hegel.Draw(tc, g.inlineSimples)}}
+		}
+		return a
+	})
+	return hegel.Composite(func(tc hegel.TestCase) chain[andOr] {
+		l := listOf(hegel.Draw(tc, andOrs))
+		if hegel.Draw(tc, chance(30)) {
+			l = appendList(l, "; ", hegel.Draw(tc, andOrs))
+		}
+		return l
+	})
+}
+
+// flatLines: one to three lines of flat lists, without comments or heredocs.
+func flatLines(g *grammar) hegel.Generator[[]line] {
+	return many(hegel.Map(flatLists(g), func(l chain[andOr]) line { return line{list: l} }), 1, 3)
+}
+
+// flatItems: case items whose bodies are flat lists, on the line or as lines.
+func flatItems(g *grammar, multi bool) hegel.Generator[caseItem] {
+	return hegel.Composite(func(tc hegel.TestCase) caseItem {
+		it := caseItem{pats: hegel.Draw(tc, g.patLists), paren: hegel.Draw(tc, chance(20)), term: hegel.Draw(tc, g.caseTerms)}
+		if multi {
+			it.b = body{lines: hegel.Draw(tc, maybe(80, flatLines(g)))}
+		} else {
+			l := hegel.Draw(tc, flatLists(g))
+			it.b = body{inl: &l}
+		}
+		return it
+	})
+}
+
+// bgBodies: a flat body ending in ` &`, on the line or spanning lines.
+func bgBodies(g *grammar) hegel.Generator[bgBody] {
+	return weighted(
+		choice[bgBody]{weight: 60, gen: hegel.Map(flatLists(g), func(l chain[andOr]) bgBody { return bgBody{inl: &l} })},
+		choice[bgBody]{weight: 40, gen: hegel.Map(flatLines(g), func(ls []line) bgBody {
+			ls[len(ls)-1].term = " &"
+			return bgBody{lines: ls}
+		})},
+	)
+}
+
+// withoutHeredocs drops the lines holding a heredoc (at least one line stays).
+func withoutHeredocs(ls []line) []line {
+	ls = slices.DeleteFunc(slices.Clone(ls), func(l line) bool { return heredocOp(textNoBodies(l)) >= 0 })
+	if len(ls) == 0 {
+		ls = []line{lineOf(trueCmd)}
+	}
+	return ls
+}
+
+// ---------------------------------------------------------------------------
+// Cases.
+
+// shapeFn draws the line (or lines) holding a bug's shape from the pieces of
+// the dialect's grammar.
+type shapeFn func(tc hegel.TestCase, g *grammar) []line
+
+// around draws a program of the dialect: the lines of the shape among up to
+// two lines of surroundings (none when shrunk), at a random position, or
+// first (the position checks stop after twenty statement spans). The shape's
+// contents are a small program, a command budget of five, an eighth of a
+// wide property's program: the engine runs a failing property for a fixed
+// number of attempts, so the cost of a narrow property is the cost of a draw.
+func around(dialects hegel.Generator[bool], first bool, shape shapeFn) hegel.Generator[progCase] {
+	return hegel.Composite(func(tc hegel.TestCase) progCase {
+		bash := hegel.Draw(tc, dialects)
+		g := grammarOf(bash, false, true)
+		g.budget(5)
+		lines := surroundings(hegel.Draw(tc, many(surroundingLines(g), 0, 2)))
+		g.budget(5)
+		ls := shape(tc, g)
+		at := 0
+		if !first {
+			at = hegel.Draw(tc, positions) % (len(lines) + 1)
+		}
+		return progCase{bash: bash, prog: program{slices.Insert(lines, at, ls...)}}
+	})
+}
+
+// surroundingLines: a line of the surroundings, a simple command or two
+// joined by a separator, a blank line before some and a trailing comment on
+// some, filtered like the grammar's own lines. The grammar's full lines
+// (compounds, heredocs, bodies) would cost the shrinker ten times the draws
+// for nothing the shape needs.
+func surroundingLines(g *grammar) hegel.Generator[line] {
+	simple := hegel.Map(g.inlineSimples, lineOf)
+	pair := hegel.Composite(func(tc hegel.TestCase) line {
+		a, b := hegel.Draw(tc, g.inlineSimples), hegel.Draw(tc, g.inlineSimples)
+		return line{list: joinedBy(hegel.Draw(tc, pick("; ", " && ", " || ", " | ")), pipeOf(a), pipeOf(b))}
+	})
+	lines := hegel.Composite(func(tc hegel.TestCase) line {
+		l := hegel.Draw(tc, weighted(choice[line]{weight: 3, gen: simple}, choice[line]{weight: 1, gen: pair}))
+		l.blank = hegel.Draw(tc, chance(15))
+		l.comment = hegel.Draw(tc, maybe(20, plainComments))
+		return l
+	})
+	return hegel.Filter(lines, g.lineOK)
+}
+
+// surroundings drops the lines of a program that hold a heredoc body right
+// after a `(` (the shape of sh/27, which the parser rejects).
+func surroundings(ls []line) []line {
+	var out []line
+	for _, l := range ls {
+		w := &writer{noBodies: true}
+		l.render(w)
+		if !w.bodyAfterParen {
+			out = append(out, l)
+		}
+	}
+	return out
+}
+
+// fmtCasesOf: programs with printer options drawn from opts.
+func fmtCasesOf(progs hegel.Generator[progCase], opts hegel.Generator[printOpts]) hegel.Generator[fmtCase] {
+	return hegel.Composite(func(tc hegel.TestCase) fmtCase {
+		return fmtCase{progCase: hegel.Draw(tc, progs), opts: hegel.Draw(tc, opts), json: hegel.Draw(tc, chance(30))}
+	})
+}
+
+// optionsWith: the printer options with some forced.
+func optionsWith(set func(o *printOpts)) hegel.Generator[printOpts] {
+	return hegel.Map(printOptions, func(o printOpts) printOpts {
+		set(&o)
+		return o
+	})
+}
+
+var (
+	minifyOn     = optionsWith(func(o *printOpts) { o.minify, o.singleLine = true, false })
+	minifyOff    = optionsWith(func(o *printOpts) { o.minify = false })
+	singleLineOn = optionsWith(func(o *printOpts) { o.minify, o.singleLine = false, true })
+	linesKept    = optionsWith(func(o *printOpts) { o.minify, o.singleLine = false, false })
+)
+
+// ---------------------------------------------------------------------------
+// The properties, one per bug.
+
+// sh/1: after a `let` clause the parser rejects a trailing comment and `|&`,
+// and Minify prints `let x=1 | [ a ]` as `let x=1|[ a ]`, which it rejects.
+func TestHegelLetWithTrailingCommentsRoundTrips(t *testing.T) {
+	var variant int
+	progs := around(bashOnly, false, func(tc hegel.TestCase, g *grammar) []line {
+		variant = hegel.Draw(tc, hegel.Integers(0, 2))
+		let := rawCmd{hegel.Draw(tc, g.lets)}
+		l := line{}
+		switch variant {
+		case 0: // `let ...  # comment`, after other statements or not
+			l.list = stmt(let)
+			if prefix := hegel.Draw(tc, optional(50, g.inlineLists)); prefix != nil {
+				l.list = appendList(*prefix, "; ", andOrOf(pipeOf(let)))
+			}
+			l.comment = hegel.Draw(tc, plainComments)
+		case 1: // `let ... |& cmd`
+			l.list = joinedBy(" |& ", pipeOf(let), pipeOf(hegel.Draw(tc, g.inlineSimples)))
+		default: // Minify: `let ... | [ a ]`, `| { a; }`, `| ( a )`, `&& [[ a ]]`, `|| { a; }`
+			next := hegel.Draw(tc, weighted(
+				choice[cmd]{weight: 1, gen: hegel.Composite(func(tc hegel.TestCase) cmd {
+					return simpleCmd{call: []word{{"["}, {hegel.Draw(tc, g.wordTexts)}, {hegel.Draw(tc, pick("=", "!=", "-eq"))}, {hegel.Draw(tc, g.wordTexts)}, {"]"}}}
+				})},
+				choice[cmd]{weight: 1, gen: hegel.Map(g.inlineBodies, func(b body) cmd { return blockCmd{open: "{", close: "}", body: b} })},
+				choice[cmd]{weight: 1, gen: hegel.Map(g.inlineBodies, func(b body) cmd { return blockCmd{open: "(", close: ")", body: b} })},
+				choice[cmd]{weight: 1, gen: hegel.Map(g.tests, func(s string) cmd { return rawCmd{s} })},
+			))
+			l.list = joinedBy(hegel.Draw(tc, pick(" | ", " && ", " || ")), pipeOf(let), pipeOf(next))
+		}
+		return []line{l}
+	})
+	cases := hegel.Composite(func(tc hegel.TestCase) fmtCase {
+		c := fmtCase{progCase: hegel.Draw(tc, progs), opts: hegel.Draw(tc, printOptions), json: hegel.Draw(tc, chance(30))}
+		if variant == 2 {
+			c.opts.minify, c.opts.singleLine = true, false
+		}
+		return c
+	})
+	shapeProperty(t, "sh/1", func(ht *hegel.T) { checkFormatting(ht, hegel.Draw(ht, cases)) })
+}
+
+// sh/2: `time ! cmd` and `! ! cmd` are rejected although bash accepts them.
+func TestHegelNegationInsideTimeParses(t *testing.T) {
+	progs := around(bashOnly, false, func(tc hegel.TestCase, g *grammar) []line {
+		inner := pipeline{neg: true, cmds: chain[cmd]{head: hegel.Draw(tc, g.inlineSimples)}}
+		for range hegel.Draw(tc, hegel.Integers(0, 1)) {
+			inner.cmds.tail = append(inner.cmds.tail, link[cmd]{hegel.Draw(tc, pipeOps(true)), hegel.Draw(tc, g.inlineSimples)})
+		}
+		var c cmd = negated{inner}
+		if hegel.Draw(tc, chance(60)) {
+			c = timeCmd{flag: hegel.Draw(tc, maybe(50, lit("-p "))), p: inner}
+		}
+		outer := pipeline{neg: hegel.Draw(tc, chance(30)), cmds: chain[cmd]{head: c}}
+		return []line{{list: listOf(andOrOf(outer)), term: hegel.Draw(tc, maybe(20, pick(";", " &")))}}
+	})
+	cases := fmtCasesOf(progs, printOptions)
+	shapeProperty(t, "sh/2", func(ht *hegel.T) { checkFormatting(ht, hegel.Draw(ht, cases)) })
+}
+
+// sh/3: KeepPadding is not idempotent: a statement starting with a redirect
+// grows spaces (after `!`, a pipe, `&&`, `then` or `do` at any indentation,
+// at the start of a line with an indentation), and a subshell spanning lines
+// gets trailing spaces after `(` with an indentation of two or more.
+func TestHegelKeepPaddingReachesAFixedPoint(t *testing.T) {
+	var variant int
+	progs := around(anyDialect, false, func(tc hegel.TestCase, g *grammar) []line {
+		variant = hegel.Draw(tc, hegel.Integers(0, 2))
+		lead := namedSimple(tc, g)
+		lead.redirs = hegel.Draw(tc, many(hegel.Map(plainRedirects, func(r redirect) placed { return placed{r, 1} }), 0, 1))
+		lead = leading(lead, hegel.Draw(tc, plainRedirects))
+		switch variant {
+		case 0:
+			var list chain[andOr]
+			switch hegel.Draw(tc, hegel.Integers(0, 3)) {
+			case 0: // `! >x a`
+				list = listOf(andOrOf(pipeline{neg: true, cmds: chain[cmd]{head: lead}}))
+			case 1: // `a | >x b`
+				list = joinedBy(hegel.Draw(tc, pipeOps(g.bash)), pipeOf(hegel.Draw(tc, g.inlineSimples)), pipeOf(lead))
+			case 2: // `a && >x b`
+				list = joinedBy(hegel.Draw(tc, pick(" && ", " || ")), pipeOf(hegel.Draw(tc, g.inlineCmds)), pipeOf(lead))
+			default: // `if a; then >x b; fi`
+				bl := stmt(lead)
+				list = stmt(ifCmd{arms: []arm{{hegel.Draw(tc, g.inlineConds), body{inl: &bl}}}})
+			}
+			return []line{{list: list, term: hegel.Draw(tc, maybe(20, pick(";", " &")))}}
+		case 1: // `>x a` opening a line
+			return []line{lineOf(lead)}
+		default: // a subshell spanning lines
+			inner := withoutHeredocs(hegel.Draw(tc, g.multiBodies).lines)
+			return []line{lineOf(blockCmd{open: "(", close: ")", body: body{lines: inner}, redirs: hegel.Draw(tc, g.trailing)})}
+		}
+	})
+	cases := hegel.Composite(func(tc hegel.TestCase) fmtCase {
+		c := fmtCase{progCase: hegel.Draw(tc, progs), opts: hegel.Draw(tc, printOptions), json: hegel.Draw(tc, chance(30))}
+		c.opts.keepPadding, c.opts.minify = true, false
+		switch variant {
+		case 1:
+			c.opts.indent = hegel.Draw(tc, hegel.Integers(1, 4))
+		case 2:
+			c.opts.indent, c.opts.singleLine = hegel.Draw(tc, hegel.Integers(2, 4)), false
+		}
+		return c
+	})
+	shapeProperty(t, "sh/3", func(ht *hegel.T) { checkFormatting(ht, hegel.Draw(ht, cases)) })
+}
+
+// sh/4: the first statement of a negated pipeline starts at the `!`.
+func TestHegelNegatedPipelinesPositionTheirFirstCommand(t *testing.T) {
+	progs := around(anyDialect, true, func(tc hegel.TestCase, g *grammar) []line {
+		head := hegel.Draw(tc, weighted(
+			choice[cmd]{weight: 7, gen: g.inlineSimples},
+			choice[cmd]{weight: 3, gen: hegel.Map(g.inlineBodies, func(b body) cmd { return blockCmd{open: "{", close: "}", body: b} })},
+		))
+		p := pipeline{neg: true, cmds: chain[cmd]{head: head}}
+		for range hegel.Draw(tc, hegel.Integers(1, 2)) {
+			p.cmds.tail = append(p.cmds.tail, link[cmd]{hegel.Draw(tc, pipeOps(g.bash)), hegel.Draw(tc, g.inlineSimples)})
+		}
+		return []line{{list: listOf(andOrOf(p)), term: hegel.Draw(tc, maybe(20, pick(";", " &")))}}
+	})
+	shapeProperty(t, "sh/4", func(ht *hegel.T) { checkPositions(ht, hegel.Draw(ht, progs)) })
+}
+
+// sh/5: a heredoc body is printed inside a `$( )`, `( )`, `<( )` or
+// backquotes that follow it on the line (after `&&`, `||` or a pipe) and
+// hold a list the printer breaks across lines.
+func TestHegelHeredocBodiesBeforeSubstitutionsFormat(t *testing.T) {
+	progs := around(anyDialect, false, func(tc hegel.TestCase, g *grammar) []line {
+		first := withHeredoc(tc, g)
+		inner := twoOrMore(tc, g)
+		kinds := []string{"$(", "(", "`"}
+		if g.bash {
+			kinds = append(kinds, "<(", ">(")
+		}
+		kind := hegel.Draw(tc, pick(kinds...))
+		if kind == "`" && strings.ContainsAny(text(inner), "\\`") {
+			kind = "$("
+		}
+		var second cmd
+		switch kind {
+		case "(":
+			second = blockCmd{open: "(", close: ")", body: body{inl: &inner}}
+		case "`":
+			second = withArg(tc, namedSimple(tc, g), word{"`" + text(inner) + "`"})
+		default:
+			second = withArg(tc, namedSimple(tc, g), word{kind + text(inner) + ")"})
+		}
+		ops := []string{" && ", " || ", " | "}
+		if g.bash {
+			ops = append(ops, " |& ")
+		}
+		return []line{{list: joinedBy(hegel.Draw(tc, pick(ops...)), pipeOf(first), pipeOf(second)), term: hegel.Draw(tc, maybe(20, lit(";")))}}
+	})
+	cases := fmtCasesOf(progs, optionsWith(func(o *printOpts) { o.singleLine = false }))
+	shapeProperty(t, "sh/5", func(ht *hegel.T) { checkFormatting(ht, hegel.Draw(ht, cases)) })
+}
+
+// sh/6: a comment ending in a backslash swallows the next line into the
+// command.
+func TestHegelBackslashEndedCommentsEndAtTheNewline(t *testing.T) {
+	progs := around(anyDialect, false, func(tc hegel.TestCase, g *grammar) []line {
+		first := lineOf(literalName(unassigned(namedSimple(tc, g))))
+		if hegel.Draw(tc, chance(30)) {
+			first.list = appendList(first.list, hegel.Draw(tc, pick("; ", " && ")), andOrOf(pipeOf(literalName(unassigned(namedSimple(tc, g))))))
+		}
+		first.comment = hegel.Draw(tc, weighted(
+			choice[string]{weight: 20, gen: lit(`#\`)},
+			choice[string]{weight: 80, gen: wrap("# ", pick(commentTexts...), `\`)},
+		))
+		next := literalName(unassigned(namedSimple(tc, g)))
+		next.redirs = nil
+		second := lineOf(next)
+		if hegel.Draw(tc, chance(30)) {
+			second.list = appendList(second.list, hegel.Draw(tc, pick("; ", " | ")), hegel.Draw(tc, g.inlineAndOrs))
+		}
+		return []line{first, second}
+	})
+	cases := fmtCasesOf(progs, minifyOff)
+	shapeProperty(t, "sh/6", func(ht *hegel.T) { checkFormatting(ht, hegel.Draw(ht, cases)) })
+}
+
+// sh/7: a comment after a heredoc redirect at the end of a pipeline or
+// and-or list is dropped or moved.
+func TestHegelCommentsAfterHeredocLinesStayOnTheirStatement(t *testing.T) {
+	progs := around(anyDialect, false, func(tc hegel.TestCase, g *grammar) []line {
+		head := pipeOf(hegel.Draw(tc, g.inlineSimples))
+		head.neg = hegel.Draw(tc, chance(20))
+		last := hegel.Draw(tc, weighted(
+			choice[cmd]{weight: 7, gen: g.inlineSimples},
+			choice[cmd]{weight: 3, gen: hegel.Map(g.inlineBodies, func(b body) cmd { return blockCmd{open: "{", close: "}", body: b} })},
+		))
+		ops := []string{" | ", " && ", " || "}
+		if g.bash {
+			ops = append(ops, " |& ")
+		}
+		return []line{{
+			list:    joinedBy(hegel.Draw(tc, pick(ops...)), head, pipeOf(last)),
+			hdoc:    ptrTo(hegel.Draw(tc, g.heredocs)),
+			term:    hegel.Draw(tc, maybe(30, lit(";"))),
+			comment: hegel.Draw(tc, plainComments),
+		}}
+	})
+	cases := fmtCasesOf(progs, minifyOff)
+	shapeProperty(t, "sh/7", func(ht *hegel.T) { checkFormatting(ht, hegel.Draw(ht, cases)) })
+}
