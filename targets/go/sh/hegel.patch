+// sh/9: a process substitution glued to other parts of a word is printed with
+// a space before it, turning one argument into two.
+func TestHegelPinGluedProcessSubstitutionsStayOneWord(t *testing.T) {
+	for _, src := range []string{"echo <(a)<(b)\n", "echo $(a)<(b)\n", "echo $x<(a)<(b)\n", "x[1]=<(a)\n"} {
+		f, err := syntax.NewParser().Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		call := f.Stmts[0].Cmd.(*syntax.CallExpr)
+		want := len(call.Args) + len(call.Assigns)
+		for _, mode := range []struct {
+			name string
+			opts []syntax.PrinterOption
+		}{{"default", nil}, {"minify", []syntax.PrinterOption{syntax.Minify(true)}}} {
+			out, err := printNode(syntax.NewPrinter(mode.opts...), f)
+			if err != nil {
+				t.Fatalf("Print: %v", err)
+			}
+			f2, err := syntax.NewParser().Parse(strings.NewReader(out), "")
+			if err != nil {
+				t.Errorf("%s print of %q is %q, which does not parse: %v", mode.name, src, out, err)
+				continue
+			}
+			call2 := f2.Stmts[0].Cmd.(*syntax.CallExpr)
+			if got := len(call2.Args) + len(call2.Assigns); got != want {
+				t.Errorf("%s print of %q is %q: %d words instead of %d", mode.name, src, out, got, want)
+			}
+		}
+	}
+}
