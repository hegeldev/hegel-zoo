+// sh/7: a comment after a heredoc redirect at the end of a pipeline or and-or
+// list is dropped by the printer, or moved into a subshell that starts it.
+func TestHegelPinCommentsAfterHeredocsAreKept(t *testing.T) {
+	for _, src := range []string{"a | b <<EOF # c\nbody\nEOF\n", "a && b <<EOF # c\nbody\nEOF\n", "( a; ) | b <<-EOF; # c\n\tbody\n\tEOF\n"} {
+		f, err := syntax.NewParser(syntax.KeepComments(true)).Parse(strings.NewReader(src), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", src, err)
+		}
+		if len(f.Stmts) != 1 || len(f.Stmts[0].Comments) != 1 {
+			t.Fatalf("Parse(%q): the comment is not on the single statement: %s", src, shape(f))
+		}
+		out := defaultPrint(f)
+		f2, err := syntax.NewParser(syntax.KeepComments(true)).Parse(strings.NewReader(out), "")
+		if err != nil {
+			t.Fatalf("Parse(%q): %v", out, err)
+		}
+		if len(f2.Stmts) != 1 || len(f2.Stmts[0].Comments) != 1 || f2.Stmts[0].Comments[0].Text != " c" {
+			t.Errorf("printing %q gives %q: the trailing comment is no longer on the statement", src, out)
+		}
+	}
+}
