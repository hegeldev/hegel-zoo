+package hegel
+
+// The model side: an expression tree of our own, its rendering to bexpr source as a pure
+// function of the tree and a drawn tape of spelling choices, the conversion of the package's
+// AST back to ours, generated data, generated expressions (drawn as recipes with no data behind
+// them and resolved against a datum by a pure function), and a model evaluator written from
+// evaluate.go's documented rules (README, the comments in evaluate.go, grammar/ast.go's
+// NotPresentDisposition).
+//
+// The shapes of the recorded bugs are drawn by default: the renderer names the shape of a
+// rendering it chose (a double-quoted value spelling a JSON pointer, a collection expression
+// as an operand without parentheses, a double-quoted string holding a quote, a number right
+// before a closing brace) and the model names the shape of a rule it applied (a nil or a nested
+// element under `in`, `is nil` on an array, `as k, k` over an empty collection, `matches` on a
+// nil value), so that a property failing on a case can name the bug. Under HEGEL_NO_KNOWN=1 the
+// Known switches steer the renderer off the first four and make the model reproduce the other
+// five.
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/hashicorp/go-bexpr/grammar"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- expression trees
+
+type node interface{}
+
+type selector struct {
+	ptr  bool // rendered as a JSON pointer
+	path []string
+}
+
+type matchN struct {
+	sel selector
+	op  grammar.MatchOperator
+	val string // Raw; unused for is-empty / is-nil
+}
+
+type notN struct{ x node }
+
+type binN struct {
+	op   grammar.BinaryOperator
+	l, r node
+}
+
+type collN struct {
+	op            grammar.CollectionOperator
+	sel           selector
+	mode          grammar.CollectionBindMode
+	def, idx, val string
+	inner         node
+}
+
+// hasValue reports whether the operator takes a value.
+func hasValue(op grammar.MatchOperator) bool {
+	switch op {
+	case grammar.MatchIsEmpty, grammar.MatchIsNotEmpty, grammar.MatchIsNil, grammar.MatchIsNotNil:
+		return false
+	}
+	return true
+}
+
+// fromGrammar converts the package's AST to ours.
+func fromGrammar(e grammar.Expression) (node, error) {
+	switch x := e.(type) {
+	case *grammar.UnaryExpression:
+		if x.Operator != grammar.UnaryOpNot {
+			return nil, fmt.Errorf("unary operator %v", x.Operator)
+		}
+		in, err := fromGrammar(x.Operand)
+		if err != nil {
+			return nil, err
+		}
+		return notN{in}, nil
+	case *grammar.BinaryExpression:
+		l, err := fromGrammar(x.Left)
+		if err != nil {
+			return nil, err
+		}
+		r, err := fromGrammar(x.Right)
+		if err != nil {
+			return nil, err
+		}
+		return binN{x.Operator, l, r}, nil
+	case *grammar.MatchExpression:
+		m := matchN{sel: selector{x.Selector.Type == grammar.SelectorTypeJsonPointer, x.Selector.Path}, op: x.Operator}
+		if hasValue(x.Operator) {
+			if x.Value == nil {
+				return nil, errors.New("match without value")
+			}
+			m.val = x.Value.Raw
+		} else if x.Value != nil {
+			return nil, errors.New("value on a unary match")
+		}
+		return m, nil
+	case *grammar.CollectionExpression:
+		in, err := fromGrammar(x.Inner)
+		if err != nil {
+			return nil, err
+		}
+		return collN{x.Op, selector{x.Selector.Type == grammar.SelectorTypeJsonPointer, x.Selector.Path}, x.NameBinding.Mode,
+			x.NameBinding.Default, x.NameBinding.Index, x.NameBinding.Value, in}, nil
+	}
+	return nil, fmt.Errorf("unknown node %T", e)
+}
+
+// same compares two trees.
+func same(want, got node) bool {
+	switch w := want.(type) {
+	case matchN:
+		g, ok := got.(matchN)
+		return ok && w.op == g.op && w.val == g.val && sameSel(w.sel, g.sel)
+	case notN:
+		g, ok := got.(notN)
+		return ok && same(w.x, g.x)
+	case binN:
+		g, ok := got.(binN)
+		return ok && w.op == g.op && same(w.l, g.l) && same(w.r, g.r)
+	case collN:
+		g, ok := got.(collN)
+		return ok && w.op == g.op && w.mode == g.mode && w.def == g.def && w.idx == g.idx && w.val == g.val && sameSel(w.sel, g.sel) && same(w.inner, g.inner)
+	}
+	return false
+}
+
+func sameSel(w, g selector) bool {
+	return w.ptr == g.ptr && strings.Join(w.path, "\x00") == strings.Join(g.path, "\x00")
+}
+
+func dump(n node) string {
+	switch x := n.(type) {
+	case matchN:
+		if hasValue(x.op) {
+			return fmt.Sprintf("Match(%v %s %q)", x.sel.path, x.op, x.val)
+		}
+		return fmt.Sprintf("Match(%v %s)", x.sel.path, x.op)
+	case notN:
+		return "Not(" + dump(x.x) + ")"
+	case binN:
+		return fmt.Sprintf("%s(%s, %s)", x.op, dump(x.l), dump(x.r))
+	case collN:
+		return fmt.Sprintf("%s(%v as %s/%q/%q/%q { %s })", x.op, x.sel.path, x.mode, x.def, x.idx, x.val, dump(x.inner))
+	}
+	return fmt.Sprintf("%#v", n)
+}
+
+// --------------------------------------------------------------------------- lexical classes
+
+var (
+	identRe  = regexp.MustCompile(`^[a-zA-Z][a-zA-Z0-9_/]*$`)
+	digitsRe = regexp.MustCompile(`^[0-9]+$`)
+	numberRe = regexp.MustCompile(`^-?(0|[1-9][0-9]*)(\.[0-9]+)?$`)
+	ptrSegRe = regexp.MustCompile(`^[\pL\pN\-_.~:|]+$`)
+	// pointerValueRe: a text the grammar's JSON pointer selector rule reads when it is
+	// double-quoted (go-bexpr/1): segments of letters, digits and -_.~:| after slashes.
+	pointerValueRe = regexp.MustCompile(`^(/[\pL\pN\-_.~:|]+)+$`)
+	keywords       = map[string]bool{"not": true, "and": true, "or": true, "any": true, "all": true, "as": true, "in": true, "is": true, "empty": true, "nil": true, "contains": true, "matches": true}
+	varNames       = []string{"v", "w", "k", "i", "item", "x", "k2"}
+	keyNames       = []string{"a", "b", "c", "k", "x", "ab", "a_b", "A1", "a/b", "a b", "0", "", "~x", "d.e", "q\"r", "s`t", "/p"}
+	// topKeys: a selector starts with an identifier, so the top-level keys are identifiers
+	topKeys   = []string{"a", "b", "c", "k", "x", "ab", "a_b", "A1", "a/b", "v"}
+	wsChoices = []string{" ", " ", " ", "\t", "\n", "  ", " \n "}
+)
+
+func isIdent(s string) bool { return identRe.MatchString(s) && !keywords[s] }
+
+// bareSelectorValue reports whether s renders unquoted as a dotted selector (the first alternative
+// of Value): identifiers and digit runs joined by dots, the first an identifier.
+func bareSelectorValue(s string) bool {
+	parts := strings.Split(s, ".")
+	if !isIdent(parts[0]) {
+		return false
+	}
+	for _, p := range parts[1:] {
+		if !isIdent(p) && !digitsRe.MatchString(p) {
+			return false
+		}
+	}
+	return true
+}
+
+// pointerable reports whether a selector can be written as a JSON pointer.
+func pointerable(path []string) bool {
+	for _, p := range path {
+		if !ptrSegRe.MatchString(escapePointer(p)) {
+			return false
+		}
+	}
+	return true
+}
+
+func escapePointer(p string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(p, "~", "~0"), "/", "~1")
+}
+
+// rawable reports whether s can be written as a raw (backtick) string literal: strconv.Unquote
+// wants valid UTF-8 and no backtick, and drops carriage returns.
+func rawable(s string) bool {
+	return utf8.ValidString(s) && !strings.Contains(s, "`") && !strings.Contains(s, "\r")
+}
+
+// --------------------------------------------------------------------------- rendering
+
+// writer renders a tree, reading every spelling choice from a tape of die rolls (0..99)
+// consumed in order and recycled modulo its length. An empty tape rolls 0 every time, which is
+// the plain spelling: single spaces, no optional whitespace, dotted selectors, bare values where
+// the grammar allows them, double quotes, no parentheses, `value in selector`.
+type writer struct {
+	tape   []int
+	at     int
+	b      strings.Builder
+	shapes []string
+	number bool // the last token written is a bare number literal
+}
+
+func (w *writer) next() int {
+	if len(w.tape) == 0 {
+		return 0
+	}
+	v := w.tape[w.at%len(w.tape)]
+	w.at++
+	return v
+}
+
+// coin is true pct percent of the rolls (a roll of 0 is false).
+func (w *writer) coin(pct int) bool { return w.next() >= 100-pct }
+
+// choose is an index below n (a roll of 0 is the first).
+func (w *writer) choose(n int) int { return w.next() % n }
+
+func (w *writer) shape(id string) {
+	if !slices.Contains(w.shapes, id) {
+		w.shapes = append(w.shapes, id)
+	}
+}
+
+func (w *writer) str(s string) {
+	w.b.WriteString(s)
+	w.number = false
+}
+
+func (w *writer) ws() { w.str(wsChoices[w.choose(len(wsChoices))]) }
+
+func (w *writer) ows() { // optional whitespace
+	if w.coin(30) {
+		w.ws()
+	}
+}
+
+// quote renders s as a string literal, raw half the time when it can be. A double-quoted value
+// spelling a JSON pointer is go-bexpr/1's shape and a double-quoted string holding a quote is
+// go-bexpr/4's; under HEGEL_NO_KNOWN=1 both are written raw (a pointer text is always rawable;
+// fixValue has kept the quote out of a string that is not).
+func (w *writer) quote(s string, isValue bool) string {
+	pointer := isValue && pointerValueRe.MatchString(s)
+	quoted := strings.Contains(s, "\"")
+	raw := w.coin(50) || (Known.slashStringIsPointer && pointer) || (Known.escapedQuoteUnparsable && quoted)
+	if raw && rawable(s) {
+		return "`" + s + "`"
+	}
+	if pointer {
+		w.shape("go-bexpr/1")
+	}
+	if quoted {
+		w.shape("go-bexpr/4")
+	}
+	return strconv.Quote(s)
+}
+
+func (w *writer) selector(sel selector) {
+	if sel.ptr {
+		w.str("\"")
+		for _, p := range sel.path {
+			w.str("/" + escapePointer(p))
+		}
+		w.str("\"")
+		return
+	}
+	w.str(sel.path[0])
+	for _, p := range sel.path[1:] {
+		if (isIdent(p) || digitsRe.MatchString(p)) && w.coin(70) {
+			w.str("." + p)
+			continue
+		}
+		w.str("[")
+		w.ows()
+		w.str(w.quote(p, false))
+		w.ows()
+		w.str("]")
+	}
+}
+
+// value renders a match value: bare when it reads as a selector or a number, quoted otherwise.
+func (w *writer) value(v string) {
+	switch {
+	case bareSelectorValue(v) && w.coin(80):
+		w.str(v)
+	case numberRe.MatchString(v) && w.coin(85):
+		w.str(v)
+		w.number = true
+	default:
+		w.str(w.quote(v, true))
+	}
+}
+
+func (w *writer) keyword(k string) { w.ws(); w.str(k); w.ws() }
+
+var (
+	inWords       = map[grammar.MatchOperator]string{grammar.MatchIn: "in", grammar.MatchNotIn: "not in"}
+	containsWords = map[grammar.MatchOperator]string{grammar.MatchIn: "contains", grammar.MatchNotIn: "not contains"}
+	equalWords    = map[grammar.MatchOperator]string{grammar.MatchEqual: "==", grammar.MatchNotEqual: "!="}
+)
+
+// expr renders n; ctx tells where it stands so that grouping keeps the tree: "or-left",
+// "or-right", "and-left", "and-right", "not", "top", "inner". An or needs parentheses
+// everywhere but at the top, in a body or as the right operand of or; an and as the left
+// operand of and or under not. A collection expression stands alone, in parentheses, or (as
+// the grammar has it) as the right operand of or: anywhere else without parentheses is
+// go-bexpr/2's shape, which the renderer avoids under HEGEL_NO_KNOWN=1.
+func (w *writer) expr(n node, ctx string) {
+	paren := w.coin(15)
+	switch x := n.(type) {
+	case binN:
+		if x.op == grammar.BinaryOpOr && ctx != "top" && ctx != "inner" && ctx != "or-right" {
+			paren = true
+		}
+		if x.op == grammar.BinaryOpAnd && (ctx == "and-left" || ctx == "not") {
+			paren = true
+		}
+	case collN:
+		if ctx != "top" && ctx != "inner" && ctx != "or-right" {
+			if Known.collectionNeedsParens {
+				paren = true
+			} else if !paren {
+				w.shape("go-bexpr/2")
+			}
+		}
+	}
+	if paren {
+		w.str("(")
+		w.ows()
+		defer func() { w.ows(); w.str(")") }()
+		ctx = "inner"
+	}
+	switch x := n.(type) {
+	case matchN:
+		if x.op == grammar.MatchIn || x.op == grammar.MatchNotIn {
+			// two spellings: `value in selector` and `selector contains value`
+			if !w.coin(50) {
+				w.value(x.val)
+				w.keyword(inWords[x.op])
+				w.selector(x.sel)
+			} else {
+				w.selector(x.sel)
+				w.keyword(containsWords[x.op])
+				w.value(x.val)
+			}
+			return
+		}
+		w.selector(x.sel)
+		switch x.op {
+		case grammar.MatchEqual, grammar.MatchNotEqual:
+			w.ows()
+			w.str(equalWords[x.op])
+			w.ows()
+			w.value(x.val)
+		case grammar.MatchMatches:
+			w.keyword("matches")
+			w.value(x.val)
+		case grammar.MatchNotMatches:
+			w.keyword("not matches")
+			w.value(x.val)
+		case grammar.MatchIsEmpty:
+			w.keyword("is")
+			w.str("empty")
+		case grammar.MatchIsNotEmpty:
+			w.keyword("is")
+			w.str("not")
+			w.ws()
+			w.str("empty")
+		case grammar.MatchIsNil:
+			w.keyword("is")
+			w.str("nil")
+		case grammar.MatchIsNotNil:
+			w.keyword("is")
+			w.str("not")
+			w.ws()
+			w.str("nil")
+		}
+	case notN:
+		w.str("not")
+		w.ws()
+		w.expr(x.x, "not")
+	case binN:
+		if x.op == grammar.BinaryOpOr {
+			w.expr(x.l, "or-left")
+			w.keyword("or")
+			w.expr(x.r, "or-right")
+		} else {
+			w.expr(x.l, "and-left")
+			w.keyword("and")
+			w.expr(x.r, "and-right")
+		}
+	case collN:
+		w.str(strings.ToLower(string(x.op)))
+		w.ws()
+		w.selector(x.sel)
+		w.keyword("as")
+		switch x.mode {
+		case grammar.CollectionBindDefault:
+			w.str(x.def)
+		case grammar.CollectionBindIndex:
+			w.str(x.idx)
+			w.ows()
+			w.str(",")
+			w.ows()
+			w.str("_")
+		case grammar.CollectionBindValue:
+			w.str("_")
+			w.ows()
+			w.str(",")
+			w.ows()
+			w.str(x.val)
+		case grammar.CollectionBindIndexAndValue:
+			w.str(x.idx)
+			w.ows()
+			w.str(",")
+			w.ows()
+			w.str(x.val)
+		}
+		w.ows()
+		w.str("{")
+		w.ows()
+		w.expr(x.inner, "inner")
+		// a number right before the closing brace is go-bexpr/5's shape; under
+		// HEGEL_NO_KNOWN=1 whitespace keeps them apart
+		if Known.numberBeforeBrace && w.number {
+			w.ws()
+		} else {
+			number := w.number
+			w.ows()
+			if number && w.number {
+				w.shape("go-bexpr/5")
+			}
+		}
+		w.str("}")
+	}
+}
+
+// render writes n as source with the spelling the tape chooses (optional outer parentheses
+// and surrounding whitespace included), and names the shapes of the recorded bugs it wrote.
+func render(n node, tape []int) (string, []string) {
+	w := &writer{tape: tape}
+	w.ows()
+	if w.coin(10) {
+		w.str("(")
+		w.ows()
+		w.expr(n, "inner")
+		w.ows()
+		w.str(")")
+	} else {
+		w.expr(n, "top")
+	}
+	w.ows()
+	return w.b.String(), w.shapes
+}
+
+// --------------------------------------------------------------------------- data
+
+// Values of every kind the evaluator reads through reflection: nils, bools, ints of two
+// widths, uints, floats of two widths, texts of the pieces that matter to the grammar and the
+// coercions; and containers of them to a bounded depth - interface slices (with a nil or a
+// nested container put among the elements now and then, go-bexpr/3's and /7's shapes), typed
+// slices, Go arrays (go-bexpr/6's), typed and interface maps, some of the slices and maps nil.
+
+var (
+	textPieces = []string{"a", "b", "c", "x", "0", "1", "16", "-", ".", "/", " ", "\"", "`", "~", "\\", "\n", "\t", "\r", "Z", "\u00e9", "\u65e5", "$", "*", "(", "[", "^"}
+	texts      = joined(upTo(pick(textPieces...), 6))
+	keys       = pick(keyNames...)
+	smallInts  = hegel.Integers(-3, 20)
+	fractions  = hegel.Map(pairs(hegel.Integers(-20, 20), pick(1.0, 2.0, 4.0, 10.0)), func(p pair[int, float64]) float64 { return float64(p.a) / p.b })
+
+	scalars = weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{1, asAny(smallInts)},
+		choice[any]{1, asAny(hegel.Map(hegel.Integers(-128, 127), func(n int) int8 { return int8(n) }))},
+		choice[any]{1, asAny(hegel.Map(hegel.Integers(0, 300), func(n int) uint { return uint(n) }))},
+		choice[any]{1, asAny(fractions)},
+		choice[any]{1, asAny(hegel.Map(fractions, func(f float64) float32 { return float32(f) }))},
+		choice[any]{2, asAny(texts)},
+	)
+
+	// Lists and Maps yield nil for zero elements; the data tells a nil container from an
+	// empty one, so the nil ones are explicit alternatives.
+	intSlices = hegel.Map(pairs(chance(15), upTo(smallInts, 4)), func(p pair[bool, []int]) any {
+		if p.a {
+			return []int(nil)
+		}
+		return nonNilSlice(p.b)
+	})
+	stringSlices = hegel.Map(upTo(texts, 3), func(xs []string) any { return nonNilSlice(xs) })
+	arrays       = weighted(
+		choice[any]{1, hegel.Just[any]([0]int{})},
+		choice[any]{1, hegel.Map(pairs(hegel.Integers(0, 5), hegel.Integers(0, 5)), func(p pair[int, int]) any { return [2]int{p.a, p.b} })},
+		choice[any]{1, hegel.Map(texts, func(s string) any { return [1]string{s} })},
+	)
+	intMaps    = hegel.Map(mapsUpTo(keys, smallInts, 3), func(m map[string]int) any { return nonNilMap(m) })
+	stringMaps = hegel.Map(pairs(chance(15), mapsUpTo(keys, texts, 3)), func(p pair[bool, map[string]string]) any {
+		if p.a {
+			return map[string]string(nil)
+		}
+		return nonNilMap(p.b)
+	})
+)
+
+func nonNilSlice[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[V any](m map[string]V) map[string]V {
+	if m == nil {
+		return map[string]V{}
+	}
+	return m
+}
+
+// insertion is an element put into an interface slice at a position taken modulo its length:
+// a nil, or a nested container (a one-element slice or map) around a value.
+type insertion struct {
+	at    int
+	elem  any
+	asMap bool
+}
+
+func (in insertion) into(xs []any) any {
+	elem := in.elem
+	if in.asMap {
+		elem = map[string]any{"a": in.elem}
+	} else if elem != nil {
+		elem = []any{in.elem}
+	}
+	return slices.Insert(slices.Clone(nonNilSlice(xs)), in.at%(len(xs)+1), elem)
+}
+
+// ifaceSlicesOf is a []interface{} of up to four values; three times in twenty with a nil put
+// among them (go-bexpr/3's shape under `in`), three times in twenty with a nested container
+// (go-bexpr/7's).
+func ifaceSlicesOf(child hegel.Generator[any]) hegel.Generator[any] {
+	nils := hegel.Map(positions, func(at int) insertion { return insertion{at: at} })
+	nested := hegel.Composite(func(tc hegel.TestCase) insertion {
+		return insertion{at: hegel.Draw(tc, positions), elem: hegel.Draw(tc, child), asMap: hegel.Draw(tc, chance(50))}
+	})
+	with := func(ins hegel.Generator[insertion]) hegel.Generator[any] {
+		return hegel.Map(pairs(upTo(child, 4), ins), func(p pair[[]any, insertion]) any { return p.b.into(p.a) })
+	}
+	return weighted(
+		choice[any]{70, hegel.Map(upTo(child, 4), func(xs []any) any { return nonNilSlice(xs) })},
+		choice[any]{15, with(nils)},
+		choice[any]{15, with(nested)},
+	)
+}
+
+func ifaceMapsOf(child hegel.Generator[any]) hegel.Generator[any] {
+	return hegel.Map(mapsUpTo(keys, child, 4), func(m map[string]any) any { return nonNilMap(m) })
+}
+
+func containersOf(child hegel.Generator[any]) hegel.Generator[any] {
+	return weighted(
+		choice[any]{2, ifaceSlicesOf(child)},
+		choice[any]{1, intSlices},
+		choice[any]{1, stringSlices},
+		choice[any]{1, arrays},
+		choice[any]{1, intMaps},
+		choice[any]{1, stringMaps},
+		choice[any]{1, ifaceMapsOf(child)},
+	)
+}
+
+// valueTower is the values of the given depth: scalars at depth 0, and above that a scalar or
+// a container of values one level down (an eager tower, since a self-referencing package-level
+// generator is an init cycle).
+func valueTower(depth int) hegel.Generator[any] {
+	g := scalars
+	for d := 0; d < depth; d++ {
+		g = weighted(choice[any]{45, scalars}, choice[any]{55, containersOf(g)})
+	}
+	return g
+}
+
+var (
+	values = valueTower(2)
+	datums = hegel.Maps(pick(topKeys...), values).MinSize(1).MaxSize(5)
+)
+
+// paths lists every path into v (including the empty path for v itself) with its value.
+type pathVal struct {
+	path []string
+	val  any
+}
+
+func paths(v any, prefix []string) []pathVal {
+	out := []pathVal{{slices.Clone(prefix), v}}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Map:
+		for _, k := range sortedKeys(rv) {
+			out = append(out, paths(rv.MapIndex(k).Interface(), append(slices.Clone(prefix), k.String()))...)
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < rv.Len(); i++ {
+			out = append(out, paths(rv.Index(i).Interface(), append(slices.Clone(prefix), strconv.Itoa(i)))...)
+		}
+	}
+	return out
+}
+
+func sortedKeys(rv reflect.Value) []reflect.Value {
+	keys := rv.MapKeys()
+	sort.Slice(keys, func(i, j int) bool { return keys[i].String() < keys[j].String() })
+	return keys
+}
+
+func isContainer(v any) bool {
+	switch reflect.ValueOf(v).Kind() {
+	case reflect.Map, reflect.Slice, reflect.Array:
+		return true
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- expression recipes
+
+// An expression is drawn as a recipe with no data behind it: each selector names a path of the
+// datum, a binding in scope or a fresh path by an index taken modulo the live count, and each
+// operator and value a form fitted to the target's kind, so that one package-level generator
+// serves every datum; scope.resolve turns a recipe into a tree against a datum. The recipes
+// are depth-indexed: exprTower(d) is a match at depth 0 and a match, a not, an and/or or a
+// collection expression over recipes one level down above that.
+
+type expr interface{}
+
+// target is a selector recipe.
+type target struct {
+	src    int  // fromDatum, fromBinding (the datum when none is in scope) or fresh
+	idx    int  // which path or binding, modulo the live count
+	sub    int  // the sub-path under an alias binding, or the tail of a fresh path, modulo the count
+	deep   bool // a sub-path under a key or index binding (an error)
+	extend bool // a fresh path appended to a path of the datum
+	ptr    bool // the JSON pointer spelling, where the path allows it
+}
+
+const (
+	fromDatum   = iota // an existing path of the datum
+	fromBinding        // a variable of an enclosing collection expression
+	fresh              // a missing key, an out-of-range index, a path through a scalar
+)
+
+// valueR is a match value recipe: a form fitted to the target's kind (equal to it, a neighbour,
+// a spelling the coercions accept, a substring or a regular expression of a text, an element or
+// a key of a container), or a text as it is.
+type valueR struct {
+	kind     string // "fitted" or "text"
+	form     int    // the fitted form, modulo the kind's forms (a stranger for an unknown target)
+	at, span int    // the substring of a text target; the element or key of a container target
+	text     string
+}
+
+// opR is a match operator recipe: one suited to the target's kind, or any of them.
+type opR struct {
+	any bool
+	idx int
+}
+
+type matchR struct {
+	t   target
+	op  opR
+	val valueR
+}
+
+type notR struct{ x expr }
+
+type binR struct {
+	op   grammar.BinaryOperator
+	l, r expr
+}
+
+// collR is a collection expression recipe: the names are the index (or default) binding and
+// the value binding, elem the element whose value stands for the bindings when sub-paths under
+// them are resolved.
+type collR struct {
+	op       grammar.CollectionOperator
+	t        target
+	mode     grammar.CollectionBindMode
+	idx, val string
+	elem     int
+	inner    expr
+}
+
+var (
+	strangers   = []string{"1", "0", "-1", "16", "1.5", "true", "false", "T", "x", "a", "abc", "0x10", "1_6", "", "a b", "/p", "^a", "[0-9]+", "(", "99999999999999999999", "1e3", "NaN"}
+	regexValues = []string{"a", ".", "[a-c]+", "x$", "(", "\\d"}
+	freshNames  = []string{"zz", "a", "b", "missing"}
+	freshTails  = []string{"zz", "9", "0", "q"}
+
+	targets = hegel.Composite(func(tc hegel.TestCase) target {
+		return target{
+			src:    hegel.Draw(tc, weighted(choice[int]{45, hegel.Just(fromDatum)}, choice[int]{40, hegel.Just(fromBinding)}, choice[int]{15, hegel.Just(fresh)})),
+			idx:    hegel.Draw(tc, positions),
+			sub:    hegel.Draw(tc, positions),
+			deep:   hegel.Draw(tc, chance(10)),
+			extend: hegel.Draw(tc, chance(70)),
+			ptr:    hegel.Draw(tc, chance(25)),
+		}
+	})
+
+	// pointerTexts: a text that spells a JSON pointer, go-bexpr/1's shape as a double-quoted
+	// value; quotedTexts: a text holding a double quote, go-bexpr/4's shape.
+	pointerTexts = joined(between(hegel.Map(hegel.Text().Alphabet("ab0-_.~:|\u00e9").MinSize(1).MaxSize(3), func(s string) string { return "/" + s }), 1, 2))
+	quotedTexts  = hegel.Map(pairs(shortTexts, shortTexts), func(p pair[string, string]) string { return p.a + "\"" + p.b })
+	shortTexts   = joined(upTo(pick("a", "b", "\\", "`", " "), 2))
+
+	fittedValues = hegel.Composite(func(tc hegel.TestCase) valueR {
+		return valueR{kind: "fitted", form: hegel.Draw(tc, positions), at: hegel.Draw(tc, positions), span: hegel.Draw(tc, positions)}
+	})
+	textValues = hegel.Map(weighted(
+		choice[string]{40, pick(strangers...)},
+		choice[string]{30, texts},
+		choice[string]{15, pointerTexts},
+		choice[string]{15, quotedTexts},
+	), func(s string) valueR { return valueR{kind: "text", text: s} })
+	matchValues = weighted(choice[valueR]{65, fittedValues}, choice[valueR]{35, textValues})
+
+	matchOps = hegel.Composite(func(tc hegel.TestCase) opR {
+		return opR{any: hegel.Draw(tc, chance(15)), idx: hegel.Draw(tc, hegel.Integers(0, 9))}
+	})
+
+	matches = asExpr(hegel.Composite(func(tc hegel.TestCase) matchR {
+		return matchR{t: hegel.Draw(tc, targets), op: hegel.Draw(tc, matchOps), val: hegel.Draw(tc, matchValues)}
+	}))
+
+	// bindNames: two distinct names most of the time; the same name for the index and the
+	// value one time in five (go-bexpr/8's shape over an empty collection).
+	distinctNames = hegel.Map(pairs(pick(varNames...), pick(varNames...)), func(p pair[string, string]) pair[string, string] {
+		if p.a == p.b {
+			p.b = p.a + "2"
+		}
+		return p
+	})
+	sameNames = hegel.Map(pick(varNames...), func(n string) pair[string, string] { return pair[string, string]{n, n} })
+	bindNames = weighted(choice[pair[string, string]]{80, distinctNames}, choice[pair[string, string]]{20, sameNames})
+	bindModes = pick(grammar.CollectionBindDefault, grammar.CollectionBindIndex, grammar.CollectionBindValue, grammar.CollectionBindIndexAndValue)
+	collOps   = pick(grammar.CollectionOpAny, grammar.CollectionOpAll)
+	binOps    = pick(grammar.BinaryOpAnd, grammar.BinaryOpOr)
+
+	exprs = exprTower(3)
+)
+
+func asExpr[T any](g hegel.Generator[T]) hegel.Generator[expr] {
+	return hegel.Map(g, func(x T) expr { return x })
+}
+
+// notsOf is a negation of inner; not not x is x in the package's AST, so a negation is not
+// negated again.
+func notsOf(inner hegel.Generator[expr]) hegel.Generator[expr] {
+	return hegel.Map(inner, func(x expr) expr {
+		if _, ok := x.(notR); ok {
+			return x
+		}
+		return notR{x}
+	})
+}
+
+func binsOf(inner hegel.Generator[expr]) hegel.Generator[expr] {
+	return asExpr(hegel.Composite(func(tc hegel.TestCase) binR {
+		return binR{op: hegel.Draw(tc, binOps), l: hegel.Draw(tc, inner), r: hegel.Draw(tc, inner)}
+	}))
+}
+
+func collsOf(inner hegel.Generator[expr]) hegel.Generator[expr] {
+	return asExpr(hegel.Composite(func(tc hegel.TestCase) collR {
+		names := hegel.Draw(tc, bindNames)
+		return collR{
+			op:    hegel.Draw(tc, collOps),
+			t:     hegel.Draw(tc, targets),
+			mode:  hegel.Draw(tc, bindModes),
+			idx:   names.a,
+			val:   names.b,
+			elem:  hegel.Draw(tc, positions),
+			inner: hegel.Draw(tc, inner),
+		}
+	}))
+}
+
+// exprTower is the expression recipes of the given depth: a match at depth 0; a match half
+// the time, a negation, a binary expression or a collection expression over recipes one level
+// down above that.
+func exprTower(depth int) hegel.Generator[expr] {
+	g := matches
+	for d := 0; d < depth; d++ {
+		g = weighted(choice[expr]{50, matches}, choice[expr]{12, notsOf(g)}, choice[expr]{22, binsOf(g)}, choice[expr]{16, collsOf(g)})
+	}
+	return g
+}
+
+// --------------------------------------------------------------------------- resolving recipes
+
+// binding is a collection variable in scope: a value (map key or slice index) or an alias of a
+// path into the datum; sample is a value the alias stands for, for resolving sub-paths.
+type binding struct {
+	name   string
+	isVal  bool
+	value  any
+	path   []string
+	sample any
+}
+
+type scope struct {
+	datum map[string]interface{}
+	env   []binding // innermost last
+}
+
+// target resolves a selector recipe to a selector and the value it denotes (nil, false when
+// unknown or garbage); container prefers the datum's containers.
+func (s scope) target(t target, container bool) (selector, any, bool) {
+	ps := paths(s.datum, nil)[1:]
+	if container {
+		var cs []pathVal
+		for _, p := range ps {
+			if isContainer(p.val) {
+				cs = append(cs, p)
+			}
+		}
+		if len(cs) > 0 {
+			ps = cs
+		}
+	}
+	src := t.src
+	if src == fromBinding && len(s.env) == 0 {
+		src = fromDatum
+	}
+	if src == fromDatum && len(ps) == 0 {
+		src = fresh
+	}
+	var sel selector
+	var v any
+	known := false
+	switch src {
+	case fromDatum:
+		p := ps[t.idx%len(ps)]
+		sel, v, known = selector{path: slices.Clone(p.path)}, p.val, true
+	case fromBinding:
+		b := s.env[t.idx%len(s.env)]
+		switch {
+		case b.isVal && t.deep:
+			sel = selector{path: []string{b.name, "x"}} // a sub-path of a key or index: an error
+		case b.isVal:
+			sel, v, known = selector{path: []string{b.name}}, b.value, true
+		default:
+			sub := paths(b.sample, []string{b.name})
+			p := sub[t.sub%len(sub)]
+			sel, v, known = selector{path: p.path}, p.val, true
+		}
+	default:
+		p := []string{freshNames[t.idx%len(freshNames)]}
+		if len(ps) > 0 && t.extend {
+			p = append(slices.Clone(ps[t.idx%len(ps)].path), freshTails[t.sub%len(freshTails)])
+		}
+		sel = selector{path: p}
+	}
+	sel = fixSelector(sel)
+	sel.ptr = t.ptr && pointerable(sel.path)
+	return sel, v, known
+}
+
+var (
+	allMatchOps = []grammar.MatchOperator{grammar.MatchEqual, grammar.MatchNotEqual, grammar.MatchIn, grammar.MatchNotIn, grammar.MatchIsEmpty,
+		grammar.MatchIsNotEmpty, grammar.MatchMatches, grammar.MatchNotMatches, grammar.MatchIsNil, grammar.MatchIsNotNil}
+	textOps      = []grammar.MatchOperator{grammar.MatchEqual, grammar.MatchNotEqual, grammar.MatchIn, grammar.MatchNotIn, grammar.MatchMatches, grammar.MatchNotMatches, grammar.MatchIsEmpty, grammar.MatchIsNotEmpty}
+	containerOps = []grammar.MatchOperator{grammar.MatchIn, grammar.MatchNotIn, grammar.MatchIsEmpty, grammar.MatchIsNotEmpty, grammar.MatchIsNil, grammar.MatchIsNotNil}
+	// nilOps: the operators drawn for a nil target; `matches` is go-bexpr/9's shape
+	nilOps    = []grammar.MatchOperator{grammar.MatchIsNil, grammar.MatchIsNotNil, grammar.MatchEqual, grammar.MatchIsEmpty, grammar.MatchMatches}
+	scalarOps = []grammar.MatchOperator{grammar.MatchEqual, grammar.MatchNotEqual, grammar.MatchEqual, grammar.MatchNotEqual, grammar.MatchIsNil, grammar.MatchIn}
+)
+
+// opFor resolves an operator recipe for the target value: one suited to its kind, or any.
+func opFor(r opR, v any, known bool) grammar.MatchOperator {
+	if !known || r.any {
+		return allMatchOps[r.idx%len(allMatchOps)]
+	}
+	fit := scalarOps
+	switch reflect.ValueOf(v).Kind() {
+	case reflect.String:
+		fit = textOps
+	case reflect.Slice, reflect.Array, reflect.Map:
+		fit = containerOps
+	case reflect.Invalid:
+		fit = nilOps
+	}
+	return fit[r.idx%len(fit)]
+}
+
+// valueFor resolves a value recipe for the target value: mostly one that could equal it or be
+// found in it, sometimes a stranger.
+func valueFor(r valueR, v any, known bool) string {
+	if r.kind == "text" {
+		return r.text
+	}
+	if !known {
+		return strangers[r.form%len(strangers)]
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Bool:
+		return []string{strconv.FormatBool(rv.Bool()), "1", "0", "t", "F"}[r.form%5]
+	case reflect.Int, reflect.Int8:
+		return []string{strconv.FormatInt(rv.Int(), 10), strconv.FormatInt(rv.Int()+1, 10), "0x" + strconv.FormatInt(rv.Int(), 16), strconv.FormatInt(rv.Int(), 10) + ".0"}[r.form%4]
+	case reflect.Uint:
+		return []string{strconv.FormatUint(rv.Uint(), 10), "-1", strconv.FormatUint(rv.Uint()+1, 10)}[r.form%3]
+	case reflect.Float64, reflect.Float32:
+		return []string{strconv.FormatFloat(rv.Float(), 'g', -1, 64), strconv.FormatFloat(rv.Float(), 'f', 2, 64), strconv.FormatFloat(rv.Float()+1, 'g', -1, 64), "1.50000001"}[r.form%4]
+	case reflect.String:
+		s := rv.String()
+		switch r.form % 4 {
+		case 0:
+			return s
+		case 1:
+			if len(s) > 1 {
+				i := r.at % len(s)
+				return s[i : i+r.span%(len(s)-i+1)]
+			}
+			return s
+		case 2:
+			return "^" + regexp.QuoteMeta(s)
+		default:
+			return regexValues[r.at%len(regexValues)]
+		}
+	case reflect.Slice, reflect.Array:
+		if rv.Len() > 0 && r.form%4 != 3 {
+			e := rv.Index(r.at % rv.Len()).Interface()
+			if e == nil {
+				return "x"
+			}
+			if isContainer(e) {
+				return "1"
+			}
+			return fmt.Sprint(e)
+		}
+		return []string{"1", "a", "x", "true"}[r.at%4]
+	case reflect.Map:
+		keys := sortedKeys(rv)
+		if len(keys) > 0 && r.form%4 != 3 {
+			return keys[r.at%len(keys)].String()
+		}
+		return []string{"a", "zz", "1"}[r.at%3]
+	}
+	return "1"
+}
+
+// fixValue keeps a string writable while a recorded grammar bug is steered around: a string
+// holding a double quote can only be written raw while Known.escapedQuoteUnparsable is on,
+// and one that cannot be raw loses its quotes.
+func fixValue(v string) string {
+	if Known.escapedQuoteUnparsable && strings.Contains(v, "\"") && !rawable(v) {
+		v = strings.ReplaceAll(v, "\"", "'")
+	}
+	return v
+}
+
+func fixSelector(sel selector) selector {
+	for i, p := range sel.path {
+		sel.path[i] = fixValue(p)
+	}
+	return sel
+}
+
+// resolve turns a recipe into a tree over the scope.
+func (s scope) resolve(e expr) node {
+	switch x := e.(type) {
+	case matchR:
+		sel, v, known := s.target(x.t, false)
+		op := opFor(x.op, v, known)
+		m := matchN{sel: sel, op: op}
+		if hasValue(op) {
+			m.val = fixValue(valueFor(x.val, v, known))
+		}
+		return m
+	case notR:
+		return notN{s.resolve(x.x)}
+	case binR:
+		return binN{x.op, s.resolve(x.l), s.resolve(x.r)}
+	case collR:
+		return s.coll(x)
+	}
+	panic(fmt.Sprintf("recipe %T", e))
+}
+
+// coll resolves a collection expression recipe: its target, the bindings its mode declares
+// (a key or index binding holds a value, a default or value binding is an alias of an element,
+// with the chosen element's value as the sample sub-paths are resolved against) and its body
+// in the extended scope.
+func (s scope) coll(x collR) node {
+	sel, v, known := s.target(x.t, true)
+	c := collN{op: x.op, sel: sel, mode: x.mode}
+	rv := reflect.ValueOf(v)
+	isMap := known && rv.Kind() == reflect.Map
+	var sample, keySample, idxSample any
+	switch {
+	case isMap && rv.Len() > 0:
+		k := sortedKeys(rv)[x.elem%rv.Len()]
+		keySample, sample = k.Interface(), rv.MapIndex(k).Interface()
+	case known && (rv.Kind() == reflect.Slice || rv.Kind() == reflect.Array) && rv.Len() > 0:
+		i := x.elem % rv.Len()
+		idxSample, sample = i, rv.Index(i).Interface()
+	}
+	indexValue := idxSample
+	if isMap {
+		indexValue = keySample
+	}
+	alias := func(name string) binding {
+		if isMap && x.mode == grammar.CollectionBindDefault {
+			return binding{name: name, isVal: true, value: keySample}
+		}
+		return binding{name: name, path: append(slices.Clone(sel.path), "0"), sample: sample}
+	}
+	inner := scope{datum: s.datum, env: slices.Clone(s.env)}
+	switch x.mode {
+	case grammar.CollectionBindDefault:
+		c.def = x.idx
+		inner.env = append(inner.env, alias(c.def))
+	case grammar.CollectionBindIndex:
+		c.idx = x.idx
+		inner.env = append(inner.env, binding{name: c.idx, isVal: true, value: indexValue})
+	case grammar.CollectionBindValue:
+		c.val = x.val
+		inner.env = append(inner.env, alias(c.val))
+	case grammar.CollectionBindIndexAndValue:
+		c.idx, c.val = x.idx, x.val
+		inner.env = append(inner.env, binding{name: c.idx, isVal: true, value: indexValue}, alias(c.val))
+	}
+	c.inner = inner.resolve(x.inner)
+	return c
+}
+
+// --------------------------------------------------------------------------- cases
+
+// exprCase is what the properties draw: a datum, an expression recipe over it and the tape its
+// rendering reads.
+type exprCase struct {
+	datum  map[string]interface{}
+	recipe expr
+	tape   []int
+}
+
+func (c exprCase) tree() node { return scope{datum: c.datum}.resolve(c.recipe) }
+
+func (c exprCase) GoString() string {
+	n := c.tree()
+	src, _ := render(n, c.tape)
+	return fmt.Sprintf("datum %s\ntree %s\nsource %q", describe(c.datum), dump(n), src)
+}
+
+var (
+	tapes     = upTo(hegel.Integers(0, 99), 40)
+	exprCases = hegel.Composite(func(tc hegel.TestCase) exprCase {
+		return exprCase{datum: hegel.Draw(tc, datums), recipe: hegel.Draw(tc, exprs), tape: hegel.Draw(tc, tapes)}
+	})
+)
+
+func describe(v any) string {
+	return fmt.Sprintf("%#v", v)
+}
+
+// --------------------------------------------------------------------------- model evaluator
+
+// outcome is one possible result of an evaluation: a value, an error, or a panic.
+type outcome struct {
+	v     bool
+	err   bool
+	panic bool
+}
+
+func (o outcome) String() string {
+	switch {
+	case o.panic:
+		return "panic"
+	case o.err:
+		return "error"
+	}
+	return strconv.FormatBool(o.v)
+}
+
+// outcomes is a set of possible outcomes (map iteration order makes some evaluations
+// nondeterministic: an element that errors and one that decides can come in either order).
+type outcomes map[outcome]bool
+
+func one(o outcome) outcomes          { return outcomes{o: true} }
+func val(b bool) outcomes             { return one(outcome{v: b}) }
+func errOut() outcomes                { return one(outcome{err: true}) }
+func panicOut() outcomes              { return one(outcome{panic: true}) }
+func (s outcomes) has(o outcome) bool { return s[o] }
+
+func (s outcomes) String() string {
+	var parts []string
+	for o := range s {
+		parts = append(parts, o.String())
+	}
+	sort.Strings(parts)
+	return "{" + strings.Join(parts, ",") + "}"
+}
+
+// mapOutcomes applies f to every value outcome, keeping errors and panics.
+func mapOutcomes(s outcomes, f func(bool) outcomes) outcomes {
+	out := outcomes{}
+	for o := range s {
+		if o.err || o.panic {
+			out[o] = true
+			continue
+		}
+		for p := range f(o.v) {
+			out[p] = true
+		}
+	}
+	return out
+}
+
+// mbinding is a collection variable as the evaluator sees it.
+type mbinding struct {
+	name  string
+	isVal bool
+	value any
+	path  []string
+}
+
+// model evaluates trees over a datum; shapes names the recorded bugs whose shape the
+// evaluation met (a rule the documentation and the package disagree on).
+type model struct {
+	datum  map[string]interface{}
+	shapes []string
+}
+
+func (m *model) shape(id string) {
+	if !slices.Contains(m.shapes, id) {
+		m.shapes = append(m.shapes, id)
+	}
+}
+
+// get resolves a selector path: the value, whether it is present (a missing map key at the end
+// of a path of two or more parts is "not present"), and whether the lookup errors.
+func (m *model) get(path []string, env []mbinding) (any, bool, bool) {
+	full := path
+	for i := len(env) - 1; i >= 0; i-- {
+		if env[i].name == full[0] {
+			if env[i].isVal {
+				if len(full) > 1 {
+					return nil, false, true
+				}
+				return env[i].value, true, false
+			}
+			full = append(slices.Clone(env[i].path), full[1:]...)
+		}
+	}
+	var cur any = m.datum
+	for i, part := range full {
+		rv := reflect.ValueOf(cur)
+		switch rv.Kind() {
+		case reflect.Map:
+			mv := rv.MapIndex(reflect.ValueOf(part))
+			if !mv.IsValid() {
+				if i == len(full)-1 && len(full) >= 2 {
+					return nil, false, false
+				}
+				return nil, false, true
+			}
+			cur = mv.Interface()
+		case reflect.Slice, reflect.Array:
+			n, err := strconv.Atoi(part)
+			if err != nil || n < 0 || n >= rv.Len() {
+				return nil, false, true
+			}
+			cur = rv.Index(n).Interface()
+		case reflect.Struct:
+			// pointerstructure finds an exported field by name; a missing field is an error
+			// (the not-present disposition is for map keys only)
+			f := rv.FieldByName(part)
+			if !f.IsValid() || !f.CanInterface() {
+				return nil, false, true
+			}
+			cur = f.Interface()
+		default:
+			return nil, false, true
+		}
+	}
+	return cur, true, false
+}
+
+func isPrimitive(k reflect.Kind) bool {
+	switch k {
+	case reflect.Bool, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Float32, reflect.Float64, reflect.String:
+		return true
+	}
+	return false
+}
+
+// coerce converts the raw value for a primitive kind, as coerce.go does.
+func coerce(raw string, k reflect.Kind) (any, error) {
+	switch k {
+	case reflect.Bool:
+		return strconv.ParseBool(raw)
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return strconv.ParseInt(raw, 0, 64)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return strconv.ParseUint(raw, 0, 64)
+	case reflect.Float32:
+		f, err := strconv.ParseFloat(raw, 32)
+		return float32(f), err
+	case reflect.Float64:
+		return strconv.ParseFloat(raw, 64)
+	}
+	return raw, nil
+}
+
+// equal compares a coerced value with a primitive.
+func equal(c any, rv reflect.Value) bool {
+	switch rv.Kind() {
+	case reflect.Bool:
+		return c.(bool) == rv.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return c.(int64) == rv.Int()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return c.(uint64) == rv.Uint()
+	case reflect.Float32:
+		return c.(float32) == float32(rv.Float())
+	case reflect.Float64:
+		return c.(float64) == rv.Float()
+	case reflect.String:
+		return c.(string) == rv.String()
+	}
+	return false
+}
+
+func (m *model) match(x matchN, env []mbinding) outcomes {
+	v, present, bad := m.get(x.sel.path, env)
+	if bad {
+		return errOut()
+	}
+	if !present {
+		return val(x.op.NotPresentDisposition())
+	}
+	// a pointer is followed, as evaluateMatchExpression does; a nil pointer is then the zero
+	// Value, like a nil interface
+	rv := reflect.Indirect(reflect.ValueOf(v))
+	neg := false
+	base := x.op
+	switch x.op {
+	case grammar.MatchNotEqual:
+		base, neg = grammar.MatchEqual, true
+	case grammar.MatchNotIn:
+		base, neg = grammar.MatchIn, true
+	case grammar.MatchIsNotEmpty:
+		base, neg = grammar.MatchIsEmpty, true
+	case grammar.MatchNotMatches:
+		base, neg = grammar.MatchMatches, true
+	case grammar.MatchIsNotNil:
+		base, neg = grammar.MatchIsNil, true
+	}
+	var res outcomes
+	switch base {
+	case grammar.MatchEqual:
+		if !isPrimitive(rv.Kind()) {
+			return errOut()
+		}
+		c, err := coerce(x.val, rv.Kind())
+		if err != nil {
+			return errOut()
+		}
+		res = val(equal(c, rv))
+	case grammar.MatchIn:
+		res = m.in(x.val, rv)
+	case grammar.MatchIsEmpty:
+		switch rv.Kind() {
+		case reflect.Map, reflect.Slice, reflect.Array, reflect.String:
+			res = val(rv.Len() == 0)
+		default:
+			return errOut()
+		}
+	case grammar.MatchMatches:
+		if rv.Kind() == reflect.Invalid {
+			// a nil value is not convertible to []byte, so an error, as for an int
+			// (go-bexpr/9: doMatchMatches asks the zero reflect.Value for its Type and panics)
+			m.shape("go-bexpr/9")
+			if Known.matchesOnNilPanics {
+				return panicOut()
+			}
+		}
+		if rv.Kind() != reflect.String {
+			return errOut()
+		}
+		re, err := regexp.Compile(x.val)
+		if err != nil {
+			return errOut()
+		}
+		res = val(re.MatchString(rv.String()))
+	case grammar.MatchIsNil:
+		switch rv.Kind() {
+		case reflect.Map, reflect.Slice:
+			res = val(rv.IsNil())
+		case reflect.Array:
+			// an array is never nil (go-bexpr/6: the package panics)
+			m.shape("go-bexpr/6")
+			if Known.arrayIsNilPanics {
+				return panicOut()
+			}
+			res = val(false)
+		case reflect.Invalid:
+			res = val(true)
+		default:
+			return errOut()
+		}
+	}
+	if neg {
+		return mapOutcomes(res, func(b bool) outcomes { return val(!b) })
+	}
+	return res
+}
+
+// in models doMatchIn. Over an interface slice an element the value does not parse as is
+// skipped; so is a nil element (go-bexpr/3: the package panics) and a nested slice or map
+// (go-bexpr/7: the package errors).
+func (m *model) in(raw string, rv reflect.Value) outcomes {
+	switch rv.Kind() {
+	case reflect.Map:
+		return val(rv.MapIndex(reflect.ValueOf(raw)).IsValid())
+	case reflect.String:
+		return val(strings.Contains(rv.String(), raw))
+	case reflect.Slice, reflect.Array:
+		if rv.Type().Elem().Kind() != reflect.Interface {
+			c, err := coerce(raw, rv.Type().Elem().Kind())
+			if err != nil {
+				return errOut()
+			}
+			for i := 0; i < rv.Len(); i++ {
+				if equal(c, rv.Index(i)) {
+					return val(true)
+				}
+			}
+			return val(false)
+		}
+		for i := 0; i < rv.Len(); i++ {
+			e := rv.Index(i).Interface()
+			if e == nil {
+				m.shape("go-bexpr/3")
+				if Known.nilElementPanics {
+					return panicOut()
+				}
+				continue
+			}
+			ev := reflect.ValueOf(e)
+			if !isPrimitive(ev.Kind()) {
+				m.shape("go-bexpr/7")
+				if Known.inStopsAtNested {
+					return errOut()
+				}
+				continue
+			}
+			c, err := coerce(raw, ev.Kind())
+			if err != nil {
+				if errors.Is(err, strconv.ErrSyntax) {
+					continue
+				}
+				return errOut()
+			}
+			if equal(c, ev) {
+				return val(true)
+			}
+		}
+		return val(false)
+	}
+	return errOut()
+}
+
+func (m *model) eval(n node, env []mbinding) outcomes {
+	switch x := n.(type) {
+	case matchN:
+		return m.match(x, env)
+	case notN:
+		return mapOutcomes(m.eval(x.x, env), func(b bool) outcomes { return val(!b) })
+	case binN:
+		return mapOutcomes(m.eval(x.l, env), func(b bool) outcomes {
+			if (x.op == grammar.BinaryOpAnd && !b) || (x.op == grammar.BinaryOpOr && b) {
+				return val(b)
+			}
+			return m.eval(x.r, env)
+		})
+	case collN:
+		return m.coll(x, env)
+	}
+	return errOut()
+}
+
+// coll models evaluateCollectionExpression. Slices are visited in order; a map's elements in
+// any order, so every element that decides may come first. Binding one name to both the index
+// and the value is an error whatever the data (go-bexpr/8: the package checks it only when the
+// collection has elements).
+func (m *model) coll(x collN, env []mbinding) outcomes {
+	v, present, bad := m.get(x.sel.path, env)
+	if bad {
+		return errOut()
+	}
+	if !present {
+		return val(x.op == grammar.CollectionOpAll)
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Map, reflect.Slice, reflect.Array:
+	default:
+		return errOut()
+	}
+	if rv.Kind() == reflect.Map && rv.Type().Key().Kind() != reflect.String {
+		return errOut()
+	}
+	if x.mode == grammar.CollectionBindIndexAndValue && x.idx == x.val {
+		if rv.Len() == 0 {
+			m.shape("go-bexpr/8")
+		}
+		if rv.Len() > 0 || !Known.sameNameUncheckedWhenEmpty {
+			return errOut()
+		}
+	}
+	decisive := x.op == grammar.CollectionOpAny // the value that ends the loop
+	var per []outcomes
+	for i := 0; i < rv.Len(); i++ {
+		inner := slices.Clone(env)
+		if rv.Kind() == reflect.Map {
+			key := sortedKeys(rv)[i].String()
+			if x.def != "" {
+				inner = append(inner, mbinding{name: x.def, isVal: true, value: key})
+			}
+			if x.idx != "" {
+				inner = append(inner, mbinding{name: x.idx, isVal: true, value: key})
+			}
+			if x.val != "" {
+				inner = append(inner, mbinding{name: x.val, path: append(slices.Clone(x.sel.path), key)})
+			}
+		} else {
+			if x.idx != "" {
+				inner = append(inner, mbinding{name: x.idx, isVal: true, value: i})
+			}
+			p := append(slices.Clone(x.sel.path), strconv.Itoa(i))
+			if x.def != "" {
+				inner = append(inner, mbinding{name: x.def, path: p})
+			}
+			if x.val != "" {
+				inner = append(inner, mbinding{name: x.val, path: p})
+			}
+		}
+		// the variable path must be resolved in the outer environment, as the package does
+		// by rewriting it progressively; our aliases are absolute, so resolve now
+		for j := len(env); j < len(inner); j++ {
+			if !inner[j].isVal {
+				inner[j].path = m.resolve(inner[j].path, env)
+			}
+		}
+		per = append(per, m.eval(x.inner, inner))
+	}
+	out := outcomes{}
+	final := outcome{v: x.op == grammar.CollectionOpAll}
+	if rv.Kind() == reflect.Map {
+		allContinue := true
+		for _, s := range per {
+			for o := range s {
+				if o.err || o.panic || o.v == decisive {
+					out[o] = true
+				}
+			}
+			if !s.has(outcome{v: !decisive}) {
+				allContinue = false
+			}
+		}
+		if allContinue {
+			out[final] = true
+		}
+		return out
+	}
+	// in order
+	for _, s := range per {
+		cont := false
+		for o := range s {
+			if o.err || o.panic || o.v == decisive {
+				out[o] = true
+			} else {
+				cont = true
+			}
+		}
+		if !cont {
+			return out
+		}
+	}
+	out[final] = true
+	return out
+}
+
+// resolve turns a variable's path (its first part possibly another variable) into a datum path.
+func (m *model) resolve(path []string, env []mbinding) []string {
+	for i := len(env) - 1; i >= 0; i-- {
+		if env[i].name == path[0] && !env[i].isVal {
+			path = append(slices.Clone(env[i].path), path[1:]...)
+		}
+	}
+	return path
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..c2b0261
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,192 @@
+package hegel
+
+// Pins: the documented behaviour behind each recorded bug. They fail while the bug exists and
+// are listed as expected failures in target.toml.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/hashicorp/go-bexpr"
+)
+
+// mustEval parses and evaluates; a panic in Evaluate is returned as an error so that the test
+// binary survives it.
+func mustEval(t *testing.T, expr string, datum any) (res bool, err error) {
+	t.Helper()
+	ev, err := bexpr.CreateEvaluator(expr)
+	if err != nil {
+		t.Fatalf("CreateEvaluator(%q): %v", expr, err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			res, err = false, fmt.Errorf("panic: %v", r)
+		}
+	}()
+	return ev.Evaluate(datum)
+}
+
+// go-bexpr/1: a double-quoted string value is the string it spells, even when it looks like a
+// JSON pointer (the pointer form is for selectors; the Value rule lists selectors first).
+func TestHegelPinSlashString(t *testing.T) {
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`path == "/usr/bin"`, true},
+		{`path != "/usr/bin"`, false},
+		{`path == "usr/bin"`, false},
+		{`"/usr/bin" in paths`, true},
+	} {
+		got, err := mustEval(t, tc.expr, map[string]interface{}{"path": "/usr/bin", "paths": []string{"/usr/bin"}})
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/2: a collection expression is an expression like any other: an operand of and, or
+// and not without parentheses.
+func TestHegelPinCollectionOperand(t *testing.T) {
+	datum := map[string]interface{}{"list": []interface{}{1, 2}, "n": 1}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`any list as v { v == 2 } and n == 1`, true},
+		{`any list as v { v == 2 } or n == 5`, true},
+		{`n == 1 and any list as v { v == 2 }`, true},
+		{`not any list as v { v == 3 }`, true},
+		{`all list as v { v == 1 } or n == 1`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/3: `in` over a []interface{} holding a nil does not panic; a nil element equals
+// nothing and is skipped like an element of another type.
+func TestHegelPinNilElement(t *testing.T) {
+	datum := map[string]interface{}{"list": []interface{}{nil, 1, "a"}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`1 in list`, true},
+		{`"a" in list`, true},
+		{`2 in list`, false},
+		{`list contains a`, true},
+		{`2 not in list`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/4: a double-quoted string literal takes Go escapes (the grammar unquotes it with
+// strconv.Unquote), so an escaped quote is part of the string.
+func TestHegelPinEscapedQuote(t *testing.T) {
+	datum := map[string]interface{}{"s": `a"b`, "m": map[string]interface{}{`k"1`: 5}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`s == "a\"b"`, true},
+		{`s matches "\""`, true},
+		{`m["k\"1"] == 5`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/5: a number literal may be followed directly by the brace closing a collection body.
+func TestHegelPinNumberBeforeBrace(t *testing.T) {
+	datum := map[string]interface{}{"list": []interface{}{1, 2}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`any list as v {v == 2}`, true},
+		{`all list as v {v != 3}`, true},
+		{`any list as v { v == 2}`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/6: `is nil` on a Go array does not panic: an array is never nil (evaluate.go lists
+// arrays with the nil-able kinds, and a struct, which cannot be nil either, gives false).
+func TestHegelPinArrayIsNil(t *testing.T) {
+	datum := map[string]interface{}{"arr": [2]int{1, 2}, "empty": [0]int{}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`arr is nil`, false},
+		{`arr is not nil`, true},
+		{`empty is nil`, false},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/7: `in` over a []interface{} skips the elements the value cannot equal (the code
+// skips a type the value does not parse as), so a nested slice or map does not turn the result
+// into an error, and the order of the elements does not matter.
+func TestHegelPinNestedElement(t *testing.T) {
+	datum := map[string]interface{}{"front": []interface{}{[]interface{}{2}, 2}, "back": []interface{}{2, []interface{}{2}}, "maps": []interface{}{map[string]interface{}{"a": 1}, "x"}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`2 in front`, true},
+		{`2 in back`, true},
+		{`3 in front`, false},
+		{`"x" in maps`, true},
+		{`3 not in front`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/8: binding the same name to the index and the value is an error of the expression,
+// whatever the data (the package rejects it as soon as the collection has an element).
+func TestHegelPinSameNameBinding(t *testing.T) {
+	for _, expr := range []string{`any empty as v, v { v == 1 }`, `all empty as v, v { v == 1 }`, `any m as k, k { k == 1 }`} {
+		got, err := mustEval(t, expr, map[string]interface{}{"empty": []interface{}{}, "m": map[string]interface{}{}})
+		if err == nil {
+			t.Errorf("%s = %v, want an error", expr, got)
+		}
+	}
+}
+
+// go-bexpr/9: `matches` and `not matches` on a nil value do not panic: a nil is not
+// convertible to []byte, so the evaluation is an error, as it is on an int (and as `==`, `in`
+// and `is empty` give on a nil), whichever form the nil takes - an interface nil at the top,
+// nested or in a slice, or a nil pointer as a map value or a struct field.
+func TestHegelPinMatchesOnNil(t *testing.T) {
+	datum := map[string]interface{}{"a": nil, "m": map[string]interface{}{"a": nil}, "l": []interface{}{nil}, "p": (*string)(nil), "s": holder{}}
+	for _, expr := range []string{`a matches "x"`, `a not matches "x"`, `m.a matches "x"`, `l.0 matches "x"`, `p matches "x"`, `s.A matches "x"`} {
+		got, err := mustEval(t, expr, datum)
+		if err == nil || strings.HasPrefix(err.Error(), "panic:") {
+			t.Errorf("%s = %v, %v; want an error, not a panic", expr, got, err)
+		}
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..e925bf1
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,204 @@
+package hegel
+
+import (
+	"fmt"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/hashicorp/go-bexpr"
+	"github.com/hashicorp/go-bexpr/grammar"
+	"hegel.dev/go/hegel"
+)
+
+// union is the shapes of both lists, each once.
+func union(a, b []string) []string {
+	for _, s := range b {
+		if !slices.Contains(a, s) {
+			a = append(a, s)
+		}
+	}
+	return a
+}
+
+// TestHegelParse: a generated expression tree rendered to source (random whitespace, grouping,
+// selector and literal spellings) parses back to the same tree. A rendering with the shape of
+// a recorded grammar bug (go-bexpr/1, /2, /4, /5) fails naming the bug; under HEGEL_NO_KNOWN=1
+// the renderer avoids those shapes.
+func TestHegelParse(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		pc := hegel.Draw(ht, exprCases)
+		want := pc.tree()
+		src, shapes := render(want, pc.tape)
+		ast, err := grammar.Parse("", []byte(src))
+		if err != nil {
+			c.mismatch(ht, shapes, "Rejected", "parse of %q failed: %v\nwanted %s", src, err, dump(want))
+			return
+		}
+		got, err := fromGrammar(ast.(grammar.Expression))
+		if err != nil {
+			c.mismatch(ht, shapes, "AST", "%q: %v", src, err)
+			return
+		}
+		if !same(want, got) {
+			c.mismatch(ht, shapes, "Tree", "parse of %q:\n  want %s\n  got  %s", src, dump(want), dump(got))
+			return
+		}
+		switch {
+		case strings.Contains(src, "any") || strings.Contains(src, "all"):
+			c.count("ok with a collection")
+		case strings.Contains(src, "\"/"):
+			c.count("ok with a pointer")
+		default:
+			c.count("ok")
+		}
+	})
+}
+
+// evalSafely runs Evaluate, turning a panic into an outcome.
+func evalSafely(ev *bexpr.Evaluator, datum any) (o outcome) {
+	defer func() {
+		if r := recover(); r != nil {
+			o = outcome{panic: true}
+		}
+	}()
+	v, err := ev.Evaluate(datum)
+	if err != nil {
+		return outcome{err: true}
+	}
+	return outcome{v: v}
+}
+
+// evalCase is an expression case and, one time in four, more data for a Filter over them.
+type evalCase struct {
+	exprCase
+	filter bool
+	extras []map[string]interface{}
+}
+
+func (c evalCase) GoString() string {
+	s := c.exprCase.GoString()
+	if c.filter {
+		s += fmt.Sprintf("\nfilter over %d more data %s", len(c.extras), describe(c.extras))
+	}
+	return s
+}
+
+var evalCases = hegel.Composite(func(tc hegel.TestCase) evalCase {
+	c := evalCase{exprCase: hegel.Draw(tc, exprCases), filter: hegel.Draw(tc, chance(25))}
+	if c.filter {
+		c.extras = hegel.Draw(tc, upTo(datums, 2))
+	}
+	return c
+})
+
+// TestHegelEvaluate: a generated expression over generated data evaluates, through
+// CreateEvaluator and Evaluate, to an outcome the model allows; Filter agrees with Evaluate. A
+// case with the shape of a recorded bug (a rendering the grammar rejects or misreads, a nil or
+// nested element under `in`, `is nil` on an array, `as k, k` over an empty collection,
+// `matches` on a nil value) fails naming the bug; under HEGEL_NO_KNOWN=1 the renderer avoids
+// the first and the model reproduces the rest.
+func TestHegelEvaluate(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ec := hegel.Draw(ht, evalCases)
+		datum := ec.datum
+		n := ec.tree()
+		src, shapes := render(n, ec.tape)
+		ev, err := bexpr.CreateEvaluator(src)
+		if err != nil {
+			c.mismatch(ht, shapes, "Rejected", "CreateEvaluator(%q): %v", src, err)
+			return
+		}
+		m := &model{datum: datum}
+		want := m.eval(n, nil)
+		shapes = union(shapes, m.shapes)
+		got := evalSafely(ev, datum)
+		if !want.has(got) {
+			if got.panic && Known.nilElementPanics && want.has(outcome{err: true}) {
+				// an interface slice holding a nil and a nested element: which comes first decides
+				c.count("known panic on a nil element")
+				return
+			}
+			c.mismatch(ht, shapes, "Mismatch", "Evaluate(%q) on %s = %s, the model allows %s\ntree %s", src, describe(datum), got, want, dump(n))
+			return
+		}
+		switch {
+		case got.panic:
+			c.count("known panic")
+		case len(want) > 1:
+			c.count("ok, order dependent")
+		case got.err:
+			c.count("ok, error")
+		default:
+			c.count(fmt.Sprintf("ok %v", got.v))
+		}
+		// the filter over a few data agrees with element-wise evaluation
+		if !ec.filter || len(want) != 1 {
+			return
+		}
+		items := []map[string]interface{}{datum}
+		wants := []outcome{got}
+		for _, d := range ec.extras {
+			md := &model{datum: d}
+			w := md.eval(n, nil)
+			if len(w) != 1 {
+				c.count("filter skipped, order dependent")
+				return
+			}
+			shapes = union(shapes, md.shapes)
+			items = append(items, d)
+			for o := range w {
+				wants = append(wants, o)
+			}
+		}
+		f, err := bexpr.CreateFilter(src)
+		if err != nil {
+			c.mismatch(ht, shapes, "Filter", "CreateFilter(%q): %v", src, err)
+			return
+		}
+		var res any
+		ferr := func() (e error) {
+			defer func() {
+				if r := recover(); r != nil {
+					e = fmt.Errorf("panic: %v", r)
+				}
+			}()
+			res, e = f.Execute(items)
+			return
+		}()
+		var kept []map[string]interface{}
+		bad := false
+		for i, w := range wants {
+			if w.err || w.panic {
+				bad = true
+			} else if w.v {
+				kept = append(kept, items[i])
+			}
+		}
+		if bad {
+			if ferr == nil {
+				c.mismatch(ht, shapes, "Filter", "Filter(%q) over %d items returned %v, an element errors", src, len(items), res)
+			}
+			return
+		}
+		if ferr != nil {
+			c.mismatch(ht, shapes, "Filter", "Filter(%q) over %d items: %v", src, len(items), ferr)
+			return
+		}
+		gotItems, _ := res.([]map[string]interface{})
+		if len(kept) == 0 {
+			kept = []map[string]interface{}{}
+		}
+		if gotItems == nil {
+			gotItems = []map[string]interface{}{}
+		}
+		if !reflect.DeepEqual(gotItems, kept) {
+			c.mismatch(ht, shapes, "Filter", "Filter(%q) kept %v, want %v", src, gotItems, kept)
+			return
+		}
+		c.count("filter ok")
+	})
+}
diff --git a/hegel/hegel_shapes_test.go b/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..11ec9b6
--- /dev/null
+++ b/hegel/hegel_shapes_test.go
@@ -0,0 +1,581 @@
+package hegel
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged as TestHegelEvaluate judges (CreateEvaluator and Evaluate against
+// the model evaluator), so that each bug has a property that finds it every run (the wide
+// properties reach the shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring region the bug does not touch (a raw or non-pointer string, a parenthesised
+// collection expression, a nil or a nested element after the match, another escape, whitespace
+// before the brace, a slice or map under `is nil`, a non-empty collection, a string or a
+// non-string value under `matches`) and passes.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/hashicorp/go-bexpr"
+	"github.com/hashicorp/go-bexpr/grammar"
+	"hegel.dev/go/hegel"
+)
+
+// shapeCase is a narrow case ready to judge: the datum, the tree and its source.
+type shapeCase struct {
+	datum map[string]interface{}
+	tree  node
+	src   string
+}
+
+func (s shapeCase) String() string {
+	return fmt.Sprintf("source %q\ntree %s\ndatum %s", s.src, dump(s.tree), describe(s.datum))
+}
+
+// shapesOf names the bug a narrow property is about - or nothing under HEGEL_NO_KNOWN=1, when
+// the property draws the neighbouring region and a disagreement is a plain failure.
+func shapesOf(bug string) []string {
+	if noKnown {
+		return nil
+	}
+	return []string{bug}
+}
+
+// checkShape judges one case as TestHegelEvaluate does: the source parses and Evaluate's
+// outcome is one the model allows.
+func checkShape(ht *hegel.T, c *collector, s shapeCase, bug string) {
+	ev, err := bexpr.CreateEvaluator(s.src)
+	if err != nil {
+		c.mismatch(ht, shapesOf(bug), "Rejected", "CreateEvaluator(%q): %v", s.src, err)
+		return
+	}
+	m := &model{datum: s.datum}
+	want := m.eval(s.tree, nil)
+	got := evalSafely(ev, s.datum)
+	if !want.has(got) {
+		c.mismatch(ht, union(shapesOf(bug), m.shapes), "Mismatch", "Evaluate(%q) on %s = %s, the model allows %s\ntree %s", s.src, describe(s.datum), got, want, dump(s.tree))
+		return
+	}
+	c.count(fmt.Sprintf("ok %s", got))
+}
+
+var (
+	gaps     = pick(" ", "  ", "\t", "\n")
+	collOp   = pick(grammar.CollectionOpAny, grammar.CollectionOpAll)
+	bindName = pick(varNames...)
+	// fillers: scalar elements that equal none of the needles 0..5
+	fillers = upTo(pick[any]("a", "b", true, 1.5, 7, 8), 3)
+	needles = hegel.Integers(0, 5)
+)
+
+func sel(parts ...string) selector { return selector{path: parts} }
+
+// --------------------------------------------------------------------------- go-bexpr/1
+
+// pointerValueCase: a double-quoted value that spells a JSON pointer, compared with a string
+// holding the same text or looked for in a list of it; under HEGEL_NO_KNOWN=1 the same text
+// written raw, or with a character outside the pointer segment class put in.
+type pointerValueCase struct {
+	text    string
+	form    int // 0: s == v; 1: v in list; 2: list contains v
+	raw     bool
+	breaker string
+	breakAt int
+}
+
+var pointerValueCases = hegel.Composite(func(tc hegel.TestCase) pointerValueCase {
+	return pointerValueCase{
+		text:    hegel.Draw(tc, pointerTexts),
+		form:    hegel.Draw(tc, hegel.Integers(0, 2)),
+		raw:     hegel.Draw(tc, chance(50)),
+		breaker: hegel.Draw(tc, pick(" ", "\\", "(", "`", "*")),
+		breakAt: hegel.Draw(tc, positions),
+	}
+})
+
+func (c pointerValueCase) build() shapeCase {
+	value, literal := c.text, strconv.Quote(c.text)
+	if noKnown {
+		if c.raw {
+			literal = "`" + c.text + "`"
+		} else {
+			at := 1 + c.breakAt%len(c.text)
+			value = c.text[:at] + c.breaker + c.text[at:]
+			literal = strconv.Quote(value)
+		}
+	}
+	datum := map[string]interface{}{"s": value, "list": []string{value}}
+	switch c.form {
+	case 0:
+		return shapeCase{datum, matchN{sel: sel("s"), op: grammar.MatchEqual, val: value}, "s == " + literal}
+	case 1:
+		return shapeCase{datum, matchN{sel: sel("list"), op: grammar.MatchIn, val: value}, literal + " in list"}
+	}
+	return shapeCase{datum, matchN{sel: sel("list"), op: grammar.MatchIn, val: value}, "list contains " + literal}
+}
+
+func (c pointerValueCase) GoString() string { return c.build().String() }
+
+// TestHegelQuotedPointerValueKeepsItsSlash: a double-quoted string value is the string it
+// spells even when it looks like a JSON pointer; the grammar reads it as a selector and the
+// value loses its slash (go-bexpr/1).
+func TestHegelQuotedPointerValueKeepsItsSlash(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, pointerValueCases).build(), "go-bexpr/1")
+	})
+}
+
+// --------------------------------------------------------------------------- go-bexpr/2
+
+// collOperandCase: a collection expression as an operand of and (either side), of not, or the
+// left operand of or, without parentheses; under HEGEL_NO_KNOWN=1 in parentheses, or as the
+// right operand of or.
+type collOperandCase struct {
+	op        grammar.CollectionOperator
+	name      string
+	n, k      int
+	where     int // 0: and-left, 1: and-right, 2: or-left, 3: not
+	gap       string
+	neighbour int // 0: parenthesised where it stands, 1: the right operand of or
+}
+
+var collOperandCases = hegel.Composite(func(tc hegel.TestCase) collOperandCase {
+	return collOperandCase{
+		op:        hegel.Draw(tc, collOp),
+		name:      hegel.Draw(tc, bindName),
+		n:         hegel.Draw(tc, hegel.Integers(0, 3)),
+		k:         hegel.Draw(tc, hegel.Integers(0, 3)),
+		where:     hegel.Draw(tc, hegel.Integers(0, 3)),
+		gap:       hegel.Draw(tc, gaps),
+		neighbour: hegel.Draw(tc, hegel.Integers(0, 1)),
+	}
+})
+
+func (c collOperandCase) build() shapeCase {
+	datum := map[string]interface{}{"list": []interface{}{1, 2}, "n": 1}
+	coll := collN{op: c.op, sel: sel("list"), mode: grammar.CollectionBindDefault, def: c.name,
+		inner: matchN{sel: sel(c.name), op: grammar.MatchEqual, val: strconv.Itoa(c.n)}}
+	other := matchN{sel: sel("n"), op: grammar.MatchEqual, val: strconv.Itoa(c.k)}
+	collSrc := fmt.Sprintf("%s list as %s {%s%s == %d%s}", strings.ToLower(string(c.op)), c.name, c.gap, c.name, c.n, c.gap)
+	otherSrc := fmt.Sprintf("n == %d", c.k)
+	where := c.where
+	if noKnown {
+		if c.neighbour == 1 {
+			return shapeCase{datum, binN{grammar.BinaryOpOr, other, coll}, otherSrc + c.gap + "or" + c.gap + collSrc}
+		}
+		collSrc = "(" + collSrc + ")"
+	}
+	switch where {
+	case 0:
+		return shapeCase{datum, binN{grammar.BinaryOpAnd, coll, other}, collSrc + c.gap + "and" + c.gap + otherSrc}
+	case 1:
+		return shapeCase{datum, binN{grammar.BinaryOpAnd, other, coll}, otherSrc + c.gap + "and" + c.gap + collSrc}
+	case 2:
+		return shapeCase{datum, binN{grammar.BinaryOpOr, coll, other}, collSrc + c.gap + "or" + c.gap + otherSrc}
+	}
+	return shapeCase{datum, notN{coll}, "not" + c.gap + collSrc}
+}
+
+func (c collOperandCase) GoString() string { return c.build().String() }
+
+// TestHegelCollectionExpressionAsOperand: a collection expression is an operand like any
+// other - of and, of not, and on either side of or - without parentheses; the grammar only
+// admits it as the right operand of or (go-bexpr/2).
+func TestHegelCollectionExpressionAsOperand(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, collOperandCases).build(), "go-bexpr/2")
+	})
+}
+
+// --------------------------------------------------------------------------- go-bexpr/3 and /7
+
+// skippedElementCase: `in` over an interface slice holding an element the value cannot equal
+// before the element it equals (or before the end): a nil (go-bexpr/3) or a nested slice or
+// map (go-bexpr/7); under HEGEL_NO_KNOWN=1 the element comes after the match.
+type skippedElementCase struct {
+	before, after []any
+	needle        int
+	hit           bool
+	notIn         bool
+	nested        any // nil for the nil element; a nested container otherwise
+}
+
+func skippedElementCasesOf(nested hegel.Generator[any]) hegel.Generator[skippedElementCase] {
+	return hegel.Composite(func(tc hegel.TestCase) skippedElementCase {
+		return skippedElementCase{
+			before: hegel.Draw(tc, fillers),
+			after:  hegel.Draw(tc, fillers),
+			needle: hegel.Draw(tc, needles),
+			hit:    hegel.Draw(tc, chance(60)),
+			notIn:  hegel.Draw(tc, chance(30)),
+			nested: hegel.Draw(tc, nested),
+		}
+	})
+}
+
+var (
+	nilElements    = hegel.Just[any](nil)
+	nestedElements = weighted(
+		choice[any]{1, hegel.Map(scalars, func(x any) any { return []interface{}{x} })},
+		choice[any]{1, hegel.Map(scalars, func(x any) any { return map[string]interface{}{"a": x} })},
+		choice[any]{1, hegel.Map(needles, func(n int) any { return []int{n} })},
+	)
+	nilElementCases    = skippedElementCasesOf(nilElements)
+	nestedElementCases = skippedElementCasesOf(nestedElements)
+)
+
+func (c skippedElementCase) build() shapeCase {
+	list := append([]any{}, c.before...)
+	if noKnown {
+		list = append(list, c.needle, c.nested)
+	} else {
+		list = append(list, c.nested)
+		if c.hit {
+			list = append(list, c.needle)
+		}
+	}
+	list = append(list, c.after...)
+	datum := map[string]interface{}{"list": list}
+	op, word := grammar.MatchIn, "in"
+	if c.notIn {
+		op, word = grammar.MatchNotIn, "not in"
+	}
+	return shapeCase{datum, matchN{sel: sel("list"), op: op, val: strconv.Itoa(c.needle)}, fmt.Sprintf("%d %s list", c.needle, word)}
+}
+
+func (c skippedElementCase) GoString() string { return c.build().String() }
+
+// TestHegelInSkipsNilElements: `in` over an interface slice skips a nil element as it skips an
+// element of another type; the package panics on it (go-bexpr/3).
+func TestHegelInSkipsNilElements(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, nilElementCases).build(), "go-bexpr/3")
+	})
+}
+
+// TestHegelInSkipsNestedElements: `in` over an interface slice skips a nested slice or map as
+// it skips an element of another type; the package errors on it (go-bexpr/7).
+func TestHegelInSkipsNestedElements(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, nestedElementCases).build(), "go-bexpr/7")
+	})
+}
+
+// --------------------------------------------------------------------------- go-bexpr/4
+
+// escapedQuoteCase: a double-quoted string holding a quote, as a match value, a regular
+// expression or an index key; under HEGEL_NO_KNOWN=1 the same string raw, or another escape in
+// the quote's place.
+type escapedQuoteCase struct {
+	left, right string
+	where       int // 0: s == "..."; 1: s matches "..."; 2: m["..."] == 5
+	raw         bool
+	other       string
+}
+
+var (
+	quotePieces       = joined(upTo(pick("a", "b", "x", "\\", "\n", " ", "/"), 2))
+	escapedQuoteCases = hegel.Composite(func(tc hegel.TestCase) escapedQuoteCase {
+		return escapedQuoteCase{
+			left:  hegel.Draw(tc, quotePieces),
+			right: hegel.Draw(tc, quotePieces),
+			where: hegel.Draw(tc, hegel.Integers(0, 2)),
+			raw:   hegel.Draw(tc, chance(50)),
+			other: hegel.Draw(tc, pick("\n", "\t", "\\", "'", "\u00e9")),
+		}
+	})
+)
+
+func (c escapedQuoteCase) build() shapeCase {
+	text := c.left + "\"" + c.right
+	literal := strconv.Quote(text)
+	if noKnown {
+		if c.raw {
+			literal = "`" + text + "`"
+		} else {
+			text = c.left + c.other + c.right
+			literal = strconv.Quote(text)
+		}
+	}
+	datum := map[string]interface{}{"s": text, "m": map[string]interface{}{text: 5}}
+	switch c.where {
+	case 0:
+		return shapeCase{datum, matchN{sel: sel("s"), op: grammar.MatchEqual, val: text}, "s == " + literal}
+	case 1:
+		return shapeCase{datum, matchN{sel: sel("s"), op: grammar.MatchMatches, val: regexpOf(text)}, "s matches " + regexpLiteral(text, noKnown && c.raw)}
+	}
+	return shapeCase{datum, matchN{sel: sel("m", text), op: grammar.MatchEqual, val: "5"}, "m[" + literal + "] == 5"}
+}
+
+// regexpOf is a regular expression matching text exactly, as the value of a matches.
+func regexpOf(text string) string { return "^" + regexpQuote(text) + "$" }
+
+func regexpQuote(text string) string {
+	var b strings.Builder
+	for _, r := range text {
+		if strings.ContainsRune(`\.+*?()|[]{}^$`, r) {
+			b.WriteByte('\\')
+		}
+		b.WriteRune(r)
+	}
+	return b.String()
+}
+
+// regexpLiteral spells the regular expression as a string literal: raw, or double-quoted with
+// Go escapes.
+func regexpLiteral(text string, raw bool) string {
+	if raw {
+		return "`" + regexpOf(text) + "`"
+	}
+	return strconv.Quote(regexpOf(text))
+}
+
+func (c escapedQuoteCase) GoString() string { return c.build().String() }
+
+// TestHegelEscapedQuoteInDoubleQuotedString: a double-quoted string literal takes Go escapes
+// (the grammar unquotes it with strconv.Unquote), so an escaped quote is part of the string;
+// the literal ends at the first quote (go-bexpr/4).
+func TestHegelEscapedQuoteInDoubleQuotedString(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, escapedQuoteCases).build(), "go-bexpr/4")
+	})
+}
+
+// --------------------------------------------------------------------------- go-bexpr/5
+
+// numberBraceCase: a collection body ending in a number literal right before the closing
+// brace; under HEGEL_NO_KNOWN=1 whitespace before the brace, a parenthesised body or a quoted
+// number.
+type numberBraceCase struct {
+	op        grammar.CollectionOperator
+	name      string
+	number    string
+	notEqual  bool
+	open      string // whitespace after the opening brace
+	gap       string
+	neighbour int
+}
+
+var numberBraceCases = hegel.Composite(func(tc hegel.TestCase) numberBraceCase {
+	return numberBraceCase{
+		op:        hegel.Draw(tc, collOp),
+		name:      hegel.Draw(tc, bindName),
+		number:    hegel.Draw(tc, pick("1", "0", "2", "-1", "2.5", "10", "1.0")),
+		notEqual:  hegel.Draw(tc, chance(30)),
+		open:      hegel.Draw(tc, pick("", " ", "\n")),
+		gap:       hegel.Draw(tc, gaps),
+		neighbour: hegel.Draw(tc, hegel.Integers(0, 2)),
+	}
+})
+
+func (c numberBraceCase) build() shapeCase {
+	datum := map[string]interface{}{"list": []interface{}{1, 2}}
+	op, word := grammar.MatchEqual, "=="
+	if c.notEqual {
+		op, word = grammar.MatchNotEqual, "!="
+	}
+	body := c.name + c.gap + word + c.gap + c.number
+	tail := ""
+	if noKnown {
+		switch c.neighbour {
+		case 0:
+			tail = c.gap
+		case 1:
+			body = "(" + body + ")"
+		default:
+			body = c.name + c.gap + word + c.gap + strconv.Quote(c.number)
+		}
+	}
+	tree := collN{op: c.op, sel: sel("list"), mode: grammar.CollectionBindDefault, def: c.name,
+		inner: matchN{sel: sel(c.name), op: op, val: c.number}}
+	return shapeCase{datum, tree, fmt.Sprintf("%s list as %s {%s%s%s}", strings.ToLower(string(c.op)), c.name, c.open, body, tail)}
+}
+
+func (c numberBraceCase) GoString() string { return c.build().String() }
+
+// TestHegelNumberBeforeClosingBrace: a number literal may be followed directly by the brace
+// closing a collection body; the number rule's lookahead does not know the brace (go-bexpr/5).
+func TestHegelNumberBeforeClosingBrace(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, numberBraceCases).build(), "go-bexpr/5")
+	})
+}
+
+// --------------------------------------------------------------------------- go-bexpr/6
+
+// arrayNilCase: `is nil` or `is not nil` on a Go array; under HEGEL_NO_KNOWN=1 on a slice or
+// a map, nil or not.
+type arrayNilCase struct {
+	arr       any
+	not       bool
+	gap       string
+	neighbour any
+}
+
+var (
+	slicesOrMaps  = weighted(choice[any]{1, intSlices}, choice[any]{1, stringMaps}, choice[any]{1, stringSlices})
+	arrayNilCases = hegel.Composite(func(tc hegel.TestCase) arrayNilCase {
+		return arrayNilCase{
+			arr:       hegel.Draw(tc, arrays),
+			not:       hegel.Draw(tc, chance(50)),
+			gap:       hegel.Draw(tc, gaps),
+			neighbour: hegel.Draw(tc, slicesOrMaps),
+		}
+	})
+)
+
+func (c arrayNilCase) build() shapeCase {
+	datum := map[string]interface{}{"arr": shaped(c.arr, c.neighbour)}
+	op, word := grammar.MatchIsNil, "is"+c.gap+"nil"
+	if c.not {
+		op, word = grammar.MatchIsNotNil, "is"+c.gap+"not"+c.gap+"nil"
+	}
+	return shapeCase{datum, matchN{sel: sel("arr"), op: op}, "arr" + c.gap + word}
+}
+
+func (c arrayNilCase) GoString() string { return c.build().String() }
+
+// TestHegelIsNilOnArray: `is nil` on a Go array is false and `is not nil` true (an array is
+// never nil, as a struct is not); the package calls IsNil on it and panics (go-bexpr/6).
+func TestHegelIsNilOnArray(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, arrayNilCases).build(), "go-bexpr/6")
+	})
+}
+
+// --------------------------------------------------------------------------- go-bexpr/8
+
+// sameNameCase: one name bound to both the index and the value of a collection expression
+// over an empty collection; under HEGEL_NO_KNOWN=1 over a non-empty one.
+type sameNameCase struct {
+	op     grammar.CollectionOperator
+	name   string
+	empty  any
+	filled any
+	value  string
+	gap    string
+}
+
+var (
+	emptyCollections  = pick[any]([]interface{}{}, []int{}, map[string]interface{}{}, [0]int{}, map[string]int{}, []string(nil))
+	filledCollections = weighted(
+		choice[any]{1, hegel.Map(between(needles, 1, 3), func(xs []int) any { return xs })},
+		choice[any]{1, hegel.Map(between(texts, 1, 2), func(xs []string) any { return xs })},
+		choice[any]{1, hegel.Map(hegel.Maps(keys, needles).MinSize(1).MaxSize(2), func(m map[string]int) any { return m })},
+	)
+	sameNameCases = hegel.Composite(func(tc hegel.TestCase) sameNameCase {
+		return sameNameCase{
+			op:     hegel.Draw(tc, collOp),
+			name:   hegel.Draw(tc, bindName),
+			empty:  hegel.Draw(tc, emptyCollections),
+			filled: hegel.Draw(tc, filledCollections),
+			value:  hegel.Draw(tc, pick("1", "a", "0")),
+			gap:    hegel.Draw(tc, gaps),
+		}
+	})
+)
+
+func (c sameNameCase) build() shapeCase {
+	datum := map[string]interface{}{"c": shaped(c.empty, c.filled)}
+	tree := collN{op: c.op, sel: sel("c"), mode: grammar.CollectionBindIndexAndValue, idx: c.name, val: c.name,
+		inner: matchN{sel: sel(c.name), op: grammar.MatchEqual, val: c.value}}
+	src := fmt.Sprintf("%s c as %s,%s%s {%s%s == %s%s}", strings.ToLower(string(c.op)), c.name, c.gap, c.name, c.gap, c.name, strconv.Quote(c.value), c.gap)
+	return shapeCase{datum, tree, src}
+}
+
+func (c sameNameCase) GoString() string { return c.build().String() }
+
+// TestHegelSameNameBindingIsRejected: binding one name to both the index and the value is an
+// error of the expression whatever the data; the package checks it inside the loop over the
+// elements, so an empty collection passes (go-bexpr/8).
+func TestHegelSameNameBindingIsRejected(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, sameNameCases).build(), "go-bexpr/8")
+	})
+}
+
+// --------------------------------------------------------------------------- go-bexpr/9
+
+// matchesOnNilCase: `matches` or `not matches` with a pattern on a selector whose value is nil
+// in one of its forms - an interface nil at the top of the datum, under a nested map or as an
+// element of an interface slice, a nil pointer as a map value or as a struct field; under
+// HEGEL_NO_KNOWN=1 the same place holds a string (a pointer to one for the pointer forms) or a
+// non-string value.
+type matchesOnNilCase struct {
+	form      int // 0: a; 1: m.a; 2: l.0; 3: a, a nil *string; 4: s.A, a nil pointer field
+	pattern   string
+	not       bool
+	gap       string
+	neighbour any    // the value in the nil's place under HEGEL_NO_KNOWN=1
+	text      string // the pointee in a pointer form's place under HEGEL_NO_KNOWN=1
+}
+
+// holder is a struct with a pointer field, the ordinary Go shape of an optional value.
+type holder struct{ A *string }
+
+var (
+	patterns      = pick("x", "a", ".", "[a-c]+", "x$", "^$", "", "\\d", "(")
+	nilNeighbours = weighted(
+		choice[any]{3, asAny(texts)},
+		choice[any]{1, asAny(smallInts)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{1, asAny(fractions)},
+		choice[any]{1, intSlices},
+	)
+	matchesOnNilCases = hegel.Composite(func(tc hegel.TestCase) matchesOnNilCase {
+		return matchesOnNilCase{
+			form:      hegel.Draw(tc, hegel.Integers(0, 4)),
+			pattern:   hegel.Draw(tc, patterns),
+			not:       hegel.Draw(tc, chance(50)),
+			gap:       hegel.Draw(tc, gaps),
+			neighbour: hegel.Draw(tc, nilNeighbours),
+			text:      hegel.Draw(tc, texts),
+		}
+	})
+)
+
+func (c matchesOnNilCase) build() shapeCase {
+	var v any     // the value: nil, or the neighbour under HEGEL_NO_KNOWN=1
+	var p *string // the pointer: nil, or to the text under HEGEL_NO_KNOWN=1
+	if noKnown {
+		v, p = c.neighbour, &c.text
+	}
+	var datum map[string]interface{}
+	var path []string
+	switch c.form {
+	case 0:
+		datum, path = map[string]interface{}{"a": v}, []string{"a"}
+	case 1:
+		datum, path = map[string]interface{}{"m": map[string]interface{}{"a": v}}, []string{"m", "a"}
+	case 2:
+		datum, path = map[string]interface{}{"l": []interface{}{v}}, []string{"l", "0"}
+	case 3:
+		datum, path = map[string]interface{}{"a": p}, []string{"a"}
+	default:
+		datum, path = map[string]interface{}{"s": holder{A: p}}, []string{"s", "A"}
+	}
+	op, word := grammar.MatchMatches, "matches"
+	if c.not {
+		op, word = grammar.MatchNotMatches, "not"+c.gap+"matches"
+	}
+	return shapeCase{datum, matchN{sel: sel(path...), op: op, val: c.pattern}, strings.Join(path, ".") + c.gap + word + c.gap + strconv.Quote(c.pattern)}
+}
+
+func (c matchesOnNilCase) GoString() string { return c.build().String() }
+
+// TestHegelMatchesOnNilValueIsAnError: `matches` on a value that is nil is an error, as it is
+// on an int (neither converts to []byte); the package asks the zero reflect.Value for its type
+// and panics (go-bexpr/9).
+func TestHegelMatchesOnNilValueIsAnError(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkShape(ht, c, hegel.Draw(ht, matchesOnNilCases).build(), "go-bexpr/9")
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..49bf711
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,256 @@
+package hegel
+
+// Hegel property tests for hashicorp/go-bexpr, written for the Hegel zoo. See
+// targets/go/go-bexpr/README.md.
+//
+// Oracle: a model of the documented language - the grammar in grammar/grammar.peg for
+// parsing, the rules of evaluate.go, grammar/ast.go's NotPresentDisposition and the README
+// for evaluation (hegel_model_test.go). Expression trees, data and the spelling of the
+// rendered source are drawn as data from package-level generators and rendered by pure
+// functions; the properties are in hegel_props_test.go, one narrow property per recorded bug
+// in hegel_shapes_test.go, and the pins in hegel_pins_test.go.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing. HEGEL_NO_KNOWN=1 switches the shapes of the recorded bugs off (noKnown, below).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// --------------------------------------------------------------------------- collector
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch is failClass on a case whose known shapes are named (none for a plain failure):
+// every shape is counted, and the failure names the bugs; under HEGEL_NO_KNOWN=1 a case with
+// a known shape is assumed away instead.
+func (c *collector) mismatch(ht *hegel.T, shapes []string, class string, format string, args ...any) {
+	for _, s := range shapes {
+		c.count("shape " + s)
+	}
+	if len(shapes) > 0 {
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the shapes of the bugs, the model says what the documentation says and
+// the properties fail on the shapes naming the bug (they are the expected failures, mapped
+// to the bugs they find, beside the pins); under HEGEL_NO_KNOWN=1 the switches below steer
+// the renderer off the shapes it can avoid and make the model reproduce the behaviour of the
+// rest, and a mismatch on a case that still has a known shape is assumed away.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml); every switch is on under HEGEL_NO_KNOWN=1 only.
+var Known = struct {
+	slashStringIsPointer       bool // 1: a double-quoted string that spells a JSON pointer is read as a selector (its slash lost)
+	collectionNeedsParens      bool // 2: any/all cannot be an operand of and, not, or the left of or without parentheses
+	nilElementPanics           bool // 3: `in` over an interface slice holding a nil panics
+	escapedQuoteUnparsable     bool // 4: a double-quoted string cannot contain an escaped quote
+	numberBeforeBrace          bool // 5: a number right before } is an invalid number literal
+	arrayIsNilPanics           bool // 6: `is nil` on a Go array panics
+	inStopsAtNested            bool // 7: `in` over an interface slice errors at a nested slice or map instead of skipping it
+	sameNameUncheckedWhenEmpty bool // 8: `as k, k` is rejected only when the collection has elements
+	matchesOnNilPanics         bool // 9: `matches` on a selector whose value is nil (an interface nil or a nil pointer) panics
+}{noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// hegel-go has no weighted choice, biased coin, optional with a probability or tuple
+// combinator; these are the zoo's spellings.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// pick is one of a small table of values (the first is the shrink target).
+func pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// upTo is a list of zero to n elements: the count is drawn first (Lists(g).MaxSize(n) almost
+// never draws the empty list), then that many elements.
+func upTo[T any](g hegel.Generator[T], n int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hegel.Integers(0, n), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// mapsUpTo is a map of zero to n entries, the count drawn first (as for upTo).
+func mapsUpTo[V any](k hegel.Generator[string], v hegel.Generator[V], n int) hegel.Generator[map[string]V] {
+	return hegel.FlatMap(hegel.Integers(0, n), func(size int) hegel.Generator[map[string]V] {
+		return hegel.Maps(k, v).MinSize(size).MaxSize(size)
+	})
+}
+
+// between is a list of lo to hi elements, the count drawn first.
+func between[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hegel.Integers(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// joined is the texts of a list generator concatenated.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, "") })
+}
+
+// asAny is the generator's values as interface values.
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// pair holds two independent draws as one value.
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// positions: an index into a table of unknown length, taken modulo the length when
+// resolved (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
