+package hegel
+
+// Pins: the documented behaviour behind each recorded bug. They fail while the bug exists and
+// are listed as expected failures in target.toml.
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/hashicorp/go-bexpr"
+)
+
+// mustEval parses and evaluates; a panic in Evaluate is returned as an error so that the test
+// binary survives it.
+func mustEval(t *testing.T, expr string, datum any) (res bool, err error) {
+	t.Helper()
+	ev, err := bexpr.CreateEvaluator(expr)
+	if err != nil {
+		t.Fatalf("CreateEvaluator(%q): %v", expr, err)
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			res, err = false, fmt.Errorf("panic: %v", r)
+		}
+	}()
+	return ev.Evaluate(datum)
+}
+
+// go-bexpr/1: a double-quoted string value is the string it spells, even when it looks like a
+// JSON pointer (the pointer form is for selectors; the Value rule lists selectors first).
+func TestHegelPinSlashString(t *testing.T) {
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`path == "/usr/bin"`, true},
+		{`path != "/usr/bin"`, false},
+		{`path == "usr/bin"`, false},
+		{`"/usr/bin" in paths`, true},
+	} {
+		got, err := mustEval(t, tc.expr, map[string]interface{}{"path": "/usr/bin", "paths": []string{"/usr/bin"}})
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/2: a collection expression is an expression like any other: an operand of and, or
+// and not without parentheses.
+func TestHegelPinCollectionOperand(t *testing.T) {
+	datum := map[string]interface{}{"list": []interface{}{1, 2}, "n": 1}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`any list as v { v == 2 } and n == 1`, true},
+		{`any list as v { v == 2 } or n == 5`, true},
+		{`n == 1 and any list as v { v == 2 }`, true},
+		{`not any list as v { v == 3 }`, true},
+		{`all list as v { v == 1 } or n == 1`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/3: `in` over a []interface{} holding a nil does not panic; a nil element equals
+// nothing and is skipped like an element of another type.
+func TestHegelPinNilElement(t *testing.T) {
+	datum := map[string]interface{}{"list": []interface{}{nil, 1, "a"}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`1 in list`, true},
+		{`"a" in list`, true},
+		{`2 in list`, false},
+		{`list contains a`, true},
+		{`2 not in list`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/4: a double-quoted string literal takes Go escapes (the grammar unquotes it with
+// strconv.Unquote), so an escaped quote is part of the string.
+func TestHegelPinEscapedQuote(t *testing.T) {
+	datum := map[string]interface{}{"s": `a"b`, "m": map[string]interface{}{`k"1`: 5}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`s == "a\"b"`, true},
+		{`s matches "\""`, true},
+		{`m["k\"1"] == 5`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/5: a number literal may be followed directly by the brace closing a collection body.
+func TestHegelPinNumberBeforeBrace(t *testing.T) {
+	datum := map[string]interface{}{"list": []interface{}{1, 2}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`any list as v {v == 2}`, true},
+		{`all list as v {v != 3}`, true},
+		{`any list as v { v == 2}`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/6: `is nil` on a Go array does not panic: an array is never nil (evaluate.go lists
+// arrays with the nil-able kinds, and a struct, which cannot be nil either, gives false).
+func TestHegelPinArrayIsNil(t *testing.T) {
+	datum := map[string]interface{}{"arr": [2]int{1, 2}, "empty": [0]int{}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`arr is nil`, false},
+		{`arr is not nil`, true},
+		{`empty is nil`, false},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/7: `in` over a []interface{} skips the elements the value cannot equal (the code
+// skips a type the value does not parse as), so a nested slice or map does not turn the result
+// into an error, and the order of the elements does not matter.
+func TestHegelPinNestedElement(t *testing.T) {
+	datum := map[string]interface{}{"front": []interface{}{[]interface{}{2}, 2}, "back": []interface{}{2, []interface{}{2}}, "maps": []interface{}{map[string]interface{}{"a": 1}, "x"}}
+	for _, tc := range []struct {
+		expr string
+		want bool
+	}{
+		{`2 in front`, true},
+		{`2 in back`, true},
+		{`3 in front`, false},
+		{`"x" in maps`, true},
+		{`3 not in front`, true},
+	} {
+		got, err := mustEval(t, tc.expr, datum)
+		if err != nil || got != tc.want {
+			t.Errorf("%s = %v, %v; want %v", tc.expr, got, err, tc.want)
+		}
+	}
+}
+
+// go-bexpr/8: binding the same name to the index and the value is an error of the expression,
+// whatever the data (the package rejects it as soon as the collection has an element).
+func TestHegelPinSameNameBinding(t *testing.T) {
+	for _, expr := range []string{`any empty as v, v { v == 1 }`, `all empty as v, v { v == 1 }`, `any m as k, k { k == 1 }`} {
+		got, err := mustEval(t, expr, map[string]interface{}{"empty": []interface{}{}, "m": map[string]interface{}{}})
+		if err == nil {
+			t.Errorf("%s = %v, want an error", expr, got)
+		}
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..99aa8ef
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,167 @@
+package hegel
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/hashicorp/go-bexpr"
+	"github.com/hashicorp/go-bexpr/grammar"
+	"hegel.dev/go/hegel"
+)
+
+// TestHegelParse: a generated expression tree rendered to source (random whitespace, grouping,
+// selector and literal spellings) parses back to the same tree.
+func TestHegelParse(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		want := genTree(ht, 0)
+		src := render(ht, want)
+		ast, err := grammar.Parse("", []byte(src))
+		if err != nil {
+			c.failClass(ht, "Rejected", "parse of %q failed: %v\nwanted %s", src, err, dump(want))
+			return
+		}
+		got, err := fromGrammar(ast.(grammar.Expression))
+		if err != nil {
+			c.failClass(ht, "AST", "%q: %v", src, err)
+			return
+		}
+		if !same(want, got) {
+			c.failClass(ht, "Tree", "parse of %q:\n  want %s\n  got  %s", src, dump(want), dump(got))
+			return
+		}
+		switch {
+		case strings.Contains(src, "any") || strings.Contains(src, "all"):
+			c.count("ok with a collection")
+		case strings.Contains(src, "\"/"):
+			c.count("ok with a pointer")
+		default:
+			c.count("ok")
+		}
+	})
+}
+
+// evalSafely runs Evaluate, turning a panic into an outcome.
+func evalSafely(ev *bexpr.Evaluator, datum any) (o outcome) {
+	defer func() {
+		if r := recover(); r != nil {
+			o = outcome{panic: true}
+		}
+	}()
+	v, err := ev.Evaluate(datum)
+	if err != nil {
+		return outcome{err: true}
+	}
+	return outcome{v: v}
+}
+
+// TestHegelEvaluate: a generated expression over generated data evaluates, through
+// CreateEvaluator and Evaluate, to an outcome the model allows; Filter agrees with Evaluate.
+func TestHegelEvaluate(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		datum := genDatum(ht)
+		n := genExpr(ht, scope{datum: datum}, 0)
+		src := render(ht, n)
+		ev, err := bexpr.CreateEvaluator(src)
+		if err != nil {
+			c.failClass(ht, "Rejected", "CreateEvaluator(%q): %v", src, err)
+			return
+		}
+		m := &model{datum: datum}
+		want := m.eval(n, nil)
+		got := evalSafely(ev, datum)
+		if !want.has(got) {
+			if got.panic && Known.nilElementPanics && want.has(outcome{err: true}) {
+				// an interface slice holding a nil and a nested element: which comes first decides
+				c.count("known panic on a nil element")
+				return
+			}
+			c.failClass(ht, "Mismatch", "Evaluate(%q) on %s = %s, the model allows %s\ntree %s", src, describe(datum), got, want, dump(n))
+			return
+		}
+		switch {
+		case got.panic:
+			c.count("known panic")
+		case len(want) > 1:
+			c.count("ok, order dependent")
+		case got.err:
+			c.count("ok, error")
+		default:
+			c.count(fmt.Sprintf("ok %v", got.v))
+		}
+		// the filter over a few data agrees with element-wise evaluation
+		if chance(ht, 25) && len(want) == 1 {
+			items := []map[string]interface{}{datum}
+			wants := []outcome{got}
+			for k := drawInt(ht, 0, 2); k > 0; k-- {
+				d := genDatum(ht)
+				w := m2eval(d, n)
+				if len(w) != 1 {
+					return
+				}
+				items = append(items, d)
+				for o := range w {
+					wants = append(wants, o)
+				}
+			}
+			f, err := bexpr.CreateFilter(src)
+			if err != nil {
+				c.failClass(ht, "Filter", "CreateFilter(%q): %v", src, err)
+				return
+			}
+			var res any
+			ferr := func() (e error) {
+				defer func() {
+					if r := recover(); r != nil {
+						e = fmt.Errorf("panic: %v", r)
+					}
+				}()
+				res, e = f.Execute(items)
+				return
+			}()
+			var kept []map[string]interface{}
+			bad := false
+			for i, w := range wants {
+				if w.err || w.panic {
+					bad = true
+				} else if w.v {
+					kept = append(kept, items[i])
+				}
+			}
+			if bad {
+				if ferr == nil {
+					c.failClass(ht, "Filter", "Filter(%q) over %d items returned %v, an element errors", src, len(items), res)
+				}
+				return
+			}
+			if ferr != nil {
+				c.failClass(ht, "Filter", "Filter(%q) over %d items: %v", src, len(items), ferr)
+				return
+			}
+			gotItems, _ := res.([]map[string]interface{})
+			if len(kept) == 0 {
+				kept = []map[string]interface{}{}
+			}
+			if gotItems == nil {
+				gotItems = []map[string]interface{}{}
+			}
+			if !reflect.DeepEqual(gotItems, kept) {
+				c.failClass(ht, "Filter", "Filter(%q) kept %v, want %v", src, gotItems, kept)
+				return
+			}
+			c.count("filter ok")
+		}
+	})
+}
+
+func m2eval(d map[string]interface{}, n node) outcomes {
+	m := &model{datum: d}
+	return m.eval(n, nil)
+}
+
+func describe(v any) string {
+	return fmt.Sprintf("%#v", v)
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..d593c76
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,138 @@
+package hegel
+
+// Hegel property tests for hashicorp/go-bexpr, written for the Hegel zoo. See
+// terminfo/dynamic), written for the Hegel zoo. See targets/go/tcell/README.md.
+//
+// Oracle: ncurses. tic compiles generated terminfo sources, infocmp reads the compiled files
+// back (dynamic.LoadTerminfo itself runs infocmp, so the model reads the same output with -x)
+// and tput evaluates parameterized strings; the package must agree with them.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	slashStringIsPointer       bool // 1: a double-quoted string that spells a JSON pointer is read as a selector (its slash lost)
+	collectionNeedsParens      bool // 2: any/all cannot be an operand of and, not, or the left of or without parentheses
+	nilElementPanics           bool // 3: `in` over an interface slice holding a nil panics
+	escapedQuoteUnparsable     bool // 4: a double-quoted string cannot contain an escaped quote
+	numberBeforeBrace          bool // 5: a number right before } is an invalid number literal
+	arrayIsNilPanics           bool // 6: `is nil` on a Go array panics
+	inStopsAtNested            bool // 7: `in` over an interface slice errors at a nested slice or map instead of skipping it
+	sameNameUncheckedWhenEmpty bool // 8: `as k, k` is rejected only when the collection has elements
+}{true, true, true, true, true, true, true, true}
