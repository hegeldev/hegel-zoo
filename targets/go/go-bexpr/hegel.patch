+package hegel
+
+// The model side: an expression tree of our own, its rendering to bexpr source with random
+// whitespace and grouping, the conversion of the package's AST back to ours, generated data,
+// and a model evaluator written from evaluate.go's documented rules (README, the comments in
+// evaluate.go, grammar/ast.go's NotPresentDisposition).
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/hashicorp/go-bexpr/grammar"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- expression trees
+
+type node interface{}
+
+type selector struct {
+	ptr  bool // rendered as a JSON pointer
+	path []string
+}
+
+type matchN struct {
+	sel selector
+	op  grammar.MatchOperator
+	val string // Raw; unused for is-empty / is-nil
+}
+
+type notN struct{ x node }
+
+type binN struct {
+	op   grammar.BinaryOperator
+	l, r node
+}
+
+type collN struct {
+	op            grammar.CollectionOperator
+	sel           selector
+	mode          grammar.CollectionBindMode
+	def, idx, val string
+	inner         node
+}
+
+// hasValue reports whether the operator takes a value.
+func hasValue(op grammar.MatchOperator) bool {
+	switch op {
+	case grammar.MatchIsEmpty, grammar.MatchIsNotEmpty, grammar.MatchIsNil, grammar.MatchIsNotNil:
+		return false
+	}
+	return true
+}
+
+// fromGrammar converts the package's AST to ours.
+func fromGrammar(e grammar.Expression) (node, error) {
+	switch x := e.(type) {
+	case *grammar.UnaryExpression:
+		if x.Operator != grammar.UnaryOpNot {
+			return nil, fmt.Errorf("unary operator %v", x.Operator)
+		}
+		in, err := fromGrammar(x.Operand)
+		if err != nil {
+			return nil, err
+		}
+		return notN{in}, nil
+	case *grammar.BinaryExpression:
+		l, err := fromGrammar(x.Left)
+		if err != nil {
+			return nil, err
+		}
+		r, err := fromGrammar(x.Right)
+		if err != nil {
+			return nil, err
+		}
+		return binN{x.Operator, l, r}, nil
+	case *grammar.MatchExpression:
+		m := matchN{sel: selector{x.Selector.Type == grammar.SelectorTypeJsonPointer, x.Selector.Path}, op: x.Operator}
+		if hasValue(x.Operator) {
+			if x.Value == nil {
+				return nil, errors.New("match without value")
+			}
+			m.val = x.Value.Raw
+		} else if x.Value != nil {
+			return nil, errors.New("value on a unary match")
+		}
+		return m, nil
+	case *grammar.CollectionExpression:
+		in, err := fromGrammar(x.Inner)
+		if err != nil {
+			return nil, err
+		}
+		return collN{x.Op, selector{x.Selector.Type == grammar.SelectorTypeJsonPointer, x.Selector.Path}, x.NameBinding.Mode,
+			x.NameBinding.Default, x.NameBinding.Index, x.NameBinding.Value, in}, nil
+	}
+	return nil, fmt.Errorf("unknown node %T", e)
+}
+
+// same compares two trees; the rendering may choose the pointer form for a selector, so the
+// selector kind is compared only when the expected tree asked for the pointer form.
+func same(want, got node) bool {
+	switch w := want.(type) {
+	case matchN:
+		g, ok := got.(matchN)
+		return ok && w.op == g.op && w.val == g.val && sameSel(w.sel, g.sel)
+	case notN:
+		g, ok := got.(notN)
+		return ok && same(w.x, g.x)
+	case binN:
+		g, ok := got.(binN)
+		return ok && w.op == g.op && same(w.l, g.l) && same(w.r, g.r)
+	case collN:
+		g, ok := got.(collN)
+		return ok && w.op == g.op && w.mode == g.mode && w.def == g.def && w.idx == g.idx && w.val == g.val && sameSel(w.sel, g.sel) && same(w.inner, g.inner)
+	}
+	return false
+}
+
+func sameSel(w, g selector) bool {
+	return w.ptr == g.ptr && strings.Join(w.path, "\x00") == strings.Join(g.path, "\x00")
+}
+
+func dump(n node) string {
+	switch x := n.(type) {
+	case matchN:
+		if hasValue(x.op) {
+			return fmt.Sprintf("Match(%v %s %q)", x.sel.path, x.op, x.val)
+		}
+		return fmt.Sprintf("Match(%v %s)", x.sel.path, x.op)
+	case notN:
+		return "Not(" + dump(x.x) + ")"
+	case binN:
+		return fmt.Sprintf("%s(%s, %s)", x.op, dump(x.l), dump(x.r))
+	case collN:
+		return fmt.Sprintf("%s(%v as %s/%q/%q/%q { %s })", x.op, x.sel.path, x.mode, x.def, x.idx, x.val, dump(x.inner))
+	}
+	return fmt.Sprintf("%#v", n)
+}
+
+// --------------------------------------------------------------------------- lexical classes
+
+var (
+	identRe   = regexp.MustCompile(`^[a-zA-Z][a-zA-Z0-9_/]*$`)
+	digitsRe  = regexp.MustCompile(`^[0-9]+$`)
+	numberRe  = regexp.MustCompile(`^-?(0|[1-9][0-9]*)(\.[0-9]+)?$`)
+	ptrSegRe  = regexp.MustCompile(`^[\pL\pN\-_.~:|]+$`)
+	keywords  = map[string]bool{"not": true, "and": true, "or": true, "any": true, "all": true, "as": true, "in": true, "is": true, "empty": true, "nil": true, "contains": true, "matches": true}
+	varNames  = []string{"v", "w", "k", "i", "item", "x", "k2"}
+	keyNames  = []string{"a", "b", "c", "k", "x", "ab", "a_b", "A1", "a/b", "a b", "0", "", "~x", "d.e", "q\"r", "s`t", "/p"}
+	wsChoices = []string{" ", " ", " ", "\t", "\n", "  ", " \n "}
+)
+
+func isIdent(s string) bool { return identRe.MatchString(s) && !keywords[s] }
+
+// bareSelectorValue reports whether s renders unquoted as a dotted selector (the first alternative
+// of Value): identifiers and digit runs joined by dots, the first an identifier.
+func bareSelectorValue(s string) bool {
+	parts := strings.Split(s, ".")
+	if !isIdent(parts[0]) {
+		return false
+	}
+	for _, p := range parts[1:] {
+		if !isIdent(p) && !digitsRe.MatchString(p) {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- rendering
+
+type renderer struct {
+	tc hegel.TestCase
+	b  strings.Builder
+}
+
+func (r *renderer) ws() { r.b.WriteString(pick(r.tc, wsChoices)) }
+func (r *renderer) ows() { // optional whitespace
+	if chance(r.tc, 30) {
+		r.ws()
+	}
+}
+
+func (r *renderer) str(s string) { r.b.WriteString(s) }
+
+// quoteString renders s as a string literal. Under Known.escapedQuoteUnparsable a string holding
+// both quote characters cannot be written; the generator does not produce one then.
+func quoteString(tc hegel.TestCase, s string, isValue bool) string {
+	// a raw string must be valid UTF-8 (strconv.Unquote); a value spelling a JSON pointer must
+	// not be double-quoted while Known.slashStringIsPointer stands
+	raw := utf8.ValidString(s) && !strings.Contains(s, "`") && !strings.Contains(s, "\r")
+	if raw && (chance(tc, 50) || strings.Contains(s, "\"") || (isValue && Known.slashStringIsPointer && strings.HasPrefix(s, "/"))) {
+		return "`" + s + "`"
+	}
+	return strconv.Quote(s)
+}
+
+func (r *renderer) selector(sel selector) {
+	if sel.ptr {
+		r.str("\"")
+		for _, p := range sel.path {
+			r.str("/" + strings.ReplaceAll(strings.ReplaceAll(p, "~", "~0"), "/", "~1"))
+		}
+		r.str("\"")
+		return
+	}
+	r.str(sel.path[0])
+	for _, p := range sel.path[1:] {
+		switch {
+		case (isIdent(p) || digitsRe.MatchString(p)) && chance(r.tc, 70):
+			r.str("." + p)
+		default:
+			r.str("[")
+			r.ows()
+			r.str(quoteString(r.tc, p, false))
+			r.ows()
+			r.str("]")
+		}
+	}
+}
+
+// pointerable reports whether a selector can be written as a JSON pointer.
+func pointerable(path []string) bool {
+	for _, p := range path {
+		e := strings.ReplaceAll(strings.ReplaceAll(p, "~", "~0"), "/", "~1")
+		if !ptrSegRe.MatchString(e) {
+			return false
+		}
+	}
+	return true
+}
+
+// value renders a match value: bare when it reads as a selector or a number, quoted otherwise.
+func (r *renderer) value(v string) {
+	switch {
+	case bareSelectorValue(v) && chance(r.tc, 80):
+		r.str(v)
+	case numberRe.MatchString(v) && chance(r.tc, 85):
+		r.str(v)
+	default:
+		r.str(quoteString(r.tc, v, true))
+	}
+}
+
+func (r *renderer) keyword(k string) { r.ws(); r.str(k); r.ws() }
+
+// expr renders n; ctx tells where it stands so that grouping keeps the tree: "or-left",
+// "or-right", "and-left", "and-right", "not", "top", "inner".
+func (r *renderer) expr(n node, ctx string) {
+	paren := chance(r.tc, 15)
+	switch x := n.(type) {
+	case binN:
+		if x.op == grammar.BinaryOpOr && ctx != "top" && ctx != "inner" && ctx != "or-right" {
+			paren = true
+		}
+		if x.op == grammar.BinaryOpAnd && (ctx == "or-left" || ctx == "and-left" || ctx == "not") {
+			paren = true
+		}
+	case collN:
+		// a collection expression stands alone, in parentheses, or (as the grammar has it) as
+		// the right operand of or
+		if ctx != "top" && ctx != "inner" && ctx != "or-right" {
+			paren = true
+		}
+	}
+	if paren {
+		r.str("(")
+		r.ows()
+		defer func() { r.ows(); r.str(")") }()
+		ctx = "inner"
+	}
+	switch x := n.(type) {
+	case matchN:
+		if x.op == grammar.MatchIn || x.op == grammar.MatchNotIn {
+			// two spellings: `value in selector` and `selector contains value`
+			if chance(r.tc, 50) {
+				r.value(x.val)
+				r.keyword(map[grammar.MatchOperator]string{grammar.MatchIn: "in", grammar.MatchNotIn: "not in"}[x.op])
+				r.selector(x.sel)
+			} else {
+				r.selector(x.sel)
+				r.keyword(map[grammar.MatchOperator]string{grammar.MatchIn: "contains", grammar.MatchNotIn: "not contains"}[x.op])
+				r.value(x.val)
+			}
+			return
+		}
+		r.selector(x.sel)
+		switch x.op {
+		case grammar.MatchEqual, grammar.MatchNotEqual:
+			r.ows()
+			r.str(map[grammar.MatchOperator]string{grammar.MatchEqual: "==", grammar.MatchNotEqual: "!="}[x.op])
+			r.ows()
+			r.value(x.val)
+		case grammar.MatchMatches:
+			r.keyword("matches")
+			r.value(x.val)
+		case grammar.MatchNotMatches:
+			r.keyword("not matches")
+			r.value(x.val)
+		case grammar.MatchIsEmpty:
+			r.keyword("is")
+			r.str("empty")
+		case grammar.MatchIsNotEmpty:
+			r.keyword("is")
+			r.str("not")
+			r.ws()
+			r.str("empty")
+		case grammar.MatchIsNil:
+			r.keyword("is")
+			r.str("nil")
+		case grammar.MatchIsNotNil:
+			r.keyword("is")
+			r.str("not")
+			r.ws()
+			r.str("nil")
+		}
+	case notN:
+		r.str("not")
+		r.ws()
+		r.expr(x.x, "not")
+	case binN:
+		if x.op == grammar.BinaryOpOr {
+			r.expr(x.l, "or-left")
+			r.keyword("or")
+			r.expr(x.r, "or-right")
+		} else {
+			r.expr(x.l, "and-left")
+			r.keyword("and")
+			r.expr(x.r, "and-right")
+		}
+	case collN:
+		r.str(strings.ToLower(string(x.op)))
+		r.ws()
+		r.selector(x.sel)
+		r.keyword("as")
+		switch x.mode {
+		case grammar.CollectionBindDefault:
+			r.str(x.def)
+		case grammar.CollectionBindIndex:
+			r.str(x.idx)
+			r.ows()
+			r.str(",")
+			r.ows()
+			r.str("_")
+		case grammar.CollectionBindValue:
+			r.str("_")
+			r.ows()
+			r.str(",")
+			r.ows()
+			r.str(x.val)
+		case grammar.CollectionBindIndexAndValue:
+			r.str(x.idx)
+			r.ows()
+			r.str(",")
+			r.ows()
+			r.str(x.val)
+		}
+		r.ows()
+		r.str("{")
+		r.ows()
+		r.expr(x.inner, "inner")
+		s := r.b.String()
+		if Known.numberBeforeBrace && s[len(s)-1] >= '0' && s[len(s)-1] <= '9' {
+			r.ws() // a number wants whitespace before the closing brace
+		} else {
+			r.ows()
+		}
+		r.str("}")
+	}
+}
+
+// render writes n as source, with optional outer parentheses and surrounding whitespace.
+func render(tc hegel.TestCase, n node) string {
+	r := &renderer{tc: tc}
+	r.ows()
+	if chance(tc, 10) {
+		r.str("(")
+		r.ows()
+		r.expr(n, "inner")
+		r.ows()
+		r.str(")")
+	} else {
+		r.expr(n, "top")
+	}
+	r.ows()
+	return r.b.String()
+}
+
+// --------------------------------------------------------------------------- data
+
+func genScalar(tc hegel.TestCase) any {
+	switch drawInt(tc, 0, 8) {
+	case 0:
+		return nil
+	case 1:
+		return chance(tc, 50)
+	case 2:
+		return drawInt(tc, -3, 20)
+	case 3:
+		return int8(drawInt(tc, -128, 127))
+	case 4:
+		return uint(drawInt(tc, 0, 300))
+	case 5:
+		return float64(drawInt(tc, -20, 20)) / pick(tc, []float64{1, 2, 4, 10})
+	case 6:
+		return float32(drawInt(tc, -20, 20)) / pick(tc, []float32{1, 2, 4, 10})
+	default:
+		return genText(tc)
+	}
+}
+
+func genText(tc hegel.TestCase) string {
+	var b strings.Builder
+	for n := drawInt(tc, 0, 6); n > 0; n-- {
+		b.WriteString(pick(tc, []string{"a", "b", "c", "x", "0", "1", "16", "-", ".", "/", " ", "\"", "`", "~", "\\", "\n", "\t", "\r", "Z", "é", "日", "$", "*", "(", "[", "^"}))
+	}
+	return b.String()
+}
+
+func genValue(tc hegel.TestCase, depth int) any {
+	if depth >= 3 || chance(tc, 45) {
+		return genScalar(tc)
+	}
+	switch drawInt(tc, 0, 7) {
+	case 0, 1:
+		n := drawInt(tc, 0, 4)
+		s := make([]interface{}, n)
+		for i := range s {
+			s[i] = genValue(tc, depth+1)
+		}
+		return s
+	case 2:
+		if chance(tc, 15) {
+			return []int(nil)
+		}
+		s := make([]int, drawInt(tc, 0, 4))
+		for i := range s {
+			s[i] = drawInt(tc, -3, 20)
+		}
+		return s
+	case 3:
+		s := make([]string, drawInt(tc, 0, 3))
+		for i := range s {
+			s[i] = genText(tc)
+		}
+		return s
+	case 4:
+		switch drawInt(tc, 0, 2) {
+		case 0:
+			return [0]int{}
+		case 1:
+			return [2]int{drawInt(tc, 0, 5), drawInt(tc, 0, 5)}
+		default:
+			return [1]string{genText(tc)}
+		}
+	case 5:
+		m := map[string]int{}
+		for n := drawInt(tc, 0, 3); n > 0; n-- {
+			m[pick(tc, keyNames)] = drawInt(tc, -3, 20)
+		}
+		return m
+	case 6:
+		if chance(tc, 15) {
+			return map[string]string(nil)
+		}
+		m := map[string]string{}
+		for n := drawInt(tc, 0, 3); n > 0; n-- {
+			m[pick(tc, keyNames)] = genText(tc)
+		}
+		return m
+	default:
+		m := map[string]interface{}{}
+		for n := drawInt(tc, 0, 4); n > 0; n-- {
+			m[pick(tc, keyNames)] = genValue(tc, depth+1)
+		}
+		return m
+	}
+}
+
+func genDatum(tc hegel.TestCase) map[string]interface{} {
+	m := map[string]interface{}{}
+	for n := drawInt(tc, 1, 5); n > 0; n-- {
+		// a selector starts with an identifier, so top-level keys are identifiers
+		m[pick(tc, []string{"a", "b", "c", "k", "x", "ab", "a_b", "A1", "a/b", "v"})] = genValue(tc, 1)
+	}
+	return m
+}
+
+// paths lists every path into v (including the empty path for v itself) with its value.
+type pathVal struct {
+	path []string
+	val  any
+}
+
+func paths(v any, prefix []string) []pathVal {
+	out := []pathVal{{append([]string(nil), prefix...), v}}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Map:
+		keys := rv.MapKeys()
+		sort.Slice(keys, func(i, j int) bool { return keys[i].String() < keys[j].String() })
+		for _, k := range keys {
+			out = append(out, paths(rv.MapIndex(k).Interface(), append(append([]string(nil), prefix...), k.String()))...)
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < rv.Len(); i++ {
+			out = append(out, paths(rv.Index(i).Interface(), append(append([]string(nil), prefix...), strconv.Itoa(i)))...)
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- expression generator over data
+
+// binding is a collection variable in scope: a value (map key or slice index) or an alias of a
+// path into the datum; sample is a value the alias stands for, for generating sub-paths.
+type binding struct {
+	name   string
+	isVal  bool
+	value  any
+	path   []string
+	sample any
+}
+
+type scope struct {
+	datum map[string]interface{}
+	env   []binding // innermost last
+}
+
+// pickTarget draws a selector and the value it denotes (nil, false when unknown or garbage).
+func (s scope) pickTarget(tc hegel.TestCase) (selector, any, bool) {
+	// a bound variable
+	if len(s.env) > 0 && chance(tc, 55) {
+		b := pick(tc, s.env)
+		if b.isVal {
+			sel := selector{path: []string{b.name}}
+			if chance(tc, 10) {
+				sel.path = append(sel.path, "x") // a sub-path of a key or index: an error
+				return sel, nil, false
+			}
+			return sel, b.value, true
+		}
+		ps := paths(b.sample, []string{b.name})
+		p := pick(tc, ps)
+		return selector{path: p.path}, p.val, true
+	}
+	ps := paths(s.datum, nil)[1:]
+	if len(ps) == 0 || chance(tc, 12) {
+		// garbage: a missing key, an out-of-range index, a path through a scalar
+		p := []string{pick(tc, []string{"zz", "a", "b", "missing"})}
+		if len(ps) > 0 && chance(tc, 70) {
+			p = append(append([]string(nil), pick(tc, ps).path...), pick(tc, []string{"zz", "9", "0", "q"}))
+		}
+		return selector{path: p}, nil, false
+	}
+	p := pick(tc, ps)
+	return selector{path: append([]string(nil), p.path...)}, p.val, true
+}
+
+// valueFor draws a match value for the target value v: mostly one that could equal it or be
+// found in it, sometimes a stranger.
+func valueFor(tc hegel.TestCase, v any, known bool) string {
+	if !known || chance(tc, 20) {
+		return pick(tc, []string{"1", "0", "-1", "16", "1.5", "true", "false", "T", "x", "a", "abc", "0x10", "1_6", "", "a b", "/p", "^a", "[0-9]+", "(", "99999999999999999999", "1e3", "NaN"})
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Bool:
+		return pick(tc, []string{strconv.FormatBool(rv.Bool()), "1", "0", "t", "F"})
+	case reflect.Int, reflect.Int8:
+		return pick(tc, []string{strconv.FormatInt(rv.Int(), 10), strconv.FormatInt(rv.Int()+1, 10), "0x" + strconv.FormatInt(rv.Int(), 16), strconv.FormatInt(rv.Int(), 10) + ".0"})
+	case reflect.Uint:
+		return pick(tc, []string{strconv.FormatUint(rv.Uint(), 10), "-1", strconv.FormatUint(rv.Uint()+1, 10)})
+	case reflect.Float64, reflect.Float32:
+		return pick(tc, []string{strconv.FormatFloat(rv.Float(), 'g', -1, 64), strconv.FormatFloat(rv.Float(), 'f', 2, 64), strconv.FormatFloat(rv.Float()+1, 'g', -1, 64), "1.50000001"})
+	case reflect.String:
+		s := rv.String()
+		switch drawInt(tc, 0, 4) {
+		case 0:
+			return s
+		case 1:
+			if len(s) > 1 {
+				i := drawInt(tc, 0, len(s)-1)
+				j := drawInt(tc, i, len(s))
+				return s[i:j]
+			}
+			return s
+		case 2:
+			return "^" + regexp.QuoteMeta(s)
+		case 3:
+			return pick(tc, []string{"a", ".", "[a-c]+", "x$", "(", "\\d"})
+		default:
+			return genText(tc)
+		}
+	case reflect.Slice, reflect.Array:
+		if rv.Len() > 0 && chance(tc, 75) {
+			e := rv.Index(drawInt(tc, 0, rv.Len()-1)).Interface()
+			if e == nil {
+				return "x"
+			}
+			ev := reflect.ValueOf(e)
+			switch ev.Kind() {
+			case reflect.Slice, reflect.Array, reflect.Map:
+				return "1"
+			}
+			return fmt.Sprint(e)
+		}
+		return pick(tc, []string{"1", "a", "x", "true"})
+	case reflect.Map:
+		keys := rv.MapKeys()
+		if len(keys) > 0 && chance(tc, 75) {
+			return keys[drawInt(tc, 0, len(keys)-1)].String()
+		}
+		return pick(tc, []string{"a", "zz", "1"})
+	}
+	return "1"
+}
+
+var allMatchOps = []grammar.MatchOperator{grammar.MatchEqual, grammar.MatchNotEqual, grammar.MatchIn, grammar.MatchNotIn, grammar.MatchIsEmpty,
+	grammar.MatchIsNotEmpty, grammar.MatchMatches, grammar.MatchNotMatches, grammar.MatchIsNil, grammar.MatchIsNotNil}
+
+// opFor draws an operator suited to the target value's kind (with a stranger now and then).
+func opFor(tc hegel.TestCase, v any, known bool) grammar.MatchOperator {
+	if !known || chance(tc, 15) {
+		return pick(tc, allMatchOps)
+	}
+	switch reflect.ValueOf(v).Kind() {
+	case reflect.String:
+		return pick(tc, []grammar.MatchOperator{grammar.MatchEqual, grammar.MatchNotEqual, grammar.MatchIn, grammar.MatchNotIn, grammar.MatchMatches, grammar.MatchNotMatches, grammar.MatchIsEmpty, grammar.MatchIsNotEmpty})
+	case reflect.Slice, reflect.Array, reflect.Map:
+		return pick(tc, []grammar.MatchOperator{grammar.MatchIn, grammar.MatchNotIn, grammar.MatchIsEmpty, grammar.MatchIsNotEmpty, grammar.MatchIsNil, grammar.MatchIsNotNil})
+	case reflect.Invalid:
+		return pick(tc, []grammar.MatchOperator{grammar.MatchIsNil, grammar.MatchIsNotNil, grammar.MatchEqual, grammar.MatchIsEmpty})
+	}
+	return pick(tc, []grammar.MatchOperator{grammar.MatchEqual, grammar.MatchNotEqual, grammar.MatchEqual, grammar.MatchNotEqual, grammar.MatchIsNil, grammar.MatchIn})
+}
+
+// fixValue makes a value writable while the recorded grammar bugs stand: a double-quoted
+// string cannot start with a slash (Known.slashStringIsPointer: the backtick form is used when
+// possible, otherwise the slash is dropped) and a string cannot hold both quote characters
+// (Known.escapedQuoteUnparsable).
+func fixValue(v string) string {
+	if Known.slashStringIsPointer && strings.HasPrefix(v, "/") && strings.Contains(v, "`") {
+		v = strings.TrimLeft(v, "/")
+	}
+	if Known.escapedQuoteUnparsable && strings.Contains(v, "\"") && (strings.Contains(v, "`") || strings.Contains(v, "\r") || !utf8.ValidString(v)) {
+		v = strings.ReplaceAll(v, "\"", "'") // only the raw form can hold a quote, and this string cannot be raw
+	}
+	return v
+}
+
+func fixSelector(sel selector) selector {
+	for i, p := range sel.path {
+		sel.path[i] = fixValue(p)
+	}
+	return sel
+}
+
+// genExpr draws an expression over the scope, depth-limited.
+func genExpr(tc hegel.TestCase, s scope, depth int) node {
+	r := drawInt(tc, 1, 100)
+	switch {
+	case depth >= 3 || r <= 50:
+		sel, v, known := s.pickTarget(tc)
+		sel = fixSelector(sel)
+		if chance(tc, 25) && pointerable(sel.path) && len(sel.path) > 0 {
+			sel.ptr = true
+		}
+		op := opFor(tc, v, known)
+		m := matchN{sel: sel, op: op}
+		if hasValue(op) {
+			m.val = fixValue(valueFor(tc, v, known))
+		}
+		return m
+	case r <= 62:
+		x := genExpr(tc, s, depth+1)
+		if _, ok := x.(notN); ok {
+			return x // not not x is x in the package's AST
+		}
+		return notN{x}
+	case r <= 84:
+		return binN{pick(tc, []grammar.BinaryOperator{grammar.BinaryOpAnd, grammar.BinaryOpOr}), genExpr(tc, s, depth+1), genExpr(tc, s, depth+1)}
+	default:
+		return genColl(tc, s, depth)
+	}
+}
+
+func genColl(tc hegel.TestCase, s scope, depth int) node {
+	// a container target when there is one
+	var sel selector
+	var v any
+	known := false
+	for try := 0; try < 4; try++ {
+		sel, v, known = s.pickTarget(tc)
+		k := reflect.ValueOf(v).Kind()
+		if known && (k == reflect.Map || k == reflect.Slice || k == reflect.Array) {
+			break
+		}
+	}
+	sel = fixSelector(sel)
+	if chance(tc, 25) && pointerable(sel.path) {
+		sel.ptr = true
+	}
+	c := collN{op: pick(tc, []grammar.CollectionOperator{grammar.CollectionOpAny, grammar.CollectionOpAll}), sel: sel}
+	names := func() (string, string) {
+		a, b := pick(tc, varNames), pick(tc, varNames)
+		if a == b && chance(tc, 80) {
+			b = a + "2"
+		}
+		return a, b
+	}
+	rv := reflect.ValueOf(v)
+	var sample, keySample, idxSample any
+	if known && rv.Kind() == reflect.Map && rv.Len() > 0 {
+		k := rv.MapKeys()[drawInt(tc, 0, rv.Len()-1)]
+		keySample = k.Interface()
+		sample = rv.MapIndex(k).Interface()
+	} else if known && (rv.Kind() == reflect.Slice || rv.Kind() == reflect.Array) && rv.Len() > 0 {
+		i := drawInt(tc, 0, rv.Len()-1)
+		idxSample = i
+		sample = rv.Index(i).Interface()
+	}
+	inner := s
+	inner.env = append([]binding(nil), s.env...)
+	isMap := known && rv.Kind() == reflect.Map
+	switch drawInt(tc, 0, 3) {
+	case 0:
+		c.mode = grammar.CollectionBindDefault
+		c.def, _ = names()
+		if isMap {
+			inner.env = append(inner.env, binding{name: c.def, isVal: true, value: keySample})
+		} else {
+			inner.env = append(inner.env, binding{name: c.def, path: append(append([]string(nil), sel.path...), "0"), sample: sample})
+		}
+	case 1:
+		c.mode = grammar.CollectionBindIndex
+		c.idx, _ = names()
+		if isMap {
+			inner.env = append(inner.env, binding{name: c.idx, isVal: true, value: keySample})
+		} else {
+			inner.env = append(inner.env, binding{name: c.idx, isVal: true, value: idxSample})
+		}
+	case 2:
+		c.mode = grammar.CollectionBindValue
+		_, c.val = names()
+		inner.env = append(inner.env, binding{name: c.val, path: append(append([]string(nil), sel.path...), "0"), sample: sample})
+	default:
+		c.mode = grammar.CollectionBindIndexAndValue
+		c.idx, c.val = names()
+		if isMap {
+			inner.env = append(inner.env, binding{name: c.idx, isVal: true, value: keySample})
+		} else {
+			inner.env = append(inner.env, binding{name: c.idx, isVal: true, value: idxSample})
+		}
+		inner.env = append(inner.env, binding{name: c.val, path: append(append([]string(nil), sel.path...), "0"), sample: sample})
+	}
+	c.inner = genExpr(tc, inner, depth+1)
+	return c
+}
+
+// genTree draws an expression with no data behind it, for the parse property.
+func genTree(tc hegel.TestCase, depth int) node {
+	s := scope{datum: genDatum(tc)}
+	return genExpr(tc, s, depth)
+}
+
+// --------------------------------------------------------------------------- model evaluator
+
+// outcome is one possible result of an evaluation: a value, an error, or a panic.
+type outcome struct {
+	v     bool
+	err   bool
+	panic bool
+}
+
+func (o outcome) String() string {
+	switch {
+	case o.panic:
+		return "panic"
+	case o.err:
+		return "error"
+	}
+	return strconv.FormatBool(o.v)
+}
+
+// outcomes is a set of possible outcomes (map iteration order makes some evaluations
+// nondeterministic: an element that errors and one that decides can come in either order).
+type outcomes map[outcome]bool
+
+func one(o outcome) outcomes          { return outcomes{o: true} }
+func val(b bool) outcomes             { return one(outcome{v: b}) }
+func errOut() outcomes                { return one(outcome{err: true}) }
+func panicOut() outcomes              { return one(outcome{panic: true}) }
+func (s outcomes) has(o outcome) bool { return s[o] }
+
+func (s outcomes) String() string {
+	var parts []string
+	for o := range s {
+		parts = append(parts, o.String())
+	}
+	sort.Strings(parts)
+	return "{" + strings.Join(parts, ",") + "}"
+}
+
+// mapOutcomes applies f to every value outcome, keeping errors and panics.
+func mapOutcomes(s outcomes, f func(bool) outcomes) outcomes {
+	out := outcomes{}
+	for o := range s {
+		if o.err || o.panic {
+			out[o] = true
+			continue
+		}
+		for p := range f(o.v) {
+			out[p] = true
+		}
+	}
+	return out
+}
+
+// mbinding is a collection variable as the evaluator sees it.
+type mbinding struct {
+	name  string
+	isVal bool
+	value any
+	path  []string
+}
+
+type model struct {
+	datum map[string]interface{}
+}
+
+// get resolves a selector path: the value, whether it is present (a missing map key at the end
+// of a path of two or more parts is "not present"), and whether the lookup errors.
+func (m *model) get(path []string, env []mbinding) (any, bool, bool) {
+	full := path
+	for i := len(env) - 1; i >= 0; i-- {
+		if env[i].name == full[0] {
+			if env[i].isVal {
+				if len(full) > 1 {
+					return nil, false, true
+				}
+				return env[i].value, true, false
+			}
+			full = append(append([]string(nil), env[i].path...), full[1:]...)
+		}
+	}
+	var cur any = m.datum
+	for i, part := range full {
+		rv := reflect.ValueOf(cur)
+		switch rv.Kind() {
+		case reflect.Map:
+			mv := rv.MapIndex(reflect.ValueOf(part))
+			if !mv.IsValid() {
+				if i == len(full)-1 && len(full) >= 2 {
+					return nil, false, false
+				}
+				return nil, false, true
+			}
+			cur = mv.Interface()
+		case reflect.Slice, reflect.Array:
+			n, err := strconv.Atoi(part)
+			if err != nil || n < 0 || n >= rv.Len() {
+				return nil, false, true
+			}
+			cur = rv.Index(n).Interface()
+		default:
+			return nil, false, true
+		}
+	}
+	return cur, true, false
+}
+
+func isPrimitive(k reflect.Kind) bool {
+	switch k {
+	case reflect.Bool, reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Float32, reflect.Float64, reflect.String:
+		return true
+	}
+	return false
+}
+
+// coerce converts the raw value for a primitive kind, as coerce.go does.
+func coerce(raw string, k reflect.Kind) (any, error) {
+	switch k {
+	case reflect.Bool:
+		return strconv.ParseBool(raw)
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return strconv.ParseInt(raw, 0, 64)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return strconv.ParseUint(raw, 0, 64)
+	case reflect.Float32:
+		f, err := strconv.ParseFloat(raw, 32)
+		return float32(f), err
+	case reflect.Float64:
+		return strconv.ParseFloat(raw, 64)
+	}
+	return raw, nil
+}
+
+// equal compares a coerced value with a primitive.
+func equal(c any, rv reflect.Value) bool {
+	switch rv.Kind() {
+	case reflect.Bool:
+		return c.(bool) == rv.Bool()
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return c.(int64) == rv.Int()
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return c.(uint64) == rv.Uint()
+	case reflect.Float32:
+		return c.(float32) == float32(rv.Float())
+	case reflect.Float64:
+		return c.(float64) == rv.Float()
+	case reflect.String:
+		return c.(string) == rv.String()
+	}
+	return false
+}
+
+func (m *model) match(x matchN, env []mbinding) outcomes {
+	v, present, bad := m.get(x.sel.path, env)
+	if bad {
+		return errOut()
+	}
+	if !present {
+		return val(x.op.NotPresentDisposition())
+	}
+	rv := reflect.ValueOf(v)
+	neg := false
+	base := x.op
+	switch x.op {
+	case grammar.MatchNotEqual:
+		base, neg = grammar.MatchEqual, true
+	case grammar.MatchNotIn:
+		base, neg = grammar.MatchIn, true
+	case grammar.MatchIsNotEmpty:
+		base, neg = grammar.MatchIsEmpty, true
+	case grammar.MatchNotMatches:
+		base, neg = grammar.MatchMatches, true
+	case grammar.MatchIsNotNil:
+		base, neg = grammar.MatchIsNil, true
+	}
+	var res outcomes
+	switch base {
+	case grammar.MatchEqual:
+		if !isPrimitive(rv.Kind()) {
+			return errOut()
+		}
+		c, err := coerce(x.val, rv.Kind())
+		if err != nil {
+			return errOut()
+		}
+		res = val(equal(c, rv))
+	case grammar.MatchIn:
+		res = m.in(x.val, rv)
+	case grammar.MatchIsEmpty:
+		switch rv.Kind() {
+		case reflect.Map, reflect.Slice, reflect.Array, reflect.String:
+			res = val(rv.Len() == 0)
+		default:
+			return errOut()
+		}
+	case grammar.MatchMatches:
+		if rv.Kind() != reflect.String {
+			return errOut()
+		}
+		re, err := regexp.Compile(x.val)
+		if err != nil {
+			return errOut()
+		}
+		res = val(re.MatchString(rv.String()))
+	case grammar.MatchIsNil:
+		switch rv.Kind() {
+		case reflect.Map, reflect.Slice:
+			res = val(rv.IsNil())
+		case reflect.Array:
+			if Known.arrayIsNilPanics {
+				return panicOut()
+			}
+			res = val(false)
+		case reflect.Invalid:
+			res = val(true)
+		default:
+			return errOut()
+		}
+	}
+	if neg {
+		return mapOutcomes(res, func(b bool) outcomes { return val(!b) })
+	}
+	return res
+}
+
+// in models doMatchIn.
+func (m *model) in(raw string, rv reflect.Value) outcomes {
+	switch rv.Kind() {
+	case reflect.Map:
+		return val(rv.MapIndex(reflect.ValueOf(raw)).IsValid())
+	case reflect.String:
+		return val(strings.Contains(rv.String(), raw))
+	case reflect.Slice, reflect.Array:
+		if rv.Type().Elem().Kind() != reflect.Interface {
+			c, err := coerce(raw, rv.Type().Elem().Kind())
+			if err != nil {
+				return errOut()
+			}
+			for i := 0; i < rv.Len(); i++ {
+				if equal(c, rv.Index(i)) {
+					return val(true)
+				}
+			}
+			return val(false)
+		}
+		for i := 0; i < rv.Len(); i++ {
+			e := rv.Index(i).Interface()
+			if e == nil {
+				if Known.nilElementPanics {
+					return panicOut()
+				}
+				continue
+			}
+			ev := reflect.ValueOf(e)
+			if !isPrimitive(ev.Kind()) {
+				if Known.inStopsAtNested {
+					return errOut()
+				}
+				continue
+			}
+			c, err := coerce(raw, ev.Kind())
+			if err != nil {
+				if errors.Is(err, strconv.ErrSyntax) {
+					continue
+				}
+				return errOut()
+			}
+			if equal(c, ev) {
+				return val(true)
+			}
+		}
+		return val(false)
+	}
+	return errOut()
+}
+
+func (m *model) eval(n node, env []mbinding) outcomes {
+	switch x := n.(type) {
+	case matchN:
+		return m.match(x, env)
+	case notN:
+		return mapOutcomes(m.eval(x.x, env), func(b bool) outcomes { return val(!b) })
+	case binN:
+		return mapOutcomes(m.eval(x.l, env), func(b bool) outcomes {
+			if (x.op == grammar.BinaryOpAnd && !b) || (x.op == grammar.BinaryOpOr && b) {
+				return val(b)
+			}
+			return m.eval(x.r, env)
+		})
+	case collN:
+		return m.coll(x, env)
+	}
+	return errOut()
+}
+
+// coll models evaluateCollectionExpression. Slices are visited in order; a map's elements in
+// any order, so every element that decides may come first.
+func (m *model) coll(x collN, env []mbinding) outcomes {
+	v, present, bad := m.get(x.sel.path, env)
+	if bad {
+		return errOut()
+	}
+	if !present {
+		return val(x.op == grammar.CollectionOpAll)
+	}
+	rv := reflect.ValueOf(v)
+	switch rv.Kind() {
+	case reflect.Map, reflect.Slice, reflect.Array:
+	default:
+		return errOut()
+	}
+	if rv.Kind() == reflect.Map && rv.Type().Key().Kind() != reflect.String {
+		return errOut()
+	}
+	if x.mode == grammar.CollectionBindIndexAndValue && x.idx == x.val && (rv.Len() > 0 || !Known.sameNameUncheckedWhenEmpty) {
+		return errOut()
+	}
+	decisive := x.op == grammar.CollectionOpAny // the value that ends the loop
+	var per []outcomes
+	for i := 0; i < rv.Len(); i++ {
+		inner := append([]mbinding(nil), env...)
+		if rv.Kind() == reflect.Map {
+			keys := rv.MapKeys()
+			sort.Slice(keys, func(a, b int) bool { return keys[a].String() < keys[b].String() })
+			key := keys[i].String()
+			if x.def != "" {
+				inner = append(inner, mbinding{name: x.def, isVal: true, value: key})
+			}
+			if x.idx != "" {
+				inner = append(inner, mbinding{name: x.idx, isVal: true, value: key})
+			}
+			if x.val != "" {
+				inner = append(inner, mbinding{name: x.val, path: append(append([]string(nil), x.sel.path...), key)})
+			}
+		} else {
+			if x.idx != "" {
+				inner = append(inner, mbinding{name: x.idx, isVal: true, value: i})
+			}
+			p := append(append([]string(nil), x.sel.path...), strconv.Itoa(i))
+			if x.def != "" {
+				inner = append(inner, mbinding{name: x.def, path: p})
+			}
+			if x.val != "" {
+				inner = append(inner, mbinding{name: x.val, path: p})
+			}
+		}
+		// the variable path must be resolved in the outer environment, as the package does
+		// by rewriting it progressively; our aliases are absolute, so resolve now
+		for j := len(env); j < len(inner); j++ {
+			if !inner[j].isVal {
+				inner[j].path = m.resolve(inner[j].path, env)
+			}
+		}
+		per = append(per, m.eval(x.inner, inner))
+	}
+	out := outcomes{}
+	final := outcome{v: x.op == grammar.CollectionOpAll}
+	if rv.Kind() == reflect.Map {
+		allContinue := true
+		for _, s := range per {
+			for o := range s {
+				if o.err || o.panic || o.v == decisive {
+					out[o] = true
+				}
+			}
+			if !s.has(outcome{v: !decisive}) {
+				allContinue = false
+			}
+		}
+		if allContinue {
+			out[final] = true
+		}
+		return out
+	}
+	// in order
+	for _, s := range per {
+		cont := false
+		for o := range s {
+			if o.err || o.panic || o.v == decisive {
+				out[o] = true
+			} else {
+				cont = true
+			}
+		}
+		if !cont {
+			return out
+		}
+	}
+	out[final] = true
+	return out
+}
+
+// resolve turns a variable's path (its first part possibly another variable) into a datum path.
+func (m *model) resolve(path []string, env []mbinding) []string {
+	for i := len(env) - 1; i >= 0; i-- {
+		if env[i].name == path[0] && !env[i].isVal {
+			path = append(append([]string(nil), env[i].path...), path[1:]...)
+		}
+	}
+	return path
+}
