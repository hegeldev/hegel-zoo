+// ---------------------------------------------------------------------------
+// JSON-like values for the conversion functions.
+
+func genJSONValue(tc hegel.TestCase, depth int) any {
+	if depth <= 0 || chance(tc, 40) {
+		switch n(tc, 0, 4) {
+		case 0:
+			return nil
+		case 1:
+			return chance(tc, 50)
+		case 2:
+			return float64(n(tc, -1000, 1000)) / pick(tc, 1.0, 4.0, 8.0)
+		case 3:
+			return genString(tc, 6)
+		}
+		return float64(n(tc, -100000, 100000))
+	}
+	if chance(tc, 50) {
+		var xs []any
+		for k := n(tc, 0, 4); k > 0; k-- {
+			xs = append(xs, genJSONValue(tc, depth-1))
+		}
+		if xs == nil {
+			xs = []any{}
+		}
+		return xs
+	}
+	m := map[string]any{}
+	for k := n(tc, 0, 4); k > 0; k-- {
+		m[genString(tc, 3)] = genJSONValue(tc, depth-1)
+	}
+	return m
+}
