+// TestHegelConversionsRoundTrip: toJSON/fromJSON, toPairs/fromPairs,
+// int/float/string conversions agree with encoding/json and strconv.
+func TestHegelConversionsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch n(ht, 0, 4) {
+		case 0:
+			v := genJSONValue(ht, 3)
+			env := map[string]any{"v": v}
+			want, err := json.Marshal(v)
+			if err != nil {
+				return
+			}
+			var back any
+			if err := json.Unmarshal(want, &back); err != nil {
+				return
+			}
+			note(ht, "toJSON(v) with v = %#v", v)
+			got, err := eval("toJSON(v)", env, true)
+			if err != nil {
+				fail(ht, "toJSON(%#v): %v", v, err)
+			}
+			var gotBack any
+			if s, ok := got.(string); !ok || json.Unmarshal([]byte(s), &gotBack) != nil || !reflect.DeepEqual(gotBack, back) {
+				fail(ht, "toJSON(%#v) = %#v; encoding/json: %s", v, got, want)
+			}
+			rt, err := eval("fromJSON(toJSON(v))", env, true)
+			if err != nil {
+				fail(ht, "fromJSON(toJSON(%#v)): %v", v, err)
+			}
+			if !reflect.DeepEqual(rt, back) {
+				fail(ht, "fromJSON(toJSON(%#v)) = %#v; want %#v", v, rt, back)
+			}
+		case 1:
+			m := map[string]any{}
+			for k := n(ht, 0, 5); k > 0; k-- {
+				m[genString(ht, 3)] = genJSONValue(ht, 1)
+			}
+			env := map[string]any{"m": m}
+			note(ht, "fromPairs(toPairs(m)) with m = %#v", m)
+			got, err := eval("fromPairs(toPairs(m))", env, true)
+			if err != nil {
+				fail(ht, "fromPairs(toPairs(%#v)): %v", m, err)
+			}
+			// fromPairs builds a map[any]any (keys need not be strings); compare the entries
+			if gm, ok := got.(map[any]any); !ok || len(gm) != len(m) || func() bool {
+				for k, v := range m {
+					if gv, ok := gm[k]; !ok || !reflect.DeepEqual(gv, v) {
+						return false
+					}
+				}
+				return true
+			}() == false {
+				fail(ht, "fromPairs(toPairs(%#v)) = %T %#v", m, got, got)
+			}
+			ln, err := eval("len(toPairs(m))", env, true)
+			if err != nil || !matches(ln, vi(len(m))) {
+				fail(ht, "len(toPairs(%#v)) = %#v, %v; want %d", m, ln, err, len(m))
+			}
+		case 2:
+			i := pick(ht, 0, 1, -1, 42, math.MaxInt, math.MinInt, n(ht, -1e6, 1e6))
+			env := map[string]any{"i": i}
+			for _, c := range []struct {
+				src  string
+				want any
+			}{{"string(i)", strconv.Itoa(i)}, {"int(string(i))", i}, {"float(i)", float64(i)}, {"int(float(i))", int(float64(i))}, {"type(i)", "int"}, {"type(string(i))", "string"}, {"type(float(i))", "float"}} {
+				got, err := eval(c.src, env, true)
+				if err != nil || !reflect.DeepEqual(got, c.want) {
+					fail(ht, "%s with i=%d = %T %#v, %v; want %T %#v", c.src, i, got, got, err, c.want, c.want)
+				}
+			}
+		case 3:
+			f := pick(ht, 0.0, 0.5, -1.25, 1e21, 1e-7, 123.456, float64(n(ht, -1000, 1000))/8)
+			env := map[string]any{"f": f}
+			s := strconv.FormatFloat(f, 'g', -1, 64)
+			for _, c := range []struct {
+				src  string
+				want any
+			}{{"float(" + strconv.Quote(s) + ")", f}, {"float(string(f))", f}, {"int(f)", int(f)}, {"type(f)", "float"}} {
+				got, err := eval(c.src, env, true)
+				if err != nil || !reflect.DeepEqual(got, c.want) {
+					fail(ht, "%s with f=%v = %T %#v, %v; want %T %#v", c.src, f, got, got, err, c.want, c.want)
+				}
+			}
+		default:
+			// type() names the documented kinds
+			for _, c := range []struct {
+				src  string
+				want string
+			}{{"type(nil)", "nil"}, {"type(true)", "bool"}, {"type(1)", "int"}, {"type(1.5)", "float"}, {"type('a')", "string"}, {"type([1])", "array"}, {"type({a: 1})", "map"}} {
+				got, err := eval(c.src, map[string]any{}, chance(ht, 50))
+				if err != nil || got != c.want {
+					fail(ht, "%s = %#v, %v; want %q", c.src, got, err, c.want)
+				}
+			}
+		}
+	})
+}
