diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..757ab9f
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,219 @@
+package expr_test
+
+// One plain test per recorded bug (see bugs.toml). Each asserts the
+// documented behaviour and fails while the bug is open; target.toml lists
+// them as expected failures.
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/ast"
+	"github.com/expr-lang/expr/checker"
+	"github.com/expr-lang/expr/conf"
+	"github.com/expr-lang/expr/parser"
+)
+
+// expr/1: docs/configuration.md says a type-checked result can be asserted
+// to its type safely, and first/last/get are documented to return nil when
+// there is nothing to return; find, findLast, findIndex and findLastIndex do
+// the same, and a conditional with a nil branch returns nil. The checker
+// gives all of them the non-nil type (int here), so `output.(int)` panics on
+// the nil. Either the static type must admit nil or the value must have the
+// static type.
+func TestHegelPinFindersHonourTheirStaticType(t *testing.T) {
+	env := map[string]any{"arr": []int{1, 2, 3}, "empty": []int{}}
+	for _, src := range []string{"find(arr, # > 5)", "findLast(arr, # > 5)", "findIndex(arr, # > 5)", "findLastIndex(arr, # > 5)", "first(empty)", "last(empty)", "get(arr, 9)", "find(empty, # > 0)", "true ? nil : arr[0]", "false ? arr[0] : nil"} {
+		cfg := conf.New(env)
+		tree, err := parser.ParseWithConfig(src, cfg)
+		if err != nil {
+			t.Fatalf("%s: %v", src, err)
+		}
+		static, err := checker.Check(tree, cfg)
+		if err != nil {
+			t.Fatalf("%s: %v", src, err)
+		}
+		got, err := expr.Eval(src, env)
+		if err != nil {
+			t.Fatalf("%s: %v", src, err)
+		}
+		if static.Kind() != reflect.Interface && (got == nil || reflect.TypeOf(got).Kind() != static.Kind()) {
+			t.Errorf("%s: the checker says %v, the program returns %T %#v", src, static, got, got)
+		}
+	}
+}
+
+// expr/2: FloatNode.String() prints an integral float without a decimal
+// point, so the printed expression re-parses as an integer: `type(1.0)` is
+// "float", `type(1)` is "int".
+func TestHegelPinFloatLiteralsPrintAsFloats(t *testing.T) {
+	for _, src := range []string{"1.0", "0.0", "-0.0", "100.0", "[1.0, 2]", "1.0 / 2"} {
+		tree, err := parser.Parse(src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		printed := tree.Node.String()
+		tree2, err := parser.Parse(printed)
+		if err != nil {
+			t.Fatalf("%s prints as %q: %v", src, printed, err)
+		}
+		v1, _ := expr.Eval("type("+src+")", nil)
+		v2, _ := expr.Eval("type("+printed+")", nil)
+		if reflect.TypeOf(tree.Node) != reflect.TypeOf(tree2.Node) || v1 != v2 {
+			t.Errorf("%s prints as %q: %T (type %v) re-parses as %T (type %v)", src, printed, tree.Node, v1, tree2.Node, v2)
+		}
+	}
+}
+
+// expr/3: a `let` or a `;` sequence nested in another expression must
+// print with the parentheses it needs; `1 + (let x = 1; x)` prints as
+// `1 + let x = 1; x`, which does not parse, and `!(1; true)` prints as
+// `!1; true`, which parses as a different expression.
+func TestHegelPinNestedLetPrintsWithParentheses(t *testing.T) {
+	for _, src := range []string{"1 + (let x = 1; x)", "(let x = 1; x) + 1", "[let x = 1; x]", "f(let x = 1; x)", "(let x = 1; x) ? 2 : 3", "!(1; true)", "(1; 2) + 3"} {
+		tree, err := parser.Parse(src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		printed := tree.Node.String()
+		tree2, err := parser.Parse(printed)
+		if err != nil {
+			t.Errorf("%s prints as %q, which does not parse: %v", src, printed, err)
+			continue
+		}
+		if ast.Dump(tree.Node) != ast.Dump(tree2.Node) {
+			t.Errorf("%s prints as %q, which parses differently:\n%s\n--- vs ---\n%s", src, printed, ast.Dump(tree.Node), ast.Dump(tree2.Node))
+		}
+	}
+}
+
+// expr/4: DisableBuiltin(name) "disables builtin function" and
+// DisableAllBuiltins "disables all builtins" (expr.go); the array functions
+// the documentation lists as builtins but the parser handles as predicates
+// (filter, map, count, sum, sortBy, reduce, find, …) stay enabled under both.
+func TestHegelPinDisableBuiltinCoversPredicates(t *testing.T) {
+	env := map[string]any{"arr": []int{1, 2, 3}}
+	for _, c := range []struct{ src, name string }{{"count(arr, # > 0)", "count"}, {"filter(arr, # > 0)", "filter"}, {"map(arr, #)", "map"}, {"sum(arr)", "sum"}, {"sortBy(arr, #)", "sortBy"}, {"reduce(arr, #acc + #)", "reduce"}, {"find(arr, # > 0)", "find"}, {"all(arr, # > 0)", "all"}, {"groupBy(arr, #)", "groupBy"}} {
+		if _, err := expr.Compile(c.src, expr.Env(env), expr.DisableBuiltin(c.name)); err == nil {
+			t.Errorf("%s compiles with DisableBuiltin(%q)", c.src, c.name)
+		}
+		if _, err := expr.Compile(c.src, expr.Env(env), expr.DisableAllBuiltins()); err == nil {
+			t.Errorf("%s compiles with DisableAllBuiltins()", c.src)
+		}
+	}
+}
+
+// expr/5: BinaryNode.String() prints the operands of `..` bare whatever
+// they are, so an operand that binds looser than `..` (a conditional, a
+// comparison or membership test, `and`/`or`, a `??`, a range on the right)
+// prints as a different expression (`(true ? 1 : 2)..3` as `true ? 1 :
+// 2..3`) or as one that does not parse (`(1 ?? 2)..3` as `1 ?? 2..3`).
+func TestHegelPinRangeOperandsPrintWithParentheses(t *testing.T) {
+	for _, src := range []string{"(true ? 1 : 2)..3", "1..(true ? 2 : 3)", "(1 ?? 2)..3", "(1 == 2)..3", "1..(1 in [1])", "(1 < 2 or 1 > 2)..3", "1..(2..3)"} {
+		tree, err := parser.Parse(src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		printed := tree.Node.String()
+		tree2, err := parser.Parse(printed)
+		if err != nil {
+			t.Errorf("%s prints as %q, which does not parse: %v", src, printed, err)
+			continue
+		}
+		if ast.Dump(tree.Node) != ast.Dump(tree2.Node) {
+			t.Errorf("%s prints as %q, which parses differently:\n%s\n--- vs ---\n%s", src, printed, ast.Dump(tree.Node), ast.Dump(tree2.Node))
+		}
+	}
+}
+
+// staticAndRuntime: the checker's type of src over env and the value the
+// program returns.
+func staticAndRuntime(t *testing.T, src string, env map[string]any) (reflect.Type, any) {
+	t.Helper()
+	cfg := conf.New(env)
+	tree, err := parser.ParseWithConfig(src, cfg)
+	if err != nil {
+		t.Fatalf("%s: %v", src, err)
+	}
+	static, err := checker.Check(tree, cfg)
+	if err != nil {
+		t.Fatalf("%s: %v", src, err)
+	}
+	got, err := expr.Eval(src, env)
+	if err != nil {
+		t.Fatalf("%s: %v", src, err)
+	}
+	return static, got
+}
+
+// expr/6: the checker types a `reduce` without an initial value as its
+// predicate, but the documentation says the first element is the initial
+// value, and over a one-element array the predicate never runs: the value
+// is the element. `reduce([1], #acc >= #)` is statically a bool and
+// evaluates to the int 1; it compiles under AsBool and fails at run time.
+func TestHegelPinSeedlessReduceHonoursItsStaticType(t *testing.T) {
+	env := map[string]any{"i": 3, "s": "ab"}
+	for _, src := range []string{"reduce([1], #acc >= #)", "reduce([1], string(#))", "reduce([i], #acc and # > 0)", "reduce(['a'], len(#))", "reduce([s], # == '')", "reduce([0.5], int(#))"} {
+		if static, got := staticAndRuntime(t, src, env); got == nil || reflect.TypeOf(got).Kind() != static.Kind() {
+			t.Errorf("%s: the checker says %v, the program returns %T %#v", src, static, got, got)
+		}
+	}
+	if p, err := expr.Compile("reduce([1], #acc >= #)", expr.AsBool()); err == nil {
+		if _, err := expr.Run(p, nil); err != nil {
+			t.Errorf("reduce([1], #acc >= #) compiles under AsBool() and fails at run time: %v", err)
+		}
+	}
+}
+
+// expr/7: `min` and `max` are typed as their first argument
+// (validateAggregateFunc returns args[0]), but return whichever argument
+// wins: `min(1, 0.5)` is statically an int and evaluates to the float64
+// 0.5, `max(0.5, 1)` the other way round, `min(i64, f32)` an int64 that is
+// a float32.
+func TestHegelPinMinMaxHonourTheirStaticType(t *testing.T) {
+	env := map[string]any{"i64": int64(2), "f32": float32(1.5)}
+	for _, src := range []string{"min(1, 0.5)", "max(0.5, 1)", "min(i64, f32)", "max(f32, i64)", "min(2, 1, 0.5)", "max(0.5, 2, 1)"} {
+		if static, got := staticAndRuntime(t, src, env); got == nil || reflect.TypeOf(got).Kind() != static.Kind() {
+			t.Errorf("%s: the checker says %v, the program returns %T %#v", src, static, got, got)
+		}
+	}
+}
+
+// expr/8: the checker types `sum(array)` as the array's element type, but
+// the compiler seeds the accumulator with the int 0, so the sum of an empty
+// array is the int 0 whatever the element type: `sum([0.5][1:])` is
+// statically a float64 and evaluates to the int 0, `sum(list[1:1])` over a
+// []string is statically a string.
+func TestHegelPinEmptySumHonoursItsStaticType(t *testing.T) {
+	env := map[string]any{"fl": []float64{0.5}, "list": []string{"a"}}
+	for _, src := range []string{"sum([0.5][1:])", "sum(fl[1:])", "sum([0.5, 1.5][0:0])", "sum(filter([0.5], false))", "sum(list[1:1])"} {
+		if static, got := staticAndRuntime(t, src, env); got == nil || reflect.TypeOf(got).Kind() != static.Kind() {
+			t.Errorf("%s: the checker says %v, the program returns %T %#v", src, static, got, got)
+		}
+	}
+}
+
+// expr/9: the optimizer folds `x and false` to false and `x or true` to
+// true whatever x is (optimizer/fold.go, cases "and" and "or"), so a left
+// operand that fails at run time unoptimised — a non-bool, a `%` by zero,
+// an index out of range — is never evaluated: the program returns the
+// constant with the optimizer (the default) and an error without it.
+func TestHegelPinOptimizerKeepsShortCircuitErrors(t *testing.T) {
+	env := map[string]any{"i": 3, "z": 0, "arr": []int{1, 2}, "s": "ab"}
+	for _, src := range []string{`(false ? 0.5 : "bar") and false`, `(false ? 0.5 : "bar") or true`, `(i % z == 1) and false`, `(arr[99] > 0) && false`, `(int(s) > 0) || true`, `(false ? 0.5 : "bar") and true`} {
+		pOn, err := expr.Compile(src, expr.Env(env), expr.Optimize(true))
+		if err != nil {
+			t.Fatalf("%s: %v", src, err)
+		}
+		pOff, err := expr.Compile(src, expr.Env(env), expr.Optimize(false))
+		if err != nil {
+			t.Fatalf("%s: %v", src, err)
+		}
+		vOn, rOn := expr.Run(pOn, env)
+		vOff, rOff := expr.Run(pOff, env)
+		if (rOn == nil) != (rOff == nil) || (rOn == nil && !reflect.DeepEqual(vOn, vOff)) {
+			t.Errorf("%s: with the optimizer %#v, %v; without %#v, %v", src, vOn, rOn, vOff, rOff)
+		}
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..c6a46dd
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,739 @@
+package expr_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged as the wide property that found
+// the bug judges (the checker's static type against the value the program
+// returns; parse → Node.String() → parse against ast.Dump; DisableBuiltin
+// against compilation; the optimizer on against off), so that each bug has
+// a property that finds it every run; the wide properties in hegel_test.go
+// reach the shapes at their natural rate. Under HEGEL_NO_KNOWN=1 each draws
+// the neighbouring region the bug does not touch (finders that match,
+// first/last and get within a non-empty array, the non-nil branch taken,
+// non-integral floats, a `let` or sequence at the top level, the builtins
+// outside the predicate table, `..` operands that need no parentheses, a
+// reduce with a seed, min/max over one kind, non-empty sums, left operands
+// of `and false`/`or true` that do not fail) and passes.
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/ast"
+	"github.com/expr-lang/expr/checker"
+	"github.com/expr-lang/expr/conf"
+	"github.com/expr-lang/expr/parser"
+	"github.com/expr-lang/expr/test/fuzz"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- expr/1
+
+// nilCase: an environment and a construct the checker types as non-nil
+// whose value is nil: a finder whose predicate no element satisfies
+// (`# > b` with b at or above the largest element), first or last of the
+// empty array, get past the end, or a conditional whose taken branch is
+// nil. Under HEGEL_NO_KNOWN=1 the neighbouring region: a predicate every
+// element of a non-empty array satisfies, first or last of it, get within
+// it, the non-nil branch taken.
+type nilCase struct {
+	env    modelEnv
+	kind   string // finder, ends, get, cond
+	fn     string // finder: find, findLast, findIndex, findLastIndex; ends: first, last; cond: ?: or if
+	off    int    // finder: the bound's distance past the extreme; get: the index past the end, or within
+	cond   node   // cond: the test (no runtime error possible at depth one)
+	branch node   // cond: the other branch
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nilCase) GoString() string { return fmt.Sprintf("%s\nenv %v", c.source(), c.env) }
+
+func (c nilCase) source() string {
+	arr := c.env.arr
+	switch c.kind {
+	case "finder":
+		extreme := 0
+		if len(arr) > 0 {
+			extreme = arr[0]
+		}
+		for _, x := range arr {
+			extreme = shaped(max(extreme, x), min(extreme, x))
+		}
+		bound := shaped(extreme+c.off, extreme-1-c.off)
+		return fmt.Sprintf("%s(arr, # > %s)", c.fn, lit(vi(bound)))
+	case "ends":
+		return c.fn + "(" + shaped("empty", "arr") + ")"
+	case "get":
+		idx := shaped(len(arr)+c.off, c.off%max(len(arr), 1))
+		return fmt.Sprintf("get(arr, %d)", idx)
+	}
+	taken := realise(c.cond, c.env).v.b
+	cond, branch := render(c.cond), render(c.branch)
+	first, second := branch, "nil"
+	if taken == !noKnown { // nil on the taken branch (the shape), on the other one past it
+		first, second = "nil", branch
+	}
+	if c.fn == "if" {
+		return fmt.Sprintf("if %s { %s } else { %s }", cond, first, second)
+	}
+	return fmt.Sprintf("(%s ? %s : %s)", cond, first, second)
+}
+
+var (
+	// envsWithArr: an environment whose array is not empty.
+	envsWithArr = hegel.Composite(func(tc hegel.TestCase) modelEnv {
+		e := hegel.Draw(tc, envs)
+		e.arr = hegel.Draw(tc, hegel.Lists(hegel.Integers(-20, 20)).MinSize(1).MaxSize(6))
+		return e
+	})
+	nilEnvs  = shaped(envs, envsWithArr)
+	nilForms = hegel.OneOf(
+		hegel.Composite(func(tc hegel.TestCase) nilCase {
+			return nilCase{kind: "finder", fn: hegel.Draw(tc, hegel.SampledFrom([]string{"find", "findLast", "findIndex", "findLastIndex"})), off: hegel.Draw(tc, hegel.Integers(0, 5))}
+		}),
+		hegel.Map(hegel.SampledFrom([]string{"first", "last"}), func(fn string) nilCase { return nilCase{kind: "ends", fn: fn} }),
+		hegel.Map(hegel.Integers(0, 5), func(off int) nilCase { return nilCase{kind: "get", off: off} }),
+		hegel.Composite(func(tc hegel.TestCase) nilCase {
+			return nilCase{kind: "cond", fn: hegel.Draw(tc, hegel.SampledFrom([]string{"?:", "if"})), cond: hegel.Draw(tc, boolAt(1)), branch: hegel.Draw(tc, anyAt(0))}
+		}),
+	)
+	nilCases = hegel.Composite(func(tc hegel.TestCase) nilCase {
+		c := hegel.Draw(tc, nilForms)
+		c.env = hegel.Draw(tc, nilEnvs)
+		return c
+	})
+)
+
+// TestHegelNilResultsMatchTheirStaticType: a finder with nothing to find,
+// first/last of an empty array, get out of range and a conditional taking
+// its nil branch return nil, so the checker's static type must admit nil;
+// it is the element's or the other branch's type, and the documented-safe
+// assertion to it panics (expr/1). Under HEGEL_NO_KNOWN=1 the finders
+// find, first/last/get are within the array and the non-nil branch is
+// taken: the value has the static kind.
+func TestHegelNilResultsMatchTheirStaticType(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nilCases)
+		src := c.source()
+		env := c.env.env()
+		env["empty"] = []int{}
+		cfg := conf.New(env)
+		tree, err := parser.ParseWithConfig(src, cfg)
+		if err != nil {
+			fail(ht, "%s does not parse: %v", src, err)
+		}
+		static, err := checker.Check(tree, cfg)
+		if err != nil {
+			fail(ht, "%s does not check: %v", src, err)
+		}
+		note(ht, "static type %v", static)
+		got, err := eval(src, env, false)
+		if err != nil {
+			fail(ht, "%s: %v\nenv %v", src, err, c.env)
+		}
+		if static == nil || static.Kind() == reflect.Interface {
+			return // the checker makes no claim
+		}
+		if got == nil {
+			mismatch(ht, known("expr/1"), "%s: static type %v, runtime value nil\nenv %v", src, static, c.env)
+		}
+		if reflect.TypeOf(got).Kind() != static.Kind() {
+			fail(ht, "%s: static type %v (kind %v), runtime %T %#v\nenv %v", src, static, static.Kind(), got, got, c.env)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- expr/2
+
+// floatLitCase: a float literal and the expression it sits in.
+type floatLitCase struct {
+	v       float64
+	context int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c floatLitCase) GoString() string { return strconv.Quote(c.source()) }
+
+func (c floatLitCase) source() string {
+	return fmt.Sprintf(floatContexts[c.context], lit(vf(c.v)))
+}
+
+var (
+	// floatContexts: where the literal sits (%s).
+	floatContexts = []string{"%s", "[%s, 2]", "%s / 2", "{a: %s}", "(%s + 1)", "fn(%s)", "%s == 1", "[%s][0]", "(true ? %s : 2)"}
+	// integralFloats: whole values, which print without a decimal point
+	// (the shape of expr/2); under HEGEL_NO_KNOWN=1 values with a fraction.
+	integralFloats = shaped[hegel.Generator[float64]](
+		hegel.Map(hegel.Integers(-1000, 1000), func(n int) float64 { return float64(n) }),
+		hegel.Composite(func(tc hegel.TestCase) float64 {
+			return float64(hegel.Draw(tc, hegel.Integers(-1000, 1000))) + float64(hegel.Draw(tc, hegel.Integers(1, 3)))/4
+		}),
+	)
+	floatLitCases = hegel.Composite(func(tc hegel.TestCase) floatLitCase {
+		return floatLitCase{v: hegel.Draw(tc, integralFloats), context: hegel.Draw(tc, hegel.Integers(0, len(floatContexts)-1))}
+	})
+)
+
+// reparses checks that printing a parsed expression and parsing the print
+// gives the same AST, naming the shape on a disagreement.
+func reparses(ht *hegel.T, src string, shape []string) {
+	tree, err := parser.Parse(src)
+	if err != nil {
+		fail(ht, "%q does not parse: %v", src, err)
+	}
+	printed := tree.Node.String()
+	note(ht, "prints as %q", printed)
+	tree2, err := parser.Parse(printed)
+	if err != nil {
+		mismatch(ht, shape, "%q prints as %q, which does not parse: %v", src, printed, err)
+	}
+	d1, d2 := ast.Dump(tree.Node), ast.Dump(tree2.Node)
+	if d1 != d2 {
+		env := fuzz.NewEnv()
+		v1, e1 := eval(src, env, false, fuzz.Func())
+		v2, e2 := eval(printed, env, false, fuzz.Func())
+		mismatch(ht, shape, "%q prints as %q: different AST (values %#v/%v vs %#v/%v)\n%s\n--- vs ---\n%s", src, printed, v1, e1, v2, e2, d1, d2)
+	}
+}
+
+// TestHegelIntegralFloatLiteralsReparse: a float literal with an integral
+// value, alone or inside an expression, prints as a float, so that the
+// print re-parses to the same AST; FloatNode.String() writes it without a
+// decimal point and it re-parses as an integer (expr/2). Under
+// HEGEL_NO_KNOWN=1 the literals have a fraction.
+func TestHegelIntegralFloatLiteralsReparse(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, floatLitCases)
+		reparses(ht, c.source(), known("expr/2"))
+	})
+}
+
+// --------------------------------------------------------------------------- expr/3
+
+// nestedLetCase: a `let` binding or a `;` sequence over two int
+// expressions, inside a binary, unary, array, call, index or conditional
+// expression (the shape of expr/3); under HEGEL_NO_KNOWN=1 at the top
+// level, the one place it prints right.
+type nestedLetCase struct {
+	seq     bool
+	a, b    node
+	wrapper int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nestedLetCase) GoString() string { return strconv.Quote(c.source()) }
+
+func (c nestedLetCase) inner() string {
+	a, b := render(c.a), render(c.b)
+	if c.seq {
+		return a + "; " + b
+	}
+	return "let x = " + a + "; x + " + b
+}
+
+func (c nestedLetCase) source() string { return fmt.Sprintf(letWrappers[c.wrapper], c.inner()) }
+
+var (
+	// letWrappers: the expressions holding the binding (%s).
+	letWrappers = shaped(
+		[]string{"1 + (%s)", "(%s) + 1", "(%s) * 2", "-(%s)", "!(%s)", "not (%s)", "[%s]", "fn(%s)", "(%s) ? 2 : 3", "true ? (%s) : 0", "(%s) == 1", "[(%s)][0]", "len([%s])"},
+		[]string{"%s"},
+	)
+	nestedLetCases = hegel.Composite(func(tc hegel.TestCase) nestedLetCase {
+		return nestedLetCase{seq: hegel.Draw(tc, hegel.Booleans()), a: hegel.Draw(tc, intAt(1)), b: hegel.Draw(tc, intAt(1)), wrapper: hegel.Draw(tc, hegel.Integers(0, len(letWrappers)-1))}
+	})
+)
+
+// TestHegelNestedLetsReparse: a `let` binding or a `;` sequence nested in
+// a binary, unary, array, call, index or conditional expression prints with
+// the parentheses it needs, so that the print re-parses to the same AST;
+// VariableDeclaratorNode and SequenceNode print bare and nothing wraps
+// them, so the print fails to parse or re-associates (expr/3). Under
+// HEGEL_NO_KNOWN=1 the binding is the whole expression.
+func TestHegelNestedLetsReparse(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nestedLetCases)
+		reparses(ht, c.source(), known("expr/3"))
+	})
+}
+
+// --------------------------------------------------------------------------- expr/4
+
+// disableCase: a builtin, an expression calling it (the sources below, k
+// written in) and whether it is disabled alone or with all builtins.
+type disableCase struct {
+	name string
+	k    int
+	all  bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c disableCase) GoString() string {
+	if c.all {
+		return c.source() + " under DisableAllBuiltins()"
+	}
+	return fmt.Sprintf("%s under DisableBuiltin(%q)", c.source(), c.name)
+}
+
+func (c disableCase) source() string {
+	return strings.ReplaceAll(builtinSources[c.name], "{k}", lit(vi(c.k)))
+}
+
+// builtinSources: an expression over the environment calling each builtin.
+var builtinSources = map[string]string{
+	// the predicate builtins (parser.predicates), the shape of expr/4
+	"all": "all(arr, # > {k})", "any": "any(arr, # > {k})", "one": "one(arr, # > {k})", "none": "none(arr, # > {k})",
+	"map": "map(arr, # + {k})", "filter": "filter(arr, # > {k})", "find": "find(arr, # > {k})", "findIndex": "findIndex(arr, # > {k})",
+	"findLast": "findLast(arr, # > {k})", "findLastIndex": "findLastIndex(arr, # > {k})", "groupBy": "groupBy(arr, # > {k})",
+	"sortBy": "sortBy(arr, # * {k})", "count": "count(arr, # > {k})", "sum": "sum(arr, # + {k})", "reduce": "reduce(arr, #acc + #, {k})",
+	// the builtins of the table, the region past it
+	"len": "len(arr)", "abs": "abs({k})", "min": "min({k}, i)", "max": "max({k}, i)", "upper": "upper(s)", "lower": "lower(s)", "trim": "trim(s)",
+	"repeat": "repeat(s, 2)", "int": "int(f)", "float": "float({k})", "string": "string({k})", "ceil": "ceil(f)", "floor": "floor(f)", "round": "round(f)",
+	"sort": "sort(arr)", "uniq": "uniq(arr)", "take": "take(arr, 1)", "first": "first(arr)", "last": "last(arr)", "join": "join(map(arr, string(#)), \",\")",
+}
+
+var (
+	tableBuiltins = []string{"len", "abs", "min", "max", "upper", "lower", "trim", "repeat", "int", "float", "string", "ceil", "floor", "round", "sort", "uniq", "take", "first", "last", "join"}
+	disableCases  = hegel.Composite(func(tc hegel.TestCase) disableCase {
+		return disableCase{name: hegel.Draw(tc, hegel.SampledFrom(shaped(predicateBuiltins, tableBuiltins))), k: hegel.Draw(tc, hegel.Integers(-5, 5)), all: hegel.Draw(tc, hegel.Booleans())}
+	})
+)
+
+// TestHegelDisableBuiltinCoversThePredicates: an expression calling a
+// builtin does not compile under DisableBuiltin of that builtin nor under
+// DisableAllBuiltins; the fifteen predicate builtins (all, any, one, none,
+// map, filter, find*, groupBy, sortBy, count, sum, reduce) stay enabled
+// under both (expr/4). Under HEGEL_NO_KNOWN=1 the builtins of the table
+// are drawn, which the options do disable.
+func TestHegelDisableBuiltinCoversThePredicates(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, disableCases)
+		src := c.source()
+		env := hegel.Draw(ht, envs).env()
+		if _, err := expr.Compile(src, expr.Env(env)); err != nil {
+			fail(ht, "%s does not compile: %v", src, err)
+		}
+		opt, under := expr.DisableBuiltin(c.name), fmt.Sprintf("DisableBuiltin(%q)", c.name)
+		if c.all {
+			opt, under = expr.DisableAllBuiltins(), "DisableAllBuiltins()"
+		}
+		if _, err := expr.Compile(src, expr.Env(env), opt); err == nil {
+			mismatch(ht, known("expr/4"), "%s compiles with %s", src, under)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- expr/5
+
+// rangeOperand is one side of a `..`: its form and the expressions in it.
+// A tight operand (a literal, a variable, arithmetic, unary minus, a call)
+// binds tighter than `..` and prints right bare; the others bind looser
+// and are written in parentheses, which BinaryNode.String() drops.
+type rangeOperand struct {
+	form string // tight, cond, coalesce, cmp, logic, range
+	op   string // cmp: the comparison; logic: the connective
+	x, y node   // int operands (y for all but tight)
+	t    node   // cond: the test
+}
+
+func (o rangeOperand) source() string {
+	x := render(o.x)
+	if o.form == "tight" {
+		return x
+	}
+	y := render(o.y)
+	switch o.form {
+	case "cond":
+		return "(" + render(o.t) + " ? " + x + " : " + y + ")"
+	case "coalesce":
+		return "(" + x + " ?? " + y + ")"
+	case "cmp":
+		if o.op == "in" {
+			return "(" + x + " in [" + y + "])"
+		}
+		return "(" + x + " " + o.op + " " + y + ")"
+	case "logic":
+		return "(" + x + " < " + y + " " + o.op + " " + x + " > " + y + ")"
+	case "range":
+		return "(" + x + ".." + y + ")"
+	}
+	return x
+}
+
+// rangeCase: a `..` over two operands; by default one side or both binds
+// looser than `..` (the shape of expr/5), under HEGEL_NO_KNOWN=1 both bind
+// tighter.
+type rangeCase struct {
+	left, right rangeOperand
+}
+
+func (c rangeCase) source() string { return c.left.source() + ".." + c.right.source() }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c rangeCase) GoString() string { return strconv.Quote(c.source()) }
+
+var (
+	// tightInts: int expressions that bind tighter than `..`.
+	tightInts = weighted(
+		choice[node]{3, intLeaves},
+		choice[node]{2, nodeOf('i', "arith", []string{"+", "-", "*", "%"}, intLeaves, intLeaves)},
+		choice[node]{1, nodeOf('i', "neg", nil, intLeaves)},
+		choice[node]{1, nodeOf('i', "abs", nil, intLeaves)},
+		choice[node]{1, nodeOf('i', "minmax", []string{"min", "max"}, intLeaves, intLeaves)},
+	)
+	tightBools    = hegel.OneOf(boolLeaves, nodeOf('b', "cmp", []string{"==", "!=", "<", "<=", ">", ">="}, intLeaves, intLeaves))
+	tightOperands = operandOf([]string{"tight"})
+	looseLefts    = operandOf([]string{"cond", "coalesce", "cmp", "logic"})
+	looseRights   = operandOf([]string{"cond", "coalesce", "cmp", "logic", "range"}) // `(1..2)..3` is how `1..2..3` parses, so a range on the left is tight
+	rangeCases    = shaped(
+		hegel.OneOf(pairOf(looseLefts, tightOperands), pairOf(tightOperands, looseRights), pairOf(looseLefts, looseRights)),
+		pairOf(tightOperands, tightOperands),
+	)
+)
+
+// operandOf is an operand of one of the forms with its parts drawn.
+func operandOf(forms []string) hegel.Generator[rangeOperand] {
+	return hegel.FlatMap(hegel.SampledFrom(forms), func(form string) hegel.Generator[rangeOperand] {
+		var ops []string
+		switch form {
+		case "cmp":
+			ops = []string{"==", "!=", "<", "<=", ">", ">=", "in"}
+		case "logic":
+			ops = []string{"and", "or", "&&", "||"}
+		}
+		return hegel.Composite(func(tc hegel.TestCase) rangeOperand {
+			o := rangeOperand{form: form, x: hegel.Draw(tc, tightInts)}
+			if form != "tight" {
+				o.y = hegel.Draw(tc, tightInts)
+			}
+			if form == "cond" {
+				o.t = hegel.Draw(tc, tightBools)
+			}
+			if len(ops) > 0 {
+				o.op = hegel.Draw(tc, hegel.SampledFrom(ops))
+			}
+			return o
+		})
+	})
+}
+
+func pairOf(left, right hegel.Generator[rangeOperand]) hegel.Generator[rangeCase] {
+	return hegel.Composite(func(tc hegel.TestCase) rangeCase {
+		return rangeCase{left: hegel.Draw(tc, left), right: hegel.Draw(tc, right)}
+	})
+}
+
+// TestHegelRangeOperandsReparse: a `..` whose operand binds looser than
+// `..` — a conditional, a `??`, a comparison or membership test, `and`/`or`,
+// a range on the right — prints with the parentheses it needs, so that the
+// print re-parses to the same AST; BinaryNode.String() prints the operands
+// of `..` bare, so the print re-associates or does not parse (expr/5).
+// Under HEGEL_NO_KNOWN=1 both operands bind tighter and need none.
+func TestHegelRangeOperandsReparse(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, rangeCases)
+		reparses(ht, c.source(), known("expr/5"))
+	})
+}
+
+// --------------------------------------------------------------------------- the static types
+
+// staticAgrees judges a source as TestHegelStaticTypeMatchesRuntime does:
+// the checker's concrete type must be the kind of the value the program
+// produces, naming the shape on a disagreement (the generators below draw
+// sources the checker types concretely).
+func staticAgrees(ht *hegel.T, src string, env map[string]any, shape shapes) {
+	cfg := conf.New(env)
+	tree, err := parser.ParseWithConfig(src, cfg)
+	if err != nil {
+		fail(ht, "%s does not parse: %v", src, err)
+	}
+	static, err := checker.Check(tree, cfg)
+	if err != nil {
+		fail(ht, "%s does not check: %v", src, err)
+	}
+	note(ht, "static type %v", static)
+	got, err := eval(src, env, false)
+	if err != nil {
+		fail(ht, "%s: %v", src, err)
+	}
+	if static == nil || static.Kind() == reflect.Interface {
+		fail(ht, "%s: the checker makes no claim (%v)", src, static)
+	}
+	if got == nil {
+		mismatch(ht, shape, "%s: static type %v, runtime value nil", src, static)
+	}
+	if reflect.TypeOf(got).Kind() != static.Kind() {
+		mismatch(ht, shape, "%s: static type %v (kind %v), runtime %T %#v", src, static, static.Kind(), got, got)
+	}
+}
+
+// leavesOf: the literal and variable leaves of each kind.
+var leavesOf = map[byte]hegel.Generator[node]{'i': intLeaves, 'f': floatLeaves, 's': strLeaves}
+
+// --------------------------------------------------------------------------- expr/6
+
+// reducePredicate: a predicate whose type is concrete and not the
+// element's (#acc is untyped), and a seed for the seeded form of that type
+// (or of the element's, for a comparison with the accumulator).
+type reducePredicate struct{ src, seed string }
+
+var reducePredicates = map[byte][]reducePredicate{
+	'i': {{"#acc >= #", "0"}, {"# > 0", "true"}, {"#acc and # > 0", "true"}, {"string(#)", `""`}, {"float(#)", "0.0"}},
+	'f': {{"#acc >= #", "0.0"}, {"# > 0.0", "true"}, {"#acc or # < 0.0", "false"}, {"string(#)", `""`}, {"int(#)", "0"}},
+	's': {{"#acc == #", `""`}, {`# == ""`, "true"}, {`#acc and # != ""`, "true"}, {"len(#)", "0"}, {"float(len(#))", "0.0"}},
+}
+
+// reduceArrays: a one-element array of the element (%[1]s) and, in the
+// slice forms, another element (%[2]s) sliced away.
+var reduceArrays = []string{"[%[1]s]", "[%[2]s, %[1]s][1:]", "[%[1]s, %[2]s][:1]"}
+
+// reduceCase: a one-element array of ints, floats or strings reduced by a
+// predicate of another type, without a seed (the shape of expr/6: the
+// element is the result, the predicate never runs); under HEGEL_NO_KNOWN=1
+// with a seed, so the predicate runs once and the value has its type.
+type reduceCase struct {
+	env         modelEnv
+	elem, other node
+	form, pred  int
+}
+
+func (c reduceCase) source() string {
+	p := reducePredicates[c.elem.typ][c.pred]
+	arr := fmt.Sprintf(reduceArrays[c.form], render(c.elem), render(c.other))
+	return "reduce(" + arr + ", " + p.src + shaped("", ", "+p.seed) + ")"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c reduceCase) GoString() string { return fmt.Sprintf("%s\nenv %v", c.source(), c.env) }
+
+var reduceCases = hegel.FlatMap(hegel.SampledFrom([]byte{'i', 'f', 's'}), func(kind byte) hegel.Generator[reduceCase] {
+	return hegel.Composite(func(tc hegel.TestCase) reduceCase {
+		return reduceCase{
+			env:   hegel.Draw(tc, envs),
+			elem:  hegel.Draw(tc, leavesOf[kind]),
+			other: hegel.Draw(tc, leavesOf[kind]),
+			form:  hegel.Draw(tc, hegel.Integers(0, len(reduceArrays)-1)),
+			pred:  hegel.Draw(tc, hegel.Integers(0, len(reducePredicates[kind])-1)),
+		}
+	})
+})
+
+// TestHegelSeedlessReduceMatchesItsStaticType: a `reduce` without an
+// initial value over a one-element array returns the element (the
+// documented initial value), so the checker's type must be the element's;
+// it is the predicate's (expr/6). Under HEGEL_NO_KNOWN=1 the reduce has a
+// seed, the predicate runs and the value has its type.
+func TestHegelSeedlessReduceMatchesItsStaticType(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, reduceCases)
+		staticAgrees(ht, c.source(), c.env.env(), known("expr/6"))
+	})
+}
+
+// --------------------------------------------------------------------------- expr/7
+
+// minMaxCase: min or max over two or three numbers, the first an int and
+// the rest floats or the other way round (the shape of expr/7: the call is
+// typed as its first argument), the function flipped when the first
+// argument would win outright, so that one of the rest wins unless the
+// values tie; under HEGEL_NO_KNOWN=1 all of one kind.
+type minMaxCase struct {
+	env  modelEnv
+	fn   string
+	args []node
+}
+
+// call is the function and the arguments' sources: the function is the
+// other one when the first argument is the strict winner of the drawn one.
+func (c minMaxCase) call() (string, []string) {
+	vals, srcs := make([]float64, len(c.args)), make([]string, len(c.args))
+	for i, a := range c.args {
+		g := realise(a, c.env)
+		vals[i], srcs[i] = g.v.num(), g.src
+	}
+	firstWins := true
+	for _, v := range vals[1:] {
+		firstWins = firstWins && ((c.fn == "min" && vals[0] < v) || (c.fn == "max" && vals[0] > v))
+	}
+	fn := c.fn
+	if firstWins {
+		fn = map[string]string{"min": "max", "max": "min"}[fn]
+	}
+	return fn, srcs
+}
+
+func (c minMaxCase) source() string {
+	fn, srcs := c.call()
+	return fn + "(" + strings.Join(srcs, ", ") + ")"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c minMaxCase) GoString() string { return fmt.Sprintf("%s\nenv %v", c.source(), c.env) }
+
+// otherKind: the float kind for the int one and the other way round.
+func otherKind(kind byte) byte {
+	if kind == 'i' {
+		return 'f'
+	}
+	return 'i'
+}
+
+var minMaxCases = hegel.FlatMap(hegel.SampledFrom([]byte{'i', 'f'}), func(kind byte) hegel.Generator[minMaxCase] {
+	first, rest := leavesOf[kind], leavesOf[shaped(otherKind(kind), kind)]
+	return hegel.Composite(func(tc hegel.TestCase) minMaxCase {
+		c := minMaxCase{env: hegel.Draw(tc, envs), fn: hegel.Draw(tc, hegel.SampledFrom([]string{"min", "max"}))}
+		c.args = append([]node{hegel.Draw(tc, first)}, hegel.Draw(tc, many(rest, 1, 2))...)
+		return c
+	})
+})
+
+// TestHegelMixedMinMaxMatchesItsStaticType: `min`/`max` over an int and
+// floats (or a float and ints) return the winning argument, so the
+// checker's type must admit both kinds; it is the first argument's
+// (expr/7). Under HEGEL_NO_KNOWN=1 the arguments are of one kind.
+func TestHegelMixedMinMaxMatchesItsStaticType(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, minMaxCases)
+		staticAgrees(ht, c.source(), c.env.env(), known("expr/7"))
+	})
+}
+
+// --------------------------------------------------------------------------- expr/8
+
+// sumCase: a sum of an empty selection of a float or string array — the
+// literal sliced to nothing from either end or at a point, or filtered by
+// false — whose static type is the element's and whose value is the int 0
+// (the shape of expr/8); under HEGEL_NO_KNOWN=1 the whole non-empty array
+// of floats or ints, selected whole (a non-empty string array is a
+// run-time error and makes no claim).
+type sumCase struct {
+	env   modelEnv
+	elems []node // one to three elements of one kind
+	form  int    // the selection
+	at    int    // [a:a]: the point, modulo the length plus one
+}
+
+var (
+	emptySelections = []string{"[%[1]s][%[2]d:]", "[%[1]s][%[3]d:%[3]d]", "[%[1]s][:0]", "filter([%[1]s], false)"}
+	wholeSelections = []string{"[%[1]s]", "[%[1]s][0:]", "[%[1]s][:%[2]d]", "filter([%[1]s], true)"}
+	sumSelections   = shaped(emptySelections, wholeSelections)
+	sumCases        = hegel.FlatMap(hegel.SampledFrom(shaped([]byte{'f', 's'}, []byte{'f', 'i'})), func(kind byte) hegel.Generator[sumCase] {
+		return hegel.Composite(func(tc hegel.TestCase) sumCase {
+			return sumCase{
+				env:   hegel.Draw(tc, envs),
+				elems: hegel.Draw(tc, many(leavesOf[kind], 1, 3)),
+				form:  hegel.Draw(tc, hegel.Integers(0, len(sumSelections)-1)),
+				at:    hegel.Draw(tc, hegel.Integers(0, 3)),
+			}
+		})
+	})
+)
+
+func (c sumCase) source() string {
+	parts := make([]string, len(c.elems))
+	for i, e := range c.elems {
+		parts[i] = render(e)
+	}
+	n := len(c.elems)
+	return "sum(" + fmt.Sprintf(sumSelections[c.form], strings.Join(parts, ", "), n, c.at%(n+1)) + ")"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c sumCase) GoString() string { return fmt.Sprintf("%s\nenv %v", c.source(), c.env) }
+
+// TestHegelEmptySumMatchesItsStaticType: the sum of an empty array is the
+// int 0 whatever the element type, so the checker's type for `sum(array)`
+// must admit it; it is the element type (expr/8). Under HEGEL_NO_KNOWN=1
+// the arrays are non-empty and the sum has the element type.
+func TestHegelEmptySumMatchesItsStaticType(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, sumCases)
+		staticAgrees(ht, c.source(), c.env.env(), known("expr/8"))
+	})
+}
+
+// --------------------------------------------------------------------------- expr/9
+
+// foldCase: `x and false` or `x or true` (either spelling) in a context,
+// x a bool-typed expression over the drawn ints that fails at run time — a
+// `%` by the zero variable z, an index past the array, a conditional whose
+// branches are a float and a string, int() of a non-numeric string, a
+// field of a field of a nil map (the shape of expr/9: the optimizer folds
+// the operator to its constant and x is never evaluated); under
+// HEGEL_NO_KNOWN=1 an x that does not fail: `%` by seven, the array's
+// length, a bool conditional, int() of a number's text, membership.
+type foldCase struct {
+	env  modelEnv
+	form int    // x's form
+	op   string // and, &&, or, ||
+	x, y node   // the ints in x
+	ctx  int    // the context around `x op constant`
+}
+
+var (
+	failingOperands = []string{"(%[1]s %% z == %[2]s)", "(arr[len(arr) + abs(%[1]s)] > %[2]s)", "(%[1]s > %[2]s ? 0.5 : s)", `(int(s + "!") > %[1]s)`, "(nilmap.a.b == %[1]s)"}
+	soundOperands   = []string{"(%[1]s %% 7 == %[2]s)", "(len(arr) > %[2]s)", "(%[1]s > %[2]s ? true : false)", "(int(string(%[1]s)) > %[2]s)", "(%[1]s in arr)"}
+	foldOperands    = shaped(failingOperands, soundOperands)
+	foldContexts    = []string{"%s", "not %s", "[%s][0]", "%s ? 1 : 2", "%s == true"}
+	foldCases       = hegel.Composite(func(tc hegel.TestCase) foldCase {
+		return foldCase{
+			env:  hegel.Draw(tc, envs),
+			form: hegel.Draw(tc, hegel.Integers(0, len(foldOperands)-1)),
+			op:   hegel.Draw(tc, hegel.SampledFrom([]string{"and", "&&", "or", "||"})),
+			x:    hegel.Draw(tc, intLeaves),
+			y:    hegel.Draw(tc, intLeaves),
+			ctx:  hegel.Draw(tc, hegel.Integers(0, len(foldContexts)-1)),
+		}
+	})
+)
+
+func (c foldCase) source() string {
+	x := fmt.Sprintf(foldOperands[c.form], render(c.x), render(c.y))
+	constant := "false"
+	if c.op == "or" || c.op == "||" {
+		constant = "true"
+	}
+	return fmt.Sprintf(foldContexts[c.ctx], "("+x+" "+c.op+" "+constant+")")
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c foldCase) GoString() string { return fmt.Sprintf("%s\nenv %v", c.source(), c.env) }
+
+// TestHegelFoldedShortCircuitKeepsErrors: `x and false` and `x or true`
+// evaluate x, so a program holding one runs alike with and without the
+// optimizer: an x that fails at run time fails either way. The optimizer
+// folds the operator to its constant whatever x is, and the failure is
+// gone (expr/9). Under HEGEL_NO_KNOWN=1 x does not fail and the two agree.
+func TestHegelFoldedShortCircuitKeepsErrors(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, foldCases)
+		src := c.source()
+		env := c.env.env()
+		env["z"] = 0
+		env["nilmap"] = (map[string]any)(nil)
+		pOn, errOn := compile(src, env, true)
+		pOff, errOff := compile(src, env, false)
+		if (errOn == nil) != (errOff == nil) {
+			fail(ht, "%s: compiles with optimizer=%v only\n  on:  %v\n  off: %v", src, errOn == nil, errOn, errOff)
+		}
+		if errOff != nil {
+			fail(ht, "%s does not compile: %v", src, errOff)
+		}
+		vOn, rOn := expr.Run(pOn, env)
+		vOff, rOff := expr.Run(pOff, env)
+		note(ht, "unoptimised: %#v, %v", vOff, rOff)
+		if !noKnown && rOff == nil {
+			fail(ht, "%s: the left operand was meant to fail at run time, got %#v", src, vOff)
+		}
+		if (rOn == nil) != (rOff == nil) {
+			mismatch(ht, known("expr/9"), "%s: runs with optimizer=%v only\n  on:  %v %#v\n  off: %v %#v\n%s", src, rOn == nil, rOn, vOn, rOff, vOff, pOn.Disassemble())
+		}
+		if rOn == nil && !sameValue(vOn, vOff) {
+			mismatch(ht, known("expr/9"), "%s: optimizer on = %T %#v, off = %T %#v\n%s", src, vOn, vOn, vOff, vOff, pOn.Disassemble())
+		}
+	})
+}
