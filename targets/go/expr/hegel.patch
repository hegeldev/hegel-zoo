+// TestHegelIndexingFollowsTheDocs: element access with negative indices, the
+// slice operator's documented forms, ranges, `in`, `??` and `?.`.
+func TestHegelIndexingFollowsTheDocs(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		e := genEnv(ht)
+		env := e.env()
+		env["m"] = map[string]any{"a": 1, "b": "x"}
+		env["nilmap"] = (map[string]any)(nil)
+		L := len(e.arr)
+		switch n(ht, 0, 6) {
+		case 0:
+			// arr[i]: in range from either end, or an error
+			i := n(ht, -L-2, L+2)
+			src := fmt.Sprintf("arr[%s]", lit(vi(i)))
+			got, err := eval(src, env, chance(ht, 50))
+			j := i
+			if j < 0 {
+				j += L
+			}
+			if 0 <= j && j < L {
+				if err != nil || !matches(got, vi(e.arr[j])) {
+					fail(ht, "%s with arr %v = %#v, %v; want %d", src, e.arr, got, err, e.arr[j])
+				}
+			} else if err == nil {
+				fail(ht, "%s with arr %v = %#v, no error; the index is out of range", src, e.arr, got)
+			}
+		case 1:
+			// arr[a:b] with 0 <= a <= b <= len, either given from the end
+			a := n(ht, 0, L)
+			b := n(ht, a, L)
+			as, bs := strconv.Itoa(a), strconv.Itoa(b)
+			if a > 0 && a < L && chance(ht, 40) {
+				as = lit(vi(a - L))
+			}
+			if b > 0 && b < L && chance(ht, 40) {
+				bs = lit(vi(b - L))
+			}
+			if a == 0 && chance(ht, 30) {
+				as = ""
+			}
+			if b == L && chance(ht, 30) {
+				bs = ""
+			}
+			src := fmt.Sprintf("arr[%s:%s]", as, bs)
+			got, err := eval(src, env, chance(ht, 50))
+			if err != nil || !seqOfInts(got, e.arr[a:b]) {
+				fail(ht, "%s with arr %v = %#v, %v; want %v (a=%d b=%d len=%d)", src, e.arr, got, err, e.arr[a:b], a, b, L)
+			}
+		case 2:
+			// a..b is the inclusive range
+			a := n(ht, -5, 5)
+			b := n(ht, a, a+8)
+			src := fmt.Sprintf("%s..%s", lit(vi(a)), lit(vi(b)))
+			var want []int
+			for x := a; x <= b; x++ {
+				want = append(want, x)
+			}
+			got, err := eval(src, env, chance(ht, 50))
+			if err != nil || !seqOfInts(got, want) {
+				fail(ht, "%s = %#v, %v; want %v", src, got, err, want)
+			}
+			got, err = eval("len("+src+")", env, chance(ht, 50))
+			if err != nil || !matches(got, vi(len(want))) {
+				fail(ht, "len(%s) = %#v, %v; want %d", src, got, err, len(want))
+			}
+		case 3:
+			// `in` on maps checks keys; `??` and `?.` on nil
+			for _, c := range []struct {
+				src  string
+				want any
+			}{{"'a' in m", true}, {"'z' in m", false}, {"m.a", 1}, {"m['b']", "x"}, {"m?.a", 1}, {"nilmap?.a", nil}, {"nilmap?.a ?? 7", 7}, {"m.a ?? 7", 1}, {"nil ?? 'd'", "d"}, {"get(m, 'zz')", nil}, {"get(arr, 99)", nil}, {"'a' in keys(m)", true}, {"len(keys(m))", 2}, {"len(values(m))", 2}} {
+				got, err := eval(c.src, env, chance(ht, 50))
+				if err != nil || !reflect.DeepEqual(got, c.want) {
+					fail(ht, "%s = %T %#v, %v; want %T %#v", c.src, got, got, err, c.want, c.want)
+				}
+			}
+		case 4:
+			// string indexing/slicing on ASCII strings follows the array rules (bytes)
+			s := asciiString(ht, 6)
+			env["s"] = s
+			a := n(ht, 0, len(s))
+			b := n(ht, a, len(s))
+			src := fmt.Sprintf("s[%d:%d]", a, b)
+			got, err := eval(src, env, chance(ht, 50))
+			if err != nil || got != s[a:b] {
+				fail(ht, "%s with s=%q = %#v, %v; want %q", src, s, got, err, s[a:b])
+			}
+		default:
+			// pipes: x | f(args) == f(x, args)
+			src := "arr | filter(# > " + lit(vi(e.k)) + ") | len()"
+			cnt := 0
+			for _, x := range e.arr {
+				if x > e.k {
+					cnt++
+				}
+			}
+			got, err := eval(src, env, chance(ht, 50))
+			if err != nil || !matches(got, vi(cnt)) {
+				fail(ht, "%s with arr %v = %#v, %v; want %d", src, e.arr, got, err, cnt)
+			}
+		}
+	})
+}
