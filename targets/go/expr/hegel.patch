+// TestHegelStringFunctionsAgree: the string builtins behave as the
+// documentation says, which is the Go strings package.
+func TestHegelStringFunctionsAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genString(ht, 8)
+		sub := genString(ht, 2)
+		if chance(ht, 40) && len(s) > 0 {
+			// a real substring
+			rs := []rune(s)
+			a := n(ht, 0, len(rs))
+			b := n(ht, a, len(rs))
+			sub = string(rs[a:b])
+		}
+		env := map[string]any{"s": s, "sub": sub}
+		k := n(ht, 0, 3)
+		var checks = []struct {
+			src  string
+			want any
+		}{
+			{"trim(s)", strings.TrimSpace(s)},
+			{"trim(s, sub)", strings.Trim(s, sub)},
+			{"trimPrefix(s, sub)", strings.TrimPrefix(s, sub)},
+			{"trimSuffix(s, sub)", strings.TrimSuffix(s, sub)},
+			{"upper(s)", strings.ToUpper(s)},
+			{"lower(s)", strings.ToLower(s)},
+			{"replace(s, sub, \"_\")", strings.ReplaceAll(s, sub, "_")},
+			{"repeat(sub, " + strconv.Itoa(k) + ")", strings.Repeat(sub, k)},
+			{"indexOf(s, sub)", strings.Index(s, sub)},
+			{"lastIndexOf(s, sub)", strings.LastIndex(s, sub)},
+			{"hasPrefix(s, sub)", strings.HasPrefix(s, sub)},
+			{"hasSuffix(s, sub)", strings.HasSuffix(s, sub)},
+			{"s startsWith sub", strings.HasPrefix(s, sub)},
+			{"s endsWith sub", strings.HasSuffix(s, sub)},
+			{"s contains sub", strings.Contains(s, sub)},
+			{"s + sub", s + sub},
+			{"len(s)", utf8.RuneCountInString(s)}, // len counts runes (the docs' "length of a string")
+			{"split(s, sub)", strings.Split(s, sub)},
+			{"splitAfter(s, sub)", strings.SplitAfter(s, sub)},
+			{"split(s, sub, " + strconv.Itoa(k) + ")", strings.SplitN(s, sub, k)},
+			{"splitAfter(s, sub, " + strconv.Itoa(k) + ")", strings.SplitAfterN(s, sub, k)},
+			{"join(split(s, sub), sub)", s},
+			{"toBase64(s)", base64.StdEncoding.EncodeToString([]byte(s))},
+			{"fromBase64(toBase64(s))", s},
+		}
+		c := pick(ht, checks...)
+		note(ht, "%s with s=%q sub=%q", c.src, s, sub)
+		for _, optimize := range []bool{true, false} {
+			got, err := eval(c.src, env, optimize)
+			if err != nil {
+				fail(ht, "%s with s=%q sub=%q: %v (optimize=%v); want %#v", c.src, s, sub, err, optimize, c.want)
+			}
+			if want, ok := c.want.([]string); ok {
+				if !sameStrings(got, want) {
+					fail(ht, "%s with s=%q sub=%q = %T %#v (optimize=%v); want %#v", c.src, s, sub, got, got, optimize, want)
+				}
+				continue
+			}
+			if !reflect.DeepEqual(got, c.want) {
+				fail(ht, "%s with s=%q sub=%q = %T %#v (optimize=%v); want %T %#v", c.src, s, sub, got, got, optimize, c.want, c.want)
+			}
+		}
+	})
+}
+
+// sameStrings: a []string, or a []any of strings, equal to want.
+func sameStrings(got any, want []string) bool {
+	v := reflect.ValueOf(got)
+	if !v.IsValid() || v.Kind() != reflect.Slice || v.Len() != len(want) {
+		return false
+	}
+	for i := range want {
+		s, ok := v.Index(i).Interface().(string)
+		if !ok || s != want[i] {
+			return false
+		}
+	}
+	return true
+}
