+// TestHegelArrayFunctionsAgree: the array functions over an int array with
+// simple predicates give what the documentation says (a Go model).
+func TestHegelArrayFunctionsAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		e := genEnv(ht)
+		env := e.env()
+		k := n(ht, -5, 5)
+		m := pick(ht, 2, 3, 5)
+		r := n(ht, 0, m-1)
+		// predicate: "# > k" or "# % m == r"
+		var pred string
+		var holds func(int) bool
+		if chance(ht, 50) {
+			pred = fmt.Sprintf("# > %s", lit(vi(k)))
+			holds = func(x int) bool { return x > k }
+		} else {
+			pred = fmt.Sprintf("# %% %d == %d", m, r)
+			holds = func(x int) bool { return x%m == r }
+		}
+		var kept []int
+		firstIdx, lastIdx := -1, -1
+		for i, x := range e.arr {
+			if holds(x) {
+				kept = append(kept, x)
+				if firstIdx < 0 {
+					firstIdx = i
+				}
+				lastIdx = i
+			}
+		}
+		sum := 0
+		for _, x := range e.arr {
+			sum += x
+		}
+		sorted := append([]int(nil), e.arr...)
+		sort.Ints(sorted)
+		desc := append([]int(nil), sorted...)
+		for i, j := 0, len(desc)-1; i < j; i, j = i+1, j-1 {
+			desc[i], desc[j] = desc[j], desc[i]
+		}
+		rev := append([]int(nil), e.arr...)
+		for i, j := 0, len(rev)-1; i < j; i, j = i+1, j-1 {
+			rev[i], rev[j] = rev[j], rev[i]
+		}
+		var uniq []int
+		seen := map[int]bool{}
+		for _, x := range e.arr {
+			if !seen[x] {
+				seen[x] = true
+				uniq = append(uniq, x)
+			}
+		}
+		take := n(ht, 0, 8)
+		taken := e.arr
+		if take < len(taken) {
+			taken = taken[:take]
+		}
+		mapped := make([]int, len(e.arr))
+		for i, x := range e.arr {
+			mapped[i] = x*2 + k
+		}
+		cnt := len(kept)
+		var checks = []struct {
+			src  string
+			want func(got any) bool
+			desc string
+		}{
+			{"filter(arr, " + pred + ")", func(g any) bool { return seqOfInts(g, kept) }, fmt.Sprint(kept)},
+			{"map(arr, # * 2 + " + lit(vi(k)) + ")", func(g any) bool { return seqOfInts(g, mapped) }, fmt.Sprint(mapped)},
+			{"all(arr, " + pred + ")", func(g any) bool { return matches(g, vb(cnt == len(e.arr))) }, fmt.Sprint(cnt == len(e.arr))},
+			{"any(arr, " + pred + ")", func(g any) bool { return matches(g, vb(cnt > 0)) }, fmt.Sprint(cnt > 0)},
+			{"one(arr, " + pred + ")", func(g any) bool { return matches(g, vb(cnt == 1)) }, fmt.Sprint(cnt == 1)},
+			{"none(arr, " + pred + ")", func(g any) bool { return matches(g, vb(cnt == 0)) }, fmt.Sprint(cnt == 0)},
+			{"count(arr, " + pred + ")", func(g any) bool { return matches(g, vi(cnt)) }, fmt.Sprint(cnt)},
+			{"len(filter(arr, " + pred + "))", func(g any) bool { return matches(g, vi(cnt)) }, fmt.Sprint(cnt)},
+			// (the not-found value of findIndex/findLastIndex is not documented — nil today,
+			// typed int by the checker, expr/1 — so only the found case is checked)
+			{"findIndex(arr, " + pred + ")", func(g any) bool { return cnt == 0 || matches(g, vi(firstIdx)) }, fmt.Sprint(firstIdx)},
+			{"findLastIndex(arr, " + pred + ")", func(g any) bool { return cnt == 0 || matches(g, vi(lastIdx)) }, fmt.Sprint(lastIdx)},
+			{"find(arr, " + pred + ")", func(g any) bool {
+				if cnt == 0 {
+					return g == nil
+				}
+				return matches(g, vi(kept[0]))
+			}, "first kept or nil"},
+			{"findLast(arr, " + pred + ")", func(g any) bool {
+				if cnt == 0 {
+					return g == nil
+				}
+				return matches(g, vi(kept[len(kept)-1]))
+			}, "last kept or nil"},
+			{"first(arr)", func(g any) bool {
+				if len(e.arr) == 0 {
+					return g == nil
+				}
+				return matches(g, vi(e.arr[0]))
+			}, "first or nil"},
+			{"last(arr)", func(g any) bool {
+				if len(e.arr) == 0 {
+					return g == nil
+				}
+				return matches(g, vi(e.arr[len(e.arr)-1]))
+			}, "last or nil"},
+			{"sum(arr)", func(g any) bool { return matches(g, vi(sum)) }, fmt.Sprint(sum)},
+			{"sum(arr, # * 2 + " + lit(vi(k)) + ")", func(g any) bool {
+				s := 0
+				for _, x := range mapped {
+					s += x
+				}
+				return matches(g, vi(s))
+			}, "sum of mapped"},
+			{"reduce(arr, #acc + #, 0)", func(g any) bool { return matches(g, vi(sum)) }, fmt.Sprint(sum)},
+			{"sort(arr)", func(g any) bool { return seqOfInts(g, sorted) }, fmt.Sprint(sorted)},
+			{"sort(arr, \"desc\")", func(g any) bool { return seqOfInts(g, desc) }, fmt.Sprint(desc)},
+			{"sortBy(arr, #)", func(g any) bool { return seqOfInts(g, sorted) }, fmt.Sprint(sorted)},
+			{"sortBy(arr, -#, \"desc\")", func(g any) bool { return seqOfInts(g, sorted) }, fmt.Sprint(sorted)},
+			{"reverse(arr)", func(g any) bool { return seqOfInts(g, rev) }, fmt.Sprint(rev)},
+			{"uniq(arr)", func(g any) bool { return seqOfInts(g, uniq) }, fmt.Sprint(uniq)},
+			{"take(arr, " + strconv.Itoa(take) + ")", func(g any) bool { return seqOfInts(g, taken) }, fmt.Sprint(taken)},
+			{"concat(arr, arr)", func(g any) bool { return seqOfInts(g, append(append([]int(nil), e.arr...), e.arr...)) }, "arr twice"},
+			{"flatten([arr, [arr]])", func(g any) bool { return seqOfInts(g, append(append([]int(nil), e.arr...), e.arr...)) }, "arr twice"},
+			{"len(arr)", func(g any) bool { return matches(g, vi(len(e.arr))) }, fmt.Sprint(len(e.arr))},
+			{"join(map(arr, string(#)), \",\")", func(g any) bool {
+				parts := make([]string, len(e.arr))
+				for i, x := range e.arr {
+					parts[i] = strconv.Itoa(x)
+				}
+				return matches(g, vs(strings.Join(parts, ",")))
+			}, "joined"},
+		}
+		if len(e.arr) > 0 {
+			mn, mx := sorted[0], sorted[len(sorted)-1]
+			mean := float64(sum) / float64(len(e.arr))
+			var median float64
+			if len(sorted)%2 == 1 {
+				median = float64(sorted[len(sorted)/2])
+			} else {
+				median = float64(sorted[len(sorted)/2-1]+sorted[len(sorted)/2]) / 2
+			}
+			checks = append(checks,
+				struct {
+					src  string
+					want func(got any) bool
+					desc string
+				}{"min(arr)", func(g any) bool { return matches(g, vi(mn)) }, fmt.Sprint(mn)},
+				struct {
+					src  string
+					want func(got any) bool
+					desc string
+				}{"max(arr)", func(g any) bool { return matches(g, vi(mx)) }, fmt.Sprint(mx)},
+				struct {
+					src  string
+					want func(got any) bool
+					desc string
+				}{"mean(arr)", func(g any) bool { return matches(g, vf(mean)) }, fmt.Sprint(mean)},
+				struct {
+					src  string
+					want func(got any) bool
+					desc string
+				}{"median(arr)", func(g any) bool { return matches(g, vf(median)) }, fmt.Sprint(median)},
+			)
+		}
+		c := pick(ht, checks...)
+		note(ht, "%s with arr %v", c.src, e.arr)
+		for _, optimize := range []bool{true, false} {
+			got, err := eval(c.src, env, optimize)
+			if err != nil {
+				fail(ht, "%s with arr %v: %v (optimize=%v); want %s", c.src, e.arr, err, optimize, c.desc)
+			}
+			if !c.want(got) {
+				fail(ht, "%s with arr %v = %T %#v (optimize=%v); want %s", c.src, e.arr, got, got, optimize, c.desc)
+			}
+		}
+	})
+}
