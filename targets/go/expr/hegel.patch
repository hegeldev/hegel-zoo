diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..5700cc0
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,105 @@
+package expr_test
+
+// One plain test per recorded bug (see bugs.toml). Each asserts the
+// documented behaviour and fails while the bug is open; target.toml lists
+// them as expected failures.
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/ast"
+	"github.com/expr-lang/expr/checker"
+	"github.com/expr-lang/expr/conf"
+	"github.com/expr-lang/expr/parser"
+)
+
+// expr/1: docs/configuration.md says a type-checked result can be asserted
+// to its type safely, and first/last/get are documented to return nil when
+// there is nothing to return; find, findLast, findIndex and findLastIndex do
+// the same, and a conditional with a nil branch returns nil. The checker
+// gives all of them the non-nil type (int here), so `output.(int)` panics on
+// the nil. Either the static type must admit nil or the value must have the
+// static type.
+func TestHegelPinFindersHonourTheirStaticType(t *testing.T) {
+	env := map[string]any{"arr": []int{1, 2, 3}, "empty": []int{}}
+	for _, src := range []string{"find(arr, # > 5)", "findLast(arr, # > 5)", "findIndex(arr, # > 5)", "findLastIndex(arr, # > 5)", "first(empty)", "last(empty)", "get(arr, 9)", "find(empty, # > 0)", "true ? nil : arr[0]", "false ? arr[0] : nil"} {
+		cfg := conf.New(env)
+		tree, err := parser.ParseWithConfig(src, cfg)
+		if err != nil {
+			t.Fatalf("%s: %v", src, err)
+		}
+		static, err := checker.Check(tree, cfg)
+		if err != nil {
+			t.Fatalf("%s: %v", src, err)
+		}
+		got, err := expr.Eval(src, env)
+		if err != nil {
+			t.Fatalf("%s: %v", src, err)
+		}
+		if static.Kind() != reflect.Interface && (got == nil || reflect.TypeOf(got).Kind() != static.Kind()) {
+			t.Errorf("%s: the checker says %v, the program returns %T %#v", src, static, got, got)
+		}
+	}
+}
+
+// expr/2: FloatNode.String() prints an integral float without a decimal
+// point, so the printed expression re-parses as an integer: `type(1.0)` is
+// "float", `type(1)` is "int".
+func TestHegelPinFloatLiteralsPrintAsFloats(t *testing.T) {
+	for _, src := range []string{"1.0", "0.0", "-0.0", "100.0", "[1.0, 2]", "1.0 / 2"} {
+		tree, err := parser.Parse(src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		printed := tree.Node.String()
+		tree2, err := parser.Parse(printed)
+		if err != nil {
+			t.Fatalf("%s prints as %q: %v", src, printed, err)
+		}
+		v1, _ := expr.Eval("type("+src+")", nil)
+		v2, _ := expr.Eval("type("+printed+")", nil)
+		if reflect.TypeOf(tree.Node) != reflect.TypeOf(tree2.Node) || v1 != v2 {
+			t.Errorf("%s prints as %q: %T (type %v) re-parses as %T (type %v)", src, printed, tree.Node, v1, tree2.Node, v2)
+		}
+	}
+}
+
+// expr/3: a `let` or a `;` sequence nested in another expression must
+// print with the parentheses it needs; `1 + (let x = 1; x)` prints as
+// `1 + let x = 1; x`, which does not parse, and `!(1; true)` prints as
+// `!1; true`, which parses as a different expression.
+func TestHegelPinNestedLetPrintsWithParentheses(t *testing.T) {
+	for _, src := range []string{"1 + (let x = 1; x)", "(let x = 1; x) + 1", "[let x = 1; x]", "f(let x = 1; x)", "(let x = 1; x) ? 2 : 3", "!(1; true)", "(1; 2) + 3"} {
+		tree, err := parser.Parse(src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		printed := tree.Node.String()
+		tree2, err := parser.Parse(printed)
+		if err != nil {
+			t.Errorf("%s prints as %q, which does not parse: %v", src, printed, err)
+			continue
+		}
+		if ast.Dump(tree.Node) != ast.Dump(tree2.Node) {
+			t.Errorf("%s prints as %q, which parses differently:\n%s\n--- vs ---\n%s", src, printed, ast.Dump(tree.Node), ast.Dump(tree2.Node))
+		}
+	}
+}
+
+// expr/4: DisableBuiltin(name) "disables builtin function" and
+// DisableAllBuiltins "disables all builtins" (expr.go); the array functions
+// the documentation lists as builtins but the parser handles as predicates
+// (filter, map, count, sum, sortBy, reduce, find, …) stay enabled under both.
+func TestHegelPinDisableBuiltinCoversPredicates(t *testing.T) {
+	env := map[string]any{"arr": []int{1, 2, 3}}
+	for _, c := range []struct{ src, name string }{{"count(arr, # > 0)", "count"}, {"filter(arr, # > 0)", "filter"}, {"map(arr, #)", "map"}, {"sum(arr)", "sum"}, {"sortBy(arr, #)", "sortBy"}, {"reduce(arr, #acc + #)", "reduce"}, {"find(arr, # > 0)", "find"}, {"all(arr, # > 0)", "all"}, {"groupBy(arr, #)", "groupBy"}} {
+		if _, err := expr.Compile(c.src, expr.Env(env), expr.DisableBuiltin(c.name)); err == nil {
+			t.Errorf("%s compiles with DisableBuiltin(%q)", c.src, c.name)
+		}
+		if _, err := expr.Compile(c.src, expr.Env(env), expr.DisableAllBuiltins()); err == nil {
+			t.Errorf("%s compiles with DisableAllBuiltins()", c.src)
+		}
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..8e342e6
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1566 @@
+package expr_test
+
+// Hegel properties for github.com/expr-lang/expr (the Hegel zoo). Oracles:
+// a Go model of the documented semantics (docs/language-definition.md and
+// the vm/runtime helpers' documented types: `/` is always a float, `%` an
+// int, `+` on ints an int), the Go standard library behind the builtins
+// (strings, strconv, encoding/json, encoding/base64), and Expr against
+// itself (optimizer on vs off, static type vs runtime type, print → parse).
+// The upstream fuzz corpus (test/fuzz/fuzz_corpus.txt) seeds the
+// self-consistency properties.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/ast"
+	"github.com/expr-lang/expr/checker"
+	"github.com/expr-lang/expr/conf"
+	"github.com/expr-lang/expr/parser"
+	"github.com/expr-lang/expr/test/fuzz"
+	"github.com/expr-lang/expr/vm"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness plumbing (shared with the other Go targets of the zoo).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("EXPR_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	findersTypedNonNil  bool // expr/1: static types never admit nil — find/first/last/get typed as the element type, `c ? nil : x` as x's type
+	integralFloatPrints bool // expr/2: FloatNode.String() prints 1.0 as 1, which re-parses as an integer
+	nestedLetPrints     bool // expr/3: a `let` or a `;` sequence inside another expression prints without its parentheses
+	predicatesStayOn    bool // expr/4: DisableBuiltin/DisableAllBuiltins leave the predicate builtins (filter, count, sum, …) enabled
+}{findersTypedNonNil: true, integralFloatPrints: true, nestedLetPrints: true, predicatesStayOn: true}
+
+// predicateBuiltins are parsed as special forms (parser.predicates), not looked up in the builtin table.
+var predicateBuiltins = []string{"all", "any", "one", "none", "map", "filter", "find", "findIndex", "findLast", "findLastIndex", "groupBy", "sortBy", "count", "sum", "reduce"}
+
+// nestedLetFinder flags a VariableDeclaratorNode or SequenceNode below the root.
+type nestedLetFinder struct {
+	root  ast.Node
+	found bool
+}
+
+func (f *nestedLetFinder) Visit(node *ast.Node) {
+	if *node == f.root {
+		return
+	}
+	switch (*node).(type) {
+	case *ast.VariableDeclaratorNode, *ast.SequenceNode:
+		f.found = true
+	}
+}
+
+var finders = []string{"find(", "findLast(", "findIndex(", "findLastIndex(", "first(", "last(", "get("}
+
+func usesFinder(src string) bool {
+	for _, f := range finders {
+		if strings.Contains(src, f) {
+			return true
+		}
+	}
+	return false
+}
+
+// integralFloatFinder flags a FloatNode whose value prints without a decimal point.
+type integralFloatFinder struct{ found bool }
+
+func (f *integralFloatFinder) Visit(node *ast.Node) {
+	if fn, ok := (*node).(*ast.FloatNode); ok && !math.IsInf(fn.Value, 0) && !math.IsNaN(fn.Value) && fn.Value == math.Trunc(fn.Value) {
+		f.found = true
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Values, environments, comparison.
+
+// val is a model value: an int, a float, a string or a bool.
+type val struct {
+	kind byte // 'i', 'f', 's', 'b'
+	i    int
+	f    float64
+	s    string
+	b    bool
+}
+
+func vi(i int) val     { return val{kind: 'i', i: i} }
+func vf(f float64) val { return val{kind: 'f', f: f} }
+func vs(s string) val  { return val{kind: 's', s: s} }
+func vb(b bool) val    { return val{kind: 'b', b: b} }
+func (v val) num() float64 { // the numeric value of an int or float
+	if v.kind == 'i' {
+		return float64(v.i)
+	}
+	return v.f
+}
+
+func (v val) String() string {
+	switch v.kind {
+	case 'i':
+		return fmt.Sprintf("int %d", v.i)
+	case 'f':
+		return fmt.Sprintf("float %v", v.f)
+	case 's':
+		return fmt.Sprintf("string %q", v.s)
+	}
+	return fmt.Sprintf("bool %v", v.b)
+}
+
+// sameFloat: equal, or both NaN.
+func sameFloat(a, b float64) bool { return a == b || (math.IsNaN(a) && math.IsNaN(b)) }
+
+// matches compares a runtime result with a model value: the Go type must be
+// the model's (int, float64, string, bool) and the value equal.
+func matches(got any, want val) bool {
+	switch want.kind {
+	case 'i':
+		g, ok := got.(int)
+		return ok && g == want.i
+	case 'f':
+		g, ok := got.(float64)
+		return ok && sameFloat(g, want.f)
+	case 's':
+		g, ok := got.(string)
+		return ok && g == want.s
+	}
+	g, ok := got.(bool)
+	return ok && g == want.b
+}
+
+// sameValue compares two runtime results structurally, NaN equal to NaN.
+func sameValue(a, b any) bool {
+	if ra, rb := reflect.ValueOf(a), reflect.ValueOf(b); ra.IsValid() && rb.IsValid() && ra.Kind() == reflect.Func && rb.Kind() == reflect.Func {
+		return ra.Pointer() == rb.Pointer()
+	}
+	if fa, ok := a.(float64); ok {
+		fb, ok := b.(float64)
+		return ok && sameFloat(fa, fb)
+	}
+	if ra, rb := reflect.ValueOf(a), reflect.ValueOf(b); ra.IsValid() && rb.IsValid() && ra.Kind() == reflect.Map && rb.Kind() == reflect.Map {
+		if ra.Type() != rb.Type() || ra.Len() != rb.Len() {
+			return false
+		}
+		for _, k := range ra.MapKeys() {
+			vb := rb.MapIndex(k)
+			if !vb.IsValid() || !sameValue(ra.MapIndex(k).Interface(), vb.Interface()) {
+				return false
+			}
+		}
+		return true
+	}
+	if ra, rb := reflect.ValueOf(a), reflect.ValueOf(b); ra.IsValid() && rb.IsValid() && ra.Kind() == reflect.Slice && rb.Kind() == reflect.Slice {
+		if ra.Type() != rb.Type() || ra.Len() != rb.Len() {
+			return false
+		}
+		for i := 0; i < ra.Len(); i++ {
+			if !sameValue(ra.Index(i).Interface(), rb.Index(i).Interface()) {
+				return false
+			}
+		}
+		return true
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+// seqOfInts checks that a result is a sequence whose elements are the ints given.
+func seqOfInts(got any, want []int) bool {
+	v := reflect.ValueOf(got)
+	if !v.IsValid() || v.Kind() != reflect.Slice || v.Len() != len(want) {
+		return false
+	}
+	for i := range want {
+		if !matches(v.Index(i).Interface(), vi(want[i])) {
+			return false
+		}
+	}
+	return true
+}
+
+// alphabet for generated strings: ASCII letters, digits, punctuation the
+// lexer must handle inside quotes, spaces and a few multi-byte runes.
+var runes = []rune("abcxyzABCXYZ019 _-.,!?:;/\\'\"éß日本😀\t\n")
+
+func genString(tc hegel.TestCase, maxLen int) string {
+	k := n(tc, 0, maxLen)
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		sb.WriteRune(pick(tc, runes...))
+	}
+	return sb.String()
+}
+
+// asciiString: printable ASCII only, for byte-indexed operations.
+func asciiString(tc hegel.TestCase, maxLen int) string {
+	k := n(tc, 0, maxLen)
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = byte(n(tc, 0x20, 0x7e))
+	}
+	return string(b)
+}
+
+// lit renders a literal of the model value in Expr syntax.
+func lit(v val) string {
+	switch v.kind {
+	case 'i':
+		if v.i < 0 {
+			return fmt.Sprintf("(%d)", v.i)
+		}
+		return strconv.Itoa(v.i)
+	case 'f':
+		s := strconv.FormatFloat(v.f, 'g', -1, 64)
+		if !strings.ContainsAny(s, ".eIN") {
+			s += ".0"
+		}
+		if v.f < 0 {
+			return "(" + s + ")"
+		}
+		return s
+	case 's':
+		return strconv.Quote(v.s)
+	}
+	return strconv.FormatBool(v.b)
+}
+
+func compile(src string, env any, optimize bool, opts ...expr.Option) (*vm.Program, error) {
+	opts = append([]expr.Option{expr.Env(env), expr.Optimize(optimize)}, opts...)
+	return expr.Compile(src, opts...)
+}
+
+// eval compiles and runs; a nil error and the value, or the error of either step.
+func eval(src string, env any, optimize bool, opts ...expr.Option) (any, error) {
+	p, err := compile(src, env, optimize, opts...)
+	if err != nil {
+		return nil, fmt.Errorf("compile: %w", err)
+	}
+	return expr.Run(p, env)
+}
+
+// ---------------------------------------------------------------------------
+// A typed expression generator with a model.
+
+type gen struct {
+	src string
+	v   val
+	err bool // the model expects a runtime error (integer division by zero)
+}
+
+type modelEnv struct {
+	i, k int
+	f    float64
+	s, t string
+	arr  []int
+	lets *int // counter for unique `let` names: a name cannot be redeclared in a nested scope
+}
+
+func (e modelEnv) env() map[string]any {
+	return map[string]any{"i": e.i, "k": e.k, "f": e.f, "s": e.s, "t": e.t, "arr": e.arr}
+}
+
+func genEnv(tc hegel.TestCase) modelEnv {
+	e := modelEnv{lets: new(int), i: n(tc, -50, 50), k: n(tc, -3, 12), f: pick(tc, 0.0, 0.5, -1.5, 2.25, 1e3, -0.0, 3.0), s: asciiString(tc, 6), t: asciiString(tc, 3)}
+	for j := n(tc, 0, 6); j > 0; j-- {
+		e.arr = append(e.arr, n(tc, -20, 20))
+	}
+	return e
+}
+
+func genInt(tc hegel.TestCase, e modelEnv, depth int) gen {
+	if depth <= 0 || chance(tc, 30) {
+		switch n(tc, 0, 4) {
+		case 0:
+			return gen{src: "i", v: vi(e.i)}
+		case 1:
+			return gen{src: "k", v: vi(e.k)}
+		case 2:
+			return gen{src: "len(arr)", v: vi(len(e.arr))}
+		case 3:
+			return gen{src: "len(s)", v: vi(utf8.RuneCountInString(e.s))}
+		}
+		v := pick(tc, 0, 1, 2, -1, 7, 10, 255, -128, 1000, math.MaxInt, math.MinInt+1, n(tc, -100, 100)) // MinInt itself has no literal: the lexer reads the magnitude first
+		return gen{src: lit(vi(v)), v: vi(v)}
+	}
+	a := genInt(tc, e, depth-1)
+	switch n(tc, 0, 11) {
+	case 0:
+		b := genInt(tc, e, depth-1)
+		return gen{src: "(" + a.src + " + " + b.src + ")", v: vi(a.v.i + b.v.i), err: a.err || b.err}
+	case 1:
+		b := genInt(tc, e, depth-1)
+		return gen{src: "(" + a.src + " - " + b.src + ")", v: vi(a.v.i - b.v.i), err: a.err || b.err}
+	case 2:
+		b := genInt(tc, e, depth-1)
+		return gen{src: "(" + a.src + " * " + b.src + ")", v: vi(a.v.i * b.v.i), err: a.err || b.err}
+	case 3:
+		b := genInt(tc, e, depth-1)
+		g := gen{src: "(" + a.src + " % " + b.src + ")", err: a.err || b.err}
+		if b.v.i == 0 {
+			g.err = true // "integer divide by zero"
+		} else if a.v.i == math.MinInt && b.v.i == -1 {
+			g.v = vi(0) // Go: MinInt % -1 == 0
+		} else {
+			g.v = vi(a.v.i % b.v.i)
+		}
+		return g
+	case 4:
+		return gen{src: "(-" + a.src + ")", v: vi(-a.v.i), err: a.err}
+	case 5:
+		return gen{src: "abs(" + a.src + ")", v: vi(absInt(a.v.i)), err: a.err}
+	case 6:
+		b := genInt(tc, e, depth-1)
+		return gen{src: "min(" + a.src + ", " + b.src + ")", v: vi(min(a.v.i, b.v.i)), err: a.err || b.err}
+	case 7:
+		b := genInt(tc, e, depth-1)
+		return gen{src: "max(" + a.src + ", " + b.src + ")", v: vi(max(a.v.i, b.v.i)), err: a.err || b.err}
+	case 8:
+		c := genBool(tc, e, depth-1)
+		b := genInt(tc, e, depth-1)
+		g := gen{src: "(" + c.src + " ? " + a.src + " : " + b.src + ")"}
+		if c.v.b {
+			g.v, g.err = a.v, c.err || a.err
+		} else {
+			g.v, g.err = b.v, c.err || b.err
+		}
+		return g
+	case 9:
+		// int(string) of a decimal literal string
+		return gen{src: "int(" + strconv.Quote(strconv.Itoa(a.v.i)) + ")", v: vi(a.v.i)}
+	case 10:
+		// the count of array elements above a bound
+		cnt := 0
+		for _, x := range e.arr {
+			if x > a.v.i {
+				cnt++
+			}
+		}
+		return gen{src: "count(arr, # > " + a.src + ")", v: vi(cnt), err: a.err}
+	}
+	// let binding
+	b := genInt(tc, e, depth-1)
+	*e.lets++
+	x := fmt.Sprintf("x%d", *e.lets)
+	return gen{src: "(let " + x + " = " + a.src + "; " + x + " + " + b.src + ")", v: vi(a.v.i + b.v.i), err: a.err || b.err}
+}
+
+func absInt(i int) int {
+	if i < 0 {
+		return -i
+	}
+	return i
+}
+
+func genFloat(tc hegel.TestCase, e modelEnv, depth int) gen {
+	if depth <= 0 || chance(tc, 30) {
+		if chance(tc, 30) {
+			return gen{src: "f", v: vf(e.f)}
+		}
+		v := pick(tc, 0.0, 0.5, 1.0, -2.5, 0.1, 1e10, 3.75, float64(n(tc, -100, 100))/4)
+		return gen{src: lit(vf(v)), v: vf(v)}
+	}
+	switch n(tc, 0, 7) {
+	case 0:
+		// `/` is always a float, on ints too
+		a, b := genNum(tc, e, depth-1), genNum(tc, e, depth-1)
+		return gen{src: "(" + a.src + " / " + b.src + ")", v: vf(a.v.num() / b.v.num()), err: a.err || b.err}
+	case 1:
+		a, b := genNum(tc, e, depth-1), genNum(tc, e, depth-1)
+		op := pick(tc, "**", "^")
+		return gen{src: "(" + a.src + " " + op + " " + b.src + ")", v: vf(math.Pow(a.v.num(), b.v.num())), err: a.err || b.err}
+	case 2:
+		a := genFloat(tc, e, depth-1)
+		b := genNum(tc, e, depth-1)
+		op := pick(tc, "+", "-", "*")
+		var r float64
+		switch op {
+		case "+":
+			r = a.v.f + b.v.num()
+		case "-":
+			r = a.v.f - b.v.num()
+		default:
+			r = a.v.f * b.v.num()
+		}
+		return gen{src: "(" + a.src + " " + op + " " + b.src + ")", v: vf(r), err: a.err || b.err}
+	case 3:
+		a := genInt(tc, e, depth-1)
+		return gen{src: "float(" + a.src + ")", v: vf(float64(a.v.i)), err: a.err}
+	case 4:
+		a := genFloat(tc, e, depth-1)
+		return gen{src: "ceil(" + a.src + ")", v: vf(math.Ceil(a.v.f)), err: a.err}
+	case 5:
+		a := genFloat(tc, e, depth-1)
+		return gen{src: "floor(" + a.src + ")", v: vf(math.Floor(a.v.f)), err: a.err}
+	case 6:
+		a := genFloat(tc, e, depth-1)
+		return gen{src: "round(" + a.src + ")", v: vf(math.Round(a.v.f)), err: a.err}
+	}
+	a := genFloat(tc, e, depth-1)
+	return gen{src: "(-" + a.src + ")", v: vf(-a.v.f), err: a.err}
+}
+
+func genNum(tc hegel.TestCase, e modelEnv, depth int) gen {
+	if chance(tc, 50) {
+		return genInt(tc, e, depth)
+	}
+	return genFloat(tc, e, depth)
+}
+
+func genStr(tc hegel.TestCase, e modelEnv, depth int) gen {
+	if depth <= 0 || chance(tc, 30) {
+		switch n(tc, 0, 3) {
+		case 0:
+			return gen{src: "s", v: vs(e.s)}
+		case 1:
+			return gen{src: "t", v: vs(e.t)}
+		}
+		v := genString(tc, 5)
+		return gen{src: lit(vs(v)), v: vs(v)}
+	}
+	a := genStr(tc, e, depth-1)
+	switch n(tc, 0, 6) {
+	case 0:
+		b := genStr(tc, e, depth-1)
+		return gen{src: "(" + a.src + " + " + b.src + ")", v: vs(a.v.s + b.v.s), err: a.err || b.err}
+	case 1:
+		return gen{src: "upper(" + a.src + ")", v: vs(strings.ToUpper(a.v.s)), err: a.err}
+	case 2:
+		return gen{src: "lower(" + a.src + ")", v: vs(strings.ToLower(a.v.s)), err: a.err}
+	case 3:
+		return gen{src: "trim(" + a.src + ")", v: vs(strings.TrimSpace(a.v.s)), err: a.err}
+	case 4:
+		i := genInt(tc, e, depth-1)
+		return gen{src: "string(" + i.src + ")", v: vs(strconv.Itoa(i.v.i)), err: i.err}
+	case 5:
+		c := genBool(tc, e, depth-1)
+		b := genStr(tc, e, depth-1)
+		g := gen{src: "(" + c.src + " ? " + a.src + " : " + b.src + ")"}
+		if c.v.b {
+			g.v, g.err = a.v, c.err || a.err
+		} else {
+			g.v, g.err = b.v, c.err || b.err
+		}
+		return g
+	}
+	k := n(tc, 0, 3)
+	return gen{src: "repeat(" + a.src + ", " + strconv.Itoa(k) + ")", v: vs(strings.Repeat(a.v.s, k)), err: a.err}
+}
+
+func genBool(tc hegel.TestCase, e modelEnv, depth int) gen {
+	if depth <= 0 || chance(tc, 25) {
+		v := chance(tc, 50)
+		return gen{src: lit(vb(v)), v: vb(v)}
+	}
+	switch n(tc, 0, 8) {
+	case 0, 1:
+		a, b := genNum(tc, e, depth-1), genNum(tc, e, depth-1)
+		op := pick(tc, "==", "!=", "<", "<=", ">", ">=")
+		var r bool
+		if a.v.kind == 'i' && b.v.kind == 'i' {
+			r = cmpInt(op, a.v.i, b.v.i)
+		} else {
+			r = cmpFloat(op, a.v.num(), b.v.num())
+		}
+		return gen{src: "(" + a.src + " " + op + " " + b.src + ")", v: vb(r), err: a.err || b.err}
+	case 2:
+		a, b := genStr(tc, e, depth-1), genStr(tc, e, depth-1)
+		op := pick(tc, "==", "!=", "contains", "startsWith", "endsWith")
+		var r bool
+		switch op {
+		case "==":
+			r = a.v.s == b.v.s
+		case "!=":
+			r = a.v.s != b.v.s
+		case "contains":
+			r = strings.Contains(a.v.s, b.v.s)
+		case "startsWith":
+			r = strings.HasPrefix(a.v.s, b.v.s)
+		default:
+			r = strings.HasSuffix(a.v.s, b.v.s)
+		}
+		return gen{src: "(" + a.src + " " + op + " " + b.src + ")", v: vb(r), err: a.err || b.err}
+	case 3:
+		a, b := genBool(tc, e, depth-1), genBool(tc, e, depth-1)
+		switch pick(tc, "and", "&&", "or", "||") {
+		case "and":
+			return gen{src: "(" + a.src + " and " + b.src + ")", v: vb(a.v.b && b.v.b), err: a.err || (a.v.b && b.err)}
+		case "&&":
+			return gen{src: "(" + a.src + " && " + b.src + ")", v: vb(a.v.b && b.v.b), err: a.err || (a.v.b && b.err)}
+		case "or":
+			return gen{src: "(" + a.src + " or " + b.src + ")", v: vb(a.v.b || b.v.b), err: a.err || (!a.v.b && b.err)}
+		}
+		return gen{src: "(" + a.src + " || " + b.src + ")", v: vb(a.v.b || b.v.b), err: a.err || (!a.v.b && b.err)}
+	case 4:
+		a := genBool(tc, e, depth-1)
+		return gen{src: pick(tc, "not ", "!") + a.src, v: vb(!a.v.b), err: a.err}
+	case 5:
+		a := genInt(tc, e, depth-1)
+		in := false
+		for _, x := range e.arr {
+			if x == a.v.i {
+				in = true
+			}
+		}
+		return gen{src: "(" + a.src + " in arr)", v: vb(in), err: a.err}
+	case 6:
+		a := genInt(tc, e, depth-1)
+		lo, hi := n(tc, -5, 5), n(tc, -5, 8)
+		in := lo <= a.v.i && a.v.i <= hi
+		return gen{src: "(" + a.src + " in " + lit(vi(lo)) + ".." + lit(vi(hi)) + ")", v: vb(in), err: a.err}
+	}
+	c := genBool(tc, e, depth-1)
+	a, b := genBool(tc, e, depth-1), genBool(tc, e, depth-1)
+	g := gen{src: "(" + c.src + " ? " + a.src + " : " + b.src + ")"}
+	if c.v.b {
+		g.v, g.err = a.v, c.err || a.err
+	} else {
+		g.v, g.err = b.v, c.err || b.err
+	}
+	return g
+}
+
+func cmpInt(op string, a, b int) bool {
+	switch op {
+	case "==":
+		return a == b
+	case "!=":
+		return a != b
+	case "<":
+		return a < b
+	case "<=":
+		return a <= b
+	case ">":
+		return a > b
+	}
+	return a >= b
+}
+
+func cmpFloat(op string, a, b float64) bool {
+	switch op {
+	case "==":
+		return a == b
+	case "!=":
+		return a != b
+	case "<":
+		return a < b
+	case "<=":
+		return a <= b
+	case ">":
+		return a > b
+	}
+	return a >= b
+}
+
+func genAny(tc hegel.TestCase, e modelEnv, depth int) gen {
+	switch n(tc, 0, 3) {
+	case 0:
+		return genInt(tc, e, depth)
+	case 1:
+		return genFloat(tc, e, depth)
+	case 2:
+		return genStr(tc, e, depth)
+	}
+	return genBool(tc, e, depth)
+}
+
+// ---------------------------------------------------------------------------
+// The upstream fuzz corpus and its environment.
+
+var (
+	corpusOnce sync.Once
+	corpus     []string
+)
+
+func fuzzCorpus(t testing.TB) []string {
+	corpusOnce.Do(func() {
+		b, err := os.ReadFile("test/fuzz/fuzz_corpus.txt")
+		if err != nil {
+			t.Fatalf("fuzz corpus: %v", err)
+		}
+		for _, line := range strings.Split(strings.TrimSpace(string(b)), "\n") {
+			if line != "" {
+				corpus = append(corpus, line)
+			}
+		}
+	})
+	return corpus
+}
+
+// timeDependent: sources whose value changes between two runs.
+func timeDependent(src string) bool {
+	return strings.Contains(src, "now(") || strings.Contains(src, "date(") || strings.Contains(src, "duration(") || strings.Contains(src, "timezone(")
+}
+
+// mutateSource applies 0–2 small edits to a corpus line: insert, delete or
+// replace a character, or splice in a fragment of another line.
+func mutateSource(tc hegel.TestCase, src string, others []string) string {
+	pieces := []string{" ", "(", ")", "[", "]", "{", "}", ",", ".", "?.", "??", "?", ":", ";", "#", "$env", "|", "+", "-", "*", "/", "%", "**", "==", "!=", "<", ">=", "not ", " and ", " or ", " in ", "..", "nil", "true", "1", "0.5", "'x'", "\"y\"", "i", "f64", "array", "list", "foo", "ok", "let x = 1; ", "if true { 1 } else { 2 }", "\\", "`", "\n", "//", "/*", "0x", "1e", "b'z'", "..."}
+	for k := n(tc, 0, 2); k > 0; k-- {
+		rs := []rune(src)
+		pos := n(tc, 0, len(rs))
+		switch n(tc, 0, 3) {
+		case 0:
+			rs = append(rs[:pos], append([]rune(pick(tc, pieces...)), rs[pos:]...)...)
+		case 1:
+			if pos < len(rs) {
+				rs = append(rs[:pos], rs[pos+1:]...)
+			}
+		case 2:
+			if pos < len(rs) {
+				rs = append(rs[:pos], append([]rune(pick(tc, pieces...)), rs[pos+1:]...)...)
+			}
+		default:
+			other := []rune(pick(tc, others...))
+			a := n(tc, 0, len(other))
+			b := n(tc, a, len(other))
+			rs = append(rs[:pos], append(other[a:b], rs[pos:]...)...)
+		}
+		src = string(rs)
+	}
+	return src
+}
+
+// upstreamAccepted: the runtime errors upstream's fuzz test skips as expected.
+var upstreamAccepted = []*regexp.Regexp{
+	regexp.MustCompile(`cannot fetch .* from .*`),
+	regexp.MustCompile(`cannot get .* from .*`),
+	regexp.MustCompile(`cannot slice`),
+	regexp.MustCompile(`slice index out of range`),
+	regexp.MustCompile(`error parsing regexp`),
+	regexp.MustCompile(`integer divide by zero`),
+	regexp.MustCompile(`interface conversion`),
+	regexp.MustCompile(`invalid argument`),
+	regexp.MustCompile(`invalid character`),
+	regexp.MustCompile(`invalid operation`),
+	regexp.MustCompile(`invalid duration`),
+	regexp.MustCompile(`time: missing unit in duration`),
+	regexp.MustCompile(`time: unknown unit .* in duration`),
+	regexp.MustCompile(`unknown time zone`),
+	regexp.MustCompile(`invalid location name`),
+	regexp.MustCompile(`json: unsupported value`),
+	regexp.MustCompile(`json: unsupported type`),
+	regexp.MustCompile(`json: cannot unmarshal .* into Go value of type .*`),
+	regexp.MustCompile(`unexpected end of JSON input`),
+	regexp.MustCompile(`memory budget exceeded`),
+	regexp.MustCompile(`using interface \{} as type .*`),
+	regexp.MustCompile(`reflect.Value.MapIndex: value of type .* is not assignable to type .*`),
+	regexp.MustCompile(`reflect: Call using .* as type .*`),
+	regexp.MustCompile(`reflect: cannot use .* as type .* in .*`),
+	regexp.MustCompile(`reflect: Call with too few input arguments`),
+	regexp.MustCompile(`invalid number of arguments`),
+	regexp.MustCompile(`reflect: call of reflect.Value.Call on .* Value`),
+	regexp.MustCompile(`reflect: call of reflect.Value.Index on map Value`),
+	regexp.MustCompile(`reflect: call of reflect.Value.Len on .* Value`),
+	regexp.MustCompile(`reflect: string index out of range`),
+	regexp.MustCompile(`strings: negative Repeat count`),
+	regexp.MustCompile(`strings: illegal bytes to escape`),
+	regexp.MustCompile(`invalid date .*`),
+	regexp.MustCompile(`parsing time .*`),
+	regexp.MustCompile(`cannot parse .* as .*`),
+	regexp.MustCompile(`operator "in" not defined on .*`),
+	regexp.MustCompile(`cannot sum .*`),
+	regexp.MustCompile(`index out of range: .* \(array length is .*\)`),
+	regexp.MustCompile(`reduce of empty array with no initial value`),
+	regexp.MustCompile(`cannot use <nil> as argument \(type .*\) to call .*`),
+	regexp.MustCompile(`illegal base64 data at input byte .*`),
+	regexp.MustCompile(`sort order argument must be a string`),
+	regexp.MustCompile(`sortBy order argument must be a string`),
+	regexp.MustCompile(`invalid order .*, expected asc or desc`),
+	regexp.MustCompile(`unknown order, use asc or desc`),
+	regexp.MustCompile(`cannot use .* as a key for groupBy: type is not comparable`),
+}
+
+func accepted(err error) bool {
+	for _, r := range upstreamAccepted {
+		if r.MatchString(err.Error()) {
+			return true
+		}
+	}
+	return false
+}
