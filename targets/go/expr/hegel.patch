new file mode 100644
index 0000000..e84ee1c
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2622 @@
+package expr_test
+
+// Hegel properties for github.com/expr-lang/expr (the Hegel zoo). Oracles:
+// a Go model of the documented semantics (docs/language-definition.md and
+// the vm/runtime helpers' documented types: `/` is always a float, `%` an
+// int, `+` on ints an int), the Go standard library behind the builtins
+// (strings, strconv, encoding/json, encoding/base64), and Expr against
+// itself (optimizer on vs off, static type vs runtime type, print → parse).
+// The upstream fuzz corpus (test/fuzz/fuzz_corpus.txt) seeds the
+// self-consistency properties.
+//
+// Every property draws one case record built from the binding's
+// combinators: an environment record and a typed expression tree (node),
+// rendered to source text and to the model's value by a pure realiser; a
+// corpus line and a list of edit records applied modulo the live length;
+// the array-function, string-function, conversion, indexing and option
+// cases as records with their positions taken modulo the live sizes. The
+// shapes of the recorded bugs (bugs.toml) are drawn at their natural rate,
+// so the properties that meet them fail, naming the shape, and are the
+// expected failures mapped to the bugs (STYLE.md rule 11);
+// hegel_shapes_test.go has one property per bug over its shape region, and
+// hegel_pins_test.go the regression examples. HEGEL_NO_KNOWN=1 switches the
+// known shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// Collect mode (EXPR_COLLECT=1) prints every disagreement instead of
+// failing.
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/ast"
+	"github.com/expr-lang/expr/checker"
+	"github.com/expr-lang/expr/conf"
+	"github.com/expr-lang/expr/parser"
+	"github.com/expr-lang/expr/parser/operator"
+	"github.com/expr-lang/expr/test/fuzz"
+	"github.com/expr-lang/expr/vm"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness plumbing (shared with the other Go targets of the zoo).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("EXPR_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Known bugs.
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape (mismatch); under HEGEL_NO_KNOWN=1
+// the switches of Known are on: the shapes are left out of the generators
+// (shaped) and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); on means
+// the shape is skipped, which is so only under HEGEL_NO_KNOWN=1. The pins
+// in hegel_pins_test.go assert the correct behaviour and fail while a bug
+// is open, and hegel_shapes_test.go has a property per bug.
+var Known = struct {
+	findersTypedNonNil  bool // expr/1: static types never admit nil — find/first/last/get typed as the element type, `c ? nil : x` as x's type
+	integralFloatPrints bool // expr/2: FloatNode.String() prints 1.0 as 1, which re-parses as an integer
+	nestedLetPrints     bool // expr/3: a `let` or a `;` sequence inside another expression prints without its parentheses
+	predicatesStayOn    bool // expr/4: DisableBuiltin/DisableAllBuiltins leave the predicate builtins (filter, count, sum, …) enabled
+	rangeOperandBare    bool // expr/5: BinaryNode.String() never parenthesises the operands of `..`: `(c ? 1 : 2)..3` prints `c ? 1 : 2..3`
+	seedlessReduceTyped bool // expr/6: a seedless `reduce` is typed as its predicate, but a one-element array returns the element
+	mixedMinMaxTyped    bool // expr/7: `min`/`max` are typed as their first argument, but return whichever argument wins
+	emptySumTyped       bool // expr/8: `sum(array)` is typed as the element type, but an empty array sums to the int 0
+	shortCircuitFolded  bool // expr/9: the optimizer folds `x and false` and `x or true` to the constant, hiding a run-time error of x
+}{findersTypedNonNil: noKnown, integralFloatPrints: noKnown, nestedLetPrints: noKnown, predicatesStayOn: noKnown,
+	rangeOperandBare: noKnown, seedlessReduceTyped: noKnown, mixedMinMaxTyped: noKnown, emptySumTyped: noKnown, shortCircuitFolded: noKnown}
+
+// gates are the switches of Known by bug id.
+var gates = map[string]bool{
+	"expr/1": Known.findersTypedNonNil,
+	"expr/2": Known.integralFloatPrints,
+	"expr/3": Known.nestedLetPrints,
+	"expr/4": Known.predicatesStayOn,
+	"expr/5": Known.rangeOperandBare,
+	"expr/6": Known.seedlessReduceTyped,
+	"expr/7": Known.mixedMinMaxTyped,
+	"expr/8": Known.emptySumTyped,
+	"expr/9": Known.shortCircuitFolded,
+}
+
+// shapes are the ids of the recorded bugs whose shape a case has.
+type shapes []string
+
+// add names the bug when the case has its shape (present).
+func (s *shapes) add(id string, present bool) {
+	if present && !slices.Contains(*s, id) {
+		*s = append(*s, id)
+	}
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the
+// shape of the recorded bugs named (none for a plain failure): the failure
+// names the shape, and while every gate of the shape is on (HEGEL_NO_KNOWN=1)
+// a disagreement on it is skipped instead.
+func mismatch(ht *hegel.T, shape shapes, format string, args ...any) {
+	if len(shape) > 0 {
+		gated := true
+		for _, id := range shape {
+			gated = gated && gates[id]
+		}
+		ht.Assume(!gated)
+		format += " (the shape of " + strings.Join(shape, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) shapes {
+	var s shapes
+	s.add(id, has)
+	return s
+}
+
+// known names the bug a property over its shape region is about, or nothing
+// under HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) shapes { return shapeIf(!noKnown, id) }
+
+// predicateBuiltins are parsed as special forms (parser.predicates), not looked up in the builtin table.
+var predicateBuiltins = []string{"all", "any", "one", "none", "map", "filter", "find", "findIndex", "findLast", "findLastIndex", "groupBy", "sortBy", "count", "sum", "reduce"}
+
+// nestedLetFinder flags a VariableDeclaratorNode or SequenceNode below the root.
+type nestedLetFinder struct {
+	root  ast.Node
+	found bool
+}
+
+func (f *nestedLetFinder) Visit(node *ast.Node) {
+	if *node == f.root {
+		return
+	}
+	switch (*node).(type) {
+	case *ast.VariableDeclaratorNode, *ast.SequenceNode:
+		f.found = true
+	}
+}
+
+var finders = []string{"find(", "findLast(", "findIndex(", "findLastIndex(", "first(", "last(", "get("}
+
+func usesFinder(src string) bool {
+	for _, f := range finders {
+		if strings.Contains(src, f) {
+			return true
+		}
+	}
+	return false
+}
+
+// integralFloatFinder flags a FloatNode whose value prints without a
+// decimal point (or an exponent, which re-parses as a float).
+type integralFloatFinder struct{ found bool }
+
+func (f *integralFloatFinder) Visit(node *ast.Node) {
+	if fn, ok := (*node).(*ast.FloatNode); ok && printsAsInteger(fn.Value) {
+		f.found = true
+	}
+}
+
+// printsAsInteger: FloatNode.String() (%v) writes the value without a
+// decimal point or an exponent.
+func printsAsInteger(v float64) bool {
+	return !math.IsInf(v, 0) && !math.IsNaN(v) && v == math.Trunc(v) && !strings.ContainsAny(fmt.Sprintf("%v", v), ".eIN")
+}
+
+// rangeOperandFinder flags a `..` whose operand binds looser than `..` and
+// is printed bare (expr/5): BinaryNode's printer never parenthesises the
+// operands of `..`, so `(c ? 1 : 2)..3` prints `c ? 1 : 2..3`, `(1 == 2)..3`
+// prints `1 == 2..3`, `1..(2..3)` prints `1..2..3` and `(1 ?? 2)..3` prints
+// `1 ?? 2..3`, which does not parse.
+type rangeOperandFinder struct{ found bool }
+
+func (f *rangeOperandFinder) Visit(node *ast.Node) {
+	b, ok := (*node).(*ast.BinaryNode)
+	if !ok || b.Operator != ".." {
+		return
+	}
+	for i, side := range []ast.Node{b.Left, b.Right} {
+		switch s := side.(type) {
+		case *ast.ConditionalNode:
+			f.found = true
+		case *ast.BinaryNode:
+			if s.Operator == "??" || operator.Less(s.Operator, "..") || (i == 1 && s.Operator == "..") {
+				f.found = true
+			}
+		}
+	}
+}
+
+// printShapes names the recorded bugs whose shape a parsed tree has when it
+// is printed and re-parsed: an integral float literal (expr/2), a nested
+// `let` or sequence (expr/3), a `..` operand that binds looser (expr/5).
+func printShapes(root ast.Node) shapes {
+	f := &integralFloatFinder{}
+	ast.Walk(&root, f)
+	l := &nestedLetFinder{root: root}
+	ast.Walk(&root, l)
+	var sh shapes
+	sh.add("expr/2", f.found)
+	sh.add("expr/3", l.found)
+	sh.add("expr/5", rangeOperandUnwrapped(root))
+	return sh
+}
+
+// rangeOperandUnwrapped reports the shape of expr/5.
+func rangeOperandUnwrapped(root ast.Node) bool {
+	f := &rangeOperandFinder{}
+	ast.Walk(&root, f)
+	return f.found
+}
+
+// seedlessReduceFinder flags a `reduce(array, predicate)` without an
+// initial value (expr/6): the checker (checker.go, case "reduce") gives it
+// the predicate's type, but over a one-element array the runtime returns
+// the element itself, so `reduce([1], #acc >= #)` is statically a bool and
+// evaluates to the int 1 (it compiles under AsBool and fails at run time
+// with "invalid operation: bool(int)").
+type seedlessReduceFinder struct{ found bool }
+
+func (f *seedlessReduceFinder) Visit(node *ast.Node) {
+	if b, ok := (*node).(*ast.BuiltinNode); ok && b.Name == "reduce" && len(b.Arguments) == 2 {
+		f.found = true
+	}
+}
+
+// reducesWithoutSeed reports the shape of expr/6.
+func reducesWithoutSeed(root ast.Node) bool {
+	f := &seedlessReduceFinder{}
+	ast.Walk(&root, f)
+	return f.found
+}
+
+// mixedMinMaxFinder flags a `min`/`max` whose arguments are of different
+// kinds (expr/7): validateAggregateFunc (builtin/validation.go) types the
+// call as its first argument, so `min(1, 0.5)` is statically an int and
+// evaluates to the float64 0.5 (and `min(i64, f32)` is statically an int64
+// and evaluates to a float32). It runs on a checked tree, whose nodes carry
+// their types.
+type mixedMinMaxFinder struct{ found bool }
+
+func (f *mixedMinMaxFinder) Visit(node *ast.Node) {
+	b, ok := (*node).(*ast.BuiltinNode)
+	if !ok || (b.Name != "min" && b.Name != "max") || len(b.Arguments) < 2 || b.Arguments[0].Type() == nil {
+		return
+	}
+	for _, a := range b.Arguments[1:] {
+		if a.Type() == nil || a.Type().Kind() != b.Arguments[0].Type().Kind() {
+			f.found = true
+		}
+	}
+}
+
+// seedlessSumFinder flags a `sum(array)` over elements that are not ints
+// (expr/8): the checker (checker.go, case "sum") types the call as the
+// element type, but an empty array sums to the int 0 (compiler.go seeds the
+// accumulator with `OpInt 0`), so `sum([0.5][1:])` is statically a float64
+// and evaluates to the int 0 (and `sum(list[1:1])` over a []string is
+// statically a string).
+type seedlessSumFinder struct{ found bool }
+
+func (f *seedlessSumFinder) Visit(node *ast.Node) {
+	b, ok := (*node).(*ast.BuiltinNode)
+	if !ok || b.Name != "sum" || len(b.Arguments) != 1 || b.Type() == nil {
+		return
+	}
+	if b.Type().Kind() != reflect.Int {
+		f.found = true
+	}
+}
+
+// shortCircuitFinder flags `x and false`, `false and x`, `x or true` and
+// `true or x` (expr/9): the constant folder (optimizer/fold.go, cases "and"
+// and "or") replaces them by the constant whatever x is, so an x that fails
+// at run time no longer does: `(false ? 0.5 : "bar") and false` is the
+// error "interface conversion: interface {} is string, not bool"
+// unoptimised and false optimised, and corpus line `reduce(false ? 0.5 :
+// "bar", # and false)` likewise. (`false and x` and `true or x` short-circuit
+// unoptimised too and agree; the finder names the shape on either side.)
+type shortCircuitFinder struct{ found bool }
+
+func (f *shortCircuitFinder) Visit(node *ast.Node) {
+	b, ok := (*node).(*ast.BinaryNode)
+	if !ok {
+		return
+	}
+	for _, side := range []ast.Node{b.Left, b.Right} {
+		if c, ok := side.(*ast.BoolNode); ok {
+			switch b.Operator {
+			case "and", "&&":
+				f.found = f.found || !c.Value
+			case "or", "||":
+				f.found = f.found || c.Value
+			}
+		}
+	}
+}
+
+// foldsShortCircuit reports the shape of expr/9.
+func foldsShortCircuit(root ast.Node) bool {
+	f := &shortCircuitFinder{}
+	ast.Walk(&root, f)
+	return f.found
+}
+
+// foldShape names expr/9 when a source compiled with the optimizer has its
+// shape (nothing for a source that does not parse, or unoptimised).
+func foldShape(src string, optimize bool) shapes {
+	var sh shapes
+	if tree, err := parser.Parse(src); optimize && err == nil {
+		sh.add("expr/9", foldsShortCircuit(tree.Node))
+	}
+	return sh
+}
+
+// staticShapes names the recorded bugs whose shape a checked tree has when
+// its static type is compared with the value it produces: a seedless reduce
+// (expr/6), a mixed min/max (expr/7), a seedless sum of non-ints (expr/8).
+func staticShapes(root ast.Node) shapes {
+	m := &mixedMinMaxFinder{}
+	ast.Walk(&root, m)
+	s := &seedlessSumFinder{}
+	ast.Walk(&root, s)
+	var sh shapes
+	sh.add("expr/6", reducesWithoutSeed(root))
+	sh.add("expr/7", m.found)
+	sh.add("expr/8", s.found)
+	return sh
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// nonNil is xs, or an empty non-nil slice for none (Lists yields nil).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+// textOf is a string of up to max runes of the alphabet.
+func textOf(alphabet string, max int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(alphabet).MaxSize(max)
+}
+
+// evenly is an index of 0..n-1 spread evenly over the range: an Integers
+// (or SampledFrom) draw over a large range is magnitude-biased toward its
+// low end (seven draws in ten of 0..19545 fell in the first tenth), so the
+// index is composed from decimal digits, each drawn evenly, and taken
+// modulo n; it shrinks to 0.
+func evenly(n int) hegel.Generator[int] {
+	digits := 1
+	for p := 10; p < n; p *= 10 {
+		digits++
+	}
+	return hegel.Map(hegel.Lists(hegel.Integers(0, 9)).MinSize(digits).MaxSize(digits), func(ds []int) int {
+		i := 0
+		for _, d := range ds {
+			i = i*10 + d
+		}
+		return i % n
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Values, environments, comparison.
+
+// val is a model value: an int, a float, a string or a bool.
+type val struct {
+	kind byte // 'i', 'f', 's', 'b'
+	i    int
+	f    float64
+	s    string
+	b    bool
+}
+
+func vi(i int) val     { return val{kind: 'i', i: i} }
+func vf(f float64) val { return val{kind: 'f', f: f} }
+func vs(s string) val  { return val{kind: 's', s: s} }
+func vb(b bool) val    { return val{kind: 'b', b: b} }
+func (v val) num() float64 { // the numeric value of an int or float
+	if v.kind == 'i' {
+		return float64(v.i)
+	}
+	return v.f
+}
+
+func (v val) String() string {
+	switch v.kind {
+	case 'i':
+		return fmt.Sprintf("int %d", v.i)
+	case 'f':
+		return fmt.Sprintf("float %v", v.f)
+	case 's':
+		return fmt.Sprintf("string %q", v.s)
+	}
+	return fmt.Sprintf("bool %v", v.b)
+}
+
+// sameFloat: equal, or both NaN.
+func sameFloat(a, b float64) bool { return a == b || (math.IsNaN(a) && math.IsNaN(b)) }
+
+// matches compares a runtime result with a model value: the Go type must be
+// the model's (int, float64, string, bool) and the value equal.
+func matches(got any, want val) bool {
+	switch want.kind {
+	case 'i':
+		g, ok := got.(int)
+		return ok && g == want.i
+	case 'f':
+		g, ok := got.(float64)
+		return ok && sameFloat(g, want.f)
+	case 's':
+		g, ok := got.(string)
+		return ok && g == want.s
+	}
+	g, ok := got.(bool)
+	return ok && g == want.b
+}
+
+// mapOrdered: the source lists a map (keys, values, toPairs), in Go's map
+// iteration order, which differs from run to run (corpus line 11825,
+// `keys(groupBy(array, # ** 0.5))`, came out in five orders over fifty runs).
+func mapOrdered(src string) bool {
+	return strings.Contains(src, "keys(") || strings.Contains(src, "values(") || strings.Contains(src, "toPairs(")
+}
+
+// sameMultiset: two slices holding the same elements in some order.
+func sameMultiset(a, b any) bool {
+	ra, rb := reflect.ValueOf(a), reflect.ValueOf(b)
+	if !ra.IsValid() || !rb.IsValid() || ra.Kind() != reflect.Slice || rb.Kind() != reflect.Slice || ra.Type() != rb.Type() || ra.Len() != rb.Len() {
+		return false
+	}
+	as, bs := make([]string, ra.Len()), make([]string, rb.Len())
+	for i := range as {
+		as[i], bs[i] = fmt.Sprintf("%#v", ra.Index(i).Interface()), fmt.Sprintf("%#v", rb.Index(i).Interface())
+	}
+	slices.Sort(as)
+	slices.Sort(bs)
+	return slices.Equal(as, bs)
+}
+
+// deterministic: eight runs of the program agree.
+func deterministic(p *vm.Program, env any) bool {
+	first, err := expr.Run(p, env)
+	for i := 0; i < 7; i++ {
+		v, e := expr.Run(p, env)
+		if (e == nil) != (err == nil) || (e == nil && !sameValue(v, first)) {
+			return false
+		}
+	}
+	return true
+}
+
+// sameValue compares two runtime results structurally, NaN equal to NaN.
+func sameValue(a, b any) bool {
+	if ra, rb := reflect.ValueOf(a), reflect.ValueOf(b); ra.IsValid() && rb.IsValid() && ra.Kind() == reflect.Func && rb.Kind() == reflect.Func {
+		return ra.Pointer() == rb.Pointer()
+	}
+	if fa, ok := a.(float64); ok {
+		fb, ok := b.(float64)
+		return ok && sameFloat(fa, fb)
+	}
+	if ra, rb := reflect.ValueOf(a), reflect.ValueOf(b); ra.IsValid() && rb.IsValid() && ra.Kind() == reflect.Map && rb.Kind() == reflect.Map {
+		if ra.Type() != rb.Type() || ra.Len() != rb.Len() {
+			return false
+		}
+		for _, k := range ra.MapKeys() {
+			vb := rb.MapIndex(k)
+			if !vb.IsValid() || !sameValue(ra.MapIndex(k).Interface(), vb.Interface()) {
+				return false
+			}
+		}
+		return true
+	}
+	if ra, rb := reflect.ValueOf(a), reflect.ValueOf(b); ra.IsValid() && rb.IsValid() && ra.Kind() == reflect.Slice && rb.Kind() == reflect.Slice {
+		if ra.Type() != rb.Type() || ra.Len() != rb.Len() {
+			return false
+		}
+		for i := 0; i < ra.Len(); i++ {
+			if !sameValue(ra.Index(i).Interface(), rb.Index(i).Interface()) {
+				return false
+			}
+		}
+		return true
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+// seqOfInts checks that a result is a sequence whose elements are the ints given.
+func seqOfInts(got any, want []int) bool {
+	v := reflect.ValueOf(got)
+	if !v.IsValid() || v.Kind() != reflect.Slice || v.Len() != len(want) {
+		return false
+	}
+	for i := range want {
+		if !matches(v.Index(i).Interface(), vi(want[i])) {
+			return false
+		}
+	}
+	return true
+}
+
+// alphabet for generated strings: ASCII letters, digits, punctuation the
+// lexer must handle inside quotes, spaces and a few multi-byte runes.
+var runes = []rune("abcxyzABCXYZ019 _-.,!?:;/\\'\"éß日本😀\t\n")
+
+// asciiPrintable: the printable ASCII characters, for byte-indexed operations.
+var asciiPrintable = func() string {
+	b := make([]byte, 0, 95)
+	for c := byte(0x20); c <= 0x7e; c++ {
+		b = append(b, c)
+	}
+	return string(b)
+}()
+
+// lit renders a literal of the model value in Expr syntax.
+func lit(v val) string {
+	switch v.kind {
+	case 'i':
+		if v.i < 0 {
+			return fmt.Sprintf("(%d)", v.i)
+		}
+		return strconv.Itoa(v.i)
+	case 'f':
+		s := strconv.FormatFloat(v.f, 'g', -1, 64)
+		if !strings.ContainsAny(s, ".eIN") {
+			s += ".0"
+		}
+		if v.f < 0 {
+			return "(" + s + ")"
+		}
+		return s
+	case 's':
+		return strconv.Quote(v.s)
+	}
+	return strconv.FormatBool(v.b)
+}
+
+func compile(src string, env any, optimize bool, opts ...expr.Option) (*vm.Program, error) {
+	opts = append([]expr.Option{expr.Env(env), expr.Optimize(optimize)}, opts...)
+	return expr.Compile(src, opts...)
+}
+
+// eval compiles and runs; a nil error and the value, or the error of either step.
+func eval(src string, env any, optimize bool, opts ...expr.Option) (any, error) {
+	p, err := compile(src, env, optimize, opts...)
+	if err != nil {
+		return nil, fmt.Errorf("compile: %w", err)
+	}
+	return expr.Run(p, env)
+}
+
+// modelEnv is the environment the typed expressions are evaluated in.
+type modelEnv struct {
+	i, k int
+	f    float64
+	s, t string
+	arr  []int
+}
+
+func (e modelEnv) env() map[string]any {
+	return map[string]any{"i": e.i, "k": e.k, "f": e.f, "s": e.s, "t": e.t, "arr": e.arr}
+}
+
+func (e modelEnv) String() string {
+	return fmt.Sprintf("{i:%d k:%d f:%v s:%q t:%q arr:%v}", e.i, e.k, e.f, e.s, e.t, e.arr)
+}
+
+var (
+	// envFloats: the values of f (the two zeros weight the plain value).
+	envFloats = []float64{0.0, 0.5, -1.5, 2.25, 1e3, 0.0, 3.0}
+	envs      = hegel.Composite(func(tc hegel.TestCase) modelEnv {
+		return modelEnv{
+			i:   hegel.Draw(tc, hegel.Integers(-50, 50)),
+			k:   hegel.Draw(tc, hegel.Integers(-3, 12)),
+			f:   hegel.Draw(tc, hegel.SampledFrom(envFloats)),
+			s:   hegel.Draw(tc, textOf(asciiPrintable, 6)),
+			t:   hegel.Draw(tc, textOf(asciiPrintable, 3)),
+			arr: hegel.Draw(tc, hegel.Lists(hegel.Integers(-20, 20)).MaxSize(6)),
+		}
+	})
+)
+
+// ---------------------------------------------------------------------------
+// A typed expression grammar with a model. A tree of nodes is drawn from
+// depth-indexed generators (one per value type, memoised per depth, each a
+// weighted choice of node kinds whose fields are the sub-expressions and the
+// drawn operator); realise renders the source text and computes the model's
+// value over an environment.
+
+// node is a node of a typed expression tree.
+type node struct {
+	typ    byte   // the value type: 'i', 'f', 's', 'b'
+	kind   string // lit, var, arith, neg, abs, minmax, cond, int(str), count, let, div, pow, farith, float, round, concat, case, string, repeat, cmp, strcmp, logic, not, inarr, inrange
+	op     string // the drawn operator or function of the kind
+	v      val    // the literal of a lit; the name of a var in v.s
+	args   []node
+	lo, hi int // the bounds of an inrange; lo is the count of a repeat
+}
+
+// GoString is what the draw report prints (it uses %#v): the source.
+func (n node) GoString() string { return render(n) }
+
+// gen is a realised expression: its source and the model's value.
+type gen struct {
+	src      string
+	v        val
+	err      bool // evaluating it is a runtime error (integer division by zero)
+	fold     bool // compiling it with the optimizer is an error: it holds a constant `% 0`, evaluated or not
+	constant bool // an int the optimizer folds to a literal: int literals under + - * % and unary minus
+}
+
+func litsOf(typ byte, vals hegel.Generator[val]) hegel.Generator[node] {
+	return hegel.Map(vals, func(v val) node { return node{typ: typ, kind: "lit", v: v} })
+}
+
+func varsOf(typ byte, names hegel.Generator[string]) hegel.Generator[node] {
+	return hegel.Map(names, func(s string) node { return node{typ: typ, kind: "var", v: vs(s)} })
+}
+
+// nodeOf is a node of the kind with an operator drawn from ops (none for
+// nil) and its operands drawn from args.
+func nodeOf(typ byte, kind string, ops []string, args ...hegel.Generator[node]) hegel.Generator[node] {
+	return hegel.Composite(func(tc hegel.TestCase) node {
+		n := node{typ: typ, kind: kind}
+		if len(ops) > 0 {
+			n.op = hegel.Draw(tc, hegel.SampledFrom(ops))
+		}
+		for _, g := range args {
+			n.args = append(n.args, hegel.Draw(tc, g))
+		}
+		return n
+	})
+}
+
+func asVals[T any](g hegel.Generator[T], f func(T) val) hegel.Generator[val] { return hegel.Map(g, f) }
+
+var (
+	// intLits: the literal ints: the small and boundary values, or any
+	// within a hundred (MinInt itself has no literal: the lexer reads the
+	// magnitude first).
+	intLits   = hegel.OneOf(hegel.SampledFrom([]int{0, 1, 2, -1, 7, 10, 255, -128, 1000, math.MaxInt, math.MinInt + 1}), hegel.Integers(-100, 100))
+	intLeaves = weighted(
+		choice[node]{20, litsOf('i', asVals(intLits, vi))},
+		choice[node]{80, varsOf('i', hegel.SampledFrom([]string{"i", "k", "len(arr)", "len(s)"}))},
+	)
+	// floatLits: the literal floats; the integral ones (0.0, 1.0, a whole
+	// quarter) are the shape of expr/2 and left out under HEGEL_NO_KNOWN=1.
+	floatConsts = shaped([]float64{0.0, 0.5, 1.0, -2.5, 0.1, 1e10, 3.75}, []float64{0.5, -2.5, 0.1, 3.75})
+	quarters    = shaped[hegel.Generator[float64]](
+		hegel.Map(hegel.Integers(-100, 100), func(n int) float64 { return float64(n) / 4 }),
+		hegel.Composite(func(tc hegel.TestCase) float64 {
+			return float64(hegel.Draw(tc, hegel.Integers(-25, 25))) + float64(hegel.Draw(tc, hegel.Integers(1, 3)))/4
+		}),
+	)
+	floatLits   = hegel.OneOf(hegel.SampledFrom(floatConsts), quarters)
+	floatLeaves = weighted(
+		choice[node]{70, litsOf('f', asVals(floatLits, vf))},
+		choice[node]{30, varsOf('f', hegel.Just("f"))},
+	)
+	strLeaves = hegel.OneOf(
+		litsOf('s', asVals(textOf(string(runes), 5), vs)),
+		varsOf('s', hegel.SampledFrom([]string{"s", "t"})),
+	)
+	boolLeaves = litsOf('b', asVals(hegel.Booleans(), vb))
+)
+
+var (
+	intMemo   = map[int]hegel.Generator[node]{}
+	floatMemo = map[int]hegel.Generator[node]{}
+	strMemo   = map[int]hegel.Generator[node]{}
+	boolMemo  = map[int]hegel.Generator[node]{}
+	memoMu    sync.Mutex
+)
+
+// at is the generator of a type at depth d, memoised: the leaves at depth
+// 0, otherwise the leaves leafPct percent of the time and the nodes over
+// the sub-expressions at depth d-1 for the rest.
+func at(memo map[int]hegel.Generator[node], d int, leaves hegel.Generator[node], leafPct int, nodes func(int) hegel.Generator[node]) hegel.Generator[node] {
+	memoMu.Lock()
+	g, ok := memo[d]
+	memoMu.Unlock()
+	if ok {
+		return g
+	}
+	g = leaves
+	if d > 0 {
+		g = weighted(choice[node]{leafPct, leaves}, choice[node]{100 - leafPct, nodes(d)})
+	}
+	memoMu.Lock()
+	memo[d] = g
+	memoMu.Unlock()
+	return g
+}
+
+func intAt(d int) hegel.Generator[node]   { return at(intMemo, d, intLeaves, 30, intNodes) }
+func floatAt(d int) hegel.Generator[node] { return at(floatMemo, d, floatLeaves, 30, floatNodes) }
+func strAt(d int) hegel.Generator[node]   { return at(strMemo, d, strLeaves, 30, strNodes) }
+func boolAt(d int) hegel.Generator[node]  { return at(boolMemo, d, boolLeaves, 25, boolNodes) }
+func numAt(d int) hegel.Generator[node]   { return hegel.OneOf(intAt(d), floatAt(d)) }
+func anyAt(d int) hegel.Generator[node] {
+	return hegel.OneOf(intAt(d), floatAt(d), strAt(d), boolAt(d))
+}
+
+// lets is a `let` binding whose body adds the bound name to b.
+func lets(a, b hegel.Generator[node]) hegel.Generator[node] { return nodeOf('i', "let", nil, a, b) }
+
+// intNodes: the int expressions over sub-expressions at depth d-1,
+// including the int-valued predicate builtins over arr (count, sum,
+// len(filter)). A `let` among them is nested in whatever holds it (the
+// shape of expr/3), so under HEGEL_NO_KNOWN=1 the binding is drawn at the
+// root only (trees).
+func intNodes(d int) hegel.Generator[node] {
+	ints, bools := intAt(d-1), boolAt(d-1)
+	kinds := []choice[node]{
+		{4, nodeOf('i', "arith", []string{"+", "-", "*", "%"}, ints, ints)},
+		{1, nodeOf('i', "neg", nil, ints)},
+		{1, nodeOf('i', "abs", nil, ints)},
+		{2, nodeOf('i', "minmax", []string{"min", "max"}, ints, ints)},
+		{1, nodeOf('i', "cond", nil, bools, ints, ints)},
+		{1, nodeOf('i', "int(str)", nil, ints)},
+		{1, nodeOf('i', "count", nil, ints)},
+		{1, nodeOf('i', "sum", nil, ints)},
+		{1, nodeOf('i', "nfilter", nil, ints)},
+	}
+	return weighted(shaped(append(kinds, choice[node]{1, lets(ints, ints)}), kinds)...)
+}
+
+func floatNodes(d int) hegel.Generator[node] {
+	ints, floats, nums := intAt(d-1), floatAt(d-1), numAt(d-1)
+	return weighted(
+		choice[node]{1, nodeOf('f', "neg", nil, floats)},
+		choice[node]{1, nodeOf('f', "float", nil, ints)},
+		choice[node]{3, nodeOf('f', "round", []string{"ceil", "floor", "round"}, floats)},
+		choice[node]{1, nodeOf('f', "farith", []string{"+", "-", "*"}, floats, nums)},
+		choice[node]{1, nodeOf('f', "div", nil, nums, nums)}, // `/` is always a float, on ints too
+		choice[node]{1, nodeOf('f', "pow", []string{"**", "^"}, nums, nums)},
+	)
+}
+
+func strNodes(d int) hegel.Generator[node] {
+	ints, strs, bools := intAt(d-1), strAt(d-1), boolAt(d-1)
+	repeats := hegel.Composite(func(tc hegel.TestCase) node {
+		return node{typ: 's', kind: "repeat", args: []node{hegel.Draw(tc, strs)}, lo: hegel.Draw(tc, hegel.Integers(0, 3))}
+	})
+	return weighted(
+		choice[node]{3, nodeOf('s', "case", []string{"upper", "lower", "trim"}, strs)},
+		choice[node]{1, nodeOf('s', "concat", nil, strs, strs)},
+		choice[node]{1, nodeOf('s', "string", nil, ints)},
+		choice[node]{1, nodeOf('s', "cond", nil, bools, strs, strs)},
+		choice[node]{1, repeats},
+	)
+}
+
+func boolNodes(d int) hegel.Generator[node] {
+	ints, strs, bools, nums := intAt(d-1), strAt(d-1), boolAt(d-1), numAt(d-1)
+	inRanges := hegel.Composite(func(tc hegel.TestCase) node {
+		return node{typ: 'b', kind: "inrange", args: []node{hegel.Draw(tc, ints)}, lo: hegel.Draw(tc, hegel.Integers(-5, 5)), hi: hegel.Draw(tc, hegel.Integers(-5, 8))}
+	})
+	return weighted(
+		choice[node]{1, nodeOf('b', "not", []string{"not ", "!"}, bools)},
+		choice[node]{2, nodeOf('b', "cmp", []string{"==", "!=", "<", "<=", ">", ">="}, nums, nums)},
+		choice[node]{1, nodeOf('b', "strcmp", []string{"==", "!=", "contains", "startsWith", "endsWith"}, strs, strs)},
+		choice[node]{1, nodeOf('b', "logic", []string{"and", "&&", "or", "||"}, bools, bools)},
+		choice[node]{1, nodeOf('b', "inarr", nil, ints)},
+		choice[node]{1, inRanges},
+		choice[node]{1, nodeOf('b', "quant", []string{"all", "any", "none"}, ints)},
+		choice[node]{2, nodeOf('b', "cond", nil, bools, bools, bools)},
+	)
+}
+
+// treesTo is a typed expression of any type, of depth one to maxDepth;
+// under HEGEL_NO_KNOWN=1 one tree in twelve is a `let` at the root, the
+// only place a binding prints right (expr/3).
+func treesTo(maxDepth int) hegel.Generator[node] {
+	depths := hegel.Integers(1, maxDepth)
+	any := hegel.FlatMap(depths, anyAt)
+	rootLets := hegel.FlatMap(depths, func(d int) hegel.Generator[node] { return lets(intAt(d-1), intAt(d-1)) })
+	return shaped(any, weighted(choice[node]{92, any}, choice[node]{8, rootLets}))
+}
+
+var (
+	trees       = treesTo(4)
+	optionTrees = treesTo(3)
+)
+
+// realiser renders a tree over an environment; the counter numbers the
+// `let` names, which cannot be redeclared in a nested scope.
+type realiser struct {
+	e    modelEnv
+	lets int
+}
+
+// realise renders the tree's source and computes the model's value.
+func realise(n node, e modelEnv) gen {
+	r := &realiser{e: e}
+	return r.gen(n)
+}
+
+// render is the source of a tree (the values of an empty environment are
+// never read for it).
+func render(n node) string { return realise(n, modelEnv{}).src }
+
+func absInt(i int) int {
+	if i < 0 {
+		return -i
+	}
+	return i
+}
+
+// gen realises a node; a constant `% 0` anywhere below it is a compile
+// error under the optimizer (fold).
+func (r *realiser) gen(n node) gen {
+	args := make([]gen, len(n.args))
+	for i, a := range n.args {
+		args[i] = r.gen(a)
+	}
+	g := r.node(n, args)
+	if n.kind != "int(str)" { // its argument is rendered as a literal, not as source
+		for _, a := range args {
+			g.fold = g.fold || a.fold
+		}
+	}
+	return g
+}
+
+// above: the elements of arr the predicate `# > bound` keeps.
+func (e modelEnv) above(bound int) []int {
+	var kept []int
+	for _, x := range e.arr {
+		if x > bound {
+			kept = append(kept, x)
+		}
+	}
+	return kept
+}
+
+func (r *realiser) node(n node, args []gen) gen {
+	e := r.e
+	var a, b, c gen
+	if len(args) > 0 {
+		a = args[0]
+	}
+	if len(args) > 1 {
+		b = args[1]
+	}
+	if len(args) > 2 {
+		c = args[2]
+	}
+	bin := func(op string, v val) gen {
+		return gen{src: "(" + a.src + " " + op + " " + b.src + ")", v: v, err: a.err || b.err}
+	}
+	call := func(name string, v val) gen { return gen{src: name + "(" + a.src + ")", v: v, err: a.err} }
+	// predicate: a builtin over arr whose predicate holds a; the predicate
+	// runs only when arr has elements, so a's runtime error is one only then.
+	predicate := func(src string, v val) gen { return gen{src: src, v: v, err: a.err && len(e.arr) > 0} }
+	switch n.kind {
+	case "lit":
+		return gen{src: lit(n.v), v: n.v, constant: n.typ == 'i'}
+	case "var":
+		switch n.v.s {
+		case "i":
+			return gen{src: "i", v: vi(e.i)}
+		case "k":
+			return gen{src: "k", v: vi(e.k)}
+		case "len(arr)":
+			return gen{src: "len(arr)", v: vi(len(e.arr))}
+		case "len(s)":
+			return gen{src: "len(s)", v: vi(utf8.RuneCountInString(e.s))}
+		case "f":
+			return gen{src: "f", v: vf(e.f)}
+		case "s":
+			return gen{src: "s", v: vs(e.s)}
+		}
+		return gen{src: "t", v: vs(e.t)}
+	case "arith":
+		var g gen
+		switch n.op {
+		case "+":
+			g = bin("+", vi(a.v.i+b.v.i))
+		case "-":
+			g = bin("-", vi(a.v.i-b.v.i))
+		case "*":
+			g = bin("*", vi(a.v.i*b.v.i))
+		default:
+			g = bin("%", val{})
+			if b.v.i == 0 {
+				g.err = true // "integer divide by zero"
+				g.fold = a.constant && b.constant
+				return g
+			} else if a.v.i == math.MinInt && b.v.i == -1 {
+				g.v = vi(0) // Go: MinInt % -1 == 0
+			} else {
+				g.v = vi(a.v.i % b.v.i)
+			}
+		}
+		g.constant = a.constant && b.constant
+		return g
+	case "neg":
+		if n.typ == 'i' {
+			return gen{src: "(-" + a.src + ")", v: vi(-a.v.i), err: a.err, constant: a.constant}
+		}
+		return gen{src: "(-" + a.src + ")", v: vf(-a.v.f), err: a.err}
+	case "abs":
+		return call("abs", vi(absInt(a.v.i)))
+	case "minmax":
+		v := min(a.v.i, b.v.i)
+		if n.op == "max" {
+			v = max(a.v.i, b.v.i)
+		}
+		return gen{src: n.op + "(" + a.src + ", " + b.src + ")", v: vi(v), err: a.err || b.err}
+	case "cond":
+		g := gen{src: "(" + a.src + " ? " + b.src + " : " + c.src + ")"}
+		if a.v.b {
+			g.v, g.err = b.v, a.err || b.err
+		} else {
+			g.v, g.err = c.v, a.err || c.err
+		}
+		return g
+	case "int(str)":
+		// int(string) of a decimal literal string
+		return gen{src: "int(" + strconv.Quote(strconv.Itoa(a.v.i)) + ")", v: vi(a.v.i)}
+	case "count":
+		// the count of array elements above a bound
+		return predicate("count(arr, # > "+a.src+")", vi(len(e.above(a.v.i))))
+	case "nfilter":
+		return predicate("len(filter(arr, # > "+a.src+"))", vi(len(e.above(a.v.i))))
+	case "sum":
+		// the sum of the elements, each plus a
+		s := 0
+		for _, x := range e.arr {
+			s += x + a.v.i
+		}
+		return predicate("sum(arr, # + "+a.src+")", vi(s))
+	case "quant":
+		kept := len(e.above(a.v.i))
+		var v bool
+		switch n.op {
+		case "all":
+			v = kept == len(e.arr)
+		case "any":
+			v = kept > 0
+		default:
+			v = kept == 0
+		}
+		return predicate(n.op+"(arr, # > "+a.src+")", vb(v))
+	case "let":
+		r.lets++
+		x := fmt.Sprintf("x%d", r.lets)
+		return gen{src: "(let " + x + " = " + a.src + "; " + x + " + " + b.src + ")", v: vi(a.v.i + b.v.i), err: a.err || b.err}
+	case "div":
+		return bin("/", vf(a.v.num()/b.v.num()))
+	case "pow":
+		return bin(n.op, vf(math.Pow(a.v.num(), b.v.num())))
+	case "farith":
+		switch n.op {
+		case "+":
+			return bin("+", vf(a.v.f+b.v.num()))
+		case "-":
+			return bin("-", vf(a.v.f-b.v.num()))
+		}
+		return bin("*", vf(a.v.f*b.v.num()))
+	case "float":
+		return call("float", vf(float64(a.v.i)))
+	case "round":
+		switch n.op {
+		case "ceil":
+			return call("ceil", vf(math.Ceil(a.v.f)))
+		case "floor":
+			return call("floor", vf(math.Floor(a.v.f)))
+		}
+		return call("round", vf(math.Round(a.v.f)))
+	case "concat":
+		return bin("+", vs(a.v.s+b.v.s))
+	case "case":
+		switch n.op {
+		case "upper":
+			return call("upper", vs(strings.ToUpper(a.v.s)))
+		case "lower":
+			return call("lower", vs(strings.ToLower(a.v.s)))
+		}
+		return call("trim", vs(strings.TrimSpace(a.v.s)))
+	case "string":
+		return call("string", vs(strconv.Itoa(a.v.i)))
+	case "repeat":
+		return gen{src: "repeat(" + a.src + ", " + strconv.Itoa(n.lo) + ")", v: vs(strings.Repeat(a.v.s, n.lo)), err: a.err}
+	case "cmp":
+		var r bool
+		if a.v.kind == 'i' && b.v.kind == 'i' {
+			r = cmpInt(n.op, a.v.i, b.v.i)
+		} else {
+			r = cmpFloat(n.op, a.v.num(), b.v.num())
+		}
+		return bin(n.op, vb(r))
+	case "strcmp":
+		var r bool
+		switch n.op {
+		case "==":
+			r = a.v.s == b.v.s
+		case "!=":
+			r = a.v.s != b.v.s
+		case "contains":
+			r = strings.Contains(a.v.s, b.v.s)
+		case "startsWith":
+			r = strings.HasPrefix(a.v.s, b.v.s)
+		default:
+			r = strings.HasSuffix(a.v.s, b.v.s)
+		}
+		return bin(n.op, vb(r))
+	case "logic":
+		switch n.op {
+		case "and", "&&":
+			return gen{src: "(" + a.src + " " + n.op + " " + b.src + ")", v: vb(a.v.b && b.v.b), err: a.err || (a.v.b && b.err)}
+		}
+		return gen{src: "(" + a.src + " " + n.op + " " + b.src + ")", v: vb(a.v.b || b.v.b), err: a.err || (!a.v.b && b.err)}
+	case "not":
+		return gen{src: n.op + a.src, v: vb(!a.v.b), err: a.err}
+	case "inarr":
+		in := false
+		for _, x := range e.arr {
+			if x == a.v.i {
+				in = true
+			}
+		}
+		return gen{src: "(" + a.src + " in arr)", v: vb(in), err: a.err}
+	case "inrange":
+		in := n.lo <= a.v.i && a.v.i <= n.hi
+		return gen{src: "(" + a.src + " in " + lit(vi(n.lo)) + ".." + lit(vi(n.hi)) + ")", v: vb(in), err: a.err}
+	}
+	panic("realise: " + n.kind)
+}
+
+func cmpInt(op string, a, b int) bool {
+	switch op {
+	case "==":
+		return a == b
+	case "!=":
+		return a != b
+	case "<":
+		return a < b
+	case "<=":
+		return a <= b
+	case ">":
+		return a > b
+	}
+	return a >= b
+}
+
+func cmpFloat(op string, a, b float64) bool {
+	switch op {
+	case "==":
+		return a == b
+	case "!=":
+		return a != b
+	case "<":
+		return a < b
+	case "<=":
+		return a <= b
+	case ">":
+		return a > b
+	}
+	return a >= b
+}
+
+// ---------------------------------------------------------------------------
+// The upstream fuzz corpus and its environment.
+
+// corpus is the upstream fuzz corpus, one expression per line.
+var corpus = func() []string {
+	b, err := os.ReadFile("test/fuzz/fuzz_corpus.txt")
+	if err != nil {
+		panic(fmt.Sprintf("fuzz corpus: %v", err))
+	}
+	var lines []string
+	for _, line := range strings.Split(strings.TrimSpace(string(b)), "\n") {
+		if line != "" {
+			lines = append(lines, line)
+		}
+	}
+	return lines
+}()
+
+// timeDependent: sources whose value changes between two runs.
+func timeDependent(src string) bool {
+	return strings.Contains(src, "now(") || strings.Contains(src, "date(") || strings.Contains(src, "duration(") || strings.Contains(src, "timezone(")
+}
+
+// pieces are the fragments an edit inserts or substitutes.
+var pieces = []string{" ", "(", ")", "[", "]", "{", "}", ",", ".", "?.", "??", "?", ":", ";", "#", "$env", "|", "+", "-", "*", "/", "%", "**", "==", "!=", "<", ">=", "not ", " and ", " or ", " in ", "..", "nil", "true", "1", "0.5", "'x'", "\"y\"", "i", "f64", "array", "list", "foo", "ok", "let x = 1; ", "if true { 1 } else { 2 }", "\\", "`", "\n", "//", "/*", "0x", "1e", "b'z'", "..."}
+
+// edit is one small change of a source: a piece inserted at a position, the
+// rune there deleted or replaced by a piece, or a fragment of another corpus
+// line spliced in. Positions are taken modulo the live length when applied.
+type edit struct {
+	kind       string // insert, delete, replace, splice
+	at         int
+	piece      string
+	other      int // the corpus line a splice takes its fragment from
+	from, span int // the fragment: from modulo the line's length plus one, span modulo what is left
+}
+
+var (
+	positions = evenly(256)
+	lines     = evenly(len(corpus))
+	inserts   = hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{kind: "insert", at: hegel.Draw(tc, positions), piece: hegel.Draw(tc, hegel.SampledFrom(pieces))}
+	})
+	deletes  = hegel.Map(positions, func(at int) edit { return edit{kind: "delete", at: at} })
+	replaces = hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{kind: "replace", at: hegel.Draw(tc, positions), piece: hegel.Draw(tc, hegel.SampledFrom(pieces))}
+	})
+	splices = hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{kind: "splice", at: hegel.Draw(tc, positions), other: hegel.Draw(tc, lines), from: hegel.Draw(tc, positions), span: hegel.Draw(tc, positions)}
+	})
+	edits = hegel.OneOf(inserts, deletes, replaces, splices)
+)
+
+// mutate applies the edits to the source; an edit whose result does not
+// fit (fits, nil for any) is a no-op.
+func mutate(src string, edits []edit, fits func(string) bool) string {
+	for _, ed := range edits {
+		if next := apply(src, ed); fits == nil || fits(next) {
+			src = next
+		}
+	}
+	return src
+}
+
+// apply is the source with the edit made.
+func apply(src string, ed edit) string {
+	rs := []rune(src)
+	pos := ed.at % (len(rs) + 1)
+	switch ed.kind {
+	case "insert":
+		rs = slices.Insert(rs, pos, []rune(ed.piece)...)
+	case "delete":
+		if pos < len(rs) {
+			rs = slices.Delete(rs, pos, pos+1)
+		}
+	case "replace":
+		if pos < len(rs) {
+			rs = slices.Replace(rs, pos, pos+1, []rune(ed.piece)...)
+		}
+	default:
+		other := []rune(corpus[ed.other%len(corpus)])
+		a := ed.from % (len(other) + 1)
+		b := a + ed.span%(len(other)-a+1)
+		rs = slices.Insert(rs, pos, other[a:b]...)
+	}
+	return string(rs)
+}
+
+// corpusCase is a corpus line and the edits made to it.
+type corpusCase struct {
+	line  int
+	edits []edit
+}
+
+// source is the line with every edit made; sourceWhere keeps only the
+// edits whose result fits.
+func (c corpusCase) source() string { return mutate(corpus[c.line], c.edits, nil) }
+func (c corpusCase) sourceWhere(fits func(string) bool) string {
+	return mutate(corpus[c.line], c.edits, fits)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c corpusCase) GoString() string {
+	if len(c.edits) == 0 {
+		return fmt.Sprintf("%q", c.source())
+	}
+	return fmt.Sprintf("%q (line %d %q with %d edits)", c.source(), c.line, corpus[c.line], len(c.edits))
+}
+
+// corpusCasesOf: a corpus line, mutated pct percent of the time by one or
+// two edits.
+func corpusCasesOf(pct int) hegel.Generator[corpusCase] {
+	return hegel.Composite(func(tc hegel.TestCase) corpusCase {
+		return corpusCase{line: hegel.Draw(tc, lines), edits: hegel.Draw(tc, maybe(pct, many(edits, 1, 2)))}
+	})
+}
+
+// parses: parser.Parse accepts the source.
+func parses(src string) bool {
+	_, err := parser.Parse(src)
+	return err == nil
+}
+
+// upstreamAccepted: the runtime errors upstream's fuzz test skips as expected.
+var upstreamAccepted = []*regexp.Regexp{
+	regexp.MustCompile(`cannot fetch .* from .*`),
+	regexp.MustCompile(`cannot get .* from .*`),
+	regexp.MustCompile(`cannot slice`),
+	regexp.MustCompile(`slice index out of range`),
+	regexp.MustCompile(`error parsing regexp`),
+	regexp.MustCompile(`integer divide by zero`),
+	regexp.MustCompile(`interface conversion`),
+	regexp.MustCompile(`invalid argument`),
+	regexp.MustCompile(`invalid character`),
+	regexp.MustCompile(`invalid operation`),
+	regexp.MustCompile(`invalid duration`),
+	regexp.MustCompile(`time: missing unit in duration`),
+	regexp.MustCompile(`time: unknown unit .* in duration`),
+	regexp.MustCompile(`unknown time zone`),
+	regexp.MustCompile(`invalid location name`),
+	regexp.MustCompile(`json: unsupported value`),
+	regexp.MustCompile(`json: unsupported type`),
+	regexp.MustCompile(`json: cannot unmarshal .* into Go value of type .*`),
+	regexp.MustCompile(`unexpected end of JSON input`),
+	regexp.MustCompile(`memory budget exceeded`),
+	regexp.MustCompile(`using interface \{} as type .*`),
+	regexp.MustCompile(`reflect.Value.MapIndex: value of type .* is not assignable to type .*`),
+	regexp.MustCompile(`reflect: Call using .* as type .*`),
+	regexp.MustCompile(`reflect: cannot use .* as type .* in .*`),
+	regexp.MustCompile(`reflect: Call with too few input arguments`),
+	regexp.MustCompile(`invalid number of arguments`),
+	regexp.MustCompile(`reflect: call of reflect.Value.Call on .* Value`),
+	regexp.MustCompile(`reflect: call of reflect.Value.Index on map Value`),
+	regexp.MustCompile(`reflect: call of reflect.Value.Len on .* Value`),
+	regexp.MustCompile(`reflect: string index out of range`),
+	regexp.MustCompile(`strings: negative Repeat count`),
+	regexp.MustCompile(`strings: illegal bytes to escape`),
+	regexp.MustCompile(`invalid date .*`),
+	regexp.MustCompile(`parsing time .*`),
+	regexp.MustCompile(`cannot parse .* as .*`),
+	regexp.MustCompile(`operator "in" not defined on .*`),
+	regexp.MustCompile(`cannot sum .*`),
+	regexp.MustCompile(`index out of range: .* \(array length is .*\)`),
+	regexp.MustCompile(`reduce of empty array with no initial value`),
+	regexp.MustCompile(`cannot use <nil> as argument \(type .*\) to call .*`),
+	regexp.MustCompile(`illegal base64 data at input byte .*`),
+	regexp.MustCompile(`sort order argument must be a string`),
+	regexp.MustCompile(`sortBy order argument must be a string`),
+	regexp.MustCompile(`invalid order .*, expected asc or desc`),
+	regexp.MustCompile(`unknown order, use asc or desc`),
+	regexp.MustCompile(`cannot use .* as a key for groupBy: type is not comparable`),
+}
+
+func accepted(err error) bool {
+	for _, r := range upstreamAccepted {
+		if r.MatchString(err.Error()) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// modelCase: an environment, a typed expression over it, and whether the
+// optimizer is on.
+type modelCase struct {
+	env      modelEnv
+	tree     node
+	optimize bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c modelCase) GoString() string {
+	return fmt.Sprintf("%s\nenv %v optimize %v", render(c.tree), c.env, c.optimize)
+}
+
+var modelCases = hegel.Composite(func(tc hegel.TestCase) modelCase {
+	return modelCase{env: hegel.Draw(tc, envs), tree: hegel.Draw(tc, trees), optimize: hegel.Draw(tc, hegel.Booleans())}
+})
+
+// TestHegelModelAgrees: a typed expression over ints, floats, strings and
+// bools, with variables from the environment, evaluates (optimizer on or
+// off) to the model's value of the model's Go type: ints stay int, `/` and
+// `**` are float64, comparisons across int and float compare numerically,
+// `%` by zero is a runtime error. The optimizer folds `x and false` and `x
+// or true` to the constant, so a `% 0` in x no longer fails (expr/9).
+func TestHegelModelAgrees(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, modelCases)
+		g := realise(c.tree, c.env)
+		wantErr := g.err || (c.optimize && g.fold) // a constant `% 0` is a compile error under the optimizer
+		note(ht, "model: %v (error %v)", g.v, wantErr)
+		got, err := eval(g.src, c.env.env(), c.optimize)
+		if wantErr {
+			if err == nil {
+				mismatch(ht, foldShape(g.src, c.optimize), "%s: model expects an error (integer divide by zero), got %#v (optimize=%v)\nenv %v", g.src, got, c.optimize, c.env)
+			}
+			return
+		}
+		if err != nil {
+			fail(ht, "%s: %v (optimize=%v)\nenv %v\nmodel %v", g.src, err, c.optimize, c.env, g.v)
+		}
+		if !matches(got, g.v) {
+			fail(ht, "%s = %T %#v, model %v (optimize=%v)\nenv %v", g.src, got, got, g.v, c.optimize, c.env)
+		}
+	})
+}
+
+var (
+	corpusCases30 = corpusCasesOf(30)
+	corpusCases40 = corpusCasesOf(40)
+)
+
+// TestHegelOptimizerIsTransparent: a corpus expression (lightly mutated)
+// compiles alike with and without the optimizer and evaluates to the same
+// value, or fails alike. `x and false` and `x or true` fold to the constant
+// with x unevaluated, so an x that fails at run time no longer does (expr/9).
+func TestHegelOptimizerIsTransparent(t *testing.T) {
+	env := fuzz.NewEnv()
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, corpusCases40).source()
+		ht.Assume(!timeDependent(src)) // no corpus line is; an edit could splice one in
+		sh := foldShape(src, true)
+		pOn, errOn := compile(src, env, true, fuzz.Func())
+		pOff, errOff := compile(src, env, false, fuzz.Func())
+		if (errOn == nil) != (errOff == nil) {
+			mismatch(ht, sh, "%q: compiles with optimizer=%v only\n  on:  %v\n  off: %v", src, errOn == nil, errOn, errOff)
+		}
+		if errOn != nil {
+			return // both refuse it alike
+		}
+		vOn, rOn := expr.Run(pOn, env)
+		vOff, rOff := expr.Run(pOff, env)
+		if (rOn == nil) != (rOff == nil) {
+			mismatch(ht, sh, "%q: runs with optimizer=%v only\n  on:  %v %#v\n  off: %v %#v\n%s", src, rOn == nil, rOn, vOn, rOff, vOff, pOn.Disassemble())
+		}
+		if rOn == nil && !sameValue(vOn, vOff) {
+			if mapOrdered(src) {
+				// a map listed in iteration order: the same elements in another
+				// order agree; a value that depends on the order is not judged
+				if sameMultiset(vOn, vOff) {
+					return
+				}
+				ht.Assume(deterministic(pOff, env))
+			}
+			mismatch(ht, sh, "%q: optimizer on = %T %#v, off = %T %#v\n%s", src, vOn, vOn, vOff, vOff, pOn.Disassemble())
+		}
+	})
+}
+
+// staticCorpus: the corpus lines the checker gives a concrete static type
+// (the others, a tenth, are typed any and make no claim), so that the
+// static-type property draws from the lines it can judge.
+var (
+	staticOnce   sync.Once
+	staticLines  []int
+	staticConfig = func() *conf.Config {
+		cfg := conf.New(fuzz.NewEnv())
+		fuzz.Func()(cfg)
+		return cfg
+	}
+)
+
+func staticCorpus() []int {
+	staticOnce.Do(func() {
+		cfg := staticConfig()
+		for i, src := range corpus {
+			tree, err := parser.ParseWithConfig(src, cfg)
+			if err != nil {
+				continue
+			}
+			static, err := checker.Check(tree, cfg)
+			if err != nil || static == nil {
+				continue
+			}
+			switch static.Kind() {
+			case reflect.Interface, reflect.Invalid:
+				continue
+			}
+			staticLines = append(staticLines, i)
+		}
+	})
+	return staticLines
+}
+
+// staticCases: a concretely typed corpus line, mutated 30% of the time.
+var staticCases = hegel.Composite(func(tc hegel.TestCase) corpusCase {
+	typed := staticCorpus()
+	return corpusCase{line: typed[hegel.Draw(tc, evenly(len(typed)))], edits: hegel.Draw(tc, maybe(30, many(edits, 1, 2)))}
+})
+
+// staticallyTyped: the checker gives the source a concrete static type.
+func staticallyTyped(src string) bool {
+	cfg := staticConfig()
+	tree, err := parser.ParseWithConfig(src, cfg)
+	if err != nil {
+		return false
+	}
+	static, err := checker.Check(tree, cfg)
+	if err != nil || static == nil {
+		return false
+	}
+	switch static.Kind() {
+	case reflect.Interface, reflect.Invalid:
+		return false
+	}
+	return true
+}
+
+// TestHegelStaticTypeMatchesRuntime: when the checker gives an expression a
+// concrete type, the value the program produces has that kind (a nil result
+// for a non-nillable kind counts as a mismatch). A finder with nothing to
+// find, first/last of an empty array, get out of range and a conditional
+// with a nil branch are typed as their non-nil type and return nil
+// (expr/1); a seedless reduce over one element is typed as its predicate
+// and returns the element (expr/6), min/max as their first argument
+// (expr/7), a seedless sum as its element type when the array is empty
+// (expr/8).
+func TestHegelStaticTypeMatchesRuntime(t *testing.T) {
+	env := fuzz.NewEnv()
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, staticCases).sourceWhere(staticallyTyped) // an edit that leaves no concrete type is a no-op
+		ht.Assume(!timeDependent(src))
+		cfg := staticConfig()
+		tree, err := parser.ParseWithConfig(src, cfg)
+		if err != nil {
+			ht.Fatalf("%q does not parse: %v", src, err)
+		}
+		static, err := checker.Check(tree, cfg)
+		if err != nil || static == nil {
+			ht.Fatalf("%q does not check: %v", src, err)
+		}
+		sh := staticShapes(tree.Node)
+		note(ht, "static type %v", static)
+		got, err := eval(src, env, false, fuzz.Func())
+		if err != nil {
+			return // a runtime error produces no value
+		}
+		if got == nil {
+			switch static.Kind() {
+			case reflect.Int, reflect.Int64, reflect.Float64, reflect.String, reflect.Bool:
+				sh.add("expr/1", usesFinder(src) || strings.Contains(src, "nil"))
+				mismatch(ht, sh, "%q: static type %v, runtime value nil", src, static)
+			}
+			return
+		}
+		if reflect.TypeOf(got).Kind() != static.Kind() {
+			mismatch(ht, sh, "%q: static type %v (kind %v), runtime %T %#v", src, static, static.Kind(), got, got)
+		}
+	})
+}
+
+// printCase: the source printed and re-parsed: a corpus line (mutated 30%
+// of the time), or a typed expression.
+type printCase struct {
+	line  corpusCase
+	typed bool
+	tree  node
+}
+
+// source: the typed expression's text, or the line with the edits that
+// leave it parseable.
+func (c printCase) source() string {
+	if c.typed {
+		return render(c.tree)
+	}
+	return c.line.sourceWhere(parses)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c printCase) GoString() string {
+	if c.typed {
+		return fmt.Sprintf("%q (typed)", c.source())
+	}
+	return c.line.GoString()
+}
+
+var printCases = weighted(
+	choice[printCase]{70, hegel.Map(corpusCases30, func(c corpusCase) printCase { return printCase{line: c} })},
+	choice[printCase]{30, hegel.Map(trees, func(n node) printCase { return printCase{typed: true, tree: n} })},
+)
+
+// TestHegelPrintedAstReparses: parsing an expression, printing the AST with
+// Node.String() and parsing the print gives the same AST (ast.Dump) — and
+// the same value. An integral float literal prints as an integer (expr/2),
+// a nested `let` or sequence without its parentheses (expr/3), and an
+// operand of `..` that binds looser than `..` bare (expr/5).
+func TestHegelPrintedAstReparses(t *testing.T) {
+	env := fuzz.NewEnv()
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, printCases).source()
+		tree, err := parser.Parse(src)
+		if err != nil {
+			ht.Fatalf("%q does not parse: %v", src, err)
+		}
+		shape := printShapes(tree.Node)
+		printed := tree.Node.String()
+		note(ht, "prints as %q", printed)
+		tree2, err := parser.Parse(printed)
+		if err != nil {
+			mismatch(ht, shape, "%q prints as %q, which does not parse: %v", src, printed, err)
+		}
+		d1, d2 := ast.Dump(tree.Node), ast.Dump(tree2.Node)
+		if d1 != d2 {
+			if timeDependent(src) {
+				mismatch(ht, shape, "%q prints as %q: different AST\n%s\n--- vs ---\n%s", src, printed, d1, d2)
+			}
+			v1, e1 := eval(src, env, false, fuzz.Func())
+			v2, e2 := eval(printed, env, false, fuzz.Func())
+			mismatch(ht, shape, "%q prints as %q: different AST (values %#v/%v vs %#v/%v)\n%s\n--- vs ---\n%s", src, printed, v1, e1, v2, e2, d1, d2)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// The array functions.
+
+// predicate is "# > k" (k the case's) or "# % m == r".
+type predicate struct {
+	mod  bool
+	m, r int
+}
+
+func (p predicate) src(k int) string {
+	if p.mod {
+		return fmt.Sprintf("# %% %d == %d", p.m, p.r)
+	}
+	return fmt.Sprintf("# > %s", lit(vi(k)))
+}
+
+func (p predicate) holds(x, k int) bool {
+	if p.mod {
+		return x%p.m == p.r
+	}
+	return x > k
+}
+
+var predicates = hegel.OneOf(
+	hegel.Just(predicate{}),
+	hegel.Composite(func(tc hegel.TestCase) predicate {
+		m := hegel.Draw(tc, hegel.SampledFrom([]int{2, 3, 5}))
+		return predicate{mod: true, m: m, r: hegel.Draw(tc, hegel.Integers(0, 4)) % m}
+	}),
+)
+
+// arrayCase: an environment, a predicate, the bound k (of `# > k` and of
+// `# * 2 + k`), a take count, the check (an index modulo the checks that
+// apply to the array) and whether the optimizer is on.
+type arrayCase struct {
+	env      modelEnv
+	pred     predicate
+	k, take  int
+	check    int
+	optimize bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c arrayCase) GoString() string {
+	return fmt.Sprintf("%s with arr %v (k %d, optimize %v)", c.pick().src(c), c.env.arr, c.k, c.optimize)
+}
+
+var arrayCases = hegel.Composite(func(tc hegel.TestCase) arrayCase {
+	return arrayCase{
+		env:      hegel.Draw(tc, envs),
+		pred:     hegel.Draw(tc, predicates),
+		k:        hegel.Draw(tc, hegel.Integers(-5, 5)),
+		take:     hegel.Draw(tc, hegel.Integers(0, 8)),
+		check:    hegel.Draw(tc, hegel.Integers(0, 99)),
+		optimize: hegel.Draw(tc, hegel.Booleans()),
+	}
+})
+
+// arrayModel is what the documentation says of the array: the elements the
+// predicate keeps, their first and last index, the sum, the sorted, reversed
+// and deduplicated arrays, the first take elements, the mapped elements.
+type arrayModel struct {
+	arr, kept, sorted, desc, rev, uniq, taken, mapped []int
+	firstIdx, lastIdx, sum, cnt                       int
+}
+
+func (c arrayCase) model() arrayModel {
+	m := arrayModel{arr: c.env.arr, firstIdx: -1, lastIdx: -1}
+	for i, x := range m.arr {
+		if c.pred.holds(x, c.k) {
+			m.kept = append(m.kept, x)
+			if m.firstIdx < 0 {
+				m.firstIdx = i
+			}
+			m.lastIdx = i
+		}
+		m.sum += x
+	}
+	m.cnt = len(m.kept)
+	m.sorted = slices.Sorted(slices.Values(m.arr))
+	m.desc = slices.Clone(m.sorted)
+	slices.Reverse(m.desc)
+	m.rev = slices.Clone(m.arr)
+	slices.Reverse(m.rev)
+	seen := map[int]bool{}
+	for _, x := range m.arr {
+		if !seen[x] {
+			seen[x] = true
+			m.uniq = append(m.uniq, x)
+		}
+	}
+	m.taken = m.arr
+	if c.take < len(m.taken) {
+		m.taken = m.taken[:c.take]
+	}
+	m.mapped = make([]int, len(m.arr))
+	for i, x := range m.arr {
+		m.mapped[i] = x*2 + c.k
+	}
+	return m
+}
+
+// arrayCheck is one documented array function: its source over the case,
+// what the result must be, and whether the array has to be non-empty.
+type arrayCheck struct {
+	src      func(c arrayCase) string
+	want     func(m arrayModel, got any) bool
+	desc     func(m arrayModel) string
+	nonEmpty bool
+}
+
+// fixedSrc, predSrc, mapSrc: a source as given, one with the predicate, one
+// with the bound k.
+func fixedSrc(src string) func(arrayCase) string { return func(arrayCase) string { return src } }
+func predSrc(format string) func(arrayCase) string {
+	return func(c arrayCase) string { return fmt.Sprintf(format, c.pred.src(c.k)) }
+}
+func mapSrc(format string) func(arrayCase) string {
+	return func(c arrayCase) string { return fmt.Sprintf(format, lit(vi(c.k))) }
+}
+
+// intsCheck, intCheck, boolCheck, floatCheck: a function whose result is
+// the ints, the int, the bool, the float the model gives (the floats need a
+// non-empty array).
+func intsCheck(src func(arrayCase) string, f func(arrayModel) []int) arrayCheck {
+	return arrayCheck{src: src, want: func(m arrayModel, g any) bool { return seqOfInts(g, f(m)) }, desc: func(m arrayModel) string { return fmt.Sprint(f(m)) }}
+}
+func intCheck(src func(arrayCase) string, f func(arrayModel) int) arrayCheck {
+	return arrayCheck{src: src, want: func(m arrayModel, g any) bool { return matches(g, vi(f(m))) }, desc: func(m arrayModel) string { return fmt.Sprint(f(m)) }}
+}
+func boolCheck(src func(arrayCase) string, f func(arrayModel) bool) arrayCheck {
+	return arrayCheck{src: src, want: func(m arrayModel, g any) bool { return matches(g, vb(f(m))) }, desc: func(m arrayModel) string { return fmt.Sprint(f(m)) }}
+}
+func floatCheck(src func(arrayCase) string, f func(arrayModel) float64) arrayCheck {
+	return arrayCheck{src: src, want: func(m arrayModel, g any) bool { return matches(g, vf(f(m))) }, desc: func(m arrayModel) string { return fmt.Sprint(f(m)) }, nonEmpty: true}
+}
+
+// nilOrCheck: nil for an empty selection, else the int at the index.
+func nilOrCheck(src func(arrayCase) string, sel func(arrayModel) ([]int, int)) arrayCheck {
+	return arrayCheck{src: src,
+		want: func(m arrayModel, g any) bool {
+			xs, i := sel(m)
+			if len(xs) == 0 {
+				return g == nil
+			}
+			return matches(g, vi(xs[i]))
+		},
+		desc: func(m arrayModel) string {
+			xs, i := sel(m)
+			if len(xs) == 0 {
+				return "nil"
+			}
+			return fmt.Sprint(xs[i])
+		}}
+}
+
+// foundCheck: the found index only (the not-found value of findIndex and
+// findLastIndex is not documented — nil today, typed int by the checker,
+// expr/1 — so only the found case is checked).
+func foundCheck(src func(arrayCase) string, f func(arrayModel) int) arrayCheck {
+	return arrayCheck{src: src, want: func(m arrayModel, g any) bool { return m.cnt == 0 || matches(g, vi(f(m))) }, desc: func(m arrayModel) string { return fmt.Sprint(f(m)) }}
+}
+
+func twice(m arrayModel) []int { return slices.Concat(m.arr, m.arr) }
+func mean(m arrayModel) float64 {
+	return float64(m.sum) / float64(len(m.arr))
+}
+func median(m arrayModel) float64 {
+	s := m.sorted
+	if len(s)%2 == 1 {
+		return float64(s[len(s)/2])
+	}
+	return float64(s[len(s)/2-1]+s[len(s)/2]) / 2
+}
+func joined(m arrayModel) string {
+	parts := make([]string, len(m.arr))
+	for i, x := range m.arr {
+		parts[i] = strconv.Itoa(x)
+	}
+	return strings.Join(parts, ",")
+}
+func sumMapped(m arrayModel) int {
+	s := 0
+	for _, x := range m.mapped {
+		s += x
+	}
+	return s
+}
+
+var arrayChecks = []arrayCheck{
+	intsCheck(predSrc("filter(arr, %s)"), func(m arrayModel) []int { return m.kept }),
+	intsCheck(mapSrc("map(arr, # * 2 + %s)"), func(m arrayModel) []int { return m.mapped }),
+	boolCheck(predSrc("all(arr, %s)"), func(m arrayModel) bool { return m.cnt == len(m.arr) }),
+	boolCheck(predSrc("any(arr, %s)"), func(m arrayModel) bool { return m.cnt > 0 }),
+	boolCheck(predSrc("one(arr, %s)"), func(m arrayModel) bool { return m.cnt == 1 }),
+	boolCheck(predSrc("none(arr, %s)"), func(m arrayModel) bool { return m.cnt == 0 }),
+	intCheck(predSrc("count(arr, %s)"), func(m arrayModel) int { return m.cnt }),
+	intCheck(predSrc("len(filter(arr, %s))"), func(m arrayModel) int { return m.cnt }),
+	foundCheck(predSrc("findIndex(arr, %s)"), func(m arrayModel) int { return m.firstIdx }),
+	foundCheck(predSrc("findLastIndex(arr, %s)"), func(m arrayModel) int { return m.lastIdx }),
+	nilOrCheck(predSrc("find(arr, %s)"), func(m arrayModel) ([]int, int) { return m.kept, 0 }),
+	nilOrCheck(predSrc("findLast(arr, %s)"), func(m arrayModel) ([]int, int) { return m.kept, len(m.kept) - 1 }),
+	nilOrCheck(fixedSrc("first(arr)"), func(m arrayModel) ([]int, int) { return m.arr, 0 }),
+	nilOrCheck(fixedSrc("last(arr)"), func(m arrayModel) ([]int, int) { return m.arr, len(m.arr) - 1 }),
+	intCheck(fixedSrc("sum(arr)"), func(m arrayModel) int { return m.sum }),
+	intCheck(mapSrc("sum(arr, # * 2 + %s)"), sumMapped),
+	intCheck(fixedSrc("reduce(arr, #acc + #, 0)"), func(m arrayModel) int { return m.sum }),
+	intsCheck(fixedSrc("sort(arr)"), func(m arrayModel) []int { return m.sorted }),
+	intsCheck(fixedSrc("sort(arr, \"desc\")"), func(m arrayModel) []int { return m.desc }),
+	intsCheck(fixedSrc("sortBy(arr, #)"), func(m arrayModel) []int { return m.sorted }),
+	intsCheck(fixedSrc("sortBy(arr, -#, \"desc\")"), func(m arrayModel) []int { return m.sorted }),
+	intsCheck(fixedSrc("reverse(arr)"), func(m arrayModel) []int { return m.rev }),
+	intsCheck(fixedSrc("uniq(arr)"), func(m arrayModel) []int { return m.uniq }),
+	intsCheck(func(c arrayCase) string { return "take(arr, " + strconv.Itoa(c.take) + ")" }, func(m arrayModel) []int { return m.taken }),
+	intsCheck(fixedSrc("concat(arr, arr)"), twice),
+	intsCheck(fixedSrc("flatten([arr, [arr]])"), twice),
+	intCheck(fixedSrc("len(arr)"), func(m arrayModel) int { return len(m.arr) }),
+	{src: fixedSrc("join(map(arr, string(#)), \",\")"), want: func(m arrayModel, g any) bool { return matches(g, vs(joined(m))) }, desc: joined},
+	{src: fixedSrc("min(arr)"), want: func(m arrayModel, g any) bool { return matches(g, vi(m.sorted[0])) }, desc: func(m arrayModel) string { return fmt.Sprint(m.sorted[0]) }, nonEmpty: true},
+	{src: fixedSrc("max(arr)"), want: func(m arrayModel, g any) bool { return matches(g, vi(m.sorted[len(m.sorted)-1])) }, desc: func(m arrayModel) string { return fmt.Sprint(m.sorted[len(m.sorted)-1]) }, nonEmpty: true},
+	floatCheck(fixedSrc("mean(arr)"), mean),
+	floatCheck(fixedSrc("median(arr)"), median),
+}
+
+// pick is the check the case names: its index modulo the checks that apply
+// to the array (the empty array has no min, max, mean or median).
+func (c arrayCase) pick() arrayCheck {
+	var applicable []arrayCheck
+	for _, ck := range arrayChecks {
+		if !ck.nonEmpty || len(c.env.arr) > 0 {
+			applicable = append(applicable, ck)
+		}
+	}
+	return applicable[c.check%len(applicable)]
+}
+
+// TestHegelArrayFunctionsAgree: the array functions over an int array with
+// simple predicates give what the documentation says (a Go model).
+func TestHegelArrayFunctionsAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, arrayCases)
+		ck := c.pick()
+		src, m := ck.src(c), c.model()
+		note(ht, "want %s", ck.desc(m))
+		got, err := eval(src, c.env.env(), c.optimize)
+		if err != nil {
+			fail(ht, "%s with arr %v: %v (optimize=%v); want %s", src, c.env.arr, err, c.optimize, ck.desc(m))
+		}
+		if !ck.want(m, got) {
+			fail(ht, "%s with arr %v = %T %#v (optimize=%v); want %s", src, c.env.arr, got, got, c.optimize, ck.desc(m))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// The string functions.
+
+// strCase: a string, a needle (a string of its own, or 40% of the time a
+// real substring at a and b taken modulo the string's length), a count, the
+// check and whether the optimizer is on.
+type strCase struct {
+	s, sub   string
+	fromS    bool
+	a, b     int
+	k        int
+	check    int
+	optimize bool
+}
+
+func (c strCase) needle() string {
+	rs := []rune(c.s)
+	if !c.fromS || len(rs) == 0 {
+		return c.sub
+	}
+	a := c.a % (len(rs) + 1)
+	b := a + c.b%(len(rs)-a+1)
+	return string(rs[a:b])
+}
+
+// source is the check's source with the count written in.
+func (c strCase) source() string {
+	return strings.ReplaceAll(strChecks[c.check].src, "{k}", strconv.Itoa(c.k))
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c strCase) GoString() string {
+	return fmt.Sprintf("%s with s=%q sub=%q (optimize %v)", c.source(), c.s, c.needle(), c.optimize)
+}
+
+var strCases = hegel.Composite(func(tc hegel.TestCase) strCase {
+	return strCase{
+		s:        hegel.Draw(tc, textOf(string(runes), 8)),
+		sub:      hegel.Draw(tc, textOf(string(runes), 2)),
+		fromS:    hegel.Draw(tc, chance(40)),
+		a:        hegel.Draw(tc, hegel.Integers(0, 8)),
+		b:        hegel.Draw(tc, hegel.Integers(0, 8)),
+		k:        hegel.Draw(tc, hegel.Integers(0, 3)),
+		check:    hegel.Draw(tc, hegel.Integers(0, len(strChecks)-1)),
+		optimize: hegel.Draw(tc, hegel.Booleans()),
+	}
+})
+
+// strCheck is one string builtin: its source over s, sub and k, and what
+// the Go strings package says.
+type strCheck struct {
+	src  string
+	want func(s, sub string, k int) any
+}
+
+var strChecks = []strCheck{
+	{"trim(s)", func(s, sub string, k int) any { return strings.TrimSpace(s) }},
+	{"trim(s, sub)", func(s, sub string, k int) any { return strings.Trim(s, sub) }},
+	{"trimPrefix(s, sub)", func(s, sub string, k int) any { return strings.TrimPrefix(s, sub) }},
+	{"trimSuffix(s, sub)", func(s, sub string, k int) any { return strings.TrimSuffix(s, sub) }},
+	{"upper(s)", func(s, sub string, k int) any { return strings.ToUpper(s) }},
+	{"lower(s)", func(s, sub string, k int) any { return strings.ToLower(s) }},
+	{"replace(s, sub, \"_\")", func(s, sub string, k int) any { return strings.ReplaceAll(s, sub, "_") }},
+	{"repeat(sub, {k})", func(s, sub string, k int) any { return strings.Repeat(sub, k) }},
+	{"indexOf(s, sub)", func(s, sub string, k int) any { return strings.Index(s, sub) }},
+	{"lastIndexOf(s, sub)", func(s, sub string, k int) any { return strings.LastIndex(s, sub) }},
+	{"hasPrefix(s, sub)", func(s, sub string, k int) any { return strings.HasPrefix(s, sub) }},
+	{"hasSuffix(s, sub)", func(s, sub string, k int) any { return strings.HasSuffix(s, sub) }},
+	{"s startsWith sub", func(s, sub string, k int) any { return strings.HasPrefix(s, sub) }},
+	{"s endsWith sub", func(s, sub string, k int) any { return strings.HasSuffix(s, sub) }},
+	{"s contains sub", func(s, sub string, k int) any { return strings.Contains(s, sub) }},
+	{"s + sub", func(s, sub string, k int) any { return s + sub }},
+	{"len(s)", func(s, sub string, k int) any { return utf8.RuneCountInString(s) }}, // len counts runes (the docs' "length of a string")
+	{"split(s, sub)", func(s, sub string, k int) any { return strings.Split(s, sub) }},
+	{"splitAfter(s, sub)", func(s, sub string, k int) any { return strings.SplitAfter(s, sub) }},
+	{"split(s, sub, {k})", func(s, sub string, k int) any { return strings.SplitN(s, sub, k) }},
+	{"splitAfter(s, sub, {k})", func(s, sub string, k int) any { return strings.SplitAfterN(s, sub, k) }},
+	{"join(split(s, sub), sub)", func(s, sub string, k int) any { return s }},
+	{"toBase64(s)", func(s, sub string, k int) any { return base64.StdEncoding.EncodeToString([]byte(s)) }},
+	{"fromBase64(toBase64(s))", func(s, sub string, k int) any { return s }},
+}
+
+// TestHegelStringFunctionsAgree: the string builtins behave as the
+// documentation says, which is the Go strings package.
+func TestHegelStringFunctionsAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, strCases)
+		s, sub, ck, src := c.s, c.needle(), strChecks[c.check], c.source()
+		env := map[string]any{"s": s, "sub": sub}
+		want := ck.want(s, sub, c.k)
+		note(ht, "want %#v", want)
+		got, err := eval(src, env, c.optimize)
+		if err != nil {
+			fail(ht, "%s with s=%q sub=%q: %v (optimize=%v); want %#v", src, s, sub, err, c.optimize, want)
+		}
+		if want, ok := want.([]string); ok {
+			if !sameStrings(got, want) {
+				fail(ht, "%s with s=%q sub=%q = %T %#v (optimize=%v); want %#v", src, s, sub, got, got, c.optimize, want)
+			}
+			return
+		}
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "%s with s=%q sub=%q = %T %#v (optimize=%v); want %T %#v", src, s, sub, got, got, c.optimize, want, want)
+		}
+	})
+}
+
+// sameStrings: a []string, or a []any of strings, equal to want.
+func sameStrings(got any, want []string) bool {
+	v := reflect.ValueOf(got)
+	if !v.IsValid() || v.Kind() != reflect.Slice || v.Len() != len(want) {
+		return false
+	}
+	for i := range want {
+		s, ok := v.Index(i).Interface().(string)
+		if !ok || s != want[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// JSON-like values for the conversion functions.
+
+var (
+	jsonKeys = textOf(string(runes), 3)
+	// jsonScalars: nil, a bool, a number with a binary fraction, a string, an
+	// integral number.
+	jsonScalars = hegel.OneOf(
+		hegel.Just[any](nil),
+		hegel.Map(hegel.Booleans(), func(b bool) any { return b }),
+		hegel.Composite(func(tc hegel.TestCase) any {
+			return float64(hegel.Draw(tc, hegel.Integers(-1000, 1000))) / hegel.Draw(tc, hegel.SampledFrom([]float64{1, 4, 8}))
+		}),
+		hegel.Map(textOf(string(runes), 6), func(s string) any { return s }),
+		hegel.Map(hegel.Integers(-100000, 100000), func(n int) any { return float64(n) }),
+	)
+)
+
+// jsonValuesTo is a JSON value up to maxDepth containers deep: a scalar, or
+// (60% of the time while depth allows) a list or a map of up to four
+// members drawn from the same generator (a depth counter in the closure
+// bounds the recursion; deferred back so an aborted draw cannot leave it
+// stale).
+func jsonValuesTo(maxDepth int) hegel.Generator[any] {
+	depth := 0
+	var values hegel.Generator[any]
+	lists := hegel.Composite(func(tc hegel.TestCase) any { return nonNil(hegel.Draw(tc, hegel.Lists(values).MaxSize(4))) })
+	maps := hegel.Composite(func(tc hegel.TestCase) any {
+		m := hegel.Draw(tc, hegel.Maps(jsonKeys, values).MaxSize(4))
+		if m == nil {
+			m = map[string]any{}
+		}
+		return m
+	})
+	containers := hegel.OneOf(lists, maps)
+	nodes := weighted(choice[any]{40, jsonScalars}, choice[any]{60, containers})
+	values = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, jsonScalars)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, nodes)
+	})
+	return values
+}
+
+// convCase: one of the conversion checks: toJSON/fromJSON of a value,
+// toPairs/fromPairs of a map, the int conversions of an int, the float
+// conversions of a float, or type() of a literal.
+type convCase struct {
+	kind     string // json, pairs, int, float, type
+	v        any
+	m        map[string]any
+	i        int
+	f        float64
+	check    int
+	optimize bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c convCase) GoString() string {
+	switch c.kind {
+	case "json":
+		return fmt.Sprintf("toJSON(v) with v = %#v", c.v)
+	case "pairs":
+		return fmt.Sprintf("fromPairs(toPairs(m)) with m = %#v", c.m)
+	case "int":
+		return fmt.Sprintf("%s with i = %d", intConversions[c.check].src, c.i)
+	case "float":
+		return fmt.Sprintf("%s with f = %v", floatConversions[c.check].src, c.f)
+	}
+	return fmt.Sprintf("%s (optimize %v)", typeNames[c.check].src, c.optimize)
+}
+
+var (
+	jsonValues = jsonValuesTo(3)
+	jsonMaps   = hegel.Map(hegel.Maps(jsonKeys, jsonValuesTo(1)).MaxSize(5), func(m map[string]any) map[string]any {
+		if m == nil {
+			return map[string]any{}
+		}
+		return m
+	})
+	convInts   = hegel.OneOf(hegel.SampledFrom([]int{0, 1, -1, 42, math.MaxInt, math.MinInt}), hegel.Integers(-1000000, 1000000))
+	convFloats = hegel.OneOf(hegel.SampledFrom([]float64{0.0, 0.5, -1.25, 1e21, 1e-7, 123.456}), hegel.Map(hegel.Integers(-1000, 1000), func(n int) float64 { return float64(n) / 8 }))
+	convCases  = hegel.OneOf(
+		hegel.Map(jsonValues, func(v any) convCase { return convCase{kind: "json", v: v} }),
+		hegel.Map(jsonMaps, func(m map[string]any) convCase { return convCase{kind: "pairs", m: m} }),
+		hegel.Composite(func(tc hegel.TestCase) convCase {
+			return convCase{kind: "int", i: hegel.Draw(tc, convInts), check: hegel.Draw(tc, hegel.Integers(0, len(intConversions)-1))}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) convCase {
+			return convCase{kind: "float", f: hegel.Draw(tc, convFloats), check: hegel.Draw(tc, hegel.Integers(0, len(floatConversions)-1))}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) convCase {
+			return convCase{kind: "type", check: hegel.Draw(tc, hegel.Integers(0, len(typeNames)-1)), optimize: hegel.Draw(tc, hegel.Booleans())}
+		}),
+	)
+)
+
+// intConversions, floatConversions: the conversions of i and f and what
+// strconv says; typeNames: type() names the documented kinds.
+var (
+	intConversions = []struct {
+		src  string
+		want func(i int) any
+	}{
+		{"string(i)", func(i int) any { return strconv.Itoa(i) }},
+		{"int(string(i))", func(i int) any { return i }},
+		{"float(i)", func(i int) any { return float64(i) }},
+		{"int(float(i))", func(i int) any { return int(float64(i)) }},
+		{"type(i)", func(i int) any { return "int" }},
+		{"type(string(i))", func(i int) any { return "string" }},
+		{"type(float(i))", func(i int) any { return "float" }},
+	}
+	floatConversions = []struct {
+		src  string // %s is the float's shortest decimal form
+		want func(f float64) any
+	}{
+		{"float(%s)", func(f float64) any { return f }},
+		{"float(string(f))", func(f float64) any { return f }},
+		{"int(f)", func(f float64) any { return int(f) }},
+		{"type(f)", func(f float64) any { return "float" }},
+	}
+	typeNames = []struct{ src, want string }{{"type(nil)", "nil"}, {"type(true)", "bool"}, {"type(1)", "int"}, {"type(1.5)", "float"}, {"type('a')", "string"}, {"type([1])", "array"}, {"type({a: 1})", "map"}}
+)
+
+// TestHegelConversionsRoundTrip: toJSON/fromJSON, toPairs/fromPairs,
+// int/float/string conversions agree with encoding/json and strconv.
+func TestHegelConversionsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, convCases)
+		switch c.kind {
+		case "json":
+			v := c.v
+			env := map[string]any{"v": v}
+			want, err := json.Marshal(v)
+			if err != nil {
+				ht.Fatalf("json: %v", err)
+			}
+			var back any
+			if err := json.Unmarshal(want, &back); err != nil {
+				ht.Fatalf("json: %v", err)
+			}
+			got, err := eval("toJSON(v)", env, true)
+			if err != nil {
+				fail(ht, "toJSON(%#v): %v", v, err)
+			}
+			var gotBack any
+			if s, ok := got.(string); !ok || json.Unmarshal([]byte(s), &gotBack) != nil || !reflect.DeepEqual(gotBack, back) {
+				fail(ht, "toJSON(%#v) = %#v; encoding/json: %s", v, got, want)
+			}
+			rt, err := eval("fromJSON(toJSON(v))", env, true)
+			if err != nil {
+				fail(ht, "fromJSON(toJSON(%#v)): %v", v, err)
+			}
+			if !reflect.DeepEqual(rt, back) {
+				fail(ht, "fromJSON(toJSON(%#v)) = %#v; want %#v", v, rt, back)
+			}
+		case "pairs":
+			m := c.m
+			env := map[string]any{"m": m}
+			got, err := eval("fromPairs(toPairs(m))", env, true)
+			if err != nil {
+				fail(ht, "fromPairs(toPairs(%#v)): %v", m, err)
+			}
+			// fromPairs builds a map[any]any (keys need not be strings); compare the entries
+			if gm, ok := got.(map[any]any); !ok || len(gm) != len(m) || func() bool {
+				for k, v := range m {
+					if gv, ok := gm[k]; !ok || !reflect.DeepEqual(gv, v) {
+						return false
+					}
+				}
+				return true
+			}() == false {
+				fail(ht, "fromPairs(toPairs(%#v)) = %T %#v", m, got, got)
+			}
+			ln, err := eval("len(toPairs(m))", env, true)
+			if err != nil || !matches(ln, vi(len(m))) {
+				fail(ht, "len(toPairs(%#v)) = %#v, %v; want %d", m, ln, err, len(m))
+			}
+		case "int":
+			i, ck := c.i, intConversions[c.check]
+			got, err := eval(ck.src, map[string]any{"i": i}, true)
+			if want := ck.want(i); err != nil || !reflect.DeepEqual(got, want) {
+				fail(ht, "%s with i=%d = %T %#v, %v; want %T %#v", ck.src, i, got, got, err, want, want)
+			}
+		case "float":
+			f, ck := c.f, floatConversions[c.check]
+			src := strings.ReplaceAll(ck.src, "%s", strconv.Quote(strconv.FormatFloat(f, 'g', -1, 64)))
+			got, err := eval(src, map[string]any{"f": f}, true)
+			if want := ck.want(f); err != nil || !reflect.DeepEqual(got, want) {
+				fail(ht, "%s with f=%v = %T %#v, %v; want %T %#v", src, f, got, got, err, want, want)
+			}
+		default:
+			ck := typeNames[c.check]
+			got, err := eval(ck.src, map[string]any{}, c.optimize)
+			if err != nil || got != ck.want {
+				fail(ht, "%s = %#v, %v; want %q", ck.src, got, err, ck.want)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Indexing.
+
+// indexCase: an environment and one of the documented forms: arr[i] (i
+// from either end, in or out of range), arr[a:b] (either bound from the
+// end or omitted), a..b, a map or nil lookup from the table, s[a:b] on an
+// ASCII string, or a pipe; positions are taken modulo the live lengths.
+type indexCase struct {
+	env      modelEnv
+	kind     string // index, slice, range, table, string, pipe
+	raw      int    // index: the offset of i within -L-2..L+2
+	a, b     int    // slice, string: the bounds modulo the length
+	fromEndA bool   // slice: a spelled from the end (when it is inside)
+	fromEndB bool
+	omitA    bool // slice: a omitted (when it is 0)
+	omitB    bool // slice: b omitted (when it is the length)
+	lo, span int  // range: a..b with b = a + span
+	entry    int  // table: the row
+	s        string
+	optimize bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c indexCase) GoString() string {
+	return fmt.Sprintf("%s with arr %v (optimize %v)", c.source(), c.env.arr, c.optimize)
+}
+
+var (
+	indexForms = hegel.OneOf(
+		hegel.Map(hegel.Integers(0, 16), func(raw int) indexCase { return indexCase{kind: "index", raw: raw} }),
+		hegel.Composite(func(tc hegel.TestCase) indexCase {
+			return indexCase{kind: "slice", a: hegel.Draw(tc, hegel.Integers(0, 6)), b: hegel.Draw(tc, hegel.Integers(0, 6)),
+				fromEndA: hegel.Draw(tc, chance(40)), fromEndB: hegel.Draw(tc, chance(40)), omitA: hegel.Draw(tc, chance(30)), omitB: hegel.Draw(tc, chance(30))}
+		}),
+		hegel.Composite(func(tc hegel.TestCase) indexCase {
+			return indexCase{kind: "range", lo: hegel.Draw(tc, hegel.Integers(-5, 5)), span: hegel.Draw(tc, hegel.Integers(0, 8))}
+		}),
+		hegel.Map(hegel.Integers(0, len(lookupTable)-1), func(entry int) indexCase { return indexCase{kind: "table", entry: entry} }),
+		hegel.Composite(func(tc hegel.TestCase) indexCase {
+			return indexCase{kind: "string", s: hegel.Draw(tc, textOf(asciiPrintable, 6)), a: hegel.Draw(tc, hegel.Integers(0, 6)), b: hegel.Draw(tc, hegel.Integers(0, 6))}
+		}),
+		hegel.Just(indexCase{kind: "pipe"}),
+	)
+	indexCases = hegel.Composite(func(tc hegel.TestCase) indexCase {
+		c := hegel.Draw(tc, indexForms)
+		c.env = hegel.Draw(tc, envs)
+		c.optimize = hegel.Draw(tc, hegel.Booleans())
+		return c
+	})
+)
+
+// lookupTable: `in` on maps checks keys; `??` and `?.` on nil; get.
+var lookupTable = []struct {
+	src  string
+	want any
+}{{"'a' in m", true}, {"'z' in m", false}, {"m.a", 1}, {"m['b']", "x"}, {"m?.a", 1}, {"nilmap?.a", nil}, {"nilmap?.a ?? 7", 7}, {"m.a ?? 7", 1}, {"nil ?? 'd'", "d"}, {"get(m, 'zz')", nil}, {"get(arr, 99)", nil}, {"'a' in keys(m)", true}, {"len(keys(m))", 2}, {"len(values(m))", 2}}
+
+// index is i: the raw offset within -L-2..L+2.
+func (c indexCase) index() int { return c.raw%(2*len(c.env.arr)+5) - len(c.env.arr) - 2 }
+
+// bounds: 0 <= a <= b <= n.
+func bounds(a, b, n int) (int, int) {
+	a %= n + 1
+	return a, a + b%(n-a+1)
+}
+
+func (c indexCase) source() string {
+	L := len(c.env.arr)
+	switch c.kind {
+	case "index":
+		return fmt.Sprintf("arr[%s]", lit(vi(c.index())))
+	case "slice":
+		a, b := bounds(c.a, c.b, L)
+		as, bs := strconv.Itoa(a), strconv.Itoa(b)
+		if a > 0 && a < L && c.fromEndA {
+			as = lit(vi(a - L))
+		}
+		if b > 0 && b < L && c.fromEndB {
+			bs = lit(vi(b - L))
+		}
+		if a == 0 && c.omitA {
+			as = ""
+		}
+		if b == L && c.omitB {
+			bs = ""
+		}
+		return fmt.Sprintf("arr[%s:%s]", as, bs)
+	case "range":
+		return fmt.Sprintf("%s..%s", lit(vi(c.lo)), lit(vi(c.lo+c.span)))
+	case "table":
+		return lookupTable[c.entry].src
+	case "string":
+		a, b := bounds(c.a, c.b, len(c.s))
+		return fmt.Sprintf("s[%d:%d]", a, b)
+	}
+	return "arr | filter(# > " + lit(vi(c.env.k)) + ") | len()"
+}
+
+// TestHegelIndexingFollowsTheDocs: element access with negative indices, the
+// slice operator's documented forms, ranges, `in`, `??` and `?.`.
+func TestHegelIndexingFollowsTheDocs(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, indexCases)
+		env := c.env.env()
+		env["m"] = map[string]any{"a": 1, "b": "x"}
+		env["nilmap"] = (map[string]any)(nil)
+		L := len(c.env.arr)
+		src := c.source()
+		switch c.kind {
+		case "index":
+			// arr[i]: in range from either end, or an error
+			i := c.index()
+			got, err := eval(src, env, c.optimize)
+			j := i
+			if j < 0 {
+				j += L
+			}
+			if 0 <= j && j < L {
+				if err != nil || !matches(got, vi(c.env.arr[j])) {
+					fail(ht, "%s with arr %v = %#v, %v; want %d", src, c.env.arr, got, err, c.env.arr[j])
+				}
+			} else if err == nil {
+				fail(ht, "%s with arr %v = %#v, no error; the index is out of range", src, c.env.arr, got)
+			}
+		case "slice":
+			// arr[a:b] with 0 <= a <= b <= len, either given from the end
+			a, b := bounds(c.a, c.b, L)
+			got, err := eval(src, env, c.optimize)
+			if err != nil || !seqOfInts(got, c.env.arr[a:b]) {
+				fail(ht, "%s with arr %v = %#v, %v; want %v (a=%d b=%d len=%d)", src, c.env.arr, got, err, c.env.arr[a:b], a, b, L)
+			}
+		case "range":
+			// a..b is the inclusive range
+			var want []int
+			for x := c.lo; x <= c.lo+c.span; x++ {
+				want = append(want, x)
+			}
+			got, err := eval(src, env, c.optimize)
+			if err != nil || !seqOfInts(got, want) {
+				fail(ht, "%s = %#v, %v; want %v", src, got, err, want)
+			}
+			got, err = eval("len("+src+")", env, c.optimize)
+			if err != nil || !matches(got, vi(len(want))) {
+				fail(ht, "len(%s) = %#v, %v; want %d", src, got, err, len(want))
+			}
+		case "table":
+			want := lookupTable[c.entry].want
+			got, err := eval(src, env, c.optimize)
+			if err != nil || !reflect.DeepEqual(got, want) {
+				fail(ht, "%s = %T %#v, %v; want %T %#v", src, got, got, err, want, want)
+			}
+		case "string":
+			// string indexing/slicing on ASCII strings follows the array rules (bytes)
+			env["s"] = c.s
+			a, b := bounds(c.a, c.b, len(c.s))
+			got, err := eval(src, env, c.optimize)
+			if err != nil || got != c.s[a:b] {
+				fail(ht, "%s with s=%q = %#v, %v; want %q", src, c.s, got, err, c.s[a:b])
+			}
+		default:
+			// pipes: x | f(args) == f(x, args)
+			cnt := 0
+			for _, x := range c.env.arr {
+				if x > c.env.k {
+					cnt++
+				}
+			}
+			got, err := eval(src, env, c.optimize)
+			if err != nil || !matches(got, vi(cnt)) {
+				fail(ht, "%s with arr %v = %#v, %v; want %d", src, c.env.arr, got, err, cnt)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Options.
+
+// countNodes counts the AST nodes of a parsed expression.
+type nodeCounter struct{ count int }
+
+func (c *nodeCounter) Visit(node *ast.Node) { c.count++ }
+
+// asOption is one of the As* options: the kinds of model value it accepts
+// and the value it gives for one.
+type asOption struct {
+	name string
+	opt  expr.Option
+	ok   func(val) bool
+	want func(val) any
+}
+
+func isNum(v val) bool { return v.kind == 'i' || v.kind == 'f' }
+
+// docs/configuration.md: AsInt/AsInt64 cast other numbers to int/int64,
+// AsFloat64 casts (the checker admits any number), AsBool/AsKind demand the kind.
+var asOptions = []asOption{
+	{"AsInt", expr.AsInt(), isNum, func(v val) any {
+		if v.kind == 'i' {
+			return v.i
+		}
+		return int(v.f)
+	}},
+	{"AsInt64", expr.AsInt64(), isNum, func(v val) any {
+		if v.kind == 'i' {
+			return int64(v.i)
+		}
+		return int64(v.f)
+	}},
+	{"AsFloat64", expr.AsFloat64(), isNum, func(v val) any { return v.num() }},
+	{"AsBool", expr.AsBool(), func(v val) bool { return v.kind == 'b' }, func(v val) any { return v.b }},
+	{"AsKind(String)", expr.AsKind(reflect.String), func(v val) bool { return v.kind == 's' }, func(v val) any { return v.s }},
+}
+
+// builtinNames: the builtins DisableBuiltin is tried with; count, sum,
+// filter, all, any and none are predicate builtins (the shape of expr/4),
+// left out under HEGEL_NO_KNOWN=1.
+var builtinNames = shaped(
+	[]string{"len", "abs", "min", "max", "upper", "lower", "trim", "count", "repeat", "int", "float", "string", "ceil", "floor", "round", "sum", "filter", "all", "any", "none"},
+	[]string{"len", "abs", "min", "max", "upper", "lower", "trim", "repeat", "int", "float", "string", "ceil", "floor", "round"},
+)
+
+var undefinedTable = []struct {
+	src  string
+	want any
+}{{"undefinedName == nil", true}, {"undefinedName ?? 3", 3}, {"undefinedName", nil}}
+
+// optionCase: an environment, a typed expression, and the option checked:
+// one of the As* options; MaxNodes with a limit around the node count
+// (raw, modulo count+2); DisableBuiltin of a name the expression uses or
+// one it does not (which: even picks a used name when there is one, odd an
+// unused one); AllowUndefinedVariables on a row of the table.
+type optionCase struct {
+	env      modelEnv
+	tree     node
+	kind     string // as, maxNodes, disable, undefined
+	as       int
+	raw      int
+	which    int
+	entry    int
+	optimize bool
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c optionCase) GoString() string {
+	src := render(c.tree)
+	switch c.kind {
+	case "as":
+		return fmt.Sprintf("%s under %s (optimize %v)\nenv %v", src, asOptions[c.as].name, c.optimize, c.env)
+	case "maxNodes":
+		return fmt.Sprintf("%s under MaxNodes(%d)\nenv %v", src, c.limit(), c.env)
+	case "disable":
+		return fmt.Sprintf("%s under DisableBuiltin(%q) (optimize %v)\nenv %v", src, c.disabled(), c.optimize, c.env)
+	}
+	return fmt.Sprintf("%s with AllowUndefinedVariables (optimize %v)", undefinedTable[c.entry].src, c.optimize)
+}
+
+var (
+	optionForms = hegel.OneOf(
+		hegel.Map(hegel.Integers(0, len(asOptions)-1), func(as int) optionCase { return optionCase{kind: "as", as: as} }),
+		hegel.Map(hegel.Integers(0, 99), func(raw int) optionCase { return optionCase{kind: "maxNodes", raw: raw} }),
+		hegel.Map(hegel.Integers(0, 99), func(which int) optionCase { return optionCase{kind: "disable", which: which} }),
+		hegel.Map(hegel.Integers(0, len(undefinedTable)-1), func(entry int) optionCase { return optionCase{kind: "undefined", entry: entry} }),
+	)
+	optionCases = hegel.Composite(func(tc hegel.TestCase) optionCase {
+		c := hegel.Draw(tc, optionForms)
+		c.env = hegel.Draw(tc, envs)
+		c.tree = hegel.Draw(tc, optionTrees)
+		c.optimize = hegel.Draw(tc, hegel.Booleans())
+		return c
+	})
+)
+
+// nodeCount is the number of AST nodes of the expression.
+func (c optionCase) nodeCount() int {
+	tree, err := parser.Parse(render(c.tree))
+	if err != nil {
+		return 0
+	}
+	n := &nodeCounter{}
+	ast.Walk(&tree.Node, n)
+	return n.count
+}
+
+// limit is the MaxNodes limit: 1 to count+2.
+func (c optionCase) limit() uint { return uint(1 + c.raw%(c.nodeCount()+2)) }
+
+// disabled is the builtin DisableBuiltin is given: of the names the
+// expression uses one (even which) when there is one, else of the others.
+func (c optionCase) disabled() string {
+	src := render(c.tree)
+	var used, unused []string
+	for _, name := range builtinNames {
+		if strings.Contains(src, name+"(") {
+			used = append(used, name)
+		} else {
+			unused = append(unused, name)
+		}
+	}
+	if c.which%2 == 0 && len(used) > 0 {
+		return used[c.which/2%len(used)]
+	}
+	return unused[c.which/2%len(unused)]
+}
+
+// TestHegelOptionsAreHonoured: AsBool/AsInt/AsFloat64/AsKind reject a result
+// of another kind (at compile time when the type is known, at run time
+// otherwise), MaxNodes bounds the AST, DisableBuiltin removes a builtin,
+// AllowUndefinedVariables makes unknown names nil. DisableBuiltin leaves a
+// predicate builtin (count) enabled (expr/4).
+func TestHegelOptionsAreHonoured(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, optionCases)
+		env := c.env.env()
+		g := realise(c.tree, c.env)
+		switch c.kind {
+		case "as":
+			o := asOptions[c.as]
+			castable := !(g.v.kind == 'f' && (math.IsNaN(g.v.f) || math.IsInf(g.v.f, 0) || math.Abs(g.v.f) > 1<<62))
+			note(ht, "model %v", g.v)
+			p, cerr := compile(g.src, env, c.optimize, o.opt)
+			var got any
+			var rerr error
+			if cerr == nil {
+				got, rerr = expr.Run(p, env)
+			}
+			if o.ok(g.v) {
+				if g.err || (c.optimize && g.fold) || !castable {
+					return // no value to cast
+				}
+				if cerr != nil || rerr != nil {
+					fail(ht, "%s (model %v) with %s: compile %v, run %v", g.src, g.v, o.name, cerr, rerr)
+				}
+				if want := o.want(g.v); !sameValue(got, want) {
+					fail(ht, "%s (model %v) with %s = %T %#v; want %T %#v", g.src, g.v, o.name, got, got, want, want)
+				}
+			} else if cerr == nil && rerr == nil {
+				fail(ht, "%s (model %v) accepted under %s: %T %#v", g.src, g.v, o.name, got, got)
+			}
+		case "maxNodes":
+			count, limit := c.nodeCount(), c.limit()
+			if count == 0 {
+				fail(ht, "%s does not parse", g.src)
+			}
+			_, err := compile(g.src, env, true, expr.MaxNodes(limit))
+			if uint(count) <= limit && err != nil {
+				fail(ht, "%s has %d nodes, MaxNodes(%d) rejects it: %v", g.src, count, limit, err)
+			}
+			if uint(count) > limit && err == nil {
+				fail(ht, "%s has %d nodes, MaxNodes(%d) accepts it", g.src, count, limit)
+			}
+		case "disable":
+			name := c.disabled()
+			uses := strings.Contains(g.src, name+"(")
+			_, err := compile(g.src, env, c.optimize, expr.DisableBuiltin(name))
+			if uses && err == nil {
+				mismatch(ht, shapeIf(slices.Contains(predicateBuiltins, name), "expr/4"), "%s compiles with DisableBuiltin(%q)", g.src, name)
+			}
+			if !uses && err != nil {
+				fail(ht, "%s does not use %s but fails with DisableBuiltin(%q): %v", g.src, name, name, err)
+			}
+		default:
+			row := undefinedTable[c.entry]
+			got, err := eval(row.src, env, c.optimize, expr.AllowUndefinedVariables())
+			if err != nil || !reflect.DeepEqual(got, row.want) {
+				fail(ht, "%s with AllowUndefinedVariables = %#v, %v; want %#v", row.src, got, err, row.want)
+			}
+			if _, err := compile("undefinedName == nil", env, true); err == nil {
+				fail(ht, "undefinedName compiles without AllowUndefinedVariables")
+			}
+		}
+	})
+}
+
+// fuzzCases: a corpus line with up to two edits (none sometimes).
+var fuzzCases = hegel.Composite(func(tc hegel.TestCase) corpusCase {
+	return corpusCase{line: hegel.Draw(tc, lines), edits: hegel.Draw(tc, many(edits, 0, 2))}
+})
+
+// TestHegelNoPanicsOnMutatedCorpus: upstream's fuzz criterion as a property —
+// a mutated corpus line never panics in Compile, Disassemble or Run, and a
+// program that compiled either runs or fails with one of the runtime errors
+// upstream's fuzz test accepts.
+func TestHegelNoPanicsOnMutatedCorpus(t *testing.T) {
+	env := fuzz.NewEnv()
+	property(t, func(ht *hegel.T) {
+		src := hegel.Draw(ht, fuzzCases).source()
+		ht.Assume(len(src) <= 1000)
+		p, err := expr.Compile(src, expr.Env(env), fuzz.Func())
+		if err != nil {
+			return // refused without a panic
+		}
+		_ = p.Disassemble()
+		_ = ast.Dump(p.Node())
+		v := vm.VM{MemoryBudget: 500000}
+		_, err = v.Run(p, env)
+		if err != nil && !accepted(err) {
+			fail(ht, "%q compiled but failed at run time with an error upstream's fuzz test does not accept: %v\n%s", src, err, p.Disassemble())
+		}
+	})
+}
