+// ---------------------------------------------------------------------------
+// Properties.
+
+// TestHegelModelAgrees: a typed expression over ints, floats, strings and
+// bools, with variables from the environment, evaluates (optimizer on and
+// off) to the model's value of the model's Go type: ints stay int, `/` and
+// `**` are float64, comparisons across int and float compare numerically,
+// `%` by zero is a runtime error.
+func TestHegelModelAgrees(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		e := genEnv(ht)
+		g := genAny(ht, e, n(ht, 1, 4))
+		note(ht, "%s\nenv %+v\nmodel: %v (error %v)", g.src, e, g.v, g.err)
+		for _, optimize := range []bool{true, false} {
+			got, err := eval(g.src, e.env(), optimize)
+			if g.err {
+				if err == nil {
+					fail(ht, "%s: model expects a runtime error (integer divide by zero), got %#v (optimize=%v)\nenv %+v", g.src, got, optimize, e)
+				}
+				continue
+			}
+			if err != nil {
+				fail(ht, "%s: %v (optimize=%v)\nenv %+v\nmodel %v", g.src, err, optimize, e, g.v)
+			}
+			if !matches(got, g.v) {
+				fail(ht, "%s = %T %#v, model %v (optimize=%v)\nenv %+v", g.src, got, got, g.v, optimize, e)
+			}
+		}
+	})
+}
+
+// TestHegelOptimizerIsTransparent: a corpus expression (lightly mutated)
+// compiles alike with and without the optimizer and evaluates to the same
+// value, or fails alike.
+func TestHegelOptimizerIsTransparent(t *testing.T) {
+	corpus := fuzzCorpus(t)
+	env := fuzz.NewEnv()
+	property(t, func(ht *hegel.T) {
+		src := pick(ht, corpus...)
+		if chance(ht, 40) {
+			src = mutateSource(ht, src, corpus)
+		}
+		if timeDependent(src) {
+			return
+		}
+		note(ht, "%q", src)
+		pOn, errOn := compile(src, env, true, fuzz.Func())
+		pOff, errOff := compile(src, env, false, fuzz.Func())
+		if (errOn == nil) != (errOff == nil) {
+			fail(ht, "%q: compiles with optimizer=%v only\n  on:  %v\n  off: %v", src, errOn == nil, errOn, errOff)
+		}
+		if errOn != nil {
+			return
+		}
+		vOn, rOn := expr.Run(pOn, env)
+		vOff, rOff := expr.Run(pOff, env)
+		if (rOn == nil) != (rOff == nil) {
+			fail(ht, "%q: runs with optimizer=%v only\n  on:  %v %#v\n  off: %v %#v\n%s", src, rOn == nil, rOn, vOn, rOff, vOff, pOn.Disassemble())
+		}
+		if rOn == nil && !sameValue(vOn, vOff) {
+			fail(ht, "%q: optimizer on = %T %#v, off = %T %#v\n%s", src, vOn, vOn, vOff, vOff, pOn.Disassemble())
+		}
+	})
+}
+
+// TestHegelStaticTypeMatchesRuntime: when the checker gives an expression a
+// concrete type, the value the program produces has that kind (a nil result
+// for a non-nillable kind counts as a mismatch).
+func TestHegelStaticTypeMatchesRuntime(t *testing.T) {
+	corpus := fuzzCorpus(t)
+	env := fuzz.NewEnv()
+	property(t, func(ht *hegel.T) {
+		src := pick(ht, corpus...)
+		if chance(ht, 30) {
+			src = mutateSource(ht, src, corpus)
+		}
+		if timeDependent(src) {
+			return
+		}
+		cfg := conf.New(env)
+		fuzz.Func()(cfg)
+		tree, err := parser.ParseWithConfig(src, cfg)
+		if err != nil {
+			return
+		}
+		static, err := checker.Check(tree, cfg)
+		if err != nil || static == nil {
+			return
+		}
+		switch static.Kind() {
+		case reflect.Interface, reflect.Invalid:
+			return
+		}
+		note(ht, "%q: static type %v", src, static)
+		got, err := eval(src, env, false, fuzz.Func())
+		if err != nil {
+			return
+		}
+		if got == nil {
+			if Known.findersTypedNonNil && (usesFinder(src) || strings.Contains(src, "nil")) {
+				return // expr/1 (a finder, or a conditional with a nil branch)
+			}
+			switch static.Kind() {
+			case reflect.Int, reflect.Int64, reflect.Float64, reflect.String, reflect.Bool:
+				fail(ht, "%q: static type %v, runtime value nil", src, static)
+			}
+			return
+		}
+		if reflect.TypeOf(got).Kind() != static.Kind() {
+			fail(ht, "%q: static type %v (kind %v), runtime %T %#v", src, static, static.Kind(), got, got)
+		}
+	})
+}
+
+// TestHegelPrintedAstReparses: parsing an expression, printing the AST with
+// Node.String() and parsing the print gives the same AST (ast.Dump) — and
+// the same value.
+func TestHegelPrintedAstReparses(t *testing.T) {
+	corpus := fuzzCorpus(t)
+	env := fuzz.NewEnv()
+	property(t, func(ht *hegel.T) {
+		var src string
+		if chance(ht, 70) {
+			src = pick(ht, corpus...)
+			if chance(ht, 30) {
+				src = mutateSource(ht, src, corpus)
+			}
+		} else {
+			e := genEnv(ht)
+			src = genAny(ht, e, n(ht, 1, 4)).src
+		}
+		tree, err := parser.Parse(src)
+		if err != nil {
+			return
+		}
+		if Known.integralFloatPrints {
+			f := &integralFloatFinder{}
+			ast.Walk(&tree.Node, f)
+			if f.found {
+				return // expr/2
+			}
+		}
+		if Known.nestedLetPrints {
+			f := &nestedLetFinder{root: tree.Node}
+			ast.Walk(&tree.Node, f)
+			if f.found {
+				return // expr/3
+			}
+		}
+		printed := tree.Node.String()
+		note(ht, "%q prints as %q", src, printed)
+		tree2, err := parser.Parse(printed)
+		if err != nil {
+			fail(ht, "%q prints as %q, which does not parse: %v", src, printed, err)
+		}
+		d1, d2 := ast.Dump(tree.Node), ast.Dump(tree2.Node)
+		if d1 != d2 {
+			if timeDependent(src) {
+				fail(ht, "%q prints as %q: different AST\n%s\n--- vs ---\n%s", src, printed, d1, d2)
+			}
+			v1, e1 := eval(src, env, false, fuzz.Func())
+			v2, e2 := eval(printed, env, false, fuzz.Func())
+			fail(ht, "%q prints as %q: different AST (values %#v/%v vs %#v/%v)\n%s\n--- vs ---\n%s", src, printed, v1, e1, v2, e2, d1, d2)
+		}
+	})
+}
