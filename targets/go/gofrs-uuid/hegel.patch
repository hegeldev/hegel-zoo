+// Hegel property tests for github.com/gofrs/uuid/v5, with Python's `uuid` module (one child
+// process held open) as the oracle for parsing, field extraction and the name-based versions,
+// plus exact models of the RFC 9562 layouts for versions 1, 4, 6, 7 and 8 driven through a
+// generator whose clock, random reader and hardware address are scripted per test case, the
+// documented parsing grammar with its error values, and round trips through the text, binary,
+// JSON, fmt and database/sql encodings.
+//
+// GOFRS_UUID_COLLECT=1 turns failures into a summary printed at the end (shortest first).
+package uuid_test
+
+import (
+	"bufio"
+	"bytes"
+	"database/sql/driver"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"net"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gofrs/uuid/v5"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+var (
+	collectMode = os.Getenv("GOFRS_UUID_COLLECT") != ""
+	collectMu   sync.Mutex
+	collectMsgs []string
+)
+
+type collected struct{}
+
+// fail reports a property failure; in collect mode it records the message and ends the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collectMode {
+		collectMu.Lock()
+		collectMsgs = append(collectMsgs, msg)
+		collectMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf("%s", msg)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+	if collectMode {
+		collectMu.Lock()
+		msgs := append([]string(nil), collectMsgs...)
+		collectMsgs = nil
+		collectMu.Unlock()
+		sort.Slice(msgs, func(i, j int) bool { return len(msgs[i]) < len(msgs[j]) })
+		t.Logf("COLLECT %s: %d failures", t.Name(), len(msgs))
+		for i, m := range msgs {
+			if i == 40 {
+				t.Logf("  ... %d more", len(msgs)-40)
+				break
+			}
+			t.Logf("  %s", m)
+		}
+	}
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// guard turns a panic in a pin into a failure message instead of killing the test binary.
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---- the oracle: Python's uuid module ------------------------------------------------------
+
+const pyScript = `
+import sys, json, uuid, base64
+def fields(u):
+    return {'ok': True, 'hex': u.hex, 'str': str(u), 'urn': u.urn, 'int': str(u.int),
+            'version': u.version, 'variant': u.variant, 'time': u.time,
+            'clock_seq': u.clock_seq, 'node': u.node}
+for line in sys.stdin:
+    req = json.loads(line)
+    op = req['op']
+    if op == 'parse':
+        try:
+            res = fields(uuid.UUID(req['s']))
+        except (ValueError, TypeError) as e:
+            res = {'ok': False, 'err': str(e)}
+    elif op == 'frombytes':
+        res = fields(uuid.UUID(bytes=base64.b64decode(req['b'])))
+    elif op == 'name':
+        ns = uuid.UUID(bytes=base64.b64decode(req['ns']))
+        name = base64.b64decode(req['name'])
+        u = uuid.uuid3(ns, name) if req['version'] == 3 else uuid.uuid5(ns, name)
+        res = {'hex': u.hex}
+    else:
+        res = {'err': 'unknown op'}
+    sys.stdout.write(json.dumps(res) + '\n')
+    sys.stdout.flush()
+`
+
+type pyFields struct {
+	OK       bool   `json:"ok"`
+	Err      string `json:"err"`
+	Hex      string `json:"hex"`
+	Str      string `json:"str"`
+	URN      string `json:"urn"`
+	Int      string `json:"int"`
+	Version  *int   `json:"version"`
+	Variant  string `json:"variant"`
+	Time     int64  `json:"time"`
+	ClockSeq int    `json:"clock_seq"`
+	Node     int64  `json:"node"`
+}
+
+type pyChild struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+var (
+	pyOnce  sync.Once
+	pyProc  *pyChild
+	pyError error
+)
+
+func oracle(t *testing.T) *pyChild {
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			pyError = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			pyError = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyError = err
+			return
+		}
+		sc := bufio.NewScanner(stdout)
+		sc.Buffer(make([]byte, 1<<16), 1<<22)
+		pyProc = &pyChild{cmd: cmd, in: bufio.NewWriter(stdin), out: sc}
+	})
+	if pyError != nil {
+		t.Fatalf("cannot start the Python oracle: %v", pyError)
+	}
+	return pyProc
+}
+
+func (p *pyChild) call(req any, res any) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		return err
+	}
+	if _, err := p.in.Write(append(b, '\n')); err != nil {
+		return err
+	}
+	if err := p.in.Flush(); err != nil {
+		return err
+	}
+	if !p.out.Scan() {
+		return fmt.Errorf("oracle died: %v", p.out.Err())
+	}
+	return json.Unmarshal(p.out.Bytes(), res)
+}
+
+func (p *pyChild) parse(t *testing.T, s string) pyFields {
+	var res pyFields
+	if err := p.call(map[string]any{"op": "parse", "s": s}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res
+}
+
+func (p *pyChild) fromBytes(t *testing.T, b []byte) pyFields {
+	var res pyFields
+	if err := p.call(map[string]any{"op": "frombytes", "b": b}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res
+}
+
+func (p *pyChild) nameBased(t *testing.T, version int, ns uuid.UUID, name []byte) string {
+	var res struct {
+		Hex string `json:"hex"`
+	}
+	if err := p.call(map[string]any{"op": "name", "version": version, "ns": ns[:], "name": name}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res.Hex
+}
+
+// ---- generators and models -----------------------------------------------------------------
+
+// genUUID draws 16 bytes: uniformly random, or shaped (a given version/variant, Nil, Max, a
+// name-space constant) often enough that the special cases are exercised.
+func genUUID(tc hegel.TestCase) uuid.UUID {
+	var u uuid.UUID
+	switch n(tc, 0, 9) {
+	case 0:
+		return uuid.Nil
+	case 1:
+		return uuid.Max
+	case 2:
+		return pick(tc, []uuid.UUID{uuid.NamespaceDNS, uuid.NamespaceURL, uuid.NamespaceOID, uuid.NamespaceX500})
+	}
+	for i := range u {
+		u[i] = byte(n(tc, 0, 255))
+	}
+	if chance(tc, 60) {
+		u[6] = (u[6] & 0x0f) | byte(n(tc, 0, 15))<<4
+	}
+	if chance(tc, 60) {
+		switch n(tc, 0, 3) {
+		case 0:
+			u[8] = (u[8] & 0x3f) | 0x80 // RFC 4122 / 9562
+		case 1:
+			u[8] = u[8] & 0x7f // NCS
+		case 2:
+			u[8] = (u[8] & 0x1f) | 0xc0 // Microsoft
+		case 3:
+			u[8] = u[8] | 0xe0 // future
+		}
+	}
+	return u
+}
+
+func genBytes(tc hegel.TestCase, k int) []byte {
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = byte(n(tc, 0, 255))
+	}
+	return b
+}
+
+var hexUpper = "0123456789ABCDEF"
+
+// hexText spells the 32 hex digits of u with a random case per digit.
+func hexText(tc hegel.TestCase, u uuid.UUID) string {
+	s := hex.EncodeToString(u[:])
+	if !chance(tc, 40) {
+		return s
+	}
+	b := []byte(s)
+	for i, c := range b {
+		if c >= 'a' && chance(tc, 50) {
+			b[i] = hexUpper[c-'a'+10]
+		}
+	}
+	return string(b)
+}
+
+func hyphenate(h string) string {
+	return h[0:8] + "-" + h[8:12] + "-" + h[12:16] + "-" + h[16:20] + "-" + h[20:32]
+}
+
+// spelling draws one of the six documented input forms (canonical, hash, each in braces, each
+// with the `urn:uuid:` prefix), in random hex case; Python's constructor takes all of them.
+func spelling(tc hegel.TestCase, u uuid.UUID) string {
+	h := hexText(tc, u)
+	body := h
+	if chance(tc, 50) {
+		body = hyphenate(h)
+	}
+	switch n(tc, 0, 2) {
+	case 0:
+		return body
+	case 1:
+		return "{" + body + "}"
+	default:
+		return "urn:uuid:" + body
+	}
+}
+
+func isHex(c byte) bool {
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
+}
+
+// modelParse is the documented grammar of Parse/FromString/UnmarshalText: lengths 32 and 36,
+// 34 and 38 in braces, 41 and 45 with a lower-case `urn:uuid:` prefix, dashes at 8/13/18/23 in
+// the 36-byte body, hex digits elsewhere; the error values are the package's sentinels.
+func modelParse(s string) (uuid.UUID, error) {
+	var u uuid.UUID
+	body := s
+	switch len(s) {
+	case 32, 36:
+	case 34, 38:
+		if s[0] != '{' || s[len(s)-1] != '}' {
+			return u, uuid.ErrInvalidBraces
+		}
+		body = s[1 : len(s)-1]
+	case 41, 45:
+		if s[:9] != "urn:uuid:" {
+			return u, uuid.ErrInvalidURNPrefix
+		}
+		body = s[9:]
+	default:
+		return u, uuid.ErrIncorrectLength
+	}
+	if len(body) == 36 {
+		if body[8] != '-' || body[13] != '-' || body[18] != '-' || body[23] != '-' {
+			return u, uuid.ErrInvalidDashes
+		}
+		body = body[0:8] + body[9:13] + body[14:18] + body[19:23] + body[24:36]
+	}
+	for i := 0; i < 32; i++ {
+		if !isHex(body[i]) {
+			return u, uuid.ErrInvalidFormat
+		}
+	}
+	b, _ := hex.DecodeString(body)
+	copy(u[:], b)
+	return u, nil
+}
+
+func sameErr(got, want error) bool {
+	if got == nil || want == nil {
+		return got == want
+	}
+	return errors.Is(got, want) || got.Error() == want.Error()
+}
+
+var junkChars = []string{"-", "g", "G", "z", " ", "\t", "\n", "{", "}", ":", "u", "0", "9", "a", "F", "é", "\x00", "\xff", "U", "R", "N"}
+
+// genText draws a string that is usually near a valid spelling: a valid one, a mutated one,
+// junk of a plausible length, or a wrong-case URN prefix.
+func genText(tc hegel.TestCase) string {
+	u := genUUID(tc)
+	s := spelling(tc, u)
+	switch n(tc, 0, 4) {
+	case 0:
+		return s
+	case 1: // replace a byte
+		b := []byte(s)
+		i := n(tc, 0, len(b)-1)
+		c := pick(tc, junkChars)
+		return string(b[:i]) + c + string(b[i+1:])
+	case 2: // insert or delete
+		i := n(tc, 0, len(s))
+		if chance(tc, 50) && i < len(s) {
+			return s[:i] + s[i+1:]
+		}
+		return s[:i] + pick(tc, junkChars) + s[i:]
+	case 3:
+		if strings.HasPrefix(s, "urn:uuid:") {
+			return pick(tc, []string{"URN:UUID:", "Urn:Uuid:", "urn:UUID:", "urn:uuid;"}) + s[9:]
+		}
+		return pick(tc, []string{"(", "[", "{"}) + s + pick(tc, []string{")", "]", "}"})
+	default:
+		var sb strings.Builder
+		k := pick(tc, []int{0, 1, 31, 32, 33, 34, 35, 36, 37, 38, 39, 41, 45, 46})
+		for sb.Len() < k {
+			sb.WriteString(pick(tc, junkChars))
+		}
+		return sb.String()[:k]
+	}
+}
+
+// RFC 9562 layouts.
+const g1582ns100 = 122192928000000000 // 100 ns ticks from 1582-10-15 to 1970-01-01
+
+func v1Time(u uuid.UUID) uint64 {
+	return uint64(binary.BigEndian.Uint32(u[0:4])) | uint64(binary.BigEndian.Uint16(u[4:6]))<<32 |
+		uint64(binary.BigEndian.Uint16(u[6:8])&0x0fff)<<48
+}
+
+func v6Time(u uuid.UUID) uint64 {
+	return uint64(binary.BigEndian.Uint32(u[0:4]))<<28 | uint64(binary.BigEndian.Uint16(u[4:6]))<<12 |
+		uint64(binary.BigEndian.Uint16(u[6:8])&0x0fff)
+}
+
+func v7Millis(u uuid.UUID) uint64 { return binary.BigEndian.Uint64(u[0:8]) >> 16 }
+
+// gregorian is the RFC timestamp of t: 100 ns ticks since 1582-10-15 (floor).
+func gregorian(t time.Time) int64 {
+	ns := new(big.Int).Mul(big.NewInt(t.Unix()), big.NewInt(1e9))
+	ns.Add(ns, big.NewInt(int64(t.Nanosecond())))
+	ticks := new(big.Int).Div(ns, big.NewInt(100))
+	return ticks.Int64() + g1582ns100
+}
+
+func variantOf(u uuid.UUID) byte {
+	switch {
+	case u[8]&0x80 == 0:
+		return uuid.VariantNCS
+	case u[8]&0x40 == 0:
+		return uuid.VariantRFC9562
+	case u[8]&0x20 == 0:
+		return uuid.VariantMicrosoft
+	}
+	return uuid.VariantFuture
+}
+
+var pyVariant = map[byte]string{
+	uuid.VariantNCS: "reserved for NCS compatibility", uuid.VariantRFC9562: "specified in RFC 4122",
+	uuid.VariantMicrosoft: "reserved for Microsoft compatibility", uuid.VariantFuture: "reserved for future definition",
+}
+
+// genInstant draws an instant NewV1AtTime/NewV6AtTime can represent (Go's UnixNano range,
+// 1678–2262; pin /4 covers the rest); pre-1970 nanoseconds are a multiple of 100 (README).
+func genInstant(tc hegel.TestCase) time.Time {
+	var t time.Time
+	switch n(tc, 0, 3) {
+	case 0:
+		t = time.Unix(int64(n(tc, 0, 2_000_000_000)), int64(n(tc, 0, 999_999_999)))
+	case 1:
+		t = time.Unix(-int64(n(tc, 1, 9_200_000_000)), int64(n(tc, 0, 9_999_999))*100)
+	case 2:
+		t = time.Unix(int64(n(tc, 2_000_000_000, 9_200_000_000)), int64(n(tc, 0, 999_999_999)))
+	default:
+		t = time.Now().Add(time.Duration(n(tc, -1_000_000_000, 1_000_000_000)))
+	}
+	return t.UTC()
+}
+
+// scripted is a generator whose clock, random bytes and hardware address are under the test's
+// control; reads past the script fail (which the library must report, not hide).
+type scripted struct {
+	gen    *uuid.Gen
+	clock  []time.Time // the clock reading of call i is clock[i]
+	tick   int         // the call in progress
+	rnd    *bytes.Reader
+	script []byte
+	hw     []byte // nil: the hardware address function fails and a random node is used
+}
+
+func newScripted(tc hegel.TestCase, randBytes int, clocks int) *scripted {
+	s := &scripted{script: genBytes(tc, randBytes)}
+	s.rnd = bytes.NewReader(s.script)
+	for i := 0; i < clocks; i++ {
+		s.clock = append(s.clock, genInstant(tc))
+	}
+	if chance(tc, 70) {
+		s.hw = genBytes(tc, 6)
+	}
+	s.gen = uuid.NewGenWithOptions(
+		uuid.WithRandomReader(s.rnd),
+		uuid.WithEpochFunc(func() time.Time { return s.clock[s.tick] }),
+		uuid.WithHWAddrFunc(func() (net.HardwareAddr, error) {
+			if s.hw == nil {
+				return nil, errors.New("no interface")
+			}
+			return net.HardwareAddr(s.hw), nil
+		}),
+	)
+	return s
+}
+
+// ---- properties ----------------------------------------------------------------------------
+
+// TestHegelParseAgreesWithPython: every documented spelling parses (FromString, FromStringOrNil,
+// Parse, UnmarshalText, Scan of a string and of text bytes, json.Unmarshal) to the same 16 bytes
+// as Python's constructor, and String/MarshalText/Value/Format print Python's spellings.
+func TestHegelParseAgreesWithPython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		u := genUUID(ht)
+		s := spelling(ht, u)
+		note(ht, "text %q", s)
+		got, err := uuid.FromString(s)
+		if err != nil || got != u {
+			fail(ht, "FromString(%q) = %v, %v; want %v", s, got, err, u)
+		}
+		if gn := uuid.FromStringOrNil(s); gn != u {
+			fail(ht, "FromStringOrNil(%q) = %v; want %v", s, gn, u)
+		}
+		var up uuid.UUID
+		if err := up.Parse(s); err != nil || up != u {
+			fail(ht, "Parse(%q) = %v, %v; want %v", s, up, err, u)
+		}
+		var ut uuid.UUID
+		if err := ut.UnmarshalText([]byte(s)); err != nil || ut != u {
+			fail(ht, "UnmarshalText(%q) = %v, %v; want %v", s, ut, err, u)
+		}
+		var us uuid.UUID
+		if err := us.Scan(s); err != nil || us != u {
+			fail(ht, "Scan(%q) = %v, %v; want %v", s, us, err, u)
+		}
+		var ub uuid.UUID
+		if err := ub.Scan([]byte(s)); err != nil || ub != u {
+			fail(ht, "Scan([]byte(%q)) = %v, %v; want %v", s, ub, err, u)
+		}
+		var js uuid.UUID
+		if err := json.Unmarshal([]byte(strconv.Quote(s)), &js); err != nil || js != u {
+			fail(ht, "json.Unmarshal(%q) = %v, %v; want %v", s, js, err, u)
+		}
+		var nj uuid.NullUUID
+		if err := json.Unmarshal([]byte(strconv.Quote(s)), &nj); err != nil || nj.UUID != u || !nj.Valid {
+			fail(ht, "json.Unmarshal(%q) into NullUUID = %+v, %v; want %v", s, nj, err, u)
+		}
+		pp := py.parse(t, s)
+		if !pp.OK || pp.Hex != hex.EncodeToString(u[:]) {
+			fail(ht, "Python UUID(%q) = %+v; Go parsed %v", s, pp, u)
+		}
+		// outputs vs Python
+		pf := py.fromBytes(t, u[:])
+		if u.String() != pf.Str {
+			fail(ht, "String() = %q; Python %q", u.String(), pf.Str)
+		}
+		if mt, err := u.MarshalText(); err != nil || string(mt) != pf.Str {
+			fail(ht, "MarshalText() = %q, %v; Python %q", mt, err, pf.Str)
+		}
+		if v, err := u.Value(); err != nil || v != driver.Value(pf.Str) {
+			fail(ht, "Value() = %v, %v; Python %q", v, err, pf.Str)
+		}
+		if fmt.Sprintf("%v|%s|%x|%X|%S|%q", u, u, u, u, u, u) !=
+			pf.Str+"|"+pf.Str+"|"+pf.Hex+"|"+strings.ToUpper(pf.Hex)+"|"+strings.ToUpper(pf.Str)+"|"+strconv.Quote(pf.Str) {
+			fail(ht, "Format verbs of %v: %q", u, fmt.Sprintf("%v|%s|%x|%X|%S|%q", u, u, u, u, u, u))
+		}
+		if fmt.Sprintf("%#v", u) != fmt.Sprintf("%#v", [16]byte(u)) {
+			fail(ht, "%%#v of %v = %s", u, fmt.Sprintf("%#v", u))
+		}
+		if "urn:uuid:"+u.String() != pf.URN {
+			fail(ht, "urn of %v: Python %q", u, pf.URN)
+		}
+	})
+}
