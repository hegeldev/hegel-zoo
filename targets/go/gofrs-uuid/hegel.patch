+// TestHegelNameBasedAgreeWithPython: NewV3/NewV5 (package-level and on any generator) are
+// Python's uuid3/uuid5 over the bytes of arbitrary names, including invalid UTF-8.
+func TestHegelNameBasedAgreeWithPython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		ns := genUUID(ht)
+		name := string(genBytes(ht, n(ht, 0, 48)))
+		note(ht, "ns %v name %x", ns, name)
+		g := uuid.NewGen()
+		v3, v5 := uuid.NewV3(ns, name), uuid.NewV5(ns, name)
+		if w := py.nameBased(t, 3, ns, []byte(name)); hex.EncodeToString(v3[:]) != w || g.NewV3(ns, name) != v3 {
+			fail(ht, "NewV3(%v, %x) = %v; Python uuid3 %s", ns, name, v3, w)
+		}
+		if w := py.nameBased(t, 5, ns, []byte(name)); hex.EncodeToString(v5[:]) != w || g.NewV5(ns, name) != v5 {
+			fail(ht, "NewV5(%v, %x) = %v; Python uuid5 %s", ns, name, v5, w)
+		}
+		if v3.Version() != uuid.V3 || v5.Version() != uuid.V5 || v3.Variant() != uuid.VariantRFC9562 || v5.Variant() != uuid.VariantRFC9562 {
+			fail(ht, "NewV3/NewV5 bits: %v %v", v3, v5)
+		}
+	})
+}
