+// TestHegelParseFollowsTheDocumentedGrammar: on arbitrary (mostly near-valid) text FromString,
+// Parse and UnmarshalText accept exactly the documented forms and return the documented error
+// values, FromStringOrNil is Nil on error, and whatever is accepted Python parses to the same
+// value.
+func TestHegelParseFollowsTheDocumentedGrammar(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		s := genText(ht)
+		note(ht, "text %q", s)
+		want, wantErr := modelParse(s)
+		got, err := uuid.FromString(s)
+		if !sameErr(err, wantErr) || (wantErr == nil && got != want) {
+			fail(ht, "FromString(%q) = %v, %v; model %v, %v", s, got, err, want, wantErr)
+		}
+		if wantErr != nil && !errors.Is(err, uuid.ErrIncorrectLength) && !errors.Is(err, uuid.ErrIncorrectFormatInString) && !errors.Is(err, uuid.ErrInvalidFormat) {
+			fail(ht, "FromString(%q) error %v matches none of the documented sentinels", s, err)
+		}
+		var ut uuid.UUID
+		if errT := ut.UnmarshalText([]byte(s)); !sameErr(errT, err) || (err == nil && ut != got) {
+			fail(ht, "UnmarshalText(%q) = %v, %v; FromString %v, %v", s, ut, errT, got, err)
+		}
+		var up uuid.UUID
+		if errP := up.Parse(s); !sameErr(errP, err) || (err == nil && up != got) {
+			fail(ht, "Parse(%q) = %v, %v; FromString %v, %v", s, up, errP, got, err)
+		}
+		if on := uuid.FromStringOrNil(s); (err == nil && on != got) || (err != nil && on != uuid.Nil) {
+			fail(ht, "FromStringOrNil(%q) = %v; FromString %v, %v", s, on, got, err)
+		}
+		if err == nil {
+			pp := py.parse(t, s)
+			if !pp.OK || pp.Hex != hex.EncodeToString(got[:]) {
+				fail(ht, "Python UUID(%q) = %+v; Go parsed %v", s, pp, got)
+			}
+		}
+	})
+}
+
+// TestHegelFieldsAgreeWithPython: Version, Variant, the version-1 timestamp, clock sequence
+// and node agree with Python's field accessors and with the RFC layouts; TimestampFromV1/V6/V7
+// refuse other versions; Timestamp.Time inverts the tick count; SetVersion/SetVariant set
+// exactly their bits; IsNil/IsZero/Bytes.
+func TestHegelFieldsAgreeWithPython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		u := genUUID(ht)
+		note(ht, "u %v", u)
+		pf := py.fromBytes(t, u[:])
+		if int(u.Version()) != int(u[6]>>4) || (pf.Version != nil && int(u.Version()) != *pf.Version) {
+			fail(ht, "%v.Version() = %d; layout %d, Python %v", u, u.Version(), u[6]>>4, pf.Version)
+		}
+		if u.Variant() != variantOf(u) || pyVariant[u.Variant()] != pf.Variant {
+			fail(ht, "%v.Variant() = %d; model %d, Python %q", u, u.Variant(), variantOf(u), pf.Variant)
+		}
+		ts1, err1 := uuid.TimestampFromV1(u)
+		ts6, err6 := uuid.TimestampFromV6(u)
+		ts7, err7 := uuid.TimestampFromV7(u)
+		if (err1 == nil) != (u.Version() == 1) || (err6 == nil) != (u.Version() == 6) || (err7 == nil) != (u.Version() == 7) {
+			fail(ht, "%v (version %d): TimestampFromV1/V6/V7 errors %v / %v / %v", u, u.Version(), err1, err6, err7)
+		}
+		for _, e := range []error{err1, err6, err7} {
+			if e != nil && !errors.Is(e, uuid.ErrInvalidVersion) {
+				fail(ht, "%v: timestamp error %v is not ErrInvalidVersion", u, e)
+			}
+		}
+		var ts uuid.Timestamp
+		var want uint64
+		switch u.Version() {
+		case 1:
+			ts, want = ts1, v1Time(u)
+			if int64(ts) != pf.Time {
+				fail(ht, "TimestampFromV1(%v) = %d; Python %d", u, ts, pf.Time)
+			}
+		case 6:
+			ts, want = ts6, v6Time(u)
+		case 7:
+			ts, want = ts7, v7Millis(u)*10000+g1582ns100
+		}
+		if uint64(ts) != want {
+			fail(ht, "timestamp of %v (version %d) = %d; layout %d", u, u.Version(), ts, want)
+		}
+		if u.Version() == 1 || u.Version() == 6 || u.Version() == 7 {
+			tm, err := ts.Time()
+			if err != nil || gregorian(tm) != int64(ts) {
+				fail(ht, "Timestamp(%d).Time() = %v, %v (ticks back %d)", ts, tm, err, gregorian(tm))
+			}
+		}
+		// Python's clock_seq and node are the v1 fields whatever the version.
+		if cs := int(binary.BigEndian.Uint16(u[8:10]) & 0x3fff); cs != pf.ClockSeq {
+			fail(ht, "%v: clock sequence layout %d; Python %d", u, cs, pf.ClockSeq)
+		}
+		if node := new(big.Int).SetBytes(u[10:]).Int64(); node != pf.Node {
+			fail(ht, "%v: node layout %x; Python %x", u, node, pf.Node)
+		}
+		// SetVersion/SetVariant.
+		v := byte(n(ht, 0, 15))
+		vr := byte(n(ht, 0, 3))
+		w := u
+		w.SetVersion(v)
+		w.SetVariant(vr)
+		if w.Version() != v || w.Variant() != vr || w[6]&0x0f != u[6]&0x0f || !bytes.Equal(w[:6], u[:6]) || !bytes.Equal(w[9:], u[9:]) {
+			fail(ht, "%v.SetVersion(%d).SetVariant(%d) = %v: version %d variant %d", u, v, vr, w, w.Version(), w.Variant())
+		}
+		keep := map[byte]byte{uuid.VariantNCS: 0x7f, uuid.VariantRFC9562: 0x3f, uuid.VariantMicrosoft: 0x1f, uuid.VariantFuture: 0x1f}[vr]
+		if w[8]&keep != u[8]&keep {
+			fail(ht, "%v.SetVariant(%d) changed payload bits: %02x -> %02x", u, vr, u[8], w[8])
+		}
+		if u.IsNil() != (u == uuid.Nil) || u.IsZero() != (u == uuid.Nil) || !bytes.Equal(u.Bytes(), u[:]) {
+			fail(ht, "%v: IsNil %v IsZero %v Bytes %x", u, u.IsNil(), u.IsZero(), u.Bytes())
+		}
+	})
+}
