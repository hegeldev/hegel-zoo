+// Hegel property tests for github.com/gofrs/uuid/v5, with Python's `uuid` module (one child
+// process held open) as the oracle for parsing, field extraction and the name-based versions,
+// plus exact models of the RFC 9562 layouts for versions 1, 4, 6, 7 and 8 driven through a
+// generator whose clock, random reader and hardware address are scripted per test case, the
+// documented parsing grammar with its error values, and round trips through the text, binary,
+// JSON, fmt and database/sql encodings.
+//
+// Every property draws one case record built from the binding's combinators and renders it
+// with pure functions (a spelling of a UUID, a mutation of a text, a JSON literal, a scripted
+// clock). The shapes of the recorded bugs (bugs.toml) are drawn at their natural rate, so the
+// properties that meet them fail, naming the shape, and are the expected failures mapped to
+// the bugs (STYLE.md rule 11); one narrow property per bug draws its shape region alone, and
+// the pins are the regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below) for a run that looks past the bugs.
+//
+// GOFRS_UUID_COLLECT=1 turns failures into a summary printed at the end (shortest first).
+package uuid_test
+
+import (
+	"bufio"
+	"bytes"
+	"database/sql/driver"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"net"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gofrs/uuid/v5"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+var (
+	collectMode = os.Getenv("GOFRS_UUID_COLLECT") != ""
+	collectMu   sync.Mutex
+	collectMsgs []string
+)
+
+type collected struct{}
+
+// fail reports a property failure; in collect mode it records the message and ends the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collectMode {
+		collectMu.Lock()
+		collectMsgs = append(collectMsgs, msg)
+		collectMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf("%s", msg)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+	if collectMode {
+		collectMu.Lock()
+		msgs := append([]string(nil), collectMsgs...)
+		collectMsgs = nil
+		collectMu.Unlock()
+		sort.Slice(msgs, func(i, j int) bool { return len(msgs[i]) < len(msgs[j]) })
+		t.Logf("COLLECT %s: %d failures", t.Name(), len(msgs))
+		for i, m := range msgs {
+			if i == 40 {
+				t.Logf("  ... %d more", len(msgs)-40)
+				break
+			}
+			t.Logf("  %s", m)
+		}
+	}
+}
+
+// guard turns a panic in a pin into a failure message instead of killing the test binary.
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape (mismatch); under HEGEL_NO_KNOWN=1 the gates of Known are on, the generators draw the
+// neighbouring regions instead (shaped) and the checks that only the shapes can fail are not
+// judged.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of the recorded bugs; on means the shape is left out or not
+// judged, which is so only under HEGEL_NO_KNOWN=1.
+var Known = struct {
+	scanValid    bool // gofrs-uuid/1: NullUUID.Scan of a rejected source leaves Valid = true
+	partialParse bool // gofrs-uuid/2: a text rejected with ErrInvalidFormat leaves the digits before the bad one in the receiver
+	rawJSONToken bool // gofrs-uuid/3: NullUUID.UnmarshalJSON hands the raw JSON token to the text parser
+	wildInstants bool // gofrs-uuid/4: NewV1AtTime/NewV6AtTime encode garbage for an instant outside Go's UnixNano range
+}{noKnown, noKnown, noKnown, noKnown}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf is the bug id when the case has its shape, else "".
+func shapeIf(has bool, id string) string {
+	if has {
+		return id
+	}
+	return ""
+}
+
+// mismatch reports a failed check on a case whose shape is that of the recorded bug shape
+// names ("" for none): the failure names the shape, and under HEGEL_NO_KNOWN=1 a failure on
+// a known shape is skipped instead (rare then, since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// nonNil makes an empty list a non-nil one (Lists yields nil for zero elements).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied.
+var positions = hegel.Integers(0, 99)
+
+// ---- the oracle: Python's uuid module ------------------------------------------------------
+
+const pyScript = `
+import sys, json, uuid, base64
+def fields(u):
+    return {'ok': True, 'hex': u.hex, 'str': str(u), 'urn': u.urn, 'int': str(u.int),
+            'version': u.version, 'variant': u.variant, 'time': u.time,
+            'clock_seq': u.clock_seq, 'node': u.node}
+for line in sys.stdin:
+    req = json.loads(line)
+    op = req['op']
+    if op == 'parse':
+        try:
+            res = fields(uuid.UUID(req['s']))
+        except (ValueError, TypeError) as e:
+            res = {'ok': False, 'err': str(e)}
+    elif op == 'frombytes':
+        res = fields(uuid.UUID(bytes=base64.b64decode(req['b'])))
+    elif op == 'name':
+        ns = uuid.UUID(bytes=base64.b64decode(req['ns']))
+        name = base64.b64decode(req['name'])
+        u = uuid.uuid3(ns, name) if req['version'] == 3 else uuid.uuid5(ns, name)
+        res = {'hex': u.hex}
+    else:
+        res = {'err': 'unknown op'}
+    sys.stdout.write(json.dumps(res) + '\n')
+    sys.stdout.flush()
+`
+
+type pyFields struct {
+	OK       bool   `json:"ok"`
+	Err      string `json:"err"`
+	Hex      string `json:"hex"`
+	Str      string `json:"str"`
+	URN      string `json:"urn"`
+	Int      string `json:"int"`
+	Version  *int   `json:"version"`
+	Variant  string `json:"variant"`
+	Time     int64  `json:"time"`
+	ClockSeq int    `json:"clock_seq"`
+	Node     int64  `json:"node"`
+}
+
+type pyChild struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+var (
+	pyOnce  sync.Once
+	pyProc  *pyChild
+	pyError error
+)
+
+func oracle(t *testing.T) *pyChild {
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			pyError = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			pyError = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyError = err
+			return
+		}
+		sc := bufio.NewScanner(stdout)
+		sc.Buffer(make([]byte, 1<<16), 1<<22)
+		pyProc = &pyChild{cmd: cmd, in: bufio.NewWriter(stdin), out: sc}
+	})
+	if pyError != nil {
+		t.Fatalf("cannot start the Python oracle: %v", pyError)
+	}
+	return pyProc
+}
+
+func (p *pyChild) call(req any, res any) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		return err
+	}
+	if _, err := p.in.Write(append(b, '\n')); err != nil {
+		return err
+	}
+	if err := p.in.Flush(); err != nil {
+		return err
+	}
+	if !p.out.Scan() {
+		return fmt.Errorf("oracle died: %v", p.out.Err())
+	}
+	return json.Unmarshal(p.out.Bytes(), res)
+}
+
+func (p *pyChild) parse(t *testing.T, s string) pyFields {
+	var res pyFields
+	if err := p.call(map[string]any{"op": "parse", "s": s}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res
+}
+
+func (p *pyChild) fromBytes(t *testing.T, b []byte) pyFields {
+	var res pyFields
+	if err := p.call(map[string]any{"op": "frombytes", "b": b}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res
+}
+
+func (p *pyChild) nameBased(t *testing.T, version int, ns uuid.UUID, name []byte) string {
+	var res struct {
+		Hex string `json:"hex"`
+	}
+	if err := p.call(map[string]any{"op": "name", "version": version, "ns": ns[:], "name": name}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res.Hex
+}
+
+// ---- UUID values ---------------------------------------------------------------------------
+
+var namespaces = []uuid.UUID{uuid.NamespaceDNS, uuid.NamespaceURL, uuid.NamespaceOID, uuid.NamespaceX500}
+
+// uuidSpec: 16 random bytes, with the version nibble forced to version and the variant bits
+// to one of the four variants (RFC 9562, NCS, Microsoft, future) when set.
+type uuidSpec struct {
+	raw     []byte
+	version *int
+	variant *int
+}
+
+func (s uuidSpec) build() uuid.UUID {
+	var u uuid.UUID
+	copy(u[:], s.raw)
+	if s.version != nil {
+		u[6] = (u[6] & 0x0f) | byte(*s.version)<<4
+	}
+	if s.variant != nil {
+		switch *s.variant {
+		case 0:
+			u[8] = (u[8] & 0x3f) | 0x80 // RFC 4122 / 9562
+		case 1:
+			u[8] = u[8] & 0x7f // NCS
+		case 2:
+			u[8] = (u[8] & 0x1f) | 0xc0 // Microsoft
+		default:
+			u[8] = u[8] | 0xe0 // future
+		}
+	}
+	return u
+}
+
+var (
+	uuidSpecs = hegel.Composite(func(tc hegel.TestCase) uuidSpec {
+		return uuidSpec{
+			raw:     hegel.Draw(tc, hegel.Binary(16, 16)),
+			version: hegel.Draw(tc, optional(60, hegel.Integers(0, 15))),
+			variant: hegel.Draw(tc, optional(60, hegel.Integers(0, 3))),
+		}
+	})
+	// uuids: Nil, Max and a name-space constant once each in ten, else random bytes with the
+	// version and variant bits shaped often enough that the special cases are exercised.
+	uuids = weighted(
+		choice[uuid.UUID]{1, hegel.Just(uuid.Nil)},
+		choice[uuid.UUID]{1, hegel.Just(uuid.Max)},
+		choice[uuid.UUID]{1, hegel.SampledFrom(namespaces)},
+		choice[uuid.UUID]{7, hegel.Map(uuidSpecs, uuidSpec.build)},
+	)
+)
+
+// ---- spellings -----------------------------------------------------------------------------
+
+type form int
+
+const (
+	plainForm  form = iota // the digits alone
+	bracedForm             // in braces
+	urnForm                // after the urn:uuid: prefix
+)
+
+// spelling: one of the six documented input forms - the 32 hex digits dashed or not, plain,
+// in braces or after the urn:uuid: prefix - in a hex case: all lower (the shrink target), all
+// upper, or upper at the digits upperAt (positions modulo 32). Python's constructor takes all
+// of them.
+type spelling struct {
+	dashed   bool
+	form     form
+	allUpper bool
+	upperAt  []int
+}
+
+func hyphenate(h string) string {
+	return h[0:8] + "-" + h[8:12] + "-" + h[12:16] + "-" + h[16:20] + "-" + h[20:32]
+}
+
+// text spells u.
+func (sp spelling) text(u uuid.UUID) string {
+	h := []byte(hex.EncodeToString(u[:]))
+	upper := func(i int) {
+		if h[i] >= 'a' {
+			h[i] -= 'a' - 'A'
+		}
+	}
+	if sp.allUpper {
+		for i := range h {
+			upper(i)
+		}
+	}
+	for _, at := range sp.upperAt {
+		upper(at % 32)
+	}
+	body := string(h)
+	if sp.dashed {
+		body = hyphenate(body)
+	}
+	switch sp.form {
+	case bracedForm:
+		return "{" + body + "}"
+	case urnForm:
+		return "urn:uuid:" + body
+	}
+	return body
+}
+
+// hexIndex is the index in the spelled text of hex digit number j (0..31).
+func (sp spelling) hexIndex(j int) int {
+	i := j
+	if sp.dashed {
+		for _, cut := range []int{8, 12, 16, 20} {
+			if j >= cut {
+				i++
+			}
+		}
+	}
+	switch sp.form {
+	case bracedForm:
+		i++
+	case urnForm:
+		i += len("urn:uuid:")
+	}
+	return i
+}
+
+var spellings = hegel.Composite(func(tc hegel.TestCase) spelling {
+	return spelling{
+		dashed:   hegel.Draw(tc, hegel.Booleans()),
+		form:     hegel.Draw(tc, hegel.SampledFrom([]form{plainForm, bracedForm, urnForm})),
+		allUpper: hegel.Draw(tc, chance(20)),
+		upperAt:  hegel.Draw(tc, maybe(30, many(hegel.Integers(0, 31), 1, 8))),
+	}
+})
+
+// jsonLiteral is s as a JSON string literal with the characters at escapeAt (positions modulo
+// its length) spelled as \u00XX escapes - a legal spelling of the same string, and the shape of
+// gofrs-uuid/3 for NullUUID; with none it is strconv.Quote's text.
+func jsonLiteral(s string, escapeAt []int) string {
+	esc := map[int]bool{}
+	for _, at := range escapeAt {
+		esc[at%len(s)] = true
+	}
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := 0; i < len(s); i++ {
+		if esc[i] {
+			fmt.Fprintf(&b, `\u%04x`, s[i])
+		} else {
+			b.WriteByte(s[i])
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+// escapePositions: the characters of a JSON string literal spelled as escapes: none (the
+// plain literal) seven times in ten, else one to four; under HEGEL_NO_KNOWN=1 none.
+var escapePositions = shaped[hegel.Generator[[]int]](maybe(30, many(positions, 1, 4)), hegel.Just[[]int](nil))
+
+// ---- mutations of a text -------------------------------------------------------------------
+
+type mutKind int
+
+const (
+	mutNone    mutKind = iota // the text as it is
+	mutDigit                  // a non-hex character in place of hex digit number hexAt (ErrInvalidFormat)
+	mutReplace                // the byte at at replaced by junk
+	mutDelete                 // the byte at at deleted
+	mutInsert                 // junk inserted at at
+	mutWrap                   // a urn spelling with its prefix re-spelled (prefix), any other in other brackets (open, close)
+	mutJunk                   // junk of a plausible length instead (filler)
+)
+
+// mutation is one edit of a spelled UUID; positions are taken modulo the live length.
+type mutation struct {
+	kind        mutKind
+	hexAt       int
+	at          int
+	junk        string
+	prefix      string
+	open, close string
+	filler      string
+}
+
+// apply edits the text s, spelled by sp.
+func (m mutation) apply(s string, sp spelling) string {
+	switch m.kind {
+	case mutDigit:
+		i := sp.hexIndex(m.hexAt % 32)
+		return s[:i] + m.junk + s[i+1:]
+	case mutReplace:
+		i := m.at % len(s)
+		return s[:i] + m.junk + s[i+1:]
+	case mutDelete:
+		i := m.at % len(s)
+		return s[:i] + s[i+1:]
+	case mutInsert:
+		i := m.at % (len(s) + 1)
+		return s[:i] + m.junk + s[i:]
+	case mutWrap:
+		if strings.HasPrefix(s, "urn:uuid:") {
+			return m.prefix + s[len("urn:uuid:"):]
+		}
+		return m.open + s + m.close
+	case mutJunk:
+		return m.filler
+	}
+	return s
+}
+
+var (
+	junkChars   = []string{"-", "g", "G", "z", " ", "\t", "\n", "{", "}", ":", "u", "0", "9", "a", "F", "\u00e9", "\x00", "\xff", "U", "R", "N"}
+	junks       = hegel.SampledFrom(junkChars)
+	nonHexBytes = hegel.SampledFrom([]string{"-", "g", "G", "z", " ", "\t", "\n", "{", "}", ":", "u", "U", "R", "N", "\x00", "\xff"})
+	junkLengths = []int{0, 1, 31, 32, 33, 34, 35, 36, 37, 38, 39, 41, 45, 46}
+	// junkTexts: junk pieces cut to a plausible length in bytes.
+	junkTexts = hegel.FlatMap(hegel.SampledFrom(junkLengths), func(k int) hegel.Generator[string] {
+		return hegel.Map(many(junks, k, k), func(ps []string) string { return strings.Join(ps, "")[:k] })
+	})
+	// edits: a replace, delete or insert at a drawn position with a drawn junk character.
+	edits = func(kind mutKind) hegel.Generator[mutation] {
+		return hegel.Composite(func(tc hegel.TestCase) mutation {
+			return mutation{kind: kind, at: hegel.Draw(tc, positions), junk: hegel.Draw(tc, junks)}
+		})
+	}
+	// digitMutations: a single non-hex byte in place of one of the hex digits hexAt.
+	digitMutations = func(hexAt hegel.Generator[int]) hegel.Generator[mutation] {
+		return hegel.Composite(func(tc hegel.TestCase) mutation {
+			return mutation{kind: mutDigit, hexAt: hegel.Draw(tc, hexAt), junk: hegel.Draw(tc, nonHexBytes)}
+		})
+	}
+	wraps = hegel.Composite(func(tc hegel.TestCase) mutation {
+		return mutation{
+			kind:   mutWrap,
+			prefix: hegel.Draw(tc, hegel.SampledFrom([]string{"URN:UUID:", "Urn:Uuid:", "urn:UUID:", "urn:uuid;"})),
+			open:   hegel.Draw(tc, hegel.SampledFrom([]string{"(", "[", "{"})),
+			close:  hegel.Draw(tc, hegel.SampledFrom([]string{")", "]", "}"})),
+		}
+	})
+	// mutations: the text as it is one time in five, else near it: a bad digit, a replaced,
+	// deleted or inserted byte, a wrong prefix or other brackets, or plausible junk.
+	mutations = weighted(
+		choice[mutation]{20, hegel.Just(mutation{})},
+		choice[mutation]{10, digitMutations(hegel.Integers(0, 31))},
+		choice[mutation]{15, edits(mutReplace)},
+		choice[mutation]{10, edits(mutDelete)},
+		choice[mutation]{10, edits(mutInsert)},
+		choice[mutation]{15, wraps},
+		choice[mutation]{20, hegel.Map(junkTexts, func(s string) mutation { return mutation{kind: mutJunk, filler: s} })},
+	)
+	// rejections: the mutations the grammar always rejects (a bad digit, a wrong length).
+	rejections = weighted(
+		choice[mutation]{2, digitMutations(hegel.Integers(0, 31))},
+		choice[mutation]{1, edits(mutDelete)},
+		choice[mutation]{1, edits(mutInsert)},
+	)
+)
+
+// priors: what a receiver holds before a parse: Nil (a fresh one) half of the time, else a
+// UUID whose bytes show what a rejected parse overwrote (gofrs-uuid/2); under HEGEL_NO_KNOWN=1
+// fresh.
+var priors = shaped[hegel.Generator[uuid.UUID]](maybe(50, uuids), hegel.Just(uuid.Nil))
+
+// ---- the parsing model ---------------------------------------------------------------------
+
+func isHex(c byte) bool {
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
+}
+
+// modelParse is the documented grammar of Parse/FromString/UnmarshalText: lengths 32 and 36,
+// 34 and 38 in braces, 41 and 45 with a lower-case `urn:uuid:` prefix, dashes at 8/13/18/23 in
+// the 36-byte body, hex digits elsewhere; the error values are the package's sentinels.
+func modelParse(s string) (uuid.UUID, error) {
+	var u uuid.UUID
+	body := s
+	switch len(s) {
+	case 32, 36:
+	case 34, 38:
+		if s[0] != '{' || s[len(s)-1] != '}' {
+			return u, uuid.ErrInvalidBraces
+		}
+		body = s[1 : len(s)-1]
+	case 41, 45:
+		if s[:9] != "urn:uuid:" {
+			return u, uuid.ErrInvalidURNPrefix
+		}
+		body = s[9:]
+	default:
+		return u, uuid.ErrIncorrectLength
+	}
+	if len(body) == 36 {
+		if body[8] != '-' || body[13] != '-' || body[18] != '-' || body[23] != '-' {
+			return u, uuid.ErrInvalidDashes
+		}
+		body = body[0:8] + body[9:13] + body[14:18] + body[19:23] + body[24:36]
+	}
+	for i := 0; i < 32; i++ {
+		if !isHex(body[i]) {
+			return u, uuid.ErrInvalidFormat
+		}
+	}
+	b, _ := hex.DecodeString(body)
+	copy(u[:], b)
+	return u, nil
+}
+
+func sameErr(got, want error) bool {
+	if got == nil || want == nil {
+		return got == want
+	}
+	return errors.Is(got, want) || got.Error() == want.Error()
+}
+
+// ---- RFC 9562 layouts ----------------------------------------------------------------------
+
+const g1582ns100 = 122192928000000000 // 100 ns ticks from 1582-10-15 to 1970-01-01
+
+func v1Time(u uuid.UUID) uint64 {
+	return uint64(binary.BigEndian.Uint32(u[0:4])) | uint64(binary.BigEndian.Uint16(u[4:6]))<<32 |
+		uint64(binary.BigEndian.Uint16(u[6:8])&0x0fff)<<48
+}
+
+func v6Time(u uuid.UUID) uint64 {
+	return uint64(binary.BigEndian.Uint32(u[0:4]))<<28 | uint64(binary.BigEndian.Uint16(u[4:6]))<<12 |
+		uint64(binary.BigEndian.Uint16(u[6:8])&0x0fff)
+}
+
+func v7Millis(u uuid.UUID) uint64 { return binary.BigEndian.Uint64(u[0:8]) >> 16 }
+
+// gregorian is the RFC timestamp of t: 100 ns ticks since 1582-10-15 (floor).
+func gregorian(t time.Time) int64 {
+	ns := new(big.Int).Mul(big.NewInt(t.Unix()), big.NewInt(1e9))
+	ns.Add(ns, big.NewInt(int64(t.Nanosecond())))
+	ticks := new(big.Int).Div(ns, big.NewInt(100))
+	return ticks.Int64() + g1582ns100
+}
+
+// representable reports whether NewV1AtTime/NewV6AtTime can encode at: Go's UnixNano holds
+// it (1677-09-21 to 2262-04-11; the seconds at either end are left out), which also puts it
+// after the 1582-10-15 epoch. Outside, an error is the right answer (gofrs-uuid/4).
+func representable(at time.Time) bool {
+	const edge = 9223372036 // UnixNano's range in whole seconds
+	return at.Unix() > -edge && at.Unix() < edge
+}
+
+func variantOf(u uuid.UUID) byte {
+	switch {
+	case u[8]&0x80 == 0:
+		return uuid.VariantNCS
+	case u[8]&0x40 == 0:
+		return uuid.VariantRFC9562
+	case u[8]&0x20 == 0:
+		return uuid.VariantMicrosoft
+	}
+	return uuid.VariantFuture
+}
+
+var pyVariant = map[byte]string{
+	uuid.VariantNCS: "reserved for NCS compatibility", uuid.VariantRFC9562: "specified in RFC 4122",
+	uuid.VariantMicrosoft: "reserved for Microsoft compatibility", uuid.VariantFuture: "reserved for future definition",
+}
+
+// ---- instants and the scripted generator ---------------------------------------------------
+
+// unixTimes: instants of the drawn seconds and nanoseconds, in UTC.
+func unixTimes(secs, nanos hegel.Generator[int64]) hegel.Generator[time.Time] {
+	return hegel.Composite(func(tc hegel.TestCase) time.Time {
+		return time.Unix(hegel.Draw(tc, secs), hegel.Draw(tc, nanos)).UTC()
+	})
+}
+
+var (
+	nanos = hegel.Integers[int64](0, 999_999_999)
+	// hundreds: nanoseconds that are a multiple of 100, for instants before 1970 (a timestamp
+	// there is truncated toward zero, README).
+	hundreds = hegel.Map(hegel.Integers[int64](0, 9_999_999), func(n int64) int64 { return n * 100 })
+	// tameInstants: an instant NewV1AtTime/NewV6AtTime can represent: 1970-2033, before 1970
+	// (down to 1678), 2033-2261, or around now.
+	tameInstants = weighted(
+		choice[time.Time]{1, unixTimes(hegel.Integers[int64](0, 2_000_000_000), nanos)},
+		choice[time.Time]{1, unixTimes(hegel.Integers[int64](-9_200_000_000, -1), hundreds)},
+		choice[time.Time]{1, unixTimes(hegel.Integers[int64](2_000_000_000, 9_200_000_000), nanos)},
+		choice[time.Time]{1, hegel.Map(hegel.Integers[int64](-1_000_000_000, 1_000_000_000), func(d int64) time.Time {
+			return time.Now().Add(time.Duration(d)).UTC()
+		})},
+	)
+	// wildInstants: an instant they cannot: after 2262-04-11 (up to 5138, within the 60-bit
+	// field), between 1582-10-15 and 1677-09-21 (the field holds it, Go's UnixNano does not),
+	// or before the 1582-10-15 epoch (year 1 on). The shape of gofrs-uuid/4.
+	wildInstants = weighted(
+		choice[time.Time]{1, unixTimes(hegel.Integers[int64](9_300_000_000, 100_000_000_000), nanos)},
+		choice[time.Time]{1, unixTimes(hegel.Integers[int64](-12_219_292_800, -9_300_000_000), hundreds)},
+		choice[time.Time]{1, unixTimes(hegel.Integers[int64](-62_135_596_800, -12_219_292_801), hundreds)},
+	)
+	// instants: the scripted clock's readings: tame, and one time in five wild (v7 pins those to
+	// its field's ends, as documented); under HEGEL_NO_KNOWN=1 tame only.
+	instants = shaped[hegel.Generator[time.Time]](weighted(choice[time.Time]{80, tameInstants}, choice[time.Time]{20, wildInstants}), tameInstants)
+)
+
+// call is one call of a time-based version: NewVxAtTime(at), or NewVx() with the clock reading at.
+type call struct {
+	atTime bool
+	at     time.Time
+}
+
+func (k call) String() string {
+	if k.atTime {
+		return fmt.Sprintf("AtTime(%v)", k.at)
+	}
+	return fmt.Sprintf("clock(%v)", k.at)
+}
+
+var calls = hegel.Composite(func(tc hegel.TestCase) call {
+	return call{atTime: hegel.Draw(tc, hegel.Booleans()), at: hegel.Draw(tc, instants)}
+})
+
+// hwAddrs: a hardware address seven times in ten; nil: the address function fails and the
+// node comes from the stream.
+var hwAddrs = maybe(70, hegel.Binary(6, 6))
+
+// scripted is a generator whose clock, random bytes and hardware address are under the test's
+// control; reads past the script fail (which the library must report, not hide).
+type scripted struct {
+	gen    *uuid.Gen
+	clock  []time.Time // the clock reading of call i is clock[i]
+	tick   int         // the call in progress
+	script []byte
+	hw     []byte
+}
+
+func newScripted(script []byte, cs []call, hw []byte) *scripted {
+	s := &scripted{script: script, hw: hw}
+	for _, k := range cs {
+		s.clock = append(s.clock, k.at)
+	}
+	s.gen = uuid.NewGenWithOptions(
+		uuid.WithRandomReader(bytes.NewReader(script)),
+		uuid.WithEpochFunc(func() time.Time { return s.clock[s.tick] }),
+		uuid.WithHWAddrFunc(func() (net.HardwareAddr, error) {
+			if s.hw == nil {
+				return nil, errors.New("no interface")
+			}
+			return net.HardwareAddr(s.hw), nil
+		}),
+	)
+	return s
+}
+
+// ---- cases ---------------------------------------------------------------------------------
+
+// parseCase: a UUID, its spelling, and the JSON spelling of that text.
+type parseCase struct {
+	u        uuid.UUID
+	sp       spelling
+	escapeAt []int
+}
+
+func (c parseCase) text() string { return c.sp.text(c.u) }
+
+func (c parseCase) GoString() string {
+	return fmt.Sprintf("text %q json %s", c.text(), jsonLiteral(c.text(), c.escapeAt))
+}
+
+var parseCases = hegel.Composite(func(tc hegel.TestCase) parseCase {
+	return parseCase{u: hegel.Draw(tc, uuids), sp: hegel.Draw(tc, spellings), escapeAt: hegel.Draw(tc, escapePositions)}
+})
+
+// grammarCase: a spelling, an edit of it, and what the receivers hold before the parse.
+type grammarCase struct {
+	u     uuid.UUID
+	sp    spelling
+	mut   mutation
+	prior uuid.UUID
+}
+
+func (c grammarCase) text() string { return c.mut.apply(c.sp.text(c.u), c.sp) }
+
+func (c grammarCase) GoString() string { return fmt.Sprintf("text %q prior %v", c.text(), c.prior) }
+
+var grammarCases = hegel.Composite(func(tc hegel.TestCase) grammarCase {
+	return grammarCase{u: hegel.Draw(tc, uuids), sp: hegel.Draw(tc, spellings), mut: hegel.Draw(tc, mutations), prior: hegel.Draw(tc, priors)}
+})
+
+// fieldsCase: a UUID and the version and variant to set on it.
+type fieldsCase struct {
+	u       uuid.UUID
+	version int
+	variant int
+}
+
+func (c fieldsCase) GoString() string {
+	return fmt.Sprintf("u %v set version %d variant %d", c.u, c.version, c.variant)
+}
+
+var fieldsCases = hegel.Composite(func(tc hegel.TestCase) fieldsCase {
+	return fieldsCase{u: hegel.Draw(tc, uuids), version: hegel.Draw(tc, hegel.Integers(0, 15)), variant: hegel.Draw(tc, hegel.Integers(0, 3))}
+})
+
+// nameCase: a name space and the bytes of a name (invalid UTF-8 included).
+type nameCase struct {
+	ns   uuid.UUID
+	name []byte
+}
+
+func (c nameCase) GoString() string { return fmt.Sprintf("ns %v name %x", c.ns, c.name) }
+
+var nameCases = hegel.Composite(func(tc hegel.TestCase) nameCase {
+	return nameCase{ns: hegel.Draw(tc, uuids), name: hegel.Draw(tc, hegel.Binary(0, 48))}
+})
+
+// rfcCase: a kind of generator call, the calls (with their clock readings), the random stream
+// and the hardware address; the v8 fields and the wrong lengths tried; the version and the
+// too-short stream of the short kind.
+type rfcCase struct {
+	kind   string
+	calls  []call
+	script []byte // 2 (the clock sequence) + 6 (a node) + 16 per call; the short kind's whole stream
+	hw     []byte
+	// v8
+	a, b, c    []byte
+	la, lb, lc int
+	// short
+	short string
+}
+
+func (c rfcCase) GoString() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "kind %s", c.kind)
+	for _, k := range c.calls {
+		fmt.Fprintf(&b, " %v", k)
+	}
+	fmt.Fprintf(&b, " hw %x script %x", c.hw, c.script)
+	switch c.kind {
+	case "v8":
+		fmt.Fprintf(&b, " a %x b %x c %x wrong lengths %d %d %d", c.a, c.b, c.c, c.la, c.lb, c.lc)
+	case "short":
+		fmt.Fprintf(&b, " %s from %d bytes", c.short, len(c.script))
+	}
+	return b.String()
+}
+
+var (
+	// timedCases: one to six calls of a time-based (or v4) kind on a stream long enough.
+	timedCases = func(kind string) hegel.Generator[rfcCase] {
+		return hegel.Composite(func(tc hegel.TestCase) rfcCase {
+			cs := hegel.Draw(tc, many(calls, 1, 6))
+			n := 2 + 6 + 16*len(cs)
+			return rfcCase{kind: kind, calls: cs, script: hegel.Draw(tc, hegel.Binary(n, n)), hw: hegel.Draw(tc, hwAddrs)}
+		})
+	}
+	v8Cases = hegel.Composite(func(tc hegel.TestCase) rfcCase {
+		return rfcCase{
+			kind:   "v8",
+			script: hegel.Draw(tc, hegel.Binary(24, 24)),
+			hw:     hegel.Draw(tc, hwAddrs),
+			a:      hegel.Draw(tc, hegel.Binary(6, 6)),
+			b:      hegel.Draw(tc, hegel.Binary(2, 2)),
+			c:      hegel.Draw(tc, hegel.Binary(8, 8)),
+			la:     hegel.Draw(tc, hegel.SampledFrom([]int{0, 5, 7})),
+			lb:     hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 3})),
+			lc:     hegel.Draw(tc, hegel.SampledFrom([]int{0, 7, 9})),
+		}
+	})
+	// shortStream: the bytes each version reads before it can succeed, less one.
+	shortStream = map[string]int{"v4": 15, "v1": 7, "v6": 9, "v7": 9}
+	// shortCases: a version and a stream too short for it.
+	shortCases = hegel.FlatMap(hegel.SampledFrom([]string{"v4", "v1", "v6", "v7"}), func(v string) hegel.Generator[rfcCase] {
+		return hegel.Composite(func(tc hegel.TestCase) rfcCase {
+			k := hegel.Draw(tc, hegel.Integers(0, shortStream[v]))
+			return rfcCase{kind: "short", short: v, calls: []call{hegel.Draw(tc, calls)}, script: hegel.Draw(tc, hegel.Binary(k, k))}
+		})
+	})
+	rfcKinds    = []string{"v4", "v1", "v6", "v7", "v8", "short"}
+	rfcCaseGens = map[string]hegel.Generator[rfcCase]{
+		"v4": timedCases("v4"), "v1": timedCases("v1"), "v6": timedCases("v6"), "v7": timedCases("v7"),
+		"v8": v8Cases, "short": shortCases,
+	}
+	rfcCases = hegel.FlatMap(hegel.SampledFrom(rfcKinds), func(kind string) hegel.Generator[rfcCase] { return rfcCaseGens[kind] })
+)
+
+// encCase: a UUID and the box around it (a NullUUID valid or not, holding Nil or u when not,
+// a slice), what the NullUUID that Scans the Value holds, an unsupported Scan source and a
+// wrong binary length.
+type encCase struct {
+	u      uuid.UUID
+	valid  bool
+	nilOpt bool
+	many   []uuid.UUID
+	prior  uuid.UUID
+	badSrc any
+	k      int
+}
+
+func (c encCase) GoString() string {
+	return fmt.Sprintf("u %v valid %v nilOpt %v many %v prior %v bad %#v k %d", c.u, c.valid, c.nilOpt, c.many, c.prior, c.badSrc, c.k)
+}
+
+var encCases = hegel.Composite(func(tc hegel.TestCase) encCase {
+	return encCase{
+		u:      hegel.Draw(tc, uuids),
+		valid:  hegel.Draw(tc, chance(70)),
+		nilOpt: hegel.Draw(tc, chance(50)),
+		many:   nonNil(hegel.Draw(tc, many(uuids, 0, 3))),
+		prior:  hegel.Draw(tc, uuids),
+		badSrc: hegel.Draw(tc, hegel.SampledFrom([]any{nil, 42, 1.5, true, struct{}{}})),
+		k:      hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 15, 17, 32})),
+	}
+})
+
+// ---- properties ----------------------------------------------------------------------------
+
+// TestHegelParseAgreesWithPython: every documented spelling parses (FromString, FromStringOrNil,
+// Parse, UnmarshalText, Scan of a string and of text bytes, json.Unmarshal) to the same 16 bytes
+// as Python's constructor, and String/MarshalText/Value/Format print Python's spellings. The
+// JSON spelling may hold \u escapes: json.Unmarshal into a UUID reads them, into a NullUUID
+// (which parses the raw token) it does not (gofrs-uuid/3).
+func TestHegelParseAgreesWithPython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, parseCases)
+		u, s := c.u, c.text()
+		got, err := uuid.FromString(s)
+		if err != nil || got != u {
+			fail(ht, "FromString(%q) = %v, %v; want %v", s, got, err, u)
+		}
+		if gn := uuid.FromStringOrNil(s); gn != u {
+			fail(ht, "FromStringOrNil(%q) = %v; want %v", s, gn, u)
+		}
+		var up uuid.UUID
+		if err := up.Parse(s); err != nil || up != u {
+			fail(ht, "Parse(%q) = %v, %v; want %v", s, up, err, u)
+		}
+		var ut uuid.UUID
+		if err := ut.UnmarshalText([]byte(s)); err != nil || ut != u {
+			fail(ht, "UnmarshalText(%q) = %v, %v; want %v", s, ut, err, u)
+		}
+		var us uuid.UUID
+		if err := us.Scan(s); err != nil || us != u {
+			fail(ht, "Scan(%q) = %v, %v; want %v", s, us, err, u)
+		}
+		var ub uuid.UUID
+		if err := ub.Scan([]byte(s)); err != nil || ub != u {
+			fail(ht, "Scan([]byte(%q)) = %v, %v; want %v", s, ub, err, u)
+		}
+		lit := jsonLiteral(s, c.escapeAt)
+		var js uuid.UUID
+		if err := json.Unmarshal([]byte(lit), &js); err != nil || js != u {
+			fail(ht, "json.Unmarshal(%s) = %v, %v; want %v", lit, js, err, u)
+		}
+		var nj uuid.NullUUID
+		if err := json.Unmarshal([]byte(lit), &nj); err != nil || nj.UUID != u || !nj.Valid {
+			mismatch(ht, shapeIf(len(c.escapeAt) > 0, "gofrs-uuid/3"), "json.Unmarshal(%s) into NullUUID = %+v, %v; want %v", lit, nj, err, u)
+		}
+		pp := py.parse(t, s)
+		if !pp.OK || pp.Hex != hex.EncodeToString(u[:]) {
+			fail(ht, "Python UUID(%q) = %+v; Go parsed %v", s, pp, u)
+		}
+		// outputs vs Python
+		pf := py.fromBytes(t, u[:])
+		if u.String() != pf.Str {
+			fail(ht, "String() = %q; Python %q", u.String(), pf.Str)
+		}
+		if mt, err := u.MarshalText(); err != nil || string(mt) != pf.Str {
+			fail(ht, "MarshalText() = %q, %v; Python %q", mt, err, pf.Str)
+		}
+		if v, err := u.Value(); err != nil || v != driver.Value(pf.Str) {
+			fail(ht, "Value() = %v, %v; Python %q", v, err, pf.Str)
+		}
+		if fmt.Sprintf("%v|%s|%x|%X|%S|%q", u, u, u, u, u, u) !=
+			pf.Str+"|"+pf.Str+"|"+pf.Hex+"|"+strings.ToUpper(pf.Hex)+"|"+strings.ToUpper(pf.Str)+"|"+strconv.Quote(pf.Str) {
+			fail(ht, "Format verbs of %v: %q", u, fmt.Sprintf("%v|%s|%x|%X|%S|%q", u, u, u, u, u, u))
+		}
+		if fmt.Sprintf("%#v", u) != fmt.Sprintf("%#v", [16]byte(u)) {
+			fail(ht, "%%#v of %v = %s", u, fmt.Sprintf("%#v", u))
+		}
+		if "urn:uuid:"+u.String() != pf.URN {
+			fail(ht, "urn of %v: Python %q", u, pf.URN)
+		}
+	})
+}
+
+// TestHegelParseFollowsTheDocumentedGrammar: on arbitrary (mostly near-valid) text FromString,
+// Parse, UnmarshalText and Scan accept exactly the documented forms and return the documented
+// error values, FromStringOrNil is Nil on error, and whatever is accepted Python parses to the
+// same value. A rejected text leaves the receiver as it was (gofrs-uuid/2 writes the digits
+// before the bad one) and a rejected Scan into a NullUUID leaves Valid false (gofrs-uuid/1
+// sets it first).
+func TestHegelParseFollowsTheDocumentedGrammar(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, grammarCases)
+		s := c.text()
+		want, wantErr := modelParse(s)
+		got, err := uuid.FromString(s)
+		if !sameErr(err, wantErr) || (wantErr == nil && got != want) {
+			fail(ht, "FromString(%q) = %v, %v; model %v, %v", s, got, err, want, wantErr)
+		}
+		if wantErr != nil && !errors.Is(err, uuid.ErrIncorrectLength) && !errors.Is(err, uuid.ErrIncorrectFormatInString) && !errors.Is(err, uuid.ErrInvalidFormat) {
+			fail(ht, "FromString(%q) error %v matches none of the documented sentinels", s, err)
+		}
+		if on := uuid.FromStringOrNil(s); (err == nil && on != got) || (err != nil && on != uuid.Nil) {
+			fail(ht, "FromStringOrNil(%q) = %v; FromString %v, %v", s, on, got, err)
+		}
+		// The receivers: Parse, UnmarshalText and Scan of text bytes (a 16-byte text would be
+		// read as binary; no text here is that short) agree with FromString and, when they
+		// reject, leave the receiver as it was. Under HEGEL_NO_KNOWN=1 an ErrInvalidFormat
+		// rejection, whose bytes before the bad digit are written (gofrs-uuid/2), is not judged.
+		partial := errors.Is(err, uuid.ErrInvalidFormat)
+		for _, p := range []struct {
+			name  string
+			parse func(*uuid.UUID) error
+		}{
+			{"Parse", func(u *uuid.UUID) error { return u.Parse(s) }},
+			{"UnmarshalText", func(u *uuid.UUID) error { return u.UnmarshalText([]byte(s)) }},
+			{"Scan([]byte)", func(u *uuid.UUID) error { return u.Scan([]byte(s)) }},
+		} {
+			if p.name == "Scan([]byte)" && len(s) == uuid.Size {
+				continue
+			}
+			rcv := c.prior
+			errP := p.parse(&rcv)
+			if !sameErr(errP, err) || (err == nil && rcv != got) {
+				fail(ht, "%s(%q) = %v, %v; FromString %v, %v", p.name, s, rcv, errP, got, err)
+			}
+			if err != nil && rcv != c.prior && !(Known.partialParse && partial) {
+				mismatch(ht, shapeIf(partial, "gofrs-uuid/2"), "%s(%q) = %v; receiver now %v (was %v)", p.name, s, errP, rcv, c.prior)
+			}
+		}
+		// Scan of a string and of text bytes into a UUID and a NullUUID: the UUID agrees with
+		// FromString; the NullUUID is Valid exactly when the Scan succeeded. Under
+		// HEGEL_NO_KNOWN=1 the flag after a rejection (gofrs-uuid/1) is not judged.
+		srcs := []any{s}
+		if len(s) != uuid.Size {
+			srcs = append(srcs, []byte(s))
+		}
+		for _, src := range srcs {
+			us := c.prior
+			if errS := us.Scan(src); !sameErr(errS, err) || (err == nil && us != got) {
+				fail(ht, "Scan(%T %q) = %v, %v; FromString %v, %v", src, s, us, errS, got, err)
+			}
+			ns := uuid.NullUUID{UUID: c.prior}
+			errN := ns.Scan(src)
+			if !sameErr(errN, err) || (err == nil && (ns.UUID != got || !ns.Valid)) {
+				fail(ht, "NullUUID.Scan(%T %q) = %+v, %v; FromString %v, %v", src, s, ns, errN, got, err)
+			}
+			if err != nil && ns.Valid && !Known.scanValid {
+				mismatch(ht, "gofrs-uuid/1", "NullUUID.Scan(%T %q) = %v but left %+v", src, s, errN, ns)
+			}
+		}
+		if err == nil {
+			pp := py.parse(t, s)
+			if !pp.OK || pp.Hex != hex.EncodeToString(got[:]) {
+				fail(ht, "Python UUID(%q) = %+v; Go parsed %v", s, pp, got)
+			}
+		}
+	})
+}
