+// TestHegelGeneratorsFollowTheRFC: a generator with a scripted clock, random stream and
+// hardware address produces exactly the RFC 9562 layouts — version 1 (time fields, a 14-bit
+// clock sequence seeded from the stream and advanced when the instant does not move forward,
+// the node from the interface or from the stream with the multicast bit), version 6 (the same
+// timestamp reordered, random low half), version 4 (the stream with the bits set), version 7
+// (millisecond timestamp, a counter seeded from 11 bits of the stream and advanced within a
+// millisecond, rand_b from the stream; a backwards clock is clamped for NewV7 and honoured for
+// NewV7AtTime; out-of-range instants pinned to the field's ends) and version 8 (the custom
+// fields with the bits set); short streams are errors.
+func TestHegelGeneratorsFollowTheRFC(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		kind := pick(ht, []string{"v1", "v6", "v4", "v7", "v8", "short"})
+		calls := n(ht, 1, 6)
+		s := newScripted(ht, 2+6+16*calls, calls)
+		pos := 0
+		next := func(k int) []byte {
+			b := s.script[pos : pos+k]
+			pos += k
+			return b
+		}
+		note(ht, "kind %s calls %d hw %x clocks %v", kind, calls, s.hw, s.clock)
+		switch kind {
+		case "v1", "v6":
+			seed := binary.BigEndian.Uint16(next(2)) // the clock sequence, seeded once
+			var last uint64
+			node := s.hw
+			for i := 0; i < calls; i++ {
+				s.tick = i
+				at := s.clock[i]
+				atTime := chance(ht, 50)
+				var u uuid.UUID
+				var err error
+				if kind == "v1" {
+					if atTime {
+						u, err = s.gen.NewV1AtTime(at)
+					} else {
+						u, err = s.gen.NewV1()
+					}
+				} else if atTime {
+					u, err = s.gen.NewV6AtTime(at)
+				} else {
+					u, err = s.gen.NewV6()
+				}
+				if err != nil {
+					fail(ht, "%s call %d at %v: %v", kind, i, at, err)
+				}
+				ticks := uint64(gregorian(at))
+				if i > 0 && ticks <= last {
+					seed++
+				}
+				last = ticks
+				if kind == "v1" && node == nil {
+					node = append([]byte(nil), next(6)...)
+					node[0] |= 0x01
+				}
+				if kind == "v1" {
+					if u.Version() != 1 || u.Variant() != uuid.VariantRFC9562 || v1Time(u) != ticks ||
+						binary.BigEndian.Uint16(u[8:10])&0x3fff != seed&0x3fff || !bytes.Equal(u[10:], node) {
+						fail(ht, "v1 call %d at %v = %v: time %d (want %d), clock seq %#x (want %#x), node %x (want %x)",
+							i, at, u, v1Time(u), ticks, binary.BigEndian.Uint16(u[8:10])&0x3fff, seed&0x3fff, u[10:], node)
+					}
+					ts, _ := uuid.TimestampFromV1(u)
+					if tm, _ := ts.Time(); !tm.Equal(at.Truncate(100 * time.Nanosecond)) {
+						fail(ht, "v1 call %d at %v: Timestamp.Time() = %v", i, at, tm)
+					}
+				} else {
+					low := next(8)
+					if u.Version() != 6 || u.Variant() != uuid.VariantRFC9562 || v6Time(u) != ticks ||
+						u[8]&0x3f != low[0]&0x3f || !bytes.Equal(u[9:], low[1:]) {
+						fail(ht, "v6 call %d at %v = %v: time %d (want %d), low half %x (stream %x)", i, at, u, v6Time(u), ticks, u[8:], low)
+					}
+					ts, _ := uuid.TimestampFromV6(u)
+					if tm, _ := ts.Time(); !tm.Equal(at.Truncate(100 * time.Nanosecond)) {
+						fail(ht, "v6 call %d at %v: Timestamp.Time() = %v", i, at, tm)
+					}
+				}
+			}
+		case "v4":
+			for i := 0; i < calls; i++ {
+				u, err := s.gen.NewV4()
+				r := next(16)
+				if err != nil || !bytes.Equal(u[:6], r[:6]) || u[6] != r[6]&0x0f|0x40 || u[7] != r[7] || u[8] != r[8]&0x3f|0x80 || !bytes.Equal(u[9:], r[9:]) {
+					fail(ht, "NewV4 call %d = %v, %v; stream %x", i, u, err, r)
+				}
+			}
+		case "v7":
+			var lastMs, lastReq uint64
+			var counter uint16
+			seeded := false
+			var prev uuid.UUID
+			for i := 0; i < calls; i++ {
+				s.tick = i
+				at := s.clock[i]
+				atTime := chance(ht, 50)
+				ms := uint64(max(at.UnixMilli(), 0))
+				if ms > 1<<48-1 {
+					ms = 1<<48 - 1
+				}
+				var u uuid.UUID
+				var err error
+				if atTime {
+					u, err = s.gen.NewV7AtTime(at)
+				} else {
+					u, err = s.gen.NewV7()
+				}
+				if err != nil {
+					fail(ht, "v7 call %d at %v: %v", i, at, err)
+				}
+				older := atTime && ms < lastReq // the one case where the ordering guarantee is suspended
+				if !seeded || ms > lastMs || older {
+					counter = binary.BigEndian.Uint16(next(2)) & 0x07ff
+					seeded, lastMs, lastReq = true, ms, ms
+				} else {
+					counter++ // at most 6 calls: no rollover
+					lastReq = ms
+				}
+				rb := next(8)
+				if u.Version() != 7 || u.Variant() != uuid.VariantRFC9562 || v7Millis(u) != lastMs ||
+					binary.BigEndian.Uint16(u[6:8])&0x0fff != counter || u[8]&0x3f != rb[0]&0x3f || !bytes.Equal(u[9:], rb[1:]) {
+					fail(ht, "v7 call %d (%v, atTime %v) = %v: ms %d (want %d), counter %#x (want %#x), rand_b %x (stream %x)",
+						i, at, atTime, u, v7Millis(u), lastMs, binary.BigEndian.Uint16(u[6:8])&0x0fff, counter, u[8:], rb)
+				}
+				ts, _ := uuid.TimestampFromV7(u)
+				if tm, _ := ts.Time(); tm.UnixMilli() != int64(lastMs) {
+					fail(ht, "v7 call %d: Timestamp.Time() = %v (ms %d)", i, tm, lastMs)
+				}
+				if i > 0 && !older && bytes.Compare(prev[:], u[:]) >= 0 {
+					fail(ht, "v7 call %d not increasing: %v then %v", i, prev, u)
+				}
+				prev = u
+			}
+		case "v8":
+			a, b, c := genBytes(ht, 6), genBytes(ht, 2), genBytes(ht, 8)
+			u, err := s.gen.NewV8(a, b, c)
+			if err != nil || !bytes.Equal(u[:6], a) || u[6] != b[0]&0x0f|0x80 || u[7] != b[1] || u[8] != c[0]&0x3f|0x80 || !bytes.Equal(u[9:], c[1:]) {
+				fail(ht, "NewV8(%x, %x, %x) = %v, %v", a, b, c, u, err)
+			}
+			if pu, perr := uuid.NewV8(a, b, c); perr != nil || pu != u {
+				fail(ht, "package NewV8 = %v, %v; generator %v", pu, perr, u)
+			}
+			la, lb, lc := pick(ht, []int{0, 5, 7}), pick(ht, []int{0, 1, 3}), pick(ht, []int{0, 7, 9})
+			if _, err := s.gen.NewV8(make([]byte, la), b, c); !errors.Is(err, uuid.ErrV8FieldLength) {
+				fail(ht, "NewV8 with a %d-byte customA: %v", la, err)
+			}
+			if _, err := s.gen.NewV8(a, make([]byte, lb), c); !errors.Is(err, uuid.ErrV8FieldLength) {
+				fail(ht, "NewV8 with a %d-byte customB: %v", lb, err)
+			}
+			if _, err := s.gen.NewV8(a, b, make([]byte, lc)); !errors.Is(err, uuid.ErrV8FieldLength) {
+				fail(ht, "NewV8 with a %d-byte customC: %v", lc, err)
+			}
+		case "short":
+			// A stream too short for the request is an error and a Nil UUID, never a panic.
+			k := n(ht, 0, 15)
+			g := uuid.NewGenWithOptions(uuid.WithRandomReader(bytes.NewReader(s.script[:k])),
+				uuid.WithHWAddrFunc(func() (net.HardwareAddr, error) { return nil, errors.New("none") }))
+			var u uuid.UUID
+			var err error
+			switch pick(ht, []string{"v1", "v4", "v6", "v7"}) {
+			case "v1":
+				if k >= 8 {
+					return
+				}
+				u, err = g.NewV1AtTime(s.clock[0])
+			case "v4":
+				u, err = g.NewV4()
+			case "v6":
+				if k >= 10 {
+					return
+				}
+				u, err = g.NewV6AtTime(s.clock[0])
+			case "v7":
+				if k >= 10 {
+					return
+				}
+				u, err = g.NewV7AtTime(s.clock[0])
+			}
+			if err == nil || u != uuid.Nil {
+				fail(ht, "%d-byte stream: %v, %v", k, u, err)
+			}
+		}
+	})
+}
+
+type box struct {
+	ID   uuid.UUID     `json:"id"`
+	Opt  uuid.NullUUID `json:"opt"`
+	Many []uuid.UUID   `json:"many"`
+}
+
+// TestHegelEncodingsRoundTrip: JSON (UUID, NullUUID including null, slices), text and binary
+// marshalling, FromBytes/FromBytesOrNil, database/sql Scan/Value on fresh destinations
+// (strings, 16-byte binaries, text bytes, a UUID value, NULL into NullUUID) all invert each
+// other; wrong binary lengths and unsupported Scan sources are the documented errors.
+func TestHegelEncodingsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		u := genUUID(ht)
+		valid := chance(ht, 70)
+		many := make([]uuid.UUID, n(ht, 0, 3))
+		for i := range many {
+			many[i] = genUUID(ht)
+		}
+		in := box{ID: u, Opt: uuid.NullUUID{UUID: u, Valid: valid}, Many: many}
+		if !valid && chance(ht, 50) {
+			in.Opt.UUID = uuid.Nil
+		}
+		note(ht, "u %v valid %v many %v", u, valid, many)
+		js, err := json.Marshal(in)
+		if err != nil {
+			fail(ht, "json.Marshal(%+v): %v", in, err)
+		}
+		wantOpt := "null"
+		if valid {
+			wantOpt = strconv.Quote(u.String())
+		}
+		strs := make([]string, len(many))
+		for i, m := range many {
+			strs[i] = m.String()
+		}
+		wantMany, _ := json.Marshal(strs)
+		if len(many) == 0 {
+			wantMany = []byte("[]")
+		}
+		want := fmt.Sprintf(`{"id":%q,"opt":%s,"many":%s}`, u.String(), wantOpt, wantMany)
+		if string(js) != want {
+			fail(ht, "json.Marshal = %s; want %s", js, want)
+		}
+		var out box
+		if err := json.Unmarshal(js, &out); err != nil {
+			fail(ht, "json.Unmarshal(%s): %v", js, err)
+		}
+		if out.ID != u || out.Opt.Valid != valid || (valid && out.Opt.UUID != u) || (!valid && out.Opt.UUID != uuid.Nil) || (len(many) > 0 && !reflect.DeepEqual(out.Many, many)) || (len(many) == 0 && len(out.Many) != 0) {
+			fail(ht, "json round trip of %s gave %+v", js, out)
+		}
+		nj, err := in.Opt.MarshalJSON()
+		if err != nil || string(nj) != wantOpt {
+			fail(ht, "NullUUID.MarshalJSON = %s, %v; want %s", nj, err, wantOpt)
+		}
+		var nu uuid.NullUUID
+		if err := nu.UnmarshalJSON(nj); err != nil || nu.Valid != valid || (valid && nu.UUID != u) || (!valid && nu.UUID != uuid.Nil) {
+			fail(ht, "NullUUID.UnmarshalJSON(%s) = %+v, %v", nj, nu, err)
+		}
+		// Text and binary.
+		mt, _ := u.MarshalText()
+		var ut uuid.UUID
+		if err := ut.UnmarshalText(mt); err != nil || ut != u {
+			fail(ht, "UnmarshalText(MarshalText(%v)) = %v, %v", u, ut, err)
+		}
+		mb, _ := u.MarshalBinary()
+		var ub uuid.UUID
+		if err := ub.UnmarshalBinary(mb); err != nil || ub != u || !bytes.Equal(mb, u[:]) {
+			fail(ht, "UnmarshalBinary(MarshalBinary(%v)) = %v, %v (binary %x)", u, ub, err, mb)
+		}
+		if fb, err := uuid.FromBytes(mb); err != nil || fb != u || uuid.FromBytesOrNil(mb) != u {
+			fail(ht, "FromBytes(%x) = %v, %v", mb, fb, err)
+		}
+		// database/sql.
+		v, err := u.Value()
+		if err != nil || v != driver.Value(u.String()) {
+			fail(ht, "Value(%v) = %v, %v", u, v, err)
+		}
+		for _, src := range []any{v, u[:], []byte(u.String()), u} {
+			var us uuid.UUID
+			if err := us.Scan(src); err != nil || us != u {
+				fail(ht, "Scan(%T %v) = %v, %v; want %v", src, src, us, err, u)
+			}
+			var ns uuid.NullUUID
+			if err := ns.Scan(src); err != nil || ns.UUID != u || !ns.Valid {
+				fail(ht, "NullUUID.Scan(%T %v) = %+v, %v; want %v", src, src, ns, err, u)
+			}
+		}
+		nv, err := in.Opt.Value()
+		if err != nil || (valid && nv != driver.Value(u.String())) || (!valid && nv != nil) {
+			fail(ht, "NullUUID.Value(%+v) = %v, %v", in.Opt, nv, err)
+		}
+		ns := uuid.NullUUID{UUID: genUUID(ht), Valid: true}
+		if err := ns.Scan(nv); err != nil || ns.Valid != valid || (valid && ns.UUID != u) || (!valid && ns.UUID != uuid.Nil) {
+			fail(ht, "NullUUID.Scan(%v) = %+v, %v", nv, ns, err)
+		}
+		var bad uuid.UUID
+		if err := bad.Scan(pick(ht, []any{nil, 42, 1.5, true, struct{}{}})); !errors.Is(err, uuid.ErrTypeConvertError) {
+			fail(ht, "Scan of an unsupported type: %v", err)
+		}
+		k := pick(ht, []int{0, 1, 15, 17, 32})
+		if err := bad.UnmarshalBinary(make([]byte, k)); !errors.Is(err, uuid.ErrIncorrectByteLength) {
+			fail(ht, "UnmarshalBinary of %d bytes: %v", k, err)
+		}
+		if _, err := uuid.FromBytes(make([]byte, k)); !errors.Is(err, uuid.ErrIncorrectByteLength) || uuid.FromBytesOrNil(make([]byte, k)) != uuid.Nil {
+			fail(ht, "FromBytes of %d bytes: %v", k, err)
+		}
+	})
+}
+
+// ---- pins ----------------------------------------------------------------------------------
+
+// gofrs-uuid/1: NullUUID.Scan sets Valid = true before delegating, so a rejected source leaves
+// Valid = true (with a half-written UUID) alongside the error.
+func TestHegelPinNullUUIDScanOfBadInputIsInvalid(t *testing.T) {
+	defer guard(t)
+	for _, src := range []any{"6ba7b810-9dad-11d1-80b4-00c04fd430cX", []byte("not a uuid at all, thirty-six by"), "x"} {
+		var nu uuid.NullUUID
+		err := nu.Scan(src)
+		if err == nil {
+			t.Fatalf("NullUUID.Scan(%#v) accepted", src)
+		}
+		if nu.Valid {
+			t.Fatalf("NullUUID.Scan(%#v) = %v but left %+v", src, err, nu)
+		}
+	}
+}
+
+// gofrs-uuid/2: Parse, UnmarshalText and Scan decode into the receiver byte by byte, so a
+// rejected string leaves a mixture of old and new bytes in the destination.
+func TestHegelPinRejectedTextLeavesTheReceiverUnchanged(t *testing.T) {
+	defer guard(t)
+	old := uuid.Must(uuid.FromString("ffffffff-ffff-ffff-ffff-ffffffffffff"))
+	bad := "6ba7b810-9dad-11d1-80b4-00c04fd430cX"
+	u := old
+	if err := u.Parse(bad); err == nil || u != old {
+		t.Fatalf("Parse(%q) = %v; receiver now %v (was %v)", bad, err, u, old)
+	}
+	u = old
+	if err := u.UnmarshalText([]byte(bad)); err == nil || u != old {
+		t.Fatalf("UnmarshalText(%q) = %v; receiver now %v (was %v)", bad, err, u, old)
+	}
+	u = old
+	if err := u.Scan([]byte(bad)); err == nil || u != old {
+		t.Fatalf("Scan(%q) = %v; receiver now %v (was %v)", bad, err, u, old)
+	}
+}
+
+// gofrs-uuid/3: NullUUID.UnmarshalJSON hands the raw JSON token to the text parser after
+// stripping quotes if present: a 32-digit JSON *number* is accepted as a UUID, and JSON string
+// escapes are not decoded (json.Unmarshal into a plain UUID handles both correctly).
+func TestHegelPinNullUUIDUnmarshalJSONReadsJSON(t *testing.T) {
+	defer guard(t)
+	var nu uuid.NullUUID
+	if err := json.Unmarshal([]byte(`12345678901234567890123456789012`), &nu); err == nil {
+		t.Fatalf("a 32-digit JSON number decoded into NullUUID as %+v", nu)
+	}
+	doc := []byte(`"6ba7b810-9dad-11d1-80b4-00c04fd430c8"`)
+	var u uuid.UUID
+	if err := json.Unmarshal(doc, &u); err != nil || u != uuid.NamespaceDNS {
+		t.Fatalf("json.Unmarshal(%s) into UUID = %v, %v", doc, u, err)
+	}
+	if err := json.Unmarshal(doc, &nu); err != nil || nu.UUID != uuid.NamespaceDNS || !nu.Valid {
+		t.Fatalf("json.Unmarshal(%s) into NullUUID = %+v, %v; the plain UUID decodes it as %v", doc, nu, err, u)
+	}
+}
+
+// gofrs-uuid/4: NewV1AtTime and NewV6AtTime accept instants the 60-bit timestamp cannot hold
+// (before 1582-10-15) or that Go's UnixNano cannot hold (before 1678 or after 2262) and return
+// a UUID with a garbage timestamp (1500 reads back as 2084, 2300 as 1715) instead of an error —
+// NewV7AtTime documents pinning out-of-range instants to the field's ends.
+func TestHegelPinTimeBasedAtTimeRejectUnrepresentableInstants(t *testing.T) {
+	defer guard(t)
+	for _, y := range []int{1500, 1600, 2300} {
+		at := time.Date(y, 1, 1, 0, 0, 0, 0, time.UTC)
+		if u, err := uuid.NewV1AtTime(at); err == nil {
+			ts, _ := uuid.TimestampFromV1(u)
+			if back, _ := ts.Time(); !back.Equal(at) {
+				t.Fatalf("NewV1AtTime(%v) = %v with no error; the timestamp reads back as %v", at, u, back.UTC())
+			}
+		}
+		if u, err := uuid.NewV6AtTime(at); err == nil {
+			ts, _ := uuid.TimestampFromV6(u)
+			if back, _ := ts.Time(); !back.Equal(at) {
+				t.Fatalf("NewV6AtTime(%v) = %v with no error; the timestamp reads back as %v", at, u, back.UTC())
+			}
+		}
+	}
+}
+
+// sanity: the models are exact on the RFC 9562 example values.
+func TestHegelRFCExamples(t *testing.T) {
+	v1 := uuid.Must(uuid.FromString("C232AB00-9414-11EC-B3C8-9F6BDECED846"))
+	v6 := uuid.Must(uuid.FromString("1EC9414C-232A-6B00-B3C8-9F6BDECED846"))
+	v7 := uuid.Must(uuid.FromString("017F22E2-79B0-7CC3-98C4-DC0C0C07398F"))
+	want := time.Date(2022, 2, 22, 19, 22, 22, 0, time.UTC)
+	for _, c := range []struct {
+		u  uuid.UUID
+		ts func(uuid.UUID) (uuid.Timestamp, error)
+	}{{v1, uuid.TimestampFromV1}, {v6, uuid.TimestampFromV6}, {v7, uuid.TimestampFromV7}} {
+		ts, err := c.ts(c.u)
+		tm, _ := ts.Time()
+		if err != nil || !tm.Equal(want) || uint64(gregorian(want)) != uint64(ts) {
+			t.Fatalf("RFC 9562 example %v: %d, %v, %v", c.u, ts, tm, err)
+		}
+	}
+}
