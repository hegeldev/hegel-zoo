+type box struct {
+	ID   uuid.UUID     `json:"id"`
+	Opt  uuid.NullUUID `json:"opt"`
+	Many []uuid.UUID   `json:"many"`
+}
+
+// TestHegelEncodingsRoundTrip: JSON (UUID, NullUUID including null, slices), text and binary
+// marshalling, FromBytes/FromBytesOrNil, database/sql Scan/Value on fresh destinations
+// (strings, 16-byte binaries, text bytes, a UUID value, NULL into NullUUID) all invert each
+// other; wrong binary lengths and unsupported Scan sources are the documented errors.
+func TestHegelEncodingsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, encCases)
+		u, valid, many := c.u, c.valid, c.many
+		in := box{ID: u, Opt: uuid.NullUUID{UUID: u, Valid: valid}, Many: many}
+		if !valid && c.nilOpt {
+			in.Opt.UUID = uuid.Nil
+		}
+		js, err := json.Marshal(in)
+		if err != nil {
+			fail(ht, "json.Marshal(%+v): %v", in, err)
+		}
+		wantOpt := "null"
+		if valid {
+			wantOpt = strconv.Quote(u.String())
+		}
+		strs := make([]string, len(many))
+		for i, m := range many {
+			strs[i] = m.String()
+		}
+		wantMany, _ := json.Marshal(strs)
+		want := fmt.Sprintf(`{"id":%q,"opt":%s,"many":%s}`, u.String(), wantOpt, wantMany)
+		if string(js) != want {
+			fail(ht, "json.Marshal = %s; want %s", js, want)
+		}
+		var out box
+		if err := json.Unmarshal(js, &out); err != nil {
+			fail(ht, "json.Unmarshal(%s): %v", js, err)
+		}
+		if out.ID != u || out.Opt.Valid != valid || (valid && out.Opt.UUID != u) || (!valid && out.Opt.UUID != uuid.Nil) || (len(many) > 0 && !reflect.DeepEqual(out.Many, many)) || (len(many) == 0 && len(out.Many) != 0) {
+			fail(ht, "json round trip of %s gave %+v", js, out)
+		}
+		nj, err := in.Opt.MarshalJSON()
+		if err != nil || string(nj) != wantOpt {
+			fail(ht, "NullUUID.MarshalJSON = %s, %v; want %s", nj, err, wantOpt)
+		}
+		var nu uuid.NullUUID
+		if err := nu.UnmarshalJSON(nj); err != nil || nu.Valid != valid || (valid && nu.UUID != u) || (!valid && nu.UUID != uuid.Nil) {
+			fail(ht, "NullUUID.UnmarshalJSON(%s) = %+v, %v", nj, nu, err)
+		}
+		// Text and binary.
+		mt, _ := u.MarshalText()
+		var ut uuid.UUID
+		if err := ut.UnmarshalText(mt); err != nil || ut != u {
+			fail(ht, "UnmarshalText(MarshalText(%v)) = %v, %v", u, ut, err)
+		}
+		mb, _ := u.MarshalBinary()
+		var ub uuid.UUID
+		if err := ub.UnmarshalBinary(mb); err != nil || ub != u || !bytes.Equal(mb, u[:]) {
+			fail(ht, "UnmarshalBinary(MarshalBinary(%v)) = %v, %v (binary %x)", u, ub, err, mb)
+		}
+		if fb, err := uuid.FromBytes(mb); err != nil || fb != u || uuid.FromBytesOrNil(mb) != u {
+			fail(ht, "FromBytes(%x) = %v, %v", mb, fb, err)
+		}
+		// database/sql.
+		v, err := u.Value()
+		if err != nil || v != driver.Value(u.String()) {
+			fail(ht, "Value(%v) = %v, %v", u, v, err)
+		}
+		for _, src := range []any{v, u[:], []byte(u.String()), u} {
+			var us uuid.UUID
+			if err := us.Scan(src); err != nil || us != u {
+				fail(ht, "Scan(%T %v) = %v, %v; want %v", src, src, us, err, u)
+			}
+			var ns uuid.NullUUID
+			if err := ns.Scan(src); err != nil || ns.UUID != u || !ns.Valid {
+				fail(ht, "NullUUID.Scan(%T %v) = %+v, %v; want %v", src, src, ns, err, u)
+			}
+		}
+		nv, err := in.Opt.Value()
+		if err != nil || (valid && nv != driver.Value(u.String())) || (!valid && nv != nil) {
+			fail(ht, "NullUUID.Value(%+v) = %v, %v", in.Opt, nv, err)
+		}
+		ns := uuid.NullUUID{UUID: c.prior, Valid: true}
+		if err := ns.Scan(nv); err != nil || ns.Valid != valid || (valid && ns.UUID != u) || (!valid && ns.UUID != uuid.Nil) {
+			fail(ht, "NullUUID.Scan(%v) = %+v, %v", nv, ns, err)
+		}
+		var bad uuid.UUID
+		if err := bad.Scan(c.badSrc); !errors.Is(err, uuid.ErrTypeConvertError) {
+			fail(ht, "Scan of an unsupported type: %v", err)
+		}
+		k := c.k
+		if err := bad.UnmarshalBinary(make([]byte, k)); !errors.Is(err, uuid.ErrIncorrectByteLength) {
+			fail(ht, "UnmarshalBinary of %d bytes: %v", k, err)
+		}
+		if _, err := uuid.FromBytes(make([]byte, k)); !errors.Is(err, uuid.ErrIncorrectByteLength) || uuid.FromBytesOrNil(make([]byte, k)) != uuid.Nil {
+			fail(ht, "FromBytes of %d bytes: %v", k, err)
+		}
+	})
+}
+
+// ---- the shapes of the recorded bugs, one property each ------------------------------------
+//
+// Each draws the bug's shape region alone, judged as the wide property that meets it does, so
+// that the bug has a property that finds it every run; under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring region instead (an accepted source, a bad digit in the first pair, a plain JSON
+// literal, a representable instant) and passes.
+
+// scanCase: a spelling damaged so that the grammar rejects it (under HEGEL_NO_KNOWN=1 left as
+// it is), Scanned as a string or as text bytes into a NullUUID holding prior.
+type scanCase struct {
+	u       uuid.UUID
+	sp      spelling
+	mut     mutation
+	asBytes bool
+	prior   uuid.UUID
+}
+
+func (c scanCase) text() string { return c.mut.apply(c.sp.text(c.u), c.sp) }
+
+func (c scanCase) src() any {
+	if c.asBytes {
+		return []byte(c.text())
+	}
+	return c.text()
+}
+
+func (c scanCase) GoString() string {
+	return fmt.Sprintf("source %T %q prior %v", c.src(), c.text(), c.prior)
+}
+
+var scanCases = hegel.Composite(func(tc hegel.TestCase) scanCase {
+	return scanCase{
+		u:       hegel.Draw(tc, uuids),
+		sp:      hegel.Draw(tc, spellings),
+		mut:     hegel.Draw(tc, shaped[hegel.Generator[mutation]](rejections, hegel.Just(mutation{}))),
+		asBytes: hegel.Draw(tc, hegel.Booleans()),
+		prior:   hegel.Draw(tc, uuids),
+	}
+})
+
+// TestHegelNullUUIDScanOfRejectedSourceClearsValid: NullUUID.Scan is Valid exactly when the
+// Scan succeeded, and holds the parsed value then; NullUUID.Scan sets Valid before delegating,
+// so a rejected source leaves Valid = true beside the error (gofrs-uuid/1).
+func TestHegelNullUUIDScanOfRejectedSourceClearsValid(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, scanCases)
+		s := c.text()
+		want, wantErr := modelParse(s)
+		ns := uuid.NullUUID{UUID: c.prior}
+		err := ns.Scan(c.src())
+		if !sameErr(err, wantErr) {
+			fail(ht, "NullUUID.Scan(%T %q) = %v; model %v", c.src(), s, err, wantErr)
+		}
+		if ns.Valid != (err == nil) {
+			mismatch(ht, shapeIf(err != nil, "gofrs-uuid/1"), "NullUUID.Scan(%T %q) = %v but left %+v", c.src(), s, err, ns)
+		}
+		if err == nil && ns.UUID != want {
+			fail(ht, "NullUUID.Scan(%T %q) = %+v; want %v", c.src(), s, ns, want)
+		}
+	})
+}
+
+// receiverCase: a spelling with a bad digit at hex position 2 to 31, so that the digits before
+// it are decoded before the rejection (under HEGEL_NO_KNOWN=1 at position 0 or 1: rejected
+// before anything is written), parsed into a receiver holding prior.
+type receiverCase struct {
+	u     uuid.UUID
+	sp    spelling
+	mut   mutation
+	prior uuid.UUID
+}
+
+func (c receiverCase) text() string { return c.mut.apply(c.sp.text(c.u), c.sp) }
+
+func (c receiverCase) GoString() string { return fmt.Sprintf("text %q prior %v", c.text(), c.prior) }
+
+var receiverCases = hegel.Composite(func(tc hegel.TestCase) receiverCase {
+	return receiverCase{
+		u:     hegel.Draw(tc, uuids),
+		sp:    hegel.Draw(tc, spellings),
+		mut:   hegel.Draw(tc, digitMutations(shaped(hegel.Integers(2, 31), hegel.Integers(0, 1)))),
+		prior: hegel.Draw(tc, uuids),
+	}
+})
+
+// TestHegelRejectedTextLeavesTheReceiverUnchanged: Parse, UnmarshalText and Scan of text bytes
+// reject a text with a bad hex digit (ErrInvalidFormat) and leave the receiver as it was; the
+// parser writes the digits before the bad one into it as it goes (gofrs-uuid/2).
+func TestHegelRejectedTextLeavesTheReceiverUnchanged(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, receiverCases)
+		s := c.text()
+		for _, p := range []struct {
+			name  string
+			parse func(*uuid.UUID) error
+		}{
+			{"Parse", func(u *uuid.UUID) error { return u.Parse(s) }},
+			{"UnmarshalText", func(u *uuid.UUID) error { return u.UnmarshalText([]byte(s)) }},
+			{"Scan([]byte)", func(u *uuid.UUID) error { return u.Scan([]byte(s)) }},
+		} {
+			rcv := c.prior
+			err := p.parse(&rcv)
+			if !errors.Is(err, uuid.ErrInvalidFormat) {
+				fail(ht, "%s(%q) = %v; want ErrInvalidFormat", p.name, s, err)
+			}
+			if rcv != c.prior {
+				mismatch(ht, shapeIf(c.mut.hexAt >= 2, "gofrs-uuid/2"), "%s(%q) = %v; receiver now %v (was %v)", p.name, s, err, rcv, c.prior)
+			}
+		}
+	})
+}
+
+// jsonCase: a JSON text for a NullUUID: a UUID's spelling as a string literal with \u escapes,
+// or a 32-digit number (a UUID whose hex digits are all decimal); under HEGEL_NO_KNOWN=1 the
+// plain string literal.
+type jsonCase struct {
+	u      uuid.UUID
+	lit    string
+	number bool
+}
+
+func (c jsonCase) GoString() string { return fmt.Sprintf("json %s (uuid %v)", c.lit, c.u) }
+
+var (
+	escapedLiterals = hegel.Composite(func(tc hegel.TestCase) jsonCase {
+		u, sp := hegel.Draw(tc, uuids), hegel.Draw(tc, spellings)
+		return jsonCase{u: u, lit: jsonLiteral(sp.text(u), hegel.Draw(tc, shaped[hegel.Generator[[]int]](many(positions, 1, 4), hegel.Just[[]int](nil))))}
+	})
+	numberLiterals = hegel.Composite(func(tc hegel.TestCase) jsonCase {
+		digits := strconv.Itoa(hegel.Draw(tc, hegel.Integers(1, 9))) + hegel.Draw(tc, hegel.Text().Alphabet("0123456789").MinSize(31).MaxSize(31))
+		return jsonCase{u: uuid.Must(uuid.FromString(digits)), lit: digits, number: true}
+	})
+	jsonCases = shaped[hegel.Generator[jsonCase]](weighted(choice[jsonCase]{7, escapedLiterals}, choice[jsonCase]{3, numberLiterals}), escapedLiterals)
+)
+
+// TestHegelNullUUIDUnmarshalJSONReadsJSON: json.Unmarshal into a NullUUID accepts what it
+// accepts into a UUID and decodes it to the same value: a string literal however its
+// characters are escaped, and never a number. NullUUID.UnmarshalJSON hands the raw token
+// minus its quotes to the text parser, so escapes fail and a 32-digit number is accepted
+// (gofrs-uuid/3).
+func TestHegelNullUUIDUnmarshalJSONReadsJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, jsonCases)
+		var plain uuid.UUID
+		errP := json.Unmarshal([]byte(c.lit), &plain)
+		var nu uuid.NullUUID
+		errN := json.Unmarshal([]byte(c.lit), &nu)
+		if c.number {
+			if errP == nil {
+				fail(ht, "json.Unmarshal(%s), a number, into UUID = %v with no error", c.lit, plain)
+			}
+			if errN == nil {
+				mismatch(ht, "gofrs-uuid/3", "json.Unmarshal(%s), a number, into NullUUID = %+v with no error; into UUID: %v", c.lit, nu, errP)
+			}
+			return
+		}
+		if errP != nil || plain != c.u {
+			fail(ht, "json.Unmarshal(%s) into UUID = %v, %v; want %v", c.lit, plain, errP, c.u)
+		}
+		if errN != nil || !nu.Valid || nu.UUID != c.u {
+			mismatch(ht, shapeIf(strings.Contains(c.lit, `\`), "gofrs-uuid/3"), "json.Unmarshal(%s) into NullUUID = %+v, %v; into UUID %v", c.lit, nu, errN, plain)
+		}
+	})
+}
+
+// atTimeCase: an instant NewV1AtTime/NewV6AtTime cannot represent (under HEGEL_NO_KNOWN=1 one
+// they can), a stream for the clock sequence and the v6 low half, and a hardware address.
+type atTimeCase struct {
+	at     time.Time
+	script []byte
+	hw     []byte
+}
+
+func (c atTimeCase) GoString() string {
+	return fmt.Sprintf("at %v script %x hw %x", c.at, c.script, c.hw)
+}
+
+var atTimeCases = hegel.Composite(func(tc hegel.TestCase) atTimeCase {
+	return atTimeCase{
+		at:     hegel.Draw(tc, shaped(wildInstants, tameInstants)),
+		script: hegel.Draw(tc, hegel.Binary(10, 10)),
+		hw:     hegel.Draw(tc, hegel.Binary(6, 6)),
+	}
+})
+
+// TestHegelTimeBasedAtTimeRejectUnrepresentableInstants: NewV1AtTime and NewV6AtTime (on a
+// generator and package-level) either return an error or a UUID whose timestamp reads back as
+// the instant given; for an instant before 1582-10-15, or outside Go's UnixNano range, they
+// return a UUID with a garbage timestamp and no error (gofrs-uuid/4).
+func TestHegelTimeBasedAtTimeRejectUnrepresentableInstants(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, atTimeCases)
+		s := newScripted(c.script, []call{{at: c.at}}, c.hw)
+		shape := shapeIf(!representable(c.at), "gofrs-uuid/4")
+		for _, f := range []struct {
+			name string
+			new  func(time.Time) (uuid.UUID, error)
+			ts   func(uuid.UUID) (uuid.Timestamp, error)
+		}{
+			{"Gen.NewV1AtTime", s.gen.NewV1AtTime, uuid.TimestampFromV1},
+			{"Gen.NewV6AtTime", s.gen.NewV6AtTime, uuid.TimestampFromV6},
+			{"NewV1AtTime", uuid.NewV1AtTime, uuid.TimestampFromV1},
+			{"NewV6AtTime", uuid.NewV6AtTime, uuid.TimestampFromV6},
+		} {
+			u, err := f.new(c.at)
+			if err != nil {
+				if representable(c.at) {
+					fail(ht, "%s(%v): %v", f.name, c.at, err)
+				}
+				continue // an error is the right answer for an instant the field cannot hold
+			}
+			ts, err := f.ts(u)
+			back, _ := ts.Time()
+			if err != nil || !back.Equal(c.at.Truncate(100*time.Nanosecond)) {
+				mismatch(ht, shape, "%s(%v) = %v with no error; the timestamp reads back as %v, %v", f.name, c.at, u, back.UTC(), err)
+			}
+		}
+	})
+}
+
+// ---- pins ----------------------------------------------------------------------------------
+
+// gofrs-uuid/1: NullUUID.Scan sets Valid = true before delegating, so a rejected source leaves
+// Valid = true (with a half-written UUID) alongside the error.
+func TestHegelPinNullUUIDScanOfBadInputIsInvalid(t *testing.T) {
+	defer guard(t)
+	for _, src := range []any{"6ba7b810-9dad-11d1-80b4-00c04fd430cX", []byte("not a uuid at all, thirty-six by"), "x"} {
+		var nu uuid.NullUUID
+		err := nu.Scan(src)
+		if err == nil {
+			t.Fatalf("NullUUID.Scan(%#v) accepted", src)
+		}
+		if nu.Valid {
+			t.Fatalf("NullUUID.Scan(%#v) = %v but left %+v", src, err, nu)
+		}
+	}
+}
+
+// gofrs-uuid/2: Parse, UnmarshalText and Scan decode into the receiver byte by byte, so a
+// rejected string leaves a mixture of old and new bytes in the destination.
+func TestHegelPinRejectedTextLeavesTheReceiverUnchanged(t *testing.T) {
+	defer guard(t)
+	old := uuid.Must(uuid.FromString("ffffffff-ffff-ffff-ffff-ffffffffffff"))
+	bad := "6ba7b810-9dad-11d1-80b4-00c04fd430cX"
+	u := old
+	if err := u.Parse(bad); err == nil || u != old {
+		t.Fatalf("Parse(%q) = %v; receiver now %v (was %v)", bad, err, u, old)
+	}
+	u = old
+	if err := u.UnmarshalText([]byte(bad)); err == nil || u != old {
+		t.Fatalf("UnmarshalText(%q) = %v; receiver now %v (was %v)", bad, err, u, old)
+	}
+	u = old
+	if err := u.Scan([]byte(bad)); err == nil || u != old {
+		t.Fatalf("Scan(%q) = %v; receiver now %v (was %v)", bad, err, u, old)
+	}
+}
+
+// gofrs-uuid/3: NullUUID.UnmarshalJSON hands the raw JSON token to the text parser after
+// stripping quotes if present: a 32-digit JSON *number* is accepted as a UUID, and JSON string
+// escapes are not decoded (json.Unmarshal into a plain UUID handles both correctly).
+func TestHegelPinNullUUIDUnmarshalJSONReadsJSON(t *testing.T) {
+	defer guard(t)
+	var nu uuid.NullUUID
+	if err := json.Unmarshal([]byte(`12345678901234567890123456789012`), &nu); err == nil {
+		t.Fatalf("a 32-digit JSON number decoded into NullUUID as %+v", nu)
+	}
+	doc := []byte(`"6ba7b810-9dad-11d1-80b4-00c04fd430c8"`)
+	var u uuid.UUID
+	if err := json.Unmarshal(doc, &u); err != nil || u != uuid.NamespaceDNS {
+		t.Fatalf("json.Unmarshal(%s) into UUID = %v, %v", doc, u, err)
+	}
+	if err := json.Unmarshal(doc, &nu); err != nil || nu.UUID != uuid.NamespaceDNS || !nu.Valid {
+		t.Fatalf("json.Unmarshal(%s) into NullUUID = %+v, %v; the plain UUID decodes it as %v", doc, nu, err, u)
+	}
+}
+
+// gofrs-uuid/4: NewV1AtTime and NewV6AtTime accept instants the 60-bit timestamp cannot hold
+// (before 1582-10-15) or that Go's UnixNano cannot hold (before 1678 or after 2262) and return
+// a UUID with a garbage timestamp (1500 reads back as 2084, 2300 as 1715) instead of an error;
+// NewV7AtTime documents pinning out-of-range instants to the field's ends.
+func TestHegelPinTimeBasedAtTimeRejectUnrepresentableInstants(t *testing.T) {
+	defer guard(t)
+	for _, y := range []int{1500, 1600, 2300} {
+		at := time.Date(y, 1, 1, 0, 0, 0, 0, time.UTC)
+		if u, err := uuid.NewV1AtTime(at); err == nil {
+			ts, _ := uuid.TimestampFromV1(u)
+			if back, _ := ts.Time(); !back.Equal(at) {
+				t.Fatalf("NewV1AtTime(%v) = %v with no error; the timestamp reads back as %v", at, u, back.UTC())
+			}
+		}
+		if u, err := uuid.NewV6AtTime(at); err == nil {
+			ts, _ := uuid.TimestampFromV6(u)
+			if back, _ := ts.Time(); !back.Equal(at) {
+				t.Fatalf("NewV6AtTime(%v) = %v with no error; the timestamp reads back as %v", at, u, back.UTC())
+			}
+		}
+	}
+}
+
+// sanity: the models are exact on the RFC 9562 example values.
+func TestHegelRFCExamples(t *testing.T) {
+	v1 := uuid.Must(uuid.FromString("C232AB00-9414-11EC-B3C8-9F6BDECED846"))
+	v6 := uuid.Must(uuid.FromString("1EC9414C-232A-6B00-B3C8-9F6BDECED846"))
+	v7 := uuid.Must(uuid.FromString("017F22E2-79B0-7CC3-98C4-DC0C0C07398F"))
+	want := time.Date(2022, 2, 22, 19, 22, 22, 0, time.UTC)
+	for _, c := range []struct {
+		u  uuid.UUID
+		ts func(uuid.UUID) (uuid.Timestamp, error)
+	}{{v1, uuid.TimestampFromV1}, {v6, uuid.TimestampFromV6}, {v7, uuid.TimestampFromV7}} {
+		ts, err := c.ts(c.u)
+		tm, _ := ts.Time()
+		if err != nil || !tm.Equal(want) || uint64(gregorian(want)) != uint64(ts) {
+			t.Fatalf("RFC 9562 example %v: %d, %v, %v", c.u, ts, tm, err)
+		}
+	}
+}
