+func TestHegelSetModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tr btree.Set[int]
+		m := newModel()
+		steps := n(ht, 1, 80)
+		for step := 0; step < steps; step++ {
+			switch n(ht, 1, 12) {
+			case 1, 2, 3, 4:
+				k := genKey(ht)
+				tr.Insert(k)
+				m.set(k, "")
+				note(ht, "Insert(%d)", k)
+			case 5, 6:
+				k := genKey(ht)
+				if len(m.keys) > 0 && chance(ht, 70) {
+					k = m.keys[n(ht, 0, len(m.keys)-1)]
+				}
+				tr.Delete(k)
+				m.del(k)
+				note(ht, "Delete(%d)", k)
+			case 7:
+				k := genKey(ht)
+				if tr.Contains(k) != m.has(k) {
+					fail(ht, "Contains(%d) = %v, model %v", k, tr.Contains(k), m.keys)
+				}
+			case 8:
+				i := n(ht, -1, len(m.keys)+1)
+				k, ok := tr.DeleteAt(i)
+				mk, _, mok := m.deleteAt(i)
+				note(ht, "DeleteAt(%d)", i)
+				if ok != mok || k != mk {
+					fail(ht, "DeleteAt(%d) = %d %v, want %d %v", i, k, ok, mk, mok)
+				}
+			case 9:
+				k, ok := tr.PopMin()
+				mk, _, mok := m.deleteAt(0)
+				note(ht, "PopMin")
+				if ok != mok || k != mk {
+					fail(ht, "PopMin = %d %v, want %d %v", k, ok, mk, mok)
+				}
+			case 10:
+				k, ok := tr.PopMax()
+				mk, _, mok := m.deleteAt(len(m.keys) - 1)
+				note(ht, "PopMax")
+				if ok != mok || k != mk {
+					fail(ht, "PopMax = %d %v, want %d %v", k, ok, mk, mok)
+				}
+			case 11:
+				k := genKey(ht)
+				tr.Load(k)
+				m.set(k, "")
+				note(ht, "Load(%d)", k)
+			case 12:
+				pivot := genKey(ht)
+				var asc, desc []int
+				tr.Ascend(pivot, func(k int) bool { asc = append(asc, k); return true })
+				tr.Descend(pivot, func(k int) bool { desc = append(desc, k); return true })
+				if !eqInts(asc, m.ascend(pivot)) {
+					fail(ht, "Ascend(%d) = %v, want %v", pivot, asc, m.ascend(pivot))
+				}
+				if !eqInts(desc, m.descend(pivot)) {
+					fail(ht, "Descend(%d) = %v, want %v", pivot, desc, m.descend(pivot))
+				}
+			}
+			if tr.Len() != len(m.keys) {
+				fail(ht, "after step %d: Len = %d, want %d", step, tr.Len(), len(m.keys))
+			}
+		}
+		if keys := tr.Keys(); !eqInts(keys, m.keys) {
+			fail(ht, "Keys = %v, want %v", keys, m.keys)
+		}
+		var scanned, reversed []int
+		tr.Scan(func(k int) bool { scanned = append(scanned, k); return true })
+		tr.Reverse(func(k int) bool { reversed = append([]int{k}, reversed...); return true })
+		if !eqInts(scanned, m.keys) || !eqInts(reversed, m.keys) {
+			fail(ht, "Scan = %v, Reverse = %v, want %v", scanned, reversed, m.keys)
+		}
+		for i := -1; i <= len(m.keys); i++ {
+			k, ok := tr.GetAt(i)
+			mk, _, mok := m.at(i)
+			if ok != mok || k != mk {
+				fail(ht, "GetAt(%d) = %d %v, want %d %v", i, k, ok, mk, mok)
+			}
+		}
+		k, ok := tr.Min()
+		if ok != (len(m.keys) > 0) || (ok && k != m.keys[0]) {
+			fail(ht, "Min = %d %v, model %v", k, ok, m.keys)
+		}
+		k, ok = tr.Max()
+		if ok != (len(m.keys) > 0) || (ok && k != m.keys[len(m.keys)-1]) {
+			fail(ht, "Max = %d %v, model %v", k, ok, m.keys)
+		}
+		if (tr.Height() == 0) != (len(m.keys) == 0) {
+			fail(ht, "Height = %d with %d items", tr.Height(), len(m.keys))
+		}
+		// The iterator walks the same keys.
+		it := tr.Iter()
+		var walked []int
+		for ok := it.First(); ok; ok = it.Next() {
+			walked = append(walked, it.Key())
+		}
+		if !eqInts(walked, m.keys) {
+			fail(ht, "Iter First/Next = %v, want %v", walked, m.keys)
+		}
+		c := tr.Copy()
+		tr.Clear()
+		if keys := c.Keys(); !eqInts(keys, m.keys) {
+			fail(ht, "the copy after Clear on the original: Keys = %v, want %v", keys, m.keys)
+		}
+		if tr.Len() != 0 {
+			fail(ht, "Len after Clear = %d", tr.Len())
+		}
+	})
+}
