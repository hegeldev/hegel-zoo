+// ---------------------------------------------------------------------------
+// Concurrency: BTreeG and BTree are documented thread-safe unless NoLocks.
+
+func TestHegelConcurrentWriters(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tr := btree.NewBTreeG(byK)
+		workers := n(ht, 2, 6)
+		per := n(ht, 1, 200)
+		readers := n(ht, 0, 3)
+		note(ht, "%d writers x %d keys, %d readers", workers, per, readers)
+		var wg sync.WaitGroup
+		for w := 0; w < workers; w++ {
+			wg.Add(1)
+			go func(w int) {
+				defer wg.Done()
+				var hint btree.PathHint
+				for i := 0; i < per; i++ {
+					k := i*workers + w
+					if i%2 == 0 {
+						tr.SetHint(item{k, "w"}, &hint)
+					} else {
+						tr.Set(item{k, "w"})
+					}
+					if i%7 == 3 {
+						tr.Delete(item{K: k - 2*workers}) // one of its own earlier keys
+					}
+				}
+			}(w)
+		}
+		for r := 0; r < readers; r++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				for i := 0; i < 20; i++ {
+					last := -1
+					tr.Scan(func(it item) bool {
+						if it.K <= last {
+							panic(fmt.Sprintf("Scan out of order under concurrent writes: %d after %d", it.K, last))
+						}
+						last = it.K
+						return true
+					})
+					iter := tr.Iter()
+					for ok := iter.First(); ok; ok = iter.Next() {
+					}
+					iter.Release()
+					if !Known.lenUnlocked {
+						tr.Len()
+					}
+					tr.Min()
+					tr.Max()
+					tr.Height()
+					tr.GetAt(i)
+					tr.Get(item{K: i})
+					tr.Items()
+				}
+			}()
+		}
+		wg.Wait()
+		m := newModel()
+		for w := 0; w < workers; w++ {
+			for i := 0; i < per; i++ {
+				m.set(i*workers+w, "w")
+			}
+			for i := 0; i < per; i++ {
+				if i%7 == 3 && i >= 2 {
+					m.del((i-2)*workers + w)
+				}
+			}
+		}
+		checkG(ht, tr, m, "after the concurrent writers")
+	})
+}
