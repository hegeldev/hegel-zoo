+				k, v := genKey(ht), genVal(ht)
+				var prev item
+				var replaced bool
+				if chance(ht, 50) {
+					prev, replaced = tr.Set(item{k, v})
+					note(ht, "Set(%d, %q)", k, v)
+				} else {
+					prev, replaced = tr.SetHint(item{k, v}, hint)
+					note(ht, "SetHint(%d, %q)", k, v)
+				}
+				mprev, mreplaced := m.set(k, v)
+				if replaced != mreplaced || (replaced && (prev.K != k || prev.V != mprev)) {
+					fail(ht, "Set(%d, %q) = %v %v, want %q %v", k, v, prev, replaced, mprev, mreplaced)
+				}
+			case 5, 6:
