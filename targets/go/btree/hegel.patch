+// ---------------------------------------------------------------------------
+// BTreeG with a custom comparator, hints, range deletion and copies
+
+type item struct {
+	K int
+	V string
+}
+
+func byK(a, b item) bool { return a.K < b.K }
+
+type gPair struct {
+	tr   *btree.BTreeG[item]
+	m    *model
+	hint *btree.PathHint
+}
+
+func newG(ht *hegel.T) *btree.BTreeG[item] {
+	deg := pick(ht, 0, 0, 1, 2, 3, 4, 5, 8, 32)
+	nolocks := chance(ht, 50)
+	note(ht, "BTreeG degree %d, NoLocks %v", deg, nolocks)
+	if deg == 0 && !nolocks && chance(ht, 50) {
+		return btree.NewBTreeG(byK)
+	}
+	return btree.NewBTreeGOptions(byK, btree.Options{Degree: deg, NoLocks: nolocks})
+}
+
+func checkG(ht *hegel.T, tr *btree.BTreeG[item], m *model, what string) {
+	if tr.Len() != len(m.keys) {
+		fail(ht, "%s: Len = %d, want %d", what, tr.Len(), len(m.keys))
+	}
+	items := tr.Items()
+	keys := make([]int, len(items))
+	for i, it := range items {
+		keys[i] = it.K
+		if m.vals[it.K] != it.V {
+			fail(ht, "%s: Items has %d=%q, want %q", what, it.K, it.V, m.vals[it.K])
+		}
+	}
+	if !eqInts(keys, m.keys) {
+		fail(ht, "%s: Items keys = %v, want %v", what, keys, m.keys)
+	}
+	var walked []int
+	tr.Walk(func(its []item) bool {
+		if len(its) == 0 {
+			fail(ht, "%s: Walk delivered an empty slice", what)
+		}
+		for _, it := range its {
+			walked = append(walked, it.K)
+		}
+		return true
+	})
+	if !eqInts(walked, m.keys) {
+		fail(ht, "%s: Walk = %v, want %v", what, walked, m.keys)
+	}
+	var scanned, reversed []int
+	tr.Scan(func(it item) bool { scanned = append(scanned, it.K); return true })
+	tr.Reverse(func(it item) bool { reversed = append([]int{it.K}, reversed...); return true })
+	if !eqInts(scanned, m.keys) || !eqInts(reversed, m.keys) {
+		fail(ht, "%s: Scan = %v, Reverse = %v, want %v", what, scanned, reversed, m.keys)
+	}
+	h := tr.Height()
+	if (h == 0) != (len(m.keys) == 0) || (len(m.keys) > 0 && h > log2ceil(len(m.keys)+1)+1) {
+		fail(ht, "%s: Height = %d for %d items", what, h, len(m.keys))
+	}
+	it, ok := tr.Min()
+	if ok != (len(m.keys) > 0) || (ok && it.K != m.keys[0]) {
+		fail(ht, "%s: Min = %v %v, model %v", what, it, ok, m.keys)
+	}
+	it, ok = tr.Max()
+	if ok != (len(m.keys) > 0) || (ok && it.K != m.keys[len(m.keys)-1]) {
+		fail(ht, "%s: Max = %v %v, model %v", what, it, ok, m.keys)
+	}
+	for i := -1; i <= len(m.keys); i++ {
+		it, ok := tr.GetAt(i)
+		mk, mv, mok := m.at(i)
+		if ok != mok || (ok && (it.K != mk || it.V != mv)) {
+			fail(ht, "%s: GetAt(%d) = %v %v, want %d %q %v", what, i, it, ok, mk, mv, mok)
+		}
+	}
+	// The iterator agrees with Items.
+	iter := tr.Iter()
+	var iterated []int
+	for ok := iter.First(); ok; ok = iter.Next() {
+		iterated = append(iterated, iter.Item().K)
+	}
+	iter.Release()
+	if !eqInts(iterated, m.keys) {
+		fail(ht, "%s: Iter = %v, want %v", what, iterated, m.keys)
+	}
+}
+
+func TestHegelBTreeGModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
