+				if len(m.keys) > 0 && chance(ht, 70) {
+					k = m.keys[n(ht, 0, len(m.keys)-1)]
+				}
+				var prev item
+				var ok bool
+				if chance(ht, 50) {
+					prev, ok = tr.Delete(item{K: k})
+					note(ht, "Delete(%d)", k)
+				} else {
+					prev, ok = tr.DeleteHint(item{K: k}, hint)
+					note(ht, "DeleteHint(%d)", k)
+				}
+				mprev, mok := m.del(k)
+				if ok != mok || (ok && (prev.K != k || prev.V != mprev)) {
+					fail(ht, "Delete(%d) = %v %v, want %q %v", k, prev, ok, mprev, mok)
+				}
+			case 7:
+				k := genKey(ht)
+				if len(m.keys) > 0 && chance(ht, 70) {
+					k = m.keys[n(ht, 0, len(m.keys)-1)]
+				}
+				mv, mok := m.get(k)
+				for _, f := range []struct {
+					name string
+					get  func() (item, bool)
+				}{
+					{"Get", func() (item, bool) { return tr.Get(item{K: k}) }},
+					{"GetMut", func() (item, bool) { return tr.GetMut(item{K: k}) }},
+					{"GetHint", func() (item, bool) { return tr.GetHint(item{K: k}, hint) }},
+					{"GetHintMut", func() (item, bool) { return tr.GetHintMut(item{K: k}, hint) }},
+				} {
+					it, ok := f.get()
+					if ok != mok || (ok && (it.K != k || it.V != mv)) {
+						fail(ht, "%s(%d) = %v %v, want %q %v", f.name, k, it, ok, mv, mok)
+					}
+				}
+			case 8:
+				i := n(ht, -1, len(m.keys)+1)
+				it, ok := tr.DeleteAt(i)
+				mk, mv, mok := m.deleteAt(i)
+				note(ht, "DeleteAt(%d)", i)
+				if ok != mok || (ok && (it.K != mk || it.V != mv)) {
+					fail(ht, "DeleteAt(%d) = %v %v, want %d %q %v", i, it, ok, mk, mv, mok)
+				}
+			case 9:
+				it, ok := tr.PopMin()
+				mk, mv, mok := m.deleteAt(0)
+				note(ht, "PopMin")
+				if ok != mok || (ok && (it.K != mk || it.V != mv)) {
+					fail(ht, "PopMin = %v %v, want %d %q %v", it, ok, mk, mv, mok)
+				}
+			case 10:
+				it, ok := tr.PopMax()
+				mk, mv, mok := m.deleteAt(len(m.keys) - 1)
+				note(ht, "PopMax")
+				if ok != mok || (ok && (it.K != mk || it.V != mv)) {
+					fail(ht, "PopMax = %v %v, want %d %q %v", it, ok, mk, mv, mok)
+				}
+			case 11:
+				pivot := genKey(ht)
+				if len(m.keys) > 0 && chance(ht, 50) {
+					pivot = m.keys[n(ht, 0, len(m.keys)-1)]
+				}
+				limit := n(ht, 0, len(m.keys)+1)
+				var asc, desc []int
+				if chance(ht, 50) {
+					tr.Ascend(item{K: pivot}, func(it item) bool { asc = append(asc, it.K); return len(asc) < limit })
+					tr.Descend(item{K: pivot}, func(it item) bool { desc = append(desc, it.K); return len(desc) < limit })
+				} else {
+					tr.AscendHint(item{K: pivot}, func(it item) bool { asc = append(asc, it.K); return len(asc) < limit }, hint)
+					tr.DescendHint(item{K: pivot}, func(it item) bool { desc = append(desc, it.K); return len(desc) < limit }, hint)
+				}
+				wantA, wantD := m.ascend(pivot), m.descend(pivot)
+				cut := func(xs []int) []int {
+					if limit == 0 && len(xs) > 0 {
+						return xs[:1]
+					}
+					if len(xs) > limit {
+						return xs[:limit]
+					}
+					return xs
+				}
+				if !eqInts(asc, cut(wantA)) || !eqInts(desc, cut(wantD)) {
+					fail(ht, "Ascend/Descend(%d) stopping after %d = %v / %v, want %v / %v", pivot, limit, asc, desc, cut(wantA), cut(wantD))
+				}
+			case 12:
+				if len(pairs) < 4 {
+					var c *btree.BTreeG[item]
+					if chance(ht, 50) {
+						c = tr.Copy()
+					} else {
+						c = tr.IsoCopy()
+					}
+					pairs = append(pairs, gPair{c, m.clone(), &btree.PathHint{}})
+					note(ht, "Copy -> tree %d", len(pairs)-1)
+					checkG(ht, c, m, "the fresh copy")
+				}
+			case 13:
+				lo, hi := genKey(ht), genKey(ht)
+				if len(m.keys) > 0 && chance(ht, 60) {
+					lo = m.keys[n(ht, 0, len(m.keys)-1)] + pick(ht, 0, 0, -1, 1)
+					hi = m.keys[n(ht, 0, len(m.keys)-1)] + pick(ht, 0, 0, -1, 1)
+				}
+				if lo > hi && chance(ht, 80) {
+					lo, hi = hi, lo
+				}
+				var opts *btree.DeleteRangeOptions
+				incl, noret := false, false
+				if chance(ht, 60) {
+					incl, noret = chance(ht, 50), chance(ht, 30)
+					opts = &btree.DeleteRangeOptions{MaxInclusive: incl, NoReturn: noret}
+				}
+				note(ht, "DeleteRange(%d, %d, inclusive %v, noreturn %v)", lo, hi, incl, noret)
+				var list btree.List[item]
+				if chance(ht, 50) {
+					list = tr.DeleteRange(item{K: lo}, item{K: hi}, opts)
+				} else {
+					list = tr.DeleteRangeReuse(item{K: lo}, item{K: hi}, opts, &list)
+				}
+				want := m.deleteRange(lo, hi, incl)
+				if noret {
+					if list.Len() != 0 {
+						fail(ht, "DeleteRange with NoReturn returned %d items", list.Len())
+					}
+				} else {
+					var got []int
+					list.Scan(func(it item) bool {
+						got = append(got, it.K)
+						if m.vals[it.K] != "" && false {
+							return false
+						}
+						return true
+					})
+					if list.Len() != len(want) || !eqInts(got, want) {
+						fail(ht, "DeleteRange(%d, %d, inclusive %v) deleted %v (Len %d), want %v", lo, hi, incl, got, list.Len(), want)
+					}
+					// Scanning twice gives the same list.
+					var again []int
+					list.Scan(func(it item) bool { again = append(again, it.K); return true })
+					if !eqInts(again, want) {
+						fail(ht, "the second Scan of the deleted list = %v, want %v", again, want)
+					}
+				}
+			case 14:
+				pivot := genKey(ht)
+				if len(m.keys) > 0 && chance(ht, 60) {
+					pivot = m.keys[n(ht, 0, len(m.keys)-1)] + pick(ht, 0, 0, -1)
+				}
+				// A random action per visited item; the model visits every
+				// item >= pivot in order until a Stop.
+				plan := map[int]btree.Action{}
+				var visited []int
+				stopped := false
+				tr.DeleteAscend(item{K: pivot}, func(it item) btree.Action {
+					visited = append(visited, it.K)
+					if stopped {
+						return btree.Stop
+					}
+					act := pick(ht, btree.Delete, btree.Delete, btree.Keep, btree.Keep, btree.Stop)
+					plan[it.K] = act
+					if act == btree.Stop {
+						stopped = true
+					}
+					return act
+				})
+				note(ht, "DeleteAscend(%d): visited %v", pivot, visited)
+				var want []int
+				for _, k := range m.ascend(pivot) {
+					want = append(want, k)
+					if plan[k] == btree.Stop {
+						break
+					}
+				}
+				if !eqInts(visited, want) {
+					fail(ht, "DeleteAscend(%d) visited %v, want %v (model %v)", pivot, visited, want, m.keys)
+				}
+				for _, k := range visited {
+					if plan[k] == btree.Delete {
+						m.del(k)
+					}
+				}
+			case 15:
+				if chance(ht, 20) {
+					tr.Clear()
+					m.keys, m.vals = nil, map[int]string{}
+					note(ht, "Clear")
+				}
+			case 16:
+				k, v := genKey(ht), genVal(ht)
+				prev, replaced := tr.Load(item{k, v})
+				mprev, mreplaced := m.set(k, v)
+				note(ht, "Load(%d, %q)", k, v)
+				if replaced != mreplaced || (replaced && prev.V != mprev) {
+					fail(ht, "Load(%d, %q) = %v %v, want %q %v", k, v, prev, replaced, mprev, mreplaced)
+				}
+			case 17:
+				// Iterator with a hinted seek, then a few steps.
+				k := genKey(ht)
+				if len(m.keys) > 0 && chance(ht, 50) {
+					k = m.keys[n(ht, 0, len(m.keys)-1)] + pick(ht, 0, 0, 1, -1)
+				}
+				iter := tr.Iter()
+				c := &cursor{n: len(m.keys)}
+				var got, want bool
+				if chance(ht, 50) {
+					got, want = iter.SeekHint(item{K: k}, hint), c.seek(m.lower(k))
+				} else {
+					got, want = iter.Seek(item{K: k}), c.seek(m.lower(k))
+				} // a fresh iterator: no stale flag (btree/2) can be involved
+				if got != want {
+					fail(ht, "Iter.Seek(%d) = %v, want %v (model %v)", k, got, want, m.keys)
+				}
+				for j := 0; j < 6; j++ {
+					if Known.seekKeepsFlag && c.staleFlags() {
+						break
+					}
+					if chance(ht, 50) {
+						got, want = iter.Next(), c.next()
+					} else {
+						got, want = iter.Prev(), c.prev()
+					}
+					if got != want {
+						fail(ht, "Iter step after Seek(%d) = %v, want %v (cursor %+v)", k, got, want, *c)
+					}
+					if c.hasItem && iter.Item().K != m.keys[c.item] {
+						fail(ht, "Iter.Item = %v, want key %d", iter.Item(), m.keys[c.item])
+					}
+				}
+				iter.Release()
+				// Re-use the released iterator on the tree.
+				iter.Init(tr, false)
+				var again []int
+				for ok := iter.First(); ok; ok = iter.Next() {
+					again = append(again, iter.Item().K)
+				}
+				iter.Release()
+				if !eqInts(again, m.keys) {
+					fail(ht, "the re-initialised iterator walks %v, want %v", again, m.keys)
+				}
+			case 18:
+				checkG(ht, tr, m, fmt.Sprintf("tree after step %d", step))
+			}
+			if tr.Len() != len(m.keys) {
+				fail(ht, "after step %d: Len = %d, want %d", step, tr.Len(), len(m.keys))
+			}
+		}
+		for i, p := range pairs {
+			checkG(ht, p.tr, p.m, fmt.Sprintf("tree %d at the end", i))
+		}
+	})
+}
