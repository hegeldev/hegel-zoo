+// ---------------------------------------------------------------------------
+// The interface{}-typed BTree
+
+func anyLess(a, b any) bool { return a.(item).K < b.(item).K }
+
+func TestHegelAnyBTree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tr *btree.BTree
+		switch n(ht, 1, 3) {
+		case 1:
+			tr = btree.New(anyLess)
+		case 2:
+			tr = btree.NewNonConcurrent(anyLess)
+		default:
+			deg := pick(ht, 0, 1, 2, 3, 5, 16)
+			note(ht, "degree %d", deg)
+			tr = btree.NewOptions(anyLess, btree.Options{Degree: deg, NoLocks: chance(ht, 50)})
+		}
+		m := newModel()
+		var hint btree.PathHint
+		steps := n(ht, 1, 70)
+		for step := 0; step < steps; step++ {
+			switch n(ht, 1, 12) {
+			case 1, 2, 3, 4:
+				k, v := genKey(ht), genVal(ht)
+				var prev any
+				if chance(ht, 50) {
+					prev = tr.Set(item{k, v})
+				} else {
+					prev = tr.SetHint(item{k, v}, &hint)
+				}
+				mprev, mreplaced := m.set(k, v)
+				note(ht, "Set(%d, %q)", k, v)
+				if mreplaced {
+					if prev == nil || prev.(item).V != mprev {
+						fail(ht, "Set(%d, %q) = %v, want the replaced %q", k, v, prev, mprev)
+					}
+				} else if prev != nil {
+					fail(ht, "Set(%d, %q) of a new key = %v, want nil", k, v, prev)
+				}
+			case 5, 6:
+				k := genKey(ht)
+				if len(m.keys) > 0 && chance(ht, 70) {
+					k = m.keys[n(ht, 0, len(m.keys)-1)]
+				}
+				var prev any
+				if chance(ht, 50) {
+					prev = tr.Delete(item{K: k})
+				} else {
+					prev = tr.DeleteHint(item{K: k}, &hint)
+				}
+				mprev, mok := m.del(k)
+				note(ht, "Delete(%d)", k)
+				if mok != (prev != nil) || (mok && prev.(item).V != mprev) {
+					fail(ht, "Delete(%d) = %v, want %q %v", k, prev, mprev, mok)
+				}
+			case 7:
+				k := genKey(ht)
+				if len(m.keys) > 0 && chance(ht, 70) {
+					k = m.keys[n(ht, 0, len(m.keys)-1)]
+				}
+				mv, mok := m.get(k)
+				for _, g := range []any{tr.Get(item{K: k}), tr.GetHint(item{K: k}, &hint), tr.GetMut(item{K: k})} {
+					if mok != (g != nil) || (mok && g.(item).V != mv) {
+						fail(ht, "Get(%d) = %v, want %q %v", k, g, mv, mok)
+					}
+				}
+				// Seek finds the first item >= k.
+				res, ok := tr.Seek(item{K: k})
+				i := m.lower(k)
+				if ok != (i < len(m.keys)) || (ok && res.(item).K != m.keys[i]) {
+					fail(ht, "Seek(%d) = %v %v, want key %v (model %v)", k, res, ok, m.ascend(k), m.keys)
+				}
+			case 8:
+				i := n(ht, -1, len(m.keys)+1)
+				got := tr.DeleteAt(i)
+				mk, mv, mok := m.deleteAt(i)
+				note(ht, "DeleteAt(%d)", i)
+				if mok != (got != nil) || (mok && (got.(item).K != mk || got.(item).V != mv)) {
+					fail(ht, "DeleteAt(%d) = %v, want %d %q %v", i, got, mk, mv, mok)
+				}
+			case 9:
+				got := tr.PopMin()
+				mk, mv, mok := m.deleteAt(0)
+				note(ht, "PopMin")
+				if mok != (got != nil) || (mok && (got.(item).K != mk || got.(item).V != mv)) {
+					fail(ht, "PopMin = %v, want %d %q %v", got, mk, mv, mok)
+				}
+			case 10:
+				got := tr.PopMax()
+				mk, mv, mok := m.deleteAt(len(m.keys) - 1)
+				note(ht, "PopMax")
+				if mok != (got != nil) || (mok && (got.(item).K != mk || got.(item).V != mv)) {
+					fail(ht, "PopMax = %v, want %d %q %v", got, mk, mv, mok)
+				}
+			case 11:
+				k, v := genKey(ht), genVal(ht)
+				prev := tr.Load(item{k, v})
+				mprev, mreplaced := m.set(k, v)
+				note(ht, "Load(%d, %q)", k, v)
+				if mreplaced != (prev != nil) || (mreplaced && prev.(item).V != mprev) {
+					fail(ht, "Load(%d, %q) = %v, want %q %v", k, v, prev, mprev, mreplaced)
+				}
+			case 12:
+				pivot := genKey(ht)
+				var asc, desc []int
+				tr.Ascend(item{K: pivot}, func(it any) bool { asc = append(asc, it.(item).K); return true })
+				tr.DescendHint(item{K: pivot}, func(it any) bool { desc = append(desc, it.(item).K); return true }, &hint)
+				if !eqInts(asc, m.ascend(pivot)) || !eqInts(desc, m.descend(pivot)) {
+					fail(ht, "Ascend/Descend(%d) = %v / %v, want %v / %v", pivot, asc, desc, m.ascend(pivot), m.descend(pivot))
+				}
+			}
+			if tr.Len() != len(m.keys) {
+				fail(ht, "after step %d: Len = %d, want %d", step, tr.Len(), len(m.keys))
+			}
+		}
+		var scanned, walked []int
+		tr.Ascend(nil, func(it any) bool { scanned = append(scanned, it.(item).K); return true })
+		tr.Walk(func(its []any) {
+			for _, it := range its {
+				walked = append(walked, it.(item).K)
+			}
+		})
+		if !eqInts(scanned, m.keys) || !eqInts(walked, m.keys) {
+			fail(ht, "Ascend(nil) = %v, Walk = %v, want %v", scanned, walked, m.keys)
+		}
+		if mn := tr.Min(); (mn == nil) != (len(m.keys) == 0) || (mn != nil && mn.(item).K != m.keys[0]) {
+			fail(ht, "Min = %v, model %v", mn, m.keys)
+		}
+		if mx := tr.Max(); (mx == nil) != (len(m.keys) == 0) || (mx != nil && mx.(item).K != m.keys[len(m.keys)-1]) {
+			fail(ht, "Max = %v, model %v", mx, m.keys)
+		}
+		for i := -1; i <= len(m.keys); i++ {
+			got := tr.GetAt(i)
+			mk, _, mok := m.at(i)
+			if mok != (got != nil) || (mok && got.(item).K != mk) {
+				fail(ht, "GetAt(%d) = %v, want %d %v", i, got, mk, mok)
+			}
+		}
+		c := tr.Copy()
+		tr.Clear()
+		var copied []int
+		c.Ascend(nil, func(it any) bool { copied = append(copied, it.(item).K); return true })
+		if !eqInts(copied, m.keys) || tr.Len() != 0 || c.Len() != len(m.keys) {
+			fail(ht, "after Clear on the original the copy holds %v (Len %d), want %v; original Len %d", copied, c.Len(), m.keys, tr.Len())
+		}
+	})
+}
