+			for i := 0; i < cnt; i++ {
+				k, v := n(ht, -span, span), genVal(ht)
+				pairs[0].tr.Set(item{k, v})
+				pairs[0].m.set(k, v)
+			}
+			note(ht, "bulk of %d random keys in [-%d, %d]", cnt, span, span)
+		}
+		steps := n(ht, 1, 80)
