+package toml_test
+
+// Hegel properties for github.com/pelletier/go-toml/v2 (the Hegel zoo, targets/go/go-toml).
+//
+// Oracles: Python's tomllib (a TOML 1.0 reader with no code in common with go-toml), run
+// as a child process and fed both go-toml's encoder output and generated documents; a
+// value model of our own (the generated tree) for what the encoder and the decoder must
+// preserve; and go-toml against itself for Marshal/Unmarshal round trips of maps, structs
+// and raw messages.  Generated documents stick to TOML 1.0 so that tomllib can read them;
+// go-toml's 1.1 extensions are not exercised.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	. "github.com/pelletier/go-toml/v2"
+	"github.com/pelletier/go-toml/v2/unstable"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	return int(hegel.Draw(tc, hegel.Integers[int64](int64(lo), int64(hi))))
+}
+func chance(tc hegel.TestCase, pct int) bool  { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+func note(ht *hegel.T, format string, args ...interface{}) {
+	ht.Note(fmt.Sprintf(format, args...))
+}
+
+// ---------------------------------------------------------------------------------------
+// The value model: a TOML document as a tree, independent of both encoders.
+
+type val struct {
+	kind  string // int float string bool datetime local-datetime local-date local-time array table
+	i     int64
+	f     float64
+	s     string
+	b     bool
+	t     time.Time // datetime
+	ld    LocalDate // local-date, local-datetime
+	lt    LocalTime // local-time, local-datetime (Precision unused)
+	items []*val
+	kids  map[string]*val
+	keys  []string // generation order of kids
+}
+
+func (v *val) isTable() bool { return v.kind == "table" }
+
+// tableArray reports whether v is a non-empty array whose elements are all tables, the
+// shape TOML can write as [[array of tables]].
+func (v *val) tableArray() bool {
+	if v.kind != "array" || len(v.items) == 0 {
+		return false
+	}
+	for _, it := range v.items {
+		if !it.isTable() {
+			return false
+		}
+	}
+	return true
+}
+
+// Generators.
+
+var asciiPieces = []string{"a", "b", "z", "A", "Z", "0", "7", "_", "-", ".", " ", "  ", "\t", "'", "''", "'''", "\"", "\"\"", "\"\"\"", "\\", "\\n", "\\u0041", "#", "=", "[", "]", "{", "}", ",", "/", ":", "+"}
+var unicodePieces = []string{"é", "ß", "日本", "😀", "\u2028", "\u00a0", "\ufeff", "\U0010ffff", "Ω"}
+var controlPieces = []string{"\n", "\n\n", "\r", "\r\n", "\x00", "\x01", "\x1b", "\x1f", "\x7f", "\b", "\f"}
+
+func genString(tc hegel.TestCase) string {
+	k := n(tc, 0, 8)
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		switch n(tc, 1, 10) {
+		case 1, 2:
+			sb.WriteString(pick(tc, unicodePieces))
+		case 3, 4:
+			sb.WriteString(pick(tc, controlPieces))
+		default:
+			sb.WriteString(pick(tc, asciiPieces))
+		}
+	}
+	return sb.String()
+}
+
+func genBareKey(tc hegel.TestCase) string {
+	const alphabet = "abcXYZ019_-"
+	k := n(tc, 1, 5)
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = alphabet[n(tc, 0, len(alphabet)-1)]
+	}
+	return string(b)
+}
+
+func genKey(tc hegel.TestCase) string {
+	if chance(tc, 65) {
+		return genBareKey(tc)
+	}
+	return genString(tc)
+}
+
+func genInt(tc hegel.TestCase) int64 {
+	switch n(tc, 1, 6) {
+	case 1:
+		return int64(n(tc, -10, 10))
+	case 2:
+		return pick(tc, []int64{math.MaxInt64, math.MinInt64, math.MaxInt32, math.MinInt32, 1 << 53, -(1 << 53), 255, 256, 65535, 1 << 31})
+	case 3:
+		return hegel.Draw(tc, hegel.Integers[int64](math.MinInt64, math.MaxInt64))
+	default:
+		return hegel.Draw(tc, hegel.Integers[int64](-1000000, 1000000))
+	}
+}
+
+func genFloat(tc hegel.TestCase) float64 {
+	switch n(tc, 1, 7) {
+	case 1:
+		return pick(tc, []float64{0, math.Copysign(0, -1), 1, -1, 0.5, 0.1, 1e21, 1e-7, 123456.789, math.MaxFloat64, math.SmallestNonzeroFloat64, 5e-324, 1 << 53, 9007199254740993})
+	case 2:
+		return pick(tc, []float64{math.Inf(1), math.Inf(-1), math.NaN()})
+	case 3:
+		// A random bit pattern: every finite double is fair game.
+		f := math.Float64frombits(uint64(hegel.Draw(tc, hegel.Integers[int64](math.MinInt64, math.MaxInt64))))
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			return 1.5
+		}
+		return f
+	case 4:
+		return float64(n(tc, -1000, 1000)) / 8
+	default:
+		return float64(n(tc, -100000, 100000)) / math.Pow(10, float64(n(tc, 0, 6)))
+	}
+}
+
+func genZone(tc hegel.TestCase) *time.Location {
+	switch n(tc, 1, 4) {
+	case 1:
+		return time.UTC
+	case 2:
+		return time.FixedZone("", 60*pick(tc, []int{-24*60 + 1, -12 * 60, -5*60 - 30, -1, 1, 60, 5*60 + 45, 14 * 60, 24*60 - 1}))
+	default:
+		return time.FixedZone("", 60*n(tc, -23*60-59, 23*60+59))
+	}
+}
+
+func genNanos(tc hegel.TestCase) int {
+	switch n(tc, 1, 4) {
+	case 1:
+		return 0
+	case 2:
+		return 1000 * n(tc, 0, 999999) // microsecond precision
+	case 3:
+		return pick(tc, []int{1, 999999999, 100000000, 500, 123456789, 120000000})
+	default:
+		return n(tc, 0, 999999999)
+	}
+}
+
+func genDate(tc hegel.TestCase) LocalDate {
+	y := n(tc, 1, 9999)
+	if chance(tc, 20) {
+		y = pick(tc, []int{1, 1900, 2000, 2024, 9999, 1970, 1600})
+	}
+	m := n(tc, 1, 12)
+	d := n(tc, 1, 28)
+	if chance(tc, 20) {
+		d = time.Date(y, time.Month(m)+1, 0, 0, 0, 0, 0, time.UTC).Day() // last day of the month
+	}
+	return LocalDate{Year: y, Month: m, Day: d}
+}
+
+func genLocalTime(tc hegel.TestCase) LocalTime {
+	return LocalTime{Hour: n(tc, 0, 23), Minute: n(tc, 0, 59), Second: n(tc, 0, 59), Nanosecond: genNanos(tc)}
+}
+
+func genTime(tc hegel.TestCase) time.Time {
+	d, lt := genDate(tc), genLocalTime(tc)
+	return time.Date(d.Year, time.Month(d.Month), d.Day, lt.Hour, lt.Minute, lt.Second, lt.Nanosecond, genZone(tc))
+}
+
+func genScalar(tc hegel.TestCase) *val {
+	switch n(tc, 1, 10) {
+	case 1, 2:
+		return &val{kind: "int", i: genInt(tc)}
+	case 3, 4:
+		return &val{kind: "float", f: genFloat(tc)}
+	case 5, 6, 7:
+		return &val{kind: "string", s: genString(tc)}
+	case 8:
+		return &val{kind: "bool", b: chance(tc, 50)}
+	default:
+		switch n(tc, 1, 4) {
+		case 1:
+			return &val{kind: "datetime", t: genTime(tc)}
+		case 2:
+			return &val{kind: "local-datetime", ld: genDate(tc), lt: genLocalTime(tc)}
+		case 3:
+			return &val{kind: "local-date", ld: genDate(tc)}
+		default:
+			return &val{kind: "local-time", lt: genLocalTime(tc)}
+		}
+	}
+}
+
+func genVal(tc hegel.TestCase, depth int) *val {
+	if depth <= 0 || chance(tc, 55) {
+		return genScalar(tc)
+	}
+	if chance(tc, 50) {
+		return genTable(tc, depth-1)
+	}
+	k := n(tc, 0, 4)
+	a := &val{kind: "array"}
+	if k > 0 && chance(tc, 40) {
+		// Homogeneous array of tables (the [[array]] shape).
+		for i := 0; i < k; i++ {
+			a.items = append(a.items, genTable(tc, depth-1))
+		}
+		return a
+	}
+	for i := 0; i < k; i++ {
+		a.items = append(a.items, genVal(tc, depth-1))
+	}
+	return a
+}
+
+func genTable(tc hegel.TestCase, depth int) *val {
+	t := &val{kind: "table", kids: map[string]*val{}}
+	k := n(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		key := genKey(tc)
+		if _, dup := t.kids[key]; dup {
+			continue
+		}
+		t.kids[key] = genVal(tc, depth)
+		t.keys = append(t.keys, key)
+	}
+	return t
+}
+
+// toGo converts a tree into the Go values that Marshal accepts: map[string]interface{},
+// []interface{} and scalars, with integers spread over the sized integer types they fit.
+func toGo(tc hegel.TestCase, v *val) interface{} {
+	switch v.kind {
+	case "int":
+		i := v.i
+		var candidates []interface{}
+		candidates = append(candidates, i, int(i))
+		if i >= 0 {
+			candidates = append(candidates, uint64(i), uint(i))
+		}
+		if i >= math.MinInt32 && i <= math.MaxInt32 {
+			candidates = append(candidates, int32(i))
+		}
+		if i >= math.MinInt16 && i <= math.MaxInt16 {
+			candidates = append(candidates, int16(i))
+		}
+		if i >= math.MinInt8 && i <= math.MaxInt8 {
+			candidates = append(candidates, int8(i))
+		}
+		if i >= 0 && i <= math.MaxUint8 {
+			candidates = append(candidates, uint8(i))
+		}
+		if i >= 0 && i <= math.MaxUint16 {
+			candidates = append(candidates, uint16(i))
+		}
+		if i >= 0 && i <= math.MaxUint32 {
+			candidates = append(candidates, uint32(i))
+		}
+		return pick(tc, candidates)
+	case "float":
+		return v.f
+	case "string":
+		return v.s
+	case "bool":
+		return v.b
+	case "datetime":
+		return v.t
+	case "local-datetime":
+		return LocalDateTime{LocalDate: v.ld, LocalTime: v.lt}
+	case "local-date":
+		return v.ld
+	case "local-time":
+		return v.lt
+	case "array":
+		out := make([]interface{}, 0, len(v.items))
+		for _, it := range v.items {
+			out = append(out, toGo(tc, it))
+		}
+		return out
+	case "table":
+		out := map[string]interface{}{}
+		for _, k := range v.keys {
+			out[k] = toGo(tc, v.kids[k])
+		}
+		return out
+	}
+	panic("unknown kind " + v.kind)
+}
+
+// ---------------------------------------------------------------------------------------
+// Tagged trees: the common currency for comparing go-toml, tomllib and the model.
+
+type node struct {
+	T     string           `json:"t"`
+	S     string           `json:"s,omitempty"`
+	Kids  map[string]*node `json:"kids,omitempty"`
+	Items []*node          `json:"items,omitempty"`
+}
+
+func canonFloat(f float64) string {
+	if math.IsNaN(f) {
+		return "NaN"
+	}
+	return strconv.FormatFloat(f, 'g', -1, 64)
+}
+
+// micro truncates a nanosecond count to microseconds when comparing with tomllib, whose
+// datetimes carry six fractional digits.
+func fraction(nanos int, micro bool) string {
+	if micro {
+		return fmt.Sprintf("%06d", nanos/1000)
+	}
+	return fmt.Sprintf("%09d", nanos)
+}
+
+func dateStr(y, m, d int) string { return fmt.Sprintf("%04d-%02d-%02d", y, m, d) }
+func timeStr(h, mi, s, nanos int, micro bool) string {
+	return fmt.Sprintf("%02d:%02d:%02d.%s", h, mi, s, fraction(nanos, micro))
+}
+func timeNode(t time.Time, micro bool) *node {
+	_, off := t.Zone()
+	return &node{T: "datetime", S: fmt.Sprintf("%sT%s@%d", dateStr(t.Year(), int(t.Month()), t.Day()), timeStr(t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), micro), off)}
+}
+
+func nodeOfVal(v *val, micro bool) *node {
+	switch v.kind {
+	case "int":
+		return &node{T: "int", S: strconv.FormatInt(v.i, 10)}
+	case "float":
+		return &node{T: "float", S: canonFloat(v.f)}
+	case "string":
+		return &node{T: "string", S: v.s}
+	case "bool":
+		return &node{T: "bool", S: strconv.FormatBool(v.b)}
+	case "datetime":
+		return timeNode(v.t, micro)
+	case "local-datetime":
+		return &node{T: "local-datetime", S: dateStr(v.ld.Year, v.ld.Month, v.ld.Day) + "T" + timeStr(v.lt.Hour, v.lt.Minute, v.lt.Second, v.lt.Nanosecond, micro)}
+	case "local-date":
+		return &node{T: "local-date", S: dateStr(v.ld.Year, v.ld.Month, v.ld.Day)}
+	case "local-time":
+		return &node{T: "local-time", S: timeStr(v.lt.Hour, v.lt.Minute, v.lt.Second, v.lt.Nanosecond, micro)}
+	case "array":
+		out := &node{T: "array", Items: []*node{}}
+		for _, it := range v.items {
+			out.Items = append(out.Items, nodeOfVal(it, micro))
+		}
+		return out
+	case "table":
+		out := &node{T: "table", Kids: map[string]*node{}}
+		for k, c := range v.kids {
+			out.Kids[k] = nodeOfVal(c, micro)
+		}
+		return out
+	}
+	panic("unknown kind " + v.kind)
+}
+
+// nodeOfAny converts what go-toml decodes into an interface{} target.
+func nodeOfAny(x interface{}, micro bool) *node {
+	switch x := x.(type) {
+	case map[string]interface{}:
+		out := &node{T: "table", Kids: map[string]*node{}}
+		for k, c := range x {
+			out.Kids[k] = nodeOfAny(c, micro)
+		}
+		return out
+	case []interface{}:
+		out := &node{T: "array", Items: []*node{}}
+		for _, it := range x {
+			out.Items = append(out.Items, nodeOfAny(it, micro))
+		}
+		return out
+	case int64:
+		return &node{T: "int", S: strconv.FormatInt(x, 10)}
+	case float64:
+		return &node{T: "float", S: canonFloat(x)}
+	case string:
+		return &node{T: "string", S: x}
+	case bool:
+		return &node{T: "bool", S: strconv.FormatBool(x)}
+	case time.Time:
+		return timeNode(x, micro)
+	case LocalDateTime:
+		return &node{T: "local-datetime", S: dateStr(x.Year, x.Month, x.Day) + "T" + timeStr(x.Hour, x.Minute, x.Second, x.Nanosecond, micro)}
+	case LocalDate:
+		return &node{T: "local-date", S: dateStr(x.Year, x.Month, x.Day)}
+	case LocalTime:
+		return &node{T: "local-time", S: timeStr(x.Hour, x.Minute, x.Second, x.Nanosecond, micro)}
+	}
+	return &node{T: fmt.Sprintf("unexpected Go type %T", x), S: fmt.Sprint(x)}
+}
+
+// normalise puts a tomllib tree into the same shape as ours (floats canonicalised).
+func normalise(nd *node) {
+	switch nd.T {
+	case "float":
+		f, err := strconv.ParseFloat(nd.S, 64)
+		if err == nil {
+			nd.S = canonFloat(f)
+		}
+	case "table":
+		for _, c := range nd.Kids {
+			normalise(c)
+		}
+	case "array":
+		for _, c := range nd.Items {
+			normalise(c)
+		}
+	}
+}
+
+func sameNode(a, b *node) bool {
+	if a.T != b.T || a.S != b.S || len(a.Kids) != len(b.Kids) || len(a.Items) != len(b.Items) {
+		return false
+	}
+	for k, c := range a.Kids {
+		d, ok := b.Kids[k]
+		if !ok || !sameNode(c, d) {
+			return false
+		}
+	}
+	for i := range a.Items {
+		if !sameNode(a.Items[i], b.Items[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func render(nd *node) string {
+	switch nd.T {
+	case "table":
+		keys := make([]string, 0, len(nd.Kids))
+		for k := range nd.Kids {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		parts := make([]string, 0, len(keys))
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%q: %s", k, render(nd.Kids[k])))
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	case "array":
+		parts := make([]string, 0, len(nd.Items))
+		for _, it := range nd.Items {
+			parts = append(parts, render(it))
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case "string":
+		return fmt.Sprintf("%q", nd.S)
+	default:
+		return nd.T + "(" + nd.S + ")"
+	}
+}
+
+// ---------------------------------------------------------------------------------------
+// Python tomllib as a child process (one per test binary, JSON lines both ways).
+
+const tomllibScript = `
+import sys, json, tomllib, datetime
+
+def node(v):
+    if isinstance(v, bool):
+        return {"t": "bool", "s": "true" if v else "false"}
+    if isinstance(v, int):
+        return {"t": "int", "s": str(v)}
+    if isinstance(v, float):
+        return {"t": "float", "s": repr(v)}
+    if isinstance(v, str):
+        return {"t": "string", "s": v}
+    if isinstance(v, datetime.datetime):
+        s = "%04d-%02d-%02dT%02d:%02d:%02d.%06d" % (v.year, v.month, v.day, v.hour, v.minute, v.second, v.microsecond)
+        if v.tzinfo is None:
+            return {"t": "local-datetime", "s": s}
+        return {"t": "datetime", "s": "%s@%d" % (s, int(v.utcoffset().total_seconds()))}
+    if isinstance(v, datetime.date):
+        return {"t": "local-date", "s": "%04d-%02d-%02d" % (v.year, v.month, v.day)}
+    if isinstance(v, datetime.time):
+        return {"t": "local-time", "s": "%02d:%02d:%02d.%06d" % (v.hour, v.minute, v.second, v.microsecond)}
+    if isinstance(v, dict):
+        return {"t": "table", "kids": {k: node(x) for k, x in v.items()}}
+    if isinstance(v, list):
+        return {"t": "array", "items": [node(x) for x in v]}
+    raise TypeError(str(type(v)))
+
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        out = {"ok": True, "tree": node(tomllib.loads(req["doc"]))}
+    except Exception as e:
+        out = {"ok": False, "err": "%s: %s" % (type(e).__name__, e)}
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+`
+
+var (
+	pyOnce  sync.Once
+	pyMu    sync.Mutex
+	pyIn    *bufio.Writer
+	pyOut   *bufio.Reader
+	pyError error
+)
+
+func startPython() {
+	cmd := exec.Command("python3", "-c", tomllibScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		pyError = err
+		return
+	}
+	pyIn, pyOut = bufio.NewWriter(stdin), bufio.NewReader(stdout)
+}
+
+// tomllib parses doc with Python's tomllib and returns the tagged tree, or the error text.
+func tomllib(t testing.TB, doc string) (*node, string) {
+	pyOnce.Do(startPython)
+	if pyError != nil {
+		t.Fatalf("cannot start python3: %v", pyError)
+	}
+	pyMu.Lock()
+	defer pyMu.Unlock()
+	req, _ := json.Marshal(map[string]string{"doc": doc})
+	pyIn.Write(req)
+	pyIn.WriteByte('\n')
+	if err := pyIn.Flush(); err != nil {
+		t.Fatalf("writing to python: %v", err)
+	}
+	line, err := pyOut.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from python: %v", err)
+	}
+	var resp struct {
+		OK   bool   `json:"ok"`
+		Tree *node  `json:"tree"`
+		Err  string `json:"err"`
+	}
+	if err := json.Unmarshal(line, &resp); err != nil {
+		t.Fatalf("bad python response %q: %v", line, err)
+	}
+	if !resp.OK {
+		return nil, resp.Err
+	}
+	normalise(resp.Tree)
+	return resp.Tree, ""
+}
+
+// ---------------------------------------------------------------------------------------
+// A TOML 1.0 writer with random syntax choices, for the decoder properties.
+
+type emitter struct {
+	tc hegel.TestCase
+	sb strings.Builder
+	nl string
+}
+
+var bareKeyRe = regexp.MustCompile(`^[A-Za-z0-9_-]+$`)
+
+func hasControl(s string) bool {
+	for _, r := range s {
+		if (r < 0x20 && r != '\t') || r == 0x7f {
+			return true
+		}
+	}
+	return false
+}
+
+func (e *emitter) ws() string {
+	switch n(e.tc, 1, 6) {
+	case 1:
+		return ""
+	case 2:
+		return "\t"
+	case 3:
+		return "  "
+	default:
+		return " "
+	}
+}
+
+func (e *emitter) comment() string {
+	if !chance(e.tc, 25) {
+		return ""
+	}
+	return e.ws() + "#" + pick(e.tc, []string{"", " c", " a = 1", "\t[x]", " \"q\" 'q' \\", " é"})
+}
+
+func (e *emitter) blank() {
+	if chance(e.tc, 20) {
+		e.sb.WriteString(e.ws() + e.nl)
+	}
+	if chance(e.tc, 15) {
+		e.sb.WriteString(e.comment() + e.nl)
+	}
+}
+
+// basicEscape writes s as the inside of a basic string.  In multiline mode newlines and
+// tabs may stay raw and line-ending backslashes may be inserted before non-blank runes.
+func (e *emitter) basicBody(s string, multiline bool) string {
+	var sb strings.Builder
+	for _, r := range s {
+		switch {
+		case r == '"' || r == '\\':
+			sb.WriteRune('\\')
+			sb.WriteRune(r)
+		case r == '\n' && multiline && chance(e.tc, 70):
+			sb.WriteRune('\n')
+		case r == '\t' && chance(e.tc, 50):
+			sb.WriteRune('\t')
+		case r < 0x20 || r == 0x7f:
+			switch r {
+			case '\b':
+				sb.WriteString(`\b`)
+			case '\t':
+				sb.WriteString(pick(e.tc, []string{`\t`, "\t"}))
+			case '\n':
+				sb.WriteString(pick(e.tc, []string{`\n`, `\U0000000a`}))
+			case '\f':
+				sb.WriteString(`\f`)
+			case '\r':
+				sb.WriteString(`\r`)
+			default:
+				sb.WriteString(fmt.Sprintf(`\u%04X`, r))
+			}
+		case chance(e.tc, 5):
+			if chance(e.tc, 50) && r <= 0xffff {
+				sb.WriteString(fmt.Sprintf(`\u%04X`, r))
+			} else {
+				sb.WriteString(fmt.Sprintf(`\U%08x`, r))
+			}
+		default:
+			if multiline && !strings.ContainsRune(" \t\n", r) && chance(e.tc, 8) {
+				// A line-ending backslash trims the whitespace and newlines that follow it.
+				sb.WriteString("\\" + pick(e.tc, []string{"", " ", "\t"}) + "\n" + pick(e.tc, []string{"", "  ", "\t\n"}))
+			}
+			sb.WriteRune(r)
+		}
+	}
+	return sb.String()
+}
+
+func (e *emitter) str(s string) string {
+	literalOK := !strings.ContainsRune(s, '\'') && !hasControl(s) && !strings.ContainsRune(s, '\n')
+	mlLiteralOK := !strings.Contains(s, "'''") && !strings.HasSuffix(s, "'") && !hasControl(strings.ReplaceAll(s, "\n", ""))
+	switch n(e.tc, 1, 6) {
+	case 1, 2:
+		if literalOK {
+			return "'" + s + "'"
+		}
+	case 3:
+		if mlLiteralOK {
+			lead := pick(e.tc, []string{"", "\n"})
+			if strings.HasPrefix(s, "\n") {
+				lead = "\n" // the newline right after the delimiter is trimmed
+			}
+			return "'''" + lead + s + "'''"
+		}
+	case 4, 5:
+		lead := pick(e.tc, []string{"", "\n", "\r\n"})
+		body := e.basicBody(s, true)
+		if strings.HasPrefix(body, "\n") {
+			lead = pick(e.tc, []string{"\n", "\r\n"}) // same trimming rule
+		}
+		// Two quotes before the delimiter are fine; a third would close it early, and a
+		// backslash before it would escape it — both cannot arise since both are escaped.
+		return `"""` + lead + body + `"""`
+	}
+	return `"` + e.basicBody(s, false) + `"`
+}
+
+func (e *emitter) key(k string) string {
+	if bareKeyRe.MatchString(k) && chance(e.tc, 80) {
+		return k
+	}
+	if !strings.ContainsRune(k, '\'') && !hasControl(k) && !strings.ContainsRune(k, '\n') && chance(e.tc, 50) {
+		return "'" + k + "'"
+	}
+	return `"` + e.basicBody(k, false) + `"`
+}
+
+func (e *emitter) keyPath(path []string) string {
+	parts := make([]string, len(path))
+	for i, k := range path {
+		parts[i] = e.key(k)
+	}
+	sep := pick(e.tc, []string{".", ".", " . ", ". ", "\t."})
+	return strings.Join(parts, sep)
+}
+
+func underscores(tc hegel.TestCase, digits string) string {
+	if len(digits) < 2 || !chance(tc, 30) {
+		return digits
+	}
+	var sb strings.Builder
+	for i, c := range digits {
+		if i > 0 && chance(tc, 30) {
+			sb.WriteByte('_')
+		}
+		sb.WriteRune(c)
+	}
+	return sb.String()
+}
+
+func (e *emitter) integer(i int64) string {
+	if i >= 0 && chance(e.tc, 40) {
+		u := uint64(i)
+		switch n(e.tc, 1, 3) {
+		case 1:
+			s := strconv.FormatUint(u, 16)
+			if chance(e.tc, 50) {
+				s = strings.ToUpper(s)
+			}
+			return "0x" + underscores(e.tc, s)
+		case 2:
+			return "0o" + underscores(e.tc, strconv.FormatUint(u, 8))
+		default:
+			return "0b" + underscores(e.tc, strconv.FormatUint(u, 2))
+		}
+	}
+	s := strconv.FormatInt(i, 10)
+	if i >= 0 && chance(e.tc, 20) {
+		return "+" + underscores(e.tc, s)
+	}
+	if i < 0 {
+		return "-" + underscores(e.tc, s[1:])
+	}
+	return underscores(e.tc, s)
+}
+
+func (e *emitter) float(f float64) string {
+	switch {
+	case math.IsNaN(f):
+		return pick(e.tc, []string{"nan", "+nan", "-nan"})
+	case math.IsInf(f, 1):
+		return pick(e.tc, []string{"inf", "+inf"})
+	case math.IsInf(f, -1):
+		return "-inf"
+	}
+	sign := ""
+	if math.Signbit(f) {
+		sign, f = "-", -f
+	} else if chance(e.tc, 15) {
+		sign = "+"
+	}
+	var s string
+	if exp := math.Log10(f); f == 0 || (exp > -6 && exp < 18 && chance(e.tc, 60)) {
+		s = strconv.FormatFloat(f, 'f', -1, 64)
+		if !strings.Contains(s, ".") {
+			s += pick(e.tc, []string{".0", "e0", "E+0", ".0e-0"})
+		}
+	} else {
+		s = strconv.FormatFloat(f, 'e', -1, 64) // like 1.5e-07 or 1e+300
+		if chance(e.tc, 50) {
+			s = strings.Replace(s, "e", "E", 1)
+		}
+		if chance(e.tc, 30) {
+			s = strings.Replace(s, "e+", "e", 1)
+			s = strings.Replace(s, "E+", "E", 1)
+		}
+	}
+	if chance(e.tc, 20) {
+		// Underscores between digits of the integer part.
+		dot := strings.IndexAny(s, ".eE")
+		if dot < 0 {
+			dot = len(s)
+		}
+		s = underscores(e.tc, s[:dot]) + s[dot:]
+	}
+	return sign + s
+}
+
+func (e *emitter) fractionDigits(nanos int) string {
+	if nanos == 0 && chance(e.tc, 70) {
+		return ""
+	}
+	s := fmt.Sprintf("%09d", nanos)
+	trimmed := strings.TrimRight(s, "0")
+	k := len(trimmed)
+	if k == 0 {
+		k = 1
+	}
+	digits := n(e.tc, k, 9)
+	return "." + s[:digits]
+}
+
+func (e *emitter) localTime(lt LocalTime) string {
+	return fmt.Sprintf("%02d:%02d:%02d%s", lt.Hour, lt.Minute, lt.Second, e.fractionDigits(lt.Nanosecond))
+}
+
+func (e *emitter) dateTime(t time.Time) string {
+	_, off := t.Zone()
+	var zone string
+	if off == 0 {
+		zone = pick(e.tc, []string{"Z", "z", "+00:00", "-00:00"})
+	} else {
+		sign := "+"
+		if off < 0 {
+			sign, off = "-", -off
+		}
+		zone = fmt.Sprintf("%s%02d:%02d", sign, off/3600, off%3600/60)
+	}
+	return dateStr(t.Year(), int(t.Month()), t.Day()) + pick(e.tc, []string{"T", "t", " "}) +
+		e.localTime(LocalTime{Hour: t.Hour(), Minute: t.Minute(), Second: t.Second(), Nanosecond: t.Nanosecond()}) + zone
+}
+
+// value writes v as an inline value.  inInline forbids newlines (inside inline tables).
+func (e *emitter) value(v *val, inInline bool) string {
+	switch v.kind {
+	case "int":
+		return e.integer(v.i)
+	case "float":
+		return e.float(v.f)
+	case "string":
+		return e.str(v.s)
+	case "bool":
+		return strconv.FormatBool(v.b)
+	case "datetime":
+		return e.dateTime(v.t)
+	case "local-datetime":
+		return dateStr(v.ld.Year, v.ld.Month, v.ld.Day) + pick(e.tc, []string{"T", "t", " "}) + e.localTime(v.lt)
+	case "local-date":
+		return dateStr(v.ld.Year, v.ld.Month, v.ld.Day)
+	case "local-time":
+		return e.localTime(v.lt)
+	case "array":
+		return e.array(v, inInline)
+	case "table":
+		return e.inlineTable(v)
+	}
+	panic("unknown kind " + v.kind)
+}
+
+// gap is whitespace, optionally with newlines and comments, allowed inside arrays.
+func (e *emitter) gap(inInline bool) string {
+	if inInline || chance(e.tc, 60) {
+		return e.ws()
+	}
+	var sb strings.Builder
+	for i := n(e.tc, 1, 2); i > 0; i-- {
+		sb.WriteString(e.ws() + e.comment() + e.nl)
+	}
+	sb.WriteString(e.ws())
+	return sb.String()
+}
+
+func (e *emitter) array(v *val, inInline bool) string {
+	var sb strings.Builder
+	sb.WriteString("[")
+	sb.WriteString(e.gap(inInline))
+	for i, it := range v.items {
+		if i > 0 {
+			sb.WriteString(",")
+			sb.WriteString(e.gap(inInline))
+		}
+		sb.WriteString(e.value(it, inInline))
+		sb.WriteString(e.gap(inInline))
+	}
+	if len(v.items) > 0 && chance(e.tc, 30) {
+		sb.WriteString(",")
+		sb.WriteString(e.gap(inInline))
+	}
+	sb.WriteString("]")
+	return sb.String()
+}
+
+func (e *emitter) inlineTable(v *val) string {
+	var sb strings.Builder
+	sb.WriteString("{" + e.ws())
+	for i, k := range e.order(v) {
+		if i > 0 {
+			sb.WriteString("," + e.ws())
+		}
+		sb.WriteString(e.key(k) + e.ws() + "=" + e.ws() + e.value(v.kids[k], true))
+	}
+	sb.WriteString(e.ws() + "}")
+	return sb.String()
+}
+
+func (e *emitter) order(v *val) []string {
+	keys := append([]string(nil), v.keys...)
+	if chance(e.tc, 50) {
+		for i := len(keys) - 1; i > 0; i-- {
+			j := n(e.tc, 0, i)
+			keys[i], keys[j] = keys[j], keys[i]
+		}
+	}
+	return keys
+}
+
+// allNonEmpty reports whether every table inside v has at least one key, so that the
+// subtree can be written entirely with dotted keys (which cannot express an empty table).
+func allNonEmpty(v *val) bool {
+	switch v.kind {
+	case "table":
+		if len(v.kids) == 0 {
+			return false
+		}
+		for _, c := range v.kids {
+			if !allNonEmpty(c) {
+				return false
+			}
+		}
+	case "array":
+		for _, c := range v.items {
+			if c.isTable() && !allNonEmpty(c) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func (e *emitter) kv(prefix []string, k string, v *val) {
+	e.sb.WriteString(e.ws() + e.keyPath(append(append([]string{}, prefix...), k)) + e.ws() + "=" + e.ws() + e.value(v, false) + e.comment() + e.nl)
+}
+
+// dotted writes table t entirely as dotted key/value lines under prefix.
+func (e *emitter) dotted(prefix []string, t *val) {
+	for _, k := range e.order(t) {
+		c := t.kids[k]
+		if c.isTable() && chance(e.tc, 70) {
+			e.dotted(append(append([]string{}, prefix...), k), c)
+			continue
+		}
+		e.kv(prefix, k, c)
+	}
+}
+
+// block writes table t at path: its header (unless root), its key/values, then the
+// children that get headers of their own.
+func (e *emitter) block(path []string, t *val, header string) {
+	if header != "" {
+		e.blank()
+		e.sb.WriteString(e.ws() + header + e.ws() + e.keyPath(path) + strings.Repeat("]", len(header)) + e.comment() + e.nl)
+	}
+	type later struct {
+		key string
+		v   *val
+	}
+	var headers []later
+	for _, k := range e.order(t) {
+		c := t.kids[k]
+		switch {
+		case c.isTable() && chance(e.tc, 45):
+			headers = append(headers, later{k, c})
+		case c.isTable() && allNonEmpty(c) && chance(e.tc, 50):
+			e.dotted([]string{k}, c)
+		case c.tableArray() && chance(e.tc, 60):
+			headers = append(headers, later{k, c})
+		default:
+			e.kv(nil, k, c)
+		}
+		e.blank()
+	}
+	for _, h := range headers {
+		sub := append(append([]string{}, path...), h.key)
+		if h.v.isTable() {
+			e.block(sub, h.v, "[")
+		} else {
+			for _, el := range h.v.items {
+				e.block(sub, el, "[[")
+			}
+		}
+	}
+}
+
+func writeDoc(tc hegel.TestCase, root *val) string {
+	e := &emitter{tc: tc, nl: pick(tc, []string{"\n", "\n", "\n", "\r\n"})}
+	e.blank()
+	e.block(nil, root, "")
+	if chance(tc, 30) {
+		e.sb.WriteString(e.ws() + strings.TrimSuffix(e.comment(), ""))
+	}
+	return e.sb.String()
+}
+
+// ---------------------------------------------------------------------------------------
+// Encoder options.
+
+type encOpts struct {
+	inline, arraysML, indent, omitSuper bool
+	symbol                              string
+}
+
+func genEncOpts(tc hegel.TestCase) encOpts {
+	return encOpts{
+		inline:    chance(tc, 30),
+		arraysML:  chance(tc, 30),
+		indent:    chance(tc, 30),
+		omitSuper: chance(tc, 30),
+		symbol:    pick(tc, []string{"  ", "\t", " ", ""}),
+	}
+}
+
+func (o encOpts) marshal(v interface{}) ([]byte, error) {
+	var buf bytes.Buffer
+	enc := NewEncoder(&buf)
+	enc.SetTablesInline(o.inline)
+	enc.SetArraysMultiline(o.arraysML)
+	enc.SetIndentTables(o.indent)
+	enc.SetIndentSymbol(o.symbol)
+	enc.SetOmitEmptySuperTables(o.omitSuper)
+	err := enc.Encode(v)
+	return buf.Bytes(), err
+}
+
+// ---------------------------------------------------------------------------------------
+// Encoder: Marshal output is TOML that tomllib and go-toml both read back as the input.
+
+func TestHegelMarshalOutputIsReadBackByTomllibAsTheInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tree := genTable(ht, 3)
+		opts := genEncOpts(ht)
+		note(ht, "options %+v", opts)
+		in := toGo(ht, tree)
+		doc, err := opts.marshal(in)
+		if err != nil {
+			ht.Fatalf("Marshal(%s) failed: %v", render(nodeOfVal(tree, false)), err)
+		}
+		note(ht, "document:\n%s", doc)
+		got, perr := tomllib(t, string(doc))
+		if perr != "" {
+			ht.Fatalf("tomllib rejects go-toml's output: %s", perr)
+		}
+		want := nodeOfVal(tree, true)
+		if !sameNode(got, want) {
+			ht.Fatalf("tomllib reads\n  %s\nbut the encoder was given\n  %s", render(got), render(want))
+		}
+	})
+}
+
+func TestHegelMarshalThenUnmarshalIntoAnInterfaceIsTheIdentity(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tree := genTable(ht, 3)
+		opts := genEncOpts(ht)
+		note(ht, "options %+v", opts)
+		doc, err := opts.marshal(toGo(ht, tree))
+		if err != nil {
+			ht.Fatalf("Marshal(%s) failed: %v", render(nodeOfVal(tree, false)), err)
+		}
+		note(ht, "document:\n%s", doc)
+		var back map[string]interface{}
+		if err := Unmarshal(doc, &back); err != nil {
+			ht.Fatalf("Unmarshal of the encoder's own output failed: %v", err)
+		}
+		got, want := nodeOfAny(back, false), nodeOfVal(tree, false)
+		if !sameNode(got, want) {
+			ht.Fatalf("read back\n  %s\nbut encoded\n  %s", render(got), render(want))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// Decoder: generated TOML 1.0 documents decode into the tree they were written from, and
+// tomllib agrees (a tomllib disagreement means the writer above is wrong, not go-toml).
+
+func TestHegelGeneratedDocumentsDecodeIntoTheTreeTheyWereWrittenFrom(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tree := genTable(ht, 3)
+		doc := writeDoc(ht, tree)
+		note(ht, "document:\n%s", doc)
+		want := nodeOfVal(tree, false)
+		py, perr := tomllib(t, doc)
+		if perr != "" {
+			ht.Fatalf("test-suite defect: tomllib rejects the generated document: %s", perr)
+		}
+		if wantMicro := nodeOfVal(tree, true); !sameNode(py, wantMicro) {
+			ht.Fatalf("test-suite defect: tomllib reads\n  %s\nbut the writer meant\n  %s", render(py), render(wantMicro))
+		}
+		var back map[string]interface{}
+		if err := Unmarshal([]byte(doc), &back); err != nil {
+			ht.Fatalf("go-toml rejects a document tomllib accepts: %v", err)
+		}
+		if got := nodeOfAny(back, false); !sameNode(got, want) {
+			ht.Fatalf("go-toml reads\n  %s\nbut the document means\n  %s", render(got), render(want))
+		}
+		// The streaming decoder must agree with Unmarshal.
+		var again map[string]interface{}
+		if err := NewDecoder(bytes.NewReader([]byte(doc))).Decode(&again); err != nil {
+			ht.Fatalf("Decoder.Decode fails where Unmarshal succeeds: %v", err)
+		}
+		if got := nodeOfAny(again, false); !sameNode(got, want) {
+			ht.Fatalf("Decoder.Decode reads\n  %s\nbut Unmarshal reads\n  %s", render(got), render(want))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// Typed decoding of numbers: a literal decodes into a numeric field exactly when it fits.
+
+type numbers struct {
+	I   int
+	I8  int8
+	I16 int16
+	I32 int32
+	I64 int64
+	U   uint
+	U8  uint8
+	U16 uint16
+	U32 uint32
+	U64 uint64
+	F32 float32
+	F64 float64
+	Any interface{}
+}
+
+var numberFields = []string{"I", "I8", "I16", "I32", "I64", "U", "U8", "U16", "U32", "U64", "F32", "F64", "Any"}
+
+func intFits(field string, v int64) bool {
+	switch field {
+	case "I8":
+		return v >= math.MinInt8 && v <= math.MaxInt8
+	case "I16":
+		return v >= math.MinInt16 && v <= math.MaxInt16
+	case "I32":
+		return v >= math.MinInt32 && v <= math.MaxInt32
+	case "U8":
+		return v >= 0 && v <= math.MaxUint8
+	case "U16":
+		return v >= 0 && v <= math.MaxUint16
+	case "U32":
+		return v >= 0 && v <= math.MaxUint32
+	case "U", "U64":
+		return v >= 0
+	}
+	return true
+}
+
+func TestHegelIntegerLiteralsDecodeIntoNumericFieldsExactlyWhenTheyFit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genInt(ht)
+		field := pick(ht, numberFields)
+		e := &emitter{tc: ht, nl: "\n"}
+		var lit string
+		if strings.HasPrefix(field, "F") {
+			// Hex, octal and binary literals are pinned separately (go-toml/1).
+			lit = strconv.FormatInt(v, 10)
+			if v >= 0 && chance(ht, 20) {
+				lit = "+" + lit
+			}
+		} else {
+			lit = e.integer(v)
+		}
+		doc := strings.ToLower(field) + " = " + lit + "\n"
+		note(ht, "document: %s", doc)
+		var got numbers
+		err := Unmarshal([]byte(doc), &got)
+		fits := intFits(field, v)
+		if fits && err != nil {
+			ht.Fatalf("%d fits %s but decoding failed: %v", v, field, err)
+		}
+		if !fits {
+			if err == nil {
+				ht.Fatalf("%d does not fit %s but decoding succeeded with %+v", v, field, got)
+			}
+			return
+		}
+		var want interface{}
+		switch field {
+		case "I":
+			want = int(v)
+		case "I8":
+			want = int8(v)
+		case "I16":
+			want = int16(v)
+		case "I32":
+			want = int32(v)
+		case "I64", "Any":
+			want = v
+		case "U":
+			want = uint(v)
+		case "U8":
+			want = uint8(v)
+		case "U16":
+			want = uint16(v)
+		case "U32":
+			want = uint32(v)
+		case "U64":
+			want = uint64(v)
+		case "F32":
+			want = float32(float64(v))
+		case "F64":
+			want = float64(v)
+		}
+		gotField := reflect.ValueOf(got).FieldByName(field).Interface()
+		if !reflect.DeepEqual(gotField, want) {
+			ht.Fatalf("%s decoded as %v (%T), want %v (%T)", doc, gotField, gotField, want, want)
+		}
+	})
+}
+
+func TestHegelFloatLiteralsDecodeIntoFloatFieldsAndNotIntoIntegerFields(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := genFloat(ht)
+		field := pick(ht, numberFields)
+		e := &emitter{tc: ht, nl: "\n"}
+		doc := strings.ToLower(field) + " = " + e.float(f) + "\n"
+		note(ht, "document: %s", doc)
+		var got numbers
+		err := Unmarshal([]byte(doc), &got)
+		switch field {
+		case "F64", "Any":
+			if err != nil {
+				ht.Fatalf("decoding %v into %s failed: %v", f, field, err)
+			}
+			var back float64
+			if field == "F64" {
+				back = got.F64
+			} else {
+				back, _ = got.Any.(float64)
+			}
+			if canonFloat(back) != canonFloat(f) {
+				ht.Fatalf("decoded %v, want %v", back, f)
+			}
+		case "F32":
+			// Values above MaxFloat32 that still round to a finite float32 are pinned
+			// separately (go-toml/2); here they are pushed into the overflow region.
+			if a := math.Abs(f); a > math.MaxFloat32 && !math.IsInf(float32Of(f), 0) {
+				return
+			}
+			finite := !math.IsInf(float32Of(f), 0) || math.IsInf(f, 0)
+			if finite && err != nil {
+				ht.Fatalf("decoding %v into float32 failed: %v", f, err)
+			}
+			if !finite {
+				if err == nil {
+					ht.Fatalf("decoding %v into float32 overflowed silently to %v", f, got.F32)
+				}
+				return
+			}
+			if canonFloat(float64(got.F32)) != canonFloat(float64(float32(f))) {
+				ht.Fatalf("decoded %v, want %v", got.F32, float32(f))
+			}
+		default:
+			if err == nil {
+				ht.Fatalf("a TOML float decoded into integer field %s: %+v", field, got)
+			}
+		}
+	})
+}
+
+func float32Of(f float64) float64 { return float64(float32(f)) }
+
+// ---------------------------------------------------------------------------------------
+// Struct round trips: Marshal then Unmarshal restores every field the encoder writes.
+
+type Temp float64
+
+func (c Temp) MarshalText() ([]byte, error) {
+	return []byte(strconv.FormatFloat(float64(c), 'g', -1, 64) + "C"), nil
+}
+
+func (c *Temp) UnmarshalText(b []byte) error {
+	f, err := strconv.ParseFloat(strings.TrimSuffix(string(b), "C"), 64)
+	if err != nil {
+		return err
+	}
+	*c = Temp(f)
+	return nil
+}
