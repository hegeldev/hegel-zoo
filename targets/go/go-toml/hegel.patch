+// riches: every field of the struct drawn on its own; the pointers, the embedded struct and
+// the omitempty/omitzero fields are present half the time.
+var riches = hegel.Composite(func(tc hegel.TestCase) rich {
+	return rich{
+		embedded: hegel.Draw(tc, maybe(50, embeddeds)),
+		I:        hegel.Draw(tc, ints),
+		I8:       int8(hegel.Draw(tc, int64s)),
+		I16:      int16(hegel.Draw(tc, int64s)),
+		I32:      int32(hegel.Draw(tc, int64s)),
+		I64:      hegel.Draw(tc, int64s),
+		U:        uint(hegel.Draw(tc, int64s) & math.MaxInt64),
+		U8:       uint8(hegel.Draw(tc, int64s)),
+		U16:      uint16(hegel.Draw(tc, int64s)),
+		U32:      uint32(hegel.Draw(tc, int64s)),
+		U64:      uint64(hegel.Draw(tc, int64s) & math.MaxInt64),
+		F32:      hegel.Draw(tc, float32s),
+		F64:      hegel.Draw(tc, floats),
+		S:        hegel.Draw(tc, texts),
+		SM:       hegel.Draw(tc, texts),
+		B:        hegel.Draw(tc, hegel.Booleans()),
+		T:        hegel.Draw(tc, times),
+		TP:       hegel.Draw(tc, hegel.Optional(times)),
+		LD:       hegel.Draw(tc, dates),
+		LT:       hegel.Draw(tc, precisionTimes),
+		LDT:      LocalDateTime{LocalDate: hegel.Draw(tc, dates), LocalTime: hegel.Draw(tc, precisionTimes)},
+		P:        hegel.Draw(tc, hegel.Optional(hegel.Integers(-9, 9))),
+		PS:       hegel.Draw(tc, hegel.Optional(inners)),
+		Arr:      [3]int{hegel.Draw(tc, hegel.Integers(-5, 5)), hegel.Draw(tc, hegel.Integers(-5, 5)), hegel.Draw(tc, ints)},
+		SI:       hegel.Draw(tc, nonNil(many(ints, 0, 3))),
+		SS:       hegel.Draw(tc, nonNil(many(texts, 0, 3))),
+		SF:       hegel.Draw(tc, nonNil(many(floats, 0, 3))),
+		ST:       hegel.Draw(tc, nonNil(many(inners, 0, 3))),
+		SM2:      hegel.Draw(tc, nonNil(many(oneIntMaps, 0, 3))),
+		MI:       hegel.Draw(tc, nonNilMap(hegel.Maps(mapKeys, ints).MaxSize(3))),
+		MS:       hegel.Draw(tc, nonNilMap(hegel.Maps(mapKeys, inners).MaxSize(3))),
+		MM:       hegel.Draw(tc, nonNilMap(hegel.Maps(mapKeys, oneStringMaps).MaxSize(3))),
+		In:       hegel.Draw(tc, inners),
+		N:        hegel.Draw(tc, inners),
+		Any:      hegel.Draw(tc, anys),
+		Temp:     Temp(hegel.Draw(tc, floats)),
+		Om:       hegel.Draw(tc, maybe(50, hegel.Integers(1, 9))),
+		Oz:       hegel.Draw(tc, maybe(50, inners)),
+		Renamed:  hegel.Draw(tc, texts),
+		Skip:     hegel.Draw(tc, hegel.Integers(1, 9)),
+	}
+})
