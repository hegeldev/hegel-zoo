+// structCase: a struct value and the options it is encoded under.
+type structCase struct {
+	in   rich
+	opts encOpts
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c structCase) GoString() string { return fmt.Sprintf("%+v\nencoded with %+v", c.in, c.opts) }
+
+var structCases = hegel.Composite(func(tc hegel.TestCase) structCase {
+	return structCase{in: hegel.Draw(tc, riches), opts: hegel.Draw(tc, encOptions)}
+})
+
+func TestHegelStructsRoundTripThroughMarshalAndUnmarshal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, structCases)
+		in := c.in
+		doc, err := c.opts.marshal(in)
+		if err != nil {
+			ht.Fatalf("Marshal failed: %v", err)
+		}
+		note(ht, "document:\n%s", doc)
+		var out rich
+		if err := Unmarshal(doc, &out); err != nil {
+			ht.Fatalf("Unmarshal of the encoder's own output failed: %v", err)
+		}
+		want := in
+		want.Skip = 0 // toml:"-" is never written
+		if !same(out, want) {
+			ht.Fatalf("round trip changed the struct:\n got %+v\nwant %+v", out, want)
+		}
+		if _, perr := tomllib(t, string(doc)); perr != "" {
+			ht.Fatalf("tomllib rejects go-toml's output: %s", perr)
+		}
+	})
+}
