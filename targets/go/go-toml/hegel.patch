diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..942c065
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,124 @@
+package toml_test
+
+// Narrow properties, one per open bug (see bugs.toml): a generator over the bug's shape
+// region with random contents, judged as the wide property that finds the bug judges.
+// Under HEGEL_NO_KNOWN=1 each draws the neighbouring region instead, where go-toml is
+// right, and passes.
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------------------
+// go-toml/1: an integer written in hex, octal or binary cannot be decoded into a float field.
+
+// prefixedIntCase: a non-negative integer, the float field it is decoded into, the base of
+// its literal (16, 8 or 2; 10 past the known shapes) and the tape spelling it (upper-case
+// hex digits and underscores, or a plus sign on a decimal).
+type prefixedIntCase struct {
+	v       int64
+	field   string
+	base    int
+	choices []int
+}
+
+func (c prefixedIntCase) document() string {
+	e := newEmitter(c.choices)
+	lit := e.decimal(c.v)
+	if c.base != 10 {
+		lit = e.prefixed(uint64(c.v), c.base)
+	}
+	return strings.ToLower(c.field) + " = " + lit + "\n"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c prefixedIntCase) GoString() string { return fmt.Sprintf("%d: %s", c.v, c.document()) }
+
+var (
+	// nonNegatives: small, up to a million, the unsigned edges, the whole non-negative range.
+	nonNegatives = hegel.OneOf(
+		hegel.Integers[int64](0, 10),
+		hegel.Integers[int64](0, 1000000),
+		hegel.SampledFrom([]int64{math.MaxInt64, math.MaxInt32, 1 << 53, 255, 256, 65535, 1 << 31}),
+		hegel.Integers[int64](0, math.MaxInt64),
+	)
+	literalBases     = shaped(hegel.SampledFrom([]int{16, 8, 2}), hegel.Just(10))
+	prefixedIntCases = hegel.Composite(func(tc hegel.TestCase) prefixedIntCase {
+		return prefixedIntCase{
+			v:       hegel.Draw(tc, nonNegatives),
+			field:   hegel.Draw(tc, floatFields),
+			base:    hegel.Draw(tc, literalBases),
+			choices: hegel.Draw(tc, tapes),
+		}
+	})
+)
+
+func TestHegelHexOctalAndBinaryIntegersDecodeIntoFloatFields(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, prefixedIntCases)
+		if d := intFieldMismatch(c.document(), c.field, c.v); d != "" {
+			ht.Fatalf("%s", d)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// go-toml/2: a float literal above MaxFloat32 that still rounds to the finite MaxFloat32
+// is rejected for a float32 field.
+
+// nearMaxFloat32Case: a float64 that rounds to MaxFloat32 as a float32: j float64 ulps
+// (2^75) above it, inside (MaxFloat32, MaxFloat32 * (1 + 2^-25)), or past the known shapes
+// j ulps below it; written with an exponent as the tape says, or in plain decimal
+// notation as the encoder writes it.
+type nearMaxFloat32Case struct {
+	j       int
+	above   bool
+	plain   bool
+	choices []int
+}
+
+func (c nearMaxFloat32Case) value() float64 {
+	step := float64(c.j) * math.Ldexp(1, 75)
+	if c.above {
+		return math.MaxFloat32 + step
+	}
+	return math.MaxFloat32 - step
+}
+
+func (c nearMaxFloat32Case) document() string {
+	f := c.value()
+	lit := newEmitter(c.choices).float(f)
+	if c.plain {
+		lit = strconv.FormatFloat(f, 'f', -1, 64) + ".0"
+	}
+	return "f32 = " + lit + "\n"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nearMaxFloat32Case) GoString() string {
+	return fmt.Sprintf("%v (float32 %v): %s", c.value(), float32(c.value()), c.document())
+}
+
+var nearMaxFloat32Cases = hegel.Composite(func(tc hegel.TestCase) nearMaxFloat32Case {
+	return nearMaxFloat32Case{
+		j:       hegel.Draw(tc, hegel.Integers(1, 1<<28-1)),
+		above:   hegel.Draw(tc, shaped(hegel.Just(true), hegel.Just(false))),
+		plain:   hegel.Draw(tc, chance(30)),
+		choices: hegel.Draw(tc, tapes),
+	}
+})
+
+func TestHegelFloatLiteralsRoundingToMaxFloat32DecodeIntoFloat32Fields(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nearMaxFloat32Cases)
+		if d := float32FieldMismatch(c.document(), c.value()); d != "" {
+			ht.Fatalf("%s", d)
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..844ef38
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2134 @@
+package toml_test
+
+// Hegel properties for github.com/pelletier/go-toml/v2 (the Hegel zoo, targets/go/go-toml).
+//
+// Oracles: Python's tomllib (a TOML 1.0 reader with no code in common with go-toml), run
+// as a child process and fed both go-toml's encoder output and generated documents; a
+// value model of our own (the generated tree) for what the encoder and the decoder must
+// preserve; and go-toml against itself for Marshal/Unmarshal round trips of maps, structs
+// and raw messages.  Generated documents stick to TOML 1.0 so that tomllib can read them;
+// go-toml's 1.1 extensions are not exercised.
+//
+// Every property draws one case record built from the binding's combinators: a value tree
+// (the kinds chosen with the plainest first, Lists and Maps for the collections, pieces for
+// the strings), the encoder options, and on the decoder side a tape of small integers that
+// a pure writer reads for every syntax choice, so that an empty tape is the plainest
+// spelling of the tree.  The shapes of the recorded bugs stay reachable by default (the
+// properties that reach them are the expected failures); HEGEL_NO_KNOWN=1, read once,
+// switches them off.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	. "github.com/pelletier/go-toml/v2"
+	"github.com/pelletier/go-toml/v2/unstable"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...interface{}) {
+	ht.Note(fmt.Sprintf(format, args...))
+}
+
+// noKnown switches the shapes of the recorded bugs off (HEGEL_NO_KNOWN=1, read once).
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the generator with the known shapes on, or past them under HEGEL_NO_KNOWN=1.
+func shaped[T any](known, past hegel.Generator[T]) hegel.Generator[T] {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// ---------------------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// nonNil: the lists of g with an empty non-nil slice for zero elements (Lists yields nil).
+func nonNil[T any](g hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(xs []T) []T {
+		if xs == nil {
+			return []T{}
+		}
+		return xs
+	})
+}
+
+// nonNilMap: the maps of g with an empty non-nil map for zero entries (Maps yields nil, and
+// the encoder skips a nil map field).
+func nonNilMap[K comparable, V any](g hegel.Generator[map[K]V]) hegel.Generator[map[K]V] {
+	return hegel.Map(g, func(m map[K]V) map[K]V {
+		if m == nil {
+			return map[K]V{}
+		}
+		return m
+	})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// ptrs: pointers to the values of g.
+func ptrs[T any](g hegel.Generator[T]) hegel.Generator[*T] { return hegel.Map(g, ptrTo[T]) }
+
+// asAny: the values of g as interface{}.
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[interface{}] {
+	return hegel.Map(g, func(x T) interface{} { return x })
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// tape: the syntax choices of the writer, drawn as a list of small integers and read in
+// order, modulo the length.  An empty tape is the plainest spelling of everything: every
+// coin is false and every pick is its first option, so a shrunk document is plain.
+type tape struct {
+	xs  []int
+	pos int
+}
+
+func (t *tape) next() int {
+	if len(t.xs) == 0 {
+		return 0
+	}
+	x := t.xs[t.pos%len(t.xs)]
+	t.pos++
+	return x
+}
+
+// coin is true pct percent of the tape's values (never on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next() >= 100-pct }
+
+// pick is one of the options, the first on an empty tape.
+func (t *tape) pick(xs []string) string { return xs[t.next()%len(xs)] }
+
+// upto is 0 to n, 0 on an empty tape.
+func (t *tape) upto(n int) int { return t.next() % (n + 1) }
+
+// tapes: up to 150 syntax choices; the writer reads them round and round.
+var tapes = hegel.Lists(hegel.Integers(0, 99)).MaxSize(150)
+
+// ---------------------------------------------------------------------------------------
+// The value model: a TOML document as a tree, independent of both encoders.
+
+type val struct {
+	kind  string // int float string bool datetime local-datetime local-date local-time array table
+	i     int64
+	f     float64
+	s     string
+	b     bool
+	t     time.Time // datetime
+	ld    LocalDate // local-date, local-datetime
+	lt    LocalTime // local-time, local-datetime (Precision unused)
+	items []*val
+	kids  map[string]*val
+	keys  []string // the kids in key order
+	rep   int      // an integer: which of the sized Go integer types it fits toGo hands the encoder
+}
+
+func (v *val) isTable() bool { return v.kind == "table" }
+
+// tableArray reports whether v is a non-empty array whose elements are all tables, the
+// shape TOML can write as [[array of tables]].
+func (v *val) tableArray() bool {
+	if v.kind != "array" || len(v.items) == 0 {
+		return false
+	}
+	for _, it := range v.items {
+		if !it.isTable() {
+			return false
+		}
+	}
+	return true
+}
+
+func sortedKeys(kids map[string]*val) []string {
+	ks := make([]string, 0, len(kids))
+	for k := range kids {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// Strings: up to eight pieces, an ASCII piece 60% of the time, a non-ASCII one 20% and a
+// control character or line break 20%.
+
+var asciiPieces = []string{"a", "b", "z", "A", "Z", "0", "7", "_", "-", ".", " ", "  ", "\t", "'", "''", "'''", "\"", "\"\"", "\"\"\"", "\\", "\\n", "\\u0041", "#", "=", "[", "]", "{", "}", ",", "/", ":", "+"}
+var unicodePieces = []string{"\u00e9", "\u00df", "\u65e5\u672c", "\U0001f600", "\u2028", "\u00a0", "\ufeff", "\U0010ffff", "\u03a9"}
+var controlPieces = []string{"\n", "\n\n", "\r", "\r\n", "\x00", "\x01", "\x1b", "\x1f", "\x7f", "\b", "\f"}
+
+var (
+	pieces = weighted(
+		choice[string]{60, hegel.SampledFrom(asciiPieces)},
+		choice[string]{20, hegel.SampledFrom(unicodePieces)},
+		choice[string]{20, hegel.SampledFrom(controlPieces)},
+	)
+	texts = hegel.Map(hegel.Lists(pieces).MaxSize(8), func(ps []string) string { return strings.Join(ps, "") })
+	// bareKeys: one to five characters TOML writes bare.
+	bareKeys = hegel.Text().Alphabet("abcXYZ019_-").MinSize(1).MaxSize(5)
+	// keys: a bare key 65% of the time, else any text (quoted by the writer).
+	keys = weighted(choice[string]{65, bareKeys}, choice[string]{35, texts})
+	// mapKeys: the keys of the Go maps in the struct round trip, bare 70% of the time.
+	mapKeys = weighted(choice[string]{70, bareKeys}, choice[string]{30, texts})
+)
+
+// Integers: small, a million either way (three times), the sized-integer edges, the whole
+// int64 range.
+
+var intEdges = []int64{math.MaxInt64, math.MinInt64, math.MaxInt32, math.MinInt32, 1 << 53, -(1 << 53), 255, 256, 65535, 1 << 31}
+
+var int64s = hegel.OneOf(
+	hegel.Integers[int64](-10, 10),
+	hegel.Integers[int64](-1000000, 1000000),
+	hegel.Integers[int64](-1000000, 1000000),
+	hegel.Integers[int64](-1000000, 1000000),
+	hegel.SampledFrom(intEdges),
+	hegel.Integers[int64](math.MinInt64, math.MaxInt64),
+)
+
+// reps: which of the sized Go integer types an integer fits toGo picks (an index, modulo
+// the candidates; 0 is int64).
+var reps = hegel.Integers(0, 9)
+
+// Floats: decimals of up to six places (three times), eighths, a pool of edge values (the
+// float64 edges and MaxFloat32, the largest float32), the non-finite values, and any bit
+// pattern (mostly subnormals: the odd-pattern arm).
+
+var floatPool = []float64{0, math.Copysign(0, -1), 1, -1, 0.5, 0.1, 1e21, 1e-7, 123456.789, math.MaxFloat64, math.SmallestNonzeroFloat64, 5e-324, 1 << 53, 9007199254740993, math.MaxFloat32}
+
+var (
+	decimals = hegel.Composite(func(tc hegel.TestCase) float64 {
+		m := hegel.Draw(tc, hegel.Integers(-100000, 100000))
+		places := hegel.Draw(tc, hegel.Integers(0, 6))
+		return float64(m) / math.Pow(10, float64(places))
+	})
+	eighths    = hegel.Map(hegel.Integers(-1000, 1000), func(x int) float64 { return float64(x) / 8 })
+	nonFinites = hegel.SampledFrom([]float64{math.Inf(1), math.Inf(-1), math.NaN()})
+	anyBits    = hegel.Map(hegel.Integers[int64](math.MinInt64, math.MaxInt64), func(b int64) float64 {
+		f := math.Float64frombits(uint64(b))
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			return 1.5
+		}
+		return f
+	})
+	floats = hegel.OneOf(decimals, decimals, decimals, eighths, hegel.SampledFrom(floatPool), nonFinites, anyBits)
+)
+
+// Dates and times: years 1-9999 (an edge year once in five), a day 1-28 or the last day of
+// the month once in five, nanoseconds on the microsecond grid (twice), zero, an edge value
+// or anything, zones UTC, an edge offset or any whole-minute offset within a day.
+
+var (
+	years = weighted(
+		choice[int]{80, hegel.Integers(1, 9999)},
+		choice[int]{20, hegel.SampledFrom([]int{1, 1900, 2000, 2024, 9999, 1970, 1600})},
+	)
+	// monthDays: 1-28, or 0 for the last day of the month.
+	monthDays = weighted(choice[int]{80, hegel.Integers(1, 28)}, choice[int]{20, hegel.Just(0)})
+	dates     = hegel.Composite(func(tc hegel.TestCase) LocalDate {
+		y := hegel.Draw(tc, years)
+		m := hegel.Draw(tc, hegel.Integers(1, 12))
+		d := hegel.Draw(tc, monthDays)
+		if d == 0 {
+			d = time.Date(y, time.Month(m)+1, 0, 0, 0, 0, 0, time.UTC).Day()
+		}
+		return LocalDate{Year: y, Month: m, Day: d}
+	})
+	micros = hegel.Map(hegel.Integers(0, 999999), func(us int) int { return 1000 * us })
+	nanos  = hegel.OneOf(
+		micros,
+		micros,
+		hegel.Just(0),
+		hegel.SampledFrom([]int{1, 999999999, 100000000, 500, 123456789, 120000000}),
+		hegel.Integers(0, 999999999),
+	)
+	localTimes = hegel.Composite(func(tc hegel.TestCase) LocalTime {
+		return LocalTime{
+			Hour:       hegel.Draw(tc, hegel.Integers(0, 23)),
+			Minute:     hegel.Draw(tc, hegel.Integers(0, 59)),
+			Second:     hegel.Draw(tc, hegel.Integers(0, 59)),
+			Nanosecond: hegel.Draw(tc, nanos),
+		}
+	})
+	zoneMinutes = hegel.OneOf(
+		hegel.Just(0),
+		hegel.SampledFrom([]int{-24*60 + 1, -12 * 60, -5*60 - 30, -1, 1, 60, 5*60 + 45, 14 * 60, 24*60 - 1}),
+		hegel.Integers(-23*60-59, 23*60+59),
+		hegel.Integers(-23*60-59, 23*60+59),
+	)
+	zones = hegel.Map(zoneMinutes, func(m int) *time.Location {
+		if m == 0 {
+			return time.UTC
+		}
+		return time.FixedZone("", 60*m)
+	})
+	times = hegel.Composite(func(tc hegel.TestCase) time.Time {
+		d := hegel.Draw(tc, dates)
+		lt := hegel.Draw(tc, localTimes)
+		z := hegel.Draw(tc, zones)
+		return time.Date(d.Year, time.Month(d.Month), d.Day, lt.Hour, lt.Minute, lt.Second, lt.Nanosecond, z)
+	})
+)
+
+// scalars: an integer 20% of the time (with its Go type when typed), a boolean 10%, a
+// string 30%, a float 20%, each of the four date kinds 5%.
+func scalars(typed bool) hegel.Generator[*val] {
+	ints := hegel.Map(int64s, func(i int64) *val { return &val{kind: "int", i: i} })
+	if typed {
+		ints = hegel.Composite(func(tc hegel.TestCase) *val {
+			return &val{kind: "int", i: hegel.Draw(tc, int64s), rep: hegel.Draw(tc, reps)}
+		})
+	}
+	return weighted(
+		choice[*val]{20, ints},
+		choice[*val]{10, hegel.Map(hegel.Booleans(), func(b bool) *val { return &val{kind: "bool", b: b} })},
+		choice[*val]{30, hegel.Map(texts, func(s string) *val { return &val{kind: "string", s: s} })},
+		choice[*val]{20, hegel.Map(floats, func(f float64) *val { return &val{kind: "float", f: f} })},
+		choice[*val]{5, hegel.Map(times, func(t time.Time) *val { return &val{kind: "datetime", t: t} })},
+		choice[*val]{5, hegel.Map(pairs(dates, localTimes), func(p pair[LocalDate, LocalTime]) *val {
+			return &val{kind: "local-datetime", ld: p.a, lt: p.b}
+		})},
+		choice[*val]{5, hegel.Map(dates, func(d LocalDate) *val { return &val{kind: "local-date", ld: d} })},
+		choice[*val]{5, hegel.Map(localTimes, func(lt LocalTime) *val { return &val{kind: "local-time", lt: lt} })},
+	)
+}
+
+// treeCfg: what a tree generator draws.
+type treeCfg struct {
+	depth   int  // tables and arrays nest this deep below the root table
+	minKeys int  // the root table has at least this many keys
+	typed   bool // draw the Go integer type of every integer (the encoder properties)
+}
+
+// trees draws a root table of up to four distinct keys whose values are a scalar 55% of the
+// time by weight, a table 23%, an array of up to four values 13% and an array of one to four
+// tables 9%.  The generator refers to itself through values, and the depth counter in the
+// closure tracks the live recursion (hegel-go's ExampleComposite_recursive): at the bound
+// every value is a scalar.
+func trees(c treeCfg) hegel.Generator[*val] {
+	depth := 0
+	var values hegel.Generator[*val]
+	leaves := scalars(c.typed)
+	table := func(tc hegel.TestCase, minKeys int) *val {
+		depth++
+		defer func() { depth-- }()
+		kids := hegel.Draw(tc, hegel.Maps(keys, values).MinSize(minKeys).MaxSize(4))
+		return &val{kind: "table", kids: kids, keys: sortedKeys(kids)}
+	}
+	tables := hegel.Composite(func(tc hegel.TestCase) *val { return table(tc, 0) })
+	arrays := hegel.Composite(func(tc hegel.TestCase) *val {
+		depth++
+		defer func() { depth-- }()
+		return &val{kind: "array", items: hegel.Draw(tc, hegel.Lists(values).MaxSize(4))}
+	})
+	tableArrays := hegel.Map(hegel.Lists(tables).MinSize(1).MaxSize(4), func(ts []*val) *val {
+		return &val{kind: "array", items: ts}
+	})
+	branches := weighted(choice[*val]{55, leaves}, choice[*val]{23, tables}, choice[*val]{13, arrays}, choice[*val]{9, tableArrays})
+	values = hegel.Composite(func(tc hegel.TestCase) *val {
+		if depth > c.depth {
+			return hegel.Draw(tc, leaves)
+		}
+		return hegel.Draw(tc, branches)
+	})
+	return hegel.Composite(func(tc hegel.TestCase) *val { return table(tc, c.minKeys) })
+}
+
+var (
+	typedTrees = trees(treeCfg{depth: 3, typed: true})
+	plainTrees = trees(treeCfg{depth: 3})
+	// rawTrees: the raw-message property's trees, two deep and never empty.
+	rawTrees = trees(treeCfg{depth: 2, minKeys: 1, typed: true})
+)
+
+// intCandidates: the Go integer types i fits, int64 first.
+func intCandidates(i int64) []interface{} {
+	candidates := []interface{}{i, int(i)}
+	if i >= 0 {
+		candidates = append(candidates, uint64(i), uint(i))
+	}
+	if i >= math.MinInt32 && i <= math.MaxInt32 {
+		candidates = append(candidates, int32(i))
+	}
+	if i >= math.MinInt16 && i <= math.MaxInt16 {
+		candidates = append(candidates, int16(i))
+	}
+	if i >= math.MinInt8 && i <= math.MaxInt8 {
+		candidates = append(candidates, int8(i))
+	}
+	if i >= 0 && i <= math.MaxUint8 {
+		candidates = append(candidates, uint8(i))
+	}
+	if i >= 0 && i <= math.MaxUint16 {
+		candidates = append(candidates, uint16(i))
+	}
+	if i >= 0 && i <= math.MaxUint32 {
+		candidates = append(candidates, uint32(i))
+	}
+	return candidates
+}
+
+// toGo converts a tree into the Go values that Marshal accepts: map[string]interface{},
+// []interface{} and scalars, with every integer in the sized integer type its rep picks.
+func toGo(v *val) interface{} {
+	switch v.kind {
+	case "int":
+		candidates := intCandidates(v.i)
+		return candidates[v.rep%len(candidates)]
+	case "float":
+		return v.f
+	case "string":
+		return v.s
+	case "bool":
+		return v.b
+	case "datetime":
+		return v.t
+	case "local-datetime":
+		return LocalDateTime{LocalDate: v.ld, LocalTime: v.lt}
+	case "local-date":
+		return v.ld
+	case "local-time":
+		return v.lt
+	case "array":
+		out := make([]interface{}, 0, len(v.items))
+		for _, it := range v.items {
+			out = append(out, toGo(it))
+		}
+		return out
+	case "table":
+		out := map[string]interface{}{}
+		for k, c := range v.kids {
+			out[k] = toGo(c)
+		}
+		return out
+	}
+	panic("unknown kind " + v.kind)
+}
+
+// ---------------------------------------------------------------------------------------
+// Tagged trees: the common currency for comparing go-toml, tomllib and the model.
+
+type node struct {
+	T     string           `json:"t"`
+	S     string           `json:"s,omitempty"`
+	Kids  map[string]*node `json:"kids,omitempty"`
+	Items []*node          `json:"items,omitempty"`
+}
+
+func canonFloat(f float64) string {
+	if math.IsNaN(f) {
+		return "NaN"
+	}
+	return strconv.FormatFloat(f, 'g', -1, 64)
+}
+
+// micro truncates a nanosecond count to microseconds when comparing with tomllib, whose
+// datetimes carry six fractional digits.
+func fraction(nanos int, micro bool) string {
+	if micro {
+		return fmt.Sprintf("%06d", nanos/1000)
+	}
+	return fmt.Sprintf("%09d", nanos)
+}
+
+func dateStr(y, m, d int) string { return fmt.Sprintf("%04d-%02d-%02d", y, m, d) }
+func timeStr(h, mi, s, nanos int, micro bool) string {
+	return fmt.Sprintf("%02d:%02d:%02d.%s", h, mi, s, fraction(nanos, micro))
+}
+func timeNode(t time.Time, micro bool) *node {
+	_, off := t.Zone()
+	return &node{T: "datetime", S: fmt.Sprintf("%sT%s@%d", dateStr(t.Year(), int(t.Month()), t.Day()), timeStr(t.Hour(), t.Minute(), t.Second(), t.Nanosecond(), micro), off)}
+}
+
+func nodeOfVal(v *val, micro bool) *node {
+	switch v.kind {
+	case "int":
+		return &node{T: "int", S: strconv.FormatInt(v.i, 10)}
+	case "float":
+		return &node{T: "float", S: canonFloat(v.f)}
+	case "string":
+		return &node{T: "string", S: v.s}
+	case "bool":
+		return &node{T: "bool", S: strconv.FormatBool(v.b)}
+	case "datetime":
+		return timeNode(v.t, micro)
+	case "local-datetime":
+		return &node{T: "local-datetime", S: dateStr(v.ld.Year, v.ld.Month, v.ld.Day) + "T" + timeStr(v.lt.Hour, v.lt.Minute, v.lt.Second, v.lt.Nanosecond, micro)}
+	case "local-date":
+		return &node{T: "local-date", S: dateStr(v.ld.Year, v.ld.Month, v.ld.Day)}
+	case "local-time":
+		return &node{T: "local-time", S: timeStr(v.lt.Hour, v.lt.Minute, v.lt.Second, v.lt.Nanosecond, micro)}
+	case "array":
+		out := &node{T: "array", Items: []*node{}}
+		for _, it := range v.items {
+			out.Items = append(out.Items, nodeOfVal(it, micro))
+		}
+		return out
+	case "table":
+		out := &node{T: "table", Kids: map[string]*node{}}
+		for k, c := range v.kids {
+			out.Kids[k] = nodeOfVal(c, micro)
+		}
+		return out
+	}
+	panic("unknown kind " + v.kind)
+}
+
+// nodeOfAny converts what go-toml decodes into an interface{} target.
+func nodeOfAny(x interface{}, micro bool) *node {
+	switch x := x.(type) {
+	case map[string]interface{}:
+		out := &node{T: "table", Kids: map[string]*node{}}
+		for k, c := range x {
+			out.Kids[k] = nodeOfAny(c, micro)
+		}
+		return out
+	case []interface{}:
+		out := &node{T: "array", Items: []*node{}}
+		for _, it := range x {
+			out.Items = append(out.Items, nodeOfAny(it, micro))
+		}
+		return out
+	case int64:
+		return &node{T: "int", S: strconv.FormatInt(x, 10)}
+	case float64:
+		return &node{T: "float", S: canonFloat(x)}
+	case string:
+		return &node{T: "string", S: x}
+	case bool:
+		return &node{T: "bool", S: strconv.FormatBool(x)}
+	case time.Time:
+		return timeNode(x, micro)
+	case LocalDateTime:
+		return &node{T: "local-datetime", S: dateStr(x.Year, x.Month, x.Day) + "T" + timeStr(x.Hour, x.Minute, x.Second, x.Nanosecond, micro)}
+	case LocalDate:
+		return &node{T: "local-date", S: dateStr(x.Year, x.Month, x.Day)}
+	case LocalTime:
+		return &node{T: "local-time", S: timeStr(x.Hour, x.Minute, x.Second, x.Nanosecond, micro)}
+	}
+	return &node{T: fmt.Sprintf("unexpected Go type %T", x), S: fmt.Sprint(x)}
+}
+
+// normalise puts a tomllib tree into the same shape as ours (floats canonicalised).
+func normalise(nd *node) {
+	switch nd.T {
+	case "float":
+		f, err := strconv.ParseFloat(nd.S, 64)
+		if err == nil {
+			nd.S = canonFloat(f)
+		}
+	case "table":
+		for _, c := range nd.Kids {
+			normalise(c)
+		}
+	case "array":
+		for _, c := range nd.Items {
+			normalise(c)
+		}
+	}
+}
+
+func sameNode(a, b *node) bool {
+	if a.T != b.T || a.S != b.S || len(a.Kids) != len(b.Kids) || len(a.Items) != len(b.Items) {
+		return false
+	}
+	for k, c := range a.Kids {
+		d, ok := b.Kids[k]
+		if !ok || !sameNode(c, d) {
+			return false
+		}
+	}
+	for i := range a.Items {
+		if !sameNode(a.Items[i], b.Items[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func render(nd *node) string {
+	switch nd.T {
+	case "table":
+		keys := make([]string, 0, len(nd.Kids))
+		for k := range nd.Kids {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		parts := make([]string, 0, len(keys))
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%q: %s", k, render(nd.Kids[k])))
+		}
+		return "{" + strings.Join(parts, ", ") + "}"
+	case "array":
+		parts := make([]string, 0, len(nd.Items))
+		for _, it := range nd.Items {
+			parts = append(parts, render(it))
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	case "string":
+		return fmt.Sprintf("%q", nd.S)
+	default:
+		return nd.T + "(" + nd.S + ")"
+	}
+}
+
+// ---------------------------------------------------------------------------------------
+// Python tomllib as a child process (one per test binary, JSON lines both ways).
+
+const tomllibScript = `
+import sys, json, tomllib, datetime
+
+def node(v):
+    if isinstance(v, bool):
+        return {"t": "bool", "s": "true" if v else "false"}
+    if isinstance(v, int):
+        return {"t": "int", "s": str(v)}
+    if isinstance(v, float):
+        return {"t": "float", "s": repr(v)}
+    if isinstance(v, str):
+        return {"t": "string", "s": v}
+    if isinstance(v, datetime.datetime):
+        s = "%04d-%02d-%02dT%02d:%02d:%02d.%06d" % (v.year, v.month, v.day, v.hour, v.minute, v.second, v.microsecond)
+        if v.tzinfo is None:
+            return {"t": "local-datetime", "s": s}
+        return {"t": "datetime", "s": "%s@%d" % (s, int(v.utcoffset().total_seconds()))}
+    if isinstance(v, datetime.date):
+        return {"t": "local-date", "s": "%04d-%02d-%02d" % (v.year, v.month, v.day)}
+    if isinstance(v, datetime.time):
+        return {"t": "local-time", "s": "%02d:%02d:%02d.%06d" % (v.hour, v.minute, v.second, v.microsecond)}
+    if isinstance(v, dict):
+        return {"t": "table", "kids": {k: node(x) for k, x in v.items()}}
+    if isinstance(v, list):
+        return {"t": "array", "items": [node(x) for x in v]}
+    raise TypeError(str(type(v)))
+
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        out = {"ok": True, "tree": node(tomllib.loads(req["doc"]))}
+    except Exception as e:
+        out = {"ok": False, "err": "%s: %s" % (type(e).__name__, e)}
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+`
+
+var (
+	pyOnce  sync.Once
+	pyMu    sync.Mutex
+	pyIn    *bufio.Writer
+	pyOut   *bufio.Reader
+	pyError error
+)
+
+func startPython() {
+	cmd := exec.Command("python3", "-c", tomllibScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		pyError = err
+		return
+	}
+	pyIn, pyOut = bufio.NewWriter(stdin), bufio.NewReader(stdout)
+}
+
+// tomllib parses doc with Python's tomllib and returns the tagged tree, or the error text.
+func tomllib(t testing.TB, doc string) (*node, string) {
+	pyOnce.Do(startPython)
+	if pyError != nil {
+		t.Fatalf("cannot start python3: %v", pyError)
+	}
+	pyMu.Lock()
+	defer pyMu.Unlock()
+	req, _ := json.Marshal(map[string]string{"doc": doc})
+	pyIn.Write(req)
+	pyIn.WriteByte('\n')
+	if err := pyIn.Flush(); err != nil {
+		t.Fatalf("writing to python: %v", err)
+	}
+	line, err := pyOut.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from python: %v", err)
+	}
+	var resp struct {
+		OK   bool   `json:"ok"`
+		Tree *node  `json:"tree"`
+		Err  string `json:"err"`
+	}
+	if err := json.Unmarshal(line, &resp); err != nil {
+		t.Fatalf("bad python response %q: %v", line, err)
+	}
+	if !resp.OK {
+		return nil, resp.Err
+	}
+	normalise(resp.Tree)
+	return resp.Tree, ""
+}
+
+// ---------------------------------------------------------------------------------------
+// A TOML 1.0 writer for the decoder properties: a pure function of the tree and a tape of
+// syntax choices (every coin and pick below reads the tape, nothing is drawn here).
+
+type emitter struct {
+	tp *tape
+	sb strings.Builder
+	nl string
+	// decimalFloats: integers meant for a float field are written in decimal only (the
+	// shape of go-toml/1, switched off under HEGEL_NO_KNOWN=1).
+	decimalFloats bool
+}
+
+func newEmitter(choices []int) *emitter {
+	return &emitter{tp: &tape{xs: choices}, nl: "\n"}
+}
+
+var bareKeyRe = regexp.MustCompile(`^[A-Za-z0-9_-]+$`)
+
+func hasControl(s string) bool {
+	for _, r := range s {
+		if (r < 0x20 && r != '\t') || r == 0x7f {
+			return true
+		}
+	}
+	return false
+}
+
+// ws is one space (three times in six), nothing, a tab or two spaces.
+func (e *emitter) ws() string {
+	return e.tp.pick([]string{" ", "", "\t", "  ", " ", " "})
+}
+
+// comment is a comment a quarter of the time.
+func (e *emitter) comment() string {
+	if !e.tp.coin(25) {
+		return ""
+	}
+	return e.ws() + "#" + e.tp.pick([]string{"", " c", " a = 1", "\t[x]", " \"q\" 'q' \\", " \u00e9"})
+}
+
+func (e *emitter) blank() {
+	if e.tp.coin(20) {
+		e.sb.WriteString(e.ws() + e.nl)
+	}
+	if e.tp.coin(15) {
+		e.sb.WriteString(e.comment() + e.nl)
+	}
+}
+
+// basicBody writes s as the inside of a basic string.  In multiline mode newlines and
+// tabs may stay raw and line-ending backslashes may be inserted before non-blank runes.
+func (e *emitter) basicBody(s string, multiline bool) string {
+	var sb strings.Builder
+	for _, r := range s {
+		switch {
+		case r == '"' || r == '\\':
+			sb.WriteRune('\\')
+			sb.WriteRune(r)
+		case r == '\n' && multiline && e.tp.coin(70):
+			sb.WriteRune('\n')
+		case r == '\t' && e.tp.coin(50):
+			sb.WriteRune('\t')
+		case r < 0x20 || r == 0x7f:
+			switch r {
+			case '\b':
+				sb.WriteString("\\b")
+			case '\t':
+				sb.WriteString(e.tp.pick([]string{"\\t", "\t"}))
+			case '\n':
+				sb.WriteString(e.tp.pick([]string{"\\n", "\\U0000000a"}))
+			case '\f':
+				sb.WriteString("\\f")
+			case '\r':
+				sb.WriteString("\\r")
+			default:
+				sb.WriteString(fmt.Sprintf("\\u%04X", r))
+			}
+		case e.tp.coin(5):
+			if r <= 0xffff && e.tp.coin(50) {
+				sb.WriteString(fmt.Sprintf("\\u%04X", r))
+			} else {
+				sb.WriteString(fmt.Sprintf("\\U%08x", r))
+			}
+		default:
+			if multiline && !strings.ContainsRune(" \t\n", r) && e.tp.coin(8) {
+				// A line-ending backslash trims the whitespace and newlines that follow it.
+				sb.WriteString("\\" + e.tp.pick([]string{"", " ", "\t"}) + "\n" + e.tp.pick([]string{"", "  ", "\t\n"}))
+			}
+			sb.WriteRune(r)
+		}
+	}
+	return sb.String()
+}
+
+// str writes s as a literal string when it can be (twice in six), a multi-line literal
+// (once), a multi-line basic string (twice) or a basic string.
+func (e *emitter) str(s string) string {
+	literalOK := !strings.ContainsRune(s, '\'') && !hasControl(s) && !strings.ContainsRune(s, '\n')
+	mlLiteralOK := !strings.Contains(s, "'''") && !strings.HasSuffix(s, "'") && !hasControl(strings.ReplaceAll(s, "\n", ""))
+	switch e.tp.upto(5) {
+	case 0, 1:
+		if literalOK {
+			return "'" + s + "'"
+		}
+	case 2:
+		if mlLiteralOK {
+			lead := e.tp.pick([]string{"", "\n"})
+			if strings.HasPrefix(s, "\n") {
+				lead = "\n" // the newline right after the delimiter is trimmed
+			}
+			return "'''" + lead + s + "'''"
+		}
+	case 3, 4:
+		lead := e.tp.pick([]string{"", "\n", "\r\n"})
+		body := e.basicBody(s, true)
+		if strings.HasPrefix(body, "\n") {
+			lead = e.tp.pick([]string{"\n", "\r\n"}) // same trimming rule
+		}
+		// Two quotes before the delimiter are fine; a third would close it early, and a
+		// backslash before it would escape it - both cannot arise since both are escaped.
+		return `"""` + lead + body + `"""`
+	}
+	return `"` + e.basicBody(s, false) + `"`
+}
+
+// key writes k bare when it can be (four times in five), else literal-quoted when it can be
+// (half the time) or basic-quoted.
+func (e *emitter) key(k string) string {
+	if bareKeyRe.MatchString(k) && !e.tp.coin(20) {
+		return k
+	}
+	if !strings.ContainsRune(k, '\'') && !hasControl(k) && !strings.ContainsRune(k, '\n') && e.tp.coin(50) {
+		return "'" + k + "'"
+	}
+	return `"` + e.basicBody(k, false) + `"`
+}
+
+func (e *emitter) keyPath(path []string) string {
+	parts := make([]string, len(path))
+	for i, k := range path {
+		parts[i] = e.key(k)
+	}
+	sep := e.tp.pick([]string{".", ".", " . ", ". ", "\t."})
+	return strings.Join(parts, sep)
+}
+
+// underscores puts underscores between some digits, three times in ten.
+func (e *emitter) underscores(digits string) string {
+	if len(digits) < 2 || !e.tp.coin(30) {
+		return digits
+	}
+	var sb strings.Builder
+	for i, c := range digits {
+		if i > 0 && e.tp.coin(30) {
+			sb.WriteByte('_')
+		}
+		sb.WriteRune(c)
+	}
+	return sb.String()
+}
+
+// prefixed writes u in base 16 (upper case half the time), 8 or 2 with its prefix.
+func (e *emitter) prefixed(u uint64, base int) string {
+	switch base {
+	case 16:
+		s := strconv.FormatUint(u, 16)
+		if e.tp.coin(50) {
+			s = strings.ToUpper(s)
+		}
+		return "0x" + e.underscores(s)
+	case 8:
+		return "0o" + e.underscores(strconv.FormatUint(u, 8))
+	}
+	return "0b" + e.underscores(strconv.FormatUint(u, 2))
+}
+
+// decimal writes i in decimal, with a plus sign once in five when non-negative.
+func (e *emitter) decimal(i int64) string {
+	s := strconv.FormatInt(i, 10)
+	if i >= 0 && e.tp.coin(20) {
+		return "+" + e.underscores(s)
+	}
+	if i < 0 {
+		return "-" + e.underscores(s[1:])
+	}
+	return e.underscores(s)
+}
+
+// integer writes i in decimal, or (non-negative, two times in five) in hex, octal or
+// binary.
+func (e *emitter) integer(i int64) string {
+	if i >= 0 && !e.decimalFloats && e.tp.coin(40) {
+		return e.prefixed(uint64(i), []int{16, 8, 2}[e.tp.upto(2)])
+	}
+	return e.decimal(i)
+}
+
+// float writes f in plain decimal notation when its magnitude allows (three times in
+// five) or with an exponent.
+func (e *emitter) float(f float64) string {
+	switch {
+	case math.IsNaN(f):
+		return e.tp.pick([]string{"nan", "+nan", "-nan"})
+	case math.IsInf(f, 1):
+		return e.tp.pick([]string{"inf", "+inf"})
+	case math.IsInf(f, -1):
+		return "-inf"
+	}
+	sign := ""
+	if math.Signbit(f) {
+		sign, f = "-", -f
+	} else if e.tp.coin(15) {
+		sign = "+"
+	}
+	var s string
+	exp := math.Log10(f)
+	if f == 0 || (exp > -6 && exp < 18 && !e.tp.coin(40)) {
+		s = strconv.FormatFloat(f, 'f', -1, 64)
+		if !strings.Contains(s, ".") {
+			s += e.tp.pick([]string{".0", "e0", "E+0", ".0e-0"})
+		}
+	} else {
+		s = strconv.FormatFloat(f, 'e', -1, 64) // like 1.5e-07 or 1e+300
+		if e.tp.coin(50) {
+			s = strings.Replace(s, "e", "E", 1)
+		}
+		if e.tp.coin(30) {
+			s = strings.Replace(s, "e+", "e", 1)
+			s = strings.Replace(s, "E+", "E", 1)
+		}
+	}
+	if e.tp.coin(20) {
+		// Underscores between digits of the integer part.
+		dot := strings.IndexAny(s, ".eE")
+		if dot < 0 {
+			dot = len(s)
+		}
+		s = e.underscores(s[:dot]) + s[dot:]
+	}
+	return sign + s
+}
+
+// fractionDigits writes the fraction of a second with as many digits as it needs or more
+// (up to nine); a zero fraction is omitted seven times in ten.
+func (e *emitter) fractionDigits(nanos int) string {
+	if nanos == 0 && !e.tp.coin(30) {
+		return ""
+	}
+	s := fmt.Sprintf("%09d", nanos)
+	trimmed := strings.TrimRight(s, "0")
+	k := len(trimmed)
+	if k == 0 {
+		k = 1
+	}
+	digits := k + e.tp.upto(9-k)
+	return "." + s[:digits]
+}
+
+func (e *emitter) localTime(lt LocalTime) string {
+	return fmt.Sprintf("%02d:%02d:%02d%s", lt.Hour, lt.Minute, lt.Second, e.fractionDigits(lt.Nanosecond))
+}
+
+func (e *emitter) dateTime(t time.Time) string {
+	_, off := t.Zone()
+	var zone string
+	if off == 0 {
+		zone = e.tp.pick([]string{"Z", "z", "+00:00", "-00:00"})
+	} else {
+		sign := "+"
+		if off < 0 {
+			sign, off = "-", -off
+		}
+		zone = fmt.Sprintf("%s%02d:%02d", sign, off/3600, off%3600/60)
+	}
+	return dateStr(t.Year(), int(t.Month()), t.Day()) + e.tp.pick([]string{"T", "t", " "}) +
+		e.localTime(LocalTime{Hour: t.Hour(), Minute: t.Minute(), Second: t.Second(), Nanosecond: t.Nanosecond()}) + zone
+}
+
+// value writes v as an inline value.  inInline forbids newlines (inside inline tables).
+func (e *emitter) value(v *val, inInline bool) string {
+	switch v.kind {
+	case "int":
+		return e.integer(v.i)
+	case "float":
+		return e.float(v.f)
+	case "string":
+		return e.str(v.s)
+	case "bool":
+		return strconv.FormatBool(v.b)
+	case "datetime":
+		return e.dateTime(v.t)
+	case "local-datetime":
+		return dateStr(v.ld.Year, v.ld.Month, v.ld.Day) + e.tp.pick([]string{"T", "t", " "}) + e.localTime(v.lt)
+	case "local-date":
+		return dateStr(v.ld.Year, v.ld.Month, v.ld.Day)
+	case "local-time":
+		return e.localTime(v.lt)
+	case "array":
+		return e.array(v, inInline)
+	case "table":
+		return e.inlineTable(v)
+	}
+	panic("unknown kind " + v.kind)
+}
+
+// gap is whitespace, optionally with newlines and comments, allowed inside arrays.
+func (e *emitter) gap(inInline bool) string {
+	if inInline || !e.tp.coin(40) {
+		return e.ws()
+	}
+	var sb strings.Builder
+	for i := 1 + e.tp.upto(1); i > 0; i-- {
+		sb.WriteString(e.ws() + e.comment() + e.nl)
+	}
+	sb.WriteString(e.ws())
+	return sb.String()
+}
+
+func (e *emitter) array(v *val, inInline bool) string {
+	var sb strings.Builder
+	sb.WriteString("[")
+	sb.WriteString(e.gap(inInline))
+	for i, it := range v.items {
+		if i > 0 {
+			sb.WriteString(",")
+			sb.WriteString(e.gap(inInline))
+		}
+		sb.WriteString(e.value(it, inInline))
+		sb.WriteString(e.gap(inInline))
+	}
+	if len(v.items) > 0 && e.tp.coin(30) {
+		sb.WriteString(",")
+		sb.WriteString(e.gap(inInline))
+	}
+	sb.WriteString("]")
+	return sb.String()
+}
+
+func (e *emitter) inlineTable(v *val) string {
+	var sb strings.Builder
+	sb.WriteString("{" + e.ws())
+	for i, k := range e.order(v) {
+		if i > 0 {
+			sb.WriteString("," + e.ws())
+		}
+		sb.WriteString(e.key(k) + e.ws() + "=" + e.ws() + e.value(v.kids[k], true))
+	}
+	sb.WriteString(e.ws() + "}")
+	return sb.String()
+}
+
+// order is the keys of v in their order, or (half the time) sorted by a rank read from the
+// tape for each key (equal ranks keep the order).
+func (e *emitter) order(v *val) []string {
+	keys := append([]string(nil), v.keys...)
+	if e.tp.coin(50) {
+		rank := make(map[string]int, len(keys))
+		for _, k := range keys {
+			rank[k] = e.tp.next()
+		}
+		sort.SliceStable(keys, func(i, j int) bool { return rank[keys[i]] < rank[keys[j]] })
+	}
+	return keys
+}
+
+// allNonEmpty reports whether every table inside v has at least one key, so that the
+// subtree can be written entirely with dotted keys (which cannot express an empty table).
+func allNonEmpty(v *val) bool {
+	switch v.kind {
+	case "table":
+		if len(v.kids) == 0 {
+			return false
+		}
+		for _, c := range v.kids {
+			if !allNonEmpty(c) {
+				return false
+			}
+		}
+	case "array":
+		for _, c := range v.items {
+			if c.isTable() && !allNonEmpty(c) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func (e *emitter) kv(prefix []string, k string, v *val) {
+	e.sb.WriteString(e.ws() + e.keyPath(append(append([]string{}, prefix...), k)) + e.ws() + "=" + e.ws() + e.value(v, false) + e.comment() + e.nl)
+}
+
+// dotted writes table t entirely as dotted key/value lines under prefix.
+func (e *emitter) dotted(prefix []string, t *val) {
+	for _, k := range e.order(t) {
+		c := t.kids[k]
+		if c.isTable() && e.tp.coin(70) {
+			e.dotted(append(append([]string{}, prefix...), k), c)
+			continue
+		}
+		e.kv(prefix, k, c)
+	}
+}
+
+// block writes table t at path: its header (unless root), its key/values, then the
+// children that get headers of their own.
+func (e *emitter) block(path []string, t *val, header string) {
+	if header != "" {
+		e.blank()
+		e.sb.WriteString(e.ws() + header + e.ws() + e.keyPath(path) + strings.Repeat("]", len(header)) + e.comment() + e.nl)
+	}
+	type later struct {
+		key string
+		v   *val
+	}
+	var headers []later
+	for _, k := range e.order(t) {
+		c := t.kids[k]
+		switch {
+		case c.isTable() && e.tp.coin(45):
+			headers = append(headers, later{k, c})
+		case c.isTable() && allNonEmpty(c) && e.tp.coin(50):
+			e.dotted([]string{k}, c)
+		case c.tableArray() && e.tp.coin(60):
+			headers = append(headers, later{k, c})
+		default:
+			e.kv(nil, k, c)
+		}
+		e.blank()
+	}
+	for _, h := range headers {
+		sub := append(append([]string{}, path...), h.key)
+		if h.v.isTable() {
+			e.block(sub, h.v, "[")
+		} else {
+			for _, el := range h.v.items {
+				e.block(sub, el, "[[")
+			}
+		}
+	}
+}
+
+// writeDoc writes root as a TOML 1.0 document, spelled as the tape says.
+func writeDoc(root *val, choices []int) string {
+	e := newEmitter(choices)
+	e.nl = e.tp.pick([]string{"\n", "\n", "\n", "\r\n"})
+	e.blank()
+	e.block(nil, root, "")
+	if e.tp.coin(30) {
+		e.sb.WriteString(e.ws() + e.comment())
+	}
+	return e.sb.String()
+}
+
+// ---------------------------------------------------------------------------------------
+// Encoder options.
+
+type encOpts struct {
+	inline, arraysML, indent, omitSuper bool
+	symbol                              string
+}
+
+// encOptions: each switch on three times in ten, the indent symbol two spaces (the
+// default), a tab, one space or nothing.
+var encOptions = hegel.Composite(func(tc hegel.TestCase) encOpts {
+	return encOpts{
+		inline:    hegel.Draw(tc, chance(30)),
+		arraysML:  hegel.Draw(tc, chance(30)),
+		indent:    hegel.Draw(tc, chance(30)),
+		omitSuper: hegel.Draw(tc, chance(30)),
+		symbol:    hegel.Draw(tc, hegel.SampledFrom([]string{"  ", "\t", " ", ""})),
+	}
+})
+
+// inlineEncOptions: the options with inline tables forced on.
+var inlineEncOptions = hegel.Map(encOptions, func(o encOpts) encOpts {
+	o.inline = true
+	return o
+})
+
+func (o encOpts) marshal(v interface{}) ([]byte, error) {
+	var buf bytes.Buffer
+	enc := NewEncoder(&buf)
+	enc.SetTablesInline(o.inline)
+	enc.SetArraysMultiline(o.arraysML)
+	enc.SetIndentTables(o.indent)
+	enc.SetIndentSymbol(o.symbol)
+	enc.SetOmitEmptySuperTables(o.omitSuper)
+	err := enc.Encode(v)
+	return buf.Bytes(), err
+}
+
+// ---------------------------------------------------------------------------------------
+// Encoder: Marshal output is TOML that tomllib and go-toml both read back as the input.
+
+// encCase: a typed tree and the options it is encoded under.
+type encCase struct {
+	tree *val
+	opts encOpts
+}
+
+func encCases(ts hegel.Generator[*val], optsGen hegel.Generator[encOpts]) hegel.Generator[encCase] {
+	return hegel.Composite(func(tc hegel.TestCase) encCase {
+		return encCase{tree: hegel.Draw(tc, ts), opts: hegel.Draw(tc, optsGen)}
+	})
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c encCase) GoString() string {
+	return fmt.Sprintf("%s\nencoded with %+v", render(nodeOfVal(c.tree, false)), c.opts)
+}
+
+var (
+	typedEncCases = encCases(typedTrees, encOptions)
+	rawEncCases   = encCases(rawTrees, inlineEncOptions)
+)
+
+func TestHegelMarshalOutputIsReadBackByTomllibAsTheInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, typedEncCases)
+		in := toGo(c.tree)
+		doc, err := c.opts.marshal(in)
+		if err != nil {
+			ht.Fatalf("Marshal failed: %v", err)
+		}
+		note(ht, "document:\n%s", doc)
+		got, perr := tomllib(t, string(doc))
+		if perr != "" {
+			ht.Fatalf("tomllib rejects go-toml's output: %s", perr)
+		}
+		want := nodeOfVal(c.tree, true)
+		if !sameNode(got, want) {
+			ht.Fatalf("tomllib reads\n  %s\nbut the encoder was given\n  %s", render(got), render(want))
+		}
+	})
+}
+
+func TestHegelMarshalThenUnmarshalIntoAnInterfaceIsTheIdentity(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, typedEncCases)
+		doc, err := c.opts.marshal(toGo(c.tree))
+		if err != nil {
+			ht.Fatalf("Marshal failed: %v", err)
+		}
+		note(ht, "document:\n%s", doc)
+		var back map[string]interface{}
+		if err := Unmarshal(doc, &back); err != nil {
+			ht.Fatalf("Unmarshal of the encoder's own output failed: %v", err)
+		}
+		got, want := nodeOfAny(back, false), nodeOfVal(c.tree, false)
+		if !sameNode(got, want) {
+			ht.Fatalf("read back\n  %s\nbut encoded\n  %s", render(got), render(want))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// Decoder: generated TOML 1.0 documents decode into the tree they were written from, and
+// tomllib agrees (a tomllib disagreement means the writer above is wrong, not go-toml).
+
+// docCase: a tree and the tape of syntax choices it is written with.
+type docCase struct {
+	tree    *val
+	choices []int
+}
+
+func (c docCase) document() string { return writeDoc(c.tree, c.choices) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c docCase) GoString() string {
+	return fmt.Sprintf("%s\nwritten as:\n%s", render(nodeOfVal(c.tree, false)), c.document())
+}
+
+var docCases = hegel.Composite(func(tc hegel.TestCase) docCase {
+	return docCase{tree: hegel.Draw(tc, plainTrees), choices: hegel.Draw(tc, tapes)}
+})
+
+func TestHegelGeneratedDocumentsDecodeIntoTheTreeTheyWereWrittenFrom(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, docCases)
+		doc := c.document()
+		want := nodeOfVal(c.tree, false)
+		py, perr := tomllib(t, doc)
+		if perr != "" {
+			ht.Fatalf("test-suite defect: tomllib rejects the generated document: %s", perr)
+		}
+		if wantMicro := nodeOfVal(c.tree, true); !sameNode(py, wantMicro) {
+			ht.Fatalf("test-suite defect: tomllib reads\n  %s\nbut the writer meant\n  %s", render(py), render(wantMicro))
+		}
+		var back map[string]interface{}
+		if err := Unmarshal([]byte(doc), &back); err != nil {
+			ht.Fatalf("go-toml rejects a document tomllib accepts: %v", err)
+		}
+		if got := nodeOfAny(back, false); !sameNode(got, want) {
+			ht.Fatalf("go-toml reads\n  %s\nbut the document means\n  %s", render(got), render(want))
+		}
+		// The streaming decoder must agree with Unmarshal.
+		var again map[string]interface{}
+		if err := NewDecoder(bytes.NewReader([]byte(doc))).Decode(&again); err != nil {
+			ht.Fatalf("Decoder.Decode fails where Unmarshal succeeds: %v", err)
+		}
+		if got := nodeOfAny(again, false); !sameNode(got, want) {
+			ht.Fatalf("Decoder.Decode reads\n  %s\nbut Unmarshal reads\n  %s", render(got), render(want))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// Typed decoding of numbers: a literal decodes into a numeric field exactly when it fits.
+
+type numbers struct {
+	I   int
+	I8  int8
+	I16 int16
+	I32 int32
+	I64 int64
+	U   uint
+	U8  uint8
+	U16 uint16
+	U32 uint32
+	U64 uint64
+	F32 float32
+	F64 float64
+	Any interface{}
+}
+
+var (
+	numberFields = hegel.SampledFrom([]string{"I", "I8", "I16", "I32", "I64", "U", "U8", "U16", "U32", "U64", "F32", "F64", "Any"})
+	floatFields  = hegel.SampledFrom([]string{"F64", "F32"})
+)
+
+func isFloatField(field string) bool { return strings.HasPrefix(field, "F") }
+
+func intFits(field string, v int64) bool {
+	switch field {
+	case "I8":
+		return v >= math.MinInt8 && v <= math.MaxInt8
+	case "I16":
+		return v >= math.MinInt16 && v <= math.MaxInt16
+	case "I32":
+		return v >= math.MinInt32 && v <= math.MaxInt32
+	case "U8":
+		return v >= 0 && v <= math.MaxUint8
+	case "U16":
+		return v >= 0 && v <= math.MaxUint16
+	case "U32":
+		return v >= 0 && v <= math.MaxUint32
+	case "U", "U64":
+		return v >= 0
+	}
+	return true
+}
+
+// wantInt is the value field holds after decoding the integer v into it.
+func wantInt(field string, v int64) interface{} {
+	switch field {
+	case "I":
+		return int(v)
+	case "I8":
+		return int8(v)
+	case "I16":
+		return int16(v)
+	case "I32":
+		return int32(v)
+	case "U":
+		return uint(v)
+	case "U8":
+		return uint8(v)
+	case "U16":
+		return uint16(v)
+	case "U32":
+		return uint32(v)
+	case "U64":
+		return uint64(v)
+	case "F32":
+		return float32(float64(v))
+	case "F64":
+		return float64(v)
+	}
+	return v
+}
+
+// intFieldMismatch decodes doc, whose one key names field and holds the integer v, and
+// reports how go-toml departs from "the value when it fits, an error otherwise" ("" when it
+// does not).
+func intFieldMismatch(doc, field string, v int64) string {
+	var got numbers
+	err := Unmarshal([]byte(doc), &got)
+	fits := intFits(field, v)
+	if fits && err != nil {
+		return fmt.Sprintf("%d fits %s but decoding failed: %v", v, field, err)
+	}
+	if !fits {
+		if err == nil {
+			return fmt.Sprintf("%d does not fit %s but decoding succeeded with %+v", v, field, got)
+		}
+		return ""
+	}
+	want := wantInt(field, v)
+	gotField := reflect.ValueOf(got).FieldByName(field).Interface()
+	if !reflect.DeepEqual(gotField, want) {
+		return fmt.Sprintf("%s decoded as %v (%T), want %v (%T)", strings.TrimSpace(doc), gotField, gotField, want, want)
+	}
+	return ""
+}
+
+// intLitCase: an integer, the field it is decoded into and the tape its literal is spelled
+// with (hex, octal and binary literals for a float field are go-toml/1).
+type intLitCase struct {
+	v       int64
+	field   string
+	choices []int
+}
+
+func (c intLitCase) document() string {
+	e := newEmitter(c.choices)
+	e.decimalFloats = noKnown && isFloatField(c.field)
+	return strings.ToLower(c.field) + " = " + e.integer(c.v) + "\n"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c intLitCase) GoString() string { return fmt.Sprintf("%d: %s", c.v, c.document()) }
+
+var intLitCases = hegel.Composite(func(tc hegel.TestCase) intLitCase {
+	return intLitCase{v: hegel.Draw(tc, int64s), field: hegel.Draw(tc, numberFields), choices: hegel.Draw(tc, tapes)}
+})
+
+func TestHegelIntegerLiteralsDecodeIntoNumericFieldsExactlyWhenTheyFit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, intLitCases)
+		if d := intFieldMismatch(c.document(), c.field, c.v); d != "" {
+			ht.Fatalf("%s", d)
+		}
+	})
+}
+
+func float32Of(f float64) float64 { return float64(float32(f)) }
+
+// roundsDownToMaxFloat32 reports whether f is above MaxFloat32 as a float64 and still a
+// finite float32 (the shape of go-toml/2).
+func roundsDownToMaxFloat32(f float64) bool {
+	return math.Abs(f) > math.MaxFloat32 && !math.IsInf(float32Of(f), 0)
+}
+
+// float32FieldMismatch decodes doc, whose one key f32 holds the float f, and reports how
+// go-toml departs from "the float32 value when that is finite, an error otherwise".
+func float32FieldMismatch(doc string, f float64) string {
+	var got numbers
+	err := Unmarshal([]byte(doc), &got)
+	finite := !math.IsInf(float32Of(f), 0) || math.IsInf(f, 0)
+	if finite && err != nil {
+		return fmt.Sprintf("decoding %v into float32 failed: %v", f, err)
+	}
+	if !finite {
+		if err == nil {
+			return fmt.Sprintf("decoding %v into float32 overflowed silently to %v", f, got.F32)
+		}
+		return ""
+	}
+	if canonFloat(float64(got.F32)) != canonFloat(float64(float32(f))) {
+		return fmt.Sprintf("decoded %v, want %v", got.F32, float32(f))
+	}
+	return ""
+}
+
+// floatLitCase: a float, the field it is decoded into and the tape its literal is spelled
+// with.
+type floatLitCase struct {
+	f       float64
+	field   string
+	choices []int
+}
+
+func (c floatLitCase) document() string {
+	return strings.ToLower(c.field) + " = " + newEmitter(c.choices).float(c.f) + "\n"
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c floatLitCase) GoString() string { return fmt.Sprintf("%v: %s", c.f, c.document()) }
+
+var floatLitCases = hegel.Composite(func(tc hegel.TestCase) floatLitCase {
+	return floatLitCase{f: hegel.Draw(tc, floats), field: hegel.Draw(tc, numberFields), choices: hegel.Draw(tc, tapes)}
+})
+
+func TestHegelFloatLiteralsDecodeIntoFloatFieldsAndNotIntoIntegerFields(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, floatLitCases)
+		f, field := c.f, c.field
+		if noKnown {
+			// go-toml/2: a literal above MaxFloat32 that rounds to a finite float32.
+			ht.Assume(!(field == "F32" && roundsDownToMaxFloat32(f)))
+		}
+		doc := c.document()
+		var got numbers
+		err := Unmarshal([]byte(doc), &got)
+		switch field {
+		case "F64", "Any":
+			if err != nil {
+				ht.Fatalf("decoding %v into %s failed: %v", f, field, err)
+			}
+			var back float64
+			if field == "F64" {
+				back = got.F64
+			} else {
+				back, _ = got.Any.(float64)
+			}
+			if canonFloat(back) != canonFloat(f) {
+				ht.Fatalf("decoded %v, want %v", back, f)
+			}
+		case "F32":
+			if d := float32FieldMismatch(doc, f); d != "" {
+				ht.Fatalf("%s", d)
+			}
+		default:
+			if err == nil {
+				ht.Fatalf("a TOML float decoded into integer field %s: %+v", field, got)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// Struct round trips: Marshal then Unmarshal restores every field the encoder writes.
+
+type Temp float64
+
+func (c Temp) MarshalText() ([]byte, error) {
+	return []byte(strconv.FormatFloat(float64(c), 'g', -1, 64) + "C"), nil
+}
+
+func (c *Temp) UnmarshalText(b []byte) error {
+	f, err := strconv.ParseFloat(strings.TrimSuffix(string(b), "C"), 64)
+	if err != nil {
+		return err
+	}
+	*c = Temp(f)
+	return nil
+}
+
+type inner struct {
+	X int    `toml:"x"`
+	Y string `toml:"y,omitempty"`
+	Z []int  `toml:"z"`
+}
+
+type embedded struct {
+	EmbA int
+	EmbB []string
+}
+
+type rich struct {
+	embedded
+	I       int
+	I8      int8
+	I16     int16
+	I32     int32
+	I64     int64
+	U       uint
+	U8      uint8
+	U16     uint16
+	U32     uint32
+	U64     uint64
+	F32     float32
+	F64     float64
+	S       string
+	SM      string `toml:"sm,multiline"`
+	B       bool
+	T       time.Time
+	TP      *time.Time
+	LD      LocalDate
+	LT      LocalTime
+	LDT     LocalDateTime
+	P       *int
+	PS      *inner
+	Arr     [3]int
+	SI      []int
+	SS      []string
+	SF      []float64
+	ST      []inner
+	SM2     []map[string]int
+	MI      map[string]int
+	MS      map[string]inner
+	MM      map[string]map[string]string
+	In      inner `toml:"in,inline"`
+	N       inner `toml:"n"`
+	Any     interface{}
+	Temp    Temp
+	Om      int    `toml:"om,omitempty"`
+	Oz      inner  `toml:"oz,omitzero"`
+	Renamed string `toml:"re-named" comment:"a comment"`
+	Skip    int    `toml:"-"`
+}
+
+var (
+	ints   = hegel.Map(int64s, func(i int64) int { return int(i) })
+	inners = hegel.Composite(func(tc hegel.TestCase) inner {
+		return inner{
+			X: hegel.Draw(tc, ints),
+			Y: hegel.Draw(tc, maybe(60, texts)),
+			Z: hegel.Draw(tc, nonNil(many(hegel.Integers(-100, 100), 0, 3))),
+		}
+	})
+	embeddeds = hegel.Composite(func(tc hegel.TestCase) embedded {
+		return embedded{EmbA: hegel.Draw(tc, hegel.Integers(-9, 9)), EmbB: []string{hegel.Draw(tc, texts)}}
+	})
+	// precisionTimes: a local time, half the time with a Precision (the number of fractional
+	// digits written) and a Nanosecond consistent with it, so that the text is exact.
+	precisionTimes = hegel.Composite(func(tc hegel.TestCase) LocalTime {
+		lt := hegel.Draw(tc, localTimes)
+		if p := hegel.Draw(tc, maybe(50, hegel.Integers(1, 9))); p > 0 {
+			lt.Precision = p
+			unit := int(math.Pow10(9 - p))
+			lt.Nanosecond -= lt.Nanosecond % unit
+		}
+		return lt
+	})
+	// float32s: any float as a float32; MaxFloat32 (whose encoding is go-toml/2) only while
+	// the known shapes are on.
+	float32s = shaped(
+		hegel.Map(floats, func(f float64) float32 { return float32(f) }),
+		hegel.Filter(hegel.Map(floats, func(f float64) float32 { return float32(f) }), func(x float32) bool { return math.Abs(float64(x)) != math.MaxFloat32 }),
+	)
+	oneIntMaps = hegel.Map(pairs(mapKeys, hegel.Integers(0, 9)), func(p pair[string, int]) map[string]int {
+		return map[string]int{p.a: p.b}
+	})
+	oneStringMaps = hegel.Map(pairs(mapKeys, texts), func(p pair[string, string]) map[string]string {
+		return map[string]string{p.a: p.b}
+	})
+	anys = anyValues(2)
+)
+
+// anyValues: a value of the dynamic types the decoder produces for an interface{} target
+// (int64, float64, string, bool, time.Time, []interface{}, map[string]interface{}), the
+// collections nesting maxDepth deep: a scalar five times in eight, a list once, a map twice.
+func anyValues(maxDepth int) hegel.Generator[interface{}] {
+	depth := 0
+	var values hegel.Generator[interface{}]
+	leaves := hegel.OneOf(asAny(int64s), asAny(floats), asAny(texts), asAny(hegel.Booleans()), asAny(times))
+	lists := hegel.Composite(func(tc hegel.TestCase) interface{} {
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, nonNil(hegel.Lists(values).MaxSize(3)))
+	})
+	maps := hegel.Composite(func(tc hegel.TestCase) interface{} {
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, nonNilMap(hegel.Maps(mapKeys, values).MaxSize(3)))
+	})
+	branches := weighted(choice[interface{}]{5, leaves}, choice[interface{}]{1, lists}, choice[interface{}]{2, maps})
+	values = hegel.Composite(func(tc hegel.TestCase) interface{} {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, leaves)
+		}
+		return hegel.Draw(tc, branches)
+	})
+	return values
+}
