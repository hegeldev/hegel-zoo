+// ---------------------------------------------------------------------------------------
+// Strict mode: DisallowUnknownFields reports exactly the keys the struct lacks.
+
+type strictTarget struct {
+	Alpha int
+	Beta  string `toml:"beta"`
+	Gamma struct {
+		Delta   float64
+		Epsilon []int
+	} `toml:"gamma"`
+}
+
+func TestHegelStrictModeReportsExactlyTheUnknownKeys(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		known := map[string]bool{"alpha": true, "beta": true, "gamma": true, "delta": true, "epsilon": true}
+		var sb strings.Builder
+		unknown := 0
+		newKey := func() string {
+			for {
+				k := genBareKey(ht)
+				if !known[strings.ToLower(k)] {
+					known[strings.ToLower(k)] = true
+					return k
+				}
+			}
+		}
+		if chance(ht, 70) {
+			sb.WriteString(fmt.Sprintf("alpha = %d\n", n(ht, -9, 9)))
+		}
+		if chance(ht, 70) {
+			sb.WriteString("beta = 'b'\n")
+		}
+		for k := n(ht, 0, 2); k > 0; k-- {
+			sb.WriteString(fmt.Sprintf("%s = %d\n", newKey(), n(ht, 0, 9)))
+			unknown++
+		}
+		if chance(ht, 70) {
+			sb.WriteString("[gamma]\n")
+			if chance(ht, 70) {
+				sb.WriteString("delta = 1.5\n")
+			}
+			if chance(ht, 50) {
+				sb.WriteString("epsilon = [1, 2]\n")
+			}
+			for k := n(ht, 0, 2); k > 0; k-- {
+				sb.WriteString(fmt.Sprintf("%s = 'x'\n", newKey()))
+				unknown++
+			}
+		}
+		doc := sb.String()
+		note(ht, "document:\n%s", doc)
+		var lenient strictTarget
+		if err := Unmarshal([]byte(doc), &lenient); err != nil {
+			ht.Fatalf("lenient decoding failed: %v", err)
+		}
+		var strict strictTarget
+		err := NewDecoder(strings.NewReader(doc)).DisallowUnknownFields().Decode(&strict)
+		if unknown == 0 {
+			if err != nil {
+				ht.Fatalf("strict decoding of a document with only known keys failed: %v", err)
+			}
+			if !same(strict, lenient) {
+				ht.Fatalf("strict and lenient decoding differ: %+v vs %+v", strict, lenient)
+			}
+			return
+		}
+		se, ok := err.(*StrictMissingError)
+		if !ok {
+			ht.Fatalf("%d unknown keys, but strict decoding returned %T: %v", unknown, err, err)
+		}
+		if len(se.Errors) != unknown {
+			ht.Fatalf("%d unknown keys, but %d strict errors:\n%s", unknown, len(se.Errors), se.String())
+		}
+	})
+}
