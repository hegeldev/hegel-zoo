+// ---------------------------------------------------------------------------------------
+// Strict mode: DisallowUnknownFields reports exactly the keys the struct lacks.
+
+type strictTarget struct {
+	Alpha int
+	Beta  string `toml:"beta"`
+	Gamma struct {
+		Delta   float64
+		Epsilon []int
+	} `toml:"gamma"`
+}
+
+var strictKnown = map[string]bool{"alpha": true, "beta": true, "gamma": true, "delta": true, "epsilon": true}
+
+// unknownKeys: up to two bare keys that name no field of strictTarget (the decoder matches
+// fields case-insensitively) and differ from each other case-insensitively.
+var unknownKeys = hegel.Map(hegel.Lists(bareKeys).MaxSize(2), func(ks []string) []string {
+	seen := map[string]bool{}
+	var out []string
+	for _, k := range ks {
+		lower := strings.ToLower(k)
+		if strictKnown[lower] || seen[lower] {
+			continue
+		}
+		seen[lower] = true
+		out = append(out, k)
+	}
+	return out
+})
+
+// gammaSection: the [gamma] table with its known keys present or not and its unknown keys.
+type gammaSection struct {
+	delta, epsilon bool
+	unknown        []string
+}
+
+var gammaSections = hegel.Composite(func(tc hegel.TestCase) gammaSection {
+	return gammaSection{
+		delta:   hegel.Draw(tc, chance(70)),
+		epsilon: hegel.Draw(tc, chance(50)),
+		unknown: hegel.Draw(tc, unknownKeys),
+	}
+})
+
+// strictCase: the document's top-level keys (alpha with its value, beta, the unknown keys)
+// and its [gamma] table when present.
+type strictCase struct {
+	alpha   *int
+	beta    bool
+	unknown []string
+	gamma   *gammaSection
+}
+
+func (c strictCase) document() string {
+	var sb strings.Builder
+	if c.alpha != nil {
+		fmt.Fprintf(&sb, "alpha = %d\n", *c.alpha)
+	}
+	if c.beta {
+		sb.WriteString("beta = 'b'\n")
+	}
+	for i, k := range c.unknown {
+		fmt.Fprintf(&sb, "%s = %d\n", k, i)
+	}
+	if g := c.gamma; g != nil {
+		sb.WriteString("[gamma]\n")
+		if g.delta {
+			sb.WriteString("delta = 1.5\n")
+		}
+		if g.epsilon {
+			sb.WriteString("epsilon = [1, 2]\n")
+		}
+		for _, k := range g.unknown {
+			fmt.Fprintf(&sb, "%s = 'x'\n", k)
+		}
+	}
+	return sb.String()
+}
+
+// unknownCount is the number of keys the strict decoder must report.
+func (c strictCase) unknownCount() int {
+	n := len(c.unknown)
+	if c.gamma != nil {
+		n += len(c.gamma.unknown)
+	}
+	return n
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c strictCase) GoString() string { return c.document() }
+
+var strictCases = hegel.Composite(func(tc hegel.TestCase) strictCase {
+	return strictCase{
+		alpha:   hegel.Draw(tc, maybe(70, ptrs(hegel.Integers(-9, 9)))),
+		beta:    hegel.Draw(tc, chance(70)),
+		unknown: hegel.Draw(tc, unknownKeys),
+		gamma:   hegel.Draw(tc, maybe(70, ptrs(gammaSections))),
+	}
+})
+
+func TestHegelStrictModeReportsExactlyTheUnknownKeys(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, strictCases)
+		doc, unknown := c.document(), c.unknownCount()
+		var lenient strictTarget
+		if err := Unmarshal([]byte(doc), &lenient); err != nil {
+			ht.Fatalf("lenient decoding failed: %v", err)
+		}
+		var strict strictTarget
+		err := NewDecoder(strings.NewReader(doc)).DisallowUnknownFields().Decode(&strict)
+		if unknown == 0 {
+			if err != nil {
+				ht.Fatalf("strict decoding of a document with only known keys failed: %v", err)
+			}
+			if !same(strict, lenient) {
+				ht.Fatalf("strict and lenient decoding differ: %+v vs %+v", strict, lenient)
+			}
+			return
+		}
+		se, ok := err.(*StrictMissingError)
+		if !ok {
+			ht.Fatalf("%d unknown keys, but strict decoding returned %T: %v", unknown, err, err)
+		}
+		if len(se.Errors) != unknown {
+			ht.Fatalf("%d unknown keys, but %d strict errors:\n%s", unknown, len(se.Errors), se.String())
+		}
+	})
+}
