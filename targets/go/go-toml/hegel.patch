+// Pinned bugs (see bugs.toml; each is an expected failure).
+
+// go-toml/1: an integer written in hex, octal or binary cannot be decoded into a float field.
+func TestHegelNonDecimalIntegerLiteralsDecodeIntoFloatFields(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := hegel.Draw(ht, hegel.Integers[int64](0, 1<<53))
+		lit := pick(ht, []string{"0x" + strconv.FormatInt(v, 16), "0o" + strconv.FormatInt(v, 8), "0b" + strconv.FormatInt(v, 2)})
+		doc := "f64 = " + lit + "\n"
+		var got numbers
+		if err := Unmarshal([]byte(doc), &got); err != nil {
+			ht.Fatalf("%s: %v (the same literal decodes into interface{} and int64 fields)", strings.TrimSpace(doc), err)
+		}
+		if got.F64 != float64(v) {
+			ht.Fatalf("%s decoded as %v, want %d", strings.TrimSpace(doc), got.F64, v)
+		}
+	})
+}
