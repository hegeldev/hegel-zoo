+// go-toml/2: a float literal that rounds to a finite float32 is rejected for a float32
+// field when it exceeds MaxFloat32 as a float64 — including the encoder's own output for
+// math.MaxFloat32.
+func TestHegelFloat32FieldsAcceptEveryLiteralThatRoundsToAFiniteFloat32(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var f float64
+		if chance(ht, 30) {
+			f = math.MaxFloat32
+		} else {
+			// (MaxFloat32, MaxFloat32 * (1 + 2^-25)) rounds to MaxFloat32 as a float32.
+			f = math.MaxFloat32 * (1 + float64(n(ht, 0, 1<<20))/float64(1<<45))
+		}
+		if math.IsInf(float32Of(f), 0) {
+			return
+		}
+		doc, err := Marshal(map[string]float32{"f32": float32(f)})
+		if err != nil {
+			ht.Fatalf("Marshal failed: %v", err)
+		}
+		lit := strconv.FormatFloat(f, 'g', -1, 64)
+		if chance(ht, 50) {
+			doc = []byte("f32 = " + lit + "\n")
+		}
+		var got numbers
+		if err := Unmarshal(doc, &got); err != nil {
+			ht.Fatalf("%s: %v (float32(%s) = %v is finite)", strings.TrimSpace(string(doc)), err, lit, float32(f))
+		}
+		if got.F32 != float32(f) {
+			ht.Fatalf("decoded %v, want %v", got.F32, float32(f))
+		}
+	})
+}
