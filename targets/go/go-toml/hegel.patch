+// ---------------------------------------------------------------------------------------
+// Raw messages: captured bytes are the value's TOML, and splicing them back is lossless.
+
+func TestHegelRawMessagesCaptureAndSpliceValuesLosslessly(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tree := genTable(ht, 2)
+		if len(tree.kids) == 0 {
+			tree.kids["k"], tree.keys = genScalar(ht), []string{"k"}
+		}
+		opts := genEncOpts(ht)
+		opts.inline = true // every top-level value is then a single inline value
+		doc, err := opts.marshal(toGo(ht, tree))
+		if err != nil {
+			ht.Fatalf("Marshal failed: %v", err)
+		}
+		note(ht, "document:\n%s", doc)
+		var raw map[string]unstable.RawMessage
+		if err := NewDecoder(bytes.NewReader(doc)).EnableUnmarshalerInterface().Decode(&raw); err != nil {
+			ht.Fatalf("decoding into RawMessage failed: %v", err)
+		}
+		if len(raw) != len(tree.kids) {
+			ht.Fatalf("captured %d raw values for %d keys", len(raw), len(tree.kids))
+		}
+		for k, v := range tree.kids {
+			var one map[string]interface{}
+			if err := Unmarshal([]byte("k = "+string(raw[k])+"\n"), &one); err != nil {
+				ht.Fatalf("raw bytes %q of key %q are not a TOML value: %v", raw[k], k, err)
+			}
+			if got, want := nodeOfAny(one["k"], false), nodeOfVal(v, false); !sameNode(got, want) {
+				ht.Fatalf("raw bytes %q of key %q mean %s, want %s", raw[k], k, render(got), render(want))
+			}
+		}
+		var buf bytes.Buffer
+		if err := NewEncoder(&buf).EnableMarshalerInterface().Encode(raw); err != nil {
+			ht.Fatalf("re-encoding the raw messages failed: %v", err)
+		}
+		var back map[string]interface{}
+		if err := Unmarshal(buf.Bytes(), &back); err != nil {
+			ht.Fatalf("re-encoded document %q does not parse: %v", buf.String(), err)
+		}
+		if got, want := nodeOfAny(back, false), nodeOfVal(tree, false); !sameNode(got, want) {
+			ht.Fatalf("spliced document %q reads as %s, want %s", buf.String(), render(got), render(want))
+		}
+	})
+}
