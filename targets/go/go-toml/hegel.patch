+type inner struct {
+	X int    `toml:"x"`
+	Y string `toml:"y,omitempty"`
+	Z []int  `toml:"z"`
+}
+
+type embedded struct {
+	EmbA int
+	EmbB []string
+}
+
+type rich struct {
+	embedded
+	I       int
+	I8      int8
+	I16     int16
+	I32     int32
+	I64     int64
+	U       uint
+	U8      uint8
+	U16     uint16
+	U32     uint32
+	U64     uint64
+	F32     float32
+	F64     float64
+	S       string
+	SM      string `toml:"sm,multiline"`
+	B       bool
+	T       time.Time
+	TP      *time.Time
+	LD      LocalDate
+	LT      LocalTime
+	LDT     LocalDateTime
+	P       *int
+	PS      *inner
+	Arr     [3]int
+	SI      []int
+	SS      []string
+	SF      []float64
+	ST      []inner
+	SM2     []map[string]int
+	MI      map[string]int
+	MS      map[string]inner
+	MM      map[string]map[string]string
+	In      inner `toml:"in,inline"`
+	N       inner `toml:"n"`
+	Any     interface{}
+	Temp    Temp
+	Om      int    `toml:"om,omitempty"`
+	Oz      inner  `toml:"oz,omitzero"`
+	Renamed string `toml:"re-named" comment:"a comment"`
+	Skip    int    `toml:"-"`
+}
+
+func genInner(tc hegel.TestCase) inner {
+	in := inner{X: int(genInt(tc)), Z: []int{}}
+	if chance(tc, 60) {
+		in.Y = genString(tc)
+	}
+	for k := n(tc, 0, 3); k > 0; k-- {
+		in.Z = append(in.Z, n(tc, -100, 100))
+	}
+	return in
+}
+
+func genStringMapKey(tc hegel.TestCase) string {
+	if chance(tc, 70) {
+		return genBareKey(tc)
+	}
+	return genString(tc)
+}
+
+// genAny draws a value of the dynamic types the decoder produces for interface{} targets.
+func genAny(tc hegel.TestCase, depth int) interface{} {
+	switch n(tc, 1, 8) {
+	case 1:
+		return genInt(tc)
+	case 2:
+		return genFloat(tc)
+	case 3:
+		return genString(tc)
+	case 4:
+		return chance(tc, 50)
+	case 5:
+		return genTime(tc)
+	case 6:
+		if depth > 0 {
+			out := []interface{}{}
+			for k := n(tc, 0, 3); k > 0; k-- {
+				out = append(out, genAny(tc, depth-1))
+			}
+			return out
+		}
+		return genInt(tc)
+	default:
+		if depth > 0 {
+			out := map[string]interface{}{}
+			for k := n(tc, 0, 3); k > 0; k-- {
+				out[genStringMapKey(tc)] = genAny(tc, depth-1)
+			}
+			return out
+		}
+		return genString(tc)
+	}
+}
+
+func genLocalTimeWithPrecision(tc hegel.TestCase) LocalTime {
+	lt := genLocalTime(tc)
+	if chance(tc, 50) {
+		// Precision is the number of fractional digits written; keep Nanosecond
+		// consistent with it so that the text is exact.
+		lt.Precision = n(tc, 1, 9)
+		unit := int(math.Pow10(9 - lt.Precision))
+		lt.Nanosecond -= lt.Nanosecond % unit
+	}
+	return lt
+}
+
+func genRich(tc hegel.TestCase) rich {
+	r := rich{
+		I: int(genInt(tc)), I8: int8(genInt(tc)), I16: int16(genInt(tc)), I32: int32(genInt(tc)), I64: genInt(tc),
+		U: uint(genInt(tc) & math.MaxInt64), U8: uint8(genInt(tc)), U16: uint16(genInt(tc)), U32: uint32(genInt(tc)), U64: uint64(genInt(tc) & math.MaxInt64),
+		F64: genFloat(tc), S: genString(tc), SM: genString(tc), B: chance(tc, 50),
+		T: genTime(tc), LD: genDate(tc), LT: genLocalTimeWithPrecision(tc),
+		LDT: LocalDateTime{LocalDate: genDate(tc), LocalTime: genLocalTimeWithPrecision(tc)},
+		Arr: [3]int{n(tc, -5, 5), n(tc, -5, 5), int(genInt(tc))},
+		SI:  []int{}, SS: []string{}, SF: []float64{}, ST: []inner{}, SM2: []map[string]int{},
+		MI: map[string]int{}, MS: map[string]inner{}, MM: map[string]map[string]string{},
+		In: genInner(tc), N: genInner(tc), Any: genAny(tc, 2), Temp: Temp(genFloat(tc)),
+		Renamed: genString(tc), Skip: n(tc, 1, 9),
+	}
+	// float32 values near MaxFloat32 are pinned separately (go-toml/2).
+	for r.F32 = float32(genFloat(tc)); math.Abs(float64(r.F32)) > 1e38; r.F32 = float32(genFloat(tc)) {
+	}
+	if chance(tc, 50) {
+		r.EmbA = n(tc, -9, 9)
+		r.EmbB = []string{genString(tc)}
+	}
+	if chance(tc, 50) {
+		tp := genTime(tc)
+		r.TP = &tp
+	}
+	if chance(tc, 50) {
+		p := n(tc, -9, 9)
+		r.P = &p
+	}
+	if chance(tc, 50) {
+		in := genInner(tc)
+		r.PS = &in
+	}
+	if chance(tc, 50) {
+		r.Om = n(tc, 1, 9)
+	}
+	if chance(tc, 50) {
+		r.Oz = genInner(tc)
+	}
+	for k := n(tc, 0, 3); k > 0; k-- {
+		r.SI = append(r.SI, int(genInt(tc)))
+		r.SS = append(r.SS, genString(tc))
+		r.SF = append(r.SF, genFloat(tc))
+		r.ST = append(r.ST, genInner(tc))
+		r.SM2 = append(r.SM2, map[string]int{genStringMapKey(tc): n(tc, 0, 9)})
+		r.MI[genStringMapKey(tc)] = int(genInt(tc))
+		r.MS[genStringMapKey(tc)] = genInner(tc)
+		r.MM[genStringMapKey(tc)] = map[string]string{genStringMapKey(tc): genString(tc)}
+	}
+	return r
+}
+
+// same compares two decoded values the way TOML preserves them: nil and empty slices and
+// maps are alike, NaN equals NaN, times are equal instants in the same offset, and
+// LocalTime's Precision is presentation only.
+func same(a, b interface{}) bool {
+	return sameValue(reflect.ValueOf(a), reflect.ValueOf(b))
+}
+
+func sameValue(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	switch a.Type() {
+	case reflect.TypeOf(time.Time{}):
+		ta, tb := a.Interface().(time.Time), b.Interface().(time.Time)
+		_, oa := ta.Zone()
+		_, ob := tb.Zone()
+		return ta.Equal(tb) && oa == ob
+	case reflect.TypeOf(LocalTime{}):
+		la, lb := a.Interface().(LocalTime), b.Interface().(LocalTime)
+		la.Precision, lb.Precision = 0, 0
+		return la == lb
+	}
+	switch a.Kind() {
+	case reflect.Float32, reflect.Float64:
+		return canonFloat(a.Float()) == canonFloat(b.Float())
+	case reflect.Ptr, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() && b.IsNil()
+		}
+		return sameValue(a.Elem(), b.Elem())
+	case reflect.Slice, reflect.Array:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !sameValue(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return false
+		}
+		iter := a.MapRange()
+		for iter.Next() {
+			bv := b.MapIndex(iter.Key())
+			if !bv.IsValid() || !sameValue(iter.Value(), bv) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			if a.Type().Field(i).PkgPath != "" && !a.Type().Field(i).Anonymous {
+				continue // unexported
+			}
+			if !sameValue(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	}
+	return reflect.DeepEqual(a.Interface(), b.Interface())
+}
+
+func TestHegelStructsRoundTripThroughMarshalAndUnmarshal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		in := genRich(ht)
+		opts := genEncOpts(ht)
+		note(ht, "options %+v", opts)
+		doc, err := opts.marshal(in)
+		if err != nil {
+			ht.Fatalf("Marshal(%+v) failed: %v", in, err)
+		}
+		note(ht, "document:\n%s", doc)
+		var out rich
+		if err := Unmarshal(doc, &out); err != nil {
+			ht.Fatalf("Unmarshal of the encoder's own output failed: %v", err)
+		}
+		want := in
+		want.Skip = 0 // toml:"-" is never written
+		if !same(out, want) {
+			ht.Fatalf("round trip changed the struct:\n got %+v\nwant %+v", out, want)
+		}
+		if _, perr := tomllib(t, string(doc)); perr != "" {
+			ht.Fatalf("tomllib rejects go-toml's output: %s", perr)
+		}
+	})
+}
