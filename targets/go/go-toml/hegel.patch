+// same compares two decoded values the way TOML preserves them: nil and empty slices and
+// maps are alike, NaN equals NaN, times are equal instants in the same offset, and
+// LocalTime's Precision is presentation only.
+func same(a, b interface{}) bool {
+	return sameValue(reflect.ValueOf(a), reflect.ValueOf(b))
+}
+
+func sameValue(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	switch a.Type() {
+	case reflect.TypeOf(time.Time{}):
+		ta, tb := a.Interface().(time.Time), b.Interface().(time.Time)
+		_, oa := ta.Zone()
+		_, ob := tb.Zone()
+		return ta.Equal(tb) && oa == ob
+	case reflect.TypeOf(LocalTime{}):
+		la, lb := a.Interface().(LocalTime), b.Interface().(LocalTime)
+		la.Precision, lb.Precision = 0, 0
+		return la == lb
+	}
+	switch a.Kind() {
+	case reflect.Float32, reflect.Float64:
+		return canonFloat(a.Float()) == canonFloat(b.Float())
+	case reflect.Ptr, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() && b.IsNil()
+		}
+		return sameValue(a.Elem(), b.Elem())
+	case reflect.Slice, reflect.Array:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !sameValue(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return false
+		}
+		iter := a.MapRange()
+		for iter.Next() {
+			bv := b.MapIndex(iter.Key())
+			if !bv.IsValid() || !sameValue(iter.Value(), bv) {
+				return false
+			}
+		}
+		return true
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			if a.Type().Field(i).PkgPath != "" && !a.Type().Field(i).Anonymous {
+				continue // unexported
+			}
+			if !sameValue(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	}
+	return reflect.DeepEqual(a.Interface(), b.Interface())
+}
