+
+// prefixedInt: a non-negative integer and the base of its prefixed literal.
+type prefixedInt struct {
+	v    int64
+	base int
+}
+
+func (p prefixedInt) literal() string {
+	return map[int]string{16: "0x", 8: "0o", 2: "0b"}[p.base] + strconv.FormatInt(p.v, p.base)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (p prefixedInt) GoString() string { return fmt.Sprintf("%d as %s", p.v, p.literal()) }
+
+var prefixedInts = hegel.Composite(func(tc hegel.TestCase) prefixedInt {
+	return prefixedInt{v: hegel.Draw(tc, hegel.Integers[int64](0, 1<<53)), base: hegel.Draw(tc, hegel.SampledFrom([]int{16, 8, 2}))}
+})
+
+// go-toml/1: an integer written in hex, octal or binary cannot be decoded into a float field.
+func TestHegelNonDecimalIntegerLiteralsDecodeIntoFloatFields(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, prefixedInts)
+		doc := "f64 = " + p.literal() + "\n"
+		var got numbers
+		if err := Unmarshal([]byte(doc), &got); err != nil {
+			ht.Fatalf("%s: %v (the same literal decodes into interface{} and int64 fields)", strings.TrimSpace(doc), err)
+		}
+		if got.F64 != float64(p.v) {
+			ht.Fatalf("%s decoded as %v, want %d", strings.TrimSpace(doc), got.F64, p.v)
+		}
+	})
+}
+
+// maxFloat32Lit: a float64 that rounds to the finite MaxFloat32 (MaxFloat32 itself for
+// k = 0, else MaxFloat32 * (1 + k / 2^45), inside (MaxFloat32, MaxFloat32 * (1 + 2^-25))),
+// written by the encoder as a float32 or as its own shortest float64 spelling.
+type maxFloat32Lit struct {
+	k      int
+	direct bool
+}
+
+func (l maxFloat32Lit) value() float64 { return math.MaxFloat32 * (1 + float64(l.k)/float64(1<<45)) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (l maxFloat32Lit) GoString() string {
+	return fmt.Sprintf("%v (k=%d) written %s", l.value(), l.k, map[bool]string{true: "as its float64 spelling", false: "by the encoder as a float32"}[l.direct])
+}
+
+var maxFloat32Lits = hegel.Composite(func(tc hegel.TestCase) maxFloat32Lit {
+	return maxFloat32Lit{
+		k:      hegel.Draw(tc, weighted(choice[int]{30, hegel.Just(0)}, choice[int]{70, hegel.Integers(0, 1<<20-1)})),
+		direct: hegel.Draw(tc, hegel.Booleans()),
+	}
+})
+
+// go-toml/2: a float literal that rounds to a finite float32 is rejected for a float32
+// field when it exceeds MaxFloat32 as a float64 - including the encoder's own output for
+// math.MaxFloat32.
+func TestHegelFloat32FieldsAcceptEveryLiteralThatRoundsToAFiniteFloat32(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		l := hegel.Draw(ht, maxFloat32Lits)
+		f := l.value()
+		ht.Assume(!math.IsInf(float32Of(f), 0)) // never: k stays below the rounding boundary
+		doc, err := Marshal(map[string]float32{"f32": float32(f)})
+		if err != nil {
+			ht.Fatalf("Marshal failed: %v", err)
+		}
+		lit := strconv.FormatFloat(f, 'g', -1, 64)
+		if l.direct {
+			doc = []byte("f32 = " + lit + "\n")
+		}
+		var got numbers
+		if err := Unmarshal(doc, &got); err != nil {
+			ht.Fatalf("%s: %v (float32(%s) = %v is finite)", strings.TrimSpace(string(doc)), err, lit, float32(f))
+		}
+		if got.F32 != float32(f) {
+			ht.Fatalf("decoded %v, want %v", got.F32, float32(f))
+		}
+	})
+}
