diff --git a/hegel/hegel_zoo_add_test.go b/hegel/hegel_zoo_add_test.go
new file mode 100644
index 0000000..32acbbf
--- /dev/null
+++ b/hegel/hegel_zoo_add_test.go
@@ -0,0 +1,253 @@
+package hegel
+
+// TestHegelAddComments: comments appended at random decoration points of a parsed file print
+// as valid Go with the same code and every comment present once.
+
+import (
+	"bytes"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/printer"
+	"go/token"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/dave/dst"
+	"github.com/dave/dst/decorator"
+	"hegel.dev/go/hegel"
+)
+
+var hzDecorationsType = reflect.TypeOf(dst.Decorations{})
+
+// hzDecorationPoints returns pointers to every decoration point of a node: the common Start
+// and End, and the node's own points (the Decorations fields of its Decs struct).
+func hzDecorationPoints(n dst.Node) (names []string, points []*dst.Decorations) {
+	nd := n.Decorations()
+	names = append(names, "Start", "End")
+	points = append(points, &nd.Start, &nd.End)
+	v := reflect.ValueOf(n)
+	if v.Kind() != reflect.Ptr || v.IsNil() {
+		return
+	}
+	decs := v.Elem().FieldByName("Decs")
+	if !decs.IsValid() {
+		return
+	}
+	for i := 0; i < decs.NumField(); i++ {
+		f := decs.Field(i)
+		if f.Type() == hzDecorationsType && decs.Type().Field(i).Name != "NodeDecs" {
+			names = append(names, decs.Type().Field(i).Name)
+			points = append(points, f.Addr().Interface().(*dst.Decorations))
+		}
+	}
+	return
+}
+
+// hzIsLineNode: a node that starts and ends a line of its own, where a line comment at Start or
+// End leaves the layout of the code alone (a Field may sit in a parameter list).
+func hzIsLineNode(n dst.Node) bool {
+	switch n.(type) {
+	case dst.Stmt, dst.Decl, dst.Spec:
+		return true
+	}
+	return false
+}
+
+var hzPosType = reflect.TypeOf(token.Pos(0))
+
+// hzASTEqual compares two syntax trees without their positions, comments and resolution
+// information: the code they describe.
+func hzASTEqual(a, b any) bool { return hzEq(reflect.ValueOf(a), reflect.ValueOf(b)) }
+
+func hzEq(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	if a.Type() == hzPosType {
+		return true
+	}
+	switch a.Kind() {
+	case reflect.Ptr, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() == b.IsNil()
+		}
+		return hzEq(a.Elem(), b.Elem())
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			switch a.Type().Field(i).Name {
+			case "Doc", "Comment", "Comments", "Obj", "Scope", "Unresolved", "Imports":
+				continue
+			}
+			if !hzEq(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Slice:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !hzEq(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		return true
+	}
+	return reflect.DeepEqual(a.Interface(), b.Interface())
+}
+
+// hzParseCode parses without comments.
+func hzParseCode(src string) (*ast.File, error) {
+	return parser.ParseFile(token.NewFileSet(), "", src, 0)
+}
+
+// hzDropEmpty removes the empty // comments from a sorted list: go/printer adds one between a
+// doc comment and a //go: directive.
+func hzDropEmpty(l []string) []string {
+	var out []string
+	for _, s := range l {
+		if s != "//" {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// hzComments lists a file's comments as go/parser reads them, sorted, line comments
+// normalised to one space after the // (go/printer reformats a comment that has become a doc
+// comment).
+func hzComments(src string) ([]string, error) {
+	fset := token.NewFileSet()
+	af, err := parser.ParseFile(fset, "", src, parser.ParseComments)
+	if err != nil {
+		return nil, err
+	}
+	var out []string
+	for _, cg := range af.Comments {
+		for _, cm := range cg.List {
+			out = append(out, hzNormComment(cm.Text))
+		}
+	}
+	sort.Strings(out)
+	return out, nil
+}
+
+func hzNormComment(s string) string {
+	if !strings.HasPrefix(s, "//") || strings.HasPrefix(s, "//go:") {
+		return s
+	}
+	body := strings.TrimLeft(s[2:], " \t")
+	if body == "" {
+		return "//"
+	}
+	return "// " + body
+}
+
+func TestHegelAddComments(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		g := hzNewGen(ht)
+		src := hzGofmt(ht, c, g.file())
+		if src == "" {
+			return
+		}
+		want, err := hzComments(src)
+		if err != nil {
+			ht.Fatalf("go/parser: %v", err)
+		}
+		codeWant, err := hzParseCode(src)
+		if err != nil {
+			ht.Fatalf("code of the source: %v", err)
+		}
+		f, out, err := hzRoundTrip(src)
+		if err != nil || out != src {
+			c.count("round trip differs (TestHegelRoundTrip's business)")
+			return
+		}
+		// Choose the nodes to decorate.
+		var nodes []dst.Node
+		dst.Inspect(f, func(n dst.Node) bool {
+			if n != nil {
+				nodes = append(nodes, n)
+			}
+			return true
+		})
+		added := 0
+		var where []string
+		for i := hzDrawInt(ht, 1, 6); i > 0 && len(nodes) > 0; i-- {
+			ni := hzDrawInt(ht, 0, len(nodes)-1)
+			n := nodes[ni]
+			names, points := hzDecorationPoints(n)
+			k := hzDrawInt(ht, 0, len(points)-1)
+			added++
+			var text string
+			line := hzIsLineNode(n) && (names[k] == "Start" || names[k] == "End") && hzChance(ht, 50)
+			if line {
+				text = fmt.Sprintf("// z%d", added)
+			} else {
+				text = fmt.Sprintf("/* z%d */", added)
+			}
+			how := "append"
+			switch {
+			case hzChance(ht, 60):
+				points[k].Append(text)
+			case !line || hzChance(ht, 50):
+				how = "prepend"
+				points[k].Prepend(text)
+			default:
+				how = "newline+append"
+				points[k].Append("\n", text) // a newline before it (only where a line may end)
+			}
+			want = append(want, text)
+			where = append(where, fmt.Sprintf("node %d %T.%s %s %s", ni, n, names[k], how, text))
+			c.count("point " + strings.TrimPrefix(fmt.Sprintf("%T", n), "*dst.") + "." + names[k])
+		}
+		sort.Strings(want)
+		var printed string
+		var perr error
+		if p := hzCatch(func() {
+			var buf bytes.Buffer
+			perr = decorator.Fprint(&buf, f)
+			printed = buf.String()
+		}); p != nil {
+			c.failClass(ht, "panic", "printing panics: %v\nadded: %v\nsource:\n%s", p, where, src)
+			return
+		}
+		if perr != nil {
+			// go/format rejected the restored tree: show what go/printer makes of it.
+			raw := "(cannot restore)"
+			if fset, af, err := decorator.RestoreFile(f); err == nil {
+				var buf bytes.Buffer
+				if printer.Fprint(&buf, fset, af) == nil {
+					raw = buf.String()
+				}
+			}
+			c.failClass(ht, "invalid", "the output is not valid Go: %v\nadded: %v\noutput:\n%s\nsource:\n%s", perr, where, raw, src)
+			return
+		}
+		got, err := hzComments(printed)
+		if err != nil {
+			c.failClass(ht, "invalid", "the output does not parse: %v\nadded: %v\noutput:\n%s\nsource:\n%s", err, where, printed, src)
+			return
+		}
+		if !reflect.DeepEqual(hzDropEmpty(want), hzDropEmpty(got)) {
+			c.failClass(ht, "comments", "the comments differ\nwant %q\ngot  %q\nadded: %v\noutput:\n%s\nsource:\n%s", want, got, where, printed, src)
+			return
+		}
+		codeGot, err := hzParseCode(printed)
+		if err != nil {
+			ht.Fatalf("code of the output: %v", err)
+		}
+		if !hzASTEqual(codeWant, codeGot) {
+			c.failClass(ht, "code", "the code differs\nadded: %v\noutput:\n%s\nsource:\n%s", where, printed, src)
+			return
+		}
+		c.count("ok")
+	})
+}
diff --git a/hegel/hegel_zoo_gen_test.go b/hegel/hegel_zoo_gen_test.go
new file mode 100644
index 0000000..a90b7ed
--- /dev/null
+++ b/hegel/hegel_zoo_gen_test.go
@@ -0,0 +1,883 @@
+package hegel
+
+// A generator of Go source files: declarations, statements and expressions of every kind the
+// syntax tree has, with comments (line, block, multi-line block, empty, directive-like,
+// non-ASCII) and blank lines at many of the places the grammar allows them. The text is then
+// formatted with gofmt, which is the form dst promises to round-trip.
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+type hzGen struct {
+	tc       *hegel.T
+	b        strings.Builder
+	n        int      // comment counter
+	comments []string // the comment texts emitted, in order
+	budget   int      // statements left to generate
+	labelN   int
+	fnN      int
+	hdr      bool // inside an if/for/switch header, where composite literals need parentheses
+	// noCommentNext: the last statement was a multi-result return spanning lines; a comment
+	// line directly after it reaches the recorded bug returnListCommentIndent.
+	noCommentNext bool
+	forceMulti    bool // the next call spreads its arguments over lines
+}
+
+func hzNewGen(tc *hegel.T) *hzGen {
+	return &hzGen{tc: tc, budget: hzDrawInt(tc, 3, 30)}
+}
+
+func (g *hzGen) w(s string) { g.b.WriteString(s) }
+
+func (g *hzGen) chance(pct int) bool { return hzChance(g.tc, pct) }
+
+func (g *hzGen) draw(lo, hi int) int { return hzDrawInt(g.tc, lo, hi) }
+
+func (g *hzGen) pick(xs ...string) string { return hzPick(g.tc, xs) }
+
+// text is the body of a fresh comment.
+func (g *hzGen) text() string {
+	g.n++
+	body := fmt.Sprintf("c%d", g.n)
+	switch g.draw(1, 12) {
+	case 1:
+		body += " " + string(rune(233)) + string(rune(0x4e2d)) // non-ASCII: e-acute, a CJK char
+	case 2:
+		body = "" // an empty comment
+	case 3:
+		body += " with a much longer text that runs on for a while to change the alignment"
+	case 4:
+		body += "\ttab" // a tab inside
+	case 5:
+		body = body + "  " // trailing spaces (gofmt strips them from line comments)
+	}
+	return body
+}
+
+// lineComment is a // comment (no newline).
+func (g *hzGen) lineComment() string {
+	t := g.text()
+	c := "//" + g.pick(" ", "", "  ") + t
+	if strings.TrimSpace(t) == "" {
+		c = "//"
+	}
+	g.comments = append(g.comments, c)
+	return c
+}
+
+// blockComment is a single-line /* */ comment.
+func (g *hzGen) blockComment() string {
+	c := "/*" + g.pick(" ", "") + g.text() + g.pick(" ", "") + "*/"
+	g.comments = append(g.comments, c)
+	return c
+}
+
+// multiComment is a /* */ comment spanning 2-3 lines (only where a newline is allowed).
+func (g *hzGen) multiComment(indent string) string {
+	lines := []string{"/* " + g.text()}
+	for i := g.draw(1, 2); i > 0; i-- {
+		lines = append(lines, indent+g.pick("", "   ", "\t")+g.text())
+	}
+	if g.chance(50) {
+		lines = append(lines, indent+"*/")
+	} else {
+		lines[len(lines)-1] += " */"
+	}
+	c := strings.Join(lines, "\n")
+	g.comments = append(g.comments, c)
+	return c
+}
+
+// sp is the space between two tokens on a line: sometimes with a block comment.
+func (g *hzGen) sp() string {
+	if g.chance(6) {
+		return g.pick(" ", "") + g.blockComment() + g.pick(" ", "")
+	}
+	return " "
+}
+
+// eol ends a line: sometimes with a trailing comment.
+func (g *hzGen) eol() string {
+	switch {
+	case g.chance(12):
+		return " " + g.lineComment() + "\n"
+	case g.chance(4):
+		return " " + g.blockComment() + "\n"
+	case g.chance(2):
+		return " " + g.blockComment() + " " + g.lineComment() + "\n"
+	}
+	return "\n"
+}
+
+// between goes between two items of a list of lines (statements, declarations, fields):
+// blank lines and whole-line comments.
+func (g *hzGen) between(indent string) {
+	for i := g.draw(0, 2); i > 0; i-- {
+		var piece string
+		switch g.draw(1, 10) {
+		case 1, 2, 3:
+			piece = "\n"
+		case 4, 5, 6:
+			piece = indent + g.lineComment() + "\n"
+		case 7:
+			piece = indent + g.blockComment() + "\n"
+		case 8:
+			piece = indent + g.multiComment(indent) + "\n"
+		case 9:
+			piece = indent + g.lineComment() + "\n" + indent + g.lineComment() + "\n"
+		case 10:
+			piece = "\n" + indent + g.lineComment() + "\n\n"
+		}
+		if g.noCommentNext && HZKnown.returnListCommentIndent && strings.TrimSpace(piece) != "" {
+			hzAvoid("returnListCommentIndent")
+			piece = "\n" // no comment at the end of this block
+		}
+		g.w(piece)
+	}
+}
+
+// --------------------------------------------------------------------------- expressions
+
+var hzIdents = []string{"a", "b", "c", "x", "y", "i", "n", "s", "ch", "err", "p", "m"}
+var hzTypeNames = []string{"int", "string", "bool", "byte", "T1", "T2", "error", "any", "float64", "rune"}
+
+func (g *hzGen) ident() string { return hzPick(g.tc, hzIdents) }
+
+func (g *hzGen) literal() string {
+	switch g.draw(1, 12) {
+	case 1:
+		return fmt.Sprint(g.draw(0, 1000))
+	case 2:
+		return g.pick("0x1F", "0o17", "0b1010", "1_000_000", "017", "0X_ff")
+	case 3:
+		return g.pick("1.5", "1e9", ".5", "1.", "0x1p-2", "2.5e-3")
+	case 4:
+		return g.pick("2i", "1.5i", "0i")
+	case 5:
+		return g.pick("'a'", "'\\n'", "'\\x41'", "'\\u00e9'", "'\\''")
+	case 6:
+		return g.pick(`"s"`, `""`, `"tab\there"`, `"quote\"d"`, `"line\n"`, `"é"`)
+	case 7:
+		return "`raw`"
+	case 8:
+		return "`raw\nmulti\n\tline`"
+	case 9:
+		return g.pick("true", "false", "nil", "iota")
+	default:
+		return fmt.Sprint(g.draw(0, 9))
+	}
+}
+
+func (g *hzGen) typ(depth int) string {
+	if depth <= 0 || g.chance(40) {
+		return hzPick(g.tc, hzTypeNames)
+	}
+	switch g.draw(1, 12) {
+	case 1:
+		return "*" + g.sp0() + g.typ(depth-1)
+	case 2:
+		return "[]" + g.typ(depth-1)
+	case 3:
+		return "[" + g.sp0() + fmt.Sprint(g.draw(0, 5)) + g.sp0() + "]" + g.typ(depth-1)
+	case 4:
+		return "map[" + g.typ(depth-1) + "]" + g.typ(depth-1)
+	case 5:
+		return g.pick("chan ", "<-chan ", "chan<- ") + g.typ(depth-1)
+	case 6:
+		return "func(" + g.params(depth-1, false) + ")" + g.results(depth-1)
+	case 7:
+		return g.structType(depth-1, "\t")
+	case 8:
+		return g.ifaceType(depth-1, "\t")
+	case 9:
+		return "pkg." + g.pick("Type", "Reader")
+	case 10:
+		return g.pick("List", "Map") + "[" + g.typ(depth-1) + g.pick("", ", "+g.typ(depth-1)) + "]"
+	case 11:
+		return "(" + g.typ(depth-1) + ")"
+	default:
+		return hzPick(g.tc, hzTypeNames)
+	}
+}
+
+// sp0 is an optional inline comment with no surrounding space requirement.
+func (g *hzGen) sp0() string {
+	if g.chance(5) {
+		return " " + g.blockComment() + " "
+	}
+	return ""
+}
+
+func (g *hzGen) params(depth int, allowVariadic bool) string {
+	n := g.draw(0, 3)
+	if n == 0 {
+		return g.sp0()
+	}
+	var ps []string
+	named := g.chance(60)
+	for i := 0; i < n; i++ {
+		t := g.typ(depth)
+		if allowVariadic && i == n-1 && g.chance(20) {
+			t = "..." + g.sp0() + t
+		}
+		if named {
+			names := g.ident()
+			if !strings.HasPrefix(t, "...") && g.chance(20) {
+				names += "," + g.sp() + g.ident()
+			}
+			ps = append(ps, names+g.sp()+t)
+		} else {
+			ps = append(ps, t)
+		}
+	}
+	if g.chance(15) {
+		// One parameter per line.
+		return g.eol() + "\t" + strings.Join(ps, ","+g.eol()+"\t") + "," + g.eol()
+	}
+	return strings.Join(ps, ","+g.sp())
+}
+
+func (g *hzGen) results(depth int) string {
+	switch g.draw(1, 5) {
+	case 1:
+		return ""
+	case 2:
+		return " " + g.typ(depth)
+	case 3:
+		return " (" + g.typ(depth) + "," + g.sp() + g.typ(depth) + ")"
+	case 4:
+		return " (" + g.ident() + " " + g.typ(depth) + "," + g.sp() + g.ident() + " " + g.typ(depth) + ")"
+	default:
+		return " (" + g.ident() + " " + g.typ(depth) + ")"
+	}
+}
+
+func (g *hzGen) structType(depth int, indent string) string {
+	n := g.draw(0, 3)
+	if n == 0 {
+		return "struct{" + g.sp0() + "}"
+	}
+	var sb strings.Builder
+	sb.WriteString("struct" + g.sp0() + "{" + g.eol())
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			g.betweenTo(&sb, indent+"\t")
+		}
+		sb.WriteString(indent + "\t")
+		switch g.draw(1, 5) {
+		case 1:
+			sb.WriteString(g.typ(0)) // embedded
+		case 2:
+			sb.WriteString(g.ident() + "," + g.sp() + g.ident() + " " + g.typ(depth))
+		case 3:
+			sb.WriteString(g.ident() + " " + g.typ(depth) + " `json:\"" + g.ident() + "\"`")
+		default:
+			sb.WriteString(g.ident() + g.sp() + g.typ(depth))
+		}
+		sb.WriteString(g.eol())
+	}
+	sb.WriteString(indent + "}")
+	return sb.String()
+}
+
+func (g *hzGen) ifaceType(depth int, indent string) string {
+	n := g.draw(0, 3)
+	if n == 0 {
+		return "interface{" + g.sp0() + "}"
+	}
+	var sb strings.Builder
+	sb.WriteString("interface" + g.sp0() + "{" + g.eol())
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			g.betweenTo(&sb, indent+"\t")
+		}
+		sb.WriteString(indent + "\t")
+		switch g.draw(1, 4) {
+		case 1:
+			sb.WriteString(g.pick("fmt.Stringer", "T1", "comparable"))
+		case 2:
+			sb.WriteString(g.pick("~int", "int | string", "~int | ~string"))
+		default:
+			sb.WriteString("M" + fmt.Sprint(g.draw(1, 3)) + "(" + g.params(depth, false) + ")" + g.results(depth))
+		}
+		sb.WriteString(g.eol())
+	}
+	sb.WriteString(indent + "}")
+	return sb.String()
+}
+
+// betweenTo is between() into another builder.
+func (g *hzGen) betweenTo(sb *strings.Builder, indent string) {
+	saved := g.b
+	g.b = strings.Builder{}
+	g.between(indent)
+	sb.WriteString(g.b.String())
+	g.b = saved
+}
+
+func (g *hzGen) expr(depth int) string {
+	if depth <= 0 || g.chance(30) {
+		if g.chance(50) {
+			return g.ident()
+		}
+		return g.literal()
+	}
+	switch g.draw(1, 20) {
+	case 1, 2:
+		op := g.pick("+", "-", "*", "/", "%", "==", "!=", "<", "<=", "&&", "||", "&", "|", "^", "<<", ">>", "&^")
+		right := g.sp()
+		if op == "/" {
+			right = " " // a block comment right after / would start a line comment
+		}
+		return g.expr(depth-1) + g.sp() + op + right + g.expr(depth-1)
+	case 3:
+		// A space after the operator: &^x or - -x would lex differently.
+		return g.pick("-", "!", "^", "&", "*", "<-", "+") + g.sp0() + " " + g.expr(depth-1)
+	case 4, 5:
+		return g.call(depth - 1)
+	case 6:
+		base := g.expr(depth - 1)
+		if !hzIdentStart(base) {
+			base = "(" + base + ")" // 0.Field would lex as the float 0., -0.Field too
+		}
+		return base + g.sp0() + "." + g.sp0() + g.pick("Field", "Method", "x")
+	case 7:
+		return g.expr(depth-1) + "[" + g.sp0() + g.expr(depth-1) + g.sp0() + "]"
+	case 8:
+		lo, hi := g.pick("", g.expr(depth-1)), g.pick("", g.expr(depth-1))
+		s := g.expr(depth-1) + "[" + lo + g.sp0() + ":" + hi
+		if hi != "" && g.chance(30) {
+			s += ":" + g.expr(depth-1)
+		}
+		return s + "]"
+	case 9:
+		base := g.expr(depth - 1)
+		if !hzIdentStart(base) {
+			base = "(" + base + ")" // 0x1F.(T) would lex as a hexadecimal float
+		}
+		return base + ".(" + g.sp0() + g.typ(1) + ")"
+	case 10, 11:
+		if g.hdr {
+			return "(" + g.composite(depth-1) + ")"
+		}
+		return g.composite(depth - 1)
+	case 12:
+		return g.funcLit(depth - 1)
+	case 13:
+		return "(" + g.sp0() + g.expr(depth-1) + g.sp0() + ")"
+	case 14:
+		ct := g.typ(1)
+		if strings.HasPrefix(ct, "func") || strings.HasPrefix(ct, "chan") || strings.HasPrefix(ct, "<-") || strings.HasPrefix(ct, "*") {
+			ct = "(" + ct + ")" // func()(x) would parse as a signature
+		}
+		return ct + "(" + g.expr(depth-1) + ")"
+	case 15:
+		return g.pick("F", "G", "Map") + "[" + g.typ(1) + g.pick("", ", "+g.typ(1)) + "](" + g.expr(depth-1) + ")"
+	case 16:
+		if g.hdr {
+			return "(struct{ A int }{" + g.expr(depth-1) + "})"
+		}
+		return "struct{ A int }{" + g.expr(depth-1) + "}"
+	default:
+		return g.call(depth - 1)
+	}
+}
+
+var hzIdentRe = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+// hzIdentStart: the text is a plain identifier, so a . or .( may follow it (a + 0.Field or
+// 0x1F.(T) would lex differently).
+func hzIdentStart(s string) bool { return hzIdentRe.MatchString(s) }
+
+func (g *hzGen) call(depth int) string { return g.callWith(depth, false) }
+
+// callWith generates a call; named keeps the function a plain name (go and defer statements
+// need a call, not a parenthesised one).
+func (g *hzGen) callWith(depth int, named bool) string {
+	fn := g.pick("f", "g.m", "x.y.z", "fmt.Println", "make", "len", "append", "new", "panic")
+	if !named && g.chance(15) {
+		fn = g.expr(depth)
+	}
+	n := g.draw(0, 3)
+	if g.forceMulti {
+		n = g.draw(1, 3)
+	}
+	var args []string
+	for i := 0; i < n; i++ {
+		args = append(args, g.expr(depth))
+	}
+	if fn == "make" || fn == "new" {
+		args = append([]string{g.typ(1)}, args...)
+	}
+	s := fn + g.sp0() + "("
+	if n > 0 && (g.forceMulti || g.chance(15)) {
+		g.forceMulti = false
+		// Arguments one per line.
+		s += g.eol() + "\t\t" + strings.Join(args, ","+g.eol()+"\t\t") + ","
+		if g.chance(30) {
+			s = strings.TrimSuffix(s, ",") + g.sp0() + "..." + "," // the last argument is variadic
+			args[len(args)-1] = g.ident()
+			s = fn + g.sp0() + "(" + g.eol() + "\t\t" + strings.Join(args, ","+g.eol()+"\t\t") + g.sp0() + "...,"
+		}
+		return s + g.eol() + "\t)"
+	}
+	if n > 0 && g.chance(15) {
+		args[len(args)-1] = g.ident() + g.sp0() + "..." // a variadic call (never after a literal: 0... lexes as 0.)
+	}
+	s += g.sp0() + strings.Join(args, ","+g.sp())
+	return s + g.sp0() + ")"
+}
+
+func (g *hzGen) composite(depth int) string {
+	t := g.pick("T1", "[]int", "map[string]int", "[...]string", "[]T2", "struct{ A, B int }", "&T1", "pkg.T")
+	n := g.draw(0, 3)
+	var elts []string
+	for i := 0; i < n; i++ {
+		e := g.expr(depth)
+		switch g.draw(1, 4) {
+		case 1:
+			e = g.ident() + g.sp0() + ":" + g.sp() + e
+		case 2:
+			e = g.literal() + ":" + g.sp() + e
+		case 3:
+			if g.chance(50) {
+				e = "{" + e + "}" // a nested elided-type literal
+			}
+		}
+		elts = append(elts, e)
+	}
+	if n > 0 && g.chance(35) {
+		return t + "{" + g.eol() + "\t\t" + strings.Join(elts, ","+g.eol()+"\t\t") + "," + g.eol() + "\t}"
+	}
+	if n == 0 {
+		return t + "{" + g.sp0() + "}"
+	}
+	return t + "{" + g.sp0() + strings.Join(elts, ","+g.sp()) + g.sp0() + "}"
+}
+
+func (g *hzGen) funcLit(depth int) string {
+	s := "func" + g.sp0() + "(" + g.params(1, true) + ")" + g.results(1) + g.sp() + "{"
+	saved := g.b
+	g.b = strings.Builder{}
+	g.body(depth, "\t\t")
+	s += g.b.String()
+	g.b = saved
+	return s + "\t}"
+}
+
+// --------------------------------------------------------------------------- statements
+
+// body writes the inside of a block after its "{" (through the closing indentation, not the
+// "}").
+func (g *hzGen) body(depth int, indent string) {
+	g.w(g.eol())
+	n := g.draw(0, 4)
+	if depth <= 0 || g.budget <= 0 {
+		n = g.draw(0, 1)
+	}
+	if n == 0 && g.chance(40) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if i > 0 || g.chance(30) {
+			g.noCommentNext = false // a statement follows: harmless
+			g.between(indent)
+		}
+		g.stmt(depth-1, indent)
+	}
+	if g.budget > 0 && g.chance(8) {
+		// A multi-result return whose first result spans lines, closing the block.
+		g.budget--
+		g.noCommentNext = false
+		g.between(indent)
+		g.forceMulti = true
+		prefix := g.pick("", "- ", "(")
+		first := prefix + g.callWith(depth, false)
+		if prefix == "(" {
+			first += ")"
+		}
+		g.forceMulti = false
+		g.w(indent + "return" + g.sp() + first + "," + g.sp() + g.expr(0) + g.eol())
+		g.noCommentNext = true
+	}
+	if g.chance(10) || (g.noCommentNext && g.chance(60)) {
+		g.between(indent)
+	}
+	g.noCommentNext = false
+	g.w(indent[:len(indent)-1])
+}
+
+// block writes "{ body }" (no trailing newline).
+func (g *hzGen) block(depth int, indent string) {
+	g.w("{")
+	g.body(depth, indent+"\t")
+	g.w("}")
+}
+
+func (g *hzGen) simpleStmt(depth int) string {
+	switch g.draw(1, 6) {
+	case 1:
+		return g.ident() + g.sp() + ":=" + g.sp() + g.expr(depth)
+	case 2:
+		return g.ident() + "," + g.sp() + g.ident() + g.sp() + g.pick(":=", "=") + g.sp() + g.expr(depth) + "," + g.sp() + g.expr(depth)
+	case 3:
+		return g.ident() + g.sp() + g.pick("+=", "-=", "*=", "<<=", "&^=") + g.sp() + g.expr(depth)
+	case 4:
+		return g.ident() + g.sp0() + g.pick("++", "--")
+	case 5:
+		return g.ident() + g.sp() + "<-" + g.sp() + g.expr(depth)
+	default:
+		return g.call(depth)
+	}
+}
+
+func (g *hzGen) stmt(depth int, indent string) {
+	g.budget--
+	g.noCommentNext = false
+	g.w(indent)
+	switch g.draw(1, 22) {
+	case 1, 2, 3:
+		g.w(g.simpleStmt(depth) + g.eol())
+	case 4:
+		g.w("var" + g.sp() + g.ident() + g.sp() + g.typ(1) + g.pick("", g.sp()+"="+g.sp()+g.expr(depth)) + g.eol())
+	case 5:
+		kw := g.pick("var", "const")
+		g.w(kw + g.sp() + "(")
+		g.specList(depth, indent+"\t", kw == "const")
+		g.w(indent + ")" + g.eol())
+	case 6:
+		g.w("type" + g.sp() + g.pick("T3", "T4") + g.sp() + g.pick("", "= ") + g.typ(2) + g.eol())
+	case 7, 8:
+		g.w("if" + g.sp())
+		g.hdr = true
+		if g.chance(30) {
+			g.w(g.simpleStmt(depth) + ";" + g.sp())
+		}
+		g.w(g.expr(depth) + g.sp())
+		g.hdr = false
+		g.block(depth, indent)
+		for i := 0; i < 2 && g.chance(30); i++ {
+			g.hdr = true
+			g.w(g.sp() + "else" + g.sp() + "if" + g.sp() + g.expr(depth) + g.sp())
+			g.hdr = false
+			g.block(depth, indent)
+		}
+		if g.chance(40) {
+			g.w(g.sp() + "else" + g.sp())
+			g.block(depth, indent)
+		}
+		g.w(g.eol())
+	case 9, 10:
+		g.w("for" + g.sp())
+		g.hdr = true
+		switch g.draw(1, 6) {
+		case 1:
+		case 2:
+			g.w(g.expr(depth) + g.sp())
+		case 3:
+			g.w(g.ident() + " := 0;" + g.sp() + g.ident() + " < " + g.expr(depth) + ";" + g.sp() + g.ident() + "++" + g.sp())
+		case 4:
+			g.w(g.pick(";;", "; "+g.expr(depth)+";", "i := 0; ; i++") + g.sp())
+		case 5:
+			g.w(g.pick(g.ident(), g.ident()+", "+g.ident(), g.ident()+", _", "_, "+g.ident()) + g.sp() + g.pick(":=", "=") + g.sp() + "range" + g.sp() + g.expr(depth) + g.sp())
+		default:
+			g.w("range" + g.sp() + g.expr(depth) + g.sp())
+		}
+		g.hdr = false
+		g.block(depth, indent)
+		g.w(g.eol())
+	case 11:
+		g.switchStmt(depth, indent)
+	case 12:
+		g.selectStmt(depth, indent)
+	case 13:
+		switch g.draw(1, 4) {
+		case 1:
+			g.w("return" + g.eol())
+		case 2:
+			g.w("return" + g.sp() + g.expr(depth) + g.eol())
+		default:
+			first := g.expr(depth)
+			results := first + "," + g.sp() + g.expr(depth)
+			g.w("return" + g.sp() + results + g.eol())
+			g.noCommentNext = strings.Contains(results, "\n")
+		}
+	case 14:
+		g.w(g.pick("go", "defer") + g.sp() + g.callWith(depth, true) + g.eol())
+	case 15:
+		g.labelN++
+		l := fmt.Sprintf("L%d", g.labelN)
+		g.w(l + g.sp0() + ":" + g.pick(g.eol()+indent, g.sp()))
+		if g.chance(50) {
+			g.w("for" + g.sp())
+			g.block(depth, indent)
+			g.w(g.eol())
+		} else {
+			g.w(g.simpleStmt(depth) + g.eol())
+		}
+		if g.chance(50) {
+			g.between(indent)
+			g.w(indent + g.pick("goto", "break", "continue") + g.sp() + l + g.eol())
+		}
+	case 16:
+		g.w(g.pick("break", "continue", "fallthrough") + g.eol())
+	case 17:
+		g.block(depth, indent)
+		g.w(g.eol())
+	case 18:
+		g.w(g.pick("<-ch", "<-"+g.expr(depth)) + g.eol())
+	case 19:
+		g.w(g.pick("F", "F", "x.f") + g.sp0() + "(" + g.sp0() + ")" + g.sp0() + "(" + g.sp0() + ")" + g.eol())
+	default:
+		g.w(g.simpleStmt(depth) + g.eol())
+	}
+}
+
+// specList writes the specs of a grouped var/const/import/type declaration after "(",
+// through the closing indentation.
+func (g *hzGen) specList(depth int, indent string, isConst bool) {
+	g.w(g.eol())
+	n := g.draw(0, 4)
+	if n == 0 && g.chance(50) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if i > 0 || g.chance(20) {
+			g.between(indent)
+		}
+		var spec string
+		switch g.draw(1, 5) {
+		case 5:
+			spec = g.ident() + g.sp() + "=" + g.sp() + "`raw\nmulti\n\tline`" // a multi-line raw string value
+		case 1:
+			if isConst {
+				spec = g.ident() // a repeated const expression
+			} else {
+				spec = g.ident() + g.sp() + g.typ(1)
+			}
+		case 2:
+			spec = g.ident() + g.sp() + g.typ(1)
+		case 3:
+			spec = g.ident() + g.sp() + "=" + g.sp() + g.expr(depth)
+		default:
+			spec = g.ident() + "," + g.sp() + g.ident() + g.sp() + g.typ(1) + g.sp() + "=" + g.sp() + g.expr(depth) + "," + g.sp() + g.expr(depth)
+		}
+		eol := g.eol()
+		if n > 1 && eol != "\n" && strings.Contains(spec, "`raw\nmulti") && HZKnown.rawStringSpecComment {
+			hzAvoid("rawStringSpecComment")
+			eol = "\n" // no trailing comment on a multi-line raw string spec in a group of several
+		}
+		g.w(indent + spec + eol)
+	}
+	g.w(indent[:len(indent)-1])
+}
+
+func (g *hzGen) switchStmt(depth int, indent string) {
+	g.w("switch" + g.sp())
+	typeSwitch := g.chance(30)
+	g.hdr = true
+	if g.chance(30) {
+		g.w(g.simpleStmt(depth) + ";" + g.sp())
+	}
+	if typeSwitch {
+		g.w(g.pick("", g.ident()+" := ") + g.pick(g.ident(), g.ident()+"."+g.ident(), g.callWith(depth, true)) + ".(type)" + g.sp())
+	} else if g.chance(70) {
+		g.w(g.expr(depth) + g.sp())
+	}
+	g.hdr = false
+	g.w("{" + g.eol())
+	n := g.draw(0, 3)
+	if n == 0 && g.chance(50) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if g.chance(25) {
+			g.between(indent)
+		}
+		g.w(indent)
+		if i == n-1 && g.chance(40) {
+			g.w("default" + g.sp0() + ":")
+		} else if typeSwitch {
+			g.w("case" + g.sp() + g.typ(1) + g.pick("", ","+g.sp()+g.typ(1), ", nil") + g.sp0() + ":")
+		} else {
+			g.w("case" + g.sp() + g.expr(depth) + g.pick("", ","+g.sp()+g.expr(depth)) + g.sp0() + ":")
+		}
+		g.caseBody(depth, indent+"\t")
+	}
+	if g.chance(15) {
+		g.between(indent)
+	}
+	g.w(indent + "}" + g.eol())
+}
+
+// caseBody writes the statements of a case clause after the colon.
+func (g *hzGen) caseBody(depth int, indent string) {
+	g.w(g.eol())
+	n := g.draw(0, 3)
+	if depth <= 0 || g.budget <= 0 {
+		n = g.draw(0, 1)
+	}
+	if n == 0 && g.chance(40) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if i > 0 || g.chance(30) {
+			g.noCommentNext = false // a statement follows: harmless
+			g.between(indent)
+		}
+		g.stmt(depth-1, indent)
+	}
+	if g.noCommentNext && g.chance(60) {
+		g.between(indent)
+	}
+	g.noCommentNext = false
+}
+
+func (g *hzGen) selectStmt(depth int, indent string) {
+	g.w("select" + g.sp() + "{" + g.eol())
+	n := g.draw(0, 3)
+	if n == 0 && g.chance(50) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if g.chance(25) {
+			g.between(indent)
+		}
+		g.w(indent)
+		switch g.draw(1, 5) {
+		case 1:
+			g.w("default" + g.sp0() + ":")
+		case 2:
+			g.w("case" + g.sp() + g.ident() + g.sp() + "<-" + g.sp() + g.expr(depth) + g.sp0() + ":")
+		case 3:
+			g.w("case" + g.sp() + g.ident() + g.pick("", ", ok") + g.sp() + g.pick(":=", "=") + g.sp() + "<-" + g.sp0() + g.ident() + g.sp0() + ":")
+		default:
+			g.w("case" + g.sp() + "<-" + g.sp0() + g.ident() + g.sp0() + ":")
+		}
+		g.caseBody(depth, indent+"\t")
+	}
+	g.w(indent + "}" + g.eol())
+}
+
+// --------------------------------------------------------------------------- declarations
+
+func (g *hzGen) decl() {
+	switch g.draw(1, 10) {
+	case 1:
+		g.w("var" + g.sp() + g.ident() + g.sp() + g.pick(g.typ(2), "= "+g.expr(2), g.typ(1)+" = "+g.expr(2)) + g.eol())
+	case 2:
+		kw := g.pick("var", "const")
+		g.w(kw + g.sp() + "(")
+		g.specList(2, "\t", kw == "const")
+		g.w(")" + g.eol())
+	case 3:
+		g.w("const" + g.sp() + g.ident() + g.sp() + "=" + g.sp() + g.expr(2) + g.eol())
+	case 4:
+		tparams := g.pick("", "[T any]", "[K comparable, V any]")
+		assign := g.pick("", "= ")
+		sp := g.sp()
+		if tparams != "" && assign != "" && sp != " " && HZKnown.aliasTypeParamsComment {
+			hzAvoid("aliasTypeParamsComment")
+			sp = " "
+		}
+		g.w("type" + g.sp() + g.pick("T1", "T2") + tparams + sp + assign + g.typ(3) + g.eol())
+	case 5:
+		g.w("type" + g.sp() + "(")
+		g.w(g.eol())
+		for i := g.draw(0, 3); i > 0; i-- {
+			g.between("\t")
+			g.w("\t" + g.pick("T1", "T2", "T3") + g.sp() + g.typ(2) + g.eol())
+		}
+		g.w(")" + g.eol())
+	default:
+		g.funcDecl()
+	}
+}
+
+func (g *hzGen) funcDecl() {
+	g.fnN++
+	g.w("func" + g.sp())
+	if g.chance(30) {
+		g.w("(" + g.pick("", g.ident()+" ") + g.pick("", "*") + "T1" + g.pick("", "[T]") + g.sp0() + ")" + g.sp())
+	}
+	g.w(fmt.Sprintf("f%d", g.fnN))
+	if g.chance(25) {
+		g.w("[" + g.pick("T any", "T, U any", "T ~int | ~string", "T interface{ M() }") + "]")
+	}
+	g.w(g.sp0() + "(" + g.params(2, true) + ")" + g.results(2))
+	if g.chance(5) {
+		g.w(g.eol()) // an external function has no body
+		return
+	}
+	g.w(g.sp())
+	g.block(3, "")
+	g.w(g.eol())
+}
+
+func (g *hzGen) imports() {
+	switch g.draw(1, 5) {
+	case 1:
+		return
+	case 2:
+		g.w("import" + g.sp() + g.pick("", "f ", ". ", "_ ") + `"fmt"` + g.eol())
+	default:
+		g.w("import" + g.sp() + "(" + g.eol())
+		n := g.draw(0, 4)
+		paths := []string{`"fmt"`, `"os"`, `"strings"`, `"go/ast"`, `"github.com/x/y"`}
+		for i := 0; i < n; i++ {
+			if g.chance(30) {
+				g.between("\t")
+			}
+			g.w("\t" + g.pick("", "", "f ", ". ", "_ ") + paths[i] + g.eol())
+		}
+		if g.chance(20) {
+			g.between("\t")
+		}
+		g.w(")" + g.eol())
+	}
+	if g.chance(30) {
+		g.between("")
+	}
+}
+
+// file generates a whole source file (unformatted).
+func (g *hzGen) file() string {
+	g.b.Reset()
+	if g.chance(40) {
+		g.between("")
+	}
+	if g.chance(50) {
+		g.w(g.lineComment() + "\n")
+		if g.chance(30) {
+			g.w("\n")
+		}
+	}
+	if g.chance(5) {
+		g.w("//go:build linux\n\n")
+	}
+	g.w("package" + g.sp() + g.pick("p", "main") + g.eol())
+	if g.chance(60) {
+		g.between("")
+	}
+	g.imports()
+	n := g.draw(0, 4)
+	for i := 0; i < n; i++ {
+		if i > 0 || g.chance(40) {
+			g.between("")
+		}
+		if g.chance(30) {
+			// A doc comment, sometimes a directive.
+			g.w(g.pick(g.lineComment(), g.lineComment(), g.blockComment(), "//go:noinline", g.lineComment()+"\n//\n"+g.lineComment()) + "\n")
+		}
+		g.decl()
+	}
+	if g.chance(30) {
+		g.between("")
+	}
+	return g.b.String()
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..bfcb519
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,46 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the documented behaviour; each fails
+// while its bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"go/format"
+	"testing"
+)
+
+// hzPinRoundTrip checks that a gofmt-formatted source survives the round trip.
+func hzPinRoundTrip(t *testing.T, src string) {
+	t.Helper()
+	if b, err := format.Source([]byte(src)); err != nil || string(b) != src {
+		t.Fatalf("the pin's source is not gofmt-formatted: %v\n%s", err, b)
+	}
+	var out string
+	var err error
+	if p := hzCatch(func() { _, out, err = hzRoundTrip(src) }); p != nil {
+		t.Fatalf("round trip panics: %v", p)
+	}
+	if err != nil {
+		t.Fatalf("round trip fails: %v", err)
+	}
+	if out != src {
+		t.Fatalf("round trip differs\n%s", hzShowDiff(src, out))
+	}
+}
+
+// dst/1: a comment between the = of a generic type alias and its type moves before the type
+// parameters.
+func TestHegelPinAliasTypeParamsComment(t *testing.T) {
+	hzPinRoundTrip(t, "package p\n\ntype T2[T any] = /* c */ string\n")
+}
+
+// dst/2: the results of a multi-result return spanning lines, followed directly by a
+// whole-line comment, are indented one level too deep.
+func TestHegelPinReturnListCommentIndent(t *testing.T) {
+	hzPinRoundTrip(t, "package p\n\nfunc f() {\n\treturn f(\n\t\t1,\n\t), s\n\t// c\n}\n")
+}
+
+// dst/3: in a grouped var declaration of several specs, the trailing comment of a spec whose
+// value is a multi-line raw string gets two spaces.
+func TestHegelPinRawStringSpecComment(t *testing.T) {
+	hzPinRoundTrip(t, "package p\n\nvar (\n\ti = `raw\nmulti` // c\n\tj = 1\n)\n")
+}
diff --git a/hegel/hegel_zoo_props_test.go b/hegel/hegel_zoo_props_test.go
new file mode 100644
index 0000000..1b067fe
--- /dev/null
+++ b/hegel/hegel_zoo_props_test.go
@@ -0,0 +1,200 @@
+package hegel
+
+// The properties: TestHegelRoundTrip (a gofmt-formatted file, decorated and restored, prints
+// byte for byte the same), TestHegelClone, TestHegelDecorations.
+
+import (
+	"bytes"
+	"fmt"
+	"go/format"
+	"go/parser"
+	"go/token"
+	"os"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/dave/dst"
+	"github.com/dave/dst/decorator"
+	"github.com/dave/dst/dstutil"
+	"hegel.dev/go/hegel"
+)
+
+// hzGofmt formats the generated text and checks gofmt's own stability on it: the formatted
+// source, or "" when gofmt is not stable on it (which is gofmt's business, not dst's).
+func hzGofmt(ht *hegel.T, c *hzCollector, raw string) string {
+	src, err := format.Source([]byte(raw))
+	if err != nil {
+		ht.Fatalf("the generator produced invalid Go: %v\n%s", err, raw)
+	}
+	src2, err := format.Source(src)
+	if err != nil || !bytes.Equal(src, src2) {
+		c.count("gofmt unstable")
+		if hzCollecting && os.Getenv("ZOO_SHOW_UNSTABLE") != "" {
+			fmt.Printf("UNSTABLE\n%s\n", hzShowDiff(string(src), string(src2)))
+		}
+		return ""
+	}
+	return string(src)
+}
+
+// hzRoundTrip parses and prints src through dst.
+func hzRoundTrip(src string) (*dst.File, string, error) {
+	f, err := decorator.Parse(src)
+	if err != nil {
+		return nil, "", err
+	}
+	var buf bytes.Buffer
+	if err := decorator.Fprint(&buf, f); err != nil {
+		return f, "", err
+	}
+	return f, buf.String(), nil
+}
+
+func TestHegelRoundTrip(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		g := hzNewGen(ht)
+		src := hzGofmt(ht, c, g.file())
+		if src == "" {
+			return
+		}
+		var out string
+		var err error
+		if p := hzCatch(func() { _, out, err = hzRoundTrip(src) }); p != nil {
+			c.failClass(ht, "panic", "round trip panics: %v\nsource:\n%s", p, src)
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "error", "round trip fails: %v\nsource:\n%s", err, src)
+			return
+		}
+		if out != src {
+			c.failClass(ht, hzDiffClass(src, out), "round trip differs\n%s", hzShowDiff(src, out))
+			return
+		}
+		c.count("ok")
+	})
+}
+
+// TestHegelClone: a cloned file prints the same as the original, which is left unchanged.
+func TestHegelClone(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		g := hzNewGen(ht)
+		src := hzGofmt(ht, c, g.file())
+		if src == "" {
+			return
+		}
+		f, out, err := hzRoundTrip(src)
+		if err != nil || out != src {
+			c.count("round trip differs (TestHegelRoundTrip's business)")
+			return
+		}
+		var cloned, again string
+		var err1, err2 error
+		if p := hzCatch(func() {
+			cf := dst.Clone(f).(*dst.File)
+			var buf bytes.Buffer
+			err1 = decorator.Fprint(&buf, cf)
+			cloned = buf.String()
+			buf.Reset()
+			err2 = decorator.Fprint(&buf, f)
+			again = buf.String()
+		}); p != nil {
+			c.failClass(ht, "panic", "clone panics: %v\nsource:\n%s", p, src)
+			return
+		}
+		if err1 != nil || err2 != nil {
+			c.failClass(ht, "error", "printing fails: clone %v, original %v\nsource:\n%s", err1, err2, src)
+			return
+		}
+		if cloned != src {
+			c.failClass(ht, "clone "+hzDiffClass(src, cloned), "the clone prints differently\n%s", hzShowDiff(src, cloned))
+			return
+		}
+		if again != src {
+			c.failClass(ht, "original changed", "the original prints differently after cloning\n%s", hzShowDiff(src, again))
+			return
+		}
+		c.count("ok")
+	})
+}
+
+// hzAllDecorations collects every decoration (comments and newlines) of every node of the
+// tree, with its attachment point.
+func hzAllDecorations(f *dst.File) (comments []string, newlines int) {
+	dst.Inspect(f, func(n dst.Node) bool {
+		if n == nil {
+			return false
+		}
+		_, _, points := dstutil.Decorations(n)
+		for _, pt := range points {
+			for _, d := range pt.Decs {
+				if d == "\n" {
+					newlines++
+				} else {
+					comments = append(comments, d)
+				}
+			}
+		}
+		return true
+	})
+	return
+}
+
+// TestHegelDecorations: every comment of the file is attached to exactly one decoration
+// point, with its text as go/parser reads it, and no decoration is anything but a comment
+// or a newline.
+func TestHegelDecorations(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		g := hzNewGen(ht)
+		src := hzGofmt(ht, c, g.file())
+		if src == "" {
+			return
+		}
+		fset := token.NewFileSet()
+		af, err := parser.ParseFile(fset, "", src, parser.ParseComments)
+		if err != nil {
+			ht.Fatalf("go/parser: %v", err)
+		}
+		var want []string
+		for _, cg := range af.Comments {
+			for _, cm := range cg.List {
+				want = append(want, cm.Text)
+			}
+		}
+		var got []string
+		var perr error
+		if p := hzCatch(func() {
+			f, err := decorator.Parse(src)
+			if err != nil {
+				perr = err
+				return
+			}
+			got, _ = hzAllDecorations(f)
+		}); p != nil {
+			c.failClass(ht, "panic", "decorating panics: %v\nsource:\n%s", p, src)
+			return
+		}
+		if perr != nil {
+			c.failClass(ht, "error", "decorator.Parse: %v\nsource:\n%s", perr, src)
+			return
+		}
+		for _, d := range got {
+			if !strings.HasPrefix(d, "//") && !strings.HasPrefix(d, "/*") {
+				c.failClass(ht, "not a comment", "decoration %q is neither a comment nor a newline\nsource:\n%s", d, src)
+				return
+			}
+		}
+		sort.Strings(want)
+		sort.Strings(got)
+		if !reflect.DeepEqual(want, got) {
+			c.failClass(ht, "comments", "the decorations are not the file's comments\ngo/parser: %q\ndst: %q\nsource:\n%s", want, got, src)
+			return
+		}
+		c.count("ok")
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..de1ef6f
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,230 @@
+package hegel
+
+// Hegel property tests for dave/dst, written for the Hegel zoo. See targets/go/dst/README.md.
+// They live in a package of their own (hegel/) and drive the public API: decorator.Parse and
+// decorator.Fprint (the decorated syntax tree's round trip), dst.Clone, dstutil.Apply and the
+// decoration points, on generated Go source files with comments and blank lines in many places.
+//
+// Oracle: gofmt (go/format) - dst's documented contract is that a gofmt-formatted file survives
+// the round trip through the decorated tree byte for byte.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		for k, v := range hzAvoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, v))
+		}
+		hzAvoided = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. While a switch is on
+// the generators keep away from the behaviour (and count the avoidance); the pins assert the
+// documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	aliasTypeParamsComment  bool // a comment between the = of a generic type alias and its type is printed before the type parameters
+	returnListCommentIndent bool // the results of a multi-result return spanning lines, followed directly by a whole-line comment, are indented one level too deep
+	rawStringSpecComment    bool // in a grouped var/const declaration of several specs, the trailing comment of a spec whose value is a multi-line raw string gets two spaces
+}{true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- diffs
+
+// hzFirstDiffLine finds the first line where a and b differ: the index, and the two lines
+// (empty when a side has run out).
+func hzFirstDiffLine(a, b string) (int, string, string) {
+	al := strings.Split(a, "\n")
+	bl := strings.Split(b, "\n")
+	for i := 0; i < len(al) || i < len(bl); i++ {
+		var x, y string
+		if i < len(al) {
+			x = al[i]
+		}
+		if i < len(bl) {
+			y = bl[i]
+		}
+		if x != y {
+			return i, x, y
+		}
+	}
+	return -1, "", ""
+}
+
+// hzDiffClass names the kind of the first difference: a blank line, a comment or code.
+func hzDiffClass(a, b string) string {
+	_, x, y := hzFirstDiffLine(a, b)
+	if strings.TrimSpace(x) == "" || strings.TrimSpace(y) == "" {
+		return "blank line"
+	}
+	if strings.Contains(x, "//") || strings.Contains(x, "/*") || strings.Contains(y, "//") || strings.Contains(y, "/*") {
+		return "comment"
+	}
+	return "code"
+}
+
+// hzShowDiff prints both texts with a marker on the first differing line.
+func hzShowDiff(want, got string) string {
+	i, _, _ := hzFirstDiffLine(want, got)
+	mark := func(s string) string {
+		l := strings.Split(s, "\n")
+		for j := range l {
+			if j == i {
+				l[j] = ">>> " + l[j]
+			} else {
+				l[j] = "    " + l[j]
+			}
+		}
+		return strings.Join(l, "\n")
+	}
+	return fmt.Sprintf("first difference at line %d\n--- gofmt:\n%s\n--- dst:\n%s", i+1, mark(want), mark(got))
+}
