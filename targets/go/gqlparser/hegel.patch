+package gqlparser_test
+
+// graphql-core as a child process: one JSON request per line (a batch of
+// cases), one JSON reply per line. Each case is one of
+//
+//	{"kind": "parse", "src": query}          -> {"ast": canonical} | {"err": msg}
+//	{"kind": "schema", "sdl": sdl}           -> {"schema": canonical} | {"err": msg}
+//	{"kind": "validate", "sdl": s, "src": q} -> {"valid": bool, "errors": [...]} | {"err": msg}
+//
+// The canonical forms are the same JSON shapes hegel_props_test.go builds
+// from gqlparser's AST and schema, serialised with sorted keys.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os/exec"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const pyScript = `
+import sys, json
+import graphql
+from graphql import parse, build_schema, validate, validate_schema
+from graphql.language import ast as A
+from graphql import type as T
+
+sys.stdout.write(json.dumps({'version': graphql.__version__}) + '\n')
+sys.stdout.flush()
+
+BUILTIN_TYPES = {'Int', 'Float', 'String', 'Boolean', 'ID'}
+BUILTIN_DIRS = {'skip', 'include', 'deprecated', 'specifiedBy', 'oneOf', 'defer'}
+
+def ty(t):
+    if isinstance(t, A.NonNullTypeNode):
+        return ty(t.type) + '!'
+    if isinstance(t, A.ListTypeNode):
+        return '[' + ty(t.type) + ']'
+    return t.name.value
+
+def val(v):
+    if v is None:
+        return None
+    if isinstance(v, A.VariableNode):
+        return {'var': v.name.value}
+    if isinstance(v, A.IntValueNode):
+        return {'int': v.value}
+    if isinstance(v, A.FloatValueNode):
+        return {'float': v.value}
+    if isinstance(v, A.StringValueNode):
+        return {'str': v.value, 'block': bool(v.block)}
+    if isinstance(v, A.BooleanValueNode):
+        return {'bool': bool(v.value)}
+    if isinstance(v, A.NullValueNode):
+        return {'null': True}
+    if isinstance(v, A.EnumValueNode):
+        return {'enum': v.value}
+    if isinstance(v, A.ListValueNode):
+        return {'list': [val(x) for x in v.values]}
+    if isinstance(v, A.ObjectValueNode):
+        return {'obj': [[f.name.value, val(f.value)] for f in v.fields]}
+    raise Exception('value node ' + type(v).__name__)
+
+def args(xs):
+    return [[a.name.value, val(a.value)] for a in (xs or [])]
+
+def dirs(ds):
+    return [{'d': d.name.value, 'args': args(d.arguments)} for d in (ds or [])]
+
+def sels(ss):
+    if ss is None:
+        return []
+    out = []
+    for s in ss.selections:
+        if isinstance(s, A.FieldNode):
+            alias = s.alias.value if s.alias else ''
+            if alias == s.name.value:
+                alias = ''
+            out.append({'f': s.name.value, 'alias': alias, 'args': args(s.arguments),
+                        'dirs': dirs(s.directives), 'sel': sels(s.selection_set)})
+        elif isinstance(s, A.FragmentSpreadNode):
+            out.append({'spread': s.name.value, 'dirs': dirs(s.directives)})
+        elif isinstance(s, A.InlineFragmentNode):
+            out.append({'inline': s.type_condition.name.value if s.type_condition else '',
+                        'dirs': dirs(s.directives), 'sel': sels(s.selection_set)})
+        else:
+            raise Exception('selection ' + type(s).__name__)
+    return out
+
+def query_doc(doc):
+    ops, frags = [], []
+    for d in doc.definitions:
+        if isinstance(d, A.OperationDefinitionNode):
+            ops.append({'op': d.operation.value, 'name': d.name.value if d.name else '',
+                        'vars': [{'name': v.variable.name.value, 'type': ty(v.type),
+                                  'default': val(v.default_value), 'dirs': dirs(v.directives)}
+                                 for v in (d.variable_definitions or [])],
+                        'dirs': dirs(d.directives), 'sel': sels(d.selection_set)})
+        elif isinstance(d, A.FragmentDefinitionNode):
+            frags.append({'name': d.name.value, 'on': d.type_condition.name.value,
+                          'dirs': dirs(d.directives), 'sel': sels(d.selection_set)})
+        else:
+            raise Exception('Syntax Error: type system definition in an executable document')
+    return {'ops': ops, 'frags': frags}
+
+def desc(x):
+    return x if x is not None else ''
+
+def node_dirs(node):
+    return dirs(node.directives) if node is not None else []
+
+def argdefs(d):
+    out = []
+    for name, a in d.items():
+        node = a.ast_node
+        out.append({'name': name, 'desc': desc(a.description), 'type': str(a.type),
+                    'default': val(node.default_value) if node is not None else None,
+                    'dirs': node_dirs(node)})
+    return out
+
+def kind(t):
+    if isinstance(t, T.GraphQLScalarType): return 'SCALAR'
+    if isinstance(t, T.GraphQLObjectType): return 'OBJECT'
+    if isinstance(t, T.GraphQLInterfaceType): return 'INTERFACE'
+    if isinstance(t, T.GraphQLUnionType): return 'UNION'
+    if isinstance(t, T.GraphQLEnumType): return 'ENUM'
+    if isinstance(t, T.GraphQLInputObjectType): return 'INPUT_OBJECT'
+    raise Exception('type ' + type(t).__name__)
+
+def all_dirs(t):
+    out = node_dirs(t.ast_node)
+    for e in (t.extension_ast_nodes or []):
+        out += dirs(e.directives)
+    return out
+
+def schema_doc(s):
+    types = {}
+    for name, t in s.type_map.items():
+        if name.startswith('__') or name in BUILTIN_TYPES:
+            continue
+        d = {'kind': kind(t), 'desc': desc(t.description), 'dirs': all_dirs(t)}
+        if isinstance(t, (T.GraphQLObjectType, T.GraphQLInterfaceType)):
+            d['interfaces'] = [i.name for i in t.interfaces]
+            d['fields'] = [{'name': fn, 'desc': desc(f.description), 'type': str(f.type),
+                            'args': argdefs(f.args), 'dirs': node_dirs(f.ast_node)}
+                           for fn, f in t.fields.items()]
+        elif isinstance(t, T.GraphQLUnionType):
+            d['members'] = [m.name for m in t.types]
+        elif isinstance(t, T.GraphQLEnumType):
+            d['values'] = [{'name': vn, 'desc': desc(v.description), 'dirs': node_dirs(v.ast_node)}
+                           for vn, v in t.values.items()]
+        elif isinstance(t, T.GraphQLInputObjectType):
+            d['inputs'] = argdefs(t.fields)
+        types[name] = d
+    directives = {}
+    for dd in s.directives:
+        if dd.name in BUILTIN_DIRS:
+            continue
+        directives[dd.name] = {'desc': desc(dd.description),
+                               'locations': sorted(l.name for l in dd.locations),
+                               'repeatable': bool(dd.is_repeatable), 'args': argdefs(dd.args)}
+    sd = node_dirs(s.ast_node)
+    for e in (s.extension_ast_nodes or []):
+        sd += dirs(e.directives)
+    return {'query': s.query_type.name if s.query_type else '',
+            'mutation': s.mutation_type.name if s.mutation_type else '',
+            'subscription': s.subscription_type.name if s.subscription_type else '',
+            'desc': desc(s.description), 'dirs': sd, 'types': types, 'directives': directives}
+
+def load_schema(sdl):
+    s = build_schema(sdl)
+    errs = validate_schema(s)
+    if errs:
+        raise Exception('; '.join(e.message for e in errs))
+    return s
+
+def describe(ex):
+    # str() of a GraphQLSyntaxError can itself raise (its location printer
+    # indexes past the source's lines for some line terminators).
+    try:
+        msg = str(ex)
+    except Exception:
+        msg = getattr(ex, 'message', '') or '(unprintable)'
+    return msg.splitlines()[0] if msg else ''
+
+def run(case):
+    k = case['kind']
+    if k == 'parse':
+        return {'ast': query_doc(parse(case['src']))}
+    if k == 'schema':
+        return {'schema': schema_doc(load_schema(case['sdl']))}
+    if k == 'validate':
+        s = load_schema(case['sdl'])
+        doc = parse(case['src'])
+        query_doc(doc)
+        try:
+            errs = validate(s, doc)
+        except Exception as ex:
+            # SingleFieldSubscriptionsRule collects fields and coerces @skip/@include
+            # arguments on the way, raising on a bad or variable value: not a verdict.
+            return {'skip': type(ex).__name__ + ': ' + describe(ex)}
+        return {'valid': len(errs) == 0, 'errors': [e.message for e in errs]}
+    raise Exception('unknown kind ' + k)
+
+for line in sys.stdin:
+    req = json.loads(line)
+    out = []
+    for case in req['cases']:
+        try:
+            out.append(run(case))
+        except Exception as ex:
+            out.append({'err': type(ex).__name__ + ': ' + describe(ex)})
+    sys.stdout.write(json.dumps({'results': out}, sort_keys=True) + '\n')
+    sys.stdout.flush()
+`
+
+type oracleCase struct {
+	Kind string `json:"kind"`
+	Src  string `json:"src,omitempty"`
+	SDL  string `json:"sdl,omitempty"`
+}
+
+type oracleReq struct {
+	Cases []oracleCase `json:"cases"`
+}
+
+type oracleResult struct {
+	AST    json.RawMessage `json:"ast"`
+	Schema json.RawMessage `json:"schema"`
+	Valid  *bool           `json:"valid"`
+	Errors []string        `json:"errors"`
+	Skip   string          `json:"skip"`
+	Err    string          `json:"err"`
+}
+
+type oracleResp struct {
+	Results []oracleResult `json:"results"`
+}
+
+var (
+	oracleOnce    sync.Once
+	oracleMu      sync.Mutex
+	oracleIn      io.WriteCloser
+	oracleOut     *bufio.Scanner
+	oracleErr     error
+	oracleVersion string
+	oracleCmd     *exec.Cmd
+	oracleStderr  strings.Builder
+)
+
+func startOracle() {
+	cmd := exec.Command("python3", "-c", pyScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	cmd.Stderr = &oracleStderr
+	oracleCmd = cmd
+	if err := cmd.Start(); err != nil {
+		oracleErr = fmt.Errorf("starting python3: %v", err)
+		return
+	}
+	oracleIn = stdin
+	oracleOut = bufio.NewScanner(stdout)
+	oracleOut.Buffer(make([]byte, 1<<20), 64<<20)
+	if !oracleOut.Scan() {
+		_ = cmd.Wait()
+		oracleErr = fmt.Errorf("graphql-core oracle did not start (python3 with graphql-core needed): %s", oracleStderr.String())
+		return
+	}
+	var v struct {
+		Version string `json:"version"`
+	}
+	if err := json.Unmarshal(oracleOut.Bytes(), &v); err != nil {
+		oracleErr = err
+		return
+	}
+	oracleVersion = v.Version
+}
+
+func oracle(t testing.TB, cases []oracleCase) []oracleResult {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("oracle: %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	req, _ := json.Marshal(oracleReq{Cases: cases})
+	if _, err := oracleIn.Write(append(req, '\n')); err != nil {
+		_ = oracleCmd.Wait()
+		t.Fatalf("oracle write: %v\nstderr: %s", err, oracleStderr.String())
+	}
+	if !oracleOut.Scan() {
+		_ = oracleCmd.Wait()
+		t.Fatalf("oracle died: %v\nstderr: %s", oracleOut.Err(), oracleStderr.String())
+	}
+	var resp oracleResp
+	if err := json.Unmarshal(oracleOut.Bytes(), &resp); err != nil {
+		t.Fatalf("oracle reply: %v: %s", err, oracleOut.Bytes())
+	}
+	if len(resp.Results) != len(cases) {
+		t.Fatalf("oracle returned %d results for %d cases", len(resp.Results), len(cases))
+	}
+	return resp.Results
+}
+
+// canon re-serialises a JSON document with sorted keys so that both sides
+// compare as strings.
+func canon(raw json.RawMessage) string {
+	var v any
+	if err := json.Unmarshal(raw, &v); err != nil {
+		return "<bad json: " + err.Error() + ">"
+	}
+	b, _ := json.Marshal(v)
+	return string(b)
+}
+
+func TestHegelOracleVersion(t *testing.T) {
+	r := oracle(t, []oracleCase{{Kind: "parse", Src: "{ a }"}})
+	t.Logf("graphql-core %s", oracleVersion)
+	if !strings.HasPrefix(oracleVersion, "3.") {
+		t.Fatalf("graphql-core 3.x expected, got %s", oracleVersion)
+	}
+	if r[0].Err != "" || len(r[0].AST) == 0 {
+		t.Fatalf("oracle smoke test: %+v", r[0])
+	}
+}
