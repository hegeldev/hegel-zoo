new file mode 100644
index 0000000..f48bbc6
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,397 @@
+package gqlparser_test
+
+// The three properties, and the canonical dumps of gqlparser's AST and
+// schema that mirror the oracle's.
+
+import (
+	"encoding/json"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/vektah/gqlparser/v2"
+	"github.com/vektah/gqlparser/v2/ast"
+	"github.com/vektah/gqlparser/v2/parser"
+	"github.com/vektah/gqlparser/v2/validator"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Canonical dumps.
+
+func dumpValue(v *ast.Value) any {
+	if v == nil {
+		return nil
+	}
+	switch v.Kind {
+	case ast.Variable:
+		return map[string]any{"var": v.Raw}
+	case ast.IntValue:
+		return map[string]any{"int": v.Raw}
+	case ast.FloatValue:
+		return map[string]any{"float": v.Raw}
+	case ast.StringValue:
+		return map[string]any{"str": v.Raw, "block": false}
+	case ast.BlockValue:
+		return map[string]any{"str": v.Raw, "block": true}
+	case ast.BooleanValue:
+		return map[string]any{"bool": v.Raw == "true"}
+	case ast.NullValue:
+		return map[string]any{"null": true}
+	case ast.EnumValue:
+		return map[string]any{"enum": v.Raw}
+	case ast.ListValue:
+		xs := make([]any, 0, len(v.Children))
+		for _, c := range v.Children {
+			xs = append(xs, dumpValue(c.Value))
+		}
+		return map[string]any{"list": xs}
+	case ast.ObjectValue:
+		xs := make([]any, 0, len(v.Children))
+		for _, c := range v.Children {
+			xs = append(xs, []any{c.Name, dumpValue(c.Value)})
+		}
+		return map[string]any{"obj": xs}
+	}
+	return map[string]any{"unknown": int(v.Kind)}
+}
+
+func dumpArgs(args ast.ArgumentList) []any {
+	xs := make([]any, 0, len(args))
+	for _, a := range args {
+		xs = append(xs, []any{a.Name, dumpValue(a.Value)})
+	}
+	return xs
+}
+
+func dumpDirs(ds ast.DirectiveList) []any {
+	xs := make([]any, 0, len(ds))
+	for _, d := range ds {
+		xs = append(xs, map[string]any{"d": d.Name, "args": dumpArgs(d.Arguments)})
+	}
+	return xs
+}
+
+func dumpSels(ss ast.SelectionSet) []any {
+	xs := make([]any, 0, len(ss))
+	for _, s := range ss {
+		switch s := s.(type) {
+		case *ast.Field:
+			alias := s.Alias
+			if alias == s.Name {
+				alias = ""
+			}
+			xs = append(xs, map[string]any{"f": s.Name, "alias": alias, "args": dumpArgs(s.Arguments), "dirs": dumpDirs(s.Directives), "sel": dumpSels(s.SelectionSet)})
+		case *ast.FragmentSpread:
+			xs = append(xs, map[string]any{"spread": s.Name, "dirs": dumpDirs(s.Directives)})
+		case *ast.InlineFragment:
+			xs = append(xs, map[string]any{"inline": s.TypeCondition, "dirs": dumpDirs(s.Directives), "sel": dumpSels(s.SelectionSet)})
+		}
+	}
+	return xs
+}
+
+func typeStr(t *ast.Type) string {
+	if t == nil {
+		return ""
+	}
+	return t.String()
+}
+
+func dumpQuery(doc *ast.QueryDocument) any {
+	ops := make([]any, 0, len(doc.Operations))
+	for _, op := range doc.Operations {
+		vars := make([]any, 0, len(op.VariableDefinitions))
+		for _, v := range op.VariableDefinitions {
+			vars = append(vars, map[string]any{"name": v.Variable, "type": typeStr(v.Type), "default": dumpValue(v.DefaultValue), "dirs": dumpDirs(v.Directives)})
+		}
+		ops = append(ops, map[string]any{"op": string(op.Operation), "name": op.Name, "vars": vars, "dirs": dumpDirs(op.Directives), "sel": dumpSels(op.SelectionSet)})
+	}
+	frags := make([]any, 0, len(doc.Fragments))
+	for _, f := range doc.Fragments {
+		frags = append(frags, map[string]any{"name": f.Name, "on": f.TypeCondition, "dirs": dumpDirs(f.Directives), "sel": dumpSels(f.SelectionSet)})
+	}
+	return map[string]any{"ops": ops, "frags": frags}
+}
+
+var builtinDirectiveNames = map[string]bool{"skip": true, "include": true, "deprecated": true, "specifiedBy": true, "oneOf": true, "defer": true}
+
+func dumpArgDefs(args ast.ArgumentDefinitionList) []any {
+	xs := make([]any, 0, len(args))
+	for _, a := range args {
+		xs = append(xs, map[string]any{"name": a.Name, "desc": a.Description, "type": typeStr(a.Type), "default": dumpValue(a.DefaultValue), "dirs": dumpDirs(a.Directives)})
+	}
+	return xs
+}
+
+func dumpInputFields(fields ast.FieldList) []any {
+	xs := make([]any, 0, len(fields))
+	for _, f := range fields {
+		xs = append(xs, map[string]any{"name": f.Name, "desc": f.Description, "type": typeStr(f.Type), "default": dumpValue(f.DefaultValue), "dirs": dumpDirs(f.Directives)})
+	}
+	return xs
+}
+
+func dumpSchema(s *ast.Schema) any {
+	types := map[string]any{}
+	for name, t := range s.Types {
+		if t.BuiltIn || strings.HasPrefix(name, "__") {
+			continue
+		}
+		d := map[string]any{"kind": string(t.Kind), "desc": t.Description, "dirs": dumpDirs(t.Directives)}
+		switch t.Kind {
+		case ast.Object, ast.Interface:
+			ifs := make([]any, 0, len(t.Interfaces))
+			for _, i := range t.Interfaces {
+				ifs = append(ifs, i)
+			}
+			d["interfaces"] = ifs
+			fs := make([]any, 0, len(t.Fields))
+			for _, f := range t.Fields {
+				if f.Name == "__schema" || f.Name == "__type" {
+					continue
+				}
+				fs = append(fs, map[string]any{"name": f.Name, "desc": f.Description, "type": typeStr(f.Type), "args": dumpArgDefs(f.Arguments), "dirs": dumpDirs(f.Directives)})
+			}
+			d["fields"] = fs
+		case ast.Union:
+			ms := make([]any, 0, len(t.Types))
+			for _, m := range t.Types {
+				ms = append(ms, m)
+			}
+			d["members"] = ms
+		case ast.Enum:
+			vs := make([]any, 0, len(t.EnumValues))
+			for _, v := range t.EnumValues {
+				vs = append(vs, map[string]any{"name": v.Name, "desc": v.Description, "dirs": dumpDirs(v.Directives)})
+			}
+			d["values"] = vs
+		case ast.InputObject:
+			d["inputs"] = dumpInputFields(t.Fields)
+		}
+		types[name] = d
+	}
+	directives := map[string]any{}
+	for name, dd := range s.Directives {
+		if builtinDirectiveNames[name] || dd.Position != nil && dd.Position.Src != nil && dd.Position.Src.BuiltIn {
+			continue
+		}
+		locs := make([]string, 0, len(dd.Locations))
+		for _, l := range dd.Locations {
+			locs = append(locs, string(l))
+		}
+		sort.Strings(locs)
+		ls := make([]any, 0, len(locs))
+		for _, l := range locs {
+			ls = append(ls, l)
+		}
+		directives[name] = map[string]any{"desc": dd.Description, "locations": ls, "repeatable": dd.IsRepeatable, "args": dumpArgDefs(dd.Arguments)}
+	}
+	root := func(d *ast.Definition) string {
+		if d == nil {
+			return ""
+		}
+		return d.Name
+	}
+	return map[string]any{"query": root(s.Query), "mutation": root(s.Mutation), "subscription": root(s.Subscription), "desc": s.Description, "dirs": dumpDirs(s.SchemaDirectives), "types": types, "directives": directives}
+}
+
+func canonAny(v any) string {
+	b, _ := json.Marshal(v)
+	return string(b)
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+func firstLine(s string) string {
+	if i := strings.IndexByte(s, '\n'); i >= 0 {
+		return s[:i]
+	}
+	return s
+}
+
+// TestHegelParseAgreesWithGraphQLCore: an executable document is accepted
+// or rejected by both parsers alike, and accepted documents have the same
+// AST.
+func TestHegelParseAgreesWithGraphQLCore(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		var cases []oracleCase
+		var srcs []string
+		var bads []string
+		for i := 0; i < k; i++ {
+			g := newGen(ht)
+			src := g.queryDoc()
+			srcs = append(srcs, src)
+			bads = append(bads, g.badWhy)
+			cases = append(cases, oracleCase{Kind: "parse", Src: src})
+		}
+		res := oracle(ht, cases)
+		for i, src := range srcs {
+			doc, err := parser.ParseQuery(&ast.Source{Input: src})
+			py := res[i]
+			note(ht, "src %q", src)
+			switch {
+			case err != nil && py.Err != "":
+				continue
+			case err != nil:
+				fail(ht, "gqlparser rejects, graphql-core accepts\nsrc:  %q\ngql:  %s\ncore: %s", src, firstLine(err.Error()), canon(py.AST))
+			case py.Err != "":
+				fail(ht, "gqlparser accepts, graphql-core rejects\nsrc:  %q\ncore: %s\ngql:  %s", src, py.Err, canonAny(dumpQuery(doc)))
+			}
+			if bads[i] != "" {
+				fail(ht, "both accept a document with a malformed token (%s)\nsrc:  %q\ngql:  %s", bads[i], src, canonAny(dumpQuery(doc)))
+			}
+			got, want := canonAny(dumpQuery(doc)), canon(py.AST)
+			if got != want {
+				fail(ht, "AST differs\nsrc:  %q\ngql:  %s\ncore: %s", src, got, want)
+			}
+		}
+	})
+}
+
+// TestHegelSchemasAgreeWithGraphQLCore: an SDL document builds the same
+// schema (or is rejected) in gqlparser and graphql-core.
+func TestHegelSchemasAgreeWithGraphQLCore(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 3)
+		var cases []oracleCase
+		var srcs []string
+		var bads []string
+		for i := 0; i < k; i++ {
+			g := newGen(ht)
+			src := g.sdl()
+			srcs = append(srcs, src)
+			bads = append(bads, g.badWhy)
+			cases = append(cases, oracleCase{Kind: "schema", SDL: src})
+		}
+		res := oracle(ht, cases)
+		for i, src := range srcs {
+			schema, err := gqlparser.LoadSchema(&ast.Source{Input: src})
+			py := res[i]
+			note(ht, "sdl %q", src)
+			switch {
+			case err != nil && py.Err != "":
+				continue
+			case err != nil:
+				fail(ht, "gqlparser rejects, graphql-core accepts\nsdl:  %q\ngql:  %s\ncore: %s", src, firstLine(err.Error()), canon(py.Schema))
+			case py.Err != "":
+				fail(ht, "gqlparser accepts, graphql-core rejects\nsdl:  %q\ncore: %s\ngql:  %s", src, py.Err, canonAny(dumpSchema(schema)))
+			}
+			if bads[i] != "" {
+				fail(ht, "both accept a document with a malformed token (%s)\nsdl:  %q", bads[i], src)
+			}
+			got, want := canonAny(dumpSchema(schema)), canon(py.Schema)
+			if got != want {
+				fail(ht, "schema differs\nsdl:  %q\ngql:  %s\ncore: %s", src, got, want)
+			}
+		}
+	})
+}
+
+// TestHegelValidationAgreesWithGraphQLCore: a query against the fixed
+// schema is valid for gqlparser exactly when it is for graphql-core.
+// onlyArgConflicts reports whether every graphql-core error is a
+// differing-arguments field conflict.
+func onlyArgConflicts(msgs []string) bool {
+	if len(msgs) == 0 {
+		return false
+	}
+	for _, m := range msgs {
+		if !strings.Contains(m, "conflict because they have differing arguments") {
+			return false
+		}
+	}
+	return true
+}
+
+// hasCompositeArg reports whether some field argument in doc is a list or
+// object literal (the values gqlparser/24 fails to compare).
+func hasCompositeArg(doc *ast.QueryDocument) bool {
+	var walk func(ss ast.SelectionSet) bool
+	walk = func(ss ast.SelectionSet) bool {
+		for _, sel := range ss {
+			switch sel := sel.(type) {
+			case *ast.Field:
+				for _, a := range sel.Arguments {
+					if a.Value != nil && (a.Value.Kind == ast.ListValue || a.Value.Kind == ast.ObjectValue) {
+						return true
+					}
+				}
+				if walk(sel.SelectionSet) {
+					return true
+				}
+			case *ast.InlineFragment:
+				if walk(sel.SelectionSet) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	for _, op := range doc.Operations {
+		if walk(op.SelectionSet) {
+			return true
+		}
+	}
+	for _, f := range doc.Fragments {
+		if walk(f.SelectionSet) {
+			return true
+		}
+	}
+	return false
+}
+
+func TestHegelValidationAgreesWithGraphQLCore(t *testing.T) {
+	schema, err := gqlparser.LoadSchema(&ast.Source{Input: valSchema})
+	if err != nil {
+		t.Fatalf("validation schema: %v", err)
+	}
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		var cases []oracleCase
+		var srcs []string
+		for i := 0; i < k; i++ {
+			g := newGen(ht)
+			src := g.validationQuery(schema)
+			srcs = append(srcs, src)
+			cases = append(cases, oracleCase{Kind: "validate", SDL: valSchema, Src: src})
+		}
+		res := oracle(ht, cases)
+		for i, src := range srcs {
+			py := res[i]
+			note(ht, "query %q", src)
+			doc, perr := parser.ParseQuery(&ast.Source{Input: src})
+			if perr != nil || py.Err != "" {
+				if perr != nil && py.Err != "" {
+					continue
+				}
+				if perr != nil {
+					fail(ht, "gqlparser fails to parse, graphql-core does not\nsrc:  %q\ngql:  %s", src, firstLine(perr.Error()))
+				}
+				fail(ht, "graphql-core fails, gqlparser parses\nsrc:  %q\ncore: %s", src, py.Err)
+			}
+			if py.Skip != "" {
+				note(ht, "skipped: graphql-core raised during validation: %s", py.Skip)
+				continue
+			}
+			errs := validator.Validate(schema, doc)
+			gotValid := len(errs) == 0
+			if py.Valid == nil {
+				fail(ht, "oracle reply without a verdict: %+v", py)
+			}
+			if gotValid && !*py.Valid && Known.compositeArgConflict && onlyArgConflicts(py.Errors) && hasCompositeArg(doc) {
+				note(ht, "skipped: differing list or object arguments (gqlparser/24)")
+				continue
+			}
+			if gotValid != *py.Valid {
+				var gmsgs []string
+				for _, e := range errs {
+					gmsgs = append(gmsgs, e.Rule+": "+e.Message)
+				}
+				fail(ht, "validity differs (gqlparser %v, graphql-core %v)\nsrc:  %q\ngql:  %s\ncore: %s", gotValid, *py.Valid, src, strings.Join(gmsgs, " | "), strings.Join(py.Errors, " | "))
+			}
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..b37dc1e
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,160 @@
+package gqlparser_test
+
+// GraphQL documents parsed, schemas built and queries validated by gqlparser
+// and by graphql-core (the Python reference implementation, as a child
+// process) must agree: the same documents accepted or rejected, the same
+// AST (in a canonical form), the same schema model, the same validity.
+//
+// Needs python3 with the `graphql-core` package on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 400 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	// A case is a batch of documents through the oracle: large and slow by
+	// hegel's defaults.
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Known bugs (see bugs.toml). Each gate keeps the generator away from a
+// shape that is known to differ from graphql-core while the bug is open; the
+// pins in hegel_pins_test.go fail while it is.
+
+var Known = struct {
+	loneSurrogate          bool // a lone surrogate escape ("\uD83D") is accepted and becomes U+FFFD
+	braceEscape            bool // the variable-width escape "\u{1F600}" is rejected (Unexpected <Invalid>)
+	blockFourQuotes        bool // a block string closed by four quotes ("""a"""") is accepted with a trailing quote in its value
+	surrogatePair          bool // a surrogate pair escape ("\uD83D\uDE00") becomes two U+FFFD instead of one code point
+	numberThenName         bool // a number immediately followed by a name start (1.5_0) is accepted as two tokens
+	directiveArgValue      bool // directive argument values in SDL are not checked against the argument type (@deprecated(reason: 1))
+	duplicateInterface     bool // `type T implements I & I` is accepted
+	selfInterface          bool // `interface I implements I` is accepted
+	extendUndefined        bool // `extend type U` for an undefined U is accepted (and defines U)
+	duplicateRootOp        bool // `schema { query: Query query: Query }` is accepted
+	noQueryRoot            bool // a schema without a query root operation type is accepted
+	oneOfConstraints       bool // @oneOf input objects may have non-null fields and default values
+	rootNotObject          bool // `schema { query: S }` with S a scalar (or any non-object type) is accepted
+	deprecatedRequired     bool // @deprecated on a required argument or input field is accepted
+	blockFirstLineIndent   bool // a block string's first line counts towards the common indent
+	reservedEnumValue      bool // an enum value named __x is accepted
+	duplicateArgDef        bool // a field may define the same argument twice: a(x: Int, x: Int)
+	duplicateInputField    bool // duplicate keys in an object value in SDL ({x: 1, x: 2}) are accepted
+	constDirectiveVariable bool // a variable in a directive argument on a variable definition (query ($a: Int @d(x: $b))) is accepted
+	emptyObjectValue       bool // {} passes validation as the value of a Boolean, String, ... argument (@skip(if: {}))
+	duplicateTypeDirective bool // a non-repeatable directive applied twice to a type definition, or in a definition and its extension, is accepted
+	subscriptionAliasCount bool // SingleFieldSubscriptions counts distinct field names, not response keys (a: petAdded b: petAdded passes)
+	compositeArgConflict   bool // OverlappingFieldsCanBeMerged treats any two list, or any two object, argument values as equal
+}{
+	loneSurrogate:          true,
+	braceEscape:            true,
+	blockFourQuotes:        true,
+	surrogatePair:          true,
+	numberThenName:         true,
+	directiveArgValue:      true,
+	duplicateInterface:     true,
+	selfInterface:          true,
+	extendUndefined:        true,
+	duplicateRootOp:        true,
+	noQueryRoot:            true,
+	oneOfConstraints:       true,
+	rootNotObject:          true,
+	deprecatedRequired:     true,
+	blockFirstLineIndent:   true,
+	reservedEnumValue:      true,
+	duplicateArgDef:        true,
+	duplicateInputField:    true,
+	constDirectiveVariable: true,
+	emptyObjectValue:       true,
+	duplicateTypeDirective: true,
+	subscriptionAliasCount: true,
+	compositeArgConflict:   true,
+}
