new file mode 100644
index 0000000..79ec23a
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,204 @@
+package gqlparser_test
+
+// Pins: one deterministic case per known bug (bugs.toml), each failing
+// while the bug is open.
+
+import (
+	"testing"
+
+	"github.com/vektah/gqlparser/v2"
+	"github.com/vektah/gqlparser/v2/ast"
+	"github.com/vektah/gqlparser/v2/parser"
+	"github.com/vektah/gqlparser/v2/validator"
+)
+
+// pinParse parses src and compares the canonical AST with graphql-core's;
+// both must accept (wantAccept) or both reject.
+func pinParse(t *testing.T, src string, wantAccept bool) {
+	t.Helper()
+	res := oracle(t, []oracleCase{{Kind: "parse", Src: src}})
+	py := res[0]
+	if (py.Err == "") != wantAccept {
+		t.Fatalf("oracle disagrees with the pin's expectation: %+v", py)
+	}
+	doc, err := parser.ParseQuery(&ast.Source{Input: src})
+	if !wantAccept {
+		if err == nil {
+			t.Fatalf("gqlparser accepts %q: %s\ngraphql-core: %s", src, canonAny(dumpQuery(doc)), py.Err)
+		}
+		return
+	}
+	if err != nil {
+		t.Fatalf("gqlparser rejects %q: %v\ngraphql-core: %s", src, err, canon(py.AST))
+	}
+	if got, want := canonAny(dumpQuery(doc)), canon(py.AST); got != want {
+		t.Fatalf("AST differs for %q\ngql:  %s\ncore: %s", src, got, want)
+	}
+}
+
+// pinSchema loads sdl on both sides; both must accept (and agree on the
+// model) or both reject.
+func pinSchema(t *testing.T, sdl string, wantAccept bool) {
+	t.Helper()
+	res := oracle(t, []oracleCase{{Kind: "schema", SDL: sdl}})
+	py := res[0]
+	if (py.Err == "") != wantAccept {
+		t.Fatalf("oracle disagrees with the pin's expectation: %+v", py)
+	}
+	schema, err := gqlparser.LoadSchema(&ast.Source{Input: sdl})
+	if !wantAccept {
+		if err == nil {
+			t.Fatalf("gqlparser accepts %q\ngraphql-core: %s", sdl, py.Err)
+		}
+		return
+	}
+	if err != nil {
+		t.Fatalf("gqlparser rejects %q: %v", sdl, err)
+	}
+	if got, want := canonAny(dumpSchema(schema)), canon(py.Schema); got != want {
+		t.Fatalf("schema differs for %q\ngql:  %s\ncore: %s", sdl, got, want)
+	}
+}
+
+// pinValid validates src against valSchema on both sides; both must find
+// it valid (wantValid) or invalid.
+func pinValid(t *testing.T, src string, wantValid bool) {
+	t.Helper()
+	res := oracle(t, []oracleCase{{Kind: "validate", SDL: valSchema, Src: src}})
+	py := res[0]
+	if py.Err != "" || py.Valid == nil || *py.Valid != wantValid {
+		t.Fatalf("oracle disagrees with the pin's expectation: %+v", py)
+	}
+	schema, err := gqlparser.LoadSchema(&ast.Source{Input: valSchema})
+	if err != nil {
+		t.Fatal(err)
+	}
+	doc, err := parser.ParseQuery(&ast.Source{Input: src})
+	if err != nil {
+		t.Fatalf("gqlparser fails to parse %q: %v", src, err)
+	}
+	errs := validator.Validate(schema, doc)
+	if (len(errs) == 0) != wantValid {
+		t.Fatalf("gqlparser finds %q valid=%v, graphql-core valid=%v\ngql: %v\ncore: %v", src, len(errs) == 0, wantValid, errs, py.Errors)
+	}
+}
+
+// gqlparser/1
+func TestHegelPinLoneSurrogateEscape(t *testing.T) {
+	pinParse(t, `{ a(x: "\uD83D") }`, false)
+}
+
+// gqlparser/2
+func TestHegelPinBraceUnicodeEscape(t *testing.T) {
+	pinParse(t, `{ a(x: "\u{41}") }`, true)
+}
+
+// gqlparser/3
+func TestHegelPinBlockStringFourQuotes(t *testing.T) {
+	pinParse(t, `{ a(x: """a"""") }`, false)
+}
+
+// gqlparser/4
+func TestHegelPinSurrogatePairEscape(t *testing.T) {
+	pinParse(t, "{ a(x: \"\\uD83D\\uDE00\") }", true)
+}
+
+// gqlparser/5
+func TestHegelPinNumberFollowedByName(t *testing.T) {
+	pinParse(t, `{ a(x: [1a]) }`, false)
+}
+
+// gqlparser/6
+func TestHegelPinDirectiveArgumentValueInSDL(t *testing.T) {
+	pinSchema(t, `type Query { a: Int @deprecated(reason: 1) }`, false)
+}
+
+// gqlparser/7
+func TestHegelPinDuplicateDirectiveArgumentInSDL(t *testing.T) {
+	pinSchema(t, `type Query { a: Int @deprecated(reason: "x", reason: "y") }`, false)
+}
+
+// gqlparser/8
+func TestHegelPinDuplicateInputFieldInSDL(t *testing.T) {
+	pinSchema(t, `input I { x: Int } directive @d(a: I) on FIELD_DEFINITION type Query { a: Int @d(a: {x: 1, x: 2}) }`, false)
+}
+
+// gqlparser/9
+func TestHegelPinDuplicateInterface(t *testing.T) {
+	pinSchema(t, `type Query { a: Int } interface I { x: Int } type T implements I & I { x: Int }`, false)
+}
+
+// gqlparser/10
+func TestHegelPinInterfaceImplementsItself(t *testing.T) {
+	pinSchema(t, `type Query { a: Int } interface I implements I { x: Int }`, false)
+}
+
+// gqlparser/11
+func TestHegelPinExtendUndefinedType(t *testing.T) {
+	pinSchema(t, `type Query { a: Int } extend type U { x: Int }`, false)
+}
+
+// gqlparser/12
+func TestHegelPinDuplicateRootOperationType(t *testing.T) {
+	pinSchema(t, `schema { query: Query query: Query } type Query { a: Int }`, false)
+}
+
+// gqlparser/13
+func TestHegelPinSchemaWithoutQueryRoot(t *testing.T) {
+	pinSchema(t, `schema { mutation: Mutation } type Mutation { a: Int }`, false)
+}
+
+// gqlparser/14
+func TestHegelPinOneOfConstraints(t *testing.T) {
+	pinSchema(t, `type Query { a: Int } input I @oneOf { a: Int! b: Int }`, false)
+}
+
+// gqlparser/15
+func TestHegelPinRootTypeNotObject(t *testing.T) {
+	pinSchema(t, `schema { query: S } scalar S`, false)
+}
+
+// gqlparser/16
+func TestHegelPinDeprecatedRequiredArgument(t *testing.T) {
+	pinSchema(t, `type Query { a(x: Int! @deprecated): Int }`, false)
+}
+
+// gqlparser/17
+func TestHegelPinBlockStringFirstLineIndent(t *testing.T) {
+	pinParse(t, "{ a(x: \"\"\"\ta\n    b\"\"\") }", true)
+}
+
+// gqlparser/18
+func TestHegelPinReservedEnumValueName(t *testing.T) {
+	pinSchema(t, `type Query { a: Int } enum E { __X }`, false)
+}
+
+// gqlparser/19
+func TestHegelPinDuplicateArgumentDefinition(t *testing.T) {
+	pinSchema(t, `type Query { a(x: Int, x: Int): Int }`, false)
+}
+
+// gqlparser/20
+func TestHegelPinVariableInConstDirective(t *testing.T) {
+	pinParse(t, `query ($a: Int @d(x: $b)) { a }`, false)
+}
+
+// gqlparser/21
+func TestHegelPinEmptyObjectForScalar(t *testing.T) {
+	pinValid(t, `{ pets { __typename @skip(if: {}) } }`, false)
+}
+
+// gqlparser/22
+func TestHegelPinDuplicateTypeDirective(t *testing.T) {
+	pinSchema(t, `directive @d on OBJECT type Query @d @d { a: Int }`, false)
+}
+
+// gqlparser/23
+func TestHegelPinSubscriptionAliases(t *testing.T) {
+	pinValid(t, `subscription { a: petAdded { __typename } b: petAdded { __typename } }`, false)
+}
+
+// gqlparser/24
+func TestHegelPinListArgumentConflict(t *testing.T) {
+	pinValid(t, `{ users(ids: ["a"]) { id } users(ids: ["b"]) { id } }`, false)
+}
