+package gqlparser_test
+
+// Generators: GraphQL source text for executable documents (syntax-directed,
+// with occasional deliberately malformed tokens), SDL documents (mostly
+// semantically valid), and type-directed queries against the fixed
+// validation schema with faults injected at random.
+
+import (
+	"regexp"
+	"strings"
+
+	"github.com/vektah/gqlparser/v2/ast"
+	"hegel.dev/go/hegel"
+)
+
+type gen struct {
+	tc     hegel.TestCase
+	bad    bool   // a deliberately malformed token was emitted; both sides must reject
+	badWhy string // which generator emitted it
+
+	uniqueObjKeys bool // object literals with unique keys (SDL values while Known.duplicateInputField)
+	noVar         bool // no variables in const positions at all (variable definition directives while Known.constDirectiveVariable)
+}
+
+func newGen(tc hegel.TestCase) *gen { return &gen{tc: tc} }
+
+func (g *gen) badAt(why string) {
+	if !g.bad {
+		g.badWhy = why
+	}
+	g.bad = true
+}
+
+func (g *gen) n(lo, hi int) int         { return n(g.tc, lo, hi) }
+func (g *gen) chance(pct int) bool      { return chance(g.tc, pct) }
+func (g *gen) pick(xs ...string) string { return pick(g.tc, xs...) }
+
+// ---------------------------------------------------------------------------
+// Lexical pieces.
+
+var namePool = []string{"a", "b", "c", "foo", "bar", "_x", "x1", "Foo", "BAR_baz", "_", "__typename", "name", "id", "on", "type", "query", "fragment", "true", "null", "input", "enum", "repeatable", "implements", "extend", "schema"}
+
+func (g *gen) name() string {
+	if g.chance(3) {
+		g.badAt("name")
+		return g.pick("1a", "a-b", "a.b", "$", "\u00E9", "a!", "%", "a\u00A0")
+	}
+	return g.pick(namePool...)
+}
+
+// plainName avoids keywords and __typename; for places where they would be a
+// semantic rather than a syntactic matter.
+func (g *gen) plainName() string {
+	return g.pick("a", "b", "c", "foo", "bar", "_x", "x1", "Foo", "BAR_baz", "name", "id")
+}
+
+// sepPlain is a valid separator for strings.Join (which drops the
+// separator for a single element, so a malformed one could go unseen).
+func (g *gen) sepPlain() string {
+	return g.pick(" ", " ", " ", "\n", ",", " , ", "\t", "\r\n")
+}
+
+// sep is the ignored tokens between two tokens.
+func (g *gen) sep() string {
+	switch g.n(1, 20) {
+	case 1:
+		return "\n"
+	case 2:
+		return "\t"
+	case 3:
+		return ","
+	case 4:
+		return " , "
+	case 5:
+		return "\r\n"
+	case 6:
+		return " # c\u00F6mment \u2603\n"
+	case 7:
+		return "\n\n  "
+	case 8:
+		return ",,"
+	case 9:
+		if g.chance(30) {
+			g.badAt("sep")
+			return g.pick(" \u00A0 ", " \u000B ", " \u2028 ", "\x00", " \u2003 ")
+		}
+		return " "
+	default:
+		return " "
+	}
+}
+
+func (g *gen) intLit() string {
+	if g.chance(6) {
+		g.badAt("intLit")
+		if Known.numberThenName {
+			return g.pick("01", "-01", "+1", "00", "--1", "- 1")
+		}
+		return g.pick("01", "-01", "+1", "00", "1a", "--1", "- 1", "0x10", "1_000", "0b1", "1L")
+	}
+	return g.pick("0", "-0", "1", "-1", "7", "42", "-12", "2147483647", "2147483648", "-2147483649", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "99999999999999999999999", "1000000")
+}
+
+func (g *gen) floatLit() string {
+	if g.chance(6) {
+		g.badAt("floatLit")
+		if Known.numberThenName {
+			return g.pick("1.", ".5", "1.e3", "1e", "1e+", "1.5.5", "01.5", "1.5e1.5", "1.5E", "-.5")
+		}
+		return g.pick("1.", ".5", "1.e3", "1e", "1e+", "1.5.5", "1.0a", "1ea", "01.5", "1.5e1.5", "1.5E", "-.5", "1e5e5", "1.5_0")
+	}
+	return g.pick("1.0", "-1.5", "0.0", "-0.0", "1e3", "1E3", "1e+3", "1e-3", "1.5e10", "1.5E-10", "123.456e7", "0.1e0", "3.14159", "-2e0", "0e0", "1e308", "1e400", "0.000001", "9007199254740993.0")
+}
+
+var strEscapes = []string{`\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`, `A`, `\u00E9`, `\u0000`, `\u2603`, `\uFFFF`, `\u0041\u00e9`}
+
+// a legacy surrogate pair, one code point (Known.surrogatePair)
+var strSurrogatePairs = []string{`\uD83D\uDE00`, `\uD83D\uDE00\uD83D\uDE00`, `\ud83d\ude00`, `\uDBFF\uDFFF`}
+
+// the variable-width escapes (Known.braceEscape)
+var strBraceEscapes = []string{`\u{1F600}`, `\u{41}`, `\u{0}`, `\u{10FFFF}`, `\u{D83D}\u{DE00}`, `\u{000041}`}
+
+var strBadPieces = []string{`\x`, `\u12G4`, `\uGGGG`, `\u1"`, "\n", "\r", `\'`, `\0`, `\U0041`, `\u{}`, `\u{110000}`, `\u{1F6000}`}
+
+// Control characters inside strings and comments (U+0000-U+001F other than
+// tab) are not source characters; graphql-core 3.2 accepts them, so the
+// generator leaves them out.
+
+var strPlain = []string{"a", "b", "z", " ", "'", "hello", "0", "-", "/", "\u00E9", "\u2603", "\U0001F600", "\u4E2D\u6587", "#", "{", "}", "$", "@", "\t", "''", "\u200B", "\uFEFF", "\u0085"}
+
+// surrogate pieces on their own (not paired): the spec forbids lone
+// surrogates; both sides decide.
+var strSurrogates = []string{`\uD83D`, `\uDE00`, `\uDE00\uD83D`, `\uD83DA`, `\uD800\uDBFF`}
+
+func (g *gen) strLit() string {
+	var b strings.Builder
+	b.WriteByte('"')
+	k := g.n(0, 6)
+	for i := 0; i < k; i++ {
+		switch g.n(1, 20) {
+		case 1, 2, 3, 4:
+			b.WriteString(g.pick(strEscapes...))
+		case 5:
+			if Known.surrogatePair {
+				b.WriteString(g.pick(strEscapes...))
+			} else {
+				b.WriteString(g.pick(strSurrogatePairs...))
+			}
+		case 6:
+			if Known.braceEscape {
+				b.WriteString(g.pick(strEscapes...))
+			} else {
+				b.WriteString(g.pick(strBraceEscapes...))
+			}
+		case 7:
+			if g.chance(40) {
+				g.badAt("strLit")
+				b.WriteString(g.pick(strBadPieces...))
+			} else {
+				b.WriteString(g.pick(strPlain...))
+			}
+		case 8:
+			if Known.loneSurrogate {
+				b.WriteString(g.pick(strPlain...))
+			} else {
+				b.WriteString(g.pick(strSurrogates...))
+			}
+		default:
+			b.WriteString(g.pick(strPlain...))
+		}
+	}
+	if g.chance(2) {
+		g.badAt("strLit")
+		return b.String() // unterminated
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+var quoteRuns = regexp.MustCompile(`"{3,}`)
+
+var blockPieces = []string{"a", "b", "hello", " ", "  ", "\t", `"`, `""`, `\"""`, `\n`, `A`, `\`, "\u00E9", "\U0001F600", "'", "#", "{", "}", "x y", "\\\\"}
+
+func (g *gen) blockStrLit() string {
+	nl := g.pick("\n", "\n", "\n", "\r\n", "\r")
+	var lines []string
+	k := g.n(0, 5)
+	for i := 0; i < k; i++ {
+		indent := strings.Repeat(g.pick(" ", "\t", "  ", "    "), g.n(0, 3))
+		var b strings.Builder
+		m := g.n(0, 3)
+		for j := 0; j < m; j++ {
+			b.WriteString(g.pick(blockPieces...))
+		}
+		lines = append(lines, indent+b.String())
+	}
+	body := strings.Join(lines, nl)
+	if g.chance(30) || Known.blockFirstLineIndent {
+		body = nl + body // a blank first line counts for neither implementation
+	}
+	if Known.blockFourQuotes {
+		body = quoteRuns.ReplaceAllString(body, `""`) // three or more quotes in a row is where the bug is
+	}
+	if g.chance(30) {
+		body = body + nl + strings.Repeat(" ", g.n(0, 3))
+	}
+	if Known.blockFourQuotes {
+		body = strings.TrimRight(body, `"`) // a quote before the closing """ is where the bug is
+	}
+	if g.chance(2) {
+		g.badAt("blockStrLit")
+		return `"""` + body // unterminated
+	}
+	if g.chance(5) && !Known.blockFourQuotes {
+		// four or more quotes close the string and start another token
+		return `"""` + body + `""""`
+	}
+	return `"""` + body + `"""`
+}
+
+func (g *gen) enumLit() string {
+	if g.chance(5) {
+		return g.pick("true", "false", "null") // not enum values: both sides decide
+	}
+	return g.pick("RED", "GREEN", "BLUE", "X", "_Y", "on", "query", "fragment", "Foo", "__typename")
+}
+
+// value is a GraphQL input value literal; allowVar permits variables (they
+// are not allowed in const positions).
+func (g *gen) value(depth int, allowVar bool) string {
+	max := 12
+	if depth <= 0 {
+		max = 8
+	}
+	switch g.n(1, max) {
+	case 1:
+		if allowVar || g.chance(15) && !g.noVar {
+			return "$" + g.plainName()
+		}
+		return g.intLit()
+	case 2, 3:
+		return g.intLit()
+	case 4:
+		return g.floatLit()
+	case 5:
+		return g.strLit()
+	case 6:
+		if g.chance(30) {
+			return g.blockStrLit()
+		}
+		return g.strLit()
+	case 7:
+		return g.pick("true", "false", "null")
+	case 8:
+		return g.enumLit()
+	case 9, 10:
+		k := g.n(0, 3)
+		parts := make([]string, k)
+		for i := range parts {
+			parts[i] = g.value(depth-1, allowVar)
+		}
+		if g.chance(3) {
+			g.badAt("value")
+			return "[" + strings.Join(parts, g.sepPlain()) // unclosed
+		}
+		return "[" + strings.Join(parts, g.sepPlain()) + "]"
+	default:
+		k := g.n(0, 3)
+		parts := make([]string, k)
+		used := map[string]bool{}
+		for i := range parts {
+			nm := g.plainName()
+			if g.uniqueObjKeys {
+				for used[nm] {
+					nm += "2"
+				}
+				used[nm] = true
+			}
+			parts[i] = nm + g.pick(":", " :", ": ", " : ") + g.value(depth-1, allowVar)
+		}
+		if g.chance(3) {
+			g.badAt("value")
+			return "{" + strings.Join(parts, g.sepPlain()) + g.pick("", " a }", " a: }", " 1: 2 }")
+		}
+		return "{" + g.sep() + strings.Join(parts, g.sepPlain()) + g.sep() + "}"
+	}
+}
+
+// typeRef is a type reference; names are drawn from the given pool.
+func (g *gen) typeRef(pool []string, depth int) string {
+	var t string
+	if depth > 0 && g.chance(35) {
+		t = "[" + g.sep() + g.typeRef(pool, depth-1) + g.sep() + "]"
+	} else {
+		t = pick(g.tc, pool...)
+	}
+	if g.chance(40) {
+		t += "!"
+	}
+	return t
+}
+
+// typeOut emits a type reference where it is written, occasionally
+// replacing it with a malformed one.
+func (g *gen) typeOut(t string) string {
+	if g.chance(2) {
+		g.badAt("typeOut")
+		return g.pick("T!!", "[T", "[]", "[T!", "!T", "[T]]", "T?", "[T!]!!")
+	}
+	return t
+}
+
+var builtinScalars = []string{"Int", "Float", "String", "Boolean", "ID"}
+
+// ---------------------------------------------------------------------------
+// Executable documents (syntax-directed).
+
+func (g *gen) directives(allowVar bool) string {
+	k := g.n(0, 2)
+	if g.chance(50) {
+		k = 0
+	}
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		b.WriteString(g.sep())
+		b.WriteString("@")
+		if g.chance(2) {
+			g.badAt("directives")
+			b.WriteString(g.pick("1", "", "-", "\\u00E9"))
+		} else {
+			b.WriteString(g.pick("skip", "include", "tag", "once", "deprecated", "foo", "defer", "d1"))
+		}
+		if g.chance(50) {
+			b.WriteString(g.args(allowVar))
+		}
+	}
+	return b.String()
+}
+
+func (g *gen) args(allowVar bool) string {
+	k := g.n(1, 3)
+	if g.chance(3) {
+		g.badAt("args")
+		return g.pick("()", "(a)", "(a: )", "(: 1)", "(a: 1", "(a: 1 b)", "(a = 1)", "(a: 1;)")
+	}
+	parts := make([]string, k)
+	for i := range parts {
+		parts[i] = g.plainName() + g.pick(":", ": ", " : ") + g.value(2, allowVar)
+	}
+	return "(" + g.sep() + strings.Join(parts, g.sepPlain()) + g.sep() + ")"
+}
+
+func (g *gen) selectionSet(depth int) string {
+	if g.chance(2) {
+		g.badAt("selectionSet")
+		return g.pick("{}", "{ }", "{ ... }", "{ a } }", "{ a: }", "{ : a }", "{ ...on }", "{ ... on { a } }", "{ a(: 1) }", "{ a: b: c }", "{ ..a }", "{ .... a }")
+	}
+	k := g.n(1, 4)
+	var b strings.Builder
+	b.WriteString("{")
+	for i := 0; i < k; i++ {
+		b.WriteString(g.sep())
+		b.WriteString(g.selection(depth))
+	}
+	b.WriteString(g.sep())
+	b.WriteString("}")
+	return b.String()
+}
+
+func (g *gen) selection(depth int) string {
+	switch g.n(1, 10) {
+	case 1:
+		// fragment spread
+		nm := g.name()
+		if nm == "on" && !g.bad {
+			// "...on" is an inline fragment start; graphql forbids `on` as a fragment name
+			g.badAt("selection")
+		}
+		return "..." + g.pick("", " ", "\n") + nm + g.directives(true)
+	case 2, 3:
+		// inline fragment
+		var b strings.Builder
+		b.WriteString("...")
+		if g.chance(70) {
+			b.WriteString(g.sep())
+			b.WriteString("on")
+			b.WriteString(g.sep())
+			b.WriteString(g.name())
+		}
+		b.WriteString(g.directives(true))
+		b.WriteString(g.sep())
+		if depth > 0 {
+			b.WriteString(g.selectionSet(depth - 1))
+		} else {
+			b.WriteString("{ x }")
+		}
+		return b.String()
+	default:
+		var b strings.Builder
+		if g.chance(20) {
+			b.WriteString(g.name())
+			b.WriteString(g.pick(":", ": ", " : ", "\n:"))
+		}
+		b.WriteString(g.name())
+		if g.chance(35) {
+			b.WriteString(g.args(true))
+		}
+		b.WriteString(g.directives(true))
+		if depth > 0 && g.chance(40) {
+			b.WriteString(g.sep())
+			b.WriteString(g.selectionSet(depth - 1))
+		}
+		return b.String()
+	}
+}
+
+func (g *gen) variableDefs() string {
+	k := g.n(1, 3)
+	if g.chance(3) {
+		g.badAt("variableDefs")
+		return g.pick("()", "($a)", "($a: )", "(a: Int)", "($a Int)", "($a: Int = )", "($a: Int,,)", "($a: Int!!)")
+	}
+	parts := make([]string, k)
+	for i := range parts {
+		var b strings.Builder
+		b.WriteString("$")
+		b.WriteString(g.plainName())
+		b.WriteString(g.pick(":", ": ", " : "))
+		b.WriteString(g.typeOut(g.typeRef(append([]string{"Foo", "Bar", "E"}, builtinScalars...), 2)))
+		if g.chance(35) {
+			b.WriteString(g.pick(" = ", "=", " =\n"))
+			b.WriteString(g.value(2, g.chance(10)))
+		}
+		g.noVar = Known.constDirectiveVariable // gqlparser takes a variable in these const directives
+		b.WriteString(g.directives(false))
+		g.noVar = false
+		parts[i] = b.String()
+	}
+	return "(" + g.sep() + strings.Join(parts, g.sepPlain()) + g.sep() + ")"
+}
+
+func (g *gen) operation() string {
+	var b strings.Builder
+	if g.chance(25) {
+		// query shorthand
+		b.WriteString(g.selectionSet(3))
+		return b.String()
+	}
+	b.WriteString(g.pick("query", "query", "mutation", "subscription"))
+	if g.chance(60) {
+		b.WriteString(g.sep())
+		b.WriteString(g.name())
+	}
+	if g.chance(50) {
+		b.WriteString(g.sep())
+		b.WriteString(g.variableDefs())
+	}
+	b.WriteString(g.directives(true))
+	b.WriteString(g.sep())
+	if g.chance(3) {
+		g.badAt("operation")
+		b.WriteString(g.pick("@ { a }", ": { a }", "[ a ]", "( $a: Int ) )", "{ a } }"))
+		return b.String()
+	}
+	b.WriteString(g.selectionSet(3))
+	return b.String()
+}
+
+func (g *gen) fragmentDef() string {
+	var b strings.Builder
+	b.WriteString("fragment")
+	b.WriteString(g.sep())
+	nm := g.name()
+	if nm == "on" && !g.bad {
+		g.badAt("fragmentDef")
+	}
+	b.WriteString(nm)
+	b.WriteString(g.sep())
+	if g.chance(3) {
+		g.badAt("fragmentDef")
+		b.WriteString(g.pick("{ a }", "on { a }", "on Foo!", "on [Foo] { a }", "Foo { a }", "on Foo @ { a }"))
+		return b.String()
+	}
+	b.WriteString("on")
+	b.WriteString(g.sep())
+	b.WriteString(g.name())
+	b.WriteString(g.directives(true))
+	b.WriteString(g.sep())
+	b.WriteString(g.selectionSet(2))
+	return b.String()
+}
+
+// queryDoc is an executable document.
+func (g *gen) queryDoc() string {
+	var b strings.Builder
+	if g.chance(5) {
+		b.WriteString("\uFEFF")
+	}
+	if g.chance(30) {
+		b.WriteString(g.sep())
+	}
+	k := g.n(1, 3)
+	for i := 0; i < k; i++ {
+		if i > 0 {
+			b.WriteString(g.sep())
+		}
+		if g.chance(30) {
+			b.WriteString(g.fragmentDef())
+		} else {
+			b.WriteString(g.operation())
+		}
+	}
+	if g.chance(30) {
+		b.WriteString(g.sep())
+	}
+	if g.chance(3) {
+		g.badAt("queryDoc")
+		b.WriteString(g.pick("}", " {", " type A { a: Int }", " ...", " $x", " @d", " )", " ]", " 1", " \"s\"", " query", " fragment F"))
+	}
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// SDL documents (mostly valid).
+
+type sdlType struct {
+	name       string
+	kind       ast.DefinitionKind
+	fields     []sdlField // object, interface, input
+	interfaces []string
+	members    []string
+	values     []string
+}
+
+type sdlField struct {
+	name string
+	typ  string
+	args []sdlArg
+}
+
+type sdlArg struct {
+	name string
+	typ  string
+	def  string // default value source, "" for none
+}
+
+type sdlDirective struct {
+	name       string
+	locations  []string
+	repeatable bool
+	args       []sdlArg
+}
+
+type sdlGen struct {
+	*gen
+	types          []*sdlType
+	byName         map[string]*sdlType
+	dirs           []*sdlDirective
+	inDirectiveDef bool
+	curRequired    bool                       // the argument or input field being emitted is non-null without a default
+	curType        string                     // the type (or "schema") whose directives are being emitted
+	typeDirs       map[string]map[string]bool // non-repeatable directives applied so far, per type, at type-level locations
+	inputPool      []string                   // input type names (enum, scalar, input object, builtins)
+	outputPool     []string                   // output type names (everything but input objects)
+}
+
+var allLocations = []string{"QUERY", "MUTATION", "SUBSCRIPTION", "FIELD", "FRAGMENT_DEFINITION", "FRAGMENT_SPREAD", "INLINE_FRAGMENT", "VARIABLE_DEFINITION", "SCHEMA", "SCALAR", "OBJECT", "FIELD_DEFINITION", "ARGUMENT_DEFINITION", "INTERFACE", "UNION", "ENUM", "ENUM_VALUE", "INPUT_OBJECT", "INPUT_FIELD_DEFINITION"}
+
+func (g *gen) description() string {
+	if !g.chance(35) {
+		return ""
+	}
+	if g.chance(40) {
+		return g.blockStrLit() + g.sep()
+	}
+	return g.strLit() + g.sep()
+}
+
+// constValueFor is a constant literal of the given type, mostly correct.
+func (s *sdlGen) constValueFor(typ string, depth int) string {
+	if s.chance(8) {
+		return s.value(1, false)
+	}
+	return s.typedConstValueFor(typ, depth)
+}
+
+// typedConstValueFor is a constant literal of the given type (custom
+// scalars take anything).
+func (s *sdlGen) typedConstValueFor(typ string, depth int) string {
+	if s.chance(10) && !strings.HasSuffix(typ, "!") {
+		return "null"
+	}
+	t := strings.TrimSuffix(typ, "!")
+	if strings.HasPrefix(t, "[") {
+		inner := t[1 : len(t)-1]
+		if s.chance(20) && depth > 0 {
+			return s.constValueFor(inner, depth-1) // list coercion of a single value
+		}
+		k := s.n(0, 2)
+		parts := make([]string, k)
+		for i := range parts {
+			parts[i] = s.constValueFor(inner, depth-1)
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	}
+	switch t {
+	case "Int":
+		return s.pick("0", "1", "-5", "2147483647", "2147483648", "42")
+	case "Float":
+		return s.pick("1.5", "0.0", "-2e3", "3", "1e308")
+	case "String":
+		return s.pick(`"s"`, `""`, `"\u00E9"`, `"""b"""`)
+	case "Boolean":
+		return s.pick("true", "false")
+	case "ID":
+		return s.pick(`"id1"`, "4", `""`)
+	}
+	if d := s.byName[t]; d != nil {
+		switch d.kind {
+		case ast.Enum:
+			if len(d.values) > 0 {
+				return pick(s.tc, d.values...)
+			}
+			return "RED"
+		case ast.Scalar:
+			return s.pick(`"x"`, "1", "true", "[1]", "{a: 1}")
+		case ast.InputObject:
+			if depth <= 0 {
+				return "{}"
+			}
+			var parts []string
+			for _, f := range d.fields {
+				if s.chance(60) {
+					parts = append(parts, f.name+": "+s.constValueFor(f.typ, depth-1))
+				}
+			}
+			return "{" + strings.Join(parts, ", ") + "}"
+		}
+	}
+	return s.value(1, false)
+}
+
+func (s *sdlGen) argDefs(fresh func() string) []sdlArg {
+	k := s.n(0, 3)
+	if s.chance(50) {
+		k = 0
+	}
+	var out []sdlArg
+	for i := 0; i < k; i++ {
+		a := sdlArg{name: fresh(), typ: s.typeRef(s.inputPool, 1)}
+		if Known.duplicateArgDef {
+			for _, o := range out {
+				if o.name == a.name {
+					a.name += "x"
+				}
+			}
+		}
+		if s.chance(3) {
+			a.typ = s.typeRef(s.outputPool, 1) // an output type as an argument type
+		}
+		if s.chance(35) {
+			a.def = s.constValueFor(a.typ, 2)
+		}
+		out = append(out, a)
+	}
+	return out
+}
+
+func (s *sdlGen) fieldDefs(input bool) []sdlField {
+	k := s.n(1, 4)
+	if s.chance(2) {
+		k = 0 // no fields: both sides decide
+	}
+	var out []sdlField
+	used := map[string]bool{}
+	fresh := func() string {
+		nm := s.plainName()
+		if s.chance(3) {
+			return nm // may duplicate
+		}
+		for used[nm] {
+			nm += "2"
+		}
+		used[nm] = true
+		return nm
+	}
+	for i := 0; i < k; i++ {
+		f := sdlField{name: fresh()}
+		if s.chance(2) {
+			f.name = "__" + f.name
+		}
+		if input {
+			f.typ = s.typeRef(s.inputPool, 1)
+			if s.chance(3) {
+				f.typ = s.typeRef(s.outputPool, 1)
+			}
+			if s.chance(35) {
+				f.args = []sdlArg{{def: s.constValueFor(f.typ, 2)}} // default value carried in args[0].def
+			}
+		} else {
+			f.typ = s.typeRef(s.outputPool, 1)
+			if s.chance(3) {
+				f.typ = s.typeRef(s.inputPool, 1)
+			}
+			f.args = s.argDefs(fresh)
+		}
+		out = append(out, f)
+	}
+	return out
+}
+
+func (s *sdlGen) appliedDirectives(location string, varOK bool) string {
+	var b strings.Builder
+	if s.inDirectiveDef {
+		return "" // a directive definition using a directive: graphql-core accepts a self-reference, the spec does not
+	}
+	for _, d := range s.dirs {
+		if !s.chance(25) {
+			continue
+		}
+		if !d.repeatable && s.onceUsed(location, d.name) {
+			continue
+		}
+		b.WriteString(s.sep())
+		b.WriteString("@" + d.name)
+		var parts []string
+		for _, a := range d.args {
+			if a.def == "" && strings.HasSuffix(a.typ, "!") || s.chance(50) {
+				if Known.directiveArgValue {
+					parts = append(parts, a.name+": "+s.typedConstValueFor(a.typ, 1))
+				} else {
+					parts = append(parts, a.name+": "+s.constValueFor(a.typ, 1))
+				}
+			}
+		}
+		if len(parts) > 0 {
+			b.WriteString("(" + strings.Join(parts, ", ") + ")")
+		}
+		if d.repeatable && s.chance(30) || s.chance(3) && !(!d.repeatable && Known.duplicateTypeDirective && typeLevel(location)) {
+			b.WriteString(" @" + d.name)
+			if len(parts) > 0 {
+				b.WriteString("(" + strings.Join(parts, ", ") + ")")
+			}
+		}
+	}
+	switch location {
+	case "FIELD_DEFINITION", "ARGUMENT_DEFINITION", "INPUT_FIELD_DEFINITION", "ENUM_VALUE":
+		if s.chance(15) && !(Known.deprecatedRequired && s.curRequired) {
+			b.WriteString(s.sep())
+			b.WriteString("@deprecated")
+			if s.chance(50) {
+				if Known.directiveArgValue {
+					b.WriteString("(reason: " + s.pick(`"old"`, `"""gone"""`, `null`, `"No longer supported"`) + ")")
+				} else {
+					b.WriteString("(reason: " + s.pick(`"old"`, `"""gone"""`, `null`, `1`, `"No longer supported"`) + ")")
+				}
+			}
+		}
+	case "SCALAR":
+		if s.chance(30) && !s.onceUsed(location, "specifiedBy") {
+			b.WriteString(s.sep())
+			if Known.directiveArgValue {
+				b.WriteString("@specifiedBy(url: " + s.pick(`"https://x.example"`, `""`) + ")")
+			} else {
+				b.WriteString("@specifiedBy(url: " + s.pick(`"https://x.example"`, `""`, `1`) + ")")
+			}
+		}
+	case "INPUT_OBJECT":
+		if s.chance(15) && !Known.oneOfConstraints {
+			b.WriteString(s.sep())
+			b.WriteString("@oneOf")
+		}
+	}
+	if s.chance(2) {
+		extra := s.pick("@deprecated", "@skip(if: true)", "@include(if: false)", "@specifiedBy(url: \"u\")", "@unknown", "@oneOf")
+		switch {
+		case extra == "@deprecated" && Known.deprecatedRequired && s.curRequired:
+			extra = "" // gqlparser/16
+		case extra == "@oneOf" && Known.oneOfConstraints && location == "INPUT_OBJECT":
+			extra = "" // gqlparser/14
+		case strings.HasPrefix(extra, "@specifiedBy") && s.onceUsed(location, "specifiedBy"):
+			extra = "" // gqlparser/22
+		}
+		if extra != "" {
+			b.WriteString(s.sep())
+			b.WriteString(extra)
+		}
+	}
+	_ = varOK
+	return b.String()
+}
+
+// typeLevel reports whether location is one of the type system locations
+// where gqlparser does not check for duplicate directives (gqlparser/22).
+func typeLevel(location string) bool {
+	switch location {
+	case "SCALAR", "OBJECT", "INTERFACE", "UNION", "ENUM", "INPUT_OBJECT", "SCHEMA":
+		return true
+	}
+	return false
+}
+
+// onceUsed records that the non-repeatable directive name is applied to the
+// current type at a type-level location and reports whether it already was,
+// while Known.duplicateTypeDirective; otherwise it is false.
+func (s *sdlGen) onceUsed(location, name string) bool {
+	if !Known.duplicateTypeDirective || !typeLevel(location) {
+		return false
+	}
+	set := s.typeDirs[s.curType]
+	if set == nil {
+		set = map[string]bool{}
+		s.typeDirs[s.curType] = set
+	}
+	if set[name] {
+		return true
+	}
+	set[name] = true
+	return false
+}
+
+func (s *sdlGen) argDefsSrc(args []sdlArg) string {
+	if len(args) == 0 {
+		if s.chance(2) {
+			s.badAt("argDefsSrc")
+			return "()"
+		}
+		return ""
+	}
+	var parts []string
+	for _, a := range args {
+		p := s.description() + a.name + s.pick(":", ": ", " : ") + s.typeOut(a.typ)
+		if a.def != "" {
+			p += s.pick(" = ", "=", " =\n") + a.def
+		}
+		s.curRequired = strings.HasSuffix(a.typ, "!") // graphql-core treats an uncoercible default as absent, so any non-null counts
+		p += s.appliedDirectives("ARGUMENT_DEFINITION", false)
+		s.curRequired = false
+		parts = append(parts, p)
+	}
+	return "(" + s.sep() + strings.Join(parts, s.sepPlain()) + s.sep() + ")"
+}
+
+func (s *sdlGen) fieldsSrc(fields []sdlField, input bool) string {
+	var b strings.Builder
+	b.WriteString("{")
+	for _, f := range fields {
+		b.WriteString(s.sep())
+		b.WriteString(s.description())
+		b.WriteString(f.name)
+		if input {
+			b.WriteString(s.pick(":", ": ", " : "))
+			b.WriteString(s.typeOut(f.typ))
+			hasDef := len(f.args) == 1 && f.args[0].def != ""
+			if hasDef {
+				b.WriteString(s.pick(" = ", "=", " =\n") + f.args[0].def)
+			}
+			s.curRequired = strings.HasSuffix(f.typ, "!")
+			b.WriteString(s.appliedDirectives("INPUT_FIELD_DEFINITION", false))
+			s.curRequired = false
+		} else {
+			b.WriteString(s.argDefsSrc(f.args))
+			b.WriteString(s.pick(":", ": ", " : "))
+			b.WriteString(s.typeOut(f.typ))
+			b.WriteString(s.appliedDirectives("FIELD_DEFINITION", false))
+		}
+	}
+	b.WriteString(s.sep())
+	b.WriteString("}")
+	return b.String()
+}
+
+func (s *sdlGen) implementsSrc(ifaces []string) string {
+	if len(ifaces) == 0 {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString(s.sep())
+	b.WriteString("implements")
+	b.WriteString(s.sep())
+	if s.chance(30) {
+		b.WriteString("&" + s.sep())
+	}
+	b.WriteString(strings.Join(ifaces, s.pick(" & ", "&", " &\n")))
+	return b.String()
+}
+
+func (s *sdlGen) typeSrc(t *sdlType, extend bool) string {
+	var b strings.Builder
+	s.curType = t.name
+	if !extend {
+		b.WriteString(s.description())
+	} else {
+		if s.chance(3) {
+			b.WriteString(s.pick(`"d" `, `""" d """ `)) // a description on an extension: not in the grammar
+		}
+		b.WriteString("extend")
+		b.WriteString(s.sep())
+	}
+	switch t.kind {
+	case ast.Scalar:
+		b.WriteString("scalar" + s.sep() + t.name + s.appliedDirectives("SCALAR", false))
+	case ast.Object:
+		b.WriteString("type" + s.sep() + t.name + s.implementsSrc(t.interfaces) + s.appliedDirectives("OBJECT", false))
+		if !(extend && len(t.fields) == 0) {
+			b.WriteString(s.sep() + s.fieldsSrc(t.fields, false))
+		}
+	case ast.Interface:
+		b.WriteString("interface" + s.sep() + t.name + s.implementsSrc(t.interfaces) + s.appliedDirectives("INTERFACE", false))
+		if !(extend && len(t.fields) == 0) {
+			b.WriteString(s.sep() + s.fieldsSrc(t.fields, false))
+		}
+	case ast.Union:
+		b.WriteString("union" + s.sep() + t.name + s.appliedDirectives("UNION", false))
+		if len(t.members) > 0 || !extend {
+			b.WriteString(s.sep() + "=" + s.sep())
+			if s.chance(30) {
+				b.WriteString("|" + s.sep())
+			}
+			b.WriteString(strings.Join(t.members, s.pick(" | ", "|", " |\n")))
+		}
+	case ast.Enum:
+		b.WriteString("enum" + s.sep() + t.name + s.appliedDirectives("ENUM", false))
+		if len(t.values) > 0 || !extend {
+			b.WriteString(s.sep() + "{")
+			for _, v := range t.values {
+				b.WriteString(s.sep() + s.description() + v + s.appliedDirectives("ENUM_VALUE", false))
+			}
+			b.WriteString(s.sep() + "}")
+		}
+	case ast.InputObject:
+		b.WriteString("input" + s.sep() + t.name + s.appliedDirectives("INPUT_OBJECT", false))
+		if !(extend && len(t.fields) == 0) {
+			b.WriteString(s.sep() + s.fieldsSrc(t.fields, true))
+		}
+	}
+	return b.String()
+}
+
+func (s *sdlGen) directiveDefSrc(d *sdlDirective) string {
+	var b strings.Builder
+	b.WriteString(s.description())
+	b.WriteString("directive" + s.sep() + "@" + d.name)
+	s.inDirectiveDef = true
+	b.WriteString(s.argDefsSrc(d.args))
+	s.inDirectiveDef = false
+	if d.repeatable {
+		b.WriteString(s.sep() + "repeatable")
+	}
+	b.WriteString(s.sep() + "on" + s.sep())
+	if s.chance(30) {
+		b.WriteString("|" + s.sep())
+	}
+	b.WriteString(strings.Join(d.locations, s.pick(" | ", "|", " |\n")))
+	return b.String()
+}
+
+// sdl builds a whole SDL document: a handful of types referring to each
+// other, optional directive definitions, schema definition and extensions.
+func (g *gen) sdl() string {
+	s := &sdlGen{gen: g, byName: map[string]*sdlType{}, typeDirs: map[string]map[string]bool{}}
+	g.uniqueObjKeys = Known.duplicateInputField
+	s.inputPool = append(s.inputPool, builtinScalars...)
+	s.outputPool = append(s.outputPool, builtinScalars...)
+
+	// Names and kinds first, so references can point forward.
+	names := []string{"A", "B", "C", "D", "E", "F"}
+	k := s.n(1, 5)
+	for i := 0; i < k; i++ {
+		t := &sdlType{name: names[i]}
+		switch s.n(1, 12) {
+		case 1, 2:
+			t.kind = ast.Scalar
+		case 3, 4, 5:
+			t.kind = ast.Object
+		case 6, 7:
+			t.kind = ast.Interface
+		case 8:
+			t.kind = ast.Union
+		case 9, 10:
+			t.kind = ast.Enum
+		default:
+			t.kind = ast.InputObject
+		}
+		s.types = append(s.types, t)
+		s.byName[t.name] = t
+		switch t.kind {
+		case ast.Scalar, ast.Enum:
+			s.inputPool = append(s.inputPool, t.name)
+			s.outputPool = append(s.outputPool, t.name)
+		case ast.InputObject:
+			s.inputPool = append(s.inputPool, t.name)
+		default:
+			s.outputPool = append(s.outputPool, t.name)
+		}
+	}
+	query := &sdlType{name: "Query", kind: ast.Object}
+	if s.chance(3) && !Known.noQueryRoot {
+		query = nil // no Query type: both sides decide
+	} else {
+		s.types = append(s.types, query)
+		s.byName["Query"] = query
+		s.outputPool = append(s.outputPool, "Query")
+	}
+	if s.chance(3) {
+		s.outputPool = append(s.outputPool, "Undefined") // a dangling reference
+	}
+
+	// Directive definitions.
+	nd := 0
+	if s.chance(40) {
+		nd = s.n(1, 2)
+	}
+	for i := 0; i < nd; i++ {
+		d := &sdlDirective{name: []string{"d1", "d2"}[i], repeatable: s.chance(30)}
+		m := s.n(1, 4)
+		for j := 0; j < m; j++ {
+			loc := pick(s.tc, allLocations...)
+			dup := false
+			for _, l := range d.locations {
+				if l == loc {
+					dup = true
+				}
+			}
+			if !dup || s.chance(5) {
+				d.locations = append(d.locations, loc)
+			}
+		}
+		used := map[string]bool{}
+		d.args = s.argDefs(func() string {
+			nm := s.plainName()
+			for used[nm] {
+				nm += "2"
+			}
+			used[nm] = true
+			return nm
+		})
+		s.dirs = append(s.dirs, d)
+	}
+
+	// Bodies, interfaces first so implementors can copy their fields.
+	for _, t := range s.types {
+		if t.kind == ast.Interface {
+			t.fields = s.fieldDefs(false)
+		}
+	}
+	for _, t := range s.types {
+		switch t.kind {
+		case ast.Interface:
+			for _, o := range s.types {
+				if o.kind == ast.Interface && o != t && s.chance(20) {
+					t.interfaces = append(t.interfaces, o.name)
+				}
+			}
+			s.inherit(t)
+		case ast.Object:
+			t.fields = s.fieldDefs(false)
+			for _, o := range s.types {
+				if o.kind == ast.Interface && s.chance(35) {
+					t.interfaces = append(t.interfaces, o.name)
+				}
+			}
+			if s.chance(3) && len(s.types) > 0 {
+				nm := pick(s.tc, s.types...).name // maybe not an interface, maybe a duplicate
+				if !Known.duplicateInterface || !containsStr(t.interfaces, nm) {
+					t.interfaces = append(t.interfaces, nm)
+				}
+			}
+			s.inherit(t)
+		case ast.Union:
+			for _, o := range s.types {
+				if o.kind == ast.Object && s.chance(50) {
+					t.members = append(t.members, o.name)
+				}
+			}
+			if len(t.members) == 0 || s.chance(3) {
+				t.members = append(t.members, pick(s.tc, s.outputPool...))
+			}
+			if s.chance(5) && len(t.members) > 0 {
+				t.members = append(t.members, t.members[0]) // duplicate member
+			}
+		case ast.Enum:
+			m := s.n(1, 4)
+			if s.chance(2) {
+				m = 0
+			}
+			for i := 0; i < m; i++ {
+				v := s.pick("RED", "GREEN", "BLUE", "X", "_Y", "on", "Foo", "__typename", "true", "null", "false")
+				if v == "__typename" && Known.reservedEnumValue {
+					v = "Z"
+				}
+				dup := false
+				for _, w := range t.values {
+					if w == v {
+						dup = true
+					}
+				}
+				if !dup || s.chance(10) {
+					t.values = append(t.values, v)
+				}
+			}
+		case ast.InputObject:
+			t.fields = s.fieldDefs(true)
+			if s.chance(10) && len(t.fields) > 0 {
+				t.fields[0].typ = t.name + s.pick("", "!", "") // self reference; non-null makes a cycle
+				t.fields[0].args = nil                         // no default: graphql-core recurses coercing one
+			}
+		}
+	}
+
+	// graphql-core recurses without end coercing the default value of an
+	// input field whose type reaches back to the containing input object
+	// (input B { b: B foo: B = {} }); no defaults on such fields.
+	for _, t := range s.types {
+		if t.kind != ast.InputObject {
+			continue
+		}
+		for i := range t.fields {
+			f := &t.fields[i]
+			if len(f.args) == 1 && f.args[0].def != "" && s.reachesInput(baseType(f.typ), t.name, map[string]bool{}) {
+				f.args = nil
+			}
+		}
+	}
+
+	// Emit.
+	var b strings.Builder
+	if s.chance(30) {
+		b.WriteString(s.sep())
+	}
+	emit := func(src string) {
+		b.WriteString(src)
+		b.WriteString(s.sep())
+		if s.chance(30) {
+			b.WriteString("\n")
+		}
+	}
+	var ops []string
+	if s.chance(35) {
+		var sb strings.Builder
+		sb.WriteString(s.description())
+		s.curType = "schema"
+		sb.WriteString("schema" + s.appliedDirectives("SCHEMA", false) + s.sep() + "{")
+		ops = []string{"query"}
+		if s.chance(30) {
+			ops = append(ops, "mutation")
+		}
+		if s.chance(30) {
+			ops = append(ops, "subscription")
+		}
+		if s.chance(5) && !Known.duplicateRootOp {
+			ops = append(ops, "query")
+		}
+		if s.chance(5) && !Known.noQueryRoot {
+			ops = ops[1:]
+		}
+		for _, op := range ops {
+			sb.WriteString(s.sep() + op + s.pick(":", ": ") + s.rootType())
+		}
+		sb.WriteString(s.sep() + "}")
+		emit(sb.String())
+	}
+	for _, d := range s.dirs {
+		emit(s.directiveDefSrc(d))
+	}
+	// Shuffle-ish order: emit types in a random rotation.
+	off := s.n(0, len(s.types))
+	for i := range s.types {
+		t := s.types[(i+off)%len(s.types)]
+		emit(s.typeSrc(t, false))
+	}
+	if s.chance(3) && len(s.types) > 0 {
+		emit(s.typeSrc(pick(s.tc, s.types...), false)) // redeclared
+	}
+	// Extensions.
+	if s.chance(35) {
+		m := s.n(1, 2)
+		for i := 0; i < m; i++ {
+			t := pick(s.tc, s.types...)
+			ext := &sdlType{name: t.name, kind: t.kind}
+			if s.chance(5) && !Known.extendUndefined {
+				ext.name = "Undefined"
+			}
+			if s.chance(5) {
+				ext.kind = ast.Object
+				if t.kind == ast.Object {
+					ext.kind = ast.Enum
+				}
+			}
+			switch ext.kind {
+			case ast.Object, ast.Interface:
+				if s.chance(70) {
+					ext.fields = []sdlField{{name: s.pick("extra", "more", "z"), typ: s.typeRef(s.outputPool, 1)}}
+					if s.chance(10) && len(t.fields) > 0 {
+						ext.fields[0].name = t.fields[0].name // duplicate field
+					}
+				}
+				if s.chance(30) {
+					for _, o := range s.types {
+						if o.kind == ast.Interface && s.chance(50) && !(Known.duplicateInterface && containsStr(t.interfaces, o.name)) {
+							ext.interfaces = append(ext.interfaces, o.name)
+							t.fields = append(t.fields, o.fields...)
+							ext.fields = append(ext.fields, o.fields...)
+						}
+					}
+				}
+			case ast.Union:
+				if s.chance(70) {
+					ext.members = []string{pick(s.tc, s.outputPool...)}
+				}
+			case ast.Enum:
+				if s.chance(70) {
+					ext.values = []string{s.pick("EXTRA", "RED", "Z")}
+				}
+			case ast.InputObject:
+				if s.chance(70) {
+					ext.fields = []sdlField{{name: s.pick("extra", "more", "z"), typ: s.typeRef(s.inputPool, 1)}}
+				}
+			}
+			emit(s.typeSrc(ext, true))
+		}
+	}
+	if s.chance(10) {
+		var sb strings.Builder
+		s.curType = "schema"
+		sb.WriteString("extend" + s.sep() + "schema" + s.appliedDirectives("SCHEMA", false))
+		if s.chance(70) {
+			// query is never added here: with no schema definition graphql-core keeps the
+			// inferred Query type as the root and graphql-js takes the extension's (not judged).
+			op := s.pick("mutation", "subscription")
+			if Known.duplicateRootOp && containsStr(ops, op) {
+				op = ""
+			}
+			if op != "" {
+				sb.WriteString(s.sep() + "{" + s.sep() + op + ": " + s.rootType() + s.sep() + "}")
+			}
+		}
+		emit(sb.String())
+	}
+	return b.String()
+}
+
+// rootType is a type name for a root operation: an object type while
+// Known.rootNotObject, anything in the output pool otherwise.
+// baseType strips list and non-null wrappers from a type reference.
+func baseType(t string) string { return strings.Trim(t, "[]!") }
+
+// reachesInput reports whether input object type from reaches type to
+// through input field types.
+func (s *sdlGen) reachesInput(from, to string, seen map[string]bool) bool {
+	if from == to {
+		return true
+	}
+	if seen[from] {
+		return false
+	}
+	seen[from] = true
+	d := s.byName[from]
+	if d == nil || d.kind != ast.InputObject {
+		return false
+	}
+	for _, f := range d.fields {
+		if s.reachesInput(baseType(f.typ), to, seen) {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *sdlGen) rootType() string {
+	if !Known.rootNotObject {
+		return pick(s.tc, s.outputPool...)
+	}
+	var objs []string
+	for _, t := range s.types {
+		if t.kind == ast.Object {
+			objs = append(objs, t.name)
+		}
+	}
+	if len(objs) == 0 {
+		return "Query"
+	}
+	return pick(s.tc, objs...)
+}
+
+func containsStr(xs []string, x string) bool {
+	for _, y := range xs {
+		if y == x {
+			return true
+		}
+	}
+	return false
+}
+
+// inherit copies the fields (and transitive interfaces) of t's interfaces
+// into t, mostly; occasionally it leaves one out.
+func (s *sdlGen) inherit(t *sdlType) {
+	seen := map[string]bool{}
+	for _, f := range t.fields {
+		seen[f.name] = true
+	}
+	for i := 0; i < len(t.interfaces); i++ {
+		in := s.byName[t.interfaces[i]]
+		if in == nil || in.kind != ast.Interface {
+			continue
+		}
+		for _, f := range in.fields {
+			if seen[f.name] {
+				continue
+			}
+			seen[f.name] = true
+			if s.chance(4) {
+				continue // missing field: invalid
+			}
+			nf := f
+			if s.chance(15) && !strings.HasSuffix(nf.typ, "!") {
+				nf.typ += "!" // covariant
+			}
+			if s.chance(4) {
+				nf.typ = s.pick("Int", "String!") // maybe incompatible
+			}
+			if s.chance(15) && len(nf.args) > 0 {
+				nf.args = nf.args[:len(nf.args)-1] // missing argument: invalid
+			}
+			if s.chance(15) {
+				nf.args = append(append([]sdlArg{}, nf.args...), sdlArg{name: "extra", typ: s.pick("Int", "Int!")}) // extra arg: valid only if nullable
+			}
+			t.fields = append(t.fields, nf)
+		}
+		for _, sup := range in.interfaces {
+			if sup == t.name && Known.selfInterface {
+				continue
+			}
+			if !containsStr(t.interfaces, sup) && !s.chance(5) {
+				t.interfaces = append(t.interfaces, sup)
+			}
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Type-directed queries against the validation schema.
+
+const valSchema = `
+schema { query: Query mutation: Mutation subscription: Subscription }
+scalar Date
+enum Color { RED GREEN BLUE @deprecated }
+interface Node { id: ID! }
+interface Named implements Node { id: ID! name: String }
+type User implements Node & Named {
+  id: ID!
+  name: String
+  age: Int
+  friends(first: Int = 10, after: ID): [User!]!
+  pet: Pet
+  color: Color
+  tags(prefix: String!): [String]
+}
+type Dog implements Node & Named { id: ID! name: String barks: Boolean! owner: User }
+type Cat implements Node { id: ID! name: String lives: Int }
+union Pet = Dog | Cat
+input Filter { name: String colors: [Color!] limit: Int = 5 nested: Filter date: Date }
+input Point { x: Float! y: Float! }
+type Query {
+  node(id: ID!): Node
+  user(id: ID, name: String): User
+  users(filter: Filter, ids: [ID!]): [User]
+  pets: [Pet!]
+  search(q: String!, point: Point, flag: Boolean = false, date: Date, f: Float, color: Color = RED): [Named]
+  version: String!
+}
+type Mutation { rename(id: ID!, name: String!): User setPoint(p: Point!): Boolean }
+type Subscription { userChanged(id: ID): User petAdded: Pet }
+directive @tag(name: String!) repeatable on FIELD | QUERY | FRAGMENT_SPREAD | INLINE_FRAGMENT
+directive @once on FIELD | FRAGMENT_DEFINITION | VARIABLE_DEFINITION
+`
+
+type qgen struct {
+	*gen
+	schema  *ast.Schema
+	vars    map[string]string // variable name -> type as used (first use wins)
+	frags   []string          // fragment definitions
+	nfrag   int
+	noAlias bool // no aliases (subscriptions while Known.subscriptionAliasCount)
+}
+
+func (q *qgen) def(name string) *ast.Definition { return q.schema.Types[name] }
+
+// literalFor is a literal of the given type; wrong is set for a deliberately
+// mistyped one.
+func (q *qgen) literalFor(t *ast.Type, depth int) string {
+	if q.chance(4) {
+		return q.anything(false) // anything at all
+	}
+	if !t.NonNull && q.chance(8) {
+		return "null"
+	}
+	if t.Elem != nil {
+		if q.chance(25) {
+			return q.literalFor(t.Elem, depth) // single value list coercion
+		}
+		k := q.n(0, 2)
+		parts := make([]string, k)
+		for i := range parts {
+			parts[i] = q.literalFor(t.Elem, depth-1)
+		}
+		return "[" + strings.Join(parts, ", ") + "]"
+	}
+	switch t.NamedType {
+	case "Int":
+		return q.pick("0", "1", "-5", "2147483647", "2147483648", "42", "1.0", `"1"`)
+	case "Float":
+		return q.pick("1.5", "0.0", "-2e3", "3", "1e308", `"1.5"`)
+	case "String":
+		return q.pick(`"s"`, `""`, `"\u00E9"`, `"""b"""`, "1", "RED")
+	case "Boolean":
+		return q.pick("true", "false", "1", `"true"`)
+	case "ID":
+		return q.pick(`"id1"`, "4", `""`, "1.5", "true")
+	case "Date":
+		return q.pick(`"2020-01-01"`, "1", "true", "[1]", "{a: 1}", "RED")
+	case "Color":
+		return q.pick("RED", "GREEN", "BLUE", "PURPLE", `"RED"`, "1")
+	}
+	d := q.def(t.NamedType)
+	if d == nil || d.Kind != ast.InputObject || depth <= 0 {
+		return q.anything(false)
+	}
+	var parts []string
+	for _, f := range d.Fields {
+		p := 50
+		if f.Type.NonNull && f.DefaultValue == nil {
+			p = 90
+		}
+		if q.chance(p) {
+			parts = append(parts, f.Name+": "+q.valueFor(f.Type, depth-1))
+		}
+	}
+	if q.chance(4) {
+		parts = append(parts, q.pick("zzz: 1", "x: 1", "name: 2"))
+	}
+	if q.chance(3) && len(parts) > 0 {
+		parts = append(parts, parts[0])
+	}
+	return "{" + strings.Join(parts, ", ") + "}"
+}
+
+var emptyObject = regexp.MustCompile(`\{[\s,]*\}`)
+
+// anything is an arbitrary value literal; while gqlparser lets {} pass for
+// a value of any type (gqlparser/21), one containing an empty object is
+// replaced.
+func (q *qgen) anything(allowVar bool) string {
+	v := q.value(1, allowVar)
+	if Known.emptyObjectValue && emptyObject.MatchString(v) {
+		return "1"
+	}
+	return v
+}
+
+// valueFor is a literal or a variable for the given type; variables are
+// declared (mostly correctly) at the end.
+func (q *qgen) valueFor(t *ast.Type, depth int) string {
+	if q.chance(20) {
+		nm := q.pick("v", "w", "x", "y")
+		if _, ok := q.vars[nm]; !ok {
+			decl := t.String()
+			switch {
+			case q.chance(8):
+				decl = strings.TrimSuffix(decl, "!") // maybe less strict: invalid if the position is non-null without default
+			case q.chance(8):
+				decl = q.pick("Int", "String!", "[Int]", "User", "Pet", "Color", "Boolean!")
+			case q.chance(10) && !strings.HasSuffix(decl, "!"):
+				decl += "!"
+			}
+			q.vars[nm] = decl
+		}
+		return "$" + nm
+	}
+	return q.literalFor(t, depth)
+}
+
+func (q *qgen) argsFor(args ast.ArgumentDefinitionList) string {
+	var parts []string
+	for _, a := range args {
+		p := 45
+		if a.Type.NonNull && a.DefaultValue == nil {
+			p = 92
+		}
+		if q.chance(p) {
+			parts = append(parts, a.Name+": "+q.valueFor(a.Type, 2))
+		}
+	}
+	if q.chance(3) {
+		parts = append(parts, q.pick("zzz", "id", "name", "first")+": "+q.anything(true))
+	}
+	if q.chance(3) && len(parts) > 0 {
+		parts = append(parts, parts[0])
+	}
+	if len(parts) == 0 {
+		return ""
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+func (q *qgen) fieldDirectives(loc string) string {
+	var b strings.Builder
+	if q.chance(12) {
+		b.WriteString(" @" + q.pick("skip", "include") + "(if: " + q.valueFor(ast.NonNullNamedType("Boolean", nil), 1) + ")")
+	}
+	if q.chance(6) {
+		b.WriteString(" @tag(name: " + q.pick(`"t"`, `"u"`, "1", "$v") + ")")
+		if q.chance(40) {
+			b.WriteString(" @tag(name: \"t2\")")
+		}
+	}
+	if q.chance(6) {
+		b.WriteString(" @once")
+		if q.chance(30) {
+			b.WriteString(" @once")
+		}
+	}
+	if q.chance(2) {
+		b.WriteString(" @" + q.pick("deprecated", "specifiedBy(url: \"u\")", "unknown", "skip", "include(if: true, if: false)", "tag"))
+	}
+	_ = loc
+	return b.String()
+}
+
+func (q *qgen) selectionFor(d *ast.Definition, depth int) string {
+	var b strings.Builder
+	b.WriteString("{")
+	k := q.n(1, 3)
+	if q.chance(2) {
+		k = 0 // empty selection set: a parse error
+	}
+	for i := 0; i < k; i++ {
+		b.WriteString(" ")
+		b.WriteString(q.oneSelection(d, depth))
+	}
+	b.WriteString(" }")
+	return b.String()
+}
+
+func (q *qgen) oneSelection(d *ast.Definition, depth int) string {
+	// Abstract types: inline fragments and spreads more often.
+	r := q.n(1, 100)
+	switch {
+	case r <= 12 && depth > 0:
+		// inline fragment
+		on := ""
+		if q.chance(80) {
+			on = q.possibleType(d)
+		}
+		target := d
+		if on != "" {
+			if t := q.def(on); t != nil {
+				target = t
+			}
+			on = " on " + on
+		}
+		return "..." + on + q.fieldDirectives("INLINE_FRAGMENT") + " " + q.selectionFor(target, depth-1)
+	case r <= 20 && depth > 0:
+		// fragment spread
+		on := q.possibleType(d)
+		target := q.def(on)
+		if target == nil {
+			target = d
+		}
+		q.nfrag++
+		name := q.pick("F", "G", "H") + string(rune('0'+q.nfrag%10))
+		body := q.selectionFor(target, depth-1)
+		if q.chance(3) {
+			body = "{ ..." + name + " }" // a cycle
+		}
+		if !q.chance(4) {
+			q.frags = append(q.frags, "fragment "+name+" on "+on+q.fragDirectives()+" "+body)
+		}
+		return "..." + name + q.fieldDirectives("FRAGMENT_SPREAD")
+	case r <= 24:
+		return "__typename" + q.fieldDirectives("FIELD")
+	}
+	if len(d.Fields) == 0 || d.Kind == ast.Union {
+		if q.chance(50) {
+			return "__typename"
+		}
+		return q.pick("name", "id", "x")
+	}
+	f := d.Fields[q.n(0, len(d.Fields)-1)]
+	if strings.HasPrefix(f.Name, "__") && !q.chance(5) {
+		f = d.Fields[0]
+	}
+	var b strings.Builder
+	if q.chance(12) && !q.noAlias {
+		b.WriteString(q.pick("alias", "a", "name", "id", f.Name) + ": ")
+	}
+	name := f.Name
+	if q.chance(3) {
+		name = q.pick("bogus", "nam", "Name", "ids")
+	}
+	b.WriteString(name)
+	b.WriteString(q.argsFor(f.Arguments))
+	b.WriteString(q.fieldDirectives("FIELD"))
+	ft := q.def(f.Type.Name())
+	if ft != nil && ft.IsCompositeType() {
+		if q.chance(96) {
+			b.WriteString(" ")
+			if depth > 0 {
+				b.WriteString(q.selectionFor(ft, depth-1))
+			} else {
+				b.WriteString(q.pick("{ __typename }", "{ id }", "{ name }"))
+			}
+		}
+	} else if ft != nil && q.chance(3) {
+		b.WriteString(" { x }")
+	}
+	return b.String()
+}
+
+func (q *qgen) fragDirectives() string {
+	if q.chance(10) {
+		return " @once"
+	}
+	if q.chance(3) {
+		return q.pick(" @tag(name: \"x\")", " @skip(if: true)", " @once @once")
+	}
+	return ""
+}
+
+// possibleType is a type name that may (or, sometimes, may not) be a
+// possible type of d.
+func (q *qgen) possibleType(d *ast.Definition) string {
+	if q.chance(12) {
+		return q.pick("User", "Dog", "Cat", "Pet", "Node", "Named", "Query", "Color", "Filter", "String", "Nope")
+	}
+	switch d.Kind {
+	case ast.Object:
+		if q.chance(60) {
+			return d.Name
+		}
+		for _, in := range q.schema.Implements[d.Name] {
+			if q.chance(50) {
+				return in.Name
+			}
+		}
+		return d.Name
+	case ast.Interface, ast.Union:
+		pt := q.schema.PossibleTypes[d.Name]
+		if len(pt) > 0 && q.chance(70) {
+			return pt[q.n(0, len(pt)-1)].Name
+		}
+		if q.chance(50) {
+			return d.Name
+		}
+		return q.pick("Node", "Named", "Pet")
+	}
+	return d.Name
+}
+
+func (q *qgen) operationSrc() string {
+	var b strings.Builder
+	op := q.pick("query", "query", "query", "mutation", "subscription")
+	root := q.schema.Query
+	switch op {
+	case "mutation":
+		root = q.schema.Mutation
+	case "subscription":
+		root = q.schema.Subscription
+	}
+	q.vars = map[string]string{}
+	q.noAlias = op == "subscription" && Known.subscriptionAliasCount
+	body := q.selectionFor(root, 3)
+	if op == "subscription" && q.chance(30) {
+		body = "{ userChanged { id } petAdded { __typename } }"
+	}
+	if q.chance(2) {
+		body = "{ __schema { types { name fields { type { fields { type { fields { type { name } } } } } } } } }"
+	}
+	if q.chance(20) && op == "query" && len(q.vars) == 0 {
+		return body
+	}
+	b.WriteString(op)
+	if q.chance(75) {
+		b.WriteString(" " + q.pick("Q", "Op", "q1", "Q"))
+	}
+	if q.chance(4) {
+		q.vars["unused"] = "Int"
+	}
+	if q.chance(4) && len(q.vars) > 0 {
+		for _, k := range []string{"v", "w", "x", "y"} {
+			if _, ok := q.vars[k]; ok {
+				delete(q.vars, k) // undeclared variable
+				break
+			}
+		}
+	}
+	if len(q.vars) > 0 {
+		var parts []string
+		for _, nm := range []string{"v", "w", "x", "y", "unused"} {
+			t, ok := q.vars[nm]
+			if !ok {
+				continue
+			}
+			if q.chance(3) {
+				t = q.pick("Nope", "[Nope!]", "Query", "Pet")
+			}
+			p := "$" + nm + ": " + t
+			if q.chance(25) {
+				ty := q.parseType(t)
+				if ty != nil {
+					p += " = " + q.literalFor(ty, 1)
+				}
+			}
+			if q.chance(8) {
+				p += " @once"
+			}
+			if q.chance(3) {
+				p += q.pick(" @tag(name: \"v\")", " @skip(if: true)", " @once @once", " @deprecated")
+			}
+			parts = append(parts, p)
+		}
+		if q.chance(3) && len(parts) > 0 {
+			parts = append(parts, parts[0])
+		}
+		b.WriteString("(" + strings.Join(parts, ", ") + ")")
+	}
+	if q.chance(8) {
+		b.WriteString(" @tag(name: \"op\")")
+	}
+	if q.chance(3) {
+		b.WriteString(q.pick(" @once", " @deprecated", " @skip(if: true)", " @tag(name: \"a\") @tag(name: \"b\")"))
+	}
+	b.WriteString(" " + body)
+	return b.String()
+}
+
+func (q *qgen) parseType(s string) *ast.Type {
+	s = strings.TrimSpace(s)
+	nonNull := strings.HasSuffix(s, "!")
+	s = strings.TrimSuffix(s, "!")
+	if strings.HasPrefix(s, "[") && strings.HasSuffix(s, "]") {
+		inner := q.parseType(s[1 : len(s)-1])
+		if inner == nil {
+			return nil
+		}
+		return &ast.Type{Elem: inner, NonNull: nonNull}
+	}
+	return &ast.Type{NamedType: s, NonNull: nonNull}
+}
+
+// validationQuery is an executable document against valSchema.
+func (g *gen) validationQuery(schema *ast.Schema) string {
+	q := &qgen{gen: g, schema: schema}
+	var parts []string
+	parts = append(parts, q.operationSrc())
+	if q.chance(12) {
+		parts = append(parts, q.operationSrc())
+	}
+	if q.chance(4) {
+		parts = append(parts, "fragment Unused on User { id }")
+	}
+	parts = append(parts, q.frags...)
+	return strings.Join(parts, "\n")
+}
