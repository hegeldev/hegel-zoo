+package geom_test
+
+// Random geometries, structural equality, and model encoders (WKT text, WKB
+// and EWKB bytes, GeoJSON) written from the specifications.
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"strconv"
+	"strings"
+
+	geom "github.com/twpayne/go-geom"
+	"hegel.dev/go/hegel"
+)
+
+var layouts = []geom.Layout{geom.XY, geom.XYZ, geom.XYM, geom.XYZM}
+
+// genOpts tunes the geometry generator.
+type genOpts struct {
+	emptyPoints   bool // empty Points and empty MultiPoint members
+	emptyMembers  bool // empty LineStrings/Polygons inside multi-geometries and empty rings
+	shortLines    bool // 1-point LineStrings, rings with fewer than 4 points or not closed
+	wildFloats    bool // NaN, infinities, -0, huge and tiny magnitudes
+	collections   bool // GeometryCollections (nested)
+	mixedLayouts  bool // GeometryCollections whose members have different layouts
+	srid          bool // a non-zero SRID
+	maxDepth      int
+	intCoordsOnly bool // small integer coordinates (exact arithmetic)
+}
+
+var coordPool = []float64{
+	0, 1, -1, 2, 3, -2, 5, 10, 100, 0.5, -0.5, 2.5, -3.25, 0.1, 0.25, 1e6, 123456.789, 7.5e-3, 42, -17, 1e-7, 0.001, 1e15,
+}
+
+func genCoordValue(tc hegel.TestCase, o genOpts) float64 {
+	if o.intCoordsOnly {
+		return float64(n(tc, -12, 12))
+	}
+	if o.wildFloats && chance(tc, 8) {
+		return pick(tc, math.NaN(), math.Inf(1), math.Inf(-1), math.Copysign(0, -1), 1e300, -1e300, 5e-324, math.MaxFloat64, 4.9e-324)
+	}
+	if chance(tc, 15) {
+		x := math.Float64frombits(uint64(n(tc, 0, 1<<30))<<33 | uint64(n(tc, 0, 1<<30)))
+		if !math.IsNaN(x) && !math.IsInf(x, 0) {
+			return x
+		}
+	}
+	return pick(tc, coordPool...)
+}
+
+func genCoord(tc hegel.TestCase, l geom.Layout, o genOpts) geom.Coord {
+	c := make(geom.Coord, l.Stride())
+	for i := range c {
+		c[i] = genCoordValue(tc, o)
+	}
+	return c
+}
+
+func genCoords(tc hegel.TestCase, l geom.Layout, o genOpts, lo, hi int) []geom.Coord {
+	var cs []geom.Coord
+	for i := n(tc, lo, hi); i > 0; i-- {
+		cs = append(cs, genCoord(tc, l, o))
+	}
+	return cs
+}
+
+// genRing returns a closed ring of at least 4 points (unless shortLines).
+func genRing(tc hegel.TestCase, l geom.Layout, o genOpts) []geom.Coord {
+	if o.shortLines && chance(tc, 15) {
+		return genCoords(tc, l, o, 0, 3)
+	}
+	cs := genCoords(tc, l, o, 3, 6)
+	if o.shortLines && chance(tc, 20) {
+		return append(cs, genCoord(tc, l, o)) // not closed
+	}
+	return append(cs, cs[0].Clone())
+}
+
+func genLine(tc hegel.TestCase, l geom.Layout, o genOpts) []geom.Coord {
+	if o.shortLines && chance(tc, 15) {
+		return genCoords(tc, l, o, 1, 1)
+	}
+	if o.emptyMembers && chance(tc, 15) {
+		return nil
+	}
+	return genCoords(tc, l, o, 2, 5)
+}
+
+func genPolygonCoords(tc hegel.TestCase, l geom.Layout, o genOpts) [][]geom.Coord {
+	if o.emptyMembers && chance(tc, 15) {
+		return nil
+	}
+	var rings [][]geom.Coord
+	for i := n(tc, 1, 3); i > 0; i-- {
+		rings = append(rings, genRing(tc, l, o))
+	}
+	return rings
+}
+
+// genGeom returns a random geometry of the given layout.
+func genGeom(tc hegel.TestCase, l geom.Layout, o genOpts, depth int) geom.T {
+	kinds := []string{"Point", "LineString", "Polygon", "MultiPoint", "MultiLineString", "MultiPolygon"}
+	if o.collections && depth < o.maxDepth {
+		kinds = append(kinds, "GeometryCollection", "GeometryCollection")
+	}
+	var g geom.T
+	switch pick(tc, kinds...) {
+	case "Point":
+		if o.emptyPoints && chance(tc, 15) {
+			g = geom.NewPointEmpty(l)
+		} else {
+			g = geom.NewPoint(l).MustSetCoords(genCoord(tc, l, o))
+		}
+	case "LineString":
+		g = geom.NewLineString(l).MustSetCoords(genLine(tc, l, o))
+	case "Polygon":
+		g = geom.NewPolygon(l).MustSetCoords(genPolygonCoords(tc, l, o))
+	case "MultiPoint":
+		var cs []geom.Coord
+		for i := n(tc, 0, 4); i > 0; i-- {
+			if o.emptyPoints && chance(tc, 20) {
+				cs = append(cs, nil)
+			} else {
+				cs = append(cs, genCoord(tc, l, o))
+			}
+		}
+		g = geom.NewMultiPoint(l).MustSetCoords(cs)
+	case "MultiLineString":
+		var ls [][]geom.Coord
+		for i := n(tc, 0, 3); i > 0; i-- {
+			ls = append(ls, genLine(tc, l, o))
+		}
+		g = geom.NewMultiLineString(l).MustSetCoords(ls)
+	case "MultiPolygon":
+		var ps [][][]geom.Coord
+		for i := n(tc, 0, 3); i > 0; i-- {
+			ps = append(ps, genPolygonCoords(tc, l, o))
+		}
+		g = geom.NewMultiPolygon(l).MustSetCoords(ps)
+	default:
+		gc := geom.NewGeometryCollection()
+		for i := n(tc, 0, 3); i > 0; i-- {
+			ml := l
+			if o.mixedLayouts && chance(tc, 30) {
+				ml = pick(tc, layouts...)
+			}
+			gc.MustPush(genGeom(tc, ml, o, depth+1))
+		}
+		if gc.NumGeoms() == 0 && chance(tc, 50) {
+			gc.MustSetLayout(l)
+		}
+		g = gc
+	}
+	if o.srid && chance(tc, 40) {
+		g, _ = geom.SetSRID(g, pick(tc, 4326, 3857, 1, 900913, 32633))
+	}
+	return g
+}
+
+// ---------------------------------------------------------------------------
+// Structural equality and description.
+
+func bitsEqual(a, b []float64) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if math.Float64bits(a[i]) != math.Float64bits(b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func intsEqual(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// geomDiff returns "" when a and b are the same geometry (type, layout, SRID,
+// coordinates bit for bit, structure), else a description of the difference.
+func geomDiff(a, b geom.T, path string) string {
+	if isNil(a) || isNil(b) {
+		if isNil(a) && isNil(b) {
+			return ""
+		}
+		return fmt.Sprintf("%s: one side is nil (%T vs %T)", path, a, b)
+	}
+	if fmt.Sprintf("%T", a) != fmt.Sprintf("%T", b) {
+		return fmt.Sprintf("%s: type %T vs %T", path, a, b)
+	}
+	if a.Layout() != b.Layout() {
+		return fmt.Sprintf("%s: layout %s vs %s", path, a.Layout(), b.Layout())
+	}
+	if a.SRID() != b.SRID() {
+		return fmt.Sprintf("%s: SRID %d vs %d", path, a.SRID(), b.SRID())
+	}
+	if ga, ok := a.(*geom.GeometryCollection); ok {
+		gb := b.(*geom.GeometryCollection)
+		if ga.NumGeoms() != gb.NumGeoms() {
+			return fmt.Sprintf("%s: %d vs %d members", path, ga.NumGeoms(), gb.NumGeoms())
+		}
+		for i := range ga.Geoms() {
+			if d := geomDiff(ga.Geom(i), gb.Geom(i), fmt.Sprintf("%s[%d]", path, i)); d != "" {
+				return d
+			}
+		}
+		return ""
+	}
+	if !bitsEqual(a.FlatCoords(), b.FlatCoords()) {
+		return fmt.Sprintf("%s: coords %v vs %v", path, a.FlatCoords(), b.FlatCoords())
+	}
+	if !intsEqual(a.Ends(), b.Ends()) {
+		return fmt.Sprintf("%s: ends %v vs %v", path, a.Ends(), b.Ends())
+	}
+	ea, eb := a.Endss(), b.Endss()
+	if len(ea) != len(eb) {
+		return fmt.Sprintf("%s: endss %v vs %v", path, ea, eb)
+	}
+	for i := range ea {
+		if !intsEqual(ea[i], eb[i]) {
+			return fmt.Sprintf("%s: endss %v vs %v", path, ea, eb)
+		}
+	}
+	return ""
+}
+
+// isNil reports a nil interface or a typed nil pointer.
+func isNil(g geom.T) bool {
+	if g == nil {
+		return true
+	}
+	v := reflect.ValueOf(g)
+	return v.Kind() == reflect.Pointer && v.IsNil()
+}
+
+// describe renders a geometry for messages.
+func describe(g geom.T) string {
+	if isNil(g) {
+		return fmt.Sprintf("<nil %T>", g)
+	}
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		var parts []string
+		for _, m := range gc.Geoms() {
+			parts = append(parts, describe(m))
+		}
+		return fmt.Sprintf("GC{layout=%s srid=%d [%s]}", gc.Layout(), gc.SRID(), strings.Join(parts, ", "))
+	}
+	s := fmt.Sprintf("%T{layout=%s srid=%d coords=%v", g, g.Layout(), g.SRID(), g.FlatCoords())
+	if e := g.Ends(); e != nil {
+		s += fmt.Sprintf(" ends=%v", e)
+	}
+	if e := g.Endss(); e != nil {
+		s += fmt.Sprintf(" endss=%v", e)
+	}
+	return s + "}"
+}
+
+// clone deep-copies a geometry through its coordinates (independent of the
+// library's Clone).
+func clone(g geom.T) geom.T {
+	switch g := g.(type) {
+	case *geom.Point:
+		if g.Empty() {
+			return geom.NewPointEmpty(g.Layout()).SetSRID(g.SRID())
+		}
+		return geom.NewPointFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...)).SetSRID(g.SRID())
+	case *geom.LineString:
+		return geom.NewLineStringFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...)).SetSRID(g.SRID())
+	case *geom.LinearRing:
+		return geom.NewLinearRingFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...)).SetSRID(g.SRID())
+	case *geom.Polygon:
+		return geom.NewPolygonFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...), append([]int(nil), g.Ends()...)).SetSRID(g.SRID())
+	case *geom.MultiPoint:
+		return geom.NewMultiPointFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...), geom.NewMultiPointFlatOptionWithEnds(append([]int(nil), g.Ends()...))).SetSRID(g.SRID())
+	case *geom.MultiLineString:
+		return geom.NewMultiLineStringFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...), append([]int(nil), g.Ends()...)).SetSRID(g.SRID())
+	case *geom.MultiPolygon:
+		var endss [][]int
+		for _, e := range g.Endss() {
+			endss = append(endss, append([]int(nil), e...))
+		}
+		return geom.NewMultiPolygonFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...), endss).SetSRID(g.SRID())
+	case *geom.GeometryCollection:
+		gc := geom.NewGeometryCollection().SetSRID(g.SRID())
+		for _, m := range g.Geoms() {
+			gc.MustPush(clone(m))
+		}
+		if g.NumGeoms() == 0 {
+			gc.MustSetLayout(g.Layout())
+		}
+		return gc
+	}
+	panic(fmt.Sprintf("clone: %T", g))
+}
+
+// normalizeNoLayout returns a copy of g in which empty collections without a
+// layout have layout XY: no codec can carry NoLayout, an empty collection
+// reads back as XY (WKB/EWKB, where every member carries its own type).
+func normalizeNoLayout(g geom.T) geom.T { return normalizeNoLayoutTo(g, geom.XY, false) }
+
+// normalizeNoLayoutWKT is the WKT reading: an EMPTY member without a layout
+// suffix takes the enclosing collection's layout, XY at the top.
+func normalizeNoLayoutWKT(g geom.T) geom.T { return normalizeNoLayoutTo(g, geom.XY, true) }
+
+func normalizeNoLayoutTo(g geom.T, l geom.Layout, inherit bool) geom.T {
+	var fix func(geom.T, geom.Layout) geom.T
+	fix = func(g geom.T, l geom.Layout) geom.T {
+		if gc, ok := g.(*geom.GeometryCollection); ok {
+			if gc.NumGeoms() == 0 {
+				layout := gc.Layout()
+				if layout == geom.NoLayout || (inherit && layout == geom.XY) {
+					layout = l
+				}
+				return geom.NewGeometryCollection().MustSetLayout(layout).SetSRID(gc.SRID())
+			}
+			ml := geom.XY
+			if inherit && gc.Layout() != geom.NoLayout {
+				ml = gc.Layout()
+			}
+			if inherit && gc.Layout() == geom.NoLayout {
+				ml = l
+			}
+			out := geom.NewGeometryCollection().SetSRID(gc.SRID())
+			for _, m := range gc.Geoms() {
+				out.MustPush(fix(m, ml))
+			}
+			return out
+		}
+		// in WKT an EMPTY member without a Z/M suffix takes the collection's layout
+		if inherit && g.Empty() && g.Layout() == geom.XY && l != geom.XY {
+			return withLayout(g, l)
+		}
+		return clone(g)
+	}
+	return fix(g, l)
+}
+
+// withLayout returns an empty geometry of g's type and SRID with layout l.
+func withLayout(g geom.T, l geom.Layout) geom.T {
+	var out geom.T
+	switch g := g.(type) {
+	case *geom.Point:
+		out = geom.NewPointEmpty(l)
+	case *geom.LineString:
+		out = geom.NewLineString(l)
+	case *geom.Polygon:
+		out = geom.NewPolygonFlat(l, nil, g.Ends())
+	case *geom.MultiPoint:
+		out = geom.NewMultiPointFlat(l, nil, geom.NewMultiPointFlatOptionWithEnds(g.Ends()))
+	case *geom.MultiLineString:
+		out = geom.NewMultiLineStringFlat(l, nil, g.Ends())
+	case *geom.MultiPolygon:
+		out = geom.NewMultiPolygonFlat(l, nil, g.Endss())
+	default:
+		panic(fmt.Sprintf("withLayout: %T", g))
+	}
+	out, _ = geom.SetSRID(out, g.SRID())
+	return out
+}
+
+// hasEmptyFirstMember reports a MultiLineString or MultiPolygon (anywhere in
+// g) whose first member is empty while its layout is not XY.
+func hasEmptyFirstMember(g geom.T) bool {
+	switch g := g.(type) {
+	case *geom.MultiLineString:
+		return g.Layout() != geom.XY && g.NumLineStrings() > 0 && g.Ends()[0] == 0
+	case *geom.MultiPolygon:
+		if g.Layout() == geom.XY || g.NumPolygons() == 0 {
+			return false
+		}
+		e := g.Endss()[0]
+		return len(e) == 0 || e[len(e)-1] == 0
+	case *geom.GeometryCollection:
+		for _, m := range g.Geoms() {
+			if hasEmptyFirstMember(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasNestedCollection reports a GeometryCollection member that is itself a
+// collection.
+func hasNestedCollection(g geom.T) bool {
+	gc, ok := g.(*geom.GeometryCollection)
+	if !ok {
+		return false
+	}
+	for _, m := range gc.Geoms() {
+		if _, ok := m.(*geom.GeometryCollection); ok {
+			return true
+		}
+	}
+	return false
+}
+
+// hasMixedLayouts reports a collection (anywhere in g) with a non-empty
+// member whose layout differs from the collection's.
+func hasMixedLayouts(g geom.T) bool {
+	gc, ok := g.(*geom.GeometryCollection)
+	if !ok {
+		return false
+	}
+	for _, m := range gc.Geoms() {
+		// an empty member without a suffix (XY or no layout) is written as a
+		// bare EMPTY, which the parser accepts in any collection
+		if m.Layout() != gc.Layout() && !(m.Empty() && (m.Layout() == geom.XY || m.Layout() == geom.NoLayout)) {
+			return true
+		}
+		if hasMixedLayouts(m) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasEmptyMultiPointMember reports a MultiPoint with an empty member anywhere in g.
+func hasEmptyMultiPointMember(g geom.T) bool {
+	switch g := g.(type) {
+	case *geom.MultiPoint:
+		for i := range g.NumPoints() {
+			if g.Coord(i) == nil {
+				return true
+			}
+		}
+	case *geom.GeometryCollection:
+		for _, m := range g.Geoms() {
+			if hasEmptyMultiPointMember(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasWild reports NaN or infinite coordinates anywhere in g.
+func hasWild(g geom.T) bool {
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		for _, m := range gc.Geoms() {
+			if hasWild(m) {
+				return true
+			}
+		}
+		return false
+	}
+	for _, x := range g.FlatCoords() {
+		if math.IsNaN(x) || math.IsInf(x, 0) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Model WKT.
+
+func fmtCoord(x float64) string { return strconv.FormatFloat(x, 'f', -1, 64) }
+
+func modelCoord(c []float64) string {
+	parts := make([]string, len(c))
+	for i, x := range c {
+		parts[i] = fmtCoord(x)
+	}
+	return strings.Join(parts, " ")
+}
+
+func modelCoordList(flat []float64, stride int) string {
+	var parts []string
+	for i := 0; i+stride <= len(flat); i += stride {
+		parts = append(parts, modelCoord(flat[i:i+stride]))
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+func modelRings(flat []float64, start int, ends []int, stride int) string {
+	var parts []string
+	for _, end := range ends {
+		if end <= start {
+			parts = append(parts, "EMPTY")
+		} else {
+			parts = append(parts, modelCoordList(flat[start:end], stride))
+		}
+		start = end
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+func layoutSuffix(l geom.Layout) string {
+	switch l {
+	case geom.XYZ:
+		return "Z "
+	case geom.XYM:
+		return "M "
+	case geom.XYZM:
+		return "ZM "
+	}
+	return ""
+}
+
+// modelWKT writes the WKT of g in the library's canonical spacing
+// ("POINT Z (1 2 3)", members separated by ", ", "EMPTY" for empties).
+func modelWKT(g geom.T) string {
+	l := g.Layout()
+	stride := l.Stride()
+	switch g := g.(type) {
+	case *geom.Point:
+		if g.Empty() {
+			return "POINT " + layoutSuffix(l) + "EMPTY"
+		}
+		return "POINT " + layoutSuffix(l) + "(" + modelCoord(g.FlatCoords()) + ")"
+	case *geom.LineString:
+		if g.Empty() {
+			return "LINESTRING " + layoutSuffix(l) + "EMPTY"
+		}
+		return "LINESTRING " + layoutSuffix(l) + modelCoordList(g.FlatCoords(), stride)
+	case *geom.Polygon:
+		if g.NumLinearRings() == 0 {
+			return "POLYGON " + layoutSuffix(l) + "EMPTY"
+		}
+		return "POLYGON " + layoutSuffix(l) + modelRings(g.FlatCoords(), 0, g.Ends(), stride)
+	case *geom.MultiPoint:
+		if g.NumPoints() == 0 {
+			return "MULTIPOINT " + layoutSuffix(l) + "EMPTY"
+		}
+		var parts []string
+		start := 0
+		for _, end := range g.Ends() {
+			if end <= start {
+				parts = append(parts, "EMPTY")
+			} else {
+				parts = append(parts, modelCoord(g.FlatCoords()[start:end]))
+			}
+			start = end
+		}
+		return "MULTIPOINT " + layoutSuffix(l) + "(" + strings.Join(parts, ", ") + ")"
+	case *geom.MultiLineString:
+		if g.NumLineStrings() == 0 {
+			return "MULTILINESTRING " + layoutSuffix(l) + "EMPTY"
+		}
+		return "MULTILINESTRING " + layoutSuffix(l) + modelRings(g.FlatCoords(), 0, g.Ends(), stride)
+	case *geom.MultiPolygon:
+		if g.NumPolygons() == 0 {
+			return "MULTIPOLYGON " + layoutSuffix(l) + "EMPTY"
+		}
+		var parts []string
+		start := 0
+		for _, ends := range g.Endss() {
+			if len(ends) == 0 {
+				parts = append(parts, "EMPTY")
+			} else {
+				parts = append(parts, modelRings(g.FlatCoords(), start, ends, stride))
+				start = ends[len(ends)-1]
+			}
+		}
+		return "MULTIPOLYGON " + layoutSuffix(l) + "(" + strings.Join(parts, ", ") + ")"
+	case *geom.GeometryCollection:
+		if g.NumGeoms() == 0 {
+			return "GEOMETRYCOLLECTION " + layoutSuffix(l) + "EMPTY"
+		}
+		var parts []string
+		for _, m := range g.Geoms() {
+			parts = append(parts, modelWKT(m))
+		}
+		return "GEOMETRYCOLLECTION " + layoutSuffix(l) + "(" + strings.Join(parts, ", ") + ")"
+	}
+	panic(fmt.Sprintf("modelWKT: %T", g))
+}
+
+// mutateWKT rewrites a canonical WKT into an equivalent text: lower case,
+// keyword suffix without the space ("POINTZ"), extra whitespace and
+// newlines, numbers with exponents or trailing zeros.
+func mutateWKT(tc hegel.TestCase, s string) string {
+	var sb strings.Builder
+	i := 0
+	for i < len(s) {
+		c := s[i]
+		switch {
+		case c >= 'A' && c <= 'Z':
+			j := i
+			for j < len(s) && s[j] >= 'A' && s[j] <= 'Z' {
+				j++
+			}
+			word := s[i:j]
+			if chance(tc, 30) {
+				word = strings.ToLower(word)
+			} else if chance(tc, 20) {
+				word = strings.Title(strings.ToLower(word))
+			}
+			sb.WriteString(word)
+			i = j
+		case c == ' ':
+			// "POINT Z" -> "POINTZ" when the next word is a suffix
+			rest := s[i+1:]
+			if (strings.HasPrefix(rest, "Z ") || strings.HasPrefix(rest, "M ") || strings.HasPrefix(rest, "ZM ")) && i > 0 && s[i-1] >= 'A' && s[i-1] <= 'Z' && chance(tc, 50) {
+				i++
+				continue
+			}
+			switch n(tc, 0, 5) {
+			case 0:
+				sb.WriteString("  ")
+			case 1:
+				sb.WriteString("\n")
+			case 2:
+				sb.WriteString(" \t ")
+			default:
+				sb.WriteByte(' ')
+			}
+			i++
+		case c == '(' || c == ')' || c == ',':
+			if chance(tc, 20) {
+				sb.WriteByte(' ')
+			}
+			sb.WriteByte(c)
+			if chance(tc, 20) {
+				sb.WriteByte(' ')
+			}
+			i++
+		case c == '-' || c == '.' || (c >= '0' && c <= '9'):
+			j := i
+			for j < len(s) && (s[j] == '-' || s[j] == '.' || (s[j] >= '0' && s[j] <= '9')) {
+				j++
+			}
+			num := s[i:j]
+			if f, err := strconv.ParseFloat(num, 64); err == nil {
+				switch n(tc, 0, 4) {
+				case 0:
+					num = strconv.FormatFloat(f, 'e', -1, 64)
+				case 1:
+					num = strconv.FormatFloat(f, 'E', -1, 64)
+				case 2:
+					if !strings.Contains(num, ".") && !strings.Contains(num, "e") {
+						num += ".0"
+					}
+				case 3:
+					if strings.Contains(num, ".") {
+						num += "00"
+					}
+				}
+			}
+			sb.WriteString(num)
+			i = j
+		default:
+			sb.WriteByte(c)
+			i++
+		}
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------------------
+// Model WKB / EWKB.
+
+func wkbTypeID(g geom.T) uint32 {
+	switch g.(type) {
+	case *geom.Point:
+		return 1
+	case *geom.LineString:
+		return 2
+	case *geom.Polygon:
+		return 3
+	case *geom.MultiPoint:
+		return 4
+	case *geom.MultiLineString:
+		return 5
+	case *geom.MultiPolygon:
+		return 6
+	case *geom.GeometryCollection:
+		return 7
+	}
+	panic(fmt.Sprintf("wkbTypeID: %T", g))
+}
+
+type wkbWriter struct {
+	buf  []byte
+	bo   binary.ByteOrder
+	ewkb bool
+}
+
+func (w *wkbWriter) u32(v uint32) {
+	var b [4]byte
+	w.bo.PutUint32(b[:], v)
+	w.buf = append(w.buf, b[:]...)
+}
+
+func (w *wkbWriter) f64(v float64) {
+	var b [8]byte
+	w.bo.PutUint64(b[:], math.Float64bits(v))
+	w.buf = append(w.buf, b[:]...)
+}
+
+func (w *wkbWriter) coords(flat []float64) {
+	for _, x := range flat {
+		w.f64(x)
+	}
+}
+
+func (w *wkbWriter) header(g geom.T) {
+	if w.bo == binary.BigEndian {
+		w.buf = append(w.buf, 0)
+	} else {
+		w.buf = append(w.buf, 1)
+	}
+	t := wkbTypeID(g)
+	l := g.Layout()
+	if w.ewkb {
+		switch l {
+		case geom.XYZ:
+			t |= 0x80000000
+		case geom.XYM:
+			t |= 0x40000000
+		case geom.XYZM:
+			t |= 0xC0000000
+		}
+		if g.SRID() != 0 {
+			t |= 0x20000000
+		}
+		w.u32(t)
+		if g.SRID() != 0 {
+			w.u32(uint32(g.SRID()))
+		}
+		return
+	}
+	switch l {
+	case geom.XYZ:
+		t += 1000
+	case geom.XYM:
+		t += 2000
+	case geom.XYZM:
+		t += 3000
+	}
+	w.u32(t)
+}
+
+// write appends the (E)WKB of g. Empty points are written as NaN
+// coordinates (the EWKB convention, and the library's option for WKB).
+func (w *wkbWriter) write(g geom.T) {
+	w.header(g)
+	stride := g.Layout().Stride()
+	switch g := g.(type) {
+	case *geom.Point:
+		if g.Empty() {
+			for i := 0; i < stride; i++ {
+				w.f64(geom.PointEmptyCoord())
+			}
+		} else {
+			w.coords(g.FlatCoords())
+		}
+	case *geom.LineString:
+		w.u32(uint32(g.NumCoords()))
+		w.coords(g.FlatCoords())
+	case *geom.Polygon:
+		w.u32(uint32(g.NumLinearRings()))
+		start := 0
+		for _, end := range g.Ends() {
+			w.u32(uint32((end - start) / stride))
+			w.coords(g.FlatCoords()[start:end])
+			start = end
+		}
+	case *geom.MultiPoint:
+		w.u32(uint32(g.NumPoints()))
+		for i := range g.NumPoints() {
+			p := g.Point(i) // member SRID is not carried
+			w.write(p)
+		}
+	case *geom.MultiLineString:
+		w.u32(uint32(g.NumLineStrings()))
+		for i := range g.NumLineStrings() {
+			w.write(g.LineString(i))
+		}
+	case *geom.MultiPolygon:
+		w.u32(uint32(g.NumPolygons()))
+		for i := range g.NumPolygons() {
+			w.write(g.Polygon(i))
+		}
+	case *geom.GeometryCollection:
+		w.u32(uint32(g.NumGeoms()))
+		for _, m := range g.Geoms() {
+			w.write(m)
+		}
+	}
+}
+
+func modelWKB(g geom.T, bo binary.ByteOrder, ewkb bool) []byte {
+	w := &wkbWriter{bo: bo, ewkb: ewkb}
+	w.write(g)
+	return w.buf
+}
+
+// ---------------------------------------------------------------------------
+// Model GeoJSON.
+
+func jsonCoord(c []float64) any {
+	out := make([]any, len(c))
+	for i, x := range c {
+		out[i] = x
+	}
+	return out
+}
+
+func jsonCoords1(flat []float64, stride int) []any {
+	out := []any{}
+	for i := 0; i+stride <= len(flat); i += stride {
+		out = append(out, jsonCoord(flat[i:i+stride]))
+	}
+	return out
+}
+
+func jsonCoords2(flat []float64, start int, ends []int, stride int) []any {
+	out := []any{}
+	for _, end := range ends {
+		out = append(out, jsonCoords1(flat[start:end], stride))
+		start = end
+	}
+	return out
+}
+
+// modelGeoJSON is the GeoJSON object for g (RFC 7946 structure; empty
+// geometries have empty coordinate arrays).
+func modelGeoJSON(g geom.T) map[string]any {
+	stride := g.Layout().Stride()
+	switch g := g.(type) {
+	case *geom.Point:
+		if g.Empty() {
+			return map[string]any{"type": "Point", "coordinates": []any{}}
+		}
+		return map[string]any{"type": "Point", "coordinates": jsonCoord(g.FlatCoords())}
+	case *geom.LineString:
+		return map[string]any{"type": "LineString", "coordinates": jsonCoords1(g.FlatCoords(), stride)}
+	case *geom.Polygon:
+		return map[string]any{"type": "Polygon", "coordinates": jsonCoords2(g.FlatCoords(), 0, g.Ends(), stride)}
+	case *geom.MultiPoint:
+		return map[string]any{"type": "MultiPoint", "coordinates": jsonCoords1(g.FlatCoords(), stride)}
+	case *geom.MultiLineString:
+		return map[string]any{"type": "MultiLineString", "coordinates": jsonCoords2(g.FlatCoords(), 0, g.Ends(), stride)}
+	case *geom.MultiPolygon:
+		out := []any{}
+		start := 0
+		for _, ends := range g.Endss() {
+			out = append(out, jsonCoords2(g.FlatCoords(), start, ends, stride))
+			if len(ends) > 0 {
+				start = ends[len(ends)-1]
+			}
+		}
+		return map[string]any{"type": "MultiPolygon", "coordinates": out}
+	case *geom.GeometryCollection:
+		out := []any{}
+		for _, m := range g.Geoms() {
+			out = append(out, modelGeoJSON(m))
+		}
+		return map[string]any{"type": "GeometryCollection", "geometries": out}
+	}
+	panic(fmt.Sprintf("modelGeoJSON: %T", g))
+}
+
+func jsonText(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// ---------------------------------------------------------------------------
+// Exact arithmetic helpers.
+
+func rat(x float64) *big.Rat {
+	r := new(big.Rat)
+	if r.SetFloat64(x) == nil {
+		panic("rat of a non-finite float")
+	}
+	return r
+}
+
+// shoelace2 returns twice the signed area of a ring (positive when the ring
+// is counter-clockwise in the usual mathematical orientation), exactly.
+func shoelace2(flat []float64, stride int) *big.Rat {
+	sum := new(big.Rat)
+	npts := len(flat) / stride
+	for i := 0; i < npts; i++ {
+		j := (i + 1) % npts
+		xi, yi := rat(flat[i*stride]), rat(flat[i*stride+1])
+		xj, yj := rat(flat[j*stride]), rat(flat[j*stride+1])
+		t := new(big.Rat).Sub(new(big.Rat).Mul(xi, yj), new(big.Rat).Mul(xj, yi))
+		sum.Add(sum, t)
+	}
+	return sum
+}
+
+func ratFloat(r *big.Rat) float64 {
+	f, _ := r.Float64()
+	return f
+}
+
+// closeTo compares floats with a relative/absolute tolerance.
+func closeTo(a, b, tol float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	if a == b {
+		return true
+	}
+	d := math.Abs(a - b)
+	return d <= tol || d <= tol*math.Max(math.Abs(a), math.Abs(b))
+}
+
+// orient2 is the exact orientation of (a, b, c): >0 counter-clockwise, <0
+// clockwise, 0 collinear.
+func orient2(ax, ay, bx, by, cx, cy float64) int {
+	l := new(big.Rat).Mul(new(big.Rat).Sub(rat(bx), rat(ax)), new(big.Rat).Sub(rat(cy), rat(ay)))
+	r := new(big.Rat).Mul(new(big.Rat).Sub(rat(by), rat(ay)), new(big.Rat).Sub(rat(cx), rat(ax)))
+	return l.Cmp(r)
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..9d1afc6
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,149 @@
+package geom_test
+
+// Pins for the bugs in bugs.toml. Each asserts the correct behaviour and
+// fails while the bug exists; the matching Known switch in hegel_test.go
+// keeps the properties clear of the bug's shape meanwhile.
+
+import (
+	"testing"
+
+	geom "github.com/twpayne/go-geom"
+	"github.com/twpayne/go-geom/encoding/geojson"
+	"github.com/twpayne/go-geom/encoding/wkt"
+	"github.com/twpayne/go-geom/xy"
+)
+
+// go-geom/1: Bounds.Extend and GeometryCollection.Bounds panic on a nested
+// GeometryCollection.
+func TestHegelPinNestedCollectionBounds(t *testing.T) {
+	inner := geom.NewGeometryCollection().MustPush(geom.NewPointFlat(geom.XY, []float64{1, 2}))
+	outer := geom.NewGeometryCollection().MustPush(inner, geom.NewPointFlat(geom.XY, []float64{3, 4}))
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("panic: %v", r)
+		}
+	}()
+	b := outer.Bounds()
+	if b.Min(0) != 1 || b.Min(1) != 2 || b.Max(0) != 3 || b.Max(1) != 4 {
+		t.Fatalf("Bounds of the nested collection = %v, want [1 2 3 4]", b)
+	}
+	e := geom.NewBounds(geom.XY).Extend(inner)
+	if e.Min(0) != 1 || e.Min(1) != 2 || e.Max(0) != 1 || e.Max(1) != 2 {
+		t.Fatalf("Bounds.Extend(collection) = %v, want [1 2 1 2]", e)
+	}
+	if _, err := geojson.Marshal(outer, geojson.EncodeGeometryWithBBox()); err != nil {
+		t.Fatalf("geojson.Marshal with bbox: %v", err)
+	}
+}
+
+// go-geom/2: geojson.Marshal writes an empty MultiPoint member as a null
+// position, and geojson.Unmarshal cannot read the text back when the empty
+// member comes first.
+func TestHegelPinGeoJSONEmptyFirstMultiPoint(t *testing.T) {
+	mp := geom.NewMultiPoint(geom.XY).MustSetCoords([]geom.Coord{nil, {1, 2}})
+	b, err := geojson.Marshal(mp)
+	if err != nil {
+		t.Fatalf("Marshal: %v", err)
+	}
+	var back geom.T
+	if err := geojson.Unmarshal(b, &back); err != nil {
+		t.Fatalf("Unmarshal(%s): %v", b, err)
+	}
+	got, ok := back.(*geom.MultiPoint)
+	if !ok {
+		t.Fatalf("Unmarshal(%s) = %T", b, back)
+	}
+	for i := range got.NumPoints() {
+		if c := got.Coord(i); c != nil && c[0] == 1 && c[1] == 2 {
+			return
+		}
+	}
+	t.Fatalf("Unmarshal(%s) lost the point (1 2): %v", b, got.Coords())
+}
+
+// go-geom/3: geojson.Unmarshal infers a MultiLineString's layout from its
+// first member, so a MultiLineString written by geojson.Marshal whose first
+// line is empty and whose second has Z cannot be read back.
+func TestHegelPinGeoJSONEmptyFirstLineString(t *testing.T) {
+	mls := geom.NewMultiLineString(geom.XYZ).MustSetCoords([][]geom.Coord{nil, {{1, 2, 3}, {4, 5, 6}}})
+	b, err := geojson.Marshal(mls)
+	if err != nil {
+		t.Fatalf("Marshal: %v", err)
+	}
+	var back geom.T
+	if err := geojson.Unmarshal(b, &back); err != nil {
+		t.Fatalf("Unmarshal(%s): %v", b, err)
+	}
+	got, ok := back.(*geom.MultiLineString)
+	if !ok || got.Layout() != geom.XYZ {
+		t.Fatalf("Unmarshal(%s) = %s, want an XYZ MultiLineString", b, describe(back))
+	}
+	for i := range got.NumLineStrings() {
+		if fc := got.LineString(i).FlatCoords(); len(fc) == 6 && fc[0] == 1 && fc[5] == 6 {
+			return
+		}
+	}
+	t.Fatalf("Unmarshal(%s) lost the line: %s", b, describe(back))
+}
+
+// go-geom/4: wkt.Marshal writes a collection whose members have different
+// layouts as text that wkt.Unmarshal rejects (EWKB and GeoJSON round-trip
+// the same collection).
+func TestHegelPinWKTMixedLayoutCollection(t *testing.T) {
+	gc := geom.NewGeometryCollection().MustPush(
+		geom.NewPointFlat(geom.XY, []float64{1, 2}),
+		geom.NewPointFlat(geom.XYZ, []float64{1, 2, 3}),
+	)
+	s, err := wkt.Marshal(gc)
+	if err != nil {
+		return // refusing to write it is a consistent answer
+	}
+	if _, err := wkt.Unmarshal(s); err != nil {
+		t.Fatalf("Marshal wrote %q, which Unmarshal rejects: %v", s, err)
+	}
+}
+
+// go-geom/5: xy.ConvexHull of three or more points of which fewer than three
+// are distinct returns coordinates that are not in the input.
+func TestHegelPinConvexHullFewDistinctPoints(t *testing.T) {
+	for _, in := range [][]float64{
+		{-5, -5, -5, -5, -5, -5},
+		{-5, -5, 3, -8, 3, -8},
+	} {
+		hull := xy.ConvexHullFlat(geom.XY, in)
+		if hull == nil {
+			t.Fatalf("ConvexHullFlat(%v) = nil", in)
+		}
+		fc := hull.FlatCoords()
+		for i := 0; i+2 <= len(fc); i += 2 {
+			found := false
+			for j := 0; j+2 <= len(in); j += 2 {
+				if in[j] == fc[i] && in[j+1] == fc[i+1] {
+					found = true
+				}
+			}
+			if !found {
+				t.Fatalf("ConvexHullFlat(%v) = %v: (%v, %v) is not an input point", in, fc, fc[i], fc[i+1])
+			}
+		}
+	}
+}
+
+// go-geom/6: for more than 50 points the hull is computed from a reduced set
+// (points outside an octant ring), and the ring is not closed, so points
+// beyond its missing closing edge are dropped: here (-12, -2) is an extreme
+// point that the returned hull leaves outside.
+func TestHegelPinConvexHullDropsExtremePoints(t *testing.T) {
+	in := []float64{8, 8, 7, -4, 7, 7, -11, -10, 7, -9, -7, -1, 12, 9, -5, 0, -1, 0, 10, -11, -8, -8, 12, 9, 12, 12, -9, -8, 2, 5, 10, -9, 10, -9, 6, 6, 10, 12, -5, -5, -8, 9, 6, 6, -9, -9, -1, 6, -1, 6, 11, -10, 11, -10, 11, 11, -10, -6, 3, 3, 3, 3, 3, 3, -1, -1, -12, 4, 4, -12, 4, -12, 12, 5, 12, 5, 12, 10, -12, -2, -1, -4, -1, -4, -11, -10, 3, 3, 3, 3, -9, -9, 12, -5, 12, -5, 2, -7, 6, -2, 2, 2, 8, 8, -10, -10, 4, -4, 4, -4}
+	hull := xy.ConvexHullFlat(geom.XY, in)
+	poly, ok := hull.(*geom.Polygon)
+	if !ok {
+		t.Fatalf("ConvexHullFlat = %T", hull)
+	}
+	ring := poly.FlatCoords()
+	for i := 0; i+2 <= len(in); i += 2 {
+		if modelInRing(in[i], in[i+1], ring, 2) == 0 {
+			t.Fatalf("input point (%v, %v) lies outside the hull %v", in[i], in[i+1], ring)
+		}
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..4b90af7
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,1263 @@
+package geom_test
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	geom "github.com/twpayne/go-geom"
+	"github.com/twpayne/go-geom/encoding/ewkb"
+	"github.com/twpayne/go-geom/encoding/ewkbhex"
+	"github.com/twpayne/go-geom/encoding/geojson"
+	"github.com/twpayne/go-geom/encoding/wkb"
+	"github.com/twpayne/go-geom/encoding/wkbcommon"
+	"github.com/twpayne/go-geom/encoding/wkbhex"
+	"github.com/twpayne/go-geom/encoding/wkt"
+	"github.com/twpayne/go-geom/xy"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// WKT.
+
+// TestHegelWKTRoundTripsAndMatchesModel: Marshal writes exactly the model
+// text; Unmarshal reads it (and case/whitespace/number-format variants of it)
+// back to the same geometry.
+func TestHegelWKTRoundTripsAndMatchesModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		l := pick(tc, layouts...)
+		o := genOpts{emptyPoints: true, emptyMembers: true, collections: true, mixedLayouts: true, maxDepth: 2}
+		g := genGeom(tc, l, o, 0)
+		note(ht, "%s", describe(g))
+		if hasMixedLayouts(g) {
+			if Known.wktMixedLayoutCollection {
+				return
+			}
+			// no model text for a mixed collection; it must at least round-trip
+			text, err := wkt.Marshal(g)
+			if err != nil {
+				return
+			}
+			if _, err := wkt.Unmarshal(text); err != nil {
+				fail(ht, "Marshal wrote %q which Unmarshal rejects: %v", text, err)
+			}
+			return
+		}
+		want := modelWKT(g)
+		got, err := wkt.Marshal(g)
+		if err != nil {
+			fail(ht, "Marshal: %v\n%s", err, describe(g))
+		}
+		if got != want {
+			fail(ht, "WKT text differs\n got %s\nwant %s\n%s", got, want, describe(g))
+		}
+		back, err := wkt.Unmarshal(got)
+		if err != nil {
+			fail(ht, "Unmarshal(%s): %v\n%s", got, err, describe(g))
+		}
+		want2 := normalizeNoLayoutWKT(g)
+		if d := geomDiff(want2, back, "g"); d != "" {
+			fail(ht, "WKT round trip: %s\ntext %s\n in %s\nout %s", d, got, describe(g), describe(back))
+		}
+		variant := mutateWKT(tc, got)
+		back2, err := wkt.Unmarshal(variant)
+		if err != nil {
+			fail(ht, "Unmarshal(variant %q): %v\ncanonical %s", variant, err, got)
+		}
+		if d := geomDiff(want2, back2, "g"); d != "" {
+			fail(ht, "WKT variant %q: %s\ncanonical %s", variant, d, got)
+		}
+	})
+}
+
+// TestHegelWKTRejectsMalformedText: truncations of a valid WKT and single
+// deleted characters never parse to a geometry silently unless the result is
+// still valid WKT for the same or another geometry (re-marshalling must
+// reproduce a text the parser accepts identically), and never panic.
+func TestHegelWKTRejectsMalformedText(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		l := pick(tc, layouts...)
+		g := genGeom(tc, l, genOpts{emptyPoints: true, collections: true, maxDepth: 1}, 0)
+		text, err := wkt.Marshal(g)
+		if err != nil {
+			fail(ht, "Marshal: %v", err)
+		}
+		// proper prefixes: none may parse, except a prefix that is itself complete WKT
+		// (a shorter list is not, since ')' would be missing).
+		cut := n(tc, 0, len(text)-1)
+		prefix := text[:cut]
+		if back, err := wkt.Unmarshal(prefix); err == nil {
+			again, err2 := wkt.Marshal(back)
+			if err2 != nil || strings.TrimSpace(again) != strings.TrimSpace(prefix) {
+				fail(ht, "prefix %q of %q parsed to %s", prefix, text, describe(back))
+			}
+		}
+		// a deleted or altered character
+		i := n(tc, 0, len(text)-1)
+		var bad string
+		if chance(tc, 50) {
+			bad = text[:i] + text[i+1:]
+		} else {
+			bad = text[:i] + pick(tc, "(", ")", ",", " ", "x", "1", "-", ".", "Z", "E") + text[i+1:]
+		}
+		back, err := wkt.Unmarshal(bad)
+		if err == nil {
+			// accepted: it must be the parse of a legitimate text, i.e. re-marshal and re-parse agree
+			again, err := wkt.Marshal(back)
+			if err != nil {
+				fail(ht, "accepted %q as %s but cannot marshal it: %v", bad, describe(back), err)
+			}
+			back2, err := wkt.Unmarshal(again)
+			if err != nil {
+				fail(ht, "accepted %q as %s whose WKT %q does not parse: %v", bad, describe(back), again, err)
+			}
+			if d := geomDiff(back, back2, "g"); d != "" {
+				fail(ht, "accepted %q as %s; re-parsing its WKT %q gives %s: %s", bad, describe(back), again, describe(back2), d)
+			}
+		}
+	})
+}
