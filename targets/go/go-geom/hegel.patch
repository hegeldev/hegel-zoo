+// ---------------------------------------------------------------------------
+// WKB / EWKB.
+
+// TestHegelWKBMatchesModelAndRoundTrips: Marshal writes exactly the model
+// bytes in both byte orders, in WKB (ISO type codes) and EWKB (flags and
+// SRID); Unmarshal, Read from a stream, and the hex forms read them back to
+// the same geometry; WKB bytes also read through EWKB's Unmarshal when the
+// layout is XY (the two encodings coincide there).
+func TestHegelWKBMatchesModelAndRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		l := pick(tc, layouts...)
+		o := genOpts{emptyPoints: true, emptyMembers: true, shortLines: true, wildFloats: true, collections: true, maxDepth: 2, srid: true}
+		g := genGeom(tc, l, o, 0)
+		bo := pick[binary.ByteOrder](tc, binary.BigEndian, binary.LittleEndian)
+		note(ht, "%s order %v", describe(g), bo)
+
+		// EWKB
+		eb, err := ewkb.Marshal(g, bo)
+		if err != nil {
+			fail(ht, "ewkb.Marshal: %v\n%s", err, describe(g))
+		}
+		if want := modelWKB(g, bo, true); !bytes.Equal(eb, want) {
+			fail(ht, "EWKB bytes differ\n got %x\nwant %x\n%s", eb, want, describe(g))
+		}
+		back, err := ewkb.Unmarshal(eb)
+		if err != nil {
+			fail(ht, "ewkb.Unmarshal: %v\n%x\n%s", err, eb, describe(g))
+		}
+		if d := geomDiff(withMemberSRIDs(g), back, "g"); d != "" {
+			fail(ht, "EWKB round trip: %s\n in %s\nout %s", d, describe(g), describe(back))
+		}
+		hx, err := ewkbhex.Encode(g, bo)
+		if err != nil || !strings.EqualFold(hx, hex.EncodeToString(eb)) {
+			fail(ht, "ewkbhex.Encode %q err %v, bytes %x", hx, err, eb)
+		}
+		if back, err := ewkbhex.Decode(strings.ToUpper(hx)); err != nil {
+			fail(ht, "ewkbhex.Decode: %v", err)
+		} else if d := geomDiff(withMemberSRIDs(g), back, "g"); d != "" {
+			fail(ht, "EWKB hex round trip: %s", d)
+		}
+		// a stream of two geometries
+		g2 := genGeom(tc, pick(tc, layouts...), o, 0)
+		eb2, err := ewkb.Marshal(g2, bo)
+		if err == nil {
+			r := bytes.NewReader(append(append([]byte(nil), eb...), eb2...))
+			r1, err1 := ewkb.Read(r)
+			r2, err2 := ewkb.Read(r)
+			if err1 != nil || err2 != nil {
+				fail(ht, "ewkb.Read stream: %v %v", err1, err2)
+			}
+			if d := geomDiff(withMemberSRIDs(g), r1, "first"); d != "" {
+				fail(ht, "ewkb.Read stream: %s", d)
+			}
+			if d := geomDiff(withMemberSRIDs(g2), r2, "second"); d != "" {
+				fail(ht, "ewkb.Read stream: %s", d)
+			}
+			if r.Len() != 0 {
+				fail(ht, "ewkb.Read left %d bytes", r.Len())
+			}
+		}
+
+		// WKB (no SRID in the format; empty points as NaN with the option)
+		g0 := withoutSRID(g)
+		wb, err := wkb.Marshal(g0, bo, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN))
+		if err != nil {
+			fail(ht, "wkb.Marshal: %v\n%s", err, describe(g0))
+		}
+		if want := modelWKB(g0, bo, false); !bytes.Equal(wb, want) {
+			fail(ht, "WKB bytes differ\n got %x\nwant %x\n%s", wb, want, describe(g0))
+		}
+		back, err = wkb.Unmarshal(wb, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN))
+		if err != nil {
+			fail(ht, "wkb.Unmarshal: %v\n%x\n%s", err, wb, describe(g0))
+		}
+		g0 = normalizeNoLayout(g0)
+		if d := geomDiff(g0, back, "g"); d != "" {
+			fail(ht, "WKB round trip: %s\n in %s\nout %s", d, describe(g0), describe(back))
+		}
+		if hx, err := wkbhex.Encode(g0, bo, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN)); err != nil || !strings.EqualFold(hx, hex.EncodeToString(wb)) {
+			fail(ht, "wkbhex.Encode %q err %v", hx, err)
+		} else if back, err := wkbhex.Decode(hx, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN)); err != nil {
+			fail(ht, "wkbhex.Decode: %v", err)
+		} else if d := geomDiff(g0, back, "g"); d != "" {
+			fail(ht, "WKB hex round trip: %s", d)
+		}
+		// without the option, an empty point is an error on both sides
+		if hasEmptyPoint(g0) {
+			if _, err := wkb.Marshal(g0, bo); err == nil {
+				fail(ht, "wkb.Marshal of an empty point without the NaN option succeeded: %s", describe(g0))
+			}
+		} else {
+			wb2, err := wkb.Marshal(g0, bo)
+			if err != nil || !bytes.Equal(wb2, wb) {
+				fail(ht, "wkb.Marshal without options: %v, %x vs %x", err, wb2, wb)
+			}
+		}
+		// XY WKB is XY EWKB
+		if allXY(g0) {
+			if back, err := ewkb.Unmarshal(wb); err != nil {
+				fail(ht, "ewkb.Unmarshal(XY WKB): %v", err)
+			} else if d := geomDiff(g0, back, "g"); d != "" {
+				fail(ht, "ewkb.Unmarshal(XY WKB): %s", d)
+			}
+			if back, err := wkb.Unmarshal(eb, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN)); g.SRID() == 0 && !hasSRID(g) {
+				if err != nil {
+					fail(ht, "wkb.Unmarshal(XY EWKB): %v", err)
+				} else if d := geomDiff(g0, back, "g"); d != "" {
+					fail(ht, "wkb.Unmarshal(XY EWKB): %s", d)
+				}
+			}
+		}
+	})
+}
+
+// withMemberSRIDs returns g as EWKB will read it back: multi-geometries'
+// members are written without an SRID, so nothing changes at the top level
+// (SRIDs live on the top-level geometry and on collection members).
+func withMemberSRIDs(g geom.T) geom.T { return normalizeNoLayout(g) }
+
+func withoutSRID(g geom.T) geom.T {
+	c := clone(g)
+	var strip func(geom.T)
+	strip = func(g geom.T) {
+		geom.SetSRID(g, 0)
+		if gc, ok := g.(*geom.GeometryCollection); ok {
+			for _, m := range gc.Geoms() {
+				strip(m)
+			}
+		}
+	}
+	strip(c)
+	return c
+}
+
+func hasSRID(g geom.T) bool {
+	if g.SRID() != 0 {
+		return true
+	}
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		for _, m := range gc.Geoms() {
+			if hasSRID(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func allXY(g geom.T) bool {
+	if g.Layout() != geom.XY {
+		return false
+	}
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		for _, m := range gc.Geoms() {
+			if !allXY(m) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func hasEmptyPoint(g geom.T) bool {
+	switch g := g.(type) {
+	case *geom.Point:
+		return g.Empty()
+	case *geom.MultiPoint:
+		for i := range g.NumPoints() {
+			if g.Point(i).Empty() {
+				return true
+			}
+		}
+	case *geom.GeometryCollection:
+		for _, m := range g.Geoms() {
+			if hasEmptyPoint(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// TestHegelWKBRejectsMalformedBytes: every proper prefix of an (E)WKB is an
+// error, and corrupted bytes never panic (limits on element counts are
+// honoured).
+func TestHegelWKBRejectsMalformedBytes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		l := pick(tc, layouts...)
+		o := genOpts{emptyPoints: true, emptyMembers: true, collections: true, maxDepth: 1, srid: true}
+		g := genGeom(tc, l, o, 0)
+		bo := pick[binary.ByteOrder](tc, binary.BigEndian, binary.LittleEndian)
+		eb, err := ewkb.Marshal(g, bo)
+		if err != nil {
+			fail(ht, "ewkb.Marshal: %v", err)
+		}
+		cut := n(tc, 0, len(eb)-1)
+		if back, err := ewkb.Unmarshal(eb[:cut]); err == nil {
+			fail(ht, "EWKB prefix %d/%d bytes decoded to %s\nfull %x\n%s", cut, len(eb), describe(back), eb, describe(g))
+		}
+		g0 := withoutSRID(g)
+		wb, err := wkb.Marshal(g0, bo, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN))
+		if err != nil {
+			fail(ht, "wkb.Marshal: %v", err)
+		}
+		cut = n(tc, 0, len(wb)-1)
+		if back, err := wkb.Unmarshal(wb[:cut], wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN)); err == nil {
+			fail(ht, "WKB prefix %d/%d bytes decoded to %s\nfull %x\n%s", cut, len(wb), describe(back), wb, describe(g0))
+		}
+		// corruption: flip a byte; must not panic (recovered by property()), must not hang
+		bad := append([]byte(nil), eb...)
+		i := n(tc, 0, len(bad)-1)
+		bad[i] ^= byte(1 << n(tc, 0, 7))
+		limit := pick(tc, 0, 1, 16, 1000)
+		old := wkbcommon.MaxGeometryElements
+		wkbcommon.MaxGeometryElements = [4]int{0, limit, limit, limit}
+		defer func() { wkbcommon.MaxGeometryElements = old }()
+		if back, err := ewkb.Unmarshal(bad); err == nil {
+			// accepted: what was read must be encodable, and read back the same
+			// (trailing bytes are ignored as in JTS and GEOS, an SRID flag with
+			// SRID 0 and member SRIDs are dropped, so the bytes may differ)
+			again, err := ewkb.Marshal(back, bo)
+			if err != nil {
+				fail(ht, "corrupted EWKB %x decoded to %s which cannot be re-encoded: %v", bad, describe(back), err)
+			}
+			back2, err := ewkb.Unmarshal(again)
+			if err != nil {
+				fail(ht, "corrupted EWKB %x decoded to %s whose EWKB %x does not decode: %v", bad, describe(back), again, err)
+			}
+			if d := geomDiff(back, back2, "g"); d != "" {
+				fail(ht, "corrupted EWKB %x decoded to %s; its EWKB %x decodes differently: %s", bad, describe(back), again, d)
+			}
+		}
+		_, _ = wkb.Unmarshal(bad, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN))
+	})
+}
