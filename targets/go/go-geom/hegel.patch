+// ---------------------------------------------------------------------------
+// Cross-codec agreement.
+
+// TestHegelCodecsAgree: the same geometry read back from WKT, EWKB and
+// GeoJSON is the same geometry, and encoding the read-back geometry
+// reproduces the text/bytes (idempotence).
+func TestHegelCodecsAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		l := pick(tc, geom.XY, geom.XYZ, geom.XYZM)
+		g := genGeom(tc, l, genOpts{emptyPoints: true, collections: true, maxDepth: 2}, 0)
+		if Known.geojsonNullPositions && hasEmptyMultiPointMember(g) {
+			return
+		}
+		if Known.geojsonLayoutFromFirstMember && hasEmptyFirstMember(g) {
+			return
+		}
+		text, err := wkt.Marshal(g)
+		if err != nil {
+			fail(ht, "wkt: %v", err)
+		}
+		fromWKT, err := wkt.Unmarshal(text)
+		if err != nil {
+			fail(ht, "wkt.Unmarshal: %v", err)
+		}
+		eb, _ := ewkb.Marshal(g, binary.LittleEndian)
+		fromEWKB, err := ewkb.Unmarshal(eb)
+		if err != nil {
+			fail(ht, "ewkb.Unmarshal: %v", err)
+		}
+		if d := geomDiff(normalizeNoLayoutWKT(g), fromWKT, "g"); d != "" {
+			fail(ht, "WKT reading: %s\n%s", d, text)
+		}
+		if d := geomDiff(normalizeNoLayout(g), fromEWKB, "g"); d != "" {
+			fail(ht, "EWKB reading: %s\n%s", d, text)
+		}
+		text2, err := wkt.Marshal(fromEWKB)
+		if err != nil || text2 != text {
+			fail(ht, "WKT of the EWKB reading differs: %q vs %q (%v)", text2, text, err)
+		}
+		jb, _ := geojson.Marshal(g)
+		var fromJSON geom.T
+		if err := geojson.Unmarshal(jb, &fromJSON); err != nil {
+			fail(ht, "geojson.Unmarshal: %v", err)
+		}
+		if d := geomDiff(expectedAfterGeoJSON(fromWKT), fromJSON, "g"); d != "" {
+			fail(ht, "WKT vs GeoJSON: %s\n%s\n%s", d, text, jb)
+		}
+		jb2, _ := geojson.Marshal(fromJSON)
+		if !bytes.Equal(jb, jb2) {
+			fail(ht, "GeoJSON not idempotent: %s vs %s", jb, jb2)
+		}
+	})
+}
