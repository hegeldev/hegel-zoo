+// ---------------------------------------------------------------------------
+// WKT.
+
+// wktCase: a geometry and the tape styling its text (an empty tape is the
+// canonical text).
+type wktCase struct {
+	g     geom.T
+	style []int
+}
+
+func (c wktCase) GoString() string { return fmt.Sprintf("%s\nstyle %v", describe(c.g), c.style) }
