+// ---------------------------------------------------------------------------
+// Measures with exact arithmetic.
+
+// ringSpec is a simple (star-shaped) closed ring with integer coordinates: a
+// centre, three to seven picks from the 17x17 grid of offsets around it
+// (the centre itself left out; repeated picks count once), the orientation,
+// and the values of the dimensions beyond XY (recycled over the vertices).
+// The picks are sorted by angle around their centroid, which is strictly
+// inside their hull unless they are collinear, so every angular gap is below
+// pi and the polygon is simple; fewer than three distinct or collinear picks
+// become a fixed triangle.
+type ringSpec struct {
+	cx, cy int
+	picks  []int
+	ccw    bool
+	extra  []int
+}
+
+const gridSide = 17
+
+var ringSpecs = hegel.Composite(func(tc hegel.TestCase) ringSpec {
+	return ringSpec{
+		cx:    hegel.Draw(tc, hegel.Integers(-5, 5)),
+		cy:    hegel.Draw(tc, hegel.Integers(-5, 5)),
+		picks: hegel.Draw(tc, many(hegel.Integers(0, gridSide*gridSide-2), 3, 7)),
+		ccw:   hegel.Draw(tc, hegel.Booleans()),
+		extra: hegel.Draw(tc, many(hegel.Integers(-3, 3), 0, 16)),
+	}
+})
+
+// flat renders the ring's coordinates in the layout, closed.
+func (r ringSpec) flat(l geom.Layout) []float64 {
+	stride := l.Stride()
+	type pt struct{ x, y, ang float64 }
+	var pts []pt
+	seen := map[int]bool{}
+	for _, k := range r.picks {
+		if seen[k] {
+			continue
+		}
+		seen[k] = true
+		i := k
+		if i >= gridSide*gridSide/2 { // the centre is left out
+			i++
+		}
+		pts = append(pts, pt{float64(r.cx + i/gridSide - gridSide/2), float64(r.cy + i%gridSide - gridSide/2), 0})
+	}
+	angleSort := func(pts []pt) {
+		var mx, my float64
+		for _, p := range pts {
+			mx += p.x
+			my += p.y
+		}
+		mx /= float64(len(pts))
+		my /= float64(len(pts))
+		for i := range pts {
+			pts[i].ang = math.Atan2(pts[i].y-my, pts[i].x-mx)
+		}
+		sort.Slice(pts, func(i, j int) bool { return pts[i].ang < pts[j].ang })
+	}
+	collinear := len(pts) < 3
+	if !collinear {
+		angleSort(pts)
+		var flat2 []float64
+		for _, p := range pts {
+			flat2 = append(flat2, p.x, p.y)
+		}
+		collinear = shoelace2(flat2, 2).Sign() == 0
+	}
+	if collinear {
+		cx, cy := float64(r.cx), float64(r.cy)
+		pts = []pt{{cx + 2, cy + 1, 0}, {cx - 1, cy + 2, 0}, {cx - 1, cy - 2, 0}}
+		angleSort(pts)
+	}
+	if !r.ccw {
+		for i, j := 0, len(pts)-1; i < j; i, j = i+1, j-1 {
+			pts[i], pts[j] = pts[j], pts[i]
+		}
+	}
+	var flat []float64
+	for i := 0; i <= len(pts); i++ {
+		p := pts[i%len(pts)]
+		c := make([]float64, stride)
+		c[0], c[1] = p.x, p.y
+		for d := 2; d < stride; d++ {
+			if len(r.extra) > 0 {
+				c[d] = float64(r.extra[(i*(stride-2)+d-2)%len(r.extra)])
+			}
+		}
+		flat = append(flat, c...)
+	}
+	return flat
+}
+
+// measuresCase: a layout, a polygon's shell and up to two holes (of either
+// orientation), and a second polygon's ring.
+type measuresCase struct {
+	l     geom.Layout
+	shell ringSpec
+	holes []ringSpec
+	other ringSpec
+}
+
+func (c measuresCase) GoString() string {
+	var holes []string
+	for _, h := range c.holes {
+		holes = append(holes, fmt.Sprint(h.flat(c.l)))
+	}
+	return fmt.Sprintf("layout %s\nshell %v\nholes %v\nother %v", c.l, c.shell.flat(c.l), holes, c.other.flat(c.l))
+}
+
+var measuresCases = hegel.Composite(func(tc hegel.TestCase) measuresCase {
+	return measuresCase{
+		l:     hegel.Draw(tc, geomLayout),
+		shell: hegel.Draw(tc, ringSpecs),
+		holes: hegel.Draw(tc, many(ringSpecs, 0, 2)),
+		other: hegel.Draw(tc, ringSpecs),
+	}
+})
+
+// TestHegelMeasuresAreExact: Area, Length, Bounds, xy.SignedArea and
+// xy.IsRingCounterClockwise agree with exact rational arithmetic on integer
+// coordinates (areas exactly, lengths to 1e-9), for polygons with holes,
+// multipolygons, linestrings and collections.
+func TestHegelMeasuresAreExact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, measuresCases)
+		l := c.l
+		stride := l.Stride()
+		// a polygon: CCW or CW shell with 0-2 holes of either orientation
+		shell := c.shell.flat(l)
+		var flat []float64
+		var ends []int
+		flat = append(flat, shell...)
+		ends = append(ends, len(flat))
+		var holes [][]float64
+		for _, spec := range c.holes {
+			h := spec.flat(l)
+			holes = append(holes, h)
+			flat = append(flat, h...)
+			ends = append(ends, len(flat))
+		}
+		poly := geom.NewPolygonFlat(l, flat, ends)
+
+		// signed sum of the rings' shoelace areas, positive when counter-clockwise (the library's Area convention)
+		sum := new(big.Rat)
+		sum.Add(sum, shoelace2(shell, stride))
+		for _, h := range holes {
+			sum.Add(sum, shoelace2(h, stride))
+		}
+		wantArea := ratFloat(new(big.Rat).Quo(sum, big.NewRat(2, 1)))
+		if got := poly.Area(); got != wantArea {
+			fail(ht, "Polygon.Area = %v, exact signed sum of the rings = %v\n%s", got, wantArea, describe(poly))
+		}
+		// xy.SignedArea of the shell: positive when CW
+		shellSigned := ratFloat(new(big.Rat).Quo(new(big.Rat).Neg(shoelace2(shell, stride)), big.NewRat(2, 1)))
+		if got := xy.SignedArea(l, shell); got != shellSigned {
+			fail(ht, "xy.SignedArea = %v, exact = %v\nring %v", got, shellSigned, shell)
+		}
+		if got := xy.IsRingCounterClockwise(l, shell); got != c.shell.ccw {
+			fail(ht, "IsRingCounterClockwise = %v for a ring built %s (signed area %v)\nring %v", got, map[bool]string{true: "CCW", false: "CW"}[c.shell.ccw], shellSigned, shell)
+		}
+		// Length = sum of segment lengths
+		var wantLen float64
+		start := 0
+		for _, end := range ends {
+			for i := start + stride; i < end; i += stride {
+				dx := flat[i] - flat[i-stride]
+				dy := flat[i+1] - flat[i+1-stride]
+				wantLen += math.Sqrt(dx*dx + dy*dy)
+			}
+			start = end
+		}
+		if got := poly.Length(); !closeTo(got, wantLen, 1e-9) {
+			fail(ht, "Polygon.Length = %v, want %v", got, wantLen)
+		}
+		// Bounds
+		b := poly.Bounds()
+		for d := 0; d < stride; d++ {
+			lo, hi := math.Inf(1), math.Inf(-1)
+			for i := d; i < len(flat); i += stride {
+				lo, hi = math.Min(lo, flat[i]), math.Max(hi, flat[i])
+			}
+			if b.Min(d) != lo || b.Max(d) != hi {
+				fail(ht, "Bounds dim %d = [%v, %v], want [%v, %v]", d, b.Min(d), b.Max(d), lo, hi)
+			}
+		}
+		if b.Layout() != l {
+			fail(ht, "Bounds layout %s, want %s", b.Layout(), l)
+		}
+		// MultiPolygon area/length = sums
+		poly2 := geom.NewPolygonFlat(l, c.other.flat(l), nil)
+		poly2 = geom.NewPolygonFlat(l, poly2.FlatCoords(), []int{len(poly2.FlatCoords())})
+		mp := geom.NewMultiPolygon(l)
+		mp.MustSetCoords([][][]geom.Coord{poly.Coords(), poly2.Coords()})
+		if got, want := mp.Area(), poly.Area()+poly2.Area(); !closeTo(got, want, 1e-9) {
+			fail(ht, "MultiPolygon.Area = %v, sum of parts = %v", got, want)
+		}
+		if got, want := mp.Length(), poly.Length()+poly2.Length(); !closeTo(got, want, 1e-9) {
+			fail(ht, "MultiPolygon.Length = %v, sum of parts = %v", got, want)
+		}
+		// LineString length and zero area
+		ls := geom.NewLineStringFlat(l, shell)
+		if got := ls.Length(); !closeTo(got, poly.LinearRing(0).Length(), 1e-12) {
+			fail(ht, "LineString.Length %v vs LinearRing.Length %v", got, poly.LinearRing(0).Length())
+		}
+		if ls.Area() != 0 {
+			fail(ht, "LineString.Area = %v", ls.Area())
+		}
+		// collection bounds cover the members
+		gc := geom.NewGeometryCollection().MustPush(poly, ls, geom.NewPointFlat(l, shell[:stride]))
+		cb := gc.Bounds()
+		for d := 0; d < stride; d++ {
+			if cb.Min(d) != b.Min(d) || cb.Max(d) != b.Max(d) {
+				fail(ht, "collection Bounds dim %d = [%v, %v], polygon [%v, %v]", d, cb.Min(d), cb.Max(d), b.Min(d), b.Max(d))
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Algorithms.
+
+// pointSet returns the distinct XY points of a flat array.
+func pointSet(flat []float64, stride int) map[[2]float64]bool {
+	m := map[[2]float64]bool{}
+	for i := 0; i+stride <= len(flat); i += stride {
+		m[[2]float64{flat[i], flat[i+1]}] = true
+	}
+	return m
+}
+
+// modelHull is Andrew's monotone chain with exact orientation; it returns the
+// hull's extreme points (collinear boundary points excluded), counter-clockwise.
+func modelHull(pts [][2]float64) [][2]float64 {
+	sort.Slice(pts, func(i, j int) bool {
+		if pts[i][0] != pts[j][0] {
+			return pts[i][0] < pts[j][0]
+		}
+		return pts[i][1] < pts[j][1]
+	})
+	var uniq [][2]float64
+	for i, p := range pts {
+		if i > 0 && p == pts[i-1] {
+			continue
+		}
+		uniq = append(uniq, p)
+	}
+	pts = uniq
+	if len(pts) <= 2 {
+		return pts
+	}
+	var lower, upper [][2]float64
+	for _, p := range pts {
+		for len(lower) >= 2 && orient2(lower[len(lower)-2][0], lower[len(lower)-2][1], lower[len(lower)-1][0], lower[len(lower)-1][1], p[0], p[1]) <= 0 {
+			lower = lower[:len(lower)-1]
+		}
+		lower = append(lower, p)
+	}
+	for i := len(pts) - 1; i >= 0; i-- {
+		p := pts[i]
+		for len(upper) >= 2 && orient2(upper[len(upper)-2][0], upper[len(upper)-2][1], upper[len(upper)-1][0], upper[len(upper)-1][1], p[0], p[1]) <= 0 {
+			upper = upper[:len(upper)-1]
+		}
+		upper = append(upper, p)
+	}
+	return append(lower[:len(lower)-1], upper[:len(upper)-1]...)
+}
+
+// modelInRing locates p relative to a closed ring by exact ray crossing:
+// 0 exterior, 1 boundary, 2 interior.
+func modelInRing(px, py float64, ring []float64, stride int) int {
+	npts := len(ring)/stride - 1
+	crossings := 0
+	for i := 0; i < npts; i++ {
+		ax, ay := ring[i*stride], ring[i*stride+1]
+		bx, by := ring[(i+1)*stride], ring[(i+1)*stride+1]
+		// on the segment?
+		if orient2(ax, ay, bx, by, px, py) == 0 && math.Min(ax, bx) <= px && px <= math.Max(ax, bx) && math.Min(ay, by) <= py && py <= math.Max(ay, by) {
+			return 1
+		}
+		if (ay > py) != (by > py) {
+			// x of the intersection with the horizontal line through p, exactly: compare orientation
+			// the edge crosses the ray to the right of p iff p is left of the upward-directed edge
+			var o int
+			if by > ay {
+				o = orient2(ax, ay, bx, by, px, py)
+			} else {
+				o = orient2(bx, by, ax, ay, px, py)
+			}
+			if o > 0 {
+				crossings++
+			}
+		}
+	}
+	if crossings%2 == 1 {
+		return 2
+	}
+	return 0
+}
+
+// hullPoint: a point of the hull input: its coordinate or, when dup, the XY
+// of the previous point (a duplicate), with y equal to x when diag (collinear
+// runs on the diagonal).
+type hullPoint struct {
+	c         geom.Coord
+	dup, diag bool
+}
+
+// hullFlat renders the points as a flat array.
+func hullFlat(pts []hullPoint, stride int) []float64 {
+	var flat []float64
+	for i, p := range pts {
+		c := append(geom.Coord(nil), p.c...)
+		if p.dup && i > 0 {
+			c[0], c[1] = flat[(i-1)*stride], flat[(i-1)*stride+1]
+		}
+		if p.diag {
+			c[1] = c[0]
+		}
+		flat = append(flat, c...)
+	}
+	return flat
+}
+
+// probe: a point located against a ring: a random point (kinds 0 and 1), a
+// vertex of the ring (2, the k-th modulo their number) or the midpoint of an
+// edge (3, the k-th).
+type probe struct {
+	kind, k int
+	px, py  int
+}
+
+// at is the probe's XY on the ring.
+func (p probe) at(ring []float64, stride int) (float64, float64) {
+	switch p.kind {
+	case 2:
+		k := p.k % (len(ring) / stride)
+		return ring[k*stride], ring[k*stride+1]
+	case 3:
+		k := p.k % (len(ring)/stride - 1)
+		return (ring[k*stride] + ring[(k+1)*stride]) / 2, (ring[k*stride+1] + ring[(k+1)*stride+1]) / 2
+	}
+	return float64(p.px), float64(p.py)
+}
+
+// fewDistinct: three or more points among fewer than three distinct ones
+// (the shape of go-geom/5).
+func fewDistinct(flat []float64, stride int) bool {
+	return len(flat)/stride >= 3 && len(pointSet(flat, stride)) < 3
+}
+
+// hullShapes names the recorded bugs the hull input has the shape of:
+// fewer than three distinct points among three or more (go-geom/5), more
+// than fifty points (go-geom/6).
+func hullShapes(flat []float64, stride int) []string {
+	return append(shapeIf(fewDistinct(flat, stride), "go-geom/5"), shapeIf(len(flat)/stride > 50, "go-geom/6")...)
+}
+
+// hullSets: one to sixty points of the layout (fifty under HEGEL_NO_KNOWN=1,
+// since the hull of more misses extreme points, go-geom/6), the count drawn
+// first so that large sets are as common as small ones; under
+// HEGEL_NO_KNOWN=1 the sets of three or more points with fewer than three
+// distinct (go-geom/5) are left out.
+func hullSets(l geom.Layout) hegel.Generator[[]hullPoint] {
+	points := hegel.Composite(func(tc hegel.TestCase) hullPoint {
+		return hullPoint{c: hegel.Draw(tc, coords(l, genOpts{intCoordsOnly: true})), dup: hegel.Draw(tc, chance(20)), diag: hegel.Draw(tc, chance(20))}
+	})
+	sets := hegel.FlatMap(hegel.Integers(1, shaped(60, 50)), func(n int) hegel.Generator[[]hullPoint] { return fixed(points, n) })
+	if !Known.convexHullFewDistinct {
+		return sets
+	}
+	return hegel.Filter(sets, func(pts []hullPoint) bool { return !fewDistinct(hullFlat(pts, l.Stride()), l.Stride()) })
+}
+
+// algoCase: a layout, the hull input, a simple ring with five probes, a
+// point and a segment, and a Douglas-Peucker threshold.
+type algoCase struct {
+	l         geom.Layout
+	pts       []hullPoint
+	ring      ringSpec
+	probes    []probe
+	p, a, b   geom.Coord
+	threshold float64
+}
+
+func (c algoCase) GoString() string {
+	return fmt.Sprintf("layout %s\npoints %v\nring %v\nprobes %+v\np %v a %v b %v threshold %v", c.l, hullFlat(c.pts, c.l.Stride()), c.ring.flat(c.l), c.probes, c.p, c.a, c.b, c.threshold)
+}
+
+var (
+	probes = hegel.Composite(func(tc hegel.TestCase) probe {
+		return probe{
+			kind: hegel.Draw(tc, hegel.Integers(0, 3)),
+			k:    hegel.Draw(tc, positions),
+			px:   hegel.Draw(tc, hegel.Integers(-14, 14)),
+			py:   hegel.Draw(tc, hegel.Integers(-14, 14)),
+		}
+	})
+	smallCoords = hegel.Map(fixed(hegel.Integers(-10, 10), 2), func(xs []int) geom.Coord { return geom.Coord{float64(xs[0]), float64(xs[1])} })
+	thresholds  = hegel.SampledFrom([]float64{0, 0.5, 1, 2, 3.5})
+	algoCases   = hegel.FlatMap(geomLayout, func(l geom.Layout) hegel.Generator[algoCase] {
+		sets := hullSets(l)
+		return hegel.Composite(func(tc hegel.TestCase) algoCase {
+			return algoCase{
+				l:         l,
+				pts:       hegel.Draw(tc, sets),
+				ring:      hegel.Draw(tc, ringSpecs),
+				probes:    hegel.Draw(tc, fixed(probes, 5)),
+				p:         hegel.Draw(tc, smallCoords),
+				a:         hegel.Draw(tc, smallCoords),
+				b:         hegel.Draw(tc, smallCoords),
+				threshold: hegel.Draw(tc, thresholds),
+			}
+		})
+	})
+)
+
+// TestHegelAlgorithmsMatchModels: ConvexHull's extreme points equal the exact
+// monotone-chain hull; IsPointInRing/LocatePointInRing equal exact ray
+// crossing; the centroids of points, lines and polygons equal the exact
+// formulas; DistanceFromPointToLine equals the exact formula; Simplify keeps
+// the endpoints, returns increasing indexes, and every dropped point lies
+// within the threshold of the simplified line.
+func TestHegelAlgorithmsMatchModels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, algoCases)
+		l := c.l
+		stride := l.Stride()
+
+		// convex hull of a random multipoint (with duplicates and collinear runs)
+		flat := hullFlat(c.pts, stride)
+		checkHull(ht, l, flat, hullShapes(flat, stride))
+
+		// point in ring on a simple ring
+		ring := c.ring.flat(l)
+		for _, pr := range c.probes {
+			px, py := pr.at(ring, stride)
+			p := make(geom.Coord, stride)
+			p[0], p[1] = px, py
+			wantLoc := modelInRing(px, py, ring, stride)
+			gotIn := xy.IsPointInRing(l, p, ring)
+			if gotIn != (wantLoc != 0) {
+				fail(ht, "IsPointInRing((%v, %v)) = %v, exact location %d (0 ext, 1 bdry, 2 int)\nring %v", px, py, gotIn, wantLoc, ring)
+			}
+			loc := xy.LocatePointInRing(l, p, ring)
+			if int(loc) != map[int]int{0: 2, 1: 1, 2: 0}[wantLoc] {
+				fail(ht, "LocatePointInRing((%v, %v)) = %v (0 interior, 1 boundary, 2 exterior), exact %d (0 ext, 1 bdry, 2 int)\nring %v", px, py, loc, wantLoc, ring)
+			}
+		}
+
+		// centroids
+		mpFlat := flat
+		ptCent := xy.PointsCentroidFlat(l, mpFlat)
+		sx, sy := new(big.Rat), new(big.Rat)
+		for i := 0; i+stride <= len(mpFlat); i += stride {
+			sx.Add(sx, rat(mpFlat[i]))
+			sy.Add(sy, rat(mpFlat[i+1]))
+		}
+		cnt := big.NewRat(int64(len(mpFlat)/stride), 1)
+		if !closeTo(ptCent[0], ratFloat(new(big.Rat).Quo(sx, cnt)), 1e-12) || !closeTo(ptCent[1], ratFloat(new(big.Rat).Quo(sy, cnt)), 1e-12) {
+			fail(ht, "PointsCentroidFlat = %v, exact (%v, %v)\n%v", ptCent, ratFloat(new(big.Rat).Quo(sx, cnt)), ratFloat(new(big.Rat).Quo(sy, cnt)), mpFlat)
+		}
+		// polygon centroid: exact formula on the simple ring
+		poly := geom.NewPolygonFlat(l, ring, []int{len(ring)})
+		a2 := shoelace2(ring, stride)
+		if a2.Sign() != 0 {
+			cx, cy := new(big.Rat), new(big.Rat)
+			np := len(ring)/stride - 1
+			for i := 0; i < np; i++ {
+				xi, yi := rat(ring[i*stride]), rat(ring[i*stride+1])
+				xj, yj := rat(ring[(i+1)*stride]), rat(ring[(i+1)*stride+1])
+				cross := new(big.Rat).Sub(new(big.Rat).Mul(xi, yj), new(big.Rat).Mul(xj, yi))
+				cx.Add(cx, new(big.Rat).Mul(new(big.Rat).Add(xi, xj), cross))
+				cy.Add(cy, new(big.Rat).Mul(new(big.Rat).Add(yi, yj), cross))
+			}
+			den := new(big.Rat).Mul(big.NewRat(3, 1), a2)
+			wantX, wantY := ratFloat(new(big.Rat).Quo(cx, den)), ratFloat(new(big.Rat).Quo(cy, den))
+			got := xy.PolygonsCentroid(poly)
+			if !closeTo(got[0], wantX, 1e-9) || !closeTo(got[1], wantY, 1e-9) {
+				fail(ht, "PolygonsCentroid = %v, exact (%v, %v)\nring %v", got, wantX, wantY, ring)
+			}
+		}
+		// line centroid: length-weighted midpoints
+		lineCent := xy.LinesCentroid(geom.NewLineStringFlat(l, ring))
+		var tl, wx, wy float64
+		for i := stride; i < len(ring); i += stride {
+			dx, dy := ring[i]-ring[i-stride], ring[i+1]-ring[i+1-stride]
+			seg := math.Hypot(dx, dy)
+			tl += seg
+			wx += seg * (ring[i] + ring[i-stride]) / 2
+			wy += seg * (ring[i+1] + ring[i+1-stride]) / 2
+		}
+		if !closeTo(lineCent[0], wx/tl, 1e-9) || !closeTo(lineCent[1], wy/tl, 1e-9) {
+			fail(ht, "LinesCentroid = %v, want (%v, %v)", lineCent, wx/tl, wy/tl)
+		}
+
+		// distance from a point to a segment
+		gotD := xy.DistanceFromPointToLine(c.p, c.a, c.b)
+		wantD := segDist(c.p, c.a, c.b)
+		if !closeTo(gotD, wantD, 1e-9) {
+			fail(ht, "DistanceFromPointToLine(%v, %v, %v) = %v, want %v", c.p, c.a, c.b, gotD, wantD)
+		}
+
+		// Douglas-Peucker
+		lineFlat := flat
+		if len(lineFlat)/stride >= 2 {
+			threshold := c.threshold
+			idx := xy.SimplifyFlatCoords(lineFlat, threshold, stride)
+			np := len(lineFlat) / stride
+			if len(idx) < 2 || idx[0] != 0 || idx[len(idx)-1] != np-1 {
+				if !(np == 1) {
+					fail(ht, "SimplifyFlatCoords endpoints: %v for %d points", idx, np)
+				}
+			}
+			for i := 1; i < len(idx); i++ {
+				if idx[i] <= idx[i-1] {
+					fail(ht, "SimplifyFlatCoords indexes not increasing: %v", idx)
+				}
+			}
+			for i := 1; i < len(idx); i++ {
+				a := geom.Coord{lineFlat[idx[i-1]*stride], lineFlat[idx[i-1]*stride+1]}
+				b := geom.Coord{lineFlat[idx[i]*stride], lineFlat[idx[i]*stride+1]}
+				for k := idx[i-1] + 1; k < idx[i]; k++ {
+					q := geom.Coord{lineFlat[k*stride], lineFlat[k*stride+1]}
+					if d := segDist(q, a, b); d > threshold+1e-9 {
+						fail(ht, "SimplifyFlatCoords dropped point %d at distance %v > threshold %v\nidx %v\n%v", k, d, threshold, idx, lineFlat)
+					}
+				}
+			}
+		}
+	})
+}
+
+// checkHull judges xy.ConvexHullFlat of the points against the exact
+// monotone-chain hull: a Polygon of the extreme points (collinear boundary
+// points removed), closed and containing every input point, for three or
+// more distinct points; the segment for two; the point for one. shapes names
+// the recorded bugs the input has the shape of.
+func checkHull(ht *hegel.T, l geom.Layout, flat []float64, shapes []string) {
+	stride := l.Stride()
+	var pts [][2]float64
+	for p := range pointSet(flat, stride) {
+		pts = append(pts, p)
+	}
+	want := modelHull(pts)
+	var hull geom.T
+	if r := recovered(func() { hull = xy.ConvexHullFlat(l, flat) }); r != nil {
+		mismatch(ht, shapes, "ConvexHull panicked: %v\ninput %v", r, flat)
+	}
+	got := map[[2]float64]bool{}
+	if hull != nil {
+		for p := range pointSet(hull.FlatCoords(), stride) {
+			got[p] = true
+		}
+	}
+	switch {
+	case len(want) >= 3:
+		wantSet := map[[2]float64]bool{}
+		for _, p := range want {
+			wantSet[p] = true
+		}
+		if !reflect.DeepEqual(got, wantSet) || fmt.Sprintf("%T", hull) != "*geom.Polygon" {
+			mismatch(ht, shapes, "ConvexHull = %s\nextreme points %v\ninput %v", describe(hull), want, flat)
+		}
+		// the hull polygon is a closed ring that is convex and contains every input point
+		hf := hull.FlatCoords()
+		if hf[0] != hf[len(hf)-stride] || hf[1] != hf[len(hf)-stride+1] {
+			mismatch(ht, shapes, "hull ring not closed: %v", hf)
+		}
+		for i := 0; i+stride <= len(flat); i += stride {
+			if modelInRing(flat[i], flat[i+1], hf, stride) == 0 {
+				mismatch(ht, shapes, "input point (%v, %v) outside the hull %v", flat[i], flat[i+1], hf)
+			}
+		}
+	case len(want) == 2:
+		if fmt.Sprintf("%T", hull) != "*geom.LineString" || !reflect.DeepEqual(got, map[[2]float64]bool{want[0]: true, want[1]: true}) {
+			mismatch(ht, shapes, "ConvexHull of two distinct points = %s, want the segment %v\ninput %v", describe(hull), want, flat)
+		}
+	default:
+		if len(got) != 1 || !got[want[0]] {
+			mismatch(ht, shapes, "ConvexHull of one distinct point = %s, want %v\ninput %v", describe(hull), want, flat)
+		}
+	}
+}
+
+func segDist(p, a, b geom.Coord) float64 {
+	dx, dy := b[0]-a[0], b[1]-a[1]
+	if dx == 0 && dy == 0 {
+		return math.Hypot(p[0]-a[0], p[1]-a[1])
+	}
+	t := ((p[0]-a[0])*dx + (p[1]-a[1])*dy) / (dx*dx + dy*dy)
+	t = math.Max(0, math.Min(1, t))
+	return math.Hypot(p[0]-(a[0]+t*dx), p[1]-(a[1]+t*dy))
+}
+
+// ---------------------------------------------------------------------------
+// Structural identities.
+
+var structCases = hegel.Map(structGeoms, func(g geom.T) geomCase { return geomCase{g} })
+
+// TestHegelStructuralIdentities: Coords/SetCoords round-trip, Clone is
+// independent, Reverse twice is the identity and reverses each part,
+// Push extends, Bounds.Extend over parts equals the whole's Bounds, a
+// collection's layout is the union of its members' and its SRID is kept.
+func TestHegelStructuralIdentities(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		g := hegel.Draw(ht, structCases).g
+		l := g.Layout()
+
+		// Coords -> SetCoords reproduces the geometry
+		switch g := g.(type) {
+		case *geom.Point:
+			if !g.Empty() {
+				h, err := geom.NewPoint(l).SetCoords(g.Coords())
+				if err != nil || geomDiff(withoutSRID(g), h, "g") != "" {
+					fail(ht, "Point Coords/SetCoords: %v %s", err, describe(h))
+				}
+			}
+		case *geom.LineString:
+			h, err := geom.NewLineString(l).SetCoords(g.Coords())
+			if err != nil || geomDiff(withoutSRID(g), h, "g") != "" {
+				fail(ht, "LineString Coords/SetCoords: %v\n%s\n%s", err, describe(g), describe(h))
+			}
+		case *geom.Polygon:
+			h, err := geom.NewPolygon(l).SetCoords(g.Coords())
+			if err != nil || geomDiff(withoutSRID(g), h, "g") != "" {
+				fail(ht, "Polygon Coords/SetCoords: %v\n%s\n%s", err, describe(g), describe(h))
+			}
+		case *geom.MultiPoint:
+			h, err := geom.NewMultiPoint(l).SetCoords(g.Coords())
+			if err != nil || geomDiff(withoutSRID(g), h, "g") != "" {
+				fail(ht, "MultiPoint Coords/SetCoords: %v\n%s\n%s", err, describe(g), describe(h))
+			}
+		case *geom.MultiLineString:
+			h, err := geom.NewMultiLineString(l).SetCoords(g.Coords())
+			if err != nil || geomDiff(withoutSRID(g), h, "g") != "" {
+				fail(ht, "MultiLineString Coords/SetCoords: %v\n%s\n%s", err, describe(g), describe(h))
+			}
+		case *geom.MultiPolygon:
+			h, err := geom.NewMultiPolygon(l).SetCoords(g.Coords())
+			if err != nil || geomDiff(withoutSRID(g), h, "g") != "" {
+				fail(ht, "MultiPolygon Coords/SetCoords: %v\n%s\n%s", err, describe(g), describe(h))
+			}
+		}
+
+		// Clone is equal and independent
+		var cl geom.T
+		switch g := g.(type) {
+		case *geom.Point:
+			cl = g.Clone()
+		case *geom.LineString:
+			cl = g.Clone()
+		case *geom.Polygon:
+			cl = g.Clone()
+		case *geom.MultiPoint:
+			cl = g.Clone()
+		case *geom.MultiLineString:
+			cl = g.Clone()
+		case *geom.MultiPolygon:
+			cl = g.Clone()
+		}
+		if cl != nil {
+			if d := geomDiff(g, cl, "g"); d != "" {
+				fail(ht, "Clone differs: %s\n%s\n%s", d, describe(g), describe(cl))
+			}
+			if fc := cl.FlatCoords(); len(fc) > 0 {
+				orig := math.Float64bits(g.FlatCoords()[0])
+				fc[0] = 12345.5
+				if math.Float64bits(g.FlatCoords()[0]) != orig {
+					fail(ht, "Clone shares coordinates with the original")
+				}
+			}
+		}
+
+		// Reverse twice is the identity; once reverses each part
+		if rev, ok := g.(interface{ Reverse() }); ok && !hasWild(g) {
+			before := clone(g)
+			rev.Reverse()
+			checkReversed(ht, before, g)
+			rev.Reverse()
+			if d := geomDiff(before, g, "g"); d != "" {
+				fail(ht, "Reverse twice: %s\n%s\n%s", d, describe(before), describe(g))
+			}
+		}
+
+		// Bounds of the whole = union of the parts' bounds (the Bounds of a nested
+		// collection panic, go-geom/1; the check is skipped under HEGEL_NO_KNOWN=1)
+		if !hasWild(g) && !(Known.boundsExtendCollectionPanics && hasNestedCollection(g)) {
+			var b *geom.Bounds
+			if r := recovered(func() { b = g.Bounds() }); r != nil {
+				mismatch(ht, shapeIf(hasNestedCollection(g), "go-geom/1"), "Bounds panicked: %v\n%s", r, describe(g))
+			}
+			u := geom.NewBounds(g.Layout())
+			var parts []geom.T
+			switch g := g.(type) {
+			case *geom.Polygon:
+				for i := range g.NumLinearRings() {
+					parts = append(parts, g.LinearRing(i))
+				}
+			case *geom.MultiPoint:
+				for i := range g.NumPoints() {
+					parts = append(parts, g.Point(i))
+				}
+			case *geom.MultiLineString:
+				for i := range g.NumLineStrings() {
+					parts = append(parts, g.LineString(i))
+				}
+			case *geom.MultiPolygon:
+				for i := range g.NumPolygons() {
+					parts = append(parts, g.Polygon(i))
+				}
+			case *geom.GeometryCollection:
+				parts = g.Geoms()
+			}
+			if parts != nil {
+				for _, p := range parts {
+					u.Extend(p)
+				}
+				if _, isGC := g.(*geom.GeometryCollection); !isGC || sameLayouts(g.(*geom.GeometryCollection)) {
+					for d := 0; d < g.Layout().Stride(); d++ {
+						if math.Float64bits(b.Min(d)) != math.Float64bits(u.Min(d)) || math.Float64bits(b.Max(d)) != math.Float64bits(u.Max(d)) {
+							fail(ht, "Bounds dim %d [%v, %v] vs union of parts [%v, %v]\n%s", d, b.Min(d), b.Max(d), u.Min(d), u.Max(d), describe(g))
+						}
+					}
+				}
+				if _, isGC := g.(*geom.GeometryCollection); b.IsEmpty() != g.Empty() && (!isGC || sameLayouts(g.(*geom.GeometryCollection))) {
+					fail(ht, "Bounds.IsEmpty %v, Empty %v\n%s", b.IsEmpty(), g.Empty(), describe(g))
+				}
+			}
+		}
+
+		// collection layout = union of members (nothing from a member without a layout)
+		if gc, ok := g.(*geom.GeometryCollection); ok && gc.NumGeoms() > 0 {
+			z, m, any := false, false, false
+			for _, mem := range gc.Geoms() {
+				switch mem.Layout() {
+				case geom.XY:
+					any = true
+				case geom.XYZ:
+					z, any = true, true
+				case geom.XYM:
+					m, any = true, true
+				case geom.XYZM:
+					z, m, any = true, true, true
+				}
+			}
+			want := geom.NoLayout
+			switch {
+			case z && m:
+				want = geom.XYZM
+			case z:
+				want = geom.XYZ
+			case m:
+				want = geom.XYM
+			case any:
+				want = geom.XY
+			}
+			if gc.Layout() != want {
+				fail(ht, "collection layout %s, members imply %s\n%s", gc.Layout(), want, describe(gc))
+			}
+		}
+	})
+}
+
+func sameLayouts(gc *geom.GeometryCollection) bool {
+	for _, m := range gc.Geoms() {
+		if m.Layout() != gc.Layout() {
+			return false
+		}
+	}
+	return true
+}
+
+// checkReversed verifies that after Reverse each part's coordinate order is
+// reversed (parts keep their order).
+func checkReversed(ht *hegel.T, before, after geom.T) {
+	stride := before.Layout().Stride()
+	revPart := func(flat []float64) []float64 {
+		out := make([]float64, len(flat))
+		np := len(flat) / stride
+		for i := 0; i < np; i++ {
+			copy(out[i*stride:(i+1)*stride], flat[(np-1-i)*stride:(np-i)*stride])
+		}
+		return out
+	}
+	var want []float64
+	switch b := before.(type) {
+	case *geom.Point:
+		want = b.FlatCoords()
+	case *geom.LineString, *geom.LinearRing:
+		want = revPart(b.FlatCoords())
+	case *geom.Polygon, *geom.MultiLineString:
+		start := 0
+		for _, end := range b.Ends() {
+			want = append(want, revPart(b.FlatCoords()[start:end])...)
+			start = end
+		}
+	case *geom.MultiPoint:
+		start := 0
+		for _, end := range b.Ends() {
+			want = append(want, revPart(b.FlatCoords()[start:end])...)
+			start = end
+		}
+	case *geom.MultiPolygon:
+		start := 0
+		for _, ends := range b.Endss() {
+			for _, end := range ends {
+				want = append(want, revPart(b.FlatCoords()[start:end])...)
+				start = end
+			}
+		}
+	default:
+		return
+	}
+	if !bitsEqual(want, after.FlatCoords()) {
+		fail(ht, "Reverse: got %v, want %v\nbefore %s", after.FlatCoords(), want, describe(before))
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..43a8d2a
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,271 @@
+package geom_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged as the wide property that found
+// it judges, so that each bug has a property that finds it every run (the
+// wide properties in hegel_props_test.go reach the shapes at their natural
+// rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug
+// does not touch instead (a flat collection, a MultiPoint with every member
+// present, the empty member after the first, a collection of one layout, one
+// or two points, at most fifty points) and passes.
+
+import (
+	"encoding/json"
+	"reflect"
+	"slices"
+	"testing"
+
+	geom "github.com/twpayne/go-geom"
+	"github.com/twpayne/go-geom/encoding/geojson"
+	"github.com/twpayne/go-geom/encoding/wkt"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	// plainGeoms: geometries without empty parts, collections, wild values or
+	// SRIDs, of each layout.
+	plainGeoms = newGrammar(genOpts{})
+	// jsonLayouts: the layouts GeoJSON carries.
+	jsonLayouts = hegel.SampledFrom([]geom.Layout{geom.XY, geom.XYZ, geom.XYZM})
+)
+
+// nonEmpty: the non-empty geometries of g (about one in eight is empty).
+func nonEmpty(g hegel.Generator[geom.T]) hegel.Generator[geom.T] {
+	return hegel.Filter(g, func(g geom.T) bool { return !g.Empty() })
+}
+
+func collectionOf(ms []geom.T) geom.T { return geom.NewGeometryCollection().MustPush(ms...) }
+
+// --------------------------------------------------------------------------- go-geom/1
+
+// wrapped: the members as one nested collection (the shape of go-geom/1), or
+// under HEGEL_NO_KNOWN=1 spliced in flat.
+var wrapped = shaped(
+	func(ms []geom.T) []geom.T { return []geom.T{collectionOf(ms)} },
+	func(ms []geom.T) []geom.T { return ms },
+)
+
+// nestedCollections: a collection of up to two plain members of the layout
+// and, at a drawn position, a collection of up to two more.
+var nestedCollections = hegel.FlatMap(jsonLayouts, func(l geom.Layout) hegel.Generator[geomCase] {
+	members := plainGeoms.all[l]
+	return hegel.Composite(func(tc hegel.TestCase) geomCase {
+		outer := hegel.Draw(tc, many(members, 0, 2))
+		inner := hegel.Draw(tc, many(members, 0, 2))
+		at := hegel.Draw(tc, positions) % (len(outer) + 1)
+		return geomCase{collectionOf(slices.Insert(outer, at, wrapped(inner)...))}
+	})
+})
+
+// leafBounds extends b with every geometry inside g that is not a collection.
+func leafBounds(b *geom.Bounds, g geom.T) *geom.Bounds {
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		for _, m := range gc.Geoms() {
+			leafBounds(b, m)
+		}
+		return b
+	}
+	return b.Extend(g)
+}
+
+// TestHegelNestedCollectionBoundsDoNotPanic: the Bounds of a collection are
+// the union of its leaves' bounds, and the GeoJSON bbox option writes them;
+// Bounds.Extend panics on a collection member (go-geom/1).
+func TestHegelNestedCollectionBoundsDoNotPanic(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		g := hegel.Draw(ht, nestedCollections).g
+		var b *geom.Bounds
+		if r := recovered(func() { b = g.Bounds() }); r != nil {
+			mismatch(ht, known("go-geom/1"), "Bounds panicked: %v\n%s", r, describe(g))
+		}
+		u := leafBounds(geom.NewBounds(g.Layout()), g)
+		for d := 0; d < g.Layout().Stride(); d++ {
+			if b.Min(d) != u.Min(d) || b.Max(d) != u.Max(d) {
+				fail(ht, "Bounds dim %d [%v, %v] vs union of leaves [%v, %v]\n%s", d, b.Min(d), b.Max(d), u.Min(d), u.Max(d), describe(g))
+			}
+		}
+		if g.Empty() {
+			return // the bbox of an empty geometry is undefined
+		}
+		var bb []byte
+		var err error
+		if r := recovered(func() { bb, err = geojson.Marshal(g, geojson.EncodeGeometryWithBBox()) }); r != nil {
+			mismatch(ht, known("go-geom/1"), "Marshal with bbox panicked: %v\n%s", r, describe(g))
+		}
+		if err != nil {
+			fail(ht, "Marshal with bbox: %v\n%s", err, describe(g))
+		}
+		var obj struct {
+			BBox []float64 `json:"bbox"`
+		}
+		json.Unmarshal(bb, &obj)
+		if len(obj.BBox) == 0 {
+			fail(ht, "Marshal with bbox wrote no bbox: %s", bb)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-geom/2 and go-geom/3
+
+// checkGeoJSONRoundTrip: Marshal writes the model object and Unmarshal reads
+// it back to the same geometry.
+func checkGeoJSONRoundTrip(ht *hegel.T, g geom.T, shapes []string) {
+	b, err := geojson.Marshal(g)
+	if err != nil {
+		mismatch(ht, shapes, "geojson.Marshal: %v\n%s", err, describe(g))
+	}
+	var got, want any
+	if err := json.Unmarshal(b, &got); err != nil {
+		mismatch(ht, shapes, "Marshal output is not JSON: %v: %s", err, b)
+	}
+	json.Unmarshal([]byte(jsonText(modelGeoJSON(g))), &want)
+	if !reflect.DeepEqual(got, want) {
+		mismatch(ht, shapes, "GeoJSON differs\n got %s\nwant %s\n%s", b, jsonText(modelGeoJSON(g)), describe(g))
+	}
+	var back geom.T
+	if err := geojson.Unmarshal(b, &back); err != nil {
+		mismatch(ht, shapes, "geojson.Unmarshal(%s): %v\n%s", b, err, describe(g))
+	}
+	if d := geomDiff(expectedAfterGeoJSON(g), back, "g"); d != "" {
+		mismatch(ht, shapes, "GeoJSON round trip: %s\ntext %s\n in %s\nout %s", d, b, describe(g), describe(back))
+	}
+}
+
+// emptyMemberMultiPoints: a MultiPoint of up to three points of the layout
+// with an empty member at a drawn position (under HEGEL_NO_KNOWN=1 one more
+// point instead).
+var emptyMemberMultiPoints = hegel.FlatMap(jsonLayouts, func(l geom.Layout) hegel.Generator[geomCase] {
+	cs := coords(l, genOpts{})
+	extra := shaped(hegel.Just[geom.Coord](nil), cs)
+	return hegel.Composite(func(tc hegel.TestCase) geomCase {
+		ms := hegel.Draw(tc, many(cs, 0, 3))
+		at := hegel.Draw(tc, positions) % (len(ms) + 1)
+		return geomCase{geom.NewMultiPoint(l).MustSetCoords(slices.Insert(ms, at, hegel.Draw(tc, extra)))}
+	})
+})
+
+// TestHegelGeoJSONEmptyMultiPointMembersRoundTrip: a MultiPoint with an
+// empty member writes the model's positions (RFC 7946 has no empty position)
+// and reads back; geojson.Marshal writes a null, unreadable when first
+// (go-geom/2).
+func TestHegelGeoJSONEmptyMultiPointMembersRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkGeoJSONRoundTrip(ht, hegel.Draw(ht, emptyMemberMultiPoints).g, known("go-geom/2"))
+	})
+}
+
+// emptyAt is the position of the empty member among n others: the first
+// (the shape of go-geom/3), or under HEGEL_NO_KNOWN=1 after the pos-th.
+func emptyAt(n, pos int) int { return shaped(0, 1+pos%n) }
+
+// emptyFirstMultis: a MultiLineString or MultiPolygon of a layout with Z,
+// of one or two non-empty members and an empty one.
+var emptyFirstMultis = hegel.FlatMap(hegel.SampledFrom([]geom.Layout{geom.XYZ, geom.XYZM}), func(l geom.Layout) hegel.Generator[geomCase] {
+	cs := coords(l, genOpts{})
+	multiLines := hegel.Map(pairs(many(lines(cs, genOpts{}), 1, 2), positions), func(p pair[[][]geom.Coord, int]) geom.T {
+		return geom.NewMultiLineString(l).MustSetCoords(slices.Insert(p.a, emptyAt(len(p.a), p.b), []geom.Coord(nil)))
+	})
+	multiPolygons := hegel.Map(pairs(many(polygonRings(rings(cs, genOpts{}), genOpts{}), 1, 2), positions), func(p pair[[][][]geom.Coord, int]) geom.T {
+		return geom.NewMultiPolygon(l).MustSetCoords(slices.Insert(p.a, emptyAt(len(p.a), p.b), [][]geom.Coord(nil)))
+	})
+	return hegel.Map(hegel.OneOf(multiLines, multiPolygons), func(g geom.T) geomCase { return geomCase{g} })
+})
+
+// TestHegelGeoJSONEmptyFirstMemberRoundTrips: a multi-geometry with Z whose
+// first member is empty reads back with the layout of its other members;
+// geojson.Unmarshal takes the layout from the first member and fails with a
+// stride mismatch (go-geom/3).
+func TestHegelGeoJSONEmptyFirstMemberRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkGeoJSONRoundTrip(ht, hegel.Draw(ht, emptyFirstMultis).g, known("go-geom/3"))
+	})
+}
+
+// --------------------------------------------------------------------------- go-geom/4
+
+// mixedCollections: a collection of one or two non-empty geometries of one
+// layout and one or two of another (of the same one under HEGEL_NO_KNOWN=1),
+// in either order.
+var mixedCollections = hegel.FlatMap(pairs(hegel.Integers(0, 3), hegel.Integers(1, 3)), func(p pair[int, int]) hegel.Generator[geomCase] {
+	l1 := layouts[p.a]
+	l2 := shaped(layouts[(p.a+p.b)%len(layouts)], l1)
+	both := pairs(many(nonEmpty(plainGeoms.all[l1]), 1, 2), many(nonEmpty(plainGeoms.all[l2]), 1, 2))
+	return hegel.Map(pairs(both, hegel.Booleans()), func(p pair[pair[[]geom.T, []geom.T], bool]) geomCase {
+		ms := append(p.a.a, p.a.b...)
+		if p.b {
+			ms = append(p.a.b, p.a.a...)
+		}
+		return geomCase{collectionOf(ms)}
+	})
+})
+
+// TestHegelWKTMixedLayoutCollectionRoundTrips: the WKT of a collection whose
+// members have different layouts reads back to the same collection (or
+// Marshal refuses it); wkt.Marshal writes members the parser rejects as mixed
+// dimensionality (go-geom/4).
+func TestHegelWKTMixedLayoutCollectionRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		g := hegel.Draw(ht, mixedCollections).g
+		text, err := wkt.Marshal(g)
+		if err != nil {
+			return // refusing to write it is a consistent answer
+		}
+		back, err := wkt.Unmarshal(text)
+		if err != nil {
+			mismatch(ht, known("go-geom/4"), "Marshal wrote %q which Unmarshal rejects: %v", text, err)
+		}
+		if d := geomDiff(normalizeNoLayoutWKT(g), back, "g"); d != "" {
+			mismatch(ht, known("go-geom/4"), "WKT round trip: %s\ntext %s\n in %s\nout %s", d, text, describe(g), describe(back))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- go-geom/5 and go-geom/6
+
+func flatten(cs []geom.Coord) []float64 {
+	var flat []float64
+	for _, c := range cs {
+		flat = append(flat, c...)
+	}
+	return flat
+}
+
+var (
+	// intXY: an XY coordinate of small integers.
+	intXY = coords(geom.XY, genOpts{intCoordsOnly: true})
+	// fewDistinctSets: three to ten XY points taken from two (so among at
+	// most two distinct ones); under HEGEL_NO_KNOWN=1 one or two points.
+	fewDistinctSets = hegel.Map(pairs(fixed(intXY, 2), many(hegel.Integers(0, 1), shaped(3, 1), shaped(10, 2))), func(p pair[[]geom.Coord, []int]) []float64 {
+		var cs []geom.Coord
+		for _, k := range p.b {
+			cs = append(cs, p.a[k])
+		}
+		return flatten(cs)
+	})
+	// manyPointSets: 51 to 80 XY points of small integers among three or more
+	// distinct ones (fewer is go-geom/5's shape, which the shrinker would
+	// otherwise walk into); under HEGEL_NO_KNOWN=1 three to fifty.
+	manyPointSets = hegel.Filter(
+		hegel.Map(hegel.FlatMap(hegel.Integers(shaped(51, 3), shaped(80, 50)), func(n int) hegel.Generator[[]geom.Coord] { return fixed(intXY, n) }), flatten),
+		func(flat []float64) bool { return !fewDistinct(flat, 2) },
+	)
+)
+
+// TestHegelConvexHullOfFewDistinctPoints: the hull of three or more points
+// among fewer than three distinct ones is the point or the segment;
+// xy.ConvexHull returns coordinates that are not in the input (go-geom/5).
+func TestHegelConvexHullOfFewDistinctPoints(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkHull(ht, geom.XY, hegel.Draw(ht, fewDistinctSets), known("go-geom/5"))
+	})
+}
+
+// TestHegelConvexHullOfManyPointsKeepsExtremes: the hull of more than fifty
+// points is the polygon of the extreme points and contains every input
+// point; xy.ConvexHull's octant-ring reduction drops points beyond its
+// unclosed edge (go-geom/6).
+func TestHegelConvexHullOfManyPointsKeepsExtremes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkHull(ht, geom.XY, hegel.Draw(ht, manyPointSets), known("go-geom/6"))
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..9974f44
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,305 @@
+package geom_test
+
+// Hegel properties for github.com/twpayne/go-geom: the WKT, WKB, EWKB (and
+// hex) and GeoJSON codecs against model encoders written from the specs and
+// against each other, and the geometry algorithms (area, length, bounds,
+// orientation, centroids, convex hull, point-in-ring, simplification) against
+// exact-arithmetic models. No external tool is needed.
+//
+// Every property draws one case record built from generator values
+// (hegel_gen_test.go: a geometry grammar built once per option set, rings and
+// hull inputs as small records) and renders it with pure functions. The
+// shapes of the recorded bugs (bugs.toml) are drawn at their natural rate, so
+// the properties that meet them fail, naming the shape, and are the expected
+// failures mapped to the bugs (STYLE.md rule 11); hegel_pins_test.go holds
+// the regression examples. HEGEL_NO_KNOWN=1 switches the known shapes off
+// (noKnown, below) for a run that looks past the bugs.
+//
+// Set HEGEL_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// The recorded bugs.
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail, naming the shape (mismatch); under HEGEL_NO_KNOWN=1
+// the gates of Known are on: the shapes are left out of the generators (the
+// grammars' options), the checks they break are skipped, and a mismatch
+// that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); on means
+// the shape is left out, which is so only under HEGEL_NO_KNOWN=1. The pin
+// tests in hegel_pins_test.go assert the correct behaviour and fail while a
+// bug is open.
+var Known = struct {
+	// go-geom/1: Bounds.Extend calls FlatCoords on its argument, so it panics
+	// on a GeometryCollection; GeometryCollection.Bounds (and the GeoJSON
+	// bbox option) therefore panic on a nested collection.
+	boundsExtendCollectionPanics bool
+	// go-geom/2: geojson.Marshal writes an empty MultiPoint member as a null
+	// position; geojson.Unmarshal rejects such a text when the null comes
+	// first (the layout is guessed from the first position).
+	geojsonNullPositions bool
+	// go-geom/3: geojson.Unmarshal guesses the layout of a MultiLineString
+	// or MultiPolygon from its first member, so one whose first member is
+	// empty and whose others have Z or M fails with a stride mismatch.
+	geojsonLayoutFromFirstMember bool
+	// go-geom/4: wkt.Marshal writes a collection of mixed layouts as
+	// "GEOMETRYCOLLECTION Z (POINT (1 2), POINT Z (1 2 3))", which
+	// wkt.Unmarshal rejects as mixed dimensionality.
+	wktMixedLayoutCollection bool
+	// go-geom/5: xy.ConvexHull of three or more points with fewer than three
+	// distinct ones returns coordinates that are not in the input (zeros).
+	convexHullFewDistinct bool
+	// go-geom/6: for more than 50 points the octant-ring reduction uses an
+	// unclosed ring, so points outside its missing closing edge are dropped
+	// and the hull misses extreme points.
+	convexHullOpenOctRing bool
+}{
+	boundsExtendCollectionPanics: noKnown,
+	geojsonNullPositions:         noKnown,
+	geojsonLayoutFromFirstMember: noKnown,
+	wktMixedLayoutCollection:     noKnown,
+	convexHullFewDistinct:        noKnown,
+	convexHullOpenOctRing:        noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// known names the bug a property over its shape region is about, or nothing
+// under HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) []string { return shapeIf(!noKnown, id) }
+
+// mismatch reports a disagreement with the oracle on a case that has the
+// shape of the recorded bugs named (none for a plain failure): the failure
+// names the shape, and under HEGEL_NO_KNOWN=1 a disagreement on a known
+// shape is skipped instead (rare then, since the generators leave the
+// shapes out).
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(len(shapes) == 0)
+	}
+	if len(shapes) > 0 {
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// recovered runs fn and returns what it panicked with, nil when it returned.
+func recovered(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("PANIC in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	if len(choices) == 1 {
+		return choices[0].gen
+	}
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// fixed is a list of exactly k elements.
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(k).MaxSize(k)
+}
+
+// positions: an index into live data of unknown size (a text, a byte
+// string, a ring), taken modulo the size when applied, so that every drawn
+// value fits and the shrinker is free.
+var positions = hegel.Integers(0, 999)
+
+// tape is a drawn list of small integers that a pure renderer consumes in
+// order, recycled modulo its length, for the choices a text leaves free
+// (case, whitespace, number spellings). An empty tape answers 0 to every
+// question, so the shrunk form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to a hundred values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 100)
