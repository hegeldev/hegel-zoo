+package geom_test
+
+// Random geometries as generator values (a grammar built once per option
+// set), structural equality, and model encoders (WKT text, WKB and EWKB
+// bytes, GeoJSON) written from the specifications.
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"reflect"
+	"strconv"
+	"strings"
+
+	geom "github.com/twpayne/go-geom"
+	"hegel.dev/go/hegel"
+)
+
+var layouts = []geom.Layout{geom.XY, geom.XYZ, geom.XYM, geom.XYZM}
+
+// genOpts tunes a geometry grammar (newGrammar builds one per option set).
+type genOpts struct {
+	emptyPoints   bool // empty Points
+	nullPositions bool // empty MultiPoint members (with emptyPoints; the shape of go-geom/2 in GeoJSON)
+	emptyMembers  bool // empty LineStrings/Polygons inside multi-geometries
+	emptyFirst    bool // an empty member may come first in a Z or M MultiLineString/MultiPolygon (the shape of go-geom/3 in GeoJSON)
+	shortLines    bool // 1-point LineStrings, rings with fewer than 4 points or not closed
+	wildFloats    bool // NaN, infinities, -0, huge and tiny magnitudes
+	collections   bool // GeometryCollections (nested maxDepth deep)
+	mixedLayouts  bool // GeometryCollections whose members have different layouts (the shape of go-geom/4 in WKT)
+	srid          bool // a non-zero SRID
+	maxDepth      int
+	intCoordsOnly bool // small integer coordinates (exact arithmetic)
+}
+
+var coordPool = []float64{
+	0, 1, -1, 2, 3, -2, 5, 10, 100, 0.5, -0.5, 2.5, -3.25, 0.1, 0.25, 1e6, 123456.789, 7.5e-3, 42, -17, 1e-7, 0.001, 1e15,
+}
+
+var (
+	// poolValues: the hand-picked coordinate values.
+	poolValues = hegel.SampledFrom(coordPool)
+	// randomValues: any finite float64 but a negative zero (a wild value).
+	randomValues = hegel.Filter(hegel.Floats[float64]().AllowNaN(false).AllowInfinity(false), func(x float64) bool { return x != 0 || !math.Signbit(x) })
+	// wildValues: the values a codec may choke on.
+	wildValues = hegel.SampledFrom([]float64{math.NaN(), math.Inf(1), math.Inf(-1), math.Copysign(0, -1), 1e300, -1e300, 5e-324, math.MaxFloat64, 4.9e-324})
+	// intValues: small integers, exact in every algorithm.
+	intValues = hegel.Map(hegel.Integers(-12, 12), func(i int) float64 { return float64(i) })
+	// srids: none six times in ten, else one of five.
+	srids = maybe(40, hegel.SampledFrom([]int{4326, 3857, 1, 900913, 32633}))
+)
+
+// values: one coordinate value: from the pool about four times in five, a
+// random finite float 15% of the time, a wild one 8% when wildFloats; small
+// integers only when intCoordsOnly.
+func values(o genOpts) hegel.Generator[float64] {
+	if o.intCoordsOnly {
+		return intValues
+	}
+	if o.wildFloats {
+		return weighted(choice[float64]{77, poolValues}, choice[float64]{15, randomValues}, choice[float64]{8, wildValues})
+	}
+	return weighted(choice[float64]{85, poolValues}, choice[float64]{15, randomValues})
+}
+
+// coords: a coordinate of the layout.
+func coords(l geom.Layout, o genOpts) hegel.Generator[geom.Coord] {
+	return hegel.Map(fixed(values(o), l.Stride()), func(xs []float64) geom.Coord { return geom.Coord(xs) })
+}
+
+// closeRing repeats the first coordinate at the end.
+func closeRing(cs []geom.Coord) []geom.Coord { return append(cs, cs[0].Clone()) }
+
+// lines: a LineString's coordinates: two to five points, or (by option) none
+// 15% of the time, or one.
+func lines(cs hegel.Generator[geom.Coord], o genOpts) hegel.Generator[[]geom.Coord] {
+	alts := []choice[[]geom.Coord]{{70, many(cs, 2, 5)}}
+	if o.emptyMembers {
+		alts = append(alts, choice[[]geom.Coord]{15, hegel.Just[[]geom.Coord](nil)})
+	}
+	if o.shortLines {
+		alts = append(alts, choice[[]geom.Coord]{15, many(cs, 1, 1)})
+	}
+	return weighted(alts...)
+}
+
+// rings: a closed ring of three to six points plus the first again, or (by
+// option) a short one of up to three points 15% of the time, or an unclosed
+// one of four to seven 20%.
+func rings(cs hegel.Generator[geom.Coord], o genOpts) hegel.Generator[[]geom.Coord] {
+	alts := []choice[[]geom.Coord]{{65, hegel.Map(many(cs, 3, 6), closeRing)}}
+	if o.shortLines {
+		alts = append(alts, choice[[]geom.Coord]{15, many(cs, 0, 3)}, choice[[]geom.Coord]{20, many(cs, 4, 7)})
+	}
+	return weighted(alts...)
+}
+
+// polygonRings: one to three rings, or (by option) none 15% of the time.
+func polygonRings(rs hegel.Generator[[]geom.Coord], o genOpts) hegel.Generator[[][]geom.Coord] {
+	if !o.emptyMembers {
+		return many(rs, 1, 3)
+	}
+	return weighted(choice[[][]geom.Coord]{85, many(rs, 1, 3)}, choice[[][]geom.Coord]{15, hegel.Just[[][]geom.Coord](nil)})
+}
+
+// polygonEmpty: a polygon without rings, or with empty rings only.
+func polygonEmpty(rs [][]geom.Coord) bool {
+	for _, r := range rs {
+		if len(r) > 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// leadNonEmpty swaps the first non-empty member to the front: the layout of
+// a GeoJSON multi-geometry is read from its first member (go-geom/3), a
+// shape the grammar leaves out under HEGEL_NO_KNOWN=1.
+func leadNonEmpty[T any](ms []T, empty func(T) bool) []T {
+	for i, m := range ms {
+		if !empty(m) {
+			ms[0], ms[i] = m, ms[0]
+			break
+		}
+	}
+	return ms
+}
+
+// grammar: the geometries of every layout under one option set. A geometry
+// is a Point, LineString, Polygon, MultiPoint, MultiLineString or
+// MultiPolygon (in that order: the first is what a case shrinks to) or, when
+// collections are on, two times in eight a GeometryCollection of up to three
+// members, nested maxDepth deep (the depth counter lives in the closure and
+// is restored by defer, hegel-go's ExampleComposite_recursive); a member has
+// the collection's layout or, when mixedLayouts, any layout 30% of the time;
+// an empty collection takes its layout half of the time (else NoLayout);
+// any geometry carries an SRID 40% of the time when srid.
+type grammar struct {
+	depth int
+	all   map[geom.Layout]hegel.Generator[geom.T]
+}
+
+func newGrammar(o genOpts) *grammar {
+	gr := &grammar{all: map[geom.Layout]hegel.Generator[geom.T]{}}
+	for _, l := range layouts {
+		gr.all[l] = gr.geometries(l, o)
+	}
+	return gr
+}
+
+// of: a geometry of one of the layouts.
+func (gr *grammar) of(ls ...geom.Layout) hegel.Generator[geom.T] {
+	return hegel.FlatMap(hegel.SampledFrom(ls), func(l geom.Layout) hegel.Generator[geom.T] { return gr.all[l] })
+}
+
+func (gr *grammar) geometries(l geom.Layout, o genOpts) hegel.Generator[geom.T] {
+	cs := coords(l, o)
+	pointCoords := cs
+	if o.emptyPoints {
+		pointCoords = weighted(choice[geom.Coord]{85, cs}, choice[geom.Coord]{15, hegel.Just[geom.Coord](nil)})
+	}
+	members := cs
+	if o.emptyPoints && o.nullPositions {
+		members = weighted(choice[geom.Coord]{80, cs}, choice[geom.Coord]{20, hegel.Just[geom.Coord](nil)})
+	}
+	ls := lines(cs, o)
+	ps := polygonRings(rings(cs, o), o)
+	lineLists, polyLists := many(ls, 0, 3), many(ps, 0, 3)
+	if !o.emptyFirst && l != geom.XY {
+		lineLists = hegel.Map(lineLists, func(ms [][]geom.Coord) [][]geom.Coord {
+			return leadNonEmpty(ms, func(m []geom.Coord) bool { return len(m) == 0 })
+		})
+		polyLists = hegel.Map(polyLists, func(ms [][][]geom.Coord) [][][]geom.Coord { return leadNonEmpty(ms, polygonEmpty) })
+	}
+	flats := []hegel.Generator[geom.T]{
+		hegel.Map(pointCoords, func(c geom.Coord) geom.T {
+			if c == nil {
+				return geom.NewPointEmpty(l)
+			}
+			return geom.NewPoint(l).MustSetCoords(c)
+		}),
+		hegel.Map(ls, func(c []geom.Coord) geom.T { return geom.NewLineString(l).MustSetCoords(c) }),
+		hegel.Map(ps, func(rs [][]geom.Coord) geom.T { return geom.NewPolygon(l).MustSetCoords(rs) }),
+		hegel.Map(many(members, 0, 4), func(cs []geom.Coord) geom.T { return geom.NewMultiPoint(l).MustSetCoords(cs) }),
+		hegel.Map(lineLists, func(ms [][]geom.Coord) geom.T { return geom.NewMultiLineString(l).MustSetCoords(ms) }),
+		hegel.Map(polyLists, func(ms [][][]geom.Coord) geom.T { return geom.NewMultiPolygon(l).MustSetCoords(ms) }),
+	}
+	flat := hegel.OneOf(flats...)
+	g := flat
+	if o.collections {
+		memberLayouts := hegel.Just(l)
+		if o.mixedLayouts {
+			memberLayouts = weighted(choice[geom.Layout]{70, hegel.Just(l)}, choice[geom.Layout]{30, hegel.SampledFrom(layouts)})
+		}
+		member := hegel.FlatMap(memberLayouts, func(ml geom.Layout) hegel.Generator[geom.T] { return gr.all[ml] })
+		collection := hegel.Map(pairs(many(member, 0, 3), chance(50)), func(p pair[[]geom.T, bool]) geom.T {
+			gc := geom.NewGeometryCollection().MustPush(p.a...)
+			if len(p.a) == 0 && p.b {
+				gc.MustSetLayout(l)
+			}
+			return gc
+		})
+		nested := hegel.OneOf(append(append([]hegel.Generator[geom.T]{}, flats...), collection, collection)...)
+		g = hegel.Composite(func(tc hegel.TestCase) geom.T {
+			if gr.depth >= o.maxDepth {
+				return hegel.Draw(tc, flat)
+			}
+			gr.depth++
+			defer func() { gr.depth-- }()
+			return hegel.Draw(tc, nested)
+		})
+	}
+	if !o.srid {
+		return g
+	}
+	return hegel.Map(pairs(g, srids), func(p pair[geom.T, int]) geom.T {
+		if p.b == 0 {
+			return p.a
+		}
+		g, _ := geom.SetSRID(p.a, p.b)
+		return g
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Structural equality and description.
+
+func bitsEqual(a, b []float64) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if math.Float64bits(a[i]) != math.Float64bits(b[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func intsEqual(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// geomDiff returns "" when a and b are the same geometry (type, layout, SRID,
+// coordinates bit for bit, structure), else a description of the difference.
+func geomDiff(a, b geom.T, path string) string {
+	if isNil(a) || isNil(b) {
+		if isNil(a) && isNil(b) {
+			return ""
+		}
+		return fmt.Sprintf("%s: one side is nil (%T vs %T)", path, a, b)
+	}
+	if fmt.Sprintf("%T", a) != fmt.Sprintf("%T", b) {
+		return fmt.Sprintf("%s: type %T vs %T", path, a, b)
+	}
+	if a.Layout() != b.Layout() {
+		return fmt.Sprintf("%s: layout %s vs %s", path, a.Layout(), b.Layout())
+	}
+	if a.SRID() != b.SRID() {
+		return fmt.Sprintf("%s: SRID %d vs %d", path, a.SRID(), b.SRID())
+	}
+	if ga, ok := a.(*geom.GeometryCollection); ok {
+		gb := b.(*geom.GeometryCollection)
+		if ga.NumGeoms() != gb.NumGeoms() {
+			return fmt.Sprintf("%s: %d vs %d members", path, ga.NumGeoms(), gb.NumGeoms())
+		}
+		for i := range ga.Geoms() {
+			if d := geomDiff(ga.Geom(i), gb.Geom(i), fmt.Sprintf("%s[%d]", path, i)); d != "" {
+				return d
+			}
+		}
+		return ""
+	}
+	if !bitsEqual(a.FlatCoords(), b.FlatCoords()) {
+		return fmt.Sprintf("%s: coords %v vs %v", path, a.FlatCoords(), b.FlatCoords())
+	}
+	if !intsEqual(a.Ends(), b.Ends()) {
+		return fmt.Sprintf("%s: ends %v vs %v", path, a.Ends(), b.Ends())
+	}
+	ea, eb := a.Endss(), b.Endss()
+	if len(ea) != len(eb) {
+		return fmt.Sprintf("%s: endss %v vs %v", path, ea, eb)
+	}
+	for i := range ea {
+		if !intsEqual(ea[i], eb[i]) {
+			return fmt.Sprintf("%s: endss %v vs %v", path, ea, eb)
+		}
+	}
+	return ""
+}
+
+// isNil reports a nil interface or a typed nil pointer.
+func isNil(g geom.T) bool {
+	if g == nil {
+		return true
+	}
+	v := reflect.ValueOf(g)
+	return v.Kind() == reflect.Pointer && v.IsNil()
+}
+
+// describe renders a geometry for messages.
+func describe(g geom.T) string {
+	if isNil(g) {
+		return fmt.Sprintf("<nil %T>", g)
+	}
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		var parts []string
+		for _, m := range gc.Geoms() {
+			parts = append(parts, describe(m))
+		}
+		return fmt.Sprintf("GC{layout=%s srid=%d [%s]}", gc.Layout(), gc.SRID(), strings.Join(parts, ", "))
+	}
+	s := fmt.Sprintf("%T{layout=%s srid=%d coords=%v", g, g.Layout(), g.SRID(), g.FlatCoords())
+	if e := g.Ends(); e != nil {
+		s += fmt.Sprintf(" ends=%v", e)
+	}
+	if e := g.Endss(); e != nil {
+		s += fmt.Sprintf(" endss=%v", e)
+	}
+	return s + "}"
+}
+
+// geomCase is a case of one geometry (what the draw report prints).
+type geomCase struct{ g geom.T }
+
+func (c geomCase) GoString() string { return describe(c.g) }
+
+// clone deep-copies a geometry through its coordinates (independent of the
+// library's Clone).
+func clone(g geom.T) geom.T {
+	switch g := g.(type) {
+	case *geom.Point:
+		if g.Empty() {
+			return geom.NewPointEmpty(g.Layout()).SetSRID(g.SRID())
+		}
+		return geom.NewPointFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...)).SetSRID(g.SRID())
+	case *geom.LineString:
+		return geom.NewLineStringFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...)).SetSRID(g.SRID())
+	case *geom.LinearRing:
+		return geom.NewLinearRingFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...)).SetSRID(g.SRID())
+	case *geom.Polygon:
+		return geom.NewPolygonFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...), append([]int(nil), g.Ends()...)).SetSRID(g.SRID())
+	case *geom.MultiPoint:
+		return geom.NewMultiPointFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...), geom.NewMultiPointFlatOptionWithEnds(append([]int(nil), g.Ends()...))).SetSRID(g.SRID())
+	case *geom.MultiLineString:
+		return geom.NewMultiLineStringFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...), append([]int(nil), g.Ends()...)).SetSRID(g.SRID())
+	case *geom.MultiPolygon:
+		var endss [][]int
+		for _, e := range g.Endss() {
+			endss = append(endss, append([]int(nil), e...))
+		}
+		return geom.NewMultiPolygonFlat(g.Layout(), append([]float64(nil), g.FlatCoords()...), endss).SetSRID(g.SRID())
+	case *geom.GeometryCollection:
+		gc := geom.NewGeometryCollection().SetSRID(g.SRID())
+		for _, m := range g.Geoms() {
+			gc.MustPush(clone(m))
+		}
+		if g.NumGeoms() == 0 {
+			gc.MustSetLayout(g.Layout())
+		}
+		return gc
+	}
+	panic(fmt.Sprintf("clone: %T", g))
+}
+
+// normalizeNoLayout returns a copy of g in which empty collections without a
+// layout have layout XY: no codec can carry NoLayout, an empty collection
+// reads back as XY (WKB/EWKB, where every member carries its own type).
+func normalizeNoLayout(g geom.T) geom.T { return normalizeNoLayoutTo(g, geom.XY, false) }
+
+// normalizeNoLayoutWKT is the WKT reading: an EMPTY member without a layout
+// suffix takes the enclosing collection's layout, XY at the top.
+func normalizeNoLayoutWKT(g geom.T) geom.T { return normalizeNoLayoutTo(g, geom.XY, true) }
+
+func normalizeNoLayoutTo(g geom.T, l geom.Layout, inherit bool) geom.T {
+	var fix func(geom.T, geom.Layout) geom.T
+	fix = func(g geom.T, l geom.Layout) geom.T {
+		if gc, ok := g.(*geom.GeometryCollection); ok {
+			if gc.NumGeoms() == 0 {
+				layout := gc.Layout()
+				if layout == geom.NoLayout || (inherit && layout == geom.XY) {
+					layout = l
+				}
+				return geom.NewGeometryCollection().MustSetLayout(layout).SetSRID(gc.SRID())
+			}
+			ml := geom.XY
+			if inherit && gc.Layout() != geom.NoLayout {
+				ml = gc.Layout()
+			}
+			if inherit && gc.Layout() == geom.NoLayout {
+				ml = l
+			}
+			out := geom.NewGeometryCollection().SetSRID(gc.SRID())
+			for _, m := range gc.Geoms() {
+				out.MustPush(fix(m, ml))
+			}
+			return out
+		}
+		// in WKT an EMPTY member without a Z/M suffix takes the collection's layout
+		if inherit && g.Empty() && g.Layout() == geom.XY && l != geom.XY {
+			return withLayout(g, l)
+		}
+		return clone(g)
+	}
+	return fix(g, l)
+}
+
+// withLayout returns an empty geometry of g's type and SRID with layout l.
+func withLayout(g geom.T, l geom.Layout) geom.T {
+	var out geom.T
+	switch g := g.(type) {
+	case *geom.Point:
+		out = geom.NewPointEmpty(l)
+	case *geom.LineString:
+		out = geom.NewLineString(l)
+	case *geom.Polygon:
+		out = geom.NewPolygonFlat(l, nil, g.Ends())
+	case *geom.MultiPoint:
+		out = geom.NewMultiPointFlat(l, nil, geom.NewMultiPointFlatOptionWithEnds(g.Ends()))
+	case *geom.MultiLineString:
+		out = geom.NewMultiLineStringFlat(l, nil, g.Ends())
+	case *geom.MultiPolygon:
+		out = geom.NewMultiPolygonFlat(l, nil, g.Endss())
+	default:
+		panic(fmt.Sprintf("withLayout: %T", g))
+	}
+	out, _ = geom.SetSRID(out, g.SRID())
+	return out
+}
+
+// hasEmptyFirstMember reports a MultiLineString or MultiPolygon (anywhere in
+// g) whose first member is empty and a later one is not, while its layout is
+// not XY (the shape of go-geom/3; with every member empty the text reads
+// back as XY, which the properties expect).
+func hasEmptyFirstMember(g geom.T) bool {
+	switch g := g.(type) {
+	case *geom.MultiLineString:
+		return g.Layout() != geom.XY && g.NumLineStrings() > 0 && g.Ends()[0] == 0 && len(g.FlatCoords()) > 0
+	case *geom.MultiPolygon:
+		if g.Layout() == geom.XY || g.NumPolygons() == 0 || len(g.FlatCoords()) == 0 {
+			return false
+		}
+		e := g.Endss()[0]
+		return len(e) == 0 || e[len(e)-1] == 0
+	case *geom.GeometryCollection:
+		for _, m := range g.Geoms() {
+			if hasEmptyFirstMember(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasNestedCollection reports a GeometryCollection member that is itself a
+// collection.
+func hasNestedCollection(g geom.T) bool {
+	gc, ok := g.(*geom.GeometryCollection)
+	if !ok {
+		return false
+	}
+	for _, m := range gc.Geoms() {
+		if _, ok := m.(*geom.GeometryCollection); ok {
+			return true
+		}
+	}
+	return false
+}
+
+// hasMixedLayouts reports a collection (anywhere in g) with a non-empty
+// member whose layout differs from the collection's.
+func hasMixedLayouts(g geom.T) bool {
+	gc, ok := g.(*geom.GeometryCollection)
+	if !ok {
+		return false
+	}
+	for _, m := range gc.Geoms() {
+		// an empty member without a suffix (XY or no layout) is written as a
+		// bare EMPTY, which the parser accepts in any collection
+		if m.Layout() != gc.Layout() && !(m.Empty() && (m.Layout() == geom.XY || m.Layout() == geom.NoLayout)) {
+			return true
+		}
+		if hasMixedLayouts(m) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasEmptyMultiPointMember reports a MultiPoint with an empty member anywhere in g.
+func hasEmptyMultiPointMember(g geom.T) bool {
+	switch g := g.(type) {
+	case *geom.MultiPoint:
+		for i := range g.NumPoints() {
+			if g.Coord(i) == nil {
+				return true
+			}
+		}
+	case *geom.GeometryCollection:
+		for _, m := range g.Geoms() {
+			if hasEmptyMultiPointMember(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// hasWild reports NaN or infinite coordinates anywhere in g.
+func hasWild(g geom.T) bool {
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		for _, m := range gc.Geoms() {
+			if hasWild(m) {
+				return true
+			}
+		}
+		return false
+	}
+	for _, x := range g.FlatCoords() {
+		if math.IsNaN(x) || math.IsInf(x, 0) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Model WKT.
+
+func fmtCoord(x float64) string { return strconv.FormatFloat(x, 'f', -1, 64) }
+
+func modelCoord(c []float64) string {
+	parts := make([]string, len(c))
+	for i, x := range c {
+		parts[i] = fmtCoord(x)
+	}
+	return strings.Join(parts, " ")
+}
+
+func modelCoordList(flat []float64, stride int) string {
+	var parts []string
+	for i := 0; i+stride <= len(flat); i += stride {
+		parts = append(parts, modelCoord(flat[i:i+stride]))
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+func modelRings(flat []float64, start int, ends []int, stride int) string {
+	var parts []string
+	for _, end := range ends {
+		if end <= start {
+			parts = append(parts, "EMPTY")
+		} else {
+			parts = append(parts, modelCoordList(flat[start:end], stride))
+		}
+		start = end
+	}
+	return "(" + strings.Join(parts, ", ") + ")"
+}
+
+func layoutSuffix(l geom.Layout) string {
+	switch l {
+	case geom.XYZ:
+		return "Z "
+	case geom.XYM:
+		return "M "
+	case geom.XYZM:
+		return "ZM "
+	}
+	return ""
+}
+
+// modelWKT writes the WKT of g in the library's canonical spacing
+// ("POINT Z (1 2 3)", members separated by ", ", "EMPTY" for empties).
+func modelWKT(g geom.T) string {
+	l := g.Layout()
+	stride := l.Stride()
+	switch g := g.(type) {
+	case *geom.Point:
+		if g.Empty() {
+			return "POINT " + layoutSuffix(l) + "EMPTY"
+		}
+		return "POINT " + layoutSuffix(l) + "(" + modelCoord(g.FlatCoords()) + ")"
+	case *geom.LineString:
+		if g.Empty() {
+			return "LINESTRING " + layoutSuffix(l) + "EMPTY"
+		}
+		return "LINESTRING " + layoutSuffix(l) + modelCoordList(g.FlatCoords(), stride)
+	case *geom.Polygon:
+		if g.NumLinearRings() == 0 {
+			return "POLYGON " + layoutSuffix(l) + "EMPTY"
+		}
+		return "POLYGON " + layoutSuffix(l) + modelRings(g.FlatCoords(), 0, g.Ends(), stride)
+	case *geom.MultiPoint:
+		if g.NumPoints() == 0 {
+			return "MULTIPOINT " + layoutSuffix(l) + "EMPTY"
+		}
+		var parts []string
+		start := 0
+		for _, end := range g.Ends() {
+			if end <= start {
+				parts = append(parts, "EMPTY")
+			} else {
+				parts = append(parts, modelCoord(g.FlatCoords()[start:end]))
+			}
+			start = end
+		}
+		return "MULTIPOINT " + layoutSuffix(l) + "(" + strings.Join(parts, ", ") + ")"
+	case *geom.MultiLineString:
+		if g.NumLineStrings() == 0 {
+			return "MULTILINESTRING " + layoutSuffix(l) + "EMPTY"
+		}
+		return "MULTILINESTRING " + layoutSuffix(l) + modelRings(g.FlatCoords(), 0, g.Ends(), stride)
+	case *geom.MultiPolygon:
+		if g.NumPolygons() == 0 {
+			return "MULTIPOLYGON " + layoutSuffix(l) + "EMPTY"
+		}
+		var parts []string
+		start := 0
+		for _, ends := range g.Endss() {
+			if len(ends) == 0 {
+				parts = append(parts, "EMPTY")
+			} else {
+				parts = append(parts, modelRings(g.FlatCoords(), start, ends, stride))
+				start = ends[len(ends)-1]
+			}
+		}
+		return "MULTIPOLYGON " + layoutSuffix(l) + "(" + strings.Join(parts, ", ") + ")"
+	case *geom.GeometryCollection:
+		if g.NumGeoms() == 0 {
+			return "GEOMETRYCOLLECTION " + layoutSuffix(l) + "EMPTY"
+		}
+		var parts []string
+		for _, m := range g.Geoms() {
+			parts = append(parts, modelWKT(m))
+		}
+		return "GEOMETRYCOLLECTION " + layoutSuffix(l) + "(" + strings.Join(parts, ", ") + ")"
+	}
+	panic(fmt.Sprintf("modelWKT: %T", g))
+}
+
+// styledWKT rewrites a canonical WKT into an equivalent text, every choice
+// read from the tape (an empty tape leaves the text as it is): a keyword in
+// lower case (30%) or title case (15%), "POINT Z" as "POINTZ" (half of the
+// time), a doubled space, a newline or tabs for a space (one time in six
+// each), spaces around brackets and commas (20% each side), a number with an
+// exponent or with trailing zeros (one time in five each).
+func styledWKT(s string, t *tape) string {
+	var sb strings.Builder
+	i := 0
+	for i < len(s) {
+		c := s[i]
+		switch {
+		case c >= 'A' && c <= 'Z':
+			j := i
+			for j < len(s) && s[j] >= 'A' && s[j] <= 'Z' {
+				j++
+			}
+			word := s[i:j]
+			switch k := t.next(100); {
+			case k >= 70:
+				word = strings.ToLower(word)
+			case k >= 55:
+				word = word[:1] + strings.ToLower(word[1:])
+			}
+			sb.WriteString(word)
+			i = j
+		case c == ' ':
+			// "POINT Z" -> "POINTZ" when the next word is a suffix
+			rest := s[i+1:]
+			if (strings.HasPrefix(rest, "Z ") || strings.HasPrefix(rest, "M ") || strings.HasPrefix(rest, "ZM ")) && i > 0 && s[i-1] >= 'A' && s[i-1] <= 'Z' && t.coin(50) {
+				i++
+				continue
+			}
+			switch t.next(6) {
+			case 3:
+				sb.WriteString("  ")
+			case 4:
+				sb.WriteString("\n")
+			case 5:
+				sb.WriteString(" \t ")
+			default:
+				sb.WriteByte(' ')
+			}
+			i++
+		case c == '(' || c == ')' || c == ',':
+			if t.coin(20) {
+				sb.WriteByte(' ')
+			}
+			sb.WriteByte(c)
+			if t.coin(20) {
+				sb.WriteByte(' ')
+			}
+			i++
+		case c == '-' || c == '.' || (c >= '0' && c <= '9'):
+			j := i
+			for j < len(s) && (s[j] == '-' || s[j] == '.' || (s[j] >= '0' && s[j] <= '9')) {
+				j++
+			}
+			num := s[i:j]
+			if f, err := strconv.ParseFloat(num, 64); err == nil {
+				switch t.next(5) {
+				case 1:
+					num = strconv.FormatFloat(f, 'e', -1, 64)
+				case 2:
+					num = strconv.FormatFloat(f, 'E', -1, 64)
+				case 3:
+					if !strings.Contains(num, ".") {
+						num += ".0"
+					}
+				case 4:
+					if strings.Contains(num, ".") {
+						num += "00"
+					}
+				}
+			}
+			sb.WriteString(num)
+			i = j
+		default:
+			sb.WriteByte(c)
+			i++
+		}
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------------------
+// Model WKB / EWKB.
+
+func wkbTypeID(g geom.T) uint32 {
+	switch g.(type) {
+	case *geom.Point:
+		return 1
+	case *geom.LineString:
+		return 2
+	case *geom.Polygon:
+		return 3
+	case *geom.MultiPoint:
+		return 4
+	case *geom.MultiLineString:
+		return 5
+	case *geom.MultiPolygon:
+		return 6
+	case *geom.GeometryCollection:
+		return 7
+	}
+	panic(fmt.Sprintf("wkbTypeID: %T", g))
+}
+
+type wkbWriter struct {
+	buf  []byte
+	bo   binary.ByteOrder
+	ewkb bool
+}
+
+func (w *wkbWriter) u32(v uint32) {
+	var b [4]byte
+	w.bo.PutUint32(b[:], v)
+	w.buf = append(w.buf, b[:]...)
+}
+
+func (w *wkbWriter) f64(v float64) {
+	var b [8]byte
+	w.bo.PutUint64(b[:], math.Float64bits(v))
+	w.buf = append(w.buf, b[:]...)
+}
+
+func (w *wkbWriter) coords(flat []float64) {
+	for _, x := range flat {
+		w.f64(x)
+	}
+}
+
+func (w *wkbWriter) header(g geom.T) {
+	if w.bo == binary.BigEndian {
+		w.buf = append(w.buf, 0)
+	} else {
+		w.buf = append(w.buf, 1)
+	}
+	t := wkbTypeID(g)
+	l := g.Layout()
+	if w.ewkb {
+		switch l {
+		case geom.XYZ:
+			t |= 0x80000000
+		case geom.XYM:
+			t |= 0x40000000
+		case geom.XYZM:
+			t |= 0xC0000000
+		}
+		if g.SRID() != 0 {
+			t |= 0x20000000
+		}
+		w.u32(t)
+		if g.SRID() != 0 {
+			w.u32(uint32(g.SRID()))
+		}
+		return
+	}
+	switch l {
+	case geom.XYZ:
+		t += 1000
+	case geom.XYM:
+		t += 2000
+	case geom.XYZM:
+		t += 3000
+	}
+	w.u32(t)
+}
+
+// write appends the (E)WKB of g. Empty points are written as NaN
+// coordinates (the EWKB convention, and the library's option for WKB).
+func (w *wkbWriter) write(g geom.T) {
+	w.header(g)
+	stride := g.Layout().Stride()
+	switch g := g.(type) {
+	case *geom.Point:
+		if g.Empty() {
+			for i := 0; i < stride; i++ {
+				w.f64(geom.PointEmptyCoord())
+			}
+		} else {
+			w.coords(g.FlatCoords())
+		}
+	case *geom.LineString:
+		w.u32(uint32(g.NumCoords()))
+		w.coords(g.FlatCoords())
+	case *geom.Polygon:
+		w.u32(uint32(g.NumLinearRings()))
+		start := 0
+		for _, end := range g.Ends() {
+			w.u32(uint32((end - start) / stride))
+			w.coords(g.FlatCoords()[start:end])
+			start = end
+		}
+	case *geom.MultiPoint:
+		w.u32(uint32(g.NumPoints()))
+		for i := range g.NumPoints() {
+			p := g.Point(i) // member SRID is not carried
+			w.write(p)
+		}
+	case *geom.MultiLineString:
+		w.u32(uint32(g.NumLineStrings()))
+		for i := range g.NumLineStrings() {
+			w.write(g.LineString(i))
+		}
+	case *geom.MultiPolygon:
+		w.u32(uint32(g.NumPolygons()))
+		for i := range g.NumPolygons() {
+			w.write(g.Polygon(i))
+		}
+	case *geom.GeometryCollection:
+		w.u32(uint32(g.NumGeoms()))
+		for _, m := range g.Geoms() {
+			w.write(m)
+		}
+	}
+}
+
+func modelWKB(g geom.T, bo binary.ByteOrder, ewkb bool) []byte {
+	w := &wkbWriter{bo: bo, ewkb: ewkb}
+	w.write(g)
+	return w.buf
+}
+
+// ---------------------------------------------------------------------------
+// Model GeoJSON.
+
+func jsonCoord(c []float64) any {
+	out := make([]any, len(c))
+	for i, x := range c {
+		out[i] = x
+	}
+	return out
+}
+
+func jsonCoords1(flat []float64, stride int) []any {
+	out := []any{}
+	for i := 0; i+stride <= len(flat); i += stride {
+		out = append(out, jsonCoord(flat[i:i+stride]))
+	}
+	return out
+}
+
+func jsonCoords2(flat []float64, start int, ends []int, stride int) []any {
+	out := []any{}
+	for _, end := range ends {
+		out = append(out, jsonCoords1(flat[start:end], stride))
+		start = end
+	}
+	return out
+}
+
+// modelGeoJSON is the GeoJSON object for g (RFC 7946 structure; empty
+// geometries have empty coordinate arrays).
+func modelGeoJSON(g geom.T) map[string]any {
+	stride := g.Layout().Stride()
+	switch g := g.(type) {
+	case *geom.Point:
+		if g.Empty() {
+			return map[string]any{"type": "Point", "coordinates": []any{}}
+		}
+		return map[string]any{"type": "Point", "coordinates": jsonCoord(g.FlatCoords())}
+	case *geom.LineString:
+		return map[string]any{"type": "LineString", "coordinates": jsonCoords1(g.FlatCoords(), stride)}
+	case *geom.Polygon:
+		return map[string]any{"type": "Polygon", "coordinates": jsonCoords2(g.FlatCoords(), 0, g.Ends(), stride)}
+	case *geom.MultiPoint:
+		return map[string]any{"type": "MultiPoint", "coordinates": jsonCoords1(g.FlatCoords(), stride)}
+	case *geom.MultiLineString:
+		return map[string]any{"type": "MultiLineString", "coordinates": jsonCoords2(g.FlatCoords(), 0, g.Ends(), stride)}
+	case *geom.MultiPolygon:
+		out := []any{}
+		start := 0
+		for _, ends := range g.Endss() {
+			out = append(out, jsonCoords2(g.FlatCoords(), start, ends, stride))
+			if len(ends) > 0 {
+				start = ends[len(ends)-1]
+			}
+		}
+		return map[string]any{"type": "MultiPolygon", "coordinates": out}
+	case *geom.GeometryCollection:
+		out := []any{}
+		for _, m := range g.Geoms() {
+			out = append(out, modelGeoJSON(m))
+		}
+		return map[string]any{"type": "GeometryCollection", "geometries": out}
+	}
+	panic(fmt.Sprintf("modelGeoJSON: %T", g))
+}
+
+func jsonText(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// ---------------------------------------------------------------------------
+// Exact arithmetic helpers.
+
+func rat(x float64) *big.Rat {
+	r := new(big.Rat)
+	if r.SetFloat64(x) == nil {
+		panic("rat of a non-finite float")
+	}
+	return r
+}
+
+// shoelace2 returns twice the signed area of a ring (positive when the ring
+// is counter-clockwise in the usual mathematical orientation), exactly.
+func shoelace2(flat []float64, stride int) *big.Rat {
+	sum := new(big.Rat)
+	npts := len(flat) / stride
+	for i := 0; i < npts; i++ {
+		j := (i + 1) % npts
+		xi, yi := rat(flat[i*stride]), rat(flat[i*stride+1])
+		xj, yj := rat(flat[j*stride]), rat(flat[j*stride+1])
+		t := new(big.Rat).Sub(new(big.Rat).Mul(xi, yj), new(big.Rat).Mul(xj, yi))
+		sum.Add(sum, t)
+	}
+	return sum
+}
+
+func ratFloat(r *big.Rat) float64 {
+	f, _ := r.Float64()
+	return f
+}
+
+// closeTo compares floats with a relative/absolute tolerance.
+func closeTo(a, b, tol float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	if a == b {
+		return true
+	}
+	d := math.Abs(a - b)
+	return d <= tol || d <= tol*math.Max(math.Abs(a), math.Abs(b))
+}
+
+// orient2 is the exact orientation of (a, b, c): >0 counter-clockwise, <0
+// clockwise, 0 collinear.
+func orient2(ax, ay, bx, by, cx, cy float64) int {
+	l := new(big.Rat).Mul(new(big.Rat).Sub(rat(bx), rat(ax)), new(big.Rat).Sub(rat(cy), rat(ay)))
+	r := new(big.Rat).Mul(new(big.Rat).Sub(rat(by), rat(ay)), new(big.Rat).Sub(rat(cx), rat(ax)))
+	return l.Cmp(r)
+}
