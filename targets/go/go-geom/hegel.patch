+// ---------------------------------------------------------------------------
+// WKB / EWKB.
+
+// wkbCase: a geometry, a second one for a stream of two, and the byte order.
+type wkbCase struct {
+	g, g2 geom.T
+	bo    binary.ByteOrder
+}
+
+func (c wkbCase) GoString() string {
+	return fmt.Sprintf("%s\nsecond %s\norder %v", describe(c.g), describe(c.g2), c.bo)
+}
+
+var wkbCases = hegel.Composite(func(tc hegel.TestCase) wkbCase {
+	return wkbCase{g: hegel.Draw(tc, wkbGeoms), g2: hegel.Draw(tc, wkbGeoms), bo: hegel.Draw(tc, byteOrders)}
+})
+
+// TestHegelWKBMatchesModelAndRoundTrips: Marshal writes exactly the model
+// bytes in both byte orders, in WKB (ISO type codes) and EWKB (flags and
+// SRID); Unmarshal, Read from a stream, and the hex forms read them back to
+// the same geometry; WKB bytes also read through EWKB's Unmarshal when the
+// layout is XY (the two encodings coincide there).
+func TestHegelWKBMatchesModelAndRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wkbCases)
+		g, bo := c.g, c.bo
+
+		// EWKB
+		eb, err := ewkb.Marshal(g, bo)
+		if err != nil {
+			fail(ht, "ewkb.Marshal: %v\n%s", err, describe(g))
+		}
+		if want := modelWKB(g, bo, true); !bytes.Equal(eb, want) {
+			fail(ht, "EWKB bytes differ\n got %x\nwant %x\n%s", eb, want, describe(g))
+		}
+		back, err := ewkb.Unmarshal(eb)
+		if err != nil {
+			fail(ht, "ewkb.Unmarshal: %v\n%x\n%s", err, eb, describe(g))
+		}
+		if d := geomDiff(withMemberSRIDs(g), back, "g"); d != "" {
+			fail(ht, "EWKB round trip: %s\n in %s\nout %s", d, describe(g), describe(back))
+		}
+		hx, err := ewkbhex.Encode(g, bo)
+		if err != nil || !strings.EqualFold(hx, hex.EncodeToString(eb)) {
+			fail(ht, "ewkbhex.Encode %q err %v, bytes %x", hx, err, eb)
+		}
+		if back, err := ewkbhex.Decode(strings.ToUpper(hx)); err != nil {
+			fail(ht, "ewkbhex.Decode: %v", err)
+		} else if d := geomDiff(withMemberSRIDs(g), back, "g"); d != "" {
+			fail(ht, "EWKB hex round trip: %s", d)
+		}
+		// a stream of two geometries
+		eb2, err := ewkb.Marshal(c.g2, bo)
+		if err == nil {
+			r := bytes.NewReader(append(append([]byte(nil), eb...), eb2...))
+			r1, err1 := ewkb.Read(r)
+			r2, err2 := ewkb.Read(r)
+			if err1 != nil || err2 != nil {
+				fail(ht, "ewkb.Read stream: %v %v", err1, err2)
+			}
+			if d := geomDiff(withMemberSRIDs(g), r1, "first"); d != "" {
+				fail(ht, "ewkb.Read stream: %s", d)
+			}
+			if d := geomDiff(withMemberSRIDs(c.g2), r2, "second"); d != "" {
+				fail(ht, "ewkb.Read stream: %s", d)
+			}
+			if r.Len() != 0 {
+				fail(ht, "ewkb.Read left %d bytes", r.Len())
+			}
+		}
+
+		// WKB (no SRID in the format; empty points as NaN with the option)
+		g0 := withoutSRID(g)
+		wb, err := wkb.Marshal(g0, bo, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN))
+		if err != nil {
+			fail(ht, "wkb.Marshal: %v\n%s", err, describe(g0))
+		}
+		if want := modelWKB(g0, bo, false); !bytes.Equal(wb, want) {
+			fail(ht, "WKB bytes differ\n got %x\nwant %x\n%s", wb, want, describe(g0))
+		}
+		back, err = wkb.Unmarshal(wb, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN))
+		if err != nil {
+			fail(ht, "wkb.Unmarshal: %v\n%x\n%s", err, wb, describe(g0))
+		}
+		g0 = normalizeNoLayout(g0)
+		if d := geomDiff(g0, back, "g"); d != "" {
+			fail(ht, "WKB round trip: %s\n in %s\nout %s", d, describe(g0), describe(back))
+		}
+		if hx, err := wkbhex.Encode(g0, bo, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN)); err != nil || !strings.EqualFold(hx, hex.EncodeToString(wb)) {
+			fail(ht, "wkbhex.Encode %q err %v", hx, err)
+		} else if back, err := wkbhex.Decode(hx, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN)); err != nil {
+			fail(ht, "wkbhex.Decode: %v", err)
+		} else if d := geomDiff(g0, back, "g"); d != "" {
+			fail(ht, "WKB hex round trip: %s", d)
+		}
+		// without the option, an empty point is an error on both sides
+		if hasEmptyPoint(g0) {
+			if _, err := wkb.Marshal(g0, bo); err == nil {
+				fail(ht, "wkb.Marshal of an empty point without the NaN option succeeded: %s", describe(g0))
+			}
+		} else {
+			wb2, err := wkb.Marshal(g0, bo)
+			if err != nil || !bytes.Equal(wb2, wb) {
+				fail(ht, "wkb.Marshal without options: %v, %x vs %x", err, wb2, wb)
+			}
+		}
+		// XY WKB is XY EWKB
+		if allXY(g0) {
+			if back, err := ewkb.Unmarshal(wb); err != nil {
+				fail(ht, "ewkb.Unmarshal(XY WKB): %v", err)
+			} else if d := geomDiff(g0, back, "g"); d != "" {
+				fail(ht, "ewkb.Unmarshal(XY WKB): %s", d)
+			}
+			if back, err := wkb.Unmarshal(eb, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN)); g.SRID() == 0 && !hasSRID(g) {
+				if err != nil {
+					fail(ht, "wkb.Unmarshal(XY EWKB): %v", err)
+				} else if d := geomDiff(g0, back, "g"); d != "" {
+					fail(ht, "wkb.Unmarshal(XY EWKB): %s", d)
+				}
+			}
+		}
+	})
+}
+
+// withMemberSRIDs returns g as EWKB will read it back: multi-geometries'
+// members are written without an SRID, so nothing changes at the top level
+// (SRIDs live on the top-level geometry and on collection members).
+func withMemberSRIDs(g geom.T) geom.T { return normalizeNoLayout(g) }
+
+func withoutSRID(g geom.T) geom.T {
+	c := clone(g)
+	var strip func(geom.T)
+	strip = func(g geom.T) {
+		geom.SetSRID(g, 0)
+		if gc, ok := g.(*geom.GeometryCollection); ok {
+			for _, m := range gc.Geoms() {
+				strip(m)
+			}
+		}
+	}
+	strip(c)
+	return c
+}
+
+func hasSRID(g geom.T) bool {
+	if g.SRID() != 0 {
+		return true
+	}
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		for _, m := range gc.Geoms() {
+			if hasSRID(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func allXY(g geom.T) bool {
+	if g.Layout() != geom.XY {
+		return false
+	}
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		for _, m := range gc.Geoms() {
+			if !allXY(m) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func hasEmptyPoint(g geom.T) bool {
+	switch g := g.(type) {
+	case *geom.Point:
+		return g.Empty()
+	case *geom.MultiPoint:
+		for i := range g.NumPoints() {
+			if g.Point(i).Empty() {
+				return true
+			}
+		}
+	case *geom.GeometryCollection:
+		for _, m := range g.Geoms() {
+			if hasEmptyPoint(m) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// wkbDamage: a geometry, the byte order, the cuts of its EWKB's and WKB's
+// prefixes, the byte and bit flipped in its EWKB (positions modulo the
+// length), and the element limit under which the corrupted bytes are read.
+type wkbDamage struct {
+	g              geom.T
+	bo             binary.ByteOrder
+	cutE, cutW, at int
+	bit            int
+	limit          int
+}
+
+func (c wkbDamage) GoString() string {
+	return fmt.Sprintf("%s\norder %v cuts %d %d flip byte %d bit %d limit %d", describe(c.g), c.bo, c.cutE, c.cutW, c.at, c.bit, c.limit)
+}
+
+var wkbDamages = hegel.Composite(func(tc hegel.TestCase) wkbDamage {
+	return wkbDamage{
+		g:     hegel.Draw(tc, wkbBadGeoms),
+		bo:    hegel.Draw(tc, byteOrders),
+		cutE:  hegel.Draw(tc, positions),
+		cutW:  hegel.Draw(tc, positions),
+		at:    hegel.Draw(tc, positions),
+		bit:   hegel.Draw(tc, hegel.Integers(0, 7)),
+		limit: hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 16, 1000})),
+	}
+})
+
+// TestHegelWKBRejectsMalformedBytes: every proper prefix of an (E)WKB is an
+// error, and corrupted bytes never panic (limits on element counts are
+// honoured).
+func TestHegelWKBRejectsMalformedBytes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wkbDamages)
+		g, bo := c.g, c.bo
+		eb, err := ewkb.Marshal(g, bo)
+		if err != nil {
+			fail(ht, "ewkb.Marshal: %v", err)
+		}
+		cut := c.cutE % len(eb)
+		if back, err := ewkb.Unmarshal(eb[:cut]); err == nil {
+			fail(ht, "EWKB prefix %d/%d bytes decoded to %s\nfull %x\n%s", cut, len(eb), describe(back), eb, describe(g))
+		}
+		g0 := withoutSRID(g)
+		wb, err := wkb.Marshal(g0, bo, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN))
+		if err != nil {
+			fail(ht, "wkb.Marshal: %v", err)
+		}
+		cut = c.cutW % len(wb)
+		if back, err := wkb.Unmarshal(wb[:cut], wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN)); err == nil {
+			fail(ht, "WKB prefix %d/%d bytes decoded to %s\nfull %x\n%s", cut, len(wb), describe(back), wb, describe(g0))
+		}
+		// corruption: flip a bit; must not panic (recovered by property()), must not hang
+		bad := append([]byte(nil), eb...)
+		bad[c.at%len(bad)] ^= byte(1 << c.bit)
+		old := wkbcommon.MaxGeometryElements
+		wkbcommon.MaxGeometryElements = [4]int{0, c.limit, c.limit, c.limit}
+		defer func() { wkbcommon.MaxGeometryElements = old }()
+		if back, err := ewkb.Unmarshal(bad); err == nil {
+			// accepted: what was read must be encodable, and read back the same
+			// (trailing bytes are ignored as in JTS and GEOS, an SRID flag with
+			// SRID 0 and member SRIDs are dropped, so the bytes may differ)
+			again, err := ewkb.Marshal(back, bo)
+			if err != nil {
+				fail(ht, "corrupted EWKB %x decoded to %s which cannot be re-encoded: %v", bad, describe(back), err)
+			}
+			back2, err := ewkb.Unmarshal(again)
+			if err != nil {
+				fail(ht, "corrupted EWKB %x decoded to %s whose EWKB %x does not decode: %v", bad, describe(back), again, err)
+			}
+			if d := geomDiff(back, back2, "g"); d != "" {
+				fail(ht, "corrupted EWKB %x decoded to %s; its EWKB %x decodes differently: %s", bad, describe(back), again, d)
+			}
+		}
+		_, _ = wkb.Unmarshal(bad, wkbcommon.WKBOptionEmptyPointHandling(wkbcommon.EmptyPointHandlingNaN))
+	})
+}
+
+// ---------------------------------------------------------------------------
+// GeoJSON.
+
+// jsonCase: a geometry, the id of the Feature wrapping it and the decimal
+// digits of the rounding option.
+type jsonCase struct {
+	g      geom.T
+	id     string
+	digits int
+}
+
+func (c jsonCase) GoString() string {
+	return fmt.Sprintf("%s\nid %q digits %d", describe(c.g), c.id, c.digits)
+}
+
+var jsonCases = hegel.Composite(func(tc hegel.TestCase) jsonCase {
+	return jsonCase{
+		g:      hegel.Draw(tc, jsonGeoms),
+		id:     hegel.Draw(tc, hegel.SampledFrom([]string{"", "f1", "7"})),
+		digits: hegel.Draw(tc, hegel.Integers(0, 6)),
+	}
+})
+
+// geojsonShapes names the recorded GeoJSON bugs whose shape g has: an empty
+// MultiPoint member (go-geom/2), an empty first member of a Z or M
+// multi-geometry (go-geom/3).
+func geojsonShapes(g geom.T) []string {
+	return append(shapeIf(hasEmptyMultiPointMember(g), "go-geom/2"), shapeIf(hasEmptyFirstMember(g), "go-geom/3")...)
+}
+
+// TestHegelGeoJSONMatchesModelAndRoundTrips: Marshal produces the RFC 7946
+// structure of the model (compared as JSON values), Unmarshal reads it back
+// to the same geometry (layouts XY, XYZ and XYZM; GeoJSON cannot carry M
+// alone), through both the Geometry type and Feature/FeatureCollection, with
+// the bbox option consistent with Bounds and the decimal-digits option a
+// rounding of the coordinates.
+func TestHegelGeoJSONMatchesModelAndRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, jsonCases)
+		g := c.g
+		shapes := geojsonShapes(g)
+		b, err := geojson.Marshal(g)
+		if err != nil {
+			mismatch(ht, shapes, "geojson.Marshal: %v\n%s", err, describe(g))
+		}
+		var got, want any
+		if err := json.Unmarshal(b, &got); err != nil {
+			mismatch(ht, shapes, "Marshal output is not JSON: %v: %s", err, b)
+		}
+		json.Unmarshal([]byte(jsonText(modelGeoJSON(g))), &want)
+		if !reflect.DeepEqual(got, want) {
+			mismatch(ht, shapes, "GeoJSON differs\n got %s\nwant %s\n%s", b, jsonText(modelGeoJSON(g)), describe(g))
+		}
+		var back geom.T
+		if err := geojson.Unmarshal(b, &back); err != nil {
+			mismatch(ht, shapes, "geojson.Unmarshal(%s): %v\n%s", b, err, describe(g))
+		}
+		if d := geomDiff(expectedAfterGeoJSON(g), back, "g"); d != "" {
+			mismatch(ht, shapes, "GeoJSON round trip: %s\ntext %s\n in %s\nout %s", d, b, describe(g), describe(back))
+		}
+		// Feature round trip
+		f := &geojson.Feature{ID: c.id, Geometry: g, Properties: map[string]any{"k": "v"}}
+		fb, err := json.Marshal(f)
+		if err != nil {
+			mismatch(ht, shapes, "Feature marshal: %v", err)
+		}
+		var f2 geojson.Feature
+		if err := json.Unmarshal(fb, &f2); err != nil {
+			mismatch(ht, shapes, "Feature unmarshal: %v\n%s", err, fb)
+		}
+		if f2.ID != f.ID {
+			fail(ht, "Feature ID %q -> %q", f.ID, f2.ID)
+		}
+		if d := geomDiff(expectedAfterGeoJSON(g), f2.Geometry, "g"); d != "" {
+			mismatch(ht, shapes, "Feature round trip: %s\n%s", d, fb)
+		}
+		// bbox option = Bounds (the bbox of a nested collection panics, go-geom/1;
+		// the check is skipped under HEGEL_NO_KNOWN=1)
+		if !g.Empty() && !(Known.boundsExtendCollectionPanics && hasNestedCollection(g)) {
+			var bb []byte
+			if r := recovered(func() { bb, err = geojson.Marshal(g, geojson.EncodeGeometryWithBBox()) }); r != nil {
+				mismatch(ht, shapeIf(hasNestedCollection(g), "go-geom/1"), "Marshal with bbox panicked: %v\n%s", r, describe(g))
+			}
+			if err != nil {
+				fail(ht, "Marshal with bbox: %v", err)
+			}
+			var obj struct {
+				BBox []float64 `json:"bbox"`
+			}
+			json.Unmarshal(bb, &obj)
+			bounds := g.Bounds()
+			var wantBB []float64
+			switch bounds.Layout() {
+			case geom.XY, geom.XYM:
+				wantBB = []float64{bounds.Min(0), bounds.Min(1), bounds.Max(0), bounds.Max(1)}
+			default:
+				wantBB = []float64{bounds.Min(0), bounds.Min(1), bounds.Min(2), bounds.Max(0), bounds.Max(1), bounds.Max(2)}
+			}
+			if !reflect.DeepEqual(obj.BBox, wantBB) {
+				fail(ht, "bbox %v, Bounds says %v\n%s", obj.BBox, wantBB, bb)
+			}
+		}
+		// decimal digits: every coordinate is the rounding of the original
+		db, err := geojson.Marshal(g, geojson.EncodeGeometryWithMaxDecimalDigits(c.digits))
+		if err != nil {
+			mismatch(ht, shapes, "Marshal with %d digits: %v", c.digits, err)
+		}
+		var rounded geom.T
+		if err := geojson.Unmarshal(db, &rounded); err != nil {
+			mismatch(ht, shapes, "Unmarshal of the %d-digit text %s: %v", c.digits, db, err)
+		}
+		checkRounded(ht, expectedAfterGeoJSON(g), rounded, c.digits, string(db))
+	})
+}
+
+// expectedAfterGeoJSON is g as GeoJSON can represent it: no SRID, empty
+// geometries take the default layout (XY) since the layout is inferred from
+// the coordinates, a collection's layout is the union of its members'.
+func expectedAfterGeoJSON(g geom.T) geom.T {
+	c := withoutSRID(g)
+	var fix func(geom.T) geom.T
+	fix = func(g geom.T) geom.T {
+		switch g := g.(type) {
+		case *geom.Point:
+			if g.Empty() {
+				return geom.NewPointEmpty(geom.XY)
+			}
+		case *geom.LineString:
+			if g.Empty() {
+				return geom.NewLineString(geom.XY)
+			}
+		case *geom.Polygon:
+			if g.NumLinearRings() == 0 {
+				return geom.NewPolygon(geom.XY)
+			}
+			if len(g.FlatCoords()) == 0 {
+				return geom.NewPolygonFlat(geom.XY, nil, g.Ends())
+			}
+		case *geom.MultiPoint:
+			if g.NumPoints() == 0 {
+				return geom.NewMultiPoint(geom.XY)
+			}
+		case *geom.MultiLineString:
+			if g.NumLineStrings() == 0 {
+				return geom.NewMultiLineString(geom.XY)
+			}
+			if len(g.FlatCoords()) == 0 {
+				return geom.NewMultiLineStringFlat(geom.XY, nil, g.Ends())
+			}
+		case *geom.MultiPolygon:
+			if g.NumPolygons() == 0 {
+				return geom.NewMultiPolygon(geom.XY)
+			}
+			if len(g.FlatCoords()) == 0 {
+				return geom.NewMultiPolygonFlat(geom.XY, nil, g.Endss())
+			}
+		case *geom.GeometryCollection:
+			gc := geom.NewGeometryCollection()
+			for _, m := range g.Geoms() {
+				gc.MustPush(fix(m))
+			}
+			return gc
+		}
+		return g
+	}
+	return fix(c)
+}
+
+func checkRounded(ht *hegel.T, g, r geom.T, digits int, text string) {
+	if gc, ok := g.(*geom.GeometryCollection); ok {
+		rc, ok := r.(*geom.GeometryCollection)
+		if !ok || rc.NumGeoms() != gc.NumGeoms() {
+			fail(ht, "%d digits: collection shape changed: %s", digits, text)
+		}
+		for i := range gc.Geoms() {
+			checkRounded(ht, gc.Geom(i), rc.Geom(i), digits, text)
+		}
+		return
+	}
+	a, b := g.FlatCoords(), r.FlatCoords()
+	if len(a) != len(b) {
+		fail(ht, "%d digits: %d vs %d coordinates\n%s", digits, len(a), len(b), text)
+	}
+	scale := math.Pow(10, float64(digits))
+	for i := range a {
+		if math.Abs(b[i]-a[i]) > 0.5/scale*(1+1e-9)+1e-12*math.Abs(a[i]) {
+			fail(ht, "%d digits: %v rounded to %v, more than half a unit away\n%s", digits, a[i], b[i], text)
+		}
+	}
+}
