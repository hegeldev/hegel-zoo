+	wkbGeoms    = newGrammar(genOpts{emptyPoints: true, nullPositions: true, emptyMembers: true, emptyFirst: true, shortLines: true, wildFloats: true, collections: true, maxDepth: 2, srid: true}).of(layouts...)
