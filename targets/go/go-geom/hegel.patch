+	jsonGeoms   = newGrammar(genOpts{emptyPoints: true, nullPositions: !Known.geojsonNullPositions, emptyMembers: true, emptyFirst: !Known.geojsonLayoutFromFirstMember, collections: true, maxDepth: 2}).of(geom.XY, geom.XYZ, geom.XYZM)
