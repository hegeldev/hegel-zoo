+var legacyFlags = []LegacyKeyEncoding{flagCtrlAt, flagCtrlI, flagCtrlM, flagCtrlOpenBracket, flagBackspace, flagFind, flagSelect, flagFKeys}
+
+// TestHegelKeyTableAgreesWithTheDecoder: the scanner looks a whole read up in buildKeysTable
+// first and falls back to the decoder otherwise; the two must agree, or the same bytes mean
+// different keys depending on how they arrive.
+func TestHegelKeyTableAgreesWithTheDecoder(t *testing.T) {
+	if len(terminfoTerms) == 0 {
+		t.Skip("no terminfo database")
+	}
+	type entry struct {
+		flags       LegacyKeyEncoding
+		term        string
+		useTerminfo bool
+	}
+	tables := map[entry][]string{}
+	tableOf := map[entry]map[string]Key{}
+	terminfoOf := map[entry]map[string]Key{}
+	property(t, func(ht *hegel.T) {
+		var flags LegacyKeyEncoding
+		for _, f := range legacyFlags {
+			if chance(ht, 25) {
+				flags |= f
+			}
+		}
+		term := pick(ht, terminfoTerms)
+		useTerminfo := chance(ht, 70)
+		e := entry{flags, term, useTerminfo}
+		if _, ok := tables[e]; !ok {
+			tbl := buildKeysTable(flags, term, useTerminfo)
+			keys := make([]string, 0, len(tbl))
+			for k := range tbl {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			tables[e] = keys
+			tableOf[e] = tbl
+			if useTerminfo {
+				terminfoOf[e] = buildTerminfoKeys(flags, term)
+			} else {
+				terminfoOf[e] = map[string]Key{}
+			}
+		}
+		seq := pick(ht, tables[e])
+		key := tableOf[e][seq]
+		if _, fromTerminfo := terminfoOf[e][seq]; fromTerminfo {
+			count("terminfo-key-skipped") // pinned
+			return
+		}
+		if flags&flagCtrlOpenBracket != 0 && strings.Trim(seq, "\x1b") == "" {
+			count("ctrl-open-bracket-skipped") // pinned
+			return
+		}
+		note(ht, "term %s flags %#b terminfo %v seq %q table %s", term, flags, useTerminfo, seq, eventString(KeyPressEvent(key)))
+		p := EventDecoder{Legacy: flags, UseTerminfo: useTerminfo}
+		got := decodeAll(&p, []byte(seq))
+		want := []Event{KeyPressEvent(key)}
+		if strings.HasPrefix(seq, "\x1b[1;") && strings.HasSuffix(seq, "R") {
+			want = append(want, CursorPositionEvent{Y: 0, X: int(key.Mod)})
+		}
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "term %s flags %#b: %q is %s in the table but the decoder gives\n    %s", term, flags, seq, eventString(KeyPressEvent(key)), eventsString(got))
+		}
+		count("ok")
+	})
+}
