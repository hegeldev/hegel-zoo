+// ---------------------------------------------------------------- SGR reading
+
+// applySGR applies one SGR parameter list to st following ECMA-48 and the xterm/kitty colour
+// and underline extensions (the oracle for Style.String and StyleDiff).
+func applySGR(params []ansi.Param, st *Style) {
+	if len(params) == 0 {
+		*st = Style{}
+		return
+	}
+	for i := 0; i < len(params); i++ {
+		p := params[i]
+		v := p.Param(0)
+		switch {
+		case v == 0:
+			*st = Style{}
+		case v == 1:
+			st.Attrs |= AttrBold
+		case v == 2:
+			st.Attrs |= AttrFaint
+		case v == 3:
+			st.Attrs |= AttrItalic
+		case v == 4:
+			if p.HasMore() && i+1 < len(params) {
+				i++
+				st.Underline = Underline(params[i].Param(1))
+			} else {
+				st.Underline = UnderlineSingle
+			}
+		case v == 5:
+			st.Attrs |= AttrBlink
+		case v == 6:
+			st.Attrs |= AttrRapidBlink
+		case v == 7:
+			st.Attrs |= AttrReverse
+		case v == 8:
+			st.Attrs |= AttrConceal
+		case v == 9:
+			st.Attrs |= AttrStrikethrough
+		case v == 22:
+			st.Attrs &^= AttrBold | AttrFaint
+		case v == 23:
+			st.Attrs &^= AttrItalic
+		case v == 24:
+			st.Underline = UnderlineNone
+		case v == 25:
+			st.Attrs &^= AttrBlink | AttrRapidBlink
+		case v == 27:
+			st.Attrs &^= AttrReverse
+		case v == 28:
+			st.Attrs &^= AttrConceal
+		case v == 29:
+			st.Attrs &^= AttrStrikethrough
+		case v >= 30 && v <= 37:
+			st.Fg = ansi.BasicColor(v - 30)
+		case v == 39:
+			st.Fg = nil
+		case v >= 40 && v <= 47:
+			st.Bg = ansi.BasicColor(v - 40)
+		case v == 49:
+			st.Bg = nil
+		case v == 59:
+			st.UnderlineColor = nil
+		case v >= 90 && v <= 97:
+			st.Fg = ansi.BasicColor(v - 90 + 8)
+		case v >= 100 && v <= 107:
+			st.Bg = ansi.BasicColor(v - 100 + 8)
+		case v == 38 || v == 48 || v == 58:
+			// Sub-parameters (colons) or following parameters (semicolons).
+			end := i
+			for end+1 < len(params) && params[end].HasMore() {
+				end++
+			}
+			run := params[i : end+1]
+			if len(run) == 1 {
+				run = params[i:min(len(params), i+5)]
+				if len(run) > 1 && run[1].Param(0) == 5 {
+					run = run[:3]
+				}
+				end = i + len(run) - 1
+			}
+			var c color.Color
+			switch {
+			case len(run) >= 3 && run[1].Param(0) == 5:
+				c = ansi.ExtendedColor(run[2].Param(0))
+			case len(run) == 6 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[3].Param(0)), G: uint8(run[4].Param(0)), B: uint8(run[5].Param(0)), A: 0xff}
+			case len(run) >= 5 && run[1].Param(0) == 2:
+				c = color.RGBA{R: uint8(run[2].Param(0)), G: uint8(run[3].Param(0)), B: uint8(run[4].Param(0)), A: 0xff}
+			}
+			switch v {
+			case 38:
+				st.Fg = c
+			case 48:
+				st.Bg = c
+			default:
+				st.UnderlineColor = c
+			}
+			i = end
+		}
+	}
+}
+
+// readLink reads an OSC 8 payload ("8;params;url") into ln.
+func readLink(data string, ln *Link) {
+	parts := strings.SplitN(data, ";", 3)
+	if len(parts) != 3 {
+		return
+	}
+	*ln = Link{URL: parts[2], Params: parts[1]}
+}
+
+// readSGR applies every SGR sequence in seq to st and every hyperlink to ln.
+func readSGR(seq string, st *Style, ln *Link) {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var state byte
+	for len(seq) > 0 {
+		sq, _, k, ns := ansi.DecodeSequenceWc(seq, state, p)
+		if ansi.HasCsiPrefix(sq) && p.Command() == 'm' {
+			applySGR(p.Params(), st)
+		} else if ansi.HasOscPrefix(sq) && p.Command() == 8 && ln != nil {
+			readLink(string(p.Data()), ln)
+		}
+		seq = seq[k:]
+		state = ns
+	}
+}
+
+func TestHegelStylesRoundTripThroughSGR(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s, o := genStyle(ht), genStyle(ht)
+		note(ht, "s=%s o=%s", styleString(s), styleString(o))
+		var got Style
+		readSGR(s.String(), &got, nil)
+		if !got.Equal(&s) {
+			fail(ht, "String() %q read back as %s, want %s", s.String(), styleString(got), styleString(s))
+		}
+		if s.IsZero() && s.String() != ansi.ResetStyle {
+			fail(ht, "zero style's String() = %q", s.String())
+		}
+		if !s.Equal(&s) {
+			fail(ht, "style not equal to itself")
+		}
+		diff := StyleDiff(&o, &s)
+		if d2 := s.Diff(&o); d2 != diff {
+			fail(ht, "s.Diff(o) = %q, StyleDiff(o, s) = %q", d2, diff)
+		}
+		var viaDiff Style
+		readSGR(o.String(), &viaDiff, nil)
+		readSGR(diff, &viaDiff, nil)
+		if !viaDiff.Equal(&s) {
+			fail(ht, "o=%s then StyleDiff %q gives %s, want s=%s", styleString(o), diff, styleString(viaDiff), styleString(s))
+		}
+		if s.Equal(&o) && diff != "" {
+			fail(ht, "StyleDiff of equal styles = %q", diff)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- line rendering
+
+// parseRendered replays a rendered line into a grid row: text lands at the cursor with the
+// pen in force, SGR and OSC 8 sequences move the pen.
+func parseRendered(out string, width int) []mcell {
+	row := make([]mcell, width)
+	for x := range row {
+		row[x] = mblank
+	}
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st Style
+	var ln Link
+	var state byte
+	x := 0
+	for len(out) > 0 {
+		sq, w, k, ns := ansi.DecodeSequenceWc(out, state, p)
+		switch {
+		case ansi.HasCsiPrefix(sq) && p.Command() == 'm':
+			applySGR(p.Params(), &st)
+		case ansi.HasOscPrefix(sq) && p.Command() == 8:
+			readLink(string(p.Data()), &ln)
+		case w > 0:
+			if x+w <= width {
+				row[x] = mcell{s: sq, w: w, st: st, ln: ln}
+				for j := 1; j < w; j++ {
+					row[x+j] = mcell{}
+				}
+			} else if x < width {
+				row[x] = mcell{s: "!overflow", w: w}
+			}
+			x += w
+		}
+		out = out[k:]
+		state = ns
+	}
+	if x < width {
+		row = append(row[:x], make([]mcell, width-x)...)
+		for i := x; i < width; i++ {
+			row[i] = mcell{s: "!short", w: 1}
+		}
+	}
+	return row
+}
+
+func TestHegelLinesRenderWhatTheyHold(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		w, h := n(ht, 1, 12), n(ht, 1, 3)
+		b := NewBuffer(w, h)
+		for k := n(ht, 0, 20); k > 0; k-- {
+			b.SetCell(n(ht, 0, w-1), n(ht, 0, h-1), genCell(ht, true))
+		}
+		if hasOrphan(b) {
+			count("orphan-placeholder-skipped")
+			return
+		}
+		out := b.Render()
+		note(ht, "rendered %q", out)
+		lines := strings.Split(out, "\n")
+		if len(lines) != h {
+			fail(ht, "Render() has %d lines, buffer %d: %q", len(lines), h, out)
+		}
+		for y := 0; y < h; y++ {
+			l := b.Line(y)
+			if got := l.Render(); got != lines[y] {
+				fail(ht, "Line(%d).Render() = %q, Buffer.Render line %q", y, got, lines[y])
+			}
+			row := parseRendered(lines[y], w)
+			for x := 0; x < w; x++ {
+				c := l.At(x)
+				mc := row[x]
+				// A plain blank may come back as a blank with the pen still set only if
+				// the renderer left the pen on; that is exactly what the check catches.
+				if !sameCell(c, mc) {
+					fail(ht, "line %d cell %d = %s, rendered %q comes back as {%q w%d %s %v}", y, x, cellString(c), lines[y], mc.s, mc.w, styleString(mc.st), mc.ln)
+				}
+			}
+			plain := ansi.Strip(lines[y])
+			if got, want := strings.TrimRight(plain, " "), strings.TrimRight(l.String(), " "); got != want {
+				fail(ht, "line %d: Strip(Render) = %q, String() = %q", y, got, want)
+			}
+			if sw := cellMethod.StringWidth(plain); sw != w {
+				fail(ht, "line %d renders %d columns, want %d: %q", y, sw, w, lines[y])
+			}
+		}
+		// Cell constructors.
+		g := genGrapheme(ht, true)
+		if c := NewCell(cellMethod, g); c.Content != g || c.Width != cellMethod.StringWidth(g) || c.IsZero() {
+			fail(ht, "NewCell(%q) = %s", g, cellString(c))
+		}
+		if c := NewCell(cellMethod, " "); !c.Equal(&EmptyCell) {
+			fail(ht, "NewCell(\" \") = %s", cellString(c))
+		}
+		if c := NewCell(cellMethod, ""); !c.IsZero() {
+			fail(ht, "NewCell(\"\") = %s", cellString(c))
+		}
+		count("ok")
+	})
+}
