+// genPasteMarker: bracketed paste markers (only usable through the scanner).
+func genPasteMarker(tc hegel.TestCase) encoded {
+	if chance(tc, 50) {
+		return encoded{"paste-start", "\x1b[200~", []Event{PasteStartEvent{}}}
+	}
+	return encoded{"paste-end", "\x1b[201~", []Event{PasteEndEvent{}}}
+}
+
+// genEvent draws any encoded event. allowEscape admits a lone ESC (only safe as the last
+// event of a stream).
+func genEvent(tc hegel.TestCase, allowEscape bool) encoded {
+	switch n(tc, 0, 10) {
+	case 0, 1:
+		return genText(tc, allowEscape)
+	case 2:
+		return genAlt(tc, allowEscape)
+	case 3, 4:
+		return genFunctionKey(tc)
+	case 5, 6:
+		return genKittyKey(tc)
+	case 7:
+		return genModifyOtherKeys(tc)
+	case 8:
+		return genMouse(tc)
+	case 9:
+		if chance(tc, 5) {
+			return genPasteMarker(tc)
+		}
+		return genReport(tc)
+	default:
+		return genReport(tc)
+	}
+}
+
+// ---------------------------------------------------------------- properties
+
+var dumbTable = buildKeysTable(0, "dumb", false)
+
+// pinnedKind reports the generator kinds that stand for pinned bugs or are not usable inside
+// a stream: bracketed paste markers, and URxvt's CSI n $, which followed by a final byte
+// (any letter) is one ECMA-48 control sequence — the protocol's own ambiguity.
+func pinnedKind(kind string) bool {
+	switch kind {
+	case "kitty-shifted-and-base", "paste-start", "paste-end", "urxvt-dollar":
+		return true
+	}
+	return false
+}
+
+// decodeAll runs the decoder over the whole buffer, flattening MultiEvents.
+func decodeAll(p *EventDecoder, buf []byte) []Event {
+	var events []Event
+	for len(buf) > 0 {
+		w, ev := p.Decode(buf)
+		if w == 0 {
+			w = 1
+		}
+		if ev != nil {
+			events = append(events, ev)
+		}
+		buf = buf[w:]
+	}
+	return flatten(events)
+}
+
+// newScanner is the scanner TerminalReader/Terminal would use with these settings.
+func newScanner(flags LegacyKeyEncoding, term string, useTerminfo bool) *eventScanner {
+	s := newEventScanner()
+	s.EventDecoder = EventDecoder{Legacy: flags, UseTerminfo: useTerminfo}
+	s.table = buildKeysTable(flags, term, useTerminfo)
+	s.lookup = true
+	return s
+}
+
+// scanOnce scans a whole buffer as one expired read (nothing more is coming).
+func scanOnce(s *eventScanner, buf []byte) []Event {
+	_, evs := s.scanEvents(buf, true)
+	return flatten(evs)
+}
+
+// scanChunked feeds the buffer to the scanner cut at the given offsets, as StreamEvents does
+// with successive reads: unconsumed bytes wait for the next read, and the last remainder is
+// flushed when the escape timeout expires.
+func scanChunked(s *eventScanner, buf []byte, cuts []int) []Event {
+	var events []Event
+	var pending []byte
+	prev := 0
+	for _, c := range append(cuts, len(buf)) {
+		pending = append(pending, buf[prev:c]...)
+		prev = c
+		w, evs := s.scanEvents(pending, false)
+		events = append(events, evs...)
+		pending = pending[w:]
+	}
+	if len(pending) > 0 {
+		_, evs := s.scanEvents(pending, true)
+		events = append(events, evs...)
+	}
+	return flatten(events)
+}
+
+func checkDecode(ht *hegel.T, e encoded) {
+	note(ht, "%s %q", e.kind, e.seq)
+	var p EventDecoder
+	buf := []byte(e.seq)
+	orig := append([]byte(nil), buf...)
+	w, ev := p.Decode(buf)
+	if !bytes.Equal(buf, orig) {
+		fail(ht, "%s: Decode modified its input: %q -> %q", e.kind, orig, buf)
+	}
+	if w != len(buf) {
+		fail(ht, "%s: Decode(%q) consumed %d of %d bytes (event %s)", e.kind, e.seq, w, len(buf), eventString(ev))
+	}
+	got := flatten([]Event{ev})
+	want := flatten(e.want)
+	if e.kind == "kitty-shifted-and-base" {
+		// Pinned: the base key overwrites the shifted key.
+		count(e.kind + "-skipped")
+		return
+	}
+	if !reflect.DeepEqual(got, want) {
+		fail(ht, "%s: Decode(%q):\n  got\n    %s\n  want\n    %s", e.kind, e.seq, eventsString(got), eventsString(want))
+	}
+	for _, ev := range got {
+		if k, ok := ev.(KeyPressEvent); ok && k.String() == "" {
+			fail(ht, "%s: %s has an empty String()", e.kind, eventString(k))
+		}
+	}
+	count(e.kind)
+}
+
+// TestHegelSequencesDecodeToTheirEvents: every encoded event decodes to itself, consuming exactly
+// its bytes and leaving them untouched.
+func TestHegelSequencesDecodeToTheirEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkDecode(ht, genEvent(ht, true))
+	})
+}
+
+// f3Ambiguous reports CSI 1;mod R: both a modified F3 and a cursor report, which the scanner's
+// whole-read table lookup resolves to F3 alone when the sequence fills a read (by design).
+func f3Ambiguous(e encoded) bool {
+	return e.kind == "cpr-f3" || (e.kind == "csi-func-mod" && strings.HasSuffix(e.seq, "R"))
+}
+
+// forbiddenCuts lists the byte offsets inside the parts where a read boundary is ambiguous in
+// the protocol itself or stands for a pinned bug.
+func forbiddenCuts(parts []encoded) map[int]bool {
+	forbidden := map[int]bool{}
+	pos := 0
+	for _, e := range parts {
+		for i := 1; i < len(e.seq); i++ {
+			switch {
+			case e.kind == "decrpm-ansi":
+				forbidden[pos+i] = true // CSI n $ | y: the prefix is URxvt's CSI n $
+			case strings.HasSuffix(e.kind, "cluster"):
+				forbidden[pos+i] = true // a cluster cut between runes is two keys: the decoder cannot know more is coming
+			case e.kind == "mouse-x10":
+				forbidden[pos+i] = true // pinned: CSI M cut before its payload is an UnknownCsiEvent
+			case i == len(e.seq)-1 && strings.HasSuffix(e.seq, "\x1b\\"):
+				forbidden[pos+i] = true // pinned: ST cut between ESC and \ ends the string at the ESC
+			}
+		}
+		pos += len(e.seq)
+	}
+	return forbidden
+}
+
+// stream draws 1–6 encoded events back to back; pinned kinds (and, for streams that will be
+// cut into reads, the F3/cursor-report ambiguity) are replaced by a focus event.
+func stream(ht *hegel.T, forChunks bool) (string, []Event, []encoded) {
+	k := n(ht, 1, 6)
+	var seq strings.Builder
+	var want []Event
+	parts := make([]encoded, 0, k)
+	for i := range k {
+		e := genEvent(ht, i == k-1)
+		if pinnedKind(e.kind) || (forChunks && f3Ambiguous(e)) {
+			e = encoded{"focus", "\x1b[I", []Event{FocusEvent{}}}
+		}
+		seq.WriteString(e.seq)
+		want = append(want, e.want...)
+		parts = append(parts, e)
+	}
+	kinds := make([]string, len(parts))
+	for i, e := range parts {
+		kinds[i] = e.kind
+	}
+	note(ht, "stream %v %q", kinds, seq.String())
+	return seq.String(), flatten(want), parts
+}
+
+// TestHegelStreamsSplitIntoTheirEvents: a stream of encoded events, back to back in one read,
+// splits into exactly those events (through Decode and through the scanner).
+func TestHegelStreamsSplitIntoTheirEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		seq, want, _ := stream(ht, false)
+		var p EventDecoder
+		got := decodeAll(&p, []byte(seq))
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "stream %q:\n  got\n    %s\n  want\n    %s", seq, eventsString(got), eventsString(want))
+		}
+		if _, inTable := dumbTable[seq]; inTable && len(want) > 1 {
+			// CSI 1;mod R alone: the scanner's whole-read table lookup gives the modified F3
+			// only, the decoder both F3 and the cursor report (the documented ambiguity).
+			count("scanner-f3-skipped")
+		} else {
+			got := scanOnce(newScanner(0, "dumb", false), []byte(seq))
+			if !reflect.DeepEqual(got, want) {
+				fail(ht, "scanner on %q:\n  got\n    %s\n  want\n    %s", seq, eventsString(got), eventsString(want))
+			}
+		}
+		count("ok")
+	})
+}
+
+// TestHegelStreamsSurviveArbitraryReads: the same stream cut into several reads at arbitrary
+// byte offsets gives the same events: an incomplete sequence at the end of a read waits for
+// the next one.
+func TestHegelStreamsSurviveArbitraryReads(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		seq, want, parts := stream(ht, true)
+		if len(seq) < 2 {
+			count("too-short")
+			return
+		}
+		forbidden := forbiddenCuts(parts)
+		var cuts []int
+		for range n(ht, 1, 3) {
+			c := n(ht, 1, len(seq)-1)
+			if forbidden[c] {
+				count("cut-skipped")
+				continue
+			}
+			cuts = append(cuts, c)
+		}
+		sort.Ints(cuts)
+		if len(cuts) == 0 {
+			count("no-cuts")
+			return
+		}
+		note(ht, "cuts %v", cuts)
+		got := scanChunked(newScanner(0, "dumb", false), []byte(seq), cuts)
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "stream %q cut at %v:\n  got\n    %s\n  want\n    %s", seq, cuts, eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
+
+// TestHegelKittyAndModifyOtherKeysAgree: the same key reported through CSI u and through
+// xterm's CSI 27;mod;code~ is the same event (for shift/alt/ctrl, which both protocols share).
+func TestHegelKittyAndModifyOtherKeysAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := pick(ht, []rune{'a', 'z', 'A', '1', ';', '/', '[', '+', ' ', 'é', 'ø', '世', '☃', '😃'})
+		m := n(ht, 0, 7)
+		kitty := fmt.Sprintf("\x1b[%d;%du", r, m+1)
+		mok := fmt.Sprintf("\x1b[27;%d;%d~", m+1, r)
+		note(ht, "%q vs %q", kitty, mok)
+		var p EventDecoder
+		_, ke := p.Decode([]byte(kitty))
+		_, me := p.Decode([]byte(mok))
+		kk, ok1 := ke.(KeyPressEvent)
+		mk, ok2 := me.(KeyPressEvent)
+		if !ok1 || !ok2 {
+			fail(ht, "not key presses: %s / %s", eventString(ke), eventString(me))
+		}
+		if kk.Code != mk.Code || kk.Mod != mk.Mod {
+			fail(ht, "code/mod differ: kitty %s, modifyOtherKeys %s", eventString(kk), eventString(mk))
+		}
+		if m&1 == 0 && kk.Text != mk.Text {
+			fail(ht, "text differs: kitty %s, modifyOtherKeys %s", eventString(kk), eventString(mk))
+		}
+		count("ok")
+	})
+}
