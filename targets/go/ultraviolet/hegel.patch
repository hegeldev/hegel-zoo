+
+// feedTo hands what the screen or renderer emitted to the emulator and the tracker (either
+// may be nil) and returns it.
+func feedTo(ht *hegel.T, out *bytes.Buffer, e *vt.Emulator, tk *termTracker) string {
+	chunk := out.String()
+	out.Reset()
+	if tk != nil {
+		tk.feed(chunk)
+	}
+	if e != nil {
+		if _, err := e.WriteString(chunk); err != nil {
+			fail(ht, "emulator: %v", err)
+		}
+	}
+	return chunk
+}
+
+// letterStrings: one lower-case letter.
+var letterStrings = hegel.Map(hegel.Integers(0, 25), func(i int) string { return string(rune('a' + i)) })
+
+// urls: a hyperlink with a short host.
+var urls = hegel.Map(hegel.Binary(1, 6), func(b []byte) uv.Link { return uv.Link{URL: "https://" + string(lettersFrom(b)) + ".example/"} })
+
+// ---------------------------------------------------------------- ultraviolet/24
+
+// linkedPair is a frame with two hyperlinked letters on different rows: with the same link
+// (the region of ultraviolet/24) or, under HEGEL_NO_KNOWN=1, with different ones.
+type linkedPair struct {
+	w, h          int
+	x1, y1, x2, d int // positions; the second row is 1+d rows below the first, modulo the height
+	first, second string
+	link          uv.Link
+	same          bool
+}
+
+func (p linkedPair) rows() (int, int) {
+	y1 := p.y1 % p.h
+	return y1, (y1 + 1 + p.d%(p.h-1)) % p.h
+}
+
+// secondLink is the second cell's link: the first's or one with another scheme.
+func (p linkedPair) secondLink() uv.Link {
+	if p.same {
+		return p.link
+	}
+	return uv.Link{URL: "http" + strings.TrimPrefix(p.link.URL, "https")}
+}
+
+func (p linkedPair) GoString() string {
+	y1, y2 := p.rows()
+	return fmt.Sprintf("%dx%d: %q linked at (%d,%d), %q linked at (%d,%d), same link %v", p.w, p.h, p.first, p.x1%p.w, y1, p.second, p.x2%p.w, y2, p.same)
+}
+
+var linkedPairs = hegel.Composite(func(tc hegel.TestCase) linkedPair {
+	return linkedPair{
+		w:      hegel.Draw(tc, hegel.Integers(1, 8)),
+		h:      hegel.Draw(tc, hegel.Integers(2, 6)),
+		x1:     hegel.Draw(tc, positions),
+		y1:     hegel.Draw(tc, positions),
+		x2:     hegel.Draw(tc, positions),
+		d:      hegel.Draw(tc, positions),
+		first:  hegel.Draw(tc, letterStrings),
+		second: hegel.Draw(tc, letterStrings),
+		link:   hegel.Draw(tc, urls),
+		same:   hegel.Draw(tc, shaped(hegel.Just(true), hegel.Just(false))),
+	}
+})
+
+// TestHegelLinkedCellsOnTwoRowsKeepTheirLinks: every hyperlinked cell of a rendered frame has
+// its link on the terminal.
+func TestHegelLinkedCellsOnTwoRowsKeepTheirLinks(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, linkedPairs)
+		var out bytes.Buffer
+		r := uv.NewTerminalRenderer(&out, []string{"TERM=xterm-256color"})
+		r.SetColorProfile(colorprofile.TrueColor)
+		r.SetFullscreen(true)
+		scr := uv.NewScreenBuffer(p.w, p.h)
+		e := vt.NewEmulator(p.w, p.h)
+		y1, y2 := p.rows()
+		cells := []struct {
+			x, y int
+			c    *uv.Cell
+		}{
+			{p.x1 % p.w, y1, &uv.Cell{Content: p.first, Width: 1, Link: p.link}},
+			{p.x2 % p.w, y2, &uv.Cell{Content: p.second, Width: 1, Link: p.secondLink()}},
+		}
+		for _, s := range cells {
+			scr.SetCell(s.x, s.y, s.c)
+		}
+		r.Render(scr.RenderBuffer)
+		if err := r.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		chunk := feedTo(ht, &out, e, nil)
+		shape := ""
+		if p.same {
+			shape = "ultraviolet/24"
+		}
+		for _, s := range cells {
+			if got := e.CellAt(s.x, s.y).Link; got != s.c.Link {
+				mismatch(ht, shape, "%q at (%d,%d) has link %v on the terminal, want %v; output %q", s.c.Content, s.x, s.y, got, s.c.Link, chunk)
+			}
+		}
+		count("ok")
+	})
+}
