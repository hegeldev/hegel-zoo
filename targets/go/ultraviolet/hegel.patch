+// ultraviolet/8: an invalid UTF-8 byte is reported as UnknownEvent(string(rune(b))), i.e. the
+// UTF-8 encoding of U+00FE for the byte 0xfe, not the byte itself (same as x-input/5).
+func TestHegelPinUnknownEventEncodesTheByteAsARune(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte{0xfe})
+	if u, _ := ev.(UnknownEvent); string(u) != "\xfe" {
+		t.Errorf("Decode(0xfe) = %q; want the byte \"\\xfe\"", string(u))
+	}
+}
