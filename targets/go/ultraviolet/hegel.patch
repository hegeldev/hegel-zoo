+// ---------------------------------------------------------------- line rendering
+
+// ---------------------------------------------------------------- line rendering
+
+// parseRendered replays a rendered line into a grid row: text lands at the cursor with the
+// pen in force, SGR and OSC 8 sequences move the pen.
+func parseRendered(out string, width int) []mcell {
+	row := make([]mcell, width)
+	for x := range row {
+		row[x] = mblank
+	}
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st Style
+	var ln Link
+	var state byte
+	x := 0
+	for len(out) > 0 {
+		sq, w, k, ns := ansi.DecodeSequenceWc(out, state, p)
+		switch {
+		case ansi.HasCsiPrefix(sq) && p.Command() == 'm':
+			applySGR(p.Params(), &st)
+		case ansi.HasOscPrefix(sq) && p.Command() == 8:
+			readLink(string(p.Data()), &ln)
+		case w > 0:
+			if x+w <= width {
+				row[x] = mcell{s: sq, w: w, st: st, ln: ln}
+				for j := 1; j < w; j++ {
+					row[x+j] = mcell{}
+				}
+			} else if x < width {
+				row[x] = mcell{s: "!overflow", w: w}
+			}
+			x += w
+		}
+		out = out[k:]
+		state = ns
+	}
+	if x < width {
+		row = append(row[:x], make([]mcell, width-x)...)
+		for i := x; i < width; i++ {
+			row[i] = mcell{s: "!short", w: 1}
+		}
+	}
+	return row
+}
+
+// cellSet is one SetCell of a rendered buffer: positions and the cell.
+type cellSet struct {
+	x, y int
+	cell *Cell
+}
+
+var cellSets = hegel.Composite(func(tc hegel.TestCase) cellSet {
+	return cellSet{hegel.Draw(tc, positions), hegel.Draw(tc, positions), hegel.Draw(tc, cells)}
+})
+
+// renderCase is a buffer with some cells set, to render, and a grapheme for the constructor
+// checks.
+type renderCase struct {
+	w, h     int
+	sets     []cellSet
+	grapheme string
+}
+
+func (c renderCase) GoString() string {
+	return fmt.Sprintf("%dx%d with %d cells set, grapheme %q", c.w, c.h, len(c.sets), c.grapheme)
+}
+
+var renderCases = hegel.Composite(func(tc hegel.TestCase) renderCase {
+	return renderCase{
+		w:        hegel.Draw(tc, hegel.Integers(1, 12)),
+		h:        hegel.Draw(tc, hegel.Integers(1, 3)),
+		sets:     hegel.Draw(tc, many(cellSets, 0, 20)),
+		grapheme: hegel.Draw(tc, graphemes),
+	}
+})
