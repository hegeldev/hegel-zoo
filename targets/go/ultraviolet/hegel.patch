+// cursorMove is a screen showing a frame and its cursor, then a cursor position and a Flush;
+// under HEGEL_NO_KNOWN=1 a frame follows the Flush (the documented way to commit the move).
+type cursorMove struct {
+	w, h       int
+	text       plainText
+	n, x, y    int // positions
+	frameAfter bool
