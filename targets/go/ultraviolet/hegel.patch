+// ---------------------------------------------------------------- ultraviolet/25
+
+// scrollShift is two frames: a mark with a row under it, then the mark moved down by two or
+// more rows with new content above it and the row under it left as it was — untouched by the
+// frame while the scroll optimisation moves it (the region of ultraviolet/25) — or, under
+// HEGEL_NO_KNOWN=1, rewritten.
+type scrollShift struct {
+	w, h    int
+	a, k    int // positions: the mark's row (0 to h-3) and its shift (2 to h-1-a)
+	term    string
+	linked  bool // the moved mark carries a link
+	rewrite bool
+}
+
+func (s scrollShift) row() int   { return s.a % (s.h - 2) }
+func (s scrollShift) shift() int { return 2 + s.k%(s.h-1-s.row()-1) }
+
+func (s scrollShift) GoString() string {
+	return fmt.Sprintf("%dx%d on %s: mark at row %d moved down %d, the row under it %s", s.w, s.h, s.term, s.row(), s.shift(), map[bool]string{false: "unchanged", true: "rewritten"}[s.rewrite])
+}
+
+var scrollShifts = hegel.Composite(func(tc hegel.TestCase) scrollShift {
+	return scrollShift{
+		w:       hegel.Draw(tc, hegel.Integers(1, 4)),
+		h:       hegel.Draw(tc, hegel.Integers(4, 8)),
+		a:       hegel.Draw(tc, positions),
+		k:       hegel.Draw(tc, positions),
+		term:    hegel.Draw(tc, hegel.SampledFrom(renderTerms)),
+		linked:  hegel.Draw(tc, chance(50)),
+		rewrite: hegel.Draw(tc, shaped(hegel.Just(false), hegel.Just(true))),
+	}
+})
