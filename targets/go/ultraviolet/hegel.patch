+// ultraviolet/13: alt+O, alt+P and alt+X (ESC followed by an introducer byte) take shortcuts
+// without ShiftedCode, unlike every other alt+uppercase letter (x-input/7 remainder).
+func TestHegelPinAltIntroducerKeysLackShiftedCode(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, want := p.Decode([]byte("\x1bQ"))
+	wk := want.(KeyPressEvent)
+	for _, c := range "OPX" {
+		_, ev := p.Decode([]byte("\x1b" + string(c)))
+		w := wk
+		w.Code, w.ShiftedCode = unicode.ToLower(c), c
+		if !reflect.DeepEqual(ev, w) {
+			t.Errorf("ESC %c = %s; want %s (the shape ESC Q has)", c, eventString(ev), eventString(w))
+		}
+	}
+}
