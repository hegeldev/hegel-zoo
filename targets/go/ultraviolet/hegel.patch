+use ratatui::layout::{Constraint, Direction, Flex, Layout, Rect};
+use std::io::{self, BufRead, Write};
+
+fn parse_constraint(s: &str) -> Constraint {
+    let (k, v) = s.split_once(':').expect("constraint");
+    match k {
+        "len" => Constraint::Length(v.parse().unwrap()),
+        "pct" => Constraint::Percentage(v.parse().unwrap()),
+        "min" => Constraint::Min(v.parse().unwrap()),
+        "max" => Constraint::Max(v.parse().unwrap()),
+        "fill" => Constraint::Fill(v.parse().unwrap()),
+        "ratio" => {
+            let (n, d) = v.split_once('/').unwrap();
+            Constraint::Ratio(n.parse().unwrap(), d.parse().unwrap())
+        }
+        _ => panic!("kind {k}"),
+    }
+}
+
+fn main() {
+    let stdin = io::stdin();
+    let stdout = io::stdout();
+    let mut out = stdout.lock();
+    for line in stdin.lock().lines() {
+        let line = line.unwrap();
+        let mut it = line.split_whitespace();
+        let dir = match it.next().unwrap() {
+            "H" => Direction::Horizontal,
+            _ => Direction::Vertical,
+        };
+        let x: u16 = it.next().unwrap().parse().unwrap();
+        let y: u16 = it.next().unwrap().parse().unwrap();
+        let w: u16 = it.next().unwrap().parse().unwrap();
+        let h: u16 = it.next().unwrap().parse().unwrap();
+        let flex = match it.next().unwrap() {
+            "legacy" => Flex::Legacy,
+            "start" => Flex::Start,
+            "end" => Flex::End,
+            "center" => Flex::Center,
+            "between" => Flex::SpaceBetween,
+            "evenly" => Flex::SpaceEvenly,
+            "around" => Flex::SpaceAround,
+            f => panic!("flex {f}"),
+        };
+        let spacing: i16 = it.next().unwrap().parse().unwrap();
+        let constraints: Vec<Constraint> = it.map(parse_constraint).collect();
+        let layout = Layout::default()
+            .direction(dir)
+            .constraints(constraints)
+            .flex(flex)
+            .spacing(spacing);
+        let (segs, spacers) = layout.split_with_spacers(Rect::new(x, y, w, h));
+        let fmt = |rs: &[Rect]| -> String {
+            rs.iter()
+                .map(|r| format!("{},{},{},{}", r.x, r.y, r.width, r.height))
+                .collect::<Vec<_>>()
+                .join(";")
+        };
+        writeln!(out, "{}|{}", fmt(&segs), fmt(&spacers)).unwrap();
+        out.flush().unwrap();
+    }
+}
