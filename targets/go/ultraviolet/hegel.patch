+
+func (c cursorMove) GoString() string {
+	return fmt.Sprintf("%dx%d: SetCursorPosition(%d,%d) then Flush, a frame after %v", c.w, c.h, c.x%c.w, c.y%c.h, c.frameAfter)
+}
+
+var cursorMoves = hegel.Composite(func(tc hegel.TestCase) cursorMove {
+	return cursorMove{
+		w:          hegel.Draw(tc, hegel.Integers(2, 12)),
+		h:          hegel.Draw(tc, hegel.Integers(1, 6)),
+		text:       hegel.Draw(tc, plainTexts),
+		n:          hegel.Draw(tc, positions),
+		x:          hegel.Draw(tc, positions),
+		y:          hegel.Draw(tc, positions),
+		frameAfter: hegel.Draw(tc, shaped(hegel.Just(false), hegel.Just(true))),
+	}
+})
