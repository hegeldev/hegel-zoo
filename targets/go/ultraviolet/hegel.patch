+// TestHegelScrolledFramesKeepTheirUntouchedRows: with the scroll optimisation on, the terminal
+// shows the second frame whole, including the row it did not touch.
+func TestHegelScrolledFramesKeepTheirUntouchedRows(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, scrollShifts)
+		var out bytes.Buffer
+		r := uv.NewTerminalRenderer(&out, []string{"TERM=" + s.term})
+		r.SetColorProfile(colorprofile.TrueColor)
+		r.SetFullscreen(true)
+		r.SetScrollOptim(true)
+		scr := uv.NewScreenBuffer(s.w, s.h)
+		e := vt.NewEmulator(s.w, s.h)
+		cell := func(content string) *uv.Cell { return &uv.Cell{Content: content, Width: 1} }
+		a, k := s.row(), s.shift()
+		scr.SetCell(0, a, cell("#"))
+		scr.SetCell(0, a+1, cell("0"))
+		r.Render(scr.RenderBuffer)
+		if err := r.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		transcript := feedTo(ht, &out, e, nil)
+		// The second frame: new letters on the rows above the moved mark, the row under the
+		// old mark as it was (or rewritten), the mark k rows down.
+		for y := 0; y < a+k; y++ {
+			if y != a+1 {
+				scr.SetCell(0, y, cell(string(rune('a'+y))))
+			}
+		}
+		under := cell("0")
+		if s.rewrite {
+			under = cell("1")
+		}
+		scr.SetCell(0, a+1, under)
+		mark := cell("#")
+		if s.linked {
+			mark.Link = uv.Link{URL: "https://example.com/"}
+		}
+		scr.SetCell(0, a+k, mark)
+		untouched := untouchedRows(scr.RenderBuffer)
+		r.Render(scr.RenderBuffer)
+		if err := r.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		chunk := feedTo(ht, &out, e, nil)
+		transcript += chunk
+		shape := ""
+		if untouched && scrollSeq.MatchString(chunk) {
+			shape = "ultraviolet/25"
+		}
+		compareScreen(ht, "second frame", shape, r, scr.RenderBuffer, e, chunk, transcript)
+		count("ok")
+	})
+}
