+// TestHegelPastesKeepEverySequence: a bracketed paste yields its text whole, escape sequences
+// included, whatever the decoder makes of them.
+func TestHegelPastesKeepEverySequence(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := hegel.Draw(ht, pastesWithSequences)
+		text := p.text()
+		got := scanOnce(newScanner(0, "dumb", false), []byte("\x1b[200~"+text+"\x1b[201~"))
+		want := []Event{PasteStartEvent{}, PasteEvent{Content: text}, PasteEndEvent{}}
+		if !reflect.DeepEqual(got, want) {
+			shape := ""
+			if slices.Contains(unrecognisedSequences, p.seq) {
+				shape = "ultraviolet/18"
+			}
+			mismatch(ht, shape, "paste of %q gives\n    %s\n  want\n    %s", text, eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
