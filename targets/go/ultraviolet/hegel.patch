+package uv
+
+// Hegel property tests for charmbracelet/ultraviolet's input decoder (hegel-zoo target
+// go/ultraviolet).
+//
+// EventDecoder turns terminal input bytes into events; eventScanner (behind TerminalReader and
+// Terminal) runs it over the bytes of each read, with a whole-read key-table lookup, bracketed
+// paste and the "wait for more bytes" rule for incomplete sequences. The oracles are the
+// protocols the bytes come from: x/ansi's own encoders (mouse, cursor/mode/device-attribute
+// reports, window ops, clipboard, light/dark reports, Kitty graphics) and hand-written encoders
+// for the Kitty keyboard protocol, xterm's modifyOtherKeys and PC-style function keys, SS3
+// keypad keys, URxvt keys, OSC colour replies, XTGETTCAP and XTVERSION replies, PM/SOS/APC
+// strings, bracketed paste and plain text. Every generator is a value producing the bytes and
+// the events they mean (an `encoded`); the decoder must return exactly those events, consume
+// exactly those bytes, leave the buffer untouched, and the scanner must split a stream of them
+// back into the same list, in one read or cut into arbitrary reads. Key events must match
+// their own Keystroke() and String() through MatchString.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn at their natural rate, so the
+// properties that meet them fail, naming the shape, and are the expected failures mapped to
+// the bugs (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over its shape
+// region alone, and the TestHegelPin tests are the regression examples. HEGEL_NO_KNOWN=1
+// switches the known shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// UV_COLLECT=1 turns failures into a tally per property (UV_STACK=1 adds stacks to panics).
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"image/color"
+	"io"
+	"os"
+	"reflect"
+	"runtime"
+	"runtime/debug"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/rivo/uniseg"
+	"github.com/xo/terminfo"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape (mismatch); under HEGEL_NO_KNOWN=1 the shapes are left out of the generators (shaped),
+// a step or check that a known shape would falsify is counted and skipped (known), and a
+// mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// known reports whether a step or check whose shape is that of the recorded bug shape ("" for
+// none) is to be skipped: only under HEGEL_NO_KNOWN=1, where it is counted.
+func known(shape string) bool {
+	if shape == "" || !noKnown {
+		return false
+	}
+	count(shape + "-skipped")
+	return true
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("UV_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is that of the
+// recorded bug shape names ("" for none, several joined by ", "): the failure names the shape,
+// and under HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then,
+// since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shapes joins the non-empty shape names for mismatch.
+func shapes(names ...string) string {
+	var out []string
+	for _, s := range names {
+		if s != "" && !slices.Contains(out, s) {
+			out = append(out, s)
+		}
+	}
+	return strings.Join(out, ", ")
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			if hegelPanic(r) {
+				panic(r)
+			}
+			msg := fmt.Sprintf("panic in the code under test: %v", r)
+			if os.Getenv("UV_STACK") != "" {
+				msg += "\n" + string(debug.Stack())
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, msg)
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("%s", msg)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// hegelPanic reports a panic of hegel's own (a failed or skipped case unwinding), which must
+// pass through.
+func hegelPanic(r any) bool {
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		return true
+	}
+	// hegel ends a case (assumption failed, choice budget spent) by panicking with an error
+	// value; the code under test panics with runtime errors or strings.
+	if err, ok := r.(error); ok {
+		var rt runtime.Error
+		return !errors.As(err, &rt)
+	}
+	return false
+}
+
+// naming runs fn and reports a panic of the code under test as a mismatch of the given shape
+// (a panic is how some recorded bugs show).
+func naming(ht *hegel.T, shape string, fn func()) {
+	defer func() {
+		r := recover()
+		if r == nil {
+			return
+		}
+		if _, ok := r.(collected); ok || hegelPanic(r) {
+			panic(r)
+		}
+		mismatch(ht, shape, "panic in the code under test: %v", r)
+	}()
+	fn()
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// guard marks a pin: it must fail (the bug is open) and it must not panic the suite.
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Errorf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// at is the element of xs at a drawn position, modulo the size.
+func at[T any](xs []T, pos int) T { return xs[pos%len(xs)] }
+
+// bytesOf is a generator of n to m bytes as a string.
+func bytesOf(lo, hi int) hegel.Generator[string] {
+	return hegel.Map(hegel.Binary(lo, hi), func(b []byte) string { return string(b) })
+}
+
+// itoa is strconv.Itoa, short.
+func itoa(n int) string { return strconv.Itoa(n) }
+
+// ---------------------------------------------------------------- events
+
+// normalize makes events comparable with reflect.DeepEqual: colours become color.RGBA.
+func normalize(ev Event) Event {
+	toRGBA := func(c color.Color) color.Color {
+		if c == nil {
+			return nil
+		}
+		r, g, b, a := c.RGBA()
+		return color.RGBA{uint8(r >> 8), uint8(g >> 8), uint8(b >> 8), uint8(a >> 8)}
+	}
+	switch e := ev.(type) {
+	case ForegroundColorEvent:
+		return ForegroundColorEvent{toRGBA(e.Color)}
+	case BackgroundColorEvent:
+		return BackgroundColorEvent{toRGBA(e.Color)}
+	case CursorColorEvent:
+		return CursorColorEvent{toRGBA(e.Color)}
+	case MultiEvent:
+		out := make(MultiEvent, len(e))
+		for i, x := range e {
+			out[i] = normalize(x)
+		}
+		return out
+	}
+	return ev
+}
+
+func flatten(evs []Event) []Event {
+	var out []Event
+	for _, ev := range evs {
+		if m, ok := ev.(MultiEvent); ok {
+			out = append(out, flatten([]Event(m))...)
+		} else {
+			out = append(out, normalize(ev))
+		}
+	}
+	return out
+}
+
+func eventString(ev Event) string {
+	switch e := ev.(type) {
+	case KeyPressEvent:
+		return fmt.Sprintf("KeyPress{Code:%#x(%q) Text:%q Mod:%#b Shifted:%#x Base:%#x Repeat:%v}", e.Code, keyName(e.Code), e.Text, e.Mod, e.ShiftedCode, e.BaseCode, e.IsRepeat)
+	case KeyReleaseEvent:
+		return fmt.Sprintf("KeyRelease{Code:%#x(%q) Text:%q Mod:%#b Shifted:%#x Base:%#x Repeat:%v}", e.Code, keyName(e.Code), e.Text, e.Mod, e.ShiftedCode, e.BaseCode, e.IsRepeat)
+	}
+	return fmt.Sprintf("%T%+v", ev, ev)
+}
+
+func keyName(code rune) string {
+	if s, ok := keyTypeString[code]; ok {
+		return s
+	}
+	if code == KeyExtended {
+		return "extended"
+	}
+	return string(code)
+}
+
+func eventsString(evs []Event) string {
+	parts := make([]string, len(evs))
+	for i, ev := range evs {
+		parts[i] = eventString(ev)
+	}
+	return strings.Join(parts, "\n    ")
+}
+
+// ---------------------------------------------------------------- generators
+
+// encoded is a byte sequence and the events it stands for.
+type encoded struct {
+	kind string
+	seq  string
+	want []Event
+}
+
+func (e encoded) GoString() string { return fmt.Sprintf("%s %q", e.kind, e.seq) }
+
+// shape names the recorded bug whose shape the sequence has ("" for none): the kinds below are
+// drawn only while the shapes are on.
+func (e encoded) shape() string {
+	switch e.kind {
+	case "kitty-shifted-and-base":
+		return "ultraviolet/1"
+	case "invalid-byte":
+		return "ultraviolet/8"
+	case "ascii-cluster":
+		return "ultraviolet/9"
+	case "csi-many-params":
+		return "ultraviolet/10"
+	case "alt-introducer":
+		return "ultraviolet/13"
+	}
+	return ""
+}
+
+var (
+	// Graphemes that are single runes and never combine with what follows.
+	singleRunes = []rune{'a', 'b', 'q', 'z', 'A', 'Q', 'Z', '0', '9', '!', '/', '?', '~', '#', '{', '}', '`', '+', 'é', 'ñ', 'Ω', 'я', '世', '☃', '😃', 'Ａ'}
+	// Multi-rune grapheme clusters that start with a non-ASCII rune.
+	clusters = []string{"ก\u0e49", "👍🏽", "👨\u200d👩\u200d👧", "🇩🇪", "é\u0301"}
+	// Multi-rune clusters that start with an ASCII byte (split by the ASCII shortcut, pinned).
+	asciiClusters = []string{"e\u0301", "n\u0303", "1\ufe0f\u20e3", "a\u200d"}
+)
+
+// clusterPool holds every cluster; the ASCII-led ones are the shape of ultraviolet/9 and are
+// left out under HEGEL_NO_KNOWN=1.
+var clusterPool = shaped(slices.Concat(clusters, asciiClusters), clusters)
+
+func keyPress(code rune, text string, mod KeyMod) KeyPressEvent {
+	return KeyPressEvent{Code: code, Text: text, Mod: mod}
+}
+
+// runeKey is the key a printable rune types: an ASCII capital is the lower-case key with shift.
+func runeKey(r rune) encoded {
+	k := keyPress(r, string(r), 0)
+	if r < utf8.RuneSelf && unicode.IsUpper(r) {
+		k = KeyPressEvent{Code: unicode.ToLower(r), ShiftedCode: r, Text: string(r), Mod: ModShift}
+	}
+	return encoded{"text", string(r), []Event{k}}
+}
+
+// clusterKey is the one KeyExtended press a multi-rune grapheme cluster types.
+func clusterKey(c string) encoded {
+	kind := "cluster"
+	if c[0] < utf8.RuneSelf {
+		kind = "ascii-cluster"
+	}
+	return encoded{kind, c, []Event{keyPress(KeyExtended, c, 0)}}
+}
+
+// controlKey is the VT100 meaning of a C0 byte with no flags set.
+func controlKey(b byte) KeyPressEvent {
+	switch b {
+	case ansi.NUL:
+		return keyPress(KeySpace, "", ModCtrl)
+	case ansi.BS:
+		return keyPress('h', "", ModCtrl)
+	case ansi.HT:
+		return keyPress(KeyTab, "", 0)
+	case ansi.CR:
+		return keyPress(KeyEnter, "", 0)
+	case ansi.ESC:
+		return keyPress(KeyEscape, "", 0)
+	case ansi.DEL:
+		return keyPress(KeyBackspace, "", 0)
+	}
+	if b <= ansi.SUB {
+		return keyPress(rune(b+0x60), "", ModCtrl)
+	}
+	return keyPress(rune(b+0x40), "", ModCtrl) // FS GS RS US: ctrl+\ ] ^ _
+}
+
+func controlSeq(b byte) encoded {
+	return encoded{"control", string([]byte{b}), []Event{controlKey(b)}}
+}
+
+var (
+	runeKeys    = hegel.Map(hegel.SampledFrom(singleRunes), runeKey)
+	clusterKeys = hegel.Map(hegel.SampledFrom(clusterPool), clusterKey)
+	spaceKey    = hegel.Just(encoded{"space", " ", []Event{keyPress(KeySpace, " ", 0)}})
+	// controlBytes: a C0 byte, DEL once in ten.
+	controlBytes = weighted(
+		choice[byte]{90, hegel.Map(hegel.Integers(0, 31), func(n int) byte { return byte(n) })},
+		choice[byte]{10, hegel.Just(byte(ansi.DEL))},
+	)
+)
+
+// textKeys: a printable grapheme or a C0 control byte and its key event (no legacy flags). A
+// lone ESC is admitted only where nothing follows it (last), since ESC followed by more bytes
+// is an escape sequence or an alt key.
+func textKeys(last bool) hegel.Generator[encoded] {
+	controls := hegel.Map(controlBytes, func(b byte) encoded {
+		if b == ansi.ESC && !last {
+			b = ansi.SOH
+		}
+		return controlSeq(b)
+	})
+	return weighted(
+		choice[encoded]{50, runeKeys},
+		choice[encoded]{10, clusterKeys},
+		choice[encoded]{10, spaceKey},
+		choice[encoded]{30, controls},
+	)
+}
+
+// altKey prefixes a key with ESC: the same key with alt and no text.
+func altKey(inner encoded) encoded {
+	k := inner.want[0].(KeyPressEvent)
+	k.Mod |= ModAlt
+	k.Text = ""
+	return encoded{"alt+" + inner.kind, "\x1b" + inner.seq, []Event{k}}
+}
+
+// introducerRunes: ESC followed by O, P or X introduces SS3, DCS and SOS, so alt+shift+o/p/x
+// are decodable only when nothing follows them in the read; the shortcuts decode them without
+// ShiftedCode (ultraviolet/13; left out under HEGEL_NO_KNOWN=1).
+var introducerRunes = shaped([]rune{'O', 'P', 'X'}, nil)
+
+// altKeys: ESC and a text key. ESC ESC followed by more bytes is ambiguous (alt+esc then a key,
+// or esc then an alt key), so the inner key is never a lone ESC; the introducer letters come
+// only last.
+func altKeys(last bool) hegel.Generator[encoded] {
+	alts := hegel.Map(textKeys(false), altKey)
+	if !last || len(introducerRunes) == 0 {
+		return alts
+	}
+	introducers := hegel.Map(hegel.SampledFrom(introducerRunes), func(r rune) encoded {
+		e := altKey(runeKey(r))
+		e.kind = "alt-introducer"
+		return e
+	})
+	return weighted(choice[encoded]{90, alts}, choice[encoded]{10, introducers})
+}
+
+// ---------------------------------------------------------------- function keys
+
+var (
+	csiFuncKeys = map[byte]rune{'A': KeyUp, 'B': KeyDown, 'C': KeyRight, 'D': KeyLeft, 'E': KeyBegin, 'F': KeyEnd, 'H': KeyHome, 'P': KeyF1, 'Q': KeyF2, 'R': KeyF3, 'S': KeyF4}
+	ss3Keys     = map[byte]rune{'A': KeyUp, 'B': KeyDown, 'C': KeyRight, 'D': KeyLeft, 'E': KeyBegin, 'F': KeyEnd, 'H': KeyHome, 'P': KeyF1, 'Q': KeyF2, 'R': KeyF3, 'S': KeyF4,
+		'M': KeyKpEnter, 'X': KeyKpEqual, 'j': KeyKpMultiply, 'k': KeyKpPlus, 'l': KeyKpComma, 'm': KeyKpMinus, 'n': KeyKpDecimal, 'o': KeyKpDivide,
+		'p': KeyKp0, 'q': KeyKp1, 'r': KeyKp2, 's': KeyKp3, 't': KeyKp4, 'u': KeyKp5, 'v': KeyKp6, 'w': KeyKp7, 'x': KeyKp8, 'y': KeyKp9}
+	tildeKeys = map[int]rune{1: KeyHome, 2: KeyInsert, 3: KeyDelete, 4: KeyEnd, 5: KeyPgUp, 6: KeyPgDown, 7: KeyHome, 8: KeyEnd,
+		11: KeyF1, 12: KeyF2, 13: KeyF3, 14: KeyF4, 15: KeyF5, 17: KeyF6, 18: KeyF7, 19: KeyF8, 20: KeyF9, 21: KeyF10,
+		23: KeyF11, 24: KeyF12, 25: KeyF13, 26: KeyF14, 28: KeyF15, 29: KeyF16, 31: KeyF17, 32: KeyF18, 33: KeyF19, 34: KeyF20}
+)
+
+func sortedKeys[K int | byte, V any](m map[K]V) []K {
+	ks := make([]K, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Slice(ks, func(i, j int) bool { return ks[i] < ks[j] })
+	return ks
+}
+
+// modifierBits: a PC-style modifier set (shift 1, alt 2, ctrl 4, meta 8); the parameter the
+// protocols write is the set plus one.
+var modifierBits = hegel.Integers(0, 15)
+
+// eventType is Kitty's event-type sub-parameter: absent, 1 press, 2 repeat, 3 release.
+type eventType int
+
+var eventTypes = hegel.Integers[eventType](0, 3)
+
+func (t eventType) suffix() string {
+	if t == 0 {
+		return ""
+	}
+	return ":" + itoa(int(t))
+}
+
+// apply gives the key event the type stands for.
+func (t eventType) apply(k KeyPressEvent) Event {
+	switch t {
+	case 2:
+		k.IsRepeat = true
+	case 3:
+		return KeyReleaseEvent(k)
+	}
+	return k
+}
+
+// modified is a modifier set and an event type for a modified function key.
+type modified struct {
+	m  int
+	ev eventType
+}
+
+var modifieds = hegel.Composite(func(tc hegel.TestCase) modified {
+	return modified{hegel.Draw(tc, modifierBits), hegel.Draw(tc, eventTypes)}
+})
+
+var (
+	csiFinals = hegel.SampledFrom(sortedKeys(csiFuncKeys))
+	tildeIDs  = hegel.SampledFrom(sortedKeys(tildeKeys))
+	ss3Finals = hegel.SampledFrom(sortedKeys(ss3Keys))
+)
+
+func csiFuncPlain(f byte) encoded {
+	return encoded{"csi-func", "\x1b[" + string(f), []Event{keyPress(csiFuncKeys[f], "", 0)}}
+}
+
+// csiFuncOne is CSI 1 F; CSI 1 R would be a cursor position report, so F3 stays CSI R.
+func csiFuncOne(f byte) encoded {
+	if f == 'R' {
+		return csiFuncPlain(f)
+	}
+	return encoded{"csi-func", "\x1b[1" + string(f), []Event{keyPress(csiFuncKeys[f], "", 0)}}
+}
+
+// csiFuncMod is CSI 1;mod[:event] F. CSI 1;mod R is also a cursor position report on row 1;
+// the decoder reports both, by design (Kitty-style event types on F3 use CSI 13;mod:ev ~).
+func csiFuncMod(f byte, md modified) encoded {
+	k := keyPress(csiFuncKeys[f], "", KeyMod(md.m))
+	m := itoa(md.m + 1)
+	if f == 'R' {
+		return encoded{"csi-func-mod", "\x1b[1;" + m + "R", []Event{k, CursorPositionEvent{Y: 0, X: md.m}}}
+	}
+	return encoded{"csi-func-mod", "\x1b[1;" + m + md.ev.suffix() + string(f), []Event{md.ev.apply(k)}}
+}
+
+func tildePlain(id int) encoded {
+	return encoded{"csi-tilde", "\x1b[" + itoa(id) + "~", []Event{keyPress(tildeKeys[id], "", 0)}}
+}
+
+func tildeMod(id int, md modified) encoded {
+	k := keyPress(tildeKeys[id], "", KeyMod(md.m))
+	return encoded{"csi-tilde-mod", "\x1b[" + itoa(id) + ";" + itoa(md.m+1) + md.ev.suffix() + "~", []Event{md.ev.apply(k)}}
+}
+
+func ss3Plain(f byte) encoded {
+	return encoded{"ss3", "\x1bO" + string(f), []Event{keyPress(ss3Keys[f], "", 0)}}
+}
+
+func ss3Mod(f byte, m int) encoded {
+	return encoded{"ss3-mod", "\x1bO" + itoa(m+1) + string(f), []Event{keyPress(ss3Keys[f], "", KeyMod(m))}}
+}
+
+// urxvtForm is one of URxvt's final bytes for a modified key: ^ ctrl, @ ctrl+shift, $ shift.
+type urxvtForm struct {
+	final byte
+	mod   KeyMod
+	kind  string
+}
+
+// urxvtForms: CSI n $ followed by a final byte (any letter) is one ECMA-48 control sequence ($
+// is an intermediate), so the $ form is decodable only when the buffer ends at the $: it is kept
+// out of streams.
+var (
+	urxvtForms       = []urxvtForm{{'^', ModCtrl, "urxvt"}, {'@', ModCtrl | ModShift, "urxvt"}, {'$', ModShift, "urxvt-dollar"}}
+	urxvtStreamForms = urxvtForms[:2]
+)
+
+func urxvtKey(id int, f urxvtForm) encoded {
+	return encoded{f.kind, "\x1b[" + itoa(id) + string(f.final), []Event{keyPress(tildeKeys[id], "", f.mod)}}
+}
+
+// functionKeys: a PC-style function key as CSI 1;mod[:event] F, CSI n;mod[:event] ~, SS3 mod
+// F or a URxvt form (all three standalone, the two stream-safe ones in streams).
+func functionKeys(forms []urxvtForm) hegel.Generator[encoded] {
+	csiFuncs := weighted(
+		choice[encoded]{25, hegel.Map(csiFinals, csiFuncPlain)},
+		choice[encoded]{25, hegel.Map(csiFinals, csiFuncOne)},
+		choice[encoded]{50, hegel.Composite(func(tc hegel.TestCase) encoded {
+			return csiFuncMod(hegel.Draw(tc, csiFinals), hegel.Draw(tc, modifieds))
+		})},
+	)
+	tildes := weighted(
+		choice[encoded]{30, hegel.Map(tildeIDs, tildePlain)},
+		choice[encoded]{70, hegel.Composite(func(tc hegel.TestCase) encoded {
+			return tildeMod(hegel.Draw(tc, tildeIDs), hegel.Draw(tc, modifieds))
+		})},
+	)
+	ss3s := weighted(
+		choice[encoded]{40, hegel.Map(ss3Finals, ss3Plain)},
+		choice[encoded]{60, hegel.Composite(func(tc hegel.TestCase) encoded {
+			return ss3Mod(hegel.Draw(tc, ss3Finals), hegel.Draw(tc, modifierBits))
+		})},
+	)
+	urxvts := hegel.Composite(func(tc hegel.TestCase) encoded {
+		return urxvtKey(hegel.Draw(tc, tildeIDs), hegel.Draw(tc, hegel.SampledFrom(forms)))
+	})
+	return weighted(choice[encoded]{2, csiFuncs}, choice[encoded]{2, tildes}, choice[encoded]{1, ss3s}, choice[encoded]{1, urxvts})
+}
+
+// ---------------------------------------------------------------- Kitty keys
+
+// keypadText is the text the decoder derives for keypad keys without an explicit text field.
+var keypadText = map[rune]string{KeyKp0: "0", KeyKp1: "1", KeyKp2: "2", KeyKp3: "3", KeyKp4: "4", KeyKp5: "5", KeyKp6: "6", KeyKp7: "7", KeyKp8: "8", KeyKp9: "9",
+	KeyKpEqual: "=", KeyKpMultiply: "*", KeyKpPlus: "+", KeyKpMinus: "-", KeyKpDecimal: ".", KeyKpDivide: "/", KeyKpSep: ","}
+
+// Kitty functional key codes (a sample) and the C0 specials the protocol keeps.
+var kittyFunctional = []int{57344, 57345, 57346, 57347, 57348, 57349, 57350, 57353, 57358, 57361, 57364, 57375, 57398, 57399, 57408, 57414, 57427, 57428, 57440, 57441, 57452, 57454}
+
+// kittyText is the text a program should derive for a text-producing key without an
+// explicit text field: nothing under alt/ctrl/super/hyper/meta, the shifted key under shift
+// or caps lock, the key itself otherwise. Lock modifiers alone do not remove the text.
+func kittyText(code, shifted rune, mod KeyMod) string {
+	if mod&^(ModShift|ModCapsLock|ModNumLock) != 0 {
+		return ""
+	}
+	if t, ok := keypadText[code]; ok {
+		// The decoder derives the keypad keys' text itself (kitty sends none): the digit or
+		// operator, under shift too.
+		return t
+	}
+	if !unicode.IsPrint(code) {
+		return ""
+	}
+	if mod&(ModShift|ModCapsLock) == 0 {
+		return string(code)
+	}
+	if shifted != 0 {
+		return string(shifted)
+	}
+	return string(unicode.ToUpper(code))
+}
+
+// kittyCode is the key a Kitty report is about: a printable rune, a functional key or one of
+// the C0 specials the protocol keeps.
+type kittyCode struct {
+	code       rune
+	key        KeyPressEvent
+	functional bool
+}
+
+func functionalCode(c int) kittyCode { return kittyCode{rune(c), KeyPressEvent(kittyKeyMap[c]), true} }
+
+var (
+	kittyRunes          = []rune{'a', 'b', 'z', 'q', '1', '9', ';', '/', '[', '=', '+', 'é', 'ø', 'я', '世', '☃'}
+	printableKittyCodes = hegel.Map(hegel.SampledFrom(kittyRunes), func(r rune) kittyCode { return kittyCode{r, KeyPressEvent{Code: r}, false} })
+)
+
+// kittyCodesFrom: a printable rune four times in six, one of the functional codes or a C0
+// special otherwise.
+func kittyCodesFrom(functional []int) hegel.Generator[kittyCode] {
+	return weighted(
+		choice[kittyCode]{4, printableKittyCodes},
+		choice[kittyCode]{1, hegel.Map(hegel.SampledFrom(functional), functionalCode)},
+		choice[kittyCode]{1, hegel.Map(hegel.SampledFrom([]int{9, 13, 27, 127}), functionalCode)},
+	)
+}
+
+// functionalKeys lists the functional codes of kittyFunctional whose key satisfies pred.
+func functionalKeys(pred func(code rune) bool) []int {
+	var out []int
+	for _, c := range kittyFunctional {
+		if pred(kittyKeyMap[c].Code) {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+var (
+	kittyCodes = kittyCodesFrom(kittyFunctional)
+	// plainFunctional: the functional keys that are no modifier, keypad or lock key, whose
+	// keys MatchString rejects (ultraviolet/7, /14, /15).
+	plainFunctional = functionalKeys(func(code rune) bool {
+		return !isModifierKey(code) && !isKeypadKey(code) && !isLockKey(code)
+	})
+	plainKittyCodes = kittyCodesFrom(plainFunctional)
+)
+
+// shiftDecoration is the "report alternate keys" decoration of a printable key: the shifted key
+// (the upper case, or fallback when there is none) and the base-layout key, 0 for none. The
+// base key is the shape of ultraviolet/1 and is left out under HEGEL_NO_KNOWN=1.
+type shiftDecoration struct {
+	fallback rune
+	base     rune
+}
+
+var (
+	shiftFallbacks = hegel.SampledFrom([]rune{'!', '@', '?', ':', '{', '+'})
+	baseRunes      = hegel.SampledFrom([]rune{'a', 'q', 'z', '1', ';'})
+)
+
+// shiftDecorationsWith: the shifted key and a base key drawn from base (0 for none).
+func shiftDecorationsWith(base hegel.Generator[rune]) hegel.Generator[shiftDecoration] {
+	return hegel.Composite(func(tc hegel.TestCase) shiftDecoration {
+		return shiftDecoration{
+			fallback: hegel.Draw(tc, shiftFallbacks),
+			base:     hegel.Draw(tc, base),
+		}
+	})
+}
+
+var shiftDecorations = shiftDecorationsWith(shaped(maybe(50, baseRunes), hegel.Just[rune](0)))
+
+// kittyAssociated is an explicit associated-text field: the key's own text and maybe a tail.
+type kittyAssociated struct {
+	on   bool
+	tail string
+}
+
+var kittyAssociateds = hegel.Map(maybe(30, hegel.SampledFrom([]string{"b", "\u0300", "☃"})), func(tail string) kittyAssociated {
+	return kittyAssociated{true, tail}
+})
+
+// kittySpec is one Kitty keyboard report: CSI code[:shifted[:base]] ; mods[:event] ; text u.
+type kittySpec struct {
+	kc      kittyCode
+	shift   shiftDecoration // zero for none (fallback is never 0 when drawn)
+	bits    int             // the modifier bits, lock bits included
+	ev      eventType       //
+	oneMods bool            // spell an empty modifier field as 1 when the event type needs the field
+	text    kittyAssociated // the explicit text field
+}
+
+var (
+	// lockBits: caps lock (64), num lock (128) or both.
+	lockBits = hegel.SampledFrom([]int{64, 128, 192})
+	// kittyModBits: any of the six modifier bits, with lock bits three times in ten.
+	kittyModBits = hegel.Composite(func(tc hegel.TestCase) int {
+		return hegel.Draw(tc, hegel.Integers(0, 63)) | hegel.Draw(tc, maybe(30, lockBits))
+	})
+	kittyKeys = kittyKeysWith(kittyCodes, kittyModBits)
+)
+
+// kittyKeysWith: a Kitty report with the key drawn from codes and the modifier bits from mods.
+func kittyKeysWith(codes hegel.Generator[kittyCode], mods hegel.Generator[int]) hegel.Generator[encoded] {
+	specs := hegel.Composite(func(tc hegel.TestCase) kittySpec {
+		return kittySpec{
+			kc:      hegel.Draw(tc, codes),
+			shift:   hegel.Draw(tc, maybe(40, shiftDecorations)),
+			bits:    hegel.Draw(tc, mods),
+			ev:      hegel.Draw(tc, eventTypes),
+			oneMods: hegel.Draw(tc, chance(70)),
+			text:    hegel.Draw(tc, maybe(30, kittyAssociateds)),
+		}
+	})
+	return hegel.Map(specs, kittySpec.encoded)
+}
+
+// encoded renders the report; the shift decoration and the text field apply to printable keys
+// only.
+func (s kittySpec) encoded() encoded {
+	code, key := s.kc.code, s.kc.key
+	codes := itoa(int(code))
+	var shifted, base rune
+	if !s.kc.functional && s.shift.fallback != 0 {
+		shifted = unicode.ToUpper(code)
+		if shifted == code {
+			shifted = s.shift.fallback
+		}
+		codes += ":" + itoa(int(shifted))
+		key.ShiftedCode = shifted
+		if base = s.shift.base; base != 0 {
+			codes += ":" + itoa(int(base))
+			key.BaseCode = base
+		}
+	}
+	key.Mod = fromKittyMod(s.bits)
+	mods := ""
+	if s.bits != 0 {
+		mods = itoa(s.bits + 1)
+	}
+	suffix, ev := s.ev.suffix(), s.ev.apply(key)
+	if suffix != "" && mods == "" && s.oneMods {
+		mods = "1"
+	}
+	seq := "\x1b[" + codes
+	text := ""
+	explicit := !s.kc.functional && s.text.on
+	if mods != "" || suffix != "" || explicit {
+		seq += ";" + mods + suffix
+	}
+	if explicit {
+		text = string(code) + s.text.tail
+		parts := make([]string, 0, 2)
+		for _, r := range text {
+			parts = append(parts, itoa(int(r)))
+		}
+		seq += ";" + strings.Join(parts, ":")
+	} else if !s.kc.functional {
+		text = kittyText(code, shifted, key.Mod)
+	} else if t, ok := keypadText[key.Code]; ok && key.Mod&^(ModShift|ModCapsLock|ModNumLock) == 0 {
+		text = t // the decoder derives the keypad keys' text
+	}
+	seq += "u"
+	kind := "kitty"
+	if base != 0 {
+		kind = "kitty-shifted-and-base"
+	}
+	switch e := ev.(type) {
+	case KeyPressEvent:
+		e.Text = text
+		ev = e
+	case KeyReleaseEvent:
+		e.Text = text
+		ev = e
+	}
+	return encoded{kind, seq, []Event{ev}}
+}
+
+// ---------------------------------------------------------------- modifyOtherKeys
+
+// mokCode is the key of an xterm CSI 27;mod;code~ report: a printable rune or a special.
+type mokCode struct {
+	code int
+	key  KeyPressEvent
+}
+
+var (
+	mokSpecials = map[int]rune{8: KeyBackspace, 9: KeyTab, 13: KeyEnter, 27: KeyEscape, 127: KeyBackspace}
+	mokCodes    = weighted(
+		choice[mokCode]{80, hegel.Map(hegel.SampledFrom([]rune{'a', 'A', 'z', '1', ' ', ';', '/', '+', 'é', '世', '☃', '😃'}), func(r rune) mokCode {
+			return mokCode{int(r), KeyPressEvent{Code: r}}
+		})},
+		choice[mokCode]{20, hegel.Map(hegel.SampledFrom(sortedKeys(mokSpecials)), func(c int) mokCode {
+			return mokCode{c, KeyPressEvent{Code: mokSpecials[c]}}
+		})},
+	)
+	// modifyOtherKeys: xterm's CSI 27 ; mod ; code ~; a printable key has its text under shift
+	// at most.
+	modifyOtherKeys = hegel.Composite(func(tc hegel.TestCase) encoded {
+		c, m := hegel.Draw(tc, mokCodes), hegel.Draw(tc, modifierBits)
+		k := c.key
+		k.Mod = KeyMod(m)
+		if _, special := mokSpecials[c.code]; !special && k.Mod <= ModShift {
+			k.Text = string(rune(c.code))
+		}
+		return encoded{"modify-other-keys", "\x1b[27;" + itoa(m+1) + ";" + itoa(c.code) + "~", []Event{k}}
+	})
+)
+
+// ---------------------------------------------------------------- mouse
+
+// mouseSpec is a mouse event and the encoding (SGR or X10) it arrives in.
+type mouseSpec struct {
+	btn                      MouseButton
+	motion, shift, alt, ctrl bool
+	sgr, release             bool
+	x, y                     int
+}
+
+var mouseButtons = []MouseButton{MouseNone, MouseLeft, MouseMiddle, MouseRight, MouseWheelUp, MouseWheelDown, MouseWheelLeft, MouseWheelRight, MouseBackward, MouseForward, MouseButton10, MouseButton11}
+
+var mouseSpecs = hegel.Composite(func(tc hegel.TestCase) mouseSpec {
+	return mouseSpec{
+		btn:     hegel.Draw(tc, hegel.SampledFrom(mouseButtons)),
+		motion:  hegel.Draw(tc, chance(30)),
+		shift:   hegel.Draw(tc, chance(30)),
+		alt:     hegel.Draw(tc, chance(30)),
+		ctrl:    hegel.Draw(tc, chance(30)),
+		sgr:     hegel.Draw(tc, chance(60)),
+		release: hegel.Draw(tc, chance(40)),
+		x:       hegel.Draw(tc, hegel.Integers(0, 5000)),
+		y:       hegel.Draw(tc, hegel.Integers(0, 5000)),
+	}
+})
+
+// encoded renders the report with x/ansi's encoders (X10's payload by hand: ansi.MouseX10
+// encodes its bytes as runes, x-ansi/22). X10 coordinates are at most 222.
+func (m mouseSpec) encoded() encoded {
+	var mod KeyMod
+	if m.shift {
+		mod |= ModShift
+	}
+	if m.alt {
+		mod |= ModAlt
+	}
+	if m.ctrl {
+		mod |= ModCtrl
+	}
+	b := ansi.EncodeMouseButton(m.btn, m.motion, m.shift, m.alt, m.ctrl)
+	wheel := m.btn >= MouseWheelUp && m.btn <= MouseWheelRight
+	x, y := m.x, m.y
+	if !m.sgr {
+		x, y = x%223, y%223
+	}
+	ev := Mouse{X: x, Y: y, Button: m.btn, Mod: mod}
+	release := m.sgr && m.release && m.btn != MouseNone && !wheel && !m.motion
+	var event Event
+	switch {
+	case wheel:
+		event = MouseWheelEvent(ev)
+	case m.motion:
+		event = MouseMotionEvent(ev)
+	case release || m.btn == MouseNone:
+		event = MouseReleaseEvent(ev)
+	default:
+		event = MouseClickEvent(ev)
+	}
+	if m.sgr {
+		return encoded{"mouse-sgr", ansi.MouseSgr(b, x, y, release || (m.btn == MouseNone && !m.motion)), []Event{event}}
+	}
+	return encoded{"mouse-x10", "\x1b[M" + string([]byte{b + 32, byte(x + 33), byte(y + 33)}), []Event{event}}
+}
+
+var mouseReports = hegel.Map(mouseSpecs, mouseSpec.encoded)
+
+// ---------------------------------------------------------------- terminal replies
+
+// stringTerminators: ST as ESC \ or BEL (for OSC replies).
+var stringTerminators = hegel.SampledFrom([]string{"\x1b\\", "\a"})
+
+func decEvent(kind, seq string, ev Event) encoded { return encoded{kind, seq, []Event{ev}} }
+
+var (
+	// cursorReports: CPR (CSI line;col R) or DECXCPR. CSI 1;mod R is also a modified F3; the
+	// decoder reports both, by design.
+	cursorReports = hegel.Composite(func(tc hegel.TestCase) encoded {
+		line, col := hegel.Draw(tc, hegel.Integers(1, 500)), hegel.Draw(tc, hegel.Integers(1, 500))
+		cpr := CursorPositionEvent{X: col - 1, Y: line - 1}
+		if hegel.Draw(tc, chance(30)) {
+			return decEvent("decxcpr", "\x1b[?"+itoa(line)+";"+itoa(col)+"R", cpr)
+		}
+		if line == 1 && col-1 <= int(ModMeta|ModShift|ModAlt|ModCtrl) {
+			return encoded{"cpr-f3", ansi.CursorPositionReport(line, col), []Event{KeyPressEvent{Code: KeyF3, Mod: KeyMod(col - 1)}, cpr}}
+		}
+		return decEvent("cpr", ansi.CursorPositionReport(line, col), cpr)
+	})
+	// modeReports: DECRPM for a DEC mode, or for an ANSI mode (CSI n $ y shares its prefix with
+	// URxvt's CSI n $, so a read cut after the $ is ambiguous: no cuts inside).
+	modeReports = hegel.Composite(func(tc hegel.TestCase) encoded {
+		v := ansi.ModeSetting(hegel.Draw(tc, hegel.Integers(0, 4)))
+		if hegel.Draw(tc, chance(60)) {
+			mode := ansi.DECMode(hegel.Draw(tc, hegel.Integers(1, 3000)))
+			return decEvent("decrpm", ansi.ReportMode(mode, v), ModeReportEvent{Mode: mode, Value: v})
+		}
+		mode := ansi.ANSIMode(hegel.Draw(tc, hegel.Integers(1, 200)))
+		return decEvent("decrpm-ansi", ansi.ReportMode(mode, v), ModeReportEvent{Mode: mode, Value: v})
+	})
+	deviceAttributes = hegel.Composite(func(tc hegel.TestCase) encoded {
+		attrs := hegel.Draw(tc, many(hegel.Integers(1, 99), 1, 6))
+		if hegel.Draw(tc, chance(50)) {
+			return decEvent("da2", ansi.SecondaryDeviceAttributes(attrs...), SecondaryDeviceAttributesEvent(attrs))
+		}
+		return decEvent("da1", ansi.PrimaryDeviceAttributes(attrs...), PrimaryDeviceAttributesEvent(attrs))
+	})
+	windowOps = hegel.Composite(func(tc hegel.TestCase) encoded {
+		op := hegel.Draw(tc, hegel.SampledFrom([]int{1, 2, 3, 5, 7, 9, 10, 11, 13, 14, 15, 16, 18, 19, 20, 21, 22, 23, 24, 30}))
+		args := hegel.Draw(tc, many(hegel.Integers(0, 4000), 0, 3))
+		return decEvent("winop", ansi.WindowOp(op, args...), WindowOpEvent{Op: op, Args: args})
+	})
+	focusReports = hegel.OneOf(
+		hegel.Just(decEvent("focus", "\x1b[I", FocusEvent{})),
+		hegel.Just(decEvent("blur", "\x1b[O", BlurEvent{})),
+	)
+	keyboardReports = hegel.OneOf(
+		hegel.Map(hegel.Integers(0, 31), func(f int) encoded {
+			return decEvent("kitty-flags", "\x1b[?"+itoa(f)+"u", KeyboardEnhancementsEvent{Flags: f})
+		}),
+		hegel.Map(hegel.Integers(0, 2), func(v int) encoded {
+			return decEvent("mok-state", "\x1b[>4;"+itoa(v)+"m", ModifyOtherKeysEvent{Mode: v})
+		}),
+	)
+	// colourReports: OSC 10/11/12 replies with an rgb: spec of 8-bit channels or of 16-bit X11
+	// channels whose high byte the reply keeps (a zero high byte gets a zero low byte: x/ansi's
+	// XParseColor keeps a four-digit channel whole when its high byte is zero).
+	colourReports = hegel.Composite(func(tc hegel.TestCase) encoded {
+		hi := hegel.Draw(tc, hegel.Lists(hegel.Integers(0, 255)).MinSize(3).MaxSize(3))
+		lo := hegel.Draw(tc, hegel.Lists(hegel.Integers(0, 255)).MinSize(3).MaxSize(3))
+		wide := hegel.Draw(tc, chance(60))
+		which := hegel.Draw(tc, hegel.Integers(10, 12))
+		st := hegel.Draw(tc, stringTerminators)
+		var spec string
+		if wide {
+			for i := range lo {
+				if hi[i] == 0 {
+					lo[i] = 0
+				}
+			}
+			spec = fmt.Sprintf("rgb:%02x%02x/%02x%02x/%02x%02x", hi[0], lo[0], hi[1], lo[1], hi[2], lo[2])
+		} else {
+			spec = fmt.Sprintf("rgb:%02x/%02x/%02x", hi[0], hi[1], hi[2])
+		}
+		c := color.RGBA{uint8(hi[0]), uint8(hi[1]), uint8(hi[2]), 0xff}
+		seq := "\x1b]" + itoa(which) + ";" + spec + st
+		switch which {
+		case 10:
+			return decEvent("osc-fg", seq, ForegroundColorEvent{c})
+		case 11:
+			return decEvent("osc-bg", seq, BackgroundColorEvent{c})
+		}
+		return decEvent("osc-cursor", seq, CursorColorEvent{c})
+	})
+	clipboardReports = hegel.Composite(func(tc hegel.TestCase) encoded {
+		sel := hegel.Draw(tc, hegel.SampledFrom([]byte{'c', 'p', 's', '0', '7'}))
+		data := hegel.Draw(tc, bytesOf(0, 12))
+		return decEvent("osc52", ansi.SetClipboard(sel, data), ClipboardEvent{Content: data, Selection: sel})
+	})
+	// capabilityReports: DCS 1+r name=value;... ST, hex-encoded.
+	capabilityReports = hegel.Composite(func(tc hegel.TestCase) encoded {
+		names := hegel.Draw(tc, many(hegel.SampledFrom([]string{"Tc", "RGB", "colors", "kbs", "smulx", "Su"}), 1, 3))
+		values := hegel.Draw(tc, hegel.Lists(hegel.SampledFrom([]string{"1", "256", "\x7f", "\x1b[4:%p1%dm", "x"})).MinSize(len(names)).MaxSize(len(names)))
+		var enc, want []string
+		for i, name := range names {
+			enc = append(enc, hex.EncodeToString([]byte(name))+"="+hex.EncodeToString([]byte(values[i])))
+			want = append(want, name+"="+values[i])
+		}
+		return decEvent("xtgettcap", "\x1bP1+r"+strings.Join(enc, ";")+"\x1b\\", CapabilityEvent{Content: strings.Join(want, ";")})
+	})
+	versionReports = hegel.Map(hegel.SampledFrom([]string{"XTerm(388)", "kitty(0.36.4)", "WezTerm 20240203-110809-5046fc22", "foot(1.18.1)", "1.2.3"}), func(v string) encoded {
+		return decEvent("xtversion", "\x1bP>|"+v+"\x1b\\", TerminalVersionEvent{Name: v})
+	})
+	sizeReports = hegel.OneOf(
+		hegel.Composite(func(tc hegel.TestCase) encoded {
+			h, w := hegel.Draw(tc, hegel.Integers(1, 4000)), hegel.Draw(tc, hegel.Integers(1, 4000))
+			return decEvent("winsize-pixels", ansi.WindowOp(4, h, w), PixelSizeEvent{Width: w, Height: h})
+		}),
+		hegel.Composite(func(tc hegel.TestCase) encoded {
+			h, w := hegel.Draw(tc, hegel.Integers(1, 100)), hegel.Draw(tc, hegel.Integers(1, 100))
+			return decEvent("winsize-cell", ansi.WindowOp(6, h, w), CellSizeEvent{Width: w, Height: h})
+		}),
+		hegel.Composite(func(tc hegel.TestCase) encoded {
+			h, w := hegel.Draw(tc, hegel.Integers(1, 500)), hegel.Draw(tc, hegel.Integers(1, 500))
+			return decEvent("winsize-cells", ansi.WindowOp(8, h, w), WindowSizeEvent{Width: w, Height: h})
+		}),
+		hegel.Composite(func(tc hegel.TestCase) encoded {
+			ch, cw := hegel.Draw(tc, hegel.Integers(1, 500)), hegel.Draw(tc, hegel.Integers(1, 500))
+			ph, pw := hegel.Draw(tc, hegel.Integers(1, 4000)), hegel.Draw(tc, hegel.Integers(1, 4000))
+			return encoded{"winsize-inband", ansi.WindowOp(48, ch, cw, ph, pw), []Event{WindowSizeEvent{Width: cw, Height: ch}, PixelSizeEvent{Width: pw, Height: ph}}}
+		}),
+	)
+	colourSchemeReports = hegel.OneOf(
+		hegel.Just(decEvent("light", ansi.LightDarkReport(false), LightColorSchemeEvent{})),
+		hegel.Just(decEvent("dark", ansi.LightDarkReport(true), DarkColorSchemeEvent{})),
+	)
+	tertiaryAttributes = hegel.Map(hegel.Binary(4, 4), func(id []byte) encoded {
+		return decEvent("da3", ansi.TertiaryDeviceAttributes(hex.EncodeToString(id)), TertiaryDeviceAttributesEvent(id))
+	})
+	graphicsReports = hegel.Composite(func(tc hegel.TestCase) encoded {
+		payload := []byte(hegel.Draw(tc, hegel.SampledFrom([]string{"", "AAAA", "iVBORw0KGgo=", "QUJDRA=="})))
+		opts := hegel.Draw(tc, hegel.SampledFrom([][]string{{"a=T", "f=100"}, {"i=31", "q=2"}, {"a=q", "i=1", "p=1"}, {"f=24", "s=10", "v=20"}}))
+		var g KittyGraphicsEvent
+		_ = g.Options.UnmarshalText([]byte(strings.Join(opts, ",")))
+		if len(payload) > 0 {
+			g.Payload = payload
+		}
+		return decEvent("kitty-graphics", ansi.KittyGraphics(payload, opts...), g)
+	})
+	// stringReports: PM, SOS and APC strings, which end with ST only (ECMA-48; BEL terminates
+	// OSC alone). An APC string starting with G would be Kitty graphics, and an empty one is
+	// not reported.
+	stringData    = hegel.SampledFrom([]string{"", "x", "hello", "G", "1;2;3", "abc def"})
+	stringReports = hegel.OneOf(
+		hegel.Map(stringData, func(data string) encoded {
+			seq := "\x1b^" + data + "\x1b\\"
+			return decEvent("pm", seq, UnknownPmEvent(seq))
+		}),
+		hegel.Map(stringData, func(data string) encoded {
+			seq := "\x1bX" + data + "\x1b\\"
+			return decEvent("sos", seq, UnknownSosEvent(seq))
+		}),
+		hegel.Map(stringData, func(data string) encoded {
+			if data == "G" || data == "" {
+				data = "hello"
+			}
+			seq := "\x1b_" + data + "\x1b\\"
+			return decEvent("apc", seq, UnknownApcEvent(seq))
+		}),
+	)
+	// unknownCSIs: a CSI the decoder has no meaning for (final byte z) with 1 to 40 parameters;
+	// above 32 parameters the decoder stops short (ultraviolet/10), so under HEGEL_NO_KNOWN=1
+	// there are at most 32.
+	unknownCSIs = csisOf(shaped(hegel.Integers(1, 40), hegel.Integers(1, 32)))
+	// scannerCSIs: the unknown CSIs a read through the scanner may hold, with 1 to 40
+	// parameters; above 32 the scanner panics (ultraviolet/35: it runs every read through
+	// x/ansi's DecodeSequence, eventScanner.deserializeWin32Input, which indexes past its 32
+	// parameters), so under HEGEL_NO_KNOWN=1 there are at most 32. The scanner properties
+	// (streams, cut streams, pastes) run the scanner under naming with scannerShape.
+	scannerCSIs = csisOf(shaped(hegel.Integers(1, 40), hegel.Integers(1, 32)))
+	// reports: one of the terminal's replies, the colour replies twice as often.
+	reports        = reportsWith(unknownCSIs)
+	scannerReports = reportsWith(scannerCSIs)
+)
+
+// scannerShape names ultraviolet/35 when a read holding the parts panics the scanner (a CSI
+// with more than 32 parameters anywhere in the read), "" otherwise.
+func scannerShape(parts []encoded) string {
+	for _, e := range parts {
+		if e.kind == "csi-many-params" {
+			return "ultraviolet/35"
+		}
+	}
+	return ""
+}
+
+// csisOf: a CSI the decoder has no meaning for (final byte z) with the drawn number of
+// parameters.
+func csisOf(params hegel.Generator[int]) hegel.Generator[encoded] {
+	return hegel.Map(params, func(k int) encoded {
+		seq := "\x1b[" + strings.TrimSuffix(strings.Repeat("1;", k), ";") + "z"
+		kind := "unknown-csi"
+		if k > 32 {
+			kind = "csi-many-params"
+		}
+		return decEvent(kind, seq, UnknownCsiEvent(seq))
+	})
+}
+
+// reportsWith: one of the terminal's replies, the colour replies twice as often, the unknown
+// CSIs from csis.
+func reportsWith(csis hegel.Generator[encoded]) hegel.Generator[encoded] {
+	return weighted(
+		choice[encoded]{1, cursorReports},
+		choice[encoded]{1, modeReports},
+		choice[encoded]{1, deviceAttributes},
+		choice[encoded]{1, windowOps},
+		choice[encoded]{1, focusReports},
+		choice[encoded]{1, keyboardReports},
+		choice[encoded]{2, colourReports},
+		choice[encoded]{1, clipboardReports},
+		choice[encoded]{1, capabilityReports},
+		choice[encoded]{1, versionReports},
+		choice[encoded]{1, sizeReports},
+		choice[encoded]{1, colourSchemeReports},
+		choice[encoded]{1, tertiaryAttributes},
+		choice[encoded]{1, graphicsReports},
+		choice[encoded]{1, stringReports},
+		choice[encoded]{1, csis},
+	)
+}
+
+var (
+	pasteMarkers = hegel.OneOf(
+		hegel.Just(decEvent("paste-start", "\x1b[200~", PasteStartEvent{})),
+		hegel.Just(decEvent("paste-end", "\x1b[201~", PasteEndEvent{})),
+	)
+	// invalidBytes: a byte that is no UTF-8 sequence on its own (a continuation or a lead
+	// byte); the decoder reports it as the rune with that value (ultraviolet/8). Not drawn
+	// under HEGEL_NO_KNOWN=1.
+	invalidBytes = hegel.Map(hegel.Integers(0xa0, 0xff), func(b int) encoded {
+		return decEvent("invalid-byte", string([]byte{byte(b)}), UnknownEvent(string([]byte{byte(b)})))
+	})
+)
+
+// ---------------------------------------------------------------- events and streams
+
+// streamEvents: an event that can stand in a stream of events; last admits what is decodable
+// only at the end of a read (a lone ESC, alt+O/P/X).
+func streamEvents(last bool) hegel.Generator[encoded] {
+	return weighted(
+		choice[encoded]{20, textKeys(last)},
+		choice[encoded]{10, altKeys(last)},
+		choice[encoded]{20, functionKeys(urxvtStreamForms)},
+		choice[encoded]{20, kittyKeys},
+		choice[encoded]{10, modifyOtherKeys},
+		choice[encoded]{10, mouseReports},
+		choice[encoded]{20, scannerReports},
+	)
+}
+
+// standaloneEventsWith: any event, including the ones only decodable alone (URxvt's $ form,
+// the paste markers, an invalid byte), the Kitty reports from kitty.
+func standaloneEventsWith(kitty hegel.Generator[encoded]) hegel.Generator[encoded] {
+	choices := []choice[encoded]{
+		{20, textKeys(true)},
+		{10, altKeys(true)},
+		{20, functionKeys(urxvtForms)},
+		{20, kitty},
+		{10, modifyOtherKeys},
+		{10, mouseReports},
+		{19, reports},
+		{1, pasteMarkers},
+	}
+	if !noKnown {
+		choices = append(choices, choice[encoded]{1, invalidBytes})
+	}
+	return weighted(choices...)
+}
+
+var (
+	standaloneEvents = standaloneEventsWith(kittyKeys)
+	// keystrokeEvents: the events whose keys are matched against their Keystroke; under
+	// HEGEL_NO_KNOWN=1 the Kitty reports carry no lock modifiers (ultraviolet/6) and are
+	// about no modifier, keypad or lock key (ultraviolet/7, /14, /15), whose keys MatchString
+	// rejects.
+	keystrokeEvents = shaped(standaloneEvents, standaloneEventsWith(kittyKeysWith(plainKittyCodes, hegel.Integers(0, 63))))
+)
+
+// stream is 1 to 6 events back to back.
+type stream struct {
+	parts []encoded
+}
+
+func (s stream) seq() string {
+	var sb strings.Builder
+	for _, e := range s.parts {
+		sb.WriteString(e.seq)
+	}
+	return sb.String()
+}
+
+func (s stream) want() []Event {
+	var want []Event
+	for _, e := range s.parts {
+		want = append(want, e.want...)
+	}
+	return flatten(want)
+}
+
+// shape names the recorded bugs whose shapes the parts have.
+func (s stream) shape() string {
+	names := make([]string, len(s.parts))
+	for i, e := range s.parts {
+		names[i] = e.shape()
+	}
+	return shapes(names...)
+}
+
+func (s stream) GoString() string {
+	kinds := make([]string, len(s.parts))
+	for i, e := range s.parts {
+		kinds[i] = e.kind
+	}
+	return fmt.Sprintf("stream %v %q", kinds, s.seq())
+}
+
+// streams draws the events before the last from the stream-safe generator and the last one
+// with the end-of-read shapes admitted.
+var streams = hegel.Composite(func(tc hegel.TestCase) stream {
+	parts := hegel.Draw(tc, many(streamEvents(false), 0, 5))
+	return stream{append(parts, hegel.Draw(tc, streamEvents(true)))}
+})
+
+// f3Ambiguous reports CSI 1;mod R: both a modified F3 and a cursor report, which the scanner's
+// whole-read table lookup resolves to F3 alone when the sequence fills a read (by design).
+func f3Ambiguous(e encoded) bool {
+	return e.kind == "cpr-f3" || (e.kind == "csi-func-mod" && strings.HasSuffix(e.seq, "R"))
+}
+
+// unambiguousInReads replaces an event whose sequence a read could isolate as a table key with
+// a focus event: a remainder that is exactly CSI 1;mod R is F3 only.
+func unambiguousInReads(e encoded) encoded {
+	if f3Ambiguous(e) {
+		return decEvent("focus", "\x1b[I", FocusEvent{})
+	}
+	return e
+}
+
+// cutStreams: a stream for the read-boundary properties, with the F3 ambiguity taken out and
+// a focus report put in before the last event when no read boundary could fall inside the
+// stream (single bytes, one cluster, an X10 report under HEGEL_NO_KNOWN=1); before the last
+// one, since the last may be a lone ESC, which nothing may follow.
+var cutStreams = hegel.Map(streams, func(s stream) stream {
+	for i, e := range s.parts {
+		s.parts[i] = unambiguousInReads(e)
+	}
+	if offsets, _ := cutPositions(s.parts); len(offsets) == 0 {
+		last := len(s.parts) - 1
+		s.parts = slices.Insert(s.parts, last, decEvent("focus", "\x1b[I", FocusEvent{}))
+	}
+	return s
+})
+
+// cutShape names what a read boundary inside a part means: "" where a cut is fine, "protocol"
+// where the protocol itself makes it ambiguous, or the recorded bug the cut reaches. offset is
+// the byte offset of the cut inside the part (1 to len-1).
+func cutShape(e encoded, offset int) string {
+	switch {
+	case e.kind == "decrpm-ansi":
+		return "protocol" // CSI n $ | y: the prefix is URxvt's CSI n $
+	case strings.HasSuffix(e.kind, "cluster"):
+		return "protocol" // a cluster cut between runes is two keys: the decoder cannot know more is coming
+	case e.kind == "mouse-x10":
+		return "ultraviolet/3" // CSI M cut before its payload is an UnknownCsiEvent
+	case offset == len(e.seq)-1 && strings.HasSuffix(e.seq, "\x1b\\"):
+		return "ultraviolet/16" // ST cut between ESC and \ ends the string at the ESC
+	}
+	return ""
+}
+
+// cutPositions lists the byte offsets of a stream where a read boundary may fall, and the
+// shape of each: the protocol's own ambiguities are never cut; the recorded bugs' cuts are
+// admitted while the shapes are on.
+func cutPositions(parts []encoded) (offsets []int, shapeAt map[int]string) {
+	shapeAt = map[int]string{}
+	pos := 0
+	for _, e := range parts {
+		skipped := ""
+		for i := 1; i < len(e.seq); i++ {
+			s := cutShape(e, i)
+			if s == "protocol" {
+				continue
+			}
+			if noKnown && s != "" {
+				skipped = s
+				continue
+			}
+			offsets = append(offsets, pos+i)
+			shapeAt[pos+i] = s
+		}
+		known(skipped) // counted once per part under HEGEL_NO_KNOWN=1
+		pos += len(e.seq)
+	}
+	return offsets, shapeAt
+}
+
+// cutsAt turns drawn positions into read boundaries: each position taken modulo the admitted
+// offsets, sorted and distinct.
+func cutsAt(positions []int, offsets []int) []int {
+	var cuts []int
+	for _, p := range positions {
+		c := at(offsets, p)
+		if !slices.Contains(cuts, c) {
+			cuts = append(cuts, c)
+		}
+	}
+	sort.Ints(cuts)
+	return cuts
+}
+
+// ---------------------------------------------------------------- properties
+
+var dumbTable = buildKeysTable(0, "dumb", false)
+
+// decodeAll runs the decoder over the whole buffer, flattening MultiEvents.
+func decodeAll(p *EventDecoder, buf []byte) []Event {
+	var events []Event
+	for len(buf) > 0 {
+		w, ev := p.Decode(buf)
+		if w == 0 {
+			w = 1
+		}
+		if ev != nil {
+			events = append(events, ev)
+		}
+		buf = buf[w:]
+	}
+	return flatten(events)
+}
+
+// newScanner is the scanner TerminalReader/Terminal would use with these settings.
+func newScanner(flags LegacyKeyEncoding, term string, useTerminfo bool) *eventScanner {
+	s := newEventScanner()
+	s.EventDecoder = EventDecoder{Legacy: flags, UseTerminfo: useTerminfo}
+	s.table = buildKeysTable(flags, term, useTerminfo)
+	s.lookup = true
+	return s
+}
+
+// scanOnce scans a whole buffer as one expired read (nothing more is coming).
+func scanOnce(s *eventScanner, buf []byte) []Event {
+	_, evs := s.scanEvents(buf, true)
+	return flatten(evs)
+}
+
+// scanChunked feeds the buffer to the scanner cut at the given offsets, as StreamEvents does
+// with successive reads: unconsumed bytes wait for the next read, and the last remainder is
+// flushed when the escape timeout expires.
+func scanChunked(s *eventScanner, buf []byte, cuts []int) []Event {
+	var events []Event
+	var pending []byte
+	prev := 0
+	for _, c := range append(cuts, len(buf)) {
+		pending = append(pending, buf[prev:c]...)
+		prev = c
+		w, evs := s.scanEvents(pending, false)
+		events = append(events, evs...)
+		pending = pending[w:]
+	}
+	if len(pending) > 0 {
+		_, evs := s.scanEvents(pending, true)
+		events = append(events, evs...)
+	}
+	return flatten(events)
+}
+
+// checkDecode: the sequence decodes to its events, consuming exactly its bytes and leaving them
+// untouched, and every key press prints.
+func checkDecode(ht *hegel.T, e encoded) {
+	var p EventDecoder
+	buf := []byte(e.seq)
+	orig := append([]byte(nil), buf...)
+	w, ev := p.Decode(buf)
+	if !bytes.Equal(buf, orig) {
+		fail(ht, "%s: Decode modified its input: %q -> %q", e.kind, orig, buf)
+	}
+	if w != len(buf) {
+		mismatch(ht, e.shape(), "%s: Decode(%q) consumed %d of %d bytes (event %s)", e.kind, e.seq, w, len(buf), eventString(ev))
+	}
+	got := flatten([]Event{ev})
+	want := flatten(e.want)
+	if !reflect.DeepEqual(got, want) {
+		mismatch(ht, e.shape(), "%s: Decode(%q):\n  got\n    %s\n  want\n    %s", e.kind, e.seq, eventsString(got), eventsString(want))
+	}
+	for _, ev := range got {
+		if k, ok := ev.(KeyPressEvent); ok && k.String() == "" {
+			fail(ht, "%s: %s has an empty String()", e.kind, eventString(k))
+		}
+	}
+	count(e.kind)
+}
+
+// TestHegelSequencesDecodeToTheirEvents: every encoded event decodes to itself, consuming exactly
+// its bytes and leaving them untouched.
+func TestHegelSequencesDecodeToTheirEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkDecode(ht, hegel.Draw(ht, standaloneEvents))
+	})
+}
+
+// TestHegelStreamsSplitIntoTheirEvents: a stream of encoded events, back to back in one read,
+// splits into exactly those events (through Decode and through the scanner).
+func TestHegelStreamsSplitIntoTheirEvents(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, streams)
+		seq, want := s.seq(), s.want()
+		var p EventDecoder
+		got := decodeAll(&p, []byte(seq))
+		if !reflect.DeepEqual(got, want) {
+			mismatch(ht, s.shape(), "stream %q:\n  got\n    %s\n  want\n    %s", seq, eventsString(got), eventsString(want))
+		}
+		if _, inTable := dumbTable[seq]; inTable && len(want) > 1 {
+			// CSI 1;mod R alone: the scanner's whole-read table lookup gives the modified F3
+			// only, the decoder both F3 and the cursor report (the documented ambiguity).
+			count("scanner-f3-skipped")
+		} else {
+			var got []Event
+			naming(ht, scannerShape(s.parts), func() { got = scanOnce(newScanner(0, "dumb", false), []byte(seq)) })
+			if !reflect.DeepEqual(got, want) {
+				mismatch(ht, s.shape(), "scanner on %q:\n  got\n    %s\n  want\n    %s", seq, eventsString(got), eventsString(want))
+			}
+		}
+		count("ok")
+	})
+}
+
+// cutStream is a stream and the read boundaries it is delivered in.
+type cutStream struct {
+	s    stream
+	cuts []int // positions, taken modulo the admitted offsets
+}
+
+func (c cutStream) GoString() string { return fmt.Sprintf("%#v cut at positions %v", c.s, c.cuts) }
+
+var cutStreamCases = hegel.Composite(func(tc hegel.TestCase) cutStream {
+	return cutStream{hegel.Draw(tc, cutStreams), hegel.Draw(tc, many(positions, 1, 3))}
+})
+
+// TestHegelStreamsSurviveArbitraryReads: the same stream cut into several reads at arbitrary
+// byte offsets gives the same events: an incomplete sequence at the end of a read waits for
+// the next one.
+func TestHegelStreamsSurviveArbitraryReads(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cutStreamCases)
+		seq, want := c.s.seq(), c.s.want()
+		offsets, shapeAt := cutPositions(c.s.parts)
+		cuts := cutsAt(c.cuts, offsets)
+		note(ht, "cuts %v", cuts)
+		var got []Event
+		naming(ht, scannerShape(c.s.parts), func() { got = scanChunked(newScanner(0, "dumb", false), []byte(seq), cuts) })
+		if !reflect.DeepEqual(got, want) {
+			names := []string{c.s.shape()}
+			for _, cut := range cuts {
+				names = append(names, shapeAt[cut])
+			}
+			mismatch(ht, shapes(names...), "stream %q cut at %v:\n  got\n    %s\n  want\n    %s", seq, cuts, eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
+
+// keyPair is one key reported through the Kitty protocol and through modifyOtherKeys.
+type keyPair struct {
+	r rune
+	m int
+}
+
+func (p keyPair) kitty() string { return fmt.Sprintf("\x1b[%d;%du", p.r, p.m+1) }
+func (p keyPair) mok() string   { return fmt.Sprintf("\x1b[27;%d;%d~", p.m+1, p.r) }
+
+func (p keyPair) GoString() string { return fmt.Sprintf("%q vs %q", p.kitty(), p.mok()) }
+
+var keyPairs = hegel.Composite(func(tc hegel.TestCase) keyPair {
+	return keyPair{
+		r: hegel.Draw(tc, hegel.SampledFrom([]rune{'a', 'z', 'A', '1', ';', '/', '[', '+', ' ', 'é', 'ø', '世', '☃', '😃'})),
+		m: hegel.Draw(tc, hegel.Integers(0, 7)),
+	}
+})
+
+// TestHegelKittyAndModifyOtherKeysAgree: the same key reported through CSI u and through
+// xterm's CSI 27;mod;code~ is the same event (for shift/alt/ctrl, which both protocols share).
+func TestHegelKittyAndModifyOtherKeysAgree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		pr := hegel.Draw(ht, keyPairs)
+		var p EventDecoder
+		_, ke := p.Decode([]byte(pr.kitty()))
+		_, me := p.Decode([]byte(pr.mok()))
+		kk, ok1 := ke.(KeyPressEvent)
+		mk, ok2 := me.(KeyPressEvent)
+		if !ok1 || !ok2 {
+			fail(ht, "not key presses: %s / %s", eventString(ke), eventString(me))
+		}
+		if kk.Code != mk.Code || kk.Mod != mk.Mod {
+			fail(ht, "code/mod differ: kitty %s, modifyOtherKeys %s", eventString(kk), eventString(mk))
+		}
+		if pr.m&1 == 0 && kk.Text != mk.Text {
+			fail(ht, "text differs: kitty %s, modifyOtherKeys %s", eventString(kk), eventString(mk))
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- the key table
+
+var terminfoTerms = func() []string {
+	var out []string
+	for _, term := range []string{"xterm", "xterm-256color", "screen", "screen-256color", "tmux", "tmux-256color", "linux", "vt100", "vt220", "rxvt", "rxvt-unicode", "rxvt-unicode-256color", "putty", "konsole", "alacritty", "kitty", "foot", "wezterm", "st-256color", "dumb"} {
+		if ti, err := terminfo.Load(term); err == nil && ti != nil {
+			out = append(out, term)
+		}
+	}
+	return out
+}()
+
+var legacyFlags = []LegacyKeyEncoding{flagCtrlAt, flagCtrlI, flagCtrlM, flagCtrlOpenBracket, flagBackspace, flagFind, flagSelect, flagFKeys}
+
+// keyTable is one built key table: the legacy flags, the terminal and whether its terminfo
+// keys are in.
+type keyTable struct {
+	flags       LegacyKeyEncoding
+	term        string
+	useTerminfo bool
+}
+
+// tableEntries holds the built tables and, for each, the entries a case may draw: every entry
+// while the shapes are on; under HEGEL_NO_KNOWN=1 without the terminfo-sourced ones
+// (ultraviolet/12) and without the ESC entries under CtrlOpenBracket (ultraviolet/11).
+var tableEntries = struct {
+	sync.Mutex
+	tables   map[keyTable]map[string]Key
+	terminfo map[keyTable]map[string]Key
+	entries  map[keyTable][]string
+}{tables: map[keyTable]map[string]Key{}, terminfo: map[keyTable]map[string]Key{}, entries: map[keyTable][]string{}}
+
+func (kt keyTable) build() (table, fromTerminfo map[string]Key, entries []string) {
+	tableEntries.Lock()
+	defer tableEntries.Unlock()
+	if _, ok := tableEntries.tables[kt]; !ok {
+		table := buildKeysTable(kt.flags, kt.term, kt.useTerminfo)
+		fromTerminfo := map[string]Key{}
+		if kt.useTerminfo {
+			fromTerminfo = buildTerminfoKeys(kt.flags, kt.term)
+		}
+		var entries []string
+		for seq := range table {
+			_, ti := fromTerminfo[seq]
+			if noKnown && (ti || (kt.flags&flagCtrlOpenBracket != 0 && strings.Trim(seq, "\x1b") == "")) {
+				continue
+			}
+			entries = append(entries, seq)
+		}
+		sort.Strings(entries)
+		tableEntries.tables[kt], tableEntries.terminfo[kt], tableEntries.entries[kt] = table, fromTerminfo, entries
+	}
+	return tableEntries.tables[kt], tableEntries.terminfo[kt], tableEntries.entries[kt]
+}
+
+// terminfoEntries lists the table's entries that come from terminfo (the region of
+// ultraviolet/12), sorted.
+func (kt keyTable) terminfoEntries() []string {
+	table, fromTerminfo, _ := kt.build()
+	var out []string
+	for seq := range fromTerminfo {
+		if _, ok := table[seq]; ok {
+			out = append(out, seq)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// tableCase is one entry of a key table.
+type tableCase struct {
+	kt  keyTable
+	seq string
+	key Key
+}
+
+// shape names the recorded bug the entry's shape belongs to: a terminfo-sourced entry the
+// decoder reads its own way (ultraviolet/12), or ctrl+[ for ESC under CtrlOpenBracket, which
+// nothing reaches (ultraviolet/11).
+func (c tableCase) shape() string {
+	_, fromTerminfo, _ := c.kt.build()
+	if c.kt.flags&flagCtrlOpenBracket != 0 && strings.Trim(c.seq, "\x1b") == "" {
+		return "ultraviolet/11"
+	}
+	if _, ti := fromTerminfo[c.seq]; ti {
+		return "ultraviolet/12"
+	}
+	return ""
+}
+
+func (c tableCase) GoString() string {
+	return fmt.Sprintf("term %s flags %#b terminfo %v seq %q table %s", c.kt.term, c.kt.flags, c.kt.useTerminfo, c.seq, eventString(KeyPressEvent(c.key)))
+}
+
+var (
+	// legacyEncodings: any set of the eight legacy flags.
+	legacyEncodings = hegel.Map(hegel.Integers(0, 255), func(bits int) LegacyKeyEncoding {
+		var flags LegacyKeyEncoding
+		for i, f := range legacyFlags {
+			if bits&(1<<i) != 0 {
+				flags |= f
+			}
+		}
+		return flags
+	})
+	keyTables = hegel.Composite(func(tc hegel.TestCase) keyTable {
+		return keyTable{
+			flags:       hegel.Draw(tc, legacyEncodings),
+			term:        hegel.Draw(tc, hegel.SampledFrom(terminfoTerms)),
+			useTerminfo: hegel.Draw(tc, chance(70)),
+		}
+	})
+	// tableCases: a table and one of its entries.
+	tableCases = hegel.FlatMap(keyTables, func(kt keyTable) hegel.Generator[tableCase] {
+		table, _, entries := kt.build()
+		return hegel.Map(hegel.SampledFrom(entries), func(seq string) tableCase { return tableCase{kt, seq, table[seq]} })
+	})
+)
+
+// TestHegelKeyTableAgreesWithTheDecoder: the scanner looks a whole read up in buildKeysTable
+// and otherwise runs the decoder over it; the two must agree, or the same bytes mean different
+// keys depending on how they arrive: an entry alone in a read (the table, when the read is
+// longer than two bytes; the decoder otherwise) and the entry followed by a typed x (the
+// decoder) must both give the table's key.
+func TestHegelKeyTableAgreesWithTheDecoder(t *testing.T) {
+	if len(terminfoTerms) == 0 {
+		t.Skip("no terminfo database")
+	}
+	property(t, func(ht *hegel.T) {
+		checkTableEntry(ht, hegel.Draw(ht, tableCases))
+	})
+}
+
+// checkTableEntry: the entry alone in a read and followed by a typed x both give the table's
+// key through the scanner.
+func checkTableEntry(ht *hegel.T, c tableCase) {
+	want := []Event{KeyPressEvent(c.key)}
+	s := newScanner(c.kt.flags, c.kt.term, c.kt.useTerminfo)
+	if got := scanOnce(s, []byte(c.seq)); !reflect.DeepEqual(got, want) {
+		mismatch(ht, c.shape(), "%q alone is %s in the table but the scanner gives\n    %s", c.seq, eventString(KeyPressEvent(c.key)), eventsString(got))
+	}
+	if strings.HasPrefix(c.seq, "\x1b[1;") && strings.HasSuffix(c.seq, "R") {
+		// CSI 1;mod R with company runs through the decoder, which reports the cursor
+		// position too (the documented ambiguity).
+		want = append(want, CursorPositionEvent{Y: 0, X: int(c.key.Mod)})
+	}
+	if strings.Trim(c.seq, "\x1b") == "" || strings.HasSuffix(c.seq, "$") {
+		// ESC followed by x is alt+x, and URxvt's CSI n $ followed by x is one control
+		// sequence ($ is an intermediate byte): nothing can follow these entries in a read.
+		count("entry-alone-only")
+		return
+	}
+	x := keyPress('x', "x", 0)
+	if got := scanOnce(s, []byte(c.seq+"x")); !reflect.DeepEqual(got, append(want, x)) {
+		mismatch(ht, c.shape(), "%q is %s in the table but followed by x the scanner gives\n    %s", c.seq, eventString(KeyPressEvent(c.key)), eventsString(got))
+	}
+	count("ok")
+}
+
+// ---------------------------------------------------------------- bracketed paste
+
+// pastePieces: what a pasted text is made of: letters, blanks, controls, clusters, a key
+// sequence and the bytes of the paste markers. Under HEGEL_NO_KNOWN=1 the pieces that can form
+// an escape sequence with what follows ([) are left out, since the scanner drops unrecognised
+// sequences from a paste (ultraviolet/18), and so is the key sequence when the paste is cut
+// into reads, one of which could be exactly the key (ultraviolet/19).
+var (
+	pastePiecePool = shaped(
+		[]string{"a", "Z", " ", "\n", "\t", "\x03", "é", "世", "😃", "\x1b[A", "\x1b", "[", "2", "0", "1", "~", "+"},
+		[]string{"a", "Z", " ", "\n", "\t", "\x03", "é", "世", "😃", "\x1b[A", "\x1b", "2", "0", "1", "~", "+"},
+	)
+	cutPastePiecePool = shaped(pastePiecePool, slices.DeleteFunc(slices.Clone(pastePiecePool), func(s string) bool { return s == "\x1b[A" }))
+	// pasteAfters: what follows the paste: nothing, a typed o, or a blur report.
+	pasteAfters = hegel.SampledFrom([]encoded{{"none", "", nil}, {"text", "o", []Event{keyPress('o', "o", 0)}}, {"blur", "\x1b[O", []Event{BlurEvent{}}}})
+)
+
+// pasteCase is a bracketed paste between two events, delivered in one read or cut into
+// several.
+type pasteCase struct {
+	pieces  []string
+	chunked bool
+	before  encoded
+	after   encoded
+	cuts    []int // positions, taken modulo the admitted offsets
+}
+
+// text is the pasted text; under HEGEL_NO_KNOWN=1 a cut paste does not end in ESC (ESC ESC [
+// at a read boundary is alt+[, ultraviolet/17).
+func (c pasteCase) text() string {
+	text := strings.Join(c.pieces, "")
+	if noKnown && c.chunked {
+		text = strings.TrimRight(text, "\x1b")
+	}
+	return text
+}
+
+func (c pasteCase) input() string {
+	return c.before.seq + "\x1b[200~" + c.text() + "\x1b[201~" + c.after.seq
+}
+
+// wantEvents: the event before, the paste as it was, the event after.
+func (c pasteCase) wantEvents() []Event {
+	want := flatten(c.before.want)
+	want = append(want, PasteStartEvent{}, PasteEvent{Content: c.text()}, PasteEndEvent{})
+	return append(want, flatten(c.after.want)...)
+}
+
+// textShape names the recorded bugs the pasted text has the shape of, given the read
+// boundaries: a sequence the decoder does not read as a key, which the scanner drops from the
+// paste (ultraviolet/18); when the paste is cut into reads, a key sequence a read could be
+// exactly (ultraviolet/19), and a read ending right after ESC ESC [ where the text's final
+// ESC meets the end marker (ultraviolet/17). The decoder itself tells which sequences it
+// keeps, since that is what the scanner consults, run over the text with the marker behind it
+// as the scanner sees it.
+func (c pasteCase) textShape(cuts []int) string {
+	text := c.text()
+	var names []string
+	var p EventDecoder
+	buf := []byte(text + "\x1b[201~")
+	for off := 0; off < len(text); {
+		w, ev := p.Decode(buf[off:])
+		if w == 0 {
+			w = 1
+		}
+		if _, key := ev.(KeyPressEvent); !key || off+w > len(text) {
+			names = append(names, "ultraviolet/18")
+		}
+		if c.chunked && w > 2 {
+			if _, inTable := dumbTable[string(buf[off:off+w])]; inTable {
+				names = append(names, "ultraviolet/19")
+			}
+		}
+		off += w
+	}
+	if c.chunked && strings.HasSuffix(text, "\x1b") && slices.Contains(cuts, len(c.before.seq)+6+len(text)+2) {
+		names = append(names, "ultraviolet/17")
+	}
+	return shapes(names...)
+}
+
+func (c pasteCase) GoString() string {
+	return fmt.Sprintf("paste %q between %#v and %#v, chunked %v at positions %v", c.text(), c.before, c.after, c.chunked, c.cuts)
+}
+
+// pasteCases: the terminal guarantees that a paste holds no end marker, so texts that spell one
+// are filtered out (they are rare).
+var pasteCases = hegel.Filter(hegel.Composite(func(tc hegel.TestCase) pasteCase {
+	chunked := hegel.Draw(tc, chance(50))
+	pool := pastePiecePool
+	if chunked {
+		pool = cutPastePiecePool
+	}
+	before := hegel.Draw(tc, streamEvents(false))
+	if chunked {
+		before = unambiguousInReads(before)
+	}
+	return pasteCase{
+		pieces:  hegel.Draw(tc, many(hegel.SampledFrom(pool), 0, 40)),
+		chunked: chunked,
+		before:  before,
+		after:   hegel.Draw(tc, pasteAfters),
+		cuts:    hegel.Draw(tc, many(positions, 1, 4)),
+	}
+}), func(c pasteCase) bool {
+	ok := !strings.Contains(c.text(), "\x1b[201~")
+	if !ok {
+		count("end-marker-in-text-filtered")
+	}
+	return ok
+})
+
+// TestHegelPastesRoundTrip: bracketed paste through the scanner, in one read or cut into
+// several, yields the pasted text between the surrounding events.
+func TestHegelPastesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pasteCases)
+		input, want := c.input(), c.wantEvents()
+		var got []Event
+		var cuts []int
+		names := []string{c.before.shape()}
+		if !c.chunked {
+			naming(ht, scannerShape([]encoded{c.before}), func() { got = scanOnce(newScanner(0, "dumb", false), []byte(input)) })
+		} else {
+			// The read boundaries may fall anywhere in the input but for the protocol's own
+			// ambiguities inside the event before (cutPositions); inside the paste every
+			// offset is admitted.
+			offsets, shapeAt := cutPositions([]encoded{c.before})
+			for i := max(len(c.before.seq), 1); i < len(input); i++ {
+				offsets = append(offsets, i)
+			}
+			cuts = cutsAt(c.cuts, offsets)
+			note(ht, "cuts %v", cuts)
+			for _, cut := range cuts {
+				names = append(names, shapeAt[cut])
+			}
+			naming(ht, scannerShape([]encoded{c.before}), func() { got = scanChunked(newScanner(0, "dumb", false), []byte(input), cuts) })
+		}
+		if !reflect.DeepEqual(got, want) {
+			mismatch(ht, shapes(append(names, c.textShape(cuts))...), "scanner on %q:\n  got\n    %s\n  want\n    %s", input, eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- graphemes and keystrokes
+
+// checkCluster: the cluster is one key press with its text.
+func checkCluster(ht *hegel.T, e encoded) {
+	c := e.seq
+	var p EventDecoder
+	w, ev := p.Decode([]byte(c))
+	if w != len(c) {
+		mismatch(ht, e.shape(), "%q: consumed %d of %d bytes (%s)", c, w, len(c), eventString(ev))
+	}
+	k, ok := ev.(KeyPressEvent)
+	if !ok || k.Text != c || k.Code != KeyExtended {
+		mismatch(ht, e.shape(), "%q: %s", c, eventString(ev))
+	}
+	if g, _, _, _ := uniseg.FirstGraphemeClusterInString(c, -1); g != c {
+		fail(ht, "generator: %q is not one cluster", c)
+	}
+	count("ok")
+}
+
+// TestHegelGraphemesAreOneKey: a grapheme cluster is one key press with its text, whatever
+// its first byte.
+func TestHegelGraphemesAreOneKey(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkCluster(ht, hegel.Draw(ht, clusterKeys))
+	})
+}
+
+func isModifierKey(code rune) bool {
+	return code >= KeyLeftShift && code <= KeyIsoLevel5Shift
+}
+
+func isKeypadKey(code rune) bool {
+	return code >= KeyKpEnter && code <= KeyKpBegin
+}
+
+func isLockKey(code rune) bool {
+	return code == KeyCapsLock || code == KeyNumLock || code == KeyScrollLock
+}
+
+// keystrokeShape names the recorded bug a key's Keystroke()/MatchString disagreement has the
+// shape of, "" for none.
+func keystrokeShape(k Key) string {
+	str := k.Keystroke()
+	switch {
+	case isModifierKey(k.Code):
+		return "ultraviolet/7" // Keystroke omits the key's own modifier
+	case isKeypadKey(k.Code):
+		return "ultraviolet/14" // Keystroke prints the main key's name, MatchString wants "kp..."
+	case isLockKey(k.Code):
+		return "ultraviolet/15" // MatchString reads "capslock" as the modifier
+	case k.BaseCode != 0 && k.BaseCode != k.Code:
+		return "ultraviolet/4" // Keystroke prints the base key, MatchString ignores it
+	case k.Mod&(ModCapsLock|ModNumLock|ModScrollLock) != 0:
+		return "ultraviolet/6" // MatchString wants the exact modifier set
+	case strings.Contains(str, "++") || strings.HasSuffix(str, "+") || strings.Contains(k.Text, "+"):
+		return "ultraviolet/5" // MatchString splits on '+'
+	}
+	return ""
+}
+
+// TestHegelKeystrokesMatchTheirKeys: a decoded key matches its own Keystroke() and String()
+// through MatchString, otherwise a binding written from what the program prints cannot fire.
+// Under HEGEL_NO_KNOWN=1 a key with a recorded shape is counted and not checked.
+func TestHegelKeystrokesMatchTheirKeys(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkKeystrokes(ht, hegel.Draw(ht, keystrokeEvents))
+	})
+}
+
+// checkKeystrokes: every key the sequence decodes to matches its own Keystroke() and String().
+func checkKeystrokes(ht *hegel.T, e encoded) {
+	var p EventDecoder
+	got := decodeAll(&p, []byte(e.seq))
+	for _, ev := range got {
+		var k Key
+		switch x := ev.(type) {
+		case KeyPressEvent:
+			k = Key(x)
+		case KeyReleaseEvent:
+			k = Key(x)
+		default:
+			continue
+		}
+		shape := shapes(keystrokeShape(k), e.shape())
+		if known(shape) {
+			continue
+		}
+		ks, str := k.String(), k.Keystroke()
+		if !k.MatchString(str) {
+			mismatch(ht, shape, "%s %q: %s does not MatchString its Keystroke %q", e.kind, e.seq, eventString(ev), str)
+		}
+		if !k.MatchString(ks) {
+			mismatch(ht, shape, "%s %q: %s does not MatchString its String %q", e.kind, e.seq, eventString(ev), ks)
+		}
+	}
+	count("ok")
+}
+
+// ---------------------------------------------------------------- pins
+
+// ultraviolet/1: with "report alternate keys", the base-layout key (third sub-parameter) is
+// stored and then falls through into the shifted-key case, overwriting ShiftedCode with the
+// base key; the text derived for shift is then the base key (same as x-input/1).
+func TestHegelPinKittyBaseKeyOverwritesShiftedKey(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte("\x1b[97:65:113;2u")) // shift+a on AZERTY: a, shifted A, base q
+	k, _ := ev.(KeyPressEvent)
+	if k.ShiftedCode != 'A' || k.Text != "A" || k.BaseCode != 'q' {
+		t.Errorf("CSI 97:65:113;2u = %s; want shifted 'A', base 'q', text \"A\"", eventString(ev))
+	}
+}
+
+// ultraviolet/2: TerminalReader.Legacy and TerminalReader.UseTerminfo, documented as the way to
+// configure the reader, have no effect: NewTerminalReader copies the zero EventDecoder into
+// the scanner and builds the key table before the fields can be set.
+func TestHegelPinTerminalReaderOptionsAreIgnored(t *testing.T) {
+	defer guard(t)
+	pr, pw := io.Pipe()
+	rd := NewTerminalReader(pr, "xterm")
+	rd.Legacy = LegacyKeyEncoding(0).CtrlI(true).CtrlM(true).Backspace(true)
+	rd.EscTimeout = 20 * time.Millisecond
+	evc := make(chan Event, 16)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		_ = rd.StreamEvents(ctx, evc)
+		close(done)
+	}()
+	_, _ = pw.Write([]byte("\t\r\x7f"))
+	time.Sleep(100 * time.Millisecond)
+	cancel()
+	_ = pw.Close()
+	<-done
+	close(evc)
+	var got []Event
+	for ev := range evc {
+		got = append(got, ev)
+	}
+	want := []Event{KeyPressEvent{Code: 'i', Mod: ModCtrl}, KeyPressEvent{Code: 'm', Mod: ModCtrl}, KeyPressEvent{Code: KeyDelete}}
+	if !reflect.DeepEqual(flatten(got), want) {
+		t.Errorf("TerminalReader with Legacy CtrlI|CtrlM|Backspace read \\t \\r DEL as\n    %s\n  want\n    %s", eventsString(flatten(got)), eventsString(want))
+	}
+}
+
+// ultraviolet/3: an X10 mouse report cut before its three payload bytes is returned as an
+// UnknownCsiEvent (not an UnknownEvent), so the scanner does not wait for the rest of the
+// read: the report is lost and its payload arrives as key presses.
+func TestHegelPinX10MouseSplitAcrossReadsIsLost(t *testing.T) {
+	defer guard(t)
+	seq := "\x1b[M" + string([]byte{32, 33 + 10, 33 + 20})
+	got := scanChunked(newScanner(0, "dumb", false), []byte(seq), []int{3})
+	want := []Event{MouseClickEvent{X: 10, Y: 20, Button: MouseLeft}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("X10 report %q read as %q + %q gives\n    %s\n  want\n    %s", seq, seq[:3], seq[3:], eventsString(got), eventsString(want))
+	}
+}
+
+// ultraviolet/4: Keystroke() prints the base-layout key when the Kitty protocol reports one,
+// but MatchString compares Code only, so a key never matches its own keystroke on a non-US
+// layout.
+func TestHegelPinMatchStringIgnoresTheBaseKey(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte("\x1b[97:65:113;5u")) // ctrl + the 'a' key of an AZERTY keyboard (PC-101 'q')
+	k := ev.(KeyPressEvent)
+	if !k.MatchString(k.Keystroke()) {
+		t.Errorf("%s: Keystroke() is %q but MatchString(%q) is false", eventString(ev), k.Keystroke(), k.Keystroke())
+	}
+}
+
+// ultraviolet/5: MatchString splits its argument on '+', so the '+' key (and ctrl++, kp+)
+// cannot be matched by string, though Keystroke() prints "+" and "ctrl++".
+func TestHegelPinPlusKeyCannotBeMatched(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	for _, seq := range []string{"+", "\x1b[43;5u", "\x1b[27;3;43~"} {
+		_, ev := p.Decode([]byte(seq))
+		k := ev.(KeyPressEvent)
+		if !k.MatchString(k.Keystroke()) {
+			t.Errorf("%q: %s Keystroke() %q, MatchString(%q) false", seq, eventString(ev), k.Keystroke(), k.Keystroke())
+		}
+	}
+}
+
+// ultraviolet/6: MatchString requires the exact modifier set, and lock modifiers are part of
+// it, so with caps lock or num lock on (which the Kitty protocol reports for non-text keys)
+// no "ctrl+a"-style binding fires; Keystroke() does not print lock modifiers either.
+func TestHegelPinLockModifiersBreakBindings(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte("\x1b[97;69u")) // ctrl+a with caps lock on (4+64+1)
+	k := ev.(KeyPressEvent)
+	if k.Keystroke() != "ctrl+a" || !k.MatchString("ctrl+a") {
+		t.Errorf("%s: Keystroke() %q, MatchString(\"ctrl+a\") %v; want a match", eventString(ev), k.Keystroke(), k.MatchString("ctrl+a"))
+	}
+	_, ev = p.Decode([]byte("\x1b[57352;129u")) // up arrow with num lock on
+	k = ev.(KeyPressEvent)
+	if !k.MatchString("up") {
+		t.Errorf("%s: Keystroke() %q, MatchString(\"up\") false", eventString(ev), k.Keystroke())
+	}
+}
+
+// ultraviolet/7: Keystroke() omits a modifier key's own modifier ("leftshift" for shift held
+// on the left shift key), so MatchString(Keystroke()) is false for modifier key events.
+func TestHegelPinModifierKeysDoNotMatchTheirKeystroke(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte("\x1b[57441;2u")) // left shift, shift bit set (as kitty reports its release)
+	k := ev.(KeyPressEvent)
+	if !k.MatchString(k.Keystroke()) {
+		t.Errorf("%s: Keystroke() %q, MatchString(%q) false", eventString(ev), k.Keystroke(), k.Keystroke())
+	}
+}
+
+// ultraviolet/8: an invalid UTF-8 byte is reported as UnknownEvent(string(rune(b))), i.e. the
+// UTF-8 encoding of U+00FE for the byte 0xfe, not the byte itself (same as x-input/5).
+func TestHegelPinUnknownEventEncodesTheByteAsARune(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte{0xfe})
+	if u, _ := ev.(UnknownEvent); string(u) != "\xfe" {
+		t.Errorf("Decode(0xfe) = %q; want the byte \"\\xfe\"", string(u))
+	}
+}
+
+// ultraviolet/9: the ASCII shortcut in parseUtf8 returns one byte before grapheme clustering,
+// so a cluster that starts with an ASCII byte (e + combining acute, keycap emoji) is split
+// into separate key presses, unlike clusters that start with a non-ASCII rune (x-input/6).
+func TestHegelPinASCIILedGraphemeClustersSplit(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	for _, c := range asciiClusters[:3] {
+		w, ev := p.Decode([]byte(c))
+		if w != len(c) {
+			t.Errorf("Decode(%q) consumed %d of %d bytes: %s", c, w, len(c), eventString(ev))
+		}
+	}
+}
+
+// ultraviolet/10: a CSI sequence with more than 32 parameters stops scanning at the 32nd; the
+// rest of the sequence is not consumed and its bytes come back as key presses (x-input/8).
+func TestHegelPinCSIWithManyParametersLeaksItsTail(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	seq := "\x1b[" + strings.Repeat("1;", 33) + "1A"
+	w, ev := p.Decode([]byte(seq))
+	if w != len(seq) {
+		t.Errorf("Decode consumed %d of %d bytes (%s); the tail %q becomes key presses", w, len(seq), eventString(ev), seq[w:])
+	}
+}
+
+// ultraviolet/35: the scanner (TerminalReader's read loop) runs every read through x/ansi's
+// DecodeSequence, whose parser holds 32 parameters and indexes the 33rd: a CSI with 33 or more
+// parameters panics the reader, while EventDecoder.Decode on the same bytes returns.
+func TestHegelPinScannerPanicsOnCSIWithManyParameters(t *testing.T) {
+	defer guard(t)
+	seq := "\x1b[" + strings.Repeat("1;", 33) + "1z"
+	got := scanOnce(newScanner(0, "xterm", false), []byte(seq))
+	if want := []Event{UnknownCsiEvent(seq)}; !reflect.DeepEqual(got, want) {
+		t.Errorf("scanner on a CSI with 34 parameters = %s; want %s", eventsString(got), eventsString(want))
+	}
+}
+
+// ultraviolet/11: LegacyKeyEncoding.CtrlOpenBracket(true) never produces ctrl+[: Decode
+// returns the escape key for a lone ESC before parseControl runs, and the scanner consults
+// the key table (which does say ctrl+[) only for reads longer than two bytes.
+func TestHegelPinCtrlOpenBracketNeverFires(t *testing.T) {
+	defer guard(t)
+	flags := LegacyKeyEncoding(0).CtrlOpenBracket(true)
+	want := KeyPressEvent{Code: '[', Mod: ModCtrl}
+	p := EventDecoder{Legacy: flags}
+	_, ev := p.Decode([]byte("\x1b"))
+	if !reflect.DeepEqual(ev, want) {
+		t.Errorf("Decode(ESC) with CtrlOpenBracket = %s; want %s (what buildKeysTable says)", eventString(ev), eventString(want))
+	}
+	got := scanOnce(newScanner(flags, "xterm", false), []byte("\x1b"))
+	if !reflect.DeepEqual(got, []Event{want}) {
+		t.Errorf("scanner on ESC with CtrlOpenBracket = %s; want %s", eventsString(got), eventString(want))
+	}
+}
+
+// ultraviolet/12: with UseTerminfo the key table holds the terminal's terminfo keys, but the
+// scanner consults the table only for a whole read (or an UnknownEvent); a terminfo sequence
+// the decoder also recognises is decoded by the decoder when it arrives with other bytes
+// (x-input/10). tmux's kf48 with FKeys: table f48, decoder ctrl+shift+f12.
+func TestHegelPinTerminfoKeysOnlyHonouredAlone(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		term  string
+		flags LegacyKeyEncoding
+		seq   string
+	}{
+		{"tmux", LegacyKeyEncoding(0).FKeys(true), "\x1b[24;6~"},
+		{"screen", LegacyKeyEncoding(0).FKeys(true), "\x1b[24;6~"},
+		{"xterm", LegacyKeyEncoding(0).FKeys(true), "\x1b[24;6~"},
+	}
+	for _, c := range cases {
+		if ti, err := terminfo.Load(c.term); err != nil || ti == nil {
+			t.Errorf("terminfo entry for %s not available: cannot reproduce here", c.term)
+			continue
+		}
+		table := buildKeysTable(c.flags, c.term, true)
+		key, ok := table[c.seq]
+		if !ok {
+			t.Errorf("%s: %q not in the table", c.term, c.seq)
+			continue
+		}
+		s := newScanner(c.flags, c.term, true)
+		alone := scanOnce(s, []byte(c.seq))
+		together := scanOnce(s, []byte(c.seq+"x"))
+		if len(together) != 2 || !reflect.DeepEqual(alone[0], together[0]) {
+			t.Errorf("%s: %q is %s alone but %s followed by x (table %s)", c.term, c.seq, eventsString(alone), eventsString(together), eventString(KeyPressEvent(key)))
+		}
+	}
+}
+
+// ultraviolet/13: alt+O, alt+P and alt+X (ESC followed by an introducer byte) take shortcuts
+// without ShiftedCode, unlike every other alt+uppercase letter (x-input/7 remainder).
+func TestHegelPinAltIntroducerKeysLackShiftedCode(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, want := p.Decode([]byte("\x1bQ"))
+	wk := want.(KeyPressEvent)
+	for _, c := range "OPX" {
+		_, ev := p.Decode([]byte("\x1b" + string(c)))
+		w := wk
+		w.Code, w.ShiftedCode = unicode.ToLower(c), c
+		if !reflect.DeepEqual(ev, w) {
+			t.Errorf("ESC %c = %s; want %s (the shape ESC Q has)", c, eventString(ev), eventString(w))
+		}
+	}
+}
+
+// ultraviolet/14: Keystroke() prints keypad keys under the main keys' names ("enter", "1",
+// "period", "begin"), but MatchString only knows them as "kpenter", "kp1", "kpperiod"…, so a
+// keypad key never matches its own keystroke, and "enter" does not match kp enter either.
+func TestHegelPinKeypadKeysDoNotMatchTheirKeystroke(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	for _, seq := range []string{"\x1bOM", "\x1bOq", "\x1bOn", "\x1b[57427u", "\x1b[57414;5u"} {
+		_, ev := p.Decode([]byte(seq))
+		k := ev.(KeyPressEvent)
+		if !k.MatchString(k.Keystroke()) {
+			t.Errorf("%q: %s Keystroke() %q, MatchString(%q) false", seq, eventString(ev), k.Keystroke(), k.Keystroke())
+		}
+	}
+}
+
+// ultraviolet/15: the caps lock, num lock and scroll lock keys print as "capslock", "numlock",
+// "scrolllock", the same words MatchString reads as modifiers, so a lock key never matches its
+// own keystroke and "capslock" alone matches nothing.
+func TestHegelPinLockKeysParsedAsModifiers(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	for _, seq := range []string{"\x1b[57358u", "\x1b[57360u", "\x1b[57358;5u"} {
+		_, ev := p.Decode([]byte(seq))
+		k := ev.(KeyPressEvent)
+		if !k.MatchString(k.Keystroke()) {
+			t.Errorf("%q: %s Keystroke() %q, MatchString(%q) false", seq, eventString(ev), k.Keystroke(), k.Keystroke())
+		}
+	}
+}
+
+// ultraviolet/16: a string terminator (ESC \) cut between its two bytes by a read boundary is
+// taken for a lone ESC ending the string: an OSC reply is dropped as cancelled, a DCS reply is
+// emitted early, and the backslash of the next read is typed as text.
+func TestHegelPinStringTerminatorSplitAcrossReads(t *testing.T) {
+	defer guard(t)
+	cases := []struct {
+		seq  string
+		want []Event
+	}{
+		{"\x1b]11;rgb:1a/2b/3c\x1b\\", []Event{BackgroundColorEvent{color.RGBA{0x1a, 0x2b, 0x3c, 0xff}}}},
+		{"\x1bP>|kitty(0.36.4)\x1b\\", []Event{TerminalVersionEvent{Name: "kitty(0.36.4)"}}},
+		{"\x1b]52;c;aGVsbG8=\x1b\\", []Event{ClipboardEvent{Content: "hello", Selection: 'c'}}},
+	}
+	for _, c := range cases {
+		got := scanChunked(newScanner(0, "dumb", false), []byte(c.seq), []int{len(c.seq) - 1})
+		if !reflect.DeepEqual(got, c.want) {
+			t.Errorf("%q read as %q + %q gives\n    %s\n  want\n    %s", c.seq, c.seq[:len(c.seq)-1], c.seq[len(c.seq)-1:], eventsString(got), eventsString(c.want))
+		}
+	}
+}
+
+// ultraviolet/17: ESC ESC [ at the end of a read is decoded as alt+[ (three bytes, so the
+// scanner's "wait for more" rule for one- and two-byte ESC keys does not apply), although it
+// may be the start of an alt-modified CSI key or of the paste-end marker after a pasted ESC.
+func TestHegelPinEscEscBracketAtAReadBoundary(t *testing.T) {
+	defer guard(t)
+	got := scanChunked(newScanner(0, "dumb", false), []byte("\x1b\x1b[A"), []int{3})
+	want := []Event{KeyPressEvent{Code: KeyUp, Mod: ModAlt}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("ESC ESC [ A read as %q + %q gives\n    %s\n  want\n    %s", "\x1b\x1b[", "A", eventsString(got), eventsString(want))
+	}
+	in := "\x1b[200~x\x1b\x1b[201~y"
+	got = scanChunked(newScanner(0, "dumb", false), []byte(in), []int{10})
+	want = []Event{PasteStartEvent{}, PasteEvent{Content: "x\x1b"}, PasteEndEvent{}, keyPress('y', "y", 0)}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("paste %q read as %q + %q gives\n    %s\n  want\n    %s", in, in[:9], in[9:], eventsString(got), eventsString(want))
+	}
+}
+
+// ultraviolet/18: inside a bracketed paste, escape sequences the decoder recognises as keys
+// are kept verbatim while every other sequence is dropped, and an ESC [ before a non-ASCII
+// byte loses those two bytes.
+func TestHegelPinPasteDropsUnrecognisedSequences(t *testing.T) {
+	defer guard(t)
+	for _, text := range []string{"a\x1b[31mb", "a\x1b[<0;1;1Mb", "a\x1b[éb", "a\x1b[Ab"} {
+		got := scanOnce(newScanner(0, "dumb", false), []byte("\x1b[200~"+text+"\x1b[201~"))
+		want := []Event{PasteStartEvent{}, PasteEvent{Content: text}, PasteEndEvent{}}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("paste of %q gives\n    %s\n  want\n    %s", text, eventsString(got), eventsString(want))
+		}
+	}
+}
+
+// ultraviolet/19: the whole-read key-table lookup runs before the bracketed-paste check, so a
+// read that is exactly a known key sequence while a paste is open is reported as a key press
+// and removed from the pasted text.
+func TestHegelPinTableLookupIgnoresAnOpenPaste(t *testing.T) {
+	defer guard(t)
+	in := "\x1b[200~ab\x1b[A\x1b[201~"
+	got := scanChunked(newScanner(0, "dumb", false), []byte(in), []int{8, 11})
+	want := []Event{PasteStartEvent{}, PasteEvent{Content: "ab\x1b[A"}, PasteEndEvent{}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("paste %q read as %q + %q + %q gives\n    %s\n  want\n    %s", in, in[:8], in[8:11], in[11:], eventsString(got), eventsString(want))
+	}
+}
+
+// TestHegelExamples: fixed examples from the protocols.
+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	cases := []struct {
+		seq  string
+		want Event
+	}{
+		{"\x1b[97;5u", KeyPressEvent{Code: 'a', Mod: ModCtrl}},
+		{"\x1b[97:65;2u", KeyPressEvent{Code: 'a', ShiftedCode: 'A', Text: "A", Mod: ModShift}},
+		{"\x1b[1;5:3D", KeyReleaseEvent{Code: KeyLeft, Mod: ModCtrl}},
+		{"\x1b[5;1:3~", KeyReleaseEvent{Code: KeyPgUp}},
+		{"\x1b[97;129u", KeyPressEvent{Code: 'a', Text: "a", Mod: ModNumLock}},
+		{"\x1b[<64;10;20M", MouseWheelEvent{X: 9, Y: 19, Button: MouseWheelUp}},
+		{"\x1b[<3;10;20m", MouseReleaseEvent{X: 9, Y: 19}},
+		{"\x1b[?2026;2$y", ModeReportEvent{Mode: ansi.DECMode(2026), Value: 2}},
+		{"\x1b]52;c;aGVsbG8=\x1b\\", ClipboardEvent{Content: "hello", Selection: 'c'}},
+		{"\x1bP1+r5463=31\x1b\\", CapabilityEvent{Content: "Tc=1"}},
+		{"\x1bOP", KeyPressEvent{Code: KeyF1}},
+		{"\x1b[15;2~", KeyPressEvent{Code: KeyF5, Mod: ModShift}},
+		{"\x1b[", KeyPressEvent{Code: '[', Mod: ModAlt}},
+		{"\x1b[?997;2n", LightColorSchemeEvent{}},
+		{"\x1b[8;24;80t", WindowSizeEvent{Width: 80, Height: 24}},
+	}
+	for _, c := range cases {
+		w, ev := p.Decode([]byte(c.seq))
+		if w != len(c.seq) || !reflect.DeepEqual(normalize(ev), c.want) {
+			t.Errorf("Decode(%q) = %d, %s; want %d, %s", c.seq, w, eventString(ev), len(c.seq), eventString(c.want))
+		}
+	}
+	buf := []byte("\x1b[2$")
+	p.Decode(buf)
+	if string(buf) != "\x1b[2$" {
+		t.Errorf("Decode changed its input to %q", buf)
+	}
+}
diff --git a/layout/hegel_shapes_test.go b/layout/hegel_shapes_test.go
new file mode 100644
index 0000000..49f1725
--- /dev/null
+++ b/layout/hegel_shapes_test.go
@@ -0,0 +1,75 @@
+package layout_test
+
+// Narrow property for the recorded layout bug (ultraviolet/26): it draws the bug's shape
+// directly and fails by default; under HEGEL_NO_KNOWN=1 it draws the region past the shape
+// and passes.
+
+import (
+	"fmt"
+	"testing"
+
+	uv "github.com/charmbracelet/ultraviolet"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- ultraviolet/26
+
+// flankedLayouts: a SpaceAround layout of a Percent, Ratio, Min or Max between two Lens
+// (the pin's family; the spacers around the segments take the tie).
+var flankedLayouts = hegel.Composite(func(tc hegel.TestCase) lspec {
+	lens := hegel.Integers(1, 60)
+	return lspec{
+		horizontal: hegel.Draw(tc, chance(50)),
+		area:       hegel.Draw(tc, areas),
+		pad:        hegel.Draw(tc, maybe(30, paddings)),
+		spacing:    hegel.Draw(tc, spacings),
+		flex:       len(flexes) - 1, // around
+		cs: []cspec{
+			{"len", hegel.Draw(tc, lens), 0},
+			hegel.Draw(tc, hegel.OneOf(percents, ratios, cellsOf("min"), cellsOf("max"))),
+			{"len", hegel.Draw(tc, lens), 0},
+		},
+	}
+})
+
+// tiedLayouts: a flanked layout whose constraints ask for more than the area holds, so that
+// several splits are equally good (the region of ultraviolet/26); under HEGEL_NO_KNOWN=1 a
+// layout that fits its area.
+var tiedLayouts = shaped(hegel.Filter(flankedLayouts, overConstrained), fittingLayouts)
+
+// keyed is the layout under a distinct cache key: padded by k on the leading side over an
+// area grown by k, so that the inner area is the same and the solver runs again.
+func keyed(sp lspec, k int) lspec {
+	sp2 := sp
+	if sp.horizontal {
+		sp2.pad.Left += k
+		sp2.area = uv.Rect(sp.area.Min.X-k, sp.area.Min.Y, sp.area.Dx()+k, sp.area.Dy())
+	} else {
+		sp2.pad.Top += k
+		sp2.area = uv.Rect(sp.area.Min.X, sp.area.Min.Y-k, sp.area.Dx(), sp.area.Dy()+k)
+	}
+	return sp2
+}
+
+// TestHegelLayoutsSplitTheSameEveryCall: solving the same layout again (under distinct cache
+// keys over the same inner area) gives the same split every time.
+func TestHegelLayoutsSplitTheSameEveryCall(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, tiedLayouts)
+		note(ht, "layout %s", sp)
+		seen := map[string]int{}
+		var first string
+		for k := 0; k < 40; k++ {
+			sp2 := keyed(sp, k)
+			got := fmt.Sprint(sp2.layout().Split(sp2.area))
+			if k == 0 {
+				first = got
+			}
+			seen[got]++
+		}
+		if len(seen) > 1 {
+			mismatch(ht, tieShape(sp), "%s: %d different splits in 40 solves, the first %s, all %v", sp, len(seen), first, seen)
+		}
+		count("ok")
+	})
+}
diff --git a/layout/hegel_test.go b/layout/hegel_test.go
new file mode 100644
index 0000000..1b1d56d
--- /dev/null
+++ b/layout/hegel_test.go
@@ -0,0 +1,913 @@
+package layout_test
+
+// Hegel property tests for the layout package (hegel-zoo target go/ultraviolet): random
+// layouts (direction, area, padding, spacing, flex, 0–6 constraints) are split and checked
+// against the documented invariants — the segments tile the padded area in order with the
+// spacers between them, Max is never exceeded, Min/Len/Percent/Ratio are honoured when they
+// fit — and, when the ratatui oracle is built (zoo/rtoracle, the Rust original this package
+// is a 1:1 translation of), against ratatui's Layout::split_with_spacers for the same input.
+//
+// The recorded bug (ultraviolet/26: the solver picks among equally good splits of an
+// over-constrained layout at random) is drawn at its natural rate and named by the failing
+// property; under HEGEL_NO_KNOWN=1 the layouts the cache and ratatui properties compare fit
+// their area by construction.
+//
+// Set UV_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches and statistics instead of
+// failing at the first one.
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	uv "github.com/charmbracelet/ultraviolet"
+	"github.com/charmbracelet/ultraviolet/layout"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bug (bugs.toml), read once. By default the
+// generators draw the bug's shape and the properties that meet it fail, naming the shape
+// (mismatch); under HEGEL_NO_KNOWN=1 the shape is left out of the generators (shaped) and a
+// check that a known shape would falsify is counted and skipped (known).
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// known reports whether a check whose shape is that of the recorded bug shape ("" for none)
+// is to be skipped: only under HEGEL_NO_KNOWN=1, where it is counted.
+func known(shape string) bool {
+	if shape == "" || !noKnown {
+		return false
+	}
+	count(shape + "-skipped")
+	return true
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("UV_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	statsMu       sync.Mutex
+	stats         = map[string]int{}
+)
+
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// mismatch reports a disagreement on a case whose shape is that of the recorded bug shape
+// ("" for none): the failure names the shape, and under HEGEL_NO_KNOWN=1 a disagreement on a
+// known shape is skipped instead.
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			if hegelPanic(r) {
+				panic(r)
+			}
+			msg := fmt.Sprintf("panic in the code under test: %v", r)
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, msg)
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("%s", msg)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// hegelPanic reports a panic of hegel's own (a failed or skipped case unwinding), which must
+// pass through.
+func hegelPanic(r any) bool {
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		return true
+	}
+	// hegel ends a case (assumption failed, choice budget spent) by panicking with an error
+	// value; the code under test panics with runtime errors or strings.
+	if err, ok := r.(error); ok {
+		var rt runtime.Error
+		return !errors.As(err, &rt)
+	}
+	return false
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied.
+var positions = hegel.Integers(0, 99)
+
+// ---------------------------------------------------------------- generators
+
+// cspec is one constraint: len pct ratio min max fill.
+type cspec struct {
+	kind string
+	a, b int
+}
+
+func (c cspec) constraint() layout.Constraint {
+	switch c.kind {
+	case "len":
+		return layout.Len(c.a)
+	case "pct":
+		return layout.Percent(c.a)
+	case "ratio":
+		return layout.Ratio{Num: c.a, Den: c.b}
+	case "min":
+		return layout.Min(c.a)
+	case "max":
+		return layout.Max(c.a)
+	}
+	return layout.Fill(c.a)
+}
+
+func (c cspec) String() string {
+	if c.kind == "ratio" {
+		return fmt.Sprintf("ratio:%d/%d", c.a, c.b)
+	}
+	return fmt.Sprintf("%s:%d", c.kind, c.a)
+}
+
+// ideal is the size the constraint asks for out of total cells (none for Fill).
+func (c cspec) ideal(total int) float64 {
+	switch c.kind {
+	case "len", "min", "max":
+		return float64(c.a)
+	case "pct":
+		return float64(c.a) / 100 * float64(total)
+	case "ratio":
+		return float64(c.a) / float64(max(1, c.b)) * float64(total)
+	}
+	return 0
+}
+
+// cellsOf is a constraint of the kind asking for 0 to 40 cells.
+func cellsOf(kind string) hegel.Generator[cspec] {
+	return hegel.Map(hegel.Integers(0, 40), func(a int) cspec { return cspec{kind, a, 0} })
+}
+
+var (
+	percents = hegel.Map(hegel.Integers(0, 120), func(a int) cspec { return cspec{"pct", a, 0} })
+	ratios   = hegel.Composite(func(tc hegel.TestCase) cspec {
+		return cspec{"ratio", hegel.Draw(tc, hegel.Integers(0, 5)), hegel.Draw(tc, hegel.Integers(1, 4))}
+	})
+	fills = hegel.Map(hegel.Integers(0, 4), func(a int) cspec { return cspec{"fill", a, 0} })
+)
+
+// constraints: each kind as often as the others.
+var constraints = hegel.OneOf(cellsOf("len"), percents, ratios, cellsOf("min"), cellsOf("max"), fills)
+
+var flexes = []struct {
+	f    layout.Flex
+	name string
+}{
+	{layout.FlexStart, "start"},
+	{layout.FlexLegacy, "legacy"},
+	{layout.FlexEnd, "end"},
+	{layout.FlexCenter, "center"},
+	{layout.FlexSpaceBetween, "between"},
+	{layout.FlexSpaceEvenly, "evenly"},
+	{layout.FlexSpaceAround, "around"},
+}
+
+// lspec is a layout and the area it splits.
+type lspec struct {
+	horizontal bool
+	area       uv.Rectangle
+	pad        layout.Padding
+	spacing    int
+	flex       int
+	cs         []cspec
+}
+
+func (sp lspec) layout() layout.Layout {
+	var cs []layout.Constraint
+	for _, c := range sp.cs {
+		cs = append(cs, c.constraint())
+	}
+	dir := layout.DirectionVertical
+	if sp.horizontal {
+		dir = layout.DirectionHorizontal
+	}
+	return layout.New(dir, cs...).WithPadding(sp.pad).WithSpacing(sp.spacing).WithFlex(flexes[sp.flex].f)
+}
+
+// inner is Padding.apply as documented: the area inset by the padding, empty when the
+// padding does not fit.
+func (sp lspec) inner() uv.Rectangle {
+	h, v := sp.pad.Left+sp.pad.Right, sp.pad.Top+sp.pad.Bottom
+	if sp.area.Dx() < h || sp.area.Dy() < v {
+		return uv.Rectangle{}
+	}
+	return uv.Rect(sp.area.Min.X+sp.pad.Left, sp.area.Min.Y+sp.pad.Top, sp.area.Dx()-h, sp.area.Dy()-v)
+}
+
+func (sp lspec) String() string {
+	var cs []string
+	for _, c := range sp.cs {
+		cs = append(cs, c.String())
+	}
+	d := "V"
+	if sp.horizontal {
+		d = "H"
+	}
+	return fmt.Sprintf("%s area=%v pad=%+v spacing=%d flex=%s [%s]", d, sp.area, sp.pad, sp.spacing, flexes[sp.flex].name, strings.Join(cs, " "))
+}
+
+func (sp lspec) GoString() string { return sp.String() }
+
+var (
+	areas = hegel.Composite(func(tc hegel.TestCase) uv.Rectangle {
+		return uv.Rect(hegel.Draw(tc, hegel.Integers(0, 20)), hegel.Draw(tc, hegel.Integers(0, 20)), hegel.Draw(tc, hegel.Integers(0, 60)), hegel.Draw(tc, hegel.Integers(0, 60)))
+	})
+	paddings = hegel.Composite(func(tc hegel.TestCase) layout.Padding {
+		return layout.Padding{
+			Top:    hegel.Draw(tc, hegel.Integers(0, 3)),
+			Right:  hegel.Draw(tc, hegel.Integers(0, 3)),
+			Bottom: hegel.Draw(tc, hegel.Integers(0, 3)),
+			Left:   hegel.Draw(tc, hegel.Integers(0, 3)),
+		}
+	})
+	// spacings: none six times in ten, else -3 (overlap) to 5.
+	spacings  = maybe(40, hegel.Integers(-3, 5))
+	flexIndex = hegel.Integers(0, len(flexes)-1)
+)
+
+// layouts: any layout, whose constraints may ask for more than the area holds (the region of
+// ultraviolet/26 for the cache and ratatui properties).
+var layouts = hegel.Composite(func(tc hegel.TestCase) lspec {
+	return lspec{
+		horizontal: hegel.Draw(tc, chance(50)),
+		area:       hegel.Draw(tc, areas),
+		pad:        hegel.Draw(tc, maybe(30, paddings)),
+		spacing:    hegel.Draw(tc, spacings),
+		flex:       hegel.Draw(tc, flexIndex),
+		cs:         hegel.Draw(tc, many(constraints, 0, 6)),
+	}
+})
+
+// constraintWithin is a constraint asking for at most budget of total cells even when grown
+// by a cell (the cache property grows one; Fill asks for nothing); with no budget left only
+// Fill remains.
+func constraintWithin(budget float64, total int) hegel.Generator[cspec] {
+	kinds := []hegel.Generator[cspec]{fills}
+	// The largest a with the ideal of a+1 within the budget: (a+1)*unit <= budget.
+	fits := func(unit float64, cap int) int {
+		if unit == 0 {
+			return cap
+		}
+		return min(cap, int(budget/unit)-1)
+	}
+	if cells := fits(1, 40); cells >= 0 {
+		for _, kind := range []string{"len", "min", "max"} {
+			kinds = append(kinds, hegel.Map(hegel.Integers(0, cells), func(a int) cspec { return cspec{kind, a, 0} }))
+		}
+	}
+	if pct := fits(float64(total)/100, 120); pct >= 0 {
+		kinds = append(kinds, hegel.Map(hegel.Integers(0, pct), func(a int) cspec { return cspec{"pct", a, 0} }))
+	}
+	var dens []int // the denominators with room for a numerator
+	for b := 1; b <= 4; b++ {
+		if fits(float64(total)/float64(b), 5) >= 0 {
+			dens = append(dens, b)
+		}
+	}
+	if len(dens) > 0 {
+		kinds = append(kinds, hegel.Composite(func(tc hegel.TestCase) cspec {
+			b := hegel.Draw(tc, hegel.SampledFrom(dens))
+			return cspec{"ratio", hegel.Draw(tc, hegel.Integers(0, fits(float64(total)/float64(b), 5))), b}
+		}))
+	}
+	return hegel.OneOf(kinds...)
+}
+
+// fittingLayouts: a layout whose constraints and gaps ask for less than the inner area holds,
+// each even when grown by a cell (the cache property grows one), so that the solver has one
+// best split. The region past ultraviolet/26.
+var fittingLayouts = hegel.Composite(func(tc hegel.TestCase) lspec {
+	sp := lspec{
+		horizontal: hegel.Draw(tc, chance(50)),
+		area:       hegel.Draw(tc, areas),
+		pad:        hegel.Draw(tc, maybe(30, paddings)),
+		spacing:    hegel.Draw(tc, spacings),
+		flex:       hegel.Draw(tc, flexIndex),
+	}
+	total := size(sp, sp.inner())
+	// As many constraints as the spacing between them leaves room for, up to 6.
+	kmax := 0
+	for k := 1; k <= 6; k++ {
+		sp.cs = make([]cspec, k)
+		if gapsFor(sp) < total {
+			kmax = k
+		}
+	}
+	sp.cs = make([]cspec, hegel.Draw(tc, hegel.Integers(0, kmax)))
+	budget := float64(total-gapsFor(sp)) - 1
+	for i := range sp.cs {
+		within := constraintWithin(budget, total)
+		if flexes[sp.flex].f == layout.FlexLegacy && i == len(sp.cs)-1 && !hasKind(sp, "fill") {
+			within = fills // Legacy's surplus goes to a Fill, not to a tie of lowest-priority segments
+		}
+		c := hegel.Draw(tc, within)
+		sp.cs[i] = c
+		budget -= cspec{c.kind, c.a + 1, c.b}.ideal(total)
+	}
+	return sp
+})
+
+// comparedLayouts are the layouts the cache and ratatui properties compare splits of.
+var comparedLayouts = shaped(layouts, fittingLayouts)
+
+// along returns the start and end of r on the layout axis.
+func along(sp lspec, r uv.Rectangle) (int, int) {
+	if sp.horizontal {
+		return r.Min.X, r.Max.X
+	}
+	return r.Min.Y, r.Max.Y
+}
+
+func size(sp lspec, r uv.Rectangle) int {
+	a, b := along(sp, r)
+	return b - a
+}
+
+func hasKind(sp lspec, kind string) bool {
+	for _, c := range sp.cs {
+		if c.kind == kind {
+			return true
+		}
+	}
+	return false
+}
+
+// gapsFor is the number of cells the spacers must take in the given flex mode.
+func gapsFor(sp lspec) int {
+	nseg := len(sp.cs)
+	switch flexes[sp.flex].f {
+	case layout.FlexSpaceEvenly:
+		return max(0, sp.spacing) * (nseg + 1)
+	case layout.FlexSpaceAround:
+		return 2 * max(0, sp.spacing) * nseg
+	}
+	return max(0, sp.spacing) * (nseg - 1)
+}
+
+// overConstrained reports whether the constraints ask for more than the area holds, in
+// which case the solver trades equal-priority requests off against each other and several
+// solutions are equally good (the shape of ultraviolet/26).
+func overConstrained(sp lspec) bool {
+	total := size(sp, sp.inner())
+	ideal := 0.0
+	for _, c := range sp.cs {
+		ideal += c.ideal(total)
+	}
+	return ideal+float64(gapsFor(sp)) > float64(total)
+}
+
+// legacySurplusTie reports whether Legacy's surplus has several lowest-priority segments to
+// go to (no Fill): the solver picks one of them.
+func legacySurplusTie(sp lspec) bool {
+	return flexes[sp.flex].f == layout.FlexLegacy && len(sp.cs) >= 2 && !hasKind(sp, "fill")
+}
+
+// tieShape names ultraviolet/26 for a layout with several equally good splits (over-constrained,
+// or a Legacy surplus with nowhere definite to go), "" otherwise.
+func tieShape(sp lspec) string {
+	if overConstrained(sp) || legacySurplusTie(sp) {
+		return "ultraviolet/26"
+	}
+	return ""
+}
+
+// ---------------------------------------------------------------- invariants
+
+func TestHegelLayoutSplitsTileTheArea(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, layouts)
+		note(ht, "layout %s", sp)
+		segs, spacers := sp.layout().SplitWithSpacers(sp.area)
+		note(ht, "segments %v\nspacers %v", segs, spacers)
+		if len(segs) != len(sp.cs) || len(spacers) != len(sp.cs)+1 {
+			fail(ht, "%s: %d segments and %d spacers for %d constraints", sp, len(segs), len(spacers), len(sp.cs))
+		}
+		if len(sp.cs) == 0 {
+			count("no-constraints")
+			return
+		}
+		in := sp.inner()
+		if in.Empty() {
+			count("empty-area")
+		}
+		aStart, aEnd := along(sp, in)
+		// Cross axis: every rectangle spans the inner area.
+		for i, r := range segs {
+			var lo, hi, wlo, whi int
+			if sp.horizontal {
+				lo, hi, wlo, whi = r.Min.Y, r.Max.Y, in.Min.Y, in.Max.Y
+			} else {
+				lo, hi, wlo, whi = r.Min.X, r.Max.X, in.Min.X, in.Max.X
+			}
+			if lo != wlo || hi != whi {
+				fail(ht, "%s: segment %d = %v does not span the inner area %v across", sp, i, r, in)
+			}
+		}
+		// Along the axis: in order, within the area, spacers between consecutive segments.
+		prevEnd := aStart
+		for i, r := range segs {
+			s, e := along(sp, r)
+			if s < aStart || e > aEnd || e < s {
+				fail(ht, "%s: segment %d = %v is outside the inner area %v", sp, i, r, in)
+			}
+			ss, se := along(sp, spacers[i])
+			if ss != prevEnd || se != s {
+				if sp.spacing < 0 && i > 0 {
+					// Overlap: spacer rectangles are clamped to size 0 at their start.
+					count("overlap")
+				} else {
+					fail(ht, "%s: spacer %d = %v should run from %d to segment %d's start %d", sp, i, spacers[i], prevEnd, i, s)
+				}
+			}
+			if i > 0 && sp.spacing >= 0 && s < prevEnd {
+				fail(ht, "%s: segment %d = %v starts before segment %d ends (%d)", sp, i, r, i-1, prevEnd)
+			}
+			prevEnd = e
+		}
+		if ls, le := along(sp, spacers[len(spacers)-1]); ls != prevEnd || le != aEnd {
+			if !(sp.spacing < 0) {
+				fail(ht, "%s: last spacer %v should run from %d to the area end %d", sp, spacers[len(spacers)-1], prevEnd, aEnd)
+			}
+		}
+		if in.Empty() {
+			return
+		}
+		total := aEnd - aStart
+		nseg := len(sp.cs)
+		flex := flexes[sp.flex].f
+		// Cells the spacers must take: the gaps between segments, plus the outer spacers in
+		// the modes where they are at least the spacing too (all of them for SpaceEvenly,
+		// half each for SpaceAround).
+		gaps := gapsFor(sp)
+		// Legacy fills the area: with no Fill to absorb the surplus, the lowest-priority
+		// segment grows past its own constraint (documented: Max(20) alone takes all 80).
+		// SpaceBetween with a single segment behaves the same (documented: Max(20) alone
+		// takes all 80). A negative spacing (overlap) forces every segment to be at least
+		// the overlap, which outranks its own constraint; only the tiling is checked then.
+		legacyGrows := flex == layout.FlexLegacy || (flex == layout.FlexSpaceBetween && nseg == 1)
+		if hasKind(sp, "fill") {
+			legacyGrows = false
+		}
+		if sp.spacing < 0 {
+			legacyGrows = true
+		}
+		// Fixed spacing modes: the inner spacers are exactly the spacing when it fits.
+		switch flex {
+		case layout.FlexLegacy, layout.FlexStart, layout.FlexEnd, layout.FlexCenter:
+			if gaps <= total {
+				for i := 1; i < nseg; i++ {
+					if got := size(sp, spacers[i]); got != max(0, sp.spacing) {
+						fail(ht, "%s: inner spacer %d is %d cells, spacing is %d", sp, i, got, sp.spacing)
+					}
+				}
+			}
+		}
+		// Legacy and SpaceBetween: no space before the first or after the last segment.
+		switch flex {
+		case layout.FlexLegacy, layout.FlexSpaceBetween:
+			if size(sp, spacers[0]) != 0 || size(sp, spacers[nseg]) != 0 {
+				fail(ht, "%s: outer spacers %v and %v are not empty", sp, spacers[0], spacers[nseg])
+			}
+		case layout.FlexStart:
+			if size(sp, spacers[0]) != 0 {
+				fail(ht, "%s: first spacer %v is not empty", sp, spacers[0])
+			}
+		case layout.FlexEnd:
+			if size(sp, spacers[nseg]) != 0 {
+				fail(ht, "%s: last spacer %v is not empty", sp, spacers[nseg])
+			}
+		}
+		// Max is the highest priority after the area itself: never exceeded.
+		sumMin, sumLen := 0, 0
+		for i, c := range sp.cs {
+			switch c.kind {
+			case "max":
+				if got := size(sp, segs[i]); got > c.a && !legacyGrows {
+					fail(ht, "%s: segment %d is %d cells, Max(%d)", sp, i, got, c.a)
+				}
+			case "min":
+				sumMin += c.a
+			case "len":
+				sumLen += c.a
+			}
+		}
+		// Min is honoured when all the mins fit; Len when the mins and lens fit.
+		if sumMin+gaps <= total && sp.spacing >= 0 {
+			for i, c := range sp.cs {
+				if c.kind == "min" {
+					if got := size(sp, segs[i]); got < c.a {
+						fail(ht, "%s: segment %d is %d cells, Min(%d) (mins %d fit in %d)", sp, i, got, c.a, sumMin, total)
+					}
+				}
+			}
+			count("mins-fit")
+		}
+		if sumMin+sumLen+gaps <= total && !legacyGrows {
+			for i, c := range sp.cs {
+				if c.kind == "len" {
+					if got := size(sp, segs[i]); got != c.a {
+						fail(ht, "%s: segment %d is %d cells, Len(%d) (mins+lens %d fit in %d)", sp, i, got, c.a, sumMin+sumLen, total)
+					}
+				}
+			}
+			count("lens-fit")
+		}
+		// Proportional constraints: within a cell of their share when everything fits.
+		if !overConstrained(sp) && !legacyGrows {
+			for i, c := range sp.cs {
+				var want float64
+				switch c.kind {
+				case "pct":
+					want = float64(c.a) / 100 * float64(total)
+				case "ratio":
+					want = float64(c.a) / float64(max(1, c.b)) * float64(total)
+				case "max":
+					want = float64(c.a)
+				default:
+					continue
+				}
+				got := float64(size(sp, segs[i]))
+				if got < want-1 || got > want+1 {
+					fail(ht, "%s: segment %d is %d cells, %s wants %.2f of %d (all constraints fit)", sp, i, size(sp, segs[i]), c, want, total)
+				}
+			}
+			count("all-fit")
+		}
+		// Legacy fills the area exactly.
+		if flex == layout.FlexLegacy && sp.spacing >= 0 && sp.spacing*(nseg-1) <= total {
+			sum := sp.spacing * (nseg - 1)
+			for _, r := range segs {
+				sum += size(sp, r)
+			}
+			if sum != total {
+				fail(ht, "%s: legacy segments + spacing cover %d of %d", sp, sum, total)
+			}
+		}
+		count("ok")
+	})
+}
+
+// cacheCase is a layout and, half the time, a constraint of it to grow by a cell.
+type cacheCase struct {
+	sp    lspec
+	nudge bool
+	at    int // position of the constraint
+}
+
+func (c cacheCase) GoString() string {
+	if c.nudge && len(c.sp.cs) > 0 {
+		return fmt.Sprintf("%s, constraint %d grown by one", c.sp, c.at%len(c.sp.cs))
+	}
+	return c.sp.String()
+}
+
+// nudged is the layout with the constraint grown by a cell.
+func (c cacheCase) nudged() lspec {
+	sp2 := c.sp
+	sp2.cs = append([]cspec(nil), c.sp.cs...)
+	sp2.cs[c.at%len(sp2.cs)].a++
+	return sp2
+}
+
+var cacheCases = hegel.Composite(func(tc hegel.TestCase) cacheCase {
+	return cacheCase{
+		sp:    hegel.Draw(tc, comparedLayouts),
+		nudge: hegel.Draw(tc, chance(50)),
+		at:    hegel.Draw(tc, positions),
+	}
+})
+
+// Split is a cached SplitWithSpacers: repeating a split, or splitting through Split, gives
+// the same rectangles, and two layouts that differ only in a constraint's value never share
+// a cache entry.
+func TestHegelLayoutCacheIsTransparent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cacheCases)
+		sp := c.sp
+		l := sp.layout()
+		segs, spacers := l.SplitWithSpacers(sp.area)
+		again, spacersAgain := l.SplitWithSpacers(sp.area)
+		if fmt.Sprint(segs) != fmt.Sprint(again) || fmt.Sprint(spacers) != fmt.Sprint(spacersAgain) {
+			fail(ht, "%s: second split differs: %v / %v then %v / %v", sp, segs, spacers, again, spacersAgain)
+		}
+		if got := l.Split(sp.area); fmt.Sprint(got) != fmt.Sprint(segs) {
+			fail(ht, "%s: Split = %v, SplitWithSpacers = %v", sp, got, segs)
+		}
+		if len(sp.cs) > 0 && c.nudge {
+			// Nudge one constraint and make sure the fresh solve is what comes back.
+			sp2 := c.nudged()
+			l2 := sp2.layout()
+			s2 := l2.Split(sp2.area)
+			s2Fresh := freshSplit(sp2)
+			// ultraviolet/26: among equally good solutions the solver's pick varies from
+			// call to call.
+			shape := tieShape(sp2)
+			if fmt.Sprint(s2) != fmt.Sprint(s2Fresh) {
+				mismatch(ht, shape, "%s then %s: cached split %v, uncached %v", sp, sp2, s2, s2Fresh)
+			}
+			if shape != "" {
+				count(shape + "-shaped")
+			}
+		}
+		count("ok")
+	})
+}
+
+// freshSplit solves the layout with a different (equivalent) constraint list so the cache
+// key differs: the same constraints preceded by nothing — there is no public way to bypass
+// the cache, so we compare with a layout whose area is shifted by a padding instead.
+func freshSplit(sp lspec) []uv.Rectangle {
+	// Pad by one on the leading side and grow the area by one: the inner area is the same.
+	sp2 := sp
+	if sp.horizontal {
+		sp2.pad.Left++
+		sp2.area = uv.Rect(sp.area.Min.X-1, sp.area.Min.Y, sp.area.Dx()+1, sp.area.Dy())
+	} else {
+		sp2.pad.Top++
+		sp2.area = uv.Rect(sp.area.Min.X, sp.area.Min.Y-1, sp.area.Dx(), sp.area.Dy()+1)
+	}
+	return sp2.layout().Split(sp2.area)
+}
+
+// ---------------------------------------------------------------- ratatui differential
+
+var oracleOnce struct {
+	sync.Once
+	path string
+}
+
+func oraclePath(t *testing.T) string {
+	oracleOnce.Do(func() {
+		if p := os.Getenv("UV_RATATUI_ORACLE"); p != "" {
+			oracleOnce.path = p
+			return
+		}
+		p := filepath.Join("..", "zoo", "rtoracle", "target", "release", "rtoracle")
+		if _, err := os.Stat(p); err == nil {
+			oracleOnce.path = p
+		}
+	})
+	if oracleOnce.path == "" {
+		t.Skip("ratatui oracle not built: cargo build --release --manifest-path zoo/rtoracle/Cargo.toml")
+	}
+	return oracleOnce.path
+}
+
+type oracle struct {
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+func startOracle(t *testing.T) *oracle {
+	cmd := exec.Command(oraclePath(t))
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { stdin.Close(); cmd.Wait() })
+	return &oracle{cmd, bufio.NewWriter(stdin), bufio.NewScanner(stdout)}
+}
+
+func parseRects(s string) []uv.Rectangle {
+	var out []uv.Rectangle
+	if s == "" {
+		return out
+	}
+	for _, r := range strings.Split(s, ";") {
+		var x, y, w, h int
+		fmt.Sscanf(r, "%d,%d,%d,%d", &x, &y, &w, &h)
+		out = append(out, uv.Rect(x, y, w, h))
+	}
+	return out
+}
+
+// split asks ratatui for the split of the inner area (ratatui has no padding).
+func (o *oracle) split(sp lspec, in uv.Rectangle) (segs, spacers []uv.Rectangle, err error) {
+	d := "V"
+	if sp.horizontal {
+		d = "H"
+	}
+	var cs []string
+	for _, c := range sp.cs {
+		cs = append(cs, c.String())
+	}
+	fmt.Fprintf(o.in, "%s %d %d %d %d %s %d %s\n", d, in.Min.X, in.Min.Y, in.Dx(), in.Dy(), flexes[sp.flex].name, sp.spacing, strings.Join(cs, " "))
+	if err := o.in.Flush(); err != nil {
+		return nil, nil, err
+	}
+	if !o.out.Scan() {
+		return nil, nil, fmt.Errorf("oracle died: %v", o.out.Err())
+	}
+	parts := strings.SplitN(o.out.Text(), "|", 2)
+	return parseRects(parts[0]), parseRects(parts[1]), nil
+}
+
+func TestHegelLayoutAgreesWithRatatui(t *testing.T) {
+	o := startOracle(t)
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, comparedLayouts)
+		note(ht, "layout %s", sp)
+		in := sp.inner()
+		segs, spacers := sp.layout().SplitWithSpacers(sp.area)
+		want, wantSpacers, err := o.split(sp, in)
+		if err != nil {
+			ht.Fatalf("%v", err)
+		}
+		if fmt.Sprint(segs) != fmt.Sprint(want) {
+			if overConstrained(sp) {
+				// Equally good solutions differ between the two solvers (and, ultraviolet/26,
+				// between two calls of this one).
+				count("over-constrained-differs")
+				return
+			}
+			if legacySurplusTie(sp) || (flexes[sp.flex].f == layout.FlexLegacy && !hasKind(sp, "fill")) {
+				// Legacy's surplus goes to "the lowest-priority trailing segment"; with two
+				// segments of that priority both solvers pick one of them (neither always
+				// the trailing one) — another tie.
+				count("legacy-surplus-tie")
+				return
+			}
+			fail(ht, "%s:\nuv      %v\nratatui %v", sp, segs, want)
+		} else if fmt.Sprint(spacers) != fmt.Sprint(wantSpacers) {
+			fail(ht, "%s: spacers\nuv      %v\nratatui %v", sp, spacers, wantSpacers)
+		} else {
+			count("ok")
+		}
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// ultraviolet/26: the Cassowary port (internal/casso) walks its tableau maps with `range`, so when
+// several solutions are equally good — any over-constrained layout — the one it lands on
+// depends on Go's randomised map order: the same layout splits differently from one call to
+// the next. The global cache hides it until an entry is evicted; here distinct cache keys
+// with the same inner area (a left padding of k on an area starting at -k) show both answers.
+func TestHegelPinLayoutSolverPicksAmongTiesAtRandom(t *testing.T) {
+	defer guard(t)
+	seen := map[string]int{}
+	for k := 0; k < 150; k++ {
+		l := layout.Horizontal(layout.Len(18), layout.Percent(110), layout.Len(31)).
+			WithFlex(layout.FlexSpaceAround).WithSpacing(1).WithPadding(layout.Padding{Left: k})
+		seen[fmt.Sprint(l.Split(uv.Rect(-k, 0, 50+k, 1)))]++
+	}
+	if len(seen) == 1 {
+		return
+	}
+	t.Fatalf("[Len(18) Percent(110) Len(31)] SpaceAround, spacing 1, 50 cells: %d different splits in 150 solves: %v", len(seen), seen)
+}
