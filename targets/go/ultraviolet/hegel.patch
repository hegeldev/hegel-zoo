+// TestHegelFlushedCursorPositionsReachTheTerminal: after SetCursorPosition and Flush the
+// terminal's cursor is at the requested cell.
+func TestHegelFlushedCursorPositionsReachTheTerminal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cursorMoves)
+		s, out := newScreen(c.w, c.h)
+		e := vt.NewEmulator(c.w, c.h)
+		s.EnterAltScreen()
+		s.ShowCursor()
+		if err := s.Display(uv.NewStyledString(c.text.render(c.w, 1+c.n%c.h))); err != nil {
+			fail(ht, "Display: %v", err)
+		}
+		feedTo(ht, out, e, nil)
+		x, y := c.x%c.w, c.y%c.h
+		s.SetCursorPosition(x, y)
+		if err := s.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		chunk := feedTo(ht, out, e, nil)
+		shape := "ultraviolet/27"
+		if c.frameAfter {
+			if err := s.Display(nil); err != nil {
+				fail(ht, "Display: %v", err)
+			}
+			chunk += feedTo(ht, out, e, nil)
+			shape = ""
+		}
+		if pos := e.CursorPosition(); pos.X != x || pos.Y != y {
+			mismatch(ht, shape, "SetCursorPosition(%d,%d) then Flush: the terminal's cursor is at (%d,%d); wrote %q", x, y, pos.X, pos.Y, chunk)
+		}
