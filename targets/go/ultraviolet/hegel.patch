+// ultraviolet/19: the whole-read key-table lookup runs before the bracketed-paste check, so a
+// read that is exactly a known key sequence while a paste is open is reported as a key press
+// and removed from the pasted text.
+func TestHegelPinTableLookupIgnoresAnOpenPaste(t *testing.T) {
+	defer guard(t)
+	in := "\x1b[200~ab\x1b[A\x1b[201~"
+	got := scanChunked(newScanner(0, "dumb", false), []byte(in), []int{8, 11})
