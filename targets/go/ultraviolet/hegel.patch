+// ultraviolet/2: TerminalReader.Legacy and TerminalReader.UseTerminfo, documented as the way to
+// configure the reader, have no effect: NewTerminalReader copies the zero EventDecoder into
+// the scanner and builds the key table before the fields can be set.
+func TestHegelPinTerminalReaderOptionsAreIgnored(t *testing.T) {
+	defer guard(t)
+	pr, pw := io.Pipe()
+	rd := NewTerminalReader(pr, "xterm")
+	rd.Legacy = LegacyKeyEncoding(0).CtrlI(true).CtrlM(true).Backspace(true)
+	rd.EscTimeout = 20 * time.Millisecond
+	evc := make(chan Event, 16)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		_ = rd.StreamEvents(ctx, evc)
+		close(done)
+	}()
+	_, _ = pw.Write([]byte("\t\r\x7f"))
+	time.Sleep(100 * time.Millisecond)
+	cancel()
+	_ = pw.Close()
+	<-done
+	close(evc)
+	var got []Event
+	for ev := range evc {
+		got = append(got, ev)
+	}
+	want := []Event{KeyPressEvent{Code: 'i', Mod: ModCtrl}, KeyPressEvent{Code: 'm', Mod: ModCtrl}, KeyPressEvent{Code: KeyDelete}}
+	if !reflect.DeepEqual(flatten(got), want) {
+		t.Errorf("TerminalReader with Legacy CtrlI|CtrlM|Backspace read \\t \\r DEL as\n    %s\n  want\n    %s", eventsString(flatten(got)), eventsString(want))
+	}
+}
