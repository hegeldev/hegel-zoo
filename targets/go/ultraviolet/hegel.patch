+package uv_test
+
+// TerminalRenderer against the charmbracelet/x/vt emulator: whatever the renderer emits to
+// bring the terminal from the previous frame to the new one must leave the emulator's screen
+// equal to the new frame. An external test package because x/vt imports ultraviolet; the
+// harness comes through the *T bridges in hegel_buffer_test.go.
+
+import (
+	"bytes"
+	"fmt"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/colorprofile"
+	uv "github.com/charmbracelet/ultraviolet"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/vt"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	property    = uv.PropertyT
+	count       = uv.CountT
+	note        = uv.NoteT
+	fail        = uv.FailT
+	genStyle    = uv.GenStyleT
+	genLink     = uv.GenLinkT
+	genCell     = uv.GenCellT
+	genGrapheme = uv.GenGraphemeT
+	genRect     = uv.GenRectT
+	applySGR    = uv.ApplySGRT
+	readLink    = uv.ReadLinkT
+	hasOrphan   = uv.HasOrphanT
+	cellString  = uv.CellStringT
+	styleString = uv.StyleStringT
+	colorEqual  = uv.ColorEqualT
+	cellEqual   = uv.CellEqualT
+	guard       = uv.GuardT
+)
+
+// ---------------------------------------------------------------- pins (renderer)
+
+// ultraviolet/24: updatePen(nil) resets the terminal's hyperlink but leaves it in the pen, so
+// the next cell carrying the same link is drawn without one. A cursor move to another row
+// resets the pen whenever it holds a style or a link.
+func TestHegelPinHyperlinkLostAfterPenReset(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	r := uv.NewTerminalRenderer(&out, []string{"TERM=xterm-256color"})
+	r.SetColorProfile(colorprofile.TrueColor)
+	r.SetFullscreen(true)
+	scr := uv.NewScreenBuffer(4, 2)
+	e := vt.NewEmulator(4, 2)
+	link := uv.Link{URL: "https://example.com/"}
+	scr.SetCell(0, 0, &uv.Cell{Content: "a", Width: 1, Link: link})
+	scr.SetCell(0, 1, &uv.Cell{Content: "b", Width: 1, Link: link})
+	r.Render(scr.RenderBuffer)
+	if err := r.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.WriteString(out.String()); err != nil {
+		t.Fatal(err)
+	}
+	if got := e.CellAt(0, 1).Link; got != link {
+		t.Errorf("b at (0,1) has link %v on the terminal, want %v; output %q", got, link, out.String())
+	}
+}
+
+// ultraviolet/25: the scroll optimisation scrolls a region of the terminal (and of the
+// renderer's current buffer) that contains a row the new frame did not touch. The row's old
+// content moves away, and since only touched rows are transformed nothing paints it back: the
+// terminal shows a blank where the frame has the row, and the renderer's record agrees with
+// the terminal rather than the frame, so later frames do not repair it either.
+func TestHegelPinScrollOptimisationSkipsAnUntouchedRow(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	r := uv.NewTerminalRenderer(&out, []string{"TERM=xterm-256color"})
+	r.SetColorProfile(colorprofile.TrueColor)
+	r.SetFullscreen(true)
+	r.SetScrollOptim(true)
+	scr := uv.NewScreenBuffer(2, 6)
+	e := vt.NewEmulator(2, 6)
+	cell := func(s string) *uv.Cell { return &uv.Cell{Content: s, Width: 1} }
+	scr.SetCell(0, 2, cell("#"))
+	scr.SetCell(0, 3, cell("0"))
+	r.Render(scr.RenderBuffer)
+	if err := r.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.WriteString(out.String()); err != nil {
+		t.Fatal(err)
+	}
+	out.Reset()
+	// The second frame shifts # down by two rows and keeps 0 where it was.
+	scr.SetCell(0, 0, cell("x"))
+	scr.SetCell(0, 1, cell("y"))
+	scr.SetCell(0, 2, cell("9"))
+	scr.SetCell(0, 3, cell("0")) // unchanged, so not touched
+	scr.SetCell(0, 4, &uv.Cell{Content: "#", Width: 1, Link: uv.Link{URL: "https://example.com/"}})
+	r.Render(scr.RenderBuffer)
+	if err := r.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.WriteString(out.String()); err != nil {
+		t.Fatal(err)
+	}
+	if got := e.CellAt(0, 3).Content; got != "0" {
+		t.Errorf("row 3 shows %q on the terminal, the frame has \"0\"; output %q", got, out.String())
+	}
+	if got := uv.RendererCurbufT(r).Line(3).String(); got != "0" {
+		t.Errorf("the renderer's current buffer has %q in row 3, the frame has \"0\"", got)
+	}
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// genText draws styled text for printAt: graphemes, spaces, SGR sequences, hyperlinks and
+// line breaks.
+func genText(tc hegel.TestCase, w int, lines int) string {
+	var sb strings.Builder
+	for i := 0; i < lines; i++ {
+		if i > 0 {
+			sb.WriteString(pick(tc, []string{"\n", "\r\n"}))
+		}
+		for k := n(tc, 0, w+2); k > 0; k-- {
+			switch n(tc, 0, 7) {
+			case 0:
+				s := genStyle(tc)
+				sb.WriteString(s.String())
+			case 1:
+				sb.WriteString("\x1b[m")
+			case 2:
+				l := genLink(tc)
+				sb.WriteString(ansi.SetHyperlink(l.URL, l.Params))
+			case 3:
+				sb.WriteString(" ")
+			default:
+				sb.WriteString(genGrapheme(tc, true))
+			}
+		}
+	}
+	return sb.String()
+}
+
+// printAt writes styled text into the screen buffer from (x, y), wrapping at the right edge
+// and stopping at the bottom — what a screen writer does with a model's view.
+func printAt(scr uv.ScreenBuffer, x, y int, text string) {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st uv.Style
+	var ln uv.Link
+	var state byte
+	w, h := scr.Width(), scr.Height()
+	for len(text) > 0 {
+		sq, cw, k, ns := ansi.DecodeSequenceWc(text, state, p)
+		switch {
+		case ansi.HasCsiPrefix(sq) && p.Command() == 'm':
+			applySGR(p.Params(), &st)
+		case ansi.HasOscPrefix(sq) && p.Command() == 8:
+			readLink(string(p.Data()), &ln)
+		case sq == "\r":
+			x = 0
+		case sq == "\n":
+			x = 0
+			y++
+		case cw > 0:
+			if x+cw > w {
+				x = 0
+				y++
+			}
+			if y >= h {
+				return
+			}
+			scr.SetCell(x, y, &uv.Cell{Content: sq, Width: cw, Style: st, Link: ln})
+			x += cw
+		}
+		text = text[k:]
+		state = ns
+	}
+}
+
+var (
+	irmOn     = regexp.MustCompile(`\x1b\[4h`)
+	scrollSeq = regexp.MustCompile(`\x1b\[[0-9;]*[rSTLM]|\x1bM`)
+)
+
+// untouchedRows reports whether some row of the frame is not marked touched.
+func untouchedRows(b *uv.RenderBuffer) bool {
+	for y := 0; y < b.Height(); y++ {
+		if y >= len(b.Touched) || b.Touched[y] == nil || (b.Touched[y].FirstCell == -1 && b.Touched[y].LastCell == -1) {
+			return true
+		}
+	}
+	return false
+}
+
+// compareScreen checks the emulator's screen against the rendered frame, then the renderer's
+// own record of the screen against it. It returns false when the case must stop because the
+// terminal state is no longer a reference. skipScroll says the frame was rendered with the
+// scroll optimisation moving rows while some row was untouched: a mismatch is then
+// ultraviolet/25 and the case stops.
+func compareScreen(ht *hegel.T, what string, r *uv.TerminalRenderer, newbuf *uv.RenderBuffer, e *vt.Emulator, chunk, transcript string, skipScroll bool) bool {
+	if irmOn.MatchString(chunk) {
+		// The vt emulator does not implement insert mode (IRM), which the renderer uses on
+		// terminals without ICH.
+		count("irm-emitted")
+		return false
+	}
+	bail := func() bool {
+		if skipScroll {
+			count("scroll-moved-untouched-row")
+		}
+		return skipScroll
+	}
+	w, h := newbuf.Width(), newbuf.Height()
+	for y := 0; y < h; y++ {
+		for x := 0; x < w; x++ {
+			c := newbuf.CellAt(x, y)
+			u := e.CellAt(x, y)
+			if c.IsZero() {
+				if u != nil && u.Width != 0 {
+					if bail() {
+						return false
+					}
+					fail(ht, "%s: (%d,%d) is a placeholder in the frame, emulator has %q w%d\nframe:\n%s\nemulator:\n%s\noutput %q", what, x, y, u.Content, u.Width, newbuf.String(), e.String(), transcript)
+				}
+				continue
+			}
+			if u == nil {
+				fail(ht, "%s: emulator has no cell at (%d,%d)", what, x, y)
+			}
+			if u.Content != c.Content || u.Width != c.Width {
+				if bail() {
+					return false
+				}
+				fail(ht, "%s: (%d,%d) frame %q w%d, emulator %q w%d\nframe:\n%s\nemulator:\n%s\noutput %q", what, x, y, c.Content, c.Width, u.Content, u.Width, newbuf.String(), e.String(), transcript)
+			}
+			// Bold, faint, italic, blink and the foreground colour are invisible on a
+			// blank; the renderer erases such cells with EL (background colour erase) and the
+			// emulator records them with the background only.
+			cs, us := c.Style, u.Style
+			if c.Content == " " {
+				invisible := uint8(uv.AttrBold | uv.AttrFaint | uv.AttrItalic | uv.AttrBlink | uv.AttrRapidBlink)
+				cs.Attrs &^= invisible
+				us.Attrs &^= invisible
+				cs.Fg, us.Fg = nil, nil
+				cs.UnderlineColor, us.UnderlineColor = nil, nil
+			}
+			if cs.Attrs != us.Attrs || cs.Underline != us.Underline ||
+				!colorEqual(cs.Fg, us.Fg) || !colorEqual(cs.Bg, us.Bg) || !colorEqual(cs.UnderlineColor, us.UnderlineColor) {
+				if bail() {
+					return false
+				}
+				fail(ht, "%s: (%d,%d) %q style %s, emulator %s\nframe:\n%s\noutput %q", what, x, y, c.Content, styleString(c.Style), styleString(u.Style), newbuf.String(), transcript)
+			}
+			if c.Link != u.Link {
+				if !c.Link.IsZero() && u.Link.IsZero() && strings.Contains(chunk, "\x1b]8;;\a") {
+					// The renderer reset the terminal's hyperlink without forgetting it
+					// in its pen, so the next cell with that link is drawn without one
+					// (ultraviolet/24).
+					count("link-lost-after-pen-reset")
+					return false
+				}
+				if bail() {
+					return false
+				}
+				fail(ht, "%s: (%d,%d) %q link %v, emulator %v\noutput %q", what, x, y, c.Content, c.Link, u.Link, transcript)
+			}
+		}
+	}
+	// The renderer's record of the screen now equals the frame.
+	cur := uv.RendererCurbufT(r)
+	if cur == nil {
+		// Nothing was rendered yet (no touched line): the renderer has no record.
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				if !cellEqual(newbuf.CellAt(x, y), &uv.EmptyCell) {
+					fail(ht, "%s: nothing rendered but the frame has %s at (%d,%d)", what, cellString(newbuf.CellAt(x, y)), x, y)
+				}
+			}
+		}
+		return true
+	}
+	for y := 0; y < h; y++ {
+		for x := 0; x < w; x++ {
+			if !cellEqual(cur.CellAt(x, y), newbuf.CellAt(x, y)) {
+				if bail() {
+					return false
+				}
+				fail(ht, "%s: after Render the current buffer (%d,%d) = %s, frame %s\noutput %q", what, x, y, cellString(cur.CellAt(x, y)), cellString(newbuf.CellAt(x, y)), transcript)
+			}
+		}
+	}
+	// The renderer's cursor model agrees with the terminal when it claims to know it.
+	if cx, cy := r.Position(); !uv.RendererAtPhantomT(r) && cx >= 0 && cy >= 0 && cx < w && cy < h {
+		if pos := e.CursorPosition(); pos.X != cx || pos.Y != cy {
+			fail(ht, "%s: renderer believes the cursor is at (%d,%d), emulator has it at (%d,%d)\noutput %q", what, cx, cy, pos.X, pos.Y, transcript)
+		}
+	}
+	return true
+}
+
+var renderTerms = []string{"xterm", "xterm-256color", "xterm-kitty", "linux", "screen", "tmux-256color", "alacritty", "vt100", "foot", "ghostty", "rxvt"}
+
+func TestHegelRendererDrawsWhatTheEmulatorShows(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		w, h := n(ht, 2, 16), n(ht, 1, 6)
+		term := pick(ht, renderTerms)
+		var out bytes.Buffer
+		r := uv.NewTerminalRenderer(&out, []string{"TERM=" + term})
+		r.SetColorProfile(colorprofile.TrueColor)
+		r.SetWidthMethod(ansi.WcWidth)
+		// Inline mode: the frame sits at the top of a taller terminal, the renderer moves the
+		// cursor relative to where it left it.
+		inline := chance(ht, 30)
+		r.SetFullscreen(!inline)
+		r.SetRelativeCursor(inline)
+		scroll, tabs, bs := chance(ht, 50), chance(ht, 40), chance(ht, 40)
+		r.SetScrollOptim(scroll)
+		if tabs {
+			r.SetTabStops(w)
+		}
+		r.SetBackspace(bs)
+		if chance(ht, 50) {
+			r.Erase()
+		}
+		scr := uv.NewScreenBuffer(w, h)
+		extra := 0
+		if inline {
+			extra = 3
+		}
+		e := vt.NewEmulator(w, h+extra)
+		var transcript string
+		note(ht, "screen %dx%d term %s inline %v scroll %v tabs %v bs %v", w, h, term, inline, scroll, tabs, bs)
+		for frame := n(ht, 1, 6); frame > 0; frame-- {
+			switch n(ht, 0, 10) {
+			case 0, 1, 2:
+				text := genText(ht, w, n(ht, 1, h+1))
+				note(ht, "printAt(0,0,%q)", text)
+				printAt(scr, 0, 0, text)
+			case 3:
+				text := genText(ht, w, n(ht, 1, 2))
+				x, y := n(ht, 0, w-1), n(ht, 0, h-1)
+				note(ht, "printAt(%d,%d,%q)", x, y, text)
+				printAt(scr, x, y, text)
+			case 4, 5:
+				for k := n(ht, 1, 6); k > 0; k-- {
+					x, y := n(ht, 0, w-1), n(ht, 0, h-1)
+					c := genCell(ht, true)
+					note(ht, "SetCell(%d,%d,%s)", x, y, cellString(c))
+					scr.SetCell(x, y, c)
+				}
+			case 6:
+				a := genRect(ht, w, h)
+				c := genCell(ht, false)
+				note(ht, "FillArea(%s,%v)", cellString(c), a)
+				scr.FillArea(c, a)
+			case 7:
+				a := genRect(ht, w, h)
+				note(ht, "ClearArea(%v)", a)
+				scr.ClearArea(a)
+			case 8:
+				y, k := n(ht, 0, h-1), n(ht, 1, 2)
+				if chance(ht, 50) {
+					note(ht, "InsertLine(%d,%d)", y, k)
+					scr.InsertLine(y, k, nil)
+				} else {
+					note(ht, "DeleteLine(%d,%d)", y, k)
+					scr.DeleteLine(y, k, nil)
+				}
+				if chance(ht, 70) {
+					text := genText(ht, w, 1)
+					yy := y
+					if !chance(ht, 50) {
+						yy = h - 1
+					}
+					note(ht, "printAt(0,%d,%q)", yy, text)
+					printAt(scr, 0, yy, text)
+				}
+			case 9:
+				note(ht, "Erase")
+				r.Erase()
+			default:
+				if inline {
+					note(ht, "Erase")
+					r.Erase()
+					break
+				}
+				// A terminal resize in fullscreen: the model, the renderer and the
+				// terminal all learn the new size.
+				w, h = n(ht, 2, 16), n(ht, 1, 6)
+				note(ht, "Resize(%d,%d)", w, h)
+				scr.Resize(w, h)
+				r.Resize(w, h)
+				e.Resize(w, h)
+			}
+			if hasOrphan(scr.Buffer) {
+				// A wide cell written over the placeholder of one wide cell and the head of
+				// another leaves an orphan (ultraviolet/22); the frame is no reference.
+				count("orphan-in-frame")
+				return
+			}
+			untouched := untouchedRows(scr.RenderBuffer)
+			r.Render(scr.RenderBuffer)
+			if err := r.Flush(); err != nil {
+				fail(ht, "Flush: %v", err)
+			}
+			chunk := out.String()
+			out.Reset()
+			transcript += chunk
+			if _, err := e.WriteString(chunk); err != nil {
+				fail(ht, "emulator write: %v", err)
+			}
+			skipScroll := scroll && untouched && scrollSeq.MatchString(chunk)
+			if !compareScreen(ht, fmt.Sprintf("frame %d", frame), r, scr.RenderBuffer, e, chunk, transcript, skipScroll) {
+				return
+			}
+		}
+		count("ok")
+	})
+}
