+// TestHegelPastesRoundTrip: bracketed paste through the scanner, in one read or cut into
+// several, yields the pasted text between the surrounding events.
+func TestHegelPastesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var sb strings.Builder
+		escBracket := false
+		for range n(ht, 0, 40) {
+			piece := pick(ht, []string{"a", "Z", " ", "\n", "\t", "\x03", "é", "世", "😃", "\x1b[A", "\x1b", "[", "2", "0", "1", "~", "+"})
+			if piece == "[" && strings.HasSuffix(sb.String(), "\x1b") {
+				escBracket = true // ESC [ + arbitrary text: an unrecognised sequence, dropped from the paste (pinned)
+			}
+			sb.WriteString(piece)
+		}
+		text := sb.String()
+		if strings.Contains(text, "\x1b[201~") {
+			count("contains-terminator")
+			return
+		}
+		if escBracket {
+			count("esc-bracket-skipped")
+			return
+		}
+		chunked := chance(ht, 50)
+		if chunked && strings.HasSuffix(text, "\x1b") {
+			count("trailing-esc-skipped") // pinned: ESC ESC [ at a read boundary is alt+[, the end marker is lost
+			return
+		}
+		before := genEvent(ht, false)
+		if pinnedKind(before.kind) || (chunked && f3Ambiguous(before)) {
+			before = encoded{"focus", "\x1b[I", []Event{FocusEvent{}}}
+		}
+		forbidden := forbiddenCuts([]encoded{before})
+		if chunked && strings.Contains(text, "\x1b[A") {
+			count("key-in-paste-skipped") // pinned: a read that is exactly a table key during a paste is a key press
+			return
+		}
+		after := pick(ht, []encoded{{"text", "o", []Event{keyPress('o', "o", 0)}}, {"blur", "\x1b[O", []Event{BlurEvent{}}}, {"none", "", nil}})
+		input := before.seq + "\x1b[200~" + text + "\x1b[201~" + after.seq
+		note(ht, "paste %q in %q", text, input)
+		want := flatten(before.want)
+		want = append(want, PasteStartEvent{}, PasteEvent{Content: text}, PasteEndEvent{})
+		want = append(want, flatten(after.want)...)
+		var got []Event
+		if !chunked {
+			got = scanOnce(newScanner(0, "dumb", false), []byte(input))
+		} else {
+			var cuts []int
+			for range n(ht, 1, 4) {
+				c := n(ht, 1, len(input)-1)
+				if forbidden[c] {
+					count("cut-skipped")
+					continue
+				}
+				cuts = append(cuts, c)
+			}
+			sort.Ints(cuts)
+			note(ht, "cuts %v", cuts)
+			got = scanChunked(newScanner(0, "dumb", false), []byte(input), cuts)
+		}
+		if !reflect.DeepEqual(got, want) {
+			fail(ht, "scanner on %q:\n  got\n    %s\n  want\n    %s", input, eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
