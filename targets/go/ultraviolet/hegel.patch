+// ---------------------------------------------------------------- pins (buffer)
+
+// ultraviolet/20: DeleteCell moves cells one column at a time through Line.Set, and InsertCell
+// moves them raw and then writes the vacated column through Line.Set: either way a wide cell
+// they move is blanked and its placeholder left orphaned.
+func TestHegelPinCellShiftsDestroyWideCells(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(5, 1)
+	b.SetCell(0, 0, NewCell(cellMethod, "世"))
+	b.SetCell(2, 0, NewCell(cellMethod, "a"))
+	b.InsertCell(0, 0, 1, nil)
+	if got, want := b.Line(0).String(), " 世a"; got != want {
+		t.Errorf("after InsertCell(0,0,1) on 世a, line = %q, want %q\n%s", got, want, dumpBuffer(b))
+	}
+	b = NewBuffer(5, 1)
+	b.SetCell(0, 0, NewCell(cellMethod, "a"))
+	b.SetCell(1, 0, NewCell(cellMethod, "世"))
+	b.SetCell(3, 0, NewCell(cellMethod, "b"))
+	b.DeleteCell(0, 0, 1, nil)
+	if got, want := b.Line(0).String(), "世b"; got != want {
+		t.Errorf("after DeleteCell(0,0,1) on a世b, line = %q, want %q\n%s", got, want, dumpBuffer(b))
+	}
+}
+
+// ultraviolet/21: Buffer.Resize cuts a line through a wide cell and leaves a head that does not
+// fit; InsertCell pushes a wide head into the last column the same way.
+func TestHegelPinResizeCutsWideCells(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 1)
+	b.SetCell(2, 0, NewCell(cellMethod, "世"))
+	b.Resize(3, 1)
+	if c := b.CellAt(2, 0); c.Width != 1 {
+		t.Errorf("after shrinking to 3 columns, cell 2 = %s (width %d in the last column), want a blank\n%s", cellString(c), c.Width, dumpBuffer(b))
+	}
+	b = NewBuffer(4, 1)
+	b.SetCell(0, 0, NewCell(cellMethod, "a"))
+	b.SetCell(1, 0, NewCell(cellMethod, "b"))
+	b.SetCell(2, 0, NewCell(cellMethod, "世"))
+	b.InsertCell(0, 0, 1, nil)
+	if c := b.CellAt(3, 0); c.Width != 1 {
+		t.Errorf("after InsertCell(0,0,1) on ab世, cell 3 = %s (width %d in the last column), want a blank\n%s", cellString(c), c.Width, dumpBuffer(b))
+	}
+}
+
+// ultraviolet/22: a wide cell written over the placeholder of one wide cell and the head of
+// another leaves the second one's placeholder orphaned.
+func TestHegelPinWideOverTwoWidesLeavesAnOrphan(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 1)
+	b.SetCell(0, 0, NewCell(cellMethod, "世"))
+	b.SetCell(2, 0, NewCell(cellMethod, "界"))
+	b.SetCell(1, 0, NewCell(cellMethod, "中"))
+	if c := b.CellAt(3, 0); c.IsZero() {
+		t.Errorf("cell 3 is an orphan placeholder, want a blank:\n%s", dumpBuffer(b))
+	}
+}
+
+// ultraviolet/23: InsertLineArea and DeleteLineArea copy the cells inside the area's columns
+// as they are, so a wide cell straddling the area's edge is torn: the moved row gets a head
+// without its placeholder, or a placeholder without its head.
+func TestHegelPinLineShiftsCutWideCellsAtTheAreaEdge(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 2)
+	b.SetCell(1, 0, NewCell(cellMethod, "世"))
+	b.InsertLineArea(0, 1, nil, Rect(0, 0, 2, 2))
+	if hasOrphan(b) {
+		t.Errorf("after InsertLineArea over columns 0-1 of a row holding 世 at 1, a wide head lost its placeholder:\n%s", dumpBuffer(b))
+	}
+	b = NewBuffer(4, 2)
+	b.SetCell(1, 1, NewCell(cellMethod, "世"))
+	b.DeleteLineArea(0, 1, nil, Rect(2, 0, 2, 2))
+	if hasOrphan(b) {
+		t.Errorf("after DeleteLineArea over columns 2-3 of a row holding 世 at 1, a placeholder lost its head:\n%s", dumpBuffer(b))
+	}
+}
