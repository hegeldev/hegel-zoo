+// ---------------------------------------------------------------- ultraviolet/19
+
+// pastedKey is a paste holding a key sequence between letters, delivered so that one read is
+// exactly the key sequence (the region of ultraviolet/19), or under HEGEL_NO_KNOWN=1 the
+// key sequence with the letter before it.
+type pastedKey struct {
+	before, key, after string
+}
+
+func (p pastedKey) text() string  { return p.before + p.key + p.after }
+func (p pastedKey) input() string { return "\x1b[200~" + p.text() + "\x1b[201~" }
+
+func (p pastedKey) cuts() []int {
+	start := 6 + len(p.before)
+	return []int{shaped(start, start-1), start + len(p.key)}
+}
+
+func (p pastedKey) GoString() string {
+	return fmt.Sprintf("paste %q read with cuts at %v", p.text(), p.cuts())
+}
+
+var pastedKeys = hegel.Composite(func(tc hegel.TestCase) pastedKey {
+	return pastedKey{
+		before: hegel.Draw(tc, lettersOf(1, 5)),
+		key:    hegel.Draw(tc, hegel.SampledFrom(slices.DeleteFunc(slices.Clone(keySequences), func(s string) bool { _, ok := dumbTable[s]; return !ok }))),
+		after:  hegel.Draw(tc, lettersOf(0, 5)),
+	}
+})
+
+// TestHegelPastedKeySequencesStayInThePaste: a key sequence inside a paste stays pasted text
+// however the reads fall around it.
+func TestHegelPastedKeySequencesStayInThePaste(t *testing.T) {
