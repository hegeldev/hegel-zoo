+func isModifierKey(code rune) bool {
+	return code >= KeyLeftShift && code <= KeyIsoLevel5Shift
+}
+
+func isKeypadKey(code rune) bool {
+	return code >= KeyKpEnter && code <= KeyKpBegin
+}
+
+// TestHegelKeystrokesMatchTheirKeys: a decoded key matches its own Keystroke() and String()
+// through MatchString — otherwise a binding written from what the program prints cannot fire.
+func TestHegelKeystrokesMatchTheirKeys(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		e := genEvent(ht, true)
+		var p EventDecoder
+		got := decodeAll(&p, []byte(e.seq))
+		for _, ev := range got {
+			var k Key
+			switch x := ev.(type) {
+			case KeyPressEvent:
+				k = Key(x)
+			case KeyReleaseEvent:
+				k = Key(x)
+			default:
+				continue
+			}
+			ks, str := k.String(), k.Keystroke()
+			note(ht, "%s %q -> %s: Keystroke %q String %q", e.kind, e.seq, eventString(ev), str, ks)
+			switch {
+			case isModifierKey(k.Code):
+				count("modifier-key-skipped") // pinned: Keystroke omits the key's own modifier
+				continue
+			case isKeypadKey(k.Code):
+				count("keypad-key-skipped") // pinned: Keystroke prints the main key's name, MatchString wants "kp…"
+				continue
+			case k.Code == KeyCapsLock || k.Code == KeyNumLock || k.Code == KeyScrollLock:
+				count("lock-key-skipped") // pinned: MatchString reads "capslock" as the modifier
+				continue
+			case k.BaseCode != 0 && k.BaseCode != k.Code:
+				count("base-code-skipped") // pinned: Keystroke prints the base key, MatchString ignores it
+				continue
+			case k.Mod&(ModCapsLock|ModNumLock|ModScrollLock) != 0:
+				count("lock-mod-skipped") // pinned: MatchString wants the exact modifier set
+				continue
+			case strings.Contains(str, "++") || strings.HasSuffix(str, "+") || strings.Contains(k.Text, "+"):
+				count("plus-skipped") // pinned: MatchString splits on '+'
+				continue
+			}
+			if !k.MatchString(str) {
+				fail(ht, "%s %q: %s does not MatchString its Keystroke %q", e.kind, e.seq, eventString(ev), str)
+			}
+			if !k.MatchString(ks) {
+				fail(ht, "%s %q: %s does not MatchString its String %q", e.kind, e.seq, eventString(ev), ks)
+			}
+		}
+		count("ok")
+	})
+}
