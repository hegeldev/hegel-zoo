+// ultraviolet/4: Keystroke() prints the base-layout key when the Kitty protocol reports one,
+// but MatchString compares Code only, so a key never matches its own keystroke on a non-US
+// layout.
+func TestHegelPinMatchStringIgnoresTheBaseKey(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte("\x1b[97:65:113;5u")) // ctrl + the 'a' key of an AZERTY keyboard (PC-101 'q')
+	k := ev.(KeyPressEvent)
+	if !k.MatchString(k.Keystroke()) {
+		t.Errorf("%s: Keystroke() is %q but MatchString(%q) is false", eventString(ev), k.Keystroke(), k.Keystroke())
+	}
+}
+
+// ultraviolet/5: MatchString splits its argument on '+', so the '+' key (and ctrl++, kp+)
+// cannot be matched by string, though Keystroke() prints "+" and "ctrl++".
+func TestHegelPinPlusKeyCannotBeMatched(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	for _, seq := range []string{"+", "\x1b[43;5u", "\x1b[27;3;43~"} {
+		_, ev := p.Decode([]byte(seq))
+		k := ev.(KeyPressEvent)
+		if !k.MatchString(k.Keystroke()) {
+			t.Errorf("%q: %s Keystroke() %q, MatchString(%q) false", seq, eventString(ev), k.Keystroke(), k.Keystroke())
+		}
+	}
+}
+
+// ultraviolet/6: MatchString requires the exact modifier set, and lock modifiers are part of
+// it, so with caps lock or num lock on (which the Kitty protocol reports for non-text keys)
+// no "ctrl+a"-style binding fires; Keystroke() does not print lock modifiers either.
+func TestHegelPinLockModifiersBreakBindings(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte("\x1b[97;69u")) // ctrl+a with caps lock on (4+64+1)
+	k := ev.(KeyPressEvent)
+	if k.Keystroke() != "ctrl+a" || !k.MatchString("ctrl+a") {
+		t.Errorf("%s: Keystroke() %q, MatchString(\"ctrl+a\") %v; want a match", eventString(ev), k.Keystroke(), k.MatchString("ctrl+a"))
+	}
+	_, ev = p.Decode([]byte("\x1b[57352;129u")) // up arrow with num lock on
+	k = ev.(KeyPressEvent)
+	if !k.MatchString("up") {
+		t.Errorf("%s: Keystroke() %q, MatchString(\"up\") false", eventString(ev), k.Keystroke())
+	}
+}
+
+// ultraviolet/7: Keystroke() omits a modifier key's own modifier ("leftshift" for shift held
+// on the left shift key), so MatchString(Keystroke()) is false for modifier key events.
+func TestHegelPinModifierKeysDoNotMatchTheirKeystroke(t *testing.T) {
+	defer guard(t)
+	var p EventDecoder
+	_, ev := p.Decode([]byte("\x1b[57441;2u")) // left shift, shift bit set (as kitty reports its release)
+	k := ev.(KeyPressEvent)
+	if !k.MatchString(k.Keystroke()) {
+		t.Errorf("%s: Keystroke() %q, MatchString(%q) false", eventString(ev), k.Keystroke(), k.Keystroke())
+	}
+}
