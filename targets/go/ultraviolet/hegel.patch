+package uv
+
+// The second slice of go/ultraviolet: the cell buffer (Line, Buffer, RenderBuffer,
+// ScreenBuffer), the Style SGR encoder/differ and the line renderer, against the grid model
+// carried over from go/cellbuf.
+
+import (
+	"fmt"
+	"image/color"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- cell generators
+
+var (
+	narrowGraphemes = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "ก้"}
+	wideGraphemes   = []string{"世", "界", "中", "文", "日", "本", "😃", "🫧", "Ａ"}
+)
+
+// cellMethod is the width method every cell in this file is built with.
+var cellMethod WidthMethod = ansi.WcWidth
+
+func genGrapheme(tc hegel.TestCase, allowWide bool) string {
+	if allowWide && chance(tc, 30) {
+		return pick(tc, wideGraphemes)
+	}
+	return pick(tc, narrowGraphemes)
+}
+
+func genColor(tc hegel.TestCase) color.Color {
+	switch n(tc, 0, 3) {
+	case 0:
+		return nil
+	case 1:
+		return ansi.BasicColor(n(tc, 0, 15))
+	case 2:
+		return ansi.ExtendedColor(n(tc, 16, 255))
+	default:
+		return color.RGBA{R: uint8(n(tc, 0, 255)), G: uint8(n(tc, 0, 255)), B: uint8(n(tc, 0, 255)), A: 0xff}
+	}
+}
+
+func genStyle(tc hegel.TestCase) Style {
+	var s Style
+	if chance(tc, 40) {
+		return s
+	}
+	s.Attrs = uint8(n(tc, 0, 255))
+	if chance(tc, 50) {
+		s.Attrs = uint8(1 << n(tc, 0, 7))
+	}
+	if chance(tc, 30) {
+		s.Underline = Underline(n(tc, 0, 5))
+	}
+	s.Fg = genColor(tc)
+	s.Bg = genColor(tc)
+	if chance(tc, 20) {
+		s.UnderlineColor = genColor(tc)
+	}
+	return s
+}
+
+func genLink(tc hegel.TestCase) Link {
+	if chance(tc, 80) {
+		return Link{}
+	}
+	l := Link{URL: fmt.Sprintf("https://example.com/%d", n(tc, 0, 9))}
+	if chance(tc, 30) {
+		l.Params = fmt.Sprintf("id=%d", n(tc, 0, 9))
+	}
+	return l
+}
+
+// genCell draws a cell: nil (a blank) or a grapheme cell with a style and a link.
+func genCell(tc hegel.TestCase, allowWide bool) *Cell {
+	if chance(tc, 25) {
+		return nil
+	}
+	c := NewCell(cellMethod, genGrapheme(tc, allowWide))
+	if chance(tc, 10) {
+		c = NewCell(cellMethod, " ")
+	}
+	c.Style = genStyle(tc)
+	c.Link = genLink(tc)
+	return c
+}
+
+func styleString(s Style) string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b uls:%d}", s.Fg, s.Bg, s.UnderlineColor, s.Attrs, s.Underline)
+}
+
+func cellString(c *Cell) string {
+	if c == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%q w%d %s %v}", c.Content, c.Width, styleString(c.Style), c.Link)
+}
+
+// ---------------------------------------------------------------- the grid model
+
+// mcell is the model's cell: a placeholder is the zero mcell (w == 0, s == "").
+type mcell struct {
+	s  string
+	w  int
+	st Style
+	ln Link
+}
+
+var mblank = mcell{s: " ", w: 1}
+
+func (c mcell) isZero() bool { return c.w == 0 && c.s == "" && c.st.IsZero() && c.ln.IsZero() }
+
+func (c mcell) isBlank() bool { return c.w == 1 && c.s == " " && c.st.IsZero() && c.ln.IsZero() }
+
+type mgrid struct {
+	w, h int
+	g    [][]mcell
+}
+
+func newGrid(w, h int) *mgrid {
+	m := &mgrid{}
+	m.resize(w, h)
+	return m
+}
+
+// resize follows Buffer.Resize: lines keep their cells, new columns and lines are blank; a
+// buffer without lines has width 0.
+func (m *mgrid) resize(w, h int) {
+	if w == m.w && h == m.h {
+		return
+	}
+	for y := range m.g {
+		if w > len(m.g[y]) {
+			for x := len(m.g[y]); x < w; x++ {
+				m.g[y] = append(m.g[y], mblank)
+			}
+		} else {
+			m.g[y] = m.g[y][:w]
+		}
+	}
+	for len(m.g) < h {
+		row := make([]mcell, w)
+		for x := range row {
+			row[x] = mblank
+		}
+		m.g = append(m.g, row)
+	}
+	m.g = m.g[:h]
+	m.h = h
+	m.w = w
+	if h == 0 {
+		m.w = 0
+	}
+}
+
+// splitWide blanks the wide cell covering column x, keeping its style and link.
+func (m *mgrid) splitWide(x, y int) {
+	if x < 0 || x >= m.w {
+		return
+	}
+	c := m.g[y][x]
+	head := -1
+	if c.w > 1 {
+		head = x
+	} else if c.isZero() {
+		for j := 1; x-j >= 0; j++ {
+			if wc := m.g[y][x-j]; wc.w > 1 {
+				if j < wc.w {
+					head = x - j
+				}
+				break
+			}
+		}
+	}
+	if head < 0 {
+		return
+	}
+	hc := m.g[y][head]
+	for k := 0; k < hc.w && head+k < m.w; k++ {
+		m.g[y][head+k] = mcell{s: " ", w: 1, st: hc.st, ln: hc.ln}
+	}
+}
+
+// coversWideHead reports whether writing a cell of width w at x would overwrite the head of
+// another wide cell with a placeholder (its own placeholder is then left orphaned).
+func (m *mgrid) coversWideHead(x, y, w int) bool {
+	if y < 0 || y >= m.h {
+		return false
+	}
+	for j := 1; j < w && x+j < m.w; j++ {
+		if m.g[y][x+j].w > 1 {
+			return true
+		}
+	}
+	return false
+}
+
+// hasWide reports whether the rectangle contains a wide cell head or placeholder.
+func (m *mgrid) hasWide(r Rectangle) bool {
+	for y := max(r.Min.Y, 0); y < min(r.Max.Y, m.h); y++ {
+		for x := max(r.Min.X, 0); x < min(r.Max.X, m.w); x++ {
+			if c := m.g[y][x]; c.w != 1 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// cutsWide reports whether a vertical edge of the rectangle runs through a wide cell in one
+// of its rows (head on one side, placeholder on the other).
+func (m *mgrid) cutsWide(r Rectangle) bool {
+	for y := max(r.Min.Y, 0); y < min(r.Max.Y, m.h); y++ {
+		for x := 0; x < m.w; x++ {
+			c := m.g[y][x]
+			if c.w > 1 {
+				for _, edge := range []int{r.Min.X, r.Max.X} {
+					if x < edge && edge < x+c.w {
+						return true
+					}
+				}
+			}
+		}
+	}
+	return false
+}
+
+func (m *mgrid) setCell(x, y int, c *Cell) {
+	if y < 0 || y >= m.h || x < 0 || x >= m.w {
+		return
+	}
+	w := 1
+	mc := mblank
+	if c != nil {
+		w = c.Width
+		mc = mcell{s: c.Content, w: c.Width, st: c.Style, ln: c.Link}
+	}
+	m.splitWide(x, y)
+	if c != nil && x+w > m.w {
+		for i := 0; i < w && x+i < m.w; i++ {
+			m.g[y][x+i] = mcell{s: " ", w: 1, st: c.Style, ln: c.Link}
+		}
+		return
+	}
+	m.g[y][x] = mc
+	for j := 1; j < w && x+j < m.w; j++ {
+		m.g[y][x+j] = mcell{}
+	}
+}
+
+func (m *mgrid) fillRect(c *Cell, r Rectangle) {
+	cw := 1
+	if c != nil && c.Width > 1 {
+		cw = c.Width
+	}
+	for y := r.Min.Y; y < r.Max.Y; y++ {
+		for x := r.Min.X; x < r.Max.X; x += cw {
+			m.setCell(x, y, c)
+		}
+	}
+}
+
+func (m *mgrid) fillLine(y int, x0, x1 int, c *Cell) {
+	for x := x0; x < x1; x++ {
+		m.setCell(x, y, c)
+	}
+}
+
+func (m *mgrid) insertLine(y, nl int, c *Cell, r Rectangle) {
+	if nl <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h {
+		return
+	}
+	nl = min(nl, r.Max.Y-y)
+	for i := r.Max.Y - 1; i >= y+nl; i-- {
+		copy(m.g[i][r.Min.X:r.Max.X], m.g[i-nl][r.Min.X:r.Max.X])
+	}
+	for i := y; i < y+nl; i++ {
+		m.fillLine(i, r.Min.X, r.Max.X, c)
+	}
+}
+
+func (m *mgrid) deleteLine(y, nl int, c *Cell, r Rectangle) {
+	if nl <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h {
+		return
+	}
+	nl = min(nl, r.Max.Y-y)
+	for dst := y; dst < r.Max.Y-nl; dst++ {
+		copy(m.g[dst][r.Min.X:r.Max.X], m.g[dst+nl][r.Min.X:r.Max.X])
+	}
+	for i := r.Max.Y - nl; i < r.Max.Y; i++ {
+		m.fillLine(i, r.Min.X, r.Max.X, c)
+	}
+}
+
+// fillCell is the model cell for the fill argument of the shift operations.
+func fillCell(c *Cell) mcell {
+	if c == nil {
+		return mblank
+	}
+	return mcell{s: c.Content, w: c.Width, st: c.Style, ln: c.Link}
+}
+
+// normalize applies the terminal rule to a shifted row: a wide cell that lost its
+// placeholders or a placeholder that lost its head is erased (blanked, keeping the style).
+func (m *mgrid) normalize(y int) {
+	row := m.g[y]
+	for x := 0; x < len(row); {
+		c := row[x]
+		switch {
+		case c.w > 1:
+			ok := x+c.w <= len(row)
+			for j := 1; ok && j < c.w; j++ {
+				ok = row[x+j].isZero()
+			}
+			if !ok {
+				for j := 0; j < c.w && x+j < len(row); j++ {
+					if j == 0 || row[x+j].isZero() {
+						row[x+j] = mcell{s: " ", w: 1, st: c.st, ln: c.ln}
+					}
+				}
+				x++
+				continue
+			}
+			x += c.w
+		case c.isZero():
+			row[x] = mblank
+			x++
+		default:
+			x++
+		}
+	}
+}
+
+// insertCell follows ICH: the cells from x move right as they are, the vacated columns take
+// the fill cell.
+func (m *mgrid) insertCell(x, y, nc int, c *Cell, r Rectangle) {
+	if nc <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h || x < r.Min.X || x >= r.Max.X || x >= m.w {
+		return
+	}
+	nc = min(nc, r.Max.X-x)
+	for i := r.Max.X - 1; i >= x+nc && i-nc >= r.Min.X; i-- {
+		m.g[y][i] = m.g[y][i-nc]
+	}
+	for i := x; i < min(x+nc, r.Max.X); i++ {
+		m.g[y][i] = fillCell(c)
+	}
+	m.normalize(y)
+}
+
+// deleteCell follows DCH: the cells after the deleted ones move left as they are, the vacated
+// columns at the right edge take the fill cell.
+func (m *mgrid) deleteCell(x, y, nc int, c *Cell, r Rectangle) {
+	if nc <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h || x < r.Min.X || x >= r.Max.X || x >= m.w {
+		return
+	}
+	nc = min(nc, r.Max.X-x)
+	for i := x; i < r.Max.X-nc; i++ {
+		m.g[y][i] = m.g[y][i+nc]
+	}
+	for i := r.Max.X - nc; i < r.Max.X; i++ {
+		m.g[y][i] = fillCell(c)
+	}
+	m.normalize(y)
+}
+
+// cloneArea follows Buffer.CloneArea: nil outside the bounds, otherwise every non-placeholder
+// cell written into a fresh grid.
+func (m *mgrid) cloneArea(r Rectangle) *mgrid {
+	if !r.In(Rect(0, 0, m.w, m.h)) {
+		return nil
+	}
+	c := newGrid(r.Dx(), r.Dy())
+	m.drawInto(c, r.Min.X, r.Min.Y, -r.Min.X, -r.Min.Y, r.Dx(), r.Dy())
+	return c
+}
+
+// drawInto writes the w×h region of m at (sx, sy) into dst at (sx+dx, sy+dy).
+func (m *mgrid) drawInto(dst *mgrid, sx, sy, dx, dy, w, h int) {
+	for y := sy; y < sy+h; y++ {
+		for x := sx; x < sx+w; {
+			if y < 0 || y >= m.h || x < 0 || x >= m.w {
+				x++
+				continue
+			}
+			c := m.g[y][x]
+			if c.isZero() {
+				x++
+				continue
+			}
+			dst.setCell(x+dx, y+dy, &Cell{Content: c.s, Width: c.w, Style: c.st, Link: c.ln})
+			x += max(c.w, 1)
+		}
+	}
+}
+
+// lineString follows Line.String: placeholders vanish, plain blanks are kept back until
+// something follows them, styled blanks are written.
+func (m *mgrid) lineString(y int) string {
+	var sb strings.Builder
+	pending := 0
+	for _, c := range m.g[y] {
+		if c.isZero() {
+			continue
+		}
+		if c.isBlank() {
+			pending++
+			continue
+		}
+		sb.WriteString(strings.Repeat(" ", pending))
+		pending = 0
+		sb.WriteString(c.s)
+	}
+	return sb.String()
+}
+
+func (m *mgrid) String() string {
+	lines := make([]string, m.h)
+	for y := range lines {
+		lines[y] = m.lineString(y)
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (m *mgrid) dump() string {
+	var sb strings.Builder
+	for y := 0; y < m.h; y++ {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range m.g[y] {
+			fmt.Fprintf(&sb, " {%q w%d}", c.s, c.w)
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+func dumpBuffer(b *Buffer) string {
+	var sb strings.Builder
+	for y, l := range b.Lines {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range l {
+			fmt.Fprintf(&sb, " {%q w%d}", c.Content, c.Width)
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+// hasOrphan reports whether the buffer holds a placeholder not covered by a wide head, or a
+// wide head whose placeholders do not fit or are missing.
+func hasOrphan(b *Buffer) bool {
+	for _, l := range b.Lines {
+		covered := 0
+		for x, c := range l {
+			if covered > 0 {
+				covered--
+				if !c.IsZero() {
+					return true
+				}
+				continue
+			}
+			if c.IsZero() {
+				return true
+			}
+			if c.Width > 1 {
+				if x+c.Width > len(l) {
+					return true
+				}
+				covered = c.Width - 1
+			}
+		}
+	}
+	return false
+}
+
+func sameCell(c *Cell, mc mcell) bool {
+	return c != nil && c.Content == mc.s && c.Width == mc.w && c.Style.Equal(&mc.st) && c.Link == mc.ln
+}
+
+// compareGrid checks the buffer against the model cell by cell.
+func compareGrid(ht *hegel.T, what string, b *Buffer, m *mgrid) {
+	if b.Width() != m.w || b.Height() != m.h {
+		fail(ht, "%s: buffer %dx%d, model %dx%d", what, b.Width(), b.Height(), m.w, m.h)
+	}
+	for y := 0; y < m.h; y++ {
+		if got := len(b.Lines[y]); got != m.w {
+			fail(ht, "%s: line %d has %d cells, width %d", what, y, got, m.w)
+		}
+		for x := 0; x < m.w; x++ {
+			c := b.CellAt(x, y)
+			mc := m.g[y][x]
+			if !sameCell(c, mc) {
+				fail(ht, "%s: cell (%d,%d) = %s, model {%q w%d %s %v}\nbuffer:\n%s\nmodel:\n%s", what, x, y, cellString(c), mc.s, mc.w, styleString(mc.st), mc.ln, dumpBuffer(b), m.dump())
+			}
+		}
+	}
+	if got, want := b.String(), m.String(); got != want {
+		fail(ht, "%s: String() = %q, model %q\nbuffer:\n%s", what, got, want, dumpBuffer(b))
+	}
+	if got, want := b.Bounds(), Rect(0, 0, m.w, m.h); got != want {
+		fail(ht, "%s: Bounds() = %v, want %v", what, got, want)
+	}
+}
+
+func genRect(tc hegel.TestCase, w, h int) Rectangle {
+	x0, y0 := n(tc, 0, max(w-1, 0)), n(tc, 0, max(h-1, 0))
+	return Rect(x0, y0, n(tc, 0, w-x0), n(tc, 0, h-y0))
+}
+
+// gridOps is what Buffer and RenderBuffer share.
+type gridOps interface {
+	SetCell(x, y int, c *Cell)
+	FillArea(c *Cell, area Rectangle)
+	ClearArea(area Rectangle)
+	InsertLineArea(y, n int, c *Cell, area Rectangle)
+	DeleteLineArea(y, n int, c *Cell, area Rectangle)
+	InsertCellArea(x, y, n int, c *Cell, area Rectangle)
+	DeleteCellArea(x, y, n int, c *Cell, area Rectangle)
+	Resize(width, height int)
+}
+
+func snapshot(b *Buffer) [][]Cell {
+	s := make([][]Cell, len(b.Lines))
+	for y, l := range b.Lines {
+		s[y] = append([]Cell(nil), l...)
+	}
+	return s
+}
+
+// checkTouched verifies that every line whose cells changed is marked touched.
+func checkTouched(ht *hegel.T, what string, rb *RenderBuffer, before [][]Cell) {
+	if rb == nil {
+		return
+	}
+	for y, l := range rb.Lines {
+		changed := y >= len(before) || len(before[y]) != len(l)
+		for x := 0; !changed && x < len(l); x++ {
+			changed = l[x] != before[y][x]
+		}
+		if changed && (y >= len(rb.Touched) || rb.Touched[y] == nil) {
+			fail(ht, "%s: line %d changed but is not touched (Touched %v)\n%s", what, y, rb.Touched, dumpBuffer(rb.Buffer))
+		}
+	}
+}
+
+func TestHegelBufferFollowsTheGridModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		w, h := n(ht, 1, 10), n(ht, 1, 5)
+		var (
+			b   *Buffer
+			rb  *RenderBuffer
+			ops gridOps
+		)
+		if chance(ht, 50) {
+			rb = NewRenderBuffer(w, h)
+			b, ops = rb.Buffer, rb
+			note(ht, "RenderBuffer %dx%d", w, h)
+		} else {
+			b = NewBuffer(w, h)
+			ops = b
+			note(ht, "Buffer %dx%d", w, h)
+		}
+		m := newGrid(w, h)
+		compareGrid(ht, "new", b, m)
+		for step := n(ht, 1, 25); step > 0; step-- {
+			w, h = m.w, m.h
+			op := n(ht, 0, 12)
+			if w == 0 || h == 0 {
+				op = 9
+			}
+			before := snapshot(b)
+			switch op {
+			case 0, 1, 2:
+				x, y := n(ht, -1, w), n(ht, -1, h)
+				c := genCell(ht, true)
+				if c != nil && m.coversWideHead(x, y, c.Width) {
+					count("wide-over-wide-head")
+					break
+				}
+				note(ht, "SetCell(%d,%d,%s)", x, y, cellString(c))
+				ops.SetCell(x, y, c)
+				m.setCell(x, y, c)
+				compareGrid(ht, "after SetCell", b, m)
+				checkTouched(ht, "after SetCell", rb, before)
+			case 3:
+				r := genRect(ht, w, h)
+				c := genCell(ht, true)
+				if c != nil && c.Width > 1 && m.hasWide(Rect(r.Min.X, r.Min.Y, r.Dx()+c.Width-1, r.Dy())) {
+					count("wide-fill-over-wide")
+					break
+				}
+				note(ht, "FillArea(%s, %v)", cellString(c), r)
+				ops.FillArea(c, r)
+				m.fillRect(c, r)
+				compareGrid(ht, "after FillArea", b, m)
+				checkTouched(ht, "after FillArea", rb, before)
+			case 4:
+				r := genRect(ht, w, h)
+				note(ht, "ClearArea(%v)", r)
+				ops.ClearArea(r)
+				m.fillRect(nil, r)
+				compareGrid(ht, "after ClearArea", b, m)
+				checkTouched(ht, "after ClearArea", rb, before)
+			case 5, 6:
+				r := b.Bounds()
+				if chance(ht, 40) {
+					r = genRect(ht, w, h)
+				}
+				y, k := n(ht, 0, h), n(ht, 1, 3)
+				c := genCell(ht, false)
+				if c != nil && c.Width != 1 {
+					c = nil
+				}
+				if m.cutsWide(r) {
+					count("line-shift-cuts-wide")
+					break
+				}
+				if op == 5 {
+					note(ht, "InsertLineArea(%d,%d,%s,%v)", y, k, cellString(c), r)
+					ops.InsertLineArea(y, k, c, r)
+					m.insertLine(y, k, c, r)
+				} else {
+					note(ht, "DeleteLineArea(%d,%d,%s,%v)", y, k, cellString(c), r)
+					ops.DeleteLineArea(y, k, c, r)
+					m.deleteLine(y, k, c, r)
+				}
+				compareGrid(ht, "after line shift", b, m)
+				checkTouched(ht, "after line shift", rb, before)
+			case 7, 8:
+				r := b.Bounds()
+				if chance(ht, 40) {
+					r = genRect(ht, w, h)
+				}
+				x, y, k := n(ht, 0, w), n(ht, 0, h-1), n(ht, 1, 3)
+				c := genCell(ht, false)
+				if c != nil && c.Width != 1 {
+					c = nil
+				}
+				if m.hasWide(Rect(r.Min.X, y, r.Dx(), 1)) {
+					count("wide-in-shifted-cells")
+					break
+				}
+				if op == 7 {
+					note(ht, "InsertCellArea(%d,%d,%d,%s,%v)", x, y, k, cellString(c), r)
+					ops.InsertCellArea(x, y, k, c, r)
+					m.insertCell(x, y, k, c, r)
+				} else {
+					note(ht, "DeleteCellArea(%d,%d,%d,%s,%v)", x, y, k, cellString(c), r)
+					ops.DeleteCellArea(x, y, k, c, r)
+					m.deleteCell(x, y, k, c, r)
+				}
+				compareGrid(ht, "after cell shift", b, m)
+				checkTouched(ht, "after cell shift", rb, before)
+			case 9:
+				nw, nh := n(ht, 0, 10), n(ht, 0, 5)
+				if nw < w {
+					cut := false
+					for y := 0; y < h; y++ {
+						for x := max(nw-2, 0); x < nw; x++ {
+							if c := m.g[y][x]; c.w > 1 && x+c.w > nw {
+								cut = true
+							}
+						}
+					}
+					if cut {
+						count("shrink-through-wide")
+						break
+					}
+				}
+				note(ht, "Resize(%d,%d)", nw, nh)
+				ops.Resize(nw, nh)
+				m.resize(nw, nh)
+				compareGrid(ht, "after Resize", b, m)
+			case 10:
+				r := genRect(ht, w, h)
+				if chance(ht, 20) {
+					r = Rect(n(ht, -2, w), n(ht, -2, h), n(ht, 0, w+2), n(ht, 0, h+2))
+				}
+				note(ht, "CloneArea(%v)", r)
+				got, want := b.CloneArea(r), m.cloneArea(r)
+				if (got == nil) != (want == nil) {
+					fail(ht, "CloneArea(%v) nil-ness %v, model %v", r, got == nil, want == nil)
+				}
+				if got != nil {
+					compareGrid(ht, "clone", got, want)
+				}
+				if r == b.Bounds() {
+					compareGrid(ht, "Clone", b.Clone(), m)
+				}
+			case 11:
+				sw, sh := n(ht, 1, 12), n(ht, 1, 6)
+				scr := NewScreenBuffer(sw, sh)
+				area := Rect(n(ht, -2, sw), n(ht, -2, sh), n(ht, 0, w+1), n(ht, 0, h+1))
+				note(ht, "Draw onto %dx%d at %v", sw, sh, area)
+				b.Draw(scr, area)
+				dst := newGrid(sw, sh)
+				if !area.Empty() && area.Overlaps(scr.Bounds()) {
+					m.drawInto(dst, 0, 0, area.Min.X, area.Min.Y, area.Dx(), area.Dy())
+				}
+				compareGrid(ht, "Draw target", scr.Buffer, dst)
+			default:
+				// Line accessors.
+				y := n(ht, -1, h)
+				l := b.Line(y)
+				if (l == nil) != (y < 0 || y >= h) {
+					fail(ht, "Line(%d) nil-ness %v for height %d", y, l == nil, h)
+				}
+				if l != nil {
+					if got, want := l.String(), m.lineString(y); got != want {
+						fail(ht, "Line(%d).String() = %q, model %q", y, got, want)
+					}
+					if l.At(-1) != nil || l.At(w) != nil || (w > 0 && l.At(0) != &l[0]) {
+						fail(ht, "Line.At out of contract")
+					}
+				}
+			}
+		}
+		if hasOrphan(b) {
+			fail(ht, "broken wide cell structure:\n%s", dumpBuffer(b))
+		}
+		count("ok")
+	})
+}
