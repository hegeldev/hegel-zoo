+package uv_test
+
+// Narrow properties for the recorded renderer and screen bugs (ultraviolet/24, /25 and /27 to
+// /34): each draws its bug's shape directly and fails by default, naming the shape; under
+// HEGEL_NO_KNOWN=1 it draws the region past the shape and passes.
+
+import (
+	"bytes"
+	"fmt"
+	"image/color"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/colorprofile"
+	uv "github.com/charmbracelet/ultraviolet"
