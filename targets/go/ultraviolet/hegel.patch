+// ---------------------------------------------------------------- ultraviolet/16
+
+// withST spells a reply's terminator as ESC \ (OSC replies may use BEL).
+func withST(e encoded) encoded {
+	if strings.HasSuffix(e.seq, "\a") {
+		e.seq = strings.TrimSuffix(e.seq, "\a") + "\x1b\\"
+	}
+	return e
+}
+
+// cutStrings: an ST-terminated reply cut between the ESC and the \ of its terminator (the
+// region of ultraviolet/16); under HEGEL_NO_KNOWN=1 cut anywhere else.
+var cutStrings = hegel.Composite(func(tc hegel.TestCase) cutReport {
+	e := withST(hegel.Draw(tc, weighted(
+		choice[encoded]{2, colourReports},
+		choice[encoded]{1, clipboardReports},
+		choice[encoded]{1, capabilityReports},
+		choice[encoded]{1, versionReports},
+		choice[encoded]{1, stringReports},
+		choice[encoded]{1, graphicsReports},
+	)))
+	pos := hegel.Draw(tc, positions)
+	return cutReport{e, shaped(len(e.seq)-2, pos%(len(e.seq)-2))} // cut() adds one
+})
+
+// TestHegelStringTerminatorsSurviveReadBoundaries: a reply whose ESC \ terminator is split
+// across two reads is still the reply.
+func TestHegelStringTerminatorsSurviveReadBoundaries(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cutStrings)
+		checkCutReport(ht, c.e, c.cut())
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/17
+
+// altCSIKey is an alt-modified CSI key (ESC then the CSI sequence) and a read boundary: after
+// ESC ESC [ (the region of ultraviolet/17), or anywhere else under HEGEL_NO_KNOWN=1.
+type altCSIKey struct {
+	inner encoded
+	pos   int
+}
+
+func (a altCSIKey) seq() string { return "\x1b" + a.inner.seq }
+
+func (a altCSIKey) want() []Event {
+	k := a.inner.want[0].(KeyPressEvent)
+	k.Mod |= ModAlt
+	return []Event{k}
+}
+
+// cut: 3 by default; otherwise 1, 2 or 4 to len-1.
+func (a altCSIKey) cut() int {
+	if !noKnown {
+		return 3
+	}
+	others := []int{1, 2}
+	for i := 4; i < len(a.seq()); i++ {
+		others = append(others, i)
+	}
+	return at(others, a.pos)
+}
+
+func (a altCSIKey) GoString() string { return fmt.Sprintf("alt+%#v cut at %d", a.inner, a.cut()) }
+
+var altCSIKeys = hegel.Composite(func(tc hegel.TestCase) altCSIKey {
+	return altCSIKey{
+		inner: hegel.Draw(tc, hegel.OneOf(hegel.Map(csiFinals, csiFuncPlain), hegel.Map(tildeIDs, tildePlain))),
+		pos:   hegel.Draw(tc, positions),
+	}
+})
+
+// TestHegelEscEscBracketWaitsAtAReadBoundary: an alt-modified CSI key cut into two reads is
+// still the alt key: ESC ESC [ at the end of a read waits for the rest.
+func TestHegelEscEscBracketWaitsAtAReadBoundary(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		a := hegel.Draw(ht, altCSIKeys)
+		seq, cut := a.seq(), a.cut()
+		got := scanChunked(newScanner(0, "dumb", false), []byte(seq), []int{cut})
+		if want := a.want(); !reflect.DeepEqual(got, want) {
+			shape := ""
+			if cut == 3 {
+				shape = "ultraviolet/17"
+			}
+			mismatch(ht, shape, "%q read as %q + %q gives\n    %s\n  want\n    %s", seq, seq[:cut], seq[cut:], eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
