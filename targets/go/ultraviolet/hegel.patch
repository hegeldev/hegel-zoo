+// TestHegelTerminalReaderHonoursItsLegacyOptions: a TerminalReader with Legacy set decodes a
+// byte as an EventDecoder with the same Legacy does.
+func TestHegelTerminalReaderHonoursItsLegacyOptions(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, readerCases)
+		rd := NewTerminalReader(bytes.NewReader(nil), "xterm")
+		rd.Legacy = c.flags
+		p := EventDecoder{Legacy: c.flags}
+		shape := ""
+		if c.flags != 0 {
+			shape = "ultraviolet/2"
+		}
+		for _, b := range c.keys {
+			_, want := p.Decode([]byte{b})
+			_, got := rd.eventScanner.scanEvents([]byte{b}, true)
+			if !reflect.DeepEqual(flatten(got), flatten([]Event{want})) {
+				mismatch(ht, shape, "reader with Legacy %#b reads %q as\n    %s\n  the decoder with the same Legacy gives\n    %s", c.flags, b, eventsString(flatten(got)), eventString(want))
+			}
+		}
+		count("ok")
+	})
+}
