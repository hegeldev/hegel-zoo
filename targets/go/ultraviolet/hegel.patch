+// TestHegelLinesRenderWhatTheyHold: a rendered line replayed onto a terminal row holds the
+// line's cells, styles and links, and Buffer.Render is Line.Render line by line.
+func TestHegelLinesRenderWhatTheyHold(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, renderCases)
+		w, h := c.w, c.h
+		b := NewBuffer(w, h)
+		m := newGrid(w, h)
+		var seen []string
+		for _, s := range c.sets {
+			x, y := s.x%w, s.y%h
+			if noKnown && s.cell != nil {
+				// The cell lands where it covers no other wide cell's head.
+				x = at(m.clearColumns(y, s.cell.Width, 0, w-1), s.x)
+			}
+			shape := ""
+			if s.cell != nil && m.coversWideHead(x, y, s.cell.Width) {
+				shape = "ultraviolet/22" // a wide cell written over another's head leaves an orphan
+			}
+			b.SetCell(x, y, s.cell)
+			m.setCell(x, y, s.cell)
+			if shape != "" {
+				count(shape + "-shaped")
+			}
+			seen = append(seen, shape)
+		}
+		shape := shapes(seen...)
+		out := b.Render()
+		note(ht, "rendered %q", out)
+		lines := strings.Split(out, "\n")
+		if len(lines) != h {
+			mismatch(ht, shape, "Render() has %d lines, buffer %d: %q", len(lines), h, out)
+		}
+		for y := 0; y < h; y++ {
+			l := b.Line(y)
+			if got := l.Render(); got != lines[y] {
+				mismatch(ht, shape, "Line(%d).Render() = %q, Buffer.Render line %q", y, got, lines[y])
+			}
+			row := parseRendered(lines[y], w)
+			for x := 0; x < w; x++ {
+				c := l.At(x)
+				mc := row[x]
+				// A plain blank may come back as a blank with the pen still set only if
+				// the renderer left the pen on; that is exactly what the check catches.
+				if !sameCell(c, mc) {
+					mismatch(ht, shape, "line %d cell %d = %s, rendered %q comes back as {%q w%d %s %v}", y, x, cellString(c), lines[y], mc.s, mc.w, styleString(mc.st), mc.ln)
+				}
+			}
+			plain := ansi.Strip(lines[y])
+			if got, want := strings.TrimRight(plain, " "), strings.TrimRight(l.String(), " "); got != want {
+				mismatch(ht, shape, "line %d: Strip(Render) = %q, String() = %q", y, got, want)
+			}
+			if sw := cellMethod.StringWidth(plain); sw != w {
+				mismatch(ht, shape, "line %d renders %d columns, want %d: %q", y, sw, w, lines[y])
+			}
+		}
+		// Cell constructors.
+		g := c.grapheme
+		if c := NewCell(cellMethod, g); c.Content != g || c.Width != cellMethod.StringWidth(g) || c.IsZero() {
+			fail(ht, "NewCell(%q) = %s", g, cellString(c))
+		}
+		if c := NewCell(cellMethod, " "); !c.Equal(&EmptyCell) {
+			fail(ht, "NewCell(\" \") = %s", cellString(c))
+		}
+		if c := NewCell(cellMethod, ""); !c.IsZero() {
+			fail(ht, "NewCell(\"\") = %s", cellString(c))
+		}
+		count("ok")
+	})
+}
