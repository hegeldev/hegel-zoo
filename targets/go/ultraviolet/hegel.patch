+package uv
+
+// The second slice of go/ultraviolet: the cell buffer (Line, Buffer, RenderBuffer,
+// ScreenBuffer), the Style SGR encoder/differ and the line renderer, against the grid model
+// carried over from go/cellbuf. The operations of a case are drawn as a list of records and
+// applied with their positions taken modulo the live size; an operation whose shape is that of
+// a recorded bug (a wide cell moved, cut or overwritten: ultraviolet/20 to /23) runs and the
+// disagreement names the bug; under HEGEL_NO_KNOWN=1 it is counted and skipped instead.
+
+import (
+	"fmt"
+	"image/color"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- cell generators
+
+var (
+	narrowGraphemes = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "ก้"}
+	wideGraphemes   = []string{"世", "界", "中", "文", "日", "本", "😃", "🫧", "Ａ"}
+)
+
+// cellMethod is the width method every cell in this file is built with.
+var cellMethod WidthMethod = ansi.WcWidth
+
+// graphemesOf: a narrow grapheme, or a wide one three times in ten when allowed.
+func graphemesOf(allowWide bool) hegel.Generator[string] {
+	narrow := hegel.SampledFrom(narrowGraphemes)
+	if !allowWide {
+		return narrow
+	}
+	return weighted(choice[string]{70, narrow}, choice[string]{30, hegel.SampledFrom(wideGraphemes)})
+}
+
+var (
+	graphemes       = graphemesOf(true)
+	narrowGraphemeG = graphemesOf(false)
+)
+
+// colors: none, a basic colour, an extended colour or a true colour.
+var colors = weighted(
+	choice[color.Color]{1, hegel.Just[color.Color](nil)},
+	choice[color.Color]{1, hegel.Map(hegel.Integers(0, 15), func(n int) color.Color { return ansi.BasicColor(n) })},
+	choice[color.Color]{1, hegel.Map(hegel.Integers(16, 255), func(n int) color.Color { return ansi.ExtendedColor(n) })},
+	choice[color.Color]{1, hegel.Map(hegel.Binary(3, 3), func(b []byte) color.Color { return color.RGBA{R: b[0], G: b[1], B: b[2], A: 0xff} })},
+)
+
+// attrs: any attribute set, or a single attribute half the time.
+var attrs = weighted(
+	choice[uint8]{50, hegel.Map(hegel.Integers(0, 255), func(n int) uint8 { return uint8(n) })},
+	choice[uint8]{50, hegel.Map(hegel.Integers(0, 7), func(n int) uint8 { return 1 << n })},
+)
+
+// styles: the zero style four times in ten; otherwise attributes, an underline style three
+// times in ten, colours, and an underline colour once in five.
+var styles = maybe(60, hegel.Composite(func(tc hegel.TestCase) Style {
+	return Style{
+		Attrs:          hegel.Draw(tc, attrs),
+		Underline:      Underline(hegel.Draw(tc, maybe(30, hegel.Integers(0, 5)))),
+		Fg:             hegel.Draw(tc, colors),
+		Bg:             hegel.Draw(tc, colors),
+		UnderlineColor: hegel.Draw(tc, maybe(20, colors)),
+	}
+}))
+
+// links: none four times in five; otherwise a URL and, three times in ten, an id.
+var links = maybe(20, hegel.Composite(func(tc hegel.TestCase) Link {
+	return Link{
+		URL:    fmt.Sprintf("https://example.com/%d", hegel.Draw(tc, hegel.Integers(0, 9))),
+		Params: hegel.Draw(tc, maybe(30, hegel.Map(hegel.Integers(0, 9), func(n int) string { return fmt.Sprintf("id=%d", n) }))),
+	}
+}))
+
+// styledCellsWith: a cell of one of the graphemes with a style and a link from ln.
+func styledCellsWith(g hegel.Generator[string], ln hegel.Generator[Link]) hegel.Generator[*Cell] {
+	return hegel.Composite(func(tc hegel.TestCase) *Cell {
+		c := NewCell(cellMethod, hegel.Draw(tc, g))
+		c.Style = hegel.Draw(tc, styles)
+		c.Link = hegel.Draw(tc, ln)
+		return c
+	})
+}
+
+func styledCells(g hegel.Generator[string]) hegel.Generator[*Cell] { return styledCellsWith(g, links) }
+
+// cellsWith: a blank (nil) once in four; otherwise a cell of one of the graphemes (a space once
+// in ten) with a style and a link from ln.
+func cellsWith(g hegel.Generator[string], ln hegel.Generator[Link]) hegel.Generator[*Cell] {
+	return maybe(75, styledCellsWith(weighted(choice[string]{90, g}, choice[string]{10, hegel.Just(" ")}), ln))
+}
+
+func cellsOf(g hegel.Generator[string]) hegel.Generator[*Cell] { return cellsWith(g, links) }
+
+var (
+	cells       = cellsOf(graphemes)
+	narrowCells = cellsOf(narrowGraphemeG)
+)
+
+func styleString(s Style) string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b uls:%d}", s.Fg, s.Bg, s.UnderlineColor, s.Attrs, s.Underline)
+}
+
+func cellString(c *Cell) string {
+	if c == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%q w%d %s %v}", c.Content, c.Width, styleString(c.Style), c.Link)
+}
+
+// ---------------------------------------------------------------- the grid model
+
+// ---------------------------------------------------------------- the grid model
+
+// mcell is the model's cell: a placeholder is the zero mcell (w == 0, s == "").
+type mcell struct {
+	s  string
+	w  int
+	st Style
+	ln Link
+}
+
+var mblank = mcell{s: " ", w: 1}
+
+func (c mcell) isZero() bool { return c.w == 0 && c.s == "" && c.st.IsZero() && c.ln.IsZero() }
+
+func (c mcell) isBlank() bool { return c.w == 1 && c.s == " " && c.st.IsZero() && c.ln.IsZero() }
+
+type mgrid struct {
+	w, h int
+	g    [][]mcell
+}
+
+func newGrid(w, h int) *mgrid {
+	m := &mgrid{}
+	m.resize(w, h)
+	return m
+}
+
+// resize follows Buffer.Resize: lines keep their cells, new columns and lines are blank; a
+// buffer without lines has width 0.
+func (m *mgrid) resize(w, h int) {
+	if w == m.w && h == m.h {
+		return
+	}
+	for y := range m.g {
+		if w > len(m.g[y]) {
+			for x := len(m.g[y]); x < w; x++ {
+				m.g[y] = append(m.g[y], mblank)
+			}
+		} else {
+			m.g[y] = m.g[y][:w]
+		}
+	}
+	for len(m.g) < h {
+		row := make([]mcell, w)
+		for x := range row {
+			row[x] = mblank
+		}
+		m.g = append(m.g, row)
+	}
+	m.g = m.g[:h]
+	m.h = h
+	m.w = w
+	if h == 0 {
+		m.w = 0
+	}
+}
+
+// splitWide blanks the wide cell covering column x, keeping its style and link.
+func (m *mgrid) splitWide(x, y int) {
+	if x < 0 || x >= m.w {
+		return
+	}
+	c := m.g[y][x]
+	head := -1
+	if c.w > 1 {
+		head = x
+	} else if c.isZero() {
+		for j := 1; x-j >= 0; j++ {
+			if wc := m.g[y][x-j]; wc.w > 1 {
+				if j < wc.w {
+					head = x - j
+				}
+				break
+			}
+		}
+	}
+	if head < 0 {
+		return
+	}
+	hc := m.g[y][head]
+	for k := 0; k < hc.w && head+k < m.w; k++ {
+		m.g[y][head+k] = mcell{s: " ", w: 1, st: hc.st, ln: hc.ln}
+	}
+}
+
+// coversWideHead reports whether writing a cell of width w at x would overwrite the head of
+// another wide cell with a placeholder (its own placeholder is then left orphaned).
+func (m *mgrid) coversWideHead(x, y, w int) bool {
+	if y < 0 || y >= m.h {
+		return false
+	}
+	for j := 1; j < w && x+j < m.w; j++ {
+		if m.g[y][x+j].w > 1 {
+			return true
+		}
+	}
+	return false
+}
+
+// hasWide reports whether the rectangle contains a wide cell head or placeholder.
+func (m *mgrid) hasWide(r Rectangle) bool {
+	for y := max(r.Min.Y, 0); y < min(r.Max.Y, m.h); y++ {
+		for x := max(r.Min.X, 0); x < min(r.Max.X, m.w); x++ {
+			if c := m.g[y][x]; c.w != 1 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// cutsWide reports whether a vertical edge of the rectangle runs through a wide cell in one
+// of its rows (head on one side, placeholder on the other).
+func (m *mgrid) cutsWide(r Rectangle) bool {
+	for y := max(r.Min.Y, 0); y < min(r.Max.Y, m.h); y++ {
+		for x := 0; x < m.w; x++ {
+			c := m.g[y][x]
+			if c.w > 1 {
+				for _, edge := range []int{r.Min.X, r.Max.X} {
+					if x < edge && edge < x+c.w {
+						return true
+					}
+				}
+			}
+		}
+	}
+	return false
+}
+
+func (m *mgrid) setCell(x, y int, c *Cell) {
+	if y < 0 || y >= m.h || x < 0 || x >= m.w {
+		return
+	}
+	w := 1
+	mc := mblank
+	if c != nil {
+		w = c.Width
+		mc = mcell{s: c.Content, w: c.Width, st: c.Style, ln: c.Link}
+	}
+	m.splitWide(x, y)
+	if c != nil && x+w > m.w {
+		for i := 0; i < w && x+i < m.w; i++ {
+			m.g[y][x+i] = mcell{s: " ", w: 1, st: c.Style, ln: c.Link}
+		}
+		return
+	}
+	m.g[y][x] = mc
+	for j := 1; j < w && x+j < m.w; j++ {
+		m.g[y][x+j] = mcell{}
+	}
+}
+
+func (m *mgrid) fillRect(c *Cell, r Rectangle) {
+	cw := 1
+	if c != nil && c.Width > 1 {
+		cw = c.Width
+	}
+	for y := r.Min.Y; y < r.Max.Y; y++ {
+		for x := r.Min.X; x < r.Max.X; x += cw {
+			m.setCell(x, y, c)
+		}
+	}
+}
+
+func (m *mgrid) fillLine(y int, x0, x1 int, c *Cell) {
+	for x := x0; x < x1; x++ {
+		m.setCell(x, y, c)
+	}
+}
+
+func (m *mgrid) insertLine(y, nl int, c *Cell, r Rectangle) {
+	if nl <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h {
+		return
+	}
+	nl = min(nl, r.Max.Y-y)
+	for i := r.Max.Y - 1; i >= y+nl; i-- {
+		copy(m.g[i][r.Min.X:r.Max.X], m.g[i-nl][r.Min.X:r.Max.X])
+	}
+	for i := y; i < y+nl; i++ {
+		m.fillLine(i, r.Min.X, r.Max.X, c)
+	}
+}
+
+func (m *mgrid) deleteLine(y, nl int, c *Cell, r Rectangle) {
+	if nl <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h {
+		return
+	}
+	nl = min(nl, r.Max.Y-y)
+	for dst := y; dst < r.Max.Y-nl; dst++ {
+		copy(m.g[dst][r.Min.X:r.Max.X], m.g[dst+nl][r.Min.X:r.Max.X])
+	}
+	for i := r.Max.Y - nl; i < r.Max.Y; i++ {
+		m.fillLine(i, r.Min.X, r.Max.X, c)
+	}
+}
+
+// fillCell is the model cell for the fill argument of the shift operations.
+func fillCell(c *Cell) mcell {
+	if c == nil {
+		return mblank
+	}
+	return mcell{s: c.Content, w: c.Width, st: c.Style, ln: c.Link}
+}
+
+// normalize applies the terminal rule to a shifted row: a wide cell that lost its
+// placeholders or a placeholder that lost its head is erased (blanked, keeping the style).
+func (m *mgrid) normalize(y int) {
+	row := m.g[y]
+	for x := 0; x < len(row); {
+		c := row[x]
+		switch {
+		case c.w > 1:
+			ok := x+c.w <= len(row)
+			for j := 1; ok && j < c.w; j++ {
+				ok = row[x+j].isZero()
+			}
+			if !ok {
+				for j := 0; j < c.w && x+j < len(row); j++ {
+					if j == 0 || row[x+j].isZero() {
+						row[x+j] = mcell{s: " ", w: 1, st: c.st, ln: c.ln}
+					}
+				}
+				x++
+				continue
+			}
+			x += c.w
+		case c.isZero():
+			row[x] = mblank
+			x++
+		default:
+			x++
+		}
+	}
+}
+
+// insertCell follows ICH: the cells from x move right as they are, the vacated columns take
+// the fill cell.
+func (m *mgrid) insertCell(x, y, nc int, c *Cell, r Rectangle) {
+	if nc <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h || x < r.Min.X || x >= r.Max.X || x >= m.w {
+		return
+	}
+	nc = min(nc, r.Max.X-x)
+	for i := r.Max.X - 1; i >= x+nc && i-nc >= r.Min.X; i-- {
+		m.g[y][i] = m.g[y][i-nc]
+	}
+	for i := x; i < min(x+nc, r.Max.X); i++ {
+		m.g[y][i] = fillCell(c)
+	}
+	m.normalize(y)
+}
+
+// deleteCell follows DCH: the cells after the deleted ones move left as they are, the vacated
+// columns at the right edge take the fill cell.
+func (m *mgrid) deleteCell(x, y, nc int, c *Cell, r Rectangle) {
+	if nc <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h || x < r.Min.X || x >= r.Max.X || x >= m.w {
+		return
+	}
+	nc = min(nc, r.Max.X-x)
+	for i := x; i < r.Max.X-nc; i++ {
+		m.g[y][i] = m.g[y][i+nc]
+	}
+	for i := r.Max.X - nc; i < r.Max.X; i++ {
+		m.g[y][i] = fillCell(c)
+	}
+	m.normalize(y)
+}
+
+// cloneArea follows Buffer.CloneArea: nil outside the bounds, otherwise every non-placeholder
+// cell written into a fresh grid.
+func (m *mgrid) cloneArea(r Rectangle) *mgrid {
+	if !r.In(Rect(0, 0, m.w, m.h)) {
+		return nil
+	}
+	c := newGrid(r.Dx(), r.Dy())
+	m.drawInto(c, r.Min.X, r.Min.Y, -r.Min.X, -r.Min.Y, r.Dx(), r.Dy())
+	return c
+}
+
+// drawInto writes the w×h region of m at (sx, sy) into dst at (sx+dx, sy+dy).
+func (m *mgrid) drawInto(dst *mgrid, sx, sy, dx, dy, w, h int) {
+	for y := sy; y < sy+h; y++ {
+		for x := sx; x < sx+w; {
+			if y < 0 || y >= m.h || x < 0 || x >= m.w {
+				x++
+				continue
+			}
+			c := m.g[y][x]
+			if c.isZero() {
+				x++
+				continue
+			}
+			dst.setCell(x+dx, y+dy, &Cell{Content: c.s, Width: c.w, Style: c.st, Link: c.ln})
+			x += max(c.w, 1)
+		}
+	}
+}
+
+// lineString follows Line.String: placeholders vanish, plain blanks are kept back until
+// something follows them, styled blanks are written.
+func (m *mgrid) lineString(y int) string {
+	var sb strings.Builder
+	pending := 0
+	for _, c := range m.g[y] {
+		if c.isZero() {
+			continue
+		}
+		if c.isBlank() {
+			pending++
+			continue
+		}
+		sb.WriteString(strings.Repeat(" ", pending))
+		pending = 0
+		sb.WriteString(c.s)
+	}
+	return sb.String()
+}
+
+func (m *mgrid) String() string {
+	lines := make([]string, m.h)
+	for y := range lines {
+		lines[y] = m.lineString(y)
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (m *mgrid) dump() string {
+	var sb strings.Builder
+	for y := 0; y < m.h; y++ {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range m.g[y] {
+			fmt.Fprintf(&sb, " {%q w%d}", c.s, c.w)
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+func dumpBuffer(b *Buffer) string {
+	var sb strings.Builder
+	for y, l := range b.Lines {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range l {
+			fmt.Fprintf(&sb, " {%q w%d}", c.Content, c.Width)
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+// hasOrphan reports whether the buffer holds a placeholder not covered by a wide head, or a
+// wide head whose placeholders do not fit or are missing.
+func hasOrphan(b *Buffer) bool {
+	for _, l := range b.Lines {
+		covered := 0
+		for x, c := range l {
+			if covered > 0 {
+				covered--
+				if !c.IsZero() {
+					return true
+				}
+				continue
+			}
+			if c.IsZero() {
+				return true
+			}
+			if c.Width > 1 {
+				if x+c.Width > len(l) {
+					return true
+				}
+				covered = c.Width - 1
+			}
+		}
+	}
+	return false
+}
+
+func sameCell(c *Cell, mc mcell) bool {
+	return c != nil && c.Content == mc.s && c.Width == mc.w && c.Style.Equal(&mc.st) && c.Link == mc.ln
+}
+
+// compareGrid checks the buffer against the model cell by cell.
+// compareGrid: the buffer holds what the model holds; a disagreement names the shape of the
+// recorded bug the last operation had ("" for none).
+func compareGrid(ht *hegel.T, what, shape string, b *Buffer, m *mgrid) {
+	if b.Width() != m.w || b.Height() != m.h {
+		mismatch(ht, shape, "%s: buffer %dx%d, model %dx%d", what, b.Width(), b.Height(), m.w, m.h)
+	}
+	for y := 0; y < m.h; y++ {
+		if got := len(b.Lines[y]); got != m.w {
+			mismatch(ht, shape, "%s: line %d has %d cells, width %d", what, y, got, m.w)
+		}
+		for x := 0; x < m.w; x++ {
+			c := b.CellAt(x, y)
+			mc := m.g[y][x]
+			if !sameCell(c, mc) {
+				mismatch(ht, shape, "%s: cell (%d,%d) = %s, model {%q w%d %s %v}\nbuffer:\n%s\nmodel:\n%s", what, x, y, cellString(c), mc.s, mc.w, styleString(mc.st), mc.ln, dumpBuffer(b), m.dump())
+			}
+		}
+	}
+	if got, want := b.String(), m.String(); got != want {
+		mismatch(ht, shape, "%s: String() = %q, model %q\nbuffer:\n%s", what, got, want, dumpBuffer(b))
+	}
+	if got, want := b.Bounds(), Rect(0, 0, m.w, m.h); got != want {
+		mismatch(ht, shape, "%s: Bounds() = %v, want %v", what, got, want)
+	}
+}
+
+// ---------------------------------------------------------------- operations
+
+// rectSpec is a rectangle drawn as positions and resolved against the live size.
+type rectSpec struct {
+	x, y, w, h int
+}
+
+var rectSpecs = hegel.Composite(func(tc hegel.TestCase) rectSpec {
+	return rectSpec{hegel.Draw(tc, positions), hegel.Draw(tc, positions), hegel.Draw(tc, positions), hegel.Draw(tc, positions)}
+})
+
+// in is a rectangle inside a w by h area (empty when the area is).
+func (r rectSpec) in(w, h int) Rectangle {
+	x0, y0 := r.x%max(w, 1), r.y%max(h, 1)
+	return Rect(x0, y0, r.w%(w-x0+1), r.h%(h-y0+1))
+}
+
+// loose is a rectangle that may stick out of a w by h area on every side.
+func (r rectSpec) loose(w, h int) Rectangle {
+	return Rect(-2+r.x%(w+3), -2+r.y%(h+3), r.w%(w+3), r.h%(h+3))
+}
+
+// gridOps is what Buffer and RenderBuffer share.
+type gridOps interface {
+	SetCell(x, y int, c *Cell)
+	FillArea(c *Cell, area Rectangle)
+	ClearArea(area Rectangle)
+	InsertLineArea(y, n int, c *Cell, area Rectangle)
+	DeleteLineArea(y, n int, c *Cell, area Rectangle)
+	InsertCellArea(x, y, n int, c *Cell, area Rectangle)
+	DeleteCellArea(x, y, n int, c *Cell, area Rectangle)
+	Resize(width, height int)
+}
+
+func snapshot(b *Buffer) [][]Cell {
+	s := make([][]Cell, len(b.Lines))
+	for y, l := range b.Lines {
+		s[y] = append([]Cell(nil), l...)
+	}
+	return s
+}
+
+// checkTouched verifies that every line whose cells changed is marked touched.
+func checkTouched(ht *hegel.T, what string, rb *RenderBuffer, before [][]Cell) {
+	if rb == nil {
+		return
+	}
+	for y, l := range rb.Lines {
+		changed := y >= len(before) || len(before[y]) != len(l)
+		for x := 0; !changed && x < len(l); x++ {
+			changed = l[x] != before[y][x]
+		}
+		if changed && (y >= len(rb.Touched) || rb.Touched[y] == nil) {
+			fail(ht, "%s: line %d changed but is not touched (Touched %v)\n%s", what, y, rb.Touched, dumpBuffer(rb.Buffer))
+		}
+	}
+}
+
+type opKind int
+
+const (
+	opSetCell opKind = iota
+	opFillArea
+	opClearArea
+	opInsertLine
+	opDeleteLine
+	opInsertCell
+	opDeleteCell
+	opResize
+	opCloneArea
+	opDraw
+	opLine
+)
+
+var opNames = []string{"SetCell", "FillArea", "ClearArea", "InsertLineArea", "DeleteLineArea", "InsertCellArea", "DeleteCellArea", "Resize", "CloneArea", "Draw", "Line"}
+
+// bufOp is one operation on the buffer, its arguments drawn as positions resolved against the
+// live size when applied.
+type bufOp struct {
+	kind    opKind
+	x, y    int      // positions
+	rect    rectSpec // the area
+	loose   bool     // CloneArea: an area that may stick out (once in five)
+	partial bool     // line and cell shifts: the drawn area rather than the whole buffer (twice in five)
+	cell    *Cell    // SetCell, FillArea
+	thin    *Cell    // line and cell shifts: a narrow cell or nil
+	k       int      // lines or cells to shift, 1 to 3
+	nw, nh  int      // Resize and Draw: a size (positions)
+}
+
+func (op bufOp) GoString() string { return opNames[op.kind] }
+
+// thinCells: a narrow cell or nil (the filler of the shifts).
+var thinCells = hegel.Map(narrowCells, thinCell)
+
+// clearColumns lists the columns lo to hi where a cell of the width covers no other wide
+// cell's head (outside ultraviolet/22's region); hi is always in it.
+func (m *mgrid) clearColumns(y, width, lo, hi int) []int {
+	var xs []int
+	for x := lo; x <= hi; x++ {
+		if !m.coversWideHead(x, y, width) {
+			xs = append(xs, x)
+		}
+	}
+	return xs
+}
+
+// clearRows lists the rows holding no wide cell within the rectangle's columns (outside
+// ultraviolet/20's region).
+func (m *mgrid) clearRows(r Rectangle) []int {
+	var ys []int
+	for y := 0; y < m.h; y++ {
+		if !m.hasWide(Rect(r.Min.X, y, r.Dx(), 1)) {
+			ys = append(ys, y)
+		}
+	}
+	return ys
+}
+
+// bufOps: SetCell three times as often as each other operation, each drawing only its own
+// arguments.
+var bufOps = weighted(
+	choice[bufOp]{3, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{kind: opSetCell, x: hegel.Draw(tc, positions), y: hegel.Draw(tc, positions), cell: hegel.Draw(tc, cells)}
+	})},
+	choice[bufOp]{1, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{kind: opFillArea, rect: hegel.Draw(tc, rectSpecs), cell: hegel.Draw(tc, cells)}
+	})},
+	choice[bufOp]{1, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{kind: opClearArea, rect: hegel.Draw(tc, rectSpecs)}
+	})},
+	choice[bufOp]{2, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{
+			kind:    hegel.Draw(tc, hegel.SampledFrom([]opKind{opInsertLine, opDeleteLine})),
+			y:       hegel.Draw(tc, positions),
+			k:       hegel.Draw(tc, hegel.Integers(1, 3)),
+			thin:    hegel.Draw(tc, thinCells),
+			partial: hegel.Draw(tc, chance(40)),
+			rect:    hegel.Draw(tc, rectSpecs),
+		}
+	})},
+	choice[bufOp]{2, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{
+			kind:    hegel.Draw(tc, hegel.SampledFrom([]opKind{opInsertCell, opDeleteCell})),
+			x:       hegel.Draw(tc, positions),
+			y:       hegel.Draw(tc, positions),
+			k:       hegel.Draw(tc, hegel.Integers(1, 3)),
+			thin:    hegel.Draw(tc, thinCells),
+			partial: hegel.Draw(tc, chance(40)),
+			rect:    hegel.Draw(tc, rectSpecs),
+		}
+	})},
+	choice[bufOp]{1, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{kind: opResize, nw: hegel.Draw(tc, positions), nh: hegel.Draw(tc, positions)}
+	})},
+	choice[bufOp]{1, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{kind: opCloneArea, rect: hegel.Draw(tc, rectSpecs), loose: hegel.Draw(tc, chance(20))}
+	})},
+	choice[bufOp]{1, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{kind: opDraw, nw: hegel.Draw(tc, positions), nh: hegel.Draw(tc, positions), rect: hegel.Draw(tc, rectSpecs)}
+	})},
+	choice[bufOp]{1, hegel.Composite(func(tc hegel.TestCase) bufOp {
+		return bufOp{kind: opLine, y: hegel.Draw(tc, positions)}
+	})},
+)
+
+// thinCell keeps a cell of width one, nil for any other.
+func thinCell(c *Cell) *Cell {
+	if c != nil && c.Width != 1 {
+		return nil
+	}
+	return c
+}
+
+// bufCase is a buffer (or a RenderBuffer) and the operations run on it.
+type bufCase struct {
+	w, h   int
+	render bool
+	ops    []bufOp
+}
+
+func (c bufCase) GoString() string {
+	kind := "Buffer"
+	if c.render {
+		kind = "RenderBuffer"
+	}
+	return fmt.Sprintf("%s %dx%d, %d ops %v", kind, c.w, c.h, len(c.ops), c.ops)
+}
+
+var bufCases = hegel.Composite(func(tc hegel.TestCase) bufCase {
+	return bufCase{
+		w:      hegel.Draw(tc, hegel.Integers(1, 10)),
+		h:      hegel.Draw(tc, hegel.Integers(1, 5)),
+		render: hegel.Draw(tc, chance(50)),
+		ops:    hegel.Draw(tc, many(bufOps, 1, 25)),
+	}
+})
+
+// shrinkCutsWide reports whether narrowing the model to nw columns cuts through a wide cell
+// (the shape of ultraviolet/21).
+func (m *mgrid) shrinkCutsWide(nw int) bool {
+	for y := 0; y < m.h; y++ {
+		for x := max(nw-2, 0); x < nw && x < m.w; x++ {
+			if c := m.g[y][x]; c.w > 1 && x+c.w > nw {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// TestHegelBufferFollowsTheGridModel: Buffer and RenderBuffer agree with the grid model after
+// every operation, RenderBuffer marks every changed line touched, and no wide cell is ever
+// left broken.
+func TestHegelBufferFollowsTheGridModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bufCases)
+		var (
+			b   *Buffer
+			rb  *RenderBuffer
+			ops gridOps
+		)
+		if c.render {
+			rb = NewRenderBuffer(c.w, c.h)
+			b, ops = rb.Buffer, rb
+		} else {
+			b = NewBuffer(c.w, c.h)
+			ops = b
+		}
+		m := newGrid(c.w, c.h)
+		compareGrid(ht, "new", "", b, m)
+		var seen []string // the shapes of the operations run
+		for _, op := range c.ops {
+			w, h := m.w, m.h
+			kind := op.kind
+			if w == 0 || h == 0 {
+				kind = opResize // an empty buffer can only be resized back
+			}
+			before := snapshot(b)
+			shape := ""
+			switch kind {
+			case opSetCell:
+				x, y := -1+op.x%(w+2), -1+op.y%(h+2)
+				if noKnown && op.cell != nil {
+					// The cell lands where it covers no other wide cell's head.
+					x = at(m.clearColumns(y, op.cell.Width, -1, w), op.x)
+				}
+				if op.cell != nil && m.coversWideHead(x, y, op.cell.Width) {
+					shape = "ultraviolet/22" // a wide cell written over another's head
+				}
+				note(ht, "SetCell(%d,%d,%s)", x, y, cellString(op.cell))
+				ops.SetCell(x, y, op.cell)
+				m.setCell(x, y, op.cell)
+				compareGrid(ht, "after SetCell", shape, b, m)
+				checkTouched(ht, "after SetCell", rb, before)
+			case opFillArea:
+				r := op.rect.in(w, h)
+				if op.cell != nil && op.cell.Width > 1 && m.hasWide(Rect(r.Min.X, r.Min.Y, r.Dx()+op.cell.Width-1, r.Dy())) {
+					shape = "ultraviolet/22" // wide cells filled over wide cells
+				}
+				if known(shape) {
+					continue
+				}
+				note(ht, "FillArea(%s, %v)", cellString(op.cell), r)
+				ops.FillArea(op.cell, r)
+				m.fillRect(op.cell, r)
+				compareGrid(ht, "after FillArea", shape, b, m)
+				checkTouched(ht, "after FillArea", rb, before)
+			case opClearArea:
+				r := op.rect.in(w, h)
+				note(ht, "ClearArea(%v)", r)
+				ops.ClearArea(r)
+				m.fillRect(nil, r)
+				compareGrid(ht, "after ClearArea", "", b, m)
+				checkTouched(ht, "after ClearArea", rb, before)
+			case opInsertLine, opDeleteLine:
+				r := b.Bounds()
+				if op.partial {
+					r = op.rect.in(w, h)
+				}
+				y := op.y % (h + 1)
+				if m.cutsWide(r) {
+					shape = "ultraviolet/23" // the area's edge runs through a wide cell
+				}
+				if known(shape) {
+					continue
+				}
+				if kind == opInsertLine {
+					note(ht, "InsertLineArea(%d,%d,%s,%v)", y, op.k, cellString(op.thin), r)
+					ops.InsertLineArea(y, op.k, op.thin, r)
+					m.insertLine(y, op.k, op.thin, r)
+				} else {
+					note(ht, "DeleteLineArea(%d,%d,%s,%v)", y, op.k, cellString(op.thin), r)
+					ops.DeleteLineArea(y, op.k, op.thin, r)
+					m.deleteLine(y, op.k, op.thin, r)
+				}
+				compareGrid(ht, "after line shift", shape, b, m)
+				checkTouched(ht, "after line shift", rb, before)
+			case opInsertCell, opDeleteCell:
+				r := b.Bounds()
+				if op.partial {
+					r = op.rect.in(w, h)
+				}
+				x, y := op.x%(w+1), op.y%h
+				if noKnown {
+					// The shift lands on a row holding no wide cell.
+					rows := m.clearRows(r)
+					if len(rows) == 0 {
+						count("ultraviolet/20-skipped")
+						continue
+					}
+					y = at(rows, op.y)
+				}
+				if m.hasWide(Rect(r.Min.X, y, r.Dx(), 1)) {
+					shape = "ultraviolet/20" // a wide cell in the shifted row (InsertCell may show ultraviolet/21's head in the last column too)
+				}
+				if kind == opInsertCell {
+					note(ht, "InsertCellArea(%d,%d,%d,%s,%v)", x, y, op.k, cellString(op.thin), r)
+					ops.InsertCellArea(x, y, op.k, op.thin, r)
+					m.insertCell(x, y, op.k, op.thin, r)
+				} else {
+					note(ht, "DeleteCellArea(%d,%d,%d,%s,%v)", x, y, op.k, cellString(op.thin), r)
+					ops.DeleteCellArea(x, y, op.k, op.thin, r)
+					m.deleteCell(x, y, op.k, op.thin, r)
+				}
+				compareGrid(ht, "after cell shift", shape, b, m)
+				checkTouched(ht, "after cell shift", rb, before)
+			case opResize:
+				nw, nh := op.nw%11, op.nh%6
+				if nw < w && m.shrinkCutsWide(nw) {
+					shape = "ultraviolet/21" // the new width cuts through a wide cell
+				}
+				if known(shape) {
+					continue
+				}
+				note(ht, "Resize(%d,%d)", nw, nh)
+				ops.Resize(nw, nh)
+				m.resize(nw, nh)
+				compareGrid(ht, "after Resize", shape, b, m)
+			case opCloneArea:
+				r := op.rect.in(w, h)
+				if op.loose {
+					r = op.rect.loose(w, h)
+				}
+				note(ht, "CloneArea(%v)", r)
+				got, want := b.CloneArea(r), m.cloneArea(r)
+				if (got == nil) != (want == nil) {
+					fail(ht, "CloneArea(%v) nil-ness %v, model %v", r, got == nil, want == nil)
+				}
+				if got != nil {
+					compareGrid(ht, "clone", "", got, want)
+				}
+				if r == b.Bounds() {
+					compareGrid(ht, "Clone", "", b.Clone(), m)
+				}
+			case opDraw:
+				sw, sh := 1+op.nw%12, 1+op.nh%6
+				scr := NewScreenBuffer(sw, sh)
+				area := Rect(-2+op.rect.x%(sw+3), -2+op.rect.y%(sh+3), op.rect.w%(w+2), op.rect.h%(h+2))
+				note(ht, "Draw onto %dx%d at %v", sw, sh, area)
+				b.Draw(scr, area)
+				dst := newGrid(sw, sh)
+				if !area.Empty() && area.Overlaps(scr.Bounds()) {
+					m.drawInto(dst, 0, 0, area.Min.X, area.Min.Y, area.Dx(), area.Dy())
+				}
+				compareGrid(ht, "Draw target", "", scr.Buffer, dst)
+			case opLine:
+				y := -1 + op.y%(h+2)
+				l := b.Line(y)
+				if (l == nil) != (y < 0 || y >= h) {
+					fail(ht, "Line(%d) nil-ness %v for height %d", y, l == nil, h)
+				}
+				if l != nil {
+					if got, want := l.String(), m.lineString(y); got != want {
+						fail(ht, "Line(%d).String() = %q, model %q", y, got, want)
+					}
+					if l.At(-1) != nil || l.At(w) != nil || (w > 0 && l.At(0) != &l[0]) {
+						fail(ht, "Line.At out of contract")
+					}
+				}
+			}
+			if shape != "" {
+				count(shape + "-shaped")
+			}
+			seen = append(seen, shape)
+		}
+		if hasOrphan(b) {
+			mismatch(ht, shapes(seen...), "broken wide cell structure:\n%s", dumpBuffer(b))
+		}
+		count("ok")
+	})
+}
