+// ---------------------------------------------------------------- ultraviolet/11
+
+// escEntries: the ESC and ESC ESC entries of a table built with CtrlOpenBracket set (the
+// region of ultraviolet/11) and any other legacy flags; under HEGEL_NO_KNOWN=1 with it clear.
+var escEntries = hegel.Composite(func(tc hegel.TestCase) tableCase {
+	flags := hegel.Draw(tc, legacyEncodings)
+	flags = shaped(flags|flagCtrlOpenBracket, flags&^flagCtrlOpenBracket)
+	kt := keyTable{flags, "xterm", false}
+	table, _, _ := kt.build()
+	seq := hegel.Draw(tc, hegel.SampledFrom([]string{"\x1b", "\x1b\x1b"}))
+	return tableCase{kt, seq, table[seq]}
+})
