+		p := hegel.Draw(ht, pastedKeys)
+		input, cuts := p.input(), p.cuts()
+		got := scanChunked(newScanner(0, "dumb", false), []byte(input), cuts)
+		want := []Event{PasteStartEvent{}, PasteEvent{Content: p.text()}, PasteEndEvent{}}
+		if !reflect.DeepEqual(got, want) {
+			mismatch(ht, shaped("ultraviolet/19", ""), "paste %q read with cuts at %v gives\n    %s\n  want\n    %s", input, cuts, eventsString(got), eventsString(want))
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/20 to /23
+
+// wideGrid is a buffer holding narrow cells and one wide cell in one row (the region of the
+// wide-cell bugs); under HEGEL_NO_KNOWN=1 that cell is narrow too.
+type wideGrid struct {
+	w, h   int
+	y      int     // position of the row
+	x      int     // position of the wide cell's head
+	filler []*Cell // the row's other cells, cyclic
+	wide   *Cell
+}
+
+// row is the row of the wide cell; head its column, from 1 to w-4 so that a placeholder and
+// two more columns follow it.
+func (g wideGrid) row() int  { return g.y % g.h }
+func (g wideGrid) head() int { return 1 + g.x%(g.w-4) }
+
+// shape names the bug whose region the grid is in when the cell is wide.
+func (g wideGrid) shape(bug string) string {
+	if g.wide.Width > 1 {
+		return bug
+	}
+	return ""
+}
+
+func (g wideGrid) GoString() string {
+	return fmt.Sprintf("%dx%d with %s at (%d,%d)", g.w, g.h, cellString(g.wide), g.head(), g.row())
+}
+
+// build makes the buffer and its model.
+func (g wideGrid) build() (*Buffer, *mgrid) {
+	b, m := NewBuffer(g.w, g.h), newGrid(g.w, g.h)
+	y, hx := g.row(), g.head()
+	for x := 0; x < g.w; x++ {
+		if x != hx && x != hx+1 {
+			b.SetCell(x, y, at(g.filler, x))
+			m.setCell(x, y, at(g.filler, x))
+		}
+	}
+	b.SetCell(hx, y, g.wide)
+	m.setCell(hx, y, g.wide)
+	return b, m
+}
+
+var (
+	wideCells   = styledCells(hegel.SampledFrom(wideGraphemes))
+	singleCells = hegel.Map(styledCells(narrowGraphemeG), thinCell)
+)
+
+// wideGridsOf: a 6 to 10 wide grid with its row of cells, the height drawn from heights.
+func wideGridsOf(heights hegel.Generator[int]) hegel.Generator[wideGrid] {
+	return hegel.Composite(func(tc hegel.TestCase) wideGrid {
+		return wideGrid{
+			w:      hegel.Draw(tc, hegel.Integers(6, 10)),
+			h:      hegel.Draw(tc, heights),
+			y:      hegel.Draw(tc, positions),
+			x:      hegel.Draw(tc, positions),
+			filler: hegel.Draw(tc, many(thinCells, 1, 10)),
+			wide:   hegel.Draw(tc, shaped(wideCells, singleCells)),
+		}
+	})
+}
+
+// checkWideCells: the buffer agrees with the model and holds no torn wide cell (a head
+// without its placeholder or room, or a placeholder without its head).
+func checkWideCells(ht *hegel.T, what, shape string, b *Buffer, m *mgrid) {
+	compareGrid(ht, what, shape, b, m)
+	if hasOrphan(b) {
+		mismatch(ht, shape, "%s: a wide cell is torn:\n%s", what, dumpBuffer(b))
+	}
+	count("ok")
+}
+
+// cellShift is a wide grid and an InsertCellArea or DeleteCellArea that moves the wide cell
+// along its row, keeping it inside.
+type cellShift struct {
+	g      wideGrid
+	insert bool
+	x, k   int // positions
+}
+
+func (s cellShift) GoString() string {
+	op := "DeleteCellArea"
+	if s.insert {
+		op = "InsertCellArea"
+	}
+	return fmt.Sprintf("%s on %#v", op, s.g)
+}
+
+var cellShifts = hegel.Composite(func(tc hegel.TestCase) cellShift {
+	return cellShift{
+		g:      hegel.Draw(tc, wideGridsOf(hegel.Integers(1, 3))),
+		insert: hegel.Draw(tc, chance(50)),
+		x:      hegel.Draw(tc, positions),
+		k:      hegel.Draw(tc, positions),
+	}
+})
+
+// TestHegelCellShiftsMoveWideCellsWhole: inserting or deleting cells before a wide cell moves
+// it whole, head and placeholder together.
+func TestHegelCellShiftsMoveWideCellsWhole(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, cellShifts)
+		b, m := s.g.build()
+		y, hx := s.g.row(), s.g.head()
+		shape := s.g.shape("ultraviolet/20")
+		if s.insert {
+			x, k := s.x%(hx+1), 1+s.k%(s.g.w-hx-3) // the wide cell keeps two columns of room
+			note(ht, "InsertCellArea(%d,%d,%d)", x, y, k)
+			b.InsertCellArea(x, y, k, nil, b.Bounds())
+			m.insertCell(x, y, k, nil, Rect(0, 0, m.w, m.h))
+		} else {
+			x := s.x % hx
+			k := 1 + s.k%(hx-x) // cells before the wide one
+			note(ht, "DeleteCellArea(%d,%d,%d)", x, y, k)
+			b.DeleteCellArea(x, y, k, nil, b.Bounds())
+			m.deleteCell(x, y, k, nil, Rect(0, 0, m.w, m.h))
+		}
+		checkWideCells(ht, "after the cell shift", shape, b, m)
+	})
+}
+
+// shrink is a wide grid resized to a width that cuts through the wide cell (the region of
+// ultraviolet/21), or under HEGEL_NO_KNOWN=1 to the column before or after it.
+type shrink struct {
+	g    wideGrid
+	keep bool // under HEGEL_NO_KNOWN=1: keep the wide cell rather than drop it
+}
+
+func (s shrink) width() int {
+	hx := s.g.head()
+	switch {
+	case !noKnown:
+		return hx + 1
+	case s.keep:
+		return hx + 2
+	}
+	return hx
+}
+
+func (s shrink) GoString() string { return fmt.Sprintf("Resize to %d columns of %#v", s.width(), s.g) }
+
+var shrinks = hegel.Composite(func(tc hegel.TestCase) shrink {
+	return shrink{hegel.Draw(tc, wideGridsOf(hegel.Integers(1, 3))), hegel.Draw(tc, chance(50))}
+})
+
+// TestHegelResizeLeavesNoWideCellWithoutRoom: narrowing a buffer through a wide cell erases
+// the cell rather than leaving its head in the last column.
+func TestHegelResizeLeavesNoWideCellWithoutRoom(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, shrinks)
+		b, m := s.g.build()
+		nw := s.width()
+		note(ht, "Resize(%d,%d)", nw, s.g.h)
+		b.Resize(nw, s.g.h)
+		m.resize(nw, s.g.h)
+		checkWideCells(ht, "after Resize", s.g.shape("ultraviolet/21"), b, m)
+	})
+}
+
+// wideOverWides is a row of two adjacent wide cells and a cell written over the placeholder
+// of the first and the head of the second: a wide one (the region of ultraviolet/22) or, under
+// HEGEL_NO_KNOWN=1, a narrow one.
+type wideOverWides struct {
+	w             int
+	x             int // position of the first wide cell
+	first, second *Cell
+	over          *Cell
+}
+
+func (o wideOverWides) x0() int { return o.x % (o.w - 3) }
+
+func (o wideOverWides) GoString() string {
+	return fmt.Sprintf("%s and %s at %d, %s written at %d", cellString(o.first), cellString(o.second), o.x0(), cellString(o.over), o.x0()+1)
+}
+
+var wideOverWidesCases = hegel.Composite(func(tc hegel.TestCase) wideOverWides {
+	return wideOverWides{
+		w:      hegel.Draw(tc, hegel.Integers(4, 10)),
+		x:      hegel.Draw(tc, positions),
+		first:  hegel.Draw(tc, wideCells),
+		second: hegel.Draw(tc, wideCells),
+		over:   hegel.Draw(tc, shaped(wideCells, singleCells)),
+	}
+})
+
+// TestHegelWideCellsOverWideCellsLeaveNoOrphan: a cell written across two wide cells erases
+// both of them whole.
+func TestHegelWideCellsOverWideCellsLeaveNoOrphan(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := hegel.Draw(ht, wideOverWidesCases)
+		b, m := NewBuffer(o.w, 1), newGrid(o.w, 1)
+		x0 := o.x0()
+		for i, c := range []*Cell{o.first, o.second} {
+			b.SetCell(x0+2*i, 0, c)
+			m.setCell(x0+2*i, 0, c)
+		}
+		b.SetCell(x0+1, 0, o.over)
+		m.setCell(x0+1, 0, o.over)
+		// The model writes the new cell's placeholder over the second head as the buffer
+		// does; the terminal rule (normalize) is the oracle: nothing torn is left behind.
+		m.normalize(0)
+		shape := ""
+		if o.over.Width > 1 {
+			shape = "ultraviolet/22"
+		}
+		if hasOrphan(b) {
+			mismatch(ht, shape, "%s over %s%s at %d leaves a torn wide cell:\n%s", cellString(o.over), cellString(o.first), cellString(o.second), x0+1, dumpBuffer(b))
+		}
+		if got, want := b.String(), m.String(); got != want {
+			mismatch(ht, shape, "String() = %q, model %q\nbuffer:\n%s", got, want, dumpBuffer(b))
+		}
+		count("ok")
+	})
+}
+
+// lineShift is a wide grid and an InsertLineArea or DeleteLineArea moving the wide cell's row
+// over an area whose vertical edge runs through the wide cell (the region of ultraviolet/23);
+// under HEGEL_NO_KNOWN=1 the edges fall outside it.
+type lineShift struct {
+	g       wideGrid
+	insert  bool
+	right   bool // the edge at the wide cell is the area's right edge
+	y0, k   int  // positions
+	partial bool // under HEGEL_NO_KNOWN=1: an area narrower than the buffer
+}
+
+// row is the wide cell's row, from 1 to h-2 so that rows exist above and below it.
+func (s lineShift) row() int { return 1 + s.g.y%(s.g.h-2) }
+
+// area spans the whole height and the columns from the edge at the wide cell to a side of the
+// buffer.
+func (s lineShift) area() Rectangle {
+	w, h, hx := s.g.w, s.g.h, s.g.head()
+	switch {
+	case !noKnown && s.right:
+		return Rect(0, 0, hx+1, h) // the edge between head and placeholder
+	case !noKnown:
+		return Rect(hx+1, 0, w-hx-1, h)
+	case !s.partial:
+		return Rect(0, 0, w, h)
+	case s.right:
+		return Rect(0, 0, hx+2, h) // the edge after the placeholder
+	}
+	return Rect(hx, 0, w-hx, h) // the edge before the head
+}
+
+func (s lineShift) GoString() string {
+	op := "DeleteLineArea"
+	if s.insert {
+		op = "InsertLineArea"
+	}
+	return fmt.Sprintf("%s over %v on %#v (row %d)", op, s.area(), s.g, s.row())
+}
+
+var lineShifts = hegel.Composite(func(tc hegel.TestCase) lineShift {
+	return lineShift{
+		g:       hegel.Draw(tc, wideGridsOf(hegel.Integers(3, 4))),
+		insert:  hegel.Draw(tc, chance(50)),
+		right:   hegel.Draw(tc, chance(50)),
+		y0:      hegel.Draw(tc, positions),
+		k:       hegel.Draw(tc, positions),
+		partial: hegel.Draw(tc, chance(50)),
+	}
+})
+
+// TestHegelLineShiftsMoveWideCellsWhole: inserting or deleting lines over an area moves a wide
+// cell at the area's edge whole or erases it, never in half.
+func TestHegelLineShiftsMoveWideCellsWhole(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, lineShifts)
+		g := s.g
+		g.y = s.row() // the grid puts the wide cell in the shifted row
+		b, m := g.build()
+		row, r := s.row(), s.area()
+		shape := g.shape("ultraviolet/23")
+		if s.insert {
+			y0 := s.y0 % (row + 1) // the row moves down one
+			note(ht, "InsertLineArea(%d,1,%v)", y0, r)
+			b.InsertLineArea(y0, 1, nil, r)
+			m.insertLine(y0, 1, nil, r)
+		} else {
+			y0 := s.y0 % row
+			k := 1 + s.k%(row-y0) // the row moves up k
+			note(ht, "DeleteLineArea(%d,%d,%v)", y0, k, r)
+			b.DeleteLineArea(y0, k, nil, r)
+			m.deleteLine(y0, k, nil, r)
+		}
+		checkWideCells(ht, "after the line shift", shape, b, m)
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/35
+
+// scannerLongCSIReads: a read of 0 to 2 stream-safe events and a CSI with 33 to 60 parameters
+// (the region of ultraviolet/35, longCSIs); under HEGEL_NO_KNOWN=1 the CSI has 1 to 32.
+var scannerLongCSIReads = hegel.Composite(func(tc hegel.TestCase) stream {
+	parts := hegel.Draw(tc, many(streamEvents(false), 0, 2))
+	return stream{append(parts, hegel.Draw(tc, longCSIs))}
+})
+
+// TestHegelScannerSurvivesCSIsWithManyParameters: a read through the scanner (TerminalReader's
+// loop) gives the events it holds however many parameters a CSI in it carries.
+func TestHegelScannerSurvivesCSIsWithManyParameters(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, scannerLongCSIReads)
+		seq, want := s.seq(), s.want()
+		var got []Event
+		naming(ht, shaped("ultraviolet/35", ""), func() { got = scanOnce(newScanner(0, "dumb", false), []byte(seq)) })
+		if !reflect.DeepEqual(got, want) {
+			mismatch(ht, s.shape(), "scanner on %q:\n  got\n    %s\n  want\n    %s", seq, eventsString(got), eventsString(want))
+		}
+	})
+}
