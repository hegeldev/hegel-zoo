+// ---------------------------------------------------------------- ultraviolet/3
+
+// cutReport is a report and the read boundary inside it.
+type cutReport struct {
+	e   encoded
+	pos int // taken modulo the offsets inside the sequence
+}
+
+func (c cutReport) GoString() string { return fmt.Sprintf("%#v cut at position %d", c.e, c.pos) }
+
+// cut is the byte offset the position stands for, among 1 to len-1.
+func (c cutReport) cut() int { return 1 + c.pos%(len(c.e.seq)-1) }
+
+// checkCutReport: the report cut into two reads still gives its events.
+func checkCutReport(ht *hegel.T, e encoded, cut int) {
+	got := scanChunked(newScanner(0, "dumb", false), []byte(e.seq), []int{cut})
+	if want := flatten(e.want); !reflect.DeepEqual(got, want) {
+		mismatch(ht, shapes(e.shape(), cutShape(e, cut)), "%s %q read as %q + %q gives\n    %s\n  want\n    %s", e.kind, e.seq, e.seq[:cut], e.seq[cut:], eventsString(got), eventsString(want))
+	}
+	count("ok")
+}
