+// ---------------------------------------------------------------- ultraviolet/10
+
+// longCSIs: a CSI with an unknown final byte and 33 to 60 parameters (the region of
+// ultraviolet/10); under HEGEL_NO_KNOWN=1 with 1 to 32.
+var longCSIs = hegel.Map(shaped(many(hegel.Integers(0, 99), 33, 60), many(hegel.Integers(0, 99), 1, 32)), func(params []int) encoded {
+	parts := make([]string, len(params))
+	for i, p := range params {
+		parts[i] = itoa(p)
+	}
+	seq := "\x1b[" + strings.Join(parts, ";") + "z"
+	kind := "unknown-csi"
+	if len(params) > 32 {
+		kind = "csi-many-params"
+	}
+	return decEvent(kind, seq, UnknownCsiEvent(seq))
+})
