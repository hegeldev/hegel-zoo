+// ---------------------------------------------------------------- ultraviolet/28
+
+// hiddenCursorStop is Terminal.Start (Restore), a step that records a hidden Cursor —
+// SetCursorPosition on the fresh screen, or ShowCursor then HideCursor — and Terminal.Stop
+// (Reset); under HEGEL_NO_KNOWN=1 the program shows the cursor before the stop.
+type hiddenCursorStop struct {
+	w, h       int
+	viaHide    bool
+	x, y       int // positions
+	showBefore bool
+}
+
+func (c hiddenCursorStop) GoString() string {
+	step := fmt.Sprintf("SetCursorPosition(%d,%d)", c.x%c.w, c.y%c.h)
+	if c.viaHide {
+		step = "ShowCursor, HideCursor"
+	}
+	return fmt.Sprintf("%dx%d: Restore, %s, shown before Reset %v", c.w, c.h, step, c.showBefore)
+}
+
+var hiddenCursorStops = hegel.Composite(func(tc hegel.TestCase) hiddenCursorStop {
+	return hiddenCursorStop{
+		w:          hegel.Draw(tc, hegel.Integers(1, 12)),
+		h:          hegel.Draw(tc, hegel.Integers(1, 6)),
+		viaHide:    hegel.Draw(tc, chance(50)),
+		x:          hegel.Draw(tc, positions),
+		y:          hegel.Draw(tc, positions),
+		showBefore: hegel.Draw(tc, shaped(hegel.Just(false), hegel.Just(true))),
+	}
+})
+
+// TestHegelResetShowsTheCursor: after Reset (Terminal.Stop) the terminal's cursor is visible.
+func TestHegelResetShowsTheCursor(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hiddenCursorStops)
+		s, out := newScreen(c.w, c.h)
+		tk := newTracker()
+		s.Restore()
+		if c.viaHide {
+			s.ShowCursor()
+			s.HideCursor()
+		} else {
+			s.SetCursorPosition(c.x%c.w, c.y%c.h)
+		}
+		if c.showBefore {
+			s.ShowCursor()
+		}
+		if err := s.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		before := feedTo(ht, out, nil, tk)
+		s.Reset()
+		if err := s.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		chunk := feedTo(ht, out, nil, tk)
+		shape := "ultraviolet/28"
+		if c.showBefore {
+			shape = ""
+		}
+		if !tk.visible {
+			mismatch(ht, shape, "after Reset the terminal's cursor is hidden: before %q, Reset wrote %q", before, chunk)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/29
+
+// styledHiddenCursor is HideCursor on a screen that holds no Cursor (the region of
+// ultraviolet/29) or, under HEGEL_NO_KNOWN=1, on one shown first; then a cursor style or colour.
+type styledHiddenCursor struct {
+	w, h      int
+	showFirst bool
+	colour    bool
+	shape     uv.CursorShape
+	blink     bool
+	c         color.Color
+}
+
+func (c styledHiddenCursor) GoString() string {
+	step := fmt.Sprintf("SetCursorStyle(%d,%v)", c.shape, c.blink)
+	if c.colour {
+		step = fmt.Sprintf("SetCursorColor(%v)", c.c)
+	}
+	return fmt.Sprintf("%dx%d: shown first %v, HideCursor, %s", c.w, c.h, c.showFirst, step)
+}
+
+var styledHiddenCursors = hegel.Composite(func(tc hegel.TestCase) styledHiddenCursor {
+	return styledHiddenCursor{
+		w:         hegel.Draw(tc, hegel.Integers(1, 12)),
+		h:         hegel.Draw(tc, hegel.Integers(1, 6)),
+		showFirst: hegel.Draw(tc, shaped(hegel.Just(false), hegel.Just(true))),
+		colour:    hegel.Draw(tc, chance(50)),
+		shape:     uv.CursorShape(hegel.Draw(tc, hegel.Integers(0, 2))),
+		blink:     hegel.Draw(tc, chance(50)),
+		c:         hegel.Draw(tc, rgb),
+	}
+})
+
+// TestHegelCursorStylesLeaveAHiddenCursorHidden: a cursor style or colour after HideCursor
+// keeps the cursor hidden, in the getter and on the terminal.
+func TestHegelCursorStylesLeaveAHiddenCursorHidden(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, styledHiddenCursors)
+		s, out := newScreen(c.w, c.h)
+		tk := newTracker()
+		if c.showFirst {
+			s.ShowCursor()
+		}
+		s.HideCursor()
+		if err := s.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		feedTo(ht, out, nil, tk)
+		if c.colour {
+			s.SetCursorColor(c.c)
+		} else {
+			s.SetCursorStyle(c.shape, c.blink)
+		}
+		visible := s.CursorVisible()
+		if err := s.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		chunk := feedTo(ht, out, nil, tk)
+		shape := "ultraviolet/29"
+		if c.showFirst {
+			shape = ""
+		}
+		if visible || tk.visible {
+			mismatch(ht, shape, "%#v: CursorVisible() is %v and the terminal's cursor is visible %v; the flush wrote %q", c, visible, tk.visible, chunk)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/30
+
+// shortLines: one to three lines of letters shorter than the width w (no wrap, not the shape
+// of ultraviolet/31).
+type shortLine struct {
+	pos  int // position
+	pool []byte
+}
+
+func (l shortLine) text(w int) string { return lettersOf(l.pool, 1+l.pos%(w-1)) }
+
+var shortLines = hegel.Composite(func(tc hegel.TestCase) shortLine {
+	return shortLine{hegel.Draw(tc, positions), hegel.Draw(tc, letters)}
+})
+
+// insertAboveIn is a frame in the alt screen (the region of ultraviolet/30) or, under
+// HEGEL_NO_KNOWN=1, on the main screen of a terminal tall enough for the lines, then
+// InsertAbove of the lines.
+type insertAboveIn struct {
+	w, h  int
+	text  plainText
+	n     int // position
+	lines []shortLine
+	alt   bool
+}
+
+func (c insertAboveIn) content() string {
+	var lines []string
+	for _, l := range c.lines {
+		lines = append(lines, l.text(c.w))
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (c insertAboveIn) GoString() string {
+	return fmt.Sprintf("%dx%d, alt screen %v: InsertAbove(%q)", c.w, c.h, c.alt, c.content())
+}
+
+var insertAboveIns = hegel.Composite(func(tc hegel.TestCase) insertAboveIn {
+	return insertAboveIn{
+		w:     hegel.Draw(tc, hegel.Integers(2, 12)),
+		h:     hegel.Draw(tc, hegel.Integers(1, 4)),
+		text:  hegel.Draw(tc, plainTexts),
+		n:     hegel.Draw(tc, positions),
+		lines: hegel.Draw(tc, many(shortLines, 1, 3)),
+		alt:   hegel.Draw(tc, shaped(hegel.Just(true), hegel.Just(false))),
+	}
+})
+
+// TestHegelInsertAboveLeavesTheFrameIntact: after InsertAbove and the next frame the terminal
+// shows the frame whole — in place in the alt screen, below the lines on the main screen.
+func TestHegelInsertAboveLeavesTheFrameIntact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, insertAboveIns)
+		rows := len(c.lines)
+		s, out := newScreen(c.w, c.h)
+		e := vt.NewEmulator(c.w, c.h+rows)
+		if c.alt {
+			s.EnterAltScreen()
+		}
+		if err := s.Display(uv.NewStyledString(c.text.render(c.w, 1+c.n%c.h))); err != nil {
+			fail(ht, "Display: %v", err)
+		}
+		feedTo(ht, out, e, nil)
+		frame := frameCells(s)
+		if err := s.InsertAbove(c.content()); err != nil {
+			fail(ht, "InsertAbove: %v", err)
+		}
+		chunk := feedTo(ht, out, e, nil)
+		if err := s.Display(nil); err != nil {
+			fail(ht, "Display: %v", err)
+		}
+		chunk += feedTo(ht, out, e, nil)
+		shape := ""
+		top := rows
+		if c.alt {
+			shape, top = "ultraviolet/30", 0
+		}
+		if d := frameDiffers(e, top, frame); d != "" {
+			mismatch(ht, shape, "after InsertAbove(%q) and a frame the terminal does not show the frame at row %d: %s\n%s\nwrote %q", c.content(), top, d, emulatorRows(e, 0, c.h+rows), chunk)
+		}
+		if !c.alt {
+			for i, l := range c.lines {
+				if got, want := rowString(e, i), l.text(c.w); got != want {
+					mismatch(ht, shape, "row %d shows %q, want %q\n%s\nwrote %q", i, got, want, emulatorRows(e, 0, c.h+rows), chunk)
+				}
+			}
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/31
+
+// fullLine is InsertAbove of a line exactly one or two screen widths wide (the region of
+// ultraviolet/31) or, under HEGEL_NO_KNOWN=1, one letter shorter.
+type fullLine struct {
+	w, h  int
+	text  plainText
+	n     int // position
+	twice bool
+	pool  []byte
+	short bool
+}
+
+func (c fullLine) width() int {
+	width := c.w
+	if c.twice {
+		width = 2 * c.w
+	}
+	if c.short {
+		width--
+	}
+	return width
+}
+
+func (c fullLine) line() string { return lettersOf(c.pool, c.width()) }
+
+func (c fullLine) GoString() string {
+	return fmt.Sprintf("%dx%d: InsertAbove(%q) (%d letters)", c.w, c.h, c.line(), c.width())
+}
+
+var fullLines = hegel.Composite(func(tc hegel.TestCase) fullLine {
+	return fullLine{
+		w:     hegel.Draw(tc, hegel.Integers(2, 12)),
+		h:     hegel.Draw(tc, hegel.Integers(1, 3)),
+		text:  hegel.Draw(tc, plainTexts),
+		n:     hegel.Draw(tc, positions),
+		twice: hegel.Draw(tc, chance(50)),
+		pool:  hegel.Draw(tc, letters),
+		short: hegel.Draw(tc, shaped(hegel.Just(false), hegel.Just(true))),
+	}
+})
+
+// TestHegelInsertedLinesKeepTheirLastCell: a line inserted above the frame shows every letter,
+// wrapped at the width.
+func TestHegelInsertedLinesKeepTheirLastCell(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, fullLines)
+		s, out := newScreen(c.w, c.h)
+		e := vt.NewEmulator(c.w, c.h+2)
+		if err := s.Display(uv.NewStyledString(c.text.render(c.w, 1+c.n%c.h))); err != nil {
+			fail(ht, "Display: %v", err)
+		}
+		feedTo(ht, out, e, nil)
+		line := c.line()
+		if err := s.InsertAbove(line); err != nil {
+			fail(ht, "InsertAbove: %v", err)
+		}
+		chunk := feedTo(ht, out, e, nil)
+		shape := ""
+		if !c.short {
+			shape = "ultraviolet/31"
+		}
+		for i := 0; len(line) > 0; i++ {
+			want := line[:min(c.w, len(line))]
+			line = line[len(want):]
+			if got := rowString(e, i); got != want {
+				mismatch(ht, shape, "InsertAbove(%q) on %d columns: row %d shows %q, want %q; wrote %q", c.line(), c.w, i, got, want, chunk)
+			}
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/32
+
+// intervalCases: tab stops at an interval other than eight (the region of ultraviolet/32) or,
+// under HEGEL_NO_KNOWN=1, at eight.
+var intervalCases = hegel.Composite(func(tc hegel.TestCase) tabCase {
+	c := hegel.Draw(tc, tabCases)
+	c.interval = hegel.Draw(tc, shaped(hegel.SampledFrom([]int{1, 2, 3, 4, 5, 6, 7, 9, 12, 16, 32}), hegel.Just(8)))
+	return c
+})
+
+// TestHegelTabStopsHonourTheirInterval: TabStops at any interval keep the documented set of
+// stops.
+func TestHegelTabStopsHonourTheirInterval(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, intervalCases)
+		shape := ""
+		if c.interval != 8 {
+			shape = "ultraviolet/32"
+		}
+		naming(ht, shape, func() { checkTabStops(ht, c, shape) })
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/33
+
+// kittyFlags: all five Kitty flags (the region of ultraviolet/33) or, under HEGEL_NO_KNOWN=1,
+// the two the constructor keeps.
+var kittyFlags = shaped(hegel.Integers(0, 31), hegel.Integers(0, 3))
+
+// TestHegelKeyboardEnhancementsKeepTheirFlags: NewKeyboardEnhancements(flags).Flags() is flags.
+func TestHegelKeyboardEnhancementsKeepTheirFlags(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		flags := hegel.Draw(ht, kittyFlags)
+		shape := ""
+		if flags&^3 != 0 {
+			shape = "ultraviolet/33"
+		}
+		if got := uv.NewKeyboardEnhancements(flags).Flags(); got != flags {
+			mismatch(ht, shape, "NewKeyboardEnhancements(%d).Flags() = %d", flags, got)
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- ultraviolet/34
+
+// stopAndStart is a frame in the alt screen (the region of ultraviolet/34) or, under
+// HEGEL_NO_KNOWN=1, inline, then Reset (Terminal.Stop) and Restore (Terminal.Start).
+type stopAndStart struct {
+	w, h int
+	text plainText
+	n    int // position
+	alt  bool
+}
+
+func (c stopAndStart) GoString() string {
+	return fmt.Sprintf("%dx%d, alt screen %v: Reset then Restore", c.w, c.h, c.alt)
+}
+
+var stopAndStarts = hegel.Composite(func(tc hegel.TestCase) stopAndStart {
+	return stopAndStart{
+		w:    hegel.Draw(tc, hegel.Integers(2, 12)),
+		h:    hegel.Draw(tc, hegel.Integers(1, 4)),
+		text: hegel.Draw(tc, plainTexts),
+		n:    hegel.Draw(tc, positions),
+		alt:  hegel.Draw(tc, shaped(hegel.Just(true), hegel.Just(false))),
+	}
+})
+
+// TestHegelRestoreBringsTheFrameBack: after Reset and Restore the terminal shows the frame
+// again.
+func TestHegelRestoreBringsTheFrameBack(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, stopAndStarts)
+		s, out := newScreen(c.w, c.h)
+		e := vt.NewEmulator(c.w, c.h+3)
+		if c.alt {
+			s.EnterAltScreen()
+		}
+		if err := s.Display(uv.NewStyledString(c.text.render(c.w, 1+c.n%c.h))); err != nil {
+			fail(ht, "Display: %v", err)
+		}
+		feedTo(ht, out, e, nil)
+		frame := frameCells(s)
+		s.Reset()
+		if err := s.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		chunk := feedTo(ht, out, e, nil)
+		s.Restore()
+		if err := s.Flush(); err != nil {
+			fail(ht, "Flush: %v", err)
+		}
+		chunk += feedTo(ht, out, e, nil)
+		shape := ""
+		if c.alt {
+			shape = "ultraviolet/34"
+		}
+		if d := frameDiffers(e, 0, frame); d != "" {
+			mismatch(ht, shape, "after Reset and Restore the terminal does not show the frame: %s\n%s\nReset and Restore wrote %q", d, emulatorRows(e, 0, c.h+3), chunk)
+		}
+		count("ok")
+	})
+}
diff --git a/hegel_render_test.go b/hegel_render_test.go
new file mode 100644
index 0000000..c221492
--- /dev/null
+++ b/hegel_render_test.go
@@ -0,0 +1,690 @@
+package uv_test
+
+// TerminalRenderer against the charmbracelet/x/vt emulator: whatever the renderer emits to
+// bring the terminal from the previous frame to the new one must leave the emulator's screen
+// equal to the new frame. An external test package because x/vt imports ultraviolet; the
+// harness and the cell generators come through the *T bridges in hegel_buffer_test.go, and
+// the generator idioms (generic, so not bridgeable as values) are repeated below for this
+// package and hegel_screen_test.go.
+//
+// The frames of a case are drawn as a list of records (what to draw and where, as positions
+// resolved against the live size) and rendered one after the other. The recorded bugs the
+// renderer meets (ultraviolet/22 through the frame's own buffer, /24, /25) are drawn at their
+// natural rate and a mismatch names the shape; under HEGEL_NO_KNOWN=1 the frames carry no
+// hyperlinks (/24), every row is marked touched before a frame the scroll optimisation may move
+// (/25), and an orphaned placeholder in a frame is repaired before rendering (/22).
+
+import (
+	"bytes"
+	"fmt"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/colorprofile"
+	uv "github.com/charmbracelet/ultraviolet"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/vt"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	property    = uv.PropertyT
+	count       = uv.CountT
+	note        = uv.NoteT
+	fail        = uv.FailT
+	mismatch    = uv.MismatchT
+	naming      = uv.NamingT
+	known       = uv.KnownT
+	shapes      = uv.ShapesT
+	noKnown     = uv.NoKnownT
+	chance      = uv.ChanceT
+	positions   = uv.PositionsT
+	styles      = uv.StylesT
+	links       = uv.LinksT
+	graphemes   = uv.GraphemesT
+	applySGR    = uv.ApplySGRT
+	readLink    = uv.ReadLinkT
+	hasOrphan   = uv.HasOrphanT
+	cellString  = uv.CellStringT
+	styleString = uv.StyleStringT
+	colorEqual  = uv.ColorEqualT
+	cellEqual   = uv.CellEqualT
+	guard       = uv.GuardT
+)
+
+// ---------------------------------------------------------------- generator idioms
+
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices with probability proportional to its weight; it
+// shrinks towards the first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// at is the element of xs at a drawn position, modulo the size.
+func at[T any](xs []T, pos int) T { return xs[pos%len(xs)] }
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](knownShape, past T) T {
+	if noKnown {
+		return past
+	}
+	return knownShape
+}
+
+// ---------------------------------------------------------------- pins (renderer)
+
+// ultraviolet/24: updatePen(nil) resets the terminal's hyperlink but leaves it in the pen, so
+// the next cell carrying the same link is drawn without one. A cursor move to another row
+// resets the pen whenever it holds a style or a link.
+func TestHegelPinHyperlinkLostAfterPenReset(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	r := uv.NewTerminalRenderer(&out, []string{"TERM=xterm-256color"})
+	r.SetColorProfile(colorprofile.TrueColor)
+	r.SetFullscreen(true)
+	scr := uv.NewScreenBuffer(4, 2)
+	e := vt.NewEmulator(4, 2)
+	link := uv.Link{URL: "https://example.com/"}
+	scr.SetCell(0, 0, &uv.Cell{Content: "a", Width: 1, Link: link})
+	scr.SetCell(0, 1, &uv.Cell{Content: "b", Width: 1, Link: link})
+	r.Render(scr.RenderBuffer)
+	if err := r.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.WriteString(out.String()); err != nil {
+		t.Fatal(err)
+	}
+	if got := e.CellAt(0, 1).Link; got != link {
+		t.Errorf("b at (0,1) has link %v on the terminal, want %v; output %q", got, link, out.String())
+	}
+}
+
+// ultraviolet/25: the scroll optimisation scrolls a region of the terminal (and of the
+// renderer's current buffer) that contains a row the new frame did not touch. The row's old
+// content moves away, and since only touched rows are transformed nothing paints it back: the
+// terminal shows a blank where the frame has the row, and the renderer's record agrees with
+// the terminal rather than the frame, so later frames do not repair it either.
+func TestHegelPinScrollOptimisationSkipsAnUntouchedRow(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	r := uv.NewTerminalRenderer(&out, []string{"TERM=xterm-256color"})
+	r.SetColorProfile(colorprofile.TrueColor)
+	r.SetFullscreen(true)
+	r.SetScrollOptim(true)
+	scr := uv.NewScreenBuffer(2, 6)
+	e := vt.NewEmulator(2, 6)
+	cell := func(s string) *uv.Cell { return &uv.Cell{Content: s, Width: 1} }
+	scr.SetCell(0, 2, cell("#"))
+	scr.SetCell(0, 3, cell("0"))
+	r.Render(scr.RenderBuffer)
+	if err := r.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.WriteString(out.String()); err != nil {
+		t.Fatal(err)
+	}
+	out.Reset()
+	// The second frame shifts # down by two rows and keeps 0 where it was.
+	scr.SetCell(0, 0, cell("x"))
+	scr.SetCell(0, 1, cell("y"))
+	scr.SetCell(0, 2, cell("9"))
+	scr.SetCell(0, 3, cell("0")) // unchanged, so not touched
+	scr.SetCell(0, 4, &uv.Cell{Content: "#", Width: 1, Link: uv.Link{URL: "https://example.com/"}})
+	r.Render(scr.RenderBuffer)
+	if err := r.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := e.WriteString(out.String()); err != nil {
+		t.Fatal(err)
+	}
+	if got := e.CellAt(0, 3).Content; got != "0" {
+		t.Errorf("row 3 shows %q on the terminal, the frame has \"0\"; output %q", got, out.String())
+	}
+	if got := uv.RendererCurbufT(r).Line(3).String(); got != "0" {
+		t.Errorf("the renderer's current buffer has %q in row 3, the frame has \"0\"", got)
+	}
+}
+
+// ---------------------------------------------------------------- styled text
+
+// renderLinks: the hyperlinks of the frames; none under HEGEL_NO_KNOWN=1, since the renderer
+// loses a link after resetting its pen (ultraviolet/24).
+var (
+	renderLinks = shaped(links, hegel.Just(uv.Link{}))
+	renderCells = uv.CellsWithT(graphemes, renderLinks)
+	narrowCells = uv.CellsWithT(uv.NarrowGraphemesT, renderLinks)
+)
+
+// piece is one element of styled text: a grapheme, a space, an SGR sequence, a reset or a
+// hyperlink.
+type piece struct {
+	kind     int // 0 grapheme, 1 space, 2 style, 3 reset, 4 link
+	grapheme string
+	style    uv.Style
+	link     uv.Link
+}
+
+func (p piece) String() string {
+	switch p.kind {
+	case 1:
+		return " "
+	case 2:
+		return p.style.String()
+	case 3:
+		return "\x1b[m"
+	case 4:
+		return ansi.SetHyperlink(p.link.URL, p.link.Params)
+	}
+	return p.grapheme
+}
+
+// pieces: a grapheme half the time, the others one in eight each.
+var pieces = hegel.Composite(func(tc hegel.TestCase) piece {
+	return piece{
+		kind:     hegel.Draw(tc, weighted(choice[int]{4, hegel.Just(0)}, choice[int]{1, hegel.Just(1)}, choice[int]{1, hegel.Just(2)}, choice[int]{1, hegel.Just(3)}, choice[int]{1, hegel.Just(4)})),
+		grapheme: hegel.Draw(tc, graphemes),
+		style:    hegel.Draw(tc, styles),
+		link:     hegel.Draw(tc, renderLinks),
+	}
+})
+
+// textLine is one line of styled text: up to w+2 pieces of the ones drawn, and its line break.
+type textLine struct {
+	pieces []piece
+	crlf   bool
+}
+
+var textLines = hegel.Composite(func(tc hegel.TestCase) textLine {
+	return textLine{hegel.Draw(tc, many(pieces, 0, 18)), hegel.Draw(tc, chance(50))}
+})
+
+// styledText is styled text for printAt: lines of pieces, rendered for a width and a number
+// of lines.
+type styledText struct {
+	lines []textLine // 1 to 7
+}
+
+var styledTexts = hegel.Map(many(textLines, 1, 7), func(ls []textLine) styledText { return styledText{ls} })
+
+// render writes n lines of at most w+2 pieces each.
+func (t styledText) render(w, n int) string {
+	var sb strings.Builder
+	for i := 0; i < n; i++ {
+		l := at(t.lines, i)
+		if i > 0 {
+			if l.crlf {
+				sb.WriteString("\r\n")
+			} else {
+				sb.WriteString("\n")
+			}
+		}
+		for _, p := range l.pieces[:min(len(l.pieces), w+2)] {
+			sb.WriteString(p.String())
+		}
+	}
+	return sb.String()
+}
+
+// printAt writes styled text into the screen buffer from (x, y), wrapping at the right edge
+// and stopping at the bottom — what a screen writer does with a model's view.
+func printAt(scr uv.ScreenBuffer, x, y int, text string) {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st uv.Style
+	var ln uv.Link
+	var state byte
+	w, h := scr.Width(), scr.Height()
+	for len(text) > 0 {
+		sq, cw, k, ns := ansi.DecodeSequenceWc(text, state, p)
+		switch {
+		case ansi.HasCsiPrefix(sq) && p.Command() == 'm':
+			applySGR(p.Params(), &st)
+		case ansi.HasOscPrefix(sq) && p.Command() == 8:
+			readLink(string(p.Data()), &ln)
+		case sq == "\r":
+			x = 0
+		case sq == "\n":
+			x = 0
+			y++
+		case cw > 0:
+			if x+cw > w {
+				x = 0
+				y++
+			}
+			if y >= h {
+				return
+			}
+			scr.SetCell(x, y, &uv.Cell{Content: sq, Width: cw, Style: st, Link: ln})
+			x += cw
+		}
+		text = text[k:]
+		state = ns
+	}
+}
+
+// scrollSeq matches the ways scrollUp/scrollDown/scrollIdl move rows: a scroll region, SU, SD,
+// IL, DL, RI — and a bare LF, which scrollUp writes at the bottom row (once for n == 1, n times
+// on terminals without SU such as linux and vt100). LF is also an ordinary cursor move, so the
+// match is only consulted when the frame mismatches with the scroll optimisation on and a row
+// untouched (ultraviolet/25).
+var (
+	irmOn     = regexp.MustCompile(`\x1b\[4h`)
+	scrollSeq = regexp.MustCompile(`\x1b\[[0-9;]*[rSTLM]|\x1bM|\n`)
+)
+
+// untouchedRows reports whether some row of the frame is not marked touched.
+func untouchedRows(b *uv.RenderBuffer) bool {
+	for y := 0; y < b.Height(); y++ {
+		if y >= len(b.Touched) || b.Touched[y] == nil || (b.Touched[y].FirstCell == -1 && b.Touched[y].LastCell == -1) {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------- frames
+
+// rectSpec is a rectangle drawn as positions and resolved against the live size.
+type rectSpec struct {
+	x, y, w, h int
+}
+
+var rectSpecs = hegel.Composite(func(tc hegel.TestCase) rectSpec {
+	return rectSpec{hegel.Draw(tc, positions), hegel.Draw(tc, positions), hegel.Draw(tc, positions), hegel.Draw(tc, positions)}
+})
+
+// in is a rectangle inside a w by h area.
+func (r rectSpec) in(w, h int) uv.Rectangle {
+	x0, y0 := r.x%w, r.y%h
+	return uv.Rect(x0, y0, r.w%(w-x0+1), r.h%(h-y0+1))
+}
+
+// cellSet is one SetCell: positions and the cell.
+type cellSet struct {
+	x, y int
+	cell *uv.Cell
+}
+
+var cellSets = hegel.Composite(func(tc hegel.TestCase) cellSet {
+	return cellSet{hegel.Draw(tc, positions), hegel.Draw(tc, positions), hegel.Draw(tc, renderCells)}
+})
+
+type frameKind int
+
+const (
+	frPrintTop frameKind = iota
+	frPrintAt
+	frSetCells
+	frFill
+	frClear
+	frLines
+	frErase
+	frResize
+)
+
+var frameKindNames = []string{"printAt(0,0)", "printAt", "SetCells", "FillArea", "ClearArea", "lines", "Erase", "Resize"}
+
+// frameOp is what changes between two frames, its arguments drawn as positions resolved
+// against the live size.
+type frameOp struct {
+	kind    frameKind
+	text    styledText
+	n       int // position: the number of lines of text
+	x, y    int // positions
+	cells   []cellSet
+	rect    rectSpec
+	cell    *uv.Cell // narrow, for FillArea
+	insert  bool     // lines: InsertLine rather than DeleteLine
+	k       int      // lines to shift, 1 or 2
+	reprint bool     // lines: print a line afterwards (seven times in ten)
+	atEnd   bool     // lines: print it on the last row rather than the shifted one
+	nw, nh  int      // Resize: the new size
+}
+
+func (op frameOp) GoString() string { return frameKindNames[op.kind] }
+
+// frameOps: text printed at the top three times in eleven, cells set twice, the rest once;
+// each draws only its own arguments.
+var frameOps = weighted(
+	choice[frameOp]{3, hegel.Composite(func(tc hegel.TestCase) frameOp {
+		return frameOp{kind: frPrintTop, text: hegel.Draw(tc, styledTexts), n: hegel.Draw(tc, positions)}
+	})},
+	choice[frameOp]{1, hegel.Composite(func(tc hegel.TestCase) frameOp {
+		return frameOp{
+			kind: frPrintAt,
+			text: hegel.Draw(tc, styledTexts),
+			n:    hegel.Draw(tc, positions),
+			x:    hegel.Draw(tc, positions),
+			y:    hegel.Draw(tc, positions),
+		}
+	})},
+	choice[frameOp]{2, hegel.Composite(func(tc hegel.TestCase) frameOp {
+		return frameOp{kind: frSetCells, cells: hegel.Draw(tc, many(cellSets, 1, 6))}
+	})},
+	choice[frameOp]{1, hegel.Composite(func(tc hegel.TestCase) frameOp {
+		return frameOp{kind: frFill, rect: hegel.Draw(tc, rectSpecs), cell: hegel.Draw(tc, narrowCells)}
+	})},
+	choice[frameOp]{1, hegel.Composite(func(tc hegel.TestCase) frameOp {
+		return frameOp{kind: frClear, rect: hegel.Draw(tc, rectSpecs)}
+	})},
+	choice[frameOp]{1, hegel.Composite(func(tc hegel.TestCase) frameOp {
+		return frameOp{
+			kind:    frLines,
+			y:       hegel.Draw(tc, positions),
+			insert:  hegel.Draw(tc, chance(50)),
+			k:       hegel.Draw(tc, hegel.Integers(1, 2)),
+			reprint: hegel.Draw(tc, chance(70)),
+			atEnd:   hegel.Draw(tc, chance(50)),
+			text:    hegel.Draw(tc, styledTexts),
+		}
+	})},
+	choice[frameOp]{1, hegel.Just(frameOp{kind: frErase})},
+	choice[frameOp]{1, hegel.Composite(func(tc hegel.TestCase) frameOp {
+		return frameOp{kind: frResize, nw: hegel.Draw(tc, hegel.Integers(2, 16)), nh: hegel.Draw(tc, hegel.Integers(1, 6))}
+	})},
+)
+
+var renderTerms = []string{"xterm", "xterm-256color", "xterm-kitty", "linux", "screen", "tmux-256color", "alacritty", "vt100", "foot", "ghostty", "rxvt"}
+
+// renderCase is a renderer's configuration and the frames it renders.
+type renderCase struct {
+	w, h   int
+	term   string
+	inline bool // the frame sits at the top of a taller terminal, the cursor moves relatively
+	scroll bool // the scroll optimisation
+	tabs   bool
+	bs     bool
+	erase  bool // Erase before the first frame
+	frames []frameOp
+}
+
+func (c renderCase) GoString() string {
+	return fmt.Sprintf("screen %dx%d term %s inline %v scroll %v tabs %v bs %v erase %v, frames %#v", c.w, c.h, c.term, c.inline, c.scroll, c.tabs, c.bs, c.erase, c.frames)
+}
+
+var renderCases = hegel.Composite(func(tc hegel.TestCase) renderCase {
+	return renderCase{
+		w:      hegel.Draw(tc, hegel.Integers(2, 16)),
+		h:      hegel.Draw(tc, hegel.Integers(1, 6)),
+		term:   hegel.Draw(tc, hegel.SampledFrom(renderTerms)),
+		inline: hegel.Draw(tc, chance(30)),
+		scroll: hegel.Draw(tc, chance(50)),
+		tabs:   hegel.Draw(tc, chance(40)),
+		bs:     hegel.Draw(tc, chance(40)),
+		erase:  hegel.Draw(tc, chance(50)),
+		frames: hegel.Draw(tc, many(frameOps, 1, 6)),
+	}
+})
+
+// repairOrphans blanks the cells hasOrphan objects to (a placeholder without a head, a head
+// without room or a placeholder), so that the frame is a reference again.
+func repairOrphans(scr uv.ScreenBuffer) {
+	for y, l := range scr.Lines {
+		covered := 0
+		for x := range l {
+			c := &l[x]
+			switch {
+			case covered > 0:
+				covered--
+				if !c.IsZero() {
+					scr.SetCell(x, y, nil)
+				}
+			case c.IsZero():
+				scr.SetCell(x, y, nil)
+			case c.Width > 1 && x+c.Width > len(l):
+				scr.SetCell(x, y, nil)
+			case c.Width > 1:
+				covered = c.Width - 1
+			}
+		}
+	}
+}
+
+// touchAll marks every row of the frame changed from end to end.
+func touchAll(scr uv.ScreenBuffer) {
+	for y := 0; y < scr.Height(); y++ {
+		scr.TouchLine(0, y, scr.Width()-1)
+	}
+}
+
+// compareScreen checks the emulator's screen against the rendered frame, then the renderer's
+// own record of the screen against it, and the renderer's cursor model against the terminal's.
+// shape names the recorded bug the frame or its rendering has the shape of. It returns false
+// when the case must stop because the terminal state is no longer a reference.
+func compareScreen(ht *hegel.T, what, shape string, r *uv.TerminalRenderer, newbuf *uv.RenderBuffer, e *vt.Emulator, chunk, transcript string) bool {
+	if irmOn.MatchString(chunk) {
+		// The vt emulator does not implement insert mode (IRM), which the renderer uses on
+		// terminals without ICH.
+		count("irm-emitted")
+		return false
+	}
+	w, h := newbuf.Width(), newbuf.Height()
+	for y := 0; y < h; y++ {
+		for x := 0; x < w; x++ {
+			c := newbuf.CellAt(x, y)
+			u := e.CellAt(x, y)
+			if c.IsZero() {
+				if u != nil && u.Width != 0 {
+					mismatch(ht, shape, "%s: (%d,%d) is a placeholder in the frame, emulator has %q w%d\nframe:\n%s\nemulator:\n%s\noutput %q", what, x, y, u.Content, u.Width, newbuf.String(), e.String(), transcript)
+				}
+				continue
+			}
+			if u == nil {
+				fail(ht, "%s: emulator has no cell at (%d,%d)", what, x, y)
+			}
+			if u.Content != c.Content || u.Width != c.Width {
+				mismatch(ht, shape, "%s: (%d,%d) frame %q w%d, emulator %q w%d\nframe:\n%s\nemulator:\n%s\noutput %q", what, x, y, c.Content, c.Width, u.Content, u.Width, newbuf.String(), e.String(), transcript)
+			}
+			// Bold, faint, italic, blink and the foreground colour are invisible on a
+			// blank; the renderer erases such cells with EL (background colour erase) and the
+			// emulator records them with the background only.
+			cs, us := c.Style, u.Style
+			if c.Content == " " {
+				invisible := uint8(uv.AttrBold | uv.AttrFaint | uv.AttrItalic | uv.AttrBlink | uv.AttrRapidBlink)
+				cs.Attrs &^= invisible
+				us.Attrs &^= invisible
+				cs.Fg, us.Fg = nil, nil
+				cs.UnderlineColor, us.UnderlineColor = nil, nil
+			}
+			if cs.Attrs != us.Attrs || cs.Underline != us.Underline ||
+				!colorEqual(cs.Fg, us.Fg) || !colorEqual(cs.Bg, us.Bg) || !colorEqual(cs.UnderlineColor, us.UnderlineColor) {
+				mismatch(ht, shape, "%s: (%d,%d) %q style %s, emulator %s\nframe:\n%s\noutput %q", what, x, y, c.Content, styleString(c.Style), styleString(u.Style), newbuf.String(), transcript)
+			}
+			if c.Link != u.Link {
+				linkShape := shape
+				if !c.Link.IsZero() && u.Link.IsZero() && strings.Contains(chunk, "\x1b]8;;\a") {
+					// The renderer reset the terminal's hyperlink without forgetting it
+					// in its pen, so the next cell with that link is drawn without one.
+					linkShape = shapes(shape, "ultraviolet/24")
+				}
+				mismatch(ht, linkShape, "%s: (%d,%d) %q link %v, emulator %v\noutput %q", what, x, y, c.Content, c.Link, u.Link, transcript)
+			}
+		}
+	}
+	// The renderer's record of the screen now equals the frame.
+	cur := uv.RendererCurbufT(r)
+	if cur == nil {
+		// Nothing was rendered yet (no touched line): the renderer has no record.
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				if !cellEqual(newbuf.CellAt(x, y), &uv.EmptyCell) {
+					mismatch(ht, shape, "%s: nothing rendered but the frame has %s at (%d,%d)", what, cellString(newbuf.CellAt(x, y)), x, y)
+				}
+			}
+		}
+		return true
+	}
+	for y := 0; y < h; y++ {
+		for x := 0; x < w; x++ {
+			if !cellEqual(cur.CellAt(x, y), newbuf.CellAt(x, y)) {
+				mismatch(ht, shape, "%s: after Render the current buffer (%d,%d) = %s, frame %s\noutput %q", what, x, y, cellString(cur.CellAt(x, y)), cellString(newbuf.CellAt(x, y)), transcript)
+			}
+		}
+	}
+	// The renderer's cursor model agrees with the terminal when it claims to know it.
+	if cx, cy := r.Position(); !uv.RendererAtPhantomT(r) && cx >= 0 && cy >= 0 && cx < w && cy < h {
+		if pos := e.CursorPosition(); pos.X != cx || pos.Y != cy {
+			mismatch(ht, shape, "%s: renderer believes the cursor is at (%d,%d), emulator has it at (%d,%d)\noutput %q", what, cx, cy, pos.X, pos.Y, transcript)
+		}
+	}
+	return true
+}
+
+// TestHegelRendererDrawsWhatTheEmulatorShows: after every rendered frame the emulator shows
+// the frame, the renderer's record of the screen equals it and its cursor model agrees with
+// the terminal.
+func TestHegelRendererDrawsWhatTheEmulatorShows(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, renderCases)
+		w, h := c.w, c.h
+		var out bytes.Buffer
+		r := uv.NewTerminalRenderer(&out, []string{"TERM=" + c.term})
+		r.SetColorProfile(colorprofile.TrueColor)
+		r.SetWidthMethod(ansi.WcWidth)
+		// Inline mode: the frame sits at the top of a taller terminal, the renderer moves the
+		// cursor relative to where it left it.
+		r.SetFullscreen(!c.inline)
+		r.SetRelativeCursor(c.inline)
+		r.SetScrollOptim(c.scroll)
+		if c.tabs {
+			r.SetTabStops(w)
+		}
+		r.SetBackspace(c.bs)
+		if c.erase {
+			r.Erase()
+		}
+		scr := uv.NewScreenBuffer(w, h)
+		extra := 0
+		if c.inline {
+			extra = 3
+		}
+		e := vt.NewEmulator(w, h+extra)
+		var transcript string
+		for i, op := range c.frames {
+			switch op.kind {
+			case frPrintTop:
+				text := op.text.render(w, 1+op.n%(h+1))
+				note(ht, "printAt(0,0,%q)", text)
+				printAt(scr, 0, 0, text)
+			case frPrintAt:
+				text := op.text.render(w, 1+op.n%2)
+				x, y := op.x%w, op.y%h
+				note(ht, "printAt(%d,%d,%q)", x, y, text)
+				printAt(scr, x, y, text)
+			case frSetCells:
+				for _, s := range op.cells {
+					x, y := s.x%w, s.y%h
+					note(ht, "SetCell(%d,%d,%s)", x, y, cellString(s.cell))
+					scr.SetCell(x, y, s.cell)
+				}
+			case frFill:
+				a := op.rect.in(w, h)
+				note(ht, "FillArea(%s,%v)", cellString(op.cell), a)
+				scr.FillArea(op.cell, a)
+			case frClear:
+				a := op.rect.in(w, h)
+				note(ht, "ClearArea(%v)", a)
+				scr.ClearArea(a)
+			case frLines:
+				y := op.y % h
+				if op.insert {
+					note(ht, "InsertLine(%d,%d)", y, op.k)
+					scr.InsertLine(y, op.k, nil)
+				} else {
+					note(ht, "DeleteLine(%d,%d)", y, op.k)
+					scr.DeleteLine(y, op.k, nil)
+				}
+				if op.reprint {
+					text := op.text.render(w, 1)
+					if op.atEnd {
+						y = h - 1
+					}
+					note(ht, "printAt(0,%d,%q)", y, text)
+					printAt(scr, 0, y, text)
+				}
+			case frErase:
+				note(ht, "Erase")
+				r.Erase()
+			case frResize:
+				if c.inline {
+					note(ht, "Erase")
+					r.Erase()
+					break
+				}
+				// A terminal resize in fullscreen: the model, the renderer and the
+				// terminal all learn the new size.
+				w, h = op.nw, op.nh
+				note(ht, "Resize(%d,%d)", w, h)
+				scr.Resize(w, h)
+				r.Resize(w, h)
+				e.Resize(w, h)
+			}
+			shape := ""
+			if hasOrphan(scr.Buffer) {
+				// A wide cell written over the placeholder of one wide cell and the head of
+				// another left an orphan placeholder in the frame (ultraviolet/22).
+				shape = "ultraviolet/22"
+				if known(shape) {
+					repairOrphans(scr)
+					shape = ""
+				}
+			}
+			untouched := untouchedRows(scr.RenderBuffer)
+			if untouched && c.scroll && known("ultraviolet/25") {
+				// The scroll optimisation may move a row the frame did not touch; under
+				// HEGEL_NO_KNOWN=1 every row is marked touched, so it is repainted.
+				touchAll(scr)
+				untouched = false
+			}
+			r.Render(scr.RenderBuffer)
+			if err := r.Flush(); err != nil {
+				fail(ht, "Flush: %v", err)
+			}
+			chunk := out.String()
+			out.Reset()
+			transcript += chunk
+			if _, err := e.WriteString(chunk); err != nil {
+				fail(ht, "emulator write: %v", err)
+			}
+			if c.scroll && untouched && scrollSeq.MatchString(chunk) {
+				// The frame was rendered with the scroll optimisation moving rows while some
+				// row was untouched (ultraviolet/25).
+				shape = shapes(shape, "ultraviolet/25")
+			}
+			if !compareScreen(ht, fmt.Sprintf("frame %d", i), shape, r, scr.RenderBuffer, e, chunk, transcript) {
+				return
+			}
+		}
+		count("ok")
+	})
+}
