+	return keyTable{hegel.Draw(tc, legacyEncodings), hegel.Draw(tc, hegel.SampledFrom(terminfoTerms)), true}
+}), func(kt keyTable) bool { return len(kt.terminfoEntries()) > 0 }), func(kt keyTable) hegel.Generator[tableCase] {
