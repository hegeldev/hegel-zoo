new file mode 100644
index 0000000..cf4cf5d
--- /dev/null
+++ b/hegel_screen_test.go
@@ -0,0 +1,1429 @@
+package uv_test
+
+// TerminalScreen's bookkeeping against the bytes it flushes and the x/vt emulator, and
+// TabStops against a model.
+//
+// TerminalScreen records what the application asked for (alt screen, cursor, colours, modes,
+// title, keyboard enhancements, progress bar) and queues the escape sequences that ask the
+// terminal for it; Terminal.Start replays the record with Restore and Terminal.Stop undoes it
+// with Reset. A random list of setters is run against a model of the requests; after every
+// Flush the sequences are read back (a small tracker of the modes the terminal would be in,
+// since x/vt models few of them) and must agree with the model, the getters must agree with
+// the model, and the emulator's screen must show the frame where the renderer believes it is.
+// Reset must leave the tracker at the terminal's defaults, Restore must bring it back, and
+// InsertAbove must put its lines above an intact frame.
+//
+// The recorded bugs (ultraviolet/27 to /34) are drawn at their natural rate and a
+// disagreement names the shape; under HEGEL_NO_KNOWN=1 the step or check a shape would falsify
+// is counted and skipped, or the step is turned into its neighbour (ShowCursor before a cursor
+// style, a line one column short of the width, the flags a constructor keeps, an interval of 8).
+
+import (
+	"bytes"
+	"fmt"
+	"image/color"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/colorprofile"
+	uv "github.com/charmbracelet/ultraviolet"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/vt"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- tracker
+
+// termTracker is the state a terminal would be in after the flushed bytes, read back from the
+// sequences themselves. Mouse tracking and its encoding follow xterm: the last DECSET of a
+// tracking mode wins and a DECRST of any of them turns tracking off.
+type termTracker struct {
+	alt, visible, paste bool
+	sync                int // nesting of mode 2026 inside one flush; back to 0 at its end
+	mouse               uv.MouseMode
+	enc                 uv.MouseEncoding
+	style               int // as encoded by DECSCUSR; 0 and 1 are both the blinking block
+	cursorColor, bg, fg string
+	title               string
+	kitty               int
+	progress            string // "0" none, "3" indeterminate, "state;value" otherwise
+	tabsReset           bool
+	unknown             []string
+	transcript          string
+}
+
+func newTracker() *termTracker { return &termTracker{visible: true, progress: "0"} }
+
+func (tk *termTracker) mode(m int, on bool) {
+	switch m {
+	case 1049:
+		tk.alt = on
+	case 25:
+		tk.visible = on
+	case 2004:
+		tk.paste = on
+	case 9, 1000, 1002, 1003:
+		if !on {
+			tk.mouse = uv.MouseModeNone
+			return
+		}
+		tk.mouse = map[int]uv.MouseMode{9: uv.MouseModePress, 1000: uv.MouseModeClick, 1002: uv.MouseModeDrag, 1003: uv.MouseModeMotion}[m]
+	case 1006, 1016, 1015:
+		if !on {
+			tk.enc = uv.MouseEncodingLegacy
+			return
+		}
+		if m == 1006 {
+			tk.enc = uv.MouseEncodingSGR
+		} else {
+			tk.enc = uv.MouseEncodingSGRPixel
+		}
+	case 2026:
+		if on {
+			tk.sync++
+		} else {
+			tk.sync--
+		}
+	case 2027:
+		// Unicode core mode: requested by Terminal.Start, set by enableGraphemeWidth.
+	case 7:
+		// Autowrap: the renderer turns it off around a write to the last column.
+	default:
+		tk.unknown = append(tk.unknown, fmt.Sprintf("mode %d %v", m, on))
+	}
+}
+
+func (tk *termTracker) feed(out string) {
+	tk.transcript += out
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var state byte
+	for len(out) > 0 {
+		seq, _, k, ns := ansi.DecodeSequence(out, state, p)
+		switch {
+		case ansi.HasCsiPrefix(seq):
+			cmd := ansi.Cmd(p.Command())
+			switch {
+			case cmd.Prefix() == '?' && (cmd.Final() == 'h' || cmd.Final() == 'l'):
+				for i := 0; i < len(p.Params()); i++ {
+					m, _ := p.Param(i, 0)
+					tk.mode(m, cmd.Final() == 'h')
+				}
+			case cmd.Prefix() == '=' && cmd.Final() == 'u':
+				flags, _ := p.Param(0, 0)
+				tk.kitty = flags
+			case cmd.Intermediate() == ' ' && cmd.Final() == 'q':
+				tk.style, _ = p.Param(0, 0)
+			case cmd.Prefix() == '?' && cmd.Final() == 'W':
+				if v, _ := p.Param(0, 0); v == 5 {
+					tk.tabsReset = true
+				}
+			}
+		case ansi.HasOscPrefix(seq):
+			cmd, rest, _ := strings.Cut(string(p.Data()), ";")
+			switch cmd {
+			case "0", "2":
+				tk.title = rest
+			case "10":
+				tk.fg = rest
+			case "11":
+				tk.bg = rest
+			case "12":
+				tk.cursorColor = rest
+			case "110":
+				tk.fg = ""
+			case "111":
+				tk.bg = ""
+			case "112":
+				tk.cursorColor = ""
+			case "9":
+				if strings.HasPrefix(rest, "4;") {
+					tk.progress = rest[2:]
+				}
+			}
+		}
+		out = out[k:]
+		state = ns
+	}
+}
+
+// ---------------------------------------------------------------- model
+
+// screenModel is what the application asked the screen for.
+type screenModel struct {
+	alt, visible, paste, sync bool
+	mouse                     uv.MouseMode
+	enc                       uv.MouseEncoding
+	shape                     uv.CursorShape
+	blink, styleSet           bool
+	cursorColor, bg, fg       color.Color
+	title                     string
+	kitty                     *uv.KeyboardEnhancements
+	kittyFlags                int // the flags asked for (NewKeyboardEnhancements keeps fewer: ultraviolet/33)
+	kittySet                  bool
+	progress                  *uv.ProgressBar
+	progressSet               bool
+	x, y                      int
+	cursorObj                 bool // the screen holds a Cursor (Show, SetCursorPosition, style or colour)
+}
+
+func newScreenModel() *screenModel {
+	return &screenModel{blink: true, x: -1, y: -1}
+}
+
+func hexOf(c color.Color) string {
+	if c == nil {
+		return ""
+	}
+	r, g, b, _ := c.RGBA()
+	return fmt.Sprintf("#%02x%02x%02x", r>>8, g>>8, b>>8)
+}
+
+func progressString(pb *uv.ProgressBar) string {
+	if pb == nil || pb.State == uv.ProgressBarNone {
+		return "0"
+	}
+	if pb.State == uv.ProgressBarIndeterminate {
+		return "3"
+	}
+	return fmt.Sprintf("%d;%d", int(pb.State), min(max(pb.Value, 0), 100))
+}
+
+// terminalDiffers returns the differences between what the application asked for and what the
+// flushed bytes established; defaults says the terminal should instead be at its defaults
+// (after Reset).
+func (m *screenModel) terminalDiffers(tk *termTracker, defaults bool) []string {
+	var diffs []string
+	check := func(name string, want, got any) {
+		if fmt.Sprint(want) != fmt.Sprint(got) {
+			diffs = append(diffs, fmt.Sprintf("%s: asked %v, terminal has %v", name, want, got))
+		}
+	}
+	if defaults {
+		check("alt screen", false, tk.alt)
+		check("cursor visible", true, tk.visible)
+		check("bracketed paste", false, tk.paste)
+		check("mouse mode", uv.MouseModeNone, tk.mouse)
+		check("mouse encoding", uv.MouseEncodingLegacy, tk.enc)
+		if tk.style > 1 {
+			check("cursor style", "default", tk.style)
+		}
+		check("cursor colour", "", tk.cursorColor)
+		check("background", "", tk.bg)
+		check("foreground", "", tk.fg)
+		check("title", "", tk.title)
+		check("kitty flags", 0, tk.kitty)
+		check("progress bar", "0", tk.progress)
+		return diffs
+	}
+	check("alt screen", m.alt, tk.alt)
+	check("cursor visible", m.visible, tk.visible)
+	check("bracketed paste", m.paste, tk.paste)
+	check("mouse mode", m.mouse, tk.mouse)
+	check("mouse encoding", m.enc, tk.enc)
+	if m.styleSet {
+		check("cursor style", m.shape.Encode(m.blink), tk.style)
+	} else if tk.style > 1 {
+		check("cursor style", "default", tk.style)
+	}
+	check("cursor colour", hexOf(m.cursorColor), tk.cursorColor)
+	check("background", hexOf(m.bg), tk.bg)
+	check("foreground", hexOf(m.fg), tk.fg)
+	check("title", m.title, tk.title)
+	check("kitty flags", m.kittyFlags, tk.kitty)
+	check("progress bar", progressString(m.progress), tk.progress)
+	return diffs
+}
+
+// gettersDiffer returns the differences between the model and the screen's getters.
+func (m *screenModel) gettersDiffer(s *uv.TerminalScreen) []string {
+	var diffs []string
+	check := func(name string, want, got any) {
+		if fmt.Sprint(want) != fmt.Sprint(got) {
+			diffs = append(diffs, fmt.Sprintf("%s: asked %v, getter says %v", name, want, got))
+		}
+	}
+	check("AltScreen", m.alt, s.AltScreen())
+	check("CursorVisible", m.visible, s.CursorVisible())
+	check("BracketedPaste", m.paste, s.BracketedPaste())
+	check("SynchronizedUpdates", m.sync, s.SynchronizedUpdates())
+	check("MouseMode", m.mouse, s.MouseMode())
+	check("MouseEncoding", m.enc, s.MouseEncoding())
+	shape, blink := s.CursorStyle()
+	check("CursorStyle", fmt.Sprint(m.shape, m.blink), fmt.Sprint(shape, blink))
+	if !colorEqual(m.cursorColor, s.CursorColor()) {
+		check("CursorColor", m.cursorColor, s.CursorColor())
+	}
+	if !colorEqual(m.bg, s.BackgroundColor()) {
+		check("BackgroundColor", m.bg, s.BackgroundColor())
+	}
+	if !colorEqual(m.fg, s.ForegroundColor()) {
+		check("ForegroundColor", m.fg, s.ForegroundColor())
+	}
+	check("WindowTitle", m.title, s.WindowTitle())
+	if m.kitty != s.KeyboardEnhancements() {
+		check("KeyboardEnhancements", m.kitty, s.KeyboardEnhancements())
+	}
+	if m.progress != s.ProgressBar() {
+		check("ProgressBar", m.progress, s.ProgressBar())
+	}
+	x, y := s.CursorPosition()
+	check("CursorPosition", fmt.Sprint(m.x, m.y), fmt.Sprint(x, y))
+	return diffs
+}
+
+// ---------------------------------------------------------------- frame
+
+// frameCells copies the screen's cells (the frame the renderer is asked to show).
+func frameCells(s *uv.TerminalScreen) [][]uv.Cell {
+	w, h := s.Width(), s.Height()
+	out := make([][]uv.Cell, h)
+	for y := 0; y < h; y++ {
+		out[y] = make([]uv.Cell, w)
+		for x := 0; x < w; x++ {
+			if c := s.CellAt(x, y); c != nil {
+				out[y][x] = *c
+			}
+		}
+	}
+	return out
+}
+
+// frameDiffers compares the emulator's rows from top with the frame: content, width and the
+// visible part of the style (bold, faint, italic, blink and the foreground are invisible on a
+// blank).
+func frameDiffers(e *vt.Emulator, top int, frame [][]uv.Cell) string {
+	for y, row := range frame {
+		for x, c := range row {
+			u := e.CellAt(x, top+y)
+			if c.IsZero() {
+				if u != nil && u.Width != 0 {
+					return fmt.Sprintf("(%d,%d) is a placeholder in the frame, emulator has %q w%d", x, y, u.Content, u.Width)
+				}
+				continue
+			}
+			if u == nil {
+				return fmt.Sprintf("emulator has no cell at (%d,%d)", x, top+y)
+			}
+			if u.Content != c.Content || u.Width != c.Width {
+				return fmt.Sprintf("(%d,%d) frame %q w%d, emulator %q w%d", x, y, c.Content, c.Width, u.Content, u.Width)
+			}
+			cs, us := c.Style, u.Style
+			if c.Content == " " {
+				invisible := uint8(uv.AttrBold | uv.AttrFaint | uv.AttrItalic | uv.AttrBlink | uv.AttrRapidBlink)
+				cs.Attrs &^= invisible
+				us.Attrs &^= invisible
+				cs.Fg, us.Fg = nil, nil
+				cs.UnderlineColor, us.UnderlineColor = nil, nil
+			}
+			if cs.Attrs != us.Attrs || cs.Underline != us.Underline ||
+				!colorEqual(cs.Fg, us.Fg) || !colorEqual(cs.Bg, us.Bg) || !colorEqual(cs.UnderlineColor, us.UnderlineColor) {
+				return fmt.Sprintf("(%d,%d) %q style %s, emulator %s", x, y, c.Content, styleString(c.Style), styleString(u.Style))
+			}
+		}
+	}
+	return ""
+}
+
+// emulatorCells copies the emulator's rows from top as a frame for frameDiffers.
+func emulatorCells(e *vt.Emulator, top, w, h int) [][]uv.Cell {
+	out := make([][]uv.Cell, h)
+	for y := 0; y < h; y++ {
+		out[y] = make([]uv.Cell, w)
+		for x := 0; x < w; x++ {
+			if c := e.CellAt(x, top+y); c != nil {
+				out[y][x] = *c
+			}
+		}
+	}
+	return out
+}
+
+func emulatorRows(e *vt.Emulator, from, to int) string {
+	var sb strings.Builder
+	for y := from; y < to && y < e.Height(); y++ {
+		if y < 0 {
+			continue
+		}
+		fmt.Fprintf(&sb, "%2d|", y)
+		for x := 0; x < e.Width(); x++ {
+			if c := e.CellAt(x, y); c != nil && c.Width > 0 {
+				sb.WriteString(c.Content)
+			}
+		}
+		sb.WriteString("|\n")
+	}
+	return sb.String()
+}
+
+// ---------------------------------------------------------------- generators
+
+// lettersFrom turns bytes into capital letters.
+func lettersFrom(b []byte) []byte {
+	out := make([]byte, len(b))
+	for i, x := range b {
+		out[i] = 'A' + x%26
+	}
+	return out
+}
+
+// letters is a pool of capital letters, cycled for lines of a drawn width.
+var letters = hegel.Map(hegel.Binary(1, 40), lettersFrom)
+
+// titles: none once in four, otherwise one to eight letters.
+var titles = maybe(75, hegel.Map(hegel.Binary(1, 8), func(b []byte) string { return string(lettersFrom(b)) }))
+
+// lettersOf writes width letters from the pool.
+func lettersOf(pool []byte, width int) string {
+	var sb strings.Builder
+	for i := 0; i < width; i++ {
+		sb.WriteByte(at(pool, i))
+	}
+	return sb.String()
+}
+
+var rgb = hegel.Map(hegel.Binary(3, 3), func(b []byte) color.Color { return color.RGBA{b[0], b[1], b[2], 255} })
+
+// colours: none three times in ten, a true colour otherwise.
+var colours = maybe(70, rgb)
+
+// plainPiece is one element of plain text: a letter, a space, an SGR sequence or a reset.
+type plainPiece struct {
+	kind   int // 0 letter, 1 space, 2 style, 3 reset
+	letter byte
+	style  uv.Style
+}
+
+func (p plainPiece) String() string {
+	switch p.kind {
+	case 1:
+		return " "
+	case 2:
+		return p.style.String()
+	case 3:
+		return "\x1b[m"
+	}
+	return string(p.letter)
+}
+
+var plainPieces = hegel.Composite(func(tc hegel.TestCase) plainPiece {
+	return plainPiece{
+		kind:   hegel.Draw(tc, weighted(choice[int]{4, hegel.Just(0)}, choice[int]{1, hegel.Just(1)}, choice[int]{1, hegel.Just(2)}, choice[int]{1, hegel.Just(3)})),
+		letter: hegel.Draw(tc, hegel.Map(hegel.Integers(0, 25), func(n int) byte { return byte('a' + n) })),
+		style:  hegel.Draw(tc, styles),
+	}
+})
+
+// plainText is lines of letters, spaces and SGR sequences without wide graphemes, rendered
+// for a width (up to w+1 pieces a line) and a number of lines.
+type plainText struct {
+	lines [][]plainPiece // 1 to 9
+}
+
+var plainTexts = hegel.Map(many(many(plainPieces, 0, 21), 1, 9), func(ls [][]plainPiece) plainText { return plainText{ls} })
+
+func (t plainText) render(w, n int) string {
+	var sb strings.Builder
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			sb.WriteString("\n")
+		}
+		l := at(t.lines, i)
+		for _, p := range l[:min(len(l), w+1)] {
+			sb.WriteString(p.String())
+		}
+	}
+	return sb.String()
+}
+
+// enhancementSpec is a keyboard enhancements request: none, a struct of flags, or one built by
+// NewKeyboardEnhancements from a flag set (which keeps two of the five flags: ultraviolet/33;
+// under HEGEL_NO_KNOWN=1 only those two are asked for that way).
+type enhancementSpec struct {
+	set      bool
+	viaFlags bool
+	flags    int
+	fields   [5]bool
+}
+
+var enhancementSpecs = hegel.Composite(func(tc hegel.TestCase) enhancementSpec {
+	return enhancementSpec{
+		set:      hegel.Draw(tc, chance(80)),
+		viaFlags: hegel.Draw(tc, chance(30)),
+		flags:    hegel.Draw(tc, shaped(hegel.Integers(0, 31), hegel.Integers(0, 3))),
+		fields:   [5]bool{hegel.Draw(tc, chance(60)), hegel.Draw(tc, chance(40)), hegel.Draw(tc, chance(30)), hegel.Draw(tc, chance(30)), hegel.Draw(tc, chance(30))},
+	}
+})
+
+// build gives the request, the flags asked for and the shape ("" or ultraviolet/33 when the
+// constructor is asked for flags it drops).
+func (e enhancementSpec) build() (ke *uv.KeyboardEnhancements, flags int, shape string) {
+	switch {
+	case !e.set:
+		return nil, 0, ""
+	case e.viaFlags:
+		ke = uv.NewKeyboardEnhancements(e.flags)
+		if ke.Flags() != e.flags {
+			shape = "ultraviolet/33"
+		}
+		return ke, e.flags, shape
+	}
+	ke = &uv.KeyboardEnhancements{
+		DisambiguateEscapeCodes:    e.fields[0],
+		ReportEventTypes:           e.fields[1],
+		ReportAlternateKeys:        e.fields[2],
+		ReportAllKeysAsEscapeCodes: e.fields[3],
+		ReportAssociatedText:       e.fields[4],
+	}
+	return ke, ke.Flags(), ""
+}
+
+// progressBars: none once in five, otherwise any state with a value that may be out of range.
+var progressBars = maybe(80, hegel.Composite(func(tc hegel.TestCase) *uv.ProgressBar {
+	return &uv.ProgressBar{
+		State: uv.ProgressBarState(hegel.Draw(tc, hegel.Integers(0, 4))),
+		Value: hegel.Draw(tc, hegel.Integers(-5, 105)),
+	}
+}))
+
+// aboveLine is one line for InsertAbove: its width as a position (0 to 2w+1), or exactly the
+// width or twice it once in ten (the shape of ultraviolet/31; under HEGEL_NO_KNOWN=1 such a
+// line is one letter short), and its letters.
+type aboveLine struct {
+	pos   int
+	full  bool
+	twice bool
+	pool  []byte
+}
+
+var aboveLines = hegel.Composite(func(tc hegel.TestCase) aboveLine {
+	return aboveLine{
+		pos:   hegel.Draw(tc, positions),
+		full:  hegel.Draw(tc, chance(10)),
+		twice: hegel.Draw(tc, chance(50)),
+		pool:  hegel.Draw(tc, letters),
+	}
+})
+
+func (l aboveLine) width(w int) int {
+	width := l.pos % (2*w + 2)
+	if l.full {
+		width = w
+		if l.twice {
+			width = 2 * w
+		}
+	}
+	if noKnown && width > 0 && width%w == 0 {
+		width--
+	}
+	return width
+}
+
+// cellSets for the screen: narrow cells at positions.
+var screenCellSets = hegel.Composite(func(tc hegel.TestCase) cellSet {
+	return cellSet{hegel.Draw(tc, positions), hegel.Draw(tc, positions), hegel.Draw(tc, uv.CellsWithT(uv.NarrowGraphemesT, links))}
+})
+
+type screenOpKind int
+
+const (
+	scEnterAlt screenOpKind = iota
+	scExitAlt
+	scHideCursor
+	scShowCursor
+	scCursorPosition
+	scCursorStyle
+	scCursorColor
+	scBackground
+	scForeground
+	scBracketedPaste
+	scMouseMode
+	scMouseEncoding
+	scTitle
+	scKeyboard
+	scProgress
+	scSync
+	scCells
+	scDisplayText
+	scInsertAbove
+	scFlush
+)
+
+var screenOpNames = []string{"EnterAltScreen", "ExitAltScreen", "HideCursor", "ShowCursor", "SetCursorPosition", "SetCursorStyle", "SetCursorColor", "SetBackgroundColor", "SetForegroundColor", "BracketedPaste", "SetMouseMode", "SetMouseEncoding", "SetWindowTitle", "SetKeyboardEnhancements", "SetProgressBar", "SetSynchronizedUpdates", "SetCells", "Display", "InsertAbove", "Flush"}
+
+// screenOp is one request to the screen, its arguments drawn as positions resolved against
+// the live size.
+type screenOp struct {
+	kind       screenOpKind
+	x, y       int // positions
+	shape      uv.CursorShape
+	blink      bool
+	colour     color.Color
+	on         bool // BracketedPaste: enable (six times in ten); SynchronizedUpdates: on
+	mode       uv.MouseMode
+	enc        uv.MouseEncoding
+	title      string
+	ke         enhancementSpec
+	pb         *uv.ProgressBar
+	cells      []cellSet // 1 to 5
+	text       plainText
+	n          int         // position: the lines of text
+	above      []aboveLine // 1 to 3
+	flushAfter bool        // six times in ten
+}
+
+func (op screenOp) GoString() string { return screenOpNames[op.kind] }
+
+// screenRequests: every setter once, cells twice, a bare Flush three times in 23; each draws
+// only its own arguments.
+var screenRequests = weighted(
+	choice[screenOp]{4, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: hegel.Draw(tc, hegel.SampledFrom([]screenOpKind{scEnterAlt, scExitAlt, scHideCursor, scShowCursor}))}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scCursorPosition, x: hegel.Draw(tc, positions), y: hegel.Draw(tc, positions)}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scCursorStyle, shape: uv.CursorShape(hegel.Draw(tc, hegel.Integers(0, 2))), blink: hegel.Draw(tc, chance(50))}
+	})},
+	choice[screenOp]{3, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{
+			kind:   hegel.Draw(tc, hegel.SampledFrom([]screenOpKind{scCursorColor, scBackground, scForeground})),
+			colour: hegel.Draw(tc, colours),
+		}
+	})},
+	choice[screenOp]{2, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: hegel.Draw(tc, hegel.SampledFrom([]screenOpKind{scBracketedPaste, scSync})), on: hegel.Draw(tc, chance(60))}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scMouseMode, mode: uv.MouseMode(hegel.Draw(tc, hegel.Integers(0, 4)))}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scMouseEncoding, enc: uv.MouseEncoding(hegel.Draw(tc, hegel.Integers(0, 2)))}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scTitle, title: hegel.Draw(tc, titles)}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scKeyboard, ke: hegel.Draw(tc, enhancementSpecs)}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scProgress, pb: hegel.Draw(tc, progressBars)}
+	})},
+	choice[screenOp]{2, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scCells, cells: hegel.Draw(tc, many(screenCellSets, 1, 5))}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scDisplayText, text: hegel.Draw(tc, plainTexts), n: hegel.Draw(tc, positions)}
+	})},
+	choice[screenOp]{1, hegel.Composite(func(tc hegel.TestCase) screenOp {
+		return screenOp{kind: scInsertAbove, above: hegel.Draw(tc, many(aboveLines, 1, 3))}
+	})},
+	choice[screenOp]{3, hegel.Just(screenOp{kind: scFlush})},
+)
+
+// screenOps: a request, flushed afterwards six times in ten.
+var screenOps = hegel.Composite(func(tc hegel.TestCase) screenOp {
+	op := hegel.Draw(tc, screenRequests)
+	op.flushAfter = hegel.Draw(tc, chance(60))
+	return op
+})
+
+// screenCase is a screen, the terminal it writes to (taller by extra rows) and the requests.
+type screenCase struct {
+	w, h      int
+	extra     int
+	showFirst bool       // the program shows the cursor before anything else (half the time)
+	ops       []screenOp // 1 to 25
+}
+
+func (c screenCase) GoString() string {
+	first := ""
+	if c.showFirst {
+		first = "ShowCursor first, "
+	}
+	return fmt.Sprintf("screen %dx%d, terminal %dx%d, %s%#v", c.w, c.h, c.w, c.h+c.extra, first, c.ops)
+}
+
+var screenCases = hegel.Composite(func(tc hegel.TestCase) screenCase {
+	return screenCase{
+		w:     hegel.Draw(tc, hegel.Integers(2, 20)),
+		h:     hegel.Draw(tc, hegel.Integers(1, 8)),
+		extra: hegel.Draw(tc, hegel.Integers(0, 6)),
+		// Without it a cursor style or colour makes the cursor (ultraviolet/29).
+		showFirst: hegel.Draw(tc, shaped(chance(50), hegel.Just(true))),
+		ops:       hegel.Draw(tc, many(screenOps, 1, 25)),
+	}
+})
+
+// ---------------------------------------------------------------- properties
+
+// TestHegelScreenKeepsItsWord: TerminalScreen's getters, its flushed sequences and the
+// emulator's screen all follow the model through a random list of setters, a Reset leaves the
+// terminal at its defaults, and a Restore brings the requests back.
+func TestHegelScreenKeepsItsWord(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, screenCases)
+		w, h := c.w, c.h
+		H := h + c.extra
+		var out bytes.Buffer
+		s := uv.NewTerminalScreen(&out, []string{"TERM=xterm-256color"})
+		s.SetColorProfile(colorprofile.TrueColor)
+		s.SetWidthMethod(ansi.WcWidth)
+		s.Resize(w, h)
+		m := newScreenModel()
+		tk := newTracker()
+		e := vt.NewEmulator(w, H)
+		top := 0 // the emulator row of the frame's first row in inline mode
+		// sticky holds the shapes of the recorded bugs the case has run into, which every later
+		// disagreement may be a consequence of.
+		var sticky []string
+		shape := func(extra ...string) string { return shapes(append(slices.Clone(sticky), extra...)...) }
+
+		frameTop := func() int {
+			if m.alt {
+				return 0
+			}
+			return top
+		}
+		// pendingMove reports whether the renderer believes the cursor is somewhere the
+		// terminal's is not: a move Flush queued in the renderer that has not been written
+		// (ultraviolet/27). Only meaningful right after a flush.
+		pendingMove := func() bool {
+			r := uv.ScreenRendererT(s)
+			rx, ry := r.Position()
+			pos := e.CursorPosition()
+			if ry != pos.Y-frameTop() {
+				return true
+			}
+			return rx != pos.X && !(rx >= w-1 && pos.X == w-1)
+		}
+		// feed writes what the screen emitted to the tracker and the emulator.
+		feed := func(what string) string {
+			chunk := out.String()
+			out.Reset()
+			tk.feed(chunk)
+			if _, err := e.WriteString(chunk); err != nil {
+				fail(ht, "%s: emulator: %v", what, err)
+			}
+			return chunk
+		}
+		// flush commits the queue, feeds it to the tracker and the emulator, and checks the
+		// three views against the model.
+		flush := func(what string) {
+			if err := s.Flush(); err != nil {
+				fail(ht, "%s: Flush: %v", what, err)
+			}
+			chunk := feed(what)
+			if len(chunk) > 0 {
+				if m.sync {
+					if !strings.HasPrefix(chunk, ansi.SetModeSynchronizedOutput) || !strings.HasSuffix(chunk, ansi.ResetModeSynchronizedOutput) {
+						mismatch(ht, shape(), "%s: synchronized updates on but the flush is not wrapped in mode 2026: %q", what, chunk)
+					}
+				} else if m.visible {
+					if !strings.HasPrefix(chunk, ansi.HideCursor) || !strings.HasSuffix(chunk, ansi.ShowCursor) {
+						mismatch(ht, shape(), "%s: cursor visible but the flush is not wrapped in hide/show: %q", what, chunk)
+					}
+				}
+			}
+			if tk.sync != 0 {
+				mismatch(ht, shape(), "%s: mode 2026 left at depth %d: %q", what, tk.sync, chunk)
+			}
+			if len(tk.unknown) > 0 {
+				mismatch(ht, shape(), "%s: unexpected modes %v in %q", what, tk.unknown, chunk)
+			}
+			if d := m.gettersDiffer(s); len(d) > 0 {
+				mismatch(ht, shape(), "%s: getters disagree with the requests:\n  %s", what, strings.Join(d, "\n  "))
+			}
+			if d := m.terminalDiffers(tk, false); len(d) > 0 {
+				mismatch(ht, shape(), "%s: the terminal disagrees with the requests:\n  %s\nflushed %q", what, strings.Join(d, "\n  "), chunk)
+			}
+			if e.IsAltScreen() != m.alt {
+				mismatch(ht, shape(), "%s: emulator alt screen %v, asked %v", what, e.IsAltScreen(), m.alt)
+			}
+			if m.visible && m.x >= 0 && m.y >= 0 && m.x < w && m.y < h && frameTop()+m.y < H {
+				// The requested cursor position has been flushed, so the terminal's cursor
+				// is there (Flush queues the move in the renderer and only the next Render
+				// commits it: ultraviolet/27; under HEGEL_NO_KNOWN=1 the check is skipped
+				// while a move is queued).
+				queued := noKnown && pendingMove()
+				if queued {
+					count("ultraviolet/27-skipped")
+				}
+				if pos := e.CursorPosition(); !queued && (pos.X != m.x || pos.Y != frameTop()+m.y) {
+					mismatch(ht, shape("ultraviolet/27"), "%s: cursor asked at (%d,%d) = row %d, the terminal has it at (%d,%d)\nflushed %q", what, m.x, m.y, frameTop()+m.y, pos.X, pos.Y, chunk)
+				}
+			}
+		}
+		display := func(what string, text uv.Drawable) {
+			if err := s.Display(text); err != nil {
+				fail(ht, "%s: Display: %v", what, err)
+			}
+			chunk := feed(what)
+			if d := frameDiffers(e, frameTop(), frameCells(s)); d != "" {
+				mismatch(ht, shape(), "%s: after Display the emulator does not show the frame at row %d: %s\nframe rows:\n%s\nflushed %q\ntranscript %q", what, frameTop(), d, emulatorRows(e, 0, H), chunk, tk.transcript)
+			}
+		}
+		// beforeSwitch flushes ahead of a step that reads the terminal's cursor (an alt screen
+		// switch, InsertAbove); a move still queued in the renderer (ultraviolet/27) makes the
+		// renderer's record and the terminal diverge from then on. Under HEGEL_NO_KNOWN=1 the
+		// step is skipped then.
+		beforeSwitch := func(what string) bool {
+			flush(what)
+			if !pendingMove() {
+				return true
+			}
+			if noKnown {
+				// A frame commits the queued move (the documented way).
+				display(what+", a frame to commit the move", nil)
+				if !pendingMove() {
+					count("ultraviolet/27-committed-by-a-frame")
+					return true
+				}
+			}
+			if known("ultraviolet/27") {
+				return false
+			}
+			sticky = append(sticky, "ultraviolet/27")
+			return true
+		}
+
+		// Terminal.Start replays the record first.
+		s.Restore()
+		flush("Restore at start")
+		if c.showFirst {
+			note(ht, "ShowCursor")
+			s.ShowCursor()
+			m.visible, m.cursorObj = true, true
+		}
+
+		for step, op := range c.ops {
+			what := fmt.Sprintf("step %d", step)
+			switch op.kind {
+			case scEnterAlt, scExitAlt:
+				// The terminal saves and restores its cursor with the alt screen and the
+				// renderer its record.
+				if !beforeSwitch(what + " before the screen switch") {
+					continue
+				}
+				if op.kind == scEnterAlt {
+					note(ht, "EnterAltScreen")
+					s.EnterAltScreen()
+					m.alt = true
+				} else {
+					note(ht, "ExitAltScreen")
+					s.ExitAltScreen()
+					m.alt = false
+				}
+			case scHideCursor:
+				note(ht, "HideCursor")
+				s.HideCursor()
+				m.visible = false
+			case scShowCursor:
+				note(ht, "ShowCursor")
+				s.ShowCursor()
+				m.visible, m.cursorObj = true, true
+			case scCursorPosition:
+				x, y := -1+op.x%(w+2), -1+op.y%(h+2)
+				note(ht, "SetCursorPosition(%d,%d)", x, y)
+				s.SetCursorPosition(x, y)
+				m.x, m.y = x, y
+				m.cursorObj = true
+			case scCursorStyle, scCursorColor:
+				if !m.cursorObj {
+					// A cursor style or colour on a screen without a Cursor creates a visible
+					// one (ultraviolet/29); under HEGEL_NO_KNOWN=1 showFirst holds.
+					sticky = append(sticky, "ultraviolet/29")
+				}
+				if op.kind == scCursorStyle {
+					note(ht, "SetCursorStyle(%d,%v)", op.shape, op.blink)
+					s.SetCursorStyle(op.shape, op.blink)
+					m.shape, m.blink, m.styleSet = op.shape, op.blink, true
+				} else {
+					note(ht, "SetCursorColor(%v)", op.colour)
+					s.SetCursorColor(op.colour)
+					m.cursorColor = op.colour
+				}
+			case scBackground:
+				note(ht, "SetBackgroundColor(%v)", op.colour)
+				s.SetBackgroundColor(op.colour)
+				m.bg = op.colour
+			case scForeground:
+				note(ht, "SetForegroundColor(%v)", op.colour)
+				s.SetForegroundColor(op.colour)
+				m.fg = op.colour
+			case scBracketedPaste:
+				if op.on {
+					note(ht, "EnableBracketedPaste")
+					s.EnableBracketedPaste()
+				} else {
+					note(ht, "DisableBracketedPaste")
+					s.DisableBracketedPaste()
+				}
+				m.paste = op.on
+			case scMouseMode:
+				note(ht, "SetMouseMode(%d)", op.mode)
+				s.SetMouseMode(op.mode)
+				m.mouse = op.mode
+			case scMouseEncoding:
+				note(ht, "SetMouseEncoding(%d)", op.enc)
+				s.SetMouseEncoding(op.enc)
+				m.enc = op.enc
+			case scTitle:
+				note(ht, "SetWindowTitle(%q)", op.title)
+				s.SetWindowTitle(op.title)
+				m.title = op.title
+			case scKeyboard:
+				ke, flags, keShape := op.ke.build()
+				note(ht, "SetKeyboardEnhancements(%+v) for flags %d", ke, flags)
+				s.SetKeyboardEnhancements(ke)
+				m.kitty, m.kittyFlags, m.kittySet = ke, flags, true
+				if keShape != "" {
+					sticky = append(sticky, keShape)
+				}
+			case scProgress:
+				note(ht, "SetProgressBar(%+v)", op.pb)
+				s.SetProgressBar(op.pb)
+				m.progress, m.progressSet = op.pb, true
+			case scSync:
+				note(ht, "SetSynchronizedUpdates(%v)", op.on)
+				s.SetSynchronizedUpdates(op.on)
+				m.sync = op.on
+			case scCells:
+				for _, cs := range op.cells {
+					x, y := cs.x%w, cs.y%h
+					note(ht, "SetCell(%d,%d,%s)", x, y, cellString(cs.cell))
+					s.SetCell(x, y, cs.cell)
+				}
+				display(what+" cells", nil)
+				continue
+			case scDisplayText:
+				text := op.text.render(w, 1+op.n%(h+1))
+				note(ht, "Display(%q)", text)
+				display(what+" text", uv.NewStyledString(text))
+				continue
+			case scInsertAbove:
+				// Content above the frame: every line takes ceil(width/w) rows; as many of
+				// the drawn lines as fit the terminal with the frame.
+				var lines []string
+				rows := 0
+				fullLine := false
+				for _, l := range op.above {
+					width := l.width(w)
+					need := max(1, (width+w-1)/w) // the rows the line takes
+					if room := H - h - rows; need > room {
+						if rows > 0 || room <= 0 {
+							break
+						}
+						width, need = room*w, room // the first line is cut to the room over the frame
+						if noKnown {
+							width--
+						}
+					}
+					lines = append(lines, lettersOf(l.pool, width))
+					rows += need
+					fullLine = fullLine || (width > 0 && width%w == 0)
+				}
+				if len(lines) == 0 {
+					// The terminal has no row over the frame.
+					count("insert-no-room")
+					continue
+				}
+				content := strings.Join(lines, "\n")
+				if content == "" {
+					// Documented no-op.
+					count("insert-empty")
+					continue
+				}
+				if m.alt && known("ultraviolet/30") {
+					// Documented as invisible in the alt screen; it draws on it.
+					continue
+				}
+				// InsertAbove writes straight to the terminal, ahead of anything still
+				// queued (documented); a program flushes first, so does the property.
+				if !beforeSwitch(what + " before InsertAbove") {
+					continue
+				}
+				var stepShapes []string
+				if m.alt {
+					stepShapes = append(stepShapes, "ultraviolet/30")
+				}
+				if fullLine {
+					stepShapes = append(stepShapes, "ultraviolet/31") // a line exactly as wide as the screen loses its last cell
+				}
+				// Whatever the terminal shows on the frame's rows (the frame, or the
+				// main screen's old content right after ExitAltScreen) must move down
+				// intact; the Display afterwards checks the frame itself. In the alt
+				// screen the content is documented invisible: the frame must stay put.
+				before := emulatorCells(e, frameTop(), w, h)
+				oldTop := top
+				note(ht, "InsertAbove(%q): %d rows", content, rows)
+				if err := s.InsertAbove(content); err != nil {
+					fail(ht, "%s: InsertAbove: %v", what, err)
+				}
+				chunk := out.String()
+				out.Reset()
+				tk.transcript += chunk
+				if _, err := e.WriteString(chunk); err != nil {
+					fail(ht, "%s: emulator: %v", what, err)
+				}
+				if !m.alt {
+					top = min(oldTop+rows, H-h)
+					// The lines, wrapped at the width, sit right above the frame.
+					var want []string
+					for _, line := range lines {
+						for {
+							if len(line) <= w {
+								want = append(want, line+strings.Repeat(" ", w-len(line)))
+								break
+							}
+							want = append(want, line[:w])
+							line = line[w:]
+						}
+					}
+					for i, row := range want {
+						y := top - rows + i
+						var got strings.Builder
+						for x := 0; x < w; x++ {
+							c := e.CellAt(x, y)
+							if c == nil {
+								got.WriteString("?")
+							} else if c.Width > 0 {
+								got.WriteString(c.Content)
+							}
+						}
+						if got.String() != row {
+							mismatch(ht, shape(stepShapes...), "%s: InsertAbove(%q) with a %d-wide frame at row %d: row %d shows %q, want %q\n%s\nwrote %q", what, content, w, oldTop, y, got.String(), row, emulatorRows(e, 0, H), chunk)
+						}
+					}
+				}
+				if d := frameDiffers(e, frameTop(), before); d != "" {
+					mismatch(ht, shape(stepShapes...), "%s: after InsertAbove(%q) the frame (now at row %d) is not intact: %s\n%s\nwrote %q", what, content, frameTop(), d, emulatorRows(e, 0, H), chunk)
+				}
+				if pos := e.CursorPosition(); !m.alt && (pos.X != 0 || pos.Y != top) {
+					mismatch(ht, shape(stepShapes...), "%s: after InsertAbove(%q) the renderer believes the cursor is at the frame's (0,0) = row %d, the emulator has it at (%d,%d)\n%s\nwrote %q", what, content, top, pos.X, pos.Y, emulatorRows(e, 0, H), chunk)
+				}
+				sticky = append(sticky, stepShapes...)
+				// A change after it is drawn where the frame now is.
+				display(what+" after InsertAbove", nil)
+				continue
+			case scFlush:
+				flush(what + " flush")
+				continue
+			}
+			if op.flushAfter {
+				flush(what)
+			}
+		}
+		flush("final flush")
+
+		// Terminal.Stop: the terminal must be back at its defaults.
+		if noKnown && !m.visible && m.cursorObj {
+			// Reset shows the cursor only when the screen holds no hidden Cursor; under
+			// HEGEL_NO_KNOWN=1 the program shows the cursor before the stop.
+			count("ultraviolet/28-shown-before-reset")
+			note(ht, "ShowCursor")
+			s.ShowCursor()
+			m.visible = true
+			flush("show before Reset")
+		}
+		if noKnown && m.alt {
+			// Restore re-enters the alt screen, which the terminal clears, and its Render
+			// finds nothing changed (ultraviolet/34); under HEGEL_NO_KNOWN=1 the program
+			// leaves the alt screen before the stop.
+			count("ultraviolet/34-alt-left-before-reset")
+			if beforeSwitch("before leaving the alt screen") {
+				note(ht, "ExitAltScreen")
+				s.ExitAltScreen()
+				m.alt = false
+				flush("leave the alt screen before Reset")
+			}
+		}
+		frame := frameCells(s)
+		mainTop := frameTop()
+		s.Reset()
+		if err := s.Flush(); err != nil {
+			fail(ht, "Reset: Flush: %v", err)
+		}
+		chunk := feed("Reset")
+		if d := m.terminalDiffers(tk, true); len(d) > 0 {
+			resetShape := ""
+			if !m.visible && m.cursorObj {
+				resetShape = "ultraviolet/28"
+			}
+			mismatch(ht, shape(resetShape), "after Reset the terminal is not at its defaults:\n  %s\nReset wrote %q\ntranscript %q", strings.Join(d, "\n  "), chunk, tk.transcript)
+		}
+		if e.IsAltScreen() {
+			mismatch(ht, shape(), "after Reset the emulator is still in the alt screen; Reset wrote %q", chunk)
+		}
+		if tk.sync != 0 {
+			mismatch(ht, shape(), "Reset left mode 2026 at depth %d: %q", tk.sync, chunk)
+		}
+		// The record survives Reset, so the getters still say what was asked.
+		if d := m.gettersDiffer(s); len(d) > 0 {
+			mismatch(ht, shape(), "after Reset the getters forgot the requests:\n  %s", strings.Join(d, "\n  "))
+		}
+
+		// Terminal.Start again: Restore brings the requests back, and the frame with them.
+		s.Restore()
+		if err := s.Flush(); err != nil {
+			fail(ht, "Restore: Flush: %v", err)
+		}
+		chunk = feed("Restore")
+		if d := m.terminalDiffers(tk, false); len(d) > 0 {
+			mismatch(ht, shape(), "after Restore the terminal disagrees with the requests:\n  %s\nRestore wrote %q", strings.Join(d, "\n  "), chunk)
+		}
+		if d := m.gettersDiffer(s); len(d) > 0 {
+			mismatch(ht, shape(), "after Restore the getters disagree with the requests:\n  %s", strings.Join(d, "\n  "))
+		}
+		if m.alt && known("ultraviolet/34") {
+			// Still in the alt screen (the switch out was skipped): the frame is not
+			// checked under HEGEL_NO_KNOWN=1.
+			return
+		}
+		restoreShape := ""
+		if m.alt {
+			restoreShape = "ultraviolet/34"
+		}
+		if d := frameDiffers(e, mainTop, frame); d != "" {
+			mismatch(ht, shape(restoreShape), "after Reset and Restore the emulator does not show the frame at row %d: %s\n%s\nReset+Restore wrote %q", mainTop, d, emulatorRows(e, 0, H), chunk)
+		}
+		display("after Restore", nil)
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- tab stops
+
+// tabOp is one operation on the tab stops: Set, Reset, Clear or Resize, with positions.
+type tabOp struct {
+	kind int // 0 Set, 1 Reset, 2 Clear, 3 Resize
+	col  int // position
+	nw   int
+}
+
+// tabProbe is a column and a distance for Next, Prev and Find.
+type tabProbe struct {
+	col   int // position
+	delta int
+}
+
+// tabCase is a TabStops of a width and an interval (8, the only one TabStops honours:
+// ultraviolet/32; the others are drawn while the shape is on), the operations run on it and the
+// probes of every check.
+type tabCase struct {
+	width    int
+	interval int
+	ops      []tabOp
+	probes   []tabProbe
+}
+
+func (c tabCase) GoString() string {
+	return fmt.Sprintf("TabStops(%d, %d) with %d ops", c.width, c.interval, len(c.ops))
+}
+
+var tabCases = hegel.Composite(func(tc hegel.TestCase) tabCase {
+	return tabCase{
+		width:    hegel.Draw(tc, hegel.Integers(0, 100)),
+		interval: hegel.Draw(tc, shaped(hegel.SampledFrom([]int{8, 1, 2, 3, 4, 5, 6, 7, 9, 12, 16, 32}), hegel.Just(8))),
+		ops: hegel.Draw(tc, many(hegel.Composite(func(tc hegel.TestCase) tabOp {
+			return tabOp{hegel.Draw(tc, hegel.Integers(0, 3)), hegel.Draw(tc, positions), hegel.Draw(tc, hegel.Integers(0, 100))}
+		}), 0, 12)),
+		probes: hegel.Draw(tc, many(hegel.Composite(func(tc hegel.TestCase) tabProbe {
+			return tabProbe{hegel.Draw(tc, positions), hegel.Draw(tc, hegel.Integers(-3, 3))}
+		}), 4, 4)),
+	}
+})
+
+// TestHegelTabStopsFollowTheModel: NewTabStops/Set/Reset/Clear/Resize keep the documented set
+// of stops for the interval and Find walks it.
+func TestHegelTabStopsFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, tabCases)
+		shape := ""
+		if c.interval != 8 {
+			shape = "ultraviolet/32" // TabStops hard-codes an interval of 8 in its bit set
+		}
+		naming(ht, shape, func() { checkTabStops(ht, c, shape) })
+	})
+}
+
+// checkTabStops runs the case against the model of the stops.
+func checkTabStops(ht *hegel.T, c tabCase, shape string) {
+	{
+		width, interval := c.width, c.interval
+		ts := uv.NewTabStops(width, interval)
+		stops := map[int]bool{}
+		for x := 0; x < width; x += interval {
+			stops[x] = true
+		}
+		next := func(col int) int {
+			if col >= width-1 {
+				return col
+			}
+			for c := col + 1; c < width; c++ {
+				if stops[c] {
+					return c
+				}
+			}
+			return width - 1
+		}
+		prev := func(col int) int {
+			if col < 1 {
+				return col
+			}
+			for c := col - 1; c > 0; c-- {
+				if stops[c] {
+					return c
+				}
+			}
+			return 0
+		}
+		check := func(what string) {
+			if ts.Width() != width {
+				mismatch(ht, shape, "%s: Width() = %d, want %d", what, ts.Width(), width)
+			}
+			for col := 0; col < width; col++ {
+				if ts.IsStop(col) != stops[col] {
+					mismatch(ht, shape, "%s: IsStop(%d) = %v, model %v (width %d)", what, col, ts.IsStop(col), stops[col], width)
+				}
+			}
+			for _, p := range c.probes {
+				// Columns at or beyond the width are outside the contract: a shrinking
+				// Resize leaves their bits as they were.
+				col := -1 + p.col%(width+1)
+				if got, want := ts.Next(col), next(col); got != want {
+					mismatch(ht, shape, "%s: Next(%d) = %d, model %d (width %d, stops %v)", what, col, got, want, width, stops)
+				}
+				if got, want := ts.Prev(col), prev(col); got != want {
+					mismatch(ht, shape, "%s: Prev(%d) = %d, model %d (width %d, stops %v)", what, col, got, want, width, stops)
+				}
+				want := col
+				for d := p.delta; d > 0; d-- {
+					want = next(want)
+				}
+				for d := p.delta; d < 0; d++ {
+					want = prev(want)
+				}
+				if got := ts.Find(col, p.delta); got != want {
+					mismatch(ht, shape, "%s: Find(%d,%d) = %d, model %d (width %d, stops %v)", what, col, p.delta, got, want, width, stops)
+				}
+			}
+		}
+		check("fresh")
+		for _, op := range c.ops {
+			switch op.kind {
+			case 0, 1:
+				if width == 0 {
+					continue
+				}
+				col := op.col % width
+				if op.kind == 0 {
+					ts.Set(col)
+					stops[col] = true
+					check(fmt.Sprintf("Set(%d)", col))
+				} else {
+					ts.Reset(col)
+					delete(stops, col)
+					check(fmt.Sprintf("Reset(%d)", col))
+				}
+			case 2:
+				ts.Clear()
+				stops = map[int]bool{}
+				check("Clear")
+			default:
+				ts.Resize(op.nw)
+				for x := range stops {
+					if x >= op.nw {
+						delete(stops, x)
+					}
+				}
+				for x := (width + interval - 1) / interval * interval; x < op.nw; x += interval {
+					stops[x] = true
+				}
+				width = op.nw
+				check(fmt.Sprintf("Resize(%d)", op.nw))
+			}
+		}
+		count("ok")
+	}
+}
+
+// ---------------------------------------------------------------- pins (screen)
+
+func newScreen(w, h int) (*uv.TerminalScreen, *bytes.Buffer) {
+	var out bytes.Buffer
+	s := uv.NewTerminalScreen(&out, []string{"TERM=xterm-256color"})
+	s.SetColorProfile(colorprofile.TrueColor)
+	s.SetWidthMethod(ansi.WcWidth)
+	s.Resize(w, h)
+	return s, &out
+}
+
+func rowString(e *vt.Emulator, y int) string {
+	var sb strings.Builder
+	for x := 0; x < e.Width(); x++ {
+		if c := e.CellAt(x, y); c != nil && c.Width > 0 {
+			sb.WriteString(c.Content)
+		}
+	}
+	return strings.TrimRight(sb.String(), " ")
+}
+
+// ultraviolet/27: Flush asks the renderer to move the cursor to the requested position, but the
+// renderer queues the sequence in its own buffer and only Render flushes it, so the position
+// reaches the terminal with the next frame.
+func TestHegelPinFlushDoesNotCommitTheCursorPosition(t *testing.T) {
+	defer guard(t)
+	s, out := newScreen(10, 3)
+	s.EnterAltScreen()
+	s.ShowCursor()
+	_ = s.Display(nil)
+	out.Reset()
+	s.SetCursorPosition(5, 1)
+	_ = s.Flush()
+	first := out.String()
+	out.Reset()
+	_ = s.Display(nil)
+	second := out.String()
+	if strings.Contains(first, "\x1b[2;6H") {
+		return
+	}
+	t.Fatalf("SetCursorPosition(5,1) then Flush wrote %q; the move came out of the next Display: %q", first, second)
+}
+
+// ultraviolet/28: Reset writes ShowCursor only when the screen holds no Cursor or a visible one;
+// with a hidden Cursor (Terminal.Start hides it, and SetCursorPosition or HideCursor after
+// ShowCursor creates a hidden one) Terminal.Stop leaves the user's cursor hidden.
+func TestHegelPinResetLeavesAHiddenCursorHidden(t *testing.T) {
+	defer guard(t)
+	s, out := newScreen(10, 3)
+	s.Restore() // Terminal.Start
+	_ = s.Flush()
+	out.Reset()
+	s.SetCursorPosition(1, 1)
+	_ = s.Flush()
+	out.Reset()
+	s.Reset() // Terminal.Stop
+	_ = s.Flush()
+	if strings.Contains(out.String(), ansi.ShowCursor) {
+		return
+	}
+	t.Fatalf("Start hid the cursor (cursor unset), SetCursorPosition(1,1) recorded a hidden cursor, and Stop's Reset wrote %q: the cursor stays hidden after the program exits", out.String())
+}
+
+// ultraviolet/29: SetCursorStyle and SetCursorColor create the screen's Cursor with the
+// default, visible, state when there is none, so after HideCursor (which records nothing when
+// there is no Cursor) they report a visible cursor and the next Flush shows it.
+func TestHegelPinCursorStyleShowsAHiddenCursor(t *testing.T) {
+	defer guard(t)
+	s, out := newScreen(10, 3)
+	s.HideCursor()
+	_ = s.Flush()
+	out.Reset()
+	s.SetCursorStyle(uv.CursorBar, false)
+	visible := s.CursorVisible()
+	_ = s.Flush()
+	if !visible && !strings.Contains(out.String(), ansi.ShowCursor) {
+		return
+	}
+	t.Fatalf("after HideCursor, SetCursorStyle(CursorBar, false) made CursorVisible() %v and the flush wrote %q", visible, out.String())
+}
+
+// ultraviolet/30: InsertAbove is documented to have no visible effect in the alt screen; its
+// bytes go to the active (alternate) screen, so the lines appear at the top and the frame is
+// pushed down while the renderer still believes it is in place.
+func TestHegelPinInsertAboveDrawsOnTheAltScreen(t *testing.T) {
+	defer guard(t)
+	s, out := newScreen(6, 3)
+	e := vt.NewEmulator(6, 5)
+	s.EnterAltScreen()
+	_ = s.Display(uv.NewStyledString("aaaaaa\nbbbbbb\ncccccc"))
+	_, _ = e.WriteString(out.String())
+	out.Reset()
+	_ = s.InsertAbove("hello")
+	_, _ = e.WriteString(out.String())
+	out.Reset()
+	_ = s.Display(nil)
+	_, _ = e.WriteString(out.String())
+	if rowString(e, 0) == "aaaaaa" && rowString(e, 1) == "bbbbbb" && rowString(e, 2) == "cccccc" {
+		return
+	}
+	t.Fatalf("InsertAbove(\"hello\") in the alt screen, then Display: the alt screen shows %q / %q / %q / %q", rowString(e, 0), rowString(e, 1), rowString(e, 2), rowString(e, 3))
+}
+
+// ultraviolet/31: InsertAbove writes each line followed by EL; a line exactly as wide as the
+// screen leaves the cursor on its last cell with the wrap pending, and EL erases that cell.
+func TestHegelPinInsertAboveErasesTheLastCellOfAFullLine(t *testing.T) {
+	defer guard(t)
+	s, out := newScreen(6, 2)
+	e := vt.NewEmulator(6, 6)
+	_ = s.Display(uv.NewStyledString("aaaaaa\nbbbbbb"))
+	_, _ = e.WriteString(out.String())
+	out.Reset()
+	_ = s.InsertAbove("ABCDEF")
+	_, _ = e.WriteString(out.String())
+	if rowString(e, 0) == "ABCDEF" {
+		return
+	}
+	t.Fatalf("InsertAbove(\"ABCDEF\") on a 6-column screen: row 0 shows %q; wrote %q", rowString(e, 0), out.String())
+}
+
+// ultraviolet/32: TabStops indexes its bit set by col>>3 and masks by col&(interval-1), so
+// NewTabStops with an interval above 8 indexes past the slice and one below 8 aliases columns.
+func TestHegelPinTabStopsAssumeAnIntervalOfEight(t *testing.T) {
+	defer guard(t)
+	var panicked any
+	func() {
+		defer func() { panicked = recover() }()
+		uv.NewTabStops(80, 16)
+	}()
+	ts := uv.NewTabStops(16, 4)
+	ts.Reset(4)
+	if panicked == nil && ts.IsStop(0) {
+		return
+	}
+	t.Fatalf("NewTabStops(80, 16) panics with %v; NewTabStops(16, 4) then Reset(4) leaves IsStop(0) = %v", panicked, ts.IsStop(0))
+}
+
+// ultraviolet/34: Reset leaves the alt screen without forgetting what the renderer drew, and
+// Restore re-enters it (the terminal clears it) and calls Render, which finds no change; a
+// program that Stops and Starts again in the alt screen comes back to a blank screen.
+func TestHegelPinRestoreDoesNotRedrawTheAltScreen(t *testing.T) {
+	defer guard(t)
+	s, out := newScreen(6, 3)
+	e := vt.NewEmulator(6, 3)
+	s.EnterAltScreen()
+	_ = s.Display(uv.NewStyledString("aaaaaa\nbbbbbb\ncccccc"))
+	_, _ = e.WriteString(out.String())
+	out.Reset()
+	s.Reset() // Terminal.Stop
+	_ = s.Flush()
+	_, _ = e.WriteString(out.String())
+	out.Reset()
+	s.Restore() // Terminal.Start
+	_ = s.Flush()
+	_, _ = e.WriteString(out.String())
+	if rowString(e, 0) == "aaaaaa" && rowString(e, 1) == "bbbbbb" && rowString(e, 2) == "cccccc" {
+		return
+	}
+	t.Fatalf("after Reset and Restore in the alt screen the terminal shows %q / %q / %q; Restore wrote %q", rowString(e, 0), rowString(e, 1), rowString(e, 2), out.String())
+}
+
+// ultraviolet/33: NewKeyboardEnhancements decodes only the first two Kitty flags, so
+// NewKeyboardEnhancements(flags).Flags() drops ReportAlternateKeys, ReportAllKeysAsEscapeCodes
+// and ReportAssociatedText.
+func TestHegelPinNewKeyboardEnhancementsDropsThreeFlags(t *testing.T) {
+	defer guard(t)
+	var lost []string
+	for f := 0; f < 32; f++ {
+		if got := uv.NewKeyboardEnhancements(f).Flags(); got != f {
+			lost = append(lost, fmt.Sprintf("%d->%d", f, got))
+		}
+	}
+	if len(lost) == 0 {
+		return
+	}
+	t.Fatalf("NewKeyboardEnhancements(flags).Flags() != flags for %d of 32 values: %s", len(lost), strings.Join(lost, " "))
+}
