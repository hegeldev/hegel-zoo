+// ---------------------------------------------------------------- ultraviolet/18
+
+// pasteWithSequence is a pasted text holding one escape sequence between letters: one the
+// decoder does not read as a key (the region of ultraviolet/18), or under HEGEL_NO_KNOWN=1 a
+// key sequence, which the paste keeps verbatim.
+type pasteWithSequence struct {
+	before, seq, after string
+}
+
+func (p pasteWithSequence) text() string { return p.before + p.seq + p.after }
+
+func (p pasteWithSequence) GoString() string { return fmt.Sprintf("paste %q", p.text()) }
+
+var (
+	unrecognisedSequences = []string{"\x1b[31m", "\x1b[<0;1;1M", "\x1b[é", "\x1b[I", "\x1b[?1u", "\x1b[0m"}
+	keySequences          = []string{"\x1b[A", "\x1b[3~", "\x1bOP", "\x1b[1;5D"}
+	pastesWithSequences   = hegel.Composite(func(tc hegel.TestCase) pasteWithSequence {
+		return pasteWithSequence{
+			before: hegel.Draw(tc, lettersOf(0, 5)),
+			seq:    hegel.Draw(tc, hegel.SampledFrom(shaped(unrecognisedSequences, keySequences))),
+			after:  hegel.Draw(tc, lettersOf(0, 5)),
+		}
+	})
+)
