+// Decoding options are exact: the nesting, array and map limits accept
+// exactly the values within them; DupMapKeyEnforcedAPF rejects exactly the
+// maps with a duplicate key; IndefLengthForbidden, TagsForbidden and
+// UTF8RejectInvalid reject exactly the encodings with those features; the
+// IntDec modes produce the documented Go types.
+func TestHegelDecodingOptionsAreExact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genVal(ht, genOpts{tags: true, maxDepth: 5, maxItems: 20}, 0)
+		l := &loose{tc: ht}
+		data := l.encode(nil, v, 0)
+		// Inject a duplicate key or invalid UTF-8 sometimes, by hand.
+		dup := false
+		if v.kind == kMap && len(v.m) > 0 && chance(ht, 30) {
+			e := v.m[n(ht, 0, len(v.m)-1)]
+			l = &loose{tc: ht}
+			data = l.head(nil, 5, uint64(len(v.m)+1))
+			for _, p := range v.m {
+				data = l.encode(data, p.k, 1)
+				data = l.encode(data, p.v, 1)
+			}
+			data = l.encode(data, e.k, 1)
+			data = l.encode(data, genVal(ht, genOpts{maxDepth: 1, maxItems: 2}, 4), 1)
+			dup = true
+		}
+		badUTF8 := false
+		if v.kind == kText && chance(ht, 50) {
+			bad := pick(ht, []byte{0xff}, []byte{0xc0, 0x80}, []byte{0xed, 0xa0, 0x80}, []byte{0xe2, 0x82}, []byte{0xf4, 0x90, 0x80, 0x80})
+			l = &loose{tc: ht}
+			data = append(appendHead(nil, 3, uint64(len(v.b)+len(bad))), append(append([]byte{}, v.b...), bad...)...)
+			badUTF8 = true
+		}
+		depth := v.depth()
+		if dup {
+			depth = max(depth, 1)
+		}
+		maxNest := pick(ht, 4, 5, 6, 8, 32, depth, depth+1, max(4, depth-1))
+		maxNest = max(4, min(maxNest, 65535))
+		if Known.tagLevelNotCounted {
+			// The library counts a tag only when it is directly inside
+			// another tag: keep the limit out of the band where the two
+			// countings disagree.
+			if lib := v.depthLib(false); lib <= maxNest && maxNest < depth {
+				maxNest = depth
+			}
+		}
+		maxArr := pick(ht, 16, 17, 20, 131072, max(16, v.maxArray()), max(16, v.maxArray()-1), max(16, v.maxArray()+1))
+		maxMap := pick(ht, 16, 17, 20, 131072, max(16, v.maxMap()), max(16, v.maxMap()-1), max(16, v.maxMap()+1))
+		o := cbor.DecOptions{
+			MapKeyByteString: cbor.MapKeyByteStringAllowed,
+			MaxNestedLevels:  maxNest,
+			MaxArrayElements: maxArr,
+			MaxMapPairs:      maxMap,
+			DupMapKey:        pick(ht, cbor.DupMapKeyQuiet, cbor.DupMapKeyEnforcedAPF),
+			IndefLength:      pick(ht, cbor.IndefLengthAllowed, cbor.IndefLengthForbidden),
+			TagsMd:           pick(ht, cbor.TagsAllowed, cbor.TagsForbidden),
+			UTF8:             pick(ht, cbor.UTF8RejectInvalid, cbor.UTF8DecodeInvalid),
+			IntDec:           pick(ht, cbor.IntDecConvertNone, cbor.IntDecConvertSignedOrFail, cbor.IntDecConvertSignedOrBigInt),
+		}
+		note(ht, "value %s (depth %d, arrays ≤ %d, maps ≤ %d)\nencoding %x (indef %v, dup %v, badUTF8 %v)\noptions %+v", v, depth, v.maxArray(), v.maxMap(), data, l.indef, dup, badUTF8, o)
+		dm, err := o.DecMode()
+		if err != nil {
+			fail(ht, "DecMode(%+v): %v", o, err)
+		}
+		if got := dm.DecOptions(); got.MaxNestedLevels != o.MaxNestedLevels || got.MaxArrayElements != o.MaxArrayElements || got.MaxMapPairs != o.MaxMapPairs || got.DupMapKey != o.DupMapKey || got.IndefLength != o.IndefLength || got.TagsMd != o.TagsMd || got.UTF8 != o.UTF8 || got.IntDec != o.IntDec {
+			fail(ht, "DecOptions() = %+v, want %+v", got, o)
+		}
+		mapPairs := v.maxMap()
+		if dup {
+			mapPairs = max(mapPairs, len(v.m)+1)
+		}
+		var hasBigUint, hasBigNeg bool
+		v.walk(func(e *val) {
+			if e.kind == kUint && e.u > math.MaxInt64 {
+				hasBigUint = true
+			}
+			if e.kind == kNeg && e.u > math.MaxInt64 {
+				hasBigNeg = true
+			}
+		})
+		wantErr := depth > maxNest || v.maxArray() > maxArr || mapPairs > maxMap ||
+			(dup && o.DupMapKey == cbor.DupMapKeyEnforcedAPF) ||
+			(l.indef && o.IndefLength == cbor.IndefLengthForbidden) ||
+			(v.hasTag() && o.TagsMd == cbor.TagsForbidden) ||
+			(badUTF8 && o.UTF8 == cbor.UTF8RejectInvalid) ||
+			((hasBigUint || hasBigNeg) && o.IntDec == cbor.IntDecConvertSignedOrFail)
+		x, err := decodeAny(dm, data)
+		if wantErr {
+			if err == nil {
+				fail(ht, "Unmarshal(%x) of %s with %+v succeeded (%v), want an error", data, v, o, x)
+			}
+			// Wellformed applies the structural limits and the forbidding
+			// modes too, but not the duplicate-key, UTF-8 or IntDec rules.
+			werr := dm.Wellformed(data)
+			structural := depth > maxNest || v.maxArray() > maxArr || mapPairs > maxMap || (l.indef && o.IndefLength == cbor.IndefLengthForbidden) || (v.hasTag() && o.TagsMd == cbor.TagsForbidden)
+			if structural && werr == nil {
+				fail(ht, "Wellformed(%x) with %+v succeeded on %s", data, o, v)
+			}
+			if !structural && werr != nil {
+				fail(ht, "Wellformed(%x) with %+v: %v (only Unmarshal should reject %s)", data, o, werr, v)
+			}
+			return
+		}
+		if err != nil {
+			fail(ht, "Unmarshal(%x) of %s with %+v: %v", data, v, o, err)
+		}
+		if werr := dm.Wellformed(data); werr != nil {
+			fail(ht, "Wellformed(%x) with %+v: %v", data, o, werr)
+		}
+		if badUTF8 {
+			s, ok := x.(string)
+			if !ok || !strings.HasPrefix(s, string(v.b)) || utf8.ValidString(s) {
+				fail(ht, "Unmarshal(%x) with UTF8DecodeInvalid gave %#v", data, x)
+			}
+			return
+		}
+		if dup {
+			// Quiet mode: the last value of a key wins? The documented rule
+			// is only that no error is returned; check the key set.
+			m, ok := x.(map[any]any)
+			if !ok || len(m) != len(v.m) {
+				fail(ht, "Unmarshal(%x) with DupMapKeyQuiet gave %d keys (%T), want %d", data, len(m), x, len(v.m))
+			}
+			return
+		}
+		if back := fromGo(x); !same(back, v) {
+			fail(ht, "Unmarshal(%x) of %s with %+v gave %s", data, v, o, back)
+		}
+		// IntDec: the Go type of a top-level integer.
+		if v.kind == kUint || v.kind == kNeg {
+			switch o.IntDec {
+			case cbor.IntDecConvertNone:
+				if v.kind == kUint {
+					if _, ok := x.(uint64); !ok {
+						fail(ht, "IntDecConvertNone decoded %s as %T", v, x)
+					}
+				} else if v.u <= math.MaxInt64 {
+					if _, ok := x.(int64); !ok {
+						fail(ht, "IntDecConvertNone decoded %s as %T", v, x)
+					}
+				} else if _, ok := x.(big.Int); !ok {
+					fail(ht, "IntDecConvertNone decoded %s as %T", v, x)
+				}
+			case cbor.IntDecConvertSignedOrFail:
+				if _, ok := x.(int64); !ok {
+					fail(ht, "IntDecConvertSignedOrFail decoded %s as %T", v, x)
+				}
+			case cbor.IntDecConvertSignedOrBigInt:
+				if v.u <= math.MaxInt64 {
+					if _, ok := x.(int64); !ok {
+						fail(ht, "IntDecConvertSignedOrBigInt decoded %s as %T", v, x)
+					}
+				} else if _, ok := x.(big.Int); !ok {
+					fail(ht, "IntDecConvertSignedOrBigInt decoded %s as %T", v, x)
+				}
+			}
+		}
+	})
+}
