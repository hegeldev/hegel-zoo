index 0000000..9334826
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,3410 @@
+package cbor_test
+
+// Hegel property tests for github.com/fxamacker/cbor/v2.
+//
+// Oracles: a small model of RFC 8949 written here (the encoding of a value
+// tree under the three deterministic orderings — Core Deterministic, Canonical
+// (RFC 7049 length-first) and CTAP2 —, arbitrary non-preferred encodings of
+// the same tree (wider heads, indefinite-length strings and containers, wider
+// floats), and the well-formedness grammar of Appendix C), the Python cbor2
+// package (canonical encodings of the same values, its own decoding of the Go
+// encoder's output), the documented decoding options (limits, duplicate keys,
+// UTF-8, integer conversion, forbidden items) and the io contracts of the
+// streaming Encoder/Decoder.
+//
+// Set CBOR_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"math/big"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"testing/iotest"
+	"time"
+	"unicode/utf8"
+
+	"github.com/fxamacker/cbor/v2"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	// The cbor2 property forks a Python interpreter per case, which takes
+	// longer than Hegel's too-slow health check likes on a loaded machine (and
+	// hegel-go reports that failure without a message). The slowness is the
+	// oracle's, not a test problem.
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("CBOR_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	unixMicroFarFromEpoch bool // cbor/1: TimeUnixMicro encodes times outside 1678–2262 through an overflowing UnixNano
+	tagLevelNotCounted    bool // cbor/2: MaxNestedLevels does not count a tag unless it is directly inside another tag
+}{unixMicroFarFromEpoch: true, tagLevelNotCounted: true}
+
+// ---------------------------------------------------------------------------
+// The model: a CBOR data item as a tree.
+
+type kind int
+
+const (
+	kUint   kind = iota // major type 0
+	kNeg                // major type 1: the value is -1 - u
+	kBytes              // major type 2
+	kText               // major type 3 (valid UTF-8)
+	kArray              // major type 4
+	kMap                // major type 5
+	kTag                // major type 6: number u, content a[0]
+	kSimple             // major type 7, simple value u (0–19 or 32–255)
+	kBool               // major type 7, 20/21
+	kNull               // major type 7, 22
+	kUndef              // major type 7, 23
+	kFloat              // major type 7, 25–27
+)
+
+type val struct {
+	kind kind
+	u    uint64
+	b    []byte
+	a    []*val
+	m    []kv
+	f    float64
+	bo   bool
+}
+
+type kv struct{ k, v *val }
+
+func vUint(u uint64) *val        { return &val{kind: kUint, u: u} }
+func vNeg(u uint64) *val         { return &val{kind: kNeg, u: u} } // -1 - u
+func vBytes(b []byte) *val       { return &val{kind: kBytes, b: b} }
+func vText(s string) *val        { return &val{kind: kText, b: []byte(s)} }
+func vArray(a ...*val) *val      { return &val{kind: kArray, a: a} }
+func vMap(m ...kv) *val          { return &val{kind: kMap, m: m} }
+func vTag(u uint64, c *val) *val { return &val{kind: kTag, u: u, a: []*val{c}} }
+func vSimple(u uint64) *val      { return &val{kind: kSimple, u: u} }
+func vBool(b bool) *val          { return &val{kind: kBool, bo: b} }
+func vNull() *val                { return &val{kind: kNull} }
+func vFloat(f float64) *val      { return &val{kind: kFloat, f: f} }
+
+// vInt makes the model item for a signed integer within the CBOR integer range.
+func vBig(x *big.Int) *val {
+	if x.Sign() >= 0 {
+		if x.IsUint64() {
+			return vUint(x.Uint64())
+		}
+		return vTag(2, vBytes(x.Bytes()))
+	}
+	m := new(big.Int).Neg(x)
+	m.Sub(m, big.NewInt(1)) // -1 - u = x  =>  u = -x - 1
+	if m.IsUint64() {
+		return vNeg(m.Uint64())
+	}
+	return vTag(3, vBytes(m.Bytes()))
+}
+
+// String renders the item in (approximate) diagnostic notation for messages.
+func (v *val) String() string {
+	var sb strings.Builder
+	v.diag(&sb)
+	return sb.String()
+}
+
+func (v *val) diag(sb *strings.Builder) {
+	switch v.kind {
+	case kUint:
+		fmt.Fprintf(sb, "%d", v.u)
+	case kNeg:
+		if v.u == math.MaxUint64 {
+			sb.WriteString("-18446744073709551616")
+		} else {
+			fmt.Fprintf(sb, "-%d", v.u+1)
+		}
+	case kBytes:
+		fmt.Fprintf(sb, "h'%x'", v.b)
+	case kText:
+		fmt.Fprintf(sb, "%q", string(v.b))
+	case kArray:
+		sb.WriteString("[")
+		for i, e := range v.a {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			e.diag(sb)
+		}
+		sb.WriteString("]")
+	case kMap:
+		sb.WriteString("{")
+		for i, e := range v.m {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			e.k.diag(sb)
+			sb.WriteString(": ")
+			e.v.diag(sb)
+		}
+		sb.WriteString("}")
+	case kTag:
+		fmt.Fprintf(sb, "%d(", v.u)
+		v.a[0].diag(sb)
+		sb.WriteString(")")
+	case kSimple:
+		fmt.Fprintf(sb, "simple(%d)", v.u)
+	case kBool:
+		fmt.Fprintf(sb, "%v", v.bo)
+	case kNull:
+		sb.WriteString("null")
+	case kUndef:
+		sb.WriteString("undefined")
+	case kFloat:
+		fmt.Fprintf(sb, "%v(%016x)", v.f, math.Float64bits(v.f))
+	}
+}
+
+// depth is the nesting depth in the sense of MaxNestedLevels: arrays, maps
+// and tags each count one level; a scalar is 0.
+func (v *val) depth() int {
+	d := 0
+	switch v.kind {
+	case kArray:
+		for _, e := range v.a {
+			d = max(d, e.depth())
+		}
+		return d + 1
+	case kMap:
+		for _, e := range v.m {
+			d = max(d, e.k.depth(), e.v.depth())
+		}
+		return d + 1
+	case kTag:
+		return v.a[0].depth() + 1
+	}
+	return 0
+}
+
+// depthLib is the library's nesting depth (cbor/2): a tag counts only when
+// its parent is a tag.
+func (v *val) depthLib(parentTag bool) int {
+	d := 0
+	switch v.kind {
+	case kArray:
+		for _, e := range v.a {
+			d = max(d, e.depthLib(false))
+		}
+		return d + 1
+	case kMap:
+		for _, e := range v.m {
+			d = max(d, e.k.depthLib(false), e.v.depthLib(false))
+		}
+		return d + 1
+	case kTag:
+		d = v.a[0].depthLib(true)
+		if parentTag {
+			d++
+		}
+		return d
+	}
+	return 0
+}
+
+// walk calls fn on every item of the tree, parents first.
+func (v *val) walk(fn func(*val)) {
+	fn(v)
+	for _, e := range v.a {
+		e.walk(fn)
+	}
+	for _, e := range v.m {
+		e.k.walk(fn)
+		e.v.walk(fn)
+	}
+}
+
+func (v *val) maxArray() int {
+	m := 0
+	v.walk(func(x *val) {
+		if x.kind == kArray {
+			m = max(m, len(x.a))
+		}
+	})
+	return m
+}
+
+func (v *val) maxMap() int {
+	m := 0
+	v.walk(func(x *val) {
+		if x.kind == kMap {
+			m = max(m, len(x.m))
+		}
+	})
+	return m
+}
+
+func (v *val) hasTag() bool {
+	found := false
+	v.walk(func(x *val) {
+		if x.kind == kTag {
+			found = true
+		}
+	})
+	return found
+}
+
+// ---------------------------------------------------------------------------
+// The model encoder.
+
+type sortMode int
+
+const (
+	sortNone     sortMode = iota // model order
+	sortBytewise                 // Core Deterministic / CTAP2: bytewise lexicographic order of the encoded keys
+	sortLength                   // Canonical (RFC 7049): shorter encoded keys first, then bytewise
+)
+
+type encStyle struct {
+	sort       sortMode
+	shortFloat bool // floats in the shortest form preserving the value; NaN as f97e00, Inf as f97c00
+}
+
+var (
+	styleCoreDet   = encStyle{sortBytewise, true}
+	styleCanonical = encStyle{sortLength, true}
+	styleCTAP2     = encStyle{sortBytewise, false}
+)
+
+func appendHead(dst []byte, mt byte, n uint64) []byte {
+	mt <<= 5
+	switch {
+	case n < 24:
+		return append(dst, mt|byte(n))
+	case n <= 0xff:
+		return append(dst, mt|24, byte(n))
+	case n <= 0xffff:
+		return append(dst, mt|25, byte(n>>8), byte(n))
+	case n <= 0xffffffff:
+		return append(dst, mt|26, byte(n>>24), byte(n>>16), byte(n>>8), byte(n))
+	}
+	return append(dst, mt|27, byte(n>>56), byte(n>>48), byte(n>>40), byte(n>>32), byte(n>>24), byte(n>>16), byte(n>>8), byte(n))
+}
+
+// f16bits returns the binary16 encoding of f and whether it preserves the
+// value exactly (false for NaN).
+func f16bits(f float64) (uint16, bool) {
+	if math.IsNaN(f) {
+		return 0x7e00, false
+	}
+	var sign uint16
+	if math.Signbit(f) {
+		sign = 0x8000
+		f = -f
+	}
+	switch {
+	case math.IsInf(f, 0):
+		return sign | 0x7c00, true
+	case f == 0:
+		return sign, true
+	case f > 65504:
+		return 0, false
+	case f >= 1.0/16384: // 2^-14: a normal binary16 number
+		frac, exp := math.Frexp(f) // f = frac * 2^exp, frac in [0.5, 1)
+		e := exp - 1               // f = (2*frac) * 2^e, 2*frac in [1, 2), e in [-14, 15]
+		m := (2*frac - 1) * 1024
+		if m != math.Trunc(m) {
+			return 0, false
+		}
+		return sign | uint16(e+15)<<10 | uint16(m), true
+	}
+	k := f * (1 << 24) // subnormal: k * 2^-24, k in 1..1023
+	if k != math.Trunc(k) {
+		return 0, false
+	}
+	return sign | uint16(k), true
+}
+
+func f32exact(f float64) bool { return !math.IsNaN(f) && float64(float32(f)) == f }
+
+func appendF16(dst []byte, bits uint16) []byte { return append(dst, 0xf9, byte(bits>>8), byte(bits)) }
+func appendF32(dst []byte, bits uint32) []byte {
+	return append(dst, 0xfa, byte(bits>>24), byte(bits>>16), byte(bits>>8), byte(bits))
+}
+func appendF64(dst []byte, bits uint64) []byte {
+	return append(dst, 0xfb, byte(bits>>56), byte(bits>>48), byte(bits>>40), byte(bits>>32), byte(bits>>24), byte(bits>>16), byte(bits>>8), byte(bits))
+}
+
+// shortestFloat is the preferred serialization of f: the shortest of binary16,
+// binary32 and binary64 that preserves the value; NaN is f97e00.
+func shortestFloat(dst []byte, f float64) []byte {
+	if math.IsNaN(f) {
+		return appendF16(dst, 0x7e00)
+	}
+	if b, ok := f16bits(f); ok {
+		return appendF16(dst, b)
+	}
+	if f32exact(f) {
+		return appendF32(dst, math.Float32bits(float32(f)))
+	}
+	return appendF64(dst, math.Float64bits(f))
+}
+
+func keyLess(mode sortMode, a, b []byte) bool {
+	if mode == sortLength && len(a) != len(b) {
+		return len(a) < len(b)
+	}
+	return bytes.Compare(a, b) < 0
+}
+
+// encode is the model's deterministic encoding of v in the given style.
+func encode(v *val, st encStyle) []byte { return appendVal(nil, v, st) }
+
+func appendVal(dst []byte, v *val, st encStyle) []byte {
+	switch v.kind {
+	case kUint:
+		return appendHead(dst, 0, v.u)
+	case kNeg:
+		return appendHead(dst, 1, v.u)
+	case kBytes:
+		return append(appendHead(dst, 2, uint64(len(v.b))), v.b...)
+	case kText:
+		return append(appendHead(dst, 3, uint64(len(v.b))), v.b...)
+	case kArray:
+		dst = appendHead(dst, 4, uint64(len(v.a)))
+		for _, e := range v.a {
+			dst = appendVal(dst, e, st)
+		}
+		return dst
+	case kMap:
+		dst = appendHead(dst, 5, uint64(len(v.m)))
+		type pair struct{ k, v []byte }
+		pairs := make([]pair, len(v.m))
+		for i, e := range v.m {
+			pairs[i] = pair{encode(e.k, st), encode(e.v, st)}
+		}
+		if st.sort != sortNone {
+			sort.SliceStable(pairs, func(i, j int) bool { return keyLess(st.sort, pairs[i].k, pairs[j].k) })
+		}
+		for _, p := range pairs {
+			dst = append(append(dst, p.k...), p.v...)
+		}
+		return dst
+	case kTag:
+		return appendVal(appendHead(dst, 6, v.u), v.a[0], st)
+	case kSimple:
+		if v.u < 24 {
+			return append(dst, 0xe0|byte(v.u))
+		}
+		return append(dst, 0xf8, byte(v.u))
+	case kBool:
+		if v.bo {
+			return append(dst, 0xf5)
+		}
+		return append(dst, 0xf4)
+	case kNull:
+		return append(dst, 0xf6)
+	case kUndef:
+		return append(dst, 0xf7)
+	case kFloat:
+		if st.shortFloat {
+			return shortestFloat(dst, v.f)
+		}
+		return appendF64(dst, math.Float64bits(v.f))
+	}
+	panic("bad kind")
+}
+
+// same compares two model items by value: floats by value (every NaN is the
+// same NaN), maps regardless of order.
+func same(a, b *val) bool { return bytes.Equal(encode(a, styleCoreDet), encode(b, styleCoreDet)) }
+
+// ---------------------------------------------------------------------------
+// Loose encodings: the same item in any of the representations RFC 8949
+// allows a decoder to accept.
+
+type loose struct {
+	tc        hegel.TestCase
+	indef     bool // whether any indefinite-length item was written
+	dupKeys   bool // whether a duplicate map key was written
+	badUTF8   bool // whether a text string with invalid UTF-8 was written
+	widths    bool // whether a non-shortest head was written
+	maxLevels int  // nesting depth written (indefinite items included)
+}
+
+func (l *loose) head(dst []byte, mt byte, num uint64) []byte {
+	// Draw the width class: the minimal one mostly, wider sometimes.
+	minw := 0
+	switch {
+	case num < 24:
+		minw = 0
+	case num <= 0xff:
+		minw = 1
+	case num <= 0xffff:
+		minw = 2
+	case num <= 0xffffffff:
+		minw = 3
+	default:
+		minw = 4
+	}
+	w := minw
+	if chance(l.tc, 25) {
+		w = n(l.tc, minw, 4)
+	}
+	if w != minw {
+		l.widths = true
+	}
+	mt <<= 5
+	switch w {
+	case 0:
+		return append(dst, mt|byte(num))
+	case 1:
+		return append(dst, mt|24, byte(num))
+	case 2:
+		return append(dst, mt|25, byte(num>>8), byte(num))
+	case 3:
+		return append(dst, mt|26, byte(num>>24), byte(num>>16), byte(num>>8), byte(num))
+	}
+	return append(dst, mt|27, byte(num>>56), byte(num>>48), byte(num>>40), byte(num>>32), byte(num>>24), byte(num>>16), byte(num>>8), byte(num))
+}
+
+// chunks splits b into definite-length chunks (at rune boundaries for text).
+func (l *loose) chunks(b []byte, text bool) [][]byte {
+	var out [][]byte
+	for len(b) > 0 {
+		k := n(l.tc, 0, len(b))
+		if text {
+			for k < len(b) && k > 0 && !utf8.RuneStart(b[k]) {
+				k++
+			}
+		}
+		if k == 0 && chance(l.tc, 50) {
+			out = append(out, []byte{}) // an empty chunk is a definite-length string too
+			continue
+		}
+		if k == 0 {
+			k = len(b)
+			if text {
+				// keep rune boundaries: len(b) always is one
+			}
+		}
+		out = append(out, b[:k])
+		b = b[k:]
+	}
+	if len(out) == 0 && chance(l.tc, 30) {
+		out = append(out, []byte{})
+	}
+	return out
+}
+
+func (l *loose) encode(dst []byte, v *val, depth int) []byte {
+	l.maxLevels = max(l.maxLevels, depth)
+	switch v.kind {
+	case kUint:
+		return l.head(dst, 0, v.u)
+	case kNeg:
+		return l.head(dst, 1, v.u)
+	case kBytes, kText:
+		mt := byte(2)
+		if v.kind == kText {
+			mt = 3
+		}
+		if chance(l.tc, 20) {
+			l.indef = true
+			dst = append(dst, mt<<5|31)
+			for _, c := range l.chunks(v.b, v.kind == kText) {
+				dst = append(l.head(dst, mt, uint64(len(c))), c...)
+			}
+			return append(dst, 0xff)
+		}
+		return append(l.head(dst, mt, uint64(len(v.b))), v.b...)
+	case kArray:
+		if chance(l.tc, 20) {
+			l.indef = true
+			dst = append(dst, 4<<5|31)
+			for _, e := range v.a {
+				dst = l.encode(dst, e, depth+1)
+			}
+			return append(dst, 0xff)
+		}
+		dst = l.head(dst, 4, uint64(len(v.a)))
+		for _, e := range v.a {
+			dst = l.encode(dst, e, depth+1)
+		}
+		return dst
+	case kMap:
+		// Model order shuffled a little: the decoder must not care.
+		pairs := append([]kv(nil), v.m...)
+		if len(pairs) > 1 && chance(l.tc, 50) {
+			i, j := n(l.tc, 0, len(pairs)-1), n(l.tc, 0, len(pairs)-1)
+			pairs[i], pairs[j] = pairs[j], pairs[i]
+		}
+		if chance(l.tc, 20) {
+			l.indef = true
+			dst = append(dst, 5<<5|31)
+			for _, e := range pairs {
+				dst = l.encode(dst, e.k, depth+1)
+				dst = l.encode(dst, e.v, depth+1)
+			}
+			return append(dst, 0xff)
+		}
+		dst = l.head(dst, 5, uint64(len(pairs)))
+		for _, e := range pairs {
+			dst = l.encode(dst, e.k, depth+1)
+			dst = l.encode(dst, e.v, depth+1)
+		}
+		return dst
+	case kTag:
+		return l.encode(l.head(dst, 6, v.u), v.a[0], depth+1)
+	case kSimple, kBool, kNull, kUndef:
+		return appendVal(dst, v, styleCoreDet)
+	case kFloat:
+		f := v.f
+		var forms [][]byte
+		if math.IsNaN(f) {
+			forms = append(forms, appendF16(nil, 0x7e00), appendF16(nil, 0xfe00), appendF16(nil, 0x7c01), appendF32(nil, 0x7fc00000), appendF32(nil, 0x7f800001), appendF64(nil, math.Float64bits(f)))
+		} else {
+			forms = append(forms, appendF64(nil, math.Float64bits(f)))
+			if f32exact(f) {
+				forms = append(forms, appendF32(nil, math.Float32bits(float32(f))))
+			}
+			if b, ok := f16bits(f); ok {
+				forms = append(forms, appendF16(nil, b))
+			}
+		}
+		form := pick(l.tc, forms...)
+		if form[0] != shortestFloat(nil, f)[0] {
+			l.widths = true
+		}
+		return append(dst, form...)
+	}
+	panic("bad kind")
+}
+
+// ---------------------------------------------------------------------------
+// The well-formedness grammar (RFC 8949 Appendix C). wellformed returns the
+// length of the first data item in data, or an error.
+
+var errNotWellformed = errors.New("not well-formed")
+
+type wfParser struct {
+	data []byte
+	off  int
+}
+
+func wellformed(data []byte) (int, error) {
+	p := &wfParser{data: data}
+	if err := p.item(false); err != nil {
+		return 0, err
+	}
+	return p.off, nil
+}
+
+func (p *wfParser) take(k int) ([]byte, error) {
+	if p.off+k > len(p.data) {
+		return nil, io.ErrUnexpectedEOF
+	}
+	b := p.data[p.off : p.off+k]
+	p.off += k
+	return b, nil
+}
+
+// item consumes one data item; with breakable a break code is allowed and
+// reported as errBreak.
+var errBreak = errors.New("break")
+
+func (p *wfParser) item(breakable bool) error {
+	ib, err := p.take(1)
+	if err != nil {
+		return err
+	}
+	mt, ai := ib[0]>>5, ib[0]&31
+	var n uint64
+	switch {
+	case ai < 24:
+		n = uint64(ai)
+	case ai <= 27:
+		b, err := p.take(1 << (ai - 24))
+		if err != nil {
+			return err
+		}
+		for _, x := range b {
+			n = n<<8 | uint64(x)
+		}
+	case ai < 31:
+		return errNotWellformed
+	default: // 31
+		return p.indefinite(mt, breakable)
+	}
+	switch mt {
+	case 0, 1:
+		return nil
+	case 2, 3:
+		if n > uint64(len(p.data)-p.off) {
+			return io.ErrUnexpectedEOF
+		}
+		p.off += int(n)
+		return nil
+	case 4:
+		for i := uint64(0); i < n; i++ {
+			if err := p.item(false); err != nil {
+				return err
+			}
+		}
+		return nil
+	case 5:
+		for i := uint64(0); i < 2*n; i++ {
+			if err := p.item(false); err != nil {
+				return err
+			}
+			if i == math.MaxUint64 {
+				return errNotWellformed
+			}
+		}
+		return nil
+	case 6:
+		return p.item(false)
+	default: // 7
+		if ai == 24 && n < 32 {
+			return errNotWellformed
+		}
+		return nil
+	}
+}
+
+func (p *wfParser) indefinite(mt byte, breakable bool) error {
+	switch mt {
+	case 2, 3:
+		// Chunks: definite-length strings of the same major type.
+		for {
+			if p.off >= len(p.data) {
+				return io.ErrUnexpectedEOF
+			}
+			ib := p.data[p.off]
+			if ib == 0xff {
+				p.off++
+				return nil
+			}
+			if ib>>5 != mt || ib&31 == 31 {
+				return errNotWellformed
+			}
+			if err := p.item(false); err != nil {
+				return err
+			}
+		}
+	case 4:
+		for {
+			err := p.item(true)
+			if err == errBreak {
+				return nil
+			}
+			if err != nil {
+				return err
+			}
+		}
+	case 5:
+		for {
+			err := p.item(true)
+			if err == errBreak {
+				return nil
+			}
+			if err != nil {
+				return err
+			}
+			if err := p.item(false); err != nil {
+				return err
+			}
+		}
+	case 7:
+		if breakable {
+			return errBreak
+		}
+		return errNotWellformed
+	}
+	return errNotWellformed
+}
+
+// ---------------------------------------------------------------------------
+// Go values for the model and back.
+
+// toGo builds the Go value that Marshal must encode as v: uint64, int64 or
+// *big.Int, []byte, string, []any, map[any]any (byte-string keys as
+// cbor.ByteString), cbor.Tag, cbor.SimpleValue, bool, nil, float64.
+func toGo(v *val) any {
+	switch v.kind {
+	case kUint:
+		return v.u
+	case kNeg:
+		if v.u <= math.MaxInt64 {
+			return -1 - int64(v.u)
+		}
+		x := new(big.Int).SetUint64(v.u)
+		x.Add(x, big.NewInt(1))
+		return x.Neg(x)
+	case kBytes:
+		return append([]byte{}, v.b...)
+	case kText:
+		return string(v.b)
+	case kArray:
+		out := make([]any, len(v.a))
+		for i, e := range v.a {
+			out[i] = toGo(e)
+		}
+		return out
+	case kMap:
+		out := make(map[any]any, len(v.m))
+		for _, e := range v.m {
+			k := toGo(e.k)
+			if e.k.kind == kBytes {
+				k = cbor.ByteString(e.k.b)
+			}
+			out[k] = toGo(e.v)
+		}
+		return out
+	case kTag:
+		return cbor.Tag{Number: v.u, Content: toGo(v.a[0])}
+	case kSimple:
+		return cbor.SimpleValue(v.u)
+	case kBool:
+		return v.bo
+	case kNull:
+		return nil
+	case kUndef:
+		panic("undefined has no Go value")
+	case kFloat:
+		return v.f
+	}
+	panic("bad kind")
+}
+
+// fromGo turns what Unmarshal produced for a value of type any back into a
+// model item (nil for undefined and null both become null).
+func fromGo(x any) *val {
+	switch x := x.(type) {
+	case nil:
+		return vNull()
+	case uint64:
+		return vUint(x)
+	case int64:
+		if x >= 0 {
+			return vUint(uint64(x))
+		}
+		return vNeg(uint64(-(x + 1)))
+	case big.Int:
+		return vBig(&x)
+	case *big.Int:
+		return vBig(x)
+	case []byte:
+		return vBytes(x)
+	case cbor.ByteString:
+		return vBytes([]byte(x))
+	case string:
+		return vText(x)
+	case []any:
+		out := make([]*val, len(x))
+		for i, e := range x {
+			out[i] = fromGo(e)
+		}
+		return vArray(out...)
+	case map[any]any:
+		out := make([]kv, 0, len(x))
+		for k, v := range x {
+			out = append(out, kv{fromGo(k), fromGo(v)})
+		}
+		return vMap(out...)
+	case cbor.Tag:
+		return vTag(x.Number, fromGo(x.Content))
+	case cbor.SimpleValue:
+		return vSimple(uint64(x))
+	case bool:
+		return vBool(x)
+	case float64:
+		return vFloat(x)
+	case float32:
+		return vFloat(float64(x))
+	}
+	panic(fmt.Sprintf("fromGo: unexpected %T", x))
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+func genText(tc hegel.TestCase, maxRunes int) []byte {
+	k := n(tc, 0, maxRunes)
+	if chance(tc, 10) {
+		k = n(tc, 0, 300)
+	}
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		switch n(tc, 0, 9) {
+		case 0:
+			sb.WriteRune(rune(n(tc, 0x80, 0x7ff)))
+		case 1:
+			sb.WriteRune(rune(pick(tc, 0x800, 0xffff, 0xe000, 0xfffd, 0x2028, 0x1234)))
+		case 2:
+			sb.WriteRune(rune(n(tc, 0x10000, 0x10ffff)))
+		case 3:
+			sb.WriteByte(byte(n(tc, 0, 31)))
+		default:
+			sb.WriteByte(byte(n(tc, 32, 126)))
+		}
+	}
+	return []byte(sb.String())
+}
+
+func genBytes(tc hegel.TestCase, maxLen int) []byte {
+	k := n(tc, 0, maxLen)
+	if chance(tc, 10) {
+		k = n(tc, 0, 300)
+	}
+	b := make([]byte, k)
+	for i := range b {
+		b[i] = byte(n(tc, 0, 255))
+	}
+	return b
+}
+
+// genUint draws an unsigned integer over all head widths.
+func genUint(tc hegel.TestCase) uint64 {
+	switch n(tc, 0, 5) {
+	case 0:
+		return uint64(n(tc, 0, 23))
+	case 1:
+		return uint64(n(tc, 24, 255))
+	case 2:
+		return uint64(n(tc, 256, 65535))
+	case 3:
+		return uint64(n(tc, 65536, math.MaxUint32))
+	case 4:
+		return uint64(n(tc, 0, math.MaxInt64)) + uint64(n(tc, 0, math.MaxInt64))
+	}
+	return pick(tc, uint64(0), 1, 23, 24, 255, 256, 65535, 65536, math.MaxUint32, math.MaxUint32+1, math.MaxInt64, math.MaxInt64+1, math.MaxUint64, math.MaxUint64-1)
+}
+
+func genFloat(tc hegel.TestCase) float64 {
+	switch n(tc, 0, 6) {
+	case 0: // exact binary16 values
+		return float64(n(tc, -2048, 2048)) / float64(pick(tc, 1, 2, 4, 1024, 1<<14, 1<<24))
+	case 1: // exact binary32 values
+		return float64(math.Float32frombits(uint32(n(tc, 0, math.MaxUint32))))
+	case 2:
+		return math.Float64frombits(uint64(n(tc, 0, math.MaxInt64))*2 + uint64(n(tc, 0, 1)))
+	case 3:
+		return pick(tc, 0.0, math.Copysign(0, -1), 1, -1, 0.5, 1.5, 65504, 65505, 65520, 1e300, -1e-300, 5.960464477539063e-08, 6.103515625e-05, 3.4028234663852886e+38, 3.4028235e38, 1.0/3, math.MaxFloat64, math.SmallestNonzeroFloat64, 2.2250738585072014e-308)
+	case 4:
+		return pick(tc, math.Inf(1), math.Inf(-1), math.NaN(), math.Float64frombits(0x7ff0000000000001), math.Float64frombits(0xfff8000000000000), math.Float64frombits(0x7ff4000000000000))
+	case 5:
+		return float64(n(tc, -1000000, 1000000)) / 1000
+	}
+	return float64(n(tc, -100000, 100000))
+}
+
+type genOpts struct {
+	undefined bool // may produce undefined (no Go value)
+	floatKeys bool
+	tags      bool
+	maxDepth  int
+	maxItems  int
+}
+
+var genAny = genOpts{tags: true, maxDepth: 4, maxItems: 6}
+
+// genKey draws a map key: kinds with a Go identity that matches CBOR's.
+func genKey(tc hegel.TestCase, o genOpts, depth int) *val {
+	switch n(tc, 0, 7) {
+	case 0, 1:
+		return vUint(genUint(tc))
+	case 2:
+		// A negative key beyond int64 decodes to big.Int, which Go cannot
+		// hash (InvalidMapKeyTypeError): keys stay within int64.
+		return vNeg(genUint(tc) >> 1)
+	case 3:
+		return vBytes(genBytes(tc, 6))
+	case 4:
+		return pick(tc, vBool(true), vBool(false), vNull(), vSimple(uint64(n(tc, 0, 19))), vSimple(uint64(n(tc, 32, 255))))
+	}
+	return vText(string(genText(tc, 6)))
+}
+
+func genVal(tc hegel.TestCase, o genOpts, depth int) *val {
+	top := 12
+	if depth >= o.maxDepth {
+		top = 8
+	}
+	switch n(tc, 0, top) {
+	case 0, 1:
+		return vUint(genUint(tc))
+	case 2:
+		return vNeg(genUint(tc))
+	case 3:
+		return vBytes(genBytes(tc, 12))
+	case 4:
+		return vText(string(genText(tc, 12)))
+	case 5:
+		return vFloat(genFloat(tc))
+	case 6:
+		if o.undefined && chance(tc, 20) {
+			return &val{kind: kUndef}
+		}
+		return pick(tc, vBool(true), vBool(false), vNull())
+	case 7:
+		if chance(tc, 50) {
+			return vSimple(uint64(n(tc, 0, 19)))
+		}
+		return vSimple(uint64(n(tc, 32, 255)))
+	case 8:
+		if o.tags && chance(tc, 30) {
+			// Bignums: tag 2/3 with a magnitude beyond 64 bits (the preferred
+			// form of anything smaller is the plain integer).
+			mag := make([]byte, n(tc, 9, 20))
+			for i := range mag {
+				mag[i] = byte(n(tc, 0, 255))
+			}
+			mag[0] |= 1
+			if len(mag) == 9 && mag[0] == 0 {
+				mag[0] = 1
+			}
+			return vTag(uint64(n(tc, 2, 3)), vBytes(mag))
+		}
+		return vUint(uint64(n(tc, 0, 1000)))
+	case 9, 10:
+		k := n(tc, 0, o.maxItems)
+		a := make([]*val, k)
+		for i := range a {
+			a[i] = genVal(tc, o, depth+1)
+		}
+		return vArray(a...)
+	case 11:
+		k := n(tc, 0, o.maxItems)
+		seen := map[string]bool{}
+		var m []kv
+		for i := 0; i < k; i++ {
+			key := genKey(tc, o, depth+1)
+			ek := string(encode(key, styleCoreDet))
+			if seen[ek] {
+				continue
+			}
+			seen[ek] = true
+			m = append(m, kv{key, genVal(tc, o, depth+1)})
+		}
+		return vMap(m...)
+	}
+	// case 12: a tag other than 0–3 (time and bignums have their own
+	// decoding) and 55799 (the self-described-CBOR tag is dropped).
+	if !o.tags {
+		return vUint(uint64(n(tc, 0, 1000)))
+	}
+	num := pick(tc, uint64(4), 5, 21, 22, 23, 24, 25, 32, 33, 34, 35, 36, 37, 100, 1000, 1001, 24999, 65535, 65536, 1<<32, math.MaxUint64, uint64(n(tc, 4, 100000)))
+	return vTag(num, genVal(tc, o, depth+1))
+}
+
+// ---------------------------------------------------------------------------
+// Decoding helpers.
+
+var liberalDec = func() cbor.DecMode {
+	dm, err := cbor.DecOptions{MapKeyByteString: cbor.MapKeyByteStringAllowed, MaxNestedLevels: 65535}.DecMode()
+	if err != nil {
+		panic(err)
+	}
+	return dm
+}()
+
+func decodeAny(dm cbor.DecMode, data []byte) (any, error) {
+	var x any
+	err := dm.Unmarshal(data, &x)
+	return x, err
+}
+
+func mustEncMode(o cbor.EncOptions) cbor.EncMode {
+	em, err := o.EncMode()
+	if err != nil {
+		panic(err)
+	}
+	return em
+}
+
+var (
+	encCoreDet   = mustEncMode(cbor.CoreDetEncOptions())
+	encCanonical = mustEncMode(cbor.CanonicalEncOptions())
+	encCTAP2     = mustEncMode(cbor.CTAP2EncOptions())
+)
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// The three deterministic encodings of a Go value are what RFC 8949 / RFC 7049
+// / CTAP2 prescribe: preferred integer and length heads, sorted map keys,
+// shortest floats (Core Deterministic and Canonical) or unchanged float64
+// (CTAP2, which also forbids tags).
+func TestHegelDeterministicEncodingsMatchTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genVal(ht, genAny, 0)
+		note(ht, "value %s", v)
+		x := toGo(v)
+		for _, c := range []struct {
+			name string
+			em   cbor.EncMode
+			st   encStyle
+		}{{"CoreDet", encCoreDet, styleCoreDet}, {"Canonical", encCanonical, styleCanonical}, {"CTAP2", encCTAP2, styleCTAP2}} {
+			want := encode(v, c.st)
+			got, err := c.em.Marshal(x)
+			if c.name == "CTAP2" && v.hasTag() {
+				if err == nil {
+					fail(ht, "%s: Marshal accepted a value with a tag: %s -> %x", c.name, v, got)
+				}
+				continue
+			}
+			if err != nil {
+				fail(ht, "%s: Marshal(%s) failed: %v", c.name, v, err)
+			}
+			if !bytes.Equal(got, want) {
+				fail(ht, "%s: Marshal(%s)\n got  %x\n want %x", c.name, v, got, want)
+			}
+			if err := cbor.Wellformed(got); err != nil {
+				fail(ht, "%s: Wellformed rejects the encoder's own output %x: %v", c.name, got, err)
+			}
+			// The default mode (unsorted, float64 as written) produces the same
+			// value: the difference is representation only.
+			d, err := decodeAny(liberalDec, got)
+			if err != nil {
+				fail(ht, "%s: Unmarshal(%x) of %s failed: %v", c.name, got, v, err)
+			}
+			if back := fromGo(d); !same(back, v) {
+				fail(ht, "%s: %s encoded %x decoded to %s", c.name, v, got, back)
+			}
+		}
+		// The default encoding mode keeps float64 as written and does not
+		// sort; it must still be well-formed and decode to the same value.
+		got, err := cbor.Marshal(x)
+		if err != nil {
+			fail(ht, "Marshal(%s) failed: %v", v, err)
+		}
+		if _, err := wellformed(got); err != nil {
+			fail(ht, "Marshal(%s) = %x is not well-formed by the model: %v", v, got, err)
+		}
+		if k, _ := wellformed(got); k != len(got) {
+			fail(ht, "Marshal(%s) = %x: the first item ends at %d", v, got, k)
+		}
+		d, err := decodeAny(liberalDec, got)
+		if err != nil {
+			fail(ht, "Unmarshal(Marshal(%s) = %x) failed: %v", v, got, err)
+		}
+		if back := fromGo(d); !same(back, v) {
+			fail(ht, "%s encoded %x decoded to %s", v, got, back)
+		}
+		// The deterministic re-encoding of the decoded value is the same
+		// bytes: determinism reaches through a decode.
+		if again, err := encCoreDet.Marshal(d); err != nil || !bytes.Equal(again, encode(v, styleCoreDet)) {
+			fail(ht, "CoreDet re-encoding of the decoded %s: %x, %v; want %x", v, again, err, encode(v, styleCoreDet))
+		}
+	})
+}
+
+// Any representation of a data item the RFC allows (wider heads,
+// indefinite-length strings and containers in chunks, any float width that
+// holds the value, any map order) decodes to the same value; Wellformed and
+// Diagnose accept it; UnmarshalFirst and DiagnoseFirst stop at its end.
+func TestHegelAnyRepresentationDecodesToTheValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genVal(ht, genOpts{undefined: true, tags: true, maxDepth: 4, maxItems: 6}, 0)
+		l := &loose{tc: ht}
+		data := l.encode(nil, v, 0)
+		note(ht, "value %s\nencoding %x (indef %v, wide heads %v)", v, data, l.indef, l.widths)
+		if k, err := wellformed(data); err != nil || k != len(data) {
+			ht.Fatalf("harness: loose encoding %x of %s is not well-formed by the model: %d, %v", data, v, k, err)
+		}
+		if err := cbor.Wellformed(data); err != nil {
+			fail(ht, "Wellformed(%x) of %s: %v", data, v, err)
+		}
+		d, err := decodeAny(liberalDec, data)
+		if err != nil {
+			fail(ht, "Unmarshal(%x) of %s: %v", data, v, err)
+		}
+		want := v
+		if v.kind == kUndef {
+			want = vNull()
+		}
+		// undefined inside containers becomes nil as well.
+		wantNorm := normUndef(want)
+		if back := fromGo(d); !same(back, wantNorm) {
+			fail(ht, "Unmarshal(%x) of %s gave %s", data, v, back)
+		}
+		if _, err := cbor.Diagnose(data); err != nil {
+			fail(ht, "Diagnose(%x) of %s: %v", data, v, err)
+		}
+		// Trailing data: UnmarshalFirst and DiagnoseFirst return exactly it,
+		// Unmarshal and Wellformed reject it.
+		tail := []byte{0x01, 0x82, 0xf6, 0xf6}[:n(ht, 1, 4)]
+		var x any
+		rest, err := liberalDec.UnmarshalFirst(append(append([]byte{}, data...), tail...), &x)
+		if err != nil || !bytes.Equal(rest, tail) {
+			fail(ht, "UnmarshalFirst(%x | %x): rest %x, %v", data, tail, rest, err)
+		}
+		if back := fromGo(x); !same(back, wantNorm) {
+			fail(ht, "UnmarshalFirst(%x | %x) gave %s, want %s", data, tail, back, v)
+		}
+		_, rest, err = cbor.DiagnoseFirst(append(append([]byte{}, data...), tail...))
+		if err != nil || !bytes.Equal(rest, tail) {
+			fail(ht, "DiagnoseFirst(%x | %x): rest %x, %v", data, tail, rest, err)
+		}
+		var ext *cbor.ExtraneousDataError
+		if err := liberalDec.Wellformed(append(append([]byte{}, data...), tail...)); !errors.As(err, &ext) {
+			fail(ht, "Wellformed(%x | %x) = %v, want ExtraneousDataError", data, tail, err)
+		}
+		if _, err := decodeAny(liberalDec, append(append([]byte{}, data...), tail...)); !errors.As(err, &ext) {
+			fail(ht, "Unmarshal(%x | %x) = %v, want ExtraneousDataError", data, tail, err)
+		}
+		// Every proper prefix is an unexpected EOF, for Wellformed and
+		// Unmarshal alike.
+		if len(data) > 1 {
+			cut := n(ht, 1, len(data)-1)
+			if err := liberalDec.Wellformed(data[:cut]); !errors.Is(err, io.ErrUnexpectedEOF) {
+				fail(ht, "Wellformed(%x cut at %d) = %v, want io.ErrUnexpectedEOF", data, cut, err)
+			}
+			if _, err := decodeAny(liberalDec, data[:cut]); !errors.Is(err, io.ErrUnexpectedEOF) {
+				fail(ht, "Unmarshal(%x cut at %d) = %v, want io.ErrUnexpectedEOF", data, cut, err)
+			}
+		}
+	})
+}
