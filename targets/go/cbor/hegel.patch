+// Floating-point values keep their value through every encoding: the
+// shortest form preserving the value under ShortestFloat16 (the model's own
+// binary16 arithmetic decides which forms are exact), float64/float32 as
+// written under ShortestFloatNone, the NaN and Inf conversions as documented;
+// every float width decodes to the same float64 and to a float32 when it
+// fits.
+func TestHegelFloatsKeepTheirValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := genFloat(ht)
+		bits := math.Float64bits(f)
+		note(ht, "float %v (%016x)", f, bits)
+		isNaN := math.IsNaN(f)
+		// The default mode: float64 and float32 as written, except that the
+		// default InfConvertFloat16 writes infinities as binary16 (and the
+		// default NaNConvert7e00 every NaN as f97e00).
+		if !isNaN {
+			b, err := cbor.Marshal(f)
+			exp := appendF64(nil, bits)
+			if math.IsInf(f, 0) {
+				exp = shortestFloat(nil, f)
+			}
+			if err != nil || !bytes.Equal(b, exp) {
+				fail(ht, "Marshal(float64 %v) = %x, %v; want %x", f, b, err, exp)
+			}
+			f32 := float32(f)
+			b, err = cbor.Marshal(f32)
+			exp = appendF32(nil, math.Float32bits(f32))
+			if math.IsInf(float64(f32), 0) { // f itself, or the conversion overflowing
+				exp = shortestFloat(nil, float64(f32))
+			}
+			if err != nil || !bytes.Equal(b, exp) {
+				fail(ht, "Marshal(float32 %v) = %x, %v; want %x", f32, b, err, exp)
+			}
+		} else if b, err := cbor.Marshal(f); err != nil || !bytes.Equal(b, appendF16(nil, 0x7e00)) {
+			fail(ht, "Marshal(NaN %016x) = %x, %v; want f97e00", bits, b, err)
+		}
+		// ShortestFloat16 with the RFC conversions.
+		em := mustEncMode(cbor.EncOptions{ShortestFloat: cbor.ShortestFloat16, NaNConvert: cbor.NaNConvert7e00, InfConvert: cbor.InfConvertFloat16})
+		b, err := em.Marshal(f)
+		if err != nil || !bytes.Equal(b, shortestFloat(nil, f)) {
+			fail(ht, "ShortestFloat16 Marshal(%v %016x) = %x, %v; want %x", f, bits, b, err, shortestFloat(nil, f))
+		}
+		// InfConvertNone keeps Inf as float64; ShortestFloat16 with
+		// InfConvertNone still shortens finite values.
+		emInf := mustEncMode(cbor.EncOptions{ShortestFloat: cbor.ShortestFloat16, InfConvert: cbor.InfConvertNone, NaNConvert: cbor.NaNConvertNone})
+		b, err = emInf.Marshal(f)
+		switch {
+		case math.IsInf(f, 0) || isNaN:
+			if err != nil || !bytes.Equal(b, appendF64(nil, bits)) {
+				fail(ht, "ShortestFloat16+InfConvertNone+NaNConvertNone Marshal(%v %016x) = %x, %v; want %x", f, bits, b, err, appendF64(nil, bits))
+			}
+		default:
+			if err != nil || !bytes.Equal(b, shortestFloat(nil, f)) {
+				fail(ht, "ShortestFloat16+InfConvertNone Marshal(%v) = %x, %v; want %x", f, b, err, shortestFloat(nil, f))
+			}
+		}
+		// NaN conversions.
+		if isNaN {
+			// PreserveSignal: the shortest form whose zero-padded payload
+			// reconstitutes the NaN; "signal" (quiet bit) preserved.
+			emP := mustEncMode(cbor.EncOptions{NaNConvert: cbor.NaNConvertPreserveSignal})
+			b, err := emP.Marshal(f)
+			if err != nil {
+				fail(ht, "NaNConvertPreserveSignal Marshal(%016x): %v", bits, err)
+			}
+			var back float64
+			if err := cbor.Unmarshal(b, &back); err != nil || !math.IsNaN(back) {
+				fail(ht, "NaNConvertPreserveSignal %016x -> %x -> %v, %v", bits, b, back, err)
+			}
+			// The shortest exact form: payload bits below the kept width zero.
+			exp := nanShortest(bits)
+			if !bytes.Equal(b, exp) {
+				fail(ht, "NaNConvertPreserveSignal Marshal(%016x) = %x, want %x", bits, b, exp)
+			}
+			emQ := mustEncMode(cbor.EncOptions{NaNConvert: cbor.NaNConvertQuiet})
+			b, err = emQ.Marshal(f)
+			if err != nil {
+				fail(ht, "NaNConvertQuiet Marshal(%016x): %v", bits, err)
+			}
+			exp = nanShortest(bits | 1<<51)
+			if !bytes.Equal(b, exp) {
+				fail(ht, "NaNConvertQuiet Marshal(%016x) = %x, want %x", bits, b, exp)
+			}
+			emR := mustEncMode(cbor.EncOptions{NaNConvert: cbor.NaNConvertReject})
+			if _, err := emR.Marshal(f); err == nil {
+				fail(ht, "NaNConvertReject accepted %016x", bits)
+			}
+			var ute *cbor.UnsupportedValueError
+			if _, err := emR.Marshal(f); !errors.As(err, &ute) {
+				fail(ht, "NaNConvertReject on %016x: %v, want UnsupportedValueError", bits, err)
+			}
+		}
+		// Decoding: each exact form gives the same float64; float32 targets
+		// get the value when it fits.
+		var forms [][]byte
+		forms = append(forms, appendF64(nil, bits))
+		if f32exact(f) {
+			forms = append(forms, appendF32(nil, math.Float32bits(float32(f))))
+		}
+		if hb, ok := f16bits(f); ok {
+			forms = append(forms, appendF16(nil, hb))
+		}
+		for _, data := range forms {
+			var back float64
+			if err := cbor.Unmarshal(data, &back); err != nil {
+				fail(ht, "Unmarshal(%x) into float64: %v", data, err)
+			}
+			if !(isNaN && math.IsNaN(back)) && math.Float64bits(back) != bits {
+				fail(ht, "Unmarshal(%x) into float64 = %v (%016x), want %v (%016x)", data, back, math.Float64bits(back), f, bits)
+			}
+			a, err := decodeAny(liberalDec, data)
+			if err != nil {
+				fail(ht, "Unmarshal(%x) into any: %v", data, err)
+			}
+			if af, ok := a.(float64); !ok || (!(isNaN && math.IsNaN(af)) && math.Float64bits(af) != bits) {
+				fail(ht, "Unmarshal(%x) into any = %#v, want float64 %v", data, a, f)
+			}
+			var back32 float32
+			err = cbor.Unmarshal(data, &back32)
+			if f32exact(f) || isNaN || math.IsInf(f, 0) {
+				if err != nil {
+					fail(ht, "Unmarshal(%x = %v) into float32: %v", data, f, err)
+				}
+				if !isNaN && float64(back32) != f {
+					fail(ht, "Unmarshal(%x = %v) into float32 = %v", data, f, back32)
+				}
+			}
+			// Diagnose renders a number that parses back to the value.
+			s, err := cbor.Diagnose(data)
+			if err != nil {
+				fail(ht, "Diagnose(%x): %v", data, err)
+			}
+			if !isNaN && !math.IsInf(f, 0) {
+				num := strings.TrimSuffix(s, "_1")
+				num = strings.TrimSuffix(num, "_2")
+				num = strings.TrimSuffix(num, "_3")
+				p, perr := strconv.ParseFloat(num, 64)
+				if perr != nil || math.Float64bits(p) != bits {
+					fail(ht, "Diagnose(%x = %v %016x) = %q, parses to %v (%016x), %v", data, f, bits, s, p, math.Float64bits(p), perr)
+				}
+			}
+		}
+		// The NaN/Inf decoding modes.
+		dmNaN, _ := cbor.DecOptions{NaN: cbor.NaNDecodeForbidden}.DecMode()
+		dmInf, _ := cbor.DecOptions{Inf: cbor.InfDecodeForbidden}.DecMode()
+		data := appendF64(nil, bits)
+		var back float64
+		if err := dmNaN.Unmarshal(data, &back); (err != nil) != isNaN {
+			fail(ht, "NaNDecodeForbidden on %x (%v): %v", data, f, err)
+		}
+		if err := dmInf.Unmarshal(data, &back); (err != nil) != math.IsInf(f, 0) {
+			fail(ht, "InfDecodeForbidden on %x (%v): %v", data, f, err)
+		}
+	})
+}
+
+// nanShortest is the shortest float encoding of a NaN whose payload,
+// zero-padded, reconstitutes the binary64 NaN bits (RFC 8949 §4.2.2).
+func nanShortest(bits uint64) []byte {
+	sign := bits >> 63
+	mant := bits & (1<<52 - 1)
+	if mant&(1<<42-1) == 0 {
+		return appendF16(nil, uint16(sign<<15|0x7c00|mant>>42))
+	}
+	if mant&(1<<29-1) == 0 {
+		return appendF32(nil, uint32(sign<<31|0x7f800000|mant>>29))
+	}
+	return appendF64(nil, bits)
+}
+
+// Struct tags follow the documented rules: field names (or `cbor:"name"`)
+// as text keys, keyasint keys as integers, toarray as an array of the fields
+// in order, omitempty/omitzero dropping the empty/zero fields; the encoding
+// is the model's and it decodes back to the struct.
+type tagged struct {
+	A int64   `cbor:"1,keyasint"`
+	B string  `cbor:"b,omitempty"`
+	C []byte  `cbor:"c,omitempty"`
+	D float64 `cbor:"d,omitzero"`
+	E *inner  `cbor:"e,omitempty"`
+	F bool    `cbor:"-"`
+	G uint8   `cbor:"7,keyasint,omitempty"`
+	H []any   `cbor:"h"`
+	I map[string]int32
+	J inner `cbor:"j"`
+}
+
+type inner struct {
+	_ struct{} `cbor:",toarray"`
+	X uint16
+	Y string
+	Z []uint8
+}
+
+func TestHegelStructTagsFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		genInner := func() inner {
+			return inner{X: uint16(genUint(ht) & 0xffff), Y: string(genText(ht, 5)), Z: genBytes(ht, 5)}
+		}
+		s := tagged{
+			A: int64(genUint(ht) >> n(ht, 1, 63)),
+			B: string(genText(ht, 5)),
+			C: genBytes(ht, 4),
+			D: pick(ht, 0.0, math.Copysign(0, -1), 1.5, genFloat(ht)),
+			F: chance(ht, 50),
+			G: uint8(n(ht, 0, 255)),
+			J: genInner(),
+		}
+		if chance(ht, 50) {
+			s.A = -s.A
+		}
+		if chance(ht, 40) {
+			s.B = ""
+		}
+		if chance(ht, 40) {
+			s.C = nil
+		} else if chance(ht, 30) {
+			s.C = []byte{}
+		}
+		if chance(ht, 50) {
+			in := genInner()
+			s.E = &in
+		}
+		if chance(ht, 60) {
+			s.H = make([]any, n(ht, 0, 3))
+			for i := range s.H {
+				s.H[i] = toGo(genVal(ht, genOpts{maxDepth: 1, maxItems: 2}, 0))
+			}
+		}
+		if chance(ht, 60) {
+			s.I = map[string]int32{}
+			for i := n(ht, 0, 3); i > 0; i-- {
+				s.I[string(genText(ht, 3))] = int32(n(ht, math.MinInt32, math.MaxInt32))
+			}
+		}
+		note(ht, "struct %+v", s)
+		innerVal := func(in inner) *val {
+			return vArray(vUint(uint64(in.X)), vText(in.Y), vBytes(in.Z))
+		}
+		// The model map. Nil slices and maps encode as null (the default
+		// NilContainersMode), empty ones as empty containers.
+		var m []kv
+		m = append(m, kv{vUint(1), vBig(big.NewInt(s.A))})
+		if s.B != "" {
+			m = append(m, kv{vText("b"), vText(s.B)})
+		}
+		if len(s.C) > 0 {
+			m = append(m, kv{vText("c"), vBytes(s.C)})
+		}
+		if s.D != 0 { // omitzero: reflect.Value.IsZero, which is true for -0.0 as well (encoding/json omits it too)
+			m = append(m, kv{vText("d"), vFloat(s.D)})
+		}
+		if s.E != nil {
+			m = append(m, kv{vText("e"), innerVal(*s.E)})
+		}
+		if s.G != 0 {
+			m = append(m, kv{vUint(7), vUint(uint64(s.G))})
+		}
+		if s.H == nil {
+			m = append(m, kv{vText("h"), vNull()})
+		} else {
+			a := make([]*val, len(s.H))
+			for i, e := range s.H {
+				a[i] = fromGo(e)
+			}
+			m = append(m, kv{vText("h"), vArray(a...)})
+		}
+		if s.I == nil {
+			m = append(m, kv{vText("I"), vNull()})
+		} else {
+			var im []kv
+			for k, x := range s.I {
+				im = append(im, kv{vText(k), vBig(big.NewInt(int64(x)))})
+			}
+			m = append(m, kv{vText("I"), vMap(im...)})
+		}
+		m = append(m, kv{vText("j"), innerVal(s.J)})
+		want := vMap(m...)
+		got, err := encCoreDet.Marshal(s)
+		if err != nil {
+			fail(ht, "CoreDet Marshal(%+v): %v", s, err)
+		}
+		if exp := encode(want, styleCoreDet); !bytes.Equal(got, exp) {
+			fail(ht, "CoreDet Marshal(%+v)\n got  %x\n want %x (%s)", s, got, exp, want)
+		}
+		// Default mode: same value, order free.
+		def, err := cbor.Marshal(s)
+		if err != nil {
+			fail(ht, "Marshal(%+v): %v", s, err)
+		}
+		d, err := decodeAny(liberalDec, def)
+		if err != nil {
+			fail(ht, "Unmarshal(%x) into any: %v", def, err)
+		}
+		if back := fromGo(d); !same(back, want) {
+			fail(ht, "Marshal(%+v) = %x decoded to %s, want %s", s, def, back, want)
+		}
+		// Round trip into the struct (F is skipped by `cbor:"-"`, nil vs empty
+		// C is lost to omitempty).
+		var back tagged
+		if err := cbor.Unmarshal(def, &back); err != nil {
+			fail(ht, "Unmarshal(%x) into the struct: %v", def, err)
+		}
+		exp := s
+		exp.F = false
+		if len(exp.C) == 0 {
+			exp.C = nil
+		}
+		// H holds arbitrary values: compare those as model items (a *big.Int
+		// comes back as a big.Int value, for one).
+		if (back.H == nil) != (s.H == nil) || !same(fromGo(back.H), fromGo(s.H)) {
+			fail(ht, "round trip of %+v through %x gave H = %#v", s, def, back.H)
+		}
+		back.H, exp.H = nil, nil
+		if math.IsNaN(s.D) {
+			if !math.IsNaN(back.D) {
+				fail(ht, "round trip of %+v through %x gave D = %v", s, def, back.D)
+			}
+			back.D, exp.D = 0, 0
+		}
+		back.J, exp.J = normInner(back.J), normInner(exp.J)
+		if back.E != nil {
+			e := normInner(*back.E)
+			back.E = &e
+		}
+		if exp.E != nil {
+			e := normInner(*exp.E)
+			exp.E = &e
+		}
+		if !reflect.DeepEqual(back, exp) {
+			fail(ht, "round trip of %+v through %x gave %+v", s, def, back)
+		}
+		// toarray in a nested struct decodes from the model array.
+		var in inner
+		if err := cbor.Unmarshal(encode(innerVal(s.J), styleCoreDet), &in); err != nil || !reflect.DeepEqual(normInner(in), normInner(s.J)) {
+			fail(ht, "Unmarshal(%x) into the toarray struct = %+v, %v; want %+v", encode(innerVal(s.J), styleCoreDet), in, err, s.J)
+		}
+	})
+}
+
+func normInner(in inner) inner {
+	if len(in.Z) == 0 {
+		in.Z = nil
+	}
+	return in
+}
+
+// time.Time encodes as the documented content for each TimeMode (integer
+// seconds, float seconds to the microsecond, RFC 3339 text with or without
+// fractions and offset), tagged 1 or 0 when EncTagRequired, and decodes back
+// to the time within the mode's precision; the zero time is null.
+func TestHegelTimeRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		mode := pick(ht, cbor.TimeUnix, cbor.TimeUnixMicro, cbor.TimeUnixDynamic, cbor.TimeRFC3339, cbor.TimeRFC3339Nano, cbor.TimeRFC3339NanoUTC)
+		year := n(ht, 1, 9999)
+		if chance(ht, 50) {
+			year = n(ht, 1900, 2100)
+		}
+		if Known.unixMicroFarFromEpoch && mode == cbor.TimeUnixMicro && (year < 1679 || year > 2261) {
+			year = n(ht, 1679, 2261)
+		}
+		nsec := pick(ht, 0, 0, n(ht, 0, 999)*1000000, n(ht, 0, 999999)*1000, n(ht, 0, 999999999), 999999999, 500, 999999500)
+		loc := time.UTC
+		if chance(ht, 30) {
+			loc = time.FixedZone("zone", n(ht, -14*60, 14*60)*60)
+		}
+		tm := time.Date(year, time.Month(n(ht, 1, 12)), n(ht, 1, 28), n(ht, 0, 23), n(ht, 0, 59), n(ht, 0, 59), nsec, loc)
+		if chance(ht, 5) {
+			tm = time.Time{}
+		}
+		tagMode := pick(ht, cbor.EncTagNone, cbor.EncTagRequired)
+		note(ht, "time %v (unix %d.%09d) mode %d tag %d", tm, tm.Unix(), tm.Nanosecond(), mode, tagMode)
+		em := mustEncMode(cbor.EncOptions{Time: mode, TimeTag: tagMode})
+		got, err := em.Marshal(tm)
+		if err != nil {
+			fail(ht, "Marshal(%v) with mode %d: %v", tm, mode, err)
+		}
+		if err := cbor.Wellformed(got); err != nil {
+			fail(ht, "Marshal(%v) = %x: %v", tm, got, err)
+		}
+		// The content and its tag.
+		var content *val
+		var tag uint64 = 1
+		rounded := tm.UTC().Round(time.Microsecond)
+		var tol time.Duration
+		switch mode {
+		case cbor.TimeUnix:
+			content = vBig(big.NewInt(tm.Unix()))
+		case cbor.TimeUnixMicro:
+			// float64 seconds: the value is checked by decoding, within the
+			// precision of a binary64 at that magnitude.
+			tol = time.Duration(math.Abs(float64(rounded.Unix()))/(1<<50)*1e9) + time.Microsecond
+		case cbor.TimeUnixDynamic:
+			if rounded.Nanosecond() == 0 {
+				content = vBig(big.NewInt(rounded.Unix()))
+			} else {
+				tol = time.Duration(math.Abs(float64(rounded.Unix()))/(1<<50)*1e9) + time.Microsecond
+			}
+		case cbor.TimeRFC3339:
+			tag = 0
+			content = vText(tm.Format(time.RFC3339))
+		case cbor.TimeRFC3339Nano:
+			tag = 0
+			content = vText(tm.Format(time.RFC3339Nano))
+		default:
+			tag = 0
+			content = vText(tm.UTC().Format(time.RFC3339Nano))
+		}
+		if tm.IsZero() {
+			if !bytes.Equal(got, []byte{0xf6}) {
+				fail(ht, "Marshal(zero time) with mode %d tag %d = %x, want f6", mode, tagMode, got)
+			}
+		} else {
+			d, err := decodeAny(liberalDec, got)
+			if err != nil {
+				fail(ht, "Unmarshal(%x) of %v: %v", got, tm, err)
+			}
+			if tagMode == cbor.EncTagRequired {
+				// Tag 0/1 decodes to time.Time in any.
+				dt, ok := d.(time.Time)
+				if !ok {
+					fail(ht, "Unmarshal(%x) of %v into any = %#v, want time.Time", got, tm, d)
+				}
+				if content != nil && !bytes.Equal(got, encode(vTag(tag, content), styleCoreDet)) && mode != cbor.TimeUnixDynamic && mode != cbor.TimeUnixMicro {
+					fail(ht, "Marshal(%v) mode %d = %x, want %x", tm, mode, got, encode(vTag(tag, content), styleCoreDet))
+				}
+				if got[0] != 0xc0+byte(tag) {
+					fail(ht, "Marshal(%v) mode %d = %x: tag %d expected", tm, mode, got, tag)
+				}
+				checkTime(ht, tm, dt, mode, tol, got)
+			} else {
+				if got[0]>>5 == 6 {
+					fail(ht, "Marshal(%v) mode %d with EncTagNone = %x has a tag", tm, mode, got)
+				}
+				if content != nil {
+					if back := fromGo(d); !same(back, content) {
+						fail(ht, "Marshal(%v) mode %d = %x decodes to %s, want %s", tm, mode, got, back, content)
+					}
+				} else if _, ok := d.(float64); !ok {
+					fail(ht, "Marshal(%v) mode %d = %x decodes to %T, want a float", tm, mode, got, d)
+				}
+			}
+		}
+		// Into time.Time, with each DecTagMode.
+		for _, dtm := range []cbor.DecTagMode{cbor.DecTagIgnored, cbor.DecTagOptional, cbor.DecTagRequired} {
+			dm, err := cbor.DecOptions{TimeTag: dtm}.DecMode()
+			if err != nil {
+				fail(ht, "DecMode TimeTag %d: %v", dtm, err)
+			}
+			var back time.Time
+			err = dm.Unmarshal(got, &back)
+			if dtm == cbor.DecTagRequired && tagMode == cbor.EncTagNone && !tm.IsZero() {
+				if err == nil {
+					fail(ht, "DecTagRequired accepted the untagged %x", got)
+				}
+				continue
+			}
+			if err != nil {
+				fail(ht, "Unmarshal(%x) into time.Time with TimeTag %d: %v", got, dtm, err)
+			}
+			if tm.IsZero() {
+				if !back.IsZero() {
+					fail(ht, "null decoded to %v, want the zero time", back)
+				}
+				continue
+			}
+			checkTime(ht, tm, back, mode, tol, got)
+		}
+	})
+}
+
+// checkTime compares a decoded time with the original under the mode's
+// precision.
+func checkTime(ht *hegel.T, tm, back time.Time, mode cbor.TimeMode, tol time.Duration, data []byte) {
+	var want time.Time
+	switch mode {
+	case cbor.TimeUnix, cbor.TimeRFC3339:
+		want = tm.Truncate(time.Second)
+	case cbor.TimeUnixMicro, cbor.TimeUnixDynamic:
+		want = tm.UTC().Round(time.Microsecond)
+	default:
+		want = tm
+	}
+	diff := back.Sub(want)
+	if diff < 0 {
+		diff = -diff
+	}
+	if diff > tol || back.Year() != want.Year() {
+		fail(ht, "%v encoded with mode %d as %x decoded to %v: %v from %v (tolerance %v)", tm, mode, data, back, diff, want, tol)
+	}
+	if mode == cbor.TimeRFC3339 || mode == cbor.TimeRFC3339Nano {
+		_, wo := want.Zone()
+		_, bo := back.Zone()
+		if wo != bo {
+			fail(ht, "%v mode %d decoded with offset %d, want %d", tm, mode, bo, wo)
+		}
+	}
+}
+
+// Diagnostic notation is compositional: a container's notation is its
+// items' notations joined by ", " inside the brackets RFC 8949 §8 gives,
+// with the "_ " markers for indefinite-length items; leaves render as exact
+// decimals, JSON strings, h'…' and simple(n); the float precision indicator
+// and CBOR-sequence options work as documented.
+func TestHegelDiagnosticNotationIsCompositional(t *testing.T) {
+	dmSeq, err := cbor.DiagOptions{CBORSequence: true}.DiagMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	dmPrec, err := cbor.DiagOptions{FloatPrecisionIndicator: true}.DiagMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	property(t, func(ht *hegel.T) {
+		v := genVal(ht, genOpts{undefined: true, tags: true, maxDepth: 3, maxItems: 4}, 0)
+		canon := encode(v, styleCoreDet)
+		l := &loose{tc: ht}
+		data := l.encode(nil, v, 0)
+		note(ht, "value %s\ncanonical %x\nloose %x", v, canon, data)
+		want, err := diagModel(v, canon, false)
+		if err != nil {
+			fail(ht, "%v", err)
+		}
+		got, err := cbor.Diagnose(canon)
+		if err != nil {
+			fail(ht, "Diagnose(%x): %v", canon, err)
+		}
+		if got != want {
+			fail(ht, "Diagnose(%x) of %s\n got  %s\n want %s", canon, v, got, want)
+		}
+		// The loose encoding: the same text, with the indefinite markers.
+		wantLoose, err := diagModel(v, data, false)
+		if err != nil {
+			fail(ht, "%v", err)
+		}
+		gotLoose, err := cbor.Diagnose(data)
+		if err != nil {
+			fail(ht, "Diagnose(%x): %v", data, err)
+		}
+		if gotLoose != wantLoose {
+			fail(ht, "Diagnose(%x) (loose) of %s\n got  %s\n want %s", data, v, gotLoose, wantLoose)
+		}
+		// Precision indicators: the float widths as written.
+		wantPrec, err := diagModel(v, data, true)
+		if err != nil {
+			fail(ht, "%v", err)
+		}
+		gotPrec, err := dmPrec.Diagnose(data)
+		if err != nil {
+			fail(ht, "Diagnose(%x) with precision indicators: %v", data, err)
+		}
+		if gotPrec != wantPrec {
+			fail(ht, "Diagnose(%x) with precision indicators of %s\n got  %s\n want %s", data, v, gotPrec, wantPrec)
+		}
+		// A sequence of 1–3 items.
+		k := n(ht, 1, 3)
+		var seq []byte
+		var parts []string
+		for i := 0; i < k; i++ {
+			e := canon
+			if i > 0 {
+				e = encode(genVal(ht, genOpts{maxDepth: 1, maxItems: 2}, 0), styleCoreDet)
+			}
+			seq = append(seq, e...)
+			s, err := cbor.Diagnose(e)
+			if err != nil {
+				fail(ht, "Diagnose(%x): %v", e, err)
+			}
+			parts = append(parts, s)
+		}
+		gotSeq, err := dmSeq.Diagnose(seq)
+		if err != nil {
+			fail(ht, "Diagnose(%x) as a sequence: %v", seq, err)
+		}
+		if gotSeq != strings.Join(parts, ", ") {
+			fail(ht, "Diagnose(%x) as a sequence = %q, want %q", seq, gotSeq, strings.Join(parts, ", "))
+		}
+		if k > 1 {
+			var ext *cbor.ExtraneousDataError
+			if _, err := cbor.Diagnose(seq); !errors.As(err, &ext) {
+				fail(ht, "Diagnose(%x) without CBORSequence: %v, want ExtraneousDataError", seq, err)
+			}
+		}
+	})
+}
+
+// diagModel renders the model's diagnostic notation for the encoding data of
+// v: the leaf forms are checked here (decimal integers, a JSON string that
+// parses back, h'hex', simple(n), a float that parses back to the value, the
+// literals), the structure follows the encoding (definite or indefinite).
+func diagModel(v *val, data []byte, prec bool) (string, error) {
+	var sb strings.Builder
+	p := &wfParser{data: data}
+	if err := diagItem(&sb, v, p, prec); err != nil {
+		return "", err
+	}
+	if p.off != len(data) {
+		return "", fmt.Errorf("diagModel: %d of %d bytes used for %s", p.off, len(data), v)
+	}
+	return sb.String(), nil
+}
+
+func diagItem(sb *strings.Builder, v *val, p *wfParser, prec bool) error {
+	start := p.off
+	ai := p.data[p.off] & 31
+	// Consume the head.
+	p.off++
+	var arg uint64
+	switch {
+	case ai < 24:
+		arg = uint64(ai)
+	case ai <= 27:
+		k := 1 << (ai - 24)
+		for _, b := range p.data[p.off : p.off+k] {
+			arg = arg<<8 | uint64(b)
+		}
+		p.off += k
+	}
+	indef := ai == 31
+	switch v.kind {
+	case kUint, kNeg:
+		sb.WriteString(v.String())
+	case kBytes, kText:
+		if indef {
+			if len(p.data) > p.off && p.data[p.off] == 0xff {
+				p.off++
+				if v.kind == kBytes {
+					sb.WriteString("''_")
+				} else {
+					sb.WriteString(`""_`)
+				}
+				return nil
+			}
+			sb.WriteString("(_ ")
+			first := true
+			for p.data[p.off] != 0xff {
+				if !first {
+					sb.WriteString(", ")
+				}
+				first = false
+				cb := p.data[p.off]
+				var clen uint64
+				cai := cb & 31
+				p.off++
+				switch {
+				case cai < 24:
+					clen = uint64(cai)
+				default:
+					k := 1 << (cai - 24)
+					for _, b := range p.data[p.off : p.off+k] {
+						clen = clen<<8 | uint64(b)
+					}
+					p.off += k
+				}
+				chunk := p.data[p.off : p.off+int(clen)]
+				p.off += int(clen)
+				if v.kind == kBytes {
+					fmt.Fprintf(sb, "h'%x'", chunk)
+				} else {
+					sb.WriteString(jsonString(string(chunk)))
+				}
+			}
+			p.off++ // break
+			sb.WriteString(")")
+			return nil
+		}
+		p.off += int(arg)
+		if v.kind == kBytes {
+			fmt.Fprintf(sb, "h'%x'", v.b)
+		} else {
+			sb.WriteString(jsonString(string(v.b)))
+		}
+	case kArray:
+		if indef {
+			sb.WriteString("[_ ")
+		} else {
+			sb.WriteString("[")
+		}
+		for i, e := range v.a {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			if err := diagItem(sb, e, p, prec); err != nil {
+				return err
+			}
+		}
+		if indef {
+			p.off++
+		}
+		sb.WriteString("]")
+	case kMap:
+		if indef {
+			sb.WriteString("{_ ")
+		} else {
+			sb.WriteString("{")
+		}
+		// The pairs in encoded order: match each encoded key to the model.
+		count := len(v.m)
+		for i := 0; i < count; i++ {
+			if i > 0 {
+				sb.WriteString(", ")
+			}
+			// Find the model pair whose key is encoded here.
+			var pair *kv
+			for j := range v.m {
+				q := &wfParser{data: p.data, off: p.off}
+				if err := q.item(false); err != nil {
+					return err
+				}
+				keyBytes := p.data[p.off:q.off]
+				kd, err := decodeAny(liberalDec, keyBytes)
+				if err != nil {
+					return fmt.Errorf("diagModel: key %x: %v", keyBytes, err)
+				}
+				if same(fromGo(kd), normUndef(v.m[j].k)) {
+					pair = &v.m[j]
+					break
+				}
+			}
+			if pair == nil {
+				return fmt.Errorf("diagModel: no model key for the pair at %d in %x", p.off, p.data)
+			}
+			if err := diagItem(sb, pair.k, p, prec); err != nil {
+				return err
+			}
+			sb.WriteString(": ")
+			if err := diagItem(sb, pair.v, p, prec); err != nil {
+				return err
+			}
+		}
+		if indef {
+			p.off++
+		}
+		sb.WriteString("}")
+	case kTag:
+		if (v.u == 2 || v.u == 3) && v.a[0].kind == kBytes {
+			// RFC 8949 Appendix A writes a bignum as its integer value.
+			q := &wfParser{data: p.data, off: p.off}
+			if err := q.item(false); err != nil {
+				return err
+			}
+			p.off = q.off
+			x := new(big.Int).SetBytes(v.a[0].b)
+			if v.u == 3 {
+				x.Neg(x)
+				x.Sub(x, big.NewInt(1))
+			}
+			sb.WriteString(x.String())
+			return nil
+		}
+		fmt.Fprintf(sb, "%d(", v.u)
+		if err := diagItem(sb, v.a[0], p, prec); err != nil {
+			return err
+		}
+		sb.WriteString(")")
+	case kSimple:
+		fmt.Fprintf(sb, "simple(%d)", v.u)
+	case kBool:
+		fmt.Fprintf(sb, "%v", v.bo)
+	case kNull:
+		sb.WriteString("null")
+	case kUndef:
+		sb.WriteString("undefined")
+	case kFloat:
+		// Whatever the text, it must parse back to the value; NaN/Infinity
+		// are the RFC's spellings. The library's text is used verbatim once
+		// checked, so that the composition is what this property tests.
+		leaf := p.data[start:p.off]
+		s, err := cbor.Diagnose(leaf)
+		if err != nil {
+			return fmt.Errorf("Diagnose(%x): %v", leaf, err)
+		}
+		switch {
+		case math.IsNaN(v.f):
+			if s != "NaN" {
+				return fmt.Errorf("Diagnose(%x) = %q for NaN", leaf, s)
+			}
+		case math.IsInf(v.f, 1):
+			if s != "Infinity" {
+				return fmt.Errorf("Diagnose(%x) = %q for +Inf", leaf, s)
+			}
+		case math.IsInf(v.f, -1):
+			if s != "-Infinity" {
+				return fmt.Errorf("Diagnose(%x) = %q for -Inf", leaf, s)
+			}
+		default:
+			f, perr := strconv.ParseFloat(s, 64)
+			if perr != nil || f != v.f || math.Signbit(f) != math.Signbit(v.f) {
+				return fmt.Errorf("Diagnose(%x) = %q, parses to %v (%v), want %v", leaf, s, f, perr, v.f)
+			}
+			if !strings.ContainsAny(s, ".e") {
+				return fmt.Errorf("Diagnose(%x) = %q: a float must show a decimal point or exponent", leaf, s)
+			}
+		}
+		sb.WriteString(s)
+		if prec && !math.IsNaN(v.f) && !math.IsInf(v.f, 0) {
+			// The library writes no indicator after NaN and Infinity.
+			sb.WriteString(pick2(ai))
+		}
+	}
+	return nil
+}
+
+func pick2(ai byte) string {
+	switch ai {
+	case 25:
+		return "_1"
+	case 26:
+		return "_2"
+	}
+	return "_3"
+}
+
+// jsonString is the diagnostic notation of a text string: a JSON string.
+// The library escapes every non-ASCII rune as \uXXXX (UTF-16), control
+// characters as \uXXXX except \t \n \r, and " and \; the model renders the
+// same and, as the real check, requires the result to parse back.
+func jsonString(s string) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '"' || r == '\\':
+			sb.WriteByte('\\')
+			sb.WriteRune(r)
+		case r == '\t':
+			sb.WriteString(`\t`)
+		case r == '\n':
+			sb.WriteString(`\n`)
+		case r == '\r':
+			sb.WriteString(`\r`)
+		case r >= ' ' && r <= '~':
+			sb.WriteRune(r)
+		case r < 0x10000:
+			fmt.Fprintf(&sb, `\u%04x`, r)
+		default:
+			r -= 0x10000
+			fmt.Fprintf(&sb, `\u%04x\u%04x`, 0xd800+(r>>10), 0xdc00+(r&0x3ff))
+		}
+	}
+	sb.WriteByte('"')
+	out := sb.String()
+	var back string
+	if err := json.Unmarshal([]byte(out), &back); err != nil || back != s {
+		panic(fmt.Sprintf("jsonString(%q) = %s does not parse back: %v", s, out, err))
+	}
+	return out
+}
+
+// The streaming Encoder's indefinite-length state machine is exact: Start*
+// is refused inside a string, Encode inside a string accepts exactly a
+// definite-length string of the same major type, EndIndefinite is refused
+// with nothing open or with an odd number of items in a map, and a
+// completed sequence of operations is well-formed and decodes to the value
+// the operations describe; with IndefLengthForbidden every Start fails.
+func TestHegelEncoderStateMachineIsExact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		forbid := chance(ht, 15)
+		o := cbor.EncOptions{}
+		if forbid {
+			o.IndefLength = cbor.IndefLengthForbidden
+		}
+		em := mustEncMode(o)
+		var buf bytes.Buffer
+		enc := em.NewEncoder(&buf)
+		var stack []*frame
+		var top []*val // the completed top-level items
+		var trace []string
+		steps := n(ht, 1, 12)
+		for i := 0; i < steps; i++ {
+			op := n(ht, 0, 6)
+			atKey := len(stack) > 0 && stack[len(stack)-1].typ == 5 && stack[len(stack)-1].count%2 == 0
+			if atKey && op <= 1 {
+				op = 2 // a container as a map key cannot be checked through map[any]any
+			}
+			switch op {
+			case 0, 1: // start
+				typ := byte(pick(ht, 2, 3, 4, 5))
+				var err error
+				switch typ {
+				case 2:
+					err = enc.StartIndefiniteByteString()
+				case 3:
+					err = enc.StartIndefiniteTextString()
+				case 4:
+					err = enc.StartIndefiniteArray()
+				default:
+					err = enc.StartIndefiniteMap()
+				}
+				trace = append(trace, fmt.Sprintf("start %d -> %v", typ, err))
+				inString := len(stack) > 0 && stack[len(stack)-1].typ <= 3
+				wantErr := forbid || inString
+				if (err != nil) != wantErr {
+					fail(ht, "Start type %d (forbid %v, in string %v): %v\n%s", typ, forbid, inString, err, strings.Join(trace, "\n"))
+				}
+				if err == nil {
+					stack = append(stack, &frame{typ: typ})
+				}
+			case 2, 3, 4: // encode
+				var x any
+				var item *val
+				var kind string
+				if len(stack) > 0 && stack[len(stack)-1].typ <= 3 && chance(ht, 70) {
+					// A matching chunk mostly.
+					if stack[len(stack)-1].typ == 2 {
+						b := genBytes(ht, 4)
+						x, item, kind = b, vBytes(b), "bytes"
+					} else {
+						s := string(genText(ht, 4))
+						x, item, kind = s, vText(s), "text"
+					}
+				} else if atKey {
+					item = genKey(ht, genOpts{}, 0)
+					x, kind = toGo(item), "value"
+					switch item.kind {
+					case kBytes:
+						x, kind = []byte(item.b), "bytes"
+					case kText:
+						kind = "text"
+					case kNull:
+						kind = "nil"
+					}
+				} else {
+					switch n(ht, 0, 3) {
+					case 0:
+						b := genBytes(ht, 4)
+						x, item, kind = b, vBytes(b), "bytes"
+					case 1:
+						s := string(genText(ht, 4))
+						x, item, kind = s, vText(s), "text"
+					case 2:
+						x, item, kind = nil, vNull(), "nil"
+					default:
+						item = genVal(ht, genOpts{tags: true, maxDepth: 2, maxItems: 3}, 0)
+						x, kind = toGo(item), "value"
+						switch item.kind {
+						case kBytes:
+							kind = "bytes"
+						case kText:
+							kind = "text"
+						case kNull:
+							kind = "nil"
+						}
+					}
+				}
+				err := enc.Encode(x)
+				trace = append(trace, fmt.Sprintf("encode %s %s -> %v", kind, item, err))
+				wantErr := false
+				if len(stack) > 0 {
+					switch stack[len(stack)-1].typ {
+					case 2:
+						wantErr = kind != "bytes"
+					case 3:
+						wantErr = kind != "text"
+					}
+				}
+				if (err != nil) != wantErr {
+					fail(ht, "Encode(%s %s) with %v open: %v\n%s", kind, item, stackTypes(stack), err, strings.Join(trace, "\n"))
+				}
+				if err != nil {
+					continue
+				}
+				if len(stack) == 0 {
+					top = append(top, item)
+				} else {
+					f := stack[len(stack)-1]
+					f.count++
+					if f.typ <= 3 {
+						f.chunk = append(f.chunk, item.b...)
+					} else {
+						f.items = append(f.items, item)
+					}
+				}
+			default: // end
+				err := enc.EndIndefinite()
+				trace = append(trace, fmt.Sprintf("end -> %v", err))
+				wantErr := len(stack) == 0 || (stack[len(stack)-1].typ == 5 && stack[len(stack)-1].count%2 == 1)
+				if (err != nil) != wantErr {
+					fail(ht, "EndIndefinite with %v open (top count %d): %v\n%s", stackTypes(stack), topCount(stack), err, strings.Join(trace, "\n"))
+				}
+				if err != nil {
+					var odd *cbor.IndefiniteLengthMapOddItemCountError
+					if len(stack) > 0 && !errors.As(err, &odd) {
+						fail(ht, "EndIndefinite on an odd map: %v, want IndefiniteLengthMapOddItemCountError", err)
+					}
+					continue
+				}
+				closeFrame(&stack, &top)
+			}
+		}
+		// Close everything that is open, completing odd maps.
+		for len(stack) > 0 {
+			f := stack[len(stack)-1]
+			if f.typ == 5 && f.count%2 == 1 {
+				if err := enc.Encode(uint64(7)); err != nil {
+					fail(ht, "Encode(7) to complete a map: %v", err)
+				}
+				f.count++
+				f.items = append(f.items, vUint(7))
+			}
+			if err := enc.EndIndefinite(); err != nil {
+				fail(ht, "EndIndefinite closing %v: %v\n%s", stackTypes(stack), err, strings.Join(trace, "\n"))
+			}
+			closeFrame(&stack, &top)
+		}
+		out := buf.Bytes()
+		note(ht, "operations:\n%s\noutput %x", strings.Join(trace, "\n"), out)
+		// The output is the sequence of the top-level items.
+		rest := out
+		for i, want := range top {
+			var x any
+			var err error
+			rest, err = liberalDec.UnmarshalFirst(rest, &x)
+			if err != nil {
+				fail(ht, "item %d of the Encoder's output %x: %v\n%s", i, out, err, strings.Join(trace, "\n"))
+			}
+			if back := fromGo(x); !same(back, normUndef(want)) {
+				fail(ht, "item %d of the Encoder's output decoded to %s, want %s\n%s", i, back, want, strings.Join(trace, "\n"))
+			}
+		}
+		if len(rest) != 0 {
+			fail(ht, "the Encoder's output %x has %x after the %d items\n%s", out, rest, len(top), strings.Join(trace, "\n"))
+		}
+	})
+}
+
+// frame is an open indefinite-length item of the model Encoder.
+type frame struct {
+	typ   byte // 2 bytes, 3 text, 4 array, 5 map
+	count int
+	items []*val
+	chunk []byte
+}
+
+func stackTypes(stack []*frame) []byte {
+	var out []byte
+	for _, f := range stack {
+		out = append(out, f.typ)
+	}
+	return out
+}
+
+func topCount(stack []*frame) int {
+	if len(stack) == 0 {
+		return -1
+	}
+	return stack[len(stack)-1].count
+}
+
+func closeFrame(stack *[]*frame, top *[]*val) {
+	f := (*stack)[len(*stack)-1]
+	*stack = (*stack)[:len(*stack)-1]
+	var item *val
+	switch f.typ {
+	case 2:
+		item = vBytes(f.chunk)
+	case 3:
+		item = vText(string(f.chunk))
+	case 4:
+		item = vArray(f.items...)
+	default:
+		// The Encoder writes every pair it is given; the output is read back with the default
+		// DupMapKeyQuiet, which keeps the last value of a repeated key.
+		var m []kv
+		at := map[string]int{}
+		for i := 0; i+1 < len(f.items); i += 2 {
+			k := string(encode(f.items[i], styleCoreDet))
+			if j, dup := at[k]; dup {
+				m[j] = kv{f.items[i], f.items[i+1]}
+				continue
+			}
+			at[k] = len(m)
+			m = append(m, kv{f.items[i], f.items[i+1]})
+		}
+		item = vMap(m...)
+	}
+	if len(*stack) == 0 {
+		*top = append(*top, item)
+	} else {
+		p := (*stack)[len(*stack)-1]
+		p.count++
+		p.items = append(p.items, item)
+	}
+}
+
+// What a Marshaler returns is checked: Marshal fails unless MarshalCBOR
+// (and RawMessage, and a RawTag's content) yields exactly one well-formed
+// data item allowed by the mode's IndefLength and TagsMd options, and the
+// bytes are embedded verbatim; an Unmarshaler receives exactly the bytes of
+// its data item, and RawMessage keeps them.
+type rawly struct{ b []byte }
+
+func (r rawly) MarshalCBOR() ([]byte, error) { return r.b, nil }
+
+type catcher struct{ got []byte }
+
+func (c *catcher) UnmarshalCBOR(data []byte) error {
+	c.got = append([]byte{}, data...)
+	return nil
+}
+
+func TestHegelMarshalerOutputIsValidated(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var b []byte
+		var v *val
+		l := &loose{tc: ht}
+		switch n(ht, 0, 3) {
+		case 0:
+			b = genBytes(ht, 6)
+		case 1:
+			v = genVal(ht, genOpts{undefined: true, tags: true, maxDepth: 3, maxItems: 3}, 0)
+			b = l.encode(nil, v, 0)
+			if len(b) > 0 && chance(ht, 50) {
+				i := n(ht, 0, len(b)-1)
+				switch n(ht, 0, 2) {
+				case 0:
+					b = b[:i]
+				case 1:
+					b = append(b, byte(n(ht, 0, 255)))
+				default:
+					b[i] ^= 1 << n(ht, 0, 7)
+				}
+			}
+		default:
+			v = genVal(ht, genOpts{undefined: true, tags: true, maxDepth: 3, maxItems: 3}, 0)
+			b = l.encode(nil, v, 0)
+		}
+		o := cbor.EncOptions{
+			IndefLength: pick(ht, cbor.IndefLengthAllowed, cbor.IndefLengthForbidden),
+			TagsMd:      pick(ht, cbor.TagsAllowed, cbor.TagsForbidden),
+		}
+		em := mustEncMode(o)
+		k, merr := wellformed(b)
+		ok := merr == nil && k == len(b)
+		// The mode's own checks on the item.
+		hasIndef, hasTag := false, false
+		if ok {
+			for i := 0; i < len(b); {
+				// A cheap scan: every head in the item (strings skipped).
+				mt, ai := b[i]>>5, b[i]&31
+				if ai == 31 && mt != 7 {
+					hasIndef = true
+				}
+				if mt == 6 {
+					hasTag = true
+				}
+				q := &wfParser{data: b, off: i}
+				if mt == 2 || mt == 3 {
+					if ai == 31 {
+						i++
+						continue
+					}
+					_ = q.item(false)
+					i = q.off
+					continue
+				}
+				switch {
+				case ai < 24:
+					i++
+				case ai <= 27:
+					i += 1 + 1<<(ai-24)
+				default:
+					i++
+				}
+			}
+		}
+		wantOK := ok && !(hasIndef && o.IndefLength == cbor.IndefLengthForbidden) && !(hasTag && o.TagsMd == cbor.TagsForbidden)
+		note(ht, "bytes %x (well-formed %v, indef %v, tag %v) options %+v", b, ok, hasIndef, hasTag, o)
+		for _, c := range []struct {
+			name string
+			x    any
+		}{{"Marshaler", rawly{b}}, {"RawMessage", cbor.RawMessage(b)}, {"in an array", []any{rawly{b}, uint64(1)}}, {"as a map value", map[string]any{"k": cbor.RawMessage(b)}}} {
+			if (c.name == "RawMessage" || c.name == "as a map value") && len(b) == 0 {
+				continue // an empty RawMessage encodes as null by design
+			}
+			got, err := em.Marshal(c.x)
+			if !wantOK {
+				if err == nil {
+					fail(ht, "%s: Marshal accepted %x (well-formed %v, indef %v, tag %v) with %+v: %x", c.name, b, ok, hasIndef, hasTag, o, got)
+				}
+				continue
+			}
+			if err != nil {
+				fail(ht, "%s: Marshal of the well-formed %x with %+v: %v", c.name, b, o, err)
+			}
+			var exp []byte
+			switch c.name {
+			case "in an array":
+				exp = append(append([]byte{0x82}, b...), 0x01)
+			case "as a map value":
+				exp = append([]byte{0xa1, 0x61, 'k'}, b...)
+			default:
+				exp = b
+			}
+			if !bytes.Equal(got, exp) {
+				fail(ht, "%s: Marshal = %x, want %x", c.name, got, exp)
+			}
+		}
+		// RawTag: the content is validated the same way.
+		if len(b) > 0 {
+			num := uint64(n(ht, 0, 100000))
+			if chance(ht, 30) {
+				num = uint64(n(ht, 0, 3))
+			}
+			got, err := em.Marshal(cbor.RawTag{Number: num, Content: b})
+			wantTagOK := wantOK && o.TagsMd == cbor.TagsAllowed
+			// Tags 0–3 must enclose a text string, a number, a byte string.
+			if wantTagOK && num <= 3 {
+				mt, ai := b[0]>>5, b[0]&31
+				switch num {
+				case 0:
+					wantTagOK = mt == 3
+				case 1:
+					wantTagOK = mt == 0 || mt == 1 || (mt == 7 && ai >= 25 && ai <= 27)
+				default:
+					wantTagOK = mt == 2
+				}
+			}
+			if wantTagOK && (err != nil || !bytes.Equal(got, append(appendHead(nil, 6, num), b...))) {
+				fail(ht, "RawTag{%d, %x}: %x, %v; want %x", num, b, got, err, append(appendHead(nil, 6, num), b...))
+			}
+			if !wantTagOK && err == nil {
+				fail(ht, "RawTag{%d, %x} with %+v accepted: %x", num, b, o, got)
+			}
+		}
+		// Decoding: the Unmarshaler and RawMessage get exactly the item
+		// (null and undefined set a pointer field to nil instead, as in
+		// encoding/json).
+		if ok && b[0] != 0xf6 && b[0] != 0xf7 {
+			arr := append(append([]byte{0x82}, b...), 0x01)
+			var c catcher
+			var target struct {
+				_ struct{} `cbor:",toarray"`
+				C *catcher
+				N int
+			}
+			target.C = &c
+			if err := liberalDec.Unmarshal(arr, &target); err != nil {
+				fail(ht, "Unmarshal(%x) into the Unmarshaler: %v", arr, err)
+			}
+			if !bytes.Equal(c.got, b) || target.N != 1 {
+				fail(ht, "the Unmarshaler got %x (N %d), want %x", c.got, target.N, b)
+			}
+			var raw struct {
+				_ struct{} `cbor:",toarray"`
+				R cbor.RawMessage
+				N int
+			}
+			if err := liberalDec.Unmarshal(arr, &raw); err != nil {
+				fail(ht, "Unmarshal(%x) into RawMessage: %v", arr, err)
+			}
+			if !bytes.Equal(raw.R, b) {
+				fail(ht, "RawMessage got %x, want %x", raw.R, b)
+			}
+			var rm cbor.RawMessage
+			if err := liberalDec.Unmarshal(b, &rm); err != nil || !bytes.Equal(rm, b) {
+				fail(ht, "Unmarshal(%x) into a bare RawMessage = %x, %v", b, rm, err)
+			}
+			// A tag around it decodes into RawTag with the content bytes.
+			tagged := append([]byte{0xd8, 0x64}, b...)
+			var rt cbor.RawTag
+			if err := liberalDec.Unmarshal(tagged, &rt); err != nil || rt.Number != 100 || !bytes.Equal(rt.Content, b) {
+				fail(ht, "Unmarshal(%x) into RawTag = {%d %x}, %v", tagged, rt.Number, rt.Content, err)
+			}
+		}
+	})
+}
+
+// Python's cbor2 agrees: it decodes the Go encoder's output to a value whose
+// canonical encoding (RFC 7049 length-first, shortest floats) is the Go
+// Canonical encoding, and its own default encoding of that value decodes in
+// Go to the same value.
+func TestHegelCbor2AgreesOnCanonicalEncodings(t *testing.T) {
+	py := cbor2Python(t)
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 6)
+		items := make([]*val, k)
+		var lines []string
+		for i := range items {
+			// cbor2 turns tags 0/1 into datetimes and has no undefined map
+			// key; simple values and other tags round-trip.
+			items[i] = cbor2SafeTags(genVal(ht, genAny, 0))
+			b, err := encCanonical.Marshal(toGo(items[i]))
+			if err != nil {
+				fail(ht, "Canonical Marshal(%s): %v", items[i], err)
+			}
+			lines = append(lines, hex.EncodeToString(b))
+		}
+		note(ht, "%d items %v", k, items)
+		out, err := runPython(py, strings.Join(lines, "\n"))
+		if err != nil {
+			fail(ht, "cbor2 on %v: %v\n%s", lines, err, out)
+		}
+		outLines := strings.Split(strings.TrimSpace(out), "\n")
+		if len(outLines) != k {
+			fail(ht, "cbor2 printed %d lines for %d items:\n%s", len(outLines), k, out)
+		}
+		for i, line := range outLines {
+			fields := strings.Fields(line)
+			if len(fields) != 2 {
+				fail(ht, "cbor2 line %d: %q", i, line)
+			}
+			canon, _ := hex.DecodeString(fields[0])
+			plain, _ := hex.DecodeString(fields[1])
+			if fields[0] != lines[i] {
+				fail(ht, "item %s: Go canonical %s, cbor2 canonical %s (from cbor2's decoding of the Go bytes)", items[i], lines[i], fields[0])
+			}
+			_ = canon
+			d, err := decodeAny(liberalDec, plain)
+			if err != nil {
+				fail(ht, "Unmarshal(%x) of cbor2's encoding of %s: %v", plain, items[i], err)
+			}
+			if back := fromGo(d); !same(back, items[i]) {
+				fail(ht, "cbor2's encoding %x of %s decoded to %s", plain, items[i], back)
+			}
+		}
+	})
+}
+
+// cbor2SafeTags drops boolean map keys and renumbers the tags cbor2 interprets itself (dates, decimal
+// fractions and bigfloats, string and shared references, URIs and the other
+// RFC 8949 §3.4.5 hints, sets, IP addresses, 55799) so that both sides see
+// plain tags; bignums (tags 2/3 with a magnitude beyond 64 bits) stay, both
+// decode them to integers.
+func cbor2SafeTags(v *val) *val {
+	switch v.kind {
+	case kArray:
+		a := make([]*val, len(v.a))
+		for i, e := range v.a {
+			a[i] = cbor2SafeTags(e)
+		}
+		return vArray(a...)
+	case kMap:
+		// Python's dict cannot hold both 0 and False (or 1 and True): the
+		// two are equal and hash alike, so a map {0: 0, false: true} would
+		// come back with one pair. Boolean keys are dropped for cbor2.
+		var m []kv
+		for _, e := range v.m {
+			if e.k.kind == kBool {
+				continue
+			}
+			m = append(m, kv{cbor2SafeTags(e.k), cbor2SafeTags(e.v)})
+		}
+		return vMap(m...)
+	case kTag:
+		if (v.u == 2 || v.u == 3) && v.a[0].kind == kBytes && len(v.a[0].b) >= 9 {
+			return v
+		}
+		num := v.u
+		switch num {
+		case 0, 1, 2, 3, 4, 5, 25, 28, 29, 30, 32, 33, 34, 35, 36, 37, 100, 256, 258, 260, 261, 1004, 55799:
+			num += 70000
+		}
+		return vTag(num, cbor2SafeTags(v.a[0]))
+	}
+	return v
+}
+
+const cbor2Script = `
+import sys, cbor2, math
+for line in sys.stdin.read().split():
+    v = cbor2.loads(bytes.fromhex(line))
+    print(cbor2.dumps(v, canonical=True).hex(), cbor2.dumps(v).hex())
+`
+
+// cbor2Python finds a Python with cbor2: HEGEL_CBOR2_PYTHON, .hegel/venv or
+// python3; the test is skipped without one.
+func cbor2Python(t *testing.T) string {
+	t.Helper()
+	var candidates []string
+	if p := os.Getenv("HEGEL_CBOR2_PYTHON"); p != "" {
+		candidates = append(candidates, p)
+	}
+	candidates = append(candidates, ".hegel/venv/bin/python", "python3")
+	for _, c := range candidates {
+		if out, err := exec.Command(c, "-c", "import cbor2").CombinedOutput(); err == nil {
+			return c
+		} else if c == candidates[len(candidates)-1] {
+			t.Skipf("no Python with cbor2 (tried %v; last: %v %s)", candidates, err, out)
+		}
+	}
+	return ""
+}
+
+func runPython(py, input string) (string, error) {
+	cmd := exec.Command(py, "-c", cbor2Script)
+	cmd.Stdin = strings.NewReader(input)
+	out, err := cmd.CombinedOutput()
+	return string(out), err
+}
