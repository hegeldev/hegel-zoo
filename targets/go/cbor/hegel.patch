@@ -0,0 +1,75 @@
+package cbor_test
+
+// One plain test per recorded bug (see bugs.toml). Each asserts the correct
+// behaviour, so it fails while the bug is open; target.toml lists them as
+// expected failures.
+
+import (
+	"testing"
+	"time"
+
+	"github.com/fxamacker/cbor/v2"
+)
+
+// cbor/1: TimeUnixMicro must encode any time.Time as float seconds since the
+// epoch; for times outside the range of int64 nanoseconds (1678–2262) the
+// value is garbage.
+func TestHegelPinUnixMicroTimeFarFromEpochRoundTrips(t *testing.T) {
+	em, err := cbor.EncOptions{Time: cbor.TimeUnixMicro, TimeTag: cbor.EncTagRequired}.EncMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tm := range []time.Time{
+		time.Date(1000, 1, 1, 0, 0, 0, 0, time.UTC),
+		time.Date(1677, 12, 31, 0, 0, 0, 0, time.UTC),
+		time.Date(2262, 4, 12, 0, 0, 0, 0, time.UTC),
+		time.Date(9999, 12, 31, 23, 59, 59, 0, time.UTC),
+	} {
+		b, err := em.Marshal(tm)
+		if err != nil {
+			t.Fatalf("Marshal(%v): %v", tm, err)
+		}
+		var back time.Time
+		if err := cbor.Unmarshal(b, &back); err != nil {
+			t.Fatalf("Unmarshal(%x): %v", b, err)
+		}
+		diff := back.Sub(tm)
+		if diff < 0 {
+			diff = -diff
+		}
+		if diff > time.Millisecond {
+			t.Errorf("%v encoded with TimeUnixMicro as %x decodes to %v (off by %v)", tm, b, back, diff)
+		}
+	}
+}
+
+// cbor/2: MaxNestedLevels counts "any combination of CBOR array, maps, and
+// tags"; a tag whose parent is not a tag is not counted.
+func TestHegelPinNestedTagsCountTowardMaxNestedLevels(t *testing.T) {
+	dm, err := cbor.DecOptions{MaxNestedLevels: 4}.DecMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, c := range []struct {
+		name   string
+		data   []byte
+		levels int
+	}{
+		{"37([[[[0]]]])", []byte{0xd8, 0x25, 0x81, 0x81, 0x81, 0x81, 0x00}, 5},
+		{"37(37(37(37(37(0)))))", []byte{0xd8, 0x25, 0xd8, 0x25, 0xd8, 0x25, 0xd8, 0x25, 0xd8, 0x25, 0x00}, 5},
+		{"[37([37([37([37(0)])])])]", []byte{0x81, 0xd8, 0x25, 0x81, 0xd8, 0x25, 0x81, 0xd8, 0x25, 0x81, 0xd8, 0x25, 0x00}, 8},
+	} {
+		var v any
+		if err := dm.Wellformed(c.data); err == nil {
+			t.Errorf("Wellformed accepted %s (%d levels) with MaxNestedLevels 4", c.name, c.levels)
+		}
+		if err := dm.Unmarshal(c.data, &v); err == nil {
+			t.Errorf("Unmarshal accepted %s (%d levels) with MaxNestedLevels 4: %v", c.name, c.levels, v)
+		}
+	}
+	// Four levels are fine.
+	var v any
+	if err := dm.Unmarshal([]byte{0xd8, 0x25, 0x81, 0x81, 0x81, 0x00}, &v); err != nil {
+		t.Errorf("Unmarshal rejected 37([[[0]]]) (4 levels) with MaxNestedLevels 4: %v", err)
+	}
+}
