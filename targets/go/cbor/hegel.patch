+// normUndef replaces undefined by null throughout (what decoding into any does).
+func normUndef(v *val) *val {
+	switch v.kind {
+	case kUndef:
+		return vNull()
+	case kArray:
+		a := make([]*val, len(v.a))
+		for i, e := range v.a {
+			a[i] = normUndef(e)
+		}
+		return vArray(a...)
+	case kMap:
+		m := make([]kv, len(v.m))
+		for i, e := range v.m {
+			m[i] = kv{normUndef(e.k), normUndef(e.v)}
+		}
+		return vMap(m...)
+	case kTag:
+		return vTag(v.u, normUndef(v.a[0]))
+	}
+	return v
+}
+
+// Every combination of encoding options produces a well-formed encoding of
+// the same value (modulo the documented conversions), sorted as the Sort mode
+// says, and the forbidding modes reject exactly what they forbid.
+func TestHegelEncodingOptionsPreserveTheValue(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genVal(ht, genAny, 0)
+		o := cbor.EncOptions{
+			Sort:          pick(ht, cbor.SortNone, cbor.SortLengthFirst, cbor.SortBytewiseLexical, cbor.SortFastShuffle),
+			ShortestFloat: pick(ht, cbor.ShortestFloatNone, cbor.ShortestFloat16),
+			NaNConvert:    pick(ht, cbor.NaNConvert7e00, cbor.NaNConvertNone, cbor.NaNConvertPreserveSignal, cbor.NaNConvertQuiet, cbor.NaNConvertReject),
+			InfConvert:    pick(ht, cbor.InfConvertFloat16, cbor.InfConvertNone, cbor.InfConvertReject),
+			BigIntConvert: pick(ht, cbor.BigIntConvertShortest, cbor.BigIntConvertNone, cbor.BigIntConvertReject),
+			IndefLength:   pick(ht, cbor.IndefLengthAllowed, cbor.IndefLengthForbidden),
+			TagsMd:        pick(ht, cbor.TagsAllowed, cbor.TagsForbidden),
+			String:        pick(ht, cbor.StringToTextString, cbor.StringToByteString),
+		}
+		if o.String == cbor.StringToByteString {
+			// A text key and a byte-string key of the same content would
+			// collide into a map with a duplicate key.
+			v = dropBytesKeys(v)
+		}
+		note(ht, "value %s\noptions %+v", v, o)
+		em, err := o.EncMode()
+		if err != nil {
+			fail(ht, "EncMode(%+v): %v", o, err)
+		}
+		if got := em.EncOptions(); got != o {
+			fail(ht, "EncOptions() = %+v, want %+v", got, o)
+		}
+		x := toGo(v)
+		got, err := em.Marshal(x)
+
+		// What must be rejected.
+		// toGo makes a *big.Int only for a negative integer beyond int64
+		// (which fits a CBOR integer, so BigIntConvertShortest writes no tag);
+		// the model's bignum tags are plain cbor.Tag values with byte content.
+		var hasNaN, hasInf, hasBig, hasTag, hasBignum bool
+		v.walk(func(e *val) {
+			switch e.kind {
+			case kFloat:
+				hasNaN = hasNaN || math.IsNaN(e.f)
+				hasInf = hasInf || math.IsInf(e.f, 0)
+			case kTag:
+				hasTag = true
+				hasBignum = hasBignum || e.u == 2 || e.u == 3
+			case kNeg:
+				hasBig = hasBig || e.u > math.MaxInt64
+			}
+		})
+		wantErr := (hasNaN && o.NaNConvert == cbor.NaNConvertReject) ||
+			(hasInf && o.InfConvert == cbor.InfConvertReject) ||
+			(hasBig && o.BigIntConvert == cbor.BigIntConvertReject) ||
+			(hasTag && o.TagsMd == cbor.TagsForbidden) ||
+			(hasBig && o.BigIntConvert == cbor.BigIntConvertNone && o.TagsMd == cbor.TagsForbidden)
+		if wantErr {
+			if err == nil {
+				fail(ht, "Marshal(%s) with %+v succeeded: %x", v, o, got)
+			}
+			return
+		}
+		if err != nil {
+			fail(ht, "Marshal(%s) with %+v: %v", v, o, err)
+		}
+		if err := cbor.Wellformed(got); err != nil {
+			fail(ht, "Wellformed(Marshal(%s) with %+v = %x): %v", v, o, got, err)
+		}
+		// The expected value after the documented conversions.
+		want := convert(v, o)
+		d, err := decodeAny(liberalDec, got)
+		if err != nil {
+			fail(ht, "Unmarshal(%x) of %s with %+v: %v", got, v, o, err)
+		}
+		if back := fromGo(d); !same(back, want) {
+			fail(ht, "Marshal(%s) with %+v = %x decoded to %s, want %s", v, o, got, back, want)
+		}
+		// Sorted modes produce the model order; Shortest floats the shortest
+		// heads. Check the exact bytes for the fully determined modes.
+		if o.Sort != cbor.SortNone && o.Sort != cbor.SortFastShuffle && o.ShortestFloat == cbor.ShortestFloat16 && o.NaNConvert == cbor.NaNConvert7e00 && o.InfConvert == cbor.InfConvertFloat16 && o.BigIntConvert == cbor.BigIntConvertShortest {
+			st := styleCoreDet
+			if o.Sort == cbor.SortLengthFirst {
+				st = styleCanonical
+			}
+			if exp := encode(want, st); !bytes.Equal(got, exp) {
+				fail(ht, "Marshal(%s) with %+v\n got  %x\n want %x", v, o, got, exp)
+			}
+		}
+		// Every mode's output decodes to a Go value whose re-encoding under
+		// the same mode is identical (encoding is a function of the value).
+		// A bignum tag decodes to a *big.Int, which BigIntConvertReject
+		// refuses by design, so that combination has no re-encoding.
+		if o.Sort != cbor.SortFastShuffle && o.Sort != cbor.SortNone && !(hasBignum && o.BigIntConvert == cbor.BigIntConvertReject) {
+			again, err := em.Marshal(d)
+			if err != nil || !bytes.Equal(again, got) {
+				fail(ht, "re-encoding the decoded value of %s with %+v: %x, %v; first %x", v, o, again, err, got)
+			}
+		}
+	})
+}
+
+// dropBytesKeys removes map pairs with byte-string keys throughout.
+func dropBytesKeys(v *val) *val {
+	switch v.kind {
+	case kArray:
+		a := make([]*val, len(v.a))
+		for i, e := range v.a {
+			a[i] = dropBytesKeys(e)
+		}
+		return vArray(a...)
+	case kMap:
+		var m []kv
+		for _, e := range v.m {
+			if e.k.kind == kBytes {
+				continue
+			}
+			m = append(m, kv{dropBytesKeys(e.k), dropBytesKeys(e.v)})
+		}
+		return vMap(m...)
+	case kTag:
+		return vTag(v.u, dropBytesKeys(v.a[0]))
+	}
+	return v
+}
+
+// convert applies the documented value conversions of the encoding options:
+// String → byte strings, NaN payload rules (a NaN stays a NaN), bignum tags
+// decode to big.Int either way.
+func convert(v *val, o cbor.EncOptions) *val {
+	switch v.kind {
+	case kText:
+		if o.String == cbor.StringToByteString {
+			return vBytes(v.b)
+		}
+		return v
+	case kArray:
+		a := make([]*val, len(v.a))
+		for i, e := range v.a {
+			a[i] = convert(e, o)
+		}
+		return vArray(a...)
+	case kMap:
+		m := make([]kv, 0, len(v.m))
+		seen := map[string]bool{}
+		for _, e := range v.m {
+			k := convert(e.k, o)
+			ek := string(encode(k, styleCoreDet))
+			if seen[ek] {
+				continue // "a" and h'61' merge under StringToByteString; either value may win
+			}
+			seen[ek] = true
+			m = append(m, kv{k, convert(e.v, o)})
+		}
+		return vMap(m...)
+	case kTag:
+		return vTag(v.u, convert(v.a[0], o))
+	}
+	return v
+}
+
+// Well-formedness of arbitrary bytes agrees with RFC 8949 Appendix C, and the
+// decoder never accepts what is not well-formed nor rejects what is with a
+// syntax error.
+// TestHegelPinBigIntRespectsTagsForbidden: TagsForbidden "disallows CBOR
+// tags", yet Marshal of a big.Int writes a bignum tag (2 or 3) under it:
+// always with BigIntConvertNone, and with BigIntConvertShortest whenever the
+// value does not fit a 64-bit CBOR integer. The library's own decoder with
+// TagsForbidden then rejects the bytes ("CBOR tag isn't allowed").
+func TestHegelPinBigIntRespectsTagsForbidden(t *testing.T) {
+	dm, err := cbor.DecOptions{TagsMd: cbor.TagsForbidden}.DecMode()
+	if err != nil {
+		t.Fatal(err)
+	}
+	two64 := new(big.Int).Lsh(big.NewInt(1), 64)
+	for _, c := range []struct {
+		mode cbor.BigIntConvertMode
+		v    *big.Int
+	}{
+		{cbor.BigIntConvertNone, big.NewInt(1)},
+		{cbor.BigIntConvertNone, two64},
+		{cbor.BigIntConvertShortest, two64},
+		{cbor.BigIntConvertShortest, new(big.Int).Neg(new(big.Int).Add(two64, big.NewInt(1)))},
+	} {
+		em, err := cbor.EncOptions{TagsMd: cbor.TagsForbidden, BigIntConvert: c.mode}.EncMode()
+		if err != nil {
+			t.Fatal(err)
+		}
+		b, err := em.Marshal(c.v)
+		if err != nil {
+			continue // rejected: the only correct outcome besides a tagless encoding
+		}
+		var x any
+		if derr := dm.Unmarshal(b, &x); derr != nil {
+			t.Errorf("BigIntConvert %d: Marshal(%s) under TagsForbidden = %x, which the TagsForbidden decoder rejects: %v", c.mode, c.v, b, derr)
+		}
+	}
+}
+
+func TestHegelWellformednessFollowsRFC8949(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var data []byte
+		switch n(ht, 0, 2) {
+		case 0:
+			data = genBytes(ht, 12)
+		default:
+			v := genVal(ht, genOpts{undefined: true, tags: true, maxDepth: 3, maxItems: 4}, 0)
+			l := &loose{tc: ht}
+			data = l.encode(nil, v, 0)
+			// One mutation.
+			if len(data) > 0 {
+				i := n(ht, 0, len(data)-1)
+				switch n(ht, 0, 4) {
+				case 0:
+					data[i] ^= 1 << n(ht, 0, 7)
+				case 1:
+					data = data[:i]
+				case 2:
+					data = append(data[:i], data[i+1:]...)
+				case 3:
+					data = append(data[:i], append([]byte{byte(n(ht, 0, 255))}, data[i:]...)...)
+				default:
+					data[i] = pick(ht, byte(0xff), 0x5f, 0x7f, 0x9f, 0xbf, 0xf8, 0xfc, 0xfd, 0xfe, 0x1c, 0x1d, 0x1e, 0x1f, 0x3f, 0xdf, 0xf7, 0xf9)
+				}
+			}
+		}
+		note(ht, "data %x", data)
+		k, merr := wellformed(data)
+		if merr == nil && k != len(data) {
+			merr = errors.New("extraneous")
+		}
+		if len(data) == 0 {
+			return
+		}
+		lib := liberalDec.Wellformed(data)
+		if (merr == nil) != (lib == nil) {
+			fail(ht, "Wellformed(%x) = %v; the model says %v", data, lib, merr)
+		}
+		_, derr := decodeAny(liberalDec, data)
+		if merr != nil && derr == nil {
+			fail(ht, "Unmarshal(%x) succeeded on data that is not well-formed (%v)", data, merr)
+		}
+		if merr == nil && derr != nil {
+			var syn *cbor.SyntaxError
+			if errors.As(derr, &syn) || errors.Is(derr, io.ErrUnexpectedEOF) {
+				fail(ht, "Unmarshal(%x) of well-formed data: syntax error %v", data, derr)
+			}
+		}
+		if merr == nil {
+			if _, err := cbor.Diagnose(data); err != nil {
+				var syn *cbor.SyntaxError
+				if errors.As(err, &syn) || errors.Is(err, io.ErrUnexpectedEOF) {
+					fail(ht, "Diagnose(%x) of well-formed data: %v", data, err)
+				}
+			}
+		} else if _, err := cbor.Diagnose(data); err == nil {
+			fail(ht, "Diagnose(%x) succeeded on data that is not well-formed (%v)", data, merr)
+		}
+		// Truncation is always an unexpected EOF, never a clean decode.
+		if merr == nil && len(data) > 1 {
+			cut := n(ht, 1, len(data)-1)
+			if err := liberalDec.Wellformed(data[:cut]); !errors.Is(err, io.ErrUnexpectedEOF) {
+				fail(ht, "Wellformed(%x cut at %d) = %v", data, cut, err)
+			}
+		}
+	})
+}
