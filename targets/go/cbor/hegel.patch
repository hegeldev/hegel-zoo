+// A CBOR sequence written by the Encoder decodes item by item with the
+// Decoder from any reader, with Skip, NumBytesRead and Buffered consistent;
+// UnmarshalFirst and DiagnoseFirst walk the same sequence; the Encoder's
+// indefinite-length containers decode to the same containers.
+func TestHegelStreamsDecodeItemByItem(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 0, 6)
+		items := make([]*val, k)
+		var seq []byte
+		var buf bytes.Buffer
+		enc := encCoreDet.NewEncoder(&buf)
+		for i := range items {
+			items[i] = genVal(ht, genOpts{tags: true, maxDepth: 3, maxItems: 4}, 0)
+			b, err := encCoreDet.Marshal(toGo(items[i]))
+			if err != nil {
+				fail(ht, "Marshal(%s): %v", items[i], err)
+			}
+			seq = append(seq, b...)
+			if err := enc.Encode(toGo(items[i])); err != nil {
+				fail(ht, "Encoder.Encode(%s): %v", items[i], err)
+			}
+		}
+		note(ht, "%d items %v\nsequence %x", k, items, seq)
+		if !bytes.Equal(buf.Bytes(), seq) {
+			fail(ht, "Encoder wrote %x, Marshal concatenated %x", buf.Bytes(), seq)
+		}
+		// Decode from a reader that delivers the bytes awkwardly.
+		var r io.Reader = bytes.NewReader(seq)
+		switch pick(ht, 0, 1, 2, 3) {
+		case 1:
+			r = iotest.OneByteReader(r)
+		case 2:
+			r = iotest.HalfReader(r)
+		case 3:
+			r = iotest.DataErrReader(r)
+		}
+		dec := liberalDec.NewDecoder(r)
+		off := 0
+		for i, want := range items {
+			if dec.NumBytesRead() != off {
+				fail(ht, "NumBytesRead() = %d before item %d, want %d", dec.NumBytesRead(), i, off)
+			}
+			enc := encode(want, styleCoreDet)
+			size := len(enc)
+			if chance(ht, 30) {
+				if err := dec.Skip(); err != nil {
+					fail(ht, "Skip() at item %d (%s): %v", i, want, err)
+				}
+			} else {
+				var x any
+				if err := dec.Decode(&x); err != nil {
+					fail(ht, "Decode() at item %d (%s): %v", i, want, err)
+				}
+				if back := fromGo(x); !same(back, want) {
+					fail(ht, "Decode() at item %d gave %s, want %s (%x)", i, back, want, enc)
+				}
+			}
+			off += size
+		}
+		var x any
+		if err := dec.Decode(&x); err != io.EOF {
+			fail(ht, "Decode() after %d items: %v, want io.EOF", k, err)
+		}
+		if err := dec.Skip(); err != io.EOF {
+			fail(ht, "Skip() after %d items: %v, want io.EOF", k, err)
+		}
+		if dec.NumBytesRead() != len(seq) {
+			fail(ht, "NumBytesRead() = %d at the end, want %d", dec.NumBytesRead(), len(seq))
+		}
+		// UnmarshalFirst / DiagnoseFirst walk the same items.
+		rest := seq
+		for i, want := range items {
+			var x any
+			var err error
+			rest, err = liberalDec.UnmarshalFirst(rest, &x)
+			if err != nil {
+				fail(ht, "UnmarshalFirst at item %d (%s): %v", i, want, err)
+			}
+			if back := fromGo(x); !same(back, want) {
+				fail(ht, "UnmarshalFirst at item %d gave %s, want %s", i, back, want)
+			}
+		}
+		if len(rest) != 0 {
+			fail(ht, "UnmarshalFirst left %x after %d items", rest, k)
+		}
+		if _, err := liberalDec.UnmarshalFirst(rest, &x); err != io.EOF {
+			fail(ht, "UnmarshalFirst on empty data: %v, want io.EOF", err)
+		}
+		rest = seq
+		for i := range items {
+			var err error
+			_, rest, err = cbor.DiagnoseFirst(rest)
+			if err != nil {
+				fail(ht, "DiagnoseFirst at item %d: %v", i, err)
+			}
+		}
+		if len(rest) != 0 {
+			fail(ht, "DiagnoseFirst left %x after %d items", rest, k)
+		}
+		// Indefinite-length containers through the Encoder.
+		buf.Reset()
+		enc2 := cbor.NewEncoder(&buf)
+		var want *val
+		switch pick(ht, 0, 1, 2, 3) {
+		case 0:
+			if err := enc2.StartIndefiniteArray(); err != nil {
+				fail(ht, "StartIndefiniteArray: %v", err)
+			}
+			for _, it := range items {
+				if err := enc2.Encode(toGo(it)); err != nil {
+					fail(ht, "Encode in an indefinite array: %v", err)
+				}
+			}
+			want = vArray(items...)
+		case 1:
+			if err := enc2.StartIndefiniteMap(); err != nil {
+				fail(ht, "StartIndefiniteMap: %v", err)
+			}
+			var m []kv
+			seen := map[string]bool{}
+			for i, it := range items {
+				key := vUint(uint64(i))
+				if err := enc2.Encode(toGo(key)); err != nil || enc2.Encode(toGo(it)) != nil {
+					fail(ht, "Encode in an indefinite map: %v", err)
+				}
+				if !seen[string(encode(key, styleCoreDet))] {
+					m = append(m, kv{key, it})
+				}
+			}
+			want = vMap(m...)
+		case 2:
+			if err := enc2.StartIndefiniteByteString(); err != nil {
+				fail(ht, "StartIndefiniteByteString: %v", err)
+			}
+			var all []byte
+			for _, it := range items {
+				chunk := encode(it, styleCoreDet)
+				if err := enc2.Encode(chunk); err != nil {
+					fail(ht, "Encode a byte-string chunk: %v", err)
+				}
+				all = append(all, chunk...)
+			}
+			want = vBytes(all)
+		default:
+			if err := enc2.StartIndefiniteTextString(); err != nil {
+				fail(ht, "StartIndefiniteTextString: %v", err)
+			}
+			var all []byte
+			for _, it := range items {
+				chunk := it.String()
+				if err := enc2.Encode(chunk); err != nil {
+					fail(ht, "Encode a text-string chunk: %v", err)
+				}
+				all = append(all, chunk...)
+			}
+			want = vText(string(all))
+		}
+		if err := enc2.EndIndefinite(); err != nil {
+			fail(ht, "EndIndefinite: %v", err)
+		}
+		if err := enc2.EndIndefinite(); err == nil {
+			fail(ht, "a second EndIndefinite succeeded")
+		}
+		if err := cbor.Wellformed(buf.Bytes()); err != nil {
+			fail(ht, "the Encoder's indefinite-length output %x: %v", buf.Bytes(), err)
+		}
+		x = nil
+		if err := liberalDec.Unmarshal(buf.Bytes(), &x); err != nil {
+			fail(ht, "Unmarshal(%x) of the indefinite-length container: %v", buf.Bytes(), err)
+		}
+		if back := fromGo(x); !same(back, want) {
+			fail(ht, "the indefinite-length container %x decoded to %s, want %s", buf.Bytes(), back, want)
+		}
+	})
+}
