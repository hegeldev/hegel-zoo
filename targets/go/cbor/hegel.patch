+// Integers decode into exactly the Go integer types that hold them, with an
+// UnmarshalTypeError otherwise; big.Int encodes as the plain integer when it
+// fits and as a bignum otherwise (or always, with BigIntConvertNone); a
+// bignum's content is the minimal big-endian magnitude.
+func TestHegelIntegersFitTheirGoTypes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// A signed integer: mostly within 64 bits, sometimes far beyond.
+		var x *big.Int
+		switch n(ht, 0, 3) {
+		case 0:
+			x = new(big.Int).SetUint64(genUint(ht))
+			if chance(ht, 50) {
+				x.Neg(x)
+				if chance(ht, 50) {
+					x.Sub(x, big.NewInt(1))
+				}
+			}
+		case 1:
+			x = big.NewInt(int64(n(ht, -300, 300)))
+		case 2:
+			bits := n(ht, 60, 200)
+			x = new(big.Int).Lsh(big.NewInt(1), uint(bits))
+			x.Add(x, new(big.Int).SetUint64(genUint(ht)))
+			if chance(ht, 50) {
+				x.Neg(x)
+			}
+		default:
+			x = pick(ht, big.NewInt(math.MaxInt64), big.NewInt(math.MinInt64), new(big.Int).SetUint64(math.MaxUint64),
+				new(big.Int).Neg(new(big.Int).SetUint64(math.MaxUint64)), new(big.Int).Neg(new(big.Int).Lsh(big.NewInt(1), 64)),
+				new(big.Int).Lsh(big.NewInt(1), 64), new(big.Int).Neg(new(big.Int).Add(new(big.Int).Lsh(big.NewInt(1), 64), big.NewInt(1))),
+				big.NewInt(-129), big.NewInt(-128), big.NewInt(127), big.NewInt(128), big.NewInt(255), big.NewInt(256), big.NewInt(math.MaxInt32), big.NewInt(math.MinInt32), big.NewInt(-1), big.NewInt(0))
+		}
+		want := vBig(x)
+		note(ht, "integer %s = %s", x, want)
+		// Encoding of the big.Int, shortest and bignum-only.
+		got, err := encCoreDet.Marshal(x)
+		if err != nil || !bytes.Equal(got, encode(want, styleCoreDet)) {
+			fail(ht, "CoreDet Marshal(%s) = %x, %v; want %x", x, got, err, encode(want, styleCoreDet))
+		}
+		emNone := mustEncMode(cbor.EncOptions{BigIntConvert: cbor.BigIntConvertNone})
+		gotNone, err := emNone.Marshal(x)
+		var wantNone *val
+		if x.Sign() >= 0 {
+			wantNone = vTag(2, vBytes(x.Bytes()))
+		} else {
+			m := new(big.Int).Neg(x)
+			m.Sub(m, big.NewInt(1))
+			wantNone = vTag(3, vBytes(m.Bytes()))
+		}
+		if err != nil || !bytes.Equal(gotNone, encode(wantNone, styleCoreDet)) {
+			fail(ht, "BigIntConvertNone Marshal(%s) = %x, %v; want %x", x, gotNone, err, encode(wantNone, styleCoreDet))
+		}
+		// Both encodings decode to the same big.Int, into *big.Int and into any.
+		for _, data := range [][]byte{got, gotNone} {
+			var bi big.Int
+			if err := cbor.Unmarshal(data, &bi); err != nil || bi.Cmp(x) != 0 {
+				fail(ht, "Unmarshal(%x) into big.Int = %s, %v; want %s", data, &bi, err, x)
+			}
+			var pbi *big.Int
+			if err := cbor.Unmarshal(data, &pbi); err != nil || pbi == nil || pbi.Cmp(x) != 0 {
+				fail(ht, "Unmarshal(%x) into *big.Int = %v, %v; want %s", data, pbi, err, x)
+			}
+			a, err := decodeAny(liberalDec, data)
+			if err != nil {
+				fail(ht, "Unmarshal(%x) into any: %v", data, err)
+			}
+			if back := fromGo(a); !same(back, want) {
+				fail(ht, "Unmarshal(%x) into any = %#v (%s), want %s", data, a, back, want)
+			}
+			// A bignum with a 64-bit magnitude decodes to big.Int (the
+			// value), not to uint64/int64: the documented type for tags 2/3.
+			if bytes.Equal(data, gotNone) {
+				if _, ok := a.(big.Int); !ok {
+					fail(ht, "Unmarshal(%x) of a bignum into any gave %T", data, a)
+				}
+			}
+			// Sized Go integers.
+			check := func(name string, ptr any, lo, hi *big.Int) {
+				err := cbor.Unmarshal(data, ptr)
+				fits := x.Cmp(lo) >= 0 && x.Cmp(hi) <= 0
+				if fits && err != nil {
+					fail(ht, "Unmarshal(%x = %s) into %s: %v", data, x, name, err)
+				}
+				if !fits {
+					var ute *cbor.UnmarshalTypeError
+					if !errors.As(err, &ute) {
+						fail(ht, "Unmarshal(%x = %s) into %s: %v, want UnmarshalTypeError", data, x, name, err)
+					}
+					return
+				}
+				gotv := reflect.ValueOf(ptr).Elem()
+				var back *big.Int
+				if gotv.CanInt() {
+					back = big.NewInt(gotv.Int())
+				} else {
+					back = new(big.Int).SetUint64(gotv.Uint())
+				}
+				if back.Cmp(x) != 0 {
+					fail(ht, "Unmarshal(%x = %s) into %s = %s", data, x, name, back)
+				}
+			}
+			check("int8", new(int8), big.NewInt(math.MinInt8), big.NewInt(math.MaxInt8))
+			check("int16", new(int16), big.NewInt(math.MinInt16), big.NewInt(math.MaxInt16))
+			check("int32", new(int32), big.NewInt(math.MinInt32), big.NewInt(math.MaxInt32))
+			check("int64", new(int64), big.NewInt(math.MinInt64), big.NewInt(math.MaxInt64))
+			check("int", new(int), big.NewInt(math.MinInt64), big.NewInt(math.MaxInt64))
+			check("uint8", new(uint8), big.NewInt(0), big.NewInt(math.MaxUint8))
+			check("uint16", new(uint16), big.NewInt(0), big.NewInt(math.MaxUint16))
+			check("uint32", new(uint32), big.NewInt(0), big.NewInt(math.MaxUint32))
+			check("uint64", new(uint64), big.NewInt(0), new(big.Int).SetUint64(math.MaxUint64))
+			check("uint", new(uint), big.NewInt(0), new(big.Int).SetUint64(math.MaxUint64))
+		}
+		// Go integer types encode as the model integer.
+		if x.IsInt64() {
+			i := x.Int64()
+			for _, g := range []any{i, int32(i), int16(i), int8(i), int(i)} {
+				lim := int64(1) << (reflect.TypeOf(g).Bits() - 1)
+				if reflect.TypeOf(g).Bits() == 64 || (i >= -lim && i < lim) {
+					b, err := cbor.Marshal(g)
+					if err != nil || !bytes.Equal(b, encode(want, styleCoreDet)) {
+						fail(ht, "Marshal(%T %v) = %x, %v; want %x", g, g, b, err, encode(want, styleCoreDet))
+					}
+				}
+			}
+		}
+		if x.IsUint64() {
+			u := x.Uint64()
+			for _, g := range []any{u, uint32(u), uint16(u), uint8(u), uint(u)} {
+				bits := reflect.TypeOf(g).Bits()
+				if bits == 64 || u < 1<<bits {
+					b, err := cbor.Marshal(g)
+					if err != nil || !bytes.Equal(b, encode(want, styleCoreDet)) {
+						fail(ht, "Marshal(%T %v) = %x, %v; want %x", g, g, b, err, encode(want, styleCoreDet))
+					}
+				}
+			}
+		}
+	})
+}
