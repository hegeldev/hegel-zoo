+// TestHegelExpandedStructKeepsItsRefs: the recursive HZNode (or a pointer to it) reflected
+// with ExpandedStruct: the definition moved into the root is referenced as "#", so a value
+// with a next or kids validates; the package leaves $refs to the removed definition
+// (invopop-jsonschema/12). HEGEL_NO_KNOWN=1 expands the non-recursive HZInner.
+func TestHegelExpandedStructKeepsItsRefs(t *testing.T) {
+	opts := hzOptionsWith(func(o hzRefOpts) hzRefOpts { o.expanded, o.doNotReference = true, false; return o })
+	roots := hzWrapped(hzShaped(hzNamed("HZNode"), hzNamed("HZInner")))
+	hzNarrow(t, "invopop-jsonschema/12", opts, roots)
