+package hegel
+
+// One narrow property per recorded bug (bugs.toml): a generator over the bug's shape region
+// with random contents (other fields, options, values), judged as the wide properties judge
+// (the value against the package's and the model's schema by python-jsonschema, then the
+// schema against the model), so that each bug has a property that finds it every run. Under
+// HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch instead (a struct
+// field in place of url.URL, unsigned or string keys, an ordinary tag name, distinct keys, a
+// plain json option, an exported embedded type, uniqueItems=true, minimum= extras, a string
+// field in place of net.IP, tags on an unnamed slice, scalar defaults, ExpandedStruct and
+// DoNotReference on a non-recursive type, nullable on a pointer field) and passes.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"runtime/debug"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/invopop/jsonschema"
+	"hegel.dev/go/hegel"
+)
+
+// hzShapesOf names the bug a narrow property is about together with every other recorded
+// shape the case has - or nothing under HEGEL_NO_KNOWN=1, when the property draws the
+// neighbouring region and a disagreement is a plain failure.
+func hzShapesOf(id string, others []string) []string {
+	if hzNoKnown {
+		return nil
+	}
+	shapes := []string{id}
+	for _, s := range others {
+		if s != id {
+			shapes = append(shapes, s)
+		}
+	}
+	return shapes
+}
+
+// hzJudge judges a case as the wide properties do: the value against the schemas
+// (TestHegelValidate), then the schema against the model (TestHegelSchema).
+func hzJudge(ht *hegel.T, col *hzCollector, oracle *hzOracle, vc hzValueCase, bug string) {
+	shapes := hzShapesOf(bug, HZKnown.explains(vc.typ, vc.o))
+	rt := vc.typ.hzReflectType()
+	if vc.val.unsat {
+		col.count("unsatisfiable tags")
+	} else if inst, err := json.Marshal(vc.val.rv.Interface()); err == nil {
+		hzCheckValue(ht, col, oracle, vc.hzCase, rt, inst, shapes)
+	} else {
+		col.count("marshal error")
+	}
+	hzCheckSchema(ht, col, vc.hzCase, rt, shapes)
+}
+
+// hzNarrow runs a narrow property over cases of the options and roots.
+func hzNarrow(t *testing.T, bug string, opts hegel.Generator[hzRefOpts], roots hegel.Generator[*hzType]) {
+	col := hzNewCollector(t)
+	oracle := hzStartOracle(t)
+	cases := hzValueCasesOf(hzCasesOf(opts, roots))
+	hzProperty(t, func(ht *hegel.T) {
+		hzJudge(ht, col, oracle, hegel.Draw(ht, cases), bug)
+	})
+}
+
+// --------------------------------------------------------------------------- the regions' pieces
+
+var (
+	hzLeaves    = hzTypesAt(false, 0)
+	hzOtherKeys = hzPick("p", "q", "r", "s")
+	// hzOtherFields: the random fields around a shape (types of one nesting level, never
+	// HZNode, keys no shape uses).
+	hzOtherFields = hzShapeFieldsOf(hzTypesAt(false, 1), hzMaybe(70, hzOtherKeys))
+	// hzWraps: a type as it is, behind a pointer, or in a slice.
+	hzWraps = hzWeighted(
+		hzChoice[func(*hzType) *hzType]{2, hegel.Just(func(t *hzType) *hzType { return t })},
+		hzChoice[func(*hzType) *hzType]{1, hegel.Just(hzPtrTo)},
+		hzChoice[func(*hzType) *hzType]{1, hegel.Just(hzSliceOf)},
+	)
+	hzNoDoNotReference = hzOptionsWith(func(o hzRefOpts) hzRefOpts { o.doNotReference = false; return o })
+)
+
+// hzWrapped is the type wrapped in one of hzWraps.
+func hzWrapped(t *hzType) hegel.Generator[*hzType] {
+	return hegel.Map(hzWraps, func(w func(*hzType) *hzType) *hzType { return w(t) })
+}
+
+// hzKeyTagsOf: a json tag of a key from keys with options (no inline), or no tag when the key
+// is empty.
+func hzKeyTagsOf(keys hegel.Generator[string]) hegel.Generator[hzJSONTag] {
+	options := hzJSONOptionsOf(false)
+	return hegel.Composite(func(tc hegel.TestCase) hzJSONTag {
+		key := hegel.Draw(tc, keys)
+		if key == "" {
+			return hzJSONTag{}
+		}
+		j := hegel.Draw(tc, options)
+		j.present, j.name = true, key
+		return j
+	})
+}
+
+// hzShapeFieldsOf: a field of a type from types, keyed from keys, with keywords fitting the
+// type, a description and extras.
+func hzShapeFieldsOf(types hegel.Generator[*hzType], keys hegel.Generator[string]) hegel.Generator[hzField] {
+	tags := hzKeyTagsOf(keys)
+	return hegel.Composite(func(tc hegel.TestCase) hzField {
+		typ := hegel.Draw(tc, types)
+		f := hzField{typ: typ, json: hegel.Draw(tc, tags)}
+		f.kw = hegel.Draw(tc, hzKeywordsFor(typ, f.json))
+		f.desc = hegel.Draw(tc, hzMaybe(10, hzPick("d2", "the field")))
+		f.extras = hegel.Draw(tc, hzMaybe(12, hzExtraLists))
+		return f
+	})
+}
+
+func hzOne(f hegel.Generator[hzField]) hegel.Generator[[]hzField] {
+	return hegel.Map(f, func(f hzField) []hzField { return []hzField{f} })
+}
+
+// hzAround: a root struct of the shape's fields, in their order, among up to three other
+// fields at a drawn position.
+func hzAround(shape hegel.Generator[[]hzField]) hegel.Generator[*hzType] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzType {
+		others := hegel.Draw(tc, hzMany(hzOtherFields, 0, 3))
+		sh := hegel.Draw(tc, shape)
+		at := hegel.Draw(tc, hegel.Integers(0, 3)) % (len(others) + 1)
+		fields := append(append(append([]hzField{}, others[:at]...), sh...), others[at:]...)
+		return hzStruct(fields, nil, 0)
+	})
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/1
+
+// TestHegelURLFieldsAreObjects: a field of url.URL (as is, behind a pointer or in a slice):
+// encoding/json writes the URL's fields as an object, and the schema must accept it; the
+// package says string with format uri (invopop-jsonschema/1). HEGEL_NO_KNOWN=1 draws a
+// struct type (HZInner) in its place.
+func TestHegelURLFieldsAreObjects(t *testing.T) {
+	types := hzWrapped(hzShaped(hzKind("url"), hzNamed("HZInner")))
+	hzNarrow(t, "invopop-jsonschema/1", hzOptions, hzAround(hzOne(hzShapeFieldsOf(types, hzPick("u", "")))))
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/2
+
+// TestHegelSignedIntegerKeysAllowNegatives: a map with signed integer keys: encoding/json
+// writes a negative key with its sign, so the schema's key pattern must admit it; the
+// package's ^[0-9]+$ does not (invopop-jsonschema/2). HEGEL_NO_KNOWN=1 draws unsigned or
+// string keys.
+func TestHegelSignedIntegerKeysAllowNegatives(t *testing.T) {
+	keys := hzShaped(hegel.Just("int"), hzPick("uint", "string"))
+	types := hegel.Composite(func(tc hegel.TestCase) *hzType {
+		return &hzType{kind: "map", key: hegel.Draw(tc, keys), elem: hegel.Draw(tc, hzLeaves)}
+	})
+	hzNarrow(t, "invopop-jsonschema/2", hzOptions, hzAround(hzOne(hzShapeFieldsOf(types, hzPick("m", "")))))
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/3
+
+// TestHegelDashCommaNamesAKey: a field tagged json:"-," (with any options) is written under
+// the key "-", which the schema must have; the package leaves the field out
+// (invopop-jsonschema/3). HEGEL_NO_KNOWN=1 draws an ordinary key.
+func TestHegelDashCommaNamesAKey(t *testing.T) {
+	keys := hzShaped(hegel.Just("-"), hzPick("d", "e"))
+	hzNarrow(t, "invopop-jsonschema/3", hzOptions, hzAround(hzOne(hzShapeFieldsOf(hzLeaves, keys))))
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/4
+
+// hzConflictFields: an outer field keyed like a field of HZInner (a: an integer there; b: a
+// string there) with a type of another schema, followed by an embedded HZInner (or a pointer
+// to one) that promotes its fields: encoding/json lets the outer field win. HEGEL_NO_KNOWN=1
+// keys the outer field c or d, which conflicts with nothing.
+var (
+	hzNotInteger    = hegel.Map(hzPick("string", "bool", "float64", "time"), hzKind)
+	hzNotString     = hegel.Map(hzPick("int", "bool", "float64", "uint8"), hzKind)
+	hzEmbeddedInner = hegel.Composite(func(tc hegel.TestCase) hzField {
+		typ := hegel.Draw(tc, hzWeighted(
+			hzChoice[*hzType]{2, hegel.Just(hzNamed("HZInner"))},
+			hzChoice[*hzType]{1, hegel.Just(hzPtrTo(hzNamed("HZInner")))},
+		))
+		return hzField{name: "HZInner", typ: typ, embedded: true, json: hegel.Draw(tc, hzMaybe(50, hzPick(hzJSONTag{present: true, omitempty: true}, hzJSONTag{present: true})))}
+	})
+	hzConflictFields = hegel.Composite(func(tc hegel.TestCase) []hzField {
+		key := hegel.Draw(tc, hzShaped(hzPick("a", "b"), hzPick("c", "d")))
+		types := hzNotInteger
+		if key == "b" || key == "d" {
+			types = hzNotString
+		}
+		outer := hegel.Draw(tc, hzShapeFieldsOf(types, hegel.Just(key)))
+		return []hzField{outer, hegel.Draw(tc, hzEmbeddedInner)}
+	})
+)
+
+// TestHegelOuterFieldWinsOverEmbedded: an outer field and a promoted field of an embedded
+// struct share a key: encoding/json writes the outer one, so its schema is the property's;
+// the package lets the later, embedded field's schema replace it (invopop-jsonschema/4).
+func TestHegelOuterFieldWinsOverEmbedded(t *testing.T) {
+	hzNarrow(t, "invopop-jsonschema/4", hzOptions, hzAround(hzConflictFields))
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/5
+
+// TestHegelInlineIsNotAJSONOption: a field with the json option "inline" (a named struct, a
+// pointer to one, an anonymous struct, or a scalar or slice): encoding/json knows no such
+// option and writes the key, which the schema must have; the package inlines a struct's
+// fields and drops any other field (invopop-jsonschema/5). HEGEL_NO_KNOWN=1 draws the same
+// fields with plain options.
+func TestHegelInlineIsNotAJSONOption(t *testing.T) {
+	types := hzWeighted(
+		hzChoice[*hzType]{2, hegel.Just(hzNamed("HZInner"))},
+		hzChoice[*hzType]{1, hegel.Just(hzPtrTo(hzNamed("HZInner")))},
+		hzChoice[*hzType]{1, hzStructsOf(hzLeaves)},
+		hzChoice[*hzType]{1, hegel.Just(hzKind("int"))},
+		hzChoice[*hzType]{1, hegel.Just(hzSliceOf(hzKind("int")))},
+	)
+	tags := hegel.Map(hzKeyTagsOf(hzPick("i", "j")), func(j hzJSONTag) hzJSONTag { j.inline = hzShaped(true, false); return j })
+	fields := hegel.Composite(func(tc hegel.TestCase) hzField {
+		typ := hegel.Draw(tc, types)
+		f := hzField{typ: typ, json: hegel.Draw(tc, tags)}
+		f.kw = hegel.Draw(tc, hzKeywordsFor(typ, f.json))
+		return f
+	})
+	hzNarrow(t, "invopop-jsonschema/5", hzOptions, hzAround(hzOne(fields)))
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/6
+
+// TestHegelUnexportedEmbeddedTypesAreNotProperties: a declared struct embedding the unexported
+// hzLevel among other fields (the family HZUnexportedA-D, as is or behind a pointer):
+// encoding/json ignores an unexported embedded field of a non-struct type, so the schema must
+// not require it; the package makes it a required property (invopop-jsonschema/6).
+// HEGEL_NO_KNOWN=1 draws the siblings embedding the exported HZLevel, which is a property.
+func TestHegelUnexportedEmbeddedTypesAreNotProperties(t *testing.T) {
+	names := hzShaped(hzPick("HZUnexportedA", "HZUnexportedB", "HZUnexportedC", "HZUnexportedD"), hzPick("HZExportedA", "HZExportedB", "HZExportedC", "HZExportedD"))
+	roots := hegel.Composite(func(tc hegel.TestCase) *hzType {
+		typ := hzNamed(hegel.Draw(tc, names))
+		if hegel.Draw(tc, hzChance(30)) {
+			typ = hzPtrTo(typ)
+		}
+		return typ
+	})
+	hzNarrow(t, "invopop-jsonschema/6", hzOptions, roots)
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/7
+
+var (
+	hzListElems = hegel.Map(hzPick("int", "string", "float64", "bool"), hzKind)
+	// hzLists: a slice or an array of up to three scalars (two booleans: more cannot be
+	// distinct).
+	hzLists = hegel.Composite(func(tc hegel.TestCase) *hzType {
+		elem := hegel.Draw(tc, hzListElems)
+		if hegel.Draw(tc, hzChance(30)) {
+			n := 3
+			if elem.kind == "bool" {
+				n = 2
+			}
+			return &hzType{kind: "array", n: hegel.Draw(tc, hegel.Integers(0, n)), elem: elem}
+		}
+		return hzSliceOf(elem)
+	})
+)
+
+// hzListFieldsWith: a field of a list type keyed "l" with the generic keywords and the array
+// keywords of arr.
+func hzListFieldsWith(types hegel.Generator[*hzType], arr func(n int) hegel.Generator[hzArrayKw]) hegel.Generator[hzField] {
+	tags := hzKeyTagsOf(hzPick("l"))
+	return hegel.Composite(func(tc hegel.TestCase) hzField {
+		typ := hegel.Draw(tc, types)
+		n := -1
+		if rt := typ.hzResolve(); rt.kind == "array" {
+			n = rt.n
+		}
+		kw := hegel.Draw(tc, hzGenericKw[1])
+		kw.arr = hegel.Draw(tc, arr(n))
+		return hzField{typ: typ, json: hegel.Draw(tc, tags), kw: kw}
+	})
+}
+
+// TestHegelUniqueItemsFalseIsFalse: a list field tagged uniqueItems=false (with minItems and
+// maxItems at random) accepts repeated elements, and its schema says nothing of uniqueness;
+// the package sets uniqueItems true (invopop-jsonschema/7). HEGEL_NO_KNOWN=1 tags
+// uniqueItems=true.
+func TestHegelUniqueItemsFalseIsFalse(t *testing.T) {
+	fields := hzListFieldsWith(hzLists, func(n int) hegel.Generator[hzArrayKw] {
+		minItems, maxItems := hzCounts(0, 2), hzCounts(2, 4)
+		if n >= 0 {
+			minItems, maxItems = hzCounts(0, n), hzCounts(n, 4)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) hzArrayKw {
+			return hzArrayKw{
+				minItems: hegel.Draw(tc, hzMaybe(40, minItems)),
+				maxItems: hegel.Draw(tc, hzMaybe(30, maxItems)),
+				unique:   hzShaped("uniqueItems=false", "uniqueItems=true"),
+			}
+		})
+	})
+	hzNarrow(t, "invopop-jsonschema/7", hzOptions, hzAround(hzOne(fields)))
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/8
+
+// TestHegelExtrasKeywordsAreTyped: a scalar field whose jsonschema_extras hold maximum=<n>
+// (among other extras): the keyword is a number in the schema, which is then a valid schema;
+// the package keeps it a string, an invalid schema (invopop-jsonschema/8). HEGEL_NO_KNOWN=1
+// writes minimum=<n>, which the package converts.
+func TestHegelExtrasKeywordsAreTyped(t *testing.T) {
+	plain := hzPick("a=b", "foo=bar", "x=true", "x=false", "c=t")
+	extras := hegel.Composite(func(tc hegel.TestCase) []string {
+		others := hegel.Draw(tc, hzMany(plain, 0, 2))
+		bound := hzShaped("maximum=", "minimum=") + hegel.Draw(tc, hzCounts(1, 9))
+		at := hegel.Draw(tc, hegel.Integers(0, 2)) % (len(others) + 1)
+		return append(append(append([]string{}, others[:at]...), bound), others[at:]...)
+	})
+	types := hegel.Map(hzPick("int", "float64", "string", "bool", "uint16"), hzKind)
+	tags := hzKeyTagsOf(hzPick("n", ""))
+	fields := hegel.Composite(func(tc hegel.TestCase) hzField {
+		// The generic keywords only: a typed bound beside the extras' one would often leave
+		// no value.
+		return hzField{typ: hegel.Draw(tc, types), json: hegel.Draw(tc, tags), kw: hegel.Draw(tc, hzGenericKw[1]), extras: hegel.Draw(tc, extras)}
+	})
+	hzNarrow(t, "invopop-jsonschema/8", hzOptions, hzAround(hzOne(fields)))
+}
