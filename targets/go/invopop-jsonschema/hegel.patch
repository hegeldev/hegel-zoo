+
+// --------------------------------------------------------------------------- invopop-jsonschema/13
+
+// hzRecursiveCase is a type holding the recursive HZNode (under HEGEL_NO_KNOWN=1: the
+// non-recursive HZInner) reflected with DoNotReference: the core as is, behind a pointer, in a
+// slice, in a map or in an array (wrap), as the root, as a field, or as a field of a slice of
+// structs (via), with extra integer fields; and the other options. It is encoded for the child
+// process that reflects it (the call may never return) and rebuilt there.
+type hzRecursiveCase struct {
+	wrap, via, extra int
+	o                hzRefOpts
+}
+
+var hzRecursiveCases = hegel.Composite(func(tc hegel.TestCase) hzRecursiveCase {
+	o := hegel.Draw(tc, hzOptions)
+	o.doNotReference = true
+	return hzRecursiveCase{wrap: hegel.Draw(tc, hegel.Integers(0, 4)), via: hegel.Draw(tc, hegel.Integers(0, 2)), extra: hegel.Draw(tc, hegel.Integers(0, 3)), o: o}
+})
+
+func (c hzRecursiveCase) typ() *hzType {
+	core := hzShaped(hzNamed("HZNode"), hzNamed("HZInner"))
+	switch c.wrap {
+	case 1:
+		core = hzPtrTo(core)
+	case 2:
+		core = hzSliceOf(core)
+	case 3:
+		core = &hzType{kind: "map", key: "string", elem: core}
+	case 4:
+		core = &hzType{kind: "array", n: 2, elem: core}
+	}
+	if c.via == 0 {
+		return core
+	}
+	if c.via == 2 {
+		core = hzSliceOf(&hzType{kind: "struct", fields: []hzField{hzTagged("F0", "n", core)}})
+	}
+	fields := []hzField{hzTagged("F0", "n", core)}
+	for i := 1; i <= c.extra; i++ {
+		fields = append(fields, hzTagged(fmt.Sprintf("F%d", i), fmt.Sprintf("f%d", i), hzKind("int")))
+	}
+	return &hzType{kind: "struct", fields: fields}
+}
+
+func (c hzRecursiveCase) GoString() string {
+	return fmt.Sprintf("type %s, options %s", c.typ(), c.o)
+}
+
+func hzBit(b bool) string {
+	if b {
+		return "1"
+	}
+	return "0"
+}
+
+func (c hzRecursiveCase) encode() string {
+	return fmt.Sprintf("%d,%d,%d,%s%s%s%s%s", c.wrap, c.via, c.extra, hzBit(c.o.anonymous), hzBit(c.o.allowAdditional), hzBit(c.o.requiredFromTags), hzBit(c.o.expanded), hzBit(c.o.anchor))
+}
+
+func hzDecodeRecursiveCase(s string) hzRecursiveCase {
+	parts := strings.Split(s, ",")
+	wrap, _ := strconv.Atoi(parts[0])
+	via, _ := strconv.Atoi(parts[1])
+	extra, _ := strconv.Atoi(parts[2])
+	bits := parts[3]
+	return hzRecursiveCase{wrap: wrap, via: via, extra: extra, o: hzRefOpts{
+		anonymous: bits[0] == '1', allowAdditional: bits[1] == '1', requiredFromTags: bits[2] == '1',
+		doNotReference: true, expanded: bits[3] == '1', anchor: bits[4] == '1',
+	}}
+}
+
+// hzChildVerdict is what the child process reported: the schema it printed, or how it died.
+type hzChildVerdict struct {
+	schema []byte
+	err    error
+}
+
+var (
+	hzChildMu       sync.Mutex
+	hzChildVerdicts = map[string]hzChildVerdict{}
+)
+
+// hzReflectInChild reflects the case in a child process (this test binary running
+// TestHegelDoNotReferenceTerminates with HZ_RECURSIVE_CASE set) under a capped address space
+// and a deadline, and returns its verdict, cached per case since the shrinker revisits the
+// same few cases many times.
+func hzReflectInChild(c hzRecursiveCase) hzChildVerdict {
+	key := c.encode()
+	hzChildMu.Lock()
+	defer hzChildMu.Unlock()
+	if v, ok := hzChildVerdicts[key]; ok {
+		return v
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "sh", "-c", `ulimit -v 2200000; exec "$0" "$@"`, os.Args[0], "-test.run=^TestHegelDoNotReferenceTerminates$")
+	cmd.Env = append(os.Environ(), "HZ_RECURSIVE_CASE="+key)
+	cmd.WaitDelay = 2 * time.Second
+	out, err := cmd.CombinedOutput()
+	v := hzChildVerdict{}
+	if err != nil {
+		msg := strings.TrimSpace(string(out))
+		if i := strings.Index(msg, "\n"); i > 0 {
+			msg = msg[:i]
+		}
+		if len(msg) > 200 {
+			msg = msg[:200]
+		}
+		v.err = fmt.Errorf("%v (%s)", err, msg)
+	} else {
+		for _, line := range strings.Split(string(out), "\n") {
+			if rest, ok := strings.CutPrefix(line, "SCHEMA "); ok {
+				v.schema = []byte(rest)
+			}
+		}
+		if v.schema == nil {
+			v.err = fmt.Errorf("the child printed no schema")
+		}
+	}
+	hzChildVerdicts[key] = v
+	return v
+}
+
+// TestHegelDoNotReferenceTerminates: ReflectFromType with DoNotReference of a type holding
+// the recursive HZNode returns (and in a child process, since the package reflects the type
+// without end until the stack overflows, a fatal error: invopop-jsonschema/13).
+// HEGEL_NO_KNOWN=1 reflects the same shapes around the non-recursive HZInner, which must
+// return the model's schema.
+func TestHegelDoNotReferenceTerminates(t *testing.T) {
+	if enc := os.Getenv("HZ_RECURSIVE_CASE"); enc != "" {
+		// The child: a small stack cap makes the overflow quick.
+		debug.SetMaxStack(16 << 20)
+		c := hzDecodeRecursiveCase(enc)
+		s := c.o.reflector().ReflectFromType(c.typ().hzReflectType())
+		b, err := json.Marshal(s)
+		if err != nil {
+			fmt.Println("marshalling the schema:", err)
+			os.Exit(3)
+		}
+		fmt.Println("SCHEMA " + string(b))
+		return
+	}
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hzRecursiveCases)
+		v := hzReflectInChild(c)
+		shapes := hzShapesOf("invopop-jsonschema/13", nil)
+		if v.err != nil {
+			col.mismatch(ht, shapes, "child", "type %s, options %s: ReflectFromType did not return: %v", c.typ(), c.o, v.err)
+			return
+		}
+		if hzMentionsNodeDeep(c.typ()) {
+			col.count("returned on a recursive type, not modelled")
+			return
+		}
+		got := hzNormalizeJSON(v.schema)
+		want := hzNormalize(hzModelSchema(c.o, c.typ()))
+		if !reflect.DeepEqual(got, want) {
+			g, _ := json.Marshal(got)
+			w, _ := json.Marshal(want)
+			col.mismatch(ht, shapes, "schema", "type %s, options %s:\n got  %s\n want %s", c.typ(), c.o, g, w)
+		}
+		col.count("returned the model's schema")
+	})
+}
+
+// hzMentionsNodeDeep reports whether HZNode is anywhere in the type.
+func hzMentionsNodeDeep(t *hzType) bool {
+	switch t.kind {
+	case "named":
+		return t.name == "HZNode"
+	case "ptr", "slice", "array", "map":
+		return hzMentionsNodeDeep(t.elem)
+	case "struct":
+		for _, f := range t.fields {
+			if hzMentionsNodeDeep(f.typ) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- invopop-jsonschema/14
+
+// TestHegelNullableAcceptsNull: a nullable field of any or json.RawMessage accepts null (as
+// it did without the tag); the package wraps the schema in oneOf [true, null], under which
+// null is valid twice and so rejected (invopop-jsonschema/14). HEGEL_NO_KNOWN=1 puts nullable
+// on a pointer field to a typed leaf (a pointer to any has the shape too), where oneOf is
+// right.
+func TestHegelNullableAcceptsNull(t *testing.T) {
+	typed := hegel.Filter(hzLeaves, func(t *hzType) bool { return t.kind != "any" && t.kind != "raw" })
+	types := hzShaped(hegel.Map(hzPick("any", "raw"), hzKind), hegel.Map(typed, hzPtrTo))
+	tags := hzKeyTagsOf(hzPick("n", ""))
+	fields := hegel.Composite(func(tc hegel.TestCase) hzField {
+		typ := hegel.Draw(tc, types)
+		kw := hegel.Draw(tc, hzGenericKw[1])
+		kw.nullable = true
+		return hzField{typ: typ, json: hegel.Draw(tc, tags), kw: kw}
+	})
+	hzNarrow(t, "invopop-jsonschema/14", hzOptions, hzAround(hzOne(fields)))
+}
