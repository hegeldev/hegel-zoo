+
+// --------------------------------------------------------------------------- type records
+
+// hzType is a generated Go type. kind is one of the scalar kinds (bool, int, int8, int16,
+// int32, int64, uint, uint8, uint16, uint32, uint64, float32, float64, string), "any", "time"
+// (time.Time), "ip" (net.IP), "url" (url.URL), "raw" (json.RawMessage), "bytes" ([]byte),
+// "slice", "array", "map", "ptr", "struct" (an anonymous struct) or "named". A drawn type is
+// never changed in place: the generators share the leaves.
+type hzType struct {
+	kind   string
+	elem   *hzType
+	key    string // map key kind: string, int, uint
+	n      int    // array length
+	fields []hzField
+	name   string // named types
+}
+
+// hzField is a field of a generated struct: its Go name (set by its position: F<i>, f<i> when
+// unexported, the type's name when embedded), its type, its json tag record, its jsonschema
+// keyword record, its jsonschema_description text and its jsonschema_extras items.
+type hzField struct {
+	name       string
+	typ        *hzType
+	embedded   bool
+	unexported bool
+	json       hzJSONTag
+	kw         hzKeywords
+	desc       string
+	extras     []string
+}
+
+// hzJSONTag is the json struct tag as data: absent, the tag "-" (drop), or a key (the Go name
+// when empty; "-" names the key "-", written "-,") with options.
+type hzJSONTag struct {
+	present   bool
+	drop      bool
+	name      string
+	omitempty bool
+	omitzero  bool
+	str       bool
+	inline    bool
+}
+
+// text renders the tag's value.
+func (j hzJSONTag) text() string {
+	if j.drop {
+		return "-"
+	}
+	var opts []string
+	if j.omitempty {
+		opts = append(opts, "omitempty")
+	}
+	if j.omitzero {
+		opts = append(opts, "omitzero")
+	}
+	if j.str {
+		opts = append(opts, "string")
+	}
+	if j.inline {
+		opts = append(opts, "inline")
+	}
+	if len(opts) == 0 {
+		if j.name == "-" {
+			return "-,"
+		}
+		return j.name
+	}
+	return j.name + "," + strings.Join(opts, ",")
+}
+
+// key is the name the tag gives the field, or "" for the Go name.
+func (j hzJSONTag) key() string {
+	if !j.present || j.drop {
+		return ""
+	}
+	return j.name
+}
+
+// hzKeywords is the jsonschema struct tag as data: the generic keywords and the type-specific
+// ones of the field's schema type (or of an array's items), rendered by render() in the order
+// the tag is written.
+type hzKeywords struct {
+	required    bool
+	nullable    bool
+	title       string
+	description string
+	arr         hzArrayKw
+	num         hzNumberKw
+	str         hzStringKw
+	boolDefault string
+}
+
+// hzArrayKw are the array keywords: minItems, maxItems, the uniqueItems item as written
+// ("uniqueItems", "uniqueItems=true" or "uniqueItems=false"), and the default= values.
+type hzArrayKw struct {
+	minItems string
+	maxItems string
+	unique   string
+	defaults []string
+}
+
+// hzNumberKw are the numeric keywords (of a field or of an array's items).
+type hzNumberKw struct {
+	minimum    string
+	maximum    string
+	multipleOf string
+	enum       []string
+	dflt       string
+	example    string
+}
+
+// hzStringKw are the string keywords (of a field or of an array's items); access is the
+// readOnly/writeOnly item as written.
+type hzStringKw struct {
+	minLength string
+	maxLength string
+	pattern   string
+	enum      []string
+	dflt      string
+	example   string
+	access    string
+}
+
+// render is the jsonschema tag's items.
+func (k hzKeywords) render() []string {
+	var tags []string
+	add := func(key, v string) {
+		if v != "" {
+			tags = append(tags, key+"="+v)
+		}
+	}
+	if k.required {
+		tags = append(tags, "required")
+	}
+	if k.nullable {
+		tags = append(tags, "nullable")
+	}
+	add("title", k.title)
+	add("description", k.description)
+	add("minItems", k.arr.minItems)
+	add("maxItems", k.arr.maxItems)
+	if k.arr.unique != "" {
+		tags = append(tags, k.arr.unique)
+	}
+	for _, d := range k.arr.defaults {
+		add("default", d)
+	}
+	add("minimum", k.num.minimum)
+	add("maximum", k.num.maximum)
+	add("multipleOf", k.num.multipleOf)
+	for _, e := range k.num.enum {
+		add("enum", e)
+	}
+	add("default", k.num.dflt)
+	add("example", k.num.example)
+	add("minLength", k.str.minLength)
+	add("maxLength", k.str.maxLength)
+	add("pattern", k.str.pattern)
+	for _, e := range k.str.enum {
+		add("enum", e)
+	}
+	add("default", k.str.dflt)
+	add("example", k.str.example)
+	if k.str.access != "" {
+		tags = append(tags, k.str.access)
+	}
+	add("default", k.boolDefault)
+	return tags
+}
+
+// hzJSONName is the key encoding/json writes for the field (its tag name or Go name).
+func (f hzField) hzJSONName() string {
+	if k := f.json.key(); k != "" {
+		return k
+	}
+	return f.name
+}
+
+// jsTags is the jsonschema tag's items.
+func (f hzField) jsTags() []string { return f.kw.render() }
+
+// hzJSTag is the value of the keyword name in the jsonschema tag.
+func (f hzField) hzJSTag(name string) (string, bool) {
+	for _, t := range f.jsTags() {
+		if k, v, ok := strings.Cut(t, "="); ok && k == name {
+			return v, true
+		}
+	}
+	return "", false
+}
+
+// hzQuoted reports whether encoding/json writes the field as a JSON string of its value: the
+// ",string" option on a string, number or boolean type, or on a pointer to one (one level: the
+// option is ignored on a pointer to a pointer, which the package does not know -
+// candidate/invopop-jsonschema-15).
+func (f hzField) hzQuoted() bool {
+	if !f.json.str {
+		return false
+	}
+	t := f.typ
+	if t.kind == "ptr" {
+		t = t.elem
+	}
+	switch t.hzResolve().hzSchemaKind() {
+	case "integer", "number", "boolean", "string":
+		return t.kind != "ptr" && t.kind != "time" && t.kind != "ip" && t.kind != "url" && t.kind != "bytes" && t.kind != "slice"
+	}
+	return false
+}
+
+// hzResolve follows named types to their description.
+func (t *hzType) hzResolve() *hzType {
+	if t.kind == "named" {
+		return hzNamedDesc[t.name]
+	}
+	return t
+}
+
+// hzBase is the type under its pointers.
+func (t *hzType) hzBase() *hzType {
+	for t.kind == "ptr" {
+		t = t.elem
+	}
+	return t
+}
+
+// hzReflectType builds the reflect.Type.
+func (t *hzType) hzReflectType() reflect.Type {
+	switch t.kind {
+	case "bool":
+		return reflect.TypeOf(false)
+	case "int":
+		return reflect.TypeOf(int(0))
+	case "int8":
+		return reflect.TypeOf(int8(0))
+	case "int16":
+		return reflect.TypeOf(int16(0))
+	case "int32":
+		return reflect.TypeOf(int32(0))
+	case "int64":
+		return reflect.TypeOf(int64(0))
+	case "uint":
+		return reflect.TypeOf(uint(0))
+	case "uint8":
+		return reflect.TypeOf(uint8(0))
+	case "uint16":
+		return reflect.TypeOf(uint16(0))
+	case "uint32":
+		return reflect.TypeOf(uint32(0))
+	case "uint64":
+		return reflect.TypeOf(uint64(0))
+	case "float32":
+		return reflect.TypeOf(float32(0))
+	case "float64":
+		return reflect.TypeOf(float64(0))
+	case "string":
+		return reflect.TypeOf("")
+	case "any":
+		return reflect.TypeOf((*any)(nil)).Elem()
+	case "time":
+		return reflect.TypeOf(time.Time{})
+	case "ip":
+		return reflect.TypeOf(net.IP{})
+	case "url":
+		return reflect.TypeOf(url.URL{})
+	case "raw":
+		return reflect.TypeOf(json.RawMessage{})
+	case "bytes":
+		return reflect.TypeOf([]byte{})
+	case "slice":
+		return reflect.SliceOf(t.elem.hzReflectType())
+	case "array":
+		return reflect.ArrayOf(t.n, t.elem.hzReflectType())
+	case "map":
+		var k reflect.Type
+		switch t.key {
+		case "string":
+			k = reflect.TypeOf("")
+		case "int":
+			k = reflect.TypeOf(int(0))
+		case "uint":
+			k = reflect.TypeOf(uint(0))
+		}
+		return reflect.MapOf(k, t.elem.hzReflectType())
+	case "ptr":
+		return reflect.PointerTo(t.elem.hzReflectType())
+	case "named":
+		return hzNamedTypes[t.name]
+	case "struct":
+		fields := make([]reflect.StructField, 0, len(t.fields))
+		for _, f := range t.fields {
+			sf := reflect.StructField{Name: f.name, Type: f.typ.hzReflectType(), Anonymous: f.embedded, Tag: f.hzStructTag()}
+			if f.unexported {
+				sf.PkgPath = hzPkgPath
+			}
+			fields = append(fields, sf)
+		}
+		return reflect.StructOf(fields)
+	}
+	panic("hzReflectType: " + t.kind)
+}
+
+// hzStructTag renders the field's struct tag from its records.
+func (f hzField) hzStructTag() reflect.StructTag {
+	var parts []string
+	if f.json.present {
+		parts = append(parts, "json:"+strconv.Quote(f.json.text()))
+	}
+	if tags := f.jsTags(); len(tags) > 0 {
+		parts = append(parts, "jsonschema:"+strconv.Quote(strings.Join(tags, ",")))
+	}
+	if f.desc != "" {
+		parts = append(parts, "jsonschema_description:"+strconv.Quote(f.desc))
+	}
+	if len(f.extras) > 0 {
+		parts = append(parts, "jsonschema_extras:"+strconv.Quote(strings.Join(f.extras, ",")))
+	}
+	return reflect.StructTag(strings.Join(parts, " "))
+}
+
+// String renders the type like Go source (fields with their tags).
+func (t *hzType) String() string {
+	switch t.kind {
+	case "slice":
+		return "[]" + t.elem.String()
+	case "array":
+		return fmt.Sprintf("[%d]%s", t.n, t.elem)
+	case "map":
+		return "map[" + t.key + "]" + t.elem.String()
+	case "ptr":
+		return "*" + t.elem.String()
+	case "named":
+		return t.name
+	case "time":
+		return "time.Time"
+	case "ip":
+		return "net.IP"
+	case "url":
+		return "url.URL"
+	case "raw":
+		return "json.RawMessage"
+	case "bytes":
+		return "[]byte"
+	case "struct":
+		var b strings.Builder
+		b.WriteString("struct{")
+		for i, f := range t.fields {
+			if i > 0 {
+				b.WriteString("; ")
+			}
+			if !f.embedded {
+				b.WriteString(f.name + " ")
+			}
+			b.WriteString(f.typ.String())
+			if tag := f.hzStructTag(); tag != "" {
+				b.WriteString(" `" + string(tag) + "`")
+			}
+		}
+		b.WriteString("}")
+		return b.String()
+	}
+	return t.kind
+}
+
+// hzSchemaKind is the JSON Schema type the package gives a Go type ("" for any, raw and
+// named types reached through a $ref).
+func (t *hzType) hzSchemaKind() string {
+	switch t.kind {
+	case "bool":
+		return "boolean"
+	case "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64":
+		return "integer"
+	case "float32", "float64":
+		return "number"
+	case "string", "time", "ip", "url", "bytes":
+		return "string"
+	case "slice":
+		if t.elem.kind == "uint8" {
+			return "string" // base64
+		}
+		return "array"
+	case "array":
+		return "array"
+	case "map", "struct":
+		return "object"
+	case "ptr":
+		return t.elem.hzSchemaKind()
+	case "named":
+		if hzNamedDesc[t.name].kind == "int" {
+			return "integer"
+		}
+		return "" // a $ref
+	}
+	return ""
+}
+
+// hzIsNamedSlice reports a field type that is a named slice (a $ref whose definition is an
+// array).
+func (t *hzType) hzIsNamedSlice() bool {
+	return t.kind == "named" && hzNamedDesc[t.name].kind == "slice"
+}
+
+// hzPromotes reports an embedded field whose fields encoding/json promotes: an untagged (or
+// nameless-tagged) struct or pointer to struct.
+func (f hzField) hzPromotes() bool {
+	return f.embedded && f.json.key() == "" && !f.json.drop && f.typ.hzBase().hzResolve().kind == "struct"
+}
+
+// --------------------------------------------------------------------------- known shapes
+
+// hzKnown names the recorded bugs (bugs.toml) by the shape of a case. The generators draw every
+// shape by default, so a mismatch on one fails naming the bug (the rules were the switches of
+// the old model, which reproduced the bugs; the model now states the documented behaviour);
+// under HEGEL_NO_KNOWN=1 the shapes are not drawn, and a mismatch the rules still explain is a
+// shape that leaked through the generator.
+type hzKnown struct{}
+
+// HZKnown is the classifier.
+var HZKnown hzKnown
+
+// explains is every recorded bug whose shape the type and options have.
+func (hzKnown) explains(t *hzType, o hzRefOpts) []string {
+	w := &hzShapeWalk{o: o, seen: map[string]bool{}}
+	root := t.hzBase()
+	if o.expanded && root.kind == "named" && root.name == "HZNode" {
+		w.has("invopop-jsonschema/12") // expandedDanglingRef
+	}
+	w.walk(t)
+	return w.shapes
+}
+
+type hzShapeWalk struct {
+	o      hzRefOpts
+	seen   map[string]bool
+	shapes []string
+}
+
+func (w *hzShapeWalk) has(id string) {
+	for _, s := range w.shapes {
+		if s == id {
+			return
+		}
+	}
+	w.shapes = append(w.shapes, id)
+}
+
+func (w *hzShapeWalk) walk(t *hzType) {
+	switch t.kind {
+	case "url":
+		w.has("invopop-jsonschema/1") // urlIsString
+	case "ip":
+		w.has("invopop-jsonschema/9") // ipAlwaysV4
+	case "map":
+		if t.key == "int" {
+			w.has("invopop-jsonschema/2") // intKeysNonNegative
+		}
+		w.walk(t.elem)
+	case "slice", "array", "ptr":
+		w.walk(t.elem)
+	case "named":
+		if w.seen[t.name] {
+			return
+		}
+		w.seen[t.name] = true
+		w.walk(hzNamedDesc[t.name])
+	case "struct":
+		w.walkStruct(t)
+	}
+}
+
+func (w *hzShapeWalk) walkStruct(t *hzType) {
+	promoted := false
+	for _, f := range t.fields {
+		if f.hzPromotes() && !f.json.inline {
+			promoted = true
+		}
+	}
+	for _, f := range t.fields {
+		w.walk(f.typ)
+		if f.json.drop {
+			continue
+		}
+		if f.json.name == "-" {
+			w.has("invopop-jsonschema/3") // dashNameIgnored
+		}
+		if f.json.inline {
+			w.has("invopop-jsonschema/5") // inlineOptionEmbeds
+		}
+		if f.embedded && f.unexported && f.typ.hzBase().hzResolve().kind != "struct" {
+			w.has("invopop-jsonschema/6") // an unexported embedded non-struct type is a property
+		}
+		if f.embedded || f.unexported {
+			continue
+		}
+		if f.json.str && !f.hzQuoted() && f.typ.kind == "ptr" && f.typ.elem.kind == "ptr" {
+			switch f.typ.hzBase().hzResolve().hzSchemaKind() {
+			case "integer", "number", "boolean":
+				// The package types a ",string" pointer-to-pointer number or boolean as a string;
+				// encoding/json writes the value bare. Not a recorded bug: counted, not judged.
+				w.has("candidate/invopop-jsonschema-15")
+			}
+		}
+		if promoted && (f.hzJSONName() == "a" || f.hzJSONName() == "b") {
+			w.has("invopop-jsonschema/4") // sameKeyOverwrites
+		}
+		if f.kw.nullable {
+			if b := f.typ.hzBase(); b.kind == "any" || b.kind == "raw" {
+				w.has("invopop-jsonschema/14") // nullableOneOfRejectsNull
+			}
+		}
+		for _, e := range f.extras {
+			if strings.HasPrefix(e, "maximum=") {
+				w.has("invopop-jsonschema/8") // extrasMaximumString
+			}
+		}
+		// An array schema in the property (a named slice's is inlined under DoNotReference)
+		// gets the array keywords; a default= among the items' keywords is the array's too.
+		if f.typ.hzSchemaKind() == "array" || (f.typ.hzIsNamedSlice() && w.o.doNotReference) {
+			if f.kw.arr.unique == "uniqueItems=false" {
+				w.has("invopop-jsonschema/7") // uniqueItemsAlwaysTrue
+			}
+			if len(f.kw.arr.defaults) > 0 || f.kw.num.dflt != "" || f.kw.boolDefault != "" {
+				switch f.typ.hzResolve().elem.hzBase().hzSchemaKind() {
+				case "integer", "number", "boolean":
+					w.has("invopop-jsonschema/11") // arrayDefaultsAreStrings
+				}
+			}
+		}
+		if f.typ.hzIsNamedSlice() && !w.o.doNotReference {
+			a := f.kw.arr
+			if a.minItems != "" || a.maxItems != "" || a.unique != "" || len(a.defaults) > 0 {
+				w.has("invopop-jsonschema/10") // refTagsDropped
+			}
+		}
+	}
+}
