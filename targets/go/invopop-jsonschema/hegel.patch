+package hegel
+
+// Hegel property tests for invopop/jsonschema, written for the Hegel zoo. See
+// targets/go/invopop-jsonschema/README.md. They live in a package of their own (hegel/) and
+// drive the public API: Reflector.ReflectFromType/Reflect on generated Go types (reflect.StructOf
+// structs over scalars, slices, arrays, maps, pointers, the special types and a pool of named
+// types) with generated json/jsonschema/jsonschema_extras/jsonschema_description tags and
+// Reflector options.
+//
+// Oracles: a model of the reflection (the package's documented mapping of Go types and tags to
+// JSON Schema 2020-12, with encoding/json's field rules for names, embedding and omission), and
+// python-jsonschema validating values marshalled by encoding/json against the generated schema:
+// a schema must accept the JSON of every value of its type.
+//
+// A type is a record (hzType, hzField with its json tag record, keyword record and extras) drawn
+// by the package-level generators of hegel_zoo_gen_test.go and rendered to a reflect.Type and
+// its struct tags by pure functions; a value of a type is a generator derived from the record
+// (hegel_zoo_props_test.go). The shapes of the recorded bugs (bugs.toml) are drawn by default as
+// explicit alternatives, so a disagreement with the model or the oracle fails naming the bug
+// whose shape the case has (HZKnown.explains); under HEGEL_NO_KNOWN=1 (hzNoKnown, read once)
+// those alternatives have weight zero and both wide properties must pass against the model,
+// which states the documented behaviour.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/url"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+// hzNoKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs, read once. By default the generators
+// draw the bugs' shapes as explicit alternatives and a disagreement on one fails naming the bug
+// (the wide properties are then expected failures mapped to the bugs they find, beside the
+// pins); under HEGEL_NO_KNOWN=1 those alternatives have weight zero (hzUnless) and a
+// disagreement HZKnown still explains is a shape that leaked through the generator: counted,
+// and the case ends.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		t.Logf("COUNT %s: %s", c.name, strings.Join(parts, " "))
+		if !hzCollecting {
+			return
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch is a disagreement between the package and the model or the oracle on a case whose
+// known shapes (HZKnown.explains) are named: by default it fails naming the bugs; under
+// HEGEL_NO_KNOWN=1 a case with a known shape has leaked through the generator, so it is counted
+// and the case ends. Without a shape it is a plain failure.
+func (c *hzCollector) mismatch(ht *hegel.T, shapes []string, class string, format string, args ...any) {
+	for _, s := range shapes {
+		if strings.HasPrefix(s, "candidate/") {
+			// A shape reproduced but not yet recorded (see HZKnown): counted, and the case ends.
+			c.count("not judged: " + s)
+			ht.Assume(false)
+		}
+	}
+	if len(shapes) == 0 {
+		class += " (no known shape)"
+	} else {
+		for _, s := range shapes {
+			c.count("shape " + s)
+		}
+		if hzNoKnown {
+			c.count("leaked shape " + strings.Join(shapes, "+"))
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.failClass(ht, class, format, args...)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzWeighted generates from one of the choices with probability proportional to its weight
+// (a weight of zero is never drawn); it shrinks towards the first choice, so the plainest
+// alternative comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzUnless is the weight w, or zero when off: the alternative of a known shape is drawn with
+// hzUnless(hzNoKnown, w).
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzChance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die).
+func hzChance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzChoice[T]{100 - pct, hegel.Just(zero)}, hzChoice[T]{pct, g})
+}
+
+// hzPick is one of a small table (the first is the shrink target).
+func hzPick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzMany is a list of lo to hi elements, its count drawn first (hegel-go's Lists with a
+// MaxSize alone almost never draws the empty list).
+func hzMany[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hegel.Integers(lo, hi), func(n int) hegel.Generator[[]T] {
+		return hzExactly(g, n)
+	})
+}
+
+// hzExactly is a list of exactly n elements (an empty, non-nil slice for none).
+func hzExactly[T any](g hegel.Generator[T], n int) hegel.Generator[[]T] {
+	if n == 0 {
+		return hegel.Just([]T{})
+	}
+	return hegel.Lists(g).MinSize(n).MaxSize(n)
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it (the narrow properties of hegel_zoo_shapes_test.go).
+func hzShaped[T any](known, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- named types
+
+// The pool of named types: they get $defs entries and $refs, and can be embedded.
+
+// HZInner is a named struct.
+type HZInner struct {
+	A int    `json:"a"`
+	B string `json:"b"`
+}
+
+// HZIDs is a named slice.
+type HZIDs []int
+
+// HZLevel is a named integer.
+type HZLevel int
+
+// hzLevel is an unexported named integer (embedded only).
+type hzLevel int
+
+// HZNode is a recursive struct.
+type HZNode struct {
+	V    int      `json:"v"`
+	Next *HZNode  `json:"next,omitempty"`
+	Kids []HZNode `json:"kids,omitempty"`
+}
+
+// HZMap is a named map.
+type HZMap map[string]int
+
+// HZRaw is a named byte slice.
+type HZRaw []byte
+
+// The family of declared types for invopop-jsonschema/6 (reflect.StructOf cannot embed an
+// unexported type): each embeds the unexported hzLevel among other fields, and its sibling
+// HZExported* embeds the exported HZLevel at the same place, the neighbouring region.
+type (
+	HZUnexportedA struct {
+		hzLevel
+		Y int `json:"y"`
+	}
+	HZUnexportedB struct {
+		X string `json:"x,omitempty"`
+		hzLevel
+	}
+	HZUnexportedC struct {
+		hzLevel
+		L []int   `json:"l"`
+		I HZInner `json:"i"`
+		Z bool    `json:"z,omitempty"`
+	}
+	HZUnexportedD struct {
+		M map[string]int `json:"m"`
+		hzLevel
+		P *float64 `json:"p"`
+	}
+	HZExportedA struct {
+		HZLevel
+		Y int `json:"y"`
+	}
+	HZExportedB struct {
+		X string `json:"x,omitempty"`
+		HZLevel
+	}
+	HZExportedC struct {
+		HZLevel
+		L []int   `json:"l"`
+		I HZInner `json:"i"`
+		Z bool    `json:"z,omitempty"`
+	}
+	HZExportedD struct {
+		M map[string]int `json:"m"`
+		HZLevel
+		P *float64 `json:"p"`
+	}
+)
+
+const hzPkgPath = "github.com/invopop/jsonschema/hegel"
+
+var hzNamedTypes = map[string]reflect.Type{
+	"HZInner":       reflect.TypeOf(HZInner{}),
+	"HZIDs":         reflect.TypeOf(HZIDs{}),
+	"HZLevel":       reflect.TypeOf(HZLevel(0)),
+	"hzLevel":       reflect.TypeOf(hzLevel(0)),
+	"HZNode":        reflect.TypeOf(HZNode{}),
+	"HZMap":         reflect.TypeOf(HZMap{}),
+	"HZRaw":         reflect.TypeOf(HZRaw{}),
+	"HZUnexportedA": reflect.TypeOf(HZUnexportedA{}),
+	"HZUnexportedB": reflect.TypeOf(HZUnexportedB{}),
+	"HZUnexportedC": reflect.TypeOf(HZUnexportedC{}),
+	"HZUnexportedD": reflect.TypeOf(HZUnexportedD{}),
+	"HZExportedA":   reflect.TypeOf(HZExportedA{}),
+	"HZExportedB":   reflect.TypeOf(HZExportedB{}),
+	"HZExportedC":   reflect.TypeOf(HZExportedC{}),
+	"HZExportedD":   reflect.TypeOf(HZExportedD{}),
+}
+
+// hzTagged is a declared field with a json tag of that name and options.
+func hzTagged(name, typ string, t *hzType, opts ...string) hzField {
+	f := hzField{name: name, typ: t, json: hzJSONTag{present: true, name: typ}}
+	for _, o := range opts {
+		switch o {
+		case "omitempty":
+			f.json.omitempty = true
+		case "omitzero":
+			f.json.omitzero = true
+		}
+	}
+	return f
+}
+
+// hzEmbeds is a declared embedded field of a named type.
+func hzEmbeds(name string, unexported bool) hzField {
+	return hzField{name: name, typ: hzNamed(name), embedded: true, unexported: unexported}
+}
+
+func hzKind(kind string) *hzType  { return &hzType{kind: kind} }
+func hzNamed(name string) *hzType { return &hzType{kind: "named", name: name} }
+
+// hzNamedDesc describes the named types for the model.
+var hzNamedDesc = map[string]*hzType{
+	"HZInner": {kind: "struct", fields: []hzField{
+		hzTagged("A", "a", hzKind("int")),
+		hzTagged("B", "b", hzKind("string")),
+	}},
+	"HZIDs":   {kind: "slice", elem: hzKind("int")},
+	"HZLevel": {kind: "int"},
+	"hzLevel": {kind: "int"},
+	"HZNode": {kind: "struct", fields: []hzField{
+		hzTagged("V", "v", hzKind("int")),
+		hzTagged("Next", "next", &hzType{kind: "ptr", elem: hzNamed("HZNode")}, "omitempty"),
+		hzTagged("Kids", "kids", &hzType{kind: "slice", elem: hzNamed("HZNode")}, "omitempty"),
+	}},
+	"HZMap": {kind: "map", key: "string", elem: hzKind("int")},
+	"HZRaw": {kind: "bytes"},
+	"HZUnexportedA": {kind: "struct", fields: []hzField{
+		hzEmbeds("hzLevel", true),
+		hzTagged("Y", "y", hzKind("int")),
+	}},
+	"HZUnexportedB": {kind: "struct", fields: []hzField{
+		hzTagged("X", "x", hzKind("string"), "omitempty"),
+		hzEmbeds("hzLevel", true),
+	}},
+	"HZUnexportedC": {kind: "struct", fields: []hzField{
+		hzEmbeds("hzLevel", true),
+		hzTagged("L", "l", &hzType{kind: "slice", elem: hzKind("int")}),
+		hzTagged("I", "i", hzNamed("HZInner")),
+		hzTagged("Z", "z", hzKind("bool"), "omitempty"),
+	}},
+	"HZUnexportedD": {kind: "struct", fields: []hzField{
+		hzTagged("M", "m", &hzType{kind: "map", key: "string", elem: hzKind("int")}),
+		hzEmbeds("hzLevel", true),
+		hzTagged("P", "p", &hzType{kind: "ptr", elem: hzKind("float64")}),
+	}},
+	"HZExportedA": {kind: "struct", fields: []hzField{
+		hzEmbeds("HZLevel", false),
+		hzTagged("Y", "y", hzKind("int")),
+	}},
+	"HZExportedB": {kind: "struct", fields: []hzField{
+		hzTagged("X", "x", hzKind("string"), "omitempty"),
+		hzEmbeds("HZLevel", false),
+	}},
+	"HZExportedC": {kind: "struct", fields: []hzField{
+		hzEmbeds("HZLevel", false),
+		hzTagged("L", "l", &hzType{kind: "slice", elem: hzKind("int")}),
+		hzTagged("I", "i", hzNamed("HZInner")),
+		hzTagged("Z", "z", hzKind("bool"), "omitempty"),
+	}},
+	"HZExportedD": {kind: "struct", fields: []hzField{
+		hzTagged("M", "m", &hzType{kind: "map", key: "string", elem: hzKind("int")}),
+		hzEmbeds("HZLevel", false),
+		hzTagged("P", "p", &hzType{kind: "ptr", elem: hzKind("float64")}),
