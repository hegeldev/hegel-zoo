+package hegel
+
+// Hegel property tests for invopop/jsonschema, written for the Hegel zoo. See
+// targets/go/invopop-jsonschema/README.md. They live in a package of their own (hegel/) and
+// drive the public API: Reflector.ReflectFromType/Reflect on generated Go types (reflect.StructOf
+// structs over scalars, slices, arrays, maps, pointers, the special types and a pool of named
+// types) with generated json/jsonschema/jsonschema_extras/jsonschema_description tags and
+// Reflector options.
+//
+// Oracles: a model of the reflection (the package's documented mapping of Go types and tags to
+// JSON Schema 2020-12, with encoding/json's field rules for names, embedding and omission), and
+// python-jsonschema validating values marshalled by encoding/json against the generated schema:
+// a schema must accept the JSON of every value of its type.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/url"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on; the pins assert the documented behaviour and fail while
+// the bug exists.
+var HZKnown = struct {
+	urlIsString              bool // url.URL is a string with format uri, while encoding/json writes it as an object
+	intKeysNonNegative       bool // map[int*] keys must match ^[0-9]+$, so negative keys are rejected
+	dashNameIgnored          bool // a field tagged json:"-," (the key "-") is left out of the schema
+	sameKeyOverwrites        bool // a later field with the same key replaces an earlier one, as an embedded struct's field does to an outer field (encoding/json: the shallower field wins, then the tagged one)
+	inlineOptionEmbeds       bool // json:"name,inline" inlines the struct, while encoding/json knows no inline option and writes the key
+	uniqueItemsAlwaysTrue    bool // uniqueItems=false sets uniqueItems true
+	extrasMaximumString      bool // jsonschema_extras parses minimum as a number but maximum as a string (an invalid schema)
+	ipAlwaysV4               bool // net.IP has format ipv4 whatever the address, so IPv6 addresses are rejected under format checking
+	refTagsDropped           bool // type-specific tags (minItems, uniqueItems, ...) on a field of a named slice type are dropped with the $ref
+	arrayDefaultsAreStrings  bool // default= on an array field is a list of strings whatever the items type
+	expandedDanglingRef      bool // ExpandedStruct moves a recursive root out of $defs and leaves the inner $ref pointing at the removed definition
+	nullableOneOfRejectsNull bool // nullable wraps the schema in oneOf [schema, null], so a field whose schema already accepts null (any, json.RawMessage) rejects null
+}{true, true, true, true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- named types
+
+// The pool of named types: they get $defs entries and $refs, and can be embedded.
+
+// HZInner is a named struct.
+type HZInner struct {
+	A int    `json:"a"`
+	B string `json:"b"`
+}
+
+// HZIDs is a named slice.
+type HZIDs []int
+
+// HZLevel is a named integer.
+type HZLevel int
+
+// hzLevel is an unexported named integer (embedded only).
+type hzLevel int
+
+// HZNode is a recursive struct.
+type HZNode struct {
+	V    int      `json:"v"`
+	Next *HZNode  `json:"next,omitempty"`
+	Kids []HZNode `json:"kids,omitempty"`
+}
+
+// HZMap is a named map.
+type HZMap map[string]int
+
+// HZRaw is a named byte slice.
+type HZRaw []byte
+
+const hzPkgPath = "github.com/invopop/jsonschema/hegel"
+
+var hzNamedTypes = map[string]reflect.Type{
+	"HZInner": reflect.TypeOf(HZInner{}),
+	"HZIDs":   reflect.TypeOf(HZIDs{}),
+	"HZLevel": reflect.TypeOf(HZLevel(0)),
+	"hzLevel": reflect.TypeOf(hzLevel(0)),
+	"HZNode":  reflect.TypeOf(HZNode{}),
+	"HZMap":   reflect.TypeOf(HZMap{}),
+	"HZRaw":   reflect.TypeOf(HZRaw{}),
+}
+
+// hzNamedDesc describes the named types for the model.
+var hzNamedDesc = map[string]*hzType{
+	"HZInner": {kind: "struct", fields: []hzField{
+		{name: "A", typ: &hzType{kind: "int"}, tagJSON: "a", hasJSON: true},
+		{name: "B", typ: &hzType{kind: "string"}, tagJSON: "b", hasJSON: true},
+	}},
+	"HZIDs":   {kind: "slice", elem: &hzType{kind: "int"}},
+	"HZLevel": {kind: "int"},
+	"hzLevel": {kind: "int"},
+	"HZNode": {kind: "struct", fields: []hzField{
+		{name: "V", typ: &hzType{kind: "int"}, tagJSON: "v", hasJSON: true},
+		{name: "Next", typ: &hzType{kind: "ptr", elem: &hzType{kind: "named", name: "HZNode"}}, tagJSON: "next,omitempty", hasJSON: true},
+		{name: "Kids", typ: &hzType{kind: "slice", elem: &hzType{kind: "named", name: "HZNode"}}, tagJSON: "kids,omitempty", hasJSON: true},
+	}},
+	"HZMap": {kind: "map", key: "string", elem: &hzType{kind: "int"}},
+	"HZRaw": {kind: "bytes"},
+}
+
+// --------------------------------------------------------------------------- generated types
+
+// hzType is a generated Go type. kind is one of the scalar kinds (bool, int, int8, int16,
+// int32, int64, uint, uint8, uint16, uint32, uint64, float32, float64, string), "any", "time"
+// (time.Time), "ip" (net.IP), "url" (url.URL), "raw" (json.RawMessage), "bytes" ([]byte),
+// "slice", "array", "map", "ptr", "struct" (an anonymous struct) or "named".
+type hzType struct {
+	kind   string
+	elem   *hzType
+	key    string // map key kind: string, int, uint
+	n      int    // array length
+	fields []hzField
+	name   string // named types
+}
+
+// hzField is a field of a generated struct. tagJSON is the json tag's text (hasJSON false: no
+// json tag), tagJS the jsonschema tag's items, tagDesc the jsonschema_description tag, extras
+// the jsonschema_extras items.
+type hzField struct {
+	name       string
+	typ        *hzType
+	embedded   bool
+	unexported bool
+	hasJSON    bool
+	tagJSON    string
+	tagJS      []string
+	tagDesc    string
+	extras     []string
+}
+
+// hzJSONName is the key encoding/json writes for the field (its tag name or Go name);
+// "" for an embedded struct without a name.
+func (f hzField) hzJSONName() string {
+	if f.hasJSON {
+		parts := strings.Split(f.tagJSON, ",")
+		if parts[0] != "" {
+			return parts[0]
+		}
+	}
+	return f.name
+}
+
+func (f hzField) hzJSONOpt(opt string) bool {
+	if !f.hasJSON {
+		return false
+	}
+	parts := strings.Split(f.tagJSON, ",")
+	for _, p := range parts[1:] {
+		if p == opt {
+			return true
+		}
+	}
+	return false
+}
+
+func (f hzField) hzJSTag(name string) (string, bool) {
+	for _, t := range f.tagJS {
+		if k, v, ok := strings.Cut(t, "="); ok && k == name {
+			return v, true
+		}
+	}
+	return "", false
+}
+
+func (f hzField) hzJSFlag(name string) bool {
+	for _, t := range f.tagJS {
+		if t == name {
+			return true
+		}
+	}
+	return false
+}
+
+// hzResolve follows named types to their description.
+func (t *hzType) hzResolve() *hzType {
+	if t.kind == "named" {
+		return hzNamedDesc[t.name]
+	}
+	return t
+}
+
+// hzReflectType builds the reflect.Type.
+func (t *hzType) hzReflectType() reflect.Type {
+	switch t.kind {
+	case "bool":
+		return reflect.TypeOf(false)
+	case "int":
+		return reflect.TypeOf(int(0))
+	case "int8":
+		return reflect.TypeOf(int8(0))
+	case "int16":
+		return reflect.TypeOf(int16(0))
+	case "int32":
+		return reflect.TypeOf(int32(0))
+	case "int64":
+		return reflect.TypeOf(int64(0))
+	case "uint":
+		return reflect.TypeOf(uint(0))
+	case "uint8":
+		return reflect.TypeOf(uint8(0))
+	case "uint16":
+		return reflect.TypeOf(uint16(0))
+	case "uint32":
+		return reflect.TypeOf(uint32(0))
+	case "uint64":
+		return reflect.TypeOf(uint64(0))
+	case "float32":
+		return reflect.TypeOf(float32(0))
+	case "float64":
+		return reflect.TypeOf(float64(0))
+	case "string":
+		return reflect.TypeOf("")
+	case "any":
+		return reflect.TypeOf((*any)(nil)).Elem()
+	case "time":
+		return reflect.TypeOf(time.Time{})
+	case "ip":
+		return reflect.TypeOf(net.IP{})
+	case "url":
+		return reflect.TypeOf(url.URL{})
+	case "raw":
+		return reflect.TypeOf(json.RawMessage{})
+	case "bytes":
+		return reflect.TypeOf([]byte{})
+	case "slice":
+		return reflect.SliceOf(t.elem.hzReflectType())
+	case "array":
+		return reflect.ArrayOf(t.n, t.elem.hzReflectType())
+	case "map":
+		var k reflect.Type
+		switch t.key {
+		case "string":
+			k = reflect.TypeOf("")
+		case "int":
+			k = reflect.TypeOf(int(0))
+		case "uint":
+			k = reflect.TypeOf(uint(0))
+		}
+		return reflect.MapOf(k, t.elem.hzReflectType())
+	case "ptr":
+		return reflect.PointerTo(t.elem.hzReflectType())
+	case "named":
+		return hzNamedTypes[t.name]
+	case "struct":
+		fields := make([]reflect.StructField, 0, len(t.fields))
+		for _, f := range t.fields {
+			sf := reflect.StructField{Name: f.name, Type: f.typ.hzReflectType(), Anonymous: f.embedded, Tag: f.hzStructTag()}
+			if f.unexported {
+				sf.PkgPath = hzPkgPath
+			}
+			fields = append(fields, sf)
+		}
+		return reflect.StructOf(fields)
+	}
+	panic("hzReflectType: " + t.kind)
+}
+
+func (f hzField) hzStructTag() reflect.StructTag {
+	var parts []string
+	if f.hasJSON {
+		parts = append(parts, "json:"+strconv.Quote(f.tagJSON))
+	}
+	if len(f.tagJS) > 0 {
+		parts = append(parts, "jsonschema:"+strconv.Quote(strings.Join(f.tagJS, ",")))
+	}
+	if f.tagDesc != "" {
+		parts = append(parts, "jsonschema_description:"+strconv.Quote(f.tagDesc))
+	}
+	if len(f.extras) > 0 {
+		parts = append(parts, "jsonschema_extras:"+strconv.Quote(strings.Join(f.extras, ",")))
+	}
+	return reflect.StructTag(strings.Join(parts, " "))
+}
+
+// String renders the type like Go source (fields with their tags).
+func (t *hzType) String() string {
+	switch t.kind {
+	case "slice":
+		return "[]" + t.elem.String()
+	case "array":
+		return fmt.Sprintf("[%d]%s", t.n, t.elem)
+	case "map":
+		return "map[" + t.key + "]" + t.elem.String()
+	case "ptr":
+		return "*" + t.elem.String()
+	case "named":
+		return t.name
+	case "time":
+		return "time.Time"
+	case "ip":
+		return "net.IP"
+	case "url":
+		return "url.URL"
+	case "raw":
+		return "json.RawMessage"
+	case "bytes":
+		return "[]byte"
+	case "struct":
+		var b strings.Builder
+		b.WriteString("struct{")
+		for i, f := range t.fields {
+			if i > 0 {
+				b.WriteString("; ")
+			}
+			if !f.embedded {
+				b.WriteString(f.name + " ")
+			}
+			b.WriteString(f.typ.String())
+			if tag := f.hzStructTag(); tag != "" {
+				b.WriteString(" `" + string(tag) + "`")
+			}
+		}
+		b.WriteString("}")
+		return b.String()
+	}
+	return t.kind
+}
+
+// hzSchemaKind is the JSON Schema type the package gives a Go type ("" for any, raw and
+// named types reached through a $ref).
+func (t *hzType) hzSchemaKind() string {
+	switch t.kind {
+	case "bool":
+		return "boolean"
+	case "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64":
+		return "integer"
+	case "float32", "float64":
+		return "number"
+	case "string", "time", "ip", "url", "bytes":
+		return "string"
+	case "slice":
+		if t.elem.kind == "uint8" {
+			return "string" // base64
+		}
+		return "array"
+	case "array":
+		return "array"
+	case "map", "struct":
+		return "object"
+	case "ptr":
+		return t.elem.hzSchemaKind()
+	case "named":
+		if t.name == "HZLevel" || t.name == "hzLevel" {
+			return "integer"
+		}
+		return "" // a $ref
+	}
+	return ""
+}
+
+var hzScalarKinds = []string{"bool", "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "string"}
+
+// hzGenType draws a type; depth limits nesting. Embedded fields and the recursive HZNode are
+// drawn only where allowed.
+func hzGenType(tc hegel.TestCase, depth int, allowNode bool) *hzType {
+	n := hzDrawInt(tc, 1, 100)
+	switch {
+	case n <= 35:
+		return &hzType{kind: hzPick(tc, hzScalarKinds)}
+	case n <= 45:
+		return &hzType{kind: hzPick(tc, []string{"any", "time", "ip", "url", "raw", "bytes", "bytes"})}
+	case n <= 55:
+		names := []string{"HZInner", "HZIDs", "HZIDs", "HZLevel", "HZMap", "HZRaw"}
+		if allowNode {
+			names = append(names, "HZNode")
+		}
+		return &hzType{kind: "named", name: hzPick(tc, names)}
+	}
+	if depth <= 0 {
+		return &hzType{kind: hzPick(tc, hzScalarKinds)}
+	}
+	switch {
+	case n <= 65:
+		return &hzType{kind: "slice", elem: hzGenType(tc, depth-1, allowNode)}
+	case n <= 70:
+		return &hzType{kind: "array", n: hzDrawInt(tc, 0, 3), elem: hzGenType(tc, depth-1, allowNode)}
+	case n <= 80:
+		return &hzType{kind: "map", key: hzPick(tc, []string{"string", "string", "int", "uint"}), elem: hzGenType(tc, depth-1, allowNode)}
+	case n <= 88:
+		return &hzType{kind: "ptr", elem: hzGenType(tc, depth-1, allowNode)}
+	}
+	return hzGenStruct(tc, depth-1, allowNode)
+}
+
+// hzGenStruct draws an anonymous struct type of 0-5 fields with tags.
+func hzGenStruct(tc hegel.TestCase, depth int, allowNode bool) *hzType {
+	st := &hzType{kind: "struct"}
+	nf := hzDrawInt(tc, 0, 5)
+	usedJSON := map[string]bool{}
+	embedded := false
+	for i := 0; i < nf; i++ {
+		f := hzField{name: fmt.Sprintf("F%d", i)}
+		if !embedded && hzChance(tc, 15) {
+			// One embedded field per struct: a named struct, a pointer to one, or a named
+			// non-struct type.
+			embedded = true
+			f.embedded = true
+			// (reflect.StructOf cannot embed an unexported type, so hzLevel is pinned only.)
+			switch hzDrawInt(tc, 1, 5) {
+			case 1, 2:
+				f.name, f.typ = "HZInner", &hzType{kind: "named", name: "HZInner"}
+			case 3:
+				f.name, f.typ = "HZInner", &hzType{kind: "ptr", elem: &hzType{kind: "named", name: "HZInner"}}
+			case 4:
+				f.name, f.typ = "HZLevel", &hzType{kind: "named", name: "HZLevel"}
+			case 5:
+				f.name, f.typ = "HZIDs", &hzType{kind: "named", name: "HZIDs"}
+			}
+			if hzChance(tc, 30) {
+				f.hasJSON = true
+				f.tagJSON = hzPick(tc, []string{",omitempty", "", "in", "in,omitempty", ",inline", "in,inline"})
+			}
+			st.fields = append(st.fields, f)
+			continue
+		}
+		f.typ = hzGenType(tc, depth, allowNode)
+		if hzChance(tc, 8) {
+			f.unexported = true
+			f.name = fmt.Sprintf("f%d", i)
+		}
+		// The json tag.
+		if hzChance(tc, 80) {
+			f.hasJSON = true
+			name := ""
+			switch hzDrawInt(tc, 1, 10) {
+			case 1:
+				name = "-"
+			case 2:
+				// The same key as a field of an embedded HZInner: a conflict.
+				name = hzPick(tc, []string{"a", "b"})
+			case 3:
+				name = hzPick(tc, []string{"x y", "F0", "Name", "with-dash", "1"})
+			default:
+				name = hzPick(tc, []string{"a", "b", "c", "d", "e", "f", "g", "h"})
+			}
+			// Keys are unique within a struct (encoding/json drops both fields of a pair).
+			for name != "-" && usedJSON[name] {
+				name += "x"
+			}
+			f.tagJSON = name
+			opts := ""
+			if name == "-" {
+				// json:"-" drops the field; json:"-," and json:"-,opt" name it "-" (once per
+				// struct, or encoding/json drops both).
+				if usedJSON["-"] || hzChance(tc, 40) {
+					opts = "-"
+				} else if hzChance(tc, 50) {
+					opts = ","
+					f.tagJSON = "-,"
+				}
+			}
+			usedJSON[name] = true
+			if opts == "" {
+				switch hzDrawInt(tc, 1, 10) {
+				case 1, 2, 3:
+					f.tagJSON += ",omitempty"
+				case 4:
+					f.tagJSON += ",omitzero"
+				case 5:
+					f.tagJSON += ",string"
+				case 6:
+					f.tagJSON += ",omitempty,string"
+				case 7:
+					if k := f.typ.kind; k != "url" && k != "time" && !(k == "ptr" && (f.typ.elem.kind == "url" || f.typ.elem.kind == "time")) {
+						// (inline on url.URL would inline its own fields: not modelled.)
+						f.tagJSON += ",inline"
+					}
+				}
+			}
+		}
+		f.tagJS = hzGenJSTags(tc, f)
+		if hzChance(tc, 10) {
+			f.tagDesc = hzPick(tc, []string{"d2", "the field"})
+		}
+		if hzChance(tc, 12) {
+			f.extras = hzGenExtras(tc)
+		}
+		st.fields = append(st.fields, f)
+	}
+	return st
+}
+
+var hzPatterns = []string{`^[a-z]+$`, `^[0-9]{2}$`, `^a\,b$`, `^x*$`, `^a=b$`}
+
+// hzGenJSTags draws the jsonschema tag items for a field, fitting the schema type the field
+// gets (so that generated values can honour them).
+func hzGenJSTags(tc hegel.TestCase, f hzField) []string {
+	if hzChance(tc, 45) {
+		return nil
+	}
+	var tags []string
+	if hzChance(tc, 20) {
+		tags = append(tags, "required")
+	}
+	if hzChance(tc, 20) {
+		tags = append(tags, "nullable")
+	}
+	if hzChance(tc, 25) {
+		tags = append(tags, "title="+hzPick(tc, []string{"T", "the title", "a=b"}))
+	}
+	if hzChance(tc, 15) {
+		tags = append(tags, "description="+hzPick(tc, []string{"D", "a\\,b"}))
+	}
+	kind := f.typ.hzSchemaKind()
+	if f.hzJSONOpt("string") && (kind == "integer" || kind == "number" || kind == "boolean" || kind == "string") {
+		// The value is a JSON string of the number, boolean or string: no type keywords.
+		kind = ""
+	}
+	if f.typ.kind == "named" && f.typ.name == "HZIDs" && hzChance(tc, 50) {
+		kind = "array"
+	}
+	// The element kind of an array, for the tags that go to items.
+	var elemKind string
+	if kind == "array" && f.typ.kind != "named" {
+		elemKind = f.typ.hzResolve().elem.hzSchemaKind()
+		if f.typ.hzResolve().elem.kind == "ptr" || f.typ.hzResolve().elem.kind == "time" || f.typ.hzResolve().elem.kind == "ip" || f.typ.hzResolve().elem.kind == "url" || f.typ.hzResolve().elem.kind == "bytes" {
+			elemKind = "" // no value-shaping tags on these
+		}
+	}
+	switch kind {
+	case "integer", "number":
+		hzGenNumberTags(tc, &tags, kind == "integer")
+	case "string":
+		if f.typ.kind == "string" {
+			hzGenStringTags(tc, &tags)
+		}
+	case "boolean":
+		if hzChance(tc, 40) {
+			tags = append(tags, "default="+hzPick(tc, []string{"true", "false", "yes"}))
+		}
+	case "array":
+		if hzChance(tc, 40) {
+			tags = append(tags, "minItems="+strconv.Itoa(hzDrawInt(tc, 0, 2)))
+		}
+		if hzChance(tc, 30) {
+			tags = append(tags, "maxItems="+strconv.Itoa(hzDrawInt(tc, 2, 4)))
+		}
+		if hzChance(tc, 30) {
+			tags = append(tags, hzPick(tc, []string{"uniqueItems", "uniqueItems=true", "uniqueItems=false"}))
+		}
+		if hzChance(tc, 35) {
+			for k := hzDrawInt(tc, 1, 2); k > 0; k-- {
+				tags = append(tags, "default="+hzPick(tc, []string{"1", "x", "true"}))
+			}
+		}
+		switch elemKind {
+		case "integer", "number":
+			hzGenNumberTags(tc, &tags, elemKind == "integer")
+		case "string":
+			hzGenStringTags(tc, &tags)
+		case "boolean":
+			if hzChance(tc, 30) {
+				tags = append(tags, "default=true")
+			}
+		}
+	}
+	return tags
+}
+
+func hzGenNumberTags(tc hegel.TestCase, tags *[]string, integer bool) {
+	if hzChance(tc, 40) {
+		*tags = append(*tags, "minimum="+hzPick(tc, []string{"-3", "0", "1", "2.5", "abc"}))
+	}
+	if hzChance(tc, 30) {
+		*tags = append(*tags, "maximum="+hzPick(tc, []string{"5", "10", "1e2", "7.5"}))
+	}
+	if hzChance(tc, 15) {
+		*tags = append(*tags, "multipleOf="+hzPick(tc, []string{"2", "0.5"}))
+	}
+	if hzChance(tc, 15) {
+		for k := hzDrawInt(tc, 1, 3); k > 0; k-- {
+			*tags = append(*tags, "enum="+hzPick(tc, []string{"1", "2", "3", "4.5", "x"}))
+		}
+	}
+	if hzChance(tc, 20) {
+		*tags = append(*tags, "default="+hzPick(tc, []string{"1", "2.5", "x"}))
+	}
+	if hzChance(tc, 15) {
+		*tags = append(*tags, "example="+hzPick(tc, []string{"3", "x"}))
+	}
+	_ = integer
+}
+
+func hzGenStringTags(tc hegel.TestCase, tags *[]string) {
+	switch hzDrawInt(tc, 1, 4) {
+	case 1:
+		if hzChance(tc, 60) {
+			*tags = append(*tags, "minLength="+hzPick(tc, []string{"0", "1", "2", "-1"}))
+		}
+		if hzChance(tc, 50) {
+			*tags = append(*tags, "maxLength="+hzPick(tc, []string{"3", "6", "abc"}))
+		}
+	case 2:
+		*tags = append(*tags, "pattern="+hzPick(tc, hzPatterns))
+	case 3:
+		for k := hzDrawInt(tc, 1, 3); k > 0; k-- {
+			*tags = append(*tags, "enum="+hzPick(tc, []string{"red", "green", "blue", "a,b"}))
+		}
+	}
+	if hzChance(tc, 20) {
+		*tags = append(*tags, "default="+hzPick(tc, []string{"alex", "x=y"}))
+	}
+	if hzChance(tc, 15) {
+		*tags = append(*tags, "example=joe")
+	}
+	if hzChance(tc, 15) {
+		*tags = append(*tags, hzPick(tc, []string{"readOnly=true", "writeOnly=true", "readOnly=yes"}))
+	}
+}
+
+func hzGenExtras(tc hegel.TestCase) []string {
+	var out []string
+	for k := hzDrawInt(tc, 1, 3); k > 0; k-- {
+		out = append(out, hzPick(tc, []string{"a=b", "foo=bar", "foo=bar1", "x=true", "x=false", "minimum=-4", "c=t", "a=b", "foo=bar", "foo=bar1", "x=true", "x=false", "minimum=-4", "c=t", "maximum=6"}))
+	}
+	return out
+}
+
+// hzGenRoot draws the root type: mostly structs, sometimes a named type, a slice or a pointer.
+func hzGenRoot(tc hegel.TestCase, allowNode bool) *hzType {
+	switch hzDrawInt(tc, 1, 10) {
+	case 1, 2:
+		names := []string{"HZInner", "HZIDs", "HZMap", "HZRaw", "HZLevel"}
+		if allowNode {
+			names = append(names, "HZNode", "HZNode", "HZNode")
+		}
+		return &hzType{kind: "named", name: hzPick(tc, names)}
+	case 3:
+		return &hzType{kind: "ptr", elem: hzGenStruct(tc, 2, allowNode)}
+	case 4:
+		return hzGenType(tc, 2, allowNode)
+	}
+	return hzGenStruct(tc, 2, allowNode)
+}
