@@ -0,0 +1,540 @@
+package hegel
+
+// Generators: every one a package-level value built from hegel-go's combinators. A type is a
+// record (hzType) drawn from a depth-indexed tower (the leaves at level 0, each level's slices,
+// arrays, maps, pointers and structs built from the level below, memoised once per pool since a
+// self-referencing package-level generator is a Go init cycle); a struct is a list of field
+// records whose json tag, keyword tag and extras are records rendered by pure functions; the
+// Reflector options are a record; a case is the options and a root type drawn for them. The
+// plainest alternative comes first in every choice, so a minimal case is a scalar or an empty
+// struct. The twelve shapes of the recorded bugs the wide properties reach are explicit
+// alternatives at hzUnless(hzNoKnown, w) weights: by default they are drawn and the properties
+// fail naming the bug; under HEGEL_NO_KNOWN=1 they have weight zero and nothing is skipped.
+
+import (
+	"fmt"
+	"strconv"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- options
+
+// hzOptions: the Reflector options, each off first.
+var hzOptions = hegel.Composite(func(tc hegel.TestCase) hzRefOpts {
+	return hzRefOpts{
+		anonymous:        hegel.Draw(tc, hzChance(50)),
+		allowAdditional:  hegel.Draw(tc, hzChance(25)),
+		requiredFromTags: hegel.Draw(tc, hzChance(25)),
+		doNotReference:   hegel.Draw(tc, hzChance(20)),
+		expanded:         hegel.Draw(tc, hzChance(25)),
+		anchor:           hegel.Draw(tc, hzChance(25)),
+	}
+})
+
+// hzOptionsWith is hzOptions with fix applied (a narrow property's constraints on them).
+func hzOptionsWith(fix func(o hzRefOpts) hzRefOpts) hegel.Generator[hzRefOpts] {
+	return hegel.Map(hzOptions, fix)
+}
+
+// --------------------------------------------------------------------------- types
+
+var hzScalarKinds = []string{"bool", "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "string"}
+
+func hzSliceOf(e *hzType) *hzType { return &hzType{kind: "slice", elem: e} }
+func hzPtrTo(e *hzType) *hzType   { return &hzType{kind: "ptr", elem: e} }
+
+var (
+	hzScalars = hegel.Map(hegel.SampledFrom(hzScalarKinds), hzKind)
+	// hzSpecials: the standard-library types; url.URL (/1) and net.IP (/9) are known shapes.
+	hzSpecials = hzWeighted(
+		hzChoice[*hzType]{5, hegel.Map(hzPick("any", "time", "raw", "bytes", "bytes"), hzKind)},
+		hzChoice[*hzType]{hzUnless(hzNoKnown, 1), hegel.Just(hzKind("url"))},
+		hzChoice[*hzType]{hzUnless(hzNoKnown, 1), hegel.Just(hzKind("ip"))},
+	)
+	// hzMapKeys: string keys first; signed integer keys are a known shape (/2).
+	hzMapKeys = hzWeighted(
+		hzChoice[string]{3, hegel.Just("string")},
+		hzChoice[string]{1, hegel.Just("uint")},
+		hzChoice[string]{hzUnless(hzNoKnown, 1), hegel.Just("int")},
+	)
+)
+
+// hzNamedOf is a named type of the pool, the recursive HZNode only where allowed (never under
+// DoNotReference, which reflects it without end: /13, pinned in a child process).
+func hzNamedOf(allowNode bool) hegel.Generator[*hzType] {
+	names := []string{"HZInner", "HZIDs", "HZIDs", "HZLevel", "HZMap", "HZRaw"}
+	if allowNode {
+		names = append(names, "HZNode")
+	}
+	return hegel.Map(hegel.SampledFrom(names), hzNamed)
+}
+
+func hzArraysOf(elems hegel.Generator[*hzType]) hegel.Generator[*hzType] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzType {
+		return &hzType{kind: "array", n: hegel.Draw(tc, hegel.Integers(0, 3)), elem: hegel.Draw(tc, elems)}
+	})
+}
+
+func hzMapsOf(elems hegel.Generator[*hzType]) hegel.Generator[*hzType] {
+	return hegel.Composite(func(tc hegel.TestCase) *hzType {
+		return &hzType{kind: "map", key: hegel.Draw(tc, hzMapKeys), elem: hegel.Draw(tc, elems)}
+	})
+}
+
+// hzTypeTower is the types of each nesting level: the leaves (scalars, the special types, the
+// named pool) at level 0, and at each level above the containers of the level below.
+func hzTypeTower(allowNode bool) []hegel.Generator[*hzType] {
+	named := hzNamedOf(allowNode)
+	levels := []hegel.Generator[*hzType]{hzWeighted(
+		hzChoice[*hzType]{8, hzScalars},
+		hzChoice[*hzType]{1, hzSpecials},
+		hzChoice[*hzType]{1, named},
+	)}
+	for d := 1; d <= 2; d++ {
+		below := levels[d-1]
+		levels = append(levels, hzWeighted(
+			hzChoice[*hzType]{35, hzScalars},
+			hzChoice[*hzType]{10, hzSpecials},
+			hzChoice[*hzType]{10, named},
+			hzChoice[*hzType]{10, hegel.Map(below, hzSliceOf)},
+			hzChoice[*hzType]{5, hzArraysOf(below)},
+			hzChoice[*hzType]{10, hzMapsOf(below)},
+			hzChoice[*hzType]{8, hegel.Map(below, hzPtrTo)},
+			hzChoice[*hzType]{12, hzStructsOf(below)},
+		))
+	}
+	return levels
+}
+
+var hzTowers = [2][]hegel.Generator[*hzType]{hzTypeTower(false), hzTypeTower(true)}
+
+func hzIndex(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// hzTypesAt is the memoised type generator of a nesting level.
+func hzTypesAt(allowNode bool, depth int) hegel.Generator[*hzType] {
+	return hzTowers[hzIndex(allowNode)][depth]
+}
+
+// --------------------------------------------------------------------------- structs
+
+// hzStructsOf: an anonymous struct of 0-5 fields whose types come from types, with an embedded
+// field (one at most) in a drawn position.
+func hzStructsOf(types hegel.Generator[*hzType]) hegel.Generator[*hzType] {
+	fields := hzFieldsOf(types)
+	return hegel.Composite(func(tc hegel.TestCase) *hzType {
+		fs := hegel.Draw(tc, hzMany(fields, 0, 5))
+		emb := hegel.Draw(tc, hzEmbedded)
+		at := hegel.Draw(tc, hegel.Integers(0, 5))
+		return hzStruct(fs, emb, at)
+	})
+}
+
+// hzStruct is the struct of the fields with the embedded one (if any) inserted at position at,
+// taken modulo the count: the fields are named by their position (F<i>, f<i> when unexported)
+// and their JSON keys made distinct (encoding/json drops both fields of a pair at one depth; a
+// struct's own keys are distinct by construction, and the drawn key shared with an embedded
+// struct's field is the shape of /4).
+func hzStruct(fs []hzField, emb *hzField, at int) *hzType {
+	fields := make([]hzField, 0, len(fs)+1)
+	fields = append(fields, fs...)
+	if emb != nil {
+		i := at % (len(fields) + 1)
+		fields = append(fields[:i], append([]hzField{*emb}, fields[i:]...)...)
+	}
+	seen := map[string]bool{}
+	for i := range fields {
+		f := &fields[i]
+		if f.embedded {
+			continue
+		}
+		if f.unexported {
+			f.name = fmt.Sprintf("f%d", i)
+			continue
+		}
+		f.name = fmt.Sprintf("F%d", i)
+		if f.json.drop {
+			continue
+		}
+		key := f.hzJSONName()
+		for seen[key] {
+			key += "x"
+		}
+		if key != f.hzJSONName() {
+			f.json.present = true
+			f.json.name = key
+		}
+		seen[key] = true
+	}
+	return &hzType{kind: "struct", fields: fields}
+}
+
+// hzEmbedded: no embedded field most of the time; else a named struct, a pointer to one, or a
+// named non-struct type, with a json tag three times in ten (the inline option is /5).
+var (
+	hzEmbeddedTypes = hzWeighted(
+		hzChoice[*hzType]{2, hegel.Just(hzNamed("HZInner"))},
+		hzChoice[*hzType]{1, hegel.Just(hzPtrTo(hzNamed("HZInner")))},
+		hzChoice[*hzType]{1, hegel.Just(hzNamed("HZLevel"))},
+		hzChoice[*hzType]{1, hegel.Just(hzNamed("HZIDs"))},
+	)
+	hzEmbeddedTags = hzWeighted(
+		hzChoice[hzJSONTag]{4, hzPick(
+			hzJSONTag{present: true, omitempty: true},
+			hzJSONTag{present: true},
+			hzJSONTag{present: true, name: "in"},
+			hzJSONTag{present: true, name: "in", omitempty: true},
+		)},
+		hzChoice[hzJSONTag]{hzUnless(hzNoKnown, 2), hzPick(
+			hzJSONTag{present: true, inline: true},
+			hzJSONTag{present: true, name: "in", inline: true},
+		)},
+	)
+	hzEmbeddedFields = hegel.Composite(func(tc hegel.TestCase) hzField {
+		typ := hegel.Draw(tc, hzEmbeddedTypes)
+		return hzField{name: typ.hzBase().name, typ: typ, embedded: true, json: hegel.Draw(tc, hzMaybe(30, hzEmbeddedTags))}
+	})
+	hzEmbedded = hzMaybe(15, hegel.Map(hzEmbeddedFields, func(f hzField) *hzField { return &f }))
+)
+
+// hzFieldsOf: an ordinary field of a type from types: unexported one time in twelve, with its
+// json tag record, its keyword record (fitting the schema type the field gets, so that values
+// can honour it), a description and extras.
+func hzFieldsOf(types hegel.Generator[*hzType]) hegel.Generator[hzField] {
+	return hegel.Composite(func(tc hegel.TestCase) hzField {
+		typ := hegel.Draw(tc, types)
+		f := hzField{typ: typ, unexported: hegel.Draw(tc, hzChance(8))}
+		f.json = hegel.Draw(tc, hzJSONTagsFor(typ))
+		f.kw = hegel.Draw(tc, hzKeywordsFor(typ, f.json))
+		f.desc = hegel.Draw(tc, hzMaybe(10, hzPick("d2", "the field")))
+		f.extras = hegel.Draw(tc, hzMaybe(12, hzExtraLists))
+		return f
+	})
+}
+
+// --------------------------------------------------------------------------- json tags
+
+var (
+	hzPlainNames = hzPick("c", "d", "e", "f", "g", "h")
+	hzOddNames   = hzPick("x y", "F0", "Name", "with-dash", "1")
+	// hzJSONNames: a key; the keys of HZInner's fields are the shape of /4 beside an embedded
+	// HZInner, and "-" (written "-,") the shape of /3.
+	hzJSONNames = hzWeighted(
+		hzChoice[string]{7, hzPlainNames},
+		hzChoice[string]{1, hzOddNames},
+		hzChoice[string]{hzUnless(hzNoKnown, 3), hzPick("a", "b")},
+		hzChoice[string]{hzUnless(hzNoKnown, 1), hegel.Just("-")},
+	)
+)
+
+// hzJSONOptionsOf: the options of a json tag, none first; inline (/5) where the type allows
+// it (on url.URL and time.Time the package inlines their own fields, which is not tested).
+func hzJSONOptionsOf(inlineOK bool) hegel.Generator[hzJSONTag] {
+	return hzWeighted(
+		hzChoice[hzJSONTag]{3, hegel.Just(hzJSONTag{})},
+		hzChoice[hzJSONTag]{3, hegel.Just(hzJSONTag{omitempty: true})},
+		hzChoice[hzJSONTag]{1, hegel.Just(hzJSONTag{omitzero: true})},
+		hzChoice[hzJSONTag]{1, hegel.Just(hzJSONTag{str: true})},
+		hzChoice[hzJSONTag]{1, hegel.Just(hzJSONTag{omitempty: true, str: true})},
+		hzChoice[hzJSONTag]{hzUnless(hzNoKnown || !inlineOK, 1), hegel.Just(hzJSONTag{inline: true})},
+	)
+}
+
+// hzJSONTagsOf: no json tag one time in five, the tag "-" (the field dropped) one in
+// twenty-five, else a key with options.
+func hzJSONTagsOf(inlineOK bool) hegel.Generator[hzJSONTag] {
+	options := hzJSONOptionsOf(inlineOK)
+	return hzWeighted(
+		hzChoice[hzJSONTag]{20, hegel.Just(hzJSONTag{})},
+		hzChoice[hzJSONTag]{4, hegel.Just(hzJSONTag{present: true, drop: true})},
+		hzChoice[hzJSONTag]{76, hegel.Composite(func(tc hegel.TestCase) hzJSONTag {
+			name := hegel.Draw(tc, hzJSONNames)
+			j := hegel.Draw(tc, options)
+			j.present, j.name = true, name
+			return j
+		})},
+	)
+}
+
+var hzJSONTagsBy = [2]hegel.Generator[hzJSONTag]{hzJSONTagsOf(false), hzJSONTagsOf(true)}
+
+func hzInlineOK(typ *hzType) bool {
+	b := typ.hzBase()
+	return b.kind != "url" && b.kind != "time"
+}
+
+// hzJSONTagsFor is the json tag generator for a field of the type.
+func hzJSONTagsFor(typ *hzType) hegel.Generator[hzJSONTag] {
+	return hzJSONTagsBy[hzIndex(hzInlineOK(typ))]
+}
+
+// --------------------------------------------------------------------------- keyword tags
+
+var hzPatterns = []string{`^[a-z]+$`, `^[0-9]{2}$`, `^a\,b$`, `^x*$`, `^a=b$`}
+
+// hzGenericKwOf: the generic keywords; nullable at the given weight (zero under
+// HEGEL_NO_KNOWN=1 for a field whose schema accepts null already: /14).
+func hzGenericKwOf(nullableW int) hegel.Generator[hzKeywords] {
+	return hegel.Composite(func(tc hegel.TestCase) hzKeywords {
+		return hzKeywords{
+			required:    hegel.Draw(tc, hzChance(20)),
+			nullable:    hegel.Draw(tc, hzChance(nullableW)),
+			title:       hegel.Draw(tc, hzMaybe(25, hzPick("T", "the title", "a=b"))),
+			description: hegel.Draw(tc, hzMaybe(15, hzPick("D", "a\\,b"))),
+		}
+	})
+}
+
+var hzGenericKw = [2]hegel.Generator[hzKeywords]{hzGenericKwOf(hzUnless(hzNoKnown, 20)), hzGenericKwOf(20)}
+
+// hzNumberKwOf: the numeric keywords, each absent first; default= at the given weight (on an
+// array's items it is an array default, /11).
+func hzNumberKwOf(defaultW int) hegel.Generator[hzNumberKw] {
+	return hegel.Composite(func(tc hegel.TestCase) hzNumberKw {
+		return hzNumberKw{
+			minimum:    hegel.Draw(tc, hzMaybe(40, hzPick("-3", "0", "1", "2.5", "abc"))),
+			maximum:    hegel.Draw(tc, hzMaybe(30, hzPick("5", "10", "1e2", "7.5"))),
+			multipleOf: hegel.Draw(tc, hzMaybe(15, hzPick("2", "0.5"))),
+			enum:       hegel.Draw(tc, hzMaybe(15, hzMany(hzPick("1", "2", "3", "4.5", "x"), 1, 3))),
+			dflt:       hegel.Draw(tc, hzMaybe(defaultW, hzPick("1", "2.5", "x"))),
+			example:    hegel.Draw(tc, hzMaybe(15, hzPick("3", "x"))),
+		}
+	})
+}
+
+// hzStringShapes: nothing, lengths, a pattern or an enum.
+var hzStringShapes = hzWeighted(
+	hzChoice[hzStringKw]{1, hegel.Just(hzStringKw{})},
+	hzChoice[hzStringKw]{1, hegel.Composite(func(tc hegel.TestCase) hzStringKw {
+		return hzStringKw{
+			minLength: hegel.Draw(tc, hzMaybe(60, hzPick("0", "1", "2", "-1"))),
+			maxLength: hegel.Draw(tc, hzMaybe(50, hzPick("3", "6", "abc"))),
+		}
+	})},
+	hzChoice[hzStringKw]{1, hegel.Map(hegel.SampledFrom(hzPatterns), func(p string) hzStringKw { return hzStringKw{pattern: p} })},
+	hzChoice[hzStringKw]{1, hegel.Map(hzMany(hzPick("red", "green", "blue", "a,b"), 1, 3), func(e []string) hzStringKw { return hzStringKw{enum: e} })},
+)
+
+// hzStringKwOf: the string keywords: a shape, a default, an example, readOnly/writeOnly.
+func hzStringKwOf(defaultW int) hegel.Generator[hzStringKw] {
+	return hegel.Composite(func(tc hegel.TestCase) hzStringKw {
+		k := hegel.Draw(tc, hzStringShapes)
+		k.dflt = hegel.Draw(tc, hzMaybe(defaultW, hzPick("alex", "x=y")))
+		k.example = hegel.Draw(tc, hzMaybe(15, hegel.Just("joe")))
+		k.access = hegel.Draw(tc, hzMaybe(15, hzPick("readOnly=true", "writeOnly=true", "readOnly=yes")))
+		return k
+	})
+}
+
+var (
+	hzNumberFields = hegel.Map(hzNumberKwOf(20), func(n hzNumberKw) hzKeywords { return hzKeywords{num: n} })
+	hzStringFields = hegel.Map(hzStringKwOf(20), func(s hzStringKw) hzKeywords { return hzKeywords{str: s} })
+	hzBoolFields   = hegel.Map(hzMaybe(40, hzPick("true", "false", "yes")), func(d string) hzKeywords { return hzKeywords{boolDefault: d} })
+	hzNoKeywords   = hegel.Just(hzKeywords{})
+	// hzUniqueItems: the uniqueItems item, absent first; "=false" is /7.
+	hzUniqueItems = hzWeighted(
+		hzChoice[string]{70, hegel.Just("")},
+		hzChoice[string]{10, hegel.Just("uniqueItems")},
+		hzChoice[string]{10, hegel.Just("uniqueItems=true")},
+		hzChoice[string]{hzUnless(hzNoKnown, 10), hegel.Just("uniqueItems=false")},
+	)
+	hzArrayDefaults = hzMany(hzPick("1", "x", "true"), 1, 2)
+)
+
+// hzCounts is a decimal number from lo to hi.
+func hzCounts(lo, hi int) hegel.Generator[string] {
+	return hegel.Map(hegel.Integers(lo, hi), strconv.Itoa)
+}
+
+// hzArrayKwOf: the array keywords of a slice (n < 0) or of an array of n elements (whose
+// minItems and maxItems admit n); default= at the given weight.
+func hzArrayKwOf(n int, defaultW int) hegel.Generator[hzArrayKw] {
+	minItems, maxItems := hzCounts(0, 2), hzCounts(2, 4)
+	if n >= 0 {
+		minItems, maxItems = hzCounts(0, n), hzCounts(n, 4)
+	}
+	return hegel.Composite(func(tc hegel.TestCase) hzArrayKw {
+		return hzArrayKw{
+			minItems: hegel.Draw(tc, hzMaybe(40, minItems)),
+			maxItems: hegel.Draw(tc, hzMaybe(30, maxItems)),
+			unique:   hegel.Draw(tc, hzUniqueItems),
+			defaults: hegel.Draw(tc, hzMaybe(defaultW, hzArrayDefaults)),
+		}
+	})
+}
+
+// hzItemsKind is the schema type of an array's items that the items' keywords fit ("" for
+// the element types whose values the keywords do not shape).
+func hzItemsKind(elem *hzType) string {
+	switch elem.kind {
+	case "ptr", "time", "ip", "url", "bytes":
+		return ""
+	}
+	return elem.hzSchemaKind()
+}
+
+// hzArrayFieldsOf: the keywords of a slice or array field: the array keywords, then the
+// items' keywords by their type. A default= on items that are not strings is /11.
+func hzArrayFieldsOf(typ *hzType) hegel.Generator[hzKeywords] {
+	rt := typ.hzBase().hzResolve()
+	n := -1
+	if rt.kind == "array" {
+		n = rt.n
+	}
+	// A default= is typed by the items' schema type, whatever the Go element (a pointer's
+	// is its element's): on items that are not strings it is /11.
+	defaultW := 35
+	switch rt.elem.hzBase().hzSchemaKind() {
+	case "integer", "number", "boolean":
+		defaultW = hzUnless(hzNoKnown, 35)
+	}
+	var items hegel.Generator[hzKeywords]
+	switch hzItemsKind(rt.elem) {
+	case "integer", "number":
+		items = hegel.Map(hzNumberKwOf(defaultW), func(k hzNumberKw) hzKeywords { return hzKeywords{num: k} })
+	case "string":
+		items = hzStringFields
+	default:
+		items = hzNoKeywords
+	}
+	arr := hzArrayKwOf(n, defaultW)
+	return hegel.Composite(func(tc hegel.TestCase) hzKeywords {
+		k := hegel.Draw(tc, items)
+		k.arr = hegel.Draw(tc, arr)
+		return k
+	})
+}
+
+// hzRefArrayKw: array keywords on a field of a named slice type, minItems always among them,
+// so that every draw meets /10 (the package drops them with the $ref).
+var hzRefArrayKw = hegel.Composite(func(tc hegel.TestCase) hzKeywords {
+	return hzKeywords{arr: hzArrayKw{
+		minItems: hegel.Draw(tc, hzCounts(0, 2)),
+		maxItems: hegel.Draw(tc, hzMaybe(30, hzCounts(2, 4))),
+		unique:   hegel.Draw(tc, hzMaybe(30, hegel.Just("uniqueItems=true"))),
+		defaults: hegel.Draw(tc, hzMaybe(35, hzArrayDefaults)),
+	}}
+})
+
+// hzMergeKw is the generic keywords with the typed ones.
+func hzMergeKw(g, t hzKeywords) hzKeywords {
+	t.required, t.nullable, t.title, t.description = g.required, g.nullable, g.title, g.description
+	return t
+}
+
+// hzKeywordsFor is the keyword record generator for a field of the type with the json tag:
+// no jsonschema tag nearly half the time, else the generic keywords with the keywords of
+// the schema type the field gets (none when the ",string" option turns it into a string of
+// the value).
+func hzKeywordsFor(typ *hzType, j hzJSONTag) hegel.Generator[hzKeywords] {
+	kind := typ.hzSchemaKind()
+	if j.str && (kind == "integer" || kind == "number" || kind == "boolean" || kind == "string") {
+		kind = ""
+	}
+	base := typ.hzBase()
+	generic := hzGenericKw[hzIndex(base.kind != "any" && base.kind != "raw")]
+	var typed hegel.Generator[hzKeywords]
+	switch {
+	case typ.hzIsNamedSlice():
+		typed = hzWeighted(hzChoice[hzKeywords]{1, hzNoKeywords}, hzChoice[hzKeywords]{hzUnless(hzNoKnown, 1), hzRefArrayKw})
+	case kind == "integer" || kind == "number":
+		typed = hzNumberFields
+	case kind == "string" && typ.kind == "string":
+		typed = hzStringFields
+	case kind == "boolean":
+		typed = hzBoolFields
+	case kind == "array":
+		typed = hzArrayFieldsOf(typ)
+	default:
+		typed = hzNoKeywords
+	}
+	return hzWeighted(
+		hzChoice[hzKeywords]{45, hzNoKeywords},
+		hzChoice[hzKeywords]{55, hegel.Composite(func(tc hegel.TestCase) hzKeywords {
+			return hzMergeKw(hegel.Draw(tc, generic), hegel.Draw(tc, typed))
+		})},
+	)
+}
+
+// --------------------------------------------------------------------------- extras
+
+// hzExtras: one to three jsonschema_extras items; maximum= is /8 (parsed as a string).
+var (
+	hzExtraItems = hzWeighted(
+		hzChoice[string]{14, hzPick("a=b", "foo=bar", "foo=bar1", "x=true", "x=false", "minimum=-4", "c=t")},
+		hzChoice[string]{hzUnless(hzNoKnown, 1), hegel.Just("maximum=6")},
+	)
+	hzExtraLists = hzMany(hzExtraItems, 1, 3)
+)
+
+// --------------------------------------------------------------------------- roots and cases
+
+// hzRootsOf is the root type for the options: mostly a struct, sometimes a named type (HZNode
+// under ExpandedStruct is /12), a pointer to a struct, or any type.
+func hzRootsOf(allowNode, expanded bool) hegel.Generator[*hzType] {
+	types := hzTypesAt(allowNode, 2)
+	structs := hzStructsOf(types)
+	anyType := types
+	if hzNoKnown && expanded {
+		// A root of (a pointer to) HZNode under ExpandedStruct is /12: not among the roots.
+		anyType = hegel.Filter(types, func(t *hzType) bool { b := t.hzBase(); return b.kind != "named" || b.name != "HZNode" })
+	}
+	named := hzWeighted(
+		hzChoice[*hzType]{5, hegel.Map(hzPick("HZInner", "HZIDs", "HZMap", "HZRaw", "HZLevel"), hzNamed)},
+		hzChoice[*hzType]{hzUnless(!allowNode || (hzNoKnown && expanded), 3), hegel.Just(hzNamed("HZNode"))},
+	)
+	return hzWeighted(
+		hzChoice[*hzType]{6, structs},
+		hzChoice[*hzType]{2, named},
+		hzChoice[*hzType]{1, hegel.Map(structs, hzPtrTo)},
+		hzChoice[*hzType]{1, anyType},
+	)
+}
+
+var hzRoots = [2][2]hegel.Generator[*hzType]{
+	{hzRootsOf(false, false), hzRootsOf(false, true)},
+	{hzRootsOf(true, false), hzRootsOf(true, true)},
+}
+
+// hzCase is the options, the root type, and whether the schema is taken by Reflect of a
+// pointer to a zero value rather than ReflectFromType.
+type hzCase struct {
+	o        hzRefOpts
+	typ      *hzType
+	viaValue bool
+}
+
+// reflected is the type ReflectFromType gets: the root type, or via Reflect the type of a
+// pointer to its zero value (ReflectFromType strips one pointer only, so a pointer root given
+// as a value is reflected as the pointer: no $id, and ExpandedStruct does not expand it).
+func (c hzCase) reflected() *hzType {
+	if c.viaValue {
+		return hzPtrTo(c.typ)
+	}
+	return c.typ
+}
+
+func (c hzCase) GoString() string {
+	s := fmt.Sprintf("type %s, options %s", c.typ, c.o)
+	if c.viaValue {
+		s += ", via Reflect"
+	}
+	return s
+}
+
+// hzCasesOf is a case of the options and roots.
+func hzCasesOf(opts hegel.Generator[hzRefOpts], roots hegel.Generator[*hzType]) hegel.Generator[hzCase] {
+	return hegel.Composite(func(tc hegel.TestCase) hzCase {
+		return hzCase{o: hegel.Draw(tc, opts), typ: hegel.Draw(tc, roots), viaValue: hegel.Draw(tc, hzChance(30))}
+	})
+}
+
+// hzCases: the options, then a root type drawn for them (HZNode never under DoNotReference).
+var hzCases = hegel.FlatMap(hzOptions, func(o hzRefOpts) hegel.Generator[hzCase] {
+	return hzCasesOf(hegel.Just(o), hzRoots[hzIndex(!o.doNotReference)][hzIndex(o.expanded)])
+})
diff --git a/hegel/hegel_zoo_model_test.go b/hegel/hegel_zoo_model_test.go
new file mode 100644
index 0000000..ae2171f
--- /dev/null
+++ b/hegel/hegel_zoo_model_test.go
@@ -0,0 +1,672 @@
+package hegel
+
+// The model: the JSON Schema the Reflector should produce for a generated type, as a tree of
+// map[string]any / []any / json.Number / string / bool. It follows the package's documented
+// mapping (README, the doc comments of Reflector and the jsonschema tag keywords) and
+// encoding/json's rules for field names, embedding and omission. It states the documented
+// behaviour everywhere: where the package differs (the recorded bugs of bugs.toml) the wide
+// properties fail naming the bug whose shape the case has (HZKnown.explains).
+
+import (
+	"encoding/json"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// hzRefOpts are the Reflector options the tests draw.
+type hzRefOpts struct {
+	anonymous        bool
+	allowAdditional  bool
+	requiredFromTags bool
+	doNotReference   bool
+	expanded         bool
+	anchor           bool
+}
+
+func (o hzRefOpts) String() string {
+	var parts []string
+	if o.anonymous {
+		parts = append(parts, "Anonymous")
+	}
+	if o.allowAdditional {
+		parts = append(parts, "AllowAdditionalProperties")
+	}
+	if o.requiredFromTags {
+		parts = append(parts, "RequiredFromJSONSchemaTags")
+	}
+	if o.doNotReference {
+		parts = append(parts, "DoNotReference")
+	}
+	if o.expanded {
+		parts = append(parts, "ExpandedStruct")
+	}
+	if o.anchor {
+		parts = append(parts, "AssignAnchor")
+	}
+	if len(parts) == 0 {
+		return "{}"
+	}
+	return "{" + strings.Join(parts, ", ") + "}"
+}
+
+type hzModel struct {
+	o    hzRefOpts
+	defs map[string]map[string]any
+}
+
+const hzVersion = "https://json-schema.org/draft/2020-12/schema"
+
+// hzModelSchema is the root schema of ReflectFromType(t) (or Reflect of a value of t).
+func hzModelSchema(o hzRefOpts, t *hzType) map[string]any {
+	m := &hzModel{o: o, defs: map[string]map[string]any{}}
+	if t.kind == "ptr" {
+		t = t.elem
+	}
+	name := ""
+	if t.kind == "named" {
+		name = t.name
+	}
+	root := m.schema(t)
+	if o.expanded {
+		if def, ok := m.defs[name]; ok && name != "" {
+			root = def
+			delete(m.defs, name)
+			// The definition moved into the root: the references to it point at the root.
+			hzRewriteRefs(root, "#/$defs/"+name, "#")
+		}
+	}
+	out := map[string]any{}
+	for k, v := range root {
+		out[k] = v
+	}
+	if !o.anonymous && name != "" {
+		out["$id"] = "https://" + hzPkgPath + "/" + hzToSnakeCase(name)
+	}
+	out["$schema"] = hzVersion
+	if !o.doNotReference && len(m.defs) > 0 {
+		defs := map[string]any{}
+		for k, v := range m.defs {
+			defs[k] = v
+		}
+		out["$defs"] = defs
+	}
+	return out
+}
+
+var hzMatchFirstCap = regexp.MustCompile("(.)([A-Z][a-z]+)")
+var hzMatchAllCap = regexp.MustCompile("([a-z0-9])([A-Z])")
+
+// hzToSnakeCase is the documented dashed snake case of type names (ToSnakeCase).
+func hzToSnakeCase(s string) string {
+	s = hzMatchFirstCap.ReplaceAllString(s, "${1}-${2}")
+	s = hzMatchAllCap.ReplaceAllString(s, "${1}-${2}")
+	return strings.ToLower(s)
+}
+
+// hzRewriteRefs replaces $ref values equal to from by to, in place.
+func hzRewriteRefs(v any, from, to string) {
+	switch x := v.(type) {
+	case map[string]any:
+		if r, ok := x["$ref"].(string); ok && r == from {
+			x["$ref"] = to
+		}
+		for _, e := range x {
+			hzRewriteRefs(e, from, to)
+		}
+	case []any:
+		for _, e := range x {
+			hzRewriteRefs(e, from, to)
+		}
+	}
+}
+
+// schema is reflectTypeToSchema: the schema of t, a $ref for a named slice, map or struct
+// type (whose definition is recorded) unless DoNotReference.
+func (m *hzModel) schema(t *hzType) map[string]any {
+	switch t.kind {
+	case "ptr":
+		return m.schema(t.elem)
+	case "bool":
+		return map[string]any{"type": "boolean"}
+	case "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64":
+		return map[string]any{"type": "integer"}
+	case "float32", "float64":
+		return map[string]any{"type": "number"}
+	case "string":
+		return map[string]any{"type": "string"}
+	case "any", "raw":
+		return map[string]any{}
+	case "time":
+		return map[string]any{"type": "string", "format": "date-time"}
+	case "ip":
+		// An address of either family (the package writes ipv4 whatever the address: /9).
+		return map[string]any{"type": "string", "oneOf": []any{map[string]any{"format": "ipv4"}, map[string]any{"format": "ipv6"}}}
+	case "url":
+		// encoding/json writes url.URL as an object (the package says string/uri: /1).
+		return map[string]any{"type": "object"}
+	case "bytes":
+		return map[string]any{"type": "string", "contentEncoding": "base64"}
+	case "slice":
+		if t.elem.kind == "uint8" {
+			// A slice of bytes, whatever its declared element, is base64 text.
+			return map[string]any{"type": "string", "contentEncoding": "base64"}
+		}
+		return map[string]any{"type": "array", "items": m.schema(t.elem)}
+	case "array":
+		n := json.Number(strconv.Itoa(t.n))
+		return map[string]any{"type": "array", "items": m.schema(t.elem), "minItems": n, "maxItems": n}
+	case "map":
+		return m.mapSchema(t)
+	case "struct":
+		s := map[string]any{}
+		m.structSchema(t, s, "")
+		return s
+	case "named":
+		return m.named(t.name)
+	}
+	panic("hzModel.schema: " + t.kind)
+}
+
+func (m *hzModel) mapSchema(t *hzType) map[string]any {
+	s := map[string]any{"type": "object"}
+	if t.key == "int" {
+		// Signed keys are written with their sign (the package's pattern has none: /2).
+		s["patternProperties"] = map[string]any{"^-?[0-9]+$": m.schema(t.elem)}
+		s["additionalProperties"] = false
+		return s
+	}
+	if t.elem.kind != "any" {
+		s["additionalProperties"] = m.schema(t.elem)
+	}
+	return s
+}
+
+// named is the schema of a named type: integers are inline, the others get a definition
+// (recorded before their content is built, as the package does, so recursion ends) and a $ref.
+func (m *hzModel) named(name string) map[string]any {
+	desc := hzNamedDesc[name]
+	if desc.kind == "int" {
+		return map[string]any{"type": "integer"}
+	}
+	if !m.o.doNotReference {
+		if _, ok := m.defs[name]; ok {
+			return map[string]any{"$ref": "#/$defs/" + name}
+		}
+	}
+	s := map[string]any{}
+	m.defs[name] = s
+	switch desc.kind {
+	case "struct":
+		m.structSchema(desc, s, name)
+	case "slice":
+		s["type"] = "array"
+		s["items"] = m.schema(desc.elem)
+	case "bytes":
+		s["type"] = "string"
+		s["contentEncoding"] = "base64"
+	case "map":
+		for k, v := range m.mapSchema(desc) {
+			s[k] = v
+		}
+	}
+	if m.o.doNotReference {
+		return s
+	}
+	return map[string]any{"$ref": "#/$defs/" + name}
+}
+
+// hzFieldWalk is the state of one struct's properties while its fields (and the fields of its
+// embedded structs) are added: the depth at which each key was taken (-1: dead, both fields
+// of a pair dropped), whether it came from a tagged field, and whether it is required.
+type hzFieldWalk struct {
+	props    map[string]any
+	depth    map[string]int
+	taggedAt map[string]bool
+	req      map[string]bool
+}
+
+// structSchema fills s with the object schema of a struct type.
+func (m *hzModel) structSchema(t *hzType, s map[string]any, name string) {
+	s["type"] = "object"
+	w := &hzFieldWalk{props: map[string]any{}, depth: map[string]int{}, taggedAt: map[string]bool{}, req: map[string]bool{}}
+	s["properties"] = w.props
+	if m.o.anchor && name != "" {
+		s["$anchor"] = name
+	}
+	if !m.o.allowAdditional {
+		s["additionalProperties"] = false
+	}
+	m.fields(t, w, 0)
+	var required []string
+	for k, v := range w.req {
+		if v {
+			required = append(required, k)
+		}
+	}
+	if len(required) > 0 {
+		sort.Strings(required)
+		var r []any
+		for _, k := range required {
+			r = append(r, k)
+		}
+		s["required"] = r
+	}
+}
+
+// fields adds the properties of t's fields (reflectStructFields), recursing into embedded
+// structs at depth d+1 for encoding/json's rule that the shallower field wins a key.
+func (m *hzModel) fields(t *hzType, w *hzFieldWalk, d int) {
+	for _, f := range t.fields {
+		if f.json.present && f.json.drop {
+			continue
+		}
+		schemaTags := f.jsTags()
+		if len(schemaTags) > 0 && schemaTags[0] == "-" {
+			continue
+		}
+		required := false
+		if !m.o.requiredFromTags {
+			required = !(f.json.omitempty || f.json.omitzero)
+		}
+		if f.kw.required {
+			required = true
+		}
+		rt := f.typ.hzBase().hzResolve()
+		if f.embedded && f.json.key() == "" {
+			if rt.kind == "struct" {
+				m.fields(rt, w, d+1)
+				continue
+			}
+			if f.unexported {
+				continue // encoding/json ignores an unexported embedded field of a non-struct type (/6)
+			}
+		}
+		// (The json option "inline" is yaml's: encoding/json ignores it, and so does the model; /5.)
+		if f.unexported && !f.embedded {
+			continue
+		}
+		name := f.hzJSONName() // "-" for the tag "-,": the key "-" (/3)
+		property := m.schema(f.typ)
+		m.applyTags(property, f)
+		if f.kw.nullable {
+			// The documented meaning is "null is accepted too": for a schema that accepts
+			// null already (any, json.RawMessage) only anyOf says that (/14).
+			op := "oneOf"
+			if base := f.typ.hzBase(); base.kind == "any" || base.kind == "raw" {
+				op = "anyOf"
+			}
+			property = map[string]any{op: []any{property, map[string]any{"type": "null"}}}
+		}
+		// encoding/json's dominant field: the shallower wins; at the same depth the tagged
+		// one wins over the untagged; otherwise both are dropped (/4).
+		tagged := f.json.key() != ""
+		if old, ok := w.depth[name]; ok {
+			if old == -1 || old < d || (old == d && w.taggedAt[name] == tagged) {
+				if old == d {
+					delete(w.props, name)
+					delete(w.req, name)
+					w.depth[name] = -1 // dead: nothing deeper may take the key
+				}
+				continue
+			}
+			if old == d && w.taggedAt[name] && !tagged {
+				continue
+			}
+		}
+		w.props[name] = property
+		w.depth[name] = d
+		w.taggedAt[name] = tagged
+		w.req[name] = required
+	}
+}
+
+// applyTags is structKeywordsFromTags: the jsonschema_description tag, the generic keywords,
+// the ",string" json option, the type-specific keywords and jsonschema_extras.
+func (m *hzModel) applyTags(p map[string]any, f hzField) {
+	if f.desc != "" {
+		p["description"] = f.desc
+	}
+	tags := hzSplitUnescaped(strings.Join(f.jsTags(), ","))
+	var rest []string
+	for _, tag := range tags {
+		k, v, ok := strings.Cut(tag, "=")
+		if !ok {
+			continue
+		}
+		switch k {
+		case "title":
+			p["title"] = v
+		case "description":
+			p["description"] = v
+		default:
+			rest = append(rest, tag)
+		}
+	}
+	typ, _ := p["type"].(string)
+	if (typ == "integer" || typ == "number" || typ == "boolean") && f.hzQuoted() {
+		typ = "string"
+		p["type"] = "string"
+	}
+	switch typ {
+	case "string":
+		hzStringKeywords(p, rest)
+	case "integer", "number":
+		hzNumberKeywords(p, rest)
+	case "boolean":
+		hzBoolKeywords(p, rest)
+	case "array":
+		items, _ := p["items"].(map[string]any)
+		hzArrayKeywords(p, items, rest)
+	case "":
+		if _, isRef := p["$ref"]; isRef && f.typ.hzIsNamedSlice() {
+			// The array keywords stand beside the $ref (2020-12 allows it; the package drops
+			// them: /10); the items' schema types the defaults and is not part of the property.
+			hzArrayKeywords(p, m.schema(hzNamedDesc[f.typ.name].elem), rest)
+		}
+	}
+	if len(f.extras) > 0 {
+		hzExtras(p, hzSplitUnescaped(strings.Join(f.extras, ",")))
+	}
+}
+
+// hzSplitUnescaped splits on commas not preceded by a backslash (the backslash is dropped).
+func hzSplitUnescaped(s string) []string {
+	parts := strings.Split(s, ",")
+	out := []string{parts[0]}
+	for _, next := range parts[1:] {
+		last := out[len(out)-1]
+		if last != "" && strings.HasSuffix(last, "\\") {
+			out[len(out)-1] = last[:len(last)-1] + "," + next
+		} else {
+			out = append(out, next)
+		}
+	}
+	return out
+}
+
+func hzParseUint(s string) (json.Number, bool) {
+	if _, err := strconv.ParseUint(s, 10, 64); err != nil {
+		return "", false
+	}
+	return json.Number(s), true
+}
+
+func hzJSONNumber(s string) (json.Number, bool) {
+	n := json.Number(s)
+	if _, err := n.Int64(); err == nil {
+		return n, true
+	}
+	if _, err := n.Float64(); err == nil {
+		return n, true
+	}
+	return "", false
+}
+
+func hzStringKeywords(p map[string]any, tags []string) {
+	for _, tag := range tags {
+		k, v, ok := strings.Cut(tag, "=")
+		if !ok {
+			continue
+		}
+		switch k {
+		case "minLength", "maxLength":
+			if n, ok := hzParseUint(v); ok {
+				p[k] = n
+			}
+		case "pattern", "format":
+			p[k] = v
+		case "readOnly", "writeOnly":
+			b, _ := strconv.ParseBool(v)
+			if b {
+				p[k] = true
+			}
+		case "default":
+			p["default"] = v
+		case "example":
+			p["examples"] = append(hzList(p["examples"]), v)
+		case "enum":
+			p["enum"] = append(hzList(p["enum"]), v)
+		}
+	}
+}
+
+func hzList(v any) []any {
+	if l, ok := v.([]any); ok {
+		return l
+	}
+	return nil
+}
+
+// hzNumberKeywords: the numeric keywords take valid JSON numbers only, split at every "=".
+func hzNumberKeywords(p map[string]any, tags []string) {
+	for _, tag := range tags {
+		parts := strings.Split(tag, "=")
+		if len(parts) != 2 {
+			continue
+		}
+		k, v := parts[0], parts[1]
+		switch k {
+		case "multipleOf", "minimum", "maximum", "exclusiveMaximum", "exclusiveMinimum":
+			if n, ok := hzJSONNumber(v); ok {
+				p[k] = n
+			} else {
+				delete(p, k)
+			}
+		case "default":
+			if n, ok := hzJSONNumber(v); ok {
+				p["default"] = n
+			}
+		case "example":
+			if n, ok := hzJSONNumber(v); ok {
+				p["examples"] = append(hzList(p["examples"]), n)
+			}
+		case "enum":
+			if n, ok := hzJSONNumber(v); ok {
+				p["enum"] = append(hzList(p["enum"]), n)
+			}
+		}
+	}
+}
+
+func hzBoolKeywords(p map[string]any, tags []string) {
+	for _, tag := range tags {
+		parts := strings.Split(tag, "=")
+		if len(parts) != 2 || parts[0] != "default" {
+			continue
+		}
+		switch parts[1] {
+		case "true":
+			p["default"] = true
+		case "false":
+			p["default"] = false
+		}
+	}
+}
+
+// hzArrayKeywords: the array keywords on p, the default= values typed by the items' schema
+// (/11), then the rest to the items by their type. items is p's items schema, or for a $ref
+// the detached schema of the definition's items.
+func hzArrayKeywords(p, items map[string]any, tags []string) {
+	var defaults []any
+	var rest []string
+	for _, tag := range tags {
+		parts := strings.Split(tag, "=")
+		if len(parts) != 2 {
+			continue
+		}
+		k, v := parts[0], parts[1]
+		switch k {
+		case "minItems", "maxItems":
+			if n, ok := hzParseUint(v); ok {
+				p[k] = n
+			} else {
+				delete(p, k)
+			}
+		case "uniqueItems":
+			// The value is read: uniqueItems=false asks for nothing (/7).
+			if v != "false" {
+				p["uniqueItems"] = true
+			}
+		case "default":
+			defaults = append(defaults, v)
+		case "format", "pattern":
+			if items != nil {
+				items[k] = v
+			}
+		default:
+			rest = append(rest, tag)
+		}
+	}
+	if len(defaults) > 0 {
+		if items != nil {
+			var typed []any
+			for _, d := range defaults {
+				switch items["type"] {
+				case "integer", "number":
+					if n, ok := hzJSONNumber(d.(string)); ok {
+						typed = append(typed, n)
+					}
+				case "boolean":
+					if d == "true" || d == "false" {
+						typed = append(typed, d == "true")
+					}
+				default:
+					typed = append(typed, d)
+				}
+			}
+			defaults = typed
+		}
+		if len(defaults) > 0 {
+			p["default"] = defaults
+		}
+	}
+	if len(rest) == 0 || items == nil {
+		return
+	}
+	switch items["type"] {
+	case "string":
+		hzStringKeywords(items, rest)
+	case "integer", "number":
+		hzNumberKeywords(items, rest)
+	case "boolean":
+		hzBoolKeywords(items, rest)
+	}
+}
+
+// hzExtras is setExtra for each key=value: the first value of a key is a number for minimum
+// and maximum (/8: the package converts minimum only), a boolean for true/false, else the
+// text; repeated keys collect strings, or replace a number or boolean.
+func hzExtras(p map[string]any, tags []string) {
+	extras := map[string]any{}
+	for _, tag := range tags {
+		k, v, ok := strings.Cut(tag, "=")
+		if !ok {
+			continue
+		}
+		if old, ok := extras[k]; ok {
+			switch o := old.(type) {
+			case string:
+				extras[k] = []any{o, v}
+			case []any:
+				extras[k] = append(o, v)
+			case json.Number:
+				n, _ := strconv.Atoi(v)
+				extras[k] = json.Number(strconv.Itoa(n))
+			case bool:
+				extras[k] = v == "true" || v == "t"
+			}
+			continue
+		}
+		switch {
+		case k == "minimum" || k == "maximum":
+			n, _ := strconv.Atoi(v)
+			extras[k] = json.Number(strconv.Itoa(n))
+		case v == "true":
+			extras[k] = true
+		case v == "false":
+			extras[k] = false
+		default:
+			extras[k] = v
+		}
+	}
+	for k, v := range extras {
+		p[k] = v
+	}
+}
+
+// hzNormalize renders a schema tree (the model's or the package's, from its JSON) in one
+// form: numbers as json.Number, "required" lists sorted.
+func hzNormalize(v any) any {
+	b, err := json.Marshal(hzEmptyToTrue(v, true))
+	if err != nil {
+		panic(err)
+	}
+	return hzNormalizeJSON(b)
+}
+
+// hzEmptyToTrue renders the model's empty schemas as the boolean schema true, as the package
+// marshals them; containers of schemas (properties, $defs, patternProperties) stay objects.
+func hzEmptyToTrue(v any, isSchema bool) any {
+	m, ok := v.(map[string]any)
+	if !ok {
+		return v
+	}
+	if isSchema && len(m) == 0 {
+		return true
+	}
+	out := map[string]any{}
+	for k, e := range m {
+		switch k {
+		case "properties", "$defs", "patternProperties":
+			if !isSchema {
+				out[k] = e
+				continue
+			}
+			out[k] = hzEmptyToTrue(e, false)
+		case "items", "additionalProperties":
+			out[k] = hzEmptyToTrue(e, true)
+		case "oneOf", "anyOf", "allOf":
+			var l []any
+			for _, x := range e.([]any) {
+				l = append(l, hzEmptyToTrue(x, true))
+			}
+			out[k] = l
+		default:
+			if !isSchema {
+				out[k] = hzEmptyToTrue(e, true) // a container's entries are schemas
+			} else {
+				out[k] = e
+			}
+		}
+	}
+	return out
+}
+
+func hzNormalizeJSON(b []byte) any {
+	dec := json.NewDecoder(strings.NewReader(string(b)))
+	dec.UseNumber()
+	var out any
+	if err := dec.Decode(&out); err != nil {
+		panic(err)
+	}
+	hzSortRequired(out)
+	return out
+}
+
+func hzSortRequired(v any) {
+	switch x := v.(type) {
+	case map[string]any:
+		if r, ok := x["required"].([]any); ok {
+			sort.Slice(r, func(i, j int) bool { return r[i].(string) < r[j].(string) })
+		}
+		for _, e := range x {
+			hzSortRequired(e)
+		}
+	case []any:
+		for _, e := range x {
+			hzSortRequired(e)
+		}
+	}
+}
diff --git a/hegel/hegel_zoo_oracle_test.go b/hegel/hegel_zoo_oracle_test.go
new file mode 100644
index 0000000..bc14964
--- /dev/null
+++ b/hegel/hegel_zoo_oracle_test.go
@@ -0,0 +1,156 @@
+package hegel
+
+// The python-jsonschema oracle: one python3 process per test, fed JSON lines
+// {schemas: [...], instance: ...} and answering, per schema, whether it is a valid 2020-12
+// schema and whether the instance validates (format assertions on).
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+const hzOracleScript = `
+import sys, json
+import jsonschema
+from jsonschema import Draft202012Validator as V
+
+def main():
+    sys.stdout.write(json.dumps({"hello": True, "version": jsonschema.__version__, "python": sys.version.split()[0]}) + "\n")
+    sys.stdout.flush()
+    for line in sys.stdin:
+        req = json.loads(line)
+        out = {"schema_ok": [], "schema_err": [], "results": [], "exc": []}
+        try:
+            inst = json.loads(req["instance"]) if req.get("instance") is not None else None
+            for text in req["schemas"]:
+                schema = json.loads(text)
+                try:
+                    V.check_schema(schema, format_checker=V.FORMAT_CHECKER)
+                    out["schema_ok"].append(True)
+                    out["schema_err"].append("")
+                except jsonschema.SchemaError as e:
+                    out["schema_ok"].append(False)
+                    out["schema_err"].append(str(e).splitlines()[0][:200])
+                    out["results"].append(None)
+                    out["exc"].append("")
+                    continue
+                if req.get("instance") is None:
+                    out["results"].append(None)
+                    out["exc"].append("")
+                    continue
+                v = V(schema, format_checker=V.FORMAT_CHECKER)
+                try:
+                    err = jsonschema.exceptions.best_match(v.iter_errors(inst))
+                    out["results"].append(err is None)
+                    out["exc"].append("" if err is None else (err.json_path + ": " + err.message)[:300])
+                except Exception as e:
+                    out["results"].append(None)
+                    out["exc"].append(type(e).__name__ + ": " + str(e)[:200])
+        except Exception as e:
+            out["fatal"] = repr(e)[:300]
+        sys.stdout.write(json.dumps(out) + "\n")
+        sys.stdout.flush()
+
+main()
+`
+
+type hzOracleReply struct {
+	SchemaOK  []bool   `json:"schema_ok"`
+	SchemaErr []string `json:"schema_err"`
+	Results   []*bool  `json:"results"`
+	Exc       []string `json:"exc"`
+	Fatal     string   `json:"fatal"`
+}
+
+type hzOracle struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+func hzStartOracle(t *testing.T) *hzOracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	if err := os.WriteFile(script, []byte(hzOracleScript), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &hzOracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<20)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	hello, err := o.out.ReadString('\n')
+	if err != nil {
+		t.Fatalf("python jsonschema oracle did not start: %v", err)
+	}
+	var h struct {
+		Version string `json:"version"`
+		Python  string `json:"python"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(hello)), &h); err != nil {
+		t.Fatalf("bad oracle greeting %q: %v", hello, err)
+	}
+	t.Logf("oracle: python %s jsonschema %s", h.Python, h.Version)
+	var major, minor int
+	fmt.Sscanf(h.Version, "%d.%d", &major, &minor)
+	if major < 4 || (major == 4 && minor < 18) {
+		t.Fatalf("python jsonschema %s is too old for the oracle (need 4.18+)", h.Version)
+	}
+	// Smoke test.
+	r, err := o.ask([]string{`{"type":"string"}`, `{"type":"integer","maximum":"5"}`}, `"a"`)
+	if err != nil || len(r.SchemaOK) != 2 || !r.SchemaOK[0] || r.SchemaOK[1] || r.Results[0] == nil || !*r.Results[0] {
+		t.Fatalf("python jsonschema oracle not working: %+v %v", r, err)
+	}
+	return o
+}
+
+// ask checks the schemas and validates the instance (JSON text; "" for none) against each.
+func (o *hzOracle) ask(schemas []string, instance string) (*hzOracleReply, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	m := map[string]any{"schemas": schemas}
+	if instance != "" {
+		m["instance"] = instance
+	}
+	req, _ := json.Marshal(m)
+	if _, err := o.in.Write(append(req, '\n')); err != nil {
+		return nil, err
+	}
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	line, err := o.out.ReadString('\n')
+	if err != nil {
+		return nil, fmt.Errorf("reading oracle reply: %v", err)
+	}
+	var r hzOracleReply
+	if err := json.Unmarshal([]byte(strings.TrimSpace(line)), &r); err != nil {
+		return nil, fmt.Errorf("bad oracle reply %q: %v", line, err)
+	}
+	if r.Fatal != "" {
+		return nil, fmt.Errorf("oracle: %s", r.Fatal)
+	}
+	return &r, nil
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..c795408
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,255 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the documented behaviour. They fail
+// while the bug exists and are listed as expected failures in target.toml.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/url"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/invopop/jsonschema"
+)
+
+// hzPinSchema reflects v's type with the root expanded (the pins' local struct types are named,
+// so the root would otherwise be a $ref).
+func hzPinSchema(t *testing.T, r *jsonschema.Reflector, v any) (*jsonschema.Schema, string) {
+	t.Helper()
+	r.ExpandedStruct = true
+	s := r.ReflectFromType(reflect.TypeOf(v))
+	b, err := json.Marshal(s)
+	if err != nil {
+		t.Fatalf("marshalling the schema: %v", err)
+	}
+	return s, string(b)
+}
+
+func hzPinProperty(t *testing.T, s *jsonschema.Schema, name string) *jsonschema.Schema {
+	t.Helper()
+	if s.Properties == nil {
+		t.Fatalf("no properties in %v", s)
+	}
+	p, ok := s.Properties.Get(name)
+	if !ok {
+		return nil
+	}
+	return p
+}
+
+// invopop-jsonschema/1: url.URL is reflected as a string with format uri, while encoding/json
+// writes it as an object.
+func TestHegelPinURLIsObject(t *testing.T) {
+	type S struct {
+		U url.URL `json:"u"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	v, _ := json.Marshal(S{U: url.URL{Scheme: "https", Host: "example.com"}})
+	p := hzPinProperty(t, s, "u")
+	if p == nil || p.Type == "string" {
+		t.Errorf("the schema of a url.URL field is %s, but encoding/json writes %s", js, v)
+	}
+}
+
+// invopop-jsonschema/2: map[int]... keys must match ^[0-9]+$, so negative keys are rejected.
+func TestHegelPinNegativeIntKeys(t *testing.T) {
+	type S struct {
+		M map[int]string `json:"m"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	p := hzPinProperty(t, s, "m")
+	if p == nil {
+		t.Fatalf("no property m in %s", js)
+	}
+	matched := false
+	for pat := range p.PatternProperties {
+		if regexp.MustCompile(pat).MatchString("-1") {
+			matched = true
+		}
+	}
+	if !matched && (p.AdditionalProperties == nil || p.AdditionalProperties == jsonschema.FalseSchema) {
+		v, _ := json.Marshal(S{M: map[int]string{-1: "x"}})
+		t.Errorf("the schema of a map[int]string field, %s, rejects the key -1 of %s", js, v)
+	}
+}
+
+// invopop-jsonschema/3: a field tagged json:"-," (the key "-") is left out of the schema.
+func TestHegelPinDashName(t *testing.T) {
+	type S struct {
+		D int `json:"-,"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	v, _ := json.Marshal(S{D: 3})
+	if hzPinProperty(t, s, "-") == nil {
+		t.Errorf("the schema %s has no property \"-\", but encoding/json writes %s", js, v)
+	}
+}
+
+// invopop-jsonschema/4: an embedded struct's field replaces an outer field of the same name
+// that precedes it; encoding/json lets the outer field win.
+func TestHegelPinEmbeddedOuterWins(t *testing.T) {
+	type S struct {
+		A string `json:"a"`
+		HZInner
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	v, _ := json.Marshal(S{A: "s", HZInner: HZInner{A: 1}})
+	p := hzPinProperty(t, s, "a")
+	if p == nil || p.Type != "string" {
+		t.Errorf("the schema %s gives a the type of the embedded field, but encoding/json writes %s", js, v)
+	}
+}
+
+// invopop-jsonschema/5: json:"name,inline" inlines the struct's fields, while encoding/json
+// knows no inline option and writes the key.
+func TestHegelPinInlineOption(t *testing.T) {
+	type S struct {
+		I HZInner `json:"i,inline"`
+		Z int     `json:"z"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	v, _ := json.Marshal(S{})
+	if hzPinProperty(t, s, "i") == nil {
+		t.Errorf("the schema %s has no property i, but encoding/json writes %s", js, v)
+	}
+}
+
+// invopop-jsonschema/6: an unexported embedded non-struct type becomes a required property that
+// encoding/json never writes.
+func TestHegelPinUnexportedEmbedded(t *testing.T) {
+	type S struct {
+		hzLevel
+		Y int `json:"y"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	v, _ := json.Marshal(S{hzLevel: 3})
+	if hzPinProperty(t, s, "hzLevel") != nil {
+		t.Errorf("the schema %s has a property hzLevel, but encoding/json writes %s", js, v)
+	}
+}
+
+// invopop-jsonschema/7: uniqueItems=false sets uniqueItems true.
+func TestHegelPinUniqueItemsFalse(t *testing.T) {
+	type S struct {
+		L []int `json:"l" jsonschema:"uniqueItems=false"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	if p := hzPinProperty(t, s, "l"); p == nil || p.UniqueItems {
+		t.Errorf("uniqueItems=false gives %s", js)
+	}
+}
+
+// invopop-jsonschema/8: jsonschema_extras parses minimum as a number but maximum as a string.
+func TestHegelPinExtrasMaximum(t *testing.T) {
+	type S struct {
+		N int `json:"n" jsonschema_extras:"minimum=2,maximum=5"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	p := hzPinProperty(t, s, "n")
+	if p == nil {
+		t.Fatalf("no property n in %s", js)
+	}
+	if _, isString := p.Extras["maximum"].(string); isString {
+		t.Errorf("jsonschema_extras maximum=5 gives %s (maximum is a string; minimum=2 is the number %v)", js, p.Extras["minimum"])
+	}
+}
+
+// invopop-jsonschema/9: net.IP has format ipv4 whatever the address.
+func TestHegelPinIPv6(t *testing.T) {
+	type S struct {
+		I net.IP `json:"i"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	v, _ := json.Marshal(S{I: net.ParseIP("fe80::1")})
+	if p := hzPinProperty(t, s, "i"); p == nil || p.Format == "ipv4" {
+		t.Errorf("the schema %s has format ipv4 for net.IP, but encoding/json writes %s", js, v)
+	}
+}
+
+// invopop-jsonschema/10: type-specific tags on a field of a named slice type are dropped.
+func TestHegelPinNamedSliceTags(t *testing.T) {
+	type S struct {
+		X HZIDs `json:"x" jsonschema:"minItems=1,uniqueItems=true"`
+	}
+	_, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	if !strings.Contains(js, `"minItems":1`) || !strings.Contains(js, `"uniqueItems":true`) {
+		t.Errorf("minItems=1,uniqueItems=true on a field of a named slice type give %s", js)
+	}
+}
+
+// invopop-jsonschema/11: default= on an array field is a list of strings whatever the items.
+func TestHegelPinArrayDefaultTyped(t *testing.T) {
+	type S struct {
+		L []int `json:"l" jsonschema:"default=1,default=2"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	p := hzPinProperty(t, s, "l")
+	if p == nil {
+		t.Fatalf("no property l in %s", js)
+	}
+	if d, ok := p.Default.([]string); ok || strings.Contains(js, `"default":["1"`) {
+		t.Errorf("default=1,default=2 on a []int field gives %s (%v)", js, d)
+	}
+}
+
+// invopop-jsonschema/12: ExpandedStruct on a recursive root leaves $refs to the removed
+// definition.
+func TestHegelPinExpandedRecursive(t *testing.T) {
+	s, js := hzPinSchema(t, &jsonschema.Reflector{ExpandedStruct: true}, HZNode{})
+	if strings.Contains(js, `"#/$defs/HZNode"`) {
+		if _, ok := s.Definitions["HZNode"]; !ok {
+			t.Errorf("ExpandedStruct on HZNode gives %s: $ref #/$defs/HZNode without that definition", js)
+		}
+	}
+}
+
+// invopop-jsonschema/14: nullable wraps the schema in oneOf [schema, null], so a field whose
+// schema accepts null already (any) rejects null.
+func TestHegelPinNullableAny(t *testing.T) {
+	type S struct {
+		A any `json:"a" jsonschema:"nullable"`
+	}
+	s, js := hzPinSchema(t, &jsonschema.Reflector{Anonymous: true}, S{})
+	p := hzPinProperty(t, s, "a")
+	if p == nil {
+		t.Fatalf("no property a in %s", js)
+	}
+	if len(p.OneOf) == 2 && reflect.DeepEqual(p.OneOf[0], &jsonschema.Schema{}) {
+		t.Errorf("nullable on an interface field gives %s: null is valid under both branches of the oneOf, so it is rejected", js)
+	}
+}
+
+// invopop-jsonschema/13: DoNotReference on a recursive type recurses without end (a fatal
+// stack overflow, so it runs in a child process).
+func TestHegelPinDoNotReferenceRecursive(t *testing.T) {
+	if os.Getenv("HZ_PIN_CHILD") == "1" {
+		r := &jsonschema.Reflector{DoNotReference: true}
+		s := r.ReflectFromType(reflect.TypeOf(HZNode{}))
+		b, _ := json.Marshal(s)
+		fmt.Println("schema of", len(b), "bytes")
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestHegelPinDoNotReferenceRecursive$")
+	cmd.Env = append(os.Environ(), "HZ_PIN_CHILD=1")
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		msg := string(out)
+		if i := strings.Index(msg, "\n"); i > 0 {
+			msg = msg[:i]
+		}
+		if len(msg) > 200 {
+			msg = msg[:200]
+		}
+		t.Errorf("Reflector{DoNotReference: true} on the recursive HZNode: %v (%s)", err, msg)
+	}
+}
diff --git a/hegel/hegel_zoo_props_test.go b/hegel/hegel_zoo_props_test.go
new file mode 100644
index 0000000..a855742
--- /dev/null
+++ b/hegel/hegel_zoo_props_test.go
@@ -0,0 +1,740 @@
+package hegel
+
+// TestHegelSchema: the schema the Reflector produces for a generated type and options equals
+// the model's.
+//
+// TestHegelValidate: the schema is a valid 2020-12 schema, and the JSON encoding/json writes for
+// a generated value of the type validates against it (python-jsonschema), as it does against
+// the model's schema.
+//
+// A disagreement on a case with the shape of a recorded bug fails naming the bug; under
+// HEGEL_NO_KNOWN=1 the shapes are not drawn and both properties pass. The judges
+// (hzCheckSchema, hzCheckValue) are shared with the narrow properties of
+// hegel_zoo_shapes_test.go.
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"net"
+	"net/url"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/invopop/jsonschema"
+	"hegel.dev/go/hegel"
+)
+
+func (o hzRefOpts) reflector() *jsonschema.Reflector {
+	return &jsonschema.Reflector{
+		Anonymous:                  o.anonymous,
+		AllowAdditionalProperties:  o.allowAdditional,
+		RequiredFromJSONSchemaTags: o.requiredFromTags,
+		DoNotReference:             o.doNotReference,
+		ExpandedStruct:             o.expanded,
+		AssignAnchor:               o.anchor,
+	}
+}
+
+// hzReflectJSON runs the Reflector on the type (ReflectFromType, or Reflect on a pointer to a
+// zero value) and returns the schema's JSON.
+func hzReflectJSON(c hzCase, rt reflect.Type) []byte {
+	r := c.o.reflector()
+	var s *jsonschema.Schema
+	if c.viaValue {
+		s = r.Reflect(reflect.New(rt).Interface())
+	} else {
+		s = r.ReflectFromType(rt)
+	}
+	b, err := json.Marshal(s)
+	if err != nil {
+		panic(fmt.Sprintf("marshalling the schema: %v", err))
+	}
+	return b
+}
+
+// hzCheckSchema: the package's schema of the case equals the model's; a difference is a
+// mismatch named by the case's known shapes.
+func hzCheckSchema(ht *hegel.T, col *hzCollector, c hzCase, rt reflect.Type, shapes []string) {
+	got := hzNormalizeJSON(hzReflectJSON(c, rt))
+	want := hzNormalize(hzModelSchema(c.o, c.reflected()))
+	if !reflect.DeepEqual(got, want) {
+		g, _ := json.Marshal(got)
+		w, _ := json.Marshal(want)
+		col.mismatch(ht, shapes, "schema", "type %s, options %s:\n got  %s\n want %s", c.typ, c.o, g, w)
+	}
+}
+
+func TestHegelSchema(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hzCases)
+		col.count("root " + c.typ.kind)
+		hzCheckSchema(ht, col, c, c.typ.hzReflectType(), HZKnown.explains(c.typ, c.o))
+	})
+}
+
+// --------------------------------------------------------------------------- constraints
+
+// hzCons are the constraints a field's tags put on its values (the documented meaning of the
+// keywords, so the values fit the schema).
+type hzCons struct {
+	min, max   *float64
+	multipleOf float64
+	enumNums   []float64
+	enumStrs   []string
+	minLen     int // -1: none
+	maxLen     int
+	pattern    string
+	minItems   int
+	maxItems   int
+	unique     bool
+	nonZero    bool // the value must not be omitted (required with omitempty)
+	nullable   bool
+	unsat      bool // no value fits: a quoted scalar whose tags constrain its text
+}
+
+func hzNoCons() hzCons { return hzCons{minLen: -1, maxLen: -1, minItems: -1, maxItems: -1} }
+
+// hzFieldCons reads the constraints of a field for its value and for the items of an array,
+// from the tag items as written (the keyword record and the extras).
+func hzFieldCons(f hzField) (val hzCons, items hzCons) {
+	val, items = hzNoCons(), hzNoCons()
+	kind := f.typ.hzSchemaKind()
+	if f.typ.hzIsNamedSlice() {
+		kind = "array"
+	}
+	if f.json.str && (kind == "integer" || kind == "number" || kind == "boolean" || kind == "string") {
+		kind = "" // a JSON string of the value: the numeric keywords do not shape it
+	}
+	if f.hzQuoted() {
+		// The schema types a quoted scalar as a string and its enum, pattern and lengths
+		// then constrain the JSON text of the value ("7", "true"), which the generator does
+		// not shape: no value is drawn (counted as unsatisfiable tags).
+		var text hzCons
+		for _, tag := range hzSplitUnescaped(strings.Join(f.jsTags(), ",")) {
+			hzReadCons(tag, &text, &text)
+		}
+		if len(text.enumStrs) > 0 || text.pattern != "" || text.minLen > 0 || text.maxLen > 0 {
+			val.unsat = true
+		}
+	}
+	target := &val
+	if kind == "array" {
+		target = &items
+	}
+	// The jsonschema tag's keywords of a value go to an array's items; the extras are the
+	// field's own schema's keywords whatever its type.
+	for _, tag := range hzSplitUnescaped(strings.Join(f.jsTags(), ",")) {
+		hzReadCons(tag, target, &val)
+	}
+	for _, tag := range hzSplitUnescaped(strings.Join(f.extras, ",")) {
+		hzReadCons(tag, &val, &val)
+	}
+	val.nullable = f.kw.nullable
+	val.nonZero = f.kw.required && (f.json.omitempty || f.json.omitzero)
+	return val, items
+}
+
+// hzReadCons adds the constraint of one tag item: the keywords of values to target, those of
+// arrays to arr.
+func hzReadCons(tag string, target, arr *hzCons) {
+	k, v, ok := strings.Cut(tag, "=")
+	if !ok {
+		return
+	}
+	switch k {
+	case "minimum", "maximum", "multipleOf":
+		n, err := strconv.ParseFloat(v, 64)
+		if err != nil {
+			return
+		}
+		switch k {
+		case "minimum":
+			target.min = &n
+		case "maximum":
+			target.max = &n
+		default:
+			target.multipleOf = n
+		}
+	case "enum":
+		if n, err := strconv.ParseFloat(v, 64); err == nil {
+			target.enumNums = append(target.enumNums, n)
+		}
+		target.enumStrs = append(target.enumStrs, v)
+	case "minLength", "maxLength":
+		if n, err := strconv.ParseUint(v, 10, 32); err == nil {
+			if k == "minLength" {
+				target.minLen = int(n)
+			} else {
+				target.maxLen = int(n)
+			}
+		}
+	case "pattern":
+		target.pattern = v
+	case "minItems", "maxItems":
+		if n, err := strconv.ParseUint(v, 10, 32); err == nil {
+			if k == "minItems" {
+				arr.minItems = int(n)
+			} else {
+				arr.maxItems = int(n)
+			}
+		}
+	case "uniqueItems":
+		if v != "false" {
+			arr.unique = true
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- values
+
+// hzVal is a value of a type, or the mark that no value satisfies its constraints.
+type hzVal struct {
+	rv    reflect.Value
+	unsat bool
+}
+
+func hzSat(rv reflect.Value) hzVal { return hzVal{rv: rv} }
+
+var hzUnsat = hegel.Just(hzVal{unsat: true})
+
+// hzNumberCandidates are the numbers of the kind that honour the constraints: a small range
+// (or the enum), bounded, whole for integers, on multipleOf's grid, non-zero when required.
+func hzNumberCandidates(kind string, c hzCons) []float64 {
+	integer := kind != "float32" && kind != "float64"
+	lo, hi := -10.0, 20.0
+	if strings.HasPrefix(kind, "u") {
+		lo = 0
+	}
+	if c.min != nil && *c.min > lo {
+		lo = *c.min
+		if integer {
+			lo = math.Ceil(lo)
+		}
+	}
+	if c.max != nil && *c.max < hi {
+		hi = *c.max
+		if integer {
+			hi = math.Floor(hi)
+		}
+	}
+	var cands []float64
+	switch {
+	case len(c.enumNums) > 0:
+		for _, e := range c.enumNums {
+			if (!integer || e == math.Trunc(e)) && e >= lo && e <= hi {
+				cands = append(cands, e)
+			}
+		}
+	case integer:
+		for x := lo; x <= hi; x++ {
+			cands = append(cands, x)
+		}
+	default:
+		for x := math.Ceil(lo*2) / 2; x <= hi; x += 0.5 {
+			cands = append(cands, x)
+		}
+	}
+	var out []float64
+	for _, x := range cands {
+		if c.multipleOf != 0 {
+			if q := x / c.multipleOf; q != math.Trunc(q) {
+				continue
+			}
+		}
+		if c.nonZero && x == 0 {
+			continue
+		}
+		out = append(out, x)
+	}
+	return out
+}
+
+var hzLetters = []string{"a", "b", "z", "q", "e", "x", "y", "Z", " ", "-", ",", "=", "\u00e9", "\u65e5"}
+
+// hzTextOf is a text of lo to hi pieces of the pool (one code point each: JSON Schema counts
+// code points).
+func hzTextOf(pool []string, lo, hi int) hegel.Generator[string] {
+	return hegel.Map(hzMany(hegel.SampledFrom(pool), lo, hi), func(ps []string) string { return strings.Join(ps, "") })
+}
+
+// hzPatternTexts are texts matching each pattern of hzPatterns (as the tag is read: the
+// escaped comma unescaped); nonZero asks for a non-empty one.
+func hzPatternTexts(pattern string, nonZero bool) hegel.Generator[string] {
+	switch pattern {
+	case `^[a-z]+$`:
+		return hzTextOf([]string{"a", "b", "z", "q"}, 1, 5)
+	case `^[0-9]{2}$`:
+		return hegel.Map(hegel.Integers(10, 99), strconv.Itoa)
+	case `^a,b$`:
+		return hegel.Just("a,b")
+	case `^x*$`:
+		lo := 0
+		if nonZero {
+			lo = 1
+		}
+		return hegel.Map(hegel.Integers(lo, 3), func(n int) string { return strings.Repeat("x", n) })
+	case `^a=b$`:
+		return hegel.Just("a=b")
+	}
+	panic("hzPatternTexts: pattern " + pattern)
+}
+
+// hzStringsOf is a string honouring the constraints: one of the enum, a match of the pattern,
+// or letters within the lengths; nil when none can.
+func hzStringsOf(c hzCons) hegel.Generator[string] {
+	if len(c.enumStrs) > 0 {
+		pool := c.enumStrs
+		if c.nonZero {
+			pool = nil
+			for _, s := range c.enumStrs {
+				if s != "" {
+					pool = append(pool, s)
+				}
+			}
+			if len(pool) == 0 {
+				return nil
+			}
+		}
+		return hegel.SampledFrom(pool)
+	}
+	if c.pattern != "" {
+		return hzPatternTexts(c.pattern, c.nonZero)
+	}
+	lo, hi := 0, 5
+	if c.minLen >= 0 {
+		lo = c.minLen
+	}
+	if c.maxLen >= 0 && c.maxLen < hi {
+		hi = c.maxLen
+	}
+	if c.nonZero && lo == 0 {
+		lo = 1
+	}
+	if lo > hi {
+		return nil
+	}
+	return hzTextOf(hzLetters, lo, hi)
+}
+
+// hzTimes: a UTC instant of this century, in a fixed zone three times in ten.
+type hzTime struct {
+	y, mo, d, h, mi, s, ns int
+	zoned                  bool
+	off                    int
+}
+
+var hzTimes = hegel.Composite(func(tc hegel.TestCase) time.Time {
+	t := hzTime{
+		y: hegel.Draw(tc, hegel.Integers(0, 30)), mo: hegel.Draw(tc, hegel.Integers(1, 12)), d: hegel.Draw(tc, hegel.Integers(1, 28)),
+		h: hegel.Draw(tc, hegel.Integers(0, 23)), mi: hegel.Draw(tc, hegel.Integers(0, 59)), s: hegel.Draw(tc, hegel.Integers(0, 59)),
+		ns: hegel.Draw(tc, hegel.Integers(0, 1)), zoned: hegel.Draw(tc, hzChance(30)), off: hegel.Draw(tc, hegel.Integers(-11, 12)),
+	}
+	tm := time.Date(2000+t.y, time.Month(t.mo), t.d, t.h, t.mi, t.s, t.ns*123456789, time.UTC)
+	if t.zoned {
+		tm = tm.In(time.FixedZone("X", 3600*t.off))
+	}
+	return tm
+})
+
+var (
+	hzOctets = hegel.Integers(0, 255)
+	// hzIPs: an IPv4 address in its 16-byte and 4-byte forms, and an IPv6 one (the package
+	// gives net.IP format ipv4 whatever the address: /9).
+	hzIPs = hzWeighted(
+		hzChoice[net.IP]{1, hegel.Map(hzExactly(hzOctets, 3), func(b []int) net.IP { return net.IPv4(byte(b[0]), byte(b[1]), 0, byte(b[2])) })},
+		hzChoice[net.IP]{1, hegel.Map(hzOctets, func(b int) net.IP { return net.IP{10, 0, 0, byte(b)} })},
+		hzChoice[net.IP]{1, hzIPv6s},
+	)
+	hzIPv6s = hegel.Map(hzOctets, func(b int) net.IP {
+		ip := make(net.IP, 16)
+		ip[0], ip[1], ip[15] = 0xfe, 0x80, byte(b)
+		return ip
+	})
+	hzURLs = hegel.Composite(func(tc hegel.TestCase) url.URL {
+		u := url.URL{Scheme: "https", Host: hegel.Draw(tc, hzPick("example.com", "x.y:8080")), Path: hegel.Draw(tc, hzPick("", "/p", "/a/b"))}
+		if hegel.Draw(tc, hzChance(30)) {
+			u.RawQuery = "q=1"
+		}
+		return u
+	})
+	hzRaws       = hzPick(`{"x":1}`, `[1,2]`, `"s"`, `null`, `3`)
+	hzAnyVals    = hegel.SampledFrom([]any{"s", 1.5, float64(2), true, []any{float64(1)}, map[string]any{"k": "v"}})
+	hzStringKeys = hzPick("k", "key", "a b", "", "x", "-1", "1")
+)
+
+// hzValuesOf is a value of the reflect type rt described by t, honouring the constraints c (and
+// items for the elements of a list); depth bounds the recursion into HZNode.
+func hzValuesOf(rt reflect.Type, t *hzType, c, items hzCons, depth int) hegel.Generator[hzVal] {
+	fresh := func() reflect.Value { return reflect.New(rt).Elem() }
+	if c.unsat {
+		return hzUnsat
+	}
+	switch t.kind {
+	case "bool":
+		return hegel.Map(hzChance(50), func(b bool) hzVal {
+			v := fresh()
+			v.SetBool(b || c.nonZero)
+			return hzSat(v)
+		})
+	case "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64":
+		cands := hzNumberCandidates(t.kind, c)
+		if len(cands) == 0 {
+			return hzUnsat
+		}
+		return hegel.Map(hegel.SampledFrom(cands), func(x float64) hzVal {
+			v := fresh()
+			if strings.HasPrefix(t.kind, "u") {
+				v.SetUint(uint64(x))
+			} else {
+				v.SetInt(int64(x))
+			}
+			return hzSat(v)
+		})
+	case "float32", "float64":
+		cands := hzNumberCandidates(t.kind, c)
+		if len(cands) == 0 {
+			return hzUnsat
+		}
+		return hegel.Map(hegel.SampledFrom(cands), func(x float64) hzVal {
+			v := fresh()
+			v.SetFloat(x)
+			return hzSat(v)
+		})
+	case "string":
+		g := hzStringsOf(c)
+		if g == nil {
+			return hzUnsat
+		}
+		return hegel.Map(g, func(s string) hzVal {
+			v := fresh()
+			v.SetString(s)
+			return hzSat(v)
+		})
+	case "any":
+		// nil (JSON null) one time in five unless the value must not be zero.
+		return hegel.Map(hzWeighted(
+			hzChoice[any]{hzUnless(c.nonZero, 20), hegel.Just[any](nil)},
+			hzChoice[any]{80, hzAnyVals},
+		), func(x any) hzVal {
+			v := fresh()
+			if x != nil {
+				v.Set(reflect.ValueOf(x))
+			}
+			return hzSat(v)
+		})
+	case "time":
+		return hegel.Map(hzTimes, func(tm time.Time) hzVal { return hzSat(reflect.ValueOf(tm).Convert(rt)) })
+	case "ip":
+		return hegel.Map(hzIPs, func(ip net.IP) hzVal { return hzSat(reflect.ValueOf(ip).Convert(rt)) })
+	case "url":
+		return hegel.Map(hzURLs, func(u url.URL) hzVal { return hzSat(reflect.ValueOf(u).Convert(rt)) })
+	case "raw":
+		return hegel.Map(hzRaws, func(s string) hzVal { return hzSat(reflect.ValueOf(json.RawMessage(s)).Convert(rt)) })
+	case "bytes":
+		return hzBytesOf(rt, c)
+	case "slice":
+		if t.elem.kind == "uint8" {
+			return hzBytesOf(rt, c)
+		}
+		lo, hi := 0, 3
+		if c.minItems >= 0 {
+			lo = c.minItems
+		}
+		if c.maxItems >= 0 && c.maxItems < hi {
+			hi = c.maxItems
+		}
+		if c.nonZero && lo == 0 {
+			lo = 1
+		}
+		if lo > hi {
+			return hzUnsat
+		}
+		elems := hzValuesOf(rt.Elem(), t.elem, items, hzNoCons(), depth)
+		return hegel.Map(hzElemsOf(elems, lo, hi, c.unique), func(es []hzVal) hzVal {
+			if es == nil {
+				return hzVal{unsat: true}
+			}
+			v := reflect.MakeSlice(rt, len(es), len(es))
+			for i, e := range es {
+				v.Index(i).Set(e.rv)
+			}
+			return hzSat(v)
+		})
+	case "array":
+		if c.minItems > t.n || (c.maxItems >= 0 && c.maxItems < t.n) || (c.nonZero && t.n == 0) {
+			return hzUnsat // an impossible minItems/maxItems tag, or [0]T that omitempty always drops
+		}
+		elems := hzValuesOf(rt.Elem(), t.elem, items, hzNoCons(), depth)
+		return hegel.Map(hzElemsOf(elems, t.n, t.n, c.unique), func(es []hzVal) hzVal {
+			if es == nil {
+				return hzVal{unsat: true}
+			}
+			v := fresh()
+			for i, e := range es {
+				v.Index(i).Set(e.rv)
+			}
+			return hzSat(v)
+		})
+	case "map":
+		lo := 0
+		if c.nonZero {
+			lo = 1
+		}
+		var keys hegel.Generator[reflect.Value]
+		switch t.key {
+		case "string":
+			keys = hegel.Map(hzStringKeys, func(k string) reflect.Value { return reflect.ValueOf(k) })
+		case "int":
+			keys = hegel.Map(hegel.Integers(-3, 5), func(k int) reflect.Value { return reflect.ValueOf(k) })
+		default:
+			keys = hegel.Map(hegel.Integers(uint(0), uint(5)), func(k uint) reflect.Value { return reflect.ValueOf(k) })
+		}
+		elems := hzValuesOf(rt.Elem(), t.elem, hzNoCons(), hzNoCons(), depth)
+		entries := hegel.Composite(func(tc hegel.TestCase) hzEntry {
+			return hzEntry{key: hegel.Draw(tc, keys), val: hegel.Draw(tc, elems)}
+		})
+		return hegel.Map(hzMany(entries, lo, 3), func(es []hzEntry) hzVal {
+			m := reflect.MakeMapWithSize(rt, len(es))
+			for _, e := range es {
+				if e.val.unsat {
+					return hzVal{unsat: true}
+				}
+				m.SetMapIndex(e.key.Convert(rt.Key()), e.val.rv)
+			}
+			return hzSat(m)
+		})
+	case "ptr":
+		inner := c
+		inner.nullable = false
+		elems := hegel.Map(hzValuesOf(rt.Elem(), t.elem, inner, items, depth), func(e hzVal) hzVal {
+			if e.unsat {
+				return e
+			}
+			p := reflect.New(rt.Elem())
+			p.Elem().Set(e.rv)
+			return hzSat(p)
+		})
+		// nil (JSON null) three times in ten where the field is nullable and may be zero.
+		return hzWeighted(
+			hzChoice[hzVal]{hzUnless(!c.nullable || c.nonZero, 30), hegel.Just(hzSat(reflect.Zero(rt)))},
+			hzChoice[hzVal]{70, elems},
+		)
+	case "struct":
+		return hzStructValuesOf(rt, t, c, depth)
+	case "named":
+		return hzValuesOf(rt, hzNamedDesc[t.name], c, items, depth-1)
+	}
+	panic("hzValuesOf: " + t.kind)
+}
+
+type hzEntry struct {
+	key reflect.Value
+	val hzVal
+}
+
+// hzBytesOf: zero to four bytes (one at least when the value must not be zero).
+func hzBytesOf(rt reflect.Type, c hzCons) hegel.Generator[hzVal] {
+	lo := 0
+	if c.nonZero {
+		lo = 1
+	}
+	return hegel.Map(hzMany(hzOctets, lo, 4), func(bs []int) hzVal {
+		b := make([]byte, len(bs))
+		for i, x := range bs {
+			b[i] = byte(x)
+		}
+		return hzSat(reflect.ValueOf(b).Convert(rt))
+	})
+}
+
+// hzDistinct keeps the first of each value with equal JSON.
+// hzElemsOf: between lo and hi satisfiable elements, distinct (by their JSON) when unique:
+// then drawn from a pool a few larger than hi, so that a repeat among few values (booleans,
+// small enumerations) costs nothing; nil when the elements cannot number lo.
+func hzElemsOf(elems hegel.Generator[hzVal], lo, hi int, unique bool) hegel.Generator[[]hzVal] {
+	if !unique {
+		return hegel.Map(hzMany(elems, lo, hi), func(es []hzVal) []hzVal {
+			for _, e := range es {
+				if e.unsat {
+					return nil
+				}
+			}
+			if es == nil {
+				es = []hzVal{}
+			}
+			return es
+		})
+	}
+	return hegel.Composite(func(tc hegel.TestCase) []hzVal {
+		pool := hzDistinct(hegel.Draw(tc, hzExactly(elems, hi+3)))
+		if len(pool) < lo {
+			return nil
+		}
+		return pool[:hegel.Draw(tc, hegel.Integers(lo, min(hi, len(pool))))]
+	})
+}
+
+// hzDistinct is the satisfiable elements of es without the repeats (by their JSON).
+func hzDistinct(es []hzVal) []hzVal {
+	seen := map[string]bool{}
+	out := []hzVal{}
+	for _, e := range es {
+		if e.unsat {
+			continue
+		}
+		if b, err := json.Marshal(e.rv.Interface()); err == nil {
+			if seen[string(b)] {
+				continue
+			}
+			seen[string(b)] = true
+		}
+		out = append(out, e)
+	}
+	return out
+}
+
+func hzMentionsNode(t *hzType) bool {
+	switch t.kind {
+	case "named":
+		return t.name == "HZNode"
+	case "ptr", "slice", "array", "map":
+		return hzMentionsNode(t.elem)
+	}
+	return false
+}
+
+// hzStructValuesOf: the exported fields filled under their tags' constraints (embedded fields
+// under none, so an embedded pointer is non-nil); the recursion into HZNode ends at depth 0
+// where the field may be omitted; a struct that must not be zero but is, is unsatisfiable.
+func hzStructValuesOf(rt reflect.Type, t *hzType, c hzCons, depth int) hegel.Generator[hzVal] {
+	type fieldGen struct {
+		i   int
+		gen hegel.Generator[hzVal]
+	}
+	var gens []fieldGen
+	for i, f := range t.fields {
+		if f.unexported {
+			continue
+		}
+		if depth <= 0 && hzMentionsNode(f.typ) && (f.json.omitempty || f.json.omitzero) {
+			continue // the recursion ends here
+		}
+		fc, ic := hzFieldCons(f)
+		if f.embedded {
+			fc, ic = hzNoCons(), hzNoCons()
+		}
+		gens = append(gens, fieldGen{i, hzValuesOf(rt.Field(i).Type, f.typ, fc, ic, depth)})
+	}
+	return hegel.Composite(func(tc hegel.TestCase) hzVal {
+		v := reflect.New(rt).Elem()
+		for _, g := range gens {
+			e := hegel.Draw(tc, g.gen)
+			if e.unsat {
+				return hzVal{unsat: true}
+			}
+			v.Field(g.i).Set(e.rv)
+		}
+		if c.nonZero && v.IsZero() {
+			return hzVal{unsat: true}
+		}
+		return hzSat(v)
+	})
+}
+
+// hzValueCase is a case with a value of its type.
+type hzValueCase struct {
+	hzCase
+	val hzVal
+}
+
+func (c hzValueCase) GoString() string {
+	if c.val.unsat {
+		return c.hzCase.GoString() + ", no value satisfies the tags"
+	}
+	b, err := json.Marshal(c.val.rv.Interface())
+	if err != nil {
+		return c.hzCase.GoString() + ", value not marshalled: " + err.Error()
+	}
+	return c.hzCase.GoString() + ", value " + string(b)
+}
+
+// hzValueCasesOf is a case of cases with a value of its type.
+func hzValueCasesOf(cases hegel.Generator[hzCase]) hegel.Generator[hzValueCase] {
+	return hegel.FlatMap(cases, func(c hzCase) hegel.Generator[hzValueCase] {
+		rt := c.typ.hzReflectType()
+		return hegel.Map(hzValuesOf(rt, c.typ, hzNoCons(), hzNoCons(), 2), func(v hzVal) hzValueCase {
+			return hzValueCase{hzCase: c, val: v}
+		})
+	})
+}
+
+var hzValueCases = hzValueCasesOf(hzCases)
+
+// --------------------------------------------------------------------------- validation
+
+func hzResult(r *bool, exc string) string {
+	if r == nil {
+		if i := strings.IndexByte(exc, ':'); i > 0 {
+			return "exception " + exc[:i]
+		}
+		return "exception"
+	}
+	if *r {
+		return "valid"
+	}
+	return "invalid"
+}
+
+// hzCheckValue: the package's schema is a valid 2020-12 schema and accepts the JSON of the
+// value, as the model's schema does; a failure of either is a mismatch named by the case's
+// known shapes. The model's schema being invalid or rejecting the value is a defect of the
+// model or of the value generator: a plain failure.
+func hzCheckValue(ht *hegel.T, col *hzCollector, oracle *hzOracle, c hzCase, rt reflect.Type, inst []byte, shapes []string) {
+	pkg := hzReflectJSON(c, rt)
+	model, _ := json.Marshal(hzEmptyToTrue(hzModelSchema(c.o, c.reflected()), true))
+	r, err := oracle.ask([]string{string(pkg), string(model)}, string(inst))
+	if err != nil {
+		ht.Fatalf("oracle: %v", err)
+	}
+	if !r.SchemaOK[1] {
+		col.failClass(ht, "model schema", "type %s, options %s: the model's schema is invalid: %s\n %s", c.typ, c.o, r.SchemaErr[1], model)
+		return
+	}
+	if !r.SchemaOK[0] {
+		col.mismatch(ht, shapes, "check_schema", "type %s, options %s: the schema is invalid: %s\n schema %s", c.typ, c.o, r.SchemaErr[0], pkg)
+		return
+	}
+	if r.Results[1] == nil || !*r.Results[1] {
+		col.failClass(ht, "model rejects", "type %s, options %s: the value %s does not validate against the model's schema: %s\n schema %s", c.typ, c.o, inst, hzResult(r.Results[1], r.Exc[1])+" "+r.Exc[1], model)
+		return
+	}
+	if got := hzResult(r.Results[0], r.Exc[0]); got != "valid" {
+		col.mismatch(ht, shapes, "validity", "type %s, options %s: the value %s is %s against the schema (%s)\n schema %s", c.typ, c.o, inst, got, r.Exc[0], pkg)
+		return
+	}
+	col.count("valid")
+}
+
+func TestHegelValidate(t *testing.T) {
+	col := hzNewCollector(t)
+	oracle := hzStartOracle(t)
+	hzProperty(t, func(ht *hegel.T) {
+		vc := hegel.Draw(ht, hzValueCases)
+		col.count("root " + vc.typ.kind)
+		if vc.val.unsat {
+			col.count("unsatisfiable tags")
+			ht.Assume(false)
+		}
+		inst, err := json.Marshal(vc.val.rv.Interface())
+		if err != nil {
+			col.count("marshal error")
+			ht.Assume(false)
+		}
+		hzCheckValue(ht, col, oracle, vc.hzCase, vc.val.rv.Type(), inst, HZKnown.explains(vc.typ, vc.o))
+	})
+}
