+// sonic on its own: Unmarshal(Marshal(v)) re-encodes to the same bytes, for
+// the struct universe and for interface{} trees.
+func TestHegelMarshalUnmarshalRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		if chance(ht, 60) {
+			v := genRich(ht)
+			text, err := api.Marshal(v)
+			if err != nil {
+				fail(ht, "Marshal: %v", err)
+			}
+			note(ht, "text: %s", short(text))
+			var back hgRich
+			if err := api.Unmarshal(text, &back); err != nil {
+				fail(ht, "Unmarshal of Marshal output: %v", err)
+			}
+			again, err := api.Marshal(back)
+			if err != nil || string(again) != string(text) {
+				fail(ht, "round trip differs (%v) %s", err, diffAt(string(text), string(again)))
+			}
+			return
+		}
+		v := genAny(ht, 3)
+		text, err := api.Marshal(v)
+		if err != nil {
+			fail(ht, "Marshal: %v", err)
+		}
+		note(ht, "text: %s", short(text))
+		var back any
+		if err := api.Unmarshal(text, &back); err != nil {
+			fail(ht, "Unmarshal of Marshal output: %v", err)
+		}
+		if !reflect.DeepEqual(v, back) {
+			fail(ht, "round trip differs:\n original %#v\n back     %#v", v, back)
+		}
+	})
+}
