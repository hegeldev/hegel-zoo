index 0000000..e2e73ef
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1976 @@
+package sonic_test
+
+// Hegel property tests for github.com/bytedance/sonic (re-targeted from the zoo's json-iterator harness).
+//
+// The oracle is the standard library's encoding/json, loaded here as `std`.
+// sonic's ConfigStd is the configuration documented as compatible with the
+// standard library, and it is the API under test (bound to `api` below):
+// wherever the two disagree on a byte of output, a decoded value, or whether
+// an input is valid, one of them is wrong -- and the standard library is the
+// reference.  Every property draws one case record: Go values come from a rich
+// struct universe and interface{} trees, JSON texts from a tree rendered by a
+// pure writer whose whitespace, escape choices and key order come from a drawn
+// tape (an empty tape is the compact, plainly escaped, sorted text, so that is
+// what a case shrinks to).  The properties compare Marshal/MarshalIndent/
+// Encoder, Unmarshal into interface{} and into structs, Valid on valid and
+// mutated texts, and Decoder streams.  The shapes of the recorded bugs
+// (bugs.toml) are drawn at their natural rate, so the properties that meet
+// them fail, naming the shape, and are the expected failures mapped to the
+// bugs (STYLE.md rule 11); hegel_shapes_test.go has one property per bug over
+// its shape region alone, and hegel_pins_test.go the regression examples.
+// HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below) for a run
+// that looks past the bugs.
+//
+// Set SONIC_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	std "encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/bytedance/sonic"
+	"hegel.dev/go/hegel"
+)
+
+// api is the API under test (sonic.ConfigStd, the encoding/json-compatible configuration).
+var api = sonic.ConfigStd
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape (mismatch); under HEGEL_NO_KNOWN=1 the gates of Known are on and the shapes are left
+// out of the generators (shaped), and a mismatch that still has a known shape is skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known gates the input shapes of recorded sonic bugs; on means the shape is left out, which
+// is so only under HEGEL_NO_KNOWN=1. The first group came with the json-iterator harness and
+// is open here.
+var Known = struct {
+	emptyMaps       bool
+	validShapes     bool
+	indentUnsafe    bool
+	oddIndents      bool
+	topLevelNumbers bool
+	tabInsertions   bool // sonic/9: Valid accepts raw control characters inside strings (Unmarshal rejects them)
+
+	negZero         bool // sonic/1, sonic/2: -0 inside a container or field decodes as +0, and is not "empty"
+	stringOptEscape bool // sonic/3: a `,string` string field escapes <, >, &, U+2028/9 at the outer level only
+	validBadEscapes bool // sonic/4: Valid accepts malformed escapes (\x, \u00x2, \u12) that Unmarshal rejects
+	strayCloser     bool // sonic/5: Decoder.Decode reads a stray ] or } as no error, forever
+	eofGarbage      bool // sonic/6: a stray comma or a truncated literal makes Decode report io.EOF
+	streamNumbers   bool // sonic/7: a bare number in a stream loses the values after it
+}{
+	tabInsertions:   noKnown,
+	negZero:         noKnown,
+	stringOptEscape: noKnown,
+	validBadEscapes: noKnown,
+	strayCloser:     noKnown,
+	eofGarbage:      noKnown,
+	streamNumbers:   noKnown,
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// isNegZero reports whether a number literal (any spelling) is a negative zero.
+func isNegZero(lit string) bool {
+	f, err := strconv.ParseFloat(lit, 64)
+	return err == nil && f == 0 && math.Signbit(f)
+}
+
+// noNegZero rewrites a "-0" literal (any spelling) as "0" under HEGEL_NO_KNOWN=1 (sonic/1).
+func noNegZero(lit string) string {
+	if Known.negZero && isNegZero(lit) {
+		return lit[1:]
+	}
+	return lit
+}
+
+// ---------------------------------------------------------------------------
+// The shapes of the recorded bugs, named on a mismatch.
+
+// valueHasNegZero reports whether a Go value holds a negative zero float anywhere (a field, an
+// element, a map value, an interface{}): the shape of sonic/1 for the decoders.
+func valueHasNegZero(v reflect.Value) bool {
+	switch v.Kind() {
+	case reflect.Float32, reflect.Float64:
+		f := v.Float()
+		return f == 0 && math.Signbit(f)
+	case reflect.Interface, reflect.Pointer:
+		return !v.IsNil() && valueHasNegZero(v.Elem())
+	case reflect.Map:
+		it := v.MapRange()
+		for it.Next() {
+			if valueHasNegZero(it.Value()) {
+				return true
+			}
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if valueHasNegZero(v.Index(i)) {
+				return true
+			}
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).IsExported() && valueHasNegZero(v.Field(i)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// treeHasNegZero reports whether a JSON tree holds a negative zero literal: the shape of
+// sonic/1 for Unmarshal into interface{} (the plain "-0" loses its sign at the top level too).
+func treeHasNegZero(v any) bool {
+	switch x := v.(type) {
+	case jnum:
+		return isNegZero(string(x))
+	case []any:
+		for _, e := range x {
+			if treeHasNegZero(e) {
+				return true
+			}
+		}
+	case jobj:
+		for _, p := range x {
+			if treeHasNegZero(p.v) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// negZeroShape is "sonic/1" when has holds, else "".
+func negZeroShape(has bool) string {
+	if has {
+		return "sonic/1"
+	}
+	return ""
+}
+
+// marshalShape names the recorded bug whose shape a value has for the encoders: an hgRich whose
+// omitempty float64 is a negative zero (sonic/2), or whose `,string` string holds <, >, & or
+// U+2028/9 (sonic/3); "" for neither.
+func marshalShape(v any) string {
+	r, ok := v.(hgRich)
+	if p, isPtr := v.(*hgRich); isPtr && p != nil {
+		r, ok = *p, true
+	}
+	switch {
+	case !ok:
+		return ""
+	case r.F64 == 0 && math.Signbit(r.F64):
+		return "sonic/2"
+	case strings.ContainsAny(r.SS, "<>&\u2028\u2029"):
+		return "sonic/3"
+	}
+	return ""
+}
+
+// stringShape scans the string literals of a JSON text (which may be malformed) and names the
+// recorded bug whose shape they have: a raw control character inside one (sonic/9), or a
+// malformed escape - a backslash before a character that starts no escape, or \u with fewer
+// than four hex digits (sonic/4); "" for neither.
+func stringShape(s string) string {
+	in := false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case !in:
+			in = c == '"'
+		case c == '"':
+			in = false
+		case c < 0x20:
+			return "sonic/9"
+		case c == '\\':
+			i++
+			if i >= len(s) {
+				return ""
+			}
+			if s[i] == 'u' {
+				for j := 0; j < 4; j++ {
+					i++
+					if i >= len(s) || !strings.ContainsRune("0123456789abcdefABCDEF", rune(s[i])) {
+						return "sonic/4"
+					}
+				}
+			} else if !strings.ContainsRune(`"\/bfnrt`, rune(s[i])) {
+				return "sonic/4"
+			}
+		}
+	}
+	return ""
+}
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// collected is the panic value fail() raises in collect mode; property()
+// swallows it so that the case counts as passed and the run goes on.
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("SONIC_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// mismatch reports a disagreement with the oracle on a case whose shape is that of the
+// recorded bug shape names ("" for none): the failure names the shape, and under
+// HEGEL_NO_KNOWN=1 a disagreement on a known shape is skipped instead (rare then, since the
+// generators leave the shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a failure
+// of the current test case (hegel-go re-raises panics after shrinking, which would abort the
+// test binary and hide every later test). Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 60 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// asAny is g as a generator of any (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[any] {
+	return hegel.Map(g, func(x T) any { return x })
+}
+
+// nonNil and nonNilMap make an empty collection a non-nil one (Lists and Maps yield nil for
+// zero elements, and both libraries write a nil slice or map as null).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+func nonNilMap[K comparable, V any](m map[K]V) map[K]V {
+	if m == nil {
+		return map[K]V{}
+	}
+	return m
+}
+
+// positions: an index into live data of unknown size, taken modulo the size when applied (so
+// every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// tape is a drawn list of small integers that a pure writer consumes in order, recycled
+// modulo its length, for the choices a JSON text leaves free (whitespace, an escape's
+// spelling, the order of an object's members). An empty tape answers 0 to every question,
+// so the shrunk form of every choice is its first, plainest one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// tapes: up to a hundred values of 0 to 99.
+var tapes = many(hegel.Integers(0, 99), 0, 100)
+
+// ---------------------------------------------------------------------------
+// The struct universe.
+
+// hgText is a TextMarshaler (value receiver) / TextUnmarshaler (pointer
+// receiver) pair; it is used both as a field and as a map key type below.
+type hgText struct{ V string }
+
+func (x hgText) MarshalText() ([]byte, error) { return []byte("t:" + x.V), nil }
+
+func (x *hgText) UnmarshalText(b []byte) error {
+	s := string(b)
+	if !strings.HasPrefix(s, "t:") {
+		return fmt.Errorf("hgText: bad text %q", s)
+	}
+	x.V = s[2:]
+	return nil
+}
+
+// hgKey is a TextMarshaler map key whose text sorts like its number.
+type hgKey struct{ K uint8 }
+
+func (k hgKey) MarshalText() ([]byte, error) { return []byte(fmt.Sprintf("k%03d", k.K)), nil }
+
+func (k *hgKey) UnmarshalText(b []byte) error {
+	v, err := strconv.Atoi(strings.TrimPrefix(string(b), "k"))
+	if err != nil || v < 0 || v > 255 {
+		return fmt.Errorf("hgKey: bad key %q", b)
+	}
+	k.K = uint8(v)
+	return nil
+}
+
+// hgMarsh is a value-receiver Marshaler with a pointer-receiver Unmarshaler.
+// Its output is a compact scalar (`"m:<v>"`): encoding/json compacts and
+// re-indents a Marshaler's output where json-iterator copied it verbatim (a
+// pin of that harness), so a container or whitespace here would only find
+// that shape again.
+type hgMarsh struct{ V int32 }
+
+func (m hgMarsh) MarshalJSON() ([]byte, error) {
+	return []byte(fmt.Sprintf("\"m:%d\"", m.V)), nil
+}
+
+func (m *hgMarsh) UnmarshalJSON(b []byte) error {
+	var w string
+	if err := std.Unmarshal(b, &w); err != nil {
+		return err
+	}
+	v, err := strconv.ParseInt(strings.TrimPrefix(w, "m:"), 10, 32)
+	if err != nil || !strings.HasPrefix(w, "m:") {
+		return fmt.Errorf("hgMarsh: bad text %q", w)
+	}
+	m.V = int32(v)
+	return nil
+}
+
+type hgInner struct {
+	A int      `json:"a"`
+	B string   `json:"b,omitempty"`
+	C *float64 `json:"c,omitempty"`
+}
+
+// HgEmbedded is exported so that it can be embedded and decoded into.
+type HgEmbedded struct {
+	E1 uint16   `json:"e1"`
+	E2 []string `json:"e2,omitempty"`
+}
+
+// hgRich exercises most of the encoding/json struct vocabulary: embedding,
+// pointers, every integer width, both float widths, the `string` option on
+// integers and on a string, omitempty on scalars and containers, []byte, a
+// fixed array, slices of structs, maps with string / integer / TextMarshaler
+// keys, Number, RawMessage, Marshaler and TextMarshaler fields, interface{},
+// `-`, `-,` and an unexported field.  Its keys are pairwise distinct even
+// case-insensitively, so the struct property may vary their case.
+type hgRich struct {
+	HgEmbedded
+	P     *hgInner         `json:"p"`
+	I8    int8             `json:"i8"`
+	I16   int16            `json:"i16,omitempty"`
+	I32   int32            `json:"i32,string"`
+	I64   int64            `json:"i64"`
+	U8    uint8            `json:"u8"`
+	U32   uint32           `json:"u32,omitempty"`
+	U64   uint64           `json:"u64,string"`
+	F32   float32          `json:"f32"`
+	F64   float64          `json:"f64,omitempty"`
+	S     string           `json:"s"`
+	SS    string           `json:"ss,string"`
+	B     bool             `json:"b,omitempty"`
+	Bs    []byte           `json:"bs"`
+	Arr   [3]int16         `json:"arr"`
+	Sl    []hgInner        `json:"sl,omitempty"`
+	M     map[string]int   `json:"m,omitempty"`
+	MI    map[int32]string `json:"mi"`
+	MT    map[hgKey]bool   `json:"mt,omitempty"`
+	N     std.Number       `json:"n,omitempty"`
+	R     std.RawMessage   `json:"r,omitempty"`
+	T     hgText           `json:"t"`
+	TP    *hgText          `json:"tp,omitempty"`
+	J     hgMarsh          `json:"j"`
+	Any   any              `json:"any"`
+	Skip  int              `json:"-"`
+	Dash  int              `json:"-,"`
+	Lower int              `json:"lower"`
+	NoTag int
+	//lint:ignore U1000 deliberately unexported, must be ignored by both encoders
+	hidden int
+}
+
+// ---------------------------------------------------------------------------
+// Generators for Go values.
+
+var stringPieces = []string{
+	"", "a", "Z", "0", "hello", "x y", " ", "\"", "\\", "/", "<", ">", "&", "'",
+	"\n", "\t", "\r", "\x00", "\x01", "\x1f", "\x7f",
+	"é", "日本", "😀", "\u2028", "\u2029", "\ufffd", "ÿ", "\U0010ffff", "\u00a0",
+	"{", "}", "[", "]", ",", ":", "null", "true", "1e5", "-0",
+}
+
+const keyAlphabet = "abcxyzABCXYZ0189-_.:/#$%'()*+,;=?@[]^{}|~éü日 !\"\\<>&\n\u2028"
+
+var (
+	// strPieces: a piece of a string: one of the pieces above seventeen times in twenty, else
+	// a rune of the first Unicode blocks.
+	strPieces = weighted(
+		choice[string]{85, hegel.SampledFrom(stringPieces)},
+		choice[string]{15, hegel.Map(hegel.Integers[rune](0x20, 0x2fff), func(r rune) string { return string(r) })},
+	)
+	// strs: up to six pieces: a valid-UTF-8 string covering ASCII punctuation, quotes and
+	// backslashes, control characters, HTML-significant characters, U+2028/2029 and non-BMP
+	// runes. Invalid UTF-8 is not generated (the two libraries write it differently, see the
+	// README's catalogue) and U+0008, U+000B and U+000C are left to textStrs.
+	strs = hegel.Map(many(strPieces, 0, 6), func(ps []string) string { return strings.Join(ps, "") })
+	// mapKeys: a map key (possibly empty) from an alphabet that includes characters needing
+	// escapes, so that key sorting and key escaping are both exercised.
+	mapKeys = hegel.Text().Alphabet(keyAlphabet).MaxSize(5)
+	// textStrs: strs with a few more control characters three times in twenty, for JSON
+	// texts that are only decoded.
+	textStrs = hegel.Map(pairs(strs, maybe(15, hegel.SampledFrom([]string{"\b", "\f", "a\bb\fc", "\x0b"}))), func(p pair[string, string]) string { return p.a + p.b })
+	strLists = many(strs, 0, 3)
+	// byteSlices: up to eight bytes, empty but not nil when there are none.
+	byteSlices = hegel.Map(hegel.Binary(0, 8), nonNil[byte])
+)
+
+var (
+	u32s = hegel.Integers[uint32](0, math.MaxUint32)
+	i32s = hegel.Integers[int32](math.MinInt32, math.MaxInt32)
+	// uint64s: within a thousand once in four, within 32 bits once, else of any width.
+	uint64s = weighted(
+		choice[uint64]{1, hegel.Integers[uint64](0, 1000)},
+		choice[uint64]{1, hegel.Integers[uint64](0, math.MaxUint32)},
+		choice[uint64]{2, hegel.Map(pairs(u32s, u32s), func(p pair[uint32, uint32]) uint64 { return uint64(p.a)<<32 | uint64(p.b) })},
+	)
+	// int64s: within a thousand once in four, at an edge of int64 or of the exact float64
+	// integers once, else the bits of a uint64.
+	int64s = weighted(
+		choice[int64]{1, hegel.Integers[int64](-1000, 1000)},
+		choice[int64]{1, hegel.SampledFrom([]int64{math.MinInt64, math.MaxInt64, -1 << 53, 1 << 53, 1<<53 + 1, -(1<<53 + 1)})},
+		choice[int64]{2, hegel.Map(uint64s, func(u uint64) int64 { return int64(u) })},
+	)
+)
+
+var floatEdges = []float64{0.1, 0.5, 1.0 / 3, 1e20, 1e21, 123456789012345680000, math.MaxFloat64, math.SmallestNonzeroFloat64, 5e-324, 1e-10, 1e-100, 2.5e-300}
+
+func isFinite(f float64) bool { return !math.IsNaN(f) && !math.IsInf(f, 0) }
+
+// floatBases: a finite float64 within the range of a float of `bits` bits, of eight kinds as
+// often as each other: zero, a negative zero (the shape of sonic/1 and sonic/2; a plain zero
+// under HEGEL_NO_KNOWN=1), an integer within a million, a decimal of up to six places, a tiny value (down to the
+// width's smallest denormal), a huge value at or above 1e21 (where encoding/json switches to
+// exponent form), the float of random bits (NaN and the infinities filtered out:
+// encoding/json rejects them, one draw in two thousand), or an edge.
+func floatBases(bits int) hegel.Generator[float64] {
+	maxExp, tinyExp, edges := 300, 1074, floatEdges
+	bitFloats := hegel.Map(uint64s, math.Float64frombits)
+	if bits == 32 {
+		maxExp, tinyExp, edges = 32, 149, nil
+		for _, e := range floatEdges {
+			if e <= math.MaxFloat32 {
+				edges = append(edges, e)
+			}
+		}
+		bitFloats = hegel.Map(u32s, func(u uint32) float64 { return float64(math.Float32frombits(u)) })
+	}
+	negZero := hegel.Just(math.Copysign(0, -1))
+	if Known.negZero {
+		negZero = hegel.Just(0.0)
+	}
+	return weighted(
+		choice[float64]{1, hegel.Just(0.0)},
+		choice[float64]{1, negZero},
+		choice[float64]{1, hegel.Map(hegel.Integers(-1000000, 1000000), func(x int) float64 { return float64(x) })},
+		choice[float64]{1, hegel.Map(pairs(hegel.Integers(-1000000, 1000000), hegel.Integers(0, 6)), func(p pair[int, int]) float64 { return float64(p.a) / math.Pow10(p.b) })},
+		choice[float64]{1, hegel.Map(pairs(hegel.Integers(0, 1<<20), hegel.Integers(1, tinyExp)), func(p pair[int, int]) float64 { return math.Ldexp(1+float64(p.a)/float64(1<<20), -p.b) })},
+		choice[float64]{1, hegel.Map(pairs(hegel.Integers(1, 999999), hegel.Integers(21, maxExp)), func(p pair[int, int]) float64 { return float64(p.a) * math.Pow10(p.b) })},
+		choice[float64]{1, hegel.Filter(bitFloats, isFinite)},
+		choice[float64]{1, hegel.SampledFrom(edges)},
+	)
+}
+
+// signed negates three times in ten; the result is never -0 under HEGEL_NO_KNOWN=1.
+func signed(g hegel.Generator[float64]) hegel.Generator[float64] {
+	return hegel.Map(pairs(g, chance(30)), func(p pair[float64, bool]) float64 {
+		f := p.a
+		if p.b {
+			f = -f
+		}
+		if Known.negZero && f == 0 {
+			f = 0
+		}
+		return f
+	})
+}
+
+var (
+	floats = signed(floatBases(64))
+	// float32s: a signed float32 base; a tiny negative value rounds to -0, which is a plain
+	// zero again under HEGEL_NO_KNOWN=1.
+	float32s = hegel.Map(signed(floatBases(32)), func(f float64) float32 {
+		g := float32(f)
+		if Known.negZero && g == 0 {
+			g = 0
+		}
+		return g
+	})
+	inners = hegel.Composite(func(tc hegel.TestCase) hgInner {
+		return hgInner{A: hegel.Draw(tc, hegel.Integers(-100000, 100000)), B: hegel.Draw(tc, maybe(50, strs)), C: hegel.Draw(tc, optional(40, floats))}
+	})
+	innerLists = hegel.Map(many(inners, 0, 3), nonNil[hgInner])
+)
+
+// anyTrees: an interface{} tree of the kinds encoding/json itself produces (nil, bool,
+// float64, string, []any and map[string]any) with at most maxDepth levels of containers. A
+// node is a leaf (nil or a bool once in six each, a float or a string twice) three times in
+// five, else a list of up to four nodes or a map of up to four (never empty while the
+// json-iterator switch is on: MarshalIndent of an empty map was pinned there). The depth
+// counter lives in the closure and is restored by defer, so an aborted draw cannot leave it
+// stale.
+func anyTrees(maxDepth int) hegel.Generator[any] {
+	leaf := weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{2, asAny(floats)},
+		choice[any]{2, asAny(strs)},
+	)
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	lists := hegel.Map(many(child, 0, 4), nonNil[any])
+	maps := hegel.Maps(mapKeys, child).MaxSize(4)
+	if Known.emptyMaps {
+		maps = maps.MinSize(1)
+	}
+	branch := weighted(
+		choice[any]{6, leaf},
+		choice[any]{2, asAny(lists)},
+		choice[any]{2, asAny(hegel.Map(maps, nonNilMap[string, any]))},
+	)
+	node = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, leaf)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branch)
+	})
+	return node
+}
+
+var anyTrees3, anyTrees2, anyTrees1 = anyTrees(3), anyTrees(2), anyTrees(1)
+
+var (
+	hgKeys    = hegel.Map(hegel.Integers(0, 255), func(k int) hgKey { return hgKey{uint8(k)} })
+	hgTexts   = hegel.Map(strs, func(s string) hgText { return hgText{s} })
+	hgMarshes = hegel.Map(i32s, func(v int32) hgMarsh { return hgMarsh{v} })
+	// ssStrs: the `,string` string field: strs, whose <, >, & and U+2028/9 are the shape of
+	// sonic/3; without them under HEGEL_NO_KNOWN=1.
+	ssStrs = func() hegel.Generator[string] {
+		if !Known.stringOptEscape {
+			return strs
+		}
+		return hegel.Map(strs, strings.NewReplacer("<", "", ">", "", "&", "", "\u2028", "", "\u2029", "").Replace)
+	}()
+	int16Triples = hegel.Map(many(hegel.Integers(-300, 300), 3, 3), func(xs []int) (a [3]int16) {
+		for i, x := range xs {
+			a[i] = int16(x)
+		}
+		return a
+	})
+	numbers = hegel.Map(numLits, func(l string) std.Number { return std.Number(noNegZero(l)) })
+	// rawMessages: a tree of two levels rendered with a tape and compacted (the RawMessage is
+	// compact for the same reason as hgMarsh's output). Raw U+2028/U+2029 are spelled as
+	// escapes: with HTML escaping off, encoding/json before Go 1.25's rewrite copied them
+	// through while today's escapes them, and neither reading is wrong (see the README's
+	// oracle caveat); <, > and & likewise, since encoding/json HTML-escapes a RawMessage's
+	// content and json-iterator copied it. A bare null becomes [null]: it decoded to a nil
+	// RawMessage in json-iterator.
+	rawMessages = hegel.Map(pairs(trees2, tapes), func(p pair[any, []int]) std.RawMessage {
+		raw := render(p.a, p.b, false, false)
+		raw = strings.ReplaceAll(raw, "\u2028", `\u2028`)
+		raw = strings.ReplaceAll(raw, "\u2029", `\u2029`)
+		var c bytes.Buffer
+		if err := std.Compact(&c, []byte(raw)); err != nil {
+			panic(err)
+		}
+		if c.String() == "null" {
+			c.Reset()
+			c.WriteString("[null]")
+		}
+		return std.RawMessage(strings.NewReplacer("<", `\u003c`, ">", `\u003e`, "&", `\u0026`).Replace(c.String()))
+	})
+	// riches: an hgRich; the optional fields present half of the time or so, the maps
+	// non-empty when present (MarshalIndent of an empty map was pinned in json-iterator).
+	riches = hegel.Composite(func(tc hegel.TestCase) hgRich {
+		return hgRich{
+			HgEmbedded: HgEmbedded{
+				E1: uint16(hegel.Draw(tc, hegel.Integers(0, 65535))),
+				E2: hegel.Draw(tc, maybe(50, strLists)),
+			},
+			P:      hegel.Draw(tc, optional(60, inners)),
+			I8:     int8(hegel.Draw(tc, hegel.Integers(-128, 127))),
+			I16:    int16(hegel.Draw(tc, hegel.Integers(-32768, 32767))),
+			I32:    hegel.Draw(tc, i32s),
+			I64:    hegel.Draw(tc, int64s),
+			U8:     uint8(hegel.Draw(tc, hegel.Integers(0, 255))),
+			U32:    hegel.Draw(tc, u32s),
+			U64:    hegel.Draw(tc, uint64s),
+			F32:    hegel.Draw(tc, float32s),
+			F64:    hegel.Draw(tc, floats),
+			S:      hegel.Draw(tc, strs),
+			SS:     hegel.Draw(tc, ssStrs),
+			B:      hegel.Draw(tc, hegel.Booleans()),
+			Bs:     hegel.Draw(tc, maybe(70, byteSlices)),
+			Arr:    hegel.Draw(tc, int16Triples),
+			Sl:     hegel.Draw(tc, maybe(50, innerLists)),
+			M:      hegel.Draw(tc, maybe(50, hegel.Maps(mapKeys, hegel.Integers(-1000, 1000)).MinSize(1).MaxSize(4))),
+			MI:     hegel.Draw(tc, maybe(60, hegel.Maps(i32s, strs).MinSize(1).MaxSize(4))),
+			MT:     hegel.Draw(tc, maybe(40, hegel.Maps(hgKeys, hegel.Booleans()).MinSize(1).MaxSize(4))),
+			N:      hegel.Draw(tc, maybe(50, numbers)),
+			R:      hegel.Draw(tc, maybe(50, rawMessages)),
+			T:      hegel.Draw(tc, hgTexts),
+			TP:     hegel.Draw(tc, optional(40, hgTexts)),
+			J:      hegel.Draw(tc, hgMarshes),
+			Any:    hegel.Draw(tc, maybe(60, anyTrees2)),
+			Skip:   hegel.Draw(tc, hegel.Integers(1, 100)),
+			Dash:   hegel.Draw(tc, hegel.Integers(1, 100)),
+			Lower:  hegel.Draw(tc, hegel.Integers(-100, 100)),
+			NoTag:  hegel.Draw(tc, hegel.Integers(-100, 100)),
+			hidden: hegel.Draw(tc, hegel.Integers(1, 100)),
+		}
+	})
+	smallMarshes = hegel.Map(hegel.Integers(-5, 5), func(v int) hgMarsh { return hgMarsh{int32(v)} })
+	// tops: a top-level value for the encoders from the whole universe: an interface{} tree
+	// once in five, a struct three times in ten, a pointer to one, a slice of structs, a
+	// string-keyed and a TextMarshaler-keyed map, and an array of Marshalers once each.
+	tops = weighted(
+		choice[any]{2, anyTrees3},
+		choice[any]{3, asAny(riches)},
+		choice[any]{1, asAny(hegel.Map(riches, ptrTo[hgRich]))},
+		choice[any]{1, asAny(innerLists)},
+		choice[any]{1, asAny(hegel.Maps(mapKeys, inners).MinSize(1).MaxSize(3))},
+		choice[any]{1, asAny(hegel.Maps(hgKeys, anyTrees1).MinSize(1).MaxSize(3))},
+		choice[any]{1, asAny(hegel.Map(pairs(smallMarshes, smallMarshes), func(p pair[hgMarsh, hgMarsh]) [2]hgMarsh { return [2]hgMarsh{p.a, p.b} }))},
+	)
+)
+
+// ---------------------------------------------------------------------------
+// Generators for JSON texts.
+//
+// A tree is nil | bool | jnum | string | []any | jobj; jnum is a number
+// literal kept verbatim, jobj is an ordered list of pairs (duplicates
+// allowed, rarely).  render writes a tree with the whitespace and escape
+// choices of a tape.  A jraw leaf is a string literal written as it is,
+// malformed or not (hegel_shapes_test.go builds them).
+
+type jnum string
+
+type jraw string
+
+type jpair struct {
+	k string
+	v any
+}
+
+type jobj []jpair
+
+const digits = "0123456789"
+
+func digitText(lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(digits).MinSize(lo).MaxSize(hi)
+}
+
+// numLit is a JSON number literal: an optional minus, the integer digits, a fraction and an
+// exponent (each "" when absent).
+type numLit struct {
+	neg              bool
+	whole, frac, exp string
+}
+
+func (l numLit) String() string {
+	var b strings.Builder
+	if l.neg {
+		b.WriteByte('-')
+	}
+	b.WriteString(l.whole)
+	if l.frac != "" {
+		b.WriteByte('.')
+		b.WriteString(l.frac)
+	}
+	b.WriteString(l.exp)
+	return b.String()
+}
+
+var (
+	// wholes: one digit two times in five, else up to twenty digits without a leading zero.
+	wholes = weighted(
+		choice[string]{40, hegel.Map(hegel.Integers(0, 9), strconv.Itoa)},
+		choice[string]{60, hegel.Map(pairs(hegel.Integers(1, 9), digitText(0, 19)), func(p pair[int, string]) string { return strconv.Itoa(p.a) + p.b })},
+	)
+	expMarks = hegel.SampledFrom([]string{"e", "E"})
+	expSigns = hegel.SampledFrom([]string{"", "+", "-"})
+	// numLits: a valid JSON number literal whose magnitude stays inside float64 range (at
+	// most 20 integer digits and a two-digit exponent), because sonic's Valid rejects
+	// out-of-range numbers (a json-iterator pin); a literal with a "0" integer part keeps its
+	// exponent at or below 38 because Valid rejects such literals above float32 range (another
+	// one). Negative three times in ten, a fraction of up to six digits two times in five, an
+	// exponent three times in ten.
+	numLits = hegel.FlatMap(wholes, func(whole string) hegel.Generator[string] {
+		expDigits := digitText(1, 2)
+		if whole == "0" {
+			expDigits = hegel.Map(hegel.Integers(0, 38), strconv.Itoa)
+		}
+		exps := hegel.Composite(func(tc hegel.TestCase) string {
+			return hegel.Draw(tc, expMarks) + hegel.Draw(tc, expSigns) + hegel.Draw(tc, expDigits)
+		})
+		return hegel.Composite(func(tc hegel.TestCase) string {
+			return numLit{
+				neg:   hegel.Draw(tc, chance(30)),
+				whole: whole,
+				frac:  hegel.Draw(tc, maybe(40, digitText(1, 6))),
+				exp:   hegel.Draw(tc, maybe(30, exps)),
+			}.String()
+		})
+	})
+	// jnums: a number literal of a tree; never -0 under HEGEL_NO_KNOWN=1 (sonic/1).
+	jnums = hegel.Map(numLits, func(l string) jnum { return jnum(noNegZero(l)) })
+)
+
+// objEntry is a drawn member of an object: its key, or (once in ten, past the first member)
+// the key of an earlier member, pos modulo their count - a duplicate key, of which the last
+// wins.
+type objEntry struct {
+	key string
+	dup bool
+	pos int
+	v   any
+}
+
+func toObj(es []objEntry) jobj {
+	out := make(jobj, 0, len(es))
+	for i, e := range es {
+		k := e.key
+		if e.dup && i > 0 {
+			k = out[e.pos%i].k
+		}
+		out = append(out, jpair{k, e.v})
+	}
+	return out
+}
+
+// trees: a JSON tree with at most maxDepth levels of containers. A node is a leaf (null or
+// a bool once in ten each, a number or a string twice) three times in five, else an array
+// of up to four nodes or an object of up to four members once each; the depth counter lives
+// in the closure like anyTrees'.
+func trees(maxDepth int) hegel.Generator[any] {
+	leaf := weighted(
+		choice[any]{1, hegel.Just[any](nil)},
+		choice[any]{1, asAny(hegel.Booleans())},
+		choice[any]{2, asAny(jnums)},
+		choice[any]{2, asAny(textStrs)},
+	)
+	depth := 0
+	var node hegel.Generator[any]
+	child := hegel.Composite(func(tc hegel.TestCase) any { return hegel.Draw(tc, node) })
+	entries := hegel.Composite(func(tc hegel.TestCase) objEntry {
+		return objEntry{key: hegel.Draw(tc, textStrs), dup: hegel.Draw(tc, chance(10)), pos: hegel.Draw(tc, positions), v: hegel.Draw(tc, child)}
+	})
+	lists := hegel.Map(many(child, 0, 4), nonNil[any])
+	objs := hegel.Map(many(entries, 0, 4), toObj)
+	branch := weighted(
+		choice[any]{6, leaf},
+		choice[any]{2, asAny(lists)},
+		choice[any]{2, asAny(objs)},
+	)
+	node = hegel.Composite(func(tc hegel.TestCase) any {
+		if depth >= maxDepth {
+			return hegel.Draw(tc, leaf)
+		}
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, branch)
+	})
+	return node
+}
+
+var trees3, trees2, trees1 = trees(3), trees(2), trees(1)
+
+// ---------------------------------------------------------------------------
+// The writer: a pure function of a tree and a tape.
+
+var wsBytes = []byte{' ', ' ', '\t', '\n', '\r'}
+
+// ws is whitespace once in four: one to three of space (twice as likely), tab, newline and
+// return.
+func (t *tape) ws() string {
+	if !t.coin(25) {
+		return ""
+	}
+	n := 1 + t.next(3)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		b.WriteByte(wsBytes[t.next(len(wsBytes))])
+	}
+	return b.String()
+}
+
+// hexEscape is the \u escape of u, in upper case three times in ten.
+func (t *tape) hexEscape(u uint16) string {
+	s := fmt.Sprintf("\\u%04x", u)
+	if t.coin(30) {
+		s = "\\u" + strings.ToUpper(s[2:])
+	}
+	return s
+}
+
+var shortEscapes = map[rune]string{'\b': `\b`, '\f': `\f`, '\n': `\n`, '\r': `\r`, '\t': `\t`}
+
+// writeString writes s as a JSON string literal with the tape's escape choices; with plain
+// set it uses no \u escapes except for control characters.
+func (t *tape) writeString(s string, b *strings.Builder, plain bool) {
+	b.WriteByte('"')
+	// lone is set after a lone surrogate escape: the next rune is then never written as a
+	// surrogate pair (two neighbours must never form a pair; a json-iterator pin).
+	lone := false
+	for _, r := range s {
+		wasLone := lone
+		lone = false
+		switch {
+		case r == '"':
+			if !plain && t.coin(50) {
+				b.WriteString(`\u0022`)
+			} else {
+				b.WriteString(`\"`)
+			}
+		case r == '\\':
+			if !plain && t.coin(50) {
+				b.WriteString(`\u005c`)
+			} else {
+				b.WriteString(`\\`)
+			}
+		case r < 0x20:
+			if e, ok := shortEscapes[r]; ok && t.coin(60) {
+				b.WriteString(e)
+			} else {
+				b.WriteString(t.hexEscape(uint16(r)))
+			}
+		case r == '/' && !plain && t.coin(40):
+			b.WriteString(`\/`)
+		case r == '\ufffd' && !plain && t.coin(50):
+			// a lone low surrogate escape decodes to U+FFFD in both libraries
+			// (only low surrogates: two neighbours must never form a pair)
+			b.WriteString([]string{`\udc00`, `\uDFFF`}[t.next(2)])
+			lone = true
+		case !plain && t.coin(12) && !(wasLone && r > 0xffff):
+			if r > 0xffff {
+				r1, r2 := (r-0x10000)>>10+0xd800, (r-0x10000)&0x3ff+0xdc00
+				b.WriteString(t.hexEscape(uint16(r1)))
+				b.WriteString(t.hexEscape(uint16(r2)))
+			} else {
+				b.WriteString(t.hexEscape(uint16(r)))
+			}
+		default:
+			b.WriteRune(r)
+		}
+	}
+	b.WriteByte('"')
+}
+
+func (t *tape) write(v any, b *strings.Builder, plain bool) {
+	b.WriteString(t.ws())
+	switch x := v.(type) {
+	case nil:
+		b.WriteString("null")
+	case bool:
+		if x {
+			b.WriteString("true")
+		} else {
+			b.WriteString("false")
+		}
+	case jnum:
+		b.WriteString(string(x))
+	case jraw:
+		b.WriteString(string(x))
+	case string:
+		t.writeString(x, b, plain)
+	case []any:
+		b.WriteByte('[')
+		for i, e := range x {
+			if i > 0 {
+				b.WriteString(t.ws())
+				b.WriteByte(',')
+			}
+			t.write(e, b, plain)
+		}
+		b.WriteString(t.ws())
+		b.WriteByte(']')
+	case jobj:
+		b.WriteByte('{')
+		for i, p := range x {
+			if i > 0 {
+				b.WriteString(t.ws())
+				b.WriteByte(',')
+			}
+			b.WriteString(t.ws())
+			t.writeString(p.k, b, plain)
+			b.WriteString(t.ws())
+			b.WriteByte(':')
+			t.write(p.v, b, plain)
+		}
+		b.WriteString(t.ws())
+		b.WriteByte('}')
+	default:
+		panic(fmt.Sprintf("write: unexpected %T", v))
+	}
+}
+
+// render is tree as JSON text with the whitespace and escape choices of the tape (an empty
+// tape: no whitespace, the short escapes); with plain no optional \u escapes, with trailing
+// whitespace after the value.
+func render(tree any, tp []int, plain, trailing bool) string {
+	t := &tape{vals: tp}
+	var b strings.Builder
+	t.write(tree, &b, plain)
+	if trailing {
+		b.WriteString(t.ws())
+	}
+	return b.String()
+}
+
+// treeOf parses encoding/json's own encoding of a value into a tree (numbers kept verbatim)
+// whose objects' members are ordered by a rank the tape gives each (equal ranks, and so an
+// empty tape, keep the sorted order), so that it can be re-rendered with random formatting
+// and key order.
+func treeOf(canon []byte, ranks *tape) any {
+	d := std.NewDecoder(bytes.NewReader(canon))
+	d.UseNumber()
+	var v any
+	if err := d.Decode(&v); err != nil {
+		panic(fmt.Sprintf("treeOf: %v for %s", err, canon))
+	}
+	return ordered(v, ranks)
+}
+
+func ordered(v any, ranks *tape) any {
+	switch x := v.(type) {
+	case map[string]any:
+		ks := make([]string, 0, len(x))
+		for k := range x {
+			ks = append(ks, k)
+		}
+		sort.Strings(ks) // deterministic before the ranks apply
+		rank := make(map[string]int, len(ks))
+		for _, k := range ks {
+			rank[k] = ranks.next(100)
+		}
+		sort.SliceStable(ks, func(i, j int) bool { return rank[ks[i]] < rank[ks[j]] })
+		out := make(jobj, 0, len(ks))
+		for _, k := range ks {
+			out = append(out, jpair{k, ordered(x[k], ranks)})
+		}
+		return out
+	case []any:
+		out := make([]any, len(x))
+		for i, e := range x {
+			out[i] = ordered(e, ranks)
+		}
+		return out
+	case std.Number:
+		return jnum(noNegZero(string(x)))
+	default:
+		return x
+	}
+}
+
+var negativeLeadingZero = regexp.MustCompile(`-0[0-9]|-\.`)
+
+// pinnedValidShape reports whether s is a text on which json-iterator's Valid was known to
+// disagree with encoding/json (the switch is open for sonic): a complete value followed by
+// anything but whitespace, a bare top-level number, or a negative number with leading zeros
+// or no integer digit. It is decided with the oracle's decoder and a regular expression
+// only.
+func pinnedValidShape(s string) bool {
+	if !Known.validShapes {
+		return false
+	}
+	if negativeLeadingZero.MatchString(s) {
+		return true
+	}
+	d := std.NewDecoder(strings.NewReader(s))
+	var v any
+	if err := d.Decode(&v); err != nil {
+		// a syntactically valid text that fails to decode holds a number out of float64 range
+		var te *std.UnmarshalTypeError
+		return errors.As(err, &te) && std.Valid([]byte(s))
+	}
+	if _, isNum := v.(float64); isNum {
+		return true
+	}
+	// (InputOffset rather than Buffered: Go 1.27's Buffered is empty after
+	// some values even when input remains.)
+	rest := s[d.InputOffset():]
+	return strings.TrimLeft(rest, " \t\n\r") != ""
+}
+
+// ---------------------------------------------------------------------------
+// Mutations of a JSON text.
+
+// structural: the bytes a mutation deletes, duplicates or inserts: brackets, braces, commas,
+// colons, quotes, a space, letters of the literals, digits, signs, a dot, an exponent mark,
+// an x and a backslash; a tab too (inserted into a string it is the shape of sonic/9: a raw
+// control character Valid accepts and Unmarshal rejects), except under HEGEL_NO_KNOWN=1.
+var structural = func() string {
+	s := "[]{},:\" true0-+.eEx\\"
+	if !Known.tabInsertions {
+		s += "\t"
+	}
+	return s
+}()
+
+type mutKind int
+
+const (
+	mutTruncate  mutKind = iota // cut the text at a rune boundary
+	mutDelete                   // delete one structural or whitespace byte
+	mutDuplicate                // duplicate one
+	mutInsert                   // insert a structural byte at a rune boundary
+)
+
+var mutKindNames = []string{"truncate", "delete", "duplicate", "insert"}
+
+// mutation is one structural edit of a JSON text: at is an index into the text (truncate,
+// insert) or into its structural and whitespace bytes (delete, duplicate; -1 when it has
+// none, and the text stays as it is). Edits inside a multi-byte character would leave
+// invalid UTF-8, whose decoding the two libraries differ on.
+type mutation struct {
+	kind mutKind
+	at   int
+	ch   byte
+}
+
+func (m mutation) String() string {
+	if m.kind == mutInsert {
+		return fmt.Sprintf("insert %q at %d", m.ch, m.at)
+	}
+	return fmt.Sprintf("%s at %d", mutKindNames[m.kind], m.at)
+}
+
+func runeBoundary(s string, i int) int {
+	for i < len(s) && !utf8.RuneStart(s[i]) {
+		i++
+	}
+	return i
+}
+
+func structuralIndices(s string) []int {
+	var idx []int
+	for i := 0; i < len(s); i++ {
+		if strings.IndexByte(structural+" \t\n\r", s[i]) >= 0 {
+			idx = append(idx, i)
+		}
+	}
+	return idx
+}
+
+// mutationsOf: a mutation of s, each kind as often as the others, its index drawn against s.
+func mutationsOf(s string) hegel.Generator[mutation] {
+	idx := structuralIndices(s)
+	bounds := hegel.Integers(0, len(s))
+	inIdx := hegel.Just(-1)
+	if len(idx) > 0 {
+		inIdx = hegel.Map(hegel.Integers(0, len(idx)-1), func(i int) int { return idx[i] })
+	}
+	return weighted(
+		choice[mutation]{1, hegel.Map(bounds, func(i int) mutation { return mutation{kind: mutTruncate, at: i} })},
+		choice[mutation]{1, hegel.Map(inIdx, func(i int) mutation { return mutation{kind: mutDelete, at: i} })},
+		choice[mutation]{1, hegel.Map(inIdx, func(i int) mutation { return mutation{kind: mutDuplicate, at: i} })},
+		choice[mutation]{1, hegel.Map(pairs(bounds, hegel.SampledFrom([]byte(structural))), func(p pair[int, byte]) mutation {
+			return mutation{kind: mutInsert, at: p.a, ch: p.b}
+		})},
+	)
+}
+
+func (m mutation) apply(s string) string {
+	switch m.kind {
+	case mutTruncate:
+		return s[:runeBoundary(s, m.at)]
+	case mutDelete:
+		if m.at < 0 {
+			return s
+		}
+		return s[:m.at] + s[m.at+1:]
+	case mutDuplicate:
+		if m.at < 0 {
+			return s
+		}
+		return s[:m.at+1] + s[m.at:]
+	default:
+		i := runeBoundary(s, m.at)
+		return s[:i] + string(m.ch) + s[i:]
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The rest of the harness.
+
+// indents: runs of spaces only while json-iterator's switch is on (its MarshalIndent
+// panicked on anything else and its SetIndent turned it into spaces), else tabs, an empty
+// indent and letters too.
+var indents = func() hegel.Generator[string] {
+	if Known.oddIndents {
+		return hegel.SampledFrom([]string{" ", "  ", "    "})
+	}
+	return hegel.SampledFrom([]string{" ", "  ", "    ", "\t", "", "\t ", "ab"})
+}()
+
+func short(b []byte) string {
+	s := string(b)
+	if len(s) > 300 {
+		return s[:300] + "..."
+	}
+	return s
+}
+
+var rawMessageType = reflect.TypeOf(std.RawMessage(nil))
+
+// indentUnsafe reports whether v holds a shape json-iterator's MarshalIndent got wrong (the
+// switch is open for sonic): a map whose value is a container (map, slice, array or struct)
+// or a RawMessage holding a container (copied verbatim instead of re-indented). Indented
+// output is only compared for values without either.
+func indentUnsafe(v reflect.Value) bool {
+	if !Known.indentUnsafe {
+		return false
+	}
+	if v.Kind() == reflect.Slice && v.Type() == rawMessageType {
+		b := v.Bytes()
+		return len(b) > 0 && (b[0] == '[' || b[0] == '{')
+	}
+	switch v.Kind() {
+	case reflect.Interface, reflect.Pointer:
+		if v.IsNil() {
+			return false
+		}
+		return indentUnsafe(v.Elem())
+	case reflect.Map:
+		it := v.MapRange()
+		for it.Next() {
+			e := it.Value()
+			for e.Kind() == reflect.Interface || e.Kind() == reflect.Pointer {
+				if e.IsNil() {
+					break
+				}
+				e = e.Elem()
+			}
+			switch e.Kind() {
+			case reflect.Map, reflect.Slice, reflect.Array, reflect.Struct:
+				return true
+			}
+			if indentUnsafe(it.Value()) {
+				return true
+			}
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if indentUnsafe(v.Index(i)) {
+				return true
+			}
+		}
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).IsExported() && indentUnsafe(v.Field(i)) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// noEscape is the compatible configuration with HTML escaping turned off.
+var noEscape = sonic.Config{SortMapKeys: true, CompactMarshaler: true, CopyString: true, ValidateString: true}.Froze()
+
+// diffAt shows the first difference between two texts with some context.
+func diffAt(a, b string) string {
+	i := 0
+	for i < len(a) && i < len(b) && a[i] == b[i] {
+		i++
+	}
+	lo := i - 40
+	if lo < 0 {
+		lo = 0
+	}
+	cut := func(s string) string {
+		if lo >= len(s) {
+			return ""
+		}
+		hi := i + 60
+		if hi > len(s) {
+			hi = len(s)
+		}
+		return s[lo:hi]
+	}
+	return fmt.Sprintf("at byte %d:\n   a %q\n   b %q", i, cut(a), cut(b))
+}
+
+func stdJSON(v any) string {
+	b, err := std.Marshal(v)
+	if err != nil {
+		return "ERR:" + err.Error()
+	}
+	return string(b)
+}
+
+// ---------------------------------------------------------------------------
+// Cases: one record per property, drawn once.
+
+// marshalCase: the value, MarshalIndent's indent, the Encoder's second value, whether the
+// Encoder's HTML escaping is turned off (it stays on when either value holds U+2028/9, see
+// the property), and whether and how it indents.
+type marshalCase struct {
+	v         any
+	indent    string
+	second    any
+	escapeOff bool
+	indented  bool
+	indent2   string
+}
+
+func (c marshalCase) GoString() string {
+	return fmt.Sprintf("value (%T): %s\nindent %q; second %s; escapeOff=%v indented=%v indent2 %q",
+		c.v, short([]byte(stdJSON(c.v))), c.indent, short([]byte(stdJSON(c.second))), c.escapeOff, c.indented, c.indent2)
+}
+
+var marshalCases = hegel.Composite(func(tc hegel.TestCase) marshalCase {
+	return marshalCase{
+		v:         hegel.Draw(tc, tops),
+		indent:    hegel.Draw(tc, indents),
+		second:    hegel.Draw(tc, anyTrees1),
+		escapeOff: hegel.Draw(tc, chance(50)),
+		indented:  hegel.Draw(tc, chance(50)),
+		indent2:   hegel.Draw(tc, indents),
+	}
+})
+
+// textCase: a tree of three levels and the tape of its rendering (with trailing whitespace).
+type textCase struct {
+	tree any
+	tape []int
+}
+
+func (c textCase) text() string { return render(c.tree, c.tape, false, true) }
+
+func (c textCase) GoString() string {
+	return fmt.Sprintf("text %q (tape of %d)", short([]byte(c.text())), len(c.tape))
+}
+
+var textCases = hegel.Composite(func(tc hegel.TestCase) textCase {
+	return textCase{tree: hegel.Draw(tc, trees3), tape: hegel.Draw(tc, tapes)}
+})
+
+// structCase: the value; the ranks of its keys (a tape: equal ranks keep the sorted order);
+// an unknown member three times in ten, inserted at a position modulo the member count; the
+// coins that upper-case the keys once in five (recycled over the members; encoding/json
+// matches keys case-insensitively); and the tapes of the two renderings.
+type structCase struct {
+	v       hgRich
+	ranks   []int
+	unknown *any
+	at      int
+	upper   []bool
+	tape    []int
+	tape2   []int
+}
+
+// render is encoding/json's encoding of the value re-rendered twice: the tree in the drawn
+// key order, with the unknown member and the upper-cased keys, written without optional \u
+// escapes (json-iterator read `,string` numbers and integer map keys without unescaping)
+// with each tape.
+func (c structCase) render(canon []byte) (text, plain string) {
+	tree := treeOf(canon, &tape{vals: c.ranks}).(jobj)
+	if c.unknown != nil {
+		at := c.at % (len(tree) + 1)
+		tree = append(tree[:at], append(jobj{{"zz_unknown", *c.unknown}}, tree[at:]...)...)
+	}
+	if len(c.upper) > 0 {
+		for i := range tree {
+			if c.upper[i%len(c.upper)] {
+				tree[i].k = strings.ToUpper(tree[i].k)
+			}
+		}
+	}
+	return render(tree, c.tape, true, true), render(tree, c.tape2, true, true)
+}
+
+func (c structCase) GoString() string {
+	canon := stdJSON(c.v)
+	text, plain := c.render([]byte(canon))
+	return fmt.Sprintf("canonical: %s\ntext:      %s\nplain:     %s\nunknown=%v at %d, upper %v", short([]byte(canon)), short([]byte(text)), short([]byte(plain)), c.unknown != nil, c.at, c.upper)
+}
+
+var structCases = hegel.Composite(func(tc hegel.TestCase) structCase {
+	return structCase{
+		v:       hegel.Draw(tc, riches),
+		ranks:   hegel.Draw(tc, tapes),
+		unknown: hegel.Draw(tc, optional(30, trees1)),
+		at:      hegel.Draw(tc, positions),
+		upper:   hegel.Draw(tc, maybe(20, many(hegel.Booleans(), 1, 32))),
+		tape:    hegel.Draw(tc, tapes),
+		tape2:   hegel.Draw(tc, tapes),
+	}
+})
+
+// discarded reports whether a mutated text is not compared: json-iterator's Valid checked
+// only the first value, so a mutation that leaves a complete value followed by more bytes,
+// or a bare top-level number, was discarded (the switch is open here); under HEGEL_NO_KNOWN=1
+// one that makes a malformed escape (sonic/4) or leaves a raw control character inside a
+// string (sonic/9; a deleted quote before a tab or newline does) is discarded too. The
+// mutation generator filters such edits out (about one edit in seventy under
+// HEGEL_NO_KNOWN=1, none by default); the property keeps the check as a guard.
+func discarded(m string) bool {
+	if pinnedValidShape(m) {
+		return true
+	}
+	switch stringShape(m) {
+	case "sonic/4":
+		return Known.validBadEscapes
+	case "sonic/9":
+		return Known.tabInsertions
+	}
+	return false
+}
+
+// validCase: a tree rendered with a tape (trailing whitespace half of the time) and, three
+// times in five, a mutation of the text, drawn against it.
+type validCase struct {
+	tree     any
+	tape     []int
+	trailing bool
+	text     string // the rendering
+	mut      *mutation
+}
+
+func (c validCase) GoString() string {
+	s := fmt.Sprintf("text %q", short([]byte(c.text)))
+	if c.mut != nil {
+		s += fmt.Sprintf("; %v -> %q", *c.mut, short([]byte(c.mut.apply(c.text))))
+	}
+	return s
+}
+
+var validCases = hegel.FlatMap(hegel.Composite(func(tc hegel.TestCase) validCase {
+	tree := hegel.Draw(tc, trees3)
+	if _, isNum := tree.(jnum); Known.topLevelNumbers && (isNum || tree == nil) {
+		// json-iterator's Valid was pinned for top-level numbers, and a bare null into a
+		// RawMessage too
+		tree = []any{tree}
+	}
+	c := validCase{tree: tree, tape: hegel.Draw(tc, tapes), trailing: hegel.Draw(tc, chance(50))}
+	c.text = render(c.tree, c.tape, false, c.trailing)
+	return c
+}), func(c validCase) hegel.Generator[validCase] {
+	kept := hegel.Filter(mutationsOf(c.text), func(m mutation) bool { return !discarded(m.apply(c.text)) })
+	return hegel.Map(optional(60, kept), func(m *mutation) validCase {
+		c.mut = m
+		return c
+	})
+})
+
+// streamValue: a value of a stream: its tree of two levels, the tape of its rendering, and
+// the separator before it, kept seven times in ten; else written only when the two values
+// are not self-delimiting on both sides (e.g. "...]" then "{...", or "...}" then "[...").
+type streamValue struct {
+	tree    any
+	tape    []int
+	sep     string
+	keepSep bool
+}
+
+// streamCase: one to four values, then garbage three times in ten (else trailing whitespace
+// once in eight).
+type streamCase struct {
+	values  []streamValue
+	garbage string
+	trail   string
+}
+
+// render writes the stream; bare[i] reports whether value i is a bare number. A bare number
+// that is not the last value of the stream (or that garbage follows) is the shape of sonic/7:
+// with wrapNumbers (the wide property under HEGEL_NO_KNOWN=1, and the narrow properties of
+// the other stream bugs) it is wrapped in an array.
+func (c streamCase) render(wrapNumbers bool) (text string, bare []bool) {
+	var b strings.Builder
+	k := len(c.values)
+	bare = make([]bool, k)
+	for i, v := range c.values {
+		tree := v.tree
+		if _, isNum := tree.(jnum); isNum {
+			if wrapNumbers && (i < k-1 || c.garbage != "") {
+				tree = []any{tree}
+			} else {
+				bare[i] = true
+			}
+		}
+		text := render(tree, v.tape, false, false)
+		if i > 0 {
+			prev := b.String()
+			next := strings.TrimLeft(text, " \t\r\n")
+			if v.keepSep || next == "" || !strings.ContainsRune("]}\"", rune(prev[len(prev)-1])) || !strings.ContainsRune("[{\"", rune(next[0])) {
+				b.WriteString(v.sep)
+			}
+		}
+		b.WriteString(text)
+	}
+	if c.garbage != "" {
+		b.WriteString(c.garbage)
+	} else {
+		b.WriteString(c.trail)
+	}
+	return b.String(), bare
+}
+
+// text is the stream as the wide property reads it.
+func (c streamCase) text() string {
+	text, _ := c.render(Known.streamNumbers)
+	return text
+}
+
+// shape names the recorded bug whose shape a mismatch at Decode #i of the stream (or at
+// More() after value #i) has: at the Decode after the last value (i == k) the garbage tail is
+// responsible - a stray closer read as no error is sonic/5, garbage read as a clean end of
+// input (eof: a comma, a truncated literal, and after some values a stray letter too) is
+// sonic/6; before it, a bare number at or before value #i in a stream of 17 bytes or more is
+// sonic/7 (the values after the number are skipped or lost).
+func (c streamCase) shape(text string, bare []bool, i int, eof bool) string {
+	if i == len(c.values) {
+		switch closer := strings.TrimLeft(c.garbage, " \t\n\r"); {
+		case eof:
+			return "sonic/6"
+		case closer == "]" || closer == "}":
+			return "sonic/5"
+		}
+		return ""
+	}
+	if len(text) >= 17 {
+		for j := 0; j <= i && j < len(bare); j++ {
+			if bare[j] {
+				return "sonic/7"
+			}
+		}
+	}
+	return ""
+}
+
+func (c streamCase) GoString() string {
+	return fmt.Sprintf("stream %q (%d values, garbage %q)", short([]byte(c.text())), len(c.values), c.garbage)
+}
+
+var (
+	// garbageTails: what may follow a stream. An unterminated { or " is left out: after it
+	// More() at EOF was false in encoding/json before Go 1.25 and is true in today's, see the
+	// README's oracle caveat. "1." is left out: encoding/json's Decoder reads the number up to
+	// the second dot and fails on the next call, sonic fails at once. A control character is
+	// left out: after "1\x01" More() is true in encoding/json and false in sonic; both then
+	// fail. Every suffix starts with a space: "2e-0nul" makes More() true in encoding/json
+	// and false in sonic, and both then fail. A stray closer is the shape of sonic/5, a comma
+	// or a truncated literal (sonic reports io.EOF for them) that of sonic/6; the letter and
+	// the sign are syntax errors to both after a number and io.EOF to sonic after a literal,
+	// so they stay under HEGEL_NO_KNOWN=1, where the io.EOF check is off (decodesLike).
+	garbageTails = func() hegel.Generator[string] {
+		gs := []string{" x", " -"}
+		if !Known.strayCloser {
+			gs = append(gs, " ]", " }")
+		}
+		if !Known.eofGarbage {
+			gs = append(gs, ",", " ,", " tru", " nul", " \"ab")
+		}
+		return hegel.SampledFrom(gs)
+	}()
+	separators   = hegel.SampledFrom([]string{" ", "\n", "\t", " \r\n"})
+	wsRuns       = hegel.Map(many(hegel.SampledFrom(wsBytes), 1, 3), func(bs []byte) string { return string(bs) })
+	streamValues = hegel.Composite(func(tc hegel.TestCase) streamValue {
+		return streamValue{tree: hegel.Draw(tc, trees2), tape: hegel.Draw(tc, tapes), sep: hegel.Draw(tc, separators), keepSep: hegel.Draw(tc, chance(70))}
+	})
+	streamCases = hegel.Composite(func(tc hegel.TestCase) streamCase {
+		return streamCase{values: hegel.Draw(tc, many(streamValues, 1, 4)), garbage: hegel.Draw(tc, maybe(30, garbageTails)), trail: hegel.Draw(tc, maybe(12, wsRuns))}
+	})
+)
+
+// roundTripCase: an interface{} tree two times in five, else a struct of the universe.
+type roundTripCase struct{ v any }
+
+func (c roundTripCase) GoString() string {
+	return fmt.Sprintf("value (%T): %s", c.v, short([]byte(stdJSON(c.v))))
+}
+
+var roundTripCases = hegel.Map(weighted(
+	choice[any]{2, anyTrees3},
+	choice[any]{3, asAny(riches)},
+), func(v any) roundTripCase { return roundTripCase{v} })
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// Marshal, MarshalIndent and Encoder produce byte-for-byte what encoding/json
+// produces, for random values from the whole universe, with and without HTML
+// escaping and indentation. The struct universe draws a -0 in the omitempty
+// float64 (sonic/2) and an HTML character in the `,string` string (sonic/3) at
+// their natural rate, so this property fails while either is open.
+func TestHegelMarshalMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, marshalCases)
+		v := c.v
+		shape := marshalShape(v)
+
+		g, ge := api.Marshal(v)
+		w, we := std.Marshal(v)
+		if (ge == nil) != (we == nil) {
+			fail(ht, "Marshal error mismatch: sonic %v, encoding/json %v", ge, we)
+		}
+		if string(g) != string(w) {
+			mismatch(ht, shape, "Marshal differs %s", diffAt(string(g), string(w)))
+		}
+
+		// MarshalIndent's prefix is documented as unsupported, so it is always "".
+		indentOK := !indentUnsafe(reflect.ValueOf(v))
+		if indentOK {
+			gi, gie := api.MarshalIndent(v, "", c.indent)
+			wi, wie := std.MarshalIndent(v, "", c.indent)
+			if (gie == nil) != (wie == nil) || string(gi) != string(wi) {
+				mismatch(ht, shape, "MarshalIndent(%q) differs (%v, %v) %s", c.indent, gie, wie, diffAt(string(gi), string(wi)))
+			}
+		}
+
+		var gb, wb bytes.Buffer
+		genc, wenc := api.NewEncoder(&gb), std.NewEncoder(&wb)
+		// With HTML escaping off, today's encoding/json still escapes
+		// U+2028/U+2029 where sonic (and encoding/json before Go
+		// 1.25) writes them raw; neither is wrong, so escaping stays on for
+		// values containing them.
+		second := c.second
+		both := stdJSON(v) + stdJSON(second)
+		escape := !c.escapeOff || strings.Contains(both, `\u2028`) || strings.Contains(both, `\u2029`)
+		genc.SetEscapeHTML(escape)
+		wenc.SetEscapeHTML(escape)
+		if c.indented && indentOK && !indentUnsafe(reflect.ValueOf(second)) {
+			genc.SetIndent("", c.indent2)
+			wenc.SetIndent("", c.indent2)
+		}
+		for _, x := range []any{v, second} {
+			ge, we := genc.Encode(x), wenc.Encode(x)
+			if (ge == nil) != (we == nil) {
+				fail(ht, "Encoder.Encode error mismatch: sonic %v, encoding/json %v", ge, we)
+			}
+		}
+		if gb.String() != wb.String() {
+			mismatch(ht, shape, "Encoder output differs (escapeHTML=%v) %s", escape, diffAt(gb.String(), wb.String()))
+		}
+
+		// A Config with EscapeHTML off is the package-level spelling of
+		// SetEscapeHTML(false).
+		if we == nil && !escape {
+			opt, err := noEscape.Marshal(v)
+			var ref bytes.Buffer
+			enc := std.NewEncoder(&ref)
+			enc.SetEscapeHTML(false)
+			_ = enc.Encode(v)
+			want := strings.TrimSuffix(ref.String(), "\n")
+			if err != nil || string(opt) != want {
+				mismatch(ht, shape, "Marshal with EscapeHTML off differs (%v) %s", err, diffAt(string(opt), want))
+			}
+		}
+	})
+}
+
+// interfaceDecodesLike judges one valid text: Unmarshal into interface{} and Decoder.UseNumber
+// give exactly the value encoding/json gives (reflect.DeepEqual, and the re-encoding, since
+// DeepEqual takes -0 and +0 for equal), and Valid accepts it. shape names the recorded bug
+// whose shape the text has (a -0 literal, sonic/1), or "".
+func interfaceDecodesLike(ht *hegel.T, text string, topNumber bool, shape string) {
+	var g, w any
+	ge := api.Unmarshal([]byte(text), &g)
+	we := std.Unmarshal([]byte(text), &w)
+	if we != nil {
+		// a number outside float64 range: both must reject it (the verdict of the case;
+		// no drawn text reaches it, measured 0 in 4000)
+		if ge == nil {
+			fail(ht, "sonic accepts a text encoding/json rejects (%v)", we)
+		}
+		return
+	}
+	if ge != nil {
+		fail(ht, "sonic rejects a valid text: %v", ge)
+	}
+	if !reflect.DeepEqual(g, w) || stdJSON(g) != stdJSON(w) {
+		mismatch(ht, shape, "Unmarshal into interface{} differs:\n sonic %#v\n encoding/json %#v", g, w)
+	}
+
+	gd, wd := api.NewDecoder(strings.NewReader(text)), std.NewDecoder(strings.NewReader(text))
+	gd.UseNumber()
+	wd.UseNumber()
+	var gn, wn any
+	ge, we = gd.Decode(&gn), wd.Decode(&wn)
+	if ge != nil || we != nil {
+		fail(ht, "UseNumber decode errors: sonic %v, encoding/json %v", ge, we)
+	}
+	if !reflect.DeepEqual(gn, wn) {
+		mismatch(ht, shape, "UseNumber decode differs:\n sonic %#v\n encoding/json %#v", gn, wn)
+	}
+	// Valid was pinned for top-level numbers in json-iterator (the switch is open here).
+	if (!topNumber || !Known.topLevelNumbers) && !api.Valid([]byte(text)) {
+		fail(ht, "Valid is false for a text Unmarshal accepted: %q", short([]byte(text)))
+	}
+}
+
+// Unmarshal into interface{} (and Decoder.UseNumber) gives exactly the value
+// encoding/json gives, for random valid texts with random whitespace, escapes
+// and number spellings. The trees draw a -0 literal at its natural rate, so
+// this property meets sonic/1 (the sign lost inside a container, and for the
+// plain "-0" at the top level too) in some runs.
+func TestHegelUnmarshalIntoInterfaceMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, textCases)
+		_, isNum := c.tree.(jnum)
+		interfaceDecodesLike(ht, c.text(), isNum, negZeroShape(treeHasNegZero(c.tree)))
+	})
+}
+
+// Unmarshal into the struct universe: encoding/json's own encoding of a random
+// hgRich, re-rendered with random formatting and key order, decodes to the
+// same struct in both libraries (and back to the original encoding), and
+// DisallowUnknownFields rejects exactly the texts with an unknown key. The
+// universe draws a -0 in its float fields at its natural rate, so this property
+// fails while sonic/1 is open (the sign is lost on the field path).
+func TestHegelUnmarshalIntoStructsMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, structCases)
+		v := c.v
+		shape := negZeroShape(valueHasNegZero(reflect.ValueOf(v)))
+		canon, err := std.Marshal(v)
+		if err != nil {
+			fail(ht, "encoding/json cannot encode the generated value: %v", err)
+		}
+		text, plain := c.render(canon)
+		unknown := c.unknown != nil
+
+		var a, b hgRich
+		ea, eb := api.Unmarshal([]byte(text), &a), std.Unmarshal([]byte(text), &b)
+		if eb != nil {
+			fail(ht, "encoding/json rejects its own re-rendered encoding: %v", eb)
+		}
+		if ea != nil {
+			fail(ht, "sonic rejects the text: %v", ea)
+		}
+		ja, jb := stdJSON(a), stdJSON(b)
+		if ja != jb {
+			mismatch(ht, shape, "decoded structs differ %s\n text %q", diffAt(ja, jb), short([]byte(text)))
+		}
+		// The RawMessage keeps the re-rendered bytes verbatim, so it is left
+		// out of the comparison with the original encoding.
+		v.R, a.R = nil, nil
+		canonNoRaw := stdJSON(v)
+		if stdJSON(a) != canonNoRaw {
+			mismatch(ht, shape, "round trip lost information:\n decoded  %s\n original %s", short([]byte(stdJSON(a))), short([]byte(canonNoRaw)))
+		}
+
+		// The stream Decoder gets the same tree rendered again.
+		var da, db hgRich
+		gd, wd := api.NewDecoder(strings.NewReader(plain)), std.NewDecoder(strings.NewReader(plain))
+		gd.DisallowUnknownFields()
+		wd.DisallowUnknownFields()
+		ea, eb = gd.Decode(&da), wd.Decode(&db)
+		if (eb != nil) != unknown {
+			fail(ht, "encoding/json DisallowUnknownFields: unknown=%v err=%v", unknown, eb)
+		}
+		if (ea != nil) != unknown {
+			fail(ht, "sonic DisallowUnknownFields: unknown key present=%v but err=%v", unknown, ea)
+		}
+		da.R = nil
+		if !unknown && stdJSON(da) != canonNoRaw {
+			mismatch(ht, shape, "Decoder.Decode differs from the original:\n decoded  %s\n original %s", short([]byte(stdJSON(da))), short([]byte(canonNoRaw)))
+		}
+	})
+}
+
+// validAgrees judges one text, valid or not: Valid and the Unmarshal verdicts (into
+// interface{} and into RawMessage) agree with encoding/json's, and so do the decoded values
+// when there are any. shape names the recorded bug whose shape the text has (stringShape:
+// a malformed escape, sonic/4; a raw control character in a string, sonic/9), or "".
+func validAgrees(ht *hegel.T, text string, shape string) {
+	gv, wv := api.Valid([]byte(text)), std.Valid([]byte(text))
+	if gv != wv {
+		mismatch(ht, shape, "Valid differs: sonic %v, encoding/json %v: %q", gv, wv, short([]byte(text)))
+	}
+
+	var g, w any
+	ge := api.Unmarshal([]byte(text), &g)
+	we := std.Unmarshal([]byte(text), &w)
+	if (ge == nil) != (we == nil) {
+		mismatch(ht, shape, "Unmarshal verdict differs: sonic %v, encoding/json %v: %q", ge, we, short([]byte(text)))
+	}
+	if we == nil && !reflect.DeepEqual(g, w) {
+		fail(ht, "Unmarshal into interface{} differs:\n sonic %#v\n encoding/json %#v", g, w)
+	}
+	if we == nil && !wv {
+		fail(ht, "encoding/json: Unmarshal accepts what Valid rejects")
+	}
+
+	var gr, wr std.RawMessage
+	ge, we = api.Unmarshal([]byte(text), &gr), std.Unmarshal([]byte(text), &wr)
+	if (ge == nil) != (we == nil) {
+		mismatch(ht, shape, "Unmarshal into RawMessage verdict differs: sonic %v, encoding/json %v: %q", ge, we, short([]byte(text)))
+	}
+	if we == nil && string(gr) != string(wr) {
+		fail(ht, "Unmarshal into RawMessage differs:\n sonic %q\n encoding/json %q", short(gr), short(wr))
+	}
+}
+
+// Valid and Unmarshal agree with encoding/json on whether a text is valid,
+// for random valid texts and for texts with one structural mutation (which
+// are usually invalid), and on the decoded value when it is. The mutations
+// draw the shapes of sonic/4 (a backslash inserted before a letter) and
+// sonic/9 (a tab inserted into a string) at their natural rate, so this
+// property fails while either is open.
+func TestHegelValidMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, validCases)
+		text := c.text
+		if c.mut != nil {
+			// the generator filtered the discarded shapes out; this is the guard
+			if m := c.mut.apply(c.text); !discarded(m) {
+				text = m
+			}
+		}
+		validAgrees(ht, text, stringShape(text))
+	})
+}
+
+// decodesLike judges one stream of k values read from the readers open returns: both
+// Decoders give the same values, the same error verdicts and the same More() answers. Only
+// the presence of an error is compared, except that io.EOF, the Decoder's documented clean
+// end of input, is a verdict of its own: sonic reporting it where encoding/json reports an
+// error is a mismatch (the shape of sonic/6, so that check alone is left out under
+// HEGEL_NO_KNOWN=1 and the rest of the case is judged). The k values are compared; the Decode
+// after the last one only when garbage follows (tail), because at the end of the stream
+// json-iterator did not return io.EOF (the switch is open here). shape names the recorded
+// bug whose shape a mismatch at Decode #i (or at More() after value #i) has, eof saying
+// whether it is the clean end against an error; "" for none.
+func decodesLike(ht *hegel.T, stream string, k int, tail bool, open func() io.Reader, shape func(i int, eof bool) string) {
+	last := k - 1
+	if tail {
+		last = k
+	}
+	gd, wd := api.NewDecoder(open()), std.NewDecoder(open())
+	for i := 0; i <= last; i++ {
+		var gv, wv any
+		ge, we := gd.Decode(&gv), wd.Decode(&wv)
+		if (ge == nil) != (we == nil) {
+			mismatch(ht, shape(i, false), "Decode #%d error mismatch: sonic %v, encoding/json %v: %q", i, ge, we, short([]byte(stream)))
+		}
+		if we != nil {
+			if !Known.eofGarbage && errors.Is(ge, io.EOF) != errors.Is(we, io.EOF) {
+				mismatch(ht, shape(i, true), "Decode #%d: sonic %v, encoding/json %v (a clean end of input against an error): %q", i, ge, we, short([]byte(stream)))
+			}
+			break
+		}
+		if !reflect.DeepEqual(gv, wv) {
+			mismatch(ht, shape(i, false), "Decode #%d differs:\n sonic %#v\n encoding/json %#v\n stream %q", i, gv, wv, short([]byte(stream)))
+		}
+		if gm, wm := gd.More(), wd.More(); gm != wm {
+			mismatch(ht, shape(i, false), "More() after value #%d: sonic %v, encoding/json %v: %q", i, gm, wm, short([]byte(stream)))
+		}
+	}
+
+	// (sonic's Decoder has no Token method.)
+}
+
+// A Decoder reading a stream of values (optionally followed by garbage) yields
+// the same values, errors and More() answers as encoding/json's Decoder. The
+// stream draws a bare number followed by more values (sonic/7), a stray closer
+// (sonic/5) and garbage sonic reads as a clean end of input (sonic/6) at their
+// natural rates, so this property fails while any of them is open.
+func TestHegelDecoderStreamMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, streamCases)
+		stream, bare := c.render(Known.streamNumbers)
+		decodesLike(ht, stream, len(c.values), c.garbage != "",
+			func() io.Reader { return strings.NewReader(stream) },
+			func(i int, eof bool) string { return c.shape(stream, bare, i, eof) })
+	})
+}
+
+// sonic on its own: Unmarshal(Marshal(v)) re-encodes to the same bytes, for
+// the struct universe and for interface{} trees. A struct with a -0 float
+// field is written as -0 and read back as +0 (sonic/1), so this property fails
+// while that is open; an interface{} tree with a -0 passes, since
+// reflect.DeepEqual takes -0 and +0 for equal.
+func TestHegelMarshalUnmarshalRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch v := hegel.Draw(ht, roundTripCases).v.(type) {
+		case hgRich:
+			shape := negZeroShape(valueHasNegZero(reflect.ValueOf(v)))
+			text, err := api.Marshal(v)
+			if err != nil {
+				fail(ht, "Marshal: %v", err)
+			}
+			var back hgRich
+			if err := api.Unmarshal(text, &back); err != nil {
+				fail(ht, "Unmarshal of Marshal output: %v", err)
+			}
+			again, err := api.Marshal(back)
+			if err != nil || string(again) != string(text) {
+				mismatch(ht, shape, "round trip differs (%v) %s", err, diffAt(string(text), string(again)))
+			}
+		default:
+			text, err := api.Marshal(v)
+			if err != nil {
+				fail(ht, "Marshal: %v", err)
+			}
+			var back any
+			if err := api.Unmarshal(text, &back); err != nil {
+				fail(ht, "Unmarshal of Marshal output: %v", err)
+			}
+			if !reflect.DeepEqual(v, back) {
+				fail(ht, "round trip differs:\n original %#v\n back     %#v", v, back)
+			}
+		}
+	})
+}
