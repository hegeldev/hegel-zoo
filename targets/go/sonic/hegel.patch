+// A Decoder reading a stream of values (optionally followed by garbage) yields
+// the same values, errors, More() answers and Token() sequence as
+// encoding/json's Decoder.
+func TestHegelDecoderStreamMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		garbage := chance(ht, 30)
+		var b strings.Builder
+		for i := 0; i < k; i++ {
+			tree := genTree(ht, 2)
+			if _, isNum := tree.(jnum); isNum && Known.streamNumbers && (i < k-1 || garbage) {
+				tree = []any{tree} // sonic/7: a bare number that is not the last value of the stream
+			}
+			text := emitText(ht, tree, false)
+			if i > 0 {
+				// The separator is dropped only between two values that are
+				// self-delimiting on both sides (e.g. "...]" then "{...", or "...}" then "[...").
+				prev := b.String()
+				next := strings.TrimLeft(text, " \t\r\n")
+				if chance(ht, 70) || next == "" || !strings.ContainsRune("]}\"", rune(prev[len(prev)-1])) || !strings.ContainsRune("[{\"", rune(next[0])) {
+					b.WriteString(pick(ht, []string{" ", "\n", "\t", " \r\n"}))
+				}
+			}
+			b.WriteString(text)
+		}
+		if garbage {
+			// Trailing garbage (an unterminated { or " is left out: after it
+			// More() at EOF was false in encoding/json before Go 1.25 and is
+			// true in today's, see the README's oracle caveat).
+			// ("1." is left out: encoding/json's Decoder reads the number up to
+			// the second dot and fails on the next call, sonic fails
+			// at once; see the README.)
+			// (A control character is left out: after "1\x01" More() is true in encoding/json and
+			// false in sonic; both then fail, see the README.)
+			// (Every suffix starts with a space: "2e-0nul" makes More() true in encoding/json and
+			// false in sonic, and both then fail; see the README.)
+			garbageBytes := []string{" x", " -", " tru", " nul", " \"ab"}
+			if !Known.strayCloser {
+				garbageBytes = append(garbageBytes, " ]", " }")
+			}
+			if !Known.eofGarbage {
+				garbageBytes = append(garbageBytes, ",", " ,")
+			}
+			b.WriteString(pick(ht, garbageBytes))
+		} else if chance(ht, 50) {
+			b.WriteString(ws(ht))
+		}
+		stream := b.String()
+		note(ht, "stream: %q", short([]byte(stream)))
+
+		// The k values are compared; the Decode after the last one is only
+		// compared when garbage follows, because at the end of the stream
+		// sonic does not return io.EOF (TestHegelPinDecoderReturnsEOFAtTheEnd).
+		last := k - 1
+		if garbage {
+			last = k
+		}
+		gd, wd := api.NewDecoder(strings.NewReader(stream)), std.NewDecoder(strings.NewReader(stream))
+		for i := 0; i <= last; i++ {
+			var gv, wv any
+			ge, we := gd.Decode(&gv), wd.Decode(&wv)
+			if (ge == nil) != (we == nil) {
+				fail(ht, "Decode #%d error mismatch: sonic %v, encoding/json %v: %q", i, ge, we, short([]byte(stream)))
+			}
+			if we != nil {
+				break
+			}
+			if !reflect.DeepEqual(gv, wv) {
+				fail(ht, "Decode #%d differs:\n sonic %#v\n encoding/json %#v\n stream %q", i, gv, wv, short([]byte(stream)))
+			}
+			if gm, wm := gd.More(), wd.More(); gm != wm {
+				fail(ht, "More() after value #%d: sonic %v, encoding/json %v: %q", i, gm, wm, short([]byte(stream)))
+			}
+		}
+
+		// (sonic's Decoder has no Token method.)
+	})
+}
