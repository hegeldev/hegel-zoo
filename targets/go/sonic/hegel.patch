+// Unmarshal into interface{} (and Decoder.UseNumber) gives exactly the value
+// encoding/json gives, for random valid texts with random whitespace, escapes
+// and number spellings.
+func TestHegelUnmarshalIntoInterfaceMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tree := genTree(ht, 3)
+		text := emitText(ht, tree, true)
+		note(ht, "text: %q", short([]byte(text)))
+
+		var g, w any
+		ge := api.Unmarshal([]byte(text), &g)
+		we := std.Unmarshal([]byte(text), &w)
+		if we != nil {
+			// a number outside float64 range: both must reject it
+			if ge == nil {
+				fail(ht, "sonic accepts a text encoding/json rejects (%v)", we)
+			}
+			return
+		}
+		if ge != nil {
+			fail(ht, "sonic rejects a valid text: %v", ge)
+		}
+		if !reflect.DeepEqual(g, w) {
+			fail(ht, "Unmarshal into interface{} differs:\n sonic %#v\n encoding/json %#v", g, w)
+		}
+
+		gd, wd := api.NewDecoder(strings.NewReader(text)), std.NewDecoder(strings.NewReader(text))
+		gd.UseNumber()
+		wd.UseNumber()
+		var gn, wn any
+		ge, we = gd.Decode(&gn), wd.Decode(&wn)
+		if ge != nil || we != nil {
+			fail(ht, "UseNumber decode errors: sonic %v, encoding/json %v", ge, we)
+		}
+		if !reflect.DeepEqual(gn, wn) {
+			fail(ht, "UseNumber decode differs:\n sonic %#v\n encoding/json %#v", gn, wn)
+		}
+		// Valid is pinned for top-level numbers (TestHegelPinValidAcceptsTopLevelNumbers).
+		if _, isNum := tree.(jnum); (!isNum || !Known.topLevelNumbers) && !api.Valid([]byte(text)) {
+			fail(ht, "Valid is false for a text Unmarshal accepted: %q", short([]byte(text)))
+		}
+	})
+}
+
+// Unmarshal into the struct universe: encoding/json's own encoding of a random
+// hgRich, re-rendered with random formatting and key order, decodes to the
+// same struct in both libraries (and back to the original encoding), and
+// DisallowUnknownFields rejects exactly the texts with an unknown key.
+func TestHegelUnmarshalIntoStructsMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		v := genRich(ht)
+		canon, err := std.Marshal(v)
+		if err != nil {
+			fail(ht, "encoding/json cannot encode the generated value: %v", err)
+		}
+		tree := canonTree(ht, canon).(jobj)
+		unknown := chance(ht, 30)
+		if unknown {
+			at := n(ht, 0, len(tree))
+			tree = append(tree[:at], append(jobj{{"zz_unknown", genTree(ht, 1)}}, tree[at:]...)...)
+		}
+		if chance(ht, 20) {
+			// encoding/json matches keys case-insensitively
+			for i := range tree {
+				if chance(ht, 50) {
+					tree[i].k = strings.ToUpper(tree[i].k)
+				}
+			}
+		}
+		// Rendered without optional \u escapes: sonic reads `,string`
+		// numbers and integer map keys without unescaping
+		// (TestHegelPinStringOptionAndIntegerKeysAreUnescaped).
+		text := emitTextPlain(ht, tree)
+		note(ht, "canonical: %s", short(canon))
+		note(ht, "text:      %s", short([]byte(text)))
+
+		var a, b hgRich
+		ea, eb := api.Unmarshal([]byte(text), &a), std.Unmarshal([]byte(text), &b)
+		if eb != nil {
+			fail(ht, "encoding/json rejects its own re-rendered encoding: %v", eb)
+		}
+		if ea != nil {
+			fail(ht, "sonic rejects the text: %v", ea)
+		}
+		ja, jb := stdJSON(a), stdJSON(b)
+		if ja != jb {
+			fail(ht, "decoded structs differ %s\n text %q", diffAt(ja, jb), short([]byte(text)))
+		}
+		// The RawMessage keeps the re-rendered bytes verbatim, so it is left
+		// out of the comparison with the original encoding.
+		v.R, a.R = nil, nil
+		canonNoRaw := stdJSON(v)
+		if stdJSON(a) != canonNoRaw {
+			fail(ht, "round trip lost information:\n decoded  %s\n original %s", short([]byte(stdJSON(a))), short([]byte(canonNoRaw)))
+		}
+
+		// The stream Decoder gets the same tree rendered again.
+		plain := emitTextPlain(ht, tree)
+		var da, db hgRich
+		gd, wd := api.NewDecoder(strings.NewReader(plain)), std.NewDecoder(strings.NewReader(plain))
+		gd.DisallowUnknownFields()
+		wd.DisallowUnknownFields()
+		ea, eb = gd.Decode(&da), wd.Decode(&db)
+		if (eb != nil) != unknown {
+			fail(ht, "encoding/json DisallowUnknownFields: unknown=%v err=%v", unknown, eb)
+		}
+		if (ea != nil) != unknown {
+			fail(ht, "sonic DisallowUnknownFields: unknown key present=%v but err=%v", unknown, ea)
+		}
+		da.R = nil
+		if !unknown && stdJSON(da) != canonNoRaw {
+			fail(ht, "Decoder.Decode differs from the original:\n decoded  %s\n original %s", short([]byte(stdJSON(da))), short([]byte(canonNoRaw)))
+		}
+	})
+}
+
+// Valid and Unmarshal agree with encoding/json on whether a text is valid,
+// for random valid texts and for texts with one structural mutation (which
+// are usually invalid), and on the decoded value when it is.
+func TestHegelValidMatchesEncodingJSON(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tree := genTree(ht, 3)
+		if _, isNum := tree.(jnum); Known.topLevelNumbers && (isNum || tree == nil) {
+			// Valid is pinned for top-level numbers (TestHegelPinValidAcceptsTopLevelNumbers)
+			// and a bare null into a RawMessage is pinned too
+			// (TestHegelPinNullIntoRawMessageKeepsTheLiteral).
+			tree = []any{tree}
+		}
+		text := emitText(ht, tree, chance(ht, 50))
+		if chance(ht, 60) {
+			m := mutate(ht, text)
+			// Valid checks only the first value (TestHegelPinValidRejectsTrailingBytes),
+			// so a mutation that leaves a complete value followed by more
+			// bytes, or a bare top-level number, is discarded.
+			if !pinnedValidShape(m) && !(Known.validBadEscapes && badEscape.MatchString(m) && !std.Valid([]byte(m))) {
+				text = m
+			}
+		}
+		note(ht, "text: %q", short([]byte(text)))
+
+		gv, wv := api.Valid([]byte(text)), std.Valid([]byte(text))
+		if gv != wv {
+			fail(ht, "Valid differs: sonic %v, encoding/json %v: %q", gv, wv, short([]byte(text)))
+		}
+
+		var g, w any
+		ge := api.Unmarshal([]byte(text), &g)
+		we := std.Unmarshal([]byte(text), &w)
+		if (ge == nil) != (we == nil) {
+			fail(ht, "Unmarshal verdict differs: sonic %v, encoding/json %v: %q", ge, we, short([]byte(text)))
+		}
+		if we == nil && !reflect.DeepEqual(g, w) {
+			fail(ht, "Unmarshal into interface{} differs:\n sonic %#v\n encoding/json %#v", g, w)
+		}
+		if we == nil && !wv {
+			fail(ht, "encoding/json: Unmarshal accepts what Valid rejects")
+		}
+
+		var gr, wr std.RawMessage
+		ge, we = api.Unmarshal([]byte(text), &gr), std.Unmarshal([]byte(text), &wr)
+		if (ge == nil) != (we == nil) {
+			fail(ht, "Unmarshal into RawMessage verdict differs: sonic %v, encoding/json %v: %q", ge, we, short([]byte(text)))
+		}
+		if we == nil && string(gr) != string(wr) {
+			fail(ht, "Unmarshal into RawMessage differs:\n sonic %q\n encoding/json %q", short(gr), short(wr))
+		}
+	})
+}
