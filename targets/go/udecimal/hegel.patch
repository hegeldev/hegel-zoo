+// --------------------------------------------------------------------------- arithmetic
+
+// TestHegelArithmetic: Add and Sub are exact; Mul and Div truncate toward zero to 19 fraction
+// digits; QuoRem and Mod are the C fmod contract; the 64-bit variants agree with the
+// decimal ones; division by zero is an error and a panic in the Must variants.
+func TestHegelArithmetic(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a, b := genDec(ht), genDec(ht)
+		c.check(ht, "Add", a.d.Add(b.d), new(big.Rat).Add(a.r, b.r))
+		c.check(ht, "Sub", a.d.Sub(b.d), new(big.Rat).Sub(a.r, b.r))
+		if differ(a.d.Sub(b.d), a.d.Add(b.d.Neg())) {
+			c.failClass(ht, "SubAddNeg", "%s - %s = %s, %s + (-%s) = %s", a, b, a.d.Sub(b.d), a, b, a.d.Add(b.d.Neg()))
+		}
+		c.check(ht, "Mul", a.d.Mul(b.d), truncRat(new(big.Rat).Mul(a.r, b.r), 19))
+		// The same value held in either representation (128-bit or big.Int) compares equal.
+		back := a.d.Add(b.d).Sub(b.d)
+		if !back.Equal(a.d) || back.Cmp(a.d) != 0 || a.d.Cmp(back) != 0 || ratOfDec(back).Cmp(a.r) != 0 {
+			c.failClass(ht, "CrossRep", "(%s + %s) - %s = %s (Prec %d): Equal %v, Cmp %d/%d", a, b, b, back, back.Prec(), back.Equal(a.d), back.Cmp(a.d), a.d.Cmp(back))
+		}
+		for _, r := range []udecimal.Decimal{a.d.Add(b.d), a.d.Sub(b.d), a.d.Mul(b.d)} {
+			if r.Prec() > 19 || r.Prec() < 0 {
+				c.failClass(ht, "ResultPrec", "result %s has Prec() %d", r, r.Prec())
+			}
+		}
+		if a.d.Add(b.d).Prec() != max(a.d.Prec(), b.d.Prec()) && !a.d.Add(b.d).IsZero() {
+			c.failClass(ht, "AddPrec", "(%s + %s).Prec() = %d, operands %d and %d", a, b, a.d.Add(b.d).Prec(), a.d.Prec(), b.d.Prec())
+		}
+
+		// Division.
+		q, err := a.d.Div(b.d)
+		if b.coef.Sign() == 0 {
+			if !errors.Is(err, udecimal.ErrDivideByZero) {
+				c.failClass(ht, "DivZero", "%s / 0: %s, %v", a, q, err)
+			}
+			if !panics(func() { a.d.MustDiv(b.d) }) || !panics(func() { a.d.MustQuoRem(b.d) }) || !panics(func() { a.d.MustMod(b.d) }) {
+				c.failClass(ht, "MustDivZero", "MustDiv/MustQuoRem/MustMod by zero did not panic")
+			}
+			if _, _, err := a.d.QuoRem(b.d); !errors.Is(err, udecimal.ErrDivideByZero) {
+				c.failClass(ht, "QuoRemZero", "QuoRem by zero: %v", err)
+			}
+			if _, err := a.d.Mod(b.d); !errors.Is(err, udecimal.ErrDivideByZero) {
+				c.failClass(ht, "ModZero", "Mod by zero: %v", err)
+			}
+		} else {
+			exact := new(big.Rat).Quo(a.r, b.r)
+			if err != nil {
+				c.failClass(ht, "Div", "%s / %s: %v", a, b, err)
+			} else {
+				c.check(ht, "Div", q, truncRat(exact, 19))
+				if q.Prec() > 19 {
+					c.failClass(ht, "DivPrec", "(%s / %s).Prec() = %d", a, b, q.Prec())
+				}
+				if differ(a.d.MustDiv(b.d), q) {
+					c.failClass(ht, "MustDiv", "MustDiv differs from Div")
+				}
+			}
+			qq, rr, err := a.d.QuoRem(b.d)
+			wq := truncRat(exact, 0)
+			wr := new(big.Rat).Sub(a.r, new(big.Rat).Mul(wq, b.r))
+			if err != nil {
+				c.failClass(ht, "QuoRem", "QuoRem(%s, %s): %v", a, b, err)
+			} else {
+				c.check(ht, "QuoRemQ", qq, wq)
+				c.check(ht, "QuoRemR", rr, wr)
+				if m, err := a.d.Mod(b.d); err != nil || differ(m, rr) {
+					c.failClass(ht, "Mod", "Mod(%s, %s) = %s, %v; QuoRem remainder %s", a, b, m, err, rr)
+				}
+				mq, mr := a.d.MustQuoRem(b.d)
+				if differ(mq, qq) || differ(mr, rr) || differ(a.d.MustMod(b.d), rr) {
+					c.failClass(ht, "MustQuoRem", "MustQuoRem/MustMod differ from QuoRem")
+				}
+			}
+		}
+
+		// The uint64 variants.
+		u := genUint64(ht)
+		ud := udecimal.MustFromUint64(u, 0)
+		ur := new(big.Rat).SetInt(bigOfU64(u))
+		c.check(ht, "Add64", a.d.Add64(u), new(big.Rat).Add(a.r, ur))
+		c.check(ht, "Sub64", a.d.Sub64(u), new(big.Rat).Sub(a.r, ur))
+		c.check(ht, "Mul64", a.d.Mul64(u), new(big.Rat).Mul(a.r, ur))
+		if differ(a.d.Add64(u), a.d.Add(ud)) || differ(a.d.Sub64(u), a.d.Sub(ud)) || differ(a.d.Mul64(u), a.d.Mul(ud)) {
+			c.failClass(ht, "Same64", "%s with %d: Add64 %s Add %s; Sub64 %s Sub %s; Mul64 %s Mul %s", a, u,
+				a.d.Add64(u), a.d.Add(ud), a.d.Sub64(u), a.d.Sub(ud), a.d.Mul64(u), a.d.Mul(ud))
+		}
+		q64, err := a.d.Div64(u)
+		if u == 0 {
+			if !errors.Is(err, udecimal.ErrDivideByZero) {
+				c.failClass(ht, "Div64Zero", "Div64(0): %v", err)
+			}
+		} else if err != nil {
+			c.failClass(ht, "Div64", "%s / %d: %v", a, u, err)
+		} else {
+			c.check(ht, "Div64", q64, truncRat(new(big.Rat).Quo(a.r, ur), 19))
+			if qd, _ := a.d.Div(ud); !qd.Equal(q64) {
+				c.failClass(ht, "Div64Same", "%s / %d: Div64 %s (prec %d), Div %s (prec %d)", a, u, q64, q64.Prec(), qd, qd.Prec())
+			}
+		}
+
+		// Comparison.
+		want := a.r.Cmp(b.r)
+		if a.d.Cmp(b.d) != want || b.d.Cmp(a.d) != -want {
+			c.failClass(ht, "Cmp", "Cmp(%s, %s) = %d, reverse %d, want %d", a, b, a.d.Cmp(b.d), b.d.Cmp(a.d), want)
+		}
+		if a.d.Equal(b.d) != (want == 0) || a.d.LessThan(b.d) != (want < 0) || a.d.LessThanOrEqual(b.d) != (want <= 0) ||
+			a.d.GreaterThan(b.d) != (want > 0) || a.d.GreaterThanOrEqual(b.d) != (want >= 0) {
+			c.failClass(ht, "Predicates", "predicates of %s vs %s disagree with Cmp %d", a, b, want)
+		}
+		if a.d.Cmp(a.d) != 0 || !a.d.Equal(a.d) {
+			c.failClass(ht, "CmpSelf", "Cmp(%s, itself) = %d", a, a.d.Cmp(a.d))
+		}
+		// The same value at another precision compares equal.
+		if a.prec < 19 && a.coef.Sign() != 0 {
+			a2 := udecimal.MustParse(fixedText(a.neg, a.coef, a.prec) + strings.Repeat("0", 1)[:0] + func() string {
+				if a.prec == 0 {
+					return ".0"
+				}
+				return "0"
+			}())
+			if a2.Cmp(a.d) != 0 || !a2.Equal(a.d) || a2.Prec() != a.d.Prec()+1 {
+				c.failClass(ht, "CmpRescaled", "%s vs %s (prec %d): Cmp %d Equal %v", a, a2, a2.Prec(), a2.Cmp(a.d), a2.Equal(a.d))
+			}
+		}
+		e := genDec(ht)
+		mx, mn := a.r, a.r
+		for _, r := range []*big.Rat{b.r, e.r} {
+			if r.Cmp(mx) > 0 {
+				mx = r
+			}
+			if r.Cmp(mn) < 0 {
+				mn = r
+			}
+		}
+		c.check(ht, "Max", udecimal.Max(a.d, b.d, e.d), mx)
+		c.check(ht, "Min", udecimal.Min(a.d, b.d, e.d), mn)
+		if differ(udecimal.Max(a.d), a.d) || differ(udecimal.Min(a.d), a.d) {
+			c.failClass(ht, "MaxOne", "Max/Min of one argument differ from it")
+		}
+	})
+}
