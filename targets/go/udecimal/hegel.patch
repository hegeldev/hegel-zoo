@@ -0,0 +1,64 @@
+package hegel
+
+// Pins: one plain test per recorded bug (bugs.toml), asserting the documented behaviour.
+// Each fails while the bug exists and is listed in target.toml's [expected_failures].
+
+import (
+	"math"
+	"testing"
+
+	"github.com/quagmt/udecimal"
+)
+
+// udecimal/1: NewFromUint64 and NewFromInt64 document that trailing zeros are removed and
+// the precision adjusted.
+func TestHegelPinConstructorTrimsTrailingZeros(t *testing.T) {
+	u := udecimal.MustFromUint64(1000, 3)
+	i := udecimal.MustFromInt64(-1500, 2)
+	if u.Prec() != 0 || i.Prec() != 1 {
+		t.Fatalf("NewFromUint64(1000, 3).Prec() = %d (want 0), NewFromInt64(-1500, 2).Prec() = %d (want 1): trailing zeros are not removed", u.Prec(), i.Prec())
+	}
+}
+
+// udecimal/2: Int64 of math.MinInt64, which fits, returns ErrIntPartOverflow.
+func TestHegelPinInt64MinFits(t *testing.T) {
+	d := udecimal.MustFromInt64(math.MinInt64, 0)
+	got, err := d.Int64()
+	if err != nil || got != math.MinInt64 {
+		t.Fatalf("Int64() of %s = %d, %v; want %d", d, got, err, int64(math.MinInt64))
+	}
+}
+
+// udecimal/3: PowToIntPart of zero with an exponent in (-1, 0) has integer part 0, and 0^0
+// is documented to be 1.
+func TestHegelPinZeroPowFractionIsOne(t *testing.T) {
+	got, err := udecimal.Zero.PowToIntPart(udecimal.MustParse("-0.5"))
+	if err != nil || !got.Equal(udecimal.One) {
+		t.Fatalf("PowToIntPart(0, -0.5) = %s, %v; want 1 (0^int(-0.5) = 0^0)", got, err)
+	}
+}
+
+// udecimal/4: the MarshalBinary doc example for -1.2345 gives the first byte as
+// 0b0001_0000 (overflow = true, neg = false); the encoder writes 0b0000_0001.
+func TestHegelPinBinaryDocExample(t *testing.T) {
+	b, err := udecimal.MustParse("-1.2345").MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if b[0] != 0b0001_0000 {
+		t.Fatalf("MarshalBinary(-1.2345)[0] = %08b; the doc example says %08b (overflow = true, neg = false)", b[0], 0b0001_0000)
+	}
+}
+
+// udecimal/5: PowInt32(math.MinInt32) and PowInt(math.MinInt) negate the exponent in its own
+// width: 2^MinInt32 comes out as 1 (the exact value truncates to 0) and 0.5^MinInt32 panics.
+func TestHegelPinPowMinExponent(t *testing.T) {
+	two := udecimal.MustParse("2")
+	got, err := two.PowInt32(math.MinInt32)
+	if err != nil || !got.IsZero() {
+		t.Fatalf("PowInt32(2, MinInt32) = %s, %v; want 0", got, err)
+	}
+	if got := two.PowInt(math.MinInt); !got.IsZero() {
+		t.Fatalf("PowInt(2, MinInt) = %s; want 0", got)
+	}
+}
diff --git a/hegel/hegel_props_test.go b/hegel/hegel_props_test.go
new file mode 100644
index 0000000..3b3372e
--- /dev/null
+++ b/hegel/hegel_props_test.go
@@ -0,0 +1,817 @@
+package hegel
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"math"
+	"math/big"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/quagmt/udecimal"
+	"hegel.dev/go/hegel"
+)
+
+// panics runs f and reports whether it panicked.
+func panics(f func()) (p bool) {
+	defer func() {
+		if recover() != nil {
+			p = true
+		}
+	}()
+	f()
+	return false
+}
+
+// sameRep reports whether two decimals are the same value at the same precision (the struct
+// holds a *big.Int for wide values, so == does not do).
+func sameRep(a, b udecimal.Decimal) bool { return a.Equal(b) && a.Prec() == b.Prec() }
+
+func differ(a, b udecimal.Decimal) bool { return !sameRep(a, b) }
+
+// --------------------------------------------------------------------------- text
+
+// TestHegelText: String prints the canonical text, Parse reads it and its variants (sign,
+// leading zeros, trailing zeros), rejects malformed text and more than 19 fraction digits;
+// StringFixed pads; ToHiLo exposes the representation; the sign predicates agree with the
+// value; Int64 and InexactFloat64 follow their contracts.
+func TestHegelText(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		x := genDec(ht)
+		if got := x.d.String(); got != x.text {
+			c.failClass(ht, "String", "String() of %s = %q, want %q", x, got, x.text)
+		}
+		if x.coef.Sign() != 0 && x.d.Prec() != int(x.prec) {
+			c.failClass(ht, "Prec", "Prec() of %s = %d, want %d", x, x.d.Prec(), x.prec)
+		}
+		if x.d.PrecUint() != uint8(x.d.Prec()) {
+			c.failClass(ht, "PrecUint", "PrecUint() of %s = %d, Prec() %d", x, x.d.PrecUint(), x.d.Prec())
+		}
+
+		// Parse of the canonical text.
+		p, err := udecimal.Parse(x.text)
+		if err != nil {
+			c.failClass(ht, "Parse", "Parse(%q): %v", x.text, err)
+		} else if !p.Equal(x.d) || p.Cmp(x.d) != 0 || ratOfDec(p).Cmp(x.r) != 0 {
+			c.failClass(ht, "Parse", "Parse(%q) = %s, want %s", x.text, p, x)
+		}
+
+		// A variant: optional +, leading zeros, extra fraction zeros (within 19 digits).
+		extra := drawInt(ht, 0, 19-int(x.prec))
+		v := fixedText(false, x.coef, x.prec)
+		if extra > 0 {
+			if x.prec == 0 {
+				v += "."
+			}
+			v += strings.Repeat("0", extra)
+		}
+		v = strings.Repeat("0", drawInt(ht, 0, 3)) + v
+		switch {
+		case x.neg:
+			v = "-" + v
+		case chance(ht, 30):
+			v = "+" + v
+		}
+		if len(v) <= 200 {
+			pv, err := udecimal.Parse(v)
+			switch {
+			case err != nil:
+				c.failClass(ht, "ParseVariant", "Parse(%q): %v", v, err)
+			case ratOfDec(pv).Cmp(x.r) != 0 || !pv.Equal(x.d):
+				c.failClass(ht, "ParseVariant", "Parse(%q) = %s, want %s", v, pv, x)
+			case x.coef.Sign() != 0 && pv.Prec() != int(x.prec)+extra:
+				c.failClass(ht, "ParseVariantPrec", "Parse(%q).Prec() = %d, want %d", v, pv.Prec(), int(x.prec)+extra)
+			}
+			sign, digits := "", v
+			if v[0] == '+' || v[0] == '-' {
+				sign, digits = v[:1], v[1:]
+			}
+			padded := sign + strings.Repeat("0", 200-len(v)) + digits
+			if bv, err := udecimal.Parse(padded); err != nil || !bv.Equal(x.d) {
+				c.failClass(ht, "Parse200", "Parse of %q padded to 200 characters: %s, %v", v, bv, err)
+			}
+		} else {
+			if _, err := udecimal.Parse(v); !errors.Is(err, udecimal.ErrMaxStrLen) {
+				c.failClass(ht, "ParseLong", "Parse of %d characters: %v, want ErrMaxStrLen", len(v), err)
+			}
+		}
+
+		// Too many fraction digits.
+		if chance(ht, 25) {
+			over := fixedText(x.neg, new(big.Int).Mul(x.coef, pow10(20-int(x.prec))), 20)
+			if len(over) <= 200 {
+				if _, err := udecimal.Parse(over); !errors.Is(err, udecimal.ErrPrecOutOfRange) {
+					c.failClass(ht, "ParsePrec", "Parse(%q): %v, want ErrPrecOutOfRange", over, err)
+				}
+			}
+		}
+
+		// Malformed text.
+		bad := pick(ht, []string{"", "-", "+", ".", "1.", ".5", "-.5", "1..2", "1.2.3", "--1", "+-1", "1e5", "1E5",
+			" 1", "1 ", "1_000", "1,5", "0x10", "abc", "1.5x", "NaN", "Inf", "-0-", "1-", "1+2"})
+		if chance(ht, 50) {
+			// A random corruption of the text.
+			b := []byte(fixedText(x.neg, x.coef, x.prec))
+			i := drawInt(ht, 0, len(b)-1)
+			b[i] = pick(ht, []byte("a.-+ e,x_"))
+			bad = string(b)
+		}
+		if bv, err := udecimal.Parse(bad); err == nil {
+			if r, ok := new(big.Rat).SetString(bad); ok && (strings.HasPrefix(bad, "+") || strings.HasPrefix(bad, "-") || (bad[0] >= '0' && bad[0] <= '9')) && !strings.ContainsAny(bad, "e.") && r.Cmp(ratOfDec(bv)) == 0 {
+				// A corruption that left a valid integer text.
+			} else if strings.Count(bad, ".") == 1 && strings.Trim(bad, "+-0123456789.") == "" && !strings.HasPrefix(strings.TrimLeft(bad, "+-"), ".") && !strings.HasSuffix(bad, ".") && strings.Count(strings.TrimLeft(bad, "+-"), "+") == 0 && strings.Count(strings.TrimLeft(bad, "+-"), "-") == 0 && strings.Count(bad, "+")+strings.Count(bad, "-") <= 1 {
+				// A corruption that left a valid decimal text.
+			} else {
+				c.failClass(ht, "ParseBad", "Parse(%q) = %s, want an error", bad, bv)
+			}
+		} else if !errors.Is(err, udecimal.ErrInvalidFormat) && !errors.Is(err, udecimal.ErrEmptyString) && !errors.Is(err, udecimal.ErrPrecOutOfRange) {
+			c.failClass(ht, "ParseBadErr", "Parse(%q): %v, want ErrInvalidFormat", bad, err)
+		}
+
+		// StringFixed.
+		fp := uint8(drawInt(ht, 0, 19))
+		// Padded to fp fraction digits; trailing zeros trimmed, but never below fp digits.
+		dp := max(x.prec, fp)
+		want := fixedText(x.neg && x.coef.Sign() != 0, new(big.Int).Mul(x.coef, pow10(int(dp)-int(x.prec))), dp)
+		if i := strings.IndexByte(want, '.'); i >= 0 {
+			for len(want)-i-1 > int(fp) && strings.HasSuffix(want, "0") {
+				want = want[:len(want)-1]
+			}
+			want = strings.TrimSuffix(want, ".")
+		}
+		if got := x.d.StringFixed(fp); got != want {
+			c.failClass(ht, "StringFixed", "StringFixed(%d) of %s = %q, want %q", fp, x, got, want)
+		}
+
+		// ToHiLo.
+		neg, hi, lo, prec, ok := x.d.ToHiLo()
+		if fits := x.coef.Cmp(two128) < 0; ok != fits {
+			c.failClass(ht, "ToHiLo", "ToHiLo() of %s ok = %v, want %v", x, ok, fits)
+		} else if ok {
+			got := new(big.Int).Lsh(bigOfU64(hi), 64)
+			got.Add(got, bigOfU64(lo))
+			if got.Cmp(x.coef) != 0 || neg != (x.neg && x.coef.Sign() != 0) || (x.coef.Sign() != 0 && prec != x.prec) {
+				c.failClass(ht, "ToHiLo", "ToHiLo() of %s = %v %d %d %d", x, neg, hi, lo, prec)
+			}
+		}
+
+		// Sign predicates, Neg, Abs.
+		s := x.r.Sign()
+		if x.d.Sign() != s || x.d.IsZero() != (s == 0) || x.d.IsNeg() != (s < 0) || x.d.IsPos() != (s > 0) {
+			c.failClass(ht, "Sign", "%s: Sign %d IsZero %v IsNeg %v IsPos %v", x, x.d.Sign(), x.d.IsZero(), x.d.IsNeg(), x.d.IsPos())
+		}
+		c.check(ht, "Neg", x.d.Neg(), new(big.Rat).Neg(x.r))
+		c.check(ht, "Abs", x.d.Abs(), new(big.Rat).Abs(x.r))
+		if differ(x.d.Neg().Neg(), x.d) {
+			c.failClass(ht, "NegNeg", "Neg().Neg() of %s = %s", x, x.d.Neg().Neg())
+		}
+
+		// Int64: the integer part, or an error when it does not fit.
+		ip := truncRat(x.r, 0).Num()
+		i64, err := x.d.Int64()
+		fits := ip.IsInt64()
+		if Known.int64MinRejected && ip.Cmp(big.NewInt(math.MinInt64)) == 0 {
+			fits = false
+		}
+		switch {
+		case fits && err != nil:
+			c.failClass(ht, "Int64", "Int64() of %s: %v", x, err)
+		case fits && i64 != ip.Int64():
+			c.failClass(ht, "Int64", "Int64() of %s = %d, want %s", x, i64, ip)
+		case !fits && !errors.Is(err, udecimal.ErrIntPartOverflow):
+			c.failClass(ht, "Int64", "Int64() of %s = %d, %v; want ErrIntPartOverflow", x, i64, err)
+		}
+
+		// InexactFloat64 is the float nearest the text.
+		f, _ := strconv.ParseFloat(x.text, 64)
+		if got := x.d.InexactFloat64(); got != f {
+			c.failClass(ht, "InexactFloat64", "InexactFloat64() of %s = %v, want %v", x, got, f)
+		}
+	})
+}
