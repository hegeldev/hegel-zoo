new file mode 100644
index 0000000..939632a
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,156 @@
+package hegel
+
+// Hegel property tests for quagmt/udecimal, written for the Hegel zoo. See targets/go/udecimal/README.md.
+//
+// Oracle: exact rational arithmetic with math/big, applying the documented rules (results
+// truncated toward zero to 19 fraction digits, the rounding modes, the integer-part
+// contracts), plus the documented text and binary formats.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"math/big"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/quagmt/udecimal"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	// NewFromUint64 and NewFromInt64 document "Trailing zeros will be removed and the prec will
+	// also be adjusted"; they are not: NewFromUint64(1000, 3) is 1 with Prec() 3.
+	constructorKeepsTrailingZeros bool
+	// Int64 returns ErrIntPartOverflow for -9223372036854775808 (math.MinInt64), which fits.
+	int64MinRejected bool
+	// PowToIntPart of zero with an exponent in (-1, 0) returns ErrZeroPowNegative, though the
+	// integer part of the exponent is 0 and 0^0 is documented to be 1.
+	zeroPowFractionErrors bool
+	// the MarshalBinary doc example for -1.2345 gives the first byte as 0b0001_0000
+	// (overflow = true, neg = false); the encoding writes 0b0000_0001 (neg = true).
+	binaryDocExample bool
+	// PowInt32(math.MinInt32) and PowInt(math.MinInt) negate the exponent in its own width, so it
+	// stays negative: 2^MinInt32 is 1 (exact: 0 after truncation) and 0.5^MinInt32 panics with
+	// an index out of range, though the package documents itself as panic-free.
+	powMinExponent bool
+}{true, true, true, true, true}
+
+// check compares a decimal with its exact expected value.
+func (c *collector) check(ht *hegel.T, what string, got udecimal.Decimal, want *big.Rat) bool {
+	g := ratOfDec(got)
+	if g.Cmp(want) != 0 {
+		c.failClass(ht, what, "%s = %s, want %s", what, got.String(), ratStr(want))
+		return false
+	}
+	return true
+}
