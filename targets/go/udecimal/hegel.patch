+// --------------------------------------------------------------------------- rounding
+
+// TestHegelRounding: the rounding methods against the exact rules; Floor and Ceil; results
+// idempotent and never more precise than asked.
+func TestHegelRounding(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		x := genDec(ht)
+		p := uint8(drawInt(ht, 0, 19))
+		if x.prec > 0 && chance(ht, 60) {
+			p = uint8(drawInt(ht, 0, int(x.prec)-1))
+		}
+		if chance(ht, 8) {
+			p = uint8(drawInt(ht, 20, 255)) // above the maximum: a no-op
+		}
+		type method struct {
+			name string
+			mode string
+			f    func(uint8) udecimal.Decimal
+		}
+		methods := []method{
+			{"RoundBank", "bank", x.d.RoundBank},
+			{"RoundHAZ", "haz", x.d.RoundHAZ},
+			{"RoundHTZ", "htz", x.d.RoundHTZ},
+			{"RoundAwayFromZero", "away", x.d.RoundAwayFromZero},
+			{"Trunc", "trunc", x.d.Trunc},
+		}
+		for _, m := range methods {
+			got := m.f(p)
+			want := roundRat(x.r, int(p), m.mode)
+			if !c.check(ht, m.name, got, want) {
+				continue
+			}
+			if got.Prec() > int(p) {
+				c.failClass(ht, m.name+"Prec", "%s(%d) of %s = %s with Prec() %d", m.name, p, x, got, got.Prec())
+			}
+			// Idempotent, and a no-op at or above the precision.
+			var again udecimal.Decimal
+			switch m.name {
+			case "RoundBank":
+				again = got.RoundBank(p)
+			case "RoundHAZ":
+				again = got.RoundHAZ(p)
+			case "RoundHTZ":
+				again = got.RoundHTZ(p)
+			case "RoundAwayFromZero":
+				again = got.RoundAwayFromZero(p)
+			default:
+				again = got.Trunc(p)
+			}
+			if differ(again, got) {
+				c.failClass(ht, m.name+"Idem", "%s(%d) of %s = %s, again %s", m.name, p, x, got, again)
+			}
+			if int(p) >= x.d.Prec() && differ(got, x.d) {
+				c.failClass(ht, m.name+"NoOp", "%s(%d) of %s (Prec %d) = %s, want unchanged", m.name, p, x, x.d.Prec(), got)
+			}
+		}
+		c.check(ht, "Floor", x.d.Floor(), roundRat(x.r, 0, "floor"))
+		c.check(ht, "Ceil", x.d.Ceil(), roundRat(x.r, 0, "ceil"))
+		if x.d.Floor().Prec() != 0 || x.d.Ceil().Prec() != 0 {
+			c.failClass(ht, "FloorPrec", "Floor/Ceil of %s have Prec() %d/%d", x, x.d.Floor().Prec(), x.d.Ceil().Prec())
+		}
+		if differ(x.d.Neg().Floor(), x.d.Ceil().Neg()) {
+			c.failClass(ht, "FloorCeil", "Floor(-%s) = %s, -Ceil = %s", x, x.d.Neg().Floor(), x.d.Ceil().Neg())
+		}
+		if differ(x.d.Neg().RoundHAZ(p), x.d.RoundHAZ(p).Neg()) || differ(x.d.Neg().RoundBank(p), x.d.RoundBank(p).Neg()) {
+			c.failClass(ht, "RoundSymmetric", "rounding of %s is not symmetric under negation", x)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- powers and roots
+
+// TestHegelPow: PowInt32, PowToIntPart and the deprecated PowInt against exact powers
+// truncated to 19 fraction digits, with the documented zero cases; Sqrt is the truncated
+// square root.
+func TestHegelPow(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		x := genDecMax(ht, 20)
+		e := drawInt(ht, -12, 12)
+		if chance(ht, 30) {
+			e = drawInt(ht, -3, 3)
+		}
+		if len(x.coef.String()) <= 3 && chance(ht, 30) {
+			e = drawInt(ht, -80, 80)
+		}
+		zero := x.coef.Sign() == 0
+		var want *big.Rat
+		if !zero || e >= 0 {
+			if zero && e == 0 {
+				want = big.NewRat(1, 1)
+			} else if zero {
+				want = new(big.Rat)
+			} else {
+				want = truncRat(ratPow(x.r, e), 19)
+			}
+		}
+
+		got, err := x.d.PowInt32(int32(e))
+		if want == nil {
+			if !errors.Is(err, udecimal.ErrZeroPowNegative) {
+				c.failClass(ht, "PowInt32Zero", "PowInt32(0, %d) = %s, %v; want ErrZeroPowNegative", e, got, err)
+			}
+		} else if err != nil {
+			c.failClass(ht, "PowInt32", "PowInt32(%s, %d): %v", x, e, err)
+		} else {
+			c.check(ht, "PowInt32", got, want)
+		}
+
+		// The most negative exponent: |d| >= 2 underflows to zero, |d| == 1 stays 1.
+		if !Known.powMinExponent && chance(ht, 10) && new(big.Rat).Abs(x.r).Cmp(big.NewRat(1, 1)) >= 0 {
+			wantMin := new(big.Rat)
+			if new(big.Rat).Abs(x.r).Cmp(big.NewRat(1, 1)) == 0 {
+				wantMin = big.NewRat(1, 1)
+			}
+			if gotMin, err := x.d.PowInt32(math.MinInt32); err != nil {
+				c.failClass(ht, "PowInt32Min", "PowInt32(%s, MinInt32): %v", x, err)
+			} else {
+				c.check(ht, "PowInt32Min", gotMin, wantMin)
+			}
+			c.check(ht, "PowIntMin", x.d.PowInt(math.MinInt), wantMin)
+		}
+
+		// PowToIntPart: the exponent with a fraction added, truncated toward zero.
+		k := drawInt(ht, 0, 5)
+		frac := int64(0)
+		if k > 0 {
+			frac = int64(drawInt(ht, 0, int(math.Pow10(k))-1))
+		}
+		mag := int64(abs(e))*int64(math.Pow10(k)) + frac
+		if e < 0 || (e == 0 && chance(ht, 50)) {
+			mag = -mag
+		}
+		ed := udecimal.MustFromInt64(mag, uint8(k))
+		wantPart := want
+		if Known.zeroPowFractionErrors && zero && mag < 0 {
+			wantPart = nil
+		}
+		gotPart, err := x.d.PowToIntPart(ed)
+		if wantPart == nil {
+			if !errors.Is(err, udecimal.ErrZeroPowNegative) {
+				c.failClass(ht, "PowToIntPartZero", "PowToIntPart(0, %s) = %s, %v; want ErrZeroPowNegative", ed, gotPart, err)
+			}
+		} else if err != nil {
+			c.failClass(ht, "PowToIntPart", "PowToIntPart(%s, %s): %v", x, ed, err)
+		} else {
+			c.check(ht, "PowToIntPart", gotPart, wantPart)
+		}
+		if big, err := x.d.PowToIntPart(udecimal.MustParse(pick(ht, []string{"2147483648", "-2147483648", "99999999999.5"}))); !errors.Is(err, udecimal.ErrExponentTooLarge) && !(zero && errors.Is(err, udecimal.ErrZeroPowNegative)) {
+			c.failClass(ht, "PowTooLarge", "PowToIntPart(%s, huge) = %s, %v; want ErrExponentTooLarge", x, big, err)
+		}
+
+		// The deprecated PowInt: 0^e = 0 for every e.
+		wantOld := want
+		if zero {
+			wantOld = new(big.Rat)
+		}
+		c.check(ht, "PowInt", x.d.PowInt(e), wantOld)
+
+		// Sqrt, on the full range of values.
+		x = genDec(ht)
+		s, err := x.d.Sqrt()
+		switch {
+		case x.r.Sign() < 0:
+			if !errors.Is(err, udecimal.ErrSqrtNegative) {
+				c.failClass(ht, "SqrtNeg", "Sqrt(%s) = %s, %v; want ErrSqrtNegative", x, s, err)
+			}
+		case err != nil:
+			c.failClass(ht, "Sqrt", "Sqrt(%s): %v", x, err)
+		default:
+			// floor(sqrt(x * 10^38)) / 10^19
+			scaled := new(big.Rat).Mul(x.r, ratPow10(38))
+			n := new(big.Int).Quo(scaled.Num(), scaled.Denom())
+			root := new(big.Int).Sqrt(n)
+			c.check(ht, "Sqrt", s, new(big.Rat).SetFrac(root, pow10(19)))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- codecs
+
+// TestHegelCodec: JSON, text and binary round trips; the documented binary layout; corrupt
+// binary data rejected without a panic.
+func TestHegelCodec(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		x := genDec(ht)
+
+		// JSON: a quoted text; unquoted numbers and null accepted on the way in.
+		j, err := x.d.MarshalJSON()
+		if err != nil || string(j) != `"`+x.text+`"` {
+			c.failClass(ht, "MarshalJSON", "MarshalJSON of %s = %s, %v", x, j, err)
+		}
+		type wrap struct {
+			D udecimal.Decimal
+			P *udecimal.Decimal
+		}
+		w := wrap{D: x.d, P: &x.d}
+		wj, err := json.Marshal(w)
+		if err != nil {
+			c.failClass(ht, "JSON", "json.Marshal: %v", err)
+		} else {
+			var back wrap
+			if err := json.Unmarshal(wj, &back); err != nil || !back.D.Equal(x.d) || back.P == nil || !back.P.Equal(x.d) {
+				c.failClass(ht, "JSON", "%s -> %+v, %v", wj, back, err)
+			}
+		}
+		var un udecimal.Decimal
+		if err := un.UnmarshalJSON([]byte(x.text)); err != nil || !un.Equal(x.d) {
+			c.failClass(ht, "JSONUnquoted", "UnmarshalJSON(%s) = %s, %v", x.text, un, err)
+		}
+		if err := un.UnmarshalJSON([]byte("null")); err != nil || !un.Equal(x.d) {
+			c.failClass(ht, "JSONNull", "UnmarshalJSON(null) = %s, %v; want unchanged", un, err)
+		}
+		if err := un.UnmarshalJSON([]byte(pick(ht, []string{`"abc"`, `""`, `"1.2.3"`, `true`, `[1]`, `{}`, `"1e5"`}))); err == nil {
+			c.failClass(ht, "JSONBad", "UnmarshalJSON of malformed JSON accepted: %s", un)
+		}
+
+		// Text.
+		tx, err := x.d.MarshalText()
+		if err != nil || string(tx) != x.text {
+			c.failClass(ht, "MarshalText", "MarshalText of %s = %s, %v", x, tx, err)
+		}
+		if at, err := x.d.AppendText([]byte("pre")); err != nil || string(at) != "pre"+x.text {
+			c.failClass(ht, "AppendText", "AppendText of %s = %s, %v", x, at, err)
+		}
+		var ut udecimal.Decimal
+		if err := ut.UnmarshalText(tx); err != nil || !ut.Equal(x.d) {
+			c.failClass(ht, "UnmarshalText", "UnmarshalText(%s) = %s, %v", tx, ut, err)
+		}
+
+		// Binary.
+		b, err := x.d.MarshalBinary()
+		if err != nil {
+			c.failClass(ht, "MarshalBinary", "MarshalBinary of %s: %v", x, err)
+			return
+		}
+		if ab, err := x.d.AppendBinary([]byte{9, 9}); err != nil || string(ab) != string(append([]byte{9, 9}, b...)) {
+			c.failClass(ht, "AppendBinary", "AppendBinary of %s = %x, %v; MarshalBinary %x", x, ab, err, b)
+		}
+		var ub udecimal.Decimal
+		if err := ub.UnmarshalBinary(b); err != nil || differ(ub, x.d) {
+			c.failClass(ht, "UnmarshalBinary", "UnmarshalBinary(%x) = %s (prec %d), %v; want %s (prec %d)", b, ub, ub.Prec(), err, x, x.d.Prec())
+		}
+		// Layout: [overflow<<4 | neg] [prec] [total bytes] [coef big-endian].
+		if len(b) < 3 {
+			c.failClass(ht, "BinaryShort", "MarshalBinary of %s = %x", x, b)
+			return
+		}
+		nonzero := x.coef.Sign() != 0
+		overflow := x.coef.Cmp(two128) >= 0
+		wantFlags := byte(0)
+		if x.neg && nonzero {
+			wantFlags |= 1
+		}
+		if overflow {
+			wantFlags |= 1 << 4
+		}
+		if Known.binaryDocExample && x.neg && nonzero && !overflow {
+			wantFlags = 1 // what the encoder writes; the doc example claims 0b0001_0000
+		}
+		if b[0] != wantFlags || int(b[2]) != len(b) || (nonzero && b[1] != x.prec) || (!nonzero && b[1] != 0) {
+			c.failClass(ht, "BinaryHeader", "MarshalBinary of %s = %x: flags %08b (want %08b), prec %d, length byte %d of %d", x, b, b[0], wantFlags, b[1], b[2], len(b))
+		}
+		if !overflow {
+			var coef []byte
+			switch len(b) {
+			case 11:
+				coef = b[3:]
+			case 19:
+				coef = b[3:]
+			default:
+				c.failClass(ht, "BinaryLen", "MarshalBinary of %s = %x: %d bytes", x, b, len(b))
+			}
+			if coef != nil {
+				got := new(big.Int).SetBytes(coef)
+				if got.Cmp(x.coef) != 0 {
+					c.failClass(ht, "BinaryCoef", "MarshalBinary of %s = %x: coefficient %s", x, b, got)
+				}
+				if len(b) == 19 && x.coef.Cmp(two64) < 0 {
+					c.failClass(ht, "BinaryWide", "MarshalBinary of %s = %x: 16 coefficient bytes for a 64-bit value", x, b)
+				}
+				if len(b) == 19 {
+					hi := binary.BigEndian.Uint64(b[3:11])
+					lo := binary.BigEndian.Uint64(b[11:19])
+					if new(big.Int).Add(new(big.Int).Lsh(bigOfU64(hi), 64), bigOfU64(lo)).Cmp(x.coef) != 0 {
+						c.failClass(ht, "BinaryHiLo", "MarshalBinary of %s = %x: hi %d lo %d", x, b, hi, lo)
+					}
+				}
+			}
+		}
+		// Corruptions: a prefix, a wrong length byte, random bytes. Never a panic; a prefix and
+		// a wrong length are errors.
+		cut := drawInt(ht, 0, len(b)-1)
+		var cd udecimal.Decimal
+		if err := cd.UnmarshalBinary(b[:cut]); err == nil {
+			c.failClass(ht, "BinaryPrefix", "UnmarshalBinary(%x) (prefix of %x) = %s", b[:cut], b, cd)
+		} else if !errors.Is(err, udecimal.ErrInvalidBinaryData) {
+			c.failClass(ht, "BinaryPrefixErr", "UnmarshalBinary(%x): %v, want ErrInvalidBinaryData", b[:cut], err)
+		}
+		bad := append([]byte(nil), b...)
+		bad[2] = byte(drawInt(ht, 0, 255))
+		if bad[2] != b[2] {
+			if err := cd.UnmarshalBinary(bad); err == nil {
+				c.failClass(ht, "BinaryLength", "UnmarshalBinary(%x) with length byte %d = %s", bad, bad[2], cd)
+			}
+		}
+		junk := make([]byte, drawInt(ht, 0, 24))
+		for i := range junk {
+			junk[i] = byte(drawInt(ht, 0, 255))
+		}
+		_ = cd.UnmarshalBinary(junk) // must not panic
+		bad = append([]byte(nil), b...)
+		bad[0] = byte(drawInt(ht, 0, 255))
+		_ = cd.UnmarshalBinary(bad) // must not panic
+	})
+}
