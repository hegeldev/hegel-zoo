--- /dev/null
+++ b/hegel/hegel_gen_test.go
@@ -0,0 +1,330 @@
+package hegel
+
+import (
+	"math"
+	"math/big"
+	"strings"
+
+	"github.com/quagmt/udecimal"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- exact arithmetic
+
+var (
+	bigZero = big.NewInt(0)
+	bigOne  = big.NewInt(1)
+	bigTen  = big.NewInt(10)
+	two63   = new(big.Int).Lsh(bigOne, 63)
+	two64   = new(big.Int).Lsh(bigOne, 64)
+	two128  = new(big.Int).Lsh(bigOne, 128)
+	ratHalf = big.NewRat(1, 2)
+)
+
+func pow10(n int) *big.Int { return new(big.Int).Exp(bigTen, big.NewInt(int64(n)), nil) }
+
+// ratPow10 is 10^n as a rational, n of either sign.
+func ratPow10(n int) *big.Rat {
+	if n >= 0 {
+		return new(big.Rat).SetInt(pow10(n))
+	}
+	return new(big.Rat).SetFrac(bigOne, pow10(-n))
+}
+
+// ratOf is (-1)^neg * coef / 10^prec.
+func ratOf(neg bool, coef *big.Int, prec uint8) *big.Rat {
+	r := new(big.Rat).SetFrac(coef, pow10(int(prec)))
+	if neg {
+		r.Neg(r)
+	}
+	return r
+}
+
+// ratOfDec reads a decimal's value back through its text.
+func ratOfDec(d udecimal.Decimal) *big.Rat {
+	r, ok := new(big.Rat).SetString(d.String())
+	if !ok {
+		panic("unparsable String(): " + d.String())
+	}
+	return r
+}
+
+// truncRat truncates r toward zero to prec fraction digits.
+func truncRat(r *big.Rat, prec int) *big.Rat {
+	return roundRat(r, prec, "trunc")
+}
+
+// roundRat rounds r to prec fraction digits with the named mode: trunc, away (away from
+// zero), haz (half away from zero), htz (half toward zero), bank (half to even), floor, ceil.
+func roundRat(r *big.Rat, prec int, mode string) *big.Rat {
+	scaled := new(big.Rat).Mul(r, ratPow10(prec))
+	q := new(big.Int).Quo(scaled.Num(), scaled.Denom()) // toward zero
+	rem := new(big.Rat).Sub(scaled, new(big.Rat).SetInt(q))
+	absRem := new(big.Rat).Abs(rem)
+	sign := int64(r.Sign())
+	step := func() { q.Add(q, big.NewInt(sign)) }
+	switch mode {
+	case "trunc":
+	case "away":
+		if rem.Sign() != 0 {
+			step()
+		}
+	case "haz":
+		if absRem.Cmp(ratHalf) >= 0 {
+			step()
+		}
+	case "htz":
+		if absRem.Cmp(ratHalf) > 0 {
+			step()
+		}
+	case "bank":
+		switch c := absRem.Cmp(ratHalf); {
+		case c > 0:
+			step()
+		case c == 0:
+			if q.Bit(0) == 1 {
+				step()
+			}
+		}
+	case "floor":
+		if rem.Sign() != 0 && sign < 0 {
+			step()
+		}
+	case "ceil":
+		if rem.Sign() != 0 && sign > 0 {
+			step()
+		}
+	default:
+		panic("mode " + mode)
+	}
+	return new(big.Rat).SetFrac(q, pow10(prec))
+}
+
+// ratPow is r^e for an integer e (r != 0 when e < 0).
+func ratPow(r *big.Rat, e int) *big.Rat {
+	n := new(big.Int).Exp(r.Num(), big.NewInt(int64(abs(e))), nil)
+	d := new(big.Int).Exp(r.Denom(), big.NewInt(int64(abs(e))), nil)
+	if e < 0 {
+		return new(big.Rat).SetFrac(d, n)
+	}
+	return new(big.Rat).SetFrac(n, d)
+}
+
+func abs(x int) int {
+	if x < 0 {
+		return -x
+	}
+	return x
+}
+
+// ratStr prints a rational exactly when it is a decimal fraction, else with 25 places.
+func ratStr(r *big.Rat) string {
+	for p := 0; p <= 60; p++ {
+		s := new(big.Rat).Mul(r, ratPow10(p))
+		if s.IsInt() {
+			return decText(s.Num(), p)
+		}
+	}
+	return r.FloatString(25)
+}
+
+// decText is the plain text of n / 10^prec (n signed), trailing zeros trimmed.
+func decText(n *big.Int, prec int) string {
+	neg := n.Sign() < 0
+	return canonText(neg, new(big.Int).Abs(n), uint8(prec))
+}
+
+// canonText is what String() must print for (-1)^neg * coef / 10^prec: no trailing zeros in
+// the fraction, no point after an integer, no sign on zero.
+func canonText(neg bool, coef *big.Int, prec uint8) string {
+	if coef.Sign() == 0 {
+		return "0"
+	}
+	s := fixedText(false, coef, prec)
+	if strings.Contains(s, ".") {
+		s = strings.TrimRight(s, "0")
+		s = strings.TrimSuffix(s, ".")
+	}
+	if neg {
+		s = "-" + s
+	}
+	return s
+}
+
+// fixedText is the plain text of (-1)^neg * coef / 10^prec with exactly prec fraction digits.
+func fixedText(neg bool, coef *big.Int, prec uint8) string {
+	s := coef.String()
+	if int(prec) >= len(s) {
+		s = strings.Repeat("0", int(prec)-len(s)+1) + s
+	}
+	if prec > 0 {
+		s = s[:len(s)-int(prec)] + "." + s[len(s)-int(prec):]
+	}
+	if neg {
+		s = "-" + s
+	}
+	return s
+}
+
+// --------------------------------------------------------------------------- generators
+
+// dec is a generated decimal with its exact value and the text String() must print.
+type dec struct {
+	d    udecimal.Decimal
+	neg  bool
+	coef *big.Int // magnitude of the coefficient
+	prec uint8
+	text string
+	r    *big.Rat
+	how  string // parse or hilo
+}
+
+func (x dec) String() string { return x.text + "{" + x.how + " prec " + itoa(int(x.prec)) + "}" }
+
+func itoa(n int) string { return big.NewInt(int64(n)).String() }
+
+var boundaryCoefs = []*big.Int{
+	new(big.Int).Sub(two63, bigOne), two63, new(big.Int).Add(two63, bigOne),
+	new(big.Int).Sub(two64, bigOne), two64, new(big.Int).Add(two64, bigOne),
+	new(big.Int).Sub(pow10(19), bigOne), pow10(19), new(big.Int).Add(pow10(19), bigOne), pow10(20),
+	new(big.Int).Sub(two128, bigOne), two128, new(big.Int).Add(two128, bigOne),
+	new(big.Int).Sub(pow10(38), bigOne), pow10(38), pow10(39), new(big.Int).Sub(pow10(39), bigOne),
+}
+
+// genDigits draws n decimal digits without a leading zero.
+func genDigits(ht *hegel.T, n int) string {
+	var b strings.Builder
+	b.WriteByte(byte('0' + drawInt(ht, 1, 9)))
+	for i := 1; i < n; i++ {
+		b.WriteByte(byte('0' + drawInt(ht, 0, 9)))
+	}
+	return b.String()
+}
+
+func bigFromDigits(s string) *big.Int {
+	n, ok := new(big.Int).SetString(s, 10)
+	if !ok {
+		panic("digits " + s)
+	}
+	return n
+}
+
+// genCoef draws a coefficient of at most maxDigits digits: mostly uint64-sized, then
+// 128-bit, then bigger, with the word boundaries and their neighbours.
+func genCoef(ht *hegel.T, maxDigits int) *big.Int {
+	t := drawInt(ht, 1, 100)
+	var n *big.Int
+	switch {
+	case t <= 8:
+		return new(big.Int)
+	case t <= 45:
+		return bigFromDigits(genDigits(ht, drawInt(ht, 1, min(19, maxDigits))))
+	case t <= 65:
+		return bigFromDigits(genDigits(ht, drawInt(ht, min(20, maxDigits), min(38, maxDigits))))
+	case t <= 80:
+		return bigFromDigits(genDigits(ht, drawInt(ht, min(39, maxDigits), min(60, maxDigits))))
+	case t <= 90:
+		n = new(big.Int).Set(pick(ht, boundaryCoefs))
+	default:
+		n = new(big.Int).Add(pick(ht, boundaryCoefs), big.NewInt(int64(drawInt(ht, -3, 3))))
+		if n.Sign() < 0 {
+			n.SetInt64(0)
+		}
+	}
+	if len(n.String()) > maxDigits {
+		n = bigFromDigits(genDigits(ht, min(19, maxDigits)))
+	}
+	return n
+}
+
+func genPrec(ht *hegel.T) uint8 {
+	t := drawInt(ht, 1, 100)
+	switch {
+	case t <= 25:
+		return 0
+	case t <= 35:
+		return 19
+	default:
+		return uint8(drawInt(ht, 1, 18))
+	}
+}
+
+// genDec draws a decimal of at most 60 digits.
+func genDec(ht *hegel.T) dec { return genDecMax(ht, 60) }
+
+// genDecMax draws a decimal of at most maxDigits digits, built by Parse of its plain text or,
+// when it fits, by NewFromHiLo.
+func genDecMax(ht *hegel.T, maxDigits int) dec {
+	coef := genCoef(ht, maxDigits)
+	prec := genPrec(ht)
+	neg := chance(ht, 45)
+	x := dec{neg: neg, coef: coef, prec: prec, text: canonText(neg, coef, prec), r: ratOf(neg, coef, prec)}
+	var err error
+	if coef.Cmp(two128) < 0 && chance(ht, 40) {
+		x.how = "hilo"
+		lo := new(big.Int).And(coef, new(big.Int).Sub(two64, bigOne)).Uint64()
+		hi := new(big.Int).Rsh(coef, 64).Uint64()
+		x.d, err = udecimal.NewFromHiLo(neg, hi, lo, prec)
+	} else {
+		x.how = "parse"
+		x.d, err = udecimal.Parse(fixedText(neg, coef, prec))
+	}
+	if err != nil {
+		ht.Fatalf("building %s (%s): %v", x.text, x.how, err)
+	}
+	return x
+}
+
+// genNonZero draws a decimal that is not zero.
+func genNonZero(ht *hegel.T) dec {
+	x := genDec(ht)
+	if x.coef.Sign() == 0 {
+		x.coef = big.NewInt(int64(drawInt(ht, 1, 9)))
+		x.neg = false
+		x.text = canonText(false, x.coef, x.prec)
+		x.r = ratOf(false, x.coef, x.prec)
+		x.how = "parse"
+		var err error
+		x.d, err = udecimal.Parse(fixedText(false, x.coef, x.prec))
+		if err != nil {
+			ht.Fatalf("building %s: %v", x.text, err)
+		}
+	}
+	return x
+}
+
+// genUint64 draws a uint64 with the extremes over-represented.
+func genUint64(ht *hegel.T) uint64 {
+	switch drawInt(ht, 1, 4) {
+	case 1:
+		return uint64(drawInt(ht, 0, 1000))
+	case 2:
+		return uint64(drawInt(ht, 0, math.MaxInt64))
+	case 3:
+		return math.MaxUint64 - uint64(drawInt(ht, 0, 3))
+	default:
+		return uint64(1)<<63 + uint64(drawInt(ht, 0, 3))
+	}
+}
+
+// genInt64 draws an int64 with the extremes over-represented.
+func genInt64(ht *hegel.T) int64 {
+	switch drawInt(ht, 1, 4) {
+	case 1:
+		return int64(drawInt(ht, -1000, 1000))
+	case 2:
+		v := int64(drawInt(ht, 0, math.MaxInt64))
+		if chance(ht, 50) {
+			v = -v
+		}
+		return v
+	case 3:
+		return math.MaxInt64 - int64(drawInt(ht, 0, 3))
+	default:
+		return math.MinInt64 + int64(drawInt(ht, 0, 3))
+	}
+}
+
+func bigOfU64(u uint64) *big.Int { return new(big.Int).SetUint64(u) }
+
+func bigOfI64(v int64) *big.Int { return big.NewInt(v) }
