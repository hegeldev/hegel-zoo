+// --------------------------------------------------------------------------- constructors
+
+// TestHegelConstructors: NewFromInt64/NewFromUint64/NewFromHiLo build coef / 10^prec and
+// reject prec > 19; NewFromFloat64 goes through the shortest float text; Scan accepts the
+// documented source types; Value and EncodeValues print the text; NullDecimal.
+func TestHegelConstructors(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		prec := uint8(drawInt(ht, 0, 19))
+		if chance(ht, 10) {
+			prec = uint8(drawInt(ht, 20, 255))
+		}
+		i := genInt64(ht)
+		u := genUint64(ht)
+
+		di, erri := udecimal.NewFromInt64(i, prec)
+		du, erru := udecimal.NewFromUint64(u, prec)
+		if prec > 19 {
+			if !errors.Is(erri, udecimal.ErrPrecOutOfRange) || !errors.Is(erru, udecimal.ErrPrecOutOfRange) {
+				c.failClass(ht, "PrecRange", "NewFromInt64(%d, %d): %v; NewFromUint64: %v", i, prec, erri, erru)
+			}
+			if _, err := udecimal.NewFromHiLo(false, 1, 1, prec); !errors.Is(err, udecimal.ErrPrecOutOfRange) {
+				c.failClass(ht, "HiLoPrec", "NewFromHiLo(prec %d): %v", prec, err)
+			}
+			if !panics(func() { udecimal.MustFromInt64(i, prec) }) || !panics(func() { udecimal.MustFromUint64(u, prec) }) {
+				c.failClass(ht, "MustPanics", "MustFromInt64/MustFromUint64 with prec %d did not panic", prec)
+			}
+			return
+		}
+		if erri != nil || erru != nil {
+			c.failClass(ht, "NewErr", "NewFromInt64(%d, %d): %v; NewFromUint64(%d, %d): %v", i, prec, erri, u, prec, erru)
+			return
+		}
+		wi := ratOf(i < 0, new(big.Int).Abs(bigOfI64(i)), prec)
+		wu := ratOf(false, bigOfU64(u), prec)
+		c.check(ht, "NewFromInt64", di, wi)
+		c.check(ht, "NewFromUint64", du, wu)
+		if differ(udecimal.MustFromInt64(i, prec), di) || differ(udecimal.MustFromUint64(u, prec), du) {
+			c.failClass(ht, "Must", "MustFromInt64/MustFromUint64 differ from NewFrom...")
+		}
+		// The documented precision: trailing zeros of the coefficient removed.
+		wantPrec := int(prec)
+		if !Known.constructorKeepsTrailingZeros {
+			for wantPrec > 0 && i%10 == 0 && i != 0 {
+				i /= 10
+				wantPrec--
+			}
+		}
+		if i != 0 && di.Prec() != wantPrec {
+			c.failClass(ht, "NewFromInt64Prec", "NewFromInt64(%d, %d).Prec() = %d, want %d", i, prec, di.Prec(), wantPrec)
+		}
+		if bytes := fixedText(i < 0, new(big.Int).Abs(bigOfI64(i)), prec); differ(udecimal.MustParse(bytes), di) && i != 0 {
+			// Parse and the constructor must build the same representation.
+			pi := udecimal.MustParse(bytes)
+			c.failClass(ht, "SameRep", "NewFromInt64(%d, %d) = %s prec %d; Parse(%q) prec %d: representations differ", i, prec, di, di.Prec(), bytes, pi.Prec())
+		}
+
+		// NewFromFloat64: the shortest text of f, parsed.
+		var f float64
+		switch drawInt(ht, 1, 5) {
+		case 1:
+			f = float64(i) / math.Pow(10, float64(prec))
+		case 2:
+			f = pick(ht, []float64{0, 0.1, -0.1, 1e-19, 1e-20, 1e20, 1e300, -1e300, 5e-324, math.MaxFloat64, 123456.789, 1.0001})
+		case 3:
+			f = math.Float64frombits(uint64(drawInt(ht, 0, math.MaxInt64)))
+		case 4:
+			f = di.InexactFloat64()
+		default:
+			f = pick(ht, []float64{math.NaN(), math.Inf(1), math.Inf(-1)})
+		}
+		df, errf := udecimal.NewFromFloat64(f)
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			if !errors.Is(errf, udecimal.ErrInvalidFormat) {
+				c.failClass(ht, "FloatSpecial", "NewFromFloat64(%v): %v, want ErrInvalidFormat", f, errf)
+			}
+		} else {
+			s := strconv.FormatFloat(f, 'f', -1, 64)
+			ps, errp := udecimal.Parse(s)
+			switch {
+			case (errp == nil) != (errf == nil):
+				c.failClass(ht, "Float", "NewFromFloat64(%v): %v; Parse(%q): %v", f, errf, s, errp)
+			case errp != nil && !errors.Is(errf, errp):
+				c.failClass(ht, "FloatErr", "NewFromFloat64(%v): %v; Parse(%q): %v", f, errf, s, errp)
+			case errp == nil && differ(df, ps):
+				c.failClass(ht, "Float", "NewFromFloat64(%v) = %s, Parse(%q) = %s", f, df, s, ps)
+			}
+			if errf == nil {
+				if r, _ := new(big.Rat).SetString(s); r.Cmp(ratOfDec(df)) != 0 {
+					c.failClass(ht, "FloatValue", "NewFromFloat64(%v) = %s, text %s", f, df, s)
+				}
+			}
+			if panics(func() { udecimal.MustFromFloat64(f) }) != (errf != nil) {
+				c.failClass(ht, "MustFloat", "MustFromFloat64(%v) panic does not match the error %v", f, errf)
+			}
+		}
+
+		// Scan from every documented source type.
+		x := genDec(ht)
+		var sd udecimal.Decimal
+		type scanCase struct {
+			src  any
+			want *big.Rat
+		}
+		cases := []scanCase{
+			{x.text, x.r}, {[]byte(x.text), x.r}, {u, wu.Mul(wu, ratPow10(int(prec)))}, {i, wi.Mul(wi, ratPow10(int(prec)))},
+			{int(i), wi}, {int32(i), new(big.Rat).SetInt64(int64(int32(i)))},
+		}
+		sc := pick(ht, cases)
+		if err := sd.Scan(sc.src); err != nil {
+			c.failClass(ht, "Scan", "Scan(%T %v): %v", sc.src, sc.src, err)
+		} else {
+			c.check(ht, "Scan", sd, sc.want)
+		}
+		if err := sd.Scan(f); (err == nil) != (errf == nil) {
+			c.failClass(ht, "ScanFloat", "Scan(%v): %v, NewFromFloat64: %v", f, err, errf)
+		}
+		if err := sd.Scan(nil); err == nil {
+			c.failClass(ht, "ScanNil", "Scan(nil) accepted")
+		}
+		if err := sd.Scan(true); err == nil {
+			c.failClass(ht, "ScanBool", "Scan(true) accepted")
+		}
+		if v, err := x.d.Value(); err != nil || v != x.text {
+			c.failClass(ht, "Value", "Value() of %s = %v (%T), %v", x, v, v, err)
+		}
+		vals := url.Values{}
+		if err := x.d.EncodeValues("k", &vals); err != nil || vals.Get("k") != x.text {
+			c.failClass(ht, "EncodeValues", "EncodeValues of %s: %v, %v", x, vals, err)
+		}
+
+		// NullDecimal.
+		var nd udecimal.NullDecimal
+		if err := nd.Scan(nil); err != nil || nd.Valid {
+			c.failClass(ht, "NullScanNil", "NullDecimal.Scan(nil): %v, Valid %v", err, nd.Valid)
+		}
+		if v, err := nd.Value(); err != nil || v != nil {
+			c.failClass(ht, "NullValue", "invalid NullDecimal.Value() = %v, %v", v, err)
+		}
+		if err := nd.Scan(x.text); err != nil || !nd.Valid || !nd.Decimal.Equal(x.d) {
+			c.failClass(ht, "NullScan", "NullDecimal.Scan(%q): %v, %+v", x.text, err, nd)
+		}
+		if v, err := nd.Value(); err != nil || v != x.text {
+			c.failClass(ht, "NullValue", "NullDecimal.Value() of %s = %v, %v", x, v, err)
+		}
+		nj, err := json.Marshal(nd)
+		if err != nil {
+			c.failClass(ht, "NullJSON", "json.Marshal(NullDecimal %s): %v", x, err)
+		} else {
+			var back udecimal.NullDecimal
+			if err := json.Unmarshal(nj, &back); err != nil || !back.Valid || !back.Decimal.Equal(x.d) {
+				c.failClass(ht, "NullJSON", "NullDecimal JSON %s -> %+v, %v", nj, back, err)
+			}
+		}
+		var nn udecimal.NullDecimal
+		if err := json.Unmarshal([]byte("null"), &nn); err != nil || nn.Valid {
+			c.failClass(ht, "NullJSONNull", "NullDecimal from null: %v, %+v", err, nn)
+		}
+	})
+}
