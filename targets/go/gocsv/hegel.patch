+// --------------------------------------------------------------------------- gocsv/12
+
+// raggedCase: a header of two to five names and rows read with the permissive reader, one of
+// them (lead) cut short of the header; under HEGEL_NO_KNOWN=1 the rows are full or longer.
+type raggedCase struct {
+	hdr  []string
+	rows []mapRow
+	lead int
+	cut  int
+}
+
+// body is the rows as read: the lead row cut short (and never a lone empty cell, which would
+// be an empty line), the others of the deltas drawn.
+func (r raggedCase) body() [][]string {
+	out := make([][]string, len(r.rows))
+	for i, row := range r.rows {
+		if !noKnown && i == r.lead%len(r.rows) {
+			row = mapRow{cells: row.cells, delta: -r.cut}
+		}
+		cells := append([]string{}, row.cellsFor(len(r.hdr))...)
+		if len(cells) == 1 && cells[0] == "" {
+			cells[0] = "x"
+		}
+		out[i] = cells
+	}
+	return out
+}
+
+func (r raggedCase) GoString() string { return fmt.Sprintf("header %q rows %q", r.hdr, r.body()) }
+
+var (
+	raggedDeltas = shaped(
+		weighted(choice[int]{2, hegel.Just(0)}, choice[int]{1, hegel.Integers(-3, -1)}, choice[int]{1, hegel.Integers(1, 2)}),
+		weighted(choice[int]{2, hegel.Just(0)}, choice[int]{1, hegel.Integers(1, 2)}),
+	)
+	raggedRows = hegel.Composite(func(tc hegel.TestCase) mapRow {
+		return mapRow{cells: hegel.Draw(tc, many(mapCells, 7, 7)), delta: hegel.Draw(tc, raggedDeltas)}
+	})
+	raggedCases = hegel.Composite(func(tc hegel.TestCase) raggedCase {
+		return raggedCase{
+			hdr:  hegel.Draw(tc, many(hegel.SampledFrom(mapNames), 2, 5)),
+			rows: hegel.Draw(tc, many(raggedRows, 1, 4)),
+			lead: hegel.Draw(tc, hegel.Integers(0, 9)),
+			cut:  hegel.Draw(tc, hegel.Integers(1, 3)),
+		}
+	})
+)
+
+// TestHegelRaggedRowsDoNotPanic: under the permissive reader (FieldsPerRecord = -1) CSVToMaps
+// maps the columns a short row has, and CSVToMap of two columns skips a row without a value;
+// both index past the row (gocsv/12).
+func TestHegelRaggedRowsDoNotPanic(t *testing.T) {
+	resetGlobals(t)
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		r := hegel.Draw(ht, raggedCases)
+		gocsv.SetCSVReader(permissiveReader)
+		rows := r.body()
+		text := writeCSV(append([][]string{r.hdr}, rows...))
+		wantMaps := []map[string]string{}
+		wantMap := map[string]string{}
+		for _, row := range rows {
+			mm := map[string]string{}
+			for j, h := range r.hdr {
+				if j < len(row) {
+					mm[h] = transported(row[j])
+				}
+			}
+			wantMaps = append(wantMaps, mm)
+			if len(row) >= 2 {
+				wantMap[transported(row[0])] = transported(row[1])
+			}
+		}
+		var got []map[string]string
+		var err error
+		if !c.call(ht, "CSVToMaps", shapesOf("gocsv/12"), func() { got, err = gocsv.CSVToMaps(strings.NewReader(text)) }) {
+			return
+		}
+		if err != nil || !reflect.DeepEqual(got, wantMaps) {
+			c.mismatch(ht, shapesOf("gocsv/12"), "CSVToMaps(%q): %v\n got  %v\n want %v", text, err, got, wantMaps)
+			return
+		}
+		if len(r.hdr) != 2 {
+			return
+		}
+		var m map[string]string
+		if !c.call(ht, "CSVToMap", shapesOf("gocsv/12"), func() { m, err = gocsv.CSVToMap(strings.NewReader(text)) }) {
+			return
+		}
+		if err != nil || !reflect.DeepEqual(m, wantMap) {
+			c.mismatch(ht, shapesOf("gocsv/12"), "CSVToMap(%q): %v\n got  %v\n want %v", text, err, m, wantMap)
+		}
+	})
+}
