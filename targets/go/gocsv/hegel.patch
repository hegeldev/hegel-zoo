+package gocsv_test
+
+// Hegel property tests for gocarina/gocsv, written for the Hegel zoo.
+// See targets/go/gocsv/README.md.
+//
+// Oracles: a model of the documented column layout (tags, nested and inline structs, csv[]
+// expansion, JSON fallback) and cell conversions (strconv with the field's width, the lenient
+// bool/int/float rules, omitempty and default=) over struct types whose headers are written
+// by hand; encoding/csv for the text itself; and gocsv's own entry points against each other
+// (every Unmarshal* path must agree on the same text).
+//
+// Generators are package-level values built from the binding's combinators: cells and numbers
+// as combinators (digit runs, signs, fractions, exponents, decimal commas, the bool words,
+// NaN/Inf and garbage as explicit alternatives, the plain piece first), one Composite record
+// per struct type under test, tables, headers and column orders as records rendered by pure
+// functions. The shapes of the recorded bugs (bugs.toml) are drawn by default - the types with
+// an interface{}, a multi-key nested, an array, a map or a Stringer field are alternatives of
+// the row kinds, the headerless texts get extra columns, the target slice is pre-filled, the
+// csv[] columns come in any order - so the property that meets a shape fails naming the bug
+// (mismatch) and is the expected failure mapped to it; the pins are the regression examples
+// and hegel_shapes_test.go has one narrow property per bug. HEGEL_NO_KNOWN=1 (noKnown, read
+// once) switches the Known steering on and looks past the recorded bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"bytes"
+	"encoding/csv"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/gocarina/gocsv"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the model on a case whose recorded shapes are named
+// (none for a plain failure): each shape is counted and the case fails naming the bugs, or under
+// HEGEL_NO_KNOWN=1 is assumed away.
+func (c *collector) mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if len(shapes) == 0 {
+		c.fail(ht, format, args...)
+		return
+	}
+	for _, s := range shapes {
+		c.count("shape " + s)
+	}
+	if noKnown {
+		ht.Assume(false)
+	}
+	c.fail(ht, format+" (the shape of "+strings.Join(shapes, ", ")+")", args...)
+}
+
+// call runs one gocsv entry point and reports a panic as a mismatch naming the case's shapes;
+// ok is false when it panicked.
+func (c *collector) call(ht *hegel.T, what string, shapes []string, f func()) (ok bool) {
+	if r := catch(f); r != nil {
+		c.mismatch(ht, shapes, "%s panics: %v", what, r)
+		return false
+	}
+	return true
+}
+
+// catch runs f and returns the panic value, if any.
+func catch(f func()) (r any) {
+	defer func() { r = recover() }()
+	f()
+	return nil
+}
+
+// resetGlobals restores gocsv's package-level switches after a test.
+func resetGlobals(t *testing.T) {
+	t.Cleanup(func() {
+		gocsv.FailIfUnmatchedStructTags = false
+		gocsv.FailIfDoubleHeaderNames = false
+		gocsv.ShouldAlignDuplicateHeadersWithStructFieldOrder = false
+		gocsv.SetHeaderNormalizer(gocsv.DefaultNameNormalizer())
+		gocsv.SetCSVReader(gocsv.DefaultCSVReader)
+	})
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw every recorded shape and the model says what the documentation says, so
+// a property that meets a shape fails naming the bug (mismatch); under HEGEL_NO_KNOWN=1 the
+// Known switches below steer the generators and the model off the shapes, and a disagreement on
+// a shape that is still reached is counted and assumed away.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml). A switch is on only under HEGEL_NO_KNOWN=1: the
+// properties then avoid the shape (or follow the code where the model otherwise follows the
+// documentation); the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// gocsv/1: a csv[] column whose index is beyond the slice's current capacity growth
+	// (columns out of order or missing) panics in reflect SetLen. On: the predicted panic is
+	// asserted and the case ends.
+	sliceGrowthPanics bool
+	// gocsv/2: Unmarshal into a struct with an interface{} field panics (Marshal accepts it).
+	// On: the Any row kind is not drawn.
+	interfacePanics bool
+	// gocsv/3: UnmarshalToChanWithoutHeaders panics on a row with more columns than fields,
+	// where UnmarshalWithoutHeaders ignores the extra columns. On: the channel path skips the
+	// texts with an extra column.
+	headerlessChanPanics bool
+	// gocsv/4: an integer cell wider than the field wraps silently (300 into int8 is 44). On:
+	// counted and the column skipped.
+	intWraps bool
+	// gocsv/5: a uint cell containing '.' goes through ParseFloat and a float-to-uint
+	// conversion: negatives give 2^64-1, exponents are accepted (int cells are not). On:
+	// counted and the column skipped.
+	uintFloatPath bool
+	// gocsv/6: float32 cells are parsed at 64 bits and rounded: out of range gives +-Inf
+	// silently, long decimals can double-round. On: counted and the column skipped.
+	float32Via64 bool
+	// gocsv/7: several keys on a nested struct field produce q.p.a instead of q.a. On: the
+	// MultiKey row kind, read through its second key, is not drawn.
+	multiKeyCartesian bool
+	// gocsv/8: an array field without a csv[] tag is written as JSON that Unmarshal rejects.
+	// On: the Arr row kind is not drawn.
+	arrayNeedsTag bool
+	// gocsv/9: a map field is written as an empty cell without error and rejected on read.
+	// On: the Mapped row kind is not drawn.
+	mapFieldUnreadable bool
+	// gocsv/10: FailIfUnmatchedStructTags and the Unmarshaller's Mismatched* lists compare
+	// headers exactly while the column mapping trims spaces and zero-width characters and
+	// honours partial. On: the headers matched only after trimming are not drawn.
+	fuzzyMatchNotCounted bool
+	// gocsv/11: Unmarshal into a slice longer than the CSV keeps the stale trailing elements.
+	// On: only the first rows of the longer slice are checked.
+	staleSliceElements bool
+	// gocsv/12: CSVToMaps and CSVToChanMaps panic on a row shorter than the header under a
+	// reader with FieldsPerRecord = -1. On: the permissive reader and ragged rows are not drawn.
+	raggedMapsPanic bool
+	// gocsv/13: Marshal uses Stringer for a named integer type (time.Duration) that Unmarshal
+	// then cannot read. On: the Dur row kind is not drawn.
+	stringerUnreadable bool
+	// gocsv/14: the WithoutHeaders paths ignore the default= tag option. On: the model of the
+	// headerless paths ignores it too.
+	headerlessIgnoresDefault bool
+	// gocsv/15: UnmarshalToChanWithoutHeaders reports a conversion error one line too far (it
+	// counts a header there is none). On: the model of that path counts it too.
+	headerlessChanLineOffByOne bool
+}{noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what it
+// shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table of texts (the first is the shrink target).
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// counted is a list of as many elements as count draws (the count shrinks first).
+func counted[T any](g hegel.Generator[T], count hegel.Generator[int]) hegel.Generator[[]T] {
+	return hegel.FlatMap(count, func(n int) hegel.Generator[[]T] { return many(g, n, n) })
+}
+
+// joined is the texts of a list generator joined with sep.
+func joined(g hegel.Generator[[]string], sep string) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, sep) })
+}
+
+// cat draws one text from each generator and concatenates them (a tuple of texts; a Composite
+// only because the binding has no tuple combinator).
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// ptrTo is a pointer to a value of g, nil pct percent of the time (the shrink target).
+func ptrTo[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return weighted(choice[*T]{pct, hegel.Just[*T](nil)}, choice[*T]{100 - pct, hegel.Map(g, func(v T) *T { return &v })})
+}
+
+// nonNil is the slice as an empty one when Lists drew no element (it yields nil then).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+// --------------------------------------------------------------------------- types under test
+
+// Hex implements gocsv's TypeMarshaller/TypeUnmarshaller pair.
+type Hex uint32
+
+func (h Hex) MarshalCSV() (string, error) { return fmt.Sprintf("0x%x", uint32(h)), nil }
+
+func (h *Hex) UnmarshalCSV(s string) error {
+	if s == "" {
+		*h = 0
+		return nil
+	}
+	v, err := strconv.ParseUint(strings.TrimPrefix(s, "0x"), 16, 32)
+	*h = Hex(v)
+	return err
+}
+
+type MyInt int32
+type MyStr string
+
+type Bar struct {
+	A int `csv:"a"`
+	B int `csv:"b"`
+}
+
+type Embedded struct {
+	E1 int  `csv:"e1"`
+	E2 bool `csv:"e2"`
+}
+
+type Outer struct {
+	Q Bar `csv:"q"`
+	R *Bar
+}
+
+type Prim struct {
+	S      string    `csv:"s"`
+	B      bool      `csv:"b"`
+	I      int       `csv:"i"`
+	I8     int8      `csv:"i8"`
+	I16    int16     `csv:"i16"`
+	I32    int32     `csv:"i32"`
+	I64    int64     `csv:"i64"`
+	U      uint      `csv:"u"`
+	U8     uint8     `csv:"u8"`
+	U16    uint16    `csv:"u16"`
+	U32    uint32    `csv:"u32"`
+	U64    uint64    `csv:"u64"`
+	F32    float32   `csv:"f32"`
+	F64    float64   `csv:"f64"`
+	MI     MyInt     `csv:"mi"`
+	MS     MyStr     `csv:"ms"`
+	Name   string    // untagged: the field name is the header
+	Skip   string    `csv:"-"`
+	hidden string    // unexported: ignored
+	H      Hex       `csv:"h"`
+	T      time.Time `csv:"t"`
+}
+
+type Ptrs struct {
+	S   *string    `csv:"s"`
+	SO  *string    `csv:"so,omitempty"`
+	SD  *string    `csv:"sd,default=dflt"`
+	SOD *string    `csv:"sod,omitempty,default=x y"`
+	I   *int       `csv:"i"`
+	IO  *int8      `csv:"io,omitempty"`
+	F   *float64   `csv:"f"`
+	B   *bool      `csv:"b,default=yes"`
+	D   string     `csv:"d,default=7"`
+	N   int        `csv:"n,default=42"`
+	H   *Hex       `csv:"h,omitempty"`
+	T   *time.Time `csv:"t"`
+}
+
+type Nested struct {
+	Id  int  `csv:"id"`
+	Bar Bar  // untagged nested struct: Bar.a, Bar.b
+	P   *Bar `csv:"p"`
+	In  Bar  `csv:"."`
+	Embedded
+	Deep  Outer `csv:"o"`
+	Skip  Bar   `csv:"-"`
+	Multi Bar   `csv:"m,mm"`
+}
+
+type Arrays struct {
+	Id int      `csv:"id"`
+	V  []int    `csv:"v" csv[]:"3"`
+	W  []Bar    `csv:"w" csv[]:"2"`
+	X  [2]int8  `csv:"x" csv[]:"2"`
+	J  []string `csv:"j"`
+	K  []Bar    `csv:"k"`
+}
+
+// The shapes of the recorded bugs that live in a struct type: an interface{} field (gocsv/2),
+// a nested struct field with several keys read through its second key (gocsv/7), an array
+// field without a csv[] tag (gocsv/8), a map field (gocsv/9), a named integer type with a
+// String method (gocsv/13).
+type Any struct {
+	Id  int         `csv:"id"`
+	Any interface{} `csv:"any"`
+}
+
+type MultiKey struct {
+	Bar Bar `csv:"p,q"`
+	X   int `csv:"x"`
+}
+
+type Arr struct {
+	Id int    `csv:"id"`
+	A  [2]int `csv:"a"`
+}
+
+type Mapped struct {
+	Id int            `csv:"id"`
+	M  map[string]int `csv:"m"`
+}
+
+type Dur struct {
+	Id int           `csv:"id"`
+	D  time.Duration `csv:"d"`
+}
+
+var (
+	primT     = reflect.TypeOf(Prim{})
+	ptrsT     = reflect.TypeOf(Ptrs{})
+	nestedT   = reflect.TypeOf(Nested{})
+	arraysT   = reflect.TypeOf(Arrays{})
+	anyT      = reflect.TypeOf(Any{})
+	multiKeyT = reflect.TypeOf(MultiKey{})
+	arrT      = reflect.TypeOf(Arr{})
+	mappedT   = reflect.TypeOf(Mapped{})
+	durT      = reflect.TypeOf(Dur{})
+)
+
+// headers: the documented header of each type, by hand (what Marshal writes: the first key of
+// every field).
+var headers = map[reflect.Type]string{
+	primT:     "s,b,i,i8,i16,i32,i64,u,u8,u16,u32,u64,f32,f64,mi,ms,Name,h,t",
+	ptrsT:     "s,so,sd,sod,i,io,f,b,d,n,h,t",
+	nestedT:   "id,Bar.a,Bar.b,p.a,p.b,a,b,e1,e2,o.q.a,o.q.b,o.R.a,o.R.b,m.a,m.b",
+	arraysT:   "id,v[0],v[1],v[2],w[0].a,w[0].b,w[1].a,w[1].b,x[0],x[1],j,k",
+	anyT:      "id,any",
+	multiKeyT: "p.a,p.b,x",
+	arrT:      "id,a",
+	mappedT:   "id,m",
+	durT:      "id,d",
+}
+
+// --------------------------------------------------------------------------- column model
+
+// step is one move from a struct value to a column's leaf: a field index or a slice index.
+type step struct {
+	i     int
+	index bool
+}
+
+// col is one CSV column of a struct type.
+type col struct {
+	steps []step
+	omit  bool
+	dflt  string
+}
+
+var (
+	typeMarshaller = reflect.TypeOf((*gocsv.TypeMarshaller)(nil)).Elem()
+	textMarshaler  = reflect.TypeOf((*interface{ MarshalText() ([]byte, error) })(nil)).Elem()
+)
+
+// opaque: a struct type that is one cell (it has a marshalling method), not a set of columns.
+func opaque(t reflect.Type) bool {
+	p := reflect.PtrTo(t)
+	return t.Implements(typeMarshaller) || p.Implements(typeMarshaller) || t.Implements(textMarshaler) || p.Implements(textMarshaler)
+}
+
+func parseTag(tag string) (names []string, omit bool, dflt string) {
+	for _, part := range strings.Split(tag, ",") {
+		part = strings.TrimSpace(part)
+		switch {
+		case part == "omitempty":
+			omit = true
+		case part == "partial":
+		case strings.HasPrefix(part, "default="):
+			dflt = strings.TrimPrefix(part, "default=")
+		default:
+			names = append(names, part)
+		}
+	}
+	return
+}
+
+func layout(t reflect.Type) []col {
+	var out []col
+	layoutInto(t, nil, &out)
+	return out
+}
+
+func layoutInto(t reflect.Type, prefix []step, out *[]col) {
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.PkgPath != "" {
+			continue
+		}
+		names, omit, dflt := parseTag(f.Tag.Get("csv"))
+		if len(names) == 1 && names[0] == "-" {
+			continue
+		}
+		steps := append(append([]step{}, prefix...), step{i, false})
+		ft := f.Type
+		if ft.Kind() == reflect.Ptr {
+			ft = ft.Elem()
+		}
+		if ft.Kind() == reflect.Struct && !opaque(ft) {
+			layoutInto(ft, steps, out)
+			continue
+		}
+		if f.Type.Kind() == reflect.Slice || f.Type.Kind() == reflect.Array {
+			if tag, ok := f.Tag.Lookup("csv[]"); ok {
+				count, _ := strconv.Atoi(tag)
+				if count > 0 {
+					for idx := 0; idx < count; idx++ {
+						at := append(append([]step{}, steps...), step{idx, true})
+						if f.Type.Elem().Kind() == reflect.Struct {
+							layoutInto(f.Type.Elem(), at, out)
+						} else {
+							*out = append(*out, col{at, omit, dflt})
+						}
+					}
+					continue
+				}
+			}
+		}
+		*out = append(*out, col{steps, omit, dflt})
+	}
+}
+
+// cellOf: the documented text of one column of a struct value.
+func cellOf(root reflect.Value, c col) string {
+	v := root
+	for _, s := range c.steps {
+		if v.Kind() == reflect.Ptr {
+			if v.IsNil() {
+				return ""
+			}
+			v = v.Elem()
+		}
+		if s.index {
+			if s.i >= v.Len() {
+				return ""
+			}
+			v = v.Index(s.i)
+		} else {
+			v = v.Field(s.i)
+		}
+	}
+	return leafString(v)
+}
+
+// leafString: a nil pointer or interface is an empty cell; a marshalling method (MarshalCSV,
+// MarshalText, String) writes the cell; the native kinds are formatted by strconv; slices,
+// arrays and maps without a csv[] tag are JSON.
+func leafString(v reflect.Value) string {
+	if v.Kind() == reflect.Ptr || v.Kind() == reflect.Interface {
+		if v.IsNil() {
+			return ""
+		}
+		v = v.Elem()
+	}
+	switch x := v.Interface().(type) {
+	case Hex:
+		s, _ := x.MarshalCSV()
+		return s
+	case time.Time:
+		b, _ := x.MarshalText()
+		return string(b)
+	case time.Duration:
+		return x.String()
+	}
+	switch v.Kind() {
+	case reflect.String:
+		return v.String()
+	case reflect.Bool:
+		return strconv.FormatBool(v.Bool())
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return strconv.FormatInt(v.Int(), 10)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return strconv.FormatUint(v.Uint(), 10)
+	case reflect.Float32:
+		return strconv.FormatFloat(v.Float(), 'f', -1, 32)
+	case reflect.Float64:
+		return strconv.FormatFloat(v.Float(), 'f', -1, 64)
+	case reflect.Slice, reflect.Array, reflect.Map:
+		b, _ := json.Marshal(v.Interface())
+		return string(b)
+	}
+	panic("leafString: " + v.Type().String())
+}
+
+func cellsOf(root reflect.Value, cols []col) []string {
+	out := make([]string, len(cols))
+	for i, c := range cols {
+		out[i] = cellOf(root, c)
+	}
+	return out
+}
+
+// decodeInto sets one column of an addressable struct value from its cell, allocating the
+// pointers and growing the slices on the way, as documented.
+func decodeInto(root reflect.Value, c col, cell string, useDefault bool) error {
+	v := root
+	for _, s := range c.steps {
+		if v.Kind() == reflect.Ptr {
+			if v.IsNil() {
+				v.Set(reflect.New(v.Type().Elem()))
+			}
+			v = v.Elem()
+		}
+		if s.index {
+			if v.Kind() == reflect.Slice && s.i >= v.Len() {
+				grown := reflect.MakeSlice(v.Type(), s.i+1, s.i+1)
+				reflect.Copy(grown, v)
+				v.Set(grown)
+			}
+			v = v.Index(s.i)
+		} else {
+			v = v.Field(s.i)
+		}
+	}
+	if cell == "" && useDefault {
+		cell = c.dflt
+	}
+	return setLeaf(v, cell, c.omit)
+}
+
+// setLeaf reads a cell into a leaf: the pointer is allocated (left nil by omitempty on an empty
+// cell), an interface{} field holds the cell as a string, an unmarshalling method (UnmarshalCSV,
+// UnmarshalText, the inverse of String for a Duration) reads it, the native kinds follow the
+// lenient rules below, and the JSON kinds read their JSON.
+func setLeaf(v reflect.Value, cell string, omit bool) error {
+	if v.Kind() == reflect.Ptr {
+		if omit && cell == "" {
+			return nil
+		}
+		if v.IsNil() {
+			v.Set(reflect.New(v.Type().Elem()))
+		}
+		v = v.Elem()
+	}
+	if v.Kind() == reflect.Interface {
+		v.Set(reflect.ValueOf(cell))
+		return nil
+	}
+	switch x := v.Addr().Interface().(type) {
+	case *Hex:
+		return x.UnmarshalCSV(cell)
+	case *time.Time:
+		return x.UnmarshalText([]byte(cell))
+	case *time.Duration:
+		if strings.TrimSpace(cell) == "" {
+			*x = 0
+			return nil
+		}
+		d, err := time.ParseDuration(strings.TrimSpace(cell))
+		*x = d
+		return err
+	}
+	switch v.Kind() {
+	case reflect.String:
+		v.SetString(cell)
+	case reflect.Bool:
+		b, err := modelBool(cell)
+		if err != nil {
+			return err
+		}
+		v.SetBool(b)
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		i, err := modelInt(cell, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetInt(i)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		u, err := modelUint(cell, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetUint(u)
+	case reflect.Float32, reflect.Float64:
+		f, err := modelFloat(cell, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetFloat(f)
+	case reflect.Slice, reflect.Array, reflect.Map:
+		if cell == "" {
+			return nil
+		}
+		return json.Unmarshal([]byte(cell), v.Addr().Interface())
+	default:
+		panic("setLeaf: " + v.Type().String())
+	}
+	return nil
+}
+
+// The documented (and lenient) cell conversions: whitespace trimmed, an empty cell is the zero
+// value, yes/no for bools, an integer cell may carry a fractional part that is dropped, a float
+// cell may use a decimal comma. Widths are the field's: a cell that does not fit is an error.
+func modelBool(s string) (bool, error) {
+	s = strings.TrimSpace(s)
+	if strings.EqualFold(s, "yes") {
+		return true, nil
+	}
+	if strings.EqualFold(s, "no") || s == "" {
+		return false, nil
+	}
+	return strconv.ParseBool(s)
+}
+
+func modelInt(s string, bits int) (int64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, nil
+	}
+	return strconv.ParseInt(strings.SplitN(s, ".", 2)[0], 10, bits)
+}
+
+func modelUint(s string, bits int) (uint64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, nil
+	}
+	return strconv.ParseUint(strings.SplitN(s, ".", 2)[0], 10, bits)
+}
+
+func modelFloat(s string, bits int) (float64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, nil
+	}
+	return strconv.ParseFloat(strings.ReplaceAll(s, ",", "."), bits)
+}
+
+// decodeRow builds a struct of type t from the cells of its columns; the error is the first
+// column's, with its index.
+func decodeRow(t reflect.Type, cols []col, cells []string, useDefault bool) (reflect.Value, int, error) {
+	v := reflect.New(t).Elem()
+	for j, c := range cols {
+		if j >= len(cells) {
+			break
+		}
+		if err := decodeInto(v, c, cells[j], useDefault); err != nil {
+			return v, j, err
+		}
+	}
+	return v, -1, nil
+}
+
+// same: structural equality with NaN equal to NaN and time.Time by Equal.
+func same(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	switch a.Kind() {
+	case reflect.Ptr:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() == b.IsNil()
+		}
+		return same(a.Elem(), b.Elem())
+	case reflect.Struct:
+		if ta, ok := a.Interface().(time.Time); ok {
+			return ta.Equal(b.Interface().(time.Time))
+		}
+		for i := 0; i < a.NumField(); i++ {
+			if a.Type().Field(i).PkgPath != "" {
+				continue
+			}
+			if !same(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Slice:
+		if a.IsNil() != b.IsNil() || a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Array:
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Float32, reflect.Float64:
+		x, y := a.Float(), b.Float()
+		return x == y || (math.IsNaN(x) && math.IsNaN(y))
+	}
+	return reflect.DeepEqual(a.Interface(), b.Interface())
+}
+
+func show(v reflect.Value) string {
+	if !v.IsValid() {
+		return "nil"
+	}
+	return fmt.Sprintf("%+v", v.Interface())
+}
