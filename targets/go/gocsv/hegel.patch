+// shapes names the recorded bug the kind is the shape of, once the table has a row to read.
+func (k rowKind) shapes(tb *table) []string {
+	if k.shape == "" || len(tb.rows) == 0 {
+		return nil
+	}
+	return []string{k.shape}
+}
