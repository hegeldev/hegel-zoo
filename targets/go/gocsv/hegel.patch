+	replaceKinds     = []rowKind{{t: primT}, {t: nestedT}, {t: arraysT}}
+	longerSliceCases = hegel.Composite(func(tc hegel.TestCase) longerSliceCase {
+		kind := hegel.Draw(tc, hegel.SampledFrom(replaceKinds))
