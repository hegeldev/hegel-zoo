+
+// trimmedHeaderCase: one column per field of Hdr (b through either of its keys) in a drawn
+// order, each as written or dressed by a form the mapping trims (a space on either side, a
+// BOM, a zero-width character), one of them (lead) always dressed; under HEGEL_NO_KNOWN=1 every
+// column as written.
+type trimmedHeaderCase struct {
+	bKey  string
+	keys  []int
+	decos []string
+	lead  int
+	rows  [][]string
+}
+
+var (
+	trimDecos          = []string{"padL", "padR", "bom", "zwAfter", "zwBefore"}
+	trimmedHeaderCases = hegel.Composite(func(tc hegel.TestCase) trimmedHeaderCase {
+		return trimmedHeaderCase{
+			bKey:  hegel.Draw(tc, pick("b", "bb")),
+			keys:  hegel.Draw(tc, many(hegel.Integers(0, 4), 5, 5)),
+			decos: hegel.Draw(tc, many(shaped(hegel.SampledFrom([]string{"", "", "padL", "padR", "bom", "zwAfter", "zwBefore"}), lit("")), 5, 5)),
+			lead:  hegel.Draw(tc, hegel.Integers(0, 4)),
+			rows:  hegel.Draw(tc, many(many(hdrValues, 5, 5), 1, 2)),
+		}
+	})
+)
+
+// columns are the header columns in their order, with the field each one is for.
+func (h trimmedHeaderCase) columns() (hdr []string, field []int) {
+	bases := []string{"a", h.bKey, "c", "D", "e"}
+	order := columnOrder{keys: h.keys, dropped: make([]bool, 5)}.kept()
+	for p, f := range order {
+		deco := h.decos[f]
+		if !noKnown && p == h.lead {
+			deco = trimDecos[h.keys[f]%len(trimDecos)]
+		}
+		hdr = append(hdr, hdrCol{base: bases[f], deco: deco}.render())
+		field = append(field, f)
+	}
+	return
+}
+
+func (h trimmedHeaderCase) GoString() string {
+	hdr, _ := h.columns()
+	return fmt.Sprintf("header %q rows %q", hdr, h.rows)
+}
+
+// TestHegelTrimmedHeadersCountAsMatched: with FailIfUnmatchedStructTags, a header matched after
+// trimming a space, a BOM or a zero-width character is matched, the rows decode and the
+// Unmarshaller lists no mismatch (gocsv/10 compares the headers exactly there).
+func TestHegelTrimmedHeadersCountAsMatched(t *testing.T) {
+	resetGlobals(t)
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		h := hegel.Draw(ht, trimmedHeaderCases)
+		gocsv.FailIfUnmatchedStructTags = true
+		hdr, field := h.columns()
+		fields := hdrFields(func(s string) string { return s })
+		text := writeCSV(append([][]string{hdr}, h.rows...))
+		want := make([]Hdr, len(h.rows))
+		for i, row := range h.rows {
+			v := reflect.ValueOf(&want[i]).Elem()
+			for j, cell := range row {
+				if cell == "" {
+					cell = fields[field[j]].dflt
+				}
+				v.Field(field[j]).SetString(cell)
+			}
+		}
+		var got []Hdr
+		if err := gocsv.UnmarshalString(text, &got); err != nil {
+			c.mismatch(ht, shapesOf("gocsv/10"), "FailIfUnmatchedStructTags with header %q: %v, every field is matched", hdr, err)
+			return
+		}
+		if !reflect.DeepEqual(got, want) {
+			c.fail(ht, "header %q:\n got  %+v\n want %+v", hdr, got, want)
+			return
+		}
+		um, err := gocsv.NewUnmarshaller(csv.NewReader(strings.NewReader(text)), Hdr{})
+		if err != nil {
+			c.mismatch(ht, shapesOf("gocsv/10"), "NewUnmarshaller with header %q: %v", hdr, err)
+			return
+		}
+		if len(um.MismatchedHeaders) != 0 || len(um.MismatchedStructFields) != 0 {
+			c.mismatch(ht, shapesOf("gocsv/10"), "Unmarshaller mismatches with header %q: headers %q fields %q, every column is mapped", hdr, um.MismatchedHeaders, um.MismatchedStructFields)
+		}
+	})
+}
