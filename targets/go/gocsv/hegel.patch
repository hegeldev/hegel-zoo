+// int64s is a value of a signed integer field of the width: a small one half the time, a
+// boundary one a quarter, any one a quarter.
+func int64s(bits int) hegel.Generator[int64] {
+	lo, hi := -(int64(1) << (bits - 1)), int64(1)<<(bits-1)-1
+	return weighted(
+		choice[int64]{2, hegel.Integers(int64(-1000), 1000)},
+		choice[int64]{1, hegel.SampledFrom([]int64{0, 1, -1, lo, hi, lo + 1, hi - 1})},
+		choice[int64]{1, hegel.Integers(lo, hi)},
+	)
+}
+
+func uint64s(bits int) hegel.Generator[uint64] {
+	hi := uint64(1)<<bits - 1
+	if bits == 64 {
+		hi = math.MaxUint64
+	}
+	return weighted(
+		choice[uint64]{2, hegel.Integers(uint64(0), 1000)},
+		choice[uint64]{1, hegel.SampledFrom([]uint64{0, 1, hi, hi - 1})},
+		choice[uint64]{1, hegel.Integers(uint64(0), hi)},
+	)
+}
+
+// float64s is a value of a float field of the width: an ordinary magnitude, one of the special
+// table, or random bits (a subnormal or NaN most of the time), rounded to float32 for that width.
+func float64s(bits int) hegel.Generator[float64] {
+	ordinary := hegel.Floats[float64]().Min(-1e6).Max(1e6).AllowNaN(false).AllowInfinity(false)
+	var anyBits hegel.Generator[float64]
+	if bits == 32 {
+		anyBits = hegel.Map(hegel.Integers(uint32(0), math.MaxUint32), func(u uint32) float64 { return float64(math.Float32frombits(u)) })
+	} else {
+		anyBits = hegel.Map(hegel.Integers(uint64(0), math.MaxUint64), math.Float64frombits)
+	}
+	g := weighted(choice[float64]{3, ordinary}, choice[float64]{4, hegel.SampledFrom(floatSpecials)}, choice[float64]{3, anyBits})
+	if bits == 32 {
+		return hegel.Map(g, func(f float64) float64 { return float64(float32(f)) })
+	}
+	return g
+}
+
+func intsOf[T ~int | ~int8 | ~int16 | ~int32 | ~int64](bits int) hegel.Generator[T] {
+	return hegel.Map(int64s(bits), func(i int64) T { return T(i) })
+}
+
+func uintsOf[T ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64](bits int) hegel.Generator[T] {
+	return hegel.Map(uint64s(bits), func(u uint64) T { return T(u) })
+}
+
+func floatsOf[T ~float32 | ~float64](bits int) hegel.Generator[T] {
+	return hegel.Map(float64s(bits), func(f float64) T { return T(f) })
+}
+
+// csvSlice is a slice behind a csv[] tag of n columns: up to n elements, one beyond the tag's
+// count (not written) one time in ten.
+func csvSlice[T any](g hegel.Generator[T], n int) hegel.Generator[[]T] {
+	return counted(g, weighted(choice[int]{9, hegel.Integers(0, n)}, choice[int]{1, hegel.Just(n + 1)}))
+}
+
+// jsonSlice is a slice written as JSON: nil one time in five, else up to three elements.
+func jsonSlice[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return weighted(choice[[]T]{1, hegel.Just[[]T](nil)}, choice[[]T]{4, hegel.Map(many(g, 0, 3), nonNil[T])})
+}
