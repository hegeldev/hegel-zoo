+// defaultCase: rows of Dflt with the cell of one defaulted column of one row (blankRow,
+// blankCol, modulo) emptied; under HEGEL_NO_KNOWN=1 every empty defaulted cell filled instead.
+type defaultCase struct {
+	rows               []reflect.Value
+	blankRow, blankCol int
+}
+
+var (
+	defaultedCols = []int{0, 1, 2} // d, n, p
+	dfltRows      = someRows(dfltT)
+	defaultCases  = hegel.Composite(func(tc hegel.TestCase) defaultCase {
+		return defaultCase{rows: []reflect.Value(hegel.Draw(tc, dfltRows)), blankRow: hegel.Draw(tc, hegel.Integers(0, 9)), blankCol: hegel.Draw(tc, hegel.Integers(0, 2))}
+	})
+)
