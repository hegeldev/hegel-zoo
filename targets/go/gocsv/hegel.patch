+// TestHegelUnmarshalReplacesTheSlice: Unmarshal into a pre-filled slice leaves the rows and
+// nothing else; a slice longer than the rows keeps its stale tail (gocsv/11).
+func TestHegelUnmarshalReplacesTheSlice(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		l := hegel.Draw(ht, longerSliceCases)
+		tb := tableOf(l.kind, l.rows)
+		ex := tb.expect(true, 2)
+		sliceT := reflect.SliceOf(l.kind.t)
+		pre := reflect.MakeSlice(sliceT, len(l.pre), len(l.pre)+2)
+		for i, v := range l.pre {
+			pre.Index(i).Set(v)
+		}
+		out := reflect.New(sliceT)
+		out.Elem().Set(pre)
+		err := gocsv.UnmarshalString(tb.text, out.Interface())
+		c.check(ht, fmt.Sprintf("UnmarshalString into a slice of %d", len(l.pre)), tb, ex, out.Elem(), err, shapesOf("gocsv/11"))
+	})
