+// --------------------------------------------------------------------------- csv[] columns
+
+type SArr struct {
+	Id int     `csv:"id"`
+	V  []int16 `csv:"v" csv[]:"5"`
+	W  []Bar   `csv:"w" csv[]:"3"`
+	X  [4]int8 `csv:"x" csv[]:"4"`
+}
+
+var (
+	sarrT      = reflect.TypeOf(SArr{})
+	sarrHeader = strings.Split("id,v[0],v[1],v[2],v[3],v[4],w[0].a,w[0].b,w[1].a,w[1].b,w[2].a,w[2].b,x[0],x[1],x[2],x[3]", ",")
+	sarrs      = hegel.Composite(func(tc hegel.TestCase) SArr {
+		return SArr{
+			Id: hegel.Draw(tc, ints), V: hegel.Draw(tc, csvSlice(i16s, 5)), W: hegel.Draw(tc, csvSlice(bars, 3)),
+			X: [4]int8(hegel.Draw(tc, many(i8s, 4, 4))),
+		}
+	})
+)
+
+// columnOrder: a sort key per column and whether the column is left out; the kept columns come
+// in key order, equal keys keeping the declared order, so all-zero keys and nothing dropped is
+// the plain layout (the shrink target). A slice column reached before the lower indices of its
+// field, or with those missing, is gocsv/1's shape.
+type columnOrder struct {
+	keys    []int
+	dropped []bool
+}
+
+// kept is the indices of the kept columns in their order (the first column when all are dropped).
+func (o columnOrder) kept() []int {
+	var idx []int
+	for j := range o.keys {
+		if !o.dropped[j] {
+			idx = append(idx, j)
+		}
+	}
+	sort.SliceStable(idx, func(a, b int) bool { return o.keys[idx[a]] < o.keys[idx[b]] })
+	if len(idx) == 0 {
+		return []int{0}
+	}
+	return idx
+}
+
+func columnOrdersOf(n int) hegel.Generator[columnOrder] {
+	return hegel.Composite(func(tc hegel.TestCase) columnOrder {
+		return columnOrder{keys: hegel.Draw(tc, many(hegel.Integers(0, n-1), n, n)), dropped: hegel.Draw(tc, many(chance(25), n, n))}
+	})
+}
+
+// sliceCase: one or two rows and the order and subset of the columns they are read through.
+type sliceCase struct {
+	rows  []SArr
+	order columnOrder
+}
+
+func (sc sliceCase) GoString() string {
+	var hdr []string
+	for _, j := range sc.order.kept() {
+		hdr = append(hdr, sarrHeader[j])
+	}
+	return fmt.Sprintf("rows %+v columns %q", sc.rows, hdr)
+}
+
+// safe is the order with the csv[] columns of every slice field in index order and the lower
+// indices of a kept column kept too: the region beside gocsv/1.
+func (o columnOrder) safe(t reflect.Type, cols []col) columnOrder {
+	s := columnOrder{keys: slices.Clone(o.keys), dropped: slices.Clone(o.dropped)}
+	byField := map[int][]int{}
+	for j, c := range cols {
+		if len(c.steps) >= 2 && c.steps[1].index && t.Field(c.steps[0].i).Type.Kind() == reflect.Slice {
+			byField[c.steps[0].i] = append(byField[c.steps[0].i], j)
+		}
+	}
+	for _, js := range byField {
+		top := -1
+		for k, j := range js {
+			if !s.dropped[j] {
+				top = k
+			}
+		}
+		var keys []int
+		for _, j := range js[:top+1] {
+			s.dropped[j] = false
+			keys = append(keys, s.keys[j])
+		}
+		sort.Ints(keys)
+		for k, j := range js[:top+1] {
+			s.keys[j] = keys[k]
+		}
+	}
+	return s
+}
+
+var (
+	sarrOrders = columnOrdersOf(len(sarrHeader))
+	sliceCases = hegel.Composite(func(tc hegel.TestCase) sliceCase {
+		return sliceCase{
+			rows:  hegel.Draw(tc, many(sarrs, 1, 2)),
+			order: hegel.Draw(tc, shaped(sarrOrders, hegel.Map(sarrOrders, func(o columnOrder) columnOrder { return o.safe(sarrT, layout(sarrT)) }))),
+		}
+	})
+)
+
+// growthPanics simulates gocsv's slice growth over the columns in their order and says whether a
+// SetLen beyond the new capacity would panic.
+func growthPanics(t reflect.Type, cols []col, order []int) bool {
+	type st struct{ length, capacity int }
+	states := map[int]*st{}
+	for _, j := range order {
+		c := cols[j]
+		if len(c.steps) < 2 || !c.steps[1].index {
+			continue
+		}
+		field := c.steps[0].i
+		if t.Field(field).Type.Kind() != reflect.Slice {
+			continue
+		}
+		s := states[field]
+		if s == nil {
+			s = &st{}
+			states[field] = s
+		}
+		i := c.steps[1].i
+		if i >= s.capacity {
+			newcap := s.capacity + s.capacity/2
+			if newcap < 4 {
+				newcap = 4
+			}
+			s.capacity = newcap
+			if i >= s.capacity {
+				return true
+			}
+		}
+		if i >= s.length {
+			s.length = i + 1
+		}
+	}
+	return false
+}
+
+// columnsText is the rows' cells under the kept columns, with their header, and the rows the
+// model reads from it.
+func columnsText(t reflect.Type, cols []col, header []string, cells [][]string, kept []int) (hdr []string, text string, want []reflect.Value, err error) {
+	hdr = make([]string, len(kept))
+	body := make([][]string, len(cells))
+	for i := range body {
+		body[i] = make([]string, len(kept))
+	}
+	for p, j := range kept {
+		hdr[p] = header[j]
+		for i := range body {
+			body[i][p] = cells[i][j]
+		}
+	}
+	text = writeCSV(append([][]string{hdr}, body...))
+	want = make([]reflect.Value, len(cells))
+	for i := range want {
+		want[i] = reflect.New(t).Elem()
+		for p, j := range kept {
+			if err = decodeInto(want[i], cols[j], transported(body[i][p]), true); err != nil {
+				return
+			}
+		}
+	}
+	return
+}
+
+// TestHegelSliceColumnsFollowTheTags: csv[] columns of slices, slices of structs and arrays
+// read back in any column order and with columns missing: the slice grows to the highest index
+// present, gaps are zero values, absent fields stay nil (a slice column read before its field's
+// lower indices panics in SetLen: gocsv/1).
+func TestHegelSliceColumnsFollowTheTags(t *testing.T) {
+	c := newCollector(t)
+	cols := layout(sarrT)
+	if len(cols) != len(sarrHeader) {
+		t.Fatalf("layout has %d columns, the header %d", len(cols), len(sarrHeader))
+	}
+	property(t, func(ht *hegel.T) {
+		sc := hegel.Draw(ht, sliceCases)
+		rows := len(sc.rows)
+		cells := make([][]string, rows)
+		for i, r := range sc.rows {
+			cells[i] = cellsOf(reflect.ValueOf(r), cols)
+		}
+		// Marshal is the model's cells.
+		gotText, err := gocsv.MarshalString(sc.rows)
+		wantText := writeCSV(append([][]string{sarrHeader}, cells...))
+		if err != nil || gotText != wantText {
+			c.fail(ht, "MarshalString: %v\n got  %q\n want %q", err, gotText, wantText)
+			return
+		}
+		// A random order and subset of the columns.
+		kept := sc.order.kept()
+		hdr, text, want, err := columnsText(sarrT, cols, sarrHeader, cells, kept)
+		if err != nil {
+			c.fail(ht, "model: %v", err)
+			return
+		}
+		var shapes []string
+		var got []SArr
+		if growthPanics(sarrT, cols, kept) {
+			if Known.sliceGrowthPanics {
+				c.count("growth-gated")
+				if r := catch(func() { _ = gocsv.UnmarshalString(text, &got) }); r == nil {
+					c.fail(ht, "columns %q: the model predicts gocsv's SetLen panic but none came", hdr)
+				}
+				return
+			}
+			shapes = []string{"gocsv/1"}
+		}
+		c.count(fmt.Sprintf("kept=%d", len(kept)))
+		if !c.call(ht, "UnmarshalString with columns "+fmt.Sprintf("%q", hdr), shapes, func() { err = gocsv.UnmarshalString(text, &got) }) {
+			return
+		}
+		if err != nil {
+			c.mismatch(ht, shapes, "columns %q: %v\n text %q", hdr, err, text)
+			return
+		}
+		if len(got) != rows {
+			c.mismatch(ht, shapes, "columns %q: %d rows, want %d", hdr, len(got), rows)
+			return
+		}
+		for i := range got {
+			if !same(reflect.ValueOf(got[i]), want[i]) {
+				c.mismatch(ht, shapes, "columns %q row %d:\n got  %s\n want %s\n text %q", hdr, i, show(reflect.ValueOf(got[i])), show(want[i]), text)
+				return
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- the map helpers
+
+var mapNames = []string{"a", "b", "c", "a", "", "x y", "1"}
+
+// mapRow: the cells of a row (seven drawn, as many used as the header has) and how many more or
+// fewer cells than the header the row has: a ragged row, which only the permissive reader
+// accepts (gocsv/12 for a short one). The permissive reader and the deltas are not drawn under
+// HEGEL_NO_KNOWN=1.
+type mapRow struct {
+	cells []string
+	delta int
+}
+
+// cellsFor is the row's cells for a header of k columns: k+delta of them, one at least and
+// two beyond the header at most.
+func (r mapRow) cellsFor(k int) []string {
+	n := k + r.delta
+	if n < 1 {
+		n = 1
+	}
+	if n > k+2 {
+		n = k + 2
+	}
+	return r.cells[:n]
+}
+
+type mapsCase struct {
+	hdr        []string
+	rows       []mapRow
+	permissive bool
+}
+
+// body is the rows as written; read is the rows as encoding/csv reads them back: a row of one
+// empty cell is an empty line, which the reader skips.
+func (m mapsCase) body() [][]string {
+	out := make([][]string, len(m.rows))
+	for i, r := range m.rows {
+		out[i] = r.cellsFor(len(m.hdr))
+	}
+	return out
+}
+
+func (m mapsCase) read() [][]string {
+	var out [][]string
+	for _, r := range m.body() {
+		if len(r) == 1 && r[0] == "" {
+			continue
+		}
+		out = append(out, r)
+	}
+	return out
+}
+
+// ragged says whether a row read is shorter than the header, and whether one is longer.
+func (m mapsCase) ragged() (short, long bool) {
+	for _, r := range m.read() {
+		short = short || len(r) < len(m.hdr)
+		long = long || len(r) > len(m.hdr)
+	}
+	return
+}
+
+func (m mapsCase) GoString() string {
+	return fmt.Sprintf("permissive=%v header %q rows %q", m.permissive, m.hdr, m.body())
+}
+
+var (
+	mapCells = weighted(choice[string]{2, hdrValues}, choice[string]{3, numCells})
+	deltas   = shaped(weighted(choice[int]{8, hegel.Just(0)}, choice[int]{1, hegel.Integers(-3, -1)}, choice[int]{1, hegel.Integers(1, 2)}), hegel.Just(0))
+	mapRows  = hegel.Composite(func(tc hegel.TestCase) mapRow {
+		return mapRow{cells: hegel.Draw(tc, many(mapCells, 7, 7)), delta: hegel.Draw(tc, deltas)}
+	})
+	permissiveReaders = shaped(chance(25), hegel.Just(false))
+	mapsCases         = hegel.Composite(func(tc hegel.TestCase) mapsCase {
+		return mapsCase{hdr: hegel.Draw(tc, many(hegel.SampledFrom(mapNames), 2, 5)), rows: hegel.Draw(tc, many(mapRows, 0, 4)), permissive: hegel.Draw(tc, permissiveReaders)}
+	})
+)
+
+// permissiveReader is the documented reader for files with a variable number of fields.
+func permissiveReader(in io.Reader) gocsv.CSVReader {
+	r := csv.NewReader(in)
+	r.FieldsPerRecord = -1
+	return r
+}
+
+// TestHegelMapsFollowTheModel: CSVToMaps and CSVToChanMaps give one header-keyed map per row
+// (later duplicate headers win; under the permissive reader a row maps the columns it has:
+// gocsv/12 panics on a short one, and CSVToChanMaps reads with a fixed reader that rejects
+// ragged rows); CSVToMap and UnmarshalCSVToMap accept exactly two columns and map the first to
+// the second (later keys win), UnmarshalCSVToMap converting the values.
+func TestHegelMapsFollowTheModel(t *testing.T) {
+	resetGlobals(t)
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, mapsCases)
+		if m.permissive {
+			gocsv.SetCSVReader(permissiveReader)
+		} else {
+			gocsv.SetCSVReader(gocsv.DefaultCSVReader)
+		}
+		k := len(m.hdr)
+		hdr, rows := m.hdr, m.read()
+		text := writeCSV(append([][]string{hdr}, m.body()...))
+		short, long := m.ragged()
+		ragged := short || long
+		c.count(fmt.Sprintf("cols=%d", k))
+		if ragged {
+			c.count("ragged")
+		}
+		var shapes []string
+		if m.permissive && short {
+			shapes = []string{"gocsv/12"}
+		}
+
+		// CSVToMaps: a row's map holds the columns it has (every one, or under the permissive
+		// reader the present ones, the cells beyond the header dropped).
+		wantMaps := []map[string]string{}
+		for _, row := range rows {
+			mm := map[string]string{}
+			for j, h := range hdr {
+				if j < len(row) {
+					mm[h] = transported(row[j])
+				}
+			}
+			wantMaps = append(wantMaps, mm)
+		}
+		var got []map[string]string
+		var err error
+		if !c.call(ht, "CSVToMaps", shapes, func() { got, err = gocsv.CSVToMaps(strings.NewReader(text)) }) {
+			return
+		}
+		if ragged && !m.permissive {
+			if err == nil {
+				c.fail(ht, "CSVToMaps(%q): no error on a ragged row under the default reader", text)
+				return
+			}
+		} else if err != nil || !reflect.DeepEqual(got, wantMaps) {
+			c.mismatch(ht, shapes, "CSVToMaps(%q): %v\n got  %v\n want %v", text, err, got, wantMaps)
+			return
+		}
+		// CSVToChanMaps reads with a fixed csv.NewReader whatever the configured reader is.
+		ch := make(chan map[string]string, 16)
+		err = gocsv.CSVToChanMaps(strings.NewReader(text), ch)
+		close(ch)
+		var fromChan []map[string]string
+		for mm := range ch {
+			fromChan = append(fromChan, mm)
+		}
+		if ragged {
+			if err == nil {
+				c.fail(ht, "CSVToChanMaps(%q): no error on a ragged row", text)
+				return
+			}
+		} else {
+			if err != nil {
+				c.fail(ht, "CSVToChanMaps(%q): %v", text, err)
+				return
+			}
+			if len(fromChan) != len(wantMaps) || (len(wantMaps) > 0 && !reflect.DeepEqual(fromChan, wantMaps)) {
+				c.fail(ht, "CSVToChanMaps(%q):\n got  %v\n want %v", text, fromChan, wantMaps)
+				return
+			}
+		}
+
+		// CSVToMap (the configured reader) and UnmarshalCSVToMap (a plain csv.Reader here).
+		var m2 map[string]string
+		if !c.call(ht, "CSVToMap", shapes, func() { m2, err = gocsv.CSVToMap(strings.NewReader(text)) }) {
+			return
+		}
+		var mm map[string]string
+		err2 := gocsv.UnmarshalCSVToMap(csv.NewReader(strings.NewReader(text)), &mm)
+		if k != 2 {
+			if err == nil || err2 == nil {
+				c.fail(ht, "CSVToMap of %d columns: %v / %v, want errors", k, err, err2)
+			}
+			return
+		}
+		if ragged {
+			if m.permissive {
+				c.count("ragged-two-columns")
+			} else if err == nil {
+				c.fail(ht, "CSVToMap(%q): no error on a ragged row under the default reader", text)
+				return
+			}
+			if err2 == nil {
+				c.fail(ht, "UnmarshalCSVToMap(%q): no error on a ragged row", text)
+			}
+			if !m.permissive {
+				return
+			}
+		}
+		wantMap := map[string]string{}
+		wantInts := map[string]int{}
+		var wantIntErr error
+		for _, row := range rows {
+			if len(row) < 2 {
+				continue
+			}
+			wantMap[transported(row[0])] = transported(row[1])
+			if wantIntErr == nil {
+				i, e := modelInt(transported(row[1]), 64)
+				if e != nil {
+					wantIntErr = e
+				} else {
+					wantInts[transported(row[0])] = int(i)
+				}
+			}
+		}
+		if err != nil || !reflect.DeepEqual(m2, wantMap) {
+			c.mismatch(ht, shapes, "CSVToMap(%q): %v\n got  %v\n want %v", text, err, m2, wantMap)
+			return
+		}
+		if ragged {
+			return
+		}
+		if err2 != nil || !reflect.DeepEqual(mm, wantMap) {
+			c.fail(ht, "UnmarshalCSVToMap(%q): %v\n got  %v\n want %v", text, err2, mm, wantMap)
+			return
+		}
+		var mi map[string]int
+		err3 := gocsv.UnmarshalCSVToMap(csv.NewReader(strings.NewReader(text)), &mi)
+		if wantIntErr != nil {
+			if err3 == nil {
+				// An int cell the model rejects: the recorded wrap and float-path bugs apply to
+				// int64 only as range errors, which gocsv shares; anything else is a mismatch.
+				c.fail(ht, "UnmarshalCSVToMap(%q) into map[string]int: no error, model %v", text, wantIntErr)
+			}
+			c.count("int-error")
+			return
+		}
+		if err3 != nil || !reflect.DeepEqual(mi, wantInts) {
+			c.fail(ht, "UnmarshalCSVToMap(%q) into map[string]int: %v\n got  %v\n want %v", text, err3, mi, wantInts)
+		}
+	})
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..06ffb7e
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,301 @@
+package gocsv_test
+
+// Pins: one plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and
+// fails while the bug exists; the target lists them as expected failures.
+
+import (
+	"encoding/csv"
+	"errors"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gocarina/gocsv"
+)
+
+func noPanic(t *testing.T, what string, f func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("%s panics: %v", what, r)
+		}
+	}()
+	f()
+}
+
+type pinSlice struct {
+	Id int   `csv:"id"`
+	V  []int `csv:"v" csv[]:"6"`
+}
+
+// gocsv/1: csv[] columns read in any order or with columns missing.
+func TestHegelPinSliceColumnsInAnyOrder(t *testing.T) {
+	var out []pinSlice
+	noPanic(t, "UnmarshalString with columns id,v[5],v[0]", func() {
+		if err := gocsv.UnmarshalString("id,v[5],v[0]\n1,5,0\n", &out); err != nil {
+			t.Fatalf("UnmarshalString: %v", err)
+		}
+	})
+	if len(out) != 1 || len(out[0].V) != 6 || out[0].V[5] != 5 {
+		t.Fatalf("got %+v, want V of length 6 with V[5] = 5", out)
+	}
+}
+
+type pinAny struct {
+	Id  int         `csv:"id"`
+	Any interface{} `csv:"any"`
+}
+
+// gocsv/2: a struct with an interface{} field: Marshal accepts it, Unmarshal must not panic.
+func TestHegelPinInterfaceFieldDoesNotPanic(t *testing.T) {
+	text, err := gocsv.MarshalString(&[]pinAny{{1, "x"}})
+	if err != nil {
+		t.Fatalf("MarshalString: %v", err)
+	}
+	var out []pinAny
+	noPanic(t, "UnmarshalString into a struct with an interface{} field", func() {
+		_ = gocsv.UnmarshalString(text, &out)
+	})
+}
+
+type pinTwo struct {
+	A string `csv:"a"`
+	B string `csv:"b"`
+}
+
+// gocsv/3: UnmarshalToChanWithoutHeaders on a row with more columns than fields, which
+// UnmarshalWithoutHeaders ignores.
+func TestHegelPinHeaderlessChanIgnoresExtraColumns(t *testing.T) {
+	var viaSlice []pinTwo
+	if err := gocsv.UnmarshalWithoutHeaders(strings.NewReader("1,2,3\n"), &viaSlice); err != nil {
+		t.Fatalf("UnmarshalWithoutHeaders: %v", err)
+	}
+	ch := make(chan pinTwo, 4)
+	noPanic(t, "UnmarshalToChanWithoutHeaders on a row of 3 columns for 2 fields", func() {
+		if err := gocsv.UnmarshalToChanWithoutHeaders(strings.NewReader("1,2,3\n"), ch); err != nil {
+			t.Fatalf("UnmarshalToChanWithoutHeaders: %v", err)
+		}
+	})
+	got := <-ch
+	if got != viaSlice[0] {
+		t.Fatalf("channel row %+v, slice row %+v", got, viaSlice[0])
+	}
+}
+
+type pinNum struct {
+	I8 int8  `csv:"i8"`
+	U8 uint8 `csv:"u8"`
+}
+
+// gocsv/4: an integer cell that does not fit the field is an error, not a wrapped value.
+func TestHegelPinIntegerOverflowIsAnError(t *testing.T) {
+	var out []pinNum
+	if err := gocsv.UnmarshalString("i8,u8\n300,0\n", &out); err == nil {
+		t.Fatalf("300 into an int8 field: no error, got %+v", out)
+	}
+	out = nil
+	if err := gocsv.UnmarshalString("i8,u8\n0,300\n", &out); err == nil {
+		t.Fatalf("300 into a uint8 field: no error, got %+v", out)
+	}
+}
+
+type pinIU struct {
+	I int  `csv:"i"`
+	U uint `csv:"u"`
+}
+
+// gocsv/5: uint cells follow the integer rules: a negative is an error, an exponent reads as it
+// does for an int field.
+func TestHegelPinUintCellsParseLikeIntCells(t *testing.T) {
+	var out []pinIU
+	if err := gocsv.UnmarshalString("i,u\n0,-1.5\n", &out); err == nil {
+		t.Fatalf("-1.5 into a uint field: no error, got %+v", out)
+	}
+	out = nil
+	if err := gocsv.UnmarshalString("i,u\n1.5e2,1.5e2\n", &out); err != nil {
+		t.Fatalf("1.5e2: %v", err)
+	}
+	if uint(out[0].I) != out[0].U {
+		t.Fatalf("1.5e2 reads as %d for int and %d for uint", out[0].I, out[0].U)
+	}
+}
+
+type pinF32 struct {
+	F float32 `csv:"f"`
+}
+
+// gocsv/6: a float32 cell out of the type's range is an error (strconv.ParseFloat at 32 bits).
+func TestHegelPinFloat32OutOfRangeIsAnError(t *testing.T) {
+	var out []pinF32
+	if err := gocsv.UnmarshalString("f\n1e40\n", &out); err == nil {
+		t.Fatalf("1e40 into a float32 field: no error, got %v", out[0].F)
+	}
+}
+
+type pinBar struct {
+	A int `csv:"a"`
+	B int `csv:"b"`
+}
+
+type pinMulti struct {
+	Bar pinBar `csv:"p,q"`
+	X   int    `csv:"x"`
+}
+
+// gocsv/7: a nested struct field with two keys is reachable through either prefix.
+func TestHegelPinMultiKeyNestedHeaders(t *testing.T) {
+	var out []pinMulti
+	if err := gocsv.UnmarshalString("q.a,q.b,x\n1,2,3\n", &out); err != nil {
+		t.Fatalf("UnmarshalString: %v", err)
+	}
+	if out[0].Bar != (pinBar{1, 2}) {
+		t.Fatalf("headers q.a,q.b: got %+v, want Bar{1 2}", out[0])
+	}
+}
+
+type pinArr struct {
+	Id int    `csv:"id"`
+	A  [2]int `csv:"a"`
+}
+
+// gocsv/8: an array field without a csv[] tag reads back what Marshal wrote.
+func TestHegelPinArrayFieldRoundTrips(t *testing.T) {
+	in := []pinArr{{1, [2]int{3, 4}}}
+	text, err := gocsv.MarshalString(&in)
+	if err != nil {
+		t.Fatalf("MarshalString: %v", err)
+	}
+	var out []pinArr
+	if err := gocsv.UnmarshalString(text, &out); err != nil {
+		t.Fatalf("UnmarshalString of %q: %v", text, err)
+	}
+	if !reflect.DeepEqual(in, out) {
+		t.Fatalf("got %+v, want %+v", out, in)
+	}
+}
+
+type pinMap struct {
+	Id int            `csv:"id"`
+	M  map[string]int `csv:"m"`
+}
+
+// gocsv/9: a map field is either refused by Marshal or read back by Unmarshal.
+func TestHegelPinMapFieldRoundTrips(t *testing.T) {
+	in := []pinMap{{1, map[string]int{"k": 3}}}
+	text, err := gocsv.MarshalString(&in)
+	if err != nil {
+		return
+	}
+	var out []pinMap
+	if err := gocsv.UnmarshalString(text, &out); err != nil {
+		t.Fatalf("Marshal wrote %q without error, Unmarshal: %v", text, err)
+	}
+	if !reflect.DeepEqual(in, out) {
+		t.Fatalf("got %+v, want %+v", out, in)
+	}
+}
+
+// gocsv/10: a header that is matched after trimming (or through a BOM) counts as matched for
+// FailIfUnmatchedStructTags and the Unmarshaller's mismatch lists.
+func TestHegelPinTrimmedHeaderCountsAsMatched(t *testing.T) {
+	gocsv.FailIfUnmatchedStructTags = true
+	defer func() { gocsv.FailIfUnmatchedStructTags = false }()
+	var out []pinTwo
+	if err := gocsv.UnmarshalString("\uFEFFa,b\n1,2\n", &out); err != nil {
+		t.Fatalf("a BOM before the first header: %v (the row decodes without the flag)", err)
+	}
+	um, err := gocsv.NewUnmarshaller(csv.NewReader(strings.NewReader(" a,b\n1,2\n")), pinTwo{})
+	if err != nil {
+		t.Fatalf("NewUnmarshaller: %v", err)
+	}
+	if len(um.MismatchedHeaders) != 0 || len(um.MismatchedStructFields) != 0 {
+		t.Fatalf("header \" a\" is mapped to field a but reported: headers %q, fields %q", um.MismatchedHeaders, um.MismatchedStructFields)
+	}
+}
+
+// gocsv/11: Unmarshal into a slice replaces its contents.
+func TestHegelPinUnmarshalReplacesTheSlice(t *testing.T) {
+	out := []pinTwo{{"x", "x"}, {"y", "y"}, {"z", "z"}}
+	if err := gocsv.UnmarshalString("a,b\n1,2\n", &out); err != nil {
+		t.Fatalf("UnmarshalString: %v", err)
+	}
+	if len(out) != 1 {
+		t.Fatalf("one CSV row into a slice of three: %+v", out)
+	}
+}
+
+// gocsv/12: CSVToMaps with a reader that allows ragged rows does not panic on a short row.
+func TestHegelPinRaggedRowsDoNotPanic(t *testing.T) {
+	gocsv.SetCSVReader(func(in io.Reader) gocsv.CSVReader {
+		r := csv.NewReader(in)
+		r.FieldsPerRecord = -1
+		return r
+	})
+	defer gocsv.SetCSVReader(gocsv.DefaultCSVReader)
+	noPanic(t, "CSVToMaps on a row shorter than the header", func() {
+		_, _ = gocsv.CSVToMaps(strings.NewReader("a,b\n1\n"))
+	})
+}
+
+type pinDur struct {
+	Id int           `csv:"id"`
+	D  time.Duration `csv:"d"`
+}
+
+// gocsv/13: what Marshal writes for a time.Duration field reads back.
+func TestHegelPinStringerOutputReadsBack(t *testing.T) {
+	in := []pinDur{{1, 1500 * time.Millisecond}, {2, 2 * time.Second}}
+	text, err := gocsv.MarshalString(&in)
+	if err != nil {
+		t.Fatalf("MarshalString: %v", err)
+	}
+	var out []pinDur
+	if err := gocsv.UnmarshalString(text, &out); err != nil {
+		t.Fatalf("UnmarshalString of %q: %v", text, err)
+	}
+	if !reflect.DeepEqual(in, out) {
+		t.Fatalf("got %+v, want %+v", out, in)
+	}
+}
+
+type pinDefault struct {
+	D string `csv:"d,default=7"`
+	X string `csv:"x"`
+}
+
+// gocsv/14: default= applies without headers as it does with them.
+func TestHegelPinHeaderlessAppliesDefault(t *testing.T) {
+	var withHeaders, without []pinDefault
+	if err := gocsv.UnmarshalString("d,x\n,x\n", &withHeaders); err != nil {
+		t.Fatalf("UnmarshalString: %v", err)
+	}
+	if err := gocsv.UnmarshalWithoutHeaders(strings.NewReader(",x\n"), &without); err != nil {
+		t.Fatalf("UnmarshalWithoutHeaders: %v", err)
+	}
+	if withHeaders[0].D != "7" {
+		t.Fatalf("with headers: D = %q, want the default 7", withHeaders[0].D)
+	}
+	if without[0].D != "7" {
+		t.Fatalf("without headers: D = %q, want the default 7", without[0].D)
+	}
+}
+
+type pinInts struct {
+	A int `csv:"a"`
+	B int `csv:"b"`
+}
+
+// gocsv/15: the headerless channel path reports a conversion error on the line it is on.
+func TestHegelPinHeaderlessChanErrorLine(t *testing.T) {
+	ch := make(chan pinInts, 4)
+	err := gocsv.UnmarshalToChanWithoutHeaders(strings.NewReader("1,x\n"), ch)
+	var pe *csv.ParseError
+	if !errors.As(err, &pe) {
+		t.Fatalf("got %v, want a ParseError", err)
+	}
+	if pe.Line != 1 {
+		t.Fatalf("error reported on line %d, want line 1 (there is no header)", pe.Line)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..e13365f
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,846 @@
+package gocsv_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with random
+// contents, judged by the model of hegel_test.go as the wide properties judge, so that each bug
+// has a property that finds it every run (the wide properties reach the shapes at their natural
+// rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch
+// instead (columns in their declared order, a string instead of an interface{} field, no extra
+// column, cells inside the field's range, uint cells without a dot, float32 cells inside the
+// range, the first key of a multi-key field, a JSON slice instead of an array or a map, exact
+// headers, a shorter pre-filled slice, full rows, a named integer without a String method, no
+// empty defaulted cell, no bad cell) and passes.
+
+import (
+	"encoding/csv"
+	"fmt"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/gocarina/gocsv"
+)
+
+// shapesOf names the bug a narrow property is about, or nothing under HEGEL_NO_KNOWN=1, when the
+// property draws the neighbouring region and a disagreement is a plain failure.
+func shapesOf(id string) []string {
+	if noKnown {
+		return nil
+	}
+	return []string{id}
+}
+
+// The regions beside the bugs' struct types: a string field beside the interface{} one, JSON
+// slices beside the array and the map, a named integer without a String method beside the
+// Duration; and the types of the regions themselves: a struct with wide csv[] slices (gocsv/1),
+// one with defaulted fields (gocsv/14).
+type Str struct {
+	Id  int    `csv:"id"`
+	Any string `csv:"any"`
+}
+
+type Jsons struct {
+	Id int   `csv:"id"`
+	A  []int `csv:"a"`
+	K  []Bar `csv:"k"`
+}
+
+type Named struct {
+	Id int   `csv:"id"`
+	N  MyInt `csv:"n"`
+}
+
+type Wide struct {
+	Id int   `csv:"id"`
+	V  []int `csv:"v" csv[]:"8"`
+	W  []Bar `csv:"w" csv[]:"6"`
+}
+
+type Dflt struct {
+	D string `csv:"d,default=7"`
+	N int    `csv:"n,default=42"`
+	P *bool  `csv:"p,default=yes"`
+	X string `csv:"x"`
+}
+
+var (
+	barT       = reflect.TypeOf(Bar{})
+	strT       = reflect.TypeOf(Str{})
+	jsonsT     = reflect.TypeOf(Jsons{})
+	namedT     = reflect.TypeOf(Named{})
+	wideT      = reflect.TypeOf(Wide{})
+	dfltT      = reflect.TypeOf(Dflt{})
+	wideHeader = strings.Split("id,v[0],v[1],v[2],v[3],v[4],v[5],v[6],v[7],w[0].a,w[0].b,w[1].a,w[1].b,w[2].a,w[2].b,w[3].a,w[3].b,w[4].a,w[4].b,w[5].a,w[5].b", ",")
+
+	strs = hegel.Composite(func(tc hegel.TestCase) Str {
+		return Str{Id: hegel.Draw(tc, ints), Any: hegel.Draw(tc, texts)}
+	})
+	jsonss = hegel.Composite(func(tc hegel.TestCase) Jsons {
+		return Jsons{Id: hegel.Draw(tc, ints), A: hegel.Draw(tc, jsonSlice(ints)), K: hegel.Draw(tc, jsonSlice(bars))}
+	})
+	nameds = hegel.Composite(func(tc hegel.TestCase) Named {
+		return Named{Id: hegel.Draw(tc, ints), N: hegel.Draw(tc, myInts)}
+	})
+	wides = hegel.Composite(func(tc hegel.TestCase) Wide {
+		return Wide{Id: hegel.Draw(tc, ints), V: hegel.Draw(tc, csvSlice(ints, 8)), W: hegel.Draw(tc, csvSlice(bars, 6))}
+	})
+	dflts = hegel.Composite(func(tc hegel.TestCase) Dflt {
+		return Dflt{D: hegel.Draw(tc, texts), N: hegel.Draw(tc, ints), P: hegel.Draw(tc, ptrTo(30, bools)), X: hegel.Draw(tc, texts)}
+	})
+)
+
+func init() {
+	headers[barT] = "a,b"
+	headers[strT] = "id,any"
+	headers[jsonsT] = "id,a,k"
+	headers[namedT] = "id,n"
+	headers[wideT] = strings.Join(wideHeader, ",")
+	headers[dfltT] = "d,n,p,x"
+	valueOf[barT] = values(bars)
+	valueOf[strT] = values(strs)
+	valueOf[jsonsT] = values(jsonss)
+	valueOf[namedT] = values(nameds)
+	valueOf[wideT] = values(wides)
+	valueOf[dfltT] = values(dflts)
+}
+
+// rowList is a list of rows that the draw report shows as values.
+type rowList []reflect.Value
+
+func (r rowList) GoString() string { return showRows(r) }
+
+// someRows is one to three rows of t (valueOf is looked up at draw time: the types of this file
+// are registered in init, after the package's variables).
+func someRows(t reflect.Type) hegel.Generator[rowList] {
+	return hegel.Composite(func(tc hegel.TestCase) rowList {
+		return hegel.Draw(tc, many(valueOf[t], 1, 3))
+	})
+}
+
+func showRows(rows []reflect.Value) string {
+	var out []string
+	for _, r := range rows {
+		out = append(out, show(r))
+	}
+	return "[" + strings.Join(out, ", ") + "]"
+}
+
+// readsBack checks that UnmarshalString reads the modelled text of the rows back to the model's
+// rows (one entry point; the wide property runs them all).
+func readsBack(ht *hegel.T, c *collector, kind rowKind, rows []reflect.Value, bug string) {
+	tb := tableOf(kind, rows)
+	ex := tb.expect(true, 2)
+	out := reflect.New(reflect.SliceOf(kind.t))
+	var err error
+	what := "UnmarshalString of " + fmt.Sprintf("%#v", kind)
+	if c.call(ht, what, shapesOf(bug), func() { err = gocsv.UnmarshalString(tb.text, out.Interface()) }) {
+		c.check(ht, what, tb, ex, out.Elem(), err, shapesOf(bug))
+	}
+}
+
+// headerlessPaths runs the three headerless entry points on the table's headerless text against
+// ex, naming the shapes of the slice paths and of the channel path.
+func headerlessPaths(ht *hegel.T, c *collector, tb *table, ex expected, sliceShapes, chanShapes []string) {
+	sliceT := reflect.SliceOf(tb.kind.t)
+	out := reflect.New(sliceT)
+	var err error
+	if c.call(ht, "UnmarshalWithoutHeaders", sliceShapes, func() { err = gocsv.UnmarshalWithoutHeaders(strings.NewReader(tb.headless), out.Interface()) }) {
+		c.check(ht, "UnmarshalWithoutHeaders", tb, ex, out.Elem(), err, sliceShapes)
+	}
+	out = reflect.New(reflect.SliceOf(reflect.PtrTo(tb.kind.t)))
+	if c.call(ht, "UnmarshalCSVWithoutHeaders", sliceShapes, func() {
+		err = gocsv.UnmarshalCSVWithoutHeaders(csv.NewReader(strings.NewReader(tb.headless)), out.Interface())
+	}) {
+		c.check(ht, "UnmarshalCSVWithoutHeaders", tb, ex, out.Elem(), err, sliceShapes)
+	}
+	ch := reflect.MakeChan(reflect.ChanOf(reflect.BothDir, tb.kind.t), 64)
+	if c.call(ht, "UnmarshalToChanWithoutHeaders", chanShapes, func() {
+		err = gocsv.UnmarshalToChanWithoutHeaders(strings.NewReader(tb.headless), ch.Interface())
+	}) {
+		c.check(ht, "UnmarshalToChanWithoutHeaders", tb, ex, drain(ch, sliceT), err, chanShapes)
+	}
+}
+
+// --------------------------------------------------------------------------- gocsv/1
+
+// anyOrderCase: rows of Wide and a column order in which a slice column of index four or more
+// (lead picks one, modulo their number) comes first and is kept; under HEGEL_NO_KNOWN=1 the
+// declared order with nothing dropped.
+type anyOrderCase struct {
+	rows  []Wide
+	order columnOrder
+	lead  int
+}
+
+var (
+	wideCols = layout(wideT)
+	// highColumns: the columns of a slice element at index four or more (the first growth
+	// gives a capacity of four).
+	highColumns = func() []int {
+		var out []int
+		for j, c := range wideCols {
+			if len(c.steps) >= 2 && c.steps[1].index && c.steps[1].i >= 4 {
+				out = append(out, j)
+			}
+		}
+		return out
+	}()
+	anyOrderCases = hegel.Composite(func(tc hegel.TestCase) anyOrderCase {
+		return anyOrderCase{
+			rows:  hegel.Draw(tc, many(wides, 1, 2)),
+			order: hegel.Draw(tc, columnOrdersOf(len(wideHeader))),
+			lead:  hegel.Draw(tc, hegel.Integers(0, len(highColumns)-1)),
+		}
+	})
+)
+
+func (a anyOrderCase) kept() []int {
+	if noKnown {
+		out := make([]int, len(wideHeader))
+		for j := range out {
+			out[j] = j
+		}
+		return out
+	}
+	o := columnOrder{keys: append([]int{}, a.order.keys...), dropped: append([]bool{}, a.order.dropped...)}
+	j := highColumns[a.lead%len(highColumns)]
+	o.keys[j] = -1
+	o.dropped[j] = false
+	return o.kept()
+}
+
+func (a anyOrderCase) GoString() string {
+	var hdr []string
+	for _, j := range a.kept() {
+		hdr = append(hdr, wideHeader[j])
+	}
+	return fmt.Sprintf("rows %+v columns %q", a.rows, hdr)
+}
+
+// TestHegelSliceColumnsInAnyOrderGrow: csv[] columns read in any order grow the slice to the
+// highest index present; a column of index four or more read first panics in SetLen (gocsv/1).
+func TestHegelSliceColumnsInAnyOrderGrow(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		a := hegel.Draw(ht, anyOrderCases)
+		cells := make([][]string, len(a.rows))
+		for i, r := range a.rows {
+			cells[i] = cellsOf(reflect.ValueOf(r), wideCols)
+		}
+		kept := a.kept()
+		hdr, text, want, err := columnsText(wideT, wideCols, wideHeader, cells, kept)
+		if err != nil {
+			c.fail(ht, "model: %v", err)
+			return
+		}
+		var got []Wide
+		if !c.call(ht, fmt.Sprintf("UnmarshalString with columns %q", hdr), shapesOf("gocsv/1"), func() { err = gocsv.UnmarshalString(text, &got) }) {
+			return
+		}
+		if err != nil {
+			c.mismatch(ht, shapesOf("gocsv/1"), "columns %q: %v\n text %q", hdr, err, text)
+			return
+		}
+		if len(got) != len(want) {
+			c.mismatch(ht, shapesOf("gocsv/1"), "columns %q: %d rows, want %d", hdr, len(got), len(want))
+			return
+		}
+		for i := range got {
+			if !same(reflect.ValueOf(got[i]), want[i]) {
+				c.mismatch(ht, shapesOf("gocsv/1"), "columns %q row %d:\n got  %s\n want %s\n text %q", hdr, i, show(reflect.ValueOf(got[i])), show(want[i]), text)
+				return
+			}
+		}
+	})
+}
