+// rowKind is a struct type under test with the header the round trip reads (the hand-written
+// one, or the alternative keys for the MultiKey type) and the recorded bug it is the shape of.
+type rowKind struct {
+	t     reflect.Type
+	read  string
+	shape string
+}
+
+func (k rowKind) header() []string { return strings.Split(headers[k.t], ",") }
