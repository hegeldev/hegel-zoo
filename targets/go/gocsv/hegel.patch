+// --------------------------------------------------------------------------- column model
+
+// step is one move from a struct value to a column's leaf: a field index or a slice index.
+type step struct {
+	i     int
+	index bool
+}
+
+// col is one CSV column of a struct type.
+type col struct {
+	steps []step
+	omit  bool
+	dflt  string
+}
+
+var (
+	typeMarshaller = reflect.TypeOf((*gocsv.TypeMarshaller)(nil)).Elem()
+	textMarshaler  = reflect.TypeOf((*interface{ MarshalText() ([]byte, error) })(nil)).Elem()
+)
+
+// opaque: a struct type that is one cell (it has a marshalling method), not a set of columns.
+func opaque(t reflect.Type) bool {
+	p := reflect.PtrTo(t)
+	return t.Implements(typeMarshaller) || p.Implements(typeMarshaller) || t.Implements(textMarshaler) || p.Implements(textMarshaler)
+}
+
+func parseTag(tag string) (names []string, omit bool, dflt string) {
+	for _, part := range strings.Split(tag, ",") {
+		part = strings.TrimSpace(part)
+		switch {
+		case part == "omitempty":
+			omit = true
+		case part == "partial":
+		case strings.HasPrefix(part, "default="):
+			dflt = strings.TrimPrefix(part, "default=")
+		default:
+			names = append(names, part)
+		}
+	}
+	return
+}
+
+func layout(t reflect.Type) []col {
+	var out []col
+	layoutInto(t, nil, &out)
+	return out
+}
+
+func layoutInto(t reflect.Type, prefix []step, out *[]col) {
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.PkgPath != "" {
+			continue
+		}
+		names, omit, dflt := parseTag(f.Tag.Get("csv"))
+		if len(names) == 1 && names[0] == "-" {
+			continue
+		}
+		steps := append(append([]step{}, prefix...), step{i, false})
+		ft := f.Type
+		if ft.Kind() == reflect.Ptr {
+			ft = ft.Elem()
+		}
+		if ft.Kind() == reflect.Struct && !opaque(ft) {
+			layoutInto(ft, steps, out)
+			continue
+		}
+		if f.Type.Kind() == reflect.Slice || f.Type.Kind() == reflect.Array {
+			if tag, ok := f.Tag.Lookup("csv[]"); ok {
+				count, _ := strconv.Atoi(tag)
+				if count > 0 {
+					for idx := 0; idx < count; idx++ {
+						at := append(append([]step{}, steps...), step{idx, true})
+						if f.Type.Elem().Kind() == reflect.Struct {
+							layoutInto(f.Type.Elem(), at, out)
+						} else {
+							*out = append(*out, col{at, omit, dflt})
+						}
+					}
+					continue
+				}
+			}
+		}
+		*out = append(*out, col{steps, omit, dflt})
+	}
+}
+
+// cellOf: the documented text of one column of a struct value.
+func cellOf(root reflect.Value, c col) string {
+	v := root
+	for _, s := range c.steps {
+		if v.Kind() == reflect.Ptr {
+			if v.IsNil() {
+				return ""
+			}
+			v = v.Elem()
+		}
+		if s.index {
+			if s.i >= v.Len() {
+				return ""
+			}
+			v = v.Index(s.i)
+		} else {
+			v = v.Field(s.i)
+		}
+	}
+	return leafString(v)
+}
+
+func leafString(v reflect.Value) string {
+	if v.Kind() == reflect.Ptr {
+		if v.IsNil() {
+			return ""
+		}
+		v = v.Elem()
+	}
+	switch x := v.Interface().(type) {
+	case Hex:
+		s, _ := x.MarshalCSV()
+		return s
+	case time.Time:
+		b, _ := x.MarshalText()
+		return string(b)
+	}
+	switch v.Kind() {
+	case reflect.String:
+		return v.String()
+	case reflect.Bool:
+		return strconv.FormatBool(v.Bool())
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return strconv.FormatInt(v.Int(), 10)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return strconv.FormatUint(v.Uint(), 10)
+	case reflect.Float32:
+		return strconv.FormatFloat(v.Float(), 'f', -1, 32)
+	case reflect.Float64:
+		return strconv.FormatFloat(v.Float(), 'f', -1, 64)
+	case reflect.Slice, reflect.Array:
+		b, _ := json.Marshal(v.Interface())
+		return string(b)
+	}
+	panic("leafString: " + v.Type().String())
+}
+
+func cellsOf(root reflect.Value, cols []col) []string {
+	out := make([]string, len(cols))
+	for i, c := range cols {
+		out[i] = cellOf(root, c)
+	}
+	return out
+}
+
+// decodeInto sets one column of an addressable struct value from its cell, allocating the
+// pointers and growing the slices on the way, as documented.
+func decodeInto(root reflect.Value, c col, cell string, useDefault bool) error {
+	v := root
+	for _, s := range c.steps {
+		if v.Kind() == reflect.Ptr {
+			if v.IsNil() {
+				v.Set(reflect.New(v.Type().Elem()))
+			}
+			v = v.Elem()
+		}
+		if s.index {
+			if v.Kind() == reflect.Slice && s.i >= v.Len() {
+				grown := reflect.MakeSlice(v.Type(), s.i+1, s.i+1)
+				reflect.Copy(grown, v)
+				v.Set(grown)
+			}
+			v = v.Index(s.i)
+		} else {
+			v = v.Field(s.i)
+		}
+	}
+	if cell == "" && useDefault {
+		cell = c.dflt
+	}
+	return setLeaf(v, cell, c.omit)
+}
+
+func setLeaf(v reflect.Value, cell string, omit bool) error {
+	if v.Kind() == reflect.Ptr {
+		if omit && cell == "" {
+			return nil
+		}
+		if v.IsNil() {
+			v.Set(reflect.New(v.Type().Elem()))
+		}
+		v = v.Elem()
+	}
+	switch x := v.Addr().Interface().(type) {
+	case *Hex:
+		return x.UnmarshalCSV(cell)
+	case *time.Time:
+		return x.UnmarshalText([]byte(cell))
+	}
+	switch v.Kind() {
+	case reflect.String:
+		v.SetString(cell)
+	case reflect.Bool:
+		b, err := modelBool(cell)
+		if err != nil {
+			return err
+		}
+		v.SetBool(b)
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		i, err := modelInt(cell, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetInt(i)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		u, err := modelUint(cell, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetUint(u)
+	case reflect.Float32, reflect.Float64:
+		f, err := modelFloat(cell, v.Type().Bits())
+		if err != nil {
+			return err
+		}
+		v.SetFloat(f)
+	case reflect.Slice, reflect.Array:
+		if cell == "" {
+			return nil
+		}
+		return json.Unmarshal([]byte(cell), v.Addr().Interface())
+	default:
+		panic("setLeaf: " + v.Type().String())
+	}
+	return nil
+}
+
+// The documented (and lenient) cell conversions: whitespace trimmed, an empty cell is the zero
+// value, yes/no for bools, an integer cell may carry a fractional part that is dropped, a float
+// cell may use a decimal comma. Widths are the field's: a cell that does not fit is an error.
+func modelBool(s string) (bool, error) {
+	s = strings.TrimSpace(s)
+	if strings.EqualFold(s, "yes") {
+		return true, nil
+	}
+	if strings.EqualFold(s, "no") || s == "" {
+		return false, nil
+	}
+	return strconv.ParseBool(s)
+}
+
+func modelInt(s string, bits int) (int64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, nil
+	}
+	return strconv.ParseInt(strings.SplitN(s, ".", 2)[0], 10, bits)
+}
+
+func modelUint(s string, bits int) (uint64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, nil
+	}
+	return strconv.ParseUint(strings.SplitN(s, ".", 2)[0], 10, bits)
+}
+
+func modelFloat(s string, bits int) (float64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0, nil
+	}
+	return strconv.ParseFloat(strings.ReplaceAll(s, ",", "."), bits)
+}
+
+// decodeRow builds a struct of type t from the cells of its columns; the error is the first
+// column's, with its index.
+func decodeRow(t reflect.Type, cols []col, cells []string, useDefault bool) (reflect.Value, int, error) {
+	v := reflect.New(t).Elem()
+	for j, c := range cols {
+		if j >= len(cells) {
+			break
+		}
+		if err := decodeInto(v, c, cells[j], useDefault); err != nil {
+			return v, j, err
+		}
+	}
+	return v, -1, nil
+}
+
+// same: structural equality with NaN equal to NaN and time.Time by Equal.
+func same(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	switch a.Kind() {
+	case reflect.Ptr:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() == b.IsNil()
+		}
+		return same(a.Elem(), b.Elem())
+	case reflect.Struct:
+		if ta, ok := a.Interface().(time.Time); ok {
+			return ta.Equal(b.Interface().(time.Time))
+		}
+		for i := 0; i < a.NumField(); i++ {
+			if a.Type().Field(i).PkgPath != "" {
+				continue
+			}
+			if !same(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Slice:
+		if a.IsNil() != b.IsNil() || a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Array:
+		for i := 0; i < a.Len(); i++ {
+			if !same(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Float32, reflect.Float64:
+		x, y := a.Float(), b.Float()
+		return x == y || (math.IsNaN(x) && math.IsNaN(y))
+	}
+	return reflect.DeepEqual(a.Interface(), b.Interface())
+}
+
+func show(v reflect.Value) string { return fmt.Sprintf("%+v", v.Interface()) }
