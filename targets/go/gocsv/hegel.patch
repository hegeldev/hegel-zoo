+func (d defaultCase) GoString() string { return fmt.Sprintf("cells %q", d.cells()) }
+
+// TestHegelHeaderlessPathsApplyDefault: the headerless entry points fill an empty cell with the
+// field's default= value as the entry points with headers do (gocsv/14).
+func TestHegelHeaderlessPathsApplyDefault(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		d := hegel.Draw(ht, defaultCases)
+		tb := tableOfCells(rowKind{t: dfltT}, d.rows, d.cells())
+		headerlessPaths(ht, c, tb, tb.expect(true, 1), shapesOf("gocsv/14"), shapesOf("gocsv/14"))
+	})
+}
+
+// --------------------------------------------------------------------------- gocsv/15
+
+// badCellCase: rows of Bar with the cell of one row (badRow, badCol, modulo) replaced by one
+// that is no integer; under HEGEL_NO_KNOWN=1 the rows as they are.
+type badCellCase struct {
+	rows           []reflect.Value
+	badRow, badCol int
+	bad            string
+}
+
+var (
+	badCells     = pick("x", "1a", "--1", "1e", "0x1f", " yes")
+	badCellCases = hegel.Composite(func(tc hegel.TestCase) badCellCase {
+		return badCellCase{rows: []reflect.Value(hegel.Draw(tc, barRows)), badRow: hegel.Draw(tc, hegel.Integers(0, 9)), badCol: hegel.Draw(tc, hegel.Integers(0, 1)), bad: hegel.Draw(tc, badCells)}
+	})
+)
+
+func (b badCellCase) cells() [][]string {
+	cols := layout(barT)
+	out := make([][]string, len(b.rows))
+	for i, r := range b.rows {
+		out[i] = cellsOf(r, cols)
+	}
+	if !noKnown {
+		out[b.badRow%len(b.rows)][b.badCol] = b.bad
+	}
+	return out
+}
+
+func (b badCellCase) GoString() string { return fmt.Sprintf("cells %q", b.cells()) }
+
+// TestHegelHeaderlessChanErrorLineIsExact: the headerless channel path reports a conversion
+// error on the line the row is on, as the headerless slice path does (gocsv/15 adds one for a
+// header there is none).
+func TestHegelHeaderlessChanErrorLineIsExact(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		b := hegel.Draw(ht, badCellCases)
+		tb := tableOfCells(rowKind{t: barT}, b.rows, b.cells())
+		headerlessPaths(ht, c, tb, tb.expect(true, 1), nil, shapesOf("gocsv/15"))
+	})
+}
