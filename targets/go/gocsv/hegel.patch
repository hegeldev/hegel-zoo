+package gocsv_test
+
+// Header matching, cell conversions, csv[] columns and the map helpers against the model.
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"math"
+	"reflect"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/gocarina/gocsv"
+	"testing"
+)
+
+// --------------------------------------------------------------------------- header matching
+
+type Hdr struct {
+	A string `csv:"a"`
+	B string `csv:"b,bb"`
+	C string `csv:"c,partial"`
+	D string
+	E string `csv:"e,default=dE"`
+}
+
+var hdrHeader = "a,b,c,D,e"
+
+type hfield struct {
+	keys    []string
+	partial bool
+	dflt    string
+}
+
+func hdrFields(norm func(string) string) []hfield {
+	return []hfield{
+		{[]string{norm("a")}, false, ""},
+		{[]string{norm("b"), norm("bb")}, false, ""},
+		{[]string{norm("c")}, true, ""},
+		{[]string{norm("D")}, false, ""},
+		{[]string{norm("e")}, false, "dE"},
+	}
+}
+
+var zeroWidth = strings.NewReplacer("\u200b", "", "\ufeff", "", "\u200d", "", "\u200c", "")
+
+// matches: the documented column-to-field match: the header equals a key, or does after
+// trimming spaces or removing zero-width characters, or contains it for a partial field.
+func matches(h string, f hfield) bool {
+	for _, k := range f.keys {
+		if h == k || strings.TrimSpace(h) == k || zeroWidth.Replace(h) == k || (f.partial && strings.Contains(h, k)) {
+			return true
+		}
+	}
+	return false
+}
+
+// exactly: the header equals a key (what FailIfUnmatchedStructTags and Mismatched* use).
+func exactly(h string, f hfield) bool {
+	for _, k := range f.keys {
+		if h == k {
+			return true
+		}
+	}
+	return false
+}
+
+// mapColumns: field index of every column or -1; with align, the n-th duplicate header takes the
+// n-th matching field.
+func mapColumns(hdr []string, fields []hfield, align bool) []int {
+	out := make([]int, len(hdr))
+	count := map[string]int{}
+	for i, h := range hdr {
+		out[i] = -1
+		matched := 0
+		for fi, f := range fields {
+			if matches(h, f) {
+				if matched >= count[h] {
+					out[i] = fi
+					break
+				}
+				matched++
+			}
+		}
+		if out[i] >= 0 && align {
+			count[h]++
+		}
+	}
+	return out
+}
+
+var hdrNames = []string{"a", "b", "bb", "c", "D", "e", " a", "a ", "\uFEFFa", "a\u200b", "\u200dbb", "xcx", "c_", "cc", "A", "BB", "d", "E", "zz", "", "b b"}
+
+var normalizers = []struct {
+	name string
+	fn   func(string) string
+}{
+	{"identity", func(s string) string { return s }},
+	{"lower", strings.ToLower},
+}
+
+func hdrValue(tc hegel.TestCase) string { return strings.ReplaceAll(genString(tc), "\r", "") }
+
+// TestHegelHeadersMatchTheModel: columns are mapped to fields by the documented rules (exact,
+// trimmed, zero-width characters removed, partial, alternative keys, the normalizer), later
+// duplicates overwrite unless ShouldAlignDuplicateHeadersWithStructFieldOrder; default= fills
+// empty cells; FailIfDoubleHeaderNames and FailIfUnmatchedStructTags error as documented; the
+// Unmarshaller reports the same mapping, its mismatches and the unmatched cells.
+func TestHegelHeadersMatchTheModel(t *testing.T) {
+	resetGlobals(t)
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		nz := pick(ht, normalizers)
+		gocsv.SetHeaderNormalizer(nz.fn)
+		gocsv.ShouldAlignDuplicateHeadersWithStructFieldOrder = chance(ht, 30)
+		gocsv.FailIfDoubleHeaderNames = chance(ht, 30)
+		gocsv.FailIfUnmatchedStructTags = chance(ht, 30)
+		c.count("normalizer=" + nz.name)
+		fields := hdrFields(nz.fn)
+
+		k := n(ht, 2, 6) // two columns at least: a lone empty cell is an empty line, which encoding/csv skips
+		hdr := make([]string, k)
+		normHdr := make([]string, k)
+		for i := range hdr {
+			hdr[i] = pick(ht, hdrNames)
+			normHdr[i] = nz.fn(hdr[i])
+		}
+		rows := make([][]string, n(ht, 1, 2))
+		for i := range rows {
+			rows[i] = make([]string, k)
+			for j := range rows[i] {
+				rows[i][j] = hdrValue(ht)
+			}
+		}
+		text := writeCSV(append([][]string{hdr}, rows...))
+		mapping := mapColumns(normHdr, fields, gocsv.ShouldAlignDuplicateHeadersWithStructFieldOrder)
+
+		// Which fields are matched, by the mapping rules and by exact equality.
+		fuzzyOnly := false
+		unmatchedFields := 0
+		for fi, f := range fields {
+			exact, fuzzy := false, false
+			for _, h := range normHdr {
+				exact = exact || exactly(h, f)
+				fuzzy = fuzzy || matches(h, f)
+			}
+			if fuzzy && !exact {
+				fuzzyOnly = true
+			}
+			if !fuzzy {
+				unmatchedFields++
+			}
+			_ = fi
+		}
+		fuzzyCols := false
+		for _, h := range normHdr {
+			exact, fuzzy := false, false
+			for _, f := range fields {
+				exact = exact || exactly(h, f)
+				fuzzy = fuzzy || matches(h, f)
+			}
+			if fuzzy && !exact {
+				fuzzyCols = true
+			}
+		}
+		dup := false
+		seen := map[string]bool{}
+		for _, h := range normHdr {
+			if seen[h] {
+				dup = true
+			}
+			seen[h] = true
+		}
+
+		// Expected rows.
+		want := make([]Hdr, len(rows))
+		for i, row := range rows {
+			v := reflect.ValueOf(&want[i]).Elem()
+			for j, cell := range row {
+				if mapping[j] < 0 {
+					continue
+				}
+				if cell == "" {
+					cell = fields[mapping[j]].dflt
+				}
+				v.Field(mapping[j]).SetString(cell)
+			}
+		}
+
+		var got []Hdr
+		err := gocsv.UnmarshalString(text, &got)
+		switch {
+		case gocsv.FailIfUnmatchedStructTags && (unmatchedFields > 0 || fuzzyOnly):
+			if fuzzyOnly && unmatchedFields == 0 && Known.fuzzyMatchNotCounted {
+				c.count("fuzzy-gated")
+				return
+			}
+			c.count("unmatched-error")
+			if !errors.Is(err, gocsv.ErrUnmatchedStructTags) {
+				c.fail(ht, "FailIfUnmatchedStructTags with header %q: %v, want ErrUnmatchedStructTags", hdr, err)
+			}
+			return
+		case gocsv.FailIfDoubleHeaderNames && dup:
+			c.count("double-error")
+			if !errors.Is(err, gocsv.ErrDoubleHeaderNames) {
+				c.fail(ht, "FailIfDoubleHeaderNames with header %q: %v, want ErrDoubleHeaderNames", hdr, err)
+			}
+			return
+		}
+		c.count("ok")
+		if err != nil {
+			c.fail(ht, "UnmarshalString with header %q: %v", hdr, err)
+			return
+		}
+		if !reflect.DeepEqual(got, want) {
+			c.fail(ht, "header %q (normalizer %s, align %v):\n got  %+v\n want %+v\n text %q", hdr, nz.name, gocsv.ShouldAlignDuplicateHeadersWithStructFieldOrder, got, want, text)
+			return
+		}
+
+		// The Unmarshaller: same rows, plus the mismatch lists and the unmatched cells.
+		um, err := gocsv.NewUnmarshaller(csv.NewReader(strings.NewReader(text)), Hdr{})
+		if err != nil {
+			c.fail(ht, "NewUnmarshaller with header %q: %v", hdr, err)
+			return
+		}
+		if fuzzyOnly || fuzzyCols {
+			if Known.fuzzyMatchNotCounted {
+				c.count("mismatch-lists-gated")
+			}
+		} else {
+			var wantMH, wantMF []string
+			for _, h := range normHdr {
+				found := false
+				for _, f := range fields {
+					found = found || matches(h, f)
+				}
+				if !found {
+					wantMH = append(wantMH, h)
+				}
+			}
+			for _, f := range fields {
+				found := false
+				for _, h := range normHdr {
+					found = found || matches(h, f)
+				}
+				if !found {
+					wantMF = append(wantMF, f.keys...)
+				}
+			}
+			if !sameStrings(um.MismatchedHeaders, wantMH) || !sameStrings(um.MismatchedStructFields, wantMF) {
+				c.fail(ht, "Unmarshaller mismatches with header %q: headers %q fields %q, want %q and %q", hdr, um.MismatchedHeaders, um.MismatchedStructFields, wantMH, wantMF)
+				return
+			}
+		}
+		for i, row := range rows {
+			v, unmatched, err := um.ReadUnmatched()
+			if err != nil {
+				c.fail(ht, "ReadUnmatched row %d: %v", i, err)
+				return
+			}
+			if !reflect.DeepEqual(v, want[i]) {
+				c.fail(ht, "ReadUnmatched row %d: %+v, want %+v", i, v, want[i])
+				return
+			}
+			wantU := map[string]string{}
+			for j, cell := range row {
+				if mapping[j] < 0 {
+					wantU[normHdr[j]] = cell
+				}
+			}
+			if !reflect.DeepEqual(unmatched, wantU) {
+				c.fail(ht, "ReadUnmatched row %d unmatched: %q, want %q", i, unmatched, wantU)
+				return
+			}
+		}
+	})
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- cell conversions
+
+type Cells struct {
+	Z   string   `csv:"z"`
+	B   bool     `csv:"b"`
+	I8  int8     `csv:"i8"`
+	I16 int16    `csv:"i16"`
+	I32 int32    `csv:"i32"`
+	I64 int64    `csv:"i64"`
+	U8  uint8    `csv:"u8"`
+	U16 uint16   `csv:"u16"`
+	U32 uint32   `csv:"u32"`
+	U64 uint64   `csv:"u64"`
+	F32 float32  `csv:"f32"`
+	F64 float64  `csv:"f64"`
+	PI8 *int8    `csv:"pi8"`
+	PU8 *uint8   `csv:"pu8"`
+	PF  *float32 `csv:"pf"`
+	PB  *bool    `csv:"pb"`
+}
+
+var cellsHeader = strings.Split("z,b,i8,i16,i32,i64,u8,u16,u32,u64,f32,f64,pi8,pu8,pf,pb", ",")
+
+var cellWords = []string{"yes", "no", "YES", "No", " yes ", "true", "false", "t", "f", "T", "F", "1", "0", "on", "off", "", "  ", "NaN", "Inf", "-Inf", "+Inf", "inf", "nan", "infinity"}
+var cellGarbage = []string{"1a", "0x1f", "1_000", "+", "-", ".", "1.", ".5", "-.5", "\uFF11", "1e", "e1", "--1", "+-1", "0b1", "1 2", "1,5", "1.2.3", "0.5.", "1e5.5"}
+
+func genDigits(tc hegel.TestCase, lo, hi int) string {
+	var b strings.Builder
+	for k := n(tc, lo, hi); k > 0; k-- {
+		b.WriteByte(byte('0' + n(tc, 0, 9)))
+	}
+	return b.String()
+}
+
+func genNumCell(tc hegel.TestCase) string {
+	switch n(tc, 1, 10) {
+	case 1:
+		return pick(tc, cellWords)
+	case 2:
+		return pick(tc, cellGarbage)
+	}
+	var b strings.Builder
+	if chance(tc, 20) {
+		b.WriteString(pick(tc, []string{"-", "+"}))
+	}
+	b.WriteString(genDigits(tc, 1, 22))
+	if chance(tc, 40) {
+		if chance(tc, 15) {
+			b.WriteString(",")
+		} else {
+			b.WriteString(".")
+		}
+		b.WriteString(genDigits(tc, 0, 8))
+	}
+	if chance(tc, 20) {
+		b.WriteString(pick(tc, []string{"e", "E"}))
+		if chance(tc, 40) {
+			b.WriteString(pick(tc, []string{"-", "+"}))
+		}
+		b.WriteString(genDigits(tc, 1, 3))
+	}
+	s := b.String()
+	if chance(tc, 15) {
+		s = pick(tc, []string{" ", "\t", "  "}) + s + pick(tc, []string{"", " ", "\n"})
+	}
+	return s
+}
+
+// gocsvUintFloatPath: what gocsv computes for a uint cell containing '.', on this machine.
+func gocsvUintFloatPath(cell string, bits int) (uint64, bool) {
+	s := strings.TrimSpace(cell)
+	if !strings.Contains(s, ".") {
+		return 0, false
+	}
+	f, err := strconv.ParseFloat(s, 64)
+	if err != nil {
+		return 0, false
+	}
+	v := reflect.New(uintType(bits)).Elem()
+	v.SetUint(uint64(f))
+	return v.Uint(), true
+}
+
+func uintType(bits int) reflect.Type {
+	switch bits {
+	case 8:
+		return reflect.TypeOf(uint8(0))
+	case 16:
+		return reflect.TypeOf(uint16(0))
+	case 32:
+		return reflect.TypeOf(uint32(0))
+	}
+	return reflect.TypeOf(uint64(0))
+}
+
+// gate classifies a cell/field pair whose gocsv result differs from the model as one of the
+// recorded bugs, or "" when it is a real mismatch. leaf is the (non-pointer) field type.
+func gate(cell string, leaf reflect.Type, got reflect.Value, gotErr error, modelErr error) string {
+	s := strings.TrimSpace(cell)
+	switch leaf.Kind() {
+	case reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if Known.intWraps && gotErr == nil && errors.Is(modelErr, strconv.ErrRange) {
+			part := strings.SplitN(s, ".", 2)[0]
+			if wide, err := strconv.ParseInt(part, 10, 64); err == nil {
+				v := reflect.New(leaf).Elem()
+				v.SetInt(wide)
+				if v.Int() == got.Int() {
+					return "wrap-gated"
+				}
+			}
+		}
+	case reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if Known.uintFloatPath && strings.Contains(s, ".") {
+			// gocsv parses the cell as a float: an error where the model reads the integer
+			// part, or the converted value.
+			if _, err := strconv.ParseFloat(s, 64); err != nil && gotErr != nil {
+				return "uint-float-gated"
+			}
+			if u, ok := gocsvUintFloatPath(cell, leaf.Bits()); ok && gotErr == nil && u == got.Uint() {
+				return "uint-float-gated"
+			}
+		}
+		if Known.intWraps && gotErr == nil && errors.Is(modelErr, strconv.ErrRange) {
+			if wide, err := strconv.ParseUint(s, 10, 64); err == nil {
+				v := reflect.New(leaf).Elem()
+				v.SetUint(wide)
+				if v.Uint() == got.Uint() {
+					return "wrap-gated"
+				}
+			}
+		}
+	case reflect.Float32:
+		if Known.float32Via64 && gotErr == nil {
+			f64, err := strconv.ParseFloat(strings.ReplaceAll(s, ",", "."), 64)
+			if err == nil && (float32(f64) == float32(got.Float()) || (math.IsNaN(f64) && math.IsNaN(got.Float()))) {
+				if modelErr != nil {
+					return "f32-range-gated"
+				}
+				return "f32-rounding-gated"
+			}
+		}
+	}
+	return ""
+}
+
+// TestHegelCellsDecodeLikeTheModel: every bool, integer and float field (and pointer to one)
+// decodes a random numeric-looking cell as the model does or errors as it does; a whole row
+// errors at its first failing column (ParseError line 2, that column) or decodes every field.
+func TestHegelCellsDecodeLikeTheModel(t *testing.T) {
+	c := newCollector(t)
+	cellsT := reflect.TypeOf(Cells{})
+	cols := layout(cellsT)
+	if len(cols) != len(cellsHeader) {
+		t.Fatalf("layout has %d columns, the header %d", len(cols), len(cellsHeader))
+	}
+	property(t, func(ht *hegel.T) {
+		cells := make([]string, len(cols))
+		cells[0] = "x"
+		for j := 1; j < len(cells); j++ {
+			cells[j] = genNumCell(ht)
+		}
+		// Each column alone (with the string column so that the row is never an empty line).
+		single := make([]Cells, len(cols))
+		singleErr := make([]error, len(cols))
+		for j := 1; j < len(cols); j++ {
+			text := writeCSV([][]string{{"z", cellsHeader[j]}, {"x", cells[j]}})
+			var got []Cells
+			err := gocsv.UnmarshalString(text, &got)
+			singleErr[j] = err
+			if err == nil {
+				if len(got) != 1 {
+					c.fail(ht, "%s=%q: %d rows", cellsHeader[j], cells[j], len(got))
+					return
+				}
+				single[j] = got[0]
+			}
+			want := reflect.New(cellsT).Elem()
+			want.Field(0).SetString("x")
+			modelErr := decodeInto(want, cols[j], cells[j], true)
+			leaf := cellsT.Field(j).Type
+			if leaf.Kind() == reflect.Ptr {
+				leaf = leaf.Elem()
+			}
+			var gotField reflect.Value
+			if err == nil {
+				gotField = reflect.ValueOf(got[0]).Field(j)
+				if gotField.Kind() == reflect.Ptr && !gotField.IsNil() {
+					gotField = gotField.Elem()
+				}
+			}
+			switch {
+			case modelErr != nil && err != nil:
+				c.count("error")
+			case modelErr == nil && err == nil && same(reflect.ValueOf(got[0]), want):
+				c.count("ok")
+			default:
+				if g := gate(cells[j], leaf, gotField, err, modelErr); g != "" {
+					c.count(g)
+					continue
+				}
+				c.fail(ht, "%s=%q: gocsv %s (%v), model %s (%v)", cellsHeader[j], cells[j], showErr(got, err), err, show(want), modelErr)
+				return
+			}
+		}
+		// The whole row: the first failing column decides.
+		text := writeCSV([][]string{cellsHeader, cells})
+		var got []Cells
+		err := gocsv.UnmarshalString(text, &got)
+		firstBad := -1
+		for j := 1; j < len(cols); j++ {
+			if singleErr[j] != nil {
+				firstBad = j
+				break
+			}
+		}
+		if firstBad >= 0 {
+			var pe *csv.ParseError
+			if !errors.As(err, &pe) {
+				c.fail(ht, "row %q: %v, want a ParseError at column %d", cells, err, firstBad+1)
+				return
+			}
+			if pe.Line != 2 || pe.Column != firstBad+1 {
+				c.fail(ht, "row %q: error at line %d column %d, want line 2 column %d: %v", cells, pe.Line, pe.Column, firstBad+1, err)
+			}
+			return
+		}
+		if err != nil || len(got) != 1 {
+			c.fail(ht, "row %q: %v (%d rows), every column decodes alone", cells, err, len(got))
+			return
+		}
+		want := reflect.New(cellsT).Elem()
+		want.Field(0).SetString("x")
+		for j := 1; j < len(cols); j++ {
+			want.Field(j).Set(reflect.ValueOf(single[j]).Field(j))
+		}
+		if !same(reflect.ValueOf(got[0]), want) {
+			c.fail(ht, "row %q:\n got  %s\n want %s (the columns decoded alone)", cells, show(reflect.ValueOf(got[0])), show(want))
+		}
+	})
+}
+
+func showErr(got []Cells, err error) string {
+	if err != nil {
+		return "error"
+	}
+	if len(got) == 0 {
+		return "no rows"
+	}
+	return show(reflect.ValueOf(got[0]))
+}
+
+// --------------------------------------------------------------------------- csv[] columns
+
+type SArr struct {
+	Id int     `csv:"id"`
+	V  []int16 `csv:"v" csv[]:"5"`
+	W  []Bar   `csv:"w" csv[]:"3"`
+	X  [4]int8 `csv:"x" csv[]:"4"`
+}
+
+var sarrHeader = strings.Split("id,v[0],v[1],v[2],v[3],v[4],w[0].a,w[0].b,w[1].a,w[1].b,w[2].a,w[2].b,x[0],x[1],x[2],x[3]", ",")
+
+// growthPanics simulates gocsv's slice growth over the columns in their order and says whether a
+// SetLen beyond the new capacity would panic.
+func growthPanics(cols []col, order []int) bool {
+	type st struct{ length, capacity int }
+	states := map[int]*st{}
+	for _, j := range order {
+		c := cols[j]
+		if len(c.steps) < 2 || !c.steps[1].index {
+			continue
+		}
+		field := c.steps[0].i
+		if reflect.TypeOf(SArr{}).Field(field).Type.Kind() != reflect.Slice {
+			continue
+		}
+		s := states[field]
+		if s == nil {
+			s = &st{}
+			states[field] = s
+		}
+		i := c.steps[1].i
+		if i >= s.capacity {
+			newcap := s.capacity + s.capacity/2
+			if newcap < 4 {
+				newcap = 4
+			}
+			s.capacity = newcap
+			if i >= s.capacity {
+				return true
+			}
+		}
+		if i >= s.length {
+			s.length = i + 1
+		}
+	}
+	return false
+}
+
+// TestHegelSliceColumnsFollowTheTags: csv[] columns of slices, slices of structs and arrays
+// read back in any column order and with columns missing: the slice grows to the highest index
+// present, gaps are zero values, absent fields stay nil.
+func TestHegelSliceColumnsFollowTheTags(t *testing.T) {
+	c := newCollector(t)
+	sarrT := reflect.TypeOf(SArr{})
+	cols := layout(sarrT)
+	if len(cols) != len(sarrHeader) {
+		t.Fatalf("layout has %d columns, the header %d", len(cols), len(sarrHeader))
+	}
+	property(t, func(ht *hegel.T) {
+		rows := n(ht, 1, 2)
+		values := make([]reflect.Value, rows)
+		cells := make([][]string, rows)
+		for i := range values {
+			values[i] = genValue(ht, sarrT, 0)
+			cells[i] = cellsOf(values[i], cols)
+		}
+		// Marshal is the model's cells.
+		in := reflect.MakeSlice(reflect.SliceOf(sarrT), rows, rows)
+		for i, v := range values {
+			in.Index(i).Set(v)
+		}
+		gotText, err := gocsv.MarshalString(in.Interface())
+		wantText := writeCSV(append([][]string{sarrHeader}, cells...))
+		if err != nil || gotText != wantText {
+			c.fail(ht, "MarshalString: %v\n got  %q\n want %q", err, gotText, wantText)
+			return
+		}
+		// A random order and subset of the columns.
+		order := make([]int, len(cols))
+		for j := range order {
+			order[j] = j
+		}
+		for j := len(order) - 1; j > 0; j-- {
+			k := n(ht, 0, j)
+			order[j], order[k] = order[k], order[j]
+		}
+		var kept []int
+		for _, j := range order {
+			if chance(ht, 75) {
+				kept = append(kept, j)
+			}
+		}
+		if len(kept) == 0 {
+			kept = []int{0}
+		}
+		hdr := make([]string, len(kept))
+		body := make([][]string, rows)
+		for i := range body {
+			body[i] = make([]string, len(kept))
+		}
+		for p, j := range kept {
+			hdr[p] = sarrHeader[j]
+			for i := range body {
+				body[i][p] = cells[i][j]
+			}
+		}
+		text := writeCSV(append([][]string{hdr}, body...))
+		want := make([]reflect.Value, rows)
+		for i := range want {
+			want[i] = reflect.New(sarrT).Elem()
+			for p, j := range kept {
+				if err := decodeInto(want[i], cols[j], transported(body[i][p]), true); err != nil {
+					c.fail(ht, "model: %v", err)
+					return
+				}
+			}
+		}
+		var got []SArr
+		if growthPanics(cols, kept) && Known.sliceGrowthPanics {
+			c.count("growth-gated")
+			if r := catch(func() { _ = gocsv.UnmarshalString(text, &got) }); r == nil {
+				c.fail(ht, "columns %q: the model predicts gocsv's SetLen panic but none came", hdr)
+			}
+			return
+		}
+		c.count(fmt.Sprintf("kept=%d", len(kept)))
+		if err := gocsv.UnmarshalString(text, &got); err != nil {
+			c.fail(ht, "columns %q: %v\n text %q", hdr, err, text)
+			return
+		}
+		if len(got) != rows {
+			c.fail(ht, "columns %q: %d rows, want %d", hdr, len(got), rows)
+			return
+		}
+		for i := range got {
+			if !same(reflect.ValueOf(got[i]), want[i]) {
+				c.fail(ht, "columns %q row %d:\n got  %s\n want %s\n text %q", hdr, i, show(reflect.ValueOf(got[i])), show(want[i]), text)
+				return
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- the map helpers
+
+var mapNames = []string{"a", "b", "c", "a", "", "x y", "1"}
+
+// TestHegelMapsFollowTheModel: CSVToMaps and CSVToChanMaps give one header-keyed map per row
+// (later duplicate headers win); CSVToMap and UnmarshalCSVToMap accept exactly two columns and
+// map the first to the second (later keys win), UnmarshalCSVToMap converting the values.
+func TestHegelMapsFollowTheModel(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 2, 5)
+		hdr := make([]string, k)
+		for i := range hdr {
+			hdr[i] = pick(ht, mapNames)
+		}
+		rows := make([][]string, n(ht, 0, 4))
+		for i := range rows {
+			rows[i] = make([]string, k)
+			for j := range rows[i] {
+				if chance(ht, 60) {
+					rows[i][j] = genNumCell(ht)
+				} else {
+					rows[i][j] = hdrValue(ht)
+				}
+			}
+		}
+		text := writeCSV(append([][]string{hdr}, rows...))
+		c.count(fmt.Sprintf("cols=%d", k))
+
+		wantMaps := []map[string]string{}
+		for _, row := range rows {
+			m := map[string]string{}
+			for j, h := range hdr {
+				m[h] = transported(row[j])
+			}
+			wantMaps = append(wantMaps, m)
+		}
+		got, err := gocsv.CSVToMaps(strings.NewReader(text))
+		if err != nil || !reflect.DeepEqual(got, wantMaps) {
+			c.fail(ht, "CSVToMaps(%q): %v\n got  %v\n want %v", text, err, got, wantMaps)
+			return
+		}
+		ch := make(chan map[string]string, 16)
+		if err := gocsv.CSVToChanMaps(strings.NewReader(text), ch); err != nil {
+			c.fail(ht, "CSVToChanMaps(%q): %v", text, err)
+			return
+		}
+		close(ch)
+		var fromChan []map[string]string
+		for m := range ch {
+			fromChan = append(fromChan, m)
+		}
+		if len(fromChan) != len(wantMaps) || (len(wantMaps) > 0 && !reflect.DeepEqual(fromChan, wantMaps)) {
+			c.fail(ht, "CSVToChanMaps(%q):\n got  %v\n want %v", text, fromChan, wantMaps)
+			return
+		}
+
+		m, err := gocsv.CSVToMap(strings.NewReader(text))
+		var mm map[string]string
+		err2 := gocsv.UnmarshalCSVToMap(csv.NewReader(strings.NewReader(text)), &mm)
+		if k != 2 {
+			if err == nil || err2 == nil {
+				c.fail(ht, "CSVToMap of %d columns: %v / %v, want errors", k, err, err2)
+			}
+			return
+		}
+		wantMap := map[string]string{}
+		wantInts := map[string]int{}
+		var wantIntErr error
+		for _, row := range rows {
+			wantMap[transported(row[0])] = transported(row[1])
+			if wantIntErr == nil {
+				i, e := modelInt(transported(row[1]), 64)
+				if e != nil {
+					wantIntErr = e
+				} else {
+					wantInts[transported(row[0])] = int(i)
+				}
+			}
+		}
+		if err != nil || !reflect.DeepEqual(m, wantMap) {
+			c.fail(ht, "CSVToMap(%q): %v\n got  %v\n want %v", text, err, m, wantMap)
+			return
+		}
+		if err2 != nil || !reflect.DeepEqual(mm, wantMap) {
+			c.fail(ht, "UnmarshalCSVToMap(%q): %v\n got  %v\n want %v", text, err2, mm, wantMap)
+			return
+		}
+		var mi map[string]int
+		err3 := gocsv.UnmarshalCSVToMap(csv.NewReader(strings.NewReader(text)), &mi)
+		if wantIntErr != nil {
+			if err3 == nil {
+				// An int cell the model rejects: the recorded wrap and float-path bugs apply to
+				// int64 only as range errors, which gocsv shares; anything else is a mismatch.
+				c.fail(ht, "UnmarshalCSVToMap(%q) into map[string]int: no error, model %v", text, wantIntErr)
+			}
+			c.count("int-error")
+			return
+		}
+		if err3 != nil || !reflect.DeepEqual(mi, wantInts) {
+			c.fail(ht, "UnmarshalCSVToMap(%q) into map[string]int: %v\n got  %v\n want %v", text, err3, mi, wantInts)
+		}
+	})
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..06ffb7e
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,301 @@
+package gocsv_test
+
+// Pins: one plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and
+// fails while the bug exists; the target lists them as expected failures.
+
+import (
+	"encoding/csv"
+	"errors"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gocarina/gocsv"
+)
+
+func noPanic(t *testing.T, what string, f func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("%s panics: %v", what, r)
+		}
+	}()
+	f()
+}
+
+type pinSlice struct {
+	Id int   `csv:"id"`
+	V  []int `csv:"v" csv[]:"6"`
+}
+
+// gocsv/1: csv[] columns read in any order or with columns missing.
+func TestHegelPinSliceColumnsInAnyOrder(t *testing.T) {
+	var out []pinSlice
+	noPanic(t, "UnmarshalString with columns id,v[5],v[0]", func() {
+		if err := gocsv.UnmarshalString("id,v[5],v[0]\n1,5,0\n", &out); err != nil {
+			t.Fatalf("UnmarshalString: %v", err)
+		}
+	})
+	if len(out) != 1 || len(out[0].V) != 6 || out[0].V[5] != 5 {
+		t.Fatalf("got %+v, want V of length 6 with V[5] = 5", out)
+	}
+}
+
+type pinAny struct {
+	Id  int         `csv:"id"`
+	Any interface{} `csv:"any"`
+}
+
+// gocsv/2: a struct with an interface{} field: Marshal accepts it, Unmarshal must not panic.
+func TestHegelPinInterfaceFieldDoesNotPanic(t *testing.T) {
+	text, err := gocsv.MarshalString(&[]pinAny{{1, "x"}})
+	if err != nil {
+		t.Fatalf("MarshalString: %v", err)
+	}
+	var out []pinAny
+	noPanic(t, "UnmarshalString into a struct with an interface{} field", func() {
+		_ = gocsv.UnmarshalString(text, &out)
+	})
+}
+
+type pinTwo struct {
+	A string `csv:"a"`
+	B string `csv:"b"`
+}
+
+// gocsv/3: UnmarshalToChanWithoutHeaders on a row with more columns than fields, which
+// UnmarshalWithoutHeaders ignores.
+func TestHegelPinHeaderlessChanIgnoresExtraColumns(t *testing.T) {
+	var viaSlice []pinTwo
+	if err := gocsv.UnmarshalWithoutHeaders(strings.NewReader("1,2,3\n"), &viaSlice); err != nil {
+		t.Fatalf("UnmarshalWithoutHeaders: %v", err)
+	}
+	ch := make(chan pinTwo, 4)
+	noPanic(t, "UnmarshalToChanWithoutHeaders on a row of 3 columns for 2 fields", func() {
+		if err := gocsv.UnmarshalToChanWithoutHeaders(strings.NewReader("1,2,3\n"), ch); err != nil {
+			t.Fatalf("UnmarshalToChanWithoutHeaders: %v", err)
+		}
+	})
+	got := <-ch
+	if got != viaSlice[0] {
+		t.Fatalf("channel row %+v, slice row %+v", got, viaSlice[0])
+	}
+}
+
+type pinNum struct {
+	I8 int8  `csv:"i8"`
+	U8 uint8 `csv:"u8"`
+}
+
+// gocsv/4: an integer cell that does not fit the field is an error, not a wrapped value.
+func TestHegelPinIntegerOverflowIsAnError(t *testing.T) {
+	var out []pinNum
+	if err := gocsv.UnmarshalString("i8,u8\n300,0\n", &out); err == nil {
+		t.Fatalf("300 into an int8 field: no error, got %+v", out)
+	}
+	out = nil
+	if err := gocsv.UnmarshalString("i8,u8\n0,300\n", &out); err == nil {
+		t.Fatalf("300 into a uint8 field: no error, got %+v", out)
+	}
+}
+
+type pinIU struct {
+	I int  `csv:"i"`
+	U uint `csv:"u"`
+}
+
+// gocsv/5: uint cells follow the integer rules: a negative is an error, an exponent reads as it
+// does for an int field.
+func TestHegelPinUintCellsParseLikeIntCells(t *testing.T) {
+	var out []pinIU
+	if err := gocsv.UnmarshalString("i,u\n0,-1.5\n", &out); err == nil {
+		t.Fatalf("-1.5 into a uint field: no error, got %+v", out)
+	}
+	out = nil
+	if err := gocsv.UnmarshalString("i,u\n1.5e2,1.5e2\n", &out); err != nil {
+		t.Fatalf("1.5e2: %v", err)
+	}
+	if uint(out[0].I) != out[0].U {
+		t.Fatalf("1.5e2 reads as %d for int and %d for uint", out[0].I, out[0].U)
+	}
+}
+
+type pinF32 struct {
+	F float32 `csv:"f"`
+}
+
+// gocsv/6: a float32 cell out of the type's range is an error (strconv.ParseFloat at 32 bits).
+func TestHegelPinFloat32OutOfRangeIsAnError(t *testing.T) {
+	var out []pinF32
+	if err := gocsv.UnmarshalString("f\n1e40\n", &out); err == nil {
+		t.Fatalf("1e40 into a float32 field: no error, got %v", out[0].F)
+	}
+}
+
+type pinBar struct {
+	A int `csv:"a"`
+	B int `csv:"b"`
+}
+
+type pinMulti struct {
+	Bar pinBar `csv:"p,q"`
+	X   int    `csv:"x"`
+}
+
+// gocsv/7: a nested struct field with two keys is reachable through either prefix.
+func TestHegelPinMultiKeyNestedHeaders(t *testing.T) {
+	var out []pinMulti
+	if err := gocsv.UnmarshalString("q.a,q.b,x\n1,2,3\n", &out); err != nil {
+		t.Fatalf("UnmarshalString: %v", err)
+	}
+	if out[0].Bar != (pinBar{1, 2}) {
+		t.Fatalf("headers q.a,q.b: got %+v, want Bar{1 2}", out[0])
+	}
+}
+
+type pinArr struct {
+	Id int    `csv:"id"`
+	A  [2]int `csv:"a"`
+}
+
+// gocsv/8: an array field without a csv[] tag reads back what Marshal wrote.
+func TestHegelPinArrayFieldRoundTrips(t *testing.T) {
+	in := []pinArr{{1, [2]int{3, 4}}}
+	text, err := gocsv.MarshalString(&in)
+	if err != nil {
+		t.Fatalf("MarshalString: %v", err)
+	}
+	var out []pinArr
+	if err := gocsv.UnmarshalString(text, &out); err != nil {
+		t.Fatalf("UnmarshalString of %q: %v", text, err)
+	}
+	if !reflect.DeepEqual(in, out) {
+		t.Fatalf("got %+v, want %+v", out, in)
+	}
+}
+
+type pinMap struct {
+	Id int            `csv:"id"`
+	M  map[string]int `csv:"m"`
+}
+
+// gocsv/9: a map field is either refused by Marshal or read back by Unmarshal.
+func TestHegelPinMapFieldRoundTrips(t *testing.T) {
+	in := []pinMap{{1, map[string]int{"k": 3}}}
+	text, err := gocsv.MarshalString(&in)
+	if err != nil {
+		return
+	}
+	var out []pinMap
+	if err := gocsv.UnmarshalString(text, &out); err != nil {
+		t.Fatalf("Marshal wrote %q without error, Unmarshal: %v", text, err)
+	}
+	if !reflect.DeepEqual(in, out) {
+		t.Fatalf("got %+v, want %+v", out, in)
+	}
+}
+
+// gocsv/10: a header that is matched after trimming (or through a BOM) counts as matched for
+// FailIfUnmatchedStructTags and the Unmarshaller's mismatch lists.
+func TestHegelPinTrimmedHeaderCountsAsMatched(t *testing.T) {
+	gocsv.FailIfUnmatchedStructTags = true
+	defer func() { gocsv.FailIfUnmatchedStructTags = false }()
+	var out []pinTwo
+	if err := gocsv.UnmarshalString("\uFEFFa,b\n1,2\n", &out); err != nil {
+		t.Fatalf("a BOM before the first header: %v (the row decodes without the flag)", err)
+	}
+	um, err := gocsv.NewUnmarshaller(csv.NewReader(strings.NewReader(" a,b\n1,2\n")), pinTwo{})
+	if err != nil {
+		t.Fatalf("NewUnmarshaller: %v", err)
+	}
+	if len(um.MismatchedHeaders) != 0 || len(um.MismatchedStructFields) != 0 {
+		t.Fatalf("header \" a\" is mapped to field a but reported: headers %q, fields %q", um.MismatchedHeaders, um.MismatchedStructFields)
+	}
+}
+
+// gocsv/11: Unmarshal into a slice replaces its contents.
+func TestHegelPinUnmarshalReplacesTheSlice(t *testing.T) {
+	out := []pinTwo{{"x", "x"}, {"y", "y"}, {"z", "z"}}
+	if err := gocsv.UnmarshalString("a,b\n1,2\n", &out); err != nil {
+		t.Fatalf("UnmarshalString: %v", err)
+	}
+	if len(out) != 1 {
+		t.Fatalf("one CSV row into a slice of three: %+v", out)
+	}
+}
+
+// gocsv/12: CSVToMaps with a reader that allows ragged rows does not panic on a short row.
+func TestHegelPinRaggedRowsDoNotPanic(t *testing.T) {
+	gocsv.SetCSVReader(func(in io.Reader) gocsv.CSVReader {
+		r := csv.NewReader(in)
+		r.FieldsPerRecord = -1
+		return r
+	})
+	defer gocsv.SetCSVReader(gocsv.DefaultCSVReader)
+	noPanic(t, "CSVToMaps on a row shorter than the header", func() {
+		_, _ = gocsv.CSVToMaps(strings.NewReader("a,b\n1\n"))
+	})
+}
+
+type pinDur struct {
+	Id int           `csv:"id"`
+	D  time.Duration `csv:"d"`
+}
+
+// gocsv/13: what Marshal writes for a time.Duration field reads back.
+func TestHegelPinStringerOutputReadsBack(t *testing.T) {
+	in := []pinDur{{1, 1500 * time.Millisecond}, {2, 2 * time.Second}}
+	text, err := gocsv.MarshalString(&in)
+	if err != nil {
+		t.Fatalf("MarshalString: %v", err)
+	}
+	var out []pinDur
+	if err := gocsv.UnmarshalString(text, &out); err != nil {
+		t.Fatalf("UnmarshalString of %q: %v", text, err)
+	}
+	if !reflect.DeepEqual(in, out) {
+		t.Fatalf("got %+v, want %+v", out, in)
+	}
+}
+
+type pinDefault struct {
+	D string `csv:"d,default=7"`
+	X string `csv:"x"`
+}
+
+// gocsv/14: default= applies without headers as it does with them.
+func TestHegelPinHeaderlessAppliesDefault(t *testing.T) {
+	var withHeaders, without []pinDefault
+	if err := gocsv.UnmarshalString("d,x\n,x\n", &withHeaders); err != nil {
+		t.Fatalf("UnmarshalString: %v", err)
+	}
+	if err := gocsv.UnmarshalWithoutHeaders(strings.NewReader(",x\n"), &without); err != nil {
+		t.Fatalf("UnmarshalWithoutHeaders: %v", err)
+	}
+	if withHeaders[0].D != "7" {
+		t.Fatalf("with headers: D = %q, want the default 7", withHeaders[0].D)
+	}
+	if without[0].D != "7" {
+		t.Fatalf("without headers: D = %q, want the default 7", without[0].D)
+	}
+}
+
+type pinInts struct {
+	A int `csv:"a"`
+	B int `csv:"b"`
+}
+
+// gocsv/15: the headerless channel path reports a conversion error on the line it is on.
+func TestHegelPinHeaderlessChanErrorLine(t *testing.T) {
+	ch := make(chan pinInts, 4)
+	err := gocsv.UnmarshalToChanWithoutHeaders(strings.NewReader("1,x\n"), ch)
+	var pe *csv.ParseError
+	if !errors.As(err, &pe) {
+		t.Fatalf("got %v, want a ParseError", err)
+	}
+	if pe.Line != 1 {
+		t.Fatalf("error reported on line %d, want line 1 (there is no header)", pe.Line)
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..1565068
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1116 @@
+package gocsv_test
+
+// Hegel property tests for gocarina/gocsv, written for the Hegel zoo.
+// See targets/go/gocsv/README.md.
+//
+// Oracles: a model of the documented column layout (tags, nested and inline structs, csv[]
+// expansion, JSON fallback) and cell conversions (strconv with the field's width, the lenient
+// bool/int/float rules, omitempty and default=) over four struct types whose headers are written
+// by hand; encoding/csv for the text itself; and gocsv's own entry points against each other
+// (every Unmarshal* path must agree on the same text).
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"bytes"
+	"encoding/csv"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/gocarina/gocsv"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// catch runs f and returns the panic value, if any.
+func catch(f func()) (r any) {
+	defer func() { r = recover() }()
+	f()
+	return nil
+}
+
+// resetGlobals restores gocsv's package-level switches after a test.
+func resetGlobals(t *testing.T) {
+	t.Cleanup(func() {
+		gocsv.FailIfUnmatchedStructTags = false
+		gocsv.FailIfDoubleHeaderNames = false
+		gocsv.ShouldAlignDuplicateHeadersWithStructFieldOrder = false
+		gocsv.SetHeaderNormalizer(gocsv.DefaultNameNormalizer())
+	})
+}
