+var floatSpecials = []float64{0, math.Copysign(0, -1), 1, -1, 0.1, 0.5, 1.0 / 3, 123456.789, 1e-45, 1e-300, math.MaxFloat32, math.MaxFloat64, math.SmallestNonzeroFloat64, math.Inf(1), math.Inf(-1), math.NaN(), 16777217, 1e21, -2.5e-7}
