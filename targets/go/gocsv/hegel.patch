+// genValue: a random value of type t; csvN is the csv[] tag of the field holding it (0: none).
+func genValue(tc hegel.TestCase, t reflect.Type, csvN int) reflect.Value {
+	v := reflect.New(t).Elem()
+	switch t {
+	case reflect.TypeOf(time.Time{}):
+		v.Set(reflect.ValueOf(genTime(tc)))
+		return v
+	case reflect.TypeOf(Hex(0)):
+		v.SetUint(uint64(n(tc, 0, math.MaxUint32)))
+		return v
+	}
+	switch t.Kind() {
+	case reflect.Ptr:
+		if chance(tc, 30) {
+			return v
+		}
+		p := reflect.New(t.Elem())
+		p.Elem().Set(genValue(tc, t.Elem(), csvN))
+		v.Set(p)
+	case reflect.Struct:
+		for i := 0; i < t.NumField(); i++ {
+			f := t.Field(i)
+			if f.PkgPath != "" {
+				continue
+			}
+			count := 0
+			if tag, ok := f.Tag.Lookup("csv[]"); ok {
+				count, _ = strconv.Atoi(tag)
+			}
+			v.Field(i).Set(genValue(tc, f.Type, count))
+		}
+	case reflect.Slice:
+		var length int
+		if csvN > 0 {
+			length = n(tc, 0, csvN)
+			if chance(tc, 10) {
+				length = csvN + 1
+			}
+		} else {
+			if chance(tc, 20) {
+				return v
+			}
+			length = n(tc, 0, 3)
+		}
+		s := reflect.MakeSlice(t, length, length)
+		for i := 0; i < length; i++ {
+			s.Index(i).Set(genValue(tc, t.Elem(), 0))
+		}
+		v.Set(s)
+	case reflect.Array:
+		for i := 0; i < t.Len(); i++ {
+			v.Index(i).Set(genValue(tc, t.Elem(), 0))
+		}
+	case reflect.String:
+		v.SetString(genString(tc))
+	case reflect.Bool:
+		v.SetBool(chance(tc, 50))
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		v.SetInt(genInt(tc, t.Bits()))
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		v.SetUint(genUint(tc, t.Bits()))
+	case reflect.Float32, reflect.Float64:
+		v.SetFloat(genFloat(tc, t.Bits()))
+	default:
+		panic("genValue: " + t.String())
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- the CSV text
+
+func writeCSV(rows [][]string) string {
+	var b bytes.Buffer
+	w := csv.NewWriter(&b)
+	for _, r := range rows {
+		_ = w.Write(r)
+	}
+	w.Flush()
+	return b.String()
+}
+
+// transported: what encoding/csv reads back of a written cell (CRLF at a physical line end
+// becomes LF).
+func transported(s string) string { return strings.ReplaceAll(s, "\r\n", "\n") }
+
+// table is one generated container of rows with its modelled text.
+type table struct {
+	t        reflect.Type
+	cols     []col
+	rows     []reflect.Value // elements of type t; invalid Value for a nil *t element
+	header   []string
+	cells    [][]string
+	withHdr  string
+	headless string
+}
+
+// genTable: ptrRows allows nil rows (elements of a []*T; their cells are empty).
+func genTable(tc hegel.TestCase, t reflect.Type, ptrRows bool) *table {
+	tb := &table{t: t, cols: layout(t), header: strings.Split(headers[t], ",")}
+	for k := n(tc, 0, 4); k > 0; k-- {
+		if ptrRows && chance(tc, 8) {
+			tb.rows = append(tb.rows, reflect.Value{})
+			tb.cells = append(tb.cells, make([]string, len(tb.cols)))
+			continue
+		}
+		v := genValue(tc, t, 0)
+		tb.rows = append(tb.rows, v)
+		tb.cells = append(tb.cells, cellsOf(v, tb.cols))
+	}
+	tb.withHdr = writeCSV(append([][]string{tb.header}, tb.cells...))
+	tb.headless = writeCSV(tb.cells)
+	return tb
+}
+
+// expected: the rows the model reads back (as values of type t), or the first error's position.
+type expected struct {
+	rows []reflect.Value
+	line int // 1-based line of the failing row in the text, 0 when none
+	col  int // 1-based column
+}
+
+func (tb *table) expect(useDefault bool, firstLine int) expected {
+	ex := expected{}
+	for i, cells := range tb.cells {
+		tr := make([]string, len(cells))
+		for j, c := range cells {
+			tr[j] = transported(c)
+		}
+		v, j, err := decodeRow(tb.t, tb.cols, tr, useDefault)
+		if err != nil {
+			ex.line, ex.col = firstLine+i, j+1
+			return ex
+		}
+		ex.rows = append(ex.rows, v)
+	}
+	return ex
+}
+
+// container builds a []t, []*t or [k]t holding the rows (nil elements for invalid Values).
+func (tb *table) container(kind int) reflect.Value {
+	switch kind {
+	case 0:
+		s := reflect.MakeSlice(reflect.SliceOf(tb.t), len(tb.rows), len(tb.rows))
+		for i, r := range tb.rows {
+			if r.IsValid() {
+				s.Index(i).Set(r)
+			}
+		}
+		return s
+	case 1:
+		s := reflect.MakeSlice(reflect.SliceOf(reflect.PtrTo(tb.t)), len(tb.rows), len(tb.rows))
+		for i, r := range tb.rows {
+			if r.IsValid() {
+				p := reflect.New(tb.t)
+				p.Elem().Set(r)
+				s.Index(i).Set(p)
+			}
+		}
+		return s
+	}
+	a := reflect.New(reflect.ArrayOf(len(tb.rows), tb.t)).Elem()
+	for i, r := range tb.rows {
+		if r.IsValid() {
+			a.Index(i).Set(r)
+		}
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelMarshalWritesTheModelCells: Marshal of a []T, []*T or [k]T (passed by value or by
+// pointer) is exactly the hand-written header and the modelled cells written by encoding/csv;
+// MarshalWithoutHeaders is the rows alone.
+func TestHegelMarshalWritesTheModelCells(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		kind := n(ht, 0, 2)
+		tb := genTable(ht, pick(ht, rowTypes), kind == 1)
+		if len(tb.header) != len(tb.cols) {
+			ht.Fatalf("%s: the hand-written header has %d columns, the layout %d", tb.t.Name(), len(tb.header), len(tb.cols))
+		}
+		in := tb.container(kind)
+		var arg any
+		if chance(ht, 50) {
+			p := reflect.New(in.Type())
+			p.Elem().Set(in)
+			arg = p.Interface()
+		} else {
+			arg = in.Interface()
+		}
+		c.count(fmt.Sprintf("%s/%d", tb.t.Name(), kind))
+		got, err := gocsv.MarshalString(arg)
+		if err != nil {
+			c.fail(ht, "MarshalString(%s): %v", in.Type(), err)
+			return
+		}
+		if got != tb.withHdr {
+			c.fail(ht, "MarshalString(%s):\n got  %q\n want %q", in.Type(), got, tb.withHdr)
+			return
+		}
+		got, err = gocsv.MarshalStringWithoutHeaders(arg)
+		if err != nil || got != tb.headless {
+			c.fail(ht, "MarshalStringWithoutHeaders(%s): %v\n got  %q\n want %q", in.Type(), err, got, tb.headless)
+			return
+		}
+		b, err := gocsv.MarshalBytes(arg)
+		if err != nil || string(b) != tb.withHdr {
+			c.fail(ht, "MarshalBytes differs from MarshalString: %v %q", err, b)
+		}
+	})
+}
+
+// check compares an Unmarshal result (a container value of []T or []*T, or its error) with the
+// expectation.
+func (c *collector) check(ht *hegel.T, what string, tb *table, ex expected, got reflect.Value, err error, firstLine int) {
+	if ex.line > 0 {
+		if err == nil {
+			c.fail(ht, "%s: no error, want one at line %d column %d\n text %q", what, ex.line, ex.col, tb.withHdr)
+			return
+		}
+		var pe *csv.ParseError
+		if errors.As(err, &pe) {
+			if pe.Line != ex.line || pe.Column != ex.col {
+				c.fail(ht, "%s: error at line %d column %d, want line %d column %d: %v", what, pe.Line, pe.Column, ex.line, ex.col, err)
+			}
+		}
+		return
+	}
+	if err != nil {
+		c.fail(ht, "%s: %v\n text %q", what, err, tb.withHdr)
+		return
+	}
+	if got.Len() != len(ex.rows) {
+		c.fail(ht, "%s: %d rows, want %d\n text %q", what, got.Len(), len(ex.rows), tb.withHdr)
+		return
+	}
+	for i := range ex.rows {
+		g := got.Index(i)
+		if g.Kind() == reflect.Ptr {
+			if g.IsNil() {
+				c.fail(ht, "%s: row %d is nil", what, i)
+				return
+			}
+			g = g.Elem()
+		}
+		if !same(g, ex.rows[i]) {
+			c.fail(ht, "%s: row %d\n got  %s\n want %s\n text %q", what, i, show(g), show(ex.rows[i]), tb.withHdr)
+			return
+		}
+	}
+}
+
+// TestHegelUnmarshalInvertsMarshal: every Unmarshal entry point reads Marshal's output back to
+// the model's rows (pointers allocated, omitempty and default= applied, csv[] slices padded,
+// CRLF normalised by encoding/csv), or fails at the modelled row and column.
+func TestHegelUnmarshalInvertsMarshal(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tb := genTable(ht, pick(ht, rowTypes), true)
+		ex := tb.expect(true, 2)
+		if ex.line > 0 {
+			c.count("error-row")
+		} else {
+			c.count("ok")
+		}
+		sliceT := reflect.SliceOf(tb.t)
+		slicePT := reflect.SliceOf(reflect.PtrTo(tb.t))
+
+		// UnmarshalString into []T
+		out := reflect.New(sliceT)
+		err := gocsv.UnmarshalString(tb.withHdr, out.Interface())
+		c.check(ht, "UnmarshalString []T", tb, ex, out.Elem(), err, 2)
+
+		// UnmarshalBytes into []*T
+		out = reflect.New(slicePT)
+		err = gocsv.UnmarshalBytes([]byte(tb.withHdr), out.Interface())
+		c.check(ht, "UnmarshalBytes []*T", tb, ex, out.Elem(), err, 2)
+
+		// UnmarshalCSV with a plain csv.Reader
+		out = reflect.New(sliceT)
+		err = gocsv.UnmarshalCSV(csv.NewReader(strings.NewReader(tb.withHdr)), out.Interface())
+		c.check(ht, "UnmarshalCSV []T", tb, ex, out.Elem(), err, 2)
+
+		// UnmarshalDecoder
+		out = reflect.New(slicePT)
+		err = gocsv.UnmarshalDecoder(gocsv.NewSimpleDecoderFromCSVReader(csv.NewReader(strings.NewReader(tb.withHdr))), out.Interface())
+		c.check(ht, "UnmarshalDecoder []*T", tb, ex, out.Elem(), err, 2)
+
+		// Unmarshal into an exactly sized array
+		if ex.line == 0 {
+			arr := reflect.New(reflect.ArrayOf(len(tb.rows), tb.t))
+			err = gocsv.UnmarshalString(tb.withHdr, arr.Interface())
+			c.check(ht, "UnmarshalString [k]T", tb, ex, arr.Elem(), err, 2)
+		}
+
+		// UnmarshalToChan: the rows arrive in order, the channel is closed
+		ch := reflect.MakeChan(reflect.ChanOf(reflect.BothDir, tb.t), 64)
+		err = gocsv.UnmarshalToChan(strings.NewReader(tb.withHdr), ch.Interface())
+		c.check(ht, "UnmarshalToChan", tb, ex, drain(ch, sliceT), err, 2)
+
+		// UnmarshalToCallback and its WithError variant
+		got := reflect.MakeSlice(sliceT, 0, 4)
+		fn := reflect.MakeFunc(reflect.FuncOf([]reflect.Type{tb.t}, nil, false), func(args []reflect.Value) []reflect.Value {
+			got = reflect.Append(got, args[0])
+			return nil
+		})
+		err = gocsv.UnmarshalStringToCallback(tb.withHdr, fn.Interface())
+		c.check(ht, "UnmarshalStringToCallback", tb, ex, got, err, 2)
+		got = reflect.MakeSlice(sliceT, 0, 4)
+		errT := reflect.TypeOf((*error)(nil)).Elem()
+		fnE := reflect.MakeFunc(reflect.FuncOf([]reflect.Type{tb.t}, []reflect.Type{errT}, false), func(args []reflect.Value) []reflect.Value {
+			got = reflect.Append(got, args[0])
+			return []reflect.Value{reflect.Zero(errT)}
+		})
+		err = gocsv.UnmarshalStringToCallbackWithError(tb.withHdr, fnE.Interface())
+		c.check(ht, "UnmarshalStringToCallbackWithError", tb, ex, got, err, 2)
+
+		// The Unmarshaller type: NewUnmarshaller then Read until io.EOF
+		um, err := gocsv.NewUnmarshaller(csv.NewReader(strings.NewReader(tb.withHdr)), reflect.New(tb.t).Elem().Interface())
+		if err != nil {
+			c.fail(ht, "NewUnmarshaller: %v", err)
+			return
+		}
+		got = reflect.MakeSlice(sliceT, 0, 4)
+		var umErr error
+		for {
+			v, err := um.Read()
+			if err != nil {
+				if err.Error() != "EOF" {
+					umErr = err
+				}
+				break
+			}
+			got = reflect.Append(got, reflect.ValueOf(v))
+		}
+		if ex.line > 0 {
+			if umErr == nil {
+				c.fail(ht, "Unmarshaller.Read: no error, want one for row %d", ex.line-2)
+			}
+		} else {
+			c.check(ht, "Unmarshaller.Read", tb, ex, got, umErr, 2)
+		}
+
+		// The headerless family reads MarshalWithoutHeaders' output positionally (an empty
+		// text is ErrEmptyCSVFile for the slice paths, no rows for the channel path).
+		exH := tb.expect(!Known.headerlessIgnoresDefault, 1)
+		out = reflect.New(sliceT)
+		err = gocsv.UnmarshalWithoutHeaders(strings.NewReader(tb.headless), out.Interface())
+		if len(tb.cells) == 0 {
+			if !errors.Is(err, gocsv.ErrEmptyCSVFile) {
+				c.fail(ht, "UnmarshalWithoutHeaders of an empty text: %v, want ErrEmptyCSVFile", err)
+			}
+		} else {
+			c.check(ht, "UnmarshalWithoutHeaders []T", tb, exH, out.Elem(), err, 1)
+			out = reflect.New(slicePT)
+			err = gocsv.UnmarshalCSVWithoutHeaders(csv.NewReader(strings.NewReader(tb.headless)), out.Interface())
+			c.check(ht, "UnmarshalCSVWithoutHeaders []*T", tb, exH, out.Elem(), err, 1)
+		}
+		exC := exH
+		if exC.line > 0 && Known.headerlessChanLineOffByOne {
+			exC.line++
+		}
+
+		// UnmarshalToChanWithoutHeaders; sometimes with an extra column, which the slice path
+		// ignores.
+		text := tb.headless
+		extra := chance(ht, 20) && len(tb.cells) > 0
+		if extra {
+			rows := make([][]string, len(tb.cells))
+			for i, r := range tb.cells {
+				rows[i] = append(append([]string{}, r...), "extra")
+			}
+			text = writeCSV(rows)
+			out = reflect.New(sliceT)
+			err = gocsv.UnmarshalWithoutHeaders(strings.NewReader(text), out.Interface())
+			c.check(ht, "UnmarshalWithoutHeaders []T with an extra column", tb, exH, out.Elem(), err, 1)
+		}
+		if extra && Known.headerlessChanPanics {
+			c.count("extra-column-gated")
+		} else {
+			ch = reflect.MakeChan(reflect.ChanOf(reflect.BothDir, tb.t), 64)
+			err = gocsv.UnmarshalToChanWithoutHeaders(strings.NewReader(text), ch.Interface())
+			c.check(ht, "UnmarshalToChanWithoutHeaders", tb, exC, drain(ch, sliceT), err, 1)
+		}
+
+		// Unmarshal into a slice that is already longer than the CSV.
+		if ex.line == 0 && chance(ht, 30) {
+			pre := reflect.MakeSlice(sliceT, len(tb.rows)+n(ht, 1, 2), len(tb.rows)+2)
+			for i := 0; i < pre.Len(); i++ {
+				pre.Index(i).Set(genValue(ht, tb.t, 0))
+			}
+			out = reflect.New(sliceT)
+			out.Elem().Set(pre)
+			err = gocsv.UnmarshalString(tb.withHdr, out.Interface())
+			if Known.staleSliceElements {
+				c.count("stale-gated")
+				if err == nil && out.Elem().Len() >= len(tb.rows) {
+					c.check(ht, "UnmarshalString into a longer slice (first rows)", tb, ex, out.Elem().Slice(0, len(tb.rows)), err, 2)
+				}
+			} else {
+				c.check(ht, "UnmarshalString into a longer slice", tb, ex, out.Elem(), err, 2)
+			}
+		}
+	})
+}
+
+// drain collects a closed channel's values into a slice of the given type.
+func drain(ch reflect.Value, sliceT reflect.Type) reflect.Value {
+	got := reflect.MakeSlice(sliceT, 0, 4)
+	for {
+		v, ok := ch.TryRecv()
+		if !ok {
+			return got
+		}
+		got = reflect.Append(got, v)
+	}
+}
