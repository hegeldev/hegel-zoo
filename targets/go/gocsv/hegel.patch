+
+// cellAgrees checks that gocsv decodes the cell into column j of Cells as the model does, or
+// errors as it does.
+func cellAgrees(ht *hegel.T, c *collector, j int, cell string, bug string) {
+	text := writeCSV([][]string{{"z", cellsHeader[j]}, {"x", cell}})
+	var got []Cells
+	err := gocsv.UnmarshalString(text, &got)
+	want := reflect.New(cellsT).Elem()
+	want.Field(0).SetString("x")
+	modelErr := decodeInto(want, cellsCols[j], cell, true)
+	switch {
+	case modelErr != nil && err != nil:
+		c.count("error")
+	case modelErr == nil && err == nil && len(got) == 1 && same(reflect.ValueOf(got[0]), want):
+		c.count("ok")
+	default:
+		c.mismatch(ht, shapesOf(bug), "%s=%q: gocsv %s (%v), model %s (%v)", cellsHeader[j], cell, showErr(got, err), err, show(want), modelErr)
+	}
+}
