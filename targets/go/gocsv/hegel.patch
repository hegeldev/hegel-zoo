+func (d defaultCase) cells() [][]string {
+	cols := layout(dfltT)
+	out := make([][]string, len(d.rows))
+	for i, r := range d.rows {
+		out[i] = cellsOf(r, cols)
+		if noKnown {
+			for _, j := range defaultedCols {
+				if out[i][j] == "" {
+					out[i][j] = "1"
+				}
+			}
+		}
+	}
+	if !noKnown {
+		out[d.blankRow%len(d.rows)][defaultedCols[d.blankCol%len(defaultedCols)]] = ""
+	}
+	return out
+}
