+package gocsv_test
+
+// Header matching, cell conversions, csv[] columns and the map helpers against the model.
+
+import (
+	"encoding/csv"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/gocarina/gocsv"
+	"testing"
+)
+
+// --------------------------------------------------------------------------- header matching
+
+type Hdr struct {
+	A string `csv:"a"`
+	B string `csv:"b,bb"`
+	C string `csv:"c,partial"`
+	D string
+	E string `csv:"e,default=dE"`
+}
+
+var hdrHeader = "a,b,c,D,e"
+
+type hfield struct {
+	keys    []string
+	partial bool
+	dflt    string
+}
+
+func hdrFields(norm func(string) string) []hfield {
+	return []hfield{
+		{[]string{norm("a")}, false, ""},
+		{[]string{norm("b"), norm("bb")}, false, ""},
+		{[]string{norm("c")}, true, ""},
+		{[]string{norm("D")}, false, ""},
+		{[]string{norm("e")}, false, "dE"},
+	}
+}
+
+var zeroWidth = strings.NewReplacer("\u200b", "", "\ufeff", "", "\u200d", "", "\u200c", "")
+
+// matches: the documented column-to-field match: the header equals a key, or does after
+// trimming spaces or removing zero-width characters, or contains it for a partial field.
+func matches(h string, f hfield) bool {
+	for _, k := range f.keys {
+		if h == k || strings.TrimSpace(h) == k || zeroWidth.Replace(h) == k || (f.partial && strings.Contains(h, k)) {
+			return true
+		}
+	}
+	return false
+}
+
+// exactly: the header equals a key (what FailIfUnmatchedStructTags and Mismatched* use).
+func exactly(h string, f hfield) bool {
+	for _, k := range f.keys {
+		if h == k {
+			return true
+		}
+	}
+	return false
+}
+
+// mapColumns: field index of every column or -1; with align, the n-th duplicate header takes the
+// n-th matching field.
+func mapColumns(hdr []string, fields []hfield, align bool) []int {
+	out := make([]int, len(hdr))
+	count := map[string]int{}
+	for i, h := range hdr {
+		out[i] = -1
+		matched := 0
+		for fi, f := range fields {
+			if matches(h, f) {
+				if matched >= count[h] {
+					out[i] = fi
+					break
+				}
+				matched++
+			}
+		}
+		if out[i] >= 0 && align {
+			count[h]++
+		}
+	}
+	return out
+}
+
+var normalizers = []struct {
+	name string
+	fn   func(string) string
+}{
+	{"identity", func(s string) string { return s }},
+	{"lower", strings.ToLower},
+}
+
+// hdrCol is one column of a drawn header: a key of the struct or an unrelated name, dressed by
+// a decoration: as written, in the other case, padded with a space on the left or the right,
+// behind a BOM, beside a zero-width character, or inside a longer name (a superstring, a suffix,
+// the name twice: what the partial field c matches). The padded, zero-width and superstring
+// forms are matched by the column mapping but not counted by FailIfUnmatchedStructTags and
+// the Unmarshaller's lists (gocsv/10), so under HEGEL_NO_KNOWN=1 only the plain and other-case
+// forms are drawn.
+type hdrCol struct {
+	base, deco string
+}
+
+func (h hdrCol) render() string {
+	switch h.deco {
+	case "case":
+		if strings.ToUpper(h.base) == h.base {
+			return strings.ToLower(h.base)
+		}
+		return strings.ToUpper(h.base)
+	case "padL":
+		return " " + h.base
+	case "padR":
+		return h.base + " "
+	case "bom":
+		return "\uFEFF" + h.base
+	case "zwAfter":
+		return h.base + "\u200b"
+	case "zwBefore":
+		return "\u200d" + h.base
+	case "super":
+		return "x" + h.base + "x"
+	case "suffix":
+		return h.base + "_"
+	case "double":
+		return h.base + h.base
+	}
+	return h.base
+}
+
+var (
+	hdrBases   = pick("a", "b", "bb", "c", "D", "e", "zz", "", "b b", "d", "E", "x")
+	plainDecos = []string{"", "", "", "case"}
+	fuzzyDecos = []string{"padL", "padR", "bom", "zwAfter", "zwBefore", "super", "suffix", "double"}
+	hdrDecos   = shaped(
+		weighted(choice[string]{85, hegel.SampledFrom(plainDecos)}, choice[string]{15, hegel.SampledFrom(fuzzyDecos)}),
+		hegel.SampledFrom(plainDecos))
+	hdrCols = hegel.Composite(func(tc hegel.TestCase) hdrCol {
+		return hdrCol{base: hegel.Draw(tc, hdrBases), deco: hegel.Draw(tc, hdrDecos)}
+	})
+	// hdrValues: the cells under a drawn header, without a carriage return (one at a cell's end
+	// would be a CRLF line end to encoding/csv).
+	hdrValues = hegel.Map(texts, func(s string) string { return strings.ReplaceAll(s, "\r", "") })
+)
+
+// headerCase: the normalizer and the three switches, two to six header columns (one column
+// alone could be a lone empty cell, which is an empty line to encoding/csv) and one or two rows.
+type headerCase struct {
+	normalizer                       int
+	align, failDouble, failUnmatched bool
+	cols                             []hdrCol
+	rows                             [][]string
+}
+
+func (h headerCase) header() []string {
+	out := make([]string, len(h.cols))
+	for i, c := range h.cols {
+		out[i] = c.render()
+	}
+	return out
+}
+
+func (h headerCase) GoString() string {
+	return fmt.Sprintf("%s align=%v failDouble=%v failUnmatched=%v header %q rows %q",
+		normalizers[h.normalizer].name, h.align, h.failDouble, h.failUnmatched, h.header(), h.rows)
+}
+
+var headerCases = hegel.Composite(func(tc hegel.TestCase) headerCase {
+	cols := hegel.Draw(tc, many(hdrCols, 2, 6))
+	return headerCase{
+		normalizer:    hegel.Draw(tc, hegel.Integers(0, 1)),
+		align:         hegel.Draw(tc, chance(30)),
+		failDouble:    hegel.Draw(tc, chance(30)),
+		failUnmatched: hegel.Draw(tc, chance(30)),
+		cols:          cols,
+		rows:          hegel.Draw(tc, many(many(hdrValues, len(cols), len(cols)), 1, 2)),
+	}
+})
+
+// TestHegelHeadersMatchTheModel: columns are mapped to fields by the documented rules (exact,
+// trimmed, zero-width characters removed, partial, alternative keys, the normalizer), later
+// duplicates overwrite unless ShouldAlignDuplicateHeadersWithStructFieldOrder; default= fills
+// empty cells; FailIfDoubleHeaderNames and FailIfUnmatchedStructTags error as documented; the
+// Unmarshaller reports the same mapping, its mismatches and the unmatched cells. A header
+// matched only after trimming counts as matched for FailIfUnmatchedStructTags and the
+// Unmarshaller's lists (gocsv/10).
+func TestHegelHeadersMatchTheModel(t *testing.T) {
+	resetGlobals(t)
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		hc := hegel.Draw(ht, headerCases)
+		nz := normalizers[hc.normalizer]
+		gocsv.SetHeaderNormalizer(nz.fn)
+		gocsv.ShouldAlignDuplicateHeadersWithStructFieldOrder = hc.align
+		gocsv.FailIfDoubleHeaderNames = hc.failDouble
+		gocsv.FailIfUnmatchedStructTags = hc.failUnmatched
+		c.count("normalizer=" + nz.name)
+		fields := hdrFields(nz.fn)
+
+		hdr := hc.header()
+		normHdr := make([]string, len(hdr))
+		for i, h := range hdr {
+			normHdr[i] = nz.fn(h)
+		}
+		rows := hc.rows
+		text := writeCSV(append([][]string{hdr}, rows...))
+		mapping := mapColumns(normHdr, fields, hc.align)
+
+		// Which fields are matched, by the mapping rules and by exact equality.
+		fuzzyOnly := false
+		unmatchedFields := 0
+		for _, f := range fields {
+			exact, fuzzy := false, false
+			for _, h := range normHdr {
+				exact = exact || exactly(h, f)
+				fuzzy = fuzzy || matches(h, f)
+			}
+			if fuzzy && !exact {
+				fuzzyOnly = true
+			}
+			if !fuzzy {
+				unmatchedFields++
+			}
+		}
+		fuzzyCols := false
+		for _, h := range normHdr {
+			exact, fuzzy := false, false
+			for _, f := range fields {
+				exact = exact || exactly(h, f)
+				fuzzy = fuzzy || matches(h, f)
+			}
+			if fuzzy && !exact {
+				fuzzyCols = true
+			}
+		}
+		dup := false
+		seen := map[string]bool{}
+		for _, h := range normHdr {
+			if seen[h] {
+				dup = true
+			}
+			seen[h] = true
+		}
+
+		// Expected rows.
+		want := make([]Hdr, len(rows))
+		for i, row := range rows {
+			v := reflect.ValueOf(&want[i]).Elem()
+			for j, cell := range row {
+				if mapping[j] < 0 {
+					continue
+				}
+				if cell == "" {
+					cell = fields[mapping[j]].dflt
+				}
+				v.Field(mapping[j]).SetString(cell)
+			}
+		}
+
+		var got []Hdr
+		err := gocsv.UnmarshalString(text, &got)
+		switch {
+		case hc.failUnmatched && unmatchedFields > 0:
+			c.count("unmatched-error")
+			if !errors.Is(err, gocsv.ErrUnmatchedStructTags) {
+				c.fail(ht, "FailIfUnmatchedStructTags with header %q: %v, want ErrUnmatchedStructTags", hdr, err)
+			}
+			return
+		case hc.failUnmatched && fuzzyOnly:
+			// Every field is matched, one of them only after trimming: no error is documented
+			// (gocsv/10: skipped under HEGEL_NO_KNOWN=1).
+			if Known.fuzzyMatchNotCounted {
+				c.count("fuzzy-gated")
+				return
+			}
+			c.count("fuzzy-matched")
+			if err != nil {
+				c.mismatch(ht, []string{"gocsv/10"}, "FailIfUnmatchedStructTags with header %q: %v, every field is matched (one only after trimming)", hdr, err)
+				return
+			}
+		case hc.failDouble && dup:
+			c.count("double-error")
+			if !errors.Is(err, gocsv.ErrDoubleHeaderNames) {
+				c.fail(ht, "FailIfDoubleHeaderNames with header %q: %v, want ErrDoubleHeaderNames", hdr, err)
+			}
+			return
+		}
+		c.count("ok")
+		if err != nil {
+			c.fail(ht, "UnmarshalString with header %q: %v", hdr, err)
+			return
+		}
+		if !reflect.DeepEqual(got, want) {
+			c.fail(ht, "header %q (normalizer %s, align %v):\n got  %+v\n want %+v\n text %q", hdr, nz.name, hc.align, got, want, text)
+			return
+		}
+
+		// The Unmarshaller: same rows, plus the mismatch lists (the columns and fields the
+		// mapping rules leave unmatched: gocsv/10 lists the trimmed ones too) and the
+		// unmatched cells.
+		um, err := gocsv.NewUnmarshaller(csv.NewReader(strings.NewReader(text)), Hdr{})
+		if err != nil {
+			c.fail(ht, "NewUnmarshaller with header %q: %v", hdr, err)
+			return
+		}
+		var listShapes []string
+		if fuzzyOnly || fuzzyCols {
+			listShapes = []string{"gocsv/10"}
+		}
+		if (fuzzyOnly || fuzzyCols) && Known.fuzzyMatchNotCounted {
+			c.count("mismatch-lists-gated")
+		} else {
+			var wantMH, wantMF []string
+			for _, h := range normHdr {
+				found := false
+				for _, f := range fields {
+					found = found || matches(h, f)
+				}
+				if !found {
+					wantMH = append(wantMH, h)
+				}
+			}
+			for _, f := range fields {
+				found := false
+				for _, h := range normHdr {
+					found = found || matches(h, f)
+				}
+				if !found {
+					wantMF = append(wantMF, f.keys...)
+				}
+			}
+			if !slices.Equal(um.MismatchedHeaders, wantMH) || !slices.Equal(um.MismatchedStructFields, wantMF) {
+				c.mismatch(ht, listShapes, "Unmarshaller mismatches with header %q: headers %q fields %q, want %q and %q", hdr, um.MismatchedHeaders, um.MismatchedStructFields, wantMH, wantMF)
+				return
+			}
+		}
+		for i, row := range rows {
+			v, unmatched, err := um.ReadUnmatched()
+			if err != nil {
+				c.fail(ht, "ReadUnmatched row %d: %v", i, err)
+				return
+			}
+			if !reflect.DeepEqual(v, want[i]) {
+				c.fail(ht, "ReadUnmatched row %d: %+v, want %+v", i, v, want[i])
+				return
+			}
+			wantU := map[string]string{}
+			for j, cell := range row {
+				if mapping[j] < 0 {
+					wantU[normHdr[j]] = cell
+				}
+			}
+			if !reflect.DeepEqual(unmatched, wantU) {
+				c.fail(ht, "ReadUnmatched row %d unmatched: %q, want %q", i, unmatched, wantU)
+				return
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- cell conversions
+
+type Cells struct {
+	Z   string   `csv:"z"`
+	B   bool     `csv:"b"`
+	I8  int8     `csv:"i8"`
+	I16 int16    `csv:"i16"`
+	I32 int32    `csv:"i32"`
+	I64 int64    `csv:"i64"`
+	U8  uint8    `csv:"u8"`
+	U16 uint16   `csv:"u16"`
+	U32 uint32   `csv:"u32"`
+	U64 uint64   `csv:"u64"`
+	F32 float32  `csv:"f32"`
+	F64 float64  `csv:"f64"`
+	PI8 *int8    `csv:"pi8"`
+	PU8 *uint8   `csv:"pu8"`
+	PF  *float32 `csv:"pf"`
+	PB  *bool    `csv:"pb"`
+}
+
+var cellsHeader = strings.Split("z,b,i8,i16,i32,i64,u8,u16,u32,u64,f32,f64,pi8,pu8,pf,pb", ",")
+
+var cellWords = []string{"yes", "no", "YES", "No", " yes ", "true", "false", "t", "f", "T", "F", "1", "0", "on", "off", "", "  ", "NaN", "Inf", "-Inf", "+Inf", "inf", "nan", "infinity"}
+var cellGarbage = []string{"1a", "0x1f", "1_000", "+", "-", ".", "1.", ".5", "-.5", "\uFF11", "1e", "e1", "--1", "+-1", "0b1", "1 2", "1,5", "1.2.3", "0.5.", "1e5.5"}
+
+// digits is a run of lo to hi decimal digits.
+func digits(lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet("0123456789").MinSize(lo).MaxSize(hi)
+}
+
+// A numeric-looking cell: an optional sign, a digit run of any width (wider than the narrow
+// integer fields most of the time: gocsv/4), an optional fraction with a dot or a decimal comma
+// (gocsv/5 for the uint fields), an optional exponent (gocsv/6 for float32 when it is large),
+// sometimes padded with blanks; or one of the bool words and NaN/Inf spellings, or garbage.
+var (
+	signs    = maybe(20, pick("-", "+"))
+	fraction = maybe(40, cat(weighted(choice[string]{85, lit(".")}, choice[string]{15, lit(",")}), digits(0, 8)))
+	exponent = maybe(20, cat(pick("e", "E"), maybe(40, pick("-", "+")), digits(1, 3)))
+	number   = cat(signs, digits(1, 22), fraction, exponent)
+	numCells = cellsAround(number, cellGarbage)
+	// cellRows: one cell per numeric column of Cells (fitting its field under HEGEL_NO_KNOWN=1).
+	cellRows = hegel.Composite(func(tc hegel.TestCase) []string {
+		out := make([]string, len(cellsHeader)-1)
+		for j := range out {
+			out[j] = hegel.Draw(tc, columnCells[j+1])
+		}
+		return out
+	})
+	columnCells = func() []hegel.Generator[string] {
+		t := reflect.TypeOf(Cells{})
+		out := make([]hegel.Generator[string], t.NumField())
+		for j := range out {
+			out[j] = shaped(numCells, fittingCells(t.Field(j).Type))
+		}
+		return out
+	}()
+)
+
+// cellsAround is a number cell, the same padded with blanks, a bool word or garbage.
+func cellsAround(num hegel.Generator[string], garbage []string) hegel.Generator[string] {
+	return weighted(
+		choice[string]{68, num},
+		choice[string]{12, cat(pick(" ", "\t", "  "), num, pick("", " ", "\n"))},
+		choice[string]{10, hegel.SampledFrom(cellWords)},
+		choice[string]{10, hegel.SampledFrom(garbage)},
+	)
+}
+
+// fittingCells is the cells beside the bugs' regions for a field of the type: the digits of an
+// integer bounded by the field's width (gocsv/4), no dot at all for an unsigned one (gocsv/5), a
+// float32's mantissa and exponent bounded by its range (gocsv/6); any cell for the others.
+func fittingCells(t reflect.Type) hegel.Generator[string] {
+	if t.Kind() == reflect.Ptr {
+		t = t.Elem()
+	}
+	// The decimal width of the largest value of a width in bits, signed and unsigned.
+	intDigits := map[int]int{8: 3, 16: 5, 32: 10, 64: 19}
+	uintDigits := map[int]int{8: 3, 16: 5, 32: 10, 64: 20}
+	switch t.Kind() {
+	case reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return cellsAround(cat(signs, digits(1, intDigits[t.Bits()]-1), fraction, exponent), cellGarbage)
+	case reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		var dotless []string
+		for _, g := range cellGarbage {
+			if !strings.Contains(g, ".") {
+				dotless = append(dotless, g)
+			}
+		}
+		return cellsAround(cat(signs, digits(1, uintDigits[t.Bits()]-1), exponent), dotless)
+	case reflect.Float32:
+		small := maybe(20, cat(pick("e", "E"), maybe(40, pick("-", "+")), hegel.Map(hegel.Integers(0, 30), strconv.Itoa)))
+		return cellsAround(cat(signs, digits(1, 8), fraction, small), cellGarbage)
+	}
+	return numCells
+}
+
+// gocsvUintFloatPath: what gocsv computes for a uint cell containing '.', on this machine.
+func gocsvUintFloatPath(cell string, bits int) (uint64, bool) {
+	s := strings.TrimSpace(cell)
+	if !strings.Contains(s, ".") {
+		return 0, false
+	}
+	f, err := strconv.ParseFloat(s, 64)
+	if err != nil {
+		return 0, false
+	}
+	v := reflect.New(uintType(bits)).Elem()
+	v.SetUint(uint64(f))
+	return v.Uint(), true
+}
+
+func uintType(bits int) reflect.Type {
+	switch bits {
+	case 8:
+		return reflect.TypeOf(uint8(0))
+	case 16:
+		return reflect.TypeOf(uint16(0))
+	case 32:
+		return reflect.TypeOf(uint32(0))
+	}
+	return reflect.TypeOf(uint64(0))
+}
+
+// gate classifies a cell/field pair whose gocsv result differs from the model as the shape of a
+// recorded bug - "gocsv/4" (the cell wrapped to the field's width), "gocsv/5" (a uint cell with a
+// dot through the float path), "gocsv/6" (a float32 out of range) or "gocsv/6 rounding" (a
+// float32 double-rounded through 64 bits) - or "" when it is a real mismatch. leaf is the
+// (non-pointer) field type.
+func gate(cell string, leaf reflect.Type, got reflect.Value, gotErr error, modelErr error) string {
+	s := strings.TrimSpace(cell)
+	switch leaf.Kind() {
+	case reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		if gotErr == nil && errors.Is(modelErr, strconv.ErrRange) {
+			part := strings.SplitN(s, ".", 2)[0]
+			if wide, err := strconv.ParseInt(part, 10, 64); err == nil {
+				v := reflect.New(leaf).Elem()
+				v.SetInt(wide)
+				if v.Int() == got.Int() {
+					return "gocsv/4"
+				}
+			}
+		}
+	case reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		if strings.Contains(s, ".") {
+			// gocsv parses the cell as a float: an error where the model reads the integer
+			// part, or the converted value.
+			if _, err := strconv.ParseFloat(s, 64); err != nil && gotErr != nil {
+				return "gocsv/5"
+			}
+			if u, ok := gocsvUintFloatPath(cell, leaf.Bits()); ok && gotErr == nil && u == got.Uint() {
+				return "gocsv/5"
+			}
+		}
+		if gotErr == nil && errors.Is(modelErr, strconv.ErrRange) {
+			if wide, err := strconv.ParseUint(s, 10, 64); err == nil {
+				v := reflect.New(leaf).Elem()
+				v.SetUint(wide)
+				if v.Uint() == got.Uint() {
+					return "gocsv/4"
+				}
+			}
+		}
+	case reflect.Float32:
+		if gotErr == nil {
+			f64, err := strconv.ParseFloat(strings.ReplaceAll(s, ",", "."), 64)
+			if err == nil && (float32(f64) == float32(got.Float()) || (math.IsNaN(f64) && math.IsNaN(got.Float()))) {
+				if modelErr != nil {
+					return "gocsv/6"
+				}
+				return "gocsv/6 rounding"
+			}
+		}
+	}
+	return ""
+}
+
+// steered says whether the Known switch of a gate's bug is on (HEGEL_NO_KNOWN=1): the column is
+// then counted and skipped instead of failing.
+func steered(g string) bool {
+	switch strings.Fields(g)[0] {
+	case "gocsv/4":
+		return Known.intWraps
+	case "gocsv/5":
+		return Known.uintFloatPath
+	case "gocsv/6":
+		return Known.float32Via64
+	}
+	return false
+}
+
+// TestHegelCellsDecodeLikeTheModel: every bool, integer and float field (and pointer to one)
+// decodes a random numeric-looking cell as the model does or errors as it does (a cell wider
+// than the field is an error: gocsv/4; a uint cell with a dot follows the int rule: gocsv/5; a
+// float32 cell out of range is an error: gocsv/6); a whole row errors at its first failing column
+// (ParseError line 2, that column) or decodes every field.
+func TestHegelCellsDecodeLikeTheModel(t *testing.T) {
+	c := newCollector(t)
+	cellsT := reflect.TypeOf(Cells{})
+	cols := layout(cellsT)
+	if len(cols) != len(cellsHeader) {
+		t.Fatalf("layout has %d columns, the header %d", len(cols), len(cellsHeader))
+	}
+	property(t, func(ht *hegel.T) {
+		cells := append([]string{"x"}, hegel.Draw(ht, cellRows)...)
+		// Each column alone (with the string column so that the row is never an empty line).
+		single := make([]Cells, len(cols))
+		singleErr := make([]error, len(cols))
+		for j := 1; j < len(cols); j++ {
+			text := writeCSV([][]string{{"z", cellsHeader[j]}, {"x", cells[j]}})
+			var got []Cells
+			err := gocsv.UnmarshalString(text, &got)
+			singleErr[j] = err
+			if err == nil {
+				if len(got) != 1 {
+					c.fail(ht, "%s=%q: %d rows", cellsHeader[j], cells[j], len(got))
+					return
+				}
+				single[j] = got[0]
+			}
+			want := reflect.New(cellsT).Elem()
+			want.Field(0).SetString("x")
+			modelErr := decodeInto(want, cols[j], cells[j], true)
+			leaf := cellsT.Field(j).Type
+			if leaf.Kind() == reflect.Ptr {
+				leaf = leaf.Elem()
+			}
+			var gotField reflect.Value
+			if err == nil {
+				gotField = reflect.ValueOf(got[0]).Field(j)
+				if gotField.Kind() == reflect.Ptr && !gotField.IsNil() {
+					gotField = gotField.Elem()
+				}
+			}
+			switch {
+			case modelErr != nil && err != nil:
+				c.count("error")
+			case modelErr == nil && err == nil && same(reflect.ValueOf(got[0]), want):
+				c.count("ok")
+			default:
+				g := gate(cells[j], leaf, gotField, err, modelErr)
+				if g != "" && steered(g) {
+					c.count(g + " steered")
+					continue
+				}
+				var shapes []string
+				if g != "" {
+					shapes = []string{strings.Fields(g)[0]}
+				}
+				c.mismatch(ht, shapes, "%s=%q: gocsv %s (%v), model %s (%v)", cellsHeader[j], cells[j], showErr(got, err), err, show(want), modelErr)
+			}
+		}
+		// The whole row: the first failing column decides.
+		text := writeCSV([][]string{cellsHeader, cells})
+		var got []Cells
+		err := gocsv.UnmarshalString(text, &got)
+		firstBad := -1
+		for j := 1; j < len(cols); j++ {
+			if singleErr[j] != nil {
+				firstBad = j
+				break
+			}
+		}
+		if firstBad >= 0 {
+			var pe *csv.ParseError
+			if !errors.As(err, &pe) {
+				c.fail(ht, "row %q: %v, want a ParseError at column %d", cells, err, firstBad+1)
+				return
+			}
+			if pe.Line != 2 || pe.Column != firstBad+1 {
+				c.fail(ht, "row %q: error at line %d column %d, want line 2 column %d: %v", cells, pe.Line, pe.Column, firstBad+1, err)
+			}
+			return
+		}
+		if err != nil || len(got) != 1 {
+			c.fail(ht, "row %q: %v (%d rows), every column decodes alone", cells, err, len(got))
+			return
+		}
+		want := reflect.New(cellsT).Elem()
+		want.Field(0).SetString("x")
+		for j := 1; j < len(cols); j++ {
+			want.Field(j).Set(reflect.ValueOf(single[j]).Field(j))
+		}
+		if !same(reflect.ValueOf(got[0]), want) {
+			c.fail(ht, "row %q:\n got  %s\n want %s (the columns decoded alone)", cells, show(reflect.ValueOf(got[0])), show(want))
+		}
+	})
+}
+
+func showErr(got []Cells, err error) string {
+	if err != nil {
+		return "error"
+	}
+	if len(got) == 0 {
+		return "no rows"
+	}
+	return show(reflect.ValueOf(got[0]))
+}
