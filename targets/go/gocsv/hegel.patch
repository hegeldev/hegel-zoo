+// elementsOf is up to four elements of a container of t, nil (an element of a []*T) nilPct
+// percent of the time.
+func elementsOf(t reflect.Type, nilPct int) hegel.Generator[[]reflect.Value] {
+	element := hegel.Composite(func(tc hegel.TestCase) reflect.Value {
+		v := hegel.Draw(tc, valueOf[t])
+		if hegel.Draw(tc, chance(nilPct)) {
+			return reflect.Value{}
+		}
+		return v
+	})
+	return many(element, 0, 4)
+}
+
+// rowsOf and nilRowsOf are elementsOf per type, built once (never nil, and nil 8% of the time).
+var rowsOf, nilRowsOf = func() (rows, nilRows map[reflect.Type]hegel.Generator[[]reflect.Value]) {
+	rows, nilRows = map[reflect.Type]hegel.Generator[[]reflect.Value]{}, map[reflect.Type]hegel.Generator[[]reflect.Value]{}
+	for t := range valueOf {
+		rows[t], nilRows[t] = elementsOf(t, 0), elementsOf(t, 8)
+	}
+	return
+}()
+
+// table is one container of rows with its modelled texts.
+type table struct {
+	kind     rowKind
+	cols     []col
+	rows     []reflect.Value // elements of type t; invalid Value for a nil *t element
+	cells    [][]string
+	written  string // what Marshal writes: the hand-written header and the cells
+	text     string // what the round trip reads: the read header and the cells
+	headless string
+}
+
+func tableOf(kind rowKind, rows []reflect.Value) *table {
+	cols := layout(kind.t)
+	var cells [][]string
+	for _, v := range rows {
+		if v.IsValid() {
+			cells = append(cells, cellsOf(v, cols))
+		} else {
+			cells = append(cells, make([]string, len(cols)))
+		}
+	}
+	return tableOfCells(kind, rows, cells)
+}
+
+// tableOfCells is the table of rows whose cells are given (edited after modelling).
+func tableOfCells(kind rowKind, rows []reflect.Value, cells [][]string) *table {
+	tb := &table{kind: kind, cols: layout(kind.t), rows: rows, cells: cells}
+	tb.written = writeCSV(append([][]string{kind.header()}, tb.cells...))
+	tb.text = writeCSV(append([][]string{kind.readHeader()}, tb.cells...))
+	tb.headless = writeCSV(tb.cells)
+	return tb
+}
+
+func (tb *table) GoString() string {
+	var rows []string
+	for _, r := range tb.rows {
+		rows = append(rows, show(r))
+	}
+	return fmt.Sprintf("%#v rows [%s]\n  text %q", tb.kind, strings.Join(rows, ", "), tb.text)
+}
+
+func writeCSV(rows [][]string) string {
+	var b bytes.Buffer
+	w := csv.NewWriter(&b)
+	for _, r := range rows {
+		_ = w.Write(r)
+	}
+	w.Flush()
+	return b.String()
+}
+
+// transported: what encoding/csv reads back of a written cell (CRLF at a physical line end
+// becomes LF).
+func transported(s string) string { return strings.ReplaceAll(s, "\r\n", "\n") }
+
+// expected: the rows the model reads back (as values of type t), or the first error's position.
+type expected struct {
+	rows []reflect.Value
+	line int // 1-based line of the failing row in the text, 0 when none
+	col  int // 1-based column
+}
+
+func (tb *table) expect(useDefault bool, firstLine int) expected {
+	ex := expected{}
+	for i, cells := range tb.cells {
+		tr := make([]string, len(cells))
+		for j, c := range cells {
+			tr[j] = transported(c)
+		}
+		v, j, err := decodeRow(tb.kind.t, tb.cols, tr, useDefault)
+		if err != nil {
+			ex.line, ex.col = firstLine+i, j+1
+			return ex
+		}
+		ex.rows = append(ex.rows, v)
+	}
+	return ex
+}
+
+func sameExpected(a, b expected) bool {
+	if a.line != b.line || a.col != b.col || len(a.rows) != len(b.rows) {
+		return false
+	}
+	for i := range a.rows {
+		if !same(a.rows[i], b.rows[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// container builds a []t, []*t or [k]t holding the rows (nil elements for invalid Values).
+func (tb *table) container(kind int) reflect.Value {
+	switch kind {
+	case 0:
+		s := reflect.MakeSlice(reflect.SliceOf(tb.kind.t), len(tb.rows), len(tb.rows))
+		for i, r := range tb.rows {
+			if r.IsValid() {
+				s.Index(i).Set(r)
+			}
+		}
+		return s
+	case 1:
+		s := reflect.MakeSlice(reflect.SliceOf(reflect.PtrTo(tb.kind.t)), len(tb.rows), len(tb.rows))
+		for i, r := range tb.rows {
+			if r.IsValid() {
+				p := reflect.New(tb.kind.t)
+				p.Elem().Set(r)
+				s.Index(i).Set(p)
+			}
+		}
+		return s
+	}
+	a := reflect.New(reflect.ArrayOf(len(tb.rows), tb.kind.t)).Elem()
+	for i, r := range tb.rows {
+		if r.IsValid() {
+			a.Index(i).Set(r)
+		}
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- Marshal
+
+// marshalCase: a kind of rows in a []T, []*T (nil elements allowed) or [k]T, passed by value
+// or by pointer.
+type marshalCase struct {
+	kind      rowKind
+	container int // 0: []T, 1: []*T, 2: [k]T
+	byPtr     bool
+	tb        *table
+}
+
+var containerNames = []string{"[]T", "[]*T", "[k]T"}
+
+func (m marshalCase) GoString() string {
+	return fmt.Sprintf("%s byPtr=%v %#v", containerNames[m.container], m.byPtr, m.tb)
+}
+
+var marshalCases = hegel.Composite(func(tc hegel.TestCase) marshalCase {
+	kind := hegel.Draw(tc, rowKinds)
+	container := hegel.Draw(tc, hegel.Integers(0, 2))
+	rows := rowsOf[kind.t]
+	if container == 1 {
+		rows = nilRowsOf[kind.t]
+	}
+	return marshalCase{kind: kind, container: container, byPtr: hegel.Draw(tc, chance(50)), tb: tableOf(kind, hegel.Draw(tc, rows))}
+})
+
+// TestHegelMarshalWritesTheModelCells: Marshal of a []T, []*T or [k]T (passed by value or by
+// pointer) is exactly the hand-written header and the modelled cells written by encoding/csv;
+// MarshalWithoutHeaders is the rows alone. A map field is modelled as JSON like a slice; gocsv
+// writes it as an empty cell (gocsv/9).
+func TestHegelMarshalWritesTheModelCells(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, marshalCases)
+		tb := m.tb
+		shapes := m.kind.shapes(tb)
+		if len(m.kind.header()) != len(tb.cols) {
+			ht.Fatalf("%s: the hand-written header has %d columns, the layout %d", m.kind.t.Name(), len(m.kind.header()), len(tb.cols))
+		}
+		in := tb.container(m.container)
+		var arg any
+		if m.byPtr {
+			p := reflect.New(in.Type())
+			p.Elem().Set(in)
+			arg = p.Interface()
+		} else {
+			arg = in.Interface()
+		}
+		c.count(fmt.Sprintf("%s/%s", m.kind.t.Name(), containerNames[m.container]))
+		got, err := gocsv.MarshalString(arg)
+		if err != nil {
+			c.mismatch(ht, shapes, "MarshalString(%s): %v", in.Type(), err)
+			return
+		}
+		if got != tb.written {
+			c.mismatch(ht, shapes, "MarshalString(%s):\n got  %q\n want %q", in.Type(), got, tb.written)
+			return
+		}
+		got, err = gocsv.MarshalStringWithoutHeaders(arg)
+		if err != nil || got != tb.headless {
+			c.mismatch(ht, shapes, "MarshalStringWithoutHeaders(%s): %v\n got  %q\n want %q", in.Type(), err, got, tb.headless)
+			return
+		}
+		b, err := gocsv.MarshalBytes(arg)
+		if err != nil || string(b) != tb.written {
+			c.mismatch(ht, shapes, "MarshalBytes differs from MarshalString: %v %q", err, b)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- the round trip
+
+// check compares an Unmarshal result (a container value of []T or []*T, or its error) with the
+// expectation; a disagreement names the case's shapes.
+func (c *collector) check(ht *hegel.T, what string, tb *table, ex expected, got reflect.Value, err error, shapes []string) {
+	if ex.line > 0 {
+		if err == nil {
+			c.mismatch(ht, shapes, "%s: no error, want one at line %d column %d\n text %q", what, ex.line, ex.col, tb.text)
+			return
+		}
+		var pe *csv.ParseError
+		if errors.As(err, &pe) {
+			if pe.Line != ex.line || pe.Column != ex.col {
+				c.mismatch(ht, shapes, "%s: error at line %d column %d, want line %d column %d: %v", what, pe.Line, pe.Column, ex.line, ex.col, err)
+			}
+		}
+		return
+	}
+	if err != nil {
+		c.mismatch(ht, shapes, "%s: %v\n text %q", what, err, tb.text)
+		return
+	}
+	if got.Len() != len(ex.rows) {
+		c.mismatch(ht, shapes, "%s: %d rows, want %d\n text %q", what, got.Len(), len(ex.rows), tb.text)
+		return
+	}
+	for i := range ex.rows {
+		g := got.Index(i)
+		if g.Kind() == reflect.Ptr {
+			if g.IsNil() {
+				c.mismatch(ht, shapes, "%s: row %d is nil", what, i)
+				return
+			}
+			g = g.Elem()
+		}
+		if !same(g, ex.rows[i]) {
+			c.mismatch(ht, shapes, "%s: row %d\n got  %s\n want %s\n text %q", what, i, show(g), show(ex.rows[i]), tb.text)
+			return
+		}
+	}
+}
+
+// roundTrip: a table (nil elements allowed), whether the headerless text gets an extra column
+// (gocsv/3 on the channel path), and a pre-filled target slice longer than the rows by `longer`
+// (gocsv/11; 0: a fresh slice).
+type roundTrip struct {
+	kind   rowKind
+	tb     *table
+	extra  bool
+	longer int
+	pre    []reflect.Value
+}
+
+func (rt roundTrip) GoString() string {
+	return fmt.Sprintf("extra=%v longer=%d %#v", rt.extra, rt.longer, rt.tb)
+}
+
+// extras and longers: the extra column (gocsv/3) and the longer pre-filled slice (gocsv/11) are
+// not drawn under HEGEL_NO_KNOWN=1.
+var (
+	extras     = shaped(chance(20), hegel.Just(false))
+	longers    = shaped(weighted(choice[int]{7, hegel.Just(0)}, choice[int]{3, hegel.Integers(1, 2)}), hegel.Just(0))
+	roundTrips = hegel.Composite(func(tc hegel.TestCase) roundTrip {
+		kind := hegel.Draw(tc, rowKinds)
+		tb := tableOf(kind, hegel.Draw(tc, nilRowsOf[kind.t]))
+		rt := roundTrip{kind: kind, tb: tb, extra: hegel.Draw(tc, extras), longer: hegel.Draw(tc, longers)}
+		if rt.longer > 0 {
+			n := len(tb.rows) + rt.longer
+			rt.pre = hegel.Draw(tc, many(valueOf[kind.t], n, n))
+		}
+		return rt
+	})
+)
+
+// withExtra is the headerless text with one more cell on every row.
+func withExtra(cells [][]string) string {
+	rows := make([][]string, len(cells))
+	for i, r := range cells {
+		rows[i] = append(append([]string{}, r...), "extra")
+	}
+	return writeCSV(rows)
+}
+
+// TestHegelUnmarshalInvertsMarshal: every Unmarshal entry point reads the modelled text back to
+// the model's rows (pointers allocated, omitempty and default= applied, csv[] slices padded,
+// CRLF normalised by encoding/csv), or fails at the modelled row and column; the headerless
+// family reads the headerless text positionally, with default= applied (gocsv/14), errors on
+// the line they are on (gocsv/15) and extra columns ignored (gocsv/3); an empty text is
+// ErrEmptyCSVFile; a longer pre-filled slice is replaced (gocsv/11). The row kinds with an
+// interface{} (gocsv/2), a multi-key nested field read through its second key (gocsv/7), an
+// array (gocsv/8), a map (gocsv/9) or a Duration field (gocsv/13) read back as the model says.
+func TestHegelUnmarshalInvertsMarshal(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		rt := hegel.Draw(ht, roundTrips)
+		tb := rt.tb
+		shapes := rt.kind.shapes(tb)
+		ex := tb.expect(true, 2)
+		c.count(rt.kind.t.Name())
+		if ex.line > 0 {
+			c.count("error-row")
+		} else {
+			c.count("ok")
+		}
+		sliceT := reflect.SliceOf(tb.kind.t)
+		slicePT := reflect.SliceOf(reflect.PtrTo(tb.kind.t))
+
+		// call runs an entry point; once one has panicked (gocsv/2 panics in every one) the
+		// rest of the case is skipped, since the callback entry points run UnmarshalToChan in a
+		// goroutine, where a panic cannot be recovered (the first panic has failed the case
+		// already outside collect mode).
+		alive := true
+		call := func(what string, shapes []string, f func()) bool {
+			if !alive {
+				return false
+			}
+			alive = c.call(ht, what, shapes, f)
+			return alive
+		}
+		// unmarshal runs an entry point into a fresh container and checks the result.
+		unmarshal := func(what string, into reflect.Type, ex expected, shapes []string, f func(out any) error) {
+			out := reflect.New(into)
+			var err error
+			if call(what, shapes, func() { err = f(out.Interface()) }) {
+				c.check(ht, what, tb, ex, out.Elem(), err, shapes)
+			}
+		}
+		// viaChan runs a channel entry point and checks the rows it sent.
+		viaChan := func(what, text string, ex expected, shapes []string, f func(in io.Reader, ch any) error) {
+			ch := reflect.MakeChan(reflect.ChanOf(reflect.BothDir, tb.kind.t), 64)
+			var err error
+			if call(what, shapes, func() { err = f(strings.NewReader(text), ch.Interface()) }) {
+				c.check(ht, what, tb, ex, drain(ch, sliceT), err, shapes)
+			}
+		}
+		// viaCallback runs a callback entry point and checks the rows it was given.
+		viaCallback := func(what string, ex expected, shapes []string, withError bool, f func(fn any) error) {
+			got := reflect.MakeSlice(sliceT, 0, 4)
+			var fn reflect.Value
+			if withError {
+				errT := reflect.TypeOf((*error)(nil)).Elem()
+				fn = reflect.MakeFunc(reflect.FuncOf([]reflect.Type{tb.kind.t}, []reflect.Type{errT}, false), func(args []reflect.Value) []reflect.Value {
+					got = reflect.Append(got, args[0])
+					return []reflect.Value{reflect.Zero(errT)}
+				})
+			} else {
+				fn = reflect.MakeFunc(reflect.FuncOf([]reflect.Type{tb.kind.t}, nil, false), func(args []reflect.Value) []reflect.Value {
+					got = reflect.Append(got, args[0])
+					return nil
+				})
+			}
+			var err error
+			if call(what, shapes, func() { err = f(fn.Interface()) }) {
+				c.check(ht, what, tb, ex, got, err, shapes)
+			}
+		}
+
+		unmarshal("UnmarshalString []T", sliceT, ex, shapes, func(out any) error { return gocsv.UnmarshalString(tb.text, out) })
+		unmarshal("UnmarshalBytes []*T", slicePT, ex, shapes, func(out any) error { return gocsv.UnmarshalBytes([]byte(tb.text), out) })
+		unmarshal("UnmarshalCSV []T", sliceT, ex, shapes, func(out any) error {
+			return gocsv.UnmarshalCSV(csv.NewReader(strings.NewReader(tb.text)), out)
+		})
+		unmarshal("UnmarshalDecoder []*T", slicePT, ex, shapes, func(out any) error {
+			return gocsv.UnmarshalDecoder(gocsv.NewSimpleDecoderFromCSVReader(csv.NewReader(strings.NewReader(tb.text))), out)
+		})
+		if ex.line == 0 {
+			unmarshal("UnmarshalString [k]T", reflect.ArrayOf(len(tb.rows), tb.kind.t), ex, shapes, func(out any) error { return gocsv.UnmarshalString(tb.text, out) })
+		}
+		viaChan("UnmarshalToChan", tb.text, ex, shapes, gocsv.UnmarshalToChan)
+		viaCallback("UnmarshalStringToCallback", ex, shapes, false, func(fn any) error { return gocsv.UnmarshalStringToCallback(tb.text, fn) })
+		viaCallback("UnmarshalStringToCallbackWithError", ex, shapes, true, func(fn any) error { return gocsv.UnmarshalStringToCallbackWithError(tb.text, fn) })
+
+		// The Unmarshaller type: NewUnmarshaller then Read until io.EOF.
+		got := reflect.MakeSlice(sliceT, 0, 4)
+		var umErr error
+		if call("Unmarshaller.Read", shapes, func() {
+			um, err := gocsv.NewUnmarshaller(csv.NewReader(strings.NewReader(tb.text)), reflect.New(tb.kind.t).Elem().Interface())
+			if err != nil {
+				umErr = fmt.Errorf("NewUnmarshaller: %w", err)
+				return
+			}
+			for {
+				v, err := um.Read()
+				if err != nil {
+					if err.Error() != "EOF" {
+						umErr = err
+					}
+					return
+				}
+				got = reflect.Append(got, reflect.ValueOf(v))
+			}
+		}) {
+			if ex.line > 0 {
+				if umErr == nil {
+					c.mismatch(ht, shapes, "Unmarshaller.Read: no error, want one for row %d", ex.line-2)
+				}
+			} else {
+				c.check(ht, "Unmarshaller.Read", tb, ex, got, umErr, shapes)
+			}
+		}
+
+		// The headerless family reads MarshalWithoutHeaders' output positionally, applying
+		// default= to empty cells as the documentation says (gocsv/14: the model follows the
+		// code under HEGEL_NO_KNOWN=1); an empty text is ErrEmptyCSVFile for the slice paths,
+		// no rows for the channel path.
+		exH, exCode := tb.expect(true, 1), tb.expect(false, 1)
+		hShapes := shapes
+		if !sameExpected(exH, exCode) {
+			if Known.headerlessIgnoresDefault {
+				c.count("default-steered")
+				exH = exCode
+			} else {
+				hShapes = append(slices.Clone(shapes), "gocsv/14")
+			}
+		}
+		text := tb.headless
+		if rt.extra && len(tb.cells) > 0 {
+			text = withExtra(tb.cells)
+		}
+		if len(tb.cells) == 0 {
+			unmarshal("UnmarshalWithoutHeaders of an empty text", sliceT, ex, shapes, func(out any) error {
+				err := gocsv.UnmarshalWithoutHeaders(strings.NewReader(tb.headless), out)
+				if !errors.Is(err, gocsv.ErrEmptyCSVFile) {
+					return fmt.Errorf("%v, want ErrEmptyCSVFile", err)
+				}
+				return nil
+			})
+		} else {
+			unmarshal("UnmarshalWithoutHeaders []T", sliceT, exH, hShapes, func(out any) error { return gocsv.UnmarshalWithoutHeaders(strings.NewReader(tb.headless), out) })
+			unmarshal("UnmarshalCSVWithoutHeaders []*T", slicePT, exH, hShapes, func(out any) error {
+				return gocsv.UnmarshalCSVWithoutHeaders(csv.NewReader(strings.NewReader(tb.headless)), out)
+			})
+			if rt.extra {
+				unmarshal("UnmarshalWithoutHeaders []T with an extra column", sliceT, exH, hShapes, func(out any) error { return gocsv.UnmarshalWithoutHeaders(strings.NewReader(text), out) })
+			}
+		}
+		// UnmarshalToChanWithoutHeaders: the error line is the row's own (gocsv/15: the model
+		// counts a header under HEGEL_NO_KNOWN=1); an extra column is ignored as on the slice
+		// path (gocsv/3: skipped under HEGEL_NO_KNOWN=1).
+		exC, cShapes := exH, hShapes
+		if exC.line > 0 {
+			if Known.headerlessChanLineOffByOne {
+				c.count("line-steered")
+				exC.line++
+			} else {
+				cShapes = append(slices.Clone(cShapes), "gocsv/15")
+			}
+		}
+		if rt.extra && len(tb.cells) > 0 {
+			if Known.headerlessChanPanics {
+				c.count("extra-column-gated")
+				text = ""
+			} else {
+				cShapes = append(slices.Clone(cShapes), "gocsv/3")
+			}
+		}
+		if text != "" || len(tb.cells) == 0 {
+			viaChan("UnmarshalToChanWithoutHeaders", text, exC, cShapes, gocsv.UnmarshalToChanWithoutHeaders)
+		}
+
+		// Unmarshal into a slice that is already longer than the CSV: the rows and nothing else
+		// (gocsv/11: only the first rows are checked under HEGEL_NO_KNOWN=1).
+		if ex.line == 0 && rt.longer > 0 {
+			pre := reflect.MakeSlice(sliceT, len(rt.pre), len(rt.pre)+2)
+			for i, v := range rt.pre {
+				pre.Index(i).Set(v)
+			}
+			out := reflect.New(sliceT)
+			out.Elem().Set(pre)
+			var err error
+			what := "UnmarshalString into a longer slice"
+			if call(what, shapes, func() { err = gocsv.UnmarshalString(tb.text, out.Interface()) }) {
+				if Known.staleSliceElements {
+					c.count("stale-gated")
+					if err == nil && out.Elem().Len() >= len(tb.rows) {
+						c.check(ht, what+" (first rows)", tb, ex, out.Elem().Slice(0, len(tb.rows)), err, shapes)
+					}
+				} else {
+					c.check(ht, what, tb, ex, out.Elem(), err, append(slices.Clone(shapes), "gocsv/11"))
+				}
+			}
+		}
+	})
+}
+
+// drain collects a channel's values into a slice of the given type (what was sent, closed or not).
+func drain(ch reflect.Value, sliceT reflect.Type) reflect.Value {
+	got := reflect.MakeSlice(sliceT, 0, 4)
+	for {
+		v, ok := ch.TryRecv()
+		if !ok {
+			return got
+		}
+		got = reflect.Append(got, v)
+	}
+}
