--- /dev/null
+++ b/semantic/hegel/doc.go
@@ -0,0 +1,4 @@
+// Package hegel holds the Hegel property tests of osv-scalibr's semantic
+// package (see hegel_test.go); it is added by the hegel zoo's patch and has
+// no non-test code beyond the gates in known.go.
+package hegel
diff --git a/semantic/hegel/hegel_gen_test.go b/semantic/hegel/hegel_gen_test.go
new file mode 100644
index 0000000..b788a4b
--- /dev/null
+++ b/semantic/hegel/hegel_gen_test.go
@@ -0,0 +1,353 @@
+package hegel
+
+// Generators: version strings built from the pieces every ecosystem's
+// grammar knows (numbers of all sizes, the separators, the pre-release and
+// post-release words, epochs, revisions, local and build parts), shaped
+// after each ecosystem's own syntax most of the time and as free soup the
+// rest. A pair is a version and a relation to it - the same text, one or
+// two edits, or a fresh version - the edits drawn as data and applied by a
+// pure function with positions taken modulo the live length, so that the
+// comparison is decided late and the shrinker can drop an edit. Every
+// generator is a package-level value and the plain alternative comes first
+// in every choice, so a minimal case is a bare number.
+
+import (
+	"fmt"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+var (
+	numbers = []string{"0", "1", "2", "3", "9", "10", "11", "42", "100", "007", "00", "0001", "2024", "65535", "65536",
+		"4294967295", "4294967296", "9223372036854775807", "9223372036854775808", "18446744073709551616",
+		"123456789012345678901234567890"}
+	words = []string{"a", "b", "c", "rc", "RC", "alpha", "Alpha", "ALPHA", "beta", "pre", "preview", "post", "rev", "r", "dev",
+		"final", "FINAL", "ga", "GA", "sp", "cr", "milestone", "m", "M", "snapshot", "SNAPSHOT", "release", "RELEASE", "p", "pl",
+		"patch", "git", "svn", "el8", "el9", "fc39", "ubuntu1", "deb11u2", "dfsg", "build", "x", "z", "aa", "zz", "abc", "v", "V",
+		"foo", "bar", "hotfix", "nightly", "next", "canary", "latest", "stable", "unstable", "alpha1", "beta2", "rc1", "dev0", "post1",
+		"a0", "b0", "rc0", "cr1", "sp1", "ga1", "m1", "e", "d", "t", "u"}
+	seps = []string{".", "-", "_", "+", "~", "^", ":", "!", " ", "", ",", "/", "=", "@"}
+)
+
+// ---------------------------------------------------------------------------
+// Pieces.
+
+var (
+	// number: a small number most of the time, one of the edge list (leading
+	// zeros, the 32- and 64-bit boundaries, far beyond them) three times in
+	// ten (a weighted table, not a range: hegel-go enumerates small ranges and
+	// magnitude-biases large ones).
+	smallNumber = pick("0", "1", "2", "3", "4", "5", "9", "10", "12", "20", "99")
+	number      = weighted(choice[string]{7, smallNumber}, choice[string]{3, hegel.SampledFrom(numbers)})
+	// word: a word of the list as written, upper-cased or title-cased one
+	// time in twenty each.
+	listedWord = hegel.SampledFrom(words)
+	word       = weighted(
+		choice[string]{18, listedWord},
+		choice[string]{1, hegel.Map(listedWord, strings.ToUpper)},
+		choice[string]{1, hegel.Map(listedWord, strings.Title)}, //nolint:staticcheck // ASCII words
+	)
+	separator = hegel.SampledFrom(seps)
+	// piece: what soup is made of, and what the insert edit puts in.
+	piece = weighted(choice[string]{4, number}, choice[string]{3, word}, choice[string]{3, separator})
+	// soup: one to seven pieces, free of any grammar.
+	soup = joined(many(piece, 1, 7), "")
+)
+
+// dotted is N(.N)* of lo to hi numbers.
+func dotted(lo, hi int) hegel.Generator[string] { return joined(many(number, lo, hi), ".") }
+
+// ---------------------------------------------------------------------------
+// Shaped versions, one generator per ecosystem family: a concatenation of
+// optional parts, each absent first.
+
+var (
+	sep4   = pick("", ".", "-", "_")
+	blanks = pick(" ", "\t", "\n")
+
+	// pypiVersions: [v][N!]N(.N)*[pre[N]][post|-N][dev[N]][+local][blank].
+	pypiLocalPart = weighted(choice[string]{1, number}, choice[string]{1, pick("local", "ubuntu", "abc", "g1a2b3c", "cpu", "cu118", "A", "z")})
+	pypiVersions  = cat(
+		maybe(10, pick("v", "V", " ", "\t")),
+		maybe(10, cat(number, lit("!"))),
+		dotted(1, 4),
+		maybe(40, cat(sep4, pick("a", "b", "c", "rc", "alpha", "beta", "pre", "preview", "RC", "Beta"), maybe(70, cat(sep4, number)))),
+		maybe(30, weighted(
+			choice[string]{3, cat(lit("-"), number)},
+			choice[string]{7, cat(sep4, pick("post", "rev", "r", "POST"), sep4, maybe(70, number))},
+		)),
+		maybe(30, cat(sep4, pick("dev", "DEV"), sep4, maybe(70, number))),
+		maybe(20, cat(lit("+"), pypiLocalPart, joined(many(cat(pick(".", "-", "_"), pypiLocalPart), 0, 2), ""))),
+		maybe(5, blanks),
+	)
+
+	// debianVersions: [N:]N(.N)*(sep word)*[-revision].
+	debianVersions = cat(
+		maybe(25, cat(number, lit(":"))),
+		dotted(1, 4),
+		joined(many(cat(pick("~", "+", ".", "-", ""), pick("rc1", "beta", "dfsg", "git20240101", "a", "b", "0", "1", "really", "alpha", "ds", "repack", "2")), 0, 3), ""),
+		maybe(50, cat(lit("-"), pick("1", "2", "0", "1ubuntu1", "1+deb11u2", "0ubuntu0.20.04.1", "1~bpo11+1", "3.1", "1build1", "10"))),
+	)
+
+	// redhatVersions: [N:]N(.N)*(sep word)*[-release].
+	redhatVersions = cat(
+		maybe(25, cat(number, lit(":"))),
+		dotted(1, 4),
+		joined(many(cat(pick("~", "^", ".", ""), pick("rc1", "beta", "git", "20240101", "a", "b", "1", "alpha", "pre", "20240101gitabcdef")), 0, 2), ""),
+		maybe(60, cat(lit("-"), pick("1", "2", "10", "1.el8", "2.el9_3", "1.fc39", "0.1.rc1.el8", "1.module+el8.9.0+1234+abcdef", "3.el8_10.1", "1.1", "0"))),
+	)
+
+	// rubygemsVersions: [blank]N(.N)*[sep word[.N]][blank].
+	rubygemsVersions = cat(
+		maybe(5, pick(" ", "\t", "\n", "")),
+		dotted(1, 4),
+		maybe(40, cat(pick(".", "-", ""), pick("a", "b", "rc", "pre", "beta", "alpha", "rc1", "beta2", "pre.1", "x86_64", "linux", "java"), maybe(50, cat(pick("", "."), number)))),
+		maybe(10, blanks),
+	)
+
+	// semverVersions: [prefix]N(.N)*[-pre(.pre)*][+build(.build)*] for npm,
+	// Go and the semver-like ecosystems.
+	semverPre      = weighted(choice[string]{1, number}, choice[string]{1, pick("alpha", "beta", "rc", "x", "-", "a-b", "0a", "SNAPSHOT", "pre")})
+	semverVersions = cat(
+		maybe(20, pick("v", "V", "=", "^", "~", " ")),
+		dotted(1, 5),
+		maybe(40, cat(lit("-"), joined(many(semverPre, 1, 3), "."))),
+		maybe(25, cat(lit("+"), joined(many(pick("001", "20130313144700", "exp", "sha", "5114f85", "build", "0", "1", "meta-valid"), 1, 3), "."))),
+	)
+
+	// mavenVersions: N(.N)*(sep (number|qualifier))*.
+	mavenQualifier = pick("alpha", "beta", "milestone", "rc", "cr", "snapshot", "SNAPSHOT", "ga", "final", "release", "sp", "a", "b", "m", "RC", "Final", "GA", "incubating", "jre8", "android", "SNAPSHOT-1", "x", "aa")
+	mavenVersions  = cat(
+		dotted(1, 4),
+		joined(many(cat(pick("-", ".", ""), weighted(choice[string]{2, number}, choice[string]{3, mavenQualifier})), 0, 3), ""),
+	)
+
+	// nugetVersions: N(.N)*[-pre][+build].
+	nugetVersions = cat(
+		dotted(1, 4),
+		maybe(40, cat(lit("-"), pick("alpha", "beta", "rc", "preview", "alpha.1", "beta.2", "rc.1", "pre", "a", "0", "1.2.3"))),
+		maybe(20, cat(lit("+"), pick("build", "1", "meta.data", "abc123"))),
+	)
+
+	// alpineVersions: N(.N)*[letter][_suffix[N]][-rN].
+	alpineVersions = cat(
+		dotted(1, 4),
+		maybe(20, pick("a", "b", "c", "z", "aa")),
+		maybe(40, cat(lit("_"), pick("alpha", "beta", "pre", "rc", "cvs", "svn", "git", "hg", "p"), maybe(50, number))),
+		maybe(50, cat(lit("-r"), number)),
+	)
+
+	// cranVersions: N(sep N)+ with dots or hyphens.
+	cranVersions = cat(number, joined(many(cat(pick(".", "-"), number), 1, 3), ""))
+
+	// hackageVersions: N(.N)*.
+	hackageVersions = dotted(1, 5)
+
+	// packagistVersions: [prefix]N(.N)*[sep word[N]].
+	packagistVersions = cat(
+		maybe(20, pick("v", "V", "dev-", "1.x-dev")),
+		dotted(1, 4),
+		maybe(40, cat(pick("-", ".", ""), pick("alpha", "beta", "RC", "rc", "patch", "pl", "p", "dev", "stable", "a", "b"), maybe(50, number))),
+	)
+
+	// pubVersions: N(.N)*[-pre][+build].
+	pubVersions = cat(
+		dotted(1, 3),
+		maybe(40, cat(lit("-"), pick("alpha", "beta", "dev", "rc", "0", "1.2", "dev.1", "a"))),
+		maybe(20, cat(lit("+"), pick("1", "hotfix.1", "2.0", "a"))),
+	)
+)
+
+// shapedOf is the shaped-version generator of the ecosystem's family.
+func shapedOf(eco string) hegel.Generator[string] {
+	switch eco {
+	case "PyPI":
+		return pypiVersions
+	case "Debian", "Ubuntu":
+		return debianVersions
+	case "Red Hat", "AlmaLinux", "Rocky Linux", "openSUSE", "Mageia", "openEuler", "SUSE":
+		return redhatVersions
+	case "RubyGems":
+		return rubygemsVersions
+	case "npm", "Go", "crates.io", "Hex", "GHC", "Julia", "SwiftURL", "Bitnami", "ConanCenter", "Docker Hardened Images", "Bioconductor":
+		return semverVersions
+	case "Maven":
+		return mavenVersions
+	case "NuGet":
+		return nugetVersions
+	case "Alpine", "Wolfi", "Chainguard", "Alpaquita", "MinimOS", "BellSoft Hardened Containers":
+		return alpineVersions
+	case "CRAN":
+		return cranVersions
+	case "Hackage":
+		return hackageVersions
+	case "Packagist":
+		return packagistVersions
+	case "Pub":
+		return pubVersions
+	}
+	return dotted(1, 4)
+}
+
+// versionsOf is a version string for the ecosystem: shaped most of the
+// time, free soup a fifth of the time, a shaped one with an edit a tenth.
+func versionsOf(eco string) hegel.Generator[string] {
+	shaped := shapedOf(eco)
+	return weighted(
+		choice[string]{7, shaped},
+		choice[string]{2, soup},
+		choice[string]{1, hegel.Map(pairs(shaped, edits), func(p pair[string, edit]) string { return p.b.apply(p.a) })},
+	)
+}
+
+// ---------------------------------------------------------------------------
+// Edits: one small change to a version text, drawn as data.
+
+// edit is the kind of change and the draws it uses: a position (and a span)
+// taken modulo the live length, the text an insert, replace or append puts
+// in, the direction of a recase. An edit that does not fit its text (a
+// delete of nothing, a swap in one character) is a no-op.
+type edit struct {
+	kind  string
+	at    int
+	span  int
+	piece string
+	upper bool
+}
+
+var (
+	editChars = pick("0", "1", "9", ".", "-", "~", "+", "a", "z", "_", ":", "^", "!")
+	editTails = pick(".0", ".1", "0", "1", "-1", "~rc1", "+build", ".post1", ".dev0", "a", "-SNAPSHOT", "_p1", "-r1", ".", "-", "~")
+
+	// edits: the nine kinds, the ones that only move or drop text first.
+	edits = weighted(
+		choice[edit]{1, hegel.Map(positions, func(at int) edit { return edit{kind: "delete", at: at} })},
+		choice[edit]{1, hegel.Map(pairs(positions, piece), func(p pair[int, string]) edit { return edit{kind: "insert", at: p.a, piece: p.b} })},
+		choice[edit]{1, hegel.Map(pairs(positions, editChars), func(p pair[int, string]) edit { return edit{kind: "replace", at: p.a, piece: p.b} })},
+		choice[edit]{1, hegel.Map(editTails, func(tail string) edit { return edit{kind: "append", piece: tail} })},
+		choice[edit]{1, hegel.Map(positions, func(at int) edit { return edit{kind: "swap", at: at} })},
+		choice[edit]{1, hegel.Map(pairs(positions, positions), func(p pair[int, int]) edit { return edit{kind: "duplicate", at: p.a, span: p.b} })},
+		choice[edit]{1, hegel.Map(positions, func(at int) edit { return edit{kind: "bump", at: at} })},
+		choice[edit]{1, hegel.Map(positions, func(at int) edit { return edit{kind: "zero", at: at} })},
+		choice[edit]{1, hegel.Map(chance(50), func(upper bool) edit { return edit{kind: "recase", upper: upper} })},
+	)
+)
+
+// apply is the text changed by the edit: a rune deleted, a piece inserted,
+// a rune replaced, a piece appended, two adjacent runes swapped, a span
+// duplicated, the next digit bumped, a leading zero put before the next
+// number, the case changed.
+func (e edit) apply(s string) string {
+	r := []rune(s)
+	n := len(r)
+	switch e.kind {
+	case "delete":
+		if n == 0 {
+			return s
+		}
+		i := e.at % n
+		return string(r[:i]) + string(r[i+1:])
+	case "insert":
+		i := e.at % (n + 1)
+		return string(r[:i]) + e.piece + string(r[i:])
+	case "replace":
+		if n == 0 {
+			return e.piece
+		}
+		i := e.at % n
+		return string(r[:i]) + e.piece + string(r[i+1:])
+	case "append":
+		return s + e.piece
+	case "swap":
+		if n < 2 {
+			return s
+		}
+		i := e.at % (n - 1)
+		r[i], r[i+1] = r[i+1], r[i]
+		return string(r)
+	case "duplicate":
+		i := e.at % (n + 1)
+		j := i + e.span%(n-i+1)
+		return string(r[:j]) + string(r[i:j]) + string(r[j:])
+	case "bump":
+		for k := e.at % (n + 1); k < n; k++ {
+			if r[k] >= '0' && r[k] <= '8' {
+				r[k]++
+				return string(r)
+			}
+		}
+		return s
+	case "zero":
+		for k := e.at % (n + 1); k < n; k++ {
+			if r[k] >= '0' && r[k] <= '9' {
+				return string(r[:k]) + "0" + string(r[k:])
+			}
+		}
+		return s
+	case "recase":
+		if e.upper {
+			return strings.ToUpper(s)
+		}
+		return strings.ToLower(s)
+	}
+	panic("edit " + e.kind)
+}
+
+func (e edit) GoString() string {
+	switch e.kind {
+	case "insert", "replace":
+		return fmt.Sprintf("%s %q at %d", e.kind, e.piece, e.at)
+	case "append":
+		return fmt.Sprintf("append %q", e.piece)
+	case "duplicate":
+		return fmt.Sprintf("duplicate at %d span %d", e.at, e.span)
+	case "recase":
+		return fmt.Sprintf("recase upper=%v", e.upper)
+	}
+	return fmt.Sprintf("%s at %d", e.kind, e.at)
+}
+
+// ---------------------------------------------------------------------------
+// Pairs: a version and a relation to it.
+
+// relation is how the second version of a pair derives from the first: the
+// same text, one or two edits applied in turn, or a fresh version.
+type relation struct {
+	kind  string
+	edits []edit
+	fresh string
+}
+
+func (r relation) apply(a string) string {
+	switch r.kind {
+	case "same":
+		return a
+	case "fresh":
+		return r.fresh
+	}
+	b := a
+	for _, e := range r.edits {
+		b = e.apply(b)
+	}
+	return b
+}
+
+// relationsOf: the same version one time in ten, a fresh one two times,
+// an edited one the rest (a second edit on some).
+func relationsOf(eco string) hegel.Generator[relation] {
+	return weighted(
+		choice[relation]{1, hegel.Just(relation{kind: "same"})},
+		choice[relation]{7, hegel.Map(many(edits, 1, 2), func(es []edit) relation { return relation{kind: "edited", edits: es} })},
+		choice[relation]{2, hegel.Map(versionsOf(eco), func(v string) relation { return relation{kind: "fresh", fresh: v} })},
+	)
+}
+
+// versionPair is two versions to compare.
+type versionPair struct{ a, b string }
+
+func pairsOf(eco string) hegel.Generator[versionPair] {
+	return hegel.Map(pairs(versionsOf(eco), relationsOf(eco)), func(p pair[string, relation]) versionPair {
+		return versionPair{p.a, p.b.apply(p.a)}
+	})
+}
diff --git a/semantic/hegel/hegel_pins_test.go b/semantic/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..ef26ec8
--- /dev/null
+++ b/semantic/hegel/hegel_pins_test.go
@@ -0,0 +1,110 @@
+package hegel
+
+// Pins: one plain test per bug in bugs.toml, failing while the bug is open
+// (listed under [expected_failures] in the zoo's target.toml).
+
+import (
+	"testing"
+)
+
+func pinCompare(t *testing.T, eco, a, b string, want int) {
+	t.Helper()
+	got, err := compare(eco, a, b)
+	if err != nil {
+		t.Fatalf("%s: %v", eco, err)
+	}
+	if got != want {
+		t.Errorf("%s: Compare of %q and %q is %d, want %d", eco, a, b, got, want)
+	}
+}
+
+// osv-scalibr/1: Gem::Version strips surrounding whitespace ("1.0 " ==
+// "1.0"); semantic keeps it as a segment.
+func TestHegelPinRubyGemsWhitespaceIsStripped(t *testing.T) {
+	pinCompare(t, "RubyGems", "1.10\t", "1.10", 0)
+	pinCompare(t, "RubyGems", " 30", "5.9", 1)
+}
+
+// osv-scalibr/2: Gem::Version reads a hyphen as ".pre." ("1.0-1" is
+// "1.0.pre.1"); semantic keeps the hyphen as a segment.
+func TestHegelPinRubyGemsHyphenIsPre(t *testing.T) {
+	pinCompare(t, "RubyGems", "1.0-1", "1.0.pre.1", 0)
+	pinCompare(t, "RubyGems", "1.0-1", "1.0.a", 1)
+}
+
+// osv-scalibr/3: Maven since 3.8.7 (MNG-7644) reads a qualifier introduced
+// by a dot and followed by a digit or the end as introduced by a hyphen:
+// 2.0.alpha == 2-alpha, 1.0.0.rc1 < 1.0.0-rc2, and 1.0.x. < 1.0.x.
+func TestHegelPinMavenDotQualifierIsHyphen(t *testing.T) {
+	pinCompare(t, "Maven", "2.0.alpha", "2-alpha", 0)
+	pinCompare(t, "Maven", "1.0.x.", "1.0.x", -1)
+}
+
+// osv-scalibr/4: Maven drops a null item (0, ga, final, release, empty)
+// that is followed by a sub-list too, nesting the sub-list one level
+// deeper, so 1-0-1 and 1-ga-1 sort below 1-1 and final4 above fina4l;
+// semantic equates the first pair (its test data asserts 1-1 = 1-ga-1).
+func TestHegelPinMavenNullBeforeSublistNests(t *testing.T) {
+	pinCompare(t, "Maven", "1-0-1", "1-1", -1)
+	pinCompare(t, "Maven", "1-ga-1", "1-1", -1)
+	pinCompare(t, "Maven", "1.0.al1", "1.al1", 0)
+}
+
+// osv-scalibr/5: rpm splits an EVR at the last hyphen (rpmverParse's
+// strrchr); semantic splits at the first, so 1.0-1-2 equals 1.0-1.2 to it
+// while rpm orders them.
+func TestHegelPinRedHatReleaseStartsAtLastHyphen(t *testing.T) {
+	pinCompare(t, "Red Hat", "1.0-1-2", "1.0-1.2", 1)
+}
+
+// osv-scalibr/6: Alpine's Compare is not an order once a version apk would
+// reject is involved: two invalid versions compare as strings, an invalid
+// and a valid one by components.
+func TestHegelPinAlpineCompareIsTransitive(t *testing.T) {
+	a, b, c := "=3", "10_beta1", "10beta1"
+	ab, _ := compare("Alpine", a, b)
+	bc, _ := compare("Alpine", b, c)
+	ac, _ := compare("Alpine", a, c)
+	if ab <= 0 && bc <= 0 && ac > 0 {
+		t.Errorf("Alpine: %q <= %q <= %q but %q > %q", a, b, c, a, c)
+	}
+}
+
+// osv-scalibr/7: Gem::Version compares numeric segments as numbers, so a
+// trailing 00 is a trailing 0 and drops before the string segments (1.00.a
+// is 1.a); semantic strips only the literal "0" and keeps "00" as a
+// number, which then outranks the string segment.
+func TestHegelPinRubyGemsLeadingZerosAreZero(t *testing.T) {
+	pinCompare(t, "RubyGems", "1.00.a", "1.a", 0)
+	pinCompare(t, "RubyGems", "0.0b", "00.0b", 0)
+}
+
+// osv-scalibr/8: Maven normalizes a version of zeros to nothing, so an
+// unknown qualifier alone (latest, sp) sorts above 0 as it sorts above a
+// release; semantic keeps the first zero and sorts every qualifier below.
+func TestHegelPinMavenZeroIsARelease(t *testing.T) {
+	pinCompare(t, "Maven", "0", "latest", -1)
+	pinCompare(t, "Maven", "0.0", "sp", -1)
+}
+
+// osv-scalibr/9: rpmvercmp strips separators and applies the tilde rule
+// before it looks at emptiness, so a version of separators only equals an
+// empty one and a version starting with a tilde sorts below an empty one;
+// semantic decides by emptiness first.
+func TestHegelPinRedHatEmptyComponentFollowsRpmvercmp(t *testing.T) {
+	pinCompare(t, "Red Hat", "1:", "1:::", 0)
+	pinCompare(t, "Red Hat", "~1", "-1", -1)
+}
+
+// osv-scalibr/10: an Alpine numeric component that is missing compares as
+// the number 0 against a present component with a leading zero, which
+// otherwise compares as a string, so 100 == 100.0 == 100.00 while
+// 100.0 < 100.00.
+func TestHegelPinAlpineMissingComponentOrder(t *testing.T) {
+	ab, _ := compare("Alpine", "100", "100.0")
+	bc, _ := compare("Alpine", "100.0", "100.00")
+	ac, _ := compare("Alpine", "100", "100.00")
+	if ab == 0 && bc != ac {
+		t.Errorf("Alpine: 100 == 100.0 but against 100.00 they compare %d and %d", ac, bc)
+	}
+}
diff --git a/semantic/hegel/hegel_props_test.go b/semantic/hegel/hegel_props_test.go
new file mode 100644
index 0000000..108c2c9
--- /dev/null
+++ b/semantic/hegel/hegel_props_test.go
@@ -0,0 +1,240 @@
+package hegel
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"golang.org/x/mod/semver"
+	"hegel.dev/go/hegel"
+
+	"github.com/google/osv-scalibr/semantic"
+)
+
+// ecosystems is every ecosystem semantic.Parse knows, with the parser it
+// uses, for the self-consistency property.
+var ecosystems = []string{"AlmaLinux", "Alpaquita", "Alpine", "BellSoft Hardened Containers", "Bitnami", "Bioconductor",
+	"Chainguard", "ConanCenter", "CRAN", "crates.io", "Debian", "Docker Hardened Images", "GHC", "Go", "Hackage", "Hex",
+	"Julia", "Mageia", "Maven", "MinimOS", "npm", "NuGet", "openEuler", "openSUSE", "Packagist", "Pub", "PyPI", "Red Hat",
+	"Rocky Linux", "RubyGems", "SUSE", "SwiftURL", "Ubuntu", "Wolfi"}
+
+// oracleEcosystems lists the ecosystems with an oracle; oracles has each
+// one's driver.
+var (
+	oracleEcosystems = []string{"PyPI", "Debian", "Red Hat", "RubyGems", "npm", "Maven", "Go"}
+	oracles          = map[string]func(t testing.TB, a, b string) verdict{
+		"PyPI":     pypiOracle,
+		"Debian":   debianOracle,
+		"Red Hat":  redhatOracle,
+		"RubyGems": rubygemsOracle,
+		"npm":      npmOracle,
+		"Maven":    mavenOracle,
+		"Go":       goOracle,
+	}
+)
+
+// goOracle is golang.org/x/mod/semver: Go module versions carry a "v",
+// which OSV's Go ecosystem drops, so it is put back when missing.
+func goOracle(t testing.TB, a, b string) verdict {
+	va, vb := a, b
+	if !strings.HasPrefix(va, "v") {
+		va = "v" + va
+	}
+	if !strings.HasPrefix(vb, "v") {
+		vb = "v" + vb
+	}
+	v := verdict{aOK: semver.IsValid(va), bOK: semver.IsValid(vb)}
+	if !v.aOK {
+		v.aErr = "invalid"
+	}
+	if !v.bOK {
+		v.bErr = "invalid"
+	}
+	if v.aOK && v.bOK {
+		v.cmp = semver.Compare(va, vb)
+	}
+	return v
+}
+
+// compare parses both sides for the ecosystem and compares them, or
+// returns the parse error.
+func compare(eco, a, b string) (int, error) {
+	va, err := semantic.Parse(a, eco)
+	if err != nil {
+		return 0, fmt.Errorf("parsing %q: %w", a, err)
+	}
+	vb, err := semantic.Parse(b, eco)
+	if err != nil {
+		return 0, fmt.Errorf("parsing %q: %w", b, err)
+	}
+	c, err := va.Compare(vb)
+	if err != nil {
+		return 0, fmt.Errorf("comparing: %w", err)
+	}
+	return sign(c), nil
+}
+
+func quoted(s string) string {
+	return fmt.Sprintf("%q", s)
+}
+
+// byEcosystem builds one generator per ecosystem once: the grammar depends
+// on the drawn ecosystem, so a case is a FlatMap from the ecosystem into
+// this table.
+func byEcosystem[T any](ecos []string, build func(eco string) hegel.Generator[T]) map[string]hegel.Generator[T] {
+	m := make(map[string]hegel.Generator[T], len(ecos))
+	for _, eco := range ecos {
+		m[eco] = build(eco)
+	}
+	return m
+}
+
+// ---------------------------------------------------------------------------
+// Property: semantic orders a pair as the ecosystem's own implementation does.
+
+// differentialCase: an ecosystem with an oracle and a pair of versions for it.
+type differentialCase struct {
+	eco  string
+	pair versionPair
+}
+
+func (c differentialCase) GoString() string {
+	return fmt.Sprintf("%s: %q vs %q", c.eco, c.pair.a, c.pair.b)
+}
+
+var (
+	differentialCasesByEco = byEcosystem(oracleEcosystems, func(eco string) hegel.Generator[differentialCase] {
+		return hegel.Map(pairsOf(eco), func(p versionPair) differentialCase { return differentialCase{eco, p} })
+	})
+	differentialCases = hegel.FlatMap(hegel.SampledFrom(oracleEcosystems), func(eco string) hegel.Generator[differentialCase] {
+		return differentialCasesByEco[eco]
+	})
+)
+
+// TestHegelComparesLikeTheEcosystem: for each ecosystem with an oracle, a
+// pair of versions the oracle accepts is ordered by semantic as the oracle
+// orders it; a pair the oracle rejects is counted. A disagreement on the
+// shape of a recorded bug fails naming the bug (known.go), or under
+// HEGEL_NO_KNOWN=1 is counted and assumed away.
+func TestHegelComparesLikeTheEcosystem(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, differentialCases)
+		count("cases")
+		a, b := c.pair.a, c.pair.b
+		want := oracles[c.eco](t, a, b)
+		got, err := compare(c.eco, a, b)
+		if !want.aOK || !want.bOK {
+			count(c.eco + ": oracle rejects a side")
+			if err == nil && want.looseOK && got != sign(want.looseCmp) {
+				count(c.eco + ": differs from node-semver's loose mode")
+			}
+			return
+		}
+		if err != nil {
+			mismatch(ht, Known.explains(c.eco, a, b), "%s: semantic rejects what the ecosystem accepts: %v (oracle: %v on %s vs %s)", c.eco, err, want, quoted(a), quoted(b))
+			return
+		}
+		if got != sign(want.cmp) {
+			mismatch(ht, Known.explains(c.eco, a, b), "%s: semantic compares %s vs %s as %d, the ecosystem as %d", c.eco, quoted(a), quoted(b), got, sign(want.cmp))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property: Compare is an order for every ecosystem.
+
+// orderCase: an ecosystem, a pair of versions for it and a third version
+// made from one of the pair by an edit.
+type orderCase struct {
+	eco   string
+	pair  versionPair
+	third edit
+	fromB bool
+}
+
+// c is the third version: the edit applied to a, or to b.
+func (c orderCase) c() string {
+	if c.fromB {
+		return c.third.apply(c.pair.b)
+	}
+	return c.third.apply(c.pair.a)
+}
+
+func (c orderCase) GoString() string {
+	return fmt.Sprintf("%s: %q, %q, %q", c.eco, c.pair.a, c.pair.b, c.c())
+}
+
+var (
+	orderCasesByEco = byEcosystem(ecosystems, func(eco string) hegel.Generator[orderCase] {
+		return hegel.Composite(func(tc hegel.TestCase) orderCase {
+			return orderCase{eco: eco, pair: hegel.Draw(tc, pairsOf(eco)), third: hegel.Draw(tc, edits), fromB: hegel.Draw(tc, chance(50))}
+		})
+	})
+	orderCases = hegel.FlatMap(hegel.SampledFrom(ecosystems), func(eco string) hegel.Generator[orderCase] {
+		return orderCasesByEco[eco]
+	})
+)
+
+// checkTransitive checks the signs of a vs b, b vs c and a vs c: a <= b <=
+// c implies a <= c (and the reverse), and a == b implies a and b compare
+// alike with c; a violation fails naming the known shapes of the versions.
+func checkTransitive(ht *hegel.T, eco string, a, b, c string, ab, bc, ac int, shapes []string) {
+	if ab <= 0 && bc <= 0 && ac > 0 {
+		mismatch(ht, shapes, "%s: not transitive: %s <= %s <= %s but %s > %s", eco, quoted(a), quoted(b), quoted(c), quoted(a), quoted(c))
+	}
+	if ab >= 0 && bc >= 0 && ac < 0 {
+		mismatch(ht, shapes, "%s: not transitive: %s >= %s >= %s but %s < %s", eco, quoted(a), quoted(b), quoted(c), quoted(a), quoted(c))
+	}
+	if ab == 0 && ac != bc {
+		mismatch(ht, shapes, "%s: %s == %s but against %s they compare %d and %d", eco, quoted(a), quoted(b), quoted(c), ac, bc)
+	}
+}
+
+// TestHegelCompareIsAnOrder: for every ecosystem, Parse and Compare never
+// panic, a version equals itself, Compare is antisymmetric, CompareStr
+// agrees with Parse plus Compare, and the order is transitive over three
+// versions. A violation on the shape of a recorded bug fails naming the
+// bug, or under HEGEL_NO_KNOWN=1 is counted and assumed away.
+func TestHegelCompareIsAnOrder(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		oc := hegel.Draw(ht, orderCases)
+		count("cases")
+		eco, a, b, c := oc.eco, oc.pair.a, oc.pair.b, oc.c()
+		va, errA := semantic.Parse(a, eco)
+		vb, errB := semantic.Parse(b, eco)
+		vc, errC := semantic.Parse(c, eco)
+		if errA != nil || errB != nil || errC != nil {
+			count(eco + ": Parse rejects")
+			// CompareStr must reject what Parse rejects.
+			if errA == nil && errB != nil {
+				if _, err := va.CompareStr(b); err == nil {
+					fail(ht, "%s: Parse rejects %s (%v) but CompareStr from %s accepts it", eco, quoted(b), errB, quoted(a))
+				}
+			}
+			return
+		}
+		if c0, err := va.Compare(va); err != nil || c0 != 0 {
+			fail(ht, "%s: %s compared with itself gives %d, %v", eco, quoted(a), c0, err)
+		}
+		ab, err := va.Compare(vb)
+		if err != nil {
+			fail(ht, "%s: Compare of %s and %s: %v", eco, quoted(a), quoted(b), err)
+		}
+		ba, err := vb.Compare(va)
+		if err != nil {
+			fail(ht, "%s: Compare of %s and %s: %v", eco, quoted(b), quoted(a), err)
+		}
+		if sign(ab) != -sign(ba) {
+			mismatch(ht, Known.explainsOrder(eco, a, b), "%s: Compare is not antisymmetric: %s vs %s is %d, the other way %d", eco, quoted(a), quoted(b), ab, ba)
+		}
+		if abs, err := va.CompareStr(b); err != nil || sign(abs) != sign(ab) {
+			fail(ht, "%s: CompareStr of %s with %s gives %d, %v; Compare gives %d", eco, quoted(a), quoted(b), abs, err, ab)
+		}
+		if ab == 0 {
+			count(eco + ": equal")
+		}
+		bc, _ := vb.Compare(vc)
+		ac, _ := va.Compare(vc)
+		checkTransitive(ht, eco, a, b, c, sign(ab), sign(bc), sign(ac), Known.explainsOrder(eco, a, b, c))
+	})
+}
diff --git a/semantic/hegel/hegel_shapes_test.go b/semantic/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..39b600c
--- /dev/null
+++ b/semantic/hegel/hegel_shapes_test.go
@@ -0,0 +1,495 @@
+package hegel
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged by the oracle of the wide
+// property that found it (TestHegelComparesLikeTheEcosystem's ecosystem
+// oracle, or TestHegelCompareIsAnOrder's transitivity check), so that each
+// bug has a property that finds it every run (the wide properties reach the
+// shapes at their natural rate). Under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring region the bug does not touch instead (no blank, the .pre.
+// spelling, a hyphen-introduced qualifier, a non-null item, one hyphen,
+// valid Alpine versions, a single zero, a non-zero version, alphanumeric
+// components, a non-zero trailing component) and passes.
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// shaped is the value for a recorded bug's shape region or, under
+// HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapesOf names the bug a narrow property is about together with every
+// other recorded shape the case has - or nothing under HEGEL_NO_KNOWN=1,
+// when the property draws the neighbouring region and a disagreement is a
+// plain failure.
+func shapesOf(id string, others []string) []string {
+	if noKnown {
+		return nil
+	}
+	shapes := []string{id}
+	for _, s := range others {
+		if !slices.Contains(shapes, s) {
+			shapes = append(shapes, s)
+		}
+	}
+	return shapes
+}
+
+// checkLikeTheEcosystem judges one pair as TestHegelComparesLikeTheEcosystem
+// does: a pair the oracle accepts is ordered by semantic as the oracle
+// orders it (a pair it rejects is counted and assumed away, rare here since
+// the regions are drawn inside the oracles' grammars).
+func checkLikeTheEcosystem(t *testing.T, ht *hegel.T, eco, a, b, bug string) {
+	want := oracles[eco](t, a, b)
+	if !want.aOK || !want.bOK {
+		count(eco + ": oracle rejects a side")
+		ht.Assume(false)
+	}
+	got, err := compare(eco, a, b)
+	shapes := shapesOf(bug, Known.explains(eco, a, b))
+	if err != nil {
+		mismatch(ht, shapes, "%s: semantic rejects what the ecosystem accepts: %v (oracle: %v on %s vs %s)", eco, err, want, quoted(a), quoted(b))
+		return
+	}
+	if got != sign(want.cmp) {
+		mismatch(ht, shapes, "%s: semantic compares %s vs %s as %d, the ecosystem as %d", eco, quoted(a), quoted(b), got, sign(want.cmp))
+	}
+}
+
+// checkOrder judges three versions as TestHegelCompareIsAnOrder does.
+func checkOrder(ht *hegel.T, eco, a, b, c, bug string) {
+	ab, errAB := compare(eco, a, b)
+	bc, errBC := compare(eco, b, c)
+	ac, errAC := compare(eco, a, c)
+	if errAB != nil || errBC != nil || errAC != nil {
+		fail(ht, "%s: Parse or Compare of %s, %s, %s: %v %v %v", eco, quoted(a), quoted(b), quoted(c), errAB, errBC, errAC)
+		return
+	}
+	checkTransitive(ht, eco, a, b, c, ab, bc, ac, shapesOf(bug, Known.explainsOrder(eco, a, b, c)))
+}
+
+// Pieces the regions are filled with: numbers without leading zeros (those
+// are a shape of their own), words of letters only, a dotted version of
+// such numbers.
+var (
+	plainNumber = weighted(
+		choice[string]{7, smallNumber},
+		choice[string]{3, pick("11", "42", "100", "2024", "65535", "65536", "4294967295", "4294967296", "9223372036854775807", "9223372036854775808", "18446744073709551616", "123456789012345678901234567890")},
+	)
+	plainDotted  = joined(many(plainNumber, 1, 3), ".")
+	letterWord   = pick("a", "b", "rc", "pre", "beta", "alpha", "x", "z", "foo", "dev", "RC", "Beta")
+	numberOrWord = weighted(choice[string]{1, plainNumber}, choice[string]{1, letterWord})
+	blank        = pick(" ", "\t", "\n", "  ", " \t")
+)
+
+// --------------------------------------------------------------------------- osv-scalibr/1
+
+// whitespaceCase: a RubyGems version with a blank before or after it,
+// against the plain text with a clean tail; under HEGEL_NO_KNOWN=1 without
+// the blank.
+type whitespaceCase struct {
+	ver     string
+	blank   string
+	leading bool
+	tail    string
+}
+
+var whitespaceCases = hegel.Composite(func(tc hegel.TestCase) whitespaceCase {
+	return whitespaceCase{
+		ver:     hegel.Draw(tc, plainDotted),
+		blank:   hegel.Draw(tc, blank),
+		leading: hegel.Draw(tc, chance(50)),
+		tail:    hegel.Draw(tc, pick("", ".0", ".pre", ".1", ".a.1")),
+	}
+})
+
+func (c whitespaceCase) a() string {
+	b := shaped(c.blank, "")
+	if c.leading {
+		return b + c.ver
+	}
+	return c.ver + b
+}
+
+func (c whitespaceCase) b() string { return c.ver + c.tail }
+
+func (c whitespaceCase) GoString() string { return fmt.Sprintf("%q vs %q", c.a(), c.b()) }
+
+// TestHegelRubyGemsStripsSurroundingWhitespace: Gem::Version strips the
+// blanks around a version, so "1.0 " is "1.0"; semantic keeps the blank as
+// a segment (osv-scalibr/1).
+func TestHegelRubyGemsStripsSurroundingWhitespace(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, whitespaceCases)
+		checkLikeTheEcosystem(t, ht, "RubyGems", c.a(), c.b(), "osv-scalibr/1")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/2
+
+// hyphenCase: a RubyGems version with a hyphen before its last piece,
+// against the ".pre." spelling Gem::Version reads it as; under
+// HEGEL_NO_KNOWN=1 a dot-introduced word instead of the hyphen.
+type hyphenCase struct {
+	base, piece, word string
+}
+
+var hyphenCases = hegel.Composite(func(tc hegel.TestCase) hyphenCase {
+	return hyphenCase{base: hegel.Draw(tc, plainDotted), piece: hegel.Draw(tc, numberOrWord), word: hegel.Draw(tc, letterWord)}
+})
+
+func (c hyphenCase) a() string {
+	return shaped(c.base+"-"+c.piece, c.base+"."+c.word+"."+c.piece)
+}
+
+func (c hyphenCase) b() string { return c.base + ".pre." + c.piece }
+
+func (c hyphenCase) GoString() string { return fmt.Sprintf("%q vs %q", c.a(), c.b()) }
+
+// TestHegelRubyGemsHyphenReadsAsPre: Gem::Version reads "-" as ".pre.", so
+// "1.0-1" equals "1.0.pre.1"; semantic keeps the hyphen as a segment that
+// sorts below every word (osv-scalibr/2).
+func TestHegelRubyGemsHyphenReadsAsPre(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hyphenCases)
+		checkLikeTheEcosystem(t, ht, "RubyGems", c.a(), c.b(), "osv-scalibr/2")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/3
+
+// dotQualifierCase: a Maven version whose qualifier is introduced by a dot
+// and followed by digits or the end, against the hyphen-introduced
+// spelling (equal since MNG-7644); under HEGEL_NO_KNOWN=1 both
+// hyphen-introduced, with their own digits.
+type dotQualifierCase struct {
+	base, qualifier, digits, otherDigits string
+}
+
+var (
+	mavenNonNullQualifier = pick("alpha", "beta", "milestone", "rc", "cr", "snapshot", "SNAPSHOT", "sp", "a", "b", "m", "RC", "x", "incubating", "latest", "foo")
+	dotQualifierCases     = hegel.Composite(func(tc hegel.TestCase) dotQualifierCase {
+		return dotQualifierCase{
+			base:        hegel.Draw(tc, plainDotted),
+			qualifier:   hegel.Draw(tc, mavenNonNullQualifier),
+			digits:      hegel.Draw(tc, maybe(50, plainNumber)),
+			otherDigits: hegel.Draw(tc, maybe(50, plainNumber)),
+		}
+	})
+)
+
+func (c dotQualifierCase) a() string {
+	return c.base + shaped(".", "-") + c.qualifier + c.digits
+}
+
+func (c dotQualifierCase) b() string {
+	return c.base + "-" + c.qualifier + shaped(c.digits, c.otherDigits)
+}
+
+func (c dotQualifierCase) GoString() string { return fmt.Sprintf("%q vs %q", c.a(), c.b()) }
+
+// TestHegelMavenDotQualifierBeforeDigitOrEndIsHyphen: Maven since 3.8.7
+// (MNG-7644) reads a qualifier introduced by a dot and followed by a digit
+// or the end as introduced by a hyphen, so "2.0.alpha" equals "2.0-alpha";
+// semantic orders dot qualifiers apart (osv-scalibr/3).
+func TestHegelMavenDotQualifierBeforeDigitOrEndIsHyphen(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, dotQualifierCases)
+		checkLikeTheEcosystem(t, ht, "Maven", c.a(), c.b(), "osv-scalibr/3")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/4
+
+// nullSublistCase: a Maven version with a null item (0, ga, final, release)
+// between two hyphens, against the version without it; under
+// HEGEL_NO_KNOWN=1 a non-null item there.
+type nullSublistCase struct {
+	base, null, nonNull, rest string
+}
+
+var nullSublistCases = hegel.Composite(func(tc hegel.TestCase) nullSublistCase {
+	return nullSublistCase{
+		base:    hegel.Draw(tc, plainDotted),
+		null:    hegel.Draw(tc, pick("0", "ga", "final", "release", "00", "GA", "Final", "RELEASE")),
+		nonNull: hegel.Draw(tc, weighted(choice[string]{1, pick("1", "2", "9", "10")}, choice[string]{1, pick("alpha", "beta", "x")})),
+		rest:    hegel.Draw(tc, numberOrWord),
+	}
+})
+
+func (c nullSublistCase) a() string { return c.base + "-" + shaped(c.null, c.nonNull) + "-" + c.rest }
+
+func (c nullSublistCase) b() string { return c.base + "-" + c.rest }
+
+func (c nullSublistCase) GoString() string { return fmt.Sprintf("%q vs %q", c.a(), c.b()) }
+
+// TestHegelMavenNullItemBeforeSublistNests: Maven drops a null item that
+// precedes a sub-list too, nesting the sub-list one level deeper, so
+// "1-0-1" and "1-ga-1" sort below "1-1"; semantic equates them
+// (osv-scalibr/4).
+func TestHegelMavenNullItemBeforeSublistNests(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nullSublistCases)
+		checkLikeTheEcosystem(t, ht, "Maven", c.a(), c.b(), "osv-scalibr/4")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/5
+
+// lastHyphenCase: a Red Hat version with two hyphens, x-y-z, against x-y.z
+// (rpm: the release is z, so the versions x-y and x differ); under
+// HEGEL_NO_KNOWN=1 x-y.z against x-y, one hyphen each.
+type lastHyphenCase struct {
+	x, y, z string
+}
+
+var lastHyphenCases = hegel.Composite(func(tc hegel.TestCase) lastHyphenCase {
+	return lastHyphenCase{x: hegel.Draw(tc, plainDotted), y: hegel.Draw(tc, numberOrWord), z: hegel.Draw(tc, numberOrWord)}
+})
+
+func (c lastHyphenCase) a() string { return c.x + "-" + c.y + shaped("-", ".") + c.z }
+
+func (c lastHyphenCase) b() string { return c.x + "-" + c.y + shaped("."+c.z, "") }
+
+func (c lastHyphenCase) GoString() string { return fmt.Sprintf("%q vs %q", c.a(), c.b()) }
+
+// TestHegelRedHatReleaseSplitsAtLastHyphen: rpm splits an EVR at the last
+// hyphen, so "1.0-1-2" is version "1.0-1" and sorts above "1.0-1.2";
+// semantic splits at the first and equates them (osv-scalibr/5).
+func TestHegelRedHatReleaseSplitsAtLastHyphen(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, lastHyphenCases)
+		checkLikeTheEcosystem(t, ht, "Red Hat", c.a(), c.b(), "osv-scalibr/5")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/6
+
+// alpineInvalidCase: three Alpine versions of which two are ones apk would
+// reject - a junk character before the number, letters after the version
+// letter - and one valid; under HEGEL_NO_KNOWN=1 three valid ones.
+type alpineInvalidCase struct {
+	n, junk, suffix, suffixNum, letter, tail, n2, suffix2 string
+}
+
+var (
+	alpineSuffix       = pick("alpha", "beta", "pre", "rc", "p")
+	alpineInvalidCases = hegel.Composite(func(tc hegel.TestCase) alpineInvalidCase {
+		return alpineInvalidCase{
+			n:         hegel.Draw(tc, smallNumber),
+			junk:      hegel.Draw(tc, pick("=", ":", "@", "^", "_", "a", "z", "A", "Z")),
+			suffix:    hegel.Draw(tc, alpineSuffix),
+			suffixNum: hegel.Draw(tc, maybe(50, plainNumber)),
+			letter:    hegel.Draw(tc, pick("b", "a", "c", "z")),
+			tail:      hegel.Draw(tc, hegel.Text().Alphabet("abcdefghijklmnopqrstuvwxyz").MinSize(1).MaxSize(4)),
+			n2:        hegel.Draw(tc, smallNumber),
+			suffix2:   hegel.Draw(tc, alpineSuffix),
+		}
+	})
+)
+
+func (c alpineInvalidCase) a() string { return shaped(c.junk+c.n, c.n2+"_"+c.suffix2) }
+
+func (c alpineInvalidCase) b() string { return c.n + "_" + c.suffix + c.suffixNum }
+
+func (c alpineInvalidCase) c() string { return c.n + c.letter + shaped(c.tail, "_"+c.suffix) }
+
+func (c alpineInvalidCase) GoString() string {
+	return fmt.Sprintf("%q, %q, %q", c.a(), c.b(), c.c())
+}
+
+// TestHegelAlpineOrderHoldsWithInvalidVersions: Compare stays an order
+// when versions apk would reject are involved; semantic compares two
+// invalid versions as strings and an invalid one with a valid one by
+// components, which is not transitive (osv-scalibr/6).
+func TestHegelAlpineOrderHoldsWithInvalidVersions(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, alpineInvalidCases)
+		checkOrder(ht, "Alpine", c.a(), c.b(), c.c(), "osv-scalibr/6")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/7
+
+// zeroPaddedCase: a RubyGems version whose last numeric segment is a zero
+// written with leading zeros, before a word, against the version without
+// that segment (equal: a trailing zero drops); under HEGEL_NO_KNOWN=1 the
+// zero written plainly.
+type zeroPaddedCase struct {
+	base  []string
+	zeros string
+	word  string
+}
+
+var zeroPaddedCases = hegel.Composite(func(tc hegel.TestCase) zeroPaddedCase {
+	return zeroPaddedCase{
+		base:  hegel.Draw(tc, many(plainNumber, 0, 3)),
+		zeros: hegel.Draw(tc, pick("00", "000", "0000")),
+		word:  hegel.Draw(tc, letterWord),
+	}
+})
+
+func (c zeroPaddedCase) a() string {
+	return strings.Join(append(slices.Clone(c.base), shaped(c.zeros, "0"), c.word), ".")
+}
+
+func (c zeroPaddedCase) b() string {
+	base := c.base
+	if len(base) == 0 {
+		base = []string{"0"}
+	}
+	return strings.Join(append(slices.Clone(base), c.word), ".")
+}
+
+func (c zeroPaddedCase) GoString() string { return fmt.Sprintf("%q vs %q", c.a(), c.b()) }
+
+// TestHegelRubyGemsZeroPaddedSegmentIsZero: Gem::Version compares numeric
+// segments by value, so a trailing "00" is a trailing zero and drops before
+// the string segments ("1.00.a" is "1.a"); semantic strips only a literal
+// "0" and keeps "00" as a number that outranks the word (osv-scalibr/7).
+func TestHegelRubyGemsZeroPaddedSegmentIsZero(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zeroPaddedCases)
+		checkLikeTheEcosystem(t, ht, "RubyGems", c.a(), c.b(), "osv-scalibr/7")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/8
+
+// zeroVersionCase: a Maven version of zeros, against a qualifier alone
+// that Maven sorts above a release (sp, or one it does not know); under
+// HEGEL_NO_KNOWN=1 a non-zero version.
+type zeroVersionCase struct {
+	zeros, nonzero, qualifier string
+}
+
+var zeroVersionCases = hegel.Composite(func(tc hegel.TestCase) zeroVersionCase {
+	return zeroVersionCase{
+		zeros:     hegel.Draw(tc, joined(many(pick("0", "00", "000"), 1, 3), ".")),
+		nonzero:   hegel.Draw(tc, cat(pick("1", "2", "3", "9", "10", "99"), maybe(50, cat(lit("."), joined(many(plainNumber, 1, 2), "."))))),
+		qualifier: hegel.Draw(tc, pick("sp", "SP", "latest", "foo", "x", "aa", "zz", "unknown", "nightly", "hotfix")),
+	}
+})
+
+func (c zeroVersionCase) a() string { return shaped(c.zeros, c.nonzero) }
+
+func (c zeroVersionCase) b() string { return c.qualifier }
+
+func (c zeroVersionCase) GoString() string { return fmt.Sprintf("%q vs %q", c.a(), c.b()) }
+
+// TestHegelMavenZeroVersionSortsBelowUnknownQualifier: Maven normalizes a
+// version of zeros to nothing, so "sp" and an unknown qualifier sort above
+// it as they sort above a release; semantic keeps the first zero, which
+// outranks every qualifier (osv-scalibr/8).
+func TestHegelMavenZeroVersionSortsBelowUnknownQualifier(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zeroVersionCases)
+		checkLikeTheEcosystem(t, ht, "Maven", c.a(), c.b(), "osv-scalibr/8")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/9
+
+// emptyComponentCase: a Red Hat EVR whose version is empty against one of
+// separators only (rpm: equal, the separators strip), or one starting with
+// a tilde against an empty one (rpm: the tilde side is older); under
+// HEGEL_NO_KNOWN=1 two alphanumeric versions.
+type emptyComponentCase struct {
+	epoch string
+	kind  string
+	seps  string
+	piece string
+	other string
+}
+
+var emptyComponentCases = hegel.Composite(func(tc hegel.TestCase) emptyComponentCase {
+	return emptyComponentCase{
+		epoch: hegel.Draw(tc, maybe(50, cat(plainNumber, lit(":")))),
+		kind:  hegel.Draw(tc, pick("separators", "tilde")),
+		seps:  hegel.Draw(tc, hegel.Text().Alphabet(".:+_! ").MinSize(1).MaxSize(3)),
+		piece: hegel.Draw(tc, numberOrWord),
+		other: hegel.Draw(tc, numberOrWord),
+	}
+})
+
+func (c emptyComponentCase) a() string {
+	if noKnown {
+		return c.epoch + c.piece
+	}
+	if c.kind == "tilde" {
+		return c.epoch + "~" + c.piece
+	}
+	return c.epoch
+}
+
+func (c emptyComponentCase) b() string {
+	if noKnown {
+		return c.epoch + c.other
+	}
+	if c.kind == "tilde" {
+		return c.epoch
+	}
+	return c.epoch + c.seps
+}
+
+func (c emptyComponentCase) GoString() string { return fmt.Sprintf("%q vs %q", c.a(), c.b()) }
+
+// TestHegelRedHatEmptyComponentsCompareByRpmvercmp: rpmvercmp strips
+// separators and applies the tilde rule before it looks at emptiness, so
+// "1:" equals "1:::" and "~1" sorts below ""; semantic decides by
+// emptiness first (osv-scalibr/9).
+func TestHegelRedHatEmptyComponentsCompareByRpmvercmp(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, emptyComponentCases)
+		checkLikeTheEcosystem(t, ht, "Red Hat", c.a(), c.b(), "osv-scalibr/9")
+	})
+}
+
+// --------------------------------------------------------------------------- osv-scalibr/10
+
+// missingComponentCase: an Alpine version, the same with a ".0" and the
+// same with a zero written with leading zeros (apk: a fraction, compared
+// as text); under HEGEL_NO_KNOWN=1 a non-zero component instead.
+type missingComponentCase struct {
+	base, zeros, nonzero string
+}
+
+var missingComponentCases = hegel.Composite(func(tc hegel.TestCase) missingComponentCase {
+	return missingComponentCase{
+		base:    hegel.Draw(tc, plainDotted),
+		zeros:   hegel.Draw(tc, pick("00", "000", "0000")),
+		nonzero: hegel.Draw(tc, pick("1", "2", "9", "10")),
+	}
+})
+
+func (c missingComponentCase) a() string { return c.base }
+
+func (c missingComponentCase) b() string { return c.base + ".0" }
+
+func (c missingComponentCase) c() string { return c.base + "." + shaped(c.zeros, c.nonzero) }
+
+func (c missingComponentCase) GoString() string {
+	return fmt.Sprintf("%q, %q, %q", c.a(), c.b(), c.c())
+}
+
+// TestHegelAlpineMissingComponentOrderIsTransitive: a missing numeric
+// component compares as the number 0 against a present one even when that
+// one has a leading zero, where two present ones compare as text, so
+// "100" == "100.0" == "100.00" while "100.0" < "100.00" (osv-scalibr/10).
+func TestHegelAlpineMissingComponentOrderIsTransitive(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, missingComponentCases)
+		checkOrder(ht, "Alpine", c.a(), c.b(), c.c(), "osv-scalibr/10")
+	})
+}
diff --git a/semantic/hegel/hegel_test.go b/semantic/hegel/hegel_test.go
new file mode 100644
index 0000000..01dc96a
--- /dev/null
+++ b/semantic/hegel/hegel_test.go
@@ -0,0 +1,470 @@
+package hegel
+
+// Hegel property tests for osv-scalibr's semantic package, the version
+// parsers and comparators OSV uses for its ecosystems. Generated version
+// strings are compared by semantic and by the ecosystem's own
+// implementation, run as child processes speaking one line each way:
+//
+//   PyPI     python packaging.version (PEP 440's reference)
+//   Debian   dpkg --compare-versions
+//   Red Hat  rpm's rpmvercmp(), compiled from rpm's source into a shared
+//            library the python oracle loads (with rpm's parseEVR split)
+//   RubyGems ruby's Gem::Version
+//   npm      node-semver
+//   Maven    Maven's ComparableVersion (maven-artifact)
+//   Go       golang.org/x/mod/semver, in process
+//
+// and every ecosystem's parser is checked against its own promises: no
+// panic on any input, Compare antisymmetric and transitive, CompareStr
+// agreeing with Parse plus Compare.
+//
+// The generators (hegel_gen_test.go) are package-level values built from
+// the binding's combinators; each property draws one case record. The
+// shapes of the recorded bugs (bugs.toml, matched in known.go) are drawn at
+// their natural rate, so the wide properties that meet them fail naming
+// the bug and are the expected failures mapped to it; hegel_shapes_test.go
+// has one narrow property per bug over its shape region, and the pins
+// (hegel_pins_test.go) are the regression examples. HEGEL_NO_KNOWN=1
+// (noKnown, below) looks past the known shapes for a run of the rest.
+//
+// Needs node with semver installed under this directory, python3 with
+// packaging, ruby, java, dpkg and the artifacts the target's setup builds
+// (MavenOracle.class, maven-artifact.jar, librpmvercmp.so).
+
+import (
+	"bufio"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 300 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes at their natural
+// rate and a disagreement on one fails, naming the bug (the wide properties
+// are then the expected failures mapped to the bugs they find, beside the
+// pins); under HEGEL_NO_KNOWN=1 the shapes of known.go are consulted and
+// such a disagreement is counted and assumed away.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// mismatch reports a disagreement with the oracle, or a broken order, on a
+// case whose known shapes are named (none for a plain failure): a shape the
+// oracle cannot judge ("!" + reason) is counted and the case ends; a
+// recorded bug's shape is counted and fails naming the bug, or under
+// HEGEL_NO_KNOWN=1 is assumed away.
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	var bugs []string
+	for _, s := range shapes {
+		if strings.HasPrefix(s, "!") {
+			count("not judged: " + s[1:])
+			panic(collected{})
+		}
+		bugs = append(bugs, s)
+	}
+	if len(bugs) > 0 {
+		for _, b := range bugs {
+			count("shape " + b)
+		}
+		if noKnown {
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(bugs, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms (hegel-go has no weighted choice, biased coin, optional
+// with a probability or tuple combinator; these are the zoo's spellings).
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value (the
+// empty string for text) otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table of texts (the first is the shrink target).
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// joined is the texts of a list generator joined with sep.
+func joined(g hegel.Generator[[]string], sep string) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, sep) })
+}
+
+// cat draws one text from each generator and concatenates them (a tuple of
+// texts; a Composite only because the binding has no tuple combinator).
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// pair holds two independent draws as one value.
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// positions: an index into text of unknown length, taken modulo the length
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// ---------------------------------------------------------------------------
+// The oracles: child processes speaking one line each way.
+
+type oracle struct {
+	name string
+	mu   sync.Mutex
+	cmd  *exec.Cmd
+	in   *bufio.Writer
+	out  *bufio.Reader
+	err  error
+}
+
+func startOracle(name string, args ...string) *oracle {
+	o := &oracle{name: name}
+	cmd := exec.Command(args[0], args[1:]...)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		o.err = err
+		return o
+	}
+	if err := cmd.Start(); err != nil {
+		o.err = fmt.Errorf("starting the %s oracle: %v", name, err)
+		return o
+	}
+	o.cmd = cmd
+	o.in = bufio.NewWriter(stdin)
+	o.out = bufio.NewReaderSize(stdout, 1<<20)
+	return o
+}
+
+// exchange sends one line and reads one line back.
+func (o *oracle) exchange(line string) (string, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.err != nil {
+		return "", o.err
+	}
+	if _, err := o.in.WriteString(line + "\n"); err != nil {
+		return "", err
+	}
+	if err := o.in.Flush(); err != nil {
+		return "", err
+	}
+	resp, err := o.out.ReadString('\n')
+	if err != nil {
+		if err == io.EOF {
+			err = fmt.Errorf("the %s oracle went away", o.name)
+		}
+		o.err = err
+		return "", err
+	}
+	return strings.TrimRight(resp, "\n"), nil
+}
+
+// call sends one JSON request and returns the answer object.
+func (o *oracle) call(req map[string]any) (map[string]any, error) {
+	line, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	resp, err := o.exchange(string(line))
+	if err != nil {
+		return nil, err
+	}
+	var m map[string]any
+	if err := json.Unmarshal([]byte(resp), &m); err != nil {
+		return nil, fmt.Errorf("%s oracle: bad answer %q: %v", o.name, resp, err)
+	}
+	if e, isErr := m["error"]; isErr {
+		return nil, fmt.Errorf("%s oracle failed on %v: %v", o.name, req, e)
+	}
+	return m, nil
+}
+
+var (
+	pyOnce, rbOnce, nodeOnce, javaOnce sync.Once
+	py, rb, node, java                 *oracle
+)
+
+func pyOracle() *oracle {
+	pyOnce.Do(func() { py = startOracle("python", "python3", "-u", "oracle.py") })
+	return py
+}
+
+func rbOracle() *oracle {
+	rbOnce.Do(func() { rb = startOracle("ruby", "ruby", "oracle.rb") })
+	return rb
+}
+
+func nodeOracle() *oracle {
+	nodeOnce.Do(func() { node = startOracle("node", "node", "oracle.cjs") })
+	return node
+}
+
+func javaOracle() *oracle {
+	javaOnce.Do(func() { java = startOracle("java", "java", "-cp", "maven-artifact.jar:.", "MavenOracle") })
+	return java
+}
+
+// verdict is an oracle's answer on a pair: whether it accepts each side,
+// and the comparison when it accepts both.
+type verdict struct {
+	aOK, bOK   bool
+	cmp        int
+	aErr, bErr string
+	// node-semver's loose mode, for the record.
+	looseOK  bool
+	looseCmp int
+}
+
+func (v verdict) String() string {
+	if v.aOK && v.bOK {
+		return fmt.Sprintf("cmp %d", v.cmp)
+	}
+	return fmt.Sprintf("a %s, b %s", accepts(v.aOK, v.aErr), accepts(v.bOK, v.bErr))
+}
+
+func accepts(ok bool, err string) string {
+	if ok {
+		return "ok"
+	}
+	return "invalid (" + err + ")"
+}
+
+func jsonVerdict(t testing.TB, o *oracle, req map[string]any) verdict {
+	m, err := o.call(req)
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	v := verdict{}
+	v.aOK, _ = m["a_ok"].(bool)
+	v.bOK, _ = m["b_ok"].(bool)
+	c, _ := m["cmp"].(float64)
+	v.cmp = int(c)
+	v.aErr, _ = m["a_err"].(string)
+	v.bErr, _ = m["b_err"].(string)
+	v.looseOK, _ = m["loose_ok"].(bool)
+	lc, _ := m["loose_cmp"].(float64)
+	v.looseCmp = int(lc)
+	return v
+}
+
+func pypiOracle(t testing.TB, a, b string) verdict {
+	return jsonVerdict(t, pyOracle(), map[string]any{"eco": "pypi", "a": a, "b": b})
+}
+
+func debianOracle(t testing.TB, a, b string) verdict {
+	return jsonVerdict(t, pyOracle(), map[string]any{"eco": "debian", "a": a, "b": b})
+}
+
+func redhatOracle(t testing.TB, a, b string) verdict {
+	return jsonVerdict(t, pyOracle(), map[string]any{"eco": "redhat", "a": a, "b": b})
+}
+
+func rubygemsOracle(t testing.TB, a, b string) verdict {
+	return jsonVerdict(t, rbOracle(), map[string]any{"a": a, "b": b})
+}
+
+func npmOracle(t testing.TB, a, b string) verdict {
+	return jsonVerdict(t, nodeOracle(), map[string]any{"a": a, "b": b})
+}
+
+func mavenOracle(t testing.TB, a, b string) verdict {
+	line := base64.StdEncoding.EncodeToString([]byte(a)) + " " + base64.StdEncoding.EncodeToString([]byte(b))
+	resp, err := javaOracle().exchange(line)
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	if strings.HasPrefix(resp, "error ") {
+		return verdict{aOK: false, bOK: false, aErr: resp, bErr: resp}
+	}
+	c, err := strconv.Atoi(resp)
+	if err != nil {
+		t.Fatalf("maven oracle: bad answer %q", resp)
+	}
+	return verdict{aOK: true, bOK: true, cmp: c}
+}
+
+func sign(x int) int {
+	switch {
+	case x < 0:
+		return -1
+	case x > 0:
+		return 1
+	}
+	return 0
+}
diff --git a/semantic/hegel/known.go b/semantic/hegel/known.go
new file mode 100644
index 0000000..4ea4651
--- /dev/null
+++ b/semantic/hegel/known.go
@@ -0,0 +1,125 @@
+package hegel
+
+// The shapes of the known bugs of the semantic package (ids from the zoo's
+// bugs.toml), and of anything an oracle cannot judge. The properties draw
+// these shapes at their natural rate and fail on them naming the bug; under
+// HEGEL_NO_KNOWN=1 a disagreement with one of these shapes is counted and
+// assumed away instead (see mismatch in hegel_test.go).
+
+import (
+	"regexp"
+	"strings"
+)
+
+var (
+	// A Maven qualifier introduced by a dot and followed by a digit or by
+	// the end of the version (a trailing dot allowed), which Maven since
+	// 3.8.7/3.9.0 (MNG-7644) reads as introduced by a hyphen.
+	mavenDotQualifier = regexp.MustCompile(`\.[^0-9.\-]+([0-9]|\.?$)`)
+	// A Maven null item (0, empty, ga/final/release) followed by a sub-list:
+	// a hyphen, or a dot-segment holding a letter-to-digit transition, or
+	// (for the words) a digit. Maven's normalize drops the null item and the
+	// sub-list nests one level deeper; semantic keeps it.
+	mavenNullBeforeSublist = regexp.MustCompile(`(?i)(^|[-.])-|(^|[-.a-z])0+-|(^|[-.0-9])(ga|final|release)[-0-9]|(^|[-.])(0*|ga|final|release)\.[^0-9.\-]+[0-9]`)
+	// A Maven version of zeros and dots only, which Maven normalizes to
+	// nothing.
+	mavenAllZero = regexp.MustCompile(`^[0.]*$`)
+	// A RubyGems numeric segment with a leading zero.
+	rubyLeadingZero = regexp.MustCompile(`(^|\.)0[0-9]`)
+	// apk-tools' version grammar (apk_version_validate).
+	// An Alpine numeric component after the first with a leading zero, which
+	// apk compares as a string (a fraction) rather than a number.
+	alpineLeadingZero = regexp.MustCompile(`\.0[0-9]`)
+	alpineValid       = regexp.MustCompile(`^[0-9]+(\.[0-9]+)*[a-z]?(_(alpha|beta|pre|rc|cvs|svn|git|hg|p)[0-9]*)*(~[0-9a-f]+)?(-r[0-9]+)?$`)
+)
+
+// hasOuterSpace reports whether s starts or ends with whitespace.
+func hasOuterSpace(s string) bool {
+	return strings.TrimSpace(s) != s
+}
+
+func isAlpineEcosystem(eco string) bool {
+	switch eco {
+	case "Alpine", "Alpaquita", "Chainguard", "MinimOS", "Wolfi", "BellSoft Hardened Containers":
+		return true
+	}
+	return false
+}
+
+// known holds the shapes of the recorded bugs.
+type known struct{}
+
+// Known is the set of shapes.
+var Known known
+
+// explains names the recorded bugs whose shape the pair (a, b) has for the
+// ecosystem (every one of them, since a pair can have several), and a shape
+// the oracle cannot judge as "!" + reason (none at present).
+func (known) explains(eco, a, b string) []string {
+	var shapes []string
+	has := func(id string, ok bool) {
+		if ok {
+			shapes = append(shapes, id)
+		}
+	}
+	switch eco {
+	case "RubyGems":
+		has("osv-scalibr/1", hasOuterSpace(a) || hasOuterSpace(b))
+		has("osv-scalibr/2", strings.Contains(a, "-") || strings.Contains(b, "-"))
+		has("osv-scalibr/7", rubyLeadingZero.MatchString(a) || rubyLeadingZero.MatchString(b) || a == "" || b == "")
+	case "Maven":
+		has("osv-scalibr/3", mavenDotQualifier.MatchString(a) || mavenDotQualifier.MatchString(b))
+		has("osv-scalibr/4", mavenNullBeforeSublist.MatchString(a) || mavenNullBeforeSublist.MatchString(b))
+		has("osv-scalibr/8", mavenAllZero.MatchString(a) || mavenAllZero.MatchString(b))
+	case "Red Hat":
+		has("osv-scalibr/5", strings.Count(a, "-") > 1 || strings.Count(b, "-") > 1)
+		has("osv-scalibr/9", redhatEmptyLikeComponent(a) || redhatEmptyLikeComponent(b))
+	}
+	return shapes
+}
+
+// redhatEmptyLikeComponent reports whether a component of the EVR (split
+// as semantic splits it) is empty, holds no alphanumerics, or starts with
+// a tilde: the shapes where rpmvercmp's stripping of separators and its
+// tilde rule decide before emptiness does.
+func redhatEmptyLikeComponent(s string) bool {
+	epoch, vr, hasColon := strings.Cut(s, ":")
+	if !hasColon || strings.Trim(epoch, "0123456789") != "" {
+		vr = s
+		epoch = "0"
+	}
+	version, release, hasRelease := strings.Cut(vr, "-")
+	parts := []string{epoch, version}
+	if hasRelease {
+		parts = append(parts, release)
+	}
+	for _, p := range parts {
+		if p == "" || strings.HasPrefix(p, "~") || !strings.ContainsAny(p, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789") {
+			return true
+		}
+	}
+	return false
+}
+
+// explainsOrder names the recorded bugs whose shape the versions have for
+// the order properties of the ecosystem: a version apk would reject
+// (osv-scalibr/6) and a numeric component with a leading zero
+// (osv-scalibr/10) in the Alpine family.
+func (known) explainsOrder(eco string, versions ...string) []string {
+	if !isAlpineEcosystem(eco) {
+		return nil
+	}
+	var shapes []string
+	invalid, leadingZero := false, false
+	for _, v := range versions {
+		invalid = invalid || !alpineValid.MatchString(v)
+		leadingZero = leadingZero || alpineLeadingZero.MatchString(v)
+	}
+	if invalid {
+		shapes = append(shapes, "osv-scalibr/6")
+	}
+	if leadingZero {
+		shapes = append(shapes, "osv-scalibr/10")
+	}
+	return shapes
+}
diff --git a/semantic/hegel/oracle.cjs b/semantic/hegel/oracle.cjs
new file mode 100644
index 0000000..f034154
--- /dev/null
+++ b/semantic/hegel/oracle.cjs
@@ -0,0 +1,32 @@
+// The npm oracle for osv-scalibr's semantic package: node-semver, the
+// reference implementation of the npm ecosystem's versions (strict parsing;
+// "loose": true is tried as well and reported separately). One JSON object
+// per line on stdin: {"a": s, "b": s}; one per line on stdout:
+// {"a_ok", "b_ok", "cmp", "a_err", "b_err", "loose_ok", "loose_cmp"}.
+"use strict";
+const readline = require("readline");
+const semver = require("semver");
+
+const rl = readline.createInterface({ input: process.stdin, terminal: false });
+rl.on("line", (line) => {
+  let resp;
+  try {
+    const req = JSON.parse(line);
+    const a = semver.parse(req.a);
+    const b = semver.parse(req.b);
+    resp = {
+      a_ok: a !== null,
+      b_ok: b !== null,
+      cmp: a !== null && b !== null ? semver.compare(a, b) : 0,
+      a_err: a === null ? "invalid" : "",
+      b_err: b === null ? "invalid" : "",
+    };
+    const la = semver.parse(req.a, { loose: true });
+    const lb = semver.parse(req.b, { loose: true });
+    resp.loose_ok = la !== null && lb !== null;
+    resp.loose_cmp = resp.loose_ok ? semver.compare(la, lb) : 0;
+  } catch (e) {
+    resp = { error: String(e && e.message ? e.message : e) };
+  }
+  process.stdout.write(JSON.stringify(resp) + "\n");
+});
diff --git a/semantic/hegel/oracle.py b/semantic/hegel/oracle.py
new file mode 100644
index 0000000..d3a0f91
--- /dev/null
+++ b/semantic/hegel/oracle.py
@@ -0,0 +1,143 @@
+#!/usr/bin/env python3
+"""Oracles for osv-scalibr's semantic package that live in python or C:
+
+  PyPI    - packaging.version.Version (the reference implementation of PEP 440)
+  Debian  - dpkg --compare-versions (the reference; run as a subprocess)
+  Red Hat - rpm's own rpmvercmp() compiled into librpmvercmp.so (the target's
+            setup fetches rpmio/rpmvercmp.c from rpm's repository), with the
+            [epoch:]version[-release] split of rpm's parseEVR() done here
+
+One JSON object per line on stdin: {"eco": "pypi"|"debian"|"redhat", "a": s, "b": s}.
+One per line on stdout: {"a_ok": bool, "b_ok": bool, "cmp": -1|0|1, "a_err": s, "b_err": s};
+cmp is only meaningful when both are ok (Red Hat and Debian compare anything).
+"""
+import ctypes
+import json
+import os
+import subprocess
+import sys
+
+from packaging.version import InvalidVersion, Version
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+_rpm = None
+
+
+def rpmvercmp(a, b):
+    global _rpm
+    if _rpm is None:
+        _rpm = ctypes.CDLL(os.path.join(HERE, "librpmvercmp.so"))
+        _rpm.rpmvercmp.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
+        _rpm.rpmvercmp.restype = ctypes.c_int
+    return _rpm.rpmvercmp(a.encode("utf-8"), b.encode("utf-8"))
+
+
+def parse_evr(evr):
+    """rpm's parseEVR: digits then ':' is the epoch; the last '-' starts the release."""
+    i = 0
+    while i < len(evr) and evr[i].isdigit() and evr[i].isascii():
+        i += 1
+    if i < len(evr) and evr[i] == ":":
+        epoch = evr[:i] or "0"
+        rest = evr[i + 1:]
+    else:
+        epoch = None
+        rest = evr
+    se = rest.rfind("-")
+    if se >= 0:
+        return epoch, rest[:se], rest[se + 1:]
+    return epoch, rest, None
+
+
+def compare_values(x, y):
+    if x is None and y is None:
+        return 0
+    if x is not None and y is None:
+        return 1
+    if x is None and y is not None:
+        return -1
+    return rpmvercmp(x, y)
+
+
+def rpmver_cmp(a, b):
+    """rpm's rpmverCmp over rpmverParse: a missing epoch compares as "0"."""
+    e1, v1, r1 = parse_evr(a)
+    e2, v2, r2 = parse_evr(b)
+    rc = compare_values(e1 or "0", e2 or "0")
+    if rc == 0:
+        rc = compare_values(v1, v2)
+        if rc == 0:
+            rc = compare_values(r1, r2)
+    return rc
+
+
+def sign(n):
+    return (n > 0) - (n < 0)
+
+
+def dpkg(a, op, b):
+    p = subprocess.run(["dpkg", "--compare-versions", a, op, b], capture_output=True, text=True, errors="replace")
+    return p.returncode, p.stderr
+
+
+def debian(a, b):
+    if a == "" or b == "":
+        # dpkg: "version string is empty" is an error, not a comparison.
+        return {"a_ok": a != "", "b_ok": b != "", "cmp": 0, "a_err": "empty" if a == "" else "", "b_err": "empty" if b == "" else ""}
+    rc, err = dpkg(a, "lt", b)
+    if rc not in (0, 1):
+        return {"a_ok": False, "b_ok": False, "cmp": 0, "a_err": err.strip(), "b_err": err.strip()}
+    if rc == 0:
+        cmp = -1
+    else:
+        rc2, _ = dpkg(a, "gt", b)
+        cmp = 1 if rc2 == 0 else 0
+    a_bad = "version '%s' has bad syntax" % a in err
+    b_bad = "version '%s' has bad syntax" % b in err
+    if a == b and "has bad syntax" in err:
+        a_bad = b_bad = True
+    return {"a_ok": not a_bad, "b_ok": not b_bad, "cmp": cmp, "a_err": err.strip() if a_bad else "", "b_err": err.strip() if b_bad else ""}
+
+
+def pypi(a, b):
+    out = {"a_ok": True, "b_ok": True, "cmp": 0, "a_err": "", "b_err": ""}
+    va = vb = None
+    try:
+        va = Version(a)
+    except InvalidVersion as e:
+        out["a_ok"], out["a_err"] = False, str(e)
+    try:
+        vb = Version(b)
+    except InvalidVersion as e:
+        out["b_ok"], out["b_err"] = False, str(e)
+    if va is not None and vb is not None:
+        out["cmp"] = -1 if va < vb else (1 if va > vb else 0)
+    return out
+
+
+def handle(req):
+    eco, a, b = req["eco"], req["a"], req["b"]
+    if eco == "pypi":
+        return pypi(a, b)
+    if eco == "debian":
+        return debian(a, b)
+    if eco == "redhat":
+        return {"a_ok": True, "b_ok": True, "cmp": sign(rpmver_cmp(a, b)), "a_err": "", "b_err": ""}
+    return {"error": "unknown ecosystem %r" % eco}
+
+
+def main():
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            resp = handle(json.loads(line))
+        except Exception as e:  # noqa: BLE001
+            resp = {"error": "%s: %s" % (type(e).__name__, e)}
+        sys.stdout.write(json.dumps(resp) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/semantic/hegel/oracle.rb b/semantic/hegel/oracle.rb
new file mode 100644
index 0000000..ce85d5e
--- /dev/null
+++ b/semantic/hegel/oracle.rb
@@ -0,0 +1,24 @@
+# The RubyGems oracle for osv-scalibr's semantic package: Gem::Version, the
+# reference. One JSON object per line on stdin: {"a": s, "b": s}; one per line
+# on stdout: {"a_ok": bool, "b_ok": bool, "cmp": -1|0|1, "a_err": s, "b_err": s}.
+require "json"
+
+$stdout.sync = true
+$stdin.each_line do |line|
+  line = line.strip
+  next if line.empty?
+  begin
+    req = JSON.parse(line)
+    a = req["a"]
+    b = req["b"]
+    a_ok = Gem::Version.correct?(a)
+    b_ok = Gem::Version.correct?(b)
+    cmp = 0
+    if a_ok && b_ok
+      cmp = Gem::Version.new(a) <=> Gem::Version.new(b)
+    end
+    puts JSON.generate({ "a_ok" => a_ok, "b_ok" => b_ok, "cmp" => cmp, "a_err" => a_ok ? "" : "malformed", "b_err" => b_ok ? "" : "malformed" })
+  rescue => e
+    puts JSON.generate({ "error" => "#{e.class}: #{e.message}" })
+  end
+end
