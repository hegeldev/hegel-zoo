--- /dev/null
+++ b/semantic/hegel/rpmshim/rpm/rpmstring.h
@@ -0,0 +1,10 @@
+/* Shim for building rpm's rpmio/rpmvercmp.c on its own: the ASCII-only
+ * character classes and rstreq of rpm's rpmstring.h, as rpm defines them. */
+#include <string.h>
+
+static inline int rislower(int c) { return (c >= 'a' && c <= 'z'); }
+static inline int risupper(int c) { return (c >= 'A' && c <= 'Z'); }
+static inline int risalpha(int c) { return (rislower(c) || risupper(c)); }
+static inline int risdigit(int c) { return (c >= '0' && c <= '9'); }
+static inline int risalnum(int c) { return (risalpha(c) || risdigit(c)); }
+static inline int rstreq(const char *s1, const char *s2) { return (strcmp(s1, s2) == 0); }
