+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+
+import org.apache.maven.artifact.versioning.ComparableVersion;
+
+/**
+ * The Maven oracle for osv-scalibr's semantic package: Maven's own
+ * ComparableVersion (maven-artifact, fetched by the target's setup). One
+ * request per line on stdin: two base64 strings separated by a space; one
+ * line per answer: -1, 0 or 1 (ComparableVersion accepts any string).
+ */
+public class MavenOracle {
+    public static void main(String[] args) throws Exception {
+        BufferedReader in = new BufferedReader(new InputStreamReader(System.in, StandardCharsets.UTF_8));
+        Base64.Decoder dec = Base64.getDecoder();
+        String line;
+        while ((line = in.readLine()) != null) {
+            line = line.trim();
+            if (line.isEmpty()) {
+                continue;
+            }
+            String[] parts = line.split(" ", -1);
+            String a = new String(dec.decode(parts[0]), StandardCharsets.UTF_8);
+            String b = new String(dec.decode(parts[1]), StandardCharsets.UTF_8);
+            int c;
+            try {
+                c = new ComparableVersion(a).compareTo(new ComparableVersion(b));
+            } catch (RuntimeException e) {
+                System.out.println("error " + e);
+                System.out.flush();
+                continue;
+            }
+            System.out.println(Integer.signum(c));
+            System.out.flush();
+        }
+    }
+}
