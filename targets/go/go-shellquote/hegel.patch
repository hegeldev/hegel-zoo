+package shellquote_test
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	shellquote "github.com/kballard/go-shellquote"
+	"hegel.dev/go/hegel"
+)
+
+// Property-based tests for kballard/go-shellquote. The oracles: bash 5.2 (the
+// line as the body of an array assignment, so unquoted newlines are allowed),
+// dash and busybox ash (the line as the operands of `set --`) for Split on
+// lines without expansions, comments or operators; the three shells for
+// Join's contract ("if passed to /bin/sh, the resulting string will be split
+// back into the original arguments"); a model of the documented splitting
+// rules for Split on arbitrary text; and Split∘Join as the identity. Collect
+// mode (GO_SHELLQUOTE_COLLECT=1) prints every disagreement instead of failing.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("GO_SHELLQUOTE_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ------------------------------------------------------------------ oracles
+
+type shell struct {
+	name string
+	argv []string
+}
+
+var (
+	bashShell = shell{"bash", []string{"bash", "-c"}}
+	dashShell = shell{"dash", []string{"dash", "-c"}}
+	ashShell  = shell{"busybox sh", []string{"busybox", "sh", "-c"}}
+	shShells  = []shell{dashShell, ashShell}
+	allShells = []shell{bashShell, dashShell, ashShell}
+)
+
+// shellWords splits line the way the shell does, with globbing (and, in bash,
+// brace expansion) turned off: bash reads it as the body of `a=( … )`, the
+// POSIX shells as the operands of `set --`. A non-zero exit is an error.
+func shellWords(sh shell, line string) ([]string, error) {
+	var script string
+	if sh.name == "bash" {
+		script = "set -f\nset +B\na=(" + line + "\n)\nprintf '%s\\n' \"${#a[@]}\"\nif ((${#a[@]})); then printf '%s\\0' \"${a[@]}\"; fi\n"
+	} else {
+		script = "set -f\nset -- " + line + "\nprintf '%s\\n' \"$#\"\nif [ \"$#\" -gt 0 ]; then printf '%s\\0' \"$@\"; fi\n"
+	}
+	cmd := exec.Command(sh.argv[0], append(sh.argv[1:], script)...)
+	cmd.Env = []string{"PATH=" + os.Getenv("PATH"), "LC_ALL=C.UTF-8"}
+	var out, stderr bytes.Buffer
+	cmd.Stdout = &out
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("%s: %v: %s", sh.name, err, strings.TrimSpace(stderr.String()))
+	}
+	head, rest, ok := bytes.Cut(out.Bytes(), []byte{'\n'})
+	if !ok {
+		return nil, fmt.Errorf("%s: no output", sh.name)
+	}
+	count, err := strconv.Atoi(string(head))
+	if err != nil {
+		return nil, fmt.Errorf("%s: bad count %q", sh.name, head)
+	}
+	words := []string{}
+	if count > 0 {
+		parts := bytes.Split(rest, []byte{0})
+		if len(parts) != count+1 || len(parts[count]) != 0 {
+			return nil, fmt.Errorf("%s: %d words announced, output %q", sh.name, count, rest)
+		}
+		for _, p := range parts[:count] {
+			words = append(words, string(p))
+		}
+	}
+	return words, nil
+}
+
+// ------------------------------------------------------------- generators
+
+// Ordinary characters for Split and the shells alike when unquoted (no `#`
+// or `~`, which the shells treat specially at the start of a word — they are
+// added inside words below; no quotes, backslash, `$`, backtick, operators,
+// blanks).
+var bareRunes = []rune("abcxyzXYZ0123456789-_./:=@%^+,{}*?!]éüßÆ日本語🍺\r")
+
+// `#` and `~` are ordinary anywhere but at the start of a word.
+var innerRunes = []rune("abcxyz0123456789-_.#~=:éü")
+
+// Characters whose backslash escape is the character itself, for Split and
+// the shells (not a newline, which is a line continuation, handled apart).
+var escapableRunes = []rune("\\\"'$` ;&|<>()#{}*?~[]abcxyzXYZ0123456789-_.é日\t")
+
+// Anything but a single quote and NUL may appear inside single quotes.
+var singleRunes = []rune("abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#$`\\\"()<>|&; \t\n\réüßÆ日本語🍺")
+
+// Inside double quotes, without a backslash, `$` or backtick.
+var doubleRunes = []rune("abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#'()<>|&; \t\n\réüßÆ日本語🍺")
+
+// After a backslash inside double quotes: the four specials (removed
+// backslash) and ordinary characters (kept backslash).
+var doubleEscapes = []rune("$`\"\\abcxyz0 '#-é日")
+
+func genRunes(tc hegel.TestCase, pool []rune, lo, hi int) string {
+	var sb strings.Builder
+	for i, k := 0, n(tc, lo, hi); i < k; i++ {
+		sb.WriteRune(pick(tc, pool))
+	}
+	return sb.String()
+}
+
+// genWord builds one word of 1–3 pieces: bare text, escapes, a line
+// continuation, single- and double-quoted text.
+func genWord(tc hegel.TestCase) string {
+	var sb strings.Builder
+	for i, k := 0, n(tc, 1, 3); i < k; i++ {
+		switch w := n(tc, 1, 100); {
+		case w <= 40:
+			if sb.Len() == 0 {
+				sb.WriteRune(pick(tc, bareRunes))
+			}
+			sb.WriteString(genRunes(tc, append(bareRunes, innerRunes...), 0, 6))
+		case w <= 55:
+			sb.WriteByte('\\')
+			if chance(tc, 10) {
+				sb.WriteString("\xff") // an invalid byte is escaped as itself too
+			} else {
+				sb.WriteRune(pick(tc, escapableRunes))
+			}
+		case w <= 57:
+			if sb.Len() == 0 {
+				sb.WriteRune(pick(tc, bareRunes))
+			}
+			sb.WriteString("\xff\xfe") // invalid UTF-8 is ordinary text
+		case w <= 60:
+			if sb.Len() == 0 {
+				sb.WriteRune(pick(tc, bareRunes))
+			}
+			sb.WriteString("\\\n")
+		case w <= 80:
+			sb.WriteByte('\'')
+			sb.WriteString(genRunes(tc, singleRunes, 0, 8))
+			sb.WriteByte('\'')
+		default:
+			sb.WriteByte('"')
+			for j, m := 0, n(tc, 0, 8); j < m; j++ {
+				if chance(tc, 20) {
+					sb.WriteByte('\\')
+					sb.WriteRune(pick(tc, doubleEscapes))
+				} else if chance(tc, 5) {
+					sb.WriteString("\\\n")
+				} else {
+					sb.WriteRune(pick(tc, doubleRunes))
+				}
+			}
+			sb.WriteByte('"')
+		}
+	}
+	return sb.String()
+}
+
+var blanks = []string{" ", "\t", "  ", " \t", "\t\t"}
+var blanksNL = append([]string{"\n", "\n ", " \n\n"}, blanks...)
+
+// genLine joins 0–5 words with separators; with newlines only if allowed.
+func genLine(tc hegel.TestCase, newlines bool) string {
+	seps := blanks
+	if newlines {
+		seps = blanksNL
+	}
+	var sb strings.Builder
+	if chance(tc, 20) {
+		sb.WriteString(pick(tc, seps))
+	}
+	for i, k := 0, n(tc, 0, 5); i < k; i++ {
+		if i > 0 {
+			sb.WriteString(pick(tc, seps))
+		}
+		sb.WriteString(genWord(tc))
+	}
+	if chance(tc, 20) {
+		sb.WriteString(pick(tc, seps))
+	}
+	return sb.String()
+}
+
+// Everything, for Join's arguments and the grammar model's input.
+var anyRunes = []rune("abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#$`\\\"'()<>|&; \t\n\réüßÆ日本語🍺")
+
+func genAny(tc hegel.TestCase, lo, hi int) string {
+	s := genRunes(tc, anyRunes, lo, hi)
+	if chance(tc, 5) {
+		s += "\xff"
+	}
+	return s
+}
+
+func genWords(tc hegel.TestCase) []string {
+	words := make([]string, n(tc, 0, 5))
+	for i := range words {
+		words[i] = genAny(tc, 0, 6)
+	}
+	return words
+}
+
+// ------------------------------------------------------------- properties
+
+func TestHegelSplitAgreesWithBash(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		line := genLine(ht, true)
+		note(ht, "line=%q", line)
+		want, werr := shellWords(bashShell, line)
+		got, err := shellquote.Split(line)
+		if (werr == nil) != (err == nil) {
+			fail(ht, "Split(%q) = %q, %v; bash: %q, %v", line, got, err, want, werr)
+		}
+		if err == nil && !reflect.DeepEqual(got, want) {
+			fail(ht, "Split(%q) = %q, bash gives %q", line, got, want)
+		}
+	})
+}
+
+func TestHegelSplitAgreesWithSh(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		line := genLine(ht, false)
+		sh := pick(ht, shShells)
+		note(ht, "shell=%s line=%q", sh.name, line)
+		want, werr := shellWords(sh, line)
+		got, err := shellquote.Split(line)
+		if (werr == nil) != (err == nil) {
+			fail(ht, "Split(%q) = %q, %v; %s: %q, %v", line, got, err, sh.name, want, werr)
+		}
+		if err == nil && !reflect.DeepEqual(got, want) {
+			fail(ht, "Split(%q) = %q, %s gives %q", line, got, sh.name, want)
+		}
+	})
+}
+
+// isHashWord reports whether a Join argument begins a comment when passed to
+// a shell unquoted (go-shellquote/1 pins it).
+func isHashWord(w string) bool { return strings.HasPrefix(w, "#") }
+
+func TestHegelJoinRoundTripsThroughTheShells(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		words := genWords(ht)
+		for i, w := range words {
+			if isHashWord(w) {
+				words[i] = "x" + w
+			}
+		}
+		joined := shellquote.Join(words...)
+		sh := pick(ht, allShells)
+		note(ht, "shell=%s words=%q joined=%q", sh.name, words, joined)
+		got, err := shellWords(sh, joined)
+		if err != nil {
+			fail(ht, "Join(%q) = %q, which %s rejects: %v", words, joined, sh.name, err)
+		}
+		if !reflect.DeepEqual(got, words) {
+			fail(ht, "Join(%q) = %q, which %s splits into %q", words, joined, sh.name, got)
+		}
+	})
+}
+
+func TestHegelSplitInvertsJoin(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		words := genWords(ht)
+		joined := shellquote.Join(words...)
+		note(ht, "words=%q joined=%q", words, joined)
+		got, err := shellquote.Split(joined)
+		if err != nil {
+			fail(ht, "Split(Join(%q) = %q) failed: %v", words, joined, err)
+		}
+		if !reflect.DeepEqual(got, words) {
+			fail(ht, "Split(Join(%q) = %q) = %q", words, joined, got)
+		}
+		// Join's output is "nice": a word without blanks or quotes is backslash-escaped, never quoted
+		if len(words) == 1 && words[0] != "" && !strings.ContainsAny(words[0], " \t\n'") && strings.Contains(joined, "'") {
+			fail(ht, "Join(%q) = %q quotes a word that needs no quoting", words, joined)
+		}
+	})
+}
+
+// modelSplit is the documented rule set: blanks, tabs and newlines separate
+// words; a backslash escapes the next character (an escaped newline is
+// dropped); single quotes are literal to the next single quote; inside double
+// quotes a backslash escapes only `$`, backtick, `"`, backslash and newline
+// (the newline being dropped); nothing else is special.
+func modelSplit(input string) ([]string, error) {
+	words := []string{}
+	var buf strings.Builder
+	inWord := false
+	i := 0
+	for i < len(input) {
+		c := input[i]
+		switch c {
+		case ' ', '\t', '\n':
+			if inWord {
+				words = append(words, buf.String())
+				buf.Reset()
+				inWord = false
+			}
+			i++
+		case '\\':
+			if i+1 >= len(input) {
+				return nil, shellquote.UnterminatedEscapeError
+			}
+			if input[i+1] == '\n' {
+				i += 2
+				continue
+			}
+			_, l := utf8.DecodeRuneInString(input[i+1:])
+			buf.WriteString(input[i+1 : i+1+l])
+			inWord = true
+			i += 1 + l
+		case '\'':
+			j := strings.IndexByte(input[i+1:], '\'')
+			if j < 0 {
+				return nil, shellquote.UnterminatedSingleQuoteError
+			}
+			buf.WriteString(input[i+1 : i+1+j])
+			inWord = true
+			i += j + 2
+		case '"':
+			i++
+			inWord = true
+			closed := false
+			for i < len(input) {
+				d := input[i]
+				if d == '"' {
+					closed = true
+					i++
+					break
+				}
+				if d == '\\' && i+1 < len(input) {
+					e := input[i+1]
+					if e == '\n' {
+						i += 2
+						continue
+					}
+					if strings.IndexByte("$`\"\\", e) >= 0 {
+						buf.WriteByte(e)
+						i += 2
+						continue
+					}
+				}
+				buf.WriteByte(d)
+				i++
+			}
+			if !closed {
+				return nil, shellquote.UnterminatedDoubleQuoteError
+			}
+		default:
+			buf.WriteByte(c)
+			inWord = true
+			i++
+		}
+	}
+	if inWord {
+		words = append(words, buf.String())
+	}
+	return words, nil
+}
+
+func TestHegelSplitFollowsTheDocumentedRules(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		input := genAny(ht, 0, 12)
+		if chance(ht, 30) {
+			input = genLine(ht, true) + genAny(ht, 0, 3)
+		}
+		note(ht, "input=%q", input)
+		want, werr := modelSplit(input)
+		got, err := shellquote.Split(input)
+		if !errors.Is(err, werr) {
+			fail(ht, "Split(%q) = %q, %v; the rules say %q, %v", input, got, err, want, werr)
+		}
+		if err == nil && !reflect.DeepEqual(got, want) {
+			fail(ht, "Split(%q) = %q, the rules say %q", input, got, want)
+		}
+	})
+}
+
+// ------------------------------------------------------------------ pins
+
+// go-shellquote/1
+func TestHegelPinJoinQuotesLeadingHash(t *testing.T) {
+	defer guard(t)
+	for _, words := range [][]string{{"#"}, {"#!/bin/sh"}, {"echo", "#x"}} {
+		joined := shellquote.Join(words...)
+		for _, sh := range allShells {
+			got, err := shellWords(sh, joined)
+			if err != nil {
+				t.Errorf("Join(%q) = %q: %s: %v", words, joined, sh.name, err)
+				continue
+			}
+			if !reflect.DeepEqual(got, words) {
+				t.Errorf("Join(%q) = %q, which %s splits into %q", words, joined, sh.name, got)
+			}
+		}
+	}
+}
