+package shellquote_test
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"reflect"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	shellquote "github.com/kballard/go-shellquote"
+	"hegel.dev/go/hegel"
+)
+
+// Property-based tests for kballard/go-shellquote. The oracles: bash 5.2 (the
+// line as the body of an array assignment, so unquoted newlines are allowed),
+// dash and busybox ash (the line as the operands of `set --`) for Split on
+// lines without expansions, comments or operators; the three shells for
+// Join's contract ("if passed to /bin/sh, the resulting string will be split
+// back into the original arguments"); a model of the documented splitting
+// rules for Split on arbitrary text; and Split∘Join as the identity.
+
+// hegelOpts passes HEGEL_TEST_CASES through (hegel-go reads no environment variable).
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel test; a panic in the code under test fails the test case
+// instead of aborting the test binary (hegel-go re-raises panics after shrinking).
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if tn := fmt.Sprintf("%T", r); strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ------------------------------------------------------------------ oracles
+
+type shell struct {
+	name string
+	argv []string
+}
+
+var (
+	bashShell = shell{"bash", []string{"bash", "-c"}}
+	dashShell = shell{"dash", []string{"dash", "-c"}}
+	ashShell  = shell{"busybox sh", []string{"busybox", "sh", "-c"}}
+	shShells  = []shell{dashShell, ashShell}
+	allShells = []shell{bashShell, dashShell, ashShell}
+)
+
+// shellWords splits line the way the shell does, with globbing (and, in bash,
+// brace expansion) turned off: bash reads it as the body of `a=( … )`, the
+// POSIX shells as the operands of `set --`. A non-zero exit is an error.
+func shellWords(sh shell, line string) ([]string, error) {
+	var script string
+	if sh.name == "bash" {
+		script = "set -f\nset +B\na=(" + line + "\n)\nprintf '%s\\n' \"${#a[@]}\"\nif ((${#a[@]})); then printf '%s\\0' \"${a[@]}\"; fi\n"
+	} else {
+		script = "set -f\nset -- " + line + "\nprintf '%s\\n' \"$#\"\nif [ \"$#\" -gt 0 ]; then printf '%s\\0' \"$@\"; fi\n"
+	}
+	cmd := exec.Command(sh.argv[0], append(sh.argv[1:], script)...)
+	cmd.Env = []string{"PATH=" + os.Getenv("PATH"), "LC_ALL=C.UTF-8"}
+	var out, stderr bytes.Buffer
+	cmd.Stdout = &out
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("%s: %v: %s", sh.name, err, strings.TrimSpace(stderr.String()))
+	}
+	head, rest, ok := bytes.Cut(out.Bytes(), []byte{'\n'})
+	if !ok {
+		return nil, fmt.Errorf("%s: no output", sh.name)
+	}
+	count, err := strconv.Atoi(string(head))
+	if err != nil {
+		return nil, fmt.Errorf("%s: bad count %q", sh.name, head)
+	}
+	words := []string{}
+	if count > 0 {
+		parts := bytes.Split(rest, []byte{0})
+		if len(parts) != count+1 || len(parts[count]) != 0 {
+			return nil, fmt.Errorf("%s: %d words announced, output %q", sh.name, count, rest)
+		}
+		for _, p := range parts[:count] {
+			words = append(words, string(p))
+		}
+	}
+	return words, nil
+}
+
+// ------------------------------------------------------------- generators
+
+// The character pools. Ordinary characters for Split and the shells alike when
+// unquoted (no `#` or `~`, which the shells treat specially at the start of a word;
+// no quotes, backslash, `$`, backtick, operators, blanks).
+const (
+	bareRunes = "abcxyzXYZ0123456789-_./:=@%^+,{}*?!]éüßÆ日本語🍺\r"
+	// `#` and `~` are ordinary anywhere but at the start of a word.
+	innerRunes = "abcxyz0123456789-_.#~=:éü"
+	// Characters whose backslash escape is the character itself (not a newline,
+	// which is a line continuation, handled apart).
+	escapableRunes = "\\\"'$` ;&|<>()#{}*?~[]abcxyzXYZ0123456789-_.é日\t"
+	// Anything but a single quote and NUL may appear inside single quotes.
+	singleRunes = "abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#$`\\\"()<>|&; \t\n\réüßÆ日本語🍺"
+	// Inside double quotes, without a backslash, `$` or backtick.
+	doubleRunes = "abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#'()<>|&; \t\n\réüßÆ日本語🍺"
+	// After a backslash inside double quotes: the four specials (removed
+	// backslash) and ordinary characters (kept backslash).
+	doubleEscapes = "$`\"\\abcxyz0 '#-é日"
+	// Everything, for Join's arguments and the grammar model's input.
+	anyRunes = "abcxyz XYZ 0123456789 -_./:=@%^+,{}[]*?!~#$`\\\"'()<>|&; \t\n\réüßÆ日本語🍺"
+)
+
+// text generates strings of lo–hi characters drawn from pool.
+func text(pool string, lo, hi int) hegel.Generator[string] {
+	return hegel.Text().Alphabet(pool).MinSize(lo).MaxSize(hi)
+}
+
+// seq generates the concatenation of one draw from each generator.
+func seq(gs ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gs {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// many generates up to n draws from g, concatenated.
+func many(g hegel.Generator[string], n int) hegel.Generator[string] {
+	return hegel.Map(hegel.Lists(g).MaxSize(n), func(parts []string) string { return strings.Join(parts, "") })
+}
+
+// weighted is OneOf with integer weights: each generator is chosen in proportion to its weight.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	var gens []hegel.Generator[T]
+	for _, c := range choices {
+		for i := 0; i < c.weight; i++ {
+			gens = append(gens, c.gen)
+		}
+	}
+	return hegel.OneOf(gens...)
+}
+
+func prefixed(prefix string, g hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Map(g, func(s string) string { return prefix + s })
+}
+
+func quoted(q string, g hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Map(g, func(s string) string { return q + s + q })
+}
+
+// The pieces of a word: bare text, an escape (an invalid byte is escaped as itself
+// too), invalid UTF-8 (ordinary text), a line continuation, single- and
+// double-quoted text. A word's first piece never starts with `#` or `~` (a comment
+// or a tilde expansion to the shells) nor with a bare invalid byte or continuation.
+var (
+	bareStart    = text(bareRunes, 1, 1)
+	bareText     = text(bareRunes+innerRunes, 0, 6)
+	escape       = weighted(choice[string]{9, prefixed(`\`, text(escapableRunes, 1, 1))}, choice[string]{1, hegel.Just("\\\xff")})
+	invalidUTF8  = hegel.Just("\xff\xfe")
+	continuation = hegel.Just("\\\n")
+	singleQuoted = quoted(`'`, text(singleRunes, 0, 8))
+	doubleQuoted = quoted(`"`, many(weighted(
+		choice[string]{4, prefixed(`\`, text(doubleEscapes, 1, 1))},
+		choice[string]{1, continuation},
+		choice[string]{15, text(doubleRunes, 1, 1)}), 8))
+
+	firstPiece = weighted(
+		choice[string]{40, seq(bareStart, bareText)},
+		choice[string]{15, escape},
+		choice[string]{2, seq(bareStart, invalidUTF8)},
+		choice[string]{3, seq(bareStart, continuation)},
+		choice[string]{20, singleQuoted},
+		choice[string]{20, doubleQuoted})
+	laterPiece = weighted(
+		choice[string]{40, bareText},
+		choice[string]{15, escape},
+		choice[string]{2, invalidUTF8},
+		choice[string]{3, continuation},
+		choice[string]{20, singleQuoted},
+		choice[string]{20, doubleQuoted})
+
+	// word is one word of 1–3 pieces.
+	word = seq(firstPiece, many(laterPiece, 2))
+
+	blanks   = []string{" ", "\t", "  ", " \t", "\t\t"}
+	blanksNL = append([]string{"\n", "\n ", " \n\n"}, blanks...)
+)
+
+// lines generates 0–5 words joined by separators from seps, with a leading or
+// trailing separator now and then.
+func lines(seps []string) hegel.Generator[string] {
+	sep := hegel.SampledFrom(seps)
+	edge := weighted(choice[string]{4, hegel.Just("")}, choice[string]{1, sep})
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		sb.WriteString(hegel.Draw(tc, edge))
+		for i, w := range hegel.Draw(tc, hegel.Lists(word).MaxSize(5)) {
+			if i > 0 {
+				sb.WriteString(hegel.Draw(tc, sep))
+			}
+			sb.WriteString(w)
+		}
+		sb.WriteString(hegel.Draw(tc, edge))
+		return sb.String()
+	})
+}
+
+// anyText generates lo–hi arbitrary characters, sometimes ending in an invalid byte.
+func anyText(lo, hi int) hegel.Generator[string] {
+	return seq(text(anyRunes, lo, hi), weighted(choice[string]{19, hegel.Just("")}, choice[string]{1, hegel.Just("\xff")}))
+}
+
+// wordLists generates Join's arguments: 0–5 arbitrary strings.
+var wordLists = hegel.Lists(anyText(0, 6)).MaxSize(5)
+
+// ------------------------------------------------------------- properties
+
+func TestHegelSplitAgreesWithBash(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		line := hegel.Draw(ht, lines(blanksNL))
+		want, werr := shellWords(bashShell, line)
+		got, err := shellquote.Split(line)
+		if (werr == nil) != (err == nil) {
+			ht.Fatalf("Split(%q) = %q, %v; bash: %q, %v", line, got, err, want, werr)
+		}
+		if err == nil && !reflect.DeepEqual(got, want) {
+			ht.Fatalf("Split(%q) = %q, bash gives %q", line, got, want)
+		}
+	})
+}
+
+func TestHegelSplitAgreesWithSh(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		line := hegel.Draw(ht, lines(blanks))
+		sh := hegel.Draw(ht, hegel.SampledFrom(shShells))
+		want, werr := shellWords(sh, line)
+		got, err := shellquote.Split(line)
+		if (werr == nil) != (err == nil) {
+			ht.Fatalf("Split(%q) = %q, %v; %s: %q, %v", line, got, err, sh.name, want, werr)
+		}
+		if err == nil && !reflect.DeepEqual(got, want) {
+			ht.Fatalf("Split(%q) = %q, %s gives %q", line, got, sh.name, want)
+		}
+	})
+}
+
+// commentSafe keeps a Join argument from beginning a comment when passed to a shell
+// unquoted (go-shellquote/1, pinned below).
+var commentSafe = hegel.Map(wordLists, func(ws []string) []string {
+	for i, w := range ws {
+		if strings.HasPrefix(w, "#") {
+			ws[i] = "x" + w
+		}
+	}
+	return ws
+})
+
+func TestHegelJoinRoundTripsThroughTheShells(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		words := hegel.Draw(ht, commentSafe)
+		joined := shellquote.Join(words...)
+		sh := hegel.Draw(ht, hegel.SampledFrom(allShells))
+		got, err := shellWords(sh, joined)
+		if err != nil {
+			ht.Fatalf("Join(%q) = %q, which %s rejects: %v", words, joined, sh.name, err)
+		}
+		if !slices.Equal(got, words) {
+			ht.Fatalf("Join(%q) = %q, which %s splits into %q", words, joined, sh.name, got)
+		}
+	})
+}
+
+func TestHegelSplitInvertsJoin(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		words := hegel.Draw(ht, wordLists)
+		joined := shellquote.Join(words...)
+		got, err := shellquote.Split(joined)
+		if err != nil {
+			ht.Fatalf("Split(Join(%q) = %q) failed: %v", words, joined, err)
+		}
+		if !slices.Equal(got, words) {
+			ht.Fatalf("Split(Join(%q) = %q) = %q", words, joined, got)
+		}
+		// Join's output is "nice": a word without blanks or quotes is backslash-escaped, never quoted
+		if len(words) == 1 && words[0] != "" && !strings.ContainsAny(words[0], " \t\n'") && strings.Contains(joined, "'") {
+			ht.Fatalf("Join(%q) = %q quotes a word that needs no quoting", words, joined)
+		}
+	})
+}
+
+// modelSplit is the documented rule set: blanks, tabs and newlines separate
+// words; a backslash escapes the next character (an escaped newline is
+// dropped); single quotes are literal to the next single quote; inside double
+// quotes a backslash escapes only `$`, backtick, `"`, backslash and newline
+// (the newline being dropped); nothing else is special.
+func modelSplit(input string) ([]string, error) {
+	words := []string{}
+	var buf strings.Builder
+	inWord := false
+	i := 0
+	for i < len(input) {
+		c := input[i]
+		switch c {
+		case ' ', '\t', '\n':
+			if inWord {
+				words = append(words, buf.String())
+				buf.Reset()
+				inWord = false
+			}
+			i++
+		case '\\':
+			if i+1 >= len(input) {
+				return nil, shellquote.UnterminatedEscapeError
+			}
+			if input[i+1] == '\n' {
+				i += 2
+				continue
+			}
+			_, l := utf8.DecodeRuneInString(input[i+1:])
+			buf.WriteString(input[i+1 : i+1+l])
+			inWord = true
+			i += 1 + l
+		case '\'':
+			j := strings.IndexByte(input[i+1:], '\'')
+			if j < 0 {
+				return nil, shellquote.UnterminatedSingleQuoteError
+			}
+			buf.WriteString(input[i+1 : i+1+j])
+			inWord = true
+			i += j + 2
+		case '"':
+			i++
+			inWord = true
+			closed := false
+			for i < len(input) {
+				d := input[i]
+				if d == '"' {
+					closed = true
+					i++
+					break
+				}
+				if d == '\\' && i+1 < len(input) {
+					e := input[i+1]
+					if e == '\n' {
+						i += 2
+						continue
+					}
+					if strings.IndexByte("$`\"\\", e) >= 0 {
+						buf.WriteByte(e)
+						i += 2
+						continue
+					}
+				}
+				buf.WriteByte(d)
+				i++
+			}
+			if !closed {
+				return nil, shellquote.UnterminatedDoubleQuoteError
+			}
+		default:
+			buf.WriteByte(c)
+			inWord = true
+			i++
+		}
+	}
+	if inWord {
+		words = append(words, buf.String())
+	}
+	return words, nil
+}
+
+// Arbitrary text, or a well-formed line with arbitrary text appended.
+var splitInput = hegel.OneOf(anyText(0, 12), seq(lines(blanksNL), anyText(0, 3)))
+
+func TestHegelSplitFollowsTheDocumentedRules(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		input := hegel.Draw(ht, splitInput)
+		want, werr := modelSplit(input)
+		got, err := shellquote.Split(input)
+		if !errors.Is(err, werr) {
+			ht.Fatalf("Split(%q) = %q, %v; the rules say %q, %v", input, got, err, want, werr)
+		}
+		if err == nil && !reflect.DeepEqual(got, want) {
+			ht.Fatalf("Split(%q) = %q, the rules say %q", input, got, want)
+		}
+	})
+}
+
+// ------------------------------------------------------------------ pins
+
+// go-shellquote/1
+func TestHegelPinJoinQuotesLeadingHash(t *testing.T) {
+	defer guard(t)
+	for _, words := range [][]string{{"#"}, {"#!/bin/sh"}, {"echo", "#x"}} {
+		joined := shellquote.Join(words...)
+		for _, sh := range allShells {
+			got, err := shellWords(sh, joined)
+			if err != nil {
+				t.Errorf("Join(%q) = %q: %s: %v", words, joined, sh.name, err)
+				continue
+			}
+			if !reflect.DeepEqual(got, words) {
+				t.Errorf("Join(%q) = %q, which %s splits into %q", words, joined, sh.name, got)
+			}
+		}
+	}
+}
