diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..621ee20
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,162 @@
+package hujson_test
+
+// One plain test per bug in bugs.toml. Each asserts the correct behaviour and
+// fails while the bug is open; target.toml lists them as expected failures.
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/tailscale/hujson"
+)
+
+func mustParse(t *testing.T, s string) hujson.Value {
+	t.Helper()
+	v, err := hujson.Parse([]byte(s))
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", s, err)
+	}
+	return v
+}
+
+func minimized(v hujson.Value) string {
+	c := v.Clone()
+	c.Minimize()
+	return string(c.Pack())
+}
+
+// hujson/1: RFC 6902 §4.1 — "The specified index MUST NOT be greater than
+// the number of elements in the array."
+func TestHegelPinAddBeyondArrayEndFails(t *testing.T) {
+	v := mustParse(t, `[10,20]`)
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"add","path":"/2","value":30}]`)); err != nil || minimized(w) != `[10,20,30]` {
+		t.Fatalf("add at index == len: err %v, result %s", err, w.Pack())
+	}
+	for _, path := range []string{"/3", "/100", "/18446744073709551615"} {
+		w := v.Clone()
+		err := w.Patch([]byte(`[{"op":"add","path":"` + path + `","value":30}]`))
+		if err == nil {
+			t.Errorf("add at %q on a 2-element array succeeded: %s", path, w.Pack())
+		}
+	}
+}
+
+// hujson/2: RFC 6901 §4 — array-index = %x30 / ( %x31-39 *(%x30-39) ):
+// no leading zeros.
+func TestHegelPinLeadingZeroIndexIsInvalid(t *testing.T) {
+	v := mustParse(t, `[10,20]`)
+	if got := v.Find("/1"); got == nil || string(got.Pack()) != "20" {
+		t.Fatalf("Find(/1) = %v", got)
+	}
+	if got := v.Find("/01"); got != nil {
+		t.Errorf("Find(/01) = %s, want nil", got.Pack())
+	}
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"add","path":"/01","value":15}]`)); err == nil {
+		t.Errorf("add at /01 succeeded: %s", w.Pack())
+	}
+	w = v.Clone()
+	if err := w.Patch([]byte(`[{"op":"remove","path":"/01"}]`)); err == nil {
+		t.Errorf("remove at /01 succeeded: %s", w.Pack())
+	}
+}
+
+// hujson/3: RFC 6902 §4.4 forbids moving a location into one of its
+// children ("from" a *proper* prefix of "path"); moving a location onto
+// itself is allowed, and §4.5 puts no restriction on "from" for copy, so
+// the root may be copied into a child.
+func TestHegelPinMoveToSelfAndCopyFromRootAreAllowed(t *testing.T) {
+	v := mustParse(t, `{"a":[1]}`)
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"move","from":"/a","path":"/a"}]`)); err != nil {
+		t.Errorf("move /a onto itself: %v", err)
+	} else if got := minimized(w); got != `{"a":[1]}` {
+		t.Errorf("move /a onto itself gave %s", got)
+	}
+	w = v.Clone()
+	if err := w.Patch([]byte(`[{"op":"copy","from":"","path":"/b"}]`)); err != nil {
+		t.Errorf("copy the root into /b: %v", err)
+	} else if got := minimized(w); got != `{"a":[1],"b":{"a":[1]}}` {
+		t.Errorf("copy the root into /b gave %s", got)
+	}
+}
+
+// hujson/4: RFC 6902 §4.3 — replace needs only that the target location
+// exist; "" (the whole document) always does, and "add" at "" is accepted.
+func TestHegelPinReplaceAtRootIsAllowed(t *testing.T) {
+	v := mustParse(t, `{"a":[1]}`)
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"add","path":"","value":7}]`)); err != nil || minimized(w) != "7" {
+		t.Fatalf("add at the root: err %v, result %s", err, w.Pack())
+	}
+	w = v.Clone()
+	if err := w.Patch([]byte(`[{"op":"replace","path":"","value":7}]`)); err != nil {
+		t.Errorf("replace at the root: %v", err)
+	} else if got := minimized(w); got != "7" {
+		t.Errorf("replace at the root gave %s", got)
+	}
+}
+
+// hujson/5: "IsValid reports whether b is a valid JSON null, boolean, string,
+// or number."
+func TestHegelPinLiteralIsValidRejectsComposites(t *testing.T) {
+	for _, s := range []string{"null", "true", "false", `"a"`, "0", "-1.5e3"} {
+		if !hujson.Literal(s).IsValid() {
+			t.Errorf("Literal(%q).IsValid() = false", s)
+		}
+	}
+	for _, s := range []string{"[]", "[1]", "{}", `{"a":1}`, `[{"a":[null]}]`} {
+		if hujson.Literal(s).IsValid() {
+			t.Errorf("Literal(%q).IsValid() = true", s)
+		}
+	}
+}
+
+// hujson/6: the convenience functions return a new buffer and say nothing
+// about the input; it must be left alone.
+func TestHegelPinStandardizeAndFormatLeaveTheInputAlone(t *testing.T) {
+	for _, src := range []string{"/*c*/ [1, /*d*/ 2,]\n", "// hello\n{\"a\": 1, // x\n \"b\": 2}\n"} {
+		for _, f := range []struct {
+			name string
+			fn   func([]byte) ([]byte, error)
+		}{{"Standardize", hujson.Standardize}, {"Minimize", hujson.Minimize}, {"Format", hujson.Format}} {
+			in := []byte(src)
+			out, err := f.fn(in)
+			if err != nil {
+				t.Fatalf("%s: %v", f.name, err)
+			}
+			if string(in) != src {
+				t.Errorf("%s(%q) returned %q and left the input as %q", f.name, src, out, in)
+			}
+		}
+	}
+}
+
+// hujson/7: "Clone returns a deep copy of the value."
+func TestHegelPinCloneKeepsTrailingCommas(t *testing.T) {
+	for _, s := range []string{"[1,]", `{"a":1,}`, "[[1,],]", "[1 ,]", "[1, ]"} {
+		v := mustParse(t, s)
+		if got := v.Clone().Pack(); !bytes.Equal(got, []byte(s)) {
+			t.Errorf("Parse(%q).Clone().Pack() = %q", s, got)
+		}
+	}
+}
+
+// hujson/8: RFC 6902 §4.6 — "test" succeeds when the target's value equals
+// the given value; two nulls are equal.
+func TestHegelPinTestAgainstNullSucceeds(t *testing.T) {
+	v := mustParse(t, `{"a":null,"b":[null]}`)
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"test","path":"/b","value":[null]}]`)); err != nil {
+		t.Fatalf("test [null] against [null]: %v", err)
+	}
+	w = v.Clone()
+	if err := w.Patch([]byte(`[{"op":"test","path":"/a","value":null}]`)); err != nil {
+		t.Errorf("test null against null: %v", err)
+	}
+	w = mustParse(t, `null`)
+	if err := w.Patch([]byte(`[{"op":"test","path":"","value":null}]`)); err != nil {
+		t.Errorf("test null against a null document: %v", err)
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..ffb89b8
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2388 @@
+package hujson_test
+
+// Hegel property tests for github.com/tailscale/hujson.
+//
+// Oracles: a model of the JWCC grammar written here (a parser producing the
+// same syntax tree — values, whitespace-and-comment extras, trailing commas,
+// byte offsets — from which the exact Pack, Standardize and Minimize outputs
+// follow), encoding/json for the standardized output, the Format contracts
+// stated in its documentation (idempotence, standard stays standard, the
+// value and the comments are preserved, every object or array is either
+// inlined or fully expanded), RFC 6901 for Find and RFC 6902 for Patch
+// (against an ordered document model), and the documented Literal
+// constructors and accessors.
+//
+// Set HUJSON_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/tailscale/hujson"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	// A loaded machine (the zoo bumps several targets at once) trips Hegel's
+	// too-slow health check, which hegel-go reports without a message.
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("HUJSON_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	addBeyondEnd         bool // hujson/1: Patch "add" with an array index greater than the length appends instead of failing
+	leadingZeroIndex     bool // hujson/2: Find and Patch accept an array index with leading zeros ("/01")
+	moveToSelfCopyRoot   bool // hujson/3: Patch refuses "move" onto the same location and "copy" from the root
+	replaceRoot          bool // hujson/4: Patch refuses "replace" at the root
+	compositeLiteralOK   bool // hujson/5: Literal.IsValid accepts objects and arrays
+	inputOverwritten     bool // hujson/6: Standardize and Format write into the caller's input buffer
+	cloneDropsComma      bool // hujson/7: Clone drops a trailing comma that directly follows the last value
+	testNullFails        bool // hujson/8: a Patch "test" against a JSON null never succeeds
+}{addBeyondEnd: true, leadingZeroIndex: true, moveToSelfCopyRoot: true, replaceRoot: true, compositeLiteralOK: true, inputOverwritten: true, cloneDropsComma: true, testNullFails: true}
+
+// cp copies a buffer: Parse aliases its input and the in-place methods write
+// through the aliases (hujson/6), so every Value that will be mutated is
+// parsed from a copy.
+func cp(b []byte) []byte { return append([]byte(nil), b...) }
+
+// call runs one of the convenience functions on a copy of b and checks that
+// the copy is what it was, unless the recorded bug is gated.
+func call(ht *hegel.T, name string, fn func([]byte) ([]byte, error), b []byte) ([]byte, error) {
+	in := cp(b)
+	out, err := fn(in)
+	if !Known.inputOverwritten && !bytes.Equal(in, b) {
+		fail(ht, "%s(%q) overwrote its input: now %q", name, b, in)
+	}
+	return out, err
+}
+
+// ---------------------------------------------------------------------------
+// The model: a JWCC parser producing the same syntax tree as hujson.Parse.
+
+// pnode is a parsed value with its extras and offsets. For a composite the
+// extra before the closing bracket is compAfter; the last member or element
+// keeps its own after-extra only when a trailing comma follows it (as in
+// hujson, where the parser moves it to the composite otherwise).
+type pnode struct {
+	before        string
+	start, end    int
+	kind          byte // 'n' 'f' 't' '"' '0' '{' '['
+	lit           string
+	members       []pmember
+	elems         []*pnode
+	compAfter     string
+	trailingComma bool
+	after         string
+}
+
+type pmember struct{ name, val *pnode }
+
+type modelError struct {
+	off int
+	msg string
+}
+
+func (e *modelError) Error() string { return fmt.Sprintf("offset %d: %s", e.off, e.msg) }
+
+func errAt(off int, msg string) error { return &modelError{off, msg} }
+
+type mparser struct{ b []byte }
+
+func modelParse(b []byte) (*pnode, error) {
+	p := &mparser{b}
+	v, n, err := p.value(0)
+	if err != nil {
+		return nil, err
+	}
+	if n < len(b) {
+		return nil, errAt(n, "after top-level value")
+	}
+	return v, nil
+}
+
+func isWS(c byte) bool { return c == ' ' || c == '\t' || c == '\r' || c == '\n' }
+
+// extra consumes whitespace and comments; it stops (without error) at the
+// first byte that is neither, including a lone '/'.
+func (p *mparser) extra(n int) (int, error) {
+	for n < len(p.b) {
+		c := p.b[n]
+		switch {
+		case isWS(c):
+			n++
+		case c == '/' && n+1 < len(p.b) && p.b[n+1] == '/':
+			i := bytes.IndexByte(p.b[n+2:], '\n')
+			if i < 0 {
+				return n, errAt(n, "unterminated line comment")
+			}
+			com := p.b[n : n+2+i+1]
+			if !utf8.Valid(com) {
+				return n, errAt(n, "invalid UTF-8 in comment")
+			}
+			if strings.ContainsAny(string(com), "\u2028\u2029") {
+				return n, errAt(n, "line separator in line comment")
+			}
+			n += len(com)
+		case c == '/' && n+1 < len(p.b) && p.b[n+1] == '*':
+			i := bytes.Index(p.b[n+2:], []byte("*/"))
+			if i < 0 {
+				return n, errAt(n, "unterminated block comment")
+			}
+			com := p.b[n : n+2+i+2]
+			if !utf8.Valid(com) {
+				return n, errAt(n, "invalid UTF-8 in comment")
+			}
+			n += len(com)
+		default:
+			return n, nil
+		}
+	}
+	return n, nil
+}
+
+func (p *mparser) value(n int) (*pnode, int, error) {
+	v := &pnode{}
+	n0 := n
+	var err error
+	if n, err = p.extra(n); err != nil {
+		return nil, n, err
+	}
+	v.before = string(p.b[n0:n])
+	v.start = n
+	if n, err = p.trimmed(v, n); err != nil {
+		return nil, n, err
+	}
+	v.end = n
+	n1 := n
+	if n, err = p.extra(n); err != nil {
+		return nil, n, err
+	}
+	v.after = string(p.b[n1:n])
+	return v, n, nil
+}
+
+var numberRE = regexp.MustCompile(`^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?$`)
+
+// validStringLiteral is RFC 8259 §7 with the encoding/json v1 relaxations
+// hujson inherits: invalid UTF-8 and lone surrogate escapes are accepted.
+func validStringLiteral(s string) bool {
+	if len(s) < 2 || s[0] != '"' || s[len(s)-1] != '"' {
+		return false
+	}
+	body := s[1 : len(s)-1]
+	for i := 0; i < len(body); i++ {
+		c := body[i]
+		switch {
+		case c < 0x20:
+			return false
+		case c == '"':
+			return false
+		case c == '\\':
+			i++
+			if i >= len(body) {
+				return false
+			}
+			switch body[i] {
+			case '"', '\\', '/', 'b', 'f', 'n', 'r', 't':
+			case 'u':
+				if i+4 >= len(body) {
+					return false
+				}
+				for _, h := range body[i+1 : i+5] {
+					if !strings.ContainsRune("0123456789abcdefABCDEF", rune(h)) {
+						return false
+					}
+				}
+				i += 4
+			default:
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// validLiteral is Literal.IsValid as documented: exactly one JSON null,
+// boolean, string or number, no surrounding whitespace.
+func validLiteral(s string) bool {
+	if s == "" {
+		return false
+	}
+	switch s[0] {
+	case '"':
+		return validStringLiteral(s)
+	case 'n':
+		return s == "null"
+	case 't':
+		return s == "true"
+	case 'f':
+		return s == "false"
+	default:
+		return numberRE.MatchString(s)
+	}
+}
+
+func litKind(s string) byte {
+	if s == "" {
+		return 0
+	}
+	switch c := s[0]; {
+	case c == 'n' || c == 'f' || c == 't' || c == '"':
+		return c
+	case c == '-' || ('0' <= c && c <= '9'):
+		return '0'
+	}
+	return 0
+}
+
+func (p *mparser) trimmed(v *pnode, n int) (int, error) {
+	if n == len(p.b) {
+		return n, errAt(n, "unexpected EOF")
+	}
+	switch p.b[n] {
+	case '{':
+		v.kind = '{'
+		n++
+		for {
+			n2, err := p.extra(n)
+			if err != nil {
+				return n2, err
+			}
+			if n2 < len(p.b) && p.b[n2] == '}' {
+				if len(v.members) > 0 {
+					v.trailingComma = true
+				}
+				v.compAfter = string(p.b[n:n2])
+				return n2 + 1, nil
+			}
+			name, n3, err := p.value(n)
+			if err != nil {
+				return n3, err
+			}
+			if name.kind != '"' {
+				return name.start, errAt(name.start, "object name is not a string")
+			}
+			if n3 == len(p.b) || p.b[n3] != ':' {
+				return n3, errAt(n3, "expected ':'")
+			}
+			val, n4, err := p.value(n3 + 1)
+			if err != nil {
+				return n4, err
+			}
+			v.members = append(v.members, pmember{name, val})
+			if n4 == len(p.b) {
+				return n4, errAt(n4, "unexpected EOF in object")
+			}
+			switch p.b[n4] {
+			case ',':
+				n = n4 + 1
+			case '}':
+				v.compAfter = val.after
+				val.after = ""
+				return n4 + 1, nil
+			default:
+				return n4, errAt(n4, "expected ',' or '}'")
+			}
+		}
+	case '[':
+		v.kind = '['
+		n++
+		for {
+			n2, err := p.extra(n)
+			if err != nil {
+				return n2, err
+			}
+			if n2 < len(p.b) && p.b[n2] == ']' {
+				if len(v.elems) > 0 {
+					v.trailingComma = true
+				}
+				v.compAfter = string(p.b[n:n2])
+				return n2 + 1, nil
+			}
+			el, n3, err := p.value(n)
+			if err != nil {
+				return n3, err
+			}
+			v.elems = append(v.elems, el)
+			if n3 == len(p.b) {
+				return n3, errAt(n3, "unexpected EOF in array")
+			}
+			switch p.b[n3] {
+			case ',':
+				n = n3 + 1
+			case ']':
+				v.compAfter = el.after
+				el.after = ""
+				return n3 + 1, nil
+			default:
+				return n3, errAt(n3, "expected ',' or ']'")
+			}
+		}
+	case '}', ']':
+		return n, errAt(n, "closing bracket at start of value")
+	case '"':
+		n0 := n
+		n++
+		for {
+			if n == len(p.b) {
+				return n, errAt(n, "unterminated string")
+			}
+			c := p.b[n]
+			if c == '\\' {
+				n++
+				if n == len(p.b) {
+					return n, errAt(n, "unterminated string")
+				}
+				n++
+				continue
+			}
+			n++
+			if c == '"' {
+				break
+			}
+		}
+		lit := string(p.b[n0:n])
+		if !validStringLiteral(lit) {
+			return n0, errAt(n0, "invalid string literal")
+		}
+		v.kind = '"'
+		v.lit = lit
+		return n, nil
+	default:
+		n0 := n
+		for n < len(p.b) {
+			c := p.b[n]
+			if c == '-' || c == '+' || c == '.' || ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z') || ('0' <= c && c <= '9') {
+				n++
+				continue
+			}
+			break
+		}
+		lit := string(p.b[n0:n])
+		if lit == "" {
+			return n0, errAt(n0, "invalid character at start of value")
+		}
+		if !validLiteral(lit) {
+			return n0, errAt(n0, "invalid literal")
+		}
+		v.kind = litKind(lit)
+		v.lit = lit
+		return n, nil
+	}
+}
+
+// pack is the exact source text of the tree.
+func (v *pnode) pack(sb *strings.Builder) {
+	sb.WriteString(v.before)
+	switch v.kind {
+	case '{':
+		sb.WriteByte('{')
+		for i, m := range v.members {
+			m.name.pack(sb)
+			sb.WriteByte(':')
+			m.val.pack(sb)
+			if i < len(v.members)-1 || v.trailingComma {
+				sb.WriteByte(',')
+			}
+		}
+		sb.WriteString(v.compAfter)
+		sb.WriteByte('}')
+	case '[':
+		sb.WriteByte('[')
+		for i, e := range v.elems {
+			e.pack(sb)
+			if i < len(v.elems)-1 || v.trailingComma {
+				sb.WriteByte(',')
+			}
+		}
+		sb.WriteString(v.compAfter)
+		sb.WriteByte(']')
+	default:
+		sb.WriteString(v.lit)
+	}
+	sb.WriteString(v.after)
+}
+
+// packAsCloned is the text after hujson/7: a trailing comma with nothing
+// between the last value and it is lost by Clone.
+func (v *pnode) packAsCloned() string {
+	c := v.clone()
+	var walk func(*pnode)
+	walk = func(x *pnode) {
+		if x.trailingComma && lastOf(x) != nil && lastOf(x).after == "" {
+			x.trailingComma = false
+		}
+		for _, m := range x.members {
+			walk(m.name)
+			walk(m.val)
+		}
+		for _, e := range x.elems {
+			walk(e)
+		}
+	}
+	walk(c)
+	return c.String()
+}
+
+func (v *pnode) String() string {
+	var sb strings.Builder
+	v.pack(&sb)
+	return sb.String()
+}
+
+// stdExtra is Standardize on one extra: every byte that is not JSON
+// whitespace becomes a space, so offsets and line numbers are kept.
+func stdExtra(s string) string {
+	b := []byte(s)
+	for i, c := range b {
+		if !isWS(c) {
+			b[i] = ' '
+		}
+	}
+	return string(b)
+}
+
+// std is the documented Standardize output: comments blanked, trailing commas
+// replaced by a space, everything else in place.
+func (v *pnode) std(sb *strings.Builder) {
+	sb.WriteString(stdExtra(v.before))
+	switch v.kind {
+	case '{':
+		sb.WriteByte('{')
+		for i, m := range v.members {
+			m.name.std(sb)
+			sb.WriteByte(':')
+			m.val.std(sb)
+			if i < len(v.members)-1 {
+				sb.WriteByte(',')
+			} else if v.trailingComma {
+				sb.WriteByte(' ')
+			}
+		}
+		sb.WriteString(stdExtra(v.compAfter))
+		sb.WriteByte('}')
+	case '[':
+		sb.WriteByte('[')
+		for i, e := range v.elems {
+			e.std(sb)
+			if i < len(v.elems)-1 {
+				sb.WriteByte(',')
+			} else if v.trailingComma {
+				sb.WriteByte(' ')
+			}
+		}
+		sb.WriteString(stdExtra(v.compAfter))
+		sb.WriteByte(']')
+	default:
+		sb.WriteString(v.lit)
+	}
+	sb.WriteString(stdExtra(v.after))
+}
+
+// compact is the Minimize output: no extras, no trailing commas.
+func (v *pnode) compact(sb *strings.Builder) {
+	switch v.kind {
+	case '{':
+		sb.WriteByte('{')
+		for i, m := range v.members {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			m.name.compact(sb)
+			sb.WriteByte(':')
+			m.val.compact(sb)
+		}
+		sb.WriteByte('}')
+	case '[':
+		sb.WriteByte('[')
+		for i, e := range v.elems {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			e.compact(sb)
+		}
+		sb.WriteByte(']')
+	default:
+		sb.WriteString(v.lit)
+	}
+}
+
+func compactOf(v *pnode) string {
+	var sb strings.Builder
+	v.compact(&sb)
+	return sb.String()
+}
+
+// jsonValue is the value as encoding/json decodes it (order-insensitive
+// objects, last duplicate wins, float64 numbers).
+func jsonValue(v *pnode) (any, error) {
+	var x any
+	err := json.Unmarshal([]byte(compactOf(v)), &x)
+	return x, err
+}
+
+// preorder lists the values in hujson's All order: each value, then for an
+// object every name followed by its value, for an array every element.
+func (v *pnode) preorder(out *[]*pnode) {
+	*out = append(*out, v)
+	for _, m := range v.members {
+		m.name.preorder(out)
+		m.val.preorder(out)
+	}
+	for _, e := range v.elems {
+		e.preorder(out)
+	}
+}
+
+// isStandard: no comments anywhere and no trailing commas.
+func (v *pnode) isStandard() bool {
+	if hasComment(v.before) || hasComment(v.after) {
+		return false
+	}
+	if v.kind == '{' || v.kind == '[' {
+		if v.trailingComma || hasComment(v.compAfter) {
+			return false
+		}
+		for _, m := range v.members {
+			if !m.name.isStandard() || !m.val.isStandard() {
+				return false
+			}
+		}
+		for _, e := range v.elems {
+			if !e.isStandard() {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func hasComment(extra string) bool {
+	for i := 0; i < len(extra); i++ {
+		if !isWS(extra[i]) {
+			return true
+		}
+	}
+	return false
+}
+
+func (v *pnode) clone() *pnode {
+	c := *v
+	c.members = nil
+	c.elems = nil
+	for _, m := range v.members {
+		c.members = append(c.members, pmember{m.name.clone(), m.val.clone()})
+	}
+	for _, e := range v.elems {
+		c.elems = append(c.elems, e.clone())
+	}
+	return &c
+}
+
+func unquote(lit string) string {
+	var s string
+	if err := json.Unmarshal([]byte(lit), &s); err != nil {
+		return lit
+	}
+	return s
+}
+
+// quote is hujson.String: RFC 8785 §3.2.2.2 escaping.
+func quote(s string) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '\b':
+			sb.WriteString(`\b`)
+		case r == '\t':
+			sb.WriteString(`\t`)
+		case r == '\n':
+			sb.WriteString(`\n`)
+		case r == '\f':
+			sb.WriteString(`\f`)
+		case r == '\r':
+			sb.WriteString(`\r`)
+		case r == '\\':
+			sb.WriteString(`\\`)
+		case r == '"':
+			sb.WriteString(`\"`)
+		case r < ' ':
+			fmt.Fprintf(&sb, `\u%04x`, r)
+		default:
+			sb.WriteRune(r)
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+// ---------------------------------------------------------------------------
+// Comparing hujson's tree with the model's.
+
+func extraStr(e hujson.Extra) string { return string(e) }
+
+func compareTree(got *hujson.Value, want *pnode, path string) error {
+	if extraStr(got.BeforeExtra) != want.before {
+		return fmt.Errorf("%s: BeforeExtra %q, want %q", path, got.BeforeExtra, want.before)
+	}
+	if got.StartOffset != want.start || got.EndOffset != want.end {
+		return fmt.Errorf("%s: offsets %d..%d, want %d..%d", path, got.StartOffset, got.EndOffset, want.start, want.end)
+	}
+	if got.Value == nil {
+		return fmt.Errorf("%s: nil Value", path)
+	}
+	if byte(got.Value.Kind()) != want.kind {
+		return fmt.Errorf("%s: Kind %q, want %q", path, byte(got.Value.Kind()), want.kind)
+	}
+	switch want.kind {
+	case '{':
+		obj, ok := got.Value.(*hujson.Object)
+		if !ok {
+			return fmt.Errorf("%s: %T, want *Object", path, got.Value)
+		}
+		if len(obj.Members) != len(want.members) {
+			return fmt.Errorf("%s: %d members, want %d", path, len(obj.Members), len(want.members))
+		}
+		for i := range want.members {
+			if err := compareTree(&obj.Members[i].Name, want.members[i].name, fmt.Sprintf("%s/%d:name", path, i)); err != nil {
+				return err
+			}
+			if err := compareTree(&obj.Members[i].Value, want.members[i].val, fmt.Sprintf("%s/%d", path, i)); err != nil {
+				return err
+			}
+		}
+		if extraStr(obj.AfterExtra) != want.compAfter {
+			return fmt.Errorf("%s: object AfterExtra %q, want %q", path, obj.AfterExtra, want.compAfter)
+		}
+		if k := len(obj.Members); k > 0 {
+			last := &obj.Members[k-1].Value
+			if (last.AfterExtra != nil) != want.trailingComma {
+				return fmt.Errorf("%s: trailing comma %v (last AfterExtra %q), want %v", path, last.AfterExtra != nil, last.AfterExtra, want.trailingComma)
+			}
+		}
+	case '[':
+		arr, ok := got.Value.(*hujson.Array)
+		if !ok {
+			return fmt.Errorf("%s: %T, want *Array", path, got.Value)
+		}
+		if len(arr.Elements) != len(want.elems) {
+			return fmt.Errorf("%s: %d elements, want %d", path, len(arr.Elements), len(want.elems))
+		}
+		for i := range want.elems {
+			if err := compareTree(&arr.Elements[i], want.elems[i], fmt.Sprintf("%s/%d", path, i)); err != nil {
+				return err
+			}
+		}
+		if extraStr(arr.AfterExtra) != want.compAfter {
+			return fmt.Errorf("%s: array AfterExtra %q, want %q", path, arr.AfterExtra, want.compAfter)
+		}
+		if k := len(arr.Elements); k > 0 {
+			last := &arr.Elements[k-1]
+			if (last.AfterExtra != nil) != want.trailingComma {
+				return fmt.Errorf("%s: trailing comma %v (last AfterExtra %q), want %v", path, last.AfterExtra != nil, last.AfterExtra, want.trailingComma)
+			}
+		}
+	default:
+		lit, ok := got.Value.(hujson.Literal)
+		if !ok {
+			return fmt.Errorf("%s: %T, want Literal", path, got.Value)
+		}
+		if string(lit) != want.lit {
+			return fmt.Errorf("%s: literal %q, want %q", path, lit, want.lit)
+		}
+	}
+	// The after-extra: for the last member/element it is the part before the
+	// trailing comma (nil without one), which compareTree's caller checked
+	// through trailingComma; the content must match either way.
+	if extraStr(got.AfterExtra) != want.after {
+		return fmt.Errorf("%s: AfterExtra %q, want %q", path, got.AfterExtra, want.after)
+	}
+	return nil
+}
+
+// checkOffsets: every value's offsets cut its trimmed text out of pack.
+func checkOffsets(root *hujson.Value, pack []byte) error {
+	for v := range root.All() {
+		if v.StartOffset < 0 || v.EndOffset > len(pack) || v.StartOffset > v.EndOffset {
+			return fmt.Errorf("offsets %d..%d outside %d bytes", v.StartOffset, v.EndOffset, len(pack))
+		}
+		want := hujson.Value{Value: v.Value}.Pack()
+		if got := pack[v.StartOffset:v.EndOffset]; !bytes.Equal(got, want) {
+			return fmt.Errorf("pack[%d:%d] = %q, want %q", v.StartOffset, v.EndOffset, got, want)
+		}
+	}
+	return nil
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+// genExtra draws whitespace and comments. Comments contain no lone '\r' (Format
+// turns those into spaces, which the comment-preservation check would see).
+func genExtra(tc hegel.TestCase, comments bool) string {
+	if chance(tc, 45) {
+		return ""
+	}
+	var sb strings.Builder
+	k := n(tc, 1, 3)
+	for i := 0; i < k; i++ {
+		switch {
+		case !comments || chance(tc, 50):
+			sb.WriteString(pick(tc, " ", " ", "\t", "\n", "\n", "\r\n", "  ", "\n\n", "\n\n\n", "\r"))
+		case chance(tc, 50):
+			sb.WriteString("//")
+			sb.WriteString(genCommentText(tc, false))
+			sb.WriteString("\n")
+		default:
+			sb.WriteString("/*")
+			sb.WriteString(genCommentText(tc, true))
+			sb.WriteString("*/")
+		}
+	}
+	return sb.String()
+}
+
+func genCommentText(tc hegel.TestCase, block bool) string {
+	k := n(tc, 0, 4)
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		switch n(tc, 0, 11) {
+		case 0:
+			sb.WriteString(pick(tc, "/*", "//", "* ", "**", "/"))
+		case 1:
+			if block {
+				sb.WriteString(pick(tc, "\n", "\n  ", "\n\t", "\n\n", "\n * ", "\r\n", "\n\n\n", "\u2028"))
+			} else {
+				sb.WriteString(pick(tc, "\t", "  ", "é", "日本"))
+			}
+		case 2:
+			sb.WriteString(pick(tc, "é", "日本", "\u2029", "\t", " "))
+		default:
+			sb.WriteByte(byte(n(tc, 0x20, 0x7e)))
+		}
+	}
+	s := sb.String()
+	if block {
+		s = strings.ReplaceAll(s, "*/", "*.")
+	} else {
+		s = strings.NewReplacer("\u2028", " ", "\u2029", " ").Replace(s)
+	}
+	return s
+}
+
+// genString draws a JSON string literal: escapes of every kind, raw UTF-8,
+// and (rarely) invalid UTF-8, which hujson accepts.
+func genString(tc hegel.TestCase) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	k := n(tc, 0, 4)
+	if chance(tc, 10) {
+		k = n(tc, 0, 20)
+	}
+	for i := 0; i < k; i++ {
+		switch n(tc, 0, 12) {
+		case 0:
+			sb.WriteString(pick(tc, `\"`, `\\`, `\/`, `\b`, `\f`, `\n`, `\r`, `\t`))
+		case 1:
+			fmt.Fprintf(&sb, `\u%04x`, n(tc, 0, 0xffff))
+		case 2:
+			sb.WriteString(pick(tc, `😀`, `\uD800`, `\udc00`, "\u2028", `/`, "\u2028"))
+		case 3:
+			sb.WriteRune(rune(pick(tc, 0x7f, 0xe9, 0x2028, 0x2029, 0x1f600, 0xfffd, 0x3000)))
+		case 4:
+			if chance(tc, 30) {
+				sb.WriteByte(0xff)
+			} else {
+				sb.WriteString(pick(tc, "/", "*", "{", "}", "[", "]", ",", ":", "~", "-"))
+			}
+		default:
+			sb.WriteByte(byte(n(tc, 0x20, 0x7e)))
+		}
+	}
+	return `"` + sanitizeBody(sb.String()[1:]) + `"`
+}
+
+// sanitizeBody makes an arbitrary string body a valid JSON string body: raw
+// control characters and quotes are escaped, backslashes must start a valid
+// escape or are doubled.
+func sanitizeBody(s string) string {
+	var sb strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == '"':
+			sb.WriteString(`\"`)
+		case c < 0x20:
+			fmt.Fprintf(&sb, `\u%04x`, c)
+		case c == '\\':
+			if i+1 < len(s) && strings.IndexByte(`"\/bfnrt`, s[i+1]) >= 0 {
+				sb.WriteByte(c)
+				sb.WriteByte(s[i+1])
+				i++
+			} else if i+5 < len(s) && s[i+1] == 'u' && isHex4(s[i+2:i+6]) {
+				sb.WriteString(s[i : i+6])
+				i += 5
+			} else {
+				sb.WriteString(`\\`)
+			}
+		default:
+			sb.WriteByte(c)
+		}
+	}
+	return sb.String()
+}
+
+func isHex4(s string) bool {
+	if len(s) != 4 {
+		return false
+	}
+	for _, h := range s {
+		if !strings.ContainsRune("0123456789abcdefABCDEF", h) {
+			return false
+		}
+	}
+	return true
+}
+
+func genNumber(tc hegel.TestCase) string {
+	switch n(tc, 0, 7) {
+	case 0:
+		return pick(tc, "0", "-0", "1", "-1", "10", "255", "1e5", "1E+5", "1e-5", "0.5", "-0.0", "1.25e2", "123456789012345678901234567890", "1.7976931348623157e308", "4.9e-324")
+	case 1:
+		return strconv.FormatFloat(float64(n(tc, -100000, 100000))/128, 'g', -1, 64)
+	case 2:
+		return strconv.FormatInt(int64(n(tc, -1<<31, 1<<31)), 10) + pick(tc, ".0", ".5", "e0", "E-1", "e+2")
+	default:
+		return strconv.Itoa(n(tc, -1000, 1000))
+	}
+}
+
+func genLiteral(tc hegel.TestCase) string {
+	switch n(tc, 0, 5) {
+	case 0:
+		return pick(tc, "null", "true", "false")
+	case 1, 2:
+		return genString(tc)
+	default:
+		return genNumber(tc)
+	}
+}
+
+// genName draws an object name: short, from a small pool (for duplicates and
+// Find/Patch collisions) or arbitrary.
+func genName(tc hegel.TestCase) string {
+	if chance(tc, 60) {
+		return quote(pick(tc, "a", "b", "c", "", "a/b", "~", "~0", "~1", "-", "0", "1", "01", " ", "key", "日本"))
+	}
+	// Names stay valid UTF-8: a JSON pointer is text and cannot name a member
+	// whose name holds an invalid byte (hujson compares such names bytewise).
+	return strings.ReplaceAll(genString(tc), "\xff", "x")
+}
+
+// genValueText draws HuJSON text of a value with random extras inside it (the
+// extras around the value are the caller's).
+func genValueText(tc hegel.TestCase, depth int, comments bool) string {
+	if depth >= 3 || chance(tc, 45) {
+		return genLiteral(tc)
+	}
+	var sb strings.Builder
+	k := n(tc, 0, 4)
+	if depth == 0 && chance(tc, 10) {
+		k = n(tc, 0, 12)
+	}
+	if chance(tc, 50) {
+		sb.WriteByte('{')
+		for i := 0; i < k; i++ {
+			sb.WriteString(genExtra(tc, comments))
+			sb.WriteString(genName(tc))
+			if chance(tc, 20) {
+				sb.WriteString(genExtra(tc, comments))
+			}
+			sb.WriteByte(':')
+			if chance(tc, 60) {
+				sb.WriteString(genExtra(tc, comments))
+			}
+			sb.WriteString(genValueText(tc, depth+1, comments))
+			if chance(tc, 20) {
+				sb.WriteString(genExtra(tc, comments))
+			}
+			if i < k-1 || chance(tc, 30) {
+				sb.WriteByte(',')
+			}
+		}
+		sb.WriteString(genExtra(tc, comments))
+		sb.WriteByte('}')
+	} else {
+		sb.WriteByte('[')
+		for i := 0; i < k; i++ {
+			sb.WriteString(genExtra(tc, comments))
+			sb.WriteString(genValueText(tc, depth+1, comments))
+			if chance(tc, 20) {
+				sb.WriteString(genExtra(tc, comments))
+			}
+			if i < k-1 || chance(tc, 30) {
+				sb.WriteByte(',')
+			}
+		}
+		sb.WriteString(genExtra(tc, comments))
+		sb.WriteByte(']')
+	}
+	return sb.String()
+}
+
+// genDoc draws a whole HuJSON document and its model parse.
+func genDoc(ht *hegel.T) ([]byte, *pnode) {
+	comments := chance(ht, 80)
+	text := genExtra(ht, comments) + genValueText(ht, 0, comments) + genExtra(ht, comments)
+	if chance(ht, 30) {
+		text = strings.TrimRight(text, " \t\r\n") + "\n"
+	}
+	b := []byte(text)
+	want, err := modelParse(b)
+	if err != nil {
+		fail(ht, "generator produced a document the model rejects: %q: %v", b, err)
+	}
+	if want.String() != text {
+		fail(ht, "model does not round-trip its own parse of %q: %q", text, want.String())
+	}
+	return b, want
+}
+
+// ---------------------------------------------------------------------------
+// Property 1: Parse builds the exact tree, Pack restores the input.
+
+func TestHegelParseBuildsTheExactTree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, want := genDoc(ht)
+		note(ht, "doc %q", b)
+		v, err := hujson.Parse(b)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", b, err)
+		}
+		if err := compareTree(&v, want, "$"); err != nil {
+			fail(ht, "tree of %q: %v", b, err)
+		}
+		if got := v.Pack(); !bytes.Equal(got, b) {
+			fail(ht, "Pack(Parse(%q)) = %q", b, got)
+		}
+		if v.String() != string(b) {
+			fail(ht, "String() %q != Pack %q", v.String(), b)
+		}
+		if err := checkOffsets(&v, b); err != nil {
+			fail(ht, "offsets after Parse of %q: %v", b, err)
+		}
+		before := fmt.Sprint(offsetsOf(&v))
+		v.UpdateOffsets()
+		if after := fmt.Sprint(offsetsOf(&v)); after != before {
+			fail(ht, "UpdateOffsets changed correct offsets of %q: %s -> %s", b, before, after)
+		}
+		if got, wantStd := v.IsStandard(), want.isStandard(); got != wantStd {
+			fail(ht, "IsStandard(%q) = %v, want %v", b, got, wantStd)
+		}
+		var order []*pnode
+		want.preorder(&order)
+		var got []int
+		for x := range v.All() {
+			got = append(got, x.StartOffset)
+		}
+		var wantOrder []int
+		for _, x := range order {
+			wantOrder = append(wantOrder, x.start)
+		}
+		if !reflect.DeepEqual(got, wantOrder) {
+			fail(ht, "All() offsets %v, want %v for %q", got, wantOrder, b)
+		}
+		// Range visits in the same order and stops when told to.
+		stop := n(ht, 0, len(wantOrder))
+		var seen []int
+		ret := v.Range(func(x *hujson.Value) bool {
+			seen = append(seen, x.StartOffset)
+			return len(seen) < stop+1
+		})
+		if stop < len(wantOrder) {
+			if ret || !reflect.DeepEqual(seen, wantOrder[:stop+1]) {
+				fail(ht, "Range stopped at %d: returned %v, saw %v (want %v)", stop, ret, seen, wantOrder[:stop+1])
+			}
+		} else if !ret || !reflect.DeepEqual(seen, wantOrder) {
+			fail(ht, "Range to the end: returned %v, saw %v (want %v)", ret, seen, wantOrder)
+		}
+	})
+}
+
+func offsetsOf(v *hujson.Value) []int {
+	var out []int
+	for x := range v.All() {
+		out = append(out, x.StartOffset, x.EndOffset)
+	}
+	return out
+}
+
+// ---------------------------------------------------------------------------
+// Property 2: the grammar — Parse accepts exactly what the model accepts.
+
+var alphabet = []string{"{", "}", "[", "]", ":", ",", "\"", "\\", "/", "*", "0", "1", "9", "-", "+", ".", "e", "E", " ", "\t", "\n", "\r", "t", "r", "u", "e", "f", "a", "l", "s", "n", "\xff", "\xc3\xa9", "\u2028", "x", "u", "0", "1"}
+
+var errRE = regexp.MustCompile(`^hujson: line (\d+), column (\d+): .`)
+
+func genBytesDoc(ht *hegel.T) []byte {
+	if chance(ht, 50) {
+		k := n(ht, 0, 12)
+		var sb strings.Builder
+		for i := 0; i < k; i++ {
+			sb.WriteString(pick(ht, alphabet...))
+		}
+		return []byte(sb.String())
+	}
+	b, _ := genDoc(ht)
+	edits := n(ht, 1, 3)
+	for i := 0; i < edits && len(b) > 0; i++ {
+		pos := n(ht, 0, len(b)-1)
+		switch n(ht, 0, 3) {
+		case 0:
+			b = append(b[:pos:pos], b[pos+1:]...)
+		case 1:
+			b = append(append(append([]byte{}, b[:pos]...), pick(ht, alphabet...)...), b[pos:]...)
+		case 2:
+			tok := pick(ht, "//x\n", "/*x*/", ",", "\"", "\u2028", "\xff", "\\", "/", "*/", "\n", "//", "/*", "]", "}", " 1")
+			b = append(append(append([]byte{}, b[:pos]...), tok...), b[pos:]...)
+		default:
+			b = append(append(append([]byte{}, b[:pos]...), pick(ht, alphabet...)...), b[pos+1:]...)
+		}
+	}
+	return b
+}
+
+func TestHegelGrammarFollowsJWCC(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b := genBytesDoc(ht)
+		note(ht, "bytes %q", b)
+		want, werr := modelParse(b)
+		orig := append([]byte{}, b...)
+		v, err := hujson.Parse(b)
+		if (err == nil) != (werr == nil) {
+			fail(ht, "Parse(%q): err=%v, model err=%v", b, err, werr)
+		}
+		if !bytes.Equal(b, orig) {
+			fail(ht, "Parse mutated its input %q -> %q", orig, b)
+		}
+		if err != nil {
+			m := errRE.FindStringSubmatch(err.Error())
+			if m == nil {
+				fail(ht, "error for %q not in the documented form: %q", b, err)
+			}
+			line, _ := strconv.Atoi(m[1])
+			col, _ := strconv.Atoi(m[2])
+			lines := strings.Split(string(b), "\n")
+			if line < 1 || line > len(lines) || col < 1 || col > len(lines[line-1])+1 {
+				fail(ht, "error position line %d column %d outside %q: %v", line, col, b, err)
+			}
+			// The convenience functions return the input as is with the error.
+			for _, f := range []struct {
+				name string
+				fn   func([]byte) ([]byte, error)
+			}{{"Standardize", hujson.Standardize}, {"Minimize", hujson.Minimize}, {"Format", hujson.Format}} {
+				out, ferr := f.fn(b)
+				if ferr == nil || !bytes.Equal(out, b) || ferr.Error() != err.Error() {
+					fail(ht, "%s(%q) on invalid input: out=%q err=%v (Parse err %v)", f.name, b, out, ferr, err)
+				}
+			}
+			return
+		}
+		if err := compareTree(&v, want, "$"); err != nil {
+			fail(ht, "tree of %q: %v", b, err)
+		}
+		if got := v.Pack(); !bytes.Equal(got, b) {
+			fail(ht, "Pack(Parse(%q)) = %q", b, got)
+		}
+		checkStandardizeAndMinimize(ht, b, want)
+		checkFormat(ht, b, want)
+		checkOverwrite(ht, b)
+	})
+}
+
+// checkOverwrite: without the gate, the convenience functions leave their
+// input alone; with it, the shape of the damage is recorded here.
+func checkOverwrite(ht *hegel.T, b []byte) {
+	if Known.inputOverwritten {
+		return
+	}
+	for _, f := range []struct {
+		name string
+		fn   func([]byte) ([]byte, error)
+	}{{"Standardize", hujson.Standardize}, {"Minimize", hujson.Minimize}, {"Format", hujson.Format}} {
+		call(ht, f.name, f.fn, b)
+	}
+}
+
+func TestHegelExtraIsValidFollowsTheGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var b []byte
+		if chance(ht, 50) {
+			b = []byte(genExtra(ht, true))
+			if chance(ht, 30) && len(b) > 0 {
+				pos := n(ht, 0, len(b)-1)
+				b = append(append(append([]byte{}, b[:pos]...), pick(ht, "/", "*/", "\xff", "\u2028", "x", "\n", "//", "/*")...), b[pos:]...)
+			}
+		} else {
+			k := n(ht, 0, 8)
+			var sb strings.Builder
+			for i := 0; i < k; i++ {
+				sb.WriteString(pick(ht, "/", "*", " ", "\n", "\t", "\r", "x", "\xff", "\u2028", "//", "/*", "*/"))
+			}
+			b = []byte(sb.String())
+		}
+		p := &mparser{b}
+		end, err := p.extra(0)
+		want := err == nil && end == len(b)
+		if got := hujson.Extra(b).IsValid(); got != want {
+			fail(ht, "Extra(%q).IsValid() = %v, want %v (model: end %d err %v)", b, got, want, end, err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 3: Standardize and Minimize are exactly what the documentation says.
+
+func checkStandardizeAndMinimize(ht *hegel.T, b []byte, want *pnode) {
+	var sb strings.Builder
+	want.std(&sb)
+	wantStd := sb.String()
+	got, err := call(ht, "Standardize", hujson.Standardize, b)
+	if err != nil {
+		fail(ht, "Standardize(%q): %v", b, err)
+	}
+	if string(got) != wantStd {
+		fail(ht, "Standardize(%q) = %q, want %q", b, got, wantStd)
+	}
+	if !json.Valid(got) {
+		fail(ht, "Standardize(%q) = %q is not valid JSON", b, got)
+	}
+	var x, y any
+	if err := json.Unmarshal(got, &x); err != nil {
+		fail(ht, "json.Unmarshal(Standardize(%q)): %v", b, err)
+	}
+	y, _ = jsonValue(want)
+	if !reflect.DeepEqual(x, y) {
+		fail(ht, "Standardize(%q) decodes to %v, want %v", b, x, y)
+	}
+	// The in-place method: the same bytes, standard, offsets untouched.
+	v, _ := hujson.Parse(cp(b))
+	before := fmt.Sprint(offsetsOf(&v))
+	v.Standardize()
+	if p := v.Pack(); string(p) != wantStd {
+		fail(ht, "Value.Standardize of %q packs to %q, want %q", b, p, wantStd)
+	}
+	if !v.IsStandard() {
+		fail(ht, "IsStandard false after Standardize of %q", b)
+	}
+	if after := fmt.Sprint(offsetsOf(&v)); after != before {
+		fail(ht, "Standardize moved offsets of %q: %s -> %s", b, before, after)
+	}
+	if err := checkOffsets(&v, v.Pack()); err != nil {
+		fail(ht, "offsets after Standardize of %q: %v", b, err)
+	}
+	// Minimize is the compact form, and json.Compact of the standard form.
+	wantMin := compactOf(want)
+	gotMin, err := call(ht, "Minimize", hujson.Minimize, b)
+	if err != nil || string(gotMin) != wantMin {
+		fail(ht, "Minimize(%q) = %q (err %v), want %q", b, gotMin, err, wantMin)
+	}
+	var buf bytes.Buffer
+	if err := json.Compact(&buf, got); err != nil || buf.String() != wantMin {
+		fail(ht, "json.Compact(Standardize(%q)) = %q (err %v), Minimize %q", b, buf.String(), err, wantMin)
+	}
+	w, _ := hujson.Parse(cp(b))
+	w.Minimize()
+	if p := w.Pack(); string(p) != wantMin || !w.IsStandard() {
+		fail(ht, "Value.Minimize of %q packs to %q (standard %v), want %q", b, p, w.IsStandard(), wantMin)
+	}
+	if err := checkOffsets(&w, w.Pack()); err != nil {
+		fail(ht, "offsets after Minimize of %q: %v", b, err)
+	}
+}
+
+func TestHegelStandardizeKeepsOffsetsAndMinimizeIsCompact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, want := genDoc(ht)
+		note(ht, "doc %q", b)
+		checkStandardizeAndMinimize(ht, b, want)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 4: Format.
+
+// normComments lists the comments of an extra in order, each normalized the
+// way Format may legitimately change it: CR handling as in Extra.format,
+// trailing whitespace trimmed, block-comment lines trimmed and empty lines
+// dropped (Format re-indents them).
+func normComments(extra string) []string {
+	s := strings.ReplaceAll(extra, "\r\n", "\n")
+	s = strings.ReplaceAll(s, "\n\r", "\n")
+	s = strings.ReplaceAll(s, "\r", " ")
+	var out []string
+	b := []byte(s)
+	for i := 0; i < len(b); {
+		if isWS(b[i]) {
+			i++
+			continue
+		}
+		if strings.HasPrefix(s[i:], "//") {
+			j := strings.IndexByte(s[i:], '\n')
+			if j < 0 {
+				j = len(s) - i
+			}
+			out = append(out, strings.TrimRightFunc(s[i:i+j], unicode.IsSpace))
+			i += j
+			continue
+		}
+		if strings.HasPrefix(s[i:], "/*") {
+			j := strings.Index(s[i+2:], "*/")
+			if j < 0 {
+				out = append(out, "<invalid>"+s[i:])
+				return out
+			}
+			com := s[i : i+2+j+2]
+			var lines []string
+			for _, l := range strings.Split(com, "\n") {
+				l = strings.TrimSpace(l)
+				if l != "" {
+					lines = append(lines, l)
+				}
+			}
+			out = append(out, strings.Join(lines, "\n"))
+			i += len(com)
+			continue
+		}
+		out = append(out, "<invalid>"+s[i:])
+		return out
+	}
+	return out
+}
+
+// allExtras lists every extra of the tree in document order.
+func (v *pnode) allExtras(out *[]string) {
+	*out = append(*out, v.before)
+	for _, m := range v.members {
+		m.name.allExtras(out)
+		m.val.allExtras(out)
+	}
+	for _, e := range v.elems {
+		e.allExtras(out)
+	}
+	if v.kind == '{' || v.kind == '[' {
+		*out = append(*out, v.compAfter)
+	}
+	*out = append(*out, v.after)
+}
+
+func allComments(v *pnode) []string {
+	var extras []string
+	v.allExtras(&extras)
+	var out []string
+	for _, e := range extras {
+		out = append(out, normComments(e)...)
+	}
+	return out
+}
+
+// checkFormattedExtra checks the whitespace discipline of one formatted extra:
+// no carriage returns; a whitespace run without a newline is a single space
+// (several only where alignment pads an object value); a run with newlines is
+// one or two newlines followed by tabs only.
+func checkFormattedExtra(extra string, alignable bool) error {
+	if strings.IndexByte(extra, '\r') >= 0 {
+		return fmt.Errorf("carriage return in formatted extra %q", extra)
+	}
+	for i := 0; i < len(extra); {
+		if !isWS(extra[i]) {
+			// skip the comment
+			if strings.HasPrefix(extra[i:], "//") {
+				j := strings.IndexByte(extra[i:], '\n')
+				if j < 0 {
+					return fmt.Errorf("unterminated line comment in %q", extra)
+				}
+				i += j // the newline belongs to the following run
+				continue
+			}
+			j := strings.Index(extra[i+2:], "*/")
+			if j < 0 {
+				return fmt.Errorf("unterminated block comment in %q", extra)
+			}
+			i += 2 + j + 2
+			continue
+		}
+		j := i
+		for j < len(extra) && isWS(extra[j]) {
+			j++
+		}
+		run := extra[i:j]
+		if strings.IndexByte(run, '\n') < 0 {
+			if strings.Trim(run, " ") != "" {
+				return fmt.Errorf("whitespace run %q in %q is not spaces", run, extra)
+			}
+			if len(run) != 1 && !alignable {
+				return fmt.Errorf("whitespace run %q in %q is not a single space", run, extra)
+			}
+		} else {
+			nl := strings.Count(run, "\n")
+			rest := strings.TrimLeft(run, "\n")
+			if nl > 2 || strings.Trim(rest, "\t") != "" || strings.IndexByte(rest, '\n') >= 0 {
+				return fmt.Errorf("whitespace run %q in %q is not one or two newlines and tabs", run, extra)
+			}
+		}
+		i = j
+	}
+	return nil
+}
+
+func checkFormattedTree(v *pnode, alignable bool) error {
+	if err := checkFormattedExtra(v.before, alignable); err != nil {
+		return err
+	}
+	if err := checkFormattedExtra(v.after, false); err != nil {
+		return err
+	}
+	if v.kind == '{' || v.kind == '[' {
+		if err := checkFormattedExtra(v.compAfter, false); err != nil {
+			return err
+		}
+		// Inlined or fully expanded.
+		// "If any whitespace after a '{', '[', or ',' or before a '}' or ']'
+		// contains a newline, then we always expand the object or array."
+		expanded := strings.IndexByte(v.compAfter, '\n') >= 0
+		var befores []string
+		for _, m := range v.members {
+			befores = append(befores, m.name.before)
+		}
+		for _, e := range v.elems {
+			befores = append(befores, e.before)
+		}
+		for _, b := range befores {
+			if strings.IndexByte(b, '\n') >= 0 {
+				expanded = true
+			}
+		}
+		if expanded {
+			for i, b := range befores {
+				if strings.IndexByte(b, '\n') < 0 {
+					return fmt.Errorf("expanded composite %q: member %d not on its own line (before %q)", v.String(), i, b)
+				}
+			}
+			if !strings.HasSuffix(strings.TrimRight(v.compAfter, "\t"), "\n") {
+				return fmt.Errorf("expanded composite %q: closing bracket not on its own line (%q)", v.String(), v.compAfter)
+			}
+		} else {
+			last := lastOf(v)
+			surrounded := last != nil && last.after != "" && v.compAfter != ""
+			if v.trailingComma && !surrounded {
+				return fmt.Errorf("inlined composite %q has a trailing comma", v.String())
+			}
+		}
+		for _, m := range v.members {
+			if err := checkFormattedTree(m.name, false); err != nil {
+				return err
+			}
+			if err := checkFormattedTree(m.val, true); err != nil {
+				return err
+			}
+		}
+		for _, e := range v.elems {
+			if err := checkFormattedTree(e, false); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func lastOf(v *pnode) *pnode {
+	if len(v.members) > 0 {
+		return v.members[len(v.members)-1].val
+	}
+	if len(v.elems) > 0 {
+		return v.elems[len(v.elems)-1]
+	}
+	return nil
+}
+
+// expandedHaveTrailingCommas: in an expanded composite the trailing comma is
+// present exactly when the input was not standard JSON.
+func expandedHaveTrailingCommas(v *pnode, wantComma bool) error {
+	if v.kind == '{' || v.kind == '[' {
+		expanded := strings.IndexByte(v.compAfter, '\n') >= 0
+		if expanded && lastOf(v) != nil && v.trailingComma != wantComma {
+			return fmt.Errorf("expanded composite %q: trailing comma %v, want %v", v.String(), v.trailingComma, wantComma)
+		}
+		for _, m := range v.members {
+			if err := expandedHaveTrailingCommas(m.val, wantComma); err != nil {
+				return err
+			}
+		}
+		for _, e := range v.elems {
+			if err := expandedHaveTrailingCommas(e, wantComma); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func checkFormat(ht *hegel.T, b []byte, want *pnode) {
+	out, err := call(ht, "Format", hujson.Format, b)
+	if err != nil {
+		fail(ht, "Format(%q): %v", b, err)
+	}
+	f, ferr := modelParse(out)
+	if ferr != nil {
+		fail(ht, "Format(%q) = %q is not HuJSON: %v", b, out, ferr)
+	}
+	if _, err := hujson.Parse(out); err != nil {
+		fail(ht, "Parse(Format(%q) = %q): %v", b, out, err)
+	}
+	out2, err := hujson.Format(cp(out))
+	if err != nil || !bytes.Equal(out2, out) {
+		fail(ht, "Format not idempotent on %q: %q -> %q (err %v)", b, out, out2, err)
+	}
+	// One trailing newline, nothing before the value but comments.
+	if len(out) < 2 || out[len(out)-1] != '\n' || unicode.IsSpace(rune(out[len(out)-2])) {
+		fail(ht, "Format(%q) = %q does not end in exactly one newline", b, out)
+	}
+	if f.before != "" && isWS(f.before[0]) {
+		fail(ht, "Format(%q) = %q starts with whitespace", b, out)
+	}
+	for i, line := range strings.Split(strings.TrimSuffix(string(out), "\n"), "\n") {
+		if strings.TrimRightFunc(line, unicode.IsSpace) != line {
+			fail(ht, "Format(%q) = %q: line %d has trailing whitespace", b, out, i+1)
+		}
+	}
+	// The value is preserved (strings may be re-escaped).
+	x, _ := jsonValue(f)
+	y, _ := jsonValue(want)
+	if !reflect.DeepEqual(x, y) {
+		fail(ht, "Format(%q) = %q changed the value: %v -> %v", b, out, y, x)
+	}
+	// Standard stays standard; the comments survive in order.
+	if want.isStandard() && !f.isStandard() {
+		fail(ht, "Format(%q) = %q is not standard JSON any more", b, out)
+	}
+	if gc, wc := allComments(f), allComments(want); !reflect.DeepEqual(gc, wc) {
+		fail(ht, "Format(%q) = %q changed the comments: %q -> %q", b, out, wc, gc)
+	}
+	// Whitespace discipline and the inline-or-expanded rule.
+	if err := checkFormattedTree(f, false); err != nil {
+		fail(ht, "Format(%q) = %q: %v", b, out, err)
+	}
+	if err := expandedHaveTrailingCommas(f, !want.isStandard()); err != nil {
+		fail(ht, "Format(%q) = %q: %v", b, out, err)
+	}
+	// The in-place method agrees and leaves correct offsets.
+	v, _ := hujson.Parse(cp(b))
+	v.Format()
+	if p := v.Pack(); !bytes.Equal(p, out) {
+		fail(ht, "Value.Format of %q packs to %q, Format gives %q", b, p, out)
+	}
+	if err := checkOffsets(&v, v.Pack()); err != nil {
+		fail(ht, "offsets after Format of %q: %v", b, err)
+	}
+}
+
+func TestHegelFormatIsIdempotentAndFaithful(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, want := genDoc(ht)
+		note(ht, "doc %q", b)
+		checkFormat(ht, b, want)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 5: Find follows RFC 6901.
+
+type locStatus int
+
+const (
+	locFound   locStatus = iota
+	locMissing           // the last segment names nothing (the parent exists)
+	locBad               // invalid pointer, or a middle segment names nothing
+)
+
+var indexRE = regexp.MustCompile(`^(0|[1-9][0-9]*)$`)
+
+func unescapeSeg(seg string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(seg, "~1", "/"), "~0", "~")
+}
+
+func escapeSeg(name string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(name, "~", "~0"), "/", "~1")
+}
+
+// locate resolves a JSON pointer in the model: the parent container, the
+// index in it (len for a missing member or "-"), the member name for objects,
+// the node, and the status.
+func locate(root *pnode, ptr string) (parent *pnode, idx int, name string, node *pnode, st locStatus) {
+	cur := root
+	if ptr == "" {
+		return nil, -1, "", root, locFound
+	}
+	if ptr[0] != '/' {
+		return nil, -1, "", nil, locBad
+	}
+	segs := strings.Split(ptr[1:], "/")
+	for i, seg := range segs {
+		last := i == len(segs)-1
+		nm := unescapeSeg(seg)
+		switch cur.kind {
+		case '{':
+			found := -1
+			for j, m := range cur.members {
+				if unquote(m.name.lit) == nm {
+					found = j
+					break
+				}
+			}
+			if found < 0 {
+				if last {
+					return cur, len(cur.members), nm, nil, locMissing
+				}
+				return nil, -1, "", nil, locBad
+			}
+			parent, idx, name, node = cur, found, nm, cur.members[found].val
+			cur = node
+		case '[':
+			if seg == "-" {
+				if last {
+					return cur, len(cur.elems), "", nil, locMissing
+				}
+				return nil, -1, "", nil, locBad
+			}
+			if !indexRE.MatchString(seg) {
+				return nil, -1, "", nil, locBad
+			}
+			k, err := strconv.ParseUint(seg, 10, 64)
+			if err != nil {
+				return nil, -1, "", nil, locBad
+			}
+			if k >= uint64(len(cur.elems)) {
+				if last {
+					return cur, int(min(k, 1<<31)), "", nil, locMissing
+				}
+				return nil, -1, "", nil, locBad
+			}
+			parent, idx, name, node = cur, int(k), "", cur.elems[k]
+			cur = node
+		default:
+			return nil, -1, "", nil, locBad
+		}
+	}
+	return parent, idx, name, node, locFound
+}
+
+// pointers lists a pointer to every node (duplicates included: the pointer of
+// a later duplicate member resolves to the first, which locate handles).
+func pointers(v *pnode, prefix string, out *[]string) {
+	*out = append(*out, prefix)
+	for _, m := range v.members {
+		pointers(m.val, prefix+"/"+escapeSeg(unquote(m.name.lit)), out)
+	}
+	for i, e := range v.elems {
+		pointers(e, prefix+"/"+strconv.Itoa(i), out)
+	}
+}
+
+func genPointer(tc hegel.TestCase, root *pnode) string {
+	var ptrs []string
+	pointers(root, "", &ptrs)
+	p := pick(tc, ptrs...)
+	if chance(tc, 60) {
+		return p
+	}
+	// Mutations: mostly misses, some hits by another route.
+	switch n(tc, 0, 9) {
+	case 0:
+		return p + "/" + pick(tc, "x", "-", "0", "1", "2", "a", "", "~0", "~1")
+	case 1:
+		return strings.TrimPrefix(p, "/")
+	case 2:
+		return p + "/"
+	case 3:
+		return strings.TrimSuffix(p, "/"+lastSeg(p)) + "/" + pick(tc, "-1", "1.0", "+1", " 1", "00", "1e0", "0x1", "18446744073709551615", "18446744073709551616", "99999999999")
+	case 4:
+		if Known.leadingZeroIndex {
+			return p
+		}
+		return strings.TrimSuffix(p, "/"+lastSeg(p)) + "/0" + lastSeg(p)
+	case 5:
+		return strings.ReplaceAll(p, "~1", "/")
+	case 6:
+		return strings.ReplaceAll(p, "~0", "~")
+	case 7:
+		return p + p
+	default:
+		return pick(tc, "", "/", "//", "/-", "/~", "/~2", "a", "/a/b/c", "/0/0/0")
+	}
+}
+
+func lastSeg(p string) string {
+	if i := strings.LastIndexByte(p, '/'); i >= 0 {
+		return p[i+1:]
+	}
+	return p
+}
+
+func TestHegelFindFollowsRFC6901(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, want := genDoc(ht)
+		v, err := hujson.Parse(b)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", b, err)
+		}
+		for i := 0; i < 4; i++ {
+			ptr := genPointer(ht, want)
+			note(ht, "doc %q pointer %q", b, ptr)
+			_, _, _, node, st := locate(want, ptr)
+			got := v.Find(ptr)
+			switch {
+			case st == locFound && got == nil:
+				fail(ht, "Find(%q) in %q = nil, want the value at offset %d", ptr, b, node.start)
+			case st == locFound && got.StartOffset != node.start:
+				fail(ht, "Find(%q) in %q = value at offset %d (%q), want offset %d (%q)", ptr, b, got.StartOffset, got.Pack(), node.start, node.String())
+			case st != locFound && got != nil:
+				fail(ht, "Find(%q) in %q = %q at offset %d, want nil", ptr, b, got.Pack(), got.StartOffset)
+			}
+		}
+	})
+}
