+package hujson_test
+
+// The generators of the properties, as values built from hegel-go's
+// combinators (STYLE.md). A HuJSON document is drawn as a tree (docSpec: the
+// extras around a jnode whose containers carry the extras of their members
+// or elements, the extra before the closing bracket and a trailing comma)
+// and rendered by a pure function; the model then parses the rendering. The
+// edits of a text, the pointers of a Find case and the operations of a patch
+// are drawn as data too and resolved against the live document when applied,
+// with positions taken modulo what exists, so that the shrinker can delete
+// steps freely. Non-ASCII literals are written as escapes.
+
+import (
+	"fmt"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Generator idioms (the zoo's Go conventions, see STYLE.md).
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.WeightedBooleans(float64(pct) / 100)
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and
+// nil otherwise (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// joined concatenates the strings of a list generator.
+func joined(g hegel.Generator[[]string]) hegel.Generator[string] {
+	return hegel.Map(g, func(ps []string) string { return strings.Join(ps, "") })
+}
+
+// deferred draws through a pointer to a generator, so that a recursive
+// grammar can name a generator before it is built (the forward declaration
+// of hegel-go's ExampleComposite_recursive).
+func deferred[T any](g *hegel.Generator[T]) hegel.Generator[T] {
+	return hegel.Composite(func(tc hegel.TestCase) T { return hegel.Draw(tc, *g) })
+}
+
+// positions: an index into live data of unknown size, taken modulo the size
+// when applied (so every drawn value fits and the shrinker is free).
+var positions = hegel.Integers(0, 99)
+
+// tape is a drawn list of small integers that a pure writer consumes in
+// order, recycled modulo its length, for the choices a rendering leaves free
+// (the order of an object's members, a coin). An empty tape answers 0 to
+// every question, so the shrunk form of every choice is its first, plainest
+// one.
+type tape struct {
+	vals []int
+	at   int
+}
+
+// next is the next value of the tape in 0..n-1.
+func (t *tape) next(n int) int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.at%len(t.vals)]
+	t.at++
+	return v % n
+}
+
+// coin is true pct percent of the time (false on an empty tape).
+func (t *tape) coin(pct int) bool { return t.next(100) >= 100-pct }
+
+// ---------------------------------------------------------------------------
+// Extras: whitespace and comments.
+
+// wsRuns: one run of whitespace (a space or a newline twice as often as the
+// rest).
+var wsRuns = hegel.SampledFrom([]string{" ", " ", "\t", "\n", "\n", "\r\n", "  ", "\n\n", "\n\n\n", "\r"})
+
+var (
+	commentMarks = hegel.SampledFrom([]string{"/*", "//", "* ", "**", "/"})
+	// commentSpecials: non-ASCII text, a paragraph separator and blanks.
+	commentSpecials = hegel.SampledFrom([]string{"\u00e9", "\u65e5\u672c", "\u2029", "\t", " "})
+	// asciiChars: one printable ASCII character.
+	asciiChars = hegel.Map(hegel.Integers(0x20, 0x7e), func(c int) string { return string(rune(c)) })
+)
+
+// commentTexts: the text of a comment: up to four pieces, nine in twelve a
+// printable ASCII character, else a comment mark, a line break (in a block
+// comment; blanks or non-ASCII text in a line comment) or a special. A block
+// comment's text never closes it early, a line comment's holds no U+2028/9
+// (hujson rejects them there).
+func commentTexts(block bool) hegel.Generator[string] {
+	breaks := hegel.SampledFrom([]string{"\t", "  ", "\u00e9", "\u65e5\u672c"})
+	if block {
+		breaks = hegel.SampledFrom([]string{"\n", "\n  ", "\n\t", "\n\n", "\n * ", "\r\n", "\n\n\n", "\u2028"})
+	}
+	pieces := weighted(
+		choice[string]{9, asciiChars},
+		choice[string]{1, commentMarks},
+		choice[string]{1, breaks},
+		choice[string]{1, commentSpecials},
+	)
+	return hegel.Map(joined(many(pieces, 0, 4)), func(s string) string {
+		if block {
+			return strings.ReplaceAll(s, "*/", "*.")
+		}
+		return strings.NewReplacer("\u2028", " ", "\u2029", " ").Replace(s)
+	})
+}
+
+var (
+	lineComments  = hegel.Map(commentTexts(false), func(s string) string { return "//" + s + "\n" })
+	blockComments = hegel.Map(commentTexts(true), func(s string) string { return "/*" + s + "*/" })
+)
+
+// extrasOf: an extra (the whitespace and comments around a value): empty 45%
+// of the time, else one to three pieces, each a whitespace run or, when
+// comments are on, half of the time a line or a block comment. Comments hold
+// no lone '\r' (Format turns those into spaces, which the comment-preservation
+// check would see).
+func extrasOf(comments bool) hegel.Generator[string] {
+	pieces := wsRuns
+	if comments {
+		pieces = weighted(choice[string]{50, wsRuns}, choice[string]{25, lineComments}, choice[string]{25, blockComments})
+	}
+	return maybe(55, joined(many(pieces, 1, 3)))
+}
+
+// ---------------------------------------------------------------------------
+// Literals.
+
+var (
+	shortEscapes = hegel.SampledFrom([]string{"\\\"", "\\\\", "\\/", "\\b", "\\f", "\\n", "\\r", "\\t"})
+	uEscapes     = hegel.Map(hegel.Integers(0, 0xffff), func(u int) string { return fmt.Sprintf("\\u%04x", u) })
+	// oddPieces: an astral character, lone surrogate escapes (accepted, as
+	// by encoding/json v1), a line separator, a slash.
+	oddPieces = hegel.SampledFrom([]string{"\U0001f600", "\\uD800", "\\udc00", "\u2028", "/", "\u2028"})
+	oddRunes  = hegel.Map(hegel.SampledFrom([]rune{0x7f, 0xe9, 0x2028, 0x2029, 0x1f600, 0xfffd, 0x3000}), func(r rune) string { return string(r) })
+	// punctuation: the bytes that mean something to the grammar.
+	punctuation = hegel.SampledFrom([]string{"/", "*", "{", "}", "[", "]", ",", ":", "~", "-"})
+	// stringPieces: eight in thirteen a printable ASCII character, else a
+	// short escape, a \u escape, an odd piece, an odd rune, or punctuation
+	// (an invalid byte 0xff, which hujson accepts, three times in ten of those).
+	stringPieces = weighted(
+		choice[string]{8, asciiChars},
+		choice[string]{1, shortEscapes},
+		choice[string]{1, uEscapes},
+		choice[string]{1, oddPieces},
+		choice[string]{1, oddRunes},
+		choice[string]{1, weighted(choice[string]{70, punctuation}, choice[string]{30, hegel.Just("\xff")})},
+	)
+	// stringLits: a JSON string literal of up to four pieces (up to twenty
+	// one time in ten), its body made valid by sanitizeBody.
+	stringLits = hegel.Map(weighted(choice[[]string]{90, many(stringPieces, 0, 4)}, choice[[]string]{10, many(stringPieces, 0, 20)}), func(ps []string) string {
+		return `"` + sanitizeBody(strings.Join(ps, "")) + `"`
+	})
+)
+
+var (
+	numberPool = hegel.SampledFrom([]string{"0", "-0", "1", "-1", "10", "255", "1e5", "1E+5", "1e-5", "0.5", "-0.0", "1.25e2", "123456789012345678901234567890", "1.7976931348623157e308", "4.9e-324"})
+	smallInts  = hegel.Map(hegel.Integers(-1000, 1000), strconv.Itoa)
+	// fractions: a multiple of 1/128 within +-782 in its shortest spelling.
+	fractions = hegel.Map(hegel.Integers(-100000, 100000), func(n int) string { return strconv.FormatFloat(float64(n)/128, 'g', -1, 64) })
+	// suffixed: a 32-bit integer with a fraction or exponent spelling.
+	suffixed = hegel.Map(pairs(hegel.Integers(-1<<31, 1<<31), hegel.SampledFrom([]string{".0", ".5", "e0", "E-1", "e+2"})), func(p pair[int, string]) string {
+		return strconv.Itoa(p.a) + p.b
+	})
+	// numberLits: a small integer five times in eight, else a spelling of
+	// note, a fraction or a suffixed integer.
+	numberLits  = weighted(choice[string]{5, smallInts}, choice[string]{1, numberPool}, choice[string]{1, fractions}, choice[string]{1, suffixed})
+	keywordLits = hegel.SampledFrom([]string{"null", "true", "false"})
+	// literals: a keyword once in six, a string twice, a number three times.
+	literals = weighted(choice[string]{1, keywordLits}, choice[string]{2, stringLits}, choice[string]{3, numberLits})
+	// namePool: short names, for duplicates and Find/Patch collisions.
+	namePool = hegel.Map(hegel.SampledFrom([]string{"a", "b", "c", "", "a/b", "~", "~0", "~1", "-", "0", "1", "01", " ", "key", "\u65e5\u672c"}), quote)
+	// names: an object name: six in ten from the pool, else a string
+	// literal kept valid UTF-8 (a JSON pointer is text and cannot name a
+	// member whose name holds an invalid byte; hujson compares such names
+	// bytewise).
+	names = weighted(choice[string]{60, namePool}, choice[string]{40, hegel.Map(stringLits, func(s string) string { return strings.ReplaceAll(s, "\xff", "x") })})
+)
+
+// ---------------------------------------------------------------------------
+// Value trees and documents.
+
+// jnode is a drawn HuJSON value: a literal, or a container whose members or
+// elements carry the extras around them.
+type jnode struct {
+	lit      string // the literal text (kind 0)
+	kind     byte   // 0 literal, '{' object, '[' array
+	members  []jmember
+	elems    []jelem
+	inner    string // the extra before the closing bracket
+	trailing bool   // a trailing comma after the last member or element
+}
+
+// jmember is an object member: the extras before the name, between the name
+// and the colon, after the colon and after the value.
+type jmember struct {
+	before, name, afterName, beforeVal string
+	val                                jnode
+	after                              string
+}
+
+// jelem is an array element with the extras before and after it.
+type jelem struct {
+	before string
+	val    jnode
+	after  string
+}
+
+func (n jnode) String() string {
+	var sb strings.Builder
+	n.render(&sb)
+	return sb.String()
+}
+
+// render writes the value's HuJSON text.
+func (n jnode) render(sb *strings.Builder) {
+	switch n.kind {
+	case '{':
+		sb.WriteByte('{')
+		for i, m := range n.members {
+			sb.WriteString(m.before)
+			sb.WriteString(m.name)
+			sb.WriteString(m.afterName)
+			sb.WriteByte(':')
+			sb.WriteString(m.beforeVal)
+			m.val.render(sb)
+			sb.WriteString(m.after)
+			if i < len(n.members)-1 || n.trailing {
+				sb.WriteByte(',')
+			}
+		}
+		sb.WriteString(n.inner)
+		sb.WriteByte('}')
+	case '[':
+		sb.WriteByte('[')
+		for i, e := range n.elems {
+			sb.WriteString(e.before)
+			e.val.render(sb)
+			sb.WriteString(e.after)
+			if i < len(n.elems)-1 || n.trailing {
+				sb.WriteByte(',')
+			}
+		}
+		sb.WriteString(n.inner)
+		sb.WriteByte(']')
+	default:
+		sb.WriteString(n.lit)
+	}
+}
+
+// clone is a deep copy of the tree (the edits below leave the drawn tree
+// alone).
+func (n jnode) clone() jnode {
+	c := n
+	c.members = append([]jmember(nil), n.members...)
+	for i := range c.members {
+		c.members[i].val = c.members[i].val.clone()
+	}
+	c.elems = append([]jelem(nil), n.elems...)
+	for i := range c.elems {
+		c.elems[i].val = c.elems[i].val.clone()
+	}
+	return c
+}
+
+// children are pointers to the values of the members or elements.
+func (n *jnode) children() []*jnode {
+	var out []*jnode
+	for i := range n.members {
+		out = append(out, &n.members[i].val)
+	}
+	for i := range n.elems {
+		out = append(out, &n.elems[i].val)
+	}
+	return out
+}
+
+// walk visits the nodes of the tree in preorder.
+func (n *jnode) walk(visit func(*jnode)) {
+	visit(n)
+	for _, c := range n.children() {
+		c.walk(visit)
+	}
+}
+
+// withLiteral is the tree with its at-th literal (modulo their number, in
+// preorder) replaced by lit; a tree without a literal (empty containers)
+// becomes the literal.
+func (n jnode) withLiteral(at int, lit string) jnode {
+	c := n.clone()
+	var lits []*jnode
+	c.walk(func(x *jnode) {
+		if x.kind == 0 {
+			lits = append(lits, x)
+		}
+	})
+	if len(lits) == 0 {
+		return jnode{lit: lit}
+	}
+	lits[at%len(lits)].lit = lit
+	return c
+}
+
+// withTrailingComma is the tree with a trailing comma after the last member
+// or element of its at-th non-empty container (modulo their number, in
+// preorder), and after the given extra; a tree without one becomes an array
+// of the tree with the comma.
+func (n jnode) withTrailingComma(at int, after string) jnode {
+	c := n.clone()
+	var conts []*jnode
+	c.walk(func(x *jnode) {
+		if len(x.members)+len(x.elems) > 0 {
+			conts = append(conts, x)
+		}
+	})
+	if len(conts) == 0 {
+		return jnode{kind: '[', elems: []jelem{{val: c, after: after}}, trailing: true}
+	}
+	x := conts[at%len(conts)]
+	x.trailing = true
+	if len(x.members) > 0 {
+		x.members[len(x.members)-1].after = after
+	} else {
+		x.elems[len(x.elems)-1].after = after
+	}
+	return c
+}
+
+// parsed is the model's tree of the value (a value the model rejects is a
+// bug of the generator).
+func (n jnode) parsed() *pnode {
+	text := n.String()
+	v, err := modelParse([]byte(text))
+	if err != nil {
+		panic(fmt.Sprintf("generator: %q: %v", text, err))
+	}
+	return v
+}
+
+// grammar is the value grammar of one mode: the extras, the members and
+// elements (whose values are trees) and the trees themselves.
+type grammar struct {
+	extras  hegel.Generator[string]
+	members hegel.Generator[jmember]
+	elems   hegel.Generator[jelem]
+	objects hegel.Generator[jnode] // an object of up to four members (for a root)
+	arrays  hegel.Generator[jnode] // an array of up to four elements (for a root)
+	trees   hegel.Generator[jnode]
+}
+
+// grammarOf: the values of a mode: with or without comments in the extras,
+// containers nesting levels deep. A tree is a literal 45% of the time (always
+// at the depth bound), else an object or an array of up to four members,
+// each with the extras around it, an inner extra and a trailing comma 30% of
+// the time; with wideRoot the root container has up to twelve members one
+// time in ten. The depth counter lives in the closure and is restored by
+// defer, so an aborted draw cannot leave it stale (hegel-go's
+// ExampleComposite_recursive).
+func grammarOf(comments bool, levels int, wideRoot bool) grammar {
+	ex := extrasOf(comments)
+	ex20, ex60, trailing := maybe(20, ex), maybe(60, ex), chance(30)
+	literalNodes := hegel.Map(literals, func(s string) jnode { return jnode{lit: s} })
+	depth := 0
+	var trees hegel.Generator[jnode]
+	child := deferred(&trees)
+	members := hegel.Composite(func(tc hegel.TestCase) jmember {
+		return jmember{
+			before:    hegel.Draw(tc, ex),
+			name:      hegel.Draw(tc, names),
+			afterName: hegel.Draw(tc, ex20),
+			beforeVal: hegel.Draw(tc, ex60),
+			val:       hegel.Draw(tc, child),
+			after:     hegel.Draw(tc, ex20),
+		}
+	})
+	elems := hegel.Composite(func(tc hegel.TestCase) jelem {
+		return jelem{before: hegel.Draw(tc, ex), val: hegel.Draw(tc, child), after: hegel.Draw(tc, ex20)}
+	})
+	containersOf := func(most int) (objects, arrays hegel.Generator[jnode]) {
+		memberLists, elemLists := many(members, 0, most), many(elems, 0, most)
+		objects = hegel.Composite(func(tc hegel.TestCase) jnode {
+			return jnode{kind: '{', members: hegel.Draw(tc, memberLists), inner: hegel.Draw(tc, ex), trailing: hegel.Draw(tc, trailing)}
+		})
+		arrays = hegel.Composite(func(tc hegel.TestCase) jnode {
+			return jnode{kind: '[', elems: hegel.Draw(tc, elemLists), inner: hegel.Draw(tc, ex), trailing: hegel.Draw(tc, trailing)}
+		})
+		return objects, arrays
+	}
+	objects, arrays := containersOf(4)
+	containers := hegel.OneOf(objects, arrays)
+	roots := containers
+	if wideRoot {
+		wideObjects, wideArrays := containersOf(12)
+		roots = weighted(choice[jnode]{90, containers}, choice[jnode]{10, hegel.OneOf(wideObjects, wideArrays)})
+	}
+	branches := weighted(choice[jnode]{45, literalNodes}, choice[jnode]{55, containers})
+	rootBranches := weighted(choice[jnode]{45, literalNodes}, choice[jnode]{55, roots})
+	trees = hegel.Composite(func(tc hegel.TestCase) jnode {
+		if depth >= levels {
+			return hegel.Draw(tc, literalNodes)
+		}
+		depth++
+		defer func() { depth-- }()
+		if depth == 1 {
+			return hegel.Draw(tc, rootBranches)
+		}
+		return hegel.Draw(tc, branches)
+	})
+	return grammar{extras: ex, members: members, elems: elems, objects: objects, arrays: arrays, trees: trees}
+}
+
+// docSpec is a drawn document: the extras around the root value and whether
+// the trailing whitespace is trimmed to one newline.
+type docSpec struct {
+	before string
+	root   jnode
+	after  string
+	nl     bool
+}
+
+func (d docSpec) text() string {
+	s := d.before + d.root.String() + d.after
+	if d.nl {
+		s = strings.TrimRight(s, " \t\r\n") + "\n"
+	}
+	return s
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (d docSpec) GoString() string { return fmt.Sprintf("doc %q", d.text()) }
+
+// docsWith: a document around a root of roots, with the grammar's extras.
+func docsWith(g grammar, roots hegel.Generator[jnode]) hegel.Generator[docSpec] {
+	nl := chance(30)
+	return hegel.Composite(func(tc hegel.TestCase) docSpec {
+		return docSpec{before: hegel.Draw(tc, g.extras), root: hegel.Draw(tc, roots), after: hegel.Draw(tc, g.extras), nl: hegel.Draw(tc, nl)}
+	})
+}
+
+var (
+	plainGrammar     = grammarOf(false, 3, true)
+	commentedGrammar = grammarOf(true, 3, true)
+	// docs: a HuJSON document, with comments in its extras four times in five.
+	docs = weighted(choice[docSpec]{20, docsWith(plainGrammar, plainGrammar.trees)}, choice[docSpec]{80, docsWith(commentedGrammar, commentedGrammar.trees)})
+	// opValues: the values of patch operations: comments inside, two levels deep.
+	opValues = grammarOf(true, 2, false).trees
+)
+
+// ---------------------------------------------------------------------------
+// Property 1: a document and where Range stops.
+
+// parseCase: a document and the visit (modulo their number plus one, the
+// end) at which Range is told to stop.
+type parseCase struct {
+	doc  docSpec
+	stop int
+}
+
+func (c parseCase) GoString() string { return fmt.Sprintf("%s stop %d", c.doc.GoString(), c.stop) }
+
+var parseCases = hegel.Composite(func(tc hegel.TestCase) parseCase {
+	return parseCase{doc: hegel.Draw(tc, docs), stop: hegel.Draw(tc, positions)}
+})
+
+// ---------------------------------------------------------------------------
+// Property 2: random and damaged bytes.
+
+// alphabet: the bytes and short sequences of the grammar (an invalid byte,
+// a non-ASCII letter and a line separator among them).
+var alphabet = []string{"{", "}", "[", "]", ":", ",", "\"", "\\", "/", "*", "0", "1", "9", "-", "+", ".", "e", "E", " ", "\t", "\n", "\r", "t", "r", "u", "e", "f", "a", "l", "s", "n", "\xff", "\xc3\xa9", "\u2028", "x", "u", "0", "1"}
+
+var (
+	alphabetTokens = hegel.SampledFrom(alphabet)
+	// junkTokens: the pieces that damage a document most tellingly.
+	junkTokens = hegel.SampledFrom([]string{"//x\n", "/*x*/", ",", "\"", "\u2028", "\xff", "\\", "/", "*/", "\n", "//", "/*", "]", "}", " 1"})
+)
+
+// edit is one change of a text at a position taken modulo its length: a
+// byte deleted, a token inserted, or a byte replaced by a token. An empty
+// text is left alone.
+type edit struct {
+	kind string
+	at   int
+	tok  string
+}
+
+func (e edit) apply(b []byte) []byte {
+	if len(b) == 0 {
+		return b
+	}
+	pos := e.at % len(b)
+	out := append([]byte{}, b[:pos]...)
+	switch e.kind {
+	case "delete":
+		return append(out, b[pos+1:]...)
+	case "insert":
+		return append(append(out, e.tok...), b[pos:]...)
+	}
+	return append(append(out, e.tok...), b[pos+1:]...)
+}
+
+// edits: a deletion once in four, an insertion (of an alphabet or a junk
+// token) twice, a replacement once.
+var edits = weighted(
+	choice[edit]{1, hegel.Map(positions, func(p int) edit { return edit{kind: "delete", at: p} })},
+	choice[edit]{2, hegel.Map(pairs(positions, hegel.OneOf(alphabetTokens, junkTokens)), func(p pair[int, string]) edit { return edit{"insert", p.a, p.b} })},
+	choice[edit]{1, hegel.Map(pairs(positions, alphabetTokens), func(p pair[int, string]) edit { return edit{"replace", p.a, p.b} })},
+)
+
+// bytesCase: up to twelve alphabet tokens, or a document with one to three
+// edits.
+type bytesCase struct {
+	tokens []string
+	doc    *docSpec
+	edits  []edit
+}
+
+func (c bytesCase) bytes() []byte {
+	if c.doc == nil {
+		return []byte(strings.Join(c.tokens, ""))
+	}
+	b := []byte(c.doc.text())
+	for _, e := range c.edits {
+		b = e.apply(b)
+	}
+	return b
+}
+
+func (c bytesCase) GoString() string { return fmt.Sprintf("bytes %q", c.bytes()) }
+
+var bytesCases = hegel.OneOf(
+	hegel.Map(many(alphabetTokens, 0, 12), func(toks []string) bytesCase { return bytesCase{tokens: toks} }),
+	hegel.Composite(func(tc hegel.TestCase) bytesCase {
+		return bytesCase{doc: ptrTo(hegel.Draw(tc, docs)), edits: hegel.Draw(tc, many(edits, 1, 3))}
+	}),
+)
+
+// ---------------------------------------------------------------------------
+// Property 3: whitespace-and-comment bytes.
+
+var (
+	extraTokens     = hegel.SampledFrom([]string{"/", "*", " ", "\n", "\t", "\r", "x", "\xff", "\u2028", "//", "/*", "*/"})
+	extraInsertions = hegel.Map(pairs(positions, hegel.SampledFrom([]string{"/", "*/", "\xff", "\u2028", "x", "\n", "//", "/*"})), func(p pair[int, string]) edit {
+		return edit{"insert", p.a, p.b}
+	})
+)
+
+// extraCase: up to eight tokens of the extra grammar, or a drawn extra with
+// an insertion 30% of the time.
+type extraCase struct {
+	tokens []string
+	extra  *string
+	ins    *edit
+}
+
+func (c extraCase) bytes() []byte {
+	if c.extra == nil {
+		return []byte(strings.Join(c.tokens, ""))
+	}
+	b := []byte(*c.extra)
+	if c.ins != nil {
+		b = c.ins.apply(b)
+	}
+	return b
+}
+
+func (c extraCase) GoString() string { return fmt.Sprintf("extra %q", c.bytes()) }
+
+var extraCases = hegel.OneOf(
+	hegel.Map(many(extraTokens, 0, 8), func(toks []string) extraCase { return extraCase{tokens: toks} }),
+	hegel.Composite(func(tc hegel.TestCase) extraCase {
+		return extraCase{extra: ptrTo(hegel.Draw(tc, commentedGrammar.extras)), ins: hegel.Draw(tc, optional(30, extraInsertions))}
+	}),
+)
+
+// ---------------------------------------------------------------------------
+// Property 5: JSON pointers.
+
+// ptrMut is a mutation of an existing pointer: a child segment appended, the
+// leading slash dropped, a slash appended, the last segment replaced by a
+// malformed index, a leading zero before the last segment (the shape of
+// hujson/2, left out under HEGEL_NO_KNOWN=1), ~1 or ~0 unescaped, the
+// pointer doubled, or a fixed pointer instead.
+type ptrMut struct {
+	kind, tok string
+}
+
+// ptrSpec: the at-th pointer of the document (modulo their number), mutated
+// 40% of the time.
+type ptrSpec struct {
+	at  int
+	mut *ptrMut
+}
+
+// resolve is the pointer against the document's pointers.
+func (s ptrSpec) resolve(ptrs []string) string {
+	p := ptrs[s.at%len(ptrs)]
+	if s.mut == nil {
+		return p
+	}
+	switch s.mut.kind {
+	case "child":
+		return p + "/" + s.mut.tok
+	case "no-slash":
+		return strings.TrimPrefix(p, "/")
+	case "slash":
+		return p + "/"
+	case "last":
+		return strings.TrimSuffix(p, "/"+lastSeg(p)) + "/" + s.mut.tok
+	case "leading-zero":
+		return strings.TrimSuffix(p, "/"+lastSeg(p)) + "/0" + lastSeg(p)
+	case "unescape-slash":
+		return strings.ReplaceAll(p, "~1", "/")
+	case "unescape-tilde":
+		return strings.ReplaceAll(p, "~0", "~")
+	case "doubled":
+		return p + p
+	}
+	return s.mut.tok
+}
+
+var (
+	childSegs  = hegel.SampledFrom([]string{"x", "-", "0", "1", "2", "a", "", "~0", "~1"})
+	badIndexes = hegel.SampledFrom([]string{"-1", "1.0", "+1", " 1", "00", "1e0", "0x1", "18446744073709551615", "18446744073709551616", "99999999999"})
+	fixedPtrs  = hegel.SampledFrom([]string{"", "/", "//", "/-", "/~", "/~2", "a", "/a/b/c", "/0/0/0"})
+	ptrMuts    = func() hegel.Generator[*ptrMut] {
+		with := func(kind string, toks hegel.Generator[string]) hegel.Generator[ptrMut] {
+			return hegel.Map(toks, func(t string) ptrMut { return ptrMut{kind, t} })
+		}
+		plain := func(kind string) hegel.Generator[ptrMut] { return hegel.Just(ptrMut{kind: kind}) }
+		muts := []choice[ptrMut]{
+			{1, with("child", childSegs)},
+			{1, plain("no-slash")},
+			{1, plain("slash")},
+			{1, with("last", badIndexes)},
+			{1, plain("unescape-slash")},
+			{1, plain("unescape-tilde")},
+			{1, plain("doubled")},
+			{2, with("fixed", fixedPtrs)},
+		}
+		if !noKnown {
+			muts = append(muts, choice[ptrMut]{1, plain("leading-zero")})
+		}
+		return hegel.Map(weighted(muts...), ptrTo[ptrMut])
+	}()
+	ptrSpecs = hegel.Composite(func(tc hegel.TestCase) ptrSpec {
+		return ptrSpec{at: hegel.Draw(tc, positions), mut: hegel.Draw(tc, maybe(40, ptrMuts))}
+	})
+)
+
+// findCase: a document and one to four pointers into it.
+type findCase struct {
+	doc  docSpec
+	ptrs []ptrSpec
+}
+
+// pointers resolves the case's pointers against the model's document.
+func (c findCase) pointers(root *pnode) []string {
+	var ptrs []string
+	pointers(root, "", &ptrs)
+	out := make([]string, len(c.ptrs))
+	for i, s := range c.ptrs {
+		out[i] = s.resolve(ptrs)
+	}
+	return out
+}
+
+func (c findCase) GoString() string {
+	root, err := modelParse([]byte(c.doc.text()))
+	if err != nil {
+		return c.doc.GoString()
+	}
+	return fmt.Sprintf("%s pointers %q", c.doc.GoString(), c.pointers(root))
+}
+
+var findCases = hegel.Composite(func(tc hegel.TestCase) findCase {
+	return findCase{doc: hegel.Draw(tc, docs), ptrs: hegel.Draw(tc, many(ptrSpecs, 1, 4))}
+})
+
+// ---------------------------------------------------------------------------
+// Property 6: patches.
+
+// addTarget is where an add, move or copy puts its value: an existing
+// pointer (a replace or an insertion) 40% of the time, else in the at-th
+// container (modulo their number): a member of the name for an object; for
+// an array the end as "-" half of the time, as the index of the length four
+// times in ten, or beyond the end (the shape of hujson/1, left out under
+// HEGEL_NO_KNOWN=1). Without a container the existing pointer.
+type addTarget struct {
+	existing bool
+	at       int
+	name     string
+	arr      string
+	beyond   int
+}
+
+func (t addTarget) resolve(root *pnode, ptrs []string) string {
+	if t.existing {
+		return ptrs[t.at%len(ptrs)]
+	}
+	nodes, cptrs := containers(root)
+	if len(nodes) == 0 {
+		return ptrs[t.at%len(ptrs)]
+	}
+	i := t.at % len(nodes)
+	c := nodes[i]
+	switch {
+	case c.kind == '{':
+		return cptrs[i] + "/" + escapeSeg(t.name)
+	case t.arr == "dash":
+		return cptrs[i] + "/-"
+	case t.arr == "beyond":
+		return cptrs[i] + "/" + strconv.Itoa(len(c.elems)+t.beyond)
+	}
+	return cptrs[i] + "/" + strconv.Itoa(len(c.elems))
+}
+
+// containers lists the object and array nodes of a document with their
+// pointers, in preorder.
+func containers(root *pnode) (nodes []*pnode, ptrs []string) {
+	var ptrList []string
+	pointers(root, "", &ptrList)
+	for _, p := range ptrList {
+		if _, _, _, node, st := locate(root, p); st == locFound && (node.kind == '{' || node.kind == '[') {
+			nodes = append(nodes, node)
+			ptrs = append(ptrs, p)
+		}
+	}
+	return nodes, ptrs
+}
+
+// testValue says how a test operation writes its value: the target's value
+// as it is, re-encoded (a number in the form-th spelling, a string
+// re-escaped, an object with its first member swapped with the swap-th), or
+// a random value.
+type testValue struct {
+	mode string
+	form int
+	swap int
+}
+
+// glitch is a miss or a malformed encoding: the path replaced by a pointer
+// spec, the from replaced by one (or, without a from, a suffix appended to
+// the path), or the defect-th applicable defect of the encoding (modulo
+// their number), with the misspelt op it may need.
+type glitch struct {
+	kind   string
+	ptr    ptrSpec
+	suffix string
+	defect int
+	badOp  string
+}
+
+// opSpec is one operation of a patch, resolved against the live model
+// document when applied (see resolve in hegel_test.go): the op, the
+// existing pointer it works on (modulo their number), the add target, the
+// value, how a test writes its value, and a glitch 15% of the time.
+type opSpec struct {
+	op     string
+	at     int
+	target addTarget
+	value  jnode
+	test   testValue
+	glitch *glitch
+}
+
+var (
+	// opNames: add and test twice as often as the rest.
+	opNames = hegel.SampledFrom([]string{"add", "add", "remove", "replace", "move", "copy", "test", "test"})
+	// newNames: the names of added members (some collide with the pool).
+	newNames = hegel.SampledFrom([]string{"new", "a", "b", "x/y", "~", "", "\u65e5\u672c", "\t", "-", "0"})
+	// arrayEnds: how an array's end is named; beyond it one time in ten by
+	// default (hujson/1).
+	arrayEnds = hegel.SampledFrom(shaped(
+		[]string{"dash", "dash", "dash", "dash", "dash", "end", "end", "end", "end", "beyond"},
+		[]string{"dash", "dash", "dash", "dash", "dash", "end", "end", "end", "end", "end"},
+	))
+	addTargets = hegel.Composite(func(tc hegel.TestCase) addTarget {
+		return addTarget{
+			existing: hegel.Draw(tc, chance(40)),
+			at:       hegel.Draw(tc, positions),
+			name:     hegel.Draw(tc, newNames),
+			arr:      hegel.Draw(tc, arrayEnds),
+			beyond:   hegel.Draw(tc, hegel.Integers(1, 3)),
+		}
+	})
+	// testModes: the value as it is half of the time, re-encoded twice in
+	// ten, random three times in ten.
+	testModes  = hegel.SampledFrom([]string{"same", "same", "same", "same", "same", "reencoded", "reencoded", "random", "random", "random"})
+	testValues = hegel.Composite(func(tc hegel.TestCase) testValue {
+		return testValue{mode: hegel.Draw(tc, testModes), form: hegel.Draw(tc, hegel.Integers(0, 2)), swap: hegel.Draw(tc, positions)}
+	})
+	// missSuffixes: segments that name nothing; "01" (an index with a
+	// leading zero, hujson/2) is left out under HEGEL_NO_KNOWN=1.
+	missSuffixes = hegel.SampledFrom(shaped([]string{"zzz", "-", "01", "x"}, []string{"zzz", "-", "x"}))
+	badOps       = hegel.SampledFrom([]string{"ADD", "delete", "", "adds"})
+	glitches     = weighted(
+		choice[glitch]{1, hegel.Map(ptrSpecs, func(p ptrSpec) glitch { return glitch{kind: "path", ptr: p} })},
+		choice[glitch]{1, hegel.Composite(func(tc hegel.TestCase) glitch {
+			return glitch{kind: "from", ptr: hegel.Draw(tc, ptrSpecs), suffix: hegel.Draw(tc, missSuffixes)}
+		})},
+		choice[glitch]{4, hegel.Composite(func(tc hegel.TestCase) glitch {
+			return glitch{kind: "defect", defect: hegel.Draw(tc, positions), badOp: hegel.Draw(tc, badOps)}
+		})},
+	)
+	opSpecs = hegel.Composite(func(tc hegel.TestCase) opSpec {
+		return opSpec{
+			op:     hegel.Draw(tc, opNames),
+			at:     hegel.Draw(tc, positions),
+			target: hegel.Draw(tc, addTargets),
+			value:  hegel.Draw(tc, opValues),
+			test:   hegel.Draw(tc, testValues),
+			glitch: hegel.Draw(tc, optional(15, glitches)),
+		}
+	})
+)
+
+// patchStyle is what the patch document's rendering leaves free: the extras
+// of its gaps (recycled modulo their number; none: no extras) and a tape
+// for the order of each operation's members, the "extra" member one
+// operation in ten carries, and the trailing comma after the last operation
+// 30% of the time.
+type patchStyle struct {
+	extras []string
+	tape   []int
+}
+
+// encode writes the operations as a HuJSON patch document, applying the
+// defect of any operation that has one.
+func (st patchStyle) encode(ops []mop) []byte {
+	t := &tape{vals: st.tape}
+	xi := 0
+	x := func() string {
+		if len(st.extras) == 0 {
+			return ""
+		}
+		s := st.extras[xi%len(st.extras)]
+		xi++
+		return s
+	}
+	var sb strings.Builder
+	sb.WriteString(x())
+	sb.WriteByte('[')
+	for i, op := range ops {
+		if op.defect == "not-object" {
+			sb.WriteString(x() + "7")
+		} else {
+			var members []string
+			mem := func(name, val string) { members = append(members, x()+quote(name)+x()+":"+x()+val+x()) }
+			switch {
+			case op.defect == "op-not-string":
+				mem("op", "1")
+			case op.defect == "bad-op":
+				mem("op", quote(op.badOp))
+			case op.defect != "no-op":
+				mem("op", quote(op.op))
+			}
+			switch {
+			case op.defect == "path-not-string":
+				mem("path", "[]")
+			case op.defect != "no-path":
+				mem("path", quote(op.path))
+			}
+			if op.hasFrom && op.defect != "no-from" {
+				mem("from", quote(op.from))
+			}
+			if op.hasValue && op.defect != "no-value" {
+				mem("value", op.value.String())
+			}
+			if op.defect == "dup-member" {
+				mem("path", quote(op.path))
+			}
+			if t.coin(10) {
+				mem("extra", "null")
+			}
+			// The members in the order of their ranks (equal ranks, and so an
+			// empty tape, keep this order).
+			ranks := make([]int, len(members))
+			order := make([]int, len(members))
+			for j := range members {
+				ranks[j], order[j] = t.next(100), j
+			}
+			sort.SliceStable(order, func(a, b int) bool { return ranks[order[a]] < ranks[order[b]] })
+			sorted := make([]string, len(members))
+			for j, k := range order {
+				sorted[j] = members[k]
+			}
+			sb.WriteString(x() + "{" + strings.Join(sorted, ",") + x() + "}")
+		}
+		if i < len(ops)-1 || t.coin(30) {
+			sb.WriteByte(',')
+		}
+	}
+	sb.WriteString(x())
+	sb.WriteByte(']')
+	sb.WriteString(x())
+	return []byte(sb.String())
+}
+
+var patchStyles = hegel.Composite(func(tc hegel.TestCase) patchStyle {
+	return patchStyle{extras: hegel.Draw(tc, many(commentedGrammar.extras, 0, 30)), tape: hegel.Draw(tc, many(hegel.Integers(0, 99), 0, 40))}
+})
+
+// patchCase: a document, the operations of a patch (none one time in
+// twenty) and the style of the patch document.
+type patchCase struct {
+	doc   docSpec
+	ops   []opSpec
+	style patchStyle
+}
+
+func (c patchCase) GoString() string {
+	root, err := modelParse([]byte(c.doc.text()))
+	if err != nil {
+		return c.doc.GoString()
+	}
+	ops, _, _ := c.operations(&root)
+	return fmt.Sprintf("%s patch %q", c.doc.GoString(), c.style.encode(ops))
+}
+
+var patchCases = hegel.Composite(func(tc hegel.TestCase) patchCase {
+	return patchCase{
+		doc:   hegel.Draw(tc, docs),
+		ops:   hegel.Draw(tc, weighted(choice[[]opSpec]{5, hegel.Just([]opSpec(nil))}, choice[[]opSpec]{95, many(opSpecs, 1, 4)})),
+		style: hegel.Draw(tc, patchStyles),
+	}
+})
+
+// ---------------------------------------------------------------------------
+// Property 7: the Literal constructors and accessors.
+
+// litCase is one of six: a Go string for String, an int64 for Int, a uint64
+// for Uint, a float64 for Float, a bool for Bool, or a literal text (valid
+// or not) for the accessors.
+type litCase struct {
+	kind string
+	s    string
+	i    int64
+	u    uint64
+	f    float64
+	b    bool
+	lit  string
+}
+
+func (c litCase) GoString() string {
+	switch c.kind {
+	case "string":
+		return fmt.Sprintf("String(%q)", c.s)
+	case "int":
+		return fmt.Sprintf("Int(%d)", c.i)
+	case "uint":
+		return fmt.Sprintf("Uint(%d)", c.u)
+	case "float":
+		return fmt.Sprintf("Float(%v)", c.f)
+	case "bool":
+		return fmt.Sprintf("Bool(%v)", c.b)
+	}
+	return fmt.Sprintf("Literal(%q)", c.lit)
+}
+
+var (
+	controlChars = hegel.Map(hegel.Integers(0, 0x1f), func(c int) string { return string(rune(c)) })
+	// goPieces: four in seven a printable ASCII character, else a control
+	// character, a character of note (a quote, a backslash, a slash, a line
+	// separator, non-ASCII text, the replacement character) or an ASCII
+	// character that is an invalid byte three times in ten.
+	goPieces = weighted(
+		choice[string]{4, asciiChars},
+		choice[string]{1, controlChars},
+		choice[string]{1, hegel.SampledFrom([]string{"\"", "\\", "/", "\u2028", "", "\u00e9", "\u65e5\u672c", "\U0001f600", "\ufffd"})},
+		choice[string]{1, weighted(choice[string]{70, asciiChars}, choice[string]{30, hegel.Just("\xff")})},
+	)
+	goStrings = joined(many(goPieces, 0, 8))
+	// int64s: a 32-bit integer four times in five, else an edge.
+	int64s = weighted(
+		choice[int64]{80, hegel.Map(hegel.Integers(math.MinInt32, math.MaxInt32), func(n int) int64 { return int64(n) })},
+		choice[int64]{20, hegel.SampledFrom([]int64{math.MinInt64, math.MaxInt64, 0, -1, 1 << 53, -(1 << 53)})},
+	)
+	uint64s = weighted(
+		choice[uint64]{80, hegel.Map(hegel.Integers(0, math.MaxInt32), func(n int) uint64 { return uint64(n) })},
+		choice[uint64]{20, hegel.SampledFrom([]uint64{math.MaxUint64, math.MaxInt64, math.MaxInt64 + 1})},
+	)
+	// float64s: the float of random bits (the sign bit clear) seven times
+	// in ten, else a value of note (zeros of both signs, NaN, the infinities).
+	float64s = weighted(
+		choice[float64]{70, hegel.Map(hegel.Integers(0, math.MaxInt64), func(n int) float64 { return math.Float64frombits(uint64(n) << 1) })},
+		choice[float64]{30, hegel.SampledFrom([]float64{0, math.Copysign(0, -1), 1.5, -2.25, 1e21, 1e-7, math.MaxFloat64, math.SmallestNonzeroFloat64, math.NaN(), math.Inf(1), math.Inf(-1), 123456789.125})},
+	)
+	// oddLiterals: texts that are not literals, or nearly; the composites
+	// (the shape of hujson/5) are left out under HEGEL_NO_KNOWN=1.
+	oddLiterals = hegel.SampledFrom(shaped(
+		[]string{"", " 1", "1 ", "01", "nul", "True", "1e", "-", "0x1", "[1]", "{}", `{"a":1}`, "[", `"a`, "1.", "+1", ".5", "Infinity", "NaN", "\"NaN\"", "\"Infinity\"", "\"-Infinity\""},
+		[]string{"", " 1", "1 ", "01", "nul", "True", "1e", "-", "0x1", "[", `"a`, "1.", "+1", ".5", "Infinity", "NaN", "\"NaN\"", "\"Infinity\"", "\"-Infinity\""},
+	))
+	// literalTexts: a drawn literal seven times in ten, else an odd text.
+	literalTexts = weighted(choice[string]{70, literals}, choice[string]{30, oddLiterals})
+	litCases     = hegel.OneOf(
+		hegel.Map(goStrings, func(s string) litCase { return litCase{kind: "string", s: s} }),
+		hegel.Map(int64s, func(i int64) litCase { return litCase{kind: "int", i: i} }),
+		hegel.Map(uint64s, func(u uint64) litCase { return litCase{kind: "uint", u: u} }),
+		hegel.Map(float64s, func(f float64) litCase { return litCase{kind: "float", f: f} }),
+		hegel.Map(hegel.Booleans(), func(b bool) litCase { return litCase{kind: "bool", b: b} }),
+		hegel.Map(literalTexts, func(s string) litCase { return litCase{kind: "literal", lit: s} }),
+	)
+)
+
+// ---------------------------------------------------------------------------
+// Property 8: clones.
+
+// cloneCase: a document and the way its clone is edited.
+type cloneCase struct {
+	doc  docSpec
+	edit string
+}
+
+func (c cloneCase) GoString() string { return fmt.Sprintf("%s edit %s", c.doc.GoString(), c.edit) }
+
+var cloneCases = hegel.Composite(func(tc hegel.TestCase) cloneCase {
+	return cloneCase{doc: hegel.Draw(tc, docs), edit: hegel.Draw(tc, hegel.SampledFrom([]string{"format", "minimize", "standardize", "patch"}))}
+})
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..621ee20
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,162 @@
+package hujson_test
+
+// One plain test per bug in bugs.toml. Each asserts the correct behaviour and
+// fails while the bug is open; target.toml lists them as expected failures.
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/tailscale/hujson"
+)
+
+func mustParse(t *testing.T, s string) hujson.Value {
+	t.Helper()
+	v, err := hujson.Parse([]byte(s))
+	if err != nil {
+		t.Fatalf("Parse(%q): %v", s, err)
+	}
+	return v
+}
+
+func minimized(v hujson.Value) string {
+	c := v.Clone()
+	c.Minimize()
+	return string(c.Pack())
+}
+
+// hujson/1: RFC 6902 §4.1 — "The specified index MUST NOT be greater than
+// the number of elements in the array."
+func TestHegelPinAddBeyondArrayEndFails(t *testing.T) {
+	v := mustParse(t, `[10,20]`)
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"add","path":"/2","value":30}]`)); err != nil || minimized(w) != `[10,20,30]` {
+		t.Fatalf("add at index == len: err %v, result %s", err, w.Pack())
+	}
+	for _, path := range []string{"/3", "/100", "/18446744073709551615"} {
+		w := v.Clone()
+		err := w.Patch([]byte(`[{"op":"add","path":"` + path + `","value":30}]`))
+		if err == nil {
+			t.Errorf("add at %q on a 2-element array succeeded: %s", path, w.Pack())
+		}
+	}
+}
+
+// hujson/2: RFC 6901 §4 — array-index = %x30 / ( %x31-39 *(%x30-39) ):
+// no leading zeros.
+func TestHegelPinLeadingZeroIndexIsInvalid(t *testing.T) {
+	v := mustParse(t, `[10,20]`)
+	if got := v.Find("/1"); got == nil || string(got.Pack()) != "20" {
+		t.Fatalf("Find(/1) = %v", got)
+	}
+	if got := v.Find("/01"); got != nil {
+		t.Errorf("Find(/01) = %s, want nil", got.Pack())
+	}
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"add","path":"/01","value":15}]`)); err == nil {
+		t.Errorf("add at /01 succeeded: %s", w.Pack())
+	}
+	w = v.Clone()
+	if err := w.Patch([]byte(`[{"op":"remove","path":"/01"}]`)); err == nil {
+		t.Errorf("remove at /01 succeeded: %s", w.Pack())
+	}
+}
+
+// hujson/3: RFC 6902 §4.4 forbids moving a location into one of its
+// children ("from" a *proper* prefix of "path"); moving a location onto
+// itself is allowed, and §4.5 puts no restriction on "from" for copy, so
+// the root may be copied into a child.
+func TestHegelPinMoveToSelfAndCopyFromRootAreAllowed(t *testing.T) {
+	v := mustParse(t, `{"a":[1]}`)
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"move","from":"/a","path":"/a"}]`)); err != nil {
+		t.Errorf("move /a onto itself: %v", err)
+	} else if got := minimized(w); got != `{"a":[1]}` {
+		t.Errorf("move /a onto itself gave %s", got)
+	}
+	w = v.Clone()
+	if err := w.Patch([]byte(`[{"op":"copy","from":"","path":"/b"}]`)); err != nil {
+		t.Errorf("copy the root into /b: %v", err)
+	} else if got := minimized(w); got != `{"a":[1],"b":{"a":[1]}}` {
+		t.Errorf("copy the root into /b gave %s", got)
+	}
+}
+
+// hujson/4: RFC 6902 §4.3 — replace needs only that the target location
+// exist; "" (the whole document) always does, and "add" at "" is accepted.
+func TestHegelPinReplaceAtRootIsAllowed(t *testing.T) {
+	v := mustParse(t, `{"a":[1]}`)
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"add","path":"","value":7}]`)); err != nil || minimized(w) != "7" {
+		t.Fatalf("add at the root: err %v, result %s", err, w.Pack())
+	}
+	w = v.Clone()
+	if err := w.Patch([]byte(`[{"op":"replace","path":"","value":7}]`)); err != nil {
+		t.Errorf("replace at the root: %v", err)
+	} else if got := minimized(w); got != "7" {
+		t.Errorf("replace at the root gave %s", got)
+	}
+}
+
+// hujson/5: "IsValid reports whether b is a valid JSON null, boolean, string,
+// or number."
+func TestHegelPinLiteralIsValidRejectsComposites(t *testing.T) {
+	for _, s := range []string{"null", "true", "false", `"a"`, "0", "-1.5e3"} {
+		if !hujson.Literal(s).IsValid() {
+			t.Errorf("Literal(%q).IsValid() = false", s)
+		}
+	}
+	for _, s := range []string{"[]", "[1]", "{}", `{"a":1}`, `[{"a":[null]}]`} {
+		if hujson.Literal(s).IsValid() {
+			t.Errorf("Literal(%q).IsValid() = true", s)
+		}
+	}
+}
+
+// hujson/6: the convenience functions return a new buffer and say nothing
+// about the input; it must be left alone.
+func TestHegelPinStandardizeAndFormatLeaveTheInputAlone(t *testing.T) {
+	for _, src := range []string{"/*c*/ [1, /*d*/ 2,]\n", "// hello\n{\"a\": 1, // x\n \"b\": 2}\n"} {
+		for _, f := range []struct {
+			name string
+			fn   func([]byte) ([]byte, error)
+		}{{"Standardize", hujson.Standardize}, {"Minimize", hujson.Minimize}, {"Format", hujson.Format}} {
+			in := []byte(src)
+			out, err := f.fn(in)
+			if err != nil {
+				t.Fatalf("%s: %v", f.name, err)
+			}
+			if string(in) != src {
+				t.Errorf("%s(%q) returned %q and left the input as %q", f.name, src, out, in)
+			}
+		}
+	}
+}
+
+// hujson/7: "Clone returns a deep copy of the value."
+func TestHegelPinCloneKeepsTrailingCommas(t *testing.T) {
+	for _, s := range []string{"[1,]", `{"a":1,}`, "[[1,],]", "[1 ,]", "[1, ]"} {
+		v := mustParse(t, s)
+		if got := v.Clone().Pack(); !bytes.Equal(got, []byte(s)) {
+			t.Errorf("Parse(%q).Clone().Pack() = %q", s, got)
+		}
+	}
+}
+
+// hujson/8: RFC 6902 §4.6 — "test" succeeds when the target's value equals
+// the given value; two nulls are equal.
+func TestHegelPinTestAgainstNullSucceeds(t *testing.T) {
+	v := mustParse(t, `{"a":null,"b":[null]}`)
+	w := v.Clone()
+	if err := w.Patch([]byte(`[{"op":"test","path":"/b","value":[null]}]`)); err != nil {
+		t.Fatalf("test [null] against [null]: %v", err)
+	}
+	w = v.Clone()
+	if err := w.Patch([]byte(`[{"op":"test","path":"/a","value":null}]`)); err != nil {
+		t.Errorf("test null against null: %v", err)
+	}
+	w = mustParse(t, `null`)
+	if err := w.Patch([]byte(`[{"op":"test","path":"","value":null}]`)); err != nil {
+		t.Errorf("test null against a null document: %v", err)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..0933d3b
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,229 @@
+package hujson_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's
+// shape region with random contents, judged as the wide property that found
+// the bug judges (the RFC 6902 model for the patches, the RFC 6901 model for
+// Find, the literal grammar, the unchanged input, the clone's packing), so
+// that each bug has a property that finds it every run; the wide properties
+// in hegel_test.go reach the shapes at their natural rate. Under
+// HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch
+// instead (the end of the array by its index, the index without the zero, a
+// move under a child or a copy from below the root, a replace below the
+// root, a literal, a formatted standard document, a comma after a space, a
+// test of a value that is not null) and passes.
+
+import (
+	"bytes"
+	"fmt"
+	"strconv"
+	"testing"
+
+	"github.com/tailscale/hujson"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	// arrayDocs: a document whose root is an array.
+	arrayDocs = docsWith(commentedGrammar, commentedGrammar.arrays)
+	// containerDocs: a document whose root is an object or an array.
+	containerDocs = docsWith(commentedGrammar, hegel.OneOf(commentedGrammar.objects, commentedGrammar.arrays))
+	// plainPatches: a patch document without comments (no extras, the
+	// members in order).
+	plainPatches = hegel.Just(patchStyle{})
+)
+
+// hujson/1: an "add" (or a "move" or "copy") whose array index is greater
+// than the length fails (RFC 6902 section 4.1); hujson appends. Off the
+// shape: the end named by its index.
+func TestHegelAddBeyondArrayEndFails(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hegel.Composite(func(tc hegel.TestCase) patchCase {
+			return patchCase{
+				doc: hegel.Draw(tc, arrayDocs),
+				ops: []opSpec{{
+					op:     hegel.Draw(tc, hegel.SampledFrom([]string{"add", "add", "move", "copy"})),
+					at:     hegel.Draw(tc, positions),
+					target: addTarget{arr: shaped("beyond", "end"), beyond: hegel.Draw(tc, hegel.Integers(1, 3))},
+					value:  hegel.Draw(tc, opValues),
+				}},
+				style: hegel.Draw(tc, plainPatches),
+			}
+		}))
+		judgePatch(ht, c)
+	})
+}
+
+// zeroIndexCase: an array of two to six elements and the pointer to one of
+// its elements after the first, with leading zeros.
+type zeroIndexCase struct {
+	doc   docSpec
+	index int
+	zeros string
+}
+
+func (c zeroIndexCase) pointer() string { return "/" + c.zeros + strconv.Itoa(c.index) }
+
+func (c zeroIndexCase) GoString() string {
+	return fmt.Sprintf("%s pointer %q", c.doc.GoString(), c.pointer())
+}
+
+var zeroIndexCases = hegel.Composite(func(tc hegel.TestCase) zeroIndexCase {
+	g := commentedGrammar
+	elems := hegel.Draw(tc, many(g.elems, 2, 6))
+	root := jnode{kind: '[', elems: elems, inner: hegel.Draw(tc, g.extras)}
+	return zeroIndexCase{
+		doc:   docSpec{before: hegel.Draw(tc, g.extras), root: root, after: hegel.Draw(tc, g.extras)},
+		index: 1 + hegel.Draw(tc, positions)%(len(elems)-1),
+		zeros: shaped(hegel.Draw(tc, hegel.SampledFrom([]string{"0", "00"})), ""),
+	}
+})
+
+// hujson/2: an array index with a leading zero names nothing (RFC 6901
+// section 4); hujson reads "/01" as 1. Off the shape: the index itself.
+func TestHegelLeadingZeroIndexNamesNothing(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zeroIndexCases)
+		b, want := parsedDoc(ht, c.doc)
+		v, err := hujson.Parse(b)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", b, err)
+		}
+		checkFind(ht, b, &v, want, c.pointer())
+	})
+}
+
+var (
+	// movesToSelf: a move from the at-th location onto itself.
+	movesToSelf = hegel.Map(positions, func(at int) opSpec {
+		return opSpec{op: "move", at: at, target: addTarget{existing: true, at: at}}
+	})
+	// copiesFromRoot: a copy from the root (the first pointer; off the
+	// shape, from the at-th location after it) to a drawn target.
+	copiesFromRoot = hegel.Map(pairs(positions, addTargets), func(p pair[int, addTarget]) opSpec {
+		return opSpec{op: "copy", at: shaped(0, 1+p.a), target: p.b}
+	})
+	// replacesAtRoot: a replace at the root (off the shape, at the at-th
+	// location after it).
+	replacesAtRoot = hegel.Map(pairs(positions, opValues), func(p pair[int, jnode]) opSpec {
+		return opSpec{op: "replace", at: shaped(0, 1+p.a), value: p.b}
+	})
+)
+
+// onePatch: a patch of one drawn operation on a document with a container
+// root, written plainly.
+func onePatch(ops hegel.Generator[opSpec]) hegel.Generator[patchCase] {
+	return hegel.Composite(func(tc hegel.TestCase) patchCase {
+		return patchCase{doc: hegel.Draw(tc, containerDocs), ops: []opSpec{hegel.Draw(tc, ops)}, style: hegel.Draw(tc, plainPatches)}
+	})
+}
+
+// hujson/3: a "move" onto its own location and a "copy" from the root
+// succeed (RFC 6902 sections 4.4 and 4.5 allow both); hujson refuses them.
+// Off the shape: a move under a child of the location (which fails on both
+// sides, or adds a member) and a copy from a location below the root.
+func TestHegelMoveToSelfAndCopyFromRootSucceed(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		judgePatch(ht, hegel.Draw(ht, onePatch(hegel.OneOf(movesToSelf, copiesFromRoot))))
+	})
+}
+
+// hujson/4: a "replace" at the root succeeds (RFC 6902 section 4.3);
+// hujson refuses it. Off the shape: a replace below the root.
+func TestHegelReplaceAtRootSucceeds(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		judgePatch(ht, hegel.Draw(ht, onePatch(replacesAtRoot)))
+	})
+}
+
+// hujson/5: Literal.IsValid rejects an object or an array (a Literal is a
+// null, boolean, string or number); hujson accepts any valid JSON. Off the
+// shape: a literal.
+func TestHegelLiteralIsValidRejectsComposites(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		composites := hegel.Map(hegel.OneOf(plainGrammar.objects, plainGrammar.arrays), func(n jnode) string { return compactOf(n.parsed()) })
+		checkLiteralText(ht, hegel.Draw(ht, shaped(composites, literals)))
+	})
+}
+
+// hujson/6: Standardize, Minimize and Format leave the caller's input
+// alone; Standardize and Format write into it (through the aliases Parse
+// keeps). Off the shape: a formatted standard document, which all three
+// return unchanged.
+func TestHegelConvenienceFunctionsLeaveTheInputAlone(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, _ := parsedDoc(ht, hegel.Draw(ht, docs))
+		if noKnown {
+			s, err := hujson.Standardize(cp(b))
+			if err != nil {
+				fail(ht, "Standardize(%q): %v", b, err)
+			}
+			if b, err = hujson.Format(s); err != nil {
+				fail(ht, "Format(%q): %v", s, err)
+			}
+		}
+		for _, f := range []struct {
+			name string
+			fn   func([]byte) ([]byte, error)
+		}{{"Standardize", hujson.Standardize}, {"Minimize", hujson.Minimize}, {"Format", hujson.Format}} {
+			in := cp(b)
+			if _, err := f.fn(in); err != nil {
+				fail(ht, "%s(%q): %v", f.name, b, err)
+			}
+			if !bytes.Equal(in, b) {
+				mismatch(ht, shaped("hujson/6", ""), "%s(%q) overwrote its input: now %q", f.name, b, in)
+			}
+		}
+	})
+}
+
+// hujson/7: Clone keeps a trailing comma that directly follows the last
+// member or element; hujson drops it (an empty after-extra becomes nil,
+// which Pack reads as "no comma"). Off the shape: the comma after a space.
+func TestHegelCloneKeepsTrailingCommas(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hegel.Composite(func(tc hegel.TestCase) cloneCase {
+			c := hegel.Draw(tc, cloneCases)
+			c.doc.root = c.doc.root.withTrailingComma(hegel.Draw(tc, positions), shaped("", " "))
+			return c
+		}))
+		judgeClone(ht, c)
+	})
+}
+
+// nullTests: a document with one of its literals made null (off the shape:
+// a boolean or a number) and a test of that literal against itself.
+var nullTests = hegel.Composite(func(tc hegel.TestCase) patchCase {
+	doc := hegel.Draw(tc, docs)
+	lit := shaped("null", hegel.Draw(tc, hegel.SampledFrom([]string{"true", "false", "0", "1.5"})))
+	doc.root = doc.root.withLiteral(hegel.Draw(tc, positions), lit)
+	// The pointers of the model's document that name the literal; the
+	// operation's location is one of them. A literal under a duplicate
+	// member has no pointer (the first member's value is what the pointer
+	// names); then the literal is the whole document.
+	root := doc.root.parsed()
+	var ptrs []string
+	var hits []int
+	pointers(root, "", &ptrs)
+	for i, p := range ptrs {
+		if _, _, _, node, _ := locate(root, p); node != nil && node.lit == lit {
+			hits = append(hits, i)
+		}
+	}
+	if len(hits) == 0 {
+		doc.root, hits = jnode{lit: lit}, []int{0}
+	}
+	return patchCase{
+		doc:   doc,
+		ops:   []opSpec{{op: "test", at: hits[hegel.Draw(tc, positions)%len(hits)], test: testValue{mode: "same"}}},
+		style: hegel.Draw(tc, plainPatches),
+	}
+})
+
+// hujson/8: a "test" of a null against null succeeds (RFC 6902 section
+// 4.6); hujson's never does. Off the shape: a test of a boolean or a number
+// against itself.
+func TestHegelTestAgainstNullSucceeds(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		judgePatch(ht, hegel.Draw(ht, nullTests))
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..9ffec3f
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,2097 @@
+package hujson_test
+
+// Hegel property tests for github.com/tailscale/hujson.
+//
+// Oracles: a model of the JWCC grammar written here (a parser producing the
+// same syntax tree - values, whitespace-and-comment extras, trailing commas,
+// byte offsets - from which the exact Pack, Standardize and Minimize outputs
+// follow), encoding/json for the standardized output, the Format contracts
+// stated in its documentation (idempotence, standard stays standard, the
+// value and the comments are preserved, every object or array is either
+// inlined or fully expanded), RFC 6901 for Find and RFC 6902 for Patch
+// (against an ordered document model), and the documented Literal
+// constructors and accessors.
+//
+// The generators live in hegel_gen_test.go. The properties draw the shapes
+// of the recorded bugs (bugs.toml) and fail on them; HEGEL_NO_KNOWN=1 turns
+// those shapes off so that everything else can be checked. Set
+// HUJSON_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/tailscale/hujson"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	// A loaded machine (the zoo bumps several targets at once) trips Hegel's
+	// too-slow health check, which hegel-go reports without a message.
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("HUJSON_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// noKnown is HEGEL_NO_KNOWN=1: the shapes of the recorded bugs are left out
+// of the generators (and the checks that every document trips are skipped),
+// so that the properties can pass while the bugs are open. By default every
+// shape is drawn and the properties fail on the recorded bugs; target.toml
+// lists them as expected failures, the pins in hegel_pins_test.go hold the
+// regression examples.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the default form of a pool when the shapes are drawn and its
+// past form under HEGEL_NO_KNOWN=1.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// mismatch reports a failed check whose input has the shape of a recorded
+// bug (shape names it, "" if none); under HEGEL_NO_KNOWN=1 a shaped case is
+// skipped instead (for the few shapes a generator cannot keep out, such as a
+// leading-zero index made by doubling a pointer).
+func mismatch(ht *hegel.T, shape, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// Known gates the input shapes of the recorded bugs (see bugs.toml): off by
+// default, on under HEGEL_NO_KNOWN=1.
+var Known = struct {
+	addBeyondEnd       bool // hujson/1: Patch "add" with an array index greater than the length appends instead of failing
+	leadingZeroIndex   bool // hujson/2: Find and Patch accept an array index with leading zeros ("/01")
+	moveToSelfCopyRoot bool // hujson/3: Patch refuses "move" onto the same location and "copy" from the root
+	replaceRoot        bool // hujson/4: Patch refuses "replace" at the root
+	compositeLiteralOK bool // hujson/5: Literal.IsValid accepts objects and arrays
+	inputOverwritten   bool // hujson/6: Standardize and Format write into the caller's input buffer
+	cloneDropsComma    bool // hujson/7: Clone drops a trailing comma that directly follows the last value
+	testNullFails      bool // hujson/8: a Patch "test" against a JSON null never succeeds
+}{addBeyondEnd: noKnown, leadingZeroIndex: noKnown, moveToSelfCopyRoot: noKnown, replaceRoot: noKnown, compositeLiteralOK: noKnown, inputOverwritten: noKnown, cloneDropsComma: noKnown, testNullFails: noKnown}
+
+// cp copies a buffer: Parse aliases its input and the in-place methods write
+// through the aliases (hujson/6), so every Value that will be mutated is
+// parsed from a copy.
+func cp(b []byte) []byte { return append([]byte(nil), b...) }
+
+// call runs one of the convenience functions on a copy of b and checks that
+// the copy is what it was (hujson/6; under HEGEL_NO_KNOWN=1 the check is
+// off, since nearly every document with a comment or a trailing comma trips
+// it).
+func call(ht *hegel.T, name string, fn func([]byte) ([]byte, error), b []byte) ([]byte, error) {
+	in := cp(b)
+	out, err := fn(in)
+	if !Known.inputOverwritten && !bytes.Equal(in, b) {
+		mismatch(ht, "hujson/6", "%s(%q) overwrote its input: now %q", name, b, in)
+	}
+	return out, err
+}
+
+// parsedDoc renders a drawn document and parses it with the model (a
+// document the model rejects, or does not print back, is a generator bug).
+func parsedDoc(ht *hegel.T, doc docSpec) ([]byte, *pnode) {
+	text := doc.text()
+	b := []byte(text)
+	want, err := modelParse(b)
+	if err != nil {
+		fail(ht, "generator produced a document the model rejects: %q: %v", b, err)
+	}
+	if want.String() != text {
+		fail(ht, "model does not round-trip its own parse of %q: %q", text, want.String())
+	}
+	return b, want
+}
+
+// ---------------------------------------------------------------------------
+// The model: a JWCC parser producing the same syntax tree as hujson.Parse.
+
+// pnode is a parsed value with its extras and offsets. For a composite the
+// extra before the closing bracket is compAfter; the last member or element
+// keeps its own after-extra only when a trailing comma follows it (as in
+// hujson, where the parser moves it to the composite otherwise).
+type pnode struct {
+	before        string
+	start, end    int
+	kind          byte // 'n' 'f' 't' '"' '0' '{' '['
+	lit           string
+	members       []pmember
+	elems         []*pnode
+	compAfter     string
+	trailingComma bool
+	after         string
+}
+
+type pmember struct{ name, val *pnode }
+
+type modelError struct {
+	off int
+	msg string
+}
+
+func (e *modelError) Error() string { return fmt.Sprintf("offset %d: %s", e.off, e.msg) }
+
+func errAt(off int, msg string) error { return &modelError{off, msg} }
+
+type mparser struct{ b []byte }
+
+func modelParse(b []byte) (*pnode, error) {
+	p := &mparser{b}
+	v, n, err := p.value(0)
+	if err != nil {
+		return nil, err
+	}
+	if n < len(b) {
+		return nil, errAt(n, "after top-level value")
+	}
+	return v, nil
+}
+
+func isWS(c byte) bool { return c == ' ' || c == '\t' || c == '\r' || c == '\n' }
+
+// extra consumes whitespace and comments; it stops (without error) at the
+// first byte that is neither, including a lone '/'.
+func (p *mparser) extra(n int) (int, error) {
+	for n < len(p.b) {
+		c := p.b[n]
+		switch {
+		case isWS(c):
+			n++
+		case c == '/' && n+1 < len(p.b) && p.b[n+1] == '/':
+			i := bytes.IndexByte(p.b[n+2:], '\n')
+			if i < 0 {
+				return n, errAt(n, "unterminated line comment")
+			}
+			com := p.b[n : n+2+i+1]
+			if !utf8.Valid(com) {
+				return n, errAt(n, "invalid UTF-8 in comment")
+			}
+			if strings.ContainsAny(string(com), "\u2028\u2029") {
+				return n, errAt(n, "line separator in line comment")
+			}
+			n += len(com)
+		case c == '/' && n+1 < len(p.b) && p.b[n+1] == '*':
+			i := bytes.Index(p.b[n+2:], []byte("*/"))
+			if i < 0 {
+				return n, errAt(n, "unterminated block comment")
+			}
+			com := p.b[n : n+2+i+2]
+			if !utf8.Valid(com) {
+				return n, errAt(n, "invalid UTF-8 in comment")
+			}
+			n += len(com)
+		default:
+			return n, nil
+		}
+	}
+	return n, nil
+}
+
+func (p *mparser) value(n int) (*pnode, int, error) {
+	v := &pnode{}
+	n0 := n
+	var err error
+	if n, err = p.extra(n); err != nil {
+		return nil, n, err
+	}
+	v.before = string(p.b[n0:n])
+	v.start = n
+	if n, err = p.trimmed(v, n); err != nil {
+		return nil, n, err
+	}
+	v.end = n
+	n1 := n
+	if n, err = p.extra(n); err != nil {
+		return nil, n, err
+	}
+	v.after = string(p.b[n1:n])
+	return v, n, nil
+}
+
+var numberRE = regexp.MustCompile(`^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?$`)
+
+// validStringLiteral is RFC 8259 §7 with the encoding/json v1 relaxations
+// hujson inherits: invalid UTF-8 and lone surrogate escapes are accepted.
+func validStringLiteral(s string) bool {
+	if len(s) < 2 || s[0] != '"' || s[len(s)-1] != '"' {
+		return false
+	}
+	body := s[1 : len(s)-1]
+	for i := 0; i < len(body); i++ {
+		c := body[i]
+		switch {
+		case c < 0x20:
+			return false
+		case c == '"':
+			return false
+		case c == '\\':
+			i++
+			if i >= len(body) {
+				return false
+			}
+			switch body[i] {
+			case '"', '\\', '/', 'b', 'f', 'n', 'r', 't':
+			case 'u':
+				if i+4 >= len(body) {
+					return false
+				}
+				for _, h := range body[i+1 : i+5] {
+					if !strings.ContainsRune("0123456789abcdefABCDEF", rune(h)) {
+						return false
+					}
+				}
+				i += 4
+			default:
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// validLiteral is Literal.IsValid as documented: exactly one JSON null,
+// boolean, string or number, no surrounding whitespace.
+func validLiteral(s string) bool {
+	if s == "" {
+		return false
+	}
+	switch s[0] {
+	case '"':
+		return validStringLiteral(s)
+	case 'n':
+		return s == "null"
+	case 't':
+		return s == "true"
+	case 'f':
+		return s == "false"
+	default:
+		return numberRE.MatchString(s)
+	}
+}
+
+func litKind(s string) byte {
+	if s == "" {
+		return 0
+	}
+	switch c := s[0]; {
+	case c == 'n' || c == 'f' || c == 't' || c == '"':
+		return c
+	case c == '-' || ('0' <= c && c <= '9'):
+		return '0'
+	}
+	return 0
+}
+
+func (p *mparser) trimmed(v *pnode, n int) (int, error) {
+	if n == len(p.b) {
+		return n, errAt(n, "unexpected EOF")
+	}
+	switch p.b[n] {
+	case '{':
+		v.kind = '{'
+		n++
+		for {
+			n2, err := p.extra(n)
+			if err != nil {
+				return n2, err
+			}
+			if n2 < len(p.b) && p.b[n2] == '}' {
+				if len(v.members) > 0 {
+					v.trailingComma = true
+				}
+				v.compAfter = string(p.b[n:n2])
+				return n2 + 1, nil
+			}
+			name, n3, err := p.value(n)
+			if err != nil {
+				return n3, err
+			}
+			if name.kind != '"' {
+				return name.start, errAt(name.start, "object name is not a string")
+			}
+			if n3 == len(p.b) || p.b[n3] != ':' {
+				return n3, errAt(n3, "expected ':'")
+			}
+			val, n4, err := p.value(n3 + 1)
+			if err != nil {
+				return n4, err
+			}
+			v.members = append(v.members, pmember{name, val})
+			if n4 == len(p.b) {
+				return n4, errAt(n4, "unexpected EOF in object")
+			}
+			switch p.b[n4] {
+			case ',':
+				n = n4 + 1
+			case '}':
+				v.compAfter = val.after
+				val.after = ""
+				return n4 + 1, nil
+			default:
+				return n4, errAt(n4, "expected ',' or '}'")
+			}
+		}
+	case '[':
+		v.kind = '['
+		n++
+		for {
+			n2, err := p.extra(n)
+			if err != nil {
+				return n2, err
+			}
+			if n2 < len(p.b) && p.b[n2] == ']' {
+				if len(v.elems) > 0 {
+					v.trailingComma = true
+				}
+				v.compAfter = string(p.b[n:n2])
+				return n2 + 1, nil
+			}
+			el, n3, err := p.value(n)
+			if err != nil {
+				return n3, err
+			}
+			v.elems = append(v.elems, el)
+			if n3 == len(p.b) {
+				return n3, errAt(n3, "unexpected EOF in array")
+			}
+			switch p.b[n3] {
+			case ',':
+				n = n3 + 1
+			case ']':
+				v.compAfter = el.after
+				el.after = ""
+				return n3 + 1, nil
+			default:
+				return n3, errAt(n3, "expected ',' or ']'")
+			}
+		}
+	case '}', ']':
+		return n, errAt(n, "closing bracket at start of value")
+	case '"':
+		n0 := n
+		n++
+		for {
+			if n == len(p.b) {
+				return n, errAt(n, "unterminated string")
+			}
+			c := p.b[n]
+			if c == '\\' {
+				n++
+				if n == len(p.b) {
+					return n, errAt(n, "unterminated string")
+				}
+				n++
+				continue
+			}
+			n++
+			if c == '"' {
+				break
+			}
+		}
+		lit := string(p.b[n0:n])
+		if !validStringLiteral(lit) {
+			return n0, errAt(n0, "invalid string literal")
+		}
+		v.kind = '"'
+		v.lit = lit
+		return n, nil
+	default:
+		n0 := n
+		for n < len(p.b) {
+			c := p.b[n]
+			if c == '-' || c == '+' || c == '.' || ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z') || ('0' <= c && c <= '9') {
+				n++
+				continue
+			}
+			break
+		}
+		lit := string(p.b[n0:n])
+		if lit == "" {
+			return n0, errAt(n0, "invalid character at start of value")
+		}
+		if !validLiteral(lit) {
+			return n0, errAt(n0, "invalid literal")
+		}
+		v.kind = litKind(lit)
+		v.lit = lit
+		return n, nil
+	}
+}
+
+// pack is the exact source text of the tree.
+func (v *pnode) pack(sb *strings.Builder) {
+	sb.WriteString(v.before)
+	switch v.kind {
+	case '{':
+		sb.WriteByte('{')
+		for i, m := range v.members {
+			m.name.pack(sb)
+			sb.WriteByte(':')
+			m.val.pack(sb)
+			if i < len(v.members)-1 || v.trailingComma {
+				sb.WriteByte(',')
+			}
+		}
+		sb.WriteString(v.compAfter)
+		sb.WriteByte('}')
+	case '[':
+		sb.WriteByte('[')
+		for i, e := range v.elems {
+			e.pack(sb)
+			if i < len(v.elems)-1 || v.trailingComma {
+				sb.WriteByte(',')
+			}
+		}
+		sb.WriteString(v.compAfter)
+		sb.WriteByte(']')
+	default:
+		sb.WriteString(v.lit)
+	}
+	sb.WriteString(v.after)
+}
+
+// packAsCloned is the text after hujson/7: a trailing comma with nothing
+// between the last value and it is lost by Clone.
+func (v *pnode) packAsCloned() string {
+	c := v.clone()
+	var walk func(*pnode)
+	walk = func(x *pnode) {
+		if x.trailingComma && lastOf(x) != nil && lastOf(x).after == "" {
+			x.trailingComma = false
+		}
+		for _, m := range x.members {
+			walk(m.name)
+			walk(m.val)
+		}
+		for _, e := range x.elems {
+			walk(e)
+		}
+	}
+	walk(c)
+	return c.String()
+}
+
+func (v *pnode) String() string {
+	var sb strings.Builder
+	v.pack(&sb)
+	return sb.String()
+}
+
+// stdExtra is Standardize on one extra: every byte that is not JSON
+// whitespace becomes a space, so offsets and line numbers are kept.
+func stdExtra(s string) string {
+	b := []byte(s)
+	for i, c := range b {
+		if !isWS(c) {
+			b[i] = ' '
+		}
+	}
+	return string(b)
+}
+
+// std is the documented Standardize output: comments blanked, trailing commas
+// replaced by a space, everything else in place.
+func (v *pnode) std(sb *strings.Builder) {
+	sb.WriteString(stdExtra(v.before))
+	switch v.kind {
+	case '{':
+		sb.WriteByte('{')
+		for i, m := range v.members {
+			m.name.std(sb)
+			sb.WriteByte(':')
+			m.val.std(sb)
+			if i < len(v.members)-1 {
+				sb.WriteByte(',')
+			} else if v.trailingComma {
+				sb.WriteByte(' ')
+			}
+		}
+		sb.WriteString(stdExtra(v.compAfter))
+		sb.WriteByte('}')
+	case '[':
+		sb.WriteByte('[')
+		for i, e := range v.elems {
+			e.std(sb)
+			if i < len(v.elems)-1 {
+				sb.WriteByte(',')
+			} else if v.trailingComma {
+				sb.WriteByte(' ')
+			}
+		}
+		sb.WriteString(stdExtra(v.compAfter))
+		sb.WriteByte(']')
+	default:
+		sb.WriteString(v.lit)
+	}
+	sb.WriteString(stdExtra(v.after))
+}
+
+// compact is the Minimize output: no extras, no trailing commas.
+func (v *pnode) compact(sb *strings.Builder) {
+	switch v.kind {
+	case '{':
+		sb.WriteByte('{')
+		for i, m := range v.members {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			m.name.compact(sb)
+			sb.WriteByte(':')
+			m.val.compact(sb)
+		}
+		sb.WriteByte('}')
+	case '[':
+		sb.WriteByte('[')
+		for i, e := range v.elems {
+			if i > 0 {
+				sb.WriteByte(',')
+			}
+			e.compact(sb)
+		}
+		sb.WriteByte(']')
+	default:
+		sb.WriteString(v.lit)
+	}
+}
+
+func compactOf(v *pnode) string {
+	var sb strings.Builder
+	v.compact(&sb)
+	return sb.String()
+}
+
+// jsonValue is the value as encoding/json decodes it (order-insensitive
+// objects, last duplicate wins, float64 numbers).
+func jsonValue(v *pnode) (any, error) {
+	var x any
+	err := json.Unmarshal([]byte(compactOf(v)), &x)
+	return x, err
+}
+
+// preorder lists the values in hujson's All order: each value, then for an
+// object every name followed by its value, for an array every element.
+func (v *pnode) preorder(out *[]*pnode) {
+	*out = append(*out, v)
+	for _, m := range v.members {
+		m.name.preorder(out)
+		m.val.preorder(out)
+	}
+	for _, e := range v.elems {
+		e.preorder(out)
+	}
+}
+
+// isStandard: no comments anywhere and no trailing commas.
+func (v *pnode) isStandard() bool {
+	if hasComment(v.before) || hasComment(v.after) {
+		return false
+	}
+	if v.kind == '{' || v.kind == '[' {
+		if v.trailingComma || hasComment(v.compAfter) {
+			return false
+		}
+		for _, m := range v.members {
+			if !m.name.isStandard() || !m.val.isStandard() {
+				return false
+			}
+		}
+		for _, e := range v.elems {
+			if !e.isStandard() {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func hasComment(extra string) bool {
+	for i := 0; i < len(extra); i++ {
+		if !isWS(extra[i]) {
+			return true
+		}
+	}
+	return false
+}
+
+func (v *pnode) clone() *pnode {
+	c := *v
+	c.members = nil
+	c.elems = nil
+	for _, m := range v.members {
+		c.members = append(c.members, pmember{m.name.clone(), m.val.clone()})
+	}
+	for _, e := range v.elems {
+		c.elems = append(c.elems, e.clone())
+	}
+	return &c
+}
+
+func unquote(lit string) string {
+	var s string
+	if err := json.Unmarshal([]byte(lit), &s); err != nil {
+		return lit
+	}
+	return s
+}
+
+// quote is hujson.String: RFC 8785 §3.2.2.2 escaping.
+func quote(s string) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for _, r := range s {
+		switch {
+		case r == '\b':
+			sb.WriteString(`\b`)
+		case r == '\t':
+			sb.WriteString(`\t`)
+		case r == '\n':
+			sb.WriteString(`\n`)
+		case r == '\f':
+			sb.WriteString(`\f`)
+		case r == '\r':
+			sb.WriteString(`\r`)
+		case r == '\\':
+			sb.WriteString(`\\`)
+		case r == '"':
+			sb.WriteString(`\"`)
+		case r < ' ':
+			fmt.Fprintf(&sb, `\u%04x`, r)
+		default:
+			sb.WriteRune(r)
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+// ---------------------------------------------------------------------------
+// Comparing hujson's tree with the model's.
+
+func extraStr(e hujson.Extra) string { return string(e) }
+
+func compareTree(got *hujson.Value, want *pnode, path string) error {
+	if extraStr(got.BeforeExtra) != want.before {
+		return fmt.Errorf("%s: BeforeExtra %q, want %q", path, got.BeforeExtra, want.before)
+	}
+	if got.StartOffset != want.start || got.EndOffset != want.end {
+		return fmt.Errorf("%s: offsets %d..%d, want %d..%d", path, got.StartOffset, got.EndOffset, want.start, want.end)
+	}
+	if got.Value == nil {
+		return fmt.Errorf("%s: nil Value", path)
+	}
+	if byte(got.Value.Kind()) != want.kind {
+		return fmt.Errorf("%s: Kind %q, want %q", path, byte(got.Value.Kind()), want.kind)
+	}
+	switch want.kind {
+	case '{':
+		obj, ok := got.Value.(*hujson.Object)
+		if !ok {
+			return fmt.Errorf("%s: %T, want *Object", path, got.Value)
+		}
+		if len(obj.Members) != len(want.members) {
+			return fmt.Errorf("%s: %d members, want %d", path, len(obj.Members), len(want.members))
+		}
+		for i := range want.members {
+			if err := compareTree(&obj.Members[i].Name, want.members[i].name, fmt.Sprintf("%s/%d:name", path, i)); err != nil {
+				return err
+			}
+			if err := compareTree(&obj.Members[i].Value, want.members[i].val, fmt.Sprintf("%s/%d", path, i)); err != nil {
+				return err
+			}
+		}
+		if extraStr(obj.AfterExtra) != want.compAfter {
+			return fmt.Errorf("%s: object AfterExtra %q, want %q", path, obj.AfterExtra, want.compAfter)
+		}
+		if k := len(obj.Members); k > 0 {
+			last := &obj.Members[k-1].Value
+			if (last.AfterExtra != nil) != want.trailingComma {
+				return fmt.Errorf("%s: trailing comma %v (last AfterExtra %q), want %v", path, last.AfterExtra != nil, last.AfterExtra, want.trailingComma)
+			}
+		}
+	case '[':
+		arr, ok := got.Value.(*hujson.Array)
+		if !ok {
+			return fmt.Errorf("%s: %T, want *Array", path, got.Value)
+		}
+		if len(arr.Elements) != len(want.elems) {
+			return fmt.Errorf("%s: %d elements, want %d", path, len(arr.Elements), len(want.elems))
+		}
+		for i := range want.elems {
+			if err := compareTree(&arr.Elements[i], want.elems[i], fmt.Sprintf("%s/%d", path, i)); err != nil {
+				return err
+			}
+		}
+		if extraStr(arr.AfterExtra) != want.compAfter {
+			return fmt.Errorf("%s: array AfterExtra %q, want %q", path, arr.AfterExtra, want.compAfter)
+		}
+		if k := len(arr.Elements); k > 0 {
+			last := &arr.Elements[k-1]
+			if (last.AfterExtra != nil) != want.trailingComma {
+				return fmt.Errorf("%s: trailing comma %v (last AfterExtra %q), want %v", path, last.AfterExtra != nil, last.AfterExtra, want.trailingComma)
+			}
+		}
+	default:
+		lit, ok := got.Value.(hujson.Literal)
+		if !ok {
+			return fmt.Errorf("%s: %T, want Literal", path, got.Value)
+		}
+		if string(lit) != want.lit {
+			return fmt.Errorf("%s: literal %q, want %q", path, lit, want.lit)
+		}
+	}
+	// The after-extra: for the last member/element it is the part before the
+	// trailing comma (nil without one), which compareTree's caller checked
+	// through trailingComma; the content must match either way.
+	if extraStr(got.AfterExtra) != want.after {
+		return fmt.Errorf("%s: AfterExtra %q, want %q", path, got.AfterExtra, want.after)
+	}
+	return nil
+}
+
+// checkOffsets: every value's offsets cut its trimmed text out of pack.
+func checkOffsets(root *hujson.Value, pack []byte) error {
+	for v := range root.All() {
+		if v.StartOffset < 0 || v.EndOffset > len(pack) || v.StartOffset > v.EndOffset {
+			return fmt.Errorf("offsets %d..%d outside %d bytes", v.StartOffset, v.EndOffset, len(pack))
+		}
+		want := hujson.Value{Value: v.Value}.Pack()
+		if got := pack[v.StartOffset:v.EndOffset]; !bytes.Equal(got, want) {
+			return fmt.Errorf("pack[%d:%d] = %q, want %q", v.StartOffset, v.EndOffset, got, want)
+		}
+	}
+	return nil
+}
+
+// ---------------------------------------------------------------------------
+// String bodies (used by the generators).
+
+// sanitizeBody makes an arbitrary string body a valid JSON string body: raw
+// control characters and quotes are escaped, backslashes must start a valid
+// escape or are doubled.
+func sanitizeBody(s string) string {
+	var sb strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == '"':
+			sb.WriteString(`\"`)
+		case c < 0x20:
+			fmt.Fprintf(&sb, `\u%04x`, c)
+		case c == '\\':
+			if i+1 < len(s) && strings.IndexByte(`"\/bfnrt`, s[i+1]) >= 0 {
+				sb.WriteByte(c)
+				sb.WriteByte(s[i+1])
+				i++
+			} else if i+5 < len(s) && s[i+1] == 'u' && isHex4(s[i+2:i+6]) {
+				sb.WriteString(s[i : i+6])
+				i += 5
+			} else {
+				sb.WriteString(`\\`)
+			}
+		default:
+			sb.WriteByte(c)
+		}
+	}
+	return sb.String()
+}
+
+func isHex4(s string) bool {
+	if len(s) != 4 {
+		return false
+	}
+	for _, h := range s {
+		if !strings.ContainsRune("0123456789abcdefABCDEF", h) {
+			return false
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// Property 1: Parse builds the exact tree, Pack restores the input.
+
+func TestHegelParseBuildsTheExactTree(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, parseCases)
+		b, want := parsedDoc(ht, c.doc)
+		v, err := hujson.Parse(b)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", b, err)
+		}
+		if err := compareTree(&v, want, "$"); err != nil {
+			fail(ht, "tree of %q: %v", b, err)
+		}
+		if got := v.Pack(); !bytes.Equal(got, b) {
+			fail(ht, "Pack(Parse(%q)) = %q", b, got)
+		}
+		if v.String() != string(b) {
+			fail(ht, "String() %q != Pack %q", v.String(), b)
+		}
+		if err := checkOffsets(&v, b); err != nil {
+			fail(ht, "offsets after Parse of %q: %v", b, err)
+		}
+		before := fmt.Sprint(offsetsOf(&v))
+		v.UpdateOffsets()
+		if after := fmt.Sprint(offsetsOf(&v)); after != before {
+			fail(ht, "UpdateOffsets changed correct offsets of %q: %s -> %s", b, before, after)
+		}
+		if got, wantStd := v.IsStandard(), want.isStandard(); got != wantStd {
+			fail(ht, "IsStandard(%q) = %v, want %v", b, got, wantStd)
+		}
+		var order []*pnode
+		want.preorder(&order)
+		var got []int
+		for x := range v.All() {
+			got = append(got, x.StartOffset)
+		}
+		var wantOrder []int
+		for _, x := range order {
+			wantOrder = append(wantOrder, x.start)
+		}
+		if !reflect.DeepEqual(got, wantOrder) {
+			fail(ht, "All() offsets %v, want %v for %q", got, wantOrder, b)
+		}
+		// Range visits in the same order and stops when told to (at the
+		// drawn visit, or runs to the end).
+		stop := c.stop % (len(wantOrder) + 1)
+		var seen []int
+		ret := v.Range(func(x *hujson.Value) bool {
+			seen = append(seen, x.StartOffset)
+			return len(seen) < stop+1
+		})
+		if stop < len(wantOrder) {
+			if ret || !reflect.DeepEqual(seen, wantOrder[:stop+1]) {
+				fail(ht, "Range stopped at %d: returned %v, saw %v (want %v)", stop, ret, seen, wantOrder[:stop+1])
+			}
+		} else if !ret || !reflect.DeepEqual(seen, wantOrder) {
+			fail(ht, "Range to the end: returned %v, saw %v (want %v)", ret, seen, wantOrder)
+		}
+	})
+}
+
+func offsetsOf(v *hujson.Value) []int {
+	var out []int
+	for x := range v.All() {
+		out = append(out, x.StartOffset, x.EndOffset)
+	}
+	return out
+}
