+// ---------------------------------------------------------------------------
+// Property 3: Standardize and Minimize are exactly what the documentation says.
+
+func checkStandardizeAndMinimize(ht *hegel.T, b []byte, want *pnode) {
+	var sb strings.Builder
+	want.std(&sb)
+	wantStd := sb.String()
+	got, err := call(ht, "Standardize", hujson.Standardize, b)
+	if err != nil {
+		fail(ht, "Standardize(%q): %v", b, err)
+	}
+	if string(got) != wantStd {
+		fail(ht, "Standardize(%q) = %q, want %q", b, got, wantStd)
+	}
+	if !json.Valid(got) {
+		fail(ht, "Standardize(%q) = %q is not valid JSON", b, got)
+	}
+	var x, y any
+	if err := json.Unmarshal(got, &x); err != nil {
+		fail(ht, "json.Unmarshal(Standardize(%q)): %v", b, err)
+	}
+	y, _ = jsonValue(want)
+	if !reflect.DeepEqual(x, y) {
+		fail(ht, "Standardize(%q) decodes to %v, want %v", b, x, y)
+	}
+	// The in-place method: the same bytes, standard, offsets untouched.
+	v, _ := hujson.Parse(cp(b))
+	before := fmt.Sprint(offsetsOf(&v))
+	v.Standardize()
+	if p := v.Pack(); string(p) != wantStd {
+		fail(ht, "Value.Standardize of %q packs to %q, want %q", b, p, wantStd)
+	}
+	if !v.IsStandard() {
+		fail(ht, "IsStandard false after Standardize of %q", b)
+	}
+	if after := fmt.Sprint(offsetsOf(&v)); after != before {
+		fail(ht, "Standardize moved offsets of %q: %s -> %s", b, before, after)
+	}
+	if err := checkOffsets(&v, v.Pack()); err != nil {
+		fail(ht, "offsets after Standardize of %q: %v", b, err)
+	}
+	// Minimize is the compact form, and json.Compact of the standard form.
+	wantMin := compactOf(want)
+	gotMin, err := call(ht, "Minimize", hujson.Minimize, b)
+	if err != nil || string(gotMin) != wantMin {
+		fail(ht, "Minimize(%q) = %q (err %v), want %q", b, gotMin, err, wantMin)
+	}
+	var buf bytes.Buffer
+	if err := json.Compact(&buf, got); err != nil || buf.String() != wantMin {
+		fail(ht, "json.Compact(Standardize(%q)) = %q (err %v), Minimize %q", b, buf.String(), err, wantMin)
+	}
+	w, _ := hujson.Parse(cp(b))
+	w.Minimize()
+	if p := w.Pack(); string(p) != wantMin || !w.IsStandard() {
+		fail(ht, "Value.Minimize of %q packs to %q (standard %v), want %q", b, p, w.IsStandard(), wantMin)
+	}
+	if err := checkOffsets(&w, w.Pack()); err != nil {
+		fail(ht, "offsets after Minimize of %q: %v", b, err)
+	}
+}
+
+func TestHegelStandardizeKeepsOffsetsAndMinimizeIsCompact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, want := parsedDoc(ht, hegel.Draw(ht, docs))
+		checkStandardizeAndMinimize(ht, b, want)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 4: Format.
+
+// normComments lists the comments of an extra in order, each normalized the
+// way Format may legitimately change it: CR handling as in Extra.format,
+// trailing whitespace trimmed, block-comment lines trimmed and empty lines
+// dropped (Format re-indents them).
+func normComments(extra string) []string {
+	s := strings.ReplaceAll(extra, "\r\n", "\n")
+	s = strings.ReplaceAll(s, "\n\r", "\n")
+	s = strings.ReplaceAll(s, "\r", " ")
+	var out []string
+	b := []byte(s)
+	for i := 0; i < len(b); {
+		if isWS(b[i]) {
+			i++
+			continue
+		}
+		if strings.HasPrefix(s[i:], "//") {
+			j := strings.IndexByte(s[i:], '\n')
+			if j < 0 {
+				j = len(s) - i
+			}
+			out = append(out, strings.TrimRightFunc(s[i:i+j], unicode.IsSpace))
+			i += j
+			continue
+		}
+		if strings.HasPrefix(s[i:], "/*") {
+			j := strings.Index(s[i+2:], "*/")
+			if j < 0 {
+				out = append(out, "<invalid>"+s[i:])
+				return out
+			}
+			com := s[i : i+2+j+2]
+			var lines []string
+			for _, l := range strings.Split(com, "\n") {
+				l = strings.TrimSpace(l)
+				if l != "" {
+					lines = append(lines, l)
+				}
+			}
+			out = append(out, strings.Join(lines, "\n"))
+			i += len(com)
+			continue
+		}
+		out = append(out, "<invalid>"+s[i:])
+		return out
+	}
+	return out
+}
+
+// allExtras lists every extra of the tree in document order.
+func (v *pnode) allExtras(out *[]string) {
+	*out = append(*out, v.before)
+	for _, m := range v.members {
+		m.name.allExtras(out)
+		m.val.allExtras(out)
+	}
+	for _, e := range v.elems {
+		e.allExtras(out)
+	}
+	if v.kind == '{' || v.kind == '[' {
+		*out = append(*out, v.compAfter)
+	}
+	*out = append(*out, v.after)
+}
+
+func allComments(v *pnode) []string {
+	var extras []string
+	v.allExtras(&extras)
+	var out []string
+	for _, e := range extras {
+		out = append(out, normComments(e)...)
+	}
+	return out
+}
+
+// checkFormattedExtra checks the whitespace discipline of one formatted extra:
+// no carriage returns; a whitespace run without a newline is a single space
+// (several only where alignment pads an object value); a run with newlines is
+// one or two newlines followed by tabs only.
+func checkFormattedExtra(extra string, alignable bool) error {
+	if strings.IndexByte(extra, '\r') >= 0 {
+		return fmt.Errorf("carriage return in formatted extra %q", extra)
+	}
+	for i := 0; i < len(extra); {
+		if !isWS(extra[i]) {
+			// skip the comment
+			if strings.HasPrefix(extra[i:], "//") {
+				j := strings.IndexByte(extra[i:], '\n')
+				if j < 0 {
+					return fmt.Errorf("unterminated line comment in %q", extra)
+				}
+				i += j // the newline belongs to the following run
+				continue
+			}
+			j := strings.Index(extra[i+2:], "*/")
+			if j < 0 {
+				return fmt.Errorf("unterminated block comment in %q", extra)
+			}
+			i += 2 + j + 2
+			continue
+		}
+		j := i
+		for j < len(extra) && isWS(extra[j]) {
+			j++
+		}
+		run := extra[i:j]
+		if strings.IndexByte(run, '\n') < 0 {
+			if strings.Trim(run, " ") != "" {
+				return fmt.Errorf("whitespace run %q in %q is not spaces", run, extra)
+			}
+			if len(run) != 1 && !alignable {
+				return fmt.Errorf("whitespace run %q in %q is not a single space", run, extra)
+			}
+		} else {
+			nl := strings.Count(run, "\n")
+			rest := strings.TrimLeft(run, "\n")
+			if nl > 2 || strings.Trim(rest, "\t") != "" || strings.IndexByte(rest, '\n') >= 0 {
+				return fmt.Errorf("whitespace run %q in %q is not one or two newlines and tabs", run, extra)
+			}
+		}
+		i = j
+	}
+	return nil
+}
+
+func checkFormattedTree(v *pnode, alignable bool) error {
+	if err := checkFormattedExtra(v.before, alignable); err != nil {
+		return err
+	}
+	if err := checkFormattedExtra(v.after, false); err != nil {
+		return err
+	}
+	if v.kind == '{' || v.kind == '[' {
+		if err := checkFormattedExtra(v.compAfter, false); err != nil {
+			return err
+		}
+		// Inlined or fully expanded.
+		// "If any whitespace after a '{', '[', or ',' or before a '}' or ']'
+		// contains a newline, then we always expand the object or array."
+		expanded := strings.IndexByte(v.compAfter, '\n') >= 0
+		var befores []string
+		for _, m := range v.members {
+			befores = append(befores, m.name.before)
+		}
+		for _, e := range v.elems {
+			befores = append(befores, e.before)
+		}
+		for _, b := range befores {
+			if strings.IndexByte(b, '\n') >= 0 {
+				expanded = true
+			}
+		}
+		if expanded {
+			for i, b := range befores {
+				if strings.IndexByte(b, '\n') < 0 {
+					return fmt.Errorf("expanded composite %q: member %d not on its own line (before %q)", v.String(), i, b)
+				}
+			}
+			if !strings.HasSuffix(strings.TrimRight(v.compAfter, "\t"), "\n") {
+				return fmt.Errorf("expanded composite %q: closing bracket not on its own line (%q)", v.String(), v.compAfter)
+			}
+		} else {
+			last := lastOf(v)
+			surrounded := last != nil && last.after != "" && v.compAfter != ""
+			if v.trailingComma && !surrounded {
+				return fmt.Errorf("inlined composite %q has a trailing comma", v.String())
+			}
+		}
+		for _, m := range v.members {
+			if err := checkFormattedTree(m.name, false); err != nil {
+				return err
+			}
+			if err := checkFormattedTree(m.val, true); err != nil {
+				return err
+			}
+		}
+		for _, e := range v.elems {
+			if err := checkFormattedTree(e, false); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func lastOf(v *pnode) *pnode {
+	if len(v.members) > 0 {
+		return v.members[len(v.members)-1].val
+	}
+	if len(v.elems) > 0 {
+		return v.elems[len(v.elems)-1]
+	}
+	return nil
+}
+
+// expandedHaveTrailingCommas: in an expanded composite the trailing comma is
+// present exactly when the input was not standard JSON.
+func expandedHaveTrailingCommas(v *pnode, wantComma bool) error {
+	if v.kind == '{' || v.kind == '[' {
+		expanded := strings.IndexByte(v.compAfter, '\n') >= 0
+		if expanded && lastOf(v) != nil && v.trailingComma != wantComma {
+			return fmt.Errorf("expanded composite %q: trailing comma %v, want %v", v.String(), v.trailingComma, wantComma)
+		}
+		for _, m := range v.members {
+			if err := expandedHaveTrailingCommas(m.val, wantComma); err != nil {
+				return err
+			}
+		}
+		for _, e := range v.elems {
+			if err := expandedHaveTrailingCommas(e, wantComma); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func checkFormat(ht *hegel.T, b []byte, want *pnode) {
+	out, err := call(ht, "Format", hujson.Format, b)
+	if err != nil {
+		fail(ht, "Format(%q): %v", b, err)
+	}
+	f, ferr := modelParse(out)
+	if ferr != nil {
+		fail(ht, "Format(%q) = %q is not HuJSON: %v", b, out, ferr)
+	}
+	if _, err := hujson.Parse(out); err != nil {
+		fail(ht, "Parse(Format(%q) = %q): %v", b, out, err)
+	}
+	out2, err := hujson.Format(cp(out))
+	if err != nil || !bytes.Equal(out2, out) {
+		fail(ht, "Format not idempotent on %q: %q -> %q (err %v)", b, out, out2, err)
+	}
+	// One trailing newline, nothing before the value but comments.
+	if len(out) < 2 || out[len(out)-1] != '\n' || unicode.IsSpace(rune(out[len(out)-2])) {
+		fail(ht, "Format(%q) = %q does not end in exactly one newline", b, out)
+	}
+	if f.before != "" && isWS(f.before[0]) {
+		fail(ht, "Format(%q) = %q starts with whitespace", b, out)
+	}
+	for i, line := range strings.Split(strings.TrimSuffix(string(out), "\n"), "\n") {
+		if strings.TrimRightFunc(line, unicode.IsSpace) != line {
+			fail(ht, "Format(%q) = %q: line %d has trailing whitespace", b, out, i+1)
+		}
+	}
+	// The value is preserved (strings may be re-escaped).
+	x, _ := jsonValue(f)
+	y, _ := jsonValue(want)
+	if !reflect.DeepEqual(x, y) {
+		fail(ht, "Format(%q) = %q changed the value: %v -> %v", b, out, y, x)
+	}
+	// Standard stays standard; the comments survive in order.
+	if want.isStandard() && !f.isStandard() {
+		fail(ht, "Format(%q) = %q is not standard JSON any more", b, out)
+	}
+	if gc, wc := allComments(f), allComments(want); !reflect.DeepEqual(gc, wc) {
+		fail(ht, "Format(%q) = %q changed the comments: %q -> %q", b, out, wc, gc)
+	}
+	// Whitespace discipline and the inline-or-expanded rule.
+	if err := checkFormattedTree(f, false); err != nil {
+		fail(ht, "Format(%q) = %q: %v", b, out, err)
+	}
+	if err := expandedHaveTrailingCommas(f, !want.isStandard()); err != nil {
+		fail(ht, "Format(%q) = %q: %v", b, out, err)
+	}
+	// The in-place method agrees and leaves correct offsets.
+	v, _ := hujson.Parse(cp(b))
+	v.Format()
+	if p := v.Pack(); !bytes.Equal(p, out) {
+		fail(ht, "Value.Format of %q packs to %q, Format gives %q", b, p, out)
+	}
+	if err := checkOffsets(&v, v.Pack()); err != nil {
+		fail(ht, "offsets after Format of %q: %v", b, err)
+	}
+}
+
+func TestHegelFormatIsIdempotentAndFaithful(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, want := parsedDoc(ht, hegel.Draw(ht, docs))
+		checkFormat(ht, b, want)
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 5: Find follows RFC 6901.
+
+type locStatus int
+
+const (
+	locFound   locStatus = iota
+	locMissing           // the last segment names nothing (the parent exists)
+	locBad               // invalid pointer, or a middle segment names nothing
+)
+
+var indexRE = regexp.MustCompile(`^(0|[1-9][0-9]*)$`)
+
+func unescapeSeg(seg string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(seg, "~1", "/"), "~0", "~")
+}
+
+func escapeSeg(name string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(name, "~", "~0"), "/", "~1")
+}
+
+// locate resolves a JSON pointer in the model: the parent container, the
+// index in it (len for a missing member or "-"), the member name for objects,
+// the node, and the status.
+func locate(root *pnode, ptr string) (parent *pnode, idx int, name string, node *pnode, st locStatus) {
+	cur := root
+	if ptr == "" {
+		return nil, -1, "", root, locFound
+	}
+	if ptr[0] != '/' {
+		return nil, -1, "", nil, locBad
+	}
+	segs := strings.Split(ptr[1:], "/")
+	for i, seg := range segs {
+		last := i == len(segs)-1
+		nm := unescapeSeg(seg)
+		switch cur.kind {
+		case '{':
+			found := -1
+			for j, m := range cur.members {
+				if unquote(m.name.lit) == nm {
+					found = j
+					break
+				}
+			}
+			if found < 0 {
+				if last {
+					return cur, len(cur.members), nm, nil, locMissing
+				}
+				return nil, -1, "", nil, locBad
+			}
+			parent, idx, name, node = cur, found, nm, cur.members[found].val
+			cur = node
+		case '[':
+			if seg == "-" {
+				if last {
+					return cur, len(cur.elems), "", nil, locMissing
+				}
+				return nil, -1, "", nil, locBad
+			}
+			if !indexRE.MatchString(seg) {
+				return nil, -1, "", nil, locBad
+			}
+			k, err := strconv.ParseUint(seg, 10, 64)
+			if err != nil {
+				return nil, -1, "", nil, locBad
+			}
+			if k >= uint64(len(cur.elems)) {
+				if last {
+					return cur, int(min(k, 1<<31)), "", nil, locMissing
+				}
+				return nil, -1, "", nil, locBad
+			}
+			parent, idx, name, node = cur, int(k), "", cur.elems[k]
+			cur = node
+		default:
+			return nil, -1, "", nil, locBad
+		}
+	}
+	return parent, idx, name, node, locFound
+}
+
+// pointers lists a pointer to every node (duplicates included: the pointer of
+// a later duplicate member resolves to the first, which locate handles).
+func pointers(v *pnode, prefix string, out *[]string) {
+	*out = append(*out, prefix)
+	for _, m := range v.members {
+		pointers(m.val, prefix+"/"+escapeSeg(unquote(m.name.lit)), out)
+	}
+	for i, e := range v.elems {
+		pointers(e, prefix+"/"+strconv.Itoa(i), out)
+	}
+}
+
+func lastSeg(p string) string {
+	if i := strings.LastIndexByte(p, '/'); i >= 0 {
+		return p[i+1:]
+	}
+	return p
+}
+
+// leadingZeroRE matches a pointer segment that is an index with a leading
+// zero, which hujson accepts (hujson/2) and RFC 6901 does not.
+var leadingZeroRE = regexp.MustCompile(`/0[0-9]+(/|$)`)
+
+func TestHegelFindFollowsRFC6901(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, findCases)
+		b, want := parsedDoc(ht, c.doc)
+		v, err := hujson.Parse(b)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", b, err)
+		}
+		for _, ptr := range c.pointers(want) {
+			checkFind(ht, b, &v, want, ptr)
+		}
+	})
+}
+
+// checkFind checks Find of one pointer against the model's locate.
+func checkFind(ht *hegel.T, b []byte, v *hujson.Value, want *pnode, ptr string) {
+	shape := ""
+	if leadingZeroRE.MatchString(ptr) {
+		shape = "hujson/2"
+	}
+	_, _, _, node, st := locate(want, ptr)
+	got := v.Find(ptr)
+	switch {
+	case st == locFound && got == nil:
+		mismatch(ht, shape, "Find(%q) in %q = nil, want the value at offset %d", ptr, b, node.start)
+	case st == locFound && got.StartOffset != node.start:
+		mismatch(ht, shape, "Find(%q) in %q = value at offset %d (%q), want offset %d (%q)", ptr, b, got.StartOffset, got.Pack(), node.start, node.String())
+	case st != locFound && got != nil:
+		mismatch(ht, shape, "Find(%q) in %q = %q at offset %d, want nil", ptr, b, got.Pack(), got.StartOffset)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Property 6: Patch follows RFC 6902.
+
+// mop is one operation as the model applies it and the encoder writes it.
+type mop struct {
+	op, path, from string
+	hasFrom        bool
+	value          *pnode
+	hasValue       bool
+	defect         string // "" or the way the operation's encoding is malformed
+	badOp          string // the misspelt op of the "bad-op" defect
+}
+
+// applyModel applies one operation to the model document; an error means the
+// patch must fail.
+func applyModel(root **pnode, op mop) error {
+	add := func(path string, val *pnode) error {
+		if path == "" {
+			*root = val
+			return nil
+		}
+		parent, idx, name, _, st := locate(*root, path)
+		switch st {
+		case locBad:
+			return fmt.Errorf("bad path %q", path)
+		case locMissing:
+			if parent.kind == '{' {
+				parent.members = append(parent.members, pmember{&pnode{kind: '"', lit: quote(name)}, val})
+				return nil
+			}
+			if idx > len(parent.elems) {
+				return fmt.Errorf("index %d beyond the end of %d elements", idx, len(parent.elems))
+			}
+			parent.elems = append(parent.elems, val)
+			return nil
+		default:
+			if parent.kind == '{' {
+				parent.members[idx].val = val
+				return nil
+			}
+			parent.elems = append(parent.elems[:idx], append([]*pnode{val}, parent.elems[idx:]...)...)
+			return nil
+		}
+	}
+	remove := func(path string) (*pnode, error) {
+		parent, idx, _, node, st := locate(*root, path)
+		if st != locFound {
+			return nil, fmt.Errorf("%q does not exist", path)
+		}
+		if parent == nil {
+			return nil, fmt.Errorf("cannot remove the root")
+		}
+		if parent.kind == '{' {
+			parent.members = append(parent.members[:idx], parent.members[idx+1:]...)
+		} else {
+			parent.elems = append(parent.elems[:idx], parent.elems[idx+1:]...)
+		}
+		return node, nil
+	}
+	switch op.op {
+	case "add":
+		return add(op.path, op.value.clone())
+	case "remove":
+		_, err := remove(op.path)
+		return err
+	case "replace":
+		parent, idx, _, _, st := locate(*root, op.path)
+		if st != locFound {
+			return fmt.Errorf("%q does not exist", op.path)
+		}
+		if parent == nil {
+			*root = op.value.clone()
+			return nil
+		}
+		if parent.kind == '{' {
+			parent.members[idx].val = op.value.clone()
+		} else {
+			parent.elems[idx] = op.value.clone()
+		}
+		return nil
+	case "move":
+		if op.from != op.path && strings.HasPrefix(op.path, op.from) && (op.from == "" || op.path[len(op.from)] == '/') {
+			return fmt.Errorf("cannot move %q into its child %q", op.from, op.path)
+		}
+		node, err := remove(op.from)
+		if err != nil {
+			return err
+		}
+		return add(op.path, node)
+	case "copy":
+		_, _, _, node, st := locate(*root, op.from)
+		if st != locFound {
+			return fmt.Errorf("%q does not exist", op.from)
+		}
+		return add(op.path, node.clone())
+	case "test":
+		_, _, _, node, st := locate(*root, op.path)
+		if st != locFound {
+			return fmt.Errorf("%q does not exist", op.path)
+		}
+		x, errx := jsonValue(node)
+		y, erry := jsonValue(op.value)
+		if errx != nil || erry != nil || !reflect.DeepEqual(x, y) {
+			return fmt.Errorf("test failed at %q", op.path)
+		}
+		return nil
+	}
+	return fmt.Errorf("unknown op %q", op.op)
+}
+
+// valueFor is the value a test operation compares with node (the target's
+// value, or nothing if the pointer named nothing): the node itself, the node
+// re-encoded, or the random value.
+func (t testValue) valueFor(node *pnode, random jnode) *pnode {
+	if node == nil || t.mode == "random" {
+		return random.parsed()
+	}
+	c := node.clone()
+	if t.mode == "same" {
+		return c
+	}
+	// Re-encoded: a number as one of three spellings, a string re-escaped,
+	// an object with its first member swapped with another; the JSON value
+	// is unchanged.
+	switch c.kind {
+	case '0':
+		if f, err := strconv.ParseFloat(c.lit, 64); err == nil && !math.IsInf(f, 0) {
+			c.lit = []string{strconv.FormatFloat(f, 'g', -1, 64), strconv.FormatFloat(f, 'e', -1, 64), c.lit}[t.form]
+			if strings.ContainsAny(c.lit, "+Ii") || !numberRE.MatchString(c.lit) {
+				c.lit = node.lit
+			}
+		}
+	case '"':
+		c.lit = quote(unquote(c.lit))
+		if unquote(c.lit) != unquote(node.lit) {
+			c.lit = node.lit
+		}
+	case '{':
+		if len(c.members) > 1 {
+			i := t.swap % len(c.members)
+			c.members[0], c.members[i] = c.members[i], c.members[0]
+		}
+	}
+	return c
+}
+
+// resolve turns a drawn operation into one against the live model document
+// (the pointers are taken modulo what exists), and names the shape of the
+// recorded bug it has, if any. Under HEGEL_NO_KNOWN=1 the shapes are steered
+// off instead, as the property once did: an index beyond the end becomes
+// "-", a move onto itself moves under "/x", a copy from the root copies from
+// "/nothing", a replace at the root replaces another location, a test of
+// null against null tests true.
+func (s opSpec) resolve(root *pnode) (op mop, shape string) {
+	var ptrs []string
+	pointers(root, "", &ptrs)
+	existing := ptrs[s.at%len(ptrs)]
+	op.op = s.op
+	switch s.op {
+	case "add":
+		op.path, op.value, op.hasValue = s.target.resolve(root, ptrs), s.value.parsed(), true
+	case "remove":
+		op.path = existing
+		if op.path == "" {
+			op.path = "/nothing"
+		}
+	case "replace":
+		op.path, op.value, op.hasValue = existing, s.value.parsed(), true
+	case "move", "copy":
+		op.from, op.hasFrom = existing, true
+		op.path = s.target.resolve(root, ptrs)
+	case "test":
+		op.path = existing
+		_, _, _, node, _ := locate(root, op.path)
+		op.value, op.hasValue = s.test.valueFor(node, s.value), true
+	}
+	// Occasional misses and malformed encodings.
+	if g := s.glitch; g != nil {
+		switch g.kind {
+		case "path":
+			op.path = g.ptr.resolve(ptrs)
+		case "from":
+			if op.hasFrom {
+				op.from = g.ptr.resolve(ptrs)
+			} else {
+				op.path += "/" + g.suffix
+			}
+		default:
+			defects := []string{"no-op", "no-path", "bad-op", "op-not-string", "path-not-string", "dup-member", "not-object"}
+			if op.hasFrom {
+				defects = append(defects, "no-from")
+			}
+			if op.hasValue {
+				defects = append(defects, "no-value")
+			}
+			op.defect, op.badOp = defects[g.defect%len(defects)], g.badOp
+		}
+	}
+	if op.defect != "" {
+		return op, "" // malformed: fails either way
+	}
+	// beyond: the path is an array index greater than the length (for a
+	// move, of the document after the removal: a move within an array to
+	// the index of its length is beyond the end too).
+	beyond := func() bool {
+		if op.op != "add" && op.op != "move" && op.op != "copy" {
+			return false
+		}
+		doc := root
+		if op.op == "move" {
+			doc = root.clone()
+			if applyModel(&doc, mop{op: "remove", path: op.from}) != nil {
+				return false
+			}
+		}
+		parent, idx, _, _, st := locate(doc, op.path)
+		return st == locMissing && parent.kind == '[' && idx > len(parent.elems)
+	}
+	testsNull := func() bool {
+		_, _, _, node, _ := locate(root, op.path)
+		return op.op == "test" && node != nil && node.kind == 'n' && op.value.kind == 'n'
+	}
+	if Known.replaceRoot && op.op == "replace" && op.path == "" {
+		op.path = ptrs[(s.at+1)%len(ptrs)]
+		if op.path == "" {
+			op.path = "/nothing"
+		}
+	}
+	if Known.moveToSelfCopyRoot && op.op == "move" && op.from == op.path {
+		op.path += "/x"
+	}
+	if Known.moveToSelfCopyRoot && op.op == "copy" && op.from == "" {
+		op.from = "/nothing"
+	}
+	if Known.testNullFails && testsNull() {
+		op.value = &pnode{kind: 't', lit: "true"} // differs: fails either way
+	}
+	if Known.addBeyondEnd && beyond() {
+		op.path = op.path[:strings.LastIndexByte(op.path, '/')] + "/-"
+	}
+	switch {
+	case beyond():
+		shape = "hujson/1"
+	case op.op == "move" && op.from == op.path, op.op == "copy" && op.from == "":
+		shape = "hujson/3"
+	case op.op == "replace" && op.path == "":
+		shape = "hujson/4"
+	case testsNull():
+		shape = "hujson/8"
+	case leadingZeroRE.MatchString(op.path), op.hasFrom && leadingZeroRE.MatchString(op.from):
+		shape = "hujson/2"
+	}
+	return op, shape
+}
+
+// operations resolves the case's operations in order against the model
+// document, applying each to it as the patch would (after a malformed or
+// failing operation the rest are resolved but not applied); it returns the
+// operations, the model's verdict and the shape of the recorded bug the
+// patch has, if any.
+func (c patchCase) operations(model **pnode) (ops []mop, modelErr error, shape string) {
+	for i, s := range c.ops {
+		op, sh := s.resolve(*model)
+		ops = append(ops, op)
+		if modelErr == nil && shape == "" {
+			shape = sh
+		}
+		if op.defect != "" {
+			modelErr = fmt.Errorf("operation %d malformed: %s", i, op.defect)
+			break
+		}
+		if modelErr == nil {
+			if e := applyModel(model, op); e != nil {
+				modelErr = fmt.Errorf("operation %d: %v", i, e)
+			}
+		}
+	}
+	return ops, modelErr, shape
+}
+
+func TestHegelPatchFollowsRFC6902(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		judgePatch(ht, hegel.Draw(ht, patchCases))
+	})
+}
+
+// judgePatch judges one patch case against the model: the same verdict,
+// the original untouched, the result well-formed with the model's value,
+// and Format of the result keeping it.
+func judgePatch(ht *hegel.T, c patchCase) {
+	b, want := parsedDoc(ht, c.doc)
+	v, err := hujson.Parse(b)
+	if err != nil {
+		fail(ht, "Parse(%q): %v", b, err)
+	}
+	model := want.clone()
+	ops, modelErr, shape := c.operations(&model)
+	patch := c.style.encode(ops)
+	if _, err := hujson.Parse(patch); err != nil {
+		fail(ht, "generator produced an unparsable patch %q: %v", patch, err)
+	}
+	w := v.Clone()
+	perr := w.Patch(patch)
+	if (perr != nil) != (modelErr != nil) {
+		mismatch(ht, shape, "Patch(%q) on %q: err=%v, model err=%v", patch, b, perr, modelErr)
+	}
+	if p := v.Pack(); !bytes.Equal(p, b) {
+		fail(ht, "Patch mutated the original through Clone: %q -> %q", b, p)
+	}
+	if perr != nil {
+		return // the verdict of a failing patch
+	}
+	out := w.Pack()
+	if _, err := hujson.Parse(out); err != nil {
+		fail(ht, "Patch(%q) on %q packs to %q, which does not parse: %v", patch, b, out, err)
+	}
+	if err := checkOffsets(&w, out); err != nil {
+		w.UpdateOffsets()
+		if err2 := checkOffsets(&w, w.Pack()); err2 != nil {
+			fail(ht, "offsets after Patch and UpdateOffsets of %q: %v", out, err2)
+		}
+	}
+	m := w.Clone()
+	m.Minimize()
+	if got, wantMin := string(m.Pack()), compactOf(model); got != wantMin {
+		mismatch(ht, shape, "Patch(%q) on %q = %q, minimized %q, want %q", patch, b, out, got, wantMin)
+	}
+	f := w.Clone()
+	f.Format()
+	fp := f.Pack()
+	if _, err := hujson.Parse(fp); err != nil {
+		fail(ht, "Format after Patch(%q) on %q gives %q, which does not parse: %v", patch, b, fp, err)
+	}
+	fm, _ := modelParse(fp)
+	x, _ := jsonValue(fm)
+	y, _ := jsonValue(model)
+	if !reflect.DeepEqual(x, y) {
+		mismatch(ht, shape, "Format after Patch(%q) on %q changed the value: %q, want %q", patch, b, fp, compactOf(model))
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Property 7: Literal constructors and accessors.
+
+func TestHegelLiteralConstructorsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, litCases)
+		switch c.kind {
+		case "string":
+			s := c.s
+			lit := hujson.String(s)
+			note(ht, "String(%q) = %s", s, lit)
+			if !lit.IsValid() || lit.Kind() != '"' {
+				fail(ht, "String(%q) = %q: IsValid %v Kind %q", s, lit, lit.IsValid(), byte(lit.Kind()))
+			}
+			want := string([]rune(s)) // invalid bytes become U+FFFD, as documented
+			if got := lit.String(); got != want {
+				fail(ht, "String(%q).String() = %q, want %q", s, got, want)
+			}
+			var back string
+			if err := json.Unmarshal(lit, &back); err != nil || back != want {
+				fail(ht, "json.Unmarshal(String(%q) = %q) = %q, %v", s, lit, back, err)
+			}
+			if utf8.ValidString(s) && string(lit) != quote(s) {
+				fail(ht, "String(%q) = %q, RFC 8785 gives %q", s, lit, quote(s))
+			}
+			if _, err := hujson.Parse(lit); err != nil {
+				fail(ht, "Parse(String(%q) = %q): %v", s, lit, err)
+			}
+		case "int":
+			i := c.i
+			lit := hujson.Int(i)
+			if !lit.IsValid() || lit.Kind() != '0' || lit.Int() != i || string(lit) != strconv.FormatInt(i, 10) {
+				fail(ht, "Int(%d) = %q: IsValid %v Kind %q Int %d", i, lit, lit.IsValid(), byte(lit.Kind()), lit.Int())
+			}
+			if i >= 0 && lit.Uint() != uint64(i) {
+				fail(ht, "Int(%d).Uint() = %d", i, lit.Uint())
+			}
+			if i < 0 && lit.Uint() != 0 {
+				fail(ht, "Int(%d).Uint() = %d, want 0", i, lit.Uint())
+			}
+		case "uint":
+			u := c.u
+			lit := hujson.Uint(u)
+			if !lit.IsValid() || lit.Kind() != '0' || lit.Uint() != u || string(lit) != strconv.FormatUint(u, 10) {
+				fail(ht, "Uint(%d) = %q: IsValid %v Uint %d", u, lit, lit.IsValid(), lit.Uint())
+			}
+			if u > math.MaxInt64 && lit.Int() != 0 {
+				fail(ht, "Uint(%d).Int() = %d, want 0", u, lit.Int())
+			}
+		case "float":
+			f := c.f
+			lit := hujson.Float(f)
+			note(ht, "Float(%v) = %s", f, lit)
+			switch {
+			case math.IsNaN(f):
+				if string(lit) != `"NaN"` || !math.IsNaN(lit.Float()) {
+					fail(ht, "Float(NaN) = %q, Float() %v", lit, lit.Float())
+				}
+			case math.IsInf(f, 0):
+				want := `"Infinity"`
+				if f < 0 {
+					want = `"-Infinity"`
+				}
+				if string(lit) != want || lit.Float() != f {
+					fail(ht, "Float(%v) = %q, Float() %v", f, lit, lit.Float())
+				}
+			default:
+				if !lit.IsValid() || lit.Kind() != '0' {
+					fail(ht, "Float(%v) = %q: IsValid %v Kind %q", f, lit, lit.IsValid(), byte(lit.Kind()))
+				}
+				if got := lit.Float(); got != f || math.Signbit(got) != math.Signbit(f) {
+					fail(ht, "Float(%v) = %q, Float() %v", f, lit, got)
+				}
+				wantText, _ := json.Marshal(f)
+				if string(lit) != string(wantText) {
+					fail(ht, "Float(%v) = %q, json.Marshal %q", f, lit, wantText)
+				}
+			}
+		case "bool":
+			b := c.b
+			lit := hujson.Bool(b)
+			if !lit.IsValid() || lit.Bool() != b || lit.Kind() != hujson.Kind(map[bool]byte{true: 't', false: 'f'}[b]) {
+				fail(ht, "Bool(%v) = %q", b, lit)
+			}
+		default:
+			checkLiteralText(ht, c.lit)
+		}
+	})
+}
+
+// checkLiteralText checks the accessors on a literal text, valid or not.
+func checkLiteralText(ht *hegel.T, s string) {
+	lit := hujson.Literal(s)
+	want := validLiteral(s)
+	shape := ""
+	if s != "" && (s[0] == '[' || s[0] == '{') && json.Valid([]byte(s)) {
+		shape = "hujson/5" // a composite IsValid says yes to
+	}
+	if got := lit.IsValid(); got != want {
+		mismatch(ht, shape, "Literal(%q).IsValid() = %v, want %v", s, got, want)
+	}
+	if got := byte(lit.Kind()); got != litKind(s) {
+		fail(ht, "Literal(%q).Kind() = %q, want %q", s, got, litKind(s))
+	}
+	if lit.Bool() != (s == "true") {
+		fail(ht, "Literal(%q).Bool() = %v", s, lit.Bool())
+	}
+	if !validLiteral(s) {
+		// The accessors are documented for JSON literals only; on
+		// invalid text they follow encoding/json ("1 " reads as 1).
+		_, _, _, _ = lit.String(), lit.Int(), lit.Uint(), lit.Float()
+		return // the verdict of an invalid literal
+	}
+	if litKind(s) == '"' {
+		if got := lit.String(); got != unquote(s) {
+			fail(ht, "Literal(%q).String() = %q, want %q", s, got, unquote(s))
+		}
+	} else if got := lit.String(); got != s {
+		fail(ht, "Literal(%q).String() = %q, want the raw text", s, got)
+	}
+	// Int and Uint are documented to return 0 for a number that is not a
+	// (signed, unsigned) integer, which includes one out of range.
+	var wantInt int64
+	if n, err := strconv.ParseInt(s, 10, 64); litKind(s) == '0' && err == nil {
+		wantInt = n
+	}
+	if got := lit.Int(); got != wantInt {
+		fail(ht, "Literal(%q).Int() = %d, want %d", s, got, wantInt)
+	}
+	var wantUint uint64
+	if n, err := strconv.ParseUint(s, 10, 64); litKind(s) == '0' && err == nil {
+		wantUint = n
+	}
+	if got := lit.Uint(); got != wantUint {
+		fail(ht, "Literal(%q).Uint() = %d, want %d", s, got, wantUint)
+	}
+	var wantF float64
+	switch {
+	case litKind(s) == '0' && validLiteral(s):
+		if f, err := strconv.ParseFloat(s, 64); err == nil {
+			wantF = f
+		}
+	case s == `"NaN"`:
+		wantF = math.NaN()
+	case s == `"Infinity"`:
+		wantF = math.Inf(1)
+	case s == `"-Infinity"`:
+		wantF = math.Inf(-1)
+	}
+	if got := lit.Float(); !(got == wantF || (math.IsNaN(got) && math.IsNaN(wantF))) || math.Signbit(got) != math.Signbit(wantF) {
+		fail(ht, "Literal(%q).Float() = %v, want %v", s, got, wantF)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Property 8: Clone is deep.
+
+func TestHegelCloneIsDeep(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		judgeClone(ht, hegel.Draw(ht, cloneCases))
+	})
+}
+
+// judgeClone judges one clone case: the clone packs to the input with the
+// same offsets, mutating it leaves the original alone, and it does not alias
+// the parsed input.
+func judgeClone(ht *hegel.T, c cloneCase) {
+	b, want := parsedDoc(ht, c.doc)
+	v, err := hujson.Parse(b)
+	if err != nil {
+		fail(ht, "Parse(%q): %v", b, err)
+	}
+	cl := v.Clone()
+	// The clone packs to the input; a trailing comma directly after the
+	// last value is what Clone drops (hujson/7).
+	wantPack, shape := string(b), ""
+	if want.packAsCloned() != string(b) {
+		shape = "hujson/7"
+	}
+	if Known.cloneDropsComma {
+		wantPack = want.packAsCloned()
+	}
+	if string(cl.Pack()) != wantPack || fmt.Sprint(offsetsOf(&cl)) != fmt.Sprint(offsetsOf(&v)) {
+		mismatch(ht, shape, "Clone of %q packs to %q, want %q", b, cl.Pack(), wantPack)
+	}
+	// Mutate the clone the drawn way; the original must not move.
+	switch c.edit {
+	case "format":
+		cl.Format()
+	case "minimize":
+		cl.Minimize()
+	case "standardize":
+		cl.Standardize()
+	default:
+		_ = cl.Patch([]byte(`[{"op":"add","path":"","value":{"x":[1,2,3]}}]`))
+	}
+	// Also scribble on the clone's byte slices.
+	for x := range cl.All() {
+		for i := range x.BeforeExtra {
+			x.BeforeExtra[i] = ' '
+		}
+		for i := range x.AfterExtra {
+			x.AfterExtra[i] = ' '
+		}
+		if lit, ok := x.Value.(hujson.Literal); ok && len(lit) > 0 {
+			lit[0] = 'Z'
+		}
+	}
+	if p := v.Pack(); !bytes.Equal(p, b) {
+		fail(ht, "mutating a Clone changed the original: %q -> %q", b, p)
+	}
+	// And the other way round: Parse aliases the input, Clone must not.
+	orig := cp(b)
+	d := v.Clone()
+	for i := range b {
+		b[i] = '#'
+	}
+	if p := d.Pack(); string(p) != wantPack {
+		mismatch(ht, shape, "Clone aliases the parsed input: %q after scribbling on the input (was %q)", p, orig)
+	}
+}
