+// ---------------------------------------------------------------------------
+// Property 6: Patch follows RFC 6902.
+
+type mop struct {
+	op, path, from string
+	hasFrom        bool
+	value          *pnode
+	hasValue       bool
+	defect         string // "" or the way the operation's encoding is malformed
+}
+
+// applyModel applies one operation to the model document; an error means the
+// patch must fail.
+func applyModel(root **pnode, op mop) error {
+	add := func(path string, val *pnode) error {
+		if path == "" {
+			*root = val
+			return nil
+		}
+		parent, idx, name, _, st := locate(*root, path)
+		switch st {
+		case locBad:
+			return fmt.Errorf("bad path %q", path)
+		case locMissing:
+			if parent.kind == '{' {
+				parent.members = append(parent.members, pmember{&pnode{kind: '"', lit: quote(name)}, val})
+				return nil
+			}
+			if idx > len(parent.elems) {
+				return fmt.Errorf("index %d beyond the end of %d elements", idx, len(parent.elems))
+			}
+			parent.elems = append(parent.elems, val)
+			return nil
+		default:
+			if parent.kind == '{' {
+				parent.members[idx].val = val
+				return nil
+			}
+			parent.elems = append(parent.elems[:idx], append([]*pnode{val}, parent.elems[idx:]...)...)
+			return nil
+		}
+	}
+	remove := func(path string) (*pnode, error) {
+		parent, idx, _, node, st := locate(*root, path)
+		if st != locFound {
+			return nil, fmt.Errorf("%q does not exist", path)
+		}
+		if parent == nil {
+			return nil, fmt.Errorf("cannot remove the root")
+		}
+		if parent.kind == '{' {
+			parent.members = append(parent.members[:idx], parent.members[idx+1:]...)
+		} else {
+			parent.elems = append(parent.elems[:idx], parent.elems[idx+1:]...)
+		}
+		return node, nil
+	}
+	switch op.op {
+	case "add":
+		return add(op.path, op.value.clone())
+	case "remove":
+		_, err := remove(op.path)
+		return err
+	case "replace":
+		parent, idx, _, _, st := locate(*root, op.path)
+		if st != locFound {
+			return fmt.Errorf("%q does not exist", op.path)
+		}
+		if parent == nil {
+			*root = op.value.clone()
+			return nil
+		}
+		if parent.kind == '{' {
+			parent.members[idx].val = op.value.clone()
+		} else {
+			parent.elems[idx] = op.value.clone()
+		}
+		return nil
+	case "move":
+		if op.from != op.path && strings.HasPrefix(op.path, op.from) && (op.from == "" || op.path[len(op.from)] == '/') {
+			return fmt.Errorf("cannot move %q into its child %q", op.from, op.path)
+		}
+		node, err := remove(op.from)
+		if err != nil {
+			return err
+		}
+		return add(op.path, node)
+	case "copy":
+		_, _, _, node, st := locate(*root, op.from)
+		if st != locFound {
+			return fmt.Errorf("%q does not exist", op.from)
+		}
+		return add(op.path, node.clone())
+	case "test":
+		_, _, _, node, st := locate(*root, op.path)
+		if st != locFound {
+			return fmt.Errorf("%q does not exist", op.path)
+		}
+		x, errx := jsonValue(node)
+		y, erry := jsonValue(op.value)
+		if errx != nil || erry != nil || !reflect.DeepEqual(x, y) {
+			return fmt.Errorf("test failed at %q", op.path)
+		}
+		return nil
+	}
+	return fmt.Errorf("unknown op %q", op.op)
+}
+
+// genOp draws an operation against the current model state, mostly valid.
+func genOp(tc hegel.TestCase, root *pnode) mop {
+	var ptrs []string
+	pointers(root, "", &ptrs)
+	existing := func() string { return pick(tc, ptrs...) }
+	// A location for adding: an existing one (replace/insert), a new member
+	// or the end of an array.
+	addTarget := func() string {
+		if chance(tc, 40) {
+			return existing()
+		}
+		var containers []*pnode
+		var cptrs []string
+		for _, p := range ptrs {
+			_, _, _, node, st := locate(root, p)
+			if st == locFound && (node.kind == '{' || node.kind == '[') {
+				containers = append(containers, node)
+				cptrs = append(cptrs, p)
+			}
+		}
+		if len(containers) == 0 {
+			return existing()
+		}
+		i := n(tc, 0, len(containers)-1)
+		c := containers[i]
+		if c.kind == '{' {
+			return cptrs[i] + "/" + escapeSeg(pick(tc, "new", "a", "b", "x/y", "~", "", "日本", "\t", "-", "0"))
+		}
+		if chance(tc, 50) {
+			return cptrs[i] + "/-"
+		}
+		if !Known.addBeyondEnd && chance(tc, 20) {
+			return cptrs[i] + "/" + strconv.Itoa(len(c.elems)+n(tc, 1, 3))
+		}
+		return cptrs[i] + "/" + strconv.Itoa(len(c.elems))
+	}
+	valueOf := func() *pnode {
+		text := genValueText(tc, 1, true)
+		v, err := modelParse([]byte(text))
+		if err != nil {
+			panic(fmt.Sprintf("generator: %q: %v", text, err))
+		}
+		return v
+	}
+	var op mop
+	op.op = pick(tc, "add", "add", "remove", "replace", "move", "copy", "test", "test")
+	switch op.op {
+	case "add":
+		op.path, op.value, op.hasValue = addTarget(), valueOf(), true
+	case "remove":
+		op.path = existing()
+		if op.path == "" {
+			op.path = "/nothing"
+		}
+	case "replace":
+		op.path, op.value, op.hasValue = existing(), valueOf(), true
+		if op.path == "" && Known.replaceRoot {
+			op.path = pick(tc, ptrs...)
+			if op.path == "" {
+				op.path = "/nothing"
+			}
+		}
+	case "move", "copy":
+		op.from, op.hasFrom = existing(), true
+		op.path = addTarget()
+		if Known.moveToSelfCopyRoot {
+			if op.op == "move" && op.from == op.path {
+				op.path = op.path + "/x"
+			}
+			if op.op == "copy" && op.from == "" {
+				op.from = pick(tc, ptrs...)
+				if op.from == "" {
+					op.from = "/nothing"
+				}
+			}
+		}
+	case "test":
+		op.path = existing()
+		_, _, _, node, _ := locate(root, op.path)
+		if node != nil && chance(tc, 70) {
+			op.value = node.clone()
+			if chance(tc, 30) {
+				// The same value written differently.
+				op.value = reencode(tc, op.value)
+			}
+		} else {
+			op.value = valueOf()
+		}
+		if Known.testNullFails && node != nil && node.kind == 'n' && op.value.kind == 'n' {
+			op.value = &pnode{kind: 't', lit: "true"} // differs: fails either way
+		}
+		op.hasValue = true
+	}
+	// Occasional misses and malformed encodings.
+	if chance(tc, 15) {
+		switch n(tc, 0, 5) {
+		case 0:
+			op.path = genPointer(tc, root)
+		case 1:
+			if op.hasFrom {
+				op.from = genPointer(tc, root)
+			} else {
+				op.path = op.path + "/" + pick(tc, "zzz", "-", "01", "x")
+			}
+		default:
+			defects := []string{"no-op", "no-path", "bad-op", "op-not-string", "path-not-string", "dup-member", "not-object"}
+			if op.hasFrom {
+				defects = append(defects, "no-from")
+			}
+			if op.hasValue {
+				defects = append(defects, "no-value")
+			}
+			op.defect = pick(tc, defects...)
+		}
+	}
+	// Keep clear of the recorded bugs' shapes.
+	if Known.moveToSelfCopyRoot {
+		if op.op == "move" && op.from == op.path {
+			op.path += "/x"
+		}
+		if op.op == "copy" && op.from == "" {
+			op.from = "/nothing"
+		}
+	}
+	if Known.replaceRoot && op.op == "replace" && op.path == "" {
+		op.path = "/nothing"
+	}
+	if Known.addBeyondEnd && (op.op == "add" || op.op == "move" || op.op == "copy") {
+		if parent, idx, _, _, st := locate(root, op.path); st == locMissing && parent.kind == '[' && idx > len(parent.elems) {
+			op.path = op.path[:strings.LastIndexByte(op.path, '/')] + "/-"
+		}
+	}
+	return op
+}
+
+// reencode rewrites a value so that its JSON value is unchanged: a number as
+// a float spelling, a string re-escaped, whitespace inside containers.
+func reencode(tc hegel.TestCase, v *pnode) *pnode {
+	c := v.clone()
+	switch c.kind {
+	case '0':
+		if f, err := strconv.ParseFloat(c.lit, 64); err == nil && !math.IsInf(f, 0) {
+			c.lit = pick(tc, strconv.FormatFloat(f, 'g', -1, 64), strconv.FormatFloat(f, 'e', -1, 64), c.lit)
+			if strings.ContainsAny(c.lit, "+Ii") || !numberRE.MatchString(c.lit) {
+				c.lit = v.lit
+			}
+		}
+	case '"':
+		c.lit = quote(unquote(c.lit))
+		if unquote(c.lit) != unquote(v.lit) {
+			c.lit = v.lit
+		}
+	case '{':
+		if len(c.members) > 1 {
+			i := n(tc, 0, len(c.members)-1)
+			c.members[0], c.members[i] = c.members[i], c.members[0]
+		}
+	}
+	return c
+}
+
+// encodePatch writes the operations as a HuJSON patch document, applying the
+// defect of any operation that has one.
+func encodePatch(tc hegel.TestCase, ops []mop) []byte {
+	var sb strings.Builder
+	x := func() string { return genExtra(tc, true) }
+	sb.WriteString(x())
+	sb.WriteByte('[')
+	for i, op := range ops {
+		if op.defect == "not-object" {
+			sb.WriteString(x() + "7")
+		} else {
+			var members []string
+			mem := func(name, val string) { members = append(members, x()+quote(name)+x()+":"+x()+val+x()) }
+			if op.defect == "op-not-string" {
+				mem("op", "1")
+			} else if op.defect == "bad-op" {
+				mem("op", quote(pick(tc, "ADD", "delete", "", "adds")))
+			} else if op.defect != "no-op" {
+				mem("op", quote(op.op))
+			}
+			if op.defect == "path-not-string" {
+				mem("path", "[]")
+			} else if op.defect != "no-path" {
+				mem("path", quote(op.path))
+			}
+			if op.hasFrom && op.defect != "no-from" {
+				mem("from", quote(op.from))
+			}
+			if op.hasValue && op.defect != "no-value" {
+				mem("value", op.value.String())
+			}
+			if op.defect == "dup-member" {
+				mem("path", quote(op.path))
+			}
+			if chance(tc, 10) {
+				mem("extra", "null")
+			}
+			// Shuffle.
+			for j := len(members) - 1; j > 0; j-- {
+				k := n(tc, 0, j)
+				members[j], members[k] = members[k], members[j]
+			}
+			sb.WriteString(x() + "{" + strings.Join(members, ",") + x() + "}")
+		}
+		if i < len(ops)-1 || chance(tc, 30) {
+			sb.WriteByte(',')
+		}
+	}
+	sb.WriteString(x())
+	sb.WriteByte(']')
+	sb.WriteString(x())
+	return []byte(sb.String())
+}
+
+func TestHegelPatchFollowsRFC6902(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, want := genDoc(ht)
+		v, err := hujson.Parse(b)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", b, err)
+		}
+		model := want.clone()
+		var ops []mop
+		var modelErr error
+		k := n(ht, 1, 4)
+		for i := 0; i < k; i++ {
+			op := genOp(ht, model)
+			ops = append(ops, op)
+			if op.defect != "" {
+				modelErr = fmt.Errorf("operation %d malformed: %s", i, op.defect)
+				break
+			}
+			if modelErr == nil {
+				if e := applyModel(&model, op); e != nil {
+					modelErr = fmt.Errorf("operation %d: %v", i, e)
+				}
+			}
+		}
+		if chance(ht, 5) {
+			ops = nil
+			modelErr = nil
+			model = want.clone()
+		}
+		patch := encodePatch(ht, ops)
+		note(ht, "doc %q patch %q", b, patch)
+		if _, err := hujson.Parse(patch); err != nil {
+			fail(ht, "generator produced an unparsable patch %q: %v", patch, err)
+		}
+		w := v.Clone()
+		perr := w.Patch(patch)
+		if (perr != nil) != (modelErr != nil) {
+			fail(ht, "Patch(%q) on %q: err=%v, model err=%v", patch, b, perr, modelErr)
+		}
+		if p := v.Pack(); !bytes.Equal(p, b) {
+			fail(ht, "Patch mutated the original through Clone: %q -> %q", b, p)
+		}
+		if perr != nil {
+			return
+		}
+		out := w.Pack()
+		if _, err := hujson.Parse(out); err != nil {
+			fail(ht, "Patch(%q) on %q packs to %q, which does not parse: %v", patch, b, out, err)
+		}
+		if err := checkOffsets(&w, out); err != nil {
+			w.UpdateOffsets()
+			if err2 := checkOffsets(&w, w.Pack()); err2 != nil {
+				fail(ht, "offsets after Patch and UpdateOffsets of %q: %v", out, err2)
+			}
+		}
+		m := w.Clone()
+		m.Minimize()
+		if got, wantMin := string(m.Pack()), compactOf(model); got != wantMin {
+			fail(ht, "Patch(%q) on %q = %q, minimized %q, want %q", patch, b, out, got, wantMin)
+		}
+		f := w.Clone()
+		f.Format()
+		fp := f.Pack()
+		if _, err := hujson.Parse(fp); err != nil {
+			fail(ht, "Format after Patch(%q) on %q gives %q, which does not parse: %v", patch, b, fp, err)
+		}
+		fm, _ := modelParse(fp)
+		x, _ := jsonValue(fm)
+		y, _ := jsonValue(model)
+		if !reflect.DeepEqual(x, y) {
+			fail(ht, "Format after Patch(%q) on %q changed the value: %q, want %q", patch, b, fp, compactOf(model))
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 7: Literal constructors and accessors.
+
+func genGoString(tc hegel.TestCase) string {
+	k := n(tc, 0, 8)
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		switch n(tc, 0, 6) {
+		case 0:
+			sb.WriteByte(byte(n(tc, 0, 0x1f)))
+		case 1:
+			sb.WriteString(pick(tc, `"`, `\`, "/", "\u2028", "", "é", "日本", "\U0001f600", "�"))
+		case 2:
+			if chance(tc, 30) {
+				sb.WriteByte(0xff)
+			} else {
+				sb.WriteByte(byte(n(tc, 0x20, 0x7e)))
+			}
+		default:
+			sb.WriteByte(byte(n(tc, 0x20, 0x7e)))
+		}
+	}
+	return sb.String()
+}
+
+func TestHegelLiteralConstructorsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		switch n(ht, 0, 5) {
+		case 0:
+			s := genGoString(ht)
+			lit := hujson.String(s)
+			note(ht, "String(%q) = %s", s, lit)
+			if !lit.IsValid() || lit.Kind() != '"' {
+				fail(ht, "String(%q) = %q: IsValid %v Kind %q", s, lit, lit.IsValid(), byte(lit.Kind()))
+			}
+			want := string([]rune(s)) // invalid bytes become U+FFFD, as documented
+			if got := lit.String(); got != want {
+				fail(ht, "String(%q).String() = %q, want %q", s, got, want)
+			}
+			var back string
+			if err := json.Unmarshal(lit, &back); err != nil || back != want {
+				fail(ht, "json.Unmarshal(String(%q) = %q) = %q, %v", s, lit, back, err)
+			}
+			if utf8.ValidString(s) && string(lit) != quote(s) {
+				fail(ht, "String(%q) = %q, RFC 8785 gives %q", s, lit, quote(s))
+			}
+			if _, err := hujson.Parse(lit); err != nil {
+				fail(ht, "Parse(String(%q) = %q): %v", s, lit, err)
+			}
+		case 1:
+			i := int64(n(ht, math.MinInt32, math.MaxInt32))
+			if chance(ht, 20) {
+				i = pick(ht, int64(math.MinInt64), math.MaxInt64, 0, -1, 1<<53, -(1 << 53))
+			}
+			lit := hujson.Int(i)
+			if !lit.IsValid() || lit.Kind() != '0' || lit.Int() != i || string(lit) != strconv.FormatInt(i, 10) {
+				fail(ht, "Int(%d) = %q: IsValid %v Kind %q Int %d", i, lit, lit.IsValid(), byte(lit.Kind()), lit.Int())
+			}
+			if i >= 0 && lit.Uint() != uint64(i) {
+				fail(ht, "Int(%d).Uint() = %d", i, lit.Uint())
+			}
+			if i < 0 && lit.Uint() != 0 {
+				fail(ht, "Int(%d).Uint() = %d, want 0", i, lit.Uint())
+			}
+		case 2:
+			u := uint64(n(ht, 0, math.MaxInt32))
+			if chance(ht, 20) {
+				u = pick(ht, uint64(math.MaxUint64), uint64(math.MaxInt64), uint64(math.MaxInt64)+1)
+			}
+			lit := hujson.Uint(u)
+			if !lit.IsValid() || lit.Kind() != '0' || lit.Uint() != u || string(lit) != strconv.FormatUint(u, 10) {
+				fail(ht, "Uint(%d) = %q: IsValid %v Uint %d", u, lit, lit.IsValid(), lit.Uint())
+			}
+			if u > math.MaxInt64 && lit.Int() != 0 {
+				fail(ht, "Uint(%d).Int() = %d, want 0", u, lit.Int())
+			}
+		case 3:
+			f := math.Float64frombits(uint64(n(ht, 0, math.MaxInt64)) << 1)
+			if chance(ht, 30) {
+				f = pick(ht, 0, math.Copysign(0, -1), 1.5, -2.25, 1e21, 1e-7, math.MaxFloat64, math.SmallestNonzeroFloat64, math.NaN(), math.Inf(1), math.Inf(-1), 123456789.125)
+			}
+			lit := hujson.Float(f)
+			note(ht, "Float(%v) = %s", f, lit)
+			switch {
+			case math.IsNaN(f):
+				if string(lit) != `"NaN"` || !math.IsNaN(lit.Float()) {
+					fail(ht, "Float(NaN) = %q, Float() %v", lit, lit.Float())
+				}
+			case math.IsInf(f, 0):
+				want := `"Infinity"`
+				if f < 0 {
+					want = `"-Infinity"`
+				}
+				if string(lit) != want || lit.Float() != f {
+					fail(ht, "Float(%v) = %q, Float() %v", f, lit, lit.Float())
+				}
+			default:
+				if !lit.IsValid() || lit.Kind() != '0' {
+					fail(ht, "Float(%v) = %q: IsValid %v Kind %q", f, lit, lit.IsValid(), byte(lit.Kind()))
+				}
+				if got := lit.Float(); got != f || math.Signbit(got) != math.Signbit(f) {
+					fail(ht, "Float(%v) = %q, Float() %v", f, lit, got)
+				}
+				wantText, _ := json.Marshal(f)
+				if string(lit) != string(wantText) {
+					fail(ht, "Float(%v) = %q, json.Marshal %q", f, lit, wantText)
+				}
+			}
+		case 4:
+			b := chance(ht, 50)
+			lit := hujson.Bool(b)
+			if !lit.IsValid() || lit.Bool() != b || lit.Kind() != hujson.Kind(map[bool]byte{true: 't', false: 'f'}[b]) {
+				fail(ht, "Bool(%v) = %q", b, lit)
+			}
+		default:
+			// Accessors on a drawn literal, valid or not.
+			var s string
+			if chance(ht, 70) {
+				s = genLiteral(ht)
+			} else {
+				s = pick(ht, "", " 1", "1 ", "01", "nul", "True", "1e", "-", "0x1", "[1]", "{}", `{"a":1}`, "[", `"a`, "1.", "+1", ".5", "Infinity", "NaN", "\"NaN\"", "\"Infinity\"", "\"-Infinity\"")
+			}
+			lit := hujson.Literal(s)
+			note(ht, "literal %q", s)
+			want := validLiteral(s)
+			if Known.compositeLiteralOK && s != "" && (s[0] == '[' || s[0] == '{') {
+				want = json.Valid([]byte(s))
+			}
+			if got := lit.IsValid(); got != want {
+				fail(ht, "Literal(%q).IsValid() = %v, want %v", s, got, want)
+			}
+			if got := byte(lit.Kind()); got != litKind(s) {
+				fail(ht, "Literal(%q).Kind() = %q, want %q", s, got, litKind(s))
+			}
+			if lit.Bool() != (s == "true") {
+				fail(ht, "Literal(%q).Bool() = %v", s, lit.Bool())
+			}
+			if !validLiteral(s) {
+				// The accessors are documented for JSON literals only; on
+				// invalid text they follow encoding/json ("1 " reads as 1).
+				_, _, _, _ = lit.String(), lit.Int(), lit.Uint(), lit.Float()
+				return
+			}
+			if litKind(s) == '"' {
+				if got := lit.String(); got != unquote(s) {
+					fail(ht, "Literal(%q).String() = %q, want %q", s, got, unquote(s))
+				}
+			} else if got := lit.String(); got != s {
+				fail(ht, "Literal(%q).String() = %q, want the raw text", s, got)
+			}
+			var wantInt int64
+			if litKind(s) == '0' {
+				wantInt, _ = strconv.ParseInt(s, 10, 64)
+			}
+			if got := lit.Int(); got != wantInt {
+				fail(ht, "Literal(%q).Int() = %d, want %d", s, got, wantInt)
+			}
+			var wantUint uint64
+			if litKind(s) == '0' {
+				wantUint, _ = strconv.ParseUint(s, 10, 64)
+			}
+			if got := lit.Uint(); got != wantUint {
+				fail(ht, "Literal(%q).Uint() = %d, want %d", s, got, wantUint)
+			}
+			var wantF float64
+			switch {
+			case litKind(s) == '0' && validLiteral(s):
+				if f, err := strconv.ParseFloat(s, 64); err == nil {
+					wantF = f
+				}
+			case s == `"NaN"`:
+				wantF = math.NaN()
+			case s == `"Infinity"`:
+				wantF = math.Inf(1)
+			case s == `"-Infinity"`:
+				wantF = math.Inf(-1)
+			}
+			if got := lit.Float(); !(got == wantF || (math.IsNaN(got) && math.IsNaN(wantF))) || math.Signbit(got) != math.Signbit(wantF) {
+				fail(ht, "Literal(%q).Float() = %v, want %v", s, got, wantF)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 8: Clone is deep.
+
+func TestHegelCloneIsDeep(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		b, want := genDoc(ht)
+		note(ht, "doc %q", b)
+		v, err := hujson.Parse(b)
+		if err != nil {
+			fail(ht, "Parse(%q): %v", b, err)
+		}
+		c := v.Clone()
+		wantPack := string(b)
+		if Known.cloneDropsComma {
+			wantPack = want.packAsCloned()
+		}
+		if string(c.Pack()) != wantPack || fmt.Sprint(offsetsOf(&c)) != fmt.Sprint(offsetsOf(&v)) {
+			fail(ht, "Clone of %q packs to %q, want %q", b, c.Pack(), wantPack)
+		}
+		// Mutate the clone every way there is; the original must not move.
+		switch n(ht, 0, 3) {
+		case 0:
+			c.Format()
+		case 1:
+			c.Minimize()
+		case 2:
+			c.Standardize()
+		default:
+			_ = c.Patch([]byte(`[{"op":"add","path":"","value":{"x":[1,2,3]}}]`))
+		}
+		// Also scribble on the clone's byte slices.
+		for x := range c.All() {
+			for i := range x.BeforeExtra {
+				x.BeforeExtra[i] = ' '
+			}
+			for i := range x.AfterExtra {
+				x.AfterExtra[i] = ' '
+			}
+			if lit, ok := x.Value.(hujson.Literal); ok && len(lit) > 0 {
+				lit[0] = 'Z'
+			}
+		}
+		if p := v.Pack(); !bytes.Equal(p, b) {
+			fail(ht, "mutating a Clone changed the original: %q -> %q", b, p)
+		}
+		// And the other way round: Parse aliases the input, Clone must not.
+		orig := cp(b)
+		d := v.Clone()
+		for i := range b {
+			b[i] = '#'
+		}
+		if p := d.Pack(); string(p) != wantPack {
+			fail(ht, "Clone aliases the parsed input: %q after scribbling on the input (was %q)", p, orig)
+		}
+	})
+}
