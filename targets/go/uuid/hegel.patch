diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..3d111d3
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,329 @@
+package uuid_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged as the wide property that meets the shape judges, so that each bug
+// has a property that finds it every run (the wide properties in hegel_test.go reach the shapes
+// at their natural rate). Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug
+// does not touch instead (one goroutine, a fresh destination, a nil NULL, a valid NullUUID, a
+// representable instant, a node with a non-zero byte) and passes.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- uuid/1
+
+// raceCase: NewV6WithTime called at one instant from several goroutines (uuid/1; one
+// goroutine under HEGEL_NO_KNOWN=1), calls times each, from a set clock sequence; goroutines
+// times calls stays under the 16384 clock sequences one timestamp allows.
+type raceCase struct {
+	at         time.Time
+	seq        int
+	goroutines int
+	calls      int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c raceCase) GoString() string {
+	return fmt.Sprintf("%d goroutines x %d NewV6WithTime(%v) calls, clock sequence %#x", c.goroutines, c.calls, c.at, c.seq)
+}
+
+var raceCases = hegel.Composite(func(tc hegel.TestCase) raceCase {
+	return raceCase{
+		at:         hegel.Draw(tc, representable),
+		seq:        hegel.Draw(tc, hegel.Integers(0, 0x3fff)),
+		goroutines: hegel.Draw(tc, shaped(hegel.Integers(2, 4), hegel.Just(1))),
+		calls:      hegel.Draw(tc, hegel.Integers(2000, 4000)),
+	}
+})
+
+// raceRounds is how many times run repeats the calls before giving the library the benefit of
+// the doubt: a race shows in most rounds, not in every one (on a two-CPU box with a busy
+// neighbour the goroutines can run one after the other for a while), and a shrunk case must
+// replay.
+const raceRounds = 12
+
+// run makes the calls, up to raceRounds times until a round duplicates a UUID, and counts the
+// distinct UUIDs, the duplicated ones and the errors of the last round.
+func (c raceCase) run() (distinct, dups int, errs int32) {
+	for round := 0; round < raceRounds && dups == 0 && errs == 0; round++ {
+		distinct, dups, errs = c.round()
+	}
+	return distinct, dups, errs
+}
+
+// round starts the goroutines, releases them together and collects what they made.
+func (c raceCase) round() (distinct, dups int, errs int32) {
+	uuid.SetClockSequence(c.seq)
+	at := c.at
+	res := make([][]uuid.UUID, c.goroutines)
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	for g := range res {
+		wg.Add(1)
+		go func(g int) {
+			defer wg.Done()
+			<-start
+			for i := 0; i < c.calls; i++ {
+				u, err := uuid.NewV6WithTime(&at)
+				if err != nil {
+					atomic.AddInt32(&errs, 1)
+					continue
+				}
+				res[g] = append(res[g], u)
+			}
+		}(g)
+	}
+	close(start)
+	wg.Wait()
+	seen := map[uuid.UUID]int{}
+	for _, r := range res {
+		for _, u := range r {
+			seen[u]++
+			if seen[u] == 2 {
+				dups++
+			}
+		}
+	}
+	return len(seen), dups, errs
+}
+
+// TestHegelConcurrentNewV6WithTimeCallsAreDistinct: NewV6WithTime at one instant hands each
+// caller the next clock sequence, so up to 16384 calls, concurrent or not, are distinct UUIDs;
+// the function reads and writes the shared clock state without the mutex, and concurrent
+// callers get duplicates (uuid/1; a race, so found in most runs rather than every one).
+func TestHegelConcurrentNewV6WithTimeCallsAreDistinct(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, raceCases)
+		distinct, dups, errs := c.run()
+		if errs > 0 {
+			fail(ht, "NewV6WithTime(%v): %d errors", c.at, errs)
+		}
+		if dups > 0 {
+			mismatch(ht, known("uuid/1"), "%d goroutines x %d NewV6WithTime(%v) calls: %d distinct UUIDs, %d duplicated", c.goroutines, c.calls, c.at, distinct, dups)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uuid/2
+
+// nullScanCase: a UUID destination holding the previous row's UUID (uuid/2; fresh, Nil, under
+// HEGEL_NO_KNOWN=1) and the driver's spelling of a NULL: nil, "" or []byte{}.
+type nullScanCase struct {
+	prev uuid.UUID
+	null any
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nullScanCase) GoString() string { return fmt.Sprintf("Scan(%#v) into %v", c.null, c.prev) }
+
+var nullScanCases = hegel.Composite(func(tc hegel.TestCase) nullScanCase {
+	return nullScanCase{
+		prev: hegel.Draw(tc, shaped(uuids, hegel.Just(uuid.Nil))),
+		null: hegel.Draw(tc, hegel.SampledFrom([]any{nil, "", []byte{}})),
+	}
+})
+
+// TestHegelScanOfNullResetsTheDestination: a NULL from the driver (nil, or the empty string or
+// []byte the source calls "a null UUID") scanned into a UUID leaves Nil whatever the
+// destination held, as database/sql's own scanners assign on every Scan; the library returns
+// without assigning, so the previous row's UUID stays in place (uuid/2).
+func TestHegelScanOfNullResetsTheDestination(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nullScanCases)
+		dest := c.prev
+		if err := dest.Scan(c.null); err != nil {
+			fail(ht, "Scan(%#v): %v", c.null, err)
+		}
+		if dest != uuid.Nil {
+			mismatch(ht, known("uuid/2"), "Scan(%#v) into %v left %v; want Nil", c.null, c.prev, dest)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uuid/3
+
+// emptyScanCase: an empty string or []byte as the NULL (uuid/3; nil under HEGEL_NO_KNOWN=1)
+// scanned into a NullUUID that holds the previous row (valid) half of the time.
+type emptyScanCase struct {
+	prev  *uuid.UUID
+	empty any
+}
+
+// dest is the NullUUID before the Scan.
+func (c emptyScanCase) dest() uuid.NullUUID {
+	if c.prev != nil {
+		return uuid.NullUUID{UUID: *c.prev, Valid: true}
+	}
+	return uuid.NullUUID{}
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c emptyScanCase) GoString() string {
+	return fmt.Sprintf("NullUUID.Scan(%#v) into %+v", c.empty, c.dest())
+}
+
+var emptyScanCases = hegel.Composite(func(tc hegel.TestCase) emptyScanCase {
+	return emptyScanCase{
+		prev:  hegel.Draw(tc, optional(50, uuids)),
+		empty: hegel.Draw(tc, shaped(hegel.SampledFrom([]any{"", []byte{}}), hegel.Just[any](nil))),
+	}
+})
+
+// TestHegelNullUUIDScanOfEmptyIsNull: NullUUID.Scan of the empty string or []byte, which
+// UUID.Scan takes for a NULL, leaves the null value (Valid false, UUID Nil) as Scan(nil) does;
+// the library reports Valid = true with the Nil or the previous UUID (uuid/3).
+func TestHegelNullUUIDScanOfEmptyIsNull(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, emptyScanCases)
+		nu := c.dest()
+		if err := nu.Scan(c.empty); err != nil {
+			fail(ht, "NullUUID.Scan(%#v): %v", c.empty, err)
+		}
+		if nu.Valid || nu.UUID != uuid.Nil {
+			mismatch(ht, known("uuid/3"), "NullUUID.Scan(%#v) into %+v = %+v; want Valid = false and Nil, as for Scan(nil)", c.empty, c.dest(), nu)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uuid/4
+
+// nullValueCase: a NullUUID holding a random UUID, null (uuid/4) or, under HEGEL_NO_KNOWN=1,
+// valid.
+type nullValueCase struct{ nu uuid.NullUUID }
+
+// canon is the value the null NullUUID reads back as: Valid false and the Nil UUID.
+func (c nullValueCase) canon() uuid.NullUUID {
+	if c.nu.Valid {
+		return c.nu
+	}
+	return uuid.NullUUID{}
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nullValueCase) GoString() string { return fmt.Sprintf("%+v", c.nu) }
+
+var nullValueCases = hegel.Map(uuids, func(u uuid.UUID) nullValueCase {
+	return nullValueCase{uuid.NullUUID{UUID: u, Valid: shaped(false, true)}}
+})
+
+// TestHegelNullUUIDTextAndBinaryRoundTrip: the TextMarshaler/TextUnmarshaler and
+// BinaryMarshaler/BinaryUnmarshaler pairs of NullUUID invert each other, for the null value
+// too, and so a JSON object keyed by NullUUID (map keys use the text form) round-trips; the
+// null value marshals to the text "null" and to an empty binary, neither of which unmarshals
+// (uuid/4).
+func TestHegelNullUUIDTextAndBinaryRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nullValueCases)
+		nu, want := c.nu, c.canon()
+		txt, err := nu.MarshalText()
+		if err != nil {
+			fail(ht, "MarshalText(%+v): %v", nu, err)
+		}
+		var back uuid.NullUUID
+		if err := back.UnmarshalText(txt); err != nil || back != want {
+			mismatch(ht, known("uuid/4"), "UnmarshalText(MarshalText(%+v) = %q) = %+v, %v; want %+v", nu, txt, back, err, want)
+		}
+		bin, err := nu.MarshalBinary()
+		if err != nil {
+			fail(ht, "MarshalBinary(%+v): %v", nu, err)
+		}
+		back = uuid.NullUUID{}
+		if err := back.UnmarshalBinary(bin); err != nil || back != want {
+			mismatch(ht, known("uuid/4"), "UnmarshalBinary(MarshalBinary(%+v) = %x) = %+v, %v; want %+v", nu, bin, back, err, want)
+		}
+		js, err := json.Marshal(map[uuid.NullUUID]int{nu: 1})
+		if err != nil {
+			fail(ht, "json.Marshal of a map keyed by %+v: %v", nu, err)
+		}
+		var keyed map[uuid.NullUUID]int
+		if err := json.Unmarshal(js, &keyed); err != nil || len(keyed) != 1 || keyed[want] != 1 {
+			mismatch(ht, known("uuid/4"), "json.Unmarshal(%s) into a map keyed by NullUUID = %v, %v; want {%+v: 1}", js, keyed, err, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uuid/5
+
+// instantCase: an instant NewV6WithTime cannot represent (uuid/5) or, under HEGEL_NO_KNOWN=1,
+// one it can.
+type instantCase struct{ at time.Time }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c instantCase) GoString() string { return c.at.String() }
+
+var instantCases = hegel.Map(shaped(unrepresentables, representable), func(at time.Time) instantCase { return instantCase{at} })
+
+// TestHegelNewV6WithTimeRejectsUnrepresentableInstants: an instant outside Go's UnixNano range
+// (before 1678-09-21 or after 2262-04-11) or before the Gregorian epoch is one NewV6WithTime
+// cannot represent, so it returns an error ("returns Nil and an error"), or else the UUID's
+// timestamp reads back exactly; the library computes the ticks through the overflowed
+// UnixNano and returns a garbage timestamp with no error (uuid/5).
+func TestHegelNewV6WithTimeRejectsUnrepresentableInstants(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		at := hegel.Draw(ht, instantCases).at
+		u, err := uuid.NewV6WithTime(&at)
+		switch {
+		case err != nil && !unrepresentable(at):
+			fail(ht, "NewV6WithTime(%v): %v", at, err)
+		case err == nil:
+			sec, nsec := u.Time().UnixTime()
+			back := time.Unix(sec, nsec).UTC()
+			if int64(u.Time()) != gregorian(at) || !back.Equal(at.Truncate(100*time.Nanosecond)) {
+				mismatch(ht, known("uuid/5"), "NewV6WithTime(%v) = %v with no error: Time() %d reads back as %v; want %d", at, u, u.Time(), back, gregorian(at))
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- uuid/6
+
+// nodeCase: the node given to SetNodeID: six to eight zero bytes (uuid/6) or, under
+// HEGEL_NO_KNOWN=1, six to eight bytes of which one of the first six is not zero.
+type nodeCase struct{ node []byte }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nodeCase) GoString() string { return fmt.Sprintf("node %x", c.node) }
+
+var (
+	nearZeroNodes = hegel.Map(pairs(hegel.Integers(6, 8), pairs(hegel.Integers(0, 5), hegel.Integers(1, 255))), func(p pair[int, pair[int, int]]) []byte {
+		node := make([]byte, p.a)
+		node[p.b.a] = byte(p.b.b)
+		return node
+	})
+	nodeCases = hegel.Map(shaped(zeroNodes, nearZeroNodes), func(node []byte) nodeCase { return nodeCase{node} })
+)
+
+// TestHegelSetNodeIDKeepsTheZeroNode: SetNodeID takes any six bytes and returns true, after
+// which NodeID(), NodeInterface() ("user") and the node of the next NewUUID and NewV6 are the
+// caller's; the zero node, a legitimate RFC value, is the library's "not set" sentinel and is
+// replaced by the hardware address (or random bits) on the next use (uuid/6).
+func TestHegelSetNodeIDKeepsTheZeroNode(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		node := hegel.Draw(ht, nodeCases).node
+		if !uuid.SetNodeID(node) {
+			fail(ht, "SetNodeID(%x) = false", node)
+		}
+		got := uuid.NodeID()
+		v1, err := uuid.NewUUID()
+		if err != nil {
+			fail(ht, "NewUUID: %v", err)
+		}
+		v6, err := uuid.NewV6()
+		if err != nil {
+			fail(ht, "NewV6: %v", err)
+		}
+		if !bytes.Equal(got, node[:6]) || uuid.NodeInterface() != "user" || !bytes.Equal(v1.NodeID(), node[:6]) || !bytes.Equal(v6.NodeID(), node[:6]) {
+			mismatch(ht, known("uuid/6"), "after SetNodeID(%x): NodeID() = %x (interface %q), NewUUID().NodeID() = %x, NewV6().NodeID() = %x", node, got, uuid.NodeInterface(), v1.NodeID(), v6.NodeID())
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..13fe1ca
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1565 @@
+// Hegel property tests for github.com/google/uuid, with Python's `uuid` module (one child
+// process held open) as the oracle for parsing, field extraction, ordering and the name-based
+// versions, plus models of the RFC 9562 layouts (versions 1, 6, 7, DCE), the documented Parse
+// grammar, and round trips through the text/binary/JSON/sql encodings.
+//
+// Every property draws one case record built from the binding's combinators (a UUID and a
+// spelling of it, a spelling and an edit of its text, a clock sequence with a node and an
+// instant, ...) and renders it with pure functions. The shapes of the recorded bugs
+// (bugs.toml) are drawn by default - the zero node, an instant NewV6WithTime cannot
+// represent, an empty string or []byte as a NULL, a Scan destination holding the previous
+// row, the null NullUUID through its text and binary forms - and the properties that meet
+// them fail, naming the shape; hegel_shapes_test.go has one property per bug over its shape
+// region alone, and the pins below are the regression examples. HEGEL_NO_KNOWN=1 switches
+// the known shapes off (noKnown, below) for a run that looks past the bugs.
+//
+// UUID_COLLECT=1 turns failures into a summary printed at the end (shortest messages first).
+package uuid_test
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/md5"
+	"crypto/sha1"
+	"crypto/sha256"
+	"database/sql/driver"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"hash"
+	"math/big"
+	"os"
+	"os/exec"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/google/uuid"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+var (
+	collectMode = os.Getenv("UUID_COLLECT") != ""
+	collectMu   sync.Mutex
+	collectMsgs []string
+)
+
+type collected struct{}
+
+// fail reports a property failure; in collect mode it records the message and ends the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collectMode {
+		collectMu.Lock()
+		collectMsgs = append(collectMsgs, msg)
+		collectMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf("%s", msg)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+	if collectMode {
+		collectMu.Lock()
+		msgs := append([]string(nil), collectMsgs...)
+		collectMsgs = nil
+		collectMu.Unlock()
+		sort.Slice(msgs, func(i, j int) bool { return len(msgs[i]) < len(msgs[j]) })
+		t.Logf("COLLECT %s: %d failures", t.Name(), len(msgs))
+		for i, m := range msgs {
+			if i == 40 {
+				t.Logf("  ... %d more", len(msgs)-40)
+				break
+			}
+			t.Logf("  %s", m)
+		}
+	}
+}
+
+// guard turns a panic in a pin into a failure message instead of killing the test binary.
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties that meet them fail, naming the
+// shape (mismatch); under HEGEL_NO_KNOWN=1 the shapes are left out of the generators (shaped)
+// and the one check only a known shape can fail (the null NullUUID's text and binary forms,
+// uuid/4) is off.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) string {
+	if has {
+		return id
+	}
+	return ""
+}
+
+// known names the bug a property over its shape region is about, or nothing under
+// HEGEL_NO_KNOWN=1, when the property draws the neighbouring region.
+func known(id string) string { return shapeIf(!noKnown, id) }
+
+// mismatch reports a failed check on a case whose shape is that of the recorded bug named
+// ("" for none): the failure names the shape; under HEGEL_NO_KNOWN=1 a failure on a known
+// shape is skipped instead (never, in fact, since the generators leave the shapes out).
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if noKnown {
+		ht.Assume(shape == "")
+	}
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// ---- generator idioms ----------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise.
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// nonNil makes an empty slice a non-nil one (Lists and Binary yield nil for zero elements,
+// which encoding/json writes as null).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+// positions: an index into text of unknown length, taken modulo the length when applied.
+var positions = hegel.Integers(0, 99)
+
+// ---- the oracle: Python's uuid module ------------------------------------------------------
+
+const pyScript = `
+import sys, json, uuid, base64, hashlib
+def fields(u):
+    return {'ok': True, 'hex': u.hex, 'str': str(u), 'urn': u.urn, 'int': str(u.int),
+            'version': u.version, 'variant': u.variant, 'time': u.time,
+            'clock_seq': u.clock_seq, 'node': u.node,
+            'time_low': u.time_low, 'time_mid': u.time_mid, 'time_hi_version': u.time_hi_version,
+            'clock_seq_hi_variant': u.clock_seq_hi_variant, 'clock_seq_low': u.clock_seq_low}
+for line in sys.stdin:
+    req = json.loads(line)
+    op = req['op']
+    if op == 'parse':
+        try:
+            res = fields(uuid.UUID(req['s']))
+        except (ValueError, TypeError) as e:
+            res = {'ok': False, 'err': str(e)}
+    elif op == 'frombytes':
+        res = fields(uuid.UUID(bytes=base64.b64decode(req['b'])))
+    elif op == 'name':
+        ns = uuid.UUID(bytes=base64.b64decode(req['ns']))
+        name = base64.b64decode(req['name'])
+        u = uuid.uuid3(ns, name) if req['version'] == 3 else uuid.uuid5(ns, name)
+        res = {'hex': u.hex}
+    else:
+        res = {'err': 'unknown op'}
+    sys.stdout.write(json.dumps(res) + '\n')
+    sys.stdout.flush()
+`
+
+type pyFields struct {
+	OK        bool   `json:"ok"`
+	Err       string `json:"err"`
+	Hex       string `json:"hex"`
+	Str       string `json:"str"`
+	URN       string `json:"urn"`
+	Int       string `json:"int"`
+	Version   *int   `json:"version"`
+	Variant   string `json:"variant"`
+	Time      int64  `json:"time"`
+	ClockSeq  int    `json:"clock_seq"`
+	Node      int64  `json:"node"`
+	TimeLow   int64  `json:"time_low"`
+	TimeMid   int64  `json:"time_mid"`
+	TimeHiVer int64  `json:"time_hi_version"`
+	CSHiVar   int    `json:"clock_seq_hi_variant"`
+	CSLow     int    `json:"clock_seq_low"`
+}
+
+type pyChild struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+var (
+	pyOnce  sync.Once
+	pyProc  *pyChild
+	pyError error
+)
+
+func oracle(t *testing.T) *pyChild {
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			pyError = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			pyError = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyError = err
+			return
+		}
+		sc := bufio.NewScanner(stdout)
+		sc.Buffer(make([]byte, 1<<16), 1<<22)
+		pyProc = &pyChild{cmd: cmd, in: bufio.NewWriter(stdin), out: sc}
+	})
+	if pyError != nil {
+		t.Fatalf("cannot start the Python oracle: %v", pyError)
+	}
+	return pyProc
+}
+
+func (p *pyChild) call(req any, res any) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		return err
+	}
+	if _, err := p.in.Write(append(b, '\n')); err != nil {
+		return err
+	}
+	if err := p.in.Flush(); err != nil {
+		return err
+	}
+	if !p.out.Scan() {
+		return fmt.Errorf("oracle died: %v", p.out.Err())
+	}
+	return json.Unmarshal(p.out.Bytes(), res)
+}
+
+func (p *pyChild) parse(t *testing.T, s string) pyFields {
+	var res pyFields
+	if err := p.call(map[string]any{"op": "parse", "s": s}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res
+}
+
+func (p *pyChild) fromBytes(t *testing.T, b []byte) pyFields {
+	var res pyFields
+	if err := p.call(map[string]any{"op": "frombytes", "b": b}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res
+}
+
+func (p *pyChild) nameBased(t *testing.T, version int, ns uuid.UUID, name []byte) string {
+	var res struct {
+		Hex string `json:"hex"`
+	}
+	if err := p.call(map[string]any{"op": "name", "version": version, "ns": ns[:], "name": name}, &res); err != nil {
+		t.Fatalf("oracle: %v", err)
+	}
+	return res.Hex
+}
+
+// ---- UUIDs and their spellings -------------------------------------------------------------
+
+// specialUUIDs: Nil, Max and the name-space constants.
+var specialUUIDs = []uuid.UUID{uuid.Nil, uuid.Max, uuid.NameSpaceDNS, uuid.NameSpaceURL, uuid.NameSpaceOID, uuid.NameSpaceX500}
+
+// uuidShape: 16 random bytes with, when present, the version nibble and the variant bits set.
+type uuidShape struct {
+	raw     []byte
+	version *int
+	variant *uuid.Variant
+}
+
+func (s uuidShape) uuid() uuid.UUID {
+	var u uuid.UUID
+	copy(u[:], s.raw)
+	if s.version != nil {
+		u[6] = (u[6] & 0x0f) | byte(*s.version)<<4
+	}
+	if s.variant != nil {
+		switch *s.variant {
+		case uuid.RFC4122:
+			u[8] = (u[8] & 0x3f) | 0x80 // RFC 4122 / 9562
+		case uuid.Reserved:
+			u[8] = u[8] & 0x7f // NCS
+		case uuid.Microsoft:
+			u[8] = (u[8] & 0x1f) | 0xc0
+		default:
+			u[8] = u[8] | 0xe0 // future
+		}
+	}
+	return u
+}
+
+var (
+	variants = hegel.SampledFrom([]uuid.Variant{uuid.RFC4122, uuid.Reserved, uuid.Microsoft, uuid.Future})
+	// shapedUUIDs: random bytes, the version set 60% of the time and the variant 60%.
+	shapedUUIDs = hegel.Composite(func(tc hegel.TestCase) uuid.UUID {
+		return uuidShape{
+			raw:     hegel.Draw(tc, hegel.Binary(16, 16)),
+			version: hegel.Draw(tc, optional(60, hegel.Integers(0, 15))),
+			variant: hegel.Draw(tc, optional(60, variants)),
+		}.uuid()
+	})
+	// uuids: a shaped random UUID seven times in ten, else Nil, Max or a name space.
+	uuids = weighted(choice[uuid.UUID]{7, shapedUUIDs}, choice[uuid.UUID]{3, hegel.SampledFrom(specialUUIDs)})
+)
+
+type spellKind int
+
+const (
+	hyphenated spellKind = iota // 8-4-4-4-12
+	urn                         // the urn:uuid: prefix, in any case, before the hyphenated form
+	braced                      // {...}
+	wrapped                     // any other byte on each side: Parse reads the middle 36 bytes
+	bare                        // the 32 hex digits
+)
+
+// spellForm is one of the documented Parse forms: its kind, the urn prefix, the wrapper.
+type spellForm struct {
+	kind   spellKind
+	prefix string
+	l, r   string
+}
+
+var (
+	urnPrefixes = []string{"urn:uuid:", "URN:UUID:", "Urn:Uuid:", "urn:UUID:"}
+	lefts       = []string{"(", "[", "<", "x", " "}
+	rights      = []string{")", "]", ">", "y", " "}
+	// forms: the five forms as often as each other.
+	forms = hegel.OneOf(
+		hegel.Just(spellForm{kind: hyphenated}),
+		hegel.Map(hegel.SampledFrom(urnPrefixes), func(p string) spellForm { return spellForm{kind: urn, prefix: p} }),
+		hegel.Just(spellForm{kind: braced}),
+		hegel.Map(pairs(hegel.SampledFrom(lefts), hegel.SampledFrom(rights)), func(p pair[string, string]) spellForm {
+			return spellForm{kind: wrapped, l: p.a, r: p.b}
+		}),
+		hegel.Just(spellForm{kind: bare}),
+	)
+	// hexCases: the case of the hex digits, a coin per digit recycled over the 32 (a letter is
+	// upper case where true); absent (lower case throughout) three times in five.
+	hexCases = maybe(40, many(hegel.Booleans(), 1, 32))
+)
+
+// spelling is a UUID written in one of the documented forms, with the case of its digits.
+type spelling struct {
+	u     uuid.UUID
+	upper []bool
+	form  spellForm
+}
+
+// hex is the 32 hex digits of u in the drawn case.
+func (s spelling) hex() string {
+	b := []byte(hex.EncodeToString(s.u[:]))
+	for i, c := range b {
+		if c >= 'a' && len(s.upper) > 0 && s.upper[i%len(s.upper)] {
+			b[i] = c - 'a' + 'A'
+		}
+	}
+	return string(b)
+}
+
+func hyphenate(h string) string {
+	return h[0:8] + "-" + h[8:12] + "-" + h[12:16] + "-" + h[16:20] + "-" + h[20:32]
+}
+
+// text is the spelling.
+func (s spelling) text() string {
+	h := hyphenate(s.hex())
+	switch s.form.kind {
+	case urn:
+		return s.form.prefix + h
+	case braced:
+		return "{" + h + "}"
+	case wrapped:
+		return s.form.l + h + s.form.r
+	case bare:
+		return s.hex()
+	}
+	return h
+}
+
+// python reports whether Python's constructor takes the spelling as well (it wants a
+// lower-case urn prefix and braces).
+func (s spelling) python() bool {
+	switch s.form.kind {
+	case urn:
+		return s.form.prefix == "urn:uuid:"
+	case wrapped:
+		return false
+	}
+	return true
+}
+
+// valid reports whether Validate accepts the spelling as well (Parse also takes any other
+// 38-byte wrapper).
+func (s spelling) valid() bool { return s.form.kind != wrapped }
+
+// GoString is what the draw report prints (it uses %#v).
+func (s spelling) GoString() string { return fmt.Sprintf("%q of %v", s.text(), s.u) }
+
+var spellings = hegel.Composite(func(tc hegel.TestCase) spelling {
+	return spelling{u: hegel.Draw(tc, uuids), upper: hegel.Draw(tc, hexCases), form: hegel.Draw(tc, forms)}
+})
+
+// ---- near-valid text -----------------------------------------------------------------------
+
+type editKind int
+
+const (
+	keep        editKind = iota // the spelling as it is
+	replaceByte                 // the byte at the position (modulo the length) becomes the piece
+	deleteByte                  // the byte at the position is dropped
+	insertPiece                 // the piece goes in at the position (modulo the length plus one)
+	junkText                    // junk of a plausible length instead of the spelling
+)
+
+// textEdit is one edit of a spelling's text: its kind, a position, a junk piece, and for junk
+// the length and the pieces it is made of (recycled).
+type textEdit struct {
+	kind   editKind
+	at     int
+	piece  string
+	length int
+	pieces []string
+}
+
+var junkChars = []string{"-", "g", "G", "z", " ", "\t", "\n", "{", "}", ":", "u", "0", "9", "a", "F", "\u00e9", "\x00", "\xff", "K", "\u212a", "\u017f"}
+
+var junkLengths = []int{0, 1, 31, 32, 33, 35, 36, 37, 38, 39, 44, 45, 46}
+
+var (
+	junkPieces = hegel.SampledFrom(junkChars)
+	// edits: the five kinds as often as each other, the plain spelling first.
+	edits = hegel.OneOf(
+		hegel.Just(textEdit{kind: keep}),
+		hegel.Map(pairs(positions, junkPieces), func(p pair[int, string]) textEdit { return textEdit{kind: replaceByte, at: p.a, piece: p.b} }),
+		hegel.Map(positions, func(at int) textEdit { return textEdit{kind: deleteByte, at: at} }),
+		hegel.Map(pairs(positions, junkPieces), func(p pair[int, string]) textEdit { return textEdit{kind: insertPiece, at: p.a, piece: p.b} }),
+		hegel.Map(pairs(hegel.SampledFrom(junkLengths), many(junkPieces, 1, 8)), func(p pair[int, []string]) textEdit {
+			return textEdit{kind: junkText, length: p.a, pieces: p.b}
+		}),
+	)
+)
+
+// apply is the edited text.
+func (e textEdit) apply(s string) string {
+	switch e.kind {
+	case replaceByte:
+		i := e.at % len(s)
+		return s[:i] + e.piece + s[i+1:]
+	case deleteByte:
+		i := e.at % len(s)
+		return s[:i] + s[i+1:]
+	case insertPiece:
+		i := e.at % (len(s) + 1)
+		return s[:i] + e.piece + s[i:]
+	case junkText:
+		var sb strings.Builder
+		for i := 0; sb.Len() < e.length; i++ {
+			sb.WriteString(e.pieces[i%len(e.pieces)])
+		}
+		return sb.String()[:e.length]
+	}
+	return s
+}
+
+// textCase: a spelling and an edit of its text, usually near a valid spelling.
+type textCase struct {
+	sp   spelling
+	edit textEdit
+}
+
+func (c textCase) text() string { return c.edit.apply(c.sp.text()) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c textCase) GoString() string { return fmt.Sprintf("%q", c.text()) }
+
+var textCases = hegel.Composite(func(tc hegel.TestCase) textCase {
+	return textCase{sp: hegel.Draw(tc, spellings), edit: hegel.Draw(tc, edits)}
+})
+
+// ---- models --------------------------------------------------------------------------------
+
+func isHex(c byte) bool {
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
+}
+
+func asciiFoldEq(a, b string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := 0; i < len(a); i++ {
+		x, y := a[i], b[i]
+		if x >= 'A' && x <= 'Z' {
+			x += 'a' - 'A'
+		}
+		if y >= 'A' && y <= 'Z' {
+			y += 'a' - 'A'
+		}
+		if x != y {
+			return false
+		}
+	}
+	return true
+}
+
+func hyphenatedOK(s string) bool {
+	if len(s) != 36 || s[8] != '-' || s[13] != '-' || s[18] != '-' || s[23] != '-' {
+		return false
+	}
+	for i := 0; i < 36; i++ {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			continue
+		}
+		if !isHex(s[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+type parseErr int
+
+const (
+	peNone parseErr = iota
+	peLength
+	peURN
+	peFormat
+	peBracket
+)
+
+func (e parseErr) String() string {
+	return [...]string{"ok", "length", "urn-prefix", "format", "bracket"}[e]
+}
+
+// modelParse is Parse's documented grammar: the four forms by length, the middle 36 bytes of a
+// 38-byte string, a case-insensitive `urn:uuid:` prefix.  validate adds Validate's brace check.
+func modelParse(s string, validate bool) (uuid.UUID, parseErr) {
+	var u uuid.UUID
+	body := s
+	switch len(s) {
+	case 36:
+	case 45:
+		if !asciiFoldEq(s[:9], "urn:uuid:") {
+			return u, peURN
+		}
+		body = s[9:]
+	case 38:
+		if validate && (s[0] != '{' || s[37] != '}') {
+			return u, peBracket
+		}
+		body = s[1:37]
+	case 32:
+		for i := 0; i < 32; i++ {
+			if !isHex(s[i]) {
+				return u, peFormat
+			}
+		}
+		b, _ := hex.DecodeString(s)
+		copy(u[:], b)
+		return u, peNone
+	default:
+		return u, peLength
+	}
+	if !hyphenatedOK(body) {
+		return u, peFormat
+	}
+	b, _ := hex.DecodeString(strings.ReplaceAll(body, "-", ""))
+	copy(u[:], b)
+	return u, peNone
+}
+
+func classify(err error) parseErr {
+	switch {
+	case err == nil:
+		return peNone
+	case uuid.IsInvalidLengthError(err):
+		return peLength
+	case errors.Is(err, uuid.ErrInvalidURNPrefix):
+		return peURN
+	case errors.Is(err, uuid.ErrInvalidBracketedFormat):
+		return peBracket
+	case errors.Is(err, uuid.ErrInvalidUUIDFormat):
+		return peFormat
+	}
+	return parseErr(-1)
+}
+
+// RFC 9562 layouts.
+const g1582ns100 = 122192928000000000 // 100 ns ticks from 1582-10-15 to 1970-01-01
+
+func v1Time(u uuid.UUID) int64 {
+	return int64(binary.BigEndian.Uint32(u[0:4])) | int64(binary.BigEndian.Uint16(u[4:6]))<<32 |
+		int64(binary.BigEndian.Uint16(u[6:8])&0x0fff)<<48
+}
+
+func v6Time(u uuid.UUID) int64 {
+	return int64(binary.BigEndian.Uint32(u[0:4]))<<28 | int64(binary.BigEndian.Uint16(u[4:6]))<<12 |
+		int64(binary.BigEndian.Uint16(u[6:8])&0x0fff)
+}
+
+func v7Millis(u uuid.UUID) int64 {
+	return int64(binary.BigEndian.Uint64(u[0:8]) >> 16)
+}
+
+// gregorian is the RFC timestamp of t: 100 ns ticks since 1582-10-15 (floor).
+func gregorian(t time.Time) int64 {
+	ns := new(big.Int).Mul(big.NewInt(t.Unix()), big.NewInt(1e9))
+	ns.Add(ns, big.NewInt(int64(t.Nanosecond())))
+	ticks := new(big.Int).Div(ns, big.NewInt(100)) // Euclidean division: floor for a positive divisor
+	return ticks.Int64() + g1582ns100
+}
+
+func variantOf(u uuid.UUID) uuid.Variant {
+	switch {
+	case u[8]&0x80 == 0:
+		return uuid.Reserved
+	case u[8]&0x40 == 0:
+		return uuid.RFC4122
+	case u[8]&0x20 == 0:
+		return uuid.Microsoft
+	}
+	return uuid.Future
+}
+
+var pyVariant = map[uuid.Variant]string{
+	uuid.Reserved: "reserved for NCS compatibility", uuid.RFC4122: "specified in RFC 4122",
+	uuid.Microsoft: "reserved for Microsoft compatibility", uuid.Future: "reserved for future definition",
+}
+
+// ---- the other cases -----------------------------------------------------------------------
+
+// fieldsCase: two UUIDs, the second for Compare.
+type fieldsCase struct{ u, v uuid.UUID }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c fieldsCase) GoString() string { return fmt.Sprintf("u %v v %v", c.u, c.v) }
+
+var fieldsCases = hegel.Composite(func(tc hegel.TestCase) fieldsCase {
+	return fieldsCase{u: hegel.Draw(tc, uuids), v: hegel.Draw(tc, uuids)}
+})
+
+// nameCase: a name space, a byte name of up to 64 bytes, the hash of NewHash and its version.
+type nameCase struct {
+	ns      uuid.UUID
+	name    []byte
+	hash    string
+	version int
+}
+
+// newHash is a fresh hash of the drawn kind.
+func (c nameCase) newHash() hash.Hash {
+	switch c.hash {
+	case "md5":
+		return md5.New()
+	case "sha1":
+		return sha1.New()
+	}
+	return sha256.New()
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nameCase) GoString() string {
+	return fmt.Sprintf("ns %v name %x %s version %d", c.ns, c.name, c.hash, c.version)
+}
+
+var nameCases = hegel.Composite(func(tc hegel.TestCase) nameCase {
+	return nameCase{
+		ns:      hegel.Draw(tc, uuids),
+		name:    nonNil(hegel.Draw(tc, hegel.Binary(0, 64))),
+		hash:    hegel.Draw(tc, hegel.SampledFrom([]string{"md5", "sha1", "sha256"})),
+		version: hegel.Draw(tc, hegel.Integers(0, 15)),
+	}
+})
+
+// unixInstants: time.Unix of a second and a nanosecond draw, in UTC.
+func unixInstants(secs, nanos hegel.Generator[int64]) hegel.Generator[time.Time] {
+	return hegel.Map(pairs(secs, nanos), func(p pair[int64, int64]) time.Time { return time.Unix(p.a, p.b).UTC() })
+}
+
+// isZeroNode reports the library's "not yet set" sentinel: six zero bytes (uuid/6).
+func isZeroNode(node []byte) bool { return bytes.Equal(node[:6], make([]byte, 6)) }
+
+// unrepresentable reports an instant outside Go's UnixNano range (before 1678-09-21 or after
+// 2262-04-11), which NewV6WithTime cannot represent (uuid/5); the RFC field itself reaches 5236.
+func unrepresentable(t time.Time) bool {
+	sec := t.Unix()
+	return sec < -9_223_372_036 || sec > 9_223_372_036
+}
+
+var (
+	nanos    = hegel.Integers[int64](0, 999_999_999)
+	nanos100 = hegel.Map(hegel.Integers[int64](0, 9_999_999), func(n int64) int64 { return n * 100 })
+	// representable: an instant NewV6WithTime can represent, within Go's UnixNano range: recent
+	// (1970 to 2033), pre-1970 back to 1678 with nanoseconds a multiple of 100 (README, Not
+	// bugs), the far future before 2262-04-11, or within a second of now.
+	representable = hegel.OneOf(
+		unixInstants(hegel.Integers[int64](0, 2_000_000_000), nanos),
+		unixInstants(hegel.Integers[int64](-9_200_000_000, -1), nanos100),
+		unixInstants(hegel.Integers[int64](2_000_000_000, 9_200_000_000), nanos),
+		hegel.Map(hegel.Integers(-1_000_000_000, 1_000_000_000), func(d int) time.Time { return time.Now().Add(time.Duration(d)).UTC() }),
+	)
+	// unrepresentables: an instant NewV6WithTime cannot represent (the shape of uuid/5): after
+	// 2262-04-11 up to the year 9999, between 1582-10-15 (the Gregorian epoch) and 1678-09-21,
+	// or before 1582-10-15, where the tick count is negative.
+	unrepresentables = hegel.OneOf(
+		unixInstants(hegel.Integers[int64](9_223_372_037, 253_402_300_799), nanos),
+		unixInstants(hegel.Integers[int64](-12_219_292_800, -9_223_372_037), nanos100),
+		unixInstants(hegel.Integers[int64](-62_135_596_800, -12_219_292_801), nanos100),
+	)
+	// v6Instants: representable 85% of the time; under HEGEL_NO_KNOWN=1 always.
+	v6Instants = shaped(weighted(choice[time.Time]{85, representable}, choice[time.Time]{15, unrepresentables}), representable)
+
+	// clockSeqs: 14 bits, and bits above them (which must not count) 20% of the time.
+	clockSeqs = hegel.Map(pairs(hegel.Integers(0, 0x3fff), maybe(20, hegel.Integers(1, 3))), func(p pair[int, int]) int { return p.a | p.b<<14 })
+	// randomNodes: six to eight random bytes, never the zero node (a Binary shrinks towards
+	// zero bytes, and the zero node is uuid/6's shape, drawn as zeroNodes).
+	randomNodes = hegel.Filter(hegel.Binary(6, 8), func(node []byte) bool { return !isZeroNode(node) })
+	// zeroNodes: six to eight zero bytes, the library's "not yet set" sentinel (uuid/6).
+	zeroNodes = hegel.Map(hegel.Integers(6, 8), func(k int) []byte { return make([]byte, k) })
+	// nodes: a random node nine times in ten, the zero node once; under HEGEL_NO_KNOWN=1 random.
+	nodes = shaped(weighted(choice[[]byte]{9, randomNodes}, choice[[]byte]{1, zeroNodes}), randomNodes)
+)
+
+// timeCase: the clock sequence to set, the node to set, the instant for NewV6WithTime and the
+// reader's 16 bytes for NewV7FromReader.
+type timeCase struct {
+	seq  int
+	node []byte
+	at   time.Time
+	rnd  []byte
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c timeCase) GoString() string {
+	return fmt.Sprintf("seq %#x node %x at %v rnd %x", c.seq, c.node, c.at, c.rnd)
+}
+
+var timeCases = hegel.Composite(func(tc hegel.TestCase) timeCase {
+	return timeCase{
+		seq:  hegel.Draw(tc, clockSeqs),
+		node: hegel.Draw(tc, nodes),
+		at:   hegel.Draw(tc, v6Instants),
+		rnd:  hegel.Draw(tc, hegel.Binary(16, 16)),
+	}
+})
+
+// dceCase: the arguments of NewDCESecurity.
+type dceCase struct {
+	domain uuid.Domain
+	id     uint32
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c dceCase) GoString() string { return fmt.Sprintf("domain %d id %d", int(c.domain), c.id) }
+
+var dceCases = hegel.Composite(func(tc hegel.TestCase) dceCase {
+	return dceCase{domain: uuid.Domain(hegel.Draw(tc, hegel.Integers(0, 255))), id: hegel.Draw(tc, hegel.Integers[uint32](0, 1<<32-1))}
+})
+
+// nullForms: the driver's spellings of a NULL: nil, or an empty string or an empty []byte
+// (the source of Scan says "if an empty UUID comes from a table, we return a null UUID"),
+// which are the shape of uuid/2 and uuid/3; under HEGEL_NO_KNOWN=1 nil only.
+var nullForms = shaped(hegel.SampledFrom([]any{nil, "", []byte{}}), hegel.Just[any](nil))
+
+// encodingCase: a UUID, whether the NullUUID holding it is valid (70%) and, when not, whether
+// its UUID is Nil, up to three more UUIDs, a wrong binary length, the previous row's UUID
+// still in the Scan destinations (nil: fresh destinations; a NULL scanned into a stale
+// destination is the shape of uuid/2, left out under HEGEL_NO_KNOWN=1) and the spelling of a
+// NULL.
+type encodingCase struct {
+	u      uuid.UUID
+	valid  bool
+	nilOpt bool
+	list   uuid.UUIDs
+	badLen int
+	prev   *uuid.UUID
+	null   any
+}
+
+// opt is the NullUUID of the case.
+func (c encodingCase) opt() uuid.NullUUID {
+	nu := uuid.NullUUID{UUID: c.u, Valid: c.valid}
+	if !c.valid && c.nilOpt {
+		nu.UUID = uuid.Nil
+	}
+	return nu
+}
+
+// dest is a Scan destination as the case has it: the previous row's UUID, or fresh.
+func (c encodingCase) dest() uuid.UUID {
+	if c.prev != nil {
+		return *c.prev
+	}
+	return uuid.Nil
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c encodingCase) GoString() string {
+	prev := "fresh"
+	if c.prev != nil {
+		prev = c.prev.String()
+	}
+	return fmt.Sprintf("u %v valid %v nilOpt %v list %v badLen %d dest %s null %#v", c.u, c.valid, c.nilOpt, c.list, c.badLen, prev, c.null)
+}
+
+var encodingCases = hegel.Composite(func(tc hegel.TestCase) encodingCase {
+	return encodingCase{
+		u:      hegel.Draw(tc, uuids),
+		valid:  hegel.Draw(tc, chance(70)),
+		nilOpt: hegel.Draw(tc, chance(50)),
+		list:   uuid.UUIDs(nonNil(hegel.Draw(tc, many(uuids, 0, 3)))),
+		badLen: hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 15, 17, 32})),
+		prev:   hegel.Draw(tc, shaped(optional(50, uuids), hegel.Just[*uuid.UUID](nil))),
+		null:   hegel.Draw(tc, nullForms),
+	}
+})
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// readerBytes: what a random reader delivers: up to 40 bytes, fewer than 16 an error.
+var readerBytes = hegel.Binary(0, 40)
+
+// ---- properties ----------------------------------------------------------------------------
+
+// TestHegelParseAgreesWithPython: every documented spelling of a UUID parses (Parse, ParseBytes,
+// Validate, UnmarshalText, Scan, MustParse) to the same 16 bytes as Python's constructor, and
+// the outputs (String, URN, MarshalText, Value) are Python's spellings.
+func TestHegelParseAgreesWithPython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		sp := hegel.Draw(ht, spellings)
+		u, text := sp.u, sp.text()
+		got, err := uuid.Parse(text)
+		if err != nil || got != u {
+			fail(ht, "Parse(%q) = %v, %v; want %v", text, got, err, u)
+		}
+		if gb, err := uuid.ParseBytes([]byte(text)); err != nil || gb != got {
+			fail(ht, "ParseBytes(%q) = %v, %v; Parse gave %v", text, gb, err, got)
+		}
+		if err := uuid.Validate(text); (err == nil) != sp.valid() {
+			fail(ht, "Validate(%q) = %v; want valid=%v", text, err, sp.valid())
+		}
+		var ut uuid.UUID
+		if err := ut.UnmarshalText([]byte(text)); err != nil || ut != u {
+			fail(ht, "UnmarshalText(%q) = %v, %v; want %v", text, ut, err, u)
+		}
+		var us uuid.UUID
+		if err := us.Scan(text); err != nil || us != u {
+			fail(ht, "Scan(%q) = %v, %v; want %v", text, us, err, u)
+		}
+		var ub uuid.UUID
+		if err := ub.Scan([]byte(text)); err != nil || ub != u {
+			fail(ht, "Scan([]byte(%q)) = %v, %v; want %v", text, ub, err, u)
+		}
+		if mp := uuid.MustParse(text); mp != u {
+			fail(ht, "MustParse(%q) = %v; want %v", text, mp, u)
+		}
+		var js uuid.UUID
+		if err := json.Unmarshal([]byte(strconv.Quote(text)), &js); err != nil || js != u {
+			fail(ht, "json.Unmarshal(%q) = %v, %v; want %v", text, js, err, u)
+		}
+		// outputs vs Python
+		pf := py.fromBytes(t, u[:])
+		if u.String() != pf.Str {
+			fail(ht, "String() = %q; Python %q", u.String(), pf.Str)
+		}
+		if u.URN() != pf.URN {
+			fail(ht, "URN() = %q; Python %q", u.URN(), pf.URN)
+		}
+		if mt, err := u.MarshalText(); err != nil || string(mt) != pf.Str {
+			fail(ht, "MarshalText() = %q, %v; Python %q", mt, err, pf.Str)
+		}
+		if v, err := u.Value(); err != nil || v != driver.Value(pf.Str) {
+			fail(ht, "Value() = %v, %v; Python %q", v, err, pf.Str)
+		}
+		if sp.python() {
+			pp := py.parse(t, text)
+			if !pp.OK || pp.Hex != hex.EncodeToString(u[:]) {
+				fail(ht, "Python UUID(%q) = %+v; Go parsed %v", text, pp, u)
+			}
+		}
+	})
+}
+
+// TestHegelParseFollowsTheDocumentedGrammar: on arbitrary (mostly near-valid) text, Parse,
+// ParseBytes and Validate accept exactly the documented forms and return the documented error
+// kinds; whatever Parse accepts, Python accepts with the same value when spelled in Python's
+// dialect (lower-case urn prefix, braces).
+func TestHegelParseFollowsTheDocumentedGrammar(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, textCases).text()
+		want, wantErr := modelParse(s, false)
+		got, err := uuid.Parse(s)
+		if classify(err) != wantErr || (wantErr == peNone && got != want) {
+			fail(ht, "Parse(%q) = %v, %v (%s); model %v, %s", s, got, err, classify(err), want, wantErr)
+		}
+		gb, errb := uuid.ParseBytes([]byte(s))
+		if classify(errb) != classify(err) || gb != got {
+			fail(ht, "ParseBytes(%q) = %v, %v; Parse gave %v, %v", s, gb, errb, got, err)
+		}
+		if err != nil && uuid.IsInvalidLengthError(err) && !strings.Contains(err.Error(), strconv.Itoa(len(s))) {
+			fail(ht, "Parse(%q) length error %q does not name the length %d", s, err, len(s))
+		}
+		_, wantV := modelParse(s, true)
+		if verr := uuid.Validate(s); classify(verr) != wantV {
+			fail(ht, "Validate(%q) = %v (%s); model %s", s, verr, classify(verr), wantV)
+		}
+		if err == nil {
+			// Python's dialect of the same text.
+			ps := s
+			switch len(s) {
+			case 45:
+				ps = "urn:uuid:" + s[9:]
+			case 38:
+				ps = "{" + s[1:37] + "}"
+			}
+			pp := py.parse(t, ps)
+			if !pp.OK || pp.Hex != hex.EncodeToString(got[:]) {
+				fail(ht, "Python UUID(%q) = %+v; Go parsed %q as %v", ps, pp, s, got)
+			}
+		}
+	})
+}
+
+// TestHegelFieldsAgreeWithPython: Version, Variant, Time (versions other than 6 and 7), the
+// clock sequence, the node and Compare agree with Python's field accessors and integer order,
+// and with the RFC bit layouts.
+func TestHegelFieldsAgreeWithPython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, fieldsCases)
+		u, v := c.u, c.v
+		pf := py.fromBytes(t, u[:])
+		if int(u.Version()) != int(u[6]>>4) {
+			fail(ht, "%v.Version() = %d; want %d", u, u.Version(), u[6]>>4)
+		}
+		if pf.Version != nil && int(u.Version()) != *pf.Version {
+			fail(ht, "%v.Version() = %d; Python %d", u, u.Version(), *pf.Version)
+		}
+		if u.Variant() != variantOf(u) || pyVariant[u.Variant()] != pf.Variant {
+			fail(ht, "%v.Variant() = %v (%s); model %v, Python %q", u, u.Variant(), u.Variant(), variantOf(u), pf.Variant)
+		}
+		if u.Version() != 6 && u.Version() != 7 {
+			if int64(u.Time()) != pf.Time || int64(u.Time()) != v1Time(u) {
+				fail(ht, "%v.Time() = %d; Python %d, layout %d", u, u.Time(), pf.Time, v1Time(u))
+			}
+		} else if u.Version() == 6 {
+			if int64(u.Time()) != v6Time(u) {
+				fail(ht, "%v.Time() = %d; v6 layout %d", u, u.Time(), v6Time(u))
+			}
+		} else if int64(u.Time()) != v7Millis(u)*10000+g1582ns100 {
+			fail(ht, "%v.Time() = %d; v7 layout %d", u, u.Time(), v7Millis(u)*10000+g1582ns100)
+		}
+		if u.ClockSequence() != pf.ClockSeq {
+			fail(ht, "%v.ClockSequence() = %d; Python %d", u, u.ClockSequence(), pf.ClockSeq)
+		}
+		node := new(big.Int).SetBytes(u.NodeID()).Int64()
+		if len(u.NodeID()) != 6 || node != pf.Node {
+			fail(ht, "%v.NodeID() = %x; Python node %x", u, u.NodeID(), pf.Node)
+		}
+		// UnixTime inverts the Gregorian tick count (exactly, at 100 ns resolution).
+		sec, nsec := u.Time().UnixTime()
+		if nsec%100 != 0 || gregorian(time.Unix(sec, nsec)) != int64(u.Time()) {
+			fail(ht, "%v.Time() = %d, UnixTime = %d, %d (ticks back %d)", u, u.Time(), sec, nsec, gregorian(time.Unix(sec, nsec)))
+		}
+		// Compare is the integer order.
+		pv := py.fromBytes(t, v[:])
+		iu, _ := new(big.Int).SetString(pf.Int, 10)
+		iv, _ := new(big.Int).SetString(pv.Int, 10)
+		if uuid.Compare(u, v) != iu.Cmp(iv) || uuid.Compare(v, u) != -uuid.Compare(u, v) {
+			fail(ht, "Compare(%v, %v) = %d; Python ints compare %d", u, v, uuid.Compare(u, v), iu.Cmp(iv))
+		}
+		if strings.Compare(u.String(), v.String()) != uuid.Compare(u, v) {
+			fail(ht, "Compare(%v, %v) = %d but the strings compare %d", u, v, uuid.Compare(u, v), strings.Compare(u.String(), v.String()))
+		}
+		// Version and Variant names.
+		if u.Version().String() != fmt.Sprintf("VERSION_%d", u[6]>>4) {
+			fail(ht, "%v.Version().String() = %q", u, u.Version().String())
+		}
+		if s := u.Variant().String(); s != map[uuid.Variant]string{uuid.Reserved: "Reserved", uuid.RFC4122: "RFC4122", uuid.Microsoft: "Microsoft", uuid.Future: "Future"}[variantOf(u)] {
+			fail(ht, "%v.Variant().String() = %q", u, s)
+		}
+	})
+}
+
+// TestHegelNameBasedAgreeWithPython: NewMD5/NewSHA1 are Python's uuid3/uuid5 for arbitrary
+// name spaces and byte names; NewHash with any hash and version is the documented
+// "first 16 bytes of H(space || data) with the version and variant bits set".
+func TestHegelNameBasedAgreeWithPython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, nameCases)
+		ns, name, version := c.ns, c.name, c.version
+		if got, want := uuid.NewMD5(ns, name), py.nameBased(t, 3, ns, name); hex.EncodeToString(got[:]) != want {
+			fail(ht, "NewMD5(%v, %x) = %v; Python uuid3 %s", ns, name, got, want)
+		}
+		if got, want := uuid.NewSHA1(ns, name), py.nameBased(t, 5, ns, name); hex.EncodeToString(got[:]) != want {
+			fail(ht, "NewSHA1(%v, %x) = %v; Python uuid5 %s", ns, name, got, want)
+		}
+		h := c.newHash()
+		h.Write(ns[:])
+		h.Write(name)
+		sum := h.Sum(nil)
+		var want uuid.UUID
+		copy(want[:], sum)
+		want[6] = want[6]&0x0f | byte(version)<<4
+		want[8] = want[8]&0x3f | 0x80
+		h.Write([]byte("stale state that NewHash must Reset")) // NewHash documents h.Reset()
+		got := uuid.NewHash(h, ns, name, version)
+		if got != want || int(got.Version()) != version || got.Variant() != uuid.RFC4122 {
+			fail(ht, "NewHash(%T, %v, %x, %d) = %v; want %v", h, ns, name, version, got, want)
+		}
+		if uuid.NewHash(h, ns, name, version) != got {
+			fail(ht, "NewHash is not deterministic: %v then %v", got, uuid.NewHash(h, ns, name, version))
+		}
+	})
+}
+
+// TestHegelTimeBasedLayoutsFollowTheRFC: NewUUID (v1), NewV6WithTime (v6) and NewV7FromReader
+// (v7) put the time, clock sequence, node and random bits where RFC 9562 says, Time() reads
+// them back, the clock sequence advances when the same instant is used twice, and the
+// package-level clock sequence / node accessors describe the UUIDs generated. The node is
+// the zero node one time in ten (uuid/6: the library takes it for "not set") and the instant
+// one NewV6WithTime cannot represent 15% of the time (uuid/5: a garbage timestamp instead of
+// an error), so the property fails while either is open.
+func TestHegelTimeBasedLayoutsFollowTheRFC(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, timeCases)
+		seq, node, ct, rnd := c.seq, c.node, c.at, c.rnd
+		nodeShape := shapeIf(isZeroNode(node), "uuid/6")
+		timeShape := shapeIf(unrepresentable(ct), "uuid/5")
+		// Clock sequence and node under our control. Setting a *changed* sequence resets the
+		// library's "last time" (a same-valued call keeps it, and a later instant left by an
+		// earlier case would then bump the sequence).
+		uuid.SetClockSequence((seq + 1) & 0x3fff)
+		uuid.SetClockSequence(seq)
+		if got := uuid.ClockSequence(); got != seq&0x3fff {
+			fail(ht, "SetClockSequence(%#x); ClockSequence() = %#x", seq, got)
+		}
+		if !uuid.SetNodeID(node) || !bytes.Equal(uuid.NodeID(), node[:6]) || uuid.NodeInterface() != "user" {
+			mismatch(ht, nodeShape, "SetNodeID(%x): NodeID() = %x, NodeInterface() = %q", node, uuid.NodeID(), uuid.NodeInterface())
+		}
+
+		// Version 1.
+		before := time.Now()
+		v1, err := uuid.NewUUID()
+		after := time.Now()
+		if err != nil {
+			fail(ht, "NewUUID: %v", err)
+		}
+		if v1.Version() != 1 || v1.Variant() != uuid.RFC4122 {
+			fail(ht, "NewUUID() = %v: version %d variant %v", v1, v1.Version(), v1.Variant())
+		}
+		if int64(v1.Time()) != v1Time(v1) || int64(v1.Time()) < gregorian(before) || int64(v1.Time()) > gregorian(after) {
+			fail(ht, "NewUUID() = %v: Time() %d, layout %d, wall clock %d..%d", v1, v1.Time(), v1Time(v1), gregorian(before), gregorian(after))
+		}
+		if v1.ClockSequence() != seq&0x3fff || !bytes.Equal(v1.NodeID(), node[:6]) {
+			mismatch(ht, nodeShape, "NewUUID() = %v: ClockSequence() %#x (set %#x), NodeID() %x (set %x)", v1, v1.ClockSequence(), seq&0x3fff, v1.NodeID(), node[:6])
+		}
+
+		// Version 6 at a chosen instant, twice: same time, next clock sequence. An instant the
+		// function cannot represent is an error ("returns Nil and an error"), or else the
+		// timestamp must read back exactly.
+		v6, err := uuid.NewV6WithTime(&ct)
+		if err != nil && timeShape == "" {
+			fail(ht, "NewV6WithTime(%v): %v", ct, err)
+		}
+		if err == nil {
+			if v6.Version() != 6 || v6.Variant() != uuid.RFC4122 {
+				fail(ht, "NewV6WithTime(%v) = %v: version %d variant %v", ct, v6, v6.Version(), v6.Variant())
+			}
+			if int64(v6.Time()) != gregorian(ct) || int64(v6.Time()) != v6Time(v6) {
+				mismatch(ht, timeShape, "NewV6WithTime(%v) = %v: Time() %d, want %d (layout %d)", ct, v6, v6.Time(), gregorian(ct), v6Time(v6))
+			}
+			sec, nsec := v6.Time().UnixTime()
+			if back := time.Unix(sec, nsec).UTC(); !back.Equal(ct.Truncate(100 * time.Nanosecond)) {
+				mismatch(ht, timeShape, "NewV6WithTime(%v).Time().UnixTime() = %v", ct, back)
+			}
+			if !bytes.Equal(v6.NodeID(), node[:6]) {
+				mismatch(ht, nodeShape, "NewV6WithTime(%v) = %v: NodeID() %x, set %x", ct, v6, v6.NodeID(), node[:6])
+			}
+			v6b, _ := uuid.NewV6WithTime(&ct)
+			if v6b == v6 || v6b.Time() != v6.Time() || v6b.ClockSequence() != (v6.ClockSequence()+1)&0x3fff {
+				fail(ht, "NewV6WithTime(%v) twice: %v then %v (clock sequences %#x, %#x)", ct, v6, v6b, v6.ClockSequence(), v6b.ClockSequence())
+			}
+		}
+		// A v1 re-laid as v6 has the same Time().
+		var re uuid.UUID
+		ts := uint64(v1Time(v1))
+		binary.BigEndian.PutUint32(re[0:4], uint32(ts>>28))
+		binary.BigEndian.PutUint16(re[4:6], uint16(ts>>12))
+		binary.BigEndian.PutUint16(re[6:8], uint16(ts&0x0fff)|0x6000)
+		copy(re[8:], v1[8:])
+		if re.Time() != v1.Time() || re.ClockSequence() != v1.ClockSequence() || !bytes.Equal(re.NodeID(), v1.NodeID()) {
+			fail(ht, "v1 %v re-laid as v6 %v: Time() %d vs %d", v1, re, re.Time(), v1.Time())
+		}
+
+		// Version 7 from a reader we control: the random bits are ours, the time is the wall clock
+		// (ms), and consecutive values are strictly increasing.
+		before = time.Now()
+		v7, err := uuid.NewV7FromReader(bytes.NewReader(rnd))
+		after = time.Now()
+		if err != nil {
+			fail(ht, "NewV7FromReader: %v", err)
+		}
+		if v7.Version() != 7 || v7.Variant() != uuid.RFC4122 || v7[8]&0x3f != rnd[8]&0x3f || !bytes.Equal(v7[9:], rnd[9:]) {
+			fail(ht, "NewV7FromReader(%x) = %v: version %d variant %v, rand_b not the reader's", rnd, v7, v7.Version(), v7.Variant())
+		}
+		ms := v7Millis(v7)
+		if ms < before.UnixMilli() || ms > after.UnixMilli()+1 {
+			fail(ht, "NewV7FromReader = %v: unix_ts_ms %d, wall clock %d..%d", v7, ms, before.UnixMilli(), after.UnixMilli())
+		}
+		if int64(v7.Time()) != ms*10000+g1582ns100 {
+			fail(ht, "NewV7FromReader = %v: Time() %d, want %d", v7, v7.Time(), ms*10000+g1582ns100)
+		}
+		v7b, _ := uuid.NewV7()
+		if uuid.Compare(v7, v7b) >= 0 || v7b.Time() < v7.Time() {
+			fail(ht, "consecutive v7 values not increasing: %v then %v", v7, v7b)
+		}
+	})
+}
