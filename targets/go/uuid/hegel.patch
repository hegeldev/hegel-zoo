+type box struct {
+	ID   uuid.UUID     `json:"id"`
+	Opt  uuid.NullUUID `json:"opt"`
+	Many uuid.UUIDs    `json:"many"`
+}
+
+// TestHegelEncodingsRoundTrip: JSON, text and binary marshalling, database/sql Scan/Value and
+// NullUUID's JSON form all invert each other, and NullUUID's null is a JSON null / a nil
+// driver.Value. The null NullUUID goes through its text and binary forms too (uuid/4: "null"
+// and an empty binary, neither of which unmarshals), the Scan destinations hold the previous
+// row's UUID half of the time (uuid/2: a NULL leaves it in place) and a NULL is spelled as an
+// empty string or []byte two times in three (uuid/3: NullUUID.Scan reports it valid), so the
+// property fails while any of the three is open.
+func TestHegelEncodingsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, encodingCases)
+		u, valid, list := c.u, c.valid, c.list
+		in := box{ID: u, Opt: c.opt(), Many: list}
+		js, err := json.Marshal(in)
+		if err != nil {
+			fail(ht, "json.Marshal(%+v): %v", in, err)
+		}
+		wantOpt := "null"
+		if valid {
+			wantOpt = strconv.Quote(u.String())
+		}
+		wantMany, _ := json.Marshal(list.Strings())
+		if len(list) == 0 {
+			wantMany = []byte("[]")
+		}
+		want := fmt.Sprintf(`{"id":%q,"opt":%s,"many":%s}`, u.String(), wantOpt, wantMany)
+		if string(js) != want {
+			fail(ht, "json.Marshal = %s; want %s", js, want)
+		}
+		var out box
+		if err := json.Unmarshal(js, &out); err != nil {
+			fail(ht, "json.Unmarshal(%s): %v", js, err)
+		}
+		if out.ID != u || out.Opt.Valid != valid || (valid && out.Opt.UUID != u) || !reflect.DeepEqual(out.Many, list) && !(len(list) == 0 && len(out.Many) == 0) {
+			fail(ht, "json round trip of %s gave %+v", js, out)
+		}
+		if !valid && out.Opt.UUID != uuid.Nil {
+			fail(ht, "json null decoded into NullUUID with UUID %v", out.Opt.UUID)
+		}
+		// NullUUID's own MarshalJSON/UnmarshalJSON.
+		nj, err := in.Opt.MarshalJSON()
+		if err != nil || string(nj) != wantOpt {
+			fail(ht, "NullUUID.MarshalJSON = %s, %v; want %s", nj, err, wantOpt)
+		}
+		var nu uuid.NullUUID
+		if err := nu.UnmarshalJSON(nj); err != nil || nu.Valid != valid || (valid && nu.UUID != u) {
+			fail(ht, "NullUUID.UnmarshalJSON(%s) = %+v, %v", nj, nu, err)
+		}
+		// Text and binary for the UUID itself.
+		mt, _ := u.MarshalText()
+		var ut uuid.UUID
+		if err := ut.UnmarshalText(mt); err != nil || ut != u {
+			fail(ht, "UnmarshalText(MarshalText(%v)) = %v, %v", u, ut, err)
+		}
+		mb, _ := u.MarshalBinary()
+		var ub uuid.UUID
+		if err := ub.UnmarshalBinary(mb); err != nil || ub != u || !bytes.Equal(mb, u[:]) {
+			fail(ht, "UnmarshalBinary(MarshalBinary(%v)) = %v, %v (binary %x)", u, ub, err, mb)
+		}
+		if fb, err := uuid.FromBytes(mb); err != nil || fb != u {
+			fail(ht, "FromBytes(%x) = %v, %v", mb, fb, err)
+		}
+		// Text and binary for the NullUUID: the TextMarshaler/TextUnmarshaler and
+		// BinaryMarshaler/BinaryUnmarshaler pairs invert each other, for the null value too (the
+		// shape of uuid/4, checked only for a valid value under HEGEL_NO_KNOWN=1).
+		if valid || !noKnown {
+			nullShape := shapeIf(!valid, "uuid/4")
+			nt, _ := in.Opt.MarshalText()
+			var nut uuid.NullUUID
+			if err := nut.UnmarshalText(nt); err != nil || nut.Valid != valid || (valid && nut.UUID != u) {
+				mismatch(ht, nullShape, "NullUUID.UnmarshalText(MarshalText(%+v) = %q) = %+v, %v", in.Opt, nt, nut, err)
+			}
+			nb, _ := in.Opt.MarshalBinary()
+			var nub uuid.NullUUID
+			if err := nub.UnmarshalBinary(nb); err != nil || nub.Valid != valid || (valid && nub.UUID != u) {
+				mismatch(ht, nullShape, "NullUUID.UnmarshalBinary(MarshalBinary(%+v) = %x) = %+v, %v", in.Opt, nb, nub, err)
+			}
+		}
+		// database/sql: Value then Scan, into destinations that may hold the previous row.
+		v, err := u.Value()
+		if err != nil {
+			fail(ht, "Value(%v): %v", u, err)
+		}
+		us := c.dest()
+		if err := us.Scan(v); err != nil || us != u {
+			fail(ht, "Scan(Value(%v)) into %v = %v, %v", u, c.dest(), us, err)
+		}
+		ub16 := c.dest()
+		if err := ub16.Scan(u[:]); err != nil || ub16 != u {
+			fail(ht, "Scan(16 bytes of %v) into %v = %v, %v", u, c.dest(), ub16, err)
+		}
+		// A NULL from the driver (nil, or the empty string or []byte the source calls "a null
+		// UUID") resets the destination to Nil, as sql.NullString and friends assign on every Scan.
+		un := c.dest()
+		if err := un.Scan(c.null); err != nil || un != uuid.Nil {
+			mismatch(ht, shapeIf(c.dest() != uuid.Nil, "uuid/2"), "Scan(%#v) into %v = %v, %v; want Nil", c.null, c.dest(), un, err)
+		}
+		nv, err := in.Opt.Value()
+		if err != nil || (valid && nv != driver.Value(u.String())) || (!valid && nv != nil) {
+			fail(ht, "NullUUID.Value(%+v) = %v, %v", in.Opt, nv, err)
+		}
+		if !valid {
+			nv = c.null // the driver's spelling of the NULL
+		}
+		ns := uuid.NullUUID{UUID: c.dest(), Valid: c.prev != nil}
+		if err := ns.Scan(nv); err != nil || ns.Valid != valid || (valid && ns.UUID != u) || (!valid && ns.UUID != uuid.Nil) {
+			mismatch(ht, shapeIf(!valid && c.null != nil, "uuid/3"), "NullUUID.Scan(%#v) into %+v = %+v, %v", nv, uuid.NullUUID{UUID: c.dest(), Valid: c.prev != nil}, ns, err)
+		}
+		// Wrong binary lengths are rejected.
+		var bad uuid.UUID
+		if err := bad.UnmarshalBinary(make([]byte, c.badLen)); err == nil {
+			fail(ht, "UnmarshalBinary of %d bytes accepted", c.badLen)
+		}
+		if _, err := uuid.FromBytes(make([]byte, c.badLen)); err == nil {
+			fail(ht, "FromBytes of %d bytes accepted", c.badLen)
+		}
+	})
+}
+
+// TestHegelRandomVersionsSetOnlyTheirBits: NewRandomFromReader keeps 122 of the reader's bits
+// and sets the version and variant; New/NewRandom/NewString are version 4 RFC UUIDs; a short
+// reader is an error, not a panic.
+func TestHegelRandomVersionsSetOnlyTheirBits(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		rnd := hegel.Draw(ht, readerBytes)
+		u, err := uuid.NewRandomFromReader(bytes.NewReader(rnd))
+		if len(rnd) < 16 {
+			if err == nil || u != uuid.Nil {
+				fail(ht, "NewRandomFromReader(%d bytes) = %v, %v", len(rnd), u, err)
+			}
+		} else {
+			var want uuid.UUID
+			copy(want[:], rnd)
+			want[6] = want[6]&0x0f | 0x40
+			want[8] = want[8]&0x3f | 0x80
+			if err != nil || u != want {
+				fail(ht, "NewRandomFromReader(%x) = %v, %v; want %v", rnd[:16], u, err, want)
+			}
+			v7, err := uuid.NewV7FromReader(bytes.NewReader(rnd))
+			if err != nil || v7[8] != want[8] || !bytes.Equal(v7[9:], want[9:]) || v7.Version() != 7 {
+				fail(ht, "NewV7FromReader(%x) = %v, %v", rnd[:16], v7, err)
+			}
+		}
+		for _, g := range []uuid.UUID{uuid.New(), uuid.Must(uuid.NewRandom()), uuid.MustParse(uuid.NewString())} {
+			if g.Version() != 4 || g.Variant() != uuid.RFC4122 {
+				fail(ht, "random UUID %v: version %d variant %v", g, g.Version(), g.Variant())
+			}
+		}
+	})
+}
