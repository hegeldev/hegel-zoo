+// genV6Time draws an instant NewV6WithTime can represent: within Go's UnixNano range
+// (1678 ≤ t < 2262; pin /5 covers the rest); for pre-1970 instants the nanoseconds are a
+// multiple of 100 (see README, Not bugs).
+func genV6Time(tc hegel.TestCase) time.Time {
+	var t time.Time
+	switch n(tc, 0, 3) {
+	case 0: // recent
+		t = time.Unix(int64(n(tc, 0, 2_000_000_000)), int64(n(tc, 0, 999_999_999)))
+	case 1: // pre-1970, back to 1678 (Go's UnixNano range; pin /5 covers the rest)
+		t = time.Unix(-int64(n(tc, 1, 9_200_000_000)), int64(n(tc, 0, 9_999_999))*100)
+	case 2: // far future, before UnixNano overflows (2262-04-11)
+		t = time.Unix(int64(n(tc, 2_000_000_000, 9_200_000_000)), int64(n(tc, 0, 999_999_999)))
+	default: // around now
+		t = time.Now().Add(time.Duration(n(tc, -1_000_000_000, 1_000_000_000)))
+	}
+	return t.UTC()
+}
+
+// TestHegelTimeBasedLayoutsFollowTheRFC: NewUUID (v1), NewV6WithTime (v6) and NewV7FromReader
+// (v7) put the time, clock sequence, node and random bits where RFC 9562 says, Time() reads
+// them back, the clock sequence advances when the same instant is used twice, and the
+// package-level clock sequence / node accessors describe the UUIDs generated.
+func TestHegelTimeBasedLayoutsFollowTheRFC(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// Clock sequence and node under our control.
+		seq := n(ht, 0, 0x3fff)
+		if chance(ht, 20) {
+			seq |= n(ht, 0, 3) << 14 // only the low 14 bits count
+		}
+		// Setting a *changed* sequence resets the library's "last time" (a same-valued call keeps
+		// it, and a later instant left by an earlier case would then bump the sequence).
+		uuid.SetClockSequence((seq + 1) & 0x3fff)
+		uuid.SetClockSequence(seq)
+		if got := uuid.ClockSequence(); got != seq&0x3fff {
+			fail(ht, "SetClockSequence(%#x); ClockSequence() = %#x", seq, got)
+		}
+		node := make([]byte, 6+n(ht, 0, 2))
+		for i := range node {
+			node[i] = byte(n(ht, 0, 255))
+		}
+		if bytes.Equal(node[:6], make([]byte, 6)) {
+			node[5] = 1 // an all-zero node is "unset" to the library (pin /6)
+		}
+		if !uuid.SetNodeID(node) || !bytes.Equal(uuid.NodeID(), node[:6]) || uuid.NodeInterface() != "user" {
+			fail(ht, "SetNodeID(%x): NodeID() = %x, NodeInterface() = %q", node, uuid.NodeID(), uuid.NodeInterface())
+		}
+		note(ht, "seq %#x node %x", seq, node)
+
+		// Version 1.
+		before := time.Now()
+		v1, err := uuid.NewUUID()
+		after := time.Now()
+		if err != nil {
+			fail(ht, "NewUUID: %v", err)
+		}
+		if v1.Version() != 1 || v1.Variant() != uuid.RFC4122 {
+			fail(ht, "NewUUID() = %v: version %d variant %v", v1, v1.Version(), v1.Variant())
+		}
+		if int64(v1.Time()) != v1Time(v1) || int64(v1.Time()) < gregorian(before) || int64(v1.Time()) > gregorian(after) {
+			fail(ht, "NewUUID() = %v: Time() %d, layout %d, wall clock %d..%d", v1, v1.Time(), v1Time(v1), gregorian(before), gregorian(after))
+		}
+		if v1.ClockSequence() != seq&0x3fff || !bytes.Equal(v1.NodeID(), node[:6]) {
+			fail(ht, "NewUUID() = %v: ClockSequence() %#x (set %#x), NodeID() %x (set %x)", v1, v1.ClockSequence(), seq&0x3fff, v1.NodeID(), node[:6])
+		}
+
+		// Version 6 at a chosen instant, twice: same time, next clock sequence.
+		ct := genV6Time(ht)
+		note(ht, "v6 time %v", ct)
+		v6, err := uuid.NewV6WithTime(&ct)
+		if err != nil {
+			fail(ht, "NewV6WithTime(%v): %v", ct, err)
+		}
+		if v6.Version() != 6 || v6.Variant() != uuid.RFC4122 {
+			fail(ht, "NewV6WithTime(%v) = %v: version %d variant %v", ct, v6, v6.Version(), v6.Variant())
+		}
+		if int64(v6.Time()) != gregorian(ct) || int64(v6.Time()) != v6Time(v6) {
+			fail(ht, "NewV6WithTime(%v) = %v: Time() %d, want %d (layout %d)", ct, v6, v6.Time(), gregorian(ct), v6Time(v6))
+		}
+		sec, nsec := v6.Time().UnixTime()
+		if back := time.Unix(sec, nsec).UTC(); !back.Equal(ct.Truncate(100 * time.Nanosecond)) {
+			fail(ht, "NewV6WithTime(%v).Time().UnixTime() = %v", ct, back)
+		}
+		if !bytes.Equal(v6.NodeID(), node[:6]) {
+			fail(ht, "NewV6WithTime(%v) = %v: NodeID() %x, set %x", ct, v6, v6.NodeID(), node[:6])
+		}
+		v6b, _ := uuid.NewV6WithTime(&ct)
+		if v6b == v6 || v6b.Time() != v6.Time() || v6b.ClockSequence() != (v6.ClockSequence()+1)&0x3fff {
+			fail(ht, "NewV6WithTime(%v) twice: %v then %v (clock sequences %#x, %#x)", ct, v6, v6b, v6.ClockSequence(), v6b.ClockSequence())
+		}
+		// A v1 re-laid as v6 has the same Time().
+		var re uuid.UUID
+		ts := uint64(v1Time(v1))
+		binary.BigEndian.PutUint32(re[0:4], uint32(ts>>28))
+		binary.BigEndian.PutUint16(re[4:6], uint16(ts>>12))
+		binary.BigEndian.PutUint16(re[6:8], uint16(ts&0x0fff)|0x6000)
+		copy(re[8:], v1[8:])
+		if re.Time() != v1.Time() || re.ClockSequence() != v1.ClockSequence() || !bytes.Equal(re.NodeID(), v1.NodeID()) {
+			fail(ht, "v1 %v re-laid as v6 %v: Time() %d vs %d", v1, re, re.Time(), v1.Time())
+		}
+
+		// Version 7 from a reader we control: the random bits are ours, the time is the wall clock
+		// (ms), and consecutive values are strictly increasing.
+		rnd := make([]byte, 16)
+		for i := range rnd {
+			rnd[i] = byte(n(ht, 0, 255))
+		}
+		before = time.Now()
+		v7, err := uuid.NewV7FromReader(bytes.NewReader(rnd))
+		after = time.Now()
+		if err != nil {
+			fail(ht, "NewV7FromReader: %v", err)
+		}
+		if v7.Version() != 7 || v7.Variant() != uuid.RFC4122 || v7[8]&0x3f != rnd[8]&0x3f || !bytes.Equal(v7[9:], rnd[9:]) {
+			fail(ht, "NewV7FromReader(%x) = %v: version %d variant %v, rand_b not the reader's", rnd, v7, v7.Version(), v7.Variant())
+		}
+		ms := v7Millis(v7)
+		if ms < before.UnixMilli() || ms > after.UnixMilli()+1 {
+			fail(ht, "NewV7FromReader = %v: unix_ts_ms %d, wall clock %d..%d", v7, ms, before.UnixMilli(), after.UnixMilli())
+		}
+		if int64(v7.Time()) != ms*10000+g1582ns100 {
+			fail(ht, "NewV7FromReader = %v: Time() %d, want %d", v7, v7.Time(), ms*10000+g1582ns100)
+		}
+		v7b, _ := uuid.NewV7()
+		if uuid.Compare(v7, v7b) >= 0 || v7b.Time() < v7.Time() {
+			fail(ht, "consecutive v7 values not increasing: %v then %v", v7, v7b)
+		}
+	})
+}
+
+// TestHegelDCEFieldsRoundTrip: NewDCESecurity(domain, id) is a version-2 UUID whose Domain()
+// and ID() are the arguments and whose node is the current NodeID.
+func TestHegelDCEFieldsRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		d := uuid.Domain(n(ht, 0, 255))
+		id := uint32(hegel.Draw(ht, hegel.Integers[int64](0, 1<<32-1)))
+		u, err := uuid.NewDCESecurity(d, id)
+		if err != nil {
+			fail(ht, "NewDCESecurity(%v, %d): %v", d, id, err)
+		}
+		if u.Version() != 2 || u.Variant() != uuid.RFC4122 || u.Domain() != d || u.ID() != id || !bytes.Equal(u.NodeID(), uuid.NodeID()) {
+			fail(ht, "NewDCESecurity(%v, %d) = %v: version %d variant %v domain %v id %d", d, id, u, u.Version(), u.Variant(), u.Domain(), u.ID())
+		}
+		want := map[uuid.Domain]string{uuid.Person: "Person", uuid.Group: "Group", uuid.Org: "Org"}[d]
+		if want == "" {
+			want = fmt.Sprintf("Domain%d", int(d))
+		}
+		if d.String() != want {
+			fail(ht, "Domain(%d).String() = %q; want %q", int(d), d.String(), want)
+		}
+	})
+}
