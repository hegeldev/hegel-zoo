+// ---- pins ----------------------------------------------------------------------------------
+
+// uuid/1: NewV6WithTime reads and writes the shared clock state (clockSeq, lasttime) without
+// timeMu, unlike GetTime/NewUUID/NewV6; concurrent callers with the same instant get identical
+// UUIDs.  Four goroutines × 3000 calls at one instant (well under the 16384 clock sequences the
+// contract allows for one timestamp) must all be distinct; a data race makes duplicates
+// (`go test -race` reports the race on time.go:67/70).
+func TestHegelPinNewV6WithTimeIsRaceFree(t *testing.T) {
+	defer guard(t)
+	ct := time.Date(2001, 2, 3, 4, 5, 6, 700, time.UTC)
+	const G, N, rounds = 4, 3000, 8
+	for round := 0; round < rounds; round++ {
+		uuid.SetClockSequence(1)
+		res := make([][]uuid.UUID, G)
+		var wg sync.WaitGroup
+		for g := 0; g < G; g++ {
+			wg.Add(1)
+			go func(g int) {
+				defer wg.Done()
+				for i := 0; i < N; i++ {
+					u, err := uuid.NewV6WithTime(&ct)
+					if err != nil {
+						panic(err)
+					}
+					res[g] = append(res[g], u)
+				}
+			}(g)
+		}
+		wg.Wait()
+		seen := map[uuid.UUID]int{}
+		dups := 0
+		for _, r := range res {
+			for _, u := range r {
+				seen[u]++
+				if seen[u] == 2 {
+					dups++
+				}
+			}
+		}
+		if dups > 0 {
+			t.Fatalf("round %d: %d goroutines × %d NewV6WithTime(%v) calls: %d distinct UUIDs, %d duplicated", round, G, N, ct, len(seen), dups)
+		}
+	}
+}
+
+// uuid/2: UUID.Scan of a NULL, an empty string or an empty []byte leaves the previous value in
+// the destination (the source comments say "we return a null UUID").
+func TestHegelPinScanOfNullResetsTheValue(t *testing.T) {
+	defer guard(t)
+	for _, src := range []any{nil, "", []byte{}} {
+		u := uuid.MustParse("12345678-abcd-1234-abcd-0123456789ab")
+		if err := u.Scan(src); err != nil {
+			t.Fatalf("Scan(%#v): %v", src, err)
+		}
+		if u != uuid.Nil {
+			t.Fatalf("Scan(%#v) left the previous value %v in place; want the Nil UUID", src, u)
+		}
+	}
+}
+
+// uuid/3: NullUUID.Scan("") reports Valid = true (with the Nil UUID, or a stale one) although
+// UUID.Scan treats the empty string as a NULL and Scan(nil) gives Valid = false.
+func TestHegelPinNullUUIDScanOfEmptyStringIsNull(t *testing.T) {
+	defer guard(t)
+	for _, src := range []any{"", []byte{}} {
+		var nu uuid.NullUUID
+		if err := nu.Scan(src); err != nil {
+			t.Fatalf("NullUUID.Scan(%#v): %v", src, err)
+		}
+		if nu.Valid {
+			t.Fatalf("NullUUID.Scan(%#v) = %+v; want Valid = false as for Scan(nil)", src, nu)
+		}
+	}
+}
+
+// uuid/4: the null NullUUID marshals to the text "null" and to an empty binary, and neither
+// decodes: UnmarshalText("null") and UnmarshalBinary(nil) are errors, so a JSON object keyed by
+// NullUUID (map keys use the text form) does not round-trip.
+func TestHegelPinNullUUIDNullTextAndBinaryRoundTrip(t *testing.T) {
+	defer guard(t)
+	var null uuid.NullUUID
+	txt, err := null.MarshalText()
+	if err != nil {
+		t.Fatalf("MarshalText: %v", err)
+	}
+	var back uuid.NullUUID
+	if err := back.UnmarshalText(txt); err != nil || back != null {
+		t.Fatalf("UnmarshalText(MarshalText(null) = %q) = %+v, %v", txt, back, err)
+	}
+	bin, err := null.MarshalBinary()
+	if err != nil {
+		t.Fatalf("MarshalBinary: %v", err)
+	}
+	if err := back.UnmarshalBinary(bin); err != nil || back != null {
+		t.Fatalf("UnmarshalBinary(MarshalBinary(null) = %x) = %+v, %v", bin, back, err)
+	}
+}
+
+// uuid/5: NewV6WithTime accepts instants the 60-bit Gregorian timestamp cannot hold (before
+// 1582-10-15) and instants Go's UnixNano cannot hold (before 1678-09-21 or after 2262-04-11,
+// although the RFC timestamp reaches 5236) and returns a UUID with a garbage timestamp
+// (1500-01-01 reads back as 2084-07-20, 1600-01-01 as 2184-07-20, 2300-01-01 as 1715-06-13)
+// instead of an error.
+func TestHegelPinNewV6WithTimeRejectsUnrepresentableInstants(t *testing.T) {
+	defer guard(t)
+	for _, y := range []int{1500, 1600, 2300} {
+		at := time.Date(y, 1, 1, 0, 0, 0, 0, time.UTC)
+		u, err := uuid.NewV6WithTime(&at)
+		if err != nil {
+			continue // an error is the acceptable outcome
+		}
+		sec, nsec := u.Time().UnixTime()
+		if back := time.Unix(sec, nsec).UTC(); !back.Equal(at) {
+			t.Fatalf("NewV6WithTime(%v) = %v with no error; Time() reads back as %v", at, u, back)
+		}
+	}
+}
+
+// uuid/6: SetNodeID of six zero bytes returns true but the zero node is the library's "not set"
+// sentinel: NodeID() and the next NewUUID/NewV6 replace it with the hardware address (or random
+// bits), so the caller's node is silently discarded.
+func TestHegelPinSetNodeIDAcceptsTheZeroNode(t *testing.T) {
+	defer guard(t)
+	zero := make([]byte, 6)
+	if !uuid.SetNodeID(zero) {
+		t.Fatalf("SetNodeID(%x) = false", zero)
+	}
+	got := uuid.NodeID()
+	u, err := uuid.NewUUID()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, zero) || !bytes.Equal(u.NodeID(), zero) {
+		t.Fatalf("after SetNodeID(%x): NodeID() = %x, NewUUID().NodeID() = %x (interface %q)", zero, got, u.NodeID(), uuid.NodeInterface())
+	}
+}
