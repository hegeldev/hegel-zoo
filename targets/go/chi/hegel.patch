new file mode 100644
index 0000000..78653bd
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,164 @@
+package hegel
+
+// Hegel property tests for go-chi/chi, written for the Hegel zoo. See targets/go/chi/README.md.
+//
+// Oracle: a model of the documented routing rules (chi.go's "URL patterns", the Router and
+// Context documentation, the middleware package's doc comments and the RFCs they cite) built
+// from the same route table; the router must agree with it on the matched pattern, the URL
+// parameters and the status of every request.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func drawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return drawInt(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The model reproduces a behaviour while its switch is
+// on; the pins assert the documented behaviour and fail while the bug exists.
+var Known = struct {
+	regexpAlternation           bool // 1: a regexp param is anchored around the whole source, so `a|b` matches "ab"
+	regexpCrossesSlash          bool // 2: a regexp param with a non-slash tail matches across a slash
+	emptyRegexpFallback         bool // 3: an empty regexp value is tried only on the last regexp node, unchecked
+	headerRouteMapOrder         bool // 4: RouteHeaders picks among headers in map order
+	regexpOrderQuirk            bool // 5: only the last '/'-tail regexp node is moved after the others
+	unknownMethod405            bool // 6: an unknown method gets 405 without Allow, whatever the path
+	rawParamValues              bool // 7: param values are decoded only when the path has no non-canonical escape
+	patternTrailingSlashTrimmed bool // 8: RoutePattern drops the trailing slash of a route
+	mountStubMatches            bool // 9: Match/Find accept the bare mount path for every method
+	encodingListUnsplit         bool // 10: AllowContentEncoding reads a comma list as one coding
+	charsetSubstring            bool // 11: ContentCharset finds the charset by substring
+	acceptEncodingSubstring     bool // 12: Compress matches Accept-Encoding by substring (q=0, * ignored)
+	contentTypeExact            bool // 13: Compress compares the media type case-sensitively, no OWS
+	headerPatternCase           bool // 14: RouteHeaders lowercases the value but not the pattern
+	deprecationHTTPDate         bool // 15: Deprecation header as an HTTP-date, not RFC 9745's @seconds
+	realIPUntrimmed             bool // 16: RealIP does not trim the first X-Forwarded-For entry
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&Known).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
