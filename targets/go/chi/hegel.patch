+package hegel
+
+// The middleware package against models of its documentation and the RFCs it cites: client IP
+// extraction, request content checks, response compression and header routing.
+
+import (
+	"bytes"
+	"compress/flate"
+	"compress/gzip"
+	"fmt"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/go-chi/chi/v5/middleware"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- client IP
+
+var ipEntries = []string{
+	"1.2.3.4", "10.0.0.1", "10.1.2.3", "192.168.0.9", "8.8.8.8", "203.0.113.7",
+	"2001:db8::1", "::1", "fe80::1%eth0", "::ffff:10.0.0.1", "::ffff:1.2.3.4", "2001:db8::/32",
+	"garbage", "1.2.3", "[::1]:80", "1.2.3.4:80", "", "unknown",
+}
+
+var trustedPrefixes = []string{"10.0.0.0/8", "192.168.0.0/16", "2001:db8::/32", "203.0.113.0/24"}
+
+func genXFF(tc hegel.TestCase) []string {
+	var headers []string
+	for n := drawInt(tc, 1, 3); n > 0; n-- {
+		var parts []string
+		for k := drawInt(tc, 0, 4); k > 0; k-- {
+			e := pick(tc, ipEntries)
+			if chance(tc, 30) {
+				e = " " + e
+			}
+			if chance(tc, 30) {
+				e += " "
+			}
+			parts = append(parts, e)
+		}
+		headers = append(headers, strings.Join(parts, ","))
+	}
+	return headers
+}
+
+// walkXFF visits the entries right to left, as documented: the last header first, trimmed,
+// empty entries skipped; visit returns true to stop.
+func walkXFF(headers []string, visit func(string) bool) {
+	for i := len(headers) - 1; i >= 0; i-- {
+		parts := strings.Split(headers[i], ",")
+		for j := len(parts) - 1; j >= 0; j-- {
+			v := strings.TrimSpace(parts[j])
+			if v == "" {
+				continue
+			}
+			if visit(v) {
+				return
+			}
+		}
+	}
+}
+
+func parseHeaderAddr(s string) (netip.Addr, bool) {
+	ip, err := netip.ParseAddr(s)
+	if err != nil {
+		return netip.Addr{}, false
+	}
+	return ip.Unmap().WithZone(""), true
+}
+
+func modelXFF(headers []string, prefixes []netip.Prefix) string {
+	var found netip.Addr
+	walkXFF(headers, func(v string) bool {
+		ip, ok := parseHeaderAddr(v)
+		if !ok {
+			return true
+		}
+		for _, p := range prefixes {
+			if p.Contains(ip) {
+				return false
+			}
+		}
+		found = ip
+		return true
+	})
+	if !found.IsValid() {
+		return ""
+	}
+	return found.String()
+}
+
+func modelTrusted(headers []string, n int) string {
+	var entry string
+	walkXFF(headers, func(v string) bool {
+		n--
+		if n == 0 {
+			entry = v
+			return true
+		}
+		return false
+	})
+	if entry == "" {
+		return ""
+	}
+	if ip, ok := parseHeaderAddr(entry); ok {
+		return ip.String()
+	}
+	return ""
+}
+
+func modelRealIP(h http.Header, remote string) string {
+	var ip string
+	if v := h.Get("True-Client-IP"); v != "" {
+		ip = v
+	} else if v := h.Get("X-Real-IP"); v != "" {
+		ip = v
+	} else if v := h.Get("X-Forwarded-For"); v != "" {
+		ip, _, _ = strings.Cut(v, ",")
+		if !Known.realIPUntrimmed { // part 2 replaces this: the property still follows the recorded bugs
+			ip = strings.TrimSpace(ip)
+		}
+	}
+	if ip == "" || net.ParseIP(ip) == nil {
+		return remote
+	}
+	return ip
+}
+
+func TestHegelClientIP(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		headers := genXFF(ht)
+		req := httptest.NewRequest("GET", "http://x/", nil)
+		for _, h := range headers {
+			req.Header.Add("X-Forwarded-For", h)
+		}
+		var got string
+		record := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { got = middleware.GetClientIP(r.Context()) })
+		switch drawInt(ht, 0, 4) {
+		case 0, 1:
+			var names []string
+			var prefixes []netip.Prefix
+			for k := drawInt(ht, 0, 3); k > 0; k-- {
+				n := pick(ht, trustedPrefixes)
+				names = append(names, n)
+				prefixes = append(prefixes, netip.MustParsePrefix(n))
+			}
+			middleware.ClientIPFromXFF(names...)(record).ServeHTTP(httptest.NewRecorder(), req)
+			want := modelXFF(headers, prefixes)
+			if got != want {
+				c.failClass(ht, "FromXFF", "ClientIPFromXFF(%v) with %q = %q, want %q", names, headers, got, want)
+				return
+			}
+			c.count("FromXFF " + strconv.FormatBool(got != ""))
+		case 2:
+			n := drawInt(ht, 1, 4)
+			middleware.ClientIPFromXFFTrustedProxies(n)(record).ServeHTTP(httptest.NewRecorder(), req)
+			want := modelTrusted(headers, n)
+			if got != want {
+				c.failClass(ht, "TrustedProxies", "ClientIPFromXFFTrustedProxies(%d) with %q = %q, want %q", n, headers, got, want)
+				return
+			}
+			c.count("TrustedProxies " + strconv.FormatBool(got != ""))
+		case 3:
+			// a single-IP header: the last value wins, folded and unzoned
+			var vals []string
+			for k := drawInt(ht, 0, 3); k > 0; k-- {
+				vals = append(vals, pick(ht, ipEntries))
+				req.Header.Add("X-Real-IP", vals[len(vals)-1])
+			}
+			middleware.ClientIPFromHeader("x-real-ip")(record).ServeHTTP(httptest.NewRecorder(), req)
+			want := ""
+			if len(vals) > 0 {
+				if ip, ok := parseHeaderAddr(vals[len(vals)-1]); ok {
+					want = ip.String()
+				}
+			}
+			if got != want {
+				c.failClass(ht, "FromHeader", "ClientIPFromHeader with %q = %q, want %q", vals, got, want)
+				return
+			}
+			c.count("FromHeader " + strconv.FormatBool(got != ""))
+		case 4:
+			remote := pick(ht, []string{"1.2.3.4:5", "[::ffff:1.2.3.4]:80", "[fe80::1%eth0]:1", "8.8.8.8", "garbage", "::1"})
+			req.RemoteAddr = remote
+			middleware.ClientIPFromRemoteAddr(record).ServeHTTP(httptest.NewRecorder(), req)
+			host, _, err := net.SplitHostPort(remote)
+			if err != nil {
+				host = remote
+			}
+			want := ""
+			if ip, err := netip.ParseAddr(host); err == nil {
+				want = ip.Unmap().String()
+			}
+			if got != want {
+				c.failClass(ht, "RemoteAddr", "ClientIPFromRemoteAddr with %q = %q, want %q", remote, got, want)
+				return
+			}
+			c.count("RemoteAddr " + strconv.FormatBool(got != ""))
+		}
+		// RealIP (deprecated, still shipped): True-Client-IP, X-Real-IP, then the first
+		// X-Forwarded-For entry, when it parses
+		req2 := httptest.NewRequest("GET", "http://x/", nil)
+		if chance(ht, 30) {
+			req2.Header.Set("True-Client-IP", pick(ht, ipEntries))
+		}
+		if chance(ht, 30) {
+			req2.Header.Set("X-Real-IP", pick(ht, ipEntries))
+		}
+		req2.Header.Set("X-Forwarded-For", headers[0])
+		want := modelRealIP(req2.Header, req2.RemoteAddr)
+		var remote string
+		middleware.RealIP(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { remote = r.RemoteAddr })).ServeHTTP(httptest.NewRecorder(), req2)
+		if remote != want {
+			c.failClass(ht, "RealIP", "RealIP with %v = %q, want %q", req2.Header, remote, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- request content checks
+
+var codings = []string{"gzip", "br", "deflate", "identity", "zstd", "GZIP", "x-gzip"}
+
+var charsetSpellings = []string{"utf-8", "UTF-8", "iso-8859-1", "us-ascii", "latin1"}
+
+// genContentType draws a parseable media type with parameters, the charset among them or not.
+func genContentType(tc hegel.TestCase) (ct string, charset string) {
+	ct = pick(tc, []string{"text/plain", "application/json", "Text/HTML", "application/x-www-form-urlencoded"})
+	var params []string
+	if chance(tc, 40) {
+		params = append(params, pick(tc, []string{"boundary=abc", "q=1", "version=2"}))
+	}
+	if chance(tc, 75) {
+		charset = pick(tc, charsetSpellings)
+		v := charset
+		if Known.charsetSubstring { // part 2 replaces this: the property still follows the recorded bugs
+			// the substring parser reads a quoted value with its quotes and cuts at "charset="
+			// wherever it appears; the generator stays with plain values
+		} else if chance(tc, 30) {
+			v = `"` + v + `"`
+		}
+		params = append(params, "charset="+v)
+	}
+	if chance(tc, 30) {
+		params = append(params, "x=y")
+	}
+	for _, p := range params {
+		sep := pick(tc, []string{";", "; ", " ; ", ";  "})
+		if Known.charsetSubstring && strings.HasPrefix(p, "charset=") { // part 2 replaces this: the property still follows the recorded bugs
+			sep = pick(tc, []string{";", "; "})
+		}
+		ct += sep + p
+	}
+	return ct, strings.ToLower(charset)
+}
+
+func TestHegelContentChecks(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		body := ""
+		if chance(ht, 80) {
+			body = "body"
+		}
+		ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200) })
+		if chance(ht, 50) {
+			// AllowContentEncoding: every coding of the request must be allowed
+			var allowed []string
+			for k := drawInt(ht, 0, 3); k > 0; k-- {
+				allowed = append(allowed, pick(ht, codings))
+			}
+			req := httptest.NewRequest("POST", "http://x/", strings.NewReader(body))
+			var reqCodings []string
+			for k := drawInt(ht, 0, 2); k > 0; k-- {
+				var list []string
+				for j := drawInt(ht, 1, 2); j > 0; j-- {
+					list = append(list, pick(ht, codings))
+				}
+				if Known.encodingListUnsplit { // part 2 replaces this: the property still follows the recorded bugs
+					list = list[:1]
+				}
+				v := strings.Join(list, pick(ht, []string{",", ", "}))
+				req.Header.Add("Content-Encoding", v)
+				reqCodings = append(reqCodings, list...)
+			}
+			want := 200
+			if body != "" {
+				for _, e := range reqCodings {
+					found := false
+					for _, a := range allowed {
+						if strings.EqualFold(strings.TrimSpace(a), strings.TrimSpace(e)) {
+							found = true
+						}
+					}
+					if !found {
+						want = 415
+					}
+				}
+			}
+			rec := httptest.NewRecorder()
+			middleware.AllowContentEncoding(allowed...)(ok).ServeHTTP(rec, req)
+			if rec.Code != want {
+				c.failClass(ht, "Encoding", "AllowContentEncoding(%v) with Content-Encoding %v (body %q) = %d, want %d", allowed, req.Header["Content-Encoding"], body, rec.Code, want)
+				return
+			}
+			c.count(fmt.Sprint("encoding ", want))
+			return
+		}
+		// ContentCharset: the charset parameter of Content-Type must be one of the list
+		var charsets []string
+		for k := drawInt(ht, 0, 3); k > 0; k-- {
+			charsets = append(charsets, pick(ht, append(charsetSpellings, "")))
+		}
+		ct, charset := genContentType(ht)
+		req := httptest.NewRequest("POST", "http://x/", strings.NewReader(body))
+		if chance(ht, 90) {
+			req.Header.Set("Content-Type", ct)
+		} else {
+			ct, charset = "", ""
+		}
+		want := 200
+		if body != "" {
+			want = 415
+			if ct != "" {
+				if _, params, err := mime.ParseMediaType(ct); err == nil {
+					charset = strings.ToLower(params["charset"])
+				}
+			}
+			for _, cs := range charsets {
+				if strings.ToLower(cs) == charset {
+					want = 200
+				}
+			}
+		}
+		rec := httptest.NewRecorder()
+		middleware.ContentCharset(append([]string(nil), charsets...)...)(ok).ServeHTTP(rec, req)
+		if rec.Code != want {
+			c.failClass(ht, "Charset", "ContentCharset(%q) with Content-Type %q (body %q) = %d, want %d", charsets, ct, body, rec.Code, want)
+			return
+		}
+		c.count(fmt.Sprint("charset ", want))
+	})
+}
+
+// --------------------------------------------------------------------------- Compress
+
+var compressibleTypes = []string{"text/html", "text/css", "text/plain", "text/javascript", "text/markdown", "text/csv", "text/vtt", "application/javascript", "application/x-javascript", "application/json", "application/atom+xml", "application/rss+xml", "application/xml", "text/xml", "image/svg+xml"}
+
+var responseTypes = []string{"text/html", "text/html; charset=utf-8", "text/html ; charset=utf-8", "Text/HTML", "application/json", "APPLICATION/JSON", "image/png", "application/octet-stream", "text/plain;charset=us-ascii", "image/svg+xml", "text/html;"}
+
+func genAcceptEncoding(tc hegel.TestCase) string {
+	var parts []string
+	for k := drawInt(tc, 0, 3); k > 0; k-- {
+		e := pick(tc, []string{"gzip", "deflate", "br", "identity", "*", "x-gzip", "GZIP", "zstd", "Deflate"})
+		if chance(tc, 40) {
+			e += pick(tc, []string{";q=0", ";q=0.5", ";q=1", ";q=0.0", "; q=0", ";q=1.0"})
+		}
+		if chance(tc, 30) {
+			e = " " + e
+		}
+		parts = append(parts, e)
+	}
+	return strings.Join(parts, ",")
+}
+
+// acceptable is RFC 9110 12.5.3: the coding listed with a non-zero weight, or "*" with a
+// non-zero weight when the coding is not listed.
+func acceptable(header, coding string) bool {
+	star := false
+	listed := false
+	accept := false
+	for _, e := range strings.Split(header, ",") {
+		tok, params, _ := strings.Cut(e, ";")
+		tok = strings.ToLower(strings.TrimSpace(tok))
+		q := 1.0
+		for _, p := range strings.Split(params, ";") {
+			k, v, ok := strings.Cut(strings.TrimSpace(p), "=")
+			if ok && strings.EqualFold(strings.TrimSpace(k), "q") {
+				if f, err := strconv.ParseFloat(strings.TrimSpace(v), 64); err == nil {
+					q = f
+				}
+			}
+		}
+		if tok == coding || (coding == "gzip" && tok == "x-gzip") {
+			listed = true
+			if q > 0 {
+				accept = true
+			}
+		}
+		if tok == "*" && q > 0 {
+			star = true
+		}
+	}
+	if listed {
+		return accept
+	}
+	return star
+}
+
+func modelEncoding(header string) string {
+	for _, name := range []string{"gzip", "deflate"} {
+		if Known.acceptEncodingSubstring { // part 2 replaces this: the property still follows the recorded bugs
+			for _, v := range strings.Split(strings.ToLower(header), ",") {
+				if strings.Contains(v, name) {
+					return name
+				}
+			}
+			continue
+		}
+		if acceptable(header, name) {
+			return name
+		}
+	}
+	return ""
+}
+
+func modelCompressible(ct string) bool {
+	if Known.contentTypeExact { // part 2 replaces this: the property still follows the recorded bugs
+		ct, _, _ = strings.Cut(ct, ";")
+	} else {
+		mt, _, err := mime.ParseMediaType(ct)
+		if err != nil {
+			return false
+		}
+		ct = mt
+	}
+	for _, t := range compressibleTypes {
+		if t == ct {
+			return true
+		}
+	}
+	return false
+}
+
+func TestHegelCompress(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		ae := genAcceptEncoding(ht)
+		ct := pick(ht, responseTypes)
+		body := strings.Repeat(randText(ht, 3, 8, "abc "), 40)
+		h := middleware.Compress(5)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", ct)
+			w.Write([]byte(body))
+		}))
+		req := httptest.NewRequest("GET", "http://x/", nil)
+		req.Header.Set("Accept-Encoding", ae)
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		want := ""
+		if modelCompressible(ct) {
+			want = modelEncoding(ae)
+		}
+		got := rec.Header().Get("Content-Encoding")
+		if got != want {
+			c.failClass(ht, "Encoding", "Compress with Accept-Encoding %q, Content-Type %q: Content-Encoding %q, want %q", ae, ct, got, want)
+			return
+		}
+		var decoded []byte
+		var err error
+		switch got {
+		case "gzip":
+			var zr *gzip.Reader
+			zr, err = gzip.NewReader(bytes.NewReader(rec.Body.Bytes()))
+			if err == nil {
+				decoded, err = io.ReadAll(zr)
+			}
+		case "deflate":
+			decoded, err = io.ReadAll(flate.NewReader(bytes.NewReader(rec.Body.Bytes())))
+		default:
+			decoded = rec.Body.Bytes()
+		}
+		if err != nil || string(decoded) != body {
+			c.failClass(ht, "Body", "Compress(%q) body does not decode: %v", got, err)
+			return
+		}
+		if got != "" && rec.Header().Get("Vary") != "Accept-Encoding" {
+			c.failClass(ht, "Vary", "Compress(%q): Vary = %q", got, rec.Header().Get("Vary"))
+			return
+		}
+		if got == "" {
+			c.count("not compressed")
+		} else {
+			c.count(got)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- RouteHeaders
+
+type headerRoute struct {
+	header, pattern, tag string
+}
+
+func tagMiddleware(tag string) func(http.Handler) http.Handler {
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte(tag)) })
+	}
+}
+
+// matchPattern is the documented "*" wildcard: the text before the first star is a prefix, the
+// text after it a suffix.
+func matchPattern(pattern, v string) bool {
+	if !Known.headerPatternCase { // part 2 replaces this: the property still follows the recorded bugs
+		pattern = strings.ToLower(pattern)
+	}
+	prefix, suffix, wild := strings.Cut(pattern, "*")
+	if !wild {
+		return prefix == v
+	}
+	return len(v) >= len(prefix)+len(suffix) && strings.HasPrefix(v, prefix) && strings.HasSuffix(v, suffix)
+}
+
+func TestHegelRouteHeaders(t *testing.T) {
+	c := newCollector(t)
+	patterns := []string{"a", "a*", "*b", "*", "a*b", "ab", "x*b*"}
+	values := []string{"a", "ab", "b", "axb", "A", "AB", "", "xbb", "c"}
+	if !Known.headerPatternCase { // part 2 replaces this: the property still follows the recorded bugs
+		patterns = append(patterns, "A", "A*")
+	}
+	property(t, func(ht *hegel.T) {
+		var routes []headerRoute
+		hr := middleware.RouteHeaders()
+		names := []string{"X-A", "X-B"}
+		for k := drawInt(ht, 1, 4); k > 0; k-- {
+			r := headerRoute{header: pick(ht, names), pattern: pick(ht, patterns), tag: fmt.Sprint("h", len(routes))}
+			routes = append(routes, r)
+			if chance(ht, 80) {
+				hr = hr.Route(r.header, r.pattern, tagMiddleware(r.tag))
+			} else {
+				hr = hr.RouteAny(r.header, []string{r.pattern, "zzz"}, tagMiddleware(r.tag))
+			}
+		}
+		def := ""
+		if chance(ht, 40) {
+			def = "default"
+			hr = hr.RouteDefault(tagMiddleware(def))
+		}
+		req := httptest.NewRequest("GET", "http://x/", nil)
+		sent := map[string]string{}
+		for _, n := range names {
+			if chance(ht, 70) {
+				v := pick(ht, values)
+				sent[n] = v
+				if v != "" {
+					req.Header.Set(n, v)
+				}
+			}
+		}
+		// the outcome per header that carries a matching route, in registration order
+		var outcomes []string
+		seen := map[string]bool{}
+		for _, r := range routes {
+			if seen[r.header] {
+				continue
+			}
+			seen[r.header] = true
+			v := strings.ToLower(sent[r.header])
+			if v == "" {
+				continue
+			}
+			for _, rr := range routes {
+				if rr.header == r.header && matchPattern(rr.pattern, v) {
+					outcomes = append(outcomes, rr.tag)
+					break
+				}
+			}
+		}
+		if len(outcomes) == 0 {
+			if def != "" {
+				outcomes = []string{def}
+			} else {
+				outcomes = []string{"next"}
+			}
+		}
+		rec := httptest.NewRecorder()
+		hr.Handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("next")) })).ServeHTTP(rec, req)
+		got := rec.Body.String()
+		okSet := Known.headerRouteMapOrder // part 2 replaces this: the property still follows the recorded bugs
+		if !okSet {
+			outcomes = outcomes[:1]
+		}
+		found := false
+		for _, o := range outcomes {
+			if o == got {
+				found = true
+			}
+		}
+		if !found {
+			c.failClass(ht, "Route", "RouteHeaders %v default %q with headers %v -> %q, want one of %v", routes, def, sent, got, outcomes)
+			return
+		}
+		switch {
+		case len(outcomes) > 1:
+			c.count("either header")
+		case got == "next":
+			c.count("no match")
+		default:
+			c.count("routed")
+		}
+	})
+}
diff --git a/hegel/hegel_idioms_test.go b/hegel/hegel_idioms_test.go
new file mode 100644
index 0000000..8ec0e43
--- /dev/null
+++ b/hegel/hegel_idioms_test.go
@@ -0,0 +1,249 @@
+package hegel
+
+// The generator idioms the properties share, copied from the go/excelize, go/graphql-go,
+// go/cobra, go/cascadia, go/carbon and go/orb harness (hegel_idioms_test.go there; go/bubbles'
+// internal/zootest/gen.go before it) with the hz prefix: hegel-go has no weighted choice,
+// biased coin, tuple or counted-list combinator. Every generator built from them is a
+// package-level value; the simplest alternative comes first so that shrinking lands on it,
+// except the shape of a recorded bug a wide property must reach every run, which goes first
+// at a solid weight and is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a
+// weighted choice drawn alone comes out exact (the engine enumerates a small die), but inside
+// a case with other draws the engine favours the first alternative (excelize measured the
+// first of a 2:18:10 choice drawn 40% of the time when another draw precedes or follows it,
+// 7% alone), so the rates are what the collector (HEGEL_COLLECT=1) measures; weightedOver and
+// evenInts are the tuned forms of a table and a range (hegel_routes_test.go explains the
+// tuning).
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
diff --git a/hegel/hegel_model_test.go b/hegel/hegel_model_test.go
new file mode 100644
index 0000000..ed754fe
--- /dev/null
+++ b/hegel/hegel_model_test.go
@@ -0,0 +1,597 @@
+package hegel
+
+// The routing model: a matcher written from the documented rules (chi.go "URL patterns", the
+// Mux, Context and middleware documentation) over the same route table, with the recorded
+// bugs behind the switches of a known value (hegel_test.go): with every switch off the model
+// states the documented behaviour; with a switch on it reproduces the library's rule for that
+// bug as a replica of its code (tree.go: patNextSegment, findRoute, tailSort; mux.go:
+// routeHTTP, Mount, Find; context.go: RoutePattern; middleware/get_head.go, clean_path.go,
+// strip.go). routeExpected states every value the routing property checks for a case and a
+// switch set; the classifier (shapeBy, hegel_test.go) runs it per switch to name the shape of
+// a case before the library is called. The precedence of the README's "Modelled as recorded"
+// list stays: static, then regexp, then param, then catch-all children, with backtracking; a
+// 405 remembered from any leaf reached with the whole path; a middle {name} may be empty but
+// not one at the end; a pattern registered twice replaces the handler; Handle sets every
+// known method.
+
+import (
+	"net/url"
+	"path"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+// --------------------------------------------------------------------------- the model tree
+
+type mend struct {
+	pattern string
+	keys    []string
+	name    string
+	mount   *mtree // the sub-router of a mount endpoint
+	wild    bool   // the mount's "P/*" endpoint (the two stubs P and P/ are not)
+}
+
+type mnode struct {
+	kind   segKind
+	tail   byte
+	rexSrc string
+	re     *regexp.Regexp
+	static map[byte]*mnode
+	rex    []*mnode
+	par    []*mnode
+	all    *mnode
+	ends   map[string]*mend
+}
+
+type mtree struct {
+	root *mnode
+	k    known
+}
+
+func newNode(kind segKind) *mnode { return &mnode{kind: kind, static: map[byte]*mnode{}} }
+
+func newTree(k known) *mtree { return &mtree{root: newNode(segStatic), k: k} }
+
+// addGroup appends a param node to its group in the order the tree keeps them. Documented:
+// every node with a suffix (a tail other than '/') before every node ending its segment, as
+// registered within each (a stable sort; the README's "a placeholder followed by a suffix
+// before one ending its segment"). Under kRegexpOrderQuirk the replica of nodes.tailSort
+// (tree.go), run after every insertion as nodes.Sort does: the last node whose tail is '/' is
+// swapped with the last node of the group, and only that one (chi/5).
+func addGroup(group []*mnode, c *mnode, quirk bool) []*mnode {
+	group = append(group, c)
+	if quirk {
+		for i := len(group) - 1; i >= 0; i-- {
+			if group[i].tail == '/' {
+				group[i], group[len(group)-1] = group[len(group)-1], group[i]
+				break
+			}
+		}
+		return group
+	}
+	sort.SliceStable(group, func(i, j int) bool { return group[i].tail != '/' && group[j].tail == '/' })
+	return group
+}
+
+// compileRex compiles a placeholder's regexp source. Documented: the whole value must match
+// the source, `^(?:src)$` (a source's own anchors dropped first). Under kRegexpAlternation
+// the replica of patNextSegment's anchoring (tree.go): "^" prepended when the source does not
+// begin with one, "$" appended when it does not end with one, so a top-level alternation
+// `a|bc` becomes `^a|bc$`, "begins with a" or "ends with bc" (chi/1). The compiled regexps
+// are cached by source and rule (the model is built per switch set).
+func compileRex(src string, chiAnchored bool) *regexp.Regexp {
+	key := src
+	if chiAnchored {
+		key = "chi:" + src
+	}
+	if re, ok := rexCache.Load(key); ok {
+		return re.(*regexp.Regexp)
+	}
+	var re *regexp.Regexp
+	if chiAnchored {
+		rexpat := src
+		if rexpat[0] != '^' {
+			rexpat = "^" + rexpat
+		}
+		if rexpat[len(rexpat)-1] != '$' {
+			rexpat += "$"
+		}
+		re = regexp.MustCompile(rexpat)
+	} else {
+		re = regexp.MustCompile("^(?:" + strings.TrimSuffix(strings.TrimPrefix(src, "^"), "$") + ")$")
+	}
+	rexCache.Store(key, re)
+	return re
+}
+
+var rexCache sync.Map
+
+func (t *mtree) insert(method string, segs []seg, e *mend) {
+	n := t.root
+	for i, s := range segs {
+		switch s.kind {
+		case segStatic:
+			for j := 0; j < len(s.text); j++ {
+				c := n.static[s.text[j]]
+				if c == nil {
+					c = newNode(segStatic)
+					n.static[s.text[j]] = c
+				}
+				n = c
+			}
+		case segParam:
+			tail := tailOf(segs, i)
+			var c *mnode
+			for _, x := range n.par {
+				if x.tail == tail {
+					c = x
+				}
+			}
+			if c == nil {
+				c = newNode(segParam)
+				c.tail = tail
+				n.par = addGroup(n.par, c, t.k[kRegexpOrderQuirk])
+			}
+			n = c
+		case segRegexp:
+			tail := tailOf(segs, i)
+			var c *mnode
+			for _, x := range n.rex {
+				if x.tail == tail && x.rexSrc == s.rex {
+					c = x
+				}
+			}
+			if c == nil {
+				c = newNode(segRegexp)
+				c.tail = tail
+				c.rexSrc = s.rex
+				c.re = compileRex(s.rex, t.k[kRegexpAlternation])
+				n.rex = addGroup(n.rex, c, t.k[kRegexpOrderQuirk])
+			}
+			n = c
+		case segCatchAll:
+			if n.all == nil {
+				n.all = newNode(segCatchAll)
+			}
+			n = n.all
+		}
+	}
+	if n.ends == nil {
+		n.ends = map[string]*mend{}
+	}
+	if method == "ALL" {
+		for _, m := range allMethods {
+			n.ends[m] = e
+		}
+	} else {
+		n.ends[method] = e
+	}
+}
+
+func keysOf(segs []seg) []string {
+	keys := []string{}
+	for _, s := range segs {
+		if s.kind != segStatic {
+			keys = append(keys, s.key)
+		}
+	}
+	return keys
+}
+
+// mstate is what a search leaves behind besides its result.
+type mstate struct {
+	notAllowed bool
+	allowed    []string
+	values     []string
+}
+
+func (st *mstate) allow(ends map[string]*mend) {
+	for m := range ends {
+		dup := false
+		for _, a := range st.allowed {
+			if a == m {
+				dup = true
+			}
+		}
+		if !dup {
+			st.allowed = append(st.allowed, m)
+		}
+	}
+	st.notAllowed = true
+}
+
+type mres struct {
+	end    *mend
+	values []string
+}
+
+func (t *mtree) search(method, p string) (*mres, *mstate) {
+	st := &mstate{}
+	return t.find(t.root, method, p, st), st
+}
+
+// step enters child c with value v (when hasV), checks for an endpoint when the path is
+// exhausted, and searches on.
+func (t *mtree) step(c *mnode, method, rest string, v string, hasV bool, st *mstate) *mres {
+	if hasV {
+		st.values = append(st.values, v)
+	}
+	if rest == "" && c.ends != nil {
+		if e := c.ends[method]; e != nil {
+			return &mres{end: e, values: append([]string(nil), st.values...)}
+		}
+		st.allow(c.ends)
+	}
+	if r := t.find(c, method, rest, st); r != nil {
+		return r
+	}
+	if hasV {
+		st.values = st.values[:len(st.values)-1]
+	}
+	return nil
+}
+
+// find tries the children in the tree's order: static, regexp, param, catch-all; within a
+// group as addGroup ordered them. A regexp value is the text up to the first tail byte (to
+// the end for a tail of '/').
+//
+// Documented: an empty value is matched like any other, exactly when the regexp accepts the
+// empty string; a value holding a slash is never matched ("/ will never be matched", chi.go).
+// Under kEmptyRegexpFallback the replica of findRoute's regexp loop (tree.go): a node whose
+// tail byte comes first (p == 0) is skipped, and when no node matched the search descends into
+// the last node of the group with an empty value appended and the regexp unchecked (the
+// append of "" after the loop, then the descent into the loop's last node; chi/3). Under
+// kRegexpCrossesSlash the replica of findRoute's regexp branch: the regexp alone decides, so
+// a value may span segments when the tail is not '/' (chi/2).
+func (t *mtree) find(n *mnode, method, rest string, st *mstate) *mres {
+	if rest != "" {
+		if c := n.static[rest[0]]; c != nil {
+			if r := t.step(c, method, rest[1:], "", false, st); r != nil {
+				return r
+			}
+		}
+	}
+	if len(n.rex) > 0 && rest != "" {
+		for _, c := range n.rex {
+			p := strings.IndexByte(rest, c.tail)
+			if p < 0 {
+				if c.tail != '/' {
+					continue
+				}
+				p = len(rest)
+			}
+			if p == 0 && t.k[kEmptyRegexpFallback] {
+				continue // the fallback below is the only way to an empty value
+			}
+			v := rest[:p]
+			if !c.re.MatchString(v) {
+				continue
+			}
+			if !t.k[kRegexpCrossesSlash] && strings.IndexByte(v, '/') >= 0 {
+				continue
+			}
+			if r := t.step(c, method, rest[p:], v, true, st); r != nil {
+				return r
+			}
+		}
+		if t.k[kEmptyRegexpFallback] {
+			c := n.rex[len(n.rex)-1]
+			if r := t.step(c, method, rest, "", true, st); r != nil {
+				return r
+			}
+		}
+	}
+	if len(n.par) > 0 && rest != "" {
+		for _, c := range n.par {
+			p := strings.IndexByte(rest, c.tail)
+			if p < 0 {
+				if c.tail != '/' {
+					continue
+				}
+				p = len(rest)
+			}
+			v := rest[:p]
+			if strings.IndexByte(v, '/') >= 0 {
+				continue
+			}
+			if r := t.step(c, method, rest[p:], v, true, st); r != nil {
+				return r
+			}
+		}
+	}
+	if n.all != nil {
+		if r := t.step(n.all, method, "", rest, true, st); r != nil {
+			return r
+		}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- the model router
+
+type model struct {
+	t    table
+	k    known
+	tree *mtree
+	sub  *mtree
+}
+
+// newModel builds the trees of the table: the mount first (Mount registers "P", "P/" and
+// "P/*" for every method when P has no trailing slash, "P/*" alone otherwise; the stubs and
+// the wildcard carry the sub-router), then the routes.
+func newModel(t table, k known) *model {
+	m := &model{t: t, k: k, tree: newTree(k)}
+	if t.mount != nil {
+		m.sub = newTree(k)
+		for _, r := range t.mount.routes {
+			m.sub.insert(r.method, r.segs, &mend{pattern: r.pattern, keys: keysOf(r.segs), name: r.name})
+		}
+		P := t.mount.pattern
+		segs := t.mount.segs
+		if P[len(P)-1] != '/' {
+			m.tree.insert("ALL", segs, &mend{pattern: P, keys: keysOf(segs), mount: m.sub})
+			withSlash := appendStatic(segs, "/")
+			m.tree.insert("ALL", withSlash, &mend{pattern: P + "/", keys: keysOf(segs), mount: m.sub})
+			segs = withSlash
+			P += "/"
+		}
+		wild := append(append([]seg(nil), segs...), seg{kind: segCatchAll, key: "*"})
+		m.tree.insert("ALL", wild, &mend{pattern: P + "*", keys: keysOf(wild), mount: m.sub, wild: true})
+	}
+	for _, r := range t.routes {
+		m.tree.insert(r.method, r.segs, &mend{pattern: r.pattern, keys: keysOf(r.segs), name: r.name})
+	}
+	return m
+}
+
+// chiRoutePattern is the replica of Context.RoutePattern (context.go): the pattern stack
+// joined, every "/*/" replaced by "/" until none is left, then a trailing "//" and a trailing
+// "/" trimmed unless the result is "/".
+func chiRoutePattern(patterns []string) string {
+	p := strings.Join(patterns, "")
+	for strings.Contains(p, "/*/") {
+		p = strings.ReplaceAll(p, "/*/", "/")
+	}
+	if p != "/" {
+		p = strings.TrimSuffix(p, "//")
+		p = strings.TrimSuffix(p, "/")
+	}
+	return p
+}
+
+// servedPattern is r.Pattern (and RoutePattern()) of a request served by the endpoint e, with
+// the sub-router's pattern sub when e is a mount endpoint. Documented: a route's pattern as
+// registered; for a mount, the pattern of the matched endpoint spliced with the sub-router's:
+// the wildcard "P/*" without its "/*" followed by the sub-pattern (Find's own splice: "/m" +
+// "/a/" is "/m/a/"), the stubs "P" and "P/" (the bare path, whose sub-path is "/") their own
+// pattern. Under kPatternTrailingSlashTrimmed the replica chiRoutePattern of the stack, which
+// trims the trailing slash of a route registered with one, of a sub-route under the wildcard
+// ("/m/*" + "/a/" is "/m/a"; "/m/*" + "/" is "/m") and of the "P/" stub ("/m/" + "/" is "/m")
+// alike (chi/8).
+func (m *model) servedPattern(e *mend, sub string) string {
+	if e.mount == nil {
+		if m.k[kPatternTrailingSlashTrimmed] {
+			return chiRoutePattern([]string{e.pattern})
+		}
+		return e.pattern
+	}
+	if m.k[kPatternTrailingSlashTrimmed] {
+		return chiRoutePattern([]string{e.pattern, sub})
+	}
+	if e.wild {
+		return strings.TrimSuffix(e.pattern, "/*") + sub
+	}
+	return e.pattern
+}
+
+type outcome struct {
+	status  int
+	name    string
+	pattern string
+	params  []string // key=value pairs in order
+	allowed []string
+}
+
+func pairs(keys, values []string) []string {
+	var out []string
+	for i, k := range keys {
+		v := ""
+		if i < len(values) {
+			v = values[i]
+		}
+		out = append(out, k+"="+v)
+	}
+	return out
+}
+
+// find is Mux.Find: the pattern matching method and path, "" when none; an unknown method
+// never matches. For a mount's wildcard the parent's pattern without "/*" followed by the
+// sub-router's match of the rest. For the bare mount path (the stubs P and P/), documented: a
+// match only when the sub-router serves "/" for the method, reported as the stub's pattern;
+// under kMountStubMatches the replica of Find's descent (mux.go: the sub-router is entered
+// only through the node that carries it, the wildcard's, so a stub's pattern is returned for
+// any method, chi/9). Find routes the path as given: no percent-decoding is involved.
+func (m *model) find(method, p string) string {
+	if !knownMethod(method) {
+		return ""
+	}
+	res, _ := m.tree.search(method, p)
+	if res == nil {
+		return ""
+	}
+	if res.end.mount == nil {
+		return res.end.pattern
+	}
+	if !res.end.wild {
+		if m.k[kMountStubMatches] || m.sub.find(m.sub.root, method, "/", &mstate{}) != nil {
+			return res.end.pattern
+		}
+		return ""
+	}
+	sp := m.sub.find(m.sub.root, method, "/"+res.values[len(res.values)-1], &mstate{})
+	if sp == nil {
+		return ""
+	}
+	return strings.TrimSuffix(res.end.pattern, "/*") + sp.end.pattern
+}
+
+// decodedPath is the request path as r.URL.Path holds it: the request-target percent-decoded
+// (url.PathUnescape, which is net/url's unescape in path mode); an invalid escape is never
+// written, and would be left as it is.
+func decodedPath(p string) string {
+	d, err := url.PathUnescape(p)
+	if err != nil {
+		return p
+	}
+	return d
+}
+
+// libRoutePath is the replica of routeHTTP's routing path for the request-target p (mux.go:
+// r.URL.RawPath when net/url set it and r.URL.Path otherwise), with net/url's rule for
+// RawPath transcribed from url.(*URL).setPath: RawPath is set to p when p differs from the
+// canonical escaping of its decoded form, (&url.URL{Path: decoded}).EscapedPath(), which is
+// net/url's own escape in path mode. So "/u/%41" is routed as "/u/%41" (A is not escaped
+// canonically), "/u/a%2Fb" as "/u/a%2Fb" (a slash is not), "/u/a%20b" as "/u/a b" (a space
+// is).
+func libRoutePath(p string) string {
+	decoded := decodedPath(p)
+	if (&url.URL{Path: decoded}).EscapedPath() != p {
+		return p
+	}
+	return decoded
+}
+
+// routedPath is the string the router matches for the request-target p, the middleware of
+// the table applied. Documented: the escaped path itself (r.URL.EscapedPath() is p for a
+// request whose escapes are valid, so an escaped slash never splits a segment; the values are
+// decoded afterwards, see values); CleanPath cleans it, StripSlashes drops one trailing
+// slash. Under kRawParamValues the replica of routeHTTP's choice (libRoutePath), which
+// CleanPath (clean_path.go) and GetHead (get_head.go) make the same way before routing, and
+// which StripSlashes (strip.go) does not: it reads r.URL.Path, and when that ends with a slash
+// routes the decoded path without it (so an escaped slash does split a segment there);
+// otherwise it leaves the choice to routeHTTP (chi/7).
+func (m *model) routedPath(p string) string {
+	if m.k[kRawParamValues] {
+		lib := libRoutePath(p)
+		switch m.t.mw {
+		case "CleanPath":
+			return path.Clean(lib)
+		case "StripSlashes":
+			if dec := decodedPath(p); len(dec) > 1 && dec[len(dec)-1] == '/' {
+				return dec[:len(dec)-1]
+			}
+		}
+		return lib
+	}
+	switch m.t.mw {
+	case "CleanPath":
+		return path.Clean(p)
+	case "StripSlashes":
+		if len(p) > 1 && p[len(p)-1] == '/' {
+			return p[:len(p)-1]
+		}
+	}
+	return p
+}
+
+// values is what the handler receives for the matched values. Documented: each value
+// percent-decoded (the decoded segment of the path). Under kRawParamValues the replica: the
+// values are slices of the routed string, decoded only where net/url decoded the path before
+// routing (chi/7).
+func (m *model) values(vs []string) []string {
+	out := make([]string, len(vs))
+	for i, v := range vs {
+		if m.k[kRawParamValues] {
+			out[i] = v
+		} else {
+			out[i] = decodedPath(v)
+		}
+	}
+	return out
+}
+
+// serve is what the router answers to method and path. GetHead (get_head.go) routes a HEAD
+// request as GET when Match(HEAD, path) fails, through the model's own find with the same
+// switches (so under kMountStubMatches HEAD on a bare mount path is not routed as GET,
+// chi/9). An unknown method: documented 501 (RFC 9110 9.1: "SHOULD respond with the 501 (Not
+// Implemented) status code"); under kUnknownMethod405 the replica of routeHTTP's methodMap
+// lookup (mux.go): MethodNotAllowedHandler() with no methods, a 405 without Allow, whatever
+// the path (chi/6). A 404 when nothing matched, a 405 with the Allow set of the leaves reached
+// with the whole path (the parent's and the sub-router's merged for a mount).
+func (m *model) serve(method, p string) outcome {
+	routed := m.routedPath(p)
+	routeMethod := method
+	if m.t.mw == "GetHead" && method == "HEAD" && m.find("HEAD", routed) == "" {
+		routeMethod = "GET"
+	}
+	if !knownMethod(routeMethod) {
+		if m.k[kUnknownMethod405] {
+			return outcome{status: 405}
+		}
+		return outcome{status: 501}
+	}
+	res, st := m.tree.search(routeMethod, routed)
+	if res == nil {
+		if st.notAllowed {
+			return outcome{status: 405, allowed: st.allowed}
+		}
+		return outcome{status: 404}
+	}
+	if res.end.mount == nil {
+		return outcome{status: 200, name: res.end.name, pattern: m.servedPattern(res.end, ""), params: pairs(res.end.keys, m.values(res.values))}
+	}
+	// a mount: the sub-router routes the rest of the path, the wildcard value is reset
+	keys := append([]string(nil), res.end.keys...)
+	values := append([]string(nil), res.values...)
+	subPath := "/"
+	if res.end.wild {
+		subPath = "/" + values[len(values)-1]
+		values[len(values)-1] = ""
+	}
+	sres, sst := m.sub.search(routeMethod, subPath)
+	if sres == nil {
+		if st.notAllowed || sst.notAllowed {
+			st.allow(map[string]*mend{})
+			for _, a := range sst.allowed {
+				st.allow(map[string]*mend{a: nil})
+			}
+			return outcome{status: 405, allowed: st.allowed}
+		}
+		return outcome{status: 404}
+	}
+	keys = append(keys, sres.end.keys...)
+	values = append(values, sres.values...)
+	return outcome{status: 200, name: sres.end.name, pattern: m.servedPattern(res.end, sres.end.pattern), params: pairs(keys, m.values(values))}
+}
+
+// --------------------------------------------------------------------------- the checks
+
+// setOutcome states the values of request i: the status, the handler's name, r.Pattern, the
+// URL parameters (key=value, in order), the Allow set of a 405 (sorted: the model collects it
+// from a map and the library's header order is a map's) and Find's pattern; every name is set
+// for every request so that the library's and the model's sets have the same keys.
+func setOutcome(out checks, i int, o outcome, find string) {
+	pre := strconv.Itoa(i) + "."
+	out[pre+"status"] = strconv.Itoa(o.status)
+	out[pre+"name"] = o.name
+	out[pre+"pattern"] = o.pattern
+	out[pre+"params"] = strings.Join(o.params, ",")
+	allowed := append([]string(nil), o.allowed...)
+	sort.Strings(allowed)
+	out[pre+"allow"] = strings.Join(allowed, ",")
+	out[pre+"find"] = find
+}
+
+// routeExpected: for every request of the case, what the router answers (status, handler,
+// pattern, parameters, Allow) and what Find reports, by the model under the switch set.
+func routeExpected(c routeCase, k known) checks {
+	m := newModel(c.tbl, k)
+	out := checks{}
+	for i, r := range c.reqs {
+		setOutcome(out, i, m.serve(r.method, r.path), m.find(r.method, r.path))
+	}
+	return out
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
