+package hegel
+
+// The narrow properties of the middleware families: one per recorded middleware bug, drawing
+// the shape of the bug as its generator (hzShaped: the region past the shape under
+// HEGEL_NO_KNOWN=1; regionOf: the classifier keeps the cases of that shape, or of none) and
+// judged by the family's judge (hegel_headers_test.go), so that each fails every run naming
+// its bug by default and passes under HEGEL_NO_KNOWN=1. The surroundings of a shape are drawn
+// from the family's own tables in their plain spellings, so that the classifier names the bug
+// of the property and not a neighbour. The figures in the comments are what HEGEL_COLLECT=1
+// measured: over 1000 default cases the cases the classifier named (every property's region
+// kept all 1000 but Sunset's, whose zero times are no shape), the replica's agreement and
+// what the library answered; over 3000 cases under HEGEL_NO_KNOWN=1 the mismatches (none)
+// and the draws rejected (none: the shapes are drawn, not filtered). chi/15 and chi/17 (Sunset)
+// have their record, model and judges here: no wide property reaches Sunset.
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5/middleware"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- chi/16
+
+// parseableEntries are the entries of ipEntries net.ParseIP accepts (a zone, a prefix, a port
+// or junk does not parse padded or not).
+var parseableEntries = []string{"1.2.3.4", "10.0.0.1", "10.1.2.3", "192.168.0.9", "8.8.8.8", "203.0.113.7", "2001:db8::1", "::1", "::ffff:10.0.0.1", "::ffff:1.2.3.4"}
+
+// firstEntryPaddings: the shape of chi/16 is OWS before the first entry of the first field,
+// after it, or both (RealIP cuts at the comma without trimming); past it, under
+// HEGEL_NO_KNOWN=1, the entry bare.
+var firstEntryPaddings = hzShaped(evenOver(" %s", "%s ", " %s "), hegel.Just("%s"))
+
+// realIPCases: the first X-Forwarded-For field begins with a parseable entry, padded, followed
+// by 0..3 entries of the family (padded or not); 0..2 fields of the family follow; the
+// middleware of the case is any of the four; no True-Client-IP or X-Real-IP (RealIP reads
+// either before the field).
+var realIPCases = hegel.Composite(func(tc hegel.TestCase) clientIPCase {
+	first := fmt.Sprintf(hegel.Draw(tc, firstEntryPaddings), hegel.Draw(tc, evenOver(parseableEntries...)))
+	entries := append([]string{first}, hegel.Draw(tc, fairCounted(xffEntries, 0, 3))...)
+	fields := append([]string{strings.Join(entries, ",")}, hegel.Draw(tc, fairCounted(xffFields, 0, 2))...)
+	return clientIPCase{xff: fields, alt: hegel.Draw(tc, clientIPAlts)}
+})
+
+// TestHegelRealIPTrimsTheFirstEntry (chi/16): RealIP reads the first X-Forwarded-For entry with
+// the OWS the list syntax allows around the comma trimmed: " 1.2.3.4 , 5.6.7.8" sets RemoteAddr
+// to 1.2.3.4 as "1.2.3.4, 5.6.7.8" does. Named chi/16 1000 of 1000, the replica agreeing on
+// every one (RemoteAddr left as it was); under HEGEL_NO_KNOWN=1 3000 of 3000 pass.
+func TestHegelRealIPTrimsTheFirstEntry(t *testing.T) {
+	judged(t, regionOf("chi/16", clientIPExpected, realIPCases), judgeClientIP)
+}
+
+// --------------------------------------------------------------------------- chi/10
+
+// twoCodingFields is the shape of chi/10: a field of two codings (chi looks the whole field up
+// in the allowed set); past it, under HEGEL_NO_KNOWN=1, the first coding alone.
+func twoCodingFields(c1, c2, joiner string) encodingField {
+	return encodingField{codings: hzShaped([]string{c1, c2}, []string{c1}), joiner: joiner}
+}
+
+// encodingListCases: a Content-Encoding field of two codings both allowed, among 0..1 fields of
+// one allowed coding before and after it; the allowed list holds the two and 0..2 others; the
+// body "body" (an empty one is never checked).
+var encodingListCases = hegel.Composite(func(tc hegel.TestCase) contentCase {
+	c1, c2 := hegel.Draw(tc, codingTable), hegel.Draw(tc, codingTable)
+	allowed := append(hegel.Draw(tc, fairCounted(codingTable, 0, 2)), c1, c2)
+	single := hegel.Map(hzTuple(evenOver(allowed...), joinerTable), func(v []string) encodingField {
+		return encodingField{codings: v[:1], joiner: v[1]}
+	})
+	fields := append(hegel.Draw(tc, fairCounted(single, 0, 1)), twoCodingFields(c1, c2, hegel.Draw(tc, joinerTable)))
+	fields = append(fields, hegel.Draw(tc, fairCounted(single, 0, 1))...)
+	return contentCase{kind: "encoding", body: "body", allowed: allowed, fields: fields}
+})
+
+// TestHegelContentEncodingListsAreSplit (chi/10): a Content-Encoding field is a list of
+// codings (RFC 9110 8.4), so "gzip, br" passes AllowContentEncoding("gzip", "br") as the two
+// fields "gzip" and "br" do. Named chi/10 1000 of 1000, 415 every time as the replica says;
+// under HEGEL_NO_KNOWN=1 3000 of 3000 pass (200).
+func TestHegelContentEncodingListsAreSplit(t *testing.T) {
+	judged(t, regionOf("chi/10", contentExpected, encodingListCases), judgeContent)
+}
+
+// --------------------------------------------------------------------------- chi/11
+
+// The shape of chi/11: the charset parameter spelled as a quoted-string (chi compares the piece
+// with its quotes), or a parameter before it whose value holds "charset=" (chi cuts at the
+// first one): `boundary="charset=a"`, quoted because the note's unquoted spelling is not a
+// media type and mime.ParseMediaType rejects it. OWS around the ";" is NOT a shape of
+// ContentCharset (its split trims both pieces; checked standalone), so the separators stay the
+// family's four. Past the shape, under HEGEL_NO_KNOWN=1, the plain spelling and "boundary=abc".
+var (
+	charsetShapeKinds = hzFair(hzW(3, hegel.Just("quoted")), hzW(3, hegel.Just("misleading"))) // 50 each nominal: 3:3 realises 51.0/49.0
+	quotedSpelling    = hzShaped(true, false)
+	misleadingText    = hzShaped(misleadingParam, "boundary=abc")
+)
+
+// listSpellingsOf is a list entry naming the charset: the same spelling or its upper case (the
+// list is compared case-insensitively).
+func listSpellingsOf(cs string) hegel.Generator[string] {
+	return hzFair(hzW(2, hegel.Just(cs)), hzW(1, hegel.Just(strings.ToUpper(cs))))
+}
+
+// quotedCharsetCases: a Content-Type with the shaped spelling (the quoted charset, in the list;
+// or the misleading parameter, with the charset in the list or no charset and "" in the list),
+// the other parameters as the family draws them, 0..2 other list entries, the body "body".
+var quotedCharsetCases = hegel.Composite(func(tc hegel.TestCase) contentCase {
+	kind := hegel.Draw(tc, charsetShapeKinds)
+	ct := contentType{typ: hegel.Draw(tc, mediaTypeTable)}
+	if kind == "misleading" {
+		ct.params = append(ct.params, ctParam{sep: hegel.Draw(tc, sepTable), text: misleadingText})
+	} else if hegel.Draw(tc, withFirstParam) {
+		ct.params = append(ct.params, ctParam{sep: hegel.Draw(tc, sepTable), text: hegel.Draw(tc, evenOver(firstParams...))})
+	}
+	charsets := hegel.Draw(tc, fairCounted(charsetListTable, 0, 2))
+	if kind == "quoted" || hegel.Draw(tc, withCharset) {
+		cs := hegel.Draw(tc, charsetTable)
+		v := cs
+		if kind == "quoted" && quotedSpelling {
+			v = `"` + v + `"`
+		}
+		ct.params = append(ct.params, ctParam{sep: hegel.Draw(tc, sepTable), text: "charset=" + v})
+		charsets = append(charsets, hegel.Draw(tc, listSpellingsOf(cs)))
+	} else {
+		charsets = append(charsets, "")
+	}
+	if hegel.Draw(tc, withXY) {
+		ct.params = append(ct.params, ctParam{sep: hegel.Draw(tc, sepTable), text: "x=y"})
+	}
+	return contentCase{kind: "charset", body: "body", charsets: charsets, ct: &ct}
+})
+
+// TestHegelQuotedCharsetsAreRead (chi/11): the charset parameter of a Content-Type is read as a
+// media type parameter (a token or a quoted-string, RFC 9110 8.3.1): `charset="utf-8"` names
+// utf-8, and `boundary="charset=a"` before it is another parameter. Named chi/11 1000 of 1000
+// (the quoted charset 51 percent, the misleading parameter 49), 415 every time as the replica
+// says; under HEGEL_NO_KNOWN=1 3000 of 3000 pass (200).
+func TestHegelQuotedCharsetsAreRead(t *testing.T) {
+	judged(t, regionOf("chi/11", contentExpected, quotedCharsetCases), judgeContent)
+}
+
+// --------------------------------------------------------------------------- chi/12
+
+// The codings by whether they name an encoder of Compress (x-gzip is gzip, RFC 9110 18.3) and
+// the q parameters by weight.
+var (
+	encoderCodings = []string{"gzip", "deflate", "x-gzip", "GZIP", "Deflate"}
+	otherCodings   = []string{"br", "identity", "zstd"}
+	encoderTable   = evenOver(encoderCodings...)
+	otherTable     = evenOver(otherCodings...)
+	zeroQs         = evenOver(";q=0", ";q=0.0", "; q=0")
+	nonZeroQs      = evenOver("", ";q=0.5", ";q=1", ";q=1.0")
+)
+
+// otherAEElements: an element naming no encoder, with a non-zero weight: the neighbours of a
+// shaped element (an encoder named beside a zero-weighted one would be chosen both ways: no
+// shape). plainAEElements: any coding but "*" with a non-zero weight, the neighbours of chi/13's
+// cases.
+var (
+	otherAEElements = hegel.Composite(func(tc hegel.TestCase) aeElement {
+		return aeElement{coding: hegel.Draw(tc, otherTable), q: hegel.Draw(tc, nonZeroQs), space: hegel.Draw(tc, withSpace)}
+	})
+	plainAEElements = hegel.Composite(func(tc hegel.TestCase) aeElement {
+		return aeElement{coding: hegel.Draw(tc, evenOver(append(append([]string(nil), encoderCodings...), otherCodings...)...)), q: hegel.Draw(tc, nonZeroQs), space: hegel.Draw(tc, withSpace)}
+	})
+)
+
+// The shape of chi/12: an encoder named with a zero weight (chi's substring match still selects
+// it), or "*" (which stands for any coding not listed; chi selects nothing); past it, under
+// HEGEL_NO_KNOWN=1, the encoder with a non-zero weight.
+var (
+	zeroWeightedElements = hegel.Composite(func(tc hegel.TestCase) aeElement {
+		return aeElement{coding: hegel.Draw(tc, encoderTable), q: hegel.Draw(tc, hzShaped(zeroQs, nonZeroQs)), space: hegel.Draw(tc, withSpace)}
+	})
+	starElements = hegel.Composite(func(tc hegel.TestCase) aeElement {
+		return aeElement{coding: hegel.Draw(tc, hzShaped(hegel.Just("*"), encoderTable)), q: hegel.Draw(tc, nonZeroQs), space: hegel.Draw(tc, withSpace)}
+	})
+	shapedAEElements          = hzFair(hzW(5, zeroWeightedElements), hzW(2, starElements)) // 75/25 nominal: 5:2 realises 75.1/24.9
+	compressibleResponseTypes = evenOver("text/html", "text/html; charset=utf-8", "application/json", "text/plain;charset=us-ascii", "image/svg+xml", "text/html;")
+)
+
+// acceptEncodingWeightCases: the shaped element among 0..1 other elements before and after it,
+// a compressible response type in a plain spelling, the family's body.
+var acceptEncodingWeightCases = hegel.Composite(func(tc hegel.TestCase) compressCase {
+	return compressCase{
+		ae:   hegel.Draw(tc, hzSeq(fairCounted(otherAEElements, 0, 1), hzOne(shapedAEElements), fairCounted(otherAEElements, 0, 1))),
+		ct:   hegel.Draw(tc, compressibleResponseTypes),
+		body: hegel.Draw(tc, compressBodies),
+	}
+})
+
+// TestHegelAcceptEncodingWeightsAreHonoured (chi/12): Compress reads Accept-Encoding by RFC
+// 9110 12.5.3: "gzip;q=0" does not select gzip, "deflate, gzip;q=0" selects deflate, and "*"
+// selects gzip. Named chi/12 1000 of 1000 ("*" 25 percent), the replica agreeing on every one
+// (the library chose gzip 482, deflate 287 and nothing 231 times); under HEGEL_NO_KNOWN=1
+// 3000 of 3000 pass (gzip 1847, deflate 1153).
+func TestHegelAcceptEncodingWeightsAreHonoured(t *testing.T) {
+	judged(t, regionOf("chi/12", compressExpected, acceptEncodingWeightCases), judgeCompress)
+}
+
+// --------------------------------------------------------------------------- chi/13
+
+// typeSpelling is how a compressible media type is written: its capitals (none, all, the first
+// letter, the subtype) and OWS after it; a "charset=utf-8" parameter follows in some.
+type typeSpelling struct {
+	caps  int
+	ows   bool
+	param bool
+}
+
+// spellType writes the media type base in the spelling.
+func spellType(base string, s typeSpelling) string {
+	t := base
+	switch s.caps {
+	case 1:
+		t = strings.ToUpper(t)
+	case 2:
+		t = strings.ToUpper(t[:1]) + t[1:]
+	case 3:
+		typ, sub, _ := strings.Cut(t, "/")
+		t = typ + "/" + strings.ToUpper(sub)
+	}
+	if s.ows {
+		t += " "
+	}
+	if s.param {
+		t += ";charset=utf-8"
+	}
+	return t
+}
+
+// The shape of chi/13: a capital in the type or OWS before the ";" (chi cuts at the ";" and
+// looks the piece up as is); past it, under HEGEL_NO_KNOWN=1, the lower-case type with no OWS.
+var (
+	typeShapes    = hzShaped(fairOver([]int{1, 1, 1, 1}, typeSpelling{caps: 1}, typeSpelling{caps: 2}, typeSpelling{caps: 3}, typeSpelling{ows: true}), hegel.Just(typeSpelling{}))
+	withTypeParam = hzCoin(50)
+)
+
+// mediaTypeCaseCases: one of the fifteen compressible types in the shaped spelling, an
+// Accept-Encoding naming an encoder with a non-zero weight among 0..1 plain elements before
+// and after it, the family's body.
+var mediaTypeCaseCases = hegel.Composite(func(tc hegel.TestCase) compressCase {
+	s := hegel.Draw(tc, typeShapes)
+	s.param = hegel.Draw(tc, withTypeParam)
+	encoder := hegel.Composite(func(tc hegel.TestCase) aeElement {
+		return aeElement{coding: hegel.Draw(tc, encoderTable), q: hegel.Draw(tc, nonZeroQs), space: hegel.Draw(tc, withSpace)}
+	})
+	return compressCase{
+		ae:   hegel.Draw(tc, hzSeq(fairCounted(plainAEElements, 0, 1), hzOne(encoder), fairCounted(plainAEElements, 0, 1))),
+		ct:   spellType(hegel.Draw(tc, evenOver(compressibleTypes...)), s),
+		body: hegel.Draw(tc, compressBodies),
+	}
+})
+
+// TestHegelMediaTypesCompareCaseInsensitively (chi/13): Compress compresses a response whose
+// media type is in its list however the type is capitalised and whether OWS precedes its
+// parameters (RFC 9110 8.3.1): "Text/HTML" and "text/html ; charset=utf-8" are text/html.
+// Named chi/13 1000 of 1000, nothing compressed every time as the replica says; under
+// HEGEL_NO_KNOWN=1 3000 of 3000 pass (gzip 2331, deflate 669).
+func TestHegelMediaTypesCompareCaseInsensitively(t *testing.T) {
+	judged(t, regionOf("chi/13", compressExpected, mediaTypeCaseCases), judgeCompress)
+}
+
+// --------------------------------------------------------------------------- chi/14
+
+// valuesMatching: the values of the family a pattern matches case-insensitively. The family's
+// "x*b*" matches none of them (its suffix is "b*": the text after the first "*" is literal, in
+// the library's Pattern and in the documented rule alike), so the narrow properties draw from
+// the routable patterns, the ones with a matching value.
+func valuesMatching(pattern string) []string {
+	var out []string
+	for _, v := range headerValues {
+		if v != "" && matchPattern(pattern, strings.ToLower(v), false) {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+func matchingValues(pattern string) hegel.Generator[string] {
+	return evenOver(valuesMatching(pattern)...)
+}
+
+func routable(patterns []string) []string {
+	var out []string
+	for _, p := range patterns {
+		if len(valuesMatching(p)) > 0 {
+			out = append(out, p)
+		}
+	}
+	return out
+}
+
+// capitalPatternTable: the letter patterns of the family in capitals ("*" has none), the
+// routable ones: "A", "A*", "*B", "A*B", "AB".
+var capitalPatternTable = evenOver(routable([]string{"A", "A*", "*B", "A*B", "AB", "X*B*"})...)
+
+// plainHeaderRoutes: a route with one of the seven lower-case patterns.
+var plainHeaderRoutes = hegel.Composite(func(tc hegel.TestCase) headerRoute {
+	return headerRoute{header: hegel.Draw(tc, headerNameTable), pattern: hegel.Draw(tc, evenOver(headerPatterns...)), any: hegel.Draw(tc, routeAnys)}
+})
+
+func headerIndex(name string) int {
+	for i, n := range headerNames {
+		if n == name {
+			return i
+		}
+	}
+	return 0
+}
+
+// patternCaseCases: the first route has a capital pattern (the shape of chi/14; past it, under
+// HEGEL_NO_KNOWN=1, the pattern in lower case) and its header is sent with a value the pattern
+// matches case-insensitively; 0..2 plain routes follow; the other header is not sent (two
+// routed headers would be chi/4's shape, named first).
+var patternCaseCases = hegel.Composite(func(tc hegel.TestCase) headerRouteCase {
+	p := hegel.Draw(tc, capitalPatternTable)
+	shaped := headerRoute{header: hegel.Draw(tc, headerNameTable), pattern: hzShaped(p, strings.ToLower(p)), any: hegel.Draw(tc, routeAnys)}
+	routes := taggedRoutes(append([]headerRoute{shaped}, hegel.Draw(tc, fairCounted(plainHeaderRoutes, 0, 2))...))
+	sent := make([]string, len(headerNames))
+	sent[headerIndex(shaped.header)] = hegel.Draw(tc, matchingValues(p))
+	return headerRouteCase{routes: routes, def: hegel.Draw(tc, withDefault), sent: sent}
+})
+
+// TestHegelHeaderPatternsCompareCaseInsensitively (chi/14): a route's pattern matches the same
+// header values whether it is spelled "Example.com" or "example.com": Route("X-A", "A*") routes
+// the value "ab". Named chi/14 1000 of 1000, the replica agreeing on every one (the library
+// found no match 700 times and routed elsewhere 300); under HEGEL_NO_KNOWN=1 3000 of 3000
+// pass, routed.
+func TestHegelHeaderPatternsCompareCaseInsensitively(t *testing.T) {
+	judged(t, regionOf("chi/14", headerRouteExpected, patternCaseCases), judgeHeaderRoute)
+}
+
+// --------------------------------------------------------------------------- chi/4
+
+// plainPatternTable: the routable lower-case patterns (all but "x*b*").
+var (
+	plainPatternTable = evenOver(routable(headerPatterns)...)
+	secondFirst       = hzCoin(50) // the X-B route registered before the X-A route
+)
+
+// twoRoutedCases: a route for X-A and one for X-B, in either order, among 0..1 plain routes
+// before and after them, both headers sent with a value their route matches (the shape of
+// chi/4: the library visits the headers in map order and takes the second one's route about
+// one time in eight); past it, under HEGEL_NO_KNOWN=1, X-B not sent.
+var twoRoutedCases = hegel.Composite(func(tc hegel.TestCase) headerRouteCase {
+	pa, pb := hegel.Draw(tc, plainPatternTable), hegel.Draw(tc, plainPatternTable)
+	pair := []headerRoute{{header: "X-A", pattern: pa, any: hegel.Draw(tc, routeAnys)}, {header: "X-B", pattern: pb, any: hegel.Draw(tc, routeAnys)}}
+	if hegel.Draw(tc, secondFirst) {
+		pair[0], pair[1] = pair[1], pair[0]
+	}
+	routes := append(hegel.Draw(tc, fairCounted(plainHeaderRoutes, 0, 1)), pair...)
+	routes = taggedRoutes(append(routes, hegel.Draw(tc, fairCounted(plainHeaderRoutes, 0, 1))...))
+	sent := []string{hegel.Draw(tc, matchingValues(pa)), hegel.Draw(tc, hzShaped(matchingValues(pb), hegel.Just("")))}
+	return headerRouteCase{routes: routes, def: hegel.Draw(tc, withDefault), sent: sent}
+})
+
+// TestHegelTwoRoutedHeadersTakeTheFirstRoute (chi/4): a request carrying two headers that each
+// have a matching route is routed by the first of the routes in registration order, every
+// time: Route("X-A", "*", A).Route("X-B", "*", B) answers A for a request with both headers.
+// Named chi/4 1000 of 1000, the replica (the set of the routes either header takes) agreeing
+// on every one (the set observed a subset of it). Served once, the library took the other
+// header's route 368 times of 3000 (seed 77), and a shrunk case replayed once passed seven
+// times in eight, so the failure named nothing; served thirty times (headerRouteActual) the
+// set observed holds both routes in 2943 of 3000 (98 percent) and the shrunk case fails on
+// replay naming chi/4; under HEGEL_NO_KNOWN=1 (the second header unsent) 3000 of 3000 pass.
+func TestHegelTwoRoutedHeadersTakeTheFirstRoute(t *testing.T) {
+	judged(t, regionOf("chi/4", headerRouteExpected, twoRoutedCases), judgeHeaderRoute)
+}
+
+// --------------------------------------------------------------------------- chi/15 and chi/17
+
+// sunsetCase: the time Sunset is given (the zero time in some: Sunset then sets nothing, its
+// code guards every header with !sunsetAt.IsZero()), the zone it is expressed in (UTC or one
+// of the fixed offsets of offsetZones, by name), and the Link values.
+type sunsetCase struct {
+	zero  bool
+	unix  int64
+	zone  string
+	links []string
+}
+
+// fixedZone is a zone of a fixed offset from UTC, by name; offsetZones is the table of the
+// zones other than UTC a time is expressed in (the shape of chi/17: Sunset formats the time in
+// its own zone, so the headers carry its wall clock labelled GMT).
+type fixedZone struct {
+	name   string
+	offset int
+}
+
+var offsetZones = []fixedZone{
+	{"+05:30", 5*3600 + 30*60},
+	{"-05:00", -5 * 3600},
+	{"+01:00", 1 * 3600},
+	{"+14:00", 14 * 3600},
+	{"-12:00", -12 * 3600},
+}
+
+func zoneNames(zones []fixedZone) []string {
+	out := make([]string, len(zones))
+	for i, z := range zones {
+		out[i] = z.name
+	}
+	return out
+}
+
+func (c sunsetCase) location() *time.Location {
+	for _, z := range offsetZones {
+		if z.name == c.zone {
+			return time.FixedZone(z.name, z.offset)
+		}
+	}
+	return time.UTC
+}
+
+func (c sunsetCase) at() time.Time {
+	if c.zero {
+		return time.Time{}
+	}
+	return time.Unix(c.unix, 0).In(c.location())
+}
+
+func (c sunsetCase) GoString() string {
+	if c.zero {
+		return fmt.Sprintf("Sunset(time.Time{}, %q)", c.links)
+	}
+	return fmt.Sprintf("Sunset(%s, %q)", c.at().Format(time.RFC3339), c.links)
+}
+
+var sunsetLinks = []string{
+	`<https://example.com/v2>; rel="successor-version"`,
+	`<https://example.com/sunset>; rel="sunset"`,
+	`<https://example.com/deprecation>; rel="deprecation"; type="text/html"`,
+}
+
+// The dice of Sunset: the zero time in 5; the seconds from 1970 to 2100 in three ranges of
+// equal weight (the engine draws the small values of a range); the zone UTC in 70 (the
+// simplest) and one of the five offsets in 30, the shape of chi/17, not drawn under
+// HEGEL_NO_KNOWN=1; 0..2 links.
+var (
+	zeroTimes     = hzCoin(6)                                                                                                             // 5 nominal: 6 realises 6.0
+	sunsetSeconds = hzFair(hzW(1, hzInts(0, 1000000000)), hzW(1, hzInts(1000000000, 2000000000)), hzW(1, hzInts(2000000000, 4102444800))) // three ranges at 33 nominal: realises 34.6/31.4/34.0
+	offsetTable   = evenOver(zoneNames(offsetZones)...)                                                                                   // 20 each nominal: realises 12.7 to 24.9 drawn alone (gmtCases)
+	sunsetZones   = hzFair(hzW(7, hegel.Just("UTC")), hzW(hzUnless(hzNoKnown, 4), offsetTable))                                           // UTC 70 nominal, the offsets 30: 7:4 realises 72.2/27.8 (7:3 put the offsets at 25.2)
+	linkLists     = fairCounted(evenOver(sunsetLinks...), 0, 2)                                                                           // 0..2 at 33 nominal: realises 28.8/35.5/35.8 (4/3/3 put the first at 42.8)
+)
+
+// sunsetCasesIn is the Sunset record with the zero time and the zone drawn from the given
+// dice (the wide-ranging chi/15 property and the chi/17 property differ only there).
+func sunsetCasesIn(zeros hegel.Generator[bool], zones hegel.Generator[string]) hegel.Generator[sunsetCase] {
+	return hegel.Composite(func(tc hegel.TestCase) sunsetCase {
+		return sunsetCase{
+			zero:  hegel.Draw(tc, zeros),
+			unix:  int64(hegel.Draw(tc, sunsetSeconds)),
+			zone:  hegel.Draw(tc, zones),
+			links: hegel.Draw(tc, linkLists),
+		}
+	})
+}
+
+var sunsetCases = sunsetCasesIn(zeroTimes, sunsetZones)
+
+// httpDateOf is the HTTP-date of the time: documented, its UTC instant in http.TimeFormat
+// (http.TimeFormat's own doc comment: "the time being formatted must be in UTC",
+// t.UTC().Format(http.TimeFormat)); under kSunsetLocalClock the replica of Sunset (sunset.go
+// line 15): sunsetAt.Format(http.TimeFormat), the wall clock of the time's own zone labelled
+// GMT (chi/17; the same text for a time in UTC).
+func httpDateOf(at time.Time, k known) string {
+	if k[kSunsetLocalClock] {
+		return at.Format(http.TimeFormat)
+	}
+	return at.UTC().Format(http.TimeFormat)
+}
+
+// sunsetExpected: the Sunset, Deprecation and Link headers of the response. Documented: Sunset
+// an HTTP-date (RFC 8594, which sunset.go cites; an HTTP-date is in GMT, so the time's UTC
+// instant in http.TimeFormat, httpDateOf); Deprecation a Structured Field Date (RFC 9745: "@"
+// and the Unix seconds, independent of the zone); each link a Link value; nothing for the zero
+// time. Under kDeprecationHTTPDate the replica of Sunset (sunset.go line 16): Deprecation is
+// sunsetAt.Format(http.TimeFormat), the same HTTP-date as Sunset (chi/15) - written as the
+// library writes it, so with kSunsetLocalClock on as well it is the local clock, and with
+// kDeprecationHTTPDate alone the UTC HTTP-date, which is what tells the classifier chi/15 from
+// chi/17.
+func sunsetExpected(c sunsetCase, k known) checks {
+	out := checks{"sunset": "", "deprecation": "", "link": ""}
+	if c.zero {
+		return out
+	}
+	at := c.at()
+	out["sunset"] = httpDateOf(at, k)
+	if k[kDeprecationHTTPDate] {
+		out["deprecation"] = httpDateOf(at, k)
+	} else {
+		out["deprecation"] = "@" + strconv.FormatInt(at.Unix(), 10)
+	}
+	out["link"] = strings.Join(c.links, "\n")
+	return out
+}
+
+// sunsetActual asks the library: Sunset(at, links...) around an empty handler.
+func sunsetActual(c sunsetCase) checks {
+	h := middleware.Sunset(c.at(), c.links...)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest("GET", "http://x/", nil))
+	return checks{"sunset": rec.Header().Get("Sunset"), "deprecation": rec.Header().Get("Deprecation"), "link": strings.Join(rec.Header()["Link"], "\n")}
+}
+
+// judgeSunset is the judge of Sunset in both forms: every non-zero time is the shape of chi/15
+// (the form of Deprecation), which the generator cannot turn off, so under HEGEL_NO_KNOWN=1 the
+// Deprecation check is dropped (counted) and Sunset and Link are checked alone. A non-zero time
+// in a zone other than UTC is the shape of chi/17 as well (the Sunset value); the classifier
+// names chi/15 first, in bug order, and the zones are not drawn under HEGEL_NO_KNOWN=1.
+func judgeSunset(j *hzCaseJudge, c sunsetCase) {
+	shape := classify(c, sunsetExpected)
+	dropped := j.Dropped(shape)
+	want := sunsetExpected(c, hzKnownNone)
+	got := sunsetActual(c)
+	if dropped {
+		delete(want, "deprecation")
+		delete(got, "deprecation")
+		verdict(j, c, got, want, "", sunsetExpected)
+		return
+	}
+	verdict(j, c, got, want, shape, sunsetExpected)
+}
+
+// TestHegelSunsetAnnouncesTheDateInBothForms (chi/15): Sunset sets the Sunset header to the
+// HTTP-date of the time (RFC 8594) and the Deprecation header to its Structured Field Date,
+// "@" and the Unix seconds (RFC 9745), with each link given as a Link value; a zero time sets
+// nothing. Named chi/15 953 of 1000 (the rest zero times, which pass), the replica agreeing on
+// every one (the Sunset value is chi/17's shape too in the cases in another zone, about 28
+// percent, named chi/15 by order); under HEGEL_NO_KNOWN=1 the zones are off, the Deprecation
+// value is dropped (2821 of 3000) and 3000 of 3000 pass.
+func TestHegelSunsetAnnouncesTheDateInBothForms(t *testing.T) {
+	judged(t, sunsetCases, judgeSunset)
+}
+
+// --------------------------------------------------------------------------- chi/17
+
+// gmtZones: the shape of chi/17, a time in one of the fixed offsets; past it, under
+// HEGEL_NO_KNOWN=1, UTC. gmtCases: the Sunset record with a non-zero time (the zero time sets
+// nothing and is no shape) in the shaped zone.
+var (
+	gmtZones = hzShaped(offsetTable, hegel.Just("UTC"))
+	gmtCases = sunsetCasesIn(hegel.Just(false), gmtZones)
+)
+
+// sunsetGMTExpected and sunsetGMTActual are the Sunset and Link values alone: the Deprecation
+// value is not among this property's checks - it is chi/15's shape and is checked by
+// TestHegelSunsetAnnouncesTheDateInBothForms - so the classifier names chi/17 here.
+func sunsetGMTExpected(c sunsetCase, k known) checks {
+	out := sunsetExpected(c, k)
+	delete(out, "deprecation")
+	return out
+}
+
+func sunsetGMTActual(c sunsetCase) checks {
+	out := sunsetActual(c)
+	delete(out, "deprecation")
+	return out
+}
+
+func judgeSunsetGMT(j *hzCaseJudge, c sunsetCase) {
+	judgeBy(j, c, sunsetGMTExpected, sunsetGMTActual)
+}
+
+// TestHegelSunsetDatesAreInGMT (chi/17): the Sunset header is an HTTP-date, which is in GMT
+// (RFC 9110 5.6.7): the time 2030-01-01T05:34:05+05:30 is announced as "Tue, 01 Jan 2030
+// 00:04:05 GMT", as the same instant in UTC is. Named chi/17 1000 of 1000, the replica
+// agreeing on every one (the local clock under the GMT label); under HEGEL_NO_KNOWN=1 (the
+// times in UTC, no shape) 3000 of 3000 pass.
+func TestHegelSunsetDatesAreInGMT(t *testing.T) {
+	judged(t, regionOf("chi/17", sunsetGMTExpected, gmtCases), judgeSunsetGMT)
+}
diff --git a/hegel/hegel_headers_test.go b/hegel/hegel_headers_test.go
new file mode 100644
index 0000000..8da4b99
--- /dev/null
+++ b/hegel/hegel_headers_test.go
@@ -0,0 +1,1411 @@
+package hegel
+
+// The middleware package against models of its documentation and the RFCs it cites: client IP
+// extraction (ClientIPFromXFF, ClientIPFromXFFTrustedProxies, ClientIPFromHeader,
+// ClientIPFromRemoteAddr and the deprecated RealIP), the request content checks
+// (AllowContentEncoding, ContentCharset), response compression (Compress) and header routing
+// (RouteHeaders). Each family draws a case record from package-level generators with the
+// population the old per-call generators drew (every special-value list as it was; the figure
+// beside each weight is what the probe measured over 3000 draws of the record with seed 77,
+// "N nominal: w realises r"), states every value its property checks in a model
+// xExpected(c, k known) checks - the documented behaviour with every switch off, the library's
+// rule transcribed from middleware/ with the switch of the recorded bug on (realip.go,
+// content_encoding.go, content_charset.go, compress.go, route_headers.go) - and judges the
+// library against the documented values after the classifier (shapeBy, hegel_test.go) has
+// named the shape of the case from the model alone, before the library is called.
+//
+// The shapes of chi/4, 10, 11, 12, 13, 14 and 16 are drawn at their natural rates (the probe,
+// per 3000 cases: chi/16 9.3 percent of the client IP cases; chi/10 1.4 and chi/11 2.2 of the
+// content cases; chi/12 11.1 and chi/13 13.4 of the compression cases; chi/14 8.9 and chi/4
+// 7.7 of the routing cases - HEGEL_COLLECT=1 over 3000 default cases named 297; 19 and 88;
+// 330 and 392; 218 and 203, every one agreeing with the replica). Under HEGEL_NO_KNOWN=1 the
+// drawn ingredients are off (hzUnless: a second coding in a Content-Encoding field, a quoted
+// charset, a parameter value holding "charset=", a zero weight or "*" in Accept-Encoding, a
+// capitalised or OWS-spelled response type, a capital in a header pattern) and the relations
+// are filtered out by the classifier (withoutShapes: a padded first X-Forwarded-For entry,
+// two routed headers; 435 and 367 draws rejected per 3000 cases). chi/15 (Sunset) is reached
+// by no wide property; its narrow property is in hegel_headers_shapes_test.go with the others.
+//
+// The header-routing request is served thirty times (headerRouteServes: a fresh recorder each
+// time, the same router and request) and the library's value is the SET of the distinct bodies
+// observed, in registration order, joined with "|" as the replica of chi/4 writes its set. The
+// shape of chi/4 is a nondeterministic failure of the library: served once, chi answers the
+// other header's route about one time in eight, so a shrunk case replayed once passed seven
+// times in eight and the property ended as a bare FAIL naming nothing. A deterministic router
+// answers the same body every time (the set has one member and equals the documented value);
+// under the shape thirty serves realise the full set with probability 1 - (7/8)^30, about 98
+// percent, so the failure reproduces on replay and names chi/4 with its shrunk case.
+//
+// Inside these cases the engine's bounded integer draw favours the small faces of its range,
+// the second most (hegel_routes_test.go; the probe: Integers(0, 99) lands below ten 17 to 20
+// percent of the time at every position of a case, a die drawn after a list-valued draw lands
+// on 1 a quarter of the time, and the residues of Integers(0, 9999) by eleven fall from 11.6
+// to 6.7 percent), so every table and count is an evenOver, fairOver or fairInts (the
+// favourite face re-rolled) or, above three entries, a fairTree of such dice, and the coins
+// (hzCoin, hzMaybe) are set above their percentage. Each weight was tuned by the probe to
+// within about two points where the engine let it: a die's profile depends on what the case
+// drew before it, and the same die at the same weight moved by up to eight points between
+// tuning rounds (the alternative die at 2/1/1/1 put X-Forwarded-For at 42, then at 50), so
+// the figures are the last probe's and a few sit three to six points off, noted beside the
+// weight.
+
+import (
+	"bytes"
+	"compress/flate"
+	"compress/gzip"
+	"fmt"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/go-chi/chi/v5/middleware"
+	"hegel.dev/go/hegel"
+)
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// defaultRemote is httptest.NewRequest's RemoteAddr (httptest.DefaultRemoteAddr), the one
+// RealIP leaves when nothing parses.
+const defaultRemote = "192.0.2.1:1234"
+
+// --------------------------------------------------------------------------- client IP
+
+var ipEntries = []string{
+	"1.2.3.4", "10.0.0.1", "10.1.2.3", "192.168.0.9", "8.8.8.8", "203.0.113.7",
+	"2001:db8::1", "::1", "fe80::1%eth0", "::ffff:10.0.0.1", "::ffff:1.2.3.4", "2001:db8::/32",
+	"garbage", "1.2.3", "[::1]:80", "1.2.3.4:80", "", "unknown",
+}
+
+var trustedPrefixes = []string{"10.0.0.0/8", "192.168.0.0/16", "2001:db8::/32", "203.0.113.0/24"}
+
+var remoteAddrs = []string{"1.2.3.4:5", "[::ffff:1.2.3.4]:80", "[fe80::1%eth0]:1", "8.8.8.8", "garbage", "::1"}
+
+// The X-Forwarded-For fields: 1..3 fields of 0..4 entries from ipEntries, each with a space
+// before it in 30 and after it in 30 (the OWS the list syntax allows around the comma). A
+// padded first entry of the first field that parses once trimmed is the shape of chi/16 when
+// RealIP reads the field (no True-Client-IP or X-Real-IP sent): a relation of the draws, named
+// by the classifier and filtered out under HEGEL_NO_KNOWN=1 (withoutShapes; the rejection is
+// measured in the file comment of the collector run, so the padding stays a plain coin rather
+// than a switched alternative).
+var (
+	ipEntryTable   = evenTree(ipEntries...)       // 5.6 each nominal: realises 4.0 to 6.7
+	padBefore      = hzCoin(36)                   // 30 nominal: 36 realises 29.5
+	padAfter       = hzCoin(36)                   // 30 nominal: 36 realises 29.9
+	xffEntryCounts = treeInts(0, 1, 1, 1, 1, 1)   // 0..4 at 20 nominal: realises 21.9/20.3/19.1/19.5/19.2
+	xffFieldCounts = fairInts(1, 4, 4, 4)         // 1..3 at 33 nominal: 4/4/4 realises 34.6/35.8/29.7 (moved four points between rounds)
+	prefixTable    = evenTree(trustedPrefixes...) // 25 each nominal
+	remoteTable    = evenTree(remoteAddrs...)     // 16.7 each nominal: realises 13.6 to 19.5
+)
+
+// xffEntries: an entry of ipEntries, padded.
+var xffEntries = hegel.Composite(func(tc hegel.TestCase) string {
+	e := hegel.Draw(tc, ipEntryTable)
+	if hegel.Draw(tc, padBefore) {
+		e = " " + e
+	}
+	if hegel.Draw(tc, padAfter) {
+		e += " "
+	}
+	return e
+})
+
+// xffFields: a field of 0..4 entries joined by ",".
+var xffFields = hegel.FlatMap(xffEntryCounts, func(k int) hegel.Generator[string] {
+	return hegel.Map(hegel.Lists(xffEntries).MinSize(k).MaxSize(k), func(es []string) string { return strings.Join(es, ",") })
+})
+
+// xffLists: the 1..3 fields.
+var xffLists = hegel.FlatMap(xffFieldCounts, func(k int) hegel.Generator[[]string] {
+	return hegel.Lists(xffFields).MinSize(k).MaxSize(k)
+})
+
+// clientIPAlt is the ClientIPFrom* middleware a case runs and its argument.
+type clientIPAlt struct {
+	kind     string   // "xff", "trusted", "header" or "remote"
+	prefixes []string // xff: the trusted prefixes of ClientIPFromXFF
+	n        int      // trusted: the proxy count of ClientIPFromXFFTrustedProxies
+	values   []string // header: the X-Real-IP values sent to ClientIPFromHeader("x-real-ip")
+	remote   string   // remote: r.RemoteAddr for ClientIPFromRemoteAddr
+}
+
+func (a clientIPAlt) String() string {
+	switch a.kind {
+	case "xff":
+		return fmt.Sprintf("ClientIPFromXFF(%q)", a.prefixes)
+	case "trusted":
+		return fmt.Sprintf("ClientIPFromXFFTrustedProxies(%d)", a.n)
+	case "header":
+		return fmt.Sprintf("ClientIPFromHeader(\"x-real-ip\") with X-Real-IP %q", a.values)
+	}
+	return fmt.Sprintf("ClientIPFromRemoteAddr with RemoteAddr %q", a.remote)
+}
+
+// The five alternatives of the old property: ClientIPFromXFF with 0..3 trusted prefixes (twice
+// as likely, first: the shrink target with none), ClientIPFromXFFTrustedProxies(1..4),
+// ClientIPFromHeader with 0..3 values, ClientIPFromRemoteAddr with a remote from the list.
+var (
+	xffAlts = hegel.Map(fairCounted(prefixTable, 0, 3), func(ps []string) clientIPAlt { // 0..3 at 25 nominal: realises 23.0/27.0/24.8/25.2
+		return clientIPAlt{kind: "xff", prefixes: ps}
+	})
+	trustedAlts = hegel.Map(treeInts(1, 1, 1, 1, 1), func(n int) clientIPAlt { // 1..4 at 25 nominal: realises 20.7/25.2/25.8/28.3
+		return clientIPAlt{kind: "trusted", n: n}
+	})
+	headerAlts = hegel.Map(fairCounted(ipEntryTable, 0, 3), func(vs []string) clientIPAlt { // 0..3 at 25 nominal: realises 25.9/25.9/23.9/24.4
+		return clientIPAlt{kind: "header", values: vs}
+	})
+	remoteAlts = hegel.Map(remoteTable, func(r string) clientIPAlt {
+		return clientIPAlt{kind: "remote", remote: r}
+	})
+	clientIPAlts = hzFair(hzW(1, xffAlts), hzW(2, hzFair(hzW(1, trustedAlts), hzW(1, headerAlts), hzW(1, remoteAlts)))) // 40/20/20/20 nominal: X-Forwarded-For against the rest first (1:2), the rest evenly, realises 36.2/23.2/22.2/18.4 (a flat four-way die put the first at 50 whatever its weight)
+)
+
+// The RealIP request's True-Client-IP and X-Real-IP, each sent in 30 with a value of ipEntries
+// ("" is both the absent header and the empty entry of the table: Header.Get reads them alike).
+var (
+	trueClientIPs = hzMaybe(42, ipEntryTable) // 30 nominal: 42 realises 31.2
+	xRealIPs      = hzMaybe(42, ipEntryTable) // 30 nominal: 42 realises 28.8
+)
+
+// clientIPCase: the X-Forwarded-For fields of the request, the middleware run on it, and the
+// True-Client-IP and X-Real-IP of the RealIP request (which carries the first field alone).
+type clientIPCase struct {
+	xff  []string
+	alt  clientIPAlt
+	tcip string
+	xrip string
+}
+
+func (c clientIPCase) GoString() string {
+	return fmt.Sprintf("X-Forwarded-For %q\n%s\nRealIP request: True-Client-IP %q, X-Real-IP %q, X-Forwarded-For %q", c.xff, c.alt, c.tcip, c.xrip, c.xff[0])
+}
+
+var clientIPCases = hegel.Composite(func(tc hegel.TestCase) clientIPCase {
+	return clientIPCase{
+		xff:  hegel.Draw(tc, xffLists),
+		alt:  hegel.Draw(tc, clientIPAlts),
+		tcip: hegel.Draw(tc, trueClientIPs),
+		xrip: hegel.Draw(tc, xRealIPs),
+	}
+})
+
+// walkXFF visits the entries right to left, as documented (client_ip.go: "walking the chain
+// right-to-left", the last header first, each entry trimmed, empty entries skipped); visit
+// returns true to stop.
+func walkXFF(headers []string, visit func(string) bool) {
+	for i := len(headers) - 1; i >= 0; i-- {
+		parts := strings.Split(headers[i], ",")
+		for j := len(parts) - 1; j >= 0; j-- {
+			v := strings.TrimSpace(parts[j])
+			if v == "" {
+				continue
+			}
+			if visit(v) {
+				return
+			}
+		}
+	}
+}
+
+// parseHeaderAddr is the documented normalisation of a header address: v4-mapped IPv6 folded
+// to v4, the zone stripped.
+func parseHeaderAddr(s string) (netip.Addr, bool) {
+	ip, err := netip.ParseAddr(s)
+	if err != nil {
+		return netip.Addr{}, false
+	}
+	return ip.Unmap().WithZone(""), true
+}
+
+// modelXFF is ClientIPFromXFF as documented: the first entry from the right that is not in a
+// trusted prefix; an entry that does not parse ends the walk with no IP (fail-closed).
+func modelXFF(headers []string, names []string) string {
+	prefixes := make([]netip.Prefix, len(names))
+	for i, n := range names {
+		prefixes[i] = netip.MustParsePrefix(n)
+	}
+	var found netip.Addr
+	walkXFF(headers, func(v string) bool {
+		ip, ok := parseHeaderAddr(v)
+		if !ok {
+			return true
+		}
+		for _, p := range prefixes {
+			if p.Contains(ip) {
+				return false
+			}
+		}
+		found = ip
+		return true
+	})
+	if !found.IsValid() {
+		return ""
+	}
+	return found.String()
+}
+
+// modelTrusted is ClientIPFromXFFTrustedProxies as documented: the n-th entry from the right,
+// no IP when the chain is shorter or the entry does not parse.
+func modelTrusted(headers []string, n int) string {
+	var entry string
+	walkXFF(headers, func(v string) bool {
+		n--
+		if n == 0 {
+			entry = v
+			return true
+		}
+		return false
+	})
+	if entry == "" {
+		return ""
+	}
+	if ip, ok := parseHeaderAddr(entry); ok {
+		return ip.String()
+	}
+	return ""
+}
+
+// modelHeader is ClientIPFromHeader as documented: the last value wins, folded and unzoned,
+// no IP when it does not parse.
+func modelHeader(values []string) string {
+	if len(values) == 0 {
+		return ""
+	}
+	if ip, ok := parseHeaderAddr(values[len(values)-1]); ok {
+		return ip.String()
+	}
+	return ""
+}
+
+// modelRemote is ClientIPFromRemoteAddr as documented: the host of RemoteAddr (or RemoteAddr
+// itself when it is a bare IP), folded, the zone kept.
+func modelRemote(remote string) string {
+	host, _, err := net.SplitHostPort(remote)
+	if err != nil {
+		host = remote
+	}
+	if ip, err := netip.ParseAddr(host); err == nil {
+		return ip.Unmap().String()
+	}
+	return ""
+}
+
+// modelRealIP is RealIP: documented (realip.go's doc comment) the True-Client-IP, else the
+// X-Real-IP, else the first X-Forwarded-For entry - the list syntax allows OWS around the comma,
+// so the entry trimmed - when it parses (net.ParseIP), else RemoteAddr as it was. Under
+// kRealIPUntrimmed the replica of realIP (realip.go line 47): `ip, _, _ = strings.Cut(xff, ",")`
+// with no trim, so a padded first entry does not parse and RemoteAddr is left (chi/16).
+func modelRealIP(c clientIPCase, untrimmed bool) string {
+	var ip string
+	if c.tcip != "" {
+		ip = c.tcip
+	} else if c.xrip != "" {
+		ip = c.xrip
+	} else if xff := c.xff[0]; xff != "" {
+		ip, _, _ = strings.Cut(xff, ",")
+		if !untrimmed {
+			ip = strings.TrimSpace(ip)
+		}
+	}
+	if ip == "" || net.ParseIP(ip) == nil {
+		return defaultRemote
+	}
+	return ip
+}
+
+// clientIPExpected: the client IP the middleware of the case stores (GetClientIP) and the
+// RemoteAddr RealIP leaves, by the model under the switch set.
+func clientIPExpected(c clientIPCase, k known) checks {
+	out := checks{}
+	switch c.alt.kind {
+	case "xff":
+		out["client"] = modelXFF(c.xff, c.alt.prefixes)
+	case "trusted":
+		out["client"] = modelTrusted(c.xff, c.alt.n)
+	case "header":
+		out["client"] = modelHeader(c.alt.values)
+	default:
+		out["client"] = modelRemote(c.alt.remote)
+	}
+	out["realip"] = modelRealIP(c, k[kRealIPUntrimmed])
+	return out
+}
+
+// clientIPActual asks the library: the middleware of the case run on a request with the
+// X-Forwarded-For fields (and the X-Real-IP values or the RemoteAddr of its alternative), then
+// RealIP on a request with the first field and the two single-IP headers.
+func clientIPActual(c clientIPCase) checks {
+	out := checks{}
+	req := httptest.NewRequest("GET", "http://x/", nil)
+	for _, h := range c.xff {
+		req.Header.Add("X-Forwarded-For", h)
+	}
+	var got string
+	record := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { got = middleware.GetClientIP(r.Context()) })
+	var h http.Handler
+	switch c.alt.kind {
+	case "xff":
+		h = middleware.ClientIPFromXFF(c.alt.prefixes...)(record)
+	case "trusted":
+		h = middleware.ClientIPFromXFFTrustedProxies(c.alt.n)(record)
+	case "header":
+		for _, v := range c.alt.values {
+			req.Header.Add("X-Real-IP", v)
+		}
+		h = middleware.ClientIPFromHeader("x-real-ip")(record)
+	default:
+		req.RemoteAddr = c.alt.remote
+		h = middleware.ClientIPFromRemoteAddr(record)
+	}
+	h.ServeHTTP(httptest.NewRecorder(), req)
+	out["client"] = got
+
+	req2 := httptest.NewRequest("GET", "http://x/", nil)
+	if c.tcip != "" {
+		req2.Header.Set("True-Client-IP", c.tcip)
+	}
+	if c.xrip != "" {
+		req2.Header.Set("X-Real-IP", c.xrip)
+	}
+	req2.Header.Set("X-Forwarded-For", c.xff[0])
+	var remote string
+	middleware.RealIP(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { remote = r.RemoteAddr })).ServeHTTP(httptest.NewRecorder(), req2)
+	out["realip"] = remote
+	return out
+}
+
+// judgeClientIP is the judge of the client IP family (the wide and the narrow property): the
+// shape first, then the library.
+func judgeClientIP(j *hzCaseJudge, c clientIPCase) {
+	shape := classify(c, clientIPExpected)
+	j.Shape(shape)
+	got := clientIPActual(c)
+	verdict(j, c, got, clientIPExpected(c, hzKnownNone), shape, clientIPExpected)
+	j.col.count(c.alt.kind + " " + strconv.FormatBool(got["client"] != ""))
+}
+
+// TestHegelClientIP: the ClientIPFrom* middlewares store the client IP their documentation
+// describes (the right-to-left walk, the trusted prefixes, the fail-closed rules) and RealIP
+// sets RemoteAddr from True-Client-IP, X-Real-IP or the first X-Forwarded-For entry. The shape
+// of chi/16 (a padded first entry) is drawn at its natural rate and filtered out under
+// HEGEL_NO_KNOWN=1.
+func TestHegelClientIP(t *testing.T) {
+	judged(t, withoutShapes(clientIPExpected, clientIPCases), judgeClientIP)
+}
+
+// --------------------------------------------------------------------------- request content checks
+
+var codings = []string{"gzip", "br", "deflate", "identity", "zstd", "GZIP", "x-gzip"}
+
+var charsetSpellings = []string{"utf-8", "UTF-8", "iso-8859-1", "us-ascii", "latin1"}
+
+var (
+	mediaTypes  = []string{"text/plain", "application/json", "Text/HTML", "application/x-www-form-urlencoded"}
+	firstParams = []string{"boundary=abc", "q=1", "version=2"}
+	paramSeps   = []string{";", "; ", " ; ", ";  "}
+	joiners     = []string{",", ", "}
+)
+
+// misleadingParam is a parameter before the charset whose value holds "charset=" (the shape of
+// chi/11 beside the quoted charset: contentEncoding cuts at the first "charset=" wherever it
+// is). The value is a quoted-string: the note's unquoted `boundary=charset=a` is not a media
+// type ("=" is not a tchar, RFC 9110 5.6.2; mime.ParseMediaType rejects it), the quoted one is.
+const misleadingParam = `boundary="charset=a"`
+
+// encodingField is one Content-Encoding field: 1..2 codings joined by "," or ", ".
+type encodingField struct {
+	codings []string
+	joiner  string
+}
+
+func (f encodingField) String() string { return strings.Join(f.codings, f.joiner) }
+
+// ctParam is one parameter of a Content-Type with the separator written before it.
+type ctParam struct {
+	sep  string
+	text string // "name=value", the value quoted or not
+}
+
+// contentType is a Content-Type: the media type and its parameters in order.
+type contentType struct {
+	typ    string
+	params []ctParam
+}
+
+func (ct contentType) String() string {
+	s := ct.typ
+	for _, p := range ct.params {
+		s += p.sep + p.text
+	}
+	return s
+}
+
+// The dice of the content checks: the alternative (AllowContentEncoding first), the body in
+// 80, 0..3 allowed codings, 0..2 fields of 1..2 codings each (the second at the rate today's
+// drawInt(1, 2) realised, 59 percent, the shape of chi/10 when both are allowed: off under
+// HEGEL_NO_KNOWN=1), the joiner; 0..3 charsets with "" among them, the Content-Type sent in 90,
+// a first parameter in 40 (the misleading one in 10 of those: chi/11, off under NO_KNOWN), the
+// charset in 75 (quoted in 30 of those: chi/11, off under NO_KNOWN), "x=y" in 30, each
+// parameter's separator from the four (OWS around the ";" is no shape of ContentCharset: its
+// split trims both pieces; it is one of Compress, below).
+var (
+	bodies           = hzFair(hzW(1, hegel.Just("")), hzW(4, hegel.Just("body")))                                                         // body 80 nominal: 1:4 realises 76.9
+	codingTable      = evenTree(codings...)                                                                                               // 14.3 each nominal: realises 12.2 to 16.4
+	secondCoding     = hzCoin(hzUnless(hzNoKnown, 80))                                                                                    // 59 nominal (today's rate): 80 realises 56.4
+	joinerTable      = evenOver(joiners...)                                                                                               // 50 each nominal: realises 52.2/47.8
+	charsetListTable = evenTree(append(append([]string(nil), charsetSpellings...), "")...)                                                // the spellings and the empty entry, 16.7 each nominal
+	mediaTypeTable   = evenTree(mediaTypes...)                                                                                            // 25 each nominal: realises 23.3/27.3/26.1/23.3
+	sepTable         = evenTree(paramSeps...)                                                                                             // 25 each nominal: realises 30.2/27.2/22.2/20.4
+	firstParamTable  = hzFair(hzW(8, fairOver([]int{3, 4, 4}, firstParams...)), hzW(hzUnless(hzNoKnown, 1), hegel.Just(misleadingParam))) // the misleading one 10 nominal: 8:1 realises 9.9; the plain three 30 each: 3/4/4 realises 29.4/29.4/31.4
+	withFirstParam   = hzCoin(54)                                                                                                         // 40 nominal: 54 realises 40.9
+	withCharset      = hzCoin(96)                                                                                                         // 75 nominal: 96 realises 72.9
+	charsetTable     = evenOver(charsetSpellings...)                                                                                      // 20 each nominal
+	quotedCharset    = hzCoin(hzUnless(hzNoKnown, 38))                                                                                    // 30 nominal: 38 realises 27.2
+	withXY           = hzCoin(41)                                                                                                         // 30 nominal: 41 realises 27.9
+	ctSent           = hzCoin(98)                                                                                                         // 90 nominal: 98 realises 91.1
+)
+
+// encodingFields: a field of one coding, a second in 59.
+var encodingFields = hegel.Composite(func(tc hegel.TestCase) encodingField {
+	f := encodingField{codings: []string{hegel.Draw(tc, codingTable)}}
+	if hegel.Draw(tc, secondCoding) {
+		f.codings = append(f.codings, hegel.Draw(tc, codingTable))
+	}
+	f.joiner = hegel.Draw(tc, joinerTable)
+	return f
+})
+
+// contentTypes: a media type with its parameters (a first one, the charset, "x=y"), each with
+// its separator.
+var contentTypes = hegel.Composite(func(tc hegel.TestCase) contentType {
+	ct := contentType{typ: hegel.Draw(tc, mediaTypeTable)}
+	if hegel.Draw(tc, withFirstParam) {
+		ct.params = append(ct.params, ctParam{sep: hegel.Draw(tc, sepTable), text: hegel.Draw(tc, firstParamTable)})
+	}
+	if hegel.Draw(tc, withCharset) {
+		v := hegel.Draw(tc, charsetTable)
+		if hegel.Draw(tc, quotedCharset) {
+			v = `"` + v + `"`
+		}
+		ct.params = append(ct.params, ctParam{sep: hegel.Draw(tc, sepTable), text: "charset=" + v})
+	}
+	if hegel.Draw(tc, withXY) {
+		ct.params = append(ct.params, ctParam{sep: hegel.Draw(tc, sepTable), text: "x=y"})
+	}
+	return ct
+})
+
+// contentCase: a request content check: AllowContentEncoding(allowed...) on a request with the
+// Content-Encoding fields, or ContentCharset(charsets...) on one with the Content-Type (nil: no
+// header); the body "body" or empty.
+type contentCase struct {
+	kind     string // "encoding" or "charset"
+	body     string
+	allowed  []string
+	fields   []encodingField
+	charsets []string
+	ct       *contentType
+}
+
+func (c contentCase) fieldTexts() []string {
+	out := make([]string, len(c.fields))
+	for i, f := range c.fields {
+		out[i] = f.String()
+	}
+	return out
+}
+
+func (c contentCase) ctText() string {
+	if c.ct == nil {
+		return ""
+	}
+	return c.ct.String()
+}
+
+func (c contentCase) GoString() string {
+	if c.kind == "encoding" {
+		return fmt.Sprintf("AllowContentEncoding(%q) with Content-Encoding %q, body %q", c.allowed, c.fieldTexts(), c.body)
+	}
+	if c.ct == nil {
+		return fmt.Sprintf("ContentCharset(%q) with no Content-Type, body %q", c.charsets, c.body)
+	}
+	return fmt.Sprintf("ContentCharset(%q) with Content-Type %q, body %q", c.charsets, c.ct.String(), c.body)
+}
+
+var (
+	encodingCases = hegel.Composite(func(tc hegel.TestCase) contentCase {
+		return contentCase{
+			kind:    "encoding",
+			body:    hegel.Draw(tc, bodies),
+			allowed: hegel.Draw(tc, countedBy(codingTable, 0, 2, 2, 2, 2)), // 0..3 at 25 nominal: 2/2/2/2 realises 24.9/25.7/24.1/25.3
+			fields:  hegel.Draw(tc, countedBy(encodingFields, 0, 4, 4, 4)), // 0..2 at 33 nominal: 4/4/4 realises 31.1/34.6/34.3
+		}
+	})
+	charsetCases = hegel.Composite(func(tc hegel.TestCase) contentCase {
+		c := contentCase{
+			kind:     "charset",
+			body:     hegel.Draw(tc, bodies),
+			charsets: hegel.Draw(tc, fairCounted(charsetListTable, 0, 3)), // 0..3 at 25 nominal: realises 26.9/24.7/24.2/24.2
+		}
+		if hegel.Draw(tc, ctSent) {
+			ct := hegel.Draw(tc, contentTypes)
+			c.ct = &ct
+		}
+		return c
+	})
+	contentCases = hzFair(hzW(1, encodingCases), hzW(1, charsetCases)) // 50 each nominal: realises 51.2/48.8
+)
+
+// allowedCodings is AllowContentEncoding as documented: "enforces a whitelist of request
+// Content-Encoding", a list field (RFC 9110 8.4: 1#content-coding) split at commas, each coding
+// trimmed and compared case-insensitively with the allowed ones (trimmed); 200 when every
+// coding of every field is allowed, else 415.
+func allowedCodings(allowed []string, fields []encodingField) int {
+	for _, f := range fields {
+		for _, e := range strings.Split(f.String(), ",") {
+			found := false
+			for _, a := range allowed {
+				if strings.EqualFold(strings.TrimSpace(a), strings.TrimSpace(e)) {
+					found = true
+				}
+			}
+			if !found {
+				return 415
+			}
+		}
+	}
+	return 200
+}
+
+// libAllowContentEncoding is the replica of AllowContentEncoding (content_encoding.go lines
+// 11-29): the allowed set of each coding lowercased and trimmed, and each WHOLE field of
+// r.Header["Content-Encoding"], lowercased and trimmed, looked up in it (chi/10).
+func libAllowContentEncoding(contentEncoding []string, requestEncodings []string) int {
+	allowedEncodings := make(map[string]struct{}, len(contentEncoding))
+	for _, encoding := range contentEncoding {
+		allowedEncodings[strings.TrimSpace(strings.ToLower(encoding))] = struct{}{}
+	}
+	for _, encoding := range requestEncodings {
+		if _, ok := allowedEncodings[strings.TrimSpace(strings.ToLower(encoding))]; !ok {
+			return http.StatusUnsupportedMediaType
+		}
+	}
+	return 200
+}
+
+// charsetAllowed is ContentCharset as documented (content_charset.go's doc comment: "writes a
+// 415 Unsupported Media Type response if none of the charsets match. An empty charset will
+// allow requests with no Content-Type header or no specified charset"): the charset parameter
+// of the Content-Type as mime.ParseMediaType reads it (a token or a quoted-string, RFC 9110
+// 8.3.1 and 5.6.6), compared case-insensitively with the list; with no Content-Type or no
+// charset parameter the list must hold "". (A Content-Type mime rejects is assumed away by the
+// judge before the model is asked; here it reads as no charset.)
+func charsetAllowed(charsets []string, ct *contentType) int {
+	cs := ""
+	if ct != nil {
+		if _, params, err := mime.ParseMediaType(ct.String()); err == nil {
+			cs = strings.ToLower(params["charset"])
+		}
+	}
+	for _, a := range charsets {
+		if strings.ToLower(a) == cs {
+			return 200
+		}
+	}
+	return 415
+}
+
+// libContentCharset is the replica of ContentCharset's check (content_charset.go lines 13-15
+// and 24-27): the list lowercased, then contentEncoding of r.Header.Get("Content-Type").
+func libContentCharset(charsets []string, ct string) int {
+	lowered := make([]string, len(charsets))
+	for i, c := range charsets {
+		lowered[i] = strings.ToLower(c)
+	}
+	if !libContentEncoding(ct, lowered...) {
+		return http.StatusUnsupportedMediaType
+	}
+	return 200
+}
+
+// libContentEncoding is contentEncoding (content_charset.go lines 35-40): the Content-Type
+// lowercased, cut at the first ";", then at "charset=", then at the next ";", the piece looked
+// up as is - so a quoted-string keeps its quotes and a value holding "charset=" misleads the
+// cut (chi/11).
+func libContentEncoding(ce string, charsets ...string) bool {
+	_, ce = libSplit(strings.ToLower(ce), ";")
+	_, ce = libSplit(ce, "charset=")
+	ce, _ = libSplit(ce, ";")
+	for _, c := range charsets {
+		if c == ce {
+			return true
+		}
+	}
+	return false
+}
+
+// libSplit is split (content_charset.go lines 43-51).
+func libSplit(str, sep string) (string, string) {
+	a, b, found := strings.Cut(str, sep)
+	a = strings.TrimSpace(a)
+	if found {
+		b = strings.TrimSpace(b)
+	}
+	return a, b
+}
+
+// contentExpected: the status the check answers, by the model under the switch set. A request
+// without a body (ContentLength 0) is always allowed by both middlewares.
+func contentExpected(c contentCase, k known) checks {
+	out := checks{}
+	out.set("status", contentStatus(c, k))
+	return out
+}
+
+func contentStatus(c contentCase, k known) int {
+	if c.body == "" {
+		return 200
+	}
+	if c.kind == "encoding" {
+		if k[kEncodingListUnsplit] {
+			return libAllowContentEncoding(c.allowed, c.fieldTexts())
+		}
+		return allowedCodings(c.allowed, c.fields)
+	}
+	if k[kCharsetSubstring] {
+		return libContentCharset(c.charsets, c.ctText())
+	}
+	return charsetAllowed(c.charsets, c.ct)
+}
+
+// contentActual asks the library: the middleware of the case on a POST with the body and the
+// headers.
+func contentActual(c contentCase) checks {
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200) })
+	req := httptest.NewRequest("POST", "http://x/", strings.NewReader(c.body))
+	var h http.Handler
+	if c.kind == "encoding" {
+		for _, f := range c.fields {
+			req.Header.Add("Content-Encoding", f.String())
+		}
+		h = middleware.AllowContentEncoding(c.allowed...)(ok)
+	} else {
+		if c.ct != nil {
+			req.Header.Set("Content-Type", c.ct.String())
+		}
+		h = middleware.ContentCharset(append([]string(nil), c.charsets...)...)(ok) // ContentCharset lowercases its argument in place
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	out := checks{}
+	out.set("status", rec.Code)
+	return out
+}
+
+// judgeContent is the judge of the content family: a Content-Type mime.ParseMediaType rejects
+// is assumed away (counted; none of the drawn spellings is one), the shape, then the library.
+func judgeContent(j *hzCaseJudge, c contentCase) {
+	if c.kind == "charset" && c.ct != nil {
+		if _, _, err := mime.ParseMediaType(c.ct.String()); err != nil {
+			hzTally("assumed unparseable content type")
+			j.ht.Assume(false)
+		}
+	}
+	shape := classify(c, contentExpected)
+	j.Shape(shape)
+	got := contentActual(c)
+	verdict(j, c, got, contentExpected(c, hzKnownNone), shape, contentExpected)
+	j.col.count(c.kind + " " + got["status"])
+}
+
+// TestHegelContentChecks: AllowContentEncoding admits a request exactly when every coding of
+// its Content-Encoding list is allowed, and ContentCharset exactly when the charset parameter
+// of its Content-Type (as a media type parses) is in the list, or "" is and there is none. The
+// shapes of chi/10 (a field of two allowed codings) and chi/11 (a quoted charset, a parameter
+// value holding "charset=") are drawn at their natural rates and off under HEGEL_NO_KNOWN=1.
+func TestHegelContentChecks(t *testing.T) {
+	judged(t, withoutShapes(contentExpected, contentCases), judgeContent)
+}
+
+// --------------------------------------------------------------------------- Compress
+
+var compressibleTypes = []string{"text/html", "text/css", "text/plain", "text/javascript", "text/markdown", "text/csv", "text/vtt", "application/javascript", "application/x-javascript", "application/json", "application/atom+xml", "application/rss+xml", "application/xml", "text/xml", "image/svg+xml"}
+
+// responseTypes: the Content-Type the handler sets; three are the shape of chi/13 (a capital
+// or OWS before the ";": "text/html ; charset=utf-8", "Text/HTML", "APPLICATION/JSON"), off
+// under HEGEL_NO_KNOWN=1. "text/html;" with its empty parameter is text/html with no parameter
+// to mime.ParseMediaType (a trailing ";" is ignored) and to chi's cut alike: no shape.
+var responseTypes = []string{"text/html", "text/html; charset=utf-8", "text/html ; charset=utf-8", "Text/HTML", "application/json", "APPLICATION/JSON", "image/png", "application/octet-stream", "text/plain;charset=us-ascii", "image/svg+xml", "text/html;"}
+
+var (
+	aeCodings = []string{"gzip", "deflate", "br", "identity", "*", "x-gzip", "GZIP", "zstd", "Deflate"}
+	aeQValues = []string{";q=0", ";q=0.5", ";q=1", ";q=0.0", "; q=0", ";q=1.0"}
+)
+
+// aeElement is one element of Accept-Encoding: a coding, its q parameter as spelled ("" for
+// none), a leading space.
+type aeElement struct {
+	coding string
+	q      string
+	space  bool
+}
+
+func (e aeElement) String() string {
+	s := e.coding + e.q
+	if e.space {
+		s = " " + s
+	}
+	return s
+}
+
+// The dice of Compress: 0..3 elements, each a coding of the nine ("*" is the shape of chi/12,
+// off under NO_KNOWN), a q parameter in 40 from the six (the three zero weights are the shape of
+// chi/12, off under NO_KNOWN), a leading space in 30; the response type from the eleven (the
+// three of chi/13 off under NO_KNOWN); the body 3..8 characters of "abc " repeated forty times.
+var (
+	aeCodingTable     = fairTree([]int{2, 3, 3, 3, hzUnless(hzNoKnown, 4), 5, 3, 4, 5}, aeCodings...)                                                     // 11.1 each nominal: realises 8.2 to 13.3
+	aeQTable          = fairTree([]int{hzUnless(hzNoKnown, 1), 1, 1, hzUnless(hzNoKnown, 1), hzUnless(hzNoKnown, 1), 1}, aeQValues...)                    // 16.7 each nominal: realises 14.9 to 18.4
+	withQ             = hzCoin(52)                                                                                                                        // 40 nominal: 52 realises 40.5
+	withSpace         = hzCoin(39)                                                                                                                        // 30 nominal: 39 realises 27.7
+	responseTypeTable = fairTree([]int{1, 1, hzUnless(hzNoKnown, 1), hzUnless(hzNoKnown, 2), 2, hzUnless(hzNoKnown, 2), 2, 2, 2, 2, 2}, responseTypes...) // 9.1 each nominal: realises 6.7 to 11.3
+	compressBodies    = hegel.Map(text("abc ", 3, 8), func(s string) string { return strings.Repeat(s, 40) })
+)
+
+var aeElements = hegel.Composite(func(tc hegel.TestCase) aeElement {
+	e := aeElement{coding: hegel.Draw(tc, aeCodingTable)}
+	if hegel.Draw(tc, withQ) {
+		e.q = hegel.Draw(tc, aeQTable)
+	}
+	e.space = hegel.Draw(tc, withSpace)
+	return e
+})
+
+// compressCase: the Accept-Encoding elements of the request, the Content-Type and the body the
+// handler writes.
+type compressCase struct {
+	ae   []aeElement
+	ct   string
+	body string
+}
+
+func (c compressCase) acceptEncoding() string {
+	parts := make([]string, len(c.ae))
+	for i, e := range c.ae {
+		parts[i] = e.String()
+	}
+	return strings.Join(parts, ",")
+}
+
+func (c compressCase) GoString() string {
+	return fmt.Sprintf("Compress(5) with Accept-Encoding %q, Content-Type %q, body %q", c.acceptEncoding(), c.ct, c.body)
+}
+
+var compressCases = hegel.Composite(func(tc hegel.TestCase) compressCase {
+	return compressCase{
+		ae:   hegel.Draw(tc, countedBy(aeElements, 0, 5, 5, 4, 4)), // 0..3 at 25 nominal: 5/5/4/4 realises 31.1/21.9/26.0/21.0 (the first die of the case; moved five points between rounds)
+		ct:   hegel.Draw(tc, responseTypeTable),
+		body: hegel.Draw(tc, compressBodies),
+	}
+})
+
+// acceptable is RFC 9110 12.5.3: the coding listed with a non-zero weight, or "*" with a
+// non-zero weight when the coding is not listed (x-gzip is gzip, 18.3).
+func acceptable(header, coding string) bool {
+	star := false
+	listed := false
+	accept := false
+	for _, e := range strings.Split(header, ",") {
+		tok, params, _ := strings.Cut(e, ";")
+		tok = strings.ToLower(strings.TrimSpace(tok))
+		q := 1.0
+		for _, p := range strings.Split(params, ";") {
+			k, v, ok := strings.Cut(strings.TrimSpace(p), "=")
+			if ok && strings.EqualFold(strings.TrimSpace(k), "q") {
+				if f, err := strconv.ParseFloat(strings.TrimSpace(v), 64); err == nil {
+					q = f
+				}
+			}
+		}
+		if tok == coding || (coding == "gzip" && tok == "x-gzip") {
+			listed = true
+			if q > 0 {
+				accept = true
+			}
+		}
+		if tok == "*" && q > 0 {
+			star = true
+		}
+	}
+	if listed {
+		return accept
+	}
+	return star
+}
+
+// encoderPrecedence is Compress's order: gzip, then deflate (compress.go: each SetEncoder
+// prepends, deflate is set first).
+var encoderPrecedence = []string{"gzip", "deflate"}
+
+// chosenEncoding is the coding Compress encodes with: documented ("based on Accept-Encoding
+// request header") the first of gzip, deflate that is acceptable (RFC 9110 12.5.3). Under
+// kAcceptEncodingSubstring the replica of selectEncoder and matchAcceptEncoding (compress.go
+// lines 232-239 and 260-267): the header lowercased and split at commas, the first encoder
+// whose name is a substring of an element, so q=0 does not exclude and "*" selects nothing
+// (chi/12).
+func chosenEncoding(header string, substring bool) string {
+	if substring {
+		accepted := strings.Split(strings.ToLower(header), ",")
+		for _, name := range encoderPrecedence {
+			if libMatchAcceptEncoding(accepted, name) {
+				return name
+			}
+		}
+		return ""
+	}
+	for _, name := range encoderPrecedence {
+		if acceptable(header, name) {
+			return name
+		}
+	}
+	return ""
+}
+
+func libMatchAcceptEncoding(accepted []string, encoding string) bool {
+	for _, v := range accepted {
+		if strings.Contains(v, encoding) {
+			return true
+		}
+	}
+	return false
+}
+
+// compressible is whether Compress(5) compresses a response of the Content-Type: documented,
+// its media type (mime.ParseMediaType: case-insensitive, OWS allowed before the parameters,
+// RFC 9110 8.3.1) is in the default list. Under kContentTypeExact the replica of
+// isCompressible (compress.go lines 294-308): the header cut at the first ";" and looked up as
+// is in the allowed set, else its type (before the "/") in the wildcard set, which Compress(5)
+// leaves empty (chi/13).
+func compressible(ct string, exact bool) bool {
+	if exact {
+		return libCompressible(ct)
+	}
+	mt, _, err := mime.ParseMediaType(ct)
+	if err != nil {
+		return false
+	}
+	for _, t := range compressibleTypes {
+		if t == mt {
+			return true
+		}
+	}
+	return false
+}
+
+func libCompressible(contentType string) bool {
+	contentTypes := map[string]struct{}{}
+	for _, t := range compressibleTypes {
+		contentTypes[t] = struct{}{}
+	}
+	contentWildcards := map[string]struct{}{}
+	contentType, _, _ = strings.Cut(contentType, ";")
+	if _, ok := contentTypes[contentType]; ok {
+		return true
+	}
+	if contentType, _, hadSlash := strings.Cut(contentType, "/"); hadSlash {
+		_, ok := contentWildcards[contentType]
+		return ok
+	}
+	return false
+}
+
+// compressExpected: the Content-Encoding of the response, whether its body decodes to what the
+// handler wrote ("ok", the library's own consistency) and Vary ("Accept-Encoding" when
+// encoded), by the model under the switch set.
+func compressExpected(c compressCase, k known) checks {
+	enc := ""
+	if compressible(c.ct, k[kContentTypeExact]) {
+		enc = chosenEncoding(c.acceptEncoding(), k[kAcceptEncodingSubstring])
+	}
+	vary := ""
+	if enc != "" {
+		vary = "Accept-Encoding"
+	}
+	return checks{"encoding": enc, "body": "ok", "vary": vary}
+}
+
+// compressActual asks the library: Compress(5) around a handler setting the Content-Type and
+// writing the body; the body is decoded by the encoding the response names.
+func compressActual(c compressCase) checks {
+	h := middleware.Compress(5)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", c.ct)
+		w.Write([]byte(c.body))
+	}))
+	req := httptest.NewRequest("GET", "http://x/", nil)
+	req.Header.Set("Accept-Encoding", c.acceptEncoding())
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	got := rec.Header().Get("Content-Encoding")
+	var decoded []byte
+	var err error
+	switch got {
+	case "gzip":
+		var zr *gzip.Reader
+		zr, err = gzip.NewReader(bytes.NewReader(rec.Body.Bytes()))
+		if err == nil {
+			decoded, err = io.ReadAll(zr)
+		}
+	case "deflate":
+		decoded, err = io.ReadAll(flate.NewReader(bytes.NewReader(rec.Body.Bytes())))
+	default:
+		decoded = rec.Body.Bytes()
+	}
+	body := "ok"
+	if err != nil {
+		body = "error: " + err.Error()
+	} else if string(decoded) != c.body {
+		body = fmt.Sprintf("decodes to %q", decoded)
+	}
+	return checks{"encoding": got, "body": body, "vary": rec.Header().Get("Vary")}
+}
+
+// judgeCompress is the judge of the Compress family.
+func judgeCompress(j *hzCaseJudge, c compressCase) {
+	shape := classify(c, compressExpected)
+	j.Shape(shape)
+	got := compressActual(c)
+	verdict(j, c, got, compressExpected(c, hzKnownNone), shape, compressExpected)
+	if got["encoding"] == "" {
+		j.col.count("not compressed")
+	} else {
+		j.col.count(got["encoding"])
+	}
+}
+
+// TestHegelCompress: Compress encodes a response of a compressible media type with the first of
+// gzip, deflate the request accepts (RFC 9110 12.5.3), the body decodes, and Vary names
+// Accept-Encoding. The shapes of chi/12 (a zero weight, "*") and chi/13 (a capital or OWS in
+// the Content-Type) are drawn at their natural rates and off under HEGEL_NO_KNOWN=1.
+func TestHegelCompress(t *testing.T) {
+	judged(t, withoutShapes(compressExpected, compressCases), judgeCompress)
+}
+
+// --------------------------------------------------------------------------- RouteHeaders
+
+var (
+	headerNames       = []string{"X-A", "X-B"}
+	headerPatterns    = []string{"a", "a*", "*b", "*", "a*b", "ab", "x*b*"}
+	capitalPatterns   = []string{"A", "A*"} // the shape of chi/14, off under NO_KNOWN
+	headerValues      = []string{"a", "ab", "b", "axb", "A", "AB", "", "xbb", "c"}
+	allHeaderPatterns = append(append([]string(nil), headerPatterns...), capitalPatterns...)
+)
+
+// headerRoute is one route of a HeaderRouter: Route(header, pattern) or RouteAny(header,
+// [pattern, "zzz"]) (any), its middleware answering the tag.
+type headerRoute struct {
+	header  string
+	pattern string
+	tag     string
+	any     bool
+}
+
+func (r headerRoute) String() string {
+	if r.any {
+		return fmt.Sprintf("RouteAny(%s, [%s zzz]) %s", r.header, r.pattern, r.tag)
+	}
+	return fmt.Sprintf("Route(%s, %s) %s", r.header, r.pattern, r.tag)
+}
+
+// headerRouteCase: the routes in registration order, whether a default is set, and the value
+// sent for each header name ("" for none).
+type headerRouteCase struct {
+	routes []headerRoute
+	def    bool
+	sent   []string
+}
+
+func (c headerRouteCase) sentValue(header string) string {
+	for i, n := range headerNames {
+		if n == header {
+			return c.sent[i]
+		}
+	}
+	return ""
+}
+
+func (c headerRouteCase) GoString() string {
+	var b strings.Builder
+	b.WriteString("RouteHeaders()")
+	for _, r := range c.routes {
+		fmt.Fprintf(&b, ".%s", r)
+	}
+	if c.def {
+		b.WriteString(".RouteDefault(default)")
+	}
+	b.WriteString(" with")
+	for i, n := range headerNames {
+		if c.sent[i] != "" {
+			fmt.Fprintf(&b, " %s: %q", n, c.sent[i])
+		}
+	}
+	return b.String()
+}
+
+// The dice of RouteHeaders: 1..4 routes over the two names and the seven patterns (nine with
+// "A" and "A*", 2/9, the shape of chi/14: off under NO_KNOWN), Route in 80 and RouteAny in 20,
+// a default in 40, each header sent in 70 with one of the nine values ("" is not sent).
+var (
+	headerNameTable    = evenOver(headerNames...)                                                                                   // 50 each nominal: realises 49.3/50.7
+	headerPatternTable = fairTree([]int{1, 1, 1, 1, 1, 1, 1, hzUnless(hzNoKnown, 1), hzUnless(hzNoKnown, 1)}, allHeaderPatterns...) // 11.1 each nominal: realises 8.9 to 12.8
+	routeAnys          = hzCoin(24)                                                                                                 // 20 nominal: 24 realises 18.2
+	withDefault        = hzCoin(51)                                                                                                 // 40 nominal: 51 realises 41.3
+	headerValueTable   = evenTree(headerValues...)                                                                                  // 11.1 each nominal: the eight non-empty realise 11.9 to 13.0 of the sent values
+	sentValues         = hzMaybe(95, headerValueTable)                                                                              // 70 nominal: 95 realises 71.9 (X-A) and 69.1 (X-B)
+)
+
+var headerRoutes = hegel.Composite(func(tc hegel.TestCase) headerRoute {
+	return headerRoute{header: hegel.Draw(tc, headerNameTable), pattern: hegel.Draw(tc, headerPatternTable), any: hegel.Draw(tc, routeAnys)}
+})
+
+// taggedRoutes gives the routes their tags, h0...
+func taggedRoutes(rs []headerRoute) []headerRoute {
+	out := append([]headerRoute(nil), rs...)
+	for i := range out {
+		out[i].tag = "h" + strconv.Itoa(i)
+	}
+	return out
+}
+
+var headerRouteCases = hegel.Composite(func(tc hegel.TestCase) headerRouteCase {
+	return headerRouteCase{
+		routes: taggedRoutes(hegel.Draw(tc, fairCounted(headerRoutes, 1, 4))), // 1..4 at 25 nominal: realises 24.0/24.7/23.0/28.4
+		def:    hegel.Draw(tc, withDefault),
+		sent:   []string{hegel.Draw(tc, sentValues), hegel.Draw(tc, sentValues)},
+	}
+})
+
+// libPattern is Pattern with NewPattern and Match (route_headers.go lines 129-146): the text
+// before the first "*" a prefix, the text after it a suffix; without a "*" the whole pattern
+// equals the value.
+type libPattern struct {
+	prefix   string
+	suffix   string
+	wildcard bool
+}
+
+func newLibPattern(value string) libPattern {
+	p := libPattern{}
+	p.prefix, p.suffix, p.wildcard = strings.Cut(value, "*")
+	return p
+}
+
+func (p libPattern) Match(v string) bool {
+	if !p.wildcard {
+		return p.prefix == v
+	}
+	return len(v) >= len(p.prefix+p.suffix) && strings.HasPrefix(v, p.prefix) && strings.HasSuffix(v, p.suffix)
+}
+
+// matchPattern is whether the lowercased header value v matches the route's pattern:
+// documented (the Host example of the doc comment, "example.com" and "*.example.com", and the
+// value lowercased by Handler) both sides case-insensitively, the pattern lowercased too; under
+// kHeaderPatternCase the replica: NewPattern keeps the pattern as given (route_headers.go line
+// 54 and 137), so a capital in it never matches (chi/14).
+func matchPattern(pattern, v string, asGiven bool) bool {
+	if !asGiven {
+		pattern = strings.ToLower(pattern)
+	}
+	return newLibPattern(pattern).Match(v)
+}
+
+// routedBody is the body the request is answered with: documented ("find first matching header
+// route": the routes in registration order), the first matching route of the first header in
+// registration order whose sent value matches, else the default, else "next" (the handler
+// behind the router). Under kHeaderRouteMapOrder the replica of Handler's `for header,
+// matchers := range hr` (route_headers.go line 86), which visits the headers in Go's map order:
+// the SET of the outcomes over the headers that carry a matching route, joined with "|" in
+// registration order - a different value whenever two headers would route (chi/4), each serve's
+// body being one of the set (the first about seven times in eight), so the set of the bodies
+// of thirty serves (headerRouteActual) is the replica's set with near certainty.
+func routedBody(c headerRouteCase, k known) string {
+	var outcomes []string
+	seen := map[string]bool{}
+	for _, r := range c.routes {
+		if seen[r.header] {
+			continue
+		}
+		seen[r.header] = true
+		v := strings.ToLower(c.sentValue(r.header))
+		if v == "" {
+			continue
+		}
+		for _, rr := range c.routes {
+			if rr.header == r.header && matchPattern(rr.pattern, v, k[kHeaderPatternCase]) {
+				outcomes = append(outcomes, rr.tag)
+				break
+			}
+		}
+	}
+	if len(outcomes) == 0 {
+		if c.def {
+			return "default"
+		}
+		return "next"
+	}
+	if k[kHeaderRouteMapOrder] {
+		set := map[string]bool{}
+		for _, o := range outcomes {
+			set[o] = true
+		}
+		return strings.Join(c.bodiesInOrder(set), "|")
+	}
+	return outcomes[0]
+}
+
+// headerRouteExpected: the body served, by the model under the switch set.
+func headerRouteExpected(c headerRouteCase, k known) checks {
+	return checks{"route": routedBody(c, k)}
+}
+
+// headerRouteAgrees is the replica agreement of this family: a set value ("h0|h2", the shape
+// of chi/4) agrees with the library when the set of the bodies observed is a SUBSET of it (the
+// thirty serves miss a member of the set in (7/8)^30 of the cases, about 2 percent: the
+// collector counted 57 of 3000 shaped cases of the narrow property with one body seen at seed
+// 77, 70 unseeded).
+func headerRouteAgrees(got, replica checks) bool {
+	if len(got) != len(replica) {
+		return false
+	}
+	for k, want := range replica {
+		g, ok := got[k]
+		if !ok {
+			return false
+		}
+		if k == "route" && strings.Contains(want, "|") {
+			if !isSubset(strings.Split(g, "|"), strings.Split(want, "|")) {
+				return false
+			}
+			continue
+		}
+		if g != want {
+			return false
+		}
+	}
+	return true
+}
+
+// isSubset is whether every element of xs is among ys.
+func isSubset(xs, ys []string) bool {
+	for _, x := range xs {
+		found := false
+		for _, y := range ys {
+			if x == y {
+				found = true
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	return true
+}
+
+func tagMiddleware(tag string) func(http.Handler) http.Handler {
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte(tag)) })
+	}
+}
+
+// headerRouteServes is how many times headerRouteActual serves the request: the library's
+// value is the set of the distinct bodies observed (the file comment: the library's map-order
+// choice of chi/4 is realised in full with probability 1 - (7/8)^30, about 98 percent).
+const headerRouteServes = 30
+
+// headerRouteActual asks the library: the router built from the routes serves a request with
+// the headers sent, thirty times, a fresh recorder each time; the value is the set of the
+// distinct bodies observed in registration order ("h0|h2"; one body for a deterministic
+// router).
+func headerRouteActual(c headerRouteCase) checks {
+	hr := middleware.RouteHeaders()
+	for _, r := range c.routes {
+		if r.any {
+			hr = hr.RouteAny(r.header, []string{r.pattern, "zzz"}, tagMiddleware(r.tag))
+		} else {
+			hr = hr.Route(r.header, r.pattern, tagMiddleware(r.tag))
+		}
+	}
+	if c.def {
+		hr = hr.RouteDefault(tagMiddleware("default"))
+	}
+	req := httptest.NewRequest("GET", "http://x/", nil)
+	for i, n := range headerNames {
+		if c.sent[i] != "" {
+			req.Header.Set(n, c.sent[i])
+		}
+	}
+	h := hr.Handler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("next")) }))
+	seen := map[string]bool{}
+	for i := 0; i < headerRouteServes; i++ {
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		seen[rec.Body.String()] = true
+	}
+	return checks{"route": strings.Join(c.bodiesInOrder(seen), "|")}
+}
+
+// bodiesInOrder lists the bodies of a set in registration order of the routes, then the
+// default and the next handler, then anything else (none expected) sorted: the one order of
+// the replica's set and of the set observed, so that the two compare as text.
+func (c headerRouteCase) bodiesInOrder(seen map[string]bool) []string {
+	order := make([]string, 0, len(c.routes)+2)
+	for _, r := range c.routes {
+		order = append(order, r.tag)
+	}
+	order = append(order, "default", "next")
+	var out []string
+	listed := map[string]bool{}
+	for _, b := range order {
+		if seen[b] && !listed[b] {
+			out = append(out, b)
+			listed[b] = true
+		}
+	}
+	var rest []string
+	for b := range seen {
+		if !listed[b] {
+			rest = append(rest, b)
+		}
+	}
+	sort.Strings(rest)
+	return append(out, rest...)
+}
+
+// judgeHeaderRoute is the judge of the RouteHeaders family: the shape first, then the library;
+// the replica of chi/4 is a set, so its agreement is the observed set being a subset of it (the
+// collector counts the shaped cases by whether every body of the set was seen in the thirty
+// serves, or one alone; a capital pattern beside leaves the replica one body, chi/14's rule).
+func judgeHeaderRoute(j *hzCaseJudge, c headerRouteCase) {
+	shape := classify(c, headerRouteExpected)
+	j.Shape(shape)
+	got := headerRouteActual(c)
+	verdictBy(j, c, got, headerRouteExpected(c, hzKnownNone), shape, headerRouteExpected, headerRouteAgrees)
+	switch {
+	case shape == "chi/4":
+		switch replica := headerRouteExpected(c, hzKnownAll)["route"]; {
+		case !strings.Contains(replica, "|"):
+			j.col.count("both headers routed, one answered")
+		case got["route"] == replica:
+			j.col.count("both headers routed, both bodies seen")
+		default:
+			j.col.count("both headers routed, one body seen")
+		}
+	case got["route"] == "next" || got["route"] == "default":
+		j.col.count("no match")
+	default:
+		j.col.count("routed")
+	}
+}
+
+// TestHegelRouteHeaders: RouteHeaders serves a request by the first route, in registration
+// order, whose header is sent with a matching value (patterns and values compared
+// case-insensitively, "*" a wildcard), else the default, else the next handler, the same body
+// on every one of thirty serves. The shape of chi/14 (a capital in a pattern) is drawn at its
+// natural rate and off under HEGEL_NO_KNOWN=1; the shape of chi/4 (two headers each with a
+// matching route) is named by the classifier, fails when the thirty serves see both headers'
+// bodies (about 98 percent of the shaped cases: 230 named of 3000 at seed 77 before and after
+// the thirty serves, 65 of them failing served once, 227 served thirty times) and is filtered
+// out under HEGEL_NO_KNOWN=1.
+func TestHegelRouteHeaders(t *testing.T) {
+	judged(t, withoutShapes(headerRouteExpected, headerRouteCases), judgeHeaderRoute)
+}
