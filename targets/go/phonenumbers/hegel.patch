+package phonenumbers_test
+
+// Hegel property tests for nyaruka/phonenumbers, written for the Hegel zoo; see
+// targets/go/phonenumbers/README.md. The oracle is Python's phonenumbers (hegel_oracle_test.go),
+// the other libphonenumber port at the same metadata version; the Java reference arbitrated
+// every disagreement between the two ports.
+//
+// Every property draws one case record built from the binding's combinators. A candidate text
+// is a record: random digits in a region, or a seed number of the library's own metadata either
+// formatted by the library or with its national number edited, grouped and prefixed; plus a
+// decoration record (a tel: context, an extension, noise around, a vanity word, lower case),
+// rendered by a pure function. A number query, a helper case, an as-you-type case and a matcher
+// case are records around candidates. The shapes of the recorded bugs (bugs.toml) are drawn by
+// default and the properties that meet them fail, naming the shape; HEGEL_NO_KNOWN=1 switches
+// the shapes off (noKnown, below). hegel_shapes_test.go has a narrow property per bug.
+//
+// hegel-go reads no environment variable itself, so HEGEL_TEST_CASES goes through hegelOpts; a
+// panic in the code under test is turned into a failure of the current case by property().
+// ZOO_COLLECT=1 makes the properties print their mismatches instead of failing.
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	. "github.com/nyaruka/phonenumbers/v2"
+	"github.com/nyaruka/phonenumbers/v2/carrier"
+	"github.com/nyaruka/phonenumbers/v2/geocoding"
+	"github.com/nyaruka/phonenumbers/v2/timezone"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T), opts ...hegel.Option) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, append(hegelOpts(), opts...)...)
+}
+
+// fail reports a mismatch; under ZOO_COLLECT=1 it prints a COLLECT line once per distinct message
+// and lets the test case go on, so one run shows every kind of mismatch.
+var collect = os.Getenv("ZOO_COLLECT") != ""
+var seen = map[string]bool{}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collect {
+		key := msg
+		if len(key) > 200 {
+			key = key[:200]
+		}
+		if !seen[key] {
+			seen[key] = true
+			fmt.Println("COLLECT " + strings.ReplaceAll(msg, "\n", " "))
+		}
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement with the oracle on a case that has the shape of the recorded
+// bug shape names ("" for none): the failure names the shape, so the expected-failure mapping
+// can be read off the output.
+func mismatch(ht *hegel.T, shape string, format string, args ...any) {
+	if shape != "" {
+		format += " (the shape of " + shape + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) string {
+	if has {
+		return id
+	}
+	return ""
+}
+
+// ---- known bugs ------------------------------------------------------------------------------
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default the
+// generators draw the bugs' shapes and the properties that meet them fail, naming the shape;
+// under HEGEL_NO_KNOWN=1 the switches of Known are on: the generators leave the shapes out
+// (shaped) and the checks only a recorded bug can fail are skipped.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known: the recorded bugs whose shapes the wide properties draw. A switch is on only under
+// HEGEL_NO_KNOWN=1; the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// phonenumbers/1: geocoding and carrier lookups do not fall back to English for a language
+	// without data (the country name, or nothing, where libphonenumber gives the English area or
+	// carrier name). On: the languages drawn are English only and the lookups are compared in
+	// English only.
+	englishOnlyLookups bool
+	// phonenumbers/2: FormatOutOfCountryKeepingAlphaChars keeps a + or * of the raw input. On:
+	// the check is skipped for a raw input holding + or *.
+	keepsPlusAndStar bool
+}{
+	englishOnlyLookups: noKnown,
+	keepsPlusAndStar:   noKnown,
+}
+
+// hasPlusOrStar reports a raw input with the shape of phonenumbers/2 (the fullwidth plus is
+// dropped by both ports, so it is not one).
+func hasPlusOrStar(raw string) bool { return strings.ContainsAny(raw, "+*") }
+
+// Where the oracle has data upstream libphonenumber 9.0.38 does not ship (python's phonenumbers
+// keeps older prefix files): geocoding for France, Malaysia, Latvia and Estonia in English, South
+// Korea in other languages, and carrier names under 549 (Argentina mobile).
+var oracleGap = struct {
+	geocodingData func(cc int) bool
+	carrierData   func(cc int) bool
+}{
+	geocodingData: func(cc int) bool { return cc == 33 || cc == 60 || cc == 371 || cc == 372 || cc == 82 },
+	carrierData:   func(cc int) bool { return cc == 54 },
+}
+
+// ---- generator idioms --------------------------------------------------------------------------
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise (for
+// values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// positions: an index taken modulo a live length.
+var positions = hegel.Integers(0, 99)
+
+// ---- names shared with the oracle -----------------------------------------------------------
+
+var typeNames = map[PhoneNumberType]string{
+	FIXED_LINE: "FIXED_LINE", MOBILE: "MOBILE", FIXED_LINE_OR_MOBILE: "FIXED_LINE_OR_MOBILE", TOLL_FREE: "TOLL_FREE",
+	PREMIUM_RATE: "PREMIUM_RATE", SHARED_COST: "SHARED_COST", VOIP: "VOIP", PERSONAL_NUMBER: "PERSONAL_NUMBER",
+	PAGER: "PAGER", UAN: "UAN", VOICEMAIL: "VOICEMAIL", UNKNOWN: "UNKNOWN",
+}
+
+var allTypes = []PhoneNumberType{FIXED_LINE, MOBILE, FIXED_LINE_OR_MOBILE, TOLL_FREE, PREMIUM_RATE, SHARED_COST, VOIP, PERSONAL_NUMBER, PAGER, UAN, VOICEMAIL, UNKNOWN}
+
+var resultNames = map[ValidationResult]string{
+	IS_POSSIBLE: "IS_POSSIBLE", IS_POSSIBLE_LOCAL_ONLY: "IS_POSSIBLE_LOCAL_ONLY", INVALID_COUNTRY_CODE: "INVALID_COUNTRY_CODE",
+	TOO_SHORT: "TOO_SHORT", INVALID_LENGTH: "INVALID_LENGTH", TOO_LONG: "TOO_LONG",
+}
+
+var matchNames = map[MatchType]string{
+	NOT_A_NUMBER: "NOT_A_NUMBER", NO_MATCH: "NO_MATCH", SHORT_NSN_MATCH: "SHORT_NSN_MATCH", NSN_MATCH: "NSN_MATCH", EXACT_MATCH: "EXACT_MATCH",
+}
+
+var costNames = map[ShortNumberCost]string{
+	TOLL_FREE_COST: "TOLL_FREE", STANDARD_RATE_COST: "STANDARD_RATE", PREMIUM_RATE_COST: "PREMIUM_RATE", UNKNOWN_COST: "UNKNOWN_COST",
+}
+
+func errName(err error) string {
+	switch {
+	case err == nil:
+		return ""
+	case errors.Is(err, ErrInvalidCountryCode):
+		return "INVALID_COUNTRY_CODE"
+	case errors.Is(err, ErrNotANumber):
+		return "NOT_A_NUMBER"
+	case errors.Is(err, ErrTooShortAfterIDD):
+		return "TOO_SHORT_AFTER_IDD"
+	case errors.Is(err, ErrTooShortNSN):
+		return "TOO_SHORT_NSN"
+	case errors.Is(err, ErrNumTooLong):
+		return "TOO_LONG"
+	}
+	return "other: " + err.Error()
+}
+
+func numOut(p *PhoneNumber) *pyNumber {
+	if p == nil {
+		return nil
+	}
+	return &pyNumber{
+		CC: int(p.GetCountryCode()), NN: p.GetNationalNumber(), Ext: p.GetExtension(), ILZ: p.GetItalianLeadingZero(),
+		NLZ: int(p.GetNumberOfLeadingZeros()), NLZSet: p.NumberOfLeadingZeros != nil, Raw: p.GetRawInput(),
+		CCS: int(p.GetCountryCodeSource()), PDCC: p.GetPreferredDomesticCarrierCode(),
+	}
+}
+
+func numIn(q pyNumber) *PhoneNumber {
+	p := &PhoneNumber{}
+	cc := int32(q.CC)
+	p.CountryCode = &cc
+	nn := q.NN
+	p.NationalNumber = &nn
+	if q.Ext != "" {
+		e := q.Ext
+		p.Extension = &e
+	}
+	if q.ILZ {
+		b := true
+		p.ItalianLeadingZero = &b
+	}
+	if q.NLZSet {
+		z := int32(q.NLZ)
+		p.NumberOfLeadingZeros = &z
+	}
+	if q.Raw != "" {
+		r := q.Raw
+		p.RawInput = &r
+	}
+	if q.CCS != 0 {
+		s := PhoneNumber_CountryCodeSource(q.CCS)
+		p.CountryCodeSource = &s
+	}
+	if q.PDCC != "" {
+		c := q.PDCC
+		p.PreferredDomesticCarrierCode = &c
+	}
+	return p
+}
+
+func sameNum(a, b *pyNumber) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return *a == *b
+}
+
+// ---- generators ----------------------------------------------------------------------------
+
+var regions = []string{"US", "US", "GB", "DE", "FR", "IT", "ES", "NL", "BE", "CH", "AT", "SE", "NO", "FI", "DK", "PL", "RU", "UA", "TR", "IL",
+	"IN", "CN", "JP", "KR", "AU", "NZ", "SG", "HK", "TW", "ID", "TH", "VN", "PH", "MY", "BR", "AR", "MX", "CO", "CL", "PE",
+	"CA", "ZA", "NG", "KE", "EG", "MA", "SA", "AE", "IR", "PK", "BD", "LK", "IE", "PT", "GR", "CZ", "HU", "RO", "BG", "RS",
+	"GG", "JE", "IM", "PR", "VI", "AS", "BS", "KZ", "VA", "SM", "CI", "AC", "TA", "SH", "HR", "SI", "LU", "MC", "LI", "MT", "CY", "IS"}
+
+// No lower-case codes: Java (and this port) treat them as unknown regions, python upper-cases them.
+var oddRegions = []string{"ZZ", "001", "", "XX", "AQ", "BV", "UM", "EH"}
+
+var callingCodes = []int{1, 7, 20, 27, 30, 31, 33, 34, 39, 41, 43, 44, 45, 46, 47, 48, 49, 52, 54, 55, 56, 57, 61, 62, 63, 64, 65, 66, 81, 82, 84, 86, 90, 91, 92, 98, 212, 234, 254, 262, 290, 358, 372, 380, 500, 590, 800, 808, 870, 878, 881, 882, 883, 888, 979, 0, 2, 999, 1234}
+
+var langs = []string{"en", "en", "de", "fr", "zh", "ja", "ko", "ru", "es", "it", "pt", "ar", "he", "xx", ""}
+
+var vanity = []string{"FLOWERS", "CALL", "HELP", "NOW", "GO", "TAXI", "abc", "MyBiz"}
+
+var (
+	// regionCodes: one of the regions, once in twelve an odd code.
+	regionCodes = weighted(choice[string]{92, hegel.SampledFrom(regions)}, choice[string]{8, hegel.SampledFrom(oddRegions)})
+	// languages: the full list, German, empty and unknown codes included (the shape of
+	// phonenumbers/1 for the area and carrier lookups); English only under HEGEL_NO_KNOWN=1.
+	languages        = shaped[hegel.Generator[string]](hegel.SampledFrom(langs), hegel.Just("en"))
+	formats          = hegel.SampledFrom([]PhoneNumberFormat{E164, INTERNATIONAL, NATIONAL, RFC3966})
+	numberTypes      = hegel.SampledFrom(allTypes)
+	callingCodeDraws = hegel.SampledFrom(callingCodes)
+)
+
+// digitText is a run of digits written in one script: ASCII, fullwidth, Arabic-Indic or
+// extended Arabic-Indic.
+type digitText struct {
+	digits []int
+	script int
+}
+
+var scriptZeros = []rune{'0', 0xFF10, 0x0660, 0x06F0}
+
+func (d digitText) String() string {
+	var sb strings.Builder
+	for _, x := range d.digits {
+		sb.WriteRune(scriptZeros[d.script] + rune(x))
+	}
+	return sb.String()
+}
+
+// scripts: ASCII, once in sixteen another script.
+var scripts = maybe(6, hegel.Integers(1, 3))
+
+// digitsOf: lo to hi digits in one script.
+func digitsOf(lo, hi int) hegel.Generator[digitText] {
+	return hegel.Composite(func(tc hegel.TestCase) digitText {
+		return digitText{digits: hegel.Draw(tc, many(hegel.Integers(0, 9), lo, hi)), script: hegel.Draw(tc, scripts)}
+	})
+}
+
+// seps: the separators between digit groups (a no-break space, a non-breaking hyphen, an en
+// dash and a fullwidth hyphen among them).
+var seps = []string{" ", "-", ".", " ", "/", "  ", "\u00A0", "\u2011", "\u2013", "\uFF0D"}
+
+// gaps: the separator after each digit of a grouped number, read in order: none (plain) six
+// times in ten, else each a separator a quarter of the time.
+var gaps = maybe(60, many(maybe(25, hegel.SampledFrom(seps)), 1, 20))
+
+// grouped puts the separators of gaps after the digits of s.
+func grouped(s string, gaps []string) string {
+	rs := []rune(s)
+	var sb strings.Builder
+	for i, r := range rs {
+		sb.WriteRune(r)
+		if i < len(rs)-1 && i < len(gaps) {
+			sb.WriteString(gaps[i])
+		}
+	}
+	return sb.String()
+}
+
+// digitEdit is one change of a national number: the digit at a position (taken modulo the live
+// length) replaced, deleted, or followed by an inserted digit.
+type digitEdit struct {
+	op, at, digit int
+}
+
+// digitEdits: up to two edits.
+var digitEdits = many(hegel.Composite(func(tc hegel.TestCase) digitEdit {
+	return digitEdit{op: hegel.Draw(tc, hegel.Integers(0, 2)), at: hegel.Draw(tc, positions), digit: hegel.Draw(tc, hegel.Integers(0, 9))}
+}), 0, 2)
+
+// edited applies the edits to the digits of nsn.
+func edited(nsn string, edits []digitEdit) string {
+	rs := []rune(nsn)
+	for _, e := range edits {
+		if len(rs) == 0 {
+			break
+		}
+		i := e.at % len(rs)
+		d := rune('0' + e.digit)
+		switch e.op {
+		case 0:
+			rs[i] = d
+		case 1:
+			rs = append(rs[:i], rs[i+1:]...)
+		default:
+			rs = append(rs[:i+1], append([]rune{d}, rs[i+1:]...)...)
+		}
+	}
+	return string(rs)
+}
+
+// prefix is how a national number is introduced: as it is, with "+cc ", with an IDD and the
+// country code, with the region's national dialling prefix, with "(cc) ", or as a tel: URI.
+type prefix struct {
+	style int
+	idd   string
+}
+
+const (
+	plainStyle = iota
+	plusStyle
+	iddStyle
+	nddStyle
+	parensStyle
+	telStyle
+)
+
+var idds = hegel.SampledFrom([]string{"00", "011", "0011", "810", "+", "++", "00 "})
+
+// prefixes: plain twice in seven, each other style once; the IDD style draws its IDD.
+var prefixes = hegel.FlatMap(hegel.SampledFrom([]int{plainStyle, plainStyle, plusStyle, iddStyle, nddStyle, parensStyle, telStyle}), func(style int) hegel.Generator[prefix] {
+	if style == iddStyle {
+		return hegel.Map(idds, func(idd string) prefix { return prefix{iddStyle, idd} })
+	}
+	return hegel.Just(prefix{style: style})
+})
+
+// render writes the grouped national number nsn of the country code cc after the prefix (the
+// national dialling prefix is the region's).
+func (p prefix) render(cc, region, nsn string) string {
+	switch p.style {
+	case plusStyle:
+		return "+" + cc + " " + nsn
+	case iddStyle:
+		return p.idd + cc + nsn
+	case nddStyle:
+		return GetNddPrefixForRegion(region, true) + nsn
+	case parensStyle:
+		return "(" + cc + ") " + nsn
+	case telStyle:
+		return "tel:+" + cc + "-" + strings.ReplaceAll(nsn, " ", "-")
+	}
+	return nsn
+}
+
+// seedSpec names a valid number of the library's own metadata: the example number of a region,
+// of a type half of the time (the region's plain example when the type has none; every region
+// of the list has one).
+type seedSpec struct {
+	region string
+	typ    *PhoneNumberType
+}
+
+func (s seedSpec) number() *PhoneNumber {
+	if s.typ != nil {
+		if p := GetExampleNumberForTypeInRegion(s.region, *s.typ); p != nil {
+			return p
+		}
+	}
+	return GetExampleNumber(s.region)
+}
+
+func (s seedSpec) String() string {
+	if s.typ != nil {
+		return s.region + " " + typeNames[*s.typ]
+	}
+	return s.region
+}
+
+var seeds = hegel.Composite(func(tc hegel.TestCase) seedSpec {
+	return seedSpec{region: hegel.Draw(tc, hegel.SampledFrom(regions)), typ: hegel.Draw(tc, optional(50, numberTypes))}
+})
+
+// wrap is the outermost shape of a text: none; a tel: URI with a phone-context of a calling
+// code; a tel: URI with another phone-context; a fullwidth plus for the leading plus; an isub
+// parameter; a long run of one junk character instead of the text; trailing zeros.
+type wrap struct {
+	kind    int
+	cc      int
+	context string
+	isub    digitText
+	junk    string
+	count   int
+}
+
+const (
+	noWrap = iota
+	contextWrap
+	oddContextWrap
+	fullwidthPlusWrap
+	isubWrap
+	junkWrap
+	zerosWrap
+)
+
+// wraps: none twenty-five times in thirty-one, each other wrap once.
+var wraps = weighted(
+	choice[wrap]{25, hegel.Just(wrap{})},
+	choice[wrap]{1, hegel.Map(callingCodeDraws, func(cc int) wrap { return wrap{kind: contextWrap, cc: cc} })},
+	choice[wrap]{1, hegel.Map(hegel.SampledFrom([]string{"example.com", "+1-800", "abc.def", "", "+"}), func(c string) wrap { return wrap{kind: oddContextWrap, context: c} })},
+	choice[wrap]{1, hegel.Just(wrap{kind: fullwidthPlusWrap})},
+	choice[wrap]{1, hegel.Map(digitsOf(1, 4), func(d digitText) wrap { return wrap{kind: isubWrap, isub: d} })},
+	choice[wrap]{1, hegel.Composite(func(tc hegel.TestCase) wrap {
+		return wrap{kind: junkWrap, junk: hegel.Draw(tc, hegel.SampledFrom([]string{"1", "9", "+", "-", " "})), count: hegel.Draw(tc, hegel.Integers(200, 300))}
+	})},
+	choice[wrap]{1, hegel.Map(hegel.Integers(10, 30), func(n int) wrap { return wrap{kind: zerosWrap, count: n} })},
+)
+
+func (w wrap) apply(s string) string {
+	switch w.kind {
+	case contextWrap:
+		return "tel:" + strings.TrimPrefix(s, "tel:") + ";phone-context=+" + strconv.Itoa(w.cc)
+	case oddContextWrap:
+		return "tel:" + s + ";phone-context=" + w.context
+	case fullwidthPlusWrap:
+		return "\uFF0B" + strings.TrimLeft(s, "+")
+	case isubWrap:
+		return s + ";isub=" + w.isub.String()
+	case junkWrap:
+		return strings.Repeat(w.junk, w.count)
+	case zerosWrap:
+		return s + strings.Repeat("0", w.count)
+	}
+	return s
+}
+
+// around is noise before and after the text (a left-to-right embedding, a left-to-right mark
+// and a pop directional formatting among the pieces).
+type around struct {
+	before, after string
+}
+
+var arounds = hegel.Composite(func(tc hegel.TestCase) around {
+	return around{
+		before: hegel.Draw(tc, hegel.SampledFrom([]string{"", " ", "Tel: ", "\u202A", "\u200E", "Call ", ".", "+", "-", "*", "#"})),
+		after:  hegel.Draw(tc, hegel.SampledFrom([]string{"", " ", ".", "\u202C", " please", "ab", "!", "-"})),
+	}
+})
+
+// vanityAt is a vanity word spliced in at a position taken modulo the text's length in runes.
+type vanityAt struct {
+	word string
+	at   int
+}
+
+var vanities = hegel.Composite(func(tc hegel.TestCase) vanityAt {
+	return vanityAt{word: hegel.Draw(tc, hegel.SampledFrom(vanity)), at: hegel.Draw(tc, positions)}
+})
+
+// exts: an extension suffix (the last with a fullwidth x).
+var exts = hegel.SampledFrom([]string{" x123", " ext. 45", ";ext=7", " extension 9", "#12", " X 2", "~3", " ext", " int. 42", "\uFF5812"})
+
+// decoration: the wrap, an extension three times in twenty, noise around once in ten, a vanity
+// word once in twelve, lower case once in twenty-five; applied in that order.
+type decoration struct {
+	wrap   wrap
+	ext    string
+	around *around
+	vanity *vanityAt
+	lower  bool
+}
+
+var decorations = hegel.Composite(func(tc hegel.TestCase) decoration {
+	return decoration{
+		wrap:   hegel.Draw(tc, wraps),
+		ext:    hegel.Draw(tc, maybe(15, exts)),
+		around: hegel.Draw(tc, optional(10, arounds)),
+		vanity: hegel.Draw(tc, optional(8, vanities)),
+		lower:  hegel.Draw(tc, chance(4)),
+	}
+})
+
+func (d decoration) apply(s string) string {
+	s = d.wrap.apply(s) + d.ext
+	if d.around != nil {
+		s = d.around.before + s + d.around.after
+	}
+	if d.vanity != nil {
+		rs := []rune(s)
+		i := d.vanity.at % (len(rs) + 1)
+		s = string(rs[:i]) + d.vanity.word + string(rs[i:])
+	}
+	if d.lower {
+		s = strings.ToLower(s)
+	}
+	return s
+}
+
+// candidate is a text that may or may not be a phone number, with the default region it is
+// parsed in: random digits in a region (digitsKind), a seed number formatted by the library
+// (formattedKind), or the seed's national number edited, grouped and prefixed (editedKind), the
+// region the seed's or once in five another; then decorated.
+type candidate struct {
+	kind   int
+	region string
+	seed   seedSpec
+	digits digitText
+	format PhoneNumberFormat
+	edits  []digitEdit
+	prefix prefix
+	gaps   []string
+	deco   decoration
+}
+
+const (
+	digitsKind = iota
+	formattedKind
+	editedKind
+)
+
+var (
+	digitCandidates = hegel.Composite(func(tc hegel.TestCase) candidate {
+		return candidate{kind: digitsKind, region: hegel.Draw(tc, regionCodes), digits: hegel.Draw(tc, digitsOf(0, 19)), deco: hegel.Draw(tc, decorations)}
+	})
+	formattedCandidates = hegel.Composite(func(tc hegel.TestCase) candidate {
+		seed := hegel.Draw(tc, seeds)
+		return candidate{kind: formattedKind, region: seed.region, seed: seed, format: hegel.Draw(tc, formats), deco: hegel.Draw(tc, decorations)}
+	})
+	editedCandidates = hegel.Composite(func(tc hegel.TestCase) candidate {
+		seed := hegel.Draw(tc, seeds)
+		c := candidate{kind: editedKind, region: seed.region, seed: seed, edits: hegel.Draw(tc, digitEdits), prefix: hegel.Draw(tc, prefixes), gaps: hegel.Draw(tc, gaps)}
+		if alt := hegel.Draw(tc, optional(20, regionCodes)); alt != nil {
+			c.region = *alt
+		}
+		c.deco = hegel.Draw(tc, decorations)
+		return c
+	})
+	// candidates: random digits three times in twenty, a formatted seed five, an edited seed twelve.
+	candidates = weighted(choice[candidate]{15, digitCandidates}, choice[candidate]{25, formattedCandidates}, choice[candidate]{60, editedCandidates})
+)
+
+// base is the text before decoration.
+func (c candidate) base() string {
+	switch c.kind {
+	case formattedKind:
+		return Format(c.seed.number(), c.format)
+	case editedKind:
+		p := c.seed.number()
+		nsn := grouped(edited(GetNationalSignificantNumber(p), c.edits), c.gaps)
+		return c.prefix.render(strconv.Itoa(int(p.GetCountryCode())), c.seed.region, nsn)
+	}
+	return c.digits.String()
+}
+
+func (c candidate) text() string { return c.deco.apply(c.base()) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (c candidate) GoString() string {
+	src := "digits"
+	switch c.kind {
+	case formattedKind:
+		src = "seed " + c.seed.String() + " formatted"
+	case editedKind:
+		src = "seed " + c.seed.String() + " edited"
+	}
+	return fmt.Sprintf("%q in region %q (%s)", c.text(), c.region, src)
+}
+
+// parseCase: a candidate and whether the raw input is kept.
+type parseCase struct {
+	cand candidate
+	keep bool
+}
+
+func parseCasesOf(keepPct int) hegel.Generator[parseCase] {
+	return hegel.Composite(func(tc hegel.TestCase) parseCase {
+		return parseCase{cand: hegel.Draw(tc, candidates), keep: hegel.Draw(tc, chance(keepPct))}
+	})
+}
+
+var parseCases = parseCasesOf(50)
+
+func (p parseCase) parse() (*PhoneNumber, error) {
+	if p.keep {
+		return ParseAndKeepRawInput(p.cand.text(), p.cand.region)
+	}
+	return Parse(p.cand.text(), p.cand.region)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (p parseCase) GoString() string { return fmt.Sprintf("%#v keepRaw %v", p.cand, p.keep) }
+
+// ---- properties ----------------------------------------------------------------------------
+
+// Parsing agrees with libphonenumber: the same error class, or the same number.
+func TestHegelParsingAgreesWithLibphonenumber(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		pc := hegel.Draw(ht, parseCases)
+		s, r := pc.cand.text(), pc.cand.region
+		got, err := pc.parse()
+		var want struct {
+			OK  bool      `json:"ok"`
+			Err string    `json:"err"`
+			Num *pyNumber `json:"num"`
+		}
+		py.call(t, map[string]any{"op": "parse", "number": s, "region": r, "keepRaw": pc.keep}, &want)
+		if want.OK != (err == nil) {
+			if err != nil {
+				fail(ht, "Parse(%q, %q) fails with %v but libphonenumber parses it to %v", s, r, err, want.Num)
+			}
+			fail(ht, "Parse(%q, %q) gives %v but libphonenumber fails with %s", s, r, numOut(got), want.Err)
+		}
+		if err != nil {
+			if errName(err) != want.Err {
+				fail(ht, "Parse(%q, %q) fails with %s but libphonenumber with %s", s, r, errName(err), want.Err)
+			}
+			return
+		}
+		if !sameNum(numOut(got), want.Num) {
+			fail(ht, "Parse(%q, %q, keepRaw %v) gives %v but libphonenumber %v", s, r, pc.keep, numOut(got), want.Num)
+		}
+	})
+}
+
+type infoResult struct {
+	Valid                    bool      `json:"valid"`
+	ValidForRegion           bool      `json:"validForRegion"`
+	Possible                 bool      `json:"possible"`
+	PossibleReason           string    `json:"possibleReason"`
+	PossibleForType          bool      `json:"possibleForType"`
+	PossibleForTypeReason    string    `json:"possibleForTypeReason"`
+	Type                     string    `json:"type"`
+	RegionCode               string    `json:"regionCode"`
+	Formats                  []string  `json:"formats"`
+	OutOfCountry             string    `json:"outOfCountry"`
+	OutOfCountryAlpha        string    `json:"outOfCountryAlpha"`
+	Original                 string    `json:"original"`
+	CarrierCode              string    `json:"carrierCode"`
+	PreferredCarrier         string    `json:"preferredCarrier"`
+	MobileDialing            string    `json:"mobileDialing"`
+	MobileDialingPlain       string    `json:"mobileDialingPlain"`
