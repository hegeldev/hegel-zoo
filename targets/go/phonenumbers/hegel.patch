+package phonenumbers_test
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+	"testing"
+)
+
+// ---- the oracle: Python's phonenumbers (the libphonenumber port that ships the same metadata) ----
+//
+// One JSON request per line on stdin, one JSON answer per line on stdout. Enumerations travel as
+// their libphonenumber names so that the two ports' differing numeric values do not matter.
+
+const pyScript = `
+import sys, json
+import phonenumbers as P
+import phonenumbers.shortnumberinfo as S
+import phonenumbers.timezone as TZ
+import phonenumbers.carrier as CA
+import phonenumbers.geocoder as GE
+from phonenumbers import PhoneNumber, NumberParseException, PhoneNumberFormat as F, PhoneNumberType as T, ValidationResult as V, MatchType as M, Leniency as L
+from phonenumbers.shortnumberinfo import ShortNumberCost as C
+
+# python's matcher compares an x-less extension with None where Java compares with "" (a Java
+# number without extension has getExtension() == ""), so "12 34 56 78 ext" is not VALID for python
+# but is for Java and this port; patch the oracle to Java's reading.
+import phonenumbers.phonenumbermatcher as PM
+def _contains_only_valid_x_chars(numobj, candidate):
+    ii = 0
+    while ii < len(candidate) - 1:
+        if candidate[ii] in 'xX':
+            next_char = candidate[ii + 1]
+            if next_char in 'xX':
+                ii += 1
+                if P.is_number_match(numobj, candidate[ii:]) != M.NSN_MATCH:
+                    return False
+            elif P.normalize_digits_only(candidate[ii:]) != (numobj.extension or ''):
+                return False
+        ii += 1
+    return True
+PM._contains_only_valid_x_chars = _contains_only_valid_x_chars
+
+TYPES = {getattr(T, k): k for k in dir(T) if k.isupper()}
+TYPE_BY_NAME = {v: k for k, v in TYPES.items()}
+RESULTS = {getattr(V, k): k for k in dir(V) if k.isupper()}
+MATCHES = {getattr(M, k): k for k in dir(M) if k.isupper()}
+COSTS = {getattr(C, k): k for k in dir(C) if k.isupper()}
+ERRORS = {NumberParseException.INVALID_COUNTRY_CODE: 'INVALID_COUNTRY_CODE', NumberParseException.NOT_A_NUMBER: 'NOT_A_NUMBER',
+          NumberParseException.TOO_SHORT_AFTER_IDD: 'TOO_SHORT_AFTER_IDD', NumberParseException.TOO_SHORT_NSN: 'TOO_SHORT_NSN', NumberParseException.TOO_LONG: 'TOO_LONG'}
+FORMATS = [F.E164, F.INTERNATIONAL, F.NATIONAL, F.RFC3966]
+
+def num_out(n):
+    if n is None:
+        return None
+    return {'cc': n.country_code or 0, 'nn': n.national_number or 0, 'ext': n.extension or '',
+            'ilz': bool(n.italian_leading_zero), 'nlz': 1 if n.number_of_leading_zeros is None else n.number_of_leading_zeros,
+            'nlzSet': n.number_of_leading_zeros is not None,
+            'raw': n.raw_input or '', 'ccs': n.country_code_source or 0, 'pdcc': n.preferred_domestic_carrier_code or ''}
+
+def num_in(d):
+    return PhoneNumber(country_code=d['cc'], national_number=d['nn'], extension=d['ext'] or None,
+                       italian_leading_zero=True if d['ilz'] else None,
+                       number_of_leading_zeros=d['nlz'] if d.get('nlzSet') else None,
+                       raw_input=d['raw'] or None, country_code_source=d['ccs'] or 0,
+                       preferred_domestic_carrier_code=d['pdcc'] or None)
+
+def parse(req):
+    try:
+        n = P.parse(req['number'], req['region'] or None, keep_raw_input=req['keepRaw'])
+        return {'ok': True, 'num': num_out(n)}
+    except NumberParseException as e:
+        return {'ok': False, 'err': ERRORS.get(e.error_type, str(e.error_type))}
+
+def info(req):
+    n = num_in(req['num'])
+    region = req['region']
+    lang = req['lang']
+    t = P.number_type(n)
+    trunc = PhoneNumber()
+    trunc.merge_from(n)
+    truncated = P.truncate_too_long_number(trunc)
+    ex_type = TYPE_BY_NAME[req['type']]
+    try:
+        tz = list(TZ.time_zones_for_number(n))
+    except Exception as e:
+        tz = ['error: ' + type(e).__name__]
+    res = {
+        'valid': P.is_valid_number(n),
+        'validForRegion': P.is_valid_number_for_region(n, region),
+        'possible': P.is_possible_number(n),
+        'possibleReason': RESULTS[P.is_possible_number_with_reason(n)],
+        'possibleForType': P.is_possible_number_for_type(n, ex_type),
+        'possibleForTypeReason': RESULTS[P.is_possible_number_for_type_with_reason(n, ex_type)],
+        'type': TYPES[t],
+        'regionCode': P.region_code_for_number(n) or '',
+        'formats': [P.format_number(n, f) for f in FORMATS],
+        'outOfCountry': P.format_out_of_country_calling_number(n, region),
+        'outOfCountryAlpha': P.format_out_of_country_keeping_alpha_chars(n, region),
+        'original': P.format_in_original_format(n, region),
+        'carrierCode': P.format_national_number_with_carrier_code(n, req['carrier']),
+        'preferredCarrier': P.format_national_number_with_preferred_carrier_code(n, req['carrier']),
+        'mobileDialing': P.format_number_for_mobile_dialing(n, region, True),
+        'mobileDialingPlain': P.format_number_for_mobile_dialing(n, region, False),
+        'areaCodeLength': P.length_of_geographical_area_code(n),
+        'ndcLength': P.length_of_national_destination_code(n),
+        'geographical': P.is_number_geographical(n),
+        'intlDiallable': P.can_be_internationally_dialled(n),
+        'truncated': truncated,
+        'truncatedNum': num_out(trunc),
+        'nsn': P.national_significant_number(n),
+        'matchOther': MATCHES[P.is_number_match(n, req['other'])],
+        'matchNum': MATCHES[P.is_number_match(n, num_in(req['otherNum']))],
+        'timezones': tz,
+        'carrier': CA.name_for_number(n, lang),
+        'carrierValid': CA.name_for_valid_number(n, lang),
+        'countryName': GE.country_name_for_number(n, lang),
+        'description': GE.description_for_number(n, lang),
+        'descriptionValid': GE.description_for_valid_number(n, lang),
+        'descriptionUser': GE.description_for_number(n, lang, region=region),
+        'possibleShort': S.is_possible_short_number(n),
+        'possibleShortForRegion': S.is_possible_short_number_for_region(n, region),
+        'validShort': S.is_valid_short_number(n),
+        'validShortForRegion': S.is_valid_short_number_for_region(n, region),
+        'cost': COSTS[S.expected_cost(n)],
+        'costForRegion': COSTS[S.expected_cost_for_region(n, region)],
+        'carrierSpecific': S.is_carrier_specific(n),
+        'carrierSpecificForRegion': S.is_carrier_specific_for_region(n, region),
+        'smsService': S.is_sms_service_for_region(n, region),
+    }
+    return res
+
+def region(req):
+    r = req['region']
+    ex = P.example_number(r)
+    ext = P.example_number_for_type(r, TYPE_BY_NAME[req['type']])
+    cc = req['cc']
+    return {
+        'countryCode': P.country_code_for_region(r),
+        'ndd': P.ndd_prefix_for_region(r, False) or '',
+        'nddDigits': P.ndd_prefix_for_region(r, True) or '',
+        'nanpa': P.is_nanpa_country(r),
+        'portable': P.is_mobile_number_portable_region(r),
+        'example': num_out(ex),
+        'exampleForType': num_out(ext),
+        'types': sorted(TYPES[t] for t in P.supported_types_for_region(r)),
+        'regionForCC': P.region_code_for_country_code(cc),
+        'regionsForCC': list(P.region_codes_for_country_code(cc)),
+        'mobileToken': P.country_mobile_token(cc),
+        'exampleNonGeo': num_out(P.example_number_for_non_geo_entity(cc)),
+        'typesNonGeo': sorted(TYPES[t] for t in P.supported_types_for_non_geo_entity(cc)),
+        'invalidExample': num_out(P.invalid_example_number(r)) if hasattr(P, 'invalid_example_number') else None,
+    }
+
+def text(req):
+    s = req['text']
+    r = req['region']
+    return {
+        'alpha': P.is_alpha_number(s),
+        'converted': P.convert_alpha_characters_in_number(s),
+        'digits': P.normalize_digits_only(s),
+        'diallable': P.normalize_diallable_chars_only(s),
+        'emergency': S.is_emergency_number(s, r),
+        'connectsEmergency': S.connects_to_emergency_number(s, r),
+        'possibleString': P.is_possible_number_string(s, r or None),
+        'match': MATCHES[P.is_number_match(s, req['other'])],
+    }
+
+def aytf(req):
+    f = P.AsYouTypeFormatter(req['region'])
+    out = []
+    for i, ch in enumerate(req['chars']):
+        if i == req['remember']:
+            out.append(f.input_digit(ch, remember_position=True))
+        else:
+            out.append(f.input_digit(ch))
+    pos = f.get_remembered_position()
+    f.clear()
+    return {'out': out, 'pos': pos, 'afterClear': f.input_digit(req['chars'][0]) if req['chars'] else ''}
+
+def matcher(req):
+    lens = [L.POSSIBLE, L.VALID, L.STRICT_GROUPING, L.EXACT_GROUPING][req['leniency']]
+    ms = []
+    for m in P.PhoneNumberMatcher(req['text'], req['region'] or None, leniency=lens, max_tries=req['maxTries']):
+        ms.append({'start': m.start, 'end': m.end, 'raw': m.raw_string, 'num': num_out(m.number)})
+    return {'matches': ms}
+
+OPS = {'parse': parse, 'info': info, 'region': region, 'text': text, 'aytf': aytf, 'matcher': matcher}
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        res = OPS[req['op']](req)
+    except Exception as e:
+        res = {'error': type(e).__name__ + ': ' + str(e)[:300]}
+    sys.stdout.write(json.dumps(res) + '\n')
+    sys.stdout.flush()
+`
+
+// pyNumber is a PhoneNumber's fields as both sides describe them.
+type pyNumber struct {
+	CC     int    `json:"cc"`
+	NN     uint64 `json:"nn"`
+	Ext    string `json:"ext"`
+	ILZ    bool   `json:"ilz"`
+	NLZ    int    `json:"nlz"`
+	NLZSet bool   `json:"nlzSet"`
+	Raw    string `json:"raw"`
+	CCS    int    `json:"ccs"`
+	PDCC   string `json:"pdcc"`
+}
+
+func (p pyNumber) String() string {
+	return fmt.Sprintf("{cc %d nn %d ext %q ilz %v nlz %d(set %v) raw %q ccs %d pdcc %q}", p.CC, p.NN, p.Ext, p.ILZ, p.NLZ, p.NLZSet, p.Raw, p.CCS, p.PDCC)
+}
+
+type python struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+var (
+	pyOnce  sync.Once
+	pyChild *python
+	pyErr   error
+)
+
+func oracle(t *testing.T) *python {
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyErr = err
+			return
+		}
+		sc := bufio.NewScanner(stdout)
+		sc.Buffer(make([]byte, 1<<16), 1<<24)
+		pyChild = &python{cmd: cmd, in: bufio.NewWriter(stdin), out: sc}
+	})
+	if pyErr != nil {
+		t.Fatalf("cannot start the python phonenumbers oracle: %v", pyErr)
+	}
+	return pyChild
+}
+
+func (g *python) call(t *testing.T, req map[string]any, res any) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		t.Fatalf("oracle request: %v", err)
+	}
+	if _, err := g.in.Write(append(b, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	if err := g.in.Flush(); err != nil {
+		t.Fatalf("oracle flush: %v", err)
+	}
+	if !g.out.Scan() {
+		t.Fatalf("the python oracle died: %v (is the phonenumbers package installed?)", g.out.Err())
+	}
+	line := g.out.Bytes()
+	var probe struct {
+		Error string `json:"error"`
+	}
+	if json.Unmarshal(line, &probe) == nil && probe.Error != "" {
+		t.Fatalf("oracle: %s for %s", probe.Error, b)
+	}
+	if err := json.Unmarshal(line, res); err != nil {
+		t.Fatalf("oracle answer %q: %v", line, err)
+	}
+}
