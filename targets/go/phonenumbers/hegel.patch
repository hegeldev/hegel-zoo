+
+// Bug 1: area and carrier lookups do not fall back to English for languages without data.
+func TestHegelPinPrefixLookupsFallBackToEnglish(t *testing.T) {
+	us, _ := Parse("+12015550123", "ZZ")
+	for _, lg := range []string{"de", "", "xx"} {
+		d, err := geocoding.GetDescriptionForNumber(us, lg)
+		if err != nil || d != "New Jersey" {
+			t.Errorf("geocoding.GetDescriptionForNumber(+1 201 555 0123, %q) = %q, %v; libphonenumber falls back to the English area name New Jersey", lg, d, err)
+		}
+	}
+	ph, _ := Parse("+639051234567", "ZZ")
+	for _, lg := range []string{"ru", "", "de"} {
+		c, err := carrier.GetNameForNumber(ph, lg)
+		if err != nil || c != "Globe" {
+			t.Errorf("carrier.GetNameForNumber(+63 905 123 4567, %q) = %q, %v; libphonenumber falls back to the English carrier name Globe", lg, c, err)
+		}
+	}
+	// languages with their own data are unaffected, and zh/ja/ko do not fall back
+	de, _ := Parse("+4930123456", "ZZ")
+	if d, _ := geocoding.GetDescriptionForNumber(de, "de"); d != "Berlin" {
+		t.Errorf("geocoding.GetDescriptionForNumber(+49 30 123456, de) = %q, want Berlin", d)
+	}
+}
