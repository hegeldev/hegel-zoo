+// parsedNumber is a number both ports agree on (parsed the same), or nil.
+func parsedNumber(t *testing.T, py *python, tc hegel.TestCase) (*PhoneNumber, string, string) {
+	s, r := candidate(tc)
+	keep := chance(tc, 40)
+	var got *PhoneNumber
+	var err error
+	if keep {
+		got, err = ParseAndKeepRawInput(s, r)
+	} else {
+		got, err = Parse(s, r)
+	}
+	if err != nil {
+		return nil, s, r
+	}
+	var want struct {
+		OK  bool      `json:"ok"`
+		Num *pyNumber `json:"num"`
+	}
+	py.call(t, map[string]any{"op": "parse", "number": s, "region": r, "keepRaw": keep}, &want)
+	if !want.OK || !sameNum(numOut(got), want.Num) {
+		return nil, s, r // the parsing property's business
+	}
+	return got, s, r
+}
+
+func strs(err error, xs []string) []string {
+	if err != nil {
+		return []string{"error: " + err.Error()}
+	}
+	if xs == nil {
+		return []string{}
+	}
+	return xs
+}
+
+func str(s string, err error) string {
+	if err != nil {
+		return "error: " + err.Error()
+	}
+	return s
+}
