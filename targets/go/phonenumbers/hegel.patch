@@ -0,0 +1,832 @@
+package phonenumbers_test
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"testing"
+
+	. "github.com/nyaruka/phonenumbers/v2"
+	"github.com/nyaruka/phonenumbers/v2/carrier"
+	"github.com/nyaruka/phonenumbers/v2/geocoding"
+	"github.com/nyaruka/phonenumbers/v2/timezone"
+	"hegel.dev/go/hegel"
+)
+
+// ---- harness -------------------------------------------------------------------------------
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// fail reports a mismatch; under ZOO_COLLECT=1 it prints a COLLECT line once per distinct message
+// and lets the test case go on, so one run shows every kind of mismatch.
+var collect = os.Getenv("ZOO_COLLECT") != ""
+var seen = map[string]bool{}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collect {
+		key := msg
+		if len(key) > 200 {
+			key = key[:200]
+		}
+		if !seen[key] {
+			seen[key] = true
+			fmt.Println("COLLECT " + strings.ReplaceAll(msg, "\n", " "))
+		}
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// Findings recorded in bugs.toml; each gate keeps a property from re-reporting one.
+var known = struct {
+	// Bug 2: FormatOutOfCountryKeepingAlphaChars keeps "+" and "*" from the raw input.
+	keepsPlusAndStar func(raw string) bool
+}{
+	keepsPlusAndStar: func(raw string) bool { return strings.ContainsAny(raw, "+*\uFF0B") },
+}
+
+// Where the oracle has data upstream libphonenumber 9.0.38 does not ship (python's phonenumbers
+// keeps older prefix files): geocoding for France, Malaysia, Latvia and Estonia in English, South
+// Korea in other languages, and carrier names under 549 (Argentina mobile).
+var oracleGap = struct {
+	geocodingData func(cc int) bool
+	carrierData   func(cc int) bool
+}{
+	geocodingData: func(cc int) bool { return cc == 33 || cc == 60 || cc == 371 || cc == 372 || cc == 82 },
+	carrierData:   func(cc int) bool { return cc == 54 },
+}
+
+// ---- names shared with the oracle -----------------------------------------------------------
+
+var typeNames = map[PhoneNumberType]string{
+	FIXED_LINE: "FIXED_LINE", MOBILE: "MOBILE", FIXED_LINE_OR_MOBILE: "FIXED_LINE_OR_MOBILE", TOLL_FREE: "TOLL_FREE",
+	PREMIUM_RATE: "PREMIUM_RATE", SHARED_COST: "SHARED_COST", VOIP: "VOIP", PERSONAL_NUMBER: "PERSONAL_NUMBER",
+	PAGER: "PAGER", UAN: "UAN", VOICEMAIL: "VOICEMAIL", UNKNOWN: "UNKNOWN",
+}
+
+var allTypes = []PhoneNumberType{FIXED_LINE, MOBILE, FIXED_LINE_OR_MOBILE, TOLL_FREE, PREMIUM_RATE, SHARED_COST, VOIP, PERSONAL_NUMBER, PAGER, UAN, VOICEMAIL, UNKNOWN}
+
+var resultNames = map[ValidationResult]string{
+	IS_POSSIBLE: "IS_POSSIBLE", IS_POSSIBLE_LOCAL_ONLY: "IS_POSSIBLE_LOCAL_ONLY", INVALID_COUNTRY_CODE: "INVALID_COUNTRY_CODE",
+	TOO_SHORT: "TOO_SHORT", INVALID_LENGTH: "INVALID_LENGTH", TOO_LONG: "TOO_LONG",
+}
+
+var matchNames = map[MatchType]string{
+	NOT_A_NUMBER: "NOT_A_NUMBER", NO_MATCH: "NO_MATCH", SHORT_NSN_MATCH: "SHORT_NSN_MATCH", NSN_MATCH: "NSN_MATCH", EXACT_MATCH: "EXACT_MATCH",
+}
+
+var costNames = map[ShortNumberCost]string{
+	TOLL_FREE_COST: "TOLL_FREE", STANDARD_RATE_COST: "STANDARD_RATE", PREMIUM_RATE_COST: "PREMIUM_RATE", UNKNOWN_COST: "UNKNOWN_COST",
+}
+
+func errName(err error) string {
+	switch {
+	case err == nil:
+		return ""
+	case errors.Is(err, ErrInvalidCountryCode):
+		return "INVALID_COUNTRY_CODE"
+	case errors.Is(err, ErrNotANumber):
+		return "NOT_A_NUMBER"
+	case errors.Is(err, ErrTooShortAfterIDD):
+		return "TOO_SHORT_AFTER_IDD"
+	case errors.Is(err, ErrTooShortNSN):
+		return "TOO_SHORT_NSN"
+	case errors.Is(err, ErrNumTooLong):
+		return "TOO_LONG"
+	}
+	return "other: " + err.Error()
+}
+
+func numOut(p *PhoneNumber) *pyNumber {
+	if p == nil {
+		return nil
+	}
+	return &pyNumber{
+		CC: int(p.GetCountryCode()), NN: p.GetNationalNumber(), Ext: p.GetExtension(), ILZ: p.GetItalianLeadingZero(),
+		NLZ: int(p.GetNumberOfLeadingZeros()), NLZSet: p.NumberOfLeadingZeros != nil, Raw: p.GetRawInput(),
+		CCS: int(p.GetCountryCodeSource()), PDCC: p.GetPreferredDomesticCarrierCode(),
+	}
+}
+
+func numIn(q pyNumber) *PhoneNumber {
+	p := &PhoneNumber{}
+	cc := int32(q.CC)
+	p.CountryCode = &cc
+	nn := q.NN
+	p.NationalNumber = &nn
+	if q.Ext != "" {
+		e := q.Ext
+		p.Extension = &e
+	}
+	if q.ILZ {
+		b := true
+		p.ItalianLeadingZero = &b
+	}
+	if q.NLZSet {
+		z := int32(q.NLZ)
+		p.NumberOfLeadingZeros = &z
+	}
+	if q.Raw != "" {
+		r := q.Raw
+		p.RawInput = &r
+	}
+	if q.CCS != 0 {
+		s := PhoneNumber_CountryCodeSource(q.CCS)
+		p.CountryCodeSource = &s
+	}
+	if q.PDCC != "" {
+		c := q.PDCC
+		p.PreferredDomesticCarrierCode = &c
+	}
+	return p
+}
+
+func sameNum(a, b *pyNumber) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return *a == *b
+}
+
+// ---- generators ----------------------------------------------------------------------------
+
+var regions = []string{"US", "US", "GB", "DE", "FR", "IT", "ES", "NL", "BE", "CH", "AT", "SE", "NO", "FI", "DK", "PL", "RU", "UA", "TR", "IL",
+	"IN", "CN", "JP", "KR", "AU", "NZ", "SG", "HK", "TW", "ID", "TH", "VN", "PH", "MY", "BR", "AR", "MX", "CO", "CL", "PE",
+	"CA", "ZA", "NG", "KE", "EG", "MA", "SA", "AE", "IR", "PK", "BD", "LK", "IE", "PT", "GR", "CZ", "HU", "RO", "BG", "RS",
+	"GG", "JE", "IM", "PR", "VI", "AS", "BS", "KZ", "VA", "SM", "CI", "AC", "TA", "SH", "HR", "SI", "LU", "MC", "LI", "MT", "CY", "IS"}
+
+// No lower-case codes: Java (and this port) treat them as unknown regions, python upper-cases them.
+var oddRegions = []string{"ZZ", "001", "", "XX", "AQ", "BV", "UM", "EH"}
+
+var callingCodes = []int{1, 7, 20, 27, 30, 31, 33, 34, 39, 41, 43, 44, 45, 46, 47, 48, 49, 52, 54, 55, 56, 57, 61, 62, 63, 64, 65, 66, 81, 82, 84, 86, 90, 91, 92, 98, 212, 234, 254, 262, 290, 358, 372, 380, 500, 590, 800, 808, 870, 878, 881, 882, 883, 888, 979, 0, 2, 999, 1234}
+
+func region(tc hegel.TestCase) string {
+	if chance(tc, 8) {
+		return pick(tc, oddRegions)
+	}
+	return pick(tc, regions)
+}
+
+func lang(tc hegel.TestCase) string {
+	return pick(tc, []string{"en", "en", "de", "fr", "zh", "ja", "ko", "ru", "es", "it", "pt", "ar", "he", "xx", ""})
+}
+
+var vanity = []string{"FLOWERS", "CALL", "HELP", "NOW", "GO", "TAXI", "abc", "MyBiz"}
+
+// digits returns lo..hi random digits, mostly ASCII, sometimes fullwidth or Arabic-Indic.
+func digits(tc hegel.TestCase, lo, hi int) string {
+	k := n(tc, lo, hi)
+	var sb strings.Builder
+	script := 0
+	if chance(tc, 6) {
+		script = n(tc, 1, 3)
+	}
+	for i := 0; i < k; i++ {
+		d := n(tc, 0, 9)
+		switch script {
+		case 1:
+			sb.WriteRune(rune(0xFF10 + d)) // fullwidth
+		case 2:
+			sb.WriteRune(rune(0x0660 + d)) // Arabic-Indic
+		case 3:
+			sb.WriteRune(rune(0x06F0 + d)) // Extended Arabic-Indic
+		default:
+			sb.WriteByte(byte('0' + d))
+		}
+	}
+	return sb.String()
+}
+
+// group splits a digit string with random separators.
+func group(tc hegel.TestCase, s string) string {
+	if chance(tc, 40) {
+		return s
+	}
+	seps := []string{" ", "-", ".", " ", "/", "  ", " ", "‑", "–", "－"}
+	var sb strings.Builder
+	rs := []rune(s)
+	for i, r := range rs {
+		sb.WriteRune(r)
+		if i < len(rs)-1 && chance(tc, 25) {
+			sb.WriteString(pick(tc, seps))
+		}
+	}
+	return sb.String()
+}
+
+// seedNumber is a valid number of a random region formatted by the library itself, the base for mutations.
+func seedNumber(tc hegel.TestCase) (*PhoneNumber, string) {
+	r := pick(tc, regions)
+	var p *PhoneNumber
+	if chance(tc, 50) {
+		p = GetExampleNumberForTypeInRegion(r, pick(tc, allTypes))
+	}
+	if p == nil {
+		p = GetExampleNumber(r)
+	}
+	if p == nil {
+		return nil, r
+	}
+	return p, r
+}
+
+// candidate is a string that may or may not be a phone number, with a default region.
+func candidate(tc hegel.TestCase) (string, string) {
+	seed, r := seedNumber(tc)
+	var s string
+	switch {
+	case seed == nil || chance(tc, 15):
+		s = digits(tc, 0, 19)
+		r = region(tc)
+	case chance(tc, 30):
+		s = Format(seed, pick(tc, []PhoneNumberFormat{E164, INTERNATIONAL, NATIONAL, RFC3966}))
+	default:
+		nsn := GetNationalSignificantNumber(seed)
+		// mutate the national number a little
+		rs := []rune(nsn)
+		for k := n(tc, 0, 2); k > 0 && len(rs) > 0; k-- {
+			i := n(tc, 0, len(rs)-1)
+			switch n(tc, 0, 2) {
+			case 0:
+				rs[i] = rune('0' + n(tc, 0, 9))
+			case 1:
+				rs = append(rs[:i], rs[i+1:]...)
+			default:
+				rs = append(rs[:i+1], append([]rune{rune('0' + n(tc, 0, 9))}, rs[i+1:]...)...)
+			}
+		}
+		nsn = string(rs)
+		cc := strconv.Itoa(int(seed.GetCountryCode()))
+		switch n(tc, 0, 6) {
+		case 0:
+			s = "+" + cc + " " + group(tc, nsn)
+		case 1:
+			s = pick(tc, []string{"00", "011", "0011", "810", "+", "++", "00 "}) + cc + group(tc, nsn)
+		case 2:
+			s = GetNddPrefixForRegion(r, true) + group(tc, nsn)
+		case 3:
+			s = "(" + cc + ") " + group(tc, nsn)
+		case 4:
+			s = "tel:+" + cc + "-" + strings.ReplaceAll(group(tc, nsn), " ", "-")
+		default:
+			s = group(tc, nsn)
+		}
+		if chance(tc, 20) {
+			r = region(tc)
+		}
+	}
+	// RFC 3966 contexts, fullwidth plus, long junk
+	switch n(tc, 0, 30) {
+	case 0:
+		s = "tel:" + strings.TrimPrefix(s, "tel:") + ";phone-context=+" + strconv.Itoa(pick(tc, callingCodes))
+	case 1:
+		s = "tel:" + s + ";phone-context=" + pick(tc, []string{"example.com", "+1-800", "abc.def", "", "+"})
+	case 2:
+		s = "\uFF0B" + strings.TrimLeft(s, "+")
+	case 3:
+		s = s + ";isub=" + digits(tc, 1, 4)
+	case 4:
+		s = strings.Repeat(pick(tc, []string{"1", "9", "+", "-", " "}), n(tc, 200, 300))
+	case 5:
+		s = s + strings.Repeat("0", n(tc, 10, 30))
+	}
+	// noise
+	if chance(tc, 15) {
+		s = s + pick(tc, []string{" x123", " ext. 45", ";ext=7", " extension 9", "#12", " X 2", "~3", " ext", " int. 42", "ｘ12"})
+	}
+	if chance(tc, 10) {
+		s = pick(tc, []string{"", " ", "Tel: ", "‪", "‎", "Call ", ".", "+", "-", "*", "#"}) + s + pick(tc, []string{"", " ", ".", "‬", " please", "ab", "!", "-"})
+	}
+	if chance(tc, 8) {
+		rs := []rune(s)
+		i := n(tc, 0, len(rs))
+		s = string(rs[:i]) + pick(tc, vanity) + string(rs[i:])
+	}
+	if chance(tc, 4) {
+		s = strings.ToLower(s)
+	}
+	return s, r
+}
