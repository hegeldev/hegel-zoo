diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..43d9ed2
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,341 @@
+package phonenumbers_test
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+	"testing"
+)
+
+// ---- the oracle: Python's phonenumbers (the libphonenumber port that ships the same metadata) ----
+//
+// One JSON request per line on stdin, one JSON answer per line on stdout. Enumerations travel as
+// their libphonenumber names so that the two ports' differing numeric values do not matter.
+
+const pyScript = `
+import sys, json
+import phonenumbers as P
+import phonenumbers.shortnumberinfo as S
+import phonenumbers.timezone as TZ
+import phonenumbers.carrier as CA
+import phonenumbers.geocoder as GE
+from phonenumbers import PhoneNumber, NumberParseException, PhoneNumberFormat as F, PhoneNumberType as T, ValidationResult as V, MatchType as M, Leniency as L
+from phonenumbers.shortnumberinfo import ShortNumberCost as C
+
+# python's matcher compares an x-less extension with None where Java compares with "" (a Java
+# number without extension has getExtension() == ""), so "12 34 56 78 ext" is not VALID for python
+# but is for Java and this port; patch the oracle to Java's reading.
+import phonenumbers.phonenumbermatcher as PM
+def _contains_only_valid_x_chars(numobj, candidate):
+    ii = 0
+    while ii < len(candidate) - 1:
+        if candidate[ii] in 'xX':
+            next_char = candidate[ii + 1]
+            if next_char in 'xX':
+                ii += 1
+                if P.is_number_match(numobj, candidate[ii:]) != M.NSN_MATCH:
+                    return False
+            elif P.normalize_digits_only(candidate[ii:]) != (numobj.extension or ''):
+                return False
+        ii += 1
+    return True
+PM._contains_only_valid_x_chars = _contains_only_valid_x_chars
+
+# python's inner-match loop searches each candidate again from one past the previous group's
+# start (overlapping groups), where Java's Matcher.find() (and this port) goes on after the
+# group; with a small max_tries python runs out of tries sooner and finds fewer numbers
+# (libphonenumber 9.0.39 arbitrated, 2026-10-07: three matches at max_tries=3 in
+# "<fullwidth plus>12015550123 - 01110 1 5 5 5 0123 - 9am" under NL, python one). Patch the
+# oracle to Java's reading.
+def _extract_inner_match(self, candidate, offset):
+    for possible_inner_match in PM._INNER_MATCHES:
+        is_first_match = True
+        for group_match in possible_inner_match.finditer(candidate):
+            if self._max_tries <= 0:
+                break
+            if is_first_match:
+                group = self._trim_after_first_match(PM._UNWANTED_END_CHAR_PATTERN, candidate[:group_match.start()])
+                match = self._parse_and_verify(group, offset)
+                if match is not None:
+                    return match
+                self._max_tries -= 1
+                is_first_match = False
+            group = self._trim_after_first_match(PM._UNWANTED_END_CHAR_PATTERN, group_match.group(1))
+            match = self._parse_and_verify(group, offset + group_match.start(1))
+            if match is not None:
+                return match
+            self._max_tries -= 1
+    return None
+PM.PhoneNumberMatcher._extract_inner_match = _extract_inner_match
+
+# Java's getNationalSignificantNumber (and this port's) caps the leading zeros it writes at ten
+# (a defence against malicious input); python's phonenumbers 9.0.39 writes them all, so a number
+# parsed from twelve or more zeros formats, validates and types differently (libphonenumber 9.0.39
+# arbitrated, 2026-10-07: "000000000000" in US is +100000000000 for Java, +1000000000000 for
+# python). Patch the oracle to Java's reading, in every module that bound the function.
+import phonenumbers.phonenumberutil as PU
+import phonenumbers.geocoder as _GE, phonenumbers.shortnumberinfo as _S
+def national_significant_number(numobj):
+    national_number = ''
+    if numobj.italian_leading_zero:
+        num_zeros = numobj.number_of_leading_zeros
+        if num_zeros is None:
+            num_zeros = 1
+        if num_zeros > 0:
+            national_number = '0' * min(num_zeros, 10)
+    return national_number + str(numobj.national_number)
+for _mod in (P, PU, PM, _GE, _S):
+    _mod.national_significant_number = national_significant_number
+
+# Java's isAlphaNumber (and this port's) is false for a string over 250 characters, the cap
+# parsing has; python's phonenumbers 9.0.39 has no cap there (libphonenumber 9.0.39 arbitrated,
+# 2026-10-07: "111FLOWERS" and 241 ones is not an alpha number for Java, is for python). Patch
+# the oracle to Java's reading.
+_is_alpha_number = P.is_alpha_number
+def is_alpha_number(number):
+    return len(number) <= 250 and _is_alpha_number(number)
+P.is_alpha_number = is_alpha_number
+
+TYPES = {getattr(T, k): k for k in dir(T) if k.isupper()}
+TYPE_BY_NAME = {v: k for k, v in TYPES.items()}
+RESULTS = {getattr(V, k): k for k in dir(V) if k.isupper()}
+MATCHES = {getattr(M, k): k for k in dir(M) if k.isupper()}
+COSTS = {getattr(C, k): k for k in dir(C) if k.isupper()}
+ERRORS = {NumberParseException.INVALID_COUNTRY_CODE: 'INVALID_COUNTRY_CODE', NumberParseException.NOT_A_NUMBER: 'NOT_A_NUMBER',
+          NumberParseException.TOO_SHORT_AFTER_IDD: 'TOO_SHORT_AFTER_IDD', NumberParseException.TOO_SHORT_NSN: 'TOO_SHORT_NSN', NumberParseException.TOO_LONG: 'TOO_LONG'}
+FORMATS = [F.E164, F.INTERNATIONAL, F.NATIONAL, F.RFC3966]
+
+def num_out(n):
+    if n is None:
+        return None
+    return {'cc': n.country_code or 0, 'nn': n.national_number or 0, 'ext': n.extension or '',
+            'ilz': bool(n.italian_leading_zero), 'nlz': 1 if n.number_of_leading_zeros is None else n.number_of_leading_zeros,
+            'nlzSet': n.number_of_leading_zeros is not None,
+            'raw': n.raw_input or '', 'ccs': n.country_code_source or 0, 'pdcc': n.preferred_domestic_carrier_code or ''}
+
+def num_in(d):
+    return PhoneNumber(country_code=d['cc'], national_number=d['nn'], extension=d['ext'] or None,
+                       italian_leading_zero=True if d['ilz'] else None,
+                       number_of_leading_zeros=d['nlz'] if d.get('nlzSet') else None,
+                       raw_input=d['raw'] or None, country_code_source=d['ccs'] or 0,
+                       preferred_domestic_carrier_code=d['pdcc'] or None)
+
+def parse(req):
+    try:
+        n = P.parse(req['number'], req['region'] or None, keep_raw_input=req['keepRaw'])
+        return {'ok': True, 'num': num_out(n)}
+    except NumberParseException as e:
+        return {'ok': False, 'err': ERRORS.get(e.error_type, str(e.error_type))}
+
+def info(req):
+    n = num_in(req['num'])
+    region = req['region']
+    lang = req['lang']
+    t = P.number_type(n)
+    trunc = PhoneNumber()
+    trunc.merge_from(n)
+    truncated = P.truncate_too_long_number(trunc)
+    ex_type = TYPE_BY_NAME[req['type']]
+    try:
+        tz = list(TZ.time_zones_for_number(n))
+    except Exception as e:
+        tz = ['error: ' + type(e).__name__]
+    res = {
+        'valid': P.is_valid_number(n),
+        'validForRegion': P.is_valid_number_for_region(n, region),
+        'possible': P.is_possible_number(n),
+        'possibleReason': RESULTS[P.is_possible_number_with_reason(n)],
+        'possibleForType': P.is_possible_number_for_type(n, ex_type),
+        'possibleForTypeReason': RESULTS[P.is_possible_number_for_type_with_reason(n, ex_type)],
+        'type': TYPES[t],
+        'regionCode': P.region_code_for_number(n) or '',
+        'formats': [P.format_number(n, f) for f in FORMATS],
+        'outOfCountry': P.format_out_of_country_calling_number(n, region),
+        'outOfCountryAlpha': P.format_out_of_country_keeping_alpha_chars(n, region),
+        'original': P.format_in_original_format(n, region),
+        'carrierCode': P.format_national_number_with_carrier_code(n, req['carrier']),
+        'preferredCarrier': P.format_national_number_with_preferred_carrier_code(n, req['carrier']),
+        'mobileDialing': P.format_number_for_mobile_dialing(n, region, True),
+        'mobileDialingPlain': P.format_number_for_mobile_dialing(n, region, False),
+        'areaCodeLength': P.length_of_geographical_area_code(n),
+        'ndcLength': P.length_of_national_destination_code(n),
+        'geographical': P.is_number_geographical(n),
+        'intlDiallable': P.can_be_internationally_dialled(n),
+        'truncated': truncated,
+        'truncatedNum': num_out(trunc),
+        'nsn': P.national_significant_number(n),
+        'matchOther': MATCHES[P.is_number_match(n, req['other'])],
+        'matchNum': MATCHES[P.is_number_match(n, num_in(req['otherNum']))],
+        'timezones': tz,
+        'carrier': CA.name_for_number(n, lang),
+        'carrierValid': CA.name_for_valid_number(n, lang),
+        'countryName': GE.country_name_for_number(n, lang),
+        'description': GE.description_for_number(n, lang),
+        'descriptionValid': GE.description_for_valid_number(n, lang),
+        'descriptionUser': GE.description_for_number(n, lang, region=region),
+        'possibleShort': S.is_possible_short_number(n),
+        'possibleShortForRegion': S.is_possible_short_number_for_region(n, region),
+        'validShort': S.is_valid_short_number(n),
+        'validShortForRegion': S.is_valid_short_number_for_region(n, region),
+        'cost': COSTS[S.expected_cost(n)],
+        'costForRegion': COSTS[S.expected_cost_for_region(n, region)],
+        'carrierSpecific': S.is_carrier_specific(n),
+        'carrierSpecificForRegion': S.is_carrier_specific_for_region(n, region),
+        'smsService': S.is_sms_service_for_region(n, region),
+    }
+    return res
+
+def region(req):
+    r = req['region']
+    ex = P.example_number(r)
+    ext = P.example_number_for_type(r, TYPE_BY_NAME[req['type']])
+    cc = req['cc']
+    return {
+        'countryCode': P.country_code_for_region(r),
+        'ndd': P.ndd_prefix_for_region(r, False) or '',
+        'nddDigits': P.ndd_prefix_for_region(r, True) or '',
+        'nanpa': P.is_nanpa_country(r),
+        'portable': P.is_mobile_number_portable_region(r),
+        'example': num_out(ex),
+        'exampleForType': num_out(ext),
+        'types': sorted(TYPES[t] for t in P.supported_types_for_region(r)),
+        'regionForCC': P.region_code_for_country_code(cc),
+        'regionsForCC': list(P.region_codes_for_country_code(cc)),
+        'mobileToken': P.country_mobile_token(cc),
+        'exampleNonGeo': num_out(P.example_number_for_non_geo_entity(cc)),
+        'typesNonGeo': sorted(TYPES[t] for t in P.supported_types_for_non_geo_entity(cc)),
+        'invalidExample': num_out(P.invalid_example_number(r)) if hasattr(P, 'invalid_example_number') else None,
+    }
+
+def text(req):
+    s = req['text']
+    r = req['region']
+    return {
+        'alpha': P.is_alpha_number(s),
+        'converted': P.convert_alpha_characters_in_number(s),
+        'digits': P.normalize_digits_only(s),
+        'diallable': P.normalize_diallable_chars_only(s),
+        'emergency': S.is_emergency_number(s, r),
+        'connectsEmergency': S.connects_to_emergency_number(s, r),
+        'possibleString': P.is_possible_number_string(s, r or None),
+        'match': MATCHES[P.is_number_match(s, req['other'])],
+    }
+
+def aytf(req):
+    f = P.AsYouTypeFormatter(req['region'])
+    out = []
+    for i, ch in enumerate(req['chars']):
+        if i == req['remember']:
+            out.append(f.input_digit(ch, remember_position=True))
+        else:
+            out.append(f.input_digit(ch))
+    pos = f.get_remembered_position()
+    f.clear()
+    return {'out': out, 'pos': pos, 'afterClear': f.input_digit(req['chars'][0]) if req['chars'] else ''}
+
+def matcher(req):
+    lens = [L.POSSIBLE, L.VALID, L.STRICT_GROUPING, L.EXACT_GROUPING][req['leniency']]
+    ms = []
+    for m in P.PhoneNumberMatcher(req['text'], req['region'] or None, leniency=lens, max_tries=req['maxTries']):
+        ms.append({'start': m.start, 'end': m.end, 'raw': m.raw_string, 'num': num_out(m.number)})
+    return {'matches': ms}
+
+OPS = {'parse': parse, 'info': info, 'region': region, 'text': text, 'aytf': aytf, 'matcher': matcher}
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        res = OPS[req['op']](req)
+    except Exception as e:
+        res = {'error': type(e).__name__ + ': ' + str(e)[:300]}
+    sys.stdout.write(json.dumps(res) + '\n')
+    sys.stdout.flush()
+`
+
+// pyNumber is a PhoneNumber's fields as both sides describe them.
+type pyNumber struct {
+	CC     int    `json:"cc"`
+	NN     uint64 `json:"nn"`
+	Ext    string `json:"ext"`
+	ILZ    bool   `json:"ilz"`
+	NLZ    int    `json:"nlz"`
+	NLZSet bool   `json:"nlzSet"`
+	Raw    string `json:"raw"`
+	CCS    int    `json:"ccs"`
+	PDCC   string `json:"pdcc"`
+}
+
+func (p pyNumber) String() string {
+	return fmt.Sprintf("{cc %d nn %d ext %q ilz %v nlz %d(set %v) raw %q ccs %d pdcc %q}", p.CC, p.NN, p.Ext, p.ILZ, p.NLZ, p.NLZSet, p.Raw, p.CCS, p.PDCC)
+}
+
+type python struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+var (
+	pyOnce  sync.Once
+	pyChild *python
+	pyErr   error
+)
+
+func oracle(t *testing.T) *python {
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyErr = err
+			return
+		}
+		sc := bufio.NewScanner(stdout)
+		sc.Buffer(make([]byte, 1<<16), 1<<24)
+		pyChild = &python{cmd: cmd, in: bufio.NewWriter(stdin), out: sc}
+	})
+	if pyErr != nil {
+		t.Fatalf("cannot start the python phonenumbers oracle: %v", pyErr)
+	}
+	return pyChild
+}
+
+func (g *python) call(t *testing.T, req map[string]any, res any) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		t.Fatalf("oracle request: %v", err)
+	}
+	if _, err := g.in.Write(append(b, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	if err := g.in.Flush(); err != nil {
+		t.Fatalf("oracle flush: %v", err)
+	}
+	if !g.out.Scan() {
+		t.Fatalf("the python oracle died: %v (is the phonenumbers package installed?)", g.out.Err())
+	}
+	line := g.out.Bytes()
+	var probe struct {
+		Error string `json:"error"`
+	}
+	if json.Unmarshal(line, &probe) == nil && probe.Error != "" {
+		t.Fatalf("oracle: %s for %s", probe.Error, b)
+	}
+	if err := json.Unmarshal(line, res); err != nil {
+		t.Fatalf("oracle answer %q: %v", line, err)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..6f831df
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,228 @@
+package phonenumbers_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with random
+// contents, judged by the python oracle as TestHegelNumberQueriesAgreeWithLibphonenumber judges
+// it, so that each bug has a property that finds it every run and shrinks to a minimal example
+// of it; the wide property reaches the shapes at their natural rate. Under HEGEL_NO_KNOWN=1
+// each draws the neighbouring region instead (English lookups; raw inputs without + or *) and
+// passes.
+
+import (
+	"fmt"
+	"reflect"
+	"strconv"
+	"testing"
+
+	. "github.com/nyaruka/phonenumbers/v2"
+	"hegel.dev/go/hegel"
+)
+
+// ---- phonenumbers/1 --------------------------------------------------------------------------
+
+// seedTable is the seeds of a table of regions and type letters (F fixed line, M mobile, B
+// fixed line or mobile), in the order of the regions list.
+func seedTable(table map[string]string) []seedSpec {
+	letters := map[byte]PhoneNumberType{'F': FIXED_LINE, 'M': MOBILE, 'B': FIXED_LINE_OR_MOBILE}
+	var out []seedSpec
+	for _, r := range regions {
+		for i := 0; i < len(table[r]); i++ {
+			out = append(out, seedSpec{region: r, typ: ptrTo(letters[table[r][i]])})
+		}
+	}
+	return out
+}
+
+// areaSeeds and carrierSeeds: the regions and types whose example numbers, with their last
+// digits redrawn, have an English area description (areaSeeds) or carrier name (carrierSeeds)
+// that python's phonenumbers 9.0.39 gives in every language of lookupLangs by falling back to
+// English (probed 2026-10-07, the oracle gaps left out).
+var (
+	areaSeeds = seedTable(map[string]string{
+		"US": "FMB", "GB": "FB", "DE": "FB", "ES": "FB", "NL": "FB", "SE": "FB", "NO": "FB", "FI": "FB", "PL": "FB", "UA": "FB",
+		"TR": "FB", "IL": "FB", "IN": "FB", "CN": "FMB", "JP": "FB", "AU": "FB", "NZ": "FB", "TW": "FB", "ID": "FB", "TH": "FB",
+		"VN": "FB", "BR": "FMB", "AR": "FMB", "MX": "M", "CO": "FB", "PE": "FB", "CA": "FMB", "ZA": "FB", "NG": "FB", "KE": "FB",
+		"EG": "FB", "MA": "FB", "AE": "FB", "IR": "FB", "PK": "FB", "BD": "FB", "LK": "FB", "IE": "FB", "GR": "FB", "CZ": "FB",
+		"HU": "FB", "RO": "FB", "BG": "FB", "RS": "FB", "IM": "FB", "BS": "FB", "CI": "FB", "AC": "FB", "TA": "FB", "SH": "FB",
+		"HR": "FB", "SI": "FB",
+	})
+	carrierSeeds = seedTable(map[string]string{
+		"GB": "M", "DE": "M", "FR": "M", "ES": "M", "NL": "M", "CH": "M", "AT": "M", "SE": "M", "NO": "M", "FI": "M",
+		"DK": "FMB", "PL": "M", "UA": "M", "TR": "M", "IL": "M", "IN": "FMB", "CN": "M", "JP": "M", "KR": "M", "AU": "M",
+		"NZ": "M", "SG": "M", "HK": "M", "TW": "M", "ID": "M", "TH": "M", "VN": "M", "PH": "M", "MY": "M", "PE": "M",
+		"ZA": "M", "NG": "M", "KE": "M", "EG": "M", "MA": "M", "AE": "M", "IR": "M", "PK": "M", "BD": "M", "LK": "M",
+		"IE": "M", "PT": "M", "GR": "M", "CZ": "M", "HU": "M", "RO": "M", "RS": "M", "GG": "M", "JE": "M", "IM": "M",
+		"AS": "M", "BS": "M", "SM": "M", "AC": "M", "SH": "M", "HR": "M", "SI": "M", "LU": "M", "MC": "M", "LI": "M",
+		"MT": "M", "CY": "M", "IS": "M",
+	})
+	// lookupLangs: languages without area or carrier data for the seeds (zh, ja and ko are left
+	// out: libphonenumber does not fall back to English for them); English under
+	// HEGEL_NO_KNOWN=1.
+	lookupLangs = shaped[hegel.Generator[string]](hegel.SampledFrom([]string{"de", "fr", "ru", "es", "it", "pt", "ar", "he", "xx", ""}), hegel.Just("en"))
+)
+
+// lookupCase: a seed of one of the tables with its last digits (up to three) redrawn, looked up
+// in a language, in the region of the number.
+type lookupCase struct {
+	seed seedSpec
+	tail []int
+	lang string
+}
+
+func lookupCasesOf(seeds []seedSpec) hegel.Generator[lookupCase] {
+	return hegel.Composite(func(tc hegel.TestCase) lookupCase {
+		return lookupCase{
+			seed: hegel.Draw(tc, hegel.SampledFrom(seeds)),
+			tail: hegel.Draw(tc, many(hegel.Integers(0, 9), 0, 3)),
+			lang: hegel.Draw(tc, lookupLangs),
+		}
+	})
+}
+
+var (
+	areaCases    = lookupCasesOf(areaSeeds)
+	carrierCases = lookupCasesOf(carrierSeeds)
+)
+
+// number is the seed's number with the tail digits in place of its last ones.
+func (c lookupCase) number() *PhoneNumber {
+	p := c.seed.number()
+	digits := []rune(strconv.FormatUint(p.GetNationalNumber(), 10))
+	for i, d := range c.tail {
+		if j := len(digits) - len(c.tail) + i; j >= 0 {
+			digits[j] = rune('0' + d)
+		}
+	}
+	nn, _ := strconv.ParseUint(string(digits), 10, 64)
+	q := numIn(*numOut(p))
+	q.NationalNumber = &nn
+	return q
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c lookupCase) GoString() string {
+	return fmt.Sprintf("%s (seed %s) in lang %q", Format(c.number(), E164), c.seed.String(), c.lang)
+}
+
+// checkLookupCase judges a lookup case as the wide property does.
+func checkLookupCase(t *testing.T, py *python, ht *hegel.T, c lookupCase) {
+	num, r, lg := c.number(), c.seed.region, c.lang
+	want := info(t, py, num, r, lg, FIXED_LINE, "", "", num)
+	check := func(shape, what string, got, exp any) {
+		if !reflect.DeepEqual(got, exp) {
+			mismatch(ht, shape, "%s of %v (lang %q) is %#v but libphonenumber gives %#v", what, numOut(num), lg, got, exp)
+		}
+	}
+	checkPrefixLookups(num, r, lg, want, check)
+}
+
+// TestHegelAreaLookupsFallBackToEnglish: the area description of a number whose area has an
+// English name, asked for in a language without data for it, is the English name, as
+// libphonenumber's PrefixFileReader falls back to it; the port gives the country name instead
+// (phonenumbers/1). Under HEGEL_NO_KNOWN=1 the lookups are English.
+func TestHegelAreaLookupsFallBackToEnglish(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		checkLookupCase(t, py, ht, hegel.Draw(ht, areaCases))
+	}, hegel.WithReportMultipleFailures(false))
+}
+
+// TestHegelCarrierLookupsFallBackToEnglish: the carrier name of a number whose carrier has an
+// English name, asked for in a language without data for it, is the English name; the port
+// gives nothing (phonenumbers/1). Under HEGEL_NO_KNOWN=1 the lookups are English.
+func TestHegelCarrierLookupsFallBackToEnglish(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		checkLookupCase(t, py, ht, hegel.Draw(ht, carrierCases))
+	}, hegel.WithReportMultipleFailures(false))
+}
+
+// ---- phonenumbers/2 --------------------------------------------------------------------------
+
+// alphaCase: a seed number written as a raw input that FormatOutOfCountryKeepingAlphaChars
+// cannot trim at the first three digits of the national number (a separator splits them), with
+// a plus and the country code or a star before the national number, further separators after
+// the split, a vanity word before the plus or after the star once in four, and a star after the
+// number once in four; formatted as called from any region. The plus and the star survive the
+// port's normalisation (phonenumbers/2); the fullwidth plus does not (both ports drop it), so
+// under HEGEL_NO_KNOWN=1 the number is written without a mark or with the fullwidth plus, and no
+// star after it.
+type alphaCase struct {
+	seed  seedSpec
+	mark  string
+	split int
+	sep   string
+	gaps  []string
+	word  string
+	star  bool
+	from  string
+}
+
+var (
+	marks         = shaped[hegel.Generator[string]](hegel.SampledFrom([]string{"+", "*"}), hegel.SampledFrom([]string{"", "\uFF0B"}))
+	trailingStars = shaped[hegel.Generator[bool]](chance(25), hegel.Just(false))
+	alphaCases    = hegel.Composite(func(tc hegel.TestCase) alphaCase {
+		return alphaCase{
+			seed:  hegel.Draw(tc, seeds),
+			mark:  hegel.Draw(tc, marks),
+			split: hegel.Draw(tc, hegel.Integers(1, 2)),
+			sep:   hegel.Draw(tc, hegel.SampledFrom([]string{" ", "-", ".", "/"})),
+			gaps:  hegel.Draw(tc, gaps),
+			word:  hegel.Draw(tc, maybe(25, hegel.SampledFrom(vanity))),
+			star:  hegel.Draw(tc, trailingStars),
+			from:  hegel.Draw(tc, regionCodes),
+		}
+	})
+)
+
+// raw is the raw input, parsed in the seed's region.
+func (a alphaCase) raw() string {
+	p := a.seed.number()
+	digits := []rune(GetNationalSignificantNumber(p))
+	k := a.split
+	if k > len(digits) {
+		k = len(digits)
+	}
+	nsn := string(digits[:k]) + a.sep + grouped(string(digits[k:]), a.gaps)
+	if a.star {
+		nsn += "*"
+	}
+	switch a.mark {
+	case "*":
+		return "*" + a.word + nsn
+	case "":
+		return a.word + nsn
+	}
+	return a.word + a.mark + strconv.Itoa(int(p.GetCountryCode())) + " " + nsn
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (a alphaCase) GoString() string {
+	return fmt.Sprintf("%q parsed in %q (seed %s), formatted from %q", a.raw(), a.seed.region, a.seed.String(), a.from)
+}
+
+// TestHegelOutOfCountryAlphaFormattingDropsPlusAndStar: FormatOutOfCountryKeepingAlphaChars of a
+// number parsed with its raw input keeps the raw input's letters and grouping and drops its +
+// and * (libphonenumber's ALL_PLUS_NUMBER_GROUPING_SYMBOLS has neither), as the oracle does;
+// the port keeps them (phonenumbers/2). Under HEGEL_NO_KNOWN=1 the raw inputs hold neither.
+func TestHegelOutOfCountryAlphaFormattingDropsPlusAndStar(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		ac := hegel.Draw(ht, alphaCases)
+		raw := ac.raw()
+		num, err := ParseAndKeepRawInput(raw, ac.seed.region)
+		if err != nil {
+			ht.Fatalf("ParseAndKeepRawInput(%q, %q): %v", raw, ac.seed.region, err)
+		}
+		var parsed struct {
+			OK  bool      `json:"ok"`
+			Num *pyNumber `json:"num"`
+		}
+		py.call(t, map[string]any{"op": "parse", "number": raw, "region": ac.seed.region, "keepRaw": true}, &parsed)
+		ht.Assume(parsed.OK && sameNum(numOut(num), parsed.Num)) // the parsing property's business
+		want := info(t, py, num, ac.from, "en", FIXED_LINE, "", "", num)
+		got := FormatOutOfCountryKeepingAlphaChars(num, ac.from)
+		if got != want.OutOfCountryAlpha {
+			mismatch(ht, shapeIf(hasPlusOrStar(raw), "phonenumbers/2"), "FormatOutOfCountryKeepingAlphaChars of %q (parsed in %q) from %q is %q but libphonenumber gives %q", raw, ac.seed.region, ac.from, got, want.OutOfCountryAlpha)
+		}
+	}, hegel.WithReportMultipleFailures(false))
+}
