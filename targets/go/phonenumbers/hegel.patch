+// aytfCase: a candidate typed into the formatter character by character (three times in ten
+// only its dialling characters), at most 25 characters, the position remembered at an index
+// taken modulo the count half of the time.
+type aytfCase struct {
+	cand     candidate
+	dialOnly bool
+	remember *int
+}
+
+var aytfCases = hegel.Composite(func(tc hegel.TestCase) aytfCase {
+	return aytfCase{cand: hegel.Draw(tc, candidates), dialOnly: hegel.Draw(tc, chance(30)), remember: hegel.Draw(tc, optional(50, positions))}
+})
+
+func isDialChar(c rune) bool {
+	return c >= '0' && c <= '9' || c == '+' || c == ' ' || c == '-' || c == '(' || c == ')' || c == '*' || c == '#'
+}
+
+// chars is the sequence typed.
+func (a aytfCase) chars() []rune {
+	s := a.cand.text()
+	if a.dialOnly {
+		s = strings.Map(func(c rune) rune {
+			if isDialChar(c) {
+				return c
+			}
+			return -1
+		}, s)
+	}
+	rs := []rune(s)
+	if len(rs) > 25 {
+		rs = rs[:25]
+	}
+	return rs
+}
+
+// rememberAt is the index of the remembered character, -1 for none.
+func (a aytfCase) rememberAt() int {
+	n := len(a.chars())
+	if a.remember == nil || n == 0 {
+		return -1
+	}
+	return *a.remember % n
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (a aytfCase) GoString() string {
+	return fmt.Sprintf("typed %q in region %q, remembered at %d (from %#v)", string(a.chars()), a.cand.region, a.rememberAt(), a.cand)
+}
+
+// The as-you-type formatter produces the same text after every character.
+func TestHegelAsYouTypeFormatterAgrees(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		ac := hegel.Draw(ht, aytfCases)
+		r, chars, remember := ac.cand.region, ac.chars(), ac.rememberAt()
+		f := GetAsYouTypeFormatter(r)
+		got := make([]string, 0, len(chars))
+		for i, c := range chars {
+			if i == remember {
+				got = append(got, f.InputDigitAndRememberPosition(c))
+			} else {
+				got = append(got, f.InputDigit(c))
+			}
+		}
+		pos := f.GetRememberedPosition()
+		f.Clear()
+		after := ""
+		if len(chars) > 0 {
+			after = f.InputDigit(chars[0])
+		}
+		strChars := make([]string, len(chars))
+		for i, c := range chars {
+			strChars[i] = string(c)
+		}
+		var want struct {
+			Out        []string `json:"out"`
+			Pos        int      `json:"pos"`
+			AfterClear string   `json:"afterClear"`
+		}
+		py.call(t, map[string]any{"op": "aytf", "region": r, "chars": strChars, "remember": remember}, &want)
+		if want.Out == nil {
+			want.Out = []string{}
+		}
+		for i := range chars {
+			if got[i] != want.Out[i] {
+				fail(ht, "AsYouTypeFormatter(%q) after %q (char %d of %q) shows %q but libphonenumber %q", r, string(chars[:i+1]), i, string(chars), got[i], want.Out[i])
+			}
+		}
+		if pos != want.Pos {
+			fail(ht, "AsYouTypeFormatter(%q).GetRememberedPosition after %q (remembered at %d) is %d but libphonenumber %d", r, string(chars), remember, pos, want.Pos)
+		}
+		if after != want.AfterClear {
+			fail(ht, "AsYouTypeFormatter(%q) after Clear and %q shows %q but libphonenumber %q", r, string(chars[:1]), after, want.AfterClear)
+		}
+	})
+}
