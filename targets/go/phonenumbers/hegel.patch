+// Bug 2: FormatOutOfCountryKeepingAlphaChars keeps a "+" or "*" of the raw input.
+func TestHegelPinAlphaFormattingDropsPlusAndStar(t *testing.T) {
+	cases := [][4]string{
+		{"+1 20-1-55500-2-3", "US", "HU", "00 1 1 20-1-55500-2-3"},
+		{"*02 1234 5678-", "IT", "IT", "02 1234 5678-"},
+		{"*MyBiz02 1234 5678-", "IT", "EH", "00 39 MYBIZ02 1234 5678-"},
+		{"telFLOWERS:+86-10-1234-5678", "CN", "CN", "TELFLOWERS086-10-1234-5678"},
+	}
+	for _, c := range cases {
+		num, err := ParseAndKeepRawInput(c[0], c[1])
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := FormatOutOfCountryKeepingAlphaChars(num, c[2]); got != c[3] {
+			t.Errorf("FormatOutOfCountryKeepingAlphaChars(%q parsed in %s, from %s) = %q, libphonenumber gives %q", c[0], c[1], c[2], got, c[3])
+		}
+	}
