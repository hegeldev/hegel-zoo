+// The as-you-type formatter produces the same text after every character.
+func TestHegelAsYouTypeFormatterAgrees(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		s, r := candidate(tc)
+		if chance(tc, 30) {
+			s = strings.Map(func(c rune) rune {
+				if c >= '0' && c <= '9' || c == '+' || c == ' ' || c == '-' || c == '(' || c == ')' || c == '*' || c == '#' {
+					return c
+				}
+				return -1
+			}, s)
+		}
+		chars := []rune(s)
+		if len(chars) > 25 {
+			chars = chars[:25]
+		}
+		remember := -1
+		if len(chars) > 0 && chance(tc, 50) {
+			remember = n(tc, 0, len(chars)-1)
+		}
+		f := GetAsYouTypeFormatter(r)
+		got := make([]string, 0, len(chars))
+		for i, c := range chars {
+			if i == remember {
+				got = append(got, f.InputDigitAndRememberPosition(c))
+			} else {
+				got = append(got, f.InputDigit(c))
+			}
+		}
+		pos := f.GetRememberedPosition()
+		f.Clear()
+		after := ""
+		if len(chars) > 0 {
+			after = f.InputDigit(chars[0])
+		}
+		strChars := make([]string, len(chars))
+		for i, c := range chars {
+			strChars[i] = string(c)
+		}
+		var want struct {
+			Out        []string `json:"out"`
+			Pos        int      `json:"pos"`
+			AfterClear string   `json:"afterClear"`
+		}
+		py.call(t, map[string]any{"op": "aytf", "region": r, "chars": strChars, "remember": remember}, &want)
+		if want.Out == nil {
+			want.Out = []string{}
+		}
+		note(ht, "input %q region %q remember %d", string(chars), r, remember)
+		for i := range chars {
+			if got[i] != want.Out[i] {
+				fail(ht, "AsYouTypeFormatter(%q) after %q (char %d of %q) shows %q but libphonenumber %q", r, string(chars[:i+1]), i, string(chars), got[i], want.Out[i])
+			}
+		}
+		if pos != want.Pos {
+			fail(ht, "AsYouTypeFormatter(%q).GetRememberedPosition after %q (remembered at %d) is %d but libphonenumber %d", r, string(chars), remember, pos, want.Pos)
+		}
+		if after != want.AfterClear {
+			fail(ht, "AsYouTypeFormatter(%q) after Clear and %q shows %q but libphonenumber %q", r, string(chars[:1]), after, want.AfterClear)
+		}
+	})
+}
