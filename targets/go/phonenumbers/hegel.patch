+// Every query on a parsed number agrees with libphonenumber.
+func TestHegelNumberQueriesAgreeWithLibphonenumber(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		num, s, r := parsedNumber(t, py, tc)
+		if num == nil {
+			return
+		}
+		if chance(tc, 30) {
+			r = region(tc)
+		}
+		typ := pick(tc, allTypes)
+		lg := lang(tc)
+		carrierCode := pick(tc, []string{"", "15", "1", "0", "1090", "ab"})
+		// a second number to match against: the same, a variant, or unrelated
+		other, _ := candidate(tc)
+		if chance(tc, 40) {
+			other = Format(num, pick(tc, []PhoneNumberFormat{E164, INTERNATIONAL, NATIONAL, RFC3966}))
+			if chance(tc, 40) {
+				other = other[n(tc, 0, len(other)/2):]
+			}
+		}
+		otherNum := numIn(*numOut(num))
+		if chance(tc, 50) {
+			if p, err := Parse(other, r); err == nil {
+				otherNum = p
+			}
+		} else if chance(tc, 50) {
+			otherNum.CountryCode = nil
+		}
+		var want infoResult
+		py.call(t, map[string]any{"op": "info", "num": numOut(num), "region": r, "lang": lg, "type": typeNames[typ], "carrier": carrierCode, "other": other, "otherNum": numOut(otherNum)}, &want)
+		note(ht, "input %q region %q number %v", s, r, numOut(num))
+		check := func(what string, got, exp any) {
+			if !reflect.DeepEqual(got, exp) {
+				fail(ht, "%s of %v (from %q, region %q, lang %q, type %s) is %#v but libphonenumber gives %#v", what, numOut(num), s, r, lg, typeNames[typ], got, exp)
+			}
+		}
+		check("IsValidNumber", IsValidNumber(num), want.Valid)
+		check("IsValidNumberForRegion", IsValidNumberForRegion(num, r), want.ValidForRegion)
+		check("IsPossibleNumber", IsPossibleNumber(num), want.Possible)
+		check("IsPossibleNumberWithReason", resultNames[IsPossibleNumberWithReason(num)], want.PossibleReason)
+		check("IsPossibleNumberForType", IsPossibleNumberForType(num, typ), want.PossibleForType)
+		check("IsPossibleNumberForTypeWithReason", resultNames[IsPossibleNumberForTypeWithReason(num, typ)], want.PossibleForTypeReason)
+		check("GetNumberType", typeNames[GetNumberType(num)], want.Type)
+		check("GetRegionCodeForNumber", GetRegionCodeForNumber(num), want.RegionCode)
+		check("Format", []string{Format(num, E164), Format(num, INTERNATIONAL), Format(num, NATIONAL), Format(num, RFC3966)}, want.Formats)
+		check("FormatOutOfCountryCallingNumber", FormatOutOfCountryCallingNumber(num, r), want.OutOfCountry)
+		if !known.keepsPlusAndStar(num.GetRawInput()) {
+			check("FormatOutOfCountryKeepingAlphaChars", FormatOutOfCountryKeepingAlphaChars(num, r), want.OutOfCountryAlpha)
+		}
+		check("FormatInOriginalFormat", FormatInOriginalFormat(num, r), want.Original)
+		check("FormatNationalNumberWithCarrierCode", FormatNationalNumberWithCarrierCode(num, carrierCode), want.CarrierCode)
+		check("FormatNationalNumberWithPreferredCarrierCode", FormatNationalNumberWithPreferredCarrierCode(num, carrierCode), want.PreferredCarrier)
+		check("FormatNumberForMobileDialing(formatted)", FormatNumberForMobileDialing(num, r, true), want.MobileDialing)
+		check("FormatNumberForMobileDialing(plain)", FormatNumberForMobileDialing(num, r, false), want.MobileDialingPlain)
+		check("GetLengthOfGeographicalAreaCode", GetLengthOfGeographicalAreaCode(num), want.AreaCodeLength)
+		check("GetLengthOfNationalDestinationCode", GetLengthOfNationalDestinationCode(num), want.NdcLength)
+		check("IsNumberGeographical", IsNumberGeographical(num), want.Geographical)
+		check("CanBeInternationallyDialled", CanBeInternationallyDialled(num), want.IntlDiallable)
+		check("GetNationalSignificantNumber", GetNationalSignificantNumber(num), want.NSN)
+		check("IsNumberMatchWithOneNumber", matchNames[IsNumberMatchWithOneNumber(num, other)], want.MatchOther)
+		check("IsNumberMatchWithNumbers", matchNames[IsNumberMatchWithNumbers(num, otherNum)], want.MatchNum)
+		tzs, err := timezone.GetTimeZonesForNumber(num)
+		check("timezone.GetTimeZonesForNumber", strs(err, tzs), want.Timezones)
+		// Carrier and area names are compared in English only: python has no English fallback for
+		// languages without data (a Java behaviour this port lacks too, bug 1) and its country names
+		// come from its own table, not CLDR ("Antigua and Barbuda" against Java's and this port's
+		// "Antigua & Barbuda"), so a description equal to python's country name is not compared.
+		cc := int(num.GetCountryCode())
+		if lg == "en" && !oracleGap.carrierData(cc) {
+			check("carrier.GetNameForNumber", str(carrier.GetNameForNumber(num, lg)), want.Carrier)
+			check("carrier.GetNameForValidNumber", str(carrier.GetNameForValidNumber(num, lg)), want.CarrierValid)
+		}
+		if lg == "en" && !oracleGap.geocodingData(cc) {
+			if want.Description != want.CountryName {
+				check("geocoding.GetDescriptionForNumber", str(geocoding.GetDescriptionForNumber(num, lg)), want.Description)
+			}
+			if want.DescriptionValid != want.CountryName {
+				check("geocoding.GetDescriptionForValidNumber", str(geocoding.GetDescriptionForValidNumber(num, lg)), want.DescriptionValid)
+			}
+			if want.DescriptionUser != want.CountryName {
+				check("geocoding.GetDescriptionForNumberForUserRegion", str(geocoding.GetDescriptionForNumberForUserRegion(num, lg, r)), want.DescriptionUser)
+			}
+		}
+		check("IsPossibleShortNumber", IsPossibleShortNumber(num), want.PossibleShort)
+		check("IsPossibleShortNumberForRegion", IsPossibleShortNumberForRegion(num, r), want.PossibleShortForRegion)
+		check("IsValidShortNumber", IsValidShortNumber(num), want.ValidShort)
+		check("IsValidShortNumberForRegion", IsValidShortNumberForRegion(num, r), want.ValidShortForRegion)
+		check("GetExpectedCost", costNames[GetExpectedCost(num)], want.Cost)
+		check("GetExpectedCostForRegion", costNames[GetExpectedCostForRegion(num, r)], want.CostForRegion)
+		check("IsCarrierSpecific", IsCarrierSpecific(num), want.CarrierSpecific)
+		check("IsCarrierSpecificForRegion", IsCarrierSpecificForRegion(num, r), want.CarrierSpecificForRegion)
+		check("IsSmsServiceForRegion", IsSmsServiceForRegion(num, r), want.SmsService)
+		// truncation works on a copy
+		copyNum := numIn(*numOut(num))
+		truncated := TruncateTooLongNumber(copyNum)
+		check("TruncateTooLongNumber", truncated, want.Truncated)
+		check("TruncateTooLongNumber result", numOut(copyNum), want.TruncatedNum)
+	})
+}
