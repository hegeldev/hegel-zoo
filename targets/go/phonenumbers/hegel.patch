+// Parsing agrees with libphonenumber: the same error class, or the same number.
+func TestHegelParsingAgreesWithLibphonenumber(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		s, r := candidate(tc)
+		keep := chance(tc, 50)
+		var got *PhoneNumber
+		var err error
+		if keep {
+			got, err = ParseAndKeepRawInput(s, r)
+		} else {
+			got, err = Parse(s, r)
+		}
+		var want struct {
+			OK  bool      `json:"ok"`
+			Err string    `json:"err"`
+			Num *pyNumber `json:"num"`
+		}
+		py.call(t, map[string]any{"op": "parse", "number": s, "region": r, "keepRaw": keep}, &want)
+		note(ht, "input %q region %q keepRaw %v", s, r, keep)
+		if want.OK != (err == nil) {
+			if err != nil {
+				fail(ht, "Parse(%q, %q) fails with %v but libphonenumber parses it to %v", s, r, err, want.Num)
+			}
+			fail(ht, "Parse(%q, %q) gives %v but libphonenumber fails with %s", s, r, numOut(got), want.Err)
+		}
+		if err != nil {
+			if errName(err) != want.Err {
+				fail(ht, "Parse(%q, %q) fails with %s but libphonenumber with %s", s, r, errName(err), want.Err)
+			}
+			return
+		}
+		if !sameNum(numOut(got), want.Num) {
+			fail(ht, "Parse(%q, %q, keepRaw %v) gives %v but libphonenumber %v", s, r, keep, numOut(got), want.Num)
+		}
+	})
+}
