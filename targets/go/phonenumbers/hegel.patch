+type textResult struct {
+	Alpha             bool   `json:"alpha"`
+	Converted         string `json:"converted"`
+	Digits            string `json:"digits"`
+	Diallable         string `json:"diallable"`
+	Emergency         bool   `json:"emergency"`
+	ConnectsEmergency bool   `json:"connectsEmergency"`
+	PossibleString    bool   `json:"possibleString"`
+	Match             string `json:"match"`
+}
+
+func typeSet(m map[PhoneNumberType]bool) []string {
+	out := []string{}
+	for k, v := range m {
+		if v {
+			out = append(out, typeNames[k])
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// helperCase: a region, a calling code and a type for the metadata queries; a candidate (or,
+// once in five, one to four short digits for the emergency helpers) and a second text (the same
+// three times in ten) for the string helpers.
+type helperCase struct {
+	region string
+	cc     int
+	typ    PhoneNumberType
+	cand   candidate
+	short  *digitText
+	other  *candidate
+}
+
+var helperCases = hegel.Composite(func(tc hegel.TestCase) helperCase {
+	return helperCase{
+		region: hegel.Draw(tc, regionCodes),
+		cc:     hegel.Draw(tc, callingCodeDraws),
+		typ:    hegel.Draw(tc, numberTypes),
+		cand:   hegel.Draw(tc, candidates),
+		short:  hegel.Draw(tc, optional(20, digitsOf(1, 4))),
+		other:  hegel.Draw(tc, optional(70, candidates)),
+	}
+})
+
+// text is the string of the helpers, in the candidate's region.
+func (h helperCase) text() string {
+	if h.short != nil {
+		return h.short.String()
+	}
+	return h.cand.text()
+}
+
+func (h helperCase) otherText() string {
+	if h.other != nil {
+		return h.other.text()
+	}
+	return h.text()
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (h helperCase) GoString() string {
+	return fmt.Sprintf("region %q, calling code %d, type %s; text %q in region %q, other %q", h.region, h.cc, typeNames[h.typ], h.text(), h.cand.region, h.otherText())
+}
