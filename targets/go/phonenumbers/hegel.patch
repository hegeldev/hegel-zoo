+	Portable       bool      `json:"portable"`
+	Example        *pyNumber `json:"example"`
+	ExampleForType *pyNumber `json:"exampleForType"`
+	Types          []string  `json:"types"`
+	RegionForCC    string    `json:"regionForCC"`
+	RegionsForCC   []string  `json:"regionsForCC"`
+	MobileToken    string    `json:"mobileToken"`
+	ExampleNonGeo  *pyNumber `json:"exampleNonGeo"`
+	TypesNonGeo    []string  `json:"typesNonGeo"`
+	InvalidExample *pyNumber `json:"invalidExample"`
+}
