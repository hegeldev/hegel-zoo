+}
+
+// info asks the oracle every query on num: in region r, language lg, for the type, the carrier
+// code and the second string and number of IsNumberMatch.
+func info(t *testing.T, py *python, num *PhoneNumber, r, lg string, typ PhoneNumberType, carrierCode, other string, otherNum *PhoneNumber) infoResult {
+	var want infoResult
+	py.call(t, map[string]any{"op": "info", "num": numOut(num), "region": r, "lang": lg, "type": typeNames[typ], "carrier": carrierCode, "other": other, "otherNum": numOut(otherNum)}, &want)
+	return want
+}
+
+// agreed asks the oracle to parse the case and reports whether it gives the same number (the
+// parsing property's business when it does not).
+func agreed(t *testing.T, py *python, pc parseCase, num *PhoneNumber) bool {
+	var want struct {
+		OK  bool      `json:"ok"`
+		Num *pyNumber `json:"num"`
+	}
+	py.call(t, map[string]any{"op": "parse", "number": pc.cand.text(), "region": pc.cand.region, "keepRaw": pc.keep}, &want)
+	return want.OK && sameNum(numOut(num), want.Num)
+}
+
+func strs(err error, xs []string) []string {
+	if err != nil {
+		return []string{"error: " + err.Error()}
+	}
+	if xs == nil {
+		return []string{}
+	}
+	return xs
+}
+
+func str(s string, err error) string {
+	if err != nil {
+		return "error: " + err.Error()
+	}
+	return s
+}
+
+// checkPrefixLookups compares the carrier and area lookups of num in language lg with the
+// oracle's answers. Python's country names come from its own table, not CLDR ("Antigua and
+// Barbuda" against Java's and this port's "Antigua & Barbuda"), so a description equal to
+// python's country name is not compared, and the oracle's extra prefix data is gated by calling
+// code (oracleGap). A mismatch in a language other than English is the shape of phonenumbers/1
+// (no fallback to English); under HEGEL_NO_KNOWN=1 the lookups are compared in English only.
+func checkPrefixLookups(num *PhoneNumber, r, lg string, want infoResult, check func(shape, what string, got, exp any)) {
+	if Known.englishOnlyLookups && lg != "en" {
+		return
+	}
+	shape := shapeIf(lg != "en", "phonenumbers/1")
+	cc := int(num.GetCountryCode())
+	if !oracleGap.carrierData(cc) {
+		check(shape, "carrier.GetNameForNumber", str(carrier.GetNameForNumber(num, lg)), want.Carrier)
+		check(shape, "carrier.GetNameForValidNumber", str(carrier.GetNameForValidNumber(num, lg)), want.CarrierValid)
+	}
+	if !oracleGap.geocodingData(cc) {
+		if want.Description != want.CountryName {
+			check(shape, "geocoding.GetDescriptionForNumber", str(geocoding.GetDescriptionForNumber(num, lg)), want.Description)
+		}
+		if want.DescriptionValid != want.CountryName {
+			check(shape, "geocoding.GetDescriptionForValidNumber", str(geocoding.GetDescriptionForValidNumber(num, lg)), want.DescriptionValid)
+		}
+		if want.DescriptionUser != want.CountryName {
+			check(shape, "geocoding.GetDescriptionForNumberForUserRegion", str(geocoding.GetDescriptionForNumberForUserRegion(num, lg, r)), want.DescriptionUser)
+		}
+	}
+}
+
+// otherText: the second string of IsNumberMatch: a candidate's text, or (four times in ten) the
+// number formatted and cut at a position taken modulo half its length four times in ten.
+type otherText struct {
+	cand      candidate
+	formatted bool
+	format    PhoneNumberFormat
+	cut       *int
+}
+
+var otherTexts = weighted(
+	choice[otherText]{60, hegel.Map(candidates, func(c candidate) otherText { return otherText{cand: c} })},
+	choice[otherText]{40, hegel.Composite(func(tc hegel.TestCase) otherText {
+		return otherText{formatted: true, format: hegel.Draw(tc, formats), cut: hegel.Draw(tc, optional(40, positions))}
+	})},
+)
+
+func (o otherText) text(num *PhoneNumber) string {
+	if !o.formatted {
+		return o.cand.text()
+	}
+	s := Format(num, o.format)
+	if o.cut != nil {
+		rs := []rune(s)
+		s = string(rs[*o.cut%(len(rs)/2+1):])
+	}
+	return s
+}
+
+// queryCase: a parsed number (raw input kept four times in ten), the region of the queries
+// (the parse region, or three times in ten another), a type, a language, a carrier code, a
+// second string and a second number to match: the same number, the second string parsed, or
+// the same without its country code.
+type queryCase struct {
+	pc       parseCase
+	alt      *string
+	typ      PhoneNumberType
+	lang     string
+	carrier  string
+	other    otherText
+	otherNum int
+}
+
+const (
+	sameNumber = iota
+	parsedOther
+	withoutCountryCode
+)
+
+// parsables: parse cases whose text the library parses (the oracle's agreement is checked in the
+// property).
+var parsables = hegel.Filter(parseCasesOf(40), func(pc parseCase) bool {
+	_, err := pc.parse()
+	return err == nil
+})
+
+var queryCases = hegel.Composite(func(tc hegel.TestCase) queryCase {
+	return queryCase{
+		pc:       hegel.Draw(tc, parsables),
+		alt:      hegel.Draw(tc, optional(30, regionCodes)),
+		typ:      hegel.Draw(tc, numberTypes),
+		lang:     hegel.Draw(tc, languages),
+		carrier:  hegel.Draw(tc, hegel.SampledFrom([]string{"", "15", "1", "0", "1090", "ab"})),
+		other:    hegel.Draw(tc, otherTexts),
+		otherNum: hegel.Draw(tc, hegel.SampledFrom([]int{sameNumber, parsedOther, parsedOther, withoutCountryCode})),
+	}
+})
+
+// region is the region of the queries.
+func (q queryCase) region() string {
+	if q.alt != nil {
+		return *q.alt
+	}
+	return q.pc.cand.region
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (q queryCase) GoString() string {
+	other := fmt.Sprintf("%#v", q.other.cand)
+	if q.other.formatted {
+		other = fmt.Sprintf("the number in format %d", q.other.format)
+		if q.other.cut != nil {
+			other += fmt.Sprintf(" cut at %d", *q.other.cut)
+		}
+	}
+	return fmt.Sprintf("%#v\n    queried in region %q, type %s, lang %q, carrier %q, other %s, otherNum %d", q.pc, q.region(), typeNames[q.typ], q.lang, q.carrier, other, q.otherNum)
+}
+
+// Every query on a parsed number agrees with libphonenumber. The area and carrier lookups are
+// made in every language (phonenumbers/1: no fallback to English) and the alpha-keeping
+// formatting is checked on every raw input (phonenumbers/2: a + or * of the raw input is kept);
+// under HEGEL_NO_KNOWN=1 the lookups are English only and the raw inputs with + or * skip the
+// alpha check.
+func TestHegelNumberQueriesAgreeWithLibphonenumber(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		qc := hegel.Draw(ht, queryCases)
+		num, err := qc.pc.parse()
+		if err != nil {
+			ht.Fatalf("Parse(%q, %q) after the filter: %v", qc.pc.cand.text(), qc.pc.cand.region, err)
+		}
+		ht.Assume(agreed(t, py, qc.pc, num))
+		s, r, lg, typ, carrierCode := qc.pc.cand.text(), qc.region(), qc.lang, qc.typ, qc.carrier
+		other := qc.other.text(num)
+		otherNum := numIn(*numOut(num))
+		switch qc.otherNum {
+		case parsedOther:
+			if p, err := Parse(other, r); err == nil {
+				otherNum = p
+			}
+		case withoutCountryCode:
+			otherNum.CountryCode = nil
+		}
+		want := info(t, py, num, r, lg, typ, carrierCode, other, otherNum)
+		ht.Note(fmt.Sprintf("number %v, other %q", numOut(num), other))
+		check := func(shape, what string, got, exp any) {
+			if !reflect.DeepEqual(got, exp) {
+				mismatch(ht, shape, "%s of %v (from %q, region %q, lang %q, type %s) is %#v but libphonenumber gives %#v", what, numOut(num), s, r, lg, typeNames[typ], got, exp)
+			}
+		}
+		check("", "IsValidNumber", IsValidNumber(num), want.Valid)
+		check("", "IsValidNumberForRegion", IsValidNumberForRegion(num, r), want.ValidForRegion)
+		check("", "IsPossibleNumber", IsPossibleNumber(num), want.Possible)
+		check("", "IsPossibleNumberWithReason", resultNames[IsPossibleNumberWithReason(num)], want.PossibleReason)
+		check("", "IsPossibleNumberForType", IsPossibleNumberForType(num, typ), want.PossibleForType)
+		check("", "IsPossibleNumberForTypeWithReason", resultNames[IsPossibleNumberForTypeWithReason(num, typ)], want.PossibleForTypeReason)
+		check("", "GetNumberType", typeNames[GetNumberType(num)], want.Type)
+		check("", "GetRegionCodeForNumber", GetRegionCodeForNumber(num), want.RegionCode)
+		check("", "Format", []string{Format(num, E164), Format(num, INTERNATIONAL), Format(num, NATIONAL), Format(num, RFC3966)}, want.Formats)
+		check("", "FormatOutOfCountryCallingNumber", FormatOutOfCountryCallingNumber(num, r), want.OutOfCountry)
+		if raw := num.GetRawInput(); !(Known.keepsPlusAndStar && hasPlusOrStar(raw)) {
+			check(shapeIf(hasPlusOrStar(raw), "phonenumbers/2"), "FormatOutOfCountryKeepingAlphaChars", FormatOutOfCountryKeepingAlphaChars(num, r), want.OutOfCountryAlpha)
+		}
+		check("", "FormatInOriginalFormat", FormatInOriginalFormat(num, r), want.Original)
+		check("", "FormatNationalNumberWithCarrierCode", FormatNationalNumberWithCarrierCode(num, carrierCode), want.CarrierCode)
+		check("", "FormatNationalNumberWithPreferredCarrierCode", FormatNationalNumberWithPreferredCarrierCode(num, carrierCode), want.PreferredCarrier)
+		check("", "FormatNumberForMobileDialing(formatted)", FormatNumberForMobileDialing(num, r, true), want.MobileDialing)
+		check("", "FormatNumberForMobileDialing(plain)", FormatNumberForMobileDialing(num, r, false), want.MobileDialingPlain)
+		check("", "GetLengthOfGeographicalAreaCode", GetLengthOfGeographicalAreaCode(num), want.AreaCodeLength)
+		check("", "GetLengthOfNationalDestinationCode", GetLengthOfNationalDestinationCode(num), want.NdcLength)
+		check("", "IsNumberGeographical", IsNumberGeographical(num), want.Geographical)
+		check("", "CanBeInternationallyDialled", CanBeInternationallyDialled(num), want.IntlDiallable)
+		check("", "GetNationalSignificantNumber", GetNationalSignificantNumber(num), want.NSN)
+		check("", "IsNumberMatchWithOneNumber", matchNames[IsNumberMatchWithOneNumber(num, other)], want.MatchOther)
+		check("", "IsNumberMatchWithNumbers", matchNames[IsNumberMatchWithNumbers(num, otherNum)], want.MatchNum)
+		tzs, err := timezone.GetTimeZonesForNumber(num)
+		check("", "timezone.GetTimeZonesForNumber", strs(err, tzs), want.Timezones)
+		checkPrefixLookups(num, r, lg, want, check)
+		check("", "IsPossibleShortNumber", IsPossibleShortNumber(num), want.PossibleShort)
+		check("", "IsPossibleShortNumberForRegion", IsPossibleShortNumberForRegion(num, r), want.PossibleShortForRegion)
+		check("", "IsValidShortNumber", IsValidShortNumber(num), want.ValidShort)
+		check("", "IsValidShortNumberForRegion", IsValidShortNumberForRegion(num, r), want.ValidShortForRegion)
+		check("", "GetExpectedCost", costNames[GetExpectedCost(num)], want.Cost)
+		check("", "GetExpectedCostForRegion", costNames[GetExpectedCostForRegion(num, r)], want.CostForRegion)
+		check("", "IsCarrierSpecific", IsCarrierSpecific(num), want.CarrierSpecific)
+		check("", "IsCarrierSpecificForRegion", IsCarrierSpecificForRegion(num, r), want.CarrierSpecificForRegion)
+		check("", "IsSmsServiceForRegion", IsSmsServiceForRegion(num, r), want.SmsService)
+		// truncation works on a copy
+		copyNum := numIn(*numOut(num))
+		truncated := TruncateTooLongNumber(copyNum)
+		check("", "TruncateTooLongNumber", truncated, want.Truncated)
+		check("", "TruncateTooLongNumber result", numOut(copyNum), want.TruncatedNum)
+	})
+}
