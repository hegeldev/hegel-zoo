+var words = []string{"call", "me", "at", "or", "fax", "tel", "phone", "the", "office", "number", "is", "and", "please", "ring", "mobile", "Tel.", "Fax:", "Contact:", "on", "before", "after", "9am", "5pm", "Monday", "room", "2024", "1999", "12", "3", "a", "ext", "x"}
+
+// matcherCase: a text of up to six parts, each a word or a candidate's text, joined by one
+// separator, searched in a region with a leniency and a limit of tries.
+type matcherCase struct {
+	region   string
+	parts    []string
+	sep      string
+	leniency Leniency
+	maxTries int
+}
+
+var (
+	textParts    = weighted(choice[string]{50, hegel.SampledFrom(words)}, choice[string]{50, hegel.Map(candidates, candidate.text)})
+	textSeps     = hegel.SampledFrom([]string{" ", " ", ", ", ". ", "\n", " - ", ":", "/", "", "  "})
+	leniencies   = hegel.SampledFrom([]Leniency{POSSIBLE, VALID, STRICT_GROUPING, EXACT_GROUPING})
+	triesLimits  = hegel.SampledFrom([]int{65535, 65535, 3, 1, 0})
+	matcherCases = hegel.Composite(func(tc hegel.TestCase) matcherCase {
+		return matcherCase{
+			region:   hegel.Draw(tc, regionCodes),
+			parts:    hegel.Draw(tc, many(textParts, 0, 6)),
+			sep:      hegel.Draw(tc, textSeps),
+			leniency: hegel.Draw(tc, leniencies),
+			maxTries: hegel.Draw(tc, triesLimits),
+		}
+	})
+)
+
+func (m matcherCase) text() string { return strings.Join(m.parts, m.sep) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (m matcherCase) GoString() string {
+	return fmt.Sprintf("text %q in region %q, leniency %d, maxTries %d", m.text(), m.region, m.leniency, m.maxTries)
+}
+
+// The number matcher finds the same numbers in text.
+func TestHegelNumberMatcherAgrees(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		mc := hegel.Draw(ht, matcherCases)
+		text, r, leniency, maxTries := mc.text(), mc.region, mc.leniency, mc.maxTries
+		type match struct {
+			Start int       `json:"start"`
+			End   int       `json:"end"`
+			Raw   string    `json:"raw"`
+			Num   *pyNumber `json:"num"`
+		}
+		got := []match{}
+		for m := range FindNumbersWithLeniency(text, r, leniency, maxTries) {
+			// Go offsets are bytes; python's are code points
+			got = append(got, match{len([]rune(text[:m.Start()])), len([]rune(text[:m.End()])), m.RawString(), numOut(m.Number())})
+		}
+		var want struct {
+			Matches []match `json:"matches"`
+		}
+		py.call(t, map[string]any{"op": "matcher", "text": text, "region": r, "leniency": int(leniency), "maxTries": maxTries}, &want)
+		if want.Matches == nil {
+			want.Matches = []match{}
+		}
+		if !reflect.DeepEqual(got, want.Matches) {
+			fail(ht, "FindNumbersWithLeniency(%q, %q, %d, %d) finds %v but libphonenumber %v", text, r, leniency, maxTries, got, want.Matches)
+		}
+	})
+}
