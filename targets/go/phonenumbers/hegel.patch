+// Region metadata queries and the plain-string helpers agree with libphonenumber.
+func TestHegelRegionAndTextHelpersAgree(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		hc := hegel.Draw(ht, helperCases)
+		r, cc, typ := hc.region, hc.cc, hc.typ
+		var want regionResult
+		py.call(t, map[string]any{"op": "region", "region": r, "cc": cc, "type": typeNames[typ]}, &want)
+		check := func(what string, got, exp any) {
+			if !reflect.DeepEqual(got, exp) {
+				fail(ht, "%s (region %q, calling code %d, type %s) is %#v but libphonenumber gives %#v", what, r, cc, typeNames[typ], got, exp)
+			}
+		}
+		check("GetCountryCodeForRegion", GetCountryCodeForRegion(r), want.CountryCode)
+		check("GetNddPrefixForRegion(false)", GetNddPrefixForRegion(r, false), want.Ndd)
+		check("GetNddPrefixForRegion(true)", GetNddPrefixForRegion(r, true), want.NddDigits)
+		check("IsNANPACountry", IsNANPACountry(r), want.Nanpa)
+		check("IsMobileNumberPortableRegion", IsMobileNumberPortableRegion(r), want.Portable)
+		check("GetExampleNumber", numOut(GetExampleNumber(r)), want.Example)
+		check("GetExampleNumberForTypeInRegion", numOut(GetExampleNumberForTypeInRegion(r, typ)), want.ExampleForType)
+		check("GetInvalidExampleNumber", numOut(GetInvalidExampleNumber(r)), want.InvalidExample)
+		check("GetSupportedTypesForRegion", typeSet(GetSupportedTypesForRegion(r)), want.Types)
+		check("GetRegionCodeForCountryCode", GetRegionCodeForCountryCode(cc), want.RegionForCC)
+		got := GetRegionCodesForCountryCode(cc)
+		if got == nil {
+			got = []string{}
+		}
+		check("GetRegionCodesForCountryCode", got, want.RegionsForCC)
+		check("GetCountryMobileToken", GetCountryMobileToken(cc), want.MobileToken)
+		check("GetExampleNumberForNonGeoEntity", numOut(GetExampleNumberForNonGeoEntity(cc)), want.ExampleNonGeo)
+		check("GetSupportedTypesForNonGeoEntity", typeSet(GetSupportedTypesForNonGeoEntity(cc)), want.TypesNonGeo)
+
+		// plain strings
+		s, r2, other := hc.text(), hc.cand.region, hc.otherText()
+		var wt textResult
+		py.call(t, map[string]any{"op": "text", "text": s, "region": r2, "other": other}, &wt)
+		check2 := func(what string, got, exp any) {
+			if !reflect.DeepEqual(got, exp) {
+				fail(ht, "%s(%q, region %q, other %q) is %#v but libphonenumber gives %#v", what, s, r2, other, got, exp)
+			}
+		}
+		check2("IsAlphaNumber", IsAlphaNumber(s), wt.Alpha)
+		check2("ConvertAlphaCharactersInNumber", ConvertAlphaCharactersInNumber(s), wt.Converted)
+		check2("NormalizeDigitsOnly", NormalizeDigitsOnly(s), wt.Digits)
+		check2("NormalizeDiallableCharsOnly", NormalizeDiallableCharsOnly(s), wt.Diallable)
+		check2("IsEmergencyNumber", IsEmergencyNumber(s, r2), wt.Emergency)
+		check2("ConnectsToEmergencyNumber", ConnectsToEmergencyNumber(s, r2), wt.ConnectsEmergency)
+		check2("IsPossibleNumberFromRegion", IsPossibleNumberFromRegion(s, r2), wt.PossibleString)
+		check2("IsNumberMatch", matchNames[IsNumberMatch(s, other)], wt.Match)
+	})
+}
