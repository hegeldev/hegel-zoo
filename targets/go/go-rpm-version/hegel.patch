diff --git a/hegel/hegel_zoo_compare_test.go b/hegel/hegel_zoo_compare_test.go
new file mode 100644
index 0000000..238dd8e
--- /dev/null
+++ b/hegel/hegel_zoo_compare_test.go
@@ -0,0 +1,122 @@
+package hegel
+
+// TestHegelCompare: generated version strings parsed by NewVersion (Epoch, Version, Release
+// against the model's parseEVR) and compared pairwise (Compare against the model's rpmverCmp,
+// antisymmetry, Equal/LessThan/GreaterThan consistent with Compare).
+//
+// TestHegelOrder: Compare is transitive over generated triples.
+//
+// TestHegelString: String prints what the model prints, and NewVersion(v.String()) has the
+// fields of v and compares equal to it.
+
+import (
+	"fmt"
+	"testing"
+
+	version "github.com/knqyf263/go-rpm-version"
+	"hegel.dev/go/hegel"
+)
+
+func hzFmtVersion(v version.Version) string {
+	return fmt.Sprintf("{%d %q %q}", v.Epoch(), v.Version(), v.Release())
+}
+
+func hzSign(n int) int {
+	switch {
+	case n < 0:
+		return -1
+	case n > 0:
+		return 1
+	}
+	return 0
+}
+
+func TestHegelCompare(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(tc *hegel.T) {
+		s1 := hzGenVersion(tc)
+		s2 := hzGenNear(tc, s1)
+		v1, v2 := version.NewVersion(s1), version.NewVersion(s2)
+		m1, m2 := hzParse(s1), hzParse(s2)
+		for _, p := range []struct {
+			s string
+			v version.Version
+			m hzEVR
+		}{{s1, v1, m1}, {s2, v2, m2}} {
+			if hzFmtVersion(p.v) != p.m.String() {
+				c.failClass(tc, "parse", "NewVersion(%q) = %s, want %s", p.s, hzFmtVersion(p.v), p.m)
+				return
+			}
+		}
+		got, want := v1.Compare(v2), hzCompare(m1, m2)
+		if got != want {
+			c.failClass(tc, "compare", "Compare(%q, %q) = %d, want %d (%s vs %s)", s1, s2, got, want, m1, m2)
+			return
+		}
+		c.count(fmt.Sprintf("compare %d", got))
+		if back := v2.Compare(v1); back != -got {
+			c.failClass(tc, "antisymmetry", "Compare(%q, %q) = %d but Compare(%q, %q) = %d", s1, s2, got, s2, s1, back)
+			return
+		}
+		if v1.Equal(v2) != (got == 0) || v1.LessThan(v2) != (got < 0) || v1.GreaterThan(v2) != (got > 0) {
+			c.failClass(tc, "predicates", "%q vs %q: Compare %d, Equal %v, LessThan %v, GreaterThan %v", s1, s2, got, v1.Equal(v2), v1.LessThan(v2), v1.GreaterThan(v2))
+			return
+		}
+	})
+}
+
+func TestHegelOrder(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(tc *hegel.T) {
+		s1 := hzGenVersion(tc)
+		s2 := hzGenNear(tc, s1)
+		s3 := hzGenNear(tc, hzPick(tc, []string{s1, s2}))
+		v1, v2, v3 := version.NewVersion(s1), version.NewVersion(s2), version.NewVersion(s3)
+		ab, bc, ac := hzSign(v1.Compare(v2)), hzSign(v2.Compare(v3)), hzSign(v1.Compare(v3))
+		if ab != 0 && ab == bc && ac != ab {
+			c.failClass(tc, "transitivity", "%q %+d %q %+d %q but %q %+d %q", s1, -ab, s2, -bc, s3, s1, -ac, s3)
+			return
+		}
+		if ab == 0 && bc != ac {
+			c.failClass(tc, "equal chain", "%q == %q, %q vs %q = %d, but %q vs %q = %d", s1, s2, s2, s3, bc, s1, s3, ac)
+			return
+		}
+		if bc == 0 && ab != ac {
+			c.failClass(tc, "equal chain", "%q == %q, %q vs %q = %d, but %q vs %q = %d", s2, s3, s1, s2, ab, s1, s3, ac)
+			return
+		}
+		c.count("triple")
+	})
+}
+
+func TestHegelString(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(tc *hegel.T) {
+		s := hzGenVersion(tc)
+		v := version.NewVersion(s)
+		m := hzParse(s)
+		if v.String() != m.hzString() {
+			c.failClass(tc, "string", "NewVersion(%q).String() = %q, want %q", s, v.String(), m.hzString())
+			return
+		}
+		back := version.NewVersion(v.String())
+		want := m.hzReparsed()
+		if hzFmtVersion(back) != want.String() {
+			c.failClass(tc, "roundtrip", "NewVersion(%q).String() = %q parses to %s, want %s", s, v.String(), hzFmtVersion(back), want)
+			return
+		}
+		if want.String() != m.String() {
+			c.count("not reparsable")
+			return
+		}
+		if v.Compare(back) != 0 {
+			c.failClass(tc, "roundtrip compare", "NewVersion(%q) and its String %q compare %d", s, v.String(), v.Compare(back))
+			return
+		}
+		if v.String() == s {
+			c.count("verbatim")
+		} else {
+			c.count("normalised")
+		}
+	})
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..69c96ab
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,57 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the documented behaviour (rpm's own
+// parsing and comparison). They fail while the bug exists and are listed as expected failures
+// in target.toml.
+
+import (
+	"testing"
+
+	version "github.com/knqyf263/go-rpm-version"
+)
+
+// go-rpm-version/1: the release starts at the first "-"; rpm's parseEVR splits at the last.
+func TestHegelPinReleaseAtLastHyphen(t *testing.T) {
+	v := version.NewVersion("1.0-1-2")
+	if v.Version() != "1.0-1" || v.Release() != "2" {
+		t.Errorf("NewVersion(1.0-1-2) = %s, want version 1.0-1, release 2", hzFmtVersion(v))
+	}
+	if c := v.Compare(version.NewVersion("1.0-2")); c <= 0 {
+		t.Errorf("Compare(1.0-1-2, 1.0-2) = %d, want 1 (rpm: version 1.0-1 > 1.0)", c)
+	}
+}
+
+// go-rpm-version/2: anything before the first ":" is taken as the epoch and non-digits read as
+// 0; rpm takes an epoch only when digits precede the ":".
+func TestHegelPinEpochDigitsOnly(t *testing.T) {
+	v := version.NewVersion("abc:1")
+	if v.Version() != "abc:1" {
+		t.Errorf("NewVersion(abc:1) = %s, want epoch 0, version abc:1", hzFmtVersion(v))
+	}
+	if v.Equal(version.NewVersion("1")) {
+		t.Errorf("abc:1 compares equal to 1")
+	}
+	if w := version.NewVersion(" 1:2"); w.Epoch() != 0 || w.Equal(version.NewVersion("1:2")) {
+		t.Errorf("NewVersion(\" 1:2\") = %s, equal to 1:2 = %v; want no epoch", hzFmtVersion(w), w.Equal(version.NewVersion("1:2")))
+	}
+}
+
+// go-rpm-version/3: an epoch beyond int64 reads as 0; rpm compares epochs as digit strings.
+func TestHegelPinEpochOverflow(t *testing.T) {
+	big := version.NewVersion("99999999999999999999:1")
+	if !big.GreaterThan(version.NewVersion("1:1")) {
+		t.Errorf("99999999999999999999:1 is not greater than 1:1 (parsed as %s)", hzFmtVersion(big))
+	}
+}
+
+// go-rpm-version/4: String omits an epoch <= 0, so NewVersion(v.String()) is not v for a
+// negative epoch or a ":" inside the version or release of an epoch-0 version.
+func TestHegelPinStringRoundTrip(t *testing.T) {
+	for _, s := range []string{"-1:2", "0:a:1", ":a:1"} {
+		v := version.NewVersion(s)
+		back := version.NewVersion(v.String())
+		if hzFmtVersion(back) != hzFmtVersion(v) || !back.Equal(v) {
+			t.Errorf("NewVersion(%q) = %s, String %q, parsed back %s", s, hzFmtVersion(v), v.String(), hzFmtVersion(back))
+		}
+	}
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..be74f9c
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,519 @@
+package hegel
+
+// Hegel property tests for knqyf263/go-rpm-version, written for the Hegel zoo. See
+// targets/go/go-rpm-version/README.md. They live in a package of their own (hegel/) and drive
+// the public API: NewVersion on generated version strings, Compare/Equal/LessThan/GreaterThan
+// on pairs and triples, String round trips.
+//
+// Oracle: a model of rpm's own parsing and comparison (rpmio/rpmver.cc parseEVR and rpmverCmp,
+// rpmio/rpmvercmp.cc rpmvercmp), which the package documents as its reference.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. The model reproduces
+// a behaviour while its switch is on; the pins assert the documented behaviour and fail while
+// the bug exists.
+var HZKnown = struct {
+	releaseSplitsAtFirstHyphen bool // the release starts at the first "-" (rpm: the last)
+	epochTextAccepted          bool // anything before the first ":" is the epoch: non-digits read as 0, spaces trimmed, signs accepted (rpm: digits only, else no epoch)
+	epochOverflowIsZero        bool // an epoch beyond int64 reads as 0 (rpm compares the digit strings)
+	stringNotReparsable        bool // String omits an epoch <= 0, so a negative epoch and any ":" in the version or release of an epoch-0 version are misread by NewVersion(v.String())
+}{true, true, true, true}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the model then disagrees with the
+// package on them (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- model
+
+// hzEVR is the model's parsed version: rpm's parseEVR, with the package's recorded deviations
+// behind switches. The epoch is kept as text (rpm compares epochs with rpmvercmp); neg marks
+// an epoch the package read as a negative number.
+type hzEVR struct {
+	epoch   string
+	neg     bool
+	version string
+	release string
+}
+
+func hzIsDigits(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] < '0' || s[i] > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// hzParse is parseEVR: leading digits followed by ":" are the epoch (empty digits are "0", no
+// ":" means no epoch, which compares as "0"); the release starts at the last "-".
+func hzParse(s string) hzEVR {
+	var e hzEVR
+	rest := s
+	if HZKnown.epochTextAccepted {
+		if i := strings.IndexByte(s, ':'); i >= 0 {
+			e.epoch = hzGoEpoch(strings.TrimLeft(s[:i], " \t\n\v\f\r"))
+			if strings.HasPrefix(e.epoch, "-") {
+				e.neg, e.epoch = true, e.epoch[1:]
+			}
+			rest = s[i+1:]
+		} else {
+			e.epoch = "0"
+		}
+	} else {
+		i := 0
+		for i < len(s) && s[i] >= '0' && s[i] <= '9' {
+			i++
+		}
+		if i < len(s) && s[i] == ':' {
+			e.epoch = s[:i]
+			if e.epoch == "" {
+				e.epoch = "0"
+			}
+			rest = s[i+1:]
+		} else {
+			e.epoch = "0"
+		}
+	}
+	e.version = rest
+	if HZKnown.releaseSplitsAtFirstHyphen {
+		if i := strings.IndexByte(rest, '-'); i >= 0 {
+			e.version, e.release = rest[:i], rest[i+1:]
+		}
+	} else if i := strings.LastIndexByte(rest, '-'); i >= 0 {
+		e.version, e.release = rest[:i], rest[i+1:]
+	}
+	return e
+}
+
+// hzGoEpoch is what strconv.Atoi makes of the epoch text: an optional sign and digits within
+// int64, anything else 0.
+func hzGoEpoch(text string) string {
+	digits := text
+	sign := ""
+	if strings.HasPrefix(digits, "+") || strings.HasPrefix(digits, "-") {
+		sign, digits = digits[:1], digits[1:]
+	}
+	if digits == "" || !hzIsDigits(digits) {
+		return "0"
+	}
+	trimmed := strings.TrimLeft(digits, "0")
+	if trimmed == "" {
+		return "0"
+	}
+	if len(trimmed) > 19 || (len(trimmed) == 19 && trimmed > "9223372036854775807") {
+		// Beyond int64 (the negative bound differs by one; the generator does not draw it).
+		if HZKnown.epochOverflowIsZero {
+			return "0"
+		}
+		if sign == "-" {
+			return "-" + trimmed
+		}
+		return trimmed
+	}
+	if sign == "-" {
+		return "-" + trimmed
+	}
+	return trimmed
+}
+
+// hzString is the package's String: the epoch when positive, the version, "-release" when
+// the release is not empty (the model prints the epoch as parsed).
+func (e hzEVR) hzString() string {
+	var b strings.Builder
+	switch {
+	case e.neg:
+		if !HZKnown.stringNotReparsable {
+			b.WriteString("-" + e.epoch + ":")
+		}
+	case strings.TrimLeft(e.epoch, "0") != "":
+		b.WriteString(strings.TrimLeft(e.epoch, "0") + ":")
+	}
+	b.WriteString(e.version)
+	if e.release != "" {
+		b.WriteString("-" + e.release)
+	}
+	return b.String()
+}
+
+// hzReparsed is what NewVersion makes of e.hzString(): e itself, unless the recorded String
+// behaviour loses the epoch or lets a ":" be read as one.
+func (e hzEVR) hzReparsed() hzEVR {
+	if HZKnown.stringNotReparsable && (e.neg || (strings.TrimLeft(e.epoch, "0") == "" && strings.Contains(e.version+e.release, ":"))) {
+		return hzParse(e.hzString())
+	}
+	return e
+}
+
+func (e hzEVR) String() string {
+	ep := e.epoch
+	if e.neg {
+		ep = "-" + ep
+	}
+	return fmt.Sprintf("{%s %q %q}", ep, e.version, e.release)
+}
+
+// hzCompare is rpmverCmp: epochs, then versions, then releases, each with rpmvercmp (the
+// package's signed epochs compared as numbers).
+func hzCompare(a, b hzEVR) int {
+	if a.neg != b.neg {
+		if a.neg {
+			return -1
+		}
+		return 1
+	}
+	rc := hzVercmp(a.epoch, b.epoch)
+	if a.neg {
+		rc = -rc
+	}
+	if rc == 0 {
+		rc = hzVercmp(a.version, b.version)
+	}
+	if rc == 0 {
+		rc = hzVercmp(a.release, b.release)
+	}
+	return rc
+}
+
+func hzIsAlnum(c byte) bool {
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func hzIsDigit(c byte) bool { return c >= '0' && c <= '9' }
+
+func hzIsAlpha(c byte) bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
+
+// hzVercmp is rpmvercmp.cc, byte for byte.
+func hzVercmp(a, b string) int {
+	if a == b {
+		return 0
+	}
+	one, two := 0, 0
+	for one < len(a) || two < len(b) {
+		for one < len(a) && !hzIsAlnum(a[one]) && a[one] != '~' && a[one] != '^' {
+			one++
+		}
+		for two < len(b) && !hzIsAlnum(b[two]) && b[two] != '~' && b[two] != '^' {
+			two++
+		}
+		c1, c2 := byte(0), byte(0)
+		if one < len(a) {
+			c1 = a[one]
+		}
+		if two < len(b) {
+			c2 = b[two]
+		}
+		if c1 == '~' || c2 == '~' {
+			if c1 != '~' {
+				return 1
+			}
+			if c2 != '~' {
+				return -1
+			}
+			one++
+			two++
+			continue
+		}
+		if c1 == '^' || c2 == '^' {
+			if c1 == 0 {
+				return -1
+			}
+			if c2 == 0 {
+				return 1
+			}
+			if c1 != '^' {
+				return 1
+			}
+			if c2 != '^' {
+				return -1
+			}
+			one++
+			two++
+			continue
+		}
+		if c1 == 0 || c2 == 0 {
+			break
+		}
+		s1, s2 := one, two
+		isnum := hzIsDigit(a[s1])
+		if isnum {
+			for s1 < len(a) && hzIsDigit(a[s1]) {
+				s1++
+			}
+			for s2 < len(b) && hzIsDigit(b[s2]) {
+				s2++
+			}
+		} else {
+			for s1 < len(a) && hzIsAlpha(a[s1]) {
+				s1++
+			}
+			for s2 < len(b) && hzIsAlpha(b[s2]) {
+				s2++
+			}
+		}
+		seg1, seg2 := a[one:s1], b[two:s2]
+		if seg1 == "" {
+			return -1 // cannot happen
+		}
+		if seg2 == "" {
+			if isnum {
+				return 1
+			}
+			return -1
+		}
+		if isnum {
+			seg1 = strings.TrimLeft(seg1, "0")
+			seg2 = strings.TrimLeft(seg2, "0")
+			if len(seg1) > len(seg2) {
+				return 1
+			}
+			if len(seg2) > len(seg1) {
+				return -1
+			}
+		}
+		if seg1 < seg2 {
+			return -1
+		}
+		if seg1 > seg2 {
+			return 1
+		}
+		one, two = s1, s2
+	}
+	if one >= len(a) && two >= len(b) {
+		return 0
+	}
+	if one >= len(a) {
+		return -1
+	}
+	return 1
+}
+
+// --------------------------------------------------------------------------- generators
+
+var hzAlphas = []string{"a", "b", "el", "fc", "rc", "git", "beta", "A", "Z", "abc", "aB"}
+
+var hzSeparators = []string{".", ".", ".", "_", "+", "~", "^", "-", " ", ":", "..", "-"}
+
+// hzGenSegment draws one alphanumeric segment: digits (leading zeros, long runs) or letters.
+func hzGenSegment(tc hegel.TestCase) string {
+	switch hzDrawInt(tc, 1, 10) {
+	case 1, 2, 3:
+		return hzPick(tc, hzAlphas)
+	case 4:
+		return strings.Repeat("0", hzDrawInt(tc, 1, 3)) + strconv.Itoa(hzDrawInt(tc, 0, 30))
+	case 5:
+		return strconv.Itoa(hzDrawInt(tc, 0, 9)) + strings.Repeat("9", hzDrawInt(tc, 15, 22))
+	}
+	return strconv.Itoa(hzDrawInt(tc, 0, 12))
+}
+
+// hzGenBody draws a version or release body: segments joined by separators, with optional
+// leading and trailing separators and bare tildes/carets.
+func hzGenBody(tc hegel.TestCase, lo, hi int) string {
+	var b strings.Builder
+	if hzChance(tc, 10) {
+		b.WriteString(hzPick(tc, hzSeparators))
+	}
+	n := hzDrawInt(tc, lo, hi)
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			b.WriteString(hzPick(tc, hzSeparators))
+		}
+		b.WriteString(hzGenSegment(tc))
+	}
+	if hzChance(tc, 10) {
+		b.WriteString(hzPick(tc, hzSeparators))
+	}
+	return b.String()
+}
+
+// hzGenEpoch draws an epoch prefix, mostly well formed.
+func hzGenEpoch(tc hegel.TestCase) string {
+	switch hzDrawInt(tc, 1, 20) {
+	case 1:
+		return strconv.Itoa(hzDrawInt(tc, 0, 3)) + ":"
+	case 2:
+		return "0" + strconv.Itoa(hzDrawInt(tc, 0, 3)) + ":"
+	case 3:
+		return ":"
+	case 4:
+		return hzPick(tc, []string{"a", "1a", "abc", "e1"}) + ":"
+	case 5:
+		return hzPick(tc, []string{" ", "\t", "  "}) + strconv.Itoa(hzDrawInt(tc, 0, 3)) + ":"
+	case 6:
+		return hzPick(tc, []string{"+", "-"}) + strconv.Itoa(hzDrawInt(tc, 0, 3)) + ":"
+	case 7:
+		return hzPick(tc, []string{"9223372036854775808", "99999999999999999999", "9223372036854775807", "-9223372036854775807"}) + ":"
+	case 8:
+		return strconv.Itoa(hzDrawInt(tc, 0, 3)) + " :"
+	}
+	return ""
+}
+
+// hzGenVersion draws a full version string.
+func hzGenVersion(tc hegel.TestCase) string {
+	if hzChance(tc, 3) {
+		return hzPick(tc, []string{"", "-", ":", "~", "^", "0", "1:", "1-", "a-b-c"})
+	}
+	s := hzGenEpoch(tc) + hzGenBody(tc, 1, 4)
+	for k := hzDrawInt(tc, 0, 2); k > 0; k-- {
+		s += "-" + hzGenBody(tc, 0, 2)
+	}
+	return s
+}
+
+// hzGenNear draws a version close to s: the same string, or a small edit of it.
+func hzGenNear(tc hegel.TestCase, s string) string {
+	if hzChance(tc, 40) || s == "" {
+		return hzGenVersion(tc)
+	}
+	switch hzDrawInt(tc, 1, 8) {
+	case 1:
+		return s
+	case 2:
+		return s + hzPick(tc, hzSeparators)
+	case 3:
+		return s + hzPick(tc, hzSeparators) + hzGenSegment(tc)
+	case 4:
+		i := hzDrawInt(tc, 0, len(s)-1)
+		return s[:i] + s[i+1:]
+	case 5:
+		i := hzDrawInt(tc, 0, len(s))
+		return s[:i] + hzPick(tc, hzSeparators) + s[i:]
+	case 6:
+		return strings.ToUpper(s)
+	case 7:
+		return strings.Replace(s, "-", ".", 1)
+	}
+	i := hzDrawInt(tc, 0, len(s))
+	return s[:i] + hzGenSegment(tc) + s[i:]
+}
