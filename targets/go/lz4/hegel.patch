+// --------------------------------------------------------------------------- lz4/10
+
+type concurrentHandlerCase struct {
+	content []byte
+	opts    writerOpts
+}
+
+func (c concurrentHandlerCase) GoString() string {
+	return fmt.Sprintf("%d bytes, %s", len(c.content), c.opts)
+}
+
+// concurrentHandlerCases: non-empty content written by a concurrent Writer.
+var concurrentHandlerCases = hegel.Composite(func(tc hegel.TestCase) concurrentHandlerCase {
+	return concurrentHandlerCase{content: hegel.Draw(tc, atLeast(1, contents(70000))), opts: hegel.Draw(tc, writerOptions(noLegacy, pick(2, 3, 4)))}
+})
+
+// TestHegelHandlerCallsCompleteBeforeClose: when Close returns, the frame is
+// written and every block has been processed, so a caller collecting
+// statistics in OnBlockDone reads them complete; with concurrency the
+// handler runs on the compression goroutines, which Close does not wait for
+// (lz4/10).
+func TestHegelHandlerCallsCompleteBeforeClose(t *testing.T) {
+	shapeOff(t, "lz4/10")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, concurrentHandlerCases)
+		var mu sync.Mutex
+		var calls []int
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		opts := append(c.opts.options(len(c.content)), lz4.OnBlockDoneOption(func(k int) {
+			time.Sleep(10 * time.Millisecond) // a handler that does some work
+			mu.Lock()
+			calls = append(calls, k)
+			mu.Unlock()
+		}))
+		if err := w.Apply(opts...); err != nil {
+			fail(ht, "Apply(%s): %v", c.opts, err)
+		}
+		if _, err := w.Write(c.content); err != nil {
+			fail(ht, "Write: %v", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		mu.Lock()
+		atClose := append([]int{}, calls...)
+		mu.Unlock()
+		sort.Ints(atClose)
+		f := parsedFrame(ht, buf.Bytes())
+		want := sortedSizes(f.blocks, true)
+		if !slices.Equal(atClose, want) {
+			fail(ht, "when Close returned the handler had completed calls %v for blocks of %v bytes (concurrency %d)", atClose, want, c.opts.conc)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/11
+
+// writeToCase: two frames read by WriteTo. Either the second has a larger
+// block size than the first (or is legacy, with 8 MiB blocks) and the Reader
+// runs without concurrency (concurrency 1, or a first frame with dependent
+// blocks, which turns it off); or the Reader is concurrent, the first frame
+// independent and the second dependent (or legacy), which turns concurrency
+// off for it. The second frame holds at least one byte.
+type writeToCase struct {
+	dependent bool
+	first     frameGen
+	second    frameGen
+	conc      int
+}
+
+func (c writeToCase) GoString() string {
+	kind := "a bigger block size"
+	if c.dependent {
+		kind = "dependent blocks under concurrency"
+	}
+	return fmt.Sprintf("%#v then %#v (%s), WriteTo with concurrency %d", c.first, c.second, kind, c.conc)
+}
+
+// framesWithData: frames of one to three blocks of the format that hold data
+// (what lz4/11 turns on is the frame's block size and dependence, not what
+// its blocks hold; a frame of the wide generator is empty a fifth of the time).
+var framesWithData = frameGensWith(exactly(hegel.Integers(1, 3), hegel.Map(blocksWithData, func(b blockSpec) blockGen { return blockGen{spec: b} })))
+
+var writeToCases = hegel.Composite(func(tc hegel.TestCase) writeToCase {
+	c := writeToCase{dependent: hegel.Draw(tc, chance(50))}
+	c.first = hegel.Draw(tc, frameGens)
+	c.first.legacy = false
+	c.second = hegel.Draw(tc, framesWithData)
+	c.second.legacy = hegel.Draw(tc, chance(20))
+	if c.dependent {
+		c.conc = hegel.Draw(tc, pick(2, 4))
+		c.first.indep = true
+		c.second.indep = false
+	} else {
+		c.conc = hegel.Draw(tc, pick(1, 1, 2, 4))
+		c.first.bsIdx = hegel.Draw(tc, hegel.Integers(4, 6))
+		c.second.bsIdx = hegel.Draw(tc, hegel.Integers(c.first.bsIdx+1, 7))
+		if c.conc > 1 {
+			c.first.indep = false
+		}
+	}
+	return c
+})
+
+// TestHegelWriteToReadsEveryFollowingFrame: WriteTo writes the content of
+// every frame of the stream, as Read, io.ReadAll and the reference do; it
+// sizes its buffer by the first frame and silently drops every block of a
+// later frame with a bigger block size, and under concurrency it drops a
+// later frame with dependent blocks, whose buffer it never allocated (lz4/11).
+func TestHegelWriteToReadsEveryFollowingFrame(t *testing.T) {
+	shapeOff(t, "lz4/11")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, writeToCases)
+		first := c.first.render(false, false)
+		second := c.second.render(c.second.legacy, false)
+		data, content := concat(first, second)
+		note(ht, "%s + %s", first.String(), second.String())
+		if _, got, err := parseFrames(data); err != nil || !bytes.Equal(got, content) {
+			fail(ht, "harness: the specification parser fails on the frames: %v", err)
+		}
+		res := readFrames(ht, data, 1, c.conc, []int{1})
+		if res.err != nil || !bytes.Equal(res.out, content) {
+			fail(ht, "WriteTo over %s then %s (concurrency %d) gives %d bytes, %v; want %d", first.String(), second.String(), c.conc, len(res.out), res.err, len(content))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/12
+
+type skippableOnlyCase struct {
+	skips [][]byte
+	conc  int
+}
+
+func (c skippableOnlyCase) GoString() string {
+	sizes := []int{}
+	for _, s := range c.skips {
+		sizes = append(sizes, len(s))
+	}
+	return fmt.Sprintf("%d skippable frames of %v bytes, WriteTo with concurrency %d", len(c.skips), sizes, c.conc)
+}
+
+var skippableOnlyCases = hegel.Composite(func(tc hegel.TestCase) skippableOnlyCase {
+	return skippableOnlyCase{skips: hegel.Draw(tc, many(hegel.Binary(0, 50), 0, 3)), conc: hegel.Draw(tc, pick(1, 1, 2, 4))}
+})
+
+// TestHegelWriteToOnAStreamWithoutFramesIsNotAnError: an empty stream, or one
+// of skippable frames only, has no content, and WriteTo (hence io.Copy)
+// writes nothing and returns nil, as io.ReadAll does; WriteTo returns the
+// io.EOF of its first frame read as the error (lz4/12).
+func TestHegelWriteToOnAStreamWithoutFramesIsNotAnError(t *testing.T) {
+	shapeOff(t, "lz4/12")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, skippableOnlyCases)
+		var data []byte
+		for _, s := range c.skips {
+			f := frameSpec{skippable: true, skip: s}
+			data = append(data, f.build()...)
+		}
+		res := readFrames(ht, data, 1, c.conc, []int{1})
+		if res.err != nil || len(res.out) != 0 {
+			fail(ht, "WriteTo on %d bytes of skippable frames only: %d bytes, %v (io.Copy takes any error as a failure)", len(data), len(res.out), res.err)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/13
+
+// refusedApplyCase: an Apply that is refused, on a Writer after its first
+// Write (any option) or on a fresh Writer (an invalid block size or level),
+// on a Reader after its first Read (ConcurrencyOption) or before it (an
+// option a Reader does not take); the object is then used on.
+type refusedApplyCase struct {
+	content []byte
+	opts    writerOpts
+	variant string
+	pos     int // Writer: where the first Write stops
+	optIdx  int // the option applied late or inapplicable, modulo the options; invalid: even = block size, odd = level
+	oddSize int
+	level   int
+}
+
+func (c refusedApplyCase) GoString() string {
+	return fmt.Sprintf("%d bytes, %s, %s (cut %d, option %d, odd size %d, level %d)", len(c.content), c.opts, c.variant, at(c.pos, len(c.content)+1), c.optIdx, c.oddSize, c.level)
+}
+
+var refusedApplyCases = hegel.Composite(func(tc hegel.TestCase) refusedApplyCase {
+	return refusedApplyCase{
+		content: hegel.Draw(tc, atLeast(2, contents(20000))),
+		opts:    hegel.Draw(tc, writerOptions(noLegacy, concurrencies)),
+		variant: hegel.Draw(tc, pick("Writer: Apply after Write", "Writer: invalid option", "Reader: Apply after Read", "Reader: inapplicable option")),
+		pos:     hegel.Draw(tc, positions),
+		optIdx:  hegel.Draw(tc, positions),
+		oddSize: hegel.Draw(tc, hegel.Map(hegel.Integers(1, 1<<20), func(x int) int { return x | 1 })),
+		level:   hegel.Draw(tc, hegel.Integers(1, 255)),
+	}
+})
+
+// TestHegelRefusedApplyLeavesTheObjectUsable: Apply reports an invalid option
+// with ErrOptionInvalidBlockSize or ErrOptionInvalidCompressionLevel, a late
+// one with ErrOptionClosedOrError and one a Reader does not take with
+// ErrOptionNotApplicable, and the Writer or Reader goes on as before; Apply's
+// deferred state check takes its own error for a failure of the object, which
+// stays in its error state for good (lz4/13).
+func TestHegelRefusedApplyLeavesTheObjectUsable(t *testing.T) {
+	shapeOff(t, "lz4/13")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, refusedApplyCases)
+		content := c.content
+		plain := c.opts.plainOptions(len(content))
+		option := plain[at(c.optIdx, len(plain))]
+		switch c.variant {
+		case "Writer: Apply after Write":
+			var buf bytes.Buffer
+			w := lz4.NewWriter(&buf)
+			if err := w.Apply(c.opts.options(len(content))...); err != nil {
+				fail(ht, "Apply(%s): %v", c.opts, err)
+			}
+			cut := at(c.pos, len(content)+1)
+			if _, err := w.Write(content[:cut]); err != nil {
+				fail(ht, "Write: %v", err)
+			}
+			if err := w.Apply(option); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+				fail(ht, "Apply(%s) after Write = %v, want ErrOptionClosedOrError", option, err)
+			}
+			if _, err := w.Write(content[cut:]); err != nil {
+				fail(ht, "Write after a refused Apply: %v", err)
+			}
+			if err := w.Close(); err != nil {
+				fail(ht, "Close after a refused Apply: %v", err)
+			}
+			if _, got, err := parseFrames(buf.Bytes()); err != nil || !bytes.Equal(got, content) {
+				fail(ht, "the frame holds %d bytes (%v), want %d", len(got), err, len(content))
+			}
+		case "Writer: invalid option":
+			var buf bytes.Buffer
+			w := lz4.NewWriter(&buf)
+			bad, want := lz4.Option(lz4.BlockSizeOption(lz4.BlockSize(c.oddSize))), lz4.ErrOptionInvalidBlockSize
+			if c.optIdx%2 == 1 {
+				bad, want = lz4.CompressionLevelOption(lz4.CompressionLevel(c.level)), lz4.ErrOptionInvalidCompressionLevel
+			}
+			if err := w.Apply(bad); !errors.Is(err, want) {
+				fail(ht, "Apply(%s) = %v, want %v", bad, err, want)
+			}
+			if _, err := w.Write(content); err != nil {
+				fail(ht, "Write after a refused Apply(%s): %v", bad, err)
+			}
+			if err := w.Close(); err != nil {
+				fail(ht, "Close after a refused Apply(%s): %v", bad, err)
+			}
+			if _, got, err := parseFrames(buf.Bytes()); err != nil || !bytes.Equal(got, content) {
+				fail(ht, "the frame holds %d bytes (%v), want %d", len(got), err, len(content))
+			}
+		case "Reader: Apply after Read":
+			r := lz4.NewReader(bytes.NewReader(writerFrame(ht, c.opts, content)))
+			one := make([]byte, 1)
+			if k, err := r.Read(one); err != nil || k != 1 {
+				fail(ht, "Read of one byte: %d, %v", k, err)
+			}
+			if err := r.Apply(lz4.ConcurrencyOption(2)); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+				fail(ht, "Reader.Apply after Read = %v, want ErrOptionClosedOrError", err)
+			}
+			rest, err := io.ReadAll(r)
+			if err != nil || !bytes.Equal(append(one, rest...), content) {
+				fail(ht, "reading on after a refused Apply: %d bytes, %v; want %d more", len(rest), err, len(content)-1)
+			}
+		default: // "Reader: inapplicable option"
+			r := lz4.NewReader(bytes.NewReader(writerFrame(ht, c.opts, content)))
+			if err := r.Apply(option); !errors.Is(err, lz4.ErrOptionNotApplicable) {
+				fail(ht, "Reader.Apply(%s) = %v, want ErrOptionNotApplicable", option, err)
+			}
+			got, err := io.ReadAll(r)
+			if err != nil || !bytes.Equal(got, content) {
+				fail(ht, "reading after a refused Apply(%s): %d bytes, %v; want %d", option, len(got), err, len(content))
+			}
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/14
+
+// sizeAfterEndCase: a frame with a content size, read to its end in one go
+// (a Read loop with a buffer at least as large as the content, WriteTo, or
+// io.ReadAll), then Size.
+type sizeAfterEndCase struct {
+	content []byte
+	opts    writerOpts
+	how     string
+	extra   int
+}
+
+func (c sizeAfterEndCase) GoString() string {
+	return fmt.Sprintf("%d bytes, %s, read by %s (buffer %d bytes larger)", len(c.content), c.opts, c.how, c.extra)
+}
+
+var sizeAfterEndCases = hegel.Composite(func(tc hegel.TestCase) sizeAfterEndCase {
+	o := hegel.Draw(tc, writerOptions(noLegacy, concurrencies))
+	o.csize = true
+	return sizeAfterEndCase{
+		content: hegel.Draw(tc, atLeast(1, contents(70000))),
+		opts:    o,
+		how:     hegel.Draw(tc, pick("Read", "WriteTo", "io.ReadAll")),
+		extra:   hegel.Draw(tc, hegel.Integers(0, 100)),
+	}
+})
+
+// TestHegelSizeSurvivesTheEndOfTheFrame: Size is "the size of the current
+// frame's uncompressed data, if set in the stream", so after the frame has
+// been read (`data, _ := io.ReadAll(r); size := r.Size()`) it is the header's
+// size; Read and WriteTo reset the frame at the end of the stream and Size is
+// 0 (lz4/14).
+func TestHegelSizeSurvivesTheEndOfTheFrame(t *testing.T) {
+	shapeOff(t, "lz4/14")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, sizeAfterEndCases)
+		n := len(c.content)
+		r := lz4.NewReader(bytes.NewReader(writerFrame(ht, c.opts, c.content)))
+		var got []byte
+		var err error
+		switch c.how {
+		case "Read":
+			buf := make([]byte, n+c.extra)
+			for err == nil {
+				var k int
+				k, err = r.Read(buf)
+				got = append(got, buf[:k]...)
+			}
+			if err == io.EOF {
+				err = nil
+			}
+		case "WriteTo":
+			var b bytes.Buffer
+			_, err = r.WriteTo(&b)
+			got = b.Bytes()
+		default:
+			got, err = io.ReadAll(r)
+		}
+		if err != nil || !bytes.Equal(got, c.content) {
+			fail(ht, "%s: %d bytes, %v; want %d", c.how, len(got), err, n)
+		}
+		if s := r.Size(); s != n {
+			fail(ht, "Size after reading the frame by %s = %d, the header says %d", c.how, s, n)
+		}
+	})
+}
