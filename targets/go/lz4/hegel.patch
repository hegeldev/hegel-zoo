diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..40e42d0
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,320 @@
+package lz4_test
+
+// Pins for the bugs in bugs.toml. Each asserts the correct behaviour and is listed as an
+// expected failure in target.toml: it fails while the bug exists and passes, unexpectedly,
+// once the bug is fixed (which is the signal to drop the Known switch and the entry).
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/pierrec/lz4/v4"
+)
+
+var pinData = bytes.Repeat([]byte("hello world, "), 20) // 260 bytes
+
+// pinBlock decodes to "abcdefghabcdefghijklm" (21 bytes).
+var (
+	pinBlock    = []byte{0x84, 'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 0x08, 0x00, 0x50, 'i', 'j', 'k', 'l', 'm'}
+	pinBlockOut = []byte("abcdefghabcdefghijklm")
+)
+
+func pinWrite(t *testing.T, content []byte, opts ...lz4.Option) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	if err := w.Apply(opts...); err != nil {
+		t.Fatalf("Apply: %v", err)
+	}
+	if _, err := w.Write(content); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func pinReadAll(data []byte, opts ...lz4.Option) ([]byte, error) {
+	r := lz4.NewReader(bytes.NewReader(data))
+	if err := r.Apply(opts...); err != nil {
+		return nil, err
+	}
+	return io.ReadAll(r)
+}
+
+// lz4/1
+func TestHegelPinSizeOptionSurvivesApplyAndReset(t *testing.T) {
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	if err := w.Apply(lz4.SizeOption(uint64(len(pinData)))); err != nil {
+		t.Fatal(err)
+	}
+	if err := w.Apply(lz4.BlockSizeOption(lz4.Block64Kb)); err != nil {
+		t.Fatal(err)
+	}
+	w.Write(pinData)
+	w.Close()
+	frames, _, err := parseFrames(buf.Bytes())
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if f := frames[0]; !f.csize || f.contentSize != uint64(len(pinData)) {
+		t.Errorf("after two Applys the header has size flag %v and content size %d, want %d", f.csize, f.contentSize, len(pinData))
+	}
+	// Reset keeps the previous options.
+	var buf2 bytes.Buffer
+	w.Reset(&buf2)
+	w.Write(pinData)
+	w.Close()
+	frames, _, err = parseFrames(buf2.Bytes())
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if f := frames[0]; !f.csize || f.contentSize != uint64(len(pinData)) {
+		t.Errorf("after Reset the header has size flag %v and content size %d, want %d", f.csize, f.contentSize, len(pinData))
+	}
+}
+
+// lz4/2
+func TestHegelPinReadFromCallsTheHandlerOncePerBlock(t *testing.T) {
+	var calls []int
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	w.Apply(lz4.BlockSizeOption(lz4.Block64Kb), lz4.OnBlockDoneOption(func(n int) { calls = append(calls, n) }))
+	if _, err := w.ReadFrom(bytes.NewReader(pinData)); err != nil {
+		t.Fatal(err)
+	}
+	w.Close()
+	if len(calls) != 1 {
+		t.Errorf("ReadFrom of one block called the handler %d times: %v", len(calls), calls)
+	}
+}
+
+// lz4/3
+func TestHegelPinReadCallsTheHandlerPerBlock(t *testing.T) {
+	data := pinWrite(t, pinData, lz4.BlockSizeOption(lz4.Block64Kb))
+	var calls []int
+	r := lz4.NewReader(bytes.NewReader(data))
+	r.Apply(lz4.OnBlockDoneOption(func(n int) { calls = append(calls, n) }))
+	p := make([]byte, 100)
+	for {
+		if _, err := r.Read(p); err != nil {
+			break
+		}
+	}
+	if len(calls) != 1 {
+		t.Errorf("reading one block with a 100-byte buffer called the handler %d times: %v (want once, with %d)", len(calls), calls, len(pinData))
+	}
+}
+
+// lz4/4
+func TestHegelPinReaderRejectsUnknownVersions(t *testing.T) {
+	f := frameSpec{bsIdx: 4, indep: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}}, content: pinBlockOut}
+	for _, c := range []struct {
+		name string
+		mod  func(b []byte)
+	}{
+		{"version 0", func(b []byte) { b[4] &^= 0xC0 }},
+		{"version 2", func(b []byte) { b[4] = b[4]&^0xC0 | 0x80 }},
+		{"reserved flag bit", func(b []byte) { b[4] |= 0x02 }},
+		{"reserved BD bit", func(b []byte) { b[5] |= 0x80 }},
+	} {
+		b := f.build()
+		c.mod(b)
+		b[6] = byte(xxh32(b[4:6]) >> 8) // a matching header checksum
+		if out, err := pinReadAll(b); err == nil {
+			t.Errorf("a frame with %s is accepted (%d bytes); the format says it cannot be decoded", c.name, len(out))
+		}
+	}
+}
+
+// lz4/5
+func TestHegelPinReaderChecksTheContentSize(t *testing.T) {
+	f := frameSpec{bsIdx: 4, indep: true, csize: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}}, content: pinBlockOut}
+	b := f.build()
+	b[6] = 5 // content size 5 instead of 21
+	for i := 7; i < 14; i++ {
+		b[i] = 0
+	}
+	b[14] = byte(xxh32(b[4:14]) >> 8)
+	if out, err := pinReadAll(b); err == nil {
+		t.Errorf("a frame declaring 5 bytes of content but holding %d is accepted", len(out))
+	}
+}
+
+// lz4/6
+func TestHegelPinTruncatedFrameIsAnError(t *testing.T) {
+	f := frameSpec{bsIdx: 4, indep: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}, {payload: pinBlock, out: pinBlockOut}}}
+	f.content = append(append([]byte{}, pinBlockOut...), pinBlockOut...)
+	data := f.build()
+	cut := data[:7+4+len(pinBlock)] // after the first block: no end mark, no second block
+	if out, err := pinReadAll(cut); err == nil {
+		t.Errorf("io.ReadAll on a frame cut after its first block: %d bytes, no error", len(out))
+	}
+	var buf bytes.Buffer
+	if _, err := lz4.NewReader(bytes.NewReader(cut)).WriteTo(&buf); err == nil {
+		t.Errorf("WriteTo on a frame cut after its first block: %d bytes, no error", buf.Len())
+	}
+	if out, err := pinReadAll(data[:4]); err == nil {
+		t.Errorf("io.ReadAll on the magic number alone: %d bytes, no error", len(out))
+	}
+}
+
+// lz4/7
+func TestHegelPinLegacyBlocksAreNotMistakenForTheSizeTrailer(t *testing.T) {
+	// Block A decodes to 21 bytes; block B's compressed size is 21 bytes (19 literals).
+	lit := bytes.Repeat([]byte{'z'}, 19)
+	blockB := append([]byte{0xF0, 0x04}, lit...)
+	f := frameSpec{legacy: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}, {payload: blockB, out: lit}}}
+	f.content = append(append([]byte{}, pinBlockOut...), lit...)
+	data := f.build()
+	if ref, err := cliDecode(data); err != nil || !bytes.Equal(ref, f.content) {
+		t.Fatalf("the reference does not decode the legacy frame: %v", err)
+	}
+	out, err := pinReadAll(data)
+	if err != nil || !bytes.Equal(out, f.content) {
+		t.Errorf("legacy frame with a 21-byte block after 21 bytes of content: %d bytes, %v; want %d bytes", len(out), err, len(f.content))
+	}
+}
+
+// lz4/8
+func TestHegelPinReadFromWorksAfterWrite(t *testing.T) {
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	if _, err := w.Write(pinData[:10]); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := w.ReadFrom(bytes.NewReader(pinData[10:])); err != nil || n != int64(len(pinData)-10) {
+		t.Errorf("ReadFrom after Write: %d, %v", n, err)
+	}
+	if err := w.Close(); err != nil {
+		t.Errorf("Close: %v", err)
+	}
+	if _, out, err := parseFrames(buf.Bytes()); err != nil || !bytes.Equal(out, pinData) {
+		t.Errorf("the frame holds %d bytes (%v), want %d", len(out), err, len(pinData))
+	}
+}
+
+// lz4/9
+func TestHegelPinLegacyFrameMayBeFollowedByAStandardFrame(t *testing.T) {
+	leg := frameSpec{legacy: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}}, content: pinBlockOut}
+	std := frameSpec{bsIdx: 4, indep: true, csum: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}}, content: pinBlockOut}
+	data := append(leg.build(), std.build()...)
+	want := append(append([]byte{}, pinBlockOut...), pinBlockOut...)
+	if ref, err := cliDecode(data); err != nil || !bytes.Equal(ref, want) {
+		t.Fatalf("the reference does not decode legacy + standard: %v", err)
+	}
+	if out, err := pinReadAll(data); err != nil || !bytes.Equal(out, want) {
+		t.Errorf("legacy frame followed by a standard frame: %d bytes, %v; want %d", len(out), err, len(want))
+	}
+}
+
+// lz4/10
+func TestHegelPinHandlerCallsFinishBeforeClose(t *testing.T) {
+	var mu sync.Mutex
+	var calls []int
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	w.Apply(lz4.ConcurrencyOption(2), lz4.BlockSizeOption(lz4.Block64Kb), lz4.OnBlockDoneOption(func(n int) {
+		time.Sleep(20 * time.Millisecond) // a handler that does some work
+		mu.Lock()
+		calls = append(calls, n)
+		mu.Unlock()
+	}))
+	w.Write(bytes.Repeat(pinData, 300)) // two blocks
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	got := len(calls)
+	mu.Unlock()
+	if got != 2 {
+		t.Errorf("when Close returned, the handler had completed %d calls for 2 blocks", got)
+	}
+	time.Sleep(100 * time.Millisecond) // let the late calls finish before the test ends
+}
+
+// lz4/11
+func TestHegelPinWriteToReadsFramesOfGrowingBlockSize(t *testing.T) {
+	small := bytes.Repeat([]byte("abc"), 100)
+	big := bytes.Repeat([]byte("0123456789abcdef-"), 6000)
+	data := append(pinWrite(t, small, lz4.BlockSizeOption(lz4.Block64Kb)), pinWrite(t, big, lz4.BlockSizeOption(lz4.Block4Mb))...)
+	var buf bytes.Buffer
+	n, err := lz4.NewReader(bytes.NewReader(data)).WriteTo(&buf)
+	if err != nil || n != int64(len(small)+len(big)) {
+		t.Errorf("WriteTo over a 64 KiB-block frame then a 4 MiB-block frame: %d bytes, %v; want %d", n, err, len(small)+len(big))
+	}
+	// With concurrency, a later frame with dependent blocks.
+	dep := []byte{0x0c, 0x15, 0x00, 0x50, 'v', 'w', 'x', 'y', 'z'} // a match of 16 bytes at offset 21 into the previous block, then 5 literals
+	depOut := append(append([]byte{}, pinBlockOut[:16]...), "vwxyz"...)
+	f := frameSpec{bsIdx: 4, indep: false, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}, {payload: dep, out: depOut}}}
+	f.content = append(append([]byte{}, pinBlockOut...), depOut...)
+	data2 := append(pinWrite(t, small, lz4.BlockSizeOption(lz4.Block64Kb)), f.build()...)
+	r := lz4.NewReader(bytes.NewReader(data2))
+	r.Apply(lz4.ConcurrencyOption(4))
+	buf.Reset()
+	n, err = r.WriteTo(&buf)
+	if err != nil || n != int64(len(small)+len(f.content)) {
+		t.Errorf("WriteTo with concurrency over a frame then a dependent-blocks frame: %d bytes, %v; want %d", n, err, len(small)+len(f.content))
+	}
+}
+
+// lz4/12
+func TestHegelPinWriteToOnAnEmptyStreamIsNotAnError(t *testing.T) {
+	if n, err := io.Copy(io.Discard, lz4.NewReader(bytes.NewReader(nil))); err != nil || n != 0 {
+		t.Errorf("io.Copy from an empty stream: %d, %v", n, err)
+	}
+	skip := frameSpec{skippable: true, skip: []byte{1, 2, 3}}
+	if n, err := io.Copy(io.Discard, lz4.NewReader(bytes.NewReader(skip.build()))); err != nil || n != 0 {
+		t.Errorf("io.Copy from a skippable-only stream: %d, %v", n, err)
+	}
+}
+
+// lz4/13
+func TestHegelPinFailedApplyDoesNotPoisonTheWriter(t *testing.T) {
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	w.Write(pinData[:100])
+	if err := w.Apply(lz4.ChecksumOption(false)); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+		t.Fatalf("Apply after Write: %v", err)
+	}
+	if _, err := w.Write(pinData[100:]); err != nil {
+		t.Errorf("Write after a refused Apply: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		t.Errorf("Close after a refused Apply: %v", err)
+	}
+	if _, out, err := parseFrames(buf.Bytes()); err != nil || !bytes.Equal(out, pinData) {
+		t.Errorf("the frame holds %d bytes (%v), want %d", len(out), err, len(pinData))
+	}
+	data := pinWrite(t, pinData)
+	r := lz4.NewReader(bytes.NewReader(data))
+	one := make([]byte, 1)
+	if _, err := r.Read(one); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Apply(lz4.ConcurrencyOption(2)); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+		t.Fatalf("Reader.Apply after Read: %v", err)
+	}
+	rest, err := io.ReadAll(r)
+	if err != nil || len(rest) != len(pinData)-1 {
+		t.Errorf("reading on after a refused Apply: %d bytes, %v; want %d", len(rest), err, len(pinData)-1)
+	}
+}
+
+// lz4/14
+func TestHegelPinSizeSurvivesTheEndOfTheFrame(t *testing.T) {
+	data := pinWrite(t, pinData, lz4.SizeOption(uint64(len(pinData))))
+	r := lz4.NewReader(bytes.NewReader(data))
+	if _, err := io.ReadAll(r); err != nil {
+		t.Fatal(err)
+	}
+	if got := r.Size(); got != len(pinData) {
+		t.Errorf("Size after reading the frame = %d, want %d", got, len(pinData))
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..a69a6a4
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1784 @@
+package lz4_test
+
+// Hegel property tests for github.com/pierrec/lz4/v4.
+//
+// Oracles: the LZ4 block format and the LZ4 frame format (lz4_Block_format.md,
+// lz4_Frame_format.md), written here as an independent decoder, encoder,
+// frame parser and frame builder, including an xxHash32 of their own; the
+// reference implementation's command-line tool, lz4 (1.9.4), which must
+// decode every frame the library writes and whose frames the library must
+// read; and the package's documented contracts (options, states, callbacks,
+// buffer-size rules, the errors named in the API).
+//
+// Set LZ4_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"math/bits"
+	"math/rand"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/pierrec/lz4/v4"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	// Cases that shell out to the lz4 tool a few times take tens of
+	// milliseconds; on a loaded machine that trips Hegel's too-slow check.
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("LZ4_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...)+"\n  case: "+lastNote)
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+var lastNote string // the notes of the running case, for collect mode
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if lz4Path == "" {
+		t.Fatalf("the lz4 command-line tool (the reference implementation) is not installed")
+	}
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		lastNote = ""
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) {
+	m := fmt.Sprintf(format, args...)
+	lastNote += "\n  " + m
+	ht.Note(m)
+}
+
+// prng returns a seeded random source: bulk bytes come from it so that Hegel
+// only has to draw (and shrink) the structure of a case.
+func prng(ht *hegel.T) *rand.Rand { return rand.New(rand.NewSource(int64(n(ht, 0, 1<<30)))) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	sizeLostOnApply       bool // lz4/1: Writer.Apply and Writer.Reset zero the content size but keep the size flag
+	readFromHandlerTwice  bool // lz4/2: Writer.ReadFrom calls the OnBlockDone handler twice per block
+	readHandlerPerCall    bool // lz4/3: Reader.Read calls the OnBlockDone handler once per Read call, not per block
+	acceptsBadVersion     bool // lz4/4: the Reader accepts frames with a version other than 1 or reserved bits set
+	ignoresContentSize    bool // lz4/5: the Reader does not check the frame's content size against the content
+	acceptsMissingEndMark bool // lz4/6: a frame cut at a block boundary, without its end mark, is accepted when it has no content checksum
+	legacyCumulativeStop  bool // lz4/7: a legacy block whose compressed size equals the content read so far ends the frame
+	readFromNotFirst      bool // lz4/8: Writer.ReadFrom fails with ErrInternalUnhandledState unless it is the first operation
+	legacyThenOther       bool // lz4/9: a legacy frame followed by a standard or skippable frame fails with ErrOptionInvalidBlockSize
+	handlerAfterClose     bool // lz4/10: with concurrency, the OnBlockDone handler is called from other goroutines, possibly after Close returned
+	writeToDropsFrames    bool // lz4/11: Reader.WriteTo silently drops a following frame whose block size is larger than the first frame's
+	writeToEOFOnEmpty     bool // lz4/12: Reader.WriteTo returns io.EOF as an error on an empty or skippable-only stream
+	failedApplyPoisons    bool // lz4/13: a failed Apply (invalid option, or after the first Write/Read) leaves the Writer or Reader in its error state for good
+	sizeLostAtEnd         bool // lz4/14: Reader.Size is 0 once a Read has reached the end of the frame
+}{sizeLostOnApply: true, readFromHandlerTwice: true, readHandlerPerCall: true, acceptsBadVersion: true, ignoresContentSize: true, acceptsMissingEndMark: true, legacyCumulativeStop: true, readFromNotFirst: true, legacyThenOther: true, handlerAfterClose: true, writeToDropsFrames: true, writeToEOFOnEmpty: true, failedApplyPoisons: true, sizeLostAtEnd: true}
+
+// ---------------------------------------------------------------------------
+// xxHash32 (seed 0), written from the algorithm description.
+
+const (
+	xxp1 uint32 = 2654435761
+	xxp2 uint32 = 2246822519
+	xxp3 uint32 = 3266489917
+	xxp4 uint32 = 668265263
+	xxp5 uint32 = 374761393
+)
+
+func xxh32(b []byte) uint32 {
+	total := uint32(len(b))
+	var h uint32
+	if len(b) >= 16 {
+		var seed uint32
+		v1 := seed + xxp1 + xxp2
+		v2 := seed + xxp2
+		v3 := seed
+		v4 := seed - xxp1
+		for len(b) >= 16 {
+			v1 = bits.RotateLeft32(v1+binary.LittleEndian.Uint32(b)*xxp2, 13) * xxp1
+			v2 = bits.RotateLeft32(v2+binary.LittleEndian.Uint32(b[4:])*xxp2, 13) * xxp1
+			v3 = bits.RotateLeft32(v3+binary.LittleEndian.Uint32(b[8:])*xxp2, 13) * xxp1
+			v4 = bits.RotateLeft32(v4+binary.LittleEndian.Uint32(b[12:])*xxp2, 13) * xxp1
+			b = b[16:]
+		}
+		h = bits.RotateLeft32(v1, 1) + bits.RotateLeft32(v2, 7) + bits.RotateLeft32(v3, 12) + bits.RotateLeft32(v4, 18)
+	} else {
+		h = xxp5
+	}
+	h += total
+	for len(b) >= 4 {
+		h += binary.LittleEndian.Uint32(b) * xxp3
+		h = bits.RotateLeft32(h, 17) * xxp4
+		b = b[4:]
+	}
+	for _, c := range b {
+		h += uint32(c) * xxp5
+		h = bits.RotateLeft32(h, 11) * xxp1
+	}
+	h ^= h >> 15
+	h *= xxp2
+	h ^= h >> 13
+	h *= xxp3
+	h ^= h >> 16
+	return h
+}
+
+func init() {
+	// Test vectors of the xxHash specification.
+	if xxh32(nil) != 0x02CC5D05 {
+		panic(fmt.Sprintf("xxh32(empty) = %08x", xxh32(nil)))
+	}
+	if xxh32([]byte("Nobody inspects the spammish repetition")) != 0xE2293B2F {
+		panic(fmt.Sprintf("xxh32(spammish) = %08x", xxh32([]byte("Nobody inspects the spammish repetition"))))
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The block format.
+
+// decodeBlock decodes an LZ4 block as the format defines it, with limit as the
+// size of the destination. compliant reports whether the block also follows
+// the encoder-side restrictions (the last five bytes are literals and the last
+// match starts at least twelve bytes before the end; blocks under thirteen
+// bytes are all literals), which a decoder may insist on.
+func decodeBlock(src, dict []byte, limit int) (out []byte, compliant bool, err error) {
+	out = make([]byte, 0, min(limit, 1<<20))
+	si := 0
+	lastMatchStart := -1
+	finalLit := 0
+	readLen := func(base int) (int, error) {
+		l := base
+		for {
+			if si >= len(src) {
+				return 0, errors.New("block: truncated length")
+			}
+			x := int(src[si])
+			si++
+			l += x
+			if l > 1<<30 {
+				return 0, errors.New("block: length overflow")
+			}
+			if x != 0xFF {
+				return l, nil
+			}
+		}
+	}
+	if len(src) == 0 {
+		return nil, false, errors.New("block: empty")
+	}
+	for {
+		if si >= len(src) {
+			// The block ends right after a match: the format wants a final
+			// literal sequence, but decoders may accept it.
+			return out, false, nil
+		}
+		token := src[si]
+		si++
+		lLen := int(token >> 4)
+		if lLen == 15 {
+			if lLen, err = readLen(15); err != nil {
+				return nil, false, err
+			}
+		}
+		if si+lLen > len(src) {
+			return nil, false, errors.New("block: truncated literals")
+		}
+		if len(out)+lLen > limit {
+			return nil, false, errors.New("block: output too large")
+		}
+		out = append(out, src[si:si+lLen]...)
+		si += lLen
+		if si == len(src) {
+			// The last sequence: literals only (a match nibble here is not compliant).
+			finalLit = lLen
+			if token&0xF != 0 {
+				lastMatchStart = len(out) // forces compliant = false below
+				finalLit = 0
+			}
+			break
+		}
+		if si+2 > len(src) {
+			return nil, false, errors.New("block: truncated offset")
+		}
+		off := int(binary.LittleEndian.Uint16(src[si:]))
+		si += 2
+		if off == 0 {
+			return nil, false, errors.New("block: zero offset")
+		}
+		if off > len(out)+len(dict) {
+			return nil, false, errors.New("block: offset before the start")
+		}
+		mLen := int(token&0xF) + 4
+		if token&0xF == 15 {
+			if mLen, err = readLen(19); err != nil {
+				return nil, false, err
+			}
+		}
+		if len(out)+mLen > limit {
+			return nil, false, errors.New("block: output too large")
+		}
+		lastMatchStart = len(out)
+		for k := 0; k < mLen; k++ {
+			p := len(out) - off
+			if p < 0 {
+				out = append(out, dict[len(dict)+p])
+			} else {
+				out = append(out, out[p])
+			}
+		}
+	}
+	if lastMatchStart < 0 {
+		compliant = true
+	} else {
+		compliant = finalLit >= 5 && lastMatchStart <= len(out)-12
+	}
+	return out, compliant, nil
+}
+
+// A sequence of the block format: literals then a match (off = 0: no match,
+// only the final literals).
+type seq struct {
+	lit  []byte
+	off  int
+	mLen int
+}
+
+func encodeSeqs(seqs []seq) []byte {
+	var b []byte
+	putLen := func(l int) {
+		for l >= 255 {
+			b = append(b, 255)
+			l -= 255
+		}
+		b = append(b, byte(l))
+	}
+	for _, s := range seqs {
+		lLen := len(s.lit)
+		token := byte(min(lLen, 15) << 4)
+		if s.off > 0 {
+			token |= byte(min(s.mLen-4, 15))
+		}
+		b = append(b, token)
+		if lLen >= 15 {
+			putLen(lLen - 15)
+		}
+		b = append(b, s.lit...)
+		if s.off > 0 {
+			b = binary.LittleEndian.AppendUint16(b, uint16(s.off))
+			if s.mLen-4 >= 15 {
+				putLen(s.mLen - 19)
+			}
+		}
+	}
+	return b
+}
+
+func expandSeqs(seqs []seq, dict []byte) []byte {
+	var out []byte
+	for _, s := range seqs {
+		out = append(out, s.lit...)
+		for k := 0; k < s.mLen && s.off > 0; k++ {
+			p := len(out) - s.off
+			if p < 0 {
+				out = append(out, dict[len(dict)+p])
+			} else {
+				out = append(out, out[p])
+			}
+		}
+	}
+	return out
+}
+
+func randBytes(r *rand.Rand, k int, alphabet int) []byte {
+	b := make([]byte, k)
+	for i := range b {
+		if alphabet > 0 {
+			b[i] = byte('a' + r.Intn(alphabet))
+		} else {
+			b[i] = byte(r.Intn(256))
+		}
+	}
+	return b
+}
+
+// genBlock builds a compliant block of the format (with matches into dict,
+// when given) and returns its bytes and the data it encodes.
+func genBlock(ht *hegel.T, r *rand.Rand, dict []byte, maxOut int) (blk, out []byte) {
+	var seqs []seq
+	outLen := 0
+	count := pick(ht, 0, 1, 1, 2, 3, n(ht, 4, 12), n(ht, 10, 60))
+	alphabet := pick(ht, 0, 0, 2, 4, 26)
+	for i := 0; i < count; i++ {
+		lLen := pick(ht, 0, 1, n(ht, 1, 14), 15, n(ht, 16, 40), 269, 270, 271, n(ht, 272, 700))
+		if outLen+lLen+4 > maxOut {
+			break
+		}
+		lit := randBytes(r, lLen, alphabet)
+		outLen += lLen
+		avail := outLen + len(dict)
+		if avail == 0 {
+			// Nothing to match yet (and a literal-only sequence may only be the last one).
+			outLen -= lLen
+			continue
+		}
+		var off int
+		switch n(ht, 0, 4) {
+		case 0:
+			off = 1
+		case 1:
+			off = min(avail, n(ht, 1, 8))
+		case 2:
+			off = min(avail, 65535) // the very start (of the dictionary when there is one)
+		default:
+			off = n(ht, 1, min(avail, 65535))
+		}
+		mLen := pick(ht, 4, 5, n(ht, 4, 18), 19, 20, n(ht, 21, 300), 274, 275, n(ht, 300, 3000))
+		if outLen+mLen > maxOut-12 {
+			mLen = min(mLen, maxOut-12-outLen)
+		}
+		if mLen < 4 {
+			seqs = append(seqs, seq{lit: lit})
+			break
+		}
+		seqs = append(seqs, seq{lit: lit, off: off, mLen: mLen})
+		outLen += mLen
+	}
+	// The final literals: enough for the encoder restrictions.
+	var final int
+	if len(seqs) > 0 && seqs[len(seqs)-1].off > 0 {
+		last := seqs[len(seqs)-1]
+		final = max(5, 12-last.mLen)
+		final += pick(ht, 0, 0, 1, n(ht, 0, 20), n(ht, 0, 300))
+	} else {
+		final = pick(ht, 0, 1, n(ht, 0, 12), n(ht, 13, 100), n(ht, 15, 600))
+	}
+	final = min(final, maxOut-outLen)
+	if final < 0 {
+		final = 0
+	}
+	if len(seqs) > 0 && seqs[len(seqs)-1].off > 0 && final < 5 {
+		// Not enough room for a compliant tail: drop the last match.
+		seqs = seqs[:len(seqs)-1]
+		final = 5
+	}
+	if len(seqs) == 0 || seqs[len(seqs)-1].off > 0 {
+		seqs = append(seqs, seq{lit: randBytes(r, final, alphabet)})
+	} else {
+		seqs[len(seqs)-1].lit = append(seqs[len(seqs)-1].lit, randBytes(r, final, alphabet)...)
+	}
+	out = expandSeqs(seqs, dict)
+	blk = encodeSeqs(seqs)
+	if got, comp, err := decodeBlock(blk, dict, len(out)); err != nil || !bytes.Equal(got, out) || !comp {
+		panic(fmt.Sprintf("harness: generated block does not decode: %v compliant=%v", err, comp))
+	}
+	return blk, out
+}
+
+// genContent builds compressible data: random bytes, runs, small alphabets,
+// repeats of earlier data at offsets up to and beyond the 64 KiB window.
+func genContent(ht *hegel.T, r *rand.Rand, maxLen int) []byte {
+	total := pick(ht, 0, n(ht, 1, 20), n(ht, 1, 300), n(ht, 300, 5000), n(ht, 5000, maxLen), n(ht, 1, maxLen))
+	total = min(total, maxLen)
+	b := make([]byte, 0, total)
+	words := []string{"the ", "lz4 ", "block ", "frame ", "format ", "is ", "simple ", "\n", "0123456789", "compression "}
+	for len(b) < total {
+		switch r.Intn(7) {
+		case 0:
+			b = append(b, randBytes(r, 1+r.Intn(64), 0)...)
+		case 1:
+			b = append(b, bytes.Repeat([]byte{byte(r.Intn(256))}, 1+r.Intn(300))...)
+		case 2:
+			b = append(b, randBytes(r, 1+r.Intn(200), 2+r.Intn(3))...)
+		case 3, 4:
+			if len(b) == 0 {
+				b = append(b, randBytes(r, 8, 0)...)
+				continue
+			}
+			off := 1 + r.Intn(min(len(b), 70000))
+			l := 4 + r.Intn(500)
+			for k := 0; k < l; k++ {
+				b = append(b, b[len(b)-off])
+			}
+		default:
+			b = append(b, words[r.Intn(len(words))]...)
+		}
+	}
+	return b[:total]
+}
+
+// ---------------------------------------------------------------------------
+// The frame format.
+
+const (
+	frameMagic     = 0x184D2204
+	legacyMagic    = 0x184C2102
+	skippableMagic = 0x184D2A50
+)
+
+var blockMax = map[int]int{4: 64 << 10, 5: 256 << 10, 6: 1 << 20, 7: 4 << 20}
+
+type specBlock struct {
+	payload []byte // compressed block, or the data itself when raw
+	raw     bool
+	out     []byte
+}
+
+// frameSpec is a frame as the builder writes it and the parser reads it.
+type frameSpec struct {
+	legacy    bool
+	skippable bool // a skippable frame of len(skip) bytes
+	skip      []byte
+	bsIdx     int // 4..7
+	indep     bool
+	bsum      bool
+	csize     bool
+	csum      bool
+	blocks    []specBlock
+	content   []byte
+	// Read by the parser only.
+	contentSize  uint64
+	nonCompliant bool // a block breaks the encoder restrictions (decoders may reject it)
+}
+
+func (f *frameSpec) build() []byte {
+	var b []byte
+	if f.skippable {
+		b = binary.LittleEndian.AppendUint32(b, skippableMagic)
+		b = binary.LittleEndian.AppendUint32(b, uint32(len(f.skip)))
+		return append(b, f.skip...)
+	}
+	if f.legacy {
+		b = binary.LittleEndian.AppendUint32(b, legacyMagic)
+		for _, blk := range f.blocks {
+			b = binary.LittleEndian.AppendUint32(b, uint32(len(blk.payload)))
+			b = append(b, blk.payload...)
+		}
+		return b
+	}
+	b = binary.LittleEndian.AppendUint32(b, frameMagic)
+	flg := byte(1 << 6)
+	if f.indep {
+		flg |= 1 << 5
+	}
+	if f.bsum {
+		flg |= 1 << 4
+	}
+	if f.csize {
+		flg |= 1 << 3
+	}
+	if f.csum {
+		flg |= 1 << 2
+	}
+	hdr := []byte{flg, byte(f.bsIdx << 4)}
+	if f.csize {
+		hdr = binary.LittleEndian.AppendUint64(hdr, uint64(len(f.content)))
+	}
+	b = append(b, hdr...)
+	b = append(b, byte(xxh32(hdr)>>8))
+	for _, blk := range f.blocks {
+		sz := uint32(len(blk.payload))
+		if blk.raw {
+			sz |= 1 << 31
+		}
+		b = binary.LittleEndian.AppendUint32(b, sz)
+		b = append(b, blk.payload...)
+		if f.bsum {
+			b = binary.LittleEndian.AppendUint32(b, xxh32(blk.payload))
+		}
+	}
+	b = append(b, 0, 0, 0, 0)
+	if f.csum {
+		b = binary.LittleEndian.AppendUint32(b, xxh32(f.content))
+	}
+	return b
+}
+
+type specError struct {
+	kind string // magic, truncated, version, reserved, block-size-index, header-checksum, block-size, block-checksum, block-format, content-checksum, content-size
+	msg  string
+}
+
+func (e *specError) Error() string { return "spec: " + e.kind + ": " + e.msg }
+
+func specErr(kind, format string, args ...any) *specError {
+	return &specError{kind: kind, msg: fmt.Sprintf(format, args...)}
+}
+
+func isMagic(x uint32) bool {
+	return x == frameMagic || x == legacyMagic || x>>4 == skippableMagic>>4
+}
+
+// parseFrames parses a sequence of frames strictly by the specification and
+// returns them with the concatenated content.
+func parseFrames(data []byte) ([]frameSpec, []byte, *specError) {
+	var frames []frameSpec
+	var content []byte
+	pos := 0
+	u32 := func() (uint32, bool) {
+		if pos+4 > len(data) {
+			return 0, false
+		}
+		x := binary.LittleEndian.Uint32(data[pos:])
+		pos += 4
+		return x, true
+	}
+	for pos < len(data) {
+		magic, ok := u32()
+		if !ok {
+			return nil, nil, specErr("truncated", "%d trailing bytes", len(data)-pos+4)
+		}
+		switch {
+		case magic>>4 == skippableMagic>>4:
+			size, ok := u32()
+			if !ok || pos+int(size) > len(data) {
+				return nil, nil, specErr("truncated", "skippable frame")
+			}
+			frames = append(frames, frameSpec{skippable: true, skip: data[pos : pos+int(size)]})
+			pos += int(size)
+		case magic == legacyMagic:
+			f := frameSpec{legacy: true, bsIdx: 3}
+			for pos < len(data) {
+				if pos+4 <= len(data) && isMagic(binary.LittleEndian.Uint32(data[pos:])) {
+					break
+				}
+				size, ok := u32()
+				if !ok {
+					return nil, nil, specErr("truncated", "legacy block size")
+				}
+				if int(size) > lz4.CompressBlockBound(8<<20) {
+					return nil, nil, specErr("block-size", "legacy block of %d bytes", size)
+				}
+				if pos+int(size) > len(data) {
+					return nil, nil, specErr("truncated", "legacy block")
+				}
+				payload := data[pos : pos+int(size)]
+				pos += int(size)
+				out, compliant, err := decodeBlock(payload, nil, 8<<20)
+				if err != nil {
+					return nil, nil, specErr("block-format", "%v", err)
+				}
+				f.nonCompliant = f.nonCompliant || !compliant
+				f.blocks = append(f.blocks, specBlock{payload: payload, out: out})
+				f.content = append(f.content, out...)
+			}
+			content = append(content, f.content...)
+			frames = append(frames, f)
+		case magic == frameMagic:
+			if pos+3 > len(data) {
+				return nil, nil, specErr("truncated", "frame descriptor")
+			}
+			flg, bd := data[pos], data[pos+1]
+			f := frameSpec{bsIdx: int(bd>>4) & 7, indep: flg&(1<<5) != 0, bsum: flg&(1<<4) != 0, csize: flg&(1<<3) != 0, csum: flg&(1<<2) != 0}
+			hdrLen := 2
+			if f.csize {
+				hdrLen += 8
+			}
+			if flg&1 != 0 {
+				hdrLen += 4 // dictionary id
+			}
+			if pos+hdrLen+1 > len(data) {
+				return nil, nil, specErr("truncated", "frame descriptor")
+			}
+			hdr := data[pos : pos+hdrLen]
+			hc := data[pos+hdrLen]
+			if byte(xxh32(hdr)>>8) != hc {
+				return nil, nil, specErr("header-checksum", "got %02x want %02x", hc, byte(xxh32(hdr)>>8))
+			}
+			if flg>>6 != 1 {
+				return nil, nil, specErr("version", "%d", flg>>6)
+			}
+			if flg&2 != 0 || bd&0x8F != 0 {
+				return nil, nil, specErr("reserved", "flg %02x bd %02x", flg, bd)
+			}
+			if f.bsIdx < 4 || f.bsIdx > 7 {
+				return nil, nil, specErr("block-size-index", "%d", f.bsIdx)
+			}
+			if f.csize {
+				f.contentSize = binary.LittleEndian.Uint64(hdr[2:])
+			}
+			pos += hdrLen + 1
+			for {
+				x, ok := u32()
+				if !ok {
+					return nil, nil, specErr("truncated", "block size")
+				}
+				if x == 0 {
+					break
+				}
+				size := int(x & 0x7FFFFFFF)
+				raw := x>>31 != 0
+				if size > blockMax[f.bsIdx] {
+					return nil, nil, specErr("block-size", "%d > %d", size, blockMax[f.bsIdx])
+				}
+				if pos+size > len(data) {
+					return nil, nil, specErr("truncated", "block data")
+				}
+				payload := data[pos : pos+size]
+				pos += size
+				if f.bsum {
+					sum, ok := u32()
+					if !ok {
+						return nil, nil, specErr("truncated", "block checksum")
+					}
+					if sum != xxh32(payload) {
+						return nil, nil, specErr("block-checksum", "got %08x want %08x", sum, xxh32(payload))
+					}
+				}
+				var out []byte
+				if raw {
+					out = payload
+				} else {
+					var dict []byte
+					if !f.indep {
+						dict = f.content
+						if len(dict) > 64<<10 {
+							dict = dict[len(dict)-64<<10:]
+						}
+					}
+					var err error
+					var compliant bool
+					out, compliant, err = decodeBlock(payload, dict, blockMax[f.bsIdx])
+					if err != nil {
+						return nil, nil, specErr("block-format", "%v", err)
+					}
+					f.nonCompliant = f.nonCompliant || !compliant
+				}
+				f.blocks = append(f.blocks, specBlock{payload: payload, raw: raw, out: out})
+				f.content = append(f.content, out...)
+			}
+			if f.csum {
+				sum, ok := u32()
+				if !ok {
+					return nil, nil, specErr("truncated", "content checksum")
+				}
+				if sum != xxh32(f.content) {
+					return nil, nil, specErr("content-checksum", "got %08x want %08x", sum, xxh32(f.content))
+				}
+			}
+			if f.csize && f.contentSize != uint64(len(f.content)) {
+				return nil, nil, specErr("content-size", "header says %d, content is %d", f.contentSize, len(f.content))
+			}
+			content = append(content, f.content...)
+			frames = append(frames, f)
+		default:
+			return nil, nil, specErr("magic", "%08x", magic)
+		}
+	}
+	return frames, content, nil
+}
+
+// genFrame draws a frame of the specification with random flags, made of
+// generated blocks (raw or compressed, dependent or not).
+func genFrame(ht *hegel.T, r *rand.Rand, allowLegacy, forceIndep bool) frameSpec {
+	f := frameSpec{bsIdx: n(ht, 4, 7), indep: forceIndep || chance(ht, 60), bsum: chance(ht, 40), csize: chance(ht, 40), csum: chance(ht, 60)}
+	if allowLegacy && chance(ht, 12) {
+		f = frameSpec{legacy: true, bsIdx: 3, indep: true}
+	}
+	count := pick(ht, 0, 1, 1, 2, n(ht, 2, 5))
+	for i := 0; i < count; i++ {
+		maxOut := min(blockMax[f.bsIdx], 30000)
+		if f.legacy {
+			maxOut = 30000
+		}
+		var blk specBlock
+		if !f.legacy && chance(ht, 30) {
+			blk.raw = true
+			blk.out = randBytes(r, n(ht, 1, min(maxOut, 3000)), pick(ht, 0, 0, 3))
+			blk.payload = blk.out
+		} else {
+			var dict []byte
+			if !f.indep && !f.legacy {
+				dict = f.content
+				if len(dict) > 64<<10 {
+					dict = dict[len(dict)-64<<10:]
+				}
+			}
+			blk.payload, blk.out = genBlock(ht, r, dict, maxOut)
+			if len(blk.out) == 0 && (f.legacy || true) {
+				// A block of no data has no place in a frame (size 0 is the end mark).
+				continue
+			}
+			if f.legacy && Known.legacyCumulativeStop && len(blk.payload) == len(f.content) {
+				continue
+			}
+		}
+		f.blocks = append(f.blocks, blk)
+		f.content = append(f.content, blk.out...)
+	}
+	return f
+}
+
+// ---------------------------------------------------------------------------
+// The reference implementation.
+
+var lz4Path = func() string {
+	p, err := exec.LookPath("lz4")
+	if err != nil {
+		return ""
+	}
+	return p
+}()
+
+// cli runs lz4 with stdin and returns stdout.
+func cli(in []byte, args ...string) ([]byte, error) {
+	cmd := exec.Command(lz4Path, args...)
+	cmd.Stdin = bytes.NewReader(in)
+	var out, errb bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &out, &errb
+	if err := cmd.Run(); err != nil {
+		return out.Bytes(), fmt.Errorf("lz4 %s: %v: %s", strings.Join(args, " "), err, bytes.TrimSpace(errb.Bytes()))
+	}
+	return out.Bytes(), nil
+}
+
+// cliCompressFile compresses through files, so that --content-size is known.
+func cliCompressFile(ht *hegel.T, content []byte, args ...string) []byte {
+	dir, err := os.MkdirTemp("", "hegel-lz4")
+	if err != nil {
+		fail(ht, "tempdir: %v", err)
+	}
+	defer os.RemoveAll(dir)
+	in := filepath.Join(dir, "in")
+	out := filepath.Join(dir, "out.lz4")
+	if err := os.WriteFile(in, content, 0o600); err != nil {
+		fail(ht, "write: %v", err)
+	}
+	all := append([]string{"-q", "-f"}, args...)
+	all = append(all, in, out)
+	cmd := exec.Command(lz4Path, all...)
+	var errb bytes.Buffer
+	cmd.Stderr = &errb
+	if err := cmd.Run(); err != nil {
+		fail(ht, "lz4 %s: %v: %s", strings.Join(all, " "), err, errb.Bytes())
+	}
+	b, err := os.ReadFile(out)
+	if err != nil {
+		fail(ht, "read: %v", err)
+	}
+	return b
+}
+
+func cliDecode(data []byte) ([]byte, error) { return cli(data, "-d", "-q", "-c") }
+
+// blockFrame wraps a raw block in a minimal frame so that the reference tool
+// can decode it.
+func blockFrame(blk []byte, outLen int) []byte {
+	idx := 4
+	for idx < 7 && outLen > blockMax[idx] {
+		idx++
+	}
+	f := frameSpec{bsIdx: idx, indep: true, blocks: []specBlock{{payload: blk}}}
+	return f.build()
+}
+
+// ---------------------------------------------------------------------------
+// Reading with the library, guarded against panics and hangs.
+
+type readResult struct {
+	out     []byte
+	err     error
+	handler []int
+	size    int // Reader.Size after the first Read (mode 0 only)
+	firstN  int // bytes returned by the first Read (mode 0 only)
+}
+
+// readFrames reads data with a Reader: mode 0 = Read with the given buffer
+// sizes, 1 = WriteTo, 2 = io.ReadAll.
+func readFrames(ht *hegel.T, data []byte, mode, conc int, sizes []int) readResult {
+	done := make(chan readResult, 1)
+	go func() {
+		var res readResult
+		defer func() {
+			if r := recover(); r != nil {
+				res.err = fmt.Errorf("PANIC: %v", r)
+			}
+			done <- res
+		}()
+		r := lz4.NewReader(bytes.NewReader(data))
+		opts := []lz4.Option{lz4.OnBlockDoneOption(func(k int) { res.handler = append(res.handler, k) })}
+		if conc != 1 {
+			opts = append(opts, lz4.ConcurrencyOption(conc))
+		}
+		if err := r.Apply(opts...); err != nil {
+			res.err = fmt.Errorf("Apply: %w", err)
+			return
+		}
+		switch mode {
+		case 0:
+			buf := make([]byte, 1<<17)
+			for i := 0; ; i++ {
+				k := sizes[i%len(sizes)]
+				m, err := r.Read(buf[:k])
+				res.out = append(res.out, buf[:m]...)
+				if i == 0 {
+					res.size = r.Size()
+					res.firstN = m
+				}
+				if err == io.EOF {
+					return
+				}
+				if err != nil {
+					res.err = err
+					return
+				}
+			}
+		case 1:
+			var b bytes.Buffer
+			_, err := r.WriteTo(&b)
+			res.out, res.err = b.Bytes(), err
+		default:
+			res.out, res.err = io.ReadAll(r)
+		}
+	}()
+	select {
+	case res := <-done:
+		return res
+	case <-time.After(60 * time.Second):
+		fail(ht, "the Reader hangs on %d bytes (mode %d, concurrency %d)", len(data), mode, conc)
+		return readResult{}
+	}
+}
+
+func genSizes(ht *hegel.T) []int {
+	k := n(ht, 1, 4)
+	sizes := make([]int, k)
+	for i := range sizes {
+		sizes[i] = pick(ht, 1, 2, 7, 100, 4096, 65536, n(ht, 1, 70000))
+	}
+	return sizes
+}
+
+// ---------------------------------------------------------------------------
+// Property 1: the block compressors.
+
+type blockCompressor struct {
+	name string
+	fn   func(src, dst []byte) (int, error)
+}
+
+func genCompressor(ht *hegel.T) blockCompressor {
+	switch n(ht, 0, 5) {
+	case 0:
+		return blockCompressor{"CompressBlock", func(src, dst []byte) (int, error) { return lz4.CompressBlock(src, dst, nil) }}
+	case 1:
+		c := new(lz4.Compressor)
+		return blockCompressor{"Compressor", c.CompressBlock}
+	case 2:
+		level := pick(ht, lz4.Level1, lz4.Level2, lz4.Level3, lz4.Level4, lz4.Level5, lz4.Level6, lz4.Level7, lz4.Level8, lz4.Level9)
+		return blockCompressor{fmt.Sprintf("CompressBlockHC(%s)", level), func(src, dst []byte) (int, error) { return lz4.CompressBlockHC(src, dst, level, nil, nil) }}
+	case 3:
+		return blockCompressor{"CompressBlockHC(0)", func(src, dst []byte) (int, error) { return lz4.CompressBlockHC(src, dst, 0, nil, nil) }}
+	default:
+		level := pick(ht, lz4.Fast, lz4.Level1, lz4.Level3, lz4.Level6, lz4.Level9)
+		c := &lz4.CompressorHC{Level: level}
+		return blockCompressor{fmt.Sprintf("CompressorHC{%s}", level), c.CompressBlock}
+	}
+}
+
+func TestHegelBlockCompressionRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		src := genContent(ht, r, 70000)
+		c := genCompressor(ht)
+		note(ht, "%s on %d bytes", c.name, len(src))
+		bound := lz4.CompressBlockBound(len(src))
+		dst := make([]byte, bound)
+		k, err := c.fn(src, dst)
+		if err != nil || k <= 0 {
+			fail(ht, "%s with a bound-sized destination: n=%d err=%v (documented to always succeed with n > 0)", c.name, k, err)
+		}
+		blk := append([]byte{}, dst[:k]...)
+		if got, compliant, err := decodeBlock(blk, nil, len(src)); err != nil || !bytes.Equal(got, src) {
+			fail(ht, "%s block does not decode by the format: %v (%d bytes -> %d, want %d)", c.name, err, k, len(got), len(src))
+		} else if !compliant {
+			fail(ht, "%s block breaks the encoder restrictions (last five literals, last match twelve bytes before the end)", c.name)
+		}
+		// The library decodes its own block, into an exact and into a larger buffer.
+		for _, extra := range []int{0, n(ht, 1, 100)} {
+			out := make([]byte, len(src)+extra)
+			m, err := lz4.UncompressBlock(blk, out)
+			if err != nil || m != len(src) || !bytes.Equal(out[:m], src) {
+				fail(ht, "UncompressBlock of a %s block into %d+%d bytes: n=%d err=%v", c.name, len(src), extra, m, err)
+			}
+		}
+		// The reference decodes it.
+		if got, err := cliDecode(blockFrame(blk, len(src))); err != nil || !bytes.Equal(got, src) {
+			fail(ht, "the reference lz4 rejects a %s block: %v (%d bytes back, want %d)", c.name, err, len(got), len(src))
+		}
+		// Deterministic (issue #65).
+		dst2 := make([]byte, bound)
+		if k2, err := c.fn(src, dst2); err != nil || k2 != k || !bytes.Equal(dst2[:k2], blk) {
+			fail(ht, "%s is not deterministic: %d then %d bytes (err %v)", c.name, k, k2, err)
+		}
+		// A destination of the source's size, as the frame writer uses it: a
+		// valid block or 0.
+		dstS := make([]byte, len(src))
+		if k3, err := c.fn(src, dstS); k3 > 0 {
+			if k3 > len(src) {
+				fail(ht, "%s wrote %d bytes into a %d-byte destination", c.name, k3, len(src))
+			}
+			if got, _, err := decodeBlock(dstS[:k3], nil, len(src)); err != nil || !bytes.Equal(got, src) {
+				fail(ht, "%s block into a source-sized destination does not decode: %v", c.name, err)
+			}
+		} else if err != nil && k3 != 0 {
+			fail(ht, "%s returned n=%d with error %v", c.name, k3, err)
+		}
+		// A destination too small by one: the first return value is zero.
+		if k > 1 {
+			short := make([]byte, k-1)
+			if k4, _ := c.fn(src, short); k4 != 0 {
+				fail(ht, "%s into %d bytes (block is %d): n=%d, want 0", c.name, k-1, k, k4)
+			}
+		}
+		if bound < len(src)+len(src)/255+16 {
+			fail(ht, "CompressBlockBound(%d) = %d", len(src), bound)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 2: the block decoder on blocks of the format.
+
+func mutate(ht *hegel.T, r *rand.Rand, b []byte) []byte {
+	m := append([]byte{}, b...)
+	ops := n(ht, 1, 2)
+	for i := 0; i < ops && len(m) > 0; i++ {
+		p := r.Intn(len(m))
+		switch n(ht, 0, 6) {
+		case 0:
+			m[p] ^= 1 << uint(r.Intn(8))
+		case 1:
+			m[p] = byte(r.Intn(256))
+		case 2:
+			m[p] = pick(ht, byte(0), byte(0xFF), byte(0xF0), byte(0x0F))
+		case 3:
+			m = append(m[:p], m[p+1:]...)
+		case 4:
+			m = append(m[:p], append([]byte{byte(r.Intn(256))}, m[p:]...)...)
+		case 5:
+			m = m[:p]
+		default:
+			m = append(m, byte(r.Intn(256)))
+		}
+	}
+	return m
+}
+
+func TestHegelSpecBlocksDecode(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		var dict []byte
+		if chance(ht, 30) {
+			dict = genContent(ht, r, 70000)
+		}
+		blk, out := genBlock(ht, r, dict, 100000)
+		note(ht, "block %d bytes -> %d bytes, dict %d", len(blk), len(out), len(dict))
+		decode := func(src, dst []byte) (int, error) {
+			if dict == nil && chance(ht, 50) {
+				return lz4.UncompressBlock(src, dst)
+			}
+			return lz4.UncompressBlockWithDict(src, dst, dict)
+		}
+		for _, extra := range []int{0, n(ht, 1, 300)} {
+			dst := make([]byte, len(out)+extra)
+			m, err := decode(blk, dst)
+			if err != nil || m != len(out) || !bytes.Equal(dst[:m], out) {
+				fail(ht, "UncompressBlock of a block of the format into %d+%d bytes: n=%d err=%v", len(out), extra, m, err)
+			}
+		}
+		if len(out) > 0 {
+			short := n(ht, 1, min(len(out), 40))
+			dst := make([]byte, len(out)-short)
+			m, err := decode(blk, dst)
+			if err == nil {
+				fail(ht, "UncompressBlock into %d bytes for %d bytes of data succeeded with n=%d", len(dst), len(out), m)
+			}
+			if !errors.Is(err, lz4.ErrInvalidSourceShortBuffer) {
+				fail(ht, "UncompressBlock into a short buffer: %v, want ErrInvalidSourceShortBuffer", err)
+			}
+		}
+		if dict == nil && chance(ht, 50) {
+			if got, err := cliDecode(blockFrame(blk, len(out))); err != nil || !bytes.Equal(got, out) {
+				fail(ht, "the reference lz4 rejects a block of the format: %v", err)
+			}
+		}
+		// Damaged blocks: never a panic; the format decides what may be accepted.
+		m := mutate(ht, r, blk)
+		if len(m) == 0 {
+			m = []byte{0} // UncompressBlock treats empty input as empty output; the format has no empty block
+		}
+		limit := len(out) + n(ht, 0, 100)
+		want, compliant, werr := decodeBlock(m, dict, limit)
+		dst := make([]byte, limit)
+		var k int
+		var err error
+		func() {
+			defer func() {
+				if rec := recover(); rec != nil {
+					fail(ht, "UncompressBlock panicked on a damaged block %x: %v", m, rec)
+				}
+			}()
+			k, err = decode(m, dst)
+		}()
+		switch {
+		case err == nil && werr != nil:
+			fail(ht, "UncompressBlock accepts a damaged block the format rejects (%v): %x -> %d bytes", werr, m, k)
+		case err == nil && !bytes.Equal(dst[:k], want):
+			fail(ht, "UncompressBlock decodes a damaged block %x to %d bytes, the format says %d", m, k, len(want))
+		case err != nil && werr == nil && compliant:
+			fail(ht, "UncompressBlock rejects a compliant block %x: %v", m, err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 3: the Writer's frames.
+
+type writerOpts struct {
+	bs     lz4.BlockSize
+	bsum   bool
+	csum   bool
+	csize  bool
+	level  lz4.CompressionLevel
+	conc   int
+	legacy bool
+}
+
+func (o writerOpts) options(size int) []lz4.Option {
+	return append(o.plainOptions(size), lz4.ConcurrencyOption(o.conc))
+}
+
+// plainOptions are the options without ConcurrencyOption (which the
+// CompressingReader does not take).
+func (o writerOpts) plainOptions(size int) []lz4.Option {
+	opts := []lz4.Option{lz4.BlockSizeOption(o.bs), lz4.BlockChecksumOption(o.bsum), lz4.ChecksumOption(o.csum), lz4.CompressionLevelOption(o.level)}
+	if o.csize {
+		opts = append(opts, lz4.SizeOption(uint64(size)))
+	}
+	if o.legacy {
+		opts = append(opts, lz4.LegacyOption(true))
+	}
+	return opts
+}
+
+func (o writerOpts) String() string {
+	return fmt.Sprintf("bs=%s bsum=%v csum=%v csize=%v level=%s conc=%d legacy=%v", o.bs, o.bsum, o.csum, o.csize, o.level, o.conc, o.legacy)
+}
+
+func genWriterOpts(ht *hegel.T) writerOpts {
+	return writerOpts{
+		bs:     pick(ht, lz4.Block64Kb, lz4.Block64Kb, lz4.Block256Kb, lz4.Block1Mb, lz4.Block4Mb),
+		bsum:   chance(ht, 40),
+		csum:   chance(ht, 60),
+		csize:  chance(ht, 40),
+		level:  pick(ht, lz4.Fast, lz4.Fast, lz4.Level1, lz4.Level2, lz4.Level3, lz4.Level4, lz4.Level5, lz4.Level6, lz4.Level7, lz4.Level8, lz4.Level9),
+		conc:   pick(ht, 1, 1, 1, 2, 3),
+		legacy: chance(ht, 10),
+	}
+}
+
+func bsIndex(bs lz4.BlockSize) int {
+	switch bs {
+	case lz4.Block64Kb:
+		return 4
+	case lz4.Block256Kb:
+		return 5
+	case lz4.Block1Mb:
+		return 6
+	}
+	return 7
+}
+
+func TestHegelWriterFramesFollowTheSpec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		content := genContent(ht, r, 300000)
+		o := genWriterOpts(ht)
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		var calls []int
+		var callsMu sync.Mutex
+		opts := append(o.options(len(content)), lz4.OnBlockDoneOption(func(k int) {
+			callsMu.Lock()
+			calls = append(calls, k)
+			callsMu.Unlock()
+		}))
+		if err := w.Apply(opts...); err != nil {
+			fail(ht, "Apply(%s): %v", o, err)
+		}
+		pattern := pick(ht, "write", "write", "chunks", "chunks+flush", "readfrom", "mixed")
+		if Known.readFromNotFirst && pattern == "mixed" {
+			pattern = "readfrom"
+		}
+		note(ht, "%d bytes, %s, %s", len(content), o, pattern)
+		flushes := 0
+		write := func(b []byte) {
+			k, err := w.Write(b)
+			if err != nil || k != len(b) {
+				fail(ht, "Write(%d) = %d, %v", len(b), k, err)
+			}
+		}
+		switch pattern {
+		case "write":
+			write(content)
+		case "chunks", "chunks+flush":
+			for pos := 0; pos < len(content); {
+				k := min(len(content)-pos, pick(ht, 1, n(ht, 1, 100), n(ht, 1, 70000), n(ht, 1, len(content))))
+				write(content[pos : pos+k])
+				pos += k
+				if pattern == "chunks+flush" && chance(ht, 50) {
+					if err := w.Flush(); err != nil {
+						fail(ht, "Flush: %v", err)
+					}
+					flushes++
+				}
+			}
+		case "readfrom":
+			k, err := w.ReadFrom(bytes.NewReader(content))
+			if err != nil || k != int64(len(content)) {
+				fail(ht, "ReadFrom = %d, %v", k, err)
+			}
+		default:
+			cut := n(ht, 0, len(content))
+			write(content[:cut])
+			k, err := w.ReadFrom(bytes.NewReader(content[cut:]))
+			if err != nil || k != int64(len(content)-cut) {
+				fail(ht, "ReadFrom = %d, %v", k, err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "second Close: %v", err)
+		}
+		data := buf.Bytes()
+		frames, got, perr := parseFrames(data)
+		if perr != nil {
+			fail(ht, "the Writer's %d bytes do not parse by the specification: %v", len(data), perr)
+		}
+		if len(frames) != 1 {
+			fail(ht, "the Writer wrote %d frames", len(frames))
+		}
+		f := frames[0]
+		if !bytes.Equal(got, content) {
+			fail(ht, "the frame's content is %d bytes, want %d", len(got), len(content))
+		}
+		if f.legacy != o.legacy {
+			fail(ht, "legacy frame %v, want %v", f.legacy, o.legacy)
+		}
+		if !o.legacy {
+			if f.bsIdx != bsIndex(o.bs) || f.bsum != o.bsum || f.csum != o.csum || !f.indep {
+				fail(ht, "frame flags bs=%d bsum=%v csum=%v indep=%v for %s", f.bsIdx, f.bsum, f.csum, f.indep, o)
+			}
+			wantSize := o.csize && len(content) > 0
+			if f.csize != wantSize || (f.csize && f.contentSize != uint64(len(content))) {
+				fail(ht, "content size flag %v (%d), want %v (%d)", f.csize, f.contentSize, wantSize, len(content))
+			}
+			maxBlock := int(o.bs)
+			for i, b := range f.blocks {
+				if len(b.out) > maxBlock {
+					fail(ht, "block %d holds %d bytes, above the %d limit", i, len(b.out), maxBlock)
+				}
+				if len(b.payload) > len(b.out) {
+					fail(ht, "block %d is %d bytes for %d bytes of data (stored blocks must be used when compression does not help)", i, len(b.payload), len(b.out))
+				}
+			}
+			if pattern != "chunks+flush" {
+				want := (len(content) + maxBlock - 1) / maxBlock
+				if len(f.blocks) != want {
+					fail(ht, "%d blocks for %d bytes with %d-byte blocks, want %d", len(f.blocks), len(content), maxBlock, want)
+				}
+			}
+			// The handler: once per block, with the block's size as written.
+			if !(Known.readFromHandlerTwice && (pattern == "readfrom" || pattern == "mixed")) && !(Known.handlerAfterClose && o.conc > 1) {
+				sizes := []int{}
+				for _, b := range f.blocks {
+					sizes = append(sizes, len(b.payload))
+				}
+				sort.Ints(sizes)
+				callsMu.Lock()
+				got := append([]int{}, calls...)
+				callsMu.Unlock()
+				sort.Ints(got)
+				if fmt.Sprint(got) != fmt.Sprint(sizes) {
+					fail(ht, "OnBlockDone calls %v, blocks written %v", got, sizes)
+				}
+			}
+		}
+		// The reference decodes it.
+		if ref, err := cliDecode(data); err != nil || !bytes.Equal(ref, content) {
+			fail(ht, "the reference lz4 does not decode the Writer's frame: %v (%d bytes back, want %d)", err, len(ref), len(content))
+		}
+		// The library reads it back (lz4/7: unless a legacy block's size equals the content before it).
+		coincidence := false
+		if f.legacy {
+			cum := 0
+			for _, b := range f.blocks {
+				if len(b.payload) == cum {
+					coincidence = true
+				}
+				cum += len(b.out)
+			}
+		}
+		if !(Known.legacyCumulativeStop && coincidence) {
+			res := readFrames(ht, data, n(ht, 0, 2), pick(ht, 1, 1, 2, 4), genSizes(ht))
+			if res.err != nil || !bytes.Equal(res.out, content) {
+				fail(ht, "the Reader does not read the Writer's frame: %v (%d bytes, want %d)", res.err, len(res.out), len(content))
+			}
+		}
+		if ok, err := lz4.ValidFrameHeader(data[:min(len(data), 15)]); !ok || err != nil {
+			fail(ht, "ValidFrameHeader of the Writer's frame: %v, %v", ok, err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 4: the Reader on frames of the specification and of the reference.
+
+func genCLIArgs(ht *hegel.T, hasFile bool) (args []string, legacy bool) {
+	args = append(args, pick(ht, "-1", "-1", "-3", "-6", "-9", "-12", "--fast=5"))
+	switch n(ht, 0, 3) {
+	case 0:
+		args = append(args, pick(ht, "-B4", "-B5", "-B6", "-B7"))
+	case 1:
+		args = append(args, fmt.Sprintf("-B%d", n(ht, 32, 5000)))
+	}
+	if chance(ht, 30) {
+		args = append(args, "-BD")
+	}
+	if chance(ht, 30) {
+		args = append(args, "-BX")
+	}
+	if chance(ht, 40) {
+		args = append(args, "--no-frame-crc")
+	}
+	if hasFile && chance(ht, 40) {
+		args = append(args, "--content-size")
+	}
+	if chance(ht, 10) {
+		args = []string{"-l", pick(ht, "-1", "-9")}
+		legacy = true
+	}
+	return args, legacy
+}
+
+func TestHegelReaderAcceptsSpecAndReferenceFrames(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		var data, content []byte
+		var desc []string
+		singleSized := false
+		count := pick(ht, 1, 1, 1, 2, 3)
+		lastLegacy := false
+		mode := n(ht, 0, 2)
+		conc := pick(ht, 1, 1, 2, 4)
+		// The lz4/11 gate: WriteTo's buffer is sized by the first frame when the
+		// Reader runs non-concurrently (concurrency 1, or a first frame with
+		// dependent blocks or legacy, which turns concurrency off for good), and
+		// is missing altogether when a later frame turns concurrency off.
+		firstIdx := 0 // block size index of the first frame (legacy: 8)
+		firstDep := false
+		gate := Known.writeToDropsFrames && mode == 1
+		capIdx := func(idx int) int {
+			if gate && (conc == 1 || firstDep) && firstIdx > 0 && idx > firstIdx {
+				return firstIdx
+			}
+			return idx
+		}
+		for i := 0; i < count; i++ {
+			if Known.legacyThenOther && lastLegacy {
+				break
+			}
+			if chance(ht, 15) {
+				f := frameSpec{skippable: true, skip: randBytes(r, n(ht, 0, 50), 0)}
+				data = append(data, f.build()...)
+				desc = append(desc, fmt.Sprintf("skippable(%d)", len(f.skip)))
+				continue
+			}
+			if chance(ht, 50) {
+				forceIndep := gate && conc > 1 && !firstDep && firstIdx > 0
+				f := genFrame(ht, r, capIdx(8) == 8 && !forceIndep, forceIndep)
+				if !f.legacy {
+					f.bsIdx = capIdx(f.bsIdx)
+				}
+				if firstIdx == 0 {
+					firstIdx = f.bsIdx
+					if f.legacy {
+						firstIdx = 8
+					}
+					firstDep = f.legacy || !f.indep
+				}
+				data = append(data, f.build()...)
+				content = append(content, f.content...)
+				desc = append(desc, fmt.Sprintf("spec{legacy=%v bs=%d indep=%v bsum=%v csize=%v csum=%v blocks=%d content=%d}", f.legacy, f.bsIdx, f.indep, f.bsum, f.csize, f.csum, len(f.blocks), len(f.content)))
+				singleSized = count == 1 && f.csize && len(f.content) > 0
+				lastLegacy = f.legacy
+			} else {
+				c := genContent(ht, r, 200000)
+				args, legacy := genCLIArgs(ht, true)
+				if gate && conc > 1 && !firstDep && firstIdx > 0 {
+					var kept []string
+					for _, a := range args {
+						if a != "-BD" && a != "-l" {
+							kept = append(kept, a)
+						}
+					}
+					args = kept
+					legacy = false
+				}
+				if firstIdx > 0 && capIdx(8) < 8 {
+					// lz4/11: keep later frames within the first frame's block size.
+					var kept []string
+					for _, a := range args {
+						if a != "-l" && !strings.HasPrefix(a, "-B") {
+							kept = append(kept, a)
+						}
+					}
+					args = append(kept, fmt.Sprintf("-B%d", firstIdx))
+					legacy = false
+				}
+				lastLegacy = legacy
+				fr := cliCompressFile(ht, c, args...)
+				if firstIdx == 0 {
+					// The first frame's flags as the tool actually wrote them (an
+					// empty input, for one, comes out with independent blocks).
+					fs, _, perr := parseFrames(fr)
+					if perr != nil || len(fs) == 0 {
+						fail(ht, "harness: the specification parser fails on the tool's frame (lz4 %s): %v", strings.Join(args, " "), perr)
+					}
+					firstIdx = fs[0].bsIdx
+					if fs[0].legacy {
+						firstIdx = 8
+					}
+					firstDep = fs[0].legacy || !fs[0].indep
+				}
+				data = append(data, fr...)
+				content = append(content, c...)
+				desc = append(desc, fmt.Sprintf("lz4 %s (%d bytes)", strings.Join(args, " "), len(c)))
+				singleSized = count == 1 && slices(args, "--content-size") && len(c) > 0
+			}
+		}
+		if Known.writeToEOFOnEmpty && mode == 1 && firstIdx == 0 {
+			mode = 2 // no real frame in the stream: WriteTo would return io.EOF
+		}
+		note(ht, "%s (mode %d, concurrency %d)", strings.Join(desc, " + "), mode, conc)
+		// The specification parser accepts everything here (a check of the parser on the reference's output).
+		if _, got, err := parseFrames(data); err != nil || !bytes.Equal(got, content) {
+			fail(ht, "harness: the specification parser fails on %s: %v", strings.Join(desc, " + "), err)
+		}
+		res := readFrames(ht, data, mode, conc, genSizes(ht))
+		if res.err != nil {
+			fail(ht, "the Reader fails on %s: %v", strings.Join(desc, " + "), res.err)
+		}
+		if !bytes.Equal(res.out, content) {
+			fail(ht, "the Reader returns %d bytes for %s, want %d", len(res.out), strings.Join(desc, " + "), len(content))
+		}
+		if mode == 0 && singleSized && res.size != len(content) && !(Known.sizeLostAtEnd && res.firstN >= len(content)) {
+			fail(ht, "Reader.Size = %d after the first Read, the frame says %d", res.size, len(content))
+		}
+		if mode == 1 && !Known.readHandlerPerCall || mode != 0 {
+			// WriteTo: the handler is called once per block with the uncompressed size.
+			sum := 0
+			for _, k := range res.handler {
+				sum += k
+			}
+			if mode == 1 && sum != len(content) {
+				fail(ht, "OnBlockDone calls in WriteTo sum to %d, content is %d", sum, len(content))
+			}
+		}
+		if len(data) >= 7 && !strings.HasPrefix(desc[0], "skippable") {
+			if ok, err := lz4.ValidFrameHeader(data[:min(len(data), 15)]); !ok || err != nil {
+				fail(ht, "ValidFrameHeader on %s: %v, %v", desc[0], ok, err)
+			}
+		}
+	})
+}
+
+func slices(xs []string, s string) bool {
+	for _, x := range xs {
+		if x == s {
+			return true
+		}
+	}
+	return false
+}
+
+// ---------------------------------------------------------------------------
+// Property 5: damaged frames.
+
+func TestHegelCorruptFramesAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		var data []byte
+		if chance(ht, 50) {
+			f := genFrame(ht, r, false, false)
+			data = f.build()
+			note(ht, "spec frame bs=%d indep=%v bsum=%v csize=%v csum=%v blocks=%d content=%d", f.bsIdx, f.indep, f.bsum, f.csize, f.csum, len(f.blocks), len(f.content))
+		} else {
+			c := genContent(ht, r, 50000)
+			o := genWriterOpts(ht)
+			o.legacy = false
+			var buf bytes.Buffer
+			w := lz4.NewWriter(&buf)
+			if err := w.Apply(o.options(len(c))...); err != nil {
+				fail(ht, "Apply: %v", err)
+			}
+			w.Write(c)
+			w.Close()
+			data = buf.Bytes()
+			note(ht, "writer frame %s content=%d", o, len(c))
+		}
+		m := mutate(ht, r, data)
+		note(ht, "%d bytes mutated to %d", len(data), len(m))
+		frames, want, werr := parseFrames(m)
+		mode := n(ht, 0, 2)
+		if Known.writeToEOFOnEmpty && mode == 1 && len(m) == 0 {
+			mode = 2 // lz4/12
+		}
+		res := readFrames(ht, m, mode, pick(ht, 1, 1, 2), genSizes(ht))
+		if res.err != nil && strings.HasPrefix(res.err.Error(), "PANIC") {
+			fail(ht, "the Reader panicked on damaged bytes %x: %v", m, res.err)
+		}
+		if werr == nil {
+			// Still a frame of the specification.
+			for _, f := range frames {
+				if f.nonCompliant && res.err != nil {
+					return // a block breaking the encoder restrictions may be refused
+				}
+			}
+			if res.err != nil || !bytes.Equal(res.out, want) {
+				fail(ht, "the Reader rejects damaged bytes that are still a valid frame: %v (%d bytes, want %d) %x", res.err, len(res.out), len(want), m)
+			}
+			return
+		}
+		switch werr.kind {
+		case "version", "reserved":
+			if Known.acceptsBadVersion {
+				return
+			}
+		case "content-size":
+			if Known.ignoresContentSize {
+				return
+			}
+		case "truncated":
+			if Known.acceptsMissingEndMark {
+				return
+			}
+		case "block-format":
+			// The library may be stricter than the format, never more lenient.
+			if res.err == nil {
+				fail(ht, "the Reader accepts a frame whose block the format rejects (%v): %x", werr, m)
+			}
+			return
+		}
+		if res.err == nil {
+			fail(ht, "the Reader accepts damaged bytes the specification rejects (%v): %d bytes out, %x", werr, len(res.out), m)
+		}
+		// The named errors.
+		switch werr.kind {
+		case "header-checksum":
+			if !errors.Is(res.err, lz4.ErrInvalidHeaderChecksum) && !isEOF(res.err) {
+				fail(ht, "header damage gives %v, want ErrInvalidHeaderChecksum", res.err)
+			}
+		case "block-checksum":
+			if !errors.Is(res.err, lz4.ErrInvalidBlockChecksum) && !errors.Is(res.err, lz4.ErrInvalidSourceShortBuffer) && !isEOF(res.err) {
+				fail(ht, "block checksum damage gives %v, want ErrInvalidBlockChecksum", res.err)
+			}
+		case "content-checksum":
+			if !errors.Is(res.err, lz4.ErrInvalidFrameChecksum) && !isEOF(res.err) {
+				fail(ht, "content checksum damage gives %v, want ErrInvalidFrameChecksum", res.err)
+			}
+		case "magic":
+			if !errors.Is(res.err, lz4.ErrInvalidFrame) && !isEOF(res.err) {
+				fail(ht, "a bad magic number gives %v, want ErrInvalidFrame", res.err)
+			}
+		}
+	})
+}
+
+func isEOF(err error) bool { return errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) }
+
+// ---------------------------------------------------------------------------
+// Property 6: CompressingReader against the Writer.
+
+type closeRecorder struct {
+	io.Reader
+	closed int
+}
+
+func (c *closeRecorder) Close() error { c.closed++; return nil }
+
+func TestHegelCompressingReaderMatchesTheWriter(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		content := genContent(ht, r, 300000)
+		o := genWriterOpts(ht)
+		o.legacy = false
+		o.conc = 1
+		note(ht, "%d bytes, %s", len(content), o)
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		if err := w.Apply(o.options(len(content))...); err != nil {
+			fail(ht, "Writer.Apply: %v", err)
+		}
+		w.Write(content)
+		w.Close()
+		src := &closeRecorder{Reader: bytes.NewReader(content)}
+		cr := lz4.NewCompressingReader(src)
+		var calls []int
+		opts := append(o.plainOptions(len(content)), lz4.OnBlockDoneOption(func(k int) { calls = append(calls, k) }))
+		if err := cr.Apply(opts...); err != nil {
+			fail(ht, "CompressingReader.Apply: %v", err)
+		}
+		if cr.Source() != src {
+			fail(ht, "Source() is not the source")
+		}
+		sizes := genSizes(ht)
+		var got []byte
+		p := make([]byte, 1<<17)
+		for i := 0; ; i++ {
+			k := sizes[i%len(sizes)]
+			m, err := cr.Read(p[:k])
+			got = append(got, p[:m]...)
+			if err == io.EOF {
+				break
+			}
+			if err != nil {
+				fail(ht, "CompressingReader.Read: %v", err)
+			}
+			if m == 0 && k > 0 && i > 1000000 {
+				fail(ht, "CompressingReader.Read returns 0 bytes without end")
+			}
+		}
+		if !bytes.Equal(got, buf.Bytes()) {
+			fail(ht, "CompressingReader gives %d bytes, the Writer %d for the same options", len(got), buf.Len())
+		}
+		frames, back, err := parseFrames(got)
+		if err != nil || len(frames) != 1 || !bytes.Equal(back, content) {
+			fail(ht, "CompressingReader's frame: %v, %d frames, %d bytes", err, len(frames), len(back))
+		}
+		if len(calls) != len(frames[0].blocks) {
+			fail(ht, "OnBlockDone called %d times for %d blocks", len(calls), len(frames[0].blocks))
+		}
+		if err := cr.Close(); err != nil || src.closed != 1 {
+			fail(ht, "Close: %v, source closed %d times", err, src.closed)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 7: options and states.
+
+func TestHegelOptionsAndStatesFollowTheContract(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		content := genContent(ht, r, 20000)
+		o := genWriterOpts(ht)
+		note(ht, "%d bytes, %s", len(content), o)
+		// Option.String.
+		for _, c := range []struct{ got, want string }{
+			{lz4.BlockSizeOption(o.bs).String(), fmt.Sprintf("BlockSizeOption(%s)", o.bs)},
+			{lz4.BlockChecksumOption(o.bsum).String(), fmt.Sprintf("BlockChecksumOption(%v)", o.bsum)},
+			{lz4.ChecksumOption(o.csum).String(), fmt.Sprintf("ChecksumOption(%v)", o.csum)},
+			{lz4.SizeOption(uint64(len(content))).String(), fmt.Sprintf("SizeOption(%d)", len(content))},
+			{lz4.ConcurrencyOption(o.conc).String(), fmt.Sprintf("ConcurrencyOption(%d)", o.conc)},
+			{lz4.CompressionLevelOption(o.level).String(), fmt.Sprintf("CompressionLevelOption(%s)", o.level)},
+			{lz4.LegacyOption(o.legacy).String(), fmt.Sprintf("LegacyOption(%v)", o.legacy)},
+		} {
+			if c.got != c.want {
+				fail(ht, "Option.String() = %q, want %q", c.got, c.want)
+			}
+		}
+		// Invalid options.
+		// (A failed Apply leaves the Writer in its error state for good, as the
+		// ErrOptionClosedOrError documentation implies: fresh Writers here.)
+		if err := lz4.NewWriter(io.Discard).Apply(lz4.BlockSizeOption(lz4.BlockSize(n(ht, 1, 1<<20) | 1))); !errors.Is(err, lz4.ErrOptionInvalidBlockSize) {
+			fail(ht, "an odd block size gives %v, want ErrOptionInvalidBlockSize", err)
+		}
+		if err := lz4.NewWriter(io.Discard).Apply(lz4.CompressionLevelOption(lz4.CompressionLevel(n(ht, 1, 255)))); !errors.Is(err, lz4.ErrOptionInvalidCompressionLevel) {
+			fail(ht, "a level below Level1 gives %v, want ErrOptionInvalidCompressionLevel", err)
+		}
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		rd := lz4.NewReader(bytes.NewReader(nil))
+		for _, opt := range []lz4.Option{lz4.BlockSizeOption(o.bs), lz4.ChecksumOption(true), lz4.SizeOption(3), lz4.CompressionLevelOption(lz4.Level1), lz4.LegacyOption(true), lz4.BlockChecksumOption(true)} {
+			if err := rd.Apply(opt); !errors.Is(err, lz4.ErrOptionNotApplicable) {
+				fail(ht, "Reader.Apply(%s) = %v, want ErrOptionNotApplicable", opt, err)
+			}
+		}
+		if err := w.Apply(lz4.ConcurrencyOption(o.conc), lz4.LegacyOption(o.legacy)); err != nil {
+			fail(ht, "Apply: %v", err)
+		}
+		// States.
+		if _, err := w.Write(content[:min(len(content), 10)]); err != nil {
+			fail(ht, "Write: %v", err)
+		}
+		if Known.failedApplyPoisons {
+			// lz4/13: the late Apply would make Close fail; test it on a Writer of its own.
+			w3 := lz4.NewWriter(io.Discard)
+			w3.Write([]byte("x"))
+			if err := w3.Apply(lz4.ChecksumOption(false)); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+				fail(ht, "Apply after Write = %v, want ErrOptionClosedOrError", err)
+			}
+		} else if err := w.Apply(lz4.ChecksumOption(false)); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+			fail(ht, "Apply after Write = %v, want ErrOptionClosedOrError", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		if _, err := w.Write([]byte{1}); !errors.Is(err, lz4.ErrWriterClosed) {
+			fail(ht, "Write after Close = %v, want ErrWriterClosed", err)
+		}
+		if _, err := w.ReadFrom(bytes.NewReader([]byte{1})); !errors.Is(err, lz4.ErrWriterClosed) {
+			fail(ht, "ReadFrom after Close = %v, want ErrWriterClosed", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "second Close: %v", err)
+		}
+		// Reset keeps the options and writes a fresh frame.
+		var buf2 bytes.Buffer
+		w2 := lz4.NewWriter(&buf2)
+		o2 := o
+		o2.legacy = false
+		if Known.sizeLostOnApply {
+			o2.csize = false
+		}
+		if err := w2.Apply(o2.options(len(content))...); err != nil {
+			fail(ht, "Apply: %v", err)
+		}
+		w2.Write(content)
+		w2.Close()
+		first := append([]byte{}, buf2.Bytes()...)
+		var buf3 bytes.Buffer
+		w2.Reset(&buf3)
+		w2.Write(content)
+		if err := w2.Close(); err != nil {
+			fail(ht, "Close after Reset: %v", err)
+		}
+		if !bytes.Equal(first, buf3.Bytes()) {
+			fail(ht, "the frame after Reset differs from the first (%d vs %d bytes; headers %x / %x)", len(first), buf3.Len(), first[:min(15, len(first))], buf3.Bytes()[:min(15, buf3.Len())])
+		}
+		// Reader states.
+		rd2 := lz4.NewReader(bytes.NewReader(first))
+		if s := rd2.Size(); s != 0 {
+			fail(ht, "Size before reading = %d", s)
+		}
+		one := make([]byte, 1)
+		if _, err := rd2.Read(one); err != nil && err != io.EOF {
+			fail(ht, "Read: %v", err)
+		}
+		if err := rd2.Apply(lz4.ConcurrencyOption(2)); !errors.Is(err, lz4.ErrOptionClosedOrError) && !(Known.failedApplyPoisons && len(content) == 0 && err != nil) {
+			fail(ht, "Reader.Apply after Read = %v, want ErrOptionClosedOrError", err)
+		}
+		rd2.Reset(bytes.NewReader(first)) // (lz4/13: Reset is what clears the error state)
+		if err := rd2.Apply(lz4.ConcurrencyOption(o.conc)); err != nil {
+			fail(ht, "Reader.Apply after Reset: %v", err)
+		}
+		if got, err := io.ReadAll(rd2); err != nil || !bytes.Equal(got, content) {
+			fail(ht, "ReadAll after Reset: %v, %d bytes", err, len(got))
+		}
+		// Empty and short inputs.
+		for _, c := range []struct {
+			name string
+			in   []byte
+			want error
+		}{
+			{"empty", nil, io.EOF},
+			{"one byte", first[:1], io.ErrUnexpectedEOF},
+			{"magic only", first[:4], io.ErrUnexpectedEOF}, // lz4/6: a clean io.EOF while gated
+			{"header cut", first[:min(len(first), 6)], io.ErrUnexpectedEOF},
+			{"garbage", []byte{1, 2, 3, 4, 5, 6, 7, 8}, lz4.ErrInvalidFrame},
+		} {
+			if Known.acceptsMissingEndMark && c.name == "magic only" {
+				continue
+			}
+			rd := lz4.NewReader(bytes.NewReader(c.in))
+			k, err := rd.Read(make([]byte, 10))
+			if k != 0 || !errors.Is(err, c.want) {
+				fail(ht, "Read on %s input: %d, %v, want 0, %v", c.name, k, err, c.want)
+			}
+		}
+	})
+}
