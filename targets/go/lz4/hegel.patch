+package lz4_test
+
+// Hegel property tests for github.com/pierrec/lz4/v4.
+//
+// Oracles: the LZ4 block format and the LZ4 frame format (lz4_Block_format.md,
+// lz4_Frame_format.md), written here as an independent decoder, encoder,
+// frame parser and frame builder, including an xxHash32 of their own; the
+// reference implementation's command-line tool, lz4 (1.9.4), which must
+// decode every frame the library writes and whose frames the library must
+// read; and the package's documented contracts (options, states, callbacks,
+// buffer-size rules, the errors named in the API).
+//
+// Set LZ4_COLLECT=1 to make the properties record mismatches instead of
+// failing and print them (shortest first) at the end of each test.
+//
+// The properties draw the input shapes of the recorded bugs (bugs.toml) and
+// fail on them; HEGEL_NO_KNOWN=1 switches those shapes off so that the
+// properties run clean (see Known below).
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"math/bits"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/pierrec/lz4/v4"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	// Cases that shell out to the lz4 tool a few times take tens of
+	// milliseconds; on a loaded machine that trips Hegel's too-slow check.
+	opts = append(opts, hegel.SuppressHealthCheck(hegel.TooSlow))
+	return opts
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("LZ4_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+// fail reports a mismatch: normally ht.Fatalf, in collect mode it records the
+// message and abandons the case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...)+"\n  case: "+lastNote)
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+var lastNote string // the notes of the running case, for collect mode
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if lz4Path == "" {
+		t.Fatalf("the lz4 command-line tool (the reference implementation) is not installed")
+	}
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		lastNote = ""
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) {
+	m := fmt.Sprintf(format, args...)
+	lastNote += "\n  " + m
+	ht.Note(m)
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted picks among the alternatives with the given weights; it shrinks
+// towards the first, so the plainest alternative goes first.
+func weighted[T any](cs ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range cs {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(x int) hegel.Generator[T] {
+		for _, c := range cs {
+			if x < c.weight {
+				return c.gen
+			}
+			x -= c.weight
+		}
+		return cs[len(cs)-1].gen
+	})
+}
+
+// chance is a coin that is true pct percent of the time and shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe draws g pct percent of the time and the zero value otherwise.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hegel.FlatMap(chance(pct), func(on bool) hegel.Generator[T] {
+		if on {
+			return g
+		}
+		return hegel.Just(zero)
+	})
+}
+
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// exactly draws a list whose length is drawn from count.
+func exactly[T any](count hegel.Generator[int], g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.FlatMap(count, func(k int) hegel.Generator[[]T] { return many(g, k, k) })
+}
+
+func pick[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// positions are taken modulo the live size of whatever they index.
+var positions = hegel.Integers(0, 1<<20)
+
+func at(pos, size int) int {
+	if size <= 0 {
+		return 0
+	}
+	return pos % size
+}
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known switches off the input shapes of recorded bugs (see bugs.toml); every
+// switch is off by default, so the properties draw the shapes and fail on the
+// bugs (and are declared as expected failures beside their pins in
+// hegel_pins_test.go), and on under HEGEL_NO_KNOWN=1, which makes the
+// properties run clean.
+var Known = struct {
+	sizeLostOnApply       bool // lz4/1: Writer.Apply and Writer.Reset zero the content size but keep the size flag
+	readFromHandlerTwice  bool // lz4/2: Writer.ReadFrom calls the OnBlockDone handler twice per block
+	acceptsBadVersion     bool // lz4/4: the Reader accepts frames with a version other than 1 or reserved bits set
+	ignoresContentSize    bool // lz4/5: the Reader does not check the frame's content size against the content
+	acceptsMissingEndMark bool // lz4/6: a frame cut at a block boundary, without its end mark, is accepted when it has no content checksum
+	legacyCumulativeStop  bool // lz4/7: a legacy block whose compressed size equals the content read so far ends the frame
+	readFromNotFirst      bool // lz4/8: Writer.ReadFrom fails with ErrInternalUnhandledState unless it is the first operation
+	legacyThenOther       bool // lz4/9: a legacy frame followed by a standard or skippable frame fails with ErrOptionInvalidBlockSize
+	handlerAfterClose     bool // lz4/10: with concurrency, the OnBlockDone handler is called from other goroutines, possibly after Close returned
