+
+// ---------------------------------------------------------------------------
+// xxHash32 (seed 0), written from the algorithm description.
+
+const (
+	xxp1 uint32 = 2654435761
+	xxp2 uint32 = 2246822519
+	xxp3 uint32 = 3266489917
+	xxp4 uint32 = 668265263
+	xxp5 uint32 = 374761393
+)
+
+func xxh32(b []byte) uint32 {
+	total := uint32(len(b))
+	var h uint32
+	if len(b) >= 16 {
+		var seed uint32
+		v1 := seed + xxp1 + xxp2
+		v2 := seed + xxp2
+		v3 := seed
+		v4 := seed - xxp1
+		for len(b) >= 16 {
+			v1 = bits.RotateLeft32(v1+binary.LittleEndian.Uint32(b)*xxp2, 13) * xxp1
+			v2 = bits.RotateLeft32(v2+binary.LittleEndian.Uint32(b[4:])*xxp2, 13) * xxp1
+			v3 = bits.RotateLeft32(v3+binary.LittleEndian.Uint32(b[8:])*xxp2, 13) * xxp1
+			v4 = bits.RotateLeft32(v4+binary.LittleEndian.Uint32(b[12:])*xxp2, 13) * xxp1
+			b = b[16:]
+		}
+		h = bits.RotateLeft32(v1, 1) + bits.RotateLeft32(v2, 7) + bits.RotateLeft32(v3, 12) + bits.RotateLeft32(v4, 18)
+	} else {
+		h = xxp5
+	}
+	h += total
+	for len(b) >= 4 {
+		h += binary.LittleEndian.Uint32(b) * xxp3
+		h = bits.RotateLeft32(h, 17) * xxp4
+		b = b[4:]
+	}
+	for _, c := range b {
+		h += uint32(c) * xxp5
+		h = bits.RotateLeft32(h, 11) * xxp1
+	}
+	h ^= h >> 15
+	h *= xxp2
+	h ^= h >> 13
+	h *= xxp3
+	h ^= h >> 16
+	return h
+}
+
+func init() {
+	// Test vectors of the xxHash specification.
+	if xxh32(nil) != 0x02CC5D05 {
+		panic(fmt.Sprintf("xxh32(empty) = %08x", xxh32(nil)))
+	}
+	if xxh32([]byte("Nobody inspects the spammish repetition")) != 0xE2293B2F {
+		panic(fmt.Sprintf("xxh32(spammish) = %08x", xxh32([]byte("Nobody inspects the spammish repetition"))))
+	}
+}
+
+// ---------------------------------------------------------------------------
+// The block format.
+
+// decodeBlock decodes an LZ4 block as the format defines it, with limit as the
+// size of the destination. compliant reports whether the block also follows
+// the encoder-side restrictions (the last five bytes are literals and the last
+// match starts at least twelve bytes before the end; blocks under thirteen
+// bytes are all literals), which a decoder may insist on.
+func decodeBlock(src, dict []byte, limit int) (out []byte, compliant bool, err error) {
+	out = make([]byte, 0, min(limit, 1<<20))
+	si := 0
+	lastMatchStart := -1
+	finalLit := 0
+	readLen := func(base int) (int, error) {
+		l := base
+		for {
+			if si >= len(src) {
+				return 0, errors.New("block: truncated length")
+			}
+			x := int(src[si])
+			si++
+			l += x
+			if l > 1<<30 {
+				return 0, errors.New("block: length overflow")
+			}
+			if x != 0xFF {
+				return l, nil
+			}
+		}
+	}
+	if len(src) == 0 {
+		return nil, false, errors.New("block: empty")
+	}
+	for {
+		if si >= len(src) {
+			// The block ends right after a match: the format wants a final
+			// literal sequence, but decoders may accept it.
+			return out, false, nil
+		}
+		token := src[si]
+		si++
+		lLen := int(token >> 4)
+		if lLen == 15 {
+			if lLen, err = readLen(15); err != nil {
+				return nil, false, err
+			}
+		}
+		if si+lLen > len(src) {
+			return nil, false, errors.New("block: truncated literals")
+		}
+		if len(out)+lLen > limit {
+			return nil, false, errors.New("block: output too large")
+		}
+		out = append(out, src[si:si+lLen]...)
+		si += lLen
+		if si == len(src) {
+			// The last sequence: literals only (a match nibble here is not compliant).
+			finalLit = lLen
+			if token&0xF != 0 {
+				lastMatchStart = len(out) // forces compliant = false below
+				finalLit = 0
+			}
+			break
+		}
+		if si+2 > len(src) {
+			return nil, false, errors.New("block: truncated offset")
+		}
+		off := int(binary.LittleEndian.Uint16(src[si:]))
+		si += 2
+		if off == 0 {
+			return nil, false, errors.New("block: zero offset")
+		}
+		if off > len(out)+len(dict) {
+			return nil, false, errors.New("block: offset before the start")
+		}
+		mLen := int(token&0xF) + 4
+		if token&0xF == 15 {
+			if mLen, err = readLen(19); err != nil {
+				return nil, false, err
+			}
+		}
+		if len(out)+mLen > limit {
+			return nil, false, errors.New("block: output too large")
+		}
+		lastMatchStart = len(out)
+		for k := 0; k < mLen; k++ {
+			p := len(out) - off
+			if p < 0 {
+				out = append(out, dict[len(dict)+p])
+			} else {
+				out = append(out, out[p])
+			}
+		}
+	}
+	if lastMatchStart < 0 {
+		compliant = true
+	} else {
+		compliant = finalLit >= 5 && lastMatchStart <= len(out)-12
+	}
+	return out, compliant, nil
+}
+
+// A sequence of the block format: literals then a match (off = 0: no match,
+// only the final literals).
+type seq struct {
+	lit  []byte
+	off  int
+	mLen int
+}
+
+func encodeSeqs(seqs []seq) []byte {
+	var b []byte
+	putLen := func(l int) {
+		for l >= 255 {
+			b = append(b, 255)
+			l -= 255
+		}
+		b = append(b, byte(l))
+	}
+	for _, s := range seqs {
+		lLen := len(s.lit)
+		token := byte(min(lLen, 15) << 4)
+		if s.off > 0 {
+			token |= byte(min(s.mLen-4, 15))
+		}
+		b = append(b, token)
+		if lLen >= 15 {
+			putLen(lLen - 15)
+		}
+		b = append(b, s.lit...)
+		if s.off > 0 {
+			b = binary.LittleEndian.AppendUint16(b, uint16(s.off))
+			if s.mLen-4 >= 15 {
+				putLen(s.mLen - 19)
+			}
+		}
+	}
+	return b
+}
+
+func expandSeqs(seqs []seq, dict []byte) []byte {
+	var out []byte
+	for _, s := range seqs {
+		out = append(out, s.lit...)
+		for k := 0; k < s.mLen && s.off > 0; k++ {
+			p := len(out) - s.off
+			if p < 0 {
+				out = append(out, dict[len(dict)+p])
+			} else {
+				out = append(out, out[p])
+			}
+		}
+	}
+	return out
+}
+
+// fillBytes renders k bytes from the drawn fill, cycled, through an alphabet
+// of the given size (0: any byte).
+func fillBytes(fill []byte, k, alphabet int) []byte {
+	b := make([]byte, k)
+	if len(fill) == 0 {
+		return b
+	}
+	for i := range b {
+		x := fill[i%len(fill)]
+		if alphabet > 0 {
+			x = byte('a' + int(x)%alphabet)
+		}
+		b[i] = x
+	}
+	return b
+}
+
+// A block of the format is drawn as sequences (literal length and fill,
+// offset, match length) and rendered by blockSpec.build, which clamps them to
+// the room available and adds the final literals the encoder restrictions want.
+type seqSpec struct {
+	lit      int    // literal length
+	fill     []byte // literal bytes, cycled through the alphabet
+	offKind  int    // 0: 1; 1: small; 2: the very start; 3, 4: anywhere
+	offParam int
+	mLen     int
+}
+
+type blockSpec struct {
+	alphabet  int // 0: any byte, else 'a'..'a'+alphabet-1
+	seqs      []seqSpec
+	extra     int    // literals beyond the compliant minimum after a final match
+	finalOnly int    // the literals of a block that ends without a match
+	tail      []byte // fill for the final literals
+}
+
+func (b blockSpec) GoString() string {
+	return fmt.Sprintf("block{alphabet %d, %d seqs, extra %d, finalOnly %d}", b.alphabet, len(b.seqs), b.extra, b.finalOnly)
+}
+
+var (
+	litLens = weighted(
+		choice[int]{1, hegel.Just(0)}, choice[int]{1, hegel.Just(1)}, choice[int]{1, hegel.Integers(1, 14)},
+		choice[int]{1, hegel.Just(15)}, choice[int]{1, hegel.Integers(16, 40)}, choice[int]{1, hegel.Just(269)},
+		choice[int]{1, hegel.Just(270)}, choice[int]{1, hegel.Just(271)}, choice[int]{1, hegel.Integers(272, 700)})
+	matchLens = weighted(
+		choice[int]{1, hegel.Just(4)}, choice[int]{1, hegel.Just(5)}, choice[int]{1, hegel.Integers(4, 18)},
+		choice[int]{1, hegel.Just(19)}, choice[int]{1, hegel.Just(20)}, choice[int]{1, hegel.Integers(21, 300)},
+		choice[int]{1, hegel.Just(274)}, choice[int]{1, hegel.Just(275)}, choice[int]{1, hegel.Integers(300, 3000)})
+	seqSpecs = hegel.Composite(func(tc hegel.TestCase) seqSpec {
+		return seqSpec{
+			lit:      hegel.Draw(tc, litLens),
+			fill:     hegel.Draw(tc, hegel.Binary(1, 32)),
+			offKind:  hegel.Draw(tc, hegel.Integers(0, 4)),
+			offParam: hegel.Draw(tc, hegel.Integers(0, 65534)),
+			mLen:     hegel.Draw(tc, matchLens),
+		}
+	})
+	seqCounts = weighted(
+		choice[int]{1, hegel.Just(0)}, choice[int]{2, hegel.Just(1)}, choice[int]{1, hegel.Just(2)}, choice[int]{1, hegel.Just(3)},
+		choice[int]{1, hegel.Integers(4, 12)}, choice[int]{1, hegel.Integers(10, 60)})
+	extraLits = weighted(
+		choice[int]{2, hegel.Just(0)}, choice[int]{1, hegel.Just(1)}, choice[int]{1, hegel.Integers(0, 20)}, choice[int]{1, hegel.Integers(0, 300)})
+	finalOnlyLits = weighted(
+		choice[int]{1, hegel.Just(0)}, choice[int]{1, hegel.Just(1)}, choice[int]{1, hegel.Integers(0, 12)},
+		choice[int]{1, hegel.Integers(13, 100)}, choice[int]{1, hegel.Integers(15, 600)})
+	blockSpecs = hegel.Composite(func(tc hegel.TestCase) blockSpec {
+		return blockSpec{
+			alphabet:  hegel.Draw(tc, pick(0, 0, 2, 4, 26)),
+			seqs:      hegel.Draw(tc, exactly(seqCounts, seqSpecs)),
+			extra:     hegel.Draw(tc, extraLits),
+			finalOnly: hegel.Draw(tc, finalOnlyLits),
+			tail:      hegel.Draw(tc, hegel.Binary(1, 32)),
+		}
+	})
+)
+
+// build renders a compliant block of the format (with matches into dict,
+// when given) and returns its bytes and the data it encodes.
+func (b blockSpec) build(dict []byte, maxOut int) (blk, out []byte) {
+	var seqs []seq
+	outLen := 0
+	for _, s := range b.seqs {
+		lLen := s.lit
+		if outLen+lLen+4 > maxOut {
+			break
+		}
+		lit := fillBytes(s.fill, lLen, b.alphabet)
+		outLen += lLen
+		avail := outLen + len(dict)
+		if avail == 0 {
+			// Nothing to match yet (and a literal-only sequence may only be the last one).
+			outLen -= lLen
+			continue
+		}
+		var off int
+		switch s.offKind {
+		case 0:
+			off = 1
+		case 1:
+			off = min(avail, 1+s.offParam%8)
+		case 2:
+			off = min(avail, 65535) // the very start (of the dictionary when there is one)
+		default:
+			off = 1 + s.offParam%min(avail, 65535)
+		}
+		mLen := s.mLen
+		if outLen+mLen > maxOut-12 {
+			mLen = min(mLen, maxOut-12-outLen)
+		}
+		if mLen < 4 {
+			seqs = append(seqs, seq{lit: lit})
+			break
+		}
+		seqs = append(seqs, seq{lit: lit, off: off, mLen: mLen})
+		outLen += mLen
+	}
+	// The final literals: enough for the encoder restrictions (five literals
+	// after the last match, which starts twelve or more bytes before the end).
+	// The loop leaves twelve bytes of room after a match and adds a
+	// literal-only sequence only when its literals fit, so need <= room.
+	room := maxOut - outLen
+	var need, final int
+	switch k := len(seqs); {
+	case k > 0 && seqs[k-1].off > 0:
+		need = max(5, 12-seqs[k-1].mLen)
+		final = need + b.extra
+	case k >= 2:
+		// The last sequence is literals only, after the match before it.
+		lit := len(seqs[k-1].lit)
+		need = max(0, 5-lit, 12-seqs[k-2].mLen-lit)
+		final = max(need, b.finalOnly)
+	default:
+		final = b.finalOnly
+	}
+	final = max(need, min(final, room))
+	if len(seqs) == 0 || seqs[len(seqs)-1].off > 0 {
+		seqs = append(seqs, seq{lit: fillBytes(b.tail, final, b.alphabet)})
+	} else {
+		seqs[len(seqs)-1].lit = append(seqs[len(seqs)-1].lit, fillBytes(b.tail, final, b.alphabet)...)
+	}
+	out = expandSeqs(seqs, dict)
+	blk = encodeSeqs(seqs)
+	if got, comp, err := decodeBlock(blk, dict, len(out)); err != nil || !bytes.Equal(got, out) || !comp {
+		panic(fmt.Sprintf("harness: generated block does not decode: %v compliant=%v", err, comp))
+	}
+	return blk, out
+}
+
+// Compressible data is drawn as a total length and a few pieces (words, byte
+// runs, small alphabets, repeats of earlier data at offsets up to and beyond
+// the 64 KiB window, noise) cycled until the total is reached.
+type piece struct {
+	kind  int // 0 word, 1 run, 2 alphabet, 3 repeat, 4 noise
+	word  string
+	b     byte
+	len   int
+	alpha int
+	off   int
+	bytes []byte
+}
+
+func (p piece) render(b []byte) []byte {
+	switch p.kind {
+	case 0:
+		return append(b, p.word...)
+	case 1:
+		return append(b, bytes.Repeat([]byte{p.b}, p.len)...)
+	case 2:
+		return append(b, fillBytes(p.bytes, p.len, p.alpha)...)
+	case 3:
+		if len(b) == 0 {
+			for k := 0; k < 8; k++ {
+				b = append(b, p.b+byte(k))
+			}
+			return b
+		}
+		off := 1 + p.off%min(len(b), 70000)
+		for k := 0; k < p.len; k++ {
+			b = append(b, b[len(b)-off])
+		}
+		return b
+	default:
+		return append(b, p.bytes...)
+	}
+}
+
+var words = []string{"the ", "lz4 ", "block ", "frame ", "format ", "is ", "simple ", "\n", "0123456789", "compression "}
+
+var pieces = weighted(
+	choice[piece]{2, hegel.Map(hegel.SampledFrom(words), func(w string) piece { return piece{kind: 0, word: w} })},
+	choice[piece]{1, hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{kind: 1, b: byte(hegel.Draw(tc, hegel.Integers(0, 255))), len: hegel.Draw(tc, hegel.Integers(1, 300))}
+	})},
+	choice[piece]{1, hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{kind: 2, len: hegel.Draw(tc, hegel.Integers(1, 200)), alpha: hegel.Draw(tc, hegel.Integers(2, 4)), bytes: hegel.Draw(tc, hegel.Binary(1, 32))}
+	})},
+	choice[piece]{2, hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{kind: 3, b: byte(hegel.Draw(tc, hegel.Integers(0, 255))), off: hegel.Draw(tc, hegel.Integers(0, 69999)), len: hegel.Draw(tc, hegel.Integers(4, 503))}
+	})},
+	choice[piece]{1, hegel.Map(hegel.Binary(1, 64), func(b []byte) piece { return piece{kind: 4, bytes: b} })},
+)
+
+// contents draws compressible data of up to maxLen bytes (maxLen >= 5000).
+func contents(maxLen int) hegel.Generator[[]byte] {
+	total := weighted(
+		choice[int]{1, hegel.Just(0)}, choice[int]{1, hegel.Integers(1, 20)}, choice[int]{1, hegel.Integers(1, 300)},
+		choice[int]{1, hegel.Integers(300, 5000)}, choice[int]{1, hegel.Integers(5000, maxLen)}, choice[int]{1, hegel.Integers(1, maxLen)})
+	return hegel.Composite(func(tc hegel.TestCase) []byte {
+		n := hegel.Draw(tc, total)
+		ps := hegel.Draw(tc, many(pieces, 1, 8))
+		b := make([]byte, 0, n)
+		for i := 0; len(b) < n; i++ {
+			b = ps[i%len(ps)].render(b)
+		}
+		return b[:n]
+	})
+}
+
+// ---------------------------------------------------------------------------
+// The frame format.
+
+const (
+	frameMagic     = 0x184D2204
+	legacyMagic    = 0x184C2102
+	skippableMagic = 0x184D2A50
+)
+
+var blockMax = map[int]int{4: 64 << 10, 5: 256 << 10, 6: 1 << 20, 7: 4 << 20}
+
+type specBlock struct {
+	payload []byte // compressed block, or the data itself when raw
+	raw     bool
+	out     []byte
+}
+
+// frameSpec is a frame as the builder writes it and the parser reads it.
+type frameSpec struct {
+	legacy    bool
+	skippable bool // a skippable frame of len(skip) bytes
+	skip      []byte
+	bsIdx     int // 4..7
+	indep     bool
+	bsum      bool
+	csize     bool
+	csum      bool
+	blocks    []specBlock
+	content   []byte
+	// Read by the parser only.
+	contentSize  uint64
+	nonCompliant bool // a block breaks the encoder restrictions (decoders may reject it)
+}
+
+func (f *frameSpec) build() []byte {
+	var b []byte
+	if f.skippable {
+		b = binary.LittleEndian.AppendUint32(b, skippableMagic)
+		b = binary.LittleEndian.AppendUint32(b, uint32(len(f.skip)))
+		return append(b, f.skip...)
+	}
+	if f.legacy {
+		b = binary.LittleEndian.AppendUint32(b, legacyMagic)
+		for _, blk := range f.blocks {
+			b = binary.LittleEndian.AppendUint32(b, uint32(len(blk.payload)))
+			b = append(b, blk.payload...)
+		}
+		return b
+	}
+	b = binary.LittleEndian.AppendUint32(b, frameMagic)
+	flg := byte(1 << 6)
+	if f.indep {
+		flg |= 1 << 5
+	}
+	if f.bsum {
+		flg |= 1 << 4
+	}
+	if f.csize {
+		flg |= 1 << 3
+	}
+	if f.csum {
+		flg |= 1 << 2
+	}
+	hdr := []byte{flg, byte(f.bsIdx << 4)}
+	if f.csize {
+		hdr = binary.LittleEndian.AppendUint64(hdr, uint64(len(f.content)))
+	}
+	b = append(b, hdr...)
+	b = append(b, byte(xxh32(hdr)>>8))
+	for _, blk := range f.blocks {
+		sz := uint32(len(blk.payload))
+		if blk.raw {
+			sz |= 1 << 31
+		}
+		b = binary.LittleEndian.AppendUint32(b, sz)
+		b = append(b, blk.payload...)
+		if f.bsum {
+			b = binary.LittleEndian.AppendUint32(b, xxh32(blk.payload))
+		}
+	}
+	b = append(b, 0, 0, 0, 0)
+	if f.csum {
+		b = binary.LittleEndian.AppendUint32(b, xxh32(f.content))
+	}
+	return b
+}
+
+func (f *frameSpec) String() string {
+	switch {
+	case f.skippable:
+		return fmt.Sprintf("skippable(%d)", len(f.skip))
+	case f.legacy:
+		return fmt.Sprintf("spec{legacy blocks=%d content=%d}", len(f.blocks), len(f.content))
+	}
+	return fmt.Sprintf("spec{bs=%d indep=%v bsum=%v csize=%v csum=%v blocks=%d content=%d}", f.bsIdx, f.indep, f.bsum, f.csize, f.csum, len(f.blocks), len(f.content))
+}
+
+type specError struct {
+	kind string // magic, truncated, version, reserved, block-size-index, header-checksum, block-size, block-checksum, block-format, content-checksum, content-size
+	msg  string
+}
+
+func (e *specError) Error() string { return "spec: " + e.kind + ": " + e.msg }
+
+func specErr(kind, format string, args ...any) *specError {
+	return &specError{kind: kind, msg: fmt.Sprintf(format, args...)}
+}
+
+func isMagic(x uint32) bool {
+	return x == frameMagic || x == legacyMagic || x>>4 == skippableMagic>>4
+}
+
+// parseFrames parses a sequence of frames strictly by the specification and
+// returns them with the concatenated content.
+func parseFrames(data []byte) ([]frameSpec, []byte, *specError) {
+	var frames []frameSpec
+	var content []byte
+	pos := 0
+	u32 := func() (uint32, bool) {
+		if pos+4 > len(data) {
+			return 0, false
+		}
+		x := binary.LittleEndian.Uint32(data[pos:])
+		pos += 4
+		return x, true
+	}
+	for pos < len(data) {
+		magic, ok := u32()
+		if !ok {
+			return nil, nil, specErr("truncated", "%d trailing bytes", len(data)-pos+4)
+		}
+		switch {
+		case magic>>4 == skippableMagic>>4:
+			size, ok := u32()
+			if !ok || pos+int(size) > len(data) {
+				return nil, nil, specErr("truncated", "skippable frame")
+			}
+			frames = append(frames, frameSpec{skippable: true, skip: data[pos : pos+int(size)]})
+			pos += int(size)
+		case magic == legacyMagic:
+			f := frameSpec{legacy: true, bsIdx: 3}
+			for pos < len(data) {
+				if pos+4 <= len(data) && isMagic(binary.LittleEndian.Uint32(data[pos:])) {
+					break
+				}
+				size, ok := u32()
+				if !ok {
+					return nil, nil, specErr("truncated", "legacy block size")
+				}
+				if int(size) > lz4.CompressBlockBound(8<<20) {
+					return nil, nil, specErr("block-size", "legacy block of %d bytes", size)
+				}
+				if pos+int(size) > len(data) {
+					return nil, nil, specErr("truncated", "legacy block")
+				}
+				payload := data[pos : pos+int(size)]
+				pos += int(size)
+				out, compliant, err := decodeBlock(payload, nil, 8<<20)
+				if err != nil {
+					return nil, nil, specErr("block-format", "%v", err)
+				}
+				f.nonCompliant = f.nonCompliant || !compliant
+				f.blocks = append(f.blocks, specBlock{payload: payload, out: out})
+				f.content = append(f.content, out...)
+			}
+			content = append(content, f.content...)
+			frames = append(frames, f)
+		case magic == frameMagic:
+			if pos+3 > len(data) {
+				return nil, nil, specErr("truncated", "frame descriptor")
+			}
+			flg, bd := data[pos], data[pos+1]
+			f := frameSpec{bsIdx: int(bd>>4) & 7, indep: flg&(1<<5) != 0, bsum: flg&(1<<4) != 0, csize: flg&(1<<3) != 0, csum: flg&(1<<2) != 0}
+			hdrLen := 2
+			if f.csize {
+				hdrLen += 8
+			}
+			if flg&1 != 0 {
+				hdrLen += 4 // dictionary id
+			}
+			if pos+hdrLen+1 > len(data) {
+				return nil, nil, specErr("truncated", "frame descriptor")
+			}
+			hdr := data[pos : pos+hdrLen]
+			hc := data[pos+hdrLen]
+			if byte(xxh32(hdr)>>8) != hc {
+				return nil, nil, specErr("header-checksum", "got %02x want %02x", hc, byte(xxh32(hdr)>>8))
+			}
+			if flg>>6 != 1 {
+				return nil, nil, specErr("version", "%d", flg>>6)
+			}
+			if flg&2 != 0 || bd&0x8F != 0 {
+				return nil, nil, specErr("reserved", "flg %02x bd %02x", flg, bd)
+			}
+			if f.bsIdx < 4 || f.bsIdx > 7 {
+				return nil, nil, specErr("block-size-index", "%d", f.bsIdx)
+			}
+			if f.csize {
+				f.contentSize = binary.LittleEndian.Uint64(hdr[2:])
+			}
+			pos += hdrLen + 1
+			for {
+				x, ok := u32()
+				if !ok {
+					return nil, nil, specErr("truncated", "block size")
+				}
+				if x == 0 {
+					break
+				}
+				size := int(x & 0x7FFFFFFF)
+				raw := x>>31 != 0
+				if size > blockMax[f.bsIdx] {
+					return nil, nil, specErr("block-size", "%d > %d", size, blockMax[f.bsIdx])
+				}
+				if pos+size > len(data) {
+					return nil, nil, specErr("truncated", "block data")
+				}
+				payload := data[pos : pos+size]
+				pos += size
+				if f.bsum {
+					sum, ok := u32()
+					if !ok {
+						return nil, nil, specErr("truncated", "block checksum")
+					}
+					if sum != xxh32(payload) {
+						return nil, nil, specErr("block-checksum", "got %08x want %08x", sum, xxh32(payload))
+					}
+				}
+				var out []byte
+				if raw {
+					out = payload
+				} else {
+					var dict []byte
+					if !f.indep {
+						dict = f.content
+						if len(dict) > 64<<10 {
+							dict = dict[len(dict)-64<<10:]
+						}
+					}
+					var err error
+					var compliant bool
+					out, compliant, err = decodeBlock(payload, dict, blockMax[f.bsIdx])
+					if err != nil {
+						return nil, nil, specErr("block-format", "%v", err)
+					}
+					f.nonCompliant = f.nonCompliant || !compliant
+				}
+				f.blocks = append(f.blocks, specBlock{payload: payload, raw: raw, out: out})
+				f.content = append(f.content, out...)
+			}
+			if f.csum {
+				sum, ok := u32()
+				if !ok {
+					return nil, nil, specErr("truncated", "content checksum")
+				}
+				if sum != xxh32(f.content) {
+					return nil, nil, specErr("content-checksum", "got %08x want %08x", sum, xxh32(f.content))
+				}
+			}
+			if f.csize && f.contentSize != uint64(len(f.content)) {
+				return nil, nil, specErr("content-size", "header says %d, content is %d", f.contentSize, len(f.content))
+			}
+			content = append(content, f.content...)
+			frames = append(frames, f)
+		default:
+			return nil, nil, specErr("magic", "%08x", magic)
+		}
+	}
+	return frames, content, nil
+}
+
+// A frame of the specification is drawn as flags and a list of blocks (raw
+// bytes, or a block of the format, dependent on the earlier ones or not) and
+// rendered by frameGen.render.
+type blockGen struct {
+	raw      bool
+	rawBytes []byte
+	rawAlpha int // 0: any byte, 3: three letters
+	spec     blockSpec
+}
+
+type frameGen struct {
+	legacy                   bool
+	bsIdx                    int
+	indep, bsum, csize, csum bool
+	blocks                   []blockGen
+}
+
+func (g frameGen) GoString() string {
+	return fmt.Sprintf("frame{legacy %v, bs %d, indep %v, bsum %v, csize %v, csum %v, %d blocks}", g.legacy, g.bsIdx, g.indep, g.bsum, g.csize, g.csum, len(g.blocks))
+}
+
+var (
+	blockGens = weighted(
+		choice[blockGen]{3, hegel.Composite(func(tc hegel.TestCase) blockGen {
+			return blockGen{raw: true, rawBytes: hegel.Draw(tc, hegel.Binary(1, 3000)), rawAlpha: hegel.Draw(tc, pick(0, 0, 3))}
+		})},
+		choice[blockGen]{7, hegel.Map(blockSpecs, func(b blockSpec) blockGen { return blockGen{spec: b} })},
+	)
+	blockCounts = weighted(
+		choice[int]{1, hegel.Just(0)}, choice[int]{2, hegel.Just(1)}, choice[int]{1, hegel.Just(2)}, choice[int]{1, hegel.Integers(2, 5)})
+	frameGens = frameGensWith(exactly(blockCounts, blockGens))
+)
+
+// frameGensWith draws a frame's flags with its blocks from the given generator.
+func frameGensWith(blocks hegel.Generator[[]blockGen]) hegel.Generator[frameGen] {
+	return hegel.Composite(func(tc hegel.TestCase) frameGen {
+		return frameGen{
+			legacy: hegel.Draw(tc, chance(12)),
+			bsIdx:  hegel.Draw(tc, hegel.Integers(4, 7)),
+			indep:  hegel.Draw(tc, chance(60)),
+			bsum:   hegel.Draw(tc, chance(40)),
+			csize:  hegel.Draw(tc, chance(40)),
+			csum:   hegel.Draw(tc, chance(60)),
+			blocks: hegel.Draw(tc, blocks),
+		}
+	})
+}
+
+// render builds the frame: legacy only when allowed, and with independent
+// blocks when forced.
+func (g frameGen) render(allowLegacy, forceIndep bool) frameSpec {
+	f := frameSpec{bsIdx: g.bsIdx, indep: forceIndep || g.indep, bsum: g.bsum, csize: g.csize, csum: g.csum}
+	if allowLegacy && g.legacy {
+		f = frameSpec{legacy: true, bsIdx: 3, indep: true}
+	}
+	for _, bg := range g.blocks {
+		maxOut := min(blockMax[f.bsIdx], 30000)
+		if f.legacy {
+			maxOut = 30000
+		}
+		var blk specBlock
+		if bg.raw && !f.legacy {
+			blk.raw = true
+			blk.out = fillBytes(bg.rawBytes, len(bg.rawBytes), bg.rawAlpha)
+			blk.payload = blk.out
+		} else {
+			var dict []byte
+			if !f.indep && !f.legacy {
+				dict = f.content
+				if len(dict) > 64<<10 {
+					dict = dict[len(dict)-64<<10:]
+				}
+			}
+			blk.payload, blk.out = bg.spec.build(dict, maxOut)
+			if len(blk.out) == 0 {
+				// A block of no data has no place in a frame (size 0 is the end mark).
+				continue
+			}
+			if f.legacy && Known.legacyCumulativeStop && len(blk.payload) == len(f.content) {
+				continue
+			}
+		}
+		f.blocks = append(f.blocks, blk)
+		f.content = append(f.content, blk.out...)
+	}
+	return f
+}
+
+// ---------------------------------------------------------------------------
+// The reference implementation.
+
+var lz4Path = func() string {
+	p, err := exec.LookPath("lz4")
+	if err != nil {
+		return ""
+	}
+	return p
+}()
+
+// cli runs lz4 with stdin and returns stdout.
+func cli(in []byte, args ...string) ([]byte, error) {
+	cmd := exec.Command(lz4Path, args...)
+	cmd.Stdin = bytes.NewReader(in)
+	var out, errb bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &out, &errb
+	if err := cmd.Run(); err != nil {
+		return out.Bytes(), fmt.Errorf("lz4 %s: %v: %s", strings.Join(args, " "), err, bytes.TrimSpace(errb.Bytes()))
+	}
+	return out.Bytes(), nil
+}
+
+// cliCompressFile compresses through files, so that --content-size is known.
+func cliCompressFile(ht *hegel.T, content []byte, args ...string) []byte {
+	dir, err := os.MkdirTemp("", "hegel-lz4")
+	if err != nil {
+		fail(ht, "tempdir: %v", err)
+	}
+	defer os.RemoveAll(dir)
+	in := filepath.Join(dir, "in")
+	out := filepath.Join(dir, "out.lz4")
+	if err := os.WriteFile(in, content, 0o600); err != nil {
+		fail(ht, "write: %v", err)
+	}
+	all := append([]string{"-q", "-f"}, args...)
+	all = append(all, in, out)
+	cmd := exec.Command(lz4Path, all...)
+	var errb bytes.Buffer
+	cmd.Stderr = &errb
+	if err := cmd.Run(); err != nil {
+		fail(ht, "lz4 %s: %v: %s", strings.Join(all, " "), err, errb.Bytes())
+	}
+	b, err := os.ReadFile(out)
+	if err != nil {
+		fail(ht, "read: %v", err)
+	}
+	return b
+}
+
+func cliDecode(data []byte) ([]byte, error) { return cli(data, "-d", "-q", "-c") }
+
+// blockFrame wraps a raw block in a minimal frame so that the reference tool
+// can decode it.
+func blockFrame(blk []byte, outLen int) []byte {
+	idx := 4
+	for idx < 7 && outLen > blockMax[idx] {
+		idx++
+	}
+	f := frameSpec{bsIdx: idx, indep: true, blocks: []specBlock{{payload: blk}}}
+	return f.build()
+}
+
+// The reference tool's compression arguments.
+type cliSpec struct {
+	level       string
+	block       string // "", -B4..-B7, or -B<bytes>
+	bd, bx      bool
+	noCRC       bool
+	csize       bool
+	legacy      bool
+	legacyLevel string
+}
+
+func (c cliSpec) GoString() string {
+	args, _ := c.args(true)
+	return "lz4 " + strings.Join(args, " ")
+}
+
+// args renders the arguments (--content-size only when compressing a file)
+// and reports whether they ask for a legacy frame.
+func (c cliSpec) args(hasFile bool) ([]string, bool) {
+	if c.legacy {
+		return []string{"-l", c.legacyLevel}, true
+	}
+	args := []string{c.level}
+	if c.block != "" {
+		args = append(args, c.block)
+	}
+	if c.bd {
+		args = append(args, "-BD")
+	}
+	if c.bx {
+		args = append(args, "-BX")
+	}
+	if c.noCRC {
+		args = append(args, "--no-frame-crc")
+	}
+	if hasFile && c.csize {
+		args = append(args, "--content-size")
+	}
+	return args, false
+}
+
+var cliSpecs = hegel.Composite(func(tc hegel.TestCase) cliSpec {
+	return cliSpec{
+		level: hegel.Draw(tc, pick("-1", "-1", "-3", "-6", "-9", "-12", "--fast=5")),
+		block: hegel.Draw(tc, weighted(
+			choice[string]{2, hegel.Just("")},
+			choice[string]{1, pick("-B4", "-B5", "-B6", "-B7")},
+			choice[string]{1, hegel.Map(hegel.Integers(32, 5000), func(k int) string { return fmt.Sprintf("-B%d", k) })})),
+		bd:          hegel.Draw(tc, chance(30)),
+		bx:          hegel.Draw(tc, chance(30)),
+		noCRC:       hegel.Draw(tc, chance(40)),
+		csize:       hegel.Draw(tc, chance(40)),
+		legacy:      hegel.Draw(tc, chance(10)),
+		legacyLevel: hegel.Draw(tc, pick("-1", "-9")),
+	}
+})
