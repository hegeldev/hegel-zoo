+// ---------------------------------------------------------------------------
+// Property 3: the Writer's frames.
+
+type writerOpts struct {
+	bs     lz4.BlockSize
+	bsum   bool
+	csum   bool
+	csize  bool
+	level  lz4.CompressionLevel
+	conc   int
+	legacy bool
+}
+
+func (o writerOpts) options(size int) []lz4.Option {
+	return append(o.plainOptions(size), lz4.ConcurrencyOption(o.conc))
+}
+
+// plainOptions are the options without ConcurrencyOption (which the
+// CompressingReader does not take).
+func (o writerOpts) plainOptions(size int) []lz4.Option {
+	opts := []lz4.Option{lz4.BlockSizeOption(o.bs), lz4.BlockChecksumOption(o.bsum), lz4.ChecksumOption(o.csum), lz4.CompressionLevelOption(o.level)}
+	if o.csize {
+		opts = append(opts, lz4.SizeOption(uint64(size)))
+	}
+	if o.legacy {
+		opts = append(opts, lz4.LegacyOption(true))
+	}
+	return opts
+}
+
+func (o writerOpts) String() string {
+	return fmt.Sprintf("bs=%s bsum=%v csum=%v csize=%v level=%s conc=%d legacy=%v", o.bs, o.bsum, o.csum, o.csize, o.level, o.conc, o.legacy)
+}
+
+func (o writerOpts) GoString() string { return o.String() }
+
+var (
+	concurrencies = pick(1, 1, 1, 2, 3)
+	noLegacy      = hegel.Just(false)
+)
+
+// writerOptions draws the Writer's options, with the legacy flag and the
+// concurrency from the given generators.
+func writerOptions(legacy hegel.Generator[bool], conc hegel.Generator[int]) hegel.Generator[writerOpts] {
+	return hegel.Composite(func(tc hegel.TestCase) writerOpts {
+		return writerOpts{
+			bs:     hegel.Draw(tc, pick(lz4.Block64Kb, lz4.Block64Kb, lz4.Block256Kb, lz4.Block1Mb, lz4.Block4Mb)),
+			bsum:   hegel.Draw(tc, chance(40)),
+			csum:   hegel.Draw(tc, chance(60)),
+			csize:  hegel.Draw(tc, chance(40)),
+			level:  hegel.Draw(tc, pick(lz4.Fast, lz4.Fast, lz4.Level1, lz4.Level2, lz4.Level3, lz4.Level4, lz4.Level5, lz4.Level6, lz4.Level7, lz4.Level8, lz4.Level9)),
+			conc:   hegel.Draw(tc, conc),
+			legacy: hegel.Draw(tc, legacy),
+		}
+	})
+}
+
+func bsIndex(bs lz4.BlockSize) int {
+	switch bs {
+	case lz4.Block64Kb:
+		return 4
+	case lz4.Block256Kb:
+		return 5
+	case lz4.Block1Mb:
+		return 6
+	}
+	return 7
+}
+
+// A chunk of the "chunks" write patterns: a size (clamped to what is left)
+// and whether to Flush after it.
+type chunk struct {
+	size  int
+	flush bool
+}
+
+type writerCase struct {
+	content  []byte
+	opts     writerOpts
+	pattern  string
+	chunks   []chunk
+	cut      int // "mixed": where Write stops and ReadFrom takes over
+	readMode int
+	readConc int
+	sizes    []int
+}
+
+func (c writerCase) GoString() string {
+	return fmt.Sprintf("%d bytes, %s, %s (%d chunks), read mode %d conc %d sizes %v", len(c.content), c.opts, c.pattern, len(c.chunks), c.readMode, c.readConc, c.sizes)
+}
+
+var (
+	chunks = hegel.Composite(func(tc hegel.TestCase) chunk {
+		return chunk{
+			size:  hegel.Draw(tc, weighted(choice[int]{1, hegel.Just(1)}, choice[int]{1, hegel.Integers(1, 100)}, choice[int]{1, hegel.Integers(1, 70000)}, choice[int]{1, hegel.Integers(1, 300000)})),
+			flush: hegel.Draw(tc, chance(50)),
+		}
+	})
+	writerCases = hegel.Composite(func(tc hegel.TestCase) writerCase {
+		return writerCase{
+			content:  hegel.Draw(tc, contents(300000)),
+			opts:     hegel.Draw(tc, writerOptions(chance(10), concurrencies)),
+			pattern:  hegel.Draw(tc, pick("write", "write", "chunks", "chunks+flush", "readfrom", "mixed")),
+			chunks:   hegel.Draw(tc, many(chunks, 1, 30)),
+			cut:      hegel.Draw(tc, positions),
+			readMode: hegel.Draw(tc, readModes),
+			readConc: hegel.Draw(tc, pick(1, 1, 2, 4)),
+			sizes:    hegel.Draw(tc, sizeLists),
+		}
+	})
+)
+
+func TestHegelWriterFramesFollowTheSpec(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, writerCases)
+		content, o, pattern := tc.content, tc.opts, tc.pattern
+		if Known.readFromNotFirst && pattern == "mixed" {
+			pattern = "readfrom"
+		}
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		var calls []int
+		var callsMu sync.Mutex
+		opts := append(o.options(len(content)), lz4.OnBlockDoneOption(func(k int) {
+			time.Sleep(5 * time.Millisecond) // a handler that does some work
+			callsMu.Lock()
+			calls = append(calls, k)
+			callsMu.Unlock()
+		}))
+		if err := w.Apply(opts...); err != nil {
+			fail(ht, "Apply(%s): %v", o, err)
+		}
+		note(ht, "%d bytes, %s, %s", len(content), o, pattern)
+		write := func(b []byte) {
+			k, err := w.Write(b)
+			if err != nil || k != len(b) {
+				fail(ht, "Write(%d) = %d, %v", len(b), k, err)
+			}
+		}
+		switch pattern {
+		case "write":
+			write(content)
+		case "chunks", "chunks+flush":
+			for pos, i := 0, 0; pos < len(content); i++ {
+				c := tc.chunks[i%len(tc.chunks)]
+				k := min(len(content)-pos, c.size)
+				write(content[pos : pos+k])
+				pos += k
+				if pattern == "chunks+flush" && c.flush {
+					if err := w.Flush(); err != nil {
+						fail(ht, "Flush: %v", err)
+					}
+				}
+			}
+		case "readfrom":
+			k, err := w.ReadFrom(bytes.NewReader(content))
+			if err != nil || k != int64(len(content)) {
+				fail(ht, "ReadFrom = %d, %v", k, err)
+			}
+		default:
+			cut := at(tc.cut, len(content)+1)
+			write(content[:cut])
+			k, err := w.ReadFrom(bytes.NewReader(content[cut:]))
+			if err != nil || k != int64(len(content)-cut) {
+				fail(ht, "ReadFrom after Write = %d, %v (the shape of lz4/8)", k, err)
+			}
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		// The handler calls completed when Close returned.
+		callsMu.Lock()
+		atClose := append([]int{}, calls...)
+		callsMu.Unlock()
+		if err := w.Close(); err != nil {
+			fail(ht, "second Close: %v", err)
+		}
+		data := buf.Bytes()
+		frames, got, perr := parseFrames(data)
+		if perr != nil {
+			fail(ht, "the Writer's %d bytes do not parse by the specification: %v", len(data), perr)
+		}
+		if len(frames) != 1 {
+			fail(ht, "the Writer wrote %d frames", len(frames))
+		}
+		f := frames[0]
+		if !bytes.Equal(got, content) {
+			fail(ht, "the frame's content is %d bytes, want %d", len(got), len(content))
+		}
+		if f.legacy != o.legacy {
+			fail(ht, "legacy frame %v, want %v", f.legacy, o.legacy)
+		}
+		if !o.legacy {
+			if f.bsIdx != bsIndex(o.bs) || f.bsum != o.bsum || f.csum != o.csum || !f.indep {
+				fail(ht, "frame flags bs=%d bsum=%v csum=%v indep=%v for %s", f.bsIdx, f.bsum, f.csum, f.indep, o)
+			}
+			wantSize := o.csize && len(content) > 0
+			if f.csize != wantSize || (f.csize && f.contentSize != uint64(len(content))) {
+				fail(ht, "content size flag %v (%d), want %v (%d)", f.csize, f.contentSize, wantSize, len(content))
+			}
+			maxBlock := int(o.bs)
+			for i, b := range f.blocks {
+				if len(b.out) > maxBlock {
+					fail(ht, "block %d holds %d bytes, above the %d limit", i, len(b.out), maxBlock)
+				}
+				if len(b.payload) > len(b.out) {
+					fail(ht, "block %d is %d bytes for %d bytes of data (stored blocks must be used when compression does not help)", i, len(b.payload), len(b.out))
+				}
+			}
+			if pattern != "chunks+flush" {
+				want := (len(content) + maxBlock - 1) / maxBlock
+				if len(f.blocks) != want {
+					fail(ht, "%d blocks for %d bytes with %d-byte blocks, want %d", len(f.blocks), len(content), maxBlock, want)
+				}
+			}
+			// The handler: once per block, with the block's size as written,
+			// completed by the time Close returns.
+			if !(Known.readFromHandlerTwice && (pattern == "readfrom" || pattern == "mixed")) && !(Known.handlerAfterClose && o.conc > 1) {
+				sizes := []int{}
+				for _, b := range f.blocks {
+					sizes = append(sizes, len(b.payload))
+				}
+				sort.Ints(sizes)
+				sort.Ints(atClose)
+				if fmt.Sprint(atClose) != fmt.Sprint(sizes) {
+					fail(ht, "OnBlockDone calls completed at Close %v, blocks written %v (%s, concurrency %d: the shapes of lz4/2 and lz4/10)", atClose, sizes, pattern, o.conc)
+				}
+			}
+		}
+		// The reference decodes it.
+		if ref, err := cliDecode(data); err != nil || !bytes.Equal(ref, content) {
+			fail(ht, "the reference lz4 does not decode the Writer's frame: %v (%d bytes back, want %d)", err, len(ref), len(content))
+		}
+		// The library reads it back (lz4/7: unless a legacy block's size equals the content before it).
+		coincidence := false
+		if f.legacy {
+			cum := 0
+			for _, b := range f.blocks {
+				if len(b.payload) == cum {
+					coincidence = true
+				}
+				cum += len(b.out)
+			}
+		}
+		if !(Known.legacyCumulativeStop && coincidence) {
+			res := readFrames(ht, data, tc.readMode, tc.readConc, tc.sizes)
+			if res.err != nil || !bytes.Equal(res.out, content) {
+				fail(ht, "the Reader does not read the Writer's frame: %v (%d bytes, want %d; legacy size coincidence %v, the shape of lz4/7)", res.err, len(res.out), len(content), coincidence)
+			}
+		}
+		if ok, err := lz4.ValidFrameHeader(data[:min(len(data), 15)]); !ok || err != nil {
+			fail(ht, "ValidFrameHeader of the Writer's frame: %v, %v", ok, err)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 4: the Reader on frames of the specification and of the reference.
+
+// An entry of the stream the Reader gets: a skippable frame, a frame of the
+// specification, or the reference tool's frame of some content.
+type readerEntry struct {
+	kind    int // 0 skippable, 1 spec, 2 reference
+	skip    []byte
+	frame   frameGen
+	cli     cliSpec
+	content []byte
+}
+
+func (e readerEntry) GoString() string {
+	switch e.kind {
+	case 0:
+		return fmt.Sprintf("skippable(%d)", len(e.skip))
+	case 1:
+		return fmt.Sprintf("%#v", e.frame)
+	}
+	return fmt.Sprintf("%#v (%d bytes)", e.cli, len(e.content))
+}
+
+type readerCase struct {
+	entries []readerEntry
+	mode    int
+	conc    int
+	sizes   []int
+}
+
+func (c readerCase) GoString() string {
+	return fmt.Sprintf("%#v, mode %d, concurrency %d, sizes %v", c.entries, c.mode, c.conc, c.sizes)
+}
+
+var (
+	readerEntries = weighted(
+		choice[readerEntry]{15, hegel.Map(hegel.Binary(0, 50), func(b []byte) readerEntry { return readerEntry{kind: 0, skip: b} })},
+		choice[readerEntry]{43, hegel.Map(frameGens, func(f frameGen) readerEntry { return readerEntry{kind: 1, frame: f} })},
+		choice[readerEntry]{42, hegel.Composite(func(tc hegel.TestCase) readerEntry {
+			return readerEntry{kind: 2, cli: hegel.Draw(tc, cliSpecs), content: hegel.Draw(tc, contents(200000))}
+		})},
+	)
+	entryCounts = weighted(choice[int]{3, hegel.Just(1)}, choice[int]{1, hegel.Just(2)}, choice[int]{1, hegel.Just(3)})
+	readerCases = hegel.Composite(func(tc hegel.TestCase) readerCase {
+		return readerCase{
+			entries: hegel.Draw(tc, exactly(entryCounts, readerEntries)),
+			mode:    hegel.Draw(tc, readModes),
+			conc:    hegel.Draw(tc, pick(1, 1, 2, 4)),
+			sizes:   hegel.Draw(tc, sizeLists),
+		}
+	})
+)
+
+func TestHegelReaderAcceptsSpecAndReferenceFrames(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, readerCases)
+		mode, conc := tc.mode, tc.conc
+		var data, content []byte
+		var desc []string
+		singleSized := false
+		lastLegacy := false
+		// The lz4/11 gate (HEGEL_NO_KNOWN=1): WriteTo's buffer is sized by the
+		// first frame when the Reader runs non-concurrently (concurrency 1, or
+		// a first frame with dependent blocks or legacy, which turns
+		// concurrency off for good), and is missing altogether when a later
+		// frame turns concurrency off.
+		firstIdx := 0 // block size index of the first frame (legacy: 8)
+		firstDep := false
+		gate := Known.writeToDropsFrames && mode == 1
+		capIdx := func(idx int) int {
+			if gate && (conc == 1 || firstDep) && firstIdx > 0 && idx > firstIdx {
+				return firstIdx
+			}
+			return idx
+		}
+		for _, e := range tc.entries {
+			if Known.legacyThenOther && lastLegacy {
+				break
+			}
+			switch e.kind {
+			case 0:
+				f := frameSpec{skippable: true, skip: e.skip}
+				data = append(data, f.build()...)
+				desc = append(desc, f.String())
+			case 1:
+				forceIndep := gate && conc > 1 && !firstDep && firstIdx > 0
+				f := e.frame.render(capIdx(8) == 8 && !forceIndep, forceIndep)
+				if !f.legacy {
+					f.bsIdx = capIdx(f.bsIdx)
+				}
+				if firstIdx == 0 {
+					firstIdx = f.bsIdx
+					if f.legacy {
+						firstIdx = 8
+					}
+					firstDep = f.legacy || !f.indep
+				}
+				data = append(data, f.build()...)
+				content = append(content, f.content...)
+				desc = append(desc, f.String())
+				singleSized = len(tc.entries) == 1 && f.csize && len(f.content) > 0
+				lastLegacy = f.legacy
+			default:
+				c := e.content
+				args, legacy := e.cli.args(true)
+				if gate && conc > 1 && !firstDep && firstIdx > 0 {
+					var kept []string
+					for _, a := range args {
+						if a != "-BD" && a != "-l" {
+							kept = append(kept, a)
+						}
+					}
+					args = kept
+					legacy = false
+				}
+				if firstIdx > 0 && capIdx(8) < 8 {
+					// lz4/11: keep later frames within the first frame's block size.
+					var kept []string
+					for _, a := range args {
+						if a != "-l" && !strings.HasPrefix(a, "-B") {
+							kept = append(kept, a)
+						}
+					}
+					args = append(kept, fmt.Sprintf("-B%d", firstIdx))
+					legacy = false
+				}
+				lastLegacy = legacy
+				fr := cliCompressFile(ht, c, args...)
+				if firstIdx == 0 {
+					// The first frame's flags as the tool actually wrote them (an
+					// empty input, for one, comes out with independent blocks).
+					fs, _, perr := parseFrames(fr)
+					if perr != nil || len(fs) == 0 {
+						fail(ht, "harness: the specification parser fails on the tool's frame (lz4 %s): %v", strings.Join(args, " "), perr)
+					}
+					firstIdx = fs[0].bsIdx
+					if fs[0].legacy {
+						firstIdx = 8
+					}
+					firstDep = fs[0].legacy || !fs[0].indep
+				}
+				data = append(data, fr...)
+				content = append(content, c...)
+				desc = append(desc, fmt.Sprintf("lz4 %s (%d bytes)", strings.Join(args, " "), len(c)))
+				singleSized = len(tc.entries) == 1 && e.cli.csize && !legacy && len(c) > 0 // a legacy frame carries no size
+			}
+		}
+		if Known.writeToEOFOnEmpty && mode == 1 && firstIdx == 0 {
+			mode = 2 // no real frame in the stream: WriteTo would return io.EOF
+		}
+		note(ht, "%s (mode %d, concurrency %d)", strings.Join(desc, " + "), mode, conc)
+		// The specification parser accepts everything here (a check of the parser on the reference's output).
+		if _, got, err := parseFrames(data); err != nil || !bytes.Equal(got, content) {
+			fail(ht, "harness: the specification parser fails on %s: %v", strings.Join(desc, " + "), err)
+		}
+		res := readFrames(ht, data, mode, conc, tc.sizes)
+		if res.err != nil {
+			fail(ht, "the Reader fails on %s (mode %d): %v (a legacy frame followed by another is the shape of lz4/9, WriteTo on no real frame that of lz4/12)", strings.Join(desc, " + "), mode, res.err)
+		}
+		if !bytes.Equal(res.out, content) {
+			fail(ht, "the Reader returns %d bytes for %s (mode %d, concurrency %d), want %d (WriteTo dropping a later frame of a bigger block size is the shape of lz4/11)", len(res.out), strings.Join(desc, " + "), mode, conc, len(content))
+		}
+		if mode == 0 && singleSized && res.size != len(content) && !(Known.sizeLostAtEnd && res.firstN >= len(content)) {
+			fail(ht, "Reader.Size = %d after the first Read of %d bytes, the frame says %d (Size after the end of the frame is the shape of lz4/14)", res.size, res.firstN, len(content))
+		}
+		if mode == 1 {
+			// WriteTo: the handler is called once per block with the uncompressed size.
+			sum := 0
+			for _, k := range res.handler {
+				sum += k
+			}
+			if sum != len(content) {
+				fail(ht, "OnBlockDone calls in WriteTo sum to %d, content is %d", sum, len(content))
+			}
+		}
+		if len(data) >= 7 && !strings.HasPrefix(desc[0], "skippable") {
+			if ok, err := lz4.ValidFrameHeader(data[:min(len(data), 15)]); !ok || err != nil {
+				fail(ht, "ValidFrameHeader on %s: %v, %v", desc[0], ok, err)
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 5: damaged frames.
+
+type corruptCase struct {
+	fromWriter bool
+	frame      frameGen
+	content    []byte
+	opts       writerOpts
+	edits      []edit
+	mode       int
+	conc       int
+	sizes      []int
+}
+
+func (c corruptCase) GoString() string {
+	src := fmt.Sprintf("%#v", c.frame)
+	if c.fromWriter {
+		src = fmt.Sprintf("writer{%s, %d bytes}", c.opts, len(c.content))
+	}
+	return fmt.Sprintf("%s, edits %v, mode %d, concurrency %d, sizes %v", src, c.edits, c.mode, c.conc, c.sizes)
+}
+
+var corruptCases = hegel.Composite(func(tc hegel.TestCase) corruptCase {
+	return corruptCase{
+		fromWriter: hegel.Draw(tc, chance(50)),
+		frame:      hegel.Draw(tc, frameGens),
+		content:    hegel.Draw(tc, contents(50000)),
+		opts:       hegel.Draw(tc, writerOptions(noLegacy, concurrencies)),
+		edits:      hegel.Draw(tc, frameEdits),
+		mode:       hegel.Draw(tc, readModes),
+		conc:       hegel.Draw(tc, pick(1, 1, 2)),
+		sizes:      hegel.Draw(tc, sizeLists),
+	}
+})
+
+func TestHegelCorruptFramesAreRejected(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, corruptCases)
+		var data []byte
+		if tc.fromWriter {
+			c, o := tc.content, tc.opts
+			var buf bytes.Buffer
+			w := lz4.NewWriter(&buf)
+			if err := w.Apply(o.options(len(c))...); err != nil {
+				fail(ht, "Apply: %v", err)
+			}
+			w.Write(c)
+			w.Close()
+			data = buf.Bytes()
+			note(ht, "writer frame %s content=%d", o, len(c))
+		} else {
+			f := tc.frame.render(false, false)
+			data = f.build()
+			note(ht, "%s", f.String())
+		}
+		m := applyEdits(tc.edits, data)
+		note(ht, "%d bytes mutated to %d", len(data), len(m))
+		frames, want, werr := parseFrames(m)
+		// candidate/go/lz4-15: the library takes any magic number 0x184D2A00
+		// to 0x184D2AFF for a skippable frame (frame.go: m>>8 ==
+		// frameSkipMagic>>8), the format only 0x184D2A50 to 0x184D2A5F.
+		if werr != nil && werr.kind == "magic" && len(m) >= 4 {
+			magic := binary.LittleEndian.Uint32(m)
+			ht.Assume(magic>>8 != skippableMagic>>8)
+		}
+		mode := tc.mode
+		if Known.writeToEOFOnEmpty && mode == 1 && len(m) == 0 {
+			mode = 2 // lz4/12
+		}
+		res := readFrames(ht, m, mode, tc.conc, tc.sizes)
+		if res.err != nil && strings.HasPrefix(res.err.Error(), "PANIC") {
+			fail(ht, "the Reader panicked on damaged bytes %x: %v", m, res.err)
+		}
+		if werr == nil {
+			// Still a frame of the specification (a block breaking the encoder
+			// restrictions may be refused).
+			refusable := false
+			for _, f := range frames {
+				refusable = refusable || f.nonCompliant
+			}
+			if !(refusable && res.err != nil) && (res.err != nil || !bytes.Equal(res.out, want)) {
+				fail(ht, "the Reader rejects damaged bytes that are still a valid frame: %v (%d bytes, want %d; mode %d) %x (WriteTo on empty bytes is the shape of lz4/12)", res.err, len(res.out), len(want), mode, m)
+			}
+			return
+		}
+		// What the library may accept: nothing the specification rejects.
+		// The recorded bugs lz4/4, lz4/5 and lz4/6 are exactly such
+		// acceptances; HEGEL_NO_KNOWN=1 leaves those kinds unchecked.
+		checkRejected := true
+		switch werr.kind {
+		case "version", "reserved":
+			checkRejected = !Known.acceptsBadVersion
+		case "content-size":
+			checkRejected = !Known.ignoresContentSize
+		case "truncated":
+			checkRejected = !Known.acceptsMissingEndMark
+		case "block-format":
+			// The library may be stricter than the format, never more lenient.
+			if res.err == nil {
+				fail(ht, "the Reader accepts a frame whose block the format rejects (%v): %x", werr, m)
+			}
+			return
+		}
+		if checkRejected && res.err == nil {
+			fail(ht, "the Reader accepts damaged bytes the specification rejects (%v): %d bytes out, %x (version/reserved: the shape of lz4/4; content-size: lz4/5; truncated: lz4/6)", werr, len(res.out), m)
+		}
+		if res.err == nil {
+			return
+		}
+		// The named errors.
+		switch werr.kind {
+		case "header-checksum":
+			if !errors.Is(res.err, lz4.ErrInvalidHeaderChecksum) && !isEOF(res.err) {
+				fail(ht, "header damage gives %v, want ErrInvalidHeaderChecksum", res.err)
+			}
+		case "block-checksum":
+			if !errors.Is(res.err, lz4.ErrInvalidBlockChecksum) && !errors.Is(res.err, lz4.ErrInvalidSourceShortBuffer) && !isEOF(res.err) {
+				fail(ht, "block checksum damage gives %v, want ErrInvalidBlockChecksum", res.err)
+			}
+		case "content-checksum":
+			if !errors.Is(res.err, lz4.ErrInvalidFrameChecksum) && !isEOF(res.err) {
+				fail(ht, "content checksum damage gives %v, want ErrInvalidFrameChecksum", res.err)
+			}
+		case "magic":
+			if !errors.Is(res.err, lz4.ErrInvalidFrame) && !isEOF(res.err) {
+				fail(ht, "a bad magic number gives %v, want ErrInvalidFrame", res.err)
+			}
+		}
+	})
+}
+
+func isEOF(err error) bool { return errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) }
+
+// ---------------------------------------------------------------------------
+// Property 6: CompressingReader against the Writer.
+
+type closeRecorder struct {
+	io.Reader
+	closed int
+}
+
+func (c *closeRecorder) Close() error { c.closed++; return nil }
+
+type compressingReaderCase struct {
+	content []byte
+	opts    writerOpts
+	sizes   []int
+}
+
+func (c compressingReaderCase) GoString() string {
+	return fmt.Sprintf("%d bytes, %s, sizes %v", len(c.content), c.opts, c.sizes)
+}
+
+var compressingReaderCases = hegel.Composite(func(tc hegel.TestCase) compressingReaderCase {
+	return compressingReaderCase{
+		content: hegel.Draw(tc, contents(300000)),
+		opts:    hegel.Draw(tc, writerOptions(noLegacy, hegel.Just(1))),
+		sizes:   hegel.Draw(tc, sizeLists),
+	}
+})
+
+func TestHegelCompressingReaderMatchesTheWriter(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, compressingReaderCases)
+		content, o := tc.content, tc.opts
+		note(ht, "%d bytes, %s", len(content), o)
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		if err := w.Apply(o.options(len(content))...); err != nil {
+			fail(ht, "Writer.Apply: %v", err)
+		}
+		w.Write(content)
+		w.Close()
+		src := &closeRecorder{Reader: bytes.NewReader(content)}
+		cr := lz4.NewCompressingReader(src)
+		var calls []int
+		opts := append(o.plainOptions(len(content)), lz4.OnBlockDoneOption(func(k int) { calls = append(calls, k) }))
+		if err := cr.Apply(opts...); err != nil {
+			fail(ht, "CompressingReader.Apply: %v", err)
+		}
+		if cr.Source() != src {
+			fail(ht, "Source() is not the source")
+		}
+		sizes := tc.sizes
+		var got []byte
+		p := make([]byte, 1<<17)
+		for i := 0; ; i++ {
+			k := sizes[i%len(sizes)]
+			m, err := cr.Read(p[:k])
+			got = append(got, p[:m]...)
+			if err == io.EOF {
+				break
+			}
+			if err != nil {
+				fail(ht, "CompressingReader.Read: %v", err)
+			}
+			if m == 0 && k > 0 && i > 1000000 {
+				fail(ht, "CompressingReader.Read returns 0 bytes without end")
+			}
+		}
+		if !bytes.Equal(got, buf.Bytes()) {
+			fail(ht, "CompressingReader gives %d bytes, the Writer %d for the same options", len(got), buf.Len())
+		}
+		frames, back, err := parseFrames(got)
+		if err != nil || len(frames) != 1 || !bytes.Equal(back, content) {
+			fail(ht, "CompressingReader's frame: %v, %d frames, %d bytes", err, len(frames), len(back))
+		}
+		if len(calls) != len(frames[0].blocks) {
+			fail(ht, "OnBlockDone called %d times for %d blocks", len(calls), len(frames[0].blocks))
+		}
+		if err := cr.Close(); err != nil || src.closed != 1 {
+			fail(ht, "Close: %v, source closed %d times", err, src.closed)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 7: options and states.
+
+type optionsCase struct {
+	content []byte
+	opts    writerOpts
+	oddSize int // an invalid (odd) block size
+	level   int // an invalid compression level
+}
+
+func (c optionsCase) GoString() string {
+	return fmt.Sprintf("%d bytes, %s, odd size %d, level %d", len(c.content), c.opts, c.oddSize, c.level)
+}
+
+var optionsCases = hegel.Composite(func(tc hegel.TestCase) optionsCase {
+	return optionsCase{
+		content: hegel.Draw(tc, contents(20000)),
+		opts:    hegel.Draw(tc, writerOptions(chance(10), concurrencies)),
+		oddSize: hegel.Draw(tc, hegel.Map(hegel.Integers(1, 1<<20), func(x int) int { return x | 1 })),
+		level:   hegel.Draw(tc, hegel.Integers(1, 255)),
+	}
+})
+
+func TestHegelOptionsAndStatesFollowTheContract(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, optionsCases)
+		content, o := tc.content, tc.opts
+		note(ht, "%d bytes, %s", len(content), o)
+		// Option.String.
+		for _, c := range []struct{ got, want string }{
+			{lz4.BlockSizeOption(o.bs).String(), fmt.Sprintf("BlockSizeOption(%s)", o.bs)},
+			{lz4.BlockChecksumOption(o.bsum).String(), fmt.Sprintf("BlockChecksumOption(%v)", o.bsum)},
+			{lz4.ChecksumOption(o.csum).String(), fmt.Sprintf("ChecksumOption(%v)", o.csum)},
+			{lz4.SizeOption(uint64(len(content))).String(), fmt.Sprintf("SizeOption(%d)", len(content))},
+			{lz4.ConcurrencyOption(o.conc).String(), fmt.Sprintf("ConcurrencyOption(%d)", o.conc)},
+			{lz4.CompressionLevelOption(o.level).String(), fmt.Sprintf("CompressionLevelOption(%s)", o.level)},
+			{lz4.LegacyOption(o.legacy).String(), fmt.Sprintf("LegacyOption(%v)", o.legacy)},
+		} {
+			if c.got != c.want {
+				fail(ht, "Option.String() = %q, want %q", c.got, c.want)
+			}
+		}
+		// Invalid options.
+		// (A failed Apply leaves the Writer in its error state for good, as the
+		// ErrOptionClosedOrError documentation implies: fresh Writers here.)
+		if err := lz4.NewWriter(io.Discard).Apply(lz4.BlockSizeOption(lz4.BlockSize(tc.oddSize))); !errors.Is(err, lz4.ErrOptionInvalidBlockSize) {
+			fail(ht, "an odd block size gives %v, want ErrOptionInvalidBlockSize", err)
+		}
+		if err := lz4.NewWriter(io.Discard).Apply(lz4.CompressionLevelOption(lz4.CompressionLevel(tc.level))); !errors.Is(err, lz4.ErrOptionInvalidCompressionLevel) {
+			fail(ht, "a level below Level1 gives %v, want ErrOptionInvalidCompressionLevel", err)
+		}
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		rd := lz4.NewReader(bytes.NewReader(nil))
+		for _, opt := range []lz4.Option{lz4.BlockSizeOption(o.bs), lz4.ChecksumOption(true), lz4.SizeOption(3), lz4.CompressionLevelOption(lz4.Level1), lz4.LegacyOption(true), lz4.BlockChecksumOption(true)} {
+			if err := rd.Apply(opt); !errors.Is(err, lz4.ErrOptionNotApplicable) {
+				fail(ht, "Reader.Apply(%s) = %v, want ErrOptionNotApplicable", opt, err)
+			}
+		}
+		if err := w.Apply(lz4.ConcurrencyOption(o.conc), lz4.LegacyOption(o.legacy)); err != nil {
+			fail(ht, "Apply: %v", err)
+		}
+		// States.
+		if _, err := w.Write(content[:min(len(content), 10)]); err != nil {
+			fail(ht, "Write: %v", err)
+		}
+		// An Apply after the first Write is refused and, by the contract, the
+		// Writer goes on (lz4/13: it does not; HEGEL_NO_KNOWN=1 tests the
+		// refusal on a Writer of its own).
+		late := w
+		if Known.failedApplyPoisons {
+			late = lz4.NewWriter(io.Discard)
+			late.Write([]byte("x"))
+		}
+		if err := late.Apply(lz4.ChecksumOption(false)); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+			fail(ht, "Apply after Write = %v, want ErrOptionClosedOrError", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close after a refused Apply: %v (the shape of lz4/13)", err)
+		}
+		if _, err := w.Write([]byte{1}); !errors.Is(err, lz4.ErrWriterClosed) {
+			fail(ht, "Write after Close = %v, want ErrWriterClosed", err)
+		}
+		if _, err := w.ReadFrom(bytes.NewReader([]byte{1})); !errors.Is(err, lz4.ErrWriterClosed) {
+			fail(ht, "ReadFrom after Close = %v, want ErrWriterClosed", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "second Close: %v", err)
+		}
+		// Reset keeps the options and writes a fresh frame.
+		var buf2 bytes.Buffer
+		w2 := lz4.NewWriter(&buf2)
+		o2 := o
+		o2.legacy = false
+		if Known.sizeLostOnApply {
+			o2.csize = false
+		}
+		if err := w2.Apply(o2.options(len(content))...); err != nil {
+			fail(ht, "Apply: %v", err)
+		}
+		w2.Write(content)
+		w2.Close()
+		first := append([]byte{}, buf2.Bytes()...)
+		var buf3 bytes.Buffer
+		w2.Reset(&buf3)
+		w2.Write(content)
+		if err := w2.Close(); err != nil {
+			fail(ht, "Close after Reset: %v", err)
+		}
+		if !bytes.Equal(first, buf3.Bytes()) {
+			fail(ht, "the frame after Reset differs from the first (%d vs %d bytes; headers %x / %x; a kept size flag with a zeroed size is the shape of lz4/1)", len(first), buf3.Len(), first[:min(15, len(first))], buf3.Bytes()[:min(15, buf3.Len())])
+		}
+		// Reader states.
+		rd2 := lz4.NewReader(bytes.NewReader(first))
+		if s := rd2.Size(); s != 0 {
+			fail(ht, "Size before reading = %d", s)
+		}
+		one := make([]byte, 1)
+		if _, err := rd2.Read(one); err != nil && err != io.EOF {
+			fail(ht, "Read: %v", err)
+		}
+		if err := rd2.Apply(lz4.ConcurrencyOption(2)); !errors.Is(err, lz4.ErrOptionClosedOrError) && !(Known.failedApplyPoisons && len(content) == 0 && err != nil) {
+			fail(ht, "Reader.Apply after Read = %v, want ErrOptionClosedOrError (io.EOF after an empty frame is the shape of lz4/13)", err)
+		}
+		rd2.Reset(bytes.NewReader(first)) // (lz4/13: Reset is what clears the error state)
+		if err := rd2.Apply(lz4.ConcurrencyOption(o.conc)); err != nil {
+			fail(ht, "Reader.Apply after Reset: %v", err)
+		}
+		if got, err := io.ReadAll(rd2); err != nil || !bytes.Equal(got, content) {
+			fail(ht, "ReadAll after Reset: %v, %d bytes", err, len(got))
+		}
+		// Empty and short inputs.
+		for _, c := range []struct {
+			name string
+			in   []byte
+			want error
+		}{
+			{"empty", nil, io.EOF},
+			{"one byte", first[:1], io.ErrUnexpectedEOF},
+			{"magic only", first[:4], io.ErrUnexpectedEOF}, // lz4/6: a clean io.EOF
+			{"header cut", first[:min(len(first), 6)], io.ErrUnexpectedEOF},
+			{"garbage", []byte{1, 2, 3, 4, 5, 6, 7, 8}, lz4.ErrInvalidFrame},
+		} {
+			if Known.acceptsMissingEndMark && c.name == "magic only" {
+				continue
+			}
+			rd := lz4.NewReader(bytes.NewReader(c.in))
+			k, err := rd.Read(make([]byte, 10))
+			if k != 0 || !errors.Is(err, c.want) {
+				fail(ht, "Read on %s input: %d, %v, want 0, %v (a clean io.EOF on the magic alone is the shape of lz4/6)", c.name, k, err, c.want)
+			}
+		}
+	})
+}
