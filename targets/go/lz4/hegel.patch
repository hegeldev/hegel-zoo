diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..40e42d0
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,320 @@
+package lz4_test
+
+// Pins for the bugs in bugs.toml. Each asserts the correct behaviour and is listed as an
+// expected failure in target.toml: it fails while the bug exists and passes, unexpectedly,
+// once the bug is fixed (which is the signal to drop the Known switch and the entry).
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/pierrec/lz4/v4"
+)
+
+var pinData = bytes.Repeat([]byte("hello world, "), 20) // 260 bytes
+
+// pinBlock decodes to "abcdefghabcdefghijklm" (21 bytes).
+var (
+	pinBlock    = []byte{0x84, 'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 0x08, 0x00, 0x50, 'i', 'j', 'k', 'l', 'm'}
+	pinBlockOut = []byte("abcdefghabcdefghijklm")
+)
+
+func pinWrite(t *testing.T, content []byte, opts ...lz4.Option) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	if err := w.Apply(opts...); err != nil {
+		t.Fatalf("Apply: %v", err)
+	}
+	if _, err := w.Write(content); err != nil {
+		t.Fatalf("Write: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+	return buf.Bytes()
+}
+
+func pinReadAll(data []byte, opts ...lz4.Option) ([]byte, error) {
+	r := lz4.NewReader(bytes.NewReader(data))
+	if err := r.Apply(opts...); err != nil {
+		return nil, err
+	}
+	return io.ReadAll(r)
+}
+
+// lz4/1
+func TestHegelPinSizeOptionSurvivesApplyAndReset(t *testing.T) {
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	if err := w.Apply(lz4.SizeOption(uint64(len(pinData)))); err != nil {
+		t.Fatal(err)
+	}
+	if err := w.Apply(lz4.BlockSizeOption(lz4.Block64Kb)); err != nil {
+		t.Fatal(err)
+	}
+	w.Write(pinData)
+	w.Close()
+	frames, _, err := parseFrames(buf.Bytes())
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if f := frames[0]; !f.csize || f.contentSize != uint64(len(pinData)) {
+		t.Errorf("after two Applys the header has size flag %v and content size %d, want %d", f.csize, f.contentSize, len(pinData))
+	}
+	// Reset keeps the previous options.
+	var buf2 bytes.Buffer
+	w.Reset(&buf2)
+	w.Write(pinData)
+	w.Close()
+	frames, _, err = parseFrames(buf2.Bytes())
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	if f := frames[0]; !f.csize || f.contentSize != uint64(len(pinData)) {
+		t.Errorf("after Reset the header has size flag %v and content size %d, want %d", f.csize, f.contentSize, len(pinData))
+	}
+}
+
+// lz4/2
+func TestHegelPinReadFromCallsTheHandlerOncePerBlock(t *testing.T) {
+	var calls []int
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	w.Apply(lz4.BlockSizeOption(lz4.Block64Kb), lz4.OnBlockDoneOption(func(n int) { calls = append(calls, n) }))
+	if _, err := w.ReadFrom(bytes.NewReader(pinData)); err != nil {
+		t.Fatal(err)
+	}
+	w.Close()
+	if len(calls) != 1 {
+		t.Errorf("ReadFrom of one block called the handler %d times: %v", len(calls), calls)
+	}
+}
+
+// lz4/3
+func TestHegelPinReadCallsTheHandlerPerBlock(t *testing.T) {
+	data := pinWrite(t, pinData, lz4.BlockSizeOption(lz4.Block64Kb))
+	var calls []int
+	r := lz4.NewReader(bytes.NewReader(data))
+	r.Apply(lz4.OnBlockDoneOption(func(n int) { calls = append(calls, n) }))
+	p := make([]byte, 100)
+	for {
+		if _, err := r.Read(p); err != nil {
+			break
+		}
+	}
+	if len(calls) != 1 {
+		t.Errorf("reading one block with a 100-byte buffer called the handler %d times: %v (want once, with %d)", len(calls), calls, len(pinData))
+	}
+}
+
+// lz4/4
+func TestHegelPinReaderRejectsUnknownVersions(t *testing.T) {
+	f := frameSpec{bsIdx: 4, indep: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}}, content: pinBlockOut}
+	for _, c := range []struct {
+		name string
+		mod  func(b []byte)
+	}{
+		{"version 0", func(b []byte) { b[4] &^= 0xC0 }},
+		{"version 2", func(b []byte) { b[4] = b[4]&^0xC0 | 0x80 }},
+		{"reserved flag bit", func(b []byte) { b[4] |= 0x02 }},
+		{"reserved BD bit", func(b []byte) { b[5] |= 0x80 }},
+	} {
+		b := f.build()
+		c.mod(b)
+		b[6] = byte(xxh32(b[4:6]) >> 8) // a matching header checksum
+		if out, err := pinReadAll(b); err == nil {
+			t.Errorf("a frame with %s is accepted (%d bytes); the format says it cannot be decoded", c.name, len(out))
+		}
+	}
+}
+
+// lz4/5
+func TestHegelPinReaderChecksTheContentSize(t *testing.T) {
+	f := frameSpec{bsIdx: 4, indep: true, csize: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}}, content: pinBlockOut}
+	b := f.build()
+	b[6] = 5 // content size 5 instead of 21
+	for i := 7; i < 14; i++ {
+		b[i] = 0
+	}
+	b[14] = byte(xxh32(b[4:14]) >> 8)
+	if out, err := pinReadAll(b); err == nil {
+		t.Errorf("a frame declaring 5 bytes of content but holding %d is accepted", len(out))
+	}
+}
+
+// lz4/6
+func TestHegelPinTruncatedFrameIsAnError(t *testing.T) {
+	f := frameSpec{bsIdx: 4, indep: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}, {payload: pinBlock, out: pinBlockOut}}}
+	f.content = append(append([]byte{}, pinBlockOut...), pinBlockOut...)
+	data := f.build()
+	cut := data[:7+4+len(pinBlock)] // after the first block: no end mark, no second block
+	if out, err := pinReadAll(cut); err == nil {
+		t.Errorf("io.ReadAll on a frame cut after its first block: %d bytes, no error", len(out))
+	}
+	var buf bytes.Buffer
+	if _, err := lz4.NewReader(bytes.NewReader(cut)).WriteTo(&buf); err == nil {
+		t.Errorf("WriteTo on a frame cut after its first block: %d bytes, no error", buf.Len())
+	}
+	if out, err := pinReadAll(data[:4]); err == nil {
+		t.Errorf("io.ReadAll on the magic number alone: %d bytes, no error", len(out))
+	}
+}
+
+// lz4/7
+func TestHegelPinLegacyBlocksAreNotMistakenForTheSizeTrailer(t *testing.T) {
+	// Block A decodes to 21 bytes; block B's compressed size is 21 bytes (19 literals).
+	lit := bytes.Repeat([]byte{'z'}, 19)
+	blockB := append([]byte{0xF0, 0x04}, lit...)
+	f := frameSpec{legacy: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}, {payload: blockB, out: lit}}}
+	f.content = append(append([]byte{}, pinBlockOut...), lit...)
+	data := f.build()
+	if ref, err := cliDecode(data); err != nil || !bytes.Equal(ref, f.content) {
+		t.Fatalf("the reference does not decode the legacy frame: %v", err)
+	}
+	out, err := pinReadAll(data)
+	if err != nil || !bytes.Equal(out, f.content) {
+		t.Errorf("legacy frame with a 21-byte block after 21 bytes of content: %d bytes, %v; want %d bytes", len(out), err, len(f.content))
+	}
+}
+
+// lz4/8
+func TestHegelPinReadFromWorksAfterWrite(t *testing.T) {
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	if _, err := w.Write(pinData[:10]); err != nil {
+		t.Fatal(err)
+	}
+	if n, err := w.ReadFrom(bytes.NewReader(pinData[10:])); err != nil || n != int64(len(pinData)-10) {
+		t.Errorf("ReadFrom after Write: %d, %v", n, err)
+	}
+	if err := w.Close(); err != nil {
+		t.Errorf("Close: %v", err)
+	}
+	if _, out, err := parseFrames(buf.Bytes()); err != nil || !bytes.Equal(out, pinData) {
+		t.Errorf("the frame holds %d bytes (%v), want %d", len(out), err, len(pinData))
+	}
+}
+
+// lz4/9
+func TestHegelPinLegacyFrameMayBeFollowedByAStandardFrame(t *testing.T) {
+	leg := frameSpec{legacy: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}}, content: pinBlockOut}
+	std := frameSpec{bsIdx: 4, indep: true, csum: true, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}}, content: pinBlockOut}
+	data := append(leg.build(), std.build()...)
+	want := append(append([]byte{}, pinBlockOut...), pinBlockOut...)
+	if ref, err := cliDecode(data); err != nil || !bytes.Equal(ref, want) {
+		t.Fatalf("the reference does not decode legacy + standard: %v", err)
+	}
+	if out, err := pinReadAll(data); err != nil || !bytes.Equal(out, want) {
+		t.Errorf("legacy frame followed by a standard frame: %d bytes, %v; want %d", len(out), err, len(want))
+	}
+}
+
+// lz4/10
+func TestHegelPinHandlerCallsFinishBeforeClose(t *testing.T) {
+	var mu sync.Mutex
+	var calls []int
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	w.Apply(lz4.ConcurrencyOption(2), lz4.BlockSizeOption(lz4.Block64Kb), lz4.OnBlockDoneOption(func(n int) {
+		time.Sleep(20 * time.Millisecond) // a handler that does some work
+		mu.Lock()
+		calls = append(calls, n)
+		mu.Unlock()
+	}))
+	w.Write(bytes.Repeat(pinData, 300)) // two blocks
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	got := len(calls)
+	mu.Unlock()
+	if got != 2 {
+		t.Errorf("when Close returned, the handler had completed %d calls for 2 blocks", got)
+	}
+	time.Sleep(100 * time.Millisecond) // let the late calls finish before the test ends
+}
+
+// lz4/11
+func TestHegelPinWriteToReadsFramesOfGrowingBlockSize(t *testing.T) {
+	small := bytes.Repeat([]byte("abc"), 100)
+	big := bytes.Repeat([]byte("0123456789abcdef-"), 6000)
+	data := append(pinWrite(t, small, lz4.BlockSizeOption(lz4.Block64Kb)), pinWrite(t, big, lz4.BlockSizeOption(lz4.Block4Mb))...)
+	var buf bytes.Buffer
+	n, err := lz4.NewReader(bytes.NewReader(data)).WriteTo(&buf)
+	if err != nil || n != int64(len(small)+len(big)) {
+		t.Errorf("WriteTo over a 64 KiB-block frame then a 4 MiB-block frame: %d bytes, %v; want %d", n, err, len(small)+len(big))
+	}
+	// With concurrency, a later frame with dependent blocks.
+	dep := []byte{0x0c, 0x15, 0x00, 0x50, 'v', 'w', 'x', 'y', 'z'} // a match of 16 bytes at offset 21 into the previous block, then 5 literals
+	depOut := append(append([]byte{}, pinBlockOut[:16]...), "vwxyz"...)
+	f := frameSpec{bsIdx: 4, indep: false, blocks: []specBlock{{payload: pinBlock, out: pinBlockOut}, {payload: dep, out: depOut}}}
+	f.content = append(append([]byte{}, pinBlockOut...), depOut...)
+	data2 := append(pinWrite(t, small, lz4.BlockSizeOption(lz4.Block64Kb)), f.build()...)
+	r := lz4.NewReader(bytes.NewReader(data2))
+	r.Apply(lz4.ConcurrencyOption(4))
+	buf.Reset()
+	n, err = r.WriteTo(&buf)
+	if err != nil || n != int64(len(small)+len(f.content)) {
+		t.Errorf("WriteTo with concurrency over a frame then a dependent-blocks frame: %d bytes, %v; want %d", n, err, len(small)+len(f.content))
+	}
+}
+
+// lz4/12
+func TestHegelPinWriteToOnAnEmptyStreamIsNotAnError(t *testing.T) {
+	if n, err := io.Copy(io.Discard, lz4.NewReader(bytes.NewReader(nil))); err != nil || n != 0 {
+		t.Errorf("io.Copy from an empty stream: %d, %v", n, err)
+	}
+	skip := frameSpec{skippable: true, skip: []byte{1, 2, 3}}
+	if n, err := io.Copy(io.Discard, lz4.NewReader(bytes.NewReader(skip.build()))); err != nil || n != 0 {
+		t.Errorf("io.Copy from a skippable-only stream: %d, %v", n, err)
+	}
+}
+
+// lz4/13
+func TestHegelPinFailedApplyDoesNotPoisonTheWriter(t *testing.T) {
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	w.Write(pinData[:100])
+	if err := w.Apply(lz4.ChecksumOption(false)); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+		t.Fatalf("Apply after Write: %v", err)
+	}
+	if _, err := w.Write(pinData[100:]); err != nil {
+		t.Errorf("Write after a refused Apply: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		t.Errorf("Close after a refused Apply: %v", err)
+	}
+	if _, out, err := parseFrames(buf.Bytes()); err != nil || !bytes.Equal(out, pinData) {
+		t.Errorf("the frame holds %d bytes (%v), want %d", len(out), err, len(pinData))
+	}
+	data := pinWrite(t, pinData)
+	r := lz4.NewReader(bytes.NewReader(data))
+	one := make([]byte, 1)
+	if _, err := r.Read(one); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Apply(lz4.ConcurrencyOption(2)); !errors.Is(err, lz4.ErrOptionClosedOrError) {
+		t.Fatalf("Reader.Apply after Read: %v", err)
+	}
+	rest, err := io.ReadAll(r)
+	if err != nil || len(rest) != len(pinData)-1 {
+		t.Errorf("reading on after a refused Apply: %d bytes, %v; want %d", len(rest), err, len(pinData)-1)
+	}
+}
+
+// lz4/14
+func TestHegelPinSizeSurvivesTheEndOfTheFrame(t *testing.T) {
+	data := pinWrite(t, pinData, lz4.SizeOption(uint64(len(pinData))))
+	r := lz4.NewReader(bytes.NewReader(data))
+	if _, err := io.ReadAll(r); err != nil {
+		t.Fatal(err)
+	}
+	if got := r.Size(); got != len(pinData) {
+		t.Errorf("Size after reading the frame = %d, want %d", got, len(pinData))
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..b38d0af
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,1043 @@
+package lz4_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape
+// region with random contents, judged as the wide property that found the bug
+// judges (the frame parser of the specification, the handler calls against the
+// blocks written, the Reader's result against the frames' content, the errors
+// the documentation names), so that each bug has a property that finds it
+// every run and shrinks to a minimal example of it; the wide properties of
+// hegel_test.go reach the shapes at their natural rate. Under HEGEL_NO_KNOWN=1
+// the shapes are off and each of these properties is skipped (shapeOff), so
+// that the run looks past the known bugs.
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"slices"
+	"sort"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/pierrec/lz4/v4"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- shared pieces
+
+// shapeOff skips a narrow property under HEGEL_NO_KNOWN=1 (noKnown, hegel_test.go).
+func shapeOff(t *testing.T, id string) {
+	t.Helper()
+	if noKnown {
+		t.Skipf("the shape of %s is off under HEGEL_NO_KNOWN=1", id)
+	}
+}
+
+// atLeast draws content of at least n bytes: n random bytes, then contents.
+func atLeast(n int, g hegel.Generator[[]byte]) hegel.Generator[[]byte] {
+	return hegel.Composite(func(tc hegel.TestCase) []byte {
+		return append(hegel.Draw(tc, hegel.Binary(n, n)), hegel.Draw(tc, g)...)
+	})
+}
+
+// writerFrame is the Writer's frame of content, written in one Write.
+func writerFrame(ht *hegel.T, o writerOpts, content []byte) []byte {
+	var buf bytes.Buffer
+	w := lz4.NewWriter(&buf)
+	if err := w.Apply(o.options(len(content))...); err != nil {
+		fail(ht, "Apply(%s): %v", o, err)
+	}
+	if _, err := w.Write(content); err != nil {
+		fail(ht, "Write: %v", err)
+	}
+	if err := w.Close(); err != nil {
+		fail(ht, "Close: %v", err)
+	}
+	return buf.Bytes()
+}
+
+// parsedFrame is the one frame the Writer's bytes hold.
+func parsedFrame(ht *hegel.T, data []byte) frameSpec {
+	frames, _, err := parseFrames(data)
+	if err != nil || len(frames) != 1 {
+		fail(ht, "the Writer's %d bytes do not parse as one frame: %v (%d frames)", len(data), err, len(frames))
+	}
+	return frames[0]
+}
+
+// sortedSizes are the blocks' compressed (payload) or uncompressed sizes,
+// sorted for comparison with the OnBlockDone calls.
+func sortedSizes(blocks []specBlock, payload bool) []int {
+	sizes := []int{}
+	for _, b := range blocks {
+		if payload {
+			sizes = append(sizes, len(b.payload))
+		} else {
+			sizes = append(sizes, len(b.out))
+		}
+	}
+	sort.Ints(sizes)
+	return sizes
+}
+
+// legacyCoincidence reports a legacy block whose compressed size equals the
+// content before it (the shape of lz4/7).
+func legacyCoincidence(f frameSpec) bool {
+	cum := 0
+	for _, b := range f.blocks {
+		if len(b.payload) == cum {
+			return true
+		}
+		cum += len(b.out)
+	}
+	return false
+}
+
+// concat is the frames' bytes and their content.
+func concat(frames ...frameSpec) (data, content []byte) {
+	for _, f := range frames {
+		data = append(data, f.build()...)
+		content = append(content, f.content...)
+	}
+	return data, content
+}
+
+// --------------------------------------------------------------------------- lz4/1
+
+// sizeOptionCase: content and options with SizeOption, applied as SizeOption
+// first and the other options in a second Apply, or all in one Apply for a
+// frame that is followed by a Reset and a second frame (both documented to
+// keep the options).
+type sizeOptionCase struct {
+	content []byte
+	opts    writerOpts
+	reset   bool
+}
+
+func (c sizeOptionCase) GoString() string {
+	how := "SizeOption, then the other options in a second Apply"
+	if c.reset {
+		how = "one Apply, a frame, then Reset and a second frame"
+	}
+	return fmt.Sprintf("%d bytes, %s, %s", len(c.content), c.opts, how)
+}
+
+var sizeOptionCases = hegel.Composite(func(tc hegel.TestCase) sizeOptionCase {
+	o := hegel.Draw(tc, writerOptions(noLegacy, concurrencies))
+	o.csize = true
+	return sizeOptionCase{content: hegel.Draw(tc, atLeast(1, contents(70000))), opts: o, reset: hegel.Draw(tc, chance(50))}
+})
+
+// TestHegelSizeOptionSurvivesASecondApplyAndReset: the content size given by
+// SizeOption is in the header of every frame the Writer then writes, also when
+// the other options come in a second Apply and after a Reset; Apply and Reset
+// keep the size flag but zero the size, so the header says 0 bytes (lz4/1).
+func TestHegelSizeOptionSurvivesASecondApplyAndReset(t *testing.T) {
+	shapeOff(t, "lz4/1")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, sizeOptionCases)
+		n := len(c.content)
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		if c.reset {
+			if err := w.Apply(c.opts.options(n)...); err != nil {
+				fail(ht, "Apply(%s): %v", c.opts, err)
+			}
+			w.Write(c.content)
+			w.Close()
+			buf.Reset()
+			w.Reset(&buf)
+		} else {
+			if err := w.Apply(lz4.SizeOption(uint64(n))); err != nil {
+				fail(ht, "Apply(SizeOption(%d)): %v", n, err)
+			}
+			rest := c.opts
+			rest.csize = false
+			if err := w.Apply(rest.options(n)...); err != nil {
+				fail(ht, "second Apply(%s): %v", rest, err)
+			}
+		}
+		if _, err := w.Write(c.content); err != nil {
+			fail(ht, "Write: %v", err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		data := buf.Bytes()
+		note(ht, "header %x", data[:min(len(data), 15)])
+		frames, _, perr := parseFrames(data)
+		if perr != nil && perr.kind == "content-size" {
+			fail(ht, "the size flag is set and the %s (the size is lost)", perr.msg)
+		}
+		if perr != nil || len(frames) != 1 {
+			fail(ht, "the Writer's %d bytes do not parse as one frame: %v (%d frames)", len(data), perr, len(frames))
+		}
+		if f := frames[0]; !f.csize || f.contentSize != uint64(n) {
+			fail(ht, "the header has size flag %v and content size %d for %d bytes of content", f.csize, f.contentSize, n)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/2
+
+type readFromCase struct {
+	content []byte
+	opts    writerOpts
+}
+
+func (c readFromCase) GoString() string { return fmt.Sprintf("%d bytes, %s", len(c.content), c.opts) }
+
+// readFromCases: non-empty content read by a fresh, non-concurrent Writer's
+// ReadFrom (concurrency is the shape of lz4/10, a Write before it that of lz4/8).
+var readFromCases = hegel.Composite(func(tc hegel.TestCase) readFromCase {
+	return readFromCase{content: hegel.Draw(tc, atLeast(1, contents(300000))), opts: hegel.Draw(tc, writerOptions(noLegacy, hegel.Just(1)))}
+})
+
+// TestHegelReadFromCallsTheHandlerOncePerBlock: OnBlockDone is "triggered when
+// a block has been processed", so ReadFrom calls it once per block with the
+// compressed size, as Write does; ReadFrom calls it a second time per block
+// with the uncompressed size (lz4/2).
+func TestHegelReadFromCallsTheHandlerOncePerBlock(t *testing.T) {
+	shapeOff(t, "lz4/2")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, readFromCases)
+		var calls []int
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		opts := append(c.opts.options(len(c.content)), lz4.OnBlockDoneOption(func(k int) { calls = append(calls, k) }))
+		if err := w.Apply(opts...); err != nil {
+			fail(ht, "Apply(%s): %v", c.opts, err)
+		}
+		if k, err := w.ReadFrom(bytes.NewReader(c.content)); err != nil || k != int64(len(c.content)) {
+			fail(ht, "ReadFrom = %d, %v", k, err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		f := parsedFrame(ht, buf.Bytes())
+		sizes := sortedSizes(f.blocks, true)
+		sort.Ints(calls)
+		if !slices.Equal(calls, sizes) {
+			fail(ht, "ReadFrom called OnBlockDone with %v for blocks of %v bytes (once per block, with the compressed size, is the contract)", calls, sizes)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/3
+
+// readSizesCase: a frame read with a first buffer smaller than its first
+// block (so that a block takes more than one Read), then any sizes.
+type readSizesCase struct {
+	content []byte
+	opts    writerOpts
+	pos     int
+	more    []int
+}
+
+func (c readSizesCase) sizes() []int {
+	first := 1 + at(c.pos, min(len(c.content), int(c.opts.bs))-1)
+	return append([]int{first}, c.more...)
+}
+
+func (c readSizesCase) GoString() string {
+	return fmt.Sprintf("%d bytes, %s, Read sizes %v", len(c.content), c.opts, c.sizes())
+}
+
+var readSizesCases = hegel.Composite(func(tc hegel.TestCase) readSizesCase {
+	return readSizesCase{
+		content: hegel.Draw(tc, atLeast(2, contents(70000))),
+		opts:    hegel.Draw(tc, writerOptions(noLegacy, hegel.Just(1))),
+		pos:     hegel.Draw(tc, positions),
+		more:    hegel.Draw(tc, sizeLists),
+	}
+})
+
+// TestHegelReadCallsTheHandlerOncePerBlock: for a Reader OnBlockDone is
+// triggered "when it has been uncompressed", a block, so Read calls it once
+// per block with the block's size whatever the caller's buffers; Read calls it
+// after every copy into the buffer, with the bytes copied (lz4/3).
+func TestHegelReadCallsTheHandlerOncePerBlock(t *testing.T) {
+	shapeOff(t, "lz4/3")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, readSizesCases)
+		data := writerFrame(ht, c.opts, c.content)
+		f := parsedFrame(ht, data)
+		res := readFrames(ht, data, 0, 1, c.sizes())
+		if res.err != nil || !bytes.Equal(res.out, c.content) {
+			fail(ht, "the Reader does not read the Writer's frame: %v (%d bytes, want %d)", res.err, len(res.out), len(c.content))
+		}
+		want := sortedSizes(f.blocks, false)
+		calls := append([]int{}, res.handler...)
+		sort.Ints(calls)
+		if !slices.Equal(calls, want) {
+			fail(ht, "Read with buffers of %v bytes called OnBlockDone with %v for blocks of %v bytes (once per block, with the uncompressed size, is the contract)", c.sizes(), calls, want)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/4
+
+// descriptorBitCase: a frame of the specification with one bit of its
+// descriptor flipped and the header checksum repaired: a version bit (6 or 7
+// of FLG: versions 0 and 3) or a reserved bit (1 of FLG; 7 and 0-3 of BD).
+type descriptorBitCase struct {
+	frame frameGen
+	bit   int // 0-7: FLG, 8-15: BD
+	mode  int
+	conc  int
+	sizes []int
+}
+
+func bitName(bit int) string {
+	switch bit {
+	case 6:
+		return "version 0 (FLG bit 6 cleared)"
+	case 7:
+		return "version 3 (FLG bit 7 set)"
+	case 1:
+		return "the reserved FLG bit 1 set"
+	}
+	return fmt.Sprintf("the reserved BD bit %d set", bit-8)
+}
+
+func (c descriptorBitCase) GoString() string {
+	return fmt.Sprintf("%#v with %s, mode %d, concurrency %d, sizes %v", c.frame, bitName(c.bit), c.mode, c.conc, c.sizes)
+}
+
+var descriptorBitCases = hegel.Composite(func(tc hegel.TestCase) descriptorBitCase {
+	return descriptorBitCase{
+		frame: hegel.Draw(tc, frameGens),
+		bit:   hegel.Draw(tc, pick(6, 7, 1, 15, 8, 9, 10, 11)),
+		mode:  hegel.Draw(tc, readModes),
+		conc:  hegel.Draw(tc, pick(1, 1, 2, 4)),
+		sizes: hegel.Draw(tc, sizeLists),
+	}
+})
+
+// TestHegelReaderRejectsUnknownVersionsAndReservedBits: the frame format says
+// the version "must be set to 01. Any other value cannot be decoded by this
+// version of the library" and that a decoder finding a reserved bit set
+// should reject the frame, as the reference does; the Reader reads such
+// frames without complaint (lz4/4).
+func TestHegelReaderRejectsUnknownVersionsAndReservedBits(t *testing.T) {
+	shapeOff(t, "lz4/4")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, descriptorBitCases)
+		f := c.frame.render(false, false)
+		m := edit{kind: 8, k: c.bit}.apply(f.build())
+		_, _, werr := parseFrames(m)
+		if werr == nil || (werr.kind != "version" && werr.kind != "reserved") {
+			fail(ht, "harness: the frame with %s parses as %v", bitName(c.bit), werr)
+		}
+		note(ht, "%s: header %x", werr, m[:7])
+		res := readFrames(ht, m, c.mode, c.conc, c.sizes)
+		if res.err == nil {
+			fail(ht, "a frame with %s is read without error (%d bytes; the format says it cannot be decoded)", bitName(c.bit), len(res.out))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/5
+
+// contentSizeCase: a frame of the specification with a content size whose
+// byte at (0-7) is changed to another non-zero value, with the header
+// checksum repaired, so that the header's size differs from the content.
+type contentSizeCase struct {
+	frame frameGen
+	at    int
+	delta int // 0-253: the new byte is 1 + (old + delta) % 255, never old
+	mode  int
+	conc  int
+	sizes []int
+}
+
+func (c contentSizeCase) GoString() string {
+	return fmt.Sprintf("%#v with content-size byte %d changed (delta %d), mode %d, concurrency %d, sizes %v", c.frame, c.at, c.delta, c.mode, c.conc, c.sizes)
+}
+
+var contentSizeCases = hegel.Composite(func(tc hegel.TestCase) contentSizeCase {
+	g := hegel.Draw(tc, frameGens)
+	g.csize = true
+	return contentSizeCase{
+		frame: g,
+		at:    hegel.Draw(tc, hegel.Integers(0, 7)),
+		delta: hegel.Draw(tc, hegel.Integers(0, 253)),
+		mode:  hegel.Draw(tc, readModes),
+		conc:  hegel.Draw(tc, pick(1, 1, 2, 4)),
+		sizes: hegel.Draw(tc, sizeLists),
+	}
+})
+
+// TestHegelReaderChecksTheContentSize: the content size in the header is the
+// frame's own statement of what it holds, and the reference rejects a frame
+// whose content has another size; the Reader only reports the field through
+// Size() and reads the frame without error (lz4/5).
+func TestHegelReaderChecksTheContentSize(t *testing.T) {
+	shapeOff(t, "lz4/5")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, contentSizeCases)
+		f := c.frame.render(false, false)
+		m := f.build()
+		old := int(m[6+c.at])
+		m[6+c.at] = byte(1 + (old+c.delta)%255)
+		m[14] = byte(xxh32(m[4:14]) >> 8)
+		declared := binary.LittleEndian.Uint64(m[6:14])
+		_, _, werr := parseFrames(m)
+		if werr == nil || werr.kind != "content-size" {
+			fail(ht, "harness: the frame declaring %d bytes parses as %v", declared, werr)
+		}
+		note(ht, "header says %d bytes, the frame holds %d", declared, len(f.content))
+		res := readFrames(ht, m, c.mode, c.conc, c.sizes)
+		if res.err == nil {
+			fail(ht, "a frame declaring %d bytes of content and holding %d is read without error (%d bytes out; the reference rejects it)", declared, len(f.content), len(res.out))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/6
+
+// cutFrameCase: a frame of the specification without a content checksum, cut
+// at one of the points that leave it without its end mark: after the magic
+// number, after the descriptor, after a block's size field, after a block.
+type cutFrameCase struct {
+	frame frameGen
+	pos   int
+	mode  int
+	conc  int
+	sizes []int
+}
+
+// cutPoints are the offsets at which a cut leaves the frame without its end mark.
+func cutPoints(f frameSpec) []int {
+	pts := []int{4}
+	pos := 4 + 2 + 1
+	if f.csize {
+		pos += 8
+	}
+	pts = append(pts, pos)
+	for _, b := range f.blocks {
+		pos += 4
+		pts = append(pts, pos)
+		pos += len(b.payload)
+		if f.bsum {
+			pos += 4
+		}
+		pts = append(pts, pos)
+	}
+	return pts
+}
+
+func (c cutFrameCase) GoString() string {
+	return fmt.Sprintf("%#v cut at point %d, mode %d, concurrency %d, sizes %v", c.frame, c.pos, c.mode, c.conc, c.sizes)
+}
+
+var cutFrameCases = hegel.Composite(func(tc hegel.TestCase) cutFrameCase {
+	g := hegel.Draw(tc, frameGens)
+	g.csum = false
+	return cutFrameCase{
+		frame: g,
+		pos:   hegel.Draw(tc, positions),
+		mode:  hegel.Draw(tc, readModes),
+		conc:  hegel.Draw(tc, pick(1, 1, 2, 4)),
+		sizes: hegel.Draw(tc, sizeLists),
+	}
+})
+
+// TestHegelFramesCutBeforeTheEndMarkAreRejected: a frame ends with an explicit
+// end mark, so bytes that stop before it are an unfinished stream, as the
+// reference reports; the Reader takes the end of the input where a block size
+// or a block should be for the end of the stream and returns what it has read
+// with a clean io.EOF or a nil error (lz4/6). WriteTo is the one entry point
+// that reports a frame cut right after its magic number (as io.EOF), so that
+// cut is read with Read.
+func TestHegelFramesCutBeforeTheEndMarkAreRejected(t *testing.T) {
+	shapeOff(t, "lz4/6")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cutFrameCases)
+		f := c.frame.render(false, false)
+		data := f.build()
+		pts := cutPoints(f)
+		cut := pts[at(c.pos, len(pts))]
+		m := data[:cut]
+		mode := c.mode
+		if cut == 4 && mode == 1 {
+			mode = 0
+		}
+		_, _, werr := parseFrames(m)
+		if werr == nil || werr.kind != "truncated" {
+			fail(ht, "harness: the frame cut at %d of %d bytes parses as %v", cut, len(data), werr)
+		}
+		note(ht, "%d of %d bytes (%s), mode %d", cut, len(data), werr, mode)
+		res := readFrames(ht, m, mode, c.conc, c.sizes)
+		if res.err == nil {
+			fail(ht, "a frame cut at byte %d of %d (%s) is read as complete: %d bytes, no error (mode %d)", cut, len(data), werr, len(res.out), mode)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/7
+
+// legacyTrailerCase: a legacy frame whose first block is literals of as many
+// bytes as the second block's compressed size, so that the second block's
+// size equals the content read before it, then any further blocks.
+type legacyTrailerCase struct {
+	block    blockSpec // the second block
+	fill     []byte    // the first block's literals
+	alphabet int
+	trailing []blockGen
+	mode     int
+	conc     int
+	sizes    []int
+}
+
+func (c legacyTrailerCase) GoString() string {
+	return fmt.Sprintf("second block %#v, alphabet %d, %d trailing blocks, mode %d, concurrency %d, sizes %v", c.block, c.alphabet, len(c.trailing), c.mode, c.conc, c.sizes)
+}
+
+// blocksWithData: blocks of the format that decode to at least one byte.
+var blocksWithData = hegel.Filter(blockSpecs, func(b blockSpec) bool {
+	_, out := b.build(nil, 30000)
+	return len(out) > 0
+})
+
+var legacyTrailerCases = hegel.Composite(func(tc hegel.TestCase) legacyTrailerCase {
+	return legacyTrailerCase{
+		block:    hegel.Draw(tc, blocksWithData),
+		fill:     hegel.Draw(tc, hegel.Binary(1, 32)),
+		alphabet: hegel.Draw(tc, pick(0, 0, 2, 4, 26)),
+		trailing: hegel.Draw(tc, many(blockGens, 0, 2)),
+		mode:     hegel.Draw(tc, readModes),
+		conc:     hegel.Draw(tc, pick(1, 1, 2, 4)),
+		sizes:    hegel.Draw(tc, sizeLists),
+	}
+})
+
+// TestHegelLegacyBlocksAreNotMistakenForTheSizeTrailer: a legacy frame is
+// blocks up to the next magic number or the end of the input, and the
+// reference decodes every block; the Reader takes a block whose compressed
+// size equals the content read so far for the size trailer of a Linux kernel
+// image and stops there, without error or with "bad magic number" (lz4/7).
+func TestHegelLegacyBlocksAreNotMistakenForTheSizeTrailer(t *testing.T) {
+	shapeOff(t, "lz4/7")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, legacyTrailerCases)
+		blkB, outB := c.block.build(nil, 30000)
+		outA := fillBytes(c.fill, len(blkB), c.alphabet)
+		blkA := encodeSeqs([]seq{{lit: outA}})
+		f := frameSpec{legacy: true, bsIdx: 3, indep: true, blocks: []specBlock{{payload: blkA, out: outA}, {payload: blkB, out: outB}}}
+		rest := frameGen{legacy: true, blocks: c.trailing}.render(true, false)
+		f.blocks = append(f.blocks, rest.blocks...)
+		f.content = slices.Concat(outA, outB, rest.content)
+		data := f.build()
+		note(ht, "block sizes %v for data of %v bytes", sortedSizesInOrder(f.blocks, true), sortedSizesInOrder(f.blocks, false))
+		if _, got, err := parseFrames(data); err != nil || !bytes.Equal(got, f.content) {
+			fail(ht, "harness: the specification parser fails on the legacy frame: %v", err)
+		}
+		if ref, err := cliDecode(data); err != nil || !bytes.Equal(ref, f.content) {
+			fail(ht, "harness: the reference does not decode the legacy frame: %v (%d bytes back, want %d)", err, len(ref), len(f.content))
+		}
+		res := readFrames(ht, data, c.mode, c.conc, c.sizes)
+		if res.err != nil || !bytes.Equal(res.out, f.content) {
+			fail(ht, "a legacy frame whose second block is %d bytes long after %d bytes of content reads as %d bytes, %v; want %d (the reference decodes all of it)", len(blkB), len(outA), len(res.out), res.err, len(f.content))
+		}
+	})
+}
+
+// sortedSizesInOrder are the blocks' sizes in frame order (for a note).
+func sortedSizesInOrder(blocks []specBlock, payload bool) []int {
+	sizes := []int{}
+	for _, b := range blocks {
+		if payload {
+			sizes = append(sizes, len(b.payload))
+		} else {
+			sizes = append(sizes, len(b.out))
+		}
+	}
+	return sizes
+}
+
+// --------------------------------------------------------------------------- lz4/8
+
+// readFromAfterCase: content split at a drawn point, the first part given to
+// the Writer by Write, Write and Flush, or ReadFrom, the rest by ReadFrom.
+type readFromAfterCase struct {
+	content []byte
+	opts    writerOpts
+	before  string
+	pos     int
+}
+
+func (c readFromAfterCase) cut() int { return at(c.pos, len(c.content)+1) }
+
+func (c readFromAfterCase) GoString() string {
+	return fmt.Sprintf("%d bytes, %s, %s of the first %d bytes then ReadFrom of the rest", len(c.content), c.opts, c.before, c.cut())
+}
+
+var readFromAfterCases = hegel.Composite(func(tc hegel.TestCase) readFromAfterCase {
+	return readFromAfterCase{
+		content: hegel.Draw(tc, contents(300000)),
+		opts:    hegel.Draw(tc, writerOptions(chance(10), concurrencies)),
+		before:  hegel.Draw(tc, pick("Write", "Write and Flush", "ReadFrom")),
+		pos:     hegel.Draw(tc, positions),
+	}
+})
+
+// TestHegelReadFromFollowsEarlierWrites: Writer implements io.ReaderFrom, so
+// ReadFrom appends to the frame after any Write, Flush or ReadFrom (io.Copy(w,
+// r) after a Write takes this path); ReadFrom accepts only a fresh Writer and
+// otherwise fails with ErrInternalUnhandledState, leaving the Writer in its
+// error state so that the frame is never finished (lz4/8).
+func TestHegelReadFromFollowsEarlierWrites(t *testing.T) {
+	shapeOff(t, "lz4/8")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, readFromAfterCases)
+		cut := c.cut()
+		head, tail := c.content[:cut], c.content[cut:]
+		var buf bytes.Buffer
+		w := lz4.NewWriter(&buf)
+		if err := w.Apply(c.opts.options(len(c.content))...); err != nil {
+			fail(ht, "Apply(%s): %v", c.opts, err)
+		}
+		switch c.before {
+		case "ReadFrom":
+			if k, err := w.ReadFrom(bytes.NewReader(head)); err != nil || k != int64(len(head)) {
+				fail(ht, "first ReadFrom(%d bytes) = %d, %v", len(head), k, err)
+			}
+		default:
+			if k, err := w.Write(head); err != nil || k != len(head) {
+				fail(ht, "Write(%d bytes) = %d, %v", len(head), k, err)
+			}
+			if c.before == "Write and Flush" {
+				if err := w.Flush(); err != nil {
+					fail(ht, "Flush: %v", err)
+				}
+			}
+		}
+		if k, err := w.ReadFrom(bytes.NewReader(tail)); err != nil || k != int64(len(tail)) {
+			fail(ht, "ReadFrom(%d bytes) after %s = %d, %v", len(tail), c.before, k, err)
+		}
+		if err := w.Close(); err != nil {
+			fail(ht, "Close after ReadFrom: %v", err)
+		}
+		if frames, got, err := parseFrames(buf.Bytes()); err != nil || len(frames) != 1 || !bytes.Equal(got, c.content) {
+			fail(ht, "the frame holds %d bytes in %d frames (%v), want %d", len(got), len(frames), err, len(c.content))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- lz4/9
+
+// legacyThenCase: a legacy frame (without the lz4/7 coincidence) followed by a
+// skippable frame or a standard frame of the specification.
+type legacyThenCase struct {
+	legacy    frameGen
+	skippable bool
+	skip      []byte
+	next      frameGen
+	mode      int
+	conc      int
+	sizes     []int
+}
+
+func (c legacyThenCase) GoString() string {
+	next := fmt.Sprintf("%#v", c.next)
+	if c.skippable {
+		next = fmt.Sprintf("skippable(%d)", len(c.skip))
+	}
+	return fmt.Sprintf("legacy %#v then %s, mode %d, concurrency %d, sizes %v", c.legacy, next, c.mode, c.conc, c.sizes)
+}
+
+// legacyFrameGens: frames rendered as legacy frames, without a block whose
+// size equals the content before it (lz4/7 would end the frame there).
+var legacyFrameGens = hegel.Filter(hegel.Map(frameGens, func(g frameGen) frameGen {
+	g.legacy = true
+	return g
+}), func(g frameGen) bool { return !legacyCoincidence(g.render(true, false)) })
+
+var legacyThenCases = hegel.Composite(func(tc hegel.TestCase) legacyThenCase {
+	return legacyThenCase{
+		legacy:    hegel.Draw(tc, legacyFrameGens),
+		skippable: hegel.Draw(tc, chance(30)),
+		skip:      hegel.Draw(tc, hegel.Binary(0, 50)),
+		next:      hegel.Draw(tc, frameGens),
+		mode:      hegel.Draw(tc, readModes),
+		conc:      hegel.Draw(tc, pick(1, 1, 2, 4)),
+		sizes:     hegel.Draw(tc, sizeLists),
+	}
+})
+
+// TestHegelLegacyFramesMayBeFollowedByOtherFrames: a legacy frame ends at the
+// next magic number, so a standard or skippable frame may follow it and the
+// reference decodes both; the Reader knows only the legacy magic as a
+// boundary, takes the next frame's magic for a block size and fails with
+// ErrOptionInvalidBlockSize (lz4/9).
+func TestHegelLegacyFramesMayBeFollowedByOtherFrames(t *testing.T) {
+	shapeOff(t, "lz4/9")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, legacyThenCases)
+		leg := c.legacy.render(true, false)
+		next := c.next.render(false, false)
+		if c.skippable {
+			next = frameSpec{skippable: true, skip: c.skip}
+		}
+		data, content := concat(leg, next)
+		note(ht, "%s + %s", leg.String(), next.String())
+		if _, got, err := parseFrames(data); err != nil || !bytes.Equal(got, content) {
+			fail(ht, "harness: the specification parser fails on the frames: %v", err)
+		}
+		res := readFrames(ht, data, c.mode, c.conc, c.sizes)
+		if res.err != nil || !bytes.Equal(res.out, content) {
+			fail(ht, "%s followed by %s reads as %d bytes, %v; want %d (the reference decodes both frames)", leg.String(), next.String(), len(res.out), res.err, len(content))
+		}
+	})
+}
