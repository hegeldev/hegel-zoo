+// ---------------------------------------------------------------------------
+// Reading with the library, guarded against panics and hangs.
+
+type readResult struct {
+	out     []byte
+	err     error
+	handler []int
+	size    int // Reader.Size after the first Read (mode 0 only)
+	firstN  int // bytes returned by the first Read (mode 0 only)
+}
+
+// readFrames reads data with a Reader: mode 0 = Read with the given buffer
+// sizes, 1 = WriteTo, 2 = io.ReadAll.
+func readFrames(ht *hegel.T, data []byte, mode, conc int, sizes []int) readResult {
+	done := make(chan readResult, 1)
+	go func() {
+		var res readResult
+		var mu sync.Mutex
+		defer func() {
+			if r := recover(); r != nil {
+				res.err = fmt.Errorf("PANIC: %v", r)
+			}
+			mu.Lock()
+			defer mu.Unlock()
+			done <- res
+		}()
+		r := lz4.NewReader(bytes.NewReader(data))
+		opts := []lz4.Option{lz4.OnBlockDoneOption(func(k int) {
+			mu.Lock()
+			res.handler = append(res.handler, k)
+			mu.Unlock()
+		})}
+		if conc != 1 {
+			opts = append(opts, lz4.ConcurrencyOption(conc))
+		}
+		if err := r.Apply(opts...); err != nil {
+			res.err = fmt.Errorf("Apply: %w", err)
+			return
+		}
+		switch mode {
+		case 0:
+			buf := make([]byte, 1<<17)
+			for i := 0; ; i++ {
+				k := sizes[i%len(sizes)]
+				m, err := r.Read(buf[:k])
+				res.out = append(res.out, buf[:m]...)
+				if i == 0 {
+					res.size = r.Size()
+					res.firstN = m
+				}
+				if err == io.EOF {
+					return
+				}
+				if err != nil {
+					res.err = err
+					return
+				}
+			}
+		case 1:
+			var b bytes.Buffer
+			_, err := r.WriteTo(&b)
+			res.out, res.err = b.Bytes(), err
+		default:
+			res.out, res.err = io.ReadAll(r)
+		}
+	}()
+	select {
+	case res := <-done:
+		return res
+	case <-time.After(60 * time.Second):
+		fail(ht, "the Reader hangs on %d bytes (mode %d, concurrency %d)", len(data), mode, conc)
+		return readResult{}
+	}
+}
+
+// The Read buffer sizes of a case, cycled.
+var (
+	bufSizes  = weighted(choice[int]{1, hegel.Just(1)}, choice[int]{1, hegel.Just(2)}, choice[int]{1, hegel.Just(7)}, choice[int]{1, hegel.Just(100)}, choice[int]{1, hegel.Just(4096)}, choice[int]{1, hegel.Just(65536)}, choice[int]{1, hegel.Integers(1, 70000)})
+	sizeLists = many(bufSizes, 1, 4)
+	readModes = hegel.Integers(0, 2) // 0 = Read, 1 = WriteTo, 2 = io.ReadAll
+)
+
+// ---------------------------------------------------------------------------
+// Property 1: the block compressors.
+
+type blockCompressor struct {
+	name string
+	fn   func(src, dst []byte) (int, error)
+}
+
+func (c blockCompressor) GoString() string { return c.name }
+
+func compressBlockHC(level lz4.CompressionLevel) blockCompressor {
+	return blockCompressor{fmt.Sprintf("CompressBlockHC(%s)", level), func(src, dst []byte) (int, error) { return lz4.CompressBlockHC(src, dst, level, nil, nil) }}
+}
+
+var compressors = weighted(
+	choice[blockCompressor]{1, hegel.Just(blockCompressor{"CompressBlock", func(src, dst []byte) (int, error) { return lz4.CompressBlock(src, dst, nil) }})},
+	choice[blockCompressor]{1, hegel.Composite(func(hegel.TestCase) blockCompressor {
+		c := new(lz4.Compressor)
+		return blockCompressor{"Compressor", c.CompressBlock}
+	})},
+	choice[blockCompressor]{1, hegel.Map(pick(lz4.Level1, lz4.Level2, lz4.Level3, lz4.Level4, lz4.Level5, lz4.Level6, lz4.Level7, lz4.Level8, lz4.Level9), compressBlockHC)},
+	choice[blockCompressor]{1, hegel.Just(blockCompressor{"CompressBlockHC(0)", func(src, dst []byte) (int, error) { return lz4.CompressBlockHC(src, dst, 0, nil, nil) }})},
+	choice[blockCompressor]{2, hegel.Map(pick(lz4.Fast, lz4.Level1, lz4.Level3, lz4.Level6, lz4.Level9), func(level lz4.CompressionLevel) blockCompressor {
+		c := &lz4.CompressorHC{Level: level}
+		return blockCompressor{fmt.Sprintf("CompressorHC{%s}", level), c.CompressBlock}
+	})},
+)
+
+type blockCase struct {
+	src   []byte
+	comp  blockCompressor
+	extra int // extra room in the decode buffer
+}
+
+func (c blockCase) GoString() string {
+	return fmt.Sprintf("%s on %d bytes, extra %d", c.comp.name, len(c.src), c.extra)
+}
+
+var blockCases = hegel.Composite(func(tc hegel.TestCase) blockCase {
+	return blockCase{src: hegel.Draw(tc, contents(70000)), comp: hegel.Draw(tc, compressors), extra: hegel.Draw(tc, hegel.Integers(1, 100))}
+})
+
+func TestHegelBlockCompressionRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tc := hegel.Draw(ht, blockCases)
+		src, c := tc.src, tc.comp
+		note(ht, "%s on %d bytes", c.name, len(src))
+		bound := lz4.CompressBlockBound(len(src))
+		dst := make([]byte, bound)
+		k, err := c.fn(src, dst)
+		if err != nil || k <= 0 {
+			fail(ht, "%s with a bound-sized destination: n=%d err=%v (documented to always succeed with n > 0)", c.name, k, err)
+		}
+		blk := append([]byte{}, dst[:k]...)
+		if got, compliant, err := decodeBlock(blk, nil, len(src)); err != nil || !bytes.Equal(got, src) {
+			fail(ht, "%s block does not decode by the format: %v (%d bytes -> %d, want %d)", c.name, err, k, len(got), len(src))
+		} else if !compliant {
+			fail(ht, "%s block breaks the encoder restrictions (last five literals, last match twelve bytes before the end)", c.name)
+		}
+		// The library decodes its own block, into an exact and into a larger buffer.
+		for _, extra := range []int{0, tc.extra} {
+			out := make([]byte, len(src)+extra)
+			m, err := lz4.UncompressBlock(blk, out)
+			if err != nil || m != len(src) || !bytes.Equal(out[:m], src) {
+				fail(ht, "UncompressBlock of a %s block into %d+%d bytes: n=%d err=%v", c.name, len(src), extra, m, err)
+			}
+		}
+		// The reference decodes it.
+		if got, err := cliDecode(blockFrame(blk, len(src))); err != nil || !bytes.Equal(got, src) {
+			fail(ht, "the reference lz4 rejects a %s block: %v (%d bytes back, want %d)", c.name, err, len(got), len(src))
+		}
+		// Deterministic (issue #65).
+		dst2 := make([]byte, bound)
+		if k2, err := c.fn(src, dst2); err != nil || k2 != k || !bytes.Equal(dst2[:k2], blk) {
+			fail(ht, "%s is not deterministic: %d then %d bytes (err %v)", c.name, k, k2, err)
+		}
+		// A destination of the source's size, as the frame writer uses it: a
+		// valid block or 0.
+		dstS := make([]byte, len(src))
+		if k3, err := c.fn(src, dstS); k3 > 0 {
+			if k3 > len(src) {
+				fail(ht, "%s wrote %d bytes into a %d-byte destination", c.name, k3, len(src))
+			}
+			if got, _, err := decodeBlock(dstS[:k3], nil, len(src)); err != nil || !bytes.Equal(got, src) {
+				fail(ht, "%s block into a source-sized destination does not decode: %v", c.name, err)
+			}
+		} else if err != nil && k3 != 0 {
+			fail(ht, "%s returned n=%d with error %v", c.name, k3, err)
+		}
+		// A destination too small by one: the first return value is zero.
+		if k > 1 {
+			short := make([]byte, k-1)
+			if k4, _ := c.fn(src, short); k4 != 0 {
+				fail(ht, "%s into %d bytes (block is %d): n=%d, want 0", c.name, k-1, k, k4)
+			}
+		}
+		if bound < len(src)+len(src)/255+16 {
+			fail(ht, "CompressBlockBound(%d) = %d", len(src), bound)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Property 2: the block decoder on blocks of the format.
+
+// An edit damages bytes; positions are taken modulo the live size. Kinds 0-6
+// suit any bytes, 7-9 the descriptor and trailer of a frame.
+type edit struct {
+	kind    int // 0 flip a bit, 1 set a byte, 2 set a special byte, 3 delete, 4 insert, 5 cut, 6 append, 7 cut the tail, 8 flip a descriptor bit and fix the header checksum, 9 change the content size
+	pos     int
+	bit     int
+	b       byte
+	special byte
+	k       int // 7: 4 or 8 tail bytes; 8: the FLG (0-7) or BD (8-15) bit
+}
+
+func edits(kinds int) hegel.Generator[edit] {
+	return hegel.Composite(func(tc hegel.TestCase) edit {
+		return edit{
+			kind:    hegel.Draw(tc, hegel.Integers(0, kinds-1)),
+			pos:     hegel.Draw(tc, positions),
+			bit:     hegel.Draw(tc, hegel.Integers(0, 7)),
+			b:       byte(hegel.Draw(tc, hegel.Integers(0, 255))),
+			special: hegel.Draw(tc, pick(byte(0), byte(0xFF), byte(0xF0), byte(0x0F))),
+			k:       hegel.Draw(tc, hegel.Integers(0, 15)),
+		}
+	})
+}
+
+var (
+	blockEdits = many(edits(7), 1, 2)
+	frameEdits = many(edits(10), 1, 2)
+)
+
+func (e edit) apply(m []byte) []byte {
+	if len(m) == 0 {
+		return m
+	}
+	p := at(e.pos, len(m))
+	switch e.kind {
+	case 0:
+		m[p] ^= 1 << uint(e.bit)
+	case 1:
+		m[p] = e.b
+	case 2:
+		m[p] = e.special
+	case 3:
+		m = append(m[:p], m[p+1:]...)
+	case 4:
+		m = append(m[:p], append([]byte{e.b}, m[p:]...)...)
+	case 5:
+		m = m[:p]
+	case 6:
+		m = append(m, e.b)
+	case 7:
+		m = m[:max(0, len(m)-4*(1+e.k%2))]
+	case 8, 9:
+		if len(m) < 7 || binary.LittleEndian.Uint32(m) != frameMagic {
+			return m
+		}
+		if e.kind == 8 {
+			m[4+e.k/8] ^= 1 << uint(e.k%8)
+		}
+		flg := m[4]
+		hdrLen := 2
+		if flg&(1<<3) != 0 {
+			hdrLen += 8
+		}
+		if flg&1 != 0 {
+			hdrLen += 4
+		}
+		if 4+hdrLen+1 > len(m) {
+			return m
+		}
+		if e.kind == 9 {
+			if flg&(1<<3) == 0 {
+				return m
+			}
+			m[6+e.k%8] = e.b
+		}
+		m[4+hdrLen] = byte(xxh32(m[4:4+hdrLen]) >> 8)
+	}
+	return m
+}
+
+func applyEdits(es []edit, b []byte) []byte {
+	m := append([]byte{}, b...)
+	for _, e := range es {
+		m = e.apply(m)
+	}
+	return m
+}
+
+type specBlockCase struct {
+	dict     []byte
+	block    blockSpec
+	plainAPI bool // UncompressBlock rather than UncompressBlockWithDict (no dictionary only)
+	extra    int  // extra room in the decode buffer
+	short    int  // bytes missing from the decode buffer
+	limit    int  // extra room in the buffer for the damaged block
+	cliCheck bool
+	edits    []edit
+}
+
+func (c specBlockCase) GoString() string {
+	return fmt.Sprintf("%#v, dict %d, plainAPI %v, extra %d, short %d, limit %d, cli %v, edits %v", c.block, len(c.dict), c.plainAPI, c.extra, c.short, c.limit, c.cliCheck, c.edits)
+}
