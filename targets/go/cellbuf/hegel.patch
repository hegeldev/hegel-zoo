+// ---------------------------------------------------------------- tab stops
+
+type tabModel struct {
+	width int
+	stops map[int]bool
+}
+
+func newTabModel(width int) *tabModel {
+	m := &tabModel{width: width, stops: map[int]bool{}}
+	for x := 0; x < width; x += DefaultTabInterval {
+		m.stops[x] = true
+	}
+	return m
+}
+
+func (m *tabModel) find(col, delta int) int {
+	if delta == 0 {
+		return col
+	}
+	cnt := delta
+	if cnt < 0 {
+		cnt = -cnt
+	}
+	for ; cnt > 0; cnt-- {
+		if delta > 0 {
+			if col >= m.width-1 {
+				return col
+			}
+			col++
+			for col < m.width-1 && !m.stops[col] {
+				col++
+			}
+		} else {
+			if col < 1 {
+				return col
+			}
+			col--
+			for col > 0 && !m.stops[col] {
+				col--
+			}
+		}
+	}
+	return col
+}
+
+func (m *tabModel) resize(width int) {
+	for x := range m.stops {
+		if x >= width {
+			delete(m.stops, x)
+		}
+	}
+	for x := m.width; x < width; x++ {
+		if x%DefaultTabInterval == 0 {
+			m.stops[x] = true
+		} else {
+			delete(m.stops, x)
+		}
+	}
+	m.width = width
+}
+
+func TestHegelTabStopsFollowTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		width := n(ht, 0, 40)
+		ts := DefaultTabStops(width)
+		m := newTabModel(width)
+		check := func(what string) {
+			for col := -1; col < m.width; col++ {
+				if got, want := ts.IsStop(col), col >= 0 && m.stops[col]; got != want {
+					fail(ht, "%s: IsStop(%d) = %v, want %v (width %d, stops %v)", what, col, got, want, m.width, m.stops)
+				}
+			}
+			for k := 0; k < 4; k++ {
+				col, d := n(ht, 0, max(m.width-1, 0)), n(ht, -3, 3)
+				if got, want := ts.Find(col, d), m.find(col, d); got != want {
+					fail(ht, "%s: Find(%d,%d) = %d, want %d (width %d, stops %v)", what, col, d, got, want, m.width, m.stops)
+				}
+				if got, want := ts.Next(col), m.find(col, 1); got != want {
+					fail(ht, "%s: Next(%d) = %d, want %d", what, col, got, want)
+				}
+				if got, want := ts.Prev(col), m.find(col, -1); got != want {
+					fail(ht, "%s: Prev(%d) = %d, want %d", what, col, got, want)
+				}
+			}
+		}
+		check("new")
+		for step := n(ht, 0, 8); step > 0; step-- {
+			switch n(ht, 0, 3) {
+			case 0:
+				if m.width == 0 {
+					continue
+				}
+				col := n(ht, 0, m.width-1)
+				note(ht, "Set(%d)", col)
+				ts.Set(col)
+				m.stops[col] = true
+			case 1:
+				if m.width == 0 {
+					continue
+				}
+				col := n(ht, 0, m.width-1)
+				note(ht, "Reset(%d)", col)
+				ts.Reset(col)
+				delete(m.stops, col)
+			case 2:
+				note(ht, "Clear()")
+				ts.Clear()
+				m.stops = map[int]bool{}
+			default:
+				nw := n(ht, 0, 40)
+				note(ht, "Resize(%d)", nw)
+				ts.Resize(nw)
+				m.resize(nw)
+			}
+			check("after ops")
+		}
+		count("ok")
+	})
+}
