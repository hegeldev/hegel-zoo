+// the other rows plain text; under HEGEL_NO_KNOWN=1 the run is ASCII (REP, which the
+// emulator repeats) or wide (no REP), two to one.
+var latin1RunCases = regionBy("cellbuf/15", screenShape, hegel.FlatMap(hzTuple(rangeHalves(5, 16), rangeHalves(1, 4)), func(d []int) hegel.Generator[screenCase] {
