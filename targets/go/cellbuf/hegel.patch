+// ---------------------------------------------------------------- pins
+
+// cellbuf/1: InsertLine, DeleteLine and DeleteCell move cells one by one through Line.set,
+// and moving a wide cell's placeholder after its head blanks the head.
+func TestHegelPinShiftsDestroyWideCells(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 3)
+	b.SetCell(0, 0, NewCell('世'))
+	b.InsertLine(0, 1, nil)
+	if got := b.Line(1).String(); got != "世" {
+		t.Errorf("after InsertLine(0,1), line 1 = %q, want %q\n%s", got, "世", dumpBuffer(b))
+	}
+	b = NewBuffer(4, 3)
+	b.SetCell(0, 1, NewCell('世'))
+	b.DeleteLine(0, 1, nil)
+	if got := b.Line(0).String(); got != "世" {
+		t.Errorf("after DeleteLine(0,1), line 0 = %q, want %q\n%s", got, "世", dumpBuffer(b))
+	}
+	b = NewBuffer(6, 1)
+	b.SetCell(0, 0, NewCell('a'))
+	b.SetCell(1, 0, NewCell('世'))
+	b.DeleteCell(0, 0, 1, nil)
+	if got := b.Line(0).String(); got != "世" {
+		t.Errorf("after DeleteCell(0,0,1), line 0 = %q, want %q\n%s", got, "世", dumpBuffer(b))
+	}
+}
+
+// cellbuf/2: a wide cell written over the placeholder of one wide cell and the head of another
+// leaves the second one's placeholder orphaned.
+func TestHegelPinWideOverTwoWidesLeavesAnOrphan(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 1)
+	b.SetCell(0, 0, NewCell('世'))
+	b.SetCell(2, 0, NewCell('界'))
+	b.SetCell(1, 0, NewCell('中'))
+	if c := b.Cell(3, 0); c.Empty() {
+		t.Errorf("cell 3 is an orphan placeholder, want a blank:\n%s", dumpBuffer(b))
+	}
+	if got, want := b.String(), " 中 "; strings.TrimRight(got, " ") != strings.TrimRight(want, " ") || len(b.Lines[0]) != 4 {
+		t.Errorf("String() = %q, want %q", got, want)
+	}
+}
+
+// cellbuf/3: Buffer.Resize cuts a line through a wide cell and leaves a head that does not fit.
+func TestHegelPinResizeCutsWideCells(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 1)
+	b.SetCell(2, 0, NewCell('世'))
+	b.Resize(3, 1)
+	if c := b.Cell(2, 0); c.Width != 1 {
+		t.Errorf("after shrinking to 3 columns, cell 2 = %s (width %d in the last column), want a blank\n%s", cellString(c), c.Width, dumpBuffer(b))
+	}
+}
+
+// cellbuf/4: TabStops index their bit words with col>>3 whatever the interval, so intervals
+// other than 8 alias columns and larger intervals index out of range.
+func TestHegelPinTabStopsAssumeInterval8(t *testing.T) {
+	defer guard(t)
+	ts := NewTabStops(16, 4)
+	ts.Reset(4)
+	if !ts.IsStop(0) {
+		t.Errorf("Reset(4) on a 4-column interval also cleared column 0")
+	}
+	ts = NewTabStops(16, 4)
+	ts.Set(5)
+	if ts.IsStop(1) {
+		t.Errorf("Set(5) on a 4-column interval also set column 1")
+	}
+	_ = NewTabStops(32, 16)
+}
+
+// cellbuf/5: TabStops.Set and Reset panic for a column at or beyond the width, while IsStop
+// answers false for it.
+func TestHegelPinTabStopsSetBeyondWidthPanics(t *testing.T) {
+	defer guard(t)
+	ts := DefaultTabStops(24)
+	if ts.IsStop(24) {
+		t.Errorf("IsStop(24) on width 24")
