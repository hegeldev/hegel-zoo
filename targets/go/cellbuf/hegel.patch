+// Hegel properties for charmbracelet/x/cellbuf: the cell Buffer against a grid model with the
+// terminal's wide-cell semantics, Render/SetContent round trips, SGR sequences and ReadStyle,
+// Wrap's preservation of content and styles, TabStops against a set model, cell constructors
+// against go-runewidth/uniseg, and Screen's optimised output replayed into the monorepo's vt
+// terminal emulator and compared cell by cell.
+//
+// The test lives in package cellbuf to read Screen's two buffers. CELLBUF_COLLECT=1 turns
+// failures into a tally per property.
+package cellbuf
+
+import (
+	"bytes"
+	"fmt"
+	"image/color"
+	"io"
+	"maps"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode"
+
+	uv "github.com/charmbracelet/ultraviolet"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/vt"
+	"github.com/mattn/go-runewidth"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("CELLBUF_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("panic in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// ---------------------------------------------------------------- generators
+
+var (
+	// Combining sequences with an ASCII base ("e\u0301") are split by x/ansi's decoder (x-ansi/5)
+	// and pinned as cellbuf/9; the Thai cluster has a non-ASCII base.
+	narrowGraphemes = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "ก\u0e49"}
+	wideGraphemes   = []string{"世", "界", "中", "文", "日", "本", "😃", "🫧", "Ａ"}
+)
+
+func genGrapheme(tc hegel.TestCase, allowWide bool) string {
+	if allowWide && chance(tc, 30) {
+		return pick(tc, wideGraphemes)
+	}
+	return pick(tc, narrowGraphemes)
+}
+
+func genColor(tc hegel.TestCase) ansi.Color {
+	switch n(tc, 0, 3) {
+	case 0:
+		return nil
+	case 1:
+		return ansi.BasicColor(n(tc, 0, 15))
+	case 2:
+		return ansi.ExtendedColor(n(tc, 16, 255))
+	default:
+		return color.RGBA{R: uint8(n(tc, 0, 255)), G: uint8(n(tc, 0, 255)), B: uint8(n(tc, 0, 255)), A: 0xff}
+	}
+}
+
+func genStyle(tc hegel.TestCase) Style { return genStyleOpt(tc, false) }
+
+// genStyleOpt draws a style; noSiblings leaves out faint and rapid blink, whose SGR off codes
+// (22, 25) also clear bold and slow blink (cellbuf/6).
+func genStyleOpt(tc hegel.TestCase, noSiblings bool) Style {
+	var s Style
+	if chance(tc, 40) {
+		return s
+	}
+	s.Attrs = AttrMask(n(tc, 0, 255))
+	if chance(tc, 50) {
+		s.Attrs = AttrMask(1 << n(tc, 0, 7))
+	}
+	if noSiblings {
+		s.Attrs &^= FaintAttr | RapidBlinkAttr
+	}
+	if chance(tc, 30) {
+		s.UlStyle = UnderlineStyle(n(tc, 0, 5))
+	}
+	s.Fg = genColor(tc)
+	s.Bg = genColor(tc)
+	if chance(tc, 20) {
+		s.Ul = genColor(tc)
+	}
+	return s
+}
+
+func genLink(tc hegel.TestCase) Link {
+	if chance(tc, 80) {
+		return Link{}
+	}
+	l := Link{URL: fmt.Sprintf("https://example.com/%d", n(tc, 0, 9))}
+	if chance(tc, 30) {
+		l.Params = fmt.Sprintf("id=%d", n(tc, 0, 9))
+	}
+	return l
+}
+
+// genCell draws a cell: nil (a blank) or a grapheme cell with a style and a link.
+func genCell(tc hegel.TestCase, allowWide bool) *Cell { return genCellOpt(tc, allowWide, false) }
+
+func genCellOpt(tc hegel.TestCase, allowWide, noSiblings bool) *Cell {
+	if chance(tc, 25) {
+		return nil
+	}
+	c := NewGraphemeCell(genGrapheme(tc, allowWide))
+	if chance(tc, 10) {
+		c = NewCell(' ')
+	}
+	c.Style = genStyleOpt(tc, noSiblings)
+	c.Link = genLink(tc)
+	return c
+}
+
+func styleString(s Style) string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b uls:%d}", s.Fg, s.Bg, s.Ul, s.Attrs, s.UlStyle)
+}
+
+func cellString(c *Cell) string {
+	if c == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%q w%d %s %v}", c.String(), c.Width, styleString(c.Style), c.Link)
+}
+
+// ---------------------------------------------------------------- the grid model
+
+// mcell is the model's cell: a placeholder has w == 0 and s == "".
+type mcell struct {
+	s  string
+	w  int
+	st Style
+	ln Link
+}
+
+var mblank = mcell{s: " ", w: 1}
+
+type mgrid struct {
+	w, h int
+	g    [][]mcell
+}
+
+func newGrid(w, h int) *mgrid {
+	m := &mgrid{}
+	m.resize(w, h)
+	return m
+}
+
+func (m *mgrid) resize(w, h int) {
+	if w == 0 || h == 0 {
+		m.w, m.h, m.g = 0, 0, nil
+		return
+	}
+	for y := range m.g {
+		if w > m.w {
+			for x := m.w; x < w; x++ {
+				m.g[y] = append(m.g[y], mblank)
+			}
+		} else {
+			m.g[y] = m.g[y][:w]
+		}
+	}
+	for len(m.g) < h {
+		row := make([]mcell, w)
+		for x := range row {
+			row[x] = mblank
+		}
+		m.g = append(m.g, row)
+	}
+	m.g = m.g[:h]
+	m.w, m.h = w, h
+}
+
+// splitWide blanks the wide cell covering column x, keeping its style and link.
+func (m *mgrid) splitWide(x, y int) {
+	if x < 0 || x >= m.w {
+		return
+	}
+	c := m.g[y][x]
+	head := -1
+	if c.w > 1 {
+		head = x
+	} else if c.w == 0 && c.s == "" {
+		for j := 1; j < maxCellWidth && x-j >= 0; j++ {
+			if wc := m.g[y][x-j]; wc.w > 1 && j < wc.w {
+				head = x - j
+				break
+			}
+		}
+	}
+	if head < 0 {
+		return
+	}
+	hc := m.g[y][head]
+	for k := 0; k < hc.w && head+k < m.w; k++ {
+		m.g[y][head+k] = mcell{s: " ", w: 1, st: hc.st, ln: hc.ln}
+	}
+}
+
+// coversWideHead reports whether writing a cell of width w at x would overwrite the head of
+// another wide cell with a placeholder (cellbuf/2: its own placeholder is left orphaned).
+func (m *mgrid) coversWideHead(x, y, w int) bool {
+	if y < 0 || y >= m.h {
+		return false
+	}
+	for j := 1; j < w && x+j < m.w; j++ {
+		if m.g[y][x+j].w > 1 {
+			return true
+		}
+	}
+	return false
+}
+
+// hasWide reports whether the rectangle contains a wide cell head or placeholder.
+func (m *mgrid) hasWide(r Rectangle) bool {
+	for y := max(r.Min.Y, 0); y < min(r.Max.Y, m.h); y++ {
+		for x := max(r.Min.X, 0); x < min(r.Max.X, m.w); x++ {
+			if c := m.g[y][x]; c.w != 1 {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (m *mgrid) setCell(x, y int, c *Cell) bool {
+	if y < 0 || y >= m.h || x < 0 || x >= m.w {
+		return false
+	}
+	w := 1
+	mc := mblank
+	if c != nil {
+		w = c.Width
+		mc = mcell{s: c.String(), w: c.Width, st: c.Style, ln: c.Link}
+	}
+	for j := 0; j < max(w, 1) && x+j < m.w; j++ {
+		m.splitWide(x+j, y)
+	}
+	if c != nil && x+w > m.w {
+		for i := 0; i < w && x+i < m.w; i++ {
+			m.g[y][x+i] = mcell{s: " ", w: 1, st: c.Style, ln: c.Link}
+		}
+		return true
+	}
+	m.g[y][x] = mc
+	for j := 1; j < w && x+j < m.w; j++ {
+		m.g[y][x+j] = mcell{}
+	}
+	return true
+}
+
+func (m *mgrid) fillRect(c *Cell, r Rectangle) {
+	cw := 1
+	if c != nil && c.Width > 1 {
+		cw = c.Width
+	}
+	for y := r.Min.Y; y < r.Max.Y; y++ {
+		for x := r.Min.X; x < r.Max.X; x += cw {
+			m.setCell(x, y, c)
+		}
+	}
+}
+
+func (m *mgrid) fillLine(y int, x0, x1 int, c *Cell) {
+	for x := x0; x < x1; x++ {
+		m.setCell(x, y, c)
+	}
+}
+
+func (m *mgrid) insertLine(y, nl int, c *Cell, r Rectangle) {
+	if nl <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h {
+		return
+	}
+	nl = min(nl, r.Max.Y-y)
+	for i := r.Max.Y - 1; i >= y+nl; i-- {
+		copy(m.g[i][r.Min.X:r.Max.X], m.g[i-nl][r.Min.X:r.Max.X])
+	}
+	for i := y; i < y+nl; i++ {
+		m.fillLine(i, r.Min.X, r.Max.X, c)
+	}
+}
+
+func (m *mgrid) deleteLine(y, nl int, c *Cell, r Rectangle) {
+	if nl <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h {
+		return
+	}
+	nl = min(nl, r.Max.Y-y)
+	for dst := y; dst < r.Max.Y-nl; dst++ {
+		copy(m.g[dst][r.Min.X:r.Max.X], m.g[dst+nl][r.Min.X:r.Max.X])
+	}
+	for i := r.Max.Y - nl; i < r.Max.Y; i++ {
+		m.fillLine(i, r.Min.X, r.Max.X, c)
+	}
+}
+
+func (m *mgrid) insertCell(x, y, nc int, c *Cell, r Rectangle) {
+	if nc <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h || x < r.Min.X || x >= r.Max.X || x >= m.w {
+		return
+	}
+	nc = min(nc, r.Max.X-x)
+	for i := r.Max.X - 1; i >= x+nc && i-nc >= r.Min.X; i-- {
+		m.g[y][i] = m.g[y][i-nc]
+	}
+	m.fillLine(y, x, min(x+nc, r.Max.X), c)
+}
+
+func (m *mgrid) deleteCell(x, y, nc int, c *Cell, r Rectangle) {
+	if nc <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h || x < r.Min.X || x >= r.Max.X || x >= m.w {
+		return
+	}
+	nc = min(nc, r.Max.X-x)
+	for i := x; i < r.Max.X-nc; i++ {
+		m.g[y][i] = m.g[y][i+nc]
+	}
+	m.fillLine(y, r.Max.X-nc, r.Max.X, c)
+}
+
+func (m *mgrid) String() string {
+	var lines []string
+	for y := 0; y < m.h; y++ {
+		var sb strings.Builder
+		for _, c := range m.g[y] {
+			sb.WriteString(c.s)
+		}
+		lines = append(lines, strings.TrimRight(sb.String(), " "))
+	}
+	return strings.Join(lines, "\r\n")
+}
+
+func (m *mgrid) dump() string {
+	var sb strings.Builder
+	for y := 0; y < m.h; y++ {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range m.g[y] {
+			fmt.Fprintf(&sb, " {%q w%d}", c.s, c.w)
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+func dumpBuffer(b *Buffer) string {
+	var sb strings.Builder
+	for y, l := range b.Lines {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range l {
+			if c == nil {
+				sb.WriteString(" nil")
+			} else {
+				fmt.Fprintf(&sb, " {%q w%d}", c.String(), c.Width)
+			}
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+// hasOrphan reports whether the buffer holds a placeholder not covered by a wide head.
+func hasOrphan(b *Buffer) bool {
+	for _, l := range b.Lines {
+		covered := 0
+		for _, c := range l {
+			if covered > 0 {
+				covered--
+				if c == nil || !c.Empty() {
+					return true
+				}
+				continue
+			}
+			if c == nil {
+				continue
+			}
+			if c.Empty() {
+				return true
+			}
+			if c.Width > 1 {
+				covered = c.Width - 1
+			}
+		}
+	}
+	return false
+}
+
+// compareGrid checks the buffer against the model cell by cell.
+func compareGrid(ht *hegel.T, what string, b *Buffer, m *mgrid) {
+	if b.Width() != m.w || b.Height() != m.h {
+		fail(ht, "%s: buffer %dx%d, model %dx%d", what, b.Width(), b.Height(), m.w, m.h)
+	}
+	for y := 0; y < m.h; y++ {
+		for x := 0; x < m.w; x++ {
+			c := b.Cell(x, y)
+			mc := m.g[y][x]
+			if c == nil {
+				fail(ht, "%s: Cell(%d,%d) is nil inside the buffer", what, x, y)
+			}
+			if c.String() != mc.s || c.Width != mc.w || !c.Style.Equal(&mc.st) || !c.Link.Equal(&mc.ln) {
+				fail(ht, "%s: cell (%d,%d) = %s, model {%q w%d %s %v}\nbuffer:\n%s\nmodel:\n%s", what, x, y, cellString(c), mc.s, mc.w, styleString(mc.st), mc.ln, dumpBuffer(b), m.dump())
+			}
+		}
+	}
+	if got, want := b.String(), m.String(); got != want {
+		fail(ht, "%s: String() = %q, model %q", what, got, want)
+	}
+	if got, want := b.Bounds(), Rect(0, 0, m.w, m.h); got != want {
+		fail(ht, "%s: Bounds() = %v, want %v", what, got, want)
+	}
+}
+
+func genRect(tc hegel.TestCase, w, h int) Rectangle {
+	x0, y0 := n(tc, 0, max(w-1, 0)), n(tc, 0, max(h-1, 0))
+	return Rect(x0, y0, n(tc, 0, w-x0), n(tc, 0, h-y0))
+}
+
+func TestHegelBufferFollowsTheGridModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		w, h := n(ht, 1, 10), n(ht, 1, 5)
+		b := NewBuffer(w, h)
+		m := newGrid(w, h)
+		compareGrid(ht, "new", b, m)
+		for step := n(ht, 1, 25); step > 0; step-- {
+			w, h = m.w, m.h
+			op := n(ht, 0, 9)
+			if w == 0 || h == 0 {
+				op = 9
+			}
+			switch op {
+			case 0, 1, 2:
+				x, y := n(ht, -1, w), n(ht, -1, h)
+				c := genCell(ht, true)
+				if c != nil && m.coversWideHead(x, y, c.Width) {
+					count("wide-over-wide-head")
+					break
+				}
+				note(ht, "SetCell(%d,%d,%s)", x, y, cellString(c))
+				if got, want := b.SetCell(x, y, c), m.setCell(x, y, c); got != want {
+					fail(ht, "SetCell(%d,%d) returned %v, model %v", x, y, got, want)
+				}
+				compareGrid(ht, "after SetCell", b, m)
+			case 3:
+				r := genRect(ht, w, h)
+				c := genCell(ht, true)
+				if c != nil && c.Width > 1 && m.hasWide(Rect(r.Min.X, r.Min.Y, r.Dx()+c.Width-1, r.Dy())) {
+					count("wide-fill-over-wide")
+					break
+				}
+				note(ht, "FillRect(%s, %v)", cellString(c), r)
+				b.FillRect(c, r)
+				m.fillRect(c, r)
+				compareGrid(ht, "after FillRect", b, m)
+			case 4:
+				r := genRect(ht, w, h)
+				note(ht, "ClearRect(%v)", r)
+				b.ClearRect(r)
+				m.fillRect(nil, r)
+				compareGrid(ht, "after ClearRect", b, m)
+			case 5, 6:
+				r := b.Bounds()
+				if chance(ht, 40) {
+					r = genRect(ht, w, h)
+				}
+				y, k := n(ht, 0, h), n(ht, 1, 3)
+				c := genCell(ht, false)
+				if c != nil && c.Width != 1 {
+					c = nil
+				}
+				if m.hasWide(r) {
+					// Moving a wide cell through Line.set blanks it: cellbuf/1.
+					count("wide-in-shifted-lines")
+					break
+				}
+				if op == 5 {
+					note(ht, "InsertLineRect(%d,%d,%s,%v)", y, k, cellString(c), r)
+					b.InsertLineRect(y, k, c, r)
+					m.insertLine(y, k, c, r)
+				} else {
+					note(ht, "DeleteLineRect(%d,%d,%s,%v)", y, k, cellString(c), r)
+					b.DeleteLineRect(y, k, c, r)
+					m.deleteLine(y, k, c, r)
+				}
+				compareGrid(ht, "after line shift", b, m)
+			case 7, 8:
+				r := b.Bounds()
+				if chance(ht, 40) {
+					r = genRect(ht, w, h)
+				}
+				x, y, k := n(ht, 0, w), n(ht, 0, h-1), n(ht, 1, 3)
+				c := genCell(ht, false)
+				if c != nil && c.Width != 1 {
+					c = nil
+				}
+				if m.hasWide(Rect(r.Min.X, y, r.Dx(), 1)) {
+					count("wide-in-shifted-cells")
+					break
+				}
+				if op == 7 {
+					note(ht, "InsertCellRect(%d,%d,%d,%s,%v)", x, y, k, cellString(c), r)
+					b.InsertCellRect(x, y, k, c, r)
+					m.insertCell(x, y, k, c, r)
+				} else {
+					note(ht, "DeleteCellRect(%d,%d,%d,%s,%v)", x, y, k, cellString(c), r)
+					b.DeleteCellRect(x, y, k, c, r)
+					m.deleteCell(x, y, k, c, r)
+				}
+				compareGrid(ht, "after cell shift", b, m)
+			default:
+				nw, nh := n(ht, 0, 10), n(ht, 0, 5)
+				if nw < w {
+					cut := false
+					for y := 0; y < h; y++ {
+						for x := max(nw-maxCellWidth, 0); x < nw; x++ {
+							if c := m.g[y][x]; c.w > 1 && x+c.w > nw {
+								cut = true
+							}
+						}
+					}
+					if cut {
+						count("shrink-through-wide") // cellbuf/3
+						break
+					}
+				}
+				note(ht, "Resize(%d,%d)", nw, nh)
+				b.Resize(nw, nh)
+				m.resize(nw, nh)
+				compareGrid(ht, "after Resize", b, m)
+			}
+		}
+		// Structure: placeholders belong to a head, heads fit.
+		for y, l := range b.Lines {
+			for x, c := range l {
+				if c == nil || c.Width == 1 {
+					continue
+				}
+				if c.Width > 1 {
+					if x+c.Width > len(l) {
+						fail(ht, "wide head at (%d,%d) does not fit:\n%s", x, y, dumpBuffer(b))
+					}
+					for j := 1; j < c.Width; j++ {
+						if p := l[x+j]; p == nil || !p.Empty() {
+							fail(ht, "wide head at (%d,%d) lacks its placeholder %d:\n%s", x, y, j, dumpBuffer(b))
+						}
+					}
+				}
+			}
+		}
+		count("ok")
+	})
+}
+
+// ---------------------------------------------------------------- render round trips
+
+// lossyDiff reports whether DiffSequence from o to s loses an attribute: turning bold off
+// with SGR 22 also turns faint off, and SGR 25 clears both blinks (cellbuf/6).
+func lossyDiff(s, o Style) bool {
+	if o.Empty() {
+		return false
+	}
+	has := func(st Style, a AttrMask) bool { return st.Attrs&a != 0 }
+	// Bold is handled before faint: 22 for a dropped bold clears a faint that is not re-sent
+	// (when o had faint too), and 22 for a dropped faint clears a bold just sent or kept.
+	faintLost := has(s, FaintAttr) && !has(s, BoldAttr) && has(o, BoldAttr) && has(o, FaintAttr)
+	boldLost := has(s, BoldAttr) && !has(s, FaintAttr) && has(o, FaintAttr)
+	// Slow blink is handled before rapid: the same two shapes with SGR 25.
+	rapidLost := has(s, RapidBlinkAttr) && !has(s, SlowBlinkAttr) && has(o, SlowBlinkAttr) && has(o, RapidBlinkAttr)
+	slowLost := has(s, SlowBlinkAttr) && !has(s, RapidBlinkAttr) && has(o, RapidBlinkAttr)
+	return faintLost || boldLost || rapidLost || slowLost
+}
+
+func TestHegelRenderRoundTripsThroughSetContent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		w, h := n(ht, 1, 12), n(ht, 1, 4)
+		b := NewBuffer(w, h)
+		for k := n(ht, 0, 20); k > 0; k-- {
+			b.SetCell(n(ht, 0, w-1), n(ht, 0, h-1), genCell(ht, true))
+		}
+		if hasOrphan(b) {
+			count("orphan-placeholder-skipped") // cellbuf/2
+			return
+		}
+		// Styles that DiffSequence cannot express are pinned.
+		for y := 0; y < h; y++ {
+			var pen Style
+			for x := 0; x < w; x++ {
+				c := b.Cell(x, y)
+				if c.Width == 0 {
+					continue
+				}
+				if !c.Style.Empty() && !c.Style.Equal(&pen) && lossyDiff(c.Style, pen) {
+					count("lossy-diff-skipped")
+					return
+				}
+				pen = c.Style
+			}
+		}
+		out := Render(b)
+		note(ht, "rendered %q", out)
+		b2 := NewBuffer(w, h)
+		SetContent(b2, out)
+		for y := 0; y < h; y++ {
+			for x := 0; x < w; x++ {
+				c, c2 := b.Cell(x, y), b2.Cell(x, y)
+				if !cellEqual(c, c2) {
+					fail(ht, "cell (%d,%d) rendered as %q came back as %s, was %s\nbefore:\n%s\nafter:\n%s", x, y, out, cellString(c2), cellString(c), dumpBuffer(b), dumpBuffer(b2))
+				}
+			}
+		}
+		// Line widths and the plain text agree with the buffer.
+		for y := 0; y < h; y++ {
+			lw, line := RenderLine(b, y)
+			plain := ansi.Strip(line)
+			if want := b.Line(y).String(); strings.TrimRight(plain, " ") != want {
+				fail(ht, "RenderLine(%d) = %q stripped %q, Line.String() %q", y, line, plain, want)
+			}
+			if sw := ansi.StringWidth(plain); lw < sw {
+				fail(ht, "RenderLine(%d) width %d < printed width %d for %q", y, lw, sw, line)
+			}
+		}
+		count("ok")
+	})
+}
