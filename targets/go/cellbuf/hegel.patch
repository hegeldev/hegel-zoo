+// cellbuf/12: clearBottom moves to the row *above* the trailing blank region (`top-1`, with
+// top already 0-based) before erasing to the end of the screen, wiping a row of content that
+// is not redrawn unless it happened to be touched in the same frame.
+func TestHegelPinClearBottomErasesTheRowAbove(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	s := NewScreen(&out, 4, 3, &ScreenOptions{Term: "xterm", AltScreen: true})
+	sw := NewScreenWriter(s)
+	e := vt.NewEmulator(4, 3)
+	sw.SetContent("a\nb\nc")
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	out.Reset()
+	s.ClearRect(Rect(0, 2, 4, 1)) // only row 2 changes; row 1 is not touched
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	if u := e.CellAt(0, 1); u == nil || u.Content != "b" {
+		t.Errorf("after %q the terminal shows %q, the screen holds %q", out.String(), e.String(), s.newbuf.String())
+	}
+}
