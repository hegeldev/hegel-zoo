+// cellbuf/11: emitRange hands raw nil cells to putCell, which draws them as clearBlank(), a
+// space in the *current pen's* style and hyperlink — so a blank after a styled cell is painted
+// with that cell's background, underline and link on the terminal.
+func TestHegelPinBlankCellsInheritThePen(t *testing.T) {
+	defer guard(t)
+	// A terminal without the xterm capabilities (no ECH/REP) takes the putCell path.
+	var out bytes.Buffer
+	s := NewScreen(&out, 3, 1, &ScreenOptions{Term: "vt100", AltScreen: true})
+	e := vt.NewEmulator(3, 1)
+	s.SetCell(1, 0, NewCell('b'))
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	out.Reset()
+	s.Clear()
+	c := NewCell('_')
+	c.Style.Background(ansi.Red)
+	c.Link = Link{URL: "https://example.com"}
+	s.SetCell(0, 0, c)
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	if u := e.CellAt(1, 0); u == nil || !u.Style.IsZero() || !u.Link.IsZero() {
+		t.Errorf("after %q the blank at (1,0) has style %s link %v on the terminal", out.String(), uvStyleString(u.Style), u.Link)
+	}
+}
