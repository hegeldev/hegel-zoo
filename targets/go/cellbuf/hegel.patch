+package cellbuf
+
+// The eighteen pins (one per recorded bug, the regression example beside the property that
+// finds it) and the fixed examples, moved byte for byte from the old hegel_test.go. Each
+// TestHegelPin... is an expected failure mapped to its bug in target.toml.
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/charmbracelet/x/vt"
+)
+
+// cellbuf/1: InsertLine, DeleteLine and DeleteCell move cells one by one through Line.set,
+// and moving a wide cell's placeholder after its head blanks the head.
+func TestHegelPinShiftsDestroyWideCells(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 3)
+	b.SetCell(0, 0, NewCell('世'))
+	b.InsertLine(0, 1, nil)
+	if got := b.Line(1).String(); got != "世" {
+		t.Errorf("after InsertLine(0,1), line 1 = %q, want %q\n%s", got, "世", dumpBuffer(b))
+	}
+	b = NewBuffer(4, 3)
+	b.SetCell(0, 1, NewCell('世'))
+	b.DeleteLine(0, 1, nil)
+	if got := b.Line(0).String(); got != "世" {
+		t.Errorf("after DeleteLine(0,1), line 0 = %q, want %q\n%s", got, "世", dumpBuffer(b))
+	}
+	b = NewBuffer(6, 1)
+	b.SetCell(0, 0, NewCell('a'))
+	b.SetCell(1, 0, NewCell('世'))
+	b.DeleteCell(0, 0, 1, nil)
+	if got := b.Line(0).String(); got != "世" {
+		t.Errorf("after DeleteCell(0,0,1), line 0 = %q, want %q\n%s", got, "世", dumpBuffer(b))
+	}
+}
+
+// cellbuf/2: a wide cell written over the placeholder of one wide cell and the head of another
+// leaves the second one's placeholder orphaned.
+func TestHegelPinWideOverTwoWidesLeavesAnOrphan(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 1)
+	b.SetCell(0, 0, NewCell('世'))
+	b.SetCell(2, 0, NewCell('界'))
+	b.SetCell(1, 0, NewCell('中'))
+	if c := b.Cell(3, 0); c.Empty() {
+		t.Errorf("cell 3 is an orphan placeholder, want a blank:\n%s", dumpBuffer(b))
+	}
+	if got, want := b.String(), " 中 "; strings.TrimRight(got, " ") != strings.TrimRight(want, " ") || len(b.Lines[0]) != 4 {
+		t.Errorf("String() = %q, want %q", got, want)
+	}
+}
+
+// cellbuf/3: Buffer.Resize cuts a line through a wide cell and leaves a head that does not fit.
+func TestHegelPinResizeCutsWideCells(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 1)
+	b.SetCell(2, 0, NewCell('世'))
+	b.Resize(3, 1)
+	if c := b.Cell(2, 0); c.Width != 1 {
+		t.Errorf("after shrinking to 3 columns, cell 2 = %s (width %d in the last column), want a blank\n%s", cellString(c), c.Width, dumpBuffer(b))
+	}
+}
+
+// cellbuf/4: TabStops index their bit words with col>>3 whatever the interval, so intervals
+// other than 8 alias columns and larger intervals index out of range.
+func TestHegelPinTabStopsAssumeInterval8(t *testing.T) {
+	defer guard(t)
+	ts := NewTabStops(16, 4)
+	ts.Reset(4)
+	if !ts.IsStop(0) {
+		t.Errorf("Reset(4) on a 4-column interval also cleared column 0")
+	}
+	ts = NewTabStops(16, 4)
+	ts.Set(5)
+	if ts.IsStop(1) {
+		t.Errorf("Set(5) on a 4-column interval also set column 1")
+	}
+	_ = NewTabStops(32, 16)
+}
+
+// cellbuf/5: TabStops.Set and Reset panic for a column at or beyond the width, while IsStop
+// answers false for it.
+func TestHegelPinTabStopsSetBeyondWidthPanics(t *testing.T) {
+	defer guard(t)
+	ts := DefaultTabStops(24)
+	if ts.IsStop(24) {
+		t.Errorf("IsStop(24) on width 24")
+	}
+	ts.Set(24)
+	ts.Reset(30)
+}
+
+// cellbuf/6: DiffSequence turns bold off with SGR 22, which also clears faint, and slow blink off
+// with SGR 25, which also clears rapid blink, without re-asserting the attribute still wanted.
+func TestHegelPinDiffSequenceDropsSiblingAttributes(t *testing.T) {
+	defer guard(t)
+	for _, c := range []struct {
+		from, to Style
+	}{
+		{Style{Attrs: BoldAttr | FaintAttr}, Style{Attrs: FaintAttr}},
+		{Style{Attrs: BoldAttr | FaintAttr}, Style{Attrs: BoldAttr}},
+		{Style{Attrs: SlowBlinkAttr | RapidBlinkAttr}, Style{Attrs: RapidBlinkAttr}},
+		{Style{Attrs: SlowBlinkAttr | RapidBlinkAttr}, Style{Attrs: SlowBlinkAttr}},
+		{Style{Attrs: FaintAttr}, Style{Attrs: BoldAttr}},
+		{Style{Attrs: RapidBlinkAttr}, Style{Attrs: SlowBlinkAttr}},
+	} {
+		var got Style
+		readSGR(c.from.Sequence(), &got, nil)
+		diff := c.to.DiffSequence(c.from)
+		readSGR(diff, &got, nil)
+		if !got.Equal(&c.to) {
+			t.Errorf("from %s, DiffSequence %q leaves %s, want %s", styleString(c.from), diff, styleString(got), styleString(c.to))
+		}
+	}
+}
+
+// cellbuf/7: NewCell is documented to take only the first combining rune, but its loop is dead
+// code and every rune is appended.
+func TestHegelPinNewCellAppendsEveryRune(t *testing.T) {
+	defer guard(t)
+	c := NewCell('a', 'b', 'c')
+	if len(c.Comb) != 0 || c.Width != 1 {
+		t.Errorf("NewCell('a','b','c') = %s, want a one-column cell %q", cellString(c), "a")
+	}
+}
+
+// cellbuf/9: a combining mark decoded on its own (x/ansi splits clusters with an ASCII base,
+// x-ansi/5) is attached to the following cell instead of the preceding one.
+func TestHegelPinCombiningMarkAttachesToTheNextCell(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 1)
+	SetContent(b, "e\u0301x")
+	if got := b.Cell(0, 0).String(); got != "e\u0301" {
+		t.Errorf("SetContent(%q): cell 0 = %q, want %q; cell 1 = %s", "e\u0301x", got, "e\u0301", cellString(b.Cell(1, 0)))
+	}
+	var out bytes.Buffer
+	s := NewScreen(&out, 4, 1, &ScreenOptions{Term: "xterm", AltScreen: true})
+	NewScreenWriter(s).SetContent("e\u0301x")
+	if got := s.Cell(0, 0).String(); got != "e\u0301" {
+		t.Errorf("ScreenWriter.SetContent(%q): cell 0 = %q, cell 1 = %s", "e\u0301x", got, cellString(s.Cell(1, 0)))
+	}
+}
+
+// cellbuf/10: the line and cell shift operations index the buffer with the rectangle's
+// coordinates without clipping them, and panic for a rectangle beyond the buffer.
+func TestHegelPinShiftRectsBeyondTheBufferPanic(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(4, 2)
+	b.InsertLineRect(0, 1, nil, Rect(0, 0, 6, 3))
+	b.DeleteLineRect(0, 1, nil, Rect(0, 0, 6, 3))
+	b.InsertCellRect(0, 0, 1, nil, Rect(0, 0, 6, 1))
+	b.DeleteCellRect(0, 0, 1, nil, Rect(0, 0, 6, 1))
+}
+
+// cellbuf/11: emitRange hands raw nil cells to putCell, which draws them as clearBlank(), a
+// space in the *current pen's* style and hyperlink — so a blank after a styled cell is painted
+// with that cell's background, underline and link on the terminal.
+func TestHegelPinBlankCellsInheritThePen(t *testing.T) {
+	defer guard(t)
+	// A terminal without the xterm capabilities (no ECH/REP) takes the putCell path.
+	var out bytes.Buffer
+	s := NewScreen(&out, 3, 1, &ScreenOptions{Term: "vt100", AltScreen: true})
+	e := vt.NewEmulator(3, 1)
+	s.SetCell(1, 0, NewCell('b'))
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	out.Reset()
+	s.Clear()
+	c := NewCell('_')
+	c.Style.Background(ansi.Red)
+	c.Link = Link{URL: "https://example.com"}
+	s.SetCell(0, 0, c)
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	if u := e.CellAt(1, 0); u == nil || !u.Style.IsZero() || !u.Link.IsZero() {
+		t.Errorf("after %q the blank at (1,0) has style %s link %v on the terminal", out.String(), uvStyleString(u.Style), u.Link)
+	}
+}
+
+// cellbuf/12: clearBottom moves to the row *above* the trailing blank region (`top-1`, with
+// top already 0-based) before erasing to the end of the screen, wiping a row of content that
+// is not redrawn unless it happened to be touched in the same frame.
+func TestHegelPinClearBottomErasesTheRowAbove(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	s := NewScreen(&out, 4, 3, &ScreenOptions{Term: "xterm", AltScreen: true})
+	sw := NewScreenWriter(s)
+	e := vt.NewEmulator(4, 3)
+	sw.SetContent("a\nb\nc")
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	out.Reset()
+	s.ClearRect(Rect(0, 2, 4, 1)) // only row 2 changes; row 1 is not touched
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	if u := e.CellAt(0, 1); u == nil || u.Content != "b" {
+		t.Errorf("after %q the terminal shows %q, the screen holds %q", out.String(), e.String(), s.newbuf.String())
+	}
+}
+
+// cellbuf/13: transformLine's `for next != nil && next.Empty()` never re-reads next, so Render
+// loops forever when a wide cell is drawn in column 0 over a row whose content sat only in
+// column 0. The reproduction runs in a child process with a timeout so that the hang cannot
+// take the test binary down.
+func TestHegelPinRenderHangsOnAWideCellInColumnZero(t *testing.T) {
+	defer guard(t)
+	if os.Getenv("CELLBUF_HANG_HELPER") == "1" {
+		var out bytes.Buffer
+		s := NewScreen(&out, 6, 1, &ScreenOptions{Term: "xterm", AltScreen: true})
+		sw := NewScreenWriter(s)
+		sw.SetContent("x")
+		s.Render()
+		_ = s.Flush()
+		sw.SetContent("世x")
+		s.Render()
+		_ = s.Flush()
+		return
+	}
+	cmd := exec.Command(os.Args[0], "-test.run", "^TestHegelPinRenderHangsOnAWideCellInColumnZero$", "-test.timeout", "5s")
+	cmd.Env = append(os.Environ(), "CELLBUF_HANG_HELPER=1")
+	outb, err := cmd.CombinedOutput()
+	if err != nil {
+		lines := strings.Split(strings.TrimSpace(string(outb)), "\n")
+		if len(lines) > 3 {
+			lines = lines[:3]
+		}
+		t.Fatalf("rendering %q over %q did not finish within 5 s: %v\n%s", "世x", "x", err, strings.Join(lines, "\n"))
+	}
+}
+
+// cellbuf/14: moveCursor's overwrite optimisation moves right by printing the cells it passes
+// over, and prints a plain space for the placeholder of a wide cell — which blanks that wide
+// cell on the terminal while the screen still believes it is there.
+func TestHegelPinOverwriteMoveBlanksWideCells(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	s := NewScreen(&out, 8, 2, &ScreenOptions{Term: "xterm", AltScreen: true})
+	sw := NewScreenWriter(s)
+	e := vt.NewEmulator(8, 2)
+	sw.SetContent("xx🫧yy\nabc")
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	out.Reset()
+	s.SetCell(4, 0, NewCell('z'))
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	if u := e.CellAt(2, 0); u == nil || u.Content != "🫧" {
+		t.Errorf("after %q the terminal shows %q, the screen holds %q", out.String(), e.String(), s.newbuf.String())
+	}
+}
+
+// cellbuf/15: emitRange uses REP for runes below 256, though its comment restricts the
+// optimisation to ASCII; Latin-1 letters such as ñ are multi-byte in UTF-8 and the monorepo's
+// own terminal emulator does not repeat them.
+func TestHegelPinRepeatUsedForLatin1(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	s := NewScreen(&out, 6, 1, &ScreenOptions{Term: "xterm", AltScreen: true})
+	NewScreenWriter(s).SetContent("ñññññ")
+	s.Render()
+	_ = s.Flush()
+	e := vt.NewEmulator(6, 1)
+	e.WriteString(out.String())
+	if got := e.String(); got != "ñññññ" {
+		t.Errorf("after %q the terminal shows %q", out.String(), got)
+	}
+}
+
+// cellbuf/16: DiffSequence of two equal, non-empty styles is the reset sequence, because an
+// ansi.Style with nothing in it renders as ResetStyle.
+func TestHegelPinDiffSequenceOfEqualStylesResets(t *testing.T) {
+	defer guard(t)
+	s := Style{Attrs: BoldAttr}
+	if diff := s.DiffSequence(s); diff != "" {
+		t.Errorf("Style{Bold}.DiffSequence(itself) = %q, want no sequence", diff)
+	}
+}
+
+// cellbuf/17: scrollUp without the SU capability (linux console, vt100, unknown TERM) writes
+// its newlines at the top row of the region, where they only move the cursor; the terminal is
+// never scrolled and keeps the old picture.
+func TestHegelPinScrollUpWithoutSUWritesNewlinesAtTheTop(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	s := NewScreen(&out, 2, 5, &ScreenOptions{Term: "linux", AltScreen: true})
+	sw := NewScreenWriter(s)
+	e := vt.NewEmulator(2, 5)
+	sw.SetContent("a\n\nb\n\n\n")
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	out.Reset()
+	sw.SetContent("b")
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	if got := strings.TrimRight(e.String(), " \n"); got != "b" {
+		t.Errorf("after scrolling up by two with %q the terminal shows %q, want \"b\" alone", out.String(), got)
+	}
+}
+
+// replayLine applies Screen output for a one-row screen to a line model that honours insert
+// mode (IRM), which the vt emulator does not implement. Only the sequences Screen emits for
+// such a frame are interpreted.
+func replayLine(width int, out string) []string {
+	line := make([]string, width)
+	for i := range line {
+		line[i] = " "
+	}
+	cur, irm := 0, false
+	for len(out) > 0 {
+		seq, w, n, _ := ansi.DecodeSequence(out, ansi.NormalState, nil)
+		out = out[n:]
+		switch {
+		case seq == "\r":
+			cur = 0
+		case seq == "\b":
+			cur = max(cur-1, 0)
+		case strings.HasPrefix(seq, "\x1b["):
+			final := seq[len(seq)-1]
+			params := seq[2 : len(seq)-1]
+			num := 1
+			if v, err := strconv.Atoi(params); err == nil {
+				num = v
+			}
+			switch final {
+			case 'h':
+				irm = irm || params == "4"
+			case 'l':
+				irm = irm && params != "4"
+			case 'D':
+				cur = max(cur-num, 0)
+			case 'C':
+				cur = min(cur+num, width-1)
+			case 'G', '`', 'H':
+				cur = min(num-1, width-1)
+			}
+		case w > 0 && cur+w <= width:
+			if irm {
+				line = append(line[:cur], append(make([]string, w), line[cur:]...)...)[:width]
+			}
+			line[cur] = seq
+			for i := 1; i < w; i++ {
+				line[cur+i] = ""
+			}
+			cur += w
+		}
+	}
+	return line
+}
+
+// cellbuf/18: on a terminal without ICH, transformLine's wide-cell adjustment moves the insert
+// point back onto the wide cell it has just written and inserts it a second time (in IRM), so
+// the row ends up with the wide cell twice and the cell that should follow it missing.
+func TestHegelPinInsertModeDuplicatesTheWideCell(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	s := NewScreen(&out, 8, 1, &ScreenOptions{Term: "vt100", AltScreen: true})
+	sw := NewScreenWriter(s)
+	sw.SetContent("世世世")
+	s.Render()
+	_ = s.Flush()
+	line := replayLine(8, out.String())
+	out.Reset()
+	sw.SetContent(" 世界世")
+	s.Render()
+	_ = s.Flush()
+	line = replayLine(8, strings.Join(line, "")+"\r"+out.String())
+	if got := strings.TrimRight(strings.Join(line, ""), " "); got != " 世界世" {
+		t.Errorf("after %q a terminal honouring IRM shows %q, want %q", out.String(), got, " 世界世")
+	}
+}
+
+// cellbuf/8: Wrap commits pending spaces to the current line before checking whether the
+// breakpoint that follows fits, so a full line gains a trailing space past the limit.
+func TestHegelPinWrapCountsTrailingSpaceAgainstTheLimit(t *testing.T) {
+	defer guard(t)
+	got := Wrap("xxxx -ba.", 4, "")
+	for _, line := range strings.Split(got, "\n") {
+		if w := ansi.StringWidth(line); w > 4 {
+			t.Errorf("Wrap(%q, 4, \"\") = %q: line %q has width %d > 4", "xxxx -ba.", got, line, w)
+		}
+	}
+}
+
+// cellbuf/19: transformLine's "last cells that really differ" loop stops on the wide head that
+// ends both lines, and the delete branch then moves onto the cell's placeholder and erases from
+// there, blanking the wide cell on the terminal.
+func TestHegelPinShortenedLinesLoseTheirLastWideCell(t *testing.T) {
+	defer guard(t)
+	var out bytes.Buffer
+	s := NewScreen(&out, 8, 1, &ScreenOptions{Term: "xterm", AltScreen: true})
+	sw := NewScreenWriter(s)
+	e := vt.NewEmulator(8, 1)
+	sw.SetContent("abcde\u4e16")
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	out.Reset()
+	sw.SetContent("ab\u4e16")
+	s.Render()
+	_ = s.Flush()
+	e.WriteString(out.String())
+	if got := strings.TrimRight(e.String(), " "); got != "ab\u4e16" {
+		t.Errorf("after %q the terminal shows %q, the screen holds %q", out.String(), got, s.newbuf.String())
+	}
+}
+
+// ---------------------------------------------------------------- fixed examples
+
+func TestHegelExamples(t *testing.T) {
+	defer guard(t)
+	b := NewBuffer(5, 2)
+	SetContent(b, "he世o\nab")
+	if got := b.String(); got != "he世o\r\nab" {
+		t.Errorf("String() = %q", got)
+	}
+	if got := Render(b); got != "he世o\r\nab" {
+		t.Errorf("Render() = %q", got)
+	}
+	if got := Wrap("The quick brown fox jumped over the lazy dog.", 20, ""); got != "The quick brown fox\njumped over the lazy\ndog." {
+		t.Errorf("Wrap = %q", got)
+	}
+	var out bytes.Buffer
+	s := NewScreen(&out, 6, 2, &ScreenOptions{Term: "xterm", AltScreen: true})
+	sw := NewScreenWriter(s)
+	sw.SetContent("he世lo\nab")
+	s.Render()
+	_ = s.Flush()
+	e := vt.NewEmulator(6, 2)
+	e.WriteString(out.String())
+	if got := e.String(); got != "he世lo\nab" {
+		t.Errorf("emulator shows %q after %q", got, out.String())
+	}
+}
diff --git a/cellbuf/hegel_screen_shapes_test.go b/cellbuf/hegel_screen_shapes_test.go
new file mode 100644
index 0000000..5f8b053
--- /dev/null
+++ b/cellbuf/hegel_screen_shapes_test.go
@@ -0,0 +1,769 @@
+package cellbuf
+
+// The eight narrow properties of the Screen family, one per bug of the family: each a
+// construction over random surroundings that forces the shape, kept to it by the family's
+// classifier (regionBy over screenShape: the predictors run on a private screen), judged by
+// the shared judge (judgeScreen against the emulator; judgeLine against a one-row line model
+// that honours IRM for cellbuf/18, which the emulator cannot judge), failing every run by
+// default and passing under HEGEL_NO_KNOWN=1 by drawing the region past the shape (hzShaped).
+// The /13 property's test is also the child process of a frame predicted to hang (its body is
+// hzScreenChildMain when HZ_SCREEN_CASE is set), for the wide property and for itself.
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the shared
+// ingredients
+
+// screenPlainCells is a narrow ASCII cell without a style or a link; plainLineOf a line of lo
+// to hi such atoms (no spaces, no sequences): the random surroundings, which must not form
+// another shape (a leak needs a style, a REP run a Latin-1 rune, a blanked wide cell a wide
+// one).
+var screenPlainCells = hegel.Map(evenHalves(hzASCIIAtoms...), hzGraphemeCell)
+
+func plainLineOf(lo, hi int) hegel.Generator[string] {
+	return hegel.Map(countedHalves(evenHalves(hzASCIIAtoms...), lo, hi), func(a []string) string { return strings.Join(a, "") })
+}
+
+// screenOptions are the three options at the wide property's rates (ShowCursor, HardTabs,
+// Backspace); screenPlainMoves the same with hard tabs off (a tab would jump the overwrite
+// move of cellbuf/14 past the placeholder).
+var (
+	screenOptions    = hzTuple(dieCoin(50), dieCoin(40), dieCoin(40))
+	screenPlainMoves = hzTuple(dieCoin(50), hegel.Just(false), dieCoin(40))
+)
+
+func screenCaseOf(w, h int, term string, opts []bool, grapheme bool, frames ...frame) screenCase {
+	return screenCase{w: w, h: h, term: term, showCursor: opts[0], hardTabs: opts[1], backspace: opts[2], grapheme: grapheme, frames: frames}
+}
+
+// otherAtom is an ASCII atom other than s (the next in the list).
+func otherAtom(s string) string {
+	for i, a := range hzASCIIAtoms {
+		if a == s {
+			return hzASCIIAtoms[(i+1)%len(hzASCIIAtoms)]
+		}
+	}
+	return hzASCIIAtoms[0]
+}
+
+// --------------------------------------------------------------------------- cellbuf/11
+
+// visibleCells is a narrow ASCII cell with a style or a link the emulator shows on a blank
+// (hzPenVisible): a style from screenStyles and a link from links, the background set to a
+// drawn basic colour when neither is visible (the degenerate instances rendered away, not
+// filtered).
+var visibleCells = hegel.Map(hzTuple[any](
+	hegel.Map(evenHalves(hzASCIIAtoms...), func(s string) any { return s }),
+	hegel.Map(screenStyles, func(s Style) any { return s }),
+	hegel.Map(links, func(l Link) any { return l }),
+	hegel.Map(rangeHalves(0, 15), func(n int) any { return n }),
+), func(v []any) *Cell {
+	c := hzGraphemeCell(v[0].(string))
+	c.Style, c.Link = v[1].(Style), v[2].(Link)
+	if !hzPenVisible(c.Style, c.Link) {
+		c.Style.Bg = ansi.BasicColor(v[3].(int))
+	}
+	return c
+})
+
+// blanksAfterStyledCases: a 4-12 x 1-3 screen on any TERM showing, after a first frame of
+// plain text, two plain cells at (x, y) and (x+2, y) with nothing between and the row's last
+// column blank (the old content; a row whose last column holds content takes transformLine's
+// lower-right path, screen.go 1005-1020, which emits the changed cells alone), then a
+// SetCells frame of a styled or linked cell at (x, y) alone, among 0 to 3 plain cells on the
+// other rows: the loop "find the last cells that really differ" (1063) stops on the last
+// equal pair, the blank at x+1, so the range transformLine emits ends on the blank
+// (putRange(firstCell, n), 1076), and emitRange hands that last blank to putCell as `cell0 :=
+// line[0]`, the nil (753-757), on every TERM. (On vt100 alone, whose el0Cost is not zero,
+// 917, a blank that is the old line's last cell past the new one takes the same path,
+// 1045-1056; a blank between two cells that differ goes through Line.At's plain BlankCell,
+// 747, and a run of two or more blanks through Line.At too, 802.) Under HEGEL_NO_KNOWN=1
+// the styled cell is plain, or the blank is an explicit space cell in the styled cell's
+// style and link.
+var blanksAfterStyledCases = regionBy("cellbuf/11", screenShape, blanksAfterStyledRaw)
+
+var blanksAfterStyledRaw = hegel.FlatMap(hzTuple(rangeHalves(4, 12), rangeHalves(1, 3)), func(d []int) hegel.Generator[screenCase] {
+	w, h := d[0], d[1]
+	return hegel.Composite(func(tc hegel.TestCase) screenCase {
+		term := hegel.Draw(tc, evenHalves(hzScreenTerms...))
+		opts := hegel.Draw(tc, screenOptions)
+		x := hegel.Draw(tc, rangeHalves(0, w-4))
+		y := hegel.Draw(tc, rangeHalves(0, h-1))
+		old := hegel.Draw(tc, hzCounted(screenPlainCells, 2, 2))
+		styled := hegel.Draw(tc, visibleCells)
+		variant := hegel.Draw(tc, hzShaped(hegel.Just(0), evenHalves(1, 2))) // past the shape: 1 the cell plain, 2 the blank a styled space
+		around := hegel.Draw(tc, countedHalves(setCellsAt(w, h, screenPlainCells), 0, 3))
+		lines := hegel.Draw(tc, hzCounted(plainLineOf(0, w), h, h))
+		lines[y] = "" // row y holds the two old cells alone, so that the range ends on the blank between them
+		if styled.String() == old[0].String() {
+			styled.Rune = rune(otherAtom(old[0].String())[0])
+		}
+		var cells []setCell
+		for _, c := range around {
+			if c.y != y {
+				cells = append(cells, c)
+			}
+		}
+		if variant == 1 {
+			styled.Style, styled.Link = Style{}, Link{}
+		}
+		cells = append(cells, setCell{x: x, y: y, cell: styled})
+		if variant == 2 {
+			cells = append(cells, setCell{x: x + 1, y: y, cell: &Cell{Rune: ' ', Width: 1, Style: styled.Style, Link: styled.Link}})
+		}
+		return screenCaseOf(w, h, term, opts, hegel.Draw(tc, dieCoin(50)),
+			frame{kind: "SetContent", text: strings.Join(lines, "\n")},
+			frame{kind: "SetCells", cells: []setCell{{x: x, y: y, cell: old[0]}, {x: x + 2, y: y, cell: old[1]}}},
+			frame{kind: "SetCells", cells: cells})
+	})
+})
+
+// TestHegelBlanksAfterStyledCellsStayPlain: a blank drawn right after a styled or linked
+// cell stays plain on the terminal (cellbuf/11: emitRange hands the nil to putCell, which
+// draws clearBlank(), a space in the pen's style and link); under HEGEL_NO_KNOWN=1 the cell
+// before is plain or the blank is a styled space cell.
+func TestHegelBlanksAfterStyledCellsStayPlain(t *testing.T) {
+	judged(t, blanksAfterStyledCases, judgeScreen)
+}
+
+// --------------------------------------------------------------------------- cellbuf/12
+
+// clearedBottomCases: a 2-10 x 3-6 screen with content on every row, then a ClearRect of
+// the bottom k rows (1 to h-2) alone, the row above untouched; under HEGEL_NO_KNOWN=1 the row
+// above is empty, or the second frame is a SetContent of the picture without the bottom rows
+// (every row touched, the row above repainted).
+var clearedBottomCases = regionBy("cellbuf/12", screenShape, hegel.FlatMap(hzTuple(rangeHalves(2, 10), rangeHalves(3, 6)), func(d []int) hegel.Generator[screenCase] {
+	w, h := d[0], d[1]
+	return hegel.Composite(func(tc hegel.TestCase) screenCase {
+		term := hegel.Draw(tc, evenHalves(hzScreenTerms...))
+		opts := hegel.Draw(tc, screenOptions)
+		lines := hegel.Draw(tc, hzCounted(plainLineOf(1, w), h, h))
+		k := hegel.Draw(tc, rangeHalves(1, h-2))
+		variant := hegel.Draw(tc, hzShaped(hegel.Just(0), evenHalves(1, 2))) // past the shape: 1 the row above empty, 2 every row touched
+		if variant == 1 {
+			lines[h-k-1] = ""
+		}
+		second := frame{kind: "ClearRect", rect: Rect(0, h-k, w, k)}
+		if variant == 2 {
+			second = frame{kind: "SetContent", text: strings.Join(lines[:h-k], "\n")}
+		}
+		return screenCaseOf(w, h, term, opts, hegel.Draw(tc, dieCoin(50)), frame{kind: "SetContent", text: strings.Join(lines, "\n")}, second)
+	})
+}))
+
+// TestHegelClearedBottomRowsKeepTheRowAbove: blanking the bottom rows of the screen leaves
+// the row above them on the terminal (cellbuf/12: clearBottom moves to the row above the
+// blank region before erasing to the end of the screen, and that row is never repainted
+// unless the frame touched it); under HEGEL_NO_KNOWN=1 the row above is empty or touched.
+func TestHegelClearedBottomRowsKeepTheRowAbove(t *testing.T) {
+	judged(t, clearedBottomCases, judgeScreen)
+}
+
+// --------------------------------------------------------------------------- cellbuf/13
+
+// wideInColumnZeroCases: a 4-10 x 1-4 screen showing, on row y, one narrow cell in column
+// 0 (the other rows plain text, the same in both frames), then the same row with a wide cell
+// in column 0 before that cell; under HEGEL_NO_KNOWN=1 the wide cell is in column 1, after a
+// space.
+var wideInColumnZeroCases = regionBy("cellbuf/13", screenShape, hegel.FlatMap(hzTuple(rangeHalves(4, 10), rangeHalves(1, 4)), func(d []int) hegel.Generator[screenCase] {
+	w, h := d[0], d[1]
+	return hegel.Composite(func(tc hegel.TestCase) screenCase {
+		term := hegel.Draw(tc, evenHalves(hzScreenTerms...))
+		opts := hegel.Draw(tc, screenOptions)
+		y := hegel.Draw(tc, rangeHalves(0, h-1))
+		c := hegel.Draw(tc, evenHalves(hzASCIIAtoms...))
+		wide := hegel.Draw(tc, evenHalves(hzWideAtoms...))
+		rows := hegel.Draw(tc, hzCounted(plainLineOf(0, w), h, h))
+		first := slices.Clone(rows)
+		first[y] = c
+		second := slices.Clone(rows)
+		second[y] = hzShaped(wide+c, " "+wide+c)
+		return screenCaseOf(w, h, term, opts, hegel.Draw(tc, dieCoin(50)),
+			frame{kind: "SetContent", text: strings.Join(first, "\n")},
+			frame{kind: "SetContent", text: strings.Join(second, "\n")})
+	})
+}))
+
+// TestHegelWideCellsInColumnZeroRender: a wide cell drawn in column 0 over a row whose only
+// content was that column renders (cellbuf/13: transformLine's insert branch never re-reads
+// the cell after the head and loops forever; the frame is judged in a child process with a
+// deadline, hzScreenChild); under HEGEL_NO_KNOWN=1 the wide cell is in column 1. The test
+// body is the child's half when HZ_SCREEN_CASE is set.
+func TestHegelWideCellsInColumnZeroRender(t *testing.T) {
+	if text := os.Getenv("HZ_SCREEN_CASE"); text != "" {
+		hzScreenChildMain(text, os.Getenv("HZ_SCREEN_FRAME"))
+		return
+	}
+	judged(t, wideInColumnZeroCases, judgeScreen)
+}
+
+// --------------------------------------------------------------------------- cellbuf/14
+
+// cursorOverWideCases: a 5-12 x 2-4 screen (hard tabs off) whose row y0 is p plain cells,
+// a wide cell at p and plain cells or spaces to the end, and whose last row with content, y1
+// below it, has p+1 plain cells so that the cursor ends at column p+1 of y1 (the wide cell's
+// placeholder column); then a SetCell of a different plain cell at q (p+2 to p+4, within
+// the width) on y0, which the cursor reaches by an overwrite move over the placeholder (one
+// to three cells, shorter than CUF). Under HEGEL_NO_KNOWN=1 the change is left of the wide
+// cell (q below p), or two narrow cells stand in the wide cell's place.
+var cursorOverWideCases = regionBy("cellbuf/14", screenShape, hegel.FlatMap(hzTuple(rangeHalves(5, 12), rangeHalves(2, 4)), func(d []int) hegel.Generator[screenCase] {
+	w, h := d[0], d[1]
+	return hegel.Composite(func(tc hegel.TestCase) screenCase {
+		term := hegel.Draw(tc, evenHalves(hzScreenTerms...))
+		opts := hegel.Draw(tc, screenPlainMoves)
+		y0 := hegel.Draw(tc, rangeHalves(0, h-2))
+		y1 := hegel.Draw(tc, rangeHalves(y0+1, h-1))
+		p := hegel.Draw(tc, rangeHalves(0, w-3))
+		prefix := hegel.Draw(tc, hzCounted(evenHalves(hzASCIIAtoms...), p, p))
+		wide := hegel.Draw(tc, evenHalves(hzWideAtoms...))
+		suffix := hegel.Draw(tc, hzCounted(evenHalves(append([]string{" "}, hzASCIIAtoms...)...), w-p-2, w-p-2))
+		q := hegel.Draw(tc, rangeHalves(p+2, min(p+4, w-1)))
+		z := hegel.Draw(tc, evenHalves(hzASCIIAtoms...))
+		below := hegel.Draw(tc, hzCounted(evenHalves(hzASCIIAtoms...), p+1, p+1))
+		rows := hegel.Draw(tc, hzCounted(plainLineOf(0, w), h, h))
+		variant := hegel.Draw(tc, hzShaped(hegel.Just(0), evenHalves(1, 2))) // past the shape: 1 the change left of the wide cell, 2 narrow cells in its place
+		left := hegel.Draw(tc, rangeHalves(0, max(p-1, 0)))
+		if variant == 1 && p == 0 { // nothing left of the wide cell: the other region
+			variant = 2
+		}
+		middle := wide
+		if variant == 2 {
+			middle = hegel.Draw(tc, evenHalves(hzASCIIAtoms...)) + hegel.Draw(tc, evenHalves(hzASCIIAtoms...))
+		}
+		rows[y0] = strings.Join(prefix, "") + middle + strings.Join(suffix, "")
+		rows[y1] = strings.Join(below, "")
