+// ---------------------------------------------------------------- styles
+
+// readSGR applies every SGR sequence in seq to st, and every hyperlink to ln.
+func readSGR(seq string, st *Style, ln *Link) {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var state byte
+	for len(seq) > 0 {
+		sq, _, k, ns := ansi.DecodeSequence(seq, state, p)
+		if ansi.HasCsiPrefix(sq) && p.Command() == 'm' {
+			ReadStyle(p.Params(), st)
+		} else if ansi.HasOscPrefix(sq) && p.Command() == 8 && ln != nil {
+			ReadLink(p.Data(), ln)
+		}
+		seq = seq[k:]
+		state = ns
+	}
+}
+
+func TestHegelStyleSequencesRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s, o := genStyle(ht), genStyle(ht)
+		note(ht, "s=%s o=%s", styleString(s), styleString(o))
+		var got Style
+		readSGR(s.Sequence(), &got, nil)
+		if !got.Equal(&s) {
+			fail(ht, "ReadStyle(%q) = %s, want %s", s.Sequence(), styleString(got), styleString(s))
+		}
+		if s.Empty() && s.Sequence() != ansi.ResetStyle {
+			fail(ht, "empty style's Sequence = %q", s.Sequence())
+		}
+		if got := s.Equal(&s); !got {
+			fail(ht, "style not equal to itself")
+		}
+		var viaDiff Style
+		readSGR(o.Sequence(), &viaDiff, nil)
+		diff := s.DiffSequence(o)
+		readSGR(diff, &viaDiff, nil)
+		if s.Equal(&o) && !s.Empty() {
+			count("equal-styles-skipped") // cellbuf/16: the diff of equal styles is a reset
+		} else if lossyDiff(s, o) {
+			count("lossy-diff-skipped") // cellbuf/6
+		} else if !viaDiff.Equal(&s) {
+			fail(ht, "o=%s then DiffSequence %q gives %s, want s=%s", styleString(o), diff, styleString(viaDiff), styleString(s))
+		}
+		count("ok")
+	})
+}
+
+// sgrParam is one SGR parameter (or colon-joined subparameters) and its effect.
+type sgrParam struct {
+	text  string
+	apply func(*Style)
+}
+
+func genSGRParam(tc hegel.TestCase) sgrParam {
+	switch n(tc, 0, 12) {
+	case 0:
+		return sgrParam{"0", func(s *Style) { s.Reset() }}
+	case 1:
+		k := n(tc, 1, 9)
+		switch k {
+		case 4:
+			return sgrParam{"4", func(s *Style) { s.UlStyle = SingleUnderline }}
+		default:
+			attr := map[int]AttrMask{1: BoldAttr, 2: FaintAttr, 3: ItalicAttr, 5: SlowBlinkAttr, 6: RapidBlinkAttr, 7: ReverseAttr, 8: ConcealAttr, 9: StrikethroughAttr}[k]
+			return sgrParam{strconv.Itoa(k), func(s *Style) { s.Attrs |= attr }}
+		}
+	case 2:
+		k := n(tc, 0, 5)
+		return sgrParam{"4:" + strconv.Itoa(k), func(s *Style) { s.UlStyle = UnderlineStyle(k) }}
+	case 3:
+		k := pick(tc, []int{22, 23, 24, 25, 27, 28, 29})
+		return sgrParam{strconv.Itoa(k), func(s *Style) {
+			switch k {
+			case 22:
+				s.Attrs &^= BoldAttr | FaintAttr
+			case 23:
+				s.Attrs &^= ItalicAttr
+			case 24:
+				s.UlStyle = NoUnderline
+			case 25:
+				s.Attrs &^= SlowBlinkAttr | RapidBlinkAttr
+			case 27:
+				s.Attrs &^= ReverseAttr
+			case 28:
+				s.Attrs &^= ConcealAttr
+			case 29:
+				s.Attrs &^= StrikethroughAttr
+			}
+		}}
+	case 4:
+		k := n(tc, 0, 7)
+		return sgrParam{strconv.Itoa(30 + k), func(s *Style) { s.Fg = ansi.BasicColor(k) }}
+	case 5:
+		k := n(tc, 0, 7)
+		return sgrParam{strconv.Itoa(40 + k), func(s *Style) { s.Bg = ansi.BasicColor(k) }}
+	case 6:
+		k := n(tc, 0, 7)
+		return sgrParam{strconv.Itoa(90 + k), func(s *Style) { s.Fg = ansi.BasicColor(8 + k) }}
+	case 7:
+		k := n(tc, 0, 7)
+		return sgrParam{strconv.Itoa(100 + k), func(s *Style) { s.Bg = ansi.BasicColor(8 + k) }}
+	case 8:
+		return sgrParam{"39", func(s *Style) { s.Fg = nil }}
+	case 9:
+		return sgrParam{"49", func(s *Style) { s.Bg = nil }}
+	case 10:
+		return sgrParam{"59", func(s *Style) { s.Ul = nil }}
+	case 11:
+		base := pick(tc, []int{38, 48, 58})
+		k := n(tc, 0, 255)
+		text := fmt.Sprintf("%d;5;%d", base, k)
+		if chance(tc, 50) {
+			text = fmt.Sprintf("%d:5:%d", base, k)
+		}
+		c := ansi.ExtendedColor(k)
+		return sgrParam{text, func(s *Style) { setColor(s, base, c) }}
+	default:
+		base := pick(tc, []int{38, 48, 58})
+		r, g, bl := n(tc, 0, 255), n(tc, 0, 255), n(tc, 0, 255)
+		text := fmt.Sprintf("%d;2;%d;%d;%d", base, r, g, bl)
+		switch n(tc, 0, 2) {
+		case 1:
+			text = fmt.Sprintf("%d:2:%d:%d:%d", base, r, g, bl)
+		case 2:
+			text = fmt.Sprintf("%d:2::%d:%d:%d", base, r, g, bl) // empty colour-space id
+		}
+		c := color.RGBA{R: uint8(r), G: uint8(g), B: uint8(bl), A: 0xff}
+		return sgrParam{text, func(s *Style) { setColor(s, base, c) }}
+	}
+}
+
+func setColor(s *Style, base int, c ansi.Color) {
+	switch base {
+	case 38:
+		s.Fg = c
+	case 48:
+		s.Bg = c
+	default:
+		s.Ul = c
+	}
+}
+
+func TestHegelReadStyleFollowsTheSGRTable(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var texts []string
+		var want Style
+		if chance(ht, 30) {
+			want = genStyle(ht)
+		}
+		got := want
+		for k := n(ht, 0, 6); k > 0; k-- {
+			p := genSGRParam(ht)
+			texts = append(texts, p.text)
+			p.apply(&want)
+		}
+		seq := "\x1b[" + strings.Join(texts, ";") + "m"
+		if len(texts) == 0 {
+			want.Reset()
+		}
+		note(ht, "seq %q", seq)
+		readSGR(seq, &got, nil)
+		if !got.Equal(&want) {
+			fail(ht, "ReadStyle(%q) = %s, want %s", seq, styleString(got), styleString(want))
+		}
+		if len(texts) == 0 {
+			// CSI m with no parameters is a reset.
+			if !got.Empty() {
+				fail(ht, "ReadStyle of %q did not reset: %s", seq, styleString(got))
+			}
+		}
+		count("ok")
+	})
+}
