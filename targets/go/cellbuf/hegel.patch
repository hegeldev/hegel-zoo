+			q, at = left, prefix[left]
+		}
+		if z == at {
+			z = otherAtom(at)
+		}
+		return screenCaseOf(w, h, term, opts, hegel.Draw(tc, dieCoin(50)),
+			frame{kind: "SetContent", text: strings.Join(rows, "\n")},
+			frame{kind: "SetCells", cells: []setCell{{x: q, y: y0, cell: hzGraphemeCell(z)}}})
+	})
+}))
