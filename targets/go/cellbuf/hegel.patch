+// cellbuf/13: transformLine's `for next != nil && next.Empty()` never re-reads next, so Render
+// loops forever when a wide cell is drawn in column 0 over a row whose content sat only in
+// column 0. The reproduction runs in a child process with a timeout so that the hang cannot
+// take the test binary down.
+func TestHegelPinRenderHangsOnAWideCellInColumnZero(t *testing.T) {
+	defer guard(t)
+	if os.Getenv("CELLBUF_HANG_HELPER") == "1" {
+		var out bytes.Buffer
+		s := NewScreen(&out, 6, 1, &ScreenOptions{Term: "xterm", AltScreen: true})
+		sw := NewScreenWriter(s)
+		sw.SetContent("x")
+		s.Render()
+		_ = s.Flush()
+		sw.SetContent("世x")
+		s.Render()
+		_ = s.Flush()
+		return
+	}
+	cmd := exec.Command(os.Args[0], "-test.run", "^TestHegelPinRenderHangsOnAWideCellInColumnZero$", "-test.timeout", "5s")
+	cmd.Env = append(os.Environ(), "CELLBUF_HANG_HELPER=1")
+	outb, err := cmd.CombinedOutput()
+	if err != nil {
+		lines := strings.Split(strings.TrimSpace(string(outb)), "\n")
+		if len(lines) > 3 {
+			lines = lines[:3]
+		}
+		t.Fatalf("rendering %q over %q did not finish within 5 s: %v\n%s", "世x", "x", err, strings.Join(lines, "\n"))
+	}
+}
