+// ---------------------------------------------------------------- the old harness
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("CELLBUF_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			statsMu.Lock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			stats = map[string]int{}
+			statsMu.Unlock()
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(collectedMsgs), sb.String())
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if collecting {
+				collectedMu.Lock()
+				collectedMsgs = append(collectedMsgs, fmt.Sprintf("panic in the code under test: %v", r))
+				collectedMu.Unlock()
+				return
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var (
+	statsMu sync.Mutex
+	stats   = map[string]int{}
+)
+
+func count(name string) {
+	statsMu.Lock()
+	stats[name]++
+	statsMu.Unlock()
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------- the old generators
+
+var (
+	// Combining sequences with an ASCII base ("e\u0301") are split by x/ansi's decoder (x-ansi/5)
+	// and pinned as cellbuf/9; the Thai cluster has a non-ASCII base.
+	narrowGraphemes = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "é", "ñ", "ก\u0e49"}
+	wideGraphemes   = []string{"世", "界", "中", "文", "日", "本", "😃", "🫧", "Ａ"}
+)
+
+func genGrapheme(tc hegel.TestCase, allowWide bool) string {
+	if allowWide && chance(tc, 30) {
+		return pick(tc, wideGraphemes)
+	}
+	return pick(tc, narrowGraphemes)
+}
+
+func genColor(tc hegel.TestCase) ansi.Color {
+	switch n(tc, 0, 3) {
+	case 0:
+		return nil
+	case 1:
+		return ansi.BasicColor(n(tc, 0, 15))
+	case 2:
+		return ansi.ExtendedColor(n(tc, 16, 255))
+	default:
+		return color.RGBA{R: uint8(n(tc, 0, 255)), G: uint8(n(tc, 0, 255)), B: uint8(n(tc, 0, 255)), A: 0xff}
+	}
+}
+
+// genStyleOpt draws a style; noSiblings leaves out faint and rapid blink, whose SGR off codes
+// (22, 25) also clear bold and slow blink (cellbuf/6).
+func genStyleOpt(tc hegel.TestCase, noSiblings bool) Style {
+	var s Style
+	if chance(tc, 40) {
+		return s
+	}
+	s.Attrs = AttrMask(n(tc, 0, 255))
+	if chance(tc, 50) {
+		s.Attrs = AttrMask(1 << n(tc, 0, 7))
+	}
+	if noSiblings {
+		s.Attrs &^= FaintAttr | RapidBlinkAttr
+	}
+	if chance(tc, 30) {
+		s.UlStyle = UnderlineStyle(n(tc, 0, 5))
+	}
+	s.Fg = genColor(tc)
+	s.Bg = genColor(tc)
+	if chance(tc, 20) {
+		s.Ul = genColor(tc)
+	}
+	return s
+}
+
+func genLink(tc hegel.TestCase) Link {
+	if chance(tc, 80) {
+		return Link{}
+	}
+	l := Link{URL: fmt.Sprintf("https://example.com/%d", n(tc, 0, 9))}
+	if chance(tc, 30) {
+		l.Params = fmt.Sprintf("id=%d", n(tc, 0, 9))
+	}
+	return l
+}
+
+func genCellOpt(tc hegel.TestCase, allowWide, noSiblings bool) *Cell {
+	if chance(tc, 25) {
+		return nil
+	}
+	c := NewGraphemeCell(genGrapheme(tc, allowWide))
+	if chance(tc, 10) {
+		c = NewCell(' ')
+	}
+	c.Style = genStyleOpt(tc, noSiblings)
+	c.Link = genLink(tc)
+	return c
+}
+
+func genRect(tc hegel.TestCase, w, h int) Rectangle {
+	x0, y0 := n(tc, 0, max(w-1, 0)), n(tc, 0, max(h-1, 0))
+	return Rect(x0, y0, n(tc, 0, w-x0), n(tc, 0, h-y0))
+}
+
+// ---------------------------------------------------------------- Screen vs the vt emulator
+
+func genText(tc hegel.TestCase, w int, lines int, combiningOK bool) string {
+	var sb strings.Builder
+	for i := 0; i < lines; i++ {
+		if i > 0 {
+			sb.WriteString(pick(tc, []string{"\n", "\r\n"}))
+		}
+		for k := n(tc, 0, w+2); k > 0; k-- {
+			switch n(tc, 0, 7) {
+			case 0:
+				sb.WriteString(genStyleOpt(tc, true).Sequence())
+			case 1:
+				sb.WriteString("\x1b[m")
+			case 2:
+				l := genLink(tc)
+				sb.WriteString(ansi.SetHyperlink(l.URL, l.Params))
+			case 3:
+				sb.WriteString(" ")
+			default:
+				g := genGrapheme(tc, true)
+				if !combiningOK {
+					for len([]rune(g)) > 1 {
+						g = genGrapheme(tc, true)
+					}
+				}
+				sb.WriteString(g)
+			}
+		}
+	}
+	return sb.String()
+}
+
+func uvStyleString(s uv.Style) string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b uls:%d}", s.Fg, s.Bg, s.UnderlineColor, s.Attrs, s.Underline)
+}
+
+// clearBottomOffByOne reports whether the next render will run clearBottom's erase from the
+// row above the trailing blank region while that row holds untouched content (cellbuf/12).
+func clearBottomOffByOne(s *Screen) bool {
+	total := s.newbuf.Height()
+	blankRow := func(b *Buffer, y int) bool {
+		l := b.Line(y)
+		if len(l) != s.newbuf.Width() {
+			return false
+		}
+		for x := 0; x < s.newbuf.Width(); x++ {
+			if !cellEqual(l.At(x), &BlankCell) {
+				return false
+			}
+		}
+		return true
+	}
+	top := total
+	for row := total - 1; row >= 0; row-- {
+		if !blankRow(s.newbuf, row) {
+			break
+		}
+		if !blankRow(s.curbuf, row) {
+			top = row
+		}
+	}
+	if top >= total || top < 1 {
+		return false
+	}
+	_, touched := s.touch[top-1]
+	return !touched && !blankRow(s.newbuf, top-1)
+}
+
+// cloneLine deep-copies a line so a replay cannot touch the screen's own cells.
+func cloneLine(l Line) Line {
+	n := make(Line, len(l))
+	for x, c := range l {
+		if c != nil {
+			n[x] = c.Clone()
+		}
+	}
+	return n
+}
+
+func cloneBuffer(b *Buffer) *Buffer {
+	c := &Buffer{Lines: make([]Line, len(b.Lines))}
+	for y, l := range b.Lines {
+		c.Lines[y] = cloneLine(l)
+	}
+	return c
+}
+
+// transformLineWouldHang replays transformLine's arithmetic (cellbuf/13) for row y without
+// side effects and reports whether it would reach the loop that never re-reads `next`.
+func transformLineWouldHang(s *Screen, y int) bool {
+	oldLine := cloneLine(s.curbuf.Line(y))
+	newLine := s.newbuf.Line(y)
+	width := s.newbuf.Width()
+	var firstCell int
+	blank := newLine.At(0)
+	if blank == nil || blank.Clear() {
+		var oFirstCell, nFirstCell int
+		for oFirstCell = range s.curbuf.Width() {
+			if !cellEqual(oldLine.At(oFirstCell), blank) {
+				break
+			}
+		}
+		for nFirstCell = range width {
+			if !cellEqual(newLine.At(nFirstCell), blank) {
+				break
+			}
+		}
+		switch {
+		case nFirstCell == oFirstCell:
+			firstCell = nFirstCell
+			for firstCell < width && cellEqual(oldLine.At(firstCell), newLine.At(firstCell)) {
+				firstCell++
+			}
+		case oFirstCell > nFirstCell:
+			firstCell = nFirstCell
+		default:
+			firstCell = oFirstCell
+			if len(ansi.EraseLineLeft) < nFirstCell-oFirstCell {
+				for firstCell < nFirstCell {
+					oldLine.Set(firstCell, blank)
+					firstCell++
+				}
+			}
+		}
+	} else {
+		for firstCell < width && cellEqual(newLine.At(firstCell), oldLine.At(firstCell)) {
+			firstCell++
+		}
+	}
+	if firstCell >= width {
+		return false
+	}
+	blank = newLine.At(width - 1)
+	if blank != nil && !blank.Clear() {
+		return false
+	}
+	oLastCell := s.curbuf.Width() - 1
+	for oLastCell > firstCell && cellEqual(oldLine.At(oLastCell), blank) {
+		oLastCell--
+	}
+	nLastCell := width - 1
+	for nLastCell > firstCell && cellEqual(newLine.At(nLastCell), blank) {
+		nLastCell--
+	}
+	if nLastCell == firstCell && s.el0Cost() < oLastCell-nLastCell {
+		return false
+	}
+	if nLastCell != oLastCell && !cellEqual(newLine.At(nLastCell), oldLine.At(oLastCell)) {
+		return false
+	}
+	for cellEqual(newLine.At(nLastCell), oldLine.At(oLastCell)) {
+		if !cellEqual(newLine.At(nLastCell-1), oldLine.At(oLastCell-1)) {
+			break
+		}
+		nLastCell--
+		oLastCell--
+		if nLastCell == -1 || oLastCell == -1 {
+			break
+		}
+	}
+	n := min(oLastCell, nLastCell)
+	if oLastCell >= nLastCell || n != 0 || n < firstCell {
+		return false
+	}
+	head := newLine.At(n)
+	if head == nil || head.Width <= 1 {
+		return false
+	}
+	next := newLine.At(n + 1)
+	return next != nil && next.Empty()
+}
+
+var scrollUpSeq = regexp.MustCompile(`\x1b\[([0-9]*)S`)
+
+// renderReplay replays Render's line loop (scroll optimisation, clearBottom, transformLine in
+// order) on a deep copy of the screen. hang reports whether some row would hang (cellbuf/13);
+// scrollUp reports whether the scroll optimisation would scroll up by two or more lines on a
+// terminal without SU, where scrollUp writes its newlines at the top row (cellbuf/17). The
+// replay runs the scroll optimisation with SU switched on so the scroll shows up as CSI S; the
+// capability set is restored before the lines are replayed.
+func renderReplay(s *Screen) (hang, scrollUp bool) {
+	c := &Screen{
+		w:             io.Discard,
+		buf:           &bytes.Buffer{},
+		curbuf:        cloneBuffer(s.curbuf),
+		newbuf:        cloneBuffer(s.newbuf),
+		tabs:          s.tabs,
+		touch:         maps.Clone(s.touch),
+		oldhash:       slices.Clone(s.oldhash),
+		newhash:       slices.Clone(s.newhash),
+		hashtab:       slices.Clone(s.hashtab),
+		oldnum:        slices.Clone(s.oldnum),
+		cur:           s.cur,
+		saved:         s.saved,
+		opts:          s.opts,
+		method:        s.method,
+		scrollHeight:  s.scrollHeight,
+		altScreenMode: s.altScreenMode,
+		cursorHidden:  s.cursorHidden,
+		clear:         s.clear,
+		caps:          s.caps,
+		queuedText:    s.queuedText,
+		atPhantom:     s.atPhantom,
+	}
+	var nonEmpty int
+	switch {
+	case c.clear:
+		if c.opts.AltScreen {
+			nonEmpty = max(c.curbuf.Height(), c.newbuf.Height())
+			c.clearScreen(c.clearBlank())
+		} else {
+			nonEmpty = c.newbuf.Height()
+			c.clearBelow(c.clearBlank(), 0)
+		}
+		nonEmpty = c.clearBottom(nonEmpty)
+		for i := range nonEmpty {
+			if transformLineWouldHang(c, i) {
+				return true, scrollUp
+			}
+			c.transformLine(i)
+		}
+	case len(c.touch) > 0:
+		if c.opts.AltScreen {
+			c.caps |= capSU
+			c.scrollOptimize()
+			c.caps = s.caps
+			if !s.caps.Contains(capSU) {
+				for _, m := range scrollUpSeq.FindAllStringSubmatch(c.buf.String(), -1) {
+					if m[1] != "" && m[1] != "1" {
+						scrollUp = true
+					}
+				}
+			}
+			c.buf.Reset()
+			nonEmpty = min(c.curbuf.Height(), c.newbuf.Height())
+		} else {
+			nonEmpty = c.newbuf.Height()
+		}
+		nonEmpty = c.clearBottom(nonEmpty)
+		for i := range nonEmpty {
+			if _, ok := c.touch[i]; !ok {
+				continue
+			}
+			if transformLineWouldHang(c, i) {
+				return true, scrollUp
+			}
+			c.transformLine(i)
+		}
+	}
+	return false, scrollUp
+}
+
+var (
+	dchOrIch  = regexp.MustCompile(`\x1b\[[0-9]*[P@]`)
+	irmOn     = regexp.MustCompile(`\x1b\[4h`)
+	latin1Rep = regexp.MustCompile(`[\x80-\xff]\x1b\[[0-9]*b`)
+)
+
+// compareScreen checks the emulator's screen against the Screen's new buffer. It returns
+// false when the case must stop because the terminal state has diverged for a pinned reason.
+func compareScreen(ht *hegel.T, what string, s *Screen, e *vt.Emulator, chunk, transcript string) bool {
+	if hasOrphan(s.newbuf) {
+		// An orphaned placeholder (cellbuf/2) is skipped when drawing, shifting the rest of
+		// the line by a column on the terminal.
+		count("orphan-in-screen")
+		return false
+	}
+	if latin1Rep.MatchString(chunk) {
+		// REP after a Latin-1 character (cellbuf/15): the emulator does not repeat it.
+		count("latin1-rep")
+		return false
+	}
+	if dchOrIch.MatchString(chunk) {
+		// The vt emulator's DCH/ICH blank wide cells they shift (an ultraviolet bug, not
+		// cellbuf's); its state is no longer a reference.
+		count("dch-ich-emitted")
+		return false
+	}
+	if irmOn.MatchString(chunk) {
+		// The vt emulator does not implement insert mode (IRM); cellbuf uses it instead of
+		// ICH on terminals without that capability. Not a reference either (cellbuf/18 is
+		// pinned with a small IRM-aware replay instead).
+		count("irm-emitted")
+		return false
+	}
+	for y := 0; y < s.Height(); y++ {
+		for x := 0; x < s.Width(); x++ {
+			c := s.newbuf.Cell(x, y)
+			u := e.CellAt(x, y)
+			if c.Empty() {
+				if u != nil && u.Width != 0 {
+					fail(ht, "%s: (%d,%d) is a placeholder in the screen, emulator has %q w%d\nscreen:\n%s\nemulator:\n%s\noutput %q", what, x, y, u.Content, u.Width, s.newbuf.String(), e.String(), transcript)
+				}
+				continue
+			}
+			if u == nil {
+				fail(ht, "%s: emulator has no cell at (%d,%d)", what, x, y)
+			}
+			if c.Width > 1 && u.Content == " " {
+				// The overwrite cursor-move optimisation prints a space over the
+				// placeholder of a wide cell, blanking it on the terminal: cellbuf/14.
+				count("wide-blanked-on-terminal")
+				return false
+			}
+			if u.Content != c.String() || u.Width != c.Width {
+				fail(ht, "%s: (%d,%d) screen %q w%d, emulator %q w%d\nscreen:\n%s\nemulator:\n%s\noutput %q", what, x, y, c.String(), c.Width, u.Content, u.Width, s.newbuf.String(), e.String(), transcript)
+			}
+			if c.Equal(&BlankCell) && (!u.Style.IsZero() || !u.Link.IsZero()) {
+				// A blank drawn right after a styled cell inherits the pen: cellbuf/11.
+				count("blank-style-leak")
+				continue
+			}
+			// Bold, faint, italic and blink are invisible on a blank; cellbuf erases such cells
+			// with EL and the emulator records them without those attributes.
+			cAttrs, uAttrs := uint8(c.Style.Attrs), u.Style.Attrs
+			if c.String() == " " {
+				invisible := uint8(BoldAttr | FaintAttr | ItalicAttr | SlowBlinkAttr | RapidBlinkAttr)
+				cAttrs &^= invisible
+				uAttrs &^= invisible
+			}
+			if cAttrs != uAttrs || c.Style.UlStyle != u.Style.Underline ||
+				!colorEqual(c.Style.Fg, u.Style.Fg) || !colorEqual(c.Style.Bg, u.Style.Bg) || !colorEqual(c.Style.Ul, u.Style.UnderlineColor) {
+				fail(ht, "%s: (%d,%d) %q style %s, emulator %s\noutput %q", what, x, y, c.String(), styleString(c.Style), uvStyleString(u.Style), transcript)
+			}
+			if c.Link.URL != u.Link.URL || c.Link.Params != u.Link.Params {
+				fail(ht, "%s: (%d,%d) %q link %v, emulator %v\noutput %q", what, x, y, c.String(), c.Link, u.Link, transcript)
+			}
+		}
+	}
+	// The screen's own bookkeeping: the current buffer now equals the new one.
+	for y := 0; y < s.Height(); y++ {
+		for x := 0; x < s.Width(); x++ {
+			if !cellEqual(s.curbuf.Cell(x, y), s.newbuf.Cell(x, y)) {
+				fail(ht, "%s: after render curbuf (%d,%d) = %s, newbuf %s", what, x, y, cellString(s.curbuf.Cell(x, y)), cellString(s.newbuf.Cell(x, y)))
+			}
+		}
+	}
+	return true
+}
+
+func TestHegelScreenRendersWhatTheEmulatorShows(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		w, h := n(ht, 2, 16), n(ht, 1, 6)
+		term := pick(ht, []string{"xterm", "xterm-256color", "linux", "screen", "alacritty", "vt100"})
+		opts := &ScreenOptions{Term: term, AltScreen: true, ShowCursor: chance(ht, 50), HardTabs: chance(ht, 40), Backspace: chance(ht, 40)}
+		var out bytes.Buffer
+		s := NewScreen(&out, w, h, opts)
+		grapheme := chance(ht, 50)
+		if grapheme {
+			s.SetMethod(ansi.GraphemeWidth)
+		}
+		sw := NewScreenWriter(s)
+		e := vt.NewEmulator(w, h)
+		var transcript string
+		note(ht, "screen %dx%d term %s opts %+v grapheme %v", w, h, term, *opts, grapheme)
+		for frame := n(ht, 1, 6); frame > 0; frame-- {
+			switch n(ht, 0, 9) {
+			case 0, 1, 2, 3:
+				text := genText(ht, w, n(ht, 1, h+1), grapheme)
+				note(ht, "SetContent(%q)", text)
+				sw.SetContent(text)
+			case 4:
+				text := genText(ht, w, n(ht, 1, 2), grapheme)
+				x, y := n(ht, 0, w-1), n(ht, 0, h-1)
+				note(ht, "PrintAt(%d,%d,%q)", x, y, text)
+				sw.PrintAt(x, y, text)
+			case 5, 6:
+				for k := n(ht, 1, 6); k > 0; k-- {
+					x, y := n(ht, 0, w-1), n(ht, 0, h-1)
+					c := genCellOpt(ht, true, true)
+					note(ht, "SetCell(%d,%d,%s)", x, y, cellString(c))
+					s.SetCell(x, y, c)
+				}
+			case 7:
+				r := genRect(ht, w, h)
+				c := genCellOpt(ht, false, true)
+				note(ht, "FillRect(%s,%v)", cellString(c), r)
+				s.FillRect(c, r)
+			case 8:
+				r := genRect(ht, w, h)
+				note(ht, "ClearRect(%v)", r)
+				s.ClearRect(r)
+			default:
+				// Shift the picture by a line to exercise the scroll optimisation.
+				text := s.newbuf.String()
+				lines := strings.Split(text, "\r\n")
+				if chance(ht, 50) {
+					lines = append(lines[1:], genText(ht, w, 1, grapheme))
+				} else {
+					lines = append([]string{genText(ht, w, 1, grapheme)}, lines...)
+				}
+				text = strings.Join(lines, "\n")
+				note(ht, "SetContent(shifted %q)", text)
+				sw.SetContent(text)
+			}
+			if hang, scrollUp := renderReplay(s); hang {
+				count("transform-line-hang")
+				return
+			} else if scrollUp {
+				count("scroll-up-without-su")
+				return
+			}
+			if !s.clear && clearBottomOffByOne(s) {
+				count("clear-bottom-off-by-one")
+				return
+			}
+			s.Render()
+			if err := s.Flush(); err != nil {
+				fail(ht, "Flush: %v", err)
+			}
+			chunk := out.String()
+			out.Reset()
+			transcript += chunk
+			e.WriteString(chunk)
+			if !compareScreen(ht, fmt.Sprintf("frame %d", frame), s, e, chunk, transcript) {
+				return
+			}
+		}
+		if err := s.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		e.WriteString(out.String())
+		count("ok")
+	})
+}
diff --git a/cellbuf/hegel_shapes_test.go b/cellbuf/hegel_shapes_test.go
new file mode 100644
index 0000000..7f7252d
--- /dev/null
+++ b/cellbuf/hegel_shapes_test.go
@@ -0,0 +1,399 @@
+package cellbuf
+
+// The eleven narrow properties, one per recorded bug of this part: each draws the region of
+// the bug's shape (a construction that forces the shape's ingredient among random
+// surroundings, kept to the shape by the family's classifier through regionOf or regionBy)
+// and fails every run by default naming the bug; under HEGEL_NO_KNOWN=1 each draws the
+// neighbouring region past the shape instead (hzShaped) and passes. Every property reuses
+// its family's judge and model.
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the shared
+// ingredients
+
+var (
+	wideCells    = graphemeCellsOf(evenHalves(hzWideAtoms...))
+	narrowCells1 = graphemeCellsOf(evenHalves(hzNarrowAtoms...))
+	// plainCells are narrow cells without attributes (a style with colours only), so that
+	// the random surroundings of a Render construction never form the lossy diff of cellbuf/6.
+	plainCells = hegel.Map(narrowCells1, func(c *Cell) *Cell { c.Style.Attrs = 0; return c })
+)
+
+// narrowSetsAt is a SetCell of a narrow cell inside a w x h buffer (the random surroundings
+// of the Buffer constructions).
+func narrowSetsAt(w, h int) hegel.Generator[bufferStep] {
+	return hegel.Composite(func(tc hegel.TestCase) bufferStep {
+		return bufferStep{op: "SetCell", x: hegel.Draw(tc, rangeHalves(0, w-1)), y: hegel.Draw(tc, rangeHalves(0, h-1)), cell: hegel.Draw(tc, narrowCells)}
+	})
+}
+
+// shiftRectsInside is the rectangle of a shift step that never reaches past the buffer: the
+// bounds 60 percent of the time, else drawn inside.
+func shiftRectsInside(w, h int) hegel.Generator[Rectangle] {
+	return dieChoice(
+		hzW(60, hegel.Just(Rect(0, 0, w, h))), // the bounds nominal 60
+		hzW(40, insideRects(w, h)),            // drawn inside nominal 40
+	)
+}
+
+// --------------------------------------------------------------------------- cellbuf/1
+
+// shiftedWideCases: a wide cell (a narrow one under HEGEL_NO_KNOWN=1) set inside a 3-10 x
+// 2-5 buffer after 0 to 3 random cells, then InsertLineRect, DeleteLineRect or DeleteCellRect
+// by n = 1 to 3 that moves it (the cell n rows or columns or more past the operation's
+// origin, and not pushed out), over the bounds or a drawn rectangle containing the cell and
+// its destination; kept to the shape of cellbuf/1 by the step-wise classifier.
+var shiftedWideCases = regionBy("cellbuf/1", bufferShapeOnly, hegel.FlatMap(hzTuple(rangeHalves(3, 10), rangeHalves(2, 5)), func(d []int) hegel.Generator[bufferCase] {
+	w, h := d[0], d[1]
+	return hegel.Composite(func(tc hegel.TestCase) bufferCase {
+		around := hegel.Draw(tc, countedHalves(narrowSetsAt(w, h), 0, 3))
+		cell := hegel.Draw(tc, hzShaped(wideCells, narrowCells1))
+		shift := bufferStep{op: hegel.Draw(tc, evenHalves("InsertLineRect", "DeleteLineRect", "DeleteCellRect")), cell: hegel.Draw(tc, narrowCells)}
+		var x, y int   // the cell's place
+		var x1, y1 int // the columns and rows the rectangle must reach
+		if shift.op == "DeleteCellRect" {
+			shift.n = hegel.Draw(tc, rangeHalves(1, min(3, w-2)))
+			x = hegel.Draw(tc, rangeHalves(shift.n, w-2))
+			y = hegel.Draw(tc, rangeHalves(0, h-1))
+			shift.x = hegel.Draw(tc, rangeHalves(max(x-shift.n-2, 0), x-shift.n))
+			shift.y = y
+			x1, y1 = x+2, y+1
+		} else {
+			shift.n = hegel.Draw(tc, rangeHalves(1, min(3, h-1)))
+			x = hegel.Draw(tc, rangeHalves(0, w-2))
+			if shift.op == "InsertLineRect" {
+				y = hegel.Draw(tc, rangeHalves(0, h-1-shift.n))
+				shift.y = hegel.Draw(tc, rangeHalves(max(y-2, 0), y))
+				x1, y1 = x+2, y+shift.n+1
+			} else {
+				y = hegel.Draw(tc, rangeHalves(shift.n, h-1))
+				shift.y = hegel.Draw(tc, rangeHalves(max(y-shift.n-2, 0), y-shift.n))
+				x1, y1 = x+2, y+1
+			}
+		}
+		containing := hegel.Map(hzTuple(rangeHalves(0, min(x, shift.x)), rangeHalves(x1, w), rangeHalves(0, min(y, shift.y)), rangeHalves(y1, h)), func(r []int) Rectangle {
+			return Rect(r[0], r[2], r[1]-r[0], r[3]-r[2])
+		})
+		shift.rect = hegel.Draw(tc, dieChoice(
+			hzW(60, hegel.Just(Rect(0, 0, w, h))), // the bounds nominal 60
+			hzW(40, containing),                   // a containing rectangle nominal 40
+		))
+		steps := append(around, bufferStep{op: "SetCell", x: x, y: y, cell: cell}, shift)
+		return bufferCase{w: w, h: h, steps: steps}
+	})
+}))
+
+// TestHegelShiftedWideCellsSurvive: a wide cell moved by InsertLineRect, DeleteLineRect or
+// DeleteCellRect arrives whole at its new place (cellbuf/1: the library moves it cell by cell
+// through Line.set and blanks it); under HEGEL_NO_KNOWN=1 the moved cell is narrow.
+func TestHegelShiftedWideCellsSurvive(t *testing.T) {
+	judged(t, shiftedWideCases, judgeBuffer)
+}
+
+// --------------------------------------------------------------------------- cellbuf/2
+
+// wideOverHeadCases: a wide cell set at x+1 inside a 3-10 x 1-5 buffer after 0 to 3 random
+// cells, then a wide cell (a narrow one under HEGEL_NO_KNOWN=1) set at x, whose placeholder
+// would cover the first cell's head.
+var wideOverHeadCases = regionBy("cellbuf/2", bufferShapeOnly, hegel.FlatMap(hzTuple(rangeHalves(3, 10), rangeHalves(1, 5)), func(d []int) hegel.Generator[bufferCase] {
+	w, h := d[0], d[1]
+	return hegel.Composite(func(tc hegel.TestCase) bufferCase {
+		around := hegel.Draw(tc, countedHalves(narrowSetsAt(w, h), 0, 3))
+		x := hegel.Draw(tc, rangeHalves(0, w-3))
+		y := hegel.Draw(tc, rangeHalves(0, h-1))
+		first := hegel.Draw(tc, wideCells)
+		second := hegel.Draw(tc, hzShaped(wideCells, narrowCells1))
+		steps := append(around, bufferStep{op: "SetCell", x: x + 1, y: y, cell: first}, bufferStep{op: "SetCell", x: x, y: y, cell: second})
+		return bufferCase{w: w, h: h, steps: steps}
+	})
+}))
+
+// TestHegelWideCellsOverWideHeadsLeaveNoOrphan: a wide cell written over the head of another
+// wide cell blanks that cell, leaving no orphan placeholder (cellbuf/2); under
+// HEGEL_NO_KNOWN=1 a narrow cell is written beside the head.
+func TestHegelWideCellsOverWideHeadsLeaveNoOrphan(t *testing.T) {
+	judged(t, wideOverHeadCases, judgeBuffer)
+}
+
+// --------------------------------------------------------------------------- cellbuf/3
+
+// cutWideCases: a wide cell set in the last two columns of a 2-10 x 1-5 buffer after 0 to 3
+// random cells, then a Resize one column narrower, through the cell (two narrower under
+// HEGEL_NO_KNOWN=1, removing it).
+var cutWideCases = regionBy("cellbuf/3", bufferShapeOnly, hegel.FlatMap(hzTuple(rangeHalves(2, 10), rangeHalves(1, 5)), func(d []int) hegel.Generator[bufferCase] {
+	w, h := d[0], d[1]
+	return hegel.Composite(func(tc hegel.TestCase) bufferCase {
+		around := hegel.Draw(tc, countedHalves(narrowSetsAt(w, h), 0, 3))
+		y := hegel.Draw(tc, rangeHalves(0, h-1))
+		cell := hegel.Draw(tc, wideCells)
+		steps := append(around, bufferStep{op: "SetCell", x: w - 2, y: y, cell: cell}, bufferStep{op: "Resize", nw: hzShaped(w-1, w-2), nh: h})
+		return bufferCase{w: w, h: h, steps: steps}
+	})
+}))
+
+// TestHegelShrinkingBlanksCutWideCells: a Resize that cuts through a wide cell blanks it
+// (cellbuf/3: the library keeps the head in the last column); under HEGEL_NO_KNOWN=1 the
+// width is cut just before the cell.
+func TestHegelShrinkingBlanksCutWideCells(t *testing.T) {
+	judged(t, cutWideCases, judgeBuffer)
+}
+
+// --------------------------------------------------------------------------- cellbuf/4
+
+// tabOpsOf is one operation of the kinds given with its column from cols and its probes.
+func tabOpsOf(width int, kinds hegel.Generator[string], cols hegel.Generator[int]) hegel.Generator[tabOp] {
+	return hegel.Composite(func(tc hegel.TestCase) tabOp {
+		return tabOp{kind: hegel.Draw(tc, kinds), col: hegel.Draw(tc, cols), probes: hegel.Draw(tc, probesAt(width))}
+	})
+}
+
+// otherIntervalCases: tab stops of a width of 1 to 40 at an interval other than 8 (8 under
+// HEGEL_NO_KNOWN=1) under 1 to 4 Set or Reset inside the width.
+var otherIntervalCases = regionOf("cellbuf/4", tabsExpected, hegel.FlatMap(hzTuple(rangeHalves(1, 40), hzShaped(evenHalves(hzOtherIntervals...), hegel.Just(DefaultTabInterval))), func(d []int) hegel.Generator[tabCase] {
+	width, interval := d[0], d[1]
+	return hegel.Map(hzTuple[any](
+		hegel.Map(probesAt(width), func(ps []tabProbe) any { return ps }),
+		hegel.Map(countedHalves(tabOpsOf(width, evenHalves("Set", "Reset"), rangeHalves(0, width-1)), 1, 4), func(ops []tabOp) any { return ops }),
+	), func(v []any) tabCase {
+		return tabCase{width: width, interval: interval, probes: v[0].([]tabProbe), ops: v[1].([]tabOp)}
+	})
+}))
+
+// TestHegelTabIntervalsOtherThanEightWork: tab stops at an interval of 2, 3, 4, 5, 6 or 16
+// follow the set model (cellbuf/4: the word index is col>>3 whatever the interval, so other
+// intervals alias columns, produce garbage masks or index out of range); under
+// HEGEL_NO_KNOWN=1 the interval is 8.
+func TestHegelTabIntervalsOtherThanEightWork(t *testing.T) {
+	judged(t, otherIntervalCases, judgeTabs)
+}
+
+// --------------------------------------------------------------------------- cellbuf/5
+
+// beyondWidthCases: tab stops of a width of 1 to 40 at the default interval, then either a
+// Set or Reset at a column at or beyond the width (inside it under HEGEL_NO_KNOWN=1), or a
+// Set at a column c inside the width followed by a Resize to a width at or below c that keeps
+// c's word (a Resize wider than the width under HEGEL_NO_KNOWN=1).
+var beyondWidthCases = regionOf("cellbuf/5", tabsExpected, hegel.FlatMap(rangeHalves(1, 40), func(width int) hegel.Generator[tabCase] {
+	beyondOrInside := hegel.Map(tabOpsOf(width, evenHalves("Set", "Reset"), hzShaped(rangeHalves(width, width+8), rangeHalves(0, width-1))), func(o tabOp) []tabOp { return []tabOp{o} })
+	setThenResize := hegel.Composite(func(tc hegel.TestCase) []tabOp {
+		c := hegel.Draw(tc, rangeHalves(1, width-1))
+		if c%8 == 0 {
+			c-- // a column at a word's first bit has no narrower width that keeps its word
+		}
+		set := tabOp{kind: "Set", col: c, probes: hegel.Draw(tc, probesAt(width))}
+		nw := hegel.Draw(tc, hzShaped(rangeHalves(c&^7+1, c), rangeHalves(width, 40)))
+		resize := tabOp{kind: "Resize", nw: nw, probes: hegel.Draw(tc, probesAt(nw))}
+		return []tabOp{set, resize}
+	})
+	ops := beyondOrInside
+	if width > 1 {
+		ops = dieChoice(hzW(1, beyondOrInside), hzW(1, setThenResize)) // the two constructions nominal 50 each
+	}
+	return hegel.Map(hzTuple[any](
+		hegel.Map(probesAt(width), func(ps []tabProbe) any { return ps }),
+		hegel.Map(ops, func(ops []tabOp) any { return ops }),
+	), func(v []any) tabCase {
+		return tabCase{width: width, interval: DefaultTabInterval, probes: v[0].([]tabProbe), ops: v[1].([]tabOp)}
+	})
+}))
+
+// TestHegelTabColumnsBeyondTheWidthAreNotStops: Set and Reset at or beyond the width are
+// ignored and IsStop there is false (cellbuf/5: Set and Reset index the words unchecked and
+// panic past the last one, and IsStop answers from the bits a Resize left in the last word);
+// under HEGEL_NO_KNOWN=1 the columns are inside the width and the Resize grows it.
+func TestHegelTabColumnsBeyondTheWidthAreNotStops(t *testing.T) {
+	judged(t, beyondWidthCases, judgeTabs)
+}
+
+// --------------------------------------------------------------------------- cellbuf/6
+
+// attrSibling is an attribute and the sibling it shares an off code with (22 turns bold and
+// faint off, 25 both blinks).
+type attrSibling struct {
+	off, kept AttrMask
+}
+
+var attrSiblings = evenHalves(
+	attrSibling{BoldAttr, FaintAttr},
+	attrSibling{FaintAttr, BoldAttr},
+	attrSibling{SlowBlinkAttr, RapidBlinkAttr},
+	attrSibling{RapidBlinkAttr, SlowBlinkAttr},
+)
+
+// siblingPairs: a random base style; s keeps one attribute of a sibling pair, o has both
+// (the diff turns one off with the shared off code, which clears the kept one too, and does
+// not re-send it: cellbuf/6); under HEGEL_NO_KNOWN=1 o has neither, so the diff only turns
+// the kept one on. (o with only the other one is not past the shape: when the kept attribute
+// comes first in DiffSequence's order it is sent before the off code that clears it.)
+var siblingPairs = regionOf("cellbuf/6", styleExpected, hegel.Map(hzTuple[any](
+	hegel.Map(styles, func(s Style) any { return s }),
+	hegel.Map(attrSiblings, func(p attrSibling) any { return p }),
+), func(v []any) stylePair {
+	base, p := v[0].(Style), v[1].(attrSibling)
+	s, o := base, base
+	s.Attrs = base.Attrs&^(p.off|p.kept) | p.kept
+	o.Attrs = hzShaped(base.Attrs|p.off|p.kept, base.Attrs&^(p.off|p.kept))
+	return stylePair{s: s, o: o}
+}))
+
+// TestHegelDiffSequencesKeepSiblingAttributes: the diff from a style with bold and faint (or
+// both blinks) to one with only faint (or one blink) keeps the one that stays (cellbuf/6:
+// the shared off code clears both and the kept one is not re-sent).
+func TestHegelDiffSequencesKeepSiblingAttributes(t *testing.T) {
+	judged(t, siblingPairs, judgeStyle)
+}
+
+// --------------------------------------------------------------------------- cellbuf/7
+
+// pairCellCases: a grapheme whose later runes add width (a glued ASCII pair, a flag, a ZWJ
+// sequence); one of the shared population under HEGEL_NO_KNOWN=1.
+var pairCellCases = regionOf("cellbuf/7", cellExpected, hegel.Map(hzShaped(hzPairAtoms, graphemes), func(g string) cellCase { return cellCase{g: g} }))
+
+// TestHegelNewCellTakesOnlyTheFirstCombiningRune: NewCell of a rune and combining runes
+// that add width keeps only the zero-width ones, as documented and as NewCellString does
+// (cellbuf/7: it appends every rune and sums their widths).
+func TestHegelNewCellTakesOnlyTheFirstCombiningRune(t *testing.T) {
+	judged(t, pairCellCases, judgeCells)
+}
+
+// --------------------------------------------------------------------------- cellbuf/8
+
+// hzBlankStyles are styles under which Wrap still treats a space as whitespace (no
+// background, no reverse, no underline), so that the construction reaches the breakpoint
+// path.
+var hzBlankStyles = hegel.Map(styles, func(s Style) Style {
+	s.Bg = nil
+	s.Attrs &^= ReverseAttr
+	s.UlStyle = NoUnderline
+	return s
+})
+
+// trailingSpaceCases: an optional style, a word of exactly the limit's width (one that
+// leaves room for the spaces under HEGEL_NO_KNOWN=1), one or two spaces, a hyphen (always a
+// breakpoint) and an optional word after it, at a limit of 2 to 16.
+var trailingSpaceCases = regionOf("cellbuf/8", wrapExpected, hegel.FlatMap(rangeHalves(2, 16), func(limit int) hegel.Generator[hzWrapCase] {
+	word := func(lo, hi int) hegel.Generator[wrapPiece] {
+		return hegel.Map(countedHalves(evenHalves(hzASCIIAtoms...), lo, hi), func(w []string) wrapPiece { return wrapPiece{kind: "word", word: w} })
+	}
+	return hegel.Composite(func(tc hegel.TestCase) hzWrapCase {
+		var pieces []wrapPiece
+		if hegel.Draw(tc, dieCoin(30)) { // a style first nominal 30
+			pieces = append(pieces, wrapPiece{kind: "style", style: hegel.Draw(tc, hzBlankStyles)})
+		}
+		spaces := hegel.Draw(tc, evenHalves(" ", "  "))
+		pieces = append(pieces, hegel.Draw(tc, hzShaped(word(limit, limit), word(1, max(1, limit-len(spaces))))))
+		pieces = append(pieces, wrapPiece{kind: "atom", atom: spaces})
+		pieces = append(pieces, wrapPiece{kind: "atom", atom: "-"})
+		if hegel.Draw(tc, dieCoin(50)) { // a word after the hyphen nominal 50
+			pieces = append(pieces, hegel.Draw(tc, word(1, 4)))
+		}
+		return hzWrapCase{pieces: pieces, limit: limit, bp: hegel.Draw(tc, evenHalves("", "-", ".,"))}
+	})
+}))
+
+// TestHegelWrappedLinesFitWithTrailingSpaces: a full line followed by spaces and a breakpoint
+// wraps to lines that fit the limit (cellbuf/8: the spaces are committed before the fit
+// check); under HEGEL_NO_KNOWN=1 the line has room for them.
+func TestHegelWrappedLinesFitWithTrailingSpaces(t *testing.T) {
+	judged(t, trailingSpaceCases, judgeWrap)
+}
+
+// --------------------------------------------------------------------------- cellbuf/9
+
+// markCases: a cell holding a cluster with an ASCII base (its precomposed form under
+// HEGEL_NO_KNOWN=1) set inside a 1-12 x 1-4 buffer among 0 to 5 narrow cells without
+// attributes.
+var markCases = regionOf("cellbuf/9", renderExpected, hegel.FlatMap(hzTuple(rangeHalves(1, 12), rangeHalves(1, 4)), func(d []int) hegel.Generator[renderCase] {
+	w, h := d[0], d[1]
+	plainSets := hegel.Composite(func(tc hegel.TestCase) renderStep {
+		return renderStep{x: hegel.Draw(tc, rangeHalves(0, w-1)), y: hegel.Draw(tc, rangeHalves(0, h-1)), cell: hegel.Draw(tc, plainCells)}
+	})
+	cluster := graphemeCellsOf(hzShaped(evenHalves(hzClusterAtoms...), evenHalves("\u00e9", "\u00f1")))
+	return hegel.Composite(func(tc hegel.TestCase) renderCase {
+		around := hegel.Draw(tc, countedHalves(plainSets, 0, 5))
+		x := hegel.Draw(tc, rangeHalves(0, w-1))
+		y := hegel.Draw(tc, rangeHalves(0, h-1))
+		cell := hegel.Draw(tc, cluster)
+		cell.Style.Attrs = 0
+		steps := append(around, renderStep{x: x, y: y, cell: cell})
+		return renderCase{w: w, h: h, steps: steps}
+	})
+}))
+
+// TestHegelCombiningMarksStayOnTheirCell: a cluster with an ASCII base rendered and read
+// back by SetContent stays one cell (cellbuf/9: printString attaches the mark, decoded on
+// its own, to the next cell); under HEGEL_NO_KNOWN=1 the cluster is precomposed.
+func TestHegelCombiningMarksStayOnTheirCell(t *testing.T) {
+	judged(t, markCases, judgeRender)
+}
+
+// --------------------------------------------------------------------------- cellbuf/10
+
+// beyondRectCases: 0 to 3 random cells in a 1-10 x 1-5 buffer, then one of the four shift
+// operations over a rectangle reaching past the buffer where the library reads (past the
+// left or right edge, or past the bottom by more than n rows for InsertLineRect, past the
+// bottom for DeleteLineRect, past the right edge by more than n columns for InsertCellRect,
+// past the right edge for DeleteCellRect), the origin and count inside the rectangle so that
+// the operation moves something; the rectangle intersected with the buffer under
+// HEGEL_NO_KNOWN=1. A rectangle past the top, or past the bottom or the right by n or fewer
+// where the operation inserts, is read inside the buffer only and does not panic.
+var beyondRectCases = regionBy("cellbuf/10", bufferShapeOnly, hegel.FlatMap(hzTuple(rangeHalves(1, 10), rangeHalves(1, 5)), func(d []int) hegel.Generator[bufferCase] {
+	w, h := d[0], d[1]
+	return hegel.Composite(func(tc hegel.TestCase) bufferCase {
+		around := hegel.Draw(tc, countedHalves(narrowSetsAt(w, h), 0, 3))
+		shift := bufferStep{op: hegel.Draw(tc, evenHalves("InsertLineRect", "DeleteLineRect", "InsertCellRect", "DeleteCellRect")), n: hegel.Draw(tc, rangeHalves(1, 3)), cell: hegel.Draw(tc, narrowCells)}
+		e := hegel.Draw(tc, rangeHalves(1, 2))
+		r := Rect(0, 0, w, h)
+		if shift.op == "InsertLineRect" || shift.op == "DeleteLineRect" {
+			r = hegel.Draw(tc, evenHalves(
+				Rect(-e, 0, w+e, h), // past the left edge
+				Rect(0, 0, w+e, h),  // past the right edge
+				Rect(0, 0, w, h+e),  // past the bottom
+			))
+			if shift.op == "InsertLineRect" && r.Max.Y > h {
+				r.Max.Y = h + shift.n + e // past the bottom by more than n rows
+			}
+			shift.y = hegel.Draw(tc, rangeHalves(0, max(min(h-1, r.Max.Y-shift.n-1), 0)))
+		} else {
+			r = Rect(0, 0, w+e, h)
+			if shift.op == "InsertCellRect" {
+				r.Max.X = w + shift.n + e // past the right edge by more than n columns
+			}
+			shift.x = hegel.Draw(tc, rangeHalves(0, max(min(w-1, r.Max.X-shift.n-1), 0)))
+			shift.y = hegel.Draw(tc, rangeHalves(0, h-1))
+		}
+		shift.rect = hzShaped(r, r.Intersect(Rect(0, 0, w, h)))
+		return bufferCase{w: w, h: h, steps: append(around, withRect(w, h, shift))}
+	})
+}))
+
+// TestHegelShiftRectsBeyondTheBufferClip: a shift operation over a rectangle reaching past
+// the buffer affects only the cells inside it (cellbuf/10: the library reads the rectangle
+// unclipped and panics); under HEGEL_NO_KNOWN=1 the rectangle is inside.
+func TestHegelShiftRectsBeyondTheBufferClip(t *testing.T) {
+	judged(t, beyondRectCases, judgeBuffer)
+}
+
+// --------------------------------------------------------------------------- cellbuf/16
+
+// equalPairs: a non-empty style and itself (itself with one attribute outside the sibling
+// pairs flipped under HEGEL_NO_KNOWN=1: the nearest unequal pair).
+var equalPairs = regionOf("cellbuf/16", styleExpected, hegel.FlatMap(styledStyles, func(s Style) hegel.Generator[stylePair] {
+	flipped := hegel.Map(evenHalves(ItalicAttr, ReverseAttr, ConcealAttr, StrikethroughAttr), func(a AttrMask) Style {
+		o := s
+		o.Attrs ^= a
+		return o
+	})
+	return hegel.Map(hzShaped(hegel.Just(s), flipped), func(o Style) stylePair { return stylePair{s: s, o: o} })
+}))
+
+// TestHegelDiffSequencesOfEqualStylesAreEmpty: the diff between two equal non-empty styles
+// changes nothing on the terminal (cellbuf/16: it is the reset sequence).
+func TestHegelDiffSequencesOfEqualStylesAreEmpty(t *testing.T) {
+	judged(t, equalPairs, judgeStyle)
+}
diff --git a/cellbuf/hegel_style_test.go b/cellbuf/hegel_style_test.go
new file mode 100644
index 0000000..f23e46f
--- /dev/null
+++ b/cellbuf/hegel_style_test.go
@@ -0,0 +1,691 @@
+package cellbuf
+
+// The style families: the SGR table model (a transcription of sequence.go's ReadStyle, the
+// documented table), the sequence model (cell.go's Sequence through x/ansi's builder, which
+// the generators use so that no cellbuf code runs while drawing), the DiffSequence replica
+// (cell.go 242 on) under the switches of cellbuf/6 and cellbuf/16, the style pair and SGR
+// case records with their generators, and the two properties.
+
+import (
+	"fmt"
+	"image/color"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the style text
+
+// hzColorText prints a colour by its RGBA so that the drawn value and the one ReadStyle gives
+// back (another type of the same colour) print alike; colorEqual is the library's equality.
+func hzColorText(c ansi.Color) string {
+	if c == nil {
+		return "nil"
+	}
+	r, g, b, a := c.RGBA()
+	return fmt.Sprintf("rgba(%d,%d,%d,%d)", r, g, b, a)
+}
+
+// hzStyleText is the check value of a style, cached by value (the grid dumps print every
+// cell's style many times per case; every colour type the package or the models make is
+// comparable).
+func hzStyleText(s Style) string {
+	if v, ok := hzStyleTexts.Load(s); ok {
+		return v.(string)
+	}
+	v := fmt.Sprintf("{fg:%s bg:%s ul:%s attrs:%08b uls:%d}", hzColorText(s.Fg), hzColorText(s.Bg), hzColorText(s.Ul), s.Attrs, s.UlStyle)
+	hzStyleTexts.Store(s, v)
+	return v
+}
+
+var hzStyleTexts sync.Map
+
+// hzStyleEmpty and hzStyleEqual are the field tests of Style.Empty and Style.Equal, written
+// out so that the models call no cellbuf code.
+func hzStyleEmpty(s Style) bool {
+	return s.Fg == nil && s.Bg == nil && s.Ul == nil && s.Attrs == 0 && s.UlStyle == NoUnderline
+}
+
+func hzStyleEqual(s, o Style) bool {
+	return s.Attrs == o.Attrs && s.UlStyle == o.UlStyle && hzColorEqual(s.Fg, o.Fg) && hzColorEqual(s.Bg, o.Bg) && hzColorEqual(s.Ul, o.Ul)
+}
+
+func hzColorEqual(c, o ansi.Color) bool {
+	if c == nil || o == nil {
+		return c == nil && o == nil
+	}
+	cr, cg, cb, ca := c.RGBA()
+	or, og, ob, oa := o.RGBA()
+	return cr == or && cg == og && cb == ob && ca == oa
+}
+
+// --------------------------------------------------------------------------- the SGR models
+
+// hzStyleSequence is the SGR sequence that sets a style, as cell.go's Sequence builds it from
+// x/ansi's Style builder (the reset sequence for the empty style); the generators render
+// drawn styles through it.
+func hzStyleSequence(s Style) string {
+	if hzStyleEmpty(s) {
+		return ansi.ResetStyle
+	}
+	var b ansi.Style
+	if s.Attrs&BoldAttr != 0 {
+		b = b.Bold()
+	}
+	if s.Attrs&FaintAttr != 0 {
+		b = b.Faint()
+	}
+	if s.Attrs&ItalicAttr != 0 {
+		b = b.Italic(true)
+	}
+	if s.Attrs&SlowBlinkAttr != 0 {
+		b = b.Blink(true)
+	}
+	if s.Attrs&RapidBlinkAttr != 0 {
+		b = b.RapidBlink(true)
+	}
+	if s.Attrs&ReverseAttr != 0 {
+		b = b.Reverse(true)
+	}
+	if s.Attrs&ConcealAttr != 0 {
+		b = b.Conceal(true)
+	}
+	if s.Attrs&StrikethroughAttr != 0 {
+		b = b.Strikethrough(true)
+	}
+	if s.UlStyle != NoUnderline {
+		b = b.Underline(true)
+		b = b.UnderlineStyle(s.UlStyle)
+	}
+	if s.Fg != nil {
+		b = b.ForegroundColor(s.Fg)
+	}
+	if s.Bg != nil {
+		b = b.BackgroundColor(s.Bg)
+	}
+	if s.Ul != nil {
+		b = b.UnderlineColor(s.Ul)
+	}
+	return b.String()
+}
+
+// hzReadStyle applies an SGR parameter list to a style: the documented table (sequence.go's
+// ReadStyle transcribed; the colour forms through x/ansi's ReadStyleColor). The Wrap replica
+// reads the styles of its input through it.
+func hzReadStyle(params ansi.Params, pen *Style) {
+	if len(params) == 0 {
+		*pen = Style{}
+		return
+	}
+	for i := 0; i < len(params); i++ {
+		param, hasMore, _ := params.Param(i, 0)
+		switch param {
+		case 0:
+			*pen = Style{}
+		case 1:
+			pen.Attrs |= BoldAttr
+		case 2:
+			pen.Attrs |= FaintAttr
+		case 3:
+			pen.Attrs |= ItalicAttr
+		case 4:
+			nextParam, _, ok := params.Param(i+1, 0)
+			if hasMore && ok && nextParam >= 0 && nextParam <= 5 {
+				i++
+				pen.UlStyle = UnderlineStyle(nextParam)
+			} else {
+				pen.UlStyle = SingleUnderline
+			}
+		case 5:
+			pen.Attrs |= SlowBlinkAttr
+		case 6:
+			pen.Attrs |= RapidBlinkAttr
+		case 7:
+			pen.Attrs |= ReverseAttr
+		case 8:
+			pen.Attrs |= ConcealAttr
+		case 9:
+			pen.Attrs |= StrikethroughAttr
+		case 22:
+			pen.Attrs &^= BoldAttr | FaintAttr
+		case 23:
+			pen.Attrs &^= ItalicAttr
+		case 24:
+			pen.UlStyle = NoUnderline
+		case 25:
+			pen.Attrs &^= SlowBlinkAttr | RapidBlinkAttr
+		case 27:
+			pen.Attrs &^= ReverseAttr
+		case 28:
+			pen.Attrs &^= ConcealAttr
+		case 29:
+			pen.Attrs &^= StrikethroughAttr
+		case 30, 31, 32, 33, 34, 35, 36, 37:
+			pen.Fg = ansi.BasicColor(param - 30)
+		case 38, 48, 58:
+			var c color.Color
+			if n := ansi.ReadStyleColor(params[i:], &c); n > 0 {
+				switch param {
+				case 38:
+					pen.Fg = c
+				case 48:
+					pen.Bg = c
+				default:
+					pen.Ul = c
+				}
+				i += n - 1
+			}
+		case 39:
+			pen.Fg = nil
+		case 40, 41, 42, 43, 44, 45, 46, 47:
+			pen.Bg = ansi.BasicColor(param - 40)
+		case 49:
+			pen.Bg = nil
+		case 59:
+			pen.Ul = nil
+		case 90, 91, 92, 93, 94, 95, 96, 97:
+			pen.Fg = ansi.BasicColor(8 + param - 90)
+		case 100, 101, 102, 103, 104, 105, 106, 107:
+			pen.Bg = ansi.BasicColor(8 + param - 100)
+		}
+	}
+}
+
+// hzReadLink reads a hyperlink's OSC 8 data (sequence.go's ReadLink).
+func hzReadLink(p []byte, link *Link) {
+	params := strings.Split(string(p), ";")
+	if len(params) != 3 {
+		return
+	}
+	link.Params = params[1]
+	link.URL = params[2]
+}
+
+// hzReadSGR applies every SGR sequence of a text to a style and every hyperlink to a link
+// through the models above (the replica's reading; readSGR below is the library's, which the
+// properties and the pins use).
+func hzReadSGR(seq string, st *Style, ln *Link) {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var state byte
+	for len(seq) > 0 {
+		sq, _, k, ns := ansi.DecodeSequence(seq, state, p)
+		if ansi.HasCsiPrefix(sq) && p.Command() == 'm' {
+			hzReadStyle(p.Params(), st)
+		} else if ansi.HasOscPrefix(sq) && p.Command() == 8 && ln != nil {
+			hzReadLink(p.Data(), ln)
+		}
+		seq = seq[k:]
+		state = ns
+	}
+}
+
+// readSGR applies every SGR sequence in seq to st, and every hyperlink to ln, through the
+// library's ReadStyle and ReadLink (the properties' reading of the library's output).
+func readSGR(seq string, st *Style, ln *Link) {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var state byte
+	for len(seq) > 0 {
+		sq, _, k, ns := ansi.DecodeSequence(seq, state, p)
+		if ansi.HasCsiPrefix(sq) && p.Command() == 'm' {
+			ReadStyle(p.Params(), st)
+		} else if ansi.HasOscPrefix(sq) && p.Command() == 8 && ln != nil {
+			ReadLink(p.Data(), ln)
+		}
+		seq = seq[k:]
+		state = ns
+	}
+}
+
+// --------------------------------------------------------------------------- the DiffSequence
+// replica
+
+// hzEffect is what one SGR code of a sequence does to the terminal's style (the SGR table).
+type hzEffect func(*Style)
+
+func hzAttrOn(a AttrMask) hzEffect  { return func(s *Style) { s.Attrs |= a } }
+func hzAttrOff(a AttrMask) hzEffect { return func(s *Style) { s.Attrs &^= a } }
+func hzSetFg(c ansi.Color) hzEffect { return func(s *Style) { s.Fg = c } }
+func hzSetBg(c ansi.Color) hzEffect { return func(s *Style) { s.Bg = c } }
+func hzSetUl(c ansi.Color) hzEffect { return func(s *Style) { s.Ul = c } }
+func hzSetUlStyle(u UnderlineStyle) hzEffect {
+	return func(s *Style) { s.UlStyle = u }
+}
+func hzResetEffect(s *Style) { *s = Style{} }
+
+func hzApplyEffects(st Style, fx []hzEffect) Style {
+	for _, f := range fx {
+		f(&st)
+	}
+	return st
+}
+
+// hzSequenceEffects is what s.Sequence() does to a terminal: the reset for the empty style,
+// else every attribute, the underline style and the colours of s switched on.
+func hzSequenceEffects(s Style) []hzEffect {
+	if hzStyleEmpty(s) {
+		return []hzEffect{hzResetEffect}
+	}
+	var fx []hzEffect
+	for _, a := range []AttrMask{BoldAttr, FaintAttr, ItalicAttr, SlowBlinkAttr, RapidBlinkAttr, ReverseAttr, ConcealAttr, StrikethroughAttr} {
+		if s.Attrs&a != 0 {
+			fx = append(fx, hzAttrOn(a))
+		}
+	}
+	if s.UlStyle != NoUnderline {
+		fx = append(fx, hzSetUlStyle(s.UlStyle))
+	}
+	if s.Fg != nil {
+		fx = append(fx, hzSetFg(s.Fg))
+	}
+	if s.Bg != nil {
+		fx = append(fx, hzSetBg(s.Bg))
+	}
+	if s.Ul != nil {
+		fx = append(fx, hzSetUl(s.Ul))
+	}
+	return fx
+}
+
+// hzDiffEffects is the replica of DiffSequence (cell.go 242 on): what the codes it emits for
+// the change from o to s do to a terminal in style o. The attribute loop is the library's:
+// a dropped bold or faint is SGR 22 (Normal: both off) sent once and the other one is not
+// re-sent (cellbuf/6, k6); a dropped slow or rapid blink is SGR 25 likewise. With no
+// difference the builder is empty and renders as the reset sequence (cellbuf/16, k16);
+// without that switch the documented value of an empty diff is no code at all. With k6 off
+// the documented diff re-sends the attribute of the pair that s keeps after 22 or 25.
+func hzDiffEffects(s, o Style, k known) []hzEffect {
+	if hzStyleEmpty(o) {
+		return hzSequenceEffects(s)
+	}
+	var fx []hzEffect
+	if !hzColorEqual(s.Fg, o.Fg) {
+		fx = append(fx, hzSetFg(s.Fg))
+	}
+	if !hzColorEqual(s.Bg, o.Bg) {
+		fx = append(fx, hzSetBg(s.Bg))
+	}
+	if !hzColorEqual(s.Ul, o.Ul) {
+		fx = append(fx, hzSetUl(s.Ul))
+	}
+	var noBlink, isNormal bool
+	if s.Attrs != o.Attrs {
+		if s.Attrs&BoldAttr != o.Attrs&BoldAttr {
+			if s.Attrs&BoldAttr != 0 {
+				fx = append(fx, hzAttrOn(BoldAttr))
+			} else if !isNormal {
+				isNormal = true
+				fx = append(fx, hzAttrOff(BoldAttr|FaintAttr)) // cell.go 272: b.Normal()
+				if !k[kDiffDropsSibling] && s.Attrs&FaintAttr != 0 {
+					fx = append(fx, hzAttrOn(FaintAttr)) // documented: faint re-sent
+				}
+			}
+		}
+		if s.Attrs&FaintAttr != o.Attrs&FaintAttr {
+			if s.Attrs&FaintAttr != 0 {
+				fx = append(fx, hzAttrOn(FaintAttr))
+			} else if !isNormal {
+				fx = append(fx, hzAttrOff(BoldAttr|FaintAttr)) // cell.go 280: b.Normal(), isNormal not set
+				if !k[kDiffDropsSibling] && s.Attrs&BoldAttr != 0 {
+					fx = append(fx, hzAttrOn(BoldAttr)) // documented: bold re-sent
+				}
+			}
+		}
+		if s.Attrs&ItalicAttr != o.Attrs&ItalicAttr {
+			if s.Attrs&ItalicAttr != 0 {
+				fx = append(fx, hzAttrOn(ItalicAttr))
+			} else {
+				fx = append(fx, hzAttrOff(ItalicAttr))
+			}
+		}
+		if s.Attrs&SlowBlinkAttr != o.Attrs&SlowBlinkAttr {
+			if s.Attrs&SlowBlinkAttr != 0 {
+				fx = append(fx, hzAttrOn(SlowBlinkAttr))
+			} else if !noBlink {
+				noBlink = true
+				fx = append(fx, hzAttrOff(SlowBlinkAttr|RapidBlinkAttr)) // cell.go 290: b.Blink(false)
+				if !k[kDiffDropsSibling] && s.Attrs&RapidBlinkAttr != 0 {
+					fx = append(fx, hzAttrOn(RapidBlinkAttr)) // documented: rapid blink re-sent
+				}
+			}
+		}
+		if s.Attrs&RapidBlinkAttr != o.Attrs&RapidBlinkAttr {
+			if s.Attrs&RapidBlinkAttr != 0 {
+				fx = append(fx, hzAttrOn(RapidBlinkAttr))
+			} else if !noBlink {
+				fx = append(fx, hzAttrOff(SlowBlinkAttr|RapidBlinkAttr)) // cell.go 297: b.Blink(false), noBlink not set
+				if !k[kDiffDropsSibling] && s.Attrs&SlowBlinkAttr != 0 {
+					fx = append(fx, hzAttrOn(SlowBlinkAttr)) // documented: slow blink re-sent
+				}
+			}
+		}
+		if s.Attrs&ReverseAttr != o.Attrs&ReverseAttr {
+			if s.Attrs&ReverseAttr != 0 {
+				fx = append(fx, hzAttrOn(ReverseAttr))
+			} else {
+				fx = append(fx, hzAttrOff(ReverseAttr))
+			}
+		}
+		if s.Attrs&ConcealAttr != o.Attrs&ConcealAttr {
+			if s.Attrs&ConcealAttr != 0 {
+				fx = append(fx, hzAttrOn(ConcealAttr))
+			} else {
+				fx = append(fx, hzAttrOff(ConcealAttr))
+			}
+		}
+		if s.Attrs&StrikethroughAttr != o.Attrs&StrikethroughAttr {
+			if s.Attrs&StrikethroughAttr != 0 {
+				fx = append(fx, hzAttrOn(StrikethroughAttr))
+			} else {
+				fx = append(fx, hzAttrOff(StrikethroughAttr))
+			}
+		}
+	}
+	if s.UlStyle != o.UlStyle {
+		fx = append(fx, hzSetUlStyle(s.UlStyle))
+	}
+	if len(fx) == 0 && k[kEqualDiffResets] {
+		return []hzEffect{hzResetEffect} // cell.go 315: an empty ansi.Style renders as ResetStyle
+	}
+	return fx
+}
+
+// --------------------------------------------------------------------------- the atoms and
+// generators of styles
+
+// hzColors is a colour: none, a basic colour 0..15, an extended colour 16..255 or an RGB
+// colour; one in four each (the old genColor).
+var hzColors = hegel.FlatMap(evenHalves[hegel.Generator[ansi.Color]]( // the four kinds nominal 25 each: realise 24.1/23.8/26.9/25.3 as the foreground of the Buffer cells
+	hegel.Just[ansi.Color](nil),
+	hegel.Map(rangeHalves(0, 15), func(n int) ansi.Color { return ansi.BasicColor(n) }),
+	hegel.Map(hzInts(16, 255), func(n int) ansi.Color { return ansi.ExtendedColor(n) }),
+	hegel.Map(hzTuple(hzInts(0, 255), hzInts(0, 255), hzInts(0, 255)), func(c []int) ansi.Color {
+		return color.RGBA{R: uint8(c[0]), G: uint8(c[1]), B: uint8(c[2]), A: 0xff}
+	}),
+), func(g hegel.Generator[ansi.Color]) hegel.Generator[ansi.Color] { return g })
+
+// hzAttrs is an attribute mask: any byte, or a single bit half the time (the old genStyle).
+var hzAttrs = dieChoice(
+	hzW(1, hegel.Map(hzInts(0, 255), func(n int) AttrMask { return AttrMask(n) })),         // any mask nominal 50 (single-bit masks nominal 51.6 with its own: realise 58.8 in the Buffer cells)
+	hzW(1, hegel.Map(rangeHalves(0, 7), func(n int) AttrMask { return AttrMask(1 << n) })), // a single bit nominal 50
+)
+
+// styledStyles is a composite style: attributes, an underline style 30 percent of the time,
+// a foreground and a background colour, an underline colour 20 (the old genStyle's styled
+// branch); styles is the empty style 40 percent of the time, else one of them.
+var styledStyles = hegel.Composite(func(tc hegel.TestCase) Style {
+	var s Style
+	s.Attrs = hegel.Draw(tc, hzAttrs)
+	if hegel.Draw(tc, dieCoin(35)) { // an underline style nominal 35 (for a realised 30): realises 29.0 of the composite styles in the Buffer cells
+		s.UlStyle = UnderlineStyle(hegel.Draw(tc, rangeHalves(0, 5)))
+	}
+	s.Fg = hegel.Draw(tc, hzColors)
+	s.Bg = hegel.Draw(tc, hzColors)
+	if hegel.Draw(tc, dieCoin(28)) { // an underline colour nominal 28 (for a realised 20): realises 22.2
+		s.Ul = hegel.Draw(tc, hzColors)
+	}
+	return s
+})
+
+var styles = dieChoice(
+	hzW(40, hegel.Just(Style{})), // empty nominal 40: realises 40.6 in the Buffer cells, 37.7 in the Wrap pieces
+	hzW(60, styledStyles),        // composite nominal 60: realises 59.4 in the Buffer cells
+)
+
+// links is a hyperlink: none 80 percent of the time, else one of ten URLs with an id
+// parameter 30 (the old genLink).
+var links = dieChoice(
+	hzW(80, hegel.Just(Link{})), // none nominal 80: realises 79.6 in the Buffer cells
+	hzW(20, hegel.Composite(func(tc hegel.TestCase) Link {
+		l := Link{URL: fmt.Sprintf("https://example.com/%d", hegel.Draw(tc, rangeHalves(0, 9)))}
+		if hegel.Draw(tc, dieCoin(30)) { // params nominal 30: realises 28.0
+			l.Params = fmt.Sprintf("id=%d", hegel.Draw(tc, rangeHalves(0, 9)))
+		}
+		return l
+	})),
+)
+
+// --------------------------------------------------------------------------- the style
+// pairs
+
+// stylePair is a case of the sequence round-trip property: the style s read back from its
+// own sequence, and the style o the diff from which is applied over.
+type stylePair struct {
+	s, o Style
+}
+
+func (c stylePair) GoString() string {
+	return fmt.Sprintf("s=%s o=%s", hzStyleText(c.s), hzStyleText(c.o))
+}
+
+// stylePairs: s and o drawn independently, or o equal to s one time in ten (the shape of
+// cellbuf/16 when s is not empty; not drawn under HEGEL_NO_KNOWN=1). The shape of cellbuf/6
+// (a sibling attribute pair between o and s) is a relation of the two draws, filtered out by
+// the classifier under HEGEL_NO_KNOWN=1 (withoutShapes) in the property.
+var stylePairs = hegel.FlatMap(styles, func(s Style) hegel.Generator[stylePair] {
+	return hegel.Map(dieChoice(
+		hzW(90, styles), // independent nominal 90: realises 79.3 unequal pairs
+		hzW(hzUnless(hzNoKnown, 10), hegel.Just(s)), // equal nominal 10: realises 20.7 equal pairs with the chance equalities (7.6 non-empty)
+	), func(o Style) stylePair { return stylePair{s: s, o: o} })
+})
+
+// styleExpected states the sequence property's values for a pair under k: "read" (ReadStyle
+// of s.Sequence() is s), "emptyReset" (the empty style's sequence is the reset sequence),
+// "equal" (s equals itself) and "viaDiff" (the style a terminal in o.Sequence() shows after
+// s.DiffSequence(o): s; under k6 the replica's lossy result, under k16 the empty style for
+// equal non-empty styles).
+func styleExpected(c stylePair, k known) checks {
+	want := checks{}
+	want["read"] = hzStyleText(c.s)
+	want["emptyReset"] = fmt.Sprint(!hzStyleEmpty(c.s) || true)
+	want["equal"] = "true"
+	want["viaDiff"] = hzStyleText(hzDiffApplied(c.s, c.o, k))
+	return want
+}
+
+// hzDiffApplied is the style a terminal in o shows after s.DiffSequence(o) under k.
+func hzDiffApplied(s, o Style, k known) Style {
+	if hzStyleEqual(s, o) && !hzStyleEmpty(s) {
+		if k[kEqualDiffResets] {
+			return Style{}
+		}
+		return s
+	}
+	if k[kDiffDropsSibling] {
+		return hzApplyEffects(o, hzDiffEffects(s, o, k))
+	}
+	return s
+}
+
+// styleActual asks the library the same questions.
+func styleActual(c stylePair) checks {
+	got := checks{}
+	var read Style
+	readSGR(c.s.Sequence(), &read, nil)
+	got["read"] = hzStyleText(read)
+	got["emptyReset"] = fmt.Sprint(!c.s.Empty() || c.s.Sequence() == ansi.ResetStyle)
+	got["equal"] = fmt.Sprint(c.s.Equal(&c.s))
+	var viaDiff Style
+	readSGR(c.o.Sequence(), &viaDiff, nil)
+	readSGR(c.s.DiffSequence(c.o), &viaDiff, nil)
+	got["viaDiff"] = hzStyleText(viaDiff)
+	return got
+}
+
+// judgeStyle is the judge of the style pair family (shared with the narrow properties).
+func judgeStyle(j *hzCaseJudge, c stylePair) {
+	judgeBy(j, c, styleExpected, styleActual)
+}
+
+// TestHegelStyleSequencesRoundTrip: ReadStyle of a style's Sequence gives the style back, the
+// empty style's sequence is the reset, a style equals itself, and the diff from another style
+// applied over that style's sequence gives the style. The shapes of cellbuf/6 (a dropped
+// bold, faint or blink whose sibling is not re-sent) and cellbuf/16 (equal non-empty styles)
+// are drawn and fail by default naming the bug; under HEGEL_NO_KNOWN=1 the equal pair is not
+// drawn and the sibling pairs are filtered out by the classifier.
+func TestHegelStyleSequencesRoundTrip(t *testing.T) {
+	judged(t, withoutShapes(styleExpected, stylePairs), judgeStyle)
+}
+
+// --------------------------------------------------------------------------- the SGR cases
+
+// sgrParam is one SGR parameter (or colon-joined subparameters) and its documented effect.
+type sgrParam struct {
+	text  string
+	apply func(*Style)
+}
+
+func (p sgrParam) String() string { return p.text }
+
+// hzSGRKinds are the thirteen parameter kinds of the SGR table (the old 0..12 switch, drawn
+// evenly): reset; an attribute 1..9 (4 the single underline); an underline style 4:k; an off
+// code 22..29; the basic colours 30..37, 40..47, 90..97, 100..107; the defaults 39, 49, 59;
+// an extended colour (38;5;n, or 38:5:n) for fg, bg or underline; an RGB colour (38;2;r;g;b,
+// the colon form, or the colon form with an empty colour-space id).
+var hzSGRKinds = []hegel.Generator[sgrParam]{
+	hegel.Just(sgrParam{"0", func(s *Style) { *s = Style{} }}),
+	evenHalves(
+		hzAttrParam(1, BoldAttr),
+		hzAttrParam(2, FaintAttr),
+		hzAttrParam(3, ItalicAttr),
+		sgrParam{"4", func(s *Style) { s.UlStyle = SingleUnderline }},
+		hzAttrParam(5, SlowBlinkAttr),
+		hzAttrParam(6, RapidBlinkAttr),
+		hzAttrParam(7, ReverseAttr),
+		hzAttrParam(8, ConcealAttr),
+		hzAttrParam(9, StrikethroughAttr),
+	),
+	hegel.Map(rangeHalves(0, 5), func(k int) sgrParam {
+		return sgrParam{"4:" + strconv.Itoa(k), func(s *Style) { s.UlStyle = UnderlineStyle(k) }}
+	}),
+	evenHalves(
+		hzOffParam(22, BoldAttr|FaintAttr),
+		hzOffParam(23, ItalicAttr),
+		sgrParam{"24", func(s *Style) { s.UlStyle = NoUnderline }},
+		hzOffParam(25, SlowBlinkAttr|RapidBlinkAttr),
+		hzOffParam(27, ReverseAttr),
+		hzOffParam(28, ConcealAttr),
+		hzOffParam(29, StrikethroughAttr),
+	),
+	hegel.Map(rangeHalves(0, 7), func(k int) sgrParam {
+		return sgrParam{strconv.Itoa(30 + k), func(s *Style) { s.Fg = ansi.BasicColor(k) }}
+	}),
+	hegel.Map(rangeHalves(0, 7), func(k int) sgrParam {
+		return sgrParam{strconv.Itoa(40 + k), func(s *Style) { s.Bg = ansi.BasicColor(k) }}
+	}),
+	hegel.Map(rangeHalves(0, 7), func(k int) sgrParam {
+		return sgrParam{strconv.Itoa(90 + k), func(s *Style) { s.Fg = ansi.BasicColor(8 + k) }}
+	}),
+	hegel.Map(rangeHalves(0, 7), func(k int) sgrParam {
+		return sgrParam{strconv.Itoa(100 + k), func(s *Style) { s.Bg = ansi.BasicColor(8 + k) }}
+	}),
+	hegel.Just(sgrParam{"39", func(s *Style) { s.Fg = nil }}),
+	hegel.Just(sgrParam{"49", func(s *Style) { s.Bg = nil }}),
+	hegel.Just(sgrParam{"59", func(s *Style) { s.Ul = nil }}),
+	hegel.Composite(func(tc hegel.TestCase) sgrParam {
+		base := hegel.Draw(tc, hzColorBases)
+		k := hegel.Draw(tc, hzInts(0, 255))
+		text := fmt.Sprintf(hegel.Draw(tc, evenHalves("%d;5;%d", "%d:5:%d")), base.code, k) // the two spellings nominal 50 each: realise 47.2 and 52.8
+		c := ansi.ExtendedColor(k)
+		return sgrParam{text, func(s *Style) { base.set(s, c) }}
+	}),
+	hegel.Composite(func(tc hegel.TestCase) sgrParam {
+		base := hegel.Draw(tc, hzColorBases)
+		rgb := hegel.Draw(tc, hzTuple(hzInts(0, 255), hzInts(0, 255), hzInts(0, 255)))
+		r, g, bl := rgb[0], rgb[1], rgb[2]
+		// The three spellings nominal 33 each (realise 34.2, 34.3 and 31.5): the semicolon form, the colon form, the colon
+		// form with an empty colour-space id.
+		text := fmt.Sprintf(hegel.Draw(tc, evenHalves("%d;2;%d;%d;%d", "%d:2:%d:%d:%d", "%d:2::%d:%d:%d")), base.code, r, g, bl)
+		c := color.RGBA{R: uint8(r), G: uint8(g), B: uint8(bl), A: 0xff}
+		return sgrParam{text, func(s *Style) { base.set(s, c) }}
+	}),
+}
+
+func hzAttrParam(code int, attr AttrMask) sgrParam {
+	return sgrParam{strconv.Itoa(code), func(s *Style) { s.Attrs |= attr }}
+}
+
+func hzOffParam(code int, attrs AttrMask) sgrParam {
+	return sgrParam{strconv.Itoa(code), func(s *Style) { s.Attrs &^= attrs }}
+}
+
+// hzColorBase is the code of a colour parameter (38, 48 or 58) and the colour it sets.
+type hzColorBase struct {
+	code int
+	set  func(*Style, ansi.Color)
+}
+
+var hzColorBases = evenHalves(
+	hzColorBase{38, func(s *Style, c ansi.Color) { s.Fg = c }},
+	hzColorBase{48, func(s *Style, c ansi.Color) { s.Bg = c }},
+	hzColorBase{58, func(s *Style, c ansi.Color) { s.Ul = c }},
+)
+
+// sgrParams is one parameter of a kind drawn evenly from the table.
+var sgrParams = hegel.FlatMap(rangeHalves(0, len(hzSGRKinds)-1), func(i int) hegel.Generator[sgrParam] { return hzSGRKinds[i] }) // the thirteen kinds nominal 7.7 each: realise 6.3 to 8.5
+
+// sgrCase is a case of the SGR table property: a starting style (drawn 30 percent of the
+// time) and zero to six parameters.
+type sgrCase struct {
+	start  Style
+	params []sgrParam
+}
+
+func (c sgrCase) seq() string {
+	texts := make([]string, len(c.params))
+	for i, p := range c.params {
+		texts[i] = p.text
+	}
+	return "\x1b[" + strings.Join(texts, ";") + "m"
+}
+
+func (c sgrCase) GoString() string {
+	return fmt.Sprintf("sgrCase{start: %s, seq: %q}", hzStyleText(c.start), c.seq())
+}
+
+var sgrCases = hegel.Map(hzTuple[any](
+	hegel.Map(dieMaybe(46, styles), func(s Style) any { return s }),                  // a starting style nominal 46 (for a realised 30): realises 28.5
+	hegel.Map(countedHalves(sgrParams, 0, 6), func(ps []sgrParam) any { return ps }), // 0 to 6 parameters nominal 14.3 each: realise 10.5 to 18.2
+), func(v []any) sgrCase {
+	return sgrCase{start: v[0].(Style), params: v[1].([]sgrParam)}
+})
+
+// sgrExpected states the SGR table property's values: "style", the style after the
+// parameters are applied in order to the start (the reset for an empty parameter list), and
+// "reset", whether the empty list leaves the empty style. No recorded bug touches ReadStyle:
+// the model is the same under every k.
+func sgrExpected(c sgrCase, _ known) checks {
+	want := c.start
+	if len(c.params) == 0 {
+		want = Style{}
+	}
+	for _, p := range c.params {
+		p.apply(&want)
+	}
+	out := checks{}
+	out["style"] = hzStyleText(want)
+	out["reset"] = fmt.Sprint(len(c.params) > 0 || hzStyleEmpty(want))
+	return out
+}
+
+func sgrActual(c sgrCase) checks {
+	got := c.start
+	readSGR(c.seq(), &got, nil)
+	out := checks{}
+	out["style"] = hzStyleText(got)
+	out["reset"] = fmt.Sprint(len(c.params) > 0 || got.Empty())
+	return out
+}
+
+// TestHegelReadStyleFollowsTheSGRTable: a random parameter list applied by ReadStyle over a
+// starting style gives the table's result, and CSI m with no parameters is a reset.
+func TestHegelReadStyleFollowsTheSGRTable(t *testing.T) {
+	judged(t, sgrCases, func(j *hzCaseJudge, c sgrCase) {
+		judgeBy(j, c, sgrExpected, sgrActual)
+	})
+}
diff --git a/cellbuf/hegel_tabs_test.go b/cellbuf/hegel_tabs_test.go
new file mode 100644
index 0000000..b990b38
--- /dev/null
+++ b/cellbuf/hegel_tabs_test.go
@@ -0,0 +1,423 @@
+package cellbuf
+
+// The TabStops family: a word-array model of tabstop.go that is the documented set model
+// with every switch off (a word per interval of columns, a bit per column; stops at the
+// multiples of the interval; Set, Reset and IsStop beyond the width ignored and false) and
+// the library's word and bit arithmetic with the switches of cellbuf/4 and 5 on; the case
+// records, their generator and the property.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the cases
+
+// tabProbe is one Find/Next/Prev probe: a column and a delta.
+type tabProbe struct {
+	col, d int
+}
+
+// tabOp is one operation: "Set" or "Reset" at col, "Clear", or "Resize" to nw; the probes
+// are asked after it.
+type tabOp struct {
+	kind   string
+	col    int
+	nw     int
+	probes []tabProbe
+}
+
+func (o tabOp) String() string {
+	switch o.kind {
+	case "Set", "Reset":
+		return fmt.Sprintf("%s(%d)", o.kind, o.col)
+	case "Clear":
+		return "Clear()"
+	default:
+		return fmt.Sprintf("Resize(%d)", o.nw)
+	}
+}
+
+// tabCase is a case of the TabStops property: the width and interval of NewTabStops, the
+// probes asked of the new stops, and the operations.
+type tabCase struct {
+	width    int
+	interval int
+	probes   []tabProbe
+	ops      []tabOp
+}
+
+func (c tabCase) GoString() string {
+	parts := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		parts[i] = o.String()
+	}
+	return fmt.Sprintf("tabCase{NewTabStops(%d, %d); %s}", c.width, c.interval, strings.Join(parts, "; "))
+}
+
+// hzOtherIntervals are the intervals other than the default 8 (the shape of cellbuf/4: 2 and
+// 4 alias columns, 16 indexes out of range, 3, 5 and 6 produce garbage masks).
+var hzOtherIntervals = []int{2, 4, 16, 3, 5, 6}
+
+// tabIntervals: 8 four times in five, else one of the six others (never under
+// HEGEL_NO_KNOWN=1).
+var tabIntervals = dieChoice(
+	hzW(80, hegel.Just(DefaultTabInterval)),                       // 8 nominal 80: realises 80.2
+	hzW(hzUnless(hzNoKnown, 20), evenHalves(hzOtherIntervals...)), // the six others nominal 3.3 each: realise 2.5 to 4.3
+)
+
+// probesAt is four probes for a width: a column inside it and a delta of -3..3.
+func probesAt(width int) hegel.Generator[[]tabProbe] {
+	return hzCounted(hegel.Map(hzTuple(rangeHalves(0, max(width-1, 0)), rangeHalves(-3, 3)), func(v []int) tabProbe { return tabProbe{col: v[0], d: v[1]} }), 4, 4)
+}
+
+// colsAt is the column of a Set or Reset: inside the width nine times in ten, else at or
+// beyond it by up to eight (the shape of cellbuf/5; never under HEGEL_NO_KNOWN=1).
+func colsAt(width int) hegel.Generator[int] {
+	return dieChoice(
+		hzW(90, rangeHalves(0, width-1)),                          // inside nominal 90: realises 90.2 of the Set and Reset columns
+		hzW(hzUnless(hzNoKnown, 10), rangeHalves(width, width+8)), // beyond nominal 10: realises 9.8
+	)
+}
+
+// opsAt is one operation at a width: Set, Reset, Clear or Resize one time in four (the old
+// 0..3 switch); Clear or Resize alone at width 0 (the old continue).
+func opsAt(width int) hegel.Generator[tabOp] {
+	var setOrReset hegel.Generator[tabOp]
+	if width > 0 {
+		setOrReset = hegel.Map(hzTuple[any](
+			hegel.Map(evenHalves("Set", "Reset"), func(k string) any { return k }),
+			hegel.Map(colsAt(width), func(c int) any { return c }),
+		), func(v []any) tabOp { return tabOp{kind: v[0].(string), col: v[1].(int)} })
+	}
+	rest := dieChoice(
+		hzW(1, hegel.Just(tabOp{kind: "Clear"})),                                                           // Clear nominal 25: realises 24.2 of the operations
+		hzW(1, hegel.Map(rangeHalves(0, 40), func(nw int) tabOp { return tabOp{kind: "Resize", nw: nw} })), // Resize nominal 25: realises 25.0
+	)
+	if width == 0 {
+		return rest
+	}
+	return dieChoice(hzW(1, setOrReset), hzW(1, rest)) // Set and Reset nominal 25 each: realise 26.4 and 24.4
+}
+
+// opsChain is n operations, each drawn for the width after the ones before it (only Resize
+// changes it), each with its probes.
+func opsChain(width, n int) hegel.Generator[[]tabOp] {
+	if n == 0 {
+		return hegel.Just[[]tabOp](nil)
+	}
+	return hegel.FlatMap(opsAt(width), func(o tabOp) hegel.Generator[[]tabOp] {
+		w2 := width
+		if o.kind == "Resize" {
+			w2 = o.nw
+		}
+		return hegel.FlatMap(probesAt(w2), func(ps []tabProbe) hegel.Generator[[]tabOp] {
+			o.probes = ps
+			return hegel.Map(opsChain(w2, n-1), func(rest []tabOp) []tabOp { return append([]tabOp{o}, rest...) })
+		})
+	})
+}
+
+// tabCases: a width of 0 to 40, the interval, the probes of the new stops and 0 to 8
+// operations.
+var tabCases = hegel.FlatMap(hzTuple(rangeHalves(0, 40), tabIntervals, rangeHalves(0, 8)), func(d []int) hegel.Generator[tabCase] { // widths nominal 2.4 each: realise 1.4 to 4.2; 0 to 8 ops nominal 11.1 each: realise 7.7 to 13.6
+	return hegel.Map(hzTuple[any](
+		hegel.Map(probesAt(d[0]), func(ps []tabProbe) any { return ps }),
+		hegel.Map(opsChain(d[0], d[2]), func(ops []tabOp) any { return ops }),
+	), func(v []any) tabCase {
+		return tabCase{width: d[0], interval: d[1], probes: v[0].([]tabProbe), ops: v[1].([]tabOp)}
+	})
+})
+
+// --------------------------------------------------------------------------- the model
+
+// hzTabModel is the word array of tabstop.go: ceil(width/interval) words, a bit per column.
+// With every switch off a column's word is col/interval and its bit col%interval (a plain
+// bitset of the columns, the documented set model, stops at the multiples of the interval);
+// with k4 the library's col>>3 and 1<<(col&(interval-1)) (tabstop.go 50, 109, 115, 125),
+// which alias columns for other intervals and index past the words for 16. Set, Reset and
+// IsStop at or beyond the width are ignored and false by the documented rule; with k5 Set
+// and Reset index the word unchecked (a panic past the last word, a stale bit inside it) and
+// IsStop answers from the bits Resize left in the last word (tabstop.go 48, 107, 113).
+type hzTabModel struct {
+	width    int
+	interval int
+	stops    []int
+}
+
+func (ts *hzTabModel) index(col int, k known) int {
+	if k[kTabIntervalAliases] {
+		return col >> 3
+	}
+	return col / ts.interval
+}
+
+func (ts *hzTabModel) mask(col int, k known) int {
+	if k[kTabIntervalAliases] {
+		return 1 << (col & (ts.interval - 1))
+	}
+	return 1 << (col % ts.interval)
+}
+
+// set and reset return false on the library's panic (an index past the words).
+func (ts *hzTabModel) set(col int, k known) bool {
+	if col >= ts.width && !k[kTabStopsBeyondWidth] {
+		return true
+	}
+	i := ts.index(col, k)
+	if i < 0 || i >= len(ts.stops) {
+		return false
+	}
+	ts.stops[i] |= ts.mask(col, k)
+	return true
+}
+
+func (ts *hzTabModel) reset(col int, k known) bool {
+	if col >= ts.width && !k[kTabStopsBeyondWidth] {
+		return true
+	}
+	i := ts.index(col, k)
+	if i < 0 || i >= len(ts.stops) {
+		return false
+	}
+	ts.stops[i] &= ^ts.mask(col, k)
+	return true
+}
+
+func (ts *hzTabModel) isStop(col int, k known) bool {
+	if col < 0 || (col >= ts.width && !k[kTabStopsBeyondWidth]) {
+		return false
+	}
+	i := ts.index(col, k)
+	if i < 0 || i >= len(ts.stops) {
+		return false
+	}
+	return ts.stops[i]&ts.mask(col, k) != 0
+}
+
+// init is tabstop.go's init: the columns from col to width set at the multiples of the
+// interval and reset elsewhere; false on a panic.
+func (ts *hzTabModel) init(col, width int, k known) bool {
+	for x := col; x < width; x++ {
+		var ok bool
+		if x%ts.interval == 0 {
+			ok = ts.set(x, k)
+		} else {
+			ok = ts.reset(x, k)
+		}
+		if !ok {
+			return false
+		}
+	}
+	return true
+}
+
+func newTabModel(width, interval int, k known) (*hzTabModel, bool) {
+	ts := &hzTabModel{width: width, interval: interval, stops: make([]int, (width+(interval-1))/interval)}
+	return ts, ts.init(0, width, k)
+}
+
+// resize is TabStops.Resize (tabstop.go 30): the words truncated to ceil(width/interval) or
+// extended, the new columns initialised; the bits of the kept last word stay (k5 reads them).
+func (ts *hzTabModel) resize(width int, k known) bool {
+	if width == ts.width {
+		return true
+	}
+	if width < ts.width {
+		size := (width + (ts.interval - 1)) / ts.interval
+		ts.stops = ts.stops[:size]
+	} else {
+		size := (width - ts.width + (ts.interval - 1)) / ts.interval
+		ts.stops = append(ts.stops, make([]int, size)...)
+	}
+	old := ts.width
+	ts.width = width // the new columns are inside the new width for init's Set and Reset
+	return ts.init(old, width, k)
+}
+
+func (ts *hzTabModel) clear() {
+	ts.stops = make([]int, len(ts.stops))
+}
+
+// find is TabStops.Find (tabstop.go 71): a step at a time, saturating at the edges, counting
+// the stops passed.
+func (ts *hzTabModel) find(col, delta int, k known) int {
+	if delta == 0 {
+		return col
+	}
+	var prev bool
+	count := delta
+	if count < 0 {
+		count = -count
+		prev = true
+	}
+	for count > 0 {
+		if !prev {
+			if col >= ts.width-1 {
+				return col
+			}
+			col++
+		} else {
+			if col < 1 {
+				return col
+			}
+			col--
+		}
+		if ts.isStop(col, k) {
+			count--
+		}
+	}
+	return col
+}
+
+// state is the check value of a stage inside the width: IsStop over -1..width-1 and the
+// probes' Find, Next and Prev; beyond is the stage's IsStop over width..width+8 (the columns
+// of the stale bits of cellbuf/5, a check of its own so that it can be dropped).
+func (ts *hzTabModel) state(probes []tabProbe, k known) string {
+	var sb strings.Builder
+	sb.WriteString("stops ")
+	for col := -1; col < ts.width; col++ {
+		if ts.isStop(col, k) {
+			sb.WriteByte('1')
+		} else {
+			sb.WriteByte('0')
+		}
+	}
+	for _, p := range probes {
+		fmt.Fprintf(&sb, " Find(%d,%d)=%d Next=%d Prev=%d", p.col, p.d, ts.find(p.col, p.d, k), ts.find(p.col, 1, k), ts.find(p.col, -1, k))
+	}
+	return sb.String()
+}
+
+func (ts *hzTabModel) beyond(k known) string {
+	var sb strings.Builder
+	sb.WriteString("stops beyond ")
+	for col := ts.width; col < ts.width+8; col++ {
+		if ts.isStop(col, k) {
+			sb.WriteByte('1')
+		} else {
+			sb.WriteByte('0')
+		}
+	}
+	return sb.String()
+}
+
+// tabsExpected states the TabStops property's values under k: "t0" the state of the new
+// stops inside the width (the panic value when the constructor's init indexes past the
+// words, k4) and "u0" its IsStop beyond the width, "tN" and "uN" the same after operation N
+// (the panic value for a Set or Reset past the words, k5; the list cut there).
+func tabsExpected(c tabCase, k known) checks {
+	want := checks{}
+	ts, ok := newTabModel(c.width, c.interval, k)
+	if !ok {
+		want["t0"] = "panic (index out of range)"
+		return want
+	}
+	want["t0"] = ts.state(c.probes, k)
+	want["u0"] = ts.beyond(k)
+	for i, o := range c.ops {
+		ok := true
+		switch o.kind {
+		case "Set":
+			ok = ts.set(o.col, k)
+		case "Reset":
+			ok = ts.reset(o.col, k)
+		case "Clear":
+			ts.clear()
+		default:
+			ok = ts.resize(o.nw, k)
+		}
+		name := fmt.Sprintf("t%d", i+1)
+		if !ok {
+			want[name] = "panic (index out of range)"
+			return want
+		}
+		want[name] = ts.state(o.probes, k)
+		want[fmt.Sprintf("u%d", i+1)] = ts.beyond(k)
+	}
+	return want
+}
+
+func hzTabState(ts *TabStops, width int, probes []tabProbe) string {
+	var sb strings.Builder
+	sb.WriteString("stops ")
+	for col := -1; col < width; col++ {
+		if ts.IsStop(col) {
+			sb.WriteByte('1')
+		} else {
+			sb.WriteByte('0')
+		}
+	}
+	for _, p := range probes {
+		fmt.Fprintf(&sb, " Find(%d,%d)=%d Next=%d Prev=%d", p.col, p.d, ts.Find(p.col, p.d), ts.Next(p.col), ts.Prev(p.col))
+	}
+	return sb.String()
+}
+
+func hzTabBeyond(ts *TabStops, width int) string {
+	var sb strings.Builder
+	sb.WriteString("stops beyond ")
+	for col := width; col < width+8; col++ {
+		if ts.IsStop(col) {
+			sb.WriteByte('1')
+		} else {
+			sb.WriteByte('0')
+		}
+	}
+	return sb.String()
+}
+
+func tabsActual(c tabCase) checks {
+	got := checks{}
+	var ts *TabStops
+	if r := hzCatch(func() { ts = NewTabStops(c.width, c.interval) }); r != nil {
+		got["t0"] = hzPanicValue(r)
+		return got
+	}
+	width := c.width
+	got["t0"] = hzTabState(ts, width, c.probes)
+	got["u0"] = hzTabBeyond(ts, width)
+	for i, o := range c.ops {
+		r := hzCatch(func() {
+			switch o.kind {
+			case "Set":
+				ts.Set(o.col)
+			case "Reset":
+				ts.Reset(o.col)
+			case "Clear":
+				ts.Clear()
+			default:
+				ts.Resize(o.nw)
+				width = o.nw
+			}
+		})
+		name := fmt.Sprintf("t%d", i+1)
+		if r != nil {
+			got[name] = hzPanicValue(r)
+			return got
+		}
+		got[name] = hzTabState(ts, width, o.probes)
+		got[fmt.Sprintf("u%d", i+1)] = hzTabBeyond(ts, width)
+	}
+	return got
+}
+
+// judgeTabs is the judge of the TabStops family (shared with the narrow properties): by
+// default every check; under HEGEL_NO_KNOWN=1 the checks the shape covers are dropped (the
+// IsStop beyond the width after a Resize that left stale bits, cellbuf/5: a relation of the
+// operations the generator cannot switch off) and the case goes on.
+func judgeTabs(j *hzCaseJudge, c tabCase) {
+	judgeByDropping(j, c, tabsExpected, tabsActual)
+}
+
+// TestHegelTabStopsFollowTheModel: tab stops of a width of 0 to 40 at an interval (8 four
+// times in five) under 0 to 8 operations (Set, Reset, Clear, Resize) answer IsStop over
+// -1..width+8 and Find/Next/Prev at four columns per stage as the set model does. The shapes
+// of cellbuf/4 (an interval other than 8) and 5 (a Set or Reset at or beyond the width) are
+// drawn and fail by default naming the bug; neither is drawn under HEGEL_NO_KNOWN=1.
+func TestHegelTabStopsFollowTheModel(t *testing.T) {
+	judged(t, tabCases, judgeTabs)
+}
diff --git a/cellbuf/hegel_test.go b/cellbuf/hegel_test.go
new file mode 100644
index 0000000..e28ada3
--- /dev/null
+++ b/cellbuf/hegel_test.go
@@ -0,0 +1,687 @@
+// Hegel properties for charmbracelet/x/cellbuf: the cell Buffer against a grid model with the
+// terminal's wide-cell semantics, Render/SetContent round trips, SGR sequences and ReadStyle,
+// Wrap's preservation of content and styles, TabStops against a set model, cell constructors
+// against go-runewidth/uniseg, and Screen's optimised output replayed into the monorepo's vt
+// terminal emulator and compared cell by cell.
+//
+// The test lives in package cellbuf to read Screen's two buffers; every identifier carries
+// the hz prefix or a name of the series' harness (known, checks, judged, shapeBy, verdict,
+// regionOf, the die* family and the halving helpers, as in go/go-debian and go/gin) to stay
+// clear of the upstream tests of the package. This file is the harness: hegelOpts, the
+// property wrapper, the collector, the switches (known), the judge, the checks and the
+// classifier. The models and properties are in hegel_buffer_test.go (the grid model, the
+// Buffer and Render properties), hegel_style_test.go (the SGR table model, the two style
+// properties), hegel_wrap_test.go, hegel_tabs_test.go, hegel_cells_test.go; the eleven narrow
+// properties in hegel_shapes_test.go; the pins and the fixed examples in hegel_pins_test.go;
+// the Screen property (part 2 of the rewrite, still on the old helpers and gates) in
+// hegel_screen_test.go. ZOO_COLLECT=1 (or HEGEL_COLLECT=1) makes the rewritten properties
+// record their mismatches instead of failing and print the counts; CELLBUF_COLLECT=1 does the
+// same for the Screen property.
+//
+// The standard (DESIGN.md decision 3, STYLE.md rule 11): the model of every family is a pure
+// function of (case, known) that states the documented behaviour with every switch off and
+// reproduces a recorded bug's rule, transcribed from the library, with its switch on; the
+// classifier runs the model per switch before the library is called and names the shape of
+// the case, the properties judge the library against the documented values and fail naming
+// the shape, and under HEGEL_NO_KNOWN=1 the shapes are not drawn, filtered out, or dropped
+// from the case.
+package cellbuf
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hegelOpts passes HEGEL_TEST_CASES and HEGEL_SEED through to the engine, which reads no
+// environment variable itself (the seed is for the rate measurements of the probe and the
+// collector).
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi, go/go-debian and go/gin judge;
+// hegel_idioms_test.go has the generator idioms). The model of each family takes the set of
+// recorded bugs it follows as a value (known); the properties judge the library against the
+// documented behaviour (hzKnownNone), name the shape of the recorded bug a case has before
+// the library is called (hzCaseJudge.Shape, from the classifier) and skip, drop or filter the
+// shapes under HEGEL_NO_KNOWN=1 (hzNoKnown).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if hzIsHegelPanic(r) {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// hzIsHegelPanic is whether a recovered value is Hegel's own control flow (re-raised, never
+// judged).
+func hzIsHegelPanic(r any) bool {
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		return true
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+		return true
+	}
+	return false
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != "" || os.Getenv("HEGEL_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// note records a message of a class that is not a failure (a replica disagreement): counted,
+// and its first two messages kept.
+func (c *hzCollector) note(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml) the models can follow, indexed by the constants below
+// in bug order (the id of a switch is "cellbuf/<index+1>"). The model of each family is a
+// pure function of (case, known): with every switch off (hzKnownNone) it states the
+// documented behaviour (the README's grid semantics, the doc comments of buffer.go, cell.go,
+// tabstop.go and wrap.go, the SGR table) and is what the properties judge the library
+// against; with a switch on it reproduces that bug as a replica of the library's rule,
+// transcribed at the point named beside the switch (hegel_buffer_test.go for 1, 2, 3, 9 and
+// 10, hegel_style_test.go for 6 and 16, hegel_wrap_test.go for 8, hegel_tabs_test.go for 4
+// and 5, hegel_cells_test.go for 7). The classifier of each family runs the model with
+// several sets to name the shape of a case before the library is called; the pins assert the
+// documented behaviour and fail while the bug exists. 11 to 15, 17 and 18 are the Screen
+// property's (part 2 of the rewrite) and only exist here so that the ids are complete.
+type known [18]bool
+
+const (
+	// cellbuf/1: InsertLine, DeleteLine and DeleteCell destroy every wide cell they move
+	kShiftsBlankWideCells = iota
+	// cellbuf/2: a wide cell written over the head of another wide cell leaves that cell's placeholder orphaned
+	kWideOverHeadOrphans
+	// cellbuf/3: Buffer.Resize cuts lines through wide cells, leaving a two-column head in the last column
+	kResizeCutsWideCells
+	// cellbuf/4: TabStops only work for an interval of 8: other intervals alias columns or index out of range
+	kTabIntervalAliases
+	// cellbuf/5: TabStops.Set and Reset panic for a column beyond the width, where IsStop answers from stale bits
+	kTabStopsBeyondWidth
+	// cellbuf/6: Style.DiffSequence drops bold, faint or a blink when it turns off the sibling attribute
+	kDiffDropsSibling
+	// cellbuf/7: NewCell appends every rune and sums their widths, contrary to its documentation
+	kNewCellAppendsAll
+	// cellbuf/8: Wrap lets a trailing space push a line one column past the limit
+	kWrapTrailingSpace
+	// cellbuf/9: a combining mark decoded on its own is attached to the following cell, not the preceding one
+	kMarkAttachesNext
+	// cellbuf/10: the line and cell shift operations panic for a rectangle that extends beyond the buffer
+	kShiftRectsPanic
+	// cellbuf/11: blank cells drawn after a styled cell are painted with that cell's style and hyperlink
+	kBlanksInheritPen
+	// cellbuf/12: clearBottom erases from the row above the blank region, wiping a row that is never redrawn
+	kClearBottomAbove
+	// cellbuf/13: Render loops forever when a wide cell is drawn in column 0 over a row whose content was only in column 0
+	kRenderHangs
+	// cellbuf/14: the overwrite cursor-move optimisation prints a space over a wide cell's placeholder, blanking the cell
+	kOverwriteBlanksWide
+	// cellbuf/15: REP is used for Latin-1 characters although the code restricts it to ASCII
+	kRepForLatin1
+	// cellbuf/16: DiffSequence of two equal, non-empty styles is the reset sequence
+	kEqualDiffResets
+	// cellbuf/17: scroll optimisation without SU writes its newlines at the top row, so the terminal never scrolls
+	kScrollUpAtTop
+	// cellbuf/18: on terminals without ICH, inserting before a wide cell writes the wide cell twice and loses the cell after it
+	kInsertDuplicatesWide
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("cellbuf/N"); hzKnownIndex the switch of a bug id
+// (-1 for none or the hole).
+func hzKnownID(i int) string { return "cellbuf/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "cellbuf/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape cellbuf/N"
+// per case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape hole"), the cases skipped for them under HEGEL_NO_KNOWN=1 ("known
+// cellbuf/N"), the steps or checks dropped for them under HEGEL_NO_KNOWN=1 ("dropped
+// cellbuf/N"), the draws the filters rejected ("filtered <name>"), the replica's agreement
+// with the library on the shaped cases ("replica agreement", "replica disagreement") and the
+// cases noted for a design exclusion ("noted <what>"); printed and reset by the collector,
+// under hzStatsMu. (A case assumed away for an unrecorded candidate bug would be counted
+// "candidate/go/cellbuf-N ..." here; none is left.)
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi, go/go-debian and go/gin judge, with the
+// collector's mismatch classes): it names the recorded bug whose shape the case has, so that
+// a mismatch or a library panic fails "(the shape of cellbuf/N)", and under HEGEL_NO_KNOWN=1
+// skips the case instead (counted as known). The wide and the narrow properties of a family
+// share their judge function and so this. The classifier that names the shape is computed
+// from the case alone (the model run with several sets of switches), before the library is
+// called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are not drawn,
+// filtered out by the classifier, or the regions past them drawn), and the collector
+// measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped cellbuf/N") and the case goes on
+// (judgeByDropping).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow).
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	if hzIsHegelPanic(r) {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (shared by every family; the go/carbon, go/orb, go/chi, go/go-debian and go/gin
+// form: every value here is text compared exactly).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole set for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two.
+type checks map[string]string
+
+func (c checks) set(name string, v any) { c[name] = fmt.Sprint(v) }
+
+// hzPanicValue is the check value of a step the library (or the replica) panics on: the
+// message without the indices, so that the replica's value and the library's agree.
+func hzPanicValue(r any) string {
+	msg := fmt.Sprint(r)
+	if strings.HasPrefix(msg, "runtime error: index out of range") {
+		return "panic (index out of range)"
+	}
+	return "panic: " + msg
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned; Hegel's own control
+// flow is re-raised.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		if r := recover(); r != nil {
+			if hzIsHegelPanic(r) {
+				panic(r)
+			}
+			recovered = r
+		}
+	}()
+	f()
+	return nil
+}
+
+// checkLess orders the check names when a failure lists them: the numbered steps or stages
+// ("s1", "s2", ..., "t0", "t1", ..., "u0", "u1", ...) by letter then number, then the rest by
+// text.
+func checkLess(a, b string) bool {
+	an, aok := hzStepNumber(a)
+	bn, bok := hzStepNumber(b)
+	if aok && bok {
+		if a[0] != b[0] {
+			return a[0] < b[0]
+		}
+		return an < bn
+	}
+	if aok != bok {
+		return aok
+	}
+	return a < b
+}
+
+func hzStepNumber(name string) (int, bool) {
+	if len(name) < 2 || (name[0] != 's' && name[0] != 't' && name[0] != 'u') {
+		return 0, false
+	}
+	n, err := strconv.Atoi(name[1:])
+	return n, err == nil
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two statements agree: the same checks, each value equal.
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order.
+func diffChecks(a, b checks) string {
+	var parts []string
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || a[k] != w {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, a[k]))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, a[k], w))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, b[k]))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("cellbuf/?", a defect of the model).
+// The order matters where two shapes meet: sufficiency in bug order names the lower id (an
+// orphan of cellbuf/2 inside a shifted region of cellbuf/1 is named 1; the Buffer family
+// classifies step by step instead, hegel_buffer_test.go).
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "cellbuf/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule.
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	verdictBy(j, c, got, want, shape, expected, sameChecks)
+}
+
+// verdictBy is verdict with the family's own notion of replica agreement (none of this
+// target's families needs one; the form is kept from go/chi, whose RouteHeaders replica is a
+// set and agreement is membership).
+func verdictBy[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks, agrees func(got, replica checks) bool) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agrees(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.note("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if sameChecks(got, want) {
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || g != want[k] {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	j.Fail(class, "%s for\n%#v", diffChecks(got, want), c)
+}
+
+// judgeBy is the judge of a family: the shape first, then the library.
+func judgeBy[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	judgeShaped(j, c, classify(c, expected), expected, actual)
+}
+
+// judgeShaped is judgeBy with the shape named by the family's own classifier (the Buffer
+// family's step-wise one).
+func judgeShaped[T any](j *hzCaseJudge, c T, shape string, expected func(T, known) checks, actual func(T) checks) {
+	j.Shape(shape)
+	want := expected(c, hzKnownNone)
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi, go/go-debian and go/gin form): by default the shape is
+// named and every check judged; under HEGEL_NO_KNOWN=1 the checks the shapes cover (those on
+// which the replica with every switch on differs from the documented model, or which it does
+// not state) are dropped from the case (hzCaseJudge.Dropped, counted "dropped cellbuf/N")
+// and the rest judged, the case not skipped. No property of this part needs it (the Buffer
+// family drops shaped steps from the case under HEGEL_NO_KNOWN=1 instead, the others filter
+// or switch the shapes off); kept for part 2.
+func judgeByDropping[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(c, expected)
+	want := expected(c, hzKnownNone)
+	if shape != "" && j.Dropped(shape) {
+		all := expected(c, hzKnownAll)
+		for name, v := range want {
+			if w, ok := all[name]; !ok || w != v {
+				delete(want, name)
+			}
+		}
+		verdict(j, c, actual(c), want, "", expected)
+		return
+	}
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few model runs.
+// regionBy is the same with the family's own classifier.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	return regionBy(id, func(c T) string { return shapeID(c, expected) }, cases)
+}
+
+func regionBy[T any](id string, shape func(T) string, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool { return shape(c) == want })
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered cellbuf/N" by the shape it had), g itself otherwise: the
+// form of a wide property whose shape is a relation between the parts of a case that the
+// generator cannot switch off (the style pairs with a sibling attribute pair, the wrap inputs
+// with a trailing space over the limit).
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// --------------------------------------------------------------------------- the pins'
+// helpers
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func styleString(s Style) string {
+	return fmt.Sprintf("{fg:%v bg:%v ul:%v attrs:%08b uls:%d}", s.Fg, s.Bg, s.Ul, s.Attrs, s.UlStyle)
+}
+
+func cellString(c *Cell) string {
+	if c == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%q w%d %s %v}", c.String(), c.Width, styleString(c.Style), c.Link)
+}
diff --git a/cellbuf/hegel_wrap_test.go b/cellbuf/hegel_wrap_test.go
new file mode 100644
index 0000000..6168da3
--- /dev/null
+++ b/cellbuf/hegel_wrap_test.go
@@ -0,0 +1,362 @@
+package cellbuf
+
+// The Wrap family: the input as a record of pieces rendered by a pure function, the model's
+// reading of a styled text (x/ansi's decoder with the SGR table model), the replica of Wrap
+// (wrap.go 23) under the switch of cellbuf/8, and the property.
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+// ansiStrip is x/ansi's Strip (named here so that the model files read alike).
+func ansiStrip(s string) string { return ansi.Strip(s) }
+
+// --------------------------------------------------------------------------- the pieces
+
+// wrapPiece is one piece of a Wrap input: a style sequence ("style"), the reset ("reset"), a
+// hyperlink ("link"), a whitespace or breakpoint atom ("atom"), or a word of one to six
+// graphemes with a space after it 60 percent of the time ("word").
+type wrapPiece struct {
+	kind  string
+	style Style
+	link  Link
+	atom  string
+	word  []string
+	space bool
+}
+
+func (p wrapPiece) text() string {
+	switch p.kind {
+	case "style":
+		return hzStyleSequence(p.style)
+	case "reset":
+		return "\x1b[m"
+	case "link":
+		return ansi.SetHyperlink(p.link.URL, p.link.Params)
+	case "atom":
+		return p.atom
+	default:
+		s := strings.Join(p.word, "")
+		if p.space {
+			s += " "
+		}
+		return s
+	}
+}
+
+var hzWrapAtoms = []string{" ", "  ", "\n", "\t", "\u00a0", "-", " - "}
+
+// wrapPieces is one piece: a style one time in ten, the reset one, a link one, an atom one,
+// a word six (the old 0..9 switch).
+var wrapPieces = dieChoice(
+	hzW(1, hegel.Map(styles, func(s Style) wrapPiece { return wrapPiece{kind: "style", style: s} })),                    // style nominal 10: realises 10.8 of the pieces
+	hzW(1, hegel.Just(wrapPiece{kind: "reset"})),                                                                        // reset nominal 10: realises 9.2
+	hzW(1, hegel.Map(links, func(l Link) wrapPiece { return wrapPiece{kind: "link", link: l} })),                        // link nominal 10: realises 10.0
+	hzW(1, hegel.Map(evenHalves(hzWrapAtoms...), func(a string) wrapPiece { return wrapPiece{kind: "atom", atom: a} })), // atom nominal 10: realises 9.6 (the seven atoms 11.1 to 19.4 of them)
+	hzW(6, hegel.Map(hzTuple[any](
+		hegel.Map(countedHalves(graphemes, 1, 6), func(w []string) any { return w }), // 1 to 6 graphemes nominal 16.7 each: realise 16.1 to 17.7
+		hegel.Map(dieCoin(60), func(b bool) any { return b }),                        // a space after the word nominal 60: realises 57.7
+	), func(v []any) wrapPiece { return wrapPiece{kind: "word", word: v[0].([]string), space: v[1].(bool)} })), // word nominal 60: realises 60.3
+)
+
+// hzWrapCase is a case of the Wrap property: the pieces, the limit and the breakpoints. (The
+// upstream wrap_test.go declares wrapCases, hence the prefix.)
+type hzWrapCase struct {
+	pieces []wrapPiece
+	limit  int
+	bp     string
+}
+
+func (c hzWrapCase) input() string {
+	var sb strings.Builder
+	for _, p := range c.pieces {
+		sb.WriteString(p.text())
+	}
+	return sb.String()
+}
+
+func (c hzWrapCase) GoString() string {
+	return fmt.Sprintf("Wrap(%q, %d, %q)", c.input(), c.limit, c.bp)
+}
+
+// hzWrapCases: 0 to 12 pieces, a limit of 1 to 16, the breakpoints "", "-" or ".,". The
+// shape of cellbuf/8 (pending spaces committed before a breakpoint that does not fit) is a
+// relation of the pieces and the limit, filtered out by the classifier under HEGEL_NO_KNOWN=1
+// (withoutShapes) in the property.
+var hzWrapCases = hegel.Map(hzTuple[any](
+	hegel.Map(countedHalves(wrapPieces, 0, 12), func(ps []wrapPiece) any { return ps }), // 0 to 12 pieces nominal 7.7 each: realise 4.9 to 9.6
+	hegel.Map(rangeHalves(1, 16), func(l int) any { return l }),                         // limits nominal 6.3 each: realise 4.8 to 7.1
+	hegel.Map(evenHalves("", "-", ".,"), func(b string) any { return b }),               // breakpoints nominal 33 each: realise 33.9/35.4/30.7
+), func(v []any) hzWrapCase {
+	return hzWrapCase{pieces: v[0].([]wrapPiece), limit: v[1].(int), bp: v[2].(string)}
+})
+
+// --------------------------------------------------------------------------- the reading
+
+// hzStyledGraphemes walks a styled text and returns its non-space graphemes with the style
+// and link in force at each (read through the SGR table model), and the plain text with all
+// whitespace removed.
+func hzStyledGraphemes(s string) (gs []string, sts []Style, lns []Link, plain string) {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st Style
+	var ln Link
+	var state byte
+	for len(s) > 0 {
+		sq, width, k, ns := ansi.DecodeSequence(s, state, p)
+		if width == 0 {
+			if ansi.HasCsiPrefix(sq) && p.Command() == 'm' {
+				hzReadStyle(p.Params(), &st)
+			} else if ansi.HasOscPrefix(sq) && p.Command() == 8 {
+				hzReadLink(p.Data(), &ln)
+			}
+		} else if r := []rune(sq); !(len(r) == 1 && unicode.IsSpace(r[0])) {
+			gs = append(gs, sq)
+			sts = append(sts, st)
+			lns = append(lns, ln)
+			plain += sq
+		}
+		s = s[k:]
+		state = ns
+	}
+	return
+}
+
+// hzOverflowing lists the lines of a wrapped text wider than the limit, except a line of a
+// one-column limit holding a wide grapheme (a design exclusion: a wide grapheme cannot fit a
+// one-column limit; excluded reports one, and the property counts the case "noted wide at
+// limit 1").
+func hzOverflowing(out string, limit int) (over []int, excluded bool) {
+	over = []int{}
+	for i, line := range strings.Split(out, "\n") {
+		if ansi.StringWidth(line) > limit {
+			if limit < 2 && strings.ContainsAny(ansi.Strip(line), strings.Join(hzWideAtoms, "")) {
+				excluded = true
+				continue
+			}
+			over = append(over, i)
+		}
+	}
+	return over, excluded
+}
+
+// --------------------------------------------------------------------------- the replica
+
+// hzWrap is Wrap (wrap.go 23) transcribed, the style and link read through the models: the
+// pending spaces are committed to the line (addSpace, wrap.go 140) when a breakpoint
+// character arrives, BEFORE the check whether the breakpoint fits, so a full line gains its
+// trailing spaces past the limit (cellbuf/8); the documented rule ("every line fits the
+// limit") has no replica of its own here: the model's overflow list is empty without k8.
+func hzWrap(s string, limit int, breakpoints string) string {
+	if len(s) == 0 {
+		return ""
+	}
+	if limit < 1 {
+		return s
+	}
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var (
+		buf             bytes.Buffer
+		word            bytes.Buffer
+		space           bytes.Buffer
+		style, curStyle Style
+		link, curLink   Link
+		curWidth        int
+		wordLen         int
+	)
+	hasBlankStyle := func() bool {
+		return style.Attrs&ReverseAttr == 0 && style.Bg == nil && style.UlStyle == NoUnderline
+	}
+	addSpace := func() {
+		curWidth += space.Len()
+		buf.Write(space.Bytes())
+		space.Reset()
+	}
+	addWord := func() {
+		if word.Len() == 0 {
+			return
+		}
+		curLink = link
+		curStyle = style
+		addSpace()
+		curWidth += wordLen
+		buf.Write(word.Bytes())
+		word.Reset()
+		wordLen = 0
+	}
+	addNewline := func() {
+		if !hzStyleEmpty(curStyle) {
+			buf.WriteString(ansi.ResetStyle)
+		}
+		if curLink.URL != "" || curLink.Params != "" {
+			buf.WriteString(ansi.ResetHyperlink())
+		}
+		buf.WriteByte('\n')
+		if curLink.URL != "" || curLink.Params != "" {
+			buf.WriteString(ansi.SetHyperlink(curLink.URL, curLink.Params))
+		}
+		if !hzStyleEmpty(curStyle) {
+			buf.WriteString(hzStyleSequence(curStyle))
+		}
+		curWidth = 0
+		space.Reset()
+	}
+	var state byte
+	for len(s) > 0 {
+		seq, width, n, newState := ansi.DecodeSequence(s, state, p)
+		switch width {
+		case 0:
+			if ansi.Equal(seq, "\t") {
+				addWord()
+				space.WriteString(seq)
+				break
+			} else if ansi.Equal(seq, "\n") {
+				if wordLen == 0 {
+					if curWidth+space.Len() > limit {
+						curWidth = 0
+					} else {
+						buf.Write(space.Bytes())
+					}
+					space.Reset()
+				}
+				addWord()
+				addNewline()
+				break
+			} else if ansi.HasCsiPrefix(seq) && p.Command() == 'm' {
+				hzReadStyle(p.Params(), &style)
+			} else if ansi.HasOscPrefix(seq) && p.Command() == 8 {
+				hzReadLink(p.Data(), &link)
+			}
+			word.WriteString(seq)
+		default:
+			if len(seq) == 1 {
+				r, _ := utf8.DecodeRuneInString(seq)
+				if r != nbsp && unicode.IsSpace(r) && hasBlankStyle() {
+					addWord()
+					space.WriteRune(r)
+					break
+				} else if r == '-' || strings.ContainsRune(breakpoints, r) {
+					addSpace() // wrap.go 140: the spaces are committed before the fit check (k8)
+					if curWidth+wordLen+width <= limit {
+						addWord()
+						buf.WriteString(seq)
+						curWidth += width
+						break
+					}
+				}
+			}
+			if wordLen+width > limit {
+				addWord()
+			}
+			word.WriteString(seq)
+			wordLen += width
+			if curWidth+wordLen+space.Len() > limit {
+				addNewline()
+			}
+		}
+		s = s[n:]
+		state = newState
+	}
+	if wordLen == 0 {
+		if curWidth+space.Len() > limit {
+			curWidth = 0
+		} else {
+			buf.Write(space.Bytes())
+		}
+		space.Reset()
+	}
+	addWord()
+	if curLink.URL != "" || curLink.Params != "" {
+		buf.WriteString(ansi.ResetHyperlink())
+	}
+	if !hzStyleEmpty(curStyle) {
+		buf.WriteString(ansi.ResetStyle)
+	}
+	return buf.String()
+}
+
+// --------------------------------------------------------------------------- the model
+
+// wrapExpected states the Wrap property's values under k: "overflow", the lines wider than
+// the limit (none by the documented rule; the replica's with k8); "content", "styles" and
+// "links", the non-space graphemes of the input in order with the style and link in force at
+// each; "newlines", the explicit newlines kept; "height", Height agreeing with the newlines.
+func wrapExpected(c hzWrapCase, k known) checks {
+	want := checks{}
+	over := []int{}
+	if k[kWrapTrailingSpace] {
+		over, _ = hzOverflowing(hzWrap(c.input(), c.limit, c.bp), c.limit)
+	}
+	want["overflow"] = fmt.Sprint(over)
+	gs, sts, lns, plain := hzStyledGraphemes(c.input())
+	want["content"] = plain
+	want["styles"] = hzStylesText(gs, sts)
+	want["links"] = hzLinksText(gs, lns)
+	want["newlines"] = "kept"
+	want["height"] = "ok"
+	return want
+}
+
+func hzStylesText(gs []string, sts []Style) string {
+	parts := make([]string, len(gs))
+	for i := range gs {
+		parts[i] = fmt.Sprintf("%q %s", gs[i], hzStyleText(sts[i]))
+	}
+	return strings.Join(parts, ", ")
+}
+
+func hzLinksText(gs []string, lns []Link) string {
+	parts := make([]string, len(gs))
+	for i := range gs {
+		parts[i] = fmt.Sprintf("%q %s", gs[i], hzLinkText(lns[i]))
+	}
+	return strings.Join(parts, ", ")
+}
+
+func wrapActual(c hzWrapCase) checks {
+	in := c.input()
+	out := Wrap(in, c.limit, c.bp)
+	got := checks{}
+	over, excluded := hzOverflowing(out, c.limit)
+	if excluded {
+		hzTally("noted wide at limit 1")
+	}
+	got["overflow"] = fmt.Sprint(over)
+	gs, sts, lns, plain := hzStyledGraphemes(out)
+	got["content"] = plain
+	got["styles"] = hzStylesText(gs, sts)
+	got["links"] = hzLinksText(gs, lns)
+	got["newlines"] = "kept"
+	if strings.Count(out, "\n") < strings.Count(in, "\n") {
+		got["newlines"] = fmt.Sprintf("lost: %d of %d", strings.Count(in, "\n")-strings.Count(out, "\n"), strings.Count(in, "\n"))
+	}
+	got["height"] = "ok"
+	if h := Height(out); h != strings.Count(out, "\n")+1 {
+		got["height"] = fmt.Sprintf("Height %d for %d newlines", h, strings.Count(out, "\n"))
+	}
+	return got
+}
+
+// judgeWrap is the judge of the Wrap family (shared with the narrow property).
+func judgeWrap(j *hzCaseJudge, c hzWrapCase) {
+	judgeBy(j, c, wrapExpected, wrapActual)
+}
+
+// TestHegelWrapKeepsContentAndStyles: Wrap of a styled text with hyperlinks, spaces, tabs,
+// non-breaking spaces, hyphens and newlines at a limit of 1 to 16 gives lines that fit the
+// limit (a wide grapheme at limit 1 excepted) and keeps the non-space graphemes in order
+// with their styles and links, the explicit newlines, and a Height that counts them. The
+// shape of cellbuf/8 (a full line followed by spaces and a breakpoint) is drawn at its
+// natural rate and fails by default naming the bug.
+func TestHegelWrapKeepsContentAndStyles(t *testing.T) {
+	judged(t, withoutShapes(wrapExpected, hzWrapCases), judgeWrap)
+}
