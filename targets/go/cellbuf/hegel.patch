+// ---------------------------------------------------------------- Wrap
+
+// styledGraphemes walks s and returns its non-space graphemes with the style and link in
+// force at each, plus the plain text with all whitespace removed.
+func styledGraphemes(s string) (gs []string, sts []Style, lns []Link, plain string) {
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var st Style
+	var ln Link
+	var state byte
+	for len(s) > 0 {
+		sq, width, k, ns := ansi.DecodeSequence(s, state, p)
+		if width == 0 {
+			if ansi.HasCsiPrefix(sq) && p.Command() == 'm' {
+				ReadStyle(p.Params(), &st)
+			} else if ansi.HasOscPrefix(sq) && p.Command() == 8 {
+				ReadLink(p.Data(), &ln)
+			}
+		} else if r := []rune(sq); !(len(r) == 1 && unicode.IsSpace(r[0])) {
+			gs = append(gs, sq)
+			sts = append(sts, st)
+			lns = append(lns, ln)
+			plain += sq
+		}
+		s = s[k:]
+		state = ns
+	}
+	return
+}
+
+func genWrapInput(tc hegel.TestCase) string {
+	var sb strings.Builder
+	for k := n(tc, 0, 12); k > 0; k-- {
+		switch n(tc, 0, 9) {
+		case 0:
+			sb.WriteString(genStyle(tc).Sequence())
+		case 1:
+			sb.WriteString("\x1b[m")
+		case 2:
+			l := genLink(tc)
+			sb.WriteString(ansi.SetHyperlink(l.URL, l.Params))
+		case 3:
+			sb.WriteString(pick(tc, []string{" ", "  ", "\n", "\t", "\u00a0", "-", " - "}))
+		default:
+			for j := n(tc, 1, 6); j > 0; j-- {
+				sb.WriteString(genGrapheme(tc, true))
+			}
+			if chance(tc, 60) {
+				sb.WriteString(" ")
+			}
+		}
+	}
+	return sb.String()
+}
+
+func TestHegelWrapKeepsContentAndStyles(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		in := genWrapInput(ht)
+		limit := n(ht, 1, 16)
+		bp := pick(ht, []string{"", "-", ".,"})
+		note(ht, "Wrap(%q, %d, %q)", in, limit, bp)
+		out := Wrap(in, limit, bp)
+		// Every line fits (a wide grapheme cannot fit in a one-column limit).
+		for i, line := range strings.Split(out, "\n") {
+			if w := ansi.StringWidth(line); w > limit {
+				if ansi.StringWidth(strings.TrimRight(ansi.Strip(line), " \t")) <= limit {
+					count("trailing-space-over-limit") // cellbuf/8
+					continue
+				}
+				if limit < 2 && strings.ContainsAny(ansi.Strip(line), strings.Join(wideGraphemes, "")) {
+					count("wide-in-limit-1")
+					continue
+				}
+				fail(ht, "line %d %q has width %d > %d in %q", i, line, w, limit, out)
+			}
+		}
+		// Non-space content, in order, with its styles and links.
+		gi, si, li, pi := styledGraphemes(in)
+		go_, so, lo, po := styledGraphemes(out)
+		if pi != po {
+			fail(ht, "content changed: %q -> %q (plain %q vs %q)", in, out, pi, po)
+		}
+		for i := range gi {
+			if gi[i] != go_[i] {
+				fail(ht, "grapheme %d: %q vs %q", i, gi[i], go_[i])
+			}
+			if !si[i].Equal(&so[i]) {
+				fail(ht, "grapheme %d %q: style %s in, %s out\nin  %q\nout %q", i, gi[i], styleString(si[i]), styleString(so[i]), in, out)
+			}
+			if !li[i].Equal(&lo[i]) {
+				fail(ht, "grapheme %d %q: link %v in, %v out\nin  %q\nout %q", i, gi[i], li[i], lo[i], in, out)
+			}
+		}
+		// Explicit newlines survive.
+		if strings.Count(out, "\n") < strings.Count(in, "\n") {
+			fail(ht, "newlines lost: %q -> %q", in, out)
+		}
+		if got := Height(out); got != strings.Count(out, "\n")+1 {
+			fail(ht, "Height(%q) = %d", out, got)
+		}
+		count("ok")
+	})
+}
