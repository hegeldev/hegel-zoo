+// --------------------------------------------------------------------------- cellbuf/18
+
+// lcell is a cell of the line model: its content and width (a placeholder has "" and 0).
+type lcell struct {
+	s string
+	w int
+}
+
+// hzLineReplay applies a one-row screen's output to a line model that honours insert mode
+// (IRM), which the vt emulator does not implement: the pin's replayLine (hegel_pins_test.go)
+// extended with the sequences the constructions' frames emit: CUP with a column, TAB, EL,
+// ECH, ED, DCH, ICH and REP, and the terminal's wide-cell rule (a cell written over any column
+// of a wide cell blanks that cell; a wide cell pushed across the right edge, or cut by a
+// delete, is blanked). Only the sequences Screen emits for such a frame are interpreted. The
+// cursor starts at cur, the screen's own cursor column before the frame (the terminal's
+// after the frames before).
+func hzLineReplay(line []lcell, cur int, out string) (final []lcell, blanked bool) {
+	width := len(line)
+	line = slices.Clone(line)
+	cur, irm := max(0, min(cur, width-1)), false
+	var last lcell
+	blankWide := func(x int) { // the emulator's rule: a wide head under x, or one column back from a trailing column
+		if x < 0 || x >= width {
+			return
+		}
+		head := x
+		if line[x].w == 0 && x > 0 && line[x-1].w > 1 {
+			head = x - 1
+		}
+		if line[head].w <= 1 {
+			return
+		}
+		for i, end := head, min(head+line[head].w, width); i < end; i++ {
+			line[i] = lcell{" ", 1}
+		}
+	}
+	fit := func() { // a head whose placeholders were cut at the right edge
+		for x := range line {
+			if line[x].w > 1 && x+line[x].w > width {
+				for i := x; i < width; i++ {
+					line[i] = lcell{" ", 1}
+				}
+			}
+		}
+	}
+	blanks := func(n int) []lcell {
+		out := make([]lcell, n)
+		for i := range out {
+			out[i] = lcell{" ", 1}
+		}
+		return out
+	}
+	put := func(c lcell) {
+		if cur+c.w > width {
+			return
+		}
+		if irm { // an insert at a wide cell's trailing column cuts the cell; at its head it shifts the cell intact
+			if line[cur].w == 0 && line[cur].s == "" {
+				blankWide(cur)
+			}
+			line = append(line[:cur], append(make([]lcell, c.w), line[cur:]...)...)[:width]
+			fit()
+		} else if c.w == 1 && c.s == " " && line[cur].w == 0 && line[cur].s == "" && cur > 0 && line[cur-1].w > 1 {
+			blanked = true // a space over a wide cell's trailing column (cellbuf/14)
+		}
+		blankWide(cur)
+		line[cur] = c
+		for i := 1; i < c.w; i++ {
+			line[cur+i] = lcell{}
+		}
+		cur += c.w
+		last = c
+	}
+	p := ansi.GetParser()
+	defer ansi.PutParser(p)
+	var state byte
+	for len(out) > 0 {
+		seq, w, n, ns := ansi.DecodeSequence(out, state, p)
+		switch {
+		case w > 0:
+			put(lcell{seq, w})
+		case seq == "\r":
+			cur = 0
+		case seq == "\b":
+			cur = max(cur-1, 0)
+		case seq == "\t":
+			cur = min((cur/8+1)*8, width-1)
+		case ansi.HasCsiPrefix(seq):
+			cmd := ansi.Cmd(p.Command())
+			params := p.Params()
+			p1, _, _ := params.Param(0, 1)
+			p2, _, _ := params.Param(1, 1)
+			p0, _, _ := params.Param(0, 0)
+			switch cmd.Final() {
+			case 'h':
+				irm = irm || (cmd.Prefix() == 0 && p1 == 4)
+			case 'l':
+				irm = irm && !(cmd.Prefix() == 0 && p1 == 4)
+			case 'D':
+				cur = max(cur-max(p1, 1), 0)
+			case 'C':
+				cur = min(cur+max(p1, 1), width-1)
+			case 'G', '`':
+				cur = max(0, min(p1-1, width-1))
+			case 'H', 'f':
+				cur = max(0, min(p2-1, width-1))
+			case 'K', 'J':
+				from, to := cur, width
+				if cmd.Final() == 'K' && p0 == 1 {
+					from, to = 0, cur+1
+				} else if cmd.Final() == 'K' && p0 == 2 {
+					from = 0
+				}
+				blankWide(from)
+				blankWide(to - 1)
+				copy(line[from:to], blanks(to-from))
+			case 'X':
+				k := min(max(p1, 1), width-cur)
+				blankWide(cur)
+				blankWide(cur + k - 1)
+				copy(line[cur:cur+k], blanks(k))
+			case 'P':
+				k := min(max(p1, 1), width-cur)
+				blankWide(cur)
+				blankWide(cur + k - 1)
+				line = append(line[:cur], append(line[cur+k:], blanks(k)...)...)
+			case '@':
+				k := min(max(p1, 1), width-cur)
+				if line[cur].w == 0 && line[cur].s == "" {
+					blankWide(cur)
+				}
+				line = append(line[:cur], append(blanks(k), line[cur:]...)...)[:width]
+				fit()
+			case 'b':
+				for range max(p1, 1) {
+					put(last)
+				}
+			}
+		}
+		out = out[n:]
+		state = ns
+	}
+	return line, blanked
+}
+
+// lineCheck is the check value of a one-row frame on the line model: "ok" when the model's
+// cells equal the screen's new buffer by content (a placeholder "", a blank " ") and the
+// current buffer equals the new one, else the first difference.
+func lineCheck(s *Screen, line []lcell, chunk string) string {
+	var sb strings.Builder
+	for _, c := range line {
+		sb.WriteString(c.s)
+	}
+	for x := 0; x < s.Width(); x++ {
+		c := s.newbuf.Cell(x, 0)
+		want := c.String()
+		if c.Empty() {
+			want = ""
+		}
+		if line[x].s != want {
+			return fmt.Sprintf("(%d,0) screen %q, the line model %q\nscreen: %q\nline:   %q\nchunk %q", x, want, line[x].s, s.newbuf.String(), sb.String(), chunk)
+		}
+	}
+	for x := 0; x < s.Width(); x++ {
+		if !cellEqual(s.curbuf.Cell(x, 0), s.newbuf.Cell(x, 0)) {
+			return fmt.Sprintf("after the render curbuf (%d,0) = %s, newbuf %s\nchunk %q", x, cellString(s.curbuf.Cell(x, 0)), cellString(s.newbuf.Cell(x, 0)), chunk)
+		}
+	}
+	return "ok"
+}
+
+// lineShapeOf is the shape of a frame for the line judge: the orphan, the hang and the erase
+// from a placeholder (cellbuf/19, a content-level decision the line model shows too) as for
+// the emulator, then a space the frame prints over a wide cell's trailing column (cellbuf/14,
+// read by the line model from the replica's chunk: the past-the-shape region of the /18
+// property on xterm reaches it through the overwrite move after putRange's insert), then
+// the stepped-back insert of cellbuf/18 (the style-level shape of 11 is not the line
+// model's: it tracks no style, and the frames here carry none).
+func lineShapeOf(p screenPrediction, blanked, differs bool) string {
+	switch {
+	case p.shape == hzKnownID(kWideOverHeadOrphans) || p.shape == hzKnownID(kRenderHangs) || p.shape == hzKnownID(kShortenedLineLosesWide):
+		return p.shape
+	case p.hang:
+		return ""
+	case blanked:
+		return hzKnownID(kOverwriteBlanksWide)
+	case p.insertDup && differs:
+		return hzKnownID(kInsertDuplicatesWide)
+	case p.insertDup:
+		hzTally("absorbed " + hzKnownID(kInsertDuplicatesWide)) // the duplicate pushed off the right edge
+	}
+	return ""
+}
+
+// lineDiffers is whether the line model's row differs from the screen's new buffer by
+// content (lineCheck's first half): the line judge's forecast of a frame's verdict.
+func lineDiffers(s *Screen, line []lcell) bool {
+	for x := 0; x < s.Width(); x++ {
+		c := s.newbuf.Cell(x, 0)
+		want := c.String()
+		if c.Empty() {
+			want = ""
+		}
+		if line[x].s != want {
+			return true
+		}
+	}
+	return false
+}
+
+// blankLine is the line model's starting row: w blanks.
+func blankLine(w int) []lcell {
+	line := make([]lcell, w)
+	for i := range line {
+		line[i] = lcell{" ", 1}
+	}
+	return line
+}
+
+// lineCursor is the screen's cursor column before a frame as the line model starts from it
+// (the width when the screen is at the pending-wrap position).
+func lineCursor(s *Screen) int {
+	if s.atPhantom {
+		return s.Width()
+	}
+	return s.cur.X
+}
+
+// lineShape is the shape of a case by the line judge's classifier (the narrow /18 property's
+// filter): the frames are rendered on a private screen and the line model follows them, the
+// first frame with a shape names it.
+func lineShape(c screenCase) (shape string) {
+	line := blankLine(c.w)
+	screenPlay(c, func(i int, s *Screen, out *bytes.Buffer, p screenPrediction) bool {
+		cur := lineCursor(s)
+		final, blanked := hzLineReplay(line, cur, p.chunk)
+		if shape = lineShapeOf(p, blanked, lineDiffers(s, final)); shape != "" || p.hang {
+			return false
+		}
+		s.Render()
+		_ = s.Flush()
+		line, _ = hzLineReplay(line, cur, out.String())
+		out.Reset()
+		return true
+	})
+	return shape
+}
+
+// judgeLine is the judge of a one-row case on the line model (the /18 narrow property):
+// screenActual's course with hzLineReplay as the terminal and lineCheck as the comparison.
+func judgeLine(j *hzCaseJudge, c screenCase) {
+	got := checks{}
+	line := blankLine(c.w)
+	complete := true
+	s, _ := screenPlay(c, func(i int, s *Screen, out *bytes.Buffer, p screenPrediction) bool {
+		name := "frame" + strconv.Itoa(i)
+		cur := lineCursor(s)
+		final, blanked := hzLineReplay(line, cur, p.chunk)
+		shape := lineShapeOf(p, blanked, lineDiffers(s, final))
+		if shape != "" {
+			hzTally("predicted " + shape)
+			if j.Dropped(shape) {
+				complete = false
+				return false
+			}
+		}
+		if p.hang {
+			got[name] = "hang (predicted; the frame is not rendered)"
+			complete = false
+			return false
+		}
+		s.Render()
+		_ = s.Flush()
+		chunk := out.String()
+		out.Reset()
+		line, _ = hzLineReplay(line, cur, chunk)
+		v := lineCheck(s, line, chunk)
+		got[name] = v
+		switch {
+		case shape != "" && v == "ok":
+			hzTally("predicted and passed " + shape)
+			j.col.note("predicted and passed", "frame %d (%s) for\n%#v", i, shape, c)
+		case shape != "":
+			hzTally("predicted and failed " + shape)
+		case v != "ok":
+			hzTally("failed unpredicted")
+			j.col.note("failed unpredicted", "frame %d: %s for\n%#v", i, v, c)
+		}
+		if v != "ok" {
+			complete = false
+			return false
+		}
+		return true
+	})
+	if complete {
+		got["close"] = "ok"
+		if err := s.Close(); err != nil {
+			got["close"] = "Close: " + err.Error()
+		}
+		hzTally("last frame reached")
+	}
+	verdict(j, c, got, restrict(screenExpected(c, hzKnownNone), got), "", screenExpected)
+}
+
+// insertBeforeWideCases: a one-row screen of width 7 to 16 on vt100 (no ICH: inserts go
+// through IRM) showing k (2 or more) wide cells, then a narrow cell (a space or an ASCII
+// atom) followed by the same wide cells with one of them replaced by another, with two
+// columns to spare at the right edge (a duplicate pushed off the edge leaves no trace; the
+// classifier counts such a draw "absorbed cellbuf/18" and rejects it); under HEGEL_NO_KNOWN=1
+// the TERM is xterm (ICH), or the cells are narrow.
+var insertBeforeWideCases = regionBy("cellbuf/18", lineShape, hegel.FlatMap(rangeHalves(7, 16), func(w int) hegel.Generator[screenCase] {
+	return hegel.Composite(func(tc hegel.TestCase) screenCase {
+		variant := hegel.Draw(tc, hzShaped(hegel.Just(0), evenHalves(1, 2))) // past the shape: 1 xterm, 2 narrow cells
+		term := "vt100"
+		if variant == 1 {
+			term = "xterm"
+		}
+		opts := hegel.Draw(tc, screenOptions)
+		atoms, cw := hzWideAtoms, 2
+		if variant == 2 {
+			atoms, cw = hzASCIIAtoms, 1
+		}
+		k := hegel.Draw(tc, rangeHalves(2, (w-3)/cw))
+		old := hegel.Draw(tc, hzCounted(evenHalves(atoms...), k, k))
+		i := hegel.Draw(tc, rangeHalves(0, k-1))
+		repl := hegel.Draw(tc, evenHalves(atoms...))
+		if repl == old[i] {
+			repl = atoms[(slices.Index(atoms, repl)+1)%len(atoms)]
+		}
+		prefix := hegel.Draw(tc, evenHalves(append([]string{" "}, hzASCIIAtoms...)...))
+		next := slices.Clone(old)
+		next[i] = repl
+		return screenCaseOf(w, 1, term, opts, hegel.Draw(tc, dieCoin(50)),
+			frame{kind: "SetContent", text: strings.Join(old, "")},
+			frame{kind: "SetContent", text: prefix + strings.Join(next, "")})
+	})
+}))
