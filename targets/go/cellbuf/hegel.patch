index 0000000..eb2c295
--- /dev/null
+++ b/cellbuf/hegel_buffer_test.go
@@ -0,0 +1,1185 @@
+package cellbuf
+
+// The Buffer and Render families: the grid model with the terminal's wide-cell semantics
+// (the README's oracle) taking the switch set, the replicas of Line.set (buffer.go 134), the
+// four shift operations (335, 366, 412, 448), Resize (266) and printString (writer.go 249)
+// and RenderLine (83) under the switches of cellbuf/1, 2, 3, 9 and 10; the atoms and the
+// generators of graphemes and cells every family shares; the Buffer and Render case records,
+// their generators, classifiers and properties.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the atoms
+
+// hzNarrowAtoms are the one-column graphemes (the old narrowGraphemes byte for byte: ASCII,
+// precomposed e-acute and n-tilde, a Thai cluster with a non-ASCII base); hzClusterAtoms the
+// two clusters with an ASCII base (e + U+0301, n + U+0303), which x/ansi's decoder splits
+// (x-ansi/5) and printString then misreads (cellbuf/9); hzWideAtoms the two-column ones (the
+// old wideGraphemes byte for byte).
+var (
+	hzNarrowAtoms  = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#", "\u00e9", "\u00f1", "\u0e01\u0e49"}
+	hzClusterAtoms = []string{"e\u0301", "n\u0303"}
+	hzWideAtoms    = []string{"\u4e16", "\u754c", "\u4e2d", "\u6587", "\u65e5", "\u672c", "\U0001f603", "\U0001fae7", "\uff21"}
+)
+
+// graphemesAt is a grapheme: a wide atom 30 percent of the time, else a narrow atom or an
+// ASCII-based cluster, each at the share of one list entry (13 atoms and, at the weight
+// cluster, the two clusters: 2 of 15 by default, none under HEGEL_NO_KNOWN=1 where the
+// family draws the shape of cellbuf/9).
+func graphemesAt(cluster int) hegel.Generator[string] {
+	return dieChoice(
+		hzW(68, dieChoice(
+			hzW(13, evenHalves(hzNarrowAtoms...)),       // a narrow atom nominal 59 (13 of 15 of 68): realises 60.0 in the Buffer cells, 63.7 in the Render cells
+			hzW(cluster, evenHalves(hzClusterAtoms...)), // a cluster nominal 9.1: realises 9.0 in the Buffer cells, 8.1 in the Render cells
+		)),
+		hzW(32, evenHalves(hzWideAtoms...)), // a wide atom nominal 32 (for a realised 30): realises 31.0 in the Buffer cells, 28.2 in the Render cells
+	)
+}
+
+var (
+	graphemes         = graphemesAt(2)
+	renderGraphemes   = graphemesAt(hzUnless(hzNoKnown, 2))
+	hzNarrowGraphemes = dieChoice(hzW(13, evenHalves(hzNarrowAtoms...)), hzW(2, evenHalves(hzClusterAtoms...)))
+)
+
+// hzGraphemeCell is the documented grapheme cell: the first grapheme cluster of s with its
+// width from uniseg (NewGraphemeCell's rule, written out so that the generators call no
+// cellbuf code).
+func hzGraphemeCell(s string) *Cell {
+	g, _, w, _ := uniseg.FirstGraphemeClusterInString(s, -1)
+	c := &Cell{Width: w}
+	for i, r := range g {
+		if i == 0 {
+			c.Rune = r
+		} else {
+			c.Comb = append(c.Comb, r)
+		}
+	}
+	return c
+}
+
+// graphemeCellsOf is a grapheme cell over g with a style and a link; a fresh *Cell per draw.
+func graphemeCellsOf(g hegel.Generator[string]) hegel.Generator[*Cell] {
+	return hegel.Map(hzTuple[any](
+		hegel.Map(g, func(s string) any { return s }),
+		hegel.Map(styles, func(s Style) any { return s }),
+		hegel.Map(links, func(l Link) any { return l }),
+	), func(v []any) *Cell {
+		c := hzGraphemeCell(v[0].(string))
+		c.Style = v[1].(Style)
+		c.Link = v[2].(Link)
+		return c
+	})
+}
+
+// cellsOf is a cell over the graphemes g: nil (a blank) 25 percent of the time, else a
+// space cell one time in ten or a grapheme cell, with a style and a link (the old genCell).
+func cellsOf(g hegel.Generator[string]) hegel.Generator[*Cell] {
+	return dieChoice(
+		hzW(25, hegel.Just[*Cell](nil)), // nil nominal 25: realises 23.6 in the Buffer steps
+		hzW(75, graphemeCellsOf(dieChoice(
+			hzW(90, g),               // a grapheme nominal 90: realises 90.5
+			hzW(10, hegel.Just(" ")), // a space nominal 10: realises 9.5
+		))),
+	)
+}
+
+var (
+	cells       = cellsOf(graphemes)
+	narrowCells = cellsOf(hzNarrowGraphemes)
+	renderCells = cellsOf(renderGraphemes)
+)
+
+// hzCellText prints a cell as the old messages did.
+func hzCellText(c *Cell) string {
+	if c == nil {
+		return "nil"
+	}
+	return fmt.Sprintf("{%q w%d %s %s}", c.String(), c.Width, hzStyleText(c.Style), hzLinkText(c.Link))
+}
+
+func hzLinkText(l Link) string {
+	if l.URL == "" && l.Params == "" {
+		return "-"
+	}
+	return l.URL + ";" + l.Params
+}
+
+// --------------------------------------------------------------------------- the grid model
+
+// mcell is the model's cell: a placeholder has w == 0 and s == "" (a zero-width cell with
+// content, printString's stray mark of cellbuf/9, has w == 0 and s != "").
+type mcell struct {
+	s  string
+	w  int
+	st Style
+	ln Link
+}
+
+var mblank = mcell{s: " ", w: 1}
+
+func blankOf(c mcell) mcell { return mcell{s: " ", w: 1, st: c.st, ln: c.ln} }
+
+func cellOf(c *Cell) mcell {
+	if c == nil {
+		return mblank
+	}
+	return mcell{s: c.String(), w: c.Width, st: c.Style, ln: c.Link}
+}
+
+func (c mcell) text() string {
+	return "{" + strconv.Quote(c.s) + " w" + strconv.Itoa(c.w) + " " + hzStyleText(c.st) + " " + hzLinkText(c.ln) + "}"
+}
+
+func (c mcell) isBlankCell() bool {
+	return c.s == " " && c.w == 1 && hzStyleEmpty(c.st) && c.ln.URL == "" && c.ln.Params == ""
+}
+
+type mgrid struct {
+	w, h int
+	g    [][]mcell
+}
+
+func newGrid(w, h int) *mgrid {
+	m := &mgrid{}
+	m.resize(w, h, hzKnownNone)
+	return m
+}
+
+func (m *mgrid) clone() *mgrid {
+	c := &mgrid{w: m.w, h: m.h, g: make([][]mcell, len(m.g))}
+	for y := range m.g {
+		c.g[y] = append([]mcell(nil), m.g[y]...)
+	}
+	return c
+}
+
+// gridOf reads a library buffer into the model's form (content, width, style, link per
+// cell; a nil is a blank).
+func gridOf(b *Buffer) *mgrid {
+	m := &mgrid{w: b.Width(), h: b.Height(), g: make([][]mcell, b.Height())}
+	for y := range b.Lines {
+		m.g[y] = make([]mcell, len(b.Lines[y]))
+		for x, c := range b.Lines[y] {
+			m.g[y][x] = cellOf(c)
+		}
+	}
+	return m
+}
+
+// resize is Buffer.Resize (buffer.go 266): the width first, then the height; a width or
+// height of zero empties the buffer. The documented rule blanks a wide cell cut by a
+// narrower width (the README: a wide cell that does not fit becomes blanks, style kept); with
+// k3 the replica keeps the cut head in the last column as the truncated slice does.
+func (m *mgrid) resize(w, h int, k known) {
+	if w == 0 || h == 0 {
+		m.w, m.h, m.g = 0, 0, nil
+		return
+	}
+	for y := range m.g {
+		if w > m.w {
+			for x := m.w; x < w; x++ {
+				m.g[y] = append(m.g[y], mblank)
+			}
+		} else {
+			m.g[y] = m.g[y][:w]
+			if !k[kResizeCutsWideCells] {
+				for x := max(w-maxCellWidth, 0); x < w; x++ {
+					if c := m.g[y][x]; c.w > 1 && x+c.w > w {
+						for j := x; j < w; j++ {
+							m.g[y][j] = blankOf(c)
+						}
+					}
+				}
+			}
+		}
+	}
+	for len(m.g) < h {
+		row := make([]mcell, w)
+		for x := range row {
+			row[x] = mblank
+		}
+		m.g = append(m.g, row)
+	}
+	m.g = m.g[:h]
+	m.w, m.h = w, h
+}
+
+// splitWide blanks the wide cell covering column x, keeping its style and link.
+func (m *mgrid) splitWide(x, y int) {
+	if x < 0 || x >= m.w {
+		return
+	}
+	c := m.g[y][x]
+	head := -1
+	if c.w > 1 {
+		head = x
+	} else if c.w == 0 {
+		for j := 1; j < maxCellWidth && x-j >= 0; j++ {
+			if wc := m.g[y][x-j]; wc.w > 1 && j < wc.w {
+				head = x - j
+				break
+			}
+		}
+	}
+	if head < 0 {
+		return
+	}
+	hc := m.g[y][head]
+	for j := 0; j < hc.w && head+j < m.w; j++ {
+		m.g[y][head+j] = blankOf(hc)
+	}
+}
+
+// lineSet is Line.set (buffer.go 134) over the model's row y: the wide cell covering the
+// target column is split (a head there, or a placeholder whose head is up to three columns
+// back), a cell too wide for the line becomes blanks in its style, else the cell is written
+// with placeholders after it. The documented rule also splits the wide cells whose heads the
+// placeholders cover (the README: a cell written over any column of a wide cell blanks that
+// cell); with k2 the replica writes the placeholders over them as the library does (buffer.go
+// 177), leaving their own placeholders orphaned.
+func (m *mgrid) lineSet(x, y int, c mcell, k known) bool {
+	width := m.w
+	if x < 0 || x >= width {
+		return false
+	}
+	prev := m.g[y][x]
+	if prev.w > 1 {
+		for j := 0; j < prev.w && x+j < width; j++ {
+			m.g[y][x+j] = blankOf(prev)
+		}
+	} else if prev.w == 0 {
+		for j := 1; j < maxCellWidth && x-j >= 0; j++ {
+			if wide := m.g[y][x-j]; wide.w > 1 && j < wide.w {
+				for i := 0; i < wide.w && x-j+i < width; i++ {
+					m.g[y][x-j+i] = blankOf(wide)
+				}
+				break
+			}
+		}
+	}
+	if !k[kWideOverHeadOrphans] {
+		for j := 1; j < c.w && x+j < width; j++ {
+			m.splitWide(x+j, y)
+		}
+	}
+	if x+c.w > width {
+		for i := 0; i < c.w && x+i < width; i++ {
+			m.g[y][x+i] = blankOf(c)
+		}
+		return true
+	}
+	m.g[y][x] = c
+	for j := 1; j < c.w && x+j < width; j++ {
+		m.g[y][x+j] = mcell{}
+	}
+	return true
+}
+
+// setCell is Buffer.SetCell (buffer.go 234): false outside the buffer.
+func (m *mgrid) setCell(x, y int, c *Cell, k known) bool {
+	if y < 0 || y >= m.h {
+		return false
+	}
+	return m.lineSet(x, y, cellOf(c), k)
+}
+
+// fillRect is Buffer.FillRect (buffer.go 293): every cell of the rectangle set, stepping by
+// the cell's width, the cells outside the buffer ignored (setCell's bounds checks clip).
+func (m *mgrid) fillRect(c *Cell, r Rectangle, k known) {
+	cw := 1
+	if c != nil && c.Width > 1 {
+		cw = c.Width
+	}
+	for y := r.Min.Y; y < r.Max.Y; y++ {
+		for x := r.Min.X; x < r.Max.X; x += cw {
+			m.setCell(x, y, c, k)
+		}
+	}
+}
+
+func (m *mgrid) fillLine(y int, x0, x1 int, c *Cell, k known) {
+	for x := x0; x < x1; x++ {
+		m.setCell(x, y, c, k)
+	}
+}
+
+// splitStraddlers blanks, in row y, a wide cell cut by the column edge at x (its head before
+// x and its extent past it): the documented rule of a shift whose rectangle cuts a wide cell
+// (the bugs.toml note of cellbuf/1: a wide cell is moved as a unit and blanked only when it
+// straddles the edge of the affected rectangle).
+func (m *mgrid) splitStraddlers(y, x int) {
+	if y < 0 || y >= m.h || x <= 0 || x >= m.w {
+		return
+	}
+	if c := m.g[y][x]; c.w == 0 && c.s == "" {
+		m.splitWide(x, y)
+	}
+}
+
+// shiftPanics is whether the library's loop of the shift op would index outside the buffer
+// (cellbuf/10, k10): the four operations read b.Lines[row][col] for every coordinate of the
+// unclipped rectangle they move (buffer.go 349, 382, 428, 466); the writes go through
+// setCell, which bounds-checks, and a rectangle that only overflows where no read lands
+// (past the bottom by at most n rows for InsertLine, a negative origin for the cell shifts)
+// does not panic.
+func (m *mgrid) shiftPanics(s bufferStep) bool {
+	r, n := s.rect, s.n
+	w, h := m.w, m.h
+	inRow := func(row int) bool { return row >= 0 && row < h }
+	inCol := func(col int) bool { return col >= 0 && col < w }
+	switch s.op {
+	case "InsertLineRect":
+		if n <= 0 || s.y < r.Min.Y || s.y >= r.Max.Y || s.y >= h {
+			return false
+		}
+		n = min(n, r.Max.Y-s.y)
+		for i := r.Max.Y - 1; i >= s.y+n; i-- {
+			for x := r.Min.X; x < r.Max.X; x++ {
+				if !inRow(i-n) || !inCol(x) {
+					return true
+				}
+			}
+		}
+	case "DeleteLineRect":
+		if n <= 0 || s.y < r.Min.Y || s.y >= r.Max.Y || s.y >= h {
+			return false
+		}
+		n = min(n, r.Max.Y-s.y)
+		for dst := s.y; dst < r.Max.Y-n; dst++ {
+			for x := r.Min.X; x < r.Max.X; x++ {
+				if !inRow(dst+n) || !inCol(x) {
+					return true
+				}
+			}
+		}
+	case "InsertCellRect":
+		if n <= 0 || s.y < r.Min.Y || s.y >= r.Max.Y || s.y >= h || s.x < r.Min.X || s.x >= r.Max.X || s.x >= w {
+			return false
+		}
+		n = min(n, r.Max.X-s.x)
+		for i := r.Max.X - 1; i >= s.x+n && i-n >= r.Min.X; i-- {
+			if !inCol(i - n) {
+				return true
+			}
+		}
+	case "DeleteCellRect":
+		if n <= 0 || s.y < r.Min.Y || s.y >= r.Max.Y || s.y >= h || s.x < r.Min.X || s.x >= r.Max.X || s.x >= w {
+			return false
+		}
+		n = min(n, r.Max.X-s.x)
+		for i := s.x; i < r.Max.X-n; i++ {
+			if !inCol(i + n) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// insertLine is InsertLineRect (buffer.go 335) over the clipped rectangle: the rows from y
+// on move down by n within the rectangle's columns, the n rows at y are filled. The
+// documented move copies each row's cells as units, a wide cell cut by the rectangle's
+// column edges blanked first; with k1 the replica moves the cells one at a time, left to
+// right, through Line.set (buffer.go 349), which blanks every wide cell it moves (the head is
+// written with a fresh placeholder, then the source placeholder is written over it and
+// Line.set's placeholder rule blanks the head).
+func (m *mgrid) insertLine(y, n int, c *Cell, r Rectangle, k known) {
+	if n <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h {
+		return
+	}
+	n = min(n, r.Max.Y-y)
+	if !k[kShiftsBlankWideCells] {
+		for i := r.Min.Y; i < r.Max.Y; i++ {
+			m.splitStraddlers(i, r.Min.X)
+			m.splitStraddlers(i, r.Max.X)
+		}
+	}
+	for i := r.Max.Y - 1; i >= y+n; i-- {
+		for x := r.Min.X; x < r.Max.X; x++ {
+			if k[kShiftsBlankWideCells] {
+				m.lineSet(x, i, m.g[i-n][x], k)
+			} else {
+				m.g[i][x] = m.g[i-n][x]
+			}
+		}
+	}
+	if !k[kShiftsBlankWideCells] {
+		m.vacate(y, y+n, r.Min.X, r.Max.X)
+	}
+	for i := y; i < y+n; i++ {
+		m.fillLine(i, r.Min.X, r.Max.X, c, k)
+	}
+}
+
+// vacate blanks the cells a documented move has left behind (the copies of the moved cells
+// still there would otherwise be taken for live wide cells by the fill's lineSet).
+func (m *mgrid) vacate(y0, y1, x0, x1 int) {
+	for y := y0; y < y1 && y < m.h; y++ {
+		for x := x0; x < x1 && x < m.w; x++ {
+			if y >= 0 && x >= 0 {
+				m.g[y][x] = mblank
+			}
+		}
+	}
+}
+
+// deleteLine is DeleteLineRect (buffer.go 366): the rows after y move up by n, the last n
+// rows of the rectangle are filled; with k1 cell by cell through Line.set (buffer.go 382).
+func (m *mgrid) deleteLine(y, n int, c *Cell, r Rectangle, k known) {
+	if n <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h {
+		return
+	}
+	n = min(n, r.Max.Y-y)
+	if !k[kShiftsBlankWideCells] {
+		for i := r.Min.Y; i < r.Max.Y; i++ {
+			m.splitStraddlers(i, r.Min.X)
+			m.splitStraddlers(i, r.Max.X)
+		}
+	}
+	for dst := y; dst < r.Max.Y-n; dst++ {
+		for x := r.Min.X; x < r.Max.X; x++ {
+			if k[kShiftsBlankWideCells] {
+				m.lineSet(x, dst, m.g[dst+n][x], k)
+			} else {
+				m.g[dst][x] = m.g[dst+n][x]
+			}
+		}
+	}
+	if !k[kShiftsBlankWideCells] {
+		m.vacate(r.Max.Y-n, r.Max.Y, r.Min.X, r.Max.X)
+	}
+	for i := r.Max.Y - n; i < r.Max.Y; i++ {
+		m.fillLine(i, r.Min.X, r.Max.X, c, k)
+	}
+}
+
+// insertCell is InsertCellRect (buffer.go 412): the cells from x on move right by n within
+// the rectangle, the n cells at x are filled. The documented move blanks a wide cell cut by
+// the rectangle's edges or by x first and one pushed across the right edge after; the
+// library copies right to left through Line.set (buffer.go 428), which writes each head after
+// its placeholder and so keeps the moved wide cells (InsertCellRect is spared by cellbuf/1's
+// note); with k1 the replica is that loop all the same, so that a case where it differs from
+// the documented move (a wide cell cut by the rectangle) is named.
+func (m *mgrid) insertCell(x, y, n int, c *Cell, r Rectangle, k known) {
+	if n <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h || x < r.Min.X || x >= r.Max.X || x >= m.w {
+		return
+	}
+	n = min(n, r.Max.X-x)
+	if !k[kShiftsBlankWideCells] {
+		m.splitStraddlers(y, r.Min.X)
+		m.splitStraddlers(y, r.Max.X)
+		m.splitStraddlers(y, x)
+	}
+	for i := r.Max.X - 1; i >= x+n && i-n >= r.Min.X; i-- {
+		if k[kShiftsBlankWideCells] {
+			m.lineSet(i, y, m.g[y][i-n], k)
+		} else {
+			m.g[y][i] = m.g[y][i-n]
+		}
+	}
+	if !k[kShiftsBlankWideCells] {
+		for i := x + n; i < r.Max.X && i < m.w; i++ {
+			if cc := m.g[y][i]; cc.w > 1 && i+cc.w > r.Max.X {
+				for j := i; j < r.Max.X && j < m.w; j++ {
+					m.g[y][j] = blankOf(cc)
+				}
+			}
+		}
+	}
+	if !k[kShiftsBlankWideCells] {
+		m.vacate(y, y+1, x, min(x+n, r.Max.X))
+	}
+	for i := x; i < x+n && i < r.Max.X; i++ {
+		m.setCell(i, y, c, k)
+	}
+}
+
+// deleteCell is DeleteCellRect (buffer.go 448): the cells after x move left by n within the
+// rectangle, the last n cells of the rectangle are filled; with k1 cell by cell, left to
+// right, through Line.set (buffer.go 466), the source read live as the library reads it.
+func (m *mgrid) deleteCell(x, y, n int, c *Cell, r Rectangle, k known) {
+	if n <= 0 || y < r.Min.Y || y >= r.Max.Y || y >= m.h || x < r.Min.X || x >= r.Max.X || x >= m.w {
+		return
+	}
+	n = min(n, r.Max.X-x)
+	if !k[kShiftsBlankWideCells] {
+		m.splitStraddlers(y, r.Min.X)
+		m.splitStraddlers(y, r.Max.X)
+		m.splitStraddlers(y, x)
+	}
+	for i := x; i < r.Max.X-n; i++ {
+		if k[kShiftsBlankWideCells] {
+			m.lineSet(i, y, m.g[y][i+n], k)
+		} else {
+			m.g[y][i] = m.g[y][i+n]
+		}
+	}
+	if !k[kShiftsBlankWideCells] {
+		m.vacate(y, y+1, r.Max.X-n, r.Max.X)
+	}
+	for i := r.Max.X - n; i < r.Max.X; i++ {
+		m.setCell(i, y, c, k)
+	}
+}
+
+// String is Buffer.String: the lines' contents (placeholders skipped), trailing spaces
+// trimmed, joined by CRLF.
+func (m *mgrid) String() string {
+	var lines []string
+	for y := 0; y < m.h; y++ {
+		lines = append(lines, m.lineString(y))
+	}
+	return strings.Join(lines, "\r\n")
+}
+
+func (m *mgrid) lineString(y int) string {
+	var sb strings.Builder
+	for _, c := range m.g[y] {
+		sb.WriteString(c.s)
+	}
+	return strings.TrimRight(sb.String(), " ")
+}
+
+// dump is the check value of a grid: every cell with its content, width, style and link,
+// then String() and Bounds().
+func (m *mgrid) dump() string {
+	var sb strings.Builder
+	for y := 0; y < m.h; y++ {
+		sb.WriteString("\n  ")
+		sb.WriteString(strconv.Itoa(y))
+		sb.WriteByte(':')
+		for _, c := range m.g[y] {
+			sb.WriteByte(' ')
+			sb.WriteString(c.text())
+		}
+	}
+	sb.WriteString("\n  String ")
+	sb.WriteString(strconv.Quote(m.String()))
+	sb.WriteString(" Bounds ")
+	sb.WriteString(Rect(0, 0, m.w, m.h).String())
+	return sb.String()
+}
+
+// structure is the structural invariant of a grid: placeholders belong to a head, heads fit
+// ("ok", or the first violation).
+func (m *mgrid) structure() string {
+	for y := 0; y < m.h; y++ {
+		covered := 0
+		for x, c := range m.g[y] {
+			if covered > 0 {
+				covered--
+				if c.w != 0 || c.s != "" {
+					return fmt.Sprintf("wide head before (%d,%d) lacks its placeholder", x, y)
+				}
+				continue
+			}
+			if c.w == 0 && c.s == "" {
+				return fmt.Sprintf("orphan placeholder at (%d,%d)", x, y)
+			}
+			if c.w > 1 {
+				if x+c.w > m.w {
+					return fmt.Sprintf("wide head at (%d,%d) does not fit", x, y)
+				}
+				covered = c.w - 1
+			}
+		}
+	}
+	return "ok"
+}
+
+func dumpBuffer(b *Buffer) string {
+	var sb strings.Builder
+	for y, l := range b.Lines {
+		fmt.Fprintf(&sb, "  %d:", y)
+		for _, c := range l {
+			if c == nil {
+				sb.WriteString(" nil")
+			} else {
+				fmt.Fprintf(&sb, " {%q w%d}", c.String(), c.Width)
+			}
+		}
+		sb.WriteByte('\n')
+	}
+	return sb.String()
+}
+
+// hasOrphan reports whether the buffer holds a placeholder not covered by a wide head.
+func hasOrphan(b *Buffer) bool {
+	for _, l := range b.Lines {
+		covered := 0
+		for _, c := range l {
+			if covered > 0 {
+				covered--
+				if c == nil || !c.Empty() {
+					return true
+				}
+				continue
+			}
+			if c == nil {
+				continue
+			}
+			if c.Empty() {
+				return true
+			}
+			if c.Width > 1 {
+				covered = c.Width - 1
+			}
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- the Buffer
+// cases
+
+// bufferStep is one operation of a Buffer case: op is "SetCell", "FillRect", "ClearRect",
+// "InsertLineRect", "DeleteLineRect", "InsertCellRect", "DeleteCellRect" or "Resize"; the
+// fields used are the op's arguments (cell is the drawn cell, cloned before the library gets
+// it); beyond says the rectangle was drawn past the buffer (for the probe and the reader).
+type bufferStep struct {
+	op     string
+	x, y   int
+	cell   *Cell
+	rect   Rectangle
+	n      int
+	nw, nh int
+	beyond bool
+}
+
+func (s bufferStep) String() string {
+	switch s.op {
+	case "SetCell":
+		return fmt.Sprintf("SetCell(%d,%d,%s)", s.x, s.y, hzCellText(s.cell))
+	case "FillRect":
+		return fmt.Sprintf("FillRect(%s, %v)", hzCellText(s.cell), s.rect)
+	case "ClearRect":
+		return fmt.Sprintf("ClearRect(%v)", s.rect)
+	case "InsertLineRect", "DeleteLineRect":
+		return fmt.Sprintf("%s(%d,%d,%s,%v)", s.op, s.y, s.n, hzCellText(s.cell), s.rect)
+	case "InsertCellRect", "DeleteCellRect":
+		return fmt.Sprintf("%s(%d,%d,%d,%s,%v)", s.op, s.x, s.y, s.n, hzCellText(s.cell), s.rect)
+	default:
+		return fmt.Sprintf("Resize(%d,%d)", s.nw, s.nh)
+	}
+}
+
+// bufferCase is a case of the Buffer property: the buffer's size and the steps.
+type bufferCase struct {
+	w, h  int
+	steps []bufferStep
+}
+
+func (c bufferCase) GoString() string {
+	parts := make([]string, len(c.steps))
+	for i, s := range c.steps {
+		parts[i] = s.String()
+	}
+	return fmt.Sprintf("bufferCase{%dx%d; %s}", c.w, c.h, strings.Join(parts, "; "))
+}
+
+// sizeAfter is the buffer's size after a step (the only state the step generator needs).
+func sizeAfter(w, h int, s bufferStep) (int, int) {
+	if s.op == "Resize" {
+		return s.nw, s.nh
+	}
+	return w, h
+}
+
+// insideRects is a rectangle inside a w x h buffer (the old genRect: an origin inside and a
+// size that fits); beyondRects one reaching past it (the shape of cellbuf/10 for the shift
+// operations; FillRect and ClearRect clip it): an inside rectangle extended by one or two
+// columns or rows past the left, top, right or bottom edge; rectsIn the inside one nine
+// times in ten and the other one (never under HEGEL_NO_KNOWN=1).
+func insideRects(w, h int) hegel.Generator[Rectangle] {
+	origins := hegel.Map(hzTuple(rangeHalves(0, max(w-1, 0)), rangeHalves(0, max(h-1, 0))), func(o []int) hegel.Generator[Rectangle] {
+		x0, y0 := o[0], o[1]
+		return hegel.Map(hzTuple(rangeHalves(0, w-x0), rangeHalves(0, h-y0)), func(d []int) Rectangle { return Rect(x0, y0, d[0], d[1]) })
+	})
+	return hegel.FlatMap(origins, func(g hegel.Generator[Rectangle]) hegel.Generator[Rectangle] { return g })
+}
+
+func beyondRects(w, h int) hegel.Generator[Rectangle] {
+	return hegel.FlatMap(insideRects(w, h), func(r Rectangle) hegel.Generator[Rectangle] {
+		return hegel.FlatMap(rangeHalves(1, 2), func(e int) hegel.Generator[Rectangle] {
+			return evenHalves(
+				Rect(r.Min.X-e, r.Min.Y, r.Dx()+e, r.Dy()), // past the left edge
+				Rect(r.Min.X, r.Min.Y-e, r.Dx(), r.Dy()+e), // past the top
+				Rect(r.Min.X, r.Min.Y, r.Dx()+e, r.Dy()),   // past the right
+				Rect(r.Min.X, r.Min.Y, r.Dx(), r.Dy()+e),   // past the bottom
+			)
+		})
+	})
+}
+
+func rectsIn(w, h int) hegel.Generator[Rectangle] {
+	return dieChoice(
+		hzW(80, insideRects(w, h)),                      // inside nominal 80 (for a realised 90): realises 89.5 of the FillRect and ClearRect rectangles
+		hzW(hzUnless(hzNoKnown, 20), beyondRects(w, h)), // beyond nominal 20 (for a realised 10): realises 10.5
+	)
+}
+
+// shiftRects is the rectangle of a shift step: the buffer's bounds 60 percent of the time,
+// else drawn (the old chance(40)).
+func shiftRects(w, h int) hegel.Generator[Rectangle] {
+	return dieChoice(
+		hzW(60, hegel.Just(Rect(0, 0, w, h))), // the bounds nominal 60: realises 59.9 of the shift rectangles
+		hzW(40, rectsIn(w, h)),                // drawn nominal 40: realises 40.1 (36.1 inside, 4.0 beyond)
+	)
+}
+
+func withRect(w, h int, s bufferStep) bufferStep {
+	s.beyond = s.rect.Min.X < 0 || s.rect.Min.Y < 0 || s.rect.Max.X > w || s.rect.Max.Y > h
+	return s
+}
+
+// stepsAt is one step of a w x h buffer: SetCell three times in ten (coordinates -1..w and
+// -1..h, any cell), FillRect, ClearRect, InsertLineRect, DeleteLineRect, InsertCellRect,
+// DeleteCellRect and Resize one time in ten each (the old 0..9 switch); a Resize alone when
+// the buffer is empty (the old op = 9).
+func stepsAt(w, h int) hegel.Generator[bufferStep] {
+	resize := hegel.Map(hzTuple(rangeHalves(0, 10), rangeHalves(0, 5)), func(d []int) bufferStep { return bufferStep{op: "Resize", nw: d[0], nh: d[1]} })
+	if w == 0 || h == 0 {
+		return resize
+	}
+	setCell := hegel.Composite(func(tc hegel.TestCase) bufferStep {
+		return bufferStep{op: "SetCell", x: hegel.Draw(tc, rangeHalves(-1, w)), y: hegel.Draw(tc, rangeHalves(-1, h)), cell: hegel.Draw(tc, cells)}
+	})
+	fill := hegel.Composite(func(tc hegel.TestCase) bufferStep {
+		return withRect(w, h, bufferStep{op: "FillRect", rect: hegel.Draw(tc, rectsIn(w, h)), cell: hegel.Draw(tc, cells)})
+	})
+	clear := hegel.Map(rectsIn(w, h), func(r Rectangle) bufferStep { return withRect(w, h, bufferStep{op: "ClearRect", rect: r}) })
+	lines := func(op string) hegel.Generator[bufferStep] {
+		return hegel.Composite(func(tc hegel.TestCase) bufferStep {
+			r := hegel.Draw(tc, shiftRects(w, h))
+			return withRect(w, h, bufferStep{op: op, rect: r, y: hegel.Draw(tc, rangeHalves(0, h)), n: hegel.Draw(tc, rangeHalves(1, 3)), cell: hegel.Draw(tc, narrowCells)})
+		})
+	}
+	cellsOp := func(op string) hegel.Generator[bufferStep] {
+		return hegel.Composite(func(tc hegel.TestCase) bufferStep {
+			r := hegel.Draw(tc, shiftRects(w, h))
+			return withRect(w, h, bufferStep{op: op, rect: r, x: hegel.Draw(tc, rangeHalves(0, w)), y: hegel.Draw(tc, rangeHalves(0, h-1)), n: hegel.Draw(tc, rangeHalves(1, 3)), cell: hegel.Draw(tc, narrowCells)})
+		})
+	}
+	return dieChoice(
+		hzW(3, setCell),                   // SetCell nominal 30: realises 29.0 of the steps
+		hzW(1, fill),                      // FillRect nominal 10: realises 9.8
+		hzW(1, clear),                     // ClearRect nominal 10: realises 9.6
+		hzW(1, lines("InsertLineRect")),   // nominal 10: realises 9.4
+		hzW(1, lines("DeleteLineRect")),   // nominal 10: realises 9.6
+		hzW(1, cellsOp("InsertCellRect")), // nominal 10: realises 9.4
+		hzW(1, cellsOp("DeleteCellRect")), // nominal 10: realises 10.1
+		hzW(1, resize),                    // Resize nominal 10: realises 13.0 with the forced Resizes of an empty buffer
+	)
+}
+
+// stepsChain is n steps, each drawn for the buffer's size after the ones before it (a
+// FlatMap chain: the size is the only state a step needs, and only Resize changes it).
+func stepsChain(w, h, n int) hegel.Generator[[]bufferStep] {
+	if n == 0 {
+		return hegel.Just[[]bufferStep](nil)
+	}
+	return hegel.FlatMap(stepsAt(w, h), func(s bufferStep) hegel.Generator[[]bufferStep] {
+		w2, h2 := sizeAfter(w, h, s)
+		return hegel.Map(stepsChain(w2, h2, n-1), func(rest []bufferStep) []bufferStep {
+			return append([]bufferStep{s}, rest...)
+		})
+	})
+}
+
+// bufferCases: a 1-10 x 1-5 buffer and 1 to 25 steps. Under HEGEL_NO_KNOWN=1 the steps the
+// classifier names (unshapedSteps) are dropped from the case, so that the rest of it is
+// judged and no case is skipped; the rectangles past the buffer are not drawn then.
+var bufferCases = hegel.Map(hegel.FlatMap(hzTuple(rangeHalves(1, 10), rangeHalves(1, 5), rangeHalves(1, 25)), func(d []int) hegel.Generator[bufferCase] { // w nominal 10 each: realise 8.1 to 11.9; h nominal 20 each: realise 17.6 to 22.5; steps nominal 4 each: realise 2.3 to 5.2
+	return hegel.Map(stepsChain(d[0], d[1], d[2]), func(steps []bufferStep) bufferCase { return bufferCase{w: d[0], h: d[1], steps: steps} })
+}), unshapedSteps)
+
+// --------------------------------------------------------------------------- the Buffer
+// model and classifier
+
+// stepValue applies one step to the model under k and returns the check value: the grid's
+// dump, or the panic value for a shift whose rectangle makes the library index outside the
+// buffer (k10).
+func (m *mgrid) stepValue(s bufferStep, k known) (string, bool) {
+	switch s.op {
+	case "SetCell":
+		ok := m.setCell(s.x, s.y, s.cell, k)
+		return fmt.Sprintf("returned %v%s", ok, m.dump()), false
+	case "FillRect":
+		m.fillRect(s.cell, s.rect, k)
+	case "ClearRect":
+		m.fillRect(nil, s.rect, k)
+	case "Resize":
+		m.resize(s.nw, s.nh, k)
+	default:
+		if k[kShiftRectsPanic] && m.shiftPanics(s) {
+			return "panic (index out of range)", true
+		}
+		r := s.rect.Intersect(Rect(0, 0, m.w, m.h))
+		switch s.op {
+		case "InsertLineRect":
+			m.insertLine(s.y, s.n, s.cell, r, k)
+		case "DeleteLineRect":
+			m.deleteLine(s.y, s.n, s.cell, r, k)
+		case "InsertCellRect":
+			m.insertCell(s.x, s.y, s.n, s.cell, r, k)
+		case "DeleteCellRect":
+			m.deleteCell(s.x, s.y, s.n, s.cell, r, k)
+		}
+	}
+	return m.dump(), false
+}
+
+// bufferExpected states the Buffer property's values under k: "s0" the new buffer's dump,
+// "sN" the dump after step N (the list cut at a step the replica panics on, whose value is
+// the panic), and "structure" at the end.
+func bufferExpected(c bufferCase, k known) checks {
+	want := checks{}
+	m := newGrid(c.w, c.h)
+	want["s0"] = m.dump()
+	for i, s := range c.steps {
+		v, panicked := m.stepValue(s, k)
+		want[fmt.Sprintf("s%d", i+1)] = v
+		if panicked {
+			return want
+		}
+	}
+	want["structure"] = m.structure()
+	return want
+}
+
+// bufferActual runs the steps on a library buffer (each cell cloned before it is handed
+// over, since SetCell may keep the pointer) and reads the same values; a panic ends the
+// steps with its value.
+func bufferActual(c bufferCase) checks {
+	got := checks{}
+	b := NewBuffer(c.w, c.h)
+	got["s0"] = gridOf(b).dump()
+	for i, s := range c.steps {
+		var v string
+		var cell *Cell
+		if s.cell != nil {
+			cell = s.cell.Clone()
+		}
+		r := hzCatch(func() {
+			switch s.op {
+			case "SetCell":
+				v = fmt.Sprintf("returned %v", b.SetCell(s.x, s.y, cell))
+			case "FillRect":
+				b.FillRect(cell, s.rect)
+			case "ClearRect":
+				b.ClearRect(s.rect)
+			case "InsertLineRect":
+				b.InsertLineRect(s.y, s.n, cell, s.rect)
+			case "DeleteLineRect":
+				b.DeleteLineRect(s.y, s.n, cell, s.rect)
+			case "InsertCellRect":
+				b.InsertCellRect(s.x, s.y, s.n, cell, s.rect)
+			case "DeleteCellRect":
+				b.DeleteCellRect(s.x, s.y, s.n, cell, s.rect)
+			default:
+				b.Resize(s.nw, s.nh)
+			}
+		})
+		name := fmt.Sprintf("s%d", i+1)
+		if r != nil {
+			got[name] = hzPanicValue(r)
+			return got
+		}
+		got[name] = v + gridOf(b).dump()
+	}
+	got["structure"] = gridOf(b).structure()
+	return got
+}
+
+// stepCase is one step over the model's state before it: the unit the Buffer family's
+// classifier works on (a shape is a property of the step and the live state, so the case
+// is classified step by step and the first shaped step names it; the generic shapeBy over the
+// whole case would name the lower bug id of a case with two shapes whichever came first).
+type stepCase struct {
+	m *mgrid
+	s bufferStep
+}
+
+func stepExpected(c stepCase, k known) checks {
+	m := c.m.clone()
+	v, _ := m.stepValue(c.s, k)
+	return checks{"s": v}
+}
+
+// bufferShape names the shape of a Buffer case: the first step, in order, that the model
+// under some switch does differently from the documented model in the state the documented
+// model has reached (sufficiency, then necessity, else the hole, counted per step).
+func bufferShape(c bufferCase) string {
+	m := newGrid(c.w, c.h)
+	for _, s := range c.steps {
+		if id := classify(stepCase{m: m, s: s}, stepExpected); id != "" {
+			return id
+		}
+		m.stepValue(s, hzKnownNone)
+	}
+	return ""
+}
+
+func bufferShapeOnly(c bufferCase) string {
+	m := newGrid(c.w, c.h)
+	for _, s := range c.steps {
+		if id := shapeID(stepCase{m: m, s: s}, stepExpected); id != "" {
+			return id
+		}
+		m.stepValue(s, hzKnownNone)
+	}
+	return ""
+}
+
+// unshapedSteps is the case with, under HEGEL_NO_KNOWN=1, every step the classifier names
+// in the state the documented model reaches dropped (counted "dropped cellbuf/N"; the
+// go/bubbles replay-drop), so that the wide property draws every operation on every state and
+// skips nothing; the case itself by default.
+func unshapedSteps(c bufferCase) bufferCase {
+	if !hzNoKnown {
+		return c
+	}
+	m := newGrid(c.w, c.h)
+	var kept []bufferStep
+	for _, s := range c.steps {
+		if id := shapeID(stepCase{m: m, s: s}, stepExpected); id != "" {
+			hzTally("dropped " + id)
+			continue
+		}
+		m.stepValue(s, hzKnownNone)
+		kept = append(kept, s)
+	}
+	return bufferCase{w: c.w, h: c.h, steps: kept}
+}
+
+// judgeBuffer is the judge of the Buffer family (shared with the narrow properties).
+func judgeBuffer(j *hzCaseJudge, c bufferCase) {
+	judgeShaped(j, c, bufferShape(c), bufferExpected, bufferActual)
+}
+
+// TestHegelBufferFollowsTheGridModel: a 1-10 x 1-5 buffer under 1 to 25 random operations
+// (SetCell with coordinates -1..w and -1..h, FillRect, ClearRect, the four shift operations
+// with the bounds or a drawn rectangle, Resize) equals the grid model after every step, cell
+// by cell with String() and Bounds(), and keeps the structural invariant (placeholders belong
+// to a head, heads fit). The shapes of cellbuf/1 (a wide cell in a shifted region), 2 (a wide
+// cell over another's head), 3 (a width cut through a wide cell) and 10 (a shift rectangle
+// past the buffer) are drawn at their natural rates and fail by default naming the bug.
+func TestHegelBufferFollowsTheGridModel(t *testing.T) {
+	judged(t, bufferCases, judgeBuffer)
+}
+
+// --------------------------------------------------------------------------- the Render
+// cases
+
+// renderStep is one SetCell of a Render case.
+type renderStep struct {
+	x, y int
+	cell *Cell
+}
+
+func (s renderStep) String() string {
+	return fmt.Sprintf("SetCell(%d,%d,%s)", s.x, s.y, hzCellText(s.cell))
+}
+
+// renderCase is a case of the Render property: a 1-12 x 1-4 buffer and 0 to 20 SetCells.
+type renderCase struct {
+	w, h  int
+	steps []renderStep
+}
+
+func (c renderCase) GoString() string {
+	parts := make([]string, len(c.steps))
+	for i, s := range c.steps {
+		parts[i] = s.String()
+	}
+	return fmt.Sprintf("renderCase{%dx%d; %s}", c.w, c.h, strings.Join(parts, "; "))
+}
+
+// renderCases: the size, then the SetCells inside it (the ASCII-based clusters, the shape of
+// cellbuf/9, not drawn under HEGEL_NO_KNOWN=1); the shapes of cellbuf/2 (an orphan) and 6 (a
+// lossy diff along a row) are relations of the steps, filtered out by the classifier under
+// HEGEL_NO_KNOWN=1 (withoutShapes) in the property.
+var renderCases = hegel.FlatMap(hzTuple(rangeHalves(1, 12), rangeHalves(1, 4)), func(d []int) hegel.Generator[renderCase] { // w nominal 8.3 each: realise 6.3 to 10.1; h nominal 25 each: realise 23.7 to 26.3
+	w, h := d[0], d[1]
+	step := hegel.Composite(func(tc hegel.TestCase) renderStep {
+		return renderStep{x: hegel.Draw(tc, rangeHalves(0, w-1)), y: hegel.Draw(tc, rangeHalves(0, h-1)), cell: hegel.Draw(tc, renderCells)}
+	})
+	return hegel.Map(countedHalves(step, 0, 20), func(steps []renderStep) renderCase { return renderCase{w: w, h: h, steps: steps} }) // 0 to 20 SetCells nominal 4.8 each: realise 3.6 to 5.8
+})
+
+// --------------------------------------------------------------------------- the Render
+// model
+
+// hzWrite is one piece of a rendered line's text that places cells: a cell's content (or a
+// flushed blank " "), with the terminal's style and link in force when printString reads it.
+type hzWrite struct {
+	s  string
+	w  int
+	st Style
+	ln Link
+}
+
+// renderLine is RenderLine (writer.go 83) over the model's row y: the cells with a width
+// are written in order, a plain blank (equal to BlankCell) pending until a later cell or a
+// style or link change flushes it (trailing blanks are never written), the style changed by
+// DiffSequence against the pen RenderLine believes in, the pen reset before an unstyled cell.
+// The terminal's style is what the emitted codes make of it: the cell's style by the
+// documented rule, the lossy replica's result with k6 (hzDiffEffects applied to the terminal
+// style, the believed pen unchanged, so the loss lasts). Returns the writes and the width
+// RenderLine reports (the widths of every cell up to the last one written).
+func (m *mgrid) renderLine(y int, k known) (writes []hzWrite, width int) {
+	var pen, actual Style
+	var link Link
+	pending := 0
+	flush := func() {
+		for ; pending > 0; pending-- {
+			writes = append(writes, hzWrite{s: " ", w: 1, st: actual, ln: link})
+			width++
+		}
+	}
+	for x := 0; x < m.w; x++ {
+		cell := m.g[y][x]
+		if cell.w <= 0 {
+			continue
+		}
+		if hzStyleEmpty(cell.st) && !hzStyleEmpty(pen) {
+			flush()
+			pen, actual = Style{}, Style{}
+		}
+		if !hzStyleEqual(cell.st, pen) {
+			flush()
+			if k[kDiffDropsSibling] {
+				actual = hzApplyEffects(actual, hzDiffEffects(cell.st, pen, k))
+			} else {
+				actual = cell.st
+			}
+			pen = cell.st
+		}
+		if cell.ln != link && link.URL != "" {
+			flush()
+			link = Link{}
+		}
+		if cell.ln != link {
+			flush()
+			link = cell.ln
+		}
+		if cell.isBlankCell() {
+			pending++
+		} else {
+			flush()
+			writes = append(writes, hzWrite{s: cell.s, w: cell.w, st: actual, ln: link})
+			width += cell.w
+		}
+	}
+	return writes, width
+}
+
+// readBack is SetContent (writer.go 63) of Render's text over a fresh buffer: printString
+// (writer.go 249) decodes the text with x/ansi, whose decoder splits a grapheme cluster with
+// an ASCII base into its base and its marks (x-ansi/5); a mark decoded on its own is a
+// zero-width item that printString appends to the pending cell, so by the library's rule (k9,
+// writer.go 326) it starts the NEXT cell, with the next grapheme as that cell's combining
+// runes, and a mark pending at the end of the text is set as a zero-width cell of its own
+// (writer.go 336); the documented rule keeps the cluster on its cell. "\r\n" between lines
+// resets the column and moves down a row with the pending cell kept; a cell past the right
+// edge is dropped and the column still advances.
+func (m *mgrid) readBack(k known) *mgrid {
+	rb := newGrid(m.w, m.h)
+	var pend mcell
+	x := 0
+	for y := 0; y < m.h; y++ {
+		if y > 0 {
+			x = 0
+		}
+		writes, _ := m.renderLine(y, k)
+		for _, wr := range writes {
+			units := []hzWrite{wr}
+			if rs := []rune(wr.s); k[kMarkAttachesNext] && len(rs) > 1 && rs[0] < 0x80 {
+				units = []hzWrite{{s: string(rs[0]), w: 1, st: wr.st, ln: wr.ln}}
+				for _, r := range rs[1:] {
+					units = append(units, hzWrite{s: string(r), w: 0, st: wr.st, ln: wr.ln})
+				}
+			}
+			for _, u := range units {
+				pend.s += u.s
+				pend.w += u.w
+				pend.st, pend.ln = u.st, u.ln
+				if u.w > 0 {
+					if x < rb.w && y < rb.h {
+						rb.lineSet(x, y, pend, k)
+					}
+					x += u.w
+					pend = mcell{}
+				}
+			}
+		}
+	}
+	if pend.s != "" && x < rb.w {
+		rb.lineSet(x, m.h-1, mcell{s: pend.s, w: 0}, k) // writer.go 336: the cell as reset, no style or link
+	}
+	return rb
+}
+
+// renderExpected states the Render property's values under k: "cells", the buffer SetContent
+// of Render's text gives back (the grid itself by the documented rule); "lineN" the plain text
+// of RenderLine(N) (the line's String()) and "widthN" the width it reports.
+func renderExpected(c renderCase, k known) checks {
+	m := newGrid(c.w, c.h)
+	for _, s := range c.steps {
+		m.setCell(s.x, s.y, s.cell, k)
+	}
+	want := checks{}
+	want["cells"] = m.readBack(k).dump()
+	for y := 0; y < m.h; y++ {
+		_, width := m.renderLine(y, k)
+		want[fmt.Sprintf("line%d", y)] = m.lineString(y)
+		want[fmt.Sprintf("width%d", y)] = fmt.Sprint(width)
+	}
+	return want
+}
+
+func renderActual(c renderCase) checks {
+	b := NewBuffer(c.w, c.h)
+	for _, s := range c.steps {
+		var cell *Cell
+		if s.cell != nil {
+			cell = s.cell.Clone()
+		}
+		b.SetCell(s.x, s.y, cell)
+	}
+	got := checks{}
+	out := Render(b)
+	b2 := NewBuffer(c.w, c.h)
+	SetContent(b2, out)
+	got["cells"] = gridOf(b2).dump()
+	for y := 0; y < c.h; y++ {
+		lw, line := RenderLine(b, y)
+		got[fmt.Sprintf("line%d", y)] = strings.TrimRight(ansiStrip(line), " ")
+		got[fmt.Sprintf("width%d", y)] = fmt.Sprint(lw)
+	}
+	return got
+}
+
+// judgeRender is the judge of the Render family (shared with the narrow property).
+func judgeRender(j *hzCaseJudge, c renderCase) {
+	judgeBy(j, c, renderExpected, renderActual)
+}
+
+// TestHegelRenderRoundTripsThroughSetContent: Render of a buffer, read back by SetContent
+// into a fresh buffer, restores every cell (content, width, style, link), and RenderLine's
+// plain text and width are the line's. The shapes of cellbuf/2 (an orphan placeholder, which
+// Render skips so that the rest of the line shifts), 6 (a style change DiffSequence writes
+// lossily) and 9 (a cluster with an ASCII base, whose mark printString attaches to the next
+// cell) are drawn at their natural rates and fail by default naming the bug.
+func TestHegelRenderRoundTripsThroughSetContent(t *testing.T) {
+	judged(t, withoutShapes(renderExpected, renderCases), judgeRender)
+}
diff --git a/cellbuf/hegel_cells_test.go b/cellbuf/hegel_cells_test.go
new file mode 100644
index 0000000..2a41c18
--- /dev/null
+++ b/cellbuf/hegel_cells_test.go
@@ -0,0 +1,137 @@
+package cellbuf
+
+// The cell constructors family: NewGraphemeCell, NewCellString and NewCell against uniseg
+// and go-runewidth (the documented widths and contents), the replica of NewCell (buffer.go
+// 16) under the switch of cellbuf/7, Clone/Blank/Equal/Empty/Clear and Line.String/At; the
+// case record, its generator and the property.
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/mattn/go-runewidth"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+// hzASCIIAtoms are the ASCII narrow atoms; hzPairAtoms the graphemes whose later runes add
+// width (the shape of cellbuf/7: NewCell sums every rune's width): two ASCII atoms glued
+// ("ab"-like, eight of ten), a flag (two regional indicators, one cluster of width 2) and a
+// ZWJ emoji sequence (woman technologist), one of ten each.
+var (
+	hzASCIIAtoms = []string{"a", "b", "x", "Z", "0", "9", ".", "-", "_", "#"}
+	hzFlagAtom   = "\U0001f1ef\U0001f1f5"
+	hzZWJAtom    = "\U0001f469\u200d\U0001f4bb"
+)
+
+var hzPairAtoms = dieChoice(
+	hzW(8, hegel.Map(hzTuple(evenHalves(hzASCIIAtoms...), evenHalves(hzASCIIAtoms...)), func(p []string) string { return p[0] + p[1] })), // a glued pair nominal 80 of the pairs: realises 81.2
+	hzW(1, hegel.Just(hzFlagAtom)), // the flag nominal 10: realises 8.0
+	hzW(1, hegel.Just(hzZWJAtom)),  // the ZWJ sequence nominal 10: realises 10.8
+)
+
+// cellGraphemes is the grapheme of a cell case: one of the shared population nine times in
+// ten, a width-adding pair one time in ten (never under HEGEL_NO_KNOWN=1).
+var cellGraphemes = dieChoice(
+	hzW(90, graphemes),                        // the atoms nominal 90: realises 89.2
+	hzW(hzUnless(hzNoKnown, 10), hzPairAtoms), // a pair nominal 10: realises 10.8
+)
+
+// cellCase is a case of the cell constructors property: a grapheme.
+type cellCase struct {
+	g string
+}
+
+func (c cellCase) GoString() string { return fmt.Sprintf("grapheme %q", c.g) }
+
+var cellCases = hegel.Map(cellGraphemes, func(g string) cellCase { return cellCase{g: g} })
+
+// hzFirstCombining is NewCellString's documented rule (buffer.go 36; NewCell's doc comment,
+// buffer.go 14, says the same of NewCell): the first rune and the zero-width runes after it
+// up to the first rune of a width, the width that of the first rune (go-runewidth).
+func hzFirstCombining(rs []rune) (string, int) {
+	out := []rune{rs[0]}
+	for _, r := range rs[1:] {
+		if runewidth.RuneWidth(r) > 0 {
+			break
+		}
+		out = append(out, r)
+	}
+	return string(out), runewidth.RuneWidth(rs[0])
+}
+
+// cellExpected states the property's values under k: "grapheme" (NewGraphemeCell: the
+// first grapheme cluster and its width from uniseg), "string" (NewCellString: the first
+// rune's width, the zero-width runes after it), "cell" (NewCell(rs[0], rs[1:]...): the
+// documented rule is NewCellString's; with k7 the replica appends every rune and takes
+// runewidth.StringWidth of them all, buffer.go 26-27), "clone", "blank", "empty" (the
+// contracts of Clone, Blank, Empty and Clear) and "line" (Line.String of a blank, the cell and
+// a blank or the cell's placeholder, with At's contract).
+func cellExpected(c cellCase, k known) checks {
+	rs := []rune(c.g)
+	want := checks{}
+	g, _, w, _ := uniseg.FirstGraphemeClusterInString(c.g, -1)
+	want["grapheme"] = fmt.Sprintf("{%q w%d}", g, w)
+	s, sw := hzFirstCombining(rs)
+	want["string"] = fmt.Sprintf("{%q w%d}", s, sw)
+	if k[kNewCellAppendsAll] {
+		want["cell"] = fmt.Sprintf("{%q w%d}", c.g, runewidth.StringWidth(c.g))
+	} else {
+		want["cell"] = fmt.Sprintf("{%q w%d}", s, sw)
+	}
+	want["clone"] = "equal, distinct"
+	want["blank"] = "ok"
+	want["empty"] = "ok"
+	want["line"] = fmt.Sprintf("%q, At ok", " "+g)
+	return want
+}
+
+func cellActual(c cellCase) checks {
+	rs := []rune(c.g)
+	got := checks{}
+	cl := NewGraphemeCell(c.g)
+	got["grapheme"] = fmt.Sprintf("{%q w%d}", cl.String(), cl.Width)
+	cs := NewCellString(c.g)
+	got["string"] = fmt.Sprintf("{%q w%d}", cs.String(), cs.Width)
+	c1 := NewCell(rs[0], rs[1:]...)
+	got["cell"] = fmt.Sprintf("{%q w%d}", c1.String(), c1.Width)
+	cp := cl.Clone()
+	got["clone"] = "equal, distinct"
+	if !cp.Equal(cl) || cp == cl {
+		got["clone"] = fmt.Sprintf("clone of %s is %s", hzCellText(cl), hzCellText(cp))
+	}
+	cp.Blank()
+	got["blank"] = "ok"
+	if cp.Rune != ' ' || cp.Width != 1 || cp.Comb != nil || !cp.Clear() {
+		got["blank"] = fmt.Sprintf("Blank() = %s", hzCellText(cp))
+	}
+	var e Cell
+	got["empty"] = "ok"
+	if cl.Empty() || !e.Empty() || (&e).Clear() {
+		got["empty"] = fmt.Sprintf("Empty %v; zero cell Empty %v Clear %v", cl.Empty(), e.Empty(), (&e).Clear())
+	}
+	l := Line{nil, cl, nil}
+	if cl.Width > 1 {
+		l = Line{nil, cl, &Cell{}}
+	}
+	at := "At ok"
+	if l.At(0) == nil || !l.At(0).Equal(&BlankCell) || l.At(-1) != nil || l.At(3) != nil {
+		at = "At out of contract"
+	}
+	got["line"] = fmt.Sprintf("%q, %s", l.String(), at)
+	return got
+}
+
+// judgeCells is the judge of the cell family (shared with the narrow property).
+func judgeCells(j *hzCaseJudge, c cellCase) {
+	judgeBy(j, c, cellExpected, cellActual)
+}
+
+// TestHegelCellConstructorsFollowRunewidth: NewGraphemeCell, NewCellString and NewCell of a
+// grapheme have the documented content and width, Clone/Blank/Equal/Empty/Clear keep their
+// contracts, and a Line prints and indexes it as documented. The shape of cellbuf/7 (a
+// grapheme whose later runes add width) is drawn one time in ten and fails by default naming
+// the bug; it is not drawn under HEGEL_NO_KNOWN=1.
+func TestHegelCellConstructorsFollowRunewidth(t *testing.T) {
+	judged(t, cellCases, judgeCells)
+}
diff --git a/cellbuf/hegel_idioms_test.go b/cellbuf/hegel_idioms_test.go
new file mode 100644
index 0000000..b0e00fa
--- /dev/null
+++ b/cellbuf/hegel_idioms_test.go
@@ -0,0 +1,553 @@
+package cellbuf
+
+// The generator idioms the properties share, copied from the go/excelize, go/graphql-go,
+// go/cobra, go/cascadia, go/carbon, go/orb, go/chi, go/go-debian and go/gin harness
+// (hegel_idioms_test.go / hegel_zoo_idioms_test.go there; go/bubbles' internal/zootest/gen.go
+// before them) with the hz prefix: hegel-go has no weighted choice, biased coin, tuple or
+// counted-list combinator. Every generator built from them is a package-level value; the
+// simplest alternative comes first so that shrinking lands on it, except the shape of a
+// recorded bug a wide property must reach every run, which goes first at a solid weight and
+// is never drawn under HEGEL_NO_KNOWN=1. The weights are nominal: a weighted choice drawn
+// alone comes out exact (the engine enumerates a small die), but inside a case with other
+// draws the engine favours the small values of any bounded draw at every scale (go/chi and
+// go/go-debian measured it: Integers(0, 99) lands in 0..9 about 29 percent of the time,
+// coins realise about 0.83 of nominal), so the rates are what the probe and the collector
+// (ZOO_COLLECT=1) measure; hzFair, fairOver, fairInts, evenOver and fairTree (from go/chi)
+// re-roll the favourite face, the die* family (from go/go-debian) draws from fair bits, the
+// halving helpers at the end (from go/gin, where hzDie(3) realised its last face at 12 to 27
+// percent instead of 33) halve a range by fair bits, and the figure beside every weight in
+// the generator files is the measured one.
+
+import (
+	"os"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzNoKnown is set by HEGEL_NO_KNOWN=1 and read once: the shapes of the recorded bugs are
+// then not drawn (a weight of zero, hzUnless; the region past the shape, hzShaped; the
+// relation filtered out, hzOnly) or the case is skipped (hzCaseJudge.Shape), for a run that
+// looks past the known bugs. By default every property draws them and fails naming the shape.
+var hzNoKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// hzChoice is one alternative of a weighted choice.
+type hzChoice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// hzW is the choice of weight w for g.
+func hzW[T any](w int, g hegel.Generator[T]) hzChoice[T] { return hzChoice[T]{weight: w, gen: g} }
+
+// hzWeighted generates from one of the choices, chosen with probability proportional to its
+// weight (a weight of zero is never drawn); it shrinks towards the first choice, so the
+// simplest comes first.
+func hzWeighted[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzWeighted: every choice has weight 0")
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// hzCoin is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func hzCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// hzMaybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func hzMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return hzWeighted(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// hzSampled is one of a small table (the first is the shrink target).
+func hzSampled[T any](xs ...T) hegel.Generator[T] { return hegel.SampledFrom(xs) }
+
+// hzInts is an integer in [lo, hi], draw-free when the range is one value.
+func hzInts(lo, hi int) hegel.Generator[int] {
+	if lo == hi {
+		return hegel.Just(lo)
+	}
+	return hegel.Integers(lo, hi)
+}
+
+// hzUnless is the weight w, or zero when off: the clean way to stop drawing a shape under
+// HEGEL_NO_KNOWN=1.
+func hzUnless(off bool, w int) int {
+	if off {
+		return 0
+	}
+	return w
+}
+
+// hzOnly is g filtered by pred when on, g itself otherwise: the form of a generator whose
+// known-bug region is a relation between its parts rather than an alternative (under
+// HEGEL_NO_KNOWN=1 the region is filtered out; the filter gives up after three draws and the
+// case is then a skip, so the region must be a small share of g). Every draw the predicate
+// rejects is counted as "filtered <name>" for the collector.
+func hzOnly[T any](on bool, name string, g hegel.Generator[T], pred func(T) bool) hegel.Generator[T] {
+	if !on {
+		return g
+	}
+	return hegel.Filter(g, func(v T) bool {
+		ok := pred(v)
+		if !ok {
+			hzTally("filtered " + name)
+		}
+		return ok
+	})
+}
+
+// hzShaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for
+// the neighbouring region past it (the narrow properties).
+func hzShaped[T any](shape, past T) T {
+	if hzNoKnown {
+		return past
+	}
+	return shape
+}
+
+// hzKnown is the plain generator, or the region of a recorded bug's shape one time in five
+// (the shape first, the exception of STYLE.md rule 3); the shape is never drawn under
+// HEGEL_NO_KNOWN=1 (the wide properties).
+func hzKnown[T any](plain, shape hegel.Generator[T]) hegel.Generator[T] {
+	return hzWeighted(hzW(hzUnless(hzNoKnown, 1), shape), hzW(4, plain))
+}
+
+// hzTuple draws one value from each generator (a Composite only because the binding has no
+// tuple combinator).
+func hzTuple[T any](gens ...hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		out := make([]T, len(gens))
+		for i, g := range gens {
+			out[i] = hegel.Draw(tc, g)
+		}
+		return out
+	})
+}
+
+// hzCounted is a list of lo to hi elements with the count drawn first (Lists alone almost
+// never draws the empty list and skews short); nil for no elements.
+func hzCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(hzInts(lo, hi), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// hzSeq concatenates the drawn lists (a prefix, the shape, a suffix).
+func hzSeq[T any](gens ...hegel.Generator[[]T]) hegel.Generator[[]T] {
+	return hegel.Composite(func(tc hegel.TestCase) []T {
+		var out []T
+		for _, g := range gens {
+			out = append(out, hegel.Draw(tc, g)...)
+		}
+		return out
+	})
+}
+
+// hzOne is a list of the one drawn value.
+func hzOne[T any](g hegel.Generator[T]) hegel.Generator[[]T] {
+	return hegel.Map(g, func(v T) []T { return []T{v} })
+}
+
+// weightedOver: a choice over the values at the weights (the first the shrink target), the
+// form of a uniform table here (the go/cascadia helper): the engine favours the first
+// alternative of a weighted choice and index 1 of a SampledFrom table, so a table drawn
+// evenly is a weighted choice with lower first weights, tuned by measurement.
+func weightedOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("weightedOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzWeighted(choices...)
+}
+
+// evenInts: the integers lo, lo+1, ... at the weights, the form of a uniform range here.
+func evenInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return weightedOver(weights, values...)
+}
+
+// hzFair is hzWeighted with the engine's favourite face re-rolled: inside the routing cases
+// a die of any range lands on its second value about nine points too often (Integers(0, 6)
+// at 23 percent there against 13 elsewhere, SampledFrom and Integers(10, 16) alike: the
+// probe), so a choice of small weights never realises them; here that face draws the choice
+// again, and the rest of the die is the weights. It shrinks as hzWeighted does (the first
+// face is the first choice). Added for go/chi.
+func hzFair[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("hzFair: every choice has weight 0")
+	}
+	var g hegel.Generator[T]
+	g = hegel.FlatMap(hegel.Integers(0, total), func(i int) hegel.Generator[T] {
+		if i == 1 {
+			return g
+		}
+		if i > 1 {
+			i--
+		}
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+	return g
+}
+
+// fairOver is weightedOver with the favourite face re-rolled (hzFair): a table drawn at its
+// weights. Added for go/chi.
+func fairOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairOver: weights and values differ in length")
+	}
+	choices := make([]hzChoice[T], len(values))
+	for i, v := range values {
+		choices[i] = hzW(weights[i], hegel.Just(v))
+	}
+	return hzFair(choices...)
+}
+
+// fairInts is evenInts with the favourite face re-rolled (hzFair).
+func fairInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairOver(weights, values...)
+}
+
+// evenOver is a table at one weight each, drawn evenly (fairOver).
+func evenOver[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairOver(weights, values...)
+}
+
+// fairCounted is a list of lo to hi elements with the count drawn evenly (treeInts; hzCounted's
+// hzInts favours the second value of its range here); nil for no elements. countedBy is the
+// same with the counts at weights (lo first).
+func fairCounted[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	weights := make([]int, hi-lo+1)
+	for i := range weights {
+		weights[i] = 1
+	}
+	return countedBy(g, lo, weights...)
+}
+
+func countedBy[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(treeInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// fairTree is fairOver for a table of more than three entries: the engine's hump over the
+// small faces of a big die (the first choice of a thirteen-face hzFair realised 38 points of
+// its 33 here) cannot be evened by weights, so the table is drawn by a tree of small dice: the
+// entries are cut into three consecutive parts (two below six), a part is drawn at its summed
+// weight (reduced by their common divisor), and the part again, down to fairOver over at most
+// three. A part without weight is left out (hzUnless). The first entry stays the shrink
+// target. evenTree is a table at one weight each; treeInts the integers lo, lo+1, ... at the
+// weights.
+func fairTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("fairTree: weights and values differ in length")
+	}
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	if len(values) <= 3 {
+		return fairOver(weights, values...)
+	}
+	parts := 2
+	if len(values) >= 6 {
+		parts = 3
+	}
+	base, rem := len(values)/parts, len(values)%parts
+	var choices []hzChoice[T]
+	var sums []int
+	g := 0
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first: the engine favours the first faces
+			j++
+		}
+		w := 0
+		for _, x := range weights[i:j] {
+			w += x
+		}
+		if w > 0 {
+			choices = append(choices, hzW(w, fairTree(weights[i:j], values[i:j]...)))
+			sums = append(sums, w)
+			g = gcd(g, w)
+		}
+		i = j
+	}
+	for k := range choices {
+		choices[k].weight = sums[k] / g
+	}
+	return hzFair(choices...)
+}
+
+func evenTree[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return fairTree(weights, values...)
+}
+
+func treeInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return fairTree(weights, values...)
+}
+
+func gcd(a, b int) int {
+	for b != 0 {
+		a, b = b, a%b
+	}
+	return a
+}
+
+// --------------------------------------------------------------------------- added for
+// go/go-debian: the probe here (hegel-go v0.6.33, a die drawn inside a case of several draws)
+// found the engine's favour on small values at every scale, not on one face: Integers(0, 99)
+// landed 29 points on 0 to 9 (about 6 each on 0 and 1) and Integers(0, 1009) 46 on its first
+// hundred, falling to 3 on its last; Integers(0, 12) 20 on face 1 and 5 to 9 on the others.
+// A coin on such a die (hzCoin) realises about 0.8 of its percentage, and a choice of weights
+// summing to more than a handful (hzFair) favours its first choices by the sum. Only the
+// smallest dice are even once their first two faces are re-rolled (hzDie: 2 faces 51/49, 3
+// faces 34/32/34, 4 faces 25/28/22/25, and the slope starts at 6), so the die* family below
+// draws every choice from dice of two or three faces: an even table by a tree of them
+// (dieTree), a weight by a run of fair bits (hzChance, the binary expansion of the
+// probability), and the generator files use it with the measured figure beside every weight.
+
+// hzDie is the faces 0 to n-1 of a small die (n at most 4), drawn evenly: a die of n+2 faces
+// whose first two draw it again. It shrinks to 0 (face 2).
+func hzDie(n int) hegel.Generator[int] {
+	if n <= 1 {
+		return hegel.Just(0)
+	}
+	var g hegel.Generator[int]
+	g = hegel.FlatMap(hegel.Integers(0, n+1), func(i int) hegel.Generator[int] {
+		if i < 2 {
+			return g
+		}
+		return hegel.Just(i - 2)
+	})
+	return g
+}
+
+// hzChance is true num times in den, drawn as fair bits (hzDie(2)) compared with the binary
+// expansion of num/den until they differ (two bits on average); it shrinks to true (every
+// bit 0 is below any positive probability), so the first choice of a weighted choice is the
+// shrink target.
+func hzChance(num, den int) hegel.Generator[bool] {
+	if num <= 0 {
+		return hegel.Just(false)
+	}
+	if num >= den {
+		return hegel.Just(true)
+	}
+	return hegel.FlatMap(hzDie(2), func(b int) hegel.Generator[bool] {
+		n2, pbit := num*2, 0
+		if n2 >= den {
+			pbit, n2 = 1, n2-den
+		}
+		if b < pbit {
+			return hegel.Just(true)
+		}
+		if b > pbit {
+			return hegel.Just(false)
+		}
+		return hzChance(n2, den)
+	})
+}
+
+// dieChoice is hzWeighted on hzChance: the first choice at its share, else the second at its
+// share of the rest, and so on (a weight of zero is never drawn); it shrinks to the first
+// choice. For more than three choices dieTree is the cheaper form.
+func dieChoice[T any](choices ...hzChoice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	if total <= 0 {
+		panic("dieChoice: every choice has weight 0")
+	}
+	var live []hzChoice[T]
+	for _, c := range choices {
+		if c.weight > 0 {
+			live = append(live, c)
+		}
+	}
+	if len(live) == 1 {
+		return live[0].gen
+	}
+	return hegel.FlatMap(hzChance(live[0].weight, total), func(first bool) hegel.Generator[T] {
+		if first {
+			return live[0].gen
+		}
+		return dieChoice(live[1:]...)
+	})
+}
+
+// dieTree is a table at its weights (the first the shrink target), drawn by a tree of small
+// dice: the entries are cut into three consecutive parts (two below six), a part drawn by
+// hzDie when their weights are equal and by dieChoice when not, and the part again, down to
+// at most three entries. An entry of weight zero is never drawn. dieInts is the integers lo,
+// lo+1, ... at the weights; dieEven a table at one weight each; dieOver another name for
+// dieTree.
+func dieTree[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("dieTree: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("dieTree: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	parts := 2
+	if len(vs) >= 6 || len(vs) == 3 {
+		parts = 3
+	}
+	if len(vs) <= 3 {
+		parts = len(vs)
+	}
+	base, rem := len(vs)/parts, len(vs)%parts
+	var gens []hegel.Generator[T]
+	var sums []int
+	even := true
+	for i, p := 0, 0; p < parts; p++ {
+		j := i + base
+		if p >= parts-rem { // the shorter parts first
+			j++
+		}
+		w := 0
+		for _, x := range ws[i:j] {
+			w += x
+		}
+		if j-i == 1 {
+			gens = append(gens, hegel.Just(vs[i]))
+		} else {
+			gens = append(gens, dieTree(ws[i:j], vs[i:j]...))
+		}
+		sums = append(sums, w)
+		if w != sums[0] {
+			even = false
+		}
+		i = j
+	}
+	if even {
+		return hegel.FlatMap(hzDie(len(gens)), func(i int) hegel.Generator[T] { return gens[i] })
+	}
+	choices := make([]hzChoice[T], len(gens))
+	for i, g := range gens {
+		choices[i] = hzW(sums[i], g)
+	}
+	return dieChoice(choices...)
+}
+
+func dieOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	return dieTree(weights, values...)
+}
+
+func dieInts(lo int, weights ...int) hegel.Generator[int] {
+	values := make([]int, len(weights))
+	for i := range weights {
+		values[i] = lo + i
+	}
+	return dieTree(weights, values...)
+}
+
+func dieEven[T any](values ...T) hegel.Generator[T] {
+	weights := make([]int, len(values))
+	for i := range weights {
+		weights[i] = 1
+	}
+	return dieTree(weights, values...)
+}
+
+// dieCoin is true pct percent of the time, shrinking to false; dieMaybe is g pct percent of
+// the time and the zero value otherwise.
+func dieCoin(pct int) hegel.Generator[bool] {
+	return hegel.Map(hzChance(100-pct, 100), func(no bool) bool { return !no })
+}
+
+func dieMaybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return dieChoice(hzW(100-pct, hegel.Just(zero)), hzW(pct, g))
+}
+
+// dieCounted is a list of elements with the count at the weights (lo first); nil for none.
+func dieCounted[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	return hegel.FlatMap(dieInts(lo, weights...), func(k int) hegel.Generator[[]T] {
+		return hegel.Lists(g).MinSize(k).MaxSize(k)
+	})
+}
+
+// --------------------------------------------------------------------------- added for
+// go/gin: evenHalves is a table at one weight each drawn by halving: a fair-bit choice
+// between the two halves at their sizes (dieChoice), and each half again, down to one value;
+// the first value is the shrink target. dieTree's three-way splits (hzDie(3)) realised their
+// last face at 12 to 27 instead of 33 in gin's harness, so even tables are halved instead.
+// rangeHalves is the integers lo to hi so drawn; countedHalves a list of lo to hi elements.
+func evenHalves[T any](values ...T) hegel.Generator[T] {
+	if len(values) == 1 {
+		return hegel.Just(values[0])
+	}
+	h := (len(values) + 1) / 2
+	return dieChoice(hzW(h, evenHalves(values[:h]...)), hzW(len(values)-h, evenHalves(values[h:]...)))
+}
+
+func rangeHalves(lo, hi int) hegel.Generator[int] {
+	values := make([]int, hi-lo+1)
+	for i := range values {
+		values[i] = lo + i
+	}
+	return evenHalves(values...)
+}
+
+func countedHalves[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.FlatMap(rangeHalves(lo, hi), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
