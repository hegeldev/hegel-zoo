diff --git a/hegel/hegel_zoo_load_test.go b/hegel/hegel_zoo_load_test.go
new file mode 100644
index 0000000..8edf7af
--- /dev/null
+++ b/hegel/hegel_zoo_load_test.go
@@ -0,0 +1,224 @@
+package hegel
+
+// TestHegelLoad: LoadRawData against a model of its conversion (every element in order, as a
+// float64; strings parsed by strconv.ParseFloat, the unparsable ones dropped; booleans 1 and 0;
+// durations in nanoseconds).
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/montanaflynn/stats"
+	"hegel.dev/go/hegel"
+)
+
+func TestHegelLoad(t *testing.T) {
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		n := hzDrawInt(ht, 0, 8)
+		ints := make([]int64, n)
+		for i := range ints {
+			ints[i] = int64(hzDrawInt(ht, -120, 120))
+		}
+		var want []float64
+		var raw any
+		kind := hzPick(ht, []string{"int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64",
+			"bool", "float64", "float32", "string", "duration", "map", "iface", "text", "reader"})
+		abs := func(v int64) int64 {
+			if v < 0 {
+				return -v
+			}
+			return v
+		}
+		for _, v := range ints {
+			switch kind {
+			case "uint", "uint8", "uint16", "uint32", "uint64":
+				want = append(want, float64(abs(v)))
+			case "bool":
+				if v%2 != 0 {
+					want = append(want, 1)
+				} else {
+					want = append(want, 0)
+				}
+			case "float64", "float32", "string", "text", "reader":
+				want = append(want, float64(v)/4)
+			default:
+				want = append(want, float64(v))
+			}
+		}
+		texts := func() []string {
+			out := make([]string, n)
+			for i, v := range ints {
+				out[i] = strconv.FormatFloat(float64(v)/4, 'g', -1, 64)
+			}
+			return out
+		}
+		switch kind {
+		case "int":
+			s := make([]int, n)
+			for i, v := range ints {
+				s[i] = int(v)
+			}
+			raw = s
+		case "int8":
+			s := make([]int8, n)
+			for i, v := range ints {
+				s[i] = int8(v)
+			}
+			raw = s
+		case "int16":
+			s := make([]int16, n)
+			for i, v := range ints {
+				s[i] = int16(v)
+			}
+			raw = s
+		case "int32":
+			s := make([]int32, n)
+			for i, v := range ints {
+				s[i] = int32(v)
+			}
+			raw = s
+		case "int64":
+			raw = ints
+		case "uint":
+			s := make([]uint, n)
+			for i, v := range ints {
+				s[i] = uint(abs(v))
+			}
+			raw = s
+		case "uint8":
+			s := make([]uint8, n)
+			for i, v := range ints {
+				s[i] = uint8(abs(v))
+			}
+			raw = s
+		case "uint16":
+			s := make([]uint16, n)
+			for i, v := range ints {
+				s[i] = uint16(abs(v))
+			}
+			raw = s
+		case "uint32":
+			s := make([]uint32, n)
+			for i, v := range ints {
+				s[i] = uint32(abs(v))
+			}
+			raw = s
+		case "uint64":
+			s := make([]uint64, n)
+			for i, v := range ints {
+				s[i] = uint64(abs(v))
+			}
+			raw = s
+		case "bool":
+			s := make([]bool, n)
+			for i, v := range ints {
+				s[i] = v%2 != 0
+			}
+			raw = s
+		case "float64":
+			raw = append([]float64{}, want...)
+		case "float32":
+			if HZKnown.loadIfaceDrops {
+				hzAvoid("loadIfaceDrops")
+				return
+			}
+			s := make([]float32, n)
+			for i, v := range want {
+				s[i] = float32(v)
+			}
+			raw = s
+		case "string":
+			raw = texts()
+		case "text":
+			raw = strings.Join(texts(), hzPick(ht, []string{" ", "\n", "\t", "  "}))
+		case "reader":
+			raw = strings.NewReader(strings.Join(texts(), hzPick(ht, []string{" ", "\n", " \n"})))
+		case "duration":
+			s := make([]time.Duration, n)
+			for i, v := range ints {
+				s[i] = time.Duration(v) * time.Millisecond
+				want[i] = float64(s[i])
+			}
+			raw = s
+		case "map":
+			// keys 0..n-1 (the documented layout: the map is read by index) or arbitrary keys
+			m := map[int]int{}
+			keys := make([]int, n)
+			for i := range keys {
+				keys[i] = i
+			}
+			if hzChance(ht, 30) {
+				if HZKnown.loadMapByIndex {
+					hzAvoid("loadMapByIndex")
+					return
+				}
+				for i := range keys {
+					keys[i] = hzDrawInt(ht, 0, 20)
+				}
+			}
+			m2 := map[int]float64{}
+			for i, v := range ints {
+				m[keys[i]] = int(v)
+				m2[keys[i]] = float64(v)
+			}
+			want = want[:0]
+			seen := map[int]bool{}
+			// the model: entries in ascending key order
+			for k := 0; k <= 20; k++ {
+				if _, ok := m2[k]; ok && !seen[k] {
+					seen[k] = true
+					want = append(want, m2[k])
+				}
+			}
+			raw = m
+		case "iface":
+			s := make([]any, n)
+			for i, v := range ints {
+				switch hzDrawInt(ht, 1, 9) {
+				case 1:
+					s[i] = int(v)
+				case 2:
+					s[i] = float64(v)
+				case 3:
+					s[i] = strconv.FormatInt(v, 10)
+				case 4:
+					s[i] = v%2 != 0
+					want[i] = 0
+					if v%2 != 0 {
+						want[i] = 1
+					}
+				case 5:
+					s[i] = time.Duration(v)
+				case 6:
+					s[i] = uint(abs(v))
+					want[i] = float64(abs(v))
+				default:
+					if HZKnown.loadIfaceDrops {
+						hzAvoid("loadIfaceDrops")
+						return
+					}
+					switch hzDrawInt(ht, 1, 4) {
+					case 1:
+						s[i] = v
+					case 2:
+						s[i] = int32(v)
+					case 3:
+						s[i] = float32(v)
+					default:
+						s[i] = uint64(abs(v))
+						want[i] = float64(abs(v))
+					}
+				}
+			}
+			raw = s
+		}
+		got := stats.LoadRawData(raw)
+		if !hzCloseAll(got, want, 0, 0) {
+			col.failClass(ht, kind, "LoadRawData(%s %v) = %v, want %v", kind, raw, got, want)
+		}
+		col.count("cases")
+	})
+}
diff --git a/hegel/hegel_zoo_norm_test.go b/hegel/hegel_zoo_norm_test.go
new file mode 100644
index 0000000..d6edcd8
--- /dev/null
+++ b/hegel/hegel_zoo_norm_test.go
@@ -0,0 +1,147 @@
+package hegel
+
+// TestHegelNorm: the normal distribution functions (norm.go) against scipy.stats.norm, and Ncr
+// against math/big.
+
+import (
+	"math"
+	"math/big"
+	"testing"
+
+	"github.com/montanaflynn/stats"
+	"hegel.dev/go/hegel"
+)
+
+func TestHegelNorm(t *testing.T) {
+	col := hzNewCollector(t)
+	oracle := hzStartOracle(t)
+	hzProperty(t, func(ht *hegel.T) {
+		loc := 0.0
+		switch hzDrawInt(ht, 1, 3) {
+		case 1:
+			loc = hzGenValue(ht, "dec")
+		case 2:
+			loc = hzGenValue(ht, "big")
+		}
+		scale := 1.0
+		switch hzDrawInt(ht, 1, 3) {
+		case 1:
+			scale = hzGenValue(ht, "positive")
+		case 2:
+			scale = math.Pow(10, float64(hzDrawInt(ht, -6, 6)))
+		}
+		// x as a standard score, into the far tails too
+		z := float64(hzDrawInt(ht, -4000, 4000)) / 1000
+		if hzChance(ht, 25) {
+			z = float64(hzDrawInt(ht, -40, 40))
+		}
+		x := loc + scale*z
+		var p float64
+		if hzChance(ht, 50) {
+			p = hzPick(ht, []float64{1e-300, 1e-100, 1e-20, 1e-10, 1e-5, 1e-3, 0.02425, 0.024251, 0.1, 0.25, 0.5, 0.75, 0.9, 0.97575, 0.999, 1 - 1e-5, 1 - 1e-10, 1 - 1e-16})
+		} else {
+			p = float64(hzDrawInt(ht, 1, 9999)) / 10000
+		}
+		nMoment := hzDrawInt(ht, 0, 20)
+		if hzChance(ht, 10) {
+			nMoment = hzDrawInt(ht, 21, 30)
+			if HZKnown.normMomentOverflow {
+				hzAvoid("normMomentOverflow")
+				nMoment = 20
+			}
+		}
+		var data []float64
+		if hzChance(ht, 80) {
+			data = hzGenSeries(ht, hzDrawInt(ht, 1, 30))
+		}
+
+		r, err := oracle.call(map[string]any{
+			"op": "norm", "x": hzFmt(x), "p": hzFmt(p), "loc": hzFmt(loc), "scale": hzFmt(scale),
+			"n": nMoment, "data": hzFmts(data),
+		})
+		if err != nil {
+			col.failClass(ht, "oracle", "loc=%v scale=%v x=%v p=%v: %v", loc, scale, x, p, err)
+			return
+		}
+		check := func(name string, got, want, rtol, atol float64) {
+			if !hzClose(got, want, rtol, atol) {
+				col.failClass(ht, name, "%s(x=%v, p=%v, loc=%v, scale=%v) = %v, oracle %v", name, x, p, loc, scale, got, want)
+			}
+		}
+		check("NormPdf", stats.NormPdf(x, loc, scale), r.float("pdf"), 1e-12, 1e-300)
+		check("NormLogPdf", stats.NormLogPdf(x, loc, scale), r.float("logpdf"), 1e-12, 1e-12)
+		// (SciPy flushes the subnormal tail to 0; the library keeps it)
+		check("NormCdf", stats.NormCdf(x, loc, scale), r.float("cdf"), 1e-12, 1e-300)
+		check("NormSf", stats.NormSf(x, loc, scale), r.float("sf"), 1e-12, 1e-300)
+		check("NormLogCdf", stats.NormLogCdf(x, loc, scale), r.float("logcdf"), 1e-11, 1e-12)
+		check("NormLogSf", stats.NormLogSf(x, loc, scale), r.float("logsf"), 1e-11, 1e-12)
+		check("NormPpf", stats.NormPpf(p, loc, scale), r.float("ppf"), 1e-12, 1e-12*scale)
+		check("NormIsf", stats.NormIsf(p, loc, scale), r.float("isf"), 1e-12, 1e-12*scale)
+		// the interval is symmetric about loc (SciPy's upper end is +Inf when (1+p)/2 rounds to 1)
+		iv := stats.NormInterval(p, loc, scale)
+		want := r.floats("interval")
+		if !hzClose(iv[0], want[0], 1e-12, 1e-12*scale) || !hzClose(iv[1], 2*loc-iv[0], 1e-12, 1e-12*scale) {
+			col.failClass(ht, "NormInterval", "NormInterval(%v, %v, %v) = %v, oracle %v", p, loc, scale, iv, want)
+		}
+		check("NormEntropy", stats.NormEntropy(loc, scale), r.float("entropy"), 1e-12, 1e-12)
+		st := stats.NormStats(loc, scale, "mvsk")
+		want = r.floats("stats")
+		if len(st) != 4 || !hzCloseAll(st, want, 1e-12, 0) {
+			col.failClass(ht, "NormStats", "NormStats(%v, %v, mvsk) = %v, oracle %v", loc, scale, st, want)
+		}
+		check("NormMean", stats.NormMean(loc, scale), loc, 0, 0)
+		check("NormMedian", stats.NormMedian(loc, scale), loc, 0, 0)
+		check("NormVar", stats.NormVar(loc, scale), scale*scale, 1e-15, 0)
+		check("NormStd", stats.NormStd(loc, scale), scale, 0, 0)
+		check("NormMoment", stats.NormMoment(nMoment, loc, scale), r.float("moment"), 1e-9, 0)
+		if len(data) > 0 {
+			fit := stats.NormFit(data)
+			want = r.floats("fit")
+			sc := hzScale(data)
+			if !hzClose(fit[0], want[0], 1e-9, 1e-9*sc) || !hzClose(fit[1], want[1], 1e-9, 1e-9*sc) {
+				col.failClass(ht, "NormFit", "NormFit(%s) = %v, oracle %v", hzShow(data), fit, want)
+			}
+		}
+
+		// the geometric distribution: P(a <= K <= b) summed term by term, its mean and variance
+		pg := float64(hzDrawInt(ht, 1, 99)) / 100
+		if hzChance(ht, 15) {
+			pg = hzPick(ht, []float64{-0.5, 1.5, 2, -1})
+			if HZKnown.probGeomNoBounds {
+				hzAvoid("probGeomNoBounds")
+				pg = 0.5
+			}
+		}
+		a := hzDrawInt(ht, 1, 20)
+		b := a + hzDrawInt(ht, 0, 20)
+		prob, err := stats.ProbGeom(a, b, pg)
+		if pg < 0 || pg > 1 {
+			if err == nil {
+				col.failClass(ht, "ProbGeom bounds", "ProbGeom(%d, %d, %v) = %v, no error", a, b, pg, prob)
+			}
+		} else {
+			sum := 0.0
+			for k := a; k <= b; k++ {
+				sum += pg * math.Pow(1-pg, float64(k-1))
+			}
+			if err != nil || !hzClose(prob, sum, 1e-9, 1e-15) {
+				col.failClass(ht, "ProbGeom", "ProbGeom(%d, %d, %v) = %v, %v; want %v", a, b, pg, prob, err, sum)
+			}
+			if e, err := stats.ExpGeom(pg); err != nil || !hzClose(e, 1/pg, 1e-12, 0) {
+				col.failClass(ht, "ExpGeom", "ExpGeom(%v) = %v, %v", pg, e, err)
+			}
+			if vg, err := stats.VarGeom(pg); err != nil || !hzClose(vg, (1-pg)/(pg*pg), 1e-12, 0) {
+				col.failClass(ht, "VarGeom", "VarGeom(%v) = %v, %v", pg, vg, err)
+			}
+		}
+
+		// Ncr against math/big where the result fits an int
+		n := hzDrawInt(ht, 0, 40)
+		k := hzDrawInt(ht, 0, n)
+		wantC := new(big.Int).Binomial(int64(n), int64(k))
+		if got := stats.Ncr(n, k); !wantC.IsInt64() || int64(got) != wantC.Int64() {
+			col.failClass(ht, "Ncr", "Ncr(%d, %d) = %d, want %s", n, k, got, wantC)
+		}
+		col.count("cases")
+	})
+}
diff --git a/hegel/hegel_zoo_oracle_test.go b/hegel/hegel_zoo_oracle_test.go
new file mode 100644
index 0000000..aae8ef9
--- /dev/null
+++ b/hegel/hegel_zoo_oracle_test.go
@@ -0,0 +1,448 @@
+package hegel
+
+// The NumPy/SciPy oracle: a python3 subprocess speaking JSON lines. Floats travel as strings
+// (Go's shortest round-trip formatting, Python's repr) so that every double, NaN and infinity
+// survives the trip exactly.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"testing"
+)
+
+const hzOracleScript = `
+import sys, json, math, warnings
+import numpy as np
+from scipy import stats as st
+from scipy.spatial import distance as sd
+from scipy.special import softmax
+warnings.simplefilter("ignore")
+
+def f(s):
+    return float(s)
+
+def arr(xs):
+    return np.array([f(s) for s in xs], dtype=float)
+
+def out(v):
+    if isinstance(v, (list, tuple, np.ndarray)):
+        return [out(x) for x in v]
+    if isinstance(v, (bool, np.bool_)):
+        return bool(v)
+    if isinstance(v, (int, np.integer)):
+        return int(v)
+    return repr(float(v))
+
+def const(x):
+    return bool(np.all(x == x[0]))
+
+def quartiles(s):
+    n = len(s)
+    q1 = np.median(s[: n // 2])
+    q3 = np.median(s[(n + 1) // 2 :])
+    return q1, np.median(s), q3
+
+def mode(s):
+    # every value of the greatest count, ascending; none when every value is unique or
+    # every distinct value has the same count (the library's convention, see README)
+    if len(s) == 1:
+        return list(s)
+    vals, counts = np.unique(s, return_counts=True)
+    m = counts.max()
+    if m == 1 or (np.all(counts == m) and m != len(s)):
+        return []
+    return [v for v, c in zip(vals, counts) if c == m]
+
+def single(req):
+    x = arr(req["x"])
+    n = len(x)
+    s = np.sort(x)
+    r = {}
+    r["sum"] = np.sum(x)
+    r["mean"] = np.mean(x)
+    r["median"] = np.median(x)
+    r["min"] = np.min(x)
+    r["max"] = np.max(x)
+    r["argmax"] = int(np.argmax(x))
+    r["argmin"] = int(np.argmin(x))
+    r["range"] = np.max(x) - np.min(x)
+    r["var"] = np.var(x)
+    r["std"] = np.std(x)
+    if n >= 2:
+        r["svar"] = np.var(x, ddof=1)
+        r["sstd"] = np.std(x, ddof=1)
+        r["sem"] = st.sem(x)
+        q1, q2, q3 = quartiles(s)
+        r["q"] = [q1, q2, q3]
+        r["skew"] = st.skew(x)
+        r["kurt"] = st.kurtosis(x)
+        if np.mean(x) != 0:
+            r["cv"] = st.variation(x, ddof=1)
+        if not const(x):
+            r["zscore"] = st.zscore(x, ddof=1)
+        iqr = q3 - q1
+        mild, extreme = [], []
+        for v in s:
+            if v < q1 - 3 * iqr or v > q3 + 3 * iqr:
+                extreme.append(v)
+            elif v < q1 - 1.5 * iqr or v > q3 + 1.5 * iqr:
+                mild.append(v)
+        r["outliers"] = [mild, extreme]
+    if n >= 3:
+        r["sskew"] = st.skew(x, bias=False)
+    if n >= 4:
+        r["skurt"] = st.kurtosis(x, bias=False)
+    r["mad"] = np.median(np.abs(x - np.median(x)))
+    r["mode"] = mode(s)
+    r["pct"] = [np.percentile(x, p) for p in req["pct"]]
+    r["pnr"] = [np.percentile(x, p, method="inverted_cdf") for p in req["pct"]]
+    r["cumsum"] = np.cumsum(x)
+    r["cumprod"] = np.cumprod(x)
+    r["cummax"] = np.maximum.accumulate(x)
+    r["cummin"] = np.minimum.accumulate(x)
+    r["diff"] = np.diff(x)
+    with np.errstate(all="ignore"):
+        r["pctchange"] = np.diff(x) / x[:-1]
+    if not const(x):
+        r["rescale"] = (x - np.min(x)) / (np.max(x) - np.min(x))
+    r["rms"] = np.sqrt(np.mean(x * x))
+    r["prod"] = np.prod(x)
+    if np.all(x > 0):
+        r["gmean"] = st.gmean(x)
+        r["hmean"] = st.hmean(x)
+    if np.all(x >= 0) and np.sum(x) > 0:
+        r["entropy"] = st.entropy(x)
+    r["softmax"] = softmax(x)
+    r["sigmoid"] = 1 / (1 + np.exp(-x))
+    r["rank"] = st.rankdata(x)
+    bins = req["bins"]
+    try:
+        counts, edges = np.histogram(x, bins)
+        r["histc"] = [int(c) for c in counts]
+        r["histe"] = edges
+    except ValueError:
+        pass  # bins narrower than the spacing of doubles at the data's magnitude
+    r["pos"] = st.percentileofscore(x, f(req["score"]), kind="mean")
+    w = f(req["trim"])
+    r["winsor"] = np.asarray(st.mstats.winsorize(x, limits=(w, w)))
+    r["trimmed"] = st.trim_mean(x, w)
+    lo, hi = f(req["clip"][0]), f(req["clip"][1])
+    r["clip"] = np.clip(x, lo, hi)
+    k = req["window"]
+    if 1 <= k <= n:
+        win = np.lib.stride_tricks.sliding_window_view(x, k)
+        r["mmedian"] = np.median(win, axis=1)
+        r["mmin"] = np.min(win, axis=1)
+        r["mmax"] = np.max(win, axis=1)
+        r["msum"] = np.sum(win, axis=1)
+        r["mmean"] = np.mean(win, axis=1)
+        if k >= 2:
+            r["mstd"] = np.std(win, axis=1, ddof=1)
+    a = f(req["alpha"])
+    e = [x[0]]
+    for v in x[1:]:
+        e.append(a * v + (1 - a) * e[-1])
+    r["ewma"] = e
+    d = x - np.mean(x)
+    den = np.dot(d, d)
+    lag = req["lag"]
+    if not const(x) and den != 0 and 0 <= lag < n:
+        r["autocorr"] = np.dot(d[lag:], d[: n - lag]) / den
+    return r
+
+def pair(req):
+    x = arr(req["x"])
+    y = arr(req["y"])
+    n = len(x)
+    r = {}
+    r["covp"] = np.cov(x, y, bias=True)[0, 1] if n >= 1 else float("nan")
+    if n >= 2:
+        r["cov"] = np.cov(x, y)[0, 1]
+        if not const(x) and not const(y):
+            r["corr"] = np.corrcoef(x, y)[0, 1]
+            r["spearman"] = st.spearmanr(x, y).statistic
+        r["kendall"] = st.kendalltau(x, y).statistic
+    r["chebyshev"] = sd.chebyshev(x, y)
+    r["euclidean"] = sd.euclidean(x, y)
+    r["manhattan"] = sd.cityblock(x, y)
+    lam = f(req["lambda"])
+    r["minkowski"] = sd.minkowski(x, y, p=lam)
+    w = arr(req["w"])
+    if np.sum(w) > 0:
+        r["wmean"] = np.average(x, weights=w)
+        # weighted inverse CDF: the smallest value whose cumulative weight reaches p% of the total
+        order = np.argsort(x, kind="stable")
+        cum = np.cumsum(w[order])
+        target = f(req["wpct"]) / 100 * np.sum(w)
+        idx = int(np.searchsorted(cum, target, side="left"))
+        if idx >= n:
+            idx = n - 1
+        r["wpct"] = x[order][idx]
+    if n >= 2 and not const(x):
+        r["linreg"] = np.polyval(np.polyfit(x, y, 1), x)
+        if np.all(y > 0):
+            c = np.polyfit(x, np.log(y), 1, w=np.sqrt(y))
+            r["expreg"] = np.exp(np.polyval(c, x))
+        if np.all(x > 0) and np.std(np.log(x)) != 0:
+            r["logreg"] = np.polyval(np.polyfit(np.log(x), y, 1), np.log(x))
+    pm = f(req["popmean"])
+    if n >= 2 and not const(x):
+        t = st.ttest_1samp(x, pm)
+        r["ttest1"] = [t.statistic, t.pvalue]
+    if n >= 2 and not (const(x) and const(y)):
+        t = st.ttest_ind(x, y)
+        r["ttest2"] = [t.statistic, t.pvalue]
+    psd = f(req["popsd"])
+    if psd > 0:
+        z = (np.mean(x) - pm) / (psd / math.sqrt(n))
+        r["ztest1"] = [z, 2 * st.norm.sf(abs(z))]
+        z = (np.mean(x) - np.mean(y)) / (psd * math.sqrt(1 / n + 1 / n))
+        r["ztest2"] = [z, 2 * st.norm.sf(abs(z))]
+    xp = np.sort(np.unique(x))
+    if len(xp) >= 1:
+        fp = y[: len(xp)]
+        r["interp_xp"] = xp
+        r["interp_fp"] = fp
+        r["interp"] = np.interp(arr(req["at"]), xp, fp)
+    return r
+
+def norm(req):
+    x = f(req["x"])
+    p = f(req["p"])
+    loc = f(req["loc"])
+    scale = f(req["scale"])
+    d = st.norm(loc, scale)
+    r = {}
+    r["pdf"] = d.pdf(x)
+    r["logpdf"] = d.logpdf(x)
+    r["cdf"] = d.cdf(x)
+    r["logcdf"] = d.logcdf(x)
+    r["sf"] = d.sf(x)
+    r["logsf"] = d.logsf(x)
+    r["ppf"] = d.ppf(p)
+    r["isf"] = d.isf(p)
+    r["interval"] = list(d.interval(p))
+    r["entropy"] = d.entropy()
+    r["stats"] = list(d.stats(moments="mvsk"))
+    r["moment"] = d.moment(req["n"])
+    data = arr(req["data"])
+    if len(data) > 0:
+        r["fit"] = list(st.norm.fit(data))
+    return r
+
+ops = {"single": single, "pair": pair, "norm": norm}
+for line in sys.stdin:
+    try:
+        req = json.loads(line)
+        res = ops[req["op"]](req)
+        sys.stdout.write(json.dumps({"ok": {k: out(v) for k, v in res.items()}}) + "\n")
+    except Exception as e:  # noqa
+        sys.stdout.write(json.dumps({"error": repr(e)}) + "\n")
+    sys.stdout.flush()
+`
+
+type hzOracle struct {
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Reader
+}
+
+func hzStartOracle(t *testing.T) *hzOracle {
+	t.Helper()
+	dir := t.TempDir()
+	script := filepath.Join(dir, "oracle.py")
+	if err := os.WriteFile(script, []byte(hzOracleScript), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("python3", script)
+	cmd.Stderr = os.Stderr
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting python3: %v", err)
+	}
+	o := &hzOracle{cmd: cmd, in: bufio.NewWriter(stdin), out: bufio.NewReaderSize(stdout, 1<<22)}
+	t.Cleanup(func() {
+		stdin.Close()
+		cmd.Wait()
+	})
+	return o
+}
+
+// hzReply is one oracle answer: a name to a float, an int, a bool, a list of floats or a list
+// of lists.
+type hzReply map[string]json.RawMessage
+
+func (o *hzOracle) call(req map[string]any) (hzReply, error) {
+	b, err := json.Marshal(req)
+	if err != nil {
+		return nil, err
+	}
+	o.in.Write(b)
+	o.in.WriteByte('\n')
+	if err := o.in.Flush(); err != nil {
+		return nil, err
+	}
+	line, err := o.out.ReadBytes('\n')
+	if err != nil {
+		return nil, fmt.Errorf("oracle: %v", err)
+	}
+	var r struct {
+		OK    hzReply `json:"ok"`
+		Error string  `json:"error"`
+	}
+	if err := json.Unmarshal(line, &r); err != nil {
+		return nil, fmt.Errorf("oracle reply %q: %v", line, err)
+	}
+	if r.Error != "" {
+		return nil, fmt.Errorf("oracle: %s", r.Error)
+	}
+	return r.OK, nil
+}
+
+func (r hzReply) has(name string) bool { _, ok := r[name]; return ok }
+
+func (r hzReply) float(name string) float64 {
+	var s string
+	if err := json.Unmarshal(r[name], &s); err != nil {
+		panic(fmt.Sprintf("oracle %s: %v", name, err))
+	}
+	return hzParse(s)
+}
+
+func (r hzReply) int(name string) int {
+	var v int
+	if err := json.Unmarshal(r[name], &v); err != nil {
+		panic(fmt.Sprintf("oracle %s: %v", name, err))
+	}
+	return v
+}
+
+func (r hzReply) floats(name string) []float64 {
+	var ss []string
+	if err := json.Unmarshal(r[name], &ss); err != nil {
+		panic(fmt.Sprintf("oracle %s: %v", name, err))
+	}
+	out := make([]float64, len(ss))
+	for i, s := range ss {
+		out[i] = hzParse(s)
+	}
+	return out
+}
+
+func (r hzReply) lists(name string) [][]float64 {
+	var ss [][]string
+	if err := json.Unmarshal(r[name], &ss); err != nil {
+		panic(fmt.Sprintf("oracle %s: %v", name, err))
+	}
+	out := make([][]float64, len(ss))
+	for i, l := range ss {
+		out[i] = make([]float64, len(l))
+		for j, s := range l {
+			out[i][j] = hzParse(s)
+		}
+	}
+	return out
+}
+
+func (r hzReply) ints(name string) []int {
+	var raw []json.RawMessage
+	if err := json.Unmarshal(r[name], &raw); err != nil {
+		panic(fmt.Sprintf("oracle %s: %v", name, err))
+	}
+	out := make([]int, len(raw))
+	for i, m := range raw {
+		if err := json.Unmarshal(m, &out[i]); err != nil {
+			panic(fmt.Sprintf("oracle %s: %v", name, err))
+		}
+	}
+	return out
+}
+
+// hzParse reads Python's repr of a float (and Go's own formatting).
+func hzParse(s string) float64 {
+	switch s {
+	case "nan", "NaN":
+		return math.NaN()
+	case "inf", "+Inf":
+		return math.Inf(1)
+	case "-inf", "-Inf":
+		return math.Inf(-1)
+	}
+	v, err := strconv.ParseFloat(s, 64)
+	if err != nil {
+		panic(fmt.Sprintf("oracle float %q: %v", s, err))
+	}
+	return v
+}
+
+func hzFmt(v float64) string { return strconv.FormatFloat(v, 'g', -1, 64) }
+
+func hzFmts(xs []float64) []string {
+	out := make([]string, len(xs))
+	for i, v := range xs {
+		out[i] = hzFmt(v)
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- comparison
+
+// hzClose: a and b agree within rtol of the larger magnitude plus atol; NaN agrees with NaN,
+// infinities with the same infinity.
+func hzClose(a, b, rtol, atol float64) bool {
+	if math.IsNaN(a) || math.IsNaN(b) {
+		return math.IsNaN(a) && math.IsNaN(b)
+	}
+	if math.IsInf(a, 0) || math.IsInf(b, 0) {
+		return a == b
+	}
+	d := math.Abs(a - b)
+	return d <= atol+rtol*math.Max(math.Abs(a), math.Abs(b))
+}
+
+func hzCloseAll(a, b []float64, rtol, atol float64) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if !hzClose(a[i], b[i], rtol, atol) {
+			return false
+		}
+	}
+	return true
+}
+
+// hzScale is the magnitude of a data set, the natural unit of an absolute tolerance on sums,
+// means and their like.
+func hzScale(xs []float64) float64 {
+	m := 0.0
+	for _, v := range xs {
+		if a := math.Abs(v); a > m && !math.IsInf(a, 0) {
+			m = a
+		}
+	}
+	if m == 0 {
+		return 1
+	}
+	return m
+}
+
+func hzShow(xs []float64) string {
+	if len(xs) > 12 {
+		return fmt.Sprintf("%v ... (%d values)", xs[:12], len(xs))
+	}
+	return fmt.Sprintf("%v", xs)
+}
