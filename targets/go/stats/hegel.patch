+package hegel
+
+// TestHegelPair: the functions of two series (covariance and correlations, distances, weighted
+// statistics, regressions, tests, interpolation) against NumPy and SciPy.
+
+import (
+	"math"
+	"sort"
+	"testing"
+
+	"github.com/montanaflynn/stats"
+	"hegel.dev/go/hegel"
+)
+
+func hzAllEqual(xs []float64) bool {
+	for _, v := range xs {
+		if v != xs[0] {
+			return false
+		}
+	}
+	return true
+}
+
+func hzAllPositive(xs []float64) bool {
+	for _, v := range xs {
+		if !(v > 0) {
+			return false
+		}
+	}
+	return true
+}
+
+// hzNoisyConstant: the series is constant but its mean does not come out exactly (see
+// constantNoise).
+func hzNoisyConstant(xs []float64) bool {
+	if !hzAllEqual(xs) {
+		return false
+	}
+	m, _ := stats.Mean(xs)
+	return m != xs[0]
+}
+
+// hzNearConstant: not constant, but varying by less than a billionth of its magnitude.
+func hzNearConstant(xs []float64) bool {
+	if hzAllEqual(xs) {
+		return false
+	}
+	sd, _ := stats.StandardDeviation(xs)
+	return sd < 1e-9*hzScale(xs)
+}
+
+// hzWeightBoundary: some cumulative weight (in ascending order of x) is within rounding of
+// the target weight, so that the summation order decides whether it reaches it.
+func hzWeightBoundary(x, w []float64, pct float64) bool {
+	idx := make([]int, len(x))
+	for i := range idx {
+		idx[i] = i
+	}
+	sort.SliceStable(idx, func(a, b int) bool { return x[idx[a]] < x[idx[b]] })
+	total := 0.0
+	for _, v := range w {
+		total += v
+	}
+	target := pct / 100 * total
+	cum := 0.0
+	for _, i := range idx {
+		cum += w[i]
+		if math.Abs(cum-target) <= 1e-9*total {
+			return true
+		}
+	}
+	return false
+}
+
+func TestHegelPair(t *testing.T) {
+	col := hzNewCollector(t)
+	oracle := hzStartOracle(t)
+	hzProperty(t, func(ht *hegel.T) {
+		n := hzGenLen(ht, 1)
+		if n > 60 {
+			n = 60
+		}
+		x := hzGenSeries(ht, n)
+		var y []float64
+		switch hzDrawInt(ht, 1, 4) {
+		case 1: // a linear image of x with noise: correlated
+			a, b := hzGenValue(ht, "dec"), hzGenValue(ht, "dec")
+			y = make([]float64, n)
+			for i, v := range x {
+				y[i] = a*v + b + hzGenValue(ht, "quarter")
+			}
+		case 2: // positive values, for the exponential regression
+			y = make([]float64, n)
+			for i := range y {
+				y[i] = hzGenValue(ht, "positive")
+			}
+		default:
+			y = hzGenSeries(ht, n)
+		}
+		if HZKnown.constantNoise && (hzNoisyConstant(x) || hzNoisyConstant(y)) {
+			hzAvoid("constantNoise")
+			return
+		}
+		if hzNearConstant(x) || hzNearConstant(y) {
+			// a series varying only in its last bits: every statistic of it is rounding noise
+			col.count("near-constant skipped")
+			return
+		}
+		// weights: small integers or tenths (whose sums depend on the order), some zero
+		w := make([]float64, n)
+		tenths := hzChance(ht, 50)
+		for i := range w {
+			if tenths {
+				w[i] = float64(hzDrawInt(ht, 0, 30)) / 10
+			} else {
+				w[i] = float64(hzDrawInt(ht, 0, 5))
+			}
+		}
+		if n > 1 && hzChance(ht, 30) {
+			w[hzDrawInt(ht, 0, n-1)] = 0
+		}
+		lambda := hzPick(ht, []float64{1, 1.5, 2, 3, 4, 10})
+		wpct := hzGenPercent(ht)
+		if hzChance(ht, 20) {
