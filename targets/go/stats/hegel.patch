+			_, err = stats.PercentileWeighted(x, w, wpct)
+			wantErr("PercentileWeighted", err, stats.ErrBounds)
+		}
+
+		// regressions: the fitted values at the given abscissae
+		series := make(stats.Series, n)
+		for i := range series {
+			series[i] = stats.Coordinate{X: x[i], Y: y[i]}
+		}
+		fitted := func(name string, got stats.Series, err error, want []float64, tol float64) {
+			if err != nil {
