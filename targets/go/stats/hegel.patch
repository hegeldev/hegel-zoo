+		scalar("EuclideanDistance", v, err, r.float("euclidean"), 1e-9*(sx+sy))
+		v, err = stats.ManhattanDistance(x, y)
+		scalar("ManhattanDistance", v, err, r.float("manhattan"), 1e-9*(sx+sy))
+		v, err = stats.MinkowskiDistance(x, y, lambda)
+		if math.IsInf(r.float("minkowski"), 0) {
