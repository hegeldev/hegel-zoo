diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..ef9e3e1
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,205 @@
+package brotli_test
+
+// Pins for the bugs in bugs.toml. Each asserts the correct behaviour and is listed as an
+// expected failure in target.toml: it fails while the bug exists and passes, unexpectedly,
+// once the bug is fixed (which is the signal to drop the Known switch and the entry).
+
+import (
+	"bytes"
+	"compress/flate"
+	"io"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/andybalholm/brotli"
+	bflate "github.com/andybalholm/brotli/flate"
+	"github.com/andybalholm/brotli/matchfinder"
+)
+
+// brotli/1
+func TestHegelPinFlateWriterHandlesLongMatches(t *testing.T) {
+	for _, level := range []int{1, 6, 9} {
+		var buf bytes.Buffer
+		w := bflate.NewWriter(&buf, level)
+		data := make([]byte, 1000) // one 1000-byte run: a match longer than 258 bytes
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Fatalf("level %d: flate.NewWriter panics on 1000 zero bytes: %v", level, r)
+				}
+			}()
+			if _, err := w.Write(data); err != nil {
+				t.Fatalf("level %d: Write: %v", level, err)
+			}
+			if err := w.Close(); err != nil {
+				t.Fatalf("level %d: Close: %v", level, err)
+			}
+		}()
+		got, err := io.ReadAll(flate.NewReader(bytes.NewReader(buf.Bytes())))
+		if err != nil || !bytes.Equal(got, data) {
+			t.Fatalf("level %d: the stream decodes to %d bytes, %v; want %d", level, len(got), err, len(data))
+		}
+	}
+}
+
+// brotli/2
+func TestHegelPinAcceptEncodingIsCaseInsensitive(t *testing.T) {
+	for _, h := range []string{"BR", "Br", "GZIP", "gzip, BR;q=1"} {
+		req := httptest.NewRequest("GET", "/", nil)
+		req.Header.Set("Accept-Encoding", h)
+		rec := httptest.NewRecorder()
+		wc := brotli.HTTPCompressor(rec, req)
+		wc.Write([]byte("hello"))
+		wc.Close()
+		want := "br"
+		if h == "GZIP" {
+			want = "gzip"
+		}
+		if got := rec.Header().Get("Content-Encoding"); got != want {
+			t.Errorf("Accept-Encoding %q: Content-Encoding %q, want %q (content codings are case-insensitive, RFC 9110 section 8.4.1)", h, got, want)
+		}
+	}
+}
+
+// brotli/3
+func TestHegelPinStarDoesNotOverrideAListedCoding(t *testing.T) {
+	// br is listed with a lower weight (or refused); "*" gives gzip weight 1.
+	for _, h := range []string{"br;q=0.5, *", "br;q=0, *", "*, br;q=0.5"} {
+		req := httptest.NewRequest("GET", "/", nil)
+		req.Header.Set("Accept-Encoding", h)
+		rec := httptest.NewRecorder()
+		wc := brotli.HTTPCompressor(rec, req)
+		wc.Write([]byte("hello"))
+		wc.Close()
+		if got := rec.Header().Get("Content-Encoding"); got != "gzip" {
+			t.Errorf("Accept-Encoding %q: Content-Encoding %q, want gzip (\"*\" applies only to codings not listed, RFC 9110 section 12.5.3)", h, got)
+		}
+	}
+}
+
+// brotli/4
+func TestHegelPinGzipClientsGetGzipAtEveryLevel(t *testing.T) {
+	for _, level := range []int{10, 11} {
+		req := httptest.NewRequest("GET", "/", nil)
+		req.Header.Set("Accept-Encoding", "gzip")
+		rec := httptest.NewRecorder()
+		wc := brotli.HTTPCompressorWithLevel(rec, req, level)
+		wc.Write([]byte("hello"))
+		wc.Close()
+		if got := rec.Header().Get("Content-Encoding"); got != "gzip" {
+			t.Errorf("level %d, Accept-Encoding gzip: Content-Encoding %q, want gzip", level, got)
+		}
+	}
+}
+
+// brotli/5
+func TestHegelPinFindMatchesAppendsWithoutReadingDst(t *testing.T) {
+	block := []byte("abcdefghij") // no repeats: no match is possible
+	for _, f := range []struct {
+		name string
+		mf   matchfinder.MatchFinder
+	}{{"M4", &matchfinder.M4{}}, {"Trio", &matchfinder.Trio{}}, {"ZM", &matchfinder.ZM{}}} {
+		// Accumulating the matches of two blocks in one slice, as the
+		// interface's "appends them to dst" invites.
+		dst := f.mf.FindMatches(nil, []byte("first block, nothing repeats"))
+		n := len(dst)
+		got := f.mf.FindMatches(dst, block)
+		for _, m := range got[n:] {
+			if m.Length > 0 {
+				t.Errorf("%s: a match in a block without repeats: %+v", f.name, m)
+			}
+			if m.Length > 0 && m.Distance <= 0 {
+				t.Errorf("%s: match with distance %d", f.name, m.Distance)
+			}
+		}
+	}
+}
+
+// brotli/6
+func TestHegelPinFastEncoderEncodesShortMatches(t *testing.T) {
+	cases := []struct {
+		block []byte
+		m     matchfinder.Match
+	}{
+		{[]byte("xccc"), matchfinder.Match{Unmatched: 1, Length: 3, Distance: 1}},
+		{[]byte("xxxxxxcc"), matchfinder.Match{Unmatched: 6, Length: 2, Distance: 1}},
+		{[]byte("xxxxxxccc"), matchfinder.Match{Unmatched: 6, Length: 3, Distance: 1}},
+	}
+	for _, c := range cases {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("FastEncoder panics on %q %+v: %v", c.block, c.m, r)
+				}
+			}()
+			e := &brotli.FastEncoder{}
+			stream := e.Encode(nil, c.block, []matchfinder.Match{c.m}, true)
+			got, err := io.ReadAll(brotli.NewReader(bytes.NewReader(stream)))
+			if err != nil || !bytes.Equal(got, c.block) {
+				t.Errorf("FastEncoder on %q %+v: the stream decodes to %q, %v", c.block, c.m, got, err)
+			}
+		}()
+	}
+}
+
+// brotli/7
+func TestHegelPinResetAfterTrailingDataRecovers(t *testing.T) {
+	data := bytes.Repeat([]byte("hello world "), 20)
+	var buf bytes.Buffer
+	w := brotli.NewWriterLevel(&buf, 5)
+	w.Write(data)
+	w.Close()
+	good := buf.Bytes()
+	withTrailer := append(append([]byte(nil), good...), 1, 2, 3)
+	r := brotli.NewReader(bytes.NewReader(withTrailer))
+	if _, err := io.ReadAll(r); err == nil {
+		t.Fatalf("trailing bytes were not reported")
+	}
+	if err := r.Reset(bytes.NewReader(good)); err != nil {
+		t.Fatalf("Reset: %v", err)
+	}
+	got, err := io.ReadAll(r)
+	if err != nil || !bytes.Equal(got, data) {
+		t.Fatalf("after trailing data and Reset, a good stream decodes to %d bytes, %v; want %d (Reset is documented to make the Reader equivalent to a new one)", len(got), err, len(data))
+	}
+}
+
+// brotli/8
+func TestHegelPinShortBlocksStayInTheHistory(t *testing.T) {
+	// A block, a short block, then a block repeating the first: the repeat
+	// is 24 bytes back, not 20.
+	blocks := [][]byte{[]byte("Dthe light rays and "), []byte("the "), []byte("Dthe light rays and the D")}
+	for _, f := range []struct {
+		name string
+		mf   matchfinder.MatchFinder
+	}{{"Trio", &matchfinder.Trio{}}, {"ZM", &matchfinder.ZM{}}} {
+		var all []byte
+		for i, block := range blocks {
+			ms := f.mf.FindMatches(nil, block)
+			all = append(all, block...)
+			pos := len(all) - len(block)
+			for _, m := range ms {
+				pos += m.Unmatched
+				for k := 0; k < m.Length; k++ {
+					if m.Distance <= 0 || pos+k-m.Distance < 0 || all[pos+k] != all[pos+k-m.Distance] {
+						t.Errorf("%s block %d: match %+v copies the wrong bytes", f.name, i, m)
+						break
+					}
+				}
+				pos += m.Length
+			}
+		}
+		// The same through a matchfinder.Writer with one block per Write.
+		var buf bytes.Buffer
+		w := &matchfinder.Writer{Dest: &buf, MatchFinder: f.mf, Encoder: &brotli.Encoder{}}
+		f.mf.Reset()
+		for _, block := range blocks {
+			w.Write(block)
+		}
+		w.Close()
+		got, err := io.ReadAll(brotli.NewReader(bytes.NewReader(buf.Bytes())))
+		if err != nil || !bytes.Equal(got, all) {
+			t.Errorf("%s in a Writer with one block per Write: the stream decodes to %q, %v; want %q", f.name, got, err, all)
+		}
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..e544821
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,437 @@
+package brotli_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape
+// region with random contents, judged by the oracle of the wide property that
+// found it, so that each bug has a property that finds it every run (the wide
+// properties in hegel_test.go reach the shapes at their natural rate). Under
+// HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch
+// instead (a repeat that fits a 258-byte match, lower-case codings, a "*" no
+// heavier than the listed br, levels up to 9, the finders that do not read
+// dst, matches of four bytes or more, a truncated stream before Reset, a
+// block of 20 bytes or more) and passes.
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"math/rand"
+	"strings"
+	"testing"
+
+	"github.com/andybalholm/brotli"
+	bflate "github.com/andybalholm/brotli/flate"
+	"github.com/andybalholm/brotli/matchfinder"
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- brotli/1
+
+// longRepeatCase: a flate or gzip writer at a level, given random bytes
+// around a repeat: a run of one byte, or a random segment written twice,
+// of length bytes, so the matchfinder returns a match about length bytes
+// long. Under HEGEL_NO_KNOWN=1 the repeat is at most 200 bytes, within
+// DEFLATE's 258-byte maximum match.
+type longRepeatCase struct {
+	gzip           bool
+	level          int
+	run            bool
+	length         int
+	prefix, suffix []byte
+	seed           int64
+}
+
+func (c longRepeatCase) GoString() string {
+	kind := "flate.NewWriter"
+	if c.gzip {
+		kind = "flate.NewGZIPWriter"
+	}
+	form := "random segment written twice"
+	if c.run {
+		form = "run of one byte"
+	}
+	return fmt.Sprintf("%s level %d: %d random bytes, a %d-byte %s, %d random bytes (seed %d)", kind, c.level, len(c.prefix), c.length, form, len(c.suffix), c.seed)
+}
+
+func (c longRepeatCase) shapes() []string { return shapeIf(c.length > 258, "brotli/1") }
+
+// bytes renders the data.
+func (c longRepeatCase) bytes() []byte {
+	r := rand.New(rand.NewSource(c.seed))
+	var repeat []byte
+	if c.run {
+		repeat = bytes.Repeat([]byte{byte(r.Intn(256))}, c.length)
+	} else {
+		segment := make([]byte, c.length)
+		r.Read(segment)
+		repeat = append(segment, segment...)
+	}
+	return append(append(append([]byte(nil), c.prefix...), repeat...), c.suffix...)
+}
+
+var (
+	// repeatLengths: over 258 bytes (brotli/1), or under HEGEL_NO_KNOWN=1 at most 200.
+	repeatLengths   = shaped(hegel.Integers(300, 3000), hegel.Integers(1, 200))
+	longRepeatCases = hegel.Composite(func(tc hegel.TestCase) longRepeatCase {
+		return longRepeatCase{
+			gzip:   hegel.Draw(tc, chance(50)),
+			level:  hegel.Draw(tc, writerLevels),
+			run:    hegel.Draw(tc, chance(50)),
+			length: hegel.Draw(tc, repeatLengths),
+			prefix: hegel.Draw(tc, hegel.Binary(0, 64)),
+			suffix: hegel.Draw(tc, hegel.Binary(0, 64)),
+			seed:   hegel.Draw(tc, seeds),
+		}
+	})
+)
+
+// TestHegelFlateWritersSplitLongMatches: a flate or gzip writer given a repeat
+// longer than DEFLATE's 258-byte maximum match writes a stream the standard
+// library decodes to the data, splitting the match as compress/flate does;
+// the flate encoder panics with "match too long" instead (brotli/1).
+func TestHegelFlateWritersSplitLongMatches(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, longRepeatCases)
+		begin(c)
+		data := c.bytes()
+		var buf bytes.Buffer
+		kind := "flate"
+		w := bflate.NewWriter(&buf, c.level)
+		if c.gzip {
+			kind = "gzip"
+			w = bflate.NewGZIPWriter(&buf, c.level)
+		}
+		if _, err := w.Write(data); err != nil {
+			mismatch(ht, "Write: %v", err)
+		}
+		if err := w.Close(); err != nil {
+			mismatch(ht, "Close: %v", err)
+		}
+		got, err := decodeStream(ht, kind, buf.Bytes(), decodeSpec{}, data)
+		if err != nil {
+			mismatch(ht, "the standard library rejects the %s writer's stream: %v", kind, err)
+		}
+		if !bytes.Equal(got, data) {
+			mismatch(ht, "the %s writer's stream decodes to %d bytes, want %d", kind, len(got), len(data))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- the Accept-Encoding shapes
+
+// withCase writes the coding with the letters of the mask in upper case.
+func withCase(coding string, mask int) string {
+	b := []byte(coding)
+	for i := range b {
+		if mask&(1<<i) != 0 {
+			b[i] = strings.ToUpper(string(b[i]))[0]
+		}
+	}
+	return string(b)
+}
+
+var (
+	// otherCodings: the codings that are neither offer nor "*".
+	otherCodings = hegel.SampledFrom([]string{"identity", "deflate", "zstd", "x-br"})
+	// otherEntries: an entry of another coding with a valid weight (an odd
+	// weight would leave the model without a verdict).
+	otherEntries = entriesOf(otherCodings, weightsOf(validQs))
+	// positiveWeights: a weight that makes a coding acceptable.
+	positiveWeights = weightsOf(hegel.SampledFrom([]string{"1", "0.5", "0.9", "1.0", "0.75", "0.1"}))
+)
+
+// lineWith: a header line of up to three other entries with the special
+// entries inserted at drawn positions (modulo the live length), in order.
+func lineWith(specials hegel.Generator[[]acceptEntry]) hegel.Generator[acceptLine] {
+	return hegel.Composite(func(tc hegel.TestCase) acceptLine {
+		entries := hegel.Draw(tc, many(otherEntries, 0, 3))
+		for _, e := range hegel.Draw(tc, specials) {
+			at := hegel.Draw(tc, positions) % (len(entries) + 1)
+			entries = append(entries[:at], append([]acceptEntry{e}, entries[at:]...)...)
+		}
+		return acceptLine{entries: entries, sep: hegel.Draw(tc, listSeps)}
+	})
+}
+
+// oneLine: a request with one header line.
+func oneLine(line hegel.Generator[acceptLine]) hegel.Generator[[]acceptLine] { return many(line, 1, 1) }
+
+// --------------------------------------------------------------------------- brotli/2
+
+// casedOffers: br or gzip with at least one upper-case letter (brotli/2); under
+// HEGEL_NO_KNOWN=1 in lower case.
+var casedOffers = hegel.FlatMap(hegel.SampledFrom([]string{"br", "gzip"}), func(coding string) hegel.Generator[string] {
+	return hegel.Map(shaped(hegel.Integers(1, 1<<len(coding)-1), hegel.Just(0)), func(mask int) string { return withCase(coding, mask) })
+})
+
+// casedOfferCases: the cased offer, acceptable, as the only br or gzip of the
+// header, so the RFC's choice is that offer.
+var casedOfferCases = httpCasesOf(oneLine(lineWith(many(entriesOf(casedOffers, positiveWeights), 1, 1))), hegel.Integers(0, 9), 30)
+
+// TestHegelContentCodingsMatchInAnyCase: a br or gzip written in upper or
+// mixed case is the coding it names (content codings are case-insensitive,
+// RFC 9110 section 8.4.1), so the response is compressed with it;
+// HTTPCompressor compares the spelling and sends identity (brotli/2).
+func TestHegelContentCodingsMatchInAnyCase(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, casedOfferCases)
+		begin(c)
+		checkNegotiation(ht, c)
+	})
+}
+
+// --------------------------------------------------------------------------- brotli/3
+
+var (
+	// lowWeights: a br weight below the "*"'s (brotli/3); under HEGEL_NO_KNOWN=1
+	// a full weight.
+	lowWeights = shaped(hegel.SampledFrom([]string{"0", "0.1", "0.5", "0.9"}), hegel.SampledFrom([]string{"", "1", "1.0"}))
+	// starWeights: a "*" of weight 1 (brotli/3); under HEGEL_NO_KNOWN=1 at most
+	// the br's.
+	starWeights = shaped(hegel.SampledFrom([]string{"", "1", "1.0"}), hegel.SampledFrom([]string{"", "1", "0.5", "0"}))
+	// starPairs: a listed br and a "*".
+	starPairs = hegel.Composite(func(tc hegel.TestCase) []acceptEntry {
+		return []acceptEntry{
+			{coding: "br", q: hegel.Draw(tc, lowWeights), sep: hegel.Draw(tc, qSeps)},
+			{coding: "*", q: hegel.Draw(tc, starWeights), sep: hegel.Draw(tc, qSeps)},
+		}
+	})
+	starCases = httpCasesOf(oneLine(lineWith(starPairs)), hegel.Integers(0, 9), 30)
+)
+
+// TestHegelStarDoesNotOutweighAListedBr: a "*" sets the weight of the codings
+// not listed (RFC 9110 section 12.5.3), so with br listed below the "*"'s
+// weight gzip wins; HTTPCompressor gives br the "*"'s weight too and br wins
+// the tie as the first offer (brotli/3).
+func TestHegelStarDoesNotOutweighAListedBr(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, starCases)
+		begin(c)
+		checkNegotiation(ht, c)
+	})
+}
+
+// --------------------------------------------------------------------------- brotli/4
+
+var (
+	// highLevels: 10 or 11 (brotli/4); under HEGEL_NO_KNOWN=1 0 to 9.
+	highLevels = shaped(hegel.SampledFrom([]int{10, 11}), hegel.Integers(0, 9))
+	// gzipOnlyCases: a client accepting gzip (and other codings, but not br)
+	// at a high level.
+	gzipOnlyCases = httpCasesOf(oneLine(lineWith(many(entriesOf(hegel.Just("gzip"), positiveWeights), 1, 1))), highLevels, 0)
+)
+
+// TestHegelGzipOnlyClientsGetGzipAtHighLevels: a client accepting gzip and
+// not br gets a gzip response at every level of the helper's 0-11 scale;
+// HTTPCompressorWithLevel hands levels 10 and 11 to gzip.NewWriterLevel,
+// which rejects them, and sends identity (brotli/4).
+func TestHegelGzipOnlyClientsGetGzipAtHighLevels(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, gzipOnlyCases)
+		begin(c)
+		checkNegotiation(ht, c)
+	})
+}
+
+// --------------------------------------------------------------------------- brotli/5
+
+var (
+	// dstReaders: the finders that take their previous match from dst
+	// (brotli/5); under HEGEL_NO_KNOWN=1 the finders that do not.
+	dstReaders = findersOf(shaped([]string{"M4", "AutoReset"}, []string{"Pathfinder", "Bargain1", "Bargain2", "Bargain3", "Trio", "ZFast", "ZDFast", "ZM"})...)
+	// dstCases: two or three non-empty blocks whose matches accumulate in dst
+	// (so every block after the first starts with dst ending in the previous
+	// block's literal-only Match), dst pre-filled half of the time.
+	dstCases = hegel.Composite(func(tc hegel.TestCase) lz77Case {
+		return lz77Case{
+			finder:  hegel.Draw(tc, dstReaders),
+			prefill: hegel.Draw(tc, maybe(50, many(matchEntries, 1, 5))),
+			keep:    true,
+			blocks:  hegel.Draw(tc, many(lz77BlocksOf(dataOf(hegel.Integers(1, 3000))), 2, 3)),
+		}
+	})
+)
+
+// TestHegelMatchFindersIgnoreThePreviousMatchesInDst: FindMatches appends to
+// dst whatever dst holds, so the matches of consecutive blocks accumulated in
+// one slice are valid LZ77 for each block; M4 reads the last entry of dst as
+// its previous match and returns distance-0 matches, or panics on a far
+// distance (brotli/5).
+func TestHegelMatchFindersIgnoreThePreviousMatchesInDst(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, dstCases)
+		begin(c)
+		checkLZ77(ht, c)
+	})
+}
+
+// --------------------------------------------------------------------------- brotli/6
+
+// shortMatchCase: a block of lit random literals, a match of length bytes at
+// distance (1 to lit), and tail random literals, encoded by the FastEncoder
+// as one final block.
+type shortMatchCase struct {
+	lit, length, distance, tail int
+	seed                        int64
+	decode                      decodeSpec
+}
+
+func (c shortMatchCase) GoString() string {
+	return fmt.Sprintf("FastEncoder: %d literals, a %d-byte match at distance %d, %d literals (seed %d), %s", c.lit, c.length, c.distance, c.tail, c.seed, c.decode.GoString())
+}
+
+func (c shortMatchCase) shapes() []string { return shapeIf(c.length < 4, "brotli/6") }
+
+// block renders the block and its matches.
+func (c shortMatchCase) block() ([]byte, []matchfinder.Match) {
+	r := rand.New(rand.NewSource(c.seed))
+	block := make([]byte, c.lit, c.lit+c.length+c.tail)
+	r.Read(block)
+	for k := 0; k < c.length; k++ {
+		block = append(block, block[len(block)-c.distance])
+	}
+	matches := []matchfinder.Match{{Unmatched: c.lit, Length: c.length, Distance: c.distance}}
+	if c.tail > 0 {
+		tail := make([]byte, c.tail)
+		r.Read(tail)
+		block = append(block, tail...)
+		matches = append(matches, matchfinder.Match{Unmatched: c.tail})
+	}
+	return block, matches
+}
+
+// shortMatches: the match length and the literals before it: a 3-byte match
+// after any literals, or a 2-byte match after six or more (brotli/6); under
+// HEGEL_NO_KNOWN=1 a match of 4 to 12 bytes.
+var shortMatches = hegel.FlatMap(shaped(hegel.SampledFrom([]int{3, 2}), hegel.Integers(4, 12)), func(length int) hegel.Generator[[2]int] {
+	lits := hegel.Integers(1, 30)
+	if length == 2 {
+		lits = hegel.Integers(6, 30)
+	}
+	return hegel.Map(lits, func(lit int) [2]int { return [2]int{length, lit} })
+})
+
+var shortMatchCases = hegel.Composite(func(tc hegel.TestCase) shortMatchCase {
+	m := hegel.Draw(tc, shortMatches)
+	return shortMatchCase{
+		lit:      m[1],
+		length:   m[0],
+		distance: 1 + hegel.Draw(tc, positions)%m[1],
+		tail:     hegel.Draw(tc, maybe(50, hegel.Integers(1, 20))),
+		seed:     hegel.Draw(tc, seeds),
+		decode:   hegel.Draw(tc, decodeSpecs),
+	}
+})
+
+// TestHegelFastEncoderEncodesTwoAndThreeByteMatches: brotli copy lengths
+// start at 2 and the Match contract has no minimum, so the FastEncoder given
+// a valid 2- or 3-byte match writes a stream the reference tool and the
+// Reader decode to the block; it writes a stream both reject for a 3-byte
+// match, and panics for a 2- or 3-byte match after six literals (brotli/6).
+func TestHegelFastEncoderEncodesTwoAndThreeByteMatches(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, shortMatchCases)
+		begin(c)
+		block, matches := c.block()
+		if msg := checkMatches(matches, nil, block, 0); msg != "" {
+			ht.Fatalf("harness: generated matches are invalid: %s", msg)
+		}
+		stream := (&brotli.FastEncoder{}).Encode(nil, block, matches, true)
+		got, err := decodeStream(ht, "brotli", stream, c.decode, block)
+		if err != nil {
+			mismatch(ht, "the reference tool rejects the FastEncoder's stream: %v", err)
+		}
+		if !bytes.Equal(got, block) {
+			mismatch(ht, "the FastEncoder's stream decodes to %d bytes, want %d", len(got), len(block))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- brotli/7
+
+// trailingCase: a valid stream with a damage before it is read, then Reset
+// onto the good stream: extra bytes after the stream (brotli/7), or under
+// HEGEL_NO_KNOWN=1 a truncation.
+type trailingCase struct {
+	data   dataSpec
+	source streamSource
+	dmg    damage
+}
+
+func (c trailingCase) GoString() string {
+	return fmt.Sprintf("%s of %s, %s, then Reset onto the good stream", c.source.GoString(), c.data.GoString(), c.dmg.GoString())
+}
+
+func (c trailingCase) shapes() []string { return shapeIf(c.dmg.kind == "append", "brotli/7") }
+
+var (
+	appendDamages   = hegel.Composite(func(tc hegel.TestCase) damage { return damage{kind: "append", extra: hegel.Draw(tc, trailers)} })
+	truncateDamages = hegel.Composite(func(tc hegel.TestCase) damage { return damage{kind: "truncate", at: hegel.Draw(tc, offsets)} })
+	trailingCases   = hegel.Composite(func(tc hegel.TestCase) trailingCase {
+		return trailingCase{
+			data:   hegel.Draw(tc, smallBlocks),
+			source: hegel.Draw(tc, streamSources),
+			dmg:    hegel.Draw(tc, shaped(appendDamages, truncateDamages)),
+		}
+	})
+)
+
+// TestHegelReaderResetRecoversFromTrailingBytes: Reset makes a Reader
+// equivalent to a new one (its documentation), so after a stream followed by
+// extra bytes (reported as excessive input) a Reset Reader decodes the good
+// stream; the leftover bytes stay in the Reader and the next stream fails
+// (brotli/7).
+func TestHegelReaderResetRecoversFromTrailingBytes(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, trailingCases)
+		begin(c)
+		data := c.data.bytes()
+		stream := c.source.stream(ht, data)
+		rd := brotli.NewReader(bytes.NewReader(c.dmg.apply(stream)))
+		_, firstErr := io.ReadAll(rd)
+		note(ht, "the damaged stream reads with error %v", firstErr)
+		if err := rd.Reset(bytes.NewReader(stream)); err != nil {
+			mismatch(ht, "Reset after the damaged stream: %v", err)
+		}
+		got, err := io.ReadAll(rd)
+		if err != nil || !bytes.Equal(got, data) {
+			mismatch(ht, "after the damaged stream and Reset, the good stream decodes to %d bytes, %v; want %d", len(got), err, len(data))
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- brotli/8
+
+// textOrRandom: bytes without long runs of one value, so a match at the
+// wrong distance copies wrong bytes.
+var textOrRandom = hegel.SampledFrom([][]string{{"random"}, {"text"}})
+
+// shortBlockCases: Trio or ZM given a block, a block under 20 (16) bytes
+// (brotli/8; under HEGEL_NO_KNOWN=1 20 to 40 bytes), and a block that echoes
+// the tail of the first two, so its matches reach back past the short one.
+var shortBlockCases = hegel.FlatMap(findersOf("Trio", "ZM"), func(f finderSpec) hegel.Generator[lz77Case] {
+	limit := 20
+	if f.name == "ZM" {
+		limit = 16
+	}
+	shortSizes := shaped(hegel.Integers(1, limit-1), hegel.Integers(20, 40))
+	return hegel.Composite(func(tc hegel.TestCase) lz77Case {
+		return lz77Case{finder: f, blocks: []lz77Block{
+			{data: hegel.Draw(tc, dataWith(hegel.Integers(20, 300), textOrRandom))},
+			{data: hegel.Draw(tc, dataWith(shortSizes, textOrRandom))},
+			{data: hegel.Draw(tc, dataWith(hegel.Integers(0, 50), textOrRandom)), echo: hegel.Draw(tc, hegel.Integers(60, 300))},
+		}}
+	})
+})
+
+// TestHegelShortBlocksStayInTheFindersHistory: a finder that refers to
+// earlier blocks measures its distances over every block it was given, so a
+// match reaching past a short block copies the right bytes; Trio and ZM
+// return a block under 20 (16) bytes as literals without adding it to their
+// history, and every later distance past it is short by its length (brotli/8).
+func TestHegelShortBlocksStayInTheFindersHistory(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, shortBlockCases)
+		begin(c)
+		checkLZ77(ht, c)
+	})
+}
