+// ---------------------------------------------------------------------------
+// Property 2: the Reader on the reference tool's streams.
+
+func TestHegelReaderDecodesReferenceStreams(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		rd := brotli.NewReader(bytes.NewReader(nil))
+		rounds := n(ht, 1, 3)
+		for i := 0; i < rounds; i++ {
+			quality := n(ht, 0, 11)
+			lgwin := pick(ht, 0, 0, 10, 12, 16, 18, 22, 24)
+			data := genData(ht, r, genSize(ht))
+			stream := toolCompress(ht, data, quality, lgwin)
+			note(ht, "round %d: tool -q %d -w %d: %d bytes", i, quality, lgwin, len(stream))
+			var src io.Reader = bytes.NewReader(stream)
+			if chance(ht, 60) {
+				src = newChunkReader(ht, r, stream)
+			}
+			if i == 0 && chance(ht, 50) {
+				rd = brotli.NewReader(src)
+			} else {
+				if err := rd.Reset(src); err != nil {
+					fail(ht, "Reset: %v", err)
+				}
+			}
+			var got []byte
+			var err error
+			switch pick(ht, "buffers", "copy", "readall") {
+			case "buffers":
+				bufSize := pick(ht, 1, 2, 7, 100, 4096, 32*1024, 1<<17)
+				note(ht, "buffer %d", bufSize)
+				got, err = readAllWith(rd, bufSize)
+			case "copy":
+				var out bytes.Buffer
+				_, err = io.Copy(&out, rd)
+				got = out.Bytes()
+			default:
+				got, err = io.ReadAll(rd)
+			}
+			if err != nil {
+				fail(ht, "the Reader fails on the tool's stream: %v", err)
+			}
+			if !bytes.Equal(got, data) {
+				fail(ht, "the Reader decodes the tool's stream to %d bytes, want %d", len(got), len(data))
+			}
+			// At the end, Read keeps returning (0, io.EOF).
+			m, err := rd.Read(make([]byte, 10))
+			if m != 0 || err != io.EOF {
+				fail(ht, "Read at the end = %d, %v", m, err)
+			}
+			// Read with an empty buffer is harmless.
+			if m, err := rd.Read(nil); m != 0 || (err != nil && err != io.EOF) {
+				fail(ht, "Read(nil) at the end = %d, %v", m, err)
+			}
+		}
+	})
+}
