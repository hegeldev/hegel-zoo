+// ---------------------------------------------------------------------------
+// The matchfinder package: LZ77 validity.
+
+type finderSpec struct {
+	name        string
+	mf          matchfinder.MatchFinder
+	maxDist     int  // the window the finder was told about (0: its default)
+	maxBlock    int  // the largest block it accepts (0: any)
+	crossBlocks bool // may refer to earlier blocks
+	minLength   int  // the shortest match it promises (0: unknown)
+	readsDst    bool // brotli/5: takes its previous match from dst
+	dropsShort  bool // brotli/8: leaves blocks under 20 bytes out of its history
+}
+
+func genFinder(ht *hegel.T) finderSpec {
+	dist := pick(ht, 0, 0, 64, 1000, 65535, 65536, 1<<20)
+	switch pick(ht, "M0", "M4", "Pathfinder", "Bargain1", "Bargain2", "Bargain3", "Trio", "ZFast", "ZDFast", "ZM", "None", "AutoReset") {
+	case "M0":
+		m := matchfinder.M0{Lazy: chance(ht, 50), MaxDistance: dist, MaxLength: pick(ht, 0, 0, 4, 100, 65536)}
+		note(ht, "M0 lazy %v maxdist %d maxlen %d", m.Lazy, m.MaxDistance, m.MaxLength)
+		return finderSpec{name: "M0", mf: m, maxDist: dist, maxBlock: 65536}
+	case "M4":
+		m := &matchfinder.M4{MaxDistance: dist, MinLength: pick(ht, 0, 0, 4, 5, 8), HashLen: pick(ht, 0, 0, 4, 5, 6, 8), TableBits: pick(ht, 0, 0, 10, 14), ChainLength: pick(ht, 0, 1, 8, 32), DistanceBitCost: pick(ht, 0, 0, 32, 66)}
+		note(ht, "M4 %+v", *m)
+		return finderSpec{name: "M4", mf: m, maxDist: dist, crossBlocks: true, readsDst: true}
+	case "Pathfinder":
+		m := &matchfinder.Pathfinder{MaxDistance: dist, MinLength: pick(ht, 0, 0, 4, 5, 8), HashLen: pick(ht, 0, 0, 4, 5, 6, 8), TableBits: pick(ht, 0, 0, 10, 14), ChainLength: pick(ht, 0, 1, 8, 32)}
+		note(ht, "Pathfinder %+v", *m)
+		return finderSpec{name: "Pathfinder", mf: m, maxDist: dist, crossBlocks: true}
+	case "Bargain1":
+		m := &matchfinder.Bargain1{MaxDistance: dist, Skip: chance(ht, 50)}
+		note(ht, "Bargain1 maxdist %d skip %v", dist, m.Skip)
+		return finderSpec{name: "Bargain1", mf: m, maxDist: dist, crossBlocks: true}
+	case "Bargain2":
+		m := &matchfinder.Bargain2{MaxDistance: dist, Skip: chance(ht, 50)}
+		note(ht, "Bargain2 maxdist %d skip %v", dist, m.Skip)
+		return finderSpec{name: "Bargain2", mf: m, maxDist: dist, crossBlocks: true}
+	case "Bargain3":
+		m := &matchfinder.Bargain3{MaxDistance: dist, Skip: chance(ht, 50)}
+		note(ht, "Bargain3 maxdist %d skip %v", dist, m.Skip)
+		return finderSpec{name: "Bargain3", mf: m, maxDist: dist, crossBlocks: true}
+	case "Trio":
+		m := &matchfinder.Trio{MaxDistance: dist}
+		note(ht, "Trio maxdist %d", dist)
+		return finderSpec{name: "Trio", mf: m, maxDist: dist, crossBlocks: true, dropsShort: true}
+	case "ZFast":
+		m := &matchfinder.ZFast{MaxDistance: dist}
+		note(ht, "ZFast maxdist %d", dist)
+		return finderSpec{name: "ZFast", mf: m, maxDist: dist, crossBlocks: true}
+	case "ZDFast":
+		m := &matchfinder.ZDFast{MaxDistance: dist}
+		note(ht, "ZDFast maxdist %d", dist)
+		return finderSpec{name: "ZDFast", mf: m, maxDist: dist, crossBlocks: true}
+	case "ZM":
+		m := &matchfinder.ZM{MaxDistance: dist}
+		note(ht, "ZM maxdist %d", dist)
+		return finderSpec{name: "ZM", mf: m, maxDist: dist, crossBlocks: true, dropsShort: true}
+	case "None":
+		note(ht, "NoMatchFinder")
+		return finderSpec{name: "None", mf: matchfinder.NoMatchFinder{}}
+	default:
+		inner := &matchfinder.M4{MaxDistance: dist}
+		note(ht, "AutoReset{M4 maxdist %d}", dist)
+		return finderSpec{name: "AutoReset", mf: matchfinder.AutoReset{MatchFinder: inner}, maxDist: dist, readsDst: true}
+	}
+}
+
+// checkMatches verifies the LZ77 contract of matches for block, given the
+// bytes history that preceded it in the stream (empty when the finder may not
+// refer to earlier blocks). It returns a description of the first violation.
+func checkMatches(matches []matchfinder.Match, history, block []byte, maxDist int) string {
+	pos := 0 // position in block
+	for i, m := range matches {
+		if m.Unmatched < 0 || m.Length < 0 {
+			return fmt.Sprintf("match %d has negative fields: %+v", i, m)
+		}
+		if m.Length == 0 && i != len(matches)-1 {
+			return fmt.Sprintf("match %d of %d has length 0 before the end: %+v", i, len(matches), m)
+		}
+		pos += m.Unmatched
+		if pos > len(block) {
+			return fmt.Sprintf("match %d runs past the block: literals reach %d of %d", i, pos, len(block))
+		}
+		if m.Length == 0 {
+			continue
+		}
+		if m.Distance <= 0 {
+			return fmt.Sprintf("match %d has distance %d", i, m.Distance)
+		}
+		if m.Distance > pos+len(history) {
+			return fmt.Sprintf("match %d at %d reaches %d bytes back with only %d bytes before it", i, pos, m.Distance, pos+len(history))
+		}
+		if maxDist > 0 && m.Distance > maxDist {
+			return fmt.Sprintf("match %d has distance %d over the window %d", i, m.Distance, maxDist)
+		}
+		if pos+m.Length > len(block) {
+			return fmt.Sprintf("match %d runs past the block: copy reaches %d of %d", i, pos+m.Length, len(block))
+		}
+		// The copied bytes must equal the bytes at the distance (overlap allowed).
+		all := append(append([]byte(nil), history...), block...)
+		base := len(history) + pos
+		for k := 0; k < m.Length; k++ {
+			if all[base+k] != all[base+k-m.Distance] {
+				return fmt.Sprintf("match %d (%+v) at %d copies wrong bytes: byte %d is %#x, source %#x", i, m, pos, k, all[base+k], all[base+k-m.Distance])
+			}
+		}
+		pos += m.Length
+	}
+	if pos != len(block) {
+		return fmt.Sprintf("matches cover %d of %d bytes", pos, len(block))
+	}
+	return ""
+}
+
+// Property 4: every MatchFinder's matches are valid LZ77.
+
+func TestHegelMatchFindersAreValidLZ77(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		spec := genFinder(ht)
+		blocks := n(ht, 1, 4)
+		var history []byte
+		var dst []matchfinder.Match
+		keep := false // accumulate the matches of every block in dst
+		if !(Known.previousMatchFromDst && spec.readsDst) {
+			if chance(ht, 30) {
+				dst = make([]matchfinder.Match, n(ht, 0, 5)) // FindMatches appends
+			}
+			keep = chance(ht, 40)
+		}
+		note(ht, "dst starts with %d entries, accumulates %v", len(dst), keep)
+		for b := 0; b < blocks; b++ {
+			size := genSize(ht)
+			if spec.maxBlock > 0 && size > spec.maxBlock {
+				size = spec.maxBlock
+			}
+			if Known.shortBlockDropped && spec.dropsShort && size < 20 && b < blocks-1 {
+				size = 20
+			}
+			block := genData(ht, r, size)
+			if chance(ht, 30) && len(history) > 0 {
+				// Make the block echo earlier data so cross-block matches appear.
+				k := min(len(history), n(ht, 1, 300))
+				block = append(append([]byte(nil), history[len(history)-k:]...), block...)
+				if spec.maxBlock > 0 && len(block) > spec.maxBlock {
+					block = block[:spec.maxBlock]
+				}
+			}
+			before := len(dst)
+			got := spec.mf.FindMatches(dst, block)
+			if len(got) < before || (before > 0 && !reflect.DeepEqual(got[:before], dst[:before])) {
+				fail(ht, "%s.FindMatches did not append to dst", spec.name)
+			}
+			matches := got[before:]
+			hist := history
+			if !spec.crossBlocks {
+				hist = nil
+			}
+			if msg := checkMatches(matches, hist, block, spec.maxDist); msg != "" {
+				fail(ht, "%s block %d (%d bytes, %d before it): %s", spec.name, b, len(block), len(history), msg)
+			}
+			history = append(history, block...)
+			dst = got[:0]
+			if keep {
+				dst = got
+			}
+			if chance(ht, 15) {
+				spec.mf.Reset()
+				history = nil
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------
+// Generated match sequences.
+
+// buildBlock makes a block of about size bytes whose LZ77 parse is the
+// returned matches: literal runs from r, and copies from the stream (history
+// then the block so far) at distances up to maxDist with lengths at least
+// minLen and up to maxLen, overlapping allowed.
+func buildBlock(r *rand.Rand, history []byte, size, minLen, maxLen, maxDist int) ([]byte, []matchfinder.Match) {
+	block := make([]byte, 0, size)
+	var matches []matchfinder.Match
+	for len(block) < size {
+		lit := r.Intn(min(size-len(block), 40) + 1)
+		if r.Intn(8) == 0 {
+			lit = min(size-len(block), r.Intn(3000))
+		}
+		for i := 0; i < lit; i++ {
+			block = append(block, byte(r.Intn(256)))
+		}
+		if len(block) >= size {
+			matches = append(matches, matchfinder.Match{Unmatched: lit})
+			break
+		}
+		avail := len(history) + len(block)
+		if avail == 0 {
+			// Nothing to copy from yet: one more literal.
+			block = append(block, byte(r.Intn(256)))
+			lit++
+			if len(block) >= size {
+				matches = append(matches, matchfinder.Match{Unmatched: lit})
+				break
+			}
+			avail = 1
+		}
+		dist := r.Intn(min(avail, maxDist)) + 1
+		if r.Intn(3) == 0 {
+			dist = r.Intn(min(avail, 8)) + 1
+		}
+		length := minLen + r.Intn(64)
+		if r.Intn(6) == 0 {
+			length = minLen + r.Intn(maxLen-minLen+1)
+		}
+		if length > size-len(block) {
+			length = size - len(block)
+		}
+		if length < minLen {
+			// Not enough room for a match: finish with literals.
+			for len(block) < size {
+				block = append(block, byte(r.Intn(256)))
+				lit++
+			}
+			matches = append(matches, matchfinder.Match{Unmatched: lit})
+			break
+		}
+		for k := 0; k < length; k++ {
+			p := len(block) - dist
+			var c byte
+			if p >= 0 {
+				c = block[p]
+			} else {
+				c = history[len(history)+p]
+			}
+			block = append(block, c)
+		}
+		matches = append(matches, matchfinder.Match{Unmatched: lit, Length: length, Distance: dist})
+	}
+	if len(matches) == 0 {
+		matches = append(matches, matchfinder.Match{})
+	}
+	return block, matches
+}
+
+// Property 5: the encoders turn any valid match sequence into a stream that
+// the reference decoders accept.
+
+func TestHegelEncodersAcceptAnyMatches(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		kind := pick(ht, "brotli", "brotli-fast", "flate", "gzip")
+		var enc matchfinder.Encoder
+		minLen, maxLen, maxDist := 2, 20000, 1<<24-16
+		switch kind {
+		case "brotli":
+			enc = &brotli.Encoder{}
+		case "brotli-fast":
+			enc = &brotli.FastEncoder{}
+			if Known.fastEncoderShort {
+				minLen = 4
+			}
+		case "flate":
+			enc = bflate.NewEncoder()
+			minLen, maxDist = 3, 32768
+		default:
+			enc = bflate.NewGZIPEncoder()
+			minLen, maxDist = 3, 32768
+		}
+		if chance(ht, 50) {
+			// Distances stay within a small window most of the time so that
+			// the stream (and its history) stays small.
+			maxDist = min(maxDist, pick(ht, 100, 1000, 65536))
+		}
+		if chance(ht, 30) {
+			maxLen = pick(ht, minLen, 10, 258, 259, 1000)
+		}
+		if Known.flateLongMatchPanics && minLen == 3 && maxLen > 258 {
+			maxLen = 258
+		}
+		note(ht, "%s encoder, min length %d, max length %d, max distance %d", kind, minLen, maxLen, maxDist)
+		if chance(ht, 20) {
+			// A used encoder, Reset.
+			enc.Encode(nil, []byte("warm up"), []matchfinder.Match{{Unmatched: 7}}, chance(ht, 50))
+			enc.Reset()
+		}
+		blocks := n(ht, 1, 4)
+		var history, stream []byte
+		for b := 0; b < blocks; b++ {
+			size := n(ht, 0, 3000)
+			if chance(ht, 15) {
+				size = pick(ht, 0, 1, 65536, 100000)
+			}
+			block, matches := buildBlock(r, history, size, minLen, maxLen, maxDist)
+			if size == 0 {
+				block, matches = nil, nil
+				if chance(ht, 50) {
+					matches = []matchfinder.Match{{}}
+				}
+			}
+			if msg := checkMatches(matches, history, block, maxDist); msg != "" && len(block) > 0 {
+				ht.Fatalf("harness: generated matches are invalid: %s", msg)
+			}
+			note(ht, "block %d: %d bytes, %d matches", b, len(block), len(matches))
+			last := b == blocks-1
+			dst := stream
+			if chance(ht, 30) {
+				dst = nil
+			}
+			out := enc.Encode(dst, block, matches, last)
+			if dst != nil && (len(out) < len(dst) || !bytes.Equal(out[:len(dst)], dst)) {
+				fail(ht, "%s Encode did not append to dst", kind)
+			}
+			if dst == nil {
+				stream = append(stream, out...)
+			} else {
+				stream = out
+			}
+			history = append(history, block...)
+		}
+		note(ht, "stream: %d bytes for %d", len(stream), len(history))
+		var got []byte
+		var err error
+		switch kind {
+		case "brotli", "brotli-fast":
+			got, err = toolDecompress(stream)
+			if err == nil {
+				lib, lerr := libDecode(ht, r, stream)
+				if lerr != nil || !bytes.Equal(lib, history) {
+					fail(ht, "the Reader decodes the %s encoder's stream to %d bytes, %v; want %d", kind, len(lib), lerr, len(history))
+				}
+			}
+		case "flate":
+			got, err = io.ReadAll(flate.NewReader(bytes.NewReader(stream)))
+		default:
+			var zr *gzip.Reader
+			zr, err = gzip.NewReader(bytes.NewReader(stream))
+			if err == nil {
+				got, err = io.ReadAll(zr)
+			}
+		}
+		if err != nil {
+			fail(ht, "the reference decoder rejects the %s encoder's stream: %v", kind, err)
+		}
+		if !bytes.Equal(got, history) {
+			fail(ht, "the %s encoder's stream decodes to %d bytes, want %d", kind, len(got), len(history))
+		}
+	})
+}
