+// ---------------------------------------------------------------------------
+// Property 7: HTTPCompressor's content negotiation (RFC 9110 section 12.5.3).
+
+type acceptEntry struct {
+	coding string // as written
+	q      string // as written, "" for none
+	weight float64
+	valid  bool // the entry follows the grammar
+}
+
+// genAccept makes Accept-Encoding header values (possibly several lines) and
+// the entries they contain.
+func genAccept(ht *hegel.T) ([]string, []acceptEntry) {
+	var lines []string
+	var entries []acceptEntry
+	nLines := pick(ht, 0, 1, 1, 1, 2)
+	for l := 0; l < nLines; l++ {
+		k := n(ht, 0, 4)
+		var parts []string
+		for i := 0; i < k; i++ {
+			e := acceptEntry{valid: true, weight: 1}
+			e.coding = pick(ht, "br", "gzip", "*", "identity", "deflate", "zstd", "br", "gzip", "BR", "Gzip", "x-br")
+			if Known.acceptCaseSensitive {
+				e.coding = strings.ToLower(e.coding)
+			}
+			switch pick(ht, "none", "none", "valid", "valid", "odd") {
+			case "valid":
+				e.q = pick(ht, "0", "1", "0.5", "0.9", "0.001", "0.000", "1.0", "1.000", "0.75", "0.1")
+				e.weight, _ = strconv.ParseFloat(e.q, 64)
+			case "odd":
+				e.q = pick(ht, "1.5", "2", ".5", "0.1234", "abc", "", "1.001", "-1", "0,5", "01")
+				e.valid = false
+			}
+			s := e.coding
+			if e.q != "" || (!e.valid && chance(ht, 50)) {
+				sep := pick(ht, ";", " ;", "; ", " ; ")
+				s += sep + "q=" + e.q
+			}
+			entries = append(entries, e)
+			parts = append(parts, s)
+		}
+		// A server trims the whitespace around a field value before a
+		// handler sees it (net/textproto does), so the lines here are trimmed.
+		line := strings.TrimSpace(strings.Join(parts, pick(ht, ",", ", ", " ,", " , ", ",  ")))
+		lines = append(lines, line)
+	}
+	if Known.starOverridesListed {
+		// Keep "*" out of headers that also list br or gzip.
+		listed := false
+		for _, e := range entries {
+			c := strings.ToLower(e.coding)
+			if c == "br" || c == "gzip" {
+				listed = true
+			}
+		}
+		if listed {
+			for i := range lines {
+				lines[i] = strings.TrimSpace(strings.Trim(strings.ReplaceAll(strings.ReplaceAll(","+lines[i]+",", "*", "identity"), ",,", ","), ","))
+			}
+			for i := range entries {
+				if entries[i].coding == "*" {
+					entries[i].coding = "identity"
+				}
+			}
+		}
+	}
+	return lines, entries
+}
+
+// negotiate is the RFC's choice among the offers br and gzip: an explicit
+// listing (case-insensitive) sets a coding's weight, "*" sets the weight of
+// every coding not listed, unlisted codings are unacceptable, the highest
+// non-zero weight wins and br (first offered) wins ties. It returns "" when
+// neither is acceptable, and ok=false when an entry breaks the grammar (no
+// verdict then), and when a coding is listed twice with different weights
+// (the RFC does not say which counts).
+func negotiate(entries []acceptEntry) (choice string, ok bool) {
+	weights := map[string]float64{}
+	star := -1.0
+	for _, e := range entries {
+		if !e.valid {
+			return "", false
+		}
+		c := strings.ToLower(e.coding)
+		if c == "*" {
+			if star >= 0 && star != e.weight {
+				return "", false
+			}
+			star = e.weight
+			continue
+		}
+		if q, dup := weights[c]; dup && q != e.weight {
+			return "", false
+		}
+		weights[c] = e.weight
+	}
+	best, bestQ := "", 0.0
+	for _, offer := range []string{"br", "gzip"} {
+		q, listed := weights[offer]
+		if !listed {
+			if star < 0 {
+				continue
+			}
+			q = star
+		}
+		if q > bestQ {
+			best, bestQ = offer, q
+		}
+	}
+	return best, true
+}
+
+func TestHegelHTTPCompressorNegotiates(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		lines, entries := genAccept(ht)
+		req := httptest.NewRequest("GET", "/", nil)
+		for _, l := range lines {
+			req.Header.Add("Accept-Encoding", l)
+		}
+		note(ht, "Accept-Encoding: %q", lines)
+		rec := httptest.NewRecorder()
+		presetVary := chance(ht, 20)
+		if presetVary {
+			rec.Header().Set("Vary", "Cookie")
+		}
+		level := n(ht, 0, 11)
+		if Known.gzipLevelOverNine {
+			level = n(ht, 0, 9)
+		}
+		var wc io.WriteCloser
+		if chance(ht, 30) {
+			level = 4
+			wc = brotli.HTTPCompressor(rec, req)
+		} else {
+			wc = brotli.HTTPCompressorWithLevel(rec, req, level)
+		}
+		note(ht, "level %d", level)
+		data := genData(ht, r, n(ht, 0, 3000))
+		for _, p := range chunks(r, data, n(ht, 1, 4)) {
+			if _, err := wc.Write(p); err != nil {
+				fail(ht, "Write: %v", err)
+			}
+		}
+		if err := wc.Close(); err != nil {
+			fail(ht, "Close: %v", err)
+		}
+		enc := rec.Header().Get("Content-Encoding")
+		if want, ok := negotiate(entries); ok && enc != want {
+			fail(ht, "Content-Encoding %q for Accept-Encoding %q, want %q", enc, lines, want)
+		}
+		if vary := rec.Header().Get("Vary"); (presetVary && vary != "Cookie") || (!presetVary && vary != "Accept-Encoding") {
+			fail(ht, "Vary = %q (preset %v)", vary, presetVary)
+		}
+		body := rec.Body.Bytes()
+		var got []byte
+		var err error
+		switch enc {
+		case "br":
+			got, err = toolDecompress(body)
+		case "gzip":
+			var zr *gzip.Reader
+			zr, err = gzip.NewReader(bytes.NewReader(body))
+			if err == nil {
+				got, err = io.ReadAll(zr)
+			}
+		case "":
+			got = body
+		default:
+			fail(ht, "Content-Encoding %q is neither offer", enc)
+		}
+		if err != nil {
+			fail(ht, "the %q body does not decode: %v", enc, err)
+		}
+		if !bytes.Equal(got, data) {
+			fail(ht, "the %q body decodes to %d bytes, want %d", enc, len(got), len(data))
+		}
+	})
+}
