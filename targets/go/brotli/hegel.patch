+// ---------------------------------------------------------------------------
+// Property 3: damaged streams.
+
+func TestHegelDamagedStreams(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		r := prng(ht)
+		data := genData(ht, r, n(ht, 0, 3000))
+		var stream []byte
+		if chance(ht, 50) {
+			stream = toolCompress(ht, data, n(ht, 0, 11), pick(ht, 0, 10, 16, 24))
+		} else {
+			var buf bytes.Buffer
+			w := brotli.NewWriterLevel(&buf, n(ht, 0, 11))
+			w.Write(data)
+			w.Close()
+			stream = buf.Bytes()
+		}
+		damaged := append([]byte(nil), stream...)
+		switch kind := pick(ht, "flip", "byte", "delete", "insert", "truncate", "append", "empty", "garbage"); kind {
+		case "flip":
+			i := n(ht, 0, len(damaged)-1)
+			damaged[i] ^= 1 << n(ht, 0, 7)
+			note(ht, "flip bit in byte %d of %d", i, len(damaged))
+		case "byte":
+			i := n(ht, 0, len(damaged)-1)
+			damaged[i] = byte(n(ht, 0, 255))
+			note(ht, "replace byte %d of %d", i, len(damaged))
+		case "delete":
+			i := n(ht, 0, len(damaged)-1)
+			damaged = append(damaged[:i], damaged[i+1:]...)
+			note(ht, "delete byte %d of %d", i, len(stream))
+		case "insert":
+			i := n(ht, 0, len(damaged))
+			damaged = append(damaged[:i], append([]byte{byte(n(ht, 0, 255))}, damaged[i:]...)...)
+			note(ht, "insert a byte at %d of %d", i, len(stream))
+		case "truncate":
+			k := n(ht, 0, len(damaged)-1)
+			damaged = damaged[:k]
+			note(ht, "truncate to %d of %d", k, len(stream))
+		case "append":
+			extra := make([]byte, n(ht, 1, 20))
+			r.Read(extra)
+			if chance(ht, 30) {
+				for i := range extra {
+					extra[i] = 0
+				}
+			}
+			damaged = append(damaged, extra...)
+			note(ht, "append %d bytes", len(extra))
+		case "empty":
+			damaged = nil
+			note(ht, "empty input")
+		default:
+			damaged = make([]byte, n(ht, 1, 64))
+			r.Read(damaged)
+			note(ht, "garbage of %d bytes", len(damaged))
+		}
+		want, toolErr := toolDecompress(damaged)
+		got, err := libDecode(ht, r, damaged)
+		switch {
+		case toolErr == nil && err != nil:
+			fail(ht, "the reference tool decodes the damaged stream (%d bytes) but the Reader fails: %v", len(want), err)
+		case toolErr == nil && !bytes.Equal(got, want):
+			fail(ht, "the reference tool decodes the damaged stream to %d bytes, the Reader to %d", len(want), len(got))
+		case toolErr != nil && err == nil:
+			fail(ht, "the reference tool rejects the damaged stream (%v) but the Reader decodes it to %d bytes", toolErr, len(got))
+		}
+		if err != nil && errors.Is(err, io.EOF) {
+			fail(ht, "the Reader reports a damaged stream as a clean EOF")
+		}
+		// A Reader that has seen the damage is reusable after Reset.
+		rd := brotli.NewReader(bytes.NewReader(damaged))
+		_, firstErr := io.ReadAll(rd)
+		if Known.resetAfterExcess && firstErr != nil && strings.Contains(firstErr.Error(), "excessive input") {
+			return
+		}
+		if err := rd.Reset(bytes.NewReader(stream)); err != nil {
+			fail(ht, "Reset after a damaged stream: %v", err)
+		}
+		got, err = io.ReadAll(rd)
+		if err != nil || !bytes.Equal(got, data) {
+			fail(ht, "after a damaged stream and Reset, the good stream decodes to %d bytes, %v; want %d", len(got), err, len(data))
+		}
+	})
+}
