+package hegel
+
+// Generators: JSON-LD contexts and documents over a small vocabulary, and N-Quads datasets,
+// as generator values. A case is drawn as a small record or tree of independent parts and
+// rendered by pure functions; everything is inline (no remote contexts), so the two
+// processors see the same input. The shapes of the recorded bugs (bugs.toml) are drawn by
+// default; under HEGEL_NO_KNOWN=1 a property builds its grammar without the shapes of the
+// bugs recorded against it (docOpts, nqOpts) and draws the neighbouring region instead.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"sort"
+	"strings"
+
+	"github.com/piprate/json-gold/ld"
+	"hegel.dev/go/hegel"
+)
+
+const (
+	vocab   = "http://ex.org/vocab#"
+	baseIRI = "http://example.org/base/doc"
+	xsd     = "http://www.w3.org/2001/XMLSchema#"
+	rdfNS   = "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
+)
+
+var (
+	termNames = []string{"p1", "p2", "p3", "p4"}
+	typeNames = []string{"T1", "T2"}
+	xsdTypes  = []string{"integer", "string", "boolean", "double", "dateTime", "date", "anyURI", "decimal"}
+	langs     = []string{"en", "de", "fr-CA", "ja"}
+	// wordPool may land in IRI positions (a term typed @id), so its entries are IRI-safe;
+	// "@id" is the keyword-shaped value of json-gold/8 ("id" when that shape is off). The
+	// nasty texts only go into @value objects and N-Quads literals.
+	wordPool  = []string{"a", "hello", "x-y", "", "@id", "_:b0", "http://x/", "1", "true", "a.b", "2024-01-01"}
+	nastyPool = []string{"x y", "caf\u00e9", "\u65e5\u672c", "line\nbreak", "quote\"d", "back\\slash", "tab\tbed", "\u00a0nbsp", "emoji\U0001F600"}
+	// keywordTexts: literal texts of the form of a keyword.
+	keywordTexts = hegel.SampledFrom([]string{"@id", "@type", "@value", "@list"})
+)
+
+// noLoader refuses every remote document: the harness keeps all contexts inline.
+type noLoader struct{}
+
+func (noLoader) LoadDocument(u string) (*ld.RemoteDocument, error) {
+	return nil, errors.New("offline harness: " + u)
+}
+
+func options() *ld.JsonLdOptions {
+	o := ld.NewJsonLdOptions(baseIRI)
+	o.DocumentLoader = noLoader{}
+	return o
+}
+
+// pyOptions is what the oracle gets for the same run.
+func pyOptions(extra map[string]interface{}) string {
+	o := map[string]interface{}{"base": baseIRI, "processingMode": "json-ld-1.1"}
+	for k, v := range extra {
+		o[k] = v
+	}
+	return mustJSON(o)
+}
+
+// viaJSON is the value as encoding/json would decode it (numbers as float64), which is the
+// input json-gold documents: what it gets is a JSON document, not arbitrary Go values.
+func viaJSON(v interface{}) interface{} {
+	var out interface{}
+	if err := json.Unmarshal([]byte(mustJSON(v)), &out); err != nil {
+		panic(err)
+	}
+	return out
+}
+
+// docOpts says which shapes of the recorded bugs a document grammar draws. Every flag is
+// on by default; under HEGEL_NO_KNOWN=1 a property switches off the shapes of the bugs
+// recorded against it.
+type docOpts struct {
+	unicodeIRIs     bool // a relative IRI with a non-ASCII character (json-gold/2: Resolve percent-encodes it)
+	keywordValues   bool // "@id" as a plain value (json-gold/8: ToRDF writes <@id>)
+	nullTerms       bool // a context term set to null (json-gold/5: Flatten panics)
+	slashBases      bool // a @base ending in a slash (json-gold/1: compaction climbs one ../ too many)
+	anonymousGraphs bool // a top-level node with @graph and no @id (its compaction is the document's @graph: lossy by the spec's own design, off in the compact-expand round trip)
+}
+
+// Shared pools -------------------------------------------------------------------------------
+
+var (
+	regexWords   = hegel.FromRegex("[a-z0-9]{0,6}", true)
+	nasty        = hegel.SampledFrom(nastyPool)
+	languages    = hegel.SampledFrom(langs)
+	xsdTypeNames = hegel.SampledFrom(xsdTypes)
+	termName     = hegel.SampledFrom(termNames)
+	indexes      = hegel.SampledFrom([]string{"i1", "i2"})
+	// absoluteIRIs: http://example.org/n0 to n4, the node identifiers of the documents.
+	absoluteIRIs = hegel.Map(hegel.Integers(0, 4), func(i int) string { return fmt.Sprintf("http://example.org/n%d", i) })
+	blankNodes   = hegel.Map(hegel.Integers(0, 3), func(i int) string { return fmt.Sprintf("_:b%d", i) })
+	vocabIRIs    = hegel.Map(hegel.SampledFrom([]string{"q1", "q2", "T1"}), func(s string) string { return vocab + s })
+	urns         = hegel.Map(hegel.SampledFrom([]string{"a", "b"}), func(s string) string { return "urn:x:" + s })
+	ints         = hegel.Integers(-1000, 1000)
+	floats       = hegel.Map(hegel.Integers(-100000, 100000), func(i int) float64 { return float64(i)/100 + 0.005 })
+	// nativeLiterals: a native @value: a small integer, a boolean or a decimal fraction.
+	nativeLiterals = weighted(
+		choice[interface{}]{1, asAny(hegel.Integers(-5, 5))},
+		choice[interface{}]{1, asAny(hegel.Booleans())},
+		choice[interface{}]{1, asAny(hegel.Map(hegel.Integers(-50, 50), func(i int) float64 { return float64(i)/10 + 0.05 }))},
+	)
+	// propNames: the key of a node's property: a term of the vocabulary five times in eight,
+	// an IRI of the vocabulary no context names twice, another IRI once.
+	propNames = weighted(
+		choice[string]{5, termName},
+		choice[string]{2, hegel.Map(hegel.SampledFrom([]string{"q1", "q2"}), func(s string) string { return vocab + s })},
+		choice[string]{1, hegel.Just("http://example.org/other#p")},
+	)
+	// typeValues: a type of a node: a type term, its IRI, or a blank node.
+	typeValues = weighted(
+		choice[string]{1, hegel.SampledFrom(typeNames)},
+		choice[string]{1, hegel.Map(hegel.SampledFrom(typeNames), func(s string) string { return vocab + s })},
+		choice[string]{1, hegel.Just("_:b9")},
+	)
+	// typeMappings: a term's @type: none two times in six, @id, @vocab, an xsd type twice.
+	typeMappings = hegel.SampledFrom([]string{"", "", "@id", "@vocab", "xsd", "xsd"})
+	// containers: a term's @container: none three times in eight, the rest once each.
+	containers = hegel.SampledFrom([]string{"", "", "", "@list", "@set", "@index", "@language", "@set@index"})
+	// termLanguages: a term's @language, one time in four: a language or null.
+	termLanguages = maybe(25, weighted(choice[string]{50, languages}, choice[string]{50, hegel.Just("null")}))
+)
+
+// wordsOf: a short IRI-safe text: a word of the pool four times in five, else lower-case
+// letters and digits; with keyword, "@id" is among the words (else "ident": not "id",
+// which the contexts alias to @id, so that a value "id" under a @vocab-typed term expands
+// to the keyword and reaches json-gold/8 through the alias); with unicode, a non-ASCII
+// word too (an IRI once it lands under a term typed @id, json-gold/2).
+func wordsOf(keyword, unicode bool) hegel.Generator[string] {
+	pool := wordPool
+	if !keyword {
+		pool = replace(pool, "@id", "ident")
+	}
+	if unicode {
+		pool = append(slices.Clone(pool), "caf\u00e9")
+	}
+	return weighted(choice[string]{80, hegel.SampledFrom(pool)}, choice[string]{20, regexWords})
+}
+
+// literalsOf: the lexical form of a literal: a word, or a nasty text two times in five.
+func literalsOf(keyword, unicode bool) hegel.Generator[string] {
+	return weighted(choice[string]{60, wordsOf(keyword, unicode)}, choice[string]{40, nasty})
+}
+
+// irisOf: an IRI in an @id position: an absolute one two times in five, one of the
+// vocabulary, a relative reference (a non-ASCII one among them when unicode), a URN.
+func irisOf(unicode bool) hegel.Generator[string] {
+	rel := []string{"n1", "n2", "#frag", "../up", "?q=1", "sub/dir"}
+	if unicode {
+		rel = append(rel, "caf\u00e9")
+	}
+	return weighted(
+		choice[string]{2, absoluteIRIs},
+		choice[string]{1, vocabIRIs},
+		choice[string]{1, hegel.SampledFrom(rel)},
+		choice[string]{1, urns},
+	)
+}
+
+// nodeIDsOf: a node's @id: none three times in ten, an absolute IRI four, a relative
+// reference (a non-ASCII one among them when unicode) one, a blank node two.
+func nodeIDsOf(unicode bool) hegel.Generator[*string] {
+	rel := []string{"n1", "#frag", "../up", ""}
+	if unicode {
+		rel = append(rel, "caf\u00e9")
+	}
+	return weighted(
+		choice[*string]{3, hegel.Just[*string](nil)},
+		choice[*string]{4, hegel.Map(absoluteIRIs, ptrTo[string])},
+		choice[*string]{1, hegel.Map(hegel.SampledFrom(rel), ptrTo[string])},
+		choice[*string]{2, hegel.Map(blankNodes, ptrTo[string])},
+	)
+}
+
+// Contexts -----------------------------------------------------------------------------------
+
+// termSpec is an expanded term definition as drawn; render fits its parts together (a
+// language container or a language only on a term without a type mapping, a reverse
+// mapping only on a term typed @id with no container or @set), a part that does not fit
+// being a no-op.
+type termSpec struct {
+	compact   bool   // the IRI as ex:name (when the context defines ex)
+	plain     bool   // a plain IRI mapping instead of an expanded definition
+	typ       string // "", "@id", "@vocab" or "xsd" (xsdType then names the type)
+	xsdType   string
+	xsdPrefix bool   // the type as xsd:name (when the context defines xsd)
+	container string // "", "@list", "@set", "@index", "@language" or "@set@index"
+	language  string // "", a language, or "null"
+	reverse   bool
+}
+
+func (t termSpec) render(name string, c ctxSpec) interface{} {
+	iri := vocab + name
+	if c.ex && t.compact {
+		iri = "ex:" + name
+	}
+	if t.plain {
+		return iri
+	}
+	def := map[string]interface{}{"@id": iri}
+	hasType := t.typ != ""
+	switch t.typ {
+	case "":
+	case "xsd":
+		if c.xsd && t.xsdPrefix {
+			def["@type"] = "xsd:" + t.xsdType
+		} else {
+			def["@type"] = xsd + t.xsdType
+		}
+	default:
+		def["@type"] = t.typ
+	}
+	switch {
+	case t.container == "@set@index":
+		def["@container"] = []interface{}{"@set", "@index"}
+	case t.container == "@language" && hasType:
+	case t.container != "":
+		def["@container"] = t.container
+	}
+	if !hasType && t.language != "" {
+		if t.language == "null" {
+			def["@language"] = nil
+		} else {
+			def["@language"] = t.language
+		}
+	}
+	// a reverse term: no container or @set only (@index on a reverse term compacts to an
+	// index map inside an array in both processors, which they then expand differently)
+	if t.reverse && t.typ == "@id" && (def["@container"] == nil || def["@container"] == "@set") {
+		delete(def, "@type")
+		delete(def, "@id")
+		def["@reverse"] = iri
+	}
+	return def
+}
+
+// ctxSpec is a local context as drawn: its keyword entries, the prefixes and aliases it
+// defines, which type terms it defines, a definition per term name (nil: none) and a
+// term set to null ("" none).
+type ctxSpec struct {
+	vocab              *string
+	base, language     string // "" absent
+	version, ex, xsd   bool
+	idAlias, typeAlias bool
+	types              []bool
+	terms              []*termSpec
+	nullTerm           string
+}
+
+func (c ctxSpec) render() map[string]interface{} {
+	ctx := map[string]interface{}{}
+	if c.vocab != nil {
+		ctx["@vocab"] = *c.vocab
+	}
+	if c.base != "" {
+		ctx["@base"] = c.base
+	}
+	if c.language != "" {
+		ctx["@language"] = c.language
+	}
+	if c.version {
+		ctx["@version"] = 1.1
+	}
+	if c.ex {
+		ctx["ex"] = vocab
+	}
+	if c.xsd {
+		ctx["xsd"] = xsd
+	}
+	if c.idAlias {
+		ctx["id"] = "@id"
+	}
+	if c.typeAlias {
+		ctx["type"] = "@type"
+	}
+	for i, t := range typeNames {
+		if c.types[i] {
+			ctx[t] = vocab + t
+		}
+	}
+	for i, name := range termNames {
+		if c.terms[i] != nil {
+			ctx[name] = c.terms[i].render(name, c)
+		}
+	}
+	if c.nullTerm != "" {
+		ctx[c.nullTerm] = nil // a term set to null removes it
+	}
+	return ctx
+}
+
+// contexts: a local context over the vocabulary: @vocab three times in ten, @base and
+// @language and @version one in five, the ex prefix three in five, xsd two in five, aliases
+// of @id and @type one in five, each type term half of the time, each of the four terms
+// three times in four (a plain IRI two in five, else an expanded definition), and one
+// time in ten a term set to null.
+func contexts(o docOpts) hegel.Generator[map[string]interface{}] {
+	basePool := []string{"http://example.org/other/x", "http://example.org/base/doc2", "d"}
+	if o.slashBases {
+		basePool = append(basePool, "http://example.org/other/", "http://example.org/base/", "d/")
+	}
+	terms := hegel.Composite(func(tc hegel.TestCase) termSpec {
+		return termSpec{
+			compact:   hegel.Draw(tc, chance(40)),
+			plain:     hegel.Draw(tc, chance(40)),
+			typ:       hegel.Draw(tc, typeMappings),
+			xsdType:   hegel.Draw(tc, xsdTypeNames),
+			xsdPrefix: hegel.Draw(tc, chance(50)),
+			container: hegel.Draw(tc, containers),
+			language:  hegel.Draw(tc, termLanguages),
+			reverse:   hegel.Draw(tc, chance(20)),
+		}
+	})
+	nullTerms := hegel.Just("")
+	if o.nullTerms {
+		nullTerms = maybe(10, termName)
+	}
+	vocabs := optional(30, hegel.SampledFrom([]string{vocab, "http://example.org/v/", ""}))
+	bases := maybe(20, hegel.SampledFrom(basePool))
+	typeFlags := hegel.Lists(chance(50)).MinSize(len(typeNames)).MaxSize(len(typeNames))
+	termSlots := hegel.Lists(optional(75, terms)).MinSize(len(termNames)).MaxSize(len(termNames))
+	return hegel.Composite(func(tc hegel.TestCase) map[string]interface{} {
+		return ctxSpec{
+			vocab:     hegel.Draw(tc, vocabs),
+			base:      hegel.Draw(tc, bases),
+			language:  hegel.Draw(tc, maybe(20, languages)),
+			version:   hegel.Draw(tc, chance(20)),
+			ex:        hegel.Draw(tc, chance(60)),
+			xsd:       hegel.Draw(tc, chance(40)),
+			idAlias:   hegel.Draw(tc, chance(20)),
+			typeAlias: hegel.Draw(tc, chance(20)),
+			types:     hegel.Draw(tc, typeFlags),
+			terms:     hegel.Draw(tc, termSlots),
+			nullTerm:  hegel.Draw(tc, nullTerms),
+		}.render()
+	})
+}
+
+// Documents ----------------------------------------------------------------------------------
+
+// document is a rendered JSON-LD document (as encoding/json decodes it) and the context it
+// was built with, inline in the document most of the time.
+type document struct {
+	doc interface{}
+	ctx map[string]interface{}
+}
+
+func (d document) GoString() string {
+	return "doc " + mustJSON(d.doc) + "\n ctx " + mustJSON(d.ctx)
+}
+
+// nodeWithCtx: a top-level node and whether it carries the document's context inline.
+type nodeWithCtx struct {
+	node    map[string]interface{}
+	withCtx bool
+}
+
+// docShape: the top level of a document: one node, or an array of up to three.
+type docShape struct {
+	array bool
+	nodes []nodeWithCtx
+}
+
+// renderNode writes a node object; a @graph (top-level nodes only) replaces everything but
+// the @id, and needs one unless anonymous graphs are drawn.
+func renderNode(o docOpts, id *string, types []string, typeArray bool, props map[string]interface{}, rev map[string]interface{}, graph []map[string]interface{}) map[string]interface{} {
+	node := map[string]interface{}{}
+	if id != nil {
+		node["@id"] = *id
+	}
+	if graph != nil && (id != nil || o.anonymousGraphs) {
+		items := make([]interface{}, len(graph))
+		for i, g := range graph {
+			items[i] = g
+		}
+		node["@graph"] = items
+		return node
+	}
+	switch {
+	case len(types) == 1 && !typeArray:
+		node["@type"] = types[0]
+	case len(types) > 0:
+		node["@type"] = stringList(types)
+	}
+	for k, v := range props {
+		node[k] = v
+	}
+	if rev != nil {
+		node["@reverse"] = rev
+	}
+	return node
+}
+
+// renderDocument puts the context into the nodes flagged for it and decodes the result as
+// JSON does.
+func renderDocument(ctx map[string]interface{}, s docShape) document {
+	var doc interface{}
+	if s.array {
+		arr := make([]interface{}, len(s.nodes))
+		for i, n := range s.nodes {
+			if n.withCtx {
+				n.node["@context"] = ctx
+			}
+			arr[i] = n.node
+		}
+		doc = arr
+	} else {
+		n := s.nodes[0]
+		if n.withCtx {
+			n.node["@context"] = ctx
+		}
+		doc = n.node
+	}
+	return document{doc: viaJSON(doc), ctx: viaJSON(ctx).(map[string]interface{})}
+}
+
+// documents: a JSON-LD document over the vocabulary: a context and a node with the context
+// inline nine times in ten or, one time in five, an array of up to three nodes each with
+// the context inline half of the time. A node has an @id, up to two types (a string when
+// one, three times in five), up to four properties with one value or up to three, a
+// @reverse map (nodes two levels deep at most) and, at the top level, a @graph of up to
+// three nodes one time in seven. A value is a word three times in twelve, an integer, a
+// decimal, a boolean, a value object (plain, typed, language-tagged or native), a node
+// reference, a nested node (two levels deep, a word below), a list, a set, and null or an
+// indexed value once each; a @set directly inside a @list is not drawn (the spec's
+// expansion splices its items, which json-gold does; pyld and jsonld.js nest a list: not
+// judged), and lists and sets nest three levels deep with scalars below.
+func documents(o docOpts) hegel.Generator[document] {
+	words := wordsOf(o.keywordValues, o.unicodeIRIs)
+	literals := literalsOf(o.keywordValues, o.unicodeIRIs)
+	iris := irisOf(o.unicodeIRIs)
+	nodeIDs := nodeIDsOf(o.unicodeIRIs)
+	idObjects := hegel.Map(iris, func(s string) map[string]interface{} { return map[string]interface{}{"@id": s} })
+	valueObjects := weighted(
+		choice[interface{}]{1, hegel.Map(literals, func(s string) interface{} { return map[string]interface{}{"@value": s} })},
+		choice[interface{}]{1, hegel.Map(pairs(literals, xsdTypeNames), func(p pair[string, string]) interface{} {
+			return map[string]interface{}{"@value": p.a, "@type": xsd + p.b}
+		})},
+		choice[interface{}]{1, hegel.Map(pairs(literals, languages), func(p pair[string, string]) interface{} {
+			return map[string]interface{}{"@value": p.a, "@language": p.b}
+		})},
+		choice[interface{}]{1, hegel.Map(nativeLiterals, func(v interface{}) interface{} { return map[string]interface{}{"@value": v} })},
+	)
+	indexed := hegel.Map(pairs(words, indexes), func(p pair[string, string]) interface{} {
+		return map[string]interface{}{"@value": p.a, "@index": p.b}
+	})
+	nullOrIndexed := weighted(choice[interface{}]{1, hegel.Just[interface{}](nil)}, choice[interface{}]{1, indexed})
+	scalars := weighted(
+		choice[interface{}]{3, asAny(words)},
+		choice[interface{}]{1, asAny(ints)},
+		choice[interface{}]{1, asAny(floats)},
+		choice[interface{}]{1, asAny(hegel.Booleans())},
+	)
+
+	// the recursion: values hold nodes and lists and sets of values again; depth counts the
+	// live nesting (hegel-go's ExampleComposite_recursive)
+	depth := 0
+	var values, listItems hegel.Generator[interface{}]
+	var innerNodes hegel.Generator[map[string]interface{}]
+	nested := hegel.Composite(func(tc hegel.TestCase) interface{} {
+		if depth >= 2 {
+			return hegel.Draw(tc, words)
+		}
+		return hegel.Draw(tc, innerNodes)
+	})
+	items := func(g *hegel.Generator[interface{}]) hegel.Generator[[]interface{}] {
+		deep, shallow := hegel.Lists(scalars).MaxSize(3), hegel.Lists(deferred(g)).MaxSize(3)
+		return hegel.Composite(func(tc hegel.TestCase) []interface{} {
+			depth++
+			defer func() { depth-- }()
+			if depth > 3 {
+				return nonNil(hegel.Draw(tc, deep))
+			}
+			return nonNil(hegel.Draw(tc, shallow))
+		})
+	}
+	lists := hegel.Map(items(&listItems), func(xs []interface{}) interface{} { return map[string]interface{}{"@list": xs} })
+	sets := hegel.Map(items(&values), func(xs []interface{}) interface{} { return map[string]interface{}{"@set": xs} })
+	common := []choice[interface{}]{
+		{3, asAny(words)},
+		{1, asAny(ints)},
+		{1, asAny(floats)},
+		{1, asAny(hegel.Booleans())},
+		{1, valueObjects},
+		{1, asAny(idObjects)},
+		{1, nested},
+		{1, lists},
+		{1, nullOrIndexed},
+	}
+	listItems = weighted(common...)
+	values = weighted(append(slices.Clone(common), choice[interface{}]{1, sets})...)
+
+	propValues := weighted(
+		choice[interface{}]{60, values},
+		choice[interface{}]{40, hegel.Map(hegel.Lists(values).MaxSize(3), func(xs []interface{}) interface{} { return nonNil(xs) })},
+	)
+	props := hegel.Maps(propNames, propValues).MaxSize(4)
+	types := maybe(40, hegel.Lists(typeValues).MinSize(1).MaxSize(2))
+	typeArrays := chance(40)
+	// a reverse map: one property with a node reference or a nested node (given an @id when
+	// it would be empty: json-gold drops the property, pyld keeps it with no values, neither
+	// convincingly), on nodes less than two levels deep
+	revTargets := weighted(
+		choice[map[string]interface{}]{1, idObjects},
+		choice[map[string]interface{}]{1, hegel.Composite(func(tc hegel.TestCase) map[string]interface{} {
+			node := hegel.Draw(tc, innerNodes)
+			if len(node) == 0 {
+				node["@id"] = hegel.Draw(tc, iris)
+			}
+			return node
+		})},
+	)
+	revs := maybe(15, hegel.Map(pairs(propNames, revTargets), func(p pair[string, map[string]interface{}]) map[string]interface{} {
+		return map[string]interface{}{p.a: p.b}
+	}))
+	reverses := hegel.Composite(func(tc hegel.TestCase) map[string]interface{} {
+		if depth >= 2 {
+			return nil
+		}
+		return hegel.Draw(tc, revs)
+	})
+	nodesOf := func(graphs hegel.Generator[[]map[string]interface{}]) hegel.Generator[map[string]interface{}] {
+		return hegel.Composite(func(tc hegel.TestCase) map[string]interface{} {
+			return renderNode(o,
+				hegel.Draw(tc, nodeIDs), hegel.Draw(tc, types), hegel.Draw(tc, typeArrays),
+				hegel.Draw(tc, props), hegel.Draw(tc, reverses), hegel.Draw(tc, graphs))
+		})
+	}
+	inner := nodesOf(hegel.Just[[]map[string]interface{}](nil))
+	innerNodes = hegel.Composite(func(tc hegel.TestCase) map[string]interface{} {
+		depth++
+		defer func() { depth-- }()
+		return hegel.Draw(tc, inner)
+	})
+	topNodes := nodesOf(maybe(15, hegel.Lists(deferred(&innerNodes)).MinSize(1).MaxSize(3)))
+
+	shapes := weighted(
+		choice[docShape]{80, hegel.Map(pairs(topNodes, chance(90)), func(p pair[map[string]interface{}, bool]) docShape {
+			return docShape{nodes: []nodeWithCtx{{p.a, p.b}}}
+		})},
+		choice[docShape]{20, hegel.Map(hegel.Lists(pairs(topNodes, chance(50))).MaxSize(3), func(ps []pair[map[string]interface{}, bool]) docShape {
+			s := docShape{array: true}
+			for _, p := range ps {
+				s.nodes = append(s.nodes, nodeWithCtx{p.a, p.b})
+			}
+			return s
+		})},
+	)
+	ctxs := contexts(o)
+	return hegel.Composite(func(tc hegel.TestCase) document {
+		return renderDocument(hegel.Draw(tc, ctxs), hegel.Draw(tc, shapes))
+	})
+}
+
+// N-Quads ------------------------------------------------------------------------------------
+
+// nqOpts says which shapes an N-Quads grammar draws.
+type nqOpts struct {
+	native     bool // the dataset is read with useNativeTypes: an xsd:integer, xsd:double or xsd:boolean literal's lexical form is one the conversion judges (see unjudgedFromRDF for the rest)
+	atLiterals bool // a literal starting with @ under a language tag ("@id"@ja, json-gold/7)
+	langString bool // an rdf:langString literal without a language (json-gold/9)
+	bigNumbers bool // an xsd:integer beyond int64, an xsd:double beyond float64 (json-gold/14 with native types)
+}
+
+var (
+	// absTerms and blankTerms: the subjects, objects and graph names of the datasets.
+	absTerms   = hegel.Map(hegel.Integers(0, 5), func(i int) string { return fmt.Sprintf("<http://example.org/n%d>", i) })
+	blankTerms = hegel.Map(hegel.Integers(0, 4), func(i int) string { return fmt.Sprintf("_:b%d", i) })
+	nqTerms    = weighted(choice[string]{65, absTerms}, choice[string]{35, blankTerms})
+	// predicates: one of the vocabulary, or rdf:type three times in twenty.
+	predicates = weighted(
+		choice[string]{85, hegel.Map(hegel.SampledFrom([]string{"p1", "p2", "p3", "q1"}), func(s string) string { return "<" + vocab + s + ">" })},
+		choice[string]{15, hegel.Just("<" + rdfNS + "type>")},
+	)
+)
+
+func nqEscape(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch r {
+		case '\\':
+			b.WriteString(`\\`)
+		case '"':
+			b.WriteString(`\"`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\r':
+			b.WriteString(`\r`)
+		case '\t':
+			b.WriteString(`\t`)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func quote(s string) string { return `"` + nqEscape(s) + `"` }
+
+// lexicalsOf: the lexical form of a literal of the xsd type: any text three times in ten,
+// else from the type's pool of valid and invalid forms; with native types the integer,
+// double and boolean forms are the judged ones only (a number the conversion reads, of
+// which the ones beyond int64 and float64 are json-gold/14's shape; true or false).
+func lexicalsOf(t string, o nqOpts, texts hegel.Generator[string]) hegel.Generator[string] {
+	var pool []string
+	switch t {
+	case "integer":
+		pool = []string{"0", "42", "-7", "+3", "007"}
+		if o.bigNumbers || !o.native {
+			pool = append(pool, "12345678901234567890")
+		}
+		if !o.native {
+			pool = append(pool, "1.0", "1e3")
+		}
+	case "double":
+		pool = []string{"1.5E0", "1.5", "5.0E-1"}
+		if o.bigNumbers || !o.native {
+			pool = append(pool, "1E400")
+		}
+		if !o.native {
+			// 1.7976931348623157E308 is integral as a float64, so with native types it is
+			// among the integral doubles the round trip does not judge
+			pool = append(pool, "1.7976931348623157E308", "-0.0", "1E21", "NaN", "INF", "-INF", "3", "1.0E0", "abc")
+		}
+	case "boolean":
+		// "1" and "0" are valid xsd:boolean too, but the spec's native conversion names only
+		// true and false; pyld converts them, json-gold and jsonld.js keep them: not judged.
+		pool = []string{"true", "false"}
+		if !o.native {
+			pool = append(pool, "TRUE", "yes")
+		}
+	case "dateTime":
+		pool = []string{"2024-01-01T00:00:00Z", "not a date"}
+	default:
+		return texts
+	}
+	if o.native && t != "dateTime" {
+		return hegel.SampledFrom(pool)
+	}
+	return weighted(choice[string]{30, texts}, choice[string]{70, hegel.SampledFrom(pool)})
+}
+
+// listSpec: a well-formed rdf:List hanging off a node, in the default graph or a named one.
+type listSpec struct {
+	subject string
+	graph   bool
+	items   []string
+}
+
+// renderQuads writes the dataset: the plain quads, then the list's triples.
+func renderQuads(lines []string, list *listSpec) string {
+	if list != nil {
+		g := ""
+		if list.graph {
+			g = " <http://example.org/g>"
+		}
+		head := "<" + rdfNS + "nil>"
+		if len(list.items) > 0 {
+			head = "_:l0"
+		}
+		lines = append(lines, list.subject+" <"+vocab+"list> "+head+g+" .")
+		for i, item := range list.items {
+			rest := "<" + rdfNS + "nil>"
+			if i+1 < len(list.items) {
+				rest = fmt.Sprintf("_:l%d", i+1)
+			}
+			lines = append(lines, fmt.Sprintf("_:l%d <%sfirst> %s%s .", i, rdfNS, item, g))
+			lines = append(lines, fmt.Sprintf("_:l%d <%srest> %s%s .", i, rdfNS, rest, g))
+		}
+	}
+	if len(lines) == 0 {
+		return ""
+	}
+	return strings.Join(lines, "\n") + "\n"
+}
+
+// quads: a small dataset: up to six quads (a subject, a predicate, an object and a graph
+// name three times in ten) and, two times in five, a well-formed rdf:List of up to three
+// items. An object is a term three times in ten, a plain literal two, a language-tagged
+// one, an xsd:string (or rdf:langString, json-gold/9's shape) one, a custom datatype one,
+// an xsd-typed literal two.
+func quads(o nqOpts) hegel.Generator[string] {
+	texts := literalsOf(o.atLiterals, false)
+	if o.atLiterals {
+		// keyword-shaped texts one time in five (json-gold/7 under a language tag)
+		texts = weighted(choice[string]{80, texts}, choice[string]{20, keywordTexts})
+	}
+	langStrings := hegel.Just(false)
+	if o.langString {
+		langStrings = chance(15)
+	}
+	typedOf := map[string]hegel.Generator[string]{}
+	for _, t := range xsdTypes {
+		t := t
+		typedOf[t] = hegel.Map(lexicalsOf(t, o, texts), func(lex string) string { return quote(lex) + "^^<" + xsd + t + ">" })
+	}
+	objects := weighted(
+		choice[string]{3, nqTerms},
+		choice[string]{2, hegel.Map(texts, quote)},
+		choice[string]{1, hegel.Map(pairs(texts, languages), func(p pair[string, string]) string { return quote(p.a) + "@" + p.b })},
+		choice[string]{1, hegel.Map(pairs(texts, langStrings), func(p pair[string, bool]) string {
+			if p.b {
+				return quote(p.a) + "^^<" + rdfNS + "langString>" // ill-typed: rdf:langString without a language tag
+			}
+			return quote(p.a) + "^^<" + xsd + "string>"
+		})},
+		choice[string]{1, hegel.Map(texts, func(s string) string { return quote(s) + "^^<http://example.org/dt>" })},
+		choice[string]{2, hegel.FlatMap(xsdTypeNames, func(t string) hegel.Generator[string] { return typedOf[t] })},
+	)
+	graphs := maybe(30, hegel.Map(nqTerms, func(g string) string { return " " + g }))
+	lines := hegel.Lists(hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, nqTerms) + " " + hegel.Draw(tc, predicates) + " " + hegel.Draw(tc, objects) + hegel.Draw(tc, graphs) + " ."
+	})).MaxSize(6)
+	lists := optional(40, hegel.Composite(func(tc hegel.TestCase) listSpec {
+		return listSpec{
+			subject: hegel.Draw(tc, absTerms),
+			graph:   hegel.Draw(tc, chance(30)),
+			items:   hegel.Draw(tc, hegel.Lists(objects).MaxSize(3)),
+		}
+	}))
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		return renderQuads(hegel.Draw(tc, lines), hegel.Draw(tc, lists))
+	})
+}
+
+// hasDuplicateLines: the same quad more than once in an N-Quads serialization.
+func hasDuplicateLines(s string) bool {
+	seen := map[string]bool{}
+	for _, l := range strings.Split(s, "\n") {
+		if strings.TrimSpace(l) == "" {
+			continue
+		}
+		if seen[l] {
+			return true
+		}
+		seen[l] = true
+	}
+	return false
+}
+
+// sortedLines normalises an N-Quads serialization for comparison.
+func sortedLines(s string) string {
+	var out []string
+	for _, l := range strings.Split(s, "\n") {
+		if strings.TrimSpace(l) != "" {
+			out = append(out, l)
+		}
+	}
+	sort.Strings(out)
+	return strings.Join(out, "\n")
+}
diff --git a/hegel/hegel_algos_test.go b/hegel/hegel_algos_test.go
new file mode 100644
index 0000000..626c867
--- /dev/null
+++ b/hegel/hegel_algos_test.go
@@ -0,0 +1,371 @@
+package hegel
+
+// Expansion, compaction and flattening against pyld on the same document and context.
+
+import (
+	"encoding/json"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/piprate/json-gold/ld"
+	"hegel.dev/go/hegel"
+)
+
+// The documents of each property: every shape by default; under HEGEL_NO_KNOWN=1 without
+// the shapes of the bugs recorded against the property (docOpts).
+var (
+	// expandDocs: without non-ASCII relative IRIs (json-gold/2).
+	expandDocs = documents(docOpts{unicodeIRIs: !noKnown, keywordValues: true, nullTerms: true, slashBases: true, anonymousGraphs: true})
+	// compactOpts: without non-ASCII relative IRIs (json-gold/2) and @base ending in a slash (json-gold/1).
+	compactOpts = docOpts{unicodeIRIs: !noKnown, slashBases: !noKnown, keywordValues: true, nullTerms: true, anonymousGraphs: true}
+	// flattenOpts: as compactOpts, and without terms set to null (json-gold/5).
+	flattenOpts = docOpts{unicodeIRIs: !noKnown, slashBases: !noKnown, nullTerms: !noKnown, keywordValues: true, anonymousGraphs: true}
+	// roundTripOpts: without @base ending in a slash (json-gold/1), keyword-shaped values
+	// (json-gold/8) and non-ASCII relative IRIs (json-gold/2 on the way back); never an
+	// anonymous top-level graph, whose compaction is lossy by the spec's own design.
+	roundTripOpts = docOpts{slashBases: !noKnown, keywordValues: !noKnown, unicodeIRIs: !noKnown, nullTerms: true}
+)
+
+// compactCase: a document and the context to compact it with (the document's own when
+// other is nil, half of the time), with CompactArrays on three times in four.
+type compactCase struct {
+	doc           document
+	other         map[string]interface{}
+	compactArrays bool
+}
+
+func (c compactCase) ctx() map[string]interface{} {
+	if c.other != nil {
+		return c.other
+	}
+	return c.doc.ctx
+}
+
+func (c compactCase) GoString() string {
+	return fmt.Sprintf("%#v\n compaction ctx %s\n compactArrays %v", c.doc, mustJSON(c.ctx()), c.compactArrays)
+}
+
+func compactCases(o docOpts) hegel.Generator[compactCase] {
+	docs, others := documents(o), maybe(50, contexts(o))
+	return hegel.Composite(func(tc hegel.TestCase) compactCase {
+		return compactCase{doc: hegel.Draw(tc, docs), other: hegel.Draw(tc, others), compactArrays: hegel.Draw(tc, chance(75))}
+	})
+}
+
+// ctxChoice: the context Flatten gets: none, the document's own, or another.
+type ctxChoice struct {
+	use string
+	ctx map[string]interface{}
+}
+
+// flattenCase: a document and the context to flatten it with, each kind one time in three.
+type flattenCase struct {
+	doc document
+	use ctxChoice
+}
+
+func (c flattenCase) ctx() interface{} {
+	switch c.use.use {
+	case "doc":
+		return c.doc.ctx
+	case "other":
+		return c.use.ctx
+	}
+	return nil
+}
+
+func (c flattenCase) GoString() string {
+	return fmt.Sprintf("%#v\n flatten ctx (%s) %s", c.doc, c.use.use, mustJSON(c.ctx()))
+}
+
+var (
+	flattenCtxs = weighted(
+		choice[ctxChoice]{1, hegel.Just(ctxChoice{use: "none"})},
+		choice[ctxChoice]{1, hegel.Just(ctxChoice{use: "doc"})},
+		choice[ctxChoice]{1, hegel.Map(contexts(flattenOpts), func(c map[string]interface{}) ctxChoice { return ctxChoice{"other", c} })},
+	)
+	flattenDocs  = documents(flattenOpts)
+	flattenCases = hegel.Composite(func(tc hegel.TestCase) flattenCase {
+		return flattenCase{doc: hegel.Draw(tc, flattenDocs), use: hegel.Draw(tc, flattenCtxs)}
+	})
+	compactionCases = compactCases(compactOpts)
+	roundTripCases  = compactCases(roundTripOpts)
+)
+
+// sortTypes orders every @type array: a node merged from several places (a @graph and a
+// @reverse) collects its types in traversal order, which the two processors do not share.
+func sortTypes(v interface{}) interface{} {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		out := make(map[string]interface{}, len(x))
+		for k, val := range x {
+			if arr, ok := val.([]interface{}); ok && (k == "@type" || k == "type") {
+				items := make([]string, 0, len(arr))
+				allStrings := true
+				for _, e := range arr {
+					s, ok := e.(string)
+					if !ok {
+						allStrings = false
+						break
+					}
+					items = append(items, s)
+				}
+				if allStrings {
+					sort.Strings(items)
+					out[k] = stringList(items)
+					continue
+				}
+			}
+			out[k] = sortTypes(val)
+		}
+		return out
+	case []interface{}:
+		items := make([]interface{}, len(x))
+		for i, e := range x {
+			items[i] = sortTypes(e)
+		}
+		return items
+	}
+	return v
+}
+
+// typesSorted re-canonicalises an outcome's JSON with @type arrays sorted.
+func typesSorted(o outcome) outcome {
+	if !o.ok {
+		return o
+	}
+	var v interface{}
+	if json.Unmarshal([]byte(o.text), &v) != nil {
+		return o
+	}
+	return outcome{true, mustJSON(sortTypes(v))}
+}
+
+// sortSets orders every array that is not a @list's value by canonical text, so two expanded
+// documents compare as the sets of values they are.
+func sortSets(v interface{}) interface{} {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		out := make(map[string]interface{}, len(x))
+		for k, val := range x {
+			if k == "@list" {
+				if arr, ok := val.([]interface{}); ok {
+					items := make([]interface{}, len(arr))
+					for i, e := range arr {
+						items[i] = sortSets(e)
+					}
+					out[k] = items
+					continue
+				}
+			}
+			out[k] = sortSets(val)
+		}
+		return out
+	case []interface{}:
+		items := make([]interface{}, len(x))
+		for i, e := range x {
+			items[i] = sortSets(e)
+		}
+		sort.Slice(items, func(i, j int) bool { return mustJSON(items[i]) < mustJSON(items[j]) })
+		return items
+	}
+	return v
+}
+
+// pyCrash: the oracle reports a Python exception class (the JSON-LD error codes are phrases).
+var pyCrash = regexp.MustCompile(`^[A-Z][A-Za-z]*(Error|Exception): `)
+
+// outcome is one side's result: a canonical JSON text, or an error.
+type outcome struct {
+	ok   bool
+	text string // canonical JSON when ok, the error otherwise
+}
+
+func goOutcome(v interface{}, err error) outcome {
+	if err != nil {
+		return outcome{false, err.Error()}
+	}
+	return outcome{true, canon(mustJSON(v))}
+}
+
+func pyOutcome(r jsonReply) outcome {
+	if !r.Ok {
+		return outcome{false, r.Error + ": " + r.Message}
+	}
+	return outcome{true, canon(string(r.Result))}
+}
+
+// judge compares the two outcomes for one operation; both failing counts as agreement.
+// shapes names the recorded bugs whose shape the case has by construction; a disagreement
+// adds the bugs recognised in the outputs (voteShapes) and fails naming them all. Under
+// HEGEL_NO_KNOWN=1 a disagreement whose only difference is such a recorded defect counts as
+// agreement up to it, and one where pyld refuses a document json-gold accepts through a
+// @set or @list (json-gold/12, nothing more to compare) is skipped.
+func judge(ht *hegel.T, op string, doc interface{}, extra string, g, p outcome, shapes ...string) bool {
+	if !p.ok && pyCrash.MatchString(p.text) {
+		// a Python exception rather than a JsonLdError: pyld's own failure, no vote
+		skip(ht, "pyld raises")
+	}
+	switch {
+	case g.ok && p.ok:
+		if op == "compact" && g.text == "{}" && p.text == `{"@graph":[]}` {
+			// pyld adds an empty @graph to an empty compaction; jsonld.js and the spec do not
+			count("not judged: pyld's empty @graph on an empty compaction")
+			return false
+		}
+		if g.text != p.text {
+			if ids := voteShapes(op, g, p); len(ids) > 0 {
+				if noKnown {
+					count("known " + strings.Join(ids, " "))
+					if collecting {
+						collectedMu.Lock()
+						collectedMsgs = append(collectedMsgs, fmt.Sprintf("known %s\n doc: %s%s\n json-gold: %s\n pyld:      %s", strings.Join(ids, " "), mustJSON(doc), extra, g.text, p.text))
+						collectedMu.Unlock()
+					}
+					return false
+				}
+				shapes = append(shapes, ids...)
+			}
+			mismatch(ht, shapes, "%s disagree\n doc: %s%s\n json-gold: %s\n pyld:      %s", op, mustJSON(doc), extra, g.text, p.text)
+			return false
+		}
+		count(op + " agree")
+	case !g.ok && !p.ok:
+		count(op + " both error")
+	case g.ok:
+		if docHasSetOrList(doc) {
+			shapes = append(shapes, "json-gold/12")
+		}
+		mismatch(ht, shapes, "%s: pyld errors, json-gold does not\n doc: %s%s\n json-gold: %s\n pyld:      %s", op, mustJSON(doc), extra, g.text, p.text)
+		return false
+	default:
+		mismatch(ht, shapes, "%s: json-gold errors, pyld does not\n doc: %s%s\n json-gold: %s\n pyld:      %s", op, mustJSON(doc), extra, g.text, p.text)
+		return false
+	}
+	return true
+}
+
+// checkExpand: Expand gives pyld's expanded document (or both refuse the document).
+func checkExpand(ht *hegel.T, doc interface{}) {
+	proc := ld.NewJsonLdProcessor()
+	g := goOutcome(proc.Expand(doc, options()))
+	var r jsonReply
+	ask(&r, "E", mustJSON(doc), pyOptions(nil))
+	judge(ht, "expand", doc, "", g, pyOutcome(r))
+}
+
+func TestHegelExpandMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkExpand(ht, hegel.Draw(ht, expandDocs).doc)
+	})
+}
+
+// checkCompact: Compact with the context gives pyld's compacted document.
+func checkCompact(ht *hegel.T, doc interface{}, ctx map[string]interface{}, compactArrays bool) {
+	opts := options()
+	opts.CompactArrays = compactArrays
+	proc := ld.NewJsonLdProcessor()
+	g := goOutcome(proc.Compact(doc, ctx, opts))
+	var r jsonReply
+	ask(&r, "C", mustJSON(doc), mustJSON(ctx), pyOptions(map[string]interface{}{"compactArrays": compactArrays}))
+	judge(ht, "compact", doc, "\n ctx: "+mustJSON(ctx)+"\n compactArrays: "+mustJSON(compactArrays), g, pyOutcome(r),
+		shapeIf(ctxBaseSlash(ctx), "json-gold/1")...)
+}
+
+func TestHegelCompactMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, compactionCases)
+		checkCompact(ht, c.doc.doc, c.ctx(), c.compactArrays)
+	})
+}
+
+// checkFlatten: Flatten with the context (nil for none) gives pyld's flattened document,
+// and does not panic.
+func checkFlatten(ht *hegel.T, doc interface{}, ctx interface{}) {
+	shapes := append(shapeIf(ctxNullTerm(ctx), "json-gold/5"), shapeIf(ctxBaseSlash(ctx), "json-gold/1")...)
+	proc := ld.NewJsonLdProcessor()
+	flat, err, panicked := guarded(func() (interface{}, error) { return proc.Flatten(doc, ctx, options()) })
+	if panicked != nil {
+		mismatch(ht, shapes, "Flatten panics: %v\n doc: %s\n ctx: %s", panicked, mustJSON(doc), mustJSON(ctx))
+		return
+	}
+	g := typesSorted(goOutcome(flat, err))
+	var r jsonReply
+	ask(&r, "F", mustJSON(doc), mustJSON(ctx), pyOptions(nil))
+	p := typesSorted(pyOutcome(r))
+	judge(ht, "flatten", doc, "\n ctx: "+mustJSON(ctx), g, p, shapes...)
+}
+
+func TestHegelFlattenMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, flattenCases)
+		checkFlatten(ht, c.doc.doc, c.ctx())
+	})
+}
+
+// Compaction is lossless: expanding the compacted document (its context inline) gives the
+// expanded document again. pyld gets the vote when json-gold's round trip does not close.
+func TestHegelCompactExpandRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, roundTripCases)
+		doc, ctx := c.doc.doc, c.ctx()
+		shapes := append(shapeIf(ctxBaseSlash(ctx) || fragmentUnderSlashBase(doc, c.doc.ctx), "json-gold/1"),
+			shapeIf(hasKeywordValue(doc), "json-gold/8")...) // the "IRI" @id compacts to the alias of the keyword and re-expands to another IRI
+		proc := ld.NewJsonLdProcessor()
+		expanded, err := proc.Expand(doc, options())
+		if err != nil {
+			skip(ht, "expand error")
+		}
+		opts := options()
+		opts.CompactArrays = c.compactArrays
+		compacted, err := proc.Compact(expanded, ctx, opts)
+		if err != nil {
+			skip(ht, "compact error")
+		}
+		again, expandErr := proc.Expand(compacted, options())
+		want := canon(mustJSON(sortSets(expanded)))
+		got := ""
+		if expandErr == nil {
+			// the order of a property's values is not significant outside @list: compare sorted
+			got = canon(mustJSON(sortSets(again)))
+			if want == got {
+				count("round trip closes")
+				return
+			}
+			if strings.Contains(want, `"@reverse":{}`) {
+				// an empty @reverse survives expansion but not compaction (pyld too): not judged
+				skip(ht, "empty @reverse")
+			}
+		}
+		// pyld's round trip over the same expanded document and context
+		var cr jsonReply
+		ask(&cr, "C", mustJSON(expanded), mustJSON(ctx), pyOptions(map[string]interface{}{"compactArrays": opts.CompactArrays}))
+		var e jsonReply
+		if cr.Ok {
+			ask(&e, "E", string(cr.Result), pyOptions(nil))
+		}
+		if cr.Ok && canon(string(cr.Result)) == canon(mustJSON(compacted)) {
+			// pyld compacts to the very same document: what is lost is lost by the
+			// specification's compaction (e.g. a number under a @language container lands
+			// under @none, which expansion refuses). Not judged.
+			skip(ht, "pyld compacts identically")
+		}
+		if expandErr != nil {
+			mismatch(ht, shapes, "expanding json-gold's compaction fails: %v\n doc: %s\n ctx: %s\n compacted: %s\n pyld compacts to: %s %s", expandErr, mustJSON(doc), mustJSON(ctx), mustJSON(compacted), string(cr.Result), cr.Error)
+			return
+		}
+		py := "pyld: compact error " + cr.Error
+		if cr.Ok {
+			if e.Ok {
+				py = "pyld compacts to " + canon(string(cr.Result)) + " which expands to " + canon(string(e.Result))
+			} else {
+				py = "pyld compacts to " + canon(string(cr.Result)) + " which does not expand: " + e.Error
+			}
+		}
+		mismatch(ht, shapes, "compaction is lossy\n doc: %s\n ctx: %s\n compactArrays: %v\n expanded:  %s\n compacted: %s\n again:     %s\n %s",
+			mustJSON(doc), mustJSON(ctx), opts.CompactArrays, want, mustJSON(compacted), got, py)
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..c2d61c7
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,261 @@
+package hegel
+
+// One deterministic reproducer per recorded bug (bugs.toml). Each fails while the bug is open.
+
+import (
+	"os"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/piprate/json-gold/ld"
+)
+
+// noPanic turns a panic in fn into a test failure.
+func noPanic(t *testing.T, what string, fn func()) {
+	defer func() {
+		if p := recover(); p != nil {
+			t.Fatalf("%s panics: %v", what, p)
+		}
+	}()
+	fn()
+}
+
+// json-gold/1: the relative IRI against a base ending in a slash has one ../ too many, so it
+// denotes another resource.
+func TestHegelPinRelativeIRIClimbsTooFar(t *testing.T) {
+	base, iri := "http://example.org/a/b/", "http://example.org/a/c"
+	rel := ld.RemoveBase(base, iri)
+	if back := ld.Resolve(base, rel); back != iri {
+		t.Errorf("RemoveBase(%s, %s) = %q, which resolves to %s (RFC 3986: ../c)", base, iri, rel, back)
+	}
+	proc := ld.NewJsonLdProcessor()
+	doc := map[string]interface{}{"@id": iri, "http://example.org/p": "x"}
+	ctx := map[string]interface{}{"@base": base}
+	out, err := proc.Compact(doc, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out["@id"] != "../c" {
+		t.Errorf("Compact with @base %s gives @id %q for %s, RFC 3986 gives ../c", base, out["@id"], iri)
+	}
+	// the other branch: an IRI ending in / with a fragment, against a base with a last segment
+	base, iri = "http://example.org/base/doc", "http://example.org/base/#frag"
+	rel = ld.RemoveBase(base, iri)
+	if back := ld.Resolve(base, rel); back != iri {
+		t.Errorf("RemoveBase(%s, %s) = %q, which resolves to %s (RFC 3986: ./#frag)", base, iri, rel, back)
+	}
+}
+
+// json-gold/2: resolving a relative IRI reference percent-encodes non-ASCII characters, so the
+// expanded @id (and the RDF IRI) is not the one the document denotes.
+func TestHegelPinResolveKeepsUnicode(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	doc := map[string]interface{}{"@context": map[string]interface{}{"@base": "http://example.org/base/doc"}, "@id": "café", "http://example.org/p": "x"}
+	out, err := proc.Expand(doc, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := out[0].(map[string]interface{})["@id"]; got != "http://example.org/base/café" {
+		t.Errorf("Expand resolves @id \"café\" against http://example.org/base/doc to %q, RFC 3987 section 6.5 gives http://example.org/base/café", got)
+	}
+}
+
+// json-gold/3: compaction with nothing to output drops the @context.
+func TestHegelPinCompactEmptyKeepsContext(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	ctx := map[string]interface{}{"ex": "http://example.org/"}
+	out, err := proc.Compact(map[string]interface{}{"@id": "_:b0"}, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := out["@context"]; !ok {
+		t.Errorf("Compact of a document with nothing to output gives %s: the spec's compact() adds @context whenever the context is not null", mustJSON(out))
+	}
+}
+
+// json-gold/4: Flatten returns a re-serialisation of the active context instead of the provided
+// context, and a bare [] instead of {@context, @graph: []} when there is nothing to output.
+func TestHegelPinFlattenProvidedContext(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	ctx := map[string]interface{}{"ex": "http://example.org/", "p": "http://example.org/p", "@version": 1.1}
+	out, err := proc.Flatten(map[string]interface{}{"@id": "http://example.org/x", "http://example.org/p": 1.0}, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m, ok := out.(map[string]interface{}); !ok || !reflect.DeepEqual(m["@context"], ctx) {
+		t.Errorf("Flatten with context %s returns %s: its @context is not the provided context", mustJSON(ctx), mustJSON(out))
+	}
+	out, err = proc.Flatten(map[string]interface{}{"@id": "_:b0"}, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m, ok := out.(map[string]interface{}); !ok || m["@context"] == nil || m["@graph"] == nil {
+		t.Errorf("Flatten with a context and nothing to output returns %s, not {@context, @graph: []}", mustJSON(out))
+	}
+}
+
+// json-gold/5: Flatten panics when the context maps a term to null.
+func TestHegelPinFlattenNullTerm(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	ctx := map[string]interface{}{"p": nil, "q": "http://example.org/q"}
+	noPanic(t, "Flatten with a context containing a null term", func() {
+		if _, err := proc.Flatten(map[string]interface{}{"@id": "http://example.org/x", "http://example.org/p": 1.0}, ctx, options()); err != nil {
+			t.Fatal(err)
+		}
+	})
+}
+
+// json-gold/6: FromRDF with UseNativeTypes yields int64 values that ToRDF panics on.
+func TestHegelPinNativeIntegerBackToRDF(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	nq := "<http://example.org/s> <http://example.org/p> \"1\"^^<http://www.w3.org/2001/XMLSchema#integer> .\n"
+	fo := options()
+	fo.UseNativeTypes = true
+	doc, err := proc.FromRDF(nq, fo)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ro := options()
+	ro.Format = "application/n-quads"
+	noPanic(t, "ToRDF of FromRDF's output with UseNativeTypes", func() {
+		out, err := proc.ToRDF(doc, ro)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if out != nq {
+			t.Errorf("round trip gives %q, not %q", out, nq)
+		}
+	})
+}
+
+// json-gold/7: a literal whose text starts with @ and has a language tag is read as a plain
+// literal containing the quotes and the tag.
+func TestHegelPinNQuadsLiteralStartingWithAt(t *testing.T) {
+	ds, err := ld.ParseNQuads("<http://example.org/s> <http://example.org/p> \"@id\"@ja .\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	q := ds.Graphs["@default"][0]
+	lit, ok := q.Object.(ld.Literal)
+	if !ok || lit.Value != "@id" || lit.Language != "ja" {
+		t.Errorf("\"@id\"@ja parsed as value %q language %q datatype %q", lit.Value, lit.Language, lit.Datatype)
+	}
+}
+
+// json-gold/8: a value of the form of a keyword, expanded through @type: @vocab, is written to
+// N-Quads as the IRI <@id>.
+func TestHegelPinToRDFKeywordValue(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	doc := map[string]interface{}{"@context": map[string]interface{}{"p": map[string]interface{}{"@id": "http://example.org/p", "@type": "@vocab"}}, "@id": "http://example.org/s", "p": "@id"}
+	o := options()
+	o.Format = "application/n-quads"
+	out, err := proc.ToRDF(doc, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(out.(string), "<@id>") {
+		t.Errorf("ToRDF writes %q: <@id> is not an IRI, the triple must be dropped", out)
+	}
+}
+
+// json-gold/9: an rdf:langString literal without a language is serialised as "a"@ ., which
+// the parser then refuses.
+func TestHegelPinLangStringWithoutLanguage(t *testing.T) {
+	ds := ld.NewRDFDataset()
+	ds.Graphs["@default"] = []*ld.Quad{ld.NewQuad(ld.NewIRI("http://example.org/s"), ld.NewIRI("http://example.org/p"), ld.NewLiteral("a", ld.RDFLangString, ""), "@default")}
+	out, err := (&ld.NQuadRDFSerializer{}).Serialize(ds)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ld.ParseNQuads(out.(string)); err != nil {
+		t.Errorf("serialised as %q, which does not parse back: %v", out, err)
+	}
+}
+
+// json-gold/11: Flatten drops a named graph whose nodes have no properties instead of giving
+// its node an empty @graph.
+func TestHegelPinFlattenEmptyNamedGraph(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	doc := map[string]interface{}{"@id": "http://example.org/n3", "@graph": []interface{}{map[string]interface{}{"@id": "http://example.org/n1"}}}
+	out, err := proc.Flatten(doc, nil, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `[{"@graph":[],"@id":"http://example.org/n3"}]`
+	if got := canon(mustJSON(out)); got != want {
+		t.Errorf("Flatten of %s gives %s, the node map has the graph node %s (pyld and jsonld.js)", mustJSON(doc), got, want)
+	}
+}
+
+// json-gold/12: an error while expanding the items of an explicit @set or @list is discarded:
+// the invalid item becomes {} (or null in a list) and Expand reports success.
+func TestHegelPinExpandSetItemError(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	for _, c := range []struct {
+		name string
+		doc  interface{}
+	}{
+		{"@set", map[string]interface{}{"@id": "http://example.org/s", "http://example.org/p": map[string]interface{}{"@set": []interface{}{map[string]interface{}{"@id": 5.0}}}}},
+		{"@list", map[string]interface{}{"@id": "http://example.org/s", "http://example.org/p": map[string]interface{}{"@list": []interface{}{map[string]interface{}{"@id": 5.0}}}}},
+	} {
+		out, err := proc.Expand(c.doc, options())
+		if err == nil {
+			t.Errorf("Expand of a node with a non-string @id inside %s gives %s and no error (invalid @id value)", c.name, mustJSON(out))
+		}
+	}
+}
+
+// json-gold/13: an empty @list value of a term with a type or language mapping is compacted
+// under the full IRI instead of the term (a term with @type: @id, or none, gets the term).
+func TestHegelPinCompactEmptyListTerm(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	ctx := map[string]interface{}{
+		"p3": map[string]interface{}{"@id": "http://ex.org/vocab#p3", "@type": "http://www.w3.org/2001/XMLSchema#boolean"},
+		"p4": map[string]interface{}{"@id": "http://ex.org/vocab#p4", "@language": "en"},
+	}
+	doc := map[string]interface{}{"@id": "http://example.org/s", "http://ex.org/vocab#p3": map[string]interface{}{"@list": []interface{}{}}, "http://ex.org/vocab#p4": map[string]interface{}{"@list": []interface{}{}}}
+	out, err := proc.Compact(doc, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, term := range []string{"p3", "p4"} {
+		if _, ok := out[term]; !ok {
+			t.Errorf("empty @list of %s compacted as %s, not under the term (pyld and jsonld.js select %s)", term, mustJSON(out), term)
+		}
+	}
+}
+
+// json-gold/14: FromRDF with UseNativeTypes fails on an xsd:integer beyond int64 or an
+// xsd:double beyond float64, valid literals the spec converts (or keeps as strings).
+func TestHegelPinNativeTypesBigNumbers(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	fo := options()
+	fo.UseNativeTypes = true
+	for _, lit := range []string{
+		`"12345678901234567890"^^<http://www.w3.org/2001/XMLSchema#integer>`,
+		`"1E400"^^<http://www.w3.org/2001/XMLSchema#double>`,
+	} {
+		if _, err := proc.FromRDF("<http://example.org/s> <http://example.org/p> "+lit+" .\n", fo); err != nil {
+			t.Errorf("FromRDF with UseNativeTypes of %s: %v", lit, err)
+		}
+	}
+}
+
+// json-gold/10: FromRDF's documentation gives useNativeTypes the default true; the options
+// default is false.
+func TestHegelPinUseNativeTypesDocumentedDefault(t *testing.T) {
+	src, err := os.ReadFile("../ld/processor.go")
+	if err != nil {
+		t.Skip("source not at hand")
+	}
+	m := regexp.MustCompile(`(?s)\[useNativeTypes\].{0,200}?\(default: (true|false)\)`).FindSubmatch(src)
+	if m == nil {
+		return // the sentence is gone: nothing to hold the code to
+	}
+	documented := string(m[1]) == "true"
+	if actual := ld.NewJsonLdOptions("").UseNativeTypes; actual != documented {
+		t.Errorf("FromRDF documents useNativeTypes (default: %v); NewJsonLdOptions sets %v", documented, actual)
+	}
+}
diff --git a/hegel/hegel_rdf_test.go b/hegel/hegel_rdf_test.go
new file mode 100644
index 0000000..9d6be9f
--- /dev/null
+++ b/hegel/hegel_rdf_test.go
@@ -0,0 +1,271 @@
+package hegel
+
+// RDF: ToRDF, Normalize (URDNA2015), FromRDF and the N-Quads parser against pyld.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/piprate/json-gold/ld"
+	"hegel.dev/go/hegel"
+)
+
+// The documents and datasets of each property: every shape by default; under
+// HEGEL_NO_KNOWN=1 without the shapes of the bugs recorded against the property.
+var (
+	// rdfDocs (ToRDF, Normalize): without keyword-shaped values (json-gold/8) and non-ASCII
+	// relative IRIs (json-gold/2).
+	rdfDocs = documents(docOpts{keywordValues: !noKnown, unicodeIRIs: !noKnown, nullTerms: true, slashBases: true, anonymousGraphs: true})
+	// roundTripDocs (the RDF round trip): without keyword-shaped values (json-gold/8, and
+	// json-gold/7 through the language-tagged literal "@id"@en).
+	roundTripDocs = documents(docOpts{keywordValues: !noKnown, unicodeIRIs: true, nullTerms: true, slashBases: true, anonymousGraphs: true})
+	// fromRDFQuads, per useNativeTypes: without a literal starting with @ under a language
+	// tag (json-gold/7) and numbers beyond int64/float64 (json-gold/14).
+	fromRDFQuads = map[bool]hegel.Generator[string]{
+		false: quads(nqOpts{atLiterals: !noKnown, langString: true, bigNumbers: true}),
+		true:  quads(nqOpts{native: true, atLiterals: !noKnown, langString: true, bigNumbers: !noKnown}),
+	}
+	// parseQuads: without a literal starting with @ under a language tag (json-gold/7) and
+	// rdf:langString literals without a language (json-gold/9).
+	parseQuads = quads(nqOpts{atLiterals: !noKnown, langString: !noKnown, bigNumbers: true})
+)
+
+// fromRDFCase: a dataset and the FromRDF options, useNativeTypes half of the time and
+// useRdfType three times in ten.
+type fromRDFCase struct {
+	nq              string
+	native, rdfType bool
+}
+
+func (c fromRDFCase) GoString() string {
+	return fmt.Sprintf("nquads:\n%s useNativeTypes %v useRdfType %v", c.nq, c.native, c.rdfType)
+}
+
+var fromRDFCases = hegel.FlatMap(chance(50), func(native bool) hegel.Generator[fromRDFCase] {
+	return hegel.Composite(func(tc hegel.TestCase) fromRDFCase {
+		return fromRDFCase{nq: hegel.Draw(tc, fromRDFQuads[native]), native: native, rdfType: hegel.Draw(tc, chance(30))}
+	})
+})
+
+// rdfRoundTripCase: a document and whether FromRDF reads the quads with native types.
+type rdfRoundTripCase struct {
+	doc    document
+	native bool
+}
+
+func (c rdfRoundTripCase) GoString() string {
+	return fmt.Sprintf("%#v\n useNativeTypes %v", c.doc, c.native)
+}
+
+var rdfRoundTripCases = hegel.Composite(func(tc hegel.TestCase) rdfRoundTripCase {
+	return rdfRoundTripCase{doc: hegel.Draw(tc, roundTripDocs), native: hegel.Draw(tc, chance(50))}
+})
+
+func goNQuads(v interface{}, err error) outcome {
+	if err != nil {
+		return outcome{false, err.Error()}
+	}
+	s, ok := v.(string)
+	if !ok {
+		return outcome{false, "not a string: " + mustJSON(v)}
+	}
+	return outcome{true, sortedLines(s)}
+}
+
+func pyNQuads(r nquadsReply) outcome {
+	if !r.Ok {
+		return outcome{false, r.Error + ": " + r.Message}
+	}
+	return outcome{true, sortedLines(r.NQuads)}
+}
+
+// checkToRDF: ToRDF (N-Quads) gives pyld's dataset, exactly or up to blank node relabelling.
+func checkToRDF(ht *hegel.T, doc interface{}) {
+	if stringUnderDouble(doc) {
+		skip(ht, "string under xsd:double")
+	}
+	opts := options()
+	opts.Format = "application/n-quads"
+	proc := ld.NewJsonLdProcessor()
+	g := goNQuads(proc.ToRDF(doc, opts))
+	var r nquadsReply
+	ask(&r, "R", mustJSON(doc), pyOptions(nil))
+	p := pyNQuads(r)
+	if unjudgedLanguageKeyword(g.text, p.text) {
+		skip(ht, "keyword as a language map key")
+	}
+	if g.ok && p.ok && g.text != p.text {
+		// blank node labels are the node map's issuing order, not fixed by the spec: the two
+		// datasets may still be the same up to relabelling (json-gold canonicalises both)
+		nopts := options()
+		nopts.InputFormat = "application/n-quads"
+		nopts.Format = "application/n-quads"
+		nopts.Algorithm = ld.AlgorithmURDNA2015
+		gn, err1 := proc.Normalize(g.text, nopts)
+		pn, err2 := proc.Normalize(p.text, nopts)
+		if err1 == nil && err2 == nil && gn == pn {
+			count("toRDF agree up to blank node labels")
+			return
+		}
+	}
+	judge(ht, "toRDF", doc, "", g, p, shapeIf(hasKeywordValue(doc), "json-gold/8")...)
+}
+
+func TestHegelToRDFMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkToRDF(ht, hegel.Draw(ht, rdfDocs).doc)
+	})
+}
+
+func TestHegelNormalizeMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		doc := hegel.Draw(ht, rdfDocs).doc
+		if stringUnderDouble(doc) {
+			skip(ht, "string under xsd:double")
+		}
+		opts := options()
+		opts.Format = "application/n-quads"
+		opts.Algorithm = ld.AlgorithmURDNA2015
+		proc := ld.NewJsonLdProcessor()
+		g := goNQuads(proc.Normalize(doc, opts))
+		var r nquadsReply
+		ask(&r, "N", mustJSON(doc), pyOptions(nil))
+		p := pyNQuads(r)
+		if unjudgedLanguageKeyword(g.text, p.text) {
+			skip(ht, "keyword as a language map key")
+		}
+		judge(ht, "normalize", doc, "", g, p, shapeIf(hasKeywordValue(doc), "json-gold/8")...)
+	})
+}
+
+// checkFromRDF: FromRDF of the dataset under the options gives pyld's document.
+func checkFromRDF(ht *hegel.T, c fromRDFCase) {
+	shapes := append(shapeIf(atLiteralWithLang.MatchString(c.nq), "json-gold/7"),
+		shapeIf(c.native && bigNativeNumber(c.nq), "json-gold/14")...)
+	if unjudgedFromRDF(c.nq, c.native) {
+		skip(ht, "native type with an invalid lexical form")
+	}
+	opts := options()
+	opts.UseNativeTypes = c.native
+	opts.UseRdfType = c.rdfType
+	proc := ld.NewJsonLdProcessor()
+	g := goOutcome(proc.FromRDF(c.nq, opts))
+	var r jsonReply
+	ask(&r, "FR", c.nq, mustJSON(map[string]interface{}{"useNativeTypes": c.native, "useRdfType": c.rdfType}))
+	judge(ht, "fromRDF", c.nq, "\n useNativeTypes: "+mustJSON(c.native)+" useRdfType: "+mustJSON(c.rdfType), g, pyOutcome(r), shapes...)
+}
+
+func TestHegelFromRDFMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkFromRDF(ht, hegel.Draw(ht, fromRDFCases))
+	})
+}
+
+// checkNQuads: the N-Quads parser and serializer: what json-gold reads and writes back is
+// what pyld does.
+func checkNQuads(ht *hegel.T, nq string) {
+	shapes := append(shapeIf(atLiteralWithLang.MatchString(nq), "json-gold/7"),
+		shapeIf(langStringTyped.MatchString(nq), "json-gold/9")...)
+	var g outcome
+	ds, err := ld.ParseNQuads(nq)
+	if err != nil {
+		g = outcome{false, err.Error()}
+	} else {
+		g = goNQuads((&ld.NQuadRDFSerializer{}).Serialize(ds))
+	}
+	var r nquadsReply
+	ask(&r, "P", nq)
+	judge(ht, "nquads", nq, "", g, pyNQuads(r), shapes...)
+}
+
+func TestHegelNQuadsParseMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		checkNQuads(ht, hegel.Draw(ht, parseQuads))
+	})
+}
+
+// checkRDFRoundTrip: JSON-LD to RDF and back preserves the dataset: normalising
+// FromRDF(ToRDF(doc)) (with native types when native) gives the normalisation of doc. pyld
+// gets the vote when json-gold's round trip does not close.
+func checkRDFRoundTrip(ht *hegel.T, doc interface{}, native bool) {
+	proc := ld.NewJsonLdProcessor()
+	nopts := options()
+	nopts.Format = "application/n-quads"
+	nopts.Algorithm = ld.AlgorithmURDNA2015
+	want, err := proc.Normalize(doc, nopts)
+	if err != nil {
+		skip(ht, "normalize error")
+	}
+	ropts := options()
+	ropts.Format = "application/n-quads"
+	nq, err := proc.ToRDF(doc, ropts)
+	if err != nil {
+		fail(ht, "Normalize works but ToRDF fails: %v\n doc: %s", err, mustJSON(doc))
+		return
+	}
+	quads := nq.(string)
+	if noKnown && native && integerTyped.MatchString(quads) {
+		// an xsd:integer read back as a native int64 crashes ToRDF (json-gold/6): the
+		// neighbouring region is the round trip without native types
+		count("native types off: xsd:integer in the quads (json-gold/6)")
+		native = false
+	}
+	shapes := append(shapeIf(native && integerTyped.MatchString(quads), "json-gold/6"),
+		shapeIf(atLiteralWithLang.MatchString(quads), "json-gold/7")...) // the parser mangles the literal
+	if unjudgedFromRDF(quads, native) {
+		// e.g. a boolean coerced to xsd:double: "true"^^xsd:double, see unjudgedFromRDF
+		skip(ht, "native type with an invalid lexical form")
+	}
+	if hasDuplicateLines(quads) {
+		// repeated values that the node map does not merge (empty lists, and values
+		// under some containers) give the same quad twice in json-gold, pyld and jsonld.js
+		// alike; FromRDF reads a set. Not judged.
+		skip(ht, "duplicate quads")
+	}
+	fopts := options()
+	fopts.UseNativeTypes = native
+	back, err := proc.FromRDF(quads, fopts)
+	if err != nil {
+		mismatch(ht, shapes, "FromRDF of json-gold's own N-Quads fails: %v\n doc: %s\n nquads:\n%s", err, mustJSON(doc), quads)
+		return
+	}
+	got, err, panicked := guarded(func() (interface{}, error) { return proc.Normalize(back, nopts) })
+	if panicked != nil {
+		mismatch(ht, shapes, "Normalize of FromRDF(ToRDF(doc)) panics: %v\n doc: %s\n back: %s", panicked, mustJSON(doc), mustJSON(back))
+		return
+	}
+	if err != nil {
+		mismatch(ht, shapes, "Normalize of FromRDF(ToRDF(doc)) fails: %v\n doc: %s\n back: %s", err, mustJSON(doc), mustJSON(back))
+		return
+	}
+	if strings.TrimSpace(want.(string)) == strings.TrimSpace(got.(string)) {
+		count("round trip closes")
+		return
+	}
+	var f jsonReply
+	ask(&f, "FR", quads, mustJSON(map[string]interface{}{"useNativeTypes": native}))
+	py := "pyld: from_rdf error " + f.Error
+	if f.Ok {
+		var nr nquadsReply
+		ask(&nr, "N", string(f.Result), pyOptions(nil))
+		if nr.Ok {
+			if strings.TrimSpace(nr.NQuads) == strings.TrimSpace(want.(string)) {
+				py = "pyld's from_rdf of the same N-Quads normalises to the original"
+			} else {
+				py = "pyld's from_rdf of the same N-Quads normalises to\n" + nr.NQuads
+			}
+		} else {
+			py = "pyld: normalize error " + nr.Error
+		}
+	}
+	mismatch(ht, shapes, "RDF round trip changes the dataset (useNativeTypes %v)\n doc: %s\n nquads:\n%s\n back: %s\n normalized before:\n%s\n normalized after:\n%s\n %s",
+		native, mustJSON(doc), quads, mustJSON(back), want, got, py)
+}
+
+func TestHegelRDFRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, rdfRoundTripCases)
+		checkRDFRoundTrip(ht, c.doc.doc, c.native)
+	})
+}
diff --git a/hegel/hegel_shapes_test.go b/hegel/hegel_shapes_test.go
new file mode 100644
index 0000000..d9565ad
--- /dev/null
+++ b/hegel/hegel_shapes_test.go
@@ -0,0 +1,901 @@
+package hegel
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents (a small record of the varying parts, rendered into a document or N-Quads
+// by pure functions over the pools of gen.go), checked by the oracle call of the wide
+// property that meets the bug (the check helpers of hegel_algos_test.go and
+// hegel_rdf_test.go: Expand, Compact, Flatten and ToRDF against pyld, FromRDF and the
+// N-Quads parser against pyld, the RDF round trip), so that each bug has a property that
+// finds it every run and shrinks to a minimal example of it; the wide properties reach the
+// shapes at their natural rate. json-gold/10 (a documentation default) has no random
+// contents to draw: its pin is its evidence. Under HEGEL_NO_KNOWN=1 every property here is
+// skipped as a known shape off: its whole domain is the bug's shape.
+
+import (
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// shapeOff skips a narrow property under HEGEL_NO_KNOWN=1 (noKnown, hegel_test.go).
+func shapeOff(t *testing.T, id string) {
+	t.Helper()
+	if noKnown {
+		t.Skipf("the shape of %s is off under HEGEL_NO_KNOWN=1", id)
+	}
+}
+
+// Shared pieces ------------------------------------------------------------------------------
+
+var (
+	// segments: an IRI path segment.
+	segments = hegel.FromRegex("[a-z0-9]{1,5}", true)
+	// plainWords: IRI-safe ASCII words without the keyword shape of json-gold/8.
+	plainWords = wordsOf(false, false)
+	// plainValues: a word three times in five, an integer, a boolean.
+	plainValues = weighted(
+		choice[interface{}]{3, asAny(plainWords)},
+		choice[interface{}]{1, asAny(ints)},
+		choice[interface{}]{1, asAny(hegel.Booleans())},
+	)
+	// vocabProps: a property of the vocabulary as its full IRI.
+	vocabProps = hegel.Map(termName, func(s string) string { return vocab + s })
+	// someProps: one to three properties of the vocabulary with plain values.
+	someProps = hegel.Maps(vocabProps, plainValues).MinSize(1).MaxSize(3)
+	// subjectIDs: a node's @id: an absolute IRI two times in three, else a blank node.
+	subjectIDs = weighted(choice[string]{2, absoluteIRIs}, choice[string]{1, blankNodes})
+	// graphNames: the graph name of a quad (with its leading space), one time in three.
+	graphNames = maybe(30, hegel.Map(nqTerms, func(g string) string { return " " + g }))
+	// positions: an index taken modulo a live length.
+	positions = hegel.Integers(0, 99)
+	// plainContexts: a local context without the shapes of json-gold/1, /2, /5 and /8.
+	plainContexts = contexts(docOpts{})
+	// plainQuads: a dataset without the shapes of json-gold/7, /9 and /14, around a quad.
+	plainQuads = quads(nqOpts{})
+	// nativeQuads: the same for a dataset read with native types (judged lexical forms only).
+	nativeQuads = quads(nqOpts{native: true})
+)
+
+// nodeOf: an expanded-form node of the id ("" for none) and the properties.
+func nodeOf(id string, props map[string]interface{}) map[string]interface{} {
+	node := map[string]interface{}{}
+	if id != "" {
+		node["@id"] = id
+	}
+	for k, v := range props {
+		node[k] = v
+	}
+	return node
+}
+
+// quadLine: one N-Quads line (the graph name carries its leading space, "" for none).
+func quadLine(s, p, o, g string) string { return s + " " + p + " " + o + g + " .\n" }
+
+// --------------------------------------------------------------------------- json-gold/1
+
+// slashBaseCase: a compaction context whose @base ends in a slash, and an IRI of the same
+// host that shares the base's leading directories and diverges below them (json-gold/1:
+// RemoveBase counts the empty segment after the base's final slash as a directory to climb,
+// one ../ too many), placed as the node's @id, as a node reference under a property, or as
+// the value of a term typed @id.
+type slashBaseCase struct {
+	host          string
+	common, extra []string // the shared directories; the base's further directories
+	tail          []string // the IRI's segments below the shared ones, the first unlike extra[0]
+	suffix        string   // "", a query or a fragment
+	where         int      // 0: the node's @id, 1: {"@id": iri} under a property, 2: the value of a term typed @id
+	props         map[string]interface{}
+	compactArrays bool
+}
+
+func (c slashBaseCase) base() string {
+	return c.host + "/" + strings.Join(slices.Concat(c.common, c.extra), "/") + "/"
+}
+
+func (c slashBaseCase) iri() string {
+	return c.host + "/" + strings.Join(slices.Concat(c.common, c.tail), "/") + c.suffix
+}
+
+// docAndCtx: the expanded-form document and the compaction context.
+func (c slashBaseCase) docAndCtx() (interface{}, map[string]interface{}) {
+	ctx := map[string]interface{}{"@base": c.base()}
+	var node map[string]interface{}
+	switch c.where {
+	case 0:
+		node = nodeOf(c.iri(), c.props)
+	default:
+		node = nodeOf("_:b0", c.props)
+		node[vocab+"ref"] = map[string]interface{}{"@id": c.iri()}
+		if c.where == 2 {
+			ctx["ref"] = map[string]interface{}{"@id": vocab + "ref", "@type": "@id"}
+		}
+	}
+	return viaJSON(node), viaJSON(ctx).(map[string]interface{})
+}
+
+func (c slashBaseCase) GoString() string {
+	doc, ctx := c.docAndCtx()
+	return fmt.Sprintf("doc %s\n ctx %s\n compactArrays %v", mustJSON(doc), mustJSON(ctx), c.compactArrays)
+}
+
+var (
+	hosts        = hegel.SampledFrom([]string{"http://example.org", "http://ex.org"})
+	segmentLists = hegel.Lists(segments).MinSize(1).MaxSize(2)
+	iriSuffixes  = hegel.SampledFrom([]string{"", "", "?q=1", "#f"})
+)
+
+var slashBaseCases = hegel.Composite(func(tc hegel.TestCase) slashBaseCase {
+	c := slashBaseCase{
+		host:          hegel.Draw(tc, hosts),
+		common:        hegel.Draw(tc, segmentLists),
+		extra:         hegel.Draw(tc, segmentLists),
+		tail:          slices.Clone(hegel.Draw(tc, segmentLists)),
+		suffix:        hegel.Draw(tc, iriSuffixes),
+		where:         hegel.Draw(tc, hegel.Integers(0, 2)),
+		props:         hegel.Draw(tc, someProps),
+		compactArrays: hegel.Draw(tc, chance(75)),
+	}
+	if c.tail[0] == c.extra[0] {
+		c.tail[0] += "-" // the IRI leaves the base's directory
+	}
+	return c
+})
+
+// TestHegelRelativeIRIsCompactAgainstSlashBase: compacting an IRI against a @base ending in
+// a slash gives the relative reference RFC 3986 resolves back to it (pyld's ../c for
+// http://example.org/a/c against http://example.org/a/b/); json-gold gives one ../ too many,
+// a reference to another resource (json-gold/1).
+func TestHegelRelativeIRIsCompactAgainstSlashBase(t *testing.T) {
+	shapeOff(t, "json-gold/1")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, slashBaseCases)
+		doc, ctx := c.docAndCtx()
+		checkCompact(ht, doc, ctx, c.compactArrays)
+	})
+}
+
+// --------------------------------------------------------------------------- json-gold/2
+
+// unicodeIRICase: a relative IRI reference with a non-ASCII word in its path or fragment
+// (json-gold/2: Resolve percent-encodes it; a query alone is passed through), placed as the
+// node's @id, as the value of a term typed @id, in a node reference or as a @type, against
+// the document base or a @base of the context.
+type unicodeIRICase struct {
+	fragment  bool   // "#word", else pre + word + post
+	pre, post string // a path below the base or a step up; a further segment, query or fragment
+	word      string
+	where     int    // 0: the node's @id, 1: the value of a term typed @id, 2: {"@id": ref} under a property, 3: a @type
+	base      string // "" the document base, else a @base of the context
+	props     map[string]interface{}
+}
+
+func (c unicodeIRICase) ref() string {
+	if c.fragment {
+		return "#" + c.word
+	}
+	return c.pre + c.word + c.post
+}
+
+func (c unicodeIRICase) doc() interface{} {
+	ctx := map[string]interface{}{}
+	if c.base != "" {
+		ctx["@base"] = c.base
+	}
+	node := nodeOf("http://example.org/n0", c.props)
+	switch c.where {
+	case 0:
+		node["@id"] = c.ref()
+	case 1:
+		ctx["ref"] = map[string]interface{}{"@id": vocab + "ref", "@type": "@id"}
+		node["ref"] = c.ref()
+	case 2:
+		node[vocab+"ref"] = map[string]interface{}{"@id": c.ref()}
+	default:
+		node["@type"] = c.ref()
+	}
+	if len(ctx) > 0 {
+		node["@context"] = ctx
+	}
+	return viaJSON(node)
+}
+
+func (c unicodeIRICase) GoString() string { return "doc " + mustJSON(c.doc()) }
+
+var (
+	nonASCIIWords = hegel.SampledFrom([]string{"caf\u00e9", "\u00e9", "\u00fcber", "\u65e5\u672c", "\u03b1\u03b2", "na\u00efve", "\u00f8l"})
+	refPrefixes   = hegel.SampledFrom([]string{"", "", "sub/", "../"})
+	refSuffixes   = hegel.SampledFrom([]string{"", "", "1", "/x", "?q=1", "#f"})
+	refBases      = hegel.SampledFrom([]string{"", "", "http://example.org/other/", "http://example.org/base/doc2"})
+)
+
+var unicodeIRICases = hegel.Composite(func(tc hegel.TestCase) unicodeIRICase {
+	return unicodeIRICase{
+		fragment: hegel.Draw(tc, chance(25)),
+		pre:      hegel.Draw(tc, refPrefixes),
+		post:     hegel.Draw(tc, refSuffixes),
+		word:     hegel.Draw(tc, nonASCIIWords),
+		where:    hegel.Draw(tc, hegel.Integers(0, 3)),
+		base:     hegel.Draw(tc, refBases),
+		props:    hegel.Draw(tc, someProps),
+	}
+})
+
+// TestHegelNonASCIIIRIsStayUnencoded: a relative IRI reference with a non-ASCII character
+// resolves to an IRI with that character (RFC 3987 section 6.5, pyld); json-gold's Resolve
+// percent-encodes it, so the expanded @id denotes another resource (json-gold/2).
+func TestHegelNonASCIIIRIsStayUnencoded(t *testing.T) {
+	shapeOff(t, "json-gold/2")
+	property(t, func(ht *hegel.T) {
+		checkExpand(ht, hegel.Draw(ht, unicodeIRICases).doc())
+	})
+}
+
+// --------------------------------------------------------------------------- json-gold/3
+
+// emptyCompactionCase: nodes with only an @id (nothing to output), compacted with a
+// non-empty context (json-gold/3: Compact adds the @context only when the output has
+// members).
+type emptyCompactionCase struct {
+	ids           []string // one to three
+	array         bool     // the document is an array even for one node
+	ctx           map[string]interface{}
+	compactArrays bool
+}
+
+func (c emptyCompactionCase) doc() interface{} {
+	if !c.array && len(c.ids) == 1 {
+		return viaJSON(nodeOf(c.ids[0], nil))
+	}
+	nodes := make([]interface{}, len(c.ids))
+	for i, id := range c.ids {
+		nodes[i] = nodeOf(id, nil)
+	}
+	return viaJSON(nodes)
+}
+
+func (c emptyCompactionCase) GoString() string {
+	return fmt.Sprintf("doc %s\n ctx %s\n compactArrays %v", mustJSON(c.doc()), mustJSON(c.ctx), c.compactArrays)
+}
+
+// nonEmptyContexts: a plain context with the ex prefix in it, so that it is never empty (an
+// empty context compacts to {} in both processors).
+var nonEmptyContexts = hegel.Map(plainContexts, func(ctx map[string]interface{}) map[string]interface{} {
+	ctx["ex"] = vocab
+	return ctx
+})
+
+var emptyCompactionCases = hegel.Composite(func(tc hegel.TestCase) emptyCompactionCase {
+	return emptyCompactionCase{
+		ids:           hegel.Draw(tc, hegel.Lists(subjectIDs).MinSize(1).MaxSize(3)),
+		array:         hegel.Draw(tc, chance(30)),
+		ctx:           hegel.Draw(tc, nonEmptyContexts),
+		compactArrays: hegel.Draw(tc, chance(75)),
+	}
+})
+
+// TestHegelEmptyCompactionKeepsContext: compacting a document with nothing to output gives
+// {@context: ...} (the API's compact() adds @context whenever the context is not null, as
+// pyld does); json-gold gives {} (json-gold/3).
+func TestHegelEmptyCompactionKeepsContext(t *testing.T) {
+	shapeOff(t, "json-gold/3")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, emptyCompactionCases)
+		checkCompact(ht, c.doc(), c.ctx, c.compactArrays)
+	})
+}
+
+// --------------------------------------------------------------------------- json-gold/4
+
+// providedContextCase: a flattening context with at least one entry that json-gold's
+// re-serialisation of the active context spells differently (json-gold/4: Flatten returns
+// that instead of the provided context): a term defined as its full IRI beside the ex
+// prefix (rewritten as ex:term), @vocab "" (resolved to the base), a term defined as
+// {"@id": iri} alone (collapsed to a string); and a node with properties to flatten.
+type providedContextCase struct {
+	features []int  // one to three of 0, 1, 2 as above
+	term     string // the term of feature 0
+	term2    string // the term of feature 2
+	version  bool
+	language string // "" none
+	id       string
+	props    map[string]interface{}
+}
+
+func (c providedContextCase) ctx() map[string]interface{} {
+	ctx := map[string]interface{}{}
+	for _, f := range c.features {
+		switch f {
+		case 0:
+			ctx["ex"] = vocab
+			ctx[c.term] = vocab + c.term
+		case 1:
+			ctx["@vocab"] = ""
+		default:
+			ctx[c.term2] = map[string]interface{}{"@id": vocab + c.term2}
+		}
+	}
+	if c.version {
+		ctx["@version"] = 1.1
+	}
+	if c.language != "" {
+		ctx["@language"] = c.language
+	}
+	return viaJSON(ctx).(map[string]interface{})
+}
+
+func (c providedContextCase) doc() interface{} { return viaJSON(nodeOf(c.id, c.props)) }
+
+func (c providedContextCase) GoString() string {
+	return fmt.Sprintf("doc %s\n ctx %s", mustJSON(c.doc()), mustJSON(c.ctx()))
+}
+
+var providedContextCases = hegel.Composite(func(tc hegel.TestCase) providedContextCase {
+	return providedContextCase{
+		features: hegel.Draw(tc, hegel.Lists(hegel.Integers(0, 2)).MinSize(1).MaxSize(3)),
+		term:     hegel.Draw(tc, termName),
+		term2:    hegel.Draw(tc, hegel.SampledFrom([]string{"q1", "q2"})),
+		version:  hegel.Draw(tc, chance(30)),
+		language: hegel.Draw(tc, maybe(20, languages)),
+		id:       hegel.Draw(tc, subjectIDs),
+		props:    hegel.Draw(tc, someProps),
+	}
+})
+
+// TestHegelFlattenReturnsTheProvidedContext: Flatten with a context returns that context
+// verbatim as the output's @context (the API's flatten() compacts with it, and compact()'s
+// output carries the provided context; pyld and jsonld.js return it as given); json-gold
+// returns a re-serialisation of the active context (json-gold/4).
+func TestHegelFlattenReturnsTheProvidedContext(t *testing.T) {
+	shapeOff(t, "json-gold/4")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, providedContextCases)
+		checkFlatten(ht, c.doc(), c.ctx())
+	})
+}
+
+// --------------------------------------------------------------------------- json-gold/5
+
+// nullTermCase: a flattening context with a term set to null (the spec's way of removing
+// a term; json-gold/5: Context.Serialize dereferences the nil definition it leaves) and a
+// node with properties, so that there is output to serialise the context for.
+type nullTermCase struct {
+	ctx      map[string]interface{}
+	nullTerm string
+	id       string
+	props    map[string]interface{}
+}
+
+func (c nullTermCase) fullCtx() map[string]interface{} {
+	ctx := map[string]interface{}{}
+	for k, v := range c.ctx {
+		ctx[k] = v
+	}
+	ctx[c.nullTerm] = nil
+	return ctx
+}
+
