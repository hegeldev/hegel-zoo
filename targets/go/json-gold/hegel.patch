+// TestHegelFlattenKeepsEmptyNamedGraphs: flattening a named graph whose nodes have nothing
+// but an @id keeps the graph's node with an empty @graph, as the flattening algorithm, pyld
+// and jsonld.js do; json-gold drops it (json-gold/11).
+func TestHegelFlattenKeepsEmptyNamedGraphs(t *testing.T) {
