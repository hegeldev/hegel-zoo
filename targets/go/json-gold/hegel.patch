+// --------------------------------------------------------------------------- json-gold/11
+
+// emptyGraph: a named graph whose nodes have only an @id, or only undefined terms (dropped
+// on expansion).
+type emptyGraph struct {
+	id        string
+	nodes     []string
+	undefined bool
+}
+
+func (g emptyGraph) render() map[string]interface{} {
+	items := make([]interface{}, len(g.nodes))
+	for i, n := range g.nodes {
+		node := map[string]interface{}{"@id": n}
+		if g.undefined {
+			node["undefined"] = i
+		}
+		items[i] = node
+	}
+	return map[string]interface{}{"@id": g.id, "@graph": items}
+}
+
+// emptyGraphCase: one or two such graphs, beside a plain node one time in three, flattened
+// without a context (json-gold/11: the graph's node, left with an empty @graph, is dropped).
+type emptyGraphCase struct {
+	graphs []emptyGraph
+	plain  map[string]interface{} // nil for none
+	array  bool
+}
+
+func (c emptyGraphCase) doc() interface{} {
+	var nodes []interface{}
+	for _, g := range c.graphs {
+		nodes = append(nodes, g.render())
+	}
+	if c.plain != nil {
+		nodes = append(nodes, c.plain)
+	}
+	if !c.array && len(nodes) == 1 {
+		return viaJSON(nodes[0])
+	}
+	return viaJSON(nodes)
+}
+
+func (c emptyGraphCase) GoString() string { return "doc " + mustJSON(c.doc()) + "\n flatten ctx none" }
+
+var (
+	graphIDs    = hegel.Map(hegel.Integers(0, 2), func(i int) string { return fmt.Sprintf("http://example.org/g%d", i) })
+	emptyGraphs = hegel.Composite(func(tc hegel.TestCase) emptyGraph {
