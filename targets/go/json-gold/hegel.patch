+	plainNodes = hegel.Composite(func(tc hegel.TestCase) map[string]interface{} {
+		return nodeOf(hegel.Draw(tc, absoluteIRIs), hegel.Draw(tc, someProps))
+	})
+	emptyGraphCases = hegel.Composite(func(tc hegel.TestCase) emptyGraphCase {
+		return emptyGraphCase{
+			graphs: hegel.Draw(tc, hegel.Lists(emptyGraphs).MinSize(1).MaxSize(2)),
+			plain:  hegel.Draw(tc, maybe(30, plainNodes)),
+			array:  hegel.Draw(tc, chance(30)),
+		}
+	})
