+			id:        hegel.Draw(tc, weighted(choice[string]{2, graphIDs}, choice[string]{1, blankNodes})),
+			nodes:     hegel.Draw(tc, hegel.Lists(subjectIDs).MinSize(1).MaxSize(3)),
+			undefined: hegel.Draw(tc, chance(25)),
+		}
