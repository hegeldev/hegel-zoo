+package hegel
+
+// Hegel property tests for piprate/json-gold against pyld, Digital Bazaar's Python JSON-LD
+// 1.1 processor, on the same generated documents: the harness (property, the panic
+// wrapper, counts and collect mode), the generator idioms the binding lacks, and the
+// known-bug switch. The properties are in hegel_algos_test.go and hegel_rdf_test.go, the
+// generators in gen.go, the shape recognisers in known.go, the oracle in oracle.go and one
+// deterministic reproducer per recorded bug in hegel_pins_test.go.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn by default, so the properties that
+// meet them fail, naming the shape, and are the expected failures mapped to the bugs
+// (STYLE.md rule 11). HEGEL_NO_KNOWN=1 (noKnown, read once) switches the shapes off: each
+// property builds its grammar without the shapes of the bugs recorded against it, a
+// disagreement whose only difference is a recorded defect of the output (the vote shapes
+// json-gold/2, /3, /4, /11, /13) counts as agreement up to it, and one that still has a
+// shape drawn by construction is skipped.
+//
+// Set HEGEL_COLLECT=1 to record mismatches instead of failing and print them at the end.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test); Hegel's own control-flow panics pass.
+// The COUNT lines at the end tally the kinds of cases (agreements, known shapes, skips).
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a disagreement on a case that has the shape of the recorded bugs named
+// (none for a plain failure): the failure names the shapes; under HEGEL_NO_KNOWN=1 a
+// disagreement on a known shape is skipped instead (rare then, since the generators leave
+// the shapes out: the count shows a leak).
+func mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	if len(shapes) > 0 {
+		if noKnown {
+			count("known " + strings.Join(shapes, " "))
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	fail(ht, format, args...)
+}
+
+// skip rejects a case that is not judged, counting why.
+func skip(ht *hegel.T, why string) {
+	count("not judged: " + why)
+	ht.Assume(false)
+}
+
+// shapeIf names the bug when the case has its shape.
+func shapeIf(has bool, id string) []string {
+	if has {
+		return []string{id}
+	}
+	return nil
+}
+
+// guarded calls fn, turning a panic into its third result (a panic of the library is a
+// finding of the property, reported with the case's shape).
+func guarded(fn func() (interface{}, error)) (v interface{}, err error, panicked interface{}) {
+	defer func() {
+		if r := recover(); r != nil {
+			panicked = r
+		}
+	}()
+	v, err = fn()
+	return
+}
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so
+// the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is
+// what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// optional generates a pointer to a value of g pct percent of the time and nil otherwise
+// (for values whose zero value is a value in its own right).
+func optional[T any](pct int, g hegel.Generator[T]) hegel.Generator[*T] {
+	return maybe(pct, hegel.Map(g, ptrTo[T]))
+}
+
+// pair holds two independent draws as one value (the binding has no tuple combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// asAny is g as a generator of interface{} (for the alternatives of a mixed choice).
+func asAny[T any](g hegel.Generator[T]) hegel.Generator[interface{}] {
+	return hegel.Map(g, func(x T) interface{} { return x })
+}
+
+// deferred draws through a pointer to a generator, so that a recursive grammar can name a
+// generator before it is built (the forward declaration of hegel-go's
+// ExampleComposite_recursive).
+func deferred[T any](g *hegel.Generator[T]) hegel.Generator[T] {
+	return hegel.Composite(func(tc hegel.TestCase) T { return hegel.Draw(tc, *g) })
+}
+
+// nonNil makes an empty list a non-nil one (Lists yields nil for zero elements, whose JSON
+// text would be null).
+func nonNil[T any](xs []T) []T {
+	if xs == nil {
+		return []T{}
+	}
+	return xs
+}
+
+// stringList is the strings as a JSON array value.
+func stringList(ss []string) []interface{} {
+	out := make([]interface{}, len(ss))
+	for i, s := range ss {
+		out[i] = s
+	}
+	return out
+}
+
+// replace is the pool with one entry replaced.
+func replace(pool []string, from, to string) []string {
+	out := make([]string, len(pool))
+	for i, s := range pool {
+		if s == from {
+			s = to
+		}
+		out[i] = s
+	}
+	return out
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..6734463
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,570 @@
+package hegel
+
+// The shapes of the recorded bugs (bugs.toml), recognised on the drawn data (a shape the
+// case has by construction) or on the two outputs (a defect of json-gold's output that,
+// taken away, leaves the two in agreement: the vote shapes), so that a disagreement names
+// the bug it has the shape of. Nothing here gates a case: the generators draw every shape
+// by default and leave a bug's shape out under HEGEL_NO_KNOWN=1 (gen.go), and the harness
+// (mismatch, judge) decides what a recognised shape means in each mode.
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"math"
+	"math/bits"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+var (
+	keywordLike = regexp.MustCompile(`^@[a-zA-Z]+$`)
+	// a literal whose text starts with @ and carries a language tag
+	atLiteralWithLang = regexp.MustCompile(`"@[^"]*"@[A-Za-z]`)
+	langStringTyped   = regexp.MustCompile(`\^\^<http://www\.w3\.org/1999/02/22-rdf-syntax-ns#langString>`)
+	integerTyped      = regexp.MustCompile(`\^\^<http://www\.w3\.org/2001/XMLSchema#integer>`)
+	typedLexical      = regexp.MustCompile(`"((?:[^"\\]|\\.)*)"\^\^<http://www\.w3\.org/2001/XMLSchema#(integer|double|boolean)>`)
+	patternInteger    = regexp.MustCompile(`^[\-+]?\d+$`)
+	patternDouble     = regexp.MustCompile(`^(\+|-)?(\d+(\.\d*)?|\.\d+)([Ee](\+|-)?\d+)?$`)
+	percentEscape     = regexp.MustCompile(`%[0-9A-Fa-f]{2}`)
+	illFormedIRI      = regexp.MustCompile("<[^<>]*[ \"\\\\{}|^`\x00-\x1f\x7f][^<>]*>")
+)
+
+// Shapes by construction ---------------------------------------------------------------------
+
+// ctxBaseSlash: the compaction context sets a @base ending in a slash (json-gold/1, the
+// relative IRI computed against such a base climbs one directory too many).
+func ctxBaseSlash(ctx interface{}) bool {
+	m, ok := ctx.(map[string]interface{})
+	if !ok {
+		return false
+	}
+	b, ok := m["@base"].(string)
+	return ok && strings.HasSuffix(b, "/")
+}
+
+// fragmentUnderSlashBase: a node @id "#frag" resolved against a @base ending in a slash gives
+// .../#frag, which compacts against the document base .../doc to "#frag" and so re-expands to
+// .../doc#frag (json-gold/1: RemoveBase drops the empty last segment; pyld and jsonld.js too).
+func fragmentUnderSlashBase(doc interface{}, docCtx interface{}) bool {
+	if !ctxBaseSlash(docCtx) {
+		return false
+	}
+	for _, nd := range topNodesOf(doc) {
+		if id, ok := nd["@id"].(string); ok && strings.HasPrefix(id, "#") {
+			return true
+		}
+		if graph, ok := nd["@graph"].([]interface{}); ok && fragmentUnderSlashBase(graph, docCtx) {
+			return true
+		}
+	}
+	return false
+}
+
+// ctxNullTerm: the context maps a term to null (json-gold/5, Flatten panics serialising it).
+func ctxNullTerm(ctx interface{}) bool {
+	m, ok := ctx.(map[string]interface{})
+	if !ok {
+		return false
+	}
+	for _, v := range m {
+		if v == nil {
+			return true
+		}
+	}
+	return false
+}
+
+// hasKeywordValue: a string of the form of a keyword (@id, @foo) in a value position of a
+// property (json-gold/8, ToRDF writes it as the IRI <@id>).
+func hasKeywordValue(v interface{}) bool {
+	var walk func(v interface{}, underProp bool) bool
+	walk = func(v interface{}, underProp bool) bool {
+		switch x := v.(type) {
+		case map[string]interface{}:
+			for k, val := range x {
+				switch {
+				case k == "@context":
+					continue
+				case k == "@list" || k == "@set":
+					if walk(val, underProp) {
+						return true
+					}
+				case strings.HasPrefix(k, "@"):
+					if walk(val, false) {
+						return true
+					}
+				default:
+					if walk(val, true) {
+						return true
+					}
+				}
+			}
+		case []interface{}:
+			for _, e := range x {
+				if walk(e, underProp) {
+					return true
+				}
+			}
+		case string:
+			return underProp && keywordLike.MatchString(x)
+		}
+		return false
+	}
+	return walk(v, false)
+}
+
+// docHasSetOrList: the document has an explicit @set or @list object somewhere (json-gold/12
+// when pyld reports an invalid document and json-gold does not: an error while expanding
+// the items of a @set or @list is discarded, the item becomes {} or null).
+func docHasSetOrList(v interface{}) bool {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		for k, val := range x {
+			if k == "@set" || k == "@list" {
+				return true
+			}
+			if k != "@context" && docHasSetOrList(val) {
+				return true
+			}
+		}
+	case []interface{}:
+		for _, e := range x {
+			if docHasSetOrList(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// bigNativeNumber: an xsd:integer beyond int64 or an xsd:double beyond float64 in the
+// dataset, valid literals FromRDF with native types fails on (json-gold/14).
+func bigNativeNumber(nq string) bool {
+	for _, m := range typedLexical.FindAllStringSubmatch(nq, -1) {
+		lex, kind := m[1], m[2]
+		if kind == "integer" && patternInteger.MatchString(lex) {
+			if _, err := strconv.ParseInt(lex, 10, 64); err != nil {
+				return true
+			}
+		}
+		if kind == "double" && patternDouble.MatchString(lex) {
+			if f, err := strconv.ParseFloat(lex, 64); err != nil || math.IsInf(f, 0) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// topNodesOf: the node objects at the top level of a document.
+func topNodesOf(doc interface{}) []map[string]interface{} {
+	nodes, ok := doc.([]interface{})
+	if !ok {
+		nodes = []interface{}{doc}
+	}
+	var out []map[string]interface{}
+	for _, nd := range nodes {
+		if m, ok := nd.(map[string]interface{}); ok {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
+// Not judged ---------------------------------------------------------------------------------
+
+// unjudgedLanguageKeyword: a language map key of the form of a keyword (@set, @list as a
+// language): pyld writes it as a language tag (""@@set), json-gold drops the value. Neither
+// is clearly right; the input is nonsense. Not judged.
+func unjudgedLanguageKeyword(texts ...string) bool {
+	for _, t := range texts {
+		if strings.Contains(t, `"@@`) || strings.Contains(t, `"@language":"@`) {
+			return true
+		}
+	}
+	return false
+}
+
+// stringUnderDouble: a string value under a term coerced to xsd:double, or a value object
+// typed xsd:double with a string @value. The specification's object-to-RDF conversion keeps a
+// string as the literal's lexical form (json-gold does); pyld and jsonld.js canonicalise it as
+// a double ("1" becomes "1.0E0", jsonld.js makes "NaN" of a word). Not judged.
+func stringUnderDouble(doc interface{}) bool {
+	doubleTerms := map[string]bool{}
+	var collect func(v interface{})
+	collect = func(v interface{}) {
+		switch x := v.(type) {
+		case map[string]interface{}:
+			for k, val := range x {
+				if k != "@context" {
+					collect(val)
+					continue
+				}
+				ctx, ok := val.(map[string]interface{})
+				if !ok {
+					continue
+				}
+				for term, def := range ctx {
+					if dm, ok := def.(map[string]interface{}); ok {
+						if t, ok := dm["@type"].(string); ok && (t == xsd+"double" || t == "xsd:double") {
+							doubleTerms[term] = true
+						}
+					}
+				}
+			}
+		case []interface{}:
+			for _, e := range x {
+				collect(e)
+			}
+		}
+	}
+	collect(doc)
+	var hasString func(v interface{}) bool
+	hasString = func(v interface{}) bool {
+		switch x := v.(type) {
+		case string:
+			return true
+		case []interface{}:
+			for _, e := range x {
+				if hasString(e) {
+					return true
+				}
+			}
+		case map[string]interface{}:
+			if items, ok := x["@list"]; ok {
+				return hasString(items)
+			}
+			if items, ok := x["@set"]; ok {
+				return hasString(items)
+			}
+			_, isValue := x["@value"].(string)
+			_, typed := x["@type"]
+			return isValue && !typed
+		}
+		return false
+	}
+	var walk func(v interface{}) bool
+	walk = func(v interface{}) bool {
+		switch x := v.(type) {
+		case map[string]interface{}:
+			if _, ok := x["@value"].(string); ok {
+				if t, ok := x["@type"].(string); ok && (t == xsd+"double" || t == "xsd:double") {
+					return true
+				}
+			}
+			for k, val := range x {
+				if doubleTerms[k] && hasString(val) {
+					return true
+				}
+				if k != "@context" && walk(val) {
+					return true
+				}
+			}
+		case []interface{}:
+			for _, e := range x {
+				if walk(e) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	return walk(doc)
+}
+
+// unjudgedFromRDF: with useNativeTypes, an xsd:integer or xsd:double literal whose lexical form
+// is not a valid number. The spec's RDF to Object Conversion (step 2.4.2.3 then nothing) leaves
+// such a value untyped, which json-gold and jsonld.js do; pyld keeps the datatype, as the test
+// suite's fromRdf#t0027 expects for values that cannot be JSON numbers. Not judged.
+func unjudgedFromRDF(nq string, native bool) bool {
+	if !native {
+		return false
+	}
+	for _, m := range typedLexical.FindAllStringSubmatch(nq, -1) {
+		lex, kind := m[1], m[2]
+		if kind == "integer" && !patternInteger.MatchString(lex) {
+			return true
+		}
+		// pyld converts "1"/"0" (the spec names only true/false) and keeps other forms typed
+		if kind == "boolean" && lex != "true" && lex != "false" {
+			return true
+		}
+		if kind == "double" && (!patternDouble.MatchString(lex) || strings.Contains(strings.ToUpper(lex), "INF") || strings.Contains(lex, "NaN")) {
+			return true
+		}
+		// an integral xsd:double ("1", "-0.0") becomes a JSON number that is an integer, and
+		// so xsd:integer on the way back (pyld too): inherent to native types
+		if kind == "double" && patternDouble.MatchString(lex) {
+			if f, err := strconv.ParseFloat(lex, 64); err == nil && f == math.Trunc(f) && !math.IsInf(f, 0) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// Shapes by the vote -------------------------------------------------------------------------
+
+// voteStep takes one recorded defect away from the two outputs (parsed JSON), so that
+// outputs differing by it alone come out equal.
+type voteStep struct {
+	id  string
+	fix func(g, p interface{}) (interface{}, interface{})
+}
+
+// voteSteps: the defects an operation's output may carry.
+func voteSteps(op string) []voteStep {
+	steps := []voteStep{{"json-gold/2", percentDecodeStep}}
+	switch op {
+	case "compact":
+		steps = append(steps, voteStep{"json-gold/3", emptyCompactionStep}, voteStep{"json-gold/13", emptyListsStep})
+	case "flatten":
+		steps = append(steps, voteStep{"json-gold/4", flattenContextStep}, voteStep{"json-gold/11", emptyGraphNodesStep}, voteStep{"json-gold/13", emptyListsStep})
+	}
+	return steps
+}
+
+// voteShapes names the recorded bugs whose defects, taken away from json-gold's output (and
+// pyld's, where the defect is a missing part), leave the two outputs equal: the smallest
+// set of steps that does so, nil when none. N-Quads outputs know only the percent-encoding
+// difference of json-gold/2.
+func voteShapes(op string, g, p outcome) []string {
+	if !g.ok || !p.ok || g.text == p.text {
+		return nil
+	}
+	var gv, pv interface{}
+	if json.Unmarshal([]byte(g.text), &gv) != nil || json.Unmarshal([]byte(p.text), &pv) != nil {
+		// the decoded IRI is what pyld writes, or (a space, a quote ... in it) an ill-formed
+		// IRI whose quad the spec's serialisation skips, as pyld does
+		if decoded := percentDecode(g.text); decoded == p.text || wellFormedQuads(decoded) == p.text {
+			return []string{"json-gold/2"}
+		}
+		return nil
+	}
+	steps := voteSteps(op)
+	for size := 1; size <= len(steps); size++ {
+		for mask := 1; mask < 1<<len(steps); mask++ {
+			if bits.OnesCount(uint(mask)) != size {
+				continue
+			}
+			g2, p2 := deepCopy(gv), deepCopy(pv)
+			var ids []string
+			for i, s := range steps {
+				if mask&(1<<i) != 0 {
+					g2, p2 = s.fix(g2, p2)
+					ids = append(ids, s.id)
+				}
+			}
+			if mustJSON(g2) == mustJSON(p2) {
+				return ids
+			}
+		}
+	}
+	return nil
+}
+
+// percentDecode undoes the percent-encoding json-gold applies to the IRIs it resolves
+// (non-ASCII, spaces, backslashes reaching an IRI position): the decoded bytes form UTF-8
+// text again.
+func percentDecode(s string) string {
+	return percentEscape.ReplaceAllStringFunc(s, func(e string) string {
+		b, _ := hex.DecodeString(e[1:])
+		return string(b)
+	})
+}
+
+// wellFormedQuads: the sorted lines of the N-Quads without those holding an IRI that is not
+// one (a character RFC 3987 does not allow: a space, a quote, a backslash, brackets, a
+// control character), which the JSON-LD to RDF algorithm skips.
+func wellFormedQuads(s string) string {
+	var out []string
+	for _, l := range strings.Split(s, "\n") {
+		if strings.TrimSpace(l) != "" && !illFormedIRI.MatchString(l) {
+			out = append(out, l)
+		}
+	}
+	return sortedLines(strings.Join(out, "\n"))
+}
+
+// percentDecodeStep: json-gold/2, json-gold percent-encoded characters of IRIs it resolved.
+func percentDecodeStep(g, p interface{}) (interface{}, interface{}) {
+	var decoded interface{}
+	if json.Unmarshal([]byte(percentDecode(mustJSON(g))), &decoded) == nil {
+		return decoded, p
+	}
+	return g, p
+}
+
+// emptyCompactionStep: json-gold/3, compaction with nothing to output loses the @context
+// (pyld adds an empty @graph to an empty compaction; jsonld.js and the spec do not).
+func emptyCompactionStep(g, p interface{}) (interface{}, interface{}) {
+	gm, gIsMap := g.(map[string]interface{})
+	pm, pIsMap := p.(map[string]interface{})
+	if !gIsMap || len(gm) != 0 || !pIsMap || pm["@context"] == nil {
+		return g, p
+	}
+	delete(pm, "@context")
+	if graph, ok := pm["@graph"].([]interface{}); ok && len(graph) == 0 {
+		delete(pm, "@graph")
+	}
+	return g, pm
+}
+
+// flattenContextStep: json-gold/4, Flatten's @context is a re-serialisation of the active
+// context instead of the provided one, and a bare [] when there is nothing to output (where
+// the spec's result is {@context, @graph: []}, or {@graph: []} for an empty context).
+func flattenContextStep(g, p interface{}) (interface{}, interface{}) {
+	pm, pIsMap := p.(map[string]interface{})
+	if !pIsMap {
+		return g, p
+	}
+	if _, hasGraph := pm["@graph"]; !hasGraph && pm["@context"] == nil {
+		return g, p
+	}
+	delete(pm, "@context")
+	if ga, isArr := g.([]interface{}); isArr && len(ga) == 0 {
+		return map[string]interface{}{"@graph": []interface{}{}}, pm
+	}
+	if gm, ok := g.(map[string]interface{}); ok && gm["@context"] != nil {
+		delete(gm, "@context")
+	}
+	return g, pm
+}
+
+// emptyGraphNodesStep: json-gold/11, Flatten drops a named graph whose nodes have no
+// properties: pyld's output gives the graph's node an empty @graph entry that json-gold's
+// lacks, and keeps the node when that entry was all it had beside its identifier.
+func emptyGraphNodesStep(g, p interface{}) (interface{}, interface{}) {
+	nodes := func(v interface{}) ([]interface{}, func([]interface{}) interface{}) {
+		switch x := v.(type) {
+		case []interface{}:
+			return x, func(ns []interface{}) interface{} { return ns }
+		case map[string]interface{}:
+			if arr, ok := x["@graph"].([]interface{}); ok {
+				return arr, func(ns []interface{}) interface{} { x["@graph"] = ns; return x }
+			}
+		}
+		return nil, nil
+	}
+	pa, put := nodes(p)
+	if put == nil {
+		return g, p
+	}
+	kept := []interface{}{}
+	for _, e := range pa {
+		if m, ok := e.(map[string]interface{}); ok {
+			if graph, ok := m["@graph"].([]interface{}); ok && len(graph) == 0 {
+				delete(m, "@graph")
+				if len(m) == 1 {
+					continue // the identifier alone: json-gold drops the node
+				}
+			}
+		}
+		kept = append(kept, e)
+	}
+	return g, put(kept)
+}
+
+// emptyListsStep: json-gold/13, an empty @list value of a term with a type, language or
+// container mapping is compacted under the full IRI instead of the term (the term's other
+// values stay under the term, where pyld has one array): every empty list (a {"@list": []}
+// value or member, a property's empty array) is taken out of both outputs, and a property's
+// array of one member left is read as that member (as CompactArrays writes it). Outputs
+// without an empty list are left alone, so that a difference of array wrapping alone is not
+// taken for this shape.
+func emptyListsStep(g, p interface{}) (interface{}, interface{}) {
+	if !hasEmptyLists(g) && !hasEmptyLists(p) {
+		return g, p
+	}
+	return withoutEmptyLists(g), withoutEmptyLists(p)
+}
+
+func isEmptyList(v interface{}) bool {
+	m, ok := v.(map[string]interface{})
+	if !ok || len(m) != 1 {
+		return false
+	}
+	arr, ok := m["@list"].([]interface{})
+	return ok && len(arr) == 0
+}
+
+func hasEmptyLists(v interface{}) bool {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		for k, val := range x {
+			if arr, ok := val.([]interface{}); ok && len(arr) == 0 && !strings.HasPrefix(k, "@") {
+				return true
+			}
+			if isEmptyList(val) || hasEmptyLists(val) {
+				return true
+			}
+		}
+	case []interface{}:
+		for _, e := range x {
+			if isEmptyList(e) || hasEmptyLists(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func withoutEmptyLists(v interface{}) interface{} {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		out := make(map[string]interface{}, len(x))
+		for k, val := range x {
+			before, _ := val.(map[string]interface{})
+			val = withoutEmptyLists(val)
+			if isEmptyList(val) {
+				continue
+			}
+			if after, ok := val.(map[string]interface{}); ok && len(after) == 0 && len(before) != 0 {
+				// an index map (or a value object) of empty lists only
+				continue
+			}
+			// @none is the index-map key pyld files un-indexed values under, not a keyword value
+			if arr, ok := val.([]interface{}); ok && (!strings.HasPrefix(k, "@") || k == "@none") {
+				switch len(arr) {
+				case 0:
+					continue
+				case 1:
+					val = arr[0]
+				}
+			}
+			out[k] = val
+		}
+		return out
+	case []interface{}:
+		out := []interface{}{}
+		for _, e := range x {
+			e = withoutEmptyLists(e)
+			if isEmptyList(e) {
+				continue
+			}
+			out = append(out, e)
+		}
+		return out
+	}
+	return v
+}
+
+// deepCopy copies a JSON value.
+func deepCopy(v interface{}) interface{} {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		m := make(map[string]interface{}, len(x))
+		for k, val := range x {
+			m[k] = deepCopy(val)
+		}
+		return m
+	case []interface{}:
+		a := make([]interface{}, len(x))
+		for i, e := range x {
+			a[i] = deepCopy(e)
+		}
+		return a
+	}
+	return v
+}
diff --git a/hegel/oracle.go b/hegel/oracle.go
new file mode 100644
index 0000000..0b735b0
--- /dev/null
+++ b/hegel/oracle.go
@@ -0,0 +1,171 @@
+package hegel
+
+// The oracle: pyld (Python, Digital Bazaar's JSON-LD 1.1 processor), driven as one persistent
+// child: a command and hex-encoded arguments per line in, one JSON object per line out. Every
+// reply has "ok"; a failure carries "error" (the JSON-LD error code, or the exception class)
+// and "message". The child has no document loader: every context is inline.
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+)
+
+const pythonScript = `
+import sys, json
+from pyld import jsonld
+
+def no_loader(url, options):
+    raise jsonld.JsonLdError("offline oracle: " + url, "jsonld.LoadDocumentError", code="loading document failed")
+
+def hx(s):
+    return bytes.fromhex(s).decode()
+
+def opts(j):
+    o = json.loads(j) if j else {}
+    o["documentLoader"] = no_loader
+    o.setdefault("processingMode", "json-ld-1.1")
+    return o
+
+def handle(cmd, a):
+    if cmd == "E":  # expand: doc json, options json
+        return {"result": jsonld.expand(json.loads(a[0]), opts(a[1]))}
+    if cmd == "C":  # compact: doc json, context json, options json
+        return {"result": jsonld.compact(json.loads(a[0]), json.loads(a[1]), opts(a[2]))}
+    if cmd == "F":  # flatten: doc json, context json (or "null"), options json
+        return {"result": jsonld.flatten(json.loads(a[0]), json.loads(a[1]), opts(a[2]))}
+    if cmd == "R":  # to_rdf: doc json, options json -> n-quads
+        o = opts(a[1])
+        o["format"] = "application/n-quads"
+        return {"nquads": jsonld.to_rdf(json.loads(a[0]), o)}
+    if cmd == "N":  # normalize: doc json, options json -> n-quads
+        o = opts(a[1])
+        o["format"] = "application/n-quads"
+        o.setdefault("algorithm", "URDNA2015")
+        return {"nquads": jsonld.normalize(json.loads(a[0]), o)}
+    if cmd == "NQ":  # normalize n-quads: n-quads, options json -> n-quads
+        o = opts(a[1])
+        o["format"] = "application/n-quads"
+        o["inputFormat"] = "application/n-quads"
+        o.setdefault("algorithm", "URDNA2015")
+        return {"nquads": jsonld.normalize(a[0], o)}
+    if cmd == "FR":  # from_rdf: n-quads, options json
+        o = json.loads(a[1]) if a[1] else {}
+        o["format"] = "application/n-quads"
+        return {"result": jsonld.from_rdf(a[0], o)}
+    if cmd == "P":  # parse n-quads and serialize back
+        ds = jsonld.JsonLdProcessor.parse_nquads(a[0])
+        return {"nquads": jsonld.JsonLdProcessor.to_nquads(ds)}
+    return {"ok": False, "error": "unknown command " + cmd}
+
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [hx(p) for p in parts[1:]]
+    try:
+        reply = handle(cmd, args)
+        reply.setdefault("ok", True)
+    except jsonld.JsonLdError as e:
+        reply = {"ok": False, "error": str(e.code or e.type), "message": str(e).split("\n")[0][:300]}
+    except Exception as e:
+        reply = {"ok": False, "error": type(e).__name__, "message": str(e)[:300]}
+    print(json.dumps(reply), flush=True)
+`
+
+type pyChild struct {
+	mu    sync.Mutex
+	cmd   *exec.Cmd
+	stdin *bufio.Writer
+	out   *bufio.Reader
+}
+
+var (
+	pyOnce sync.Once
+	py     *pyChild
+)
+
+func oracle() *pyChild {
+	pyOnce.Do(func() {
+		python := "python3"
+		if p := os.Getenv("HEGEL_PYTHON"); p != "" {
+			python = p
+		}
+		cmd := exec.Command(python, "-u", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			panic(err)
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			panic(err)
+		}
+		if err := cmd.Start(); err != nil {
+			panic(fmt.Sprintf("python3 with pyld is needed as the oracle: %v", err))
+		}
+		py = &pyChild{cmd: cmd, stdin: bufio.NewWriter(in), out: bufio.NewReader(out)}
+	})
+	return py
+}
+
+// reply is the common part of every oracle answer.
+type reply struct {
+	Ok      bool   `json:"ok"`
+	Error   string `json:"error"`
+	Message string `json:"message"`
+}
+
+// jsonReply carries a JSON-LD document.
+type jsonReply struct {
+	reply
+	Result json.RawMessage `json:"result"`
+}
+
+// nquadsReply carries an N-Quads serialization.
+type nquadsReply struct {
+	reply
+	NQuads string `json:"nquads"`
+}
+
+// ask sends one request and decodes the JSON answer into v (which embeds reply).
+func ask(v interface{}, cmd string, args ...string) {
+	p := oracle()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	line := cmd
+	for _, a := range args {
+		line += " " + hex.EncodeToString([]byte(a))
+	}
+	p.stdin.WriteString(line + "\n")
+	if err := p.stdin.Flush(); err != nil {
+		panic(fmt.Sprintf("pyld oracle: %v", err))
+	}
+	raw, err := p.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("pyld oracle exited: %v", err))
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		panic(fmt.Sprintf("pyld oracle reply %q: %v", raw, err))
+	}
+}
+
+func mustJSON(v interface{}) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// canon re-encodes JSON with sorted keys (and numbers through float64 on both sides) so the two
+// sides compare as text.
+func canon(raw string) string {
+	var v interface{}
+	if err := json.Unmarshal([]byte(raw), &v); err != nil {
+		return "INVALID JSON: " + raw
+	}
+	return mustJSON(v)
+}
