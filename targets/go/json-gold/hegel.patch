+// --------------------------------------------------------------------------- json-gold/12
+
+// badItem: an item of a @set or @list the expansion algorithm rejects: a non-string @id, an
+// invalid @type, @language or @index, a @value that is an object, a value object with a
+// @list, a reverse property with a literal, an invalid local context.
+type badItem struct {
+	kind int // 0 to 10
+	n    int
+	w, q string
+}
+
+func (b badItem) render() interface{} {
+	m := func(kv ...interface{}) map[string]interface{} {
+		out := map[string]interface{}{}
+		for i := 0; i < len(kv); i += 2 {
+			out[kv[i].(string)] = kv[i+1]
+		}
+		return out
+	}
+	switch b.kind {
+	case 0:
+		return m("@id", b.n)
+	case 1:
+		return m("@id", []interface{}{b.w, b.q})
+	case 2:
+		return m("@type", b.n)
+	case 3:
+		return m("@type", m(b.w, b.n))
+	case 4:
+		return m("@value", b.w, "@language", b.n)
+	case 5:
+		return m("@value", b.w, "@type", b.n)
+	case 6:
+		return m("@value", m(b.w, b.n))
+	case 7:
+		return m("@value", b.w, "@list", []interface{}{})
+	case 8:
+		return m("@reverse", m(vocab+b.q, b.w))
+	case 9:
+		return m("@context", b.n, vocab+b.q, b.w)
+	default:
+		return m("@value", b.w, "@index", b.n)
+	}
+}
+
+// swallowedErrorCase: a node whose property holds a @set or @list with one invalid item
+// among valid ones (json-gold/12: the error of the recursive expansion is discarded and the
+// item emptied).
+type swallowedErrorCase struct {
+	list  bool // a @list, else a @set
+	valid []interface{}
+	at    int // the invalid item's position, modulo len(valid)+1
+	bad   badItem
+	id    string
+	prop  string
+	props map[string]interface{}
+}
+
+func (c swallowedErrorCase) doc() interface{} {
+	items := slices.Clone(c.valid)
+	items = slices.Insert(items, c.at%(len(items)+1), c.bad.render())
+	node := nodeOf(c.id, c.props)
+	key := "@set"
+	if c.list {
+		key = "@list"
+	}
+	node[c.prop] = map[string]interface{}{key: items}
+	return viaJSON(node)
+}
+
+func (c swallowedErrorCase) GoString() string { return "doc " + mustJSON(c.doc()) }
+
+var (
+	validItems = weighted(
+		choice[interface{}]{2, asAny(plainWords)},
+		choice[interface{}]{1, hegel.Map(absoluteIRIs, func(s string) interface{} { return map[string]interface{}{"@id": s} })},
+	)
+	badItems = hegel.Composite(func(tc hegel.TestCase) badItem {
+		return badItem{
+			kind: hegel.Draw(tc, hegel.Integers(0, 10)),
+			n:    hegel.Draw(tc, ints),
+			w:    hegel.Draw(tc, plainWords),
+			q:    hegel.Draw(tc, hegel.SampledFrom([]string{"q1", "q2"})),
+		}
+	})
+	swallowedErrorCases = hegel.Composite(func(tc hegel.TestCase) swallowedErrorCase {
+		return swallowedErrorCase{
+			list:  hegel.Draw(tc, chance(50)),
+			valid: hegel.Draw(tc, hegel.Lists(validItems).MaxSize(2)),
+			at:    hegel.Draw(tc, positions),
+			bad:   hegel.Draw(tc, badItems),
+			id:    hegel.Draw(tc, subjectIDs),
+			prop:  hegel.Draw(tc, vocabProps),
+			props: hegel.Draw(tc, hegel.Maps(vocabProps, plainValues).MaxSize(2)),
+		}
+	})
+)
+
+// TestHegelErrorsInsideSetsAndListsAreReported: expanding a document with an invalid item
+// inside an explicit @set or @list fails as it does with the item outside them (pyld
+// reports the error); json-gold expands the document, the item emptied to {} or null
+// (json-gold/12).
+func TestHegelErrorsInsideSetsAndListsAreReported(t *testing.T) {
+	shapeOff(t, "json-gold/12")
+	property(t, func(ht *hegel.T) {
+		checkExpand(ht, hegel.Draw(ht, swallowedErrorCases).doc())
+	})
+}
+
+// --------------------------------------------------------------------------- json-gold/13
+
+// emptyListTermCase: a term with a type mapping (an xsd type or @vocab) or a language
+// mapping (a language or null) and, in the expanded document, an empty @list under its
+// IRI, empty as written or of nulls only (json-gold/13: the IRI compaction algorithm's
+// @any/@none for an empty list matches the term in pyld and jsonld.js, not in json-gold).
+type emptyListTermCase struct {
+	term          string
+	coercion      int // 0: an xsd type, 1: @vocab, 2: a language, 3: @language null
+	xsdType       string
+	xsdPrefix     bool // the type as xsd:name, with the prefix defined
+	lang          string
+	nulls         int // 0: {"@list": []}, else that many nulls
+	id            string
+	props         map[string]interface{}
+	compactArrays bool
+}
+
+func (c emptyListTermCase) ctx() map[string]interface{} {
+	def := map[string]interface{}{"@id": vocab + c.term}
+	ctx := map[string]interface{}{c.term: def}
+	switch c.coercion {
+	case 0:
+		def["@type"] = xsd + c.xsdType
+		if c.xsdPrefix {
+			def["@type"] = "xsd:" + c.xsdType
+			ctx["xsd"] = xsd
+		}
+	case 1:
+		def["@type"] = "@vocab"
+	case 2:
+		def["@language"] = c.lang
+	default:
+		def["@language"] = nil
+	}
+	return viaJSON(ctx).(map[string]interface{})
+}
+
+func (c emptyListTermCase) doc() interface{} {
+	node := nodeOf(c.id, c.props)
+	items := make([]interface{}, c.nulls)
+	node[vocab+c.term] = map[string]interface{}{"@list": items}
+	return viaJSON(node)
+}
+
+func (c emptyListTermCase) GoString() string {
+	return fmt.Sprintf("doc %s\n ctx %s\n compactArrays %v", mustJSON(c.doc()), mustJSON(c.ctx()), c.compactArrays)
+}
+
+var emptyListTermCases = hegel.Composite(func(tc hegel.TestCase) emptyListTermCase {
+	return emptyListTermCase{
+		term:          hegel.Draw(tc, termName),
+		coercion:      hegel.Draw(tc, hegel.Integers(0, 3)),
+		xsdType:       hegel.Draw(tc, xsdTypeNames),
+		xsdPrefix:     hegel.Draw(tc, chance(30)),
+		lang:          hegel.Draw(tc, languages),
+		nulls:         hegel.Draw(tc, hegel.Integers(0, 2)),
+		id:            hegel.Draw(tc, subjectIDs),
+		props:         hegel.Draw(tc, hegel.Maps(vocabProps, plainValues).MaxSize(2)),
+		compactArrays: hegel.Draw(tc, chance(75)),
+	}
+})
+
+// TestHegelEmptyListsCompactToTheirTerm: an empty @list under the IRI of a term with a type
+// or language mapping compacts under the term, as pyld and jsonld.js select it (a term
+// typed @id or without a coercion gets it in json-gold too); json-gold leaves it under the
+// full IRI (json-gold/13).
+func TestHegelEmptyListsCompactToTheirTerm(t *testing.T) {
+	shapeOff(t, "json-gold/13")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, emptyListTermCases)
+		doc, ctx := c.doc(), c.ctx()
+		checkCompact(ht, doc, ctx, c.compactArrays)
+	})
+}
+
+// --------------------------------------------------------------------------- json-gold/14
+
+// bigNumberCase: a dataset read with native types that holds an xsd:integer beyond int64
+// (twenty digits or more) or an xsd:double beyond float64 (an exponent of 309 or more),
+// valid literals (json-gold/14: RdfToObject returns strconv's range error as a parse
+// error).
+type bigNumberCase struct {
+	others             string
+	subject, predicate string
+	graph              string
+	double             bool
+	sign, lex          string
+	rdfType            bool
+}
+
+func (c bigNumberCase) nq() string {
+	typ := "integer"
+	if c.double {
+		typ = "double"
+	}
+	return c.others + quadLine(c.subject, c.predicate, quote(c.sign+c.lex)+"^^<"+xsd+typ+">", c.graph)
+}
+
+func (c bigNumberCase) GoString() string {
+	return fmt.Sprintf("nquads:\n%s useNativeTypes true useRdfType %v", c.nq(), c.rdfType)
+}
+
+var (
+	bigIntegers = hegel.FromRegex("[1-9][0-9]{19,29}", true)
+	bigDoubles  = hegel.FromRegex("[1-9](\\.[0-9]{1,6})?[Ee](309|[4-9][0-9]{2})", true)
+	signs       = hegel.SampledFrom([]string{"", "", "-", "+"})
+)
+
+var bigNumberCases = hegel.FlatMap(chance(40), func(double bool) hegel.Generator[bigNumberCase] {
+	lex := bigIntegers
+	if double {
+		lex = bigDoubles
+	}
+	return hegel.Composite(func(tc hegel.TestCase) bigNumberCase {
+		return bigNumberCase{
+			others:    hegel.Draw(tc, nativeQuads),
+			subject:   hegel.Draw(tc, nqTerms),
+			predicate: hegel.Draw(tc, predicates),
+			graph:     hegel.Draw(tc, graphNames),
+			double:    double,
+			sign:      hegel.Draw(tc, signs),
+			lex:       hegel.Draw(tc, lex),
+			rdfType:   hegel.Draw(tc, chance(30)),
+		}
+	})
+})
+
+// TestHegelBigNumbersConvertWithNativeTypes: FromRDF with UseNativeTypes of a dataset with
+// an xsd:integer beyond int64 or an xsd:double beyond float64 gives pyld's document (the
+// integer as a number, the double kept as a typed string); json-gold fails with a parse
+// error (json-gold/14).
+func TestHegelBigNumbersConvertWithNativeTypes(t *testing.T) {
+	shapeOff(t, "json-gold/14")
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bigNumberCases)
+		checkFromRDF(ht, fromRDFCase{nq: c.nq(), native: true, rdfType: c.rdfType})
+	})
+}
