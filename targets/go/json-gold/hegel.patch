+package hegel
+
+// Generators: JSON-LD contexts and documents over a small vocabulary, and N-Quads datasets.
+// Everything is inline (no remote contexts), so the two processors see the same input.
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/piprate/json-gold/ld"
+	"hegel.dev/go/hegel"
+)
+
+const (
+	vocab   = "http://ex.org/vocab#"
+	baseIRI = "http://example.org/base/doc"
+	xsd     = "http://www.w3.org/2001/XMLSchema#"
+	rdfNS   = "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
+)
+
+var (
+	termNames = []string{"p1", "p2", "p3", "p4"}
+	typeNames = []string{"T1", "T2"}
+	xsdTypes  = []string{"integer", "string", "boolean", "double", "dateTime", "date", "anyURI", "decimal"}
+	langs     = []string{"en", "de", "fr-CA", "ja"}
+	// words may land in IRI positions (a term typed @id), so they are IRI-safe; nasty ones only
+	// go into @value objects and N-Quads literals.
+	words = []string{"a", "hello", "x-y", "", "@id", "_:b0", "http://x/", "1", "true", "a.b", "2024-01-01"}
+	nasty = []string{"x y", "café", "日本", "line\nbreak", "quote\"d", "back\\slash", "tab\tbed", " nbsp", "emoji\U0001F600"}
+)
+
+// noLoader refuses every remote document: the harness keeps all contexts inline.
+type noLoader struct{}
+
+func (noLoader) LoadDocument(u string) (*ld.RemoteDocument, error) {
+	return nil, errors.New("offline harness: " + u)
+}
+
+func options() *ld.JsonLdOptions {
+	o := ld.NewJsonLdOptions(baseIRI)
+	o.DocumentLoader = noLoader{}
+	return o
+}
+
+// pyOptions is what the oracle gets for the same run.
+func pyOptions(extra map[string]interface{}) string {
+	o := map[string]interface{}{"base": baseIRI, "processingMode": "json-ld-1.1"}
+	for k, v := range extra {
+		o[k] = v
+	}
+	return mustJSON(o)
+}
+
+func genWord(tc hegel.TestCase) string {
+	if chance(tc, 80) {
+		return pick(tc, words...)
+	}
+	return hegel.Draw(tc, hegel.FromRegex("[a-z0-9]{0,6}", true))
+}
+
+// genLiteralText is the lexical form of a literal: any text.
+func genLiteralText(tc hegel.TestCase) string {
+	if chance(tc, 40) {
+		return pick(tc, nasty...)
+	}
+	return genWord(tc)
+}
+
+func genIRI(tc hegel.TestCase) string {
+	switch n(tc, 1, 5) {
+	case 1:
+		return fmt.Sprintf("http://example.org/n%d", n(tc, 0, 4))
+	case 2:
+		return vocab + pick(tc, "q1", "q2", "T1")
+	case 3:
+		return pick(tc, "n1", "n2", "#frag", "../up", "?q=1", "sub/dir")
+	case 4:
+		return "urn:x:" + pick(tc, "a", "b")
+	}
+	return fmt.Sprintf("http://example.org/n%d", n(tc, 0, 4))
+}
+
+// genContext builds a local context over the vocabulary. Terms may be plain IRIs, compact
+// IRIs or expanded definitions with type coercions, containers, languages and reverse mappings.
+func genContext(tc hegel.TestCase) map[string]interface{} {
+	ctx := map[string]interface{}{}
+	if chance(tc, 30) {
+		ctx["@vocab"] = pick(tc, vocab, "http://example.org/v/", "")
+	}
+	if chance(tc, 20) {
+		ctx["@base"] = pick(tc, "http://example.org/other/", "http://example.org/base/", "d/")
+	}
+	if chance(tc, 20) {
+		ctx["@language"] = pick(tc, langs...)
+	}
+	if chance(tc, 20) {
+		ctx["@version"] = 1.1
+	}
+	useEx := chance(tc, 60)
+	if useEx {
+		ctx["ex"] = vocab
+	}
+	if chance(tc, 40) {
+		ctx["xsd"] = xsd
+	}
+	if chance(tc, 20) {
+		ctx["id"] = "@id"
+	}
+	if chance(tc, 20) {
+		ctx["type"] = "@type"
+	}
+	for _, t := range typeNames {
+		if chance(tc, 50) {
+			ctx[t] = vocab + t
+		}
+	}
+	for _, name := range termNames {
+		if !chance(tc, 75) {
+			continue
+		}
+		iri := vocab + name
+		if useEx && chance(tc, 40) {
+			iri = "ex:" + name
+		}
+		if chance(tc, 40) {
+			ctx[name] = iri
+			continue
+		}
+		def := map[string]interface{}{"@id": iri}
+		hasType := false
+		switch n(tc, 1, 6) {
+		case 1:
+			def["@type"] = "@id"
+			hasType = true
+		case 2:
+			def["@type"] = "@vocab"
+			hasType = true
+		case 3, 4:
+			if _, ok := ctx["xsd"]; ok && chance(tc, 50) {
+				def["@type"] = "xsd:" + pick(tc, xsdTypes...)
+			} else {
+				def["@type"] = xsd + pick(tc, xsdTypes...)
+			}
+			hasType = true
+		}
+		switch n(tc, 1, 8) {
+		case 1:
+			def["@container"] = "@list"
+		case 2:
+			def["@container"] = "@set"
+		case 3:
+			def["@container"] = "@index"
+		case 4:
+			if !hasType {
+				def["@container"] = "@language"
+			}
+		case 5:
+			def["@container"] = []interface{}{"@set", "@index"}
+		}
+		if !hasType && chance(tc, 25) {
+			if chance(tc, 50) {
+				def["@language"] = pick(tc, langs...)
+			} else {
+				def["@language"] = nil
+			}
+		}
+		// a reverse term: no container or @set only (@index on a reverse term compacts to an
+		// index map inside an array in both processors, which they then expand differently)
+		if hasType && def["@type"] == "@id" && (def["@container"] == nil || def["@container"] == "@set") && chance(tc, 20) {
+			delete(def, "@type")
+			delete(def, "@id")
+			def["@reverse"] = iri
+		}
+		ctx[name] = def
+	}
+	if chance(tc, 10) {
+		// a term set to null removes it
+		ctx[pick(tc, termNames...)] = nil
+	}
+	return ctx
+}
+
+// genValue is one value of a property.
+func genValue(tc hegel.TestCase, depth int) interface{} {
+	switch n(tc, 1, 12) {
+	case 1, 2, 3:
+		return genWord(tc)
+	case 4:
+		return n(tc, -1000, 1000)
+	case 5:
+		return float64(n(tc, -100000, 100000))/100 + 0.005
+	case 6:
+		return chance(tc, 50)
+	case 7:
+		v := map[string]interface{}{"@value": genWord(tc)}
+		if chance(tc, 40) {
+			v["@value"] = pick(tc, nasty...)
+		}
+		switch n(tc, 1, 4) {
+		case 1:
+			v["@type"] = xsd + pick(tc, xsdTypes...)
+		case 2:
+			v["@language"] = pick(tc, langs...)
+		case 3:
+			v["@value"] = pick(tc, []interface{}{n(tc, -5, 5), chance(tc, 50), float64(n(tc, -50, 50))/10 + 0.05}...)
+		}
+		return v
+	case 8:
+		return map[string]interface{}{"@id": genIRI(tc)}
+	case 9:
+		if depth < 2 {
+			return genNode(tc, depth+1, false)
+		}
+		return genWord(tc)
+	case 10:
+		items := make([]interface{}, n(tc, 0, 3))
+		for i := range items {
+			items[i] = genValue(tc, depth+1)
+			// A @set directly inside a @list: the spec's expansion algorithm splices its items
+			// into the list (json-gold does), pyld and jsonld.js nest a list: not judged.
+			if m, ok := items[i].(map[string]interface{}); ok {
+				if _, isSet := m["@set"]; isSet {
+					items[i] = genWord(tc)
+				}
+			}
+		}
+		return map[string]interface{}{"@list": items}
+	case 11:
+		items := make([]interface{}, n(tc, 0, 3))
+		for i := range items {
+			items[i] = genValue(tc, depth+1)
+		}
+		return map[string]interface{}{"@set": items}
+	}
+	if chance(tc, 50) {
+		return nil
+	}
+	return map[string]interface{}{"@value": genWord(tc), "@index": pick(tc, "i1", "i2")}
+}
+
+func genProperty(tc hegel.TestCase, ctx map[string]interface{}) string {
+	switch n(tc, 1, 8) {
+	case 1:
+		if _, ok := ctx["ex"]; ok {
+			return "ex:" + pick(tc, termNames...)
+		}
+		return vocab + pick(tc, "q1", "q2")
+	case 2:
+		return vocab + pick(tc, "q1", "q2")
+	case 3:
+		return "http://example.org/other#p"
+	}
+	return pick(tc, termNames...)
+}
+
+// genNode is a node object; top says whether it may carry a @graph.
+func genNode(tc hegel.TestCase, depth int, top bool) map[string]interface{} {
+	node := map[string]interface{}{}
+	switch n(tc, 1, 10) {
+	case 1, 2, 3, 4:
+		node["@id"] = fmt.Sprintf("http://example.org/n%d", n(tc, 0, 4))
+	case 5:
+		node["@id"] = pick(tc, "n1", "#frag", "../up", "")
+	case 6, 7:
+		node["@id"] = fmt.Sprintf("_:b%d", n(tc, 0, 3))
+	}
+	if chance(tc, 40) {
+		var types []interface{}
+		for i := 0; i < n(tc, 1, 2); i++ {
+			switch n(tc, 1, 3) {
+			case 1:
+				types = append(types, pick(tc, typeNames...))
+			case 2:
+				types = append(types, vocab+pick(tc, typeNames...))
+			default:
+				types = append(types, "_:b9")
+			}
+		}
+		if len(types) == 1 && chance(tc, 60) {
+			node["@type"] = types[0]
+		} else {
+			node["@type"] = types
+		}
+	}
+	ctx, _ := node["@context"].(map[string]interface{})
+	for i := 0; i < n(tc, 0, 4); i++ {
+		prop := genProperty(tc, ctx)
+		if chance(tc, 60) {
+			node[prop] = genValue(tc, depth)
+		} else {
+			vals := make([]interface{}, n(tc, 0, 3))
+			for j := range vals {
+				vals[j] = genValue(tc, depth)
+			}
+			node[prop] = vals
+		}
+	}
+	if chance(tc, 15) && depth < 2 {
+		rev := map[string]interface{}{}
+		prop := genProperty(tc, ctx)
+		if chance(tc, 50) {
+			rev[prop] = map[string]interface{}{"@id": genIRI(tc)}
+		} else {
+			inner := genNode(tc, depth+1, false)
+			if len(inner) == 0 {
+				// an empty node under a reverse property: json-gold drops the property, pyld
+				// keeps it with no values; neither convincingly. Not generated.
+				inner["@id"] = genIRI(tc)
+			}
+			rev[prop] = inner
+		}
+		node["@reverse"] = rev
+	}
+	if top && chance(tc, 15) {
+		graph := make([]interface{}, n(tc, 1, 3))
+		for i := range graph {
+			graph[i] = genNode(tc, depth+1, false)
+		}
+		for k := range node {
+			if k != "@id" {
+				delete(node, k)
+			}
+		}
+		node["@graph"] = graph
+	}
+	return node
+}
+
+// viaJSON is the value as encoding/json would decode it (numbers as float64), which is the
+// input json-gold documents: what it gets is a JSON document, not arbitrary Go values.
+func viaJSON(v interface{}) interface{} {
+	var out interface{}
+	if err := json.Unmarshal([]byte(mustJSON(v)), &out); err != nil {
+		panic(err)
+	}
+	return out
+}
+
+// genDocument is a JSON-LD document with an inline context: one node or an array of nodes.
+func genDocument(tc hegel.TestCase) (doc interface{}, ctx map[string]interface{}) {
+	ctx = genContext(tc)
+	if chance(tc, 20) {
+		arr := make([]interface{}, n(tc, 0, 3))
+		for i := range arr {
+			node := genNode(tc, 0, true)
+			if chance(tc, 50) {
+				node["@context"] = ctx
+			}
+			arr[i] = node
+		}
+		return viaJSON(arr), viaJSON(ctx).(map[string]interface{})
+	}
+	node := genNode(tc, 0, true)
+	if chance(tc, 90) {
+		node["@context"] = ctx
+	}
+	return viaJSON(node), viaJSON(ctx).(map[string]interface{})
+}
+
+// N-Quads.
+
+func nqEscape(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		switch r {
+		case '\\':
+			b.WriteString(`\\`)
+		case '"':
+			b.WriteString(`\"`)
+		case '\n':
+			b.WriteString(`\n`)
+		case '\r':
+			b.WriteString(`\r`)
+		case '\t':
+			b.WriteString(`\t`)
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func genTerm(tc hegel.TestCase, bnodes bool) string {
+	if bnodes && chance(tc, 35) {
+		return fmt.Sprintf("_:b%d", n(tc, 0, 4))
+	}
+	return fmt.Sprintf("<http://example.org/n%d>", n(tc, 0, 5))
+}
+
+func genPredicate(tc hegel.TestCase) string {
+	if chance(tc, 15) {
+		return "<" + rdfNS + "type>"
+	}
+	return "<" + vocab + pick(tc, "p1", "p2", "p3", "q1") + ">"
+}
+
+func genLexical(tc hegel.TestCase, xsdType string) string {
+	if chance(tc, 30) {
+		return genLiteralText(tc)
+	}
+	switch xsdType {
+	case "integer":
+		return pick(tc, "0", "42", "-7", "+3", "007", "12345678901234567890", "1.0", "1e3")
+	case "double":
+		return pick(tc, "1.5E0", "1.5", "-0.0", "1E21", "NaN", "INF", "-INF", "3", "1.0E0", "5.0E-1", "1.7976931348623157E308", "1E400", "abc")
+	case "boolean":
+		// "1" and "0" are valid xsd:boolean too, but the spec's native conversion names only
+		// true and false; pyld converts them, json-gold and jsonld.js keep them: not judged.
+		return pick(tc, "true", "false", "TRUE", "yes")
+	case "dateTime":
+		return pick(tc, "2024-01-01T00:00:00Z", "not a date")
+	}
+	return genLiteralText(tc)
+}
+
+func genObject(tc hegel.TestCase) string {
+	switch n(tc, 1, 10) {
+	case 1, 2, 3:
+		return genTerm(tc, true)
+	case 4, 5:
+		return `"` + nqEscape(genLiteralText(tc)) + `"`
+	case 6:
+		return `"` + nqEscape(genLiteralText(tc)) + `"@` + pick(tc, langs...)
+	case 7:
+		if chance(tc, 15) {
+			// ill-typed: rdf:langString without a language tag
+			return `"` + nqEscape(genLiteralText(tc)) + `"^^<` + rdfNS + `langString>`
+		}
+		return `"` + nqEscape(genLiteralText(tc)) + `"^^<` + xsd + `string>`
+	case 8:
+		return `"` + nqEscape(genLiteralText(tc)) + `"^^<http://example.org/dt>`
+	}
+	t := pick(tc, xsdTypes...)
+	return `"` + nqEscape(genLexical(tc, t)) + `"^^<` + xsd + t + `>`
+}
+
+// genNQuads is a small dataset: plain quads, sometimes a well-formed rdf:List, in the default
+// graph or named graphs.
+func genNQuads(tc hegel.TestCase) string {
+	var lines []string
+	for i := 0; i < n(tc, 0, 6); i++ {
+		g := ""
+		if chance(tc, 30) {
+			g = " " + genTerm(tc, true)
+		}
+		lines = append(lines, genTerm(tc, true)+" "+genPredicate(tc)+" "+genObject(tc)+g+" .")
+	}
+	if chance(tc, 40) {
+		// a list hanging off a node
+		g := ""
+		if chance(tc, 30) {
+			g = " <http://example.org/g>"
+		}
+		k := n(tc, 0, 3)
+		head := "<" + rdfNS + "nil>"
+		if k > 0 {
+			head = "_:l0"
+		}
+		lines = append(lines, genTerm(tc, false)+" <"+vocab+"list> "+head+g+" .")
+		for i := 0; i < k; i++ {
+			rest := "<" + rdfNS + "nil>"
+			if i+1 < k {
+				rest = fmt.Sprintf("_:l%d", i+1)
+			}
+			lines = append(lines, fmt.Sprintf("_:l%d <%sfirst> %s%s .", i, rdfNS, genObject(tc), g))
+			lines = append(lines, fmt.Sprintf("_:l%d <%srest> %s%s .", i, rdfNS, rest, g))
+		}
+	}
+	if len(lines) == 0 {
+		return ""
+	}
+	return strings.Join(lines, "\n") + "\n"
+}
+
+// hasDuplicateLines: the same quad more than once in an N-Quads serialization.
+func hasDuplicateLines(s string) bool {
+	seen := map[string]bool{}
+	for _, l := range strings.Split(s, "\n") {
+		if strings.TrimSpace(l) == "" {
+			continue
+		}
+		if seen[l] {
+			return true
+		}
+		seen[l] = true
+	}
+	return false
+}
+
+// sortedLines normalises an N-Quads serialization for comparison.
+func sortedLines(s string) string {
+	var out []string
+	for _, l := range strings.Split(s, "\n") {
+		if strings.TrimSpace(l) != "" {
+			out = append(out, l)
+		}
+	}
+	sort.Strings(out)
+	return strings.Join(out, "\n")
+}
diff --git a/hegel/hegel_algos_test.go b/hegel/hegel_algos_test.go
new file mode 100644
index 0000000..5afe196
--- /dev/null
+++ b/hegel/hegel_algos_test.go
@@ -0,0 +1,309 @@
+package hegel
+
+// Expansion, compaction and flattening against pyld on the same document and context.
+
+import (
+	"encoding/json"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/piprate/json-gold/ld"
+	"hegel.dev/go/hegel"
+)
+
+// sortTypes orders every @type array: a node merged from several places (a @graph and a
+// @reverse) collects its types in traversal order, which the two processors do not share.
+func sortTypes(v interface{}) interface{} {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		out := make(map[string]interface{}, len(x))
+		for k, val := range x {
+			if arr, ok := val.([]interface{}); ok && (k == "@type" || k == "type") {
+				items := make([]string, 0, len(arr))
+				allStrings := true
+				for _, e := range arr {
+					s, ok := e.(string)
+					if !ok {
+						allStrings = false
+						break
+					}
+					items = append(items, s)
+				}
+				if allStrings {
+					sort.Strings(items)
+					sorted := make([]interface{}, len(items))
+					for i, s := range items {
+						sorted[i] = s
+					}
+					out[k] = sorted
+					continue
+				}
+			}
+			out[k] = sortTypes(val)
+		}
+		return out
+	case []interface{}:
+		items := make([]interface{}, len(x))
+		for i, e := range x {
+			items[i] = sortTypes(e)
+		}
+		return items
+	}
+	return v
+}
+
+// typesSorted re-canonicalises an outcome's JSON with @type arrays sorted.
+func typesSorted(o outcome) outcome {
+	if !o.ok {
+		return o
+	}
+	var v interface{}
+	if json.Unmarshal([]byte(o.text), &v) != nil {
+		return o
+	}
+	return outcome{true, mustJSON(sortTypes(v))}
+}
+
+// sortSets orders every array that is not a @list's value by canonical text, so two expanded
+// documents compare as the sets of values they are.
+func sortSets(v interface{}) interface{} {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		out := make(map[string]interface{}, len(x))
+		for k, val := range x {
+			if k == "@list" {
+				if arr, ok := val.([]interface{}); ok {
+					items := make([]interface{}, len(arr))
+					for i, e := range arr {
+						items[i] = sortSets(e)
+					}
+					out[k] = items
+					continue
+				}
+			}
+			out[k] = sortSets(val)
+		}
+		return out
+	case []interface{}:
+		items := make([]interface{}, len(x))
+		for i, e := range x {
+			items[i] = sortSets(e)
+		}
+		sort.Slice(items, func(i, j int) bool { return mustJSON(items[i]) < mustJSON(items[j]) })
+		return items
+	}
+	return v
+}
+
+// pyCrash: the oracle reports a Python exception class (the JSON-LD error codes are phrases).
+var pyCrash = regexp.MustCompile(`^[A-Z][A-Za-z]*(Error|Exception): `)
+
+// outcome is one side's result: a canonical JSON text, or an error.
+type outcome struct {
+	ok   bool
+	text string // canonical JSON when ok, the error otherwise
+}
+
+func goOutcome(v interface{}, err error) outcome {
+	if err != nil {
+		return outcome{false, err.Error()}
+	}
+	return outcome{true, canon(mustJSON(v))}
+}
+
+func pyOutcome(r jsonReply) outcome {
+	if !r.Ok {
+		return outcome{false, r.Error + ": " + r.Message}
+	}
+	return outcome{true, canon(string(r.Result))}
+}
+
+// judge compares the two outcomes for one operation; both failing counts as agreement.
+func judge(ht *hegel.T, op string, doc interface{}, extra string, g, p outcome) bool {
+	if id := knownVote(g, p); id != "" {
+		count("known " + id)
+		return false
+	}
+	if id := knownErrorSwallowed(doc, g, p); id != "" {
+		count("known " + id)
+		return false
+	}
+	if !p.ok && pyCrash.MatchString(p.text) {
+		// a Python exception rather than a JsonLdError: pyld's own failure, no vote
+		count("not judged: pyld raises")
+		return false
+	}
+	switch {
+	case g.ok && p.ok:
+		if g.text != p.text {
+			fail(ht, "%s disagree\n doc: %s%s\n json-gold: %s\n pyld:      %s", op, mustJSON(doc), extra, g.text, p.text)
+			return false
+		}
+		count(op + " agree")
+	case !g.ok && !p.ok:
+		count(op + " both error")
+	case g.ok:
+		fail(ht, "%s: pyld errors, json-gold does not\n doc: %s%s\n json-gold: %s\n pyld:      %s", op, mustJSON(doc), extra, g.text, p.text)
+		return false
+	default:
+		fail(ht, "%s: json-gold errors, pyld does not\n doc: %s%s\n json-gold: %s\n pyld:      %s", op, mustJSON(doc), extra, g.text, p.text)
+		return false
+	}
+	return true
+}
+
+func TestHegelExpandMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		doc, _ := genDocument(tc)
+		if id := knownExpand(doc); id != "" {
+			count("known " + id)
+			return
+		}
+		proc := ld.NewJsonLdProcessor()
+		g := goOutcome(proc.Expand(doc, options()))
+		var r jsonReply
+		ask(&r, "E", mustJSON(doc), pyOptions(nil))
+		judge(ht, "expand", doc, "", g, pyOutcome(r))
+	})
+}
+
+func TestHegelCompactMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		doc, docCtx := genDocument(tc)
+		ctx := docCtx
+		if chance(tc, 50) {
+			ctx = viaJSON(genContext(tc)).(map[string]interface{})
+		}
+		compactArrays := chance(tc, 75)
+		if id := knownCompact(doc, ctx); id != "" {
+			count("known " + id)
+			return
+		}
+		opts := options()
+		opts.CompactArrays = compactArrays
+		proc := ld.NewJsonLdProcessor()
+		g := goOutcome(proc.Compact(doc, ctx, opts))
+		var r jsonReply
+		ask(&r, "C", mustJSON(doc), mustJSON(ctx), pyOptions(map[string]interface{}{"compactArrays": compactArrays}))
+		p := pyOutcome(r)
+		if id := knownCompactVote(g, p); id != "" {
+			count("known " + id)
+			return
+		}
+		judge(ht, "compact", doc, "\n ctx: "+mustJSON(ctx)+"\n compactArrays: "+mustJSON(compactArrays), g, p)
+	})
+}
+
+func TestHegelFlattenMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		doc, docCtx := genDocument(tc)
+		var ctx interface{}
+		switch n(tc, 1, 3) {
+		case 1:
+			ctx = docCtx
+		case 2:
+			ctx = viaJSON(genContext(tc)).(map[string]interface{})
+		}
+		if id := knownFlatten(doc, ctx); id != "" {
+			count("known " + id)
+			return
+		}
+		proc := ld.NewJsonLdProcessor()
+		g := typesSorted(goOutcome(proc.Flatten(doc, ctx, options())))
+		var r jsonReply
+		ask(&r, "F", mustJSON(doc), mustJSON(ctx), pyOptions(nil))
+		p := typesSorted(pyOutcome(r))
+		if id := knownFlattenVote(g, p); id != "" {
+			count("known " + id)
+			return
+		}
+		if id := knownFlattenGraphVote(g, p); id != "" {
+			count("known " + id)
+			return
+		}
+		judge(ht, "flatten", doc, "\n ctx: "+mustJSON(ctx), g, p)
+	})
+}
+
+// Compaction is lossless: expanding the compacted document (its context inline) gives the
+// expanded document again. pyld gets the vote when json-gold's round trip does not close.
+func TestHegelCompactExpandRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		doc, docCtx := genDocument(tc)
+		ctx := docCtx
+		if chance(tc, 50) {
+			ctx = viaJSON(genContext(tc)).(map[string]interface{})
+		}
+		if id := knownRoundTrip(doc, ctx, docCtx); id != "" {
+			count("known " + id)
+			return
+		}
+		if anonymousTopGraph(doc) {
+			count("not judged: anonymous top-level graph")
+			return
+		}
+		proc := ld.NewJsonLdProcessor()
+		expanded, err := proc.Expand(doc, options())
+		if err != nil {
+			count("expand error")
+			return
+		}
+		opts := options()
+		opts.CompactArrays = chance(tc, 75)
+		compacted, err := proc.Compact(expanded, ctx, opts)
+		if err != nil {
+			count("compact error")
+			return
+		}
+		again, expandErr := proc.Expand(compacted, options())
+		want := canon(mustJSON(sortSets(expanded)))
+		got := ""
+		if expandErr == nil {
+			// the order of a property's values is not significant outside @list: compare sorted
+			got = canon(mustJSON(sortSets(again)))
+			if want == got {
+				count("round trip closes")
+				return
+			}
+			if strings.Contains(want, `"@reverse":{}`) {
+				// an empty @reverse survives expansion but not compaction (pyld too): not judged
+				count("not judged: empty @reverse")
+				return
+			}
+		}
+		// pyld's round trip over the same expanded document and context
+		var c jsonReply
+		ask(&c, "C", mustJSON(expanded), mustJSON(ctx), pyOptions(map[string]interface{}{"compactArrays": opts.CompactArrays}))
+		var e jsonReply
+		if c.Ok {
+			ask(&e, "E", string(c.Result), pyOptions(nil))
+		}
+		if c.Ok && canon(string(c.Result)) == canon(mustJSON(compacted)) {
+			// pyld compacts to the very same document: what is lost is lost by the
+			// specification's compaction (e.g. a number under a @language container lands
+			// under @none, which expansion refuses). Not judged.
+			count("not judged: pyld compacts identically")
+			return
+		}
+		if expandErr != nil {
+			fail(ht, "expanding json-gold's compaction fails: %v\n doc: %s\n ctx: %s\n compacted: %s\n pyld compacts to: %s %s", expandErr, mustJSON(doc), mustJSON(ctx), mustJSON(compacted), string(c.Result), c.Error)
+			return
+		}
+		py := "pyld: compact error " + c.Error
+		if c.Ok {
+			if e.Ok {
+				py = "pyld compacts to " + canon(string(c.Result)) + " which expands to " + canon(string(e.Result))
+			} else {
+				py = "pyld compacts to " + canon(string(c.Result)) + " which does not expand: " + e.Error
+			}
+		}
+		fail(ht, "compaction is lossy\n doc: %s\n ctx: %s\n compactArrays: %v\n expanded:  %s\n compacted: %s\n again:     %s\n %s",
+			mustJSON(doc), mustJSON(ctx), opts.CompactArrays, want, mustJSON(compacted), got, py)
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..c2d61c7
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,261 @@
+package hegel
+
+// One deterministic reproducer per recorded bug (bugs.toml). Each fails while the bug is open.
+
+import (
+	"os"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/piprate/json-gold/ld"
+)
+
+// noPanic turns a panic in fn into a test failure.
+func noPanic(t *testing.T, what string, fn func()) {
+	defer func() {
+		if p := recover(); p != nil {
+			t.Fatalf("%s panics: %v", what, p)
+		}
+	}()
+	fn()
+}
+
+// json-gold/1: the relative IRI against a base ending in a slash has one ../ too many, so it
+// denotes another resource.
+func TestHegelPinRelativeIRIClimbsTooFar(t *testing.T) {
+	base, iri := "http://example.org/a/b/", "http://example.org/a/c"
+	rel := ld.RemoveBase(base, iri)
+	if back := ld.Resolve(base, rel); back != iri {
+		t.Errorf("RemoveBase(%s, %s) = %q, which resolves to %s (RFC 3986: ../c)", base, iri, rel, back)
+	}
+	proc := ld.NewJsonLdProcessor()
+	doc := map[string]interface{}{"@id": iri, "http://example.org/p": "x"}
+	ctx := map[string]interface{}{"@base": base}
+	out, err := proc.Compact(doc, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out["@id"] != "../c" {
+		t.Errorf("Compact with @base %s gives @id %q for %s, RFC 3986 gives ../c", base, out["@id"], iri)
+	}
+	// the other branch: an IRI ending in / with a fragment, against a base with a last segment
+	base, iri = "http://example.org/base/doc", "http://example.org/base/#frag"
+	rel = ld.RemoveBase(base, iri)
+	if back := ld.Resolve(base, rel); back != iri {
+		t.Errorf("RemoveBase(%s, %s) = %q, which resolves to %s (RFC 3986: ./#frag)", base, iri, rel, back)
+	}
+}
+
+// json-gold/2: resolving a relative IRI reference percent-encodes non-ASCII characters, so the
+// expanded @id (and the RDF IRI) is not the one the document denotes.
+func TestHegelPinResolveKeepsUnicode(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	doc := map[string]interface{}{"@context": map[string]interface{}{"@base": "http://example.org/base/doc"}, "@id": "café", "http://example.org/p": "x"}
+	out, err := proc.Expand(doc, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := out[0].(map[string]interface{})["@id"]; got != "http://example.org/base/café" {
+		t.Errorf("Expand resolves @id \"café\" against http://example.org/base/doc to %q, RFC 3987 section 6.5 gives http://example.org/base/café", got)
+	}
+}
+
+// json-gold/3: compaction with nothing to output drops the @context.
+func TestHegelPinCompactEmptyKeepsContext(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	ctx := map[string]interface{}{"ex": "http://example.org/"}
+	out, err := proc.Compact(map[string]interface{}{"@id": "_:b0"}, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := out["@context"]; !ok {
+		t.Errorf("Compact of a document with nothing to output gives %s: the spec's compact() adds @context whenever the context is not null", mustJSON(out))
+	}
+}
+
+// json-gold/4: Flatten returns a re-serialisation of the active context instead of the provided
+// context, and a bare [] instead of {@context, @graph: []} when there is nothing to output.
+func TestHegelPinFlattenProvidedContext(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	ctx := map[string]interface{}{"ex": "http://example.org/", "p": "http://example.org/p", "@version": 1.1}
+	out, err := proc.Flatten(map[string]interface{}{"@id": "http://example.org/x", "http://example.org/p": 1.0}, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m, ok := out.(map[string]interface{}); !ok || !reflect.DeepEqual(m["@context"], ctx) {
+		t.Errorf("Flatten with context %s returns %s: its @context is not the provided context", mustJSON(ctx), mustJSON(out))
+	}
+	out, err = proc.Flatten(map[string]interface{}{"@id": "_:b0"}, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m, ok := out.(map[string]interface{}); !ok || m["@context"] == nil || m["@graph"] == nil {
+		t.Errorf("Flatten with a context and nothing to output returns %s, not {@context, @graph: []}", mustJSON(out))
+	}
+}
+
+// json-gold/5: Flatten panics when the context maps a term to null.
+func TestHegelPinFlattenNullTerm(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	ctx := map[string]interface{}{"p": nil, "q": "http://example.org/q"}
+	noPanic(t, "Flatten with a context containing a null term", func() {
+		if _, err := proc.Flatten(map[string]interface{}{"@id": "http://example.org/x", "http://example.org/p": 1.0}, ctx, options()); err != nil {
+			t.Fatal(err)
+		}
+	})
+}
+
+// json-gold/6: FromRDF with UseNativeTypes yields int64 values that ToRDF panics on.
+func TestHegelPinNativeIntegerBackToRDF(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	nq := "<http://example.org/s> <http://example.org/p> \"1\"^^<http://www.w3.org/2001/XMLSchema#integer> .\n"
+	fo := options()
+	fo.UseNativeTypes = true
+	doc, err := proc.FromRDF(nq, fo)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ro := options()
+	ro.Format = "application/n-quads"
+	noPanic(t, "ToRDF of FromRDF's output with UseNativeTypes", func() {
+		out, err := proc.ToRDF(doc, ro)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if out != nq {
+			t.Errorf("round trip gives %q, not %q", out, nq)
+		}
+	})
+}
+
+// json-gold/7: a literal whose text starts with @ and has a language tag is read as a plain
+// literal containing the quotes and the tag.
+func TestHegelPinNQuadsLiteralStartingWithAt(t *testing.T) {
+	ds, err := ld.ParseNQuads("<http://example.org/s> <http://example.org/p> \"@id\"@ja .\n")
+	if err != nil {
+		t.Fatal(err)
+	}
+	q := ds.Graphs["@default"][0]
+	lit, ok := q.Object.(ld.Literal)
+	if !ok || lit.Value != "@id" || lit.Language != "ja" {
+		t.Errorf("\"@id\"@ja parsed as value %q language %q datatype %q", lit.Value, lit.Language, lit.Datatype)
+	}
+}
+
+// json-gold/8: a value of the form of a keyword, expanded through @type: @vocab, is written to
+// N-Quads as the IRI <@id>.
+func TestHegelPinToRDFKeywordValue(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	doc := map[string]interface{}{"@context": map[string]interface{}{"p": map[string]interface{}{"@id": "http://example.org/p", "@type": "@vocab"}}, "@id": "http://example.org/s", "p": "@id"}
+	o := options()
+	o.Format = "application/n-quads"
+	out, err := proc.ToRDF(doc, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(out.(string), "<@id>") {
+		t.Errorf("ToRDF writes %q: <@id> is not an IRI, the triple must be dropped", out)
+	}
+}
+
+// json-gold/9: an rdf:langString literal without a language is serialised as "a"@ ., which
+// the parser then refuses.
+func TestHegelPinLangStringWithoutLanguage(t *testing.T) {
+	ds := ld.NewRDFDataset()
+	ds.Graphs["@default"] = []*ld.Quad{ld.NewQuad(ld.NewIRI("http://example.org/s"), ld.NewIRI("http://example.org/p"), ld.NewLiteral("a", ld.RDFLangString, ""), "@default")}
+	out, err := (&ld.NQuadRDFSerializer{}).Serialize(ds)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ld.ParseNQuads(out.(string)); err != nil {
+		t.Errorf("serialised as %q, which does not parse back: %v", out, err)
+	}
+}
+
+// json-gold/11: Flatten drops a named graph whose nodes have no properties instead of giving
+// its node an empty @graph.
+func TestHegelPinFlattenEmptyNamedGraph(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	doc := map[string]interface{}{"@id": "http://example.org/n3", "@graph": []interface{}{map[string]interface{}{"@id": "http://example.org/n1"}}}
+	out, err := proc.Flatten(doc, nil, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := `[{"@graph":[],"@id":"http://example.org/n3"}]`
+	if got := canon(mustJSON(out)); got != want {
+		t.Errorf("Flatten of %s gives %s, the node map has the graph node %s (pyld and jsonld.js)", mustJSON(doc), got, want)
+	}
+}
+
+// json-gold/12: an error while expanding the items of an explicit @set or @list is discarded:
+// the invalid item becomes {} (or null in a list) and Expand reports success.
+func TestHegelPinExpandSetItemError(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	for _, c := range []struct {
+		name string
+		doc  interface{}
+	}{
+		{"@set", map[string]interface{}{"@id": "http://example.org/s", "http://example.org/p": map[string]interface{}{"@set": []interface{}{map[string]interface{}{"@id": 5.0}}}}},
+		{"@list", map[string]interface{}{"@id": "http://example.org/s", "http://example.org/p": map[string]interface{}{"@list": []interface{}{map[string]interface{}{"@id": 5.0}}}}},
+	} {
+		out, err := proc.Expand(c.doc, options())
+		if err == nil {
+			t.Errorf("Expand of a node with a non-string @id inside %s gives %s and no error (invalid @id value)", c.name, mustJSON(out))
+		}
+	}
+}
+
+// json-gold/13: an empty @list value of a term with a type or language mapping is compacted
+// under the full IRI instead of the term (a term with @type: @id, or none, gets the term).
+func TestHegelPinCompactEmptyListTerm(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	ctx := map[string]interface{}{
+		"p3": map[string]interface{}{"@id": "http://ex.org/vocab#p3", "@type": "http://www.w3.org/2001/XMLSchema#boolean"},
+		"p4": map[string]interface{}{"@id": "http://ex.org/vocab#p4", "@language": "en"},
+	}
+	doc := map[string]interface{}{"@id": "http://example.org/s", "http://ex.org/vocab#p3": map[string]interface{}{"@list": []interface{}{}}, "http://ex.org/vocab#p4": map[string]interface{}{"@list": []interface{}{}}}
+	out, err := proc.Compact(doc, ctx, options())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, term := range []string{"p3", "p4"} {
+		if _, ok := out[term]; !ok {
+			t.Errorf("empty @list of %s compacted as %s, not under the term (pyld and jsonld.js select %s)", term, mustJSON(out), term)
+		}
+	}
+}
+
+// json-gold/14: FromRDF with UseNativeTypes fails on an xsd:integer beyond int64 or an
+// xsd:double beyond float64, valid literals the spec converts (or keeps as strings).
+func TestHegelPinNativeTypesBigNumbers(t *testing.T) {
+	proc := ld.NewJsonLdProcessor()
+	fo := options()
+	fo.UseNativeTypes = true
+	for _, lit := range []string{
+		`"12345678901234567890"^^<http://www.w3.org/2001/XMLSchema#integer>`,
+		`"1E400"^^<http://www.w3.org/2001/XMLSchema#double>`,
+	} {
+		if _, err := proc.FromRDF("<http://example.org/s> <http://example.org/p> "+lit+" .\n", fo); err != nil {
+			t.Errorf("FromRDF with UseNativeTypes of %s: %v", lit, err)
+		}
+	}
+}
+
+// json-gold/10: FromRDF's documentation gives useNativeTypes the default true; the options
+// default is false.
+func TestHegelPinUseNativeTypesDocumentedDefault(t *testing.T) {
+	src, err := os.ReadFile("../ld/processor.go")
+	if err != nil {
+		t.Skip("source not at hand")
+	}
+	m := regexp.MustCompile(`(?s)\[useNativeTypes\].{0,200}?\(default: (true|false)\)`).FindSubmatch(src)
+	if m == nil {
+		return // the sentence is gone: nothing to hold the code to
+	}
+	documented := string(m[1]) == "true"
+	if actual := ld.NewJsonLdOptions("").UseNativeTypes; actual != documented {
+		t.Errorf("FromRDF documents useNativeTypes (default: %v); NewJsonLdOptions sets %v", documented, actual)
+	}
+}
diff --git a/hegel/hegel_rdf_test.go b/hegel/hegel_rdf_test.go
new file mode 100644
index 0000000..d2b7f11
--- /dev/null
+++ b/hegel/hegel_rdf_test.go
@@ -0,0 +1,224 @@
+package hegel
+
+// RDF: ToRDF, Normalize (URDNA2015), FromRDF and the N-Quads parser against pyld.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/piprate/json-gold/ld"
+	"hegel.dev/go/hegel"
+)
+
+func goNQuads(v interface{}, err error) outcome {
+	if err != nil {
+		return outcome{false, err.Error()}
+	}
+	s, ok := v.(string)
+	if !ok {
+		return outcome{false, "not a string: " + mustJSON(v)}
+	}
+	return outcome{true, sortedLines(s)}
+}
+
+func pyNQuads(r nquadsReply) outcome {
+	if !r.Ok {
+		return outcome{false, r.Error + ": " + r.Message}
+	}
+	return outcome{true, sortedLines(r.NQuads)}
+}
+
+func TestHegelToRDFMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		doc, _ := genDocument(tc)
+		if id := knownToRDF(doc); id != "" {
+			count("known " + id)
+			return
+		}
+		if stringUnderDouble(doc) {
+			count("not judged: string under xsd:double")
+			return
+		}
+		opts := options()
+		opts.Format = "application/n-quads"
+		proc := ld.NewJsonLdProcessor()
+		g := goNQuads(proc.ToRDF(doc, opts))
+		var r nquadsReply
+		ask(&r, "R", mustJSON(doc), pyOptions(nil))
+		p := pyNQuads(r)
+		if unjudgedLanguageKeyword(g.text, p.text) {
+			count("not judged: keyword as a language map key")
+			return
+		}
+		if g.ok && p.ok && g.text != p.text {
+			// blank node labels are the node map's issuing order, not fixed by the spec: the two
+			// datasets may still be the same up to relabelling (json-gold canonicalises both)
+			nopts := options()
+			nopts.InputFormat = "application/n-quads"
+			nopts.Format = "application/n-quads"
+			nopts.Algorithm = ld.AlgorithmURDNA2015
+			gn, err1 := proc.Normalize(g.text, nopts)
+			pn, err2 := proc.Normalize(p.text, nopts)
+			if err1 == nil && err2 == nil && gn == pn {
+				count("toRDF agree up to blank node labels")
+				return
+			}
+		}
+		judge(ht, "toRDF", doc, "", g, p)
+	})
+}
+
+func TestHegelNormalizeMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		doc, _ := genDocument(tc)
+		if id := knownToRDF(doc); id != "" {
+			count("known " + id)
+			return
+		}
+		if stringUnderDouble(doc) {
+			count("not judged: string under xsd:double")
+			return
+		}
+		opts := options()
+		opts.Format = "application/n-quads"
+		opts.Algorithm = ld.AlgorithmURDNA2015
+		proc := ld.NewJsonLdProcessor()
+		g := goNQuads(proc.Normalize(doc, opts))
+		var r nquadsReply
+		ask(&r, "N", mustJSON(doc), pyOptions(nil))
+		p := pyNQuads(r)
+		if unjudgedLanguageKeyword(g.text, p.text) {
+			count("not judged: keyword as a language map key")
+			return
+		}
+		judge(ht, "normalize", doc, "", g, p)
+	})
+}
+
+func TestHegelFromRDFMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		nq := genNQuads(tc)
+		native, rdfType := chance(tc, 50), chance(tc, 30)
+		if id := knownFromRDF(nq, native, rdfType); id != "" {
+			count("known " + id)
+			return
+		}
+		if unjudgedFromRDF(nq, native) {
+			count("not judged: native type with an invalid lexical form")
+			return
+		}
+		opts := options()
+		opts.UseNativeTypes = native
+		opts.UseRdfType = rdfType
+		proc := ld.NewJsonLdProcessor()
+		g := goOutcome(proc.FromRDF(nq, opts))
+		var r jsonReply
+		ask(&r, "FR", nq, mustJSON(map[string]interface{}{"useNativeTypes": native, "useRdfType": rdfType}))
+		judge(ht, "fromRDF", nq, "\n useNativeTypes: "+mustJSON(native)+" useRdfType: "+mustJSON(rdfType), g, pyOutcome(r))
+	})
+}
+
+// The N-Quads parser and serializer: what json-gold reads and writes back is what pyld does.
+func TestHegelNQuadsParseMatchesPyld(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		nq := genNQuads(tc)
+		if id := knownNQuads(nq); id != "" {
+			count("known " + id)
+			return
+		}
+		var g outcome
+		ds, err := ld.ParseNQuads(nq)
+		if err != nil {
+			g = outcome{false, err.Error()}
+		} else {
+			g = goNQuads((&ld.NQuadRDFSerializer{}).Serialize(ds))
+		}
+		var r nquadsReply
+		ask(&r, "P", nq)
+		judge(ht, "nquads", nq, "", g, pyNQuads(r))
+	})
+}
+
+// JSON-LD to RDF and back preserves the dataset: normalising FromRDF(ToRDF(doc)) gives the
+// normalisation of doc. pyld gets the vote when json-gold's round trip does not close.
+func TestHegelRDFRoundTrip(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		doc, _ := genDocument(tc)
+		native := chance(tc, 50)
+		if id := knownRDFRoundTrip(doc, native); id != "" {
+			count("known " + id)
+			return
+		}
+		proc := ld.NewJsonLdProcessor()
+		nopts := options()
+		nopts.Format = "application/n-quads"
+		nopts.Algorithm = ld.AlgorithmURDNA2015
+		want, err := proc.Normalize(doc, nopts)
+		if err != nil {
+			count("normalize error")
+			return
+		}
+		ropts := options()
+		ropts.Format = "application/n-quads"
+		nq, err := proc.ToRDF(doc, ropts)
+		if err != nil {
+			fail(ht, "Normalize works but ToRDF fails: %v\n doc: %s", err, mustJSON(doc))
+			return
+		}
+		if id := knownRDFRoundTripQuads(nq.(string), native); id != "" {
+			count("known " + id)
+			return
+		}
+		if unjudgedFromRDF(nq.(string), native) {
+			// e.g. a boolean coerced to xsd:double: "true"^^xsd:double, see unjudgedFromRDF
+			count("not judged: native type with an invalid lexical form")
+			return
+		}
+		if hasDuplicateLines(nq.(string)) {
+			// repeated values that the node map does not merge (empty lists, and values
+			// under some containers) give the same quad twice in json-gold, pyld and jsonld.js
+			// alike; FromRDF reads a set. Not judged.
+			count("not judged: duplicate quads")
+			return
+		}
+		fopts := options()
+		fopts.UseNativeTypes = native
+		back, err := proc.FromRDF(nq, fopts)
+		if err != nil {
+			fail(ht, "FromRDF of json-gold's own N-Quads fails: %v\n doc: %s\n nquads:\n%s", err, mustJSON(doc), nq)
+			return
+		}
+		got, err := proc.Normalize(back, nopts)
+		if err != nil {
+			fail(ht, "Normalize of FromRDF(ToRDF(doc)) fails: %v\n doc: %s\n back: %s", err, mustJSON(doc), mustJSON(back))
+			return
+		}
+		if strings.TrimSpace(want.(string)) == strings.TrimSpace(got.(string)) {
+			count("round trip closes")
+			return
+		}
+		var f jsonReply
+		ask(&f, "FR", nq.(string), mustJSON(map[string]interface{}{"useNativeTypes": native}))
+		py := "pyld: from_rdf error " + f.Error
+		if f.Ok {
+			var nr nquadsReply
+			ask(&nr, "N", string(f.Result), pyOptions(nil))
+			if nr.Ok {
+				if strings.TrimSpace(nr.NQuads) == strings.TrimSpace(want.(string)) {
+					py = "pyld's from_rdf of the same N-Quads normalises to the original"
+				} else {
+					py = "pyld's from_rdf of the same N-Quads normalises to\n" + nr.NQuads
+				}
+			} else {
+				py = "pyld: normalize error " + nr.Error
+			}
+		}
+		fail(ht, "RDF round trip changes the dataset (useNativeTypes %v)\n doc: %s\n nquads:\n%s\n back: %s\n normalized before:\n%s\n normalized after:\n%s\n %s",
+			native, mustJSON(doc), nq, mustJSON(back), want, got, py)
+	})
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..0538819
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,133 @@
+package hegel
+
+// Hegel property tests for fasthttp: generated HTTP requests, responses, URIs,
+// query strings and cookies, parsed by fasthttp and by the standard library
+// (net/http, net/url), must agree; what fasthttp writes, net/http must read as written.
+//
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime/debug"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+	countsMu      sync.Mutex
+	counts        = map[string]int{}
+	curT          testing.TB
+	firstFailure  sync.Once
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	curT, firstFailure = t, sync.Once{}
+	countsMu.Lock()
+	counts = map[string]int{}
+	countsMu.Unlock()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+	}
+	defer func() {
+		countsMu.Lock()
+		keys := make([]string, 0, len(counts))
+		for k := range counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		for _, k := range keys {
+			t.Logf("COUNT %s: %d", k, counts[k])
+		}
+		countsMu.Unlock()
+		if collecting {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 200 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}
+	}()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the harness: %v\n%s", r, debug.Stack())
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// count tallies a kind of case that is noted, not failed.
+func count(kind string) {
+	countsMu.Lock()
+	counts[kind]++
+	countsMu.Unlock()
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	msg := fmt.Sprintf(format, args...)
+	firstFailure.Do(func() {
+		if curT != nil {
+			curT.Logf("first failing case (before shrinking):\n%s", msg)
+		}
+	})
+	ht.Fatalf("%s", msg)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..20cd8e9
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,657 @@
+package hegel
+
+// Gates for the recorded bugs (bugs.toml), by generated shape or by the shape of the one vote.
+// HEGEL_NO_KNOWN=1 lifts them.
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"math"
+	"os"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+var (
+	keywordLike = regexp.MustCompile(`^@[a-zA-Z]+$`)
+	// a literal whose text starts with @ and carries a language tag
+	atLiteralWithLang = regexp.MustCompile(`"@[^"]*"@[A-Za-z]`)
+	langStringTyped   = regexp.MustCompile(`\^\^<http://www\.w3\.org/1999/02/22-rdf-syntax-ns#langString>`)
+	integerTyped      = regexp.MustCompile(`\^\^<http://www\.w3\.org/2001/XMLSchema#integer>`)
+	typedLexical      = regexp.MustCompile(`"((?:[^"\\]|\\.)*)"\^\^<http://www\.w3\.org/2001/XMLSchema#(integer|double|boolean)>`)
+	patternInteger    = regexp.MustCompile(`^[\-+]?\d+$`)
+	patternDouble     = regexp.MustCompile(`^(\+|-)?(\d+(\.\d*)?|\.\d+)([Ee](\+|-)?\d+)?$`)
+)
+
+// ctxBaseSlash: the compaction context sets a @base ending in a slash (json-gold/1, the
+// relative IRI computed against such a base climbs one directory too many).
+func ctxBaseSlash(ctx interface{}) bool {
+	m, ok := ctx.(map[string]interface{})
+	if !ok {
+		return false
+	}
+	b, ok := m["@base"].(string)
+	return ok && strings.HasSuffix(b, "/")
+}
+
+// ctxNullTerm: the context maps a term to null (json-gold/5, Flatten panics serialising it).
+func ctxNullTerm(ctx interface{}) bool {
+	m, ok := ctx.(map[string]interface{})
+	if !ok {
+		return false
+	}
+	for _, v := range m {
+		if v == nil {
+			return true
+		}
+	}
+	return false
+}
+
+// hasKeywordValue: a string of the form of a keyword (@id, @foo) in a value position of a
+// property (json-gold/8, ToRDF writes it as the IRI <@id>).
+func hasKeywordValue(v interface{}) bool {
+	var walk func(v interface{}, underProp bool) bool
+	walk = func(v interface{}, underProp bool) bool {
+		switch x := v.(type) {
+		case map[string]interface{}:
+			for k, val := range x {
+				switch {
+				case k == "@context":
+					continue
+				case k == "@list" || k == "@set":
+					if walk(val, underProp) {
+						return true
+					}
+				case strings.HasPrefix(k, "@"):
+					if walk(val, false) {
+						return true
+					}
+				default:
+					if walk(val, true) {
+						return true
+					}
+				}
+			}
+		case []interface{}:
+			for _, e := range x {
+				if walk(e, underProp) {
+					return true
+				}
+			}
+		case string:
+			return underProp && keywordLike.MatchString(x)
+		}
+		return false
+	}
+	return walk(v, false)
+}
+
+func knownExpand(doc interface{}) string { return "" }
+
+var percentEscape = regexp.MustCompile(`%[0-9A-Fa-f]{2}`)
+
+// knownVote: json-gold/2, the two outputs differ only by json-gold percent-encoding characters
+// of IRIs it resolved (non-ASCII, spaces, backslashes reaching an IRI position, e.g. through
+// an index map).
+func knownVote(g, p outcome) string {
+	if noKnown || !g.ok || !p.ok || g.text == p.text || !percentEscape.MatchString(g.text) {
+		return ""
+	}
+	decoded := percentEscape.ReplaceAllStringFunc(g.text, func(s string) string {
+		b, _ := hex.DecodeString(s[1:])
+		return string(b)
+	})
+	// the decoded bytes form UTF-8 text again; compare as JSON so \u escapes do not matter
+	if canon(decoded) == canon(p.text) || decoded == p.text {
+		return "json-gold/2"
+	}
+	return ""
+}
+
+// docHasSetOrList: the document has an explicit @set or @list object somewhere.
+func docHasSetOrList(v interface{}) bool {
+	switch x := v.(type) {
+	case map[string]interface{}:
+		for k, val := range x {
+			if k == "@set" || k == "@list" {
+				return true
+			}
+			if k != "@context" && docHasSetOrList(val) {
+				return true
+			}
+		}
+	case []interface{}:
+		for _, e := range x {
+			if docHasSetOrList(e) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// knownErrorSwallowed: json-gold/12, an error while expanding the items of an explicit @set or
+// @list is discarded (the item becomes {} or null), so json-gold succeeds where pyld reports
+// the invalid document.
+func knownErrorSwallowed(doc interface{}, g, p outcome) string {
+	if noKnown || !g.ok || p.ok || !docHasSetOrList(doc) {
+		return ""
+	}
+	return "json-gold/12"
+}
+
+// emptyNamedGraph: a named graph whose nodes all have only an @id (json-gold/11, Flatten drops
+// the graph's node instead of giving it an empty @graph).
+func emptyNamedGraph(doc interface{}) bool {
+	nodes, ok := doc.([]interface{})
+	if !ok {
+		nodes = []interface{}{doc}
+	}
+	for _, nd := range nodes {
+		m, ok := nd.(map[string]interface{})
+		if !ok || m["@id"] == nil {
+			continue
+		}
+		graph, ok := m["@graph"].([]interface{})
+		if !ok {
+			continue
+		}
+		empty := true
+		for _, g := range graph {
+			gm, ok := g.(map[string]interface{})
+			if !ok {
+				empty = false
+				break
+			}
+			for k := range gm {
+				if k != "@id" && k != "@context" {
+					empty = false
+				}
+			}
+		}
+		if empty {
+			return true
+		}
+	}
+	return false
+}
+
+// fragmentUnderSlashBase: a node @id "#frag" resolved against a @base ending in a slash gives
+// .../#frag, which compacts against the document base .../doc to "#frag" and so re-expands to
+// .../doc#frag (json-gold/1: RemoveBase drops the empty last segment; pyld and jsonld.js too).
+func fragmentUnderSlashBase(doc interface{}, docCtx interface{}) bool {
+	if !ctxBaseSlash(docCtx) {
+		return false
+	}
+	nodes, ok := doc.([]interface{})
+	if !ok {
+		nodes = []interface{}{doc}
+	}
+	for _, nd := range nodes {
+		if m, ok := nd.(map[string]interface{}); ok {
+			if id, ok := m["@id"].(string); ok && strings.HasPrefix(id, "#") {
+				return true
+			}
+			if graph, ok := m["@graph"].([]interface{}); ok && fragmentUnderSlashBase(graph, docCtx) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func knownCompact(doc interface{}, ctx interface{}) string {
+	if noKnown {
+		return ""
+	}
+	if ctxBaseSlash(ctx) {
+		return "json-gold/1"
+	}
+	if hasEmptyList(doc) && ctxTypedOrLanguageTerm(ctx) {
+		return "json-gold/13"
+	}
+	return ""
+}
+
+// knownCompactVote: json-gold/3, compaction with nothing to output loses the @context.
+func knownCompactVote(g, p outcome) string {
+	if noKnown || !g.ok || !p.ok || g.text != "{}" {
+		return ""
+	}
+	var pm map[string]interface{}
+	if json.Unmarshal([]byte(p.text), &pm) != nil || pm["@context"] == nil {
+		return ""
+	}
+	// pyld adds an empty @graph to an empty compaction; jsonld.js and the spec do not
+	graph, hasGraph := pm["@graph"].([]interface{})
+	if len(pm) == 1 || (len(pm) == 2 && hasGraph && len(graph) == 0) {
+		return "json-gold/3"
+	}
+	return ""
+}
+
+// anonymousTopGraph: a top-level node object with @graph and no @id. Its compaction is the
+// document's top-level @graph, which expands back to the default graph: lossy by the spec's
+// own design (pyld does the same). Not judged.
+func anonymousTopGraph(doc interface{}) bool {
+	nodes, ok := doc.([]interface{})
+	if !ok {
+		nodes = []interface{}{doc}
+	}
+	for _, nd := range nodes {
+		if m, ok := nd.(map[string]interface{}); ok {
+			if _, hasGraph := m["@graph"]; hasGraph && m["@id"] == nil {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func knownFlatten(doc interface{}, ctx interface{}) string {
+	if noKnown {
+		return ""
+	}
+	if ctxNullTerm(ctx) {
+		return "json-gold/5"
+	}
+	if ctxBaseSlash(ctx) {
+		return "json-gold/1"
+	}
+	if emptyNamedGraph(doc) {
+		return "json-gold/11"
+	}
+	if ctx != nil && hasEmptyList(doc) && ctxTypedOrLanguageTerm(ctx) {
+		return "json-gold/13"
+	}
+	return ""
+}
+
+// knownFlattenVote: json-gold/4, Flatten's @context is a re-serialisation of the active
+// context instead of the provided one, and a bare [] when there is nothing to output.
+func knownFlattenVote(g, p outcome) string {
+	if noKnown || !g.ok || !p.ok {
+		return ""
+	}
+	var gv, pv interface{}
+	if json.Unmarshal([]byte(g.text), &gv) != nil || json.Unmarshal([]byte(p.text), &pv) != nil {
+		return ""
+	}
+	pm, pIsMap := pv.(map[string]interface{})
+	if !pIsMap || pm["@context"] == nil {
+		return ""
+	}
+	if ga, isArr := gv.([]interface{}); isArr && len(ga) == 0 {
+		if graph, ok := pm["@graph"].([]interface{}); ok && len(graph) == 0 {
+			return "json-gold/4"
+		}
+		return ""
+	}
+	gm, gIsMap := gv.(map[string]interface{})
+	if !gIsMap || gm["@context"] == nil {
+		return ""
+	}
+	delete(gm, "@context")
+	delete(pm, "@context")
+	if reflect.DeepEqual(gm, pm) {
+		return "json-gold/4"
+	}
+	return ""
+}
+
+// knownFlattenGraphVote: json-gold/11 by the vote, for a context-free flattening: pyld's
+// output is json-gold's plus named-graph nodes with an empty @graph (the graph's nodes had
+// nothing but an @id once undefined terms were dropped, which the shape gate cannot see).
+func knownFlattenGraphVote(g, p outcome) string {
+	if noKnown || !g.ok || !p.ok {
+		return ""
+	}
+	var gv, pv interface{}
+	if json.Unmarshal([]byte(g.text), &gv) != nil || json.Unmarshal([]byte(p.text), &pv) != nil {
+		return ""
+	}
+	// with a context both are {"@context": ..., "@graph": [...]}: the context may differ by
+	// json-gold/4 as well, so compare the node arrays only
+	nodes := func(v interface{}) ([]interface{}, bool) {
+		switch x := v.(type) {
+		case []interface{}:
+			return x, true
+		case map[string]interface{}:
+			arr, ok := x["@graph"].([]interface{})
+			return arr, ok
+		}
+		return nil, false
+	}
+	ga, ok1 := nodes(gv)
+	pa, ok2 := nodes(pv)
+	if !ok1 || !ok2 {
+		return ""
+	}
+	if ga == nil {
+		ga = []interface{}{} // json-gold's bare [] (json-gold/4 as well, when a context was given)
+	}
+	kept := []interface{}{}
+	dropped := false
+	for _, e := range pa {
+		// a graph node with nothing but its identifier (under @id or an alias) and an empty
+		// @graph
+		if m, ok := e.(map[string]interface{}); ok && len(m) == 2 {
+			if graph, ok := m["@graph"].([]interface{}); ok && len(graph) == 0 {
+				dropped = true
+				continue
+			}
+		}
+		kept = append(kept, e)
+	}
+	if dropped && mustJSON(kept) == mustJSON(ga) {
+		return "json-gold/11"
+	}
+	return ""
+}
+
+// unjudgedLanguageKeyword: a language map key of the form of a keyword (@set, @list as a
+// language): pyld writes it as a language tag (""@@set), json-gold drops the value. Neither
+// is clearly right; the input is nonsense. Not judged.
+func unjudgedLanguageKeyword(texts ...string) bool {
+	for _, t := range texts {
+		if strings.Contains(t, `"@@`) || strings.Contains(t, `"@language":"@`) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasEmptyList: an empty list somewhere in the document, explicit ({"@list": []}) or an empty
+// array under a term the document's contexts give a @list container (json-gold/13 when
+// compacted with a term that has a type or language mapping).
+func allNull(arr []interface{}) bool {
+	for _, e := range arr {
+		if e != nil {
+			return false
+		}
+	}
+	return true
+}
+
+func hasEmptyList(doc interface{}) bool {
+	listTerms := map[string]bool{}
+	var collect func(v interface{})
+	collect = func(v interface{}) {
+		switch x := v.(type) {
+		case map[string]interface{}:
+			for k, val := range x {
+				if k != "@context" {
+					collect(val)
+					continue
+				}
+				ctx, ok := val.(map[string]interface{})
+				if !ok {
+					continue
+				}
+				for term, def := range ctx {
+					if dm, ok := def.(map[string]interface{}); ok {
+						if c, ok := dm["@container"]; ok && strings.Contains(mustJSON(c), `"@list"`) {
+							listTerms[term] = true
+						}
+					}
+				}
+			}
+		case []interface{}:
+			for _, e := range x {
+				collect(e)
+			}
+		}
+	}
+	collect(doc)
+	var walk func(v interface{}) bool
+	walk = func(v interface{}) bool {
+		switch x := v.(type) {
+		case map[string]interface{}:
+			for k, val := range x {
+				if arr, ok := val.([]interface{}); ok && allNull(arr) && (k == "@list" || listTerms[k]) {
+					// nulls are dropped from a list: [null, null] expands to an empty list
+					return true
+				}
+				// {"@set": []} under a @list term expands to an empty list too
+				if m, ok := val.(map[string]interface{}); ok && listTerms[k] {
+					if arr, ok := m["@set"].([]interface{}); ok && len(arr) == 0 {
+						return true
+					}
+				}
+				if k != "@context" && walk(val) {
+					return true
+				}
+			}
+		case []interface{}:
+			for _, e := range x {
+				if walk(e) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	return walk(doc)
+}
+
+// ctxTypedOrLanguageTerm: the context defines a term with a type mapping (@vocab included,
+// @id not), a language mapping, a container or a reverse mapping: the shapes whose empty
+// @list values json-gold compacts under the IRI (json-gold/13).
+func ctxTypedOrLanguageTerm(ctx interface{}) bool {
+	m, ok := ctx.(map[string]interface{})
+	if !ok {
+		return false
+	}
+	for _, v := range m {
+		def, ok := v.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		if t, ok := def["@type"].(string); ok && t != "@id" {
+			return true
+		}
+		for _, k := range []string{"@language", "@container", "@reverse"} {
+			if _, ok := def[k]; ok {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// stringUnderDouble: a string value under a term coerced to xsd:double, or a value object
+// typed xsd:double with a string @value. The specification's object-to-RDF conversion keeps a
+// string as the literal's lexical form (json-gold does); pyld and jsonld.js canonicalise it as
+// a double ("1" becomes "1.0E0", jsonld.js makes "NaN" of a word). Not judged.
+func stringUnderDouble(doc interface{}) bool {
+	doubleTerms := map[string]bool{}
+	var collect func(v interface{})
+	collect = func(v interface{}) {
+		switch x := v.(type) {
+		case map[string]interface{}:
+			for k, val := range x {
+				if k != "@context" {
+					collect(val)
+					continue
+				}
+				ctx, ok := val.(map[string]interface{})
+				if !ok {
+					continue
+				}
+				for term, def := range ctx {
+					if dm, ok := def.(map[string]interface{}); ok {
+						if t, ok := dm["@type"].(string); ok && (t == xsd+"double" || t == "xsd:double") {
+							doubleTerms[term] = true
+						}
+					}
+				}
+			}
+		case []interface{}:
+			for _, e := range x {
+				collect(e)
+			}
+		}
+	}
+	collect(doc)
+	var hasString func(v interface{}) bool
+	hasString = func(v interface{}) bool {
+		switch x := v.(type) {
+		case string:
+			return true
+		case []interface{}:
+			for _, e := range x {
+				if hasString(e) {
+					return true
+				}
+			}
+		case map[string]interface{}:
+			_, isValue := x["@value"].(string)
+			_, typed := x["@type"]
+			return isValue && !typed
+		}
+		return false
+	}
+	var walk func(v interface{}) bool
+	walk = func(v interface{}) bool {
+		switch x := v.(type) {
+		case map[string]interface{}:
+			if _, ok := x["@value"].(string); ok {
+				if t, ok := x["@type"].(string); ok && (t == xsd+"double" || t == "xsd:double") {
+					return true
+				}
+			}
+			for k, val := range x {
+				if doubleTerms[k] && hasString(val) {
+					return true
+				}
+				if k != "@context" && walk(val) {
+					return true
+				}
+			}
+		case []interface{}:
+			for _, e := range x {
+				if walk(e) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	return walk(doc)
+}
+
+func knownRoundTrip(doc interface{}, ctx interface{}, docCtx interface{}) string {
+	if noKnown {
+		return ""
+	}
+	if ctxBaseSlash(ctx) || fragmentUnderSlashBase(doc, docCtx) {
+		return "json-gold/1"
+	}
+	if hasKeywordValue(doc) {
+		// the "IRI" @id compacts to the alias of the keyword and re-expands to another IRI
+		return "json-gold/8"
+	}
+	return ""
+}
+
+func knownToRDF(doc interface{}) string {
+	if noKnown {
+		return ""
+	}
+	if hasKeywordValue(doc) {
+		return "json-gold/8"
+	}
+	return ""
+}
+
+func knownFromRDF(nq string, native, rdfType bool) string {
+	if noKnown {
+		return ""
+	}
+	if atLiteralWithLang.MatchString(nq) {
+		return "json-gold/7"
+	}
+	if native {
+		for _, m := range typedLexical.FindAllStringSubmatch(nq, -1) {
+			lex, kind := m[1], m[2]
+			if kind == "integer" && patternInteger.MatchString(lex) {
+				if _, err := strconv.ParseInt(lex, 10, 64); err != nil {
+					return "json-gold/14"
+				}
+			}
+			if kind == "double" && patternDouble.MatchString(lex) {
+				if f, err := strconv.ParseFloat(lex, 64); err != nil || math.IsInf(f, 0) {
+					return "json-gold/14"
+				}
+			}
+		}
+	}
+	return ""
+}
+
+// unjudgedFromRDF: with useNativeTypes, an xsd:integer or xsd:double literal whose lexical form
+// is not a valid number. The spec's RDF to Object Conversion (step 2.4.2.3 then nothing) leaves
+// such a value untyped, which json-gold and jsonld.js do; pyld keeps the datatype, as the test
+// suite's fromRdf#t0027 expects for values that cannot be JSON numbers. Not judged.
+func unjudgedFromRDF(nq string, native bool) bool {
+	if !native {
+		return false
+	}
+	for _, m := range typedLexical.FindAllStringSubmatch(nq, -1) {
+		lex, kind := m[1], m[2]
+		if kind == "integer" && !patternInteger.MatchString(lex) {
+			return true
+		}
+		// pyld converts "1"/"0" (the spec names only true/false) and keeps other forms typed
+		if kind == "boolean" && lex != "true" && lex != "false" {
+			return true
+		}
+		if kind == "double" && (!patternDouble.MatchString(lex) || strings.Contains(strings.ToUpper(lex), "INF") || strings.Contains(lex, "NaN")) {
+			return true
+		}
+		// an integral xsd:double ("1", "-0.0") becomes a JSON number that is an integer, and
+		// so xsd:integer on the way back (pyld too): inherent to native types
+		if kind == "double" && patternDouble.MatchString(lex) {
+			if f, err := strconv.ParseFloat(lex, 64); err == nil && f == math.Trunc(f) && !math.IsInf(f, 0) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func knownNQuads(nq string) string {
+	if noKnown {
+		return ""
+	}
+	if atLiteralWithLang.MatchString(nq) {
+		return "json-gold/7"
+	}
+	if langStringTyped.MatchString(nq) {
+		return "json-gold/9"
+	}
+	return ""
+}
+
+func knownRDFRoundTrip(doc interface{}, native bool) string { return "" }
+
+// knownRDFRoundTripQuads: the N-Quads json-gold wrote for the document decide the round trip's
+// gates: an xsd:integer read back as a native int64 crashes ToRDF (json-gold/6); a literal
+// starting with @ with a language tag is mangled by the parser (json-gold/7).
+func knownRDFRoundTripQuads(nq string, native bool) string {
+	if noKnown {
+		return ""
+	}
+	if native && integerTyped.MatchString(nq) {
+		return "json-gold/6"
+	}
+	if atLiteralWithLang.MatchString(nq) {
+		return "json-gold/7"
+	}
+	return ""
+}
diff --git a/hegel/oracle.go b/hegel/oracle.go
new file mode 100644
index 0000000..0b735b0
--- /dev/null
+++ b/hegel/oracle.go
@@ -0,0 +1,171 @@
+package hegel
+
+// The oracle: pyld (Python, Digital Bazaar's JSON-LD 1.1 processor), driven as one persistent
+// child: a command and hex-encoded arguments per line in, one JSON object per line out. Every
+// reply has "ok"; a failure carries "error" (the JSON-LD error code, or the exception class)
+// and "message". The child has no document loader: every context is inline.
+
+import (
+	"bufio"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+)
+
+const pythonScript = `
+import sys, json
+from pyld import jsonld
+
+def no_loader(url, options):
+    raise jsonld.JsonLdError("offline oracle: " + url, "jsonld.LoadDocumentError", code="loading document failed")
+
+def hx(s):
+    return bytes.fromhex(s).decode()
+
+def opts(j):
+    o = json.loads(j) if j else {}
+    o["documentLoader"] = no_loader
+    o.setdefault("processingMode", "json-ld-1.1")
+    return o
+
+def handle(cmd, a):
+    if cmd == "E":  # expand: doc json, options json
+        return {"result": jsonld.expand(json.loads(a[0]), opts(a[1]))}
+    if cmd == "C":  # compact: doc json, context json, options json
+        return {"result": jsonld.compact(json.loads(a[0]), json.loads(a[1]), opts(a[2]))}
+    if cmd == "F":  # flatten: doc json, context json (or "null"), options json
+        return {"result": jsonld.flatten(json.loads(a[0]), json.loads(a[1]), opts(a[2]))}
+    if cmd == "R":  # to_rdf: doc json, options json -> n-quads
+        o = opts(a[1])
+        o["format"] = "application/n-quads"
+        return {"nquads": jsonld.to_rdf(json.loads(a[0]), o)}
+    if cmd == "N":  # normalize: doc json, options json -> n-quads
+        o = opts(a[1])
+        o["format"] = "application/n-quads"
+        o.setdefault("algorithm", "URDNA2015")
+        return {"nquads": jsonld.normalize(json.loads(a[0]), o)}
+    if cmd == "NQ":  # normalize n-quads: n-quads, options json -> n-quads
+        o = opts(a[1])
+        o["format"] = "application/n-quads"
+        o["inputFormat"] = "application/n-quads"
+        o.setdefault("algorithm", "URDNA2015")
+        return {"nquads": jsonld.normalize(a[0], o)}
+    if cmd == "FR":  # from_rdf: n-quads, options json
+        o = json.loads(a[1]) if a[1] else {}
+        o["format"] = "application/n-quads"
+        return {"result": jsonld.from_rdf(a[0], o)}
+    if cmd == "P":  # parse n-quads and serialize back
+        ds = jsonld.JsonLdProcessor.parse_nquads(a[0])
+        return {"nquads": jsonld.JsonLdProcessor.to_nquads(ds)}
+    return {"ok": False, "error": "unknown command " + cmd}
+
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [hx(p) for p in parts[1:]]
+    try:
+        reply = handle(cmd, args)
+        reply.setdefault("ok", True)
+    except jsonld.JsonLdError as e:
+        reply = {"ok": False, "error": str(e.code or e.type), "message": str(e).split("\n")[0][:300]}
+    except Exception as e:
+        reply = {"ok": False, "error": type(e).__name__, "message": str(e)[:300]}
+    print(json.dumps(reply), flush=True)
+`
+
+type pyChild struct {
+	mu    sync.Mutex
+	cmd   *exec.Cmd
+	stdin *bufio.Writer
+	out   *bufio.Reader
+}
+
+var (
+	pyOnce sync.Once
+	py     *pyChild
+)
+
+func oracle() *pyChild {
+	pyOnce.Do(func() {
+		python := "python3"
+		if p := os.Getenv("HEGEL_PYTHON"); p != "" {
+			python = p
+		}
+		cmd := exec.Command(python, "-u", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			panic(err)
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			panic(err)
+		}
+		if err := cmd.Start(); err != nil {
+			panic(fmt.Sprintf("python3 with pyld is needed as the oracle: %v", err))
+		}
+		py = &pyChild{cmd: cmd, stdin: bufio.NewWriter(in), out: bufio.NewReader(out)}
+	})
+	return py
+}
+
+// reply is the common part of every oracle answer.
+type reply struct {
+	Ok      bool   `json:"ok"`
+	Error   string `json:"error"`
+	Message string `json:"message"`
+}
+
+// jsonReply carries a JSON-LD document.
+type jsonReply struct {
+	reply
+	Result json.RawMessage `json:"result"`
+}
+
+// nquadsReply carries an N-Quads serialization.
+type nquadsReply struct {
+	reply
+	NQuads string `json:"nquads"`
+}
+
+// ask sends one request and decodes the JSON answer into v (which embeds reply).
+func ask(v interface{}, cmd string, args ...string) {
+	p := oracle()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	line := cmd
+	for _, a := range args {
+		line += " " + hex.EncodeToString([]byte(a))
+	}
+	p.stdin.WriteString(line + "\n")
+	if err := p.stdin.Flush(); err != nil {
+		panic(fmt.Sprintf("pyld oracle: %v", err))
+	}
+	raw, err := p.out.ReadBytes('\n')
+	if err != nil {
+		panic(fmt.Sprintf("pyld oracle exited: %v", err))
+	}
+	if err := json.Unmarshal(raw, v); err != nil {
+		panic(fmt.Sprintf("pyld oracle reply %q: %v", raw, err))
+	}
+}
+
+func mustJSON(v interface{}) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic(err)
+	}
+	return string(b)
+}
+
+// canon re-encodes JSON with sorted keys (and numbers through float64 on both sides) so the two
+// sides compare as text.
+func canon(raw string) string {
+	var v interface{}
+	if err := json.Unmarshal([]byte(raw), &v); err != nil {
+		return "INVALID JSON: " + raw
+	}
+	return mustJSON(v)
+}
