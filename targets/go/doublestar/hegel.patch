+// ---------------------------------------------------------------------------
+// Property: SplitPattern splits before the first meta character.
+
+func TestHegelSplitPatternRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// A base of one to three literal segments (meta characters
+		// escaped), then a pattern.
+		k := n(ht, 0, 3)
+		var base []string
+		for i := 0; i < k; i++ {
+			seg := genLiteral(ht, 1, 3)
+			if chance(ht, 20) {
+				seg += `\*`
+			}
+			base = append(base, seg)
+		}
+		p := genPattern(ht)
+		for tries := 0; tries < 20 && (!strings.ContainsAny(p.text, `*?[{`) || strings.HasPrefix(p.text, "/")); tries++ {
+			p = genPattern(ht)
+		}
+		if !strings.ContainsAny(p.text, `*?[{`) || strings.HasPrefix(p.text, "/") {
+			return
+		}
+		// The pattern's own first segment must contain a meta character,
+		// else the split point moves into it.
+		first := strings.SplitN(p.text, "/", 2)[0]
+		if !strings.ContainsAny(strings.ReplaceAll(first, `\`, ""), `*?[{`) || strings.ContainsAny(first, `\`) {
+			return
+		}
+		full := p.text
+		if k > 0 {
+			full = strings.Join(base, "/") + "/" + p.text
+		}
+		note(ht, "SplitPattern(%q)", full)
+		gotBase, gotPat := doublestar.SplitPattern(full)
+		wantBase := "."
+		if k > 0 {
+			wantBase = strings.ReplaceAll(strings.Join(base, "/"), `\*`, "*")
+		}
+		if gotBase != wantBase || gotPat != p.text {
+			fail(ht, "SplitPattern(%q) = %q, %q; want %q, %q", full, gotBase, gotPat, wantBase, p.text)
+		}
+	})
+}
