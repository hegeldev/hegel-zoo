+// ---------------------------------------------------------------------------
+// Property: on the full syntax, Match follows the documented grammar.
+
+func TestHegelMatchFollowsTheGrammar(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := genPattern(ht)
+		skip := func() bool { return p.consecDS || p.lazyAlt || p.unmatched || p.starTail || p.altDS }
+		for tries := 0; tries < 20 && skip(); tries++ {
+			p = genPattern(ht)
+		}
+		if skip() {
+			return
+		}
+		name := genName(ht)
+		if classVsSlash(p.text, name) {
+			name = strings.ReplaceAll(name, "/", "")
+		}
+		// The rest of a `**` pattern after an empty or slash-terminated
+		// name is recognised only in fixed shapes (doublestar/1).
+		if strings.Contains(p.text, "**") && (name == "" || strings.HasSuffix(name, "/") || strings.HasSuffix(p.text, "/")) {
+			return
+		}
+		note(ht, "Match(%q, %q)", p.text, name)
+		got, gerr := doublestar.Match(p.text, name)
+		want, werr := modelMatch(p.text, name)
+		if got != want || (gerr != nil) != (werr != nil) {
+			fail(ht, "Match(%q, %q) = %v, %v; model = %v, %v", p.text, name, got, gerr, want, werr)
+		}
+		if gerr == nil && doublestar.MatchUnvalidated(p.text, name) != got {
+			fail(ht, "MatchUnvalidated(%q, %q) = %v, Match = %v", p.text, name, !got, got)
+		}
+		if !p.unmatched && doublestar.ValidatePattern(p.text) != modelValid(p.text) {
+			fail(ht, "ValidatePattern(%q) = %v, model = %v", p.text, !modelValid(p.text), modelValid(p.text))
+		}
+		if p2, p3 := doublestar.PathMatch, doublestar.PathMatchUnvalidated; true {
+			got3, gerr3 := p2(p.text, name)
+			if got3 != got || (gerr3 != nil) != (gerr != nil) {
+				fail(ht, "PathMatch(%q, %q) = %v, %v; Match = %v, %v", p.text, name, got3, gerr3, got, gerr)
+			}
+			if gerr == nil && p3(p.text, name) != got {
+				fail(ht, "PathMatchUnvalidated(%q, %q) disagrees with Match", p.text, name)
+			}
+		}
+	})
+}
