+// ---------------------------------------------------------------------------
+// Property: Glob lists exactly the tree entries Match accepts.
+
+func TestHegelGlobListsWhatMatchAccepts(t *testing.T) {
+	buildTree(t)
+	property(t, func(ht *hegel.T) {
+		p := genPattern(ht)
+		for tries := 0; tries < 20 && !globPatternOK(p); tries++ {
+			p = genPattern(ht)
+		}
+		if !globPatternOK(p) {
+			return
+		}
+		// Trailing slashes on a pattern without meta characters are pinned
+		// (doublestar/5); trailing slashes with meta characters are checked.
+		if strings.HasSuffix(p.text, "/") && !strings.ContainsAny(p.text, `*?[{\`) {
+			p.text = strings.TrimSuffix(p.text, "/")
+		}
+		filesOnly := chance(ht, 25)
+		var opts []doublestar.GlobOption
+		if filesOnly {
+			opts = append(opts, doublestar.WithFilesOnly())
+		}
+		note(ht, "Glob(%q) filesOnly=%v", p.text, filesOnly)
+		got, err := doublestar.Glob(treeFS, p.text, opts...)
+		if err != nil {
+			fail(ht, "Glob(%q): %v", p.text, err)
+			return
+		}
+		gotSet, dups := sortedSet(got)
+		want, _ := modelGlob(p.text, filesOnly)
+		wantSet, _ := sortedSet(want)
+		if !reflect.DeepEqual(gotSet, wantSet) {
+			fail(ht, "Glob(%q, filesOnly=%v) = %q\n  want %q", p.text, filesOnly, got, wantSet)
+		}
+		// Duplicates are pinned (doublestar/2) for patterns with two `**`
+		// segments or with alternatives; the rest must be duplicate-free.
+		if len(dups) > 0 && strings.Count(p.text, "**") <= 1 && !strings.Contains(p.text, "{") {
+			fail(ht, "Glob(%q) returned duplicates %q in %q", p.text, dups, got)
+		}
+		// GlobWalk visits the same names.
+		var walked []string
+		if err := doublestar.GlobWalk(treeFS, p.text, func(path string, d fs.DirEntry) error {
+			walked = append(walked, path)
+			return nil
+		}, opts...); err != nil {
+			fail(ht, "GlobWalk(%q): %v", p.text, err)
+		}
+		walkedSet, _ := sortedSet(walked)
+		if !reflect.DeepEqual(walkedSet, gotSet) {
+			fail(ht, "GlobWalk(%q) = %q, Glob = %q", p.text, walked, got)
+		}
+		// FilepathGlob on the real directory is Glob joined with the base
+		// (it cleans the pattern, so trailing slashes are pinned, doublestar/8).
+		if !strings.HasSuffix(p.text, "/") {
+			fp, err := doublestar.FilepathGlob(filepath.Join(treeDir, p.text), opts...)
+			if err != nil {
+				fail(ht, "FilepathGlob(%q): %v", p.text, err)
+			}
+			var rel []string
+			for _, m := range fp {
+				r, _ := filepath.Rel(treeDir, m)
+				rel = append(rel, filepath.ToSlash(r))
+			}
+			relSet, _ := sortedSet(rel)
+			if !reflect.DeepEqual(relSet, gotSet) {
+				fail(ht, "FilepathGlob(dir/%q) = %q, Glob = %q", p.text, rel, got)
+			}
+		}
+		// Match agrees with membership (patterns without a trailing slash).
+		if !strings.HasSuffix(p.text, "/") && !filesOnly {
+			for _, tp := range treePaths {
+				if tp == "." {
+					continue // listed only for a bare `**`
+				}
+				if !treeDirs[tp] && endsInDoublestar(p.text) {
+					continue // a final `**` matches "the directory itself" only for directories
+				}
+				if classVsSlash(p.text, tp) {
+					continue // doublestar/11
+				}
+				m, _ := doublestar.Match(p.text, tp)
+				in := sort.SearchStrings(gotSet, tp) < len(gotSet) && gotSet[sort.SearchStrings(gotSet, tp)] == tp
+				if m != in {
+					fail(ht, "Match(%q, %q) = %v but Glob(%q) = %q", p.text, tp, m, p.text, got)
+				}
+			}
+		}
+		// On the shared syntax, io/fs.Glob agrees.
+		if p.standard && !strings.HasSuffix(p.text, "/") && !filesOnly {
+			std, err := fs.Glob(treeFS, p.text)
+			if err != nil {
+				fail(ht, "fs.Glob(%q): %v", p.text, err)
+			}
+			stdSet, _ := sortedSet(std)
+			if !reflect.DeepEqual(stdSet, gotSet) {
+				fail(ht, "Glob(%q) = %q, fs.Glob = %q", p.text, got, std)
+			}
+		}
+		// Case-insensitivity only adds matches.
+		ci, err := doublestar.Glob(treeFS, p.text, append(opts, doublestar.WithCaseInsensitive())...)
+		if err != nil {
+			fail(ht, "Glob(%q, CaseInsensitive): %v", p.text, err)
+		}
+		ciSet, _ := sortedSet(ci)
+		for _, g := range gotSet {
+			if i := sort.SearchStrings(ciSet, g); i >= len(ciSet) || ciSet[i] != g {
+				fail(ht, "Glob(%q, CaseInsensitive) = %q lacks %q from Glob", p.text, ci, g)
+			}
+		}
+	})
+}
