+package doublestar_test
+
+// Hegel property tests for github.com/bmatcuk/doublestar/v4.
+//
+// Three oracles. (1) The standard library: Match is documented as a drop-in
+// replacement for path.Match, PathMatch for filepath.Match and Glob for
+// io/fs.Glob, so on the syntax they share (no alternatives, no `**` segment,
+// classes as path.Match accepts them) they must agree, match and error alike.
+// (2) A reference matcher written from the documented grammar: alternatives
+// are expanded, the pattern and the name are split on `/`, a `**` segment
+// matches zero or more name segments (and a pattern ending in `/**` or `/**/`
+// matches the directory itself), every other segment is matched by a
+// path.Match-style single-segment matcher with doublestar's class rules
+// (`!` or `^` negation, a `-` at either end of a class is literal). (3) bash
+// with globstar on a fixed directory tree, an independent check of the model
+// for Glob, with and without dotglob (WithNoHidden).
+//
+// Set DOUBLESTAR_COLLECT=1 to record mismatches instead of failing and print
+// them (shortest first) at the end of each test.
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"os/exec"
+	"path"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/bmatcuk/doublestar/v4"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness helpers.
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+type collected struct{}
+
+var (
+	collecting    = os.Getenv("DOUBLESTAR_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// The reference matcher.
+
+var errBad = fmt.Errorf("bad pattern")
+
+// expandAlts returns every pattern obtained by choosing one alternative in
+// each {…} group (nested groups included); ok is false for an unclosed `{`.
+// An unmatched `}` is a literal, as Match treats it.
+func expandAlts(p string) ([]string, bool) {
+	for i := 0; i < len(p); i++ {
+		switch p[i] {
+		case '\\':
+			i++
+		case '{':
+			depth, start := 1, i+1
+			var alts []string
+			for j := i + 1; j < len(p); j++ {
+				switch p[j] {
+				case '\\':
+					j++
+				case '{':
+					depth++
+				case '}':
+					depth--
+					if depth == 0 {
+						alts = append(alts, p[start:j])
+						var out []string
+						for _, a := range alts {
+							sub, ok := expandAlts(p[:i] + a + p[j+1:])
+							if !ok {
+								return nil, false
+							}
+							out = append(out, sub...)
+						}
+						return out, true
+					}
+				case ',':
+					if depth == 1 {
+						alts = append(alts, p[start:j])
+						start = j + 1
+					}
+				}
+			}
+			return nil, false
+		}
+	}
+	return []string{p}, true
+}
+
+// matchSeg matches one path segment against one pattern segment (no `/`).
+func matchSeg(pat, name string) (bool, error) {
+	for len(pat) > 0 {
+		switch pat[0] {
+		case '*':
+			for len(pat) > 0 && pat[0] == '*' {
+				pat = pat[1:]
+			}
+			if len(pat) == 0 {
+				return true, nil
+			}
+			// try every split of the remaining name
+			for i := 0; i <= len(name); i++ {
+				if i > 0 && !utf8.RuneStart(name[i-1]) {
+					continue
+				}
+				ok, err := matchSeg(pat, name[i:])
+				if err != nil {
+					return false, err
+				}
+				if ok {
+					return true, nil
+				}
+			}
+			return false, nil
+		case '?':
+			if len(name) == 0 {
+				return false, validRest(pat)
+			}
+			_, sz := utf8.DecodeRuneInString(name)
+			pat, name = pat[1:], name[sz:]
+		case '[':
+			if len(name) == 0 {
+				return false, validRest(pat)
+			}
+			ok, rest, err := matchClass(pat, name)
+			if err != nil {
+				return false, err
+			}
+			if !ok {
+				return false, validRest(rest)
+			}
+			_, sz := utf8.DecodeRuneInString(name)
+			pat, name = rest, name[sz:]
+		case '\\':
+			if len(pat) == 1 {
+				return false, errBad
+			}
+			r, sz := utf8.DecodeRuneInString(pat[1:])
+			nr, nsz := utf8.DecodeRuneInString(name)
+			if len(name) == 0 || r != nr {
+				return false, validRest(pat[1+sz:])
+			}
+			pat, name = pat[1+sz:], name[nsz:]
+		default:
+			r, sz := utf8.DecodeRuneInString(pat)
+			nr, nsz := utf8.DecodeRuneInString(name)
+			if len(name) == 0 || r != nr {
+				return false, validRest(pat[sz:])
+			}
+			pat, name = pat[sz:], name[nsz:]
+		}
+	}
+	return len(name) == 0, nil
+}
+
+// validRest reports errBad if the unmatched remainder of a segment pattern is
+// malformed (an unclosed or empty class, a trailing backslash), nil otherwise.
+func validRest(pat string) error {
+	for len(pat) > 0 {
+		switch pat[0] {
+		case '\\':
+			if len(pat) == 1 {
+				return errBad
+			}
+			_, sz := utf8.DecodeRuneInString(pat[1:])
+			pat = pat[1+sz:]
+		case '[':
+			_, rest, err := matchClass(pat, "\x00")
+			if err != nil {
+				return err
+			}
+			pat = rest
+		default:
+			_, sz := utf8.DecodeRuneInString(pat)
+			pat = pat[sz:]
+		}
+	}
+	return nil
+}
+
+// matchClass parses the class at the start of pat and reports whether the
+// first rune of name is in it, returning the pattern after the class.
+func matchClass(pat, name string) (bool, string, error) {
+	p := pat[1:]
+	negate := false
+	if len(p) > 0 && (p[0] == '!' || p[0] == '^') {
+		negate = true
+		p = p[1:]
+	}
+	if len(p) == 0 || p[0] == ']' {
+		return false, "", errBad
+	}
+	var nr rune = -1
+	if len(name) > 0 {
+		nr, _ = utf8.DecodeRuneInString(name)
+	}
+	matched := false
+	item := func() (rune, bool) {
+		if len(p) == 0 {
+			return 0, false
+		}
+		if p[0] == '\\' {
+			if len(p) == 1 {
+				return 0, false
+			}
+			r, sz := utf8.DecodeRuneInString(p[1:])
+			p = p[1+sz:]
+			return r, true
+		}
+		r, sz := utf8.DecodeRuneInString(p)
+		p = p[sz:]
+		return r, true
+	}
+	for len(p) > 0 && p[0] != ']' {
+		lo, ok := item()
+		if !ok {
+			return false, "", errBad
+		}
+		if len(p) >= 2 && p[0] == '-' && p[1] != ']' {
+			p = p[1:]
+			hi, ok := item()
+			if !ok {
+				return false, "", errBad
+			}
+			if lo <= nr && nr <= hi {
+				matched = true
+			}
+			continue
+		}
+		if nr == lo {
+			matched = true
+		}
+	}
+	if len(p) == 0 {
+		return false, "", errBad
+	}
+	return matched != negate, p[1:], nil
+}
+
+// validSegs reports errBad if any of the segments is malformed; Match
+// validates the whole remaining pattern once matching has failed.
+func validSegs(segs []string) error {
+	for _, s := range segs {
+		if err := validRest(s); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// matchPath matches name segments against pattern segments; self allows a
+// final `**` (or `**/`) to match the name itself as "the directory".
+func matchPath(pat, name []string, self bool) (bool, error) {
+	if len(pat) == 0 {
+		return len(name) == 0, nil
+	}
+	if pat[0] == "**" {
+		final := len(pat) == 1 || (len(pat) == 2 && pat[1] == "")
+		if len(name) == 0 {
+			if final {
+				return self, nil
+			}
+			return matchPath(pat[1:], name, self)
+		}
+		k := 0
+		if final && !self {
+			k = 1 // a file needs at least one segment under the prefix
+		}
+		for ; k <= len(name); k++ {
+			ok, err := matchPath(pat[1:], name[k:], self)
+			if err != nil || ok {
+				return ok, err
+			}
+		}
+		return false, validSegs(pat[1:])
+	}
+	if len(name) == 0 {
+		return false, validSegs(pat)
+	}
+	ok, err := matchSeg(pat[0], name[0])
+	if err != nil {
+		return false, err
+	}
+	if !ok {
+		return false, validSegs(pat[1:])
+	}
+	return matchPath(pat[1:], name[1:], self)
+}
+
+// modelMatch is the reference for Match.
+func modelMatch(pattern, name string) (bool, error) { return modelMatchSelf(pattern, name, true) }
+
+func modelMatchSelf(pattern, name string, self bool) (bool, error) {
+	alts, ok := expandAlts(pattern)
+	if !ok {
+		return false, errBad
+	}
+	nameSegs := strings.Split(name, "/")
+	for _, a := range alts {
+		ok, err := matchPath(strings.Split(a, "/"), nameSegs, self)
+		if err != nil {
+			return false, err
+		}
+		if ok {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// modelValid is the reference for ValidatePattern: every alternative must be
+// well formed, whether or not it would ever match.
+func modelValid(pattern string) bool {
+	alts, ok := expandAlts(pattern)
+	if !ok {
+		return false
+	}
+	for _, a := range alts {
+		for _, seg := range strings.Split(a, "/") {
+			if validRest(seg) != nil {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+var alphabet = []string{"a", "b", "c", "1", ".", "-", "_"}
+
+// pattern is a generated pattern with the facts the oracles need.
+type pattern struct {
+	text      string
+	standard  bool // path.Match-compatible: no alternatives, no `**` segment, no `!` or edge `-` in classes
+	bashSafe  bool // brace groups have two or more alternatives
+	consecDS  bool // two `**` segments in a row (pinned, doublestar/1, doublestar/2)
+	unmatched bool // an unmatched `}` (pinned, doublestar/3)
+	lazyAlt   bool // an alternative that is malformed on its own (pinned, doublestar/4)
+	escPlain  bool // a backslash before a non-meta character (Glob is pinned, doublestar/6)
+	emptyAlt  bool // an empty alternative (Glob is pinned, doublestar/7)
+	starTail  bool // a final `**` segment after a segment containing `*` (pinned, doublestar/1)
+	altDS     bool // an alternative beginning with `**` (pinned, doublestar/10)
+	nestedAlt bool // a group inside a group (Glob is pinned, doublestar/12)
+}
+
+// finishFlags computes the flags that depend on the whole text.
+func (p *pattern) finishFlags() {
+	p.unmatched = hasUnmatchedClose(p.text)
+	alts, ok := expandAlts(p.text)
+	if ok && len(alts) > 1 {
+		valid, invalid := 0, 0
+		for _, a := range alts {
+			if modelValid(a) {
+				valid++
+			} else {
+				invalid++
+			}
+		}
+		p.lazyAlt = valid > 0 && invalid > 0
+	}
+	if ok {
+		for _, a := range alts {
+			segs := strings.Split(strings.TrimSuffix(a, "/"), "/")
+			if len(segs) >= 2 && segs[len(segs)-1] == "**" && strings.Contains(segs[len(segs)-2], "*") {
+				p.starTail = true
+			}
+		}
+	}
+	// an alternative that begins with `**`
+	for i := 0; i+2 < len(p.text); i++ {
+		if p.text[i] == '\\' {
+			i++
+			continue
+		}
+		if (p.text[i] == '{' || p.text[i] == ',') && p.text[i+1] == '*' && p.text[i+2] == '*' {
+			p.altDS = true
+		}
+	}
+}
+
+func genLiteral(tc hegel.TestCase, lo, hi int) string {
+	var sb strings.Builder
+	for k := n(tc, lo, hi); k > 0; k-- {
+		sb.WriteString(pick(tc, alphabet))
+	}
+	return sb.String()
+}
+
+// genClass draws a character class; nonstd is set when path.Match would
+// refuse it (`!` negation or a `-` at either end).
+func genClass(tc hegel.TestCase) (text string, nonstd bool) {
+	var sb strings.Builder
+	sb.WriteByte('[')
+	switch n(tc, 0, 5) {
+	case 0:
+		sb.WriteByte('^')
+	case 1:
+		sb.WriteByte('!')
+		nonstd = true
+	}
+	items := n(tc, 1, 3)
+	for i := 0; i < items; i++ {
+		switch n(tc, 0, 4) {
+		case 0:
+			// `-` is never a range endpoint: `[--b]`-style classes are read
+			// differently by every implementation (path.Match refuses them).
+			lo, hi := pick(tc, []string{"a", "b", "0", "."}), pick(tc, []string{"c", "z", "9", "b"})
+			if lo > hi {
+				lo, hi = hi, lo
+			}
+			sb.WriteString(lo + "-" + hi)
+		case 1:
+			if i == 0 || i == items-1 {
+				sb.WriteByte('-')
+				nonstd = true
+			} else {
+				sb.WriteString(pick(tc, alphabet[:4]))
+			}
+		case 2:
+			sb.WriteString(`\` + pick(tc, []string{"]", "a", "-", "*", "["}))
+		default:
+			sb.WriteString(pick(tc, alphabet[:5]))
+		}
+	}
+	sb.WriteByte(']')
+	return sb.String(), nonstd
+}
+
+// genSegment draws one pattern segment.
+func genSegment(tc hegel.TestCase, depth int, p *pattern) string {
+	switch n(tc, 0, 11) {
+	case 0:
+		return "*"
+	case 1:
+		return "**"
+	case 2:
+		return genLiteral(tc, 0, 2) + "*" + genLiteral(tc, 0, 2)
+	case 3:
+		return "?" + genLiteral(tc, 0, 2)
+	case 4:
+		c, nonstd := genClass(tc)
+		if nonstd {
+			p.standard = false
+		}
+		return genLiteral(tc, 0, 1) + c + genLiteral(tc, 0, 1)
+	case 5:
+		e := pick(tc, []string{"*", "?", "[", "a", ".", "{", "}", "]"})
+		if e == "a" || e == "." {
+			p.escPlain = true
+		}
+		return `\` + e + genLiteral(tc, 0, 2)
+	case 6, 7:
+		if depth < 2 {
+			p.standard = false
+			if depth > 0 {
+				p.nestedAlt = true
+			}
+			k := n(tc, 1, 3)
+			if k == 1 {
+				p.bashSafe = false
+			}
+			alts := make([]string, k)
+			for i := range alts {
+				if !chance(tc, 15) {
+					alts[i] = genSegment(tc, depth+1, p)
+				}
+				if alts[i] == "" {
+					p.emptyAlt = true
+				}
+			}
+			return genLiteral(tc, 0, 1) + "{" + strings.Join(alts, ",") + "}" + genLiteral(tc, 0, 1)
+		}
+		return genLiteral(tc, 1, 3)
+	case 8:
+		return genLiteral(tc, 1, 2) + "**"
+	default:
+		return genLiteral(tc, 0, 3)
+	}
+}
+
+// genPattern draws a pattern of one to four segments.
+func genPattern(tc hegel.TestCase) pattern {
+	p := pattern{standard: true, bashSafe: true}
+	k := n(tc, 1, 4)
+	segs := make([]string, k)
+	for i := range segs {
+		segs[i] = genSegment(tc, 0, &p)
+		if segs[i] == "**" {
+			p.standard = false
+			if i > 0 && segs[i-1] == "**" {
+				p.consecDS = true
+			}
+		}
+	}
+	p.text = strings.Join(segs, "/")
+	if chance(tc, 8) {
+		p.text = "/" + p.text
+	}
+	if chance(tc, 8) {
+		p.text += "/"
+	}
+	// Occasionally damage the pattern.
+	if chance(tc, 10) {
+		p.standard = false
+		p.bashSafe = false
+		switch n(tc, 0, 4) {
+		case 0:
+			p.text += `\`
+		case 1:
+			p.text += "["
+		case 2:
+			p.text += "{"
+		case 3:
+			p.text += "}"
+		default:
+			p.text = "[]" + p.text
+		}
+	}
+	p.finishFlags()
+	return p
+}
+
+// hasUnmatchedClose reports an unescaped `}` with no open group.
+func hasUnmatchedClose(p string) bool {
+	depth := 0
+	for i := 0; i < len(p); i++ {
+		switch p[i] {
+		case '\\':
+			i++
+		case '{':
+			depth++
+		case '}':
+			if depth == 0 {
+				return true
+			}
+			depth--
+		}
+	}
+	return false
+}
+
+// genName draws a name: a tree path (perhaps decorated), or random segments.
+func genName(tc hegel.TestCase) string {
+	if chance(tc, 50) {
+		s := pick(tc, treePaths)
+		switch n(tc, 0, 9) {
+		case 0:
+			s = "/" + s
+		case 1:
+			s += "/"
+		case 2:
+			s = strings.Replace(s, "/", "//", 1)
+		}
+		return s
+	}
+	k := n(tc, 0, 4)
+	segs := make([]string, k)
+	for i := range segs {
+		segs[i] = genLiteral(tc, 0, 3)
+	}
+	return strings.Join(segs, "/")
+}
+
+// ---------------------------------------------------------------------------
+// The fixed tree.
+
+var treeFiles = []string{
+	"a/e", "a/a", "a/b/c/f", "a/b/c/c", "a/b/c/.k", "a/b/d.txt", "a/.h/x", "a/.g",
+	"f", ".i", "b/a", "b/-", "b/_1", "a-1/a", "ab/ba", "c.1/a.b", "-/a", "1/2/3/4", "_/.",
+}
+
+var (
+	treeDir   string
+	treeFS    fs.FS
+	treePaths []string // every file and directory, "." included
+	treeDirs  = map[string]bool{}
+)
+
+// treeMeta fills treePaths and treeDirs from treeFiles; buildTree writes the files under a
+// per-test temporary directory (removed by the testing package) and points treeDir/treeFS at it.
+func treeMeta() {
+	seen := map[string]bool{".": true}
+	treeDirs["."] = true
+	for _, f := range treeFiles {
+		if strings.HasSuffix(f, "/.") {
+			// "_/." is the directory "_" alone
+			d := strings.TrimSuffix(f, "/.")
+			for p := d; p != "."; p = path.Dir(p) {
+				seen[p] = true
+				treeDirs[p] = true
+			}
+			continue
+		}
+		seen[f] = true
+		for p := path.Dir(f); p != "."; p = path.Dir(p) {
+			seen[p] = true
+			treeDirs[p] = true
+		}
+	}
+	for p := range seen {
+		treePaths = append(treePaths, p)
+	}
+	sort.Strings(treePaths)
+}
+
+func init() { treeMeta() }
+
+func buildTree(t *testing.T) {
+	t.Helper()
+	dir := t.TempDir()
+	for _, f := range treeFiles {
+		if strings.HasSuffix(f, "/.") {
+			if err := os.MkdirAll(filepath.Join(dir, strings.TrimSuffix(f, "/.")), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			continue
+		}
+		if err := os.MkdirAll(filepath.Join(dir, path.Dir(f)), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, f), []byte("x"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	treeDir = dir
+	treeFS = os.DirFS(dir)
+}
+
+// modelGlob lists the tree entries the pattern matches: the model applied to
+// every path; a trailing slash restricts to directories; results are
+// reported without the slash. The root "." is listed only for a bare `**`
+// (zero directories), as an alternative or alone.
+func modelGlob(pattern string, filesOnly bool) ([]string, error) {
+	dirsOnly := strings.HasSuffix(pattern, "/") && pattern != "/"
+	pat := strings.TrimSuffix(pattern, "/")
+	var out []string
+	for _, p := range treePaths {
+		if dirsOnly && !treeDirs[p] {
+			continue
+		}
+		if filesOnly && treeDirs[p] {
+			continue
+		}
+		if p == "." {
+			if filesOnly {
+				continue
+			}
+			alts, _ := expandAlts(pat)
+			for _, a := range alts {
+				if a == "**" {
+					out = append(out, ".")
+					break
+				}
+			}
+			continue
+		}
+		ok, err := modelMatchSelf(pat, p, treeDirs[p])
+		if err != nil {
+			return nil, err
+		}
+		if ok {
+			out = append(out, p)
+		}
+	}
+	return out, nil
+}
+
+func sortedSet(xs []string) ([]string, []string) {
+	set := map[string]int{}
+	for _, x := range xs {
+		set[strings.TrimSuffix(x, "/")]++
+	}
+	var out, dups []string
+	for k, c := range set {
+		out = append(out, k)
+		if c > 1 {
+			dups = append(dups, k)
+		}
+	}
+	sort.Strings(out)
+	sort.Strings(dups)
+	return out, dups
+}
+
+// bashGlob runs the pattern through bash with globstar (and dotglob unless
+// hidden is set) in the tree, keeping only names that exist.
+func bashGlob(pattern string, hidden bool) ([]string, error) {
+	opts := "globstar nullglob"
+	if !hidden {
+		opts += " dotglob"
+	}
+	script := fmt.Sprintf(`shopt -s %s; cd "$1" || exit 9; for f in %s; do printf '%%s\n' "$f"; done`, opts, pattern)
+	cmd := exec.Command("bash", "-c", script, "_", treeDir)
+	cmd.Env = append(os.Environ(), "LC_ALL=C")
+	outb, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("bash: %v", err)
+	}
+	var out []string
+	for _, line := range strings.Split(strings.TrimRight(string(outb), "\n"), "\n") {
+		if line == "" {
+			continue
+		}
+		clean := strings.TrimSuffix(line, "/")
+		if _, err := os.Lstat(filepath.Join(treeDir, clean)); err != nil {
+			continue // a brace alternative bash left unexpanded
+		}
+		out = append(out, clean)
+	}
+	return out, nil
+}
+
+// globbable reports whether Glob-style oracles apply: no leading slash and
+// no `.`/`..` segments (io/fs.Glob and doublestar.Glob document these as
+// matching nothing), in every alternative, and a non-empty pattern.
+func globbable(p string) bool {
+	alts, ok := expandAlts(p)
+	if !ok {
+		return false
+	}
+	for _, a := range alts {
+		if a == "" || strings.HasPrefix(a, "/") {
+			return false
+		}
+		for _, s := range strings.Split(strings.TrimSuffix(a, "/"), "/") {
+			if s == "." || s == ".." || s == `\.` {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// endsInDoublestar reports whether some alternative ends in a `**` segment.
+func endsInDoublestar(p string) bool {
+	alts, _ := expandAlts(p)
+	for _, a := range alts {
+		segs := strings.Split(strings.TrimSuffix(a, "/"), "/")
+		if segs[len(segs)-1] == "**" {
+			return true
+		}
+	}
+	return false
+}
+
+// classVsSlash reports the pinned shape doublestar/11: a class that can
+// match `/` (negated, or with a range spanning 0x2F) and a name containing a
+// separator.
+func classVsSlash(p, name string) bool {
+	if !strings.Contains(name, "/") {
+		return false
+	}
+	for i := 0; i < len(p); i++ {
+		switch p[i] {
+		case '\\':
+			i++
+		case '[':
+			j := i + 1
+			if j < len(p) && (p[j] == '!' || p[j] == '^') {
+				return true
+			}
+			var last byte
+			for ; j < len(p) && p[j] != ']'; j++ {
+				if p[j] == '\\' {
+					j++
+					if j < len(p) {
+						last = p[j]
+					}
+					continue
+				}
+				if p[j] == '-' && last != 0 && j+1 < len(p) && p[j+1] != ']' {
+					hi := p[j+1]
+					if hi == '\\' && j+2 < len(p) {
+						hi = p[j+2]
+					}
+					if last <= '/' && '/' <= hi {
+						return true
+					}
+					j++
+					last = 0
+					continue
+				}
+				last = p[j]
+			}
+			i = j
+		}
+	}
+	return false
+}
+
+// globPatternOK is the shared filter of the Glob properties: the pattern
+// must be globbable, valid, free of empty segments (`//` is no path in
+// io/fs terms and matches nothing) and free of the pinned shapes.
+func globPatternOK(p pattern) bool {
+	return globbable(p.text) && !strings.Contains(p.text, "//") && !p.consecDS && !p.unmatched && !p.lazyAlt &&
+		!p.escPlain && !p.emptyAlt && !p.starTail && !p.altDS && !p.nestedAlt && modelValid(p.text)
+}
+
+// ---------------------------------------------------------------------------
+// Property: on the shared syntax, Match agrees with path.Match.
+
+func TestHegelMatchAgreesWithPathMatch(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		p := genPattern(ht)
+		for tries := 0; tries < 20 && !p.standard; tries++ {
+			p = genPattern(ht)
+		}
+		if !p.standard {
+			p = pattern{text: genLiteral(ht, 0, 3) + "*", standard: true}
+		}
+		name := genName(ht)
+		if classVsSlash(p.text, name) {
+			name = strings.ReplaceAll(name, "/", "")
+		}
+		if strings.Contains(p.text, "**") && (name == "" || strings.HasSuffix(name, "/") || strings.HasSuffix(p.text, "/")) {
+			return // doublestar/1: `-**/` matches `-`
+		}
+		note(ht, "Match(%q, %q)", p.text, name)
+		got, gerr := doublestar.Match(p.text, name)
+		want, werr := path.Match(p.text, name)
+		if got != want || (gerr != nil) != (werr != nil) {
+			fail(ht, "Match(%q, %q) = %v, %v; path.Match = %v, %v", p.text, name, got, gerr, want, werr)
+		}
+		got2, gerr2 := doublestar.PathMatch(p.text, name)
+		want2, werr2 := filepath.Match(p.text, name)
+		if got2 != want2 || (gerr2 != nil) != (werr2 != nil) {
+			fail(ht, "PathMatch(%q, %q) = %v, %v; filepath.Match = %v, %v", p.text, name, got2, gerr2, want2, werr2)
+		}
+		if gerr == nil && doublestar.MatchUnvalidated(p.text, name) != got {
+			fail(ht, "MatchUnvalidated(%q, %q) = %v, Match = %v", p.text, name, !got, got)
+		}
+		if doublestar.ValidatePattern(p.text) != (werr == nil) {
+			fail(ht, "ValidatePattern(%q) = %v, path.Match error = %v", p.text, !(werr == nil), werr)
+		}
+	})
+}
