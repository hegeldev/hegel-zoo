+// ---------------------------------------------------------------------------
+// Pins: one test per recorded bug, each failing while the bug is present.
+
+func guard(t *testing.T) {
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+// pinTree builds a small directory tree for the pins and returns its path
+// and an fs.FS over it.
+func pinTree(t *testing.T, files ...string) (string, fs.FS) {
+	t.Helper()
+	dir := t.TempDir()
+	for _, f := range files {
+		if strings.HasSuffix(f, "/") {
+			if err := os.MkdirAll(filepath.Join(dir, f), 0o755); err != nil {
+				t.Fatal(err)
+			}
+			continue
+		}
+		if err := os.MkdirAll(filepath.Join(dir, path.Dir(f)), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, f), []byte("x"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir, os.DirFS(dir)
+}
+
+func expectMatch(t *testing.T, pattern, name string, want bool) {
+	t.Helper()
+	got, err := doublestar.Match(pattern, name)
+	if err != nil || got != want {
+		t.Errorf("Match(%q, %q) = %v, %v; want %v, nil", pattern, name, got, err, want)
+	}
+}
+
+func expectGlob(t *testing.T, fsys fs.FS, pattern string, want []string, opts ...doublestar.GlobOption) {
+	t.Helper()
+	got, err := doublestar.Glob(fsys, pattern, opts...)
+	if err != nil {
+		t.Errorf("Glob(%q): %v", pattern, err)
+		return
+	}
+	sort.Strings(got)
+	sort.Strings(want)
+	if len(want) == 0 {
+		want = nil
+	}
+	if len(got) == 0 {
+		got = nil
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("Glob(%q) = %q, want %q", pattern, got, want)
+	}
+}
