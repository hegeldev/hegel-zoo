+// doublestar/1: once the name is exhausted, the rest of the pattern is
+// recognised as matching nothing more only in a handful of fixed shapes, so
+// `a/**/**` and `a*/**` do not match `a` although `a/**` and `*/**` do.
+func TestHegelPinConsecutiveDoublestarZeroDirs(t *testing.T) {
+	defer guard(t)
+	expectMatch(t, "a/**", "a", true)
+	expectMatch(t, "*/**", "a", true)
+	expectMatch(t, "a/**/**", "a", true)
+	expectMatch(t, "a*/**", "a", true)
+	expectMatch(t, "**", "", true)
+	expectMatch(t, "**/**", "", true)
+}
+
+// doublestar/2: Glob lists a name once per way the pattern can match it —
+// two `**` segments (`a/**/**`, `**/?/**`) or overlapping alternatives
+// (`{?,*}`) produce duplicates.
+func TestHegelPinGlobDuplicatesWithConsecutiveDoublestar(t *testing.T) {
+	defer guard(t)
+	_, fsys := pinTree(t, "a/b/c", "a/d", "f")
+	for _, p := range []string{"a/**/**", "**/?/**", "{f,?}"} {
+		got, err := doublestar.Glob(fsys, p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		seen := map[string]bool{}
+		for _, g := range got {
+			if seen[g] {
+				t.Errorf("Glob(%q) lists %q more than once: %q", p, g, got)
+				break
+			}
+			seen[g] = true
+		}
+	}
+}
+
+// doublestar/3: an unmatched `}` is a literal when Match consumes it, an
+// error when Match validates it after a mismatch, and ValidatePattern and
+// Glob refuse it.
+func TestHegelPinUnmatchedCloseBrace(t *testing.T) {
+	defer guard(t)
+	expectMatch(t, "a}", "a}", true)
+	expectMatch(t, "a}", "b", false)
+	if !doublestar.ValidatePattern("a}") {
+		t.Errorf("ValidatePattern(%q) = false, but Match accepts the pattern", "a}")
+	}
+	_, fsys := pinTree(t, "a}")
+	expectGlob(t, fsys, "a}", []string{"a}"})
+}
+
+// doublestar/4: whether a malformed alternative is reported depends on the
+// name: Match("{a,[]}", "a") succeeds, Match("{a,[]}", "b") is ErrBadPattern.
+// (The original example "{a,[}" became ErrBadPattern for every name at 314a609,
+// where the closing-brace search started skipping character classes; a
+// malformed class that does close still shows the lazy validation.)
+func TestHegelPinAlternativeValidationDependsOnTheName(t *testing.T) {
+	defer guard(t)
+	const pat = "{a,[]}"
+	_, err1 := doublestar.Match(pat, "a")
+	_, err2 := doublestar.Match(pat, "b")
+	if (err1 == nil) != (err2 == nil) {
+		t.Errorf("Match(%q, %q) error = %v but Match(%q, %q) error = %v", pat, "a", err1, pat, "b", err2)
+	}
+}
+
+// doublestar/5: Glob with a trailing slash on a literal pattern returns a
+// regular file, and keeps the slash in the result.
+func TestHegelPinGlobTrailingSlashOnLiteral(t *testing.T) {
+	defer guard(t)
+	_, fsys := pinTree(t, "f", "a/")
+	expectGlob(t, fsys, "f/", nil)
+	expectGlob(t, fsys, "a/", []string{"a"})
+}
+
+// doublestar/6: Glob does not find files when the pattern escapes a
+// character that is not a meta character, although Match accepts it.
+func TestHegelPinGlobEscapedPlainCharacter(t *testing.T) {
+	defer guard(t)
+	_, fsys := pinTree(t, "f", "a/e", ".i")
+	expectMatch(t, `\f`, "f", true)
+	expectGlob(t, fsys, `\f`, []string{"f"})
+	expectGlob(t, fsys, `a/\e`, []string{"a/e"})
+	expectGlob(t, fsys, `\.i`, []string{".i"})
+}
+
+// doublestar/7: Glob drops an empty alternative — the README's own
+// `some{thing,}` lists "something" but not "some".
+func TestHegelPinGlobEmptyAlternative(t *testing.T) {
+	defer guard(t)
+	_, fsys := pinTree(t, "some", "something", "f")
+	expectMatch(t, "some{thing,}", "some", true)
+	expectGlob(t, fsys, "some{thing,}", []string{"some", "something"})
+	expectGlob(t, fsys, "{,something}", []string{"something"})
+	expectGlob(t, fsys, "{f,}", []string{"f"})
+}
+
+// doublestar/8: FilepathGlob cleans the pattern, so a trailing slash no
+// longer restricts to directories: `dir/*/` returns regular files, where
+// filepath.Glob returns nothing and Glob returns directories only.
+func TestHegelPinFilepathGlobTrailingSlash(t *testing.T) {
+	defer guard(t)
+	dir, _ := pinTree(t, "f", "a/")
+	got, err := doublestar.FilepathGlob(filepath.Join(dir, "*") + "/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, g := range got {
+		if filepath.Base(g) == "f" {
+			t.Errorf("FilepathGlob(%q) = %q includes the regular file f", "dir/*/", got)
+		}
+	}
+}
+
+// doublestar/9: with WithNoHidden a character class at the start of a
+// segment matches a leading dot, which shells never allow.
+func TestHegelPinNoHiddenClassMatchesDotfile(t *testing.T) {
+	defer guard(t)
+	_, fsys := pinTree(t, ".i", "ai")
+	expectGlob(t, fsys, "?i", []string{"ai"}, doublestar.WithNoHidden())
+	expectGlob(t, fsys, "[.a]i", []string{"ai"}, doublestar.WithNoHidden())
+	expectGlob(t, fsys, "[!b]i", []string{"ai"}, doublestar.WithNoHidden())
+}
+
+// doublestar/10: a `**` at the start of an alternative is treated as a
+// segment-start doublestar even in the middle of a segment, so `b{**}`
+// matches `b/-` although `b**` does not, and Glob("b{**}") lists nothing.
+func TestHegelPinAlternativeLeadingDoublestar(t *testing.T) {
+	defer guard(t)
+	expectMatch(t, "b**", "b/-", false)
+	expectMatch(t, "b{**}", "b/-", false)
+	expectMatch(t, "b{**,x}", "b/-", false)
+}
+
+// doublestar/11: a character class matches the path separator — a negated
+// class always, a range spanning 0x2F (`[.-c]`) too — so `a[!1]b` and
+// `a[.-c]a` match `a/b` and `a/a` (path.Match: false; the doc says a class
+// matches a single non-path-separator character).
+func TestHegelPinNegatedClassMatchesSeparator(t *testing.T) {
+	defer guard(t)
+	expectMatch(t, "a[!1]b", "a/b", false)
+	expectMatch(t, "a[^1]b", "a/b", false)
+	expectMatch(t, "a[.-c]a", "a/a", false)
+	expectMatch(t, "[!a]", "/", false)
+}
+
+// doublestar/12: a group nested inside a group makes Glob descend one level
+// too far: with 1/2/3/4 and a/b/c/f present, Glob("*/{{*}}/*") lists
+// 1/2/3/4 (four segments for a three-segment pattern) where Glob("*/{*}/*"),
+// Glob("*/*/*") and Match do not.
+func TestHegelPinGlobNestedAlternativesDescendTooFar(t *testing.T) {
+	defer guard(t)
+	_, fsys := pinTree(t, "a/b/c/f", "a/x", "a/b/d", "f", "1/2/3/4")
+	expectMatch(t, "*/{{*}}/*", "1/2/3/4", false)
+	expectGlob(t, fsys, "*/{*}/*", []string{"1/2/3", "a/b/c", "a/b/d"})
+	expectGlob(t, fsys, "*/{{*}}/*", []string{"1/2/3", "a/b/c", "a/b/d"})
+}
