+// ---------------------------------------------------------------------------
+// Property: Glob agrees with bash's globstar.
+
+func TestHegelGlobAgreesWithBash(t *testing.T) {
+	buildTree(t)
+	property(t, func(ht *hegel.T) {
+		p := genPattern(ht)
+		for tries := 0; tries < 20 && (!globPatternOK(p) || !p.bashSafe); tries++ {
+			p = genPattern(ht)
+		}
+		if !globPatternOK(p) || !p.bashSafe {
+			return
+		}
+		if strings.HasSuffix(p.text, "/") && !strings.ContainsAny(p.text, `*?[{\`) {
+			p.text = strings.TrimSuffix(p.text, "/")
+		}
+		hidden := chance(ht, 30)
+		var opts []doublestar.GlobOption
+		if hidden {
+			// A class at the start of a segment matching a leading dot is
+			// pinned (doublestar/9).
+			alts, _ := expandAlts(p.text)
+			for _, a := range alts {
+				for _, s := range strings.Split(a, "/") {
+					if strings.HasPrefix(s, "[") {
+						hidden = false
+					}
+				}
+			}
+		}
+		if hidden {
+			opts = append(opts, doublestar.WithNoHidden())
+		}
+		note(ht, "Glob(%q) noHidden=%v vs bash", p.text, hidden)
+		got, err := doublestar.Glob(treeFS, p.text, opts...)
+		if err != nil {
+			fail(ht, "Glob(%q): %v", p.text, err)
+			return
+		}
+		gotSet, _ := sortedSet(got)
+		// bash never lists the root itself.
+		if i := sort.SearchStrings(gotSet, "."); i < len(gotSet) && gotSet[i] == "." {
+			gotSet = append(gotSet[:i], gotSet[i+1:]...)
+		}
+		want, err := bashGlob(p.text, hidden)
+		if err != nil {
+			fail(ht, "bash on %q: %v", p.text, err)
+			return
+		}
+		wantSet, _ := sortedSet(want)
+		if !reflect.DeepEqual(gotSet, wantSet) {
+			fail(ht, "Glob(%q, noHidden=%v) = %q\n  bash %q", p.text, hidden, gotSet, wantSet)
+		}
+	})
+}
